function NeedMakeSF: boolean;
{
  Result :=  if(GetFirst KatPayment = tsOk, LoCase(KatPayment.Name) != 'без сф', true);

}
!-------------------------------------------------------------------------------------------------------------
!Записать сообщение в протокол
!lev - количество отступов
!-------------------------------------------------------------------------------------------------------------
procedure WriteProtokol(strMes: string; lev: word = 2);
{
  If NeedProtokol
    Form_Write(LPadCh('', ' ', lev) + strMes, '', LogHandle);
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
procedure MyBeginVisual(sMess: string);
{
  if (MyVisualCount = 0)
  {
    StartNewVisual(vtRotateVisual, vfTimer, 'Отмена проведение документа...', 3);
    SetVisualTitle(sMess);

  }
  SetVisualHeader(sMess);
  MyVisualCount ++;
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
procedure MyStopVisual;
{
  MyVisualCount --;
  if MyVisualCount = 0
    StopVisual('', 0);
}
!-------------------------------------------------------------------------------------------------------------
!Получение направления счета фактуры
!-------------------------------------------------------------------------------------------------------------
function GetDirectShFact : word;
{
  Result := 0;
  case KatSopr.VidSopr of
    552,553,554:     Result := 2;
    504,513,551,557: Result := 1;
    // накладные и акты из KatSopr
    101..111, 114, 151, 201..211, 251, 1411, 1421:
    {
      case KatSopr.VidSopr of
       102,106,203,206,114: Result := KatSopr.TipSopr; // возвраты
      else
        case KatSopr.TipSopr of
          1: Result := 2;
          2: Result := 1;
        end;
      end;
    }
  end;
  if ( Result = 0)
    Message('Неизвестный тип документа, по которому формируется документ по учету НДС',Information);
};
#include KatSoprToBaseDoc.vpp
!-------------------------------------------------------------------------------------------------------------
! Апдейт накладных перед и после операций проведения
!-------------------------------------------------------------------------------------------------------------
Function Update_Current_KatSopr: word;
{
  Result := Update Current KatSopr;
  if  Result != tsOk
  {
    Message('Ошибка обновления статуса: ' + Result + 'Обратитесь к разработчикам.');
  }


   iKB.SaveInfoforBal(KatSopr.VidSopr,KatSopr.NRec);


  if ( Result = tsOk )
    oSDfuns.UpdateSoprHoz(KatSopr.Buffer);

  iKB.ModiKontrBal(KatSopr.VidSopr,KatSopr.NRec);
}
!-------------------------------------------------------------------------------------------------------------
!Вставка накладной если новая, теоретически не должно попасть сюда
!-------------------------------------------------------------------------------------------------------------
Procedure MakeNotNewKatSopr;
{
  if (IsNew)
  {
    insert current KatSopr;
    SetNew(FALSE);
    // тип документа системный,ссылка на документ,ссылка на контрагента
    iGrPl.InsSpGrPlD_Default( KatSopr.VidSopr, KatSopr.NRec, KatSopr.cOrg);
    Update_Current_KatSopr;
  }
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
function DeleteHozOperBySh(TipDoc: word; cSoprDoc: tNrec): boolean;
var
  iSHoz : ObjSHmanager;
{
  Result := false;


  If (GetFirst SoprHoz where ((TipDoc  == SoprHoz.TipDoc AND cSoprDoc == SoprHoz.cSoprDoc)) != tsOk)
    Exit;

  iTxoBind.ResetServer;
  if ( NullVipRef(iSHoz) )
    GetVipRef(iSHoz, 'SHmanager');

  iShoz.CheckMagOper(#TSoprHozX(SoprHoz.bufferp), integer(1));
  iTxoBind.BuildTree(SoprHoz.bufferp);
  Result := iTxoBind.UnBind(SoprHoz.bufferp);
  iTxoBind.ProcessProtokol;


}
!-------------------------------------------------------------------------------------------------------------
!Удаление хоз операции
!-------------------------------------------------------------------------------------------------------------
function DeleteHozOper: boolean;
{
  /*if not iDocTune.NeedDel(cgOper_HozOper)
  {
    Result := true;
    Exit;
  }       */
  Result := false;
  WriteProtokol('Удаление ХозОпераций по документу.');
  if (not DeleteHozOperBySh(KatSopr.VidSopr, KatSopr.Nrec)      )
     WriteProtokol('Ошибка удаления ХозОпераций по документу.', 3);
  else
  {
    update current SoprHoz;
    if GetFirst KatSopr = tsOk
    {
      KatSopr.cHozOper    := SoprHoz.cHozOper;
      set KatSopr.SoprHoz := 1;
      Update_Current_KatSopr;
    }
  }
  Result := true;

}
!-------------------------------------------------------------------------------------------------------------
!Привязка Хоз. операции
!-------------------------------------------------------------------------------------------------------------
function MakeHozOperBySh(TipDoc: word; cSoprDoc: tNrec; wOperFlag: word; wRecType: word = 0): word;
var
  iSHoz : ObjSHmanager;
  TxoIsGood : boolean;
  logMes: string;
{
  Result := 0;
  TxoIsGood := false;

  If (GetFirst SoprHoz where ((TipDoc  == SoprHoz.TipDoc AND cSoprDoc == SoprHoz.cSoprDoc)) != tsOk)
    Exit;

  iTxoBind.ResetServer;
  if ( NullVipRef(iSHoz) )
    GetVipRef(iSHoz, 'SHmanager');

  //передаем тип книги для проведения
  SoprHoz.cHozOper := iDocTune.GetHozOper(wOperFlag, wRecType);
  SoprHoz.SysOper  := wRecType;//получаем тип операции для всего
  //Message(TipDoc+' '+wRecType+' '+SoprHoz.cHozOper);
  if (SoprHoz.cHozOper = 0) and (wRecType != 0) // значит нет записи для книги покупок в настройке
  {
    Result := 2;
    Exit;
  }

  if GetFirst HozOper where ((SoprHoz.cHozOper == HozOper.Nrec)) != tsOk
    Exit;

  iShoz.CheckMagOper(#TSoprHozX(SoprHoz.bufferp), integer(1));
  iTxoBind.BuildTree(SoprHoz.bufferp);
  iTxoBind.SetOperation(0, wOper_ReObor, 0, 0);
  TxoIsGood := iTxoBind.RealizeAndApplyOperations(SoprHoz.bufferp);

  iTxoBind.ProcessProtokol;

  if ( TxoIsGood )
  {
    update current SoprHoz;
    WriteProtokol('Привязана хозоперация "' + HozOper.Name1 +'"', 3);
  }

  Result := 1;
}
!-------------------------------------------------------------------------------------------------------------
!Привязка Хоз. операции
!-------------------------------------------------------------------------------------------------------------
function MakeHozOper: boolean;

{
  Result := false;
  if not iDocTune.NeedMake(cgOper_HozOper)
  {
    Result := true;
    Exit;
  }
  if (GetFirst KatSopr != tsOk)
    Exit;
  WriteProtokol('Привязка ХозОперации:') ;
  if (MakeHozOperBySh(KatSopr.VidSopr, KatSopr.Nrec, cgOper_HozOper) = 0)
  {
    WriteProtokol(' Не найдена хозоперация для типа: ' + KatSopr.VidSopr, 3);
    Exit;
  }
  Result := true;
}

!-------------------------------------------------------------------------------------------------------------
!Привязка Хоз. операции
!-------------------------------------------------------------------------------------------------------------
function MakeBookHozOper: boolean;
var
  wBookType
  ,wDirect: word;
  cSchFact: tNrec;
  isBookRec: boolean;
  wSh: word;
{
  Result := false;
  if not iDocTune.NeedMake(cgOper_HozOperBook)
  {
    Result := true;
    Exit;
  }
  if (GetFirst KatSopr != tsOk)
    Exit;
  if ( GetFirst SchFact != tsOk )
    Exit;

  WriteProtokol('Привязка ХозОперации к записям в книге покупок/продаж:') ;
  /*wBookType := iDocTune.GetBookType;
  if (wBookType = 0)
  {
    WriteProtokol(' Не найдена хозоперация к записям в книге покупок/продаж', 3);
    Exit;
  }                                 */
  cSchFact := SchFact.Nrec;
  isBookRec := false;
  _loop BookPrZk where ((cSchFact == BookPrZk.cSchFact))
  {
    /*if (BookPrZk.TipUser != wBookType)
      continue;           */

    wDirect := word(SubStr(BookPrZk.TipUser, 1, 2));
    isBookRec := true;
    wSh := MakeHozOperBySh(wDirect, BookPrZk.Nrec, cgOper_HozOperBook, BookPrZk.TipUser);
    if (wSh = 0)
    {
      WriteProtokol(' Не найдена хозоперация к записям в книге покупок/продаж', 3);
      Exit;
    }
  }

  if not isBookRec
    WriteProtokol(' Нет записей в книге покупок/продаж', 3);
  else
   if wSh = 2
    WriteProtokol(' Нет записи для книги покупок/продаж в настройке.', 3);
  Result := true;
}

#include ProveDoc204.Vpp


!-------------------------------------------------------------------------------------------------------------
!Окно настройки параметров операций
!-------------------------------------------------------------------------------------------------------------
function GetMakeParams: boolean;
{
  Result := false;
  SfPar.dDate := SfPar.dRegDate := OprDate := if (longint(KatSopr.dOpr) = 0, KatSopr.dSopr, KatSopr.dOpr);
  if (not iDocTune.NeedMake(cgOper_SchFact))  or (not NeedMakeSF)
  {
    result := true;
    Exit;
  }
  iViewSchF.GetNumDate(SfPar, KaTSopr.Nrec);

  if(( KatSopr.VidSopr != 201) and ( KatSopr.VidSopr != 211))
  {
    if (SfPar.dDate = date(0,0,0))
      SfPar.dDate := KatSopr.dSopr;
    if (SfPar.dRegDate = date(0,0,0))
      SfPar.dRegDate := SfPar.dDate;


    if (trim(SfPar.sNum) = '')
      SfPar.sNum := KatSopr.NSopr;
  }
  if NeedAskDate
    if (RunWindowmodal(wnParams) != cmDefault)
      Exit;

   Result := true;
}

!-------------------------------------------------------------------------------------------------------------
! проверка данных перед формированием ордеров
!-------------------------------------------------------------------------------------------------------------
function CheckData: boolean;
var
  bBoxNeedAuto: boolean;
{
  Result := false;
  If (wGetTune('Doc.Buy.MakeOrder')=1 and KatSopr.status != 1)
  {
    message('Включена настройка "Формирование ордеров по накладным только в статусе "исполняемый"".');
    exit;
  }
  bBoxNeedAuto := false ;
  if (ExistTune('Oper.BoxAutoNew'))
  {
    if (boGetTune('Oper.UseBoxes') and (wGetTune('Oper.BoxAutoNew') = 2))
      if (message('Выполнить автоматическое распределение по ячейкам?', YesNo) = cmYes)
        bBoxNeedAuto := true;
  }

  PushPos(#SpSopr);

  _LOOP SpSopr
    _LOOP SpecZatr2 where ((SpSopr.NRec == SpecZatr2.cAddSumTune))
      if (SpecZatr2.coTable = 0)
      {
        Message('Накладная связана с актом о приемке материалов.');
        PopPos(#SpSopr);
        Exit;
      }
  if (boGetTune('Oper.UseBoxes') and (wGetTune('Oper.BoxAutoNew') = 2))
    _LOOP SpSopr
    {
      PushPos(#SpSopr);
      if not bBoxNeedAuto
        RunInterface('InBoxPlan', SpSopr.NRec);
      PopPos(#SpSopr);
    }

  PopPos(#SpSopr);
  if (wGetTune('Oper.Buy.Nakl.PrihParty') = 1) and (not boGetTune('MCUsl.AvtoParty')) and (KatSopr.VidSopr = 101)
  {
    PushPos(#SpSopr);
    _Loop SpSopr where ((KatSopr.nRec == SpSopr.cSopr and  word(1) == SpSopr.prMC and (SpSopr.cParty = 0) ))
      if (KatMC.kGroupMC <> sGetTune('Tara.KodGrMcTara'))
      {
        ShowTune('Для формирования ордера требуется наличие партии у всех позиций спецификации!',
                 'Oper.Buy.Nakl.PrihParty');
        PopPos(#SpSopr);
        Abort;
        Exit;
      }
    PopPos(#SpSopr);
  }

  MakeNotNewKatSopr;
  Result := true;
}
!-------------------------------------------------------------------------------------------------------------
!Возвращает дату для ордера объекту
!-------------------------------------------------------------------------------------------------------------
Function CanMakeOrder: Date;
{
  Result := to_Days(0);

  if (NOT iMakeOrder.IsDelOrder(KatSopr.NRec))
    Exit;

  /*if (KatSopr.dSopr > OprDate)
    if (Message('Дата формирования ордеров меньше даты документа!'#13 +
                'Продолжить формирование?', Confirmation + YesNo + mfSwapButtons) <> cmYes)
      Exit;                   */


  Result := OprDate;
}
!-------------------------------------------------------------------------------------------------------------
!Удаление ордеров
!-------------------------------------------------------------------------------------------------------------
function DeleteOrders: boolean;
{
 /* if not iDocTune.NeedDel(cgOper_SklOrder)
  {
    Result := true;
    Exit;
  }
 */
  WriteProtokol('Удаление ордеров по документу.');
  Result := iMakeOrder.DeleteOrders(KatSopr.NRec, false, true, true, 0, 0);
  if not Result
    WriteProtokol('Ошибка удаления ордеров.', 3);
}
function MakePrihOrder: boolean;
var
  firstRozn,
  prRozn: boolean;
{
  Result := iMakeOrder.MakePrihOrder(KatSopr.Nrec, false, firstRozn, prRozn,wSP,wMode,0);

  if (KatSopr.VidSopr = 101)
  {
    _Loop KSopr where ((KatSopr.Nrec == KSopr.cKatSopr))
      if (KSopr.VidSopr = 111)
        {
          if (KSopr.wcIzd <> cgCustomAkt)
          {
            KSopr.wcIzd := cgPrihOrdAkt;
            Update current KSopr;
          }
        }
  }
  if ( KatSopr.VidSopr = 101 )
    // Если есть модуль "Управление строительством" в лицензионном файле
    if (GetFirst SklOrder where ((KatSopr.NRec == SklOrder.cSopr)) = tsOk)
    {
      oChkSchem.CheckSchem(KatSopr.Nrec, KatSopr.VidSopr, SklOrder.Nrec,
                           if(SklOrder.VidOrder = 0, word(150), word(250)), true);

      if UpdateTable
        oUKSfuns.JoinSO(SklOrder.nRec);
    }

  if (prRozn)
  {
    Update_Current_KatSopr;
    RunInterface(KUTOper);
  }
}
!-------------------------------------------------------------------------------------------------------------
!Формирование складских ордеров
!-------------------------------------------------------------------------------------------------------------
function MakeSkladOrder: boolean;
var
  firstRozn,
  prRozn: boolean;
{
  Result := false;
  wMode := 0;

  if not iDocTune.NeedMake(cgOper_SklOrder)
  {
    Result := true;
    Exit;
  }
  WriteProtokol('Формирование складских ордеров ... ');
  if not DeleteOrders
    Exit;
  BindEvent(CanMakeOrder, iMakeOrder.CanMakeOrder);


  case KatSopr.VidSopr of
    101, 111: Result :=  MakePrihOrder;
    201, 204, 211: Result :=  iMakeOrder.MakeRashOrd (KatSopr.NRec, False, OprDate, 0, 0, 2, LogHandle);
  end;
  UnBindEvent(CanMakeOrder, iMakeOrder.CanMakeOrder);

  if Result
    WriteProtokol('Формирование завершено.', 3);
  Result := true;
}

!-------------------------------------------------------------------------------------------------------------
! Установка заданного номера и даты для СФ
!-------------------------------------------------------------------------------------------------------------
function UpdateSchFact: boolean;
{
  Result := true;
  /*if (SfNum = '')
    Exit;        */
  if not iDocTune.NeedMake(cgOper_SchFact) or not NeedMakeSF
    Exit;
  if (GetFirst KatSopr != tsOk)
    Exit;
  if ( GetFirst SchFact = tsOk )
  {

    //ели одинаковые то и нечего апдейтить
    if ( (SchFact.Num = SfPar.sNum) and (SchFact.DFACT = SfPar.dDate)
       and (SchFact.DReg = SfPar.dRegDate) and (SchFact.cRecs[3] = SfPar.cStatusBuh)  )
      Exit;
    // если не задано то пропишем в аттрибуты накладной из счета фактуры
    SfPar.sNum       := if(SfPar.sNum = ''     , SchFact.Num      , SfPar.sNum);
    SfPar.dDate      := if(SfPar.dDate = 0     , SchFact.DFACT    , SfPar.dDate);
    SfPar.dRegDate   := if(SfPar.dRegDate = 0  , SchFact.DReg     , SfPar.dRegDate);
    SfPar.cStatusBuh := if(SfPar.cStatusBuh = 0, SchFact.cRecs[3], SfPar.cStatusBuh);

    iViewSchF.SetNumDate(SfPar, KatSopr.Nrec);
    if ( (update current SchFact set SchFact.Num      := SfPar.sNum
                                  , SchFact.DFACT     := SfPar.dDate
                                  , SchFact.DReg      := SfPar.dRegDate
                                  , SchFact.cRecs[3] := SfPar.cStatusBuh
         ) != tsOk )
    {
      WriteProtokol('Ошибка обновления документа для учета НДС.' );
      Result := false;
      Exit;
    }

  }
  else
  {
    Result := false;
    WriteProtokol('Ошибка изменения параметров документа для учета НДС.');
    _raise ExSchFactNotFound;
  }
  Result := true;
}

!-------------------------------------------------------------------------------------------------------------
!Удаление Хоз. операции
!-------------------------------------------------------------------------------------------------------------
function DeleteBookHozOper: boolean;
var
  wBookType
  ,wDirect: word;
  cSchFactD : tNRec;
{
  Result := false;
  WriteProtokol('Удаление ХозОперации к записям в книге покупок/продаж:') ;
  wBookType := iDocTune.GetBookType;

  if(KatSopr.VidSopr != Word(204))
  {
/*    if (wBookType = 0)
    {
      WriteProtokol(' Не найдена хозоперация к записям в книге покупок/продаж', 3);
      Exit;
    }
        */
  cSchFactD := SchFact.Nrec;

  _loop BookPrZk where ((cSchFactD == BookPrZk.cSchFact))
  {
/*    if (BookPrZk.TipUser != wBookType)
      continue; */

    wDirect := word(SubStr(BookPrZk.TipUser, 1, 2));
    if (not DeleteHozOperBySh(wDirect, BookPrZk.Nrec)      )
    {
      WriteProtokol('Ошибка удаления ХозОпераций к записям в книге покупок/продаж.', 3);
      Exit;
    }
   }
  } // if(KatSopr.VidSopr != Word(204))
  else
   DeleteBookHozOper204;

  Result := true;
}

!-------------------------------------------------------------------------------------------------------------
!Удаление счетов фактур
!-------------------------------------------------------------------------------------------------------------
function DeleteSchFact: boolean;
var
  MarkerSchF: longint;
  cSF: tNrec;
{
  Result := false;
  _try
  {
/*    if not iDocTune.NeedMake(cgOper_SchFact) or not NeedMakeSF
    {
      Result := true;
      Exit;
    } */
    if (KatSopr.cSchFact = Comp(0))
    {
      Result := true;
      Exit;
    }

    if (GetFirst FastFirstRow SchFact where((KatSopr.cSchFact == SchFact.NRec)) != tsOk)
    {
      WriteProtokol('Удаление документа для учета НДС. Некорректная ссылка NREC: ' +  KatSopr.cSchFact);
      Exit;
    }
    DeleteBookHozOper;
    WriteProtokol('Удаление документа СФ № ' + SchFact.Num + ' от ' + string(SchFact.DFACT));
    SfPar.sNum       := SchFact.Num  ;
    SfPar.dDate      := SchFact.DFACT;
    SfPar.dRegDate   := SchFact.DReg ;
    SfPar.cStatusBuh := SchFact.cRecs[3];

    iViewSchF.SetNumDate(SfPar, KatSopr.Nrec);

    if ( not iSF.DoInit(GetDirectShFact) )
      _raise ExSchFactNotInited;
    iSF.SetMsgState(true);
    //viTotalLogV1.vip убить мсг тама
    Result := iSf.DeleteSchFact(KatSopr.cSchFact);


    if (GetFirst FastFirstRow SchFact where((KatSopr.cSchFact == SchFact.NRec)) = tsOk)
    {
      Result := false;
      WriteProtokol('Документ не удален.', 3);
    }
    else
    {
       If GetFirst KatSopr != tsOk
         Exit;
       /*if(pIsprDoc.IsIspr(KatSopr.NRec))
       {
         pIsprDoc.DeleteIsprRecs(KatSopr.cAdoc);
       }*/
    }
  }
}
!-------------------------------------------------------------------------------------------------------------
!Регистрация СФ
!-------------------------------------------------------------------------------------------------------------
function RegisterSchFact:boolean;
var
  tmpSchDate
, tmpDateOpr: date;
{
  Result := false;
  _try
  {
    if not iDocTune.NeedMake(cgOper_SchFactReg) or not NeedMakeSF
    {
      Result := true;
      Exit;
    }
    if ( not iSF.DoInit(GetDirectShFact) )
      _raise ExSchFactNotInited;

    iSF.SetMsgState(true);
    if (GetFirst KatSopr != tsOk)
      Exit;
    tmpDateOpr := KatSopr.dOpr;
    if ( GetFirst SchFact = tsOk )
    {

     WriteProtokol('Регистрация документа для учета НДС № ' + if(SfPar.sNum != '', SfPar.sNum, SchFact.Num) +
                   ' от ' + if(SfPar.dDate != 0, string(SfPar.dDate), string(SchFact.DFACT)));
     if(SfPar.dRegDate != SchFact.dPost) and (SfPar.dRegDate != 0)
      {
       // SfRegDate  := if(SfRegDate = 0, SchFact.DReg , SfRegDate);
        tmpSchDate := SchFact.DPost;

        if ((update current SchFact set SchFact.DPost := SfPar.dRegDate) != tsOk){}


      }
      if iSF.Register(SchFact.Nrec)
      {
        if (SchFact.DPost = 0)
          if ((update current SchFact set SchFact.DPost := SchFact.DReg ) != tsOk){}
        WriteProtokol('Документ зарегистрирован.', 3);

//        pIsprDoc.CheckSFRegister(SchFact.Nrec, KatSopr.wAdoc);
        /*if(pIsprDoc.IsIspr(KatSopr.NRec))
        {
          pIsprDoc.CreateRecords(SchFact.Nrec, KatSopr.VidSopr);

        }*/
      }
      else
        _raise ExSchFactNotRegistred;
    }
    else
      _raise ExSchFactNotFound;

    Result := true;
  }
  _finally
  {
    if(tmpDateOpr != KatSopr.dOpr)
      if ((update current KatSopr set KatSopr.dOpr := tmpDateOpr) != tsOk){}
  }

}

!-------------------------------------------------------------------------------------------------------------
! Установка договора из накладной
!-------------------------------------------------------------------------------------------------------------
Function MakeBaseDocToSF: boolean;
{
   Result := false;

   if(GetFirst BaseDoc1 Where ((SchFact.cBaseDoc == BaseDoc1.Nrec)) =tsOk)
    {
      Result := True;
      Exit;
    }

    if(GetFirst Dogovor Where ((KatSopr.cDogovor == Dogovor.Nrec)) != tsOK)
      Exit;


    if(GetFirst BaseDoc1 Where ((Dogovor.Nrec ==  BaseDoc1.cDogovor AND Word(211) == BaseDoc1.VidDoc)) !=tsOk)
    { // Создаем
      ClearBuffer(#BaseDoc1);
        BaseDoc1.VidDoc   := 211;
        BaseDoc1.NoDoc    := Dogovor.NoDoc;
        BaseDoc1.dForm    := Dogovor.dDoc;
        BaseDoc1.dDoc     := Dogovor.dDoc;
        BaseDoc1.YearDoc  := Year(BaseDoc1.dDoc);
        BaseDoc1.cDogovor := Dogovor.Nrec;
        BaseDoc1.Name     := 'по договору';
        BaseDOC1.FilialNo := lGetTune('Konsolid.FilialNo');
        BaseDOC1.KolDn    := wGetTune('Oper.SrokSch'); //word "количество дней действия счета",
        BaseDOC1.Descr    := sGetTune('User.Descr');
        BaseDOC1.DesGr    := sGetTune('User.DesGr');
        BaseDOC1.cOrg     := Dogovor.cPlat;
        BaseDOC1.Status   := Word(2);
        BaseDOC1.cNote    := oNotes.GetFirstNote(Word(40), BaseDOC1.Status);
      Insert Current BaseDoc1;
    }

    if(GetFirst StepDoc1 Where ((BaseDoc1.Nrec ==  StepDoc1.cBaseDoc)) !=tsOk)
    { // Создаем
       ClearBuffer(#StepDoc1);
        StepDoc1.cBaseDoc := BaseDoc1.Nrec;
        StepDoc1.Name     := BaseDoc1.Name;
        StepDoc1.nStep    := Word(1);
        StepDoc1.dStart   := BaseDoc.dDoc;
        StepDoc1.dEnd     := BaseDoc.dDoc;
        StepDoc1.Status   := Word(2);
       Insert Current StepDoc1;
    }

    SchFact.cBaseDoc := StepDoc1.cBaseDoc;
    SchFact.cStepDoc := StepDoc1.Nrec;
    Update Current SchFact;

   Result := True;
} // function MakeBaseDocToSF

