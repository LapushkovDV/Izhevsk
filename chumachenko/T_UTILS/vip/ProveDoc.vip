!-------------------------------------------------------------------------------------------------------------
!Установка статуса документа, статус берется из DocTune
!-------------------------------------------------------------------------------------------------------------
procedure SetGalStatus(wNum: word);
var
  iStatlog      : vipStatlog;
  cNewStat : tNRec;
  wNewStat : word;
{
  cNewStat := iDocTune.GetDocStatus(wNum);
  if GetFirst KatNotes where ((cNewStat == KatNotes.NRec)) = tsOk
    wNewStat := KatNotes.Status;
  if GetFirst KatSopr != tsOk
    Exit;

  if KatSopr.Status = wNewStat
    Exit;                    // KatSopr.VidSopr
//                                  , word(1024+1)
  iStatlog.StatLog_InsNewStat(word(100), KatSopr.Nrec, KatSopr.Status, KatSopr.cNote,
                                wNewStat, cNewStat,
                                if(wNum = 4, 'проведение документа', 'отмена проведение документа')
                              );
  KatSopr.Status := wNewStat;
  KatSopr.cNote  := cNewStat;
  //KatSopr.cZakaz := iDocTune.GetDocStatus(cgStatus_ControlProve);
  Update_Current_KatSopr;
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
function CheckStatus(wStatus: word): boolean;
{
  Result := (wStatus != 4);
}
!-------------------------------------------------------------------------------------------------------------
!Инициализация настроек документа
!-------------------------------------------------------------------------------------------------------------
function InitDocTune: boolean;
{
  Result := false;
  _try
  {
    iDocTune := new(DocTune, InitDoc(KatSopr.VidSopr));
    if not iDocTune.SetTune(KatSopr.cIzd, KatSopr.wcIzd)
      _raise  ExDocTuneNotLoad;
    if (not iDocTune.isAvaliableCommand(1) )
      _raise  ExDocTuneNotAccepted;
    if (not CheckStatus(KatSopr.Status) )
      _raise  ExStatusNotAccepted;

    iViewSchF.SetSchFact(KatSopr.cSchFact, KatSopr.Nrec, false);

    Result := true;
  }
  _except
    on ExRef: Message('Ошибка загрузки объекта настроек для документа.'#13 + 'Обратитесь к разработчикам!');
    on ExDocTuneNotLoad: Message('Ошибка загрузки настроек для документа.');
    on ExDocTuneNotAccepted: Message('Вам запрещено модифицировать документ с данным видом операции.', Error);
    on ExStatusNotAccepted:  Message('Статус документа запрещает его модификацию .', Error);
}

!-------------------------------------------------------------------------------------------------------------
! Закрытый период бух. контура
!-------------------------------------------------------------------------------------------------------------
Function boClosePeriod:boolean;
Var
  dtECBUH : Date;
  ModAfterClose : Word;
{
    Result := True;
    dtECBUH := dGetTune('FIN.USER.DTECBUH');
    ModAfterClose:= wGetTune('FIN.USER.MODAFTERCLOSE');

    if(KatSopr.dSopr < dtECBUH)
    {
       Case ModAfterClose of
        0 : {}
        1 : {
               if(Message('Документ находится в закрытом отчетном периоде. Продолжить проведение?',YesNo)<>cmYes)
                exit;
            }
        2 : {
               Message('Документ находится в закрытом отчетном периоде. Модификация запрещена!');
               exit;
            }
       End; //case
    }

    Result := false;
} // function boClosePeriod

!-------------------------------------------------------------------------------------------------------------
!Отмена проведения документа
!-------------------------------------------------------------------------------------------------------------
function DeleteProve(cKatSopr: tNRec): boolean;
{
  Result := true;
  _try
  {
    par_KatSopr := cKatSopr;
    MyBeginVisual('Отмена проведение документа...');
    if (GetFirst KatSopr != tsOk)
      Exit;


    if(boClosePeriod)
      exit;

    if not InitDocTune
      Exit;
    Result := Result and DeleteHozOper;
    Result := Result and DeleteOrders;
    if Result
    {
      if GetFirst KatSopr != tsOk
        Exit;
      case KatSopr.VidSopr of
        111:
        {
          KatSopr.cPodrTo := 0;
          KatSopr.cMolTo  := 0;
          Update current KatSopr;
        }
      end;
    }

    Result := Result and if(KatSopr.VidSopr !=Word(204),DeleteSchFact,DeleteBookHozOper);

    SetGalStatus(cgStatus_GalUnProved);
    //если отменяем из создания и отмена прошла не полностью, то статус ставим проведен
  }
  _finally
  {
    MyStopVisual;
    ShowProtokol;
    iDocTune := NullRef;
  }
}

!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
function CheckDataAll: boolean;
{
  Result := false;
  If KatSopr.cOrgBase = 0
  {
    WriteProtokol('Необходимо заполнить поле "Организация-контрагент".');
    exit;
  }

  if (not IsValid(#SpSopr))
  {
    WriteProtokol('Нет спецификации по документу.');
    Exit;
  }

   if(iDocTune.wGetParamTune('wParSFB') = Word(0))
    If ( (KatSopr.dSopr > SfPar.dDate) and (SfPar.dDate != 0) )
      or ( (KatSopr.dSopr > SfPar.dRegDate) and (SfPar.dRegDate != 0) )
    {
      Message('Дата СФ не может быть меньше даты накладной.');
      WriteProtokol('Дата СФ не может быть меньше даты накладной.');
      Exit;
    }
  Result := true;
}


!-------------------------------------------------------------------------------------------------------------
! проведение документа
!-------------------------------------------------------------------------------------------------------------
Function RunMake: boolean;
{
  Result := false;
  _try
  {

    if not MakeSkladOrder
      _raise ExMakeSklOrder;

    if(KatSopr.VidSopr !=Word(204))
     MakeMySchFact;// эксепшн генерится внутри и сюда упадет

    if not MakeHozOper
      _raise ExMakeHozOper;

    if(KatSopr.VidSopr !=Word(204))
    {
      UpdateSchFact;
      RegisterSchFact; //сразу не находит schfact, не критично
      MakeBookHozOper;
    }
    else
    {
      MakeBookHozOper204;
    }
    Result := true;
  }
  _except
    on ExUserBreak:
    {
      Message('Break');
      WriteProtokol('Формирование прервано пользователем!' , 1);
    }
    //обработка ошибок формирования Ордеров
    on ExMakeSklOrder:
      WriteProtokol('Складские ордера не сформированы...');
    //обработка ошибок формирования СФ
    on ExSchFactNotInited:
      WriteProtokol('Не проинициализирован модуль обработки документов для учета НДС');
    on ExSchFactNotCreated:
      errr2.Write('Документ для учета НДС не создан...');
    on ExSchFactDoError:
      WriteProtokol( 'Документ связан с ДО другого типа.'#13#3 + 'В этом случае документ для учета НДС должен формироваться'#13#3 + 'по хозоперации и рассматриваться как оплата.', 3);
    on ExSchFactNotRegistred:
      WriteProtokol('Документ для учета НДС не Зарегистрирован');
    on ExSchFactNotFound:
       WriteProtokol('Документ для учета НДС не найден.');
   //обработка ошибок формирования TXO
    on ExMakeHozOper:
      WriteProtokol('Ошибка привязки TXO');

}

!-------------------------------------------------------------------------------------------------------------
! проведение документа, если были ошибки, то отмена
!-------------------------------------------------------------------------------------------------------------
function MakeProve(cKatSopr: tNRec): boolean;
{
  par_KatSopr := cKatSopr;
  _try
  {
    Result := false;
    MyBeginVisual('Проведение документа...');
//    NeedAskDate := NeedProtokol;
    if (GetFirst KatSopr != tsOk)
      _raise ExMakeNoKatSopr;
    if not InitDocTune
      Exit;

    if(boClosePeriod)
      exit;

    if not GetMakeParams
      Exit;

     WriteProtokol(''#13 + GetTidkGalName(KatSopr.VidSopr) + ' № '  + KatSopr.NSopr + ' от ' + string(KatSopr.dSopr) + ':', 1);

     if(KatSopr.VidSopr = Word(204))
     {
       if not CheckData204
        _raise  ExMakeDataNotValid;
     }
     else
     {
      if not CheckDataAll
        _raise  ExMakeDataNotValid;
     }


    //если были ошибки при формировании, отменим проведение
    //if
     RunMake;
      SetGalStatus(cgStatus_GalProved);
    /*else
      DeleteProve(cKatSopr);*/
    Result := true;
  }
  _except

    on ExMakeNoKatSopr:
      WriteProtokol('Ошибка позиционирования KatSopr.Nrec: ' + string(par_KatSopr), 1);
    on ExMakeDataNotValid:
      WriteProtokol('Документ оформлен неправильно!!!', 1);
  _finally
  {
    MyStopVisual;
!    ShowProtokol;
    if not NullVipRef(iDocTune)
      iDocTune := NullRef;
  }

}
!-------------------------------------------------------------------------------------------------------------
! Показать протокол
!-------------------------------------------------------------------------------------------------------------
procedure ShowProtokol;
{
  if (NeedProtokol and (LogHandle != 0))
    Form_ShowFile('Протокол формирования', false, LogHandle);
}
!-------------------------------------------------------------------------------------------------------------
! Включение/отключение протокола
!-------------------------------------------------------------------------------------------------------------
Procedure EnableProtokol(flag: boolean; lHandle : longint = 0);
{
  if (NeedProtokol and not flag)
    Form_AbortForm(LogHandle);
  NeedProtokol := flag;
  LogHandle := if(flag, if(lHandle = 0, Errr2.Handle, lHandle), 0);
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
Procedure SetDopParams(flag: word);
{
  NeedAskDate := ((flag and cgAskParams) > 0);
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
constructor Init;
{
  Result := true;
  NeedAskDate := NeedProtokol := false;

  LogHandle := 0;
  MyVisualCount := 0;
  SaveMyDsk(1, 'CheckNds_DontCheckProv');

  iSF := new(viSchFunc);
  iSF.SetMsgState(true);
  iViewSchF  := new(ViewSchF);
  oTL.TotalLogOpen;



}

destructor done;
{
  ShowProtokol;
  iSF       := NullRef;
  iViewSchF := NullRef;
  SaveMyDsk(0, 'CheckNds_DontCheckProv');
  oTL.TotalLogClose;
}
end. // interface
