          KatSopr.Summa += KSopr.Summa;
          update current KatSopr ;
          delete all mt_SpSopr;
          delete all mt_SpNal;
          _loop SpSopr where ((KatSopr.Nrec == SpSopr.cSopr))
          {
            ClearBuffer(#mt_SpSopr);
            mt_SpSopr.cSpSopr := SpSopr.Nrec;
            mt_SpSopr.doPrice := SpSopr.Price;
            mt_SpSopr.doRPrice := SpSopr.RPrice;
            mt_SpSopr.doKol := SpSopr.KolOpl;
            insert current mt_SpSopr;
            if GetFirst SpDocNal where ((SpSopr.NRec == SpDocNal.cSpDoc)) = tsok
            {
              mt_SpNal.cSpDoc := SpDocNal.Nrec;
              mt_SpNal.doSumma := SpDocNal.Summa;
              insert current mt_SpNal;
            }

            if (GetFirst SpSoprSrc where ((SPSOPR.CADOCSP == SpSoprSrc.Nrec )) = tsOk)
            {
              if GetFirst SpDocNalSrc where ((SpSoprSrc.NRec == SpDocNalSrc.cSpDoc)) = tsOk
              {
                 SpDocNal.Summa +=SpDocNalSrc.Summa;
                 update current SpDocNal;
              }

              SpSopr.Price := KDPriceNew;
              SpSopr.RPrice := KDPriceNew;
              SpSopr.KolOpl   := KDKolNew;
              update current SpSopr;
            }

          }

        }  */
!        Message('ok');

      //}
      if ( NOT iSF.CreateSFbyKatSopr(KatSopr.NRec) )
        _raise ExSchFactNotCreated;

      If GetFirst KatSopr != tsOk
          Exit;
      /*if(pIsprDoc.IsIspr(KatSopr.NRec))
      {
        KatSopr.wAdoc := KS.wAdoc;
        KatSopr.Summa := KS.Summa;
        update current KatSopr ;
        _loop SpSopr where ((KatSopr.Nrec == SpSopr.cSopr))
        {
          if (GetFirst mt_SpSopr where ((SPSOPR.NRec == mt_SpSopr.cSpSopr )) = tsOk)
          {

            SpSopr.Price := mt_SpSopr.doPrice;
            SpSopr.RPrice := mt_SpSopr.doRPrice;
            SpSopr.KolOpl:= mt_SpSopr.doKol;
            update current SpSopr;
          }
          _loop SpDocNal   where ((SpSopr.NRec == SpDocNal.cSpDoc))
          {
