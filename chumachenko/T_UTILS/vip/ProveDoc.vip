Table struct tSpSch
(
   cMcUsl    : Comp
 , cParty    : Comp
 , dCur      : Double
 , dOst      : Double
 , cSchfact  : Comp
)
With Index
(
   tIdx00 = cMcUsl+cParty
);

Table Struct tSpAkt
(
   Nrec      : Comp
 , cMcUsl    : Comp
 , cParty    : Comp
 , cSpSopr   : Comp
 , Sum       : Double
 , Kol       : Double
)
With Index
(
   tIdx00 = Nrec
);

Table struct mt_SpSopr
(
   cSpSopr    : Comp
 , doPrice    : Double
 , doRPrice   : Double
 , doKol      : Double
)
With Index
(
   tIdx00 = cSpSopr
);

Table struct mt_SpNal
(
   cSpDoc    : Comp
 , doSumma      : Double

)
With Index
(
   tIdx00 = cSpDoc
);

Create view vView
var
  par_KatSopr : tNRec;
  dPrice: date;
  OprDate
/*, SfDate
, SfRegDate*/  : date;
/*  SfNum : string;*/

  wSP, wMode: word;

  IsRecModif
  ,NeedProtokol
  ,NeedAskDate: boolean;
  LogHandle : longint;


As Select
  oCorrDocFun.GetKDKolOld(SpSopr.cADocSp, SpSopr.cSopr)
         (FieldName = KDKolOld)

, KDKolOld + if (SpSopr.Kol <> 0, SpSopr.KolOpl, 0)
         (FieldName = KDKolNew)

,  oCorrDocFun.GetKDSummaOld(SpSopr.cADocSp, SpSopr.cSopr, KatSopr.cVal)  (FieldName = KDSummaOld)
//-----------------------------------------------------------------------------
, if (KatSopr.cVal = 0, SpSopr.Price, SpSopr.VPrice) * SpSopr.KolOpl
  + oCorrDocFun.GetKDSummaOld(SpSopr.cADocSp, SpSopr.cSopr, KatSopr.cVal) (FieldName = KDSummaNew)

, KDSummaNew / KDKolNew     (FieldName = KDPriceNew)
//-------
, *
From
  BookPrZk
, Dogovor
, KatMc
, KatParty
, HozOper
, KatNotes
, KatPayment
, KatSopr
, KatSopr  KSopr
, SklOrder
, SoprHoz
, SpSopr
, SpSopr SpSoprSrc
, SpecZatr SpecZatr2

, StepDoc StepDoc1
, BaseDoc BaseDoc1
, SpDocNal SpDocNalSrc
, tSpSch
, tSpAkt
, SpSopr SpSopr1
Where
((
    par_KatSopr      == KatSopr.NRec
AND KatSopr.NRec     == SpSopr.cSopr
AND SpSopr.cMcUsl    == KatMc.Nrec

AND KatSopr.cStepDoc == StepDoc.NRec
AND StepDoc.cBaseDoc == BaseDoc.NRec
AND KatSopr.cSchFact == SchFact.NRec
AND KatSopr.cPayment == KatPayment.NRec
//AND SoprHoz.cHozOper == HozOper.NRec

!AND SchFact.cBaseDoc == BaseDoc1.Nrec;
!AND SchFact.cStepDoc == StepDoc1.Nrec;
))
;
