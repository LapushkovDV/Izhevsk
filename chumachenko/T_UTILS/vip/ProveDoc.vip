window wnParams 'Формирование сопроводительных документов' gray, EscClose, doAccept ;
Show At(,,45,8)
screen scParams;
Fields
  OprDate      ('Введите дату')         : [, 'DD/MM/YYYY'],NoProtect;
  [NDSNAME]    'Документ для учета НДС' : Skip;
  SfPar.dDate  ('Введите дату')         : [, 'DD/MM/YYYY'],NoProtect;
  SfPar.dRegDate  ('Введите дату')      : [, 'DD/MM/YYYY'],NoProtect;
  SfPar.sNum                            : NoProtect;

Buttons
  cmOk,Default,, 'Ввод',   , scGalDial;
  cmCancel,,,    'Отмена', , scGalDial;

<<
`Дата оприходования:`&.@@@@@@@@@@@
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Дата:            `&.@@@@@@@@@@@
`Дата регистрации:`&.@@@@@@@@@@@
`Номер:            `.@@@@@@@@@@@@@@@@@@@@@@@@
  <.~П~родолжить.>       <. ~О~тмена .>
>>
end;

HandleEvent
cmInit:
{
  if iDocTune.NeedMake(cgOper_SchFact)
  {
    SetFieldVisible(#SfPar.dDate, true);
    ShowLabel4Field(#SfPar.dDate);
    SetFieldVisible(#SfPar.dRegDate, true);
    ShowLabel4Field(#SfPar.dRegDate);
    SetFieldVisible(#SfPar.sNum, true);
    ShowLabel4Field(#SfPar.sNum);
    SetFieldVisible(#NDSNAME, true);
  }
  else
  {
    SetFieldVisible(#SfPar.dDate, false);
    HideLabel4Field(#SfPar.dDate);
    SetFieldVisible(#SfPar.dRegDate, false);
    HideLabel4Field(#SfPar.dRegDate);
    SetFieldVisible(#SfPar.sNum, false);
    HideLabel4Field(#SfPar.sNum);
    SetFieldVisible(#NDSNAME, false);
  }

}
cmOk:
{
  if(SfPar.dDate > SfPar.dRegDate)
  {
    Message('Дата регистрации не может быть меньше даты формирования СФ.');
    Exit;
  }
  if(SfPar.dDate > SfPar.dRegDate)
  {
    Message('Дата регистрации не может быть меньше даты формирования СФ.');
    Exit;
  }
  PutCommand(cmDefault);
}
 // CloseWindow(wnParams);
end;

end;
