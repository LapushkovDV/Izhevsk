#ifndef _KatSoprToBaseDoc_VPP
#define _KatSoprToBaseDoc_VPP

Function KatSoprToBaseDoc: word;
{
  Case KatSopr.VidSopr of
  //---------------------
   114,
   211,
   106: Result := 201;
  //---------------------
   110: Result := if (KatSopr.TipSopr = 1, 101, 201);
  //---------------------
   108,
   111,
   206: Result := 101;
  //---------------------
   203: Result := 102;
  //---------------------
   103: Result := 102;
  //---------------------
   102,
   251: Result := 202;
  //---------------------
   502..508
      : Result := 501;
  //---------------------
   511,
   512,
   513: Result := 510;
  //---------------------
   521,
   522,
   523: Result := 520;
  //---------------------
   551,
   552,
   553,
   554,
   557: Result := 550;
  //---------------------
  1411: Result := 1410;
  //---------------------
  1421: Result := 1420;
  //---------------------
  else  Result := KatSopr.VidSopr;
  //---------------------
  end;
}

#end