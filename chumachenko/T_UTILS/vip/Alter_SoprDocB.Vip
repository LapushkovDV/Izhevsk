// Interface
//------------------------------------------------------------------------------
HandleEvent


cmInit :
{
  typesopr := 101;
  if(inherited :: HandleEvent (cmInit)!=heOk)
  {
    Abort;
    Exit;
  }


  InitEmbededObj;
  ProtectMode := 0;
/*  if ((RunMode and 1) = 1)
  {
    RunWindowModal(EditSopr);
    Abort;
    Exit;
  }                       */

}
cmValue53: ProveCurDoc;
cmValue52: UnProveDoc;
cmDone:
{
  iDocTune := NullRef;
}
end;
end. // interface
