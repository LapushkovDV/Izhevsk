procedure SetEmbeddedParams(cFormat: longint = 0);  forward;
function IsUnProvedAvaliable: boolean;
{
  Result := (iDocTune.IsDocProoved and (ProtectMode = 0));
}

function IsProvedAvaliable: boolean;
{
  Result := ((not iDocTune.IsDocProoved) and (ProtectMode = 0));
}

procedure CheckButtonVisible;
{
  ShowButton (scrButHeader, cmValue52, IsUnProvedAvaliable);
  ShowButton (scrButHeader, cmValue53, IsProvedAvaliable);
}
procedure ProveCurDoc; forward;
procedure UnProveDoc; forward;

