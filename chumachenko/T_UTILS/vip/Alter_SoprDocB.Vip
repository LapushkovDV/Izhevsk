!-------------------------------------------------------------------------------------------------------------
! При изменении типа документа вызовется эта функция
!-------------------------------------------------------------------------------------------------------------

function onCfgObjects(ObjType: word; cfgFName: string; flag: word): boolean;
{
  Result := true;
  case ObjType of
    cgObject_Tab:
    {
      SetTabbedSheetVisible(brbyName    , (flag and cgTab_1) > 0);      //МЦ
      SetTabbedSheetVisible(brSopUsl    , (flag and cgTab_2) > 0);      //Услуги
    }
    cgObject_Visible:
    {
      case flag of
        cgAction_Show:
        {
         // cfsGetObjInfo (cfgFName , sFullName, pMainScr, pCont, lObjType);
         // cfsSetProp(pMainScr, cfpVisible, true);
          cfsSetProp(cfgFName, cfpVisible, true);
          cfsSetProp(cfgFName, cfpHidden, false);
        }
        cgAction_Hide:
        {
          //cfsGetObjInfo (cfgFName , sFullName, pMainScr, pCont, lObjType);
          //cfsSetProp(pMainScr, cfpVisible, false);
            cfsSetProp(cfgFName, cfpVisible, false);
            cfsSetProp(cfgFName, cfpHidden, true);

        }
        cgAction_Protect: cfsSetProp(cfgFName, cfpProtect, true);
        cgAction_UnProtect: cfsSetProp(cfgFName, cfpProtect, false);
      end;
    }
    cgObject_Requied:
    {
      var val, err, msg: string;
      var errr : longint;        //cfpFontBackColor почему то не понимает, когда поймет раскоментить надо
  /*    if (cfsGetProp(cfgFName, cfpFieldName, val) != cfOk)
      {
        Result := false;
        Exit;
      }    */
      errr := cfsGetProp(cfgFName, cfpFieldName, val);
     // Message(err);
      msg := trim(LotExpressionFunc(val, err));


      if (msg = '') or (msg = 'Ошибка при вычислении')
      {
!        cfsSetProp(cfgFName, cfpFontBackColor , ColorNeed);
        Result := false;
      }
/*      else
        cfsSetProp(cfgFName, cfpFontBackColor, 0);
*/    }
  end;
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
procedure SetEmbeddedParams(cFormat: longint = 0);
var
  OldType: tNRec;
  OldwcIzd: word;
  isSchFact: boolean;
  isProtected: boolean;
{

  iDocTune.SetDocStatus(KatSopr.Status);
  isProtected := iDocTune.IsDocProtected or (ProtectMode = 1);

  if (CurWindow <> wnMainWindow)
  {
    iDocTune.SetTune(KatSopr.cIzd, KatSopr.wcIzd);
    if ((OldType != KatSopr.cIzd) or (OldwcIzd != KatSopr.wcIzd)) and not IsProtected(#KatSopr)
    {
      set KatSopr.cIzd := KatSopr.cIzd;

      if not IsNew
        update current KatSopr;
      else
        insert current KatSopr;
      RereadRecord;
    }
    if (cFormat = 0)
      cFormat := CurFormatInArea(brbyName);

    CheckButtonVisible;
  }


}
#CreateFieldList

function onCreateObjectsAn(p_sNameObj: string; p_wKodAn: word): boolean;
{
  Result := True;
  CreateFieldList(p_sNameObj, p_wKodAn);
}

procedure InitEmbededObj;
{
  iDocTune   := new(DocTune, InitDoc(KatSopr.VidSopr));
  BindEvent(onCfgObjects, iDocTune.Event_onCfgObjects);
  BindEvent(onCreateObjectsAn, iDocTune.Event_onCreateObjectsAn);
  SetEmbeddedParams;
}
procedure UnProveDoc;
var
  iProveDoc  : ProveDoc noauto;
{
  SetFormat(brbyName);
  iProveDoc  := new(ProveDoc);
  iProveDoc.EnableProtokol(true);
  if ( UpDateTable )
    iProveDoc.DeleteProve(KatSopr.NRec);

  RereadRecord;
  SetEmbeddedParams;

  iProveDoc  := NullRef;
}
function CheckSumOborot: boolean;
var
  SumOb: double;
{
  SumOb := 0;
  _loop oborot where ((KatSopr.VidSopr == oborot.TiDk and KatSopr.Nrec  == oborot.cSoprDoc))
  {
    if (oborot.VhProp != '+')
      continue;
    SumOb += Oborot.SumOb;
  }
  Result := ( abs(KatSopr.Summa - SumOb) < 0.009);

}
!-------------------------------------------------------------------------------------------------------------
!Проведение документа
!Если были какие то ошибки
!-------------------------------------------------------------------------------------------------------------
procedure ProveCurDoc;
var
  tmpSkl: comp;
  tmpMol: comp;
  iProveDoc : ProveDoc noauto;
  errMsg    : string;

{
  if not  iDocTune.CheckFields(errMsg)
  {
    Message('Не все необходимые поля заполнены!!!'#13 + 'Не заполнены поля:'#13 +errMsg, Error);
    Exit;
  }

  
  tmpSkl := tmpMol := 0;

  SetFormat(brbyName);
  if ( UpDateTable )
  {

    if (not  oSoprOrdB.CheckSoprOrdB(KatSopr.NRec, KatSopr.cPodrTo, KatSopr.cMolTo, true, if (KatSopr.VidSopr = 101, True, False),  False, False, 0, 0))
    {
      Message('Складские ордера не сформированы...', CancelButton);
      StopVisual('', 0);
      Exit;
    }

    iProveDoc  := new(ProveDoc);
    iProveDoc.EnableProtokol(true);
    iProveDoc.SetDopParams(cgAskParams);
    if(iProveDoc.MakeProve(KatSopr.NRec))//
      if not CheckSumOborot
      {
        iProveDoc.EnableProtokol(false);
        iProveDoc  := NullRef;
        Message('Сумма оборотов не совпадает с суммой накладной.'#13 + 'Операция будет отменена' , Error);
        UnProveDoc;
      }
      else
        iProveDoc  := NullRef;

    if not CheckSumOborot
    {
      iProveDoc.EnableProtokol(false);
      iProveDoc  := NullRef;
      Message('Сумма оборотов не совпадает с суммой накладной.'#13 + 'Операция будет отменена' , Error);
      UnProveDoc;
    }
    else
      iProveDoc  := NullRef;

  }
  RereadRecord;
  SetEmbeddedParams;
}




TableEvent Table KatSopr
cmSetDefault:
{
  ClearBuffer(#KatSopr);
  if(inherited :: HandleEvent (cmSetDefault)=heOk)
  {
    SetEmbeddedParams;
  }
}
end;
