//------------------------------------------------------------------------------
// Акты дооценки
//------------------------------------------------------------------------------
Function FilltSpAkt : Boolean;
{
  Result := False;
  Delete All tSpAkt;

  vliSQLStmt := sqlAllocStmt;

  #ss Select                                                                                       #se
  #ss   SpSopr.Nrec                                                                                #se
  #ss , SpSopr.cMcUsl                                                                              #se
  #ss , SpSopr.cParty                                                                              #se
  #ss , SpO.cSpSopr                                                                                #se
  #ss , SpO.Sum                                                                                    #se
  #ss , SpF.Kol                                                                                    #se
  #ss From                                                                                         #se
  #ss  SpSopr                                                                                      #se
  #ss  Join ( Select SpOrder.cSpSopr,SpOrder.cMc, SpOrder.cParty                                   #se
  #ss                , Sum(Coalesce(SpOrder.SrPrice,0)) Sum                                        #se
  #ss         From SpOrder                                                                         #se
  #ss         Where 0 = SpOrder.VidOrder AND 4 = SpOrder.TIPORD                                    #se
  #ss         Group By SpOrder.cSpSopr, SpOrder.cMc, SpOrder.cParty ) SpO                          #se
  #ss      on ( SpSopr.cMcUsl = SpO.cMc AND SpSopr.cParty = SpO.cParty )                           #se
  #ss Left Join ( Select SpSchf.cMcUsl, SpSchf.cParty                                              #se
  #ss             , Sum(Coalesce(SpSchf.KolOpl,0)*Coalesce(KatOtped.Koef,1)) Kol                   #se
  #ss             From SpSchf                                                                      #se
  #ss             Join Schfact on (SpSchf.cSchfact   = Schfact.Nrec AND 7300 = Schfact.TipUser)    #se
  #ss             Left Join KatOtped on (SpSchf.cOtped = KatOtped.Nrec)                            #se
  #ss             Group By SpSchf.cMcUsl, SpSchf.cParty ) SpF                                      #se
  #ss     on ( SpSopr.cMcUsl = SpF.cMcUsl AND SpSopr.cParty = SpF.cParty )                         #se
  #ss Where                                                                                        #se
  #ss    Comp('+String(Katsopr.Nrec)+') = SpSopr.cSopr                                             #se
  #ss    AND SpSopr.KolFact >0                                                                     #se

   sqlSelectInto(vliSQLCommand, #tSpAkt);
   ClearQuery(vliSQLCommand);

   if ( vliSQLStmt <> 0)
     sqlFreeStmt(vliSQLStmt);
  Result := True;

} // function

//------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------
Function FilltSpSch(wPar: Word) : Boolean;
{
  Result := False;
  if (not IsValid(#SpSopr))
  {
    WriteProtokol('Нет спецификации по документу.');
    Exit;
  }

  Delete All tSpSch;

  vliSQLStmt := sqlAllocStmt;

  #ss  Select                                                                                        #se
  #ss    SpSopr.cMcUsl                                                                               #se
  #ss  , SpSopr.cParty                                                                               #se
  #ss  , Sum(Coalesce(SpSopr.KolFact,0))/Count(SpSopr.Nrec) dCur                                     #se
  #ss  , (Sum(Coalesce(SpSchf.KolOpl,0)*Coalesce(KatOtped.Koef,1))-Sum(Coalesce(SpSoprOld.KolFact,0)))/Count(SpSopr.Nrec) dOst #se

if(wPar = Word(0))
  #ss  , Comp(0)                                                                                     #se
else
  #ss  , SpSchf.cSchfact                                                                             #se

  #ss  From                                                                                          #se
  #ss   SpSopr                                                                                       #se
  #ss   Join SpSchf on (                                                                             #se
  #ss                        SpSopr.PrMc   = SpSchf.PrMc                                             #se
  #ss                    AND SpSopr.cMcUsl = SpSchf.cMcUsl                                           #se
  #ss                    AND SpSopr.cParty = SpSchf.cParty                                           #se
  #ss                  )                                                                             #se
  #ss   Join Schfact on (SpSchf.cSchfact   = Schfact.Nrec AND 7300 = Schfact.TipUser)                #se
  #ss   Left Join KatOtped on (SpSchf.cOtped = KatOtped.Nrec)                                        #se
  #ss   Left Join BookPrzk on                                                                        #se
  #ss                  (     SpSchf.cSchFact = BookPrzk.cSchfact                                     #se
  #ss                    AND 7450 = BookPrzk.TipUser                                                 #se
  #ss                    AND 1109 = BookPrZk.TipOtvPodr                                              #se
  #ss                  )                                                                             #se
  #ss   Left Join SpSopr SpSoprOld on                                                                #se
  #ss                  (                                                                             #se
  #ss                        BookPrZk.cOtvPodr = SpSoprOld.Nrec                                      #se
  #ss                  )                                                                             #se
  #ss  Where                                                                                         #se
  #ss   Comp('+String(Katsopr.Nrec)+') = SpSopr.cSopr                                                #se
  #ss  Group By                                                                                      #se
  #ss    SpSopr.cMcUsl                                                                               #se
  #ss  , SpSopr.cParty                                                                               #se
if(wPar != Word(0))
  #ss  , SpSchf.cSchfact                                                                             #se
  #ss  Having                                                                                        #se
  #ss   Sum(Coalesce(SpSchf.KolOpl,0))-Sum(Coalesce(SpSoprOld.KolFact,0))>0                          #se

   sqlSelectInto(vliSQLCommand, #tSpSch);
   ClearQuery(vliSQLCommand);

   if ( vliSQLStmt <> 0)
     sqlFreeStmt(vliSQLStmt);

  Result := true;

} // procedure FilltSpSch

function CheckData204: boolean;
{
  if not iDocTune.NeedMake(cgOper_HozOperBook)
  {
    Result := true;
    Exit;
  }

   Result := FilltSpSch(Word(1));

   if(NOT Result)
     Exit;

  _Loop SpSopr
  {
    if(Getfirst tSpSch Where ((SpSopr.cMcUsl == tSpSch.cMcUsl AND SpSopr.cParty == tSpSch.cParty))!=tsOK)
    {
      WriteProtokol('Позиция №'+String(SpSopr.Npp)+' '+KatMc.Name+' '
        +If(getFirst KatParty Where ((SpSopr.cParty == KatParty.Nrec))=tsOK,'Партия: '+KatParty.Name,'')+'. Нет СФ от поставщика.');
!      Result := false;
      continue;
    }

    Var _dOst:double; _dOst:=0;
    _Loop tSpSch Where ((SpSopr.cMcUsl == tSpSch.cMcUsl AND SpSopr.cParty == tSpSch.cParty))
      _dOst+=tSpSch.dOst;

    if(Round(tSpSch.dCur,4)>Round(_dOst,4))
    {
      WriteProtokol('Позиция №'+String(SpSopr.Npp)+' '+KatMc.Name+' '
      +If(getFirst KatPArty Where ((SpSopr.cParty == KatParty.Nrec))=tsOK,'Партия: '+KatParty.Name,'')
      +'. В акте '+String(tSpSch.dCur)+' больше, чем в СФ поставщика '+String(_dOst));
      _Loop tSpSch Where ((SpSopr.cMcUsl == tSpSch.cMcUsl AND SpSopr.cParty == tSpSch.cParty))
      {
        if(GetFirst SchFact Where ((tSpSch.cSchfact == SchFact.Nrec))=tsOk)
         WriteProtokol('СФ №'+SchFact.Num +DateToStr(SchFact.dFact,' от DD.MM.YYYY')+ ' остаток '+String(tSpSch.dOst));
      }

!      Result := false;
      continue;
    }

  }  // loop SpSopr

  if(Not Result )
   exit;

  Result := FilltSpSch(Word(1));

  FilltSpAkt;
  Result := true;
}

//------------------------------------------------------------------------------
// Создать рег. запись на акт дооценки
//------------------------------------------------------------------------------
Procedure MakeOneReginAkts;
Var
  wBookType
  ,wDirect: word;
  cSchFact: tNrec;
  isBookRec: boolean;
  wSh: word;
{

  _Loop tSpAkt Where ((SpSopr.Nrec == tSpAkt.Nrec))
  {
     if(GetFirst SpSopr1 Where ((tSpAkt.cSpSopr == SpSopr1.Nrec))!=tsOk)
      Continue;

     if(GetFirst SpSchf Where ((SpSopr1.cSpSchf == SpSchf.Nrec))!=tsOk)
      Continue;

     if(Getfirst Schfact Where ((SpSchf.cSchFact == Schfact.Nrec))!=tsOK)
     {
       WriteProtokol(' Не найдена СФ Nrec='+To_Char(SpSchf.cSchFact,20,0), 3);
       continue;
     }

/////////////////////////////
    ClearBuffer(#BookPrzk);
     BookPrzk.Nazn       := 'Дооценка. Акт №'+KatSopr.nsopr+DateToStr(KatSopr.dSopr,' от DD/MM/YYYY')+' МЦ:'+KatMc.Name;
     BookPrzk.cSchfact   := Schfact.Nrec;
     BookPrzk.TipUser    := Word(7450);
     BookPrzk.Direct     := Word(1);
     BookPrZk.TipOtvPodr := Word(1109);
     BookPrZk.cOtvPodr   := KatSopr.Nrec;
     BookPrZk.cRecs[10]  := SpSopr.Nrec;
     BookPrZk.dReg       := KatSopr.dSopr;

     BookPrzk.SubTip     := Word(7);
     BookPrzk.dReg       := KatSopr.dSopr;
     BookPrzk.dOpl       := BookPrzk.dReg;
     BookPrzk.dOpr       := BookPrzk.dReg;

     BookPrzk.NUM        := Schfact.Num;
     BookPrzk.cOrg       := Schfact.cOrg;
     BookPrzk.CBASEDOC   := Schfact.cBaseDoc;
     BookPrzk.CSTEPDOC   := Schfact.cStepDoc;

     Case Word(SpSchf.PercNDS) of
       18 :
            {
             BookPrzk.SUM[1]     := Round(tSpAkt.Sum/tSpAkt.Kol*SpSopr.KolFact,2);
             BookPrzk.SUM[2]     := Round(BookPrzk.Sum[1]*SpSchf.PercNDS/100,2);
            }
       10 :
            {
             BookPrzk.SUM[4]     := Round(tSpAkt.Sum/tSpAkt.Kol*SpSopr.KolFact,2);
             BookPrzk.SUM[5]     := Round(BookPrzk.SUM[4]*SpSchf.PercNDS/100,2);
            }
        0 :
            {
             BOOKPRZK.SUM[23]    := Round(tSpAkt.Sum/tSpAkt.Kol*SpSopr.KolFact,2);
             BOOKPRZK.SUM[9]     := BOOKPRZK.SUM[23];
             BOOKPRZK.SUM[19]    := BOOKPRZK.SUM[23];
             BOOKPRZK.SUM[28]    := BOOKPRZK.SUM[23];
            }
      end; //case


     BookPrzk.SUM[3]     := BookPrzk.SUM[1]+BookPrzk.SUM[2];
     BookPrzk.SUM[6]     := BookPrzk.SUM[4]+BookPrzk.SUM[5];

     BookPrzk.SUM[11]    := BookPrzk.SUM[1];
     BookPrzk.SUM[12]    := BookPrzk.SUM[2];
     BookPrzk.SUM[13]    := BookPrzk.SUM[3];
     BookPrzk.SUM[14]    := BookPrzk.SUM[4];
     BookPrzk.SUM[15]    := BookPrzk.SUM[5];

     BookPrzk.SUM[21]    := BookPrzk.SUM[3]+BookPrzk.SUM[6]+BOOKPRZK.SUM[23];
     BookPrzk.SUMMA      := BookPrzk.SUM[21];

     BookPrzk.SUM[30]    := 1; // хз чёйэта
     BookPrzk.DESCR      := sGetTune('User.Descr');
     BookPrzk.DESGR      := sGetTune('User.DesGr');
    Insert Current BookPrzk;

    wDirect := word(SubStr(BookPrZk.TipUser, 1, 2));

    ClearBuffer(#SoprHoz);
     SoprHoz.DATOB   := BookPrzk.dReg;
     SoprHoz.cSoprDoc:= BookPrzk.Nrec;
     SoprHoz.TipDoc  := wDirect;
     SoprHoz.TidkGal := wDirect;
     SoprHoz.NoDoc   := BookPrzk.Num;
     SoprHoz.Descr   := BookPrzk.Descr;
     SoprHoz.DesGr   := BookPrzk.DesGr;
     SoprHoz.Summa   := BookPrzk.SUM[2];
     SoprHoz.Direct  := BookPrzk.Direct;
     SoprHoz.cOrg    := BookPrzk.cOrg;
    Insert Current SoprHoz;

    wSh := MakeHozOperBySh(wDirect, BookPrZk.Nrec, cgOper_HozOperBook, BookPrZk.TipUser);
    if (wSh = 0)
    {
      WriteProtokol(' Не найдена хозоперация к записям в книге покупок/продаж', 3);
      continue;
    }

/////////////////////////////
  }  // loop tSpAkt

}

function MakeBookHozOper204: boolean;
var
  wBookType
  ,wDirect: word;
  cSchFact: tNrec;
  isBookRec: boolean;
  wSh: word;
{

  Result := false;

  if not iDocTune.NeedMake(cgOper_HozOperBook)
  {
    Result := true;
    Exit;
  }

  if (GetFirst KatSopr != tsOk)
    Exit;

  _Loop SpSopr
  {
    if(Getfirst tSpSch Where ((SpSopr.cMcUsl == tSpSch.cMcUsl AND SpSopr.cParty == tSpSch.cParty))!=tsOK)
     Continue;

     Var _dOst: Double; _dOst:=SpSopr.KolFact;

    _Loop tSpSch Where ((SpSopr.cMcUsl == tSpSch.cMcUsl AND SpSopr.cParty == tSpSch.cParty))
    {
      if(Round(_dOst,4) <= 0) break;

    if(Getfirst Schfact Where ((tSpSch.cSchFact == Schfact.Nrec))!=tsOK)
    {
      WriteProtokol(' Не найдена СФ Nrec='+To_Char(tSpSch.cSchFact,20,0), 3);
      continue;
    }

      Var _dKol: Double;
      _dKol := if(_dOst>tSpSch.dOst,tSpSch.dOst,_dOst);
      _dOst-=_dKol;

    if(GetFirst KatMc=tsOk){}

    ClearBuffer(#BookPrzk);
     BookPrzk.Nazn       := 'Акт №'+KatSopr.nsopr+DateToStr(KatSopr.dSopr,' от DD/MM/YYYY')+' МЦ:'+KatMc.Name;
     BookPrzk.cSchfact   := tSpSch.cSchFact;
     BookPrzk.TipUser    := Word(7450);
     BookPrzk.Direct     := Word(1);
     BookPrZk.TipOtvPodr := Word(1109);
     BookPrZk.cOtvPodr   := KatSopr.Nrec;
     BookPrZk.cRecs[10]  := SpSopr.Nrec;
     BookPrZk.dReg       := KatSopr.dSopr;

     BookPrzk.SubTip     := Word(7);
     BookPrzk.dReg       := KatSopr.dSopr;
     BookPrzk.dOpl       := BookPrzk.dReg;
     BookPrzk.dOpr       := BookPrzk.dReg;

     BookPrzk.NUM        := Schfact.Num;
     BookPrzk.cOrg       := Schfact.cOrg;
     BookPrzk.CBASEDOC   := Schfact.cBaseDoc;
     BookPrzk.CSTEPDOC   := Schfact.cStepDoc;

     if(GetFirst SpSchf Where ((    Schfact.Nrec  == SpSchf.cSchfact
                                AND SpSopr.PrMc   == SpSchf.PrMc
                                AND SpSopr.cMcUsl == SpSchf.cMcUsl
                                AND SpSopr.cParty == SpSchf.cParty (NoIndex)
                              ))=tsOK)
     {
      case Word(SpSchf.PercNDS) of
        18 :
            {
             BookPrzk.SUM[1]     := Round(SpSchf.PrNoNds*_dKol,2);
             BookPrzk.SUM[2]     := Round(BookPrzk.Sum[1]*SpSchf.PercNDS/100,2);
            }
        10 :
            {
             BookPrzk.SUM[4]     := Round(SpSchf.PRNONDS*_dKol,2);
             BookPrzk.SUM[5]     := Round(BookPrzk.SUM[4]*SpSchf.PercNDS/100,2);
            }
         0 :
            {
             BOOKPRZK.SUM[23]    := Round(SpSchf.PRNONDS*_dKol,2);
             BOOKPRZK.SUM[9]     := BOOKPRZK.SUM[23];
             BOOKPRZK.SUM[19]    := BOOKPRZK.SUM[23];
             BOOKPRZK.SUM[28]    := BOOKPRZK.SUM[23];
            }
      end; //case
     }


     BookPrzk.SUM[3]     := BookPrzk.SUM[1]+BookPrzk.SUM[2];
     BookPrzk.SUM[6]     := BookPrzk.SUM[4]+BookPrzk.SUM[5];

     BookPrzk.SUM[11]    := BookPrzk.SUM[1];
     BookPrzk.SUM[12]    := BookPrzk.SUM[2];
     BookPrzk.SUM[13]    := BookPrzk.SUM[3];
     BookPrzk.SUM[14]    := BookPrzk.SUM[4];
     BookPrzk.SUM[15]    := BookPrzk.SUM[5];

     BookPrzk.SUM[21]    := BookPrzk.SUM[3]+BookPrzk.SUM[6]+BOOKPRZK.SUM[23];
     BookPrzk.SUMMA      := BookPrzk.SUM[21];

     BookPrzk.SUM[30]    := 1; // хз чёйэта
     BookPrzk.DESCR      := sGetTune('User.Descr');
     BookPrzk.DESGR      := sGetTune('User.DesGr');
    Insert Current BookPrzk;

    wDirect := word(SubStr(BookPrZk.TipUser, 1, 2));

    ClearBuffer(#SoprHoz);
     SoprHoz.DATOB   := BookPrzk.dReg;
     SoprHoz.cSoprDoc:= BookPrzk.Nrec;
     SoprHoz.TipDoc  := wDirect;
     SoprHoz.TidkGal := wDirect;
     SoprHoz.NoDoc   := BookPrzk.Num;
     SoprHoz.Descr   := BookPrzk.Descr;
     SoprHoz.DesGr   := BookPrzk.DesGr;
     SoprHoz.Summa   := BookPrzk.SUM[2];
     SoprHoz.Direct  := BookPrzk.Direct;
     SoprHoz.cOrg    := BookPrzk.cOrg;
    Insert Current SoprHoz;

    isBookRec := true;

    wSh := MakeHozOperBySh(wDirect, BookPrZk.Nrec, cgOper_HozOperBook, BookPrZk.TipUser);
    if (wSh = 0)
    {
      WriteProtokol(' Не найдена хозоперация к записям в книге покупок/продаж', 3);
      continue;
    }
    }// Loop tSpSch

    MakeOneReginAkts;
  }  // loop SpSopr

  WriteProtokol('Привязка ХозОперации к записям в книге покупок/продаж:') ;
  Result := true;
}

//------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------
Function DeleteBookHozOper204: boolean;
var
 wDirect: word;
{

  _loop BookPrZk Where ((     coKatSopr    == BookPrZk.TipOtvPodr
                          AND KatSopr.Nrec == BookPrZk.cOtvPodr
                       ))
  {
    wDirect := Word(SubStr(BookPrZk.TipUser, 1, 2));
    if (not DeleteHozOperBySh(wDirect, BookPrZk.Nrec)      )
    {
      WriteProtokol('Ошибка удаления ХозОпераций к записям в книге покупок/продаж.', 3);
      //Continue;
    }
    Delete SoprHoz where ((wDirect == SoprHoz.TipDoc AND BookPrZk.Nrec == SoprHoz.cSoprDoc));
    Delete Current BookPrZk;
  }
}