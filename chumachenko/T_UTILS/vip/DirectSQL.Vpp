
#define ss sqlAddStr(vliSQLCommand, '
#define se ');

Var  vliSQLCommand                                  // Handle SQL-команды
   , vliErrorCode                                   // Код ошибки
   , vliSQLStmt   : longint;                        // Handle Stmt
     sMCInCompl   : String;

//------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------
Procedure ClearQuery(var liHandle : longint);
{
  if (liHandle <> 0)
  {
    sqlFreeStr(liHandle);
    liHandle := 0;
  } //
} // procedure ClearQuery

//------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------
Procedure FreeQuery(var liSQLStmt : longint);
{
  if (liSQLStmt <> 0)
  {
    sqlFreeStmt(liSQLStmt);
  } //
} // procedure ClearQuery

//------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------
Function DateToInt(dd: Date): LongInt;
{
   DateToInt := 65536*Year(dd)+256*Month(dd)+Day(dd);
} // procedure DateToInt

//------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------
Function IntToDate(p_lDate: longint): date;
var
  btDay
 ,btMonth : byte;
  wYear   : word;
{
   btDay   :=  byte(p_lDate & 0000000ffh);
   btMonth :=  byte((p_lDate & 00000ff00h) shr 8);
   wYear   :=  word(p_lDate shr 16);
   result  := date(btDay, btMonth, wYear);
}

//------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------
Function GetDateByMSSQ(dd: Comp): Date;
Var d,m,y : Word;
{
   GetDateByMSSQ := Date(0,0,0);
   dd := Comp(dd shr 32);
   d := Word(dd And 0FFh);

   dd := Comp(dd shr 8);
   m  := Word(dd And 0FFh);

   dd := Comp(dd shr 8);
   y  := Word(dd And 0FFFFh);

   GetDateByMSSQ := Date(d,m,y);
} // procedure DateToInt

//------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------
Function DateToComp(dd: Date): Comp;
Var c : Comp;
{
  c := Year(dd);
  c := c  Shl 8;

  c := c OR (Month(dd));
  c := c  Shl 8;

  c := c OR (Day(dd));
  c := c  Shl 32;

  Result :=c;
} // procedure DateToComp
