#declare CreateFieldList
procedure CreateFieldList(sNameBr: string; wKodAn: word);
{

  var sObjName: string = '';
  cfsGetProp(sNameBr, cfpTitle, sObjName);

  if(GetFirst KatKau where ((wKodAn == KatKau.KODGROUP)) != tsOk)
  {
    ClearBuffer(#KatKau);
    KatKau.KODGROUP := wKodAn;
    KatKau.SySNum   := 1;
    KatKau.Name     := 'Список полей для документа ' + string(wKodAn - cgKau_CfgBase);
    insert current KatKau;

  }
  var cObjGroup: comp = 0;

  if (sNameBr != '')
  {

    if GetFirst SpKau where ((wKodAn == SpKau.KODGRKAU and sNameBr == SpKau.Name )) != tsOk
    {
      clearBuffer(#SpKau);
      SpKau.KODGRKAU := wKodAn;
      SpKau.Name     := sNameBr;
      SpKau.CODE     := sObjName;
      insert current SpKau;
    }
    cObjGroup := SpKau.Nrec;
  }

  var sAllObj: array[1..1] of string;
  cfsEnumObjects(sNameBr, sAllObj, true);

  var i: word;
  for(i := 1; i<= count(sAllObj); i++)
  {
    if GetFirst SpKau where ((wKodAn == SpKau.KODGRKAU and sAllObj[i] == SpKau.Name )) = tsOk
    {
      if(SpKau.cNode != cObjGroup)
      {
        SpKau.cNode := cObjGroup;

        update current SpKau;

      }
      continue;
    }
    clearBuffer(#SpKau);
    SpKau.KODGRKAU := wKodAn;
    SpKau.Name     := sAllObj[i];
    SpKau.cNode    := cObjGroup;
    cfsGetProp(SpKau.Name, cfpTitle, SpKau.CODE);

    insert current SpKau;

  }
}
#end


