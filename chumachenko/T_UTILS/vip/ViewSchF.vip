#include ViewSchF.vih
#include  ShViewOborot.vih
#include ExtAttr.vih
#include DocTune.vih
Interface ViewSchF 'Просмотр ордеров'  DoAccept,cyan;
#include sfconst.inc
#include ExtAttr.var
var
  iOborot : ShViewOborot noauto;
create view v
var
  par_cSchFact
  ,par_cKatSopr: tNrec;
  SchFormat
, wDirect
, wBookDirect: word;
  SchFact_Num: string;
  SchFact_Date
, SchFact_DateReg : date;
  AttrNumID
, AttrDatID
, AttrDatRegID
, AttrStatusBuhID
, SchFact_cStatusBuh  : comp;

  PlatDocNo: string;
  PlatDocDate : date;
as select
 UsersDocBk.Name+''                                                                        ( FieldName = bPrZkDocName)
, if ( IsValid(tnSpSophoz), 'V', if ( BookPrZk.cBookPrZk <> 0, 'С', '') )                  ( FieldName = IsRazn )
, if ( (BookPrZk.ls[2] AND 1) <> 0, 'Н', 'С')                                              ( FieldName = strOwnBk )
, If(IsValid(tnUsersDoc), UsersDoc.Name, '')                                               ( FieldName = DlgUserDoc  )
, if(par_cSchFact = 0, '', if(SchFact.cRecs[2]  != 0, KatNotesManag.Name, 'оформляемый') ) ( FieldName = ManagStatusName )
!, if(par_cSchFact = 0, '', if(SchFact_cStatusBuh!= 0, KatNotesBuh.Name  , 'оформляемый') ) ( FieldName = BuhStatusName )
, if(SchFact_cStatusBuh!= 0, KatNotesBuh.Name, if(par_cSchFact = 0, '', 'оформляемый'))    ( FieldName = BuhStatusName )
, if(par_cSchFact = 0, '', SchFact.Nazn )                                                  ( FieldName = SchFactNazn )


from
  BookPrZk
, BookPrZk BookPrZkPlat201
, BookPrZk BookPrZkPlat101
, KatStroy BkKatStroy
, KatNotes KatNotesManag
, KatNotes KatNotesBuh
, SchFact
, SchFact SchFact201
, SchFact SchFact101
, SpSophoz
, SoprHoz SoprHoz201
, SoprHoz SoprHoz101
, UsersDoc
, UsersDoc UsersDocBk
where
((
    par_cSchFact     == SchFact.Nrec
AND SchFact.TipUser  == UsersDoc.TipUsers
AND par_cSchFact     == BookPrZk.cSchFact
AND cwBK_Reg         == BookPrZk.RegDoc(NoIndex)

AND par_cKatSopr     == KatSopr.NRec

and BookPrZk.NRec    == SpSopHoz.cBookPrZk
AND BookPrZk.TipUser == UsersDocBk.TipUsers
and BookPrZk.cObject == BkKatStroy.NRec

and word(SubStr(BookPrZk.TipUser, 1, 2))  == SoprHoz.TipDoc
AND BookPrZk.NRec    == SoprHoz.cSoprDoc

AND SchFact.cRecs[2]    == KatNotesManag.NRec
AND SchFact_cStatusBuh  == KatNotesBuh.NRec


//платеж для отгрузки
AND par_cSchFact                      == BookPrZkPlat201.cSchFact
AND cwTypeBK_Buy_RegAvansInMomentOtgr == BookPrZkPlat201.TipUser(NoIndex)
AND BookPrZkPlat201.cSchFactS         == SchFact201.NRec
AND SchFact201.cSoprHoz               == SoprHoz201.NRec
//платеж для поставки
AND par_cSchFact                       == BookPrZkPlat101.cSchFact
AND cwTypeBK_Sell_RegAvansInMomentOtgr == BookPrZkPlat101.TipUser(NoIndex)
AND BookPrZkPlat101.cSchFactS          == SchFact101.NRec
AND SchFact101.cSoprHoz                == SoprHoz101.NRec

))
and (par_cSchFact <> 0)
  ;
window wnSchFact (,,sci1Esc);
panel pnSch;
table SchFact;
screen scSchFact;

show at (,,,6) fixed_Y;
fields
  'Документ для учета НДС'                           : Skip, Centered;//,{Font = {Bold = true; Color = ColorSysWhite; BackColor = ColorMark}};
  DlgUserDoc                                         : Protect, Skip, Left;
  SchFact_Num      ('Номер СФ', ,)                   : NoProtect;
  SchFact_Date     ('Дата СФ', ,)                    : NoProtect;
  SchFact_DateReg  ('Дата регистрации', ,)           : NoProtect, NoPickButton;
  ManagStatusName  ('Статус документа', , sci1378Esc): Protect, NoPickButton;
  BuhStatusName    ('Статус документа', , sci1378Esc): Protect, PickButton;
  SchFactNazn      ('Примечание', ,)                 : Protect, NoPickButton;
  PlatDocNo        ('№ платежного документа', ,)     : Protect, NoPickButton;
<<
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
.@@@@@@@@@@@@@@@@@@@@@@  `Номер`.@@@@@@@@@@@@@@@@@@@@@@ `Дата`.@@@@@@@@@@   `Дата рег.`.@@@@@@@@@@
 Статусы        `Управленческий`.@@@@@@@@@@@@@@@@@@@@@@@@@@@ `Бухгалтерский`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Примечание`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`К пл. документу `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;
end;
Browse brBookPrZk ('Записи регистрации по отгрузке', hcSchFactSInterfaceBottom, sci14Esc);
show at (,7,,13);
  Table BookPrZk;

Fields
  {Font =
    {Color = if (BookPrZk.Summa < 0 or
                 ((par_cSchFact <> 0) and (BookPrZk.Direct <> SchFact.Direct) and
                  (BookPrZk.TipUser <> cwTypeBK_Sell_CorrStorno) and
                  (BookPrZk.TipUser <> cwTypeBK_Buy_CorrStorno)), ColorError, 0)
     Bold  = (BookPrZk.ls[2] and 1) <> 0 }};
//------------------------------------------------------------------------------
  BookPrZk.dReg #3'Дата'         ('Дата', , )  : [10, 'DD/MM/YYYY'], Protect, NoAutoSize, Centered;
//-----------------------------------------------------------------------------
  bPrZkDocName  #3'Документ'     ('Документ', , ): [18], Protect;
//-----------------------------------------------------------------------------
  if (SchFormat = 0, BookPrZk.Summa, BookPrZk.Sum[21])
                #3'Сумма'#13#3'с НДС'  ('Сумма записи по документу вместе с НДС', , )
                : [12.2, '\2p[|-]3666`666`666`666`666`666.88'], Protect, NoAutoSize;
//-----------------------------------------------------------------------------
  if (SchFormat = 0, BookPrZk.Sum[2], BookPrZk.Sum[12])
                #3'Сумма НДС'#13#3'осн.став.'     ('Сумма НДС по основной ставке', , )
                : [11.2, '\2p[|-]3666`666`666`666`666`666.88'], Protect, LessNull, NoAutoSize;
//-----------------------------------------------------------------------------
  if (SchFormat = 0, BookPrZk.Sum[5], BookPrZk.Sum[15])
                #3'Сумма НДС'#13#3'доп.став.'     ('Сумма НДС по дополнительной ставке', , )
                : [11.2, '\2p[|-]3666`666`666`666`666`666.88'], Protect, LessNull, NoAutoSize;
//-----------------------------------------------------------------------------
  IsRazn
                #3'Р'            ('V-Учтена разноска платежа по спецификации ТСД, С-запись связана с другой записью')
                : [1], Protect, Centered, NoAutoSize;
//-----------------------------------------------------------------------------
  strOwnBk
                #3'С/Н'          ('С-по собственным Н- по несобственным товарам/услугам', , sci1378Esc)
                : [3], Protect, NoPickButton, Centered, NoAutoSize;
//-----------------------------------------------------------------------------
  BkKatStroy.Name
                #3'Объект', #3'строит.' ('Объект строительства', , sci1378Esc)
                : [10], Protect, NoPickButton, NoAutoSize;
//-----------------------------------------------------------------------------
end; //Browse
Embedded embViewOborot 'Проводки' Interface iOborot.wnOborot;
show at (,14,,);
cache=onDemand;
end;
tableEvent table  BookPrZk
cmPositionChanged:
{
  iOborot.SetSh(if(GetFirst SoprHoz = tsOk, SoprHoz.NRec, 0));
}
end;
HandleEvent
cmSeeDopInfo:
{
  if (IsValid(#SchFact) )
    RunInterface('SchFact', SchFact.NRec, SchFact.Direct, 0, SchFact.cOrg, SchFact.cBaseDoc, SchFact.cStepDoc,
                            SchFact.cVal, SchFact.Status, SchFact.TipNum,  word(2));
}
cmHotKeys:
{
  PutHotCommand(RunDynMenu('O_Tavr::mnuViewSchF'));
}
cmEdit:
{
  PutCommand(cmSeeDopInfo);
}
end;
end;
HandleEvent
cmEdit:
{
  PutCommand(cmSeeDopInfo);
}
cmSeeDopInfo:
{
  RunInterface('NalNakl_View',word(coKatSopr),KatSopr.VidSopr, KatSopr.nRec,Date(0,0,0));
}
cmCheckField:
{
  case CurField of
    #SchFact_Num    : oExtAttr.sSetAttrID(coKatSopr, par_cKatSopr, AttrNumID, SchFact_Num);
    #SchFact_Date   : oExtAttr.dSetAttrID(coKatSopr, par_cKatSopr, AttrDatID, SchFact_Date);
    #SchFact_DateReg: oExtAttr.dSetAttrID(coKatSopr, par_cKatSopr, AttrDatRegID, SchFact_DateReg);
  end;
}
cmPick :
{
  Case CurField of
    #BuhStatusName:
    {
      if (RunInterface( 'GetSomKatNotes', cgVidStatus_BuhSF, 0, 0, FALSE, SchFact.cRecs[3] ) != cmCancel)
      {
        Set SchFact.cRecs[3] := SchFact.cRecs[3];
        Update current SchFact;
        set SchFact_cStatusBuh := SchFact.cRecs[3];
        oExtAttr.coSetAttrID(coKatSopr, cKatSopr, AttrStatusBuhID, SchFact_cStatusBuh, if(ISValid(#KatNotesBuh), KatNotesBuh.Name, ''));

      }
    }
  end;
}

end;
!-------------------------------------------------------------------------------------------------------------
!Получение информации о платежных документах к накладной
!-------------------------------------------------------------------------------------------------------------
procedure GetPlatDocInfo;
{
  PlatDocNo   := '';
  PlatDocDate := 0;

  case wDirect of
    cwGlobalCodeBK_Buy:
    {
      _loop BookPrZkPlat101
        _loop SchFact101
          _loop SoprHoz101
             PlatDocNo   += SoprHoz101.NoDoc + ' от ' + string(SoprHoz101.DatOb) + ', ';



    }
    cwGlobalCodeBK_Sell:
    {
       _loop BookPrZkPlat201
        _loop SchFact201
          _loop SoprHoz201
             PlatDocNo   += SoprHoz201.NoDoc + ' от ' + string(SoprHoz201.DatOb) + ', ';

    }
  end;
  set PlatDocNo := RTrim(Trim(PlatDocNo), ',');
}
!-------------------------------------------------------------------------------------------------------------
!Позиционирование на СФ
!-------------------------------------------------------------------------------------------------------------
function SetSchFact(cSchFact: tNRec; cKatSopr: tNrec; IsProtect: boolean): boolean;
var
  cSopHoz: tNrec;
{
  cSopHoz := 0;
  par_cSchFact := cSchFact;
  par_cKatSopr := cKatSopr;
  If (GetFirst KatSopr = tsok) {}



  case KatSopr.VidSopr of
    101, 111: wDirect := cwGlobalCodeBK_Buy;
    201, 211: wDirect := cwGlobalCodeBK_Sell;
  end;

  GetPlatDocInfo;

  if GetFirst SchFact != tsOk
  {
    par_cSchFact := 0;
    SchFact_Num        := oExtAttr.sGetAttrID(coKatSopr, par_cKatSopr, AttrNumID);
    SchFact_Date       := oExtAttr.dGetAttrID(coKatSopr, par_cKatSopr, AttrDatID);
    SchFact_DateReg    := oExtAttr.dGetAttrID(coKatSopr, par_cKatSopr, AttrDatRegID);
    set SchFact_cStatusBuh := oExtAttr.coGetAttrID(coKatSopr, par_cKatSopr, AttrStatusBuhID);
    SetFieldProtected(#SchFact_Num, false);
    SetFieldProtected(#SchFact_Date, false);
    SetFieldProtected(#SchFact_DateReg, false);
  }
  else
  {
    SetFieldProtected(#SchFact_Num, true);
    SetFieldProtected(#SchFact_Date, true);
    SetFieldProtected(#SchFact_DateReg, true);
    SchFact_Num        := SchFact.Num;
    SchFact_Date       := SchFact.DFACT;
    SchFact_DateReg    := SchFact.DReg;
    set SchFact_cStatusBuh := SchFact.cRecs[3];
  }
  if (GetFirst BookPrZk = tsOk)
  {
    wBookDirect := word(SubStr(BookPrZk.TipUser, 1, 2));
    if(GetFirst SoprHoz = tsOk)
      cSopHoz := SoprHoz.NRec;
  }
  iOborot.SetSh(cSopHoz);
   RereadRecord;
  RescanPanel(tnBookPrZk);
  RescanPanel(tnSchFact);

 Result := true
}
!-------------------------------------------------------------------------------------------------------------
!Получение аттрибутов KatSopr из вне
!-------------------------------------------------------------------------------------------------------------
function GetNumDate(var SfPar: TParamsSF; cKatSopr: tNrec = 0; cSchFact: tNrec = 0): boolean;
{
  Result := true;
  ClearAdvRecord(SfPar);

  if (cKatSopr != 0) //получение данных по накладной с Nrec = cKatSopr
  {
    par_cKatSopr := cKatSopr;
    par_cSchFact := cSchFact;

    if (GetFirst SchFact != tsOk) //если к накладной нет СФ, то берем из аттрибута к KatSopr
    {
      par_cSchFact := 0 ;
      SfPar.sNum       := oExtAttr.sGetAttrID(coKatSopr,  cKatSopr, AttrNumID);
      SfPar.dDate      := oExtAttr.dGetAttrID(coKatSopr,  cKatSopr, AttrDatID);
      SfPar.dRegDate   := oExtAttr.dGetAttrID(coKatSopr,  cKatSopr, AttrDatRegID);
      SfPar.cStatusBuh := oExtAttr.coGetAttrID(coKatSopr, cKatSopr, AttrStatusBuhID);
      Result := false;
    }
    else  //если есть СФ - берем из СФ
    {
      SfPar.sNum       := SchFact.Num;
      SfPar.dDate      := SchFact.DFACT;
      SfPar.dRegDate   := SchFact.DReg;
      SfPar.cStatusBuh := SchFact.cRecs[3];
    }
  }
  else//если ссылку на накладную не передали, то берем текущие данные, позиция в SetSchFact
  {
    if (GetFirst SchFact = tsOk)
    {
      SfPar.sNum       := SchFact.Num;
      SfPar.dDate      := SchFact.DFACT;
      SfPar.dRegDate   := SchFact.DReg;
      SfPar.cStatusBuh := SchFact.cRecs[3];
    }
  }
}
!-------------------------------------------------------------------------------------------------------------
! Установка аттрибутов Сф из вне
!-------------------------------------------------------------------------------------------------------------
function SetNumDate(var SfPar: TParamsSF; cKatSopr: tNrec = 0): boolean;
{
  if (cKatSopr = 0)
   {
      ClearAdvRecord(SfPar);
      exit;
   }

!    cKatSopr := par_cKatSopr;

  SchFact_Num        := SfPar.sNum      ;
  SchFact_Date       := SfPar.dDate     ;
  SchFact_DateReg    := SfPar.dRegDate  ;
  set SchFact_cStatusBuh := SfPar.cStatusBuh;
  oExtAttr.sSetAttrID(coKatSopr,  cKatSopr, AttrNumID      , SchFact_Num);
  oExtAttr.dSetAttrID(coKatSopr,  cKatSopr, AttrDatID      , SchFact_Date);
  oExtAttr.dSetAttrID(coKatSopr,  cKatSopr, AttrDatRegID   , SchFact_DateReg);
  oExtAttr.coSetAttrID(coKatSopr, cKatSopr, AttrStatusBuhID, SchFact_cStatusBuh, if(ISValid(#KatNotesBuh), KatNotesBuh.Name, ''));

  Result := true;
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
constructor Init;
{
  SchFormat := 2;
  iOborot    := new(ShViewOborot);
  AttrNumID       := oExtAttr.CreateAttr(coKatSopr, 'Номер СФ'           , cgAttrType_Str);
  AttrDatID       := oExtAttr.CreateAttr(coKatSopr, 'Дата СФ'            , cgAttrType_Date);
  AttrDatRegID    := oExtAttr.CreateAttr(coKatSopr, 'Дата регистрации СФ', cgAttrType_Date);
  AttrStatusBuhID := oExtAttr.CreateAttr(coKatSopr, 'Бух. статус СФ'     , cgAttrType_Comp);
  Result := true;
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
destructor done;
{
  oExtAttr := NullRef;
  iOborot := NullRef;
}
End.
mnuViewSchF Menu
{
  -'Просмотр документа', cmSeeDopInfo, 'Просмотр документа', hcSellM1DocNal, '', , sci1Esc;
}