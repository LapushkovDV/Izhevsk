#include ShViewOborot.vih
Interface ShViewOborot 'Просмотр ордеров'  DoAccept,cyan;
create view v
var
  par_cSoprHoz: tNrec;
as select
    if (GetAnyKau(cgAkSimple,Oborot.TblOs[1],Oborot.KauOs[1]),GivenAnName(cgAnName),'') (FieldName = dbKau1)
  , if (GetAnyKau(cgAkSimple,Oborot.TblOs[2],Oborot.KauOs[2]),GivenAnName(cgAnName),'') (FieldName = dbKau2)
  , if (GetAnyKau(cgAkSimple,Oborot.TblOs[3],Oborot.KauOs[3]),GivenAnName(cgAnName),'') (FieldName = dbKau3)
  , if (GetAnyKau(cgAkSimple,Oborot.TblOs[4],Oborot.KauOs[4]),GivenAnName(cgAnName),'') (FieldName = dbKau4)
  , if (GetAnyKau(cgAkSimple,Oborot.TblOs[5],Oborot.KauOs[5]),GivenAnName(cgAnName),'') (FieldName = dbKau5)
  , if (GetAnyKau(cgAkSimple,Oborot.TblOs[6],Oborot.KauOs[6]),GivenAnName(cgAnName),'') (FieldName = dbKau6)
!-------------------------------------------------------------------------------
  , RTrim(dbKau1+'\'+dbKau2+'\'+dbKau3+'\'+dbKau4+'\'+dbKau5+'\'+dbKau6,'\')            (FieldName = dbKau)
!-------------------------------------------------------------------------------
  , if (GetAnyKau(cgAkSimple,Oborot.TblKs[1],Oborot.KauKs[1]),GivenAnName(cgAnName),'') (FieldName = krKau1)
  , if (GetAnyKau(cgAkSimple,Oborot.TblKs[2],Oborot.KauKs[2]),GivenAnName(cgAnName),'') (FieldName = krKau2)
  , if (GetAnyKau(cgAkSimple,Oborot.TblKs[3],Oborot.KauKs[3]),GivenAnName(cgAnName),'') (FieldName = krKau3)
  , if (GetAnyKau(cgAkSimple,Oborot.TblKs[4],Oborot.KauKs[4]),GivenAnName(cgAnName),'') (FieldName = krKau4)
  , if (GetAnyKau(cgAkSimple,Oborot.TblKs[5],Oborot.KauKs[5]),GivenAnName(cgAnName),'') (FieldName = krKau5)
  , if (GetAnyKau(cgAkSimple,Oborot.TblKs[6],Oborot.KauKs[6]),GivenAnName(cgAnName),'') (FieldName = krKau6)
!-------------------------------------------------------------------------------
  , RTrim(krKau1+'\'+krKau2+'\'+krKau3+'\'+krKau4+'\'+krKau5+'\'+krKau6,'\')            (FieldName = krKau)
!-------------------------------------------------------------------------------
  , Oborot.dbSchetO + ' ' + Oborot.SubOsSch + ' ' + dbKau    (FieldName = Debet)
!-------------------------------------------------------------------------------
  , Oborot.krSchetK + ' ' + Oborot.SubSchK  + ' ' + krKau    (FieldName = Kredit)
!-------------------------------------------------------------------------------
  , if (Oborot.SumValut <> 0, Oborot.SumValut, Oborot.SumOb) (FieldName = SumProv)
!-------------------------------------------------------------------------------
  , if (Oborot.RuchAuto = cgOborotManual,   'Р',
    if (Oborot.RuchAuto = cgOborotAuto,     'А',
    if (Oborot.RuchAuto = cgOborotModified, '*', '')))       (FieldName = ProvAuto)

!-------------------------------------------------------------------------------
  , if (Oborot.ConvOb <> 0,''#251,'')                        (FieldName = ConvFlag)


from
  Oborot
, KlVal KlValO
where
((
 par_cSoprHoz == Oborot.cSoprHoz
 and Oborot.cEd        ==    KatEd.Nrec
and Oborot.KodValut   ==    KlValO.Nrec
))
and (par_cSoprHoz <> 0)
  ;
window wnOborot (,,sci1Esc);
browse brOborot;
Table Oborot;
!-------------------------------------------------------------------------------
Fields
 // {Font = {Color = BrowseColorOborot}};
 // isPicked        ''               : [1],  NoAutoSize, Skip;
  Oborot.DatOb    #3'Дата'         ('Дата формирования проводки',hcPrBookDatOb)
                                   : [10], NoAutoSize, Protect, Centered;
  Oborot.NoDok    #3'№ докум.'     ('Номер проводки или номер документа по которому сформирована проводка',hcBankNomerDoc)
                                   : [8],  NoAutoSize, Protect;
  Debet           #3'Дебет'        ('Счет, субсчет, аналитика по дебету в проводке',hcBuhDebetProv)
                                   : [10], Protect;
  Kredit          #3'Кредит'       ('Счет, субсчет, аналитика по кредиту в проводке',hcBuhKreditProv)
                                   : [10], Protect;
  Oborot.SumOb    #3'Сумма'        ('Сумма оборота в НДЕ по проводке',hcBuhSumOborot)
                                   : [14,'\+2p[|-]366`666`666`666`667.88'], NoAutoSize, Protect, LessNull;
  Oborot.SumValut #3'... в валюте' ('Сумма оборота в валюте по проводке',hcBuhSumOborotVal)
                                   : [12,'\+2p[|-]366`666`666`666`667.88'], NoAutoSize, Protect, LessNull;
  KlValO.SimvolV  #3'Вал.'         ('Символ валюты, для проводок в валюте',hcBuhValutaProv)
                                   : [4],  NoAutoSize, Protect;
  ConvFlag        #3'К'            ('Конвертация сумм в проводке в валюту или НДЕ при расчетах',hcBuhConvValuta)
                                   : [1],  NoAutoSize, Protect, Centered;
  Oborot.Kol       #3'Количество'   : [12], [3, '\+2p[|-]366`666`666`666`667~88'], noAutoSize, Protect, LessNull;
  if (Oborot.Kol = 0, '', KatEd.Abbr) #3'ЕдИзм'        ('Единица измерения')
                                   : [4],  NoAutoSize, Protect;
  Oborot.VhProp   #3'В'            ('Входимость в расчет суммы по документу: `+` -входит, `-` -не входит',hcPrBookFVhodSumPl)
                                   : [1],  NoAutoSize, Protect, Centered;
  ProvAuto        #3'П'            ('`Р`- ручная, `А`- автоматическая, `*`-автоматическая, отредактированная',hcPrBookSSignMakeProv)
                                   : [1],  NoAutoSize, Protect, Centered;
!------------------------------------------------------------------
end;
end;
!#include SHBufDoc.vpp
function SetSh(cSoprHoz: tNRec): boolean;
{
  par_cSoprHoz := cSoprHoz;
//  IF GetFirst SoprHoz where((cSoprHoz == SoprHoz.NRec))!= tsOk {}
  //  Exit;
 RereadRecord;
 Result := true
}
End.
