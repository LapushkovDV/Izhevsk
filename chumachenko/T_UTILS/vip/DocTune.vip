Window wnListTune 'Список настроек для документов' cyan, doAccept, EscClose;
Show at (,,72,16);
browse brListTunes ;
 Table BuhRep;
   RecMarker = pMarker {BuhRep.nRec};
 Fields
  Buhrep.name 'Наименование'  : [30], Protect, PickButton;
