!-------------------------------------------------------------------------------------------------------------
window wncfgObjReq 'Список полей' cyan, DoAccept, EscClose;
browse brObjReq;
table cfgObjectsReq;
  Fields
    cfgObjectsReq.sLabel 'Имя' :[20], NoProtect, PickButton;
    cfgObjectsReq.cfgName 'Код' :[40], NoProtect, PickButton;
    cfgObjectsReq.wType   'Действие' :[15],  [List  cgAction_NotRequied 'не обязательное', cgAction_Requied 'обязательное'], Protect;
end;

TableEvent Table cfgObjectsReq;
cmInsertRecord: insert current cfgObjectsReq;
cmUpdateRecord: update current cfgObjectsReq;
cmDeleteRecord: delete current cfgObjectsReq;
end;
HandleEvent
cmInit:
{
  if getFirst cfgObjectsReq != tsOk
  {}
}
cmPick:
{
  case CurField of
    #cfgObjectsReq.cfgName
    ,#cfgObjectsReq.sLabel:
    {
      if PickCfgName(cfgObjectsReq.cRec, cfgObjectsReq.cfgName, cfgObjectsReq.sLabel)
      {
   //     set cfgObjectsReq.cRec := cfgObjectsReq.cRec;
   //     set cfgObjectsReq.cfgName := cfgObjectsReq.cfgName;
      }
    }
  end;
}
end;
end;//window

!-------------------------------------------------------------------------------------------------------------
!Настройка видимости Объектов/полей
!-------------------------------------------------------------------------------------------------------------
window wncfgObj 'Список полей' cyan, DoAccept, EscClose;
browse brObj;
table cfgObjectsVis;
  Fields
    cfgObjectsVis.sLabel 'Имя' :[20], NoProtect, PickButton;
    cfgObjectsVis.cfgName 'Код' :[40], NoProtect, PickButton;
    cfgObjectsVis.wType   'Действие' :[15],  [List  cgAction_Show 'отображать', cgAction_Hide 'не отображать'
                                                   ,cgAction_Protect 'защитить'], Protect;
end;

tableEvent table cfgObjectsVis;
cmInsertRecord: insert current cfgObjectsVis;
cmUpdateRecord: update current cfgObjectsVis;
cmDeleteRecord: delete current cfgObjectsVis;
end;
HandleEvent
cmInit:
{
  if getFirst cfgObjectsVis != tsOk
  {}
}
cmPick:
{
  case CurField of
    #cfgObjectsVis.cfgName
    ,#cfgObjectsVis.sLabel:
    {
      PickCfgNameMult;
    }
  end;
}
end;
end;//window

