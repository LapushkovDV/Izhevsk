const
  //статусы
  cg_UnProved = 0; //не проведен
  cg_Proved = 1;   //проведен
  cg_Storno = 4;

  cgMode_Pick = 1;
  cgMode_Add = 2;

Table struct TxoBook
(
  Nrec  :tNrec,
  cTxo  :tNrec,
  wType   : word,
  wDirect : word
)
With index
(
 // Nrec  =  NRec(Unique, Surrogate),
  C00  = wType
);
Table struct cfgObjects
(
  Nrec  :tNrec,
  cRec  :tNrec,
  sLabel: string,
  cfgName: string,
  wType: word,
  OperType: word
)
With index
(
 // Nrec  =  NRec(Unique, Surrogate),
  C00  = wType
  ,C01 = OperType
);
Type

TDocTuneParams = record
    // План счетов
  cPlansSch : comp;
  cTXO      : comp;      //тхо
  wBookType : word;      //тип книги покупок продаж
  cTXOKPP   : comp;      //тхо книги покупок продаж
  cZakazCr  : comp;      //статус управленческий при создании
  cUksCr    : comp;      //статус бухгалтерский при создании
  cStProved : comp;      //!НЕ СОХРАНЯЕТСЯ статус галактический при проведении
  cStUnProved: comp;     //НЕ СОХРАНЯЕТСЯ статус галактический при отмене проведения
  wOper     : word;      //операции
  wTabs     : word;      //операции
  wParTTN   : word;
  wDateTTN  : word;
  wParZd    : Word;
  wParSFB   : Word;
End;

#include GetKau.var
var
  pMarker : IMarker(Marker) new ;
  iPSManager : PSManager;
  iStorage  :  BuhRepStore; //
  Entity    : rcFpEntity;
  DocParams : TDocTuneParams;
  IsLoadedTune: boolean;
  var lComm: longint;
  //Cur_DocTune: tNRec;
  par_TuneNrec: tNRec;
  CurDocStatus
  ,ListMode: word;



  sFName: string;
  lProp: longint;
  wFLSH: word;

function IsAvaliableByDescr: boolean; forward;

Create view vTune         //i_SCRHEADER_ZD_DOGNODOC
var
  CurTidk: word;
  wDirect: word;
  IsProoved: boolean;
  piPickDoc: VipPickDoc;
  sNameBr: string;
  wOldfV   : Word;
as select
  *
, if(Buhrep.cPlansSch != 0, GetTidkGalName(Word(BuhRep.cPlansSch)), '') (fieldname = DlgTuneType)
, if(DocParams.cTXO != 0, HozOper.Name1, '')                            (fieldname = DlgTxo)
, if(DocParams.cZakazCr  != 0, KatNotesManag.Name,  '')                 ( FieldName = ManagStatusName )
, if(DocParams.cUksCr    != 0, KatNotesBuh.Name,  '')                   ( FieldName = BuhStatusName )
, if(IsValid(tncfgObjectsVis), 'есть настройки','')                     ( FieldName = DlgFieldsTune)
, 'нажмите для настройки'                                               ( FieldName = DlgwType)
, if(IsValid(tncfgObjectsReq), 'есть настройки','')                     ( FieldName = DlgwReq)

, if(IsValid(tnTxoBook), 'есть настройки','')                          ( FieldName = DlgTXOKPP)
, if(TxoBook.wType != 0, UsersDocTune.Name, '')                        (fieldname = DlgBookType)
, if(TxoBook.cTXO  != 0, HozOperKPP.Name1, '')                         (fieldname = DlgBookTxo)
from
  BuhRep
, BuhRep BuhRepA
, cfgObjects
, cfgObjects  cfgObjectsVis
, cfgObjects  cfgObjectsReq
, FpAreaBoxRec BoxRec
, HozOper
, HozOper HozOperKPP
, KatNotes
, KatNotes KatNotesManag
, KatNotes KatNotesBuh
, SpBuhRep
, TxoBook
, UsersDoc
, UsersDoc  UsersDocTune
where
((
    BuhRepEntity       == SpBuhRep.wEntity       //BuhRepEntity для Buhrep т.е. при нем пара   wEntity, cEntity будет уникальна
and BuhRep.Nrec        == SpBuhRep.cEntity
and DocParams.cTXO     == HozOper.Nrec
and DocParams.cZakazCr == KatNotesManag.NRec
and DocParams.cUksCr   == KatNotesBuh.NRec
and cgObject_Visible   == cfgObjectsVis.OperType
and cgObject_Requied   == cfgObjectsReq.OperType

and TxoBook.wType == UsersDocTune.TipUsers
and TxoBook.cTXO  == HozOperKPP.NRec

and 0                     == BuhRepA.cPlansSch
and sGetTune('USER.DESCR')== BuhRepA.Descr
and cgRepBuh_TuneAccess   == BuhRepA.wBuhRep
and BuhRep.NRec           == BuhRepA.cBuhRep(NoIndex)
))
bounds byAllTune =  cgRepBuh_DocTune == BuhRep.wBuhRep
//bounds byTidk    =  cgRepBuh_DocTune == BuhRep.wBuhRep and comp(CurTidk) == BuhRep.cPlansSch
bounds byTidk    = //  BuhRepA.cBuhRep == BuhRep.NRec
                    cgRepBuh_DocTune == BuhRep.wBuhRep
                   and comp(CurTidk) == BuhRep.cPlansSch
                  /*and  ( IsValid(tnBuhRepA) ) */

//condition byDescr = IsAvaliableByDescr
;

function IsAvaliableByDescr: boolean;
{
  result := getfirst buhrepa = tsok;
}

function LoadDocTunes(cTune: tNRec): boolean; forward;
!-------------------------------------------------------------------------------------------------------------
!Надо ли отображать поле
!-------------------------------------------------------------------------------------------------------------
function IsFieldVisible(FieldNum: word): boolean;
{
  Result :=( (DocParams.wTabs and FieldNum) > 0);
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
function IsDocProtected : boolean;
{
  Result := IsProoved and (wGetTune('FIN.USER.MODHAVEPROVOD') != 0) ;
}
function IsDocProoved : boolean;
{
  Result := IsProoved ;
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
function isAvaliableCommand(lCommand: longint): boolean;
{
  Result := true;
  case lCommand of
    1: Result := IsAvaliableByDescr;
  end;
}
function GetDefOper: word;
{
   case CurTidk of
        101: Result := cgOper_SklOrder or cgOper_SchFact or cgOper_SchFactReg or cgOper_HozOper;
        201: Result := cgOper_SchFact or cgOper_SchFactReg or cgOper_HozOper;
        204: Result := cgOper_SchFactReg or cgOper_HozOper;
        else
          Result := 0;
   end;
}
!-------------------------------------------------------------------------------------------------------------
!Допустима ли операция для текущей настройки
!-------------------------------------------------------------------------------------------------------------
function NeedMake(wOper: word): boolean;
{
  if IsLoadedTune
    Result := ((DocParams.wOper and wOper) = wOper);
  //else//временная заглушка
    //Result := GetDefOper(wOper);

}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
function NeedDel(wOper: word): boolean;
{
  Result := NeedMake(wOper);
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
function GetHozOperName:string;
{
  Result := '';
  case CurTidk of
    101: Result := 'Поступление угля (ТОРГ-12)';
    201: Result := 'Реализация Уголь,дрова';
    204: Result := 'Списание материалов';
  end;
}
!-------------------------------------------------------------------------------------------------------------
!Получение ссылки на хозоперацию для текущей настройки
!-------------------------------------------------------------------------------------------------------------
Function GetHozOperTXO(var SysOper: word) : Comp;
{
  Result := 0;
  if IsLoadedTune
  {
    if GetFirst HozOper  != tsOk
      Exit;
  }

  SysOper := HozOper.SysOper;
  Result := HozOper.Nrec;
}
!-------------------------------------------------------------------------------------------------------------
!Получение ссылки на хозоперацию для текущей настройки
!-------------------------------------------------------------------------------------------------------------
Function GetHozOperKPP(OperFlag: word; var SysOper: word) : Comp;
{
  Result := 0;

  if IsLoadedTune
  {
    if (GetFirst TxoBook where ((SysOper == TxoBook.wType)) = tsOk)
    {
      if GetFirst HozOperKPP != tsOk
      {
        SysOper := 0;
        Exit;
      }
      SysOper := HozOperKPP.SysOper;
      Result := HozOperKPP.Nrec;
    }
    else
      SysOper := 999;

  }
  else
    SysOper := 0;
}
!-------------------------------------------------------------------------------------------------------------
!Получение ссылки на хозоперацию для текущей настройки
!-------------------------------------------------------------------------------------------------------------
Function GetHozOper(OperFlag: word; var SysOper: word) : Comp;
{
  case OperFlag of
    cgOper_HozOper:     Result := GetHozOperTXO(SysOper);
    cgOper_HozOperBook: Result := GetHozOperKPP(OperFlag, SysOper);
    else
      Result := 0;
  end;
}
!-------------------------------------------------------------------------------------------------------------
!
!-------------------------------------------------------------------------------------------------------------
Function GetBookType : word;
{

  Result := DocParams.wBookType;
}
function GetDocStatus1: tNrec;
{
  if GetFirst KatNotes where ((cgVidStatus_Control == KatNotes.VidDoc and  1 == KatNotes.Status and 'БУ создан Галактика' == KATNOTES.NAME))= tsOk
    Result := KatNotes.Nrec;
}
function GetStatusByNum(wNum: word): tNRec;
{
  if GetFirst KatNotes where ((cgVidStatus_Gal == KatNotes.VidDoc and  wNum == KatNotes.Status and  wNum == KatNotes.Code))= tsOk
    Result := KatNotes.Nrec;
}
!-------------------------------------------------------------------------------------------------------------
!Получение ссылки на управленческий статус при создании документа
!-------------------------------------------------------------------------------------------------------------
function GetDocStatus(wFlag: word): tNRec;
{
  case wFlag of
    cgStatus_ControlCreate: Result := DocParams.cZakazCr;
    cgStatus_GalCreate:     Result := DocParams.cStUnProved;
    cgStatus_BuhCreate:     Result := DocParams.cUksCr;
    cgStatus_GalProved:     Result := DocParams.cStProved;
    cgStatus_GalUnProved:   Result := DocParams.cStUnProved;
    else
      Result := 0;
  end;

}
!-------------------------------------------------------------------------------------------------------------
! Установка текущего статуса документа, не нужна загруженная настройка, ставит протект по статусу
!-------------------------------------------------------------------------------------------------------------
procedure SetDocStatus(DocStatus: word);
{
  IsProoved := ((DocStatus = cg_Proved) or (DocStatus = cg_Storno));
  CurDocStatus := DocStatus;
}
!-------------------------------------------------------------------------------------------------------------
!Установка видимости вкладок
!-------------------------------------------------------------------------------------------------------------
procedure SetTabsVisible;
{
  Event_onCfgObjects(cgObject_Tab, '', DocParams.wTabs);
}
!-------------------------------------------------------------------------------------------------------------
! проверка правильности заполнения полей, и выставление цвета фона поля
! ОБЪЕДЕНИТЬ с ParseCfgObjectsVisible???
!-------------------------------------------------------------------------------------------------------------
function CheckFields(var Msg: string): boolean;
{
  Result := true;
  Msg := '';
  //надо прогнать все поля чтоб выставить фонт
  _loop cfgObjectsReq
    if (cfgObjectsReq.wType = cgAction_Requied)
    {
      if not Event_onCfgObjects(cgObject_Requied, trim(cfgObjectsReq.cfgName), 0)
      {
        Result := false;
        Msg += cfgObjectsReq.sLabel + ''#13;
      }
      //Result := Result and Event_onCfgObjects(cgObject_Requied, trim(cfgObjectsReq.cfgName), 0);
    }
}
!-------------------------------------------------------------------------------------------------------------
!нех лазить по внутренним таблицам из других интерфейсов
!-------------------------------------------------------------------------------------------------------------
procedure ParseCfgObjectsVisible(IsCancel: boolean = false);
var
  SendParam: word;
{
  _loop cfgObjectsVis
  {
    case cfgObjectsVis.wType of    //если никак не обрабатывать видимые, то можно в ограничения
      cgAction_Hide:    SendParam := if(IsCancel, cgAction_Show,      cfgObjectsVis.wType);
      cgAction_Protect: SendParam := if(IsCancel, cgAction_UnProtect, cfgObjectsVis.wType);
      else
        continue;
    end;
    Event_onCfgObjects(cgObject_Visible, trim(cfgObjectsVis.cfgName), SendParam);
  }

}

!-------------------------------------------------------------------------------------------------------------
! Установка типа документа
! меняем параметры видимости, только если тип изменился,
! незачем постоянно мелькать
! Устанавливает все необходимое для окон
!-------------------------------------------------------------------------------------------------------------
function SetTune(var cTune: tNrec; var wTune: word): boolean;
var
  Mes: string;
{

  if (par_TuneNrec != cTune) or (not IsLoadedTune)
  {
    wTune := cgSoprDocTune;
    //если, не первая настройка, то надо показать все спрятанные поля, загрузить настройку и спрятать новые
    if IsLoadedTune
      ParseCfgObjectsVisible(true);

    if (cTune = 0)
      cTune := PickTune;
    LoadDocTunes(cTune);
    ParseCfgObjectsVisible;
    SetTabsVisible;
    CheckFields(Mes);
  }
  Result := IsLoadedTune;
}

!-------------------------------------------------------------------------------------------------------------
!Настройка ТХО
!-------------------------------------------------------------------------------------------------------------
window wnTxoBook cyan, DoAccept, EscClose;
browse brTxoBook;
table TxoBook;
  Fields
    DlgBookType 'Имя' :[20], NoProtect, PickButton;
    DlgBookTxo  'Имя' :[40], NoProtect, PickButton;
    TxoBook.wDirect   :[List cwGlobalCodeBK_Buy 'покупка', cwGlobalCodeBK_Sell 'продажа'];
end;

tableEvent table TxoBook;
cmSetDefault:
{
  case word(BuhRep.cPlansSch) of
    101, 111: TxoBook.wDirect := cwGlobalCodeBK_Buy;
    201, 211: TxoBook.wDirect := cwGlobalCodeBK_Sell;
    204     : TxoBook.wDirect := cwGlobalCodeBK_Buy;
  end;
}
cmInsertRecord: insert current TxoBook;
cmUpdateRecord: update current TxoBook;
cmDeleteRecord: delete current TxoBook;
end;
HandleEvent
cmInit:
{
  if getFirst TxoBook != tsOk
  {}
}
cmPick:
{
  case CurField of
    #DlgBookType:
    {

 /*     case word(BuhRep.cPlansSch) of
        101, 111: wDirect := cwGlobalCodeBK_Buy;
        201, 211: wDirect := cwGlobalCodeBK_Sell;
      end;     */
      if (RunInterface('GetSchfTipDocTmp', TxoBook.wType, TxoBook.wDirect, 0) = cmDefault)
      {
         set TxoBook.wType := TxoBook.wType;
      }


    }
    #DlgBookTxo:
    {
      if (TxoBook.wType = 0)
      {
        Message('Выберите тип документа');
        Exit;
      }
      var cPlanNo: tNrec;
      iPSManager.GetTunePlansSch(cPlanNo);

      if (RunInterface('GetHozOper', cPlanNo, UsersDocTune.TipGal, 0, TxoBook.cTXO, cgiPick) = cmCancel)
        set TxoBook.cTXO := TxoBook.cTXO;

    }
  end;
}
end;
end;//window

function GetKauConst: word;
{
  Result := cgKau_CfgBase + BuhRep.cPlansSch;
//  exit;
//  case BuhRep.cPlansSch of
//    101,
//    201,
//    204: Result := cgKau_CfgBase + BuhRep.cPlansSch;//cgKau_CfgObjects101;
//    else
//      Result := 0;
//  end;

}
function PickCfgName(var cRec: tNrec; var sName: string; var sLabel: string): boolean;
var
  wType: word;
{
  Result := false;

  wType := GetKauConst;

  if (iGetKau.GetCodeKau(cgiPick, wType, cRec) >0)
  {
    sName := #ShowKauNum(wType, cRec, cgAnName);
    sLabel:= #ShowKauNum(wType, cRec, cgAnStrKod);
  }
  Result := true;
}

function PickCfgNameMult: boolean;
var wType : word;
    i, lCount : longint;
    cRec : comp;
{
  Result := false;

  wType := GetKauConst;

  lCount := iGetKau.GetCodeKau(cgiPickMult, wType, cRec);

  if (lCount = 0)
    Exit;

  if (lCount = 1)
  {
    set cfgObjectsVis.wType := cgAction_Hide;
    cfgObjectsVis.cRec      := cRec;
    cfgObjectsVis.cfgName   := #ShowKauNum(wType, cRec, cgAnName);
    cfgObjectsVis.sLabel    := #ShowKauNum(wType, cRec, cgAnStrKod);

    Updatetable;
    Exit;
  }

  var nMarkers : string[30] = iGetKau.GetMarkerName(wType);
  var MID : TPtr = InitMarker(nMarkers, 8, 200, 100, False);

  for(i := 0;  i < lCount; i++)
  {
    if not GetMarker(MID, i, cRec)
      Break;

    ClearBuffer(#cfgObjectsVis);

    cfgObjectsVis.OperType := cgObject_Visible;
    cfgObjectsVis.wType    := cgAction_Hide;
    cfgObjectsVis.cRec     := cRec;
    cfgObjectsVis.cfgName  := #ShowKauNum(wType, cRec, cgAnName);
    cfgObjectsVis.sLabel   := #ShowKauNum(wType, cRec, cgAnStrKod);

    insert current cfgObjectsVis;
  }

  DoneMarker(MID, '');
  ReReadRecord;

  Result := true;
}


