HandleEvent

cmInit:
  LoadDocTunes(Buhrep.Nrec);

cmDone:
{
  Updatetable;
  if (ListMode != cgMode_Pick)
  SaveTune(Buhrep.Nrec);
}

cmPick:
{
  case CurField of
    #DlgTuneType:
    {
      if (DocParams.cTXO != 0)
      {
        Message('В настройке есть ТХО.'#13 + 'Нельзя менять тип.');
        Exit;
      }
      piPickDoc.Clear;
      piPickDoc.LoadPreset(cgPickDoc_AllKatDoc);
      var wPar: word;
      wPar := word(BuhRep.cPlansSch);
      If piPickDoc.PickSingle('Выбор типа документа', wPar)
        Set BuhRep.cPlansSch := comp(wPar);
    }
    #DlgTXO:
    {
      if (BuhRep.cPlansSch = 0)
      {
        Message('Выберите тип документа');
        Exit;
      }
      var cPlanNo: tNrec;
      var wPar: word;
      iPSManager.GetTunePlansSch(cPlanNo);
      wPar := word(BuhRep.cPlansSch);
      if (RunInterface('GetHozOper', cPlanNo, wPar, 0, DocParams.cTXO, cgiPick) = cmCancel)
        set DocParams.cTXO := DocParams.cTXO;

    }
    #DlgTXOKPP:
    {
      RunWindowModal(wnTxoBook);

    }
    #DlgFieldsTune:
    {
      RunWindowModal(wncfgObj);
    }
    #DlgwType:
    {
      RunWindowModal(wnTabs);
    }
    #DlgwReq:
    {
      RunWindowModal(wncfgObjReq);
    }

    #ManagStatusName:
    {
      if (RunInterface( 'GetSomKatNotes', cgVidStatus_Control, 0, 0, FALSE, DocParams.cZakazCr ) != cmCancel)
        set DocParams.cZakazCr := DocParams.cZakazCr;
    }
    #BuhStatusName:
      if (RunInterface( 'GetSomKatNotes', cgVidStatus_Buh, 0, 0, FALSE, DocParams.cUksCr ) != cmCancel)
        set DocParams.cUksCr := DocParams.cUksCr;

  end;
}
end;
end;
