end;
HandleEvent

cmEdit:
  RunWindowModal(wnEditTune);

cmPick:
  PutCommand(cmEdit);
cmDefault:
{
  if (ListMode = cgMode_Add)
  {
    PutCommand(cmEdit);
    Stop;
    Exit;
  }
  //if (ListMode = cgMode_Pick)
    //PutCommand(cmDefault);
}
cmDone:
  Updatetable;
cmExp:
{
  if (ListMode = cgMode_Pick)
    if (GetKauConst != 0)
      if (RunWindowModal(wnName) != cmCancel)
        Event_onCreateObjectsAn(sNameBr, GetKauConst);
}
cmHotKeys:
  if (ListMode = cgMode_Pick)
    PutHotCommand(RunMenu('mnuRunDocTune'));
end;
end;// window wnListTune

#declare ifChMasck(wId)
 if((DocParams.wTabs  AND #wId)>0 AND (wOldfV AND #wId)=0)
#end

TableEvent table BuhRep;
cmCheckField :
{
  Case CurField of
   #DocParams.wTabs :
      if(BuhRep.cPlansSch = Comp(111))
      {  // Нельзя в одной операции несколько типов распределения по ЖД
         #ifChMasck(2)
           DocParams.wTabs := DocParams.wTabs AND Not(32);
         else
          #ifChMasck(32)
            DocParams.wTabs := DocParams.wTabs AND Not(2);
          wOldfV := DocParams.wTabs;
      }
  End; //case
}

cmPositionChanged:
{
  if (ListMode = cgMode_Pick)
    exit;
  SaveTune(par_TuneNrec);
  LoadDocTunes(Buhrep.Nrec);
}
cmInsertRecord:
  insert current BuhRep;

cmUpdateRecord:
  update current BuhRep;

cmSetDefault:
{
  SaveTune(par_TuneNrec);
  ClearParams;
  BuhRep.NRec   := 0;
  BuhRep.Descr  := sGetTune('USER.DESCR');
  BuhRep.DesGr  := sGetTune('USER.DESGR');
  BuhRep.dtSave := _CurDateTime;
  BuhRep.Name   := 'Новая настройка';
  BuhRep.Attr   := 0; //Вид документа сюда
  BuhRep.wBuhRep:= cgRepBuh_DocTune;
  BuhRep.cPlansSch := 0;
  insert current BuhRep;
  RereadRecord;
  SetDefs;
  SaveTune(BuhRep.NRec);
  RereadRecord;
  PutCommand(cmEdit);
}

cmDeleteRecord:
{
  if (message('Удалить настройку "' + BuhRep.Name + '"?', YesNo) = Yes) {
    Delete SpBuhRep where (( BuhRepEntity == wEntity and
                             BuhRep.NRec  == cEntity ));
    Delete current BuhRep;
  }
  Else abort;
}

end; //TableEvent table BuhRep

HandleEvent
cmDelOnProtect:
{
  case CurField of
    #DlgTuneType:
    {

      if (DocParams.cTXO != 0)
      {
        Message('В настройке есть ТХО.'#13 + 'Нельзя менять тип.');
        abort;
        Exit;
      }
      Set BuhRep.cPlansSch := 0;
    }
    #DlgTXO:     set DocParams.cTXO := 0;
    #DlgBookType:set DocParams.wBookType := 0;
    #DlgTXOKPP:  set DocParams.cTXOKPP := 0;
    #ManagStatusName: set DocParams.cZakazCr := 0;
  end;
}
end;

procedure InitMyMarker(mode : boolean);
{
  pMarker.StoreName := 'MOPERTUNEAUTO';
  pMarker.Caption  := (' Отмечено [%d] ');
  pMarker.AutoSave := True;
  pMarker.LoadAuto := false;

  pMarker.UnselectAll;

  pMarker.Disable := (not mode);
}

!-------------------------------------------------------------------------------------------------------------
Function PickTune(wMode: word = 0): tNRec;
var
  wTmp: word;
{
  Result := 0;
  if IsDocProtected
    Exit;

  SetHelpAndStatusContext(brListTunes, -1, sci14EnEsc, '');
  DisableCommand(cmInsert);
  DisableCommand(cmEdit);
  DisableCommand(cmdelete);
  DisableCommand(cmPick);

  if (wMode = 0)
  {
    if Not BoundActive(tbByTidk)
      PushBounds(tbByTidk);
/*    if(not ConditionActiveInLeave(tcbyDescr,#BuhRep))
      PushConditionForLeave (tcbyDescr,#BuhRep);     */

  }
  else
  {
    InitMyMarker(true);
//    if(ConditionActiveInLeave(tcbyDescr,#BuhRep)) PopConditionForLeave (tcbyDescr,#BuhRep);

    if (CurTidk != 0)
    {
      if Not BoundActive(tbByTidk)
        PushBounds(tbByTidk);
    }
    else
    {
      if Not BoundActive(tbByAllTune)
        PushBounds(tbByAllTune);
    }
  }

  if (GetFirst  Buhrep != tsOk)
  {
    Message('Нет настроек для данного вида документов!');
    Exit;
  }
  ListMode := cgMode_Pick;
  if (RunWindowModal(wnListTune) != cmDefault)
    Exit;

  par_TuneNrec := 0;
  Result := BuhRep.NRec;

  if (wMode = 1)
  {
    var pickrec: tnrec;
    var StatusMarker: TPTR = InitMarker(cDTMarkerName, 8,100,10);
    ClearMarker(StatusMarker);
    ResetBounds(#pMarker);

    _loop pMarker
      InsertMarker(StatusMarker, pMarker.pnRec);

    SetBounds(#pMarker);

    if (GetMarkerCount(StatusMarker) = 0)
      InsertMarker(StatusMarker, BuhRep.nRec);

    DoneMarker(StatusMarker, cDTMarkerName);
  }

  SetTune(BuhRep.Nrec, wTmp)

}


!-------------------------------------------------------------------------------------------------------------
!Запуск списка настроек
!-------------------------------------------------------------------------------------------------------------
function RunTune(wType: word): boolean;
{
  SetHelpAndStatusContext(brListTunes, -1, sci1478EnEsc, '');

  ListMode := cgMode_Add;
  RunWindow(wnListTune);

  Result := true;
}

constructor Init;
{
  CurTidk := 0;
  CurDocStatus := 0;
  InitMyMarker(false);

  ListMode := cgMode_Pick;
  if Not BoundActive(tbByAllTune)
    PushBounds(tbByAllTune);

  IsLoadedTune := false;

  Result := true;
}

constructor InitDoc(VidDoc: word; wDefTune: word = 0);
{
  CurTidk := VidDoc;
  CurDocStatus := 0;
  ListMode := cgMode_Pick;
  InitMyMarker(false);

  Result := true;
}

destructor done;
{
  if not NullVipRef (piPickDoc)
    piPickDoc := NullRef;
  if not NullVipRef (iPSManager)
    iPSManager := NullRef;
}

End.


Interface RunDocTune;
/*var
  wMode:word;
parameters
  wMode;   */
HandleEvent
cmInit:
{
  var
    iDocTune: DocTune new;
  begin
    iDocTune.RunTune(0);
    iDocTune := nullRef;
  end;
}

end;
end.
