HandleEvent
cmInit:
{
  wOldfV := DocParams.wTabs;

  Case BuhRep.cPlansSch of
    101: SetFormat(scTabs101);
    111: SetFormat(scTabs111);
    201: SetFormat(scTabs201);
    211: SetFormat(scTabs211);
    204: SetFormat(scTabs204);
  End;
}
  end;
end;

procedure SetDefs;
{
  DocParams.wTabs := Word(1);
}
!-------------------------------------------------------------------------------------------------------------
!Функции для работы с настройками Save\load
!-------------------------------------------------------------------------------------------------------------
Procedure ClearParams;
{
  delete all cfgObjects;
  delete all TxoBook;
  ClearAdvRecord(DocParams);
/*  DocParams.cStProved := GetStatusByNum(cg_Proved);
  DocParams.cStUnProved := GetStatusByNum(cg_UnProved);*/
}

function wGetParamTune(sName: String): Word;
{
  Entity.w := BuhRepEntity;
  Entity.c := BuhRep.Nrec;
  if (not iStorage.InitEnt(Entity))
    exit;

  iStorage.WordGetFld(sName  , Result);
}

!-------------------------------------------------------------------------------------------------------------
! Сохранение параметра настройки
!-------------------------------------------------------------------------------------------------------------
Function SaveTune(cTune: tNRec ):boolean;
var
  NRec : tNrec;
{
  Result := false;
  if cTune = 0
    Exit;
  Entity.w := BuhRepEntity;
  Entity.c := cTune;
  if (not iStorage.InitEnt(Entity))
    exit;
  iStorage.ClearEnt(Entity);
  iStorage.CompSetFld('cTXO'     , DocParams.cTXO);
  iStorage.WordSetFld('wOper'    , DocParams.wOper);
  iStorage.WordSetFld('wTabs'    , DocParams.wTabs);
  iStorage.CompSetFld('cZakazCr' , DocParams.cZakazCr);
  iStorage.CompSetFld('cUksCr'   , DocParams.cUksCr);
  iStorage.WordSetFld('wDateTTN' , DocParams.wDateTTN);
  iStorage.WordSetFld('wParTTN'  , DocParams.wParTTN);
  iStorage.WordSetFld('wParZd'   , DocParams.wParZd);
  iStorage.WordSetFld('wParSFB'  , DocParams.wParSFB);

  //сохранение настроек полей
  _loop cfgObjects
  {
    NRec ++;
    iStorage.CompSetTblFld('cfgOb', NRec , 'cRec', cfgObjects.cRec);
    iStorage.WordSetTblFld('cfgOb', NRec , 'wType', cfgObjects.wType);

  }
  //сохранение настроек ТХО
  _loop TxoBook
  {
    NRec ++;
    iStorage.CompSetTblFld('TxoB', NRec , 'cTxo' , TxoBook.cTxo);
    iStorage.WordSetTblFld('TxoB', NRec , 'wType', TxoBook.wType);
    iStorage.WordSetTblFld('cfgOb', NRec , 'wDir', TxoBook.wDirect);
  }

  iStorage.DoneEnt(Entity);
  Result := true;
}

!-------------------------------------------------------------------------------------------------------------
! Загрузка параметра настройки
!-------------------------------------------------------------------------------------------------------------
function LoadTune: boolean;
{
  Result := false;
  ClearParams;
  Entity.w := BuhRepEntity;
  Entity.c := BuhRep.Nrec;
  if (not iStorage.InitEnt(Entity))
    exit;

  iStorage.CompGetFld('cTXO',     DocParams.cTXO);
  iStorage.WordGetFld('wOper',    DocParams.wOper);
  iStorage.WordGetFld('wTabs',    DocParams.wTabs);
  iStorage.WordGetFld('wDateTTN', DocParams.wDateTTN);
  iStorage.WordGetFld('wParTTN',  DocParams.wParTTN);
  iStorage.WordGetFld('wParZd',   DocParams.wParZd);
  iStorage.CompGetFld('cZakazCr', DocParams.cZakazCr);
  iStorage.CompGetFld('cUksCr'  , DocParams.cUksCr);
  iStorage.WordGetFld('wParSFB'  , DocParams.wParSFB);

  //загрузка настройки полей
  iStorage.GetTblBoxRec('cfgOb');
  _loop BoxRec
  {
    ClearBuffer(#cfgObjects);
    iStorage.CompGetTblFld('cfgOb', BoxRec.cRec , 'cRec', cfgObjects.cRec);
    iStorage.WordGetTblFld('cfgOb', BoxRec.cRec, 'wType', cfgObjects.wType);

    cfgObjects.cfgName := #ShowKau(GetKauConst, cfgObjects.cRec);
    cfgObjects.sLabel  := #ShowKauNum(GetKauConst, cfgObjects.cRec, cgAnStrKod);
   //надо подумать тут
    case cfgObjects.wType of
      cgAction_Show
      ,cgAction_Hide
      ,cgAction_Protect: cfgObjects.OperType :=  cgObject_Visible;

     cgAction_NotRequied
     ,cgAction_Requied: cfgObjects.OperType := cgObject_Requied;
    end;
    insert current cfgObjects;
  }
  //загрузка настроек ТХО
  iStorage.GetTblBoxRec('TxoB');
  _loop BoxRec
  {
    ClearBuffer(#TxoBook);
    iStorage.CompGetTblFld('TxoB', BoxRec.cRec , 'cTxo', TxoBook.cTxo);
    iStorage.WordGetTblFld('TxoB', BoxRec.cRec, 'wType', TxoBook.wType);
    iStorage.WordGetTblFld('TxoB', BoxRec.cRec, 'wDir', TxoBook.wDirect);
    insert current TxoBook;
  }
  iStorage.DoneEnt(Entity);

  set DocParams.cTXO     := DocParams.cTXO;
  set DocParams.wOper    := DocParams.wOper;
  set DocParams.cZakazCr := DocParams.cZakazCr;
  if GetFirst HozOper = tsOk {}
  if GetFirst HozOperKPP = tsOk {}
  RereadRecord;
  Result := true;
}

!-------------------------------------------------------------------------------------------------------------
!Загрузка настроек, поидее только при полных параметрах
!-------------------------------------------------------------------------------------------------------------
function LoadDocTunes(cTune: tNRec):boolean;
{
  Result := IsLoadedTune := false;
  ClearParams;//угадай зачем
  SetDefs;
  par_TuneNrec := cTune;
  if (cTune = 0)
    Exit;
  //par_TuneNrec := cTune;
  /*if Not BoundActive(tbByNRec)
    PushBounds(tbByNRec);     */
  if (GetFirst BuhRep where ((par_TuneNrec == BuhRep.Nrec))!= tsOk)
  {
    Result := false;
    Exit;
  }
  LoadTune;
  RereadRecord;

  Result := IsLoadedTune := true;
}
