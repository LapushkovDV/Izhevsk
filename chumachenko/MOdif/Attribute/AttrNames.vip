// Внешние атрибуты таблиц базы данных
//------------------------------------------------------------------------------

#include PiP_Catalogs.vih  // Права и полномочия для справочников

#doc
Внешние атрибуты таблиц базы данных
#end
Interface AttrNames 'Внешние атрибуты таблиц базы данных', EscClose, Cyan;
  show at (,, 61, 18);

Table struct mTable
(
  wTable : word "Код таблицы",
  Name   : string[20],
  Title  : string[40],
  Access : word
)
With index
(
  mTable0 = wTable(Unique),
  mTable1 = Access + wTable
);

Const
  cs_NoInherit: string = 'Не наследуется';

var
  PiPCat: PiP_Catalogs; // Права и полномочия для справочников
  bUsePipBounds: boolean; // Требуется ли ограничивать видимость внешних атрибутов только для доступных пользователю таблиц

Create View
var
  w1, _attrType,
  wTip, old_attrType: word;
as select
  case(AttrNam.AttrType; cgAttrType_Str:    'строка',
                         cgAttrType_Dbl:    'вещественное число',
                         cgAttrType_Date:   'дата',
                         cgAttrType_Time:   'время',
                         cgAttrType_Memo:   'мемо-поле',
                         cgAttrType_Comp:   'ссылка->' + if(AttrNam.rType <> cgKatKau_System, KatKau.Name, x$Files.xf$Title),
                         cgAttrType_Switch: 'переключатель',
                         cgAttrType_Bool:   'признак',
                         cgAttrType_LongInt:'целочисленный'; 'не определен') (FieldName = sTMP),

  (sGetAttr(coAttrNam, AttrNam.nRec, cs_NoInherit) <> '0') and (sGetAttr(coAttrNam, AttrNam.nRec, cs_NoInherit) <> '')
    (FieldName = boNoInherit),

  if((mTable.Access and PIP_ACCESS_MODIFY) = 0, '', '+') (FieldName = sAccess),
  if(IsValidAll(tnAllMemo), '+', '-') (fieldname = fVisible),
  *
from
  x$Files(ReadOnly),
  KatKau(ReadOnly),
  AttrVal,
  AttrNam, mTable,
  AllMemo
where
((
       mTable.wTable  == AttrNam.wTable
  and  AttrNam.rObject  == KatKau.kodGroup
  and  AttrNam.rObject  == x$Files.xf$Code

  and  AttrNam.NRec      == AllMemo.cRec
  and  coAttrNam         == AllMemo.wTable
  and 'ConditionVisible' == AllMemo.Name (noindex)
))

bounds Belong = 0 << mTable.Access;

Parameters
  w1; // #docl Код таблицы


Browse br11 ('', hcGkatalM1Attr, sci1478EnEsc);
  show at (,,, 10);
  table mTable;
Fields
  mTable.Title 'Название таблицы': [20], Protect;
  mTable.Name 'Таблица': [10], Protect;
  sAccess 'Ред' ('Возможность редактирования перечня атрибутов таблицы'): [5], Protect, Centered, NoAutoSize;
end;

Browse br22('', hcGkatalM1Attr, sci14EnEsc);
  show at (, 11);
  table AttrNam;
Fields
  AttrNam.Name 'Название атрибута' ('Наименование внешнего (дополнительного) атрибута'): [25], Protect;
  sTMP         'Тип' ('Тип внешнего (дополнительного) атрибута'): [25], Protect;
  fVisible 'B' ('Настройка условий видимости атрибута') : [3], Protect,PickButton ,NoDel;
end;

// ----------------------------------------------------------------------------
Window WinTipAttr 'Тип атрибута' DoAccept, EscClose, Gray;
  show at (,, 35, 11);

Screen TipAttr (, hcGkatalM1Attr, sci1EnEsc);
fields
  _attrType ('Тип внешнего атрибута'), NoProtect;
buttons
  cmOk, Default;
  cmCancel;
<<

     (.)  строка`
     (.)  вещественное число`
     (.)  дата`
     (.)  время`
     (.)  мемо-поле`
     (.)  ссылка `
     (.)  признак `
     (.)  целочисленный `

  <.~П~родолжить.> <.   Отмена   .>
>>
End;

End; // WinTipAttr

WindowEvent WinTipAttr;

cmInit:
{
  old_attrType := AttrNam.attrType;
  _attrType := AttrNam.attrType;
}

cmOk:
{
  PackFields;
  if (_attrType = 6)
    set AttrNam.attrType := cgAttrType_Bool;
  else if (_attrType = 7)
    set AttrNam.attrType := cgAttrType_LongInt;
  else if (_attrType < cgAttrType_Comp)
    set AttrNam.attrType := _attrType;
  else
  {
    set AttrNam.attrType := cgAttrType_Comp;
    if (RunInterface('GetAttrTable', AttrNam.rType, AttrNam.rObject, AttrNam.coTable) = cmDefault)
      set AttrNam.attrType := cgAttrType_Comp;
    else
      if (old_attrType <> cgAttrType_Comp)
        set AttrNam.attrType := old_attrType;
  }

  CloseWindow(WinTipAttr);
}

End;

// ----------------------------------------------------------------------------
Window Win1 'Редактирование внешних атрибутов' EscClose;
  show at (,, 80, 15);

Browse br2view ('', hcGkatalM1Attr, sci1Esc);
  table AttrNam;
fields
  AttrNam.Name 'Название атрибута' ('Наименование внешнего (дополнительного) атрибута'): [33], Protect;
  sTMP         'Тип атрибута': [23], Protect;
  boNoInherit  'Н' ('Не наследуется'): [3], Protect, CheckBox, NoAutoSize;
End;

Browse br2 ('', hcGkatalM1Attr, sci178Esc);
  table AttrNam;
fields
  AttrNam.Name 'Название атрибута' ('Наименование внешнего (дополнительного) атрибута'): [33];
  sTMP         'Тип атрибута' ('',, sci1378Esc): [23], Protect;
  boNoInherit  'Н' ('Не наследуется',, sci178Esc): [3], NoProtect, CheckBox, NoAutoSize;
End;

End; // Win1


WindowEvent Win1;

cmInit:
{
  SetWindowTitle(Win1, 'Редактирование внешних атрибутов таблицы ' + mTable.Name + ' "' + mTable.Title + '"');

  if (sAccess = '')
  {
    SetFormat(br2view);
    SelectFieldInFormat(br2view, #AttrNam.Name);
  }
  else
  {
    SetFormat(br2);
    SelectFieldInFormat(br2, #AttrNam.Name);
  }
}

cmDone:
  if (w1 <> 0)
    CloseInterface(cmCancel);

End; // WindowEvent Win1

// ------------------------------------------------------------------------
TableEvent
  table mTable;

cmPositionChanged:
  SetHelpAndStatusContext(br11, -1, if(bUsePipBounds, sci14EnEsc, sci1478EnEsc), hcKeepCurrent);

cmDeleteRecord:
  if (message('Удаление может привести к потере ранее установленных ссылок.'#13 +
              'Удалить все атрибуты для таблицы?', Confirmation + YesNo) <> cmYes)
    abort;
  else
  {
    _loop AttrNam
    {
      delete AttrVal where (( AttrNam.NRec == AttrVal.cAttrNam ));
      delete current AttrNam;
    }
    delete current mTable;
    RereadRecord(#mTable);
  }

End; // TableEvent mTable


// ------------------------------------------------------------------------
TableEvent
  table AttrNam;

cmSetDefault:
{
  AttrNam.Name := '???';
  AttrNam.wTable := mTable.wTable;
  SelectField(#AttrNam.Name);
}

cmExprFieldChanged:
  if (CurField = #boNoInherit)
  {
    sSetAttr(coAttrNam, AttrNam.nRec, cs_NoInherit, String(word(Trim(ExprFieldValue) = 'TRUE')));
    RereadRecord(#mTable);
  }

cmInsertRecord:
  insert current AttrNam;

cmDeleteRecord:
  if (message('Удаление может привести к потере ранее установленных ссылок.'#13 +
              'Удалить атрибут?', Confirmation + YesNo) <> cmYes)
    abort;
  else
  {
    delete AttrVal where (( AttrNam.NRec == AttrVal.cAttrNam ));
    delete current AttrNam;
  }

cmUpdateRecord:
  update current AttrNam;

cmPick:
 {
  Case CurField of 
  #sTMP :{
    set AttrNam.wTable := mTable.wTable;
    UpdateTable;
    if (AttrNam.AttrType = cgAttrType_Switch) // для переключателя редактирование недоступно
      message('Изменение атрибута доступно только в конфигураторе.', Information)
    else
      RunWindowModal(WinTipAttr);
    UpdateTable;
    ReReadRecord(#AttrNam);
    ReReadRecord(#mTable);
  }
  
  #fVisible :{
    if (not UpdateTable) exit;
    RunInterface(AttrConditionEditor, AttrNam.NRec, mTable.name);
    ReReadRecord(tnAllMemo);
    set fVisible;
  }
  end;
 }
end; // TableEvent AttrNam


HandleEvent

cmInit:
{
  if (not PipCat.Init(coAttrNam, 0, bUsePipBounds))
  {
    abort;
    exit;
  }

  if (w1 = 0)
  {
    ResetBounds(#AttrNam);
    StartNewVisual(vtIndicatorVisual, vfTimer, 'Отбор таблиц с внешними атрибутами...', RecordsInTable(#AttrNam));

    _loop AttrNam
    {
      NextVisual;

      if (GetFirst mTable where (( AttrNam.wTable == mTable.wTable )) <> tsOk)
      {
        mTable.wTable := AttrNam.wTable;
        mTable.Access := PiPCat.GetAccessLevel(coAttrNam, 0, string(mTable.wTable));

        if (GetFirst x$Files where (( AttrNam.wTable == x$Files.xf$Code )) = tsOk)
        {
          mTable.Name := x$Files.xf$Name;
          mTable.Title := x$Files.xf$Title;
        }

        insert current mTable;
      }
    }

    StopVisual;
    SetBounds(#AttrNam);
  }
  else
  {
    if (GetFirst mTable where (( w1 == mTable.wTable )) <> tsOK)
    {
      mTable.wTable := w1;
      mTable.Access := PiPCat.GetAccessLevel(coAttrNam, 0, string(w1));

      if (GetFirst x$Files where (( w1 == x$Files.xf$Code )) = tsOk)
      {
        mTable.Name  := x$Files.xf$Name;
        mTable.Title := x$Files.xf$Title;
      }

      insert current mTable;
    }

    PutCommand(cmEdit);
  }

  if not bUsePipBounds
    SetFieldVisible(#sAccess, false);
  else
  {
    PushBounds(tbBelong);
    SetHelpAndStatusContext(br11, -1, sci14EnEsc, hcKeepCurrent);
  }

  ReReadRecord(#mTable);
}

cmEdit:
  RunWindow(Win1);

cmInsert:
{
  stop;

  if (CurTable <> #mTable) or (w1 <> 0)
    exit;

  var wTable: word = w1;
  if (RunInterface('PickTable', wTable) <> cmDefault)
    exit;

  if (wTable > 0)
  {
    if (GetFirst mTable where (( wTable == mTable.wTable )) = tsOK)
    {
      message('Такая таблица уже есть.', Information);
      RescanPanel(#AttrNam);
    }
    else
    {
      ClearBuffer(#mTable);
      mTable.wTable := wTable;
      mTable.Access := PiPCat.GetAccessLevel(coAttrNam, 0, string(mTable.wTable));

      if (GetFirst x$Files where (( wTable == x$Files.xf$Code )) = tsOk)
      {
        mTable.Name  := x$Files.xf$Name;
        mTable.Title := x$Files.xf$Title;
      }

      insert current mTable;
    }

    PutCommand(cmEdit);
  }
}

cmDefault:
  PutCommand(cmEdit);

End; // HandleEvent

End. // Interface
