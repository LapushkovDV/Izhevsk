Interface AttributeV3;
Create view
;
Window ValueInputWindow;

HandleEvent

cmDone:
{
  if ( inherited :: HandleEvent(cmDone) = heAbort )
    {
      Abort;
      Exit;
    }

  PutCommand(cmCancel);
}

end;

end;

HandleEvent

cmInit:
{
  if ( inherited :: HandleEvent(cmInit) = heAbort )
    {
      Abort;
      Exit;
    }

  if ( GetFirst AttrNam where (( AttrRec == AttrNam.nRec )) = tsOk )
    PutCommand(cmEdit);
}

cmOnVipLoad:
{
  if ( inherited :: HandleEvent(cmOnVipLoad) = heAbort )
    {
      Abort;
      Exit;
    }
}

cmOnVipUnload:
{
  if ( inherited :: HandleEvent(cmOnVipLoad) = heAbort )
    {
      Abort;
      Exit;
    }
}

end;

End.

