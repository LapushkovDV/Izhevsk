//******************************************************************************
Tableevent table AllMemo;
cmCheckRecord :
{
   MemoCheckSize.OpenMemo(AllMemo.MEM);
   if (MemoCheckSize.GetSize > 5242880) and (AttrNam.ATTRTYPE = cgAttrType_Memo) and boGetTune('ALLMEMO.CheckMemoSize')
   {
     Message ('Размер вложения превысил 5 Mb. Сделайте вложение меньше 5 MB и повторите операцию.', Error);
     ClearMemoField(AllMemo.MEM);
     ReScanPanel(#AllMemo);
     abort;
   }
   MemoCheckSize.Close;
}
end;

Panel panMemo;
  Table AllMemo;

Text
  MemoID = memAttrVal
  AllMemo.Mem #3'Значение атрибута';

HandleEvent

cmInsertRecord:
{
  MemoHasChanged := true;

  Insert Current AllMemo;
}

cmUpdateRecord:
{
  MemoHasChanged := true;

  Update Current AllMemo;
}

end; // of HandleEvent panMemoTbl

end;

//******************************************************************************

Panel panMemoTbl;
  Table mAttrVal;

HandleEvent

cmUpdateRecord:
{
  Update Current mAttrVal;
  RereadRecord(#mAttrVal);
}

end; // of HandleEvent panMemoTbl

end;

//******************************************************************************

HandleEvent //Окна

cmInit:
  {
    case AttrNam.AttrType of
    //-------------------------------------------------------------
      cgAttrType_Dbl:
        {
          SetFormat(DoubleInputScreen);
          SelectFieldInFormat(DoubleInputScreen, #mAttrVal.VDOUBLE);
          savDouble := mAttrVal.VDOUBLE;
        }
    //-------------------------------------------------------------
      cgAttrType_Date:
        {
          SetFormat(DateInputScreen);
          SelectFieldInFormat(DateInputScreen, #mAttrVal.VDATE);
          savDate := mAttrVal.VDATE;
        }
    //-------------------------------------------------------------
      cgAttrType_Time:
        {
          SetFormat(TimeInputScreen);
          SelectFieldInFormat(TimeInputScreen, #mAttrVal.VTIME);
          savTime := mAttrVal.VTIME;
        }
    //-------------------------------------------------------------
      cgAttrType_Str:
        {
          SetFormat(StringInputScreen);
          SelectFieldInFormat(StringInputScreen, #mAttrVal.VSTRING);
          savString := mAttrVal.VSTRING;
        }
    //-------------------------------------------------------------
      cgAttrType_Comp:
        {
          if (AttrNam.rObject = 0)
            {
              SetFormat(CompInputScreen2);
              SelectFieldInFormat(CompInputScreen2, #tAV);
            }
          else
            {
              SetFormat(CompInputScreen);
              SelectFieldInFormat(CompInputScreen, #tAV);
            }
          savComp := mAttrVal.VCOMP;
        }
    //-------------------------------------------------------------
      cgAttrType_Memo:
        {
          SetFormat(memAttrVal);
        }
    //-------------------------------------------------------------
      cgAttrType_Bool:
        {
          SetFormat(BooleanInputScreen);
          SelectFieldInFormat(BooleanInputScreen, #mAttrVal.VLONGINT);
          savLongInt := mAttrVal.VLONGINT;
        }
      cgAttrType_LongInt:
        {
          SetFormat(LongIntInputScreen);
          SelectFieldInFormat(LongIntInputScreen, #mAttrVal.VLONGINT);
          savLongInt := mAttrVal.VLONGINT;
        }
    //-------------------------------------------------------------
    end;

    SetModified(TRUE);
  }

cmCancel:
  if NOT PackFields
    abort
  else
    {
      var boChanged: boolean = FALSE;

      case AttrNam.AttrType of
      //-------------------------------------------------------------
        cgAttrType_Dbl : boChanged := savDouble  <> mAttrVal.VDOUBLE;
      //-------------------------------------------------------------
        cgAttrType_Date: boChanged := savDate    <> mAttrVal.VDATE;
      //-------------------------------------------------------------
        cgAttrType_Time: boChanged := savTime    <> mAttrVal.VTIME;
      //-------------------------------------------------------------
        cgAttrType_Str : boChanged := savString  <> mAttrVal.VSTRING;
      //-------------------------------------------------------------
        cgAttrType_Comp: boChanged := savComp    <> mAttrVal.VCOMP;
      //-------------------------------------------------------------
        cgAttrType_Bool,
        cgAttrType_LongInt: boChanged := savLongInt <> mAttrVal.VLONGINT;
      //-------------------------------------------------------------
      end;

      if ( boChanged )
          if (message(txtAskLeave, YesNo+mfSwapButtons+Confirmation) <> cmYes)
            Abort;
    }

cmDone:
{
  if IsModified
    UpdateTable;

  RereadRecord(#mAttrVal);
}

cmOk:
{
  if NOT UpdateTable
    Exit;

  CloseInterface(cmCancel);
}

cmHotKeys :
  case AttrNam.AttrType of
    cgAttrType_Str:
      PutHotCommand(RunMenu('Attribu_Edit_HotKeys'));
  end;

cmRestoreDoc:
{
  var sDirName : string;

  sDirName := AddSlashToPath(GetDirName('Выберите каталог'));
  if sDirName <> ''
  {
    set mAttrVal.VSTRING := sDirName;
    UpdateTable;
    CloseWindow(ValueInputWindow);
  }
}

end; // HandleEvent Window
end; // Window  GetmAttrVal

