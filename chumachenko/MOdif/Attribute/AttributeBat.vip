Tree AttribTree (, hcGkatalM1Attr, sci14Esc);
  Show at (,,, 12);
  Table AttrNam;

Fields
//------------------------------------------------------------------------------
  {Font = {color = if(NOT IsValid(#mAttrVal), ColorSysGray, 0)}};
//------------------------------------------------------------------------------
  AttrNam.Name  'Название атрибута'
                ('F4 - настроить атрибуты. Для изменения значения установите курсор на поле "Значение"')
                : [40], NoAutoSize, Protect;
//------------------------------------------------------------------------------
