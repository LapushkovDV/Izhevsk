Buttons
  cmOk, Default;
  cmValue1;
  cmCancel;

<<
  <. Установить значения .>  <. Очистить значения   .>  <. Отмена              .>
>>
end;

//******************************************************************************

Tableevent Table AttrNam;

cmPositionChanged:
{
  var wStatus : word;

  wStatus := if ((AttrNam.ATTRTYPE = cgAttrType_Str) OR (AttrNam.ATTRTYPE = cgAttrType_Comp) AND (AttrNam.rObject <> 0) OR (AttrNam.ATTRTYPE = cgAttrType_Bool), sci1348Esc, sci148Esc);

  SetFormat(AttribTree);

  SetHelpAndStatusContext(AttribTree, #tAV, wStatus, hcGkatalM1Attr);
}

cmTreeNodeType:
  case AttrNam.ATTRTYPE of
  //---------------------------------------------------------
    cgAttrType_Comp:
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_BrowseR');
  //---------------------------------------------------------
    cgAttrType_Dbl:
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_T_DOUBLE');
  //---------------------------------------------------------
    cgAttrType_Date
  , cgAttrType_Time:
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_T_DATETIME');
  //---------------------------------------------------------
    cgAttrType_Memo:
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_MEMO');
  //---------------------------------------------------------
    cgAttrType_Bool:
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_BOOLEAN');
  //---------------------------------------------------------
    cgAttrType_LongInt:
      TreeSetNodeType(AttribTree, ntfOpen, 'cfg_t_Longint');
  //---------------------------------------------------------
    else
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_T_STRING');
  //---------------------------------------------------------
  end; //case

cmDeleteRecord:
{
  if (IsValid(#mAttrVal))
    delete current mAttrVal;
}

end;

//******************************************************************************
// выцепить расширение из переданного имени файла
//
Function MyGetFileExt(s: string): string;
{
  if (pos('.', s) = 0)
    s := '';

  While (pos('.', s) > 0)
    s := substr(s, pos('.', s) + 1, 255);

  MyGetFileExt := s;
}

//******************************************************************************
File fSrc;
File fDes;
//******************************************************************************
// проверка сопроводительного документа на возможность редактирования
Function bOtkatToOldState: boolean;
{
  Result := True;

  Case TableCode of
    coKatSopr:
    {
      For (i := 0; i < GetMarkerCount(lMarker); i++)
        if (GetMarker(lMarker, i, _cRec))
          if (GetFirst KatSopr where ((_cRec == KatSopr.nRec)) = tsOk)
          {
            if (NOT oOtkatToOldState.OtkatToOldState(_cRec, 0, false, false, false, 0, coKatSopr, cmPickAttr))
            {
              Result := False;
              Exit;
            }
          }
    }
    coSpSopr:
    {
      For (i := 0; i < GetMarkerCount(lMarker); i++)
        if (GetMarker(lMarker, i, _cRec))
          if (GetFirst SpSopr where ((_cRec == SpSopr.nRec)) = tsOk)
          {
            if (NOT oOtkatToOldState.OtkatToOldState(SpSopr.cSopr, _cRec, false, false, false, 0, coKatSopr, cmPickAttr))
            {
              Result := False;
              Exit;
            }
          }
    }
  end;
}
//******************************************************************************

HandleEvent  // интерфейса

cmInit:
{
  if (TableCode = 0)
  {
    Message('Недостаточно информации для выбора атрибута'#13+
            'Возможно, не заполнена новая запись', Information+OkButton);

    CloseInterface(cmCancel);
  }

  if (GetFirst AttrNam <> tsOk)
    {
      var sInfo: string;

      if (GetFirst x$Files where (( TableCode == x$Files.XF$Code )) = tsOk)
        sInfo := ''#13 + '"' + X$Files.XF$TITLE + '" (' + X$Files.XF$Name + ')'
      else
        sInfo := ' с кодом ' + string(TableCode);

      Message('Нет внешних атрибутов для таблицы' + sInfo,Information);

      CloseInterface(cmCancel);
    }

  if (wGetTune('UsePiP') = 0)
  {
    var sTblTune: string = '';

    case TableCode of
      coKatPodr: sTblTune := 'KatPodr';
      coKatMC:   sTblTune := 'KatMC';
      coKatUsl:  sTblTune := 'KatUsl';
      coKatMOL:  sTblTune := 'KatMOL';
    end;

    if (sTblTune <> '')
    {
      if boGetTune('RghTbl.NoUpdate.' + sTblTune)
      {
        ShowTune('Запрещено редактирование каталога', 'RghTbl.NoUpdate.' + sTblTune);
        CloseInterface(cmCancel);
      }
    }
    else
      if (not boGetTune('ExtAttrTune.CanEdit'))
      {
        if (bOtkatToOldState) // проверка сопроводительного документа на возможность редактирования
          Exit;

        ShowTune('Запрещено редактирование документа', 'ExtAttrTune.CanEdit');
        CloseInterface(cmCancel);
      }
  }

  if (GetFirst X$Files where ((TableCode == X$Files.XF$Code)) = tsOk)
    SetTitle('Дополнительные атрибуты записи таблицы "' + X$Files.XF$TITLE + '" (' + X$Files.XF$Name + ')' );

  SetFormat(AttribTree);

  SetInterfaceOptions(opEscClose);

  if (GetFirst mAttrVal = tsOk)
    { }

  SelectField(#tAV);

  MemoHasChanged := false;
}

cmDone:
{
  _loop AttrNam
    delete safe AllMemo;
}

cmPick:
  case CurField of
  //------------------------------------------------------------------------------
    #mAttrVal.VSTRING:
      if AttrNam.attrType = cgAttrType_Str
        {
          var s: string = GetFileName('*.*', 'Выберите имя файла');

          if (s <> '')
            {
              set mAttrVal.VSTRING := s;
              UpdateTable;
            }
          CloseWindow(ValueInputWindow);
          RereadRecord(#mAttrVal);
        }
  //------------------------------------------------------------------------------
    #tAV:
        {
          if CurTable = #AttrNam
            {
              PutCommand(cmPick);
              ProcessCommand(cmOpenSearch);
            }
          else
            if (AttrNam.attrType = cgAttrType_Comp) AND (AttrNam.rObject <> 0)
              {
                var _result: boolean = false;
                //=====================================================================
                // выбор значения для аналитики (КАУ)
                //=====================================================================
                if (AttrNam.rType <> cgKatKau_System)
                {
                  // определить и запомнить старое значение
                  var wKau : word = AttrNam.rObject;
                  var cKau : comp = mAttrVal.vComp;

                  // вызвать выбор аналитики
                  if (iGetKau.GetCodeKau(cgiPick, wKau, cKau) <> 0)
                  {
                    set mAttrVal.vComp   := cKau;
                    set mAttrVal.vString := #ShowKau(wKau, cKau);

                    _result := true;
                  }
                }
                //=====================================================================
                // выбор значения для других таблиц
                //=====================================================================
                else
                {
                  // запомнить т.к. после точки расширения позиция может сбиться
                  var wCodeTable : word = AttrNam.rObject;

                  // если настройка типа comp создана в коде, то связи с интерфейсом выбора нет
                  if (wCodeTable = 0)
                    Exit;

                  var ifc : CreateAttrRef_Gal;

                  if not ifc.PickValueRefEx (wCodeTable, mAttrVal.vString, mAttrVal.vComp)
                  {
                    // если не найдена таблица (ошибочно указана), то выдается сообщение об отсутствии таблицы
                    // иначе сообщение о отсутствии интерфейса выбора
                    if( GetFirst x$files where ((wCodeTable == x$files.xf$code)) <> tsok )
                      message ('Нет таблицы с кодом ' + string(wCodeTable) + '.');
                    else
                      message ('Для таблицы с кодом ' + string(wCodeTable) + ' нет интерфейса выбора.');
                    exit;
                  }

                  set mAttrVal.vString := mAttrVal.vString;
                  set mAttrVal.vComp := mAttrVal.vComp;

                  _result := true;
                }

                if _result
                  CloseWindow(ValueInputWindow);
              }
        }
  //------------------------------------------------------------------------------
  end;

cmOpenSearch :
{
  if (CurField = #tAV)
  {
    Abort;

    if (AttrNam.AttrType = cgAttrType_Switch)    // для переключателя редактирование недоступно
      Message('Изменение атрибута доступно только в конфигураторе.')
    else
    {
      RunWindowModal(ValueInputWindow);
    }
    RereadRecord(#mAttrVal);
    RescanPanel(#AttrNam);
  }
}

cmEdit :
{
  case CurField of
  //---------------------------------------
  #AttrNam.Name:
  {
    RunInterface('AttrNames', TableCode);
    RescanPanel(#AttrNam);
  }
  //---------------------------------------
  #tAV : ProcessCommand(cmOpenSearch);
  //---------------------------------------
  end; // case
}

cmDelOnProtect:
{
  Abort;

  if (IsValid(#mAttrVal))
  {
    delete current mAttrVal;
    RereadRecord(#mAttrVal);
    RedrawPanel(#AttrNam);
  }
}

cmHotKeys :
{
  case AttrNam.AttrType of
  //------------------------------------------------------------------------------
    cgAttrType_Str:
    {
      PutHotCommand(RunMenu('Attribu_Edit_HotKeys'));
    }
  end;
}

cmRestoreDoc:
{
  PutCommand(cmRestoreDoc);
  RunWindow(ValueInputWindow);
}

cmOk:
{
  if ( RecordsInTable(#mAttrVal) = 0 ) and not MemoHasChanged
    {
      Message('Не задано ни одного значения для установки!', Information);
      Exit;
    }

  if ( Message('Установить значения внешних атрибутов для ' + string(GetMarkerCount(lMarker)) + ' записей?', Confirmation + YesNo) <> cmYes )
    Exit;

  StartNewVisual(vtIndicatorVisual, vfTimer, 'Установка значений внешних атрибутов...', GetMarkerCount(lMarker) * RecordsInTable(#AttrNam));

  for(i := 0; i < GetMarkerCount(lMarker); i++)
    if GetMarker(lMarker, i, _cRec)
      _Loop AttrNam
        {
          NextVisual;

          if ( AttrNam.AttrType = cgAttrType_Memo )
          {
            if IsValid(#AllMemo)
            {
              if ( GetFirst AttrVal where (( TableCode    == AttrVal.wTable and
                                             _cRec        == AttrVal.cRec   and
                                             AttrNam.NRec == AttrVal.cAttrNam )) <> tsOk )
                insert AttrVal set AttrVal.wTable   := TableCode
                                 , AttrVal.cRec     := _cRec
                                 , AttrVal.cAttrNam := AttrNam.NRec
                                 ;

              if fDes.OpenMemo(AttrVal.vLvar)
              {
                fDes.Seek(0);
                fDes.Truncate;

                if fSrc.OpenMemo(AllMemo.Mem)
                {
                  fSrc.Seek(0);

                  var tmpS : string;

                  while not fSrc.EOF do
                  {
                    fSrc.Readln(tmpS);
                    fDes.Writeln(tmpS);
                  }

                  fSrc.Close;
                }

                fDes.Close;

                update current AttrVal;
              }
            }
          }
          else
          {
            if not IsValid(#mAttrVal)
              Continue;

            case AttrNam.AttrType of
              cgAttrType_Str  : iAttr.sSetAttrID  (TableCode, _cRec, mAttrVal.cAttrNam, mAttrVal.vString);
              cgAttrType_Dbl  : iAttr.doSetAttrID (TableCode, _cRec, mAttrVal.cAttrNam, mAttrVal.vDouble);
              cgAttrType_Date : iAttr.dSetAttrID  (TableCode, _cRec, mAttrVal.cAttrNam, mAttrVal.vDate  );
              cgAttrType_Time : iAttr.tSetAttrID  (TableCode, _cRec, mAttrVal.cAttrNam, mAttrVal.vTime  );
              cgAttrType_Comp : iAttr.coSetAttrID (TableCode, _cRec, mAttrVal.cAttrNam, mAttrVal.vComp, mAttrVal.vString);
              cgAttrType_Bool : iAttr.bSetAttrIDEx(TableCode, _cRec, mAttrVal.cAttrNam, boolean(mAttrVal.VLONGINT));
              cgAttrType_LongInt : iAttr.lSetAttrIDEx(TableCode, _cRec, mAttrVal.cAttrNam, mAttrVal.VLONGINT);
            end;
          }
        }

  StopVisual('', 0);

  CloseInterface(cmCancel);
}

cmValue1:
{
  if ( Message('Очистить значение текущего внешнего атрибута для ' + string(GetMarkerCount(lMarker)) + ' записей?', Confirmation + YesNo) <> cmYes )
    Exit;

  var i    : longint;
  var _cRec: comp;

  StartNewVisual(vtIndicatorVisual, vfTimer, 'Очистка значений внешних атрибутов...', GetMarkerCount(lMarker) * RecordsInTable(#AttrNam));

  for(i := 0; i < GetMarkerCount(lMarker); i++)
    if GetMarker(lMarker, i, _cRec)
    {
      NextVisual;
      iAttr.DeleteValueID(TableCode, _cRec, AttrNam.NRec);
    }

  StopVisual('', 0);
}

end;
End.

//******************************************************************************
