//******************************************************************************

#doc
Внешние атрибуты. Показ в интерфейсе.
#end
Interface AttributeBat 'Внешние атрибуты' EscClose;
  Show at (, , 110, 15);

  Table Struct mAttrVal
  (
    wTable      : word        "Внутренний тип объекта",
    cRec        : comp        "Код записи в таблице-объекте БД",
    cAttrNam    : comp        "Код названия атрибута,ссылка на AttrNam",
    vString     : string      "string-значение атрибута",
    vDouble     : double      "double-значение атрибута",
    vDate       : date        "date-значение атрибута",
    vTime       : time        "time-значение атрибута",
    vComp       : comp        "comp-значение атрибута",
    vLongint    : longint     "int32-значение атрибута"
  )
  With index
  (
    mAttrVal2 = cAttrNam,
    mAttrVal3 = wTable(unique) + cAttrNam + cRec
  );

//******************************************************************************

var
  iAttr: iExtAttr;
  PiPCat: PiP_Catalogs;

#include GetKau.var // Объектный интерфейс выбора КАУ
#include OtkatToOldState.var    // Проверка накладной на возможность редактирования

//******************************************************************************

Function GetAValue: string; forward;

//******************************************************************************

Create view
Var
//------------------------------------------------------------------------------
  lMarker
                : TPtr;
//------------------------------------------------------------------------------
  TableCode
                : word;
//------------------------------------------------------------------------------
  savComp
, _cRec
                : comp;
//------------------------------------------------------------------------------
  savDouble
                : double;
//------------------------------------------------------------------------------
  savDate
                : date;
//------------------------------------------------------------------------------
  savTime
                : time;
//------------------------------------------------------------------------------
  savString
                : string;
//------------------------------------------------------------------------------
  savLongInt
, i
                : LongInt;
//------------------------------------------------------------------------------
  MemoHasChanged
                : boolean;
//******************************************************************************

As select
//------------------------------------------------------------------------------
  (GetAValue)
    ( Fieldname = tAV )
//------------------------------------------------------------------------------
, 'Значение атрибута "' + AttrNam.Name + '"'
+ if((AttrNam.AttrType = cgAttrType_Comp) AND (AttrNam.rObject <> 0), '(ссылка->' + if(AttrNam.rType <> cgKatKau_System, KatKau.Name, x$files.xf$title) + ')', '')
+ ':'
    ( Fieldname = ZnAt )
//------------------------------------------------------------------------------
, *
//------------------------------------------------------------------------------
From
  AllMemo
, AttrNam
, AttrVal
, mAttrVal
, KatKau
, KatSopr
, SpSopr
, X$Files

where
((
    TableCode       == AttrNam.wTable
AND TableCode       == mAttrVal.wTable
AND AttrNam.NRec    == mAttrVal.cAttrNam
AND AttrNam.rObject == KatKau.kodGroup
AND AttrNam.rObject == X$Files.xf$code
AND coAttrNam       == AllMemo.wTable
AND AttrNam.nRec    == AllMemo.cRec
))

Order by AttrNam.Name
;

Parameters
  TableCode // #docl код таблицы
, lMarker
;

//******************************************************************************

const
  txtAskLeave = 'Без нажатия кнопки "Установить" введенное значение будет утрачено.'#13#13
              + 'Вы уверены, что хотите закрыть окно?';

//******************************************************************************

File MemoCheckSize; // файл для проверки размера

//******************************************************************************

#include ShowKau.vpp

Function GetAValue: string;
{
  case AttrNam.AttrType of
  //------------------------------------------------------------------------------
    cgAttrType_Dbl:
      result := if( mAttrVal.vDouble < 0
                  , DoubleToStr(mAttrVal.vDouble, '36666666666666667.89999999')
                  , DoubleToStr(mAttrVal.vDouble, '66666666666666667.89999999')
                  )
  //------------------------------------------------------------------------------
    cgAttrType_Date:
      result := DateToStr(mAttrVal.vDate, 'DD/MM/YYYY');
  //------------------------------------------------------------------------------
    cgAttrType_Time:
      result := TimeToStr(mAttrVal.vTime, 'HH:MM');
  //------------------------------------------------------------------------------
    cgAttrType_Comp:
      {
        if (AttrNam.rType = cgKatKau_System)
          result := mAttrVal.vString
        else
          if (AttrNam.rObject = 0)
            result := string(mAttrVal.vComp)
          else
            result := #ShowKau(AttrNam.rObject, mAttrVal.vComp)
      }
  //------------------------------------------------------------------------------
    cgAttrType_Switch:     // переключатель
      result := string(mAttrVal.vComp);
  //------------------------------------------------------------------------------
    cgAttrType_Bool: 
      result := if(mAttrVal.VLONGINT = 0, 'нет', 'да');
  //------------------------------------------------------------------------------
    cgAttrType_LongInt:
      result := string(mAttrVal.VLONGINT);
  //------------------------------------------------------------------------------
    cgAttrType_Memo:
      result := 'мемо-поле (' +
                   if ( IsValid(tnAllMemo) AND (GetFieldFromMemo(0, 2, ftString, tnAllMemo) <> '')
                      , 'есть данные'
                      , 'нет данных'
                      ) + ')';
  //------------------------------------------------------------------------------
   else
      result := mAttrVal.vString;
  //------------------------------------------------------------------------------
  end;
}

//******************************************************************************

Tableevent
  Table mAttrVal;

cmInsertRecord:
  insert current mAttrVal;

cmUpdateRecord:
  Update current mAttrVal;

end;

