//******************************************************************************

#doc
Внешние атрибуты. Показ в интерфейсе.
#end
Interface Attribute 'Внешние атрибуты' EscClose;
  show at (,, 120, 15);

//******************************************************************************

var
  iAttr: iExtAttr;
  PiPCat: PiP_Catalogs;
  iAttrVisibility : AttrVisibility;
//******************************************************************************

Function GetAValue : string; forward;
Function GetAValueP: string; forward;

//******************************************************************************
#include AttrFunc.Vpp

Create view
Var
//------------------------------------------------------------------------------
  refAttrTablePick
                : AttrTablePick;
  iUserLink     : UserLink;
//------------------------------------------------------------------------------
  TableCode
, wTiDkGal
                : word;
//------------------------------------------------------------------------------
  RecordNumber
, savComp
                : comp;
//------------------------------------------------------------------------------
  bNotEditAttribute
, isVipLoad
                : boolean;
//------------------------------------------------------------------------------
  savDouble
                : double;
//------------------------------------------------------------------------------
  savDate
                : date;
//------------------------------------------------------------------------------
  savTime
                : time;
//------------------------------------------------------------------------------
  savString
                : string;
//------------------------------------------------------------------------------
  savLongInt
                : LongInt;
 mHiddenAttr : TPtr;
//******************************************************************************

As select
//------------------------------------------------------------------------------
  (GetAValue)    ( FieldName = tAV )
//------------------------------------------------------------------------------
, (GetAValueP)   ( FieldName = tAVP )
//------------------------------------------------------------------------------
, 'Значение атрибута "' + AttrNam.Name + '"'
+ if((AttrNam.AttrType = cgAttrType_Comp) AND (AttrNam.rObject <> 0), '(ссылка->' + if(AttrNam.rType <> cgKatKau_System, KatKau.Name, x$files.xf$title) + ')', '')
+ ':'
    ( FieldName = ZnAt )
//------------------------------------------------------------------------------
, AttrVal.Nrec // для доступа по Ctrl+F4
, *
//------------------------------------------------------------------------------
From
  AttrNam
, AttrVal
, X$Files
, KatKau
, DogPodr
, SpDocs
, SpSopr
, SpStep
, StepDoc
, SpSchF
, OKDP

where
((
      TableCode       == AttrNam.wTable
  AND TableCode       == AttrVal.wTable
  AND RECORDNUMBER    == AttrVal.cRec
  AND AttrNam.NRec    == AttrVal.cAttrNam
  AND AttrNam.rObject == KatKau.kodGroup
  AND AttrNam.rObject == X$Files.xf$code

  AND RECORDNUMBER    == SpSopr.nRec
  AND RECORDNUMBER    == SpDocs.nRec
  AND RECORDNUMBER    == SpStep.nRec
  AND SpStep.cStepDoc == StepDoc.nRec
))

Condition VisibleAttr = FoundMarker(mHiddenAttr, AttrNam.NRec)

Order by AttrNam.Name
;

Parameters
  TableCode // #docl код таблицы
, RecordNumber // #docl nRec записи
, bNotEditAttribute
, wTiDkGal
;

//******************************************************************************

const
  txtAskLeave = 'Без нажатия кнопки "Установить" введенное значение будет утрачено.'#13#13
              + 'Вы уверены, что хотите закрыть окно?';

//******************************************************************************
var m_cValue : word = 0;
File gfFile;
File MemoCheckSize; // файл для проверки размера
//******************************************************************************

Function GetAValue: string;
{
  Result := '';

  if not IsValid(#AttrVal)
    Exit;

  case AttrNam.AttrType of
  //------------------------------------------------------------------------------
    cgAttrType_Dbl:
    {
      if ( ( AttrNam.wTable = coKatOrg ) AND ( trim(AttrNam.Name) = 'Контроль ТЦО'
                                            OR trim(AttrNam.Name) = 'Резидент особой экономической зоны'
                                            OR trim(AttrNam.Name) = 'Взаимозависимое лицо'
                                            OR trim(AttrNam.Name) = 'Участие в КГН'
                                            OR trim(AttrNam.Name) = 'Субъект малого и среднего бизнеса' ) )
      {
        if ( trim(AttrNam.Name) = 'Субъект малого и среднего бизнеса' )
          Result := bCase( word(AttrVal.vDouble) = 0: 'не является субъектом малого и среднего бизнеса',
                           word(AttrVal.vDouble) = 1: 'субъект малого и среднего бизнеса';
                                                      'субъект малого бизнеса');
        else
          Result := if ( word(AttrVal.vDouble) = 1, 'да', 'нет');
      }
      else
        Result := if ( AttrVal.vDouble < 0, DoubleToStr(AttrVal.vDouble, '36666666666666667.89999999')
                                         , DoubleToStr(AttrVal.vDouble, '66666666666666667.89999999'))
    }
  //------------------------------------------------------------------------------
    cgAttrType_Date:
      REsult := DateToStr(AttrVal.vDate, 'DD/MM/YYYY');
  //------------------------------------------------------------------------------
    cgAttrType_Time:
      Result := TimeToStr(AttrVal.vTime, 'HH:MM');
  //------------------------------------------------------------------------------
    cgAttrType_Comp:
    {
      if ( AttrNam.rObject <> 5066 ) and (AttrNam.rObject <> coOKDP)
        Result := refAttrTablePick.sGetValue(AttrVal.wTable, AttrVal.cAttrNam, AttrVal.cRec);
      else
      {
        case AttrNam.rObject of
        coOKDP:
        {
          if getfirst OKDP where ((AttrVal.vComp == OKDP.NRec)) = tsOk
            Result := OKDP.Kod + ' - ' + OKDP.Name
        }
        else
          if ( GetFirst DogPodr where (( AttrVal.vComp == DogPodr.NRec )) = tsOk )
            Result := DogPodr.DscDoc+' от '+string(DogPodr.Datan);
        end;
      }
    }
  //------------------------------------------------------------------------------
    cgAttrType_Memo:
      Result := 'мемо-поле (' +
                if ( IsValid(tnAttrVal) AND (GetFieldFromMemo(0, 2, ftString, tnAttrVal) <> '')
                   , 'есть данные'
                   , 'нет данных'
                   ) + ')';
    cgAttrType_Switch:     // переключатель
      Result := string(AttrVal.vComp);
  //------------------------------------------------------------------------------
    cgAttrType_Bool:
      Result := if(AttrVal.VLONGINT = 0, 'нет', 'да');
  //------------------------------------------------------------------------------
    cgAttrType_LongInt:
      Result := string(AttrVal.VLONGINT);
  //------------------------------------------------------------------------------
   else
   {
     if( AttrNam.wTable = coKatOrg AND trim(AttrNam.Name) = 'Резидент офшорной зоны')
       Result := bCase(word(attrVal.vString) = 0: 'по стране',
                       word(attrVal.vString) = 1: 'да';
                                                  'нет');
     else
       Result := AttrVal.vString;
   }
  //------------------------------------------------------------------------------
  end;
}

//******************************************************************************
Function GetAValueP: string;
{
  Result := '';

  var wUpTable: word = 0;
  var pUpRec  : comp = 0;

  case TableCode of
    coSpDocs : { wUpTable := coDogovor; pUpRec := SpDocs.cDoc ;     }
    coSpSopr : { wUpTable := coKatSopr; pUpRec := SpSopr.cSopr;     }
    coSpStep : { wUpTable := coBaseDoc; pUpRec := StepDoc.cBaseDoc; }
    coSpSchF : { wUpTable := coSchFact; pUpRec := SpSchF.cSchFact;  }
  end;

  case AttrNam.AttrType of
  //------------------------------------------------------------------------------
    cgAttrType_Dbl:
      Result := DoubleToStr(doGetAttr(wUpTable, pUpRec, AttrNam.Name), '36666666666666667.89999999');
  //------------------------------------------------------------------------------
    cgAttrType_Date:
      Result :=   DateToStr( dGetAttr(wUpTable, pUpRec, AttrNam.Name), 'DD/MM/YYYY');
  //------------------------------------------------------------------------------
    cgAttrType_Time:
      Result :=   TimeToStr( tGetAttr(wUpTable, pUpRec, AttrNam.Name), 'HH:MM');
  //------------------------------------------------------------------------------
    cgAttrType_Comp:
      Result :=              sGetAttr(wUpTable, pUpRec, AttrNam.Name);
  //------------------------------------------------------------------------------
    cgAttrType_Memo:
      Result :=              mGetAttr(wUpTable, pUpRec, AttrNam.Name);
  //------------------------------------------------------------------------------
    else
      Result :=              sGetAttr(wUpTable, pUpRec, AttrNam.Name);
  //------------------------------------------------------------------------------
  end;
}

//******************************************************************************

function CanEditAttribute(bShowMessage : boolean = true) : boolean;
{
  result := not bNotEditAttribute;
  result := True;;
  exit;

  if (bNotEditAttribute)
  {
    // если постобработчик вернул TRUE, т.е не найден переписанные права доступа через подписку,
    // то будет использоваться стандартные права
    var bResault : boolean = epCanEditAttribute(AttrNam.Name, TableCode, RecordNumber);

    if (not bResault)
    {
      result := true;
      exit;
    }
  }
  if ((AttrNam.ATTRTYPE <> cgAttrType_Memo) and (bShowMessage) and (bNotEditAttribute))
    Message('В данном документе нельзя редактировать внешние атрибуты.')
}

//******************************************************************************

Tableevent
  Table AttrVal;
cmCheckRecord :
{
   if (AttrNam.ATTRTYPE = cgAttrType_Memo) and boGetTune('ALLMEMO.CheckMemoSize')
   {
     MemoCheckSize.OpenMemo(AttrVal.VLVAR);
     if (MemoCheckSize.GetSize > 5242880)
     {
       if (m_cValue <> cmDone)
         Message ('Размер вложения превысил 5 Mb. Сделайте вложение меньше 5 MB и повторите операцию.', Error);
       m_cValue := 0;
       ClearMemoField(AttrVal.vLvar);
       rescanPanel(#AttrVal);
       abort;
     }
     MemoCheckSize.Close;
   }
}

cmInsertRecord:
  if (CanEditAttribute(false))
    insert current AttrVal;

cmUpdateRecord:
  if (CanEditAttribute(false))
    Update current AttrVal;

end;

