//******************************************************************************
// выцепить расширение из переданного имени файла
//
Function MyGetFileExt(s: string): string;
{
  if (pos('.', s) = 0)
    s := '';

  While (pos('.', s) > 0)
    s := substr(s, pos('.', s) + 1, 255);

  MyGetFileExt := s;
}

//******************************************************************************

Procedure RunMyApplication(sParam: string);
{
  var sWhatRun: string;
  //если есть точка то файл, запускаем с параметром START. Если нету точки, то считаем что папка
  //и запускаем с параметром explorer.exe
  sWhatRun := 'explorer.exe';
  if (Pos('.', sParam) > 6)// проверка на файл или директорию
  {
    sWhatRun := 'START';
    if NOT File_OpenFile(sParam, stOpenRead, gfFile.Handle)
    {
      Message('Не удалось найти и открыть для чтения файл '#13 + sParam, Error);
      Exit;
    }
  }

  File_Close(gfFile.Handle);


  var sRunExt: string; sRunExt := 'Run.' + MyGetFileExt(sParam);

  if (iAttr.ValueExists(coAttrNam, AttrNam.Nrec, sRunExt))
    sWhatRun := iAttr.sGetAttr(coAttrNam, AttrNam.Nrec, sRunExt)
  else
    if (iAttr.ValueExists(coAttrNam, AttrNam.Nrec, 'RunAny'))
      sWhatRun := iAttr.sGetAttr(coAttrNam, AttrNam.Nrec, 'RunAny');

  StartNewVisual(vtRotateVisual, vfTimer, 'Запуск приложения:'#13 + sWhatRun + ' ' + sParam, 1);

  var iRun, iRet: integer;
  iRun := ExecProgram( sWhatRun
                     , sParam
                     ,''
                     , pfDontWait
                     , iRet
                     );

  StopVisual('', 0);
  case iRun of
  //------------------------------------------------------------------------------
    0:   {}
    2:   Message('Запускаемое приложение не найдено'#13 + sWhatRun, Error);
    5:   Message('Нет прав на доступ к запускаемому приложению или его папке'#13 + sWhatRun, Error);
    8:   Message('Не хватает памяти для загрузки приложения'#13 + sWhatRun, Error);
    10:  Message('Не найдена одна из динамических библиотек запускаемого приложения'#13 + sWhatRun, Error);
    11:  Message('Запускаемый файл не является программой'#13 + sWhatRun, Error);
    else Message('Коды запуска и возврата приложения'#13 + sWhatRun + ''#13 + string(iRun) + ' ' + string(iRet), mfError);
  //------------------------------------------------------------------------------
  end;
}

Function doInit: boolean;
{
  if (wGetTune('UsePiP') > 0)
  {
     case TableCode of
        coInvTab, coSpInvTab: {} //берем значение из переданного параметра
        else
        {
    // При включенном ПиП возможность просмотра и изменения ВА будет определяться настройками профиля пользователя
    bNotEditAttribute := false;

    if (not PiPCat.HaveAccessLevel(coAttrNam, 0, string(TableCode), PIP_ACCESS_MODIFY, PIP_SILENT))
      SetHelpAndStatusContext(AttribTree, #AttrNam.Name, sci1Esc, hcKeepCurrent);

    if (not PiPCat.HaveAccessLevel(coAttrNam, 0, string(TableCode), PIP_ACCESS_CHOOSE, PIP_SILENT))
    { // нельзя изменять значения ВА
      bNotEditAttribute := true;

      if (not PiPCat.HaveAccessLevel(coAttrNam, 0, string(TableCode), PIP_ACCESS_READ))
      {
        result := false;
        exit;
      }
    }
        }
      end;
  }

  result := true;

  // пр. 102.97684 Если используется интерфейс как объект, то права устанавливаются согласно методу RedrawEx
  if (not isVipLoad)
  {
    // запретить редактирование, если редактирование самих каталогов запрещено
    if (wGetTune('UsePiP') = 0)
    {
      case TableCode of
        coKatPodr: bNotEditAttribute := boGetTune('RghTbl.NoUpdate.KatPodr');
        coKatMC:   bNotEditAttribute := if (boGetTune('McUsl.CanEditAttrMC'), false,
                                        boGetTune('RghTbl.NoUpdate.KatMC'));
        coKatUsl:  bNotEditAttribute := boGetTune('RghTbl.NoUpdate.KatUsl');
        coKatMOL:  bNotEditAttribute := boGetTune('RghTbl.NoUpdate.KatMOL');
        coInvTab, coSpInvTab: {} //берем значение из переданного параметра
      else
      {
        if not bNotEditAttribute // параметр интерфейса. false - по умолчанию
          if (not ReadMyDsk(bNotEditAttribute, '_CanEditAttribute_', FALSE))
            bNotEditAttribute := false;

        SaveMyDsk(false, '_CanEditAttribute_');

        if bNotEditAttribute  // 180.4071 Редактирование внешних атрибутов при запрете редактирования документа
          if not iUserLink.CheckKatLinkRec(coKatDoc, wTiDkGal, UserID)
            bNotEditAttribute := not boGetTune('ExtAttrTune.CanEdit');
      }
      end;
    }

    if ((RecordNumber = 0) OR (TableCode = 0))
    {
      Message('Недостаточно информации для выбора атрибута'#13+
              'Возможно, не заполнена новая запись', Information+OkButton);

      CloseInterface(cmCancel);
    }

    DisableCommand(cmPickAttr);// пр. 102.146449 в обычном режиме это событие не должно работать. при встраивании должно

    if (CanEditAttribute(false))
      if (GetFirst AttrNam <> tsOk)
      {
        var sInfo: string;

        if (GetFirst x$Files where (( TableCode == x$Files.XF$Code )) = tsOk)
          sInfo := ''#13 + '"' + X$Files.XF$TITLE + '" (' + X$Files.XF$Name + ')'
        else
          sInfo := ' с кодом ' + string(TableCode);

        if (Message('Нет внешних атрибутов для таблицы' + sInfo + ''#13#13'Создать?',
                    Confirmation + YesNo) = cmYes )
        {
          RunInterface('AttrNames', TableCode);
          RereadRecord(#AttrNam);

          if (GetFirst AttrNam <> tsOk)
            CloseInterface(cmCancel);
        }
        else
          CloseInterface(cmCancel);
      }
  }

  if (GetFirst X$Files where ((TableCode == X$Files.XF$Code)) = tsOk)
    SetTitle('Дополнительные атрибуты записи таблицы "' + X$Files.XF$TITLE + '" (' + X$Files.XF$Name + ')' );

!  SetFormat(if (not CanEditAttribute(false), AttribTreeView, AttribTree));
   SetFormat(AttribTree);

  SetInterfaceOptions(opEscClose OR if(not CanEditAttribute(false), opCyanInterface, 0) );

  mHiddenAttr := iAttrVisibility.GetHiddenAttributes(TableCode, X$Files.XF$Name, RecordNumber);
  if (iAttrVisibility.LastErrorDescription <> '')
    message(iAttrVisibility.LastErrorDescription, error);

  PushConditionForLeave(tcVisibleAttr,#attrnam);

  if (GetFirst AttrVal = tsOk)
    { }

  case TableCode of
    coSpDocs
  , coSpSopr
  , coSpStep
  , coSpSchF
    :
    {
      var sTitle: string = 'Значение атрибута шапки документа'#13;

      if (GetFirst X$Files where ((BCase(TableCode = coSpDocs: coDogovor,
                                         TableCode = coSpSopr: coKatSopr,
                                         TableCode = coSpStep: coBaseDoc,
                                         TableCode = coSpSchF: coSchFact) == X$Files.XF$Code)) = tsOk)
        sTitle += X$Files.XF$TITLE + '" (' + X$Files.XF$Name + ')'
      else
        sTitle += '(шапка документа)';

      SetColumnTitle(AttribTree    , #tAVP, sTitle);
      SetColumnTitle(AttribTreeView, #tAVP, sTitle);

      ToggleFieldVisible(#tAVP, True);
    }
  else
      ToggleFieldVisible(#tAVP, False);
  end;

  SelectField(#tAV);
}
//******************************************************************************
// Перечитывает атрибуты и возвращает TRUE если запись AttrVal существует
Function ReDrawEx ( _wTable : word; _cRec : comp; _Enable: boolean) : boolean;
{
  set TableCode    := _wTable;
  set RecordNumber := _cRec;

  Result := IsValid(#AttrVal);
  bNotEditAttribute := not _Enable;
  if (not bNotEditAttribute)
  {
    EnableCommand(cmRestoreDoc);
    EnableCommand(cmSortMC);
  }
  else
  {
    DisableCommand(cmRestoreDoc);
    DisableCommand(cmSortMC);
  }
  doInit;
  RescanPanel(#AttrNam);
}

Function ReDraw( _wTable: word; _cRec: comp): boolean;
{
  Result := ReDrawEx(_wTable, _cRec, true);
}

Function RunModal(_wTable : word; _cRec : comp; _Enable: boolean = true) : word;
{
  //установка прав редактирования
  result := RunInterface('Attribute', _wTable, _cRec, not _Enable);
}
//******************************************************************************

procedure InputValue;
{
  if ((not CanEditAttribute(false)) and (AttrNam.ATTRTYPE <> cgAttrType_Memo))
    Exit;

  if ((not IsValid(#AttrNam)) and CanEditAttribute(false))
    if (Message('Нет внешних атрибутов для данной таблицы.'#13'Создать?', YesNo) <> Yes )
        Exit
    else
      {
        RunInterface(AttrNames, TableCode);

        if (GetFirst AttrNam = tsOk)
          RereadRecord(#AttrNam)
        else
          Exit;
      }

  if (AttrNam.AttrType = cgAttrType_Switch)    // для переключателя редактирование недоступно
    Message('Изменение атрибута доступно только в конфигураторе.')
  else
  {
    // если постобработчик вернул TRUE, т.е не найден переписанный диалог изменения атрибута,
    // то будет использоваться стандартный
    if (epShowDialogSetAttrValue(AttrNam.Name, TableCode, RecordNumber))
      RunWindowModal(ValueInputWindow);
  }

  RereadRecord(#AttrVal);
  RescanPanel(#AttrNam);
}

HandleEvent  // интерфейса

cmInit:
{
  if (not doInit)
    abort;
}

cmOnVipLoad:
{
  isVipLoad         := true;
  bNotEditAttribute := false;

  ProcessCommand(cmInit);
}

cmPick:
{
  case CurField of
  //------------------------------------------------------------------------------
    #AttrVal.VSTRING:
      if AttrNam.attrType = cgAttrType_Str
      or AttrNam.attrType = cgAttrType_File
        {
          var s: string; s := GetFileName('*.*', 'Выберите имя файла');
          if (s <> '')
            {
              set AttrVal.VSTRING := s;
              UpdateTable;
            }
          CloseWindow(ValueInputWindow);
          RereadRecord(#AttrVal);
        }
  //------------------------------------------------------------------------------
    #tAV:
      if CanEditAttribute
        {
          if CurTable = #AttrNam
            {
              if (AttrNam.attrType = cgAttrType_Comp or AttrNam.attrType = cgAttrType_File)
              PutCommand(cmPick);

              InputValue;
            }
          else
            if (AttrNam.attrType = cgAttrType_Comp) AND (AttrNam.rObject <> 0)
              if refAttrTablePick.PickValue(AttrNam.wTable, AttrNam.NRec, RecordNumber)
                {
                  CloseWindow(ValueInputWindow);
                  RereadRecord(#AttrVal);
                }
        }
  //------------------------------------------------------------------------------
  end;
}

cmOpenSearch :
{
  if (CurField = #tAV)
  {
    abort;// надо остановить для данной колонки.
    InputValue;  
    exit;
   }

   if ((not CanEditAttribute(false)) and (AttrNam.ATTRTYPE <> cgAttrType_Memo))
     Stop
}

cmEdit :
{
  case CurField of
  //---------------------------------------
  #AttrNam.Name:
  {
    if (not CanEditAttribute)
    {
      Stop;
      Exit;
    }

    RunInterface('AttrNames', TableCode);
    RescanPanel(#AttrNam);
  }
  //---------------------------------------
  #tAV :
  {
    if (not CanEditAttribute)
    {
      Stop;
      Exit;
    }
    InputValue;
  }
  end; // case
}

cmDelOnProtect:
{
  Abort;
  if (not CanEditAttribute) Exit;

  if (IsValid(#AttrVal))
  {
    delete current AttrVal;
    RereadRecord(#AttrVal);
    RedrawPanel(#AttrNam);
  }
}

cmPickAttr :
{
  if (CanEditAttribute(false))
    if (isValid(#AttrNam))
      RunInterface('Attribute', word(coAttrNam), AttrNam.Nrec);
}

cmHotKeys :
{
  var MenuID:longInt = LoadMenu('Attribu_List_HotKeys');

  if (CanEditAttribute(false))
    EnableCommand(cmValue1)
  else
    DisableCommand(cmValue1);

  case AttrNam.AttrType of
  //------------------------------------------------------------------------------
    cgAttrType_Str, cgAttrType_File:
    {
      if (CanEditAttribute(false))
        if (AttrVal.vString <> '')
          EnableCommand(cmSortMC);
        else
          DisableCommand(cmSortMC);

      var ExtMenuID:longInt = LoadMenu('Attribu_Str_HotKeys');
      AddMenuItem(MenuID, 'separator', 1);
      ConcatMenu(MenuID, ExtMenuID);
  //------------------------------------------------------------------------------
    }
  end;

  PutHotCommand(RunLoadMenu(MenuID));
}

cmValue1:
{
  RunInterface(AttrNames, TableCode);
  RescanPanel(#AttrNam);
}

cmValue2:
{
  InputValue;
}

cmSortMC:
  case AttrNam.AttrType of
  //------------------------------------------------------------------------------
    cgAttrType_Str,  cgAttrType_File:
      if (AttrVal.vString <> '')
        RunMyApplication(AttrVal.vString);
  //------------------------------------------------------------------------------
  end;

cmRestoreDoc:
{
  PutCommand(cmRestoreDoc);
  RunWindow(ValueInputWindow);
}

end;
End.

//******************************************************************************

Attribu_List_HotKeys Menu
{
- 'Редактирование атрибутов', cmValue1, 'Настройка атрибутов', hcGkatalM1Attr,,, sci1Esc;
- 'Редактирование значения атрибута', cmValue2, 'Изменение значения атрибута', hcGkatalM1Attr,,, sci1Esc;
}

Attribu_Str_HotKeys Menu
{
- 'Запуск внешнего приложения', cmSortMC    , 'Запуск приложения для обработки файла или директории, имя которого хранится в строковом значении внешнего атрибута', hcNastrLocMRunOutAppl, 'Alt+R', kbAltR,sci1Esc;
- 'Выбор директории'          , cmRestoreDoc, 'Выбор директории, путь которой хранится в строковом значении внешнего атрибута'                     , hcNastrLocMRunOutAppl, 'Ctrl+F3', kbCtrlF3,sci1Esc;
}

Attribu_Edit_HotKeys Menu
{
- 'Выбор директории'          , cmRestoreDoc, 'Выбор директории, путь которой хранится в строковом значении внешнего атрибута'                     , hcNastrLocMRunOutAppl, 'Ctrl+F3', kbCtrlF3,sci1Esc;
}

