//******************************************************************************

Panel panMemoTbl;
  Table AttrVal;

//******************************************************************************

Text
  MemoID = memAttrVal
  AttrVal.vLvar 'Значение атрибута';

//******************************************************************************

HandleEvent

cmUpdateRecord:
{
  if (CanEditAttribute(false))
    Update Current AttrVal;
  RereadRecord(#AttrVal);
}

end; // of HandleEvent panMemoTbl
end;

//******************************************************************************
Panel panMemoTblView;
  Table AttrVal;

Text
  MemoID = memAttrValView
  AttrVal.vLvar 'Значение атрибута' : Protect;

end;

//******************************************************************************

HandleEvent //Окна

cmInit:
  {
    m_cValue := 0;
    case AttrNam.AttrType of
    //-------------------------------------------------------------
      cgAttrType_Dbl:
        {
          SetFormat(DoubleInputScreen);
          SelectFieldInFormat(DoubleInputScreen, #AttrVal.VDOUBLE);
          savDouble := AttrVal.VDOUBLE;
        }
    //-------------------------------------------------------------
      cgAttrType_Date:
        {
          SetFormat(DateInputScreen);
          SelectFieldInFormat(DateInputScreen, #AttrVal.VDATE);
          savDate := AttrVal.VDATE;
        }
    //-------------------------------------------------------------
      cgAttrType_Time:
        {
          SetFormat(TimeInputScreen);
          SelectFieldInFormat(TimeInputScreen, #AttrVal.VTIME);
          savTime := AttrVal.VTIME;
        }
    //-------------------------------------------------------------
      cgAttrType_Str:
        {
          SetFormat(StringInputScreen);
          SelectFieldInFormat(StringInputScreen, #AttrVal.VSTRING);
          savString := AttrVal.VSTRING;
        }
    //-------------------------------------------------------------
      cgAttrType_Comp:
        {
          if (AttrNam.rObject = 0)
            {
              SetFormat(CompInputScreen2);
              SelectFieldInFormat(CompInputScreen2, #tAV);
            }
          else
            {
              SetFormat(CompInputScreen);
              SelectFieldInFormat(CompInputScreen, #tAV);
            }
          savComp := AttrVal.VCOMP;
        }
    //-------------------------------------------------------------
      cgAttrType_Memo:
        {
          if (CanEditAttribute(false))
            SetFormat(memAttrVal);
          else
            SetFormat(memAttrValView);
        }
    //-------------------------------------------------------------
      cgAttrType_Bool:
      {
        SetFormat(BooleanInputScreen);
        SelectFieldInFormat(BooleanInputScreen, #AttrVal.VLONGINT);
        savLongInt := AttrVal.VLONGINT;
      }
    //-------------------------------------------------------------
      cgAttrType_LongInt:
      {
        SetFormat(LongIntInputScreen);
        SelectFieldInFormat(LongIntInputScreen, #AttrVal.VLONGINT);
        savLongInt := AttrVal.VLONGINT;
      }
    //-------------------------------------------------------------
    end;

    SetModified(TRUE);
  }

cmCancel:
{
  m_cValue := cmCancel;
  if NOT PackFields
    abort
  else
    {

      var boChanged: boolean;  boChanged := FALSE;

      case AttrNam.AttrType of
      //-------------------------------------------------------------
        cgAttrType_Dbl : boChanged := savDouble <> AttrVal.VDOUBLE;
      //-------------------------------------------------------------
        cgAttrType_Date: boChanged := savDate   <> AttrVal.VDATE;
      //-------------------------------------------------------------
        cgAttrType_Time: boChanged := savTime   <> AttrVal.VTIME;
      //-------------------------------------------------------------
        cgAttrType_Str : boChanged := savString <> AttrVal.VSTRING;
      //-------------------------------------------------------------
        cgAttrType_Comp: boChanged := savComp   <> AttrVal.VCOMP;
      //-------------------------------------------------------------
        cgAttrType_Bool,
        cgAttrType_LongInt : boChanged := savLongInt <> AttrVal.VLONGINT;

      end;

      if ( boChanged )
          if (message(txtAskLeave, YesNo+mfSwapButtons) <> cmYes)
            Abort;
    }
}

cmDone:
{
  m_cValue := cmDone;
  case AttrNam.AttrType of
  //-------------------------------------------------------------
  cgAttrType_Memo:
  {
    if (CanEditAttribute(false))
      if (not UpdateTable)
        exit;
  }
  //-------------------------------------------------------------
  end;

  RereadRecord(#AttrVal);
}

cmOk:
{
  m_cValue := cmOk;
  if (CanEditAttribute(false))
    if NOT UpdateTable
      Exit;

  CloseInterface(cmCancel);
}

cmHotKeys :
  case AttrNam.AttrType of
    cgAttrType_Str, cgAttrType_File:
      PutHotCommand(RunMenu('Attribu_Edit_HotKeys'));
  end;

cmRestoreDoc:
{
  var sDirName : string;

  sDirName := AddSlashToPath(GetDirName('Выберите каталог'));
  if sDirName <> ''
  {
    set AttrVal.VSTRING := sDirName;
    UpdateTable;
    CloseWindow(ValueInputWindow);
  }
}

end; // HandleEvent Window
end; // Window  GetAttrVal

