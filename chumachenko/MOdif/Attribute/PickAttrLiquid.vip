// Система T2 ERP - Общая функциональность
// Выбор внешних атрибутов для позиций с объектом программы ликвидации
//------------------------------------------------------------------------------
#include PickAttrLiquid.vih
#include MTRFuncs.vih
#include KatOs.vih
#include ObjStroyFunc.vih
#include SpyTNTPR.vih

#doc
Выбор внешних атрибутов для позиций с объектом программы ликвидации
#end
Interface PickAttrLiquid;

#include MTRFuncs.var
#include SpyTNTPR.var
var oObjFunc: ObjStroyFunc;

Create View

var
  cObjSpec
, cLiquidProgram: comp;

As Select
  *

From
  SpSopr
, KatOS
, LikvidOs
, VidNorma
, FpCO

where
((
    cObjSpec        == LikvidOs.cKatStroy
and LikvidOs.cKatOs == KatOS.NRec
and KatOS.cVid      == VidNorma.NRec
and KatOs.cCo       == FpCo.NRec
))
;

Window wnPickPos 'Выбор основного средства' ('Выбор основного средства', hcNoContext, sci14EnEsc) doAccept;
  Show At (,,148,30);

Browse brPickPos;
  Table LikvidOs;
Fields
  KatOS.NameOs 'Основные средства' : [42], Protect;
  KatOS.InNum  'Инв. номер'        : [15], Protect;
  VidNorma.Kod 'Вид ОС'            : [15], Protect;
  FpCO.Name    'ЦО'                : [15], Protect;
end; // Browse

end;

//------------------------------------------------------------------------------
// Необходимо ли запускать выбор внешних атрибутов для программы ликвидации
//------------------------------------------------------------------------------
Function IsNeedRun(wTable: word; cRec: comp; wKau: word; sAttrName: string): boolean;
{
  result := false;

  if not (pSpyTN.GetIsTNTPR and pSpyTN.GetTNTPRVer = cgTNTPRVer_3_0)
    exit;

  case wTable of

    coSpSopr:
    {
      // 1. заполнение внешнего атрибута "Основные средства" таблицы SpSopr
      if (wKau != cgKau_OS or sAttrName != 'Основные средства')
        exit;

      if (GetFirst SpSopr where (( cRec == SpSopr.NRec )) != tsOk)
        exit;

      case SpSopr.VidSopr of

        110, 111, 629:
        {}

        else
          exit; // остальные пропускаем

      end;
    }

    else
      exit; // остальные пропускаем

  end;

  set cObjSpec := oMTRFun.GetObjUKS(wTable, cRec);

  if (cObjSpec = 0)
    exit;

  if (oObjFunc.Program_NRec(cObjSpec) != cLiquidProgram)
    exit;

  result := (GetFirst LikvidOs = tsOk);
}

//------------------------------------------------------------------------------
// Выбора внешних атрибутов для позиций с объектом программы ликвидации
//------------------------------------------------------------------------------
Function RunPickAttr(wKau: word; var cKau: comp): boolean;
{
  result := false;

  if (wKau != cgKau_OS)
    exit;

  if (cKau != 0)
    if (GetFirst LikvidOs where (( cObjSpec == LikvidOs.cKatStroy and cKau == LikvidOs.cKatOs )) = tsOk)
    {}

  if (RunWindowModal(wnPickPos) != cmDefault)
    exit;

  cKau := KatOS.NRec;
  result := true;
}

HandleEvent

cmOnVipLoad:
  cLiquidProgram := oObjFunc.ProgramLiquid_NRec;

End;

End.  //Interface
