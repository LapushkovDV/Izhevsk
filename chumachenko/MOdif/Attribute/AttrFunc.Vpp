// Простые функции по работе с внещними атрибутами
//******************************************************************************
var wImageAttr : integer = -1;
Function GetImage(_ATTRTYPE:word) :string;
{
  // Здесь прочитать с CFG
  if wImageAttr = -1
  { wImageAttr :=0;
    var _s : string = Trim(UpCase(GetStringParameter('Image','ExtAttrType',0)));
    if _s='1' or _s='TRUE'
      wImageAttr := 1;
  }
  if wImageAttr = 1  // новые атрибуты
  { Result:='EXTATTR_STRING';
    case _ATTRTYPE of
    //---------------------------------------------------------
      cgAttrType_Comp:
        Result:= 'C_ExtClass::EXTATTR_BROWSER';
    //---------------------------------------------------------
      cgAttrType_Memo:
        Result:= 'C_ExtClass::EXTATTR_MEMO';
    //---------------------------------------------------------
      cgAttrType_Dbl:
        Result:=  'C_ExtClass::EXTATTR_DOUBLE';
    //---------------------------------------------------------
      cgAttrType_Date:
        Result:=  'C_ExtClass::EXTATTR_DATETIME';
    //---------------------------------------------------------
      cgAttrType_Time:
        Result:=  'C_ExtClass::EXTATTR_TIME';
    //---------------------------------------------------------
      cgAttrType_Switch:
        Result:= 'C_ExtClass::EXTATTR_BROWSER';
    //---------------------------------------------------------
      cgAttrType_Bool:
        Result:=  'C_ExtClass::EXTATTR_BOOLEAN';
    //---------------------------------------------------------
      cgAttrType_File:
        Result:=  'C_ExtClass::EXTATTR_FILE';
    //---------------------------------------------------------
      cgAttrType_Longint:
        Result:=  'C_ExtClass::EXTATTR_LONGINT';
    //---------------------------------------------------------
      else
        Result:=  'C_ExtClass::EXTATTR_STRING';
    //---------------------------------------------------------
    end; //case
  }
  else  // старый вариант
  { // было без указание компоненты - это с атлантиса. Если у каких то типов пропадет  нужно добавить
    Result:='CFG_T_STRING';
    case _ATTRTYPE of
    //---------------------------------------------------------
      cgAttrType_Comp:
        Result:= 'CFG_BrowseR';
    //---------------------------------------------------------
      cgAttrType_Memo:
        Result:= 'CFG_MEMO';
    //---------------------------------------------------------
      cgAttrType_Dbl:
        Result:=  'CFG_T_DOUBLE';
    //---------------------------------------------------------
      cgAttrType_Date
    , cgAttrType_Time:
        Result:=  'CFG_T_DATETIME';
    //---------------------------------------------------------
      cgAttrType_File:
        Result:=  'C_ExtClass::EXTATTR_FILE';
    //---------------------------------------------------------
      cgAttrType_Bool:
        Result:=  'C_ExtClass::CFG_BOOLEAN';
      cgAttrType_Longint:
        Result:=  'C_ExtClass::EXTATTR_LONGINT';
    //---------------------------------------------------------
      cgAttrType_Switch:
        Result:= 'cfg_Check';
      else
              Result:=  'CFG_T_STRING';
    //---------------------------------------------------------
    end; //case

  }

}
