// Выбор значения внешнего атрибута
//------------------------------------------------------------------------------

#include AttrTablePick.vih

#doc
Выбор значения внешнего  атрибута. <br>
</brief>
  TableCode    - код таблицы;<br>
  RecordNumber - nRec записи;<br>
#end
Interface PickAttrVal 'Выбор внешних атрибутов' DoAccept, EscClose, Cyan;
  Show at (, , 108, 9);

//******************************************************************************

Function GetAValue: string; forward;

//******************************************************************************

Create view
Var
//------------------------------------------------------------------------------
  refAttrTablePick : AttrTablePick;
//------------------------------------------------------------------------------
  Mode, TableCode  : word;
//------------------------------------------------------------------------------
  RecordNumber, c1 : comp;
  MarkVal          : TPtr;
  IndexVal         : longint;
//------------------------------------------------------------------------------
//------------------------------------------------------------------------------

//******************************************************************************

As select
//------------------------------------------------------------------------------
  (GetAValue)     ( Fieldname = tAV )
//------------------------------------------------------------------------------
// , 'Значение атрибута "' + AttrNam.Name + '":'                ( Fieldname = ZnAt )
,  if(SearchMarker(MarkVal,AttrVal.nRec,IndexVal), 'v', '')  ( Fieldname = Picked )
, *

//------------------------------------------------------------------------------
From
  AttrNam
, AttrVal
, X$Files

where
((
       TableCODE     ==  AttrNam.WTable
  AND  TableCODE     ==  AttrVal.WTable
  AND  RECORDNUMBER  ==  AttrVal.CREC
  AND  AttrNam.NRec  ==  AttrVal.CAttrNam
))

Order by AttrNam.Name;

Parameters
  Mode           // cgiPick, cgiMulti, cgiNotEdit
, TableCode
, RecordNumber
, c1
;


//******************************************************************************
Procedure SetMyTitle;
{
  SetTitle( '... (выбрано: ' +  string(GetMarkerCount(MarkVal)) + ')');
}
Procedure KillPick;
{
  ClearMarker(MarkVal);
  SetMyTitle;
}
procedure OneMarkPick;
{
  if IsValid(#AttrVal)
    InvertMarker(MarkVal, AttrVal.nRec);
  SetMyTitle;
}


Function GetAValue: string;
{
  case AttrNam.AttrType of
  //------------------------------------------------------------------------------
    cgAttrType_Dbl:
      GetAValue := if( AttrVal.vDouble < 0
                     , DoubleToStr(AttrVal.vDouble, '36666666666666667.89999999')
                     , DoubleToStr(AttrVal.vDouble, '66666666666666667.89999999')
                     )
  //------------------------------------------------------------------------------
    cgAttrType_Date:
      GetAValue := DateToStr(AttrVal.vDate, 'DD/MM/YYYY');
  //------------------------------------------------------------------------------
    cgAttrType_Time:
      GetAValue := TimeToStr(AttrVal.vTime, 'HH:MM');
  //------------------------------------------------------------------------------
    cgAttrType_Comp:
      GetAValue := refAttrTablePick.sGetValue(AttrVal.wTable, AttrVal.cAttrNam, AttrVal.cRec);
  //------------------------------------------------------------------------------
    cgAttrType_Memo:
      GetAValue := 'мемо-поле (' +
                   if ( IsValid(tnAttrVal) AND (GetFieldFromMemo(0, 2, ftString, tnAttrVal) <> '')
                      , 'есть данные'
                      , 'нет данных'
                      ) + ')';
    cgAttrType_Switch:     // переключатель
      GetAValue := string(AttrVal.vComp);
  //------------------------------------------------------------------------------
    cgAttrType_Bool: result := if(AttrVal.VLONGINT = 0, 'нет', 'да');
  //------------------------------------------------------------------------------
    cgAttrType_LongInt:     // переключатель
      GetAValue := string(AttrVal.VLONGINT);
  //------------------------------------------------------------------------------
    else
      GetAValue := AttrVal.vString;
  //------------------------------------------------------------------------------
  end;
}



//******************************************************************************

Tree 1 AttribTree ('Только просмотр. Атрибуты - закрыты от редактирования', hcGkatalM1Attr, sci1EnEscInsPM);
  Table AttrNam;

Fields
//------------------------------------------------------------------------------
    { Font = { Color = if(Picked = '', 0, ColorMark) }};
//  {Font = {color = if(NOT IsValid(#AttrVal), ColorSysGray, 0)}};
//------------------------------------------------------------------------------
  Picked          'V'                 : [ 1], Skip, NoAutoSize, Centered;
//------------------------------------------------------------------------------
  AttrNam.Name    'Название атрибута' : [29], NoAutoSize, Protect;
//------------------------------------------------------------------------------
  tAV             'Значение атрибута' : [44], Protect;
//------------------------------------------------------------------------------
end;

//******************************************************************************

Tableevent Table AttrNam;

cmTreeNodeType:
  case AttrNam.ATTRTYPE of
  //---------------------------------------------------------
    cgAttrType_Comp:
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_BrowseR');
  //---------------------------------------------------------
    cgAttrType_Memo:
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_MEMO');
  //---------------------------------------------------------
    cgAttrType_Dbl:
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_T_DOUBLE');
  //---------------------------------------------------------
    cgAttrType_Date
  , cgAttrType_Time:
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_T_DATETIME');
  //---------------------------------------------------------
    cgAttrType_Bool:
       TreeSetNodeType(AttribTree, ntfOpen, 'CFG_BOOLEAN');
    cgAttrType_LongInt:
       TreeSetNodeType(AttribTree, ntfOpen, 'cfg_t_Longint');
    else
      TreeSetNodeType(AttribTree, ntfOpen, 'CFG_T_STRING');
  //---------------------------------------------------------
  end; //case

end;


//******************************************************************************

HandleEvent  // интерфейса
cmInit:
  {
    if ((RecordNumber = 0) OR (TableCode = 0))
      {
         Message('Недостаточно информации для выбора атрибута'#13+
                 'Возможно, не заполнена новая запись', Information+OkButton);

         CloseInterface(cmCancel);
      }

    if (GetFirst AttrNam <> tsOk)
      {
        var sInfo: string;

        if (GetFirst x$Files where (( TableCode == x$Files.XF$Code )) = tsOk)
          sInfo := ''#13 + '"' + X$Files.XF$TITLE + '" (' + X$Files.XF$Name + ')'
        else
          sInfo := ' с кодом ' + string(TableCode);

        if (Message('Нет внешних атрибутов для таблицы' + sInfo + ''#13#13'Создать?',
                    Confirmation + YesNo) = cmYes )

          {
            RunInterface('AttrNames', TableCode);

            RereadRecord(#AttrNam);

            if (GetFirst AttrNam <> tsOk)
              CloseInterface(cmCancel);
          }
        else
          CloseInterface(cmCancel);
      }

    if GetFirst X$Files where ((TableCode == X$Files.XF$Code)) = tsOk
      SetTitle('Выберите атрибуты записи таблицы "' + X$Files.XF$TITLE + '" (' + X$Files.XF$Name + ')' );

    if ((Mode and cgiPick) > 0)
    {
      if ((Mode and cgiNotEdit) > 0)
        SetHelpAndStatusContext(AttribTree, -1, sci1EnEsc, hcGkatalM1Attr);
      else
        SetHelpAndStatusContext(AttribTree, -1, sci14EnEsc, hcGkatalM1Attr);
    }
    else
    {
      if ((Mode and cgiNotEdit) > 0)
        SetHelpAndStatusContext(AttribTree, -1, sci1EnEscInsPM, hcGkatalM1Attr);
      else
        SetHelpAndStatusContext(AttribTree, -1, sci14InsPMEnEsc, hcGkatalM1Attr);
    }

    MarkVal := InitMarker('AttrVal_' + string(TableCode),8,50,10);
    ClearMarker(MarkVal);

    if GetFirst AttrVal = tsOk  { }

    SelectField(#tAV);
  }

cmMarkUnMark :
{
  OneMarkPick;
  RedrawCurrentAndGo(GetCurrentFormat, true);
  SetMyTitle;
  RescanPanel(#AttrNam);
}


cmSelectAll :
{
  PushPos(#AttrNam);
  KillPick;
  _Loop AttrNam
    if IsValid(#AttrVal)
      InsertMarker(MarkVal,AttrVal.nrec);
  SetMyTitle;
  PopPos(#AttrNam);
  ReReadRecord(#AttrNam);
}

cmUnSelectAll :
{
  KillPick;
  ReReadRecord(#AttrNam);
  RescanPanel(#AttrNam);
}

cmEdit:
  RunInterface('Attribute', TableCode, RecordNumber);

cmDefault :
 if IsValid(#AttrVal)
 {
  if ((Mode and cgiPick) > 0)
      c1 := AttrVal.nRec;
  else
    {
      if GetMarkerCount(MarkVal) = 0
        {
          OneMarkPick;
          c1 := AttrVal.nrec;
        }
      if GetMarkerCount(MarkVal) = 1
        GetMarker(MarkVal,0,c1);
    }
 }
 else   c1 := 0;

cmDone:
  DoneMarker(MarkVal,'AttrVal_' + string(TableCode));

end;
End.


//******************************************************************************
