#include  AttrRef1502_BuhSchet.vih
#include  PSManager.vih

#doc
Создание атрибутов типа ссылка (не аналитика)
#end

Interface AttrRef1502_BuhSchet;

#include PSManager.var

Create view
From
 BuhSchet
;
/*------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------------------*/
property IAttrRefPlugin.wCodeTable: word read coBuhSchet;


//  Реализация интерфейса вызова для таблицы
Function PickValue (var p_sVal: string; var p_cVal: comp; var p_bChangeValue: boolean): boolean;
{
  p_bChangeValue := false;

  var cPlansSch : tNRec;

  if (not iPSManager.GetTunePlansSch(cPlansSch))
  {
    Abort;
    Exit;
  }

  var sSchet    : tSchet3;
  var sSubSchet : tSubSch;

  if (p_cVal <> 0)
  {
    if (GetFirst BuhSchet where ((p_cVal == BuhSchet.Nrec)) = tsOk)
    {
      sSchet :=  BuhSchet.Schet;
      sSubSchet := BuhSchet.SubSch;
    }
  }

  Result := true;

  if (RunInterface('GetBuhSchet',word(cgiPick or cgiPickExt), cPlansSch, sSchet, sSubSchet) = cmCancel)
    Exit;

  if (GetFirst BuhSchet where ((sSchet == BuhSchet.Schet and sSubSchet == BuhSchet.SubSch)) = tsOk)
  {
    p_cVal := BuhSchet.Nrec;
    p_sVal := sSchet + if(BuhSchet.Code = '', '', '.' + sSubSchet) + ' ' + BuhSchet.Name;
  }

  p_bChangeValue := true;
}

end. // интерфейс
//------------------------------------------------------------------------------
