// Выбор названия внешнего атрибута
//------------------------------------------------------------------------------

#include marker.vih

#doc
Выбор названия внешнего атрибута из AttrNam.
#end

Interface PickAttrNam 'Выбор названия атрибута' DoAccept, EscClose, Cyan;
show at (,,80,15);

Create View
Var
  lCode : comp;
  wTab  : word;
  wPick : word;

  pMarker: IMarker(Marker) new;

as select
  if (AttrNam.AttrType = cgAttrType_Str , 'CFG_T_STRING',
  if (AttrNam.AttrType = cgAttrType_Dbl , 'CFG_T_DOUBLE',
  if (AttrNam.AttrType = cgAttrType_Date, 'CFG_T_DATETIME',
  if (AttrNam.AttrType = cgAttrType_Time, 'CFG_T_DATETIME',
  if (AttrNam.AttrType = cgAttrType_Memo, 'CFG_MEMO',
  if (AttrNam.AttrType = cgAttrType_Comp, 'CFG_BrowseR',
  if (AttrNam.AttrType = cgAttrType_Bool, 'CFG_BOOLEAN',
  if (AttrNam.AttrType = cgAttrType_LongInt, 'cfg_t_Longint',
                                          'CFG_T_STRING'))))))))
    (FieldName = strType)
from
  AttrNam
, X$Files  
where
((
  wTab == AttrNam.wTable
));

Parameters
  lCode
, wTab
, wPick
;

Browse brw1 (, hcGkatalM1Attr, sci1EnEsc);
  Table AttrNam;
  recMarker = pMarker{AttrNam.NRec};
Fields
  AttrNam.NAME 'Название атрибута' ('Выберите атрибут и нажмите Enter' ): Protect, browseImage(strType);
end; // browse

HandleEvent

cmDefault:
{
  if pMarker.Disable
    lCode := AttrNam.NRec
  else
  {
    if (pMarker.Count = 0)
      pMarker.Mark;

    pMarker.ExportToName('GetAttrName');
  }
}  

cmInit:
{
  if (GetFirst AttrNam <> tsOK)
  {
    if (GetFirst X$Files where ((wTab == X$Files.XF$Code)) = tsOk)
      Message('Отсутствуют внешние атрибуты у таблицы "' + X$Files.XF$TITLE + '" (' + X$Files.XF$Name + ')', Information)
    else
      Message('Отсутствуют внешние атрибуты у таблицы с кодом ' + string(wTab), Information);
      
    Abort;
    Exit;
  }
  
  if (lCode <> 0)
  {
    if (GetFirst AttrNam where ((lCode == AttrNam.NRec)) <> tsOK)
      if (GetFirst AttrNam <> tsOK) {}
  }

  if (GetFirst X$Files where ((wTab == X$Files.XF$Code)) = tsOk)
    SetTitle('Выбор названия атрибута таблицы "' + X$Files.XF$TITLE + '" (' + X$Files.XF$Name + ')')
  else
    SetTitle('Выбор названия атрибута таблицы с кодом ' + string(wTab));
 
  pMarker.Disable := (wPick and cgiMulti) = 0;

  if not pMarker.Disable
  {
    SetHelpAndStatusContext(brw1, -1, sciEnEsc1Ins, '');

    if ((wPick and cgiNotClear) <> 0)
      pMarker.ImportFromName('GetAttrName');
  }
}

end;  // HandleEvent
End.  // interface
