
#ifndef _CreateAttrRef_Gal
#define _CreateAttrRef_Gal

#component "C_ExtClass"

#include GetAttrTable.vih
#doc
Для реализации интерфейсов плагинов "прочих таблиц" в атрибутах
Интерфейс - плагин должен реализовывать IAttrRefPlugin и наименование интерфейса должно начинаться с AttrRef + код таблицы(тоже значение что и в свойстве wCodeTable)
#end
ObjInterface IAttrRefPlugin;
  #doc
    Код таблицы для которой реализуется плагин
  #end
  property wCodeTable: word read;
  #doc
  Реализует интерфейс выбора из таблицы.
    p_sVal - строковое значение атрибута. Возвращаемое значение
    p_cVal - Nrec значения атрибута. Возвращаемое значение
    p_bChangeValue - было ли значение изменено. Если False, то значение внешнего атрибута не обновляется
    Результат:
      Если False, то интерфейс для таблицы не реализован
  #end
  Function PickValue (var p_sVal: string; var p_cVal: comp; var p_bChangeValue: boolean): boolean;
end;

VipInterface CreateAttrRef_Gal implements ObjCreateAttrRefPlugin, ObjCreateAttrRefPluginEx licensed (FREE);

#end
