#include Attribu_.vih
#include ExClass.Vih

#doc
Пример встраивания внешних атрибутов и внешней классификации<br>
</brief>
#end
Interface TestEmbInts 'Пример встраивания внешних атрибутов и внешней классификации' EscClose;
  Show at (, , 200, 25);

create view vTuneList
var
  m_wShowEmb1, m_wShowEmb2, m_wCheckRigths, m_wSetUserValues : word;
  m_sEdit, m_sUserNrec, m_sUserTable : string;
  m_objAttribute : Attribute;
  m_objExClassifier : ExClassifier;
as
select
*
from
  TuneDef;

screen Setup (,,);
  Show at (, , , 5);
 Notablenavigation;
   bevel b1 { 0, 0, 25, 5, bsLowered, bsFrame};
   bevel b2 { 28, 0, 47, 5, bsLowered, bsFrame};
   bevel b3 { 48, 0, 70, 5, bsLowered, bsFrame};
Fields
  m_wShowEmb1 ('Показывать встраиваемый интерфейс - Внешние атрибуты') , NoProtect;
  m_wCheckRigths ('Показывать встраиваемый интерфейс - C правами') , NoProtect;
  m_wSetUserValues ('Передать значение и таблицу'), NoProtect;
  m_sUserTable ('Код таблицы, для которой нужно посмотреть значения'): noProtect;
  m_wShowEmb2 ('Показывать встраиваемый интерфейс - Внешняя классификация') , NoProtect;
  m_sEdit ('Можно редактировать, если в наименовании есть данное словосочетание'): noProtect;
  m_sUserNrec ('Нрек таблицы, для которой нужно посмотреть значения'): noProtect;
Buttons
  cmValue1;
  cmValue2;
<<

  [.] Внешние атрибуты       ` [.] Установка прав` [.] Просмотр     `    <.   RunInterface Внешние атрибуты  .>
                                                  Код таблицы.@@@@@@@@
  [.] Внешняя классификация  `.@@@@@@@@@@@@@@     Нрек записи.@@@@@@@@   <.RunInterface Внешняя классификация.>
>>
end;

browse brUsers ('',hcNastrM1NastrAllUser,sci18Esc);
  show at (, 6, 56,);
  Table TuneDef;
fields
  TuneDef.Name 'Наименование настройки' : [55],Protect;
end;

TabbedSheet Right tsPages;
  show at (57, 7, ,);
Screen scrEmpty '' (, , sciWindow);
  Notablenavigation;
<<
>>
end;// Screen scrEmpty

embedded embOutAtrributes interface;
end;

embedded embOutClassifiers interface;
end;

end; //TabbedSheet tsPages

procedure ShowTabbedSheet;
{
  SetTabbedSheetVisible(embOutAtrributes, (m_wShowEmb1 <> 0));
  SetTabbedSheetTitle(embOutAtrributes, 'Внешние атрибуты');
  SetTabbedSheetVisible (embOutClassifiers, (m_wShowEmb2 <> 0));
  SetTabbedSheetTitle(embOutClassifiers, 'Внешняя классификация');
  SetTabbedSheetVisible (scrEmpty, ((m_wShowEmb1 = 0) and (m_wShowEmb2 = 0)));
  SetTabbedSheetTitle(scrEmpty, '');
}

procedure SetRights;
var
  cNrec : comp;
  wTable : word;
  bRight : boolean;
{
  cNrec := TuneDef.nRec;
  wTable := coTuneDef;
  bRight := true;
  if (m_wCheckRigths <> 0) bRight := pos(m_sEdit, TuneDef.Name) <> 0;
  if (m_wSetUserValues <> 0)
  {
    cNrec := comp(m_sUserNrec);
    wTable := word(m_sUserTable);
    // всегда только в режиме чтения - чтобы не было возможности изменить атрибут или классификацию
    // только через интерфейсы ERP.
    // Исключение будет Таблица Настроек - обычно атрибуты и классификацию не заводят на них
    bRight := false;
  }

  if (m_wCheckRigths = 0)
    ClearFieldOption(#m_sEdit, ofSelectable);
  else
    SetFieldOption(#m_sEdit, ofSelectable);
  m_objAttribute.reDrawEx(wTable, cNrec, bRight);
  m_objExClassifier.reDrawEx(wTable, cNrec, bRight);

}

procedure RunOperation(wCommand : word);
var
  cNrec : comp;
  wTable : word;
  bRight, bResult : boolean;
{
  cNrec := TuneDef.nRec;
  wTable := coTuneDef;
  bRight := true;
  if (m_wCheckRigths <> 0) bRight := pos(m_sEdit, TuneDef.Name) <> 0;
  if (m_wSetUserValues <> 0)
  {
    cNrec := comp(m_sUserNrec);
    wTable := word(m_sUserTable);
    // всегда только в режиме чтения - чтобы не было возможности изменить атрибут или классификацию
    // только через интерфейсы ERP.
    // Исключение будет Таблица Настроек - обычно атрибуты и классификацию не заводят на них
    bRight := false;
  }

  if (wCommand = cmValue2)
    bResult := m_objExClassifier.RunModal(wTable, cNrec, bRight) = cmCancel;
  else if (wCommand = cmValue1)
    bResult := m_objAttribute.RunModal(wTable, cNrec, bRight) = cmCancel;
  if (bResult)
    SetRights;
}

tableEvent table TuneDef;
cmPositionChanged : SetRights;
end;

HandleEvent
cmInit :
{
  m_wShowEmb1 := m_wShowEmb2 := m_wCheckRigths := 0;// по умолчанию ничего не встраивается
  m_sEdit := '';
  m_sUserNrec := '0';
  m_sUserTable := string(coTuneDef);
  ShowTabbedSheet;
  if (NullvipRef (m_objAttribute)) LoadVipInterface (m_objAttribute);
  if NullvipRef (m_objExClassifier) LoadVipInterface (m_objExClassifier);
  BindEmbeddedInterface(embOutAtrributes, m_objAttribute);
  BindEmbeddedInterface(embOutClassifiers, m_objExClassifier);
  SetRights;
}

cmcheckField :
{
  case curfield of
  #m_wShowEmb2, #m_wShowEmb1 : ShowTabbedSheet;
  #m_wCheckRigths, #m_sEdit, #m_wSetUserValues, #m_sUserNrec, #m_sUserTable : SetRights;
  end;
}

cmDone:
{
  FreeVipInterface(m_objAttribute);
  FreeVipInterface(m_objExClassifier);
}

cmValue2 : RunOperation(cmValue2);

cmValue1 : RunOperation(cmValue1);
end;
end.
