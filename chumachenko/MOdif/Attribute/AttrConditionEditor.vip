#include AttrVisibility.vih

interface AttrConditionEditor 'Настройка условий видимости атрибута';

var CurAttrNam:comp;
    TableName:string;
    iAttrVisibility : AttrVisibility;

Create view
as select
  AllMemo.cRec
from
  AllMemo
where
((
      CurAttrNam         == AllMemo.cRec
  and coAttrNam          == AllMemo.wTable
  and 'ConditionVisible' == AllMemo.Name (noindex)
));

parameters CurAttrNam, TableName;

File MemoFile;

screen scHelp;
show(,,,6) Fixed_Y;
<<
  Правила написания условия:
  - В условии можно использовать только поля таблицы, к которой относится данный атрибут;
  - Поля должны заключаться в квадратные скобки;
  - Имена полей должны быть в нижнем регистре;
  - При написании условий на дату или время значение должно задаваться в помощью date() или time().
  Пример: ([vidsopr]=101 or [vidsopr]=211) and [dsopr]>=date(01,10,2009).
>>
end;

Text AllMemo.Mem 'Условия':NoProtect, OnlyOneDoc;
show(,7,,);

TableEvent table AllMemo;
cmSetDefault:
{
  AllMemo.Nrec     := 0;
  AllMemo.cRec     := CurAttrNam;
  AllMemo.Tip      := 0;
  AllMemo.wTable   := coAttrnam;
  AllMemo.Name     := 'ConditionVisible';
}

cmInsertRecord :
{
  insert current AllMemo;
}

cmUpdateRecord :
{
  update current AllMemo;
}

cmDeleteRecord :
{
  delete current AllMemo;
}
end;

HandleEvent
cmDone:{
  UpDateTable;
  if (not IsValidAll(tnAllMemo)) exit;

  ReReadRecord(tnAllMemo);
  if (MemoFile.OpenMemo(AllMemo.Mem)) {
    var sLine, sCondition:wideString = '';

    MemoFile.seek(0);
    while (not MemoFile.EOF) {
      MemoFile.ReadLn(sLine);
      sCondition += ' ' + sLine;
    }
    MemoFile.Close;

    if (Trim(sCondition) = '')
      delete current AllMemo
    else if (not iAttrVisibility.CheckCondition(TableName, sCondition)) {
      message('Проверка условия.'#13 + iAttrVisibility.LastErrorDescription, error);
      abort;
    }
  }
}
end;

end.
