// Выбор названия внешнего атрибута. Фильтр по типу.
//------------------------------------------------------------------------------


#doc
Выбор названия внешнего атрибута из AttrNam. Фильтр по типу.
#end

Interface  PickAttrNamType 'Выбор названия атрибута' DoAccept, EscClose, Cyan;
show at (,,47,9);

Create View
Var
  lCode : comp;
  wTab, aType : word;
as select
  if (AttrNam.AttrType = cgAttrType_Str, 'CFG_T_STRING',
    if (AttrNam.AttrType = cgAttrType_Dbl, 'CFG_T_DOUBLE',
      if (AttrNam.AttrType = cgAttrType_Date, 'CFG_T_DATETIME',
        if (AttrNam.AttrType = cgAttrType_Time, 'CFG_T_DATETIME',
          if (AttrNam.AttrType = cgAttrType_Memo, 'CFG_MEMO',
            if (AttrNam.AttrType = cgAttrType_Comp, 'CFG_BrowseR', 
              if (AttrNam.AttrType = cgAttrType_Bool, 'CFG_BOOLEAN',
                 if (AttrNam.AttrType = cgAttrType_LongInt, 'cfg_t_Longint', 'CFG_T_STRING'))))))))
              (FieldName = strType)
from
  AttrNam
where
((
       wTab == AttrNam.wTable
  and aType == AttrNam.AttrType
))
;

Parameters
    lCode     // ссылка на AttrNam. Возвращаемый.
  , wTab      // код таблицы
  , aType;    // задает тип атрибута для фильтра

Panel pan1;
  Table AttrNam;
Browse brw1;
Fields
  AttrNam.NAME 'Название атрибута' ('Выберите атрибут и нажмите Enter' ,hcGkatalM1Attr, sci1EnEsc): Protect, browseImage(strType);
end; // browse
end; // panel

HandleEvent

cmDefault:
  lCode := AttrNam.NRec;

cmInit:
  {
    if (aType > cgAttrType_Switch)
      {
        Message  ('Неверно задан тип внешнего атрибута для интерфейса выбора! ', Error);
        abort; exit;
      }

    if(lCode <> 0)
      if(GetFirst AttrNam
        where ((lCode == AttrNam.NRec)) <> tsOK) {};
    else
      if(GetFirst AttrNam <> tsOK)   {};
  }

end;  // HandleEvent
End.  // interface
