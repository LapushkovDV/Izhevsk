Interface AttributeV2;
Create view
Var
//------------------------------------------------------------------------------
  AttrRec : comp;
//------------------------------------------------------------------------------

;

Parameters
  AttrRec
;

//******************************************************************************

Window ValueInputWindow;

HandleEvent

cmDone:
{
  if ( inherited :: HandleEvent(cmDone) = heAbort )
    {
      Abort;
      Exit;
    }

  if not isVipLoad
    PutCommand(cmCancel);
}

end;

end;

HandleEvent

cmInit:
{
  if ( inherited :: HandleEvent(cmInit) = heAbort )
    {
      Abort;
      Exit;
    }

  if not isVipLoad
    if ( GetFirst AttrNam where (( AttrRec == AttrNam.nRec )) = tsOk )
      PutCommand(cmEdit);
}

cmOnVipLoad:
{
  if ( inherited :: HandleEvent(cmOnVipLoad) = heAbort )
    {
      Abort;
      Exit;
    }
}

cmOnVipUnload:
{
  if ( inherited :: HandleEvent(cmOnVipLoad) = heAbort )
    {
      Abort;
      Exit;
    }
}

end;

End.

//******************************************************************************
