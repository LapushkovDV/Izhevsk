#include Query.vih
#include ExtAttr.Vih

#include AttrVisibility.vih
interface AttrVisibility;

var TableCode:word;
    CountFields:longint;
    iRow:IResultRow;
    bNeedGroupsRights : boolean ;
    _Val : word;
//    iAttr: iExtAttr;

Create view
as select
  AttrNam.NRec
from
  AttrNam,
  AllMemo
where
((
      TableCode          == AttrNam.wTable
  and AttrNam.NRec       == AllMemo.cRec
  and coAttrNam          == AllMemo.wTable
  and 'ConditionVisible' == AllMemo.Name (noindex)
));

var LastErrorStr:wideString = '';
property LastErrorDescription:wideString absolute LastErrorStr read;

procedure AddErrorStr(msg: wideString);
{
  if (LastErrorStr <> '') LastErrorStr += ''#13#10;
  LastErrorStr += msg;
}

File MemoFile;

function DateToFormulaStr(ds: string): string;
{
  result := 'Date(';
  result += SubStr(ds,1,2) + ',';
  result += SubStr(ds,4,2) + ',';
  result += SubStr(ds,7,4) + ')';
}

/*
sql query selectQuery =
  select *
  from
    %macroTable
  where
    %macroWhere
;

sql query selectTop1Query =
  select top 1 *
  from
    %macroTable
;
*/

function GetTableFields(TableName:string; CurRec:comp ; var ColValue: word  ):boolean;
  var sLine : string;
{
  result:=false;
  iRow := NullRef;
  CountFields := -1;
  var iQ : IQuery;
  var _stmt_str : tPtr;

!  if (CurRec = 0)
!    iQ:=queryManager.createQuery(selectTop1Query)
!  else {
!    iQ:=queryManager.createQuery(selectQuery);
!    iQ.setMacro('macroWhere', 'NRec = #comp(' + string(CurRec) + ')');
!  }

!  iQ.setMacro('macroTable', TableName);

  if getfirst allmemo<>tsok
    exit;

//  stmt_ := sqlAllocStmt;

  if (MemoFile.OpenMemo(AllMemo.Mem)) {
    MemoFile.seek(0);
    while (not MemoFile.EOF) {
      MemoFile.ReadLn(sLine);
        if instr(':CurRec',sLine)>0
        {
         sLine:=Replace(sLine,':CurRec','#comp('+String(CurRec)+')');
        }
     sqlAddStr(_stmt_str, sLine);
    }
    MemoFile.Close;
  }
  else {
    AddErrorStr('Ошибка открытия мемо-поля для внешнего атрибута: ' + AttrNam.Name);
//    continue;
  }

  iQ:=queryManager.createQuery(_stmt_str)

  if (iQ.execute.errorCode != tsOk) {
    AddErrorStr('Ошибка выполнения запроса на условие видимости: ' + string(iQ.errorCode));
    exit;
  }

  iRow := iQ.getResultSet.Row;
  CountFields := iRow.count; // теперь д.б. только 1 столбец
  if CountFields =0
  {
    CountFields := -1;
    AddErrorStr('Ошибка подсчета кол-ва столбцов в ' + TableName);
  }
  else
   ColValue:=iQ.getResultSet.Row.valAt(1);
  result:=true;
}

function CalcCondition(sCondition:wideString):boolean;
{
  result:=false;

  var FldName, Val:string;
  var i: integer;//longint;
  for(i:=1; i <= CountFields; i++)
  {
    FldName:='[' + LoCase(iRow.colAt(i).name) + ']';

    if (pos(FldName, sCondition) = 0)
     continue;

    Val:=Case(iRow.colAt(i).dtype;
              ftString, ftComp : String(iRow.valAt(i)),
              ftDate : DateToStr(iRow.valAt(i),'DD/MM/YYYY'),
              ftTime : TimeTostr(iRow.valAt(i),'HH.MM/SS'),
              ftWord, ftLongint  : String(iRow.valAt(i));
              String(iRow.valAt(i)));

    sCondition:=Replace(sCondition, FldName,
                        if(iRow.colAt(i).dtype = ftDate, DateToFormulaStr(Val), Val));
  }

  var sError, rez:string = '';
  rez := LotExpressionFunc(sCondition, sError);

  if (Length(sError) = 0)
    result:=rez = 'FALSE'
  else
    AddErrorStr('Ошибка вычисления выражения: "' + sCondition + '"'#13#10 + sError);
}

//----------------------
// Не будем пересчитывать если таблица совпадет
var lHiddenAttributes_TableCode : longint = -1;
function GetHiddenAttributes(TableCode:word; TableName:string; CurRec:comp):TPtr;
{
  result:=InitMarker('', SizeOf(comp), 0, 1);

  LastErrorStr:='';
  var bUseDSQL  : boolean = UseDSQL;
//  bNeedGroupsRights := iAttr.NeedGroupsRights(1) ;

!  FpLog('AttrVisibility-> GetHiddenAttributes TableCode = ' + string(TableCode)
!    + ', bNeedGroupsRights = ' +string(bNeedGroupsRights) +', CurRec =' + string(CurRec, 0 , 0)  );

  if (not bUseDSQL) //and (not bNeedGroupsRights)
     exit;

  StartNewVisual(vtNumericVisual, vfTimer + vfBreak + vfConfirm, 'Вычисление условий видимости внешних атрибутов...', 1);

  var sLine, sCondition:wideString;
  var _pUserId : comp = UserID;

  CountFields := 0;
  private::TableCode:=TableCode;

//  var _wGetGroupsRights : word;

!  if bNeedGroupsRights
!  {
!    if lHiddenAttributes_TableCode <> TableCode
!      iAttr.ClearGroupsRighCache;
!    lHiddenAttributes_TableCode := TableCode;
!  }

  _loop AttrNam
  {
    if (not NextVisual) break;
    //тормозит. расскоментарить при проблемах
    //FpLog('AttrVisibility-> GetHiddenAttributes Name = ' + AttrNam.Name);

/*    if bNeedGroupsRights
    {
      _wGetGroupsRights := iAttr.GetGroupsRights(AttrNam.wTable, AttrNam.Nrec, _PUserId );
      //тормозит. расскоментарить при проблемах
      //FpLog('_wGetGroupsRights = ' +string(_wGetGroupsRights));
      if (_wGetGroupsRights and 1) = 0
      {
        InsertMarker(result, AttrNam.NRec);
        Continue;
      }
    }
*/
    if bUseDSQL
    {
      _Val:=0;
      if isValid(#AllMemo)
      {
        if (CountFields = 0)
          if (not GetTableFields(TableName, CurRec, _Val))
            break;

/*        sCondition:='';
        if (MemoFile.OpenMemo(AllMemo.Mem)) {
          MemoFile.seek(0);
          while (not MemoFile.EOF) {
            MemoFile.ReadLn(sLine);
            sCondition += ' ' + sLine;
          }
          MemoFile.Close;
        }
        else {
          AddErrorStr('Ошибка открытия мемо-поля для внешнего атрибута: ' + AttrNam.Name);
          continue;
        }

*/
!        if (Trim(sCondition) = '') continue;

!        if (CalcCondition(sCondition))
         if _Val=0
          InsertMarker(result, AttrNam.NRec);
      }
      else // Нет скрипта на огрничение видимости по нему. Он нам нужен
        InsertMarker(result, AttrNam.NRec);
    }
  }

  StopVisual;
}

function CheckCondition(TableName:string; sCondition:wideString):boolean;
{
  result:=false;
  LastErrorStr:='';

  StartNewVisual(vtRotateVisual, vfTimer, 'Вычисление условия...', 1);

  CountFields:=0;
  if (GetTableFields(TableName, 0, _Val))
    CalcCondition(sCondition);

  result:=LastErrorStr = '';
  StopVisual;
}

end.
