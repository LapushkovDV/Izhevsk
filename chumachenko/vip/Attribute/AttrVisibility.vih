// Расчет условий видимости внешних атрибутов
//--------------------------------------------------------------------------------------------------

#ifndef __AttrVisibility_VIH__
#define __AttrVisibility_VIH__

#component "C_ExtClass"

#doc
Расчет условий видимости внешних атрибутов
#end
ObjInterface ObjAttrVisibility;
  #doc
  Функция вычисляет условия видимости атрибутов и возвращает массив скрытых.
  #end
  function GetHiddenAttributes(TableCode:word; TableName:string; CurRec:comp):TPtr;
  #doc
  Функция вычисляет условие и возвращает true, если не было ошибок.
  #end
  function CheckCondition(TableName:string; sCondition:wideString):boolean;
  #doc
  Возвращает строку с описанием последней ошибки.
  #end
  property LastErrorDescription:wideString read;
end;

VipInterface AttrVisibility Implements ObjAttrVisibility licensed(free);

#endif
