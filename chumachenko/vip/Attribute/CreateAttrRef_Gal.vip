#include  KatOrg.vih
#include  GetDoverAttr.vih
#include  CreateAttrRef_Gal.vih
#include  AdrFunc.vih       // Функции работы с адресами
#include  TerrCatalogPick.vih
#include TemplateGroupPKP.vih
#include Pickcat.vih

//------------------------------------------------------------------------------
Handler with replace Gal_CreateAttrRefTable on extensionPoint  epCreateAttrRefTable (AttrRef : ObjGetAttrTable) [11]
Action
{
   Result := true;
   var ifc : CreateAttrRef_Gal;
   ifc.AddAttrRefTable (AttrRef);
}


//------------------------------------------------------------------------------
Handler with replace Gal_PickTableRef on extensionPoint  epPickTableRef (_coTable: word; _cAttrVal: comp) [11]
Action
{
   var ifc: CreateAttrRef_Gal;
   Result := not ifc.PickValueRef (_coTable, _cAttrVal);
}

// ObjCreateAttrRefPlugin - вызвается интерфейсом GetAttrTable для создания ссылок на таблицы не являющиеся аналитикой.
// CreateAttrRef_Gal  реализация объектного интерфейса ObjCreateAttrRefPlugin, чтобы дополнить список ссылок.

#doc
Создание атрибутов типа ссылка (не аналитика)
#end

Interface CreateAttrRef_Gal;

#include TcKlassifConst.vpp

var
  Flag      : boolean;
  wVidSopr
 ,wMetodtc
 ,wMorale   : word;

 oTemplateGroupPKP : TemplateGroupPKP;

#include AdrFunc.var // Функции работы с адресами

Create view
From
  AttrVal
 ,AttrNam
 ,Dover
 ,KatEd
 ,KatPayment
 ,KatOrg
 ,KatState
 ,KatCity
 ,KlSkidka
 ,TarStav
 ,KlSisOpl
 ,KatSopr
 ,KatDoc
 ,Morale
 ,KlVal
 ,FormPl
 ,DovFio
 ,PlanLimitPetrol
 ,KatMC
 ,KatUsl
 ,GrDescr
 ,sTerr
 ,GroupPKP
 ,OKDP

where
((
     TarStav.SisOpl   == KlSisOpl.SisOpl
and  AttrVal.cattrnam == Attrnam.nrec
))
;

//------------------------------------------------------------------------------
Create view vCatalogs
var
  pCatalogs : comp;
as select Catalogs.Nrec
From
  Catalogs
where ((
   pCatalogs  == Catalogs.Nrec
)); //Create view vCatalogs

//  AttrRef ссылка на интерфейс GetAttrTable
Public Procedure AddAttrRefTable (AttrRef : ObjGetAttrTable);
{
/*

Не надо добавлять сюда, надо делать отдельный интерфейс

*/
  AttrRef.AddTable (coKatEd);
  AttrRef.AddTable (coDover);
  AttrRef.AddTable (coKatPayment);
  AttrRef.AddTable (coKatOrg);
  AttrRef.AddTable (coKatState);
  AttrRef.AddTable (coKatCity);
  AttrRef.AddTable (coKlSkidka);
  AttrRef.AddTable (coTarStav);
  AttrRef.AddTable (coKatSopr);
  AttrRef.AddTable (coMorale);
  AttrRef.AddTable (coKlVal);
  AttrRef.AddTable (coFormPl);
  AttrRef.AddTable (coCatalogs);//ссылка на Catalogs
  AttrRef.AddTable (coDovFio);
  AttrRef.AddTable (coPlanLimitPetrol);
  AttrRef.AddTable (coGrDescr);
  AttrRef.AddTable (cosTerr);
  AttrRef.AddTable (coGroupPKP);
  AttrRef.AddTable (coOKDP);

  //Загружаем список реализаций базового интерфейса
  if(LoadImplementationList('C_ExtClass::IAttrRefPlugin', 'AttrRef') )
  {
    var i: integer;
    var ifc: IAttrRefPlugin;
    //создаем список объектов алгоритмов, и привязываем метода на event-ы
    for( i := 0; i < GetImplementationCount; i ++ )
    {
      GetVipRef(ifc, GetImplementationName(i));
      AttrRef.AddTable (ifc.wCodeTable);

      FreeVipInterface(ifc);
    }
    UnLoadImplementationList;
  }
}
Window WinForm 'Задайте параметры формирования' EscClose, DoAccept, Cyan;
Show At (13, 5, 67, 20);

Panel PanMorale;
Table Morale;

Screen FormParMorale (, , scGalDial);
Fields
  wMetodtc ('Тип транспорта ') : [LIST 0 'автотранспорт', 10 'ж.д', 20 'прочие'],protect;
  wMorale ('Классификация ТС') : noprotect;
Buttons
  cmValue1, , , ' Ввод', hcoKHelp, sci1Esc;
  cmCancel, , , 'Выход', hcCancelHelp, sci1Esc;

<<

       .@@@@@@@@@@@@@@@@@@@@@@@

  'Классификация ТС  ...'

      (.) По первому целевому признаку   `
      (.) по второму целевому признаку   `
      (.) по видам                       `
      (.) по типу основного двигателя    `
      (.) по наличию прицепа             `
      (.) по парку учета                 `

    <. Продолжить .>          <. Отмена .>
>>
end;
end;
HandleEvent // Window WinForm
cmInit:
  {
    if ( not ReadMyDsk(wMetodtc, 'CreateAttrRef_Gal_wMetodtc', False) )
       wMetodtc := Word(0);
    if ( not ReadMyDsk(wMorale, 'CreateAttrRef_Gal_wMorale', False) )
       wMorale := Word(0);
  }
cmValue1:
  {
    Flag := True;
    CloseWindow(WinForm);
  }
end; // HandleEvent Window WinForm

end; // Window WinForm


//  Реализация интерфейса вызова для таблицы
Function PickValueRefEx_ (_coTable: word; var _vString: string; var _vComp: comp; var bChangeValue: boolean): boolean;
{
  result := false;

  bChangeValue := false;

  case _coTable of
  coKatOrg:
  {
    result := true;
    if (RunInterface('GetKatOr', _vComp, comp(0), FALSE, comp(0), comp(0)) <> cmCancel)
    {
      if (GetFirst KatOrg where ((_vComp == KatOrg.NRec))=tsOk)
        _vString := KatOrg.Name;
      bChangeValue := true;
    }
  }
  coKatState:
  {
    result := true;
    if (RunInterface('GetState', _vComp) <> cmCancel)
    {
      if (GetFirst KatState where ((_vComp == KatState.NRec))=tsOk)
        _vString := KatState.Name;
      bChangeValue := true;
    }
  }
  coKatCity:
  {
    result := true;
    var pState: comp;
    if (RunInterface('GetState', pState) <> cmCancel)
      if (RunInterface('GetCity', pState, _vComp) <> cmCancel)
      {
        if (GetFirst KatCity where ((_vComp == KatCity.NRec))=tsOk)
          _vString := KatCity.Name;
        bChangeValue := true;
      }
  }
  coKatEd:
  {
    result := true;
    if (RunInterface('GetEdIzm', _vComp) <> cmCancel)
    {
      if (GetFirst KatEd where ((_vComp == KatEd.NRec))=tsOk)
        _vString := KatEd.Name;
      bChangeValue := true;
    }
  }
  coDover:
  {
    result := true;
    if(RunInterface('GetDoverAttr', 4, _vComp) <> cmCancel)
    {
      if (GetFirst Dover Where (( _vComp == Dover.NRec )) = tsOk)
        _vString := 'Доверенность ' + ' №  ' + Dover.NoDoc + ' от ' + DateToStr(Dover.dForm, 'DD/MM/YY г.');
      bChangeValue := true;
    }
  }
  coKatPayment:
  {
    result := true;
    if (RunInterface('GetPayment', _vComp) <> cmCancel)
    {
      if (GetFirst KatPayment where ((_vComp == KatPayment.NRec))=tsOk)
        _vString := KatPayment.Name;
      bChangeValue := true;
    }
  }
  cosTerr:
  {
    result := true;

    if ( RunInterface('TerrCatalogPick', -10, _vComp, 1, 0) <> cmCancel)
    {
      if (GetFirst sTerr where ((_vComp == sTerr.NRec))=tsOk)
        _vString := iAdrFunc.GetFullTerrName(sTerr.NRec);
      bChangeValue := true;
    }
  }
  coKlSkidka:
  {
    result := true;
    if(RunInterface('GetSkid', _vComp, 0) <> cmCancel)
    {
      if (GetFirst KlSkidka Where (( _vComp == KlSkidka.NRec )) = tsOk)
        _vString := KlSkidka.Name;
      bChangeValue := true;
    }
  }
  coTarStav:
  {
    var dDate: date;
    var cResTarStav: comp;
    result := true;
    if ( RunInterface('Select_TarStav', Cur_date, dDate, cResTarStav) <> cmCancel )
    {
      if ( getfirst TarStav where (( cResTarStav == TarStav.NRec )) = tsOK )
      {
        _vComp   := TarStav.Nrec;
        _vString := KlSisOpl.NaSisOpl + ' / ' + string(TarStav.CodTar) + ' / ' + TarStav.NaiTar + ' / '
                         + string(TarStav.RAZR) + ' / ' + DateToStr(TarStav.DatIzm, 'DD.MM.YYYY');
      }
      bChangeValue := true;
    }
  } // coTarStav
  coKatSopr:
  {
    var cRec: comp;
    var sVid: string;
    var bRun: boolean;

    bRun := false;
    cRec := _vComp;

    if ( Getfirst KatSopr where (( cRec == KatSopr.nRec )) = tsOK )
    {
      wVidSopr := KatSopr.VidSopr;
      bRun := true;
    }
    else
    {
      wVidSopr := 0;
      if ( RunDialog('KatSoprVidSoprSelect', wVidSopr) <> cmCancel )
      {
        case wVidSopr of
         0: wVidSopr := 101; // Накладная на прием МЦ
         1: wVidSopr := 111; // Акт на прием услуги
         2: wVidSopr := 201; // Накладная на отпуск МЦ
         3: wVidSopr := 211; // Акт на оказание услуги
         4: wVidSopr := 110; // Акт выполненных работ в строительстве
         5: wVidSopr := 204; // Акт на списание МЦ со склада
         6: wVidSopr := 210; // Акт передачи оборудования в монтаж
         7: wVidSopr := 229; // Акт передачи материалов на строительство
         8: wVidSopr := 600; // Накладная на внутреннее перемещение
         9: wVidSopr := 610; // Реестр смонтированного оборудования
        10: wVidSopr := 629; // Отчет по форме М-29
        11: wVidSopr := 602; // Накладная на передачу МЦ в спецоснастку
        12: wVidSopr := 505; // Межцеховая накладная
        end;

        bRun := true;
      }
    }

    if ( bRun )
    {
      result := true;
      if ( RunInterface('GetKatSopr', cRec, wVidSopr) = cmDefault )
      {
        if ( Getfirst KatSopr where (( cRec == KatSopr.nRec )) = tsOK )
        {
          _vComp := KatSopr.nRec;

          sVid := '';
          if ( GetFirst KatDoc where (( wVidSopr == KatDoc.TiDkGal )) = tsOK )
            sVid := KatDoc.Name + ' ';

          _vString := sVid + '№' + KatSopr.NSopr + ' от ' + DateToStr(KatSopr.dSopr, 'DD.MM.YYYY');
        }

        bChangeValue := true;
      }
    }
  } // coKatSopr
  coMorale:
  {
    var cRec: comp;
    var sVid: string;
    var bRun: boolean;
    var TempStr  : String[10];

    bRun := true;
    cRec := _vComp;
    if ( Getfirst Morale where (( cRec == Morale.nRec )) = tsOK )
    {
      wMetodTc := Morale.WhatIs div 10;
      if Morale.WhatIs < 10
        wMorale := Morale.WhatIs;
      else
        wMorale := (Morale.WhatIs mod 100);
      wMorale := wMorale - 3
    }
    else
    {
      wMorale := 0;
      if upcase(trim(AttrNam.name)) = upcase(trim(csKlassif1_Full))
        wMorale := 0
      else
      if upcase(trim(AttrNam.name)) = upcase(trim(csKlassif2_Full))
        wMorale := 1
      else
      if upcase(trim(AttrNam.name)) = upcase(trim(csKlassifVid_Full))
        wMorale := 2
      else
      if upcase(trim(AttrNam.name)) = upcase(trim(csKlassifEng_Full))
        wMorale := 3
      else
      if upcase(trim(AttrNam.name)) = upcase(trim(csKlassifEng_Full))
        wMorale := 4
      else
      if upcase(trim(AttrNam.name)) = upcase(trim(csKlassifPark_Full))
        wMorale := 5
      else
      if not( RunWindowModal(WinForm) <> cmCancel  or  Flag)
        bRun := FALSE;
    }
    if ( bRun )
    {
      result := true;
      if RunInterface(GetMorale, Word(wMetodTc*10 + wmorale + 3), cRec, TempStr, Word(0),word(13)) = cmDefault
      {
        if ( Getfirst Morale where (( cRec == Morale.nRec )) = tsOK )
        {
          _vComp := Morale.nRec;
          if ( Morale.Whatis < 100 )
            sVid  :=  csVidAvto
          else
          if ( Morale.Whatis < 200 )
            sVid  := csVidRail
          else
          if ( Morale.Whatis < 300 )
            sVid  :=  csVidVar;
          sVid  := sVid + ', ';
          case wMorale of
          0 : sVid  := sVid + csKlassif1
          1 : sVid  := sVid + csKlassif2
          2 : sVid  := sVid + csKlassifVid
          3 : sVid  := sVid + csKlassifEng
          4 : sVid  := sVid + csKlassifTrl
          5 : sVid  := sVid + csKlassifPark
          end; // case
          _vString := sVid +', ' + Morale.Name
        }
        bChangeValue := true;
        SaveMyDsk(wMetodTc, 'CreateAttrRef_Gal_wMetodtc');
        SaveMyDsk(wMorale,'CreateAttrRef_Galt_wMorale');
      }
    }
  } // coMorale
  coKlVal:
  {
    Result := True;
    if (RunInterface(CursVal, _vComp, Double(0), ZeroDate, Word(1)) <> cmCancel)
    {
      if (GetFirst KlVal where ((_vComp == KlVal.NRec))=tsOk)
        _vString := KlVal.SimVolV;

      bChangeValue := True;
    }
  }  // coKlVal

  coFormPl:
  {
    Result := True;
    if (RunInterface('PickAlgoritm', _vComp, 1, 1, 0, 0) <> cmCancel)
    {
      if (GetFirst FormPl where ((_vComp == FormPl.NRec))=tsOk)
        _vString := FormPl.Name;

      bChangeValue := True;
    }
  }  // coKlVal
  coDovFio:
  {
    Result := True;
    if (RunInterface('GetDovFio', _vComp) <> cmCancel)
    {
      if (GetFirst DovFio where ((_vComp == DovFio.NRec))=tsOk)
        _vString := DovFio.Name;
      bChangeValue := True;
    }
  }
  coPlanLimitPetrol:
  {
    Result := True;
    if (RunInterface('PlanPetrol', cgiPick, _vComp, FALSE, 0, 0, 0, 0, 0) <> cmCancel)
    {
      if (GetFirst PlanLimitPetrol where ((_vComp == PlanLimitPetrol.NRec))=tsOk)
      {
        _vString := PlanLimitPetrol.NoDoc + '-' + String(PlanLimitPetrol.wYear) + '-';

        if (PlanLimitPetrol.wPrMC = 1)
        {
          if (GetFirst KatMC where (( PlanLimitPetrol.cMCUsl == KatMC.nRec )) = tsOk)
            _vString += KatMC.Name;
        }
        else
          if (GetFirst KatUsl where (( PlanLimitPetrol.cMCUsl == KatUsl.nRec )) = tsOk)
            _vString += KatUsl.Name;
      }

      bChangeValue := True;
    }
  }  // coPlanLimitPetrol
  coGrDescr :
  {
    var strVal : string='';
    result := true;
    if (RunInterface(GetGrDescr, strVal, false, false, _vComp) <> cmCancel)
    {
      if (GetFirst GrDescr where ((_vComp == GrDescr.NRec))=tsOk)
        _vString := GrDescr.DesGr + ' ' +  GrDescr.Name;
      bChangeValue := true;
    }
  }

  coGroupPKP:
  {
    Result := True;

    var cTmp : comp = oTemplateGroupPKP.GetGroupPKP(_vComp, 0, 0, 0);

    if (cTmp <> 0)
      if (GetFirst GroupPKP where (( cTmp == GroupPKP.nRec )) = tsOK)
      {
        _vString     := GroupPKP.Name;
        bChangeValue := True;
      }
  }

  coOKDP:
  {
    var strVal: String[20] = '';

    Result := True;

    if (RunInterface('GetOKDP', strVal, '') <> cmCancel)
    {
      if getfirst OKDP where ((strVal == OKDP.Kod)) = tsOk
      {
        _vComp := OKDP.NRec;
        _vString := strVal;
      }

      bChangeValue := True;
    }

  }
  coCatalogs:
  {
    var  _syscode : integer=0; //longint
    result := true;
    vCatalogs.pCatalogs := AttrVal.vComp;
    if pos(',',AttrNam.Name)>0
    {
      _syscode:=integer(trim(substr(AttrNam.Name, pos(',',AttrNam.Name)+1,100)))
    }

    if RunInterface (PickCatalog2, _syscode, vCatalogs.pCatalogs, comp(0), comp(0)) = cmDefault
    {
      _vComp := vCatalogs.pCatalogs;
      if (vCatalogs.getfirst Catalogs = tsok)
      {
        if (Trim(vCatalogs.Catalogs.Code) = '')
          _vString := vCatalogs.Catalogs.Name
        else
          _vString := vCatalogs.Catalogs.Code + ' ' + vCatalogs.Catalogs.Name;
      }

      bChangeValue:=true;
    }
  }
  else
  {
    if(LoadImplementationList('C_ExtClass::IAttrRefPlugin', 'AttrRef' + string(_coTable) + '_') )
    {
      if (GetImplementationCount > 0)
      {
        var ifc: IAttrRefPlugin;
        if (GetVipRef(ifc, GetImplementationName(0)) )
        {
          Result := ifc.PickValue(_vString, _vComp, bChangeValue);
          FreeVipInterface(ifc);
        }
      }
      UnLoadImplementationList;
    }
  }
  end; // case
}

//  Реализация интерфейса вызова для таблицы
Function PickValueRefEx (_coTable: word; var _vString: string; var _vComp: comp): boolean;
var bChangeValue: boolean;
{
  result := PickValueRefEx_ (_coTable, _vString, _vComp, bChangeValue);
}

//  Реализация интерфейса вызова для таблицы
Function PickValueRef (_coTable: word; _cAttrVal: comp): boolean;
var bChangeValue: boolean;
{
  result := false;

  if (getFirst AttrVal where ((_cAttrVal == AttrVal.nRec)) <> tsOk)
    Exit;

  result := PickValueRefEx_ (_coTable, AttrVal.vString, AttrVal.vComp, bChangeValue);

  if ( bChangeValue )
  {
    var err : word;

    err := Update current AttrVal;

    if (err <> 0)
    {
      Message ('Ошибка № ' + string(err) + ' обновления записи в таблице AttrVal.');
      exit;
    }
  }
}

end. // интерфейс

