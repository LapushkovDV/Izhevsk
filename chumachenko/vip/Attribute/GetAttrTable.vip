// Система T2 ERP
// Выбор таблицы ссылки для атрибута с типом COMP
//------------------------------------------------------------------------------


#include  GetAttrTable.vih

#doc
Выбор таблицы ссылки для атрибута с типом COMP
#end

Interface GetAttrTable 'Выберите тип ссылки'  DoAccept, EscClose, Gray;
  Show at (,,45,6);

  Table Struct mAttrTab (
     nRec    : comp,
     code    : word,
     Name    : string[21],
     TITLE   : string[41]
  )
  With index
  (
     mAttrTab00 = nRec (Unique,Surrogate),
     mAttrTab01 = Code,
     mAttrTab02 = Name,
     mAttrTab03 = TITLE
  );

Create View
var
  _SysNum ,  _Code, _coTable : word;
  wTypeRef : word;
 _attrType : word;

From
    X$Files(ReadOnly)
  , mAttrTab
  order by mAttrTab.nRec

  order BynRec  by mAttrTab.nRec
  order ByName  by mAttrTab.Name
  order ByTitle by mAttrTab.Title
  order ByCode  by mAttrTab.Code;
;

Parameters _SysNum,      // тип КАУ, если = 100 (cgKatKau_System), то выбор идет из прочих таблиц
           _code,        // код КАУ
           _coTable;     // код таблицы из словаря

VAR  fCurrentMy : longint;

// ----------------------------------------------------------------------------
Window WinOtherTable 'Таблицы' DoAccept,EscClose,Cyan;
 show at (,,80,17);
 Browse  brKatH_System 'Таблицы' ('Прочие таблицы', hcGkatalM1ExtClass, sci1EnEsc);
  Table mAttrTab;
 Fields
  mAttrTab.Name  'Аббревиатура' : [14], Protect;
  mAttrTab.TITLE 'Наименование' : [40], Protect;
  mAttrTab.code  'Код'          : [ 5], Protect;
 end;

HandleEvent //Окна
cmDefault:
 {
   if _SysNum = cgKatKau_System
   {
    _Code    := mAttrTab.code;
    _CoTable := mAttrTab.code;
   }
   CloseInterface(cmDefault);
 }

cmCancel:
  CloseInterface(cmCancel);

cmColumnClicked:
  ProcessCommand(cmColumnClicked);
end;
end;


// ----------------------------------------------------------------------------
screen TipAttr (,hcGkatalM1Attr,sci1EnEsc);
    Fields
      _attrType ('Тип ссылки внешнего атрибута') , NoProtect;
    Buttons
      cmOk,Default;      cmCancel;
<<

          (.)  аналитика`
          (.)  прочие таблицы`

    <.~П~родолжить.>   <.Отмена.>
>>
end;



Public Procedure AddTable (_coTable : word);
{
   if (_coTable = 0)
     exit;

   if GetFirst x$files where ((_coTable == x$files.xf$code)) = tsok
   {
     clearbuffer(#mAttrTab);
     mAttrTab.code  := x$files.xf$code;
     mAttrTab.name  := x$files.xf$name;
     mAttrTab.title := x$files.xf$title;
     insert current mAttrTab;
   }
}


// --------------------------------------------------------------------------------------
HandleEvent      // INTERFACE handler
  cmInit:
    _attrType := if (_SysNum <> cgKatKau_System, 0, 1);

  cmOk:
  {
    _SysNum := if(_attrType = 0, cgKatKau_Table, cgKatKau_System);
    ProcessCommand(if(_SysNum <> cgKatKau_System, cmValue2, cmValue3));
  }

  cmCancel:
    CloseInterface(cmCancel);
  // --------------------------------------------------------------------------------------
  //  Выбор таблицы из аналитикм
  cmValue2:
  {
    if RunInterface(GetKauTable,cgiPick,(4 or 8 or 16),_Code,0) <> cmCancel
    {
      _SysNum  := GetKauSysNum  (_Code);
      _CoTable := GetKauCoTable (_Code);
      CloseInterface(cmDefault);
    }
    else
      CloseInterface(cmCancel);
  }
  // --------------------------------------------------------------------------------------
  //  Выбор таблицы из прочих таблиц
  cmValue3:
  {
    // точка расширения - дополнить список таблиц - не аналитика
    if (RecordsInTable(#mAttrTab)=0)
      epCreateAttrRefTable (ObjGetAttrTable(self));

    if GetFirst mAttrTab where ((_Code == mAttrTab.code)) = tsOk {};
    else  if GetFirst mAttrTab = tsOk {};
    RunWindowModal(WinOtherTable);
  }


  cmColumnClicked :
   {
      case GetColumnSorting(fCurrentMy, Target) of
      0: {
            if Target = #mAttrTab.Name  SetOrder(tiByName)
            else if Target = #mAttrTab.Title SetOrder(tiByTitle)
            else SetOrder(tiByCode);
            SetColumnSorting(fCurrentMy, Target, 1);
            SetTableBackOrderIn (tnmAttrTab, False);
          }
       1: {
            SetColumnSorting(fCurrentMy, Target, -1);
            SetTableBackOrderIn (tnmAttrTab, true);
          }
       -1: {
            SetColumnSorting(fCurrentMy, Target, 0);
            SetOrder(tiByNrec);
            SetTableBackOrderIn (tnmAttrTab, false);
          }
        end;
      RescanPanel (#mAttrTab);
   }
end;
End.
