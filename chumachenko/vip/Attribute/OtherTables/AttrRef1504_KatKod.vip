// При создании атрибута типа ссылка (не аналитика) требуется обязательная консультация с отделом Прикладные сервисы
//------------------------------------------------------------------------------

#include  AttrRef1504_KatKod.vih

#doc
Создание атрибутов типа ссылка (не аналитика)
#end

Interface AttrRef1504_KatKod;

var
  wKatKod : word;

Create view
From
  KatKod
;
/*------------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------------------*/
property IAttrRefPlugin.wCodeTable: word read coKatKod;


//  Реализация интерфейса вызова для таблицы
Function PickValue (var p_sVal: string; var p_cVal: comp; var p_bChangeValue: boolean): boolean;
{
  p_bChangeValue := false;

  Result := true;

  if ( Getfirst KatKod where (( p_cVal == KatKod.nRec )) = tsOK )
    wKatKod := KatKod.wType;
  else
  {
    wKatKod := 0;
    if ( RunDialog('KatKodSelect', wKatKod) = cmCancel )
      Exit;

    case wKatKod of
      0: wKatKod := cgKatKod_VidIspDoc; // Вид исполнительного документа  `
      1: wKatKod := cgKatKod_TipSlDoc;  // Тип ссылочного документа       `
      2: wKatKod := cgKatKod_DateUpNal; // Период уплаты налогов          `
      3: wKatKod := cgKatKod_KodNaznPl; // Код назначения платежа         `
      4: wKatKod := cgKatKod_NaznPl;    // Код операции платежа
    end;
  }

  var l_cRec: comp = p_cVal;

  if (RunInterface('F_KatKod::KatKod', cgiPick, wKatKod, l_cRec , 0, 0, 0) = cmCancel)
    Exit;

  if ( Getfirst KatKod where (( l_cRec == KatKod.nRec )) = tsOK )
  {
    p_cVal := KatKod.nRec;
    p_sVal := KatKod.Kod;
  }

  p_bChangeValue := true;
}

end. // интерфейс
//------------------------------------------------------------------------------

KatKodSelect DIALOG

Fields
  wKatKod ('Вид документа',, scGalDial) : word;

Buttons
  cmOk,Default,, 'Продолжить',, scGalDial;
  cmCancel,,,    'Отмена',, scGalDial;

<< 'Выбор вида документа...'
      (.) Вид исполнительного документа  `
      (.) Тип ссылочного документа       `
      (.) Период уплаты налогов          `
      (.) Код назначения платежа         `
      (.) Код операции платежа           `

    <. Продолжить .>             <. Отмена .>
>>
