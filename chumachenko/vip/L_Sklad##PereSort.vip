#Define _L_Sklad_PereSort_

#include GP_DATFS_Base.vih
#include GP_DocFieldsStateService.vih

#component 'L_Sklad'
Alter Interface PereSort;

  var oDATFS: GP_ObjDocAbleTuneFieldsState;
  var iDatFS_base : GP_DATFS_Base;
  var namewin:string;

  Create view
   as select
     if(isvalid(tnKauVid),KauVid.name,'Не определен') (fieldname=fvidOper)  
   from Spkau KauVid
     where ((
            katsopr.cizd == KauVid.nrec
          ))
  ;

procedure timelog(_str : string); {
#ifdef _DEBUG_DocFieldsStateService_
  iDatFS_base.enablelog;
  iDatFS_base.MyLog(_str);
#endif
}

#include onCfgObjectsRequired.vpp
#include funWin.vpp

  Window EditSopr;
    Panel p2;
      Table KatSopr;
      HandleEvent
       cmPositionChanged:
       {
         Inherited::HandleEvent(cmPositionChanged);
         if (oDATFS <> NullRef)
           oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
       }
      end;
    end;
    HandleEvent
     cmInit:
     {
      Inherited::HandleEvent(CmInit);
      if (oDATFS<>NullRef) {
       if katsopr.cIzd = 0h {
         var _cIzd : comp =  iDatFS_base.runwindowgetsubtip(630);
         set katsopr.cIzd := _cIzd;
         updatetable;
         iDatFS_base.SetDefault(KatSopr.cIzd, katsopr.nrec);
       }
       oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
      }
      SetWindowTitle(EDITSOPR,SetNeWinTitle(namewin));
     }
   cmMakeOrder : {
      if (oDATFS<>NullRef) {
        var _boOverload : boolean = oDATFS.isOverLoadButton(KatSopr.cIzd,cfsGetCurrentContainerSelf,cmMakeOrder);
         if _boOverload {
          var _TypeCpNrec : word = 2000 + katsopr.vidsopr;

          oDATFS.PushButton(KatSopr.cIzd,cfsGetCurrentContainerSelf,cmMakeOrder, _TypeCpNrec, katsopr.nrec, oDATFS);

          ReReadRecord(tnKatSopr);
          ReReadRecord(tnSpSopr);
          //message('_boOverload!');
          abort; exit;
        }
      }
      inherited::handleevent(cmMakeOrder)
    }
    end;
  end;

  HandleEvent
    cmInit:
    {
      oDATFS := GP_DocFieldsStateService::GetDocByName('PereSort');
      oDATFS.CalcAndApplyFieldsState(0, cfsGetCurrentContainerSelf);
      BindEvent(onCfgObjectsRequired, oDATFS.Event_onCfgObjectsRequired);

      case Inherited::HandleEvent(cmInit) of
        heAbort :  Abort;
        heStop  :  Exit;
       end;
      cfsGetProp('EDITSOPR','Title',namewin); 
    }
  end;
end.