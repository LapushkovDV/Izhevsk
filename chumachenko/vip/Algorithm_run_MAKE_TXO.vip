#include auto_MAKE_TXO.vih
#include Algor.vih
#include iz_const.vpp
#include StatLog.vih

#component "M_MnPlan"
//***********************************
VipInterface Algorithm_run_MAKE_TXO Implements oAlgoritm_Sys #Licensed_Free;
//***********************************
#doc
Запуск расчета плана производства для АВТОВАЗ
#end

Interface Algorithm_run_MAKE_TXO; // M_MNPLAN::ALGORITHM_RUN_MAKE_TXO (chumachenko.res

Create view
  var   nrecFormPl
      , _cToStatus : comp;
 iVipStatLog : VipStatLog;//интерфейс истории изменений статусов
from
   formpl
 , KatNotes KatNotes_ok
 , KatNotes KatNotes_notok
 , KatNotes KatNotesNew
 , katsopr
 , MbpMove

 , tTxoTipDoc
 , tTxoTipDoc tTxoTipDocIns

where
 ((
    nrecFormPl == formpl.nrec
and FormPl.RESCOMP[2] == KatNotes_ok.nrec
and FormPl.RESCOMP[3] == KatNotes_notok.nrec
and _cToStatus  == KatNotesNew.nrec
 ))
;
//Номер системного алгоритма
#include filltTxoTipDoc.vpp
Function GetNum: Word; {
  Result := 6600;
} //Function GetNum: Word;

Function GetName: String; {
  Result := 'Привязка ТХО к документу';
}; //Function GetName: String;

Function GetMemo(st: oSteckCommonString): Boolean; {
  Result := True;
  st.Push(GetName);
  st.Push('Формирование проводок по шаблону ТХО к документу');
}; //Function GetMemo(st: oSteckCommonString): Boolean;

Function GetNameInter: String; {
  Result := 'Algorithm_run_MAKE_TXO';
} //Function GetNameInter: String;

Function GetNameInterPr: String; {
  Result := 'Algorithm_run_MAKE_TXO_Setup';
} //Function GetNameInterPr: String;

Function InitInter(Var pt: TRecAcc): Boolean; {
  #__UNUSED__(pt)
  Result := True;
} //Function InitInter(Var pt: TRecAcc): Boolean;

//Запуск алгоритма
Function ConvertMNPLAN_tipDoc_to_tidkgal(_typeCpNrec : word) : word;
{
  case _typeCpNrec of   // смотрите iz_const.vpp
   tpNak101 : result := 101; // Приходная накладная /снабжение/
   tpNak106 : result := 106; // Накладная на возврат товаров по рекламации в продаже
   tpNak201 : result := 201; // Накладная на отпуск МЦ на продажу /сбыт/
   tpNak204 : result := 204; // Акт на списание МЦ со склада /склад/
   tpNak501 : result := 501; // Накладная на отпуск в производство /склад-подразделение/
   tpNak502 : result := 502; // Накладная на приход готовой продукции из производства /по
   tpNak503 : result := 503; // Накладная на возврат сырья из производства /подразделение
   tpNak504 : result := 504; // Акт на списание МЦ из производства /подразделение/
   tpNak505 : result := 505; // Межцеховая накладная (полуфабрикат) /подразделение-подраз
   tpNak506 : result := 506; // Накладная на внутреннее перемещение в производстве (МЦ) /
   tpNak507 : result := 507; // Акт на брак
   tpNak508 : result := 508; // Акт на оказание услуг
   tpNak521 : result := 521; // Накладная на отпуск сырья на переработку (ДВС)
   tpNak522 : result := 522; // Накладная на приход готовой продукции из переработки (ДВС
   tpNak523 : result := 523; // Накладная на приход сырья из переработки (ДВС)
   tpNak532 : result := 532; // Накладная на расход сырья /по накладной на приход готовой
   tpNak600 : result := 600; // Накладная на внутреннее перемещение МЦ со склада на склад
   tpNak611 : result := 611; // Акт об излишке МЦ на складе
       2632 : result := 632; // АПМО
       2601 : result := 601; // Накладная на передачу МЦ в ОС
       2602 : result := 602; // Накладная на передачу МЦ в спецоснастку
   tpNak626 : result := 626; // Акт на возврат оборудования и материалов
       2650 : result := 615; // Инвентаризационная опись складского учета
       2737 : result := 19;   // Акт на списание МБП
       2738 : result := 12;   // Ввод в эксплуатаацию МБП /спецодежды

    else result := 0
  end;
}

Procedure SetKatSoprStatus; {
   Var oldStatus   : Word;//предыдущий статус документа
   Var oldNote     : Comp;
   Var vidSoprLog  : Word;

   oldStatus := KatSopr.status;
   oldNote   := KatSopr.cNote;
   If(GetFirst FastFirstRow KatNotesNew = TsOk) then {
     KatSopr.status := KatNotesNew.status;
     KatSopr.cNote  := KatNotesNew.nrec;
    }
   else  {
    KatSopr.status := 0;
    KatSopr.cNote  := Comp(0);
   }
   If(Update Current KatSopr = TsOk)
   {
    Case(KatSopr.vidSopr)Of
     101 //Накладная на прием МЦ (Управление снабжением)
    ,201 //Накладная на отпуск МЦ (Управление сбытом)
    ,206 //Накладная на возврат по рекламации (Управление снабжением)
    ,210://Акт передачи оборудования в монтаж (Складской учет)
     {
      vidSoprLog := 100;
     }
     Else
     {
      vidSoprLog := KatSopr.vidSopr;
     }
    End;
    //Функция вставки записи в историю изменения статуса документа
    iVipStatLog.StatLog_InsNewStat(vidSoprLog, KatSopr.nrec, oldStatus, oldNote
      , KatSopr.status, KatSopr.cNote, GetNameInter+' Автоматическое изменение статуса алгоритма привязки ТХО');
   }
}

Procedure SetMpbStatus; {
   Var oldStatus   : Word;//предыдущий статус документа
   Var oldNote     : Comp;
   Var vidSoprLog  : Word;

//   oldStatus := MpbMpve.status;
   oldNote   := MbpMove.CRECS[5];
   If(GetFirst FastFirstRow KatNotesNew = TsOk) then {
//     KatSopr.status := KatNotesNew.status;
     MbpMove.CRECS[5]  := KatNotesNew.nrec;
    }
   else  {
//    KatSopr.status := 0;
    MbpMove.CRECS[5]  := Comp(0);
   }
   If(Update Current MbpMove = TsOk)
   {
    Case(MbpMove.status)Of
     4:{
      vidSoprLog := 731;
     }
     5:
     {
      vidSoprLog := 733;
     }
    End;
    //Функция вставки записи в историю изменения статуса документа
    iVipStatLog.StatLog_InsNewStat(vidSoprLog, MbpMove.nrec, 0, oldNote
      , 0, MbpMove.CRECS[5], GetNameInter+' Автоматическое изменение статуса алгоритма привязки ТХО');
   }
}


Function RunInter(wflag: Word; Var pt: TRecAcc): Boolean;{
//  logstrtofile('c:\debug\6600.log','!!!Start 6600='+TimeToStr(Cur_Time,'HH:MM:SS:SSS'));
//  Message('strat 6600');
//  Message('Call Algoritm_MAKE_TXO ='+pt.TypeCpNrec);
  #__UNUSED__(wflag,pt)
  set nrecFormPl := pt.cFormPl;
  if getfirst FormPl <> tsOK {
     message('Не найдена настройка алгоритма ' + string(nrecFormPl,0,0), error);
     pt.Binding:=8;
     result := false;
     exit;
   }
  if FormPl.RESCOMP[1] = 0h {
     message('В настройке алгоритма привязки ТХО не выбрана ТХО', error);
     pt.Binding:=8;
     result := false;
     exit;
   }

  var _TypeCpNrec : word = pt.TypeCpNrec;
  var _cpNrec     : comp = pt.cpNrec;
  var _subTip     : word =0;

  _TypeCpNrec := ConvertMNPLAN_tipDoc_to_tidkgal(_TypeCpNrec);

//  Message('Call Algoritm_MAKE_TXO step2 '+_TypeCpNrec);

  filltTxoTipDoc;
  if( getfirst tTxoTipDoc where tTxoTipDoc.tipdoc = _TypeCpNrec)  <> tsOK {
     message('Тип документа TypeCpNrec = '+string(_TypeCpNrec)+' не предусмотрен для автоматического формирования проводок в алгоритме', error);
     pt.Binding:=8;
     result := false;
     exit;
  }

  if _TypeCpNrec <> FormPl.RESWORD[4] {
     message('Алгоритм запущен из документа с типом TypeCpNrec = '+string(_TypeCpNrec)+', а алгоритм настроен для типа ' + string(FormPl.RESWORD[4]), error);
     pt.Binding:=8;
     result := false;
     exit;
  }
//  Message('Call Algoritm_MAKE_TXO step3 '+_TypeCpNrec);

  _subTip:=0;
  if _TypeCpNrec=12
   _subTip:=1;
  //message('_cpNrec = '+string(_cpNrec,0,0) + ' _TypeCpNrec = '+string(_TypeCpNrec));
  var iauto_MAKE_TXO : auto_MAKE_TXO;
//  logstrtofile('c:\debug\6600.log','_TypeCpNrec='+_TypeCpNrec+';_cpNrec='+_cpNrec+'/'+TimeToStr(Cur_Time,'HH:MM:SS:SSS'));

  if FormPl.RESWORD[1] = 1 then iauto_MAKE_TXO.enableLog;
  var _resTxo : boolean = iauto_MAKE_TXO.MakeHozOper(_TypeCpNrec,_subTip, _cpNrec, FormPl.RESCOMP[1]);
//  logstrtofile('c:\debug\6600.log','end _TypeCpNrec='+_TypeCpNrec+';_cpNrec='+_cpNrec+TimeToStr(Cur_Time,'HH:MM:SS:SSS'));
  if FormPl.RESWORD[1] = 1 then processtext(iauto_MAKE_TXO.GetLogFile,vfDefault ,'лог привязки ТХО');
//  logstrtofile('c:\debug\nvp.log','is restxo='+_resTxo+'|'+_TypeCpNrec);
  result := True;

/*
!!!!!!!!!!!!!!!!!
смена статуса далее только для накладных сделана, никаких проверок нет накладная ли в обработке, так что если будет что то еще кроме накладных - меняйте соответственно
*/
  if (_TypeCpNrec>=101 and _TypeCpNrec<=3101)
  {
//    logstrtofile('c:\debug\nvp.log','is 1='+FormPl.RESCOMP[2]+'|'+FormPl.RESWORD[2]);

    if getfirst katsopr where ((_cpNrec == katsopr.nrec)) <> tsOK {exit;}
    set _cToStatus := 0;
    if _resTxo {
      if FormPl.RESWORD[2] = 1
      if getfirst KatNotes_ok = tsOK then set _cToStatus := KatNotes_ok.nrec;
    }
    else {
      if FormPl.RESWORD[3] = 1
      if getfirst KatNotes_notok = tsOK then set _cToStatus := KatNotes_notok.nrec;
    }
    if _cToStatus <> 0h {
//      logstrtofile('c:\debug\nvp.log','is need update');
      SetKatSoprStatus;
    }
  }
  else
   Case _TypeCpNrec of//(_TypeCpNrec>=12 and _TypeCpNrec<=20)
     19,12:
     {
       if getfirst mbpmove where ((_cpNrec == mbpmove.nrec)) <> tsOK {exit;}
       set _cToStatus := 0;
       if _resTxo {
         if FormPl.RESWORD[2] = 1
         if getfirst KatNotes_ok = tsOK then set _cToStatus := KatNotes_ok.nrec;
       }
       else {
        if FormPl.RESWORD[3] = 1
        if getfirst KatNotes_notok = tsOK then set _cToStatus := KatNotes_notok.nrec;
       }
       if _cToStatus <> 0h {
        SetMpbStatus;
       }

     }
    end;
} //Function RunInter(wflag: Word; Var pt: TRecAcc): Boolean;

End.