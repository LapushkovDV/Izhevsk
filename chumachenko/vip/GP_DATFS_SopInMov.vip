#include SopInMov.vih
#include GP_DATFS_Base.vih
#include GP_DATFS_SopInMov.vih

#component "GP_Logistics"
interface GP_DATFS_SopInMov;

function InitDocFields:boolean;
{
  result:=false;

  var iSopInMov:SopInMov;
  if (not mService.IsContainerObjectExist('L_Sklad::SopInMov')) {
//    iSopInMov.PickKatNotesAfter(rvMaxWord, rvMaxComp); //Необходимо загрузить класс из ресурса для работы GrubFieldsFromContaine
     if not LoadVipInterface(iSopInMov)
        exit;
    iSopInMov.InitVars;
  }

  mFields.SetGroup('Кнопки');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_Sklad::SopInMov', 'SCRBUTHEADER');

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_Sklad::SopInMov', 'SCRHEADER');
  if result
  {
    mFields.ChangeTitle('FPODRNAME','ОТКУДА: Склад');
    mFields.ChangeTitle('FMOLNAME','ОТКУДА: МОЛ');
    mFields.ChangeTitle('TOPODR1_NAME','КУДА: Склад');
    mFields.ChangeTitle('TOMOL1_NAME','КУДА: МОЛ');

    mFields.SetGroup('Шапка_атрибуты');
    mService.GetAtrTable(mFields, 'L_Sklad::SopInMov','ATTR_KATSOPR',word(1109));

  }

  if (result) {
    mFields.SetGroup('Спецификация');
    result:=mService.GrubFieldsFromContainer(mFields,'L_Sklad::SopInMov','BRSPECIF');
    mFields.Del('PickSpSoprMark');
    mFields.Del('Furn');
    mFields.ChangeTitle('fSerialCalc','Уч С, Учет серийных номеров');
    mFields.ChangeTitle('c_BRSPECIF1_P','P, + - позиция зарезервирована');

    mFields.SetGroup('Спецификация_атрибуты');
    mService.GetAtrTable(mFields,'L_Sklad::SopInMov','ATR_SPSOPR',word(1110));
  }

  if (iSopInMov<>NullRef) {
    iSopInMov.DoneVars;
    FreeVipInterface(iSopInMov);
  }

}

constructor Init;
{
  mGroup:='Складской учет';
  mTitle:='Накладные на внутреннее перемещение';
  mName:='SopInMov';
  mVidDoc:=600;

  result:=InitDocFields;
}
end.
