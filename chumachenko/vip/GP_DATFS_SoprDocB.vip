/*************************************************************************************************\
* Наименование: Реализация класса GP_DATFS_SoprDocB "Функционал настройки доступа                 *
*               к полям для документа Накладная на получение матценностей"                        *
* Контур/Модуль: КОУ                                                                              *
* Примечание: взято с проекта НПО ЭНЕРГОМАШ                                                       *
*                                                                                                 *
\*************************************************************************************************/

#include Notes.vih
#include SoprDocB.vih

#include GP_NalDrag.vih

#include GP_DATFS_SoprDocB.vih
interface GP_DATFS_SoprDocB;

#include Notes.var

function InitDocFields:boolean;
{
  result:=false;

  var iSD:SoprDocB;
  if (not mService.IsContainerObjectExist('L_SoprDoc::SoprDocB')) {
    if (not LoadVipInterface(iSD)) //Необходимо загрузить класс из ресурса для работы GrubFieldsFromContainer
      exit;

    iSD.InitVars;
  }

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_SoprDoc::SoprDocB', 'scrHeader');
  mFields.Del('strInfoGetOrd');
  mFields.Del('fOsnKol');
  mFields.Del('fDEI1Kol');
  mFields.Del('fDEI2Kol');

  if (result) {
    mFields.SetGroup('Спецификация');
    result:=mService.GrubFieldsFromContainer(mFields, 'L_SoprDoc::SoprDocB', 'brbyName');
    mFields.Del('OldKolFact');
    mFields.Del('OldPrv');
    mFields.Del('OldSumPrice');
    mFields.Del('KDKolOld');
    mFields.Del('KDKolNew');
    mFields.Del('KDKolDiff');
    mFields.Del('KDPriceOld');
    mFields.Del('KDPriceNew');
    mFields.Del('KDPriceDiff');
    mFields.Del('KDSummaOld');
    mFields.Del('KDSummaNew');
    mFields.Del('KDSummaDiff');
    mFields.Del('KDNalogOld');
    mFields.Del('KDNalogNew');
    mFields.Del('KDNalogDiff');
  }

  if (result) {
    mFields.SetGroup('Спецификация - сопутствующие услуги');
    result:=mService.GrubFieldsFromContainer(mFields, 'L_SoprDoc::SoprDocB', 'brSopUsl');
    mFields.Del('OldKolFact');
    mFields.Del('OldPrv');
    mFields.Del('OldSumPrice');
    mFields.Del('KDKolOldUsl');
    mFields.Del('KDKolNewUsl');
    mFields.Del('KDKolDiffUsl');
    mFields.Del('KDPriceOldUsl');
    mFields.Del('KDPriceNewUsl');
    mFields.Del('KDPriceDiffUsl');
    mFields.Del('KDSummaOldUsl');
    mFields.Del('KDSummaNewUsl');
    mFields.Del('KDSummaDiffUsl');
    mFields.Del('KDNalogOldUsl');
    mFields.Del('KDNalogNewUsl');
    mFields.Del('KDNalogDiffUsl');
  }

  if (iSD<>NullRef) {
    iSD.DoneVars;
    FreeVipInterface(iSD);
  }

}

constructor Init;
{
  mGroup:='Управление снабжением';
  mTitle:='Накладная на получение матценностей';
  mName:='SoprDocB';
  mVidDoc:=oNotes.GetVidNoteByVidDoc(101);

  result:=InitDocFields;
}

end.
