#include GP_DATFS_Base.vih

#include SoprDoc.vih

#include GP_DATFS_SoprDoc.vih
interface GP_DATFS_SoprDoc;

var iDatFS_base : GP_DATFS_Base;

function InitDocFields:boolean;
{
  result:=false;

  var iSD:SoprDoc;
  if (not mService.IsContainerObjectExist('L_SoprDoc::SoprDoc')) {
    if (not LoadVipInterface(iSD)) //Необходимо загрузить класс из ресурса для работы GrubFieldsFromContainer
      exit;

    iSD.InitVars;
  }

  mFields.SetGroup('Кнопки');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_SoprDoc::SoprDoc', 'SCRBUTHEADER');

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_SoprDoc::SoprDoc','SCRHEADER'/*'ScrHeaderFull'*/);
  mFields.ChangeTitle('KATSOPR.DESGR','Код группы пользователей');
  mFields.Del('STRINFOGETORD');
  mFields.Del('fOsnKol');
  mFields.Del('fDEI1Kol');
  mFields.Del('fDEI2Kol');

  mFields.SetGroup('Шапка_атрибуты');
  mService.GetAtrTable(mFields, 'L_SoprDoc::SoprDoc','ATTR_KATSOPR',word(1109));

  if (result) {
    mFields.SetGroup('Спецификация');
    result:=mService.GrubFieldsFromContainer(mFields, 'L_SoprDoc::SoprDoc', 'brSpecif');
    mFields.Del('KDKolOld');
    mFields.Del('KDKolNew');
    mFields.Del('KDPriceOld');
    mFields.Del('DPriceNew');
    mFields.Del('KDPriceDiff');
    mFields.Del('KDSummaOld');
    mFields.Del('KDSummaNew');
    mFields.Del('KDSummaDiff');
    mFields.Del('KDNalogOld');
    mFields.Del('KDNalogNew');
    mFields.Del('KDNalogDiff');

    mFields.SetGroup('Спецификация_атрибуты');
    mService.GetAtrTable(mFields, 'L_SoprDoc::SoprDoc','ATR_SPSOPR',word(1110));
  }

  if (iSD<>NullRef) {
    iSD.DoneVars;
    FreeVipInterface(iSD);
  }
}

constructor Init;
{
  mGroup:='Управление сбытом';
  mTitle:='Накладная на отпуск МЦ';
  mName:='SoprDoc';
  mVidDoc:=201;

  result:=InitDocFields;
}

end.
