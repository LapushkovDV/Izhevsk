/*
  МБП Акт ввода в эксплуатацию Настройка доступа 
*/

#include GP_DATFS_Base.vih
#include Move_MBP.vih
#include GP_DATFS_Move_Sfo_4.vih

#component "GP_Logistics"
interface GP_DATFS_Spec_MBP_4;

var iDatFS_base : GP_DATFS_Base;

function InitDocFields:boolean;
{
  result:=false;

  var iSD:Move_MBP;
  if (not mService.IsContainerObjectExist('F_MBP::Move_MBP')) {
    if (not LoadVipInterface(iSD)) //Необходимо загрузить класс из ресурса для работы GrubFieldsFromContainer
      exit;   
  }

  mFields.SetGroup('Кнопки');
  result:=mService.GrubFieldsFromContainer(mFields, 'F_MBP::Move_MBP', 'SCREENEXPL',1);
!  Message('result1='+result);

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields, 'F_MBP::Move_MBP', 'SCREENEXPL',2);
!  Message('result2='+result);
  mFields.ChangeTitle('MBPMOVE.DESGR','Код группы пользователей');
//  mFields.Del('fOsnKol');
   mFields.SetGroup('Шапка_атрибуты');
   mService.GetAtrTable(mFields, 'F_MBP::Move_MBP','ATTR_MBPMOVE',word(2003));

  if (result) {
    mFields.SetGroup('Спецификация');
    result:=mService.GrubFieldsFromContainer(mFields, 'F_MBP::Move_MBP', 'BROWSEOUTE');
    mFields.Del('V');
    mFields.Del('У');

    mFields.SetGroup('Спецификация_атрибуты');
    mService.GetAtrTable(mFields, 'F_MBP::Move_MBP','ATTR_MBPIN',word(2001));
  }

  mFields.SetGroup('Информация к позиции спецификации');
  result:=mService.GrubFieldsFromContainer(mFields, 'F_MBP::Move_MBP', 'SCMBPEXPL');  
  mFields.Del('MBPIn.Price');
  mFields.Del('MBPOut.tKol');
  mFields.Del('WorkEd');
  mFields.Del('MBPOut.Kol');

!  Message('result3='+result);

  if (iSD<>NullRef) {
    FreeVipInterface(iSD);
  }
}

constructor Init;
{
  mGroup := 'Учет Спецодежды';
  mTitle := 'Ввод в эксплуатацию спецодежды'; 
  mName := 'Spec_MBP_4';
  mVidDoc := 8041; //Пока сделал так, потому что Приход и Вводу э экспулатацию под одинаковыми типами документов (12)

  result := InitDocFields;
}
end.
