#include GP_DATFS_Base.vih

#include Akt_Spis.vih

#include GP_DATFS_Act_Spis.vih

#component "GP_Logistics"
interface GP_DATFS_Akt_Spis;

var iDatFS_base : GP_DATFS_Base;

function InitDocFields:boolean;
{
  result:=false;

  var iSD:Akt_Spis;
  if (not mService.IsContainerObjectExist('L_Sklad::Akt_Spis')) {
    if (not LoadVipInterface(iSD)) //Необходимо загрузить класс из ресурса для работы GrubFieldsFromContainer
      exit;

    iSD.InitVars;
  }

  mFields.SetGroup('Кнопки');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_Sklad::Akt_Spis', 'SCRBUTHEADER2');

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_Sklad::Akt_Spis', 'SCRHEADER2');
  mFields.ChangeTitle('KATSOPR.DESGR','Код группы пользователей');
  mFields.Del('fOsnKol');
  mFields.Del('fDEI1Kol');
  mFields.Del('fDEI2Kol');


  if (result) {
    mFields.SetGroup('Спецификация');
    result:=mService.GrubFieldsFromContainer(mFields, 'L_Sklad::Akt_Spis', 'brSpecif');
    mFields.Del('fEdIzmPros');
  }

  if (iSD<>NullRef) {
    iSD.DoneVars;
    FreeVipInterface(iSD);
  }
}

constructor Init;
{
  mGroup := 'Складской учет';
  mTitle := 'Акт на списание'; 
  mName := 'Akt_Spis';
  mVidDoc := 204;

  result := InitDocFields;
}
end.