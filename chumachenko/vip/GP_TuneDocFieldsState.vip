//============================================
// проверить является ли этот уровень разделом документа
Function IsRazdel(_pNrec:comp) :boolean;cacheable;
{ Result:=False;
  if _pNrec=0 then exit;
  if DocFieldsTree.IsLeaf=0
  { if isvalidall(#DocFieldsTree_Sub)
      Result :=DocFieldsTree_Sub.IsLeaf<>0;
  }
} //Function IsRazdel :boolean;

//============================================
// Установка форматов отображения при навигации по дереву
procedure SetDocFieldsStateFormat;
var
  _boKey: boolean;
{ if (DocFieldsTree.IsLeaf=0)
  { if not IsRazdel(DocFieldsTree.Nrec)
    {
      HintStr:='Выберите поле документа для настройки доступа';
      SetFormat(scHint);
      exit;
    }
  }
  _boKey:=(not IsValidAll(tnGP_TuneDocFields));
  if not _boKey
  { _boKey:=(not GP_TuneDocFields.IsUsed);
  }

  if _boKey
  { HintStr:='Выберите "Да" в колонке "Настроить?"';
    SetFormat(scHint);
    exit;
  }
/*
  if (DocFieldsTree.IsLeaf=0)
    SetDocActionStateMatrixEditor
  else
    SetDocFieldsStateMatrixEditor;
*/
} //procedure SetDocFieldsStateFormat;

//============================================
// Загрузка элементов
procedure LoadDocFields; forward;


//********************************************
//\/\/\/\ СОБЫТИЯ DocFieldsTree /\/\/\/\/\/\/\/\
//********************************************
TableEvent table DocFieldsTree;
cmImgClick:{
  if not isvalidall(tnGP_TuneDocFields) then exit;
  case CurImgField of
    //-1073741809,
    fnVisibleImg: {
      if(GP_TuneDocFields.state and 001b) <> 0
       then GP_TuneDocFields.state := (GP_TuneDocFields.state and 110b) // снять 1 бит
       else GP_TuneDocFields.state := (GP_TuneDocFields.state  or 001b) // добавить 1 бит
       }
    //-1073741808,
    fnEditableImg: {
      if(GP_TuneDocFields.state and 010b) <> 0
       then GP_TuneDocFields.state := (GP_TuneDocFields.state and 101b) // снять 2й бит
       else GP_TuneDocFields.state := (GP_TuneDocFields.state  or 010b) // добавить 2й бит
     }
    fnRequiredImg: {
      if(GP_TuneDocFields.state and 100b) <> 0
       then GP_TuneDocFields.state := (GP_TuneDocFields.state and 011b) // снять 3й бит
       else GP_TuneDocFields.state := (GP_TuneDocFields.state  or 100b) // добавить 3й бит
     }
  end;
  update current GP_TuneDocFields;
  rereadrecord; //(#GP_TuneDocFields);
}
cmTreeNodeType:{
  if (DocFieldsTree.cNode=0)
    TreeSetNodeType(trDocFields,
                    if(TreeIsTerminal(trDocFields),ntfText,if(TreeNodeIsOpen(trDocFields),ntfOpen,ntfClose)))
  else if (DocFieldsTree.IsLeaf=1)
    TreeSetNodeType(trDocFields, ntfText);
}
cmTreeTop:{
  cTreeNode:=0;
}
cmTreeUp:{
  cTreeNode:=DocFieldsTree.cNode;
}
cmTreeDown:{
  cTreeNode:=DocFieldsTree.NRec;
}
cmTreeNeedOwner:{
  TreeJumpToRecord(trDocFields,DocFieldsTree.cNode);
}
cmPositionChanged:{
  SetDocFieldsStateFormat;
}

cmPick:{
  if (CurField<>fnUseField) exit;

  if  (IsValidAll(tnGP_TuneDocFields)) {
    GP_TuneDocFields.IsUsed:=not GP_TuneDocFields.IsUsed;
    if (update current GP_TuneDocFields <> tsok)
      message('Ошибка модификации записи в таблице GP_TuneDocFields!',error);
  } else {
    GP_TuneDocFields.IsUsed        := true;
    GP_TuneDocFields.NRec          := 0;
    GP_TuneDocFields.DocName       := DocFieldsTree.DocName;
    GP_TuneDocFields.DocFieldGroup := DocFieldsTree.DocFieldGroup;
    GP_TuneDocFields.VidDoc        := DocFieldsTree.VidDoc;
    GP_TuneDocFields.cSubtip       := DocFieldsTree.cSubtip;

    GP_TuneDocFields.DocFieldName  :=if(length(DocFieldsTree.DocFieldName)>0
                                       ,DocFieldsTree.DocFieldName
                                       ,DOCFIELDSTREE.TITLE);

    if (insert current GP_TuneDocFields <> tsok)
      message('Ошибка вставки записи в таблицу GP_TuneDocFields!',error);
  }

  set GP_TuneDocFields.IsUsed;

  SetDocFieldsStateFormat;
}
cmCheckField:{
  if (CurField=fnHideUnusedFields) {
    var buf:type$DocFieldsTree;
    buf:=DocFieldsTree.buffer;

    LoadDocFields;

    var Find:boolean=false;
    Find:=getfirst fastfirstrow DocFieldsTree
          where((
            buf.IsLeaf==DocFieldsTree.IsLeaf and
            buf.Title==DocFieldsTree.Title and
            buf.DocName==DocFieldsTree.DocName and
            buf.Num==DocFieldsTree.Num
          ))=tsok;
    if (not Find)
      Find:=getfirst fastfirstrow DocFieldsTree
            where((
              buf.IsLeaf==DocFieldsTree.IsLeaf and
              buf.Title==DocFieldsTree.Title and
              buf.DocName==DocFieldsTree.DocName
            ))=tsok;

    if (Find) {
      cTreeNode:=DocFieldsTree.cNode;
      ReReadRecord(tnDocFieldsTree);
      TreeJumpToRecord(trDocFields,DocFieldsTree.NRec);
    } else {
      cTreeNode:=0;
      ReReadRecord(tnDocFieldsTree);
      TreeGetFirstEx(trDocFields);
    }
  }
}
end;

//********************************************
//\/\/\/\ ПРОЦЕДУРЫ И ФУНКЦИИ 2 /\/\/\/\/\/\/\
//********************************************
function AddTreeLeaf(buf:type$DocFieldsTree):comp;
{
  result:=0;

  if (getfirst fastfirstrow DocFieldsTree2
      where((
        buf.cNode==DocFieldsTree2.cNode and
        buf.IsLeaf==DocFieldsTree2.IsLeaf and
        buf.DocFieldName==DocFieldsTree2.DocFieldName
      ))<>tsok) {
    DocFieldsTree2.buffer:=buf;
    insert current DocFieldsTree2;
  }

  result:=DocFieldsTree2.NRec;
} //function AddTreeLeaf(buf:type$DocFieldsTree):comp;

function InsTreeNode(_cCurNode:comp
          ;_NodeTitle:string
          ;_DocName  :string=''
          ;_NodeNum  :longint=0
          ;_Viddoc   :word=0
           ):comp;
{
  result:=_cCurNode;
  if (getfirst fastfirstrow DocFieldsTree2
      where(( _cCurNode  == DocFieldsTree2.cNode and
              _NodeTitle == DocFieldsTree2.Title and
                       0 == DocFieldsTree2.IsLeaf ))<>tsok) {
        ClearBuffer(tnDocFieldsTree2);
          DocFieldsTree2.cNode   :=_cCurNode;
          DocFieldsTree2.Num     :=_NodeNum;
          DocFieldsTree2.Title   :=_NodeTitle;
          DocFieldsTree2.DocName :=_DocName;
          DocFieldsTree2.VidDoc  :=_VidDoc;
        insert current DocFieldsTree2;
  }
  result := DocFieldsTree2.NRec;
} //function InsTreeNode(cCurNode:comp;NodeTitle:string;DocName:string='';NodeNum:longint=0):comp;

procedure LoadDocFields;
var ImpCount,i:integer;
    buf:type$DocFieldsTree;
    cCurNode:comp;
    GroupName:string;
{
  Timelog('GP_TuneDocFieldsState->LoadDocFields');
  delete DocFieldsTree2 where((0<<=DocFieldsTree2.NRec));

  if (not LoadImplementationList('GP_Common::GP_ObjDocAbleTuneFieldsState', 'GP_DATFS_')) {
    Message('Не удалось загрузить список документов и полей.', Error + OkButton);
    Exit;
  }

  ImpCount := GetImplementationCount;
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Загрузка списка документов и полей...', ImpCount);

  _try {
    for (i := 0; i < ImpCount; i++) {
      Timelog('GP_TuneDocFieldsState -> for (i := 0; i < ImpCount; i++) :  i = '+ string(i));
      NextVisual;

      oDATFS:=NullRef;
      oDocFields:=NullRef;
      var _sName:string=GetImplementationName(i);
      Timelog('GP_TuneDocFieldsState->LoadDocFields:_sName='+_sName);

      if (not GetVipRef(oDATFS, _sName)) continue;
      if (oDATFS=NullRef) continue;
      if (oDATFS.Name='') continue;

      if (HideUnusedFields<>0)
        if (getfirst fastfirstrow GP_TuneDocFields2
            where((
              oDATFS.Name==GP_TuneDocFields2.DocName and
              true==GP_TuneDocFields2.IsUsed(noindex)

            ))<>tsok) continue;

      cCurNode:=0;

      GroupName:=oDATFS.Group;
      Timelog('GP_TuneDocFieldsState->LoadDocFields:GroupName='+GroupName);

      if (GroupName<>'')
        cCurNode:=InsTreeNode(cCurNode,GroupName,0,oDATFS.VidDoc);

      cCurNode:=InsTreeNode(cCurNode,oDATFS.Title,oDATFS.Name,0,oDATFS.VidDoc);

  if getfirst subtip_vaz where ((iDatFS_base.getkaukod_subtip(co_subtipVAZ) == subtip_vaz.kodgrkau
                                                      and oDATFS.VidDoc == subtip_vaz.code
                                                       and 0h == subtip_vaz.CNODE (noindex) )) <> tsOK {
    message('В пользовательской аналитике "'+co_subtipVAZ+'" на найден элемент с кодом '+oDATFS.VidDoc+' без родителя', error);
    iDatFS_base.MyLog('В пользовательской аналитике "'+co_subtipVAZ+'" на найден элемент с кодом '+oDATFS.VidDoc+' без родителя');
    exit;
   }

   var _csubTip : comp = subtip_vaz.nrec;

  if getfirst subtip_vaz where ((iDatFS_base.getkaukod_subtip(co_subtipVAZ) == subtip_vaz.kodgrkau
                                                               and _csubTip == subtip_vaz.CNODE (noindex) )) <> tsOK {
    message('В пользовательской аналитике "'+co_subtipVAZ+'" у элемента с кодом '+oDATFS.VidDoc+' нет дочерних записей', error);
    iDatFS_base.MyLog('В пользовательской аналитике "'+co_subtipVAZ+'" у элемента с кодом '+oDATFS.VidDoc+' нет дочерних записей');
    exit;
   }

  var cCurNodebefore : comp = cCurNode;
  var _isFirst : boolean = true;
  _loop subtip_vaz where ((iDatFS_base.getkaukod_subtip(co_subtipVAZ) == subtip_vaz.kodgrkau
                                                         and _csubTip == subtip_vaz.CNODE (noindex) )) {

         cCurNode:=InsTreeNode(cCurNodebefore,subtip_vaz.name,oDATFS.Name,0,oDATFS.VidDoc);

          oDocFields:=oDATFS.Fields;

          Timelog('GP_TuneDocFieldsState->oDocFields');
          _loop oDocFields ordered by oDocFields.Num {
            Timelog('GP_TuneDocFieldsState->oDocFields: oDocFields.Name = ' + oDocFields.Name);
            if (oDocFields.Name='') continue;


             if _isFirst = true {
                GP_TuneDocFields.NRec          := 0;
                GP_TuneDocFields.DocName       := oDATFS.Name;
                GP_TuneDocFields.DocFieldGroup := '____DEFAULT____';
                GP_TuneDocFields.VidDoc        := oDATFS.VidDoc;
                GP_TuneDocFields.cSubtip       := 0;
                if (insert current GP_TuneDocFields <> tsok) {}
              }


            if (HideUnusedFields<>0)
              if (getfirst fastfirstrow GP_TuneDocFields2
                  where((   oDATFS.Name  == GP_TuneDocFields2.DocName
                    and oDocFields.Group == GP_TuneDocFields2.DocFieldGroup
                     and oDocFields.Name == GP_TuneDocFields2.DocFieldName
                       and oDATFS.VidDoc == GP_TuneDocFields2.VIDDOC
                     and subtip_vaz.nrec == GP_TuneDocFields2.cSubTip
                    and             true == GP_TuneDocFields2.IsUsed(noindex)
                  ))<>tsok) continue;

            ClearAdvRecord(buf);
            buf.cNode:=cCurNode;

            GroupName:=oDocFields.Group;
            if (GroupName<>'')
              buf.cNode:=InsTreeNode(buf.cNode,GroupName,oDATFS.Name,oDocFields.Num,oDATFS.VidDoc);



              //subtip_vaz.nrec;

            buf.IsLeaf:=1;
            buf.Title         := oDocFields.Title;
            buf.Num           := oDocFields.Num;
            buf.DocName       := oDATFS.Name;
            buf.DocFieldGroup := oDocFields.Group;
            buf.DocFieldName  := oDocFields.Name;
            buf.VidDoc        := oDATFS.VidDoc;
            buf.RootContainer := oDocFields.RootContainer;
            buf.Container     := oDocFields.Container;
            buf.ControlName   := oDocFields.ControlName;
            buf.cSubtip       := subtip_vaz.nrec;
           AddTreeLeaf(buf);
      } //_loop oDocFields ordered by oDocFields.Num {
      _isFirst := false;
     }
    } //for (i := 0; i < ImpCount; i++) {
  } //_try
  _except
  on ExUserBreak :  {  }
  _finally {
    oDATFS:=NullRef;
    oDocFields:=NullRef;
    StopVisual;
  }

  UnloadImplementationList;
}  //procedure LoadDocFields;

//********************************************
//\/\/\/\ СОБЫТИЯ ИНТЕРФЕЙСА /\/\/\/\/\/\/\/\
//********************************************

HandleEvent
//--------------------------------------------
cmInit:{

#ifdef _DEBUG_DocFieldsStateService_
  iDatFS_base.enablelog;
#endif
  Timelog('GP_TuneDocFieldsState->cmInit:');

  if iDatFS_base.getkaukod_subtip(co_subtipVAZ) = 0 {
   Timelog('не найдена пользовательская аналитика "'+co_subtipVAZ+'"');
   message('не найдена пользовательская аналитика "'+co_subtipVAZ+'"', error);
   stop;abort;exit;
  }

  if (not iRARS.IsAdminFunc()) {
    message('Программа доступна только пользователям с правами администратора.',error);
    abort;
    exit;
  }

  ReadMyDsk(HideUnusedFields,#__InterfaceName__+'HideUnusedFields',true);

  LoadDocFields;
  if (HideUnusedFields<>0 and RecordsInTable(tnDocFieldsTree)=0) {
    HideUnusedFields:=0;
    LoadDocFields;
  }



  DisableCommand(cmRestoreDoc);

  ToggleFieldVisible(#DocFieldsTree.DocName,false);
  ToggleFieldVisible(#DocFieldsTree.DocFieldName,false);
  ToggleFieldVisible(#DocFieldsTree.VidDoc,false);
  ToggleFieldVisible(#DocFieldsTree.RootContainer,false);
  ToggleFieldVisible(#DocFieldsTree.Container,false);
  ToggleFieldVisible(#DocFieldsTree.ControlName,false);
}

//--------------------------------------------
cmDone:{
  SaveMyDsk(HideUnusedFields,#__InterfaceName__+'HideUnusedFields');
  //dSetTune('NPOEM_OWN.Rights_Fields_Date',cur_date);// 'Права доступа по полям - Дата' , ftDate,0,'','');
  //tSetTune('NPOEM_OWN.Rights_Fields_Time',cur_time);// 'Права доступа по полям - Время', ftTime,0,'','');

}
//--------------------------------------------
cmHotKeys:{
  PutHotCommand(RunMenu('GP_TuneDocFieldsState_HotKeys'));
}
//--------------------------------------------
cmSaveDoc:{
  if (DocFieldsTree.IsLeaf<>1 or UseField<>'Да') exit;

//  CopyFieldStateMatrix_TreeNRec:=DocFieldsTree.NRec;
//  CopyFieldStateMatrix_VidDoc:=DocFieldsTree.VidDoc;
//  CopyFieldStateMatrix_NRec:=GP_TuneDocFields.NRec;

  EnableCommand(cmRestoreDoc);
  message('Скопированы настройки доступа поля "'+DocFieldsTree.Title+'".');
}
//--------------------------------------------
