//*******************************************
Interface GP_TuneDocFieldsState 'Настройка прав доступа к полям документов' Gray;
//*******************************************
show(10,1,170,30);

//*******************************************
//\/\/\/\ Forward описания функций /\/\/\/\/\
//*******************************************
Function IsRazdel(_pNrec:comp) :boolean;Forward;


//*******************************************
//\/\/\/\ Объекты и переменные /\/\/\/\/\
//*******************************************
var pMarker   : IMarker(Marker) new;
    iRARS     : iRARSDisp;
    oDATFS    : GP_ObjDocAbleTuneFieldsState;
    oDocFields: GP_ObjDocFields;
//    oEditor   : GP_ObjDocFieldsStateMatrixEditor;
//    oAction   : GP_ObjDocActionStateMatrixEditor;
    iService  : GP_DocFieldsStateService;
        iDatFS_base : GP_DATFS_Base;
//    CopyFieldStateMatrix_VidDoc:word;
//    CopyFieldStateMatrix_NRec,CopyFieldStateMatrix_TreeNRec:comp;

//*******************************************
//\/\/\/\    Временные таблицы     /\/\/\/\/\
//*******************************************
table struct DocFieldsTree(
    NRec          : comp
  , cNode         : comp
  , IsLeaf        : word
  , Title         : string
  , Num           : longint
  , DocName       : string
  , DocFieldGroup : string
  , DocFieldName  : string
  , VidDoc        : word
  , RootContainer : string
  , Container     : string
  , ControlName   : string
  , cSubtip       : comp
)
with index (
   i1 = NRec(Unique, Surrogate, Journal)
 , i2 = cNode + Num + Title + IsLeaf
 , i3 = cNode + Title + IsLeaf
 , i4 = cNode + IsLeaf + DocFieldName
 , i5 = IsLeaf + Title + DocName + Num
);

//***************************************
create view
var cTreeNode:comp;
    HideUnusedFields:word;
    HintStr:string;
as select
  if(DocFieldsTree.IsLeaf=0 and (not IsRazdel(DocFieldsTree.Nrec)),'',
    if(not IsValidAll(tnGP_TuneDocFields),'Нет',
      if(GP_TuneDocFields.IsUsed,'Да','Нет'))) (FieldName=UseField)

  ,if((GP_TuneDocFields.state and 001b) <> 0,'BMCHECKONBROWSE','BMCHECKOFFBROWSE') (FieldName=VisibleImg )
  ,if((GP_TuneDocFields.state and 010b) <> 0,'BMCHECKONBROWSE','BMCHECKOFFBROWSE') (FieldName=EditableImg)
  ,if((GP_TuneDocFields.state and 100b) <> 0,'BMCHECKONBROWSE','BMCHECKOFFBROWSE') (FieldName=RequiredImg)


from
    DocFieldsTree(i2)
  , DocFieldsTree DocFieldsTree2
  , DocFieldsTree DocFieldsTree_UP
  , DocFieldsTree DocFieldsTree_Sub
  , oDocFields
  , GP_TuneDocFields
  , GP_TuneDocFields GP_TuneDocFields2
  , spkau subtip_vaz
where((
    cTreeNode                   == DocFieldsTree.cNode
and DocFieldsTree.cNode         == DocFieldsTree_UP.Nrec
and DocFieldsTree.Nrec          == DocFieldsTree_Sub.cNode
and DocFieldsTree.DocName       == GP_TuneDocFields.DocName
and DocFieldsTree.DocFieldGroup == GP_TuneDocFields.DocFieldGroup
and if(length(DocFieldsTree.DocFieldName)>0
        , DocFieldsTree.DocFieldName
        , DOCFIELDSTREE.TITLE)  == GP_TuneDocFields.DocFieldName
and DocFieldsTree.VIDDOC        == GP_TuneDocFields.VIDDOC
and DocFieldsTree.cSubTip       == GP_TuneDocFields.cSubTip

));

procedure timelog(_str : string); {
  iDatFS_base.MyLog(_str);

}
//********************************************
//\/\/\/\ ВИЗУАЛЬНЫЕ ЭЛЕМЕНТЫ /\/\/\/\/\/\/\/\
//********************************************
screen scOptions (,,sci1Esc);
show(,,70,1) Fixed_Y;
table DocFieldsTree;
fields
  HideUnusedFields:NoProtect;
<<
   [.] Скрыть поля без настроек`
>>
end;

tree trDocFields (,,sci1EscTreeI);
show(,2,70,);
table DocFieldsTree;
recMarker=pMarker;
fields
  {font={color=if(UseField='Нет',ColorSysGray,0)}};
  DocFieldsTree.Title 'Наименование программы/поля':[60],Protect;
  UseField 'Настроить?' (,,sci13EscTreeI):[12],Protect,NoAutoSize,PickButton;
  DocFieldsTree.DocName 'Имя документа' :[20],Protect;
  DocFieldsTree.DocFieldName 'Имя поля' :[20],Protect;

  VisibleImg 'Видимость' ('Определяет будет ли поле отображаться',,):
    [10],Centered,NoAutoSize,image;
  EditableImg 'Редакт-е' ('Определяет возможность редактировать поле',,):
    [10],Centered,NoAutoSize,image;
  RequiredImg 'Обязательное' ('Определяет обязательность заполнения редактировать поле',,):
    [10],Centered,NoAutoSize,image;
  DocFieldsTree.VidDoc 'Код' :[5],Protect;
  DocFieldsTree.RootContainer 'Корневой контейнер' :[20],Protect;
  DocFieldsTree.Container 'Контейнер' :[20],Protect;
  DocFieldsTree.ControlName 'Элемент управления' :[40],Protect;
  DocFieldsTree.cSubtip     'ссылка на подтип' :[40],Protect;
end;
screen scHint(,,sci1Esc);
show(71,,,);
fields
  HintStr:skip,centered,anAll,{font={bold=true;Color=0}};
<<










.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

embedded emDocFieldsStateMatrix interface;
show(71,,,);
end;

embedded emDocActionStateMatrix interface;
show(71,,,);
end;


