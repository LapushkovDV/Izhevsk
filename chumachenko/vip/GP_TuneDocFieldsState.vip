      if (DocFieldsTree2.IsLeaf<>1 or
          CopyFieldStateMatrix_TreeNRec=DocFieldsTree2.NRec or
          CopyFieldStateMatrix_VidDoc<>DocFieldsTree2.VidDoc) continue;

      if (not iService.CopyFieldStateMatrix(CopyFieldStateMatrix_NRec,DocFieldsTree2.DocName,
                                            DocFieldsTree2.DocFieldGroup,DocFieldsTree2.DocFieldName))
        break;
    }//_loop pMarker
    AddBounds(tbRMDocFieldsTree1);

    pMarker.UnselectAll;

    StopVisual;
  }

  ReReadRecord(tnDocFieldsTree);
  SetDocFieldsStateFormat;
}
*/
//--------------------------------------------
cmAlt1:{
  ToggleFieldVisible(#DocFieldsTree.DocName,true);
  ToggleFieldVisible(#DocFieldsTree.DocFieldName,true);
  ToggleFieldVisible(#DocFieldsTree.VidDoc,true);
  ToggleFieldVisible(#DocFieldsTree.RootContainer,true);
  ToggleFieldVisible(#DocFieldsTree.Container,true);
  ToggleFieldVisible(#DocFieldsTree.ControlName,true);
}

end;
end.

