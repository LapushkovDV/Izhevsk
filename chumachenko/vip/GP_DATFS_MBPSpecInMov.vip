#include GP_DATFS_Base.vih
#include GP_DATFS_MBPSPECInMov.vih
#include MBPInMov.vih

#component "GP_Logistics"

Interface GP_DATFS_MBPSpecInMov;

function InitDocFields:boolean;
{
  result:=false;

  var iMbp:MBPInMov;
  if (not mService.IsContainerObjectExist('L_Sklad::MBPInMov')) {
      if not LoadVipInterface(iMbp)
        exit;
    iMbp.InitVars;
  }

  mFields.SetGroup('Кнопки');
  result:=mService.GrubFieldsFromContainer(mFields,'L_Sklad::MBPInMov', 'SCRBUTHEADERMBP');

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields,'L_Sklad::MBPInMov', 'SCRHEADERMBP');
  if result
  {
    mFields.ChangeTitle('FPODRNAME','ОТКУДА: Склад');
    mFields.ChangeTitle('FMOLNAME','ОТКУДА: МОЛ');
    mFields.ChangeTitle('TOPODR1_NAME','КУДА: Склад');
    mFields.ChangeTitle('TOMOL1_NAME','КУДА: МОЛ');

    mFields.SetGroup('Шапка_атрибуты');
    mService.GetAtrTable(mFields, 'L_Sklad::MBPInMov','ATTR_KATSOPR',word(1109));
  }

  if (result) {
    mFields.SetGroup('Спецификация');
    result:=mService.GrubFieldsFromContainer(mFields,'L_Sklad::MBPInMov','BRSPECIF');

    mFields.SetGroup('Спецификация_атрибуты');
    mService.GetAtrTable(mFields, 'L_Sklad::MBPInMov','ATTR_KATSOPR',word(1110));
  }

    mFields.SetGroup('Спецификация_атрибуты');
    mService.GetAtrTable(mFields, 'L_Sklad::MBPInMov','ATTR_KATSOPR',word(1110));

}

constructor Init;
{
  mGroup:='Складской учет';
  mTitle:='Накладные на склад-спецоодежда';
  mName:='MBPSpecInMov';
  mVidDoc:=6022;

  result:=InitDocFields;
}

end.
