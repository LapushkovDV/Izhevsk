#ifndef __GP_DocFieldsStateService_VIH__
#define __GP_DocFieldsStateService_VIH__

#include GP_ObjDocAbleTuneFieldsState.obj

#component "GP_Common"

//--------------------------------
// Время и дата последней загрузки данных по интерфейсу
Table Struct tRFld_Interface
( name :string[100]
 ,DT :date
 ,TM:time
)
with index
( tRFld_Interface01 = Name
);

//--------------------------------
// список полей
Table Struct tTuneDocFields
(    NRec         : comp        "Номер записи"
   , DocName      : string[127] "Имя документа"
   , DocFieldGroup: string      "Группа полей" // Пустое значение - права на запись
   , DocFieldName : string      "Имя поля"
   , state        : word        "набор состояний поля"
   , IsUsed       : boolean     "Поле используется в настройке"
   , TitleNew     : string "новое наименование для кнопки"
)
with index
( tTuneDocFields01 = DocName+DocFieldGroup+DocFieldName
 ,tTuneDocFields02 = NRec

);

//--------------------------------
// список настроек по ролям
table struct tFieldsStateMatrix "Матрица состоянии полей документов"
(
  NRec      : comp "Номер записи",
  cDocField : comp "Настройка поля документа",
  wSubType     : comp "Роль",
  cSubType   : comp "Статус",
  State     : word "Состояние",
  //------------- нету в стандарте, но нужно для индекса
  DocName   : string[127] "Имя документа"
)
With index
(
  tFieldsStateMatrix01 = nRec,
  tFieldsStateMatrix02 = cDocField + wSubType + cSubType,
  tFieldsStateMatrix03 = DocName
);

//--------- Привязка ролей к пользователю
Table struct tr_WorkPlace
( wSubType :comp
 ,cUsers:comp
)
with index
( tr_WorkPlace01  =wSubType
);

//------------ Права на документ в зависимости от статуса
Table struct tDoc_Status
(   DocName      : string[127] "Имя документа"
   ,cSubType      : comp        "Статус"
   ,DocFieldGroup: string      "Группа полей"
      // = tTuneDocFields.DocFieldName при tTuneDocFields.DocFieldGroup=''
      //SopInMove - Спецификация, Шапка - Основная информация,
   ,IsUsed       : boolean     "Поле используется в настройке"
   ,IsIns        : boolean //  if((GP_FieldsStateMatrix.State and   1b)=0
   ,IsEdit       : boolean //  if((GP_FieldsStateMatrix.State and  10b)=0
   ,IsDel        : boolean //  if((GP_FieldsStateMatrix.State and 100b)=0
)
with index
( tDoc_Status01 = DocName+ DocFieldGroup + cSubType
);

//*******************************************
ObjInterface GP_ObjDocFieldsStateService;
//*******************************************
  function IsContainerObjectExist(RootContainer:string):boolean; //Контейнер существует (загружен)
  function GrubFieldsFromContainer(oFields:GP_ObjDocFields;RootContainer,Container:string):boolean; //Получить список полей
  function anotherSubTip(cSubType:comp):boolean;
  function CalcFieldsState(oDATFS:GP_ObjDocAbleTuneFieldsState;cSubType:comp):boolean; //Рассчитать состояние полей для текущего пользователя
  function ApplyFieldsState(oFields:GP_ObjDocFields;CurContainer:tptr;UseSkip:boolean; _returnFieldsProp : word = 0 ):boolean; //Применить состояние полей к документу
  function isButtonOverLoad(oFields:GP_ObjDocFields; CurContainer:tptr; _command : longint) : boolean;
  function CanEditField(oFields:GP_ObjDocFields;CurContainer:tptr;ControlName:string):boolean; //Доступно ли редактирование пол
  procedure RenameFieldsGroup(DocName,OldName,NewName:string); //Переименовать группу полей
  procedure RenameField(DocName,FieldGroup,OldName,NewName:string); //Переименовать поле
//  function CopyFieldStateMatrix(cSrc:comp;DocName,FieldGroup,DocFieldName:string):boolean; //Скопировать настройки доступа из поля cSrc
  function ButtonPush(oFields:GP_ObjDocFields; CurContainer:tptr; _command : longint; _TypeCpNrec : word; _cRec : comp) : boolean; //выполнить перекрытую кнопку

  procedure SetCheckProtectStateEnabled(pEnabled: boolean);
  property pbEmptyTitleAsFieldNameEnabled: boolean;

//-------- #3954 ------------------
  function CanEditRazdel(_CurContainer:tptr;_DocName:string; ControlName:string;_Razdel:string;_cSubType:comp):boolean; //Доступно ли редактирование раздела
  function CanInsRazdel (_CurContainer:tptr;_DocName:string; ControlName:string;_Razdel:string;_cSubType:comp):boolean; //Доступна ли вставка записей раздела
  function CanDelRazdel (_CurContainer:tptr;_DocName:string; ControlName:string;_Razdel:string;_cSubType:comp):boolean; //Доступна ли удаление записей раздела
//-----------------
  event function ApplyState(IsVisible,IsEditable:boolean;bField:GP_ObjDocFields):boolean; //Не типовая обработка состояния поля
end;

VipInterface GP_DocFieldsStateService Implements GP_ObjDocFieldsStateService;
public:
  Constructor Init;
  static function GetDocByName(DocName:string):GP_ObjDocAbleTuneFieldsState;//Фабричный метод
end;

#endif
