#include GP_DATFS_Base.vih
#include gtekost.vih
#include GP_DATFS_PereSort.vih
#include PereSort.vih
//#component "GP_Logistics"

Interface GP_DATFS_PereSort;

function InitDocFields:boolean;
{
  result:=false;

  var
    iPereSort: PereSort;

  if (not mService.IsContainerObjectExist('L_Sklad::PereSort')) {
//    iPereSort.PickKatNotesAfter(rvMaxWord, rvMaxComp);
    iPereSort.InitVars;
  }

  mFields.SetGroup('Кнопки');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_Sklad::PereSort', 'SCRBUT1');

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_Sklad::PereSort', 'S1');
  if result
  {
    mFields.ChangeTitle('KATPODR1_NAME','ОТКУДА: Склад');
    mFields.ChangeTitle('KATMOL1_NAME','ОТКУДА: МОЛ');
    mFields.ChangeTitle('KATPODR2_SNAME','КУДА: Склад');
    mFields.ChangeTitle('KATMOL2_SNAME','КУДА: МОЛ');

    mFields.Del('i_S1');
    mFields.Del('i_S1#1');    
    mFields.Del('i_S1#2');
    mFields.Del('i_S1#3');
    mFields.Del('i_S1#4');
    mFields.Del('i_S1#5');
    mFields.Del('i_S1_BARKODANDSTATE');

    mFields.SetGroup('Шапка_атрибуты');
    mService.GetAtrTable(mFields,'L_Sklad::PereSort','ATTR_KATSOPR',word(1109));

  
    mFields.SetGroup('Спецификация - Списание');
    result := mService.GrubFieldsFromContainer(mFields, 'L_Sklad::PereSort', 'ListRasxod');
    if result
    {
      // c_LISTRASXOD
      mFields.Del('c_LISTRASXOD');
      // №
      mFields.Del('SPSOPR.NPP');
      // Уч С
      mFields.Del('FSERIALCALC');
      // ДЕИ 2
      mFields.Del('KATDOPED2.SHORTNAME');
      // Количество в ДЕИ 2
      mFields.Del('SPDOPED2.KOL');
        // Серийный номер
        mFields.Del('FSERIALNUM');

      mFields.SetGroup('Спецификация - Списание_атрибуты');
      mService.GetAtrTable(mFields,'L_Sklad::PereSort','ATR_SPSOPR',word(1110));


      mFields.SetGroup('Спецификация - Оприходование');
      result := mService.GrubFieldsFromContainer(mFields, 'L_Sklad::PereSort', 'ListPrixod');
      if result
      {
        // c_LISTPRIXOD
        mFields.Del('c_LISTPRIXOD');
        // №
        mFields.Del('SPSOPR2.NPP');
        // Уч С
        mFields.Del('FSERIALCALC2');
        // ДЕИ 2
        mFields.Del('KATDOPEDP2.SHORTNAME');
        // Количество в ДЕИ 2
        mFields.Del('SPDOPEDP2.KOL');
        // Серийный номер
        mFields.Del('FSERIALNUM2');

        mFields.SetGroup('Спецификация - Оприходование');
        mService.GetAtrTable(mFields,'L_Sklad::PereSort','ATR_SPSOPR',word(1110));
      }
    }
  }
  if (iPereSort <> NullRef)
    FreeVipInterface(iPereSort);
}

constructor Init;
{
  mGroup := 'Складской учет';
  mTitle := 'Акт на пересортицу'; 
  mName := 'PereSort';
  mVidDoc := 630;

  result := InitDocFields;
}
end.
