#component "VAZ_COMMON"

Interface Interfaces_tunes 'Настройки полей интерфейсов';
create view
var
from
 x$files x$files_br
;
 Function getlastsymbol(_str : string): string; {
  Result := substr(_str,length(_str),1);
 }
 Function GenerateNewFile: string; {
   var _outPath : string = GetStringParameter('Files','OutputFilesDirectory',0);
  result := _outPath + if(getlastsymbol(_outPath) = '\','','\')+'VAZ_COMMON_'+DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS-SSS');
 }

handleevent
cmcheckfield: {
  updatetable;
}
end;
end.
