#include GP_DATFS_Base.vih
#include GP_DocFieldsStateService.vih

#component "L_Sklad"

Alter Interface SopInMov;

  var oDATFS: GP_ObjDocAbleTuneFieldsState;
  var iDatFS_base : GP_DATFS_Base;

  create view
    var namewin:string;
   as select
     if(isvalid(tnKauVid),KauVid.name,'Не определен') (fieldname=fvidOper)  
   from Spkau KauVid
     where ((
            katsopr.cizd == KauVid.nrec
          ))
  ;

procedure timelog(_str : string); {
#ifdef _DEBUG_DocFieldsStateService_
  iDatFS_base.enablelog;
  iDatFS_base.MyLog(_str);
#endif
}

#include onCfgObjectsRequired.vpp
#include funWin.vpp

Window EditSopr;
Panel pnHeader;
Table KatSopr;

  handleevent  //Panel pnHeader
    cmPositionChanged:
    {
      Inherited::HandleEvent(cmPositionChanged);
      //================= #5818 =====================
      //При смене позиции KatSopr удаляем пустую накладную, созданную ранее текущим пользователем

      if (oDATFS <> NullRef)
        oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);        
    }
   end;
 end; //handleevent Panel pnHeader
end; //Panel pnHeader;

WindowEvent EditSopr;
  CmInit:
  {
   Inherited::HandleEvent(CmInit);
     if (oDATFS<>NullRef) {
       if katsopr.cIzd = 0h {
          var _cIzd : comp =  iDatFS_base.runwindowgetsubtip(600);
         set katsopr.cIzd := _cIzd;
         updatetable;
        iDatFS_base.SetDefault(KatSopr.cIzd, katsopr.nrec);
       }
       oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
     }
   SetWindowTitle(EDITSOPR,SetNeWinTitle(namewin));
  }
   cmMakeOrder : {
      if (oDATFS<>NullRef) {
        var _boOverload : boolean = oDATFS.isOverLoadButton(KatSopr.cIzd,cfsGetCurrentContainerSelf,cmMakeOrder);
         if _boOverload {
          var _TypeCpNrec : word = 2000 + katsopr.vidsopr;

        /*подготовим массив записей для проверки атрибутов*/
        var _arAtr : arAttr;
        SetLimit(_arAtr,0);
        SetLimit(_arAtr,1);
        var _i : longint = 1;
        _arAtr[_i].nrec := Katsopr.nrec;
        _arAtr[_i].tabl := 1109;
        timelog('_i = '+ _i + '  _arAtr[_i].nrec = ' + string(_arAtr[_i].nrec) + ' _arAtr[_i].tabl = ' +_arAtr[_i].tabl);
        _loop spsopr {
          _i++;
          setlimit(_arAtr, getlimit(_arAtr)+1);
          _arAtr[_i].nrec := spsopr.nrec;
          _arAtr[_i].tabl := 1110;
           timelog('_i = '+ _i + '  _arAtr[_i].nrec = ' + string(_arAtr[_i].nrec) + ' _arAtr[_i].tabl = ' +_arAtr[_i].tabl);
        }

        timelog('getlimit(_arAtr) = ' + getlimit(_arAtr));
        /*end подготовим массив записей для проверки атрибутов*/
        if not oDATFS.CheckReqrAtr(_arAtr, Katsopr.cizd) { // проверить заполненность атрибутов
         ReReadRecord(tnKatSopr);
         ReReadRecord(tnSpSopr);
        //message('_boOverload!');
          abort; exit;
        }


          oDATFS.PushButton(KatSopr.cIzd,cfsGetCurrentContainerSelf,cmMakeOrder, _TypeCpNrec, katsopr.nrec, oDATFS);

          ReReadRecord(tnKatSopr);
          ReReadRecord(tnSpSopr);
          //message('_boOverload!');
          abort; exit;
        }
      }
      inherited::handleevent(cmMakeOrder)
    }
End; //WindowEvent EditSopr;

TableEvent Table SpSopr;
CmPositionChanged:
{
 Inherited::HandleEvent(CmPositionChanged);
 if (oDATFS<>NullRef)
  oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);

}
End;//TableEvent Table SpSopr;

HandleEvent
cmInit:
{

  oDATFS := GP_DocFieldsStateService::GetDocByName('SopInmov');
  oDATFS.CalcAndApplyFieldsState(0, cfsGetCurrentContainerSelf);
  BindEvent(onCfgObjectsRequired, oDATFS.Event_onCfgObjectsRequired);

  case Inherited::HandleEvent(cmInit) of
  heAbort :  Abort;
  heStop  :  Exit;
  end;
  cfsGetProp('EDITSOPR','Title',namewin); 
  //-------------------------------------------
} //cmInit:
end;
end.
