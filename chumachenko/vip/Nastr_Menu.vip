#include MenuDynamic.vih
//Добавление пунктов локального меню
handler with replace AVAZ_MenuDynamic_AddItems_NastrLogDocs on ExtensionPoint AVAZ_MenuDynamic_AddItems
action
{
  result:=true;

  var MenuID:longint=0;
  _try {
    MenuID:=LoadMenuEx('C_Common::Nastr_Nastr',false,true);

    AddMenuItem(MenuID,'separator',0);

    if(not ConcatMenu(MenuId, LoadMenu('AVAZ_NastrLog_HotKeys1', false)))
      Message('ошибка добавления AVAZ_NastrLog_HotKeys1');
    if (not StoreMenuHowDynamics(MenuID,'C_Common::Nastr_Nastr'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню настройки Хозопераций"'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }
}

//Удаление пунктов меню
handler with replace AVAZ_MenuDynamic_DelItems_NastrLogDocs on ExtensionPoint AVAZ_MenuDynamic_DelItems
action
{
  result:=true;

  DeleteMenuHowDynamics('C_Common::Nastr_Nastr');
}

AVAZ_NastrLog_HotKeys1 Menu
{
  - 'Настройка видов операций по документам логистики', cmRunInterface('GP_COMMON::GP_TuneDocFieldsState'),,;
}