#doc
Записать в длинную строку лог.
Получить путь на лог-файл можно через GetLogFile
#end

Procedure MyLog(_str: string);
#doc
Отключить логирование
#end
procedure disableLog;

#doc
Включить логирование
#end
procedure enableLog;

#doc
Выгружает на диск длинную строку с логом и очищает строку.
Возвращается путь на выгруженный файл
#end
function GetLogFile : string;

#doc
привязать ТХО к документу
  _TipDoc   - тип документа
  _cSoprDoc - ссылка на документ
  _cHozOper - ссылка на ТХО
#end
function MakeHozOper (_TipDoc: word; _cSoprDoc: comp; _cHozOper : comp) : boolean;

#doc
отвязать ТХО от документа
  _TipDoc   - тип документа
  _cSoprDoc - ссылка на документ

#end
function DeleteHozOper (_TipDoc: word; _cSoprDoc: comp) : boolean;

end;

