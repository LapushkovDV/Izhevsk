#include TxoBind.vih          // iTxoBind         сложная привязка ТХО, и запуск сложной разноски
#include SHManager.vih

#include auto_MAKE_TXO.vih

#component "VAZ"
Interface auto_MAKE_TXO 'Формирование проводок к документу по ТХО';

var iSHoz  : ObjSHmanager;

create view
 var
     _LongStringLog
   , _serviceLog    : tptr;
     _needlog : boolean;
     iTxoBind : TxoBinder;
from
   soprhoz
 , HozOper
 , MbpMove
;
exception ExMakeHozOper;

function getlastsymbol(_str : string) : string; {
  result := substr(_str,length(_str),1);
}

Function GenerateNewFile: string; {
  var _outdir : string = GetStringParameter('Files','OutputFilesDirectory',0);
 result := _outdir + if(getlastsymbol(_outdir) = '\','','\') +
       + 'auto_make_txo_'+DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS-SSS');
}

Procedure MyLog(_str: string);{
  if not _needlog then exit;
  _str := DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS') + ': '+_str + ''#13'';
  HttpConnect_AddValueToLongString(_serviceLog, _str, _LongStringLog);
}

procedure disableLog; {
  HttpConnect_DestroyLongString(_serviceLog, _LongStringLog);
  HttpConnect_Free(_serviceLog);
  set _needlog := false;
}

procedure enableLog; {
   disableLog;
  _serviceLog    := HttpConnect_CreateEx('http://ya.ru', '', '', true);
  _LongStringLog := HttpConnect_CreateLongString(_serviceLog);
  set _needlog := true;
}

function GetLogFile : string; {
  var _log_OUT : string = GenerateNewFile+'.log';
  HttpConnect_SaveToFileEx(_serviceLog, _LongStringLog, _log_OUT, cpOEMCP, false); // cpUTF8 | cpOEMCP | cpACP | 0-CP866
  result := _log_OUT;
}

function MakeHozOperreal (_TipDoc: word; _cSoprDoc: comp; _cHozOper : comp) : boolean; {
  Result := false;


  mylog('start function MakeHozOper _TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0)+' _cHozOper = ' + string(_cHozOper,0,0));

  If (GetFirst fastfirstrow SoprHoz where ((_TipDoc  == SoprHoz.TipDoc AND _cSoprDoc == SoprHoz.cSoprDoc)) != tsOk) {
    mylog('не найдена хозоперация (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0)+')');
    Exit;
   }

  iTxoBind.ResetServer;

  if GetFirst HozOper where ((_cHozOper == HozOper.Nrec)) != tsOk {
    mylog('не найдена хозоперация (_cHozOper = '+ string(_cHozOper,0,0) + ')');
    Exit;
   }

//  update SoprHoz set SoprHoz.cHozOper := _cHozOper;
  SoprHoz.cHozOper := _cHozOper;
  update current SoprHoz;
!  Message('1');
  if ( NullVipRef(iSHoz) )
    GetVipRef(iSHoz, 'SHmanager');

  iSHoz.CheckMagOper(#TSoprHozX(SoprHoz.bufferp), 1);
!  Message('2');
  if iTxoBind.BuildTree(SoprHoz.bufferp)
   {
!  Message('3');
    iTxoBind.SetOperation(0, wOper_ReObor, 0, 0);
!  Message('4');
//    if ( iTxoBind.Bind(SoprHoz.bufferp, 0))
      if iTxoBind.RealizeAndApplyOperations(SoprHoz.bufferp)
       {
!  Message('5');
        Result :=iTxoBind.Apply(SoprHoz.bufferp);
       }
   }
  iTxoBind.ProcessProtokol;
  FreeVipInterface(iTxoBind);
  if ( Result ) then {
//    update current SoprHoz;
    mylog('К документу (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) + ') привязана хозоперация "' + HozOper.Name1 +'"');
  }
  else {
      mylog('ОШИБКА. К документу (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) +') НЕ привязана хозоперация "' + HozOper.Name1 +'"');
      exit
    }
}

function MakeHozOperMbp (_TipDoc,_Subtip: word; _cSoprDoc: comp; _cHozOper : comp) : boolean; {
  Result := false;

!  Message('start function MakeHozOperMbp '+_cSoprdoc);
  mylog('start function MakeHozOperMbp _TipDoc = '+ string(_TipDoc) +' _Subtip='+string(_Subtip) +' _cSoprDoc = ' + string(_cSoprDoc,0,0)+' _cHozOper = ' + string(_cHozOper,0,0));

!  If (GetFirst fastfirstrow SoprHoz where ((_TipDoc  == SoprHoz.TipDoc AND _cSoprDoc == SoprHoz.cSoprDoc and _Subtip == SoprHoz.sysoper )) != tsOk) {
!    mylog('не найдена хозоперация (_TipDoc = '+ string(_TipDoc) +' _Subtip='+string(_Subtip) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0)+')');
!    Exit;
!   }

!  Message('start function MakeHozOperMbp step2');

  _loop MbpOut where (( _cSoprdoc == MbpOut.cmove))
  {

    If (GetFirst fastfirstrow SoprHoz where ((_TipDoc  == SoprHoz.TipDoc AND MbpOut.nrec == SoprHoz.cSoprDoc and _Subtip == SoprHoz.sysoper )) != tsOk)
     continue;


  iTxoBind.ResetServer;

  if GetFirst HozOper where ((_cHozOper == HozOper.Nrec)) != tsOk {
    mylog('не найдена хозоперация (_cHozOper = '+ string(_cHozOper,0,0) + ')');
    Exit;
   }
//  Message('start function MakeHozOperMbp step3');
//  update SoprHoz set SoprHoz.cHozOper := _cHozOper;
  SoprHoz.cHozOper := _cHozOper;
  update current SoprHoz;
!  Message('1');
  if ( NullVipRef(iSHoz) )
    GetVipRef(iSHoz, 'SHmanager');

  iSHoz.CheckMagOper(#TSoprHozX(SoprHoz.bufferp), 1);
!  Message('2');
  if iTxoBind.BuildTree(SoprHoz.bufferp)
   {
!  Message('3');
    iTxoBind.SetOperation(0, wOper_ReObor, 0, 0);
!  Message('4');
//    if ( iTxoBind.Bind(SoprHoz.bufferp, 0))
      if iTxoBind.RealizeAndApplyOperations(SoprHoz.bufferp)
       {
!  Message('5');
        Result :=iTxoBind.Apply(SoprHoz.bufferp);
       }
   }
  iTxoBind.ProcessProtokol;
  FreeVipInterface(iTxoBind);
  if ( Result ) then {
   if getfirst MbpMove where (( _cSoprdoc == MbpMove.nrec))=tsok
     update current MbpMove set MBPMove.cRecs[1]:=_cHozOper;
//    update current SoprHoz;
    mylog('К документу (_TipDoc = '+ string(_TipDoc) +' _Subtip='+string(_Subtip) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) + ') привязана хозоперация "' + HozOper.Name1 +'"');
  }
  else {
      mylog('ОШИБКА. К документу (_TipDoc = '+ string(_TipDoc) +' _Subtip='+string(_Subtip) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) +') НЕ привязана хозоперация "' + HozOper.Name1 +'"');
      exit
    }

  }
}

function MakeHozOperMbpActVvod (_TipDoc,_Subtip: word; _cSoprDoc: comp; _cHozOper : comp) : boolean; {
  Result := false;

!  Message('start function MakeHozOperMbp '+_cSoprdoc);
  mylog('start function MakeHozOperMbp _TipDoc = '+ string(_TipDoc) +' _Subtip='+string(_Subtip) +' _cSoprDoc = ' + string(_cSoprDoc,0,0)+' _cHozOper = ' + string(_cHozOper,0,0));

!  If (GetFirst fastfirstrow SoprHoz where ((_TipDoc  == SoprHoz.TipDoc AND _cSoprDoc == SoprHoz.cSoprDoc and _Subtip == SoprHoz.sysoper )) != tsOk) {
!    mylog('не найдена хозоперация (_TipDoc = '+ string(_TipDoc) +' _Subtip='+string(_Subtip) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0)+')');
!    Exit;
!   }

!  Message('start function MakeHozOperMbp step2');

  _loop MbpIn where (( _cSoprdoc == MbpIn.csopr))
  {

    If (GetFirst fastfirstrow SoprHoz where ((_TipDoc  == SoprHoz.TipDoc AND MbpIn.nrec == SoprHoz.cSoprDoc and _Subtip == SoprHoz.sysoper )) != tsOk)
     continue;


  iTxoBind.ResetServer;

  if GetFirst HozOper where ((_cHozOper == HozOper.Nrec)) != tsOk {
    mylog('не найдена хозоперация (_cHozOper = '+ string(_cHozOper,0,0) + ')');
    Exit;
   }
//  Message('start function MakeHozOperMbp step3');
//  update SoprHoz set SoprHoz.cHozOper := _cHozOper;
  SoprHoz.cHozOper := _cHozOper;
  update current SoprHoz;
!  Message('1');
  if ( NullVipRef(iSHoz) )
    GetVipRef(iSHoz, 'SHmanager');

  iSHoz.CheckMagOper(#TSoprHozX(SoprHoz.bufferp), 1);
!  Message('2');
  if iTxoBind.BuildTree(SoprHoz.bufferp)
   {
!  Message('3');
    iTxoBind.SetOperation(0, wOper_ReObor, 0, 0);
!  Message('4');
//    if ( iTxoBind.Bind(SoprHoz.bufferp, 0))
      if iTxoBind.RealizeAndApplyOperations(SoprHoz.bufferp)
       {
!  Message('5');
        Result :=iTxoBind.Apply(SoprHoz.bufferp);
       }
   }
  iTxoBind.ProcessProtokol;
  FreeVipInterface(iTxoBind);
  if ( Result ) then {
   if getfirst MbpMove where (( _cSoprdoc == MbpMove.nrec))=tsok
     update current MbpMove set MBPMove.cRecs[1]:=_cHozOper;
//    update current SoprHoz;
    mylog('К документу (_TipDoc = '+ string(_TipDoc) +' _Subtip='+string(_Subtip) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) + ') привязана хозоперация "' + HozOper.Name1 +'"');
  }
  else {
      mylog('ОШИБКА. К документу (_TipDoc = '+ string(_TipDoc) +' _Subtip='+string(_Subtip) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) +') НЕ привязана хозоперация "' + HozOper.Name1 +'"');
      exit
    }

  }
}


function MakeHozOper (_TipDoc,_SubTip: word; _cSoprDoc: comp; _cHozOper : comp) : boolean; {
//    mylog('//start  MakeHozOper '+String(_TipDoc));
!  Message('//start  MakeHozOper '+String(_TipDoc));

  _try {
    if (_TipDoc>=101 and _TipDoc<=3101)
     {
!  Message('is need MakeHozOper');
      result := MakeHozOperreal(_TipDoc, _cSoprDoc, _cHozOper)
     }
    else
      if (_TipDoc>=12 and _TipDoc<=20)
      {
!  Message('is need MakeHozOperMbp');
//        mylog('is need MakeHozOperMbp');
        Case _TipDoc of
         19: result := MakeHozOperMbp(_TipDoc, _SubTip,_cSoprDoc, _cHozOper);
         12: result := MakeHozOperMbpActVvod(_TipDoc, _SubTip,_cSoprDoc, _cHozOper);
        end;
      }
    if not result
     _raise  ExMakeHozOper;
  }
  _except
    on ExMakeHozOper:
      mylog('ОШИБКА ПРИВЯЗКИ ТХО. К документу (_TipDoc = '+ string(_TipDoc) + ' ' + string(_cSoprDoc,0,0)+')');
  _finally
      mylog('end function MakeHozOper');
}

function DeleteHozOper (_TipDoc: word; _cSoprDoc: comp) : boolean; {

  If (GetFirst fastfirstrow SoprHoz where ((_TipDoc  == SoprHoz.TipDoc AND _cSoprDoc == SoprHoz.cSoprDoc)) != tsOk) {
    mylog('не найдена хозоперация (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0)+')');
    Exit;
   }

  iTxoBind.ResetServer;
  iTxoBind.BuildTree(SoprHoz.bufferp);
  Result := iTxoBind.UnBind(SoprHoz.bufferp);
  iTxoBind.ProcessProtokol;
  FreeVipInterface(iTxoBind);
  if ( Result ) then {
    update current SoprHoz;
    mylog('От документа (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) + ') отвязана хозоперация "' + HozOper.Name1 +'"');
  }
  else {
      mylog('ОШИБКА. От документа (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) + ') НЕ отвязана хозоперация "' + HozOper.Name1 +'"');
      exit
    }

}

function DeleteHozOperMbp (_TipDoc,_Subtip: word; _cSoprDoc: comp) : boolean; {

  if _TipDoc=19
  {
    _loop MbpOut where (( _cSoprdoc == MbpOut.cmove))
    {
  
    If (GetFirst fastfirstrow SoprHoz where ((_TipDoc  == SoprHoz.TipDoc AND MbpOut.nrec == SoprHoz.cSoprDoc and _Subtip == SoprHoz.sysoper)) != tsOk) {
      continue;
     }
  
    iTxoBind.ResetServer;
    iTxoBind.BuildTree(SoprHoz.bufferp);
    Result := iTxoBind.UnBind(SoprHoz.bufferp);
    iTxoBind.ProcessProtokol;
    FreeVipInterface(iTxoBind);
    if ( Result ) then {
      update current SoprHoz;
      mylog('От документа (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) + ') отвязана хозоперация "' + HozOper.Name1 +'"');
    }
    else {
        mylog('ОШИБКА. От документа (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) + ') НЕ отвязана хозоперация "' + HozOper.Name1 +'"');
        exit
      }
  
    }
!     if getfirst MbpMove where (( _cSoprdoc == MbpMove.nrec))=tsok
!       update current MbpMove set MBPMove.cRecs[1]:=0h;
  }

  if (_TipDoc=12 and _subtip=1)
  {
     _loop MbpIn where (( _cSoprdoc == MbpIn.csopr))
    {
  
    If (GetFirst fastfirstrow SoprHoz where ((_TipDoc  == SoprHoz.TipDoc AND MbpIn.nrec == SoprHoz.cSoprDoc and _Subtip == SoprHoz.sysoper)) != tsOk) {
      continue;
     }
  
    iTxoBind.ResetServer;
    iTxoBind.BuildTree(SoprHoz.bufferp);
    Result := iTxoBind.UnBind(SoprHoz.bufferp);
    iTxoBind.ProcessProtokol;
    FreeVipInterface(iTxoBind);
    if ( Result ) then {
      update current SoprHoz;
      mylog('От документа (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) + ') отвязана хозоперация "' + HozOper.Name1 +'"');
!     if getfirst MbpMove where (( _cSoprdoc == MbpMove.nrec))=tsok
!       update current MbpMove set MBPMove.cRecs[1]:=0h;
    }
    else {
        mylog('ОШИБКА. От документа (_TipDoc = '+ string(_TipDoc) + ' _cSoprDoc = ' + string(_cSoprDoc,0,0) + ') НЕ отвязана хозоперация "' + HozOper.Name1 +'"');
        exit
      }
  
    }
  }

}



end.
