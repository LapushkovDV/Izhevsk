Create View
    var _cviodoper:comp;
        namewin:string;
  as select
   if(isvalid(tnKauVid),KauVid.name,'Не определен') (fieldname=fvidOper)  
  from Spkau KauVid
   where ((
            katsopr.cizd == KauVid.nrec
         ))
;

Create View Quality
 select * from
 KatSopr CardBrak;

#include onCfgObjectsRequired.vpp
#include funWin.vpp

procedure InitInter(_NRecObj : comp; _vTypSop : word);
{
  inherited::InitInter(_NRecObj,_vTypSop);

//  Message('Call InitInter ='+(oDATFS<>NullRef))	

  if (TypeSopr=501 and oDATFS=NullRef)
  { oDATFS:=GP_DocFieldsStateService::GetDocByName('Nakl501');
    // обьект проверки кэшируется при повторном открытии - надо загнать туда 0 статусу
    oDATFS.CalcAndApplyFieldsState(0,cfsGetCurrentContainerSelf);
    BindEvent(onCfgObjectsRequired, oDATFS.Event_onCfgObjectsRequired);
  }

}

Procedure SetFieldKatSopr_Buh_dOpr(How_Edit:word; scr1:LongInt; scr2:LongInt; WhereAre:Boolean);
{
!  Message('Call SetFieldKatSopr_Buh_dOpr');	

  var l: tPtr = cfsGetCurrentContainerSelf;
  inherited::SetFieldKatSopr_Buh_dOpr(How_Edit, scr1, scr2, WhereAre);

//  Message('SetFieldKatSopr_Buh_dOpr step 1'+'|'+(oDATFS<>NullRef));	
!  if (oDATFS<>NullRef)
!    if KatSopr.cIzd<>0h
!    oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,l);
      if (oDATFS<>NullRef) {
        if katsopr.cIzd = 0h {
         var _cIzd : comp =  iDatFS_base.runwindowgetsubtip(501);
        set katsopr.cIzd := _cIzd;
        updatetable;
        iDatFS_base.SetDefault(KatSopr.cIzd, katsopr.nrec);
        }
!        ix.SetNaklTip(501)
!        ix.SetNaklTitle(SetNeWinTitle(namewin));
!        iHndNew.DefaultEditWindow(KatSopr.nRec);
!        FreeVipInterface(ix);
        oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
//        SetWindowTitle(EDITSOPR,SetNeWinTitle(namewin));
      }
//  cfsSetProp('M_UP::IMNFINTRF',cfpTitle,'Редактирование блаблабла'); 
}

