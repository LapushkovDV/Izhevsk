#include GP_DATFS_Base.vih
#include GP_DocFieldsStateService.vih
#include auto_MAKE_TXO.vih

#component "F_MBP"

Alter Interface Spis_MBP;

  var oDATFS: GP_ObjDocAbleTuneFieldsState;
  var iDatFS_base : GP_DATFS_Base;
  var iauto_MAKE_TXO : auto_MAKE_TXO;

  Create view
   var
      namewin:string;
   as select
    if(isvalid(tnKauVid),KauVid.name,'Не определен') (fieldname=fvidOper)  
   from Spkau KauVid
    where ((
            Mbpmove.cnd == KauVid.nrec
          ))
  ;

procedure timelog(_str : string); {
#ifdef _DEBUG_DocFieldsStateService_
  iDatFS_base.enablelog;
  iDatFS_base.MyLog(_str);
#endif
}

#include onCfgObjectsRequired.vpp
#include funWin.vpp

  Window SpisDocWindow 'Акт на списание' EscClose;
    HandleEvent

     CmInit:
      {
        Inherited::HandleEvent(CmInit);
        if (oDATFS<>NullRef) {
         if Mbpmove.cnd = 0h {
           var _cIzd : comp =  iDatFS_base.runwindowgetsubtip(if(pTypeDoc=10,737,if(pSubType=0,733,7331)));
           set Mbpmove.cnd := _cIzd;
!           if Isnew
!             insert current Mbpmove;
!           else
!             update current Mbpmove;
//           Message('before UpdateTable '+Mbpmove.cnd);
           if (not UpdateTable) {}
//             Message('not UpdateTable '+Mbpmove.cnd);

//           Message('1 need update = '+_cIzd+'|'+Mbpmove.cnd);
           if Mbpmove.cnd=0
           {
//             Message('2 need update = '+Mbpmove.cnd);
             update current Mbpmove set Mbpmove.cnd := _cIzd;
           }
           iDatFS_base.SetDefault(Mbpmove.cnd, Mbpmove.nrec);
         }
         oDATFS.CalcAndApplyFieldsState(Mbpmove.cnd,cfsGetCurrentContainerSelf);
//       SetWindowTitle(EDITSOPR,SetNeWinTitle('EDITSOPR'));
         SetWindowTitle(SpisDocWindow,SetNeWinTitle(namewin));
        }
      }

      cmPositionChanged:
      {
        Inherited::HandleEvent(cmPositionChanged);

!        if pTypeDoc=5
        {
          if (oDATFS <> NullRef)
            oDATFS.CalcAndApplyFieldsState(Mbpmove.cnd,cfsGetCurrentContainerSelf);
        }
      }
cmValue70:
{
  UpdateTable;
  RunInterface('AVAZ_Logistics::ImpExcelToDocMBP',MBPMove.Nrec);
}

cmValue71:
{
  UpdateTable;
  RunInterface('AVAZ_Logistics::MBP_PrnAktSpis',MBPMove.Nrec);
}

    end;
  end;

  HandleEvent
  CmInit:
  {
    if pTypeDoc=5
    {
      oDATFS := GP_DocFieldsStateService::GetDocByName(if(pSubType=0,'Spis_MBP_5','Spis_MBP_51'));
      oDATFS.CalcAndApplyFieldsState(0, cfsGetCurrentContainerSelf);
      BindEvent(onCfgObjectsRequired, oDATFS.Event_onCfgObjectsRequired);
    }
    else
     if pTypeDoc=10
    {
      oDATFS := GP_DocFieldsStateService::GetDocByName('Spis_MBP_10');
      oDATFS.CalcAndApplyFieldsState(0, cfsGetCurrentContainerSelf);
      BindEvent(onCfgObjectsRequired, oDATFS.Event_onCfgObjectsRequired);
    }

     case Inherited::HandleEvent(cmInit) of
      heAbort :  Abort;
      heStop  :  Exit;
     end;
    if (pTypeDoc=5 or pTypeDoc=10)
      cfsGetProp('SpisDocWindow','Title',namewin); 
  }

   cmMakeOrder : {
     if (oDATFS<>NullRef) {
       var _boOverload : boolean = oDATFS.isOverLoadButton(Mbpmove.cnd,cfsGetCurrentContainerSelf,cmMakeOrder);
        if _boOverload {
          var _TypeCpNrec : word = 2737;

        /*подготовим массив записей для проверки атрибутов*/
        var _arAtr : arAttr;
        SetLimit(_arAtr,0);
        SetLimit(_arAtr,1);
        var _i : longint = 1;
        _arAtr[_i].nrec := MbpMove.nrec;
        _arAtr[_i].tabl := 2003;
        //timelog('_i = '+ _i + '  _arAtr[_i].nrec = ' + string(_arAtr[_i].nrec) + ' _arAtr[_i].tabl = ' +_arAtr[_i].tabl);
        PushPos(#mbpout)
        _loop mbpout {
          _i++;
          setlimit(_arAtr, getlimit(_arAtr)+1);
          _arAtr[_i].nrec := mbpout.nrec;
          _arAtr[_i].tabl := 2002;
          // timelog('_i = '+ _i + '  _arAtr[_i].nrec = ' + string(_arAtr[_i].nrec) + ' _arAtr[_i].tabl = ' +_arAtr[_i].tabl);
        }
        PopPos(#mbpout)
        //timelog('getlimit(_arAtr) = ' + getlimit(_arAtr));
        /*end подготовим массив записей для проверки атрибутов*/
        if not oDATFS.CheckReqrAtr(_arAtr, Mbpmove.cnd) { // проверить заполненность атрибутов
         ReReadRecord(tnMbpMove);
         ReReadRecord(tnmbpout);
        //message('_boOverload!');
          abort; exit;
        }

          oDATFS.PushButton(Mbpmove.cnd,cfsGetCurrentContainerSelf,cmMakeOrder, _TypeCpNrec, Mbpmove.nrec, oDATFS);
          SelectableButton(CurFormatInArea(SpisScreen), cmValue5, True);
          ReReadRecord(tnMbpmove);
          ReReadRecord(tnMbpOut);
        //message('_boOverload!');
          abort; exit;
        }
      }
     inherited::handleevent(cmMakeOrder)
 }

   cmValue5:{
     iauto_MAKE_TXO.DeleteHozOperMbp(19,0,mbpmove.nrec);  //Иначе рантайм. Свадивается что то в Постгри, если к моменту отмены операции разнесена Хозоперация
     inherited::handleevent(cmValue5);
     if MBPMove.cRecs[1]>0
       update current MbpMove set MBPMove.cRecs[1]:=0h;
   }

cmValue70:
{
  UpdateTable;
  RunInterface('AVAZ_Logistics::ImpExcelToDocMBP',MBPMove.Nrec);
}

cmValue71:
{
  UpdateTable;
  RunInterface('AVAZ_Logistics::MBP_PrnAktSpis',MBPMove.Nrec);
}

  end;
end.

