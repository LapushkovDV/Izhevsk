#include SchfFuncs_Ext.vih
#include SchFactFunctions.vih

#Component "L_SoprDoc"

Interface SchfFuncs_EXt;

  Create view
  ;

!function InitPos_KatSopr(aKS : Comp) : Boolean;
!{
!  Set cKS := aKS;
!  Result := (GetFirst KatSopr = tsOK);
!}

  procedure MakeSchFact_EXt(aKS : Comp);
  {
// Создание или редактирование СФ
   if not InitPos_KatSopr(aKS)
     Exit;

   if IsExistSchFact
   {
     RunSchFact(KatSopr.NRec, 2);
     RereadRecord(tnKatSopr);
     Exit;
   }
  else
   {
     if (wGetTune('Nalog.CreateWithFullAccessKatSopr') = 1)
      if (not oOtkatToOldState.OtkatToOldState(KatSopr.NRec, 0, False, False, False, 1, coKatSopr, cmPick))
      {                                                                                                    
         ShowTune('По данному документу Вам запрещено создавать документы для учета НДС', 'Nalog.CreateWithFullAccessKatSopr');
         Exit;
      }
   }

    _try
    {
      var iSF : viSchFunc;

      if (not GetVipInterface(iSF))
        _raise ExSchFactNotLoaded;

      _try
      {
        if (not iSF.DoInit(GetDirectSchFact(KatSopr.NRec)))
          _raise ExSchFactNotInited;

        if (Message('Создать новый документ для учета НДС для данного документа?', Confirmation + YesNo) = cmYes)
        {
          if IsValid(#BaseDoc)
          {
            if (not ((KatSopr.VidSopr = cgDoc_0111) and (BaseDoc.VidDoc = 520)) and
                not ((KatSopr.VidSopr = cgDoc_0211) and (BaseDoc.VidDoc = 102)))
              if (not KatSoprToBaseDoc_PlusRemont)
              {
                Message('Документ связан с ДО другого типа.'#13
                      + 'В этом случае документ для учета НДС должен формироваться'#13
                      + 'по хозоперации и рассматриваться как оплата.', CancelButton);
               _dofinally;
              }
          }

          if (GetFirst SpSopr != tsOK)
          {
            Message('Документ не оформлен...', CancelButton);
            _dofinally;
          }

          if (iSF.CreateSFbyKatSopr(KatSopr.NRec))
          {
            RereadRecord(tnKatSopr);

            if (GetFirst SchFact = tsOk)
            {
!              if (Message('Создан документ для учета НДС №' + SchFact.Num + '.'#13 +
!                          'Редактировать?', Confirmation + YesNo) = cmYes)
!                RunSchFact(KatSopr.NRec, 2);

               oSDfuns.UpdateSoprHoz(KatSopr.Buffer);
            }
            else
              _raise ExSchFactNotCreated;
          }
          else
            _raise ExSchFactNotCreated;
        }
      }
      _except
        on ExSchFactNotCreated : Message('Документ для учета НДС не создан'                               , Warning+OkButton);
        on ExSchFactNotInited  : Message('Не проинициализирован модуль обработки документов для учета НДС', Warning+OkButton);
      _finally
        FreeVipInterface(iSF);
    } // _try
    _except
        on ExSchFactNotLoaded  : Message('Не загружен модуль обработки документов для учета НДС'          , Warning+OkButton);

  }

 HandleEvent
   CmInit :{
               if (inherited :: HandleEvent(cmInit) = heAbort)
               {
                 Abort; Exit;
               }
           }
   CmOnVipLoad :{
               if (inherited :: HandleEvent(CmOnVipLoad) = heAbort)
               {
                 Abort; Exit;
               }
           }
  end;
end.
