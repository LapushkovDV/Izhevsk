/*************************************************************************************************\
* Наименование: Реализация класса GP_DATFS_Base                                                   *
*               "Супер класс функционала настройки доступа к полям для конкретного документа"     *
* Контур/Модуль: *                                                                                *
* Примечание: взято с проекта НПО ЭНЕРГОМАШ                                                       *
*                                                                                                 *
\*************************************************************************************************/
#component "GP_Logistics"

#include GP_DocFields.vih
#include GP_DocFieldsStateService.vih

#include GP_DATFS_Base.vih
interface GP_DATFS_Base;

var mFields:GP_ObjDocFields(GP_DocFields) New;
    mGroup:string;
    mTitle:string;
    mName:string[127];
    mVidDoc:word=0;
    mService:GP_DocFieldsStateService;
    mUseSkip:boolean = true;

function CalcFieldsState(cStatus:comp):boolean; //Рассчитать состояние полей для текущего пользователя
{
  result:=mService.CalcFieldsState(GP_ObjDocAbleTuneFieldsState(cfsGetObjInfo),cStatus);
}

function ApplyFieldsState(CurContainer:longint):boolean;
{
  result:=mService.ApplyFieldsState(mFields,CurContainer,mUseSkip);
}

function CalcAndApplyFieldsState(cStatus:comp;CurContainer:longint):boolean;//Рассчитать состояние полей и применить к документу
{
  result:=CalcFieldsState(cStatus);
  if (not result) exit;

  result:=ApplyFieldsState(CurContainer);
}

procedure SetCheckProtectStateEnabled(pEnabled: boolean);
{
  mService.SetCheckProtectStateEnabled(pEnabled);
}

// получить разрешение на редактирование поля
// var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,'#'+GetIfcCurrentFieldName);
function CanEditField(CurContainer:longint;ControlName:string):boolean;
{
  result:=mService.CanEditField(mFields,CurContainer,ControlName);
}

function CanEditField_Status(cStatus:comp;CurContainer:longint;ControlName:string):boolean;
{
  result:=CalcFieldsState(cStatus);
  if (not result)
  { Result:=true;
    exit;
  }
  result:=CanEditField(CurContainer,ControlName);
}

//-------- #3954 ------------------
function CanEditRazdel(CurContainer:longint;ControlName:string;Razdel:string;_cStatus:comp):boolean; //Доступно ли редактирование раздела
{ Result:=mService.CanEditRazdel(CurContainer,mName,ControlName,Razdel,_cStatus);

} //function CanEditRazdel(CurContainer:longint;ControlName:string;Razdel:string):boolean; //Доступно ли редактирование раздела
function CanInsRazdel (CurContainer:longint;ControlName:string;Razdel:string;_cStatus:comp):boolean; //Доступна ли вставка записей раздела
{ Result:=mService.CanInsRazdel(CurContainer,mName,ControlName,Razdel,_cStatus);

} //function CanEditRazdel(CurContainer:longint;ControlName:string;Razdel:string):boolean; //Доступно ли редактирование раздела
function CanDelRazdel (CurContainer:longint;ControlName:string;Razdel:string;_cStatus:comp):boolean; //Доступна ли удаление записей раздела
{ Result:=mService.CanDelRazdel(CurContainer,mName,ControlName,Razdel,_cStatus);

} //function CanEditRazdel(CurContainer:longint;ControlName:string;Razdel:string):boolean; //Доступно ли редактирование раздела

property Fields:GP_ObjDocFields absolute mFields read write;
property Group:string absolute mGroup read;
property Title:string absolute mTitle read;
property Name:string[127] absolute mName read;
property VidDoc:word absolute mVidDoc read;

end.
