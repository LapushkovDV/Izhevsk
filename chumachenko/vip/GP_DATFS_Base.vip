#component "GP_Logistics"

#include GP_DocFields.vih
#include GP_DocFieldsStateService.vih

#include GP_DATFS_Base.vih
interface GP_DATFS_Base;

var mFields:GP_ObjDocFields(GP_DocFields) New;
    mGroup:string;
    mTitle:string;
    mName:string[127];
    mVidDoc:word=0;
    mService:GP_DocFieldsStateService;
    mUseSkip:boolean = true;
    _log_OUT : string;
    _needlog : boolean = false;
    _kodkau : word;
    _cNode : comp;
create view
from katkau
   , spkau subtip_vaz
   , spkau spkau_br
   , GP_TuneDocFields
   , attrnam
   , attrval
where ((_kodkau == spkau_br.kodgrkau
     and _cNode == spkau_br.cNode))
;

Procedure SetDefault(cSubType:comp; _cRec : comp); { // установить значения по умолчанию
  mService.SetDefault(cSubType,_cRec)
}

function getkaukod_subtip( _subtipVAZ : string): word; cacheable;{
 result := 0;
 // тут надо переделать на настройку наверное...
 // подумайте сами
 if(getfirst katkau where katkau.name = _subtipVAZ) = tsOK {
   result := KATKAU.KODGROUP;
 }
}
window wgetsubtip 'Выбор вида операции', doaccept;
browse brgetsubtip;
 table spkau_br;
 fields
  spkau_br.code 'код':[6],Protect;
  spkau_br.name 'Наименование':[20],Protect;
end;
end;
windowevent wgetsubtip;
cmdone: {
 closewindowex(wgetsubtip,cmdefault);
}
end;

function runwindowgetsubtip(__viddoc : word) : comp; {
  result := 0h;

  set _kodkau := getkaukod_subtip(co_subtipVAZ);

  if getfirst subtip_vaz where ((_kodkau == subtip_vaz.kodgrkau
                            and __viddoc == subtip_vaz.code
                                  and 0h == subtip_vaz.CNODE (noindex) )) <> tsOK {
    message('В пользовательской аналитике "'+co_subtipVAZ+'" на найден элемент с кодом '+__viddoc+' без родителя', error);
    MyLog('В пользовательской аналитике "'+co_subtipVAZ+'" на найден элемент с кодом '+__viddoc+' без родителя');
    exit;
   }
 set _cNode := subtip_vaz.nrec;
 if runwindowModal(wgetsubtip) = cmdefault then result := spkau_br.nrec;
}

function getlastsymbol(_str : string) : string; {
  result := substr(_str,length(_str),1);
}

Function GenerateNewFile: string; {
  var _outdir : string = GetStringParameter('Files','OutputFilesDirectory',0);
 result := _outdir + if(getlastsymbol(_outdir) = '\','','\') +
       + 'GP_DATFS_'+DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS-SSS');
}

Procedure MyLog(_str: string);{
  if not _needlog then exit;
  _str := DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS') + ': '+_str ; //+ ''#13'';
  logstrtofile(_log_OUT, _str);
  //HttpConnect_AddValueToLongString(_serviceLog, _str, _LongStringLog);
}

procedure disableLog; {
  if _needlog = false then exit;
/*
  HttpConnect_DestroyLongString(_serviceLog, _LongStringLog);
  HttpConnect_Free(_serviceLog);
  set _needlog := false;
*/
}

procedure enableLog; {
   if _needlog = true then exit;
   _log_OUT := GenerateNewFile+'.log';
   set _needlog := true;

/*   disableLog;
  _serviceLog    := HttpConnect_CreateEx('http://ya.ru', '', '', true);
  _LongStringLog := HttpConnect_CreateLongString(_serviceLog);
  set _needlog := true;
*/
}

function GetLogFile : string; {
  var _log_OUT : string = GenerateNewFile+'.log';
  //HttpConnect_SaveToFileEx(_serviceLog, _LongStringLog, _log_OUT, cpOEMCP, false); // cpUTF8 | cpOEMCP | cpACP | 0-CP866
  result := _log_OUT;
}


function CalcFieldsState(cSubType:comp):boolean; //Рассчитать состояние полей для текущего пользователя
{
#IFDEF _DEBUG_DocFieldsStateService_
  enablelog;
  MyLog('CalcAndApplyFieldsState CalcFieldsState='+ string(cSubType,0,0));
#endif

  result:=mService.CalcFieldsState(GP_ObjDocAbleTuneFieldsState(self),cSubType);
}

function ApplyFieldsState(CurContainer:tptr):boolean;
{
  result:=mService.ApplyFieldsState(mFields,CurContainer,mUseSkip);
}

function FieldsCheckRequired(_cfgFName: string) : boolean; {

#IFDEF _DEBUG_DocFieldsStateService_
  enablelog;
  MyLog('FieldsCheckRequired _cfgFName ='+ _cfgFName);
#endif

  result := Event_onCfgObjectsRequired(_cfgFName);
}

function isOverLoadButton(cSubType:comp;CurContainer:tptr; _command: longint):boolean; { //проверить перекрыта ли кнопка
  result := mService.isButtonOverLoad(mFields, CurContainer, _command);
}

function PushButton(cSubType:comp;CurContainer:tptr; _command: longint; _TypeCpNrec : word; _cRec : comp; oDATFS : GP_ObjDocAbleTuneFieldsState ):boolean; {//выполнить перекрытую кнопку
  result := mService.ButtonPush(mFields, CurContainer, _command, _TypeCpNrec, _cRec, oDATFS);
}

function CheckReqrAtr(_arAtr : arAttr; _cizd : comp) : boolean; {
  result := true;
  var i : longint = 0;
  var msg : string = '';

#IFDEF _DEBUG_DocFieldsStateService_
  enablelog;
  MyLog('function CheckReqrAtr _cizd = '+ string(_cizd,0,0));
#endif


  for( i := 1; i <= getlimit(_arAtr); i ++ ) {
    var _wTable : word = _arAtr[i].tabl;
#IFDEF _DEBUG_DocFieldsStateService_
  enablelog;
  MyLog('function CheckReqrAtr for i = '+ string(i) + 'getlimit(_arAtr) = '+getlimit(_arAtr)+' _wTable = '+ string(_wTable) + '  _arAtr[i].nrec = ' +string( _arAtr[i].nrec ));
#endif

   if _wTable <> 0
   _loop GP_TuneDocFields where ((//mFields.Name == GP_TuneDocFields.DOCNAME
                                        _cizd == GP_TuneDocFields.CSUBTIP (noindex)
                                     and true == GP_TuneDocFields.isUsed (noindex)
                                  and _wTable == GP_TuneDocFields.wTable (noindex) )) {

#IFDEF _DEBUG_DocFieldsStateService_
  enablelog;
  MyLog('function CheckReqrAtr _loop GP_TuneDocFields GP_TuneDocFields.DocFieldname = '+ GP_TuneDocFields.DocFieldname + ' GP_TuneDocFields.state and 1000b = ' + (GP_TuneDocFields.state and 1000b));
#endif

      if(GP_TuneDocFields.state and 0100b) <> 0 { // надо проверить заполненность обязательных полей

      if getfirst attrnam where ((_wTable == attrnam.wtable and GP_TuneDocFields.DocFieldname == attrnam.name)) = tsOK {
#IFDEF _DEBUG_DocFieldsStateService_
  enablelog;
  MyLog('function CheckReqrAtr _loop GP_TuneDocFields getfirst attrnam where ((_wTable == attrnam.wtable and GP_TuneDocFields.DocFieldname == attrnam.name)) = tsOK  attrnam.nrec=' + string(attrnam.nrec));
#endif

        if getfirst attrval where ((_wTable == attrval.wTable
                         and _arAtr[i].nrec == attrval.cRec
                           and attrnam.nrec == attrval.cAttrnam)) = tsOK {
#IFDEF _DEBUG_DocFieldsStateService_
  enablelog;
  MyLog('function CheckReqrAtr _loop GP_TuneDocFields if getfirst attrval where ((_wTable == attrval.wTable = tsOK  attrval.nrec'+ string(attrval.nrec));
#endif

           if   attrval.VSTRING =''
            and attrval.VDOUBLE = 0
            and attrval.VDATE = to_date(0,0,0)
            and attrval.VTIME = time(0,0,0,0)
            and attrval.VCOMP = 0h
            and attrval.VLONGINT = 0 {
              result := false;
//              message('Не заполнен внешний атрибут "'+GP_TuneDocFields.DocFieldname+'"');
              Msg += ''#13 +GP_TuneDocFields.DocFieldname ;
!              exit;
           }
        } else {
        result := false;
              Msg += ''#13 +GP_TuneDocFields.DocFieldname ;
!        message('Не заполнен внешний атрибут "'+GP_TuneDocFields.DocFieldname+'"');
!        exit;
      }

      }
     }
   }
  }
  if (not result)
    message('Не заполнены обязательные поля ' + Msg)
}

function CalcAndApplyFieldsState(cSubType:comp;CurContainer:tptr):boolean;//Рассчитать состояние полей и применить к документу
{
#IFDEF _DEBUG_DocFieldsStateService_
  enablelog;
  MyLog('CalcAndApplyFieldsState cSubType='+ string(cSubType,0,0));
#endif

  if mService.anotherSubTip(cSubType) then mService.ApplyFieldsState(mFields,CurContainer,mUseSkip,1);

  result:=CalcFieldsState(cSubType);
  if (not result) exit;

  result:=ApplyFieldsState(CurContainer);
}

procedure SetCheckProtectStateEnabled(pEnabled: boolean);
{
  mService.SetCheckProtectStateEnabled(pEnabled);
}

// получить разрешение на редактирование поля
// var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,'#'+GetIfcCurrentFieldName);
function CanEditField(CurContainer:tptr;ControlName:string):boolean;
{
  result:=mService.CanEditField(mFields,CurContainer,ControlName);
}

function CanEditField_Status(cSubType:comp;CurContainer:tptr;ControlName:string):boolean;
{
  result:=CalcFieldsState(cSubType);
  if (not result)
  { Result:=true;
    exit;
  }
  result:=CanEditField(CurContainer,ControlName);
}

