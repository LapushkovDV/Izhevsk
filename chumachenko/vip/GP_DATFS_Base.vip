function CanEditRazdel(CurContainer:tptr;ControlName:string;Razdel:string;_cSubType:comp):boolean; //Доступно ли редактирование раздела
{ Result:=mService.CanEditRazdel(CurContainer,mName,ControlName,Razdel,_cSubType);

} //function CanEditRazdel(CurContainer:tptr;ControlName:string;Razdel:string):boolean; //Доступно ли редактирование раздела
function CanInsRazdel (CurContainer:tptr;ControlName:string;Razdel:string;_cSubType:comp):boolean; //Доступна ли вставка записей раздела
{ Result:=mService.CanInsRazdel(CurContainer,mName,ControlName,Razdel,_cSubType);

} //function CanEditRazdel(CurContainer:tptr;ControlName:string;Razdel:string):boolean; //Доступно ли редактирование раздела
function CanDelRazdel (CurContainer:tptr;ControlName:string;Razdel:string;_cSubType:comp):boolean; //Доступна ли удаление записей раздела
{ Result:=mService.CanDelRazdel(CurContainer,mName,ControlName,Razdel,_cSubType);

} //function CanEditRazdel(CurContainer:tptr;ControlName:string;Razdel:string):boolean; //Доступно ли редактирование раздела

property Fields:GP_ObjDocFields absolute mFields read write;
property Group:string absolute mGroup read;
property Title:string absolute mTitle read;
property Name:string[127] absolute mName read;
property VidDoc:word absolute mVidDoc read;

end.
