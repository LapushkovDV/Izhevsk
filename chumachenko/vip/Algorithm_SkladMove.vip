#include SoprOrdB.vih
#include CreateOrder.vih
#include MakeReclOrder.vih
#include Spis_Mbp_MakeOrder.vih
#include Move_Mbp_MakeOrder.vih

#define OBJINT_ALGORITM
#include objintpl.vin

#component "M_MnPlan"
VipInterface Algoritm_SkladMove implements oAlgoritm_Sys;
Interface Algoritm_SkladMove;
var oMakeOrder : MakeOrder;
//var oSoprOrdB: iSoprOrdB;
#include CreateOrder.var
var fh : longint;

create view
var
 cWorkFormPl,cdoc: Comp;
 wEvnCode: Word;
 sEvnLine: String;
 DatOper: date;

from
  FormPl(ReadOnly)
 ,katsopr
where ((
  //'настройка алгоритма
  cWorkFormPl         == FormPl.NRec
  and cdoc  == Katsopr.nrec
))
 ;

exception ExUser1, ExUser2;

#include MakeOptionsByDefines.vpp

Function GetNum : word;
{
  GetNum := 6601;
}

function GetName : string;
{
  GetName := 'Проведение накладных по складу';
}

Function GetMemo ( st:oSteckCommonString ) : Boolean;
{
  GetMemo := True;

  st.push('Данный алгритм поддеривает накладные 101,201,204,630');
}

Function GetNameInter : String;
{
  GetNameInter := 'Algoritm_SkladMove' ;
}

Function GetNameInterPr : String;
{
  GetNameInterPr := 'AlgoritmSetup_SkladMove' ;
}

//=======================================================================
// 'ИНИЦИАЛИЗАЦИЯ АЛГОРИТМА'
//-----------------------------------------------------------------------
//'коды ситуаций - до 49 включительно
Function InitInter( Var pt:TRecAcc ) : Boolean;
{
  InitInter := False;

_try
{
 pt.Visua    := Word(0);
 pt.MessEnd  := Word(0);

  cWorkFormPl := pt.cFormPl;
  if (GetFirst FormPl <> tsOk)
  {
   wEvnCode := 1;
   sEvnLine := 'Пользовательский алгоритм не найден (скорее всего, он был удален)';
   _raise ExUser2;
  }

 InitInter := True;
}  //'_try

_except
 on ExUser1:
  pt.Error := 1;

 on ExUser2:
 {
  Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally
{
 //'
}
}

//=======================================================================
// 'ЗАВЕРШЕНИЕ РАБОТЫ С ИНТЕРФЕЙСОМ'
//-----------------------------------------------------------------------
Function DoneInter( Var pt:TRecAcc ) : Boolean;
{
 #__UNUSED__(pt)
 DoneInter := True;
}

/*
 Function CanMakeOrder : date;
 {
  CanMakeOrder:=katsopr.dsopr;
  oSoprOrdB.CheckSoprOrdB(KatSopr.nRec, katsopr.cpodrto, katsopr.cmolto, true, true, TRUE, false, boGetTune('DOC.BUY.AUTOMakePartyKN'), 0);
 }

 */
//=======================================================================
Function RunInter( wflag:Word; Var pt:TRecAcc ) : Boolean;
{
  #__UNUSED__(wflag)

!  Message('Call Algoritm_SkladMove ='+pt.TypeCpNrec);

_try {
  RunInter := False;

  if (pt.Visua = 0)
    StartNewVisual(vtRotateVisual, vfTimer+vfBreak+vfConfirm,GetName+'...', 0);

//  Message('000 pt.cpnRec='+pt.cpnRec+'/'+pt.TypeCpNrec);
  cdoc:=pt.cpnRec;
  if (pt.TypeCpNrec<>2737 and pt.TypeCpNrec<>2738)
   if getfirst katsopr<>tsok
     exit;

  DatOper:=katsopr.dsopr;

  if (pt.TypeCpNrec<>2737 and pt.TypeCpNrec<>2738)
    if (RunDialog(GetDatMoveSkl,DatOper) = cmCancel)
      exit;
   
//  Message('step 2');

  if (pt.TypeCpNrec<>2737 and pt.TypeCpNrec<>2738)
    case (KatSopr.VidSopr) of
     101, 204, 630, 611, 632:
      {
//         Message('Call Algoritm_SkladMove 1');
         oCreateOrder.CreateOrderAllVidSopr(KatSopr.nRec, KatSopr.VidSopr, DatOper, True, True, True,
                                          if (True, 0, OPT_HIDE_REQUESTS_TO_USER),
                                            0, if(True, 0, WMODE_BATCH), 2 + if(True, 0, 32)+8, 0);

      } // 201, 204, 630
      201, 601, 602:
      {
         oCreateOrder.CreateOrderAllVidSopr(KatSopr.nRec, KatSopr.VidSopr, DatOper, True, True, True,
                                           if (True, 0, OPT_HIDE_REQUESTS_TO_USER),
                                           0, if(True, 0, WMODE_BATCH), 2 + if(True, 0, 32)+8, 0);
      } // 101
      600:
      {
        RunInterface('CallMake', katsopr.vidsopr, katsopr.nrec, 1, 0, 0,DatOper);
      }
    end;


   if (pt.TypeCpNrec=2737)
    {
!      Message('is 2737');
      var oMakeOrder_SpisMbp : Spis_MBP_MakeORder;
      oMakeOrder_SpisMbp.SetPos(cdoc);
!     Message('is 2737 2');
    }
   else
   if (pt.TypeCpNrec=2738)
    {
//      Message('is 2737');
      var oMakeOrder_MoveMbp : Move_MBP_MakeORder;
      oMakeOrder_MoveMbp.SetPos(cdoc);
    }




/*
  BindEvent(CanMakeOrder,oMakeOrder.CanMakeOrder);
  if oMakeOrder.MakePrihOrder(katsopr.nrec,false,true,true,0,0,32+128)
  {
//    Message('yesorder=101');
    RunInter := True;
  }
  UnBindEvent(CanMakeOrder, oMakeOrder.CanMakeOrder);
*/
}  //'_try

_except
 on ExUser1: pt.Error := 1;

 on ExUser2:{
   Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally {
  if (pt.Visua = 0) StopVisual('', 0);

  DoneInter(pt);
}
}
end.

GetDatMoveSkl DIALOG
Fields
  myd ('Введите дату',hcD_GetFormNa,scGalDialPick): date [,'DD/MM/YYYY'];
Buttons
  cmOk,Default, , 'Ввод' ,hcD_GetFormNa,scGalDial;
//  cmCancel,,,'Отмена',hcD_GetFormNa,scGalDial;

