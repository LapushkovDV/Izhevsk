Window EditSopr;
  handleEvent
    cmInit:
    {
!      Message('cminit winedit='+(oDATFS<>NullRef))	
      inherited::handleevent(cminit);
      if (oDATFS<>NullRef) {
        if katsopr.cIzd = 0h {
         var _cIzd : comp =  iDatFS_base.runwindowgetsubtip(201);
        set katsopr.cIzd := _cIzd;
        }
        oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
        SetWindowTitle(EDITSOPR,SetNeWinTitle(namewin));
      }
    }
  end;
end;

//******************************************************************************
// события интерфейса
//******************************************************************************
  handleEvent
    cmInit:
    {
!        Message('cminit TypeSopr='+TypeSopr)	
      //----------------------------
!      if (TypeSopr=201)
      {  
        oDATFS:=GP_DocFieldsStateService::GetDocByName('SoprDoc');
!        Message('cminit='+(oDATFS<>NullRef))	
        // обьект проверки кэшируется при повторном открытии - надо загнать туда 0 статусу
        oDATFS.CalcAndApplyFieldsState(0,cfsGetCurrentContainerSelf);       
      }

      case Inherited::HandleEvent(cmInit) of
        heAbort :  Abort;
        heStop  :  Exit;
      end;   
      cfsGetProp('EDITSOPR','Title',namewin); 
!        Message('cminit TypeSopr='+TypeSopr)	
    }

!    cmCallFilter:
!    {
!     Inherited::HandleEvent(cmCallFilter);
!    }
/*
cmCallFilter:
{
  var sAddTitle       : string  = '';           //прибавить к заголовку
  var sTitle          : string  = '';
  var tMyRec          : comp    = KatSopr.NRec;
  var bMyDocFlt       : boolean = True;         //для отмены фильтров
  var isReread        : boolean;  //запись перечитана
  var isSortDN        : boolean;  //сортировка по дате создания и номеру
  var isInitialization: boolean = False;
  var shouldSetFilter : boolean = False;
  var WD_1, wi        : word;
  var isFilterTune    : boolean; // фильтр из настройки
  var oFltInDoc       : FltInDoc;
  pUserID := UserID();

  isFilterTune := boGetTune('User.UseFilter') And (BegDate <= EndDate);

  sTypeTitle := Trim(sTypeTitle); // тип заголовка

  pMarker.UnselectAll;

  if Pos('ФИЛЬТР:', CurrentInterfaceTitle) = 0
    strTitle := CurrentInterfaceTitle;

  if NOT ReadMyDsk(isInitialization, '_InitKatSopr_' + sTypeDoc, True)
    isInitialization := False;

  SaveMyDsk(False, '_InitKatSopr_' + sTypeDoc);

  if (isInitialization)
    {
      pRecFltDoc.wRestore := oFltInDoc.GetFltInDocParameter('Filter_Nakl_wRestore_', sTypeDoc);

      if (pRecFltDoc.wRestore = 0)
        Exit
      else
        {
          ReadDSK2(pRecFltDoc);
          shouldSetFilter := True;
        }
    }
  else
    {
      oFltInDoc.SetFltInDocParameter('Filter_Tip_Doc', '', sTypeDoc);

      var typeKatSopr : word; typeKatSopr := KatSopr.VidSopr;

!      if (RunInterface('FltInDoc', typeKatSopr, pRecFltDoc) = cmCancel)
     if (RunInterface('FltInDoc_Ext', typeKatSopr, pRecFltDoc,cVidOPer) = cmCancel)
        Exit
      else
        shouldSetFilter := True;
    }

  SaveMyDsk(False, '_InitKatSopr_' + sTypeDoc);

  if pRecFltDoc.WD > 3 // где то записалось 65535
    pRecFltDoc.WD := 0;

  WD_1 := pRecFltDoc.WD;

  if (pRecFltDoc.WD <> 0)
    WD_1--;

  WhatDate := WD_1;
  isFilter := False;

  if (shouldSetFilter)
    {
      bMyDocFlt := (pRecFltDoc.Filter    <> 0) or (pRecFltDoc.NoDOpr  <> 0)
                or (pRecFltDoc.DopFilter <> 0) or (pRecFltDoc.wNalAkt <> 0) ;

      isSortDN  := (WD_1 = 0) And ((pRecFltDoc.wSort And 1) = 1);

      if (pRecFltDoc.WD = 0)
        {
          if (isFilterTune)
            {
              BegDate  := dGetTune('User.dFilter1');
              EndDate  := dGetTune('User.dFilter2');
              isFilter := BegDate <= EndDate;
            }
        }
      else
        {           
          if (isFilterTune) and //если Использовать этот фильтр в интерфейсах - да
             (not boGetTune('Doc.SD.FilterD')) //В фильтрах по документам допускать выход за ограничения фильтра по интервалу дат - нет
            {
              BegDate := if ((pRecFltDoc.bDate >= BegDate) And (pRecFltDoc.bDate <= EndDate), pRecFltDoc.bDate, BegDate);
              EndDate := if ((pRecFltDoc.eDate >= BegDate) And (pRecFltDoc.eDate <= EndDate), pRecFltDoc.eDate, EndDate);
            }
          else //если Использовать этот фильтр в интерфейсах - нет
            {
              BegDate := pRecFltDoc.bDate;
              EndDate := pRecFltDoc.eDate;
            }
            isFilter := BegDate <= EndDate ;
        }


      SetDocBound;

      if bMyDocFlt
        {
          //фильтр по ДО
          if (BoundActive(tbFiltrByDODN))  SubBounds(tbFiltrByDODN);
          if (BoundActive(tbFiltrByDO))    SubBounds(tbFiltrByDO);

          if (pRecFltDoc.Filter And FILTER_BY_DO) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByDODN);
              else
                AddBounds(tbFiltrByDO);
            }

          //фильтр по договору
          if (BoundActive(tbFiltrByDogDN))  SubBounds(tbFiltrByDogDN);
          if (BoundActive(tbFiltrByDog))    SubBounds(tbFiltrByDog);

          if (pRecFltDoc.Filter And FILTER_BY_DOGOVOR) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByDogDN);
              else
                AddBounds(tbFiltrByDog);
            }

          //фильтр по соглашению
          if (BoundActive(tbFiltrByAppDogDN))  SubBounds(tbFiltrByAppDogDN);
          if (BoundActive(tbFiltrByAppDog))    SubBounds(tbFiltrByAppDog);

          if (pRecFltDoc.Filter And FILTER_BY_SOGL) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByAppDogDN);
              else
                AddBounds(tbFiltrByAppDog);
            }

          //фильтр по ПКП
          if (BoundActive(tbFiltrByCalPlanDN))  SubBounds(tbFiltrByCalPlanDN);
          if (BoundActive(tbFiltrByCalPlan))    SubBounds(tbFiltrByCalPlan);

          if (pRecFltDoc.Filter And FILTER_BY_PKP) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByCalPlanDN);
              else
                AddBounds(tbFiltrByCalPlan);
            }

          //фильтр по контрагенту
          if (BoundActive(tbFiltrByOrgBaseDN))    SubBounds(tbFiltrByOrgBaseDN);
          if (BoundActive(tbFiltrByOrgBase))      SubBounds(tbFiltrByOrgBase);
          if (BoundActive(tbFiltrByOrgBaseMult))  SubBounds(tbFiltrByOrgBaseMult);
          ResetBounds(#DocFilters_Org);//#TmpFlt_Sopr_Org ;

          if (pRecFltDoc.Filter And FILTER_BY_KONTRAGENT) != 0
            {
              var _Marker_KatOrg : tPtr = InitMarker('FILTER_NAKL_KatOrg_'+string(TypeSopr),8,100,10);

              delete DocFilters_Org  where ((
                             pUserID              /== DocFilters_Org.User   and
                             coKatSopr            /== DocFilters_Org.wTable and
                             TypeSopr             /== DocFilters_Org.Tip    and
                             FILTER_BY_KONTRAGENT /== DocFilters_Org.SubTip
                             ));
              var _ii : Longint;
              var _cRec :comp =0;
              if GetMarkerCount(_Marker_KatOrg )>1
              { For(_ii:=0; _ii< GetMarkerCount(_Marker_KatOrg ); _ii++)
                { if GetMarker(_Marker_KatORg,_ii, _cRec)
                    insert into DocFilters_Org set
                              DocFilters_Org.User      := pUserID
                            , DocFilters_Org.wTable    := coKatSopr
                            , DocFilters_Org.Tip       := TypeSopr
                            , DocFilters_Org.SubTip    := FILTER_BY_KONTRAGENT
                            , DocFilters_Org.DocBelong := _cRec //KatSopr.cOrgBase
                            ;

                }
                AddBounds(tbFiltrByOrgBaseMult);
              }
              else
              {
                if (isSortDN)
                  AddBounds(tbFiltrByOrgBaseDN);
                else
                  AddBounds(tbFiltrByOrgBase);
              }

              DoneMarker(_Marker_KatOrg , 'FILTER_NAKL_KatOrg_'+string(TypeSopr));
            }

          //фильтр по дескриптору
          if (BoundActive(tbFiltrByDescrDN))  SubBounds(tbFiltrByDescrDN);
          if (BoundActive(tbFiltrByDescr))    SubBounds(tbFiltrByDescr);

          if (pRecFltDoc.Filter And FILTER_BY_DESCR) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByDescrDN);
              else
                AddBounds(tbFiltrByDescr);
            }

          //фильтр по группе дескрипторов
          if (BoundActive(tbFiltrByDesgrDN))  SubBounds(tbFiltrByDesgrDN);
          if (BoundActive(tbFiltrByDesgr))    SubBounds(tbFiltrByDesgr);

          if (pRecFltDoc.Filter And FILTER_BY_GROUP) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByDesgrDN);
              else
                AddBounds(tbFiltrByDesgr);
            }

          //фильтр по назначению
          if (BoundActive(tbFiltrByNaznaDN))   SubBounds(tbFiltrByNaznaDN);
          if (BoundActive(tbFiltrByNazna))     SubBounds(tbFiltrByNazna);
          if (BoundActive(tbFiltrByNaznaMult)) SubBounds(tbFiltrByNaznaMult);

          if (pRecFltDoc.Filter And FILTER_BY_KATNAZNA) != 0
          {
            var _Marker_Nazna : tPtr = InitMarker('FILTER_NAKL_NAZNA_' + string(TypeSopr), 8, 100, 10);

            delete TmpFlt_KatNazna where (( TypeSopr == TmpFlt_KatNazna.VidSopr ));
            var _ii : Longint;
            var _cRec :comp = 0;
            if (GetMarkerCount(_Marker_Nazna ) > 1)
            {
              For(_ii:=0; _ii< GetMarkerCount(_Marker_Nazna); _ii++)
                if (GetMarker(_Marker_Nazna,_ii, _cRec))
                  insert into TmpFlt_KatNazna set TmpFlt_KatNazna.VidSopr := TypeSopr
                                                , TmpFlt_KatNazna.cNazna  := _cRec;
              AddBounds(tbFiltrByNaznaMult);
            }
            else
            {
              if (isSortDN)
                AddBounds(tbFiltrByNaznaDN);
              else
                AddBounds(tbFiltrByNazna);
            }
            DoneMarker(_Marker_Nazna, 'FILTER_NAKL_NAZNA_' + string(TypeSopr));
          }

          //фильтр по контрагенту
          if (BoundActive(tbFiltrGruzToDN))  SubBounds(tbFiltrGruzToDN);
          if (BoundActive(tbFiltrGruzTo))    SubBounds(tbFiltrGruzTo);

          if (pRecFltDoc.Filter And FILTER_BY_GRUZPOL) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrGruzToDN);
              else
                AddBounds(tbFiltrGruzTo);
            }

          //фильтр по форме расчета
          if (BoundActive(tbFiltrPaymentDN))  SubBounds(tbFiltrPaymentDN);
          if (BoundActive(tbFiltrPayment))    SubBounds(tbFiltrPayment);

          if (pRecFltDoc.Filter And FILTER_BY_FORMRAS) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrPaymentDN);
              else
                AddBounds(tbFiltrPayment);
            }

          //фильтр по системному статусу
          if (BoundActive(tbFiltrByStatusDN))  SubBounds(tbFiltrByStatusDN);
          if (BoundActive(tbFiltrByStatus))    SubBounds(tbFiltrByStatus);

          if (pRecFltDoc.Filter And FILTER_BY_SYSSTATUS) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByStatusDN);
              else
                AddBounds(tbFiltrByStatus);
            }

          //фильтр по пользовательскому статусу
          if (BoundActive(tbFiltrByStatusPolzDN))    SubBounds(tbFiltrByStatusPolzDN);
          if (BoundActive(tbFiltrByStatusPolz))      SubBounds(tbFiltrByStatusPolz);
          if (BoundActive(tbFiltrByStatusPolzMult))  SubBounds(tbFiltrByStatusPolzMult);

          if (pRecFltDoc.Filter And FILTER_BY_USRSTATUS) != 0
            {
              var _Marker_Notes : tPtr = InitMarker('FILTER_NAKL_NOTES_'+string(TypeSopr),8,100,10);

              delete TmpFlt_KatNotes where (( TypeSopr == TmpFlt_KatNotes.VidSopr ));
              var _ii : Longint;
              var _cRec :comp =0;
              if GetMarkerCount(_Marker_Notes )>1
              { For(_ii:=0; _ii< GetMarkerCount(_Marker_Notes ); _ii++)
                { if GetMarker(_Marker_Notes,_ii, _cRec)
                    insert into TmpFlt_KatNotes set TmpFlt_KatNotes.VidSopr :=TypeSopr, TmpFlt_KatNotes.cNote := _cRec;

                }
                AddBounds(tbFiltrByStatusPolzMult);
              }
              else
              { if (isSortDN)
                  AddBounds(tbFiltrByStatusPolzDN);
                else
                  AddBounds(tbFiltrByStatusPolz);
              }

              DoneMarker(_Marker_Notes , 'FILTER_NAKL_NOTES_'+string(TypeSopr));
            }


          //фильтр по центру ответственности
          if (BoundActive(tbFiltrByFPCODN))  SubBounds(tbFiltrByFPCODN);
          if (BoundActive(tbFiltrByFPCO))    SubBounds(tbFiltrByFPCO);

          if (pRecFltDoc.Filter And FILTER_BY_CO) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByFPCODN);
              else
                AddBounds(tbFiltrByFPCO);
            }

          //фильтр по объекту строительства
          if (BoundActive(tbFiltrByKatStroyDN))  SubBounds(tbFiltrByKatStroyDN);
          if (BoundActive(tbFiltrByKatStroy))    SubBounds(tbFiltrByKatStroy);

          if (TypeSopr = 110)
          if (pRecFltDoc.Filter And FILTER_BY_OBJSTROY) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByKatStroyDN);
              else
                AddBounds(tbFiltrByKatStroy);
            }

          if (BoundActive(tbFiltrByGrDN)) SubBounds(tbFiltrByGrDN);
          if (BoundActive(tbFiltrByGr))   SubBounds(tbFiltrByGr);

          // фильтр по сводному документу
          if ((TypeSopr = 211) OR (TypeSopr = 201) OR (TypeSopr = 111) OR (TypeSopr = 101))
          if (pRecFltDoc.Filter And FILTER_BY_SVODDOC) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByGrDN)
              else
                AddBounds(tbFiltrByGr);
            }

          //фильтр по склад "откуда"
          if (BoundActive(tbFiltrByPodrFromDN))  SubBounds(tbFiltrByPodrFromDN);
          if (BoundActive(tbFiltrByPodrFrom))    SubBounds(tbFiltrByPodrFrom);

          if (pRecFltDoc.Filter And FILTER_BY_PODRFROM) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByPodrFromDN);
              else
                AddBounds(tbFiltrByPodrFrom);
            }

          //фильтр по МОЛ "откуда"
          if (BoundActive(tbFiltrByMolFromDN))  SubBounds(tbFiltrByMolFromDN);
          if (BoundActive(tbFiltrByMolFrom))    SubBounds(tbFiltrByMolFrom);

          if (pRecFltDoc.Filter And FILTER_BY_MOLFROM) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByMolFromDN);
              else
                AddBounds(tbFiltrByMolFrom);
            }

          //фильтр по склад "куда"
          if (BoundActive(tbFiltrByPodrToDN))  SubBounds(tbFiltrByPodrToDN);
          if (BoundActive(tbFiltrByPodrTo))    SubBounds(tbFiltrByPodrTo);

          if (pRecFltDoc.Filter And FILTER_BY_PODRTO) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByPodrToDN);
              else
                AddBounds(tbFiltrByPodrTo);
            }

          //фильтр по МОЛ "куда"
          if (BoundActive(tbFiltrByMolToDN))  SubBounds(tbFiltrByMolToDN);
          if (BoundActive(tbFiltrByMolTo))    SubBounds(tbFiltrByMolTo);

          if (pRecFltDoc.Filter And FILTER_BY_MOLTO) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByMolToDN);
              else
                AddBounds(tbFiltrByMolTo);
            }
          //по налоговому акту
          if (BoundActive(tbFiltrByNalAkt))    SubBounds(tbFiltrByNalAkt);
          if (pRecFltDoc.wNalAkt and 1) <> 0
             AddBounds(tbFiltrByNalAkt);

          //фильтр по хоз.операции
          if (BoundActive(tbFiltrByHozOperDN))  SubBounds(tbFiltrByHozOperDN);
          if (BoundActive(tbFiltrByHozOper))    SubBounds(tbFiltrByHozOper);

          if (pRecFltDoc.Filter And FILTER_BY_HOZOPER) != 0
            {
              if (isSortDN)
                AddBounds(tbFiltrByHozOperDN);
              else
                AddBounds(tbFiltrByHozOper);
            }

          if (BoundActive(tbFiltrByNoDOpr))  SubBounds(tbFiltrByNoDOpr);

          if (pRecFltDoc.NoDOpr != 0)
            AddBounds(tbFiltrByNoDOpr);

// внешняя классификация /ERP-1319

          if (BoundActive(tbFiltrByExtClass1)) SubBounds (tbFiltrByExtClass1);
          if (( pRecFltDoc.DopFilter and 1) != 0 )
          {
            if ((pRecFltDoc.wExClass [1]) <> 0)
              AddBounds(tbFiltrByExtClass1);
          }

          if (BoundActive(tbFiltrByExtClass2)) SubBounds (tbFiltrByExtClass2);
          if (( pRecFltDoc.DopFilter and 2) != 0 )
          {
            if (pRecFltDoc.wExClass [2] <> 0)
              AddBounds(tbFiltrByExtClass2);
          }

          if (BoundActive(tbFiltrByExtClass3)) SubBounds (tbFiltrByExtClass3);
          if (( pRecFltDoc.DopFilter and 4) != 0 )
          {
            if (pRecFltDoc.wExClass [3] <> 0)
              AddBounds(tbFiltrByExtClass3);
          }

          if (BoundActive(tbFiltrByExtClass4)) SubBounds (tbFiltrByExtClass4);
          if (( pRecFltDoc.DopFilter and 8) != 0 )
          {
            if (pRecFltDoc.wExClass [4] <> 0)
              AddBounds(tbFiltrByExtClass4);
          }

          if (BoundActive(tbFiltrByExtClass5)) SubBounds (tbFiltrByExtClass5);
          if (( pRecFltDoc.DopFilter and 16) != 0 )
          {
            if (pRecFltDoc.wExClass [5] <> 0)
              AddBounds(tbFiltrByExtClass5);
          }

          if (BoundActive(tbFiltrByExtClass6)) SubBounds (tbFiltrByExtClass6);
          if (( pRecFltDoc.DopFilter and 32) != 0 )
          {
            if (pRecFltDoc.wExClass [6] <> 0)
              AddBounds(tbFiltrByExtClass6);
          }

          StartNewVisual (vtRotateVisual, vfTimer+vfThread, 'Идет фильтрация...', 1);

          oFltInDoc.SetFltInDocParameter('Filter_Nakl_bFilterNakl_', sTypeDoc, 1);

          if not IsValidBuffer (#KatSopr)
          {
            if (GetLast KatSopr <> tsOk)
            {
              bMyDocFlt := False;
              sTitle    := '';
            }
          }
          //для заголовка  *****************************************************************
          if (bMyDocFlt)
            {
              ReReadRecord(#KatSopr);

              if (BoundActive(tbFiltrByDODN) or BoundActive(tbFiltrByDO))
                sAddTitle += 'ДО № '  + if(KatSopr.cStepDoc = 0, '"--"  ', '"' + BaseDoc.NoDoc + '"  ');

              if (BoundActive(tbFiltrByDogDN) or BoundActive(tbFiltrByDog))
                sAddTitle += 'ДОГ.№ ' + if(KatSopr.cDogovor = 0, '"--"  ', '"' + Dogovor.NoDoc + '"');

              if (BoundActive (tbFiltrByAppDogDN) or BoundActive (tbFiltrByAppDog))
                sAddTitle += 'СОГЛ.№ '+ if(KatSopr.cAppDogovor = 0, '"--"  ', '"' + AppDogovor.NoDoc + '"  ');

              if (BoundActive (tbFiltrByCalPlanDN) or BoundActive (tbFiltrByCalPlan))
                sAddTitle += 'ПКП № ' + if(KatSopr.cCalPlan = 0, '"--"  ', '"' + CalPlan.NoDoc + '"  ');

              if (BoundActive (tbFiltrByOrgBaseDN) or BoundActive (tbFiltrByOrgBase))
                sAddTitle += 'КОНТРАГЕНТ ' + if(KatSopr.cOrgBase = 0, '"--"  ', '"' + ShowKau(cgKau_KatOrg, KatSopr.cOrgBase) + '"  ');

              if (BoundActive (tbFiltrByOrgBaseMult) )
                sAddTitle += 'КОНТРАГЕНТЫ ' ;

              if (BoundActive (tbFiltrByDescrDN) or BoundActive (tbFiltrByDescr))
                sAddTitle += 'ДЕСКР. ' + '"' + KatSopr.Descr + '"  ';

              if (BoundActive (tbFiltrByDesgrDN) or BoundActive (tbFiltrByDesgr))
                sAddTitle += 'ГР.ДЕСКР. ' + '"' + KatSopr.Desgr + '"  ';

              if (BoundActive(tbFiltrByNaznaDN) or BoundActive(tbFiltrByNazna))
                sAddTitle += 'НАЗНАЧЕНИЕ ' + if(KatSopr.cNazna = 0, '"--"  ', '"' + ShowKau(cgKau_KatNazna, KatSopr.cNazna) + '"');

              if (BoundActive (tbFiltrByNaznaMult))
                sAddTitle += 'НАЗНАЧЕНИЯ ' ;

              if (BoundActive (tbFiltrGruzToDN) or BoundActive (tbFiltrGruzTo))
                sAddTitle += 'ГРУЗОПОЛУЧАТЕЛЬ ' + if(KatSopr.cGruzTo = 0, '"--"  ', '"' + ShowKau(cgKau_KatOrg, KatSopr.cGruzTo) + '"  ');

              if (BoundActive (tbFiltrPaymentDN) or BoundActive (tbFiltrPayment))
                sAddTitle += 'ФОРМА РАСЧЕТА ' + if(KatSopr.cPayment = 0, '"--"  ', '"' + KatPayment.Name + '"  ');

              if (BoundActive (tbFiltrByFPCODN) or BoundActive (tbFiltrByFPCO))
                sAddTitle += 'ЦО ' + if(KatSopr.cOtvPodr = 0, '"--"  ', '"' + ShowKau(cgKau_FpCO, KatSopr.cOtvPodr) + '"  ');

              if (BoundActive (tbFiltrByKatStroyDN) or BoundActive (tbFiltrByKatStroy))
                sAddTitle += 'ОБЪЕКТ ' + if(KatSopr.cUks = 0, '"--"  ', '"' + KatStroy.Name + '"  ');

              if (BoundActive (tbFiltrByGrDN) or BoundActive (tbFiltrByGr))
                sAddTitle += 'СВОДНЫЙ ДОКУМЕНТ ' + if(KatSopr.cGrSopr = 0, '"--"  ', '"' + GrSopr.NSopr + '"  ');

              if (BoundActive (tbFiltrByStatusDN) or BoundActive (tbFiltrByStatus))
                {
                  var strStat : string; strStat := '';

                  case KatSopr.Status of
                    0: strStat := 'Оформляемый';
                    1: strStat := 'Исполняемый';
                    2: strStat := 'Приостановленный';
                    3: strStat := 'Отмененный';
                    4: strStat := 'Закрытый';
                  end;

                  sAddTitle += 'СИСТЕМНЫЙ СТАТУС "' + strStat + '"';
                }

              if (BoundActive (tbFiltrByStatusPolzDN) or BoundActive (tbFiltrByStatusPolz))
                sAddTitle += 'ПОЛЬЗОВАТЕЛЬСКИЙ СТАТУС ' + if(KatSopr.cNote = 0, '"--"  ', '"' + KatNotes.Name + '"  ');
              if (BoundActive (tbFiltrByStatusPolzMult) )
                sAddTitle += 'ПОЛЬЗОВАТЕЛЬСКИЙ СТАТУСЫ ';

              if (BoundActive (tbFiltrByPodrFromDN) or BoundActive (tbFiltrByPodrFrom))
                sAddTitle += 'СКЛАД (ОТКУДА) ' + if(KatSopr.cPodrFrom = 0, '"--"  ', '"' + ShowKau(cgKau_KatPodr, KatSopr.cPodrFrom) + '"  ');

              if (BoundActive (tbFiltrByPodrToDN) or BoundActive (tbFiltrByPodrTo))
                sAddTitle += 'СКЛАД (КУДА) ' + if(KatSopr.cPodrTo = 0, '"--"  ', '"' + ShowKau(cgKau_KatPodr, KatSopr.cPodrTo) + '"  ');

              if (BoundActive (tbFiltrByMolFromDN) or BoundActive (tbFiltrByMolFrom))
                sAddTitle += 'МОЛ (ОТКУДА) ' + if(KatSopr.cMolFrom = 0, '"--"  ', '"' + ShowKau(cgKau_KatMOL, KatSopr.cMolFrom) + '"  ');

              if (BoundActive (tbFiltrByMolToDN) or BoundActive (tbFiltrByMolTo))
                sAddTitle += 'МОЛ (КУДА) ' + if(KatSopr.cMolTo = 0, '"--"  ', '"' + ShowKau(cgKau_KatMOL, KatSopr.cMolTo) + '"  ');

              if (BoundActive (tbFiltrByNalAkt))
                sAddTitle += 'Налоговые акты ';

              if (BoundActive (tbFiltrByHozOperDN) or BoundActive (tbFiltrByHozOper))
                sAddTitle += 'Хоз.операция ' + if(KatSopr.cHozOper = 0, '"--"  ', '"' + sTxoGetField('HozOper', 'Name1', KatSopr.cHozOper) + '"  ');
                
//--------------------------------------------------------
              for (wi:=1; wi<=6; Inc(wi))
              {
                if (pRecFltDoc.DopFilter != 0 )
                {
                  if (pRecFltDoc.wExClass [wi] <> 0)
                    sAddTitle += 'классификация ' + '"' + pRecFltDoc.sExClass[wi] + '"  ';
                }
              }
//--------------------------------------------------------
              if (BoundActive (tbFiltrByNoDOpr))
                sAddTitle += '"Без даты исполнения"  ';

            }

          StopVisual('', 0);
        }

      sTitle := if (sTypeTitle = '', sTitle, sTypeTitle);
    }

  if not IsValidBuffer (#KatSopr)
  {
    //проверка записей
    if (GetLast KatSopr <> tsOk)
    {
      bMyDocFlt         := False;
      set pRecFltDoc.WD := 0;
      isFilter          := False;

       if (isFilterTune)
         {
           BegDate  := dGetTune('User.dFilter1');
           EndDate  := dGetTune('User.dFilter2');
           isFilter := BegDate < EndDate;
         }


      SetDocBound;
#IFDEF _SOMESOPR_
      if not boFltSoprNoExist
#ENDIF
      message('Нет документов, удовлетворяющих условиям фильтра(' + string(TypeSopr)+ ').');

#IFDEF _SOMESOPR_
      boFltSoprNoExist := True;
#ENDIF
      oFltInDoc.SetFltInDocParameter('Filter_Nakl_Filter_'     , sTypeDoc, longint(0));
      oFltInDoc.SetFltInDocParameter('Filter_Nakl_bFilterNakl_', sTypeDoc,    word(0));
      oFltInDoc.SetFltInDocParameter('Filter_What_Date_'       , sTypeDoc,    word(0));

      if tMyRec <> 0
      {
        if GetFirst KatSopr where((tMyRec == KatSopr.Nrec)) = tsOk
          {
          }  //исходная позиция
      }
    }
  }
  else
  {
#IFDEF _SOMESOPR_
      boFltSoprNoExist := False;
#ENDIF

  }
  //ReReadRecord(#KatSopr);

  if (not bMyDocFlt)
    {
      ResetBounds(#DocFilters_Org) ;
      if BoundActive (tbFiltrByDODN)           SubBounds (tbFiltrByDODN);
      if BoundActive (tbFiltrByDO)             SubBounds (tbFiltrByDO);
      if BoundActive (tbFiltrByDogDN)          SubBounds (tbFiltrByDogDN);
      if BoundActive (tbFiltrByDog)            SubBounds (tbFiltrByDog);
      if BoundActive (tbFiltrByAppDogDN)       SubBounds (tbFiltrByAppDogDN);
      if BoundActive (tbFiltrByAppDog)         SubBounds (tbFiltrByAppDog);
      if BoundActive (tbFiltrByCalPlanDN)      SubBounds (tbFiltrByCalPlanDN);
      if BoundActive (tbFiltrByCalPlan)        SubBounds (tbFiltrByCalPlan);
      if BoundActive (tbFiltrByOrgBaseDN)      SubBounds (tbFiltrByOrgBaseDN);
      if BoundActive (tbFiltrByOrgBaseMult)    SubBounds (tbFiltrByOrgBaseMult);
      if BoundActive (tbFiltrByOrgBase)        SubBounds (tbFiltrByOrgBase);
      if BoundActive (tbFiltrByDescrDN)        SubBounds (tbFiltrByDescrDN);
      if BoundActive (tbFiltrByDescr)          SubBounds (tbFiltrByDescr);
      if BoundActive (tbFiltrByDesgrDN)        SubBounds (tbFiltrByDesgrDN);
      if BoundActive (tbFiltrByDesgr)          SubBounds (tbFiltrByDesgr);
      if BoundActive (tbFiltrByNazna)          SubBounds (tbFiltrByNazna);
      if BoundActive (tbFiltrByNaznaDN)        SubBounds (tbFiltrByNaznaDN);
      if BoundActive (tbFiltrByNaznaMult)      SubBounds (tbFiltrByNaznaMult);
      if BoundActive (tbFiltrByStatusDN)       SubBounds (tbFiltrByStatusDN);
      if BoundActive (tbFiltrByStatus)         SubBounds (tbFiltrByStatus);
      if BoundActive (tbFiltrByStatusPolz)     SubBounds (tbFiltrByStatusPolz);
      if BoundActive (tbFiltrByStatusPolzDN)   SubBounds (tbFiltrByStatusPolzDN);
      if BoundActive (tbFiltrByStatusPolzMult) SubBounds (tbFiltrByStatusPolzMult);
      if BoundActive (tbFiltrByFPCODN)         SubBounds (tbFiltrByFPCODN);
      if BoundActive (tbFiltrByFPCO)           SubBounds (tbFiltrByFPCO);
      if BoundActive (tbFiltrByKatStroyDN)     SubBounds (tbFiltrByKatStroyDN);
      if BoundActive (tbFiltrByKatStroy)       SubBounds (tbFiltrByKatStroy);
      if BoundActive (tbFiltrByPodrFrom)       SubBounds (tbFiltrByPodrFrom);
      if BoundActive (tbFiltrByPodrFromDN)     SubBounds (tbFiltrByPodrFromDN);
      if BoundActive (tbFiltrByPodrTo)         SubBounds (tbFiltrByPodrTo);
      if BoundActive (tbFiltrByPodrToDN)       SubBounds (tbFiltrByPodrToDN);
      if BoundActive (tbFiltrByMOLFrom)        SubBounds (tbFiltrByMOLFrom);
      if BoundActive (tbFiltrByMOLFromDN)      SubBounds (tbFiltrByMOLFromDN);
      if BoundActive (tbFiltrByMOLTo)          SubBounds (tbFiltrByMOLTo);
      if BoundActive (tbFiltrByMOLToDN)        SubBounds (tbFiltrByMOLToDN);
      if BoundActive (tbFiltrByNalAkt)         SubBounds (tbFiltrByNalAkt);
      if BoundActive (tbFiltrByHozOper)        SubBounds (tbFiltrByHozOper);
      if BoundActive (tbFiltrByHozOperDN)      SubBounds (tbFiltrByHozOperDN);
      if BoundActive (tbFiltrByNoDOpr)         SubBounds (tbFiltrByNoDOpr);

// внешняя классификация /ERP-1319
     if (boundactive(tbFiltrByExtClass1))  SubBounds (tbFiltrByExtClass1);
     if (boundactive(tbFiltrByExtClass2))  SubBounds (tbFiltrByExtClass2);
     if (boundactive(tbFiltrByExtClass3))  SubBounds (tbFiltrByExtClass3);
     if (boundactive(tbFiltrByExtClass4))  SubBounds (tbFiltrByExtClass4);
     if (boundactive(tbFiltrByExtClass5))  SubBounds (tbFiltrByExtClass5);
     if (boundactive(tbFiltrByExtClass6))  SubBounds (tbFiltrByExtClass6);

      Rereadrecord(#KatSopr);
      sAddTitle := '';
    }

  if not (isFilterTune or bMyDocFlt)
  {
    sTitle := sTypeTitle;

    RunInterface('iCheckTitleKatSopr', TypeSopr
                                     , (pRecFltDoc.WD <> 0)
                                     , if (pRecFltDoc.WD <> 0, BegDate, ZeroDate)
                                     , if (pRecFltDoc.WD <> 0, EndDate, ZeroDate)
                                     , sTitle);

    SetTitle(sTitle);

    bFilterNakl := False or isFilter;
  }
  else
  {
    RunInterface('iCheckTitleKatSopr', TypeSopr, (isFilterTune or (pRecFltDoc.WD <> 0)), BegDate, EndDate, sTitle);

    SetTitle(if (sTitle = '', strTitle, sTitle) + if(sAddTitle = '', '', ' - ФИЛЬТР:  ' + sAddTitle));

    bFilterNakl := True;
  }

  HidePickButton;

  isFilter := isFilterTune;
  if isFilter
    isFilter := BegDate < EndDate;

#IFDEF _SOMESOPR_
#ELSE
  ReReadRecord(#KatSopr);
#ENDIF
}
*/
end;
end.