#include GP_DATFS_Base.vih
#include GP_DocFieldsStateService.vih
//#include FltInDoc_EXt.vih

#component "L_SOPRDOC"

//******************************************************************************
Alter Interface SoprDoc;

overload
  Procedure PosChange;
//  Procedure CallFilter;
end;

ExtendFormats brSelectNakl;//brSelect;

Var
  oDATFS : GP_ObjDocAbleTuneFieldsState;
  iDatFS_base : GP_DATFS_Base;

//  var cVidOPer : comp;

  Create view
    var _cviodoper:comp;
        namewin:string;
  as select
   if(isvalid(tnKauVid),KauVid.name,'Не определен') (fieldname=fvidOper)  
  from Spkau KauVid
   where ((
            katsopr.cizd == KauVid.nrec
         ))
   ;

procedure timelog(_str : string); {
#ifdef _DEBUG_DocFieldsStateService_
  iDatFS_base.enablelog;
  iDatFS_base.MyLog(_str);
#endif
}

#include onCfgObjectsRequired.vpp
#include funWin.vpp
//#include onCfgObjectsRequired.vpp

Browse brSelectNakl ('Для редактирования накладной нажмите <Enter>, <Ctrl><P> - печать', hcSpis_PrihNakl2, sci178InsPM);
  RecMarker = pMarker { KatSopr.nRec };

Fields {Font = {Color = if (IsValid(tnPMarker), ColorMark, GetColorRecKatSopr)}};
   fvidOper 'Вид операции' :[18],protect;

end;

Procedure PosChange;
{
  inherited::PosChange;

  if (oDATFS<>NullRef)
     oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);   
}


Window EditSopr;
  handleEvent
    cmInit:
    {
!      Message('cminit winedit='+(oDATFS<>NullRef))	
      inherited::handleevent(cminit);
      if (oDATFS<>NullRef) {
        if katsopr.cIzd = 0h {
         var _cIzd : comp =  iDatFS_base.runwindowgetsubtip(201);
        set katsopr.cIzd := _cIzd;
        iDatFS_base.SetDefault(KatSopr.cIzd, katsopr.nrec);
        }
        oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
        SetWindowTitle(EDITSOPR,SetNeWinTitle(namewin));
      }
    }

 cmMakeOrder : {
   if (oDATFS<>NullRef) {
     var _boOverload : boolean = oDATFS.isOverLoadButton(KatSopr.cIzd,cfsGetCurrentContainerSelf,cmMakeOrder);
      if _boOverload {
        var _TypeCpNrec : word = 2000 + katsopr.vidsopr;

        oDATFS.PushButton(KatSopr.cIzd,cfsGetCurrentContainerSelf,cmMakeOrder, _TypeCpNrec, katsopr.nrec, oDATFS);

        ReReadRecord(tnKatSopr);
        ReReadRecord(tnSpSopr);
        //message('_boOverload!');
        abort; exit;
      }
    }
   inherited::handleevent(cmMakeOrder)
 }
  end;
end;

//******************************************************************************
// события интерфейса
//******************************************************************************
  handleEvent
    cmInit:
    {
!        Message('cminit TypeSopr='+TypeSopr)	
      //----------------------------
!      if (TypeSopr=201)
      {  
        oDATFS:=GP_DocFieldsStateService::GetDocByName('SoprDoc');
!        Message('cminit='+(oDATFS<>NullRef))	
        // обьект проверки кэшируется при повторном открытии - надо загнать туда 0 статусу
        oDATFS.CalcAndApplyFieldsState(0,cfsGetCurrentContainerSelf);       
        BindEvent(onCfgObjectsRequired, oDATFS.Event_onCfgObjectsRequired);
      }

      case Inherited::HandleEvent(cmInit) of
        heAbort :  Abort;
        heStop  :  Exit;
      end;   
      cfsGetProp('EDITSOPR','Title',namewin); 
!        Message('cminit TypeSopr='+TypeSopr)	
    }

end;
end.