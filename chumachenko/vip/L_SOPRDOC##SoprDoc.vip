#include GP_DATFS_Base.vih
#include GP_DocFieldsStateService.vih
//#include FltInDoc_EXt.vih

#component "L_SOPRDOC"

//******************************************************************************
Alter Interface SoprDoc;

overload
  Procedure PosChange;
//  Procedure CallFilter;
end;

ExtendFormats brSelectNakl;//brSelect;

Var
  oDATFS : GP_ObjDocAbleTuneFieldsState;
  iDatFS_base : GP_DATFS_Base;

//  var cVidOPer : comp;

  Create view
    var _cviodoper:comp;
        namewin:string;
  as select
   if(isvalid(tnKauVid),KauVid.name,'Не определен') (fieldname=fvidOper)  
  from Spkau KauVid
   where ((
            katsopr.cizd == KauVid.nrec
         ))
   ;

#include funWin.vpp

Browse brSelectNakl ('Для редактирования накладной нажмите <Enter>, <Ctrl><P> - печать', hcSpis_PrihNakl2, sci178InsPM);
  RecMarker = pMarker { KatSopr.nRec };

Fields {Font = {Color = if (IsValid(tnPMarker), ColorMark, GetColorRecKatSopr)}};
   fvidOper 'Вид операции' :[18],protect;

end;

Procedure PosChange;
{
  inherited::PosChange;

  if (oDATFS<>NullRef)
     oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);   
}
