#component "L_SoprBase"

Alter Interface FltInDoc;

OverloadFormats scrFiltr;

  Create View
    var svidOper : s80;
     _kodkau : word; 
     _cNode: comp;

from katkau
   , spkau subtip_vaz
   , spkau spkau_br
where ((_kodkau == spkau_br.kodgrkau
     and _cNode == spkau_br.cNode))

  ;


function getkaukod_subtip( _subtipVAZ : string): word; cacheable;{
 result := 0;
 // тут надо переделать на настройку наверное...
 // подумайте сами
 if(getfirst katkau where katkau.name = _subtipVAZ) = tsOK {
   result := KATKAU.KODGROUP;
 }
}

window wgetsubtip 'Выбор подтипа документа', doaccept;
browse brgetsubtip;
 table spkau_br;
 fields
  spkau_br.code 'код':[6],Protect;
  spkau_br.name 'Наименование':[20],Protect;
end;
end;
windowevent wgetsubtip;
cmdone: {
 closewindowex(wgetsubtip,cmdefault);
}
end;

function runwindowgetsubtip(__viddoc : word) : comp; {
  result := 0h;

  set _kodkau := getkaukod_subtip(co_subtipVAZ);

  if getfirst subtip_vaz where ((_kodkau == subtip_vaz.kodgrkau
                            and __viddoc == subtip_vaz.code
                                  and 0h == subtip_vaz.CNODE (noindex) )) <> tsOK {
    message('В пользовательской аналитике "'+co_subtipVAZ+'" на найден элемент с кодом '+__viddoc+' без родителя', error);
    exit;
   }
 set _cNode := subtip_vaz.nrec;
 if runwindowModal(wgetsubtip) = cmdefault then result := spkau_br.nrec;
}


//tabbedSheet TOP tbFltr;
//Show at (, 5, ,31 );
Screen scrFiltr('',,sci13EnEsc);
  Show at (, 6, , );
  bevel b02 {1, 0, 77, 23, bsLowered, bsFrame};
Fields
   Filter ('Установленные фильтры',, sci1EnEsc) : NoProtect;

   BaseDoc.NoDoc   ('Установленные фильтры по документу-основанию'      ,,) : Protect;
   DogNoDoc        ('Установленные фильтры по договору (есть Сtrl+F3)'  ,,) : Protect;
   AppDogNoDoc     ('Установленные фильтры по соглашению (есть Сtrl+F3)',,) : Protect;
   CalPlan.NoDoc   ('Установленные фильтры по ПКП (есть Сtrl+F3)'       ,,) : Protect;
   KatOrg.Name     ('Установленные фильтры по контрагенту'              ,,) : Protect;
   sDescr          ('Установленные фильтры по дескриптору'              ,,) : Protect;
   sDesgr          ('Установленные фильтры по группе дескрипторов'      ,,) : Protect;
   KatNazna.Name   ('Установленные фильтры по каталогу назначений'      ,,) : Protect;
   KatOrgT.Name    ('Установленные фильтры по грузополучателю'          ,,) : Protect;
   KatPayment.Name ('Установленные фильтры по форме расчета'            ,,) : Protect;
   sStatus         ('Установленные фильтры по системному статусу'       ,,) :
                                                 [LIST  0  'Оформляемый',
                                                        1  'Исполняемый',
                                                        2  'Приостановленный',
                                                        3  'Отмененный',
                                                        4  'Закрытый'], Protect;
   KatNotes.Name   ('Установленные фильтры по пользовательскому статусу',,) : Protect;
   FPCO.Name       ('Установленные фильтры по центру ответственности'   ,,) : Protect;
   KatStroy.Name   ('Установленные фильтры по объекту строительства'    ,,) : Protect;
   GrSopr.NSopr    ('Установленные фильтры по сводному документу'       ,,) : Protect;
   KatPodrFrom.Name('Установленные фильтры по складу (откуда)'          ,,) : Protect;
   KatMolFrom.Name ('Установленные фильтры по МОЛ (откуда)'             ,,) : Protect;
   KatPodrTo.Name  ('Установленные фильтры по складу (куда)'            ,,) : Protect;
   KatMolTo.Name   ('Установленные фильтры по МОЛ (куда)'               ,,) : Protect;
   wNalAkt         ('Налоговые акты',,sci1EnEsc) : NoProtect;
   svidOper        : Protect;
   wSort           ('Сортировки',,sci1EnEsc) : NoProtect;
   wRestore        ('Восстанавливать фильтр при запуске интерфейса',,sci1EnEsc) : NoProtect;
Buttons
  cmOK,Default,,'Ввод - принять выбор',,sci1EnEsc;
  cmValueCancel,,,'Снять фильтры',,sci1EnEsc;
  cmCancel,,,'Отмена',,sci1EnEsc;
<<
   `Дополнительные фильтры по:`
    [.] ДО                   `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Договору             `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Соглашению           `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] ПКП                  `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Контрагенту          `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Дескриптору          `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Группе дескр.        `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Назначению           `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Грузополучателю      `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Форме расчета        `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Системному статусу   `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Польз. статусу       `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Центру ответственности`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Объекту строительства `  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Сводному документу   `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Склад (откуда)       `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] МОЛ   (откуда)       `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] Склад (куда)         `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    [.] МОЛ   (куда)         `   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

    [.] Налоговым актам` `Вид Операции `.@@@@@@@@@@@@@@@@@@@@@@@@@@@

    [:] Сортировка по дате создания`
    [:] Применять фильтр при запуске интерфейса`
   
  <.Установить фильтр.>  <.  Снять фильтр   .>  <.     Отмена      .>
>>
End; // Screen
//End;

  Handleevent
  cmInit:
  {
    if (inherited :: HandleEvent(cmInit) = heAbort)
    {
      Abort; Exit;
    }
  }

  cmPick:
  {
    if curfield<>#svidOper
      inherited :: HandleEvent(cmPick)
    else
    {
     if runwindowgetsubtip(TypeSopr)>0
      set  svidOper:=spkau_br.name;
      ReScanpanel(tnNoTable);
    }
  }
  end;
end.
