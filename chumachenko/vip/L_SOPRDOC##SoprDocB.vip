//******************************************************************************
Alter Interface SoprDocB;
//******************************************************************************
overload
  Procedure PosChange;
end;
OverLoadFormats scrButHeader;
ExtendFormats brbyName;

Var
  oDATFS : GP_ObjDocAbleTuneFieldsState;
  iDatFS_base : GP_DATFS_Base;

ExtendFormats BRSELECT;

  Create view
    var _cviodoper:comp;
        firstRun:word;
        namewin:string;
  as select
   if(isvalid(tnKauVid),KauVid.name,'Не определен') (fieldname=fvidOper)  
  from Spkau KauVid
   where ((
            katsopr.cizd == KauVid.nrec
         ))
   ;


Browse brSelect ('Для редактирования накладной нажмите <Enter>, <Ctrl><P> - печать', hcSpis_PrihNakl2, sci1478InsPM);
  RecMarker = pMarker { KatSopr.nRec };

Fields {Font = {Color = if (IsValid(tnPMarker), ColorMark, GetColorRecKatSopr)}};
   fvidOper 'Вид операции' :[18],protect;

end;

procedure timelog(_str : string); {
#ifdef _DEBUG_DocFieldsStateService_
  iDatFS_base.enablelog;
  iDatFS_base.MyLog(_str);
#endif
}

#include onCfgObjectsRequired.vpp
#include funWin.vpp

//==========================================
Procedure PosChange;
{
   timelog('SoprDocB PosChange ');
  inherited::PosChange;
  if true { //BoEditSopr {
      if (oDATFS<>NullRef)
      oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
      timelog('SoprDocB PosChange after oDATFS.CalcAndApplyFieldsState');
  }
} //Procedure PosChange;


Window EditSopr EscClose;
  Show at (, , 235, 45);
Panel pnHeader
  Table KatSopr;

Screen scrButHeader 'Редактирование' ('', hcZakupWNaklEditTopPan, sci1378Esc);
  Show (205,,, 17) fixed_X;
  Table KatSopr;
Buttons
  cmMakeOrder, [singleLine,Icon L_Soprdoc::bmpMakeOrd] , , , 'Оприходование МЦ'                                      ,, sci1EnEsc;
  cmKauReff  , [singleLine,Icon L_BaseDoc::bmpTTI]     , , , 'Вызов окна с товарно-транспортной информацией <Alt><T>',, sci1EnEsc;
  cmAttrib   , [singleLine,Icon F_Common::bmpDopInfo]  , , , 'Вызов окна с расширенной информацией'                  ,, sci1EnEsc;
  cmPickAttr , [singleLine];
  cmMakeDO   , [singleLine,Icon L_Soprdoc::bmpMakeDO]  , , , 'Формирование ДО по накладной'                          ,, sci1EnEsc;
  cmValue3   , [singleLine,Icon L_BaseDoc::bmpPayments], , , 'Платежные документы по документу-основанию'            ,, sci1EnEsc;
<<
