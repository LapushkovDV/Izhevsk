/*************************************************************************************************\
* Наименование: Реестр приходных ордеров накладных                                                *
* Контур/Модуль: Управление снабжением                                                            *
* Пункт меню: Документы / Приходные накладные                                                     *
* Примечание:                                                                                     *
\*************************************************************************************************/

#include GP_DocFieldsStateService.vih

#component "L_SOPRDOC"

//******************************************************************************
Alter Interface SoprDocB;
//******************************************************************************
overload
  Procedure PosChange;
end;

Var
  oDATFS : GP_ObjDocAbleTuneFieldsState;

//==========================================
Procedure PosChange;
{
  inherited::PosChange;
  if true { //BoEditSopr {
      if (oDATFS<>NullRef)
      oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
  }
} //Procedure PosChange;

Panel pnSopUsl
Table SpSopUsl;
HandleEvent
 cmPick : {
    if (oDATFS<>NullRef) {
      var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
      if not _boEdit { message('У вас нет прав на изменение этого поля!');
        abort; exit;
      }
    }
  }
End;
End; //pnSopUsl

Panel basPanelKatSopr
  Table KatSopr;

Handleevent
cmPick: {
  if (oDATFS<>NullRef) {
    var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
    if not _boEdit {
      message('У вас нет прав на изменение этого поля!');
      stop; abort; exit;
    }
  }
}
end;
end;

/*************************************************************************************************\
        События таблицы SpSopr
\*************************************************************************************************/
TableEvent Table SpSopr;
cmDelOnProtect: {
  if (oDATFS<>NullRef) {
    var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
    if not _boEdit {
      message('У вас нет прав на изменение этого поля!');
      abort; exit;
    }
  }
 Inherited::HandleEvent(CmDelOnProtect);
}
cmPick:
{
  if (oDATFS<>NullRef) {
    var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
    if not _boEdit {
      message('У вас нет прав на изменение этого поля!');
      abort; exit;
    }
  }
  case inherited::handleEvent(cmpick) of
   heAbort: { abort; exit; }
   heStop : { stop;  exit; }
  end;
}
End;

TableEvent Table SpSopUsl;
cmPick: {
    if (oDATFS<>NullRef) {
      var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
      if not _boEdit {
        message('У вас нет прав на изменение этого поля!');
        abort; exit;
      }
    }
  If inherited::handleevent(cmPick) = heAbort then abort;
}
cmDelOnProtect: {
 if (oDATFS<>NullRef) {
   var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
   if not _boEdit {
     message('У вас нет прав на изменение этого поля!');
     abort; exit;
   }
 }
 If inherited::handleevent(cmDelOnProtect) = heAbort then abort;
}
end; //TableEvent SpSoprUsl

//*****************************************************************************
// обработчик интерфейса
 handleEvent
   cmInit: {
    if (TypeSopr=101) {
      oDATFS:=GP_DocFieldsStateService::GetDocByName('SoprDocB');
       // обьект проверки кэшируется при повторном открытии - надо загнать туда 0 статусу
       oDATFS.CalcAndApplyFieldsState(0,cfsGetCurrentContainerSelf);
    }
     //===========================================
     case inherited::handleEvent(cmInit) of
     heAbort: { abort; exit; }
     heStop : { stop;  exit; }
     end;
   }

  cmDelOnProtect: {
   if (oDATFS<>NullRef) {
     var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
      if not _boEdit {
        message('У вас нет прав на изменение этого поля!');
        abort; exit;
      }
    }
     case inherited::handleEvent(cmDelOnProtect) of
     heAbort: { abort; exit; }
     heStop : { stop;  exit; }
     end;
  }
end;
end.
