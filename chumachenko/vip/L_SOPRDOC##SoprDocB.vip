/*************************************************************************************************\
* Наименование: Реестр приходных ордеров накладных                                                *
* Контур/Модуль: Управление снабжением                                                            *
* Пункт меню: Документы / Приходные накладные                                                     *
* Примечание:                                                                                     *
\*************************************************************************************************/
#include GP_DATFS_Base.vih
#include GP_DocFieldsStateService.vih

#component "L_SOPRDOC"

//******************************************************************************
Alter Interface SoprDocB;
//******************************************************************************
overload
  Procedure PosChange;
end;

Var
  oDATFS : GP_ObjDocAbleTuneFieldsState;
  iDatFS_base : GP_DATFS_Base;

procedure timelog(_str : string); {
#ifdef _DEBUG_DocFieldsStateService_
  iDatFS_base.enablelog;
  iDatFS_base.MyLog(_str);
#endif
}
//==========================================
Procedure PosChange;
{
   timelog('SoprDocB PosChange ');
  inherited::PosChange;
  if true { //BoEditSopr {
      if (oDATFS<>NullRef)
      oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
      timelog('SoprDocB PosChange after oDATFS.CalcAndApplyFieldsState');
  }
} //Procedure PosChange;

windowevent EDITSOPR;
cminit: {
  inherited::handleevent(cminit);
   if (oDATFS<>NullRef) {
     if katsopr.cIzd = 0h {
        var _cIzd : comp =  iDatFS_base.runwindowgetsubtip(101);
       set katsopr.cIzd := _cIzd;
     }
     timelog('SoprDocB windowevent EDITSOPR cminit');
     oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
   }
}
 cmMakeOrder : {
   if (oDATFS<>NullRef) {
     var _boOverload : boolean = oDATFS.isOverLoadButton(KatSopr.cIzd,cfsGetCurrentContainerSelf,cmMakeOrder);
      if _boOverload {
        message('_boOverload!');
        abort; exit;
      }
    }
   inherited::handleevent(cmMakeOrder)
 }
end;

Panel pnSopUsl
Table SpSopUsl;
HandleEvent
 cmPick : {
    if (oDATFS<>NullRef) {
      var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
      if not _boEdit { message('У вас нет прав на изменение этого поля!');
        abort; exit;
      }
    }
  Inherited::HandleEvent(cmPick);
  }
End;
End; //pnSopUsl

Panel basPanelKatSopr
  Table KatSopr;

Handleevent
cmPick: {
  if (oDATFS<>NullRef) {
    var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
    if not _boEdit {
      message('У вас нет прав на изменение этого поля!');
      stop; abort; exit;
    }
  }
  Inherited::HandleEvent(cmPick);
}
end;
end;

/*************************************************************************************************\
        События таблицы SpSopr
\*************************************************************************************************/

TableEvent Table SpSopr;
cmDelOnProtect: {
  if (oDATFS<>NullRef) {
    var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
    if not _boEdit {
      message('У вас нет прав на изменение этого поля!');
      abort; exit;
    }
  }
 Inherited::HandleEvent(CmDelOnProtect);
}
cmPick:
{
  if (oDATFS<>NullRef) {
    var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
    if not _boEdit {
      message('У вас нет прав на изменение этого поля!');
      abort; exit;
    }
  }
  case inherited::handleEvent(cmpick) of
   heAbort: { abort; exit; }
   heStop : { stop;  exit; }
  end;
}
End;

TableEvent Table SpSopUsl;
cmPick: {
    if (oDATFS<>NullRef) {
      var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
      if not _boEdit {
        message('У вас нет прав на изменение этого поля!');
        abort; exit;
      }
    }
  If inherited::handleevent(cmPick) = heAbort then abort;
}
cmDelOnProtect: {
 if (oDATFS<>NullRef) {
   var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
   if not _boEdit {
     message('У вас нет прав на изменение этого поля!');
     abort; exit;
   }
 }
 If inherited::handleevent(cmDelOnProtect) = heAbort then abort;
}
end; //TableEvent SpSoprUsl

//*****************************************************************************
// обработчик интерфейса
 handleEvent
   cmInit: {
     timelog('SoprDocB cminit TypeSopr = ' + string(TypeSopr));
    if (TypeSopr=101) {
      oDATFS:=GP_DocFieldsStateService::GetDocByName('SoprDocB');
       // обьект проверки кэшируется при повторном открытии - надо загнать туда 0 статусу
       oDATFS.CalcAndApplyFieldsState(0,cfsGetCurrentContainerSelf);
    }
     //===========================================
     case inherited::handleEvent(cmInit) of
     heAbort: { abort; exit; }
     heStop : { stop;  exit; }
     end;
   }

  cmDelOnProtect: {
   if (oDATFS<>NullRef) {
     var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
      if not _boEdit {
        message('У вас нет прав на изменение этого поля!');
        abort; exit;
      }
    }
     case inherited::handleEvent(cmDelOnProtect) of
     heAbort: { abort; exit; }
     heStop : { stop;  exit; }
     end;
  }


end;
end.
