Panel pnSpecif;
  Table SpSopr;
  Browse brbyName;
    Fields
//     [Atr_Sp] 'Дополя' : Protect, anLeft, anRight, NoPickButton, {button={command=cmPickAttr}};
     [Atr_Sp] 'Дополя' :[6],{button={command=cmPickAttr}};
  end;
end;
end;


windowevent EDITSOPR;
cminit: {
  inherited::handleevent(cminit);

   if (oDATFS<>NullRef) {
     if katsopr.cIzd = 0h {
        var _cIzd : comp =  iDatFS_base.runwindowgetsubtip(101);
        set katsopr.cIzd := _cIzd;
        updatetable;
        iDatFS_base.SetDefault(KatSopr.cIzd, katsopr.nrec);
        //var _strqry : string = 'update katsopr set nsopr = ''34546778'' where nrec = '+string(katsopr.nrec)+'';
        //message(_strqry + ' ' + sqlExecDirect(_strqry));
//        /set katsopr.nsopr := '34546778'
     }
     timelog('SoprDocB windowevent EDITSOPR cminit');
     oDATFS.CalcAndApplyFieldsState(KatSopr.cIzd,cfsGetCurrentContainerSelf);
     if firstrun=0
     {
       cfsGetProp('EDITSOPR','Title',namewin);
       firstrun:=1;
     }
     SetWindowTitle(EDITSOPR,SetNeWinTitle(namewin));
     PutCommand(CmValue48);
   }
}
 cmMakeOrder : {
   if (oDATFS<>NullRef) {
     var _boOverload : boolean = oDATFS.isOverLoadButton(KatSopr.cIzd,cfsGetCurrentContainerSelf,cmMakeOrder);
      if _boOverload {
        var _TypeCpNrec : word = 2000 + katsopr.vidsopr;

        /*подготовим массив записей для проверки атрибутов*/
        var _arAtr : arAttr;
        SetLimit(_arAtr,0);
        SetLimit(_arAtr,1);
        var _i : longint = 1;
        _arAtr[_i].nrec := Katsopr.nrec;
        _arAtr[_i].tabl := 1109;
        timelog('_i = '+ _i + '  _arAtr[_i].nrec = ' + string(_arAtr[_i].nrec) + ' _arAtr[_i].tabl = ' +_arAtr[_i].tabl);
        _loop spsopr {
          _i++;
          setlimit(_arAtr, getlimit(_arAtr)+1);
          _arAtr[_i].nrec := spsopr.nrec;
          _arAtr[_i].tabl := 1110;
           timelog('_i = '+ _i + '  _arAtr[_i].nrec = ' + string(_arAtr[_i].nrec) + ' _arAtr[_i].tabl = ' +_arAtr[_i].tabl);
        }

        timelog('getlimit(_arAtr) = ' + getlimit(_arAtr));
        /*end подготовим массив записей для проверки атрибутов*/
        if not oDATFS.CheckReqrAtr(_arAtr, Katsopr.cizd) { // проверить заполненность атрибутов
         ReReadRecord(tnKatSopr);
         ReReadRecord(tnSpSopr);
        //message('_boOverload!');
          abort; exit;
        }


        oDATFS.PushButton(KatSopr.cIzd,cfsGetCurrentContainerSelf,cmMakeOrder, _TypeCpNrec, katsopr.nrec, oDATFS);

        ReReadRecord(tnKatSopr);
        ReReadRecord(tnSpSopr);
        //message('_boOverload!');
        abort; exit;
      }
    }
   inherited::handleevent(cmMakeOrder)
 }
cmValue50:
{
!  Message('call 50');
 RunInterface('AVAZ_Logistics::Avaz_PrintM4',KatSopr.NRec);
};
CmValue48: { if cfsSetProp('c_BRBYNAME_ATR_SP',cfpIndex,integer(12))=cfOk {} }
end;

Panel pnSopUsl
Table SpSopUsl;
HandleEvent
 cmPick : {
    if (oDATFS<>NullRef) {
      var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
      if not _boEdit { message('У вас нет прав на изменение этого поля!');
        abort; exit;
      }
    }
  Inherited::HandleEvent(cmPick);
  }
End;
End; //pnSopUsl

Panel basPanelKatSopr
  Table KatSopr;

Handleevent
cmPick: {
  if (oDATFS<>NullRef) {
    var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
    if not _boEdit {
      message('У вас нет прав на изменение этого поля!');
      stop; abort; exit;
    }
  }
  Inherited::HandleEvent(cmPick);
}
!cmValue50:
!{
!  Message('call 50');
! RunInterface('AVAZ_Logistics::Avaz_PrintM4',KatSopr.NRec);
!};
end;
end;

/*************************************************************************************************\
        События таблицы SpSopr
\*************************************************************************************************/

TableEvent Table SpSopr;
cmDelOnProtect: {
  if (oDATFS<>NullRef) {
    var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
    if not _boEdit {
      message('У вас нет прав на изменение этого поля!');
      abort; exit;
    }
  }
 Inherited::HandleEvent(CmDelOnProtect);
}
cmPick:
{
  if (oDATFS<>NullRef) {
    var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
    if not _boEdit {
      message('У вас нет прав на изменение этого поля!');
      abort; exit;
    }
  }
  case inherited::handleEvent(cmpick) of
   heAbort: { abort; exit; }
   heStop : { stop;  exit; }
  end;
}
End;

TableEvent Table SpSopUsl;
cmPick: {
    if (oDATFS<>NullRef) {
      var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
      if not _boEdit {
        message('У вас нет прав на изменение этого поля!');
        abort; exit;
      }
    }
  If inherited::handleevent(cmPick) = heAbort then abort;
}
cmDelOnProtect: {
 if (oDATFS<>NullRef) {
   var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
   if not _boEdit {
     message('У вас нет прав на изменение этого поля!');
     abort; exit;
   }
 }
 If inherited::handleevent(cmDelOnProtect) = heAbort then abort;
}
end; //TableEvent SpSoprUsl

//*****************************************************************************
// обработчик интерфейса
 handleEvent
   cmInit: {
     timelog('SoprDocB cminit TypeSopr = ' + string(TypeSopr));
    if (TypeSopr=101) {
      oDATFS:=GP_DocFieldsStateService::GetDocByName('SoprDocB');
       // обьект проверки кэшируется при повторном открытии - надо загнать туда 0 статусу
       oDATFS.CalcAndApplyFieldsState(0,cfsGetCurrentContainerSelf);
       BindEvent(onCfgObjectsRequired, oDATFS.Event_onCfgObjectsRequired);
    }
     //===========================================
     case inherited::handleEvent(cmInit) of
     heAbort: { abort; exit; }
     heStop : { stop;  exit; }
     end;

      cfsSetProp('BRSOPUSL',   'RectA_Y', integer(39));
      cfsSetProp('scLongName_', 'RectA_Y', integer(36));
      cfsSetProp('ScLongName_', 'RectB_Y', integer(38));
      cfsSetProp('brbyName',   'RectB_Y', integer(35));
//      cfsSetProp('brbyName',   'RectB_Y', integer(37));

//     SetWindowTitle(EDITSOPR,SetNeWinTitle('EDITSOPR'));
//     SetWindowTitle(EDITSOPR,SetNeWinTitle('EDITSOPR'));
!      var sss: string ='';
      firstRun:=0;
   }

  cmDelOnProtect: {
   if (oDATFS<>NullRef) {
     var _boEdit:boolean=oDATFS.CanEditField(cfsGetCurrentContainerSelf,GetIfcCurrentSelfName);
      if not _boEdit {
        message('У вас нет прав на изменение этого поля!');
        abort; exit;
      }
    }
     case inherited::handleEvent(cmDelOnProtect) of
     heAbort: { abort; exit; }
     heStop : { stop;  exit; }
     end;
  }

end;
end.

