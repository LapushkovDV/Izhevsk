/*************************************************************************************************\
* Наименование: Объявление интерфейса GP_DATFS_Inv_Prih - функционал настройки прав доступа       *
*               к полям документа "Акты об излишках"                                              *
* Контур/Модуль: Складской учет                                                                   *
* Примечание:                                                                                     *
*                                                                                                 *
\*************************************************************************************************/

#include GP_DATFS_Inv_Prih.vih
#include Notes.vih
#include Inv_Prih.vih

#component "GP_Logistics"

interface GP_DATFS_Inv_Prih;

#include Notes.var

const
  ContainerName = 'L_Sklad::Inv_Prih';
  LoadFormDATFSName = 'IsLoadFormDATFS';
end;

function InitDocFields: boolean;
{
  result := false;

!  #ifndef _EM_218_
!  exit;
!  #endif

  var
    iInv_Prih: Inv_Prih;

  if not mService.IsContainerObjectExist(ContainerName)
  {
    SaveMyDsk(true, LoadFormDATFSName);
    _try
      if not LoadVipInterface(iInv_Prih)
        exit;
    _finally
      ClearMyDsk(LoadFormDATFSName);
  }

  mService.pbEmptyTitleAsFieldNameEnabled := true;

  _try
  {
    mFields.SetGroup('Кнопки');
    result:=mService.GrubFieldsFromContainer(mFields, ContainerName, 'SCRBUTHEADER');

    mFields.SetGroup('Шапка');
    result := mService.GrubFieldsFromContainer(mFields, ContainerName, 'ScrHeader');
    if result
    {
      mFields.ChangeTitle('KATSOPR.DESGR', 'Группа');
      mFields.ChangeTitle('KATSOPR.DESCR', 'Дескриптор');
      mFields.ChangeTitle('KATSOPR.NSOPR', 'Номер');
      mFields.ChangeTitle('KATSOPR.DSOPR', 'Дата');
      mFields.ChangeTitle('KATNOTES.NAME', 'Статус');
      mFields.ChangeTitle('INVTAB.NINV', 'Инвентаризация №');
      mFields.ChangeTitle('INVTAB.DINV', 'Инвентаризация от');

      mFields.ChangeTitle('KATPODR.NAME', 'Склад');
      mFields.ChangeTitle('KATMOL.NAME', 'МОЛ');
      mFields.ChangeTitle('KATSOPR.NAME', 'Примечание');
      mFields.ChangeTitle('KATNAZNA.NAME', 'Назначение');
      mFields.ChangeTitle('VALUT', 'Валюта суммы по акту');
      mFields.ChangeTitle('HOZOPERVIEWNAME', 'Операция');
      mFields.ChangeTitle('FOSNKOL', 'Количество');
      mFields.ChangeTitle('FDEI1KOL', 'в ДЕИ 1');

      // Дата оприходования товаров по акту
      mFields.Del('i_SCRHEADER');
      // Код склада
      mFields.Del('KATPODR.KOD');
      // Сумма
      mFields.Del('SUM');
      // в ДЕИ 2
      mFields.Del('FDEI2KOL');
      // Связь со штрих-кодом
      mFields.Del('BARKODANDSTATE');

      mFields.SetGroup('Спецификация');
      result := mService.GrubFieldsFromContainer(mFields, ContainerName, 'brSpecif');
      if result
      {
        // c_BRBYNAME
        mFields.Del('c_BRBYNAME');
        // №
        mFields.Del('SPSOPR.NPP');
        // Уч С
        mFields.Del('FSERIALCALC');
        // ДЕИ 2
        mFields.Del('KATDOPED2.SHORTNAME');
        // Количество в ДЕИ 2
        mFields.Del('SPDOPED2.KOL');
        // План работ
        mFields.Del('PLJOBNAME');
      }
    }
  }
  _finally
    mService.pbEmptyTitleAsFieldNameEnabled := false;

  if (iInv_Prih <> NullRef)
    FreeVipInterface(iInv_Prih);
}

constructor Init;
{
  mGroup := 'Складской учет';
  mTitle := 'Акт об излишках'; 
  mName := 'Inv_Prih';
  mVidDoc := oNotes.GetVidNoteByVidDoc(cgDoc_0611);

  result := InitDocFields;
}

end.
