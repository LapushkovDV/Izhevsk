#ifndef __GP_ObjDocAbleTuneFieldsState_OBJ__
#define __GP_ObjDocAbleTuneFieldsState_OBJ__

#include GP_ObjDocFields.obj

#component "GP_Common"

ObjInterface GP_ObjDocAbleTuneFieldsState;
  function CalcFieldsState(cSubType:comp):boolean; //Рассчитать состояние полей для текущего пользователя
  function ApplyFieldsState(CurContainer:tptr):boolean; //Применить состояние полей к документу
  function CalcAndApplyFieldsState(cSubType:comp;CurContainer:tptr):boolean; //Рассчитать состояние полей и применить к документу
  function CanEditField(CurContainer:tptr;ControlName:string):boolean; //Доступно ли редактирование поля
  function CanEditField_Status(cSubType:comp;CurContainer:tptr;ControlName:string):boolean;
  function getkaukod_subtip( _subtipVAZ : string): word;
  function runwindowgetsubtip(__viddoc : word) : comp;


  Function GenerateNewFile: string;
  Procedure MyLog(_str: string);
  procedure disableLog;
  procedure enableLog;
  function GetLogFile : string;

  procedure SetCheckProtectStateEnabled(pEnabled: boolean);

//-------- #3954 ------------------
  function CanEditRazdel(CurContainer:tptr;ControlName:string;Razdel:string;_cSubType:comp):boolean; //Доступно ли редактирование раздела
  function CanInsRazdel (CurContainer:tptr;ControlName:string;Razdel:string;_cSubType:comp):boolean; //Доступна ли вставка записей раздела
  function CanDelRazdel (CurContainer:tptr;ControlName:string;Razdel:string;_cSubType:comp):boolean; //Доступна ли удаление записей раздела
//--------------------------------------------
  property Fields:GP_ObjDocFields read write; //Поля документа
  property Group:string read; //Группа документа (Логистика\МТО\...)
  property Title:string read; //Отображаемое наименование документа
  property Name:string[127] read;  //Имя документа (должно быть уникальным)
  property VidDoc:word read;  //TiDkGal - для статуса
end;

#endif
