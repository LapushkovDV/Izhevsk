#include GP_DATFS_Base.vih
#include GP_DATFS_AktPerem.vih
#include AktOnPeremesch.vih

Interface GP_DATFS_AktONPeremesch;

  create view
  ;

function InitDocFields:boolean;
{
  result:=false;

  var
    iPerem: AktONPeremesch;
  var
    oLinkMtr2Spec,oLinkMtr2Spec2  : LinkMtr2Spec new;


  if (not mService.IsContainerObjectExist('L_Sklad::AktONPeremesch')) {
//    iPereSort.PickKatNotesAfter(rvMaxWord, rvMaxComp);
    if (not LoadVipInterface(iPerem))
      exit;
    if (not LoadVipInterface(oLinkMtr2Spec))
      exit;
    if (not LoadVipInterface(oLinkMtr2Spec2))
      exit;
    iPerem.InitVars;
  }

  mFields.SetGroup('Кнопки');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_Sklad::AktONPeremesch', 'SCRBUT1');

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields, 'L_Sklad::AktONPeremesch', 'S1');
  if result
  {
    mFields.ChangeTitle('KATPODR1_NAME','ОТКУДА: Склад');
    mFields.ChangeTitle('KATMOL1_NAME','ОТКУДА: МОЛ');
    mFields.ChangeTitle('KATPODR2_SNAME','КУДА: Склад');
    mFields.ChangeTitle('KATMOL2_SNAME','КУДА: МОЛ');

    mFields.Del('i_S1');
    mFields.Del('i_S1#1');    
    mFields.Del('i_S1#2');
    mFields.Del('i_S1#3');
    mFields.Del('i_S1#4');
    mFields.Del('i_S1#5');
    mFields.Del('i_S1_BARKODANDSTATE');

    mFields.SetGroup('Шапка_атрибуты');
    mService.GetAtrTable(mFields, 'L_Sklad::AktONPeremesch','ATTR_KATSOPR',word(1109));

    mFields.SetGroup('Спецификация');
    result := mService.GrubFieldsFromContainer(mFields, 'L_Sklad::AktONPeremesch', 'ListRasxod');
    if result
    {
      mFields.Del('c_LISTRASXOD');
      // №
      mFields.Del('SPSOPR.NPP_N');
      // Уч С
      mFields.Del('FSERIALSYM_Уч_С');
      // ДЕИ 2
      mFields.Del('RESSP_P');

      mFields.SetGroup('Спецификация_атрибуты');
      mService.GetAtrTable(mFields, 'L_Sklad::AktONPeremesch','ATR_SPSOPR',word(1110));

      // Количество в ДЕИ 2
!      mFields.Del('SPDOPED2.KOL');
        // Серийный номер
!      mFields.Del('FSERIALNUM');

/*      mFields.SetGroup('ЦУ-Откуда');
      result := mService.GrubFieldsFromContainer(mFields, 'L_SALDOMTR::LINKMTR2SPEC', 'SCKAU10');
      if result
      {
//        Message('Is Load  LINKMTR2SPEC');
      }
      mFields.SetGroup('ЦУ-Куда');
      result := mService.GrubFieldsFromContainer(mFields, 'L_SALDOMTR::LINKMTR2SPEC', 'SCKAU10');
*/
    }
  }

  if (iPerem <> NullRef)
  {
    iPerem.DoneVars;
    FreeVipInterface(iPerem);
    FreeVipInterface(oLinkMtr2Spec);
    FreeVipInterface(oLinkMtr2Spec2);
  }
}

constructor Init;
{
  mGroup := 'Складской учет';
  mTitle := 'Акт на перемещение между объектами'; 
  mName := 'AktONPeremesch';
  mVidDoc := 632;
  result := InitDocFields;
}
end.
