//#include SchfFuncs.vih
#include SchfFuncs_Ext.vih

#define OBJINT_ALGORITM
#include objintpl.vin

#component "M_MnPlan"
VipInterface Algoritm_Make_Schfact implements oAlgoritm_Sys;
Interface Algoritm_Make_Schfact;

//#include SchfFuncs.var
var oSchfFuncs: SchfFuncs_EXt;

create view
var
 cWorkFormPl,cdoc: Comp;
 wEvnCode: Word;
 sEvnLine: String;
 DatOper: date;

from
  FormPl(ReadOnly)
 ,katsopr
where ((
  //'настройка алгоритма
  cWorkFormPl         == FormPl.NRec
  and cdoc  == Katsopr.nrec
))
 ;

exception ExUser1, ExUser2;

#include MakeOptionsByDefines.vpp

Function GetNum : word;
{
  GetNum := 6602;
}

function GetName : string;
{
  GetName := 'Создание с/ф по накладной';
}

Function GetMemo ( st:oSteckCommonString ) : Boolean;
{
  GetMemo := True;

  st.push('Данный алгоритм созадет счет-фактиуру по накладным на продажу/закупку');
}

Function GetNameInter : String;
{
  GetNameInter := 'Algoritm_Make_Schfact' ;
}

Function GetNameInterPr : String;
{
  GetNameInterPr := 'AlgoritmSetup_Make_Schfact' ;
}

//=======================================================================
// 'ИНИЦИАЛИЗАЦИЯ АЛГОРИТМА'
//-----------------------------------------------------------------------
//'коды ситуаций - до 49 включительно
Function InitInter( Var pt:TRecAcc ) : Boolean;
{
  InitInter := False;

_try
{
 pt.Visua    := Word(0);
 pt.MessEnd  := Word(0);

  cWorkFormPl := pt.cFormPl;
  if (GetFirst FormPl <> tsOk)
  {
   wEvnCode := 1;
   sEvnLine := 'Пользовательский алгоритм не найден (скорее всего, он был удален)';
   _raise ExUser2;
  }

 InitInter := True;
}  //'_try

_except
 on ExUser1:
  pt.Error := 1;

 on ExUser2:
 {
  Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally
{
 //'
}
}

//=======================================================================
// 'ЗАВЕРШЕНИЕ РАБОТЫ С ИНТЕРФЕЙСОМ'
//-----------------------------------------------------------------------
Function DoneInter( Var pt:TRecAcc ) : Boolean;
{
 #__UNUSED__(pt)
 DoneInter := True;
}

/*
 Function CanMakeOrder : date;
 {
  CanMakeOrder:=katsopr.dsopr;
  oSoprOrdB.CheckSoprOrdB(KatSopr.nRec, katsopr.cpodrto, katsopr.cmolto, true, true, TRUE, false, boGetTune('DOC.BUY.AUTOMakePartyKN'), 0);
 }

 */
//=======================================================================
Function RunInter( wflag:Word; Var pt:TRecAcc ) : Boolean;
{
  #__UNUSED__(wflag)

!  Message('Call Algoritm_SkladMove ='+pt.TypeCpNrec);

_try {
  RunInter := False;

  if (pt.Visua = 0)
    StartNewVisual(vtRotateVisual, vfTimer+vfBreak+vfConfirm,GetName+'...', 0);

//  Message('000 pt.cpnRec='+pt.cpnRec);
  cdoc:=pt.cpnRec;
  if getfirst katsopr<>tsok
    exit;

  if (katsopr.vidsopr<>101 and katsopr.vidsopr<>201)
  {
    Message('с/ф создаются только по накладным сбыта/снабжения');
    exit;
  }

  oSchfFuncs.MakeSchFact_EXt(KatSopr.NRec);
}  //'_try

_except
 on ExUser1: pt.Error := 1;

 on ExUser2:{
   Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally {
  if (pt.Visua = 0) StopVisual('', 0);

  DoneInter(pt);
}
}
end.