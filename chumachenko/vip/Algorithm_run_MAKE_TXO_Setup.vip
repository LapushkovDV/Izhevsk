/*************************************************************************************************\
*  Наименование: Настройка алгоритма для контроля цены в накладной на соответствие данным договора
*  Контур/Модуль: КОУ
*  Примечание:
*  Вид работы  |Номер           |Дата    |Исполнитель              |Проект
*  -----------------------------------------------------------------------------------------------
\*************************************************************************************************/

#include Algor.vih
#include PSManager.vih
#include getsnote.vih

#component "M_MnPlan"

VipInterface Algorithm_run_MAKE_TXO_Setup Implements oAlgoritmSetup
Parameters ( nrecFormPl : comp) licensed (FREE);

Interface Algorithm_run_MAKE_TXO_Setup 'Настройка алгоритма привязки ТХО', EscClose, Blue;

Show at (,,85,20);

Create view
var
   iPSManager : PSManager;
   nrecFormPl
 , _cTXO : comp;
   objNote  : IGetSomKatNotes;
as select
  if(isvalidall(tnHozOper), HozOper.name1, '--выберите ТХО--') (fieldname = txoname)
, if(isvalidall(tnKatNotes_ok)   , KatNotes_ok.name, '--выберите статус--') (fieldname = StatusOK)
, if(isvalidall(tnKatNotes_notok), KatNotes_ok.name, '--выберите статус--') (fieldname = StatusNotOk)
from HozOper
   , KatNotes KatNotes_ok
   , KatNotes KatNotes_notok
where  ((
           nrecFormPl  == FormPl.NRec
and FormPl.RESCOMP[1] == HozOper.nrec
and FormPl.RESCOMP[2] == KatNotes_ok.nrec
and FormPl.RESCOMP[3] == KatNotes_notok.nrec
 ))
;
Parameters
  nrecFormPl;

screen scMain ;
 Fields
  tipdocname : Protect, PickButton, {Font = {BackColor = if(isvalidall(tnHozOper),0,ColorNeed)}};
  txoname    : Protect, PickButton, {Font = {BackColor = if(isvalidall(tnHozOper),0,ColorNeed)}};
  FormPl.RESWORD[2] : noprotect;
  StatusOK    : Protect, PickButton, {Font = {BackColor = if(isvalidall(tnKatNotes_ok)   , 0, ColorNeed)}};
  FormPl.RESWORD[3] : noprotect;
  StatusNotOK : Protect, PickButton, {Font = {BackColor = if(isvalidall(tnKatNotes_notok), 0, ColorNeed)}};
  FormPl.RESWORD[1] : noprotect;
 buttons
  cmOK;
<<'Настройка алгоритма привязки ТХО'
      тип документа .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   ТХО для привязки .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@


[..] - при успешной привязке ТХО установить статус   ` .@@@@@@@@@@@@@@
[..] - при НЕ успешной привязке ТХО установить статус` .@@@@@@@@@@@@@@


[.] - показывать лог привязки ТХО`

                          <.   ok   .>
>>
end;



Function asInitInter(p_cFormPl : Comp) : Boolean;{
  #__UNUSED__(p_cFormPl)
    asInitInter := True;
}
//Завершение работы с интерфейсом настройки. Освобождаются переменные.
Function asDoneInter : Boolean;{
 asDoneInter := True;
}

//Вызывается после создания новой настройки (записи в таблице FormPl). Используется для начальной инициализации полей.
Procedure asOnCmSetDefault;{
}
//Вызывается после вставки настройки в шаблон документа на закладку "Параметры автоматического формирования \ Алгоритмы". Шаблоны документов хранятся в таблице WayAccou. В данной процедуре заполняются те поля настройки, которые зависят от конкретного шаблона. В нашем примере это поле "Тип документа".
Procedure asOnSetWayAccou(p_cWayAccou : Comp);{
#__UNUSED__(p_cWayAccou)
}
handleevent
cmInit: {
  if getfirst FormPl <> tsOK {
    message('Не найдена настройка алгоритма',error);
    exit;
  }
  rereadrecord;
}
cmPick: {
   case curfield of
    #tipdocname : {

      set FormPl.RESCOMP[1] := 0h;
      set FormPl.RESCOMP[2] := 0h;
      set FormPl.RESCOMP[3] := 0h;
     }
    #txoname: {
        var _cPlanNo: comp;
        var _wPar: word;
         iPSManager.GetTunePlansSch(_cPlanNo);
         //_wPar := word(BuhRep.cPlansSch);
         if (RunInterface('F_TXO::GETHOZOPER', _cPlanNo, _wPar, 0, FormPl.RESCOMP[1], cgiPick+cgiPickExt) <> cmCancel) then {
           set FormPl.RESCOMP[1] := FormPl.RESCOMP[1];
         }
     }
    #StatusOK : {
      var tmpNrec : comp;
       If(RunInterface('L_Dogovor::GetSomKatNotes', FormPl.RESWORD[4], 0, 0, False, tmpNrec, objNote) = CmDefault) {
       Set SpFormPl.resComp1[2] := tmpNrec;
       ReScanPanel(tnFormPl);
      }
     }
    #StatusNotOK : {
      var tmpNrec : comp;
       If(RunInterface('L_Dogovor::GetSomKatNotes', FormPl.RESWORD[4], 0, 0, False, tmpNrec, objNote) = CmDefault) {
       Set SpFormPl.resComp1[3] := tmpNrec;
       ReScanPanel(tnFormPl);
      }
     }
   end;
  update current FormPl;
  rereadrecord;
}
cmCheckField: {
    update current FormPl;
}
cmOK: {
  update current FormPl;
  closeinterface(cmDefault)

}
end;
End.
