#include Move_Mbp_MakeOrder.vih

#component "F_MBP"

Interface Move_MBP_MakeORder;
  function SetPos(_cDoc: comp): boolean;
  {
    result := getfirst mbpmove where ((_cDoc == mbpmove.Nrec)) = tsOk;
    if result
    {
      ProcessCommand(cmPositionChanged);
      ReReadRecord;
      MakeOper(true, true);
    }
  }


 HandleEvent
   CmInit :{
             if (inherited :: HandleEvent(cmInit) = heAbort)
             {
               Abort; Exit;
             }
           }
  end;
end.