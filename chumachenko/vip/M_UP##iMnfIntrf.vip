#Component "M_UP"

alter interface IMNFINTRF;
#include GP_GSinfobetween.var

Overload
  Procedure objHndlMnf.DefaultEditWindow(_vMnfRec: comp);
end;

Procedure DefaultEditWindow(_vMnfRec: comp);
{
  if (ix.GetNaklTip=TypeMnfDoc)
    if ix.GetNaklTitle<>''
    {
      SetTitle('Редактирование '+StringNameInterface+' '+ix.GetNaklTitle);
      SetFormat(scEditWindow);
      exit;
    }

  SetTitle('Редактирование '+StringNameInterface);
  SetFormat(scEditWindow);
}

HandleEvent

/*
cmChangeTabbedSheetFormat :
{
  if (ix.isflag(TypeMnfDoc)=True)
 {
  abort;
  exit;
 }

 inherited::handleEvent(cmChangeTabbedSheetFormat);
}
*/

cmChangeTabbedSheetFormat :
{
Message('Call cmChangeTabbedSheetFormat');

  if (not UpdateTable)
  {
    Abort;
    Exit;
  };//if
  var pTarget: longint; pTarget := longint(0);
  case Target of
    scListDoc     : pTarget := longint(1);
    scEditWindow  : pTarget := longint(2);
    brsnObjAcct01 : pTarget := longint(3);
  end;//case

  iMnfDskFuncs.liSaveValue ('', pTarget, 'iMnfIntf_Target');
  _vvvMnfRec := viManufObj.Get_NRec_MnfDoc(_v_Kak_View);
  pTarget := longint(0);
  iMnfDskFuncs.liSaveValue ('', pTarget, 'iMnfIntf_Target');
  case FocusedFormat of
    scEditWindow :
    {
      if (_vvvMnfRec = comp(0))
      {
        Message('Данные не модифицированы!',Information);
        Abort;
        Exit;
      };//if
      viManufObj.RefResh;
        #IfDef ext_NaklDone
          ext_NaklDone(_vvvMnfRec);
        #End
    }//scEditWindow
  end;//case

  case Target of
    scListDoc :
    {
      if (GetEmbeddedInterfaceReference(scListDoc, viManufObjTmp))
      {
        FreeVipInterface(viManufObjTmp);
        SetTitle('Список '+StringNameInterface+viManufObj.GetInterfaceTitle());
      }
      else
      {
        viManufObj.SetHndlNew(objHndlMnf(SELF));
        BindEmbeddedInterface(scListDoc,viManufObj);
        BindEvent(SetListTitle, viManufObj.WasChangedFilter);
        SetTitle('Список '+StringNameInterface+viManufObj.GetInterfaceTitle());
      };//if
      Change_Color(word(0));
    }//scListDoc
    scEditWindow :
    {
      Message('seet scEditWindow');
      SetTitle('Редактирование '+StringNameInterface+'/Test/');
      case FocusedFormat of
        scListDoc : {};
        brsnObjAcct01 : {};
      end;//case
      Change_Color(word(1))
    }//scEditWindow
    brsnObjAcct01 :
    {
      if (NullVipRef(viAttachDoc))
      {
        if (not LoadVipRef(viAttachDoc,'iAttachDoc'))
        {
          Message('Системная ошибка !!!'+
                  'Не загружен интерфейс <iAttachDoc>',Information);
          Abort;
          Exit;
        };//if
      };
      if (GetEmbeddedInterfaceReference(brsnObjAcct01,viAttachDoctTmp))
      {
        FreeVipInterface(viAttachDoctTmp);
      }
      else
      {
        BindEmbeddedInterface(brsnObjAcct01, viAttachDoc);
      };//if

      SetTitle('Редактор связей '+StringNameInterface);
      if (_vvvMnfRec <> 0)
        viAttachDoc.InitInter(0, KakouDoc, _vvvMnfRec, 1, _v_Kak_View);
      Change_Color(word(1))
    }//brsnObjAcct01
  end;//case
}//cmChangeTabbedSheetFormat
end;
end.
