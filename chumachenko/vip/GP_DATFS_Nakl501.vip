#include GP_DATFS_Base.vih

#include Notes.vih
#include oiNakl501.vih

#include GP_DATFS_Nakl501.vih
interface GP_DATFS_Nakl501;

#include Notes.var

function InitDocFields:boolean;
{
  result:=false;

  var iMnfObj:ObjManufSch;
  if (not mService.IsContainerObjectExist('M_UP::NAKL501')) {
    if (not LoadVipRef(iMnfObj,'M_UP::NAKL501')) //Необходимо загрузить класс из ресурса для работы GrubFieldsFromContainer
      exit;

    iMnfObj.InitInter(0,501);
  }

  mFields.SetGroup('Кнопки');
  result:=mService.GrubFieldsFromContainer(mFields, 'M_UP::NAKL501', 'ScrHeader',1);

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields,'M_UP::NAKL501','ScrHeader',2);
  mFields.ChangeTitle('KATSOPR.NAME','Наименование накладной');
  mFields.ChangeTitle('KATPODR.NAME','ОТКУДА: Склад');
  mFields.ChangeTitle('KATMOL.NAME','ОТКУДА: МОЛ');
  mFields.ChangeTitle('TOPODR.NAME','КУДА: Подразделение');
  mFields.ChangeTitle('TOMOL.NAME','КУДА: МОЛ');

  mFields.SetGroup('Шапка_атрибуты');
  mService.GetAtrTable(mFields, 'M_UP::NAKL501','ATTR_KATSOPR',word(1109));

  if (result) {
    mFields.SetGroup('Спецификация');
    result:=mService.GrubFieldsFromContainer(mFields,'M_UP::NAKL501','brSpecif'+if(wGetTune('Pick.SortMC') = 1,'','1'));
    mFields.ChangeTitle('RPOS','P, + - позиция зарезервирована');
    mFields.Del('SPSOPR.NVAGON');

    mFields.SetGroup('Спецификация_атрибуты');
    mService.GetAtrTable(mFields, 'M_UP::NAKL501','ATR_SPSOPR',word(1110));
  }

  if (iMnfObj<>NullRef) {
    iMnfObj.DoneInter;
    FreeVipInterface(iMnfObj);
  }
}

constructor Init;
{
  mGroup:='Управление производственной логистикой';
  mTitle:='Накладная на отпуск в производство';
  mName:='Nakl501';
  mVidDoc:=501;

  result:=InitDocFields;
}
end.
