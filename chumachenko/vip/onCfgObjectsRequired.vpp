/*
чтобы отработала проверка обязательных полей надо:
1. инклюдить данный файл в альтер интерфейса
...
#include onCfgObjectsRequired.vpp
...

2. в инициализации интерфейса добавить связывание событий и функции
...
    BindEvent(onCfgObjectsRequired, oDATFS.Event_onCfgObjectsRequired);
...
пример:
alter interface
create view
;
#include onCfgObjectsRequired.vpp
handleevent
cminit: {

    if (TypeSopr=101) {
       oDATFS:=GP_DocFieldsStateService::GetDocByName('SoprDocB');
       // обьект проверки кэшируется при повторном открытии - надо загнать туда 0 статусу
       oDATFS.CalcAndApplyFieldsState(0,cfsGetCurrentContainerSelf);
       BindEvent(onCfgObjectsRequired, oDATFS.Event_onCfgObjectsRequired);
    }

}
end;
end.

*/

function onCfgObjectsRequired(_cfgFName: string): boolean; {
    result := true;
    var _errLotExpr : string; // Message(err);
    var _resLoexpr : string = trim(LotExpressionFunc(_cfgFName, _errLotExpr));
      if (_resLoexpr = '') or (_resLoexpr = 'Ошибка при вычислении') {
        Result := false;
      }
}
