#include GP_DATFS_Base.vih

#include Spis_MBP.vih

#include GP_DATFS_Spis_MbpInv.vih

#component "GP_Logistics"
interface GP_DATFS_Spis_MBP_10;

var iDatFS_base : GP_DATFS_Base;

function InitDocFields:boolean;
{
  result:=false;

  var iSD:Spis_MBP;
  if (not mService.IsContainerObjectExist('F_MBP::Spis_MBP')) {
    if (not LoadVipInterface(iSD)) //Необходимо загрузить класс из ресурса для работы GrubFieldsFromContainer
      exit;   
  }

  mFields.SetGroup('Кнопки');
  result:=mService.GrubFieldsFromContainer(mFields, 'F_MBP::Spis_MBP', 'SCRNEDOST',1);
!  Message('result1='+result);

  mFields.SetGroup('Шапка');
  result:=mService.GrubFieldsFromContainer(mFields, 'F_MBP::Spis_MBP', 'SCRNEDOST',2);
!  Message('result2='+result);
  mFields.ChangeTitle('MBPMOVE.DESGR','Код группы пользователей');
//  mFields.Del('fOsnKol');
  mFields.SetGroup('Шапка_атрибуты');
  mService.GetAtrTable(mFields, 'F_MBP::Spis_MBP','ATTR_MBPMOVE',word(2003));


  if (result) {
    mFields.SetGroup('Спецификация');
    result:=mService.GrubFieldsFromContainer(mFields, 'F_MBP::Spis_MBP', 'BROUTNEDOST');
    mFields.Del('V');
    mFields.Del('У');

    mFields.SetGroup('Спецификация_атрибуты');
    mService.GetAtrTable(mFields, 'F_MBP::Spis_MBP','ATTR_MBPOUT',word(2002));
  }

  mFields.SetGroup('Информация к позиции спецификации');
  result:=mService.GrubFieldsFromContainer(mFields, 'F_MBP::Spis_MBP', 'SCOUTNEDOST');  
  mFields.Del('MBPIn.Price');
  mFields.Del('MBPOut.tKol');
  mFields.Del('WorkEd');
  mFields.Del('MBPOut.Kol');


!  Message('result3='+result);

  if (iSD<>NullRef) {
    FreeVipInterface(iSD);
  }
}

constructor Init;
{
  mGroup := 'Учет МБП';
  mTitle := 'Акт о недостаче инвентаризация'; 
  mName := 'Spis_MBP_10';
  mVidDoc := 737;

  result := InitDocFields;
}
end.
