procedure filltTxoTipDoc; {
  delete all tTxoTipDoc;
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 101, tTxoTipDocIns.name := 'Приходная накладная /снабжение/';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 106, tTxoTipDocIns.name := 'Накладная на возврат товаров по рекламации в продаже';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 201, tTxoTipDocIns.name := 'Накладная на отпуск МЦ на продажу /сбыт/';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 204, tTxoTipDocIns.name := 'Акт на списание МЦ со склада /склад/';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 501, tTxoTipDocIns.name := 'Накладная на отпуск в производство /склад-подразделение/';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 502, tTxoTipDocIns.name := 'Накладная на приход готовой продукции из производства /по';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 503, tTxoTipDocIns.name := 'Накладная на возврат сырья из производства /подразделение';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 504, tTxoTipDocIns.name := 'Акт на списание МЦ из производства /подразделение/';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 505, tTxoTipDocIns.name := 'Межцеховая накладная (полуфабрикат) /подразделение-подраз';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 506, tTxoTipDocIns.name := 'Накладная на внутреннее перемещение в производстве (МЦ) /';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 507, tTxoTipDocIns.name := 'Акт на брак';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 508, tTxoTipDocIns.name := 'Акт на оказание услуг';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 521, tTxoTipDocIns.name := 'Накладная на отпуск сырья на переработку (ДВС)';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 522, tTxoTipDocIns.name := 'Накладная на приход готовой продукции из переработки (ДВС';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 523, tTxoTipDocIns.name := 'Накладная на приход сырья из переработки (ДВС)';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 532, tTxoTipDocIns.name := 'Накладная на расход сырья /по накладной на приход готовой';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 600, tTxoTipDocIns.name := 'Накладная на внутреннее перемещение МЦ со склада на склад';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 611, tTxoTipDocIns.name := 'Акт об излишке МЦ на складе';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 601, tTxoTipDocIns.name := 'Накладная на передачу МЦ в ОС';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 602, tTxoTipDocIns.name := 'Накладная на передачу МЦ в спецоснастку';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 626, tTxoTipDocIns.name := 'Акт на возврат оборудования и материалов';
   insert tTxoTipDocIns set tTxoTipDocIns.tipdoc := 615, tTxoTipDocIns.name := 'Инвентаризационная опись складского учета';
}
