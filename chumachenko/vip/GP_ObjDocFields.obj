#ifndef __GP_ObjDocFields_OBJ__
#define __GP_ObjDocFields_OBJ__

#component "GP_Common"
Type TDef_Control= Record
  _ObjType       :longint;
  _StatusCtx     :longint;
  _Protect       :boolean;
  _CalendarBut   :boolean;
  _CalcButton    :boolean;
  _PickButton    :boolean;
  _SpinButton    :boolean;
end;

type GP_DocFieldInfo = record
  Name:string;
  Title:string;
  Control:string;
  ObjType:longint;
  PropProtect:boolean;
  PropDefPickButton:boolean;
  PropButtonType:integer;
  PropStatusCtx:word;
  OrigFontColor:boolean;
  PropFontColor:word;
end;

ObjInterface GP_ObjDocFields;
  procedure SetGroup(GroupName:string);
  procedure SetRootContainer(RootContainer:string);
  procedure SetContainer(Container:string);
  procedure Add(DFI:GP_DocFieldInfo; _pDef_Control:TDef_Control);
  procedure Del(_Name:string);
  procedure ChangeTitle(_Name, NewTitle:string);
  procedure SetPickButton(pFieldName: string; pValue: boolean);
  procedure SetCalendarButton(pFieldName: string; pValue: boolean);
  procedure UseOrigFontColor(_Name:string);

  property Num:longint read;  //Номер поля
  property Group:string read; //Группа полей (Шапка\спецификация\...)
  property Title:string read; //Отображаемое наименование поля
  property Name:string read;  //Имя поля
  property RootContainer:string read; //Имя интерфейса (как в конфигураторе)
  property Container:string read; //Имя контейнера (как в конфигураторе)
  property ControlName:string read; //Имя элемента управления связанного с полем (как в конфигураторе)
  property State:word;        //Состояние поля
  property IsUsed:boolean;    //Поле участвует в настройке прав доступа

  function GetDocFieldInfo:GP_DocFieldInfo;
//-----------------------------------
  property Def_ObjType     :longint;//cfsGetObjInfo(ObjList[I], ObjFullName, ObjSelf, ObjContainer, ObjType)
  property Def_StatusCtx   :longint; // статус по умолчанию cfpStatusCtx
  property Def_Protect     :boolean; // поле закрыто        cfpProtect
  property Def_CalendarBut :boolean; //cfpCalendarButton
  property Def_CalcButton  :boolean; //
  property Def_PickButton  :boolean; //
  property Def_SpinButton  :boolean; //
//-----------------------------------
  index iNum      = Num;
  index iName     = Group, Name;
  index iIsUsed   = IsUsed, RootContainer, ControlName;
end;

#endif
