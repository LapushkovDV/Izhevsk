/*
drop table GP_TuneDocFields;
drop table GP_FieldsStateMatrix;
drop table GP_DocExtAttr;
drop table GP_UserRolesByDate;
*/
Create table GP.GP_TuneDocFields "Настройка состояния полей документов"
  With table_Code = 31594
  With replace
  With TableOptions Branched
  (
    NRec         : comp        "Номер записи",
    DocName      : string[127] "Имя документа",
    DocFieldGroup: string      "Группа полей",
    DocFieldName : string      "Имя поля",
    IsUsed       : boolean     "Поле используется в настройке"
  )
  With index
  (
    TuneDocFields01 = nRec(Unique, Surrogate, Journal),
    TuneDocFields02 = DocName + DocFieldGroup + DocFieldName
  );

Create table GP.GP_FieldsStateMatrix "Матрица состоянии полей документов"
  With table_Code = 31595
  With replace
  With TableOptions Branched
  (
    NRec      : comp          "Номер записи",
    cDocField : Ref(GP_TuneDocFields) "Настройка поля документа",
    cRole     : Ref(r_Role)   "Роль",
    cStatus   : Ref(KatNotes) "Статус",
    State     : word          "Состояние"
  )
  With index
  (
    FieldsStateMatrix01 = nRec(Unique, Surrogate, Journal),
    FieldsStateMatrix02 = cDocField + cRole + cStatus
  );

Create table GP.GP_DocExtAttr "Настройка отображения внешних атрибутов"
  With table_Code = 31579
  With replace
  With TableOptions Branched
  (
    NRec        : comp "Номер записи",
    cWayAccou   : ref(WayAccou) "Шаблон документа",
    Number      : word "Номер поля",
    FrandlyName : string "Наименование поля",
    cAttrNam    : ref(AttrNam) "Внешний атрибут"
  )
  With index
  (
    DocExtAttr01 = NRec(Unique, Surrogate, Journal),
    DocExtAttr02 = cWayAccou + Number,
    DocExtAttr03 = cWayAccou + cAttrNam
  );

Create table GP.GP_UserRolesByDate "Роли пользователей по датам"
  With table_Code = 31577
  With replace
  With TableOptions Branched
  (
    NRec     : comp         "Номер записи",
    cUser    : Ref(r_Users) "Пользователь",
    cRole    : Ref(r_Role)  "Роль пользователя",
    DateBeg  : date         "Дата начала",
    DateEnd  : date         "Дата завершения",
    cBase    : Ref(SpKau)   "Основание назначения"
  )
  With index
  (
    UserRolesByDate01 = nRec(Unique, Surrogate, Journal),
    UserRolesByDate02 = cUser+DateBeg(desc)
  );
