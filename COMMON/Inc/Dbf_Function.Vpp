//===============================
// таблица для хранения струтуры
//===============================
Table Struct tmp_StructTable
(  fNum: integer //- порядковый номер поля в таблице.
  ,iName: string //- имя поля, возвращаемый параметр.
  ,iType: byte  //- тип поля, возвращаемый параметр.
  ,iLen: integer //- длина поля, возвращаемый параметр.
  ,iDigit: integer //- длина дробной части поля, возвращаемый параметр.


)
with index
( tmp_StructTable01 = fNum
);

//===============================
Create view DBFSTRU
//===============================
Var Handler:Longint;
as select tmp_StructTable.*
From tmp_StructTable(tmp_StructTable01)
;

//===============================
// лог
//===============================
Procedure DBF_Log(w:string);
{ if logfilenm <>''
  { logstrtofile(logfilenm,w)
  }
}
//===============================
// заменить мусор на чего нибудь
//===============================
Function CheckStringForGal(const wwval:string) :string ;
var wwstr :string ;
 w:string[1] ;
 wwii:word ;
{ wwstr:='' ;
  for(wwii:=1;wwii<=length(wwval);inc(wwii))
  { w:=substr(wwval,wwii,1)
    if ord(w)>=241 then w:='-' ;
    if ord(w)<32 then w:='-' ;
    wwstr:=wwstr+w ;
  }
  CheckStringForGal:=wwstr ;
}

//===============================
// прочитать строковое поле из dbf
//===============================
Function DBF_ReadField(const wHandler :longint;const nmfield :string;var field_val :string):word ;
{ DBF_ReadField:=0
  if whandler<=0 
  { DBF_ReadField:=1 ;
    exit ;
  
  }
  field_val:=trim(DBFGetFieldValue(WHandler, nmfield))
  if field_val='ERROR'
  {  DBF_ReadField:=2 ;
     field_val:='' ;
  }
} // DBF_ReadField


//===============================
//
//===============================
Function DBF_ReadField1(const wHandler :longint;const nmfield :string;var field_val :string):word ;
{ field_val:='' ;
  DBF_ReadField1:=DBF_ReadField(wHandler,nmfield,field_val)
  if pos('.',field_val)>0
   field_val:=substr(field_val,1,pos('.',field_val)-1)
}

//===============================
// прочитать поле типа date из dbf
//===============================
Function DBF_ReadFieldDate(const wHandler :longint;const nmfield :string;var field_val :date):word ;
var w :string ;
{ w:='' ;
  DBF_ReadFieldDate:=DBF_ReadField(wHandler,nmfield,w)
  if w<>''
  { field_val:=StrToDate(w,'YYYYMMDD') ;
  }
  else field_val:=date(0,0,0) ;
}

//===============================
// прочитать поле типа double из dbf
//===============================
Function DBF_ReadFieldDouble(const wHandler :longint;const nmfield :string;var field_val :double):word ;
var w :string ;
{ w:='' ;
  DBF_ReadFieldDouble:=DBF_ReadField(wHandler,nmfield,w)
  if w<>''
  { field_val:=double(w) ;
  }
  else field_val:=0 ;
}

//===============================
// прочитать поле типа longint из dbf
//===============================
Function DBF_ReadFieldLInt(const wHandler :longint;const nmfield :string;var field_val :longint):word ;
var w :string ;
{ w:='' ;
  DBF_ReadFieldLInt:=DBF_ReadField(wHandler,nmfield,w)
  if w<>''
  { field_val:=longint(w) ;
  }
  else field_val:=0 ;
}

//===============================
// прочитать поле типа word из dbf
//===============================
Function DBF_ReadFieldWord(const wHandler :longint;const nmfield :string;var field_val :word):word ;
var w :string ;
{ w:='' ;
  DBF_ReadFieldWord:=DBF_ReadField(wHandler,nmfield,w)
  if w<>''
  { field_val:=word(w) ;
  }
  else field_val:=0 ;
}


//===============================
// Открыть файл
//===============================
Function Dbf_OpenFile( wnmpath:string;wnmdbf:string) :Longint ;
var WHandler:longint ;
{ Dbf_OpenFile:=0 ; 
  wnmdbf:=wnmdbf+'.dbf'
  if wnmdbf='' then exit ;
  if not fileexist(wnmpath+'\'+wnmdbf) then
  { //logstrtofile(wlogfilenm,'нет файла '+nmpath+'\'+nmdbf)
    Dbf_OpenFile:=-1 ; 
    exit
  }
  WHandler     := DBFOpen(wnmpath+'\'+wnmdbf, stOpen);
  if WHandler=0
  { //logstrtofile(wlogfilenm,'Ошибка открытия '+nmpath+'\'+nmdbf)
    Dbf_OpenFile:=-2 ; 
    exit ;
  }
  Dbf_OpenFile:=WHandler ;
} //Function Dbf_OpenFile( wnmpath:string;wnmdbf:string) :Longint ;


//===============================
// Прочитать структуру
//===============================
Function Dbf_ReadFileStruct(ww_Handler:Longint; var ww_err:string) :boolean ;
Var jj:longint;
    ww_Count_fld:longint;
    ww_fNum  : integer// - порядковый номер поля в таблице.
    ww_iName : string // - имя поля, возвращаемый параметр.
    ww_iType : byte   // - тип поля, возвращаемый параметр.
    ww_iLen  : integer// - длина поля, возвращаемый параметр.
    ww_iDigit: integer// - длина дробной части поля, возвращаемый параметр.
    
{  Result:=False
   ww_err:='';
   if ww_Handler=0 then
   { ww_err:='Dbf_ReadFileStruct Не открыт Handle таблицы!'
     exit
   }
   DBFSTRU.Handler:=ww_Handler
   DBFSTRU.delete all tmp_StructTable;
   ww_Count_fld:=DBFFieldsCount(ww_Handler);
   for(jj:=0;jj<ww_Count_fld;jj++)
   { if DBFFieldDescription(ww_Handler,jj,ww_iName,ww_iType,ww_iLen,ww_iDigit)<>0
     { ww_err:='Ошибка чтения структуры, номер поля '+string(jj)
     }
     DBFSTRU.insert into tmp_StructTable set 
        tmp_StructTable.fNum:=jj
       ,tmp_StructTable.iName :=ww_iName
       ,tmp_StructTable.iType :=ww_iType
       ,tmp_StructTable.iLen  :=ww_iLen
       ,tmp_StructTable.iDigit:=ww_iDigit;
     DBF_Log('Dbf_ReadFileStruct jj='+string(jj)+','+ww_iName+','+string(ww_iType)+','+string(ww_iLen)+','+string(ww_iDigit))  
   } //for(jj:=0;jj<ww_Count_fld;jj++)
   Result:=True
}  //Function Dbf_ReadFileStruct(ww_Handler:Longint) :boolean ;

//===============================
// Скопировать структуру в файл с указанным именем(с путем. Возвращает Handle и ошибку
//===============================
Function Dbf_CopyFileStruct(ww_Handler:Longint; ww_name_file:string; var ww_err:string) :Longint ;
var ww_Handler_Out:longint
{ Result:=0
  ww_err:=''
  if ww_Handler=0 then
  { ww_err:='Dbf_CopyFileStruct Не открыт Handle таблицы откуда!'
    exit
  }
  if not Dbf_ReadFileStruct(ww_Handler,ww_err)
  { exit;
  }
  ww_Handler_Out:=0
  ww_Handler_Out:= DBFOpen(ww_Name_file,stCreate);
  If ww_Handler_Out=0
  { ww_err:='Dbf_CopyFileStruct Ошибка создания файла куда '+ww_Name_file
    exit
  }
  DBFSTRU._Loop tmp_StructTable
  { DbfAddField(ww_Handler_Out ,DBFSTRU.tmp_StructTable.iName,DBFSTRU.tmp_StructTable.iType ,DBFSTRU.tmp_StructTable.iLen  ,DBFSTRU.tmp_StructTable.iDigit);
  } //DBFSTRU._Loop tmp_StructTable
  Result:=ww_Handler_Out;
} //Function Dbf_CopyFileStruct(wHandler:Longint; name_file:string; var ww_err:stringl) :Longint ;


//===============================
// Скопировать структуру в файл с указанным именем(с путем. Возвращает Handle и ошибку
// преварительно вызвать Function Dbf_ReadFileStruct(ww_Handler:Longint; var ww_err:string) :boolean ;
//===============================
Function Dbf_CopyRecord(ww_Handler_from:Longint; ww_Handler_to:Longint; var ww_err:string) :boolean ;
var ww_str:string;
{ ww_str:='';
  Result:=False;
  if DBFSTRU.getfirst tmp_StructTable<>0 or DBFSTRU.Handler<>ww_Handler_from
  { if not Dbf_ReadFileStruct(ww_Handler_from,ww_err)
      Exit;
  }
  DBFSTRU._Loop tmp_StructTable
  { ww_str:=dbfGetFieldValue( ww_Handler_from,DBFSTRU.tmp_StructTable.iName)
    if DBFSTRU.tmp_StructTable.iType=dbNum
    {  ww_str:=Replace(ww_Str,chr(160),'')
       ww_str:=Replace(ww_Str,chr(255),'')
       ww_str:=Replace(ww_Str,' ','')
       //ww_str
    }
    dbfPutFieldValue(ww_Handler_to,DBFSTRU.tmp_StructTable.iName ,ww_str)
  }
  Result:=True;
} //Function Dbf_CopyRecord(ww_Handler_from:Longint; ww_Handler_to:Longint; var ww_err:string) :Longint ;
