
//===================================================
// Проверить на заполненость
//===================================================
Function  CheckEmptyVariant(ww :variant) :boolean;
{ Result:=False;
  case VType(ww) of
	   VT_EMPTY// 0  [V]   [P]  nothing
  ,VT_NULL //       = 1;   // [V]        SQL style Null
   : {}
   VT_I2 //         = 2;   // [V][T][P]  2 byte signed int
  ,VT_I4 //         = 3;   // [V][T][P]  4 byte signed int
  ,VT_R4 //         = 4;   // [V][T][P]  4 byte real
  ,VT_R8 //         = 5;   // [V][T][P]  8 byte real
  ,VT_I1 //         = 16;  // [T]     signed char
  ,VT_UI2//         = 18;  // [T]     unsigned short
  ,VT_UI1//         = 17;  // [T]     unsigned char
  ,VT_UI4//         = 19;  // [T]     unsigned short
  ,VT_DECIMAL //    = 14;  // [V][T][S]  16 byte fixed point
  :  Result:=Double(ww)=0;
   // VT_CY          = 6;   // [V][T][P]  currency
  VT_DATE//        = 7;   // [V][T][P]  date
  :  Result:=Longint(ww)=0;
  //const VT_BSTR        = 8;   // [V][T][P]  binary string
  //const VT_DISPATCH    = 9;   // [V][T]     IDispatch FAR*
  //const VT_ERROR       = 10;  // [V][T]     SCODE
  VT_BOOL  //      = 11;  [V][T][P]  true=-1, false=0
  : Result:=(ww=0);
  //const VT_VARIANT     = 12;  // [V][T][P]  VARIANT FAR*
  //const VT_UNKNOWN     = 13;  // [V][T]     IUnknown FAR*
  //const VT_I1          = 16;  // [T]     signed char
   VT_I8 //          = 20;  // [T][P]  signed 64-bit int
  ,VT_UI8//         = 21;  // [T]     unsigned 64-bit int
  ,VT_INT//         = 22;  // [T]     signed machine int
  ,VT_UINT//        = 23;  // [T]     unsigned machine int
  : Result:=comp(ww)=0;
   // VT_VOID        = 24;  // [T]     C style void
   // VT_HRESULT     = 25;  // [T]
   // VT_PTR        = 26; // [T]     pointer type
   // VT_SAFEARRAY   = 27; // [T]     use VT_ARRAY in VARIANT
   // VT_CARRAY      = 28; // [T]     C style array
   // VT_USERDEFINED = 29; // [T]     user defined type
   // VT_LPSTR    = 30; // [T][P]  null terminated string
   // VT_LPWSTR   = 31; // [T][P]  wide null terminated string
       //VT_FILETIME = 64;  // [P]  FILETIME
       //VT_BLOB     = 65;  // [P]  Length prefixed bytes
       //VT_STREAM   = 66;  // [P]  Name of the stream follows
       //VT_STORAGE  = 67;  // [P]  Name of the storage follows
       //VT_STREAMED_OBJECT = 68; // [P] Stream contains an object
       //VT_STORED_OBJECT  = 69; // [P] Storage contains an object
       //VT_BLOB_OBJECT    = 70; // [P]  Blob contains an object
       //VT_CF             = 71; // [P]  Clipboard format
       //VT_CLSID          = 72; // [P]  A Class ID
       //VT_VECTOR   =  4096; // $1000 [P] simple counted array
       //VT_ARRAY    =  8192; // $2000 [V] SAFEARRAY*
       //VT_BYREF    = 16384; // $4000 [V]
       //VT_RESERVED = 32768; // $8000
       //VT_ILLEGAL  = 65535; // $ffff
       //VT_ILLEGALMASKED =  4095; // $0fff
       //VT_TYPEMASK      =  4095; // $0fff

  else 
  { Result:=string(ww)='';
  }
  end;
} //Function  CheckEmptyVariant(ww :variant) :boolean;


//===================================================
// Транcлировать в зависимости от типа
//===================================================
Function GetUnixTime(ww_Dt:date;ww_tm:time):string;
var ww_day_sec:comp;
{ ww_day_sec:=86400;
  Result:= String(Comp(CalcDaysBetweenDates(date(1,1,1970),ww_Dt,false)*ww_day_sec
                +hour(ww_tm)*3600 + Minute(ww_tm)*60+Second(ww_tm)
          ) //comp
        )// String
} //Function GetUnixTime(ww_Dt:date;ww_tm:time):string;


//===============================
// Заменить значения при импорте
//-------------------------------
Function ReplImp(_s:string):string;
{ Result:=_s;
  Result:=Replace(Result,'&amp;'  ,'&');
  Result:=Replace(Result,'&quot;' ,'"');
  Result:=Replace(Result,'&lt;'   ,'<');
  Result:=Replace(Result,'&gt;'   ,'>');
  Result:=Replace(Result,'&apos;' ,'`');
  // мое
  Result:=Replace(Result,'#proc;','%');
}

//===============================
// Заменить значения при экспорте
//-------------------------------
Function ReplExp(_s:string):string;
{ Result:=_s;
  Result:=Replace(Result,'&','&amp;'  );
  Result:=Replace(Result,'"','&quot;' );
  Result:=Replace(Result,'<','&lt;'   );
  Result:=Replace(Result,'>','&gt;'   );
  Result:=Replace(Result,'`','&apos;' );
  // мое
  Result:=Replace(Result,'%','#proc;' );

}

//------------------------------------------------------------------------------
//  Получить позицию справа
//------------------------------------------------------------------------------
function PosR(_substr: string; _s: string): byte;
var ww_str:string;
    ii :word;
    len_sub:word;
{ ww_str:='';
  Result:=0;
  len_sub:=length(_substr);
  for(ii:=length(_s);ii>0;ii--)
  { ww_str:=substr(_s,ii,1)+ww_str;
    if substr(ww_str,1,len_sub)=_substr
    { Result:=ii;
      break
    }
  }
} //function PosR(substr: string; s: string): byte;

function SubStrPosR(_substr: string;_s:string) : string;
var ii :word;
{ Result:=_s;
  ii:=PosR(_substr,_s);
  if ii>0
  { Result:=SubStr(_s,1,ii-1);
  } //if ii>0
  fplog('SubStrPosR _substr='+_substr+',ii='+string(ii)+',Result='+Result+',s='+_s);
        
} //function SubStrPosR(substr: string;s:string) : string;


//===================================================
// Транcлировать в зависимости от типа
//===================================================
Function  Variant2Str(ww :variant) :String;
{ Result:=string(ww);
  case VType(ww) of
  VT_DATE: Result:=DateToStr(ww,'DD/MM/YYYY')
  end;
} //Function  Variant2Str(ww :variant) :boolean;

//===================================================
// Добавить узел в XML-файл
//===================================================
Function AddNode(_Node: comp; _Name: string; _Value: string = ''): comp;
{
  result := oXMLConverter.AddNode(_Node, _Name, _Value, 0);
}



//===================================================
// Добавить обязательный атрибут узла
//===================================================
Procedure AttribRequired(_Node: comp; _AttrName:string; _AttrValue: variant);
{
  oXMLConverter.AddAttr(_Node, _AttrName, Variant2Str(_AttrValue));
}



//===================================================
// Добавить необязательный атрибут узла
//===================================================
Procedure AttribOptional(_Node: comp; _AttrName:string; _AttrValue: variant);
{
  //if (_AttrValue <> '') and _AttrValue<>'0' and _AttrValue<>'0.00'
  if not CheckEmptyVariant(_AttrValue)
    oXMLConverter.AddAttr(_Node, _AttrName, Variant2Str(_AttrValue));
}

//============ import_xml
//******************************************************************************
// Прочитать атрибуты ноды
//******************************************************************************
Procedure Txml_GetNodeAttrs(phNode: longint; pcRec: comp);
Var
  hAttrList
, hAttrCount
, hRec
, i
             : longint;
{
  hAttrList := XMLDOMNode_Get_Attributes(phNode);
  hRec:=0;
  if ( hAttrList <> 0 )
    {
      Txml_Attr.cNode := pcRec;
      hAttrCount     := XMLDOMNamedNodeMap_Get_Length(hAttrList);

      for ( i := 0; i < hAttrCount; i := i + 1 )
        {
          hRec := XMLDOMNamedNodeMap_Get_Item(hAttrList, i);

          if ( hRec <> 0 )
            {
              Txml_Attr.Name := XMLDOMNode_Get_NodeName(hRec);
              Txml_Attr.sVal := XMLDOMAttribute_Get_NodeValue(hRec);
              insert current Txml_Attr;
              timelog('   Txml_Attr.Name='+Txml_Attr.Name+', Txml_Attr.sVal='+Txml_Attr.sVal);
            }
        }

      if ( hAttrCount > 0 )
        XMLDOMNode_Release(hRec);
    }

  XMLDOMNode_Release(hAttrList);
} //Procedure Txml_GetNodeAttrs(phNode: longint; pcRec: comp);

//******************************************************************************
// Прочитать документ
//******************************************************************************
Function GetNodesRecursive(phNodeHigh: longint; pcHigh: comp; plNpp: longint): boolean;
Var
  hNodeList, hNodeCount, hRec, i       : longint;
  cRec   : comp;
  bRet   : boolean;
{
  timelog('GetNodesRecursive phNodeHigh='+string(phNodeHigh)+',pcHigh='+string(pcHigh)+',plNpp='+string(plNpp));
  GetNodesRecursive := false;
  bRet := true;
  hRec:=0;
  cRec:=0;
  //if ( bIsShowProgress )
    if ( not NextVisual )
      exit;

  if ( XMLDOMNode_get_NodeType(phNodeHigh) = 3 )
    {
      if ( GetFirst Txml_Node where (( pcHigh == Txml_Node.nRec )) = tsOk )
        {
          Txml_Node.sVal := XMLDOMCDataSection_Get_NodeValue(phNodeHigh);
          timelog(' Txml_Node.Name='+Txml_Node.Name+', Txml_Node.sVal='+string(Txml_Node.sVal));
          update current Txml_Node;
        }

      GetNodesRecursive := true;
      exit;
    }

  Txml_Node.nRec  := 0;
  Txml_Node.cNode := pcHigh;
  if pcHigh>0
  { if Txml_Node_F.Nrec<>pcHigh
    { if getfirst Txml_Node_F where (( pcHigh == Txml_Node_F.Nrec ))=0 {}
    }
    Txml_Node.NameUp:=Txml_Node_F.Name; // чтобы быстрей искать значение справочников
    if Txml_Node_F.isLeave=0 // установим что это не концевой
    { update current Txml_Node_F set Txml_Node_F.isLeave:=1;
    }
  }  //if Txml_Node.cNode>0
   
  Txml_Node.Name  := XMLDOMNode_Get_NodeName(phNodeHigh);
  // комментарии не грузим
  if Txml_Node.Name='#comment'
  { Result:=true;
    exit;
  }
  Txml_Node.sVal  := '';
  Txml_Node.Npp   := plNpp;
  timelog(' Txml_Node.Name='+Txml_Node.Name);
  if ( insert current Txml_Node = tsOk )
    cRec := Txml_Node.nRec;
  else
    {
      GetNodesRecursive := false;
      exit;
    }
  //--------------  
  Txml_GetNodeAttrs(phNodeHigh, cRec);

  hNodeList := XMLDOMNode_Get_ChildNodes(phNodeHigh);

  if ( hNodeList <> 0 )
    {
      hNodeCount := XMLDOMNodeList_Get_Length(hNodeList);

      for ( i := 0; i < hNodeCount; i := i + 1 )
        {
          hRec := XMLDOMNodeList_Get_Item(hNodeList, i);

          if ( hRec <> 0 )
            if ( not GetNodesRecursive(hRec, cRec, i) )
              {
                bRet := false;
                break;
              }
        }

      if ( hNodeCount > 0 )
        XMLDOMNode_Release(hRec);
      XMLDOMNode_Release(hNodeList);

  }



  GetNodesRecursive := bRet;
} //Function GetNodesRecursive(phNodeHigh: longint; pcHigh: comp; plNpp: longint): boolean;

//=========================================
// преобразовать в число строку
//=========================================
Function Xml2Double(ww_str:string):double;
{ Result:=0;
  Result:=Double(Replace(Replace(ww_str,' ','' ),',','.'))
} //Function Xml2Double(ww_str:string):double;


//=========================================
// преобразовать в дату строку
//=========================================
Function Xml2Date(ww_str:string):date;
//=========================================
{ //2013-07-23T00:00:00
  ww_str:=substr(ww_str,1,10);
  if substr(ww_str,5,1)='-' or substr(ww_str,5,1)='/'
   Result:=StrToDate(ww_str,'YYYY'+substr(ww_str,5,1)+'MM'+substr(ww_str,5,1)+'DD')
  else
   Result:=StrToDate(ww_str,'DD'+substr(ww_str,3,1)+'MM'+substr(ww_str,3,1)+'YYYY')
}//Function Xml2Date(ww_str:string):date;

//=========================================
// преобразовать в время строку
//=========================================
Function Xml2Time(ww_str:string):time;
//=========================================
{ //2013-07-23T00:00:00
  Result:=StrToTime(substr(ww_str,1,10),'HH:MM:SS')
}//Function Xml2Time(ww_str:string):time;

//=========================================
// преобразовать в Дату-время строку
//=========================================
Function Xml2DateTime(ww_str:string):DateTime;
//=========================================
{ //2013-07-23T00:00:00
  Result:=_StrToDateTime(ww_str,'YYYY-MM-DDTHH:NN:SS')
}//Function Xml2DateTime(ww_str:string):time;

//=========================================
// преобразовать в строку дату
//=========================================
Function Date2XML(ww:date):string;
{ Result:=DateToStr(ww,'DD-MM-YYYYT00:00:00')
}
//=========================================
// преобразовать в строку время
//=========================================
Function Time2XML(ww:time):string;
{ Result:=TimeToStr(ww,'HH:MM:SS')
}

//=========================================
// преобразовать в Дату-время строку
//=========================================
Function DateTime2Xml(ww:DateTime):String;
//=========================================
{ //2013-07-23T00:00:00
  Result:=_DateTimeToStr(ww,'YYYY-MM-DDTHH:NN:SS')
}//Function Xml2DateTime(ww_str:string):time;


//=========================================
// найти значение и текстовый тип
//=========================================
Function FindCodeVal(ww_pat:string;ww_pat_sub:string;
                       ww_value:string;ww_type:string;var ww_type_str:string; var ww_code:string ):string;
var
    ww_cNode:comp;
{ Result:='';ww_type_str:=''; ww_code:='';
  _loop Txml_Node_F where (( 
                    ww_pat    == Txml_Node_F.NameUp 
               and 'ObjectId' ==  Txml_Node_F.Name
               and  ww_Value  ==  Txml_Node_F.sVal
               ))
  {  // проверим на тип          
     if (getfirst Txml_Node_F1 where (( 
                   Txml_Node_F.cNode  == Txml_Node_F1.cNode
               and 'CodeTypeObjectId' == Txml_Node_F1.Name
               and  ww_type           == Txml_Node_F1.sVal 
               )) )<> 0 then continue;         
     if (getfirst Txml_Node_F1 where (( 
                   Txml_Node_F.cNode == Txml_Node_F1.cNode
               and 'Description'     == Txml_Node_F1.Name
                )) )= 0 
      { Result:= Txml_Node_F1.sVal;
      }                
     if (getfirst Txml_Node_F1 where (( 
                   Txml_Node_F.cNode == Txml_Node_F1.cNode
               and 'CodeValue'       == Txml_Node_F1.Name
                )) )= 0 
      { ww_code:= Txml_Node_F1.sVal;
      }                
     if (getfirst Txml_Node_F1 where (( 
                   ww_pat_sub == Txml_Node_F1.NameUp 
               and 'ObjectId' == Txml_Node_F1.Name
               and  ww_Type   == Txml_Node_F1.sVal
                )) )= 0 
     { ww_cnode:=Txml_Node_F1.cNode;
       if (getfirst Txml_Node_F1 where (( 
                   ww_cnode == Txml_Node_F1.cNode
               and 'Name'   == Txml_Node_F1.Name
                )) )= 0 
       { ww_type_str:= Txml_Node_F1.sVal;
       }
     }           
  } //_loop Txml_Node_F where ((             
} //Function FindCodeVal(ww_pat:string;ww_val:string;ww_type:string;var ww_type:string):string;



//=========================================
//== найти значение в текущей ветке
//=========================================
Function FindValInNode(ww_cNode:comp;ww_pat:string):string;
{  Result:='' ;
   PushPos(#Txml_Node_F1);
   if (getfirst Txml_Node_F1 where (( 
                   ww_cnode == Txml_Node_F1.cNode
               and ww_pat  == Txml_Node_F1.Name
                )) )= 0 
   { Result:= Txml_Node_F1.sVal;
   }
   PopPos(#Txml_Node_F1);
   
} //Function FindValInNode(ww_cNode:comp;ww_pat:string):string;



//=========================
// Прочить файл xml
//=========================
Function ReadXMLFILE(ww_file:string) : boolean;
var  hDoc, hRoot  : longint;
{ Result:=False;
  timelog('ReadXMLFILE ww_file='+ww_file);
  if not FileExist(ww_file) then Exit;
  delete all Txml_Node;
  ResetBounds(#Txml_Attr);
  delete all Txml_Attr;
  delete all Txml_Attr;
  SetBounds(#Txml_Attr);
  delete all Txml_Node;
  hDoc  := XMLDOMDoc_New;
  hRoot := 0;
  timelog('ReadXMLFILE before XMLDOMDoc_Load');
  XMLDOMDoc_Load(hDoc, ww_file); 
  timelog('ReadXMLFILE before XMLDOMDoc_DocumentElement');
  hRoot := XMLDOMDoc_DocumentElement(hDoc);

  if ( hRoot = 0 )
    {
      //MyMessage('Ошибка в структуре XML файла.'+chr(13)+ww_file);
      Exit;
  }
  timelog('ReadXMLFILE before GetNodesRecursive');
  Result:=GetNodesRecursive(hRoot, 0, 0);

  XMLDOMNode_Release(hRoot);
  XMLDOMDoc_Done(hDoc);
  timelog('ReadXMLFILE FINISH');
} //Function ReadXMLFILE(ww_file:string) : boolean;              
