#ifndef _FPPREDEF_VPP_
#define _FPPREDEF_VPP_

//==============================================================================
// Для совместимости со старыми define-ми
//==============================================================================

// присутствует cMain
#ifdef __whrKatFpMain__
  #ifndef _cMain_
    #define _cMain_
  #end
#end

// присутствует cMain+KodGrKau
#ifdef __whrKatFpMainKodGrKau__
  #ifndef _cMain_
    #define _cMain_
  #end
  #ifndef _cMainKodGrKau_
    #define _cMainKodGrKau_
  #end
#end

// иерархическая таблица
// д/б bounds byTreeKatH и bounds byBrowKatH (fp_Serv.Vpp)
// кажется д/б bounds byTreeKatHName и bounds byBrowKatHName (fp_Serv.Vpp)
#ifdef __edtKatFpHierTable__
  #ifndef _HierTable_
    #define _HierTable_
  #end
  #ifndef _Code_
    #define _Code_
  #end
  #ifndef _LevelCode_
    #define _LevelCode_
  #end
  #ifndef _bndTreeKatH_
    #define _bndTreeKatH_
  #end
  #ifndef _bndBrowKatH_
    #define _bndBrowKatH_
  #end
  #ifndef _bndTreeKatHName_
    #define _bndTreeKatHName_
  #end
  #ifndef _bndBrowKatHName_
    #define _bndBrowKatHName_
  #end
#end

#ifdef __edtKatFpNotStdCode__
  #ifdef _Code_
    #undef _Code_
  #end
#end

//==============================================================================
// Определение define-ов по умолчанию
//==============================================================================
#ifdef _HierTable_
  #ifndef _cNode_
    #define _cNode_
  #end
#end

#ifdef _cMain_
  #if ('#_cMain_' = '')
    #undef _cMain_
    #define _cMain_ cMain
  #end
#end

#ifdef _cNode_
  #if ('#_cNode_' = '')
    #undef _cNode_
    #define _cNode_ cNode
  #end
#end

#ifdef _Code_
  #if ('#_Code_' = '')
    #undef _Code_
    #define _Code_ Code
  #end
#end

#ifdef _LevelCode_
  #if ('#_LevelCode_' = '')
    #undef _LevelCode_
    #define _LevelCode_ LevelCode
  #end
#end
 
#ifdef _Abbr_
  #if ('#_Abbr_' = '')
    #undef _Abbr_
    #define _Abbr_ Abbr
  #end
#end

#ifdef _bndTreeKatH_
  #if ('#_bndTreeKatH_' = '')
    #undef _bndTreeKatH_
    #define _bndTreeKatH_ byTreeKatH
  #end
#end

#ifdef _bndBrowKatH_
  #if ('#_bndBrowKatH_' = '')
    #undef _bndBrowKatH_
    #define _bndBrowKatH_ byBrowKatH
  #end
#end

#ifdef _bndTreeKatHName_
  #if ('#_bndTreeKatHName_' = '')
    #undef _bndTreeKatHName_
    #define _bndTreeKatHName_ ByTreeKatHName
  #end
#end

#ifdef _bndBrowKatHName_
  #if ('#_bndBrowKatHName_' = '')
    #undef _bndBrowKatHName_
    #define _bndBrowKatHName_ ByBrowKatHName
  #end
#end

#ifdef _bndBrowKatHAbbr_
  #if ('#_bndBrowKatHAbbr_' = '')
    #undef _bndBrowKatHAbbr_
    #define _bndBrowKatHAbbr_ ByBrowKatHAbbr
  #end
#end

#ifndef __NOFPSTDKAT__
  #ifndef __FPKAT__
    #define __FPKAT__
  #end
#end

//==============================================================================
#end // _FPPREDEF_VPP_
