//Xml_tbl.vpp
//==============================================
Table struct Txml_Node
//==============================================
(
  nRec    : comp        "уникальный идентификатор"
, cNode   : comp        "ссылка на вышестоящий узел"
, Name    : string[50]  "наименование узла"
, sVal    : string[250] "значение узла"
, Npp     : longint     "номер по порядку"
, NameUp  : string[50]  "Вышестоящий элемент"
, isLeave : word       "1-не концевой уровень"
)
With index
(
  Txml_Node01 = nRec(unique, surrogate)
, Txml_Node02 = cNode + Npp
, Txml_Node03 = Name + cNode + Npp
, Txml_Node04 = NameUp+Name + sval
, Txml_Node05 = CNODE+NAME+SVAL
)
;

//==============================================
Table struct Txml_Attr
//==============================================
(
  cNode   : comp         "ссылка на узел"
, Name    : string[100]  "наименование атрибута"
, sVal    : string       "значение атрибута"
, Npp     : longint      "номер по порядку"
)
With index
(
  Txml_Attr01 = cNode + Npp + Name,
  Txml_Attr02 = cNode + Name
)
;
