//========================================
//получить ожидаемое имя книги из файла
//========================================
Function GetBookNameFromFile(w:string) :string ;
var i,k :word ;
begin
  i:=myrpos('.',w) ;
  k:=myrpos('\',w) ;
  k:=k+1 ;
  if i=0 then i:=length(w)+1 ;
  GetBookNameFromFile:=substr(w,k,i-k) ;
end ;
