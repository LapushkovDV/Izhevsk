//========================================
//Сохраняем файлы по порядку
//========================================
Function MyXlSaveAsWorkBookByName(sCurBook:String; sNewBook:String) : Boolean;
var iii : Word;
{
  MyXlSaveAsWorkBookByName := True;
  deletefile(sNewBook+'.*');
  iii:=0;
  while Not(xlSaveAsWorkBookByName(sCurBook, sNewBook+if(iii=0,'',String(iii))))
  { iii:=iii+1;
    deletefile(sNewBook+'.*'+if(iii=0,'',String(iii)));
    if (iii>=255)
    { Message('Ошибка! Не сохранить файл под именем '+sNewBook+if(iii=0,'',String(iii)));
      MyXlSaveAsWorkBookByName := False;
      exit;
    }
  }
}
//========================================
//Инициализация Excel
//========================================
Function ExcelInit(wnmfile:string ; fromtemplate :boolean;wwyear:word =2009  ) : word ;
var
  XlRes    : Boolean;
  aFileName,wstr: String;
  akolfile :longint;
  aFileName1: string ;
{ wexrow:=1 ;
  wexcol:=1 ;
  wexlist:=0 ;
  wwyear:=wwyear;
  wpoint:=GetDecimalSeparator; //общесистемный разделитель в Excel
  // для отладки
!#DEFINE _EXCELINIT_
//  MyLogWrite(true,'Инициализация Excel') ;
  ExcelInit:=1 ;
  matrixkl_main:=false;

  if logfilenm=''
  { logfilenm:='!excellog.txt' ;
    MyLogWrite(true,'Начало печати - '+TimeToStr (Cur_Time, 'HH.MM.SS.SSS'));
  }
  else
    MyLogWrite(False,'Начало печати - '+TimeToStr (Cur_Time, 'HH.MM.SS.SSS'));
#IFDEF _EXCELINIT_
  MyLogWrite(false,'Инициализация Excel') ;
#ENDIF
//  xlOpenExcel(True) ; // так проинициализируем
!  wcurbook:=GetBookNameFromFile(wnmfile) ;
  wcurbook:=wnmfile ;
//  message(wcurbook) ;

/*
  if xlSetActiveWorkBookByName(wcurbook)
  { message('Ошибка! Уже открыт файл с таким именем '+wcurbook) ;
    xlKillExcel ;
    exit ;
  }
*/

  XlRes := True;
#IFDEF _EXCELINIT_
  MyLogWrite(false,'1');
#ENDIF
!  aFileName := GetStringParameter('Files','OutputFilesDirectory',0) + wnmfile;
  aFileName := MyOutputFilesDirectory + wnmfile;
  aFileName1:=aFileName;
//  message(afilename+'/'+wnmfile) ;
  ExcelInit:=2 ;
//  MyLogWrite(false,'удаляем файл '+aFileName) ;
#IFDEF _EXCELINIT_
  MyLogWrite(false,'2 удаление '+aFileName) ;
#ENDIF

/*
  if FileExist(aFileName)
  {
#IFDEF _EXCELINIT_
  MyLogWrite(false,'21 удаление '+aFileName) ;
#ENDIF
    if not DeleteFile(aFileName)
    { message('Ошибка при удалении файла '+chr(13)+wnmfile+chr(13)+'возможно он открыт другой программой') ;
      xlKillExcel ;
      exit ;
    }
  }
*/
  akolfile:=0 ;
  if false //FileExist(aFileName)
  { 
#IFDEF _EXCELINIT_  
  MyLogWrite(false,'21 удаление '+aFileName) ;
#ENDIF
  
    if not DeleteFile(aFileName)
    { do 
      { akolfile:=akolfile+1 ;
        if akolfile>20 then
        { akolfile:=0 ;
        }
        aFileName1:=substr(aFileName,1,pos('.',aFileName)-1)+'d'+string(akolfile)+'.xls';
        if FileExist(aFileName1)
        { DeleteFile(aFileName1)
        }
      } while fileexist(aFileName1)
      if akolfile=0
      { message('Ошибка при удалении файла '+chr(13)+wnmfile+
        chr(13)+'возможно он открыт другой программой') ;
        exit ;
      }
      else aFileName:=aFileName1 ;  
    }
  } //if false //FileExist(aFileName)

  ExcelInit:=3 ;
//  wstr:=translatepath('%ClientStartPath%XLS\#_MYXLSPATH_\')+wnmfile ;
  wstr:=translatepath('%ClientStartPath%#_MYXLSPATH_\')+wnmfile ;
  MyLogWrite(false,'открытие excel '+wstr) ;

  if fromtemplate
  {  //XlRes := xlCreateExcelWithTemplate(wstr, True);
     XlRes := xlCreateNewExcelWithTemplate(wstr, True);

     if not XLRes
     { message('Ошибка открытия шаблона '+wstr) ;
       exit ;
     }
     else
     {  xlGetActiveWorkBookName(wcurbook) ;
!        xlSaveAsWorkBookByName(wcurbook,aFileName); //Сохраним в OUT
     }
  }
  else  XlRes := xlCreateExcel(aFileName, True);

//2010-02-09
  if Not(xlDisplayAlerts(false)) {} //message('Error xlDisplayAlerts !'); //убираем сообщения в EXCEL 

//  MyLogWrite(false,'проверка на корректность '+aFileName) ;
#IFDEF _EXCELINIT_
  MyLogWrite(false,'4') ;
#ENDIF

  if (XlRes) XlRes := xlIsExcelValid;
  if not XlRes then exit;

  wcurbook:='' ;
//  MyLogWrite(false,'имя текущей книги '+aFileName) ;
#IFDEF _EXCELINIT_
  MyLogWrite(false,'5') ;
#ENDIF
  xlGetActiveWorkBookName(wcurbook) ;
  ExcelInit:=5 ;
#IFDEF _EXCELINIT_
  MyLogWrite(false,'6') ;
#ENDIF
/*
!  if pos(upcase(GetBookNameFromFile(wnmfile)),upcase(wcurbook))=0
  if pos(upcase(wnmfile),upcase(wcurbook))=0
  { message('Ошибка! Выходной файл уже открыт '+wstr) ;
    xlKillExcel;
    exit ;
  }
*/
  if matrix_main=1
  { MyXlCreaMatrix(10000,30) ;
    matrixkl:=true ;
  }
  else matrixkl:=false ;

#IFDEF _EXCELINIT_
  MyLogWrite(false,'7 - end ExcelInit') ;
#ENDIF
//  MyLogWrite(false,wcurbook) ;
  ExcelInit:=0 ;
}
//========================================
//Закрываем Excel
//========================================
Function MyXlEnd :boolean ;
//var wPictBook,fbasname:string ;
{
  if matrixkl then
  { MyXlWriteMatrix(wexrow) ;
    xlFreeMatrix ;
  }
/*
  //Сохраняем шаблон в OUT
  xlRunMacro('AfterForm') ;
  XLGETACTIVEWORKBOOKNAME(wPictBook) ;
!  fbasname:=GetStringParameter('Files','OutputFilesDirectory',0)+wPictbook+'.xls' ;
!  fbasname:=GetStringParameter('Files','OutputFilesDirectory',0)+wPictbook ;
  fbasname:=MyOutputFilesDirectory+wPictbook ;
  if fileexist(fbasname) deletefile(fbasname)
  xlSaveAsWorkBookByName(wPictbook, fbasname)
*/
  XlKillExcel ;
  MyXlEnd:=true ;
  message('Переключитесь в Excel и смотрите отчет') ;
  if fileexist(logfilenm)
  { message('В процесе формирования обнаружены ошибки'+chr(13)+
     'смотрите "'+logfilenm+'" в рабочей папке ярлыка на запуск Галактики');
      ProcessText(logfilenm,vfNewTitle+vfEscable+vfMacroSize+vfRunModal,
               logfilenm+' Протокол ошибок');
  }
}
//========================================
//Редактирование шаблона
//========================================
Function Excel_Edit(wnmfile:string  ) : word ;
var
!  aFileName,
  wstr: String;
{

#ifdef Atl51
  wstr:=translatepath('%ClientStartPath%XLS\#_MYXLSPATH_\')+wnmfile ;
#else
  wstr:=translatepath('%StartPath%XLS\#_MYXLSPATH_\')+wnmfile ;
#end

  Excel_Edit:=0;
  //Excel_Edit:=false;
  if not fileexist(wstr)
  { message('нет файла '+wstr) ;
    exit ;
  }
// xlOpenExcel(wstr, True);
// XlKillExcel ;
  ExecProgram (wstr,'', 'редактирование шаблона '+wstr,0);
}
