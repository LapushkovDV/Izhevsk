var excel_Null_Need:boolean=false;
//========================================
//Печать отладочного протокола
//========================================
Procedure MyLogWrite(wkl :boolean ;w :string ) ;
{
//ExcelInit  nmlogfile:=GetStringParameter('Files','OutputFilesDirectory',0) +'excellog.txt' ;
  if logfilekl
  { if wkl then  deletefile(logfilenm) ;
    LogStrToFile(logfilenm,w) ;
  }
}
//========================================
//Проверка наименования листа
//========================================
Function MyXlCheckListName(sNameList:String):String;
{
  sNameList:=Replace(sNameList,'ж','_');
  sNameList:=Replace(sNameList,'Ж','_');
  sNameList:=Replace(sNameList,':','_');
  sNameList:=Replace(sNameList,'\','_');
  sNameList:=Replace(sNameList,'/','_');
  sNameList:=Replace(sNameList,'?','_');
  sNameList:=Replace(sNameList,'*','_');
  sNameList:=Replace(sNameList,'[','_');
  sNameList:=Replace(sNameList,']','_');
  sNameList:=SubStr(sNameList,1,30);
  MyXlCheckListName:=sNameList;
}
