#ifndef __CLREPTBL_VPP__
#define __CLREPTBL_VPP__

// Для очистки таблиц хранения отчета
Create view loClrRep
Var
  wnRep : word; // код(тип) отчета
As select *
From
  TempDescr,
  TempIer,
  Tobot
Where
  ((
    wnRep          == Tobot.Code     and
    wnRep          == TempDescr.Code and
    wnRep          == TempIer.Code
  ))
;

// --------------------------------------------------------------
// очистка tobot и tempdescr перед формированием отчета
// --------------------------------------------------------------
function ClearTempTables( pwNRep : word ) : boolean;
  {
  ClearTempTables := false;
  loClrRep.wnRep := pwNRep;

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm,
                 ''#3'Очистка временных таблиц', 3);
  _try
    {
    loClrRep.Delete Safe Tobot;
    NextVisual;
    loClrRep.Delete Safe TempDescr;
    NextVisual;
    loClrRep.Delete Safe TempIer;
    NextVisual;
    ClearTempTables := true;
    }
  _except
  on ExUserBreak: {}
  StopVisual('',0);
  }

#end // __CLREPTBL_VPP__