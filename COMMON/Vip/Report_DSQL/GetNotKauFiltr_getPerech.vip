#include marker.vih

Interface GetNotKauFiltr_getPerech;
create view
 var
   MarkPerech : IMarker(marker) new; // маркер помеченных
   _tmpMarkers : tptr;
from
  Perech
;

parameters _tmpMarkers;

Window winPerech 'Выбор Налоги на ФОТ' doAccept, escClose, Dialog,cyan;
 browse brPerech 'Выбор Налоги на ФОТ' (, hcSberb, sci1EscIns);
  table Perech;
  recMarker = MarkPerech{Perech.VidPer};
fields
  Perech.VidPer 'Номер' ('Номер перечисления',,): [7], protect;
  Perech.NamePer 'Наименование' ('Наименование перечисления ',,): [30], protect;
  Perech.ProcPer 'Процент' ('Процент ',,): [5.2], protect;
end;
end;
windowevent winPerech;
cminit: {
  MarkPerech.ImportFrom(_tmpMarkers);
}
cmDefault :{
  MarkPerech.ExportTo(_tmpMarkers);
}
end;

HandleEvent
cmInit: {
  runwindowmodal(winPerech);
  closeinterface(-1);
}
End;
end.
