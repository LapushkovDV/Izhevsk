//
// Галактика 8.1 - Отчеты пользователя
// интерфейс вызова фильтров, которых нет в КАУ
// Автор Стрельцов С.А. (отдел ПНР) 2013 год
//********************************************************************************
#include PickDeduction.vih

#include GetNotKauFiltr.vih

Interface GetNotKAUFiltr;
var
  gliPickedCount, k : longint;
  Marker : pointer;
  MarkerName : string;
  Val : string;

table Struct typeFlt
(
   Code : LongInt,
   NAme : String,
   MarkerNAme : string
)
with index
(
  i0 = Code,
  i1 = Name
)
;

create view
as select typeFlt.Code
from
  typeFlt
, GRDESCR;

Window wCaseTypeFltr 'Выбор фильтра' doAccept, escClose, Dialog,cyan;
  Show at (, ,60 ,7);
Browse typeFlt;
   Fields
     typeFlt.Code 'Код'          : [4],  Protect;
     typeflt.Name 'Наименование' : [15], Protect;
   end;
end;

function InsFlt(_Code: LongInt; _name, _Markername: String): boolean;
{
  typeFlt.Code := _Code;
  typeflt.Name := _name;
  typeflt.MarkerName := _Markername;
  insert current typeflt;
  result := true;
}

Procedure FillFlt; {
  Delete all from typeflt;
  InsFlt(cgiPickNotKAU + 1, 'Дескриптор'                         , 'UserTuneDescr');
  InsFlt(cgiPickNotKAU + 2, 'Группа дескрипторов'                , 'UserTuneGrDescr');
  InsFlt(cgiPickNotKAU + 5, 'Налоги на ФОТ (поле Perech.VidPer)' , 'lapus_DSQLNalogFOT');
  InsFlt(cgiPickNotKAU + 6, 'Реестры на перечисление'            , 'lapus_DSQLReestrPerechisl');
  InsFlt(cgiPickNotKAU + 3, 'Виды удержаний (поле KLVIDUD.VIDUD)', 'lapus_DSQLVidUd');
  InsFlt(cgiPickNotKAU + 4, 'Виды оплат (поле KlVidOpl.VIDOPLP)' , 'lapus_DSQLVidOp');
}

function GetCaseFiltrDialog: LongInt;
{
  FillFlt;
  RunWindowModal(wCaseTypeFltr);
  GetCaseFiltrDialog := typeFlt.Code;
}

function GetFiltrName(_Kod: LongInt): string;
{
  if GetFirst typeflt where ((_kod == typeFlt.Code)) = tsOk
    GetFiltrName := typeFlt.Name;
  LogstrtoFile('Dsql.log', 'GetFiltrName=' + GetFiltrName);
}

function GetMarkerName(_Kod: LongInt): string;
{
  if GetFirst typeflt where ((_kod == typeFlt.Code)) = tsOk
    GetMarkerName := typeFlt.MarkerName;
  LogstrtoFile('Dsql.log', 'GetMarkerName=' + GetMarkerName);
}

function RunFiltrDialog(_Kod: LongInt): word;
{
  FillFlt;
  //message('RunFiltrDialog _Kod = ' + _Kod);
  case _kod of
    cgiPickNotKAU + 1: {
      RunFiltrDialog := RunInterface('C_COMMON::GetSomeDescr', false);
    }

    cgiPickNotKAU + 2: {
      RunFiltrDialog := RunInterface('C_COMMON::GetGrDescr', '', true, true, 0);
    }
    cgiPickNotKAU + 3: {
         var PickVidUd: PickDeduction;
         var _tmpMarkers : tptr = InitMarker(GetMarkerName(_kod), 2, 200, 7);
         PickVidUd.PickMultipleEdit(_tmpMarkers, 0, true);
         DoneMarker(_tmpMarkers, GetMarkerName(_kod));
    }
    cgiPickNotKAU + 4: {
      var PickVidUd: PickDeduction;
      var _tmpMarkers : tptr = InitMarker(GetMarkerName(_kod), 2, 200, 7);
       RunInterface('Z_CALC::GETVIDOP', _tmpMarkers, true, 3, 0);
       DoneMarker(_tmpMarkers, GetMarkerName(_kod));
    }
    cgiPickNotKAU + 5: {
      var PickVidUd: PickDeduction;
      var _tmpMarkers : tptr = InitMarker(GetMarkerName(_kod), 2, 200, 7);
       RunInterface('GP_COMMON::GetNotKauFiltr_getPerech', _tmpMarkers);
       DoneMarker(_tmpMarkers, GetMarkerName(_kod));
    }
    cgiPickNotKAU + 6: {
      var PickVidUd: PickDeduction;
      var _tmpMarkers : tptr = InitMarker(GetMarkerName(_kod), 2, 200, 7);
       RunInterface('GP_COMMON::GetNotKauFiltr_getSBBAN', _tmpMarkers);
       DoneMarker(_tmpMarkers, GetMarkerName(_kod));
    }
  end;
}

function GetPickCount(_Kod: LongInt): LongInt;
{
  MarkerName := GetMarkerName(_Kod);
  Marker := InitMarker(MarkerName, 8, 100, 10);
  GetPickCount := GetMarkerCount(Marker);
  DoneMarker(Marker, MarkerName);
  LogstrtoFile('Dsql.log', 'GetPickCount=' + GetPickCount);
}

function GetNrecFirstPick(_Kod: LongInt): comp;
{
  MarkerName := GetMarkerName(_Kod);
  Marker := InitMarker(MarkerName, 8, 100, 10);
  GetMarker(Marker, 0, GetNrecFirstPick);
  DoneMarker(Marker, MarkerName);
}

#declare GetVal
  case _kod of
    cgiPickNotKAU+1:
    {
      Val := sGetTuneEx('USER.DESCR', UserOfficeFilial(cNrec), cNrec);
    }
    cgiPickNotKAU+2:
    {
      if GetFirst GRDESCR where ((cNrec == GRDESCR.Nrec)) = tsOk
        Val := GrDescr.DESGR;
    }
    cgiPickNotKAU + 3 : {
      if GetFirst KLVIDUD where ((word(cNrec) == KLVIDUD.VIDUD)) = tsOk
        Val := KLVIDUD.VIDUD + ', ' + KLVIDUD.nvidud;
      }
    cgiPickNotKAU + 4 : {
      if GetFirst KlVidOpl where ((word(cNrec) == KlVidOpl.VIDOPLP)) = tsOk
        Val := KlVidOpl.VIDOPLP + ', ' + KlVidOpl.nvidopl;
      }
    cgiPickNotKAU + 5 : {
      if GetFirst Perech where ((word(cNrec) == Perech.VidPer)) = tsOk
        Val := Perech.VidPer +', '+ Perech.NamePer;
      }
    cgiPickNotKAU + 6 : {
      if GetFirst SBBAN where ((cNrec == SBBAN.Nrec)) = tsOk
        Val := SBBAN.LASTUSER + ', ' + SBBAN.NAME;
      }
  end;
  LogstrtoFile('Dsql.log', 'Val=' + Val);
#end

function GetNameFirstPick(_Kod: LongInt): string;
{
  var
    cNrec: comp;
  MarkerName := GetMarkerName(_Kod);
  Marker := InitMarker(MarkerName, 8, 100, 10);
  GetMarker(Marker, 0, cNrec);
  #GetVal
  GetNameFirstPick := Val;
  DoneMarker(Marker, MarkerName);
}

function GetValByNrec(_Kod: LongInt; cNrec: comp): variant;
{
  #GetVal
  GetValByNrec := Val;
}

HandleEvent
  cmInit:
  {
    FillFlt;
  }
End;
end.
