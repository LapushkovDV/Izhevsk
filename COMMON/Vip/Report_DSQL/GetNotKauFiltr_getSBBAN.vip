//********************************************************************************
//
//********************************************************************************

#include AdrFunc.vih
#include marker.vih
#include ZarRegister.vih

Interface GetNotKauFiltr_getSBBAN;

function GetVidDoc(Pref: string): string; forward;
function GetGroupName(ACode: word): string; forward;

create view
 var
   MarkSbban : IMarker(marker) new; // маркер помеченных
   _tmpMarkers : string;
  ADR:       AddressFunc;
as select
    if(IsValid(tnKATPODR), Trim(LTrim(KATPODR.KOD + ', ' + KATPODR.NAME, ',')), 'несколько подразделений') (fieldname = DepStr)
  , (IsValid(tnPLPOR) and (Day(PLPOR.DATOB) <> 0)) (fieldname = Guard)
  , (SBBAN.SUMMA - SBBAN.SBOR) (fieldname = SumZach)
  , if(IsValid(tnSbban), ADR.GetOKTMO(Sbban.Region), '') (fieldname = OKTMO)
  , if(IsValid(tnSBBAN), DateToStr(SBBAN.DATAN, 'MM/YYYY'), '') (fieldname = MesNachisl)
  , (IsValid(tnSBBAN) and (IsValid(tnPLPOR))) (fieldname = Exist)
  , if(IsValid(tnSBBAN) and (IsValid(tnPLPORB)) and (Day(PLPORB.DATOB) <> 0), 'Б', '') (fieldname = ExistB)
  , if(SBBAN.PRIZNAK = 3, '$',
      if(SBBAN.PRIZNAK = 2, 'н/о',
        if(SBBAN.PRIZNAK > 0, if(Exist,if(Guard,'О','П'),'УС'),if(Exist,'X+',''))
      )
    ) (fieldname = StrState)
  , if(not IsValid(tnSBBAN), '',
      if((SBBAN.FILIALNO and 1) = 1, 'Р', '')) (fieldname = IsTouch)

from
    SBBAN
  , ProcessState ProcessState2
  , KATPODR
  , DOCPODOT
  , PLPOR
  , PLPOR PLPORB
  , DOCPODOT DOCPODOTB
where ((
           SBBAN.CPODR   == KATPODR.NREC
       and Sbban.StatusV == ProcessState2.NRec
    and cgLink_ReesPlDoc == DOCPODOT.TIPDOC
    and SBBAN.NREC       == DOCPODOT.CVTDOC
    and DOCPODOT.CPRDOC  == PLPOR.NREC
    and cgLink_ReesBuhSpr == DOCPODOTB.TIPDOC
    and SBBAN.NREC        == DOCPODOTB.CVTDOC
    and DOCPODOTB.CPRDOC  == PLPORB.NREC

  ))
;

parameters _tmpMarkers;

Window winSbban 'Выбор реестров' doAccept, escClose, cyan;
browse brSbban 'Выбор реестров' (, hcSberb, sci1EscIns);
  table SbBan;
  recMarker = MarkSbban{SBBAN.Nrec};
fields
  SBBAN.nrec 'nrec'('nrec'): protect,  [5];
  [VidDoc] GetVidDoc(SBBAN.PREFIX)
    'Док.'('Тип документа, на основе которого создан реестр'): protect, centered,  [5];
  SBBAN.PREFIX    'Преф.'('Префикс реестра'): protect,  [5];
  SBBAN.PRIZMEG   'Табл.'('Источник данных'): protect,  [5];
  SBBAN.VIDUD     'В/У'('Системный код вида удержания'): protect,  [3];
  SBBAN.DFORM     'Дата'('Дата формирования реестра', hcReesDForm):[10], protect, centered;
  SBBAN.LASTUSER  'Номер'('Номер реестра', hcNomRees):[12], protect;
  SBBAN.NAME      'Наименование'('Наименование реестра', hcReesName):[10];
  DepStr          'Подразделение' ('Подразделение группировки'): [12], protect;
  SBBAN.SUMMA     'Перечисл.','сумма'('Перечисляемая или удержанная сумма', hcReesSumma):[12,2], protect;//, browseSum;
  SumZach         'Выплачив.','сумма'('Сумма, выплачиваемая по реестру', hcReesSumma):[12,2], protect;//, browseSum;
  SBBAN.SUMMA1    'Сумма','взысканий'('Сумма взысканий по исполнительным документам', hcReesSumma):[10.2], protect;//, browseSum;
  SBBAN.DATOK     'Дата','выплаты'('Дата выплаты дохода',, sci1378Esc):[12], centered;
  SBBAN.LASTDATE  'Срок','уплаты'('Срок уплаты НДФЛ с дохода',, sci1378Esc):[12], centered;
  OKTMO           'ОКТМО' ('Код ОКТМО'): [12], protect;
  MesNachisl      'Месяц','начисл.'('Месяц, из начислений которого выплачивается'):[8], protect, centered;
  StrState        'Пров.'('Платежный документ:[" " не создан]["УС" условно создан]["П|О" создан|оплачен]["X+" не учитывается]',
    hcReesPriznak, sci1378Esc):  centered, pickbutton, protect, [5];
  ExistB          'Б'('Наличие сформированной бухсправки по реестру'): protect,  [1];
  IsTouch         'Р'('`Р`- редактировался'):[1], protect, {font = {color = ColorSysRed; bold = true}};
  SBBAN.PRIZDEL   'Код'('Код группы выплат'): protect,  [2];
  [GroupName] GetGroupName(SBBAN.PRIZDEL) 'Гр.'('Группа выплат'): protect, centered,  [8];
  ProcessState2.Name 'Статус' ('Статус в Workflow',, sci13Esc): [7], Protect, PickButton;
end;
end;
windowevent winSbban;
cminit: {
  MarkSbban.ImportFromName(_tmpMarkers);
}
cmDefault :{
  MarkSbban.ExportToName(_tmpMarkers);
}
end;

function GetGroupName(ACode: word): string; {
  Result := 'прочие';

  case ACode of
    rgDeduction:  Result := 'прочие';
    rgPrepayment: Result := 'аванс';
    rgSalary:     Result := 'зарпл.';
    rgIncomeTax:  Result := 'налог';
    rgAlimony..
    rgWritOfExec: Result := 'алим.';
  end;
}

function GetVidDoc(Pref: string): string; {
    Result := 'н/о';
    case Pref of
      'R$$':  Result := 'ГР';
      'RV':   Result := 'НЧВП';
      'RU':   Result := 'УДВП';
      'RM':   Result := 'ПМАТ';
      'RD':   Result := 'ПДЕТ';
      'RRD':  Result := 'РДЕТ';
      'R#Z':  Result := 'ДОГП';
      'R#A':  Result := 'ДОГП';
      'RO':   Result := 'ОТПС';
      'RP':   Result := 'ПРЕМ';
      'RB':   Result := 'БЛНЛ';
      'R$A':  Result := 'АВАН';
      'R$Z':  Result := 'ИТРЗ';
      'R$AL': Result := 'АЛИМ';
      'R$D':  Result := 'СТВЗ';
      'S$':   Result := 'НФОТ';
    end;
}

HandleEvent
cmInit: {
  runwindowmodal(winSbban);
  closeinterface(-1);
}
End;
end.
