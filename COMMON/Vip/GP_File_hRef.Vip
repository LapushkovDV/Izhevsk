//==============================================================================
//        Визуальная часть
//******************************************************************************
window wnViewFile 'Список файлов' (,,sci1Esc) , EscClose;
show at  (,,60,20);
screen scrViewFile;
show at  (,,,2);
buttons
  cmOK,,,'Запуск',,;
  cmValue2,,,'Сохранить',,;
<<
 <. Добавить файл .>                     <. Сохранить файлы .>
>>
end;
browse brViewFile (,,sci18Esc);
show at  (,3,,);
Fields
{Font={Color=if(GP_File_hRef.isArch=2,ColorSysGray,0)}};
  GP_File_hRef.Add_Date 'Дата добавления' (,,sci18Esc):[10],Protect,NoDel,NoPickbutton ;
  GP_File_hRef.Add_Time 'Время добавления'(,,sci18Esc):[10],Protect,NoDel,NoPickbutton ;
  GP_File_hRef.Descr    'Деск.польз'      (,,sci18Esc):[10],Protect,NoDel,NoPickbutton ;
  GP_File_hRef.DesGr    'Группа дескр.'   (,,sci18Esc):[10],Protect,NoDel,NoPickbutton ;

  GP_File_hRef.hRef       'Ссылка'        (,,sci18Esc):[40],Protect,NoDel,NoPickbutton ;
  GP_File_hRef.subject    'Примечание'    (,,sci18Esc):[40],Protect,NoDel,NoPickbutton ;
  GP_File_hRef.sFile      'Файл'          (,,sci18Esc):[30],Protect,NoDel,NoPickbutton ;
  GP_File_hRef.tipDoc     'Тип'           (,,sci18Esc):[10],[list 0 ' ', 1 'Результат оценки'],Protect,NoDel;
end;
//================================
HandleEvent
//--------------------
cmInit:
{
  SetWindowTitle(wnViewFile, GetIHead()) ;
  if GP_File_hRef.wTable <> 25001
    then
     {
       cfsSetProp('c_BRVIEWFILE_GP_FILE_HREF.TIPDOC_Тип','HIDDEN',TRUE);
     }
     else
      {
        cfsSetProp('c_BRVIEWFILE_GP_FILE_HREF.TIPDOC_Тип','HIDDEN',FALSE);
      }
}
cmDone:
{
  wArch := 0;
  SetVisibleArch;
}
//--------------------
cmOk:
{ if not CanEditTbl
  { message('У вас нет прав на добавление файла!');
    exit;
  }
  sFile_New:=GetFileName('*.*','Выберите файл для добавления');
  if sFile_New<>''
  { timelog('GP_File_hRef->cmOk sFile_New='+sFile_New);
    Add_File(wTableMain, cRecDoc,sFile_New);
    ReReadRecord(#GP_File_hRef);
    if getlast GP_File_hRef =tsok {}
  }
}
//--------------------
cmDefault:
{ var aDosCode, aErrorCode: integer;
  //http://dep968-galweb/стражи.pdf
  //pfKeepWindow $0010 DOS Сохранять окно на экране. Стирать по "пустому" вызову (при aFileName=''), что может быть полезно при запуске нескольких программ
  //aDosCode:= ExecProgram('',GP_File_hRef.hRef , 'Поиск файла', 0, aErrorCode);
  //"C:\Program Files\Internet Explorer\iexplore.exe"
  if Web_Browser<>'' //'@start '
  { aDosCode:= ExecProgram('',Web_Browser+' '+GP_File_hRef.hRef , 'Просмотр файла', pfDontWait, aErrorCode);
  }
  else
  { aDosCode:= ExecProgram('',GP_File_hRef.hRef , 'Просмотр файла', pfKeepWindow+pfDontWait, aErrorCode);
  }
  if aDosCode <> 0 then {
    Message('Программа не запустилась !', mfError);

  } else {
    if aErrorCode <> 0 then
      Message('Ошибка открытия гиперссылки !', mfError);
  }
}
//--------------------
cmHotKeys:
{ PutHotCommand(RunMenu(GetIHotKey ));
}
//--------------------
cmValue1:
{ set wArch:=2-wArch;
  SetVisibleArch;
  SetWindowTitle(wnViewFile, GetIHead()) ;
}
cmValue2:
{
  lnFile:=1;
  var www_str : string = GetDirName('','\\dep968-terminal\User_disk\Galaktika\WorkFolder\erpdb\'+upcase(username),0,'');
  _loop GP_File_hRef
  {
    if not CopyMoveFile('\\dep968-galweb\DOC$'+Substr(GP_File_hRef.sFile,63,100) ,www_str+'\Приложенный файл №'+lnFile+' '+GP_File_hRef.subject,false,1+8)
    { message('Ошибка копирования файла '+GP_File_hRef.subject);
      exit;
    }
    else{
     lnFile+=1;
    }
  }
  lnFile:=lnFile-1;
  if lnFile>0{
    message('Файлы скачаны: '+lnFile);
  }

}
end;
end;//window wnViewFile 'Список файлов' , EscClose;


//------------------------------------------------------------------------------
#doc
   Проверить наличие скана
   Пробуем проверять не чаще чем раз в минуту
#end
Function Find_File_hRef:boolean;
var _cur_time:time;
{ Result:=False;
  if getfirst tmp_file_href=tsok
  { Result:=tmp_file_href.Exist;
    if not Result //только если отрицательный результат, то проверим
    { _cur_time:=cur_time;
      if (sub_time(_cur_time,tmp_file_href.Tm)>time(0,1,0,0))
      { Result:=(RecordExists GP_file_href)=tsok;
        update current tmp_file_href set tmp_file_href.Exist:=Result,tmp_file_href.Tm:=_cur_time;
      }
    }
  } //if getfirst tmp_file_href=tsok
  else
  { Result:=(RecordExists GP_file_href)=tsok;
    _cur_time:=cur_time;
    insert into tmp_file_href set
        tmp_file_href.Exist  := Result
       ,tmp_file_href.Tm     := _cur_time
       ,tmp_File_hRef.wTable := wTableMain
       ,tmp_File_hRef.cRec   := cRecDoc
       ;
  } //else if getfirst tmp_file_href=tsok
} //Function Find_File_hRef:boolean;
//------------------------------------------------------------------------------
#doc
   Инициализация параметров интерфейса
#end
Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _wTable    : word;  // ссылка на "Ведомость"
  _cRec      : comp=0;   // выбранная запись
  _Option    : longint=0; // опции биты 1- окно просмотра, 2 - наличие файлов, 3 - очистка кэша
  _NoVisual  : boolean=false; //не перерисовывать экраны
  _sWinTitle : string = ''; // название окна
  _wTipDoc   : word = 0 //
) : boolean;
{
  set wIntMode   := _wIntMode  ;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  wArch:=0;
  wTableMain := _wTable    ;  // ссылка на "Ведомость"
  set cRecDoc    := _cRec      ;   // выбранная запись
  set wOption    := _Option    ; // опции
  set sWinTitle  := _sWinTitle;
  set wTipDoc  := _wTipDoc;
  boNoVisual :=_NoVisual  ; //не перерисовывать экраны
  //---- Потом примет значение CanEditTbl
  isProtect:=CanEditTbl;

  if IsBitCTW(wOption, 3)
    if getfirst tmp_file_href = tsok
      delete current tmp_file_href;

  if IsBitCTW(wOption,1)
  { //------------------------
    if timelog_Status>0
    timelog('GP_File_hRef->InitParam'
     +',wIntMode='  +string(wIntMode)
     +',wTableMain='+string(_wTable)
     +',cRecDoc='   +string(_cRec)
     +',wOption='   +string(_Option)
     +',boNoVisual='+string(_NoVisual)
    );

    SetEditMode(CanEditTbl);
    //------------------------
    SetVisibleArch;
    //------------------------

    runWindowModal(wnViewFile);
  }
  else
  if IsBitCTW(wOption,2)
  { Result:=Find_File_hRef;
    Exit;
  }
  Result:=true;
} //Function InitParam(


TableEvent table GP_File_hRef ;
//--------------------
cmSetDefault:
{ Exit;
}
//--------------------
cmInsertRecord : exit;
//--------------------
cmUpdateRecord :
{ //exit;
  update current GP_File_hRef;
}
//--------------------
cmDeleteRecord :
{ if not CanEditTbl
  { message('У вас нет прав на редактирование ');
    exit;
  }
  if message('Подтвердите удаление файла'
    +chr(13)+GP_File_hRef.subject
     ,YesNo)=cmYes
  { GP_File_hRef.isArch:=2;
    update current GP_File_hRef;
    ReScanPanel(#GP_File_hRef);
  }
  if getfirst tmp_file_href = tsok
    delete current tmp_file_href;
}
end; //TableEvent table GP_File_hRef


//****************************************
// События интерфейса
//****************************************
HandleEvent
//--------------------
cmInit:
{ timelog('GP_File_hRef->cmInit');
  InitParam(  wIntMode
    , wTableMain
    , cRecDoc
    , wOption
    );
  CloseInterface(cmDone);
}

end;//HandleEvent
end.

HotI_GP_File_hRef Menu
{
  - 'отобразить/скрыть архивные',cmValue1,''                         ,hcNoContext,'',,sci1Esc;
}
