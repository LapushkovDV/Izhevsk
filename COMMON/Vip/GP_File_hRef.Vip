var
//----------------------------------------
// объекты
//----------------------------------------
  DataProtector       : IGP_Protector2;      // защита полей от модификации
//----------------------------------------
  boNoVisual:boolean;
  isProtect :boolean;
  lnFile :longint;
  sFile_New :string;
  HREF_F_Path :string;//Хранилище файлов для доступа через WEB:Папка для отправки файлов
  HREF_F_HREF :string;//Хранилище файлов для доступа через WEB:сайт для просмотра
  Web_Browser :string;//WEB браузер(iexplore.exe, пусто - авто определение Windows
  sWinTitle : string; // Заголовок окна снаружи
  wTipDoc   : word; // Тип документа    !!!!!! ИСПОЛЬЗОВАТЬ КОНСТАНТЫ ИЗ GP_CONST
//----------------------------------------------------
Table struct tmp_file_href
(   wTable :word
  , cRec   :comp
  , tM     :time
  , Exist  :boolean
)
with index
( tmp_href01 = wTable+cRec
);
//----------------------------------------------------
//function getnamebytip(_tip : word) : string; forward;
create view vHref
var
  wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  wTableMain: word;  // код таблицы
  cRecDoc   : comp;  // ссылка на Nrec таблицы
  cCurRec   : comp;  // текущая позиция документа
  wOption   : word;  // опции - 1 запуск окна для ввода
  wArch     : word;  // просмотр архивных файлов
as select
GP_File_hRef.Nrec
//,getnamebytip(GP_File_hRef.tipdoc) (FieldName = NameTip)
From GP_File_hRef,tmp_file_href
where ((
    wTableMain == GP_File_hRef.wTable
and cRecDoc    == GP_File_hRef.cRec
and wArch      == GP_File_hRef.isArch
and wTableMain == tmp_File_hRef.wTable
and cRecDoc    == tmp_File_hRef.cRec
and wTipDoc    == GP_File_hRef.TipDoc  (noindex)
))
bounds byWithArch  wTableMain == GP_File_hRef.wTable
         and cRecDoc    == GP_File_hRef.cRec
         and wTipDoc    == GP_File_hRef.TipDoc (noindex)
 //and wArch      == GP_File_hRef.isArch

//bounds byTipDoc wTipDoc == GP_File_hRef.TipDoc (noindex)
;
/*
function getnamebytip(_tip : word) : string; cacheable;
{
 case _tip of
   1 : result := 'Результат обучения'
  else result := ''
 end;
}
*/
//GP_COMMON::GP_FILE_HREF
//0,1000,254545100,1
Parameters
  wIntMode
#doc
   режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
#end
, wTableMain
, cRecDoc
, wOption
, sWinTitle
, wTipDoc
;

//==============================================================================
//        ОПИСАНИЕ СТАНДАРТНЫХ МЕТОДОВ ИНТЕРФЕЙСА (СЕКЦИЯ 1)
//******************************************************************************
//------------------------------------------------------------------------------
// Конструктор интерфейса
//------------------------------------------------------------------------------
Constructor Init;
{ Result:=true;
  timelog_init;
  //---------------------
  if NullVipRef(DataProtector)
  { LoadVipRef(DataProtector, 'GP_Protector');
    DataProtector.LinkToExt(cfsGetCurrentContainerSelf, 'GP_File_hRef', true);
    DataProtector.ProtectedStatusCtx := sci1Esc;
    DataProtector.AutoPalette := true;
  } //if NullVipRef(DataProtector)
  HREF_F_Path :=sGetTune('NPOEM_OWN.HREF_F_Path');//Хранилище файлов для доступа через WEB:Папка для отправки файлов
  if SubStr(HREF_F_Path,Length(HREF_F_Path),1)<>'\'
     HREF_F_Path:=HREF_F_Path+'\';

  HREF_F_HREF :=sGetTune('NPOEM_OWN.HREF_F_HREF');//Хранилище файлов для доступа через WEB:сайт для просмотра
  if SubStr(HREF_F_HREF,Length(HREF_F_HREF),1)<>'/'
     HREF_F_HREF:=HREF_F_HREF+'/';
  Web_Browser:=sGetTune('NPOEM_OWN.Web_Browser');//'WEB браузер(iexplore.exe, пусто - авто определение Windows'
  //----------------------
  if not boGetTune('NPOEM_OWN.HREF_F_F8')
  { DisableCommand(cmDelete);
    DisableCommand(cmDeleteRecord);
  }
  else
  { EnableCommand(cmDelete);
    EnableCommand(cmDeleteRecord);
  }


} //Constructor Init;

//------------------------------------------------------------------------------
// Деструктор интерфейса
//------------------------------------------------------------------------------
Destructor  Done;
{
}
//----------------------------------------

//------------------------------------------------------------------------------
// Наименование интерфейса
//------------------------------------------------------------------------------
Function GetIName : string;
{ Result := #(__InterfaceName__);
}
//------------------------------------------------------------------------------
// Заголовок интерфейса
//------------------------------------------------------------------------------
Function GetIHead : string;
{ Result := 'Файлы к документу';
  if wArch=2
  { Result := Result+'(+ архив)';
  }
  if sWinTitle <> '' then
  { Result:=sWinTitle
  } //if sWinTitle <> '' then
  else
  { var _sVidDoc:String='';
    var _NoDoc  :String='';
    var _DDoc   :date=ZeroDate;
    _Try
    { case   wTableMain  of
      coBaseDoc:
      {   /*
          (Case Basedoc.VIDDOC
           when =101 then 41
           when =201 then 51
           else 0
           end)*/

        SQL Select BaseDoc.NoDoc,BaseDoc.DDoc,COALESCE(KatDoc.Name,'Документ основание')
        From BaseDoc
        Left Outer join KatDoc on KatDoc.TidkGal =
        (Case Basedoc.VIDDOC
           when 101 then 41
           when 201 then 51
           else 0
           end)
        where Basedoc.Nrec=:(cRecDoc)
        into (_NoDoc,_DDoc,_sVidDoc) ;
      }
      coDogovor:
      { SQL Select Dogovor.NoDoc,Dogovor.DDoc,COALESCE(KatDoc.Name,'')
        From Dogovor
        Left Outer join KatDoc on KatDoc.TidkGal = Dogovor.Tidk
        where Dogovor.Nrec=:(cRecDoc)
        into (_NoDoc,_DDoc,_sVidDoc) ;
      }
      coKatSopr:
      { SQL Select KatSopr.NSopr,KatSopr.DSopr,COALESCE(KatDoc.Name,'')
        From KatSopr
        Left Outer join KatDoc on KatDoc.TidkGal = KatSopr.VidSopr
        where KatSopr.Nrec=:(cRecDoc)
        into (_NoDoc,_DDoc,_sVidDoc) ;
      }
      coMnPlan:
      { SQL Select MnPlan.Number,MnPlan.STATEMDATE,''
        From MnPlan
        where MnPlan.Nrec=:(cRecDoc)
        into (_NoDoc,_DDoc,_sVidDoc) ;
      }
      coPlPor:
      { SQL Select PlPor.NoDok,PlPor.DatVip,COALESCE(KatDoc.Name,'')
        From PlPor
        Left Outer join KatDoc on KatDoc.TidkGal = PlPor.TIDKGAL
        where PlPor.Nrec=:(cRecDoc)
        into (_NoDoc,_DDoc,_sVidDoc) ;
      }
      end;
    }
    _Except
    else
    {
    }
    Result:=Result+if(_NoDoc<>'',' № '+_NoDoc,'')
                  +if(_DDoc <>ZeroDate,' от '+DateToStr(_DDoc,'DD/MM/YYYY'),'')
                  +if(_sVidDoc <>'',', '+_sVidDoc,'')
                  ;
  } //else if sWinTitle <> '' then
} //Function GetIHead : string;

//------------------------------------------------------------------------------
// Наименование меню
//------------------------------------------------------------------------------
Function GetIHotKey : string;
{ Result := #mAddCurComponentName('HotI_'+GetIName);
}

//------------------------------------------------------------------------------
// Текущая позиция
//------------------------------------------------------------------------------
Function GetCurRec : comp;
{ Result :=  GP_File_hRef.NRec;
}
//------------------------------------------------------------------------------
// можно ли редактировать документ
//------------------------------------------------------------------------------
Function CanEditTbl:boolean;
{ Result:=(wIntMode and cgiNotEdit)=0;
}

//------------------------------------------------------------------------------
// установка режима редактирования
//------------------------------------------------------------------------------
procedure SetEditMode(Value: boolean);
{ //isProtect:=not Value;
  if isProtect<>Value then exit;
  //-- Защищаем запись
  DataProtector.SetProtected(not Value);
  //----------------------------
  if Value
  { cfsSetProp(cfsGetCurrentContainerSelf, cfpPalette, wpBlueWindow);
    EnableCommand(cmDelete);
    EnableCommand(cmDeleteRecord);
  }
  else
  //----------------------------
  { cfsSetProp(cfsGetCurrentContainerSelf, cfpPalette, wpCyanWindow);
    DisableCommand(cmDelete);
    DisableCommand(cmDeleteRecord);
  }
  isProtect:=not Value;
  ReScanPanel(#GP_File_hRef);
} //Procedure SetEditMode(_isEdit:boolean);

//------------------------------------------------------------------------------
// Добавить файл
//------------------------------------------------------------------------------
Function Add_File(
            _wTable    :word;  // ссылка на "Ведомость"
            _cRec      :comp;   // выбранная запись
            _sfile     :string
      ) :boolean;
var
    _sFile_New, _sFile_New_S:string;
    _sSub_Path:string;
    _ext:string;
    _sRef:string;
{ Result:=false;
  timelog('GP_File_hRef->Add_File _sfile='+_sfile+', _crec='+String(_crec));
  if not FileExist(_SFile) then
  { timelog('GP_File_hRef->Add_File не нашли файл');
    Exit;
  }
  _sSub_Path:=LpadCh(_wTable,'0',6)+'\'+String(_Crec)+'\';
  _ext:='';
  _Ext:=substr(_sfile,PosR('.',_sFile),100);
  _sFile_New_S:=OleGenerateGUID+_Ext;
  _sFile_New:=HREF_F_Path+_sSub_Path+_sFile_New_S;
  timelog('GP_File_hRef->Add_File CopyMoveFile '+_sFile_New);
  if not CopyMoveFile(_sfile,_sFile_New,false ,ecmfServerFrom+ecmfClientTo) then
  { message('Ошибка копирования файла '+_sfile
     +chr(13)+'в '+_sFile_New);
    exit;
  }
  _sRef:=HREF_F_HREF+Replace(_sSub_Path,'\','/')+_sFile_New_S;
  ClearBuffer(#GP_File_hRef);
  GP_File_hRef.wTable  :=_wTable;
  GP_File_hRef.cRec    :=_cRec;
  GP_File_hRef.Descr   :=sGetTune('USER.DESCR');
  GP_File_hRef.DesGr   :=sGetTune('USER.DESGR');
  GP_File_hRef.cUser   :=UserId();
  GP_File_hRef.Add_Time:=Cur_Time;
  GP_File_hRef.Add_Date:=Cur_Date;
  GP_File_hRef.sfile   :=_sFile_new;
  GP_File_hRef.hRef    :=_sRef;
  GP_File_hRef.subject :=substr(_sfile,PosR('\',_sFile)+1,100);
  GP_File_hRef.tipDoc  := wTipDoc;
  Result:=( insert current GP_File_hRef=tsok);
  if not Result
  { timelog('GP_File_hRef->ошибка вставки в GP_File_hRef');

  }
  var _cur_time:time;
  _cur_time:=cur_time;
  if getfirst tmp_file_href=tsok
  { update current tmp_file_href set tmp_file_href.Exist:=Result,tmp_file_href.Tm:=_cur_time;
  }
  else
  { insert into tmp_file_href set
        tmp_file_href.Exist  := Result
       ,tmp_file_href.Tm     := _cur_time
       ,tmp_File_hRef.wTable := wTableMain
       ,tmp_File_hRef.cRec   := cRecDoc
       ;
  } //else if getfirst tmp_file_href=tsok

  timelog('GP_File_hRef->Add_File Finish');
} //Function Add_File(

//===========================================
// скрыть/отобразить архив
//------------------------------------------
Procedure SetVisibleArch;
{ case wArch of
  0:   PushBounds(#GP_File_hRef);
  else PushBounds(tbbyWithArch);
  end;
} //Procedure SetVisibleArch;

