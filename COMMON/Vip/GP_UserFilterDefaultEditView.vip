#include GP_IUserFilter.obj

#component "GP_Common"

#include GP_UserFilterDefaultEditView.vih
interface GP_UserFilterDefaultEditView;

var
  _userFilter: GP_IUserFilter;
  _caption: string;

create view;

screen scUserFilter (,,sci13Esc);
fields
  [UserFilterFld] _userFilter.FilterStr: protect, pickbutton, {label=_caption};
<<
`                                                                  `
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

handleevent
  cmPick:
  {
    _userFilter.Pick;
    rereadrecord;
  }
  cmDelOnProtect:
  {
    _userFilter.Del;
    rereadrecord;
  }
  cmDefault:
  {
    OnCmDefault;
  }
end;

constructor Init;
{
  result := false;
}


constructor UserFilterDefaultEditView(aUserFilter: GP_IUserFilter; aCaption: string = '');
{
  _userFilter := aUserFilter;
  Caption     := aCaption;
  result      := _userFilter != nullref;
}

property UserFilter: GP_IUserFilter read _userFilter;
property Caption: string absolute _caption;

end.
