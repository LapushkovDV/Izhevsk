#include GP_SettingsSelector.vih
interface GP_SettingsSelector;
show(,,80,2);

var ProgCode:word;
    CurUser:comp;
    CurUserName:string;
    CurSettingNrec:comp;
    NewSettingName:string;

create view
from
  UserDeskRep CurSetting,
  UserDeskRep SettingList,
  PickRep, AddPickR
where((
  CurSettingNrec==CurSetting.NRec and
  ProgCode==SettingList.nRep and
  CurUser==SettingList.cUser
))
bounds ByDefSetting = 1==SettingList.InUse(noindex);

screen scSetting (,,sci1Esc);
table CurSetting;
fields
  CurSetting.RepName (,,sci13Esc):Protect, PickButton, NoDel;
buttons
  cmSaveSetting, [SingleLine],,, 'Сохранить настройку',,,;
  cmSaveSettingAs, [SingleLine],,, 'Сохранить настройку под другим именем',,,;
  cmDelSetting, [SingleLine],,, 'Удалить настройку',,,;
<<
 `Настройка`           <.  Сохранить   .> <.Сохранить как .> <.   Удалить    .>
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

window WinEditSettings 'Редактирование настройки' Blue;
show(20,5,130,25);

browse brSettingListEdit (,,sci178Esc);
table SettingList;
fields
  {font={bold=(SettingList.InUse=1)}};
  SettingList.dRep 'Дата', 'создания':[10], Protect, NoAutoSize;
  SettingList.RepName 'Наименование':[50], NoProtect,
    {font={BackColor=if(Trim(SettingList.RepName)='',ColorNeed,0)}};
  SettingList.RepOpi 'Описание':[50], NoProtect;
end;

HandleEvent
cmDelete:{
  if (message('Удалить настройку?',yesno+Warning+mfSwapButtons)<>cmYes) stop;
}
end;
end;//WinEditSettings

window WinPickSettings 'Выбор настройки' Cyan, DoAccept, EscClose;
show(20,5,130,25);

browse brSettingList (,,sci14Esc);
table SettingList;
fields
  {font={bold=(SettingList.InUse=1)}};
  SettingList.dRep 'Дата', 'создания':[10], Protect, NoAutoSize;
  SettingList.RepName 'Наименование':[50], Protect;
  SettingList.RepOpi 'Описание':[50], Protect;
end;

HandleEvent
cmEdit:{
  RunWindowModal(WinEditSettings);
}
end;
end;//WinPickSettings

window WinNewSettingName 'Сохранить настройку под именем' Gray, DoAccept, EscClose;
show(20,10,90,15);

screen scNewSettingName (,,sci1Esc);
table CurSetting;
fields
  NewSettingName:NoProtect, anAll,
    {font={BackColor=if(Trim(NewSettingName)='',ColorNeed,0)}};
buttons
  cmOK,,, 'Продолжить',,, anLeft;
  cmClose,,, 'Отмена',,, anRight;
<<
  `Наименование настройки`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <. Продолжить .>                                  <.   Отмена   .>
>>
end;

HandleEvent
cmInit:{
  NewSettingName:=CurSetting.RepName+' (копия)';
}
cmOK:{
  PutCommand(cmDefault);
}
cmDefault:{
  if (Trim(NewSettingName)='') {
    message('Пожалуйста, укажите имя настройки.', error);
    stop;
  }
}
end;
end;//WinNewSettingName

function SetDefSetting(Val:word = 1):boolean;
{
  CurSetting.InUse:=Val;
  result:=update current CurSetting = tsok;
}

function GetDefSettingBuf:type$UserDeskRep;
var buf:type$UserDeskRep;
{
  ClearAdvRecord(buf);
  buf.nRep:=ProgCode;
  buf.cUser:=CurUser;
  buf.OwnName:=CurUserName;
  buf.dRep:=Cur_Date;

  result:=buf;
}

function AddDefSetting(SettingName:string = ''):comp;
{
  result:=0;

  CurSetting.buffer:=GetDefSettingBuf;
  if (SettingName='')
    CurSetting.RepName:='Настройка по умолчанию'
  else
    CurSetting.RepName:=SettingName;
  CurSetting.InUse:=1;
  if (insert current CurSetting = tsok)
    result:=CurSetting.NRec
  else
    message('Ошибка вставки записи в таблицу UserDeskRep.', error);
}

procedure FindValidSetting;
{
  CurSettingNrec:=0;

  if (getfirst SettingList = tsok) {
    set CurSettingNrec:=SettingList.NRec;
    SetDefSetting;
  } else {
    set CurSettingNrec:=AddDefSetting;
  }
}

TableEvent table SettingList;
cmSetDefault:{
  SettingList.buffer:=GetDefSettingBuf;
}
cmCheckField:{
  case CurField of
    #SettingList.RepName:{
      if (Trim(SettingList.RepName)='') {
        message('Пожалуйста, укажите имя настройки или удалите запись.', error);
        abort;
      }
    }
  end;
}
cmInsertRecord:{
  insert current SettingList;
}
cmUpdateRecord:{
  update current SettingList;
}
cmDeleteRecord:{
  DelSetting(SettingList.NRec);
}
end;

HandleEvent
cmInit:abort;
cmPick:{
  case CurField of
    #CurSetting.RepName:{
      OnSaveCurSetting(CurSettingNrec);

      if (RunWindowModal(WinPickSettings)=cmDefault) {
        if (IsValidAll(tnSettingList))
          if (CurSettingNrec<>SettingList.NRec) {
            SetDefSetting(0);
            set CurSettingNrec:=SettingList.NRec;
            SetDefSetting;
            OnChangeCurSetting(CurSettingNrec);
          }
      }

      if (getfirst CurSetting <> tsok) {
        FindValidSetting;

        OnChangeCurSetting(CurSettingNrec);
      }
    }
  end;
}
cmSaveSetting:{
  OnSaveCurSetting(CurSettingNrec);
}
cmSaveSettingAs:{
  if (RunWindowModal(WinNewSettingName)=cmDefault) {
    SetDefSetting(0);
    set CurSettingNrec:=AddDefSetting(NewSettingName);
    OnSaveCurSetting(CurSettingNrec);
  }
}
cmDelSetting:{
  if (message('Удалить настройку "'+CurSetting.RepName+'"?',yesno+Warning+mfSwapButtons)<>cmYes) exit;

  if (not DelSetting(CurSetting.NRec)) exit;

  FindValidSetting;

  OnChangeCurSetting(CurSettingNrec);
}
end;

constructor Init;
{
  result:=true;

  CurUser:=UserId;
  CurUserName:=UserName;
}

function DelSetting(cSetting:comp):boolean;
{
  result:=false;

  _loop PickRep where((cSetting==PickRep.cUserDeskRep))
    if (delete AddPickR where((PickRep.NRec==AddPickR.cPick))<>tsok) {
      message('Ошибка удаления записи в таблице AddPickR.', error);
      exit;
    }

  if (delete PickRep where((cSetting==PickRep.cUserDeskRep))<>tsok) {
    message('Ошибка удаления записи в таблице PickRep.', error);
    exit;
  }

  result:=delete SettingList where((cSetting==SettingList.NRec))=tsok;
  if (not result)
    message('Ошибка удаления записи в таблице UserDeskRep.', error);
}

procedure SetProgCode(Val:word);
{
  if (Val=0 or Val=ProgCode) exit;

  ProgCode:=Val;
  CurSettingNrec:=0;

  AddBounds(tbByDefSetting);
  if (getfirst SettingList = tsok)
    set CurSettingNrec:=SettingList.NRec;
  PopBounds(tbByDefSetting);

  if (CurSettingNrec=0)
    FindValidSetting;
}

property wProgCode:word read ProgCode write SetProgCode(result);
property cCurSetting:comp absolute CurSettingNrec read;

end.
