#include Marker.vih

interface GP_PickGroups 'Выбор группы пользователей', Cyan, DoAccept, EscClose;
show(20,5,90,25);

var Mode:word;
    cCurGroup:comp;
    hMarker:longint;
    pMarker:IMarker(Marker) new;

create view
as select
  Groups.Name
from
  Groups;

parameters Mode,cCurGroup,hMarker;

browse brGroups (,,sci1EscIns);
table Groups;
recMarker=pMarker;
fields
  'IMGARMGROUP' '':[2],Image;
  Groups.Name 'Наименование группы' ('Наименование группы',,):[50],Protect;
end;

HandleEvent
cmInit:{
  if ((Mode and cgiPickMult)=cgiPickMult) {
    if (hMarker=0) {
      message('Не задан маркер для множественного выбора.',error);
      abort;
      exit;
    }

    pMarker.ImportFrom(hMarker);
    SetHelpAndStatusContext(brGroups, -1, sci1EscIns, hcKeepCurrent);
  } else {
    PutCommand(cmValue1);

    if ((Mode and cgiPick)=cgiPick)
      SetHelpAndStatusContext(brGroups, -1, sci1Esc, hcKeepCurrent);
  }

  if (cCurGroup<>0)
    if (getfirst Groups where((cCurGroup==Groups.Atl_NRec))=tsok) {};
}
cmValue1:{
  pMarker.Disable:=true;
}
cmDefault:{
  if ((Mode and cgiPickMult)=cgiPickMult) {
    if (pMarker.Count=0)
      pMarker.Mark;

    pMarker.ExportTo(hMarker);
  }

  cCurGroup:=Groups.Atl_NRec;
}
end;
end.
