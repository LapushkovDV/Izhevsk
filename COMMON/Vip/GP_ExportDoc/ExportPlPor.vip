#include ExportDoc.vih
#include ExportDoc_GP.vih

#component "L_Common"

#doc
Экспорт платежного документа для формирования ЭЦП
#end
Interface ExportPlPor 'Экспорт платежного документа для формирования ЭЦП';

Create view
var
  pPlPor:comp;
As select PlPor.Nrec

From
  PlPor
where (( pPlPor == PlPor.NRec
 and PlPor.cVal == klVal.Nrec
))
;

//------------------------------------------------------------------------------
Function TheFile(_FileName: string): comp; forward;
Function Document(_Node: comp; _NodeName: string): comp; forward;
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
// [OVERRIDEN] Перегруженные методы интерфейса-предка

// Префикс имени XML-файла (для СФ это 'ON_SFAKT')
Function ObjExportDoc.FileNamePrefix: string;
{
  result := 'ON_PlPor';
}

// Позиционирование на документ, определение контрагента
Function ObjExportDoc.GotoDoc(_Doc: comp): boolean;
{
  result := false;
  set pPlPor:=_Doc;
  if (GetFirst PlPor  = tsOk)
    result := true;
}

// Дата документа
Function ObjExportDoc.DocDate: date;
{
  result := PlPor.DatVip;
}

// Выгрузка содержимого документа в XML-формат
Function ObjExportDoc.Export(_Path, _FileName, _IdPok: string): boolean;
{
  #__UnUsed__(_IdPok)

  result := true;

  oXMLConverter.Init;
  oXMLConverter.SortAttrByName := false;
  TheFile(_FileName);
  oXMLConverter.SaveTxmlTablesEncoding(_Path + _FileName + '.xml', 'UTF-8');
}

//Выгрузка содержимого документа в XML-формат в таблицы интерфейса XMLConverter
Function ObjExportDoc.ExportToObj(_FileName, _IdPok: string; var _oXMLConverter : XMLConverter): boolean;
{
  #__UnUsed__(_IdPok)

  oXMLConverter := _oXMLConverter;

  result := (TheFile(_FileName) <> 0);

  _oXMLConverter := oXMLConverter;
}

//------------------------------------------------------------------------------
Function TheFile(_FileName: string): comp;
{
  result := AddNode(0, 'Файл');
  AttribRequired(result, 'ИдФайл', _FileName); // Идентификатор файла. Содержит (повторяет) имя сформированного файла (без расширения)
  AttribOptional(result, 'ВерсПрог', 'Галактика ERP 9.1'); // Версия передающей программы
  Document(result, 'Документ'); // Счет-фактура, применяемый при расчетах по налогу на добавленную стоимость
}

Function Document(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'ВидДок'  , string(PlPor.TidkGal));  // Вид сопроводительного документа
  AttribRequired(result, 'НомерДок', PlPor.NoDok);            // Номер сопроводительного документа
  AttribRequired(result, 'ДатаДок' , Dat(PlPor.DATVIP));       // Дата составления сопроводительного документа
  AttribRequired(result, 'СуммаДок', String(PlPor.SUMPLAT,0,2));       // Дата составления сопроводительного документа
  if PlPor.cVal>0
  { AttribRequired(result, 'СуммаВалДок', String(PlPor.SUMPLATV,0,2));       // Дата составления сопроводительного документа
    AttribRequired(result, 'Вал', String(KlVal.DOLLAR,0,2));       // Дата составления сопроводительного документа
  }
}

End.
