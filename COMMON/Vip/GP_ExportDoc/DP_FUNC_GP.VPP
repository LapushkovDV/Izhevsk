//------------------------------------------------------------------------------
// Сформировать наименование файла экспорта Export_base.vip
Function GetNameFileExport_GP(pIDOEDO: string;VA_NAME:String='ЭДО GUID'): string;
{ //Result:=Inherited::GetNameFileExport(pIDOEDO)
  sGUID:= sGetAttr(coKatSopr, TmpKatSopr.cKatSopr, VA_NAME) ;
#IFDEF _GP_
  if sGUID=''
  { sGUID  := BuhXml_CreateGUID36;
    sSetAttr(coKatSopr, TmpKatSopr.cKatSopr, VA_NAME, sGUID)
  }
#ELSE  
  sGUID  := BuhXml_CreateGUID36;
#ENDIF
  Result := FileNamePrefix + pIDOEDO + '_' + oEDO.MyOrgID + '_' +
            DatetoStr(Cur_Date, 'YYYYMMDD')   + '_' + sGUID;
  MyLog('DP_???->GetNameFileExport:Result='+Result)
}//Function GetNameFileExport(pIDOEDO: string): string;

//------------------------------------------------------------------------------
// Текстовая информация (ТекстИнфТип)
Function TextInfTip_GP(_Node: comp; _NodeName: string;_wMode:word=0;_wColMemo:word=0): comp; //
{
#IFDEF _GP_
  if _NodeName='ТекстИнф' or _NodeName='ИнфПолФХЖ3'
  { var Attr_DOG_ID:comp=0;
    var ID_ERP,ID_DOG,ID_DIR,_DESGR,_DESCR, _ISP_DESCR, _ISP_DESGR, _ISP_FIO:string='';
    var ID_LINK:string='';
    var ID_NAME,ID_VAL:string='';
    var Remark_Comment:string;
    var ii :word;
    if false //wGetTune('GALCOMMON.DIRECTUM.EDO_DOP_FLD')>0
    { ID_ERP:='KATSOPR.'+string(TmpKatSopr.cKatSopr);
      //Directum_IDED:=sGetTune('GALCOMMON.DIRECTUM.ATTR_IDED_NAME');
      //ID_DIR:=sGetAttr(coKATSOPR,TmpKatSopr.cKatSopr,Directum_IDED);
      ID_DIR:='';
      vDop.pNrec:=TmpKatSopr.cKAtSopr;
      if vDop.GetFirst KAtSopr=tsok
      { _DESGR:=vDop.KatSopr.DESGR;
        _DESCR:=vDop.KatSopr.DESCR;
        if vDop.KatSopr.cSchFact>0
          ID_LINK:='SCHFACT.'+string(vDop.KatSopr.cSchFact);
      }
      _ISP_DESCR:=sGetTune('User.Descr'); // пока нет
      _ISP_DESGR:=sGetTune('User.Desgr'); // пока нет
      _ISP_FIO  :=sGetTune('User.Fio'); // пока нет
      
      //Attr_DOG_ID:=coGetTune('GALCOMMON.DIRECTUM.EDO_DOG_ATTR');
      if Attr_DOG_ID<>0
      { ID_DOG:=sGetAttrID(coDogovor, TmpKatSopr.cDogovor,Attr_DOG_ID); // 
      }
    } 
    Remark_Comment:=sGetAttr(coKatSopr,TmpKatSopr.cKatSopr,'ЭДО. Подпись с замечаниями');
    if _wMode=0
    { FOR(ii:=1;ii<=20;ii++)
      { case ii of 
        01:  { ID_NAME:='ID_ERP';ID_VAL:=ID_ERP;}
        02:  { ID_NAME:='ID_DIR';ID_VAL:=ID_DIR;}
        03:  { ID_NAME:='ID_DOG';ID_VAL:=ID_DOG;}
        04:  { ID_NAME:='Замечания';ID_VAL:=Remark_Comment;}
        05:  { ID_NAME:='DESGR';ID_VAL:=_DESGR;}
        06:  { ID_NAME:='DESCR';ID_VAL:=_DESCR;}
        07:  { ID_NAME:='ISP_DESCR';ID_VAL:=_ISP_DESCR;}
        08:  { ID_NAME:='ISP_DESGR';ID_VAL:=_ISP_DESGR;}
        09:  { ID_NAME:='ISP_FIO'  ;ID_VAL:=_ISP_FIO;}
        10:  { ID_NAME:='ID_LINK'  ;ID_VAL:=ID_LINK;}
        else { ID_NAME:='';ID_VAL:='';}
        end;
        if ID_NAME='' or ID_VAL=''  then continue; 
        result := AddNode(_Node, _NodeName); // До 20
        AttribOptional(result, 'Идентиф', ID_NAME); // Идентификатор
        AttribOptional(result, 'Значен', ID_VAL);  // Значение
      }
    }
    else
    { if _wColMemo>0
      {
      }
      else
      {   AttribOptional(_Node, 'ТекстИнф', 'ID_ERP='+ID_ERP+';ID_DOG='+ID_DOG+';ID_DIR='+ID_DIR); // Текстовая информация
      }
    }  
  }  //if _NodeName='ТекстИнф'
  Exit;
#ELSE  
    result := AddNode(_Node, _NodeName); // До 20
    AttribRequired(result, 'Идентиф', ''); // Идентификатор
    AttribRequired(result, 'Значен', '');  // Значение
#ENDIF    

}

//------------------------------------------------------------------------------
// Наименование организации
Function GetKatOrgName_GP(aOrg : comp): string;
var
  sTipOrg, sName: string;
{
  sTipOrg := oKatOrg.GetKatOrgName(aOrg, koTipOrg) + ' ';
  sName := Trim(oKatOrg.GetKatOrgName(aOrg, koShortName));
  if pos('общество с ограниченной ответственностью',locase(sName))>0
  { Result:=sName;
    exit;
  }
  // Проверяем наличие типа в наименовании
  if (sTipOrg != ' ')
    if (SubStr(sName, 1, Length(sTipOrg)) = sTipOrg)
      sName := SubStr(sName, Length(sTipOrg) + 1, Length(sName));

  result := Trim(sTipOrg + sName);
}
