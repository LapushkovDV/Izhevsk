//------------------------------------------
create view vDop
var pNrec :comp;
as select KatSopr.Nrec
From KatSopr
where (( pNrec == KatSopr.Nrec
));
//==============================================
procedure mylog(const w :string) ;
//==============================================
{ //if logfilekl
  if logfilenm=''
  { logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0)+ '!ExportSopr.log'
    // if fileexist(logfilenm) deletefile(logfilenm)
  }
  logstrtofile(logfilenm,w)
  
}

