Function SvOrg(_Node: comp; _NodeName: string): comp; forward;
// 5.36 Сведения о российской организации (СвЮЛ);
Function SvUL(_Node: comp; _NodeName: string): comp; forward;
// 5.37 Сведения об иностранной организации (ИнОрг)
Function InOrg(_Node: comp; _NodeName: string): comp; forward;
