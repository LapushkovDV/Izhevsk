Function PredOrgPol(_Node: comp; _NodeName, _sFIO, _sPost, _sDover: string): comp; forward;
// 7.12 Физическое лицо, которому доверено получение товара (груза) (ФЛ)
Function FLPol(_Node: comp; _NodeName, _sFIO, _sDover: string): comp; forward;
