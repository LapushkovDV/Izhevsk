Function SvIPTip(_Node: comp; _NodeName: string): comp; forward;
// 5.32, 7.18 Сведения об индивидуальном предпринимателе (СвИПТип)
Function SvFLTip(_Node: comp; _NodeName: string): comp; forward;
// 5.34 Идентификационные сведения (ИдСв)
Function IdSv(_Node: comp; _NodeName: string): comp; forward;
