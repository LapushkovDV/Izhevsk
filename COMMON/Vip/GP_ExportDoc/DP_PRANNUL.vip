//------------------------------------------------------------------------------

Function TOKEI(_Value: string): string[4];
{
  if (_Value = '') or (_Value = '-')
    _Value := '0000';

  result := _Value;
}

Function NameDocOpr: string;
{
  result := 'Соглашение об аннулировании документа';
}

Function GetValKod(_cVal: comp): string;
{
  Result := '';

  if (GetFirst KlVal where ((_cVal == KlVal.nRec)) = tsOk)
    Result := KlVal.ISO;
  else
    Result := sGetTune('NDE.RublISO');
}

Function GetValName(_cVal: comp): string;
{
  Result := '';

  if (GetFirst KlVal where ((_cVal == KlVal.nRec)) = tsOk)
    Result := KlVal.Dollar;
  else
    Result := 'Российский рубль';
}

Function OblPolnForBuyer(_OblPoln : word) : word;
{
  case _OblPoln of
    1, 4 : Result := 1; // лицо, совершившее сделку, операцию;
    6, 2 : Result := 2; // лицо, совершившее сделку, операцию и ответственное за ее оформление;
    3, 5 : Result := 3; // лицо, ответственное за оформление свершившегося события
  end;
}

Function GetStatusSigner(_Param: word): word;
var sOrg: string;
{
  Result := 1;

  if (TmpSigners.cOrg = comp(0))
    Exit;

  if ((_Param = 1) and (TmpSigners.cOrg = TmpKatSopr.cOrgBase))
    Exit;

  Result := 3;

  if (GetFirst TmpKatOrg where ((TmpSigners.cOrg == TmpKatOrg.cKatOrg)) = tsOk)
    if (TmpKatOrg.wType <> 0)
      Result := 4;
}

//------------------------------------------------------------------------------
// 5.1 Файл обмена (Файл)
Function TheFile(_FileName, _IdPok: string): comp;
{
  result := AddNode(0, 'Файл');

  AttribRequired(result, 'ИдФайл'  , _FileName);           // Идентификатор файла
  AttribOptional(result, 'ВерсПрог', 'Галактика ERP 9.1'); // Версия передающей программы
  AttribRequired(result, 'ВерсФорм', '1.01');              // Версия формата

  //SvUchDocObor(result, 'СвУчДокОбор', _IdPok);             // Сведения об участниках электронного документооборота
  Document(result, 'Документ',_IdPok);                            // Документ
}

//------------------------------------------------------------------------------
// 5.2 Сведения об участниках электронного документооборота (СвУчДокОбор)
Function SvUchDocObor(_Node: comp; _NodeName, _IdPok: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'ИдУчастЭДО',SubStr(_IdPok, 1, 46));          // Идентификатор участника документооборота, отправителя информации исполнителя
  //SvOEDOtpr(result, 'СвОЭДОтпр');                          // Сведения об операторе ЭДО отправителя информации продавца
  SvUL(result, 'ЮЛ');   // Сведения о российской организации
}

//------------------------------------------------------------------------------
// 5.3 Сведения об операторе ЭДО отправителя информации продавца (СвОЭДОтпр)
Function SvOEDOtpr(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'НаимОрг', oEDO.OperatorName); // Наименование
  AttribRequired(result, 'ИННЮЛ'  , oEDO.OperatorUNN);  // ИНН
  AttribRequired(result, 'ИдЭДО'  , oEDO.OperatorID);   // Идентификатор оператора электронного документооборота отправителя информации продавца
}

//--- ЭЦПАнФайл
Function ECPAnFile(_Node: comp; _NodeName: string; _filename:string): comp;
var MemArrayZ: TMemoStrArray; // массив строк
    MemArrayZ2: TMemoStrArray; // массив строк
{ Result:=0;
  //EXIT;// Пока не ясно! Не читается!
  if EDO_SIGN_ANUL<>1   exit;
  if _filename<>''
  {   MyLog('SOPR DP_PRANNU->ECPAnFile _filename='+_filename);
      if not FileExist(_filename) exit;
      //result := AddNode(_Node, _NodeName,_ECP);
      var indx,indx2: word=0;
      indx:=indx2 := 0;
      MyLog('SOPR DP_PRANNU->ECPAnFile 001');
      
      if not MemoFile.OpenFile(_filename,stOpenRead) exit;
      MyLog('SOPR DP_PRANNU->ECPAnFile 002');
      while (not MemoFile.EOF)
      {
        if indx<100
        { indx++;
          MemArrayZ[indx]:='';
          MemoFile.Readln(MemArrayZ[indx]);
        }
        else
        { if indx2>=100 break;
          indx2++;
          MemArrayZ2[indx2]:='';
          MemoFile.Readln(MemArrayZ2[indx2]);
        }  
      }

      MemoFile.Close;
      MyLog('SOPR DP_PRANNU->ECPAnFile indx='+string(indx)+'/'+string(indx2));

      if (indx <> 0)
      {
        //AttribOptional(result, 'ТекстИнф', 'MemoStrArray' + String(iMemoStrArrayZ)); // Текстовая информация
        //oXMLConverter.AddAttrMem(result, 'ТекстИнф', 'MemoStrArray' + String(iMemoStrArrayZ), MemArrayZ, indx);
        iMemoStrArray2++;
//  oXMLConverter.AddNode(result, 'ЗагСодОпер', 'MemoStrArray' + String(iMemoStrArray), 0);
//  oXMLConverter.AddNodeMem(result, 'ЗагСодОпер', 'MemoStrArray' + String(iMemoStrArray), MemArray, 5, 0);
        oXMLConverter.AddNode   (_Node,_NodeName, 'MemoStrArray' + String(iMemoStrArray2), 0);
        MyLog('SOPR DP_PRANNU->ECPAnFile AddNode ');
        oXMLConverter.AddNodeMem(_Node,_NodeName, 'MemoStrArray' + String(iMemoStrArray2), MemArrayZ, indx,0);
        MyLog('SOPR DP_PRANNU->ECPAnFile AddNodeMem ');
        iMemoStrArray2++;
        if (indx2 <> 0)
        { oXMLConverter.AddNodeMem(_Node,_NodeName, 'MemoStrArray' + String(iMemoStrArray2), MemArrayZ2, indx2,1);
          MyLog('SOPR DP_PRANNU->ECPAnFile AddNodeMem2 ');
        }
      }
      MyLog('SOPR DP_PRANNU->ECPAnFile --- Finish');
  }
} //Function ECPAnFile(_Node: comp; _NodeName: string; _filename:string): comp;

//----- 'СведАнФайл'
Function SvPredAnFile(_Node: comp; _NodeName: string): comp;
{ result := AddNode(_Node, _NodeName);
  AttribRequired(result,'ИмяАнФайла','Исх. УПД № '+tmpKatSopr.NSopr+DateToStr(TmpKatsopr.DSopr,' от DD.MM.YYYY  для ')+TmpKatOrg.Name);  // ="Исх. УПД № 055030 от 13.06.2017 для ООО _Хилдинг Андерс РУС_">
  MyLog('SOPR DP_PRANNU->SvPredAnFile:FileName_Sign='+FileName_Sign);
  if FileName_Sign<>''
  { ECPAnFile(result,'ЭЦПАнФайл',FileName_Sign)
  }
  //ECPAnFile(result,'ЭЦПАнФайл','')

} //Function SvPredAnFile(_Node: comp; _NodeName: string): comp;

//ТекстПредАн
Function TekstPreDAn(_Node: comp; _NodeName: string): comp;
var sComment:string='';
{ sComment:=sGetAttr(coKatSopr,TmpKatSopr.cKatSopr,'ЭДО. Аннулирование') ;
  if sComment<>''
    result := AddNode(_Node, _NodeName,sComment);
}

//----- СвПредАн
Function SvPredAn(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);
  SvPredAnFile(Result,'СведАнФайл' );
  TekstPreDAn (Result,'ТекстПредАн');

}
//------------------------------------------------------------------------------
// 5.4 Документ (Документ)
Function Document(_Node: comp; _NodeName: string; _IdPok: string): comp;
{
  result := AddNode(_Node, _NodeName);
    
  MyLog('SOPR DP_PRANNU->Document _NodeName '+_NodeName);


  KolNpp := 0;
  cMyOrg := coGetTune('MyOrg');

  //AttribRequired(result, 'КНД', sKND);                 // Код документа по КНД
  /*
  AttribRequired(result, 'ДатаИнфПр', sDateFirst);     // Дата формирования документа о передаче товара, информация продавца

  case sKND of
    
    '1175010': // Документ о передаче товара, титул продавца
    {
      AttribRequired(result, 'ВремИнфПр', sTimeFirst); // Время формирования документа о передаче товара, информация продавца

    }

    '1175011': // Документ о передаче товара, титул покупателя
    {
      AttribRequired(result, 'ВремИнфПок', CurTime);   // Время формирования документа о передаче товара, информация продавца
    }
  end;
  */
  //кому
  var cPokup : comp = if (TmpKatSopr.cOrgBase <> comp(0), TmpKatSopr.cOrgBase, TmpKatSopr.cOrg);
  if (GetFirst TmpKatOrg where ((if(wDirect=1,cPokup,cMyOrg) == TmpKatOrg.cKatOrg)) = tsOk) {}
  SvUchDocObor(Result,'УчастЭДО', _IdPok);
  SvPredAn(Result,'СвПредАн');
  //от кого
  if (GetFirst TmpKatOrg where ((if(wDirect<>1,cPokup,cMyOrg) == TmpKatOrg.cKatOrg)) = tsOk)
  SvUchDocObor(Result,'НапрПредАн', oEDO.MyOrgID);
  //--- для вывода доп.полей
  InfPolFHJ4(Result,'ИнфПолФХЖ1');  
  //AttribRequired(result, 'НаимЭконСубСост', oHistory.sGetField(coKatOrg, cMyOrg, 'REP.KATORGNAME', TmpKatSopr.dSopr));
                                                       // Наименование экономического субъекта - составителя информации продавца (в т.ч. комиссионера/агента)
  //AttribOptional(result, 'ОснДоверОргСост', '');       // Основание, по которому экономический субъект является составителем информации продавца

  _loop TmpSigners
    if (TmpSigners.IsBoss OR TmpSigners.IsBuh OR TmpSigners.IsEPodpisant) // Сведения о лице, подписавшем информацию продавца в электронном виде
      PodpisantUpd(result, 'Подписант', 0);
}



//------------------------------------------------------------------------------
//------------------------------------------------------------------------------
// 5.8 Дата и номер документа (ИдентДок)
Function IdentDok(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribOptional(result, 'НомДокПТ', TmpKatSopr.nSopr); // Номер документа о передаче товара
  AttribRequired(result, 'ДатаДокПТ', sDateFirst);      // Дата составления документа о передаче товара
}

//------------------------------------------------------------------------------
// 5.9 Исправление (ИспрДокПТ)
Function IsprDokPT(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'НомИспрДокПТ', '');  // Исправление: N
  AttribRequired(result, 'ДатаИспрДокПТ', ''); // Исправление: Дата
}


//------------------------------------------------------------------------------
// 5.12 Основание (Основание)
Function Osnovanie(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);
#IFDEF _GP_
  if wDirect=1 and TmpKatSopr.NameDO[1]='' 
  { AttribRequired(result, 'НаимОсн', 'Накладная');                                        // Наименование документа-основания
    AttribOptional(result, 'НомОсн', if (TmpKatSopr.NSopr = '-', '', TmpKatSopr.NSopr));     // Номер документа-основания
    AttribOptional(result, 'ДатаОсн', if (TmpKatSopr.Dsopr = 0, '', Dat(TmpKatSopr.dDocDO[1]))); // Дата документа-основания
  }  
  else
  { AttribRequired(result, 'НаимОсн', TmpKatSopr.NameDO[1]);                                        // Наименование документа-основания
    AttribOptional(result, 'НомОсн', if (TmpKatSopr.NoDocDO[1] = '-', '', TmpKatSopr.NoDocDO[1]));     // Номер документа-основания
    AttribOptional(result, 'ДатаОсн', if (TmpKatSopr.NameDO[1] = '-', '', Dat(TmpKatSopr.dDocDO[1]))); // Дата документа-основания
  }  
#ELSE
  AttribRequired(result, 'НаимОсн', TmpKatSopr.NameDO[1]);                                        // Наименование документа-основания
  AttribOptional(result, 'НомОсн', if (TmpKatSopr.NoDocDO[1] = '-', '', TmpKatSopr.NoDocDO[1]));     // Номер документа-основания
  AttribRequired(result, 'ДатаОсн', if (TmpKatSopr.NameDO[1] = '-', '', Dat(TmpKatSopr.dDocDO[1]))); // Дата документа-основания
#ENDIF  
  AttribOptional(result, 'ДопСвОсн', '');                                                      // Дополнительные сведения
}


//------------------------------------------------------------------------------
// 5.18 Работник организации продавца (РабОргПрод)
Function RabOrgProd(_Node: comp; _NodeName, _sFIO, _sPost, _sDover: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'Должность', _sPost);                // Должность
  AttribOptional(result, 'ИныеСвед', '');                     // Иные сведения, идентифицирующие физическое лицо
  AttribOptional(result, 'ОснПолн', _sDover);                 // Основанние полномочий (доверия)

  FIOTip(_Node, 'ФИО', TmpSigners.FIO);                       // Фамилия, имя, отчество
}

//------------------------------------------------------------------------------
// 5.19 Иное лицо (ИнЛицо)
Function InLico(_Node: comp; _NodeName, _sFIO, _sPost, _sDover: string): comp;
{
  result := AddNode(_Node, _NodeName);

  if (sKND = '1175010')
  {
    if (TmpKatOrg.wType = 0)
      PredOrgPer(result, 'ПредОргПер', _sFIO, _sPost, _sDover); // Представитель организации, которой доверена отгрузка товаров (передача результатов работ), передача имущественных прав (предъявление оказанных услуг)
    else
      FLPer(result, 'ФЛ', _sFIO, _sDover);                      // Физическое лицо, которому доверена отгрузка товаров (передача результатов работ), передача имущественных прав (предъявление оказанных услуг)
  }
  else
  {
    if (TmpKatOrg.wType = 0)
      PredOrgPol(result, 'ПредОргПол', _sFIO, _sPost, _sDover);
    else
      FLPol(result, 'ФЛ', _sFIO, _sDover);
  }
}

//------------------------------------------------------------------------------
// 5.20 Представитель организации, которойй доверена передача товара (ПредОргПер)
Function PredOrgPer(_Node: comp; _NodeName, _sFIO, _sPost, _sDover: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'Должность', _sPost);          // Должность
  AttribOptional(result, 'ИныеСвед', '');               // Иные сведения, идентифицирующие физическое лицо
  AttribRequired(result, 'НаимОргПер', TmpKatOrg.Name); // Наименование организации
  AttribOptional(result, 'ОснДоверОргПер', '');         // Основание, по которому организации доверена передача товара (груза)
  AttribOptional(result, 'ОснПолнПредПер', _sDover);    // Основание полномочий представителя организации на передачу

  FIOTip(result, 'ФИО', _sFIO);                         // Фамилия, имя, отчество
}

//------------------------------------------------------------------------------
// 5.21 Физическое лицо, которому доверена передача товара (груза) (ФЛ)
Function FLPer(_Node: comp; _NodeName, _sFIO, _sDover: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribOptional(result, 'ОснДоверФЛПер', _sDover); // Основание, по которому физическому лицу доверена передача товара (груза)
  AttribOptional(result, 'ИныеСвед', '');           // Иные сведения, идентифицирующие физическое лицо
   
  FIOTip(result, 'ФИО', _sFIO);                     // Фамилия, имя, отчество
}


//------------------------------------------------------------------------------
// 5.23 Сведения о лице, подписавшем информацию продавца в электронном виде (Подписант)
Function PodpisantUpd(_Node: comp; _NodeName: string; _Param: word): comp;
{
  result := AddNode(_Node, _NodeName);
  AttribOptional(result, 'Должность', TmpSigners.Post);           // Иные сведения, идентифицирующие физическое лицо
  FIOTip(result, 'ФИО', TmpSigners.FIO);                     // Фамилия, имя, отчество

}

//------------------------------------------------------------------------------
// 5.24 Представитель юридического лица (ЮЛ)
Function ULUpd(_Node: comp; _NodeName: string; _Param: word): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'ИННЮЛ', TmpKatOrg.UNN);    // ИНН организации
  AttribRequired(result, 'НаимОрг', TmpKatOrg.Name); // Наименование
  AttribRequired(result, 'Должн', TmpSigners.Post);  // Должность
  AttribOptional(result, 'ИныеСвед', '');            // Иные сведения, идентифицирующие физическое лицо
 
  FIOTip(result, 'ФИО', TmpSigners.FIO);             // Фамилия, имя, отчество
}



//------------------------------------------------------------------------------
// 5.28 Текстовая информация (ТекстИнфТип)
Function TekstInfTip(_Node: comp; _NodeName: string): comp;
{
#IFDEF _GP_
  Result:=TextInfTip_GP(_Node, _NodeName);
#ELSE  
  result := AddNode(_Node, _NodeName);
  AttribRequired(result, 'Идентиф', ''); // Идентификатор
  AttribRequired(result, 'Значен', '');  // Значение
#ENDIF  
}

//------------------------------------------------------------------------------
// 5.29 Контактные данные (КонтактТип)
Function KontaktTip(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribOptional(result, 'Тлф', if (TmpKatOrg.Tel <> '', TmpKatOrg.Tel, TmpKatOrg.Fax)); // Номер контактного телефона/факс
  AttribOptional(result, 'ЭлПочта', TmpKatOrg.Email);                                    // Адрес электронной почты
}


//------------------------------------------------------------------------------
// 5.31 Сведеения об индивидуальном предпринимателе (СвИПТип)
Function SvIPTip(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'ИННФЛ', TmpKatOrg.UNN); // ИНН
  AttribOptional(result, 'СвГосРегИП', '');       // Реквизиты свидетельства о государственной регистрации индивидуального предпринимателя
  AttribOptional(result, 'ИныеСвед', '');         // Иные сведения, идентифицирующие физическое лицо
          
  FIOTip(result, 'ФИО', TmpKatOrg.Name1);         // Фамилия, имя, отчество
}

//------------------------------------------------------------------------------
// 5.32 Сведения о физическом лице (СвФлТип)
Function SvFLTip(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribOptional(result, 'ИННФЛ', TmpKatOrg.UNN); // ИНН
  AttribOptional(result, 'ИныеСвед', '');         // Иные сведения, идентифицирующие физическое лицо
  
  FIOTip(result, 'ФИО', TmpKatOrg.Name1);         // Фамилия, имя, отчество
}


//------------------------------------------------------------------------------
// 5.34 Идентификационные сведения (ИдСв)
Function IdSv(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  if (TmpKatOrg.wType = 1)
  {
    SvFLTip(result, 'СвФЛ');         // Сведения о физическом лице
  }
  else
  {
    if (length(TmpKAtOrg.UNN) = 12) // Исходим из предположения, что у предпринимателя ИНН 12-значный
      SvIPTip(result, 'СвИП');      // Сведения об индивидуальном предпринимателе
    else
      SvOrg(result, 'СвОрг');       // Сведения об организации
  }

}              

//------------------------------------------------------------------------------
// 5.35 Сведения об организации (СвОрг)
Function SvOrg(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  case TmpKatOrg.State of
    '1': SvUL(result, 'ЮЛ');   // Сведения о российской организации
    '2': InOrg(result, 'ИнОрг'); // Сведения об иностранной организации
  end;
}

//------------------------------------------------------------------------------
// 5.36 Сведения о российской организации (СвЮЛ);
Function SvUL(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'НаимОрг', TmpKatOrg.Name); // Наименование полное
  AttribRequired(result, 'ИННЮЛ', TmpKatOrg.UNN);    // ИНН
  AttribOptional(result, 'КПП', TmpKatOrg.KPP);      // КПП
}

//------------------------------------------------------------------------------
// 5.37 Сведения об иностранной организации (ИнОрг)
Function InOrg(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'НаимОрг', TmpKatOrg.Name);   // Наименование полное
  AttribRequired(result, 'Страна', TmpKatOrg.Country); // Страна
  AttribOptional(result, 'ИныеСвед','');               // Иные сведения, идентифицирующие юридическое лицо
}



//------------------------------------------------------------------------------
// 7.9 Работник организации покупателя (РабОргПок)
Function RabOrgPok(_Node: comp; _NodeName, _sFIO, _sPost, _sDover: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'Должность', _sPost); // Должность
  AttribOptional(result, 'ИныеСвед', '');      // Иные сведения, идентифицирующие физическое лицо
  AttribOptional(result, 'ОснПолн', _sDover);  // Основание полномочий (доверия)

  FIOTip(result, 'ФИО', _sFIO);                // Фамилия, имя, отчество
}

//------------------------------------------------------------------------------
// 7.11 Представитель организации, которой доверено получение товара (груза) (ПредОргПол)
Function PredOrgPol(_Node: comp; _NodeName, _sFIO, _sPost, _sDover: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribRequired(result, 'Должность', _sPost);          // Должность
  AttribOptional(result, 'ИныеСвед', '');               // Иные сведения, идентифицирующие физическое лицо
  AttribRequired(result, 'НаимОргПол', TmpKatOrg.Name); // Наименование организации
  AttribOptional(result, 'ОснДоверОргПол', '');         // Основание, по которому организации доверено получение товара (груза)
  AttribOptional(result, 'ОснПолнПредПол', _sDover);    // Основание полномочий представителя организации на получение товара (груза)

  FIOTip(result, 'ФИО', _sFIO);                         // Фамилия, имя, отчество
}

//------------------------------------------------------------------------------
// 7.12 Физическое лицо, которому доверено получение товара (груза) (ФЛ)
Function FLPol(_Node: comp; _NodeName, _sFIO, _sDover: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribOptional(result, 'ОснДоверФД', _sDover); // Идентификатор файла информационного поля
  AttribOptional(result, 'ИныеСвед', '');        // Иные сведения, идентифицирующие физическое лицо

  FIOTip(result, 'ФИО', _sFIO);
}

//------------------------------------------------------------------------------
Function InfPolFHJ4(_Node: comp; _NodeName: string): comp;
{
  result := AddNode(_Node, _NodeName);

  AttribOptional(result, 'ИдФайлИнфПол', sGUID); // Идентификатор файла информамционного поля

  //if false
  //  TekstInfTip(result, 'ТекстИнф');
  Result:=TextInfTip_GP(result, 'ТекстИнф');
}

//-----------------------------------------------------------------------


Function ExportToXML: boolean;
var sFileName, sFullFileName, sIDOrgEDO: string;
{

  sIDOrgEDO := oEDO.GetIDOrgEDO(TmpKatSopr.cOrg);
#IFDEF _GP_
  sFileName := GetNameFileExport_GP(sIDOrgEDO,'ЭДО. Аннулирование GUID');
  MyLog('SOPR DP_PRANNU->ExportToXML: 001 '+sFileName);
#ELSE  
  sFileName := GetNameFileExport(sIDOrgEDO);
#ENDIF
  if (sKND = '1175010')
  {
    sFileFirst := sFileName;
    sDateFirst := Dat(Cur_Date);
    sTimeFirst := CurTime;
  }

#IFDEF _GP_
  sFullFileName := oEDO.OutDir +if(SubStr(oEDO.OutDir,length(oEDO.OutDir),1)<>'\','\','') + sFileName +'.'+GetExtentionEDO;
  SaveMyDSK(sFullFileName,'ON_DPSOPR_Filename_1');
  if FileExist(sFullFileName) DeleteFile(sFullFileName);
  MyLog('SOPR DP_PRANNU->ExportToXML: 002 ') ;

#ELSE  
  sFullFileName := oEDO.OutDir + '\' + sFileName +'.xml';
#ENDIF

  result := FileCreate(sFullFileName);

  if not result
    exit;
//------------
  FileName_Sign:='';
  // пробуем сформировать файл с подписью
  EDO_SIGN_ANUL:=0;
  if ExistTune('GALCOMMON.DIRECTUM.EDO_SIGN_ANUL')
    EDO_SIGN_ANUL:=wGetTune('GALCOMMON.DIRECTUM.EDO_SIGN_ANUL');
  if EDO_SIGN_ANUL=1
  { boInit_oSign:=oSign.Init_Chk;
    if boInit_oSign
    { MyLog('SOPR DP_PRANNU->SvPredAnFile boInit_oSign ');

      if oSign.IsSetCertificate
      {  MyLog('SOPR DP_PRANNU->ExportToXML IsSetCertificate ');
         //  Function SignCreate2TmpFile(var fileName: string; isCoSign: boolean = false; isVerify: boolean = false): boolean;
         if oSign.SignCreate2TmpFile(FileName_Sign, false,false,coKatSopr,tmpKatSopr.cKatSopr)
         { MyLog('SOPR DP_PRANNU->ExportToXML SignCreate2TmpFile ') ;
           MyLog('SOPR DP_PRANNU->ExportToXML FileName_Sign='+FileName_Sign) ;
           //ECPAnFile(result,'ЭЦПАнФайл',TmpFile) ;
         }
      }
    }
  }//if EDO_SIGN_ANUL=1  

  oXMLConverter.Init;
  TheFile(sFileName, sIDOrgEDO);
#IFDEF _GP_
  MyLog('SOPR DP_PRANNU->ExportToXML: 003='+sFullFileName);

  if ( (wParam_Main and (cg_ExpSfSingEDO)) != 0 )
  { //if wGetTune('GALCOMMON.DIRECTUM.EDO_SIGN_FILE')=1 //ЭЦП. Кодировка файла с ЭЦП - win1251
    //or EDO_SIGN_ANUL<>0
    if true
    { oXMLConverter.SaveTxmlTablesWithTabs(sFullFileName)
    }
    else
    {  oXMLConverter.SaveTxmlTablesEncodingWithTabs(sFullFileName, 'UTF-8')
    }
  }  
  else  
  { oXMLConverter.SaveTxmlTablesWithTabs(sFullFileName)
  }
#ELSE
  oXMLConverter.SaveTxmlTables(sFullFileName);
#ENDIF  
}

Procedure SetRoundFormat;
var
  ii, bRoundGrM: byte;
{
  bRoundGrM := bGetTune('Doc.SD.PrnNakl.GrmRound');
  wRoundGrM := integer(wGetTune('Doc.SD.PrnNakl.GrmRound'));
  sRoundGrM := '[|-]3666666666666666';

  For (ii := 1; ii <= bRoundGrM; ii++)
    sRoundGrM += if (ii = 1, '.8', '8');

  sRoundGrM := '\' + string(bRoundGrM) + 'p' + sRoundGrM;

  if (bRoundGrM <> 0)
    sRound := '\f4 целых 5'
  else
    sRound := '4';
}

Function oExport_base.FileNamePrefix: string;
{
// Другое имя DPAD не берет
  result := 'DP_PRANNUL_'; // Товарная накладная, титул продавца

//  case sKND of
//    '1175010': result := 'DP_PRANNUL_'; // Товарная накладная, титул продавца
//    '1175011': result := 'DP_CANCELPOK_'; // Товарная накладная, титул покупателя
//  end;
}

Function oExport_base.Export(_cRec: comp; _oEDO: TuneEDO; wParam: word = 0): boolean;
{
#IFDEF _GP_
  wParam_Main:=wParam;
  wDirect:=if((wParam_Main and 16384)>0,1,0);
  wParam:=(wParam and 1) ;
#ENDIF  
  MyLog('SOPR DP_PRANNU->Export:_cRec='+string(_cRec)+', wParam='+string(wParam))  ;
  result := inherited::Export(_cRec, _oEDO);
  MyLog('SOPR DP_PRANNU->Export: 001 '+string(Result));

  if not result
    exit;
  MyLog('SOPR DP_PRANNU->Export: 002'+string(Result)) ;

  SetRoundFormat;

  // 1175010 - Товарная накладная, титул продавца
  sKND := '1175010';

  result := ExportToXML;
  MyLog('SOPR DP_PRANNU->Export: 003 '+string(Result));

  if not result
    exit;

  if  FALSE // Второй файл не нужен! (wParam = 0)
  {
    // 1175011 - Товарная накладная, титул покупателя
    sKND := '1175011';
    result := ExportToXML;
  }
}

//Function oExport_base.ExportToObj(_sFileFirst, _sDateFirst, _sTimeFirst, _sFileName, _sKND, _IdOrg: string;  _cRec : comp; _oEDO: TuneEDO; var _oXMLConverter : XMLConverter): boolean;
  Function oExport_base.ExportToObj(_sFileFirst, _sDateFirst, _sTimeFirst, _sFileName, _sKND, _IdOrg: string;  _cRec : comp; _oEDO: TuneEDO; var _oXMLConverter : XMLConverter; wParam : word = 0): boolean;
{
  result := inherited::Export(_cRec, _oEDO);

  if not result
    exit;

  sKND          := _sKND;
  sFileFirst    := _sFileFirst;
  oXMLConverter := _oXMLConverter;

  if (sKND = '1175010')
  {
    sDateFirst := Dat(Cur_Date);
    sTimeFirst := CurTime;
  }
  else
  {
    sDateFirst    := _sDateFirst;
    sTimeFirst    := _sTimeFirst;
  }

  result := FileCreate(oEDO.OutDir + '\' + _sFileName +'.xml');

  if not result
    exit;

  result := (TheFile(_sFileName, _IdOrg) <> 0);

  _oXMLConverter := oXMLConverter;
}

End.
