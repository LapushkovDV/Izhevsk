#include GP_UserFilterString.vih

#component "GP_Common"

#include GP_UserFilterStringEditView.vih
interface GP_UserFilterStringEditView;

var
  _userFilter: GP_UserFilterString noauto;
  _caption: string;

create view;

screen scUserFilter;
fields
  _caption: skip;
  _userFilter.Match: [List 'Точное совпадение', 'Содержит'];
  _userFilter.FilterString: noprotect;
<<
.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 .@@@@@@@@@@@@@@@@@@@@ `Строка`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

handleevent
  cmDefault: OnCmDefault;
end;

constructor Init;
{
  result := false;
}


constructor UserFilterStringEditView(aUserFilter: GP_UserFilterString; aCaption: string = '');
{
  _userFilter := aUserFilter;
  Caption     := aCaption;
  result      := _userFilter != nullref;
}

property UserFilter: GP_UserFilterString read _userFilter;
property Caption: string absolute _caption;

end.
