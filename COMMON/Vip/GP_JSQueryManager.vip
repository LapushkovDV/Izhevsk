#include Query.vih
#include GP_JSQuery.vih
#include GP_Collections.vih

#component "GP_Common"

interface GP_JSQueryManager;

var
  _queries: GP_IDictionary(GP_Dictionary) new;

function CreateJSQuery(key: variant; sqlStr: variant): GP_IJSQuery;
{
  var q: GP_IJSQuery = GP_IJSQuery(new(GP_JSQuery, Create(sqlStr)));
  if q != NullRef
    _queries.AddKeyValue(key, q);
  result := q;
}

function GetJSQuery(key: variant): GP_IJSQuery;
{
  result := GP_IJSQuery(_queries.ValueGet(key));
}

function RemoveJSQuery(key: variant): boolean;
{
  result := _queries.RemoveItemWithKey(key);
}

end.
