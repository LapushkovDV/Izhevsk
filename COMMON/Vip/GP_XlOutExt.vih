#ifndef __GP_XlOutExt_vih__
#define __GP_XlOutExt_vih__

#component "GP_Common"

objInterface GP_XlOutExt_Obj;

//Установка ландшафтной ориентации и сквозных строк (шапочки на каждой странице) для текущего листа.
procedure TitleEachPage(iBeg, iEnd : integer; sReport : string);

//Установка сквозных строк (шапочки на каждой странице) для текущего листа.
procedure xlTitleEachPageO(iBeg, iEnd : integer);

//Установка ландшафтной ориентации и масштаба по ширине iFitToPagesWide в листах для текущего листа.
procedure xlPageScaleLandscape(iFitToPagesWide : integer);

//Включение/выключение режима R1C1
//для генерации Excel формул в формате R1C1
//Соответственно включить параметрм true
//занести значения формул в формате R1C1
//выключить параметром false
procedure xlR1C1OnOff(isOnOff : boolean);

procedure xlSummaryRowAbove;
procedure xlSetSummaryRow(iRowB, iRowE, iNPP : integer);


//Текст в ячейках вертикально
procedure xlRangeVert4C(lRow, lPage : longint );
procedure xlRangeVert(sCol : string; lRow, lPage : longint );

procedure xlHideCol(sCol : string);


//Вывод поля шапочки занимающей соответственно 1-4 строчки
procedure Header1Row(sString : string; liRB,liCB,liRE,liCE        : longint);
procedure Header1RowT(sString : string; liRB,liCB,liRE,liCE : longint);
procedure Header1RowB(sString : string; liRB,liCB,liRE,liCE : longint);
procedure Header2Row(sString : string; liRB,liCB,liRE,liCE        : longint);
procedure Header3Row(sString : string; liRB,liCB,liRE,liCE        : longint);
procedure Header4Row(sString : string; liRB,liCB,liRE,liCE        : longint);
procedure Header5Row(sString : string; liRB,liCB,liRE,liCE : longint);
//Вывод общей крышки столбцов в шапочке на указанное число столбцов занимающей соответственно 1-3 строчки
procedure HeaderIns (sString : string; liRB,liCB,liRE,liCE,liSize : longint);
procedure HeaderIns2(sString : string; liRB,liCB,liRE,liCE,liSize : longint);
procedure HeaderIns3(sString : string; liRB,liCB,liRE,liCE,liSize : longint);
procedure HeaderIns4(sString : string; liRB,liCB,liRE,liCE,liSize : longint);
procedure HeaderIns5(sString : string; liRB,liCB,liRE,liCE,liSize : longint);
procedure HeaderInsL(sString : string; liRB,liCB,liRE,liCE,liSize : longint);

//Вывод строкового значения с центрированием лево-центр-право
procedure StringValL(sString : string; liRB,liCB,liRE,liCE : longint);
procedure StringValC(sString : string; liRB,liCB,liRE,liCE : longint);
procedure StringValR(sString : string; liRB,liCB,liRE,liCE : longint);

//Вывод даты с подавлением пустого значения (право)
procedure DateVal(dDate : date; liRB,liCB,liRE,liCE : longint);

//Вывод значения типа "код" с подавлением автоматического преобразования в число Excel-ом (центр)
procedure CodeVal(sCode : string; liRB,liCB,liRE,liCE : longint);
procedure CodeValB(sCode : string; liRB,liCB,liRE,liCE : longint);
procedure CodeValL(sCode : string; liRB,liCB,liRE,liCE : longint);
//Вывод вещественного числа в формате '### ### ### ##0, 00' (право)
procedure DoubleVal(dbDouble : double; liRB,liCB,liRE,liCE : longint);
//Вывод целочисленного числа в формате '### ### ### ##0' (право)
procedure IntegerVal(iInt : integer; liRB,liCB,liRE,liCE : longint);
procedure IntegerValCM(iInt : integer; liRB,liCB,liRE,liCE : longint);

//Вывод формулы с результатом в виде вещественного числа в формате '### ### ### ##0, 00' (право)
procedure FormulaDoubleVal(sString : string; liRB,liCB,liRE,liCE : longint);
procedure FormulaDoubleValC(sString : string; liRB,liCB,liRE,liCE : longint);
//Вывод формулы с результатом в виде целого числа в формате '### ### ### ##0' (право)
procedure FormulaIntegerVal(sString : string; liRB,liCB,liRE,liCE : longint);
procedure FormulaIntegerValC(sString : string; liRB,liCB,liRE,liCE : longint);
procedure FormulaPctVal(sString : string; liRB,liCB,liRE,liCE : longint);


Function OutputFilesDirectory : String;
//========================================
//Инициализация Excel sub_path='#_MYXLSPATH_'
//========================================
Function ExcelInit(sub_path:string; wnmfile:string ; fromtemplate :boolean ) : word ;

end;

vipInterface GP_XlOutExt Implements GP_XlOutExt_Obj;
#endif
