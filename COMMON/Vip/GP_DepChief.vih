#IFNDEF __GP_DEPCHIEF_VIH__
#DEFINE __GP_DEPCHIEF_VIH__

#component "GP_Common"

const
  // режимы сравнения названия должности
  CM_EXACT = 0; // точно совпадает
  CM_START_WITH = 1; // начинается с
end;

objInterface GP_ObjDepChief;

  // Ищет работника, который являлся начальником указанного подразделения на указанную дату
  //  cDep - NRec подразделения (Catalogs)
  //  OnDate - дата, на которую выполняется расчет
  //  cPositon - возвращаемый, должность найденного начальника
  // Возвращаемое значение: ссылка на карточку работника (Persons)
  function GetDepChief(cDep: tNRec; OnDate: Date; var cPositon: Comp): tNRec;

  // Ищет работника, который являлся начальником указанного работника на указанную дату
  //  cPersons - NRec карточки работника (Persons)
  //  OnDate - дата, на которую выполняется расчет
  //  cChiefPos - возвращаемый, ссылка на должность найденного начальника
  //  cChiefDep - возвращаемый, ссылка на подразделение найденного начальника
  // Возвращаемое значение: ссылка на карточку работника (Persons)
  function GetPersChief(cPersons: tNRec; OnDate: Date; var cChiefPos: Comp; var cChiefDep: Comp): tNRec;

  // Возращает NRec подразделения, в котором числился работник на указанную дату
  //  cPersons - NRec карточки работника (Persons)
  //  OnDate - дата, на которую выполняется расчет
  // Возвращаемое значение: ссылка на подразделения (Catalogs)
  function GetPersDep(cPersons: tNRec; OnDate: Date): tNRec;

  // Возращает NRec подразделения с трехзначным кодом, в котором числился работник на указанную дату
  //  cPersons - NRec карточки работника (Persons)
  //  OnDate - дата, на которую выполняется расчет
  // Возвращаемое значение: ссылка на подразделения (Catalogs)
  function GetPersTopDep(cPersons: tNRec; OnDate: Date): tNRec;

  // Добавляет должность в перечень должностей руководителей
  //  _PosName - название должности
  //  _CompMode - режим сравнения:
  //   CM_EXACT = 0; // точно совпадает
  //   CM_START_WITH = 1; // начинается с
  // Возвращает true, если операция завершилась успешно
  function AddChiefPosition(_PosName: String; _CompMode: Byte = CM_EXACT): Boolean;
end;

vipInterface GP_DepChief Implements GP_ObjDepChief;
#endif
