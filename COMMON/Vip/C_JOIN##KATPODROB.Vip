#include MacOb.vpp //макросы (для таблиц, не содержащих кау, и общие)
#define UseGetMarkerMy

#component "C_JOIN"
#doc
Модуль настройка - Администратор - Объединение данных - Объединение складов.
базовый файл CompSrc\C\C_Join\vip\OBEDPODR.VIP
#end
Alter Interface KATPODROB
OverLoad
  Function AmalgamatePlan( wType: Word; aOne, aTwo, cOtpEdNRec: Comp ): Boolean;
  Function updateObj : boolean;
end;
Create View as select GP_SCUD_DOC.Nrec
From
  GP_KPI_Doc
 ,GP_KPI_Doc_SP
 ,GP_SCUD_Podr
 ,GP_SCUD_Pers
 ,GP_SCUD_Pers_Hist
 ,GP_SCUD_DOC
 ,GP_USERRIGHTS
// ,GP_SCUD_Events
// ,GP_TimeTable
// ,GP_KPI_Doc_Z
// ,GP_KPI_Excl_Kat_D
// ,GP_EMAIL
// ,GP_RaspAvans
// ,GP_PlannedReceipts
;
#DECLARE UpdateTableOneFieldNoIndexSQL (Tabl,Field,TablString)
 _Try
 { SQL Update #(Tabl) set #(Tabl).#(Field) =:(JoiHead.cRec)
   where #(Tabl).#(Field) =:(SpJoi.cRec);
 }
 _Except
 else
 { timelog('Возникло исключение при запуске запроса #(Tabl).#(Field) '+ExploreException);
 }
#END
//
