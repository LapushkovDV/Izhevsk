#include GP_JSQuery.vih

#component "GP_Common"

#declare QueryParamIfc(IfcName,Type)

interface #IfcName;

var
  _value: #Type;

procedure SetParamValue(value: variant);
{
  _value := value;
}

procedure SetQueryParamValue(query: IQuery; paramName: string);
{
  query.setParam(paramName, _value);
}

end.

#end

#QueryParamIfc(GP_QueryStringParamSetter,string)
#QueryParamIfc(GP_QueryCompParamSetter,comp)
#QueryParamIfc(GP_QueryWordParamSetter,word)
#QueryParamIfc(GP_QueryDoubleParamSetter,double)

interface GP_QueryDateParamSetter;

var
  _value: date;

procedure SetParamValue(value: variant);
{
  _value := StrToDate(value, 'DD/MM/YYYY');
}

procedure SetQueryParamValue(query: IQuery; paramName: string);
{
  query.setParam(paramName, _value);
}

end.


interface GP_QueryBoolParamSetter;

var
  _value: boolean;

procedure SetParamValue(value: variant);
{
  _value := boolean(value);
}

procedure SetQueryParamValue(query: IQuery; paramName: string);
{
  query.setParam(paramName, _value);
}

end.
