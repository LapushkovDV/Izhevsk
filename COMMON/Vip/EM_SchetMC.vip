//************************************************
#include EM_SchetMC.vih

Interface EM_SchetMC;
 create view
 ;

Function GetSchetBuhFromParty_str(_cParty: comp) : string;
{
  var _result : string = '';
 _Try
  { SQL Select
       BSch.code as Schet
      From
      (
       Select
         coalesce(AvKP.vComp,#comp(0)) as cBuhSchet
        from KatParty Kp
        left join attrnam AnKp on AnKp.wtable = 1430
                         and AnKp.Name = '.‘η¥β –'
        left join AttrVal AvKP on AvKP.wTable = AnKp.wtable
                         and AvKP.cAttrNam = AnKp.nrec
                         and AvKP.cRec = KP.Nrec
        where Kp.Nrec = :(_cParty)
      ) Schet
      left join BuhSchet BSch on BSch.nrec = Schet.cBuhSchet
     into (_result)
     ;
  }
  _except else {}
 result := _result
}
Function GetSchetBuhFromKatMC_str(_cMC: comp) : string;
{
  var _result : string = '';
  _try
     {  sql
        select
         BSch.code as Schet
        From
        (
            select
               coalesce(AvMC.vComp,AvGrMc.vComp,#comp(0)) as cBuhSchet
             from katmc Mc
              left join attrnam ANMC on AnMc.wtable = 1411
                               and AnMc.Name = '.€­ «¨β¨ª  γε‘η¥β '
              left join AttrVal AvMc on AvMc.wTable = AnMc.wtable
                               and AvMc.cAttrNam = AnMc.nrec
                               and AvMc.cRec = Mc.Nrec
              Left Join groupMC grMc on GrMc.Nrec = Mc.cGroupMc
              left join attrnam AnGrMC on AnGrMC.wtable = 1432
                               and AnGrMC.Name = '.‘η¥β –'
              left join AttrVal AvGrMc on AvGrMc.wTable = AnGrMC.wtable
                               and AvGrMc.cAttrNam = AnGrMC.nrec
                               and AvGrMc.cRec = GrMc.Nrec
            WHERE MC.nrec = :(_cMc)
         ) Schet
           left join BuhSchet BSch on BSch.nrec = Schet.cBuhSchet
      into (_result)
      ;
  }
  _except else {}

 result := _result
}

end.
