#include GP_UserFilterPeriodEditView.vih;

#component "GP_Common"

#include GP_UserFilterPeriod.vih
interface GP_UserFilterPeriod;

var
  _dateBeg       : date;
  _dateEnd       : date;
  _defaultDateBeg: date;
  _defaultDateEnd: date;
  _noField       : tptr;
  _filterStr     : string;
  _saveName      : string;
  _editView      : GP_UserFilterPeriodEditView noauto;

window wPick 'Установка периода' escClose, doAccept;
  show(,,70,5);
  embedded scPick interface _editView;
  show(,,,2);
  end;
  screen scButtons;
  show(,3,,) fixed_y;
  buttons
    cmDoOk, default;
<<
                                                    <. Продолжить .>
>>
  end;
  handleevent
    cmDoOk: PutCommand(cmDefault);
  end;
end; //window

procedure OnEditViewCmDefault;
{
  CloseWindowEx(wPick, cmDefault);
}

constructor UserFilterPeriod(NoField: tptr; SaveName: string; dDateBeg: date = 0; dDateEnd: date = 0;
                             dDefaultDateBeg: date = 0; dDefaultDateEnd: date = 0);
{
  _noField := NoField;
  _saveName := SaveName;
  _dateBeg := dDateBeg;
  _dateEnd := dDateEnd;
  _defaultDateBeg := dDefaultDateBeg;
  _defaultDateEnd := dDefaultDateEnd;
  _editView := new(GP_UserFilterPeriodEditView, UserFilterPeriodEditView(self, 'Период'));
  BindEvent(OnEditViewCmDefault, _editView.OnCmDefault);
  result := true;
}

procedure Pick;                //Выбор значения(й) фильтра
{
  RunWindowModal(wPick)
}

procedure Del;                 //Очистка фильтра
{
  _dateBeg := _defaultDateBeg;
  _dateEnd := _defaultDateEnd;
}

procedure Load(IStore: GP_IUserFilterStore);//Загрузить значения фильтра из хранилища IStore
{
  _dateBeg := IStore.LoadDate(_saveName + '_DateBeg');
  _dateEnd := IStore.LoadDate(_saveName + '_DateEnd');
}

procedure Save(IStore: GP_IUserFilterStore);//Сохранить значения фильтра в хранилище IStore
{
  IStore.SaveDate(_dateBeg, _saveName + '_DateBeg');
  IStore.SaveDate(_dateEnd, _saveName + '_DateEnd');
}

function GetDatePresentation(d: date): string;
{
  result := if(d = 0, '<пусто>', DateToStr(d, 'DD.MM.YYYY'));
}

function GetFilterStr: string;    //Функция формирующая отображаемое значение фильтра
{
  result := GetDatePresentation(_dateBeg) + ' - ' + GetDatePresentation(_dateEnd);
}

property NoField       : tptr read _noField;    //Номер поля фильтра (константа fn*)
property FilterStr     : string read GetFilterStr; //Отображаемое значение фильтра
property DateBeg       : date absolute _dateBeg;
property DateEnd       : date absolute _dateEnd;
property DefaultDateBeg: date absolute _defaultDateBeg;
property DefaultDateEnd: date absolute _defaultDateEnd;

end.
