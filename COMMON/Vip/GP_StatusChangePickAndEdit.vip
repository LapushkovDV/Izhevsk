#include Marker.vih

interface GP_StatusChangePickAndEdit 'Выбор переходов статусов', Cyan, DoAccept, EscClose;
show(20,5,105,25);

var cCurTypeDoc:comp;
    hMarker:longint;
    pMarker:IMarker(Marker) new;

table struct MemStatusChange(NRec:comp,Code:string[5],StatusFromCode:string[5],StatusFrom:string,StatusTo:string)
with index(i1=NRec,i2=StatusFromCode+Code);

create view
from
  MemStatusChange(i2);

parameters cCurTypeDoc,hMarker;

browse brRoles (,,sci1EscIns);
table MemStatusChange;
recMarker=pMarker{MemStatusChange.NRec};
fields
  MemStatusChange.StatusFrom 'Из статуса' ('Из статуса',,):[40],Protect;
  MemStatusChange.Code 'Код' ('Код',,):[5],Protect,NoAutoSize;
  MemStatusChange.StatusTo 'В статус' ('В статус',,):[40],Protect;
end;

HandleEvent
cmInit:{
  if (cCurTypeDoc=0 or hMarker=0) {
    abort;
    exit;
  }

  delete all MemStatusChange;
  sql
    select distinct GP_StatusChange.NRec,GP_StatusChange.Code,SF.Code,SF.Name,ST.Name
    from
      GP_StatusChange
      inner join GP_Status SF on (GP_StatusChange.cStatusFrom=SF.NRec)
      inner join GP_Status ST on (GP_StatusChange.cStatusTo=ST.NRec)
    where
      :(cCurTypeDoc)=SF.cTypeDoc and :(cCurTypeDoc)=ST.cTypeDoc
    into MemStatusChange;

  pMarker.ImportFrom(hMarker);
}
cmDefault:{
  if (pMarker.Count=0)
    pMarker.Mark;

  pMarker.ExportTo(hMarker);
}
end;
end.
