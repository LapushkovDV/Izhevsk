  xlSetCellFormula(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}

procedure FormulaIntegerVal(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetNumberFormat('### ### ### ##0',liRB,liCB,liRE,liCE);
  xlSetCellFormula(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlRight,xlCenter,liRB,liCB,liRE,liCE);
}

procedure FormulaIntegerValC(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetNumberFormat('### ### ### ##0',liRB,liCB,liRE,liCE);
  xlSetCellFormula(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}

//========================================
//OutputFilesDirectory
//========================================
Function OutputFilesDirectory : String;
var IsCur3X : Boolean;
    //aDosCode, aErrorCode : Integer;
{
  IsCur3X:=IfDefServerApp; //true-3-ур. арх-ра
  if (IsCur3X)
  {
    Result:=GetPathParameter('Files','OutputFilesDirectory',0);
  }
  else
  { //MyOutputFilesDirectory:=GetStringParameter('Files','OutputFilesDirectory',0);
    Result:=GetPathParameter('Files','OutputFilesDirectory',0);
  }
}

//========================================
//Инициализация Excel
//========================================
Function ExcelInit(sub_path:string; wnmfile:string ; fromtemplate :boolean ) : word ;
var
  XlRes    : Boolean;
  aFileName,wstr: String;
  akolfile :longint;
  aFileName1: string ;
  acurbook  : string ;
{ //wpoint:=GetDecimalSeparator; //общесистемный разделитель в Excel
  ExcelInit:=1 ;


  XlRes := True;
  aFileName := OutputFilesDirectory + wnmfile;
  aFileName1:=aFileName;
  ExcelInit:=2 ;

  akolfile:=0 ;
  if FileExist(aFileName)
  { if not DeleteFile(aFileName)
    { do
      { akolfile:=akolfile+1 ;
        if akolfile>20 then
        { akolfile:=0 ;
        }
        aFileName1:=substr(aFileName,1,pos('.',aFileName)-1)+'d'+string(akolfile)+'.xlsx';
        if FileExist(aFileName1)
        { DeleteFile(aFileName1)
        }
      } while fileexist(aFileName1)
      if akolfile=0
      { message('Ошибка при удалении файла '+chr(13)+wnmfile+
        chr(13)+'возможно он открыт другой программой') ;
        exit ;
      }
      else aFileName:=aFileName1 ;
    }
  } //if false //FileExist(aFileName)

  ExcelInit:=3 ;
  //sub_path= #_MYXLSPATH_
  wstr:=translatepath('%ClientStartPath%'+sub_path+'\')+wnmfile ;
  timelog('GP_XlOutExt->ExcelInit:wstr='+wstr+', fromtemplate='+string(fromtemplate));
  acurbook:='';
  if fromtemplate
  {  //XlRes := xlCreateExcelWithTemplate(wstr, True);
     XlRes := xlCreateNewExcelWithTemplate(wstr, True);

     if not XLRes
     { message('Ошибка открытия шаблона '+wstr) ;
       exit ;
     }
     else
     {  xlGetActiveWorkBookName(acurbook) ;
        xlSaveAsWorkBookByName(acurbook,aFileName); //Сохраним в OUT
     }
  }
  else  XlRes := xlCreateExcel(aFileName, True);

  if Not(xlDisplayAlerts(false)) {} //message('Error xlDisplayAlerts !'); //убираем сообщения в EXCEL


  if (XlRes) XlRes := xlIsExcelValid;
  if not XlRes then exit;

  acurbook:='' ;
  xlGetActiveWorkBookName(acurbook) ;
  ExcelInit:=5 ;

  ExcelInit:=0 ;
}


end.
