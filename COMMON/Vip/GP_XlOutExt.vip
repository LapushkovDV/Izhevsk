#include GP_XlOutExt.vih

interface GP_XlOutExt;

file XlTitleEachPageMacros;
file XlTitleEachPageOMacros;
file xlR1C1OnOffMacros;
file xlPageScaleLandMacros;
file xlRangeVertMacros;
file xlSummaryRowAboveMacros;
file xlSetSummaryRowMacros;
file xlHideColMacros;


procedure xlHideCol(sCol : string);
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + 'xlHideCol.bas';
  if xlHideColMacros.OpenFile(MacrosFN, stCreate)
  {
    xlHideColMacros.Writeln('Sub xlHideCol'+sCol);
    xlHideColMacros.Writeln('  Columns("'+sCol+':'+sCol+'").Select');
    xlHideColMacros.Writeln('  Selection.EntireColumn.Hidden = True');
    xlHideColMacros.Writeln('End Sub');
    xlHideColMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('xlHideCol'+sCol);
    DeleteFile(MacrosFN);
  }
}


procedure xlSummaryRowAbove;
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + 'xlSummaryRowAbove.bas';
  if xlSummaryRowAboveMacros.OpenFile(MacrosFN, stCreate)
  {
    xlSummaryRowAboveMacros.Writeln('Sub xlSummaryRowAbove');
    xlSummaryRowAboveMacros.Writeln('  With ActiveSheet.Outline');
    xlSummaryRowAboveMacros.Writeln('      .AutomaticStyles = False');
    xlSummaryRowAboveMacros.Writeln('      .SummaryRow = xlAbove');
    xlSummaryRowAboveMacros.Writeln('      .SummaryColumn = xlRight');
    xlSummaryRowAboveMacros.Writeln('  End With');
    xlSummaryRowAboveMacros.Writeln('End Sub');
    xlSummaryRowAboveMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('xlSummaryRowAbove');
    DeleteFile(MacrosFN);
  }
}

procedure xlSetSummaryRow(iRowB, iRowE, iNPP : integer);
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + 'xlSetSummaryRow.bas';
  if xlSetSummaryRowMacros.OpenFile(MacrosFN, stCreate)
  {
    xlSetSummaryRowMacros.Writeln('Sub xlSetSummaryRow'+iNPP);
    xlSetSummaryRowMacros.Writeln('    Rows("'+iRowB+':'+iRowE+'").Select');
    xlSetSummaryRowMacros.Writeln('    Selection.Rows.Group');
    xlSetSummaryRowMacros.Writeln('End Sub');
    xlSetSummaryRowMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('xlSetSummaryRow'+iNPP);
    DeleteFile(MacrosFN);
  }
}


procedure xlPageScaleLandscape(iFitToPagesWide : integer);
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + 'xlPageScale.bas';
  if xlPageScaleLandMacros.OpenFile(MacrosFN, stCreate)
  {
    xlPageScaleLandMacros.Writeln('Sub xlPageScale');
    xlPageScaleLandMacros.Writeln('  Application.PrintCommunication = False');
    xlPageScaleLandMacros.Writeln('  ActiveSheet.PageSetup.Orientation = xlLandscape');
    xlPageScaleLandMacros.Writeln('  ActiveSheet.PageSetup.FitToPagesWide = '+iFitToPagesWide);
    xlPageScaleLandMacros.Writeln('  Application.PrintCommunication = True');
    xlPageScaleLandMacros.Writeln('End Sub');
    xlPageScaleLandMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('xlPageScale');
    DeleteFile(MacrosFN);
  }
}

procedure xlR1C1OnOff(isOnOff : boolean);
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + 'xlR1C1OnOff.bas';
  if xlR1C1OnOffMacros.OpenFile(MacrosFN, stCreate)
  {
    xlR1C1OnOffMacros.Writeln('Sub xlR1C1'+String(isOnOff));
    if isOnOff
      xlR1C1OnOffMacros.Writeln('  Application.ReferenceStyle = xlR1C1')
    else
      xlR1C1OnOffMacros.Writeln('  Application.ReferenceStyle = xlA1');
    xlR1C1OnOffMacros.Writeln('End Sub');
    xlR1C1OnOffMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('xlR1C1'+String(isOnOff));
    DeleteFile(MacrosFN);
  }
}
procedure xlRangeVert4C(lRow, lPage : longint );
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + 'xlRangeVert'+lPage+'.bas';
  if xlRangeVertMacros.OpenFile(MacrosFN, stCreate)
  {
    xlRangeVertMacros.Writeln('Sub xlRangeVert'+String(lPage));
    xlRangeVertMacros.Writeln('  Range("C'+lRow+':XFD'+lRow+'").Select');
    xlRangeVertMacros.Writeln('  With Selection');
    xlRangeVertMacros.Writeln('    .Orientation = 90');
    xlRangeVertMacros.Writeln('  End With');
    xlRangeVertMacros.Writeln('End Sub');
    xlRangeVertMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('xlRangeVert'+String(lPage));
    DeleteFile(MacrosFN);
  }
}
procedure xlRangeVert(sCol : string; lRow, lPage : longint );
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + 'xlRangeVert'+lPage+'.bas';
  if xlRangeVertMacros.OpenFile(MacrosFN, stCreate)
  {
    xlRangeVertMacros.Writeln('Sub xlRangeVert'+String(lPage));
    xlRangeVertMacros.Writeln('  Range("'+sCol+lRow+':XFD'+lRow+'").Select');
    xlRangeVertMacros.Writeln('  With Selection');
    xlRangeVertMacros.Writeln('    .Orientation = 90');
    xlRangeVertMacros.Writeln('  End With');
    xlRangeVertMacros.Writeln('End Sub');
    xlRangeVertMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('xlRangeVert'+String(lPage));
    DeleteFile(MacrosFN);
  }
}

procedure TitleEachPage(iBeg, iEnd : integer; sReport : string);
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + sReport + '.bas';
  if XlTitleEachPageMacros.OpenFile(MacrosFN, stCreate)
  {
    XlTitleEachPageMacros.Writeln('Sub XlTitleEachPage');
    XlTitleEachPageMacros.Writeln('  ActiveSheet.PageSetup.Orientation = xlLandscape');
    XlTitleEachPageMacros.Writeln('  ActiveSheet.PageSetup.PrintTitleRows = "$'+iBeg+':$'+iEnd+'"');
    XlTitleEachPageMacros.Writeln('End Sub');
    XlTitleEachPageMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('XlTitleEachPage');
    DeleteFile(MacrosFN);
  }
}
procedure xlTitleEachPageO(iBeg, iEnd : integer);
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + 'xlTitleEachPageO.bas';
  if XlTitleEachPageOMacros.OpenFile(MacrosFN, stCreate)
  {
    XlTitleEachPageOMacros.Writeln('Sub XlTitleEachPageO');
    XlTitleEachPageOMacros.Writeln('  ActiveSheet.PageSetup.PrintTitleRows = "$'+iBeg+':$'+iEnd+'"');
    XlTitleEachPageOMacros.Writeln('End Sub');
    XlTitleEachPageOMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('XlTitleEachPageO');
    DeleteFile(MacrosFN);
  }
}

procedure Header1Row(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetCellStringValue(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}
procedure Header1RowB(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetCellStringValue(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlBottom,liRB,liCB,liRE,liCE);
}
procedure Header1RowT(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetCellStringValue(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlTop,liRB,liCB,liRE,liCE);
}
procedure Header2Row(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlMergeCells(liRB,liCB,liRE+1,liCE);
  xlSetCellStringValue(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}
procedure Header3Row(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlMergeCells(liRB,liCB,liRE+2,liCE);
  xlSetCellStringValue(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}
