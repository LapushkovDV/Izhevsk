procedure StringValL(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetCellStringValue(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlLeft,xlCenter,liRB,liCB,liRE,liCE);
}
procedure StringValC(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetCellStringValue(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}
procedure StringValR(sString : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetCellStringValue(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlRight,xlCenter,liRB,liCB,liRE,liCE);
}

procedure DateVal(dDate : date; liRB,liCB,liRE,liCE : longint);
{
  xlSetCellStringValue(if(dDate<>0,datetostr(dDate,'DD.MM.YYYY'),''),liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlRight,xlCenter,liRB,liCB,liRE,liCE);
}

procedure CodeVal(sCode : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetNumberFormat('@',liRB,liCB,liRE,liCE);
  xlSetCellStringValue(sCode,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}
procedure CodeValL(sCode : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetNumberFormat('@',liRB,liCB,liRE,liCE);
  xlSetCellStringValue(sCode,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlLeft,xlCenter,liRB,liCB,liRE,liCE);
}
procedure CodeValB(sCode : string; liRB,liCB,liRE,liCE : longint);
{
  xlSetNumberFormat('@',liRB,liCB,liRE,liCE);
  if sCode <> '0'
    xlSetCellStringValue(sCode,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}

procedure DoubleVal(dbDouble : double; liRB,liCB,liRE,liCE : longint);
{
  xlSetNumberFormat('### ### ### ##0, 00',liRB,liCB,liRE,liCE);
  xlSetCellNumberValue(dbDouble,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlRight,xlCenter,liRB,liCB,liRE,liCE);
}

