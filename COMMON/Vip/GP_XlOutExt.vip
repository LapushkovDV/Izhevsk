}
procedure HeaderIns(sString : string; liRB,liCB,liRE,liCE,liSize : longint);
{
  xlMergeCells(liRB,liCB,liRE,liCE+liSize-1);
  xlSetCellStringValue(sString,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}
