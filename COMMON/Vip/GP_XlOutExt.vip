{
  xlSetNumberFormat('0;-0;"-"',liRB,liCB,liRE,liCE);
  xlSetCellNumberValue(iInt,liRB,liCB,liRE,liCE);
  xlAlignCellsEx(xlCenter,xlCenter,liRB,liCB,liRE,liCE);
}

