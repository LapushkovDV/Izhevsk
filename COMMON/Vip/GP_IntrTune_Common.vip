#include TuneSpec.vih
#include FeeSigners.vih
#include GetKau.vih

VipInterface GP_IntrTune_Common implements ObjIntrTuneComponent licensed (FREE);

// Обработчик точки расширения epIntrTuneComponent
// Должен вернуть FALSE если обработка проводилась. TRUE - если не проводилась.
handler with replace GP_IntrTune_Common on extensionPoint epIntrTuneComponent (TR: objTuneIntr; TVal: TTuneVal; Inter: string)
action
{
   var ifc : GP_IntrTune_Common;
   result := not ifc.TuneIntrComponent (TR, TVal, Inter);
}
#doc
 обработчики настроек
#end
//-----------------------------------
Interface GP_IntrTune_Common;
//-----------------------------------
#include ShowKau.Vpp
//-----------------------------------
#include GetKau.var
var
 Markers:tPtr;
 KAuMarkerName:string;
 wStr:string;
 j:longint;
Create view
var
  wc_nrec:comp;
  wc_GroupMC:comp;
  wKodGrKau :word;
as select catalogs.nrec
from catalogs
,KATLINK
,x$users
where ((
    wc_nrec == Catalogs.Nrec
and wc_nrec == KATLINK.Nrec
and wc_nrec == x$users.Atl_nrec
))
;

// Убрать домен из имени пользователя
Function UserRemoveDomen(ww:string): string;
{ Result:='';
  if  pos('\',ww)>0
    Result:=substr(ww,pos('\',ww)+1,200)
  else
    Result:=ww;
} //Function UserRemoveDomen(ww:string): string;


// получить имя пользователя по ID
Function GetUserName(ww_cUser:comp):string;
{ if ww_cUser=0
  { Result:='';
    Exit;
  }
  Result:=UserName();
  if UserID()<>ww_cUser
  { if getfirst x$users where (( ww_cUser == x$users.Atl_Nrec ))=0
    {  Result:=UserRemoveDomen(x$users.xu$LoginName);
    }
  }
} //Function GetUserName(ww_cUser:comp):string;

// Обязательно должна вернуть False если обработка не производилась, иначе true
Public Function TuneIntrComponent (TR: objTuneIntr; TVal: TTuneVal; Inter: string) : boolean;
{
  Var PrOk : boolean;  PrOk := False;

  TuneIntrComponent := true; // Чтобы в каждом case не писать это

  case UpCase(Inter) of

  'EMAIL_SIGNSCOPE': //NPOEM_OWN.EMAIL_signscope
  {   wc_nrec:=TVal.CompVal;
      wStr:=TVal.strVal;
      If RunInterface(GP_EMAIL_SIGNSCOPE,wc_nrec,wStr)<>cmCancel
      {
        TVal.CompVal:=wc_nrec;
        TVal.strVal :=wStr;
        PrOk := true;
      }
  }

  else
    TuneIntrComponent := false;  // Если не зашли в обработку, то обязательно установим в false
  end;  // case

  if (PrOk)
    TR.UpdateTuneVal(TVal);
}     // TuneIntrComponent
end. // интерфейс
