#include Marker.vih

interface GP_PickUsers 'Выбор пользователей', Cyan, DoAccept, EscClose;
show(20,5,100,25);

var Mode:word;
    cCurUser:comp;
    hMarker:longint;
    pMarker:IMarker(Marker) new;

create view
as select
  X$USERS.XU$LOGINNAME
from
  X$USERS;

parameters Mode,cCurUser,hMarker;

browse brUsers (,,sci1EscIns);
table X$USERS;
recMarker=pMarker;
fields
  if(X$USERS.XU$TYPE=1,'IMGATLADMIN','IMGARMUSER') '':[2],Image;
  X$USERS.XU$LOGINNAME 'Идентификатор' ('Идентификатор (сетевое имя) пользователя',,):[30],Protect;
  X$USERS.XU$FULLNAME 'Имя пользователя' ('Имя пользователя',,):[50],Protect;
end;

HandleEvent
cmInit:{
  if ((Mode and cgiPickMult)=cgiPickMult) {
    if (hMarker=0) {
      message('Не задан маркер для множественного выбора.',error);
      abort;
      exit;
    }

    pMarker.ImportFrom(hMarker);
    SetHelpAndStatusContext(brUsers, -1, sci1EscIns, hcKeepCurrent);
  } else {
    PutCommand(cmValue1);

    if ((Mode and cgiPick)=cgiPick)
      SetHelpAndStatusContext(brUsers, -1, sci1Esc, hcKeepCurrent);
  }

  if (cCurUser<>0)
    if (getfirst X$USERS where((cCurUser==X$USERS.Atl_NRec))=tsok) {};
}
cmValue1:{
  pMarker.Disable:=true;
}
cmDefault:{
  if ((Mode and cgiPickMult)=cgiPickMult) {
    if (pMarker.Count=0)
      pMarker.Mark;

    pMarker.ExportTo(hMarker);
  }

  cCurUser:=X$USERS.Atl_NRec;
}
end;
end.
