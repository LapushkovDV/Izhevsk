interface GP_PickRoleGroup 'Выбор группы ролей пользователей', Cyan, DoAccept, EscClose;
show(20,5,105,25);

var RoleGroupName:string;

create view
from
  GP_RoleGroups;

parameters RoleGroupName;

browse brRoleGroups (,,sci1Esc);
table GP_RoleGroups;
fields
  GP_RoleGroups.Name 'Наименование' ('Наименование',,):[40],Protect;
end;

HandleEvent
cmInit:{
  if (RoleGroupName<>'')
    if (getfirst GP_RoleGroups where((RoleGroupName==GP_RoleGroups.Name))=tsok) {};
}
cmDefault:{
  RoleGroupName:=GP_RoleGroups.Name;
}
end;
end.
