#include GP_GetUserDeskRep.Vih

#doc
Настройки отчетов
#end

Interface GP_GetUserDeskRep 'Настройки отчетов' DoAccept, EscClose,Cyan;
Show at (,,,);

Create view vUDR
var 
    pUserDeskRep : comp;
    sRepName     : String;
    wNREP : Word;
    sUserName : String;
as Select UserDeskRep.*
From UserDeskRep,
    PickRep,PickRep PickRepF
Where
((    wNREP     == UserDeskRep.NREP 
  and UserDeskRep.nRec == PickRep.cUserDeskRep
  //and (UpCase(sRepName) = UpCase(UserDeskRep.REPNAME) and UserDeskRep.REPNAME<>'')
 // and ( pos(sRepName,UserDeskRep.REPNAME) >0 )
  and PickRep.Nrec == PickRepF.Nrec
))
//  and ( upCase(sRepName) = upCase(UserDeskRep.REPNAME))
  and ( upCase(sRepName) = upCase(UserDeskRep.REPNAME) and (sUserName='' or (UpCase(sUserName) = UpCase(UserDeskRep.OWNNAME) )) )

/*
bounds ByRep     as    wNREP     == UserDeskRep.NREP              //Тип отчета
                 and ( sRepName = UserDeskRep.REPNAME)
                   //---- sRepName   ==UserDeskRep.REPNAME(noindex)
                   //and sRepName20         <<=UserDeskRep.REPNAME(length=20)   //Наименование отчета
                   //and sRepName20+'ЯЯЯ'   >>=UserDeskRep.REPNAME(length=20)
                   ordered by TableOrder
bounds ByRepUser as     wNREP     == UserDeskRep.NREP     //Тип отчета
                   and sUserName == UserDeskRep.OWNNAME   //Юзер
                   and (UpCase(sRepName) = UpCase(UserDeskRep.REPNAME))
                   //ordered by TableOrder

*/                   
;

//Возвращаемые параметры через RunInterface
Parameters pUserDeskRep,
           sRepName,
           wNREP,
           sUserName;

//*******************************************************************************
//=======================================
//Проверка параметров
//=======================================
Function CheckParam:Boolean;
{
  CheckParam := True;
  if (pUserDeskRep = 0
  AND sRepName     = '')
  {
    CheckParam := False;
    message('Ошибка! Не заданы параметры в pUserDeskRep и sRepName в функции ReadUserDeskRep().');
  }
}
//=======================================
//Проверка на изменение чужой настройки
//=======================================
Function CheckUserDeskRep(boCheck:Boolean;boMsg:Boolean):Boolean;
{
  CheckUserDeskRep:=True;

  if Not(CheckParam) exit;

#ifdef _GUSE_
  boCheck:=False;
#end
  if Not(boCheck) then exit;
  if (PR_CurUserAdmin) then exit; //Админам
  if (GetFirst UserDeskRep Where (( pUserDeskRep == UserDeskRep.Nrec )) = tsOk)
   AND (UserDeskRep.OWNNAME<>UserName)
  {
    CheckUserDeskRep:=False;
    if (boMsg) then Message(''#3'Нельзя изменять чужие настройки!');
  }
}
//=======================================
//Перегон из Marker в PickRep
//=======================================
Procedure MarkerToPickRep(Marker:Longint;wList:Word;sUserName:String);
Var
  iii, lCount : longint;
  PickRec : comp;
{
  if Not(CheckParam) exit;

  if Delete all PickRep where (( sUserName        == PickRep.OwnName      AND
                                 wList            == PickRep.wList        AND
                                 pUserDeskRep     == PickRep.cUserDeskRep
                              )) = tsOk {}

  lCount  := GetMarkerCount(Marker);
  for(iii := 0; iii < lCount; iii := iii + 1)
  {  if ( GetMarker(Marker, iii, PickRec) )
     {
        ClearBuffer(#PickRep);
        PickRep.OwnName      := sUserName;
        PickRep.wList        := wList;
        PickRep.cRec         := PickRec;
        PickRep.PickNum      := iii;
        PickRep.cUserDeskRep := pUserDeskRep;
        Insert Current PickRep;
     }
  }
}
//=======================================
//Перегон из PickRep в Marker
//=======================================
Procedure PickRepToMarker(Marker:Longint;wList:Word;sUserName:String);
{
  if Not(CheckParam) exit;

  ClearMarker(Marker);
  _loop PickRep Where (( sUserName    == PickRep.OwnName      AND
                             wList    == PickRep.wList        AND
                         pUserDeskRep == PickRep.cUserDeskRep
                      ))
  { InsertMarker(Marker, PickRep.cRec);
  }
}
//=======================================
//Вставка новой настройки UserDeskRep
//=======================================
Function InsUserDeskRep:Comp;
{
  InsUserDeskRep := 0;

  if Not(CheckParam) exit;

  if (pUserDeskRep=0)
  {
     ClearBuffer(#UserDeskRep);
     UserDeskRep.REPOPI      := 'Без имени';
     UserDeskRep.RepName     := sRepName;
     UserDeskRep.dRep        := Cur_Date;
     UserDeskRep.OWNNAME     := UserName;
     UserDeskRep.NREP        := 0;
     Insert current UserDeskRep;
     set pUserDeskRep := UserDeskRep.Nrec;

     if GetFirst UserDeskRep Where (( pUserDeskRep == UserDeskRep.Nrec )) = tsOk {}
  }

  InsUserDeskRep := pUserDeskRep;
}
//=======================================
//Запись тенущей настройки UserDeskRep в DSK
//=======================================
Procedure SaveUserDeskRep;
{
  if Not(CheckParam) exit;

  SaveMyDsk(pUserDeskRep, sRepName+'_pUserDeskRep');
}
//=======================================
//Чтение настройки UserDeskRep из DSK
//=======================================
Function ReadUserDeskRep(_pUserDeskRep:Comp;_sRepName:String):Comp;
{
  ReadUserDeskRep := 0;

  set pUserDeskRep := _pUserDeskRep;
  set sRepName     := _sRepName;

  if Not(CheckParam) exit;

  if (pUserDeskRep=0)
  { if not ReadMyDsk(pUserDeskRep, sRepName+'_pUserDeskRep' ,false) then pUserDeskRep:=0;
  }
  if (pUserDeskRep=0)
  { if GetFirst UserDeskRep Where ((  sRepName  == UserDeskRep.REPNAME (noindex)
                                  AND 0         == UserDeskRep.NREP
!                                  AND UserName  == UserDeskRep.OWNNAME
                                  )) = tsOk
    { set pUserDeskRep := UserDeskRep.Nrec;
    }
  }
  //проверка тот-ли отчет
  if GetFirst UserDeskRep Where (( pUserDeskRep == UserDeskRep.Nrec )) = tsOk
  { if (sRepName = UserDeskRep.REPNAME)
    { set pUserDeskRep := UserDeskRep.Nrec;
//=========================================
!Потом убрать
!      if (UserDeskRep.OWNNAME='') then
!       Update current UserDeskRep Set UserDeskRep.OWNNAME:=UserName;
//=========================================
    } else { set pUserDeskRep := 0; }
  } else { set pUserDeskRep := 0; }

  Set pUserDeskRep := InsUserDeskRep(); //Вставка новой настройки UserDeskRep, если нет настроек

  ReadUserDeskRep := pUserDeskRep;
}
//*******************************************************************************
Browse b1 ( , ,sci178Esc);
Table UserDeskRep;
Fields
   UserDeskRep.REPOPI     'Наименование настройки'    ('',, sci178Esc)
                          : [30], noProtect;

   UserDeskRep.dRep       'Дата'  ('',, sci178Esc)
                          : [10, 'DD/MM/YYYY'], Protect, Centered, NoAutoSize;

   UserDeskRep.OWNNAME    'Владелец'    ('Владелец (для определения Ctrl+F4 и введите UserName)',, sci178Esc)
                          : [10], noProtect; //!!!Потом закрыть!!!
end; //Browse b1
//*******************************************************************************


TableEvent Table UserDeskRep;
cmSetDefault :
{
  UserDeskRep.REPOPI      := 'Без имени';
  UserDeskRep.RepName     := sRepName;
  UserDeskRep.dRep        := Cur_Date;
  UserDeskRep.NREP        := wNREP;
  UserDeskRep.OWNNAME     := UserName();

}

cmInsertRecord :
{
  Insert current UserDeskRep;
}

cmDeleteRecord :
{
  if (UserDeskRep.OWNNAME=UserName()  ) OR (PR_CurUserAdmin)
  {
    if ( Message(''#3'Удалить текущую запись?', YesNo) <> cmYes )
      Abort;
    else
     {
       Delete all PickRep;
       Delete current UserDeskRep;
     }
  }
  else
  { Message(''#3'Нельзя удалять чужие настройки!');
    Abort;
  }
} //cmDeleteRecord :

cmUpdateRecord:
{
  if Update current UserDeskRep<>tsok
  { message('Ошибка обновления настройки')
  }
} //cmUpdateRecord:
end;//TableEvent Table UserDeskRep


//*******************************************************************************
// Обработчик событий интерфейса
//*******************************************************************************
HandleEvent
cmDefault : //Кнопка "Enter"
{
  UpdateTable;
  Set UserDeskRep.REPOPI:=UserDeskRep.REPOPI;
  pUserDeskRep := UserDeskRep.nrec;
  CloseInterface(cmDefault);
}

cmInit :
{
  timelog('IGetUserDeskRep->cminit:wNREP='+string(wNREP)+',sUserName='+sUserName+',sRepName='+sRepName+',pUserDeskRep='+string(pUserDeskRep));
  sUserName:=trim(sUserName);
  sRepName:=trim(sRepName);
  //PopBounds(tbByRep);     //Снять
  //PopBounds(tbByRepUser); //Снять
  //sUserName:='supervisor'
  /*
  if False // перестало все работать на 24 атлантисе
  { if (sUserName='')
    { #timelog2('IGetUserDeskRep->tbByRep') 
    //PushBounds(tbByRep);     //Установить
    SetBounds(#UserDeskRep)
    }
    else
    { #timelog2('IGetUserDeskRep->tbByRepUser') 
      PushBounds(tbByRepUser); //Установить
    }
    ReReadRecord(#UserDeskRep)
  
  }
  */  
  ReScanPanel(#UserDeskRep);
  if getfirst UserDeskRep=0 {}
  timelog('IGetUserDeskRep->cmInit 000:UserDeskRep.RepName:='+UserDeskRep.RepName+';'+string(UserDeskRep.Nrec));
  if Not(PR_CurUserAdmin)
  { ClearFieldOption(#UserDeskRep.OWNNAME, ofSelectable); //Закрыть поле
  }
  if pUserDeskRep>0
  { if getfirst UserDeskRep where ((  pUserDeskRep ==  UserDeskRep.Nrec
      and (sRepName= UserDeskRep.REPNAME)
      ))<>0
    { if getfirst UserDeskRep=0 {}
      {
      }
    }
    else
    {
    }
  }
  else
    if getfirst UserDeskRep=0 
    {  //timelog2('IGetUserDeskRep->cmInit 003:UserDeskRep.RepName:='+UserDeskRep.RepName+';')
    }
  ReScanPanel(#UserDeskRep);
  timelog('IGetUserDeskRep->cmInit Final:UserDeskRep.RepName:='+UserDeskRep.RepName+';'+string(UserDeskRep.Nrec));
} //cmInit :

cmValue1: // скопировать настройку
{ UpdateTable;
  if not isvalid(#UserDeskRep)
  { message('Еще нет ни одной настройки!');
    abort;
  }
  if message('Скопировать настройку '
    +chr(13)+UserDeskRep.REPOPI+'?' , YesNo)<>cmYes
  { abort;
  }  
  var ww_old:comp;
  ww_old:=UserDeskRep.Nrec;
  UserDeskRep.Nrec:=0 ;
  UserDeskRep.REPOPI:=UserDeskRep.REPOPI+' копия';
  UserDeskRep.OWNNAME:=UserName();
  if insert current UserDeskRep=0
  { _Loop fullcache PickRep where (( ww_old== PickRep.cUserDeskRep  ))
    { if getfirst PickRepF=0
      { PickRepF.Nrec:=0;
        PickRepF.cUserDeskRep:=UserDeskRep.Nrec;
        Insert current PickRepF;
      }
    }
  } //if insert current UserDeskRep=0
  else
  { message('Ошибка копирования настройки '+UserDeskRep.REPOPI);
    ReReadRecord(#UserDeskRep);
  }  
  ReScanPanel(#UserDeskRep)

} //cmValue1: // скопировать настройку
cmDone :
{
}
cmHotKeys:
{  PutHotCommand(RunMenu('GP_GetUserDeskRep_Menu'));
}
end; //HandleEvent

end.
GP_GetUserDeskRep_Menu Menu
{
  - 'Скопировать настройку',cmValue1,''                         ,hcNoContext,'',,sci1Esc;
}
