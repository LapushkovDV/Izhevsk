#include AlgCalc.vih
#include AlgCalc.vih
#include oAlgFldSys.vih
#include TMnPlan.vih
#include oAlgInDocList.vih
#include Algor.vih
#include StatLog.vih
#include GP_Log.vih

#component "M_MnPlan"
#doc
Наименование: Сообщение о закрытии периода и рассылка
<p>
#end

VipInterface Algoritm_6961 Implements oAlgoritm_Sys
parameters (nrecFormPl : comp);
Interface Algoritm_6961;


Create view
var
  nrecFormPl : Comp;
as select
  word(SpFormPl1.descr)
from
  FormPl
 ,SpFormPl SpFormPl1
 ,SpFormPl SpFormPl2
where
((
    nrecFormPl  == FormPl.NRec
and FormPl.NRec == SpFormPl1.cFormPl
and           1 == SpFormPl1.TYPEREC
and FormPl.NRec == SpFormPl2.cFormPl
and           2 == SpFormPl2.TYPEREC

));

Parameters
  nrecFormPl;



Function GetNum: Word;
{
  GetNum := 6961;
}

Function GetName: String;
{
  GetName := '6961. Сообщение о закрытии периода и рассылка';
}

Function GetMemo(st: oSteckCommonString): Boolean;
{
  GetMemo := True;
  st.Push(GetName);
  st.Push('    Сообщение о закрытии периода и рассылка.');
}

Function GetNameInter: String;
{
  GetNameInter := 'Algoritm_'+GetNum;
}

Function GetNameInterPr: String;
{
  GetNameInterPr := 'Algoritm_'+GetNum+'_Setup';
}

Function InitInter(Var pt: TRecAcc): Boolean;
{#__UNUSED__(pt)
 InitInter := True;
}

Function RunInter(wflag: Word; Var pt: TRecAcc): Boolean;
{
  #__UNUSED__(wflag)
  nrecFormPl:= pt.cFormPl;
  if (Cur_Date <= FormPl.RESDATE[1]) then
  {
   var _MsgSettings : MsgSettings ;
    _MsgSettings.ShowMessage(pt.cFormPl, 0);
  }
  result := true;
}

End.
