#doc
 Для тестирования массива данных
 Для генерации
 кол-во записей в справочнике делится на число итераций - и с таким шагом создаются
 если шаг меньше 1, то на одну запись справочника создается несколько строк
#end
Interface GP_Generate_Doc  'Генератор документов', EscClose;
var
  wTypeGen  : word;
  numIter   : longint=50000;
  numIterSP : longint=50;
  wVidsopr  : word;
  DTB,DTE   : date;
create view
as select
  KatSopr.Nrec
From
  KatSopr  , KatMc , KatPodr, SpSopr;
;

Function FormDoc:boolean;
{ Result:=False;
  if wTypeGen=0
  { Message('Задайте тип генерации');
    Exit;

  }
  if numIter=0 or numIterSp=0
  { Message('Кол-во итераций не должно быть 0!');
    Exit;
  }
  if Message('Произвести генерацию документов?',YesNo)<>cmYes
  { Exit;
  }
  var _Dt:date;
  var _counter   :longint=0;
  var _counter_sp:longint=0;
  var _step_dt   :longint=CalcDaysBetweenDates(DTB,DTE,false)/numIter;
  var _step_podr :longint=RecordsInTable(#KatPodr)/numIter;
  var _step_Mc   :longint=RecordsInTable(#KatMC)/numIter;
  if _step_dt=0   _step_dt  :=1;
  if _step_MC=0   _step_MC  :=1;
  if _step_Podr=0 _step_Podr:=1;
  if getfirst KatPodr <>tsok
  { Message('Нет  записей в KatPodr ');
    Exit;
  }
  if getfirst KatMC <>tsok
  { Message('Нет  записей в KatMc ');
    Exit;
  }
  _dt:=DTB;
  var ii:longint;
  do {
    If Not NextVisual break;
    clearbuffer(#KAtSopr);
    KatSopr.VidSopr:=wTypeGen;
    KatSopr.DSopr  :=_Dt ;
    KatSopr.cPodrFrom:=KatPodr.Nrec;
    KatSopr.Descr:='TEST' ;
    KatSopr.Desgr:='TEST' ;
    KatSopr.NSopr:='_00000'+LpadCh(_counter,'0',5);
    Insert Current KatSopr;
    //---- спецификация
    _counter_sp:=0;
    do
    { clearbuffer(#SpSopr);
      SpSopr.PrMc:=1;
      SpSopr.Vidsopr:=KatSopr.VidSopr;
      SpSopr.cMcUsl:=KatMc.Nrec;
      SpSopr.NPP:=_counter_sp+1;
      SpSopr.Kol:=10;
      SpSopr.KolFact:=10;
      SpSopr.Price:=10;
      SpSopr.cSopr:=KatSopr.Nrec;
      Insert current SpSopr;
      // следующая итерация
      for(ii:=1; ii<=_step_MC; ii++)
      { if getnext katMc<>tsok
          if getfirst katMc<>tsok {}
      }
      _counter_sp++;
    } while _counter_sp<numIterSp;
    //---- следующая итерация
    _DT:=Add_Day(_DT,_step_dt );
    if _DT>DTE _DT:=DTB;
    for(ii:=1; ii<=_step_podr; ii++)
    { if getnext katpodr<>tsok
        if getfirst katpodr<>tsok {}


    }
    _counter++;
  } while _counter<numIter;

  Result:=True ;
} //Function FromDoc:boolean;

//===========================================
Screen scrParam0;
Table Katsopr;
Fields
  wTypeGen: [List 0 ' Выберите тип ', 600 'НВП' ] ,Protect;
  numIter   : NoProtect;
  numIterSP : NoProtect;
  DTB  :NoProtect;
  DTE  :NoProtect;

Buttons
  cmOk    ,,, 'Установить фильтр', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;

<<
 `Генерация документов`
 Для тестирования массива данных
 Для генерации
 кол-во записей в справочнике(Длина интервала) делится на число итераций - и с таким шагом создаются
 если шаг меньше 1, то на одну запись справочника создается несколько строк.
 Документ будет создан с декскриптором TEST

 Тип формирования     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Кол-во итераций      .@@@@@@@@@@@
 Кол-во строк в спец. .@@@@@@@@@@@
 Период               .@@@@@@@@@@@ - .@@@@@@@@@@@

     <. Продолжить .>    <.   Отмена   .>
>>
end; //scrParam05;

HandleEvent
  cmInit:
  { DTB:=date(1,month(cur_date),year(cur_date));
    DTE:=date(Last_day(DTB),month(cur_date),year(cur_date));
  }

  cmOk:
  { StartNewVisual(vtIndicatorVisual, vfTimer, 'Ждите, идет генерация документов', numIter);
    FormDoc;
    StopVisual('',0);


  }
end;
end.
