/*************************************************************************************************\
* Наименование: Функции работы с внешними классификаторами                                        *
* Контур/Модуль: *                                                                                *
* Примечание:                                                                                     *
* Библиотека предназначена для облегчения вывода полей для редактирования внешних классификаторов *
* в интерфейс.                                                                                    *
* Пока предназначена для работы только уникальными классификаторами и поддержиывает выбор только  *
* одного значения, но спроектирована так, чтобы была возможность безболезнено добавить поддержку  *
* не уникальных классификаторов с множественным выбором.                                          *
*                                                                                                 *
* Вид работы  |Номер задачи  |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#763          |05/10/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#IFNDEF __GP_EXTCLASS_VIH__
#DEFINE __GP_EXTCLASS_VIH__

#component "GP_Common"

objInterface GP_ObjExtClass;

  // Выбор значения внешнего классификатора
  // Параметры:
  //  _PickMode  - режим выбора (пока поддерживается только cgiPick)
  //  _ClassCode - код классификатора
  //  _ClassSeg  - NRec выбранного значения внешнего классификатора (возвращаемый)
  //  _ShowTree  - Если true, классификатор выводится в древовидном виде
  function GetValue(_PickMode: Word; _ClassCode: Word; var _cClassSeg: tNRec; _ShowTree: Boolean = true): Boolean;

  // Редактирование значение указанного внешнего классификатора для указанной записи
  // Параметры:
  //  _ClassCode - код классификатора
  //  _cRec      - NRec записи таблицы, для которой нужно редактировать значение внешнего классификатора
  //  _ShowTree  - Если true, классификатор выводится в древовидном виде
  function PickValue(_ClassCode: Word; _cRec: tNRec; _ShowTree: Boolean = true): Boolean;

  // Возвращает NRec сегмента вн.классификатора по коду классификатора и номеру записи таблицы, к которой он привязан
  function GetSegNRec(_ClassCode: Word; _cRec: tNRec): tNRec;

  // Привязывает сегмент с указанным NRec к записи таблицы с указанным NRec
  function SetSegNRec(_ClassCode: Word; _cRec: tNRec; _cClassSeg: tNRec): Boolean;

  // Удаляет все значения внешнего классификатора с кодом _ClassCode, привязанные к записи с указанным NRec
  function DelAllValues(_ClassCode: Word; _cRec: tNRec): Boolean;
end;

vipInterface GP_ExtClass Implements GP_ObjExtClass;
#endif
