Create View viewGroupCopy
select
  KatLink.Nrec
From
  KatLink,
  KatLink synKatLink
;
  
  
//==============================================================================
// Убрать домен из имени пользователя 
//==============================================================================
Function UserRemoveDomen(ww:string): string;
{ Result:='';
  if  pos('\',ww)>0
    Result:=substr(ww,pos('\',ww)+1,200)
  else
    Result:=ww;
} //Function UserRemoveDomen(ww:string): string;

  var 
  name_from ,name_to : string;
  
//==============================================================================
//
//==============================================================================
  Procedure CopyTunesUsersIns(fromUser, toUser : comp);
  { #__UNUSED__(fromUser, toUser)
        viewGroupCopy.ClearBuffer(viewGroupCopy.tnSynKatLink);
        viewGroupCopy.synKatLink.Buffer  := viewGroupCopy.KatLink.Buffer;
        viewGroupCopy.synKatLink.Nrec    := 0;
        viewGroupCopy.synKATLINK.CUSER   := toUser;
        viewGroupCopy.synKATLINK.OWNNAME := name_to;//GetUserNameByID(toUser);
        viewGroupCopy.insert current synKatLink;
  }
//==============================================================================
// функция копирования настройки
//==============================================================================
  Function CopyTunesUsers(fromUser, toUser : comp;wwCODETABLE:word;_Code:word=0 ) : boolean;
  { 
    name_from :=UserRemoveDomen(GetUserNameByID(fromUser));
    name_to   :=UserRemoveDomen(GetUserNameByID(toUser));
    timelog('CopyTunesUsers   from='+name_from+','+name_to);
    Result := true;

    viewGroupCopy.delete all KatLink where (( wwCODETABLE == KATLINK.CODETABLE
                            and toUser   == KATLINK.CUSER
                            and (_code=0 or _code= KATLINK.Code )
                            ));
    viewGroupCopy.delete all KatLink where (( wwCODETABLE == KATLINK.CODETABLE
                            and GetUserNameByID(toUser)   == KATLINK.OWNNAME
                            and (_code=0 or _code= KATLINK.Code )
                            ));
    if viewGroupCopy.getfirst KatLink where (( wwCODETABLE == KATLINK.CODETABLE
                       and fromUser == KATLINK.CUSER
                       and (_code=0 or _code= KATLINK.Code )
                       ))=0
    { timelog('CopyTunesUsers  0001');
      viewGroupCopy._loop KatLink where (( wwCODETABLE == KATLINK.CODETABLE
                       and fromUser == KATLINK.CUSER
                      and (_code=0 or _code= KATLINK.Code )
                       ))
      { CopyTunesUsersIns(fromUser, toUser );
        timelog('  synKATLINK.OWNNAME'+viewGroupCopy.synKATLINK.OWNNAME); 
      }
    }
    else
    { timelog('CopyTunesUsers  0002');
      viewGroupCopy._loop KatLink where (( wwCODETABLE == KATLINK.CODETABLE
                       and name_from == KATLINK.OWNNAME
                       and (_code=0 or _code= KATLINK.Code )
                       ))
      { CopyTunesUsersIns(fromUser, toUser );
        timelog('  synKATLINK.OWNNAME'+viewGroupCopy.synKATLINK.OWNNAME) ;
      }
    }
  } //Function CopyTunesUsers(fromUser, toUser : comp;wwCODETABLE:word ) : boolean;

//==============================================================================
// Для одной настройки
function TunesCopyOne (nSrc : comp; cTune : comp) : word;
var
  idSrc, idDst : comp; //нреки X$user (источник, приемник)
  lOfficeSrc, lOfficeDst : LongInt;//офисы (источник, приемник)
  sLoginSrc : string;
  lCount, i : longint;
  bCopyUser : boolean;
  //buf : type$tmTuneVal;
  cNRecTxUsers : comp;
{ Result:=inherited::TunesCopyOne (nSrc, cTune);
  timelog('TunesCopyOne');
  if Result=0 then Exit;
  timelog('TunesCopyOne EX '+string(Result));
  if (getFirst FastFirstRow TuneDef where ((cTune == TuneDef.nRec)) <> tsOk)
  {
    Message('Не найдена настройка с nRec ' + string(cTune));
    exit;
  }

  if (TuneDef.code = 'USER.OWNNAME') or (TuneDef.code = 'USER.DESCR') or (TuneDef.code = 'USER.FIO')
    exit;

  if (GetFirst TxUsersTmp where ((nSrc == TxUsersTmp.nRec)) <> tsOk)
  {
    Message('Не найден пользователь, от которого нужно копировать настройку.');
    exit;
  }

  sLoginSrc := TxUsersTmp.LoginName;
  idSrc  := TxUsersTmp.cUser;
  lOfficeSrc  := TxUsersTmp.Obj;
  
  MarkerUser := InitMarker('MarkerOfficeUsers', 8, 100, 10);
  lCount := GetMarkerCount(MarkerUser);
  StartNewVisual(vtDownVisual,vfTimer,'Копирование настройки "' + TuneDef.name + '"', lCount);
  FOR (i := 0; i < lCount; i := i + 1)
  {
    if (not NextVisual) break;
    if (not GetMarker(MarkerUser, i, cNRecTxUsers)) continue;
    if (getFirst TxUsersTmp where ((cNRecTxUsers == TxUsersTmp.nRec)) <> tsOk)
    {
      Message('Не найден пользователь, которому нужно копировать настройку.');
      continue;
    }
    timelog('Копируем для '+TxUsersTmp.loginname);

    IdDst := TxUsersTmp.cUser;
    lOfficeDst := TxUsersTmp.Obj;
    // себя не копируем в одном и том же офисе
    if (IdSrc = IdDst) and (lOfficeSrc = lOfficeDst) continue;
    // системная корпоративная не копируется
    if (TuneDef.sysType = ttSysTune) and (TuneDef.CorpoType = ttCorpoTune) continue;

    bCopyUser := false;
    bCopyUser := ((lOfficeDst = lOfficeSrc) /*внутри офиса*/
                or(IdSrc <> 0) // от пользователя(офиса)
                or(IdDst <> 0))/*пользователю(офису)*/;
    if (TuneDef.sysType = ttSysTune) and (bCopyUser)
      continue;
    timelog('Копируем TuneDef.Code '+TuneDef.Code);

     //PICK.CGRPODR
     //--- #1410
     //"Настройки Галактики \ Общие настройки системы \ Работа с МЦ, услугами
     //\ Работа с МЦ \Разрешенные группы МЦ
     if TuneDef.sysType <> ttSysTune
     { if (TuneDef.Code = upcase('MCUSL.MC.ENABLE_GROUPMC'))
       {   CopyTunesUsers(IdSrc, IdDst,coGroupMC);
       }
       if (TuneDef.Code = upcase('MCUSL.USL.ENABLE_GROUPUSL'))
       {   CopyTunesUsers(IdSrc, IdDst,coGroupUSL,1);
       }
       if (TuneDef.Code = upcase('NPOEM_OWN.MZAK.mShablonNarZak'))
       {   CopyTunesUsers(IdSrc, IdDst,coWAYACCOU,1);
       }
       if (TuneDef.Code = upcase('NPOEM_OWN.OPER.SKLAD.Group_Sklad'))
       {   CopyTunesUsers(IdSrc, IdDst,coSpKau,1);
       }
     }

  } //FOR (i := 0; i < lCount; i := i + 1)
  DoneMarker(MarkerUser,'MarkerOfficeUsers');
  StopVisual('', 0);
  
} //function TunesCopyOne (nSrc : comp; cTune : comp) : word;

//==============================================================================
function TunesCopy(nSrc : comp; nDst : comp) : boolean;
var
  idSrc, idDst : comp; //нреки X$user (источник, приемник)
{ Result:=inherited::TunesCopy(nSrc, nDst); 
  //if not Result then exit;
  idSrc:=0;
  if (getFirst TxUsersSyn where ((nSrc == TxUsersSyn.nrec)) <> tsOk)
    idSrc  := TxUsersSyn.cUser;
  idDst:=0;  
  if  getfirst TuneDef where (( 'MCUSL.MC.ENABLE_GROUPMC' == TuneDef.Code ))=0
    if TuneDef.sysType <> ttSysTune
       CopyTunesUsers(IdSrc, IdDst,coGroupMC);
  if  getfirst TuneDef where (( 'MCUSL.USL.ENABLE_GROUPUSL' == TuneDef.Code ))=0
    if TuneDef.sysType <> ttSysTune
       CopyTunesUsers(IdSrc, IdDst,coGroupUSL,1);
  if  getfirst TuneDef where (( 'NPOEM_OWN.MZAK.mShablonNarZak' == TuneDef.Code ))=0
    if TuneDef.sysType <> ttSysTune
       CopyTunesUsers(IdSrc, IdDst,coWAYACCOU,1);
} //function TunesCopy(nSrc : comp; nDst : comp) : boolean;
