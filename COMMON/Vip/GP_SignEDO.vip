var 
  oGP_Log:GP_Log;
#if(#__TOOLVERSION__ >= 5005.035)
#else
  boCertificate:boolean=false;
  LastError:string='';

//==============================================

  create view
  var
    pPlPor:comp;
  as select
     PlPor.Nrec
  From
    PlPor
  where ((
    pPlPor == PlPor.Nrec
  ));
