#component "GP_Common"

#include GP_UserFilterShrRpd.vih
Interface GP_UserFilterShrRpd '' ('', hcNoContext, sci1Esc);

var
  _flags: word;

Create view
Var
  _catStrPrWCodoper: word = 0;
As select *
From CatStrPr
Where ((
  _catStrPrWCodoper == CatStrPr.wCodOper
))
;

constructor GP_UserFilterShrRpd(NoField:tptr; SaveName:string; wFlags: word = vfMultipleSelection);
{
  _flags := wFlags;
  result := inherited::UserFilter(NoField, SaveName);
}

function GP_IUserFilter.GetFilterStr: string;
{
  result := '';

  var markerCount: longint;
  markerCount := GetMarkerCount(Marker);

  case MarkerCount of
    0: result := 'Не установлен'
    1:
    {
      if GetMarker(Marker, 0, _catStrPrWCodoper)
        if (getfirst CatStrPr = tsOk)
          result := CatStrPr.NOper;
    }
    2..10:
    {
      var i: longint;
      var w: word;
      var s: string;
      s := 'РПД №№ ';
      for(i := 0; i <= 9 and GetMarker(Marker, i, w); i++)
          s += if(i = 0, '', ', ') + w;
      result := s;
    }
    else result := 'Множественный выбор (' + string(markerCount) + ')';
  end;
}

procedure GP_IUserFilter.Pick;
{
  var tmpMarker: TPtr;
  tmpMarker := InitMarker('', sizeOf(comp), 10, 100, true);
  CopyMarker(tmpMarker, Marker);

  if RunInterface(GetStrOper, 0, 0, tmpMarker, _flags) = cmDefault
  {
    CopyMarker(Marker, tmpMarker);
  }
  DoneMarker(tmpMarker, '');
  RefreshFilterStr;
}

function GetMarkerProperty: TPtr;
{
  if mFilter = 0 mFilter := InitMarker('', sizeOf(comp), 10, 100, true);
  result := mFilter;
}

procedure RefreshFilterStr;
{
  private::FilterStr := GetFilterStr;
}

property Marker: TPtr read GetMarkerProperty; //маркер распорядительных действий
property Flags: word absolute _flags; //флаг пометки (vfCanSelect - одиночная пометка, vfMultipleSelection - множественная пометка)

End.
