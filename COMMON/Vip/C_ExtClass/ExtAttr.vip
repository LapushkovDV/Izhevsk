// Назначение  : Функции для работы с внешними атрибутами документов
//------------------------------------------------------------------------------
/*
  Параметры:
    __wTable     - co-код Таблицы
    _AttrName    - наименование атрибута
    _cAttrNam    - код атрибута
    _cRec        - ссылка на запись в таблице
    _AttrType    - Тип значения атрибута
       cgAttrType_Str    = 0;   // 0 -  STRING [80]
       cgAttrType_Dbl    = 1;   // 1 -  DOUBLE
       cgAttrType_Date   = 2;   // 2 -  DATE
       cgAttrType_Time   = 3;   // 3 -  TIME
       cgAttrType_Memo   = 4;   // 4 -  MEMO
       cgAttrType_Comp   = 5;   // 5 -  COMP
       cgAttrType_bool   = 7;   // 7 -  BOOLEAN

    _NeedMessage - выдавать сообщение об ошибке
*/


#include ExtAttr.vih
#include AttrTablePick.vih  // Объектный интерфейс для работы с атрибутом ССЫЛКА

#IFDEF _GP_
#component "C_ExtClass"
#ENDIF
#doc
Функции для работы с внешними атрибутами документов<br>
#end

Interface iExtAttr cacheable;

//таблицы для временной вставки внешних атрибутов
table struct tmpAttrNam = AttrNam;
table struct tmpAttrVal
(
  NREC             : comp,
#IFDEF _GP_
#ELSE
  ATL_LASTDATE     : date,
  ATL_LASTTIME     : time,
  ATL_LASTUSER     : comp,
  ATL_ORIGINOFFICE : word,
  ATL_OWNER        : comp,
  LASTUSER         : string,
  LASTTIME         : time,
  LASTDATE         : date,
  FILIALNO         : longInt,
#ENDIF
  WTABLE           : word,
  CREC             : comp,
  CATTRNAM         : comp,
  VSTRING          : string,
  VDOUBLE          : double,
  VDATE            : date,
  VTIME            : time,
  VCOMP            : comp,
  VLONGINT         : longInt,
  vLVar            : boolean //для того что б не ругалось на мемо поле
)
with Index
(
  index01  = NRec(Unique, Surrogate),
  index02  = CATTRNAM,
  index03  = WTABLE + CREC + CATTRNAM
);
#IFDEF _GP_
#ELSE
Create view
#ENDIF
 Var
  pwTable, pAttrType  : word;
  pcAttrNam,
  pcRec      : comp;
  pName      : string;
  pCoTable, pSysNumKau   : word;
  pString    : string;      // "string-значение  атрибута",
  pDouble    : double;      // "double-значение  атрибута",
  pDate      : date;        // "date-значение атрибута",
  pTime      : time;        // "time-значение атрибута",
  pComp      : comp;        // "comp-значение атрибута",
  pBoolean   : boolean;
  Err, ErrBtr  : word;
  ErrMessage   : string ;
  NeedMessage  : boolean;   // выдавать сообщение об ошибке
  isCreateAttr : boolean;   // создавать атрибут в AttrNam если не найден

#IFDEF _GP_
  wXF_Code : word; // код таблицы
  wKodGroup: word; // код аналитики
  pAttrVal:comp;
Create view viExtAttr
#ELSE
#ENDIF

as select
#IFDEF _GP_
  AttrNam.Nrec
 ,AttrVal.NREC,AttrVal.WTABLE,AttrVal.CREC
 ,AttrVal.CATTRNAM
 ,AttrVal.VSTRING,AttrVal.VDOUBLE,AttrVal.VDATE,AttrVal.VTIME,AttrVal.VCOMP,AttrVal.VLONGINT
#ELSE
 *
#ENDIF
 from
      AttrNam,
      AttrVal,
      X$FILES(ReadOnly),
      KatKau(ReadOnly),
#IFDEF _GP_
#ELSE
      AttrNam AttrNamTmp,
#ENDIF
      AttrVal AttrValTmp,
      tmpAttrNam,
      tmpAttrVal,
      tmpAttrNam tmpAttrNam1
 where
  ((
        pwTable   == AttrNam.wTable
    and pName     == AttrNam.Name

    and pwTable   == AttrVal.wTable
    and pcRec     == AttrVal.cRec
    and pcAttrNam == AttrVal.cAttrNam

    and pwTable   == tmpAttrNam.wTable
    and pName     == tmpAttrNam.Name

    and pwTable   == tmpAttrVal.wTable
    and pcRec     == tmpAttrVal.cRec
    and pcAttrNam == tmpAttrVal.cAttrNam
#IFDEF _GP_
    and wXF_Code  == x$Files.xf$code
    and wKodGroup == KatKau.KodGroup
    and  pAttrVal == AttrValTmp.Nrec
#ENDIF
  ))
;
#IFDEF _GP_
create view vTmp
var
  pAttrNam:comp;
as select AttrNamTmp.Nrec
From
  AttrNam AttrNamTmp
where
((
     pAttrNam == AttrNamTmp.Nrec

));

#ENDIF

File MemoFile;
//bRealTbl - fakse указывает что работа ведется с временными таблицами, по умолчанию работаем по старому алгоритму.
Function InsAttr  (bRealTbl : boolean = true): word   ; forward;
Function FindID   (bRealTbl : boolean = true): boolean; forward;
Function FindValue(bRealTbl : boolean = true): boolean; forward;
#IFDEF _GP_
Function FindID_tmp   (bRealTbl : boolean = true): boolean; forward;
Function FindValue_tmp(bRealTbl : boolean = true): boolean; forward;
#ENDIF
Function SetValue (bRealTbl : boolean = true): boolean; forward;
Function CopyAttrVal ( _cAttrVal: comp; _cRecTo: comp ): word; forward;
var refAttrComp : AttrTablePick;  // для типа comp - вернуть строковое значение
var m_wInsertDbMode : boolean;

!------------------------------------------------------------------------------
!   Набор функций для создания атрибута, получения ID, показа ошибки
!------------------------------------------------------------------------------
// Возвращает ID атрибута по коду таблицы и наименованию. 0 - не найден
PUBLIC Function AttrID(_wTable : word; _Name : string): comp;
{
  result := 0;
  pwTable := _wTable;
  pName   := _Name;
  pAttrType :=0;

  if (FindID)
    result := pcAttrNam;
}
// Возвращает наименование атрибута по его ID (NRec)
PUBLIC Function AttrName(_cRec: comp): string;
{
  result := '';
#IFDEF _GP_
  vTmp.pAttrNam:=_cRec;
  vTmp._Loop AttrNamTmp
  {  result := vTmp.AttrNamTmp.Name;
     break;
  }
#ELSE
  if (GetFirst AttrNamTmp where ((_cRec == AttrNamTmp.nRec)) = tsOk)
    result := AttrNamTmp.Name;
#ENDIF
}
PUBLIC Function AttrTable(_cRec: comp): word;
{
  result := 0;
#IFDEF _GP_
  vTmp.pAttrNam:=_cRec;
  vTmp._Loop AttrNamTmp
  {  result := vTmp.AttrNamTmp.wTable;
     break;
  }
#ELSE
  if GetFirst AttrNamTmp where ((_cRec == AttrNamTmp.nRec)) = tsOk
    result := AttrNamTmp.wTable;
#ENDIF
}
// Возвращает тип атрибута по коду таблицы и нименованию. 13 - не найден
PUBLIC Function AttrType(_wTable : word; _Name : string): word;
{
  result := 13;
  pwTable := _wTable;
  pName   := _Name;
  pAttrType :=0;

  if (FindID)
    result := pAttrType;
}
// Возвращает true, если у записи с номером _cRec таблицы с кодом _wTable
// существует значение внешнего атрибута с именем _Name
PUBLIC function ValueExists(_wTable : word; _cRec: comp; _Name: string): boolean;
{
  result := false;
  pwTable := _wTable;
  pName   := _Name;
  pcRec   := _cRec;
  pAttrType := 0;

  if (FindID)
    result := getfirst ATTRVAL = tsOk;
}
// Возвращает true, если у записи с номером _cRec таблицы с кодом _wTable
// существует значение внешнего атрибута с номером _cAttrNam
PUBLIC function ValueExistsID(_wTable : word; _cRec: comp; _cAttrNam: comp): boolean;
{
  pwTable := _wTable;
  pcRec   := _cRec;
  pcAttrNam := _cAttrNam;
  pAttrType := 0;

  result := (getfirst ATTRVAL = tsOk);
}
// Удалить значение внешнего атрибута с именем _Name у у записи с номером _cRec
// таблицы с кодом _wTable
PUBLIC function DeleteValue(_wTable : word; _cRec: comp; _Name: string): integer;
{
  pwTable := _wTable;
  pName   := _Name;
  pcRec   := _cRec;
  pAttrType := 0;

  if(FindID)
  {
    if (GetFirst AttrVal <> tsOk)
      Exit;
    result := delete current ATTRVAL;
  }
  else
    result := tsOk;
}
// Удалить значение внешнего атрибута с номером _cAttrNam у записи с номером _cRec
// таблицы с кодом _wTable
PUBLIC function DeleteValueID(_wTable : word; _cRec: comp; _cAttrNam: comp): integer;
{
  pwTable := _wTable;
  pcRec   := _cRec;
  pcAttrNam  := _cAttrNam;
  pAttrType := 0;

  result := (getfirst ATTRVAL);
  if (result = tsOk)
    result := delete current ATTRVAL;
}
//возвращает ссылку на внешний атрибут если существует, если не найден - добавляет
Function CreateAttrEx(_wTable : word; _Name : string; _Type : word; bRealTbl : boolean = true): comp ;
{
  result := 0;
  pwTable   := _wTable;
  pName     := _Name;
  pAttrType := _Type;

  isCreateAttr  := true;
  if (FindId(bRealTbl))
  {
    if (bRealTbl)
      result := AttrNam.nRec;
    else
      result := tmpAttrNam.nRec;
  }

  isCreateAttr  := false;
}
PUBLIC Function CreateAttr(_wTable : word;_Name : string;_Type : word): comp ;
{
  result := CreateAttrEx(_wTable, _Name,_Type, m_wInsertDbMode);
}

// Выдать сообщение об ошибке
Public Procedure ShowError (_err : word);
{
  CASE _err OF
   1 :
     message ('Нет внешнего атрибута для таблицы с кодом ' + string(pwTable) + '. Наименование атрибута- ' + pName,Error);
   2 :
     message ('Не совпадает тип внешнего атрибута запрашиваемого и реального для таблицы с кодом ' + string(pwTable) + '. Наименование атрибута- ' + pName +
       ' Тип в таблице ' + string(AttrNam.AttrType) + '. Тип в функции ' + string(pAttrType) , Error);
   3 :
     message ('Не найдено значение внешнего атрибута для таблицы с кодом ' + string(pwTable) + '. Наименование  атрибута- ' + pName,Error);
   4 :
     message ('Физическая ошибка записи в AttrNam для таблицы с кодом ' + string(pwTable) + '. Наименование атрибута- ' + pName + '. Ошибка ' + string(errBtr),Error);
   5 :
     message ('Физическая ошибка записи в AttrVal для таблицы с кодом ' + string(pwTable) + '. Наименование атрибута- ' + pName + '. Ошибка ' + string(errBtr),Error);
   6 :
     message ('Недопустимый тип атрибута для таблицы с кодом ' + string(pwTable) + '. Наименование атрибута- ' + pName,Error);
   7 :
     message ('Физическая ошибка удаления записи в AttrVal для таблицы с кодом ' + string(pwTable) + '. Наименование атрибута- ' + pName + '. Ошибка ' + string(errBtr),Error);
   8 :
     message ('Неверный системный номер КАУ для таблицы с кодом ' + string(pwTable) + '. Наименование атрибута- ' + pName + '. Системный номер ' + string(pSysNumKau),Error);
   9 :
     message ('Неверный код КАУ(код таблицы) для таблицы с кодом ' + string(pwTable) + '. Наименование атрибута- ' + pName + '. Код КАУ ' + string(pCoTable),Error);
  10 :
     message ('Физическая ошибка удаления записи в AttrNam для таблицы с кодом ' + string(pwTable) + '. Наименование атрибута- ' + pName + '. Ошибка ' + string(errBtr),Error);
  END ;
}

// установка требования выдачи сообщения при ошибке; Возвращает предыдущее значение
PUBLIC function SetNeedMessage(_NeedMessage : boolean): boolean;
{
  result  := NeedMessage;
  NeedMessage := _NeedMessage;
}

// получить номер последней ошибки
PUBLIC Function LastError : word ;
{
  result := Err;
}


 // Создает внешний атрибут с типом Comp. Если существует - возвращает ссылку.
PUBLIC  Function CreateAttrCompEx(_wTable : word; _Name : string; _Type : word; _SysNumKau : word; _KodKau : word; bRealTbl : boolean = true): comp;
{
#IFDEF _GP_
  timelog('CreateAttrCompEx '+string(_wTable)+','+ _Name+','+string( _Type));
#ENDIF
  pwTable   := _wTable;
  pName     := _Name;
  pAttrType := _Type;
  pSysNumKau := _SysNumKau;
  pCoTable   := _KodKau;

  result := 0;
  case _SysNumKau of
    cgKatKau_Table, cgKatKau_User :
    {
#IFDEF _GP_
      set wKodGroup:=_KodKau;
      if (GetFirst FastFirstRow Katkau <> tsOk)
      //if (RecordExists Katkau<>tsok)
#ELSE
      if (GetFirst Katkau where ((_KodKau == KatKau.KodGroup)) <> tsOk)
#ENDIF
      {
        Err :=9;  if NeedMessage ShowError(Err); Exit;
      }
    }
    cgKatKau_System :
    {
#IFDEF _GP_
      wXF_Code:=_KodKau;
      if (GetFirst FastFirstRow x$Files  <> tsOk)
      //if not (RecordExists x$Files) <> tsOk
#ELSE
      if (GetFirst x$Files where ((_KodKau == x$Files.xf$code)) <> tsOk)
#ENDIF
      {
        Err :=9;  if NeedMessage ShowError(Err); Exit;
      }
    }
    else
    {
       Err :=8;  if NeedMessage ShowError(Err);  Exit;
    }
  end; // case
  isCreateAttr  := true;
#IFDEF _GP_
  timelog('CreateAttrCompEx isCreateAttr= '+string(isCreateAttr));
#ENDIF

  if (FindId(bRealTbl))
  {
    if (bRealTbl)
      result := AttrNam.nRec;
    else
      result := tmpAttrNam.nRec;
  }
#IFDEF _GP_
  timelog('CreateAttrCompEx result= '+string(result));
#ENDIF

  isCreateAttr  := false;
}

PUBLIC  Function CreateAttrComp(_wTable : word; _Name : string; _Type : word; _SysNumKau : word; _KodKau : word): comp;
{
  result := CreateAttrCompEx(_wTable, _Name, _Type, _SysNumKau, _KodKau, m_wInsertDbMode);
}

// Возвращает код КАУ по ID атрибута
PUBLIC Function AttrCompKodKau( _cAttrNam: comp): word;
{
  result := 0;
#IFDEF _GP_
  vTmp.pAttrNam:=_cAttrNam;
  vTmp._Loop AttrNamTmp
  {  result := vTmp.AttrNamTmp.rObject;
     break;
  }
#ELSE
  if (GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk)
    result := AttrNamTmp.rObject;
#ENDIF
}
// Возвращает системный номер КАУ по ID атрибута
PUBLIC  Function AttrCompSysNumKau(_cAttrNam: comp): word;
{
  result := cgKatKau_Error;
#IFDEF _GP_
  vTmp.pAttrNam:=_cAttrNam;
  vTmp._Loop AttrNamTmp
  {  result := vTmp.AttrNamTmp.rType;
     break;
  }
#ELSE
  if (GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk)
    result := AttrNamTmp.rType;
#ENDIF
}
!------------------------------------------------------------------------------
// Функции возвращают значение внешнего атрибута по коду таблицы, имени атрибута и nRec-ку записи
// для разных типов атрибута.
// sGetAttr - возвращает строку для всех типов, преобразовав тип в строку
!------------------------------------------------------------------------------
PUBLIC Function sGetAttr(_wTable : word; _cRec : comp; _Name : string): string ;
{
  pAttrType := cgAttrType_Str;
  pwTable := _wTable;
  pName   := _Name;
  pcRec   := _cRec;

  result :='';
  if (FindID)
    if (FindValue)
      result := pString;
}

PUBLIC Function doGetAttr(_wTable : word; _cRec : comp;_Name : string): double ;
{
  pAttrType := cgAttrType_Dbl ;
  pwTable := _wTable;
  pName   := _Name;
  pcRec   := _cRec;

  result :=0;
  if (FindID)
    if (FindValue)
      result := pDouble;
}

PUBLIC Function dGetAttr(_wTable : word; _cRec : comp; _Name : string): date ;
{
  pAttrType := cgAttrType_Date;
  pwTable := _wTable;
  pName   := _Name;
  pcRec   := _cRec;

  result := date(0,0,0);
  if (FindID)
    if (FindValue)
      result := pDate;
}

PUBLIC Function tGetAttr ( _wTable : word;  _cRec : comp; _Name : string ) : time ;
{
  pAttrType := cgAttrType_Time;
  pwTable := _wTable;
  pName   := _Name;
  pcRec   := _cRec;

  result := time(0,0,0,0);
  if (FindID)
    if (FindValue)
      result := pTime;
}

PUBLIC Function mGetAttr ( _wTable : word;  _cRec : comp; _Name : string ) : string ;
{
  pAttrType := cgAttrType_Memo;
  pwTable := _wTable;
  pName   := _Name;
  pcRec   := _cRec;

  result :='';
  if (FindID)
    if (FindValue)
      result := pString;
}

PUBLIC function coGetAttr(_wTable : word; _cRec : comp; _Name : string) : comp;
{
  pAttrType := cgAttrType_Comp;
  pwTable := _wTable;
  pName   := _Name;
  pcRec   := _cRec;

  result := 0;
  if (FindID)
    if (FindValue)
      result := pComp;
}

PUBLIC Function bGetAttr(_wTable : word; _cRec : comp;_Name : string): boolean ;
{
  pAttrType := cgAttrType_Bool ;
  pwTable := _wTable;
  pName   := _Name;
  pcRec   := _cRec;

  result := false;
  if (FindID)
    if (FindValue)
      result := pBoolean;
}


!------------------------------------------------------------------------------
// Функции возвращают значение внешнего атрибута по коду таблицы, коду атрибута и nRec-ку записи
// для разных типов атрибута.
// sGetAttrID - возвращает строку для всех типов, преобразовав тип в строку
!------------------------------------------------------------------------------
PUBLIC Function sGetAttrID(_wTable : word; _cRec : comp; _cAttrNam : comp): string ;
{
  pAttrType  := cgAttrType_Str;
  pwTable    := _wTable;
  pcRec      := _cRec;
  pcAttrNam  := _cAttrNam;

  result :='';
#IFDEF _GP_
  vTmp.pAttrNam:=_cAttrNam;
  vTmp._Loop AttrNamTmp
  {  pName := vTmp.AttrNamTmp.Name;
     if (FindID_tmp)
      if (FindValue_tmp)
        result := pString;
     break;
  }
#ELSE
  if GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk
  {
    pName := AttrNamTmp.Name;
    if (FindID)
      if (FindValue)
        result := pString;
  }
#ENDIF
}
PUBLIC Function doGetAttrID(_wTable : word; _cRec : comp; _cAttrNam : comp): double ;
{
  pAttrType  := cgAttrType_Dbl ;
  pwTable    := _wTable;
  pcRec      := _cRec;
  pcAttrNam  := _cAttrNam;

  result :=0;
#IFDEF _GP_
  /*
  vTmp.pAttrNam:=_cAttrNam;
  vTmp._Loop AttrNamTmp
  {  pName := vTmp.AttrNamTmp.Name;
     if (FindID_tmp)
      if (FindValue_tmp)
        result := pDouble;
     break;
  }
  */
  _Loop AttrVal
  { Result:=AttrVal.vDouble;
  }
#ELSE
  if GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk
  {
    pName := AttrNamTmp.Name;
    if (FindID)
      if (FindValue)
        result := pDouble;
  }
#endif
}

PUBLIC Function dGetAttrID(_wTable : word; _cRec : comp; _cAttrNam : comp): date ;
{
  pAttrType  := cgAttrType_Date;
  pwTable    := _wTable;
  pcRec      := _cRec;
  pcAttrNam  := _cAttrNam;

  result := date(0,0,0);
#IFDEF _GP_
  /*
  vTmp.pAttrNam:=_cAttrNam;
  vTmp._Loop AttrNamTmp
  {  pName := vTmp.AttrNamTmp.Name;
     if (FindID_tmp)
      if (FindValue_tmp)
        result := pDate;
     break;
  }
  */
  _Loop AttrVal
  { Result:=AttrVal.vDate;
    break;
  }

#ELSE
  if GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk
  {
    pName := AttrNamTmp.Name;
    if (FindID)
      if (FindValue)
        result := pDate;
  }
#ENDIF
}

PUBLIC Function tGetAttrID ( _wTable : word;  _cRec : comp; _cAttrNam : comp ) : time ;
{
  pAttrType  := cgAttrType_Time;
  pwTable    := _wTable;
  pcRec      := _cRec;
  pcAttrNam  := _cAttrNam;

  result := time(0,0,0,0);
#IFDEF _GP_
  /*
  vTmp.pAttrNam:=_cAttrNam;
  vTmp._Loop AttrNamTmp
  {  pName := vTmp.AttrNamTmp.Name;
     if (FindID_tmp)
      if (FindValue_tmp)
        result := pTime;
     break;
  }
  */
  _Loop AttrVal
  { Result:=AttrVal.vTime;
    break;
  }

#ELSE
  if (GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk)
  {
    pName := AttrNamTmp.Name;
    if (FindID)
      if (FindValue)
        result := pTime;
  }
#ENDIF
}

PUBLIC Function mGetAttrID ( _wTable : word;  _cRec : comp; _cAttrNam : comp ) : string ;
{
  pAttrType  := cgAttrType_Memo;
  pwTable    := _wTable;
  pcRec      := _cRec;
  pcAttrNam  := _cAttrNam;

  result :='';
#IFDEF _GP_
  vTmp.pAttrNam:=_cAttrNam;
  vTmp._Loop AttrNamTmp
  {  pName := vTmp.AttrNamTmp.Name;
     if (FindID_tmp)
      if (FindValue_tmp)
        result := pString;
     break;
  }
#ELSE
  if (GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk)
  {
    pName := AttrNamTmp.Name;
    if (FindID)
      if (FindValue)
        result := pString;
  }
#ENDIF
}

PUBLIC function coGetAttrID(_wTable : word; _cRec : comp; _cAttrNam : comp) : comp;
{
  pAttrType  := cgAttrType_Comp;
  pwTable    := _wTable;
  pcAttrNam  := _cAttrNam;
  pcRec      := _cRec;
  result := 0;
#IFDEF _GP_
  /*
  vTmp.pAttrNam:=_cAttrNam;
  vTmp._Loop AttrNamTmp
  {  pName := vTmp.AttrNamTmp.Name;
     if (FindID_tmp)
      if (FindValue_tmp)
        result := pComp;
     break;
  }
  */
  _Loop AttrVal
  { Result:=AttrVal.vComp;
    break;
  }

#ELSE
  if (GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk)
  {
    pName := AttrNamTmp.Name;
    if (FindID)
      if (FindValue)
        result := pComp;
  }
#ENDIF
}

function GetAttrValueStr(_wTable : word; _cRec : comp; _Name : string) : string;
{
  case AttrType(_wTable, _Name) of
    cgAttrType_Str  : Result :=         sGetAttr(_wTable, _cRec, _Name);
    cgAttrType_Dbl  : Result := string(doGetAttr(_wTable, _cRec, _Name));
    cgAttrType_Date : Result := string( dGetAttr(_wTable, _cRec, _Name));
    cgAttrType_Time : Result := string( tGetAttr(_wTable, _cRec, _Name));
    cgAttrType_Memo : Result :=         mGetAttr(_wTable, _cRec, _Name);
    cgAttrType_Comp : Result := string(coGetAttr(_wTable, _cRec, _Name));
    cgAttrType_Bool : Result := string(bGetAttr(_wTable, _cRec, _Name));
  else
                      Result := '';
  end;
}

function GetAttrValueStrID(_wTable : word; _cRec : comp; _cAttrNam : comp) : string;
{
#IFDEF _GP_
  vTmp.pAttrNam:=_cAttrNam;
  if vTmp.getfirst AttrNamTmp=tsok
    Result := GetAttrValueStr(_wTable, _cRec, vTmp.AttrNamTmp.Name)
#ELSE
  if (GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk)
    Result := GetAttrValueStr(_wTable, _cRec, AttrNamTmp.Name)
#ENDIF
  else
    Result := '';
}

PUBLIC Function bGetAttrID ( _wTable : word;  _cRec : comp; _cAttrNam : comp ) : boolean ;
{
  pAttrType  := cgAttrType_Bool;
  pwTable    := _wTable;
  pcRec      := _cRec;
  pcAttrNam  := _cAttrNam;

  result := false;
#IFDEF _GP_
  /*
  vTmp.pAttrNam:=_cAttrNam;
  vTmp._Loop AttrNamTmp
  {  pName := vTmp.AttrNamTmp.Name;
     if (FindID_tmp)
      if (FindValue_tmp)
        result := pBoolean;
     break;
  }
  */
  _Loop AttrVal
  { Result:=boolean( AttrVal.VLONGINT );
    break;
  }

#ELSE
  if (GetFirst AttrNamTmp where ((_cAttrNam == AttrNamTmp.nRec)) = tsOk)
  {
    pName := AttrNamTmp.Name;
    if (FindID)
      if (FindValue)
        result := pBoolean;
  }
#endif
}

!------------------------------------------------------------------------------
!   Набор функций для установки содержания внешних атрибутов для различных типов
// Функции устанавливает значение внешнего атрибута по коду таблицы, имени атрибута и nRec-ку записи
// для разных типов атрибута.
// Если атрибут не найден, то он создается
// Возвращает true - успешно, false - ошибка
!------------------------------------------------------------------------------
function sSetAttrEx(_wTable : word; _cRec : comp; _Name : string; _Val : string; bRealTbl : boolean = true) : boolean;
{
  pAttrType := cgAttrType_Str;
  pwTable   := _wTable;
  pName     := _Name;
  pcRec     := _cRec;
  pString   := _Val;
  result    := false;
  isCreateAttr  := true;
  if FindID(bRealTbl)
    if SetValue(bRealTbl)
      result := true;
  isCreateAttr  := false;
}

PUBLIC function sSetAttr ( _wTable : word; _cRec : comp; _Name : string; _Val : string) : boolean;
{
  result := sSetAttrEx(_wTable, _cRec, _Name, _Val, m_wInsertDbMode);
}

