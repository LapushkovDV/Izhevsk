{
  pAttrType := cgAttrType_Dbl ;
  pwTable   := _wTable;
  pName     := _Name;
  pcRec     := _cRec;
  pDouble   := _Val;
  result    := false;

  isCreateAttr  := true;
  if FindID(bRealTbl)
   if SetValue(bRealTbl)
     result := true;
  isCreateAttr  := false;
}

PUBLIC function doSetAttr(_wTable : word; _cRec : comp; _Name : string; _Val : double) : boolean;
