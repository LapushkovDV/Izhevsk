#ifndef __GP_MenuDynamic_VIH__
#define __GP_MenuDynamic_VIH__
#include AtlProtocol.vih

#component "GP_Common"

ObjInterface oGP_MenuDynamic;
  function AddItemToSubMenu(MenuID: tptr; subMenuTitle, newItemTitle: string; newItemCommand: longint): boolean;
end;
VipInterface GP_MenuDynamic implements oGP_MenuDynamic;

//Вызывается при нажатии кнопки "Добавить" утилиты "Регистрация дополнительных пунктов меню"
ExtensionPoint GP_MenuDynamic_AddItems;
ExtensionPoint GP_MenuDynamic_AddItemsWithLog(atlLog: IAtlProtocol);

//Вызывается при нажатии кнопки "Удалить" утилиты "Регистрация дополнительных пунктов меню"
ExtensionPoint GP_MenuDynamic_DelItems;

#endif
