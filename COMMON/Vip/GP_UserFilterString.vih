#ifndef __GP_UserFilterString_VIH__
#define __GP_UserFilterString_VIH__

#component "GP_Common"

#include GP_UserFilter.vih

const
  GP_UserFilterString_Match_Equal: byte = 0;
  GP_UserFilterString_Match_Like: byte = 1;
end;

vipinterface GP_UserFilterString Implements GP_IUserFilter;
public:
  constructor UserFilterString(NoField:longint; SaveName:string; sFilterString: string = '';
                               bMatch: byte = GP_UserFilterString_Match_Equal);
  property FilterString: String;
  property Match: byte;
end;

#endif
