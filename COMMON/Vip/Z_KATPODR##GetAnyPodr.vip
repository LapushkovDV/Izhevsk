#Component "Z_KatPodr"
Alter Interface GetAnyPodr doaccept, escclose, cyan;

create view
from
EXTCATLINKS,
catalogs
where ((

11 == EXTCATLINKS.OBJTYPE and
1 == EXTCATLINKS.MODTYPE and
katpodr.nrec == EXTCATLINKS.EXTCAT and
catalogs.nrec == EXTCATLINKS.STAFFCAT


));

 ExtendFormats DepartmentTree;

Tree 1 DepartmentTree (,hcSklLokMenVibSkl, sci1EnInsTree);
  show at (,3);
  table SPODR;
fields
  KATPODR.DTO      'Запрет выбора с' : [10], protect;
  KATPODR.LASTDATE 'В архиве с' : [10], protect;
  catalogs.datok 'Дата ликвидации ': [7], protect;
end;
end.
