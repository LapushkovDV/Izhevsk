#ifndef __GP_UserFilterDouble_VIH__
#define __GP_UserFilterDouble_VIH__

#component "GP_Common"

#include GP_UserFilter.vih

const
  GP_UserFilterDouble_Match_Equal    : byte = 0;
  GP_UserFilterDouble_Match_Less     : byte = 1;
  GP_UserFilterDouble_Match_LessEqual: byte = 2;
  GP_UserFilterDouble_Match_More     : byte = 3;
  GP_UserFilterDouble_Match_MoreEqual: byte = 4;
  GP_UserFilterDouble_Match_Between  : byte = 5;
end;

vipinterface GP_UserFilterDouble Implements GP_IUserFilter;
public:
  constructor UserFilterDouble(NoField:tptr; SaveName:string; doSum: double = 0; doSum2: double = 0;
                               bMatch: byte = GP_UserFilterDouble_Match_Equal);
  property Sum: Double;
  property Sum2: Double;
  property Match: byte;
end;

#endif
