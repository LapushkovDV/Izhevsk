#include AlgCalc.vih
#include oAlgFldSys.vih
#include TMnPlan.vih
#include oAlgInDocList.vih
#include Algor.vih
#include getsnote.vih
#include MsgSettings.vih

#component "M_MnPlan"
#doc
Наименование: Сообщение о закрытии периода и рассылка
<p>
#end

VipInterface Algoritm_6961_Setup Implements oAlgoritmSetup Parameters( nrecFormPl : comp);
Interface Algoritm_6961_Setup 'Настройка алгоритма 6961', EscClose, Blue;

Create view
Var
  nrecFormPl : Comp;
As Select
  Word(FormPl.descr)
From
  FormPl
Where
((
    nrecFormPl  == FormPl.NRec
))
;

Parameters
  nrecFormPl;

Function asInitInter(p_cFormPl : Comp) : Boolean;
{ #__UNUSED__(p_cFormPl)
  result := true;
}

Function asDoneInter : Boolean;
{
  result := true;
}

Procedure asOnCmSetDefault;
{}

Procedure asOnSetWayAccou(p_cWayAccou : Comp);
{ #__UNUSED__(p_cWayAccou) }

HandleEvent
cmInit:
{
  var _MsgSettings : MsgSettings ;
  _MsgSettings.ShowMessage(nrecFormPl, 1);
}
End;

End.
