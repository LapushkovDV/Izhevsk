#include TypeTbl.inc
#include R_Disp.vih
#include ExtAttr.vih
#include AttrTablePick.vih

#include GP_DocExtAttr.vih
interface GP_DocExtAttr 'Редактирование внешних атрибутов документа' Gray;
show(20,5,110,30);

#include ExtAttr.var
var CurWayAccou, CurMnPaln:comp;
    CurTypePlan:word;
    mCanEdit:boolean;
    iRARS:iRARSDisp;
    oAttrTablePick:AttrTablePick;

Function GetAValue: string; forward;

create view ltDocExtAttr
as select
  if(IsValidAll(tnAttrVal), GetAValue, '') (FieldName=sVal)
from
  GP_DocExtAttr,
  AttrNam, AttrVal
where((
  CurWayAccou==GP_DocExtAttr.cWayAccou and
  GP_DocExtAttr.cAttrNam==AttrNam.NRec and
  coMnPlan==AttrVal.wTable and CurMnPaln==AttrVal.cRec and
  GP_DocExtAttr.cAttrNam==AttrVal.cAttrNam
))
order by
  GP_DocExtAttr.Number;

Function GetAValue: string;
{
  case AttrNam.AttrType of
  //------------------------------------------------------------------------------
    cgAttrType_Dbl:
      GetAValue := if( AttrVal.vDouble < 0
                     , DoubleToStr(AttrVal.vDouble, '36666666666666667.89999999')
                     , DoubleToStr(AttrVal.vDouble, '66666666666666667.89999999')
                     )
  //------------------------------------------------------------------------------
    cgAttrType_Date:
      GetAValue := DateToStr(AttrVal.vDate, 'DD.MM.YYYY');
  //------------------------------------------------------------------------------
    cgAttrType_Time:
      GetAValue := TimeToStr(AttrVal.vTime, 'HH:MM');
  //------------------------------------------------------------------------------
    cgAttrType_Memo:
      GetAValue := 'мемо-поле (' +
                   if ( IsValid(tnAttrVal) AND (GetFieldFromMemo(0, 2, ftString, tnAttrVal) <> '')
                      , 'есть данные'
                      , 'нет данных'
                      ) + ')';
    cgAttrType_Switch:     // переключатель
      GetAValue := string(AttrVal.vComp);
  //------------------------------------------------------------------------------
    cgAttrType_Bool:
      GetAValue := if(AttrVal.vLongint = 0, 'нет', 'да');
  //------------------------------------------------------------------------------
    cgAttrType_Comp:
      GetAValue := oAttrTablePick.sGetValue(AttrVal.wTable, AttrVal.cAttrNam, AttrVal.cRec);
  //------------------------------------------------------------------------------
   else
     GetAValue := AttrVal.vString;
  end;
}

screen scTune(,,sci1Esc);
table GP_DocExtAttr;
buttons
  cmValue1,,,'Настройка отображения внешних атрибутов',,sci1Esc;
<<

 <.Настройка отображения внешних атрибутов.>
>>
end;

browse brDocExtAttr (,,sci1Esc);
table GP_DocExtAttr;
fields
  GP_DocExtAttr.Number '№':[3], Protect, NoAutoSize;
  GP_DocExtAttr.FrandlyName 'Наименование':[20], Protect;
  sVal 'Значение':[20], Protect;
end;

window WinMemoEdit 'Мемо-поле';
show(10,5,80,25);

Text
  MemoID = memAttrVal
  AttrVal.vLvar 'Значение атрибута';

Text
  MemoID = memAttrValView
  AttrVal.vLvar 'Значение атрибута' : Protect;

HandleEvent
cmInit:{
  if (mCanEdit) {
    SetFormat(memAttrVal);
    SetWindowTitle(WinMemoEdit, 'Редактирование поля '+GP_DocExtAttr.FrandlyName);
  } else {
    SetFormat(memAttrValView);
    SetWindowTitle(WinMemoEdit, 'Поле '+GP_DocExtAttr.FrandlyName);
  }
}
end;
end;//WinMemoEdit

constructor Init;
{
  if (not iRARS.IsAdminFunc()) {
    ShowButton(scTune, cmValue1, false);
    DisableCommand(cmValue1);
  }

  result:=true;
}

procedure RefreshFormat;
{
  if (IsValidAll(tnGP_DocExtAttr))
    SetFormat(brDocExtAttr)
  else
    SetFormat(scTune);
}

procedure SetCurDoc(TypePlan:word; cWayAccou, cMnPaln:comp);
{
  if (CurWayAccou<>cWayAccou) {
    set CurWayAccou:=cWayAccou;
    RefreshFormat;
  }

  CurTypePlan:=TypePlan;
  set CurMnPaln:=cMnPaln;

  ReReadRecord(tnGP_DocExtAttr);
}

procedure SetValFieldOpt;
{
  if (mCanEdit) {
    var IsProtect:boolean = AttrNam.AttrType=cgAttrType_Memo or
                            AttrNam.AttrType=cgAttrType_Bool or
                            AttrNam.AttrType=cgAttrType_Comp;
    ToggleFieldProtected(fnsVal, IsProtect);

    if (IsProtect)
      SetInputLineFlags(brDocExtAttr, fnsVal, inPickButton);

    if (AttrNam.AttrType=cgAttrType_Date)
      SetInputLineFlags(brDocExtAttr, fnsVal, inCalendarPick);

    if (IsProtect or AttrNam.AttrType=cgAttrType_Date)
      SetHelpAndStatusContext(brDocExtAttr, fnsVal, sci13Esc, hcKeepCurrent)
    else {
      SetInputLineFlags(brDocExtAttr, fnsVal, 0);
      SetHelpAndStatusContext(brDocExtAttr, fnsVal, sci1Esc, hcKeepCurrent);
    }
  } else {
    ToggleFieldProtected(fnsVal, true);

    if (AttrNam.AttrType=cgAttrType_Memo) {
      SetInputLineFlags(brDocExtAttr, fnsVal, inCalendarPick);
      SetHelpAndStatusContext(brDocExtAttr, fnsVal, sci13Esc, hcKeepCurrent);
    } else {
      SetInputLineFlags(brDocExtAttr, fnsVal, 0);
      SetHelpAndStatusContext(brDocExtAttr, fnsVal, sci1Esc, hcKeepCurrent);
    }
  }
}

procedure SetCanEdit(Val:boolean);
{
  if (mCanEdit=Val) exit;

  mCanEdit:=Val;
  SetValFieldOpt;
}

property CanEdit:boolean read mCanEdit write SetCanEdit(result);

procedure SaveAttrVal;
{
  if (not mCanEdit) exit;

  if (IsValidAll(tnAttrVal))
    update current AttrVal
  else {
    AttrVal.NRec:=0;
    AttrVal.wTable:=coMnPlan;
    AttrVal.cRec:=CurMnPaln;
    AttrVal.cAttrNam:=GP_DocExtAttr.cAttrNam;
    insert current AttrVal;
  }
}

TableEvent Table GP_DocExtAttr;
cmPositionChanged:{
  SetValFieldOpt;
}

cmExprFieldChanged:{


  if (Trim(ExprFieldValue)='') {
    if (IsValidAll(tnAttrVal)) {
      oExtAttr.DeleteValueID(coMnPlan, CurMnPaln, GP_DocExtAttr.cAttrNam);
      RescanPanel(tnGP_DocExtAttr);
    }

    exit;
  }

  var s, ErrStr:string = '';

  _try {
    case AttrNam.AttrType of
      cgAttrType_Str:{
        AttrVal.vString:=ExprFieldValue;
      }
      cgAttrType_Dbl:{
        ErrStr:='к числу';
        s:=Replace(ExprFieldValue, ',', '.');
        AttrVal.vDouble:=double(s);
      }
      cgAttrType_Date:{
        ErrStr:='к дате (формат ДД.ММ.ГГГГ)';
        s:=Replace(ExprFieldValue, '/', '.');
        s:=Replace(s, ',', '.');
        AttrVal.vDate:=StrToDate(s, 'DD.MM.YYYY');
        if (AttrVal.vDate=ZeroDate)
          AttrVal.vDate:=StrToDate(s, 'DD.MM.YY');
        if (AttrVal.vDate=ZeroDate)
          _raise ExNumberConvert;
      }
      cgAttrType_Time:{
        ErrStr:='ко времени (формат ЧЧ:ММ)';
        s:=Replace(ExprFieldValue, '/', ':');
        s:=Replace(s, '.', ':');
        AttrVal.vTime:=StrToTime(s, 'HH:MM');
        if (AttrVal.vTime=ZeroTime)
          _raise ExNumberConvert;
      }
    end;

    SaveAttrVal;
  }
  _except
    on ExNumberConvert: {
      message('Ошибка преобразования введенного значения '+ErrStr, error);
      abort;
    }
}
end;

HandleEvent
cmHotKeys:{
  PutHotCommand(RunMenu('GP_DocExtAttr_HotKeys'));
}
cmValue1:{
  RunInterface(GP_TuneDocExtAttr, CurTypePlan, CurWayAccou);

  ReReadRecord(tnGP_DocExtAttr);

  RefreshFormat;
}
cmPick:{
  if (CurField=fnsVal) {
    if (CurMnPaln=0) exit;
    if (AttrNam.AttrType<>cgAttrType_Memo and not mCanEdit) exit;

    if RunInterface('GP_CheckRoleStateVA',CurMnPaln,AttrNam.nrec)<>cmDefault then
     {
       message('Вам запрещено редактирование!');
       exit;
     }

    if (AttrNam.AttrType=cgAttrType_Comp)
      oAttrTablePick.PickValue(coMnPlan, GP_DocExtAttr.cAttrNam, CurMnPaln)
    else if (AttrNam.AttrType=cgAttrType_Memo) {
      if (not IsValidAll(tnAttrVal))
        SaveAttrVal;

      RunWindowModal(WinMemoEdit);

      SaveAttrVal;
    } else if (AttrNam.AttrType=cgAttrType_Date) {
      if (CheckFields)
        if (CalendarPick(AttrVal.vDate))
          SaveAttrVal;
    } else if (AttrNam.AttrType=cgAttrType_Bool) {
      AttrVal.vLongint:=AttrVal.vLongint xor 1;
      SaveAttrVal;
    }

    RescanPanel(tnGP_DocExtAttr);
  }
}
cmDelOnProtect:{
  if (CurField=fnsVal) {
    if (CurMnPaln=0 or not mCanEdit) exit;

    if RunInterface('GP_CheckRoleStateVA',CurMnPaln,AttrNam.nrec)<>cmDefault then
     {
       message('Вам запрещено редактирование!');
       abort;
       exit;
     }

    oExtAttr.DeleteValueID(coMnPlan, CurMnPaln, GP_DocExtAttr.cAttrNam);
    RescanPanel(tnGP_DocExtAttr);
  }
}
cmBeginFieldEdit:
 {
    if RunInterface('GP_CheckRoleStateVA',CurMnPaln,AttrNam.nrec)<>cmDefault then
     {
       message('Вам запрещено редактирование!');
       ToggleFieldProtected(fnsVal, true);
     }
    else
       ToggleFieldProtected(fnsVal, false);

 }

end;
end.

GP_DocExtAttr_HotKeys Menu
{
  - 'Настройка отображения внешних атрибутов',cmValue1, 'Настройка отображения внешних атрибутов',hcNoContext,,,sci1Esc,,,, bmpDopInfo;
}
