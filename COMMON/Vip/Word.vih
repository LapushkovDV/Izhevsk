ObjInterface com_Application( comIDispatch );
// #docl Объектный интерфейс com_Application </brief>
  property  Documents// #docl Дополнительная документация отсутствует. </brief>
                      : comDocuments Read;
  property  ActiveDocument// #docl Дополнительная документация отсутствует. </brief>
                           : coDocument Read;
  property  Visible// #docl Дополнительная документация отсутствует. </brief>
                    : boolean Read Write;
  property  Version// #docl Дополнительная документация отсутствует. </brief>
                    : string Read;
  procedure Quit  // #docl  Комментарии отсутствуют. </brief>
                   ( SaveChanges // #docl Тип параметра: входной.
                   : WdSaveOptions ; OriginalFormat // #docl Тип параметра: входной.
                   : WdOriginalFormat ; RouteDocument // #docl Тип параметра: входной.
                   : boolean = false);
  function  Run  // #docl  Комментарии отсутствуют. </brief>
                  ( MacroName // #docl Тип параметра: входной.
                  : string; varg1 // #docl Тип параметра: входной.
                  : variant='' ; varg2 // #docl Тип параметра: входной.
                  : variant='' ; varg3 // #docl Тип параметра: входной.
                  : variant='' ; varg4 // #docl Тип параметра: входной.
                  : variant='' ; varg5 // #docl Тип параметра: входной.
                  : variant='' ; varg6 // #docl Тип параметра: входной.
                  : variant='' ; varg7 // #docl Тип параметра: входной.
                  : variant='' ; varg8 // #docl Тип параметра: входной.
                  : variant='' ; varg9 // #docl Тип параметра: входной.
                  : variant='' ; varg10 // #docl Тип параметра: входной.
                  : variant='' ; varg11 // #docl Тип параметра: входной.
                  : variant='' ; varg12 // #docl Тип параметра: входной.
                  : variant='' ; varg13 // #docl Тип параметра: входной.
                  : variant='' ; varg14 // #docl Тип параметра: входной.
                  : variant='' ; varg15 // #docl Тип параметра: входной.
                  : variant='' ; varg16 // #docl Тип параметра: входной.
                  : variant='' ; varg17 // #docl Тип параметра: входной.
                  : variant='' ; varg18 // #docl Тип параметра: входной.
                  : variant='' ; varg19 // #docl Тип параметра: входной.
                  : variant='' ; varg20 // #docl Тип параметра: входной.
                  : variant='' ; varg21 // #docl Тип параметра: входной.
                  : variant='' ; varg22 // #docl Тип параметра: входной.
                  : variant='' ; varg23 // #docl Тип параметра: входной.
                  : variant='' ; varg24 // #docl Тип параметра: входной.
                  : variant='' ; varg25 // #docl Тип параметра: входной.
                  : variant='' ; varg26 // #docl Тип параметра: входной.
                  : variant='' ; varg27 // #docl Тип параметра: входной.
                  : variant='' ; varg28 // #docl Тип параметра: входной.
