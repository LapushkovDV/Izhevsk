                    : comRange Read;
  property  _ReadOnly// #docl Дополнительная документация отсутствует. </brief>
                      : boolean Read;
  procedure Close  // #docl  Комментарии отсутствуют. </brief>
                    ( SaveChanges // #docl Тип параметра: входной.
                    : pointer ; OriginalFormat // #docl Тип параметра: входной.
                    : pointer ; RouteDocument // #docl Тип параметра: входной.
                    : pointer  );
  procedure _Save  // #docl  Комментарии отсутствуют. </brief>
                   ;
  function  Range  // #docl  Комментарии отсутствуют. </brief>
                    : comRange; // #docl Результат типа comRange
  procedure Activate  // #docl  Комментарии отсутствуют. </brief>
                      ;
  procedure UndoClear  // #docl  Комментарии отсутствуют. </brief>
                       ;
