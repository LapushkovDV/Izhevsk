                     ( FileName // #docl Тип параметра: входной.
                     : pointer ; FileFormat // #docl Тип параметра: входной.
                     : pointer ; LockComments // #docl Тип параметра: входной.
                     : pointer ; Password // #docl Тип параметра: входной.
                     : pointer ; AddToRecentFiles // #docl Тип параметра: входной.
                     : pointer ; WritePassword // #docl Тип параметра: входной.
