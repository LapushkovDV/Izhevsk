  wdUnderlineWavy = 11;
  wdUnderlineWavyHeavy = 27;
  wdUnderlineDottedHeavy = 20;
  wdUnderlineDashHeavy = 23;
  wdUnderlineDotDashHeavy = 25;
  wdUnderlineDotDotDashHeavy = 26;
  wdUnderlineDashLong = 39;
  wdUnderlineDashLongHeavy = 55;
  wdUnderlineWavyDouble = 43;
end;

