  //************************************************
  function GetBoundConst (arwNumber: word;_TypeOwn:word): word; cacheable;
  {
    var vwResult: word;
    vwResult := word(0);

    case (arwNumber) of
      word(37): vwResult := cgCommisDoverManual;
    end; // case
    GetBoundConst := vwResult;
  } // function GetBoundConst

  //************************************************
  // Добавляет запись в массив aFeeSigners
  function AddRole(_NRec: Byte; _Code: String; _Name: String): Boolean;
  begin
    result := false;
    ClearBuffer(#SRoles);
    SRoles.NRec := _NRec;
    SRoles.Code := _Code;
    SRoles.Name := _Name;
    if insert current SRoles != tsOk then
    begin
      Message('Ошибка: не удалось добавить запись в таблицу SRoles');
      exit;
    end;
    result := true;
  end;

