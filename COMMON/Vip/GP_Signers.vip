/*
Падежи:
 1 Именительный (Кто? Что?)
 2 Родительный (Нет Кого? Чего?)
 3 Дательный (Дать Кому? Чему?)
 4 Винительный (Винить Кого? Что?)
 5 Творительный (Доволен Кем? Чем?)
 6 Предложный (Думать О ком? О чём? В ком? В чём? Где?)
*/
#include GP_Signers.vih
#include FeeSigners.Vih
#include AppFuncs.vih
#include GP_StrFunc.vih
//#include GP_Log.vih
#include PostInPaternal.vih // Должность в род.и дат. падеже
#include CatFunc.vih // Функции работы с Catalogs

//************************************************
Interface GP_Signers;
//************************************************

  const
    REC_TYPE_FIO = 1; // Фамилия Имя Отчество
    REC_TYPE_SHORT_FIO = 2; // Фамилия И.О.
    REC_TYPE_POSITION = 3; // Должность
    FULL_FIO = 0; // Фамилия Имя Отчество
    SHORT_FIO_ALIGN_RIGHT = 1; // Фамилия с инициалами, инициалы справа
    SHORT_FIO_ALIGN_LEFT = 2; // Фамилия с инициалами, инициалы слева
  end;
  //************************************************
  function GetBoundConst (arwNumber: word; _TypeOwn:word): word; forward;
  //************************************************

  #include FeeSigners.inc

  var boMes:boolean;//выдавать сообщения

 //************************************************
   table struct SRoles
  (
    NRec: Byte,
    Code: String[20],
    Name: String[30]
  )
  With index
  (
    SRoles01 = NRec,
    SRoles02 = Code,
    SRoles03 = Name
  );

  //************************************************
  table struct SSigners
  (
    NRec: Word,
    SignerType: Byte, // Тип (0 - собственный, 1 - сторонний) 
    cPerson: tNRec,
    cMnSpAdd: tNRec,
    TypeOwn : Word,
    TabN: String[20],
    cRole: Byte,
    cKatOrg: tNRec
  )
  With index
  (
    SSigners01 = NRec,
    SSigners02 = cRole
  );

  //************************************************
  table struct SNames
  (
    cSSigners: Word,
    RecType: Byte,
    NCase: Byte,
    Name: String[100]
  )
  With index
  (
    SNames01 = cSSigners + RecType + NCase
  );

  //************************************************
  create view
  //************************************************
  var
    pSigner:Comp;
    pCurApp:comp;
    sFIO   :string;
    pKatOrg:comp;
  as select SSigners.Nrec
  from
      Appointments,
      SSigners (SSigners02),
      SNames (SNames01),
      SRoles (SRoles02),
      SelPicks,
      MnSpAdd,
      PersPod,
      PersPod PersPodDover,
      KatOrg,
      Persons,
      synonym SNames SNamesL
  where ((
      pSigner        == SelPicks.NRec
  and SelPicks.cRec  == MnSpAdd.NRec
  and MnSpAdd.cOwner == PersPod.NRec
  // доверенность
  and GetBoundConst(word(37), SSigners.TypeOwn) == PersPodDover.TipMode (NoIndex)
  and SSigners.cMnSpAdd/*KatSigner.Nrec*/     == PersPodDover.cPersons

  and pCurApp        == Appointments.NRec
  and 'С'            == Persons.IsEmployee
  and sFIO           == Persons.FIO
  and pKatOrg        == KatOrg.Nrec
   ));

  //************************************************
  #include FeeSigners.var
  #include GP_StrFunc.var
  //#include GP_Log.var

 //************************************************
   var
    ConstRep: Word;
    FeeSignersGroup: String;
    TagRep: String;
    OnDate: Date;
    cCurRole: Byte;
    IsCurSignerValid: Boolean;
    vAppFuncs: AppointmentsFunctions;
    IPostInP: PostInPaternal;
    ICatFunc: CatalogsFunctions;

  //************************************************
  Window winParam 'Подписи' DoAccept, EscClose, Gray;
    Show at (,, 63, 5);

    screen scrParam ('',, sci1EnEsc);
    fields
      FeeSignersGroup ('Группа подписантов',, sci13EnEsc): Protect, PickButton;
    Buttons
      cmOk,,, 'Ввод - принять выбор',,sci1Esc;
      cmCancel,,, 'Отмена',,sci1Esc;
    <<

`Группа подписантов:`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

                    <.  ~O~K  .><.О~т~мена.>

    >>
    end;

    HandleEvent
      cmOk:
        PutCommand(cmDefault);
    end;
  end;
  
