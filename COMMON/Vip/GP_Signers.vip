  // Возвращает для текущего подписанта роль
  function GetRoleByCode(_RoleCode: String): Byte;
  begin
    if getFirst SRoles where ((_RoleCode == SRoles.Code)) = tsOk then
      result := SRoles.NRec
    else
      result := 0;
  end;

  // Возвращает для текущего подписанта роль
  function GetRoleByName(_RoleName: String): Byte;
  begin
    if getFirst SRoles where ((_RoleName == SRoles.Name)) = tsOk then
      result := SRoles.NRec
    else
      result := 0;
  end;

  // Добавляет запись в массив aFeeSigners
  function AddSigner(_TabN: String; _cSigner: tNRec; _cRole: Byte): Boolean;
  begin
    result := false;
    ClearBuffer(#SSigners);
    if getFirst SelPicks where ((_cSigner == SelPicks.NRec)) = tsOk then
      if getFirst MnSpAdd where ((SelPicks.cRec == MnSpAdd.NRec)) = tsOk then
      begin
        SSigners.cPerson := MnSpAdd.cOwner;
        SSigners.cMnSpAdd:= MnSpAdd.Nrec;
        SSigners.typeOwn := MnSpAdd.typeOwn;//для доверенностей нужно
        if MnSpAdd.typeOwn = 115 then // toPersPod = 115
        begin
          SSigners.SignerType := 1;
          if getFirst PersPod where ((MnSpAdd.cOwner == PersPod.NRec)) = tsOk then
            SSigners.cKatOrg := PersPod.GalDep;
        end;
      end;
    SSigners.NRec := RecordsInTable(#SSigners);
    SSigners.TabN := _TabN;
    SSigners.cRole := _cRole;
    if insert current SSigners != tsOk then
    begin
      Message('Ошибка: не удалось добавить запись в таблицу SSigners');
      exit;
    end;
    result := true;
  end;

  // Добавляет запись в массив aFeeSigners
  function AddName(_RecType: Byte; _NCase: Byte; _Name: String): Boolean;
  begin
    result := false;
    ClearBuffer(#SNames);
    SNames.cSSigners := SSigners.NRec;
    SNames.RecType := _RecType;
    SNames.NCase := _NCase;
    SNames.Name := Trim(_Name);
    if insert current SNames != tsOk then
    begin
      Message('Ошибка: не удалось добавить запись в таблицу SName');
      exit;
    end;
    result := true;
  end;

  function GetName(_RecType: Byte; _NCase: Byte): String;
  begin
    result := '';
    if getFirst SNamesL where ((
          SSigners.NRec == SNamesL.cSSigners
      and _RecType      == SNamesL.RecType
      and _NCase        == SNamesL.NCase
    )) = tsOk then
      result := SNamesL.Name;
  end;

  // Ищет назначение работника на дату отчёта
  function LocateAppointment(_cPerson: tNRec): Boolean;
  begin
    result := false;
    pCurApp := vAppFuncs.GetAppNRec_OnDate(_cPerson, OnDate);
    if GetFirst Appointments /*where ((_cCurApp == Appointments.NRec))*/ = tsOk then
      result := true;
  end;

  // Пытается заполнить Фамилию и Должность во всех остальны падежах на основании первого,
  // если они не заполнены
  procedure CheckSignerNames;
  var
    _Name1: String;
    _FIO: String;
  begin
    // Фамилия Имя Отчество
    _Name1 := '';
    _loop SNames where ((SSigners.NRec == SNames.cSSigners and REC_TYPE_FIO == SNames.RecType))
    begin
      if SNames.NCase = 1 then
      begin
        _Name1 := SNames.Name;
        continue;
      end;
      if SNames.Name = '' then
        if _Name1 != '' then
        begin
          SNames.Name := OGP_SF.FIODecl(SSigners.cPerson, _Name1, SNames.NCase);
          if update current SNames = tsOk then
          begin
          end;
        end;
    end;
    // Фамилия с инициалами
    _loop SNames where ((SSigners.NRec == SNames.cSSigners and REC_TYPE_SHORT_FIO == SNames.RecType))
    begin
      if SNames.Name = '' then
      begin
        _FIO := GetName(REC_TYPE_FIO, SNames.NCase);
        if _FIO != '' then
        begin
          SNames.Name := OGP_SF.ShortFIO(_FIO, SHORT_FIO_ALIGN_RIGHT);
          if update current SNames = tsOk then
          begin
          end;
        end;
      end;
    end;
    // Должности
    _Name1 := '';
    _loop SNames where ((SSigners.NRec == SNames.cSSigners and REC_TYPE_POSITION == SNames.RecType))
    begin      
      if SNames.NCase = 1 then
      begin
        // Если должность в именительном падеже не заполнена
        if SNames.Name = '' then
          // Подставляем должность на текущую дату
          if LocateAppointment(SSigners.cPerson) then
          begin
            SNames.Name := ICatFunc.GetCatalogsName(Appointments.Post);
            if update current SNames = tsOk then
            begin
            end;
          end;
        _Name1 := SNames.Name;
        continue;
      end;
      if SNames.Name = '' then
        if _Name1 != '' then
        begin
          // Родительний или дательный
          if SNames.NCase = 2 or SNames.NCase = 3 then
            SNames.Name := IPostInP.PostInP(_Name1, SNames.NCase)
          else
            // Винительный, Творительный и Предложный
            if SNames.NCase = 4 or SNames.NCase = 5 or SNames.NCase = 5 then
              // Так как PostInPaternal не поддерживает эти падежи, пробуем преобразовать
              // с помощью функции склонения фамилии
              SNames.Name := OGP_SF.FIODecl(0, _Name1, SNames.NCase)
            else
              // Именительный
              SNames.Name := _Name1;
          if update current SNames = tsOk then
          begin
          end;
        end;
    end;
  end;

  // Заполняет массив aFeeSigners
  function LoadSigners: Boolean;
  var
    I: Word;
  begin
    result := false;
    if FeeSignersGroup = '' then
      exit;
    iFeeSigners.FindFeeSignersByName(ConstRep, FeeSignersGroup);
    if iFeeSigners.FeeSignersIsValid then
    begin
      if delete all from SSigners != tsOk then
      begin
        Message('Ошибка: не удалось очистить SSigners');
        exit;
      end;
      if delete all from SNames != tsOk then
      begin
        Message('Ошибка: не удалось очистить SNames');
        exit;
      end;
      // TestFeeSigners;
      if iFeeSigners.GetSignerFirst then
        do
        begin
          if not AddSigner(iFeeSigners.GetSignerTabN, iFeeSigners.GetSignerNRec, GetRoleByName(iFeeSigners.GetSignerRole)) then
            exit;
          for (I := 1; I <= 6; I++)
          begin
            if not AddName(REC_TYPE_FIO, I, iFeeSigners.GetSignerFIO(I)) then
              exit;
            if not AddName(REC_TYPE_SHORT_FIO, I, iFeeSigners.GetSignerFIO(I + 6)) then
              exit;
            if not AddName(REC_TYPE_POSITION, I, iFeeSigners.GetSignerPosition(I)) then
              exit;
          end;
        end while iFeeSigners.GetSignerNext;
      result := true;
    end;
    _loop SSigners
    begin
      CheckSignerNames;
    end;
  end;

  // Инициализация
  // _ConstRep - код группы отчётов (константа cgReport_XXXX)
  // _TagRep - код отчёта
  // SelGroup - если true, при инициализации показывается диалог выбора группы подписантов
  // _OnDate - дата, на которую берётся должность, если она не заполнена
  function Init(_ConstRep: Word; _TagRep: String; SelGroup: Boolean;
         _OnDate: Date = ZeroDate; _boMes:boolean=True): Boolean;
  var
    DSKVarName: String;
  begin

    result := False;
    boMes:=_boMes;
    ConstRep := _ConstRep;
    TagRep := _TagRep;
    if _OnDate != ZeroDate then
      OnDate := _OnDate
    else
      OnDate := Cur_Date;
    cCurRole := 0;
    FeeSignersGroup := '';
    IsCurSignerValid := false;
    iFeeSigners.InitFeeSigners(ConstRep);
    // Считываем имя группы подписантов из DSK файла
    DSKVarName := 'FeeSigners_' + To_Char(ConstRep) + '_' + TagRep;
    if not ReadMyDsk(FeeSignersGroup, DSKVarName, true) then
      FeeSignersGroup := '';
    // При необходимости вызываем диалог выбора группы подписантов
    if SelGroup then
    begin
      if RunWindowModal(winParam) = cmDefault then
      begin
        SaveMyDsk(FeeSignersGroup, DSKVarName);
        result := True;
        LoadSigners;
      end else
        result := False;
    end else
    begin
      result := True;
      LoadSigners;
    end;
  end;
  
  // Позиционирует курсор на первого подписанта 
  // если нет ни одного подписанта, возвращает false
  // Если передан параметр _RoleCode устанавливается фильтр по роли с этим кодом
  function GetFirst(_RoleCode: String = ''): Boolean;
  begin
    if _RoleCode != '' then
    { cCurRole := GetRoleByCode(_RoleCode);
      if cCurRole=0
        cCurRole := GetRoleByName(_RoleCode);
    }
    if cCurRole <> 0 then
    begin
      IsCurSignerValid := getFirst SSigners where ((cCurRole == SSigners.cRole)) = tsOk;
    end else
    begin
      IsCurSignerValid := getFirst SSigners = tsOk;
      if boMes
         Message('Не найдена роль подписанта с кодом "' + _RoleCode + '"');
    end;
    result := IsCurSignerValid;
  end;

  // Позиционирует курсор на следующего подписанта
  // если больше нет записей, возвращает false
  // Если передан параметр _RoleCode устанавливается фильтр по роли с этим кодом
  function GetNext: Boolean;
  begin
    if cCurRole != 0 then
      IsCurSignerValid := getNext SSigners where ((cCurRole == SSigners.cRole)) = tsOk
    else
      IsCurSignerValid := getNext SSigners = tsOk;
    result := IsCurSignerValid;
  end;

  // Позиционируется на подписанта с заданным номером (нумерация начинается с 1)
  function GoTo(_Index: Word): Boolean;
  begin
    if getNext SSigners where ((_Index == SSigners.NRec)) = tsOk then
      result := true
    else
      result := false;
  end;

  // Возвращает количество подписантов
  function Count: Word;
  begin
    result := RecordsInTable(#SSigners);
  end;

  // Возвращает для текущего подписанта ссылку на таблицу Persons
  function GetcPerson: tNRec;
  begin
    if IsCurSignerValid then
      result := SSigners.cPerson
    else
      result := 0;
  end;

  // Возвращает для текущего подписанта табельный номер
  function GetTabN: String;
  begin
    if IsCurSignerValid then
      result := SSigners.TabN
    else
      result := '';
  end;

  // Возвращает для текущего подписанта тип (0 - собственный, 1 - сторонний)
  function GetType: Byte;
  begin
    if IsCurSignerValid then
      result := SSigners.SignerType
    else
      result := 0;
  end;

  // Возвращает для текущего подписанта NRec организации (если он сторонний)
  function GetOrg: tNRec;
  begin
    if IsCurSignerValid then
      result := SSigners.cKatOrg
    else
      result := 0;
  end;

  // Возвращает для текущего подписанта наименование организации (если он сторонний)
  function GetOrgName: String;
  begin
    result := '';
    if IsCurSignerValid then
      if SSigners.SignerType = 1 then
      { pKatOrg:=SSigners.cKatOrg;
        if getFirst KatOrg /*where ((SSigners.cKatOrg == KatOrg.NRec))*/ = tsOk then
          result := KatOrg.Name
      }
  end;

  // Возвращает для текущего подписанта фамилию, имя и отчество
  // _NCase - падеж
  // _FIOType - тип:
  //  0 Фамилия Имя Отчество
  //  1 Фамилия с инициалами, инициалы слева
  //  2 Фамилия с инициалами, инициалы справа
  //  101 - Доверенность
  //      'F_COMMON::FEESIGNERS.WIEDITSELECTION.SCSIGNERINFO.F_COMMON::ISIGNERINFO.SCSIGNERINFO.DOVER'
  function GetFIO(_NCase: Byte = 1; _FIOType: Byte = 0): String;
  var
    P: Byte;
 {
    result := '';
    timelog('GP_Signers->GetFIO:_NCase='+String(_NCase)+', _FIOType='+string(_FIOType));

    if IsCurSignerValid then
    {  if _FIOType=101
      { timelog('GP_Signers->GetFIO:_FIOType=101, SSigners.cMnSpAdd= '+String(SSigners.cMnSpAdd,0,0)
         +', SSigners.typeOwn='+string(SSigners.typeOwn)      );

        Result:=sGetAttr(coMnSpAdd,SSigners.cMnSpAdd , 'Доверенность');
        if Result=''
         if getfirst PersPodDover=tsok
           Result:=PersPodDover.Fio;
        Exit;
      } //if _FIOType=101
      if _FIOType = FULL_FIO then
      { result := GetName(REC_TYPE_FIO, _NCase);
      }
      else
      {
        result := GetName(REC_TYPE_SHORT_FIO, _NCase);
        if _FIOType = SHORT_FIO_ALIGN_LEFT then
        {
          P := InStr(' ', result);
          if P > 0 then
            result := Trim(SubStr(result, P + 1, Length(result) - P)) + ' ' + SubStr(result, 1, P - 1);
        }
      } //if _FIOType = FULL_FIO then
    } //if IsCurSignerValid then
 } //  function GetFIO(_NCase: Byte = 1; _FIOType: Byte = 0): String;

  // Возвращает для текущего подписанта должность
  // NCase - падеж
  function GetPosition(_NCase: Byte = 1): String;
  begin
    result := '';
    if IsCurSignerValid then
      result := GetName(REC_TYPE_POSITION, _NCase);
  end;

  // Возвращает для текущего подписанта NRec подразделения
  function GetDepNRec: Comp;
  begin
    result := '';
    if IsCurSignerValid then
      if LocateAppointment(SSigners.cPerson) then
        result := Appointments.Department;
  end;

  // Возвращает для текущего подписанта код подразделения
  function GetDepCode: String;
  begin
    result := '';
    if IsCurSignerValid then
      if LocateAppointment(SSigners.cPerson) then
        result := ICatFunc.GetCatalogsCode(Appointments.Department);
  end;

  // Возвращает для текущего подписанта наименование подразделения
  function GetDepName: String;
  begin
    result := '';
    if IsCurSignerValid then
      if LocateAppointment(SSigners.cPerson) then
        result := ICatFunc.GetCatalogsName(Appointments.Department);
  end;

  // Возвращает для текущего подписанта код роли
  function GetRoleCode: String;
  begin
    result := '';
    if IsCurSignerValid then
      if getFirst SRoles where ((SSigners.cRole == SRoles.NRec)) = tsOk then
        result := SRoles.Code
  end;

  // Возвращает для текущего подписанта наименование роли
  function GetRoleName: String;
  begin
    result := '';
    if IsCurSignerValid then
      if getFirst SRoles where ((SSigners.cRole == SRoles.NRec)) = tsOk then
        result := SRoles.Name;
  end;

  // Добавляет запись в массив aFeeSigners
  procedure Add(_FIO: String; _TabN: String; _cPerson: tNRec; _Position: String; _RoleCode: String);
  var
    I: Byte;
  begin
    if AddSigner(_TabN, _cPerson, GetRoleByCode(_RoleCode)) then
    begin
      for (I := 1; I <= 6; I++)
      begin
        if not AddName(REC_TYPE_FIO, I, if(I = 1, _FIO, '')) then
          exit;
        if not AddName(REC_TYPE_SHORT_FIO, I, '') then
          exit;
        if not AddName(REC_TYPE_POSITION, I, if(I = 1, _Position, '')) then
          exit;
      end;
      CheckSignerNames;
    end;
  end;

  // Добавляет директора из общесистемной настройки в массив aFeeSigners
  procedure AddBoss;
  begin
    Add(sGetTune('BOSS'), 0, coGetTune('BOSS'), '', 'Direct');
  end;

  // Добавляет главного бухгалтера из общесистемной настройки в массив aFeeSigners
  procedure AddMainBuh;
  begin
    Add(sGetTune('MAINBUH'), 0, coGetTune('MAINBUH'), '', 'GlBux');
  end;

  // Возвращает Фамилию Имя Отчество текущего пользователя
  // (из настройки "Общие настройки системы \ Фамилия Имя Отчество")
  function GetCurUserFIO(_NCase: Byte = 1; _FIOType: Byte = 0): String;
  begin
    result := sGetTune('USER.FIO');
    if _NCase != 1 then
      result := OGP_SF.FIODecl(GetCurUserPerson, result, _NCase);
    if _FIOType = SHORT_FIO_ALIGN_RIGHT or _FIOType = SHORT_FIO_ALIGN_LEFT then
      result := OGP_SF.ShortFIO(result, _FIOType);
  end;

  // Возвращает должность текущего пользователя на указанну дату в указанном падеже
  function GetCurUserPosition(_NCase: Byte = 1; _OnDate: Date = ZeroDate): String;
  var
    _cPerson: tNRec;
  begin
    result := '';
    _cPerson := GetCurUserPerson;
    if _cPerson != 0 then
      result := oGP_SF.GetPersPost(_cPerson, _NCase, if(_OnDate != ZeroDate, _OnDate, OnDate));
  end;

  // Возвращает ссылку на карточку текущего пользователя (Persons.NRec)
  function GetCurUserPerson: tNRec;
  var
    _FIO: String;
  begin
    result := coGetTune('USER.PERSON');
    if Result=0
    { sFIO := sGetTune('USER.FIO');
      // Пробуем найти карточку сотрудника с такой фамилией именем и отчеством
      // (обработка на случай, если таких сотрудников найдётся несколько, пока не предусмотрена)
      if getFirst Persons where (('С'  == Persons.IsEmployee and _FIO == Persons.FIO)) = tsOk then
        result := Persons.NRec;
    }
  end;

  HandleEvent
    cmOnVipLoad:
      begin
        // oGP_Log.Init('GP_Signers.log', true, true, true);
        timelog_init;
        timelog('GP_Signers->cmOnVipLoad');
        ConstRep := 0;
        boMes:=True;
        FeeSignersGroup := '';
        TagRep := '';
        OnDate := Cur_Date;
        cCurRole := 0;
        IsCurSignerValid := false;
        InitRoles;
      end;
    // cmOnVipUnLoad:
    //  oGP_Log.Done(true);
    cmPick:
      case CurField of
        #FeeSignersGroup:
          begin
            if iFeeSigners.RunMainWindow(1) then
              set FeeSignersGroup := iFeeSigners.GetFeeSignersName;
          end;
      end;
    cmDelOnProtect:
      case CurField of
        #FeeSignersGroup:
          set FeeSignersGroup := '';
      end;
  end;

end.
