/*************************************************************************************************\
* Наименование: Импорт сальдо по контрагентам 60,62 из Excel                                      *
* Контур/Модуль: КОУ                                                                              *
* Примечание:  Добавлено поле IEINCFLD2.VALUE 'Поле БД' для составления Альбома форматов          *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3508         |24/10/18|Шунин А.Г.               |НПО Энергомаш                    *
\*************************************************************************************************/

#component "C_ExpImp"
Alter Interface ieSettings;
Create View
As Select IEINCFLD2.VALUE
From IEINCFLD IEINCFLD2
where
((
  IEHFlds.Code == IEINCFLD2.KODE
))
;

ExtendFormats brIHFldsWithDBF_XML;
ExtendTabbedSheets wTuneSettings;
Window wTuneSettings;
  TabbedSheet Top tabbed1;
    Show At (,,,24);
  Browse brIHFldsWithDBF_XML;
   Table IEHFlds;
    recMarker = m_pMarkerHFlds {IEHFlds.Nrec};
    Fields
    IEINCFLD2.VALUE 'Поле БД': protect;
      IEHFlds.Code  'Code': protect;
        IEHFlds.VALUE 'VALUE': protect;
  End; // Browse brIHFldsWithDBF_XML;

 End; //tabbedsheet
End; // Window wTuneSettings
End.
