sql select KatOrgDescr.nRec, KatOrgDescr.cGroup, KontrIer.cRecDs KontrIer_cRecDs, KontrIer.cGroup Ier_cGroup, KontrIer.nRec, KatOrgDescr2.Name,KontrIer.name
from KatOrgDescr
left join KontrIer on KatOrgDescr.nRec = KontrIer.cRecDs
left join KatOrgDescr KatOrgDescr2 on KontrIer.cGroup = KatOrgDescr2.nRec
where KatOrgDescr.CREC = #comp(3096224743817771) ;


sql select KatOrgDescr.nRec, KatOrgDescr.cGroup, KatOrgDescr.CREC, KatOrgDescr.NAME
from KatOrgDescr where KatOrgDescr.CREC = #comp(3096224743817771) or KatOrgDescr.nRec = #comp(000A000000006BB1h ) or KatOrgDescr.nRec = #comp(000A000000000027h);

LOGSTRTOFILE('IMPORT_XX.LOG','-------- 41  CODES CODES CODES CODES CODES CODES');
*/
