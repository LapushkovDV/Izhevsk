// component "C_EXPIMP"
#include ImpDefine.vih
#component "GP_Common"
Interface GP_McDragImp 'Импорт Драгов в Карточки Матценностей из Excel' gray dialog;

Const
xlBCYellow =   65535; // Желтый
xlBCBrown  =   49407; // Рыжий
xlBCGreen  = 5296274; // Зелёный
xlBCRed             =255; // Красный
xlBCDarkRed         =192; // ТемноКрасный
xlBC           =15773696; // Синий
xlBCDark       =12611584; // ТемноСиния
xlBCBlakBlue   = 6299648; // ЧёрноСиний
xlBCDarkPurple =10498160; // ТёмноФиолетовый
xlBCLiteGal    =15652797; // СветлоГалактический
xlBCGal        =15123099; // Галактический

xlBCError=xlBCBrown;
xlBCFindOK=xlBCLiteGal;
xlBCErrUpDate=xlBCYellow;

end;
;

var
lCapLine, // строка заголовка,
Counter, MaxLine, MaxCol, npp : longint;
sFileName, nm_file: string;

lBarkod, lDrag, lKol, lProba, lDragGr : longint;

sDrag, sDragGR, sMCKOD : string;
cDrag: comp;
_fKol, _fProba:double;

Str: string;
wFlagDop: word;
cntAkt: longint;

create view jView
as select KatMC.nrec
from
   KatMC
 , naldrag
 , SpKau GrDrag
 ,HashAn, HashAn HashAnFind, SpSloj (SPSLOJ03), MaskMC
where
((
    sMCKOD == KatMC.BARKOD

and sDrag == KatDrag.Name
and            word(3)      == NalDrag.TiDk
           and KatMC.nRec   == NalDrag.cKatOs
           and        cDrag == NalDrag.cKatDrag


and 10146 == GrDrag.KodGrKau
and sDragGR == GrDrag.NAME

and
   000B000000000001h == MaskMC.nRec

and
        HashAn.CSLOJ == SpSloj.cMain

))
;

//==== преобразовать из Excel  в число
function MyDouble(w:string):double ;
{ w:=replace(w,',','.');
  w:=replace(w,' ','');
  w:=replace(w,chr(39),'');
  MyDouble:=double(w) ;
}

//----------------------------------------
Function GetKatDrag(_sname:string):comp; cacheable;
{ Result:=0;
  var ii:word;
  ii:=pos(' ',_sname);
  if ii>0
  { _sname:=SubStr(_sname,1,ii-1)
  }
  if _sname='Алмазы' _sname:='Алмаз';
  sDrag := _sname;
  if getfirst KatDrag = tsok
    Result:=KatDrag.Nrec;
} //Function GetKatDrag(_sname:string):comp; cacheable;

//----------------------------------------
procedure xlOut1(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOut1

// ----------------------------------------
var LineError: word;
procedure xlOutE(pCol:longint;pStr: string);
{
  LineError++;
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
  xlSetBackColor( xlBCError , Counter, MaxCol+1, Counter, MaxCol+1);
}//  procedure xlOutE

var wDataCount: word = 0;
function ReadColNumByNamesOK: boolean;
Var
   lCol:longint;
   wOK: word = 0;
{

  lBarkod := lDrag := lKol := lProba := lDragGR := 0;

  lCapLine := 1; lCol:=0; str := '';
    while (lCol <= MaxCol) and (lCapLine < 50)// по Колонкам lCapLine строки ищем заголовок
    do
    {
      lCol++;
      xlgetcellvalue(lCapLine, lCol, str);
      str := trim( str );
      str := Replace(str,''#13,' ');
      str := Replace(str,''#10,' ');
      str := Replace(str,'  ',' ');      str := Replace(str,'  ',' ');      str := Replace(str,'  ',' ');
            Case str of
'ТМЦ / Услуга':{
                  // Наименование МЦ
               }
  '"Номенклатурный номер"','Номенклатурный номер',
      'КодМЦ','Артикул': lBarkod :=lCol;
       'ВидДрагметалла': lDrag := lCol;
           'Количество': lKol  := lCol;
  'ВидДрагметаллаПроба': lProba  := lCol;
   'ГруппаДрагМеталлов': lDragGR:=lCol;

            end; // Case

    }// while lCol <= MaxCol // по Колонкам lCapLine строки

    if lBarkod = 0 or lProba=0 or lDragGR = 0 or lDrag = 0 or lKol = 0
    {
        message ( 'Ошибка формата. Не найдена колонка'
                    +''#13'Артикул= '    + lBarkod
                    +''#13'ДрагМетал= '  + lDrag
                    +''#13'Количество= ' + lKol
                    +''#13'Проба= '      + lProba
                    +''#13'ГруппаДрагМеталлов= ' + lDragGR );

       ReadColNumByNamesOK := False;
    }
    else
    ReadColNumByNamesOK := true;
}// function ReadColNumByNamesOK: boolean;


screen scrWImp;
fields
nm_file:NoProtect, PickButton;
wFlagDop:NoProtect;
buttons
cmColTune ;  cmImport;
<<
  Импорт Даргов в Партии к Актам об излишках
  Файл Excel
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Обработка:`
 [.] Делать изменения в Базе`
 [.] Менять % у Драгов в МЦ`
 [.] Добавлять Драги в МЦ`

       <. Проверить соответствие полей .>                  <. Выполнить .>

>>
end;

HandleEvent // интерфейс

cmINIT:
{
  lCapLine := 1; // строка заголовка, будет уточнена
  if not ReadMyDsk(nm_file  , 'GP_DragMCimpnm_file', false) nm_file := '';
  if not ReadMyDsk(wFlagDop , 'GP_DragMCimpFlags'  , false) wFlagDop:= 11111b;
}
cmColTune:
{
  if nm_file = ''
  {
    Message('Укажите файл для импорта');
    SelectField(#nm_file);
    exit;
  }
  sFileName := nm_file ;

  if (not ExistFile(sFileName))
  { message('Не файла "'+sFileName+'"',error);
    exit;
  }


    if (not xlOpenNewExcel(false))
    {
      message('Ошибка запуска Excel', Error);
      if not xlKillExcel
        message('Ошибка закрытия Excel', Error);
      exit;
    }

    if (not xlOpenWorkBook(sFileName))
    {
      Message('Ошибка открытия книги: "' + sFileName + '"');
      xlKillExcel;
      Exit;
    }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);
  Counter:=lCapLine;
  if ReadColNumByNamesOK
  {
    xlkillExcel;
        message ( 'Найдены колонки:'
                    +''#13'Артикул= '    + lBarkod
                    +''#13'ДрагМетал= '  + lDrag
                    +''#13'Количество= ' + lKol
                    +''#13'Проба= '      + lProba
                    +''#13'ГруппаДрагМеталлов= ' + lDragGR );
  }
  else
  {
    xlkillExcel;
  }
} // cmColTune

cmImport:
{
  SaveMyDsk(nm_file    , 'GP_DragMCimpnm_file');
  SaveMyDsk(wFlagDop   , 'GP_DragMCimpFlags'  );

  if nm_file = ''
  {
    Message('Укажите файл для импорта');
    SelectField(#nm_file);
    exit;
  }
  sFileName := nm_file ;

  if (not ExistFile(sFileName))
  { message('Не найден шаблон файла "'+sFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(sFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sFileName+'".',error);
    exit;
  }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel ...', MaxLine div 3);

// Читаем заголовок и находим номера колонок по названию полей

Var boOk: boolean = ReadColNumByNamesOK;

if boOk
{

  Counter:=lCapLine;

// Заголовки для протокола
  xlOut1( 1, 'СтатусДМ');
  xlOut1( 2, 'Katmc.Nrec');
  xlOut1( 3, 'Katmc.NAME');
  xlOut1( 4, 'NalDrag.nRec');
  xlOut1( 5, 'СтатусАналитики');
  xlSetBackColor( xlBCGal , Counter, MaxCol+1, Counter, MaxCol+5);

while counter < MaxLine
do
{
  Counter++;   LineError := 0;

  if Counter mod 3 = 0
    if not nextvisual { boOk := False ; break; }

    xlgetcellvalue(Counter, lBarkod,Str);
    Str := Trim(Str);

    if Str = ''
    {  xlOutE(1 , 'Нет Баркода') ;
       continue;
    }
  sMCKOD :=Str;
    if getfirst KatMC <> tsOK
    {
      sMCKOD := LPADCH(sMCKOD,'0',10);
      if getfirst KatMC <> tsOK
      {
        xlSetBackColor( xlBCError , Counter, lBarkod, Counter, lBarkod);
        xlOutE(1 , 'Не найдена МЦ ' + sMCKOD);
        continue;
      }
    }

    xlOut1( 2, string(KatMC.nRec,0,0));
    xlOut1( 3, KatMC.Name);

    xlgetcellvalue(Counter, lDrag,Str);
    Str := Trim(Str);
    if Str = ''
    {  xlOutE(1 , 'Нет ДрагаМеталла') ;
       xlSetBackColor( xlBCError , Counter, lDrag, Counter, lDrag);
       continue;
    }
  cDrag := GetKatDrag(Str);
    if cDrag = 0
    {  xlOutE(1 , 'Не найден Драг'+ sDrag) ;
       xlSetBackColor( xlBCError , Counter, lDrag, Counter, lDrag);
         continue;
    }

    xlgetcellvalue(Counter, lKol,Str);    _fKol := MyDouble(Str);

    xlgetcellvalue(Counter, lProba,Str); _fProba := MyDouble(Str);

    var NewKol : double;
    if _fProba<>0 and _fProba<>1
    { NewKol :=_fProba;

      if (wFlagDop and 1b)> 0  doSetAttr(coKatMc,Katmc.nRec,'ТМЦ-ДМ',1);
      xlOut1(1 , 'ТМЦ-ДМ') ;
      xlSetBackColor( xlBCGal , Counter, lProba, Counter, lProba);
    }
    else
    { NewKol :=_fKol;
      xlOut1(1 , 'ТМЦ%') ;
      xlSetBackColor( xlBCGal , Counter, lKol, Counter, lKol);
    }

    if Getfirst NalDrag = tsOK
    {
      xlOut1( 4, string(NalDrag.nRec,0,0));
      if (wFlagDop and 11b)> 0
      if NalDrag.kol <> NewKol
      {
        NalDrag.kol := NewKol;
        if update current NalDrag <> tsOK
        {
          xlSetBackColor( xlBCError , Counter, MaxCol+4, Counter, MaxCol+4);
        }
      }
    }
    else
    {
       if (wFlagDop and 101b)> 0
       {
            Clearbuffer(#NalDrag);
            NalDrag.TiDk     :=word(3)   ;
            NalDrag.cKatOs   :=KatMC.nRec;
            NalDrag.cKatDrag :=cDrag     ;
            NALDRAG.Kol      := NewKol;
            NALDRAG.VIDDRAG:=0; // Паспорт
            insert current NalDrag;
            xlOut1( 4, string(NalDrag.nRec,0,0));
            xlSetBackColor( xlBCGreen , Counter, MaxCol+4, Counter, MaxCol+4);
       }
    }


// Аналитика\ kau4 Группы драгметаллов
    xlgetcellvalue(Counter, lDragGR,Str);
  sDragGR := Trim(Str);
    if sDragGR = '' continue;

    if getfirst GrDrag <> tsOK
    {
       if sDragGR = '1-ДМ алмазно-абраз инстру' sDragGR := '1-ДМ алмазно-абразивный инструмент';
       if sDragGR = '2-ДМ прил-золото- произво'  sDragGR := '2-ДМ прил-золото- произв';
       if getfirst GrDrag <> tsOK
       {  xlOutE(1 , 'Не найдена Группа Драгов '+ Str) ;
          xlSetBackColor( xlBCError , Counter, lDragGR, Counter, lDragGR);
          continue;
       }

    }

   if (wFlagDop and 1b) = 0 continue; // не менять данные - пропускаем аналитику

   coSetAttr(coKatmc,Katmc.nRec,'.Аналитика Группы драгметаллов',GrDrag.nRec, GrDrag.Name);

   var cNewHASHAN: comp = comp(0);
   if getfirst Hashan where (( Katmc.cHashan == Hashan.nRec)) = tsOK
   {
     if Hashan.CANALIT[4] = GrDrag.nRec
     {
       xlOut1( 5, 'Соответствует');
       continue;
     }

     Hashan.CANALIT[4] := GrDrag.nRec;//
     if (GetFirst HashAnFind where ((HashAn.CSLOJ == HashAnFind.CSLOJ and HashAn.CBLOCK == HashAnFind.CBLOCK and HashAn.CANALIT[1] == HashAnFind.CANALIT[1] and
                                     HashAn.CANALIT[2] == HashAnFind.CANALIT[2] and HashAn.CANALIT[3] == HashAnFind.CANALIT[3] and HashAn.CANALIT[4] == HashAnFind.CANALIT[4] and
                                     HashAn.CANALIT[5] == HashAnFind.CANALIT[5] and HashAn.CANALIT[6] == HashAnFind.CANALIT[6] and HashAn.CANALIT[7] == HashAnFind.CANALIT[7] and
                                     HashAn.CANALIT[8] == HashAnFind.CANALIT[8] and HashAn.CANALIT[9] == HashAnFind.CANALIT[9] and HashAn.CANALIT[10] == HashAnFind.CANALIT[10] )) = tsOk)
     {
       cNewHASHAN := HashAnFind.nRec;
     }
     else
     {
       HashAn.nRec := comp(0);
       if (insert current HashAn = tsOk) cNewHASHAN := HashAn.nRec;
     }
   }
   else
   {
     ClearBuffer(tnHashan);

     Hashan.CSLOJ := MaskMC.cSloj; // 000B000000000001h;
     if getlast SpSloj = tsOK  Hashan.npp  := SpSloj.NPP else Hashan.npp   := 4;

     Hashan.CANALIT[2] := coGetAttr(coKatmc,Katmc.nRec,'.Виды взаиморасчетов по договору');
     Hashan.CANALIT[3] := coGetAttr(coKatmc,Katmc.nRec,'.Аналитика БухСчета');
//     Hashan.CANALIT[4] := coGetAttr(coKatmc,Katmc.nRec,'.Аналитика Группы драгметаллов');
     Hashan.CANALIT[4] := GrDrag.nRec;//

      if (GetFirst HashAnFind where ((HashAn.CSLOJ == HashAnFind.CSLOJ and HashAn.CBLOCK == HashAnFind.CBLOCK and HashAn.CANALIT[1] == HashAnFind.CANALIT[1] and
                                      HashAn.CANALIT[2] == HashAnFind.CANALIT[2] and HashAn.CANALIT[3] == HashAnFind.CANALIT[3] and HashAn.CANALIT[4] == HashAnFind.CANALIT[4] and
                                      HashAn.CANALIT[5] == HashAnFind.CANALIT[5] and HashAn.CANALIT[6] == HashAnFind.CANALIT[6] and HashAn.CANALIT[7] == HashAnFind.CANALIT[7] and
                                      HashAn.CANALIT[8] == HashAnFind.CANALIT[8] and HashAn.CANALIT[9] == HashAnFind.CANALIT[9] and HashAn.CANALIT[10] == HashAnFind.CANALIT[10] )) = tsOk)
      {
        cNewHASHAN := HashAnFind.nRec;
      }
      else
      {
        HashAn.nRec := comp(0);
        if (insert current HashAn = tsOk) cNewHASHAN := HashAn.nRec;
      }

   }

   if cNewHASHAN = comp(0)
   {
     xlOut1( 5, 'cNewHASHAN = 0');
     continue;
   }

   if Katmc.cHASHAN <> cNewHASHAN
   {
     Katmc.cHASHAN := cNewHASHAN;
     KatMC.cMaskMC := MaskMC.nRec ;
     KatMC.cSloj   := MaskMC.cSloj;

     UpDate current Katmc;
     xlOut1( 5, 'обновлено');
   }
   else
     xlOut1( 5, 'Без изменений');


} // while counter < MaxLine do
}// if ReadColNumByNamesOK


xlkillExcel;
StopVisual('',0);

if not boOk Message('Прервано пользователем');

} // cmImport:

cmPick:
{ case CurField of
  #nm_file:
  { var ww_str:string=GetFileName('*.xls;*.xlsx','Выберите файл c данными по Задолженности');
    if ww_str<>''
    {
       set nm_file:=ww_str;
    }
  }
  end;
} // cmPick:

end; // HandleEvent
End. // interface
