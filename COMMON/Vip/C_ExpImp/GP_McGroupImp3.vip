/*************************************************************************************************\
* Наименование: Импорт Каталога Матценностей из Excel в Галактику                                 *
* Контур/Модуль:                                                                                  *
* Примечание:  запуск:  \Сервис \Утилиты \Запуск внешнего интерфейса                              *
*                                                                                                 *
*                                                                                                 *
* Вид работы  |Номер         |Дата      |Исполнитель              |Проект                         *
* ---------------------------------------------------------------------------------------------   *
* Разработка  |#2515         |20/11/2018|Шунин А.Г.               |НПО Энергомаш                  *
\*************************************************************************************************/
Interface GP_McGroupImp3 'Импорт Группы Матценностей из Excel' gray dialog;

var
Counter, MaxLine, MaxCol, npp : longint;
sFileName, nm_file: string;

lBarkod     : longint;
lNAME     : longint;
lGroup      : longint;

sMCKOD      : string;
sGroup      : string;
sNAME       : string;

wFlagDop: word;
NeedUpDateMC: word;


create view jView
as select KatMC.nRec, GROUPMC.KOD, PRICES.TIP, KatED.Name
from
 KatMC, GROUPMC, PRICES, KatED
where
((
   sMCKOD == KatMC.BARKOD and KatMC.cED == KatED.nRec
and
   sGroup == GROUPMC.KOD

and          0 == PRICES.tip and
    KATMC.nRec == PRICES.CTHING
))
;

screen scrImp;
fields
nm_file:NoProtect, PickButton;
wFlagDop:NoProtect;

buttons
      cmColTune; cmImport;
<<
  Импорт Атрибутов МЦ
  Файл Excel.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Обработка:`
 [.] Менять группу в ERP`
 [.] Update KATMC`
 [.] Update PRICES при изменении KATMC`
 [.] Проверять и Update PRICES в любом случае`
 [.] Только проверка МЦ`

    <. Проверить соответствие полей .>              <. Запустить Импорт .>

  версия 0.1
>>
end;

function ReadColNumByNamesOK: boolean;
Var str: string;
   lCol:longint;
{
  lBarkod := lGroup := 0;
  lCol:=0; str := '';
    while lCol <= MaxCol // по Колонкам первой строки
    do
    {
      lCol++;
      xlgetcellvalue(1, lCol, str);
      str := trim( str );
            Case str of
'КодМЦ',
'Ном.№'             : lBarkod    :=lCol;
'Код группы МЦ'     : lGroup     :=lCol;
'Полное наименование': lNAME:=lCol;
            end; // Case
    }

    if lBarkod = 0 or  ( ((wFlagDop and 10000b) = 0 ) and (lGroup = 0 or lNAME= 0) )
    {
        message ( 'Ошибка формата файла. Не найдена колонка'
            +''#13'Ном.№='                  + lBarkod
            +''#13'Код группы МЦ='          + lGroup
            +''#13'Наименование МЦ='          + lNAME
                );
       ReadColNumByNamesOK := False;
    }
    else
    ReadColNumByNamesOK := true;

}// function ReadColNumByNamesOK: boolean;


procedure xlOut1(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOut1

var LineError: word;
procedure xlOutE(pCol:longint;pStr: string);
{
  LineError++;
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOutE



HandleEvent

cmINIT:
{
  if not ReadMyDsk(nm_file  , 'GP_McGroupImp_nm_file', false) nm_file := '';
  if not ReadMyDsk(wFlagDop , 'GP_McGroupImp_Flags'  , false) wFlagDop:= 111b;
}
cmColTune:
{
  if nm_file <> '' then sFileName := nm_file
  else
  {
    sFileName := 'GP_Saldo60.xlsx';
    sFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + sFileName ;
  }

  if (not ExistFile(sFileName))
  { message('Не файла "'+sFileName+'"',error);
    exit;
  }


    if (not xlOpenNewExcel(false))
    {
      message('Ошибка запуска Excel', Error);
      if not xlKillExcel
        message('Ошибка закрытия Excel', Error);
      exit;
    }

    if (not xlOpenWorkBook(sFileName))
    {
      Message('Ошибка открытия книги: "' + sFileName + '"');
      xlKillExcel;
      Exit;
    }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);
  Counter:=1;
  if ReadColNumByNamesOK
        message ( 'Найдены колонки:'
            +''#13'Ном.№ = '                  + lBarkod
            +''#13'Код группы МЦ = '          + lGroup
            +''#13'Наименование МЦ='          + lNAME
                );
  xlkillExcel;
} // cmColTune

cmImport:
{
  SaveMyDsk(nm_file    , 'GP_McGroupImp_nm_file');
  SaveMyDsk(wFlagDop   , 'GP_McGroupImp_Flags'  );

  if nm_file <> '' then sFileName := nm_file
  else
  {
    sFileName := 'GP_McGroupImp.xlsx';
    sFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + sFileName ;
  }

  if (not ExistFile(sFileName))
  { message('Не найден шаблон файла "'+sFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(sFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sFileName+'".',error);
    exit;
  }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel ...', MaxLine);

// Читаем заголовок и находим номера колонок по названию полей

Counter:=1;
        xlOut1( 1, 'Статус');
        xlOut1( 2, 'Katmc_Nrec ');
        xlOut1( 3, 'Old_Katmc_GR');
        xlOut1( 4, 'Old_Katmc_NAME');
        xlOut1( 5, 'Old_CGROUPMC');
        xlOut1( 6, 'KatED_Name');


if ReadColNumByNamesOK
while counter < MaxLine
do
{
  Counter++;
  NeedUpDateMC := 0; // признак изменения значения

//  if Counter > 10 break;
  if Counter mod 3 = 0
  {
//    SetVisualHeader(counter + '/' + MaxLine);
    if not nextvisual break;
  }

  LineError := 0;

#define xlReadString(_Col, _Svar) xlgetcellvalue(Counter, #_Col,#_Svar); #_Svar := Trim(#_Svar);

    #xlReadString(lBarkod     ,sMCKOD)
    if sMCKOD = ''
    {  xlOutE(1 , 'Нет Баркода') ; continue;}

    sMCKOD := LPADCH(sMCKOD,'0',10);
    if getfirst KATMC <> tsOK
    {
      xlOutE(1 , 'Не найдена МЦ ' + sMCKOD);
      continue;
    }
    xlOut1(2, string(Katmc.nRec,0,0) );
    xlOut1(3, Katmc.KGROUPMC );
    xlOut1(4, Katmc.NAME );
    xlOut1(5, string(KATMC.CGROUPMC,0,0) );
    xlOut1(6, KatED.Name);


    if (wFlagDop and 10000b) > 0 continue;

    #xlReadString(lGroup      ,sGroup      )

    if getfirst GROUPMC <> tsOK
    {
      xlOutE(1 , 'Не найдена GROUPMC ' + sGroup);
      continue;
    }

    sNAME := KATMC.NAME;
    if lNAME > 0
    {
      #xlReadString(lNAME      ,sNAME      )
    
    }

    if KATMC.CGROUPMC <> GROUPMC.nrec or KATMC.KGROUPMC <> GROUPMC.KOD or KATMC.NAME <> sNAME
    {
      if (wFlagDop and 1b) > 0
      {
        KATMC.CGROUPMC := GROUPMC.nrec ;
        KATMC.KGROUPMC := GROUPMC.KOD  ;
        KATMC.NAME := sNAME;
        NeedUpDateMC++;
      }
    }



    if NeedUpDateMC > 0
    if (wFlagDop and 10b) > 0
    {
       if UpDate current Katmc = tsOK
       xlOut1(1,'Обновлено OK');
       else
       {
         xlOutE(1,'НЕ Обновлено. Ошибка');
         LineError++;
       }
    }

     if LineError = 0
     if ((NeedUpDateMC > 0)  and  ( (wFlagDop and 100b) > 0 ) ) or
        ((wFlagDop and 1000b) > 0 )
     {
         _Loop PRICES
         if PRICES.CGROUPMC <> KATMC.CGROUPMC or
            PRICES.KOD <> KATMC.KGROUPMC   or
            PRICES.NAME <> KATMC.NAME
         {
            PRICES.CGROUPMC := KATMC.CGROUPMC;
            PRICES.KOD := KATMC.KGROUPMC;
            PRICES.NAME:= KATMC.NAME;
            UpDate current PRICES;
         }
     }

    if NeedUpDateMC = 0
    xlOut1(1,'Одинаково');

}
xlkillExcel;
StopVisual('',0);

} // cmImport:

cmPick:
{ case CurField of
  #nm_file:
  { var ww_str:string=GetFileName('*.xls;*.xlsx','Выберите файл c данными по Группам МЦ');
    if ww_str<>''
    {
       set nm_file:=ww_str;
    }
  }
  end;
} // cmPick:

end; // HandleEvent
End. // interface
