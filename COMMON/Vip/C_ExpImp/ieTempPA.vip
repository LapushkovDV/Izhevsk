// #3006 Импорт Каталога Партий из Excel в Галактику
#doc
<p>Импорт Каталога Партий из Excel в Галактику
<p>Добавлены новый поля для импорта KATMC:
<p>Добавлен импорт внешнего атрибута числа <- Номер записи источника (N строки Excel)
<p>Добавлен импорт внешнего атрибута - строка
<p>Добавлен импорт внешнего атрибута - число
<p>Добавлен импорт внешнего атрибута - Ссылка
<p> Добавлены типы ссылок:
<p> Ссылка на Подразделение. Поиск по наименованиию подразделения. Влияет в дальнейшем для поиска МОЛ
<p> Ссылка на МОЛ. Поиск по наименованию МОЛ (обычно это ФИО сотрудника). Если ранее был поиск подразделения, то nRec этого подразделения будет ограничивать список МОЛ
<p> Ссылка на Сотрудника. Поиск по табельному номеру
#end

#component "C_ExpImp"
Alter InterFace ieTempPA;
overload
Procedure AddDocument( IsHeader  : Boolean );
function ImportDocument( cTempDoc : Comp ) : comp;
Function DefineField( sFieldValue : String; HeadOrSpec : Byte; sCode : String ) : Boolean;
Function ImportExcelField( sFieldName : string; iRow : longInt; Var sFieldValue : String ) : Boolean;
Function ImportField( IsHeader : Boolean; wNumber : Word; Var sFieldValue : String ) : Boolean;
Procedure GetDocumentSignature(Var sSign1:String; Var sSign2:String);
Procedure UpdateDocument( cTempDocument : Comp; cExistingDocument : Comp );
Function CheckDocumentSignature( Var cDocument : Comp ) : Boolean;
Procedure DoImportDocument( cDocument : Comp );
end;
#include exImConst.inc

var 
  sLastFieldValue : string;  // значение последнего прочитанного поля из Excel. Для получения "всех" 255 символов строки.
  lCurColumn: longint;

  cLastPodr: comp;
  cAttrValue: comp;
  sAttrValue, sAttrName: string = '';


Create View
as select KatEd.nrec,
katpodr.nrec, katmol.nrec, Persons.nrec, BuhSCHET.nrec, Dover.nrec, KatPayment.nrec, klskidka.nrec
from KatEd , attrnam, katpodr, katmol, Persons, BuhSCHET, Dover, KatPayment, klskidka
,HashAn, HashAn HashAn0,HashAn HashAnFind, SpSloj (SPSLOJ03), MaskMC , MnPlan
where
((
       Katmc.cEd == KatEd.nRec

  and          1 == KatOtpED.PrMC
  and Katmc.nRec == KatOtpED.CMCUSL
  and Katmc.cEd  == KatOtpED.CKATED

and  sAttrValue == KATPODR.NAME

and   cLastPodr == KATMOL.CSKL
 and sAttrValue == KATMOL.NAME

 and
 'С' == Persons.IsEmployee and sAttrValue == Persons.FIO (noindex)

 and cAttrValue == Buhschet.Nrec
 and cAttrValue == Dover.Nrec
 and cAttrValue == KatPayment.Nrec
 and cAttrValue == KlSkidka.Nrec

  and sAttrName == AttrNam.Name
  and word(5)   == AttrNam.AttrType
  and coKATPARTY== AttrNam.wTable

/*
                  if (getFirst KATPODR where ((sAttrValue == KATPODR.NAME)) ) = tsOk
                  if (getfirst KATMOL where ((cLastPodr == KATMOL.CSKL and sAttrValue == KATMOL.NAME)) = tsOk)
                  if (getfirst KATMOL where ((sAttrValue == KATMOL.NAME)) = tsOk)
                  if (getFirst Persons where (('С' == Persons.IsEmployee and sAttrValue == Persons.STRTABN (noindex) )) ) = tsOk
                  if (getFirst Persons where (('С' == Persons.IsEmployee and sAttrValue == Persons.FIO (noindex) )) ) = tsOk
                  if (getfirst BuhSchet where ((cAttrValue == Buhschet.Nrec)) = tsOk)
                  if (getfirst KatEd where ((cAttrValue == KatEd.Nrec)) = tsOk)
                  if (getfirst Dover where ((cAttrValue == Dover.Nrec)) = tsOk)
                  if (getfirst KatPayment where ((cAttrValue == KatPayment.Nrec)) = tsOk)
                  if (getfirst KatOrg where ((cAttrValue == KatOrg.Nrec)) = tsOk)
                  if (getfirst KlSkidka where ((cAttrValue == KlSkidka.Nrec)) = tsOk)
         */
and
   000B000000000001h == MaskMC.nRec
and
       KatMC.cHashAn == HashAn0.nRec // в 3 и 4 Аналитику из Атрибутов  .Аналитика БухСчета + .Аналитика Группы драгметаллов
and
        HashAn.CSLOJ == SpSloj.cMain
))
;

function GetHashAn: comp;
{
   Result := comp(0);
   if Katmc.cHashan > comp(0)
   if getfirst Hashan where (( Katmc.cHashan == Hashan.nRec)) = tsOK
   {
     Result := Hashan.nRec;
   }

   if Result = comp(0)
   {
     ClearBuffer(tnHashan);
     
     Hashan.CSLOJ := MaskMC.cSloj; // 000B000000000001h;
     if getlast SpSloj = tsOK  Hashan.npp  := SpSloj.NPP else Hashan.npp   := 4;

   }

   Hashan.CANALIT[2] := iexAttr.coGetAttr(coKatmc,Katmc.nRec,'.Виды взаиморасчетов по договору');
   Hashan.CANALIT[3] := iexAttr.coGetAttr(coKatmc,Katmc.nRec,'.Аналитика БухСчета');
   Hashan.CANALIT[4] := iexAttr.coGetAttr(coKatmc,Katmc.nRec,'.Аналитика Группы драгметаллов');

    if (GetFirst HashAnFind where ((HashAn.CSLOJ == HashAnFind.CSLOJ and HashAn.CBLOCK == HashAnFind.CBLOCK and HashAn.CANALIT[1] == HashAnFind.CANALIT[1] and
                                    HashAn.CANALIT[2] == HashAnFind.CANALIT[2] and HashAn.CANALIT[3] == HashAnFind.CANALIT[3] and HashAn.CANALIT[4] == HashAnFind.CANALIT[4] and
                                    HashAn.CANALIT[5] == HashAnFind.CANALIT[5] and HashAn.CANALIT[6] == HashAnFind.CANALIT[6] and HashAn.CANALIT[7] == HashAnFind.CANALIT[7] and
                                    HashAn.CANALIT[8] == HashAnFind.CANALIT[8] and HashAn.CANALIT[9] == HashAnFind.CANALIT[9] and HashAn.CANALIT[10] == HashAnFind.CANALIT[10] )) = tsOk)
    {
        Result := HashAnFind.nRec
    }
    else
    {
      HashAn.nRec := comp(0);
      if (insert current HashAn = tsOk) Result := HashAn.nRec
    }

} // function GetHashAn: comp;

//if GetFirst Katmc where (( KatParty.cmc == KatMC.nRec)) = tsOK
Procedure SetMCAnalitic;
{
  // только новые МЦ, созданные для партии
if not( katmc.NAME    <> '' and katmc.ATL_LASTUSER = katmc.ATL_OWNER
    and katmc.BARKOD  <> ''
    and katmc.OBOZN   =''
    and katmc.BARKOD2 =''
    and katmc.REMMC   =''
    and katmc.KGROUPMC =''
    and katmc.TNVED   =''
    and katmc.CED <> 0
    and katmc.CRESHR  =0
    and katmc.CTYPE   =0
    and katmc.CTECH   =0
    and katmc.PREUTIL = false
    and katmc.DIVIDE  =0
    and katmc.BASEDSE =0
    and katmc.CDEP    =0
    and katmc.CMCMAT  =0
    and katmc.RET1    =0
    and katmc.RET2    =0
    and katmc.PRIOR   =0
    and katmc.SALE    = 0
    and katmc.CGRNAL  =0
    and katmc.OKDP    =''
    and katmc.COKP    = 0
    and katmc.KIND    =0
    and katmc.PRMAT   =0
    and katmc.CSTZATR =0
    and katmc.CKAELEM =0
    and katmc.TPPLAN  = 0
    and katmc.WPLANLEVEL      =0
    and katmc.GOST = ''
    and katmc.WSERIALREG      = 0
    and katmc.CGROUPSFO=0
    and katmc.CSTATE  = 0
    and katmc.WQUESTIONNAIRE = 0 ) exit;


LogStrTOFILE('#MC_ANALIT.txt', 'SetMCAnalitic KatParty.nRec=' + KatParty.nRec + ': KOD=' + KatParty.KOD + '  cmc=' + KatParty.cmc + ' ' + Katmc.NAME);

  sAttrName  := '.Аналитика БухСчета';
  sAttrValue := iexAttr.sGetAttr (coKatParty, KatParty.nRec, sAttrName);
  cAttrValue := iexAttr.coGetAttr(coKatParty, KatParty.nRec, sAttrName);

LogStrTOFILE('#MC_ANALIT.txt', ' sAttrName=' + sAttrName + '  sAttrValue=' + sAttrValue + ' cAttrValue=' + cAttrValue);


  if cAttrValue = comp(0)
  {
LogStrTOFILE('#MC_ANALIT.txt', ' Нет Аналитики - пропускаем');
    // Нет Аналитики - пропускаем
    exit;
  }

LogStrTOFILE('#MC_ANALIT.txt', ' Old value=' + iexAttr.sGetAttr(coKatMC, KatMC.nRec, sAttrName));


  if cAttrValue = iexAttr.coGetAttr(coKatMC, KatMC.nRec, sAttrName)
  {
LogStrTOFILE('#MC_ANALIT.txt', ' Значение Аналитики совпадает - пропускаем');
     exit;
  }

LogStrTOFILE('#MC_ANALIT.txt', 'New Value = ' + sAttrValue);

 if iexAttr.coSetAttrEx(coKatMC, KatMC.nRec, sAttrName,cAttrValue,sAttrValue)
LogStrTOFILE('#MC_ANALIT.txt', 'Атрибут у МЦ услановлен = ' + sAttrValue + ' результат = ' + iexAttr.coGetAttr(coKatMC, KatMC.nRec, sAttrName));


// Шаблон и аналитика для KATMC
var cHashanNew:comp;

    if (GetFirst MaskMC = tsOk)
    {
       cHashanNew    := GetHashAn; // в 3 и 4 Аналитику из Атрибутов  .Аналитика БухСчета + .Аналитика Группы драгметаллов

       if  KatMC.cMaskMC <> MaskMC.nRec  or
           KatMC.cSloj   <> MaskMC.cSloj or
           KatMC.cHashAn <> cHashanNew
       {
          KatMC.cMaskMC := MaskMC.nRec ;
          KatMC.cSloj   := MaskMC.cSloj;
          KatMC.cHashAn := cHashanNew;
          UpDate current KatMC;
LogStrTOFILE('#MC_ANALIT.txt', '-- Аналитика у МЦ изменена UpDateED');
       }
    }
// Шаблон и аналитика для KATMC
LogStrTOFILE('#MC_ANALIT.txt', '-- OK END');

}// Procedure SetMCAnalitic

Function GetIEHFldsCODE: word;
{
  var bPos: byte;
  var sTemp: string = '';
    sTemp := IEHFlds.Value;
    bPos  := Pos('"', sTemp );
    GetIEHFldsCODE := word( If ( bPos <> 0, SubStr( sTemp, 1, bPos - 1 ), sTemp ));
}

/*******************************************************************************
  AddDocument - добавить во временную таблицу импортированный документ
********************************************************************************/
Procedure AddDocument( IsHeader  : Boolean );
{
  If ( IsHeader )
  { // что б были разные nRec
    //Обновляем все ссылки
    UpdateHeaderLinks;
    tHeader.NRec := GetNextNRec(#KatParty, 0);
    fun.LogDocument(tHeader.NRec, ieImportedInTemp, 'Код:'+tHeader.Kod+' '+tHeader.Name, IEHead.nRec);

    if EXIMLOGT.RSTR = ''  Update current EXIMLOGT Set EXIMLOGT.rStr := 'lCurRow';
    Update current ExImLogR Set ExImLogR.rStr := string(lCurRow);

    // Update ExImLogE.rStr здесь вспомогательно.
    // Раз уж приходится делать update из-за cLogR=0, пишем в rStr номер записи источника.
    Update ExImLogE Where((0 == ExImLogE.cLogR)) Set  ExImLogE.SVALUES[1] := string(lCurRow)
                                                     ,ExImLogE.SVALUES[2] := ExImLogE.NOREFFLD
                                                     ,ExImLogE.SVALUES[3] := ExImLogE.VALUE
                                                     ,ExImLogE.SVALUES[4] := ExImLogE.RSTR
                                                     ,ExImLogE.cLogR := ExImLogR.nRec
                                                     ,ExImLogE.rStr := string(lCurRow)
                                                     ;

    lDocumentsImported++;
    if( Insert Current tHeader = tsOk )
    {
      tClass.nRec := comp(0);
      tClass.CREC   := tHeader.nRec;
      insert current tClass;
    }
  }
} // Procedure AddDocument

//функции для импорта
//функции для импорта
Procedure GetDocumentSignature(Var sSign1:String; Var sSign2:String);
{
  if getfirst KatMC = tsOK
    sSign1 := tHeader.KOD + ' для МЦ ' + KatMC.Barkod +  tHeader.Name
  else
    sSign1 := tHeader.KOD + ' ' +  tHeader.Name;

  sSign2 := '';
} // Function GetDocumentSignature

/*******************************************************************************
  ImportDocument - Переносим запись из временной таблицы в постоянную
********************************************************************************/
function ImportDocument( cTempDoc : Comp ) : comp;
{
  result := inherited::ImportDocument( cTempDoc );
LogStrTOFILE('#PA_Sign.txt', 'ImportDocument== KatParty.nRec=' + KatParty.nRec + ': KOD=' + KatParty.KOD + '  cmc=' + KatParty.cmc );

  Var UpTable: word = 0;
  var cIGK: comp = coGetAttr(coKatParty, KatParty.nRec, 'Идентификатор государственного контракта');
  var cNEWNOTE, cNEWGRoup: comp;
  var wNewSTATUS: word = 0;
  if cIGK = comp(0)
  {
    cNEWGRoup := refImpDef.SetToGroupParty('Коммерческие заказы');
    if cNEWGRoup = comp(0)  cNEWGRoup := 000B000000000003h; // КОМ

    if not refImpDef.SetToKatNotes(429, 'отпуск разрешен', wNewSTATUS, cNEWNOTE)
    {
      cNEWNOTE  := 000B000000000099h; // отпуск разрешен
    }
  }
  else
  {
    cNEWGRoup := refImpDef.SetToGroupParty('Исполнение гос.заказов');
    if cNEWGRoup = comp(0) cNEWGRoup := 000B000000000001h; // ГОЗ
    if not refImpDef.SetToKatNotes(429, 'прочий отпуск разрешен', wNewSTATUS, cNEWNOTE)
    {
      cNEWNOTE  := 000B00000000009Ah; // прочий отпуск разрешен
    }
  }

  if not ((KatParty.CGROUPPARTY = cNEWGRoup ) and
          (KatParty.CNOTE       = cNEWNOTE  ) and
          (KatParty.Status      = wNewSTATUS)  )
  {
     KatParty.CGROUPPARTY := cNEWGRoup ;
     KatParty.CNOTE       := cNEWNOTE  ;
     KatParty.Status      := wNewSTATUS;
     UpTable++;
  }

  if UpTable > 0
  if Update current KatParty = tsOK {}

  if GetFirst Katmc where (( KatParty.cmc == KatMC.nRec)) = tsOK  SetMCAnalitic;

  // удалить ссылку на запись времменой таблицы для импорта
  If ( cTempDoc <> 0 ) and ( result = comp(0) )
  {
    If ( GetFirst tHeader Where (( cTempDoc == tHeader.nRec )) = tsOk )
    {
      fun.UpdateImportLog(tHeader.nRec, Comp(0), ieError, ExImLogT.nRec);
    }
  }
} // function ImportDocument( cTempDoc : Comp ) : comp;


Procedure DoImportDocument( cDocument : Comp );
Var
  cExistingDocument : Comp;
{
  //для корректной работы настроек и отображения в диалогах надо позиционироваться на tHeader
  If GetFirst tHeader Where ((cDocument == tHeader.NRec)) = tsOk {}

  if (not CheckImportDocument)
    exit;
  // проверим, не импортировался ли документ с такой сигнатурой
  If (CheckDocumentSignature(cExistingDocument))
  { //обновляем лог если документ добавляется, иначе не надо пересчитывать
    ShowErrorRecordInTmp;
    fun.UpdateLogError(tHeader.nREc, ExImLogT.nRec);
    ImportDocument(cDocument);
// убрал   epAfterImportDocument(ieHead.buffer, ImportDocument(cDocument)); // потому, что тут сами допишем что надо
  }
  Else
  {
// убрал    If ( fun.DuplicatesImportType = ieUpdateDuplicates ) // потому,что в импорте партии нет такого в списке значений
    {
      if (wWarningResult = cmOk or wWarningResult = cmOkAll)
      {
        ShowErrorRecordInTmp;
        fun.UpdateLogError(tHeader.nREc, ExImLogT.nRec);
        UpdateDocument( cDocument, cExistingDocument );
      }
    }
  }
} // Procedure DoImportDocument

Function CheckDocumentSignature( Var cDocument : Comp ) : Boolean;
{
 LogStrTOFILE('#PA_Sign.txt', '1 KOD=' + tHeader.kod + ' substr(tHeader.kod,1,1) = ' + substr(tHeader.kod,1,1));
  result := not ( GetFirst KatParty Where (( tHeader.kod == KatParty.KOD and
                                             tHeader.cmc == KatParty.cmc (noindex) )) = tsOk );
 LogStrTOFILE('#PA_Sign.txt', '1 KOD=' + tHeader.kod + ' substr(tHeader.kod,1,1) = ' + substr(tHeader.kod,1,1) + ' result=' + String(result));

  if result
  if substr(tHeader.kod,1,1) = '0'
  {
     Var KODl: string = string(longint(tHeader.kod));
     result := not ( GetFirst KatParty Where ((     KODl == KatParty.KOD and
                                             tHeader.cmc == KatParty.cmc (noindex) )) = tsOk );
 LogStrTOFILE('#PA_Sign.txt', '2 KOD=' + KODl + ' result=' + string(result));
  }
  else
  {
    Var KOD00: string = tHeader.kod;
    KOD00 := LPadCh(tHeader.kod,'0',9);

    result := not ( GetFirst KatParty Where ((       KOD00 == KatParty.KOD and
                                               tHeader.cmc == KatParty.cmc (noindex) )) = tsOk );
 LogStrTOFILE('#PA_Sign.txt', '3 KOD=' + KOD00+ ' result=' + string(result));
  }

  if not result cDocument := KatParty.nRec else cDocument:=comp(0);

  wWarningResult := cmOkAll;

 LogStrTOFILE('#PA_Sign.txt', KatParty.nRec + ': KOD=' + KatParty.KOD + '  cmc=' + KatParty.cmc );
}

/*******************************************************************************
  UpdateDocument -
********************************************************************************/
Procedure UpdateDocument( cTempDocument : Comp; cExistingDocument : Comp );
{
  if (getfirst FastFirstRow KatParty where((cExistingDocument == KatParty.nRec)) <> tsOk) exit;
  if (GetFirst FastFirstRow tHeader where((cTempDocument == tHeader.NRec)) <> tsOk) Exit;

  Var UpTable: word = 0;
// Поля не меняем КОД и CMC совпадают, про другой NAME сообщим, атрибуты переносим, остальное не важно
LogStrTOFILE('#PA_Sign.txt', 'UpdateDocument== KatParty.nRec=' + KatParty.nRec + ': KOD=' + KatParty.KOD + '  cmc=' + KatParty.cmc );

  if (fun.ThisCodePresentInTune(iehPA +  0))
  if  Trim(KatParty.KOD) <> trim(tHeader.KOD)
  {
    KatParty.KOD := tHeader.KOD;
    UpTable++;
  }

  if (fun.ThisCodePresentInTune(iehPA +  1))
  if  Trim(KatParty.NAME) <> trim(tHeader.NAME)
  {
    fun.Set_sCurFieldName('Разное KatParty.NAME в Базе и в Источнике ');
    fun.LogErrorDetail(0, 2, trim(KatParty.NAME), trim(tHeader.NAME)); // 2 - Warning
  }

  if (fun.ThisCodePresentInTune(iehPA + 11)) 
  if KatParty.cOrgPar <> tHeader.cOrgPar
  {
    KatParty.cOrgPar := tHeader.cOrgPar;
    UpTable++;
  }

  if (fun.ThisCodePresentInTune(iehPA + 27))
  if ( KatParty.CNOTE <> tHeader.CNOTE ) or (KatParty.STATUS <> tHeader.STATUS)
  {
    KatParty.CNOTE := tHeader.CNOTE;
    KatParty.STATUS := tHeader.STATUS;
    UpTable++;
  }

      // Удаляем значения атрибутов, которые есть в настройке импорта
      _LOOP IEHFlds Where((IEHead.nRec == IEHFlds.cHead  And true == IEHFlds.isLeaf )) Ordered By Number
      if iFileStruct.GetIndexFieldByName(IEHFlds.DbfName) > 0 // Это поле есть в файле импорта
      Case GetIEHFldsCODE of 
        iehPA + 22, //'Внешний атрибут число <- Номер записи источника' ))'
        iehPA + 23, //'Внешний атрибут строка'               ))'Введите имя
        iehPA + 24, //'Внешний атрибут строка 255 символов'  ))'Имя атрибут
        iehPA + 25, //'Внешний атрибут число'   ))'Введите имя атрибута'
        iehPA + 26: //'Внешний атрибут ссылка'  ))'Введите имя атрибута'
        {
            Var AttrNAME: string = '';
            Var bPos : word = Pos('"', IEHFlds.Value);
            if bPos > 0
            {
                AttrNAME := SubStr(IEHFlds.Value, bPos+1, length(IEHFlds.Value)-bPos-1);
                if iexAttr.DeleteValue (coKATPARTY, KATPARTY.nRec, AttrNAME) > 0 {}
            }
        }
      end; // Case


  iExAttr.CopyAllAttrEx1(coIEHFlds, tHeader.nRec, coKatParty, KatParty.nRec, false);

  var cIGK: comp = coGetAttr(coKatParty, KatParty.nRec, 'Идентификатор государственного контракта');
  var cNEWNOTE, cNEWGRoup: comp;
  var wNewSTATUS: word = 0;
  if cIGK = comp(0)
  {
    cNEWGRoup := refImpDef.SetToGroupParty('Коммерческие заказы');
    if cNEWGRoup = comp(0)  cNEWGRoup := 000B000000000003h; // КОМ

    if not refImpDef.SetToKatNotes(429, 'отпуск разрешен', wNewSTATUS, cNEWNOTE)
    {
      cNEWNOTE  := 000B000000000099h; // отпуск разрешен
    }
  }
  else
  {
    cNEWGRoup := refImpDef.SetToGroupParty('Исполнение гос.заказов');
    if cNEWGRoup = comp(0) cNEWGRoup := 000B000000000001h; // ГОЗ
    if not refImpDef.SetToKatNotes(429, 'прочий отпуск разрешен', wNewSTATUS, cNEWNOTE)
    {
      cNEWNOTE  := 000B00000000009Ah; // прочий отпуск разрешен
    }
  }

  if not ((KatParty.CGROUPPARTY = cNEWGRoup ) and
          (KatParty.CNOTE       = cNEWNOTE  ) and
          (KatParty.Status      = wNewSTATUS)  )
  {
     KatParty.CGROUPPARTY := cNEWGRoup ;
     KatParty.CNOTE       := cNEWNOTE  ;
     KatParty.Status      := wNewSTATUS;
     UpTable++;
  }

  if UpTable > 0
  if Update current KatParty = tsOK {}

  fun.UpdateImportLog(cTempDocument, KatParty.nRec, ieImported, ExImLogT.nRec);

  if false
  if GetFirst Katmc where (( KatParty.cmc == KatMC.nRec)) = tsOK  SetMCAnalitic;

} // Procedure UpdateDocument

function GetSrcAddres:string;
{
  result := 'R' +string(lCurRow)+'C'+ string(lCurColumn);
}

Function DefineField( sFieldValue : String; HeadOrSpec : Byte; sCode : String ) : Boolean;
{
   sFieldValue := Trim(sFieldValue);
   DefineField := true;

// Имя текущего поля для протокола ошибок
    Case ( Word(sCode) ) Of
      iehPA + 10: fun.Set_sCurFieldName('Валюта ' +GetSrcAddres);        // tHeader.cValPar
      iehPA + 11: fun.Set_sCurFieldName('Организация ' +GetSrcAddres);                     // tHeader.cOrgPar
      iehPA + 14: fun.Set_sCurFieldName('Группа партий ' +GetSrcAddres);                     // tHeader.cGroupParty
      iehPA + 19: fun.Set_sCurFieldName('Ресурс отгрузки ' +GetSrcAddres);          // tHeader.cResOtgr
    End; // Case

   // ПредОбработка. Мапинг даннах для привязке к данным в Базе ERP
    Case ( Word(sCode) ) Of
      iehPA +  0: sFieldValue := LPadCh(sFieldValue,'0',9);
      iehPA + 11:
      {
         Var KOD1C, KOD1C2: string[20] ='';

         KOD1C := trim(sFieldValue);
         if KOD1C = '' exit;
         

        if getfirst KatORG where ((KOD1C  == katorg.code)) = tsOK tHeader.cOrgPar := KatORG.nRec 
        else
        {
           if length(KOD1C) < 9
             KOD1C2 := LPadCh(String(LongInt(KOD1C)),'0',9)
           else
             KOD1C2 := String(LongInt(KOD1C));

           if getfirst KatORG where ((KOD1C2 == katorg.code)) = tsOK tHeader.cOrgPar := KatORG.nRec else
           {
             fun.LogError(0, constDocErrorCode, KOD1C+', '+KOD1C2);
           }
        }
        exit;
      } 
      iehPA + 20:{ // sMCBarKod
                   if sFieldValue <> '' sFieldValue :=  LPadCh(sFieldValue,'0',10);
                   sMCBarKod := sFieldValue;
                   if sMCBarKod <> ''
                   if sMCName <> ''
                   if getfirst Katmc where (( sMCBarKod == Katmc.BarKod )) = tsOK
                   {
                      if sMCName <> Katmc.NAME
                      {
                        fun.Set_sCurFieldName('Разное Наименование МЦ в Базе и в Источнике '+GetSrcAddres);
                        fun.LogErrorDetail(0, 2, KatMc.NAME, sMCName); // 2 - Warning
                        sMCName := Katmc.NAME;
                      }

                   }

                   exit;

                   // Далее вставка МЦ, которой нет - отменена с 01/02/2019

    // вставка новой МЦ работает только тогда, когда Имя МЦ прочитано раньше Баркода
                   if sMCName <> ''
                   if getfirst Katmc where (( sMCBarKod == Katmc.BarKod )) <> tsOK
                   {
//  LogstrToFile('#_NewMC.txt', sMCBarKod + ' ' + sMCName);
                         ClearBuffer(tnKatmc);
                       Katmc.BarKod := sMCBarKod;
                       Katmc.NAME := sMCName;
                       // единица измерения
                       if tHeader.WhoSertif <> ''
                       {
                         Katmc.cEd  := refImpDef.SetToKatEd(tHeader.WhoSertif);// единица измерения
                       }

                       if insert current Katmc = tsOK
                       {
                        fun.Set_sCurFieldName('Добавлена МЦ');
                        fun.LogErrorDetail(0, 2, KatMC.BARKOD, KatMC.NAME); // 2 - Warning
                       }

                       if getfirst KatEd = tsOK
                       {
                          ClearBuffer(#KATOTPED);
                          KATOTPED.cMCUsl  := Katmc.nRec;
                          KATOTPED.Name    := KatEd.NAME;
                          KATOTPED.Akt     := 1;
                          KATOTPED.Koef    := 1;
                          KATOTPED.Diskret := KatEd.DISKRET;
                          KATOTPED.bKod    := KatEd.KOD;
                          KATOTPED.Abbr    := KatEd.ABBR;
                          KATOTPED.cKatEd  := KatEd.nRec;
                          insert current KATOTPED;
                       }
                   }
                   else
                   {
                       var p_cEd : comp = 0;
                       var pAKT: word = 0;

                       if Katmc.cEd = comp(0) pAKT := 1;

                       if tHeader.WhoSertif <> ''
                       {
                         p_cEd := refImpDef.SetToKatEd(tHeader.WhoSertif);// единица измерения
//                         tHeader.WhoSertif := '';
                         if p_cEd <> comp(0)
                         if Katmc.cEd = comp(0)
                         {
                           Katmc.cEd := p_cEd;
                           UpDate current Katmc;
                         }

                       }

                       if p_cEd <> comp(0)
                       {
                             Katmc.cEd := p_cEd; // Update Katmc не будет !!

                           if getfirst KatEd = tsOK
                           if getfirst KATOTPED <> tsOK
                           {
                              ClearBuffer(#KATOTPED);
                              KATOTPED.cMCUsl  := Katmc.nRec;
                              KATOTPED.Name    := KatEd.NAME;
                              KATOTPED.Akt     := pAKT;
                              KATOTPED.Koef    := 1;
                              KATOTPED.Diskret := KatEd.DISKRET;
                              KATOTPED.bKod    := KatEd.KOD;
                              KATOTPED.Abbr    := KatEd.ABBR;
                              KATOTPED.cKatEd  := KatEd.nRec;
                              KatOtpED.PrMC    := 1;
                              if insert current KATOTPED = tsOK
                              {
                                fun.Set_sCurFieldName('Добавлена KATOTPED:');
                                fun.LogErrorDetail(0, 2, KatEd.KOD + ' ' + KatEd.ABBR, '.К МЦ:'+Katmc.BARKOD + ' ' + Katmc.NAME ); // 2 - Warning
                              }
                           }
                       }

                       if sMCName <> Katmc.NAME
                       {
      LogstrToFile('#McNAMEx.txt', 'Строка: ' + lCurRow + ' Длина из Excel=' + Length(sMCName) + ' Длина из базы='  + Length(Katmc.NAME));
      LogstrToFile('#McNAMEx.txt', sMCName);
      LogstrToFile('#McNAMEx.txt', Katmc.NAME);

                          fun.Set_sCurFieldName('Разное Наименование МЦ в Базе и в Источнике '+GetSrcAddres);
                          fun.LogErrorDetail(0, 2, KatMc.NAME, sMCName); // 2 - Warning

                          sMCName := Katmc.NAME;

                       }
                   }
                 }
    End;

  DefineField := inherited::DefineField( sFieldValue, HeadOrSpec, sCode);

// Дополнительные поля для импорта
       Case ( Word(sCode) ) Of
         iehPA + 22 :  if (sFieldValue != '')  // Внешний атрибут число <- Номер записи источника' , 'N строки Excel
                      {
                        Var bPos : word;
                        var AttrValue: string;
                        bPos := Pos('"', SFieldValue);
                        if bPos = 0 exit;
                        AttrValue := SubStr(SFieldValue, bPos+1, length(SFieldValue)-bPos);
                        if AttrValue <> ''
                        iexAttr.doSetAttr(coIEHFlds,tHeader.Nrec, SubStr(SFieldValue,1,bpos-1), double(AttrValue));
                        DefineField := true;
                      }

         iehPA + 23 : if (sFieldValue != '')  // Внешний атрибут строка
                      {
                        Var bPos : word;
                        var AttrValue: string;
                        bPos := Pos('"', SFieldValue);
                        if bPos = 0 exit;

                        AttrValue := SubStr(SFieldValue, bPos+1, length(SFieldValue)-bPos);
                        if AttrValue <> ''
                        iexAttr.sSetAttr(coIEHFlds,tHeader.Nrec, SubStr(SFieldValue,1,bpos-1),AttrValue);
                        DefineField := true;
                      }
         iehPA + 24 : if (sFieldValue != '') //Внешний атрибут строка 255 символов
                      if (sLastFieldValue != '')
                      {
                        Var bPos : word;
                        var AttrNAME: string;
                        bPos := Pos('"', IEHFlds.Value);
                        if bPos > 0
                        {
                            AttrNAME := SubStr(IEHFlds.Value, bPos+1, length(IEHFlds.Value)-bPos-1);
                            iexAttr.sSetAttr(coIEHFlds,tHeader.Nrec, AttrNAME, sLastFieldValue);
                        }
                      }
         iehPA + 25 : if (sFieldValue != '')  // Внешний атрибут число
                      {
                        Var bPos : word;
                        var AttrValue: string;
                        bPos := Pos('"', SFieldValue);
                        if bPos = 0 exit;
                        AttrValue := SubStr(SFieldValue, bPos+1, length(SFieldValue)-bPos);
                        AttrValue := Replace(AttrValue,',','.');
                        if AttrValue <> ''
                        iexAttr.doSetAttr(coIEHFlds,tHeader.Nrec, SubStr(SFieldValue,1,bpos-1), double(AttrValue));
                      }

         iehPA + 27 : {  //  Статус партии KATPARTY.CNOTE

               refImpDef.SetToKatNotes(word(429), SFieldValue, tHeader.Status, tHeader.cNote);

                      }
	
         iehPA + 26: // Внешний атрибут ссылка
          if (sFieldValue != '')
          {
            Var bPos : word;

            var sErrorStr : string = '';

            bPos := Pos('"', sFieldValue);   //    sFieldValue = '[sAttrName]"[sAttrValue]'
            sAttrValue := SubStr(sFieldValue, bPos+1, length(sFieldValue)-bPos);
            if trim(sAttrValue) = '' exit; // пустое значение из источника

            cAttrValue := comp(trim(sAttrValue));
            sAttrName := SubStr(SFieldValue,1,bpos-1);

            if (GetFirst AttrNam /*where (( sAttrName == AttrNam.Name and
                                          word(5)   == AttrNam.AttrType and
                                          coKatmc   == AttrNam.wTable)) */ = tsOk)
            {
              case AttrNam.rObject of
              2: {// подразделение / склад. влияет в дальнейшем для поиска МОЛ
                   if (getFirst KATPODR where ((sAttrValue == KATPODR.NAME)) ) = tsOk
                   {
                     cLastPodr := KATPODR.nRec;
                     cAttrValue := KATPODR.nRec;
                   }
                   sErrorStr := 'Подразделение / склад.';
                 }
             60:{ // МОЛ
                  if cLastPodr <> Comp(0) // если ранее был поиск подразделения
                  {
                     if (getfirst KATMOL /* where ((cLastPodr == KATMOL.CSKL and sAttrValue == KATMOL.NAME))*/ = tsOk)
                       cAttrValue := KATMOL.nRec;
                  }
                  else
                  if (getfirst KATMOL where ((sAttrValue == KATMOL.NAME)) = tsOk)
                    cAttrValue := KATMOL.nRec;

                  sErrorStr := 'МОЛ';
                }
           3,25001:{
                       if (getFirst Persons /* where (('С' == Persons.IsEmployee and sAttrValue == Persons.FIO (noindex) )) */ ) = tsOk
                       {
                         cAttrValue := Persons.nRec;
                         sAttrValue := Persons.FIO;
                       }
                       else
                       if (getFirst Persons where (('С' == Persons.IsEmployee and sAttrValue == Persons.STRTABN (noindex) )) ) = tsOk
                       {
                         cAttrValue := Persons.nRec;
                         sAttrValue := Persons.FIO;
                       }

                      sErrorStr := 'Сотрудник';
                   }
         1502,5063:{
                      var Str6: string;
                      Str6 := substr(sAttrValue, 1, 6);
                      Str6 := RePlace(Str6, '/', '.');

                      if Str6 = '10.151' sAttrValue := '10.01' else
                      if Str6 = '10.200' sAttrValue := '10.02' else
                      if Str6 = '10.156' sAttrValue := '10.13' else
                      if Str6 = '10.450' sAttrValue := '10.04' else
                      if Str6 = '10.956' sAttrValue := '10.09' else
                      if Str6 = '08.451' sAttrValue := '10.12' else
                      if Str6 = '10.300' sAttrValue := '10.03' else
                      if Str6 = '10.900' sAttrValue := '10.09' else
                      if Str6 = '10.952' sAttrValue := '10.10' else
                      if Str6 = '10.152' sAttrValue := '10.13' else
                      if Str6 = '10.965' sAttrValue := '10.13' else
                      if Str6 = '10.902' sAttrValue := '10.13' else
                      if Str6 = '10.101' sAttrValue := '10.06' else
                      if Str6 = '10.900' sAttrValue := '10.09' else
                      if Str6 = '10.652' sAttrValue := '10.13' else
                      if Str6 = '10.550' sAttrValue := '10.05' else
                      if Str6 = 'Готовая продукция' sAttrValue := '43' ;

  LogStrToFile('#MC_imp_buh.txt', GetSrcAddres + ' > ' + Str6  + ' > ' +  sAttrValue);

                   if (getfirst BuhSchet where ((coGetTune('KONSOLID.CPLANSSCH') == Buhschet.CPLANSSCH and sAttrValue == Buhschet.CODE)) = tsOk)
                   {
                     sAttrValue := BuhSchet.Name;
                     cAttrValue := Buhschet.Nrec;
                   }
                   else
                   if (getfirst BuhSchet /* where ((cAttrValue == Buhschet.Nrec))*/ = tsOk)
                     sAttrValue := BuhSchet.Name;
                   }
              1412:
                  if (getfirst KatEd where ((cAttrValue == KatEd.Nrec)) = tsOk)
                     sAttrValue := KatEd.Name;
              1138:
                  if (getfirst Dover /*where ((cAttrValue == Dover.Nrec))*/ = tsOk)
                     sAttrValue := string(Dover.NoDoc);
              1485:
                  if (getfirst KatPayment /*where ((cAttrValue == KatPayment.Nrec))*/ = tsOk)
                     sAttrValue := KatPayment.Name;
              1418:
                  if (getfirst KatOrg where ((cAttrValue == KatOrg.Nrec)) = tsOk)
                     sAttrValue := KatOrg.Name;
              1115:
                  if (getfirst KlSkidka /* where ((cAttrValue == KlSkidka.Nrec))*/ = tsOk)
                     sAttrValue := KlSkidka.Name;
              5073: // Идентификатор государственного контракта
                  if Getfirst EXCLASSSEG where (( 24 ==EXCLASSSEG.CLASSCODE and UpCase(sAttrValue)==EXCLASSSEG.NAME (length = 40) )) = tsOK
                     cAttrValue := EXCLASSSEG.Nrec;
              7:{
                  if Getfirst MnPlan where (( 17 ==  MnPlan.TypePlan and sAttrValue == MNPLAN.NUMBER )) = tsOK
                     cAttrValue := MNPLAN.Nrec;
                }
/*
GetKauID(cgKau_Zakaz; sAttrValue : String; _Code: string; bKode : boolean = false) : Comp;
function GetKauID(_wKau: word; _Name : String; _Code: string; bKode : boolean = false) : Comp;
  case _wKau of
    cgKau_Zakaz      :  result := SetToMnPlan  (_Name, _Code, toMnfZakaz); // toMnfZakaz   = 17
                                                              MnPlan.TypePlan
              }
*/
              else
                  {}
              end; // case
            }

            if cAttrValue = comp(0)
            {
              if sErrorStr ='' sErrorStr := 'не определено';
              else
              if sAttrName <> '' sErrorStr := sErrorStr + '. Атрибут: ' + sAttrName;

              fun.Set_sCurFieldName(sErrorStr + ' ' + +GetSrcAddres);
              fun.LogError(0, constDocErrorCode, sAttrValue);
            }
            else
            {

              iexAttr.coSetAttr(coIEHFlds,tHeader.Nrec, sAttrName,cAttrValue,sAttrValue);

              if (GetFirst AttrNam where ((sAttrName  == AttrNam.Name and
                                            word(5)   == AttrNam.AttrType and
                                            coIEHFlds == AttrNam.wTable)) = tsOk)
              {
                AttrNam.rType := word(100);
                update current AttrNam;
              }
            }


           }

       End; // Case

}
Function ImportField( IsHeader : Boolean; wNumber : Word; Var sFieldValue : String ) : Boolean;
{
  if IsHeader
  if IEHFlds.CODE = String(iehPA + 22)
  {
    result := true;
    sFieldValue := string(lCurRow);
    exit;
  }

  var sFieldName : string = if (IsHeader, IEHFlds.DbfName, IESFlds.DbfName);
  if substr(sFieldName,1,1) = '=' // Значение указано в настройках импорта
  {
    sFieldValue := substr(sFieldName,2,255);
    result := true;
    exit;
  }

  result := inherited::ImportField(IsHeader, wNumber,sFieldValue);
}

Function ImportExcelField( sFieldName : string; iRow : longInt; Var sFieldValue : String ) : Boolean;
{
  lCurColumn := iFileStruct.GetIndexFieldByName(sFieldName);
  result := xlGetCellValue(iRow, lCurColumn, sFieldValue);
  sLastFieldValue := sFieldValue ;
}
end.
