Interface GP_ListXChangeImport 'Импорт листов замен из Excel' gray dialog;

Const
 pAttr_SPCOMMENT = '.Комментарий';
end;
var
Counter, MaxLine, MaxCol, npp : longint;
sFileName, nm_file: string;
lStatus, lKod1, lMC1, lEd1, lKod2, lMC2, lEd2,
 lKoeff, lDSEKOD, lOsnovanie, lDbeg, lDend, lTip, lOID, lComment: longint;

sStr, sBarkod, sNameMC, sEd, sKAUNAME,sKauNAMEXL, sOID, sOID_OLD, sComment: String;
wFlagDop, TipZAM_KAU: word;


create view jView
as select GP_ListXChange.cMc
from
 GP_ListXChange New_List
,GP_SpXChange New_SpList,katkau
,GP_ListXChange, GP_SpXChange, KatMC, KatED
where
((
    
               New_List.cmc == GP_ListXChange.cMc
    and GP_ListXChange.nrec == GP_SpXChange.cLxch
    and New_SpList.cmc      == GP_SpXChange.cmc
    and New_SpList.CMCDSE   == GP_SpXChange.CMCDSE (noindex)

and    sBarkod == KatMC.Barkod
and    KatMC.cEd == KatED.nRec

and TipZAM_KAU == spKau.KODGRKAU
and sKAUNAME   == spKau.NAME
))
;

screen scrImp;
fields
nm_file:NoProtect, PickButton;
wFlagDop:NoProtect;

buttons
      cmColTune; cmImport;
<<
  Импорт листов замены
  Файл Excel.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Обработка:`
 [.] Удалять Код МЦ из её наименования при чтении из Excel`
 [.] Обработка строки до первой ошибки`
 [.] Выделять фоном ячейки с ошибками при импорте`
 [.] Не проверять на дублирование, добавлять все данные из Excel`
 [.] Добавлять изменения в базу ERP`
 [.] Наименования МЦ НЕ проверять`
 [.] НЕ проверять Пустой OID`

    <. Проверить соответствие полей .>              <. Запустить Импорт .>

  версия1
>>
end;

function ReadColNumByNamesOK: boolean;
Var str: string;
   lCol:longint;
{
str := '';
lCol:=0;
lStatus :=0; lOID := 0;
lKod1   :=0;
lMC1    :=0;
lEd1    :=0;
lKod2   :=0;
lMC2    :=0;
lEd2    :=0;
lKoeff  :=0;
lDSEKOD :=0;
lOsnovanie :=0;
lDbeg   :=0;
lDend   :=0;
lTip    :=0;
lComment := 0;

    while lCol <= MaxCol // по Колонкам первой строки
    do
    {
      lCol++;

        xlgetcellvalue(1, lCol   ,str );
        str  := UpCase(trim( str ));
            Case str of
'OID'                 : lOID :=lCol;
'СТАТУС'              : lStatus   :=lCol;
'КОД ЗАМЕНЯЕМОГО'     : lKod1     :=lCol;
'ЗАМЕНЯЕМЫЙ КОМПОНЕНТ': lMC1      :=lCol;
'ЕИ ЗАМЕНЯЕМОГО'      : lEd1      :=lCol;
'КОД ЗАМЕНЯЮЩЕГО'     : lKod2     :=lCol;
'ЗАМЕНЯЮЩИЙ КОМПОНЕНТ': lMC2      :=lCol;

'ЕИ ЗАМЕНЯЮЩЕГО'      : lEd2      :=lCol;
'КОЭФФ. ЗАМЕНЫ'       : lKoeff    :=lCol;
'ТОЛЬКО ДЛЯ ДСЕ'      : lDSEKOD   :=lCol;
   'ДАТА НАЧАЛА','ДЕЙСТВУЕТ С' : lDbeg :=lCol;
'ДАТА ОКОНЧАНИЯ','ДЕЙСТВУЕТ ПО' : lDend :=lCol;
    'ТИП ЗАМЕНЫ','ВИД ЗАМЕНЫ' : lTip  :=lCol;
'ПРИМЕЧАНИЕ','КОММЕНТАРИЙ': lComment   :=lCol;
'ОСНОВАНИЕ ЗАМЕНЫ': lOsnovanie   :=lCol;

            end; // Case
    }

    if lKod1=0 or lMC1=0 or lKod2=0 or lMC2=0 or lKoeff=0 or lDSEKOD=0 or lComment=0
    {
        message ( 'Ошибка формата файла. Не найдена колонка'
                  +''#13'OID='              + lOID
                  +''#13'СТАТУС='              + lStatus
                  +''#13'КОД ЗАМЕНЯЕМОГО='     + lKod1
                  +''#13'ЗАМЕНЯЕМЫЙ КОМПОНЕНТ='+ lMC1      
                  +''#13'ЕИ ЗАМЕНЯЕМОГО='      + lEd1      
                  +''#13'КОД ЗАМЕНЯЮЩЕГО='     + lKod2
                  +''#13'ЗАМЕНЯЮЩИЙ КОМПОНЕНТ='+ lMC2      
                  +''#13'ЕИ ЗАМЕНЯЮЩЕГО='      + lEd2      
                  +''#13'КОЭФФ. ЗАМЕНЫ='       + lKoeff    
                  +''#13'ТОЛЬКО ДЛЯ ДСЕ='      + lDSEKOD
                  +''#13'ДАТА НАЧАЛА='      + lDbeg
                  +''#13'ДАТА ОКОНЧАНИЯ='   + lDend
                  +''#13'ТИП ЗАМЕНЫ='       + lTip
                  +''#13'Основание замены='         + lOsnovanie
                  +''#13'КОММЕНТАРИЙ='         + lComment

                );
       ReadColNumByNamesOK := False;
    }
    else
    ReadColNumByNamesOK := true;
}

procedure xlOut1(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOut1

var LineError: word;
procedure xlOutE(pCol:longint;pStr: string);
{
  LineError++;
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOutE

HandleEvent

cmINIT:
{
  if not ReadMyDsk(nm_file  , 'GP_ListImp_nm_file', false) nm_file := '';
  if not ReadMyDsk(wFlagDop , 'GP_ListImp_Flags'  , false) wFlagDop:= 111b;

                           // TipZAM_name = 'ТИП замен' см. GP_Common\Inc\gp_const.inc
   if getfirst katkau where ((TipZAM_name == katkau.code)) <> tsok then
     {
       message('Не найдена аналитика с кодом "'+TipZAM_name+'"');
       exit;
     }
     else
      {
       TipZAM_KAU:=katkau.kodgroup;
      }
}
cmColTune:
{
  if nm_file <> '' then sFileName := nm_file
  else
  {
    sFileName := 'GP_List.xlsx';
    sFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + sFileName ;
  }

  if (not ExistFile(sFileName))
  { message('Не файла "'+sFileName+'"',error);
    exit;
  }


    if (not xlOpenNewExcel(false))
    {
      message('Ошибка запуска Excel', Error);
      if not xlKillExcel
        message('Ошибка закрытия Excel', Error);
      exit;
    }

    if (not xlOpenWorkBook(sFileName))
    {
      Message('Ошибка открытия книги: "' + sFileName + '"');
      xlKillExcel;
      Exit;
    }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);
  Counter:=1;
  if ReadColNumByNamesOK
          message ( 'Найдены колонки'
                    +''#13'OID='              + lOID
                    +''#13'СТАТУС='              + lStatus
                    +''#13'КОД ЗАМЕНЯЕМОГО='     + lKod1
                    +''#13'ЗАМЕНЯЕМЫЙ КОМПОНЕНТ='+ lMC1
                    +''#13'ЕИ ЗАМЕНЯЕМОГО='      + lEd1
                    +''#13'КОД ЗАМЕНЯЮЩЕГО='     + lKod2
                    +''#13'ЗАМЕНЯЮЩИЙ КОМПОНЕНТ='+ lMC2
                    +''#13'ЕИ ЗАМЕНЯЮЩЕГО='      + lEd2
                    +''#13'КОЭФФ. ЗАМЕНЫ='       + lKoeff
                    +''#13'ТОЛЬКО ДЛЯ ДСЕ='      + lDSEKOD
                    +''#13'ДАТА НАЧАЛА='      + lDbeg
                    +''#13'ДАТА ОКОНЧАНИЯ='   + lDend
                    +''#13'ТИП ЗАМЕНЫ='       + lTip
                  +''#13'Основание замены='         + lOsnovanie
                  +''#13'КОММЕНТАРИЙ='         + lComment
                  );
  xlkillExcel;
} // cmColTune

cmImport:
{
  SaveMyDsk(nm_file    , 'GP_ListImp_nm_file');
  SaveMyDsk(wFlagDop   , 'GP_ListImp_Flags'  );

  if nm_file <> '' then sFileName := nm_file
  else
  {
    sFileName := 'GP_List.xlsx';
    sFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + sFileName ;
  }

  if (not ExistFile(sFileName))
  { message('Не найден шаблон файла "'+sFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(sFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sFileName+'".',error);
    exit;
  }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);


  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel ...', MaxLine div 5);

// Читаем заголовок и находим номера колонок по названию полей

Counter:=1;
        xlOut1( 1, 'Статус');
        xlOut1( 2, 'GP_SpXChange.nRec');//String(.nRec,0,0) );

if ReadColNumByNamesOK
while counter < MaxLine
do
{
  sComment := sOID := '';
  Counter++;
  if Counter mod 5 = 0
  {
    SetVisualHeader(counter + '/' + MaxLine);
    if not nextvisual break;
  }

  LineError := 0;

  // 1 Шапка. Кого меняем
  xlgetcellvalue(Counter, lKod1,sBarKOD); sBarKOD := Trim(sBarKOD);
  xlgetcellvalue(Counter, lMC1, sNameMC); sNameMC := Trim(sNameMC);

  if lEd1 > 0
  { xlgetcellvalue(Counter, lEd1, sEd    ); sEd :=   UpCase(trim( sEd )); }

  if (wFlagDop and 1b) > 0
  if Instr(sBarKOD, sNameMC) = 1
    sNameMC := trim(SubStr(sNameMC, length(sBarKOD)+2, 255));

  sBarKOD := LPadCh(sBarKOD,'0',10);
  if Instr(sBarKOD, sNameMC) = 1
    sNameMC := trim(SubStr(sNameMC, length(sBarKOD)+2, 255));
  if getfirst KatMC <> tsOK
  {
    xlOutE(1,'Не найдена МЦ по Коду');
    xlOut1(2,sBarKOD);
    if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lKod1, Counter, lKod1);
    if (wFlagDop and  10b) > 0 continue;
  }
  else
  if sNameMC <> KatMC.Name
  if InStr(KatMC.Name, sNameMC) = 0
  {
    if (wFlagDop and 100000b) = 0
    xlOutE(1,'Не то наименование МЦ с Кодом')
    else
    xlOut1(1,'Не то наименование МЦ с Кодом');

    xlOut1(2,sBarKOD);
    xlOut1(3,KatMC.Name);
    xlOut1(4,sNameMC);

    if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lMC1, Counter, lMC1);
    if (wFlagDop and 100000b) = 0 // Наименования МЦ НЕ проверять
    if (wFlagDop and  10b) > 0 continue;
  }

  if getfirst KatED <> tsOK
  {
    xlOutE(1,'В Базе данных нет Ед.Изм. у МЦ с Кодом');
    xlOut1(2,sBarKOD);
    if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lKod1, Counter, lKod1);
    if (wFlagDop and  10b) > 0 continue;
  }
  else
  if lEd1 > 0
  if UpCase(trim(KatED.ABBR)) <> sEd
  {
    xlOutE(1,'Другая Ед.Изм. в Базе данных у МЦ с Кодом ');
    xlOut1(2,sBarKOD);
    xlOut1(3,KatED.KOD);
    if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lKod1, Counter, lKod1);
    if (wFlagDop and  10b) > 0 continue;
  }

    clearbuffer(#New_List);
    clearbuffer(#New_spList);

    New_List.CMC := KatMC.nRec; // Запомним  KatMC для Шапки

  // 2 Спецификация. На Кого меняем
  xlgetcellvalue(Counter, lKod2,sBarKOD);
  xlgetcellvalue(Counter, lMC2, sNameMC);
  if lEd2 > 0
  { xlgetcellvalue(Counter, lEd2, sEd    ); sEd := UpCase(trim( sEd )); }

  if (wFlagDop and 1b) > 0
  if Instr(sBarKOD, sNameMC) = 1
    sNameMC := trim(SubStr(sNameMC, length(sBarKOD)+2, 255));

  sBarKOD := LPadCh(sBarKOD,'0',10);
  if Instr(sBarKOD, sNameMC) = 1
    sNameMC := trim(SubStr(sNameMC, length(sBarKOD)+2, 255));
  if getfirst KatMC <> tsOK
  {
    xlOutE(1,'Не найдена МЦ по Коду');
    xlOut1(2,sBarKOD);
    if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lKod2, Counter, lKod2);
    if (wFlagDop and  10b) > 0 continue;
  }
  if sNameMC <> KatMC.Name
  if InStr(KatMC.Name, sNameMC) = 0
  {
    if (wFlagDop and 100000b) = 0
    xlOutE(1,'Не то наименование МЦ с Кодом')
    else
    xlOut1(1,'Не то наименование МЦ с Кодом');

    xlOut1(2,sBarKOD);
    xlOut1(3,KatMC.Name);
    xlOut1(4,sNameMC);
    if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter,  lMC2, Counter, lMC2);

    if (wFlagDop and 100000b) = 0 // Наименования МЦ НЕ проверять
    if (wFlagDop and  10b) > 0 continue;
  }

  if getfirst KatED <> tsOK
  {
    xlOutE(1,'В Базе данных нет Ед.Изм. у МЦ с Кодом');
    xlOut1(2,sBarKOD);
    if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lKod2, Counter,  lKod2);
    if (wFlagDop and  10b) > 0 continue;
  }

  if lEd2 > 0
  if UpCase(trim(KatED.ABBR)) <> sEd
  {
    xlOutE(1,'Другая Ед.Изм. в Базе данных у МЦ с Кодом ');
    xlOut1(2,sBarKOD);
    xlOut1(3,KatED.KOD);
    if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lKod2, Counter,  lKod2);
    if (wFlagDop and  10b) > 0 continue;
  }


  New_spList.CMC := KatMC.nRec; // Запомним KatMC для спецификации 1


  // 3 Спецификация. Применение только для ДСЕ
  xlgetcellvalue(Counter, lKoeff,  sStr);
  sStr := Replace(Trim(sStr),',','.');
  New_spList.KOEF := Double(sStr);
  if New_spList.KOEF < 1e-10
  {
      xlOutE(1,'Не верное значение коффициента замены');
      if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lKoeff, Counter,  lKoeff);
      if (wFlagDop and  10b) > 0 continue;
  }


  xlgetcellvalue(Counter, lDSEKOD,  sBarKOD);

  if sBarKOD <> ''
  {
    sBarKOD := LPadCh(sBarKOD,'0',10);
    if getfirst KatMC <> tsOK
    {
      xlOutE(1,'Не найдена МЦ по Коду');
      xlOut1(2,sBarKOD);
      if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lDSEKOD, Counter,  lDSEKOD);
      if (wFlagDop and  10b) > 0 continue;
    }
    else
    New_spList.CMCDSE := KatMC.nRec; // Запомним KatMC для спецификации 1
  }

  #define _DateS(_Str) date(substr(#_Str,1,2),substr(#_Str,4,2),substr(#_Str,7,4))

  xlgetcellvalue(Counter, lDbeg, sStr);
  sStr := Trim(sStr);
//LogStrToFile('#DocImp.log' , 'sStr = ' + sStr);
//LogStrToFile('#DocImp.log' , 'Date(sStr) = ' + #_DateS(sStr));
  if sStr <> '' New_spList.DBEG := #_DateS(sStr);
  xlgetcellvalue(Counter, lDend, sStr);
  sStr := Trim(sStr);
//LogStrToFile('#DocImp.log' , 'sStr = ' + sStr);
//LogStrToFile('#DocImp.log' , 'Date(sStr) = ' + #_DateS(sStr));
  if sStr <> '' New_spList.DEND := #_DateS(sStr);

  if New_spList.DEND > Date(0,0,0)
  if New_spList.Dbeg > Date(0,0,0)
  if New_spList.DEND < New_spList.Dbeg
  {
      xlOutE(1,'Не верный период');
      xlOut1(2, DateToStr(New_spList.Dbeg , 'DD.MM.YYYY > ') + DateToStr(New_spList.DEND, 'DD.MM.YYYY'));

      if (wFlagDop and 100b) > 0
      {
         if Abs(lDend-lDbeg) = 1
           xlSetBackColor( 49407 , Counter, lDbeg, Counter,  lDend)
         else
         {
           xlSetBackColor( 49407 , Counter, lDbeg, Counter,  lDbeg);
           xlSetBackColor( 49407 , Counter, lDend, Counter,  lDend);
         }
      }
      if (wFlagDop and  10b) > 0 continue;
  }


  if lTip > 0
  {
    xlgetcellvalue(Counter, lTip,  sKauNAMEXL);
    sKauNAME := sKauNAMEXL;
    if getfirst spKAU <> tsOK
    {
      if sKauNAME = 'Возможная замена' sKauNAME := 'Допустимые';

      if getfirst spKAU <> tsOK
      {
        xlOutE(1,'Не найден spKAU для типа замены');
        xlOut1(2,sKauNAME);
        if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, lTip, Counter, lTip);
        if (wFlagDop and  10b) > 0 continue;
      }
      else
      New_spList.CTIP := spKAU.nRec;
    }
    else
    New_spList.CTIP := spKAU.nRec;
  }

  if lOsnovanie > 0
  {
    sStr := '';
    xlgetcellvalue(Counter, lOsnovanie, sStr);
    New_spList.PRIM := sStr;
  }
  if lComment > 0
  {
    sStr := '';
    xlgetcellvalue(Counter, lComment, sStr);
    sComment := trim(sStr);
  }


  if lOID > 0
  xlgetcellvalue(Counter, lOID,  sOID);
  sOID := Trim(sOID);

  if sOID = ''
  if (wFlagDop and 1000000b) = 0 // НЕ проверять Пустой OID
  xlOutE(1,'Пустой OID');

  // Проверка на дублирование
  if (wFlagDop and 1000b) = 0
  {
      var cSpXChange : comp = comp(0);

      _Loop GP_ListXChange
      {
        if cSpXChange <> comp(0) break
        else
        {
          _Loop GP_SpXChange
          {
            cSpXChange := GP_SpXChange.nrec;
            xlOutE(1,'Уже есть такой лист замены');
            xlOut1(2,String(GP_SpXChange.nrec,0,0));
            xlOut1(3,String(GP_SpXChange.KOEF));

            sOID_OLD := sGetAttr(31587, GP_SpXChange.nrec,'.OID' );

            if sOID_OLD <> sOID
            {
              xlOut1(4,sOID_OLD);
              xlOut1(5,sOID);

           //   if (wFlagDop and 10000b) > 0 // Добавлять изменения в базу ERP
             //   sSetAttr(31587, GP_SpXChange.nrec, '.OID', sOID );
            }


             break;
          }
        }
        if cSpXChange <> comp(0) break
      } // _Loop GP_ListXChange

      if cSpXChange <> comp(0)
        continue;
  }

  if LineError > 0
  {
    if (wFlagDop and 100b) > 0 xlSetBackColor( 49407 , Counter, MaxCol+1, Counter, MaxCol+1);
  }
  else
  if (wFlagDop and 10000b) = 0 // Добавлять изменения в базу ERP
  {
      xlOut1(1,'Проверено OK');
  }
  else
  if (wFlagDop and 10000b) > 0 // Добавлять изменения в базу ERP
  {
    if Getfirst GP_ListXChange = tsOK
    New_List.buffer := GP_ListXChange.buffer
    else
    {
      New_List.STATUS := 1;
      New_List.CSTATUS:= 000A0000000000CEh;
      if insert current New_List = tsOK {}
    }

    if New_spList.DBEG = Date(0,0,0) New_spList.DBEG := Date(1,1,2001);

    New_spList.cLxch := New_List.nREC;
    if insert current New_spList = tsOK
    {
      if sOID <> ''
      sSetAttr(31587, New_spList.nrec, '.OID', sOID);// атрибут для ESB
      sSetAttr(31587, New_spList.nrec, pAttr_SPCOMMENT, sComment); // 'Примечание' ('Примечание к позиции листа замены'): [25], NoPickButton;


      xlOut1(1,'Добавлен');
      xlOut1(2,String(New_spList.nRec,0,0));
    }

  }
}

xlkillExcel;
StopVisual('',0);

} // cmImport:

cmPick:
{ case CurField of
  #nm_file:
  { var ww_str:string=GetFileName('*.xls;*.xlsx','Выберите файл c данными по Листам замены');
    if ww_str<>''
    {
       set nm_file:=ww_str;
    }
  }
  end;
} // cmPick:

end; // HandleEvent
End. // interface
