Interface GP_McAttrImp 'Импорт атрибутов Матценностей из Excel' gray dialog;

var
Counter, MaxLine, MaxCol, npp : longint;
sFileName, nm_file: string;

lBarkod     : longint;
lMarka      : longint;
lProfile    : longint;
lProfileGOST: longint;
lMarkaGOST  : longint;
lGOST       : longint;

sMCKOD      : string;
sMarka      : string;
sProfile    : string;
sProfileGOST: string;
sMarkaGOST  : string;
sGOST       : string;

sValue : string;
sStr: string;
wFlagDop: word;
NeedUpDateMC: word;

DCol: longint; // смещение для вывода старых значений


create view jView
as select KatMC.nRec
from
 KatMC
where
((
   sMCKOD == KatMC.BARKOD
))
;

screen scrImp;
fields
nm_file:NoProtect, PickButton;
wFlagDop:NoProtect;

buttons
      cmColTune; cmImport;
<<
  Импорт Атрибутов МЦ
  Файл Excel.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Обработка:`
 [.] Менять Атрибуты в ERP`
 [.] Update KATMC`

    <. Проверить соответствие полей .>              <. Запустить Импорт .>

  версия 0.1
>>
end;

function ReadColNumByNamesOK: boolean;
Var str: string;
   lCol:longint;
{
  lBarkod := lGOST := lMarka := lProfile := lProfileGOST := lMarkaGOST := 0;
  lCol:=0; str := '';
    while lCol <= MaxCol // по Колонкам первой строки
    do
    {
      lCol++;
      xlgetcellvalue(1, lCol, str);
      str := trim( str );
            Case str of
'Ном.№'             : lBarkod    :=lCol;
'Марка'             : lMarka     :=lCol;
'Профиль'           : lProfile   :=lCol;
'ГОСТ'              : lGOST      :=lCol;
'ГОСТ на марку'     : lMarkaGOST :=lCol;
'ГОСТ на сортамент' : lProfileGOST :=lCol;
/*
'ДатаДокумента'             : lDOC      :=lCol;
'НомерДокумента'            : lDOC1Ckod :=lCol;
'ДатаОплаты'                : lDOPL     :=lCol;
'ДокументРасчетов'          : lDOCName  :=lCol;
'ВалютаЗадолженности'       : lVal      :=lCol;
'СуммаЗадолженностиВВалюте' : lSumVal   :=lCol;
'СуммаЗадолженности'        : lSum      :=lCol;*/
            end; // Case
    }

    if lBarkod = 0 or  lGOST = 0 or  lMarka = 0 or  lProfile = 0 or  lProfileGOST = 0 or  lMarkaGOST = 0
    {
        message ( 'Ошибка формата файла. Не найдена колонка'
            +''#13'Ном.№'                  + lBarkod
            +''#13'Марка'                  + lMarka
            +''#13'Профиль'                + lProfile
            +''#13'ГОСТ'                   + lGOST
            +''#13'ГОСТ на марку'          + lMarkaGOST
            +''#13'ГОСТ на сортамент'      + lProfileGOST
            /*
            +''#13'ДатаДокумента'             + lDOC
            +''#13'НомерДокумента'            + lDOC1Ckod
            +''#13'ДатаОплаты'            + lDOPL
            +''#13'ДокументРасчетов'          + lDOCName
            +''#13'ВалютаЗадолженности'       + lVal
            +''#13'СуммаЗадолженностиВВалюте' + lSumVal
            +''#13'СуммаЗадолженности'        + lSum    */
                );
       ReadColNumByNamesOK := False;
    }
    else
    ReadColNumByNamesOK := true;

    DCol := lGOST;
    if DCol > lMarka       DCol :=lMarka ;
    if DCol > lProfile     DCol := lProfile;
    if DCol > lProfileGOST DCol := lProfileGOST;
    if DCol > lMarkaGOST   DCol := lMarkaGOST;
    DCol := 3 - DCol; // 3 - DCol;

    Message('DCol = ' + DCol);
//    if DCol >  DCol := ;
}// function ReadColNumByNamesOK: boolean;


procedure xlOut1(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOut1

var LineError: word;
procedure xlOutE(pCol:longint;pStr: string);
{
  LineError++;
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOutE



HandleEvent

cmINIT:
{
  if not ReadMyDsk(nm_file  , 'GP_MCAttrIMP_nm_file', false) nm_file := '';
  if not ReadMyDsk(wFlagDop , 'GP_MCAttrIMP_Flags'  , false) wFlagDop:= 111b;
}
cmColTune:
{
  if nm_file <> '' then sFileName := nm_file
  else
  {
    sFileName := 'GP_Saldo60.xlsx';
    sFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + sFileName ;
  }

  if (not ExistFile(sFileName))
  { message('Не файла "'+sFileName+'"',error);
    exit;
  }


    if (not xlOpenNewExcel(false))
    {
      message('Ошибка запуска Excel', Error);
      if not xlKillExcel
        message('Ошибка закрытия Excel', Error);
      exit;
    }

    if (not xlOpenWorkBook(sFileName))
    {
      Message('Ошибка открытия книги: "' + sFileName + '"');
      xlKillExcel;
      Exit;
    }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);
  Counter:=1;
  if ReadColNumByNamesOK
        message ( 'Найдены колонки:'
            +''#13'Ном.№'                  + lBarkod
            +''#13'Марка'                  + lMarka
            +''#13'Профиль'                + lProfile
            +''#13'ГОСТ'                   + lGOST
            +''#13'ГОСТ на марку'          + lMarkaGOST
            +''#13'ГОСТ на сортамент'      + lProfileGOST
                );
  xlkillExcel;
} // cmColTune

cmImport:
{
  SaveMyDsk(nm_file    , 'GP_MCAttrIMP_nm_file');
  SaveMyDsk(wFlagDop   , 'GP_MCAttrIMP_Flags'  );

  if nm_file <> '' then sFileName := nm_file
  else
  {
    sFileName := 'GP_MCAttrIMP.xlsx';
    sFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + sFileName ;
  }

  if (not ExistFile(sFileName))
  { message('Не найден шаблон файла "'+sFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(sFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sFileName+'".',error);
    exit;
  }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel ...', MaxLine);

// Читаем заголовок и находим номера колонок по названию полей

Counter:=1;
        xlOut1( 1, 'Статус');
        xlOut1( 2, 'Nrec Докумена');

if ReadColNumByNamesOK
while counter < MaxLine
do
{
  Counter++;
  NeedUpDateMC := 0; // признак изменения значения

//  if Counter > 10 break;
  if Counter mod 3 = 0
  {
//    SetVisualHeader(counter + '/' + MaxLine);
    if not nextvisual break;
  }

  LineError := 0;

#define xlReadString(_Col, _Svar) xlgetcellvalue(Counter, #_Col,#_Svar); #_Svar := Trim(#_Svar);

    #xlReadString(lBarkod     ,sMCKOD)
    if sMCKOD = ''
    {  xlOutE(1 , 'Нет Баркода') ; continue;}

    sMCKOD := LPADCH(sMCKOD,'0',10);
    if getfirst KATMC <> tsOK
    {
      xlOutE(1 , 'Не найдена МЦ ' + sMCKOD);
      continue;
    }

    #xlReadString(lMarka      ,sMarka      )
    #xlReadString(lProfile    ,sProfile    )
    #xlReadString(lProfileGOST,sProfileGOST)
    #xlReadString(lMarkaGOST  ,sMarkaGOST  )
    #xlReadString(lGOST       ,sGOST       )

#Declare UpDateATTR(_AttrVal,_AttrNAME)
    sValue := sGetAttr(coKatmc, Katmc.nRec,#_AttrNAME);
    if s#_AttrVal <> sValue
    {
       xlOut1( l#_AttrVal + DCol, sValue);
       sSetAttr(coKatmc, Katmc.nRec,#_AttrNAME,s#_AttrVal);
       xlSetBackColor( 49407 , Counter, l#_AttrVal, Counter, l#_AttrVal);
       NeedUpDateMC++;
    }
#end
    #UpDateATTR(Marka      ,'Марка')
    #UpDateATTR(Profile    ,'Профиль')
    #UpDateATTR(ProfileGOST,'.Профиль ГОСТ')
    #UpDateATTR(MarkaGOST  ,'.Марка ГОСТ')

    if KATMC.GOST <> sGOST
    {
       xlOut1( lGOST, KATMC.GOST);
       KATMC.GOST := sGOST;
       xlSetBackColor( 49407 , Counter, lGOST, Counter, lGOST);

       if UpDate current Katmc = tsOK xlOut1(1,'Обновлено с ГОСТОм');
    }
    else
    if NeedUpDateMC > 0
    {
//      if KATMC.WBITFLAGS = 0 KATMC.WBITFLAGS := 1 ELSE KATMC.WBITFLAGS := 0;

  //    if UpDate current Katmc = tsOK 
       xlOut1(1,'НЕ Обновлено WBITFLAGS');
    }

    if NeedUpDateMC = 0
    xlOut1(1,'Одинаково');
    xlOut1(2, string(Katmc.nRec,0,0) );

}
xlkillExcel;
StopVisual('',0);

} // cmImport:

cmPick:
{ case CurField of
  #nm_file:
  { var ww_str:string=GetFileName('*.xls;*.xlsx','Выберите файл c данными по Задолженности');
    if ww_str<>''
    {
       set nm_file:=ww_str;
    }
  }
  end;
} // cmPick:

end; // HandleEvent
End. // interface
