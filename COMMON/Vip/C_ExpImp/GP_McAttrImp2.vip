#include ImpDefine.vih
#component "GP_Common"
Interface GP_MCAttrIMP2 'Импорт атрибутов Матценностей из Excel' gray dialog;

Const
xlBCYellow =   65535; // Желтый
xlBCBrown  =   49407; // Рыжий
xlBCGreen  = 5296274; // Зелёный
xlBCRed             =255; // Красный
xlBCDarkRed         =192; // ТемноКрасный
xlBC           =15773696; // Синий
xlBCDark       =12611584; // ТемноСиния
xlBCBlakBlue   = 6299648; // ЧёрноСиний
xlBCDarkPurple =10498160; // ТёмноФиолетовый
xlBCLiteGal    =15652797; // СветлоГалактический
xlBCGal        =15123099; // Галактический

xlBCError=xlBCBrown;
xlBCFindOK=xlBCLiteGal;
xlBCErrUpDate=xlBCYellow;

end;
Table struct mtAList
(
Name: string[80], // Наименование атрибута 
Col: longInt, // колонка
COut: longInt, // колонка куда выдавать старое значение
cAttrnam:comp, // ссылка на Атрибут
ATTRTYPE: word,
rObject : word,
// M: boolean,
NameList: string// варианты наименований в Excel
)
with index (
 i0 = Col
)
;

var
 refImpDef : C_EXPIMP::ImpDefine;
cCurrent_User: comp; // = UserId;
lCapLine, // строка заголовка,
Counter, MaxLine, MaxCol, npp : longint;
sFileName, nm_file: string;

lBarkod     : longint;

sMCKOD      : string;

gError: word;
sTune, sTuneOK,sError: String;

sValue : string;
Str, StrKod, StrName: string;
dd, dValue: double;
cc, cValue: comp;
wFlagDop: word;
NeedUpDateAtr, UpDateCnt: word;

DCol: longint; // смещение для вывода старых значений

var lNullLine, lNullLineCnt: LongInt;
create view jView
as select KatMC.nRec
from
 KatMC, mtAList, AttrNam, ExImLogE
where
((
   sMCKOD == KatMC.BARKOD

   and 0 == ExImLogE.cLogR // and ( cCurrent_User = ExImLogE.ATL_LASTUSER)
))
;

var wDataCount: word = 0;
function ReadColNumByNamesOK: boolean;
Var
   lCol:longint;
   wOK: word = 0;
{

  lBarkod := 0;

//  _LOOP mtAList {mtAList.Col := 0; Update current mtAList}
  Update all mtAList set mtAList.Col := 0;

  lCapLine := 1; lCol:=0; str := '';
    while (lCol <= MaxCol) and (lCapLine < 50)// по Колонкам lCapLine строки ищем заголовок
    do
    {
      lCol++;
      xlgetcellvalue(lCapLine, lCol, str);
      str := trim( str );
      str := Replace(str,''#13,' ');
      str := Replace(str,''#10,' ');
      str := Replace(str,'  ',' ');      str := Replace(str,'  ',' ');      str := Replace(str,'  ',' ');
            Case str of
'Позиции заявок':{
                   lCapLine++; wOK := 0; lCol:=0;
                   Update all mtAList set mtAList.Col := 0;
                   continue;
                 }
 'ТМЦ / Услуга':{
                  // Наименование МЦ
                }
'"Номенклатурный номер"','КодМЦ','Артикул', 'Баркод',
'Номенклатурный номер': lBarkod    :=lCol;
                else
                {
                  _LOOP mtAList
                    if mtAList.NAME = str {wOK++;mtAList.Col := lCol; Update current mtAList}
                    else
                    if Instr(';'+UpCase(str)+';',mtAList.NAMEList)>0 {wOK++;mtAList.Col := lCol; Update current mtAList}
                }
            end; // Case

      if lCol = MaxCol
      if lBarkod = 0
      {
        lCapLine++; wOK := 0; lCol:=0;
        Update all mtAList set mtAList.Col := 0;

        continue;
      }

    } // while lCol <= MaxCol // по Колонкам lCapLine строки


    gError :=0;  wDataCount := 0;
    sTuneOK := sTune := sError := '';
    _LOOP mtAList
    {
      sTune := sTune + ''#13+ mtAList.NAME + '= ' + mtAList.Col;
      if mtAList.Col = 0
      {
        sError := sError + ''#13+ mtAList.NAME;
        gError++;
      }
      else
      {
        sTuneOK := sTuneOK + ''#13+ mtAList.NAME + '= ' + mtAList.Col;
        wDataCount++;
      }

    }

    if lBarkod = 0 gError++;

    if lBarkod = 0 or gError > 0
    if not ( (wFlagDop and 10b) > 0 and  lBarkod > 0 and wOK > 0)  //
    {
        message ( 'Ошибка формата файла. Не найдена колонка'
            +''#13'Ном.№ = ' + lBarkod + sError );
       ReadColNumByNamesOK := False;
    }
    else
    ReadColNumByNamesOK := true;

    DCol := 4; // тут 4 - первая свободная ячейка лога справа от таблицы. см.
    _LOOP mtAList
    if mtAList.Col > 0
    {  mtAList.cOut := DCol++;
       UpDate current mtAList;
    }
}// function ReadColNumByNamesOK: boolean;

//------------------------------------
// Взято из C_ExpImp\vip\ExpImp\IMP\ImpDefine.vip
// Убрал поиск по Табельному номеру. Всегда по ФИО
// Причина: у пользователя не находит Persons по ФИО
//------------------------------------
// PERSONS
create view LinkToPersons
as select
  NRec, IsEmployee, FIO, TABNMB, STRTABN, AppDate
from
  Persons;

function SetToPersons(sFieldValue : string; isEmp : string; stabN : string = '') : comp;
var
  bRes : boolean = false;
  sError : string;
  dMaxAppDate : date = date(0,0,0);
{
  result := 0;
  if (sFieldValue = '' and stabN = '') exit;
  sError := sFieldValue + if (stabN <> '', ' c номером ' + stabN, '');
  //по умолчанию если не задано, то сотрудник
  {
    LinkToPersons._loop Persons where ((char(isEmp) == Persons.IsEmployee and
                                        sFieldValue == Persons.FIO))
    {
      bRes := true;
      if (LinkToPersons.Persons.AppDate > dMaxAppDate)
      {
        result := LinkToPersons.Persons.nRec;
        dMaxAppDate := LinkToPersons.Persons.AppDate;
      }
    }
    //если не нашли, то ищем среди работающих
    if (not bRes) and (isEmp <> 'С')
    {
      LinkToPersons._loop Persons where ((        'С' == Persons.IsEmployee and
                                          sFieldValue == Persons.FIO))
      {
        bRes := true;
        if (LinkToPersons.Persons.AppDate > dMaxAppDate)
        {
          result := LinkToPersons.Persons.nRec;
          dMaxAppDate := LinkToPersons.Persons.AppDate;
        }
      }
    }
    if(not bRes) and (isEmp = '')
      if(LinkToPersons.getfirst Persons where((sFieldValue == Persons.FIO(noindex))) = tsOk)
      {
        result := LinkToPersons.Persons.NRec;
        bRes := true;
      }
  }
  if (not bRes)
  {
    exit;
  }
  if (result = 0)
    result := LinkToPersons.Persons.nRec;
}
//function SetToPersons
//------------------------------------

screen scrImp;
fields
nm_file:NoProtect, PickButton;
buttons
      cmWinExTune; cmImport;
<<

  Импорт Атрибутов МЦ
  Файл Excel
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@



 <. Дополнительные Настройки .>                         <. Запустить Импорт .>

  примечание: Изменён поиск Отв. Исполнителя
>>
end;

Window wExTune;
screen scrWImp;
Show at (,,,11);
fields
nm_file:NoProtect, PickButton;
wFlagDop:NoProtect;

buttons
      cmColTune;
<<
  Импорт Атрибутов МЦ
  Файл Excel
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Обработка:`
 [.] Менять Атрибуты в ERP`
 [.] Не выдавать сообщение об ошибке, если можно загрузить хоть один атрибут`
 [.] Пропускать пустые ячейки. "Пусто = неопределено"`

              <. Проверить соответствие полей .>       

  версия 2.0 ( поиск Отв. Исполнитель напрямую)
>>
end;
Browse brAttr;
Show at (,12,,);
table mtAList;
fields
  mtAList.Col  '№ Колонки в Excel':[3], Protect;
  mtAList.Name 'Наименование атрибута':[30], Protect;
    mtAList.NameList 'Имена колонок':[30], Protect;
end;
HandleEvent
cmColTune:
{
  if nm_file = ''
  {
    Message('Укажите файл для импорта');
    SelectField(#nm_file);
    exit;
  }
  sFileName := nm_file ;

  if (not ExistFile(sFileName))
  { message('Не файла "'+sFileName+'"',error);
    exit;
  }


    if (not xlOpenNewExcel(false))
    {
      message('Ошибка запуска Excel', Error);
      if not xlKillExcel
        message('Ошибка закрытия Excel', Error);
      exit;
    }

    if (not xlOpenWorkBook(sFileName))
    {
      Message('Ошибка открытия книги: "' + sFileName + '"');
      xlKillExcel;
      Exit;
    }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);
  Counter:=lCapLine;
  if ReadColNumByNamesOK
        message ( 'Найдены колонки:'
            +''#13'Ном.№ = '                  + lBarkod + sTune );
  xlkillExcel;
  ReScanPanel(tnmtAList);
} // cmColTune
end; // HandleEvent
end; // Window

Procedure AddAttr(pS,pS2: string);
{
  if getfirst Attrnam where (( coKatMC == Attrnam.WTABLE and pS==Attrnam.NAME)) = tsOK
  {
    insert into mtAList set mtAList.Name := pS, mtAList.NameList := ';'+ UpCase(if(pS2='',pS,pS2) )+';' , mtAList.cAttrnam := Attrnam.nRec, 
    mtAList.ATTRTYPE := Attrnam.ATTRTYPE, mtAList.rObject := AttrNam.rObject; 
  }
  else
  {
    insert into mtAList set mtAList.Name := pS, mtAList.NameList := ';'+ pS+';'+ UpCase(pS)+';';
    sError := sError + ''#13+ pS;
    gError++;
  }
}


procedure xlOut1(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOut1

var LineError: word;
procedure xlOutE(pCol:longint;pStr: string);
{
  LineError++;
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
  xlSetBackColor( xlBCError , Counter, MaxCol+1, Counter, MaxCol+1);
}//  procedure xlOutE


HandleEvent // интерфейс

cmINIT:
{
  cCurrent_User:= UserId;
  lCapLine := 1; // строка заголовка, будет уточнена
  if not ReadMyDsk(nm_file  , 'GP_MCAttrIMPv2_nm_file', false) nm_file := '';
  if not ReadMyDsk(wFlagDop , 'GP_MCAttrIMPv2_Flags'  , false) wFlagDop:= 11111b;
  gError:= 0; sError := '';

//  AddAttr('МОЛ');
 AddAttr('Нормативный срок закупки','');
 AddAttr('Нормативный срок на входной контроль','');
 AddAttr('Нормативный срок поставки','');
 AddAttr('Ответственный исполнитель','ОТВ. ИСПОЛНИТЕЛЬ;"Отв.исполнитель";Отв.исполнитель');


//  AddAttr('Подразделение');
//  AddAttr('Раздел дефлятора');
//  AddAttr('ОКПД2');

  if sError <> ''
  {
    if gError = 1 if Yes<>Message('Продолжить??'#13'Не найден атрибут к МЦ:'#13 + sError) CloseInterface(cmCancel);
    if gError > 1 if Yes<>Message('Продолжить??'#13'Не найдены атрибуты к МЦ:'#13 + sError) CloseInterface(cmCancel);
  }
}

cmImport:
{
  SaveMyDsk(nm_file    , 'GP_MCAttrIMPv2_nm_file');
  SaveMyDsk(wFlagDop   , 'GP_MCAttrIMPv2_Flags'  );

  if nm_file = ''
  {
    Message('Укажите файл для импорта');
    SelectField(#nm_file);
    exit;
  }
  sFileName := nm_file ;

  if (not ExistFile(sFileName))
  { message('Не найден шаблон файла "'+sFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(sFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sFileName+'".',error);
    exit;
  }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel ...', MaxLine div 3);

// Читаем заголовок и находим номера колонок по названию полей

Var boOk: boolean = ReadColNumByNamesOK;

if (wFlagDop and 10b) = 0
if not boOk
  if wDataCount > 0
    boOk := Message('Можно загрузить данные только из '+String(wDataCount)+' колонок'+sTuneOK+''#13'Продолжить?',YESNO) = YES;

if boOk
{

  Counter:=lCapLine;

// Заголовки для протокола
  xlOut1( 1, 'Статус');
  xlOut1( 2, 'Katmc.Nrec');
  xlOut1( 3, 'Katmc.NAME');
  _Loop mtAList
     if mtAList.Col > 0
        xlOut1( mtAList.cOut, 'Атрибут ' + mtAList.Name);

xlSetBackColor( xlBCGal , Counter, MaxCol+1, Counter, MaxCol+wDataCount+2);

lNullLine := lNullLineCnt:=0;
while counter < MaxLine
do
{
  Counter++;

  LineError := 0; // Наличие ошибки в строке
  UpDateCnt := NeedUpDateAtr := 0; // признак изменения значения

  if Counter mod 3 = 0
    if not nextvisual break;


    xlgetcellvalue(Counter, lBarkod,sMCKOD);
    sMCKOD := Trim(sMCKOD);

    if sMCKOD = ''
    {  xlOutE(1 , 'Нет Баркода') ;

       xlSetBackColor( xlBCError , Counter, lBarkod, Counter,lBarkod);
       if lNullLine=0 lNullLine := Counter;
       lNullLineCnt++;
       continue;
    }

    lNullLine := lNullLineCnt:=0;
    if getfirst KATMC <> tsOK
    {
      sMCKOD := LPADCH(sMCKOD,'0',10);
      if getfirst KATMC <> tsOK
      {
        xlOutE(1 , 'Не найдена МЦ ' + sMCKOD);
        xlSetBackColor( xlBCError , Counter, lBarkod, Counter,lBarkod);
        continue;
      }

      if KATMC.isarch <> 0
      {
        xlOutE(1 , 'МЦ в Архиве' + sMCKOD);
        xlOut1(2, string(Katmc.nRec,0,0) );
        xlOut1(3, Katmc.NAME);

        While ( GetNext Katmc = tsOK )
        {
          if KATMC.isarch = 0
          {
            xlOut1(1 ,'');
            xlOut1(2, string(Katmc.nRec,0,0) );
            xlOut1(3, Katmc.NAME);
            LineError := 0;
            break;
          }
        }

        if LineError > 0 continue;
      }
    }

    _Loop mtAList
    if mtAList.Col > 0
    {
      xlgetcellvalue(Counter, mtAList.Col, Str);
      Str := Trim(Str);

      if Str = ''
      if (wFlagDop and 100b) > 0 continue;

      Case mtAList.ATTRTYPE of
      0:// строка
       {
         sValue := sGetAttr(coKatmc, Katmc.nRec,mtAList.NAME);
         if sValue <> Str
         {
           NeedUpDateAtr++;
           xlOut1( mtAList.cOut, sValue);

           if (wFlagDop and 1b) > 0
           if sSetAttr(coKatmc, Katmc.nRec, mtAList.NAME, Str)
           {
             xlSetBackColor( xlBCFindOK , Counter, mtAList.Col, Counter, mtAList.Col);
             UpDateCnt++;
           }
           else
           {
             // ошибка изменения атрибута
             xlSetBackColor( xlBCErrUpDate, Counter, mtAList.Col, Counter, mtAList.Col);
           }
         }
       }
      1: // число
       {
         Str := Replace(Str, ',','.');
         dd := double(Str);
         dValue := doGetAttr(coKatmc, Katmc.nRec,mtAList.NAME);
         if dValue <> dd
         {
           xlOut1( mtAList.cOut, dValue);
           NeedUpDateAtr++;

           if (wFlagDop and 1b) > 0
           if doSetAttr(coKatmc, Katmc.nRec, mtAList.NAME, dd)
           {
             UpDateCnt++;
             xlSetBackColor( xlBCFindOK , Counter, mtAList.Col, Counter, mtAList.Col);
           }
           else
           {
             // ошибки изменения атрибута
             xlSetBackColor( xlBCErrUpDate, Counter, mtAList.Col, Counter, mtAList.Col);
           }
         }
       }
      2: // Дата
       {}
      3: // Время
       {}
      4: // мемо-поле
       {}
      5: // ссылка
       {
         StrKod := StrName := '';
         StrKod := ExtractDelimitedWord(Str, 1, ' ');
         StrName := Trim(SubStr( Str, Length(StrKod)+1, 255));
// LogStrToFile('#_TEST_.txt', 'StrKod =' + StrKod  + ' StrName =' + StrName);

         if  mtAList.ROBJECT = cgKau_Persons // cgKau_Persons = 3
           cc := SetToPersons (Str, '', '');
         else
         {
           cc := refImpDef.GetKauID(mtAList.ROBJECT,StrName, StrKod);

           if cc = comp(0)
              Delete ExImLogE Where((0 == ExImLogE.cLogR and cCurrent_User == ExImLogE.ATL_OWNER (noindex) )); // побочный продукт refImpDef

           if cc = comp(0) cc := refImpDef.GetKauID(mtAList.ROBJECT, Str, '');

// LogStrToFile('#_TEST_.txt', 'KodKAU=' + mtAList.ROBJECT  + ' Str='+Str+' cc =' + string(cc,0,0) );

         }

         if cc = comp(0)
         {
            Delete ExImLogE Where((0 == ExImLogE.cLogR and cCurrent_User == ExImLogE.ATL_OWNER (noindex) )); // побочный продукт refImpDef
            xlOutE( mtAList.cOut, 'Не найдено в справочнике значение=' + str);
            xlSetBackColor( xlBCError , Counter, mtAList.Col, Counter, mtAList.Col);
         }
         else
         {
           cValue := coGetAttr(coKatmc, Katmc.nRec,mtAList.NAME);
           if cValue <> cc
           {
              NeedUpDateAtr++;
              sValue := sGetAttr(coKatmc, Katmc.nRec,mtAList.NAME); //  sGetAttr(1411,KATMC.nRec,'Ответственный исполнитель')
              xlOut1( mtAList.cOut, sValue);

              if cValue = comp(0)
              if sValue = ''
                xlOut1( mtAList.cOut, 'пусто' );
//            xlOut1( mtAList.cOut, 'sGetAttr('+coKatmc+', '+Katmc.nRec+','+mtAList.NAME+') = пусто' );
//              message('sGetAttr('+coKatmc+', '+Katmc.nRec+','+mtAList.NAME+')' );

              if (wFlagDop and 1b) > 0
              if coSetAttr(coKatmc, Katmc.nRec, mtAList.NAME, cc, Str)
              {
                xlSetBackColor( xlBCFindOK , Counter, mtAList.Col, Counter, mtAList.Col);
                UpDateCnt++;
              }
              else
              {
                xlSetBackColor( xlBCErrUpDate, Counter, mtAList.Col, Counter, mtAList.Col);

              }

           }
         }
       }
      end; // Case

    }

    if LineError > 0
      xlOut1(1,'Ошибка')
    else
    if UpDateCnt > 0
      xlOut1(1,'Обновлено')
    else
    if NeedUpDateAtr > 0
      xlOut1(1,'Есть различия')
    else
      xlOut1(1,'Одинаково');


    xlOut1(2, string(Katmc.nRec,0,0) );
    xlOut1(3, Katmc.NAME);

} // while counter < MaxLine do
}// if ReadColNumByNamesOK

if false // хорошая идея удалять лог под таблицей, но оно стирает реальные ошибку если в конце таблицы подряд нет баркода среди данных
if lNullLine > 0 xlDeleteRange(xlShiftToLeft,lNullLine,MaxCol+1,Counter,MaxCol+10); //  xlShiftToLeft   = -4159;

xlkillExcel;
StopVisual('',0);

} // cmImport:

cmPick:
{ case CurField of
  #nm_file:
  { var ww_str:string=GetFileName('*.xls;*.xlsx','Выберите файл c данными по Задолженности');
    if ww_str<>''
    {
       set nm_file:=ww_str;
    }
  }
  end;
} // cmPick:
cmWinExTune: RunWindowModal( wExTune );
end; // HandleEvent
End. // interface



