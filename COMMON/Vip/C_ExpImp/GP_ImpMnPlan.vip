/*
sql
select  MnPlan.number, SPMNPLAN.Number, SPSETAN.NAME, A1.VSTRING
from SPMNPLAN
inner join MNPLAN on SPMNPLAN.cMNPLAN = MNPLAN.nRec
inner join SPSETAN on SPSETAN.KODGRKAU  = 10027 and SPMNPLAN.CANVAL3 = SPSETAN.CKAU
inner join SPMNPL on SPMNPLAN.nrec = SPMNPL.CSPMNPLAN
inner join katmc on SPMNPLAN.CIZD = katmc.nrec
left join ATTRNAM on 1411 = ATTRNAM.WTABLE and 'Ответственный исполнитель' = ATTRNAM.NAME
