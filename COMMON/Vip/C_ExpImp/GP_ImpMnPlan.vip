and SPMNPLAN.WKODGR3 = 3
and SPMNPLAN.CMNPLAN = #comp(000B00000000616Dh)
and (A1.VCOMP is null or A1.VCOMP <> SPSETAN.CKAU)
;





sql
Update SPMNPLAN
set SPMNPLAN.CANVAL3 = Case when A1.VCOMP is null then COMP(0) else SPSETAN.CKAU end
from SPMNPLAN
inner join MNPLAN on SPMNPLAN.cMNPLAN = MNPLAN.nRec
inner join SPSETAN on SPSETAN.KODGRKAU  = 10027 and SPMNPLAN.CANVAL3 = SPSETAN.CKAU
inner join SPMNPL on SPMNPLAN.nrec = SPMNPL.CSPMNPLAN
