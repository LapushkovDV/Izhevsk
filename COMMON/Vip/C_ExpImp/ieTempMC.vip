#include oEdIzm.vih
// #2515 Импорт Каталога Матценностей из Excel в Галактику
#doc
<p>Импорт Каталога Матценностей из Excel в Галактику
<p>Добавлены новый поля для импорта KATMC:
KATMC.GOST
KATMC.PRMAT - Признак 0-Материал/1-ДСЕ/2-Инструмент, оснастка
KATMC.CTYPE - Тип матценности. Поиск по коду или по наименованию
KATMC.isarch - признак архивности,
<p>Добавлен импорт внешнего атрибута - строка
<p>Добавлен импорт внешнего атрибута - число
<p>Добавлен импорт внешнего атрибута - Ссылка
<p> Добавлены типы ссылок:
<p> Ссылка на Подразделение. Поиск по наименованиию подразделения. Влияет в дальнейшем для поиска МОЛ
<p> Ссылка на МОЛ. Поиск по наименованию МОЛ (обычно это ФИО сотрудника). Если ранее был поиск подразделения, то nRec этого подразделения будет ограничивать список МОЛ
<p> Ссылка на Сотрудника. Поиск по табельному номеру

<p>Добавлен импорт внешнего атрибута числа <- Номер записи источника (N строки Excel)

<p>Добавлено обновление существующей записи KatMC данными из импорта поиск по БарКОДУ

<p>ПЛАН: Добавлен импорт внешнего атрибута отложенной ссылки на запись KATMC, которая будет импортирована
   Алгоритм:
   необходимо импортировать 2 поля:
   ID записи и Ссылка на ID на запись по ID из "ID записи"
   1) При импорте из источника в память пишем ID в Атрибут-"Ссылку" в AttrVal.VLONGINT
   2) После вставки всех записей в базу, обновляем Атрибут-"Ссылку":
      ищщем ID=AttrVal.VLONGINT в атрибуте "Значение ID", и
#end


#component "C_ExpImp"
ieOtherKatalog DIALOG
  HelpLine 'Такой документ уже есть в базе.'
  HelpCtx   hcAllAFilterData
  StatusCtx scGalDial;
  fields
    sDocumentSignature1 ('') : string[255], protect;
    sDocumentSignature2 ('') : string[255], protect;
    sDocumentSignature3 ('') : string[255], protect;
  buttons
    cmOk      , default, closeowner , 'Заменить'     , hcAllBOk    , scGalDial;
    cmOkAll   ,        , closeowner , 'Заменить все' , hcAllBOk    , scGalDial;
    cmSkipThis,        , closeowner , 'Пропустить'        , hcAllBOk    , scGalDial;
    cmSkipAll ,        , closeowner , 'Пропустить все'    , hcAllBOk    , scGalDial;
    cmCancel  ,        , closeowner , 'Выход'             , hcAllBCancel, scGalDial;
<<'Предупреждение'

