// ImpDefine.vip
#component "C_ExpImp"

#include ImpDefine.vih
Alter InterFace ImpDefine;
overload
   function iImpDefine.SetToDefaultKatBank(cOrg : comp) : comp;
   function iImpDefine.SetToKatOtpEd(sFieldValue: string; shortName: string; sCMCUsl: comp; sPrMC: word; TipDoc: word; SubTipDoc: word) : comp;
   function iImpDefine.SetToKatParty(sName, sKod : string) : comp;
   function iImpDefine.SetToStZatr(_Name : String; _Code: string) : Comp;
end;

function iImpDefine.SetToDefaultKatBank(cOrg: comp): comp;
{
  result := comp(0);
  if(cOrg <> comp(0))
    if(LinkToKatBank.getfirst KatBank where((cOrg == KatBank.cOrg and 1 == KatBank.Aktiv)) = tsOk)
    {
      result := LinkToKatBank.KatBank.NRec;
    }
    else
      if(LinkToKatBank.getfirst KatBank where((cOrg == KatBank.cOrg and 2 >> KatBank.Aktiv)) = tsOk)
      {
        result := LinkToKatBank.KatBank.NRec;
      }
}
Create view vOtp
  var
    sEdKOD : String;
    cpMC : comp;
as select OtpED.nRec
from 
  ATTRNAM tEdKOD, AttrVAL vEdKOD, KatOtped OtpED
where
((
   1412 == tEdKOD.wtable and 'Код' == tEdKOD.NAME
   and tEdKOD.nRec == vEdKOD.CATTRNAM and sEdKOD== vEdKOD.VSTRING
   and  1 == OtpED.PRMC and cpMC == OtpED.CMCUSL and vEdKOD.CREC == OtpED.CKATED
))
;

function GetOtpEdByKOD(pMC: comp;pKOD: string[10]): comp; cacheable;
{                                                         
 Result := comp(0);
 vOtp.cpMC := pMC;  vOtp.sEdKOD := pKOD;
 if vOtp.Getfirst vEdKOD = tsok
   if vOtp.Getfirst OtpED = tsok  
     Result := vOtp.OtpED.nRec;
}

function SetToKatOtpEd(sFieldValue: string; shortName: string; sCMCUsl: comp; sPrMC: word; TipDoc: word; SubTipDoc: word) : comp;
{
  if word(sFieldValue) > 0 // значит тут код единицы измерения
  {
    result := GetOtpEdByKOD(sCMCUsl,sFieldValue);
    if result <> comp(0) exit;
  }
  result := inherited::SetToKatOtpEd(sFieldValue, shortName, sCMCUsl, sPrMC, TipDoc, SubTipDoc);
}
function SetToKatParty(sName, sKod : string) : comp;
var
  cResult : comp;
{
  SetToKatParty := comp(0);
  if((sName = '') and (sKod='')) exit;

  cResult := comp(0);
  if(sKod <> '')
    if(LinkToKatParty.getfirst KatParty where((sKod == KatParty.Kod)) = tsOk)
      cResult := LinkToKatParty.KatParty.nRec;

  if((cResult = comp(0)) and (sName <> ''))
    if(LinkToKatParty.getfirst KatParty where((sName == KatParty.Name)) = tsOk)
      cResult := LinkToKatParty.KatParty.nRec;

  if  (cResult = comp(0)  )
  if ( Longint(sKod) > 0  )
  {
    sKod := string(Longint(sKod));
    if(LinkToKatParty.getfirst KatParty where((sKod == KatParty.Kod)) = tsOk)
      cResult := LinkToKatParty.KatParty.nRec;
  }

  if(cResult = comp(0)) fun.LogError(0, constDocErrorCode, 'Наименование : '+sName+' Код : '+sKod);

  SetToKatParty := cResult;
}
function SetToStZatr(_Name : String; _Code: string) : Comp;
{
var  strError : string;

  result := 0;
  if ((_Code = '') and (_Name = '')) exit;
  strError := 'Статья затрат: ';
  if (_Name <> '')
  {
    if (LinkToStZatr.GetFirst FastFirstRow StZatr where((_Name == StZatr.Name)) = tsOk)
    {  result := LinkToStZatr.StZatr.NRec; exit; }
    strError +=  _Name + ' ';
  }

  if (_Code <> '')
  {
    if (LinkToStZatr.GetFirst FastFirstRow StZatr where((_Code == StZatr.Kod)) = tsOk)
      {result := LinkToStZatr.StZatr.NRec;  exit; }
    strError +=  ' Код: ' + _Code + ' ';
  }
  if (result = 0)
    fun.LogError(0, constDocErrorCode, strError);
}

end.
