/*************************************************************************************************\
* Наименование: Вывод в Excel протокола операции экспорта-импорта                                 *
* Контур/Модуль: Обмен бизнес-документами                                                         *
* Примечание:                                                                                     *
*     добавлена кнопка <.Печать протокола в Excel.>                                               *
* Вид работы  |Номер         |Дата      |Исполнитель              |Проект                         *
* ---------------------------------------------------------------------------------------------   *
* Разработка  |#2515         |18/06/2018|Шунин А.Г.               |НПО Энергомаш                  *
\*************************************************************************************************/

#component "C_EXPIMP"
alter interface ieLog;
ExtendFormats bPrint;

screen bPrint(,hcSwiftMProtocol,);
  show at (,23,,);
buttons
  cmOut2Excel;
<<
                                                                              <.Печать протокола в Excel.>
>>
end;

HandleEvent

  cmOut2Excel: // печать всего протокола
  {
    if( GetMarkerCount(hMarker) > 0 )
    {
      RunInterFace('ExpImpJournXL', hMarker, word(0));
    }
    else
    {
      if( IsValid(#ExImLogT) )
      {
        InsertMarker( hMarker, ExImLogT.nRec );
        RunInterFace('ExpImpJournXL', hMarker, word(0));
        ClearMarker( hMarker );
      }
      else
        Message('Не выбран протокол');
    }
  }
end;
end.
