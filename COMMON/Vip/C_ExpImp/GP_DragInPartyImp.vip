var wDataCount: word = 0;
function ReadColNumByNamesOK: boolean;
Var
   lCol:longint;
   wOK: word = 0;
{

  lPKOD := lPNAME := lBarkod := lDrag := lW0 := lKol := lSkl := 0;

  lCapLine := 1; lCol:=0; str := '';
    while (lCol <= MaxCol) and (lCapLine < 50)// по Колонкам lCapLine строки ищем заголовок
    do
    {
      lCol++;
      xlgetcellvalue(lCapLine, lCol, str);
      str := trim( str );
      str := Replace(str,''#13,' ');
      str := Replace(str,''#10,' ');
      str := Replace(str,'  ',' ');      str := Replace(str,'  ',' ');      str := Replace(str,'  ',' ');
            Case str of
'ТМЦ / Услуга':{
                  // Наименование МЦ
               }
'"Номенклатурный номер"','Номенклатурный номер',
             'КодМЦ','Артикул': lBarkod :=lCol;
       'КодСерии', 'КодПартии':   lPKOD := lCol;
'СерияНоменклатуры','НаименованиеПартии':  lPNAME := lCol;
    'ДрагМетал': lDrag := lCol;
   'ЛигатурныйВес' : lW1   := lCol;
   'Количество': lKol  := lCol;
   'ЧистыйВес' : lW0   := lCol;
        'Склад': lSkl  :=lCol;

            end; // Case

    }// while lCol <= MaxCol // по Колонкам lCapLine строки

    if lBarkod = 0 or lPNAME=0 or lPKOD = 0 or lW0 = 0 or lDrag = 0 or lKol = 0 or lSkl = 0 or lW1 = 0
    {
        message ( 'Ошибка формата. Не найдена колонка'
                        +''#13'КодПартии= ' + lPKOD
                        +''#13'ИмяПартии= ' + lPNAME
                        +''#13'ДрагМетал= ' + lDrag
                        +''#13'ЧистыйВес= ' + lW0
                       +''#13'Количество= ' + lKol
                       +''#13'Склад= ' + lSkl
                            +''#13'Ном.№= ' + lBarkod);

       ReadColNumByNamesOK := False;
    }
    else
    ReadColNumByNamesOK := true;
}// function ReadColNumByNamesOK: boolean;


screen scrWImp;
fields
nm_file:NoProtect, PickButton;
wFlagDop:NoProtect;
pDsopr :NoProtect;
wAccuracy:NoProtect;
wAccuracyPrc:NoProtect;
cntAkt:Protect;
buttons
cmAktsReLoad;  cmOut2DBF;    cmColTune; cmImport;
<<
  Импорт Даргов в Партии к Актам об излишках
  Файл Excel
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Обработка:`
 [.] Делать изменения в Базе`                 По Актам от.@@@@@@@@@@ только 013
 [.] Менять % у Драгов в Партии`
 [.] Добавлять Драги в Партии`
 [.] Обновлять Драги в позициях Актов`
                        Точность по Чистому весу:.@@знаков после запятой
                                  Точность по % :.@@знаков после запятой

      <.AktsReLoad .>       Найдено позиций Актов.@@@@@@@@@@@ v2.0  <. cmOut2DBF .>

    <. Проверить соответствие полей .>        <. Запустить сверку Драгов .>

 поиск МЦ+партия+склад10 в выгрузке Актов об излишках.
 "Не найдена МЦ" означает, что этой МЦ нет в Актах. Аналогично по "Не найдена Партия"

 Записи в ERP, которые не найдены в Excel
 см. файл mtKSDragFlag.xls, где xlFlag=0, а PDRAGNREC <> 0

 После внесения пробы из файла источника не сходится Чистый вес.
 Возможные причины:
 1) Проба (%) указана на Лигатурный вес а не на количество и количество <> Лигатурному весу
    решение : установить в spsopr. = Лигатурный вес. Пример:
    UpDate spSOPR where nrec = 000B00000006DF13h 
      set kolopl := 23.6564, KOLFACT := KOLOPL
         ,RVPRICE= SPSOPR.kol*SPSOPR.PRICE/SPSOPR.kolopl
         ,RPRICE = RVPRICE,  VPRICE = RVPRICE,  PRICE  = RVPRICE;

 2) Одна партия в разных разрезах с разной Пробой. 
    При этом в колонке "Статус PRC" будет: "Конфликт по % со строкой "
    решение: Сделать дубль партии и перевыбрать её вручную в Накладной и в Ордере
    указать код новой прартии в файле, повторить обработку.
    Через "дубль партии" можно решить любую ситуацию.


>>
end;

HandleEvent // интерфейс

cmINIT:
{
  pDsopr := date(31,12,2018);
  lCapLine := 1; // строка заголовка, будет уточнена
  if not ReadMyDsk(nm_file  , 'GP_DragInPartyImpnm_file', false) nm_file := '';
  if not ReadMyDsk(wFlagDop , 'GP_DragInPartyImpFlags'  , false) wFlagDop:= 11111b;
  if not ReadMyDsk(wAccuracy , 'GP_DragInPartyAccuracy'  , false) wAccuracy:= 6;
  if not ReadMyDsk(wAccuracyPrc , 'GP_DragInPartyAccuracyPrc'  , false) wAccuracyPrc:= 14;

  set wAccuracy := wAccuracy;
  set wAccuracyPrc := wAccuracyPrc;
  boAktDataValid := false;

  LoadKS;
}
cmColTune:
{
  if nm_file = ''
  {
    Message('Укажите файл для импорта');
    SelectField(#nm_file);
    exit;
  }
  sFileName := nm_file ;

  if (not ExistFile(sFileName))
  { message('Не файла "'+sFileName+'"',error);
    exit;
  }


    if (not xlOpenNewExcel(false))
    {
      message('Ошибка запуска Excel', Error);
      if not xlKillExcel
        message('Ошибка закрытия Excel', Error);
      exit;
    }

    if (not xlOpenWorkBook(sFileName))
    {
      Message('Ошибка открытия книги: "' + sFileName + '"');
      xlKillExcel;
      Exit;
    }

  if (xlIsExcelValid) xlSetActiveSheetByName('TDSheet');

  xlGetUsedRange(0,0,MaxLine,MaxCol);
  Counter:=lCapLine;
  if ReadColNumByNamesOK
  {
    xlkillExcel;
        message ( 'Найдены колонки:'
                        +''#13'КодПартии= ' + lPKOD
                        +''#13'ИмяПартии= ' + lPNAME
                        +''#13'ДрагМетал= ' + lDrag
                        +''#13'ЧистыйВес= ' + lW0
                        +''#13'Количество= ' + lKol
                        +''#13'Склад= ' + lSkl
                        +''#13'Ном.№= ' + lBarkod);
  }
  else
  {
    xlkillExcel;
  }
} // cmColTune

cmImport:
{
  Delete all mXLDrag;
  if not boAktDataValid
    LoadKS;

  SaveMyDsk(nm_file    , 'GP_DragInPartyImpnm_file');
  SaveMyDsk(wFlagDop   , 'GP_DragInPartyImpFlags'  );
  SaveMyDsk(wAccuracy   , 'GP_DragInPartyAccuracy'  );
  SaveMyDsk(wAccuracyPrc   , 'GP_DragInPartyAccuracyPrc'  );

  dblAccuracy := 0.1**(wAccuracy+1)*9.99999;
  dblAccuracyPrc := 0.1**(wAccuracyPrc+1)*9.99;
  if nm_file = ''
  {
    Message('Укажите файл для импорта');
    SelectField(#nm_file);
    exit;
  }
  sFileName := nm_file ;

  if (not ExistFile(sFileName))
  { message('Не найден шаблон файла "'+sFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(sFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sFileName+'".',error);
    exit;
  }

  if (xlIsExcelValid) xlSetActiveSheetByName('TDSheet');

  xlGetUsedRange(0,0,MaxLine,MaxCol);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel ...', MaxLine div 3);

// Читаем заголовок и находим номера колонок по названию полей

Var boOk: boolean = ReadColNumByNamesOK;

if boOk
{

  Counter:=lCapLine;

// Заголовки для протокола
  xlOut1( 1, 'Статус');
  xlOut1( 2, 'spsopr.Nrec');
  xlOut1( 3, 'KatParty.Nrec');
  xlOut1( 4, 'NalDrag.nRec');
  xlOut1( 5, 'KatParty.KOD');
  xlOut1( 6, 'KatParty.NAME');
  xlOut1( 7, 'Про партию');
  xlOut1( 8, 'чистый вес позиции');
  xlOut1( 9, 'pNalDrag.KOL');
  xlOut1(10, 'spsopr.KOL');
  xlOut1(11, 'New pNalDrag.KOL');
  xlOut1(12, 'Статус PRC');
  xlOut1(13, 'Дубль в данных');
  xlOut1(14, 'DesGR');
  xlOut1(15, 'NNN');
  xlSetBackColor( xlBCGal , Counter, MaxCol+1, Counter, MaxCol+15);

while counter < MaxLine
do
{
  Counter++;   LineError := 0;

  if Counter mod 3 = 0
    if not nextvisual { boOk := False ; break; }

    xlgetcellvalue(Counter, lBarkod,Str);
    Str := Trim(Str);

    if Str = ''
    {  xlOutE(1 , 'Нет Баркода') ;
       continue;
    }

  ClearBuffer(#mXLDrag);
  mXLDrag.Line := Counter;
  mXLDrag.MCKOD :=Str;

    xlgetcellvalue(Counter, lPKOD,Str);
    Str := Trim(Str);
    if Str = ''
    {  xlOutE(1 , 'Нет Кода Партии') ;
       continue;
    }
  mXLDrag.pKOD := Str;

    xlgetcellvalue(Counter, lPNAME,Str);
    Str := Trim(Str);
    if Str = ''
    {  xlOut1(1 , 'Нет Партии') ;
       // continue;
    }
  mXLDrag.pNAME := Str;

    xlgetcellvalue(Counter, lDrag,Str);
    Str := Trim(Str);
    if Str = ''
    {  xlOutE(1 , 'Нет ДрагаМеталла') ;
       continue;
    }
  mXLDrag.sDrag := Str;

  mXLDrag.cDrag := GetKatDrag(mXLDrag.sDrag);
    if mXLDrag.cDrag = 0
    {  xlOutE(1 , 'Не найден Драг'+ mXLDrag.sDrag) ;
         continue;
    }

    xlgetcellvalue(Counter, lSkl,Str);
    Str := Trim(Str);
    if Str = ''
    {  xlOutE(1 , 'Нет Склада') ;
       continue;
    }
  mXLDrag.Skl:= SubStr(Str,1,10);


  if getfirst mXLDragDB = tsOK
  {  xlOutE(1 , 'Пропускаю. Уже есть') ;
     xlOutE(2 , 'В строке =' ) ;
     xlOutE(3 , String(mXLDragDB.Line)) ;
     continue;
  }

  insert current mXLDrag;

   sMCKOD := mXLDrag.MCKOD;
    if getfirst KS_MC <> tsOK
    {
      sMCKOD := LPADCH(sMCKOD,'0',10);
      if getfirst KS_MC <> tsOK
      {
        xlOutE(1 , 'Не найдена МЦ ' + sMCKOD);
        continue;
      }
    }
   mXLDrag.MCKOD := sMCKOD;

//   xlOut1( 2, string(KS_MC.cmc,0,0) );

   sPKOD := mXLDrag.pKod;

    if getfirst KS_Party <> tsOK
    {
      sPKOD := LPADCH(sPKOD,'0',9);
      if getfirst KS_Party <> tsOK
      {
        xlOutE(1 , 'Не найдена Партия' + mXLDrag.pKod);
        continue;
      }
    }
   mXLDrag.MCKOD := sMCKOD;
   mXLDrag.cmc := KS_Party.cmc;
   mXLDrag.cParty:= KS_Party.cParty;

   UpDate Current mXLDrag;
  xlOut1( 3, String(mXLDrag.cParty,0,0));
  xlOut1( 5, KS_Party.PARTYKOD);
  xlOut1( 6, KS_Party.PARTYNAME);

   if getfirst KSPos <> tsOk
   {
      xlOutE(1 , 'Разрез в актах не найден');
      continue;

   }

   xlOut1(14, KSPos.DesGR);
   xlOut1(15, KSPos.NNN);


   if trim(KSPos.PARTYNAME)<> trim(mXLDrag.pNAME)
   {
      xlOut1(7 , 'Имя Партий не совпадает');
   }
   xlOut1(10,DoubleToStr(KSPos.spkol,'66666666666666666.999999999999999999999999'));

   xlgetcellvalue(Counter, lW1,Str); // ЛигатурныйВес
   mXLDrag.W1 := dW1 := MyDouble(Str);

   xlgetcellvalue(Counter, lKol,Str);
   mXLDrag.Kol := dKol := MyDouble(Str);

   xlgetcellvalue(Counter, lW0,Str); // ЧистыйВес
   mXLDrag.W0 := dW0 := MyDouble(Str);



   if dW1 > 0.0001
   if Abs(dKol - dW1) < 0.001 // Разница в 4 знаке
   {
     dKol := dW1;
     xlSetBackColor(xlBCGreen, counter,lW1, counter,lKol);
   }

   if dKol <> KSPos.spKOl
    xlSetBackColor(xlBCBrown, counter,MaxCol+10, counter,MaxCol+10);

   mXLDrag.Prc := dW0/dKol;
   UpDate current mXLDrag;

  var boRecW: boolean = ( getfirst mXLDrag2 = tsOk );
  if boRecW
   {
     xlOut1(12 , 'Конфликт по % со строкой=' + mXLDrag2.Line);
     xlSetCellStringValue('Конфликт по % со строкой=' + Counter ,mXLDrag2.Line,MaxCol+12,mXLDrag2.Line,MaxCol+12);
   }

   if LineError > 0 continue ;  // от xlOutE(1 , 'Разрез в актах не найден');

   var boUpDate: boolean = false;

   if getfirst KSDrag = tsOk
   {
      if KSDrag.xlFlag > 0 xlOut1( 13,'Дубль ');

      KSDrag.xlFlag := 1;
      UpDate current KSDrag;

      xlOut1(14, KSDrag.DesGR);
      xlOut1(15, KSDrag.NNN);

      xlOut1( 2, String(KSDrag.spNREC,0,0));
      xlOut1( 4, String(KSDrag.pDragNrec,0,0));
       Var spW0 : double = KSDrag.spKOl * KSDrag.DARG_KOL; // чистый вес по позиции

       xlOut1(8,DoubleToStr(spW0,'66666666666666666.9999999999999999'));
       xlOut1(9,DoubleToStr(KSDrag.DARG_KOL,'66666666666666666.999999999999999999999999'));

       if ABS(spW0 - dW0) > dblAccuracy
       {
         xlSetBackColor(xlBCBrown, counter,lW0, counter,MaxCol + 8);
         xlOut1( 1, 'Не совпадает Чистый вес');

         if not boRecW
         if dKol <> 0
         if (wFlagDop and 1) > 0
         if (wFlagDop and 10b) > 0
         if Getfirst NalDrag where (( KSDrag.pDragNrec == NalDrag.nRec)) = tsOK
         if NalDrag.Kol <> (dW0/dKol)
         {
           NalDrag.Kol := dW0/dKol;
           UpDate Current NalDrag;
           boUpDate := true;
           xlOut1( 1, 'Обновлена запись драга');
           xlOut1( 4, String(NalDrag.nRec,0,0));
           xlOut1(11,DoubleToStr(NalDrag.Kol,'66666666666666666.999999999999999999999999'));
         }
         else
         {
           xlOut1( 4, String(NalDrag.nRec,0,0));
           xlOut1(11,DoubleToStr(NalDrag.Kol,'66666666666666666.999999999999999999999999'));
         }
       }

   }
   else // if getfirst KSDrag = tsOk
   {
     xlOut1(1 , 'Нет записи драга');
     if not boRecW
     if (wFlagDop and 1) > 0
     if (wFlagDop and 100b) > 0
     if getfirst NalDrag where ((
            word(4)           == NalDrag.TiDk
        and mXLDrag.cParty    == NalDrag.cKatOs
        and mXLDrag.cDrag     == NalDrag.cKatDrag
       ))<>tsok
       { Clearbuffer(#NalDrag);
         NalDrag.TiDk     :=word(4)      ;
         NalDrag.cKatOs   :=mXLDrag.cParty;
         NalDrag.cKatDrag :=mXLDrag.cDrag  ;
         NALDRAG.VIDDRAG:=0; // Паспорт
         NalDrag.Kol:= dW0/dKol;
         insert current NalDrag;
            boUpDate := true;
         xlOut1( 1, 'Добавлена запись драга');
         xlOut1( 4, String(NalDrag.nRec,0,0));
         xlOut1(11,DoubleToStr(NalDrag.Kol,'66666666666666666.999999999999999999999999'));
       }
   }// else if

   if boUpDate  boAktDataValid := false;

   if boUpDate
   if (wFlagDop and 1000b) > 0
   {

   }

} // while counter < MaxLine do
}// if ReadColNumByNamesOK


xlkillExcel;

DELETE mtKSDrag WHERE xlFlag = 1;
DELETE mtKSDrag WHERE PDRAGNREC = 0;

jView.PutTableToDBF (#mtKSDrag,'mtKSDragFlag.xls',0);
jView.PutTableToDBF (#mXLDrag,'mXLDrag_All.xls',0);

StopVisual('',0);

if not boOk Message('Прервано пользователем');

} // cmImport:

cmPick:
{ case CurField of
  #nm_file:
  { var ww_str:string=GetFileName('*.xls;*.xlsx','Выберите файл c данными по Задолженности');
    if ww_str<>''
    {
       set nm_file:=ww_str;
    }
  }
  end;
} // cmPick:
cmOut2DBF:
{
  jView.PutTableToDBF (#mtKSDrag,'mtKSDrag.xls',0);
}
cmAktsReLoad:
{
  LoadKS;
}

end; // HandleEvent
End. // interface
