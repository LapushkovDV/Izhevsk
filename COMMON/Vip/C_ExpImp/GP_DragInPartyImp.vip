// component "C_EXPIMP"
#include ImpDefine.vih
#component "GP_Common"
Interface GP_DragInPartyImp 'Импорт Содержания драгов в Партии из Excel' gray dialog;

Const
xlBCYellow =   65535; // Желтый
xlBCBrown  =   49407; // Рыжий
xlBCGreen  = 5296274; // Зелёный
xlBCRed             =255; // Красный
xlBCDarkRed         =192; // ТемноКрасный
xlBC           =15773696; // Синий
xlBCDark       =12611584; // ТемноСиния
xlBCBlakBlue   = 6299648; // ЧёрноСиний
xlBCDarkPurple =10498160; // ТёмноФиолетовый
xlBCLiteGal    =15652797; // СветлоГалактический
xlBCGal        =15123099; // Галактический

xlBCError=xlBCBrown;
xlBCFindOK=xlBCLiteGal;
xlBCErrUpDate=xlBCYellow;

end;
;

table struct mXLDrag
(
  Line: longint,
  pKOD: string[20],
  pNAME: string,
  MCKOD: string[20],
  sDrag: string[20],
  cDrag: comp,
  cmc: comp,
  cParty: comp,
  W1:double,
  kol:double,
  W0:double,
  Prc:double,
  skl: string[10]
)
with index (
 i0 = Line, i1 = cParty + cmc + cDrag, i3 = pKOD + MCKOD+ sDrag + skl
)
;

table struct mtKSDrag
(
  NNN        :	double
 ,KS_NAME	   :	string
 ,MCBARKOD	 :	string
 ,MCNAME	:	string
 ,EDOKEI	:	string
 ,EDNAME	:	string
 ,SPKOL	  :	double
 ,DRAG_NAME : string
 ,DRAG_KOD	:	string
 ,DARG_KOL	:	double
 ,PARTYKOD	:	string
 ,PARTYNAME	:	string
 ,CPARTY	:	comp
 ,SPNREC	:	comp
 ,KSNREC	:	comp
 ,PDRAGNREC	:	comp
 ,cDRAG:	comp
 ,cmc:	comp
 ,skl: string[10]
 ,xlFlag: word
 ,DESGR:	string[30]
)
with index (
 i0 = nnn, i1 = cParty + cmc + Skl +cDrag, iMC = MCBARKOD + PARTYKOD
)
;

const
 ImportOwner = Comp(000A000000000072h); // UserID = Alt_Owner
 minNRec1 :comp = 100000000h;        // условно, Максимальный код из 1С
end;

var
lCapLine, // строка заголовка,
Counter, MaxLine, MaxCol, npp : longint;
sFileName, nm_file: string;

lPKOD,lPNAME, lBarkod, lDrag, lW1,lW0, lKol, lSkl  : longint;

sDrag, sPKOD, sMCKOD : string;
dW1,dW0, dKol : double;

Str: string;
wFlagDop, wAccuracy, wAccuracyPrc: word;
dblAccuracy, dblAccuracyPRC: double;
 boAktDataValid: boolean;
pDsopr: Date;
cntAkt: longint;

create view jView
as select mtKSDrag.*
from
   mXLDrag, mXLDrag mXLDragDB
 , mtKSDrag
 , mtKSDrag KS_MC
 , mtKSDrag KS_Party
 , mtKSDrag KSPos
 , mtKSDrag KSDrag
 , naldrag
 , mXLDrag mXLDrag2
where
((
    sMCKOD == KS_MC.MCBARKOD

and sMCKOD == KS_Party.MCBARKOD
and sPKOD == KS_Party.PARTYKOD

and mXLDrag.CPARTY == KSDrag.CPARTY
and mXLDrag.cmc    == KSDrag.cmc
and mXLDrag.Skl    == KSDrag.Skl
and mXLDrag.cDrag  == KSDrag.cDrag

and mXLDrag.CPARTY == KSPos.CPARTY
and mXLDrag.cmc    == KSPos.cmc
and mXLDrag.Skl    == KSPos.Skl


and mXLDrag.pKOD  == mXLDragDB.pKOD
and mXLDrag.MCKOD == mXLDragDB.MCKOD
and mXLDrag.sDrag == mXLDragDB.sDrag
and mXLDrag.skl   == mXLDragDB.skl


and mXLDrag.cParty == mXLDrag2.cParty
and mXLDrag.CMC    == mXLDrag2.CMC
and mXLDrag.cDrag  == mXLDrag2.cDrag // and (mXLDrag.Prc <> mXLDrag2.Prc)
  and ( ABS(mXLDrag.Prc - mXLDrag2.Prc) > dblAccuracyPrc )

and sDrag == KatDrag.Name
))
;

//==== преобразовать из Excel  в число
function MyDouble(w:string):double ;
{ w:=replace(w,',','.');
  w:=replace(w,' ','');
  w:=replace(w,chr(39),'');
  MyDouble:=double(w) ;
}

//----------------------------------------
Function GetKatDrag(_sname:string):comp; cacheable;
{ Result:=0;
  var ii:word;
  ii:=pos(' ',_sname);
  if ii>0
  { _sname:=SubStr(_sname,1,ii-1)
  }
  if _sname='Алмазы' _sname:='Алмаз';
  sDrag := _sname;
  if getfirst KatDrag = tsok
    Result:=KatDrag.Nrec;
} //Function GetKatDrag(_sname:string):comp; cacheable;

//----------------------------------------
procedure xlOut1(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOut1

// ----------------------------------------
var LineError: word;
procedure xlOutE(pCol:longint;pStr: string);
{
  LineError++;
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
  xlSetBackColor( xlBCError , Counter, MaxCol+1, Counter, MaxCol+1);
}//  procedure xlOutE

//----------------------------------------
procedure LoadKS;
{
StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Выборка данных из Актов...', 1);

  delete all mtKSDrag;

sql
select
  NUMxl.VDOUBLE NNN
 ,KATSOPR.name ks_NAME
 , katMC.barkod MCBarkod
 , katMC.name MCNAME
 , Cast(vEdKOD.VSTRING as string[10]) EdOKEI
 , OtpED.name EdNAME
 ,SPSOPR.KOLFACT spkol
 ,KATDRAG.NAME DRAG_Name
 ,KATDRAG.KOD DRAG_KOD
 ,pDRAG.KOL Darg_KOL
 ,katparty.KOD PartyKOD
 , katparty.NAME PartyNAME
 , katparty.nRec cParty
 , spsopr.nRec spNREC
 , katsopr.nRec ksNREC
 , pDRAG.nRec pDRAGNREC
 , pDRAG.cKatDrag cDRAG
 , spsopr.cmcusl cmc
 ,
 Case
 when KATSOPR.DESGR='10DR' then  SubString(Katsopr.name,22,10) // Остатки по регистру  781 Перфилов Алексей Михайлович
 when KATSOPR.DESGR='002' then  SubString(Katsopr.name,13,10) // Остатки 002 221 Друненков Сергей Владимирович

 else SubString(Katsopr.name,1,10) end skl
 , 0 xlFlag
 , KATSOPR.nSOPR + ' '+ KATSOPR.DESGR DESGR
from katsopr
left join SPSOPR on CSOPR=katsopr.nRec
left join KATMC on SPSOPR.cmcusl = katmc.nRec
left join KATPARTY on SPSOPR.cparty = katparty.nRec
left join AttrNam aNUMxl on 1110 = aNUMxl.wTable
               and aNUMxl.Name = 'Номер записи источника Excel'
left join Attrval NUMxl on  1110 = NUMxl.wTable
and SPSOPR.nRec = NUMxl.cRec and aNUMxl.nRec=NUMxl.CATTRNAM


left join KatOtped OtpED on spsopr.cOtpED = OtpED.nRec
left join nalDrag pDRAG on pDRAG.TIDK = 4  and SPSOPR.cParty = pDRAG.CKATOS
left join KATDRAG on pDRAG.CKATDRAG = KATDRAG.nRec

left join AttrNam tEdKOD on 1412 = tEdKOD.wtable and 'Код' = tEdKOD.NAME
left join AttrVal vEdKOD on tEdKOD.nRec = vEdKOD.CATTRNAM and OtpED.cKatED = vEdKOD.CREC

where
    KATSOPR.VIDSOPR = 611 and KATSOPR.DSOPR = #date(31,12,2018)
and KATSOPR.ATL_owner = #COMP(000A000000000072h)
and KATSOPR.NAME <>''
and ( KATSOPR.DESGR='' or KATSOPR.DESGR='10DR' )
// and ( KATSOPR.DESGR='' ) // or KATSOPR.DESGR='10DR' )
// and KATSOPR.DESGR=''
and KATSOPR.DOPR > 0
and KATSOPR.DESCR='GAL_IMPORT'
into mtKSDrag
;
 
