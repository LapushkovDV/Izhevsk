Interface GP_SaldoOrgChk 'Сверка сальдо по контрагентам 60,62 из Excel' gray dialog;

var
Counter, MaxLine, MaxCol, npp : longint;
sFileName: string;

lVID      : longint; //sVID      : string; // ВидЗадолженности	Дебиторская
lBSCH     : longint; //sBSCH     : string; // СчетРасчетов	60.02
lOrg1Ckod : longint; //sOrg1Ckod : string; // КодКонтрагента	000011106
lOrg      : longint; //sOrg      : string; // Контрагент	А-гифтс
lcDogovor : longint; //cDogovor  : string; // КодДоговора	000025303
lsDogovor : longint; //sDogovor  : string; // Договор	Договор-счет № 1029 от 09.06.2018 поставка бейсболок и футболок с логотипом
lDOC      : longint; //dDOC      : Date;   // ДатаДокумента	25.06.2018 0:00:00
lDOC1Ckod : longint; //sDOC1Ckod : string; // НомерДокумента	00000246412 // tHeader.CDOGDS или CALPLAN.nRec
lDopl     : longint; //DOPL      : Date;   // ДатаОплаты	22.08.2018 0:00:00
lDOCName  : longint; //sDOCName  : string; // ДокументРасчетов	Платежное поручение исходящее 00000246412 от 25.06.2018 0:00:00
lVal      : longint; //sVal      : string; // ВалютаЗадолженности	руб. EUR USD
lSumVal   : longint; //dSumVal   : double; // СуммаЗадолженностиВВалюте	10 108,56
lSum      : longint; //dSum      : double; // СуммаЗадолженности	10 108,56
lnRec     : longint; //nRec документа, импортированого в систему


sStr: string;
dDBL: double;
pCDOGOVOR: comp;
wFlagDop: word;
byDOPL: boolean;
DSALDO: date = Date(31,10,2018);
  minNRec1 :comp = 100000000h;        // условно, Максимальный код из 1С

//------ документы из проводок ----
pT1, pT2: word;
table struct local tmGalDocs
(
    T1 : Word
   ,T2 : Word
  ,cRec: comp
)
with index
(
  tmGalDocs1 = T1 + T2 + cRec
);
//---------------------------------
// Данные из Excel и ссылки на справочники для создания документов
table struct tmOrgSaldo (
 NPP : longint, // Номер строки Excel 
 wErr: longint, // Ошибки 
 wVID      : word,   // ВидЗадолженности	1 = Дебиторская 2=Кредиторская
 sBSCH     : string[10], // СчетРасчетов	60.02
 sOrg1Ckod : string[10], // КодКонтрагента     11106                                                          
 sOrg1Ckod0: string[10], // КодКонтрагента 000011106                                                          
 sOrg      : string, // Контрагент	А-гифтс                                                                    
 c1Dogovor : string[10], // КодДоговора	000025303                                                                  
 s1Dogovor : string, // Договор	Договор-счет № 1029 от 09.06.2018 поставка бейсболок и футболок с логотипом
 dDOC      : Date,   // ДатаДокумента	25.06.2018 0:00:00                                                 
 sDOC1Ckod : string[50], // НомерДокумента	1466 или Б/Н или 201371422 или РД191.СА.728-052-2012 и т.п.
 xlDOPL    : Date,       // ДатаОплаты	22.08.2018 0:00:00
 DOPL      : Date,       // ДатаОплаты	22.08.2018 0:00:00
 sDOCName  : string, // ДокументРасчетов	Платежное поручение исходящее 00000246412 от 25.06.2018 0:00:00
 sVal      : string, // ВалютаЗадолженности	руб. EUR USD                                                       
 dSumVal   : double, // СуммаЗадолженностиВВалюте	10 108,56                                                  
 dSum      : double, // СуммаЗадолженности	10 108,56

 dSumERP   : double, // Реальная сумма документа в ERP
 dSumERPv  : double, // Реальная сумма документа в ERP

 dSumRes   : double, // Реальная сумма документа в ERP
 dCursVal  : Date,   // Дата курса из ERP
 dCursRub  : double, // Курс из ERP

 cVal: comp, // валюта 
 cOrg: comp, // Контрагент
 cDogovor: comp,
 cAppDogovor: comp,
 CCALPLAN: comp,
 CFINPLAN: comp,
 cRec: comp, // результат - документ в Базе

 InERP: boolean,
 FldOk: boolean,
 boSum: boolean,
 ObtOk: boolean,
 wObt: word
  // lcDogovor lDOC1Ckod Year(lDOC)
) 
with index (
 i0 = NPP , i1 = sOrg1Ckod , icRec = cRec
)
;
table struct mtSchets(
SCH: string[20], SUB: string[20]
)
with index (
 i0 = SCH + SUB
)
;


// КодКонтрагента	КодДоговора	НомерДокумента	ДатаДокумента
// sOrg1Ckod) + c1Dogovor) +  sDOC1Ckod)  dDOC)

//---------------------------------
// Типы документов в зависимости от Вида Задолженности и счета
table struct mtTDOC(
 wVID : word,
 bschet : string[10], // '60.02'
 wDOC :word, // = 1 Plpor? = 2 Katsopr
 DIRECT:word,
 TIDK :word,
 TIDKGAL :word,
 MODEDOC :word
)
with index (
 i0 = wVID + bschet
)
;

create view jView
as select tmOrgSaldo.sOrg, tmGDF15.T1, tmGDF15.T2,tmGDF15.cRec
from
  tmOrgSaldo
 ,tmOrgSaldo tmOrgSaldo_ORG
 ,mtTDOC

 ,KLVAL
 ,KatORG
 ,KatORG KatORG0
 ,KatORG KatORGS
 ,CALPLAN ,DOGOVOR

 ,tmGalDocs, tmGalDocs tmGDF15

 ,KatSOPR, KatSOPR KatSOPR0, KatSOPR KatSOPR2
 ,PlPor, PlPor PlPor0, PlPor PlPor2
 ,oborot

 ,CALPLAN CALPLAN0, CALPLAN CALPLAN2
 ,CursVal
 ,mtSchets, mtSchets mtSchetsD, mtSchets mtSchetsK
where
((

    tmOrgSaldo.sOrg == KatORGS.CODE
 and tmOrgSaldo.sOrg1Ckod0 == KatORG0.CODE
 and tmOrgSaldo.sOrg1Ckod == KatORG.CODE
 and tmOrgSaldo.sOrg1Ckod == tmOrgSaldo_ORG.sOrg1Ckod

 and pCDOGOVOR == CALPLAN.nRec
              and CALPLAN.cDogovor == Dogovor.nRec

              and CALPLAN.nRec == CALPLAN0.CPREDPLAN
              and CALPLAN.CPREDPLAN == CALPLAN2.nRec
 and
    tmOrgSaldo.sVal == KLVAL.SIMVOLV

    and tmOrgSaldo.wVID == mtTDOC.wVID
    and tmOrgSaldo.sBSCH== mtTDOC.bschet

 and   tmOrgSaldo.cVal  == CursVal.KodValut
 and   tmOrgSaldo.DOPL >>= CursVal.DatVal

// Bounds _CREC =
and
   tmOrgSaldo.cRec == PlPor0.nRec
 and PlPor.TIDK   ==  PlPor2.TIDK
 and PlPor.DATVIP ==  PlPor2.DATVIP
 and PlPor.NODOK  ==  PlPor2.NODOK

 and PlPor.DIRECT  == PlPor2.DIRECT  (noindex)
 and PlPor.CVAL    == PlPor2.CVAL    (noindex)
 and PlPor.NAMEPL1 == PlPor2.NAMEPL1 (noindex)
 and PlPor.NAMEPL2 == PlPor2.NAMEPL2 (noindex)
 and PlPor.NAMEPL3 == PlPor2.NAMEPL3 (noindex)
 and PlPor.NAMEPL4 == PlPor2.NAMEPL4 (noindex)

and
    tmOrgSaldo.cRec == KatSopr0.nRec
 and KatSOPR.VIDSOPR == KatSOPR2.VIDSOPR
 and KatSOPR.DSOPR   == KatSOPR2.DSOPR
 and KatSOPR.NSOPR   == KatSOPR2.NSOPR
 and KatSOPR.CORG    == KatSOPR2.CORG (noindex)
 and KatSOPR.CVAL    == KatSOPR2.CVAL (noindex)
 and KatSOPR.NAME    == KatSOPR2.NAME (noindex)

and
   pT1 == tmGalDocs.T1 and
   pT2 == tmGalDocs.T2 and
   tmOrgSaldo.cRec == tmGalDocs.cRec
and
               pT1 == OBOROT.TIDK and
   tmOrgSaldo.cRec == OBOROT.cSoprDOC and
 0000000000010001h == OBOROT.CPLANSSCH and
               pT2 == OBOROT.TIDKGal (noindex)
and
OBOROT.SCHETO   == mtSchetsD.SCH  and
OBOROT.SUBOSSCH == mtSchetsD.SUB
and
OBOROT.SCHETK   == mtSchetsK.SCH  and
OBOROT.SUBSCHK  == mtSchetsK.SUB

  and root == mtSchets.SCH

))
;
Procedure LoadGalSoprDocs;
{
   sql select distinct
          oborot.TIDK    as T1
         ,oborot.TIDKGAL as T2
         ,oborot.CSOPRDOC as cRec
       from oborot
       where  #Comp(0000000000010001h) = OBOROT.CPLANSSCH and
                          :( DSALDO ) >= OBOROT.DATOB and
            ((
                 :( mtSchets.SCH ) = OBOROT.SCHETK   and
                 :( mtSchets.SUB ) = OBOROT.SUBSCHK
              )
              or
              (
                 :( mtSchets.SCH ) = OBOROT.SCHETO   and
                 :( mtSchets.SUB ) = OBOROT.SUBOSSCH
              ))
       into tmGDF15;
}
var wSchetX: word = 0;
procedure LoadGalDocs;
{
  var wKey: word = 0;

   if instr('60', OBOROT.SCHETK) > 0 or instr('62', OBOROT.SCHETK) > 0
   {
     wKey++;
     if getfirst mtSchetsK <> tsOK
     {
       mtSchets.SCH := OBOROT.SCHETK ;
       mtSchets.SUB := OBOROT.SUBSCHK;
       insert current mtSchets;

       LoadGalSoprDocs;
     }
   }// if instr...


   if instr('60', OBOROT.SCHETO) > 0 or instr('62', OBOROT.SCHETO) > 0
   {
     wKey++;
     if getfirst mtSchetsD <> tsOK
     {
       mtSchets.SCH := OBOROT.SCHETO ;
       mtSchets.SUB := OBOROT.SUBOSSCH;
       insert current mtSchets;

       LoadGalSoprDocs;
     }
   }// if instr...

   if wKey=0
   {
logStrToFile('1xx.txt','--------' + _CurDateTime);

       wSchetX++;
       mtSchets.SCH := OBOROT.SCHETK  + '_' + string(wSchetX);
       mtSchets.SUB := OBOROT.SUBSCHK + '_' + string(wSchetX);
       insert current mtSchets;
logStrToFile('1xx.txt',mtSchets.SCH +' ' + mtSchets.SUB );//+' ' + mtSchets.SCHETK +' ' + mtSchets.SUBSCHK);

       mtSchets.SCH := OBOROT.SCHETO  + '_' + string(wSchetX);
       mtSchets.SUB := OBOROT.SUBOSSCH+ '_' + string(wSchetX);
       insert current mtSchets;
logStrToFile('1xx.txt',mtSchets.SCH +' ' + mtSchets.SUB );//+' ' + mtSchets.SCHETK +' ' + mtSchets.SUBSCHK);

       sql select distinct
              oborot.TIDK    as T1
             ,oborot.TIDKGAL as T2
             ,oborot.CSOPRDOC as cRec
           from oborot
           where  #Comp(0000000000010001h) = OBOROT.CPLANSSCH and
                     :( OBOROT.SCHETO   ) = OBOROT.SCHETO   and
                     :( OBOROT.SUBOSSCH ) = OBOROT.SUBOSSCH and
                     :( OBOROT.SCHETK   ) = OBOROT.SCHETK   and
                     :( OBOROT.SUBSCHK  ) = OBOROT.SUBSCHK
                     and :( DSALDO ) >= OBOROT.DATOB
           into tmGDF15;

   }

}// procedure LoadGalDocs;

screen scrImp;
fields
byDOPL:NoProtect;
DSALDO:NoProtect;
sFileName:NoProtect, PickButton;
!wFlagDop:NoProtect;

buttons
      cmColTune; cmImport;
<<
  Сверка сальдо по контрагентам

 Для Накладных:
 (.) Дата курса = даты оплаты в источнике`
 (.) Дата курса валют ` .@@@@@@@@@@

 Для Платежей Дата курса = даты оплаты в источнике

  Файл Excel.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
! `Обработка:`
! [.] Создавать Услуги в Каталоге услуг в ERP`
! [.] Создавать Акты на услуги в ERP`
! [.] Создавать Платежные документы в ERP`
! [.] Выделять фоном ячейки с ошибками при Сверке`

    <. Проверить соответствие полей .>              <. Выполнить Сверку .>

  версия 1.0
>>
end;

function ReadColNumByNamesOK: boolean;
Var str: string;
   lCol:longint;
{
  lVID := lBSCH := lOrg1Ckod := lOrg := lsDogovor := lcDogovor := lDOC := 0;
  lDOC1Ckod := lDOPL := lDOCName := lVal:= lSumVal := lSum := lnRec := 0 ;

  lCol:=0; str := '';
    while lCol <= MaxCol // по Колонкам первой строки
    do
    {
      lCol++;
      xlgetcellvalue(1, lCol, str);
      str := trim( str );
            Case str of
'ВидЗадолженности'          : lVID      :=lCol;
'СчетРасчетов'              : lBSCH     :=lCol;
'КодКонтрагента'            : lOrg1Ckod :=lCol;
'Контрагент'                : lOrg      :=lCol;
'КодДоговора'               : lcDogovor :=lCol;
'Договор'                   : lsDogovor :=lCol;
'ДатаДокумента'             : lDOC      :=lCol;
'НомерДокумента'            : lDOC1Ckod :=lCol;
'ДатаОплаты'                : lDOPL     :=lCol;
'ДокументРасчетов'          : lDOCName  :=lCol;
'ВалютаЗадолженности'       : lVal      :=lCol;
'СуммаЗадолженностиВВалюте' : lSumVal   :=lCol;
'СуммаЗадолженности'        : lSum      :=lCol;
'Nrec Докумена','nRec','NREC' : lnRec := lCol;
            end; // Case
    }

    if lVID=0 or lBSCH=0 or lOrg1Ckod=0 or lOrg=0 or
       lcDogovor=0 or lsDogovor=0 or lDOC=0 or lDOC1Ckod=0 or lDOCName=0 or lVal=0 or lSumVal=0 or lSum=0 or lDOPL = 0
    {
        message ( 'Ошибка формата файла. Не найдена колонка'
            +''#13'ВидЗадолженности = '          + lVID
            +''#13'СчетРасчетов = '              + lBSCH
            +''#13'КодКонтрагента = '            + lOrg1Ckod
            +''#13'Контрагент = '                + lOrg
            +''#13'КодДоговора = '               + lcDogovor
            +''#13'Договор = '                   + lsDogovor
            +''#13'ДатаДокумента = '             + lDOC
            +''#13'НомерДокумента = '            + lDOC1Ckod
            +''#13'ДатаОплаты = '            + lDOPL
            +''#13'ДокументРасчетов = '          + lDOCName
            +''#13'ВалютаЗадолженности = '       + lVal
            +''#13'СуммаЗадолженностиВВалюте = ' + lSumVal
            +''#13'СуммаЗадолженности = '        + lSum
            +''#13'Nrec Докумена = '        + lnRec
                );
       ReadColNumByNamesOK := False;
    }
    else
    ReadColNumByNamesOK := true;
}// function ReadColNumByNamesOK: boolean;


procedure xlOut1(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOut1

var LineError: word;
procedure xlOutE(pCol:longint;pStr: string);
{
  LineError++;
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOutE


Procedure CheckPlPor;
{
   Clearbuffer(#PlPor);

   PlPor.TIDKGAL:= mtTDOC.TIDKGAL;//31;
   PlPor.TIDK   := mtTDOC.TIDK   ;//31;

   PlPor.NODOK:= tmOrgSaldo.sDOC1Ckod; // 	000752
   PlPor.DATVIP:= tmOrgSaldo.DDOC; //	04.10.2018
   PlPor.DATOB :=tmOrgSaldo.DOPL; // Дата оплаты
   PlPor.DATOTS:=PlPor.DATVIP;

   if mtTDOC.DIRECT = 1 PlPor.DIRECT := 1 else PlPor.DIRECT := 0;

   if PlPor.DIRECT = 0 // собственные документы
   {
       PlPor.CPLAT	:= coGetTune('MyOrg');
       PlPor.CPOL	:= tmOrgSaldo.cORG; //2814749767133303
   }
   else
   {
       PlPor.CPLAT:= tmOrgSaldo.cORG; //2814749767133303
       PlPor.CPOL	:= coGetTune('MyOrg');
   }


   PlPor.SUMPLAT := tmOrgSaldo.dSum;// 	101685440,11045000
   PlPor.CVAL    := tmOrgSaldo.cVal; //2
   if tmOrgSaldo.cVal <> comp(0)
   PlPor.SUMPLATV	:= tmOrgSaldo.dSumVal ;// 1557049,30000000

   PlPor.NAMEPL1 := tmOrgSaldo.sBSCH + ' ' + PlPor.DATVIP + ' ' + tmOrgSaldo.sOrg; //	30.06.2018 62.32 000001595 ЦЭНКИ
   PlPor.NAMEPL2 := tmOrgSaldo.sDOCName; //	Документ расчетов с контрагентом (ручной учет) 752 от 21.07.2011
   PlPor.NAMEPL3 := tmOrgSaldo.s1Dogovor; //	056-980-2008 от 04.06.2008 двигатель поставки №7 Продажа ЖРД 171-М  6 шт.
   PlPor.NAMEPL4 := tmOrgSaldo.sVal + ' ' + tmOrgSaldo.dSumVal + ' ' + tmOrgSaldo.dSum + ' ' + tmOrgSaldo.sOrg1Ckod0; //	USD 1 557 049,3 87 597 102,14


   if tmOrgSaldo.cRec = comp(0)
   { // ищем по значениям полей
     _Loop PlPor2
     {
         tmOrgSaldo.FldOk := tmOrgSaldo.InERP := true;

         tmOrgSaldo.cRec := PlPor2.nrec;

         tmOrgSaldo.boSum := ( Abs(PlPor.SUMPLAT  - PlPor2.SUMPLAT) < 0.01)  and
                             ( Abs(PlPor.SUMPLATV - PlPor2.SUMPLATV) < 0.01);

         tmOrgSaldo.dSumERP  := PlPor2.SUMPLAT ;
         tmOrgSaldo.dSumERPv := PlPor2.SUMPLATV;

         break;
     }
   }
   else
   {
    if getfirst PlPor0 = tsOK
    {
       tmOrgSaldo.InERP := true;
       tmOrgSaldo.FldOk := PlPor.TIDK   =  PlPor0.TIDK
                       and PlPor.DATVIP =  PlPor0.DATVIP
                       and PlPor.NODOK  =  PlPor0.NODOK
                      and PlPor.DIRECT  = PlPor0.DIRECT
                      and PlPor.CVAL    = PlPor0.CVAL
                      and PlPor.NAMEPL1 = PlPor0.NAMEPL1
                      and PlPor.NAMEPL2 = PlPor0.NAMEPL2
                      and PlPor.NAMEPL3 = PlPor0.NAMEPL3
                      and PlPor.NAMEPL4 = PlPor0.NAMEPL4 ;

         tmOrgSaldo.boSum := ( Abs(PlPor.SUMPLAT  - PlPor0.SUMPLAT) < 0.01)  and
                             ( Abs(PlPor.SUMPLATV - PlPor0.SUMPLATV) < 0.01);

         tmOrgSaldo.dSumERP  := PlPor0.SUMPLAT ;
         tmOrgSaldo.dSumERPv := PlPor0.SUMPLATV;

    }

 }



   pT1 := PlPor.TIDK   ;
   pT2 := PlPor.TIDKGAL;

  // if PlPor.TIDK = 33 and PlPor.TIDKGAL = 33
  tmOrgSaldo.DOPL := DSALDO;
var cc: word = 0;
  _Loop OBOROT
  {
    LoadGalDocs;
    cc++;
    if OBOROT.DATOB  <> tmOrgSaldo.DOPL tmOrgSaldo.wObt := tmOrgSaldo.wObt or 1b;
    if OBOROT.DATAOT <> tmOrgSaldo.DOPL tmOrgSaldo.wObt := tmOrgSaldo.wObt or 10b;
    if Abs(OBOROT.SUMOB    - tmOrgSaldo.dSumERP  ) > 0.009   tmOrgSaldo.wObt := tmOrgSaldo.wObt or 100b;
    if tmOrgSaldo.cVal = 0 or ( (OBOROT.TidK =10090 and OBOROT.TidKGAL=1 )or
                                (OBOROT.TidK =10091 and OBOROT.TidKGAL=2 ) )
    {
       if Abs(OBOROT.SUMVALUT - 0) > 0.009   tmOrgSaldo.wObt := tmOrgSaldo.wObt or 1000b;
    }
    else
    if Abs(OBOROT.SUMVALUT - tmOrgSaldo.dSumERPv ) > 0.009   tmOrgSaldo.wObt := tmOrgSaldo.wObt or 1000b;
  }
  if cc=0 tmOrgSaldo.wObt := tmOrgSaldo.wObt or 10000b;
  tmOrgSaldo.ObtOk := (tmOrgSaldo.wObt = 0);

  UpDate current tmOrgSaldo;

   _Loop tmGalDocs Delete current tmGalDocs;

  Counter := tmOrgSaldo.NPP;
  xlOut1(3,'PlPor ' + String(PlPor.TidK) + ' '+ String(PlPor.TidKGAL) );
  if tmOrgSaldo.cRec <> comp(0)
  xlOut1(4,String(tmOrgSaldo.cRec,0,0) );
} // Procedure CheckPlPor;

// для 
// Дебиторская
// 62.01	Акт на оказание услуг
// 62.21	Акт на оказание услуг
// Кредиторская
// 60.01	Акт на прием услуг
// 60.31	Акт на прием услуг

Procedure CheckAkt;
{
   Clearbuffer(#KatSOPR);

   KatSOPR.VidSopr := mtTDOC.TIDK;
   KatSOPR.TIPSOPR := mtTDOC.TIDKGAL; // 1 / 2

   KatSOPR.NAME := tmOrgSaldo.sBSCH + ' ' + tmOrgSaldo.sOrg1Ckod0 + ' ' + tmOrgSaldo.sOrg;

   KatSOPR.DESCR := 'GAL_IMPORT';
   KatSOPR.NSOPR := tmOrgSaldo.sDOC1Ckod;
   KatSOPR.CORG  := tmOrgSaldo.cORG ;
   KatSOPR.CDOGOVOR := tmOrgSaldo.cDogovor ;
   KatSOPR.CAppDOGOVOR := tmOrgSaldo.cAppDogovor ;
   KatSOPR.CCALPLAN := tmOrgSaldo.CCALPLAN;

   KatSOPR.VHODNAL	:= 1;
   KatSOPR.DSOPR    := tmOrgSaldo.DDOC; //	04.10.2018

   if tmOrgSaldo.CVAL = comp(0)
   {
     KatSOPR.SUMMA  := tmOrgSaldo.dSum;
     KatSOPR.SUMVAL := tmOrgSaldo.dSum;
   }
   else
   {
     KatSOPR.CVAL := tmOrgSaldo.CVAL;
     KatSOPR.CVALUT := KatSOPR.CVAL;
     KatSOPR.SUMMA  := tmOrgSaldo.dSum;
     KatSOPR.SUMVAL := tmOrgSaldo.dSumVal ;
   }


   KatSOPR.DOPR     := KatSOPR.DSOPR; 
   KatSOPR.YEARSOPR := Year(KatSOPR.DSOPR); // 2018

   if byDOPL
   tmOrgSaldo.DOPL  := DSALDO;
   UpDate current tmOrgSaldo;

   KatSOPR.DPRICE   := tmOrgSaldo.DOPL;


   if KatSOPR.VidSopr = 111 
   {
     KatSOPR.CGRUZFROM := tmOrgSaldo.CORG; // 2814749767131412
     KatSOPR.CGRUZTO   := coGetTune('MyOrg'); 
   }
   else
   {
     KatSOPR.CGRUZFROM := coGetTune('MyOrg'); 
     KatSOPR.CGRUZTO   := tmOrgSaldo.CORG; // 2814749767131412 
   }
   KatSOPR.CORGBASE  := tmOrgSaldo.CORG; //	2814749767131412
   KatSOPR.CORGPLAT := tmOrgSaldo.CORG; // 	2814749767131412

  if tmOrgSaldo.cRec = comp(0)
  { // ищем по значениям полей
    _Loop Katsopr2
    {
       tmOrgSaldo.FldOk := tmOrgSaldo.InERP := true;
       tmOrgSaldo.cRec := Katsopr2.nRec;

       tmOrgSaldo.boSum := ( Abs(KatSOPR.SUMMA  - Katsopr2.SUMMA) < 0.01)  and
                           ( Abs(KatSOPR.SUMVAL - Katsopr2.SUMVAL) < 0.01);

       tmOrgSaldo.dSumERP  := KatSOPR2.SUMMA;
       tmOrgSaldo.dSumERPv := KatSOPR2.SUMVAL;
       break;
    }
  }
  else
  if getfirst Katsopr0 = tsOK
  {
     tmOrgSaldo.InERP := true;
     tmOrgSaldo.FldOk :=  KatSOPR.VIDSOPR = KatSOPR0.VIDSOPR
                       and KatSOPR.DSOPR   = KatSOPR0.DSOPR
                       and KatSOPR.NSOPR   = KatSOPR0.NSOPR
                       and KatSOPR.CORG    = KatSOPR0.CORG
                       and KatSOPR.CVAL    = KatSOPR0.CVAL
                       and KatSOPR.NAME    = KatSOPR0.NAME;

      tmOrgSaldo.boSum :=  ( Abs(KatSOPR.SUMMA  - KatSOPR0.SUMMA) < 0.01)  and
                           ( Abs(KatSOPR.SUMVAL - KatSOPR0.SUMVAL) < 0.01);

      tmOrgSaldo.dSumERP  := KatSOPR0.SUMMA;
      tmOrgSaldo.dSumERPv := KatSOPR0.SUMVAL;
  }

   pT1 := KatSOPR.VIDSOPR;
   pT2 := pT1;

var cc: word = 0;
  _Loop OBOROT
  {
    LoadGalDocs;
    cc++;
    if OBOROT.DATOB  <> tmOrgSaldo.DOPL tmOrgSaldo.wObt := tmOrgSaldo.wObt or 1b;
    if OBOROT.DATAOT <> tmOrgSaldo.DOPL tmOrgSaldo.wObt := tmOrgSaldo.wObt or 10b;
    if Abs(OBOROT.SUMOB    - tmOrgSaldo.dSumERP  ) > 0.009   tmOrgSaldo.wObt := tmOrgSaldo.wObt or 100b;
    if tmOrgSaldo.cVal = 0
    {
       if Abs(OBOROT.SUMVALUT - 0) > 0.009   tmOrgSaldo.wObt := tmOrgSaldo.wObt or 1000b;
    }
    else
    if Abs(OBOROT.SUMVALUT - tmOrgSaldo.dSumERPv ) > 0.009   tmOrgSaldo.wObt := tmOrgSaldo.wObt or 1000b;
  }

  if cc=0 tmOrgSaldo.wObt := tmOrgSaldo.wObt or 10000b;
  tmOrgSaldo.ObtOk := (tmOrgSaldo.wObt = 0);

  UpDate current tmOrgSaldo;

   if tmOrgSaldo.InERP
   _Loop tmGalDocs Delete current tmGalDocs;

  Counter := tmOrgSaldo.NPP;
  xlOut1(3,'Katsopr ' + String(Katsopr.VidSopr) );
  if tmOrgSaldo.cRec <> comp(0)
  xlOut1(4,String(tmOrgSaldo.cRec,0,0) );

}// Procedure CheckAkt;


HandleEvent

cmINIT:
{
  if not ReadMyDsk(sFileName  , 'GP_Saldo60_nm_file', false)
     sFileName := '\\10.10.10.229\erp проектная документация\Реализация\Запросы данных\ЗД.25. Остатки по расчетам с контрагентами (Логистика) (++)\Предоставленные данные\СВЕРКА\остатки дкз_chk.xlsx';
  byDOPL := true;
//  if not ReadMyDsk(wFlagDop , 'GP_Saldo60_Flags'  , false) wFlagDop:= 111b;
                                                                                                   // plpor.MODEDOC
insert into mtTDOC set wVID :=1, bschet := '60.02', wDOC := 1, DIRECT := 2, TIDK := 10090, TIDKGAL := 1, MODEDOC := 2048; // 2048 Собственное платежное поручение	Сумма только в рублях
insert into mtTDOC set wVID :=1, bschet := '60.22', wDOC := 1, DIRECT := 2, TIDK :=    31, TIDKGAL :=31, MODEDOC := 2048; // Собственное Валютное платежное поручение
insert into mtTDOC set wVID :=1, bschet := '60.32', wDOC := 1, DIRECT := 2, TIDK := 10090, TIDKGAL := 1, MODEDOC := 2048; // Собственное платежное поручение	Сумма в рублях и в ВАЛЮТЕ 000B000000000C70h

insert into mtTDOC set wVID :=2, bschet := '62.02', wDOC := 1, DIRECT := 1, TIDK := 10091, TIDKGAL :=  2, MODEDOC := 1048; //1024 Стороннее платежное поручение
insert into mtTDOC set wVID :=2, bschet := '62.22', wDOC := 1, DIRECT := 1, TIDK :=    33, TIDKGAL := 33, MODEDOC := 1048; // Стороннее валютное платежное поручение
insert into mtTDOC set wVID :=2, bschet := '62.32', wDOC := 1, DIRECT := 1, TIDK := 10091, TIDKGAL :=  2, MODEDOC := 1048; // Стороннее платежное поручение

insert into mtTDOC set wVID :=1, bschet := '62.01', wDOC := 2, TIDK := 211, TIDKGAL :=  2;
insert into mtTDOC set wVID :=1, bschet := '62.21', wDOC := 2, TIDK := 211, TIDKGAL :=  2;
insert into mtTDOC set wVID :=2, bschet := '60.01', wDOC := 2, TIDK := 111, TIDKGAL :=  1;
insert into mtTDOC set wVID :=2, bschet := '60.31', wDOC := 2, TIDK := 111, TIDKGAL :=  1;

 jView.PutTableToDBF(#tmGDF15,'#S_DOCs0.xls',0);

 _LOOP tmGDF15
 LogStrToFile('#S_DOCs0.txt',tmGDF15.T1 + ' ' + tmGDF15.T2 + ' ' + String(tmGDF15.cRec,0,0) );



}
cmColTune:
{
  if (not ExistFile(sFileName))
  { message('Не файла "'+sFileName+'"',error);
    exit;
  }

    if (not xlOpenNewExcel(false))
    {
      message('Ошибка запуска Excel', Error);
      if not xlKillExcel
        message('Ошибка закрытия Excel', Error);
      exit;
    }

    if (not xlOpenWorkBook(sFileName))
    {
      Message('Ошибка открытия книги: "' + sFileName + '"');
      xlKillExcel;
      Exit;
    }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);
  Counter:=1;
  if ReadColNumByNamesOK
        message ( 'Найдены колонки:'
            +''#13'ВидЗадолженности'          + lVID
            +''#13'СчетРасчетов'              + lBSCH
            +''#13'КодКонтрагента'            + lOrg1Ckod
            +''#13'Контрагент'                + lOrg
            +''#13'КодДоговора'               + lcDogovor
            +''#13'Договор'                   + lsDogovor
            +''#13'ДатаДокумента'             + lDOC
            +''#13'НомерДокумента'            + lDOC1Ckod
            +''#13'ДатаОплаты'            + lDOPL
            +''#13'ДокументРасчетов'          + lDOCName
            +''#13'ВалютаЗадолженности'       + lVal
            +''#13'СуммаЗадолженностиВВалюте' + lSumVal
            +''#13'СуммаЗадолженности'        + lSum
            +''#13'Nrec Докумена'        + lnRec
                );
  xlkillExcel;
} // cmColTune

cmImport:
{
  delete all tmOrgSaldo;
  SaveMyDsk(sFileName    , 'GP_Saldo60_nm_file');
//  SaveMyDsk(wFlagDop   , 'GP_Saldo60_Flags'  );

  if (not ExistFile(sFileName))
  { message('Не найден шаблон файла "'+sFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(sFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sFileName+'".',error);
    exit;
  }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, '1/3. Импорт из Excel ...', MaxLine);

// Читаем заголовок и находим номера колонок по названию полей

Counter:=1;
        xlOut1( 1, 'Статус1');
        xlOut1( 2, 'Статус2');
        xlOut1( 3, 'Документ')     ;
        xlOut1( 4, 'Nrec Докумена');
        xlOut1( 5, 'Статус в ERP');

if ReadColNumByNamesOK
while counter < MaxLine
do
{
  Counter++;

  if Counter mod 3 = 0
    if not nextvisual break;

  LineError := 0;

#define xlReadString(_Col, _Svar) xlgetcellvalue(Counter, #_Col,#_Svar); #_Svar := Trim(#_Svar);

  // 1 Читаем строку в запись tmOrgSaldo
 clearBuffer(#tmOrgSaldo);

    tmOrgSaldo.NPP := Counter;
    
    #xlReadString(lVID      , sStr)  // ВидЗадолженности	Дебиторская
    if sStr = 'Дебиторская'  tmOrgSaldo.wVid := 1 else
    if sStr = 'Кредиторская' tmOrgSaldo.wVid := 2 else
    {
      xlOutE(1 , 'Не определён вид задолженности') ; continue;
    }

    #xlReadString(lBSCH     , tmOrgSaldo.sBSCH     )  // СчетРасчетов	60.02
    #xlReadString(lOrg1Ckod , tmOrgSaldo.sOrg1Ckod )  // КодКонтрагента	000011106
    #xlReadString(lOrg      , tmOrgSaldo.sOrg      )  // Контрагент	А-гифтс
    #xlReadString(lcDogovor , tmOrgSaldo.c1Dogovor )  // КодДоговора	000025303
    #xlReadString(lsDogovor , tmOrgSaldo.s1Dogovor )  // Договор	Договор-счет № 1029 от 09.06.2018 поставка бейсболок и футболок с логотипом
    #xlReadString(lDOC1Ckod , tmOrgSaldo.sDOC1Ckod )  // НомерДокумента	00000246412 // tHeader.CDOGDS или CALPLAN.nRec
    #xlReadString(lDOCName  , tmOrgSaldo.sDOCName  )  // ДокументРасчетов	Платежное поручение исходящее 00000246412 от 25.06.2018 0:00:00
    #xlReadString(lVal      , tmOrgSaldo.sVal      )  // ВалютаЗадолженности	руб. EUR USD

    #xlReadString(lVal      , tmOrgSaldo.sVal      )  // ВалютаЗадолженности	руб. EUR USD

    tmOrgSaldo.sOrg1Ckod0 := LPadCh(tmOrgSaldo.SORG1CKOD,'0',9);
    tmOrgSaldo.sDOCName := RepLace(tmOrgSaldo.sDOCName,' 0:00:00','');

    xlgetcellvalue(Counter, lSumVal,tmOrgSaldo.dSumVal   ); // СуммаЗадолженностиВВалюте	10 108,56
    xlgetcellvalue(Counter, lSum   ,tmOrgSaldo.dSum      ); // СуммаЗадолженности	10 108,56

    #define _DateS(_Str) date(substr(#_Str,1,2),substr(#_Str,4,2),substr(#_Str,7,4))

    xlgetcellvalue(Counter, lDOC   , sStr);
    sStr := Trim(sStr);
    if sStr <> '' tmOrgSaldo.dDOC := #_DateS(sStr);

    xlgetcellvalue(Counter, lDOPL   , sStr);
    sStr := Trim(sStr);
    if sStr <> '' tmOrgSaldo.xlDOPL := #_DateS(sStr)
    else tmOrgSaldo.xlDOPL := tmOrgSaldo.dDOC;

    tmOrgSaldo.DOPL := tmOrgSaldo.xlDOPL;

    if lnRec > 0
    {
      xlgetcellvalue(Counter, lnRec   , sStr);
      sStr := Trim(sStr);
      tmOrgSaldo.cRec := comp(sStr);
    }

  if LineError > 0
  {
//    if (wFlagDop and 1000b) > 0 // Выделять фоном ячейки с ошибками при импорте`
      xlSetBackColor( 49407 , Counter, MaxCol+1, Counter, MaxCol+1);
  }
  else
  if insert current tmOrgSaldo = tsOK
  {
    xlOut1(1,'Прочитан');
  }
}

var C: longint;
SetVisualHeader('2/3. Привязка справочников');
_Loop tmOrgSaldo
{
  if C++ mod 3 = 0
  if not nextvisual break;

  if tmOrgSaldo.cORG = comp(0)
  if getfirst KatOrg0 = tsOK
  {
    UpDate tmOrgSaldo_ORG set tmOrgSaldo_ORG.cOrg := KatOrg0.nRec;

    tmOrgSaldo.cOrg := KatOrg0.nRec;
  }
  else
  if getfirst KatOrg = tsOK
  {
    UpDate tmOrgSaldo_ORG set tmOrgSaldo_ORG.cOrg := KatOrg.nRec;

    tmOrgSaldo.cOrg := KatOrg.nRec;
  }
  else
  {
    // Не найден Контрагент
    Counter := tmOrgSaldo.NPP;
    xlSetBackColor( 49407 , Counter, lOrg1Ckod, Counter,  lOrg1Ckod);
    xlOut1(2,'Не найден Контрагент')
  }


     //  товарный CalPlan.nRec = comp(xlKod1С) // У нижестоящего договора
  pCDOGOVOR := comp(tmOrgSaldo.c1Dogovor);
    if getfirst CalPlan = tsOK    tmOrgSaldo.cCalPlan := CalPlan.nRec;
    else
    {

      //  товарный CalPlan.nRec = comp(xlKod1С) + comp(minNRec1); // У одиночного
      pCDOGOVOR := pCDOGOVOR + minNRec1 ;

      if getfirst CalPlan = tsOK
       tmOrgSaldo.cCalPlan := CalPlan.nRec
      else
      { // 10 Товарных ПКП введены вручную:
          pCDOGOVOR := comp(tmOrgSaldo.c1Dogovor);
          if pCDOGOVOR = comp(000010551) pCDOGOVOR := 000B000000000DACh else
          if pCDOGOVOR = comp(000010552) pCDOGOVOR := 000B000000000DADh else
          if pCDOGOVOR = comp(000010553) pCDOGOVOR := 000B000000000DAEh else
          if pCDOGOVOR = comp(000010554) pCDOGOVOR := 000B000000000DAFh else
          if pCDOGOVOR = comp(000010555) pCDOGOVOR := 000B000000000DB0h else
          if pCDOGOVOR = comp(000010556) pCDOGOVOR := 000B000000000DB1h else
          if pCDOGOVOR = comp(000010558) pCDOGOVOR := 000B000000000DB8h else
          if pCDOGOVOR = comp(000010818) pCDOGOVOR := 000B000000000DB2h else
          if pCDOGOVOR = comp(000010819) pCDOGOVOR := 000B000000000DB3h else pCDOGOVOR:= comp(0);

          if pCDOGOVOR <> comp(0)
          if getfirst CalPlan = tsOK
          tmOrgSaldo.cCalPlan := CalPlan.nRec;

      }
    }

    if tmOrgSaldo.cCalPlan <> comp(0)
    if getfirst Dogovor = tsOK
    {
       if Dogovor.cDogovor <> comp(0)
       {
         tmOrgSaldo.CDOGOVOR := Dogovor.cDogovor;
         tmOrgSaldo.CAPPDOGOVOR := Dogovor.nRec;
       }
       else
       {
         tmOrgSaldo.CDOGOVOR := Dogovor.nRec;
       }

        if getfirst CALPLAN2 = tsOK
        {
          if CALPLAN2.DIRECTMC = 0 and CALPLAN2.DIRECTPLAT > 0 // финансовый план
          tmOrgSaldo.CFINPLAN:= CALPLAN2.nRec;
        }

        if tmOrgSaldo.CFINPLAN = comp(0)
        if getfirst CALPLAN0 = tsOK
        {
          if CALPLAN0.DIRECTMC = 0 and CALPLAN0.DIRECTPLAT > 0 // финансовый план
          tmOrgSaldo.CFINPLAN:= CALPLAN0.nRec;
        }
    }

    if tmOrgSaldo.CDOGOVOR = comp(0)
    {
      // Не найден Договор
      Counter := tmOrgSaldo.NPP;
      xlSetBackColor( 49407 , Counter, lcDogovor, Counter,  lcDogovor);
      xlOut1(2,'Не найден Договор')
    }

  if tmOrgSaldo.cVal = comp(0)
  if tmOrgSaldo.sVal <> 'руб.'
  if getfirst KlVal = tsok
    tmOrgSaldo.cVal := KlVal.nRec
  else
  {
    Counter := tmOrgSaldo.NPP;
    xlSetBackColor( 49407 , Counter, lVal, Counter,  lVal);
    xlOut1(2,'Не найдена валюта')
  }

  UpDate Current tmOrgSaldo;

} // _Loop tmOrgSaldo

SetVisualHeader('3/3. Проверка документов в ERP');
    _Loop tmOrgSaldo
    {
        if C++ mod 3 = 0
        if not nextvisual break;

        tmOrgSaldo.InERP := False;
        tmOrgSaldo.boSum := False;
        tmOrgSaldo.FldOk := False;
        tmOrgSaldo.ObtOk := False;
        tmOrgSaldo.wObt := 0; //

        if getfirst mtTDOC = tsOK
        {
          if mtTDOC.wDOC = 1 CheckPlPor else
          if mtTDOC.wDOC = 2 CheckAkt;

          Counter := tmOrgSaldo.NPP;
          xlOut1(7,DoubleToStr(tmOrgSaldo.dSumERP  ,'66666666666666666.9999999999999999'));
          xlOut1(8,DoubleToStr(tmOrgSaldo.dSumERPv ,'66666666666666666.9999999999999999'));

          sStr := '';
          if tmOrgSaldo.InERP
          {
            sStr := 'Найден';
            if not tmOrgSaldo.fldOk sStr := sStr + ' ИЗМЕНЁН';
            if tmOrgSaldo.boSum  sStr := sStr + ' Сумма OK' else sStr := sStr + ' Сумма Error';

          }
          else sStr := 'Не найден';

          xlOut1(5,sStr);
          if tmOrgSaldo.ObtOk sStr := 'OK' else
          {
            sStr:= 'Ошибка в Проводках ' + tmOrgSaldo.wObt;
            if (tmOrgSaldo.wObt and 1b) > 0 sStr := sStr + 'DATOB;';
            if (tmOrgSaldo.wObt and 10b) > 0 sStr := sStr + 'DATAOT;';
            if (tmOrgSaldo.wObt and 100b) > 0 sStr := sStr + 'SUMOB;';
            if (tmOrgSaldo.wObt and 1000b) > 0 sStr := sStr + 'SUMVALUT;';
            if (tmOrgSaldo.wObt and 10000b) > 0 sStr := sStr + 'НЕТ проводок;';

          }
          xlOut1(6,sStr);
        }
        else
        {
            Counter := tmOrgSaldo.NPP;
            xlSetBackColor( 49407 , Counter, lBSCH, Counter,  lBSCH);
            xlOut1(2,'Не известный счет');
        }
    } // _Loop tmOrgSaldo
/*
tmGDF15.T1:= 999;
tmGDF15.T2 := 999;
tmGDF15.cRec := 999;
insert current tmGDF15;
*/
Counter := 1;
 xlOut1(5,'Сверка Док');
 xlOut1(6,'Сверка Проводок');
 xlOut1(7,'Сумма в Руб.');
 xlOut1(8,'Сумма в Валюте.');

    if getfirst tmGDF15 = tsOK // Есть документы кроме тех, что в Excel
    {
      xlAddSheet;
      xlSetActiveSheet(1);
      xlSetSheetName(1,'Прочие Документы');

      Counter := 1;
        xlSetCellStringValue('Tidk'    ,Counter,1,Counter,1);
        xlSetCellStringValue('TidkGal' ,Counter,2,Counter,2);
        xlSetCellStringValue('cSoprDoc',Counter,3,Counter,3);

      _LOOP tmGDF15
      {
        Counter++;
        xlSetCellStringValue(String(tmGDF15.T1),Counter,1,Counter,1);
        xlSetCellStringValue(String(tmGDF15.T2),Counter,2,Counter,2);
        xlSetCellStringValue(String(tmGDF15.cRec,0,0),Counter,3,Counter,3);
      }
    }  // if getfirst tmGDF15 = tsOK // Есть документы кроме тех, что в Excel

xlkillExcel;
StopVisual('',0);


jView.PutTableToDBF (#tmOrgSaldo,'#_OrgSaldo.xls',0);
jView.PutTableToDBF (#tmGDF15,'#_SaldoDOCs.xls',0);

logStrToFile('1.txt','SCHET  SUBSSCH');
_Loop mtSchets
logStrToFile('1.txt',mtSchets.SCH +' ' + mtSchets.SUB );//+' ' + mtSchets.SCHETK +' ' + mtSchets.SUBSCHK);


jView.PutTableToDBF (#mtSchets,'#OborSchets.xls',0);
} // cmImport:

cmPick:
{ case CurField of
  #sFileName:
  { var ww_str:string=GetFileName('*.xls;*.xlsx','Выберите файл c данными по Задолженности');
    if ww_str<>''
    {
       set sFileName:=ww_str;
    }
  }
  end;
} // cmPick:

end; // HandleEvent
End. // interface
