/*************************************************************************************************\
* Наименование: Импорт Каталога Матценностей из Excel в Галактику                                 *
* Контур/Модуль: Обмен бизнес-документами                                                         *
* Примечание:                                                                                     *
*    Ошибка. запись ExImLogE привязывается к предыдущемпу документу                               *
*                                                                                                 *
*    Исправление: строки 46-47 с пометкой (#2515) отключены/закоментированы                       *
*                                                                                                 *
*    Пояснение                                                                                    *
*    cCurLogR содержит ссылку на последний Протокол EXIMLOGR,                                     *
*    но вызов LogError идёт до вставки нового документа и с cLogR=0,                              *
*    когда записи EXIMLOGR для текущего документа ещё нет.                                        *
*    При вставке документа, создаётся запись протокола EXIMLOGR                                   *
*    и все ошибки ExImLogE с cLogR=0 вяжут к этому новому протоколу.                              *
*    Update ExImLogE Where((0 == ExImLogE.cLogR)) Set ExImLogE.cLogR := ExImLogR.nRec;            *
*    Таков алгоритм добавления ошибок ExImLogE в протокол при импорте МЦ.                         *
*                                                                                                 *
*    Обнаружено на импорте КАТМС. Не уверен, что все импорты будут корректны                      *
*                                                                                                 *
* Вид работы  |Номер         |Дата      |Исполнитель              |Проект                         *
* ---------------------------------------------------------------------------------------------   *
* Разработка  |#2515         |13/06/2018|Шунин А.Г.               |НПО Энергомаш                  *
\*************************************************************************************************/

// #2515 Импорт Каталога Матценностей из Excel в Галактику

#component "C_EXPIMP"

#include exImConst.inc
#include ieFun.vih

Alter Interface ieFun Cacheable;
overload
procedure ObjIeFun.LogErrorDetail(cLogR : comp; wStatus : word; sValue : string; sDetailValue : string);
Procedure ObjIeFun.LogDocument(cDocument : Comp; wStatus : Word; Value : String; cIEHead: comp);
end;

var lImportDocCounter : Longint=1;
var lCurColumn : Longint=1;


procedure ObjIeFun.LogErrorDetail(cLogR : comp; wStatus : word; sValue : string; sDetailValue : string);
var sPref : string;
{

//  if (cLogR = 0)    
//     cLogR := cCurLogR; //  #2515 отключено. Иначе запись ExImLogE привязывается к предыдущемпу документу.

  ClearBuffer(#ExImLogE);

  ExImLogE.cLogR := cLogR;     // возможно надо все таки ExImLogR.NRec
//  ExImLogE.cLogR := ExImLogR.NRec;
  ExImLogE.Status := wStatus;
  ExImLogE.Value := sValue;

  ExImLogE.rStr := sDetailValue; // номер документа по порядку вызова LogDocument
//   ExImLogE.rStr := String(lImportDocCounter) + sDetailValue; // номер документа по порядку вызова LogDocument

  sPref := '';
  if (m_wTypeRec = lHeader)
    sPref := lHeaderValueColumn;
  else if (m_wTypeRec = lSpec)
    sPref := lSpecValueColumn;
  ExImLogE.NoRefFld := sPref + sCurFieldName;
  ExImLogE.rComp := m_cNrecRec;
  insert current ExImLogE;
  sError := sValue;
  lImportErrorsCounter++;
} // procedure LogError

Procedure ObjIeFun.LogDocument(cDocument : Comp; wStatus : Word; Value : String; cIEHead: comp);
{
  inherited::LogDocument(cDocument,wStatus,Value,cIEHead);
  lImportDocCounter++;
}
end.
