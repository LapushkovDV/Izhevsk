Interface GP_McSchetImp 'Импорт Счета учета Матценностей из Excel' gray dialog;

var
Counter, MaxLine, MaxCol, npp : longint;
sFileName, nm_file: string;

lBarkod     : longint;
lSCHET      : longint;

sMCKOD      : string;
sSCHET      : string;

sValue : string;
sStr: string;
wFlagDop: word;
NeedUpDateMC: word;

DCol: longint; // смещение для вывода старых значений

sAttrName :string= '.Аналитика БухСчета';
cAttrNewValue, cAttrValue, cKAU3: comp;
sAttrNewValue, sAttrValue: string;
cPlan : comp;

create view jView
as select KatMC.nRec
from
 KatMC, BuhSchet, SPSETAN
,HashAn, HashAn HashAn0,HashAn HashAnFind, SpSloj (SPSLOJ03), MaskMC
where
((
   sMCKOD == KatMC.BARKOD

and
   000B000000000001h == MaskMC.nRec
and
       KatMC.cHashAn == HashAn0.nRec // в 3 и 4 Аналитику из Атрибутов  .Аналитика БухСчета + .Аналитика Группы драгметаллов
and
        HashAn.CSLOJ == SpSloj.cMain

    and 10142 == SPSETAN.KODGRKAU
))
;

function GetHashAn: comp;
{
   Result := comp(0);
   if Katmc.cHashan > comp(0)
   if getfirst Hashan where (( Katmc.cHashan == Hashan.nRec)) = tsOK
   {
     Result := Hashan.nRec;
     Hashan.CANALIT[3] := cKAU3;// coGetAttr(coKatmc,Katmc.nRec,'.Аналитика БухСчета');
     if (GetFirst HashAnFind where ((HashAn.CSLOJ == HashAnFind.CSLOJ and HashAn.CBLOCK == HashAnFind.CBLOCK and HashAn.CANALIT[1] == HashAnFind.CANALIT[1] and
                                     HashAn.CANALIT[2] == HashAnFind.CANALIT[2] and HashAn.CANALIT[3] == HashAnFind.CANALIT[3] and HashAn.CANALIT[4] == HashAnFind.CANALIT[4] and
                                     HashAn.CANALIT[5] == HashAnFind.CANALIT[5] and HashAn.CANALIT[6] == HashAnFind.CANALIT[6] and HashAn.CANALIT[7] == HashAnFind.CANALIT[7] and
                                     HashAn.CANALIT[8] == HashAnFind.CANALIT[8] and HashAn.CANALIT[9] == HashAnFind.CANALIT[9] and HashAn.CANALIT[10] == HashAnFind.CANALIT[10] )) = tsOk)
     {
       Result := HashAnFind.nRec;
       exit;
     }
     else
     {
       HashAn.nRec := comp(0);
       if (insert current HashAn = tsOk) Result := HashAn.nRec;
       exit;
     }
   }

   if Result = comp(0)
   {
     ClearBuffer(tnHashan);
     
     Hashan.CSLOJ := MaskMC.cSloj; // 000B000000000001h;
     if getlast SpSloj = tsOK  Hashan.npp  := SpSloj.NPP else Hashan.npp   := 4;

   }

   Hashan.CANALIT[2] := coGetAttr(coKatmc,Katmc.nRec,'.Виды взаиморасчетов по договору');
   Hashan.CANALIT[3] := coGetAttr(coKatmc,Katmc.nRec,'.Аналитика БухСчета');
   Hashan.CANALIT[4] := coGetAttr(coKatmc,Katmc.nRec,'.Аналитика Группы драгметаллов');

    if (GetFirst HashAnFind where ((HashAn.CSLOJ == HashAnFind.CSLOJ and HashAn.CBLOCK == HashAnFind.CBLOCK and HashAn.CANALIT[1] == HashAnFind.CANALIT[1] and
                                    HashAn.CANALIT[2] == HashAnFind.CANALIT[2] and HashAn.CANALIT[3] == HashAnFind.CANALIT[3] and HashAn.CANALIT[4] == HashAnFind.CANALIT[4] and
                                    HashAn.CANALIT[5] == HashAnFind.CANALIT[5] and HashAn.CANALIT[6] == HashAnFind.CANALIT[6] and HashAn.CANALIT[7] == HashAnFind.CANALIT[7] and
                                    HashAn.CANALIT[8] == HashAnFind.CANALIT[8] and HashAn.CANALIT[9] == HashAnFind.CANALIT[9] and HashAn.CANALIT[10] == HashAnFind.CANALIT[10] )) = tsOk)
    {
        Result := HashAnFind.nRec
    }
    else
    {
      HashAn.nRec := comp(0);
      if (insert current HashAn = tsOk) Result := HashAn.nRec
    }

} // function GetHashAn: comp;

screen scrImp;
fields
nm_file:NoProtect, PickButton;

buttons
      cmColTune; cmImport;
<<
  Импорт Счета учета ТМЦ МЦ
  Файл Excel.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

    <. Проверить соответствие полей .>              <. Запустить Импорт .>

  версия 0.3
>>
end;

function ReadColNumByNamesOK: boolean;
Var str: string;
   lCol:longint;
{
  lBarkod := lSCHET := 0;
  lCol:=0; str := '';
    while lCol <= MaxCol // по Колонкам первой строки
    do
    {
      lCol++;
      xlgetcellvalue(1, lCol, str);
      str := trim( str );
            Case str of
'КодМЦ',
'Ном.№'           : lBarkod    :=lCol;
'СчетУчетаБУ',
'Балансовый счет' : lSCHET     :=lCol;
            end; // Case
    }

    if lBarkod = 0 or lSCHET = 0
    {
        message ( 'Ошибка формата файла. Не найдена колонка'
            +''#13'Ном.№ '                  + lBarkod
            +''#13'Балансовый счет '        + lSCHET
                );
       ReadColNumByNamesOK := False;
    }
    else
    ReadColNumByNamesOK := true;

}// function ReadColNumByNamesOK: boolean;


procedure xlOut1(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOut1

var LineError: word;
procedure xlOutE(pCol:longint;pStr: string);
{
  LineError++;
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOutE



HandleEvent

cmINIT:
{
  if not ReadMyDsk(nm_file  , 'GP_McSchetImp_nm_file', false) nm_file := '';
  if not ReadMyDsk(wFlagDop , 'GP_McSchetImp_Flags'  , false) wFlagDop:= 111b;
 cPlan := coGetTune('FIN.USER.CPLANSSCH'); // coGetTune('KONSOLID.CPLANSSCH');
}
cmColTune:
{
  if nm_file <> '' then sFileName := nm_file
  else
  {
    sFileName := 'GP_Saldo60.xlsx';
    sFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + sFileName ;
  }

  if (not ExistFile(sFileName))
  { message('Не файла "'+sFileName+'"',error);
    exit;
  }


    if (not xlOpenNewExcel(false))
    {
      message('Ошибка запуска Excel', Error);
      if not xlKillExcel
        message('Ошибка закрытия Excel', Error);
      exit;
    }

    if (not xlOpenWorkBook(sFileName))
    {
      Message('Ошибка открытия книги: "' + sFileName + '"');
      xlKillExcel;
      Exit;
    }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);
  Counter:=1;
  if ReadColNumByNamesOK
        message ( 'Найдены колонки:'
            +''#13'Ном.№ '                  + lBarkod
            +''#13'Балансовый счет '        + lSCHET
                );
  xlkillExcel;
} // cmColTune

cmImport:
{
  SaveMyDsk(nm_file    , 'GP_McSchetImp_nm_file');
  SaveMyDsk(wFlagDop   , 'GP_McSchetImp_Flags'  );

  if nm_file <> '' then sFileName := nm_file
  else
  {
    sFileName := 'GP_McSchetImp.xlsx';
    sFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + sFileName ;
  }

  if (not ExistFile(sFileName))
  { message('Не найден шаблон файла "'+sFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(sFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sFileName+'".',error);
    exit;
  }

  if (xlIsExcelValid) xlSetActiveSheetByName('1');

  xlGetUsedRange(0,0,MaxLine,MaxCol);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel ...', MaxLine);

// Читаем заголовок и находим номера колонок по названию полей
Counter:=1;
        xlOut1( 1, 'Статус');
        xlOut1( 2, 'Nrec Докумена');
        xlOut1( 3, 'Старое значение атрибута');

if ReadColNumByNamesOK
while counter < MaxLine
do
{
  Counter++;
  NeedUpDateMC := 0; // признак изменения значения

  if Counter mod 3 = 0
    if not nextvisual break;

  LineError := 0;

#define xlReadString(_Col, _Svar) xlgetcellvalue(Counter, #_Col,#_Svar); #_Svar := Trim(#_Svar);

    #xlReadString(lBarkod     ,sMCKOD)
    if sMCKOD = ''
    {  xlOutE(1 , 'Нет Баркода') ; continue;}

    sMCKOD := LPADCH(sMCKOD,'0',10);
    if getfirst KATMC <> tsOK
    {
      xlOutE(1 , 'Не найдена МЦ ' + sMCKOD);
      continue;
    }

    #xlReadString(lSCHET  ,sSCHET )
    if sSCHET = '7' sSCHET := '07';

    cAttrNewValue := comp(0);
    if (getfirst SPSETAN where (( 10142 == SPSETAN.KODGRKAU  and  (InStr(sSCHET,trim(SPSETAN.Name) ) =1 ) )) = tsOk)
    {
      cAttrNewValue := SPSETAN.cKAU;
      sAttrNewValue := SPSETAN.Name;
    }
    else
    if (getfirst BuhSchet where ((cPlan == Buhschet.CPLANSSCH and sSCHET == Buhschet.CODE)) = tsOk)
    {
      cAttrNewValue := Buhschet.Nrec;
      sAttrNewValue := BuhSchet.CODE + ' ' + BuhSchet.Name;
      
    }
    else
    {
      xlOut1(1,'Счет не найден');
      continue;
    }

    cAttrValue := coGetAttr(coKatmc, Katmc.nRec,sAttrName);

    if cAttrValue <> cAttrNewValue
    {

       if cAttrValue <> comp(0)
       {
         sAttrValue := sGetAttr(coKatmc, Katmc.nRec,sAttrName);
         xlOut1( 3, sAttrValue);
       }
       coSetAttr(coKatmc, Katmc.nRec,sAttrName,cAttrNewValue,sAttrNewValue);
       xlSetBackColor( 49407 , Counter, lSCHET, Counter, lSCHET);
       // NeedUpDateMC++;
    }

    cKAU3 := cAttrNewValue;
// Шаблон и аналитика для KATMC
var cHashanNew:comp;

    if (GetFirst MaskMC = tsOk)
    {
       cHashanNew := GetHashAn; // в 3 и 4 Аналитику из Атрибутов  .Аналитика БухСчета + .Аналитика Группы драгметаллов

       if  KatMC.cMaskMC <> MaskMC.nRec  or
           KatMC.cSloj   <> MaskMC.cSloj or
           KatMC.cHashAn <> cHashanNew
       {
          KatMC.cMaskMC := MaskMC.nRec ;
          KatMC.cSloj   := MaskMC.cSloj;
          KatMC.cHashAn := cHashanNew;
          NeedUpDateMC++; // UpDate current KatMC;
       }
    }

    if NeedUpDateMC = 0
    xlOut1(1,'Одинаково')
    else
    {
      if Update current KatMC = tsOK
      xlOut1(1,'Обновлено')
      else
      xlOut1(1,'Ошибка при Обновлении');
    }
    xlOut1(2, string(Katmc.nRec,0,0) );

}
xlkillExcel;
StopVisual('',0);

} // cmImport:

cmPick:
{ case CurField of
  #nm_file:
  { var ww_str:string=GetFileName('*.xls;*.xlsx','Выберите файл c данными по Счета учета ТМЦ');
    if ww_str<>''
    {
       set nm_file:=ww_str;
    }
  }
  end;
} // cmPick:

end; // HandleEvent
End. // interface
