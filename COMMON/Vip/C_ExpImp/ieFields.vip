/*************************************************************************************************\
* Наименование: Импорт Каталога организаций из Excel в Галактику                                  *
* Контур/Модуль: Обмен бизнес-документами                                                         *
* Примечание: Запуск внешнего интерфейса - C_ExpImp::ieSettingsFields
              Запустится Формирование справочника полей. Появится фейс - из него просто выйти
*                                                                                                 *
* Вид работы  |Номер         |Дата      |Исполнитель              |Проект                         *
* ---------------------------------------------------------------------------------------------   *
* Разработка  |#2249         |12/04/2018|Шунин А.Г.               |НПО Энергомаш                  *
* Разработка  |#2515         |05/04/2018|Шунин А.Г.               |НПО Энергомаш                  *
* Разработка  |#3006         |05/04/2018|Шунин А.Г.               |НПО Энергомаш                  *
* Разработка  |#3260         |18/08/2018|Шунин А.Г.               |НПО Энергомаш                  *
\*************************************************************************************************/
//
//
// #2249 Импорт Каталога организаций из Excel в Галактику
//
// Внимание коды полей/алгоритма указаны в исходном коде
// При пересечении этих кодов результат не предсказуем
// например, iehKO + 49 может быть занят в новой версии inherited::CreateIEIncFlds;
//
// Добавлены новый пол из KATORG
// Добавлен импорт внешнего атрибута для KATORG
//
//
//
//
#component "C_ExpImp"
Alter InterFace ieSettingsFields;
overload
Procedure CreateIEIncFlds;
end;

Create View
As Select
  IEIncFld_MY.NAME
From
  IEIncFld IEIncFld_MY
;

Procedure AddNewField;
{

// Импорт Каталога Контрагентов

  InsertIEIncFld( 0, iehKO + 41, 'KATORG.CODES[i], i=1 или из формулы', 'KATORG.CODES[i], i от 1 до 20 из формулы'  , 'C020' , ieKatOrg, ieHeader , ieBoth);
  InsertIEIncFld( 0, iehKO + 42, 'Очередность платежа'                , 'KATORG.SPLATPRIORITY'                      , 'C255' , ieKatOrg, ieHeader , ieBoth);
  InsertIEIncFld( 0, iehKO + 43, 'Идентификационный код'              , 'KATORG.SJURIDICALID '                      , 'C255' , ieKatOrg, ieHeader , ieBoth);
  InsertIEIncFld( 0, iehKO + 44, 'наим.организации или ФИО физ.лица'  , 'KATORG.NAMELATIN    '                      , 'C255' , ieKatOrg, ieHeader , ieBoth);
  InsertIEIncFld( 0, iehKO + 45, 'адрес контрагента латиницей'        , 'KATORG.ADDRLATIN    '                      , 'C150' , ieKatOrg, ieHeader , ieBoth);
  InsertIEIncFld( 0, iehKO + 46, 'Орган исполнительной власти'        , 'KATORG.INSNAME      '                      , 'C255' , ieKatOrg, ieHeader , ieBoth);
  InsertIEIncFld( 0, iehKO + 47, 'KATORG.REFS[1], i=1 или из формулы' , 'KATORG.REFS[1], i от 1 до 20 из формулы'   , 'C020' , ieKatOrg, ieHeader , ieBoth);
  
  //  Штатный способ Название атрибута и значение атрибута в одной переменной, разделитель " - одна двойная кавыча
  //  при этом строка, в 255 символов делит эти 255 символов с Названием атрибута, что урезает длину данных
  //  Чтоб данные не резать, есть способ код 50
  InsertIEIncFld( 0, iehKO + 49, 'Внешний атрибут строка'               , 'Введите имя атрибута'    , 'C200'     , ieKatOrg, ieHeader , ieBoth);

  //  Другой способ Название атрибута из параметра, значение атрибута через глобальную переменную
  InsertIEIncFld( 0, iehKO + 50, 'Внешний атрибут строка 255 символов'  , 'Имя атрибута из Формулы' , 'C255'     , ieKatOrg, ieHeader , ieBoth);

  InsertIEIncFld( 0, iehKO + 51, 'Тип: 0-юридическое/1-физическое лицо/2-индивидуальный предприниматель/3-НО'  , 'KATORGIMP.WTYPE' , 'N003'     , ieKatOrg, ieHeader , ieBoth);
  InsertIEIncFld( 0, iehKO + 52, 'Применять налоги: 0 -всегда, 1-только в закупках, 2-только в продажах, 3-никогда'  , 'KATORGIMP.TIPKNT = (TIPKNT and 255) or (word( LoadValue ) shl 8)' , 'N003'     , ieKatOrg, ieHeader , ieBoth);

  InsertIEIncFld( 0, iehKO + 53, 'Внешний атрибут число да/нет логический (boolean)'   , 'Введите имя атрибута'   , 'C020'  , ieKatOrg, ieHeader , ieBoth);
  InsertIEIncFld( 0, iehKO + 54, 'Внешний атрибут число'   , 'Введите имя атрибута'   , 'C020'  , ieKatOrg, ieHeader , ieBoth);
  InsertIEIncFld( 0, iehKO + 55, 'Внешний атрибут число <- Номер записи источника' , 'N строки Excel'    , 'C020', ieKatOrg, ieHeader , ieBoth);





// Импорт Каталога Матценностей

// 3058 Пересеклось  InsertIEIncFld( 0, iehMC + 58, 'Внешний атрибут строка'               , 'Введите имя атрибута'    , 'C200'     , ieKATMC  , ieHeader , ieBoth);
  InsertIEIncFld( 0, iehMC + 59, 'Внешний атрибут строка 255 символов'  , 'Имя атрибута из Формулы' , 'C255'     , ieKATMC  , ieHeader , ieBoth);

  InsertIEIncFld( 0, iehMC + 60, 'Внешний атрибут число'   , 'Введите имя атрибута'   , 'C020'  , ieKATMC  , ieHeader , ieBoth);
  InsertIEIncFld( 0, iehMC + 61, 'Внешний атрибут ссылка'  , 'Введите имя атрибута'   , 'C080'  , ieKATMC  , ieHeader , ieBoth);
  InsertIEIncFld( 0, iehMC + 62, 'ГОСТ'  , 'KATMC.GOST'   , 'C050'  , ieKATMC  , ieHeader , ieBoth);
                        
  InsertIEIncFld( 0, iehMC + 63, 'Признак 0-Материал/1-ДСЕ/2-Инструмент, оснастка'  , 'KATMC.PRMAT'   , 'N010'  , ieKATMC  , ieHeader , ieBoth);
  InsertIEIncFld( 0, iehMC + 64, 'Тип матценности (KATMC.CTYPE -> KIND, PRMAT) по наименованию'  , 'TYPEMC.NAME'   , 'C050'  , ieKATMC  , ieHeader , ieBoth);
  InsertIEIncFld( 0, iehMC + 65, 'Тип матценности (KATMC.CTYPE -> KIND, PRMAT) по коду'          , 'TYPEMC.KOD'    , 'C020'  , ieKATMC  , ieHeader , ieBoth);

  InsertIEIncFld( 0, iehMC + 66, 'Признак архивности. Не пусто - в архив' , 'KATMC.isarch'    , 'C020'  , ieKATMC  , ieHeader , ieBoth);

  InsertIEIncFld( 0, iehMC + 67, 'Внешний атрибут число <- Номер записи источника' , 'N строки Excel'    , 'C020'  , ieKATMC  , ieHeader , ieBoth);

  InsertIEIncFld( 0, iehMC + 68, 'Внешний атрибут строка'               , 'Введите имя атрибута'    , 'C200'     , ieKATMC  , ieHeader , ieBoth);

// #3006 Импорт Каталога Партий из Excel в Галактику
  InsertIEIncFld( 0, iehPA + 22, 'Внешний атрибут число <- Номер записи источника' , 'N строки Excel'    , 'C020', ieParty  , ieHeader , ieBoth);
  InsertIEIncFld( 0, iehPA + 23, 'Внешний атрибут строка'               , 'Введите имя атрибута'    , 'C200'     , ieParty  , ieHeader , ieBoth);
  InsertIEIncFld( 0, iehPA + 24, 'Внешний атрибут строка 255 символов'  , 'Имя атрибута из Формулы' , 'C255'     , ieParty  , ieHeader , ieBoth);

  InsertIEIncFld( 0, iehPA + 25, 'Внешний атрибут число'   , 'Введите имя атрибута'   , 'C020'  , ieParty  , ieHeader , ieBoth);
  InsertIEIncFld( 0, iehPA + 26, 'Внешний атрибут ссылка'  , 'Введите имя атрибута'   , 'C080'  , ieParty  , ieHeader , ieBoth);
  InsertIEIncFld( 0, iehPA + 27, 'Статус партии KATPARTY.CNOTE'  , 'KATPARTY.CNOTE и KATPARTY.STATUS'   , 'C080'  , ieParty  , ieHeader , ieBoth);


//  #3105 Импорт Накладных из Excel в Галактику
  InsertIEIncFld( 0, iesKS + 95, 'Внешний атрибут число <- Номер записи источника' , 'N строки Excel'    , 'C020',  ieSopr , ieSpec , ieBoth);


// #3260 Импорт Договоров из Excel в Галактику

  InsertIEIncFld(0, iehDogovor + 101, 'Номер в архиве DOGOVOR.ARCHNUM'   , 'DOGOVOR.ARCHNUM'   , 'C100'  , ieDogovor, ieHeader, ieBoth);
  InsertIEIncFld(0, iehDogovor + 102, 'Пользовательское наименование'   , 'DOGOVOR.NAME'   , 'C100'  , ieDogovor, ieHeader, ieBoth);

  InsertIEIncFld(0, iehDogovor + 103, 'Внешний атрибут число <- Номер записи источника' , 'N строки Excel'    , 'C020', ieDogovor, ieHeader, ieBoth);
  InsertIEIncFld(0, iehDogovor + 104, 'Внешний атрибут строка'               , 'Введите имя атрибута'    , 'C200'     , ieDogovor, ieHeader, ieBoth);
  InsertIEIncFld(0, iehDogovor + 105, 'Внешний атрибут строка 255 символов'  , 'Имя атрибута из Формулы' , 'C255'     , ieDogovor, ieHeader, ieBoth);
  InsertIEIncFld(0, iehDogovor + 106, 'Внешний атрибут число'   , 'Введите имя атрибута'   , 'C020' , ieDogovor, ieHeader, ieBoth);
  InsertIEIncFld(0, iehDogovor + 107, 'Внешний атрибут ссылка'  , 'Введите имя атрибута'   , 'C080' , ieDogovor, ieHeader, ieBoth);

  InsertIEIncFld(0, iehDogovor + 108,'Ссылка на допсоглашение (атр) договора CDOGDSA','DOGOVOR.CDOGDSA', 'C020', ieDogovor, ieHeader, ieBoth);
  InsertIEIncFld(0, iehDogovor + 109,'Ссылка на допсоглашение договора CDOGDS','DOGOVOR.CDOGDS', 'C020', ieDogovor, ieHeader, ieBoth);
  InsertIEIncFld(0, iehDogovor + 110,'Ссылка Тендер CTENDER','DOGOVOR.CTENDER', 'C020', ieDogovor, ieHeader, ieBoth);
  InsertIEIncFld(0, iehDogovor + 111,'Наименование Группы документов GROUPSCH.NAME','GROUPSCH.NAME', 'C120', ieDogovor, ieHeader, ieBoth);
  InsertIEIncFld(0, iehDogovor + 112,'Наименование или код назначения KATNAZNA.NAME','KATNAZNA.NAME или KATNAZNA.NAZCODE', 'C120', ieDogovor, ieHeader, ieBoth);

  InsertIEIncFld(0, iehDogovor + 113, 'Внешний атрибут число да/нет логический (boolean)'   , 'Введите имя атрибута'   , 'C020' , ieDogovor, ieHeader, ieBoth);
//  InsertIEIncFld(0, iehDogovor + 102,, ieDogovor, ieHeader, ieBoth);

}
Procedure CreateIEIncFlds;
{

  inherited::CreateIEIncFlds;
  AddNewField;

}

HandleEvent

  cmInit :
  {
    inherited::HandleEvent(cmInit);

      If ( GetFirst IEIncFld_MY Where (( 'Статус партии KATPARTY.CNOTE' == IEIncFld_MY.Name )) <> tsOk )
      {
         AddNewField; // ...или нет полей , то пересоздаем справочник
      }
   }
end;
end.
// sql select * from IEINCFLD  where kode in (select Kode  from IEINCFLD group by KODE having count(*) > 1);