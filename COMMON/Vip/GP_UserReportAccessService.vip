#include GP_UserReportAccessService.vih
interface GP_UserReportAccessService;

var CurRepVipName:string='';
    CurAllowResult:boolean=false;

create view
as select
  GP_UserReportAccess.RepVipName
from
  GP_UserReportAccess,
  GP_UserReportAccess GP_UserReportAccess2,
  GroupUsers;

function IsRepAllow(RepVipName:string):boolean;
var CurUser:comp;
    IsFirstRec,IsFirstGroup:boolean;
{
  if (RepVipName=CurRepVipName) {
    result:=CurAllowResult;
    exit;
  }

  result:=true;
  if (not pr_CurUserAdmin) {
    CurUser:=UserId;
    IsFirstRec:=true;
    IsFirstGroup:=true;

    _loop GP_UserReportAccess
    where((
      RepVipName==GP_UserReportAccess.RepVipName and
      GP_UserReportAccess.cGroup==GroupUsers.GroupCode and
      CurUser==GroupUsers.UserCode
    ))
    ordered by GP_UserReportAccess.cUser, GP_UserReportAccess.cGroup {
      if (IsFirstRec) {
        result:=false;
        IsFirstRec:=false;
      }

      if (GP_UserReportAccess.cUser=0 and GP_UserReportAccess.cGroup=0)
        result:=GP_UserReportAccess.IsAllow
      else if (GP_UserReportAccess.cUser=0 and IsValidAll(tnGroupUsers)) {
        if (IsFirstGroup) {
          IsFirstGroup:=false;
          result:=GP_UserReportAccess.IsAllow;
        }
        else
          result:=result or GP_UserReportAccess.IsAllow;
      } else if (GP_UserReportAccess.cUser=CurUser) {
        result:=GP_UserReportAccess.IsAllow;
        break;
      }
    }//_loop GP_UserReportAccess
  }

  CurRepVipName:=RepVipName;
  CurAllowResult:=result;
}

function AddRepAccess(RepVipName:string;cUser,cGroup:comp;IsAllow:boolean=true):boolean;
var Res:integer;
{
  result:=false;
  if (RepVipName='') exit;

  result:=getfirst fastfirstrow GP_UserReportAccess
          where((
            RepVipName==GP_UserReportAccess.RepVipName and
            cUser==GP_UserReportAccess.cUser and
            cGroup==GP_UserReportAccess.cGroup
          ))=tsok;

  if (not result) {
    ClearBuffer(tnGP_UserReportAccess);
    GP_UserReportAccess.RepVipName:=RepVipName;
    GP_UserReportAccess.cUser:=cUser;
    GP_UserReportAccess.cGroup:=cGroup;
    GP_UserReportAccess.IsAllow:=IsAllow;
    Res:=insert current GP_UserReportAccess;
    result:=Res = tsok;
    if (not result)
      message('Ошибка вставки записи в таблицу GP_UserReportAccess ('+string(Res)+').',error);
  }
}

function CopyRepAccess(SrcRepVipName,DstRepVipName:string):boolean;
var Res:integer;
{
  result:=false;
  if (SrcRepVipName='' or DstRepVipName='') exit;

  Res:=delete GP_UserReportAccess where((DstRepVipName==GP_UserReportAccess.RepVipName));
  result:=Res = tsok;
  if (not result) {
    message('Ошибка удаления записи в таблице GP_UserReportAccess ('+string(Res)+').',error);
    exit;
  }

  _loop GP_UserReportAccess2 where((SrcRepVipName==GP_UserReportAccess2.RepVipName)) {
    GP_UserReportAccess.buffer:=GP_UserReportAccess2.buffer;
    GP_UserReportAccess.NRec:=0;
    GP_UserReportAccess.RepVipName:=DstRepVipName;
    Res:=insert current GP_UserReportAccess;
    result:=Res = tsok;
    if (not result) {
      message('Ошибка вставки записи в таблицу GP_UserReportAccess ('+string(Res)+').',error);
      break;
    }
  }
}

end.
