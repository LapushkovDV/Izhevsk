#include GP_UserFilterDoubleEditView.vih;

#component "GP_Common"

//TODO: Параметризировать интерфейс: ввести properties на SumFormat, заголовок окна Pick, название поля в окне редактирования

#include GP_UserFilterDouble.vih
interface GP_UserFilterDouble;

var
  _noField      : longint;
  _sum          : double;
  _sum2         : double;
  _saveName     : string;
  _filterString : String;
  _match        : Byte;
  _editView     : GP_UserFilterDoubleEditView noauto;
  _sumFormat    : string;

window wPick 'Установка числового фильтра' escClose, doAccept;
  show(,,70,5);
  embedded scPick interface _editView;
  show(,,,2);
  end;
  screen scButtons;
  show(,3,,) fixed_y;
  buttons
    cmDoOk, default;
<<
                                                     <. Продолжить .>
>>
  end;
  handleevent
    cmDoOk: PutCommand(cmDefault);
  end;
end; //window

procedure OnEditViewCmDefault;
{
  CloseWindowEx(wPick, cmDefault);
}

constructor UserFilterDouble(NoField:longint; SaveName:string; doSum: double = 0; doSum2: double = 0;
                             bMatch: byte = GP_UserFilterDouble_Match_Equal);
{
  _noField      := NoField;
  _saveName     := SaveName;
  _sum          := doSum;
  _sum2         := doSum2;
  _match        := bMatch;
  _editView     := new(GP_UserFilterDoubleEditView, UserFilterDoubleEditView(self, 'Числовой фильтр'));
  BindEvent(OnEditViewCmDefault, _editView.OnCmDefault);
  _sumFormat    := '[|-]3666 666 666 666.88';
  result        := true;
}

function GetSumPresentation(doSum: double): string;
{
  result := DoubleToStr(doSum, _sumformat);
}

procedure Pick;                //Выбор значения(й) фильтра
{
  RunWindowModal(wPick)
}

procedure Del;                 //Очистка фильтра
{
  _sum := 0;
  _sum2 := 0;
}

procedure Load(IStore: GP_IUserFilterStore);//Загрузить значения фильтра из хранилища IStore
{
  _sum   := IStore.LoadDouble(_saveName + '_Sum');
  _sum2  := IStore.LoadDouble(_saveName + '_Sum2');
  _match := byte(IStore.LoadComp(_saveName + '_Match'));
}

procedure Save(IStore: GP_IUserFilterStore);//Сохранить значения фильтра в хранилище IStore
{
  IStore.SaveDouble(_sum, _saveName + '_Sum');
  IStore.SaveDouble(_sum2, _saveName + '_Sum2');
  IStore.SaveComp(comp(_match), _saveName + '_Match');
}

function GetFilterStr: string;    //Функция формирующая отображаемое значение фильтра
{
  result := case(_match;
                 GP_UserFilterDouble_Match_Equal    : '= ' + GetSumPresentation(_sum),
                 GP_UserFilterDouble_Match_Less     : '< ' + GetSumPresentation(_sum),
                 GP_UserFilterDouble_Match_LessEqual: '<= ' + GetSumPresentation(_sum),
                 GP_UserFilterDouble_Match_More     : '> ' + GetSumPresentation(_sum),
                 GP_UserFilterDouble_Match_MoreEqual: '>= ' + GetSumPresentation(_sum),
                 GP_UserFilterDouble_Match_Between  : '[' + GetSumPresentation(_sum) +
                                                      ' .. ' +  + GetSumPresentation(_sum2) + ']';
                 '?');
}

property NoField       : longint read _noField;    //Номер поля фильтра (константа fn*)
property FilterStr     : string read GetFilterStr; //Отображаемое значение фильтра
property Sum           : Double absolute _sum;
property Sum2          : Double absolute _sum2;
property Match         : byte   absolute _match;
end.
