#doc
Редактирование атрибутов
#end
//======================================
InterFace GP_CheckRoleStateVA;
var cMnPlan,cRole,cState,cAttr,cUser:comp;
    fres:boolean;
create view as  select MnPlan.nrec from
  mnplan
 ,formpl
 ,spformpl
 ,SPWAYAC
 ,SpFormPL SpFormPLVA1
 ,SpFormPL SpFormPLVA2
 ,r_users
 ,GP_UserRolesByDate UserRoles

where ((
     cMnPlan == MnPlan.nrec                   and
     MnPlan.CWAYACCOU           == SPWAYAC.CWAYACMAIN and
     word(32)                   == SPWAYAC.code       and
     SPWAYAC.cvalres[4]         == SpFormPlVA1.cFormPl               and
     Word(101)                  == SpFormPlVA1.TypeRec               and
     cRole                      == SpFormPlVA1.ResComp1[1]   (NoIndex)           and
     cState                     == SpFormPlVA1.ResComp1[2]   (NoIndex)          and
     SPWAYAC.cvalres[4]         == SpFormPlVA2.cFormPl               and
     Word(102)                  == SpFormPlVA2.TypeRec               and
     SpFormPlVA1.nrec           == SpFormPlVA2.ResComp1[1]   (NoIndex)         and
     cAttr                      == SpFormPlVA2.ResComp1[2]   (NoIndex)         and
     cUser                      == r_users.CXUSERS                   and
     r_users.nrec               == UserRoles.cUser and
     (Cur_Date <= UserRoles.DateEnd or UserRoles.DateEnd = ZeroDate)
));

parameters cMnPlan,cAttr;

function CheckIT:boolean;
{
      Result:=false;
        if (getfirst fastfirstrow  SpFormPlVA1 = tsok)  then
       {
          if (getfirst fastfirstrow  SpFormPlVA2 = tsok)  then
            {
                Result:=true;
            }
       }
}

function GetState:comp;
var cTempl:comp;
{
  Result:=0;

  if (GetFirst FormPl Where ((
        Word(7)     == FormPl.TypeAlg              and
        Word(65535) == FormPl.wSysNum              and
        MnPlan.typeplan   == FormPl.ResWord[1] (NoIndex) and
        MnPlan.CWAYACCOU  == FormPl.ResComp[1] (NoIndex) and
        MnPlan.cstatus    == FormPl.ResComp[2] (NoIndex)
                                      )) = tsOk)
 {
   Result:=FormPl.nrec;
 }
}

HandleEvent
 cmInit:{
   if getfirst fastfirstrow mnplan <> tsok then {CloseInterface(cmDefault);exit;}
   if (getfirst fastfirstrow spwayac = tsok) and (SPWAYAC.cvalres[4]=0) then {CloseInterface(cmDefault);exit;}
   if getfirst fastfirstrow SpFormPlVA1 where  (( SPWAYAC.cvalres[4] == SpFormPlVA1.cFormPl and  Word(101) == SpFormPlVA1.TypeRec))<> tsok then {CloseInterface(cmDefault);exit;}
   cUser:=UserID;
   if getfirst fastfirstrow r_users <> tsok then {CloseInterface(cmCancel);exit;}

   cState:=GetState;
   fres:=false;
   _loop UserRoles
   {
    cRole:=UserRoles.crole;
    if CheckIT then
          {
           fres:=true;
           break;
          }
   }
  if (fres) then CloseInterface(cmDefault);
            else CloseInterface(cmCancel);
 }
end;
end.


