#ifndef __GP_SettingsSelector_VIH__
#define __GP_SettingsSelector_VIH__

#component "GP_Common"

ObjInterface GP_ObjSettingsSelector;
  property wProgCode:word;        //UserDeskRep.nRep
  property cCurSetting:comp read; //UserDeskRep.NRec

  function DelSetting(cSetting:comp):boolean;

  event procedure OnChangeCurSetting(cCurSetting:comp);
  event procedure OnSaveCurSetting(cCurSetting:comp);
end;

