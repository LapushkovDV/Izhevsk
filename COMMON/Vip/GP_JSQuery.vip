#include Query.vih
#include GP_JSQuery.vih
#include GP_Collections.vih

#component "GP_Common"

interface GP_JSQuery;
var
  _query: IQuery;
  _resultSet: IResultSet;
  _paramSetters: GP_IDictionary(GP_Dictionary) new;

procedure SetQueryParams;
{
  var enum: GP_IEnumerator;
  enum := _paramSetters.GetEnumerator;

  while enum.MoveNext
  {
    var keyValuePair: GP_IKeyValuePair;
    keyValuePair := GP_IKeyValuePair(enum.Current);
    GP_IQueryParamSetter(keyValuePair.Value).SetQueryParamValue(_query, keyValuePair.Key);
  }
}

function GetResultSet: IResultSet;
{
  SetQueryParams;
  if _resultSet != NullRef
    FreeVipInterface(_resultSet);
  _resultSet := _query.getResultSet;
  result := _resultSet;
}

function Execute: integer;
{
  SetQueryParams;
  result := _query.execute.errorCode;
}

function setMacro(macro: string; value: variant): GP_IJSQuery;
{
  _query.setMacro(macro, value);
  result := GP_IJSQuery(self);
}

function isMacroDefined(macro: string): byte;
{
  result := _query.isMacroDefined(macro);
}

function addCriteria(combination: string; criteria: variant): GP_IJSQuery;
{
  _query.addCriteria(combination, criteria);
  result := GP_IJSQuery(self);
}

function errorCode: integer;
{
  result := _query.errorCode;
}

function rowCount: longInt;
{
  result := _query.rowCount;
}

function SetParam(paramName: string; paramValue: variant): GP_IJSQuery;
{
  var queryParamSetter: GP_IQueryParamSetter;
  queryParamSetter := _paramSetters.ValueGet(paramName);

  if queryParamSetter = nullref
  {
    case vType(paramValue) of
      VT_I8  : queryParamSetter := GP_IQueryParamSetter(new(GP_QueryCompParamSetter));
      VT_UI2 : queryParamSetter := GP_IQueryParamSetter(new(GP_QueryWordParamSetter));
      VT_R8  : queryParamSetter := GP_IQueryParamSetter(new(GP_QueryDoubleParamSetter));
      VT_DATE: queryParamSetter := GP_IQueryParamSetter(new(GP_QueryDateParamSetter));
      VT_BOOL: queryParamSetter := GP_IQueryParamSetter(new(GP_QueryBoolParamSetter));
    else
      queryParamSetter := GP_IQueryParamSetter(new(GP_QueryStringParamSetter));
    end;
    _paramSetters.AddKeyValue(paramName, queryParamSetter);
  }

  queryParamSetter.SetParamValue(paramValue);
  result := GP_IJSQuery(self);
}

Constructor Init;
{
  result := false;
}

Constructor Create(sqlStr: variant);
{
  _query := queryManager.createQuery(sqlStr);
  result := _query != nullref;
}

property ResultSet: IResultSet read _resultSet;

end.
