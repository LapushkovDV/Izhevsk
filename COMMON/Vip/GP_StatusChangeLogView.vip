interface GP_StatusChangeLogView 'История изменения статусов', Cyan, DoAccept, EscClose;
show(20,5,150,25);

var wCurTbl:word;
    cCurDoc:comp;

create view
as Select GP_StatusChangeLog.wTbl
from
  GP_StatusChangeLog,
  GP_Status StatusFrom, GP_Status StatusTo
where((
  wCurTbl==GP_StatusChangeLog.wTbl and cCurDoc==GP_StatusChangeLog.cDoc and
  GP_StatusChangeLog.cStatusFrom==StatusFrom.NRec and
  GP_StatusChangeLog.cStatusTo==StatusTo.NRec and
  GP_StatusChangeLog.cUser==X$Users.Atl_NRec
));

parameters wCurTbl,cCurDoc;

browse brStatusChangeLog (,,sci1Esc);
table GP_StatusChangeLog;
fields
  GP_StatusChangeLog.DateOper 'Дата изменения':[20,'DD.MM.YYYY HH:NN:SS'],Protect,NoAutoSize;
  StatusFrom.Name 'Из статуса':[20],Protect,NoDel;
  StatusTo.Name 'В статус':[20],Protect,NoDel;
  X$Users.XU$FULLNAME 'Кто изменил':[25],Protect,NoDel;
  GP_StatusChangeLog.Notice 'Примечание' ('Примечание',,):[40],Protect;
end;

HandleEvent
cmInit:{
  if (wCurTbl=0 or cCurDoc=0) {
    abort;
    exit;
  }
}
end;
end.
