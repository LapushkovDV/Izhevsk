#include epSystem.vih


handler with replace GP_RunURLInterface_Test1 on ExtensionPoint epRunURLInterface (aCommandLine: string)
Action
{  var aCommandLine_up:string=UpCase(aCommandLine);
   Timelog_Init;
   timelog('GP_RunURLInterface_Test1:aCommandLine='+aCommandLine);
   do {
     if SubStr(aCommandLine_UP,1,Length('INTERFACE'))='INTERFACE'
     { timelog('GP_RunURLInterface_Test1:INTERFACE');
       RunAnyView(aCommandLine,false);
       break;
     }
     Message(aCommandLine); // Вместо Message здесь нужно обработать команды из ссылки.
   } while false;
   Result := true;
}
