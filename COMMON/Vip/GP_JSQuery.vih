/*************************************************************************************************\
* Наименование: Объектные интерфейсы для работы с IQuery в JS-библиотеке "Функции для работы с    *
*               прямым SQL": GP_IQueryParamSetter, GP_IJSQuery, GP_IJSQueryManager                *
* Контур/Модуль: Планирование производства                                                        *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Доработка   |#000          |06/07/18|Евдокимов М.А.           |НПО Энергомаш                    *
\*************************************************************************************************/
#ifndef __JSQuery__
#define __JSQuery__

#include Query.vih

#component "GP_Common"

#doc
Объектный интерфейс "Установщик параметра sql-запроса"
#end
objinterface GP_IQueryParamSetter;
  #doc
  Сохраняет значение, которое будет передаваться в параметр запроса
  #end
  procedure SetParamValue(value: variant);

  #doc
  Передает сохраненное значение в параметр с именем paramName запроса query
  #end
  procedure SetQueryParamValue(query: IQuery; paramName: string);
end;

vipinterface GP_QueryStringParamSetter implements GP_IQueryParamSetter;
vipinterface GP_QueryCompParamSetter   implements GP_IQueryParamSetter;
vipinterface GP_QueryWordParamSetter   implements GP_IQueryParamSetter;
vipinterface GP_QueryDoubleParamSetter implements GP_IQueryParamSetter;
vipinterface GP_QueryDateParamSetter   implements GP_IQueryParamSetter;
vipinterface GP_QueryBoolParamSetter   implements GP_IQueryParamSetter;

#doc
Обертка к IQuery для корректной работы IQuery в JS библиотеке.
Установка параметров запроса в direct sql и в IQuery в частности происходит по ссылке.
Переменная со значением параметра, полученная из JS скрипта уничтожается при завершении выполнения
соответствующего обработчика JS-инструкции и запрос выполняется некорректно.
GP_IJSQuery хранит словарь объектов типа GP_IQueryParamSetter, каждый из которых содержит переменную,
хранящую значение устанавливаемого параметра. Непосредственно перед выполнением запроса (GetResultSet, Execute)
сеттеры устанавливают параметры запроса. Таким образом предотвращается преждевременная деинициализация переменных
со значениями параметров запроса.
Свойство ResultSet - результат запроса, полученный с помощью метода GetResultSet. При вызове метода GetResultSet
предыдущий результат запроса уничтожается.
#end
objinterface GP_IJSQuery;
  function GetResultSet: IResultSet;
  function Execute: integer;
  function setMacro(macro: string; value: variant): GP_IJSQuery;
  function isMacroDefined(macro: string): byte;
  function addCriteria(combination: string; criteria: variant): GP_IJSQuery;
  function errorCode: integer;
  function rowCount: longInt;
  function SetParam(paramName: string; paramValue: variant): GP_IJSQuery;
  property ResultSet: IResultSet read;
end;

vipinterface GP_JSQuery implements GP_IJSQuery;
public:
  Constructor Init;
  Constructor Create(sqlStr: variant);
end;

#doc
Менеджер объектов GP_IJSQuery.
Создает, организует доступ к объектам по уникальным ключам key
#end
objinterface GP_IJSQueryManager;
  #doc
  Создает GP_IJSQuery с ключем key и текстом запроса sqlStr. sqlStr - строка/id sql строки/идентификатор текста запроса.
  Возвращает ссылку на объект.
  #end
  function CreateJSQuery(key: variant; sqlStr: variant): GP_IJSQuery;

  #doc
  Возвращает GP_IJSQuery по ключу key. Если объект не найден - возвращает nullref.
  #end
  function GetJSQuery(key: variant): GP_IJSQuery;

  #doc
  Удаляет объект по ключу key. Возвращает True, если объект найден и удален.
  #end
  function RemoveJSQuery(key: variant): boolean;
end;

vipinterface GP_JSQueryManager implements GP_IJSQueryManager;

#end
