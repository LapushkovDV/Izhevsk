#include GP_UserFilterManagerViewActiveFilters.vih
#include GP_UserFilterManager.vih
#include GP_UserFilterString.vih
#include GP_UserFilterPeriod.vih
#include GP_UserFilterAnalit.vih
#include GP_UserFilterDouble.vih
#include GP_UserFilterStoreDSK.vih

#component "GP_COMMON"

interface GP_UserFilterManagerExample;

var
  _filterManager    : GP_IUserFilterManager noauto;
  _filterStore      : GP_UserFilterStoreDSK noauto;
  _filterManagerView: GP_UserFilterManagerViewActiveFilters noauto;

create view
as select
  KatMc.Nrec
from KatMc, GroupMc
where ((
  KatMc.cGroupMc == GroupMc.Nrec
));

embedded embActiveFilters interface;
show (,,,2) fixed_y;
end;

browse br1 (,,sci18Esc);
show (,3,,);
table KatMc;
fields
  KatMc.Name 'Name': [50], protect;
  KatMc.Atl_LastDate 'Atl_LastDate': [10], protect;
  GroupMc.Name 'GroupMcName': [30], protect;
  KatMc.SizeX 'SizeX': [10,3], protect;
  KatMc.SizeY 'SizeY (без фильтра)': [10,3], protect;
end;

procedure AddUserFilterString(lNoField: longint; sSaveName: string; sCaption: string);
{
  _filterManager.AddFilter(lNoField,
                           GP_IUserFilter(new(GP_UserFilterString,
                                              UserFilterString(lNoField, sSaveName))),
                           sCaption);
}

procedure AddUserFilterPeriod(lNoField: longint; sSaveName: string; sCaption: string;
                              dDateBeg: date = 0; dDateEnd: date = 0;
                              dDefaultDateBeg: date = 0; dDefaultDateEnd: date = 0);
{
  _filterManager.AddFilter(lNoField,
                           GP_IUserFilter(new(GP_UserFilterPeriod,
                                              UserFilterPeriod(lNoField, sSaveName, dDateBeg,
                                              dDateEnd, dDefaultDateBeg, dDefaultDateEnd))),
                           sCaption);
}

procedure AddUserFilterDouble(lNoField: longint; sSaveName: string; sCaption: string);
{
  _filterManager.AddFilter(lNoField,
                           GP_IUserFilter(new(GP_UserFilterDouble,
                                              UserFilterDouble(lNoField, sSaveName))),
                           sCaption);
}

procedure AddUserFilterAnalit(lNoField: longint; sSaveName: string; kodgrKau: word; sCaption: string);
{
  _filterManager.AddFilter(lNoField,
                           GP_IUserFilter(new(GP_UserFilterAnalit,
                                              UserFilterAnalit(lNoField, sSaveName, kodgrKau))),
                           sCaption);
}


handleevent

cmInit:
{
  _filterStore := new(GP_UserFilterStoreDSK, InitDSK(''));
  _filterManager := GP_IUserFilterManager(new(GP_UserFilterManager, UserFilterManager(GP_IUserFilterStore(_filterStore))));
  _filterManagerView := new(GP_UserFilterManagerViewActiveFilters, UserFilterManagerViewActiveFilters(_filterManager));
  AddUserFilterString(#KatMc.Name, 'KatMcName', 'Наименование');
  AddUserFilterPeriod(#KatMc.Atl_LastDate, 'KatMcAtlLastDate', 'Дата', cur_date, cur_date);
  AddUserFilterAnalit(#GroupMc.Name, 'GroupMcName', cgKau_GroupMc, 'Группа МЦ');
  AddUserFilterDouble(#KatMc.SizeX, 'KatmcSizeX', 'Размер X');
  BindEmbeddedInterface(embActiveFilters, _filterManagerView);
  //_filterManager.ActivateFilterForField(#KatMc.Name);
  //_filterManager.ActivateFilterForField(#KatMc.Barkod);
}

cmHotkeys:
{
  var menuId: longint;
  menuId := CreateMenu;
  if _filterManager.AddMenuItemForField(menuId, curfield)
    EnableCommand(cmNal)
  else
    DisableCommand(cmNal);
  PutHotCommand(RunLoadMenu(menuId));
}

cmNal: //Alt+F
{
  if _filterManager.EditFilterForField(curfield)
  {
    _filterManager.Save;
  }
}

end;

end.
