#include GP_DocFields.vih

interface GP_DocFields;

var CurGroup,CurRootContainer,CurContainer:string;
    CurNum:longint=0;

Table struct DocFields(
  Num:longint,
  Group:string,Name:string,Title:string,
  RootContainer:string,Container:string,ControlName:string,ObjType:longint,
  PropProtect:boolean,PropDefPickButton:boolean,PropButtonType:integer,PropStatusCtx:word,
  OrigFontColor:boolean,PropFontColor:word,
  State:word,IsUsed:boolean
  //----- поля по умолчанию
  ,Def_ObjType    :longint
  ,Def_StatusCtx  :longint // статус по умолчанию cfpStatusCtx
  ,Def_Protect    :boolean // поле закрыто        cfpProtect
  ,Def_CalendarBut:boolean //
  ,Def_CalcButton :boolean //
  ,Def_PickButton :boolean //
  ,Def_SpinButton :boolean //
)
with index (
  iNum=Num,
  iName=Group + Name,
  iIsUsed=IsUsed + RootContainer + ControlName
);

create view
as select
  DocFields.*
from
  DocFields;

create view Modif
from
  DocFields;

procedure SetGroup(GroupName:string);
{
  CurGroup:=GroupName;
}

procedure SetRootContainer(RootContainer:string);
{
  CurRootContainer:=RootContainer;
}

procedure SetContainer(Container:string);
{
  CurContainer:=Container;
}

procedure Add(DFI:GP_DocFieldInfo; _pDef_Control:TDef_Control);
{
  if (Trim(DFI.Name)='' or Trim(DFI.Title)='') exit;

  if (getfirst fastfirstrow DocFields
      where((CurGroup==DocFields.Group and DFI.Name==DocFields.Name))=tsok) exit;

  ClearBuffer(tnDocFields);
  DocFields.Num          :=++CurNum;
  DocFields.RootContainer:=CurRootContainer;
  DocFields.Container    :=CurContainer;
  DocFields.Group        :=CurGroup;

  DocFields.Name         :=DFI.Name;
  DocFields.ControlName  :=DFI.Control;
  DocFields.Title        :=DFI.Title;
  DocFields.ObjType      :=DFI.ObjType;

  DocFields.PropProtect:=DFI.PropProtect;
  DocFields.PropDefPickButton:=DFI.PropDefPickButton;
  DocFields.PropButtonType:=DFI.PropButtonType;
  DocFields.PropStatusCtx:=DFI.PropStatusCtx;
  DocFields.OrigFontColor:=DFI.OrigFontColor;
  DocFields.PropFontColor:=DFI.PropFontColor;

  //--------------------------------------
  DocFields.Def_ObjType     :=_pDef_Control._ObjType     ;
  DocFields.Def_StatusCtx   :=_pDef_Control._StatusCtx   ;
  DocFields.Def_Protect     :=_pDef_Control._Protect     ;
  DocFields.Def_CalendarBut :=_pDef_Control._CalendarBut ;
  DocFields.Def_CalcButton  :=_pDef_Control._CalcButton  ;
  DocFields.Def_PickButton  :=_pDef_Control._PickButton  ;
  DocFields.Def_SpinButton  :=_pDef_Control._SpinButton  ;
  //--------------------------------------
  insert current DocFields;
}

procedure Del(_Name:string);
{
  Modif.delete DocFields where((CurGroup==DocFields.Group and _Name==DocFields.Name));
}

procedure ChangeTitle(_Name, NewTitle:string);
{
  Modif.update DocFields where((CurGroup==DocFields.Group and _Name==DocFields.Name)) set
    DocFields.Title:=NewTitle;
}

procedure SetPickButton(pFieldName: string; pValue: boolean);
{
  Modif.update DocFields where((CurGroup==DocFields.Group and pFieldName==DocFields.Name)) set
    DocFields.Def_PickButton := pValue;
}

procedure SetCalendarButton(pFieldName: string; pValue: boolean);
{
  Modif.update DocFields where((CurGroup==DocFields.Group and pFieldName==DocFields.Name)) set
    DocFields.Def_CalendarBut := pValue;
}

procedure UseOrigFontColor(_Name:string);
{
  Modif.update DocFields where((CurGroup==DocFields.Group and _Name==DocFields.Name)) set
    DocFields.OrigFontColor:=true;
}

function GetDocFieldInfo:GP_DocFieldInfo;
{
  var DFI:GP_DocFieldInfo;
  DFI.Name:=DocFields.Name;
  DFI.Title:=DocFields.Title;
  DFI.Control:=DocFields.ControlName;
  DFI.ObjType:=DocFields.ObjType;
  DFI.PropProtect:=DocFields.PropProtect;
  DFI.PropDefPickButton:=DocFields.PropDefPickButton;
  DFI.PropButtonType:=DocFields.PropButtonType;
  DFI.PropStatusCtx:=DocFields.PropStatusCtx;
  DFI.OrigFontColor:=DocFields.OrigFontColor;
  DFI.PropFontColor:=DocFields.PropFontColor;
  result:=DFI;
}

property Num          :longint absolute DocFields.Num read;
property Group        :string  absolute DocFields.Group read;
property Title        :string  absolute DocFields.Title read;
property Name         :string  absolute DocFields.Name read;
property RootContainer:string  absolute DocFields.RootContainer read;
property Container    :string  absolute DocFields.Container read;
property ControlName  :string  absolute DocFields.ControlName read;
property State        :word    absolute DocFields.State;
property IsUsed       :boolean absolute DocFields.IsUsed;
//------------------------------------------
property Def_ObjType       :longint  absolute DocFields.Def_ObjType     read write;
property Def_StatusCtx     :longint  absolute DocFields.Def_StatusCtx   read write; // статус по умолчанию cfpStatusCtx
property Def_Protect       :boolean  absolute DocFields.Def_Protect     read write; // поле закрыто        cfpProtect
property Def_CalendarBut   :boolean  absolute DocFields.Def_CalendarBut read write; //
property Def_CalcButton    :boolean  absolute DocFields.Def_CalcButton  read write; //
property Def_PickButton    :boolean  absolute DocFields.Def_PickButton  read write; //
property Def_SpinButton    :boolean  absolute DocFields.Def_SpinButton  read write; //

index iNum      auto;
index iName     auto;
index iIsUsed   auto;

function IModify.doUpdate: word;
{
  Result := update current DocFields;
}
implementation IModify.DoInsert abstract;
implementation IModify.DoDelete abstract;
implementation IModify.doFlush abstract;

end.
