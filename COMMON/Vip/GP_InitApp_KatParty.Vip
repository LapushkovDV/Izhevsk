#Include GP_InitApp_KatParty.Vih

#doc
 Установка статуса по просроченным партиям
 Не добавлять лишних таблиц!
 Быстродействие критично!
 Грузиться при старте галактики!
#end
Interface GP_InitApp_KatParty;
create view
var
   pParty:comp;
as select KAtParty.Nrec
From
  KAtParty
 ,KatNotes
where (( pParty == KAtParty.Nrec
 and 429 == KatNotes.VidDoc
 and 'истек срок годности' == KatNotes.Name(Noindex)
));

//------------------------------------------------------------------------------
#doc
   установка статуса в просроченных партиях
#end
Function CheckDGodn:boolean;
{ Result:=false;
  timelog_init;
  timelog('GP_InitApp_KatParty->CheckDGodn:boolea');
  var _dt:date=Cur_Date;
  var _pNote:comp=0;
  if getfirst KatNotes=tsok
     _pNote:=KatNotes.Nrec
  else
    timelog('GP_InitApp_KatParty->CheckDGodn:boolea не нашли статус партии "истек срок годности"');
  if IsProtected(#KatParty) then exit;
  dSetTune('NPOEM_OWN.KATPARTY.DATECHECK',_dt);
  timelog('GP_InitApp_KatParty->CheckDGodn:boolea:start');
  _Try
  {  SQL
     update katparty
     set katparty.CNOTE =  :(_pNote) //KatNotes.Nrec
        ,katparty.status = 2
     where KatParty.Status=0
      and katparty.DGODN < :(_dt)
      and katparty.DGODN  <> 0
      and KatParty.Nrec in
     ( select KatParty.Nrec    From KatParty
       inner join GROUPPARTY on GROUPPARTY.nrec = KatParty.CGROUPPARTY
          and GROUPPARTY.kod in  ('ГОЗ', 'Ком','ПДС')
       inner join KatNotes KatNotes_Cur on KatNotes_Cur.Nrec = katparty.CNOTE
            //and KatNotes_Cur.Name in ('годен','Отпуск разрешен','Прочий отпуск разрешен')
            and KatNotes_Cur.Status=0
       inner join KatNotes on KatNotes.Name= 'истек срок годности' and KatNotes.VidDoc=429
       where katparty.status = 0
         and katparty.DGODN < :(_dt)
         and katparty.DGODN  <> 0
     );
    timelog('GP_InitApp_KatParty->CheckDGodn:boolea:finish');
  }
  _Except
  else
  { timelog('Возникло исключение при запуске запроса CheckDGodn '+ExploreException);
  }
  Result:=true;
} //Function CheckDGodn:boolea;
end.//Interface GP_InitApp_KatParty;
