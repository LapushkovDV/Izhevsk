#component "M_MNPLAN"

Alter InterFace  GetTemplReg;

OverloadFormats scFormPl1;
OverloadFormats scFormPl1_1;
var vcRec:comp;
create view as select FormPl.* from
 r_Role RoleVA
 ,FormPl FormPl_stateVA
 ,SpFormPL SpFormPLVA1
 ,SpFormPL SpFormPLVA2
 ,AttrNam AttrNamVA
where
((
    //'перечень ролей состояний
    FormPl.NRec                == SpFormPlVA1.cFormPl               and
    Word(101)                  == SpFormPlVA1.TypeRec               and
    SpFormPlVA1.ResComp1[1]    == RoleVA.NRec                       and
    SpFormPlVA1.ResComp1[2]    == FormPl_StateVA.NRec               and

    //'перечень ВА
    FormPl.NRec                == SpFormPlVA2.cFormPl               and
    Word(102)                  == SpFormPlVA2.TypeRec               and
    SpFormPlVA1.NRec           == SpFormPlVA2.ResComp1[1] (NoIndex) and
    SpFormPlVA2.ResComp1[2]    == AttrNamVA.NRec
));

procedure InsertVA1;
begin
          SpFormPlVA1.NRec := GetNextNRec(#SpFormPlVA1, 0);
          SpFormPlVA1.cFormPl := FormPl.nrec;
          SpFormPlVA1.TypeRec := word(101);
          Insert Current SpFormPlVA1;

          vcRec := SpFormPlVA1.Nrec;

          ReReadRecord(#SpFormPlVA1);
          if (GetFirst SpFormPlVA1 where ((vcRec == SpFormPlVA1.Nrec)) = tsOk){}
end;

procedure InsertVA2;
begin
          SpFormPlVA2.NRec := GetNextNRec(#SpFormPlVA2, 0);
          SpFormPlVA2.cFormPl := FormPl.nrec;
          SpFormPlVA2.TypeRec := word(102);
          SpFormPlVA2.ResComp1[1] := SpFormPlVA1.nrec;
          Insert Current SpFormPlVA2;

          vcRec := SpFormPlVA2.Nrec;

          ReReadRecord(#SpFormPlVA2);
          if (GetFirst SpFormPlVA2 where ((vcRec == SpFormPlVA2.Nrec)) = tsOk){}
end;


Window wEditVA 'Редактирование прав на изменение атрибутов' (,hcZakaz_GetTemplReg,) EscClose;
//Show at (,5,,27);

Browse brFormPl1VA (,, sci1378Esc);
 Show  at (,,,8);
 Table SpFormPlVA1;
Fields
  RoleVA.Name 'Наименование роли' ('Наименование роли',,sci1378Esc):[30], Protect, NoDel;
  FormPl_StateVA.Code  'Код' ('Код состояния',,):[5], Protect;
  FormPl_StateVA.Name  'Наименование состояния' ('Наименование состояния',,):[30], Protect;
End;  //'browse


Browse brEditRoleVA (,, sci178Esc);
 Show  at (,9,,);
 Table SpFormPlVA2;
Fields
  AttrNamVA.Name 'Наименование ВА' ('Наименование ВА',,sci1378Esc):[30], Protect, NoDel;
End;

HandleEvent
cmInit:
{
  if Not IsValid(#FormPl)
    PutCommand(cmInsert);
}

cmInsert:
{
  case CurField of
    #Formpl : InsertTemplate;
    #RoleVA.Name,#FormPl_StateVA.Code,#FormPl_StateVA.Name :
      {
          InsertVA1;
          PutCommand(cmPick);
      }
    #AttrNamVA.Name :
      {
         // InsertVA2;
          PutCommand(cmPick);
      }
  end;

  Abort;

  ReScanPanel(#FormPl);
}
cmPIck:
 {
  Case CurField of
     #FormPl_StateVA.Name, #FormPl_StateVA.Code:
      {
          if (RunInterface('GetDocstate', SpFormPlVA1.ResComp1[2], True, FormPl.ResWord[1], FormPl.ResComp[1], p_TypeState, 0) = cmCancel) exit;
      }

   #RoleVA.Code, #RoleVA.Name:
      if (RunInterface('iR_Role', SpFormPlVA1.ResComp1[1], 9) = cmCancel) exit;

   #AttrNamVA.Name:
      {
        var cRec:comp = SpFormPlVA2.ResComp1[2];
        if (RunInterface(PickAttrNam, cRec, coMnPlan, cgiMulti)=cmDefault) {
        var m:TPtr = InitMarker('GetAttrName',8,0,1);
        var i, k:longint;
        k:=GetMarkerCount(m);
        for(i:=0;i<k;i++) {
        GetMarker(m, i, cRec);
        if (getfirst fastfirstrow  SpFormPlVA2 where ((
                    FormPl.NRec                == SpFormPlVA2.cFormPl               and
                    Word(102)                  == SpFormPlVA2.TypeRec               and
                   SpFormPlVA1.NRec            == SpFormPlVA2.ResComp1[1] (NoIndex) and
                    crec                       == SpFormPlVA2.ResComp1[2] (NoIndex)))    =tsok)        continue;
        ClearBuffer(#SpFormPlVA2);
        SpFormPlVA2.NRec := GetNextNRec(#SpFormPlVA2, 0);
        SpFormPlVA2.cFormPl := FormPl.nrec;
        SpFormPlVA2.TypeRec := word(102);
        SpFormPlVA2.ResComp1[1] := SpFormPlVA1.nrec;
        SpFormPlVA2.ResComp1[2] := crec;
        Insert Current SpFormPlVA2;
         }
          DoneMarker(m,'');
       ReReadRecord(#SpFormPlVA2);

       }
       }

  end;

   case curtable of
     #SpFormPlVA1 :
    {
      if not isValid(#SpFormPlVA1)
        {
        InsertVA1;
        }
      else
      {
        if (update current SpFormPlVA1 = tsOk)
          RescanPanel(#SpFormPlVA1);
      }
    }
     #SpFormPlVA2 :
    {
      if not isValid(#SpFormPlVA2)
        InsertVA2;
      else
      {
        if (update current SpFormPlVA2 = tsOk)
          RescanPanel(#SpFormPlVA2);
      }
    }

  end;
 }

cmDelete:
{
  if ( Message( ''#3'Удалить запись ?', YesNo ) = Yes )
  {
     case curtable of
       #SpFormPlVA1 :
         {

           delete SpFormPlVA2 where ((FormPl.NRec                == SpFormPlVA2.cFormPl   and
                                      Word(102)                  == SpFormPlVA2.TypeRec   and
                                      SpFormPlVA1.NRec           == SpFormPlVA2.ResComp1[1] (NoIndex) ));
           delete current SpFormPlVA1;
           RescanPanel(#SpFormPlVA1);
           RescanPanel(#SpFormPlVA2);
         }
       #SpFormPlVA2 :
         {
           delete current SpFormPlVA2;
           RescanPanel(#SpFormPlVA2);
         }
     end;
  }
}


cmDone:
{
  if (Update Current FormPl = tsOk){};
  ReReadRecord(#FormPl);
}
end;
end;


Window wEditFormPl 'Редактирование шаблона' (,hcZakaz_GetTemplReg,) EscClose;
//Show at (,5,,27);
Screen scFormPl1 (,,sci178Esc);
Show at (,,,7);
Table FormPl;
Fields
  FormPl.Code ('Код шаблона',,), NoProtect;
  FormPl.Name ('Наименование шаблона',,), NoProtect;
  FormPl.ResWord[1] ('Тип документа',,sci1378Esc) :
   [List
     toPlan     'Производственный план',
     toNeedMt   'Потребность в материалах',
     toNeedTr   'Потребность в трудовых ресурсах',
     toNeedEq   'Потребность в оборудовании',
     toPlanSb   'План сбыта',
     toPlanSnab 'План снабжения',
     toMnfZakaz 'Производственный заказ',
     toZClient  'Заявка',

     toPlanSvod      'Сводный план',
     toPlanOper      'Пооперационный  план',
     toCorpoBalance  'Плановые остатки',
     toCorpoNeed     'Корпоративная потребность',
     toCorpoDelivery 'Корпоративный план поставок',
     toCorpoManuf    'Корпоративный план производства',
     toOperPlan      'Оперативный план заказов'
   ], Protect;
  fTemplateName ('Шаблон документа',,sci1378Esc) : Protect, PickButton,
    {Font = {BackColor = if (FormPl.ResComp[1] = Comp(0), ColorNeed, 0)}};
  FormPl.ResWord[2] ('Разные настройки',,) : NoProtect;
 Buttons
  cmB1;
<<

`Код шаблона`           .@@@@@@@@@@@@@@@@@@@@@
`Наименование шаблона`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

`Тип документа`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Шаблон`       .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] Вести историю изменения состояния`  <. Настройка прав на изменение внешних атрибутов .>
>>
End;  //'screen

Screen scFormPl1_1 (,,sci178Esc);
Show at (,,,7);
Table FormPl;
Fields
  FormPl.Code ('Код шаблона',,), NoProtect;
  FormPl.Name ('Наименование шаблона',,), NoProtect;
  FormPl.ResWord[1] ('Тип документа',,sci1378Esc) :
   [List
     toPlan     'Производственный план',
     toNeedMt   'Потребность в материалах',
     toNeedTr   'Потребность в трудовых ресурсах',
     toNeedEq   'Потребность в оборудовании',
     toPlanSb   'План сбыта',
     toPlanSnab 'План снабжения',
     toMnfZakaz 'Производственный заказ'//,
   //toZClient  'Заявка'
   ], Protect;
  fTemplateName ('Шаблон документа',,sci1378Esc) : Protect, PickButton,
    {Font = {BackColor = if (FormPl.ResComp[1] = Comp(0), ColorNeed, 0)}};
  FormPl.ResWord[2] ('Разные настройки',,) : NoProtect;
Buttons
  cmB1;

<<

`Код шаблона`           .@@@@@@@@@@@@@@@@@@@@@
`Наименование шаблона`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

`Тип документа`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Шаблон`       .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] Вести историю изменения состояния` <. Настройка прав на изменение внешних атрибутов .>
>>
End;  //'screen
HandleEvent
cmB1:
 {RunWindow(wEditVA);}
end;
end;
end.
