#include GP_UserFilterStringEditView.vih;

#component "GP_Common"

#include GP_UserFilterString.vih
interface GP_UserFilterString;

var
  _noField       : tptr;
  _filterStr     : string;
  _saveName      : string;
  _filterString  : String;
  _match         : Byte;
  _editView      : GP_UserFilterStringEditView noauto;

window wPick 'Установка фильтра по строке' escClose, doAccept;
  show(,,70,5);
  embedded scPick interface _editView;
  show(,,,2);
  end;
  screen scButtons;
  show(,3,,) fixed_y;
  buttons
    cmDoOk, default;
<<
                                                     <. Продолжить .>
>>
  end;
  handleevent
    cmDoOk: PutCommand(cmDefault);
  end;
end; //window

procedure OnEditViewCmDefault;
{
  CloseWindowEx(wPick, cmDefault);
}

constructor UserFilterString(NoField:tptr; SaveName:string; sFilterString: string = '';
                             bMatch: byte = GP_UserFilterString_Match_Equal);
{
  _noField      := NoField;
  _saveName     := SaveName;
  _filterString := sFilterString;
  _match        := bMatch;
  _editView     := new(GP_UserFilterStringEditView, UserFilterStringEditView(self, 'Фильтр по строке'));
  BindEvent(OnEditViewCmDefault, _editView.OnCmDefault);
  result        := true;
}

procedure Pick;                //Выбор значения(й) фильтра
{
  RunWindowModal(wPick)
}

procedure Del;                 //Очистка фильтра
{
  _filterString := '';
}

procedure Load(IStore: GP_IUserFilterStore);//Загрузить значения фильтра из хранилища IStore
{
  _filterString := IStore.LoadString(_saveName + '_FilterString');
  _match := byte(IStore.LoadComp(_saveName + '_Match'));
}

procedure Save(IStore: GP_IUserFilterStore);//Сохранить значения фильтра в хранилище IStore
{
  IStore.SaveString(_filterString, _saveName + '_FilterString');
  IStore.SaveComp(comp(_match), _saveName + '_Match');
}

function GetFilterStr: string;    //Функция формирующая отображаемое значение фильтра
{
  result := case(_match;
                 GP_UserFilterString_Match_Equal: '= "',
                 GP_UserFilterString_Match_Like: 'Содержит "';
                 '? "') +
            _filterString + '"';
}

property NoField       : tptr read _noField;    //Номер поля фильтра (константа fn*)
property FilterStr     : string read GetFilterStr; //Отображаемое значение фильтра
property FilterString  : string absolute _filterString;
property Match         : byte absolute _match;
end.
