#include GP_StrFunc.vih
#include ODecl.vih // Объектный интерфейс для склонения фамилий
#include PostInPaternal.vih // Должность в род.и дат. падеже
#include CatFunc.vih // Функции работы с Catalogs
#include AppFuncs.vih // Функции работы с назначениями

interface GP_StrFunc;

  const
    SHORT_FIO_ALIGN_RIGHT = 1; // Фамилия с инициалами, инициалы справа
    SHORT_FIO_ALIGN_LEFT = 2; // Фамилия с инициалами, инициалы слева
    // Константы для функции PeriodName
    ST_YEAR = 'год';
    ST_YEARS = 'года';
    ST_QUARTER = 'квартал';
    ST_HALF_OF_YEAR = 'полугодие';
    ST_FOR = 'за';
    ST_FIRST = 'первые';
    ST_MONTHS = 'месяцев';
    ST_PERIOD = 'период';
    ST_FROM = 'с';
    ST_TO = 'по';
  end;

  create view
    from
      Appointments;

  var
    IDecl: Declension;
    IPostInP: PostInPaternal;
    ICatFunc: CatalogsFunctions;
    VAppFuncs: AppointmentsFunctions;

  // Преобразует полные Фамилию Имя и Отчество в Фамилию с инициалами
  // FIOType - тип:
  //  1 Фамилия с инициалами, инициалы справа
  //  2 Фамилия с инициалами, инициалы слева
  function ShortFIO(FIO: String; FIOType: Byte = 1): String;
  var
    P: Byte;
    S: String;
    _Surname, _Name, _Patronymic: String = '';
  begin
    S := Trim(FIO);
    P := InStr(' ', S);
    if P > 0 then
    begin
      _Surname := SubStr(S, 1, P - 1);
      S := Trim(SubStr(S, P + 1, Length(S) - P));
      P := InStr(' ', S);
      if P = 0 then
        P := InStr('.', S);
      if P > 0 then
      begin
        _Name := Trim(SubStr(S, 1, P));
        _Patronymic := Trim(SubStr(S, P + 1, Length(S) - P));
      end else
      begin
        _Name := S;
        _Patronymic := '';
      end;
    end else
    begin
      _Surname := S;
      _Name := '';
      _Patronymic := '';
    end;
    result := _Surname;
    if FIOType = SHORT_FIO_ALIGN_LEFT then
    begin
      if _Patronymic != '' then
        result := SubStr(_Patronymic, 1, 1) + '. ' + result;
      if _Name != '' then
        result := SubStr(_Name, 1, 1) + '.' + If(_Patronymic = '', ' ', '') + result;
    end else
    begin
      if _Name != '' then
        result := result + ' ' + SubStr(_Name, 1, 1) + '.';
      if _Patronymic != '' then
        result := result + If(_Name = '', ' ', '') + SubStr(_Patronymic, 1, 1) + '.';
    end;
  end;

  // Сцепляет две строки, вставляя между ними разделитель
  // Если какая-то из строк пустая, разделитель не вставляется
  // Если разделитель запятая, точка или точка с запятой, то после разделителя вставляется пробел
  function LinkStr(S1: String; S2: String; Delim: String): String;
  begin
    S1 := Trim(S1);
    S2 := Trim(S2);
    if Delim = '' or Delim = ',' or Delim = '.' or Delim = ';' then
      Delim := Delim + ' ';
    if S1 != '' and S2 != '' then
      LinkStr := S1 + Delim + S2
    else
      LinkStr := S1 + S2;
  end;

  // Преобразовывет количество в строку, удаляя все незначащие нули после запятой
  function QuantToStr(N: Double): String;
  var
    S: String;
    C: Char;
    I: Byte;
  begin
    S := To_Char(N, 0, wGetTune('ROUND.KOLSIGN'));
    I := Length(S);
    while true do
    begin
      if I <= 1 then
        break;
      C := SubStr(S, I, 1);
      if C = '0' or C = '.' then
        Dec(I)
      else
        break;
      if C = '.' then
        break;
    end;
    QuantToStr := SubStr(S, 1, I);
  end;

  // Аналог DateToStr, но в случае, если дата пустая, возвращается пустая строка, а не 'ДД/ММ/ГГГГ'
  function DateToStrE(PDate: Date): String;
  begin
   if PDate > Date(0, 0, 0) then
     DateToStrE := DateToStr(PDate, 'DD.MM.YYYY')
   else
     DateToStrE := '';
  end;

  // Аналог DateToStrE с возможностью задания формата преобразования даты в строку
  function DateToStrEF(PDate: Date; PFormat: String): String;
  begin
   if PDate > Date(0, 0, 0) then
     DateToStrEF := DateToStr(PDate, PFormat)
   else
     DateToStrEF := '';
  end;

  // Преобразовывает строку, содержащую дату в формате по умолчанию в тип дата
  // Формат берётся из параметра конфигурационного файла Compilers.DefaultDateFormat
  // Символы '/' и '.' в строке с датой и в строке с форматом считаются равноценными
  function StringToDate(S: String): Date;
  begin
    StringToDate := StrToDate(Replace(Trim(S), '/', '.'), 
     Replace(GetStringParameter('Compilers', 'DefaultDateFormat', 0), '/', '.'));
  end;

  // Преобразовывает первый символ строки в нижний регистр
  function LoCaseFirstChar(S: String): String;
  begin
    result := LoCase(SubStr(S, 1, 1)) + SubStr(S, 2, Length(S) - 1);
  end;

  // Преобразовывает первый символ строки в верхний регистр
  function UpCaseFirstChar(S: String): String;
  begin
    result := UpCase(SubStr(S, 1, 1)) + SubStr(S, 2, Length(S) - 1);
  end;

  // Возвращает фамилию имя отчество в указанном падеже
  // cPersons - ссылка на таблицу Persons (для анализа таблицы исключений, может быть 0)
  // FIO - фамилия имя отчество в именительном падеже
  // NCase - падеж:
  //  1 Именительный
  //  2 Родительный
  //  3 Дательный
  //  4 Винительный
  //  5 Творительный
  //  6 Предложный
  function FIODecl(cPersons: tNRec; FIO: String; NCase: Word): String;
  begin
    // if IDeclLoaded and NCase >= 2 and NCase <= 6 then
    if NCase >= 2 and NCase <= 6 then
      result := Trim(IDecl.FIODeclension(cPersons, FIO, NCase))
    else
      result := FIO;
  end;

  // Возвращает фамилию с инициалами в указанном падеже
  // FIOType - тип:
  //  1 Фамилия с инициалами, инициалы справа
  //  2 Фамилия с инициалами, инициалы слева
  function ShortFIODecl(cPersons: tNRec; FIO: String; NCase: Word; FIOType: Byte = 1): String;
  begin
    result := ShortFIO(FIODecl(cPersons, FIO, NCase), FIOType);
  end;

  // Возвращает должность указанного работника на указанну дату в указанном падеже
  // Реализована поддержка только следующих падежей:
  //  1 Именительный
  //  2 Родительный
  //  3 Дательный
  function GetPersPost(cPersons: tNRec; NCase: Word; OnDate: Date): String;
  var
    cAppoint: tNRec; // ссылка на текущее назначение
  begin
    result := '';
    cAppoint := VAppFuncs.GetAppNrec_OnDate(cPersons, OnDate);
    if getFirst Appointments where ((cAppoint == Appointments.NRec)) = tsOK then
    begin
      result := ICatFunc.GetCatalogsName(Appointments.Post);
      if NCase >= 2 and NCase <= 3 then
        result := IPostInP.PostInP(result, NCase);
    end;
  end;

  // Преобразовывает кол-во часов из числа с плавающей точкой в строку в формате "HH:MM"
  function TimeDToH(D: Double): String;
  var
    H: Word; 
    M: Byte; 
  begin
    H := Word(Trunc(D));
    M := Byte((D - H) * 60);
    result := if(H > 9, '', '0') + To_Char(H) + ':' + if(M > 9, '', '0') + To_Char(M);
  end;

  // Возвращает наименование отчетного периода
  public function PeriodName(_DBeg: Date; _DEnd: Date): String;
  var
    NonStdPeriod: Boolean;
  begin
    NonStdPeriod := false;
    if Year(_DBeg) = Year(_DEnd) then
    begin
      if Month(_DBeg) = Month(_DEnd) then
      begin
        if Day(_DBeg) = 1 and Day(_DEnd) = Last_Day(_DEnd) then
          result := ST_FOR + ' ' + DateToStr(_DBeg, 'month YYYY') + ' ' + ST_YEARS
        else
          NonStdPeriod := true;
      end else
      begin
        var _MBeg: Byte = Month(_DBeg);
        var _MEnd: Byte = Month(_DEnd);
        if Day(_DBeg) = 1 and Day(_DEnd) = Last_Day(_DEnd) then
        begin
          if _MBeg = 1 and _MEnd = 3 then
            result := ST_FOR + ' I ' + ST_QUARTER + ' ' + To_Char(Year(_DBeg)) + ' ' + ST_YEARS
          else
            if _MBeg = 4 and _MEnd = 6 then
              result := ST_FOR + ' II ' + ST_QUARTER + ' ' + To_Char(Year(_DBeg)) + ' ' + ST_YEARS
            else
              if _MBeg = 7 and _MEnd = 9 then
                result := ST_FOR + ' III ' + ST_QUARTER + ' ' + To_Char(Year(_DBeg)) + ' ' + ST_YEARS
              else
                if _MBeg = 10 and _MEnd = 12 then
                  result := ST_FOR + ' IV ' + ST_QUARTER + ' ' + To_Char(Year(_DBeg)) + ' ' + ST_YEARS
                else
                  if _MBeg = 1 and _MEnd = 6 then
                    result := ST_FOR + ' I ' + ST_HALF_OF_YEAR + ' ' + To_Char(Year(_DBeg)) + ' ' + ST_YEARS
                  else
                    if _MBeg = 7 and _MEnd = 12 then
                      result := ST_FOR + ' II ' + ST_HALF_OF_YEAR + ' ' + To_Char(Year(_DBeg)) + ' ' + ST_YEARS
                    else
                      if _MBeg = 1 and _MEnd = 9 then
                        result := ST_FOR + ' ' + ST_FIRST + ' 9 ' + ST_MONTHS + ' ' + To_Char(Year(_DBeg)) + ' ' + ST_YEARS
                      else
                        if _MBeg = 1 and _MEnd = 12 then
                          result := ST_FOR + ' ' + To_Char(Year(_DBeg)) + ' ' + ST_YEAR
                        else
                          NonStdPeriod := true;
        end else
          NonStdPeriod := true;
      end;
    end else
      NonStdPeriod := true;
    if NonStdPeriod then
      result := ST_FOR + ' ' + ST_PERIOD + ' ' + ST_FROM + ' ' + DateToStr(_DBeg, 'DD.MM.YYYY') + ' ' + 
       ST_TO + ' ' + DateToStr(_DEnd, 'DD.MM.YYYY');
  end;

end.