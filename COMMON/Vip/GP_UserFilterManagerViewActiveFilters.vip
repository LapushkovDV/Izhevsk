#include GP_UserFilterManager.vih
#include GP_UserFilterManagerViewBrowse.vih

#component "GP_Common"

#include GP_UserFilterManagerViewActiveFilters.vih
interface GP_UserFilterManagerViewActiveFilters

var
  _activeFiltersMarker: TPtr; //Маркер для хранения индексов активных фильтров
  _filterManagerViewBrowse: GP_UserFilterManagerViewBrowse noauto;
  _filterManager: GP_IUserFilterManager;

create view;

Window wExtraFilters 'Дополнительные фильтры' escClose doAccept;
show(,,60, 13);
embedded embExtraFilters interface;
show(,,,10);
end;
screen scExtraFiltersButtons;
show(,11,,) fixed_y;
buttons
  cmDoOk, default;
<<
                                           <. Продолжить .>
>>
end;
handleevent
  cmDoOk: PutCommand(cmDefault);
end;
end; //Window wExtraFilters

Function GetFilterFld(filterIndexInMarker: longint): string;
{
  result := '';
  var filterIndex: longint;
  if getMarker(_activeFiltersMarker, filterIndexInMarker, filterIndex)
    result := _filterManager.GetFilterCaption(filterIndex) + ' ' + _filterManager.GetFilterStr(filterIndex);
}

#declare FilterField(Ind)
  [FilterFld#Ind] GetFilterFld(#Ind): protect,
    {button={command=cmPick;picture='GP_Common::GP_UserFilterEditBmp';hint='Изменить фильтр (F3)';hotkey=kbF3}},
    {button={command=cmValue2;picture='GP_Common::GP_UserFilterDeleteBmp';hint='Отменить фильтр (Ctrl+Del)';hotkey=kbCtrlDel}};
#end
screen scActiveFilters (,,sci13Esc);
fields
  #FilterField(0)  #FilterField(1)  #FilterField(2)  #FilterField(3)  #FilterField(4)
  #FilterField(5)  #FilterField(6)  #FilterField(7)  #FilterField(8)  #FilterField(9)
  #FilterField(10) #FilterField(11) #FilterField(12) #FilterField(13) #FilterField(14)
buttons
  cmShowExtraFilters, [singleLine];
<<
<.Доп.фильтры.> .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@
                .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@
                .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@
>>
end;

//*****************************************************************************
//#region Вспомогательные функции

Function GetFilterIndexInMarkerByField(NoFld: longint): longint;
{
  result := case(NoFld;
                 #FilterFld0:  0,  #FilterFld1:  1,  #FilterFld2:  2,  #FilterFld3:  3,  #FilterFld4:  4,
                 #FilterFld5:  5,  #FilterFld6:  6,  #FilterFld7:  7,  #FilterFld8:  8,  #FilterFld9:  9,
                 #FilterFld10: 10, #FilterFld11: 11, #FilterFld12: 12, #FilterFld13: 13, #FilterFld14: 14;
                 -1);
}

Function IsFilterFldVisible(NoFld: longint): boolean;
{
  result := GetFilterIndexInMarkerByField(NoFld) < GetMarkerCount(_activeFiltersMarker);
}

procedure SetFilterFieldVisiblity(noFld: longint);
{
  if IsFilterFldVisible(noFld)
    SetFieldState(noFld, sfVisible)
  else
    ClearFieldState(noFld, sfVisible);
}

procedure SetFilterFieldsVisiblity;
{
  SetFilterFieldVisiblity(#FilterFld0);
  SetFilterFieldVisiblity(#FilterFld1);
  SetFilterFieldVisiblity(#FilterFld2);
  SetFilterFieldVisiblity(#FilterFld3);
  SetFilterFieldVisiblity(#FilterFld4);
  SetFilterFieldVisiblity(#FilterFld5);
  SetFilterFieldVisiblity(#FilterFld6);
  SetFilterFieldVisiblity(#FilterFld7);
  SetFilterFieldVisiblity(#FilterFld8);
  SetFilterFieldVisiblity(#FilterFld9);
  SetFilterFieldVisiblity(#FilterFld10);
  SetFilterFieldVisiblity(#FilterFld11);
  SetFilterFieldVisiblity(#FilterFld12);
  SetFilterFieldVisiblity(#FilterFld13);
  SetFilterFieldVisiblity(#FilterFld14);
}

procedure OnAfterFilterChanged(filterIndex: longint);
{
  filterIndex := filterIndex;
  rereadrecord;
}

procedure OnAfterDeactivateFilter(filterIndex: longint);
{
  if FoundMarker(_activeFiltersMarker, filterIndex)
  {
    DeleteMarker(_activeFiltersMarker, filterIndex);
    SetFilterFieldsVisiblity;
    OnAfterFilterChanged(filterIndex);
  }
}

procedure OnAfterActivateFilter(filterIndex: longint);
{
  if not FoundMarker(_activeFiltersMarker, filterIndex)
  {
    InsertMarker(_activeFiltersMarker, filterIndex);
    SetFilterFieldsVisiblity;
    OnAfterFilterChanged(filterIndex);
  }
}

procedure OnFilterManagerViewBrowseCmDefault;
{
  CloseWindowEx(wExtraFilters, cmDefault);
}
//#endregion Вспомогательные функции
//*****************************************************************************

handleevent
  cmPick:
  {
    var filterIndex: longint;
    if GetMarker(_activeFiltersMarker, GetFilterIndexInMarkerByField(curfield), filterIndex)
      _filterManager.PickFilter(filterIndex);
    rereadrecord;
    OnCmDefault;
  }
  cmValue2:
  {
    var filterIndex: longint;
    if GetMarker(_activeFiltersMarker, GetFilterIndexInMarkerByField(curfield), filterIndex)
      _filterManager.DeactivateFilter(filterIndex);
    OnCmDefault;
  }
  cmDelOnProtect:
  {
    var filterIndex: longint;
    if GetMarker(_activeFiltersMarker, GetFilterIndexInMarkerByField(curfield), filterIndex)
      _filterManager.DelFilter(filterIndex);
    OnCmDefault;
  }
  cmShowExtraFilters:
  {
    RunWindowModal(wExtraFilters);
    OnCmDefault;
  }
end;

//*****************************************************************************
//#region GP_UserFilterManagerViewActiveFilters

Constructor Init;
{
  result := false;
}

Constructor UserFilterManagerViewActiveFilters(objUserFilterManager: GP_IUserFilterManager);
{
  _activeFiltersMarker := InitMarker('', SizeOf(Longint), 10, 10, false);
  _filterManager := objUserFilterManager;
  result := _filterManager != NullRef;
  if result
  {
    BindEvent(OnAfterActivateFilter, _filterManager.OnAfterActivateFilter);
    BindEvent(OnAfterDeactivateFilter, _filterManager.OnAfterDeactivateFilter);
    BindEvent(OnAfterFilterChanged, _filterManager.OnAfterEditFilter);
    BindEvent(OnAfterFilterChanged, _filterManager.OnAfterPickFilter);
    BindEvent(OnAfterFilterChanged, _filterManager.OnAfterDelFilter);
    SetFilterFieldsVisiblity;
    _filterManagerViewBrowse := new(GP_UserFilterManagerViewBrowse,
                                    UserFilterManagerViewBrowse(_filterManager));
    BindEvent(OnFilterManagerViewBrowseCmDefault, _filterManagerViewBrowse.OnCmDefault);
    BindEmbeddedInterface(embExtraFilters, _filterManagerViewBrowse);
  }
}

Destructor Done;
{
  DoneMarker(_activeFiltersMarker, '');
}

//#endregion GP_UserFilterManagerViewActiveFilters
//*****************************************************************************

end.
