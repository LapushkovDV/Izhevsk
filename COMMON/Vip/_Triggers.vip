* Разработка  |              |        |                         |                                 *
\*************************************************************************************************/
#declare trAfterInsertDateCreation(Table)
handler with replace tAfterInsert#Table on trigger #Table after insert [99] action {
Var Buff_#Table : record as table #Table;
  GetTableBuffer(Buff_#Table);
  _try
   {
     //установка даты и времени создания документа
    dSetAttr(co#Table, Buff_#Table.nrec, VA_DOC_CreateDate, cur_date);
    tSetattr(co#Table, Buff_#Table.nrec, VA_DOC_CreateTime, cur_time);
   }
  _except
   else {}
  _finally{}

  result := true;
}
#end

#trAfterInsertDateCreation(KATSOPR)
#trAfterInsertDateCreation(BASEDOC)
#trAfterInsertDateCreation(MNPLAN)
#trAfterInsertDateCreation(AKTOFP)
