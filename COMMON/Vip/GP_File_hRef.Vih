#ifndef __GP_File_hRef_Vih__
#define __GP_File_hRef_Vih__

//------------------------------------------------------------------------------

#component "GP_Common"

//------------------------------------------------------------------------------
#doc
#end
VipInterface GP_File_hRef
#Licensed_Free
Parameters (
  wIntMode  : word;   // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  wTableMain: word;   // таблица
  cRecDoc   : comp;    // выбранная запись
  wOption   : word ;    //1 - запустить окно
  sWinTitle : string='';
  wTipDoc   : word=0 // Тип документа
);
Public:
  Constructor Init;
  Destructor  Done;
  Function  GetIName        : string;
  Function  GetIHead        : string;
  Function GetCurRec : comp;
//---------------------------------------
#doc
  Добавить файл
#end
Function Add_File(  _wTable    : word;  // ссылка на "Ведомость"
            _cRec      : comp  ;   // выбранная запись
            _sfile :string
      ) :boolean;

//------------------------------------------------------------------------------
#doc
   Инициализация параметров интерфейса
#end
Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _wTable    : word;  // код таблицы
  _cRec      : comp=0;   // выбранная запись
  _Option    : longint=0; // опции: биты 1 запустить окно,2 - проверить наличие вложений, 3 - очистка кэша
  _NoVisual  : boolean=false; //не перерисовывать экраны
  _sWinTitle : String = ''; // Название окна
  _wTipDoc   : word = 0 //  Тип документа
) : boolean;


end;

//------------------------------------------------
