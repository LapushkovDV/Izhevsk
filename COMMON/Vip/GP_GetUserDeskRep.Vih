#ifndef _GP_GetUserDeskRep_INCLUDED_
#define _GP_GetUserDeskRep_INCLUDED_

#ifdef ComponentVersion
  #component "GP_Common"
#end

ObjInterface objGP_GetUserDeskRep;
//=======================================
//Проверка на изменение чужой настройки
//=======================================
Function CheckUserDeskRep(boCheck:Boolean;boMsg:Boolean):Boolean;
//=======================================
//Перегон из Marker в PickRep
//=======================================
Procedure MarkerToPickRep(Marker:Longint;wList:Word;sUserName:String);
//=======================================
//Перегон из PickRep в Marker
//=======================================
Procedure PickRepToMarker(Marker:Longint;wList:Word;sUserName:String);
//=======================================
//Вставка новой настройки UserDeskRep
//=======================================
Function InsUserDeskRep:Comp;
//=======================================
//Запись тенущей настройки UserDeskRep в DSK
//=======================================
Procedure SaveUserDeskRep;
//=======================================
//Чтение настройки UserDeskRep из DSK
//=======================================
Function ReadUserDeskRep(_pUserDeskRep:Comp;_sRepName:String):Comp;
end;

VipInterface GP_GetUserDeskRep Implements objGP_GetUserDeskRep licensed (FREE) Parameters (pUserDeskRep:comp; sRepName:String; wNREP:Word; sUserName:String);

#end
