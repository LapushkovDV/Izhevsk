#include GP_UDR_RKStat.vih

interface GP_UDR_RKStat; 

var 
  __sOwnName : string[60] = 'RKStat';
  __wNRep    : word   = cgGP_Report_20002;
  __sName    : string[80];

create view
from
  UserDeskRep
, PickRep
where
((
    __sOwnName == UserDeskRep.OwnName
and __wNRep    == UserDeskRep.NRep
and ( UserDeskRep.RepName = __sName )
//-------------------------------------
and __sOwnName       == PickRep.OwnName
and UserDeskRep.nRec == PickRep.cUserDeskRep
))
;

procedure SaveWord(_sName: string; _wVal: word);
{
  set __sName := _sName;
  if not isvalid(#UserDeskRep)
  {
    clearbuffer(#UserDeskRep);
    UserDeskRep.OwnName := __sOwnName;
    UserDeskRep.NRep    := __wNRep   ;
    UserDeskRep.RepName := __sName   ;
    insert current UserDeskRep;
  }
  UserDeskRep.ResWord[1] := _wVal;
  update current UserDeskRep;
}
function  ReadWord(_sName: string): word;
{
  set __sName := _sName;
  result := 0;
  if isvalid(#UserDeskRep)
    result := UserDeskRep.ResWord[1];
}

procedure SaveDate(_sName: string; _dVal: Date);
{
  set __sName := _sName;
  if not isvalid(#UserDeskRep)
  {
    clearbuffer(#UserDeskRep);
    UserDeskRep.OwnName := __sOwnName;
    UserDeskRep.NRep    := __wNRep   ;
    UserDeskRep.RepName := __sName   ;
    insert current UserDeskRep;
  }
  UserDeskRep.ResDate[1] := _dVal;
  update current UserDeskRep;
}
function  ReadDate(_sName: string): Date;
{
  set __sName := _sName;
  result := 0;
  if isvalid(#UserDeskRep)
    result := UserDeskRep.ResDate[1];
}

file FMemo;

procedure SaveString(_sName: string; _sVal: String);
{
  set __sName := _sName;
  if not isvalid(#UserDeskRep)
  {
    clearbuffer(#UserDeskRep);
    UserDeskRep.OwnName := __sOwnName;
    UserDeskRep.NRep    := __wNRep   ;
    UserDeskRep.RepName := __sName   ;
    insert current UserDeskRep;
  }
  _try
  {
    ClearMemoField(UserDeskRep.TEXTDATA);
    FMemo.OpenMemo(UserDeskRep.TEXTDATA);
    FMemo.WriteLine(_sVal);
  }
  _except
    on ExFile         :{}
    on ExFileNotFound :{}
  _finally
    FMemo.Close;
  update current UserDeskRep;
}
function  ReadString(_sName: string): String;
{
  set __sName := _sName;
  result := '';
  if isvalid(#UserDeskRep)
  {
    _try
    {
      FMemo.OpenMemo(UserDeskRep.TEXTDATA);
      FMemo.ReadLn(result);
    }
    _except
      on ExFile         :{}
      on ExFileNotFound :{}
    _finally
      FMemo.Close;
  }
}

function  ReadMarker(_sName: string): TPtr;
{
  set __sName := _sName;
  var mValSet: TPtr = InitMarker('',8,100,10,false);
  if isvalid(#UserDeskRep)
    if isvalid(#PickRep)
      _loop PickRep
        InsertMarker(mValSet, PickRep.cRec);
  result := mValSet;
}
procedure SaveMarker(_sName: string; _mVal: TPtr);
{
  var mValCheckChange: TPtr = ReadMarker(_sName);
  var isDiff: boolean = false;
  var ii: longint;
  var ih: longint = GetMarkerCount(mValCheckChange);
  var ie: longint = GetMarkerCount(_mVal);
  var cCheck: comp;
/*
  message('mValCheckChange='+GetMarkerCount(mValCheckChange));
  message('_mVal='+GetMarkerCount(_mVal));
*/
  if ( ih = 0 )
    isDiff := true;
  if ( ih <> ie )
    isDiff := true;
  if not isDiff
    for(ii := 0; ii < ih; ii++)
    {
      GetMarker(mValCheckChange, ii, cCheck);
      if not FoundMarker(_mVal, cCheck)
        isDiff := true;
      if isDiff
        break;
    }

  if not isDiff
    exit;

  set __sName := _sName;
  if not isvalid(#UserDeskRep)
  {
    clearbuffer(#UserDeskRep);
    UserDeskRep.OwnName := __sOwnName;
    UserDeskRep.NRep    := __wNRep   ;
    UserDeskRep.RepName := __sName   ;
    insert current UserDeskRep;
  }
  else
    if isvalid(#PickRep)
      delete all from PickRep where((__sOwnName == PickRep.OwnName and UserDeskRep.nRec == PickRep.cUserDeskRep));
      // это избыточно, достаточно подцепки, но на всякий случай что бы что то чужое не грохнуть, ибо Галактика...
  
  var cRecM: comp;
  if ( ie <> 0 )
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Сохраняю настройки.', 0);
    for( ii := 0;  ii < ie; ii++)
      if GetMarker(_mVal, ii, cRecM)
      {
        if (not NextVisual) break;
        clearbuffer(#PickRep);
        PickRep.OwnName      := __sOwnName;
        PickRep.cUserDeskRep := UserDeskRep.nRec;
        PickRep.cRec         := cRecM;
        insert current PickRep;
      }
    StopVisual;
  }
}

procedure SaveDouble(_sName: string; _dbVal: Double);
{
  set __sName := _sName;
  if not isvalid(#UserDeskRep)
  {
    clearbuffer(#UserDeskRep);
    UserDeskRep.OwnName := __sOwnName;
    UserDeskRep.NRep    := __wNRep   ;
    UserDeskRep.RepName := __sName   ;
    insert current UserDeskRep;
  }
  UserDeskRep.ResDouble[1] := _dbVal;
  update current UserDeskRep;
}
function  ReadDouble(_sName: string): Double;
{
  set __sName := _sName;
  result := 0;
  if isvalid(#UserDeskRep)
    result := UserDeskRep.ResDouble[1];
}

end.