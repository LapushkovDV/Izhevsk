#include GP_IUserFilter.obj
#include GP_UserFilterStringEditView.vih
#include GP_UserFilterPeriodEditView.vih
#include GP_UserFilterDoubleEditView.vih
#include GP_UserFilterDefaultEditView.vih

#component "GP_Common"

#include  GP_UserFilterEditViewFactory.vih
interface GP_UserFilterEditViewFactory;

function GetEditViewForFilter(objUserFilter: ObjRef; sCaption: string): GP_IOnCmDefault;
{
  case UpCase(VipFullName(objUserFilter)) of
    'GP_COMMON::GP_USERFILTERSTRING':
      result := GP_IOnCmDefault(new(GP_UserFilterStringEditView,
                                    UserFilterStringEditView(GP_UserFilterString(objUserFilter), sCaption)));
    'GP_COMMON::GP_USERFILTERPERIOD':
      result := GP_IOnCmDefault(new(GP_UserFilterPeriodEditView,
                                    UserFilterPeriodEditView(GP_UserFilterPeriod(objUserFilter), sCaption)));
    'GP_COMMON::GP_USERFILTERDOUBLE':
      result := GP_IOnCmDefault(new(GP_UserFilterDoubleEditView,
                                    UserFilterDoubleEditView(GP_UserFilterDouble(objUserFilter), sCaption)));
    else
      result := GP_IOnCmDefault(new(GP_UserFilterDefaultEditView,
                                    UserFilterDefaultEditView(GP_IUserFilter(objUserFilter), sCaption)));
  end;
}

end.
