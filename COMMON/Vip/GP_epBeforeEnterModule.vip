#include epSystem.vih
#include ExtAttr.Vih
#include GP_Static_Function.Vih
#Include GP_InitApp_KatParty.Vih

#component "GP_Common"
handler with replace GP_COMON_BeforeEnterModule on ExtensionPoint epBeforeEnterModule
                     (aContour: String; aModule: String)
Action
{ Result:=True;
  //message('aContour='+aContour+',aModule='+aModule);
}

//-------------------------------------
// перед входом в Галактику
handler with replace GP_COMON__InitApp on ExtensionPoint epAppInit
Action
{ Result:=True;
  RegisterGlobalIfc('C_ExtClass::iExtAttrClassInfo');
  if not RegisterGlobalIfc('GP_Common::GP_Static_Function')
  { message('Ошибка регистрации GP_Common::GP_Static_Function');
  }
  var boStatic_success:boolean=false;
  _Try
  { boStatic_success:=IsBitCtW(1,1);
    //для проверки _Raise ExInternalError;
    timelog_Init;
  }
  _except
  else
  { if Message('Ошибка загрузки объекта GP_Common::GP_Static_Function'
     +chr(13)+'Обратитесь к администратору БД'
     +chr(13)+'Требуется пересборка ресурсов GP*'
     +chr(13)+'Работа части функционала будет невозможна!'
     +chr(13)+'Продолжить работу?',YesNo)<>cmYes
    { Result:=False;
    }

  }
  //--------------------------------------------

}
