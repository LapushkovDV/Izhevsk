#ifndef __GP_UserFilterPersons_VIH__
#define __GP_UserFilterPersons_VIH__

#component "GP_Common"

#include GP_UserFilter.vih

vipinterface GP_UserFilterPersons(GP_UserFilter);
public:
  constructor GP_UserFilterPersons(NoField:longint; SaveName:string; wFlags: word = vfMultipleSelection;
                                   wEmployee: word = 1; lDeptMarker: TPtr = 0);
  procedure GP_IUserFilter.Pick;
  property Flags: word;       //флаг пометки (vfCanSelect - одиночная пометка, vfMultipleSelection - множественная пометка , vfSilentlySelectAll - пометка всех записей)
  property Employee: word;    //база для выбора: 0 - все ФЛ, 1 - текущие, 2 - архивные, 3 - работающие, 4 - уволенные, 5 - студенческие карточки, 6 - текущие и архивные
  property DeptMarker: TPtr;  //маркер доступных подразделений
  property Marker: TPtr read; //маркер сотрудников
  protected function GP_IUserFilter.GetFilterStr: string;
end;

#endif
