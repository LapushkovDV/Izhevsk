#component "L_MCU"
#include ObjMC.vih
  var fObjMC : oObjMC;

#include AutoBarKod.vih
  var BarKod : iAutoBarKod;

#include TSoprHoz.vih
#include TxoBind.vih
  var iTxoBind : TxoBinder;

#include SHManager.vih
  var iSHoz    : ObjSHmanager; // интерфейс для работы с SoprHoz

#define OBJINT_ACCOUNT
#include objintpl.vin

#component "EM"
#include EM_ForESB.vih



Interface EM_ForESB 'Функции для вызова из ESB ' EscClose, Cyan;

create view as
select  *
from
  KatMC
, SoprHoz
, SpMnPlan
;
 #doc
    оригинал находится в /L/L_MCU/vip/KATMC/KatMC_f.vpp
    Для генерации баркода нужно вызвать GetCopyKatMCName(KatMC.BarKod , 'McUsl.UniqMcBarCode' , 'к'    );
#end

Function GetBarKodByMCNrec(_nrec : comp): string;
{
  Result := '';
  if ( GetFirst KatMC where (( comp(_nrec) == nrec )) = tsOK )
  {
   Result := BarKod.GetMCKod(KatMC.buffer);
  }
}

Function BindTXO(cSoprHoz, cHozOper, cPlansSch : comp) : boolean;
{
  Result := false;
  if(GetFirst SoprHoz where ((cSoprHoz == SoprHoz.nrec)) = tsOk)
  {
    SoprHoz.cHozoper:=cHozOper ;
    Update current soprHoz;

    TXoMakeSpecial(SoprHoz.Nrec,cHozOper,0);
    Result := true;
  }
}

function RunAlgorithmByTune(typeCp: word; docNRec, docSpNRec: comp; tuneName: string): boolean;
var aAccount : Account_PL;
    aGlobData: GlobData;
    aoMainVid: oMainVid;
    cAlg     : comp;
    pt       : TRecAcc;
{
  Result := true;
  cAlg := coGetTune(tuneName);
  if cAlg = 0
    exit;
  clearAdvRecord(pt);
  if docSpNRec <> 0
    if getfirst fastfirstrow SpMnPlan where ((docSpNRec == SpMnPlan.NRec)) = tsOk
      pt.stSpMnPlan := SpMnPlan.Buffer;
  pt.cMnPlan         := docNRec;
  pt.cpNrec          := docNRec;
  pt.TypeCpNrec      := typeCp;
  pt.FlagRun         := 1;
  aAccount.InitInter(aGlobData, aoMainVid);
  aAccount.RunInter(cAlg, word(0), pt);
  Result := pt.Binding = 0 and pt.Error = 0;
}

End.
