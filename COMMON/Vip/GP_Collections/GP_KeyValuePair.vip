#include GP_Collections.vih

#component "GP_Common"

interface GP_KeyValuePair;

var
  _key: variant;
  _value: ObjRef;

constructor KeyValuePair(aKey: variant; aValue: ObjRef);
{
  _key := aKey;
  _value := aValue;
  result := true;
}

property Key: variant absolute _key;
property Value: ObjRef absolute _value;

end.
