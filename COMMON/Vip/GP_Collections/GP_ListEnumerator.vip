#include GP_Collections.vih

#component "GP_Common"

interface GP_ListEnumerator;
var
  _list: GP_IList;
  _position: longint;

constructor ListEnumerator(list: GP_IList);
{
  _list := list;
  _position := -1;
  result := true;
}

function MoveNext: boolean;
{
  _position++;
  result := _position < _list.lCount;
}

procedure Reset;
{
  _position := -1;
}

function Current: ObjRef;
{
  if (_position >= 0 and _position < _list.lCount)
    result  := _list.ItemGet(_position)
  else
    result :=  nullref;
}
end.
