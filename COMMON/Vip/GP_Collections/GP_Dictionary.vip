#include GP_Collections.vih

#component "GP_Common"

interface GP_Dictionary;

var
  _items : GP_IList;
  _values: GP_IList;
  _keys  : GP_IVariantList;

constructor Init;
{
  result := false;
  if not loadvipref(_items, 'GP_Common::GP_List') exit;
  if not loadvipref(_values, 'GP_Common::GP_List') exit;
  if not loadvipref(_keys, 'GP_Common::GP_VariantList') exit;
  result := true;
}

function AddKeyValue(key: variant; value: ObjRef): GP_IDictionary;
{
  if not ContainsKey(key)
  {
    var pair: GP_Common::GP_KeyValuePair noauto;
    pair := new(GP_Common::GP_KeyValuePair, KeyValuePair(key, value)) ;
    Add(GP_IKeyValuePair(pair));
  }
  result := GP_IDictionary(Self);
}

function ContainsValue(value: ObjRef): boolean;
{
  result := _values.Contains(value);
}

function ContainsKey(key: variant): boolean;
{
  result := _keys.Contains(key);
}

function RemoveItemWithKey(key: variant): boolean;
{
  var i: longint;
  i := _keys.IndexOf(key);
  if i <> -1
  {
    _items.RemoveAt(i);
    _keys.RemoveAt(i);
    _values.RemoveAt(i);
    result := true;
  }
  else
    result := false;
}

function ValueGet(key: variant): ObjRef;
{
  var i: longint;
  i := _keys.IndexOf(key);
  if i != -1
    result := _values.ItemGet(i);
}

function ValueSet(key: variant; value: ObjRef): boolean;
{
  var i: longint;
  i := _keys.IndexOf(key);
  if i != -1
  {
    _values.ItemSet(i, value);
    result := true;
  }
  else
    result := false;
}

property Keys: GP_IVariantCollection read _keys;
property Values: GP_ICollection read _values;

function Add(value: ObjRef): longint;
{
  result := -1;
  var pair: GP_IKeyValuePair;
  pair := GP_IKeyValuePair(value);
  if not ContainsKey(pair.key)
  {
    _values.Add(pair.Value);
    _keys.Add(pair.Key);
    _items.Add(pair);
  }
}

procedure Remove(value: ObjRef);
{
  var i: longint;
  i := _values.IndexOf(value);
  if i != -1
  {
    _values.RemoveAt(i);
    _keys.RemoveAt(i);
    _items.RemoveAt(i);
  }
}

procedure Clear;
{
  _values.Clear;
  _keys.Clear;
  _items.Clear;
}

function Contains(value: ObjRef): boolean;
{
  result := _items.Contains(value);
}

property lCount: longint read _items.lCount;

function GetEnumerator: GP_IEnumerator;
{
  result := _items.GetEnumerator;
}

function First: ObjRef;
{
  result := _items.First;
}

function Last: ObjRef;
{
  result := _items.Last;
}

end.
