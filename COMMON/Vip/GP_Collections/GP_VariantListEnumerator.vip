#include GP_Collections.vih

#component "GP_Common"

interface GP_VariantListEnumerator;
var
  _list: GP_IVariantList;
  _position: longint;

constructor VariantListEnumerator(list: GP_IVariantList);
{
  _list := list;
  _position := -1;
  result := true;
}

function MoveNext: boolean;
{
  _position++;
  result := _position < _list.lCount;
}

procedure Reset;
{
  _position := -1;
}

function Current: variant;
{
  if (_position >= 0 and _position < _list.lCount)
    result  := _list.ItemGet(_position)
  else
    result :=  '';
}
end.
