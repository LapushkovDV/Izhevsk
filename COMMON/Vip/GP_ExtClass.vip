#include GP_ExtClass.vih
#include ExtClass.vih

interface GP_ExtClass;

  create View
    var
      CurGroup: tNRec;
      pPickMode: Word;
      pShowTree: Boolean;
    from
      ExClassName,
      ExClassVal,
      ExClassSeg,
      synonym ExClassName ExClassNameW,
      synonym ExClassVal ExClassValW,
      synonym ExClassSeg ExClassSegW
    where ((
          ExClassName.ClassCode == ExClassSeg.ClassCode
      and CurGroup              == ExClassSeg.cGroup
      and ExClassName.ClassCode == ExClassVal.ClassCode
      and ExClassName.wTable    == ExClassVal.wTable
    ));

  var
    oExtClass: iExtClass;

  Window winExtClass (, hcGkatalM1ExtClass, scClassifier) doAccept, escClose, cyan;
    show at (,, 66, 20);

    tree treExtClass (,, sci14EnEscTree);
      table ExClassSeg;
      fields
        ExClassSeg.Name 'Значение классификатора' (, hcGkatalM1ExtClass, sci14EnEscTree): [40], protect;
        ExClassSeg.Value 'Код': [15], noAutoSize, protect;
    end;

    browse brwExtClass (,, sci14EnEsc);
      table ExClassSeg;
      fields
        ExClassSeg.Name 'Значение классификатора' (, hcGkatalM1ExtClass, sci14EnEsc): [40], protect;
        ExClassSeg.Value 'Код': [15], noAutoSize, protect;
    end;

    handleEvent
      cmOk:
        PutCommand(cmDefault);
      cmDefault:
        if not IsValid(tnExClassSeg) then
          abort;
      cmEdit:
        begin
          RunInterface('EXEXTCLASS', cgiPick, ExClassName.wTable, ExClassName.ClassCode, ExClassName.UniqFeat);
          RereadRecord;
          PushPos(#ExClassSeg);
          if GetFirst ExClassSeg != tsOK then
            if GetFirst ExClassName != tsOK then
              PutCommand(cmClose);
          PopPos(#ExClassSeg);
        end;
    end;
  end;

  // Выбор значения внешнего классификатора
  // Параметры:
  //  _PickMode  - режим выбора (пока поддерживается только cgiPick)
  //  _ClassCode - код классификатора
  //  _ClassSeg  - NRec выбранного значения внешнего классификатора (возвращаемый)
  //  _ShowTree  - Если true, классификатор выводится в древовидном виде
  function GetValue(_PickMode: Word; _ClassCode: Word; var _cClassSeg: tNRec; _ShowTree: Boolean = true): Boolean;
  begin
    result := false;
    if getFirst ExClassName where ((_ClassCode == ExClassName.ClassCode)) != tsOk then
      exit;
    SetWindowTitle(winExtClass, ExClassName.Name);
    pPickMode := _PickMode;
    pShowTree := _ShowTree;

    set CurGroup := 0;

    if _cClassSeg != 0 then
    begin
      if getFirst ExClassSeg where ((_cClassSeg == ExClassSeg.NRec)) = tsOk then
      begin
        if pShowTree then
          TreeJumpToRecord(treExtClass, _cClassSeg);
      end else
        if GetFirst ExClassSeg = tsOk then
        begin
        end;
      RescanPanel(#ExClassSeg);
    end;
    SetFormat(if(_ShowTree, treExtClass, brwExtClass));
    if RunWindowModal(winExtClass) != cmDefault then
      exit;
    _cClassSeg := ExClassSeg.NRec;
    result := true;
  end;

  // Редактирование значение указанного внешнего классификатора для указанной записи
  // Параметры:
  //  _ClassCode - код классификатора
  //  _cRec      - NRec записи таблицы, для которой нужно редактировать значение внешнего классификатора
  //  _ShowTree  - Если true, классификатор выводится в древовидном виде
  function PickValue(_ClassCode: Word; _cRec: tNRec; _ShowTree: Boolean = true): Boolean;
  var
    _cClassSeg: tNRec;
  begin
    result := false;
    // ExClassName.wTable
    if getFirst ExClassName where ((_ClassCode == ExClassName.ClassCode)) != tsOk then
      exit;
    _cClassSeg := GetSegNRec(_ClassCode, _cRec);
    // cgiMulti пока тоже выбирает одну запись, когда понадобится доработаем
    if GetValue(if(ExClassName.UniqFeat = 1, cgiPick, cgiMulti), _ClassCode, _cClassSeg, _ShowTree) then
    begin
      // Сохраним результат выбора
      // if oExtClass.AddSegClass(_ClassCode : word; _SegName: string;  _SegCode: string; _cGroup: comp) != 0 then
      // if oExtClass.LinkSegClass(ExClassName.wTable, _cRec, ExClassName.Name, _SegName: string) : boolean;
      result := SetSegNRec(_ClassCode, _cRec, _cClassSeg);
    end;
  end;

  // Возвращает NRec сегмента вн.классификатора по коду классификатора и номеру записи таблицы, к которой он привязан
  function GetSegNRec(_ClassCode: Word; _cRec: tNRec): tNRec;
  begin
    result := 0;
    if getFirst ExClassValW where ((_cRec == ExClassValW.cRec and _ClassCode == ExClassValW.ClassCode)) = tsOk then
      result := ExClassValW.cClassSeg;
  end;

  // Привязывает сегмент с указанным NRec к записи таблицы с указанным NRec
  function SetSegNRec(_ClassCode: Word; _cRec: tNRec; _cClassSeg: tNRec): Boolean;
  begin
    result := false;
    if getFirst ExClassNameW where((_ClassCode == ExClassNameW.ClassCode)) != tsOk then
      exit;
    if getFirst ExClassSegW where((_cClassSeg == ExClassSegW.NRec)) != tsOk then
      exit;
    // Если этот сегмент уже привязан
    if getFirst ExClassValW where((
          _cRec      == ExClassValW.cRec
      and _ClassCode == ExClassValW.ClassCode
      and _cClassSeg == ExClassValW.cClassSeg
    )) = tsOk then
      exit;
    // Удаляем все значения, привязанные к записи
    if not DelAllValues(_ClassCode, _cRec) then
    begin
      Message('Ошибка: не удалось удалить старое значение внешнего классификатора');
      exit;
    end;
    ClearBuffer(#ExClassValW);
    ExClassValW.wTable    := ExClassNameW.wTable;
    ExClassValW.cRec      := _cRec;
    ExClassValW.ClassCode := _ClassCode;
    ExClassValW.cClassSeg := _cClassSeg;
    if insert current ExClassValW != tsOk then
      exit;
    result := true;
  end;

  // Удаляет все значения внешнего классификатора с кодом _ClassCode, привязанные к записи с указанным NRec
  function DelAllValues(_ClassCode: Word; _cRec: tNRec): Boolean;
  begin
    if delete all from ExClassValW where ((
          _cRec      == ExClassValW.cRec
      and _ClassCode == ExClassValW.ClassCode
    )) = tsOk then
      result := true
    else
      result := false;
  end;

  handleEvent
    cmTreeTop:
      CurGroup := 0;
    cmTreeUp:
      CurGroup := ExClassSeg.cGroup;
    cmTreeDown:
      CurGroup := ExClassSeg.NRec;
    cmTreeNodeType:
      if TreeIsTerminal(treExtClass)
        TreeSetNodeType(treExtClass, ntfText);
    cmTreeNeedOwner:
      TreeJumpToRecord(treExtClass, ExClassSeg.cGroup);
  end;

end.
