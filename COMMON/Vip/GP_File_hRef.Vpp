#doc
Порядок подключения
1. Добавить в проект
 include GP_File_hRef.Vih
2. Добавить в файл докомпиляции интерфейса этот файл после Alter Interface перед HandleEvent интерфейса
 include GP_File_hRef.Vpp

3.Добавить в HandleEvent интерфейса
cmInit:
{ ...

  //-------------------------------------------
  //добавить тулбар в основное окно
  LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' , -1, -1, 0);
  //добавить тулбар в окно редактирования
  LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' , EditSopr, -1, 1);
  ReScanPanel(CurTable);
}
// если событие в стандартном интерфейсе занято, нужно переопределить тулбар
// в em_dev_kou\GP_Common\Vip\GP_File_hRef.Tb
cmValue68:
{ pGP_File_hRef.Function InitParam(
   if(not CanEditTbl,cgiNotEdit,0)   //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
                // Если документ только на чтение следует вызвать cgiNotEdit
  ,coKatSopr //_wTable    : word; указать код таблицы документа системы
  ,KatSopr.Nrec //_cRec      : comp=0;   // указать поле в таблице
  ,1 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
  ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
   );
  ReScanPanel(#KatSopr);
}
4. Возможно событие придется также встроить в окно редактирования
#end
#include GP_File_hRef.Var

//*****************************************************************************
// Загрузить ToolBar -> BaseSoprGui.vpp 
Table Struct MemToolBarsGP
(
  ID         : longint
, WinID      : longint
, ScreenID   : longint
, Owner      : word // 0 - главное окно, 1 - EditSopr
, Name       : string[50]
)
with index
(
  MemToolBarsGP01 = Owner + Name+WinID+ScreenID
);

//var Directum_IDED:string; - вставить в начало файла
//в cmInit добавить LoadInterface_Dir

//*****************************************************************************
create view vFiles
as select MemToolBarsGP.*
From MemToolBarsGP;


//*****************************************************************************
// Загрузить ToolBar -> BaseSoprGui.vpp
// 
Procedure LoadAndShowToolBar_GP(__Name: string[50]; __WinID: integer; __ScreenID: longint; __Owner: word);
{
  if (vFiles.GetFirst MemToolBarsGP where (( __Owner == MemToolBarsGP.Owner
                                  and  __Name     == MemToolBarsGP.Name
                                  and  __WinID    == MemToolBarsGP.WinID
                                  and  __ScreenId == MemToolBarsGP.ScreenId
                                     )) = tsOk)
    Exit;

  vFiles.ClearBuffer(vFiles.tnMemToolBarsGP);

  vFiles.MemToolBarsGP.ID       := Longint(LoadToolBarEx(__Name));
  vFiles.MemToolBarsGP.WinID    := __WinID;
  vFiles.MemToolBarsGP.ScreenId := __ScreenId;
  vFiles.MemToolBarsGP.Owner    := __Owner;
  vFiles.MemToolBarsGP.Name     := __Name;

  vFiles.Insert current MemToolBarsGP;

  ApplyToolBarEx(vFiles.MemToolBarsGP.ID, __WinID, __ScreenID, -1, TB_SHOW);
}

//==========================================
// Получить картинку для колонки Скан
//----------------------------------------
Function GetImageScanDoc1(_wTable:word;_cRec:comp;_wType:word=0) : string;
{ var _boExitstScan:boolean=pGP_File_hRef.InitParam(
            cgiNotEdit  //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
                       // Если документ только на чтение следует вызвать cgiNotEdit
            ,_wTable //_wTable    : word; указать код таблицы документа системы
            ,_cRec //_cRec      : comp=0;   // указать поле в таблице
            ,2 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
           ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
     );
  Result:='';
  case _wType of
  1:   Result:=if(_boExitstScan,'GP_Common::bmpFilesGreen','GP_Common::bmpFilesRed');
  2:   Result:=if(_boExitstScan,'Есть','Нет');
  else Result:=if(_boExitstScan,'GP_Logistics::bmpGP_SEMAFOR_LimeL','GP_Logistics::bmpGP_SEMAFOR_RedL');
  end;
} //Function GetImageScan : string;

#declare ScanfldScreen (wTable,wfld)
  GetImageScanDoc1(#(wTable),#(wfld),2) ('Наличие скана документа - красная кнопка - нет, зеленная - есть') : Protect,NoDel
//так не работает  ,{button={command=cmValue68;Picture=GetImageScanDoc(#(wTable),#(wfld),2);hint='Наличие скана документа'}}
    ,{button={command=cmValue68;Picture='GP_Common::bmpFilesDoc';hint='Наличие скана документа'}}
    ,{Font={BackColor=if(GetImageScanDoc1(#(wTable),#(wfld),2)='Нет',ColorNeed,0)}};
#end
#declare ScanfldScreen2but (wTable,wfld)
  GetImageScanDoc1(#(wTable),#(wfld),2) ('Наличие скана документа - красная кнопка - нет, зеленная - есть') : Protect,NoDel
    ,{button={command=cmValue68;Picture='GP_Common::bmpFilesRed';hint='Наличие скана документа'}}
    ,{button={command=cmValue68;Picture='GP_Common::bmpFilesGreen';hint='Наличие скана документа'}}
    ,{Font={BackColor=if(GetImageScanDoc1(#(wTable),#(wfld),2)='Нет',ColorNeed,0)}};
#end
#declare ScanBackColor (wTable,wfld)
    {Font={BackColor=if(GetImageScanDoc1(#(wTable),#(wfld),2)='Нет',ColorNeed,0)}}
#end

#declare ScanfldScreenButton (wTable,wfld)
  //GetImageScanDoc(#(wTable),#(wfld),2)
  // {button={command=cmValue68;Picture=GetImageScanDoc(#(wTable),#(wfld),2);hint='Наличие скана документа'}};
  {button={command=cmValue68;Picture='GP_Common::bmpFilesDoc';hint='Наличие скана документа'}};
#end
