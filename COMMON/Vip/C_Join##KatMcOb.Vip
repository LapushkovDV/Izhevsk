#component "C_Join"
alter interface KatMcOb
overload
  Procedure FinishStage (stage : word);
end;

#undef UpdateTableWithOtpEd
#Declare UpdateTableWithOtpEd(Tabl,NameField,NameFieldType,NameFieldOtpEd)
m_tTimeBeg := Cur_Time;
  if (queryManager.
        createQuery(SQLQUERY(.
          update #Tabl set
            #Tabl.#NameField = :(cMcTo),
            #Tabl.#NameFieldOtpEd = COALESCE((select KatOtpEdMap.cDst from KatOtpEdMap where KatOtpEdMap.cSrc = #Tabl.#NameFieldOtpEd), #comp(0))
          where
            #Tabl.#NameFieldType = :(toMC) and #Tabl.#NameField = :(cMcFrom)
        .)).
        execute.
        errorCode <> tsOk)
    MsgForm('#Tabl', 0, 4);
InsExecTime(cMcFrom,cMcTo,'#Tabl.#NameField', m_tTimeBeg,Cur_Time);
#End

#undef UpdateTable
#declare UpdateTable(Tabl, NameField)
m_tTimeBeg := Cur_Time;
_try
  sql update #Tabl set #Tabl.#NameField = :(cMcTo) where #Tabl.#NameField = :(cMcFrom)
_except else
  MsgForm('#Tabl', 0, 4);
InsExecTime(cMcFrom,cMcTo,'#Tabl.#NameField', m_tTimeBeg,Cur_Time);
#end
#undef UpdateTableWithType
#declare UpdateTableWithType(Tabl, NameField, NameFieldType)
m_tTimeBeg := Cur_Time;
_try
  sql update #Tabl set #Tabl.#NameField = :(cMcTo) where #Tabl.#NameFieldType = :(toMC) and #Tabl.#NameField = :(cMcFrom);
_except else
  MsgForm('#Tabl', 0, 4);
InsExecTime(cMcFrom,cMcTo,'#Tabl.#NameField', m_tTimeBeg,Cur_Time);
#end
#undef UpdateTableWithKatEd
#declare UpdateTableWithKatEd(Tabl, NameField, NameFieldEd)
m_tTimeBeg := Cur_Time;
_try
  sql update #Tabl set #Tabl.#NameField = :(cMcTo), #Tabl.#NameFieldEd = COALESCE((select KatMC.cEd from KatMC where KatMC.Nrec = :(cMcTo)), #comp(0)) where #Tabl.#NameField = :(cMcFrom);
_except else
  MsgForm('#Tabl', 0, 4);
InsExecTime(cMcFrom,cMcTo,'#Tabl.#NameField', m_tTimeBeg,Cur_Time);
#end
#undef UpdateTableWithTypeKatEd
#declare UpdateTableWithTypeKatEd(Tabl, NameField, NameFieldType, NameFieldEd)
m_tTimeBeg := Cur_Time;
_try
  sql update #Tabl set #Tabl.#NameField = :(cMcTo), #Tabl.#NameFieldEd = COALESCE((select KatMC.cEd from KatMC where KatMC.Nrec = :(cMcTo)), #comp(0)) where #Tabl.#NameFieldType = :(toMC) and #Tabl.#NameField = :(cMcFrom);
_except else
  MsgForm('#Tabl', 0, 4);
InsExecTime(cMcFrom,cMcTo,'#Tabl.#NameField', m_tTimeBeg,Cur_Time);
#end

