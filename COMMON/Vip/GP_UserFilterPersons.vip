#include ChoiseYourPersons.vih
#include PsnFuncs.vih

#component "GP_Common"

#include GP_UserFilterPersons.vih
interface GP_UserFilterPersons;

var
  _choiceYourPersons: ChoiseYourPersons;
  _personsFunctions : PersonsFunctions;
  _flags            : word = vfMultipleSelection;
  _employee         : word = 1;
  _deptMarker       : TPtr = 0;

function GetFilterStr: string;
{
  var markerCount: longint;
  markerCount := GetMarkerCount(Marker);

  case MarkerCount of
    0: result := 'Не установлен'
    1:
    {
      result := '';
      var c: comp = 0;
      if GetMarker(Marker, 0, c)
        result := _personsFunctions.GetFIO(c);
    }
    else result := 'Множественный выбор (' + string(MarkerCount) + ')';
  end;
}

constructor GP_UserFilterPersons(NoField:tptr; SaveName:string; wFlags: word = vfMultipleSelection;
                                 wEmployee: word = 1; lDeptMarker: TPtr = 0);
{
  _flags           := wFlags;
  _employee        := wEmployee;
  _deptMarker      := lDeptMarker;

  result := inherited::UserFilter(NoField, SaveName);
}

procedure Pick;
{
  var c: comp = 0;
  var l: TPtr;
  //l := initmarker('', 8, 10, 100, true);
  if _choiceYourPersons.Choice(_deptMarker, _employee, _flags, 0, c, 0)
  {
    if ((_flags = vfMultipleSelection)) or ((_flags = vfSilentlySelectAll))
    {
      _choiceYourPersons.GetPsnMarkerByKindChoice(0, Marker);
    }
    else if (_flags = vfCanSelect)
    {
      clearmarker(Marker);
      insertmarker(Marker, c);
    }
  }

  private::FilterStr := GetFilterStr;
}

property Flags     : word absolute _flags;
property Employee  : word absolute _employee;
property DeptMarker: TPtr absolute _deptMarker;

function GetMarkerProperty: TPtr;
{
  if mFilter = 0 mFilter := InitMarker('', sizeOf(comp), 10, 100, true);
  result := mFilter;
}

property Marker: TPtr read GetMarkerProperty;

end.
