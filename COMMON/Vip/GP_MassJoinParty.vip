#include AtlProtocol.vih

interface GP_MassJoinParty 'Обработка партий'
show (,,65,11);

table struct tFileRows (oidAmm: string, cParty: comp, wMain: word) (i1 = wMain + oidAmm);
table struct tReplaceParty (cPartyFrom: comp, cPartyTo: comp) (i1 = cPartyFrom);
table struct tQueries (name: string, sQuery: string, cnt: longint);
table struct tMCToRecalc (cMC: comp, barkod: string);
table struct tMoveAttr (cPartyFrom: comp, cPartyTo: comp) (i1 = cPartyFrom);
table struct tPartyGrpChanges (NRec: comp, Kod: string, Name: string, KodGroup: string, cAttr: comp, doAttr: double, cSoprMnf: comp, cSoprIn: comp, wChangeGroup: word, wChangeAttr: word) (i1 = NRec);

var iAtlProtocol: AtlProtocol;

create view
var sXls, sXls2: string;
    wActions: word;
as select * from
  AttrNam
, AttrVal, AttrVal AttrVal2
, GroupParty
, KatParty
, tFileRows, tFileRows tFileRows2
, tMCToRecalc
, tMoveAttr
, tPartyGrpChanges
, tQueries
, tReplaceParty;

screen sc1;
notablenavigation;
fields
  sXls: noprotect, pickbutton;
  wActions: noprotect, noframe;
  sXls2: noprotect, pickbutton;
buttons
  cmRunJoin;
  cmCancel;
<<

 `Файл выгрузки` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   Запускаемые действия
  [.] Заменить ссылки на партию`
  [.] Заменить пустые атрибуты основной партии`
  [.] Удалить дублирующие партии`
  [.] Удалить партии группы "Плановый ЗНП"`
  [.] Актуализация группы партий`
  [.] Возврат партий на Ком и Гоз` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. Запустить .>                                  <.  Отмена  .>
>>
end;

function LoadExcelFile: boolean;
var i, r1, r2, c1, c2, rFirst, rLast: longInt;
    oidAmm, sNrec: string;
    wMain: word;
    cParty: comp;
{
  Result := false;
  iNextVisual('Загрузка файла');
  mtClear(tntFileRows, mfNormal);
  iAtlProtocol.LogMessage(APE_INFO, 'Загрузка Excel-файла: ' + sXls);
  _try
  {
    if not ExistFile(sXls)
    {
      iAtlProtocol.LogLine(APE_ERROR, 'Не найден файл: ' + sXls);
      exit;
    }
    if not xlOpenExcel(false)
    {
      iAtlProtocol.LogLine(APE_ERROR, 'Ошибка инициализации Excel');
      exit;
    }
    if not xlOpenWorkBook(sXls)
    {
      iAtlProtocol.LogLine(APE_ERROR, 'Не удалось открыть файл: ' + sXls);
      exit;
    }
    r1 := r2 := c1 := c2 := 0;
    xlGetUsedRange(r1, c1, r2, c2);    
    iAtlProtocol.LogLine(APE_INFO, 'Таблица: ' + r1 +',' +  c1 +',' +  r2 +',' +  c2);
    rFirst := 2;
    rLast := 10000;
    rLast := if(r2 < rLast, r2, rLast);
    while (rFirst <= r2)
    {
      NextVisual;
      if not xlReadMatrixFromExcel(rFirst, 1, rLast, c2)
      {
        iAtlProtocol.LogLine(APE_ERROR, 'Ошибка чтения данных из Excel!');
        exit;
      }
      for (i := 1; i <= rLast - rFirst + 1; i++)
      {
        if not NextVisual exit;
        xlReadFromMatrix(i, 1, oidAmm);
        xlReadFromMatrix(i, 3, sNrec);
        cParty := 0;
        cParty := comp(sNrec);
        xlReadFromMatrix(i, 7, wMain);
        if OidAmm = ''
          break;

        if cParty = 0
        {
          iAtlProtocol.LogLine(APE_ERROR, 'Неправильный NREC! ' + i + ': ' + sNrec);
          continue;
        }
        insert tFileRows set tFileRows.oidAmm := oidAmm, tFileRows.cParty := cParty, tFileRows.wMain := wMain;
      }
      xlFreeMatrix;
      if OidAmm = ''
        break;

      rFirst := rLast + 1;
      rLast += 10000;
      rLast := if(r2 < rLast, r2, rLast);
    }
  }
  _except else
  {
    iAtlProtocol.LogLine(APE_ERROR, ExploreException);
  }
  _finally
  {
    xlKillExcel;
    iAtlProtocol.LogLine(APE_INFO, 'Загружено строк: ' + RecordsInTable(tntFileRows));
  }
  
  mtClear(tntReplaceParty, mfNormal);
  _loop tFileRows where ((0 == tFileRows.wMain))
  {
    if getfirst tFileRows2 where ((1 == tFileRows2.wMain and tFileRows.oidAmm == tFileRows2.oidAmm)) = tsOK
      insert tReplaceParty set tReplaceParty.cPartyFrom := tFileRows.cParty, tReplaceParty.cPartyTo := tFileRows2.cParty;
    else
      iAtlProtocol.LogLine(APE_ERROR, 'Не найдена основная запись для партии с nrec = ' + cParty);
  }
  iAtlProtocol.LogLine(APE_INFO, 'Партий к замене: ' + RecordsInTable(tntReplaceParty));

  // _loop tReplaceParty where ((root == tReplaceParty.cPartyFrom and tReplaceParty.cPartyFrom == KatParty.NRec and tReplaceParty.cPartyTo == KatParty2.NRec))
  //   iAtlProtocol.LogLine(APE_INFO, KatParty.Kod + ' -> ' + KatParty2.Kod);    
  // iAtlProtocol.LogLine(APE_INFO, RecordsInTable(tntReplaceParty));
  iAtlProtocol.LogCommit;

  //PutTableToDBF(tntReplaceParty, 'repParty.dbf', ptfFullTable);
  Result := message('Считано строк: ' + RecordsInTable(tntFileRows) + ''#13 
                  + 'Партий к замене: ' + RecordsInTable(tntReplaceParty) + ''#13 
                  + 'Продолжить?', YesNo + Confirmation) = cmYes;
}


function LoadExcelFile2(mParty: TPtr): boolean;
var i, r1, r2, c1, c2, rFirst, rLast: longInt;
    sNrec: string;
    cParty: comp;
{
  Result := false;
  iNextVisual('Загрузка файла');
  mtClear(tntFileRows, mfNormal);
  iAtlProtocol.LogMessage(APE_INFO, 'Загрузка Excel-файла: ' + sXls2);
  _try
  {
    if not ExistFile(sXls2)
    {
      iAtlProtocol.LogLine(APE_ERROR, 'Не найден файл: ' + sXls2);
      exit;
    }
    if not xlOpenExcel(false)
    {
      iAtlProtocol.LogLine(APE_ERROR, 'Ошибка инициализации Excel');
      exit;
    }
    if not xlOpenWorkBook(sXls2)
    {
      iAtlProtocol.LogLine(APE_ERROR, 'Не удалось открыть файл: ' + sXls);
      exit;
    }
    r1 := r2 := c1 := c2 := 0;
    xlGetUsedRange(r1, c1, r2, c2);    
    iAtlProtocol.LogLine(APE_INFO, 'Таблица: ' + r1 +',' +  c1 +',' +  r2 +',' +  c2);
    rFirst := 2;
    rLast := 10000;
    rLast := if(r2 < rLast, r2, rLast);
    while (rFirst <= r2)
    {
      NextVisual;
      if not xlReadMatrixFromExcel(rFirst, 1, rLast, 1)
      {
        iAtlProtocol.LogLine(APE_ERROR, 'Ошибка чтения данных из Excel!');
        exit;
      }
      for (i := 1; i <= rLast - rFirst + 1; i++)
      {
        if not NextVisual exit;
        xlReadFromMatrix(i, 1, sNrec);
        if sNrec = '' 
          break;

        cParty := 0;
        cParty := comp(sNrec);
        if cParty = 0
        {
          iAtlProtocol.LogLine(APE_ERROR, 'Неправильный NREC! ' + i + ': ' + sNrec);
          continue;
        }
        if not FoundMarker(mParty, cParty)
          InsertMarker(mParty, cParty);
      }
      xlFreeMatrix;

      rFirst := rLast + 1;
      rLast += 10000;
      rLast := if(r2 < rLast, r2, rLast);
    }
  }
  _except else
  {
    iAtlProtocol.LogLine(APE_ERROR, ExploreException);
  }
  _finally
  {
    xlKillExcel;
    iAtlProtocol.LogLine(APE_INFO, 'Загружено строк: ' + GetMarkerCount(mParty));
  }
  iAtlProtocol.LogCommit;

  Result := message('Партий к изменению группы: ' + GetMarkerCount(mParty) + ''#13 
                  + 'Продолжить?', YesNo + Confirmation) = cmYes;
}

function ReplacePartyLinks: boolean;
{
  Result := false;
  iAtlProtocol.LogMessage(APE_INFO, 'Замена ссылок на партии');
  iNextVisual('Замена ссылок на партии');
  mtClear(tntQueries, mfNormal);
  insert tQueries set tQueries.Name := 'DOCSKAU.CPARTY', tQueries.sQuery := 'update DOCSKAU set DOCSKAU.CPARTY = tReplaceParty.cPartyTo from DOCSKAU, tReplaceParty where DOCSKAU.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'SOPRORDB.CPARTY', tQueries.sQuery := 'update SOPRORDB set SOPRORDB.CPARTY = tReplaceParty.cPartyTo from SOPRORDB, tReplaceParty where SOPRORDB.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'SPINVTAB.CPARTY', tQueries.sQuery := 'update SPINVTAB set SPINVTAB.CPARTY = tReplaceParty.cPartyTo from SPINVTAB, tReplaceParty where SPINVTAB.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'CARDSN.CPARTY', tQueries.sQuery := 'update CARDSN set CARDSN.CPARTY = tReplaceParty.cPartyTo from CARDSN, tReplaceParty where CARDSN.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'EM_SPSOPR_EXT.CPARTYON', tQueries.sQuery := 'update EM_SPSOPR_EXT set EM_SPSOPR_EXT.CPARTYON = tReplaceParty.cPartyTo from EM_SPSOPR_EXT, tReplaceParty where EM_SPSOPR_EXT.CPARTYON = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'GP_PARTY_INPUT.CKATPARTY', tQueries.sQuery := 'update GP_PARTY_INPUT set GP_PARTY_INPUT.CKATPARTY = tReplaceParty.cPartyTo from GP_PARTY_INPUT, tReplaceParty where GP_PARTY_INPUT.CKATPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'GP_PARTY_INPUT_SP.CKATPARTY', tQueries.sQuery := 'update GP_PARTY_INPUT_SP set GP_PARTY_INPUT_SP.CKATPARTY = tReplaceParty.cPartyTo from GP_PARTY_INPUT_SP, tReplaceParty where GP_PARTY_INPUT_SP.CKATPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'DSIO.CPARTY', tQueries.sQuery := 'update DSIO set DSIO.CPARTY = tReplaceParty.cPartyTo from DSIO, tReplaceParty where DSIO.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'INBOXP.CPARTY', tQueries.sQuery := 'update INBOXP set INBOXP.CPARTY = tReplaceParty.cPartyTo from INBOXP, tReplaceParty where INBOXP.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'GP_SPSTEP.CPARTY', tQueries.sQuery := 'update GP_SPSTEP set GP_SPSTEP.CPARTY = tReplaceParty.cPartyTo from GP_SPSTEP, tReplaceParty where GP_SPSTEP.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'SPMTRACT.CPARTY', tQueries.sQuery := 'update SPMTRACT set SPMTRACT.CPARTY = tReplaceParty.cPartyTo from SPMTRACT, tReplaceParty where SPMTRACT.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'RPJORN.CPARTY2', tQueries.sQuery := 'update RPJORN set RPJORN.CPARTY2 = tReplaceParty.cPartyTo from RPJORN, tReplaceParty where RPJORN.CPARTY2 = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'INVTAB.CPARTY', tQueries.sQuery := 'update INVTAB set INVTAB.CPARTY = tReplaceParty.cPartyTo from INVTAB, tReplaceParty where INVTAB.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'GP_HISTDMPARTY.CPARTY', tQueries.sQuery := 'update GP_HISTDMPARTY set GP_HISTDMPARTY.CPARTY = tReplaceParty.cPartyTo from GP_HISTDMPARTY, tReplaceParty where GP_HISTDMPARTY.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'RPJORN.CPARTY1', tQueries.sQuery := 'update RPJORN set RPJORN.CPARTY1 = tReplaceParty.cPartyTo from RPJORN, tReplaceParty where RPJORN.CPARTY1 = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'DORES.CPARTY', tQueries.sQuery := 'update DORES set DORES.CPARTY = tReplaceParty.cPartyTo from DORES, tReplaceParty where DORES.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'GP_BASEDOC.CPARTY', tQueries.sQuery := 'update GP_BASEDOC set GP_BASEDOC.CPARTY = tReplaceParty.cPartyTo from GP_BASEDOC, tReplaceParty where GP_BASEDOC.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'SPSOPR.CPARTY', tQueries.sQuery := 'update SPSOPR set SPSOPR.CPARTY = tReplaceParty.cPartyTo from SPSOPR, tReplaceParty where SPSOPR.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'SPORDER.CPARTY', tQueries.sQuery := 'update SPORDER set SPORDER.CPARTY = tReplaceParty.cPartyTo from SPORDER, tReplaceParty where SPORDER.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'SPSCHF.CPARTY', tQueries.sQuery := 'update SPSCHF set SPSCHF.CPARTY = tReplaceParty.cPartyTo from SPSCHF, tReplaceParty where SPSCHF.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'MBPIN.CPARTYF', tQueries.sQuery := 'update MBPIN set MBPIN.CPARTYF = tReplaceParty.cPartyTo from MBPIN, tReplaceParty where MBPIN.CPARTYF = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'MBPINV.CPARTY', tQueries.sQuery := 'update MBPINV set MBPINV.CPARTY = tReplaceParty.cPartyTo from MBPINV, tReplaceParty where MBPINV.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'SPSTEP.CPARTY', tQueries.sQuery := 'update SPSTEP set SPSTEP.CPARTY = tReplaceParty.cPartyTo from SPSTEP, tReplaceParty where SPSTEP.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'PRICES.CPARTY', tQueries.sQuery := 'update PRICES set PRICES.CPARTY = tReplaceParty.cPartyTo from PRICES, tReplaceParty where PRICES.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'BASEDOC.CPARTY', tQueries.sQuery := 'update BASEDOC set BASEDOC.CPARTY = tReplaceParty.cPartyTo from BASEDOC, tReplaceParty where BASEDOC.CPARTY = tReplaceParty.cPartyFrom ';
  insert tQueries set tQueries.Name := 'oborot.kauos[1]', tQueries.sQuery := 'update oborot set oborot.kauos[1] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauos[1] = tReplaceParty.cPartyFrom and oborot.tblos[1] = 10';
  insert tQueries set tQueries.Name := 'oborot.kauos[2]', tQueries.sQuery := 'update oborot set oborot.kauos[2] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauos[2] = tReplaceParty.cPartyFrom and oborot.tblos[2] = 10';
