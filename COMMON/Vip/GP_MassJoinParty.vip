  insert tQueries set tQueries.Name := 'oborot.kauos[5]', tQueries.sQuery := 'update oborot set oborot.kauos[5] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauos[5] = tReplaceParty.cPartyFrom and oborot.tblos[5] = 10';
  insert tQueries set tQueries.Name := 'oborot.kauos[6]', tQueries.sQuery := 'update oborot set oborot.kauos[6] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauos[6] = tReplaceParty.cPartyFrom and oborot.tblos[6] = 10';
  insert tQueries set tQueries.Name := 'oborot.kauks[1]', tQueries.sQuery := 'update oborot set oborot.kauks[1] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauks[1] = tReplaceParty.cPartyFrom and oborot.tblks[1] = 10';
  insert tQueries set tQueries.Name := 'oborot.kauks[2]', tQueries.sQuery := 'update oborot set oborot.kauks[2] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauks[2] = tReplaceParty.cPartyFrom and oborot.tblks[2] = 10';
  insert tQueries set tQueries.Name := 'oborot.kauks[3]', tQueries.sQuery := 'update oborot set oborot.kauks[3] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauks[3] = tReplaceParty.cPartyFrom and oborot.tblks[3] = 10';
  insert tQueries set tQueries.Name := 'oborot.kauks[4]', tQueries.sQuery := 'update oborot set oborot.kauks[4] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauks[4] = tReplaceParty.cPartyFrom and oborot.tblks[4] = 10';
  insert tQueries set tQueries.Name := 'oborot.kauks[5]', tQueries.sQuery := 'update oborot set oborot.kauks[5] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauks[5] = tReplaceParty.cPartyFrom and oborot.tblks[5] = 10';
  insert tQueries set tQueries.Name := 'oborot.kauks[6]', tQueries.sQuery := 'update oborot set oborot.kauks[6] = tReplaceParty.cPartyTo from oborot, tReplaceParty where oborot.kauks[6] = tReplaceParty.cPartyFrom and oborot.tblks[6] = 10';
  insert tQueries set tQueries.Name := 'mnplan.canval1', tQueries.sQuery := 'update mnplan set mnplan.canval1 = tReplaceParty.cPartyTo from mnplan, tReplaceParty where mnplan.canval1 = tReplaceParty.cPartyFrom and mnplan.wkodgr1 = 10';
  insert tQueries set tQueries.Name := 'mnplan.canval2', tQueries.sQuery := 'update mnplan set mnplan.canval2 = tReplaceParty.cPartyTo from mnplan, tReplaceParty where mnplan.canval2 = tReplaceParty.cPartyFrom and mnplan.wkodgr2 = 10';
  insert tQueries set tQueries.Name := 'mnplan.canval3', tQueries.sQuery := 'update mnplan set mnplan.canval3 = tReplaceParty.cPartyTo from mnplan, tReplaceParty where mnplan.canval3 = tReplaceParty.cPartyFrom and mnplan.wkodgr3 = 10';
  insert tQueries set tQueries.Name := 'mnplan.canval4', tQueries.sQuery := 'update mnplan set mnplan.canval4 = tReplaceParty.cPartyTo from mnplan, tReplaceParty where mnplan.canval4 = tReplaceParty.cPartyFrom and mnplan.wkodgr4 = 10';
  insert tQueries set tQueries.Name := 'mnplan.canval5', tQueries.sQuery := 'update mnplan set mnplan.canval5 = tReplaceParty.cPartyTo from mnplan, tReplaceParty where mnplan.canval5 = tReplaceParty.cPartyFrom and mnplan.wkodgr5 = 10';
  insert tQueries set tQueries.Name := 'spmnplan.canval1', tQueries.sQuery := 'update spmnplan set spmnplan.canval1 = tReplaceParty.cPartyTo from spmnplan, tReplaceParty where spmnplan.canval1 = tReplaceParty.cPartyFrom and spmnplan.wkodgr1 = 10';
  insert tQueries set tQueries.Name := 'spmnplan.canval2', tQueries.sQuery := 'update spmnplan set spmnplan.canval2 = tReplaceParty.cPartyTo from spmnplan, tReplaceParty where spmnplan.canval2 = tReplaceParty.cPartyFrom and spmnplan.wkodgr2 = 10';
  insert tQueries set tQueries.Name := 'spmnplan.canval3', tQueries.sQuery := 'update spmnplan set spmnplan.canval3 = tReplaceParty.cPartyTo from spmnplan, tReplaceParty where spmnplan.canval3 = tReplaceParty.cPartyFrom and spmnplan.wkodgr3 = 10';
  insert tQueries set tQueries.Name := 'spmnplan.canval4', tQueries.sQuery := 'update spmnplan set spmnplan.canval4 = tReplaceParty.cPartyTo from spmnplan, tReplaceParty where spmnplan.canval4 = tReplaceParty.cPartyFrom and spmnplan.wkodgr4 = 10';
  insert tQueries set tQueries.Name := 'spmnplan.canval5', tQueries.sQuery := 'update spmnplan set spmnplan.canval5 = tReplaceParty.cPartyTo from spmnplan, tReplaceParty where spmnplan.canval5 = tReplaceParty.cPartyFrom and spmnplan.wkodgr5 = 10';
  insert tQueries set tQueries.Name := 'spmnpl.canval1', tQueries.sQuery := 'update spmnpl set spmnpl.canval1 = tReplaceParty.cPartyTo from spmnpl, tReplaceParty where spmnpl.canval1 = tReplaceParty.cPartyFrom and spmnpl.wkodgr1 = 10';
  insert tQueries set tQueries.Name := 'spmnpl.canval2', tQueries.sQuery := 'update spmnpl set spmnpl.canval2 = tReplaceParty.cPartyTo from spmnpl, tReplaceParty where spmnpl.canval2 = tReplaceParty.cPartyFrom and spmnpl.wkodgr2 = 10';
