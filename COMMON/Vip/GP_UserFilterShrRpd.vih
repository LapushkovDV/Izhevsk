#ifndef __GP_UserFilterShrRpd_VIH__
#define __GP_UserFilterShrRpd_VIH__

#component "GP_Common"

#include GP_UserFilter.vih

vipinterface GP_UserFilterShrRpd(GP_UserFilter);
public:
  constructor GP_UserFilterShrRpd(NoField:tptr; SaveName:string; wFlags: word = vfMultipleSelection);
  procedure GP_IUserFilter.Pick;
  procedure RefreshFilterStr;
  property Marker: TPtr read; //маркер распорядительных действий. в маркере КОДЫ РПД, а не nrec'и
  property Flags: word; //флаг пометки (vfCanSelect - одиночная пометка, vfMultipleSelection - множественная пометка)
  protected function GP_IUserFilter.GetFilterStr: string;
end;

