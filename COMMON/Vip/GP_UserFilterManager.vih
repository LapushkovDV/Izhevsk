#ifndef __GP_UserFilterManager_VIH__
#define __GP_UserFilterManager_VIH__

#include GP_IUserFilter.obj
#include GP_IUserFilterStore.obj
#include GP_IOnCmDefault.obj
#include GP_UserFilterEditViewFactory.vih

#component "GP_Common"

const
  GP_IUserFilterManager_SaveAll: byte = 0;
  GP_IUserFilterManager_SaveOnlyActive: byte = 1;
  GP_IUserFilterManager_SaveOnlyInactive: byte = 2;
end;

ObjInterface GP_IUserFilterManager;

  function  AddFilter(lNoField: longint; objUserFilter: GP_IUserFilter;
                      sFieldCaption: String = ''; objEditInterface: GP_IOnCmDefault = NullRef): boolean;
  function  GetFilterCount: longint;
  procedure ActivateFilter(filterIndex: longint);
  procedure DeactivateFilter(filterIndex: longint);
  function  EditFilter(filterIndex: longint): boolean;
  function  GetFilter(filterIndex: longint): GP_IUserFilter;
  function  GetFilterStr(filterIndex: longint): string;
  function  GetFilterCaption(filterIndex: longint): string;
  function  FilterIsActive(filterIndex: longint): boolean;
  function  PickFilter(filterIndex: longint): boolean;
  function  DelFilter(filterIndex: longint): boolean;

  procedure ActivateFilterForField(lNoField: longint);
  procedure DeactivateFilterForField(lNoField: longint);
  function  EditFilterForField(lNoField: longint): boolean;
  function  GetFilterForField(lNoField: longint): GP_IUserFilter;
  function  GetFilterStrForField(lNoField: longint): string;
  function  GetFilterCaptionForField(lNoField: longint): string;
  function  FilterForFieldIsActive(lNoField: longint): boolean;
  function  PickFilterForField(lNoField: longint): boolean;
  function  DelFilterForField(lNoField: longint): boolean;
  function  AddMenuItemForField(menuId    : longint;
                                lNoField  : longint;
                                command   : word = cmNal;
                                keyCode   : word = kbAltF;
                                keyCodeHlp: string = 'Alt+F'): boolean;
  procedure Load;
  procedure Save(bSaveMode: byte = GP_IUserFilterManager_SaveAll);

  property Ind      : longint read;
  property NoField  : longint read;
  property Caption  : String read;
  property IsActive : boolean read;
  property FilterStr: String read;
  property Filter   : GP_IUserFilter read;

  index ByInd = Ind (unique);

  event procedure OnFilterChanged(filterIndex: longint);
  event function  OnBeforeAddFilter(lNoField: longint; objUserFilter: GP_IUserFilter;
                                    sFieldCaption: String; objEditInterface: GP_IOnCmDefault): word;
  event procedure OnAfterAddFilter(lNoField: longint; objUserFilter: GP_IUserFilter;
                                   sFieldCaption: String; objEditInterface: GP_IOnCmDefault);
  event function  OnBeforeActivateFilter(filterIndex: longint): word;
  event procedure OnAfterActivateFilter(filterIndex: longint);
  event function  OnBeforeDelFilter(filterIndex: longint): word;
  event procedure OnAfterDelFilter(filterIndex: longint);
  event function  OnBeforePickFilter(filterIndex: longint): word;
  event procedure OnAfterPickFilter(filterIndex: longint);
  event function  OnBeforeEditFilter(filterIndex: longint): word;
  event procedure OnAfterEditFilter(filterIndex: longint);
  event function  OnBeforeDeactivateFilter(filterIndex: longint): word;
  event procedure OnAfterDeactivateFilter(filterIndex: longint);

end;

VipInterface GP_UserFilterManager Implements GP_IUserFilterManager;
public:
  constructor Init;
  constructor UserFilterManager(Store: GP_IUserFilterStore;
                                EditViewFactory: GP_IUserFilterEditViewFactory = NullRef);
  destructor Done;
end;

#endif
