#include GP_UserFilterManager.vih

#component "GP_Common"

#include GP_UserFilterManagerViewBrowse.vih
interface GP_UserFilterManagerViewBrowse;

var
  _filterManager: GP_IUserFilterManager;

create view
as select _filterManager.Ind
from _filterManager;

browse brFilters ('',,);
table _filterManager;
fields

  [FilterIsActiveFld] if(_filterManager.IsActive, '+', '-')
    '+/-' ('Установить +, Снять -',,sci13Esc): [3],
    noautosize, protect, pickbutton;

  [FilterFld] _filterManager.Caption + ' ' + _filterManager.FilterStr
    'Фильтр' ('Изменить фильтр',,sci13Esc): [50],
    protect, pickbutton;

end;

handleevent
  cmPick:
  {
    case curfield of
      #FilterIsActiveFld:
      {
        if _filterManager.IsActive
          _filterManager.DeactivateFilter(_filterManager.Ind)
        else
          _filterManager.ActivateFilter(_filterManager.Ind);
      }
      #FilterFld:
      {
        _filterManager.PickFilter(_filterManager.Ind);
      }
    end;
  }
  cmDelOnProtect:
  {
    _filterManager.DelFilter(_filterManager.Ind);
  }
  cmDefault:
  {
    OnCmDefault;
  }
end;

procedure OnAfterFilterChanged(filterIndex: longint);
{
  filterIndex := filterIndex;
  rereadrecord;
}

//*****************************************************************************
//#region GP_UserFilterManagerViewActiveFilters

Constructor Init;
{
  result := false;
}

Constructor UserFilterManagerViewBrowse(objUserFilterManager: GP_IUserFilterManager);
{
  _filterManager := objUserFilterManager;
  result := _filterManager != NullRef;
  if result
  {
    BindEvent(OnAfterFilterChanged, _filterManager.OnAfterActivateFilter);
    BindEvent(OnAfterFilterChanged, _filterManager.OnAfterDeactivateFilter);
    BindEvent(OnAfterFilterChanged, _filterManager.OnAfterEditFilter);
    BindEvent(OnAfterFilterChanged, _filterManager.OnAfterPickFilter);
    BindEvent(OnAfterFilterChanged, _filterManager.OnAfterDelFilter);
  }
}

//#endregion GP_UserFilterManagerViewActiveFilters
//*****************************************************************************

end.
