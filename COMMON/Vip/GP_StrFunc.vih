#IFNDEF __GP_STRFUNC_VIH__
#DEFINE __GP_STRFUNC_VIH__

#component "GP_Common"

objInterface GP_ObjStrFunc;

  // Преобразует полные Фамилию Имя и Отчество в Фамилию с инициалами
  // FIOType - тип:
  //  1 Фамилия с инициалами, инициалы справа
  //  2 Фамилия с инициалами, инициалы слева
  function ShortFIO(FIO: String; FIOType: Byte = 1): String;

  // Сцепляет две строки, вставляя между ними разделитель
  // Если какая-то из строк пустая, разделитель не вставляется
  // Если разделитель запятая, точка или точка с запятой, то после разделителя вставляется пробел
  function LinkStr(S1: String; S2: String; Delim: String): String;

  // Преобразовывет количество в строку, удаляя все незначащие нули после запятой
  function QuantToStr(N: Double): String;

  // Аналог DateToStr, но в случае, если дата пустая, возвращается пустая строка, а не 'ДД/ММ/ГГГГ'
  function DateToStrE(PDate: Date): String;

  // Аналог DateToStrE с возможностью задания формата преобразования даты в строку
  function DateToStrEF(PDate: Date; PFormat: String): String;

  // Преобразовывает строку, содержащую дату в формате по умолчанию в тип дата
  // Формат берётся из параметра конфигурационного файла Compilers.DefaultDateFormat
  // Символы '/' и '.' в строке с датой и в строке с форматом считаются равноценными
  function StringToDate(S: String): Date;

  // Преобразовывает первый символ строки в нижний регистр
  function LoCaseFirstChar(S: String): String;

  // Преобразовывает первый символ строки в верхний регистр
  function UpCaseFirstChar(S: String): String;

  // Возвращает фамилию имя отчество в указанном падеже
  // cPersons - ссылка на таблицу Persons (для анализа таблицы исключений, может быть 0)
  // FIO - фамилия имя отчество в именительном падеже
  // NCase - падеж:
  //  1 Именительный
  //  2 Родительный
  //  3 Дательный
  //  4 Винительный
  //  5 Творительный
  //  6 Предложный
  function FIODecl(cPersons: tNRec; FIO: String; NCase: Word): String;

  // Возвращает фамилию с инициалами в указанном падеже
  // FIOType - тип:
  //  1 Фамилия с инициалами, инициалы справа
  //  2 Фамилия с инициалами, инициалы слева
  function ShortFIODecl(cPersons: tNRec; FIO: String; NCase: Word; FIOType: Byte = 1): String;

  // Возвращает должность указанного работника на указанну дату в указанном падеже
  // Реализована поддержка только следующих падежей:
  //  1 Именительный
  //  2 Родительный
  //  3 Дательный
  function GetPersPost(cPersons: tNRec; NCase: Word; OnDate: Date): String;

  // Преобразовывает кол-во часов из числа с плавающей точкой в строку в формате "HH:MM"
  function TimeDToH(D: Double): String;

  // Возвращает наименование отчетного периода
  function PeriodName(_DBeg: Date; _DEnd: Date): String;

end;

vipInterface GP_StrFunc Implements GP_ObjStrFunc;
#endif
