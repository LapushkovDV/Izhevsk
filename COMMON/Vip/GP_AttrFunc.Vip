#include GP_AttrFunc.Vih
#doc
Функции по работе с внешними атрибутами
<p>3782 -	Складской учет / Документы / Акты об излишках / CTRL+P/ ЭМ. Комплектация материальных ценностей с ДМ
#end

//----------------------------------------------------
Interface GP_AttrFunc 'Функции по работе с внешними атрибутами' ;
//----------------------------------------------------
Table Struct tmp_attr
( cRec:comp
 ,vString:string
)
with index
( tmp_attr01 = cRec
)
;
//----------------------------------------------------
create view
as select tmp_attr.*
From tmp_attr
;


//------------------------------------------------------------------------------
// Наименование интерфейса
//------------------------------------------------------------------------------
Function GetIName : string;
{ Result := #(__InterfaceName__);
}

//===========================================
// Найти в маркер все записи со значением внешнего атрибута типа comp
Function FindAttrValComp(
    _wTable   : word      // таблица
  ; _pValue   : comp      // значение внешнего атрибута
  ; _Marker   : TPtr      // маркер для хранения значений
  ; _pAttrID  : comp      // AttrNam.Nrec
  ; _sAttrNam : string='' // Если _pAttrID=0 то AttrNam.Name
  ): boolean;
{ delete all tmp_attr;
  Result:=False;
  if _Marker=0 then exit;
  ClearMarker(_Marker);
  if _pAttrID=0 _pAttrID:=ExtAttr_ID(_wTable,_sAttrNam);
  _try
  { SQL Select AttrVal.cRec,AttrVal.vString
    From AttrVal
    where  AttrVal.cAttrNam=:(_pAttrID)
       and AttrVal.vComp   =:(_pValue)
    into tmp_attr;
    _Loop tmp_Attr
    { InsertMarker(_Marker,tmp_Attr.cRec);
    } //_Loop tmp_Attr
  } //_try
  _Except
  else
  {
  }
  Result:=True;
} //Function FindAttrValComp(_wTable:word //таблица

