#component "C_EXTCLASS"

#doc
Редактирование атрибутов
#end
//======================================
Alter InterFace attribute;
HandleEvent
cmOpenSearch:
 {

  if (TableCode = coMnPlan) and (AttrNam.Name<>'')
  {
     if RunInterface('GP_COMMON::GP_CheckRoleStateVA',RECORDNUMBER,AttrNam.nrec)<>cmDefault then
     {
       message('Вам запрещено редактирование!');
       abort;
       exit;
     }
  }
  if inherited::handleevent ( cmOpenSearch ) = heAbort
      Abort;
 }
  CmEdit:
  {
    if (wGetTune('NPOEM_OWN.RIGHTS.EXT_ATTR_ACCESS') = 1) then
    {
      inherited::handleevent ( cmEdit )
    }
    else
    {
      Message('Редактировать НЕЛЬЗЯ!',error);
    }
  }
 end;
end.
