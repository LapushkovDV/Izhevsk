HandleEvent
cmInit:
{
 SetVisibleFields(pWMode);
}
end;
end;
procedure ShowMessage(_cFormpl : comp; _pWMode : word);
{

  set pWMode  := _pWMode;
  set nrecFormpl := _cFormpl;
  _fieldShowTill := 'Показывать до';
  _MarkColor := 'Выделять цветом';
  _SendMail := 'Выполнить рассылку';
  _RemindBuh := 'Добавить в письмо "Обращаться в бухгалтерию"';

  if getfirst FormPl <> tsOK
   {
      Message('В настройке не указан алгоритм, продолжение невозможно ' + nrecFormpl, error);
      stop;abort;exit
   }

  NPOEM_OWN_SCUD_EMAIL_TYPE:=wGetTune('NPOEM_OWN.SCUD.EMAIL_TYPE');

  Update FormPl Set ResWord[1] = 0;

  if (getfirst fastfirstrow spFormPl1 <> tsOk) then
  {
    Insert SpFormPl1 set
       SpFormPl1.cFormPl := FormPl.NRec
     , SpFormPl1.TYPEREC := 1
  }

  if (getfirst fastfirstrow spFormPl2 <> tsOk) then
  {
    Insert SpFormPl2 set
       SpFormPl2.cFormPl := FormPl.NRec
     , SpFormPl2.TYPEREC := 2
  }

  if (getfirst fastfirstrow spFormPl3 <> tsOk) then
  {
    Insert SpFormPl3 set
       SpFormPl3.cFormPl := FormPl.NRec
     , SpFormPl3.TYPEREC := 3
  }

  if (getfirst fastfirstrow spFormPl4 <> tsOk) then
  {
    Insert SpFormPl4 set
       SpFormPl4.cFormPl := FormPl.NRec
     , SpFormPl4.TYPEREC := 4
  }
  ReReadRecord;

//  message(_cFormpl +' ' +_pWMode );
  RunWindowmodal(winMsgSet);

  if ( (pWMode = 1) and (FormPl.RESWORD[1] = 1)) then
  {
    if (Message('Выполнить рассылку?', YesNo) = cmYes) then
    {
      #declare mes(tnum, num)
        if (SPFORMPL#tnum.RESNAME[#num] <> '') then
        {
          if (SPFORMPL#tnum.RESWORD1[#num] = 1) then
          {
            Write_Mess('<br /><span style="color: #DF0101;">' + SPFORMPL#tnum.RESNAME[#num] + '</span>');
          }
          else
          {
            Write_Mess('<br />' + SPFORMPL#tnum.RESNAME[#num]);
          }
        }
      #end
      num_row:=0;
      Write_Mess('<br />' +'Добрый день!');
      Write_Mess('<br />');
      #mes(1, 1)
      #mes(1, 2)
      #mes(1, 3)
      #mes(1, 4)
      #mes(1, 5)
      #mes(1, 6)
      #mes(1, 7)
      #mes(1, 8)
      #mes(1, 9)
      #mes(1, 10)

      #mes(2, 1)
      #mes(2, 2)
      #mes(2, 3)
      #mes(2, 4)
      #mes(2, 5)
      #mes(2, 6)
      #mes(2, 7)
      #mes(2, 8)
      #mes(2, 9)
      #mes(2, 10)

      #mes(3, 1)
      #mes(3, 2)
      #mes(3, 3)
      #mes(3, 4)
      #mes(3, 5)
      #mes(3, 6)
      #mes(3, 7)
      #mes(3, 8)
      #mes(3, 9)
      #mes(3, 10)

      #mes(4, 1)
      #mes(4, 2)
      #mes(4, 3)
      //#mes(4, 8)
      //#mes(4, 9)
      //#mes(4, 10)
      Write_Mess('<br />');
      if (FormPl.RESWORD[2] = 1) then
      {
        Write_Mess('<br />' +'По возникающим вопросам своевременного проведения документов обращаться к руководителям отделов бухгалтерии по направлениям.');
      }

      Write_Mess(' ');
      pGP_EmailRun.EmailSend
          ( NPOEM_OWN_SCUD_EMAIL_TYPE
           ,'GalaktikaERPUsers' + '@' + sGetTune('NPOEM_OWN.EMAIL_DOM') //@npoem.ru'
           ,'Галактика ERP. Закрытие месяца'
           ,''
           ,string(SPFORMPL4.RESNAME[1]) //_email_attach1 :string ;
           ,string(SPFORMPL4.RESNAME[2]) //_email_attach2 :string ;
           ,string(SPFORMPL4.RESNAME[3]) //_email_attach3 :string ;
           ,'' //_email_attach2 :string ;
           ,'' //_email_attach5:string ;
           ,'' //_email_addr_copy :string='';
           ,'' //_email_addr_from :string=''
         )
    }
  }
}
HandleEvent
cmInit:
{
  if (nrecFormPl = 0h) then
  {
    nrecFormPl := cogettune('NPOEM_OWN.ADMIN.PERIOD_CLOSE');
  }
  ShowMessage(nrecFormPl, pWMode);
  Abort;
}

cmCheckField:
{
  Update Current SpFormPl1;
  Update Current SpFormPl2;
  Update Current SpFormPl3;
  Update Current SpFormPl4;
  Update Current FormPl;
  ReReadRecord;
}
end;
End.
