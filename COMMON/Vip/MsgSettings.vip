#doc
Настройка сообщения для пользователей при открытии Галактики.
#end

#include GP_EmailRun.vih

Interface MsgSettings 'Настройка сообщения для пользователей при открытии Галактики.';
show(5,1,90,26);


Create view
var pWMode, num_row, NPOEM_OWN_SCUD_EMAIL_TYPE : word;
    pGP_EmailRun : GP_EmailRun;
    nrecFormPl : comp;
    _fieldShowTill, _MarkColor, _SendMail, _RemindBuh : string;
as select

  word(SpFormPl1.descr)
from
  FormPl
 ,SpFormPl SpFormPl1
 ,SpFormPl SpFormPl2
 ,SpFormPl SpFormPl3
 ,SpFormPl SpFormPl4
where
((
                                           nrecFormPl == FormPl.NRec
and                                       FormPl.NRec == SpFormPl1.cFormPl
and                                                 1 == SpFormPl1.TYPEREC
and                                       FormPl.NRec == SpFormPl2.cFormPl
and                                                 2 == SpFormPl2.TYPEREC
and                                       FormPl.NRec == SpFormPl3.cFormPl
and                                                 3 == SpFormPl3.TYPEREC
and                                       FormPl.NRec == SpFormPl4.cFormPl
and                                                 4 == SpFormPl4.TYPEREC

));

parameters nrecFormPl, pWMode;

Procedure Write_Mess(w: string);
{
  num_row++;
  pGP_EmailRun.Write_Text(num_row, w);
}


Procedure SetVisibleFields(pwm: word);
{
  if (pwm = 0) then
  {
    ToggleFieldVisible(#FormPl.RESDATE[1], false);
    ToggleFieldVisible(#FormPl.RESWORD[1], false);
    ToggleFieldVisible(#_fieldShowTill, false);
    ToggleFieldVisible(#_MarkColor, false);
    ToggleFieldVisible(#_SendMail, false);

    ToggleFieldVisible(#_RemindBuh, false);
    ToggleFieldVisible(#FormPl.RESWORD[2], false);

    ToggleFieldSelectable(#SPFORMPL1.RESNAME[1], false);
    ToggleFieldSelectable(#SPFORMPL1.RESNAME[2], false);
    ToggleFieldSelectable(#SPFORMPL1.RESNAME[3], false);
    ToggleFieldSelectable(#SPFORMPL1.RESNAME[4], false);
    ToggleFieldSelectable(#SPFORMPL1.RESNAME[5], false);
    ToggleFieldSelectable(#SPFORMPL1.RESNAME[6], false);
    ToggleFieldSelectable(#SPFORMPL1.RESNAME[7], false);
    ToggleFieldSelectable(#SPFORMPL1.RESNAME[8], false);
    ToggleFieldSelectable(#SPFORMPL1.RESNAME[9], false);
    ToggleFieldSelectable(#SPFORMPL1.RESNAME[10], false);

    ToggleFieldSelectable(#SPFORMPL2.RESNAME[1], false);
    ToggleFieldSelectable(#SPFORMPL2.RESNAME[2], false);
    ToggleFieldSelectable(#SPFORMPL2.RESNAME[3], false);
    ToggleFieldSelectable(#SPFORMPL2.RESNAME[4], false);
    ToggleFieldSelectable(#SPFORMPL2.RESNAME[5], false);
    ToggleFieldSelectable(#SPFORMPL2.RESNAME[6], false);
    ToggleFieldSelectable(#SPFORMPL2.RESNAME[7], false);
    ToggleFieldSelectable(#SPFORMPL2.RESNAME[8], false);
    ToggleFieldSelectable(#SPFORMPL2.RESNAME[9], false);
    ToggleFieldSelectable(#SPFORMPL2.RESNAME[10], false);

    ToggleFieldSelectable(#SPFORMPL3.RESNAME[1], false);
    ToggleFieldSelectable(#SPFORMPL3.RESNAME[2], false);
    ToggleFieldSelectable(#SPFORMPL3.RESNAME[3], false);
    ToggleFieldSelectable(#SPFORMPL3.RESNAME[4], false);
    ToggleFieldSelectable(#SPFORMPL3.RESNAME[5], false);
    ToggleFieldSelectable(#SPFORMPL3.RESNAME[6], false);
    ToggleFieldSelectable(#SPFORMPL3.RESNAME[7], false);
    ToggleFieldSelectable(#SPFORMPL3.RESNAME[8], false);
    ToggleFieldSelectable(#SPFORMPL3.RESNAME[9], false);
    ToggleFieldSelectable(#SPFORMPL3.RESNAME[10], false);

    ToggleFieldSelectable(#SPFORMPL4.RESNAME[1], false);
    ToggleFieldSelectable(#SPFORMPL4.RESNAME[2], false);
    ToggleFieldSelectable(#SPFORMPL4.RESNAME[3], false);

    ToggleFieldVisible(#SPFORMPL1.RESWORD1[1], false);
    ToggleFieldVisible(#SPFORMPL1.RESWORD1[2], false);
    ToggleFieldVisible(#SPFORMPL1.RESWORD1[3], false);
    ToggleFieldVisible(#SPFORMPL1.RESWORD1[4], false);
    ToggleFieldVisible(#SPFORMPL1.RESWORD1[5], false);
    ToggleFieldVisible(#SPFORMPL1.RESWORD1[6], false);
    ToggleFieldVisible(#SPFORMPL1.RESWORD1[7], false);
    ToggleFieldVisible(#SPFORMPL1.RESWORD1[8], false);
    ToggleFieldVisible(#SPFORMPL1.RESWORD1[9], false);
    ToggleFieldVisible(#SPFORMPL1.RESWORD1[10], false);

    ToggleFieldVisible(#SPFORMPL2.RESWORD1[1], false);
    ToggleFieldVisible(#SPFORMPL2.RESWORD1[2], false);
    ToggleFieldVisible(#SPFORMPL2.RESWORD1[3], false);
    ToggleFieldVisible(#SPFORMPL2.RESWORD1[4], false);
    ToggleFieldVisible(#SPFORMPL2.RESWORD1[5], false);
    ToggleFieldVisible(#SPFORMPL2.RESWORD1[6], false);
    ToggleFieldVisible(#SPFORMPL2.RESWORD1[7], false);
    ToggleFieldVisible(#SPFORMPL2.RESWORD1[8], false);
    ToggleFieldVisible(#SPFORMPL2.RESWORD1[9], false);
    ToggleFieldVisible(#SPFORMPL2.RESWORD1[10], false);

    ToggleFieldVisible(#SPFORMPL3.RESWORD1[1], false);
    ToggleFieldVisible(#SPFORMPL3.RESWORD1[2], false);
    ToggleFieldVisible(#SPFORMPL3.RESWORD1[3], false);
    ToggleFieldVisible(#SPFORMPL3.RESWORD1[4], false);
    ToggleFieldVisible(#SPFORMPL3.RESWORD1[5], false);
