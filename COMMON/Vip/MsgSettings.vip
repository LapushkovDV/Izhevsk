    ToggleFieldVisible(#SPFORMPL4.RESWORD1[1], false);
    ToggleFieldVisible(#SPFORMPL4.RESWORD1[2], false);
    ToggleFieldVisible(#SPFORMPL4.RESWORD1[3], false);


  }
}

Window winMsgSet 'Внимание пользователей Галактика ERP' escclose Cyan;
show(5,1,90,35);


#declare filedone(tnum, num)
    SpFormPl#tnum.RESNAME[#num] : noprotect, {font = {backcolor = if (SpFormPl#tnum.RESword1[#num]>0, colorneed, 0)}};
    SpFormPl#tnum.RESword1[#num] : noProtect;
#end

Screen scParam (,,sci1Esc);
Show at (,,,);

