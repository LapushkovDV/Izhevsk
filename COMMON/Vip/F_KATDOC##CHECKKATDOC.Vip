#component "F_KATDOC"
#doc
Добавление типов Документов
#964
#4641


#end
Alter Interface CHECKKATDOC;
OverLoad
   procedure MakeKatDoc;
end;
////////////////////////////////////////////////////////////////////////////////
//  построение иерархии документов по модулям, и сами документы
procedure MakeKatDoc;
{ Inherited::MakeKatDoc;
  // обнуление важных переменных
  var nod1, nod2, nod3 : comp;
  nod1 := 0;
  nod2 := 0;
  nod3 := 0;

  //////////////////////////////////////////////////////////////////////////////
  // первая иерархия - общий классификатор документов
  // ( другую иерархию нужно строить с другим системным номером )
  var curSysNum : word;
  curSysNum     := 0;
  CurFolderNum  := 0;

  //////////////////////////////////////////////////////////////////////////////
  // НПО "ЭНЕРГОМАШ"

  nod1 := AddFolder(curSysNum, comp(0), 'Прочие типы документов');
  //--------- L_KatParty##KatParty.vip ----
    AddLeaf(curSysNum, nod1, 789, 'Сертификат партии');
  //--------- Algoritm_6934.vip ----
    AddLeaf(curSysNum, nod1, 51103, 'Лист замен спецификация');
    AddLeaf(curSysNum, nod1, 51101, 'Лист замен');
  //----- #4641 L_SF##SchFactFunctions_Rus.Vip
    AddLeaf(curSysNum, nod1, 60963, 'Регистрационные номера СФ поставщика');
  //---   #964 GP_ActDrag.vip
    AddLeaf(curSysNum, nod1, 60964, 'Акт на изменение содержания драгметаллов');
  //-----  GP_ListAgreed.vip ---------------
    AddLeaf(curSysNum, nod1, 60965, 'Лист согласования');
    AddLeaf(curSysNum, nod1, 60966, 'Спецификация листа согласования');
} //procedure MakeKatDoc;
end.
