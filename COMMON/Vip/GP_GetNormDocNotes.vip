#include marker.vih

interface GP_GetNormDocNotes 'Выбор статусов' DoAccept, EscClose;
show (,,50, 15);
var pMarker: IMarker(marker) new;
create view 
var wSysNum, wDocType, typeState: word;
    cTemplate: comp;
    mSelected: TPtr;
as select * from 
  FormPl, KatNotes
where ((
        7                 == FormPl.TypeAlg and
        wSysNum           == FormPl.wSysNum and 
        wDocType          == FormPl.ResWord[1](NoIndex) and
        cTemplate         == FormPl.ResComp[1](NoIndex) and
        FormPl.ResComp[2] /== KatNotes.NRec
      ));
parameters typeState, wDocType, cTemplate, mSelected;

browse br1 (,,sci1EnEscInsPM);
table FormPl;
recMarker = pMarker {KatNotes.Nrec};
fields
  KatNotes.Name 'Наименование': [50], protect;
end;

handleEvent
    cmInit:
    {
        Case typeState of
          0: wSysNum := 65535;
          1: wSysNum := 65534;
        End;
        if GetMarkerCount(mSelected) > 0
        {
          var cRec: comp;
          GetMarker(mSelected, 0, cRec);
          if getfirst FormPl where ((
                                      7                 == FormPl.TypeAlg and
                                      wSysNum           == FormPl.wSysNum and 
                                      wDocType          == FormPl.ResWord[1](NoIndex) and
                                      cTemplate         == FormPl.ResComp[1](NoIndex) and
                                      cRec              == FormPl.ResComp[2](NoIndex)
                                    )) = tsOK {}
          if GetMarkerCount(mSelected) > 1
            pMarker.ImportFrom(mSelected);
        }
    }
    cmDefault:
    {
      if pMarker.Count = 0
        pMarker.MarkUnMark;
      pMarker.ExportTo(mSelected);
    }
end;
end.