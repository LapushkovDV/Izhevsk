VipInterface GP_EMAIL_SIGNSCOPE #Licensed_Free
parameters
 (
  pAllMemo :comp;
  sComment :string
 );
#doc

#end
Interface GP_EMAIL_SIGNSCOPE 'Ввод строки signature в RDP' , alwaysReturn ;
Show at (,,100,50);
var
 pAllMemo :comp;
 sComment :string;
Create view
as select AllMemo.Nrec
From AllMemo
where
(( pAllMemo == AllMemo.Nrec

))
;
Parameters pAllMemo, sComment;

Screen scrMain;
Show at (,,,2);
Fields
  [LbCom] 'Ввод строки signature в RDP' :skip;
Buttons
   cmOk,default,,'Отправить',hcObVedTimParam,sci1Esc;
<<
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@    <. Сохранить .>
>>
end;
Text AllMemo.MEM :NoProtect;
Show at (,3,,);

TableEvent Table AllMemo;
cmUpdateRecord:
{ update current AllMemo;
}
end;
HandleEvent
cmInit:
{ timelog_init;
  if getfirst AllMemo<>tsok
  { ClearBuffer(#AllMemo);
    pAllMemo:=GetNextNrec(tnAllMemo,0);
    AllMemo.Nrec:=pAllMemo;
    AllMemo.wTable:=30502;//coTuneVal;
    if Insert Current AllMemo=tsok
    { sComment:='Есть';
    }
    ReScanPanel(#AllMemo);
  }
}
cmDefault:
{ if True //IsValidAll(tnAllMemo)
  { if Update Current AllMemo=tsok {};
    sComment:='Есть'
  }
  else
  { sComment:='Нет';
  }

}
cmOk:
{ CloseInterface(cmDefault);

}
end;
end.
