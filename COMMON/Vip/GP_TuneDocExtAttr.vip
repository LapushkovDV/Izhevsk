#include Marker.vih
#include TypeTbl.inc
#include R_Disp.vih

interface GP_TuneDocExtAttr 'Настройка отображения внешних атрибутов документов' Gray;
show(10,1,170,30);

var pMarker:IMarker(Marker) new;
    iRARS:iRARSDisp;
    CopyWayAccou_NRec:comp;
    wPosFrom:word;

create view
var TypePlan:word;
    cWayAccou:comp;
as select
  WayAccou.Name
from
  WayAccou,
  GP_DocExtAttr, GP_DocExtAttr GP_DocExtAttr2,
  AttrNam
where((
  0==WayAccou.cWayAccou and 0==WayAccou.TypeAlgor and
  TypePlan==WayAccou.TypeObj and
  WayAccou.NRec==GP_DocExtAttr.cWayAccou and
  GP_DocExtAttr.cAttrNam==AttrNam.NRec
));

parameters TypePlan, cWayAccou;

browse brWayAccou (,,sci1EscIns);
show(,,70,);
table WayAccou;
recMarker=pMarker;
fields
  {font={bold=WayAccou.Act=1}};
  WayAccou.Name 'Наименование шаблона':[40],Protect;
end;

browse brDocExtAttr (,,sci178Esc);
show(71,,,);
table GP_DocExtAttr;
fields
  GP_DocExtAttr.Number '№':[3], Protect, NoAutoSize;
  GP_DocExtAttr.FrandlyName 'Наименование поля в документе':[40], NoProtect,
   {font={BackColor=if(Trim(GP_DocExtAttr.FrandlyName)='',ColorNeed,0)}};
  AttrNam.Name 'Наименование внешнего атрибута':[40], Protect, NoDel;
end;

procedure MovePos(wPosFrom, wPosTo:word);
{
  if (wPosTo=wPosFrom or wPosFrom=0 or wPosTo=0) exit;

  if (getfirst GP_DocExtAttr
      where((WayAccou.NRec==GP_DocExtAttr.cWayAccou and wPosFrom==GP_DocExtAttr.Number))<>tsok) exit;

  if (wPosTo>wPosFrom) //вниз
    update GP_DocExtAttr2
    where((WayAccou.NRec==GP_DocExtAttr2.cWayAccou and wPosFrom<<GP_DocExtAttr2.Number and wPosTo>>=GP_DocExtAttr2.Number)) set
      GP_DocExtAttr2.Number:=GP_DocExtAttr2.Number-1;
  else                 //вверх
    update GP_DocExtAttr2
    where((WayAccou.NRec==GP_DocExtAttr2.cWayAccou and wPosTo<<=GP_DocExtAttr2.Number and wPosFrom>>GP_DocExtAttr2.Number)) set
      GP_DocExtAttr2.Number:=GP_DocExtAttr2.Number+1;

  GP_DocExtAttr.Number:=wPosTo;
  update current GP_DocExtAttr;

  ReReadRecord(tnGP_DocExtAttr);
}

procedure DelPos(wPosFrom:word);
{
  update GP_DocExtAttr2
  where((WayAccou.NRec==GP_DocExtAttr2.cWayAccou and wPosFrom<<GP_DocExtAttr2.Number)) set
    GP_DocExtAttr2.Number:=GP_DocExtAttr2.Number-1;
}

TableEvent table GP_DocExtAttr;
cmCheckField:{
  if (CurField=#GP_DocExtAttr.FrandlyName)
    if (Trim(GP_DocExtAttr.FrandlyName)='') {
      message('Наименование поля не может быть пустым.',error);
      abort;
    }
}
cmUpdateRecord:{
  update current GP_DocExtAttr;
}
cmDeleteRecord:{
  wPosFrom:=GP_DocExtAttr.Number;

  if (delete current GP_DocExtAttr = tsok)
    DelPos(wPosFrom);

  wPosFrom:=0;
}
end;

function CopyDocExtAttr(cFrom, cTo:comp):boolean;
{
  if (cFrom=cTo) {
    result:=true;
    exit;
  }

  result:=delete GP_DocExtAttr2 where((cTo==GP_DocExtAttr2.cWayAccou)) = tsok;
  if (not result) exit;

  result:=
    insert into GP_DocExtAttr2(cWayAccou, Number, FrandlyName, cAttrNam)
    select cTo, Number, FrandlyName, cAttrNam
    from GP_DocExtAttr
    where((cFrom==GP_DocExtAttr.cWayAccou)) = tsok;
}

HandleEvent
cmInit:{
  if (not iRARS.IsAdminFunc()) {
    message('Программа доступна только пользователям с правами администратора.',error);
    abort;
    exit;
  }

  if (TypePlan=0)
    TypePlan:=toMnfZakaz;

  if (cWayAccou<>0)
    if ((getfirst WayAccou where(cWayAccou=WayAccou.NRec))=tsok) {};

  DisableCommand(cmRestoreDoc);

  DNDFieldAcceptDrag(brDocExtAttr,#GP_DocExtAttr.Number);
  DNDFieldAcceptDrag(brDocExtAttr,#GP_DocExtAttr.FrandlyName);
  DNDFieldAcceptDrag(brDocExtAttr,#AttrNam.Name);
  DNDFieldDropSource(brDocExtAttr,#GP_DocExtAttr.Number);
  DNDFieldDropSource(brDocExtAttr,#GP_DocExtAttr.FrandlyName);
  DNDFieldDropSource(brDocExtAttr,#AttrNam.Name);
}
cmInsert:{
  var cRec:comp = GP_DocExtAttr.cAttrNam;
  if (RunInterface(PickAttrNam, cRec, coMnPlan, cgiMulti)=cmDefault) {
    var m:TPtr = InitMarker('GetAttrName',8,0,1);
    var i, k:longint;
    k:=GetMarkerCount(m);
    for(i:=0;i<k;i++) {
      GetMarker(m, i, cRec);
      if (getfirst fastfirstrow GP_DocExtAttr2
          where((WayAccou.NRec==GP_DocExtAttr2.cWayAccou and cRec==GP_DocExtAttr2.cAttrNam))=tsok)
        continue;

      ClearBuffer(tnGP_DocExtAttr);
      GP_DocExtAttr.cWayAccou:=WayAccou.NRec;
      GP_DocExtAttr.cAttrNam:=cRec;
      if (getfirst AttrNam = tsok) {
        GP_DocExtAttr.FrandlyName:=AttrNam.Name;
        if ((getlast GP_DocExtAttr2
             where((WayAccou.NRec==GP_DocExtAttr2.cWayAccou)) ordered by GP_DocExtAttr2.Number)=tsok)
          GP_DocExtAttr.Number:=GP_DocExtAttr2.Number+1
        else
          GP_DocExtAttr.Number:=1;
        insert current GP_DocExtAttr;
      }
    }
    DoneMarker(m,'');
    ReReadRecord(tnGP_DocExtAttr);
  }
  stop;
}
cmDelete:{
  if (IsValidAll(tnGP_DocExtAttr))
    if (message('Удалить запись?',YesNo+Warning+mfSwapButtons)<>cmYes) stop;
}
cmHotKeys:{
  PutHotCommand(RunMenu('GP_TuneDocExtAttr_HotKeys'));
}
cmSaveDoc:{
  CopyWayAccou_NRec:=WayAccou.NRec;

  EnableCommand(cmRestoreDoc);
  message('Скопированы настройки отображения шаблона "'+WayAccou.Name+'".');
}
cmRestoreDoc:{
  if (CopyWayAccou_NRec=0) exit;

  if (message('Установить скопированные настройки отображения для '+
              if(pMarker.Count=0,'текущего шаблона','всех помеченных шаблонов')+'?'#13+
              chr(255)+chr(129)+'Текущие настройки будут удалены!'+chr(255)+chr(129),YesNo+Confirmation)<>cmYes) exit;

  if (pMarker.Count=0)
    CopyDocExtAttr(CopyWayAccou_NRec, WayAccou.NRec)
  else {
    StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Копирование настроек отображения...', pMarker.Count);

    SubBounds(tbRMWayAccou1);
    _loop pMarker {
      if (not NextVisual) break;

      if (not CopyDocExtAttr(CopyWayAccou_NRec, pMarker.pNRec))
        break;
    }//_loop pMarker
    AddBounds(tbRMWayAccou1);

    pMarker.UnselectAll;

    StopVisual;
  }

  ReReadRecord(tnGP_DocExtAttr);
}
cmQueryStartDrag:{
  case DNDCurField of
    #GP_DocExtAttr.Number,
    #GP_DocExtAttr.FrandlyName,
    #AttrNam.Name:{
      wPosFrom:=GP_DocExtAttr.Number;
      DNDSetDropEffect(DROPEFFECT_MOVE);
    }
  end;
}
cmDragEnter:{
  DNDSetDropEffect(DROPEFFECT_MOVE);
}
cmDragOver:{
  case DNDCurField of
    #GP_DocExtAttr.Number,
    #GP_DocExtAttr.FrandlyName,
    #AttrNam.Name:{
      DNDSetDropEffect(DROPEFFECT_MOVE);  // (это надо сделать, чтобы процесс не прервался).
    }
  end;
}
cmDrop:{
  case DNDCurField of
    #GP_DocExtAttr.Number,
    #GP_DocExtAttr.FrandlyName,
    #AttrNam.Name:{
      DNDSetDropEffect(DROPEFFECT_MOVE);
      MovePos(wPosFrom, GP_DocExtAttr.Number);
    }
  end;
}
cmAfterEndDrag:{
  wPosFrom:=0;
}
end;
end.

GP_TuneDocExtAttr_HotKeys Menu
{
  - 'Копировать настройки отображения',cmSaveDoc, 'Копировать настройки отображения',hcNoContext,'Ctrl+F2',kbCtrlF2,sci1Esc,,,, bmpCopyDoc;
  - 'Вставить настройки отображения', cmRestoreDoc,'Вставить настройки отображения',hcNoContext,'Ctrl+F3',kbCtrlF3,sci1Esc,,,, bmpPasteDoc;
}
