#include GP_UserFilterStoreUDR.vih

interface GP_UserFilterStoreUDR;

var cUDR:comp;
    CurVarName:string;
    IsPickRepExist, IsAddPickRExist:boolean;

create view
from
  PickRep, AddPickR
where((
  cUDR==PickRep.cUserDeskRep and CurVarName==PickRep.OwnName and rvMaxWord==PickRep.wList and
  PickRep.NRec==AddPickR.cPick
));

constructor Init;
{
  result:=false;
}

constructor InitUDR(cUserDeskRep:comp);
{
  cUDR:=cUserDeskRep;

  result:=cUDR<>0;
}

procedure SavePickRep;
{
  if (IsPickRepExist) {
    if (update current PickRep <> tsok)
      message('Ошибка модификации записи в таблице PickRep.', error);
  } else {
    PickRep.NRec:=0;
    PickRep.cUserDeskRep:=cUDR;
    PickRep.OwnName:=CurVarName;
    PickRep.wList:=rvMaxWord;
    if (insert current PickRep <> tsok)
      message('Ошибка вставки записи в таблицу PickRep.', error);
  }
}

procedure SaveAddPickR;
{
  if (IsAddPickRExist) {
    if (update current AddPickR <> tsok)
      message('Ошибка модификации записи в таблице AddPickR.', error);
  } else {
    AddPickR.NRec:=0;
    AddPickR.cPick:=PickRep.NRec;
    if (insert current AddPickR <> tsok)
      message('Ошибка вставки записи в таблицу AddPickR.', error);
  }
}

function LoadDouble(NameVar:string):double;
{
  result:=0;
  CurVarName:=NameVar;

  if (getfirst PickRep = tsok)
    result:=PickRep.PickKol;
}

procedure SaveDouble(doVal:double;NameVar:string);
{
  CurVarName:=NameVar;
  IsPickRepExist:=getfirst PickRep = tsok;

  PickRep.PickKol:=doVal;
  SavePickRep;
}

function LoadString(NameVar:string):string;
{
  result:='';
  CurVarName:=NameVar;

  if (getfirst PickRep = tsok)
    if (getfirst AddPickR = tsok)
      result:=AddPickR.AdditionalInfo;
}

procedure SaveString(sVal:string;NameVar:string);
{
  CurVarName:=NameVar;
  IsPickRepExist:=getfirst PickRep = tsok;

  if (not IsPickRepExist)
    SavePickRep;

  IsAddPickRExist:=getfirst AddPickR = tsok;

  AddPickR.AdditionalInfo:=sVal;
  SaveAddPickR;
}

function LoadComp(NameVar:string):comp;
{
  result:=0;
  CurVarName:=NameVar;

  if (getfirst PickRep = tsok)
    result:=PickRep.cRec;
}

procedure SaveComp(cVal:comp;NameVar:string);
{
  CurVarName:=NameVar;
  IsPickRepExist:=getfirst PickRep = tsok;

  PickRep.cRec:=cVal;
  SavePickRep;
}

function LoadDate(NameVar:string):date;
{
  result:=date(0,0,0);
  CurVarName:=NameVar;

  if (getfirst PickRep = tsok)
    result:=PickRep.LastDate;
}

procedure SaveDate(Dat:date;NameVar:string);
{
  CurVarName:=NameVar;
  IsPickRepExist:=getfirst PickRep = tsok;

  PickRep.LastDate:=Dat;
  SavePickRep;
}

function LoadMarker(NameMarker:string):longint;
{
  result:=InitMarker('',8,0,1);

  CurVarName:=NameMarker;
  _loop PickRep
    InsertMarker(result, PickRep.cRec);
}

procedure SaveMarker(hMarker:longint;NameMarker:string);
var i, k:longint;
    cRec:comp;
{
  CurVarName:=NameMarker;

  if (delete safe PickRep <> tsok) {
    message('Ошибка удаления записи в таблице PickRep.', error);
    exit;
  }

  IsPickRepExist:=false;

  k:=GetMarkerCount(hMarker);
  for(i:=0;i<k;i++)
    if (GetMarker(hMarker, i, cRec)) {
      PickRep.cRec:=cRec;
      SavePickRep;
    }
}

property cUserDeskRep:comp absolute cUDR;

end.
