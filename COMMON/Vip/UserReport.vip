#include GP_UserReportAccessService.vih

#component "F_UserReport"
alter interface UserReport;
overload
  function AddGroup(GroupName: string; cParent : comp) : comp;
  function AddReport(ReportName, InterfaceName : string; Priority : integer; cParent : comp) : comp;
end;

var oAccessService:GP_UserReportAccessService;

function AddGroup(GroupName: string; cParent : comp) : comp;
{
  if (oAccessService.IsRepAllow(VipFullName(UserReport)))
    result:=inherited::AddGroup(GroupName, cParent)
  else
    result:=0;
}

function AddReport(ReportName, InterfaceName : string; Priority : integer; cParent : comp) : comp;
{
  if (oAccessService.IsRepAllow(InterfaceName))
    result:=inherited::AddReport(ReportName, InterfaceName, Priority, cParent)
  else
    result:=0;
}

HandleEvent
cmHotKeys:{
  var MenuID:longint=LoadMenu('UserReport_HotKeys');
  if (pr_CurUserAdmin and ReportList.InterfaceName<>'') {
    AddMenuItem(MenuID,'separator',1);
    AddMenuItem(MenuID, 'Настройка доступа', cmValue10);
  }
  PutHotCommand(RunLoadMenu(MenuID));
}
cmValue10:{
  RunInterface(GP_Common::GP_UserReportAccessEdit,ReportList.InterfaceName);
}
end;

end.
