#include GP_UserFilterDouble.vih

#component "GP_Common"

#include GP_UserFilterDoubleEditView.vih
interface GP_UserFilterDoubleEditView;

var
  _userFilter: GP_UserFilterDouble noauto;
  _caption: string;

create view;

screen scUserFilter (,,sci13Esc);
fields
  _caption: skip;
  [MatchFld] _userFilter.Match: [List '=    Равно',
                                      '<    Меньше',
                                      '<=   Меньше или равно',
                                      '>    Больше',
                                      '>=   Больше или равно',
                                      '[..] Между'];
  [SumFld]  _userFilter.Sum:  [16.2], noprotect;
  [Sum2Fld] _userFilter.Sum2: [16.2], noprotect;
<<
.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 .@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@ `и` .@@@@@@@@@@
>>
end;

procedure SetFieldsVisiblity;
{
  if _userFilter.Match != GP_UserFilterDouble_Match_Between
  {
    ClearFieldState(#Sum2Fld, sfVisible);
    HideLabel4Field(#Sum2Fld);
  }
  else
  {
    SetFieldState(#Sum2Fld, sfVisible);
    ShowLabel4Field(#Sum2Fld);
  }
}

handleevent
  cmDefault: OnCmDefault;
  cmCheckField:
  {
    case curfield of
      #MatchFld: SetFieldsVisiblity;
    end;
  }
end;

constructor Init;
{
  result := false;
}

constructor UserFilterDoubleEditView(aUserFilter: GP_UserFilterDouble; aCaption: string = '');
{
  _userFilter := aUserFilter;
  Caption     := aCaption;
  result      := _userFilter != nullref;
  SetFieldsVisiblity;
}

property UserFilter: GP_UserFilterDouble read _userFilter;
property Caption: string absolute _caption;

end.
