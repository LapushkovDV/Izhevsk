#include GP_UserFilterPeriod.vih
#include DateInterim.vih

#component "GP_Common"

#include GP_UserFilterPeriodEditView.vih
interface GP_UserFilterPeriodEditView;

var
  _userFilter: GP_UserFilterPeriod noauto;
  _caption: string;
  _dateInterim: DateInterimInterval new;

create view;

screen scUserFilter;
fields
  _caption: skip;
  _userFilter.DateBeg: noprotect;
  _userFilter.DateEnd: noprotect;
buttons
  cmSetPeriod, [singleLine];
<<
.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`с`.@@@@@@@@@@ `по`.@@@@@@@@@@ <. Установка периода .>
>>
end;

handleevent
  cmSetPeriod:
  {
    _dateInterim.SetHiddenFields(DIF_TIME);
    _dateInterim.BegDate := _userFilter.DateBeg;
    _dateInterim.EndDate := _userFilter.DateEnd;
    if _dateInterim.SelectDateInterim = cmOk
    {
      _userFilter.DateBeg := _dateInterim.BegDate;
      _userFilter.DateEnd := _dateInterim.EndDate;
    }
  }
  cmDefault:
  {
    OnCmDefault;
  }
end;

constructor Init;
{
  result := false;
}


constructor UserFilterPeriodEditView(aUserFilter: GP_UserFilterPeriod; aCaption: string = '');
{
  _userFilter := aUserFilter;
  Caption     := aCaption;
  result      := _userFilter != nullref;
}

property UserFilter: GP_UserFilterPeriod read _userFilter;
property Caption: string absolute _caption;

end.
