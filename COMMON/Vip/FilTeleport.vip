/*************************************************************************************************\
* Наименование: Подменялка настроек для ФЛ                                                        *
* Контур/Модуль: common                                                                           *
* Вид работы  |Номер           |Дата    |Исполнитель              |Проект                         *
*  -----------------------------------------------------------------------------------------------*
* Разработка  |#NaN            |15/12/22|kurennykh                |НПО Энергомаш                  *
\*************************************************************************************************/

Interface FilTeleport 'Перемещение в другой ФЛ';
Show(5,1,50,6);

Create View
var
  _wF : word = 0;
as
select 1 from GrDescr, KatPodr;

Screen scr1 'Перемещение в другой ФЛ' (,,sci13Esc);
Show at (,,,);
Fields
  _wF : noProtect, NoFrame;
Buttons
  cmOk,,, 'Телепортироваться',,sci1Esc;
<<
 `Переместить меня `  (.) на Энергомаш (01)`
                      (.) в Камский ФЛ (702)`
                      (.) в Приволжский ФЛ (719)`

                      <.    Ок    .>
>>
End;

Function SetTunes(_s : string) : boolean;
{
  result := false;
  if (getFirst FastFirstRow KatPodr where ((_s == KatPodr.Kod)) = tsOk) then
  {
    if (getFirst FastFirstRoW GrDescr where ((_s == GrDescr.DesGr)) = tsOk) then
    {
       sSetTune('USER.DESGR', GrDescr.DesGr);
      coSetTune('TPROV.CURFILIALASKATPODR', KatPodr.nRec, KatPodr.Kod);
      result := true;
    }
    else
    {
      Message('Не найдена группа дескрипторов с кодом "' + _s + '"', Error);
    }
  }
  else
  {
    Message('Не найдено подразделение с кодом "' + _s + '"', Error);
  }
}

HandleEvent
  cmOk :
  {
    var _b : boolean;
    Case _wF of
      0 : {
        _b := SetTunes('01');
      }
      1 : {
        _b := SetTunes('702');
      }
      2 : {
        _b := SetTunes('719');
      }
    End;

    if (_b) then
    {
      Message('Настройки изменены');
    }
    else
    {
      Message('Настройки не изменены', Error);
    }
  }
End;

End.
