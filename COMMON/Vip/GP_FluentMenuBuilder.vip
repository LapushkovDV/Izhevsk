#include GP_MenuDynamic.vih
#include GP_FluentMenuBuilder.vih
#include AtlProtocol.vih
#component "GP_Common"
interface GP_FluentMenuBuilder;
var name: string;
    menuId: longint;
    atlLog: IAtlProtocol;

constructor Init;
{
  Result := false;
}

constructor Load(menuName: string; iAtlLog: IAtlProtocol; title: string = '');
var txt: string;
{
  atlLog := iAtlLog;
  atlLog.LogMessage(APE_INFO, 'Внесение изменеий в ' + title + '(' + menuName + ')');
  name := menuName;
  txt := 'Загрузка меню ' + menuName;
  _try
  {
    menuId := 0;
    DeleteMenuHowDynamics(name);
    menuId := LoadMenuEx(name, false, false);
    Result := menuId <> 0;
    timelog('GP_FluentMenuBuilder. ' + txt + if(Result, ': успешно', ': неудачно'));
  }
  _except else
    txt += ' ' + ExploreException;
  _finally
  {
    atlLog.LogLine(if(Result, APE_INFO, APE_ERROR), txt);
    Result := true;//объект создаем всегда
  }
}

function Concat(menuName: String): GP_oFluentMenuBuilder;
var subMenu: longint;
    f: boolean;
    txt: string;
{
  Result := GP_oFluentMenuBuilder(Self);
  if menuId = 0
    exit;
  f := false;
  txt := 'Добавление меню ' + menuName;
  timelog('GP_FluentMenuBuilder. ' + txt);
  _try
  {
    subMenu := LoadMenu(menuName);
    f := ConcatMenu(menuId, subMenu);
  }
  _except else
    txt += ' ' + ExploreException;
  _finally
    atlLog.LogLine(if(f, APE_INFO, APE_ERROR),  txt);
}

function AddSeparator: GP_oFluentMenuBuilder;
var f: boolean;
    txt: string;
{
  Result := GP_oFluentMenuBuilder(Self);
  if menuId = 0
    exit;
  f := false;
  txt := 'Добавление разделителя';
  timelog('GP_FluentMenuBuilder. ' + txt);
  _try
  {
    f := AddMenuItem(menuId, 'SEPARATOR', 0);
  }
  _except else
    txt += ' ' + ExploreException;
  _finally
    atlLog.LogLine(if(f, APE_INFO, APE_ERROR), txt);
}

function AddSubMenu(menuName, title: string; fndName: string = ''; fndCommand: word = 0; addFlags: word = 0): GP_oFluentMenuBuilder;
var f: boolean;
    txt: string;
{
  Result := GP_oFluentMenuBuilder(Self);
  if menuId = 0
    exit;
  f := false;
  txt := 'Добавление подменю "' + title + '" (' + menuName + ')';
  timelog('GP_FluentMenuBuilder. ' + txt);
  _try
  {
    f := AddSubMenuDynamicEx(menuId, menuName, title, '', hcNoContext, fndName, fndCommand, addFlags);
  }
  _except else
    txt += ' ' + ExploreException;
  _finally
    atlLog.LogLine(if(f, APE_INFO, APE_ERROR), txt);
}

function AddItem(itemName: string; command: word; keyCode: word = 0; helpLine: string = ''; commandParams: string = ''): GP_oFluentMenuBuilder;
var f: boolean;
    txt: string;
{
  Result := GP_oFluentMenuBuilder(Self);
  if menuId = 0
    exit;
  f := false;
  txt := 'Добавление пункта меню "' + itemName + '"';
  timelog('GP_FluentMenuBuilder. ' + txt);
  _try
  {
    f := AddMenuItemEx2(menuId, itemName, helpLine, hcNoContext, command, keyCode, commandParams);
  }
  _except else
    txt += ' ' + ExploreException;
  _finally
    atlLog.LogLine(if(f, APE_INFO, APE_ERROR), txt);
}

function DelItem(itemName: string; command: word; commandParams: string = ''): GP_oFluentMenuBuilder;
var f: boolean;
    txt: string;
{
  Result := GP_oFluentMenuBuilder(Self);
  if menuId = 0
    exit;
  f := false;
  txt := 'Удаление пункта меню "' + itemName + '"';
  timelog('GP_FluentMenuBuilder. ' + txt);
  _try
  {
    f := DelMenuItem(menuID, itemName, command, commandParams);
  }
  _except else
    txt += ' ' + ExploreException;
  _finally
    atlLog.LogLine(if(f, APE_INFO, APE_ERROR), txt);
}

function AddItemToSubMenu(subMenuTitle, newItemTitle: string; newItemCommand: longint): GP_oFluentMenuBuilder;
var f: boolean;
    txt: string;
{
  Result := GP_oFluentMenuBuilder(Self);
  if menuId = 0
    exit;
  f := false;
  txt := 'Добавление пункта меню "' + newItemTitle + '" в подменю к "' + subMenuTitle + '"';
  timelog('GP_FluentMenuBuilder. ' + txt);
  _try
  {
    var iFace: GP_MenuDynamic;
    f := iFace.AddItemToSubMenu(menuId, subMenuTitle, newItemTitle, newItemCommand);
  }
  _finally
    atlLog.LogLine(if(f, APE_INFO, APE_ERROR), txt);
}

function Store: boolean;
var txt: string;
{
  Result := false;
  if menuId = 0
  {
    name := '';
    atlLog.LogCommit;
    exit;
  }
  txt := 'Сохранение меню ' + name;
  timelog('GP_FluentMenuBuilder. ' + txt);
  _try
  {
    Result := StoreMenuHowDynamics(menuId, name);
  }
  _except else
    txt += ' ' + ExploreException;
  _finally
  {
    if menuId <> 0
    _try
      DisposeLoadMenu(menuId);
    _except else {}
    atlLog.LogLine(if(Result, APE_INFO, APE_ERROR), txt);
    name := '';
    atlLog.LogCommit;
  }
}
end.