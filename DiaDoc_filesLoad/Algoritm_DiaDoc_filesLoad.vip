#include TMnPlan.vih
#include Algor.vih
#include StatLog.vih
#include FILESREF_File_hRef.Vih
#component "M_MnPlan"


//#include SaldoFuncs.vih

//***********************************
VipInterface Algoritm_DiaDoc_filesLoad Implements oAlgoritm_Sys;
//***********************************
#doc
Алгоритм для прикрепления файлов
#end
Interface Algoritm_DiaDoc_filesLoad;
//***********************************
Var
 _TypeCpNrec : word;
 _cpNrec     : comp;
Create view
Var
 nrecFormPl    : Comp;//Настройка алгоритма

As Select
 FormPl.nrec
From
   FormPl
   , DiaDocument
Where
((
       nrecFormPl == FormPl.NRec
))
;

file _fdia;
//-------------------------
//Номер системного алгоритма
Function GetNum: Word;
{ Result := 4555;
} //Function GetNum: Word;


//-------------------------
Function GetName: String;
{ Result := 'Прикрепление файлов';
}; //Function GetName: String;


//-------------------------
Function GetMemo(st: oSteckCommonString): Boolean;
{ Result := True;
  st.Push(GetName);
  st.Push('   загрузка списка файлов, полученных из DIADOC');
  st.Push('   Используется FILESREF_File_hRef и WEB API по хранению файлов');
  st.Push('   Адрес API задается в настройке ' + gettunename('FILESREF.HREF_PATHAPI'));
}; //Function GetMemo(st: oSteckCommonString): Boolean;


//-------------------------
Function GetNameInter: String;
{ Result := 'Algoritm_DiaDoc_filesLoad';
} //Function GetNameInter: String;


//-------------------------
Function GetNameInterPr: String;
{ Result := 'Algoritm_DiaDoc_filesLoad';
} //Function GetNameInterPr: String;


//-------------------------
Function InitInter(Var pt: TRecAcc): Boolean;
{ #__UNUSED__(pt)
  Result := True;
} //Function InitInter(Var pt: TRecAcc): Boolean;



//Запуск алгоритма
Function RunInter(wflag: Word; Var pt: TRecAcc): Boolean;
//var isAllOk:boolean;
{ #__UNUSED__(wflag,pt)

  Result  := false;

  set nrecFormPl := pt.cFormPl;
  if getfirst FormPl <> tsOK
   {
         message('Не найдена настройка алгоритма ' + string(nrecFormPl,0,0), error);
         pt.Binding:=8;
     exit;
   }
  _TypeCpNrec := pt.TypeCpNrec;
  _cpNrec     := pt.cpNrec;

  logstrtofile('c:\debug\DiaDoc_filesLoad.log','===================Begin=====================');
  logstrtofile('c:\debug\DiaDoc_filesLoad.log','_TypeCpNrec='+_TypeCpNrec+'; _cpNrec='+_cpNrec);

   var pFILESREF_File_hRef : FILESREF_File_hRef;
    if (NullVipRef(pFILESREF_File_hRef))
    _try {
        if (not LoadVipRef(pFILESREF_File_hRef, 'C_FILESREF::FILESREF_File_hRef')) {
         message('Не удалось загрузить C_FILESREF::FILESREF_File_hRef',error);
        }
     }
/*    _except
      on ExPathNotFound: Message('1. Нормально (Исключение ExPathNotFound)',0);
      on ExFile        : Message('НЕ ДОЛЖНО БЫТЬ (Исключение ExFile) 1',0);
*/
    _except else{}
//      on ExObjIfcBadVar : message('переменная не является ссылкой на VIP-интерфейс.');
//      on ExObjIfcNoLoad : message('невозможно загрузить интерфейс.');
//      on ExObjIfcNoImpl : message('VIP-интерфейс не реализует нужный OBJ-интерфейс.');

    _finally {};

  logstrtofile('c:\debug\DiaDoc_filesLoad.log','Step 1');

//      pFILESREF_File_hRef.EnableTimeLog;

    var _wTable: word = 0;
    if _cpNrec > 2000 then {
      _wTable := coKATSOPR; //_cpNrec - 2000
      } else {
         if _cpNrec > 1000 then _wTable := coBASEDOC; //_cpNrec - 1000
      }

  logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set wtable='+_wTable);

    var _cDiadocument : comp = 0h;

     if _wTable <> 0 {
     var _SMYBOXID : string = sGetTune('Diadoc.MyBox_ID');
     logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set _SMYBOXID='+_SMYBOXID);

      if getfirst DiaDocument where (( //_SMYBOXID == DiaDocument.SMYBOXID
                                        _wTable == DiaDocument.wTable
                                    and _cpNrec == DiaDocument.cDoc)) = tsOK {
           _cDiadocument := DiaDocument.nrec;
            logstrtofile('c:\debug\DiaDoc_filesLoad.log','set first getfirst DiaDocument');
          }
     } else {
      if getfirst DiaDocument where ((_cpNrec == DiaDocument.nrec)) = tsOK {
           _cDiadocument := DiaDocument.nrec
            logstrtofile('c:\debug\DiaDoc_filesLoad.log','set second getfirst DiaDocument');
          }
      _wTable := coDIADOCUMENT;
     }


  logstrtofile('c:\debug\DiaDoc_filesLoad.log','reSet _cDiadocument='+_cDiadocument+';wtable='+_wTable);

     if _cDiadocument = 0h then  {
       logstrtofile('c:\debug\DiaDoc_filesLoad.log','_cDiadocument = 0h это плохо');
       pt.Binding := 8;
       exit;
     }

     var _zipFilePath : string = sGetAttr(coDIADOCUMENT, _cDiadocument, 'Пакет Документов'); // 25056

  logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set _zipFilePath='+_zipFilePath);

     if _zipFilePath = '' {
       pt.Binding := 8;
       exit;
     }


     var lResp: TPtr = 0;
     var _zpath_srv: string ='';
     var _listf  : string='';

     _listf:=GetStringParameter('Files','OutputFilesDirectory',0)+'diadoc_list.log';
     logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set _listf='+_listf);

     _zpath_srv:=ConvertClientPathtoSrv(_zipFilePath);
     logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set _zpath_srv='+_zpath_srv);

     GetFIleFromClient(_zipFilePath,false);
     var m_service : tptr =  HttpConnect_CreateEx('https://ya.ru','','',true);

     lResp := HttpConnect_UnZipFileAll(m_service,_zpath_srv, False );
     if (HttpConnect_SaveToFileEx(m_service,lResp, _listf,cpUTF8, false))
        logstrtofile('c:\debug\DiaDoc_filesLoad.log','HttpConnect_SaveToFileEx=True')
     else
        logstrtofile('c:\debug\DiaDoc_filesLoad.log','HttpConnect_SaveToFileEx=False');

     PutFileToClient(_listf,false);

     logstrtofile('c:\debug\DiaDoc_filesLoad.log','llllllll='+String(HttpConnect_GetLongStringLength(m_service, lResp)));
      var _filesPath : widestring[60000];

        if (lResp <> 0) {
          var _str : string = '';
          var _lPosB, _LPosE : longint;
          _lPosB :=0; _LPosE:= 254;
          DO {
            _str := HttpConnect_GetLongStringSubString(m_service, lResp, _lPosB, _lPosE);
//            logstrtofile('c:\debug\DiaDoc_filesLoad.log','_str='+_str);
            if _str = ''
              Break;

            _lPosB +=254;
            _lPosE +=254;
            _filesPath += _str;
//             logstrtofile('c:\debug\DiaDoc_filesLoad.log','in Do_While Set _filesPath='+_filesPath);
          } WHILE _lPosB < 60000;
        }

      logstrtofile('c:\debug\DiaDoc_filesLoad.log','len _filesPath='+length(_filesPath));
      logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set _filesPath='+_filesPath);
       var fh : tPtr;

       fh:=CreateFileHandle(_listf);
       file_OpenFile(_listf,StCreate,fh);


      var _curPos : word = 1;
      var _oneFile : string ='';

      _filesPath:=Replace(_filesPath,chr(10),'');
      _filesPath:=Replace(_filesPath,chr(13),'');

      logstrtofile('c:\debug\DiaDoc_filesLoad.log','Replace Set _filesPath='+_filesPath);

!      while (not File_EOF(fh)){
       while true {
!         File_Readln( _oneFile,fh);
!         _oneFile:=Replace( _oneFile,';','');

        if pos(';',_filesPath) = 0 then break;
        var _oneFile : string = substr(_filesPath,_curPos,instr(';',_filesPath)-1);
        logstrtofile('c:\debug\DiaDoc_filesLoad.log','  pos='+string(instr(';',_filesPath))+'|_curpos='+string(_curpos));
        logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set _oneFile='+_oneFile);
//        logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set _oneFile='+);

            pFILESREF_File_hRef.Add_File( _wTable// код таблицы
                                         ,_cpNrec         // выбранная запись
                                         ,_oneFile       // путь на файл
                                         ,'загружено из DIADOC' // текстовое описание
                                        );
        //_curPos := instr(';',_filesPath)+1;
        _filesPath := substr(_filesPath,instr(';',_filesPath)+1,60000);
        logstrtofile('c:\debug\DiaDoc_filesLoad.log','ReSet _filesPath='+_filesPath);
      }
      logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set Second_filesPath='+_filesPath);

      if _filesPath <> '' {
        var _oneFile : string = substr(_filesPath,1,255);
        logstrtofile('c:\debug\DiaDoc_filesLoad.log','Set second _oneFile='+_oneFile);

            pFILESREF_File_hRef.Add_File( _wTable// код таблицы
                                         ,_cpNrec         // выбранная запись
                                         ,_oneFile       // путь на файл
                                         ,'загружено из DIADOC' // текстовое описание
                                        );
       }

} //Function RunInter(wflag: Word; Var pt: TRecAcc): Boolean;

End.
