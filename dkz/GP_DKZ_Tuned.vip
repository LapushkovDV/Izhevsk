HandleEvent
  cmInit:
  {
    cfsSetProp('cb_SJORNTUNE_JORNTUNE.WDAYMONTH', cfpFrame, false);
    cfsSetProp('cb_SJORNTUNE_JORNTUNE.WPARAM', cfpFrame, false);
    cfsSetProp('cb_SJORNTUNE_JORNTUNE.WGETDATA', cfpFrame, false);
    if not InitCurrentTune
    {
      Abort;
      Exit;
    }
    PushBounds(tbByTip1);
    tip_flt:=1;
  }
  cmPick :
    MyPick;


  cmOpenSearch :
  {
    MyPick;
    Stop;
  }
  cmDone :
  {
    if not SaveCurrentTune(true)
    {
     // message('1111');
      Abort;
      Exit;
    }
  }
  cmHotKeys : {
    if (CurTable = #JornTune)
      ProcessCommand(cmHotKeys);
  }
  cmSaveDoc : {
    if (CurTable = #JornTune)
      ProcessCommand(cmSaveDoc);
  }
  cmRestoreDoc : {
    if (CurTable = #JornTune)
      ProcessCommand(cmRestoreDoc);
  }
  cmAlt1: if #IsBetaTester RunWindow(wiTesterTune);
  cmChangeTabbedSheetFormat:
  { //timelog('GP_DKZ_Tuned->wiTune->cmChangeTabbedSheetFormat');

    UpdateTableWithInserted;
    //if BoundActive(tbByTip0) then {PopBounds(tbByTip0);PushBounds(tbByTip1);}
    //                         else {PopBounds(tbByTip1);PushBounds(tbByTip0);}
    case Target of
    brSpJorno :
    { PushBounds(tbByTip1);
      tip_flt:=1;
    }
    brSpJornHS:
    { PushBounds(tbByTip0);
      tip_flt:=0;
    }
    brSpJornR :
    { PushBounds(tbByTip2);
      tip_flt:=2;
    }
    brSpJornIN:
    { PushBounds(tbByTip3);
      tip_flt:=3;
    }
    end;
    if getfirst mt_JoTune = tsok then {}
     RescanPanel(#mt_JoTune);
  }
end; // handleevent window wiTune
end; // window wiTune
