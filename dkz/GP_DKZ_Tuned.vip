TableEvent table mt_JoTune;
  cmInsertRecord :
    If(insert current mt_JoTune = TsOk){}

  cmUpdateRecord :
    If(update current mt_JoTune = TsOk){}
  cmDeleteRecord : //удалить можно запись только целиком, т.к должны быть заданы и дебет и кредит
    if (Message('Удалить настройку?',YesNo) = cmYes) {
      If(delete current mt_JoTune = TsOk){}
  }
  cmSetDefault:
  { ClearBuffer(#mt_JoTune);
    set mt_JoTune.Tip:=Tip_flt;
  }
  cmCheckRecord:
  {
    if not CheckRec
    { Abort;Exit; }
  }
  cmPick:
  {
    case (CurField) of
      #DlgKauO:
      {
        if not iXGetKau.PickKauBuh(cgiPick, 0, mt_JoTune.SchetO, mt_JoTune.SubSchO, mt_JoTune.TblO, mt_JoTune.KauO)
          exit;
        set mt_JoTune.KauO := mt_JoTune.KauO;
      }
      #DlgKauK:
      {
        if not iXGetKau.PickKauBuh(cgiPick, 0, mt_JoTune.SchetK, mt_JoTune.SubSchK, mt_JoTune.TblK, mt_JoTune.KauK)
          exit;
        set mt_JoTune.KauK := mt_JoTune.KauK;
      }
    end;
  //  ReReadRecord;
  }
  cmOpenSearch :
  {
    PutCommand(cmPick);
    Stop;
  }
  cmDelOnProtect :
  {
    case (CurField) of
      #mt_JoTune.SubSchO :
      {
        set mt_JoTune.SubSchO := cgDefSub;
        #DelKau(O);
      }
      #mt_JoTune.SubSchK :
      {
        set mt_JoTune.SubSchK := cgDefSub;
        #DelKau(K);
      }
      #DlgKauO:
      {
        #DelKau(O);
      }
      #DlgKauK:
      {
        #DelKau(K);
      }
    end; // case
//    ReReadRecord;
  }

end; // tableEvent panel pSpJornHS*/

// формируем список доступных уровней аналитики для указания детализации вывода
procedure TuneExcelLevel;
{
  var Items  : array[0..5] of string[80];
  var iLimit : integer;

  iLimit := 0;

  if JornTune.TblOs[1] > 0 and (not IsGroupBitOnKau(1))
  {  Items[iLimit] := GetAnalitikName(JornTune.TblOs[1]);    iLimit++; }
  if JornTune.TblOs[2] > 0 and (not IsGroupBitOnKau(2))
  {  Items[iLimit] := GetAnalitikName(JornTune.TblOs[2]);    iLimit++; }
  if JornTune.TblOs[3] > 0 and (not IsGroupBitOnKau(3))
  {  Items[iLimit] := GetAnalitikName(JornTune.TblOs[3]);    iLimit++; }
  if JornTune.TblOs[4] > 0 and (not IsGroupBitOnKau(4))
  {  Items[iLimit] := GetAnalitikName(JornTune.TblOs[4]);    iLimit++; }
  if JornTune.TblOs[5] > 0 and (not IsGroupBitOnKau(5))
  {  Items[iLimit] := GetAnalitikName(JornTune.TblOs[5]);    iLimit++; }
  if JornTune.TblOs[6] > 0 and (not IsGroupBitOnKau(6))
  {  Items[iLimit] := GetAnalitikName(JornTune.TblOs[6]);    iLimit++; }

  if DlgExcelLevel > (iLimit - 1)
    DlgExcelLevel := 0;
  SetLimit(Items,iLimit);
  SetEnumList(sJornTune,#DlgExcelLevel,Items);
} //procedure TuneExcelLevel;

//=======================================
// Заполнение таблицы с настройками
//=======================================
procedure FillMtRecord(_viob: word);
var ts:string;
{
  case _viob of
    1:
    {
      mt_JoTune.SchetK   :=  SpJornHO.SCHET;
      mt_JoTune.SubSchK  :=  SpJornHO.SUBOSSCH;
      mt_JoTune.KrSchetK :=  SpJornHO.DbSchet;
      mt_JoTune.TblK     :=  SpJornHO.TblOS;
      mt_JoTune.KauK     :=  SpJornHO.KauOS;
      mt_JoTune.wParam   :=  SpJornHO.SeeSchet;
    }
    //0:
    else
    {
      mt_JoTune.SchetO   :=  SpJornHO.SCHET;
      mt_JoTune.SubSchO  :=  SpJornHO.SUBOSSCH;
      mt_JoTune.DbSchetO :=  SpJornHO.DbSchet;
      mt_JoTune.TblO     :=  SpJornHO.TblOS;
      mt_JoTune.KauO     :=  SpJornHO.KauOS;
    }

  end;
 //  SpJorn.SeeSchet := mt_JoTune.wParam + mt_JoTune.DKZ*10 + mt_JoTune.tip*100;
   ts:=LPadCh(string(SpJornHO.SeeSchet), '0', 3);
   mt_JoTune.wParam  := word(SubStr(ts,3,1));
   mt_JoTune.DKZ     := word(SubStr(ts,2,1));
   mt_JoTune.tip     := word(SubStr(ts,1,1));// поле с фильтрацией типа
} //procedure FillMtRecord(viob: word);

//-------------------------------------------------------------------------------
//
procedure FindOtherPart(num:word; _viob: word);
{
  mt_JoTune.NRec := SpJornHO.wParam;
  FillMtRecord(_viob);
  PushPos(#SpJornHO);
  ResetBounds(#SpJornHO);
  _loop SpJornHO where ((JornTune.Nrec == SpJornHO.cJornTune and num == SpJornHO.wParam(NoIndex)))
  {
      if  SpJornHO.Viob <> _viob
        FillMtRecord(SpJornHO.Viob);
  }
  SetBounds(#SpJornHO);
  PopPos(#SpJornHO);
} //procedure FindOtherPart(num:word; _viob: word);


//-------------------------------------------------------------------------------
// Импорт настроек
//-------------------------------------------------------------------------------
function ImportTunesToMt: boolean;
{
  ImportTunesToMt := false;
  if JornTune.TipJorn = joDKZ
  {
    delete all mt_JoTune;
    ResetBounds(#SpJornHO);
    PushBounds(tbBySecond);
    _loop SpJornHO
    {
      if (RecordExists mt_JoTune where ((SpJornHO.wParam == mt_JoTune.NRec(NoIndex))) <> tsOk)
      {
        FindOtherPart(SpJornHO.wParam, SpJornHO.Viob);
        insert current mt_JoTune;
      }
    }
    PopBounds(tbBySecond);
    SetBounds(#SpJornHO);
    ReScanPanel(#mt_JoTune);
  }
  ImportTunesToMt := true;
} //function ImportTunesToMt: boolean;

//---------------------------
// Запоминание настроек
//---------------------------
procedure ExportTunesFromMt;
var num: word;
    tb:word;
{
  //удаляем все из SpJorn, т.к. в интерфейсе работаем только с mt_JoTune
  delete SpJorn where ((cJorn == SpJorn.cJornTune and  (0 <> SpJorn.wParam)  ));
  tb:=0;
  if BoundActive(tbbyTip0) then tb:=0;// else tb:=1;
  if BoundActive(tbbyTip1) then tb:=1;
  if BoundActive(tbbyTip2) then tb:=2;
  if BoundActive(tbbyTip3) then tb:=3;
  Tip_Flt:=tb;
  ResetBounds(tnmt_JoTune);

  _loop mt_JoTune
  {
    num := mt_JoTune.NRec + 1;
    if (RecordExists SpJorn where ((cJorn == SpJorn.cJornTune and num == SpJorn.wParam(NoIndex) )) = tsOk)
    {
      _loop SpJorn where ((cJorn == SpJorn.cJornTune and num == SpJorn.wParam(NoIndex) ))
      {
        if SpJorn.Viob = 1
        {
          SpJorn.SCHET := mt_JoTune.SchetK;
          SpJorn.SUBOSSCH := mt_JoTune.SubSchK;
          SpJorn.DbSCHET := mt_JoTune.KrSchetK;
          SpJorn.TblOS := mt_JoTune.TblO;
          SpJorn.KauOS := mt_JoTune.KauO;
          //SpJorn.SeeSchet := mt_JoTune.wParam;
          SpJorn.SeeSchet := mt_JoTune.wParam + mt_JoTune.DKZ*10+ mt_JoTune.tip*100 ;

        }
        if SpJorn.Viob = 0
        {
          SpJorn.SeeSchet := mt_JoTune.wParam + mt_JoTune.DKZ*10+ mt_JoTune.tip*100 ;
          SpJorn.SCHET := mt_JoTune.SchetO;
          SpJorn.SUBOSSCH := mt_JoTune.SubSchO;
          SpJorn.DbSCHET := mt_JoTune.DbSchetO;
          SpJorn.TblOS := mt_JoTune.TblK;
          SpJorn.KauOS := mt_JoTune.KauK;
        }
        update current SpJorn;
      }
    }
    else
    {
      //добавляем 2 записи, по дебету и по кредиту
      SpJorn.Nrec     := 0;
      SpJorn.cJornTune:= cJorn;
      SpJorn.wParam   := num;
      SpJorn.Viob     := 1;
      SpJorn.SCHET    := mt_JoTune.SchetK;
      SpJorn.SUBOSSCH := mt_JoTune.SubSchK;
      SpJorn.DbSCHET  := mt_JoTune.KrSchetK;
      SpJorn.TblOS    := mt_JoTune.TblK;
      SpJorn.KauOS    := mt_JoTune.KauK;
      SpJorn.SeeSchet := mt_JoTune.wParam + mt_JoTune.DKZ*10 + mt_JoTune.tip*100 ;
      insert current SpJorn;
      SpJorn.Nrec     := 0;
      SpJorn.Viob     := 0;
      SpJorn.SCHET    := mt_JoTune.SchetO;
      SpJorn.SUBOSSCH := mt_JoTune.SubSchO;
      SpJorn.DbSCHET  := mt_JoTune.DbSchetO;
      SpJorn.TblOS    := mt_JoTune.TblO;
      SpJorn.KauOS    := mt_JoTune.KauO;
      SpJorn.SeeSchet := mt_JoTune.wParam + mt_JoTune.DKZ*10 + mt_JoTune.tip*100;
      insert current SpJorn;
    }
  }
  delete all mt_JoTune; // очищаем память
  MtClear(#mt_JoTune, mfNormal);
  case tb of
  0: PushBounds(tbbyTip0); //
  1: PushBounds(tbbyTip1); //
  2: PushBounds(tbbyTip2); //Счет для учета резерва
  3: PushBounds(tbbyTip3); //Счета  для учета встречных обязательств
  end;
  ReScanPanel(#mt_JoTune);

} //ExportTunesFromMt;

!-------------------------------------------------------------------------------
!Загрузка настройки
!-------------------------------------------------------------------------------
function InitCurrentTune: boolean;
{
  Result := false;
  cJorn := JornTune.NRec;
  if cJorn <> 0
    LoadNastr(cJorn);
  If not ImportTunesToMt
  {
    Abort;
    Exit;
  }
  CheckGroupParams;
  SetVisibleUnvisible;
  SetFormat(brSpJornO);
  Result := true;
}

function SaveCurrentTune(ChangeJorn: boolean): boolean;
{
  Result := false;
  if not CheckRec       //вначале делаем  UpdateTable потом Экспорт, чтобы если новая настройка, узнать  NRec
  {
    Abort;
    Exit;
  }
  if (isModified)
    if (not UpdateTable)
      Abort;
  if ChangeJorn
    cJorn := JornTune.NRec;
  ExportTunesFromMt;
  if (isValid(#JornTune))
      ReDrawPanel(#JornTune); // Чтобы отрисовать плюсики в Browse

  SaveNastr(cJorn);
  Result := true;
}
procedure ChooseKau(i: word);
{
  RunInterface('GetKauTable', cgiPick, cgKatKau_BuhDisabled,  JornTune.TblOs[i], 0);
  SetVisibleUnvisible;
}
