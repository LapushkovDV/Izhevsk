#doc
Финансово-расчетные операции / Отчеты / НПО Энергомаш / отчеты по ДКЗ - Настройка
<p>#2596
<p>#2603
<p>#3503
<p>#3672
<p>#3835 Акт инвентаризации по просроченной задолженности
#end
Interface GP_DKZ_Tuned 'Настройка ДКЗ'  DoAccept, EscClose, Cyan;
Show at (,,,15);

#include GetKau.var
#include PSManager.var
#include XGetKau.var   // Переменная типа "Интерфес выбора многих КАУ"
const
 BegY  = 11;
 joDKZ = 11223;
 #include FpConst.Inc // const BuhRepEntity

end;
var iJornTuneNastr : JornTuneNastr;
    NeedOpenKau    : array[cFirstKau..cLastKau] of boolean;
    iStorage       : BuhRepStore; // объект для работы с хранилищем
    Entity         : rcFpEntity;// сущность под которой хранятся настройки этого интерфейса

procedure TuneExcelLevel; forward;

//временная для хранения настроек депонирования,
//т.к. в SpJorn нельзя сразу запихать счет по дебету и кредиту
table STRUCT  mt_JoTune                 //Для хранения результатов сравнения
(
   NRec      : word
  ,DBSchetO  : string
  ,SchetO    : tSchet3
  ,SubSchO   : tSubSch
  ,TblO      : tTabKau
  ,KauO      : tGetKau
  ,KrSchetK  : string
  ,SchetK    : tSchet3
  ,SubSchK  : tSubSch
  ,TblK     : tTabKau
  ,KauK     : tGetKau
  ,num      : word
  ,wParam   : word
  ,Tip      : word
  ,DKZ : word
)
with index
(
  ind01  = NRec (Unique,AutoInc),
  ind02  = Tip + Nrec
)
;




#declare NeedShowKau(L)
  (Kau#L[1] <> 0) or (Kau#L[2] <> 0) or (Kau#L[3] <> 0) or
  (Kau#L[4] <> 0) or (Kau#L[5] <> 0) or (Kau#L[6] <> 0)
#end
create view AktTuned
var
  MyPlansNo    : comp;  // План счетов
  cJorn        : comp;
  MainAn       : word;  // Аналитика мемориальных ордеров
  JoTuneType   : word;  //

  //todo 12kau
  // переменные для работы с хранилищем дополнительных параметров
  wTipHier2,
  wTipHier3,
  wTipHier4,
  wTipHier5,
  wTipHier6,
  wNumHier2,
  wNumHier3,
  wNumHier4,
  wNumHier5,
  wNumHier6   : word;

  DlgExcelLevel : word;// уровень детализации в excel-листе
  Tip_Flt:word;
as select
  if(JornTune.TblOs[1] > 0, GetAnalitikName(JornTune.TblOs[1]), '')  (FieldName = KatKauName1)
  ,if(JornTune.TblOs[2] > 0, GetAnalitikName(JornTune.TblOs[2]), '')  (FieldName = KatKauName2)
  ,if(JornTune.TblOs[3] > 0, GetAnalitikName(JornTune.TblOs[3]), '')  (FieldName = KatKauName3)
  ,if(JornTune.TblOs[4] > 0, GetAnalitikName(JornTune.TblOs[4]), '')  (FieldName = KatKauName4)
  ,if(JornTune.TblOs[5] > 0, GetAnalitikName(JornTune.TblOs[5]), '')  (FieldName = KatKauName5)
  ,if(JornTune.TblOs[6] > 0, GetAnalitikName(JornTune.TblOs[6]), '')  (FieldName = KatKauName6)
  ,if(#NeedShowKau(O), #ShowKauArray(mt_JoTune.TblO, mt_JoTune.KauO),'') (FieldName = DlgKauO)
  ,if(#NeedShowKau(K), #ShowKauArray(mt_JoTune.TblK, mt_JoTune.KauK),'') (FieldName = DlgKauK)

//  ,*
#undef NeedShowKau
from
   JornTune              (Normal)
  ,mt_JoTune
  ,SpJorn
  ,SpJorn    SpJornO     (Normal, SpJorn03)                    // Основные счета
  ,SpJorn    SpJornS     (Normal, SpJorn03)             // Счета вторых проводок
  ,SpJorn    SpJornHO     (Normal, SpJorn03)             //
  ,BuhSchet  SchetO      (ReadOnly)
  ,BuhSchet  SubSchO     (ReadOnly)
  ,BuhSchet  SchetS      (ReadOnly)
  ,BuhSchet  SubSchS     (ReadOnly)

  ,BuhSchet  SchetHO      (ReadOnly)
  ,BuhSchet  SubSchHO     (ReadOnly)

  ,BuhSchet  SchetHK      (ReadOnly)
  ,BuhSchet  SubSchHK     (ReadOnly)
  ,PlansSch  PlansSchD    (ReadOnly)
  ,PlansSch  PlansSchK    (ReadOnly)

where
((
      myPlansNo               ==  JornTune.cPlansSch
  // ----------------------------------------------
  and joDKZ ==  JornTune.TipJorn
  and  JornTune.Nrec == SpJornHO.cJornTune
  and  (SpJornHO.wParam <> 0)
  // ----------------------------------------------
  #declare Podcepki(Letter,Num)
  and JornTune.Nrec           ==  SpJorn#Letter.cJornTune
  and #Num                    ==  SpJorn#Letter.ViOb
  and SpJorn#Letter.Schet     ==  Schet#Letter.Schet
  and cgDefSub                ==  Schet#Letter.SubSch
  and SpJorn#Letter.Schet     ==  SubSch#Letter.Schet
  and SpJorn#Letter.SubOsSch  ==  SubSch#Letter.SubSch
  and 0  ==  SpJorn#Letter.wParam(NoIndex)
  #end
  #Podcepki(O,0)
  #Podcepki(S,3)
  #undef Podcepki

  and mt_JoTune.SchetO     ==  SchetHO.Schet
  and cgDefSub             ==  SchetHO.SubSch
  and mt_JoTune.SchetO     ==  SubSchHO.Schet
  and mt_JoTune.SubSchO    ==  SubSchHO.SubSch
  and mt_JoTune.SchetK     ==  SchetHK.Schet
  and cgDefSub             ==  SchetHK.SubSch
  and mt_JoTune.SchetK     ==  SubSchHK.Schet
  and mt_JoTune.SubSchK    ==  SubSchHK.SubSch
  //===========================================
  and SchetHO.cPlansSch    ==  PlansSchD.Nrec
  and SchetHK.cPlansSch    ==  PlansSchK.Nrec

))
bounds BySecond = JornTune.Nrec == SpJornHO.cJornTune and
                 (0 <> SpJornHO.wParam )
bounds byTip0 = 0 == mt_JoTune.tip //исключения
bounds byTip1 = 1 == mt_JoTune.tip //основные счета
bounds byTip2 = 2 == mt_JoTune.tip //Счет для учета резерва
bounds byTip3 = 3 == mt_JoTune.tip //Счета  для учета встречных обязательств.
;

Parameters
  cJorn;       // Настройка МО
!-------------------------------------------------------------------------------
!
// загрузка дополнительных параметров отчета их хранилища
procedure LoadNastr(cReport: comp);
var

  i       : integer;
  TmpNRec :TNrec;
{
  Entity.w := FpAktSverkiDopFldEntity;
  Entity.c := cReport;
  if (not iStorage.InitEnt(Entity))
    exit;
//   set cNastr := cReport;

  iStorage.WordGetFld('TipHier2',wTipHier2);
  iStorage.WordGetFld('TipHier3',wTipHier3);
  iStorage.WordGetFld('TipHier4',wTipHier4);
  iStorage.WordGetFld('TipHier5',wTipHier5);
  iStorage.WordGetFld('TipHier6',wTipHier6);
  iStorage.WordGetFld('NumHier2',wNumHier2);
  iStorage.WordGetFld('NumHier3',wNumHier3);
  iStorage.WordGetFld('NumHier4',wNumHier4);
  iStorage.WordGetFld('NumHier5',wNumHier5);
  iStorage.WordGetFld('NumHier6',wNumHier6);
  iStorage.WordGetFld('ExclLevl',DlgExcelLevel);

  RereadRecord;

  iStorage.DoneEnt(Entity);
}

procedure SaveNastr(cReport: comp);
var
  TmpNRec: TNrec;
{
  Entity.w := FpAktSverkiDopFldEntity;
  Entity.c := cReport;
  if (not iStorage.InitEnt(Entity))
    exit;
  iStorage.ClearEnt(Entity);
  iStorage.DelEnt(Entity);

  iStorage.WordSetFld('TipHier2',wTipHier2);
  iStorage.WordSetFld('TipHier3',wTipHier3);
  iStorage.WordSetFld('TipHier4',wTipHier4);
  iStorage.WordSetFld('TipHier5',wTipHier5);
  iStorage.WordSetFld('TipHier6',wTipHier6);
  iStorage.WordSetFld('NumHier2',wNumHier2);
  iStorage.WordSetFld('NumHier3',wNumHier3);
  iStorage.WordSetFld('NumHier4',wNumHier4);
  iStorage.WordSetFld('NumHier5',wNumHier5);
  iStorage.WordSetFld('NumHier6',wNumHier6);
  iStorage.WordSetFld('ExclLevl',DlgExcelLevel);

  iStorage.DoneEnt(Entity);
}
!-------------------------------------------------------------------------------
procedure ClearKau(var aTbl: tTabKau; var aKau: tGetKau);
var
  i: byte;
{
  for (i:=cFirstKau; i<=cLastKau; i:=i+1)
  {
    aTbl[i] := 0;
    aKau[i] := 0;
  }
}
#declare DelKau(L)
  ClearKau(mt_JoTune.Tbl#L, mt_JoTune.Kau#L);
  set mt_JoTune.Tbl#L := mt_JoTune.Tbl#L;
  set mt_JoTune.Kau#L := mt_JoTune.Kau#L;
#end
procedure CheckGroupParams;
{
  if (JornTune.SetProchie = 3)
    ClusterDisabledField(#JornTune.SetKauDay, 0);
  else
  {
    ClusterDisabledField(#JornTune.SetKauDay, 4);
    set JornTune.SetKauDay := JornTune.SetKauDay and not 4;
  }
}
!-------------------------------------------------------------------------------
Procedure MyPick;
{ var _boChange:boolean=false;
  var _myPlansNo:comp=myPlansNo;
  set mt_JoTune.dbSchetO:=mt_JoTune.dbSchetO;
  UpDateTable;
  case (CurField) of
    #SpJornO.dbSchet,
!    #SpJornS.dbSchet,
    #mt_JoTune.dbSchetO,
    #mt_JoTune.KrSchetK :
    {
      if (CurCommand = cmOpenSearch) QuickChoiceName := 'qcBuh_SchetAndSub';
      case (CurField) of

        #mt_JoTune.dbSchetO:
        {
          if (RunInterface('GetBuhSchet',cgiPick+if(Tip_Flt>1,cgiPickAlone,0),_myPlansNo,mt_JoTune.SchetO, mt_JoTune.SubSchO) <> cmCancel)
          { _boChange:=true;
            set mt_JoTune.dbSchetO := #GetDbSch(mt_JoTune.SchetO);
            set mt_JoTune.SubSchO := mt_JoTune.SubSchO;
            #DelKau(O)
          }
        }
        #mt_JoTune.KrSchetK :
        {
          if (RunInterface('GetBuhSchet',cgiPick+if(Tip_Flt>1,cgiPickAlone,0),_myPlansNo,mt_JoTune.SchetK, mt_JoTune.SubSchK) <> cmCancel)
          { _boChange:=true;
            set mt_JoTune.KrSchetK := #GetDbSch(mt_JoTune.SchetK);
            set mt_JoTune.SubSchK := mt_JoTune.SubSchK;
            #DelKau(K)
          }
        }
        #SpJornO.dbSchet :
          if (RunInterface('GetBuhSchet',cgiPick+cgiPickAlone,_myPlansNo,SpJornO.Schet,SpJornO.SubOsSch) <> cmCancel)
          { set SpJornO.dbSchet := #GetDbSch(SpJornO.Schet);
            _boChange:=true;
          }
!        #SpJornS.dbSchet :
!          if (RunInterface('GetBuhSchet',cgiPick,myPlansNo,SpJornS.Schet,SpJornS.SubOsSch) <> cmCancel)
!            set SpJornS.dbSchet := #GetDbSch(SpJornS.Schet);
      end; // case
    }
    #SpJornO.SubOsSch,
!    #SpJornS.SubOsSch,
    #mt_JoTune.SubSchO,
    #mt_JoTune.SubSchK : {
      if (CurCommand = cmOpenSearch) QuickChoiceName := 'qcBuh_SubSchet';
      case (CurField) of
        #SpJornO.SubOsSch : RunInterface('GetBuhSchet',cgiPickSub,myPlansNo,SpJornO.Schet,SpJornO.SubOsSch);
!        #SpJornS.SubOsSch : RunInterface('GetBuhSchet',cgiPickSub,myPlansNo,SpJornS.Schet,SpJornS.SubOsSch);
        #mt_JoTune.SubSchO :
        {
          if (RunInterface('GetBuhSchet',cgiPickSub,myPlansNo,mt_JoTune.SchetO,mt_JoTune.SubSchO) <> cmCancel)
            if (OldFieldValue <> mt_JoTune.SubSchO)
            { _boChange:=true;
              set mt_JoTune.SubSchO := mt_JoTune.SubSchO;
              #DelKau(O)
            }
        }
        #mt_JoTune.SubSchK :
        {
          if(RunInterface('GetBuhSchet',cgiPickSub,myPlansNo,mt_JoTune.SchetK,mt_JoTune.SubSchK) <> cmCancel)
            if (OldFieldValue <> mt_JoTune.SubSchK)
            { _boChange:=true;
              #DelKau(K)
            }
        }
      end; // case

    }
  end; // case
  if _boChange
  { SetModified(true);
    UpdateTable;
  }
} // MyPick

!-------------------------------------------------------------------------------
! Проверка ввода настроек исключений, Обязательно должны быть заполнены оба счета
!-------------------------------------------------------------------------------
Function CheckRec: boolean;
{
  CheckRec := true;

  if (mt_JoTune.SchetO <> cgDefSch and mt_JoTune.SchetK = cgDefSch)
  {
    if mt_JoTune.tip=0 then
    {
      Message('Необходимо указать счет по кредиту', Error);
      SelectField(#mt_JoTune.KrSchetK);
      CheckRec := false;
    }
  }
  if (mt_JoTune.SchetO = cgDefSch and mt_JoTune.SchetK <> cgDefSch)
  {
    Message('Необходимо указать счет по дебету', Error);
    SelectField(#mt_JoTune.DbSchetO);
    CheckRec := false;
  }
} //Function CheckRec: boolean;

//==============================================================================
//
//==============================================================================
Function ModUpdateCurTable : boolean;
{
  ModUpdateCurTable := False;

  if ((isNew) and (not isModified))
  {
    Message('Перед сохранением и копированием настройки,'#13 +
            'необходимо корректно заполнить ее.',OkButton);
    Exit;
  }

  if (not UpDateTable)
    Exit;

  SaveNastr(JornTune.Nrec);

  ModUpdateCurTable := True;
} // ModUpdateCurTable

//==============================================================================
// проверка битов по кау
//==============================================================================
function IsBitOnKau(Level: word): boolean;
{
  Result := ((JornTune.wDayMonth and (1 shl (Level - 1))) = (1 shl (Level - 1)))
} //function IsBitOnKau(Level: word): boolean;

//==============================================================================
// установка битов по кау
//==============================================================================
procedure SetBitOnKau(Level: word);
{
 set JornTune.wDayMonth :=  JornTune.wDayMonth or (1 shl (Level - 1));
}

//==============================================================================
// очистка битов по кау
//==============================================================================
procedure ClearBitOnKau(Level: word);
{
  if IsBitOnKau(Level)
  set  JornTune.wDayMonth := JornTune.wDayMonth xor (1 shl (Level - 1));
}

//==============================================================================
// уровень группировки
//==============================================================================
function IsGroupBitOnKau(Level: word): boolean;
{
  Result := ((JornTune.wParam and (1 shl (Level - 1))) = (1 shl (Level - 1)))
}

//==============================================================================
//
//==============================================================================
procedure SetGroupBitOnKau(Level: word);
{
 set JornTune.wParam :=  JornTune.wParam or (1 shl (Level - 1));
}

//==============================================================================
//
//==============================================================================
procedure ClearGroupBitOnKau(Level: word);
{
  if IsGroupBitOnKau(Level)
  set  JornTune.wParam := JornTune.wParam xor (1 shl (Level - 1));
}

//==============================================================================
// скрытие итогов
//==============================================================================
function IsGroupBitOnHideItogKau(Level: word): boolean;
{
  Result := ((JornTune.wGetData and (1 shl (Level - 1))) = (1 shl (Level - 1)))
}

//==============================================================================
//
//==============================================================================
procedure SetGroupBitOnHideItogKau(Level: word);
{
 set JornTune.wGetData :=  JornTune.wGetData or (1 shl (Level - 1));
}


//==============================================================================
//
//==============================================================================
procedure ClearGroupBitOnHideItogKau(Level: word);
{
  if IsGroupBitOnHideItogKau(Level)
  set  JornTune.wGetData := JornTune.wGetData xor (1 shl (Level - 1));
}


//==============================================================================
//
//==============================================================================
procedure ClearKauTbl(Level: byte);
var
  i: byte;
{
  // сдвигаем аналитику на позицию вверх
  for (i:=Level; i<cLastKau; i:=i+1)
  {
    set JornTune.TblOs[i] := JornTune.TblOs[i+1];
    if IsBitOnKau(i+1)
      SetBitOnKau(i);
    else
      ClearBitOnKau(i);

   if IsGroupBitOnKau(i+1)
      SetGroupBitOnKau(i);
    else
      ClearGroupBitOnKau(i);

   if IsGroupBitOnHideItogKau(i+1)
     SetGroupBitOnHideItogKau(i);
   else
     ClearGroupBitOnHideItogKau(i);

  }

  set JornTune.TblOs[6] := 0;
  ClearBitOnKau(6);
  ClearGroupBitOnKau(6);
  ClearGroupBitOnHideItogKau(6);
} //procedure ClearKauTbl(Level: byte);

//==============================================================================
//
//==============================================================================
Procedure SetClearField (bResult : boolean; iField : integer);
{
  if (bResult)
    SetFieldState(iField,sfVisible);
  else
    ClearFieldState(iField,sfVisible);
} // SetClearField


//==============================================================================
// отображение полей для заполненных уровней КАУ + 1 для нового(до 6)
//==============================================================================
Procedure SetVisibleUnvisible;
var
  i, KauLevels: byte;
  flag: word;
{
  // определим кол-во заполненных уровней
  KauLevels := 6;
  flag := 0;
  for (i:=cLastKau; i>=cFirstKau; i:=i-1)
  {
    if JornTune.TblOs[i] = 0
    {
      KauLevels := i - 1;
      flag := flag or (1 shl KauLevels);
    }
    else
      Break;

  }
  if KauLevels < 6
    inc(KauLevels);


  SetClearField((KauLevels >= 2), #KatKauName2);
  SetClearField((KauLevels >= 3), #KatKauName3);
  SetClearField((KauLevels >= 4), #KatKauName4);
  SetClearField( (KauLevels >= 5), #KatKauName5);
  SetClearField( (KauLevels >= 6), #KatKauName6);
  ClusterDisabledField(#JORNTUNE.WDAYMONTH, flag or 1);
  ClusterDisabledField(#JORNTUNE.WPARAM, flag or 1);

  if ((JornTune.SetKauDay and 1) = 0)
    ClusterDisabledField(#JORNTUNE.WGETDATA, 63)
  else
    ClusterDisabledField(#JORNTUNE.WGETDATA, flag or 1);

  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WDAYMONTH', cfpSkip, true);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WDAYMONTH#1', cfpVisible, KauLevels >= 3);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WDAYMONTH#2', cfpVisible, KauLevels >= 4);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WDAYMONTH#3', cfpVisible, KauLevels >= 5);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WDAYMONTH#4', cfpVisible, KauLevels >= 6);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WPARAM', cfpSkip, true);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WPARAM#1', cfpVisible, KauLevels >= 3);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WPARAM#2', cfpVisible, KauLevels >= 4);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WPARAM#3', cfpVisible, KauLevels >= 5);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WPARAM#4', cfpVisible, KauLevels >= 6);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WGETDATA', cfpSkip, true);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WGETDATA#1', cfpVisible, KauLevels >= 3);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WGETDATA#2', cfpVisible, KauLevels >= 4);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WGETDATA#3', cfpVisible, KauLevels >= 5);
  cfsSetProp('ci_SJORNTUNE_JORNTUNE.WGETDATA#4', cfpVisible, KauLevels >= 6);

  cfsSetProp('i_SJORNTUNE_WTIPHIER2', cfpVisible, JornTune.TblOs[2] <> 0 and not IsGroupBitOnKau(2));
  cfsSetProp('i_SJORNTUNE_WTIPHIER3', cfpVisible, JornTune.TblOs[3] <> 0 and not IsGroupBitOnKau(3));
  cfsSetProp('i_SJORNTUNE_WTIPHIER4', cfpVisible, JornTune.TblOs[4] <> 0 and not IsGroupBitOnKau(4));
  cfsSetProp('i_SJORNTUNE_WTIPHIER5', cfpVisible, JornTune.TblOs[5] <> 0 and not IsGroupBitOnKau(5));
  cfsSetProp('i_SJORNTUNE_WTIPHIER6', cfpVisible, JornTune.TblOs[6] <> 0 and not IsGroupBitOnKau(6));

  cfsSetProp('i_SJORNTUNE_WNUMHIER2', cfpVisible, JornTune.TblOs[2] <> 0 and not IsGroupBitOnKau(2));
  cfsSetProp('i_SJORNTUNE_WNUMHIER3', cfpVisible, JornTune.TblOs[3] <> 0 and not IsGroupBitOnKau(3));
  cfsSetProp('i_SJORNTUNE_WNUMHIER4', cfpVisible, JornTune.TblOs[4] <> 0 and not IsGroupBitOnKau(4));
  cfsSetProp('i_SJORNTUNE_WNUMHIER5', cfpVisible, JornTune.TblOs[5] <> 0 and not IsGroupBitOnKau(5));
  cfsSetProp('i_SJORNTUNE_WNUMHIER6', cfpVisible, JornTune.TblOs[6] <> 0 and not IsGroupBitOnKau(6));

  //меняем размеры панелей, чтоб не было пустоты
  cfsSetProp('sJornTune' , cfpRectB_Y, BegY + KauLevels);
  cfsSetProp('brSpJornHS', cfpRectA_Y, BegY + KauLevels +  1);
  cfsSetProp('brSpJornO' , cfpRectA_Y, BegY + KauLevels +  1);
  cfsSetProp('brSpJornR' , cfpRectA_Y, BegY + KauLevels +  1);
  cfsSetProp('brSpJornIN', cfpRectA_Y, BegY + KauLevels +  1);
//  for(i := cLastKau; i<= KauLevels; i--)
  TuneExcelLevel;

} // SetVisibleUnvisible


