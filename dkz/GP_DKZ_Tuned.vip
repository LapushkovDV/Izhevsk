HandleEvent
  cmDefault : {
    if (isValid(#JornTune))
    {
      cJorn := JornTune.NRec;
    }
    else
      Abort;
  }
end; // handleevent panel pJornTune
//end; // panel pJornTune

TableEvent table JornTune;
  cmCheckField:
  {
    case CurField of
      #JornTune.SetProchie:
        CheckGroupParams;
      #JornTune.SetKauDay,
      #JornTune.wParam,
      #DlgExcelLevel:
        SetVisibleUnvisible;
    end;

  }
  cmPositionChanged:
  {
    if FocusedFormat  <> brJornTune
    {
      SaveCurrentTune(false);
      InitCurrentTune;
    }
  }
  cmEdit :
  {
    InitCurrentTune;
    RunWindow(wiTune);
  }

  cmInsertRecord :
  {
    insert current JornTune;
    cJorn := JornTune.NRec;
  }
  cmUpdateRecord :
  {
    update current JornTune;
  }
  cmDeleteRecord :
    if (Message('Удалить настройку ?',YesNo) = cmYes) {
      delete SpJornO;
      delete SpJornS;
      delete current JornTune;
    }
  cmSetDefault :
  {
    InitCurrentTune;
    JornTune.TblOs[1] := cgKau_KatOrg;
    if FocusedFormat  <> brJornTune
    {  //Если новая настройка создается из окна редактирования настройки
        ExportTunesFromMt;
    }
    JornTune.TipJorn := joDKZ;
    JornTune.NumJorn :=  iJornTuneNastr.NextNumber(MyPlansNo, joDKZ);
    //т.к сквозная нумерация ордеров(независимо стнадартный ордер или нет, то ищем максимальный номер из двух типов)
    // Нумерация сейчас начинается с 2 (для возможной совместимости в будующем с журналами)
    JornTune.SetProchie := 2;
    SetVisibleUnvisible;
    PutCommand(cmEdit);
    SelectField(#JornTune.NumJorn);
  }
  cmAddNewRec : {
    PutCommand(cmInsert);
  }

  cmCheckRecord : {
    if (JornTune.NumJorn = 0) {
      Message('Необходимо указать номер', Error);
      SelectField(#JornTune.NumJorn);
      Abort; Exit;
    }
    if (Trim(JornTune.Name) = '') {
      Message('Необходимо указать наименование', Error);
      SelectField(#JornTune.Name);
      Abort; Exit;
    }

  }
  cmPick:
  {
    case (CurField) of
      #KatKauName1: ChooseKau(1);
      #KatKauName2: ChooseKau(2);
      #KatKauName3: ChooseKau(3);
      #KatKauName4: ChooseKau(4);
      #KatKauName5: ChooseKau(5);
      #KatKauName6: ChooseKau(6);
    end;
  }
  cmDelOnProtect:
  {
    case CurField of
      #KatKauName1: ClearKauTbl(1);
      #KatKauName2: ClearKauTbl(2);
      #KatKauName3: ClearKauTbl(3);
      #KatKauName4: ClearKauTbl(4);
      #KatKauName5: ClearKauTbl(5);
      #KatKauName6: ClearKauTbl(6);
    end;
    SetVisibleUnvisible;
  }
end;  //TableEvent table JornTune;


!-------------------------------------------------------------------------------
HandleEvent   // Interface
  cmInit : {
!    timelog_Init;
!    timelog('GP_DKZ_Tuned->cmInit');
    if (not iPSManager.GetTunePlansSch(MyPlansNo))
    {
      Abort;
      Exit;
    }

    if (cJorn <> 0)
      if (GetFirst JornTune where ((cJorn == JornTune.NRec)) <> tsOk)
        if (GetFirst JornTune = tsOk) {};

    SetWindowTitle(wnMainWindow,'ДКЗ (' + iPSManager.GetName(MyPlansNo) + ')');

  }
  cmDone : {
  }
  cmSaveDoc : {

    Message('1');
  //  if (ModUpdateCurTable)
  //    iJornTuneNastr.SaveNastrJorn(JornTune.NRec);
  }


  cmDelOnProtect :
  {
  }

end;          // HandleEvent Interface
End.          // Interface

#include userreport.vih

