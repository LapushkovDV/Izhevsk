Browse brJornTune (,hcBankSpisNastr,sci1478EnEsc);
table JornTune;
fields
  JornTune.NumJorn                 '№ '                   : [5], Protect;
  JornTune.SCHET                   'тип'                  : [5], Protect;
  JornTune.Name                    'Наименование отчета'  : [47], Protect;

end; // browse brJornTune
