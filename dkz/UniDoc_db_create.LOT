Create table GP.GP_Status "Статусы док-в в системе контроля доступа"
  With table_Code = 31529
  With replace
  With TableOptions Branched
  (
    NRec       : comp "Номер записи",
    cTypeDoc   : ref(GP_TypeDocs) "Тип документа",
    Code       : string[5] "Код",
    Name       : string "Наименование",
    IsDefault  : boolean "Статус по умолчанию"
  )
  With index
  (
    Status01 = NRec(Unique, Surrogate, Journal),
    Status02 = cTypeDoc + Code
  );


Create table EM_UniDoc_Head "Шапка универсального документа"
With table_Code = 31613
with Replace
with tableoptions Branched

(
   NRec           : comp                                 "Идентификатор"
 , wType          : word                                 "Тип документа"
 , wParentTable   : word                                 "Тип документа-основания"
 , cParentDoc     : comp                                 "Указатель на документ-основание"
 , DocNumb        : string                               "Номер документа"
 , DocDate        : date                                 "Дата документа"
 , cPodr          : ref(KATPODR)                         "Подразделение"
 , cStatus        : ref(GP_STATUS)                       "Статус"
 , Description    : String                               "Описание"
 , addComp        : array[1..10] of comp                 "Дополнительные поля comp"
 , addDate        : array[1..10] of date                 "Дополнительные поля date"
 , addTime        : array[1..10] of time                 "Дополнительные поля time"
 , addDouble      : array[1..10] of double               "Дополнительные поля double"
 , addWord        : array[1..10] of word                 "Дополнительные поля word"
 , addLongInt     : array[1..10] of longint              "Дополнительные поля longint"
 , addString      : array[1..10] of string               "Дополнительные поля string"
)
With index
(
   i_nrec = NRec(Unique, Surrogate, Journal)
 , i_ind1 = wType + DocDate + DocNumb
 , i_ind2 = wType + wParentTable + cParentDoc
 , i_ind3 = wType + cPodr
)
;

Create table EM_UniDoc_Spec "Спецификация универсального документа"
With table_Code = 31614
with Replace
with tableoptions Branched

(
   NRec           : comp                                 "Идентификатор"
 , cHead          : ref(EM_UniDoc_Head)                  "Документ"
 , cSpec          : ref(EM_UniDoc_Spec)                  "Родительская позиция спецификации"
 , addComp        : array[1..10] of comp                 "Дополнительные поля comp"
 , addDate        : array[1..10] of date                 "Дополнительные поля date"
 , addTime        : array[1..10] of time                 "Дополнительные поля time"
 , addDouble      : array[1..10] of double               "Дополнительные поля double"
 , addWord        : array[1..10] of word                 "Дополнительные поля word"
 , addLongInt     : array[1..10] of longint              "Дополнительные поля longint"
 , addString      : array[1..10] of string               "Дополнительные поля string"
)
With index
(
   i_nrec = NRec(Unique, Surrogate, Journal)
 , i_ind1 = cHead
 , i_ind2 = cSpec
)
;
