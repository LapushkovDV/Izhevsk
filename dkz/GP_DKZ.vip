procedure RecordToDlg;
{
  BegDate      := VipParams.BegDate;
  EndDate      := VipParams.EndDate;
  set VipParams.SchetO := VipParams.SchetO;
  set VipParams.cJOrder := VipParams.cJOrder;
  set VipParams.cListGD := VipParams.cListGD;
  set VipParams.TiDkUser := VipParams.TiDkUser;
  set VipParams.SchK := VipParams.SchK;
  set VipParams.PageNum := VipParams.PageNum;
  set VipParams.PageCount := VipParams.PageCount;
  set VipParams.cCorrespO := VipParams.cCorrespO;
  set VipParams.cCorrespK := VipParams.cCorrespK;
  set VipParams.mCorrespO := VipParams.mCorrespO;
  set VipParams.mCorrespK := VipParams.mCorrespK;
  set VipParams.CorrespO_Obj := VipParams.CorrespO_Obj;
  set VipParams.CorrespK_Obj := VipParams.CorrespK_Obj;
  set VipParams.wCorrespO := VipParams.wCorrespO;
  set VipParams.wCorrespK := VipParams.wCorrespK;
  set VipParams.cPostPol := VipParams.cPostPol;
  set VipParams.cFilKor := VipParams.cFilKor;
  set VipParams.cDeltaVal := VipParams.cDeltaVal;
  set VipParams.cCachBank := VipParams.cCachBank;
  set VipParams.cHozOper  := VipParams.cHozOper;
  Reporttip:=VipParams.wVidOtch;
  DlgUslT   := VipParams.SumMode   ;
  DlgUsl1   := VipParams.MinSum    ;
  DlgUsl2   := VipParams.MaxSum;
  set DlgUsl_chk:= VipParams.PageNum;
  set DlgOnDate := VipParams.PageCount     ;
  set DlgUslM   := VipParams.SaveRep  ;
  set Kol_Days_Prosr:=VipParams.wCorrespK; // кол-во дней просрочки
  if Kol_Days_Prosr=0 Kol_Days_Prosr:=90;
} // procedure RecordToDlg

procedure DlgToRecord;
{
  VipParams.BegDate   := BegDate;
  VipParams.EndDate   := EndDate;
  VipParams.wVidOtch  := Reporttip;
  VipParams.SumMode   := DlgUslT;
  VipParams.MinSum    := DlgUsl1;
  VipParams.MaxSum    := DlgUsl2;
  VipParams.PageNum   := DlgUsl_chk;
  VipParams.PageCount := DlgOnDate;
  VipParams.SaveRep   := DlgUslM;
  VipParams.wCorrespK := Kol_Days_Prosr; // кол-во дней просрочки

} // procedure DlgToRecord


