procedure DeleteAllPicks;
{
  delete all SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and cReport  == SpBuhRep.cEntity and  'gp_m1'  == SpBuhRep.STBL));
  delete all SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and cReport  == SpBuhRep.cEntity and  'gp_m2'  == SpBuhRep.STBL));
  delete all SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and cReport  == SpBuhRep.cEntity and  'gp_m3'  == SpBuhRep.STBL));
  delete all SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and cReport  == SpBuhRep.cEntity and  'gp_m4'  == SpBuhRep.STBL));
  delete all SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and cReport  == SpBuhRep.cEntity and  'gp_m5'  == SpBuhRep.STBL));
} //procedure DeleteAllPicks;

