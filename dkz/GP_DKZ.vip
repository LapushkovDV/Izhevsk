//
//-----------------------------------------------------
function GetOB(cK,cD:comp):string;
var t1,t2,ts:string;
npp:word;
{
  Result:='';
  vOborotX.pr:=Substr(oborot.SCHETO,1,1);
  vOborotX.cK:=cK;
  vOborotX.cD:=cD;
  ts:='';npp:=0;
//  if Timelog_status>2
    _log('GetOb '+vOborotX.pr+'  '+vOborotX.ck+'  '+vOborotX.cd);
  vOborotX._loop oborotX /*where ((
                     pr+'008' == oborotX.SCHETO
                     and '02'     == oborotX.SUBOSSCH
                     and (cK       = oborotX.kauos[1]
                     and cD       = oborotX.kauos[2])
                    ))     */
  {
    t1:='';t2:='';
    //if getfirst KATB where ((oborotX.KAUOS[4] == KATB.nrec )) = tsok
    vOborotX._Loop KATB
    {
      t1:=vOborotX.katb.name;
      break;
    }
    //if getfirst katsoprX where ((oborotX.KAUOS[3] == katsoprX.czakaz )) = tsok
    vOborotX._Loop katsoprX
    {
      t2:='№'+vOborotX.katsoprX.Nsopr+' на период с '+vOborotX.katsoprX.Dprice+' по '+vOborotX.katsoprX.Dopr;
    }
    inc(npp);
    ts:=ts+if(ts='','','  '+chr(13))+string(npp)+' '+t1+' '+t2;

    _log('GetOb ts='+ts);
  } //vOborotX._loop oborotX
  Result:=ts;
} //function GetOB(cK,cD:comp):string;

//=====================================================
//
//-----------------------------------------------------
function GetOBStr(s:string;cK:comp):string;
var t1,t2,ts,tmp_s:string;
npp:word;  cD:comp;
{
 Result:='';
 vOborotX.Pr:=Substr(toborot.SCH,1,1);
 ts:='';npp:=0;
 _log('GetObStr s= '+s+'    '+vOborotX.pr+'  '+ck);
  i:=0;
  do{
    inc(i);
    tmp_s:=ExtractDelimitedWord(s,i,'#');
    _log('GetObStr tmp_s= '+tmp_s+'    '+i);
    if tmp_s<>'' then
    {
      cD:=comp(tmp_s);
      vOborotX.cK:=cK;
      vOborotX.cD:=cD;

      vOborotX._loop oborotX /*where ((
                         pr+'008' == oborotX.SCHETO
                         and '02'     == oborotX.SUBOSSCH
                         and (cK       = oborotX.kauos[1]
                         and cD       = oborotX.kauos[2])
                        ))    */
      {
        t1:='';t2:='';
        //if getfirst KATB where ((oborotX.KAUOS[4] == KATB.nrec )) = tsok
        vOborotX._Loop KATB
        {
          t1:=vOborotX.katb.name;
        }
        //if getfirst katsoprX where ((oborotX.KAUOS[3] == katsoprX.czakaz )) = tsok
        vOborotX._Loop katsoprX
        {
          t2:='№'+vOborotX.katsoprX.Nsopr+' на период с '+vOborotX.katsoprX.Dprice+' по '+vOborotX.katsoprX.Dopr;
        }
        inc(npp);
        ts:=ts+if(ts='','','  '+chr(13))+string(npp)+' '+t1+' '+t2;

      }
    }
  } while(tmp_s<>'')
  _log('GetOb ts='+ts);

  Result:=ts;
}//function GetOBStr(s:string;cK:comp):string;

