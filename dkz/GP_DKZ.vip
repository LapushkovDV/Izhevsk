function GetNaznaFromDog(cc:comp):string; cacheable;
{
  Result:='';
  if cc=0 then exit;
  vSpr.pDogovor_F:=cc;
  vSpr._Loop AttrDog
  { Result:=trim(ShowKau(cgKau_Dogovor,cc)+' '+vSpr.AttrDog.SUBJECT1+' '+vSpr.AttrDog.SUBJECT2+' '+vSpr.AttrDog.SUBJECT3);
  }
  _log('D_Nazna '+Result);

} //function GetNaznaFromDog(cc:comp):string;

//EM-316 добавить анализ дополнительных аналитик для выгурзки в печатные формы
Procedure SetNaznaDopAnlt;
{
  If (tOborot.Nazna = '')Or(tOborot.dname = '')Or(tOborot.dname = 'Бухгалтерская справка')
  {
    for(i:=1; i<=7; i++)
    {  
      If (cgKau_BGarant  = tOborot.TBLOS[i])
      {        
        If (GetFirst FastFirstRow KatSopr where ((     cgDoc_0408        == KatSopr.VidSopr
                                                   And tOborot.KAUOS[i]  == KatSopr.cZakaz (NoIndex)
                                                 )) = tsOk)
        {    
          tOborot.nazna   := GetNaznaFromDog(KatSopr.cDogovor);
          If(tOborot.nazna = '')
          { tOborot.nazna := KatSopr.name; }
          tOborot.dname   := Get_KatDocName(cgDoc_0409);
          tOborot.dnum    := KatSopr.nsopr;
          tOborot.dsopr   := KatSopr.dsopr;          
          tOborot.dvoznpr := tOborot.dsopr;
          if(Update Current tOborot = TsOk)
          {}
          Exit;
        }   
      }
      Else If (cgKau_VedDeponir  = tOborot.TBLOS[i])
      {
        If (GetFirst FastFirstRow VedDeponir where((tOborot.KAUOS[i] == VedDeponir.NRec)) = TsOk)
        {
          tOborot.Nazna := Trim(tOborot.Nazna+' '+VedDeponir.nmnEm);
          If UpCase(Trim(VedDeponir.name)) <> UpCase(Trim(VedDeponir.nmnEm))
          {
           tOborot.Nazna := Trim(tOborot.Nazna+' '+VedDeponir.name);
          }
          tOborot.dname   := 'Ведомость депонирования';
          tOborot.dnum    := VedDeponir.noDoc;
          tOborot.dsopr   := VedDeponir.dForm;
          tOborot.dvoznpr := tOborot.dsopr;
          if(Update Current tOborot = TsOk)
          {}
          Exit;
        }
      }
      Else If (cgKau_AppVeks = tOborot.TBLOS[i])
      {
        If (GetFirst FastFirstRow Veksl where((tOborot.KAUOS[i] == Veksl.NRec)) = TsOk)
        {          
          tOborot.dname   := If(IsValid(tnKatKlass), KatKlass.Name, 'Векселя и ценные бумаги');
          tOborot.dnum    := Trim(Veksl.SrDoc+' '+Veksl.NoDoc);
          tOborot.dsopr   := Veksl.DatVip;
          tOborot.dvoznpr := Veksl.DatVip;
          if(Update Current tOborot = TsOk)
          {}
          Exit;
        }
      }
      Else If (cgKau_Dogovor = tOborot.TBLOS[i])
      {        
        If(tOborot.nazna = '')
        { tOborot.nazna :=  GetNaznaFromDog(Comp(tOborot.KAUOS[i])); }
      }
    }  
  }

  If (tOborot.Nazna = '')
  {
    for(i:=1; i<=6; i++)
    {  
      If (cgKau_Dogovor = tOborot.wgr[i])
      {        
        If(tOborot.nazna = '')
        {
          tOborot.nazna :=  GetNaznaFromDog(Comp(tOborot.cgr[i])); 
          Exit;          
        }
      }
    }   
  }   
}

//=====================================================
Procedure MyxlSetCellStringValue(_sVal:string; _row_t:longint;_col_l:longint; _row_b:longint;_col_r:longint );
{
  _row_b := _row_b;
  _col_r := _col_r;
  wexrow:=_row_t; wexcol:=_col_l;
  MyPutExcel(_sVal,0,0,-1,-1);
}

//=====================================================
Procedure MyxlSetCellDateValue(_dVal:date; _row_t:longint;_col_l:longint; _row_b:longint;_col_r:longint );
{
  _row_b := _row_b;
  _col_r := _col_r;
  wexrow:=_row_t; wexcol:=_col_l;
  if _dVal<>ZeroDate
    MyPutExcel(chr(39)+DateToStr(_dVal,'DD.MM.YYYY'),0,0,-1,-1);
}

//=====================================================
Procedure  MyxlSetCellNumberValue(_dVal:double; _row_t:longint;_col_l:longint; _row_b:longint;_col_r:longint );
{
  _row_b := _row_b;
  _col_r := _col_r;
  wexrow:=_row_t; wexcol:=_col_l;
  MyPutExcelNumber(_dVal,2,0,0,-1,-1);
}

//#EM-389 Наличие группировка субсчет в иерархии
Function ExistGrLevelSubSch: Boolean;
{
  Result := False;
  
  Var i : Word;  
  for(i:=1; i<=6; i++)
  {
    if (JornTune.TblOs[i] = 0)
    { Continue; }
    
    If (JornTune.tblos[i] = wDKZ_SubSch) Or (JornTune.tblos[i] = wDKZ_SchSubSch)
    {
      Result := True; 
      Exit;
    }       
  }
}

//=====================================================
// 0 'Дебиторская/Кредиторская задолженность(Крупные суммы)'
//-----------------------------------------------------
Function RecursionPrint1(cc:comp; ll:longint):boolean;
var OO,OldLevS:word;
    CR:word;
{

 PushPos(#ttreesx);
 Result:=True;
 CR:=0;
 OO:=LevelString;
 LevelString:=LevelString+1;
 _loop ttreesx where ((cc==ttreesx.cowner))
 { if not NextVisual
   { Result:=False;
     Break;
   }
   
   //по контрагентам
   If(ttreesx.grLv <> wDKZ_OrgSchSubSch And ttreesx.grLv <> cgKau_KatOrg And ttreesx.grLv <> cgKau_Persons)
   { Continue; }     
   
   //Общая сумма по всем контрагентам
   sumTot[0] += tTreesx.summa;       
   sumTot[1] += tTreesx.sum_prosr[1];
   sumTot[2] += tTreesx.sum_prosr[2];
   sumTot[3] += tTreesx.sum_prosr[3];
   sumTot[4] += tTreesx.sum_prosr[4];
   sumTot[5] += tTreesx.sum_prosr[5];
   sumTot[6] += tTreesx.sum_prosr[6];
   sumTot[7] += tTreesx.sum_prosr[7];

   if getfirst ttreesx1 where ((ttreesx.name == ttreesx1.name and 0 == tTreesx.dkz and 1 == tTreesx1.dkz))=tsok
     {
       if '63'=substr(tTreesx1.schet,2,2)
       {
         sumTot[8] += tTreesx1.summa;
       }
       if '76'=substr(tTreesx1.schet,2,2)
       {
         sumTot[9] += tTreesx1.summa;
       }

     }

   var ttname1:string;
   ttname1:=ttreesx.name+' 76.192';
   if getfirst ttreesx1 where ((ttname1==ttreesx1.name   and 0 == tTreesx.dkz and 1 == tTreesx1.dkz))=tsok
     {
       if '76'=substr(tTreesx1.schet,2,2)
       {
         sumTot[9] += tTreesx1.summa;
       }

     }


   If(tTreesx.summa < krupSumma)
   { Continue; }

   If(Round(TochSum(tTreesx.summa), 0) = 0)
   { Continue; }
   
   //итоговая сумма по крупнейшим организациям
   sumItg[0] += tTreesx.summa;       
   sumItg[1] += tTreesx.sum_prosr[1];
   sumItg[2] += tTreesx.sum_prosr[2];
   sumItg[3] += tTreesx.sum_prosr[3];
   sumItg[4] += tTreesx.sum_prosr[4];
   sumItg[5] += tTreesx.sum_prosr[5];
   sumItg[6] += tTreesx.sum_prosr[6];
   sumItg[7] += tTreesx.sum_prosr[7];

   if getfirst ttreesx1 where ((ttreesx.name == ttreesx1.name and 0 == tTreesx.dkz and 1 == tTreesx1.dkz))=tsok
     {
       if '63'=substr(tTreesx1.schet,2,2)
       {
         sumItg[8] += tTreesx1.summa;
       }
       if '76'=substr(tTreesx1.schet,2,2)
       {
         sumItg[9] += tTreesx1.summa;
       }

     }

   if getfirst ttreesx1 where ((ttname1==ttreesx1.name   and 0 == tTreesx.dkz and 1 == tTreesx1.dkz))=tsok
     {
       if '76'=substr(tTreesx1.schet,2,2)
       {
         sumItg[9] += tTreesx1.summa;
       }

     }


   
   inc(wexrow);inc(CR);
   MyxlSetCellStringValue(ttreesx.name          ,wexrow, 1+LevelString,wexrow, 1+LevelString);
   xlFrameCells(63, xlThin, 0, 0,wexrow,6+LevelString,wexrow,6+LevelString);
   MyxlSetCellStringValue(ttreesx.inn           ,wexrow, 6+LevelString,wexrow, 6+LevelString);
   xlFrameCells(63, xlThin, 0, 0,wexrow,7+LevelString,wexrow,7+LevelString);
   MyxlSetCellStringValue(ttreesx.ogrn          ,wexrow, 7+LevelString,wexrow, 7+LevelString);
   if tTreesx.summa<>0        then MyxlSetCellNumberValue(TochSum(tTreesx.summa)            ,wexrow, 9,wexrow, 9);
   if ll=2
   {
     if getfirst ttreesx1 where ((ttreesx.name == ttreesx1.name and 0 == tTreesx.dkz and 1 == tTreesx1.dkz))=tsok
     {
       if '63'=substr(tTreesx1.schet,2,2)
       {
         MyxlSetCellNumberValue(TochSum(tTreesx1.summa),wexrow, 10,wexrow, 10);
       }
       if '76'=substr(tTreesx1.schet,2,2)
       {
         MyxlSetCellNumberValue( TochSum(tTreesx1.summa),wexrow, 11,wexrow, 11);
       }

     }
     var ttname:string;
     ttname:=ttreesx.name+' 76.192';
     if getfirst ttreesx1 where ((ttname==ttreesx1.name   and 0 == tTreesx.dkz and 1 == tTreesx1.dkz))=tsok
     {
       if '76'=substr(tTreesx1.schet,2,2)
       {
         MyxlSetCellNumberValue( TochSum(tTreesx1.summa),wexrow, 11,wexrow, 11);
       }

     }
   }
   if tTreesx.sum_prosr[1]<>0 then MyxlSetCellNumberValue(TochSum(tTreesx.sum_prosr[1])     ,wexrow,10+ll,wexrow,10+ll);
   if tTreesx.sum_prosr[2]<>0 then MyxlSetCellNumberValue(TochSum(tTreesx.sum_prosr[2])     ,wexrow,11+ll,wexrow,11+ll);
   if tTreesx.sum_prosr[3]<>0 then MyxlSetCellNumberValue(TochSum(tTreesx.sum_prosr[3])     ,wexrow,12+ll,wexrow,12+ll);
   if tTreesx.sum_prosr[4]<>0 then MyxlSetCellNumberValue(TochSum(tTreesx.sum_prosr[4])     ,wexrow,13+ll,wexrow,13+ll);
   if tTreesx.sum_prosr[5]<>0 then MyxlSetCellNumberValue(TochSum(tTreesx.sum_prosr[5])     ,wexrow,14+ll,wexrow,14+ll);
   if tTreesx.sum_prosr[6]<>0 then MyxlSetCellNumberValue(TochSum(tTreesx.sum_prosr[6])     ,wexrow,15+ll,wexrow,15+ll);
   if tTreesx.sum_prosr[7]<>0 then MyxlSetCellNumberValue(TochSum(tTreesx.sum_prosr[7])     ,wexrow,16+ll,wexrow,16+ll);
   MyxlSetCellDateValue(tTreesx.mind                        ,wexrow,17+ll,wexrow,17+ll);
   MyxlSetCellDateValue(tTreesx.maxd                        ,wexrow,18+ll,wexrow,18+ll);
//   xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,17);
   if LevelString=1 then
     {
      inc(_NPP);
//      xlSetFontStyle(xlBold ,wexrow,1,wexrow,18);
      MyxlSetCellStringValue(_NPP         ,wexrow, 1,wexrow, 1);
     }
   xlFrameCells(63, xlThin, 0, 0,wexrow,9,wexrow,18+ll);
   xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,1);
   xlFrameCells(15, xlThin, 0, 0,wexrow,2,wexrow,8);

   OldLevS:=LevelString;
   Result:=RecursionPrint1(ttreesx.nrec,ll);
   if not Result break;
   LevelString:=OldLevS;

 }
 PopPos(#ttreesx);

} //Function RecursionPrint1(cc:comp):boolean;


//=====================================================
// 0 'Дебиторская/Кредиторская задолженность(Крупные суммы)'
//-----------------------------------------------------
procedure PR1;
{
 var ww:longint;
 xlSetActiveSheet(1);
 MyxlSetCellStringValue('Расшифровка дебиторской задолженности (Крупные суммы)',1,1,1,1);
 MyxlSetCellStringValue(BuhRep.Name+' на '+datetostr(EndDate,'DD.MM.YYYY'),2,1,2,1);
 wexrow:=6;_NPP:=0;
 
 //Обнуление массивов итогов
 SetLimit(SumTot, 0);
 SetLimit(SumItg, 0);
 
 if getfirst ttreesx where ((0 == tTreesx.dkz and 0 == ttreesx.cowner))=tsok
 {
   MyxlSetCellStringValue(ttreesx.name ,wexrow, 2,wexrow, 2);
   xlSetFontStyle(xlBold ,wexrow,1,wexrow,19);
   xlFrameCells(63, xlThin, 0, 0,wexrow,9,wexrow,20);
   xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,1);
   xlFrameCells(15, xlThin, 0, 0,wexrow,2,wexrow,8);
 }
 LevelString:=0;
 //====================================
 HeaderStrCount:=wexrow;
 MaxColCount:=20;
 wexrow++;
 MyXlCreaMatrix(1000,MaxColCount);
 wexrow--;
 //====================================
 RecursionPrint1(ttreesx.nrec,2);
 //====================================
 MyxlWriteMatrix(wexrow);
 xlFreeMatrix;
 matrixkl:=False;
 //====================================  
 ww:=wexrow;
 //ДЗ - Итоговые суммы по крупнейшим организациям
 inc(wexrow); 
 MyxlSetCellStringValue('По крупным задолженностям всего' ,wexrow, 2,wexrow, 2);
 if (sumItg[0] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[0]), wexrow,  9, wexrow,  9); }
 if (sumItg[1] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[1]), wexrow, 12, wexrow, 12); }
 if (sumItg[2] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[2]), wexrow, 13, wexrow, 13); }
 if (sumItg[3] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[3]), wexrow, 14, wexrow, 14); }
 if (sumItg[4] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[4]), wexrow, 15, wexrow, 15); }
 if (sumItg[5] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[5]), wexrow, 16, wexrow, 16); }
 if (sumItg[6] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[6]), wexrow, 17, wexrow, 17); }
 if (sumItg[7] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[7]), wexrow, 18, wexrow, 18); }
 if (sumItg[8] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[8]), wexrow, 10, wexrow, 10); }
 if (sumItg[9] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[9]), wexrow, 11, wexrow, 11); }
 xlSetFontStyle(xlBold ,wexrow,1,wexrow,20);
 xlFrameCells(63, xlThin, 0, 0,wexrow,9,wexrow,20);
 xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,1);
 xlFrameCells(15, xlThin, 0, 0,wexrow,2,wexrow,8);
 
 //ДЗ - Итоговые суммы по организациям, которые не относятся к крупнейшим
 inc(wexrow);
 MyxlSetCellStringValue('Прочие авансы выданные'          ,wexrow, 2,wexrow, 2); 
 if ((sumTot[0] - sumItg[0]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[0] - sumItg[0]), wexrow,  9, wexrow, 9); }
 if ((sumTot[1] - sumItg[1]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[1] - sumItg[1]), wexrow, 12, wexrow,12); }
 if ((sumTot[2] - sumItg[2]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[2] - sumItg[2]), wexrow, 13, wexrow,13); }
 if ((sumTot[3] - sumItg[3]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[3] - sumItg[3]), wexrow, 14, wexrow,14); }
 if ((sumTot[4] - sumItg[4]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[4] - sumItg[4]), wexrow, 15, wexrow,15); }
 if ((sumTot[5] - sumItg[5]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[5] - sumItg[5]), wexrow, 16, wexrow,16); }
 if ((sumTot[6] - sumItg[6]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[6] - sumItg[6]), wexrow, 17, wexrow,17); }
 if ((sumTot[7] - sumItg[7]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[7] - sumItg[7]), wexrow, 18, wexrow,18); }
 if ((sumTot[8] - sumItg[8]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[8] - sumItg[8]), wexrow, 10, wexrow, 10); }
 if ((sumTot[9] - sumItg[9]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[9] - sumItg[9]), wexrow, 11, wexrow, 11); }
 xlSetFontStyle(xlBold ,wexrow,1,wexrow,20);
 xlFrameCells(63, xlThin, 0, 0,wexrow,9,wexrow,20);
 xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,1);
 xlFrameCells(15, xlThin, 0, 0,wexrow,2,wexrow,8);

 //ДЗ - Итоговые суммы по отчету
 inc(wexrow);
 MyxlSetCellStringValue('Всего задолженности'          ,wexrow, 2,wexrow, 2);
 if (sumTot[0] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[0]), wexrow,  9, wexrow,  9); }
 if (sumTot[1] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[1]), wexrow, 12, wexrow, 12); }
 if (sumTot[2] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[2]), wexrow, 13, wexrow, 13); }
