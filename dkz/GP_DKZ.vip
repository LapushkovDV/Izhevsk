cmCheckField:
 {
   case CurField of

   #DlgOndate:SetAttrField(1,DlgOndate);
   #ReportTip: {
//      if ReportTip=1 or ReportTip=2 then DlgUSl_chk:=1;
       SetAttrField(3,ReportTip);
   }
   #EndDate:
    {
      if DlgOndate=1 then BegDate:=EndDate;
    }
   #DlgUslT: SetAttrField(2,DlgUslT);
   end;
  RereadRecord(#BuhRep);
  RereadRecord;

 }

end;
end.

