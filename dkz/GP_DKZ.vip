 if (sumTot[4] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[4]), wexrow, 15, wexrow, 15); }
 if (sumTot[5] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[5]), wexrow, 16, wexrow, 16); }
 if (sumTot[6] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[6]), wexrow, 17, wexrow, 17); }
 if (sumTot[7] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[7]), wexrow, 18, wexrow, 18); }
 if (sumTot[8] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[8]), wexrow, 10, wexrow, 10); }
 if (sumTot[9] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[9]), wexrow, 11, wexrow, 11); }
 xlSetFontStyle(xlBold ,wexrow,1,wexrow,20);
 xlFrameCells(63, xlThin, 0, 0,wexrow,9,wexrow,20);
 xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,1);
 xlFrameCells(15, xlThin, 0, 0,wexrow,2,wexrow,8);

 xlSetActiveSheet(2);
 MyxlSetCellStringValue('Расшифровка кредиторской задолженности (Крупные суммы)',1,1,1,1);
 MyxlSetCellStringValue(BuhRep.Name+' на '+datetostr(EndDate,'DD.MM.YYYY'),2,1,2,1);
 wexrow:=6;_Npp:=0;
 
 //Обнуление массивов итогов
 SetLimit(SumTot, 0);
 SetLimit(SumItg, 0); 
 
 if getfirst ttreesx where ((1 == tTreesx.dkz and 0 == ttreesx.cowner))=tsok
 {
   MyxlSetCellStringValue(ttreesx.name                      ,wexrow, 2,wexrow, 2);
   xlSetFontStyle(xlBold ,wexrow,1,wexrow,18);
   xlFrameCells(63, xlThin, 0, 0,wexrow,9,wexrow,18);
   xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,1);
   xlFrameCells(15, xlThin, 0, 0,wexrow,2,wexrow,8);
 }
 LevelString:=0;
 //====================================
 wexrow:=6;_Npp:=0;
 HeaderStrCount:=wexrow;
 MaxColCount:=18;
 wexrow++;
 MyXlCreaMatrix(1000,MaxColCount);
 wexrow--;
 //====================================
 RecursionPrint1(ttreesx.nrec,0);
 //====================================
 MyxlWriteMatrix(wexrow);
 xlFreeMatrix;
 matrixkl:=False;
 //====================================
 
 //КЗ - Итоговые суммы по крупнейшим организациям
 inc(wexrow); 
 MyxlSetCellStringValue('По крупным задолженностям всего' ,wexrow, 2,wexrow, 2);
 if (sumItg[0] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[0]), wexrow,  9, wexrow,  9);}
 if (sumItg[1] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[1]), wexrow, 10, wexrow, 10); }
 if (sumItg[2] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[2]), wexrow, 11, wexrow, 11); }
 if (sumItg[3] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[3]), wexrow, 12, wexrow, 12); }
 if (sumItg[4] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[4]), wexrow, 13, wexrow, 13); }
 if (sumItg[5] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[5]), wexrow, 14, wexrow, 14); }
 if (sumItg[6] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[6]), wexrow, 15, wexrow, 15); }
 if (sumItg[7] <> 0) { MyxlSetCellNumberValue(TochSum(sumItg[7]), wexrow, 16, wexrow, 16); }   
