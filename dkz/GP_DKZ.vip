function GetNumKau(_kodTabl : tTabKau; _wKau : Word): Word;
{
  Result := 0;
  
  If(_kodTabl[1] = _wKau) { Result := 1; Exit; }
  If(_kodTabl[2] = _wKau) { Result := 2; Exit; }
  If(_kodTabl[3] = _wKau) { Result := 3; Exit; }
  If(_kodTabl[4] = _wKau) { Result := 4; Exit; }
  If(_kodTabl[5] = _wKau) { Result := 5; Exit; }
  If(_kodTabl[6] = _wKau) { Result := 6; Exit; }
}

