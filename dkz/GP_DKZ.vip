#include userreport.vih
VipInterface UserReport_GP_DKZ Implements IUserReport;
Interface UserReport_GP_DKZ;

Procedure Run;
Begin
  RunInterfaceNoModal(GP_DKZ);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Формирование ДКЗ';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := 'ДКЗ';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
//    1 : VisibleInModule := 'B_BALANS';
    1 : VisibleInModule := 'B_FINANS';
  end;
end;
End.
