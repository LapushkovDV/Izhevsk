        { a_gr[i]:=oborot.dbscheto;
          if getfirst buhschet where ((oborot.scheto == buhschet.schet and ''== buhschet.SUBSCH))=tsok
          { a_cgr[i]:=buhschet.nrec;
            a_wgr[i]:=wDKZ_Sch;
