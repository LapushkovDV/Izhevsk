Function GetMinDate(d1, d2 : date) : date;
{
  if (d1 = ZeroDate)
    Result := d2;
  else
    if (d2 = ZeroDate)
      Result := d1;
    else
      Result := if(d1 < d2, d1, d2);
}//Function GetMinDate(d1, d2 : date) : date;

//=====================================================
//
//-----------------------------------------------------
Function GetMaXDate(d1, d2 : date) : date;
{
  if (d1 = ZeroDate)
    Result := d2;
  else
    if (d2 = ZeroDate)
      Result := d1;
    else
      Result := if(d1 > d2, d1, d2);
} //Function GetMaXDate(d1, d2 : date) : date;

//=====================================================
//
//-----------------------------------------------------
Function GetDaysProsr(_wdt:date):longint;
{ // кол-во дней просрочки
  Result:=if (_wdt = ZeroDate
   ,0
   ,if(_wdt >= EndDate
      , - CalcDaysBetweenDates(EndDate, _wdt, FALSE)
      , CalcDaysBetweenDates(_wdt, EndDate, FALSE)
      )
    )
} //Function GetDaysProsr(_wdt:date):longint;

//=====================================================
//
//-----------------------------------------------------
Function GetDaysProsr2(_wdt:date):longint;
{ // кол-во дней просрочки
  Result:=if (_wdt = ZeroDate
   ,0
   ,if(_wdt > EndDate
      , - CalcDaysBetweenDates(EndDate, _wdt, FALSE)+1
      , if (_wdt = EndDate,0,CalcDaysBetweenDates(_wdt, EndDate, FALSE)-1)
      )
    )
} //Function GetDaysProsr2(_wdt:date):longint;


