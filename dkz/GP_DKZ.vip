function GetGroupFromSchet(dkz:word;sch,subsch:string):word;cacheable;
var tS:string;
{
 Result:=0;
 ts:=Substr(sch,2,length(sch));
 if ts<>'76' then
 {
 ts:=string(dkz)+'.'+ts+'.'+subsch;
 case ts of
  '0.62.01','0.62.21','0.62.31': Result:=0;                                               //62.01, 62.21, 62.31
  '0.60.02','0.60.22','0.60.32': Result:=1;
  '1.62.02','1.62.22','1.62.32': Result:=0;
  '1.60.01','1.60.21','1.60.31': Result:=1;
 end;
 }
 else Result:=2;
}//function GetGroupFromSchet(dkz:word;sch,subsch:string):word;

