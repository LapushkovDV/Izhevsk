//=====================================================
// 2 'Справка к акту инвентаризации ИНВ-17'
//-----------------------------------------------------
procedure LOOP_PR3;
{
  inc(wexrow);
  inc(LevelString);
  MyxlSetCellNumberValue(LevelString                                           ,wexrow, 1,wexrow, 1);
  
  MyxlSetCellStringValue(tOborot.Kontr                                         ,wexrow, 2,wexrow, 2);
  //#EM-316 Выводить всегда первый уровень группировки для сотрудников 
  If(tOborot.wgr[1] = cgKau_Persons)
  {
    If(GetFirst FastFirstRow ttreesx where((tOborot.cTreeNode[1] == ttreesx.nrec)) = TsOk)
    { MyxlSetCellStringValue(ttreesx.name                                      ,wexrow, 2,wexrow, 2); }  
  }   
  
  MyxlSetCellStringValue(Substr(toborot.sch,2,length(toborot.sch))+if(toborot.subsch='','','.'+toborot.subsch)
                                                                                 ,wexrow, 3,wexrow, 3);
  
  If (tOborot.dname = '')
  {
    for(i:=1; i<=6; i++)
    {
      if (cgKau_KatSopr = tOborot.wgr[i])
      { 
        FillKatsoprProsr(Comp(tOborot.cgr[i])); Break; 
      }            
      Else if (cgKau_plpor   = tOborot.wgr[i])
      { 
        FillPlPorProsr(Comp(tOborot.cgr[i]));   Break;
      }      
      Else if (cgKau_BookPrZk = tOborot.wgr[i])
      {
        FillBookPrZkProsr(Comp(tOborot.cgr[i]));   Break; 
      }
      Else if (cgKau_VedDeponir = tOborot.wgr[i])
      {
        FillVedDeponirProsr(Comp(tOborot.cgr[i]));   Break; 
      }
    }
  }
  
  SetNaznaDopAnlt();
  If (tOborot.Nazna <> '')
  { MyxlSetCellStringValue(tOborot.Nazna                                     ,wexrow, 4,wexrow, 4); }
  
  if (tOborot.dvoznpr <> Zerodate)
  { MyxlSetCellStringValue(datetostr(tOborot.dvoznpr,'DD.MM.YYYY')           ,wexrow, 5,wexrow, 5); }

  MyxlSetCellStringValue(tOborot.dname                                       ,wexrow, 6,wexrow, 6);
  MyxlSetCellStringValue(tOborot.dnum                                        ,wexrow, 7,wexrow, 7);

  if (tOborot.dsopr   <> Zerodate)
  { MyxlSetCellStringValue(datetostr(tOborot.dsopr,'DD.MM.YYYY')             ,wexrow, 8,wexrow, 8); }

  if toborot.summa<>0 then
   MyxlSetCellNumberValue(TochSum(toborot.summa)                                ,wexrow, 9,wexrow, 9);
  if toborot.summa<>0 then
   MyxlSetCellNumberValue(TochSum(toborot.summa)                                ,wexrow,10,wexrow,10);
  if toborot.istek_summa<>0 then
   MyxlSetCellNumberValue(TochSum(toborot.istek_summa)                          ,wexrow,11,wexrow,11);
  MyxlSetCellStringValue(toborot.sMen                                          ,wexrow,13,wexrow,13);
  MyxlSetCellStringValue(toborot.sPodr                                         ,wexrow,14,wexrow,14);
  xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,14);
  itog1:=itog1+toborot.summa;
  itog2:=itog2+toborot.summa;
  itog3:=itog3+toborot.istek_summa;
} //procedure LOOP_PR3;

//=====================================================
// 2 'Справка к акту инвентаризации ИНВ-17'
//-----------------------------------------------------
procedure PR3(tip:word);
var ts1:string;
{
   ts1:='';
   xlSetActiveSheet(1);
   LevelString:=0;
  // if tip=1 then ts1:='Справка к инвентаризации расчетов с покупателями, поставщиками и прочими дебиторами и кредиторами';
 //  if tip=1 then ts1:='Справка к инвентаризации расчетов с покупателями, поставщиками и прочими дебиторами / кредиторами';
   if tip=2 then
    {
      ts1:='Перечень контрагентов с задолженностью свыше 3 лет';
     MyxlSetCellStringValue(ts1,12,1,12,1);
    }    
   //--- 'по счетам учёта: '+JORNTUNE.NAME
   if tip=1 then ts1:= getSchet_subschetDeb();// JORNTUNE.NAME;
   if tip=2 then ts1:='по счетам учёта: '+JORNTUNE.NAME;
   MyxlSetCellStringValue(ts1,14,1,14,1);
   MyxlSetCellStringValue(datetostr(EndDate, 'DD.MM.YYYY'),15,5,15,5);
   itog1:=0;
   itog2:=0;
   itog3:=0;
   wexrow:=24;
   //====================================
   HeaderStrCount:=wexrow;
   MaxColCount:=14;
   wexrow++;
   MyXlCreaMatrix(1000,MaxColCount);
   wexrow--;
   //====================================

   _lOOp tOborot where ((0 == toborot.dkz)) ordered by toborot.gr[1]
   { if not NextVisual then Exit;
     if tip=2 then
     {
       if toborot.sum_prosr[7]=0 then continue;
     }     
     LOOP_PR3;
     
   }
   //====================================
   MyxlWriteMatrix(wexrow);
   xlFreeMatrix;
   matrixkl:=False;
   //====================================
   inc(wexrow);
   MyxlSetCellStringValue('ИТОГО:',wexrow,2,wexrow,2);
   if itog1<>0 then MyxlSetCellNumberValue(TochSum(itog1)                                ,wexrow, 9,wexrow, 9);
   if itog2<>0 then MyxlSetCellNumberValue(TochSum(itog2)                                ,wexrow,10,wexrow,10);
   if itog3<>0 then MyxlSetCellNumberValue(TochSum(itog3)                                ,wexrow,11,wexrow,11);
   xlSetFontStyle(xlBold ,wexrow,1,wexrow,14);
   itog1:=0;
   itog2:=0;
   itog3:=0;

   xlSetActiveSheet(2);
   LevelString:=0;
   if tip=1 then
    {
      wexrow:=11;  
    }

   if tip=2 then
    {
      MyxlSetCellStringValue(datetostr(EndDate,'DD.MM.YYYY'),14,5,14,5);

      ts1:='Перечень контрагентов с задолженностью свыше 3 лет';
      MyxlSetCellStringValue(ts1,12,1,12,1);
      ts1:='по счетам учёта: '+JORNTUNE.NAME;
      MyxlSetCellStringValue(ts1,14,1,14,1);
      wexrow:=24;      
    }

   LevelString:=0;
   //====================================
   HeaderStrCount:=wexrow;
   MaxColCount:=14;
   wexrow++;
   MyXlCreaMatrix(1000,MaxColCount);
   wexrow--;
   //====================================
   _lOOp tOborot where ((1 == toborot.dkz)) ordered by toborot.gr[1]
   { if not NextVisual then Exit;
      if tip=2 then
     {
       if toborot.sum_prosr[7]=0 then continue;
     }

     LOOP_PR3;
   }
   //====================================
   MyxlWriteMatrix(wexrow);
   xlFreeMatrix;
   matrixkl:=False;
   //====================================
 inc(wexrow);
 MyxlSetCellStringValue('ИТОГО:',wexrow,2,wexrow,2);
 if itog1<>0 then MyxlSetCellNumberValue(TochSum(itog1)                                ,wexrow, 9,wexrow, 9);
 if itog2<>0 then MyxlSetCellNumberValue(TochSum(itog2)                                ,wexrow,10,wexrow,10);
 if itog3<>0 then MyxlSetCellNumberValue(TochSum(itog3)                                ,wexrow,11,wexrow,11);
 xlSetFontStyle(xlBold ,wexrow,1,wexrow,14);

   if tip=1 then
    {
     //#EM-316 Добавлены подписи
     //Подписи: суммы печатаются после подписей, а затем перемещаю подписи вниз - после сумм
     inc(wexrow);   
     xlCopyToBuff(9, 1, 9+2, MaxExcelCol);
     xlPasteAllFromBuff(wexrow, 1, wexrow+2, MaxExcelCol);
     xlDeleteRange(xlShiftUp, 9, 1, 9+2, MaxExcelCol);
     //снять выделение со скопированной области
     xlCopyToBuff(1, 1, 1, 1);
     xlPasteAllFromBuff(1, 1, 1, 1);
    } 
    
  xlSetActiveSheet(1);

} //procedure PR3(tip:word);

//=====================================================
// 3 'Дебиторская и кредиторская задолженность контрагентов свыше 3-х лет'
//-----------------------------------------------------
procedure PR4;
var ts1:string;
{
   ts1:='';
   xlSetActiveSheet(1);
   LevelString:=0;
   MyxlSetCellStringValue(datetostr(EndDate, 'DD Mon YYYY'),10,1,10,1);
   wexrow:=32;
   itog1:=0;
   itog2:=0;
   itog3:=0;
   //====================================
   HeaderStrCount:=wexrow;
   MaxColCount:=14;
   wexrow++;
   MyXlCreaMatrix(1000,MaxColCount);
   wexrow--;
   //====================================
   _lOOp tOborot where ((0 == toborot.dkz)) ordered by toborot.gr[1]
   { if not NextVisual then break;
     inc(wexrow);
     MyxlSetCellStringValue(tOborot.Kontr                                         ,wexrow, 1,wexrow, 1);
     MyxlSetCellStringValue(tOborot.INN                                         ,wexrow, 2,wexrow, 2);
     //#EM-315 Должны быть значения "Да" или "Нет" - в зависимости от того, входит или нет контрагент в группу компаний Роскосмос. (входимость организации в группу "03.Группа ОРКК")
     If (toborot.corg <> 0)     
     {
       MyxlSetCellStringValue(If(IsORKKGroup(toborot.corg), 'Да', 'Нет')             ,wexrow, 3,wexrow, 3);
     }
     
     SetNaznaDopAnlt();
     var tSN:string=tOborot.Nazna+if(tOborot.Nazna<>'',', ','')+tOborot.dname+' №'+ tOborot.dnum+' от ' + DateToStr(tOborot.dsopr,'DD.MM.YYYY');
     MyxlSetCellStringValue(tSN                                         ,wexrow, 4,wexrow, 4);
     if toborot.summa<>0 then
       MyxlSetCellNumberValue(TochSum(toborot.summa)                                ,wexrow, 5,wexrow, 5);
     if tOborot.dvoznpr<>Zerodate then
       MyxlSetCellStringValue(datetostr(tOborot.dvoznpr,'DD.MM.YYYY')               ,wexrow, 6,wexrow, 6);
     if tOborot.day_prosr<>0 then
       MyxlSetCellStringValue(Round(tOborot.day_prosr/12,0)                         ,wexrow, 7,wexrow, 7);
     xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,14);  
     itog1:=itog1+toborot.summa;
   } //_lOOp tOborot where ((0 == toborot.dkz)) ordered by toborot.gr[1]
   //====================================
   MyxlWriteMatrix(wexrow);
   xlFreeMatrix;
   matrixkl:=False;
   //====================================
   xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,14);

   inc(wexrow);
   MyxlSetCellStringValue('ИТОГО:',wexrow,2,wexrow,2);
   if itog1<>0 then MyxlSetCellNumberValue(TochSum(itog1)                                ,wexrow, 5,wexrow, 5);
   xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,14);
   xlSetFontStyle(xlBold ,wexrow,1,wexrow,14);
   
   //#EM-315 Добавлены подписи
   //Подписи: суммы печатаются после подписей, а затем перемещаю подписи вниз - после сумм
   inc(wexrow);   
   xlCopyToBuff(20, 1, 20+12, MaxExcelCol);
   xlPasteAllFromBuff(wexrow, 1, wexrow+12, MaxExcelCol);
   xlDeleteRange(xlShiftUp, 20, 1, 20+12, MaxExcelCol);
   //снять выделение со скопированной области
   xlCopyToBuff(1, 1, 1, 1);
   xlPasteAllFromBuff(1, 1, 1, 1);
} //procedure PR4;


//=====================================================
// 4 'Дебиторская и кредиторская задолженность контрагентов свыше 3-х лет' // 'Дебиторская и кредиторская задолженность с истекшим сроком исковой давности'
//-----------------------------------------------------
procedure LOOP_PR5;
{
 inc(wexrow);
 inc(LevelString);
 MyxlSetCellNumberValue(LevelString                                           ,wexrow, 1,wexrow, 1);
 MyxlSetCellStringValue(tOborot.Kontr                                         ,wexrow, 2,wexrow, 2);
 MyxlSetCellStringValue(Substr(toborot.sch,2,length(toborot.sch))+if(toborot.subsch='','','.'+toborot.subsch)
                                                                            ,wexrow, 3,wexrow, 3);

  If (tOborot.dname = '')
  {
    for(i:=1; i<=6; i++)
    {
      if (cgKau_KatSopr = tOborot.wgr[i])
      { 
        FillKatsoprProsr(Comp(tOborot.cgr[i])); Break;
      }      
      Else if (cgKau_plpor   = tOborot.wgr[i])
      {
        FillPlPorProsr(Comp(tOborot.cgr[i]));   Break;
      }
      Else if (cgKau_BookPrZk = tOborot.wgr[i])
      {
        FillBookPrZkProsr(Comp(tOborot.cgr[i]));   Break; 
      }      
      Else if (cgKau_VedDeponir = tOborot.wgr[i])
      {
        FillVedDeponirProsr(Comp(tOborot.cgr[i]));   Break; 
      }      
    }
  }
 SetNaznaDopAnlt();                                                                            
 MyxlSetCellStringValue(tOborot.Nazna                                         ,wexrow, 4,wexrow, 4);
 if tOborot.dvoznpr<>Zerodate then
   MyxlSetCellStringValue(datetostr(tOborot.dvoznpr,'DD.MM.YYYY')               ,wexrow, 5,wexrow, 5);
 MyxlSetCellStringValue(tOborot.dname                                         ,wexrow, 6,wexrow, 6);
 MyxlSetCellStringValue(tOborot.dnum                                          ,wexrow, 7,wexrow, 7);
 if tOborot.dsopr<>Zerodate then
   MyxlSetCellStringValue(datetostr(tOborot.dsopr,'DD.MM.YYYY')                 ,wexrow, 8,wexrow, 8);
 if toborot.istek_summa<>0 then
   MyxlSetCellNumberValue(TochSum(toborot.istek_summa)                          ,wexrow, 9,wexrow, 9);
 MyxlSetCellStringValue('резерв'                                              ,wexrow,10,wexrow,10);
 if toborot.istek_summa<>0 then
   MyxlSetCellNumberValue(TochSum(toborot.istek_summa)                          ,wexrow,11,wexrow,11);
 MyxlSetCellStringValue(toborot.sMen                                          ,wexrow,13,wexrow,13);
 MyxlSetCellStringValue(toborot.sPodr                                         ,wexrow,14,wexrow,14);
 xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,14);
 itog1:=itog1+toborot.istek_summa;
 itog2:=itog2+toborot.istek_summa;
 itog3:=itog3+toborot.istek_summa;
} //procedure LOOP_PR5;

//=====================================================
// 4 'Дебиторская и кредиторская задолженность контрагентов свыше 3-х лет' // 'Дебиторская и кредиторская задолженность с истекшим сроком исковой давности'
//-----------------------------------------------------
procedure PR5;
var ts1:string;
{
 ts1:='';
 xlSetActiveSheet(1);
 wexrow:=17;
 LevelString:=0;
 ts1:='Перечень дебиторской и кредиторской задолженности с истекшим сроком исковой давности по состоянию на '+datetostr(EndDate, 'DD.MM.YYYY');
 MyxlSetCellStringValue(ts1,8,1,8,1);
 itog1:=0;
