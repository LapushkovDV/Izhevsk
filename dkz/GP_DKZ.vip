TabbedSheet top MyTabbedTree;
tree trCat 'Дебиторская задолженность' (, hcStaffViewCatalogs, sci14EscTreeG);
  table tTreeD;
fields {font={BackColor=if((tTreeD.grLv=wDKZ_OrgSchSubSch Or tTreeD.grLv=cgKau_KatOrg Or tTreeD.grLv=cgKau_Dogovor) And Round(tTreeD.summa-tTreeD.sumDoc, 2)<>0,ColorError,0)}};
