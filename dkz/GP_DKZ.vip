//=====================================================
// 6 'Дебиторская и кредиторская задолженность'
//-----------------------------------------------------
procedure LOOP_PR7;
var c1,c2,c3,c4,c5,c6:double;
{
 inc(wexrow);
 MyxlSetCellStringValue(tOborot.Kontr                                         ,wexrow, 4,wexrow, 4);

 if toborot.cdog<>0 then MyxlSetCellStringValue(ShowKau(cgKau_Dogovor,toborot.cdog),wexrow, 5,wexrow, 5);
 
  //#EM-316 не отображается документ
  If (tOborot.dname = '')
  {
    for(i:=1; i<=6; i++)
    {
      if (cgKau_KatSopr = tOborot.wgr[i])
      { 
        FillKatsoprProsr(Comp(tOborot.cgr[i])); Break; 
      }            
      Else if (cgKau_plpor   = tOborot.wgr[i])
      { 
        FillPlPorProsr(Comp(tOborot.cgr[i]));   Break;
      }      
      Else if (cgKau_BookPrZk = tOborot.wgr[i])
      {
        FillBookPrZkProsr(Comp(tOborot.cgr[i]));   Break; 
      }
      Else if (cgKau_VedDeponir = tOborot.wgr[i])
      {
        FillVedDeponirProsr(Comp(tOborot.cgr[i]));   Break; 
      }
    }
  }  
  SetNaznaDopAnlt();
 
 //#EM-316 не отображается документ
 if tOborot.dname<>'' then 
 {MyxlSetCellStringValue(tOborot.dname+' '+tOborot.dnum+' от '+DateToStr(tOborot.dSopr,'DD/MM/YYYY г.'),wexrow, 6,wexrow, 6); } 
 else if toborot.kauos[7]<>0 then 
 {MyxlSetCellStringValue(ShowKau(tOborot.tblos[7],tOborot.kauos[7]),wexrow, 6,wexrow, 6); }

 MyxlSetCellStringValue(Substr(toborot.sch,2,length(toborot.sch))+if(toborot.subsch='','','.'+toborot.subsch)
                                                                            ,wexrow, 7,wexrow, 7);


 if tOborot.day_prosr<>0 then
  MyxlSetCellNumberValue(tOborot.day_prosr               ,wexrow, 8,wexrow, 8);

 c1:=c2:=c3:=c4:=c5:=c6:=0;
 c1:=toborot.summa;
 if tOborot.day_prosr<=0 then c2:=toborot.summa;
  else
   {
     c3:=toborot.sum_prosr[2]+toborot.sum_prosr[3];
     c4:=toborot.sum_prosr[4]+toborot.sum_prosr[5];
     c5:=toborot.sum_prosr[6];
     c6:=toborot.sum_prosr[7];
   }
 if c1<>0 then MyxlSetCellNumberValue(TochSum(c1)                                ,wexrow, 9,wexrow, 9);
 if c2<>0 then MyxlSetCellNumberValue(TochSum(c2)                                ,wexrow,10,wexrow,10);
 if c3<>0 then MyxlSetCellNumberValue(TochSum(c3)                                ,wexrow,11,wexrow,11);
 if c4<>0 then MyxlSetCellNumberValue(TochSum(c4)                                ,wexrow,12,wexrow,12);
 if c5<>0 then MyxlSetCellNumberValue(TochSum(c5)                                ,wexrow,13,wexrow,13);
 if c6<>0 then MyxlSetCellNumberValue(TochSum(c6)                                ,wexrow,14,wexrow,14);

 MyxlSetCellStringValue(toborot.sPodr                                         ,wexrow,15,wexrow,15);
 MyxlSetCellStringValue(toborot.sMen                                          ,wexrow,16,wexrow,16);
 MyxlSetCellStringValue(toborot.sDDS                                           ,wexrow,17,wexrow,17);
 MyxlSetCellStringValue(toborot.sCO                                           ,wexrow,18,wexrow,18);
 xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,18);
 itog1:=itog1+c1;
 itog2:=itog2+c2;
 itog3:=itog3+c3;
 itog4:=itog4+c4;
 itog5:=itog5+c5;
 itog6:=itog6+c6;
} //procedure LOOP_PR7;



procedure LOOP_PR10;
var c1,c2,c3,c4,c5,c6:double;
{
   var nextRow: integer = 0;


   if (curcOrg <> tOborot.cOrg){
      inc(wexrow);
      MyxlSetCellStringValue(tOborot.Kontr,wexrow,1,wexrow,1); // Организация
      curcOrg := tOborot.cOrg;
      xlSetFontStyle(xlBold ,wexrow,1,wexrow,1);
      xlSetBackColor(0D9D9D9h  ,wexrow,1,wexrow,11);

      xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,11);

      curOrgRow := wexrow;


      SumItogo1 := SumItogo1 + curOrgSum1;
      SumItogo2 := SumItogo2 + curOrgSum2;
      SumItogo3 := SumItogo3 + curOrgSum3;

      curOrgSum1 := curOrgSum2 := curOrgSum3 := sumDzOrg := 0;


      sumKzOrg := 0;

      _loop tOborot10 where ((1 == tOborot10.dkz and curcOrg == tOborot10.cOrg (noindex) )) ordered by tOborot10.gr[1] {
        if (not NextVisual) {
           exit;
        }
        if tOborot10.tip=2 and tOborot10.sum_prosr[7]=0 {
           continue;
        }
        if(tOborot10.Summa > 0) {
          sumKzOrg := sumKzOrg + tOborot10.Summa;
        }
      }
      MyxlSetCellStringValue(sumKzOrg,curOrgRow,6,curOrgRow,6);
      //MyxlSetCellStringValue('='+'ЕСЛИ(RC[-3]-RC[-1]<=0;0;RC[-3]-RC[-1])'
      //MyxlSetCellStringValue(sumKzOrg,curOrgRow,7,curOrgRow,7);
      //xlSetCellFormula('= ЕСЛИ(D5-F5 <= 0; 0; D5-F5)', curOrgRow, 7, curOrgRow, 7);
      xlSetCellFormula('= ЕСЛИ(D'+curOrgRow+'-F'+curOrgRow+' <= 0; 0; D'+curOrgRow+'-F'+curOrgRow+')', curOrgRow, 7, curOrgRow, 7);
      xlSetCellFormula('=(ЕСЛИ(D'+curOrgRow+'-F'+curOrgRow+' < 0; F'+curOrgRow+'-D'+curOrgRow+'; 0))', curOrgRow, 8, curOrgRow, 8); //остаток КЗ
      xlSetCellFormula('=ЕСЛИ(И(H'+curOrgRow+'>=0;(C'+curOrgRow+'-H'+curOrgRow+')<>0;(C'+curOrgRow+'-H'+curOrgRow+')>0);C'+curOrgRow+'-H'+curOrgRow+';0)', curOrgRow, 9, curOrgRow, 9);
      xlSetCellFormula('=I'+curOrgRow+'*50/100', curOrgRow, 10, curOrgRow, 10);
      xlSetCellFormula('=G'+curOrgRow+'+J'+curOrgRow+'', curOrgRow, 11, curOrgRow, 11);

   }




   if (toborot.cdog <> 0 and toborot.cdog <> curcDog) {
      inc(wexrow);
      MyxlSetCellStringValue('    ' + ShowKau(cgKau_Dogovor,toborot.cdog),wexrow,1,wexrow,1); // Договор
      curcDog := toborot.cdog;
      xlSetFontStyle(xlItalic ,wexrow,1,wexrow,1);
      xlSetBackColor(0F7F7F7h ,wexrow,1,wexrow,11);
      xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,11);


      curDogRow := wexrow;
      curDogSum1 := curDogSum2 := curDogSum3 := sumDzDog := 0;

   }

   if (tOborot.dname = '') {
      for(i:=1; i<=6; i++) {
         if (cgKau_KatSopr = tOborot.wgr[i]) {
            FillKatsoprProsr(Comp(tOborot.cgr[i])); Break;
         } else if (cgKau_plpor = tOborot.wgr[i]) {
            FillPlPorProsr(Comp(tOborot.cgr[i])); Break;
         } else if (cgKau_BookPrZk = tOborot.wgr[i]) {
            FillBookPrZkProsr(Comp(tOborot.cgr[i])); Break;
         }
      }
   }
   SetNaznaDopAnlt();

   if tOborot.dname <> '' {       // Документ
      inc(wexrow);
      MyxlSetCellStringValue('      ' + tOborot.dname+' '+tOborot.dnum+' от '+DateToStr(tOborot.dSopr,'DD/MM/YYYY г.'),wexrow,1,wexrow,1);
      xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,11);
   } else if toborot.kauos[7]<>0 {
      inc(wexrow);
      MyxlSetCellStringValue(ShowKau(tOborot.tblos[7],tOborot.kauos[7]),wexrow,1,wexrow,1);
      xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,11);
   }

   //if tOborot.day_prosr <> 0 {
      //MyxlSetCellNumberValue(tOborot.day_prosr,wexrow,7,wexrow,7); // Дней просрочки        //стереть

      if (tOborot.day_prosr < 45) {
        if (toborot.summa < 0) {
          MyxlSetCellNumberValue(0,wexrow, 2,wexrow, 2);
        } else {
          MyxlSetCellNumberValue(TochSum(toborot.summa),wexrow, 2,wexrow, 2);
          curOrgSum1 := curOrgSum1 + tOborot.summa;
          curDogSum1 := curDogSum1 + tOborot.summa;
        }
      }
      if (tOborot.day_prosr >= 45 and tOborot.day_prosr <= 90) {
        if (toborot.summa < 0) {
          MyxlSetCellNumberValue(0,wexrow, 3,wexrow, 3);
        } else {
          MyxlSetCellNumberValue(TochSum(toborot.summa),wexrow, 3,wexrow, 3);
          curOrgSum2 := curOrgSum2 + tOborot.summa;
          curDogSum2 := curDogSum2 + tOborot.summa;
        }
      }
      if (tOborot.day_prosr > 90) {
        if (toborot.summa < 0) {
          MyxlSetCellNumberValue(0,wexrow, 4,wexrow, 4);
        } else {
          MyxlSetCellNumberValue(TochSum(toborot.summa),wexrow, 4,wexrow, 4);
          curOrgSum3 := curOrgSum3 + tOborot.summa;
          curDogSum3 := curDogSum3 + tOborot.summa;
        }
      }

      sumDzOrg  := curOrgSum1+curOrgSum2+curOrgSum3;
      sumDzDog  := curDogSum1+curDogSum2+curDogSum3;

   //} endof if tOborot.day_prosr <> 0

   //if (curOrgRow <> 0) {

        nextRow := wexrow;

        MyxlSetCellNumberValue(curOrgSum1,curOrgRow, 2,curOrgRow, 2);
        MyxlSetCellNumberValue(curOrgSum2,curOrgRow, 3,curOrgRow, 3);
        MyxlSetCellNumberValue(curOrgSum3,curOrgRow, 4,curOrgRow, 4);
        MyxlSetCellNumberValue(sumDzOrg  ,curOrgRow, 5,curOrgRow, 5);
        wexrow :=  nextRow;

   //}
   //if (curDogRow <> 0) {

        nextRow := wexrow;

        MyxlSetCellNumberValue(curDogSum1,curDogRow, 2,curDogRow, 2);
        MyxlSetCellNumberValue(curDogSum2,curDogRow, 3,curDogRow, 3);
        MyxlSetCellNumberValue(curDogSum3,curDogRow, 4,curDogRow, 4);
        MyxlSetCellNumberValue(sumDzDog  ,curDogRow, 5,curDogRow, 5);

        wexrow :=  nextRow;
   //}



   //MyxlSetCellStringValue(toborot.sMen,wexrow,15,wexrow,15);
   //MyxlSetCellStringValue(toborot.sPodr,wexrow,16,wexrow,16);
   //MyxlSetCellStringValue(toborot.sDDS,wexrow,17,wexrow,17);
   //MyxlSetCellStringValue(toborot.sCO,wexrow,18,wexrow,18);

   //xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,18);
   itog1:=itog1+c1;
   itog2:=itog2+c2;
   itog3:=itog3+c3;
   itog4:=itog4+c4;
   itog5:=itog5+c5;
   itog6:=itog6+c6;

} //procedure LOOP_PR10;



