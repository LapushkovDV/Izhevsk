table struct local tmp_katSopr
(   cKatSopr:comp
  , cPlPor  :comp
  , DSopr   :date
  , Direct  :integer
  , Summa   :tSumma
  , SumVal  :tSumma
) with index
( tmp_katSopr01=Dsopr
);


//===================================
table struct local tmp_saldo
(  cKatOrg  :comp
  ,cDogovor :comp
  ,DateProsrT:date
  ,DateProsrO:date
  ,dVoznPr   :date
  ,MaxD      :date
  ,MinD      :date
  ,nazna     :string
  ,dname     :string
  ,dnum      :string[30]
  ,dsopr     :date
)
with index
( tmp_saldo01 = cKatOrg+ cDogovor
);

//============================
table STRUCT tTreeS                 //Для хранения результатов
(
   NRec      :comp
  ,Name      :string
  ,cOwner    :comp
  ,summa     :double
  ,cSoprDoc :comp
  ,tidkgal  :word
  ,node:word
  ,DateProsrT: date
  ,DateProsrO: date
  ,MinD:date
  ,MaxD:date
  ,dVoznPr   :date
  ,day_Prosr :longint
  ,cPodr:comp
  ,cMen:comp
  ,cDDS:comp
  ,cCO:comp
  ,sPodr:string
  ,sMen:string
  ,sDDS:string
  ,sCO:string
  ,schet : string [10]
  ,istek_summa:double
  ,sum_prosr       :array[1..10] of double
  ,summaR   :double "Резерв на начало периода"
  ,summaIn  :double "Встречные обязательства"
  ,sum_dop         :array[1..10] of double
  ,Kontr:string
  ,inn:string[30]
  ,Nazna:string
  ,dname:string
  ,dnum:string[20]
  ,dsopr:date
  ,dkz:word
  ,wOb:word
  ,ogrn:string
  ,grLv:String
  ,sumDoc:Double
)
with index
(
  tTreeS01  = NRec (Unique,AutoInc),
  tTreeS02  = dkz+cOwner+dSopr,
  tTreeS03  = cOwner,
  tTreeS04  = name+dkz,
  tTreeS05  = schet

)
;
//===================================
table STRUCT MemNastr
(
   sch          :string
  ,subsch       :string
  ,schk         :string
  ,subschk      :string
  ,TBLOS       :array[1..6] of word
  ,kauos       :array[1..6] of comp
  ,TBLKS       :array[1..6] of word
  ,kauks       :array[1..6] of comp
  ,tip          :word
  ,dkz          :word
  ,saldo        :word
  ,cOwner      :comp

)
with index
(
  MemNastr01  = sch+subsch,
  MemNastr02  = tip+sch+schk+dkz+saldo
)
;


