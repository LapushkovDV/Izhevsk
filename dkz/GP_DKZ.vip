  } //2
  end;
} //procedure LoadGroup(tip:word);


//================================
//
//--------------------------------
procedure SetSumNode(cc:comp;Sum:double);
{
  if getfirst ttreesX where ((cc == ttreesX.nrec))=tsok then
  {
//    set ttreesX.summa:=Sum;
    ttreesX.sumDoc:=0; 
    ttreesX.summa:=0;
    ttreesX.tidkgal:=0;
    ttreesX.csoprdoc:=0;
    tTreesX.day_Prosr:=0;
    tTreesX.sum_prosr[1]:=0;
    tTreesx.sum_prosr[2]:=0;
    tTreesx.sum_prosr[3]:=0;
    tTreesx.sum_prosr[4]:=0;
    tTreesx.sum_prosr[5]:=0;
    tTreesx.sum_prosr[6]:=0;
    tTreesx.sum_prosr[7]:=0;
    tTreesx.istek_summa :=0;
    ttreesX.summaR      :=0;
    ttreesX.summaIN     :=0;
    tTreesX.sum_dop[1]  :=0;
    tTreesx.sum_dop[2]  :=0;
    tTreesx.sum_dop[3]  :=0;
    tTreesx.sum_dop[4]  :=0;
    tTreesx.sum_dop[5]  :=0;
    tTreesx.sum_dop[6]  :=0;
    tTreesx.sum_dop[7]  :=0;
 //   set tTreesx.minD:=ZeroDate;
//    set tTreesx.maxD:=ZeroDate;

    set tTreesx.sPodr:='';
    set tTreesx.sMen:='';
    set tTreesx.sDDS:='';
    set tTreesx.sCO:='';
    set tTreesx.node:=1;



    update current ttreesX;
    _log('ttreesX.name = '+cc+'   '+Sum);
  } //if getfirst ttreesX where ((cc == ttreesX.nrec))=tsok then
} //procedure SetSumNode(cc:comp;Sum:double);


//================================
//
//--------------------------------
procedure TreeBuilding(dkz:word);
var oldc1,oldc2,oldc3,oldc4,oldc5,oldc6,cc,cc1,cc2,cc3,cc4,cc5,cc6:String='0';
    SumNode,Sum,Sum1,Sum2,Sum3,Sum4,Sum5:double;
{
        StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Постраение иерархии по '+if(dkz=0,'дебету','кредиту'), RecordsInTable(tntOborot));
        _log('TreeBuilding');
        ClearBuffer(#ttreest);
        set ttreest.dkz:=  dkz;
        set ttreest.name:=JornTune.name;
        set ttreest.cowner:=0;
        insert current ttreest;
!        if Timelog_Status>0
        { _log('TreeBuilding = '+ttreest.nrec);
          _log('TreeTIP = '+dkz);
          _log('JornTune.tblos[1] = '+JornTune.tblos[1]);
          _log('JornTune.tblos[2] = '+JornTune.tblos[2]);
          _log('JornTune.tblos[3] = '+JornTune.tblos[3]);
          _log('JornTune.tblos[4] = '+JornTune.tblos[4]);
          _log('JornTune.tblos[5] = '+JornTune.tblos[5]);
          _log('JornTune.tblos[6] = '+JornTune.tblos[6]);
        }
        cc:=ttreest.nrec;
        Sum:=0;oldc1:=-1;Sum1:=0;Sum2:=0;Sum3:=0;Sum4:=0;Sum5:=0;SumNode:=0;
        if JornTune.tblos[1]<>0 then
        _loop tOborot where ((   dkz == tOborot.dkz and (3>tOborot.tip)       ))  ordered by toborot.gr[1]
        {
         If Not NextVisual
         {Break;}
         
#Declare SetCTreeNode(tOborot,cc,cc1,cc2,cc3,cc4,cc5,cc6)
          #tOborot.cTreeNode[0] := #cc;
          #tOborot.cTreeNode[1] := #cc1;
          #tOborot.cTreeNode[2] := #cc2;
          #tOborot.cTreeNode[3] := #cc3;
          #tOborot.cTreeNode[4] := #cc4;
          #tOborot.cTreeNode[5] := #cc5;
          #tOborot.cTreeNode[6] := #cc6;
          If(update Current #tOborot = TsOk)
          {}
#end      
          if oldc1=tOborot.cgr[1] then continue; else oldc1:=tOborot.cgr[1];
          ClearBuffer(#ttreest);
          ttreest.name:=GetNameLevel(tOborot.gr[1]);
          ttreest.grLv:=JornTune.tblos[1];
          ttreest.dkz:=  tOborot.dkz;
          ttreest.cowner:=cc;
          //------------------------------
          ttreest.sumDoc      := tOborot.sumDoc;
          ttreest.summa       := tOborot.summa;
          tTreest.schet       := tOborot.schet;
          tTreest.day_Prosr   := tOborot.day_Prosr;
          tTreest.sum_prosr[1]:= tOborot.sum_prosr[1];
          tTreest.sum_prosr[2]:= tOborot.sum_prosr[2];
          tTreest.sum_prosr[3]:= tOborot.sum_prosr[3];
          tTreest.sum_prosr[4]:= tOborot.sum_prosr[4];
          tTreest.sum_prosr[5]:= tOborot.sum_prosr[5];
          tTreest.sum_prosr[6]:= tOborot.sum_prosr[6];
          tTreest.sum_prosr[7]:= tOborot.sum_prosr[7];
          tTreest.sPodr       := tOborot.sPodr;
          tTreest.sMen        := tOborot.sMen;
          tTreest.sDDS        := tOborot.sDDS;
          tTreest.sCO         := tOborot.sCO;
          tTreest.tidkgal     := tOborot.tidkgal;
          tTreest.csoprdoc    := tOborot.csoprdoc;
          tTreest.mind        := tOborot.mind;
          tTreest.maxd        := tOborot.maxd;
          tTreest.dnum        := tOborot.dnum; 
          tTreest.dsopr       := tOborot.dsopr;
          tTreest.Kontr       := tOborot.Kontr;
          tTreest.inn         := tOborot.inn;
          tTreest.ogrn        := tOborot.ogrn;
          tTreest.istek_summa := tOborot.istek_summa;
          //------------------------------------------
          case ReportTip of
          9:
          { tTreest.summaR      := tOborot.summaR;//2
            tTreest.summaIn     := tOborot.summaIn;//5
            //06 Учтено при формировании резерва сомнительных долгов П.4-П.5
            tTreest.sum_dop[1]  := tOborot.istek_summa-tOborot.summaIn;
            //07 Расходы за период суммарно П.6-П.2'
            tTreest.sum_dop[2]  := tTreest.sum_dop[1]-tTreest.summaR;
            //08 Доходы за период, счет 91.01.7 ЕСЛИ(П.7<0;П.7;0)
            tTreest.sum_dop[3]  := if(tTreest.sum_dop[2]<0,tTreest.sum_dop[2],0);
            //09 Расходы за период, счет 91.02.7 =ЕСЛИ(П.7>0;П.7;0)
            tTreest.sum_dop[4]  := if(tTreest.sum_dop[2]>0,tTreest.sum_dop[2],0);
          }
          end;
          //--------------------------------
          insert current ttreest;          
          //--------------------------------
          SumNode:=SumNode+tOborot.summa;
          cc1:=ttreest.nrec;
          #SetCTreeNode(tOborot,cc,cc1,0,0,0,0,0)
          if JornTune.tblos[2]<>0 then
           if getfirst tOborot1 where ((dkz == tOborot1.dkz
              and tOborot.cgr[1] == tOborot1.cgr[1]
              and (3>tOborot1.tip) )) = tsok then
           {
             Sum1:=0;oldc2:=-1;Sum2:=0;Sum3:=0;Sum4:=0;Sum5:=0;SumNode:=0;
             _loop tOborot1 where ((dkz == tOborot1.dkz
               and tOborot.cgr[1] == tOborot1.cgr[1]
               and (3>tOborot1.tip) ))
             {             
              //   _log(GetNameLevel(tOborot1.gr[2])+'    '+oldc2+'    '+tOborot1.cgr[2]);
               if oldc2=tOborot1.cgr[2] then continue; else oldc2:=tOborot1.cgr[2];
               //      _log('new');
               ClearBuffer(#ttreest);
               ttreest.name:= GetNameLevel(tOborot1.gr[2]);
               ttreest.grLv:= JornTune.tblos[2];
               ttreest.dkz:=  tOborot1.dkz;
               ttreest.cowner:=cc1;
               ttreest.sumDoc:=tOborot1.sumDoc;
               ttreest.summa:=tOborot1.summa;
               //--------------------------------------------
               tTreest.schet:=                   tOborot1.schet;
               tTreest.day_Prosr:=               tOborot1.day_Prosr;
               tTreest.sumDoc:=                  tOborot1.sumDoc;
               tTreest.summa:=                   tOborot1.summa;
               tTreest.sum_prosr[1]:=            tOborot1.sum_prosr[1];
               tTreest.sum_prosr[2]:=            tOborot1.sum_prosr[2];
               tTreest.sum_prosr[3]:=            tOborot1.sum_prosr[3];
               tTreest.sum_prosr[4]:=            tOborot1.sum_prosr[4];
               tTreest.sum_prosr[5]:=            tOborot1.sum_prosr[5];
               tTreest.sum_prosr[6]:=            tOborot1.sum_prosr[6];
               tTreest.sum_prosr[7]:=            tOborot1.sum_prosr[7];
               tTreest.sPodr:=                   tOborot1.sPodr;
               tTreest.sMen:=                    tOborot1.sMen;
               tTreest.sDDS:=                    tOborot1.sDDS;
               tTreest.sCO:=                     tOborot1.sCO;
               tTreest.tidkgal:=                 tOborot1.tidkgal;
               tTreest.csoprdoc:=                tOborot1.csoprdoc;
               tTreest.mind:=                    tOborot1.mind;
               tTreest.dnum:=                    tOborot1.dnum; 
               tTreest.dsopr:=                   tOborot1.dsopr;               
               tTreest.Kontr:=                   tOborot1.Kontr;
               tTreest.inn:=                     tOborot1.inn;
               tTreest.ogrn:=                    tOborot1.ogrn;
               tTreest.maxd:=                    tOborot1.maxd;
               tTreest.istek_summa:=             tOborot1.istek_summa;
               //------------------------------------------
               case ReportTip of
               9:
               { tTreest.summaR      := tOborot1.summaR;//2
                 tTreest.summaIn     := tOborot1.summaIn;//5
                 //06 Учтено при формировании резерва сомнительных долгов П.4-П.5
                 tTreest.sum_dop[1]  := tOborot1.istek_summa-tOborot1.summaIn;
                 //07 Расходы за период суммарно П.6-П.2'
                 tTreest.sum_dop[2]  := tTreest.sum_dop[1]-tTreest.summaR;
                 //08 Доходы за период, счет 91.01.7 ЕСЛИ(П.7<0;П.7;0)
                 tTreest.sum_dop[3]  := if(tTreest.sum_dop[2]<0,tTreest.sum_dop[2],0);
                 //09 Расходы за период, счет 91.02.7 =ЕСЛИ(П.7>0;П.7;0)
                 tTreest.sum_dop[4]  := if(tTreest.sum_dop[2]>0,tTreest.sum_dop[2],0);
               }
               end;
               //--------------------------------------------
               insert current ttreest;
               SumNode:=SumNode+tOborot1.summa;
               //--------------------------------------------
               cc2:=ttreest.NRec;
               #SetCTreeNode(tOborot1,cc,cc1,cc2,0,0,0,0)
               if JornTune.tblos[3]<>0 then
               if getfirst tOborot2 where ((   dkz == tOborot2.dkz and tOborot1.cgr[1] == tOborot2.cgr[1]  and
                                            tOborot1.cgr[2] == tOborot2.cgr[2]
                                            and (3>tOborot2.tip)
                                            )) = tsok then
               {
                 Sum2:=0;oldc3:=-1;Sum3:=0;Sum4:=0;Sum5:=0;SumNode:=0;
                 _loop tOborot2 where ((      dkz == tOborot2.dkz and
                                         tOborot1.cgr[1] == tOborot2.cgr[1]  and
                                         tOborot1.cgr[2] == tOborot2.cgr[2]
                                         and (3>tOborot2.tip)
                                         ))
                 {                 
                   if oldc3=tOborot2.cgr[3] then continue; else oldc3:=tOborot2.cgr[3];
                   ClearBuffer(#ttreest);
                   ttreest.name:= GetNameLevel(tOborot2.gr[3]);
                   ttreest.grLv:= JornTune.tblos[3];
                   ttreest.dkz:=  tOborot2.dkz;
                   ttreest.cowner:=cc2;
                   ttreest.sumDoc:=tOborot2.sumDoc;
                   ttreest.summa:=tOborot2.summa;
                   //-------------------------------------------
                   tTreest.schet:=                   tOborot2.schet;
                   tTreest.day_Prosr:=               tOborot2.day_Prosr;
                   tTreest.sumDoc:=                  tOborot2.sumDoc;
                   tTreest.summa:=                   tOborot2.summa;
                   tTreest.sum_prosr[1]:=            tOborot2.sum_prosr[1];
                   tTreest.sum_prosr[2]:=            tOborot2.sum_prosr[2];
                   tTreest.sum_prosr[3]:=            tOborot2.sum_prosr[3];
                   tTreest.sum_prosr[4]:=            tOborot2.sum_prosr[4];
                   tTreest.sum_prosr[5]:=            tOborot2.sum_prosr[5];
                   tTreest.sum_prosr[6]:=            tOborot2.sum_prosr[6];
                   tTreest.sum_prosr[7]:=            tOborot2.sum_prosr[7];
                   tTreest.sPodr:=                   tOborot2.sPodr;
                   tTreest.sMen:=                    tOborot2.sMen;
                   tTreest.sDDS:=                    tOborot2.sDDS;
                   tTreest.sCO:=                     tOborot2.sCO;
                   tTreest.tidkgal:=                 tOborot2.tidkgal;
                   tTreest.csoprdoc:=                tOborot2.csoprdoc;
                   tTreest.mind:=                    tOborot2.mind;
                   tTreest.dnum:=                    tOborot2.dnum;
                   tTreest.dsopr:=                   tOborot2.dsopr;
                   tTreest.Kontr:=                   tOborot2.Kontr;
                   tTreest.inn:=                     tOborot2.inn;
                   tTreest.ogrn:=                    tOborot2.ogrn;
                   tTreest.maxd:=                    tOborot2.maxd;
                   tTreest.istek_summa:=             tOborot2.istek_summa;
                   //------------------------------------------
                   case ReportTip of
                   9:
                   { tTreest.summaR      := tOborot2.summaR;//2
                     tTreest.summaIn     := tOborot2.summaIn;//5
                     //06 Учтено при формировании резерва сомнительных долгов П.4-П.5
                     tTreest.sum_dop[1]  := tOborot2.istek_summa-tOborot2.summaIn;
                     //07 Расходы за период суммарно П.6-П.2'
                     tTreest.sum_dop[2]  := tTreest.sum_dop[1]-tTreest.summaR;
                     //08 Доходы за период, счет 91.01.7 ЕСЛИ(П.7<0;П.7;0)
                     tTreest.sum_dop[3]  := if(tTreest.sum_dop[2]<0,tTreest.sum_dop[2],0);
                     //09 Расходы за период, счет 91.02.7 =ЕСЛИ(П.7>0;П.7;0)
                     tTreest.sum_dop[4]  := if(tTreest.sum_dop[2]>0,tTreest.sum_dop[2],0);
                   }
                   end;
                   //--------------------------------
                   insert current ttreest;
                   SumNode:=SumNode+tOborot2.summa;
                   //--------------------------------
                   cc3:=ttreest.NRec;
                   #SetCTreeNode(tOborot2,cc,cc1,cc2,cc3,0,0,0)
                   if JornTune.tblos[4]<>0 then
                     if getfirst tOborot3 where (( dkz    == tOborot3.dkz and
                                                tOborot2.cgr[1] == tOborot3.cgr[1]  and
                                                tOborot2.cgr[2] == tOborot3.cgr[2]  and
                                                tOborot2.cgr[3] == tOborot3.cgr[3]
                                                and (3>tOborot3.tip)
                                                )) = tsok then
                     {
                       Sum3:=0;oldc4:=-1;Sum4:=0;Sum5:=0;SumNode:=0;
                       _loop tOborot3 where ((      dkz == tOborot3.dkz and
                                                tOborot2.cgr[1] == tOborot3.cgr[1]  and
                                                tOborot2.cgr[2] == tOborot3.cgr[2]  and
                                                tOborot2.cgr[3] == tOborot3.cgr[3]
                                                and (3>tOborot3.tip)  ))
                       {                       
                         if oldc4=tOborot3.cgr[4] then continue; else oldc4:=tOborot3.cgr[4];
                         ClearBuffer(#ttreest);
                         ttreest.name:= GetNameLevel(tOborot3.gr[4]);
                         ttreest.grLv:= JornTune.tblos[4];
                         ttreest.dkz:=  tOborot3.dkz;
                         ttreest.cowner:=cc3;
                         ttreest.sumDoc:=tOborot3.sumDoc;
                         ttreest.summa:=tOborot3.summa;
                         //-----------------------------------------
                         tTreest.schet:=                   tOborot3.schet;
                         tTreest.day_Prosr:=               tOborot3.day_Prosr;
                         tTreest.sumDoc:=                  tOborot3.sumDoc;
                         tTreest.summa:=                   tOborot3.summa;
                         tTreest.sum_prosr[1]:=            tOborot3.sum_prosr[1];
                         tTreest.sum_prosr[2]:=            tOborot3.sum_prosr[2];
                         tTreest.sum_prosr[3]:=            tOborot3.sum_prosr[3];
                         tTreest.sum_prosr[4]:=            tOborot3.sum_prosr[4];
                         tTreest.sum_prosr[5]:=            tOborot3.sum_prosr[5];
                         tTreest.sum_prosr[6]:=            tOborot3.sum_prosr[6];
                         tTreest.sum_prosr[7]:=            tOborot3.sum_prosr[7];
                         tTreest.sPodr:=                   tOborot3.sPodr;
                         tTreest.sMen:=                    tOborot3.sMen;
                         tTreest.sDDS:=                    tOborot3.sDDS;
                         tTreest.sCO:=                     tOborot3.sCO;
                         tTreest.tidkgal:=                 tOborot3.tidkgal;
                         tTreest.csoprdoc:=                tOborot3.csoprdoc;
                         tTreest.mind:=                    tOborot3.mind;
                         tTreest.dnum:=                    tOborot3.dnum;
                         tTreest.dsopr:=                   tOborot3.dsopr;
                         tTreest.Kontr:=                   tOborot3.Kontr;
                         tTreest.inn:=                     tOborot3.inn;
                         tTreest.ogrn:=                    tOborot3.ogrn;
                         tTreest.maxd:=                    tOborot3.maxd;
                         tTreest.istek_summa:=             tOborot3.istek_summa;
                         //------------------------------------------
                         case ReportTip of
                         9:
                         { tTreest.summaR      := tOborot3.summaR;//2
                           tTreest.summaIn     := tOborot3.summaIn;//5
                           //06 Учтено при формировании резерва сомнительных долгов П.4-П.5
                           tTreest.sum_dop[1]  := tOborot3.istek_summa-tOborot3.summaIn;
                           //07 Расходы за период суммарно П.6-П.2'
                           tTreest.sum_dop[2]  := tTreest.sum_dop[1]-tTreest.summaR;
                           //08 Доходы за период, счет 91.01.7 ЕСЛИ(П.7<0;П.7;0)
                           tTreest.sum_dop[3]  := if(tTreest.sum_dop[2]<0,tTreest.sum_dop[2],0);
                           //09 Расходы за период, счет 91.02.7 =ЕСЛИ(П.7>0;П.7;0)
                           tTreest.sum_dop[4]  := if(tTreest.sum_dop[2]>0,tTreest.sum_dop[2],0);
                         }
                         end;
                         //-----------------------------------------
                         insert current ttreest;
                         //-----------------------------------------
                         SumNode:=SumNode+tOborot3.summa;
                         cc4:=ttreest.NRec;                         
                         #SetCTreeNode(tOborot3,cc,cc1,cc2,cc3,cc4,0,0)
                         if JornTune.tblos[5]<>0 then
                           if getfirst tOborot4 where ((
                                                    dkz == tOborot4.dkz and
                                                    tOborot3.cgr[1] == tOborot4.cgr[1]  and
                                                    tOborot3.cgr[2] == tOborot4.cgr[2]  and
                                                    tOborot3.cgr[3] == tOborot4.cgr[3]  and
                                                    tOborot3.cgr[4] == tOborot4.cgr[4]
                                                    and (3>tOborot4.tip))) = tsok then
                           {
                             Sum4:=0;oldc5:=-1;Sum5:=0;SumNode:=0;
                             _loop tOborot4 where ((      dkz == tOborot4.dkz and
                                                    tOborot3.cgr[1] == tOborot4.cgr[1]  and
                                                    tOborot3.cgr[2] == tOborot4.cgr[2]  and
                                                    tOborot3.cgr[3] == tOborot4.cgr[3]  and
                                                    tOborot3.cgr[4] == tOborot4.cgr[4]
                                                    and (3>tOborot4.tip) ))
                            {
                              if oldc5=tOborot4.cgr[5] then continue; else oldc5:=tOborot4.cgr[5];
                              ClearBuffer(#ttreest);
                              ttreest.name:= GetNameLevel(tOborot4.gr[5]);
                              ttreest.grLv:= tOborot4.gr[5];
                              ttreest.dkz:=  JornTune.tblos[5];
                              ttreest.cowner:=cc4;
                              ttreest.sumDoc:=tOborot4.sumDoc;
                              ttreest.summa:=tOborot4.summa;
                              //------------------------
                              tTreest.schet:=                   tOborot4.schet;
                              tTreest.day_Prosr:=               tOborot4.day_Prosr;
                              tTreest.sumDoc:=                  tOborot4.sumDoc;
                              tTreest.summa:=                   tOborot4.summa;
                              tTreest.sum_prosr[1]:=            tOborot4.sum_prosr[1];
                              tTreest.sum_prosr[2]:=            tOborot4.sum_prosr[2];
                              tTreest.sum_prosr[3]:=            tOborot4.sum_prosr[3];
                              tTreest.sum_prosr[4]:=            tOborot4.sum_prosr[4];
                              tTreest.sum_prosr[5]:=            tOborot4.sum_prosr[5];
                              tTreest.sum_prosr[6]:=            tOborot4.sum_prosr[6];
                              tTreest.sum_prosr[7]:=            tOborot4.sum_prosr[7];
                              tTreest.sPodr:=                   tOborot4.sPodr;
                              tTreest.sMen:=                    tOborot4.sMen;
                              tTreest.sDDS:=                    tOborot4.sDDS;
                              tTreest.sCO:=                     tOborot4.sCO;
                              tTreest.tidkgal:=                 tOborot4.tidkgal;
                              tTreest.csoprdoc:=                tOborot4.csoprdoc;
                              tTreest.mind:=                    tOborot4.mind;
                              tTreest.dnum:=                    tOborot4.dnum;
                              tTreest.dsopr:=                   tOborot4.dsopr;
                              tTreest.Kontr:=                   tOborot4.Kontr;
                              tTreest.inn:=                     tOborot4.inn;
                              tTreest.ogrn:=                    tOborot4.ogrn;
                              tTreest.maxd:=                    tOborot4.maxd;
                              tTreest.istek_summa:=             tOborot4.istek_summa;
                               //------------------------------------------
                               case ReportTip of
                               9:
                               { tTreest.summaR      := tOborot4.summaR;//2
                                 tTreest.summaIn     := tOborot4.summaIn;//5
                                 //06 Учтено при формировании резерва сомнительных долгов П.4-П.5
                                 tTreest.sum_dop[1]  := tOborot4.istek_summa-tOborot4.summaR;
                                 //07 Расходы за период суммарно П.6-П.2'
                                 tTreest.sum_dop[2]  := tTreest.sum_dop[1]-tTreest.summaR;
                                 //08 Доходы за период, счет 91.01.7 ЕСЛИ(П.7<0;П.7;0)
                                 tTreest.sum_dop[3]  := if(tTreest.sum_dop[2]<0,tTreest.sum_dop[2],0);
                                 //09 Расходы за период, счет 91.02.7 =ЕСЛИ(П.7>0;П.7;0)
                                 tTreest.sum_dop[4]  := if(tTreest.sum_dop[2]>0,tTreest.sum_dop[2],0);
                               }
                               end;
                              //-----------------------------------------
                              insert current ttreest;
                              //-----------------------------------------
                              SumNode:=SumNode+tOborot4.summa;
                              cc5:=ttreest.NRec;
                              #SetCTreeNode(tOborot4,cc,cc1,cc2,cc3,cc4,cc5,0)
                              if JornTune.tblos[6]<>0 then
                                if getfirst tOborot5 where ((  dkz == tOborot5.dkz and
                                                          tOborot4.cgr[1] == tOborot5.cgr[1]  and
                                                          tOborot4.cgr[2] == tOborot5.cgr[2]  and
                                                          tOborot4.cgr[3] == tOborot5.cgr[3]  and
                                                          tOborot4.cgr[4] == tOborot5.cgr[4]  and
                                                          tOborot4.cgr[5] == tOborot5.cgr[5]
                                                          and (3>tOborot5.tip))) = tsok then
                                {
                                  SumNode:=0;oldc6:=-1;
                                  _loop tOborot5 where ((      dkz == tOborot5.dkz and
                                                         tOborot4.cgr[1] == tOborot5.cgr[1]  and
                                                         tOborot4.cgr[2] == tOborot5.cgr[2]  and
                                                         tOborot4.cgr[3] == tOborot5.cgr[3]  and
                                                         tOborot4.cgr[4] == tOborot5.cgr[4]  and
                                                         tOborot4.cgr[5] == tOborot5.cgr[5]
                                                         and (3>tOborot5.tip)))
                                  {
                                    if oldc6=tOborot5.cgr[6] then continue; else oldc6:=tOborot5.cgr[6];
                                    ClearBuffer(#ttreest);
                                    ttreest.name:= GetNameLevel(tOborot5.gr[6]);
                                    ttreest.grLv:= tOborot5.gr[6];
                                    ttreest.dkz:=  JornTune.tblos[6];
                                    ttreest.cowner:=cc5;
                                    ttreest.sumDoc:=tOborot5.sumDoc;
                                    ttreest.summa:=tOborot5.summa;
                                    //------------------------
                                    tTreest.schet:=                   tOborot5.schet;
                                    tTreest.day_Prosr:=               tOborot5.day_Prosr;
                                    tTreest.sumDoc:=                  tOborot5.sumDoc;
                                    tTreest.summa:=                   tOborot5.summa;
                                    tTreest.sum_prosr[1]:=            tOborot5.sum_prosr[1];
                                    tTreest.sum_prosr[2]:=            tOborot5.sum_prosr[2];
                                    tTreest.sum_prosr[3]:=            tOborot5.sum_prosr[3];
                                    tTreest.sum_prosr[4]:=            tOborot5.sum_prosr[4];
                                    tTreest.sum_prosr[5]:=            tOborot5.sum_prosr[5];
                                    tTreest.sum_prosr[6]:=            tOborot5.sum_prosr[6];
                                    tTreest.sum_prosr[7]:=            tOborot5.sum_prosr[7];
                                    tTreest.sPodr:=                   tOborot5.sPodr;
                                    tTreest.sMen:=                    tOborot5.sMen;
                                    tTreest.sDDS:=                    tOborot5.sDDS;
                                    tTreest.sCO:=                     tOborot5.sCO;
                                    tTreest.tidkgal:=                 tOborot5.tidkgal;
                                    tTreest.csoprdoc:=                tOborot5.csoprdoc;
                                    tTreest.mind:=                    tOborot5.mind;
                                    tTreest.dnum:=                    tOborot5.dnum;
                                    tTreest.dsopr:=                   tOborot5.dsopr;
                                    tTreest.Kontr:=                   tOborot5.Kontr;
                                    tTreest.inn:=                     tOborot5.inn;
                                    tTreest.ogrn:=                    tOborot5.ogrn;
                                    tTreest.maxd:=                    tOborot5.maxd;
                                    tTreest.istek_summa:=             tOborot5.istek_summa;
                                     //------------------------------------------
                                     case ReportTip of
                                     9:
                                     { tTreest.summaR      := tOborot5.summaR;//2
                                       tTreest.summaIn     := tOborot5.summaIn;//5
                                       //06 Учтено при формировании резерва сомнительных долгов П.4-П.5
                                       tTreest.sum_dop[1]  := tOborot5.istek_summa-tOborot5.summaIn;
                                       //07 Расходы за период суммарно П.6-П.2'
                                       tTreest.sum_dop[2]  := tTreest.sum_dop[1]-tTreest.summaR;
                                       //08 Доходы за период, счет 91.01.7 ЕСЛИ(П.7<0;П.7;0)
                                       tTreest.sum_dop[3]  := if(tTreest.sum_dop[2]<0,tTreest.sum_dop[2],0);
                                       //09 Расходы за период, счет 91.02.7 =ЕСЛИ(П.7>0;П.7;0)
                                       tTreest.sum_dop[4]  := if(tTreest.sum_dop[2]>0,tTreest.sum_dop[2],0);
                                     }
                                     end;

                                    insert current ttreest;
                                    SumNode:=SumNode+tOborot5.summa;
                                    cc6:=ttreest.NRec;
                                    #SetCTreeNode(tOborot5,cc,cc1,cc2,cc3,cc4,cc5,cc6)
                                 } //_loop tOborot5 where ((      dkz == tOborot5.dkz and
                               SetSumNode(cc5,SumNode);
                               Sum4:=Sum4+SumNode;
                             } //if getfirst tOborot5 where ((  dkz == tOborot5.dkz and
                          } //_loop tOborot4 where ((      dkz == tOborot4.dkz and
                          if Sum4=0 then Sum4:=SumNode;
                          SetSumNode(cc4,Sum4);
                          Sum3:=Sum3+Sum4;
                        } //if getfirst tOborot4 where ((
                     } //_loop tOborot3 where ((      dkz == tOborot3.dkz and
                     if Sum3=0 then Sum3:=SumNode;
                     SetSumNode(cc3,Sum3);
                     Sum2:=Sum2+Sum3;
                 } //if getfirst tOborot3 where (( dkz    == tOborot3.dkz and
              } //_loop tOborot2 where ((      dkz == tOborot2.dkz and
              if Sum2=0 then Sum2:=SumNode;
              SetSumNode(cc2,Sum2);
              Sum1:=Sum1+Sum2;

            } //if getfirst tOborot2 where ((   dkz == tOborot2.dkz and tOborot1.cgr[1] == tOborot2.cgr[1]  and

          } //_loop tOborot1 where ((dkz == tOborot1.dkz and tOborot.cgr[1] == tOborot1.cgr[1]))
          if Sum1=0 then Sum1:=SumNode;
          SetSumNode(cc1,Sum1);
          Sum:=Sum+Sum1;
        } // if getfirst tOborot1 where ((dkz == tOborot1.dkz and tOborot.cgr[1] == tOborot1.cgr[1])) = tsok then

        } //_loop tOborot where ((   dkz == tOborot.dkz        ))  ordered by toborot.gr[1]
        if Sum=0 then Sum:=SumNode;
        SetSumNode(cc,Sum);
        StopVisual;

} //procedure TreeBuilding(dkz:word);

//================================
//
//--------------------------------
procedure RecursionAggr(dkz:word;cc:comp);
var L_:longint;
    L_Sum:array[0..20] of double;
    L_mind,L_maxD:date;
{
 PushPos(#ttreesx);
 If(GetFirst ttreesx where ((dkz == ttreesx.dkz and cc==ttreesx.cowner)) = TsOk)
 {
  SetSumNode(cc, 0);
 } 
 PopPos(#ttreesx);
 PushPos(#ttreesx);
 L_:=0;l_mind:=l_maxd:=ZeroDate;
 for(i:=0;i<=20;i:=i+1) l_sum[i]:=0;
 _loop ttreesx where ((dkz == ttreesx.dkz and cc==ttreesx.cowner))
 {
   If(not Nextvisual)
   {Break;}
   
   RecursionAggr(dkz,ttreesx.nrec);
   L_:=if(L_<TTreesX.day_Prosr,TTreesX.day_Prosr,L_);
   l_minD:=GetMinDate(l_minD,TTreesX.MinD);
   l_maxD:=GetMaxDate(l_maxD,TTreesX.MaxD);
   l_sum[00]:= l_sum[00] +  tTreesx.sumDoc;
   l_sum[01]:= l_sum[01] +  tTreesx.summa;
   l_sum[02]:= l_sum[02] +  tTreesx.sum_prosr[1];
   l_sum[03]:= l_sum[03] +  tTreesx.sum_prosr[2];
   l_sum[04]:= l_sum[04] +  tTreesx.sum_prosr[3];
   l_sum[05]:= l_sum[05] +  tTreesx.sum_prosr[4];
   l_sum[06]:= l_sum[06] +  tTreesx.sum_prosr[5];
   l_sum[07]:= l_sum[07] +  tTreesx.sum_prosr[6];
   l_sum[08]:= l_sum[08] +  tTreesx.sum_prosr[7];
   l_sum[09]:= l_sum[09] +  tTreesx.istek_summa;
   l_sum[10]:= l_sum[10] +  tTreesx.summaR;
   l_sum[11]:= l_sum[11] +  tTreesx.summaIn;
   l_sum[12]:= l_sum[12] +  tTreesx.sum_dop[01];
   l_sum[13]:= l_sum[13] +  tTreesx.sum_dop[02];
   l_sum[14]:= l_sum[14] +  tTreesx.sum_dop[03];
   l_sum[15]:= l_sum[15] +  tTreesx.sum_dop[04];
   l_sum[16]:= l_sum[16] +  tTreesx.sum_dop[05];
   l_sum[17]:= l_sum[17] +  tTreesx.sum_dop[06];
   l_sum[18]:= l_sum[18] +  tTreesx.sum_dop[07];
   l_sum[19]:= l_sum[19] +  tTreesx.sum_dop[08];
   l_sum[20]:= l_sum[20] +  tTreesx.sum_dop[09];
 }
 PopPos(#ttreesx);
 TTreesX.day_Prosr:=  if(L_=0 and TTreesX.day_Prosr<0,TTreesX.day_Prosr,if(L_<TTreesX.day_Prosr,TTreesX.day_Prosr,L_));
 TTreesX.mind     :=  if(l_minD<>ZeroDate,l_minD,TTreesX.mind);
 TTreesX.maxd     :=  if(l_maxD<>ZeroDate,l_maxD,TTreesX.maxd);
 tTreesx.sumDoc         :=  tTreesx.sumDoc        +  l_sum[0];
 tTreesx.summa          :=  tTreesx.summa         +  l_sum[1];
 tTreesx.sum_prosr[1]   :=  tTreesx.sum_prosr[1]  +  l_sum[2];
 tTreesx.sum_prosr[2]   :=  tTreesx.sum_prosr[2]  +  l_sum[3];
 tTreesx.sum_prosr[3]   :=  tTreesx.sum_prosr[3]  +  l_sum[4];
 tTreesx.sum_prosr[4]   :=  tTreesx.sum_prosr[4]  +  l_sum[5];
 tTreesx.sum_prosr[5]   :=  tTreesx.sum_prosr[5]  +  l_sum[6];
 tTreesx.sum_prosr[6]   :=  tTreesx.sum_prosr[6]  +  l_sum[7];
 tTreesx.sum_prosr[7]   :=  tTreesx.sum_prosr[7]  +  l_sum[8];
 tTreesx.istek_summa    :=  tTreesx.istek_summa   +  l_sum[9];
 tTreesx.summaR         :=  tTreesx.summaR        +  l_sum[10] ;
 tTreesx.summaIn        :=  tTreesx.summaIn       +  l_sum[11] ;
 tTreesx.sum_dop[01]    :=  tTreesx.sum_dop[01]   +  l_sum[12] ;
 tTreesx.sum_dop[02]    :=  tTreesx.sum_dop[02]   +  l_sum[13] ;
 tTreesx.sum_dop[03]    :=  tTreesx.sum_dop[03]   +  l_sum[14] ;
 tTreesx.sum_dop[04]    :=  tTreesx.sum_dop[04]   +  l_sum[15] ;
 tTreesx.sum_dop[05]    :=  tTreesx.sum_dop[05]   +  l_sum[16] ;
 tTreesx.sum_dop[06]    :=  tTreesx.sum_dop[06]   +  l_sum[17] ;
 tTreesx.sum_dop[07]    :=  tTreesx.sum_dop[07]   +  l_sum[18] ;
 tTreesx.sum_dop[08]    :=  tTreesx.sum_dop[08]   +  l_sum[19] ;
 tTreesx.sum_dop[09]    :=  tTreesx.sum_dop[09]   +  l_sum[20] ;

 update current ttreesx;
} //procedure RecursionAggr(dkz:word;cc:comp);


//================================
//
//--------------------------------
procedure  TreeAggrigation(dkz:word);
{
 
 if getfirst ttreesx where ((dkz == ttreesx.dkz and 0 == ttreesx.cowner))=tsok then
  {
   StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Расчет итогов по '+if(dkz=0,'дебету','кредиту'), RecordsInTable(tnttreesx));
   SetSumNode(ttreesx.nrec, 0);
   RecursionAggr(dkz,ttreesx.nrec);
   StopVisual;
  }
} //procedure  TreeAggrigation(dkz:word);

//================================
//
//--------------------------------
//EM-108 Исключить из иерархии контрагентов с отрицательной итоговой суммой
//EM-108 Исключить из иерархии договора с нулевой итоговой суммой
procedure TreeDelMinusSum(_dkz : word; _kau: Word);
{
  var nrecTree : Comp;
  Var lvlTree  : Word;
  Var iPanel   : LongInt;
  
  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Изменение иерархии по '+if(_dkz=0,'дебету','кредиту'), RecordsInTable(tnttreesx));  
  
  iPanel := if(_dkz = 0, trCat, trCat2);
  
  //Первая запись в иерархии - получить Nrec
  if(getfirst ttreesx where ((_dkz == ttreesx.dkz and 0 == ttreesx.cowner)) = tsok)
  { nrecTree := ttreesx.nrec; }
  else
  { Exit; }
  
#Declare TreeDelNode(nrecTree)
 Case(TreeLevel(iPanel))Of
   0: If(Delete All From tOborot Where((#nrecTree == tOborot.cTreeNode[0])) = TsOk){}
   1: If(Delete All From tOborot Where((#nrecTree == tOborot.cTreeNode[1])) = TsOk){}
   2: If(Delete All From tOborot Where((#nrecTree == tOborot.cTreeNode[2])) = TsOk){}
   3: If(Delete All From tOborot Where((#nrecTree == tOborot.cTreeNode[3])) = TsOk){}
   4: If(Delete All From tOborot Where((#nrecTree == tOborot.cTreeNode[4])) = TsOk){}
   5: If(Delete All From tOborot Where((#nrecTree == tOborot.cTreeNode[5])) = TsOk){}
   6: If(Delete All From tOborot Where((#nrecTree == tOborot.cTreeNode[6])) = TsOk){} 
 End;  
 If ((Update ttreesx Where((#nrecTree == ttreesx.nrec)) Set  ttreesx.summa  := 0) = TsOk)
 {} 
#End      
  
  //Перемещение по дереву
  TreePushPos(iPanel);
  If TreeGetFirstEx(iPanel)
  {
    While TreeGetNextEx(iPanel)
    {
     If Not NextVisual
     { Break; }
      lvlTree := Word(TreeLevel(iPanel));
            
      if(_dkz = 0)//ДЗ
      { 
        //уровень группировки контрагент                   
        //Исключить из иерархии контрагентов с нулевой или отрицательной суммой
        If(_kau = wDKZ_OrgSchSubSch Or _kau = cgKau_KatOrg Or _kau = cgKau_Persons)
        {                
          If (tTreeD.grLv = _kau)
          {
            If (Round(ttreeD.summa, 2) = 0)
            {
              #TreeDelNode(ttreeD.nrec) 
              Continue;
            }
            Else If (Round(ttreeD.summa, 2) < 0)
                    And
                    (Not(   //Для 60 или 62 оставить отрицательные суммы
                            (Substr(tTreeD.schet,2,255) = '60') 
                         Or (Substr(tTreeD.schet,2,255) = '62')
                         Or (Substr(tTreeD.schet,2,  3) = '60.')
                         Or (Substr(tTreeD.schet,2,  3) = '62.')
                        )
                    )   
            {
              #TreeDelNode(ttreeD.nrec) 
              Continue;
            }
            Else
            {
              if(DlgUslT <> 0)
              {
                case DlgUslT of
                  1:
                  { 
                    if Not(abs(ttreeD.summa) >= DlgUsl1)
                    {
                      #TreeDelNode(ttreeD.nrec) 
                      Continue;                 
                    }
                  }
                  2: 
                  { 
                    if Not(abs(ttreeD.summa) <= DlgUsl1)
                    {
                      #TreeDelNode(ttreeD.nrec) 
                      Continue;
                    }
                  }  
                  3:
                  {
                    if Not(abs(ttreeD.summa) >= DlgUsl1 and abs(ttreeD.summa)<= DlgUsl2) 
                    {
                      #TreeDelNode(ttreeD.nrec) 
                      Continue;
                    } 
                  }
                end;
              }
            }
          }          
        }
       
        //уровень группировки, договора
        //Исключить из иерархии договора с нулевой или отрицательной суммой
        If(_kau = cgKau_Dogovor)
        {
          If (tTreeD.grLv = _kau)
          {
            If (Round(ttreeD.summa, 2) = 0)
            {
              #TreeDelNode(ttreeD.nrec) 
              Continue;
            }
            Else If (Round(ttreeD.summa, 2) < 0)
                    And
                    (Not(   //Для 60 или 62 оставить отрицательные суммы
                            (Substr(tTreeD.schet,2,255) = '60') 
                         Or (Substr(tTreeD.schet,2,255) = '62')
                         Or (Substr(tTreeD.schet,2,  3) = '60.')
                         Or (Substr(tTreeD.schet,2,  3) = '62.')
                        )
                    )   
            {      
              #TreeDelNode(ttreeD.nrec) 
              Continue;
            }                          
          }          
        } 
      }
      
      if(_dkz = 1)//КЗ
      {                   
        //уровень группировки контрагент                   
        //Исключить из иерархии контрагентов с нулевой или отрицательной суммой
        If(_kau = wDKZ_OrgSchSubSch Or _kau = cgKau_KatOrg  Or _kau = cgKau_Persons)
        {
          If (tTreeK.grLv = _kau)
          {
            If (Round(tTreeK.summa, 2) = 0)
            {
              #TreeDelNode(tTreeK.nrec) 
              Continue;
            }
            Else If (Round(tTreeK.summa, 2) < 0)
                    And
                    (Not(   //Для 60 или 62 оставить отрицательные суммы
                            (Substr(tTreeK.schet,2,255) = '60') 
                         Or (Substr(tTreeK.schet,2,255) = '62')
                         Or (Substr(tTreeK.schet,2,  3) = '60.')
                         Or (Substr(tTreeK.schet,2,  3) = '62.')
                        )
                    )   
            {
              #TreeDelNode(tTreeK.nrec) 
              Continue;
            }
            Else
            {
              if(DlgUslT <> 0)
              {
                case DlgUslT of
                  1:
                  { 
                    if Not(abs(tTreeK.summa) >= DlgUsl1)
                    {
                      #TreeDelNode(tTreeK.nrec) 
                      Continue;                 
                    }
                  }
                  2: 
                  { 
                    if Not(abs(tTreeK.summa) <= DlgUsl1)
                    {
                      #TreeDelNode(tTreeK.nrec) 
                      Continue;
                    }
                  }  
                  3:
                  {
                    if Not(abs(tTreeK.summa) >= DlgUsl1 and abs(tTreeK.summa)<= DlgUsl2) 
                    {
                      #TreeDelNode(tTreeK.nrec) 
                      Continue;
                    } 
                  }
                end;
              }
            }
          }          
        }
      
        //уровень группировки, договора
        //Исключить из иерархии договора с нулевой или отрицательной суммой
        If(_kau = cgKau_Dogovor)
        {
          If (ttreeK.grLv = _kau)
          {
            If (Round(ttreeK.summa, 2) = 0)
            {
              #treeDelNode(ttreeK.nrec) 
              Continue;
            }
            Else If (Round(ttreeK.summa, 2) < 0)
                    And
                    (Not(   //Для 60 или 62 оставить отрицательные суммы
                            (Substr(tTreeK.schet,2,255) = '60') 
                         Or (Substr(tTreeK.schet,2,255) = '62')
                         Or (Substr(tTreeK.schet,2,  3) = '60.')
                         Or (Substr(tTreeK.schet,2,  3) = '62.')
                        )
                    )   
            {
              #treeDelNode(ttreeK.nrec) 
              Continue;
            }
          }           
        } 
      }  
    }   
    //Испключить записи из дерева       
    If ((Update ttreesx Where((_dkz == ttreesx.dkz And  _kau == ttreesx.grLv(NoIndex) And  (ttreesx.summa = 0)))
                      Set  ttreesx.dkz    := 10 + ttreesx.dkz  
                          ,ttreesx.cOwner := -1  
       ) = TsOk)
    {}    
  }
  TreePopPos(iPanel);
  StopVisual;
} //procedure TreeDelMinusSum

//EM-108 Сформировать протокол, где ttreesx.sumDoc <> ttreesx.summa
procedure TreeLogErrSumma(_dkz : word);
{
  var nrecTree     : Comp;
  Var iPanel       : LongInt;
  Var sumDocTree   : Double;  
  Var summaTree    : Double;
  Var arrName      : Array[0..0] Of String;
  Var errLog       : String;
  
  iPanel := if(_dkz = 0, trCat, trCat2);
  
  if(getfirst ttreesx where ((_dkz == ttreesx.dkz and 0 == ttreesx.cowner)) = tsok)
  { nrecTree := ttreesx.nrec; }
  else
  { Exit; }
  
  TreePushPos(iPanel);
  If TreeGetFirstEx(iPanel)
  {
    arrName[TreeLevel(iPanel)] := if(_dkz = 0, ttreeD.name, ttreeK.name);
    While TreeGetNextEx(iPanel)
    {
     arrName[TreeLevel(iPanel)] := '\ '+if(_dkz = 0, ttreeD.name, ttreeK.name);
     sumDocTree   := 0;
     summaTree    := 0;
     if(_dkz = 0)
     {
      If(tTreeD.grLv=wDKZ_OrgSchSubSch Or tTreeD.grLv=cgKau_KatOrg Or tTreeD.grLv=cgKau_Dogovor)
      {
       sumDocTree   := ttreeD.sumDoc;
       summaTree    := ttreeD.summa;
      }  
     }
     Else
     {
      If((tTreeK.grLv=wDKZ_OrgSchSubSch Or tTreeK.grLv=cgKau_KatOrg Or tTreeK.grLv=cgKau_Dogovor))
      {
       sumDocTree   := ttreeK.sumDoc;
       summaTree    := ttreeK.summa;
      } 
     } 
     If(Round(sumDocTree, 2) <> Round(summaTree, 2))
     {
      errlog := '';
      errlog += 'КОУ:'+LPad(DoubleToStr(sumDocTree, '\2p[|-]36666666666666666.88'), 15);
      errlog += '  ';
      errlog += 'КБУ:'+LPad(DoubleToStr(summaTree,  '\2p[|-]36666666666666666.88'), 15);
      errlog += '  ';
      For(i := 0; i<=TreeLevel(iPanel); i++)
      {
       errlog += arrName[i];
      }
      
      oGP_Log.Write(errlog);
     }
    }     
  }
  TreePopPos(iPanel);  
}//procedure TreeLogErrSumma


procedure TreeDayProsr(_dkz : word);
{
  var nrecTree : Comp;
  Var lvlTree  : Word;
  Var iPanel   : LongInt;
  Var sumSaldo : Double;
  Var datSaldo : Date = ZeroDate;

  
  iPanel := if(_dkz = 0, trCat, trCat2);
  TreePushPos(iPanel);
  If TreeGetFirstEx(iPanel)
  {
    While TreeGetNextEx(iPanel)
    {
      If Not NextVisual
      { Break; }

      lvlTree  := Word(TreeLevel(iPanel));
      nrecTree := if(_dkz = 0, tTreeD.nrec, tTreeK.nrec);
      If (GetFirst FastFirstRow ttreesx Where((nrecTree == ttreesx.nrec)) = TsOk)
      {              
        If(ttreesx.grLv = wDKZ_OrgSchSubSch Or ttreesx.grLv = cgKau_KatOrg Or ttreesx.grLv = cgKau_Persons Or ttreesx.grLv = cgKau_Dogovor)
        {
#Declare LooptOborot(lvl)
          sumSaldo := 0;
          datSaldo := ZeroDate;
          _Loop tOborot Where((nrecTree == tOborot.cTreeNode[#lvl])) Ordered By tOborot.dSopr
          {
            sumSaldo += tOborot.summa;
            If (Round(sumSaldo, 2) <= 0)
            {
              datSaldo := ZeroDate; 
            }
            Else
            {
              If (datSaldo > tOborot.dSopr)Or(datSaldo = ZeroDate)
              { datSaldo := tOborot.dSopr;}
            }
            oGP_Log.Write(ttreesx.name +'  '+datSaldo+'  '+String(sumSaldo, 0, 12));            
          }
#End          
          Case lvlTree Of
            0: 
            { 
              #LooptOborot(0)
            }
            1:
            { 
              #LooptOborot(1)
            }
            2:
            { 
              #LooptOborot(2)
            }
            3:
            { 
              #LooptOborot(3)
            }
            4:
            { 
              #LooptOborot(4)
            }
            5:
            { 
              #LooptOborot(5)
            }
            6:         
            { 
              #LooptOborot(6)
            }
          End;             

          Set ttreesx.dVoznPr    := datSaldo;
          Set ttreesx.day_Prosr  := if (DlgUsl_chk=0,GetDaysProsr(datSaldo),GetDaysProsr2(datSaldo));          
          If(Update Current ttreesx = TsOk)
          {}          
          If (BaseDocLevel > 0)
          {
            Set tTreesx.sumDoc   := tTreesx.summa; 
            Set tTreesX.sum_prosr[1]:=0;
            Set tTreesx.sum_prosr[2]:=0;
            Set tTreesx.sum_prosr[3]:=0;
            Set tTreesx.sum_prosr[4]:=0;
            Set tTreesx.sum_prosr[5]:=0;
            Set tTreesx.sum_prosr[6]:=0; 
            Set tTreesx.sum_prosr[7]:=0;
            Set tTreesx.istek_summa :=0;

            #SetDayProsr(tTreesx,tTreesx.summa)            
            If(Update Current ttreesx = TsOk)
            {}                      

            tOborot.cTreeNode[BaseDocLevel] := 0;
            tOborot.summa       := tTreesx.summa;
            tOborot.sum_prosr[1]:= tTreesX.sum_prosr[1];
            tOborot.sum_prosr[2]:= tTreesx.sum_prosr[2];
            tOborot.sum_prosr[3]:= tTreesx.sum_prosr[3];
            tOborot.sum_prosr[4]:= tTreesx.sum_prosr[4];
            tOborot.sum_prosr[5]:= tTreesx.sum_prosr[5];
            tOborot.sum_prosr[6]:= tTreesx.sum_prosr[6];
            tOborot.sum_prosr[7]:= tTreesx.sum_prosr[7];
            tOborot.istek_summa := tTreesx.istek_summa ;
            If (Update Current tOborot = TsOk)
            {}            
          }          
        }      
        
        If (BaseDocLevel > 0)  And (ttreesx.grLv = wDKZ_D)
        {
          #TreeDelNode(nrecTree) 
        }                  
      }
    }  
  }

  If (BaseDocLevel > 0)
  {
    //Испключить записи из дерева       
    If ((Update ttreesx Where((_dkz == ttreesx.dkz And  wDKZ_D == ttreesx.grLv(NoIndex)))
                      Set  ttreesx.dkz    := 10 + ttreesx.dkz  
                          ,ttreesx.cOwner := -1  
       ) = TsOk)
    {}    
  }
  
  ReReadRecord(tntTreeD);
  ReReadRecord(tntTreeK);
  TreePopPos(iPanel);
}//procedure TreeDayProsr

//================================
//
//--------------------------------
Function LoopOborot(_wOb:word):boolean;
{
   _log('ДБ = '+BegDateB+'   '+EndDateB );
   Result:=True;
   
   if BoundActive(tbbn_OK)   { SubBounds(tbbn_OK);   }
   if BoundActive(tbbn_O)    { SubBounds(tbbn_O);    }
   if BoundActive(tbbn_K)    { SubBounds(tbbn_K);    }
   if BoundActive(tbbn_OSUB) { SubBounds(tbbn_OSUB); }
   if BoundActive(tbbn_KSUB) { SubBounds(tbbn_KSUB); }
   
   _SCHETO    := MemNastr.SCH;    _SCHETK    := MemNastr.SCHK;
   _SCHETOSUB := MemNastr.subsch; _SCHETKSUB := MemNastr.subschk;
   
   if (_SCHETO<>'') and (_SCHETK<>'')
   { PushBounds(tbbn_OK); }
   Else If(_SCHETO<>'') and (_SCHETOSUB='')  and (_SCHETK='')
   { PushBounds(tbbn_O); }
   Else If(_SCHETO<>'') and (_SCHETOSUB<>'') and (_SCHETK='')
   { PushBounds(tbbn_OSUB); }
   else if (_SCHETO='') and (_SCHETK<>'')and (_SCHETKSUB='')
   { PushBounds(tbbn_K); }
   else if (_SCHETO='') and (_SCHETK<>'')and (_SCHETKSUB<>'')
   { PushBounds(tbbn_KSUB); }
   
   _loop oborot
   { if not iNextVisual('Отбор бух. проводок '+SubStr(_SCHETO, 2, 255)+'.'+_SCHETOSUB+' по '+if(_wOb=1,'дебету','кредиту')+' 1 из 2'#13+oborot.datOb)
     { Result:=False;
       Exit;
     }
     //if timelog_status>0  _log('111 '+DateToStr(oborot.datob,'DD/MM/YYYY')+'   '+oborot.SCHETO+'.'+oborot.SUBOSSCH+'   '+oborot.SCHETK+'.'+oborot.SUBSCHK+'   '+oborot.sumob );
     if not EnabledObSSO then continue;
     //if timelog_status>0  _log('111 01' );
     if not EnabledObKauOS(1) then continue;
     //if timelog_status>0  _log('111 02' );
     if not EnabledObKauOS(2) then continue;
     //if timelog_status>0  _log('111 03' );
     if not EnabledObKauOS(3) then continue;
     //if timelog_status>0  _log('111 04' );
     if not EnabledObKauOS(4) then continue;
     //if timelog_status>0  _log('111 05' );
     if not EnabledObKauOS(5) then continue;
     //if timelog_status>0  _log('111 06' );
     if not EnabledObKauOS(6) then continue;
     //if timelog_status>0  _log('111 07' );
     if not EnabledObDOGO then continue;
     //if timelog_status>0  _log('111 08' );
     if not EnabledObOrgO then continue;
     //if timelog_status>0  _log('111 09' );
     if not EnabledObVidVO then continue;
     //if timelog_status>0  _log('111 10' );
     if not EnabledCO then continue;
     //if timelog_status>0  _log('111 11' );
     if not EnabledObPodrO then continue;
     //if timelog_status>0  _log('111 12' );
     LoadGroup(1);
     _log('D 222 '+DateToStr(oborot.datob,'DD/MM/YYYY')+'   '+oborot.SCHETO+'.'+oborot.SUBOSSCH+'   '+oborot.SCHETK+'.'+oborot.SUBSCHK+'   '+string(oborot.sumob,0,4) );

     if getfirst tOborot where ((
   //                     oborot.SCHETO == tOborot.sch and
      //                  oborot.SUBOSSCH == tOborot.subsch And
                           MemNastr.dkz == tOborot.dkz and
                            a_cgr[1] == tOborot.cgr[1] and
                            a_cgr[2] == tOborot.cgr[2] and
                            a_cgr[3] == tOborot.cgr[3] and
                            a_cgr[4] == tOborot.cgr[4] and
                            a_cgr[5] == tOborot.cgr[5] and
                            a_cgr[6] == tOborot.cgr[6]
                                  )) = tsok then
        {
          LoadSumma(oborot.sumob);
          set tOborot.name := tOborot.name+'+СРД';
          update current tOborot;
       }
        else
        {
          ClearBuffer(#tOborot);
          for(i:=1;i<=6;i:=i+1)
          {
            set tOborot.gr[i]:=a_gr[i];
            set tOborot.cgr[i]:=a_cgr[i];
            set tOborot.wgr[i]:=a_wgr[i];
            set tOborot.TBLOS[i] := oborot.TBLOS[i];
            set tOborot.kauos[i] := oborot.kauos[i];
//            set tOborot.TBLKS[i] := oborot.TBLKS[i];
//            set tOborot.kauKs[i] := oborot.kauKs[i];
            if oborot.TBLOS[i]=cgKau_KatOrg
            { set tOborot.cOrg :=oborot.kauOs[i];
            }
            if oborot.TBLOS[i]=cgKau_Dogovor
            { set tOborot.cDogKau :=oborot.kauOs[i];
            }
            if oborot.TBLOS[i]=cgKau_BaseDoc
            { set tOborot.cDOKau :=oborot.kauOs[i];
            }
          }
          set tOborot.TBLOS[7] := GetKauCode(oborot.tidkgal);
          set tOborot.kauos[7] := oborot.csoprdoc;
          set tOborot.d:=oborot.DATOB;
          set tOborot.name := 'СРД';
          set tOborot.sch       := oborot.SCHETO;
          set tOborot.subsch    := oborot.SUBOSSCH;
          set tOborot.wOb       := _wOb;
          LoadSoprDoc;
                    
          If(1 = MemNastr.tip)//Вкладка "Основные"
          {
            //EM-31 не включать с меньшей просроченной задолженностью
            If(Not CheckKolDaysProsr(tOborot.day_Prosr))
            {Continue;}
          }  
          
          LoadSumma(oborot.sumob);
          set tOborot.dkz:=MemNastr.dkz;
          insert current tOborot;
        }

   }

   if BoundActive(tbbn_OK)   { SubBounds(tbbn_OK);   }
   if BoundActive(tbbn_O)    { SubBounds(tbbn_O);    }
   if BoundActive(tbbn_K)    { SubBounds(tbbn_K);    }
   if BoundActive(tbbn_OSUB) { SubBounds(tbbn_OSUB); }
   if BoundActive(tbbn_KSUB) { SubBounds(tbbn_KSUB); }
   
   _SCHETO    := MemNastr.SCHK;    _SCHETK    := MemNastr.SCH;   
   _SCHETOSUB := MemNastr.subschk; _SCHETKSUB := MemNastr.subsch;
   
   if (_SCHETO<>'') and (_SCHETK<>'')
   { PushBounds(tbbn_OK); }
   Else If(_SCHETO<>'') and (_SCHETOSUB='')  and (_SCHETK='')
   { PushBounds(tbbn_O); }
   Else If(_SCHETO<>'') and (_SCHETOSUB<>'') and (_SCHETK='')
   { PushBounds(tbbn_OSUB); }
   else if (_SCHETO='') and (_SCHETK<>'')and (_SCHETKSUB='')
   { PushBounds(tbbn_K); }
   else if (_SCHETO='') and (_SCHETK<>'')and (_SCHETKSUB<>'')
   { PushBounds(tbbn_KSUB); }

   _loop oborot
   { 
     if not iNextVisual('Отбор бух. проводок '+SubStr(_SCHETK, 2, 255)+'.'+_SCHETKSUB+' по '+if(_wOb=0,'дебету','кредиту')+' 2 из 2'#13+oborot.datOb)
     { Result:=False;
       Exit;
     }

     if not EnabledObSSK then continue;
     if not EnabledObKauKS(1) then continue;
     if not EnabledObKauKS(2) then continue;
     if not EnabledObKauKS(3) then continue;
     if not EnabledObKauKS(4) then continue;
     if not EnabledObKauKS(5) then continue;
     if not EnabledObKauKS(6) then continue;
     if not EnabledObIskl then continue;
     if not EnabledObDOGK then continue;
     if not EnabledObOrgK then continue;
     if not EnabledObPodrK then continue;
     if not EnabledObVidVK then continue;
     if not EnabledCO then continue;
     _log('K 222 '+DateToStr(oborot.datob,'DD/MM/YYYY')+'   '+oborot.SCHETO+'.'+oborot.SUBOSSCH+'   '+oborot.SCHETK+'.'+oborot.SUBSCHK+'   '+string(oborot.sumob,0,4) );
     LoadGroup(2);
     if getfirst tOborot where ((
                //        oborot.SCHETK == tOborot.sch and
               //         oborot.SUBSCHK == tOborot.subsch And
                           MemNastr.dkz == tOborot.dkz and
                            a_cgr[1] == tOborot.cgr[1] and
                            a_cgr[2] == tOborot.cgr[2] and
                            a_cgr[3] == tOborot.cgr[3] and
                            a_cgr[4] == tOborot.cgr[4] and
                            a_cgr[5] == tOborot.cgr[5] and
                            a_cgr[6] == tOborot.cgr[6]
                                  )) = tsok then
        {
          LoadSumma(-oborot.sumob);
          set tOborot.name := tOborot.name+'-СРК';
          update current tOborot;
        }
        else
        {
          ClearBuffer(#tOborot);
          for(i:=1;i<=6;i:=i+1)
          {
            set tOborot.gr[i]:=a_gr[i];
            set tOborot.cgr[i]:=a_cgr[i];
            set tOborot.wgr[i]:=a_wgr[i];
            set tOborot.TBLOS[i] := oborot.TBLKS[i];
            set tOborot.kauos[i] := oborot.kauKs[i];
//            set tOborot.TBLKS[i] := oborot.TBLKS[i];
//            set tOborot.kauKs[i] := oborot.kauKs[i];
            if oborot.TBLKS[i]=cgKau_KatOrg
            { set tOborot.cOrg :=oborot.kauKs[i];
            }
            if oborot.TBLKS[i]=cgKau_Dogovor
            { set tOborot.cDogKau :=oborot.kauKs[i];
            }
            if oborot.TBLKS[i]=cgKau_BaseDoc
            { set tOborot.cDOKau :=oborot.kauKs[i];
            }
          }
          set tOborot.TBLOS[7] := GetKauCode(oborot.tidkgal);
          set tOborot.kauos[7] := oborot.csoprdoc;
          set tOborot.d:=oborot.DATOB;
          set tOborot.name := 'СРК';
          set tOborot.sch       := oborot.SCHETK;
          set tOborot.subsch    := oborot.SUBSCHK;
          set tOborot.wOb       := _wOb;
          LoadSoprDoc;
          
          If(1 = MemNastr.tip)//Вкладка "Основные"
          {          
            //EM-31 не включать с меньшей просроченной задолженностью
            If(Not CheckKolDaysProsr(tOborot.day_Prosr))
            {Continue;}          
          }  
          
          LoadSumma(-oborot.sumob);
          set tOborot.dkz:=MemNastr.dkz;
          insert current tOborot;
        }

   }
} //Function LoopOborot(_wOb:word):boolean;


//#3835_EM-31 Акт инвентаризации по просроченной задолженности
//Без группировки док. основания" неправлиьно считаются дни просрочки по оперативным документам, т.к.
//ранее написанный алгоритм находит запись Контрагент / Договор в тбл.  tOborot и складывет суумы не анализируя ДО 
//для упрощения исправления ошибки добавляю фиктивный уровень группировки, и по окончанию возвращаю запись JornTune к исходному состаянию
//После построения дерева отчета, фиктивный уровень скрываю через TreeLevel
Function AddBaseDocLevel: LongInt;
{
  var i : Word;
  
  Result := 0;
  
  if (ReportTip = 2)  
  { 
    ReReadRecord(#JornTune); 
    for(i:=1;i<=6;i:=i+1)
    {
      If(JornTune.TblOs[i] = wDKZ_D)
      { Exit; }
      else If(JornTune.TblOs[i] = 0)
      {
        Set JornTune.TblOs[i] := wDKZ_D;
        Update current JornTune;
        Result := i;
        Exit;
      }
    }    
  }

  if (ReportTip = 9)  
  { 
    ReReadRecord(#JornTune); 
    for(i:=1;i<=6;i:=i+1)
    {
      If(JornTune.TblOs[i] = cgKau_BaseDoc)
      { Exit; }
      else If(JornTune.TblOs[i] = 0)
      {
        Set JornTune.TblOs[i] := cgKau_BaseDoc;
        Update current JornTune;
        Result := i;
        Exit;
      }
    }    
  }
}//Function AddBaseDocLevel

//Убрать фиктивный уровень группировки (см. AddBaseDocLevel)
Function SubBaseDocLevel: LongInt;
{
  Result := 0;

  if (ReportTip = 2)  
  { 
    ReReadRecord(#JornTune);
    If(BaseDocLevel > 0)
    {
      Set JornTune.TblOs[BaseDocLevel] := 0;
      Update current JornTune;
    }    
  }
  
  if (ReportTip = 9)  
  { 
    ReReadRecord(#JornTune);
    If(BaseDocLevel > 0)
    {
      Set JornTune.TblOs[BaseDocLevel] := 0;
      Update current JornTune;
    }    
  }
}//Function SubBaseDocLevel


Function IsOwnPor(wTip: word) : boolean;
!является ли платежный документ собственным документом-поручением
{
  case wTip of
    1,3,4,5,21,31,37,38,44:
     IsOwnPor := true;
  else
     IsOwnPor := false;
  end;
}

Function IsAnotherTreb(wTip: word) : boolean;
!является ли платежный документ сторонним документом-требованием
{
  case wTip of
    1011,1030,1032 :
     IsAnotherTreb := true;
  else
     IsAnotherTreb := false;
  end;
}

// контрагент - получатель
function isKontrPol(wTip: word): boolean;
{
  isKontrPol := IsOwnPor(wTip) or IsAnotherTreb(wTip);
}

// вид накл как сопр.док-та в зав от оп
function GetNaklDirect(_VidSopr: word): word;
{
  case _VidSopr of
    501..506,511,512,521,522,523,554,559,
    600..607,611..613,621,622 :
      GetNaklDirect := 0;
    100..199,553,907,1410,1411,626 : // закупка
      GetNaklDirect := 2;
    200..299,513,557,629,610,911,919,1420,1421,1610 : // продажа
      GetNaklDirect := 1;
    else
      GetNaklDirect := 0; // внутренний
  end;
}

//==============================================
// формирование отчета
//---------------------------------------------
Function MakeReport:boolean;
{
  timelog('GP_DKZ->MakeReport:Start');
  Result:=True;
  ClearFuncCache;
  
  if BoundActive(tbbn_OK)   { SubBounds(tbbn_OK);   }
  if BoundActive(tbbn_O)    { SubBounds(tbbn_O);    }
  if BoundActive(tbbn_K)    { SubBounds(tbbn_K);    }
  if BoundActive(tbbn_OSUB) { SubBounds(tbbn_OSUB); }
  if BoundActive(tbbn_KSUB) { SubBounds(tbbn_KSUB); }  
  
  for(i:=0;i<=15;i:=i+1)
   {
       SUMD[i]:=0;
       SUMD0[i]:=0;
       SUMD1[i]:=0;
       SUMD2[i]:=0;
       SUMK0[i]:=0;
       SUMK1[i]:=0;
       SUMK2[i]:=0;
       SUMK[i]:=0;
   }

  //Добавил фиктивный уровень группировки "Документы-основани"
  baseDocLevel := AddBaseDocLevel;  
  
  _SCHETO    := ''; _SCHETK    := '';   
  _SCHETOSUB := ''; _SCHETKSUB := '';
  
  if DlgOndate=1 then BegDate:=EndDate;
  _log('Старт = '+BegDate+'    '+EndDate);
  //=====================================
  StartNewVisual(vtNumericVisual,vfTimer+vfBreak+vfConfirm,'Отбор данных для отчета'#13,0);
  //=====================================
  // Для возможности прерывания
  DO {
    //-----------------
    MTRetrieve(#tOborot,mfFilters + mfClear);
    MTRetrieve(#ttreest,mfFilters + mfClear);
    MTRetrieve(#tmp_saldo,mfFilters + mfClear) ;
    MTRetrieve(#tmp_KatSopr,mfFilters + mfClear);

    //-----------------
    delete all tOborot;
    delete all ttreest;
    //-----------------
    pVA_DOGOVOR_KBK:= ExtAttr_ID(coDogovor,'.Основная статья ДДС');

    fIskl:=fDOG:=fCO:=FOrg:=fVIDV:=FPodr:=false;
    _Loop SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and
                                     cReport  == SpBuhRep.cEntity and
                                     'gp_m1'  == SpBuhRep.STBL))
    { fOrg:=true;
      break;
    }
    _Loop SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and
                                     cReport  == SpBuhRep.cEntity and
                                    'gp_m2'   == SpBuhRep.STBL))
    { fDOG:=true;
      break;
    }
    _Loop SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and
                                     cReport  == SpBuhRep.cEntity and
                                    'gp_m3'   == SpBuhRep.STBL))
    { fCO:=true;
      break;
    }
    _Loop SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and
                                     cReport  == SpBuhRep.cEntity and
                                    'gp_m4'   == SpBuhRep.STBL))
    { fvidv:=true;
      break;
    }
    _Loop SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and
                                     cReport  == SpBuhRep.cEntity and
                                    'gp_m5'   == SpBuhRep.STBL))
    { fPodr:=true;
      break;
    }
    timelog('GP_DKZ->MakeReport:Filtr=fIskl='+String(fIskl)+',fDOG='+string(fDOG)
               +',fCO='+string(fCO)+', FOrg='+string(FOrg)+',fVIDV='+string(fVIDV)
               +',fPodr='+string(fPodr)
               );

   // GetOborot()
    _log('VipParams.cJOrder='+VipParams.cJOrder);
    GetDKZNastr;
    if getfirst MemIskl where ((0 == memiskl.tip))=tsok then
    { fIskl:=true;
    }
    _log('filters  '+string(fDOG)+'  '+string(fOrg)+'  '+string(fCO)+'  '+string(fvidv)+' ISKL = '+string(fiskl));
    _log('MemNastr.tip 1='+string(if(getfirst MemNastr where ((1 == MemNastr.tip))=tsok,true,false)));
    var _Tip    :word;
    var _TipMax :word=1;
    var _TipScan:word=1;
    Case ReportTip of
    9: _TipMax:=3;
    end;
    For(_Tip:=1;_Tip<=_TipMax;_Tip++)
    { case _tip of
      1: _TipScan:=1;
      2: _TipScan:=2;
      3: _TipScan:=3;
      end;

      _loop MemNastr where ((_TipScan == MemNastr.tip))
      { if Not NextVisual then
        { Result:=False;
          break;
        }
                       
         if BoundActive(tbbn_OK)   { SubBounds(tbbn_OK);   }
         if BoundActive(tbbn_O)    { SubBounds(tbbn_O);    }
         if BoundActive(tbbn_K)    { SubBounds(tbbn_K);    }
         if BoundActive(tbbn_OSUB) { SubBounds(tbbn_OSUB); }
         if BoundActive(tbbn_KSUB) { SubBounds(tbbn_KSUB); }
         
          _SCHETO    := MemNastr.SCH;    _SCHETK    := MemNastr.SCHK;   
          _SCHETOSUB := MemNastr.subsch; _SCHETKSUB := MemNastr.subschk;         
        
        //EM-31	Оптимизировать время формирования отчета.
        If(_SCHETO = '')and(_SCHETK = '')
        { Continue; }        


        fSaldo:=true;
        
        If(SubStr(_SCHETO,2,255) = '76')Or(SubStr(_SCHETK,2,255) = '076')
        { BD:=Date(1,1,1990); }
        else
        { BD:=BegDate; }        
        
         if BoundActive(tbbn_S1)   { SubBounds(tbbn_S1);    }
         if BoundActive(tbbn_SSUB1){ SubBounds(tbbn_SSUB1); }
         if BoundActive(tbbn_S2)   { SubBounds(tbbn_S2);    }
         if BoundActive(tbbn_SSUB2){ SubBounds(tbbn_SSUB2); }
                  
        if (_SCHETO<>'') and (_SCHETOSUB='')
        { PushBounds(tbbn_S1);    }
        Else If (_SCHETO<>'') and (_SCHETOSUB<>'')
        { PushBounds(tbbn_SSUB1); } 
        
        if ConditionActiveInLeave(tcByEnabledSaldoKAU1, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU1, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU2, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU2, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU3, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU3, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU4, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU4, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU5, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU5, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU6, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU6, tnsaldmoun); }

        If(MemNastr.kauos[1] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU1, tnsaldmoun); }
        If(MemNastr.kauos[2] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU2, tnsaldmoun); }
        If(MemNastr.kauos[3] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU3, tnsaldmoun); }
        If(MemNastr.kauos[4] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU4, tnsaldmoun); }
        If(MemNastr.kauos[5] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU5, tnsaldmoun); }
        If(MemNastr.kauos[6] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU6, tnsaldmoun); }
                
        if (getlast saldmoun) = tsok
        { BD:=saldmoun.DATESAL; }
        else
        { BD:=ZeroDate; }

        if BoundActive(tbbn_S1)   { SubBounds(tbbn_S1);    }
        if BoundActive(tbbn_SSUB1){ SubBounds(tbbn_SSUB1); }
        if BoundActive(tbbn_S2)   { SubBounds(tbbn_S2);    }
        if BoundActive(tbbn_SSUB2){ SubBounds(tbbn_SSUB2); }

        if (_SCHETO<>'') and (_SCHETOSUB='')
        { PushBounds(tbbn_S2);    }
        Else If (_SCHETO<>'') and (_SCHETOSUB<>'')
        { PushBounds(tbbn_SSUB2); } 

        if ConditionActiveInLeave(tcByEnabledSaldoKAU1, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU1, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU2, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU2, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU3, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU3, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU4, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU4, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU5, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU5, tnsaldmoun); }
        if ConditionActiveInLeave(tcByEnabledSaldoKAU6, tnsaldmoun) { PopConditionForLeave(tcByEnabledSaldoKAU6, tnsaldmoun); }

        If(MemNastr.kauos[1] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU1, tnsaldmoun); }
        If(MemNastr.kauos[2] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU2, tnsaldmoun); }
        If(MemNastr.kauos[3] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU3, tnsaldmoun); }
        If(MemNastr.kauos[4] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU4, tnsaldmoun); }
        If(MemNastr.kauos[5] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU5, tnsaldmoun); }
        If(MemNastr.kauos[6] <> 0) { PushConditionForLeave(tcByEnabledSaldoKAU6, tnsaldmoun); }

        _log('СД = '+BD );
        _loop saldmoun 
        { if Not iNextVisual('Просмотр сальдо '+SubStr(_SCHETO, 2, 255)+'.'+_SCHETOSUB+''#13+saldmoun.dateSal) then
          { Result:=False;
            break;
          }          
          
            if not EnabledSaldoDOG then continue;
            if not EnabledSaldoOrg then continue;
            if not EnabledSaldoVidV then continue;
            if not EnabledCO then continue;
            if not EnabledSaldoPodr then continue;

            LoadGroup(0);
            if getfirst tOborot where ((
               //             saldmoun.SCHETO == tOborot.sch and
             //          saldmoun.SUBOSSCH == tOborot.subsch And
                               MemNastr.dkz == tOborot.dkz and
                                a_cgr[1] == tOborot.cgr[1] and
                                a_cgr[2] == tOborot.cgr[2] and
                                a_cgr[3] == tOborot.cgr[3] and
                                a_cgr[4] == tOborot.cgr[4] and
                                a_cgr[5] == tOborot.cgr[5] and
                                a_cgr[6] == tOborot.cgr[6]
                                      )) = tsok then
            {            
              LoadSumma(if(saldmoun.VIOB=1,saldmoun.sums,-saldmoun.sums));
              update current tOborot;
            }
            else
            {
              ClearBuffer(#tOborot);
              for(i:=1;i<=6;i:=i+1)
              { set tOborot.gr[i]:=a_gr[i];
                set tOborot.cgr[i]:=a_cgr[i];
                set tOborot.wgr[i]:=a_wgr[i];
                set tOborot.TBLOS[i] := saldmoun.TBLOS[i];
                set tOborot.kauos[i] := saldmoun.kauos[i];
                if saldmoun.TBLOS[i]=cgKau_KatOrg
                { set tOborot.cOrg :=saldmoun.kauOs[i];
                }
                if saldmoun.TBLOS[i]=cgKau_Dogovor
                { set tOborot.cDogKau :=saldmoun.kauOs[i];
                }
                if saldmoun.TBLOS[i]=cgKau_BaseDoc
                { set tOborot.cDOKau :=saldmoun.kauOs[i];
                }
              }
              set tOborot.tip  :=MemNastr.Tip;
              set tOborot.d:=saldmoun.DATESAL;
              set tOborot.name := 'Сальдо';
              set tOborot.sch      := saldmoun.SCHETO;
              set tOborot.subsch   := saldmoun.SUBOSSCH;

              set tOborot.cOrg :=cDKZ_KatOrg;
              LoadSoprDoc;
              
              If(1 = MemNastr.tip)//Вкладка "Основные"
              {              
                //EM-31 не включать с меньшей просроченной задолженностью
                If(Not CheckKolDaysProsr(tOborot.day_Prosr))
                {Continue;}              
              }  
              
              LoadSumma(if(saldmoun.VIOB=1,saldmoun.sums,-saldmoun.sums));
              set tOborot.dkz:=MemNastr.dkz;
              insert current tOborot;
            }
       } //_loop saldmoun where
       
       if not Result Break;
       
       BegDateB:=BD;
       EndDateB:=Sub_Day(BegDate,1);
       _log('Loop1 '+BegDateB+'   '+EndDateB);
       if EndDateB>BegDateB
       { if Not LoopOborot(1)
         { Result:=False;
           break;
         }
       }
       case ReportTip of
       9: if _TipScan=2 continue;//Резерв на начало периода
       end;
       fSaldo:=false;
       BegDateB:=BegDate;
       EndDateB:=ENDDate;
       _log('Loop2 '+BegDateB+'   '+EndDateB);
       if not LoopOborot(2)
       { Result:=False;
         break;
       }
       timelog('end _loop oborot' );

      } //_loop MemNastr where ((1 == MemNastr.tip))
      if not Result Break;
   } //For(_Tip:=1;_Tip<=_TipMax;_Tip++)
   cDKZ_Dogovor := 0;   
   //=====================================

   if not Result Break;
   
   //=====================================
   // Надо раскидать встречную задолженность
   if ReportTip=9
   { ReReadRecord(#tOborot5);
     timelog('===== Учтем встречные обязательства ==== ');
     _Loop  tOborot where (( 1                     == tOborot.tip
                          ))
     {
       If(GetFirst FastFirstRow Dogovor where((tOborot.cDogKAU == Dogovor.nrec)) = TsOk)
       { tOborot.dDogKAU := Dogovor.dDoc; }
       else
       { tOborot.dDogKAU := Date(31, 12, 2100); }
       
       If(GetFirst FastFirstRow BaseDoc where((tOborot.cDOKAU  == BaseDoc.nrec)) = TsOk)
       { tOborot.dDOKAU := BaseDoc.dDoc; }
       else
       { tOborot.dDOKAU := Date(31, 12, 2100); }
       
       If(Update Current tOborot = TsOk)
       {}
     }

     _Loop fullcache tOborot5 where (( 3 == tOborot5.tip ))
     { /*if timelog_status>2 */timelog('tOborot5.SummaIn ='+String(tOborot5.SummaIn,0,2));
       if tOborot5.SummaIn>=0 then continue; // Знак обратный ж
       var _wsu:tSumma=-tOborot5.summaIn; // меняем знак
       _Loop fullcache tOborot where (( 1 == tOborot.tip
       and tOborot5.cOrg == tOborot.cOrg

        )) Ordered by tOborot.dDogKAU, tOborot.dDOKAU 
       { //if timelog_status>2 
           timelog('001 tOborot.SummaIn ='+String(tOborot.SummaIn,0,2)
           +' , tOborot.istek_summa='+string(tOborot.istek_summa,0,2)  );

         if  ( tOborot.istek_summa<=0) then continue;
         if tOborot.SummaIn>=tOborot.istek_summa then continue;
         if _wsu>tOborot.istek_summa-tOborot.SummaIn
         { _wsu:=_wsu-(tOborot.istek_summa-tOborot.SummaIn);
           tOborot.SummaIn:=tOborot.SummaIn+tOborot.istek_summa-tOborot.SummaIn;
           update current tOborot;
         }
         else
         { tOborot.SummaIn:=tOborot.SummaIn+_wsu;
           update current tOborot;
           _wsu:=0;
           break;
         }
         //if timelog_status>2 
         timelog('002 tOborot.SummaIn ='+String(tOborot.SummaIn,0,2)
           +' , tOborot.istek_summa='+string(tOborot.istek_summa,0,2) );

       } //_Loop fullcache tOborot where (( 1 == tOborot1.tip
       delete current tOborot5;
     } //_Loop tOborot5 where (( 3 == tOborot5.tip ))
   } //if ReportTip=9
   // Надо раскидать встречную задолженность
   //=====================================


   //=====================================
   if not Result Break;
   //=====================================
   if BoundActive(tbbn_OK)   { SubBounds(tbbn_OK);   }
   if BoundActive(tbbn_O)    { SubBounds(tbbn_O);    }
   if BoundActive(tbbn_K)    { SubBounds(tbbn_K);    }
   if BoundActive(tbbn_OSUB) { SubBounds(tbbn_OSUB); }
   if BoundActive(tbbn_KSUB) { SubBounds(tbbn_KSUB); }
   
    StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Суммирование данных', RecordsInTable(tntOborot));
    _loop fullcache toborot
    { if not NextVisual
      { Result:=False;
        break;
      }
       if Round(abs(toborot.summa),3)=0 then
      //   delete toborot2 where ((toborot.NRec == toborot2.nrec));
       {
         if (ReportTip <> 9)
         { delete current  toborot;
           continue;
         }
         else
         { if  abs(toborot.summaR)<0.003  // "Резерв на начало периода"
           and abs(toborot.summaIn)<0.003 //"Встречные обязательства"
           { delete current  toborot;
             continue;
           }
         }
       }
      if toborot.dkz=2 then
       {
         if toborot.summa > 0 then {set toborot.dkz:=0;} else {set toborot.dkz:=1;}
         update current toborot;
       }
      toborot.tGroup:=GetGroupFromSchet(toborot.DKZ,toborot.sch,toborot.subsch);
      update current toborot;

      if toborot.dkz=0 then
      {
        SUMD[1]:=SUMD[1]+toborot.summa             ;
        SUMD[2]:=SUMD[2]+toborot.istek_summa       ;
        SUMD[3]:=SUMD[3]+toborot.sum_prosr[1]      ;
        SUMD[4]:=SUMD[4]+toborot.sum_prosr[2]      ;
        SUMD[5]:=SUMD[5]+toborot.sum_prosr[3]      ;
        SUMD[6]:=SUMD[6]+toborot.sum_prosr[4]      ;
        SUMD[7]:=SUMD[7]+toborot.sum_prosr[5]      ;
        SUMD[8]:=SUMD[8]+toborot.sum_prosr[6]      ;
        SUMD[9]:=SUMD[9]+toborot.sum_prosr[7]      ;
        SUMD[10]:=SUMD[10]+toborot.sum_prosr[8]    ;
        SUMD[11]:=SUMD[11]+toborot.sum_prosr[9]    ;
        if ReportTip=6 then
        {
          case toborot.tGroup of
          0: {
            SUMD0[1]:=SUMD0[1]+toborot.summa             ;
            SUMD0[2]:=SUMD0[2]+toborot.istek_summa       ;
          }
          1: {
            SUMD1[1]:=SUMD1[1]+toborot.summa             ;
            SUMD1[2]:=SUMD1[2]+toborot.istek_summa       ;
          }
          2: {
            SUMD2[1]:=SUMD2[1]+toborot.summa             ;
            SUMD2[2]:=SUMD2[2]+toborot.istek_summa       ;
          }
         end;
        }

       } //if toborot.dkz=0 then
       ELSE
       {
        SUMK[1]:=SUMK[1]+(-toborot.summa)             ;
        SUMK[2]:=SUMK[2]+(-toborot.istek_summa)       ;
        SUMK[3]:=SUMK[3]+(-toborot.sum_prosr[1])      ;
        SUMK[4]:=SUMK[4]+(-toborot.sum_prosr[2])      ;
        SUMK[5]:=SUMK[5]+(-toborot.sum_prosr[3])      ;
        SUMK[6]:=SUMK[6]+(-toborot.sum_prosr[4])      ;
        SUMK[7]:=SUMK[7]+(-toborot.sum_prosr[5])      ;
        SUMK[8]:=SUMK[8]+(-toborot.sum_prosr[6])      ;
        SUMK[9]:=SUMK[9]+(-toborot.sum_prosr[7])      ;
        SUMK[10]:=SUMK[10]+(-toborot.sum_prosr[8])    ;
        SUMK[11]:=SUMK[11]+(-toborot.sum_prosr[9])    ;
        if ReportTip=6 then
        {
          case toborot.tGroup of
          0: {
            SUMK0[1]:=SUMK0[1]+(-toborot.summa)             ;
            SUMK0[2]:=SUMK0[2]+(-toborot.istek_summa)       ;
          }
          1: {
            SUMK1[1]:=SUMK1[1]+(-toborot.summa)             ;
            SUMK1[2]:=SUMK1[2]+(-toborot.istek_summa)       ;
          }
          2: {
            SUMK2[1]:=SUMK2[1]+(-toborot.summa)             ;
            SUMK2[2]:=SUMK2[2]+(-toborot.istek_summa)       ;
          }
          end;
        }
      } //else if toborot.dkz=0 then

     if toborot.Kontr='' then
      {
       set toborot.Kontr:=GetNameLevel(toborot.Kontr);
       update current toborot;
      }
     timelog(' _loop fullcache toborot 03' );
     if toborot.dkz=1 then
     {
       set toborot.summa                 := -toborot.summa;
       set toborot.istek_summa           := -toborot.istek_summa;
       set toborot.sum_prosr[1]          := -toborot.sum_prosr[1];
       set toborot.sum_prosr[2]          := -toborot.sum_prosr[2];
       set toborot.sum_prosr[3]          := -toborot.sum_prosr[3];
       set toborot.sum_prosr[4]          := -toborot.sum_prosr[4];
       set toborot.sum_prosr[5]          := -toborot.sum_prosr[5];
       set toborot.sum_prosr[6]          := -toborot.sum_prosr[6];
       set toborot.sum_prosr[7]          := -toborot.sum_prosr[7];
       set toborot.sum_prosr[8]          := -toborot.sum_prosr[8];
       set toborot.sum_prosr[9]          := -toborot.sum_prosr[9];
       update current toborot;
     }
     timelog(' _loop fullcache toborot 04' );
   } //_loop fullcache toborot
   StopVisual;
   
   
 //=======
 } WHILE FALSE
 StopVisual;

 //-------- Финальное формирование
 var _tsok:longint;
  _tsok:=getfirst toborot;
  _log('toborot='+string(_tsok=tsok));
  _tsok:=getfirst ttrees;
  _log('ttrees1='+string(_tsok=tsok));
  
  //EM-108 Сумму  "Всего по документам" приравнять к "сумме по проводкам"
  If(Update tOborot Set tOborot.sumDoc := tOborot.summa) = TsOk    
  {}                               

  TreeBuilding(0);
  TreeBuilding(1);
  TreeAggrigation(0);
  TreeAggrigation(1);
  
  If (ReportTip <> 9)
  { 
    //EM-108 Исключить из иерархии договора с нулевой итоговой суммой
    TreeDelMinusSum(0, cgKau_Dogovor);
    TreeDelMinusSum(1, cgKau_Dogovor);   
    TreeAggrigation(0);
    TreeAggrigation(1);

    //EM-108 Исключить из иерархии контрагентов с отрицательной или нулевой итоговой суммой
    TreeDelMinusSum(0, wDKZ_OrgSchSubSch);
    TreeDelMinusSum(1, wDKZ_OrgSchSubSch);   
    TreeDelMinusSum(0, cgKau_KatOrg);
    TreeDelMinusSum(1, cgKau_KatOrg);       
    //EM-316 Исключить из иерархии сотрудников с отрицательной или нулевой итоговой суммой
    TreeDelMinusSum(0, cgKau_Persons);
    TreeDelMinusSum(1, cgKau_Persons);       
    TreeAggrigation(0);
    TreeAggrigation(1);

    //EM-108 Скрыть колонку "Всего по документам" в дереве по дебету и по кредиту
    ToggleFieldVisible(#tTreeD.sumDoc, false);
    ToggleFieldVisible(#tTreeK.sumDoc, false);
    
    If( //EM-108 Есть группировка "Документы"
           JornTune.tblos[1] = wDKZ_D
        Or JornTune.tblos[2] = wDKZ_D
        Or JornTune.tblos[3] = wDKZ_D
        Or JornTune.tblos[4] = wDKZ_D
        Or JornTune.tblos[5] = wDKZ_D
        Or JornTune.tblos[6] = wDKZ_D        
      )
    {
      //EM-108 Есть записи по 76 счету
      If (GetFirst FastFirstRow ttreesx Where(Substr(ttreesx.schet, 2, 2) = '76'))=TsOk
      {
        If (BaseDocLevel = 0)
        {
          ToggleFieldVisible(#tTreeD.sumDoc, True);    
          ToggleFieldVisible(#tTreeK.sumDoc, True);    
        }
        
        StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Расчет сальдо КОУ по документам', RecordsInTable(tntOborot));
        //EM-108 Иссключить из иерархии полностью разнесенные документы по 76 счету
        _Loop tOborot
        {
          If(Not NextVisual)
          {Break;}                
          
          If(Substr(tOborot.schet, 2, 2)<>'76')
          {
            Continue;
          } 
          
          for(i:=1; i<=6; i++)
          {
            if(cgKau_KatSopr = tOborot.wgr[i])
            { 
              vOtg.CurSoprDoc := tOborot.cgr[i];
              If(vOtg.GetFirst FastFirstRow KatSopr = TsOk)
              {
                vOtg._Loop SPSopr
                {
                  vOtg._Loop spsophoz
                  {
                    if(vOtg.getfirst FastFirstRow soprhoz <> tsok)
                    { continue; }
                    
                    if(vOtg.getfirst FastFirstRow plpor <> tsok)
                    { continue; }
                    
                    If(vOtg.plpor.datvip = ZeroDate)
                    { continue; }
                    
                    If(vOtg.plpor.datvip > EndDate)
                    { continue; }
                                 
                    tOborot.sumOpl += vOtg.spsophoz.summa;
                  }
                }
                tOborot.sumOtg := vOtg.KatSopr.Summa;              
                   
                Case(GetNaklDirect(vOpl.KatSopr.vidSopr))Of
                  1://наши продажа, наши оказания услуг
                  {
                    If(tOborot.dkz = 0)//ДЗ
                    { tOborot.sumDoc  := Round(tOborot.sumOtg-tOborot.sumOpl, 2); }
                    else
                    { tOborot.sumDoc  := Round(tOborot.sumOpl-tOborot.sumOtg, 2); }
                  }
                  2://мы покупаем, нам оказавают услуги
                  {
                    If(tOborot.dkz = 1)//КЗ
                    { tOborot.sumDoc  := Round(tOborot.sumOtg-tOborot.sumOpl, 2); }
                    else
                    { tOborot.sumDoc  := Round(tOborot.sumOpl-tOborot.sumOtg, 2); }
                  }
                  else//внутренний документ
                  { tOborot.sumDoc  := Round(tOborot.sumOtg-tOborot.sumOpl, 2); }
                End;  
                
                If(Update Current tOborot = TsOk)           
                {}  
                                              
              } 
            }       
            
            if(cgKau_plpor = tOborot.wgr[i])
            {
              vOpl.CurSoprDoc := tOborot.cgr[i];
              If(vOpl.GetFirst FastFirstRow PlPor = TsOk)
              {         
                vOpl._loop SoprHoz
                {
                  vOpl._Loop spsophoz
                  {
                    if(vOpl.getfirst FastFirstRow SpSopr <> tsok)
                    { continue; }              
        
                    if(vOpl.getfirst FastFirstRow katSopr <> tsok)
                    { continue; }              

                    If(vOpl.katSopr.dOpr = ZeroDate)
                    { continue; }
        
                    If(vOpl.katSopr.dOpr > EndDate)
                    { continue; }
                    
                    tOborot.sumOtg += vOpl.spsophoz.summa;                              
                  }
                }                                                       
                tOborot.sumOpl := vOpl.PlPor.SumPlat;
                
                If(vOpl.PlPor.TiDkGal = 10) //Бух.справка
                { tOborot.sumDoc := Round(tOborot.sumOpl-tOborot.sumOtg, 2); }
                else
                {
                  If(isKontrPol(vOpl.PlPor.TiDkGal))//мы платим контрагенту
                  { 
                    If(tOborot.dkz = 0)//0 - ДЗ
                    { tOborot.sumDoc := Round(tOborot.sumOpl-tOborot.sumOtg, 2); }
                    Else
                    { tOborot.sumDoc := Round(tOborot.sumOtg-tOborot.sumOpl, 2); }
                  }
                  Else
                  { 
                    If(tOborot.dkz = 1)//1 - КЗ
                    { tOborot.sumDoc := Round(tOborot.sumOpl-tOborot.sumOtg, 2); }
                    Else
                    { tOborot.sumDoc := Round(tOborot.sumOtg-tOborot.sumOpl, 2); }
                  }
                }
        
                If(Update Current tOborot = TsOk)           
                {}                                                     
              }
            }

            if(cgKau_plpor = tOborot.wgr[i])Or(cgKau_KatSopr = tOborot.wgr[i])
            {  
              For(j:=0; j<=i; j++)           
              {                              
                If(toborot.cTreeNode[j] <> 0)
                {                
                  If ((Update ttreesx Where((toborot.cTreeNode[j] == ttreesx.nrec)) 
                                      Set ttreesx.sumDoc := ttreesx.sumDoc-tOborot.summa+tOborot.sumDoc) = TsOk)
                  {} 
                }  
              }

              If(GetFirst FastFirstRow ttreesx Where((toborot.cTreeNode[i] == ttreesx.nrec))=TsOk)
              {
                If (Round(tOborot.sumDoc, 2)=0) And (Round(tOborot.sumOpl, 2)<>0 Or Round(tOborot.sumOtg, 2)<>0)                            
                {                              

                  If ((Update Current ttreesx
                                  Set ttreesx.dkz    := 10 + ttreesx.dkz
                                     ,ttreesx.cOwner := -1  
                     ) = TsOk)
                  {}    
                } 
                Else
                {
                  If(cgKau_KatSopr = tOborot.wgr[i])
                  {
                    If(tOborot.sumOpl = 0)
                    {
                      koefRaspr := 1;
                    }
                    Else If(tOborot.sumOtg = 0)
                    {
                      koefRaspr := 1;
                    }  
                    Else
                    {
                      koefRaspr := tOborot.sumDoc/tOborot.sumOtg;
                    }  
                  }
                  
                  if(cgKau_plpor = tOborot.wgr[i])
                  {
                    If(tOborot.sumOpl = 0)
                    {
                      koefRaspr := 1;
                    }
                    Else If(tOborot.sumOtg = 0)
                    {
                      koefRaspr := 1;
                    }  
                    Else
                    {
                      koefRaspr := tOborot.sumDoc/tOborot.sumOpl;
                    }
                  } 
                  
                  If ((Update Current tOborot
                                  Set tOborot.Summa        := koefRaspr*tOborot.Summa
                                     ,tOborot.sum_prosr[1] := koefRaspr*tOborot.sum_prosr[1]
                                     ,tOborot.sum_prosr[2] := koefRaspr*tOborot.sum_prosr[2]
                                     ,tOborot.sum_prosr[3] := koefRaspr*tOborot.sum_prosr[3]
                                     ,tOborot.sum_prosr[4] := koefRaspr*tOborot.sum_prosr[4]
                                     ,tOborot.sum_prosr[5] := koefRaspr*tOborot.sum_prosr[5]
                                     ,tOborot.sum_prosr[6] := koefRaspr*tOborot.sum_prosr[6]
                                     ,tOborot.sum_prosr[7] := koefRaspr*tOborot.sum_prosr[7]
                                     ,tOborot.istek_summa  := koefRaspr*tOborot.istek_summa 
                                     ,tOborot.summaR       := koefRaspr*tOborot.summaR      
                                     ,tOborot.summaIN      := koefRaspr*tOborot.summaIN     
                                     ,tOborot.sum_dop[1]   := koefRaspr*tOborot.sum_dop[1]  
                                     ,tOborot.sum_dop[2]   := koefRaspr*tOborot.sum_dop[2]  
                                     ,tOborot.sum_dop[3]   := koefRaspr*tOborot.sum_dop[3]  
                                     ,tOborot.sum_dop[4]   := koefRaspr*tOborot.sum_dop[4]  
                                     ,tOborot.sum_dop[5]   := koefRaspr*tOborot.sum_dop[5]  
                                     ,tOborot.sum_dop[6]   := koefRaspr*tOborot.sum_dop[6]  
                                     ,tOborot.sum_dop[7]   := koefRaspr*tOborot.sum_dop[7]
                     ) = TsOk)
                  {}    
                  If ((Update Current ttreesx
                                  Set ttreesx.Summa        := koefRaspr*ttreesx.Summa
                                     ,tTreesX.sum_prosr[1] := koefRaspr*tTreesX.sum_prosr[1]
                                     ,tTreesx.sum_prosr[2] := koefRaspr*tTreesx.sum_prosr[2]
                                     ,tTreesx.sum_prosr[3] := koefRaspr*tTreesx.sum_prosr[3]
                                     ,tTreesx.sum_prosr[4] := koefRaspr*tTreesx.sum_prosr[4]
                                     ,tTreesx.sum_prosr[5] := koefRaspr*tTreesx.sum_prosr[5]
                                     ,tTreesx.sum_prosr[6] := koefRaspr*tTreesx.sum_prosr[6]
                                     ,tTreesx.sum_prosr[7] := koefRaspr*tTreesx.sum_prosr[7]
                                     ,tTreesx.istek_summa  := koefRaspr*tTreesx.istek_summa 
                                     ,ttreesX.summaR       := koefRaspr*ttreesX.summaR      
                                     ,ttreesX.summaIN      := koefRaspr*ttreesX.summaIN     
                                     ,tTreesX.sum_dop[1]   := koefRaspr*tTreesX.sum_dop[1]  
                                     ,tTreesx.sum_dop[2]   := koefRaspr*tTreesx.sum_dop[2]  
                                     ,tTreesx.sum_dop[3]   := koefRaspr*tTreesx.sum_dop[3]  
                                     ,tTreesx.sum_dop[4]   := koefRaspr*tTreesx.sum_dop[4]  
                                     ,tTreesx.sum_dop[5]   := koefRaspr*tTreesx.sum_dop[5]  
                                     ,tTreesx.sum_dop[6]   := koefRaspr*tTreesx.sum_dop[6]  
                                     ,tTreesx.sum_dop[7]   := koefRaspr*tTreesx.sum_dop[7]
                     ) = TsOk)
                  {}                                       
                }
              }                            
              Break;  
            }
          }//for
        }        
        If (Delete all from tOborot where (Round(tOborot.sumDoc, 2)=0) And (Round(tOborot.sumOpl, 2)<>0 Or Round(tOborot.sumOtg, 2)<>0)) = TsOk
        {}       

        If (BaseDocLevel = 0)
        {
          //24.04.2020 - После исключения из отчета полностью закрытых документов, необходимо пересчитать итоги в иерархии
          TreeAggrigation(0); //Дебиторская задолженность  - расчет Итогов в "дереве"
          TreeAggrigation(1); //Кредиторская задолженность  - расчет Итогов в "дереве"        

          TreeDayProsr(0);
          TreeDayProsr(1);   
        }
        Else
        {  
          TreeDayProsr(0);
          TreeDayProsr(1);   

          //24.04.2020 - После исключения из отчета полностью закрытых документов, необходимо пересчитать итоги в иерархии
          TreeAggrigation(0); //Дебиторская задолженность  - расчет Итогов в "дереве"
          TreeAggrigation(1); //Кредиторская задолженность  - расчет Итогов в "дереве"        
        }

        StopVisual;
        
        StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Формирование протокола', RecordsInTable(tnttreesx));
        oGP_Log.Init('GP_DKZ', true, true, true);        
        TreeLogErrSumma(0);
        TreeLogErrSumma(1);   
        oGP_Log.Done(true);  
        StopVisual;               
      }              
    }      
  }//If (ReportTip <> 9)    
  
  curOwnerD:=0;if getfirst ttreeD = tsok then {}
  curOwnerK:=0;if getfirst ttreeK = tsok then {}    
  RereadRecord;
  _log('ttrees2='+string(getfirst ttrees=tsok));
 
  timelog('GP_DKZ->MakeReport:Finish');


  //Вернуть запись в исходное состояние
  SubBaseDocLevel;
} //procedure MakeReport;

function GetReportToUniDoc(cUniDoc: comp; wSide: word; _VipParams: TVipReportParams; mDogs: TPtr): boolean;
{
  
  VipParams := _VipParams;
  RecordToDlg;
  DlgOndate := 1;
  DeleteAllPicks;
  StoreMarker(mDogs, 'GP_DKZ_MDogs');
  SaveMarker('GP_DKZ_MDogs', 'gp_m2');
  MakeReport;
  _loop tOborot
  {
    if getfirst Em_UniDoc_Spec where ((cUniDoc == Em_UniDoc_Spec.cHead 
                                   and wSide == Em_UniDoc_Spec.AddWord[1](noindex)
                                   and tOborot.tidkgal == Em_UniDoc_Spec.AddWord[2](noindex)
                                   and tOborot.cSoprDoc == Em_UniDoc_Spec.AddComp[2](noindex)
                                   )) = tsOk
    {
      if tOborot.dkz = 0
        Em_UniDoc_Spec.AddDouble[3] += tOborot.summa;
      else
        Em_UniDoc_Spec.AddDouble[4] += tOborot.summa;
      if getfirst BuhSchet where ((tOborot.sch == BuhSchet.Schet and tOborot.subsch == BuhSchet.SubSch)) = tsOK
        Em_UniDoc_Spec.AddComp[6] := buhschet.NRec;
      update current Em_UniDoc_Spec;
    }
    else
    {
      ClearBuffer(tnEm_UniDoc_Spec);
      Em_UniDoc_Spec.cHead := cUniDoc;
      Em_UniDoc_Spec.AddComp[1] := tOborot.cdog;
      Em_UniDoc_Spec.AddWord[1] := wSide;
      if tOborot.dkz = 0
        Em_UniDoc_Spec.AddDouble[3] := tOborot.summa;
      else
        Em_UniDoc_Spec.AddDouble[4] := tOborot.summa;
      Em_UniDoc_Spec.AddDate[1] := tOborot.dVoznPr;
      Em_UniDoc_Spec.AddComp[2] := tOborot.cSoprDoc;
      Em_UniDoc_Spec.AddWord[2] := tOborot.tidkgal;
      Em_UniDoc_Spec.AddWord[3] := tOborot.tidkUser;
      Em_UniDoc_Spec.AddDate[2] := tOborot.dsopr;
      Em_UniDoc_Spec.AddString[2] := tOborot.dnum;

      // Em_UniDoc_Spec.AddComp[4] := tmpDocs_Dop.cCalPlan;
      // Em_UniDoc_Spec.AddComp[5] := tmpDocs_Dop.cCalPlanFin;

      Em_UniDoc_Spec.AddDouble[5] := tOborot.sum_prosr[7];

      if getfirst BuhSchet where ((tOborot.sch == BuhSchet.Schet and tOborot.subsch == BuhSchet.SubSch)) = tsOK
        Em_UniDoc_Spec.AddComp[6] := buhschet.NRec;
      // Em_UniDoc_Spec.AddComp[7] := ;//СФ
      Em_UniDoc_Spec.AddComp[8] := tOborot.cDOKAU;
      insert current Em_UniDoc_Spec;
    }
  }
  Result := true;
}

constructor Init;
{
//  timelog_init;

  TimeLog_File:=GetStringParameter('Files','OutputFilesDirectory',0)
                               +'!TimeLog.log';

  if FileExist(TimeLog_File)
       DeleteFile(TimeLog_File);

  timelog('GP_DKZ->cmInit:Start');
  if (getfirst katkau where ((Root == katkau.nrec and (DKZ_D=upcase(KatKau.code)))) = tsok)
              then wDKZ_D:=katkau.kodgroup;
              else timelog(''#13#3'Не найдена аналитика "ДКЗ_Д" - "Документы"!'#13#3'Группировка может работать не корректно!'); // message(''#13#3'Не найдена аналитика "ДКЗ_Д" - "Документы"!'#13#3'Группировка может работать не корректно!',error)
  if getfirst katkau where ((Root == katkau.nrec and (DKZ_Sch=upcase(KatKau.code)))) = tsok
              then wDKZ_Sch:=katkau.kodgroup; else
              timelog(''#13#3'Не найдена аналитика "ДКЗ_СЧЕТ" - "Счета"!'#13#3'Группировка может работать не корректно!'); //message(''#13#3'Не найдена аналитика "ДКЗ_СЧЕТ" - "Счета"!'#13#3'Группировка может работать не корректно!',error);
  if getfirst katkau where ((Root == katkau.nrec and (DKZ_SubSch=upcase(KatKau.code))))= tsok
              then wDKZ_SubSch:=katkau.kodgroup;
              else timelog(''#13#3'Не найдена аналитика "ДКЗ_СУБСЧЕТ" - "Субсчета"!'#13#3'Группировка может работать не корректно!'); //message(''#13#3'Не найдена аналитика "ДКЗ_СУБСЧЕТ" - "Субсчета"!'#13#3'Группировка может работать не корректно!',error);
  if getfirst katkau where ((Root == katkau.nrec and (DKZ_SchSubSch=upcase(KatKau.code))))= tsok
              then wDKZ_SchSubSch:=katkau.kodgroup;
              else timelog(''#13#3'Не найдена аналитика "ДКЗ_СЧЕТСУБСЧЕТ" - "Счета и Субсчета"!'#13#3'Группировка может работать не корректно!'); //message(''#13#3'Не найдена аналитика "ДКЗ_СЧЕТСУБСЧЕТ" - "Счета и Субсчета"!'#13#3'Группировка может работать не корректно!',error);
  if getfirst katkau where ((Root == katkau.nrec and (DKZ_OrgSchSubSch=upcase(KatKau.code))))= tsok
              then wDKZ_OrgSchSubSch:=katkau.kodgroup;
              else timelog(''#13#3'Не найдена аналитика "ДКЗ_ОРГСЧЕТСУБСЧЕТ" - "Организации, Счета и Субсчета"!'#13#3'Группировка может работать не корректно!'); // message(''#13#3'Не найдена аналитика "ДКЗ_ОРГСЧЕТСУБСЧЕТ" - "Организации, Счета и Субсчета"!'#13#3'Группировка может работать не корректно!',error);
  if getfirst katkau where ((Root == katkau.nrec and (upcase(DKZ_VIDV)=upcase(KatKau.code))))= tsok
              then wDKZ_vidv:=katkau.kodgroup;
              else timelog(''#13#3'Не найдена аналитика "ЭМ_Виды взаиморасчет"!'#13#3'Группировка может работать не корректно!'); //message(''#13#3'Не найдена аналитика "ЭМ_Виды взаиморасчет"!'#13#3'Группировка может работать не корректно!',error);
  MarkK:='KatOrg';
  MarkD:='Gt_cgKau_' + LPadCh(string(cgKau_Dogovor),'0',6) + '_Mrk';
  MarkC:='Gt_cgKau_' + LPadCh(string(cgKau_fpco   ),'0',6) + '_Mrk';
  MarkV:='Gt_cgKau_' + LPadCh(string(wDKZ_vidv    ),'0',6) + '_Mrk';
  MarkP:='Gt_cgKau_' + LPadCh(string(cgKau_KatPodr),'0',6) + '_Mrk';
  _log('MarkString = '+MarkD+' '+MarkC+' '+MarkV+' '+MarkP);
  cfsGetObjInfo(cfsGetCurrentContainerSelf,'', lEntity, 0, 0);
  wReport:=cgRepBuh_GPREP;
  cReport:=0;
  wMode:=cgiPick or cgiNotClear;
  CurDescr   := sGetTune('User.Descr');
  CurDesGr   := sGetTune('User.DesGr');
   
  ReadMyDSK(cReport,'GP_DKZ_cReport',true);
  If(cReport = 0)
  {cReport := iBuhRep.GetDefaultNastr(wReport, VipParams.cPlansSch);}    
  set cReport;
    
  if (not InitWithParam(wReport, cReport, wMode)) { abort; exit; }
  //--------------------------
  timelog('GP_DKZ->cmInit:Finish: cReport='+String(cReport,0,0));
  Result := true;
}


