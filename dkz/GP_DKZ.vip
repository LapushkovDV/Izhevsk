//EM-31 не включать с меньшей просроченной задолженностью
Function CheckKolDaysProsr(_dayProsr: LongInt): Boolean;
{
  Result := True;
  
  case ReportTip of
    9://Акт инвентаризации по просроченной задолженности
    {
      If(Kol_Days_Prosr <> 0)
      {    
        If(_dayProsr > 0)
        {
          If(_dayProsr < Kol_Days_Prosr)
          {
            Result := False;
          }
        }
        Else
        {
           Result := False;
        }
      }  
    }  
  end; 
}

