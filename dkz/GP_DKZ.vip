Function getSchet_subschetDeb: string ;
{
 var tmpStr : String = '';
  Result := ' ';
 _loop MemNastr where MemNastr.tip = 1
 {
   //#EN-316 
   tmpStr := SubStr(MemNastr.sch, 2, 255) + if(MemNastr.subsch <> '','.'+MemNastr.subsch,'');
   If (Pos(' '+tmpStr+' ', Result) = 0)
   {
     Result += tmpStr+' ';  
   }
 }
 Result := Trim(Result);
 Result := Replace(Result, ' ', ', ');
 Result := 'по счетам учёта: ' + Result;
}

