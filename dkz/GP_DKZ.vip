HandleEvent
cmInit: {
          if GetFirst ttreesx <> tsok then
           {
              Message('Нет данных!!!',Error);
              CloseWindow(Report_Result);
           }
        curOwnerD:=0;if getfirst ttreeD = tsok then {}
        curOwnerK:=0;if getfirst ttreeK = tsok then {}
        PutHotCommand(cmShowAll);
        }
cmValue8:PrintReport;
cmCancel:CloseWindow(Report_Result);
//cmPick: RunPick;
cmEdit: 
{
  if (CurTable = #ttreeK)
  {
    iEditDoc.RunEditHozDoc(coOborot, ttreeK.TiDkGal, ttreeK.TiDkGal, ttreeK.cSoprDoc);
  }     
  else
  {
    iEditDoc.RunEditHozDoc(coOborot, ttreeD.TiDkGal, ttreeD.TiDkGal, ttreeD.cSoprDoc);
  }     
}
cmBuhCalculator :
  {
    RunInterface('Buh_Calc',0,0,0);
  }

cmPrintDoc:PutCommand(cmValue8);
cmHotKeys:
  {
    PutHotCommand(RunDynMenu('GP_BU::mnDKZ_HotKeys'));
  }

cmShowAll :
  {
    TreePushPos(trcAT);
    StartNewVisual(vtNumericVisual, vfTimer + vfBreak + vfScreenBottom,'Раскрытие всех папок ДЗ',0);
    _try {
      for(ForCounter := TreeGetFirstEx(trcat);
          ForCounter;
          ForCounter := TreeGetNextEx(trcat)) {
        NextVisual;
        if (not TreeNodeIsOpen(trcat))
          TreeOpenNode(trcat);
      }
    }
    _except
      on ExUserBreak : {};
    _finally {
      TreePopPos(trcat);
      RescanPanel(#ttreed);
      StopVisual('',0);
    }


    TreePushPos(trcAT2);
    StartNewVisual(vtNumericVisual, vfTimer + vfBreak + vfScreenBottom,'Раскрытие всех папок КЗ',0);
    _try {
      for(ForCounter := TreeGetFirstEx(trcat2);
          ForCounter;
          ForCounter := TreeGetNextEx(trcat2)) {
        NextVisual;
        if (not TreeNodeIsOpen(trcat2))
          TreeOpenNode(trcat2);
      }
    }
    _except
      on ExUserBreak : {};
    _finally {
      TreePopPos(trcat2);
      RescanPanel(#ttreek);
      StopVisual('',0);
    }
   RescanPanel(#ttreek);
   RescanPanel(#ttreed);
  }

  cmHideAll :
  {
    // Поднимемся к ближайшему корню
    while TTREED.cOwner <> 0 {
      TreeJumpToRecord(trcat,TTREED.cOwner);
    }
    TreeCloseAllOpenedNode(trcat);
    while TTREEK.cOwner <> 0 {
      TreeJumpToRecord(trcat2,TTREEK.cOwner);
    }
    TreeCloseAllOpenedNode(trcat2);
      RereadRecord;
  }

end;
end; // window Report_Result


