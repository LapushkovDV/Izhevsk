function EnabledObIskl:boolean;
var fos,fks:boolean;
{

  if not fIskl then
  {
     Result:=true;
  }
  else
  {
    Result:=true;
    _loop MemIskl where ((
                0               == MemIskl.tip
            and Oborot.SCHETO   == MemIskl.sch
            and Oborot.SCHETK   == MemIskl.schk
            and MemNastr.dkz        == MemIskl.dkz
             ))
    {
     if fSaldo then
      {
        if MemIskl.saldo=0 then continue;
      }
     fos:=false;
     fks:=false;
     if MemIskl.subsch<>'' then {if Oborot.SUBOSSCH = MemIskl.subsch then fos:=true;}
                           else fos:=true;

     if not fos then continue;
     if MemIskl.subschk<>'' then {if Oborot.SUBSCHK = MemIskl.subschk then fks:=true;}
                           else fks:=true;
     if not fks then continue;
!     if timelog_Status>0
     { _Log('11');
       _log('OBOROT          = '+Oborot.SCHETO+'.'+Oborot.SUBOSSCH+'  '+Oborot.SCHETK+'.'+Oborot.SUBSCHK);
       _log('MemIskl.tblos[1]= '+MemIskl.tblos[1]);
       _log('oborot.tblos[1] = '+oborot.tblos[1]);
       _log('MemIskl.kauos[1]= '+MemIskl.kauos[1]);
       _log('oborot.kauos[1] = '+oborot.kauos[1]);
       _log('oborot.sumob    = '+string(oborot.sumob,0,4));
     }
     fos:=false;if MemIskl.kauos[1]<>0 then {if (oborot.tblos[1] = MemIskl.tblos[1])and(oborot.kauos[1] = MemIskl.kauos[1]) then fos:=true; }  else {fos:=true;}   if not fos then continue;
     fos:=false;if MemIskl.kauos[2]<>0 then {if (oborot.tblos[2] = MemIskl.tblos[2])and(oborot.kauos[2] = MemIskl.kauos[2]) then fos:=true; }  else {fos:=true;}   if not fos then continue;
     fos:=false;if MemIskl.kauos[3]<>0 then {if (oborot.tblos[3] = MemIskl.tblos[3])and(oborot.kauos[3] = MemIskl.kauos[3]) then fos:=true; }  else {fos:=true;}   if not fos then continue;
     fos:=false;if MemIskl.kauos[4]<>0 then {if (oborot.tblos[4] = MemIskl.tblos[4])and(oborot.kauos[4] = MemIskl.kauos[4]) then fos:=true; }  else {fos:=true;}   if not fos then continue;
     fos:=false;if MemIskl.kauos[5]<>0 then {if (oborot.tblos[5] = MemIskl.tblos[5])and(oborot.kauos[5] = MemIskl.kauos[5]) then fos:=true; }  else {fos:=true;}   if not fos then continue;
     fos:=false;if MemIskl.kauos[6]<>0 then {if (oborot.tblos[6] = MemIskl.tblos[6])and(oborot.kauos[6] = MemIskl.kauos[6]) then fos:=true; }  else {fos:=true;}   if not fos then continue;
     fks:=false;if MemIskl.kauks[1]<>0 then {if (oborot.tblks[1] = MemIskl.tblks[1])and(oborot.kauks[1] = MemIskl.kauks[1]) then fks:=true; }  else {fks:=true;}   if not fks then continue;
     fks:=false;if MemIskl.kauks[2]<>0 then {if (oborot.tblks[2] = MemIskl.tblks[2])and(oborot.kauks[2] = MemIskl.kauks[2]) then fks:=true; }  else {fks:=true;}   if not fks then continue;
     fks:=false;if MemIskl.kauks[3]<>0 then {if (oborot.tblks[3] = MemIskl.tblks[3])and(oborot.kauks[3] = MemIskl.kauks[3]) then fks:=true; }  else {fks:=true;}   if not fks then continue;
     fks:=false;if MemIskl.kauks[4]<>0 then {if (oborot.tblks[4] = MemIskl.tblks[4])and(oborot.kauks[4] = MemIskl.kauks[4]) then fks:=true; }  else {fks:=true;}   if not fks then continue;
     fks:=false;if MemIskl.kauks[5]<>0 then {if (oborot.tblks[5] = MemIskl.tblks[5])and(oborot.kauks[5] = MemIskl.kauks[5]) then fks:=true; }  else {fks:=true;}   if not fks then continue;
     fks:=false;if MemIskl.kauks[6]<>0 then {if (oborot.tblks[6] = MemIskl.tblks[6])and(oborot.kauks[6] = MemIskl.kauks[6]) then fks:=true; }  else {fks:=true;}   if not fks then continue;
     Result:=false;
    } //_loop MemIskl where ((

  } //if not fIskl then
} //function EnabledObIskl:boolean;

