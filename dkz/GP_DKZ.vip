//=====================================================
//9. #3835 Акт инвентаризации по просроченной задолженности
//-----------------------------------------------------
Function RecursionPrint09SP(_Name:string;_Level:word=0):boolean;
{  MyxlSetCellStringValue(_Name    ,wexrow, 1,wexrow, 1);
   if tTreesx.summaR <>0       then MyxlSetCellNumberValue(TochSum(tTreesx.summaR      ) ,wexrow, 2,wexrow, 2);
   if tTreesx.summa  <>0       then MyxlSetCellNumberValue(TochSum(tTreesx.summa       ) ,wexrow, 3,wexrow, 3);
   if tTreesx.summaIn<>0       then MyxlSetCellNumberValue(TochSum(tTreesx.summaIn     ) ,wexrow, 4,wexrow, 4);
   if tTreesx.sum_dop[1]<>0    then MyxlSetCellNumberValue(TochSum(tTreesx.sum_dop[1]  ) ,wexrow, 5,wexrow, 5);
   if tTreesx.sum_dop[2]<>0    then MyxlSetCellNumberValue(TochSum(tTreesx.sum_dop[2]  ) ,wexrow, 6,wexrow, 6);
   if tTreesx.sum_dop[3]<>0    then MyxlSetCellNumberValue(TochSum(tTreesx.sum_dop[3]  ) ,wexrow, 7,wexrow, 7);
   if tTreesx.sum_dop[4]<>0    then MyxlSetCellNumberValue(TochSum(tTreesx.sum_dop[4]  ) ,wexrow, 8,wexrow, 8);
//   xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,17);                                                     
   if LevelString=1 then
   {
      inc(_NPP);
      xlSetFontStyle(xlBold ,wexrow,1,wexrow,8);
      //0DDDDDDh
      xlSetbackcolor(00DAE2EFh, wexrow,1,wexrow,8);
      //MyxlSetCellStringValue(_NPP         ,wexrow, 1,wexrow, 1);
   }
   else
   { //0FFCCCCh
     //R226, G239,B218 00E2EFDAh
     //переставляем цвета RBG 00E2DAEFh
     //переставляем цвета BRG 00DAE2EFh
     if _Level=1
     { xlSetbackcolor(00E2EFDAh, wexrow,1,wexrow,8);
     }
   }
   xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,8);
   Result:=true;

} //Function RecursionPrint09SP(_Name:string):boolean;


//===============================================
Function RecursionPrint9(cc:comp;_DKZ:Integer=-1;_Level:word=0):boolean;
var OO,OldLevS:word;
    CR:word;
{
 Result:=True; 
 If(BaseDocLevel <> 0)
 {
   If(BaseDocLevel = LevelString) //не печатаю фиктивный уровень
   { Exit; }
 }  
 PushPos(#ttreesx);
 CR:=0;
 OO:=LevelString;
 LevelString:=LevelString+1;
 _loop ttreesx where ((cc==ttreesx.cowner and (_DKZ=-1 or ttreesx.DKZ=_DKZ) ))
 { if not NextVisual
   { Result:=False;
     Break;
   }

   if cc<>0
   { inc(wexrow);inc(CR);
     RecursionPrint09SP(LPad('',LevelString)+ttreesx.name, _Level );
   }
   OldLevS:=LevelString;
   Result:=RecursionPrint9(ttreesx.nrec,_DKZ,_Level+1);
   if not Result break;
   LevelString:=OldLevS;
   if cc=0
   { inc(wexrow);inc(CR);
     RecursionPrint09SP('Итого',_Level );
     xlSetCellNumberValue(TochSum(tTreesx.summaR      ) ,6,2,6,2);
     xlSetCellNumberValue(TochSum(tTreesx.summa       ) ,6,3,6,3);
     xlSetCellNumberValue(TochSum(tTreesx.summaIn     ) ,6,4,6,4);
     xlSetCellNumberValue(TochSum(tTreesx.sum_dop[1]  ) ,6,5,6,5);
     xlSetCellNumberValue(TochSum(tTreesx.sum_dop[2]  ) ,6,6,6,6);
     xlSetCellNumberValue(TochSum(tTreesx.sum_dop[3]  ) ,6,7,6,7);
     xlSetCellNumberValue(TochSum(tTreesx.sum_dop[4]  ) ,6,8,6,8);
   }
 }
 PopPos(#ttreesx);

} //Function RecursionPrint9(cc:comp):boolean;



