cmFCExpandAll:
{
  var LastNode: comp = 0;

  TreePushPos(trCat09);
  
  if TreeGetLastEx(trCat09)
  { LastNode := TTreeD.NRec; }
  
  if TreeGetFirstEx(trCat09)
  {
    do
    {
      TreeOpenNode(trCat09);
      TreeGetNextEx(trCat09);
    }
    while (TTreeD.NRec <> LastNode)
  }  
  
  TreePopPos(trCat09);

  ReReadRecord(#TTreeD);
