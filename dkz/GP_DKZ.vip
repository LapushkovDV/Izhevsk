HandleEvent
CmInit:
{
//  timelog_init;

  TimeLog_File:=GetStringParameter('Files','OutputFilesDirectory',0)
                               +'!TimeLog.log';

  if FileExist(TimeLog_File)
       DeleteFile(TimeLog_File);

  timelog('GP_DKZ->cmInit:Start');
  if (getfirst katkau where ((Root == katkau.nrec and (DKZ_D=upcase(KatKau.code)))) = tsok)
              then wDKZ_D:=katkau.kodgroup;
              else message(''#13#3'Не найдена аналитика "ДКЗ_Д" - "Документы"!'#13#3'Группировка может работать не корректно!',error);
  if getfirst katkau where ((Root == katkau.nrec and (DKZ_Sch=upcase(KatKau.code)))) = tsok
              then wDKZ_Sch:=katkau.kodgroup; else
              message(''#13#3'Не найдена аналитика "ДКЗ_СЧЕТ" - "Счета"!'#13#3'Группировка может работать не корректно!',error);
  if getfirst katkau where ((Root == katkau.nrec and (DKZ_SubSch=upcase(KatKau.code))))= tsok
              then wDKZ_SubSch:=katkau.kodgroup;
              else message(''#13#3'Не найдена аналитика "ДКЗ_СУБСЧЕТ" - "Субсчета"!'#13#3'Группировка может работать не корректно!',error);
  if getfirst katkau where ((Root == katkau.nrec and (DKZ_SchSubSch=upcase(KatKau.code))))= tsok
              then wDKZ_SchSubSch:=katkau.kodgroup;
              else message(''#13#3'Не найдена аналитика "ДКЗ_СЧЕТСУБСЧЕТ" - "Счета и Субсчета"!'#13#3'Группировка может работать не корректно!',error);
  if getfirst katkau where ((Root == katkau.nrec and (DKZ_OrgSchSubSch=upcase(KatKau.code))))= tsok
              then wDKZ_OrgSchSubSch:=katkau.kodgroup;
              else message(''#13#3'Не найдена аналитика "ДКЗ_ОРГСЧЕТСУБСЧЕТ" - "Организации, Счета и Субсчета"!'#13#3'Группировка может работать не корректно!',error);
  if getfirst katkau where ((Root == katkau.nrec and (upcase(DKZ_VIDV)=upcase(KatKau.code))))= tsok
              then wDKZ_vidv:=katkau.kodgroup;
              else message(''#13#3'Не найдена аналитика "ЭМ_Виды взаиморасчет"!'#13#3'Группировка может работать не корректно!',error);
  MarkK:='KatOrg';
  MarkD:='Gt_cgKau_' + LPadCh(string(cgKau_Dogovor),'0',6) + '_Mrk';
  MarkC:='Gt_cgKau_' + LPadCh(string(cgKau_fpco   ),'0',6) + '_Mrk';
  MarkV:='Gt_cgKau_' + LPadCh(string(wDKZ_vidv    ),'0',6) + '_Mrk';
  MarkP:='Gt_cgKau_' + LPadCh(string(cgKau_KatPodr),'0',6) + '_Mrk';
  _log('MarkString = '+MarkD+' '+MarkC+' '+MarkV+' '+MarkP);
  cfsGetObjInfo(cfsGetCurrentContainerSelf,'', lEntity, 0, 0);
  wReport:=cgRepBuh_GPREP;
  cReport:=0;
  wMode:=cgiPick or cgiNotClear;
  CurDescr   := sGetTune('User.Descr');
  CurDesGr   := sGetTune('User.DesGr');
   
  ReadMyDSK(cReport,'GP_DKZ_cReport',true);
  If(cReport = 0)
  {cReport := iBuhRep.GetDefaultNastr(wReport, VipParams.cPlansSch);}    
  set cReport;
    
  if (not InitWithParam(wReport, cReport, wMode)) { abort; exit; }
  //--------------------------
  timelog('GP_DKZ->cmInit:Finish: cReport='+String(cReport,0,0));
!  Result := true;
}

//---------------------
cmDone :
{
  DlgToRecord;

  FreeVipInterface(iBuhRep);
}



//---------------------
cmValue1 : // Применить
{
  if not CheckParameters
  {
    exit;
  }

  DlgToRecord;
  iPickBuhNew.MakePickBuh(lEntity);
  _log('PUSK cReport = '+cReport+'   VipParams.cJOrder='+VipParams.cJOrder );
  if (not iBuhRep.CheckParams(wReport,VipParams)) {
    iPickBuhNew.GetPickBuh(lEntity);
    abort;
    exit;
  }
  // настройка могла измениться - отобразим на экране
  RecordToDlg;

  QuerySaveNastr;

  iListRep.coSaveDskByName(cReport,
                           'BuRep_Last' + String(wReport) + ':' +
                             String(VipParams.cPlansSch));

  var cNastr : comp = iBuhRep.GetDefaultNastr(wReport, VipParams.cPlansSch);

  iBuhRep.SaveNastr(wReport, cNastr, VipParams);
  //Зачем каждый раз писать? - но почему то слетает
  SaveMarker(MarkK,'gp_m1');
  SaveMarker(MarkD,'gp_m2');
  SaveMarker(MarkC,'gp_m3');
  SaveMarker(MarkV,'gp_m4');
  SaveMarker(MarkP,'gp_m5');
  //iBuhRep.ExecuteAndModify(wReport, cReport, cNastr);
  _log('VIPU cReport = '+cReport+'   VipParams.cJOrder='+VipParams.cJOrder );

  MakeReport;
  case ReportTip of
    9  : RunWindow(Report_Result09);
    else RunWindow(Report_Result);
  end  
  _log('VIPD cReport = '+cReport+'   VipParams.cJOrder='+VipParams.cJOrder );
  LoadNastr(wReport, cReport);
  _log('VIPL cReport = '+cReport+'   VipParams.cJOrder='+VipParams.cJOrder );
  
  SaveMyDSK(cReport,'GP_DKZ_cReport');
}

//---------------------
cmValue2 : {  // Очистить фильтр
  ClearFilter;
}

//---------------------
cmValue10 : { // сохранить
  DlgToRecord;
  iPickBuhNew.MakePickBuh(lEntity);
  iBuhRep.SaveNastr(wReport,cReport,VipParams);

  SaveMarker(MarkK,'gp_m1');
  SaveMarker(MarkD,'gp_m2');
  SaveMarker(MarkC,'gp_m3');
  SaveMarker(MarkV,'gp_m4');
  SaveMarker(MarkP,'gp_m5');
  iPickBuhNew.GetPickBuh(lEntity);


  SavedParams := VipParams;
}

//---------------------
cmValue11 : { // сохранить как

  stName := BuhRep.Name + ' (копия)';
  if (RunWindowModal(wSaveAs) = cmDefault) {
    ClearBuffer(#BuhRep);
    BuhRep.NRec   := 0;
    BuhRep.Descr  := CurDescr;
    BuhRep.DesGr  := CurDesGr;
    BuhRep.dtSave := _CurDateTime;
    BuhRep.wBuhRep:= wReport;
    BuhRep.Name   := stName;
    BuhRep.cPlansSch := VipParams.cPlansSch;
    insert current BuhRep;
    set cReport := BuhRep.NRec;
    iPickBuhNew.MakePickBuh(lEntity);
    iBuhRep.SaveNastr(wReport,cReport,VipParams);
    SaveMarker(MarkK,'gp_m1');
    SaveMarker(MarkD,'gp_m2');
    SaveMarker(MarkC,'gp_m3');
    SaveMarker(MarkV,'gp_m4');
    SaveMarker(MarkP,'gp_m5');
    iPickBuhNew.GetPickBuh(lEntity);
    SavedParams := VipParams;
    RereadRecord;
  }
}

//---------------------
cmValue12 : { // удалить
  if (BuhRep.Name = cgDefRepNastrName) {
    Message('Нельзя удалять настройку "по умолчанию"!');
    abort; exit;
  }
  if (Message('Удалить настройку "'+BuhRep.Name+'"?', YesNo) = Yes) {
    delete SpBuhRep where (( BuhRepEntity == wEntity and
                             BuhRep.NRec  == cEntity ));
    delete current BuhRep;
    cReport := iBuhRep.GetDefaultNastr(wReport, VipParams.cPlansSch);
    LoadNastr(wReport, cReport);
    set cReport := cReport;
  }
}

//---------------------
cmPick:
{
    case CurField of
    // выбор настройки
    #BuhRep.Name :
    {
      QuerySaveNastr;
      if (RunInterface('ListRep', wReport, cReport, cgiPick) = cmDefault)
      {
        ClearFilter;
        LoadNastr(wReport, cReport);
      }
    }

      // журнал-ордер
    #JornTune.Name : {

          if RunInterface('GP_DKZ_Tuned', VipParams.cJOrder) = cmCancel
            exit;
          RereadRecord(#JornTune);

    }

   #DlgPostPol :
    {
      var wMode: word;
      wMode := cgiPickMult or if (MarkerCount_K > 1, cgiNotClear, 0);
      DoneMarker(Marker_K,MarkK);
      if (iGetKau.GetCodeKau(wMode, cgKau_KatOrg, VipParams.cPostPol) = 0)        exit;
      Marker_K := InitMarker(MarkK, 8, 100, 10);
      MarkerCount_K:=GetMarkerCount(Marker_K);
      tC:=0;if MarkerCount_K = 1  set VipParams.cPostPol  := if(GetMarker(Marker_K,0,tc),tc,tc);
      DoneMarker(Marker_K,MarkK);
      //SaveMarker(MarkK,'gp_m1');
   }

   #DlgDogovor :
    {
      var wMode: word;
      wMode := cgiPickMult or if (MarkerCount_D > 1, cgiNotClear, 0);
       DoneMarker(Marker_D,MarkD);
      if (iGetKau.GetCodeKau(wMode, cgKau_Dogovor, VipParams.cFilKor) = 0)
        exit;
      Marker_D := InitMarker(MarkD, 8, 100, 10);
      MarkerCount_D:=GetMarkerCount(Marker_D);
      tC:=0;if MarkerCount_D = 1  set VipParams.cFilKor  := if(GetMarker(Marker_D,0,tc),tc,tc);
      DoneMarker(Marker_D,MarkD);
      //SaveMarker(MarkD,'gp_m2');

    }

  #DlgCO :
    {
      var wMode: word;
      wMode := cgiPickMult or if (MarkerCount_C > 1, cgiNotClear, 0);
       DoneMarker(Marker_C,MarkC);
      if (iGetKau.GetCodeKau(wMode, cgKau_fpco, VipParams.cDeltaVal) = 0)
        exit;
      Marker_C := InitMarker(MarkC, 8, 100, 10);
      MarkerCount_C:=GetMarkerCount(Marker_C);
      tC:=0;if MarkerCount_C = 1  set VipParams.cDeltaVal  := if(GetMarker(Marker_C,0,tc),tc,tc);
      DoneMarker(Marker_C,MarkC);
      //SaveMarker(MarkC,'gp_m3');

    }
  #DlgVidV :
    {
      var wMode: word;
      wMode := cgiPickMult or if (MarkerCount_V > 1, cgiNotClear, 0);
       DoneMarker(Marker_V,MarkV);
      if (iGetKau.GetCodeKau(wMode, wDKZ_VidV, VipParams.cCachBank) = 0)
        exit;
      Marker_V := InitMarker(MarkV, 8, 100, 10);
      MarkerCount_V:=GetMarkerCount(Marker_V);
      tC:=0;if MarkerCount_V = 1  set VipParams.cCachBank  := if(GetMarker(Marker_V,0,tc),tc,tc);
      DoneMarker(Marker_V,MarkV);
      //SaveMarker(MarkV,'gp_m4');

    }
  #DlgPodr :
    {
      var wMode: word;
      wMode := cgiPickMult or if (MarkerCount_P > 1, cgiNotClear, 0);
      DoneMarker(Marker_P,MarkP);
      if (iGetKau.GetCodeKau(wMode, cgKau_KatPodr, VipParams.cHozOper) = 0)
        exit;
      Marker_P := InitMarker(MarkP, 8, 100, 10);
      MarkerCount_P:=GetMarkerCount(Marker_P);
      tC:=0;if MarkerCount_P = 1  set VipParams.cHozOper  := if(GetMarker(Marker_P,0,tc),tc,tc);
      DoneMarker(Marker_P,MarkP);
      //SaveMarker(MarkC,'gp_m3');

    }
    end;
  // FieldStateHandler;
  RereadRecord;
}
//---------------------
cmDelOnProtect:
  {
   case CurField of
   #DlgPostPol:
    {
      set VipParams.cPostPol := 0;
      iPickBuhNew.DeleteItem(lEntity, cgPick_PostPol);
      Marker := InitMarker(MarkK, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkK);
      MarkerCount_K:=0;
      delete all spbuhrep where ((BuhRepEntity == SpBuhRep.wEntity and
                                      cReport  == SpBuhRep.cEntity and
                                      'gp_m1'  == SpBuhRep.STBL ));
    }
   #DlgDogovor:
    {
      set VipParams.cFilKor := 0;
      iPickBuhNew.DeleteItem(lEntity, cgPick_AtlBranch);
      Marker := InitMarker(MarkD, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkD);
      MarkerCount_D:=0;
      delete all spbuhrep where ((BuhRepEntity == SpBuhRep.wEntity and
                                      cReport  == SpBuhRep.cEntity and
                                      'gp_m2'  == SpBuhRep.STBL ));
    }
  #DlgCO:
    {
      set VipParams.cDeltaVal := 0;
      Marker := InitMarker(MarkC, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkC);
      MarkerCount_C:=0;
      delete all spbuhrep where ((BuhRepEntity == SpBuhRep.wEntity and
                                      cReport  == SpBuhRep.cEntity and
                                      'gp_m3'  == SpBuhRep.STBL ));
    }
  #DlgVidV:
    {
      set VipParams.cCachBank := 0;
      Marker := InitMarker(MarkV, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkV);
      MarkerCount_V:=0;
      delete all spbuhrep where ((BuhRepEntity == SpBuhRep.wEntity and
                                      cReport  == SpBuhRep.cEntity and
                                      'gp_m4'  == SpBuhRep.STBL ));
    }
  #DlgPodr:
    {
      set VipParams.cHozOper := 0;
      Marker := InitMarker(MarkP, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkP);
      MarkerCount_P:=0;
      delete all spbuhrep where ((BuhRepEntity == SpBuhRep.wEntity and
                                      cReport  == SpBuhRep.cEntity and
                                      'gp_m5'  == SpBuhRep.STBL ));
    }
   end;

    RereadRecord;

  }


//---------------------
cmPlansNo : {      // перейти на другой план счетов
  GetMyPlansNo;
  SetMainWindowTitle;
}
cmHotKeys:
{
  //#3835_EM-31  пользователь захотел иметь возможность менять текущий план счетов
  PutHotCommand(RunDynMenu('GP_BU::mnDKZ_HotKeysMain'));
}
