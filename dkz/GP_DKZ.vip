//*****************************************
create view
//*****************************************
var
  cReport:comp;
  cDKZ_Dogovor:comp;
  cDKZ_KatOrg:comp;
  cDKZ_VidV:comp;
  cDKZ_KatPodr:comp;
  cDKZ_CO:comp;
  sDKZ_CO:string;

select
 if(MarkerCount_K = 0,'',
 if(MarkerCount_K = 1,  ShowKau(cgKau_KatOrg, VipParams.cPostPol), MultiStr + ' (' + String(MarkerCount_K) + ')' ))
  (FieldName = DlgPostPol),
//------------------------
 if(MarkerCount_D = 0,'',
 if(MarkerCount_D = 1,  ShowKau(cgKau_Dogovor, VipParams.cFilKor), MultiStr + ' (' + String(MarkerCount_D) + ')' ))
  (FieldName = DlgDogovor),
//------------------------
 if(MarkerCount_C = 0,'',
 if(MarkerCount_C = 1,  ShowKau(cgKau_fpCO, VipParams.cDeltaVal), MultiStr + ' (' + String(MarkerCount_C) + ')' ))
  (FieldName = DlgCO),
//------------------------
 if(MarkerCount_V = 0,'',
 if(MarkerCount_V = 1,  ShowKau(wDKZ_vidv, VipParams.cCachBank), MultiStr + ' (' + String(MarkerCount_V) + ')' ))
  (FieldName = DlgVidV),
//------------------------
 if(MarkerCount_P = 0,'',
 if(MarkerCount_P = 1,  ShowKau(cgKau_KatPodr, VipParams.cHozOper), MultiStr + ' (' + String(MarkerCount_P) + ')' ))
  (FieldName = DlgPodr)
// ,*
from
   buhrep,spbuhrep,jorntune
  ,tOborot(tOborot03)
  ,tTreeS ttreed
  ,tTreeS ttreek
  ,tTrees ttreesT
  ,tTrees ttreesX
  ,tTrees ttreesX1
  ,memnastr, memnastr memiskl,spjorn, spjorn spjornX
  ,toborot toborot1,toborot toborot2,toborot toborot3
  ,toborot toborot4,toborot toborot5, toborot tOborot10
  , oborot
  , katdoc
  , ttrees
  //=========================
  ,buhschet,saldmoun ,katkau
  //=========================
  ,tmp_saldo, tmp_KatSopr(tmp_KatSopr01)
  ,Dogovor
  ,BaseDoc
  ,VedDeponir
  ,KatSopr
  ,Veksl
  ,KatKlass
  ,KatOrg
  ,KatOrgDescr, KatOrgDescr KatOrgDescr2
  ,tRep11
  ,tRep12
  ,EM_UniDoc_Spec
where
((
      cReport               == BuhRep.Nrec
  AND VipParams.cJOrder     ==  JornTune.NRec
  and JornTune.Nrec     ==  SpJorn.cJornTune
  and 0  == tTreeD.dkz
  and  curOwnerD == tTreeD.cowner
  and  1  == tTreeK.dkz
  and  curOwnerK == tTreeK.cowner
  and Veksl.cVidVeks == KatKlass.NRec
))
     bounds bn_S1          = _SCHETO  == saldmoun.SCHETO and BD >>= saldmoun.DATESAL
     bounds bn_SSUB1       = _SCHETO  == saldmoun.SCHETO and _SCHETOSUB == saldmoun.SUBOSSCH and BD >>= saldmoun.DATESAL Ordered By saldmoun.DATESAL

     bounds bn_S2          = _SCHETO  == saldmoun.SCHETO and BD == saldmoun.DATESAL Ordered By saldmoun.DATESAL
     bounds bn_SSUB2       = _SCHETO  == saldmoun.SCHETO and _SCHETOSUB == saldmoun.SUBOSSCH and BD == saldmoun.DATESAL Ordered By saldmoun.DATESAL
     
     bounds bn_OK          = _SCHETO  == Oborot.SCHETO and _SCHETK   == Oborot.SCHETK  and BegDateB <<=Oborot.Datob and EndDateB >>= Oborot.DatOb Ordered By Oborot.DatOb
     bounds bn_O           = _SCHETO  == Oborot.SCHETO and BegDateB <<=Oborot.Datob and EndDateB >>= Oborot.DatOb Ordered By Oborot.DatOb
     bounds bn_K           = _SCHETK  == Oborot.SCHETK and BegDateB <<=Oborot.Datob and EndDateB >>= Oborot.DatOb Ordered By Oborot.DatOb
     bounds bn_OSUB        = _SCHETO  == Oborot.SCHETO and _SCHETOSUB  == Oborot.SUBOSSCH and BegDateB <<=Oborot.Datob and EndDateB >>= Oborot.DatOb Ordered By Oborot.DatOb
     bounds bn_KSUB        = _SCHETK  == Oborot.SCHETK and _SCHETKSUB  == Oborot.SUBSCHK  and BegDateB <<=Oborot.Datob and EndDateB >>= Oborot.DatOb Ordered By Oborot.DatOb
     
     Condition ByEnabledSaldoKAU1 = EnabledSaldoKAU(1) 
     Condition ByEnabledSaldoKAU2 = EnabledSaldoKAU(2)
     Condition ByEnabledSaldoKAU3 = EnabledSaldoKAU(3)
     Condition ByEnabledSaldoKAU4 = EnabledSaldoKAU(4)
     Condition ByEnabledSaldoKAU5 = EnabledSaldoKAU(5)
     Condition ByEnabledSaldoKAU6 = EnabledSaldoKAU(6)     
;
//=======================================
Create view vKatSopr
var
  pKatSopr:comp;
as select KatSopr.Nrec
From KatSopr
where
(( pKatSopr == KatSopr.Nrec
));

//=======================================
Create view vOborotX
var
  pr:string;
  cK,cD:comp;
as select KatSoprX.Nrec
From
    oborot oborotx
  , katb
  , KatSopr KatSoprX

where
((
        pr+'008' == oborotX.SCHETO
    and '02'     == oborotX.SUBOSSCH
    and (    cK    = oborotX.kauos[1]
         and cD    = oborotX.kauos[2]
        )
    and oborotX.KAUOS[4] == KATB.nrec
    and oborotX.KAUOS[3] == katsoprX.czakaz
 ));

//=======================================
Create view vPlPor
var
  pPlPor:comp;
as select PlPor.Nrec
From
    plpor,basefin, CalPlan CalPlan_Fin, CalPlan CalPlan_Tov  
  , PlanPays PlanPaysAvan
  , PlanPays PlanPaysAdd
where
((    pPlPor           == plpor.nrec
  and plpor.nrec       == basefin.cplpor
  and BaseFin.cKatSopr == CalPlan_Fin.Nrec
  and BaseFin.cCalPlan == CalPlan_Tov.Nrec
  and CalPlan_Fin.Nrec == PlanPaysAvan.cCalPlan    // Авансовые платежи по пункту плана
  and word(1)          == PlanPaysAvan.VidPlat     // --/--
  AND CalPlan_Fin.nRec == PlanPaysAdd.cCalPlan     // Дополнительные платежи по пункту плана
  AND word(2)          == PlanPaysAdd.VidPlat      // --/-

));

//=======================================
Create view vBookPrZk
var
  pBookPrZk : comp;
as select 
  BookPrZk.Nrec
From
 BookPrZk
,UsersDoc  
where
((    
    pBookPrZk        == BookPrZk.nrec
And BookPrZk.TipUser == UsersDoc.TipUsers
));

//=======================================
Create view vVedDeponir
var
  pVedDeponir : comp;
as select 
  VedDeponir.Nrec
From
 VedDeponir
where
((    
    pVedDeponir      == VedDeponir.nrec
));

//=======================================
Create view vSoprHoz
var
  wtidkgal :word;
  pSoprDoc :comp;
as select SoprHoz.tidkgal
From SoprHoz
where ((
 wtidkgal == SoprHoz.tidkgal and pSoprdoc == SoprHoz.csoprdoc
)) ;
//=======================================
Create view vSpr
var
  pDogovor_F:comp;
  pCalplan  :comp;
  pSpKau    :comp;
  pKlVal    :comp;
  pFPSTBUD  :comp;
  pKatOrg   :comp;
as select Dogovor.Nrec
From
   Dogovor
  ,CalPlan
  ,CalPlan CalPlan_F
  ,FPCO     KatPodrOtv
  ,KatPodr    KuratPodr
  ,SpKau
  ,KlVal
  ,FPSTBUD
  ,persons menotv
where ((
      pDogovor_F == Dogovor.Nrec
  and pCalPlan == CalPlan.Nrec
   //схема платежей по товарным
  and CalPlan.Nrec       == PaySchem.cMCPlan
  and PaySchem.cPlanPays == PlanPays.nRec
  and PlanPays.cCalPlan  == CalPlan_F.Nrec
  //-------------
  and pDogovor_F       == AttrDog.cDogovor
  and AttrDog.cPodr    == KatPodrOtv.nRec
  and AttrDog.COTV_MY  == MenOtv.nrec
  and Dogovor.cCurPodr == KuratPodr.nRec
  //-------------------------
  and pSpKau == SpKau.Nrec
  and pKlVal == KlVal.Nrec
  and pFPSTBUD == FPSTBUD.Nrec
  //--------------------
  and pKatOrg == KatOrg.Nrec
));//Create view vSpr


create view vOtg
var
  CurSoprDoc : comp;
as select
  Katsopr.nrec
from
 Katsopr
,SpSopr
,SpSophoz
,SoprHoz
,plpor
where
((
    CurSoprDoc        == KatSopr.Nrec 
And CurSoprDoc        == SpSopr.cSopr 
And spsopr.nrec       == spsophoz.cspsopr
And spsophoz.csoprhoz == soprhoz.nrec 
And soprhoz.csoprdoc  == plpor.nrec
));//create view vOtg

create view vOpl
var
  CurSoprDoc : comp;
as select
 plpor.nrec
from
 Katsopr
,SpSopr
,SpSophoz
,SoprHoz
,plpor
where
((
    CurSoprDoc       == plpor.nrec
And PlPor.tidkGal    == SoprHoz.tidkGal  
And plpor.nrec       == soprhoz.csoprdoc
And soprhoz.nrec     == spsophoz.csoprhoz
And spsophoz.cspsopr == spsopr.nrec 
And SpSopr.cSopr     == KatSopr.Nrec
));//create view vOpl

Create View vOrg
var
  CurKatOrg : comp;
as select
  KatOrgDescr.nrec
from
  KatOrgDescr
 ,Synonym KatOrgDescr ORKKGroup  
Where
((
    1                   == KatOrgDescr.code  
And CurKatOrg           == KatOrgDescr.crec  
And KatOrgDescr.cGroup /== ORKKGroup.nRec
And '03.Группа ОРКК'    == ORKKGroup.name(NoIndex)
));


Procedure TimeLog( const wStr :string ) ;
{
  LogStrTofile(TimeLog_File,DateToStr(Cur_Date,'дата DD/MM/YYYY')+
                                   TimeToStr(Cur_Time,' тек.вр HH:MM:SS:SSS')+
                                   TimeToStr(sub_time(Cur_Time,TimeLog_Time),' - пред.этап =  HH:MM:SS:SSS')+
                                   ' '+wStr) ;

!  TimeLog_Time:=Cur_Time ;
}

