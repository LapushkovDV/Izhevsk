table struct tRep11 
(
  NRec: comp
, cOrg: comp
, cDog: comp
, cCO: comp
, sOrg: string
, sDog: string
, sSchet: string
, sPerson: string
, sPodr: string
, sCO: string
, doDeb: double
, doKred: double
)
(i1 = NRec(unique, surrogate), i2 = cOrg + cDog + cCO + sSchet, i3 = sOrg + sDog + sCO);

table struct tRep12 
(
  NRec: comp
, wType: word
, cOrg: comp
, cDog: comp
, sGrOrg: string
, sOrg: string
, sDog: string
, dDebt: date
, dExpiried: date
, sSchet: string
, doDebt: double
, doExpiried: double
, sIGK: string
, sVidVz: string
, sVidOp: string
)
(i1 = NRec(unique, surrogate), i2 = wType + cOrg + cDog + sSchet, i3 = wType + sOrg + sDog + sSchet);

table STRUCT tOborot                 //Для хранения результатов
(
   NRec      :comp
  ,Name      :string
  ,Sort      :string
  ,gr        :array[1..6] of string
  ,cgr       :array[1..6] of string//EM-108 изменил тип с Comp на String, т.к. добавлена группировка Контрагент+счет,субсчет и надо хрнить 2 nrec (контрагента и счета)
  ,wgr       :array[1..6] of word
  ,cOwner    :comp
  ,d         :date
  ,sch          :string[50]
  ,subsch       :string[50]
  ,schk         :string[50]
  ,subschk      :string[50]
  ,TBLOS       :array[1..7] of word
  ,kauos       :array[1..7] of comp
  ,TBLKS       :array[1..7] of word
  ,kauks       :array[1..7] of comp
  ,summa :double
  ,cSoprDoc :comp
  ,tidkgal  :word
  ,tidkUser :word
  ,DateProsrT: date
  ,DateProsrO: date
  ,MinD:date
  ,MaxD:date
  ,dVoznPr   :date
  ,day_Prosr :longint
  ,cPodr:comp
  ,cMen:comp
  ,cDDS:comp
  ,cCO:comp
  ,sPodr:string
  ,sMen:string
  ,sDDS:string
  ,sCO:string[100]
  ,istek_summa:double
  ,sum_prosr       :array[1..10] of double
  ,summaR   :double "Резерв на начало периода"
  ,summaIn  :double "Встречные обязательства"
  ,sum_dop         :array[1..10] of double
  ,schet:string[20]
  ,Kontr:string
  ,Inn:string[30]
  ,Nazna:string
  ,dname:string[100]
  ,dnum:string[100]
  ,dsopr:date
  ,dkz:word
  ,wOb:word
  ,ogrn:string
  ,tGroup:word
  ,ob:string
  ,cOrg     :comp "Организация"
  ,cdog    :comp
  ,cDogKAU :comp
  ,cDOKAU  :comp
  ,dDogKau :Date
  ,dDOKau  :Date
  ,sdog:string
  ,tip :word "Тип настройки"
  ,cTreeNode  : array[0..6] of Comp
  ,sumDoc  : Double
  ,sumOtg  : Double
  ,sumOpl  : Double
 )
with index
(
  tOborot01  = NRec (Unique,AutoInc),
  tOborot03  = dkz+gr[1]+gr[2]+gr[3]+gr[4]+gr[5]+gr[6],
  tOborot04  = dkz+cOwner,
  tOborot05  = MinD,
  tOborot032 = dkz+sch+subsch+cgr[1]+cgr[2]+cgr[3]+cgr[4]+cgr[5]+cgr[6],

  tOborot09  = dkz+cgr[1]+cgr[2]+cgr[3]+cgr[4]+cgr[5]+cgr[6],
  tOborot10  = dkz+tGroup+gr[1]+gr[2]+gr[3]+gr[4]+gr[5]+gr[6],
  tOborot11  = tip + cOrg + dVoznPr,
  tOborot12  = tip + cOrg + dDogKau + dDOKau,
  tOborot20  = cTreeNode[0]+DSopr,
  tOborot21  = cTreeNode[1]+DSopr,
  tOborot22  = cTreeNode[2]+DSopr,
  tOborot23  = cTreeNode[3]+DSopr,
  tOborot24  = cTreeNode[4]+DSopr,
  tOborot25  = cTreeNode[5]+DSopr,
  tOborot26  = cTreeNode[6]+DSopr
)
;
