//9. #3835 Акт инвентаризации по просроченной задолженности
//-----------------------------------------------------
procedure PR9;
{
  LevelString := 0;
  xlSetActiveSheet(1);
  wexrow:=7;_NPP:=0;
//по счету 62.01 по состоянию на 30.09.2018 с учетом встречных обязательств, в целях создания резерва по сомнительным долгам в Налоговом учете

  MyxlSetCellStringValue(JORNTUNE.NAME+' по состоянию '+' на '+datetostr(EndDate,'DD.MM.YYYY')+' с учетом встречных обязательств, в целях создания резерва по сомнительным долгам в Налоговом учете',4,1,4,1);
  MyxlSetCellStringValue('период '+datetostr(Sub_Day(EndDate, Kol_Days_Prosr),'DD.MM.YYYY')+' - '+datetostr(EndDate,'DD.MM.YYYY'),1,8,1,8);
  MyxlSetCellStringValue(
                            if(JornTune.TblOs[1] > 0,       GetAnalitikName(JornTune.TblOs[1]), '')
                          + if(JornTune.TblOs[2] > 0, ' / '+GetAnalitikName(JornTune.TblOs[2]), '')
