 if (sumTot[6] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[6]), wexrow, 15, wexrow, 15); }
 if (sumTot[7] <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[7]), wexrow, 16, wexrow, 16); }
 xlSetFontStyle(xlBold ,wexrow,1,wexrow,18);
 xlFrameCells(63, xlThin, 0, 0,wexrow,9,wexrow,18);
 xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,1);
 xlFrameCells(15, xlThin, 0, 0,wexrow,2,wexrow,8);
 
 xlSetActiveSheet(1);
} //procedure PR1;



//=====================================================
// 1 'Акт инвентаризации ИНВ-17'
//-----------------------------------------------------
Function RecursionPrint2(cc:comp):boolean;
{
 Var isPrintLvl : Boolean;
 
 PushPos(#ttreesx);
 Result:=True;
 _loop ttreesx where ((cc==ttreesx.cowner))
 { if not NextVisual
   { Result:=False;
     break;
   }
   isPrintLvl := True;
     
   //#EM-389 В акте инвентаризации в Excel нужно исключить группировку по контрагентам, и выводить суммы по счетам/субсчетам, указанным в настройке.  
   If (isPrintSubSch)
   {
     //по субчетам
     If(ttreesx.grLv <> wDKZ_SubSch And ttreesx.grLv <> wDKZ_SchSubSch)
     { isPrintLvl := False; }               
   }
   Else
   { 
     //по контрагентам
     If(ttreesx.grLv <> wDKZ_OrgSchSubSch And ttreesx.grLv <> cgKau_KatOrg And ttreesx.grLv <> cgKau_Persons)
     { isPrintLvl := False; }
   }  
     
   If isPrintLvl
   {
     inc(wexrow);inc(LevelString);   
     MyxlSetCellNumberValue(LevelString                                           ,wexrow, 2,wexrow, 2);
     MyxlSetCellStringValue(ttreesx.kontr                                         ,wexrow, 3,wexrow, 3);
     MyxlSetCellStringValue(Substr(ttreesx.schet,2,length(ttreesx.schet))         ,wexrow, 4,wexrow, 4);
     MyxlSetCellNumberValue(TochSum(tTreesx.summa)                                ,wexrow, 5,wexrow, 5);
     MyxlSetCellNumberValue(TochSum(tTreesx.summa)                                ,wexrow, 6,wexrow, 6);
     //  MyxlSetCellNumberValue(TochSum(tTreesx.summa)                                ,wexrow, 7,wexrow, 7);
     if Round(tTreesx.istek_summa,3)<>0 then
       MyxlSetCellNumberValue(TochSum(tTreesx.istek_summa)                        ,wexrow, 8,wexrow, 8);
     xlFrameCells(63, xlThin, 0, 0,wexrow,2,wexrow,8);
   }    
   Result:=RecursionPrint2(ttreesx.nrec);  
   if not Result break;
 }
 PopPos(#ttreesx);

}//Function RecursionPrint2(cc:comp):boolean;

//=====================================================
// 1 'Акт инвентаризации ИНВ-17'
//-----------------------------------------------------
procedure PR2;
{
 //#EM-389 Выводить в Excel группировку счет/субсче
 IsPrintSubSch := ExistGrLevelSubSch();

 xlSetActiveSheet(1);
 wexrow:=27;
 MyxlSetCellStringValue(datetostr(EndDate, 'DD.MM.YYYY'),14,4,14,4);
 if getfirst ttreesx where ((0 == ttreesx.dkz and 0 == ttreesx.cowner))=tsok
  then
   {
//16 инвентаризации расчетов с покупателями, поставщиками и прочими дебиторами / кредиторами
//17   MyxlSetCellStringValue('по счетам учёта: '+ttreesx.name,17,2,17,2);
   MyxlSetCellStringValue(getSchet_subschetDeb(),16,3,16,3);
   LevelString:=0;
   //====================================
   wexrow:=24;
   HeaderStrCount:=wexrow;
   MaxColCount:=8;
   wexrow++;
   MyXlCreaMatrix(1000,MaxColCount);
   wexrow--;
   //====================================
   RecursionPrint2(ttreesx.nrec);
   //====================================
   MyxlWriteMatrix(wexrow);
   xlFreeMatrix;
   matrixkl:=False;
   //====================================
   inc(wexrow);
   MyxlSetCellStringValue('ИТОГО:',wexrow,3,wexrow,3);
   MyxlSetCellNumberValue(TochSum(tTreesx.summa)                                ,wexrow, 5,wexrow, 5);
   MyxlSetCellNumberValue(TochSum(tTreesx.summa)                                ,wexrow, 6,wexrow, 6);
 //  MyxlSetCellNumberValue(TochSum(tTreesx.summa)                                ,wexrow, 7,wexrow, 7);
  if Round(tTreesx.istek_summa,3)<>0 then
   MyxlSetCellNumberValue(TochSum(tTreesx.istek_summa)                          ,wexrow, 8,wexrow, 8);
   xlSetFontStyle(xlBold ,wexrow,1,wexrow,8);
  }

 xlSetActiveSheet(2);
 wexrow:=37;
 if getfirst ttreesx where ((1 == ttreesx.dkz and 0 == ttreesx.cowner))=tsok
  then
   {
   LevelString:=0;
   //====================================
   HeaderStrCount:=wexrow;
   MaxColCount:=8;
   wexrow++;
   MyXlCreaMatrix(1000,MaxColCount);
   wexrow--;
   //====================================
   RecursionPrint2(ttreesx.nrec);
   //====================================
   MyxlWriteMatrix(wexrow);
   xlFreeMatrix;
   matrixkl:=False;
   //====================================
   inc(wexrow);
   MyxlSetCellStringValue('ИТОГО:',wexrow,3,wexrow,3);
   MyxlSetCellNumberValue(TochSum(tTreesx.summa)                                ,wexrow, 5,wexrow, 5);
   MyxlSetCellNumberValue(TochSum(tTreesx.summa)                                ,wexrow, 6,wexrow, 6);
 //  MyxlSetCellNumberValue(TochSum(tTreesx.summa)                                ,wexrow, 7,wexrow, 7);
  if Round(tTreesx.istek_summa,3)<>0 then
   MyxlSetCellNumberValue(TochSum(tTreesx.istek_summa)                          ,wexrow, 8,wexrow, 8);
   xlSetFontStyle(xlBold ,wexrow,1,wexrow,8);

   //#EM-289 Добавлены подписи на вкладку кредиторской задолженности    
   inc(wexrow);
   //Подписи: суммы печатаются после подписей, а затем перемещаю подписи вниз - после сумм
   xlCopyToBuff(9, 1, 9+28, MaxExcelCol);
   xlPasteAllFromBuff(wexrow, 1, wexrow+28, MaxExcelCol);
   xlDeleteRange(xlShiftUp, 9, 1, 9+28, MaxExcelCol);
   //снять выделение со скопированной области
   xlCopyToBuff(2, 2, 2, 2);
   xlPasteAllFromBuff(2, 2, 2, 2);
  }  
  xlSetActiveSheet(1);

} //procedure PR2;

