  cmValue11,[SingleLine];
  cmValue12,[SingleLine];
<<
 `Настройка`         <.Сохранить    .><.Сохранить как.><.Удалить      .>
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end; // screen scNastr

Screen scRepBuh_DKZ('',hcBankOknoAktSverki,sci13EnEsc);
show at (,4,,20);
fields
  'Параметры отчета' : Skip, Centered,{Font = {Bold = true; Color = ColorSysWhite; BackColor = ColorSysGray}};
  JornTune.Name ('Настройка ДКЗ') : Protect,{Font = {BackColor = if (VipParams.cJOrder = 0, ColorNeed, 0)}};
  ReportTip  ('Форма отчета'): [List 0 'Дебиторская/Кредиторская задолженность(Крупные суммы)'
                                    ,1 'Акт инвентаризации ИНВ-17'
                                    ,2 'Справка к акту инвентаризации ИНВ-17'
                                //  ,3 'Дебиторская и кредиторская задолженность контрагентов свыше 3-х лет'
                                    ,4 'Дебиторская и кредиторская задолженность контрагентов свыше 3-х лет' // 'Дебиторская и кредиторская задолженность с истекшим сроком исковой давности'
                                    ,5 'Справка-расчёт по составу сомнительной задолженности'
                                    ,6 'Дебиторская и кредиторская задолженность'
                                    ,7 'Отчет по всей дебиторской/кредиторской задолженности'
                                    ,8 'Отчет по ДКЗ с просроченным сроком исковой давности'
                                    ,9 'Акт инвентаризации по просроченной задолженности'
                                    ,11 'Сведения о дебиторской и кредиторской задолженности на дату формирования'
                                    ,12 'К паспорту предприятия. Деб./Кред. задолженность на дату'
                             ], Protect;
  BegDate   ('За период c')  : ['DD/MM/YYYY'], NoProtect,{Font = {Bold = true; Color = if (BegDate > EndDate, ColorNotOk, 0); BackColor = if (Longint(BegDate) = 0, ColorNeed, 0)}};
  EndDate   ('За период по') : ['DD/MM/YYYY'], NoProtect,{Font = {Bold = true; BackColor = if (Longint(EndDate) = 0, ColorNeed, 0)}};
  DlgOndate ('Формировать на дату') : NoProtect;

  DlgPostPol ('Организация')           : Protect, PickButton;
  DlgDogovor ('Договор')               : Protect, PickButton;
  DlgCO      ('ЦФО')                   : Protect, PickButton;
  DlgVidV    ('Виды взаиморасчетов')   : Protect, PickButton;
  DlgPodr    ('Подразделение - аналитика оборотов')   : Protect, PickButton;

  DlgUslT    ('Фильтр по сумме')       : [List 'Без фильтра'
                             ,'>='
                             ,'<='
                             ,'Между'], Protect;
  DlgUsl1 :[15.2],NoProtect;
  DlgUsl2 :[15.2],NoProtect;
  DlgUslM    ('Срок иск. давности - мес.'): NoProtect, SpinButton[1,0,180];
  Kol_Days_Prosr ('Срок для учета просроченной задолженности, дней',,sci1EnEsc) : NoProtect;
  DlgUsl_chk ('Дата возникновения задолженности по дате хозоперации') : NoProtect;
<<
.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Настройка ДКЗ       `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Форма отчета        `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`За период`       &с  .@@@@@@@@@@@ `по`.@@@@@@@@@@@  [.] Формировать на дату`

 Фильтры:
