//=====================================================
// 5 'Справка-расчёт по составу сомнительной задолженности'
//-----------------------------------------------------
procedure Print6;
{
   inc(wexrow);inc(LevelString);
   MyxlSetCellNumberValue(LevelString                                           ,wexrow, 1,wexrow, 1);
   MyxlSetCellStringValue(toborot.Kontr                                         ,wexrow, 2,wexrow, 2);
   MyxlSetCellStringValue(toborot.inn                                           ,wexrow, 3,wexrow, 3);
   MyxlSetCellStringValue(toborot.ogrn                                          ,wexrow, 4,wexrow, 4);
   MyxlSetCellNumberValue(TochSum(toborot.summa)                                ,wexrow, 5,wexrow, 5);
   if toborot.mind <>Zerodate then
     MyxlSetCellStringValue(datetostr(toborot.mind ,'DD.MM.YYYY')                 ,wexrow, 6,wexrow, 6);
   if toborot.istek_summa<>0 then
     MyxlSetCellNumberValue(TochSum(toborot.istek_summa)                          ,wexrow, 8,wexrow, 8);
   if toborot.day_prosr<>0 then
     MyxlSetCellNumberValue(toborot.day_prosr                                     ,wexrow, 9,wexrow, 9);
   MyxlSetCellStringValue(GetObStr(tOborot.sdog,tOborot.corg)                                           ,wexrow,10,wexrow,10);
   xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,11);
   itog1:=itog1+toborot.summa;
   itog2:=itog2+toborot.istek_summa;
} //procedure Print6;

