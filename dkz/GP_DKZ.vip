 if itog5<>0 then MyxlSetCellNumberValue(TochSum(itog5)                                ,9,13,9,13);
 if itog6<>0 then MyxlSetCellNumberValue(TochSum(itog6)                                ,9,14,9,14);
 xlSetFontStyle(xlBold ,9,1,9,17);

 xlSetActiveSheet(2);

 wexrow:=9;
 LevelString:=0;
 MyxlSetCellStringValue(ts1,1,1,1,1);
 MyxlSetCellStringValue('Исполнение',9,1,9,1);
 MyxlSetCellStringValue('Кредиторская',9,4,9,4);
 xlSetFontStyle(xlBold ,9,1,9,17);
 xlFrameCells(63, xlThin, 0, 0,9,1,9,18);
 itog1:=0;
 itog2:=0;
 itog3:=0;
 itog4:=0;
 itog5:=0;
 itog6:=0;
 wexrow:=9;
 //====================================
 HeaderStrCount:=wexrow;
 wexrow++;
 MaxColCount:=18;
 MyXlCreaMatrix(1000,MaxColCount);
 wexrow--;
 //====================================

 _lOOp tOborot where ((1 == toborot.dkz)) ordered by toborot.gr[1]
 { if not NextVisual then exit;
   if tip=2 then
   {
     if toborot.sum_prosr[7]=0 then continue;
   }
   LOOP_PR7;
   
 }
 //====================================
 MyxlWriteMatrix(wexrow);
 xlFreeMatrix;
 matrixkl:=False;
 //====================================
 inc(wexrow);
 if itog1<>0 then MyxlSetCellNumberValue(TochSum(itog1)                                ,9, 9,9, 9);
 if itog2<>0 then MyxlSetCellNumberValue(TochSum(itog2)                                ,9,10,9,10);
 if itog3<>0 then MyxlSetCellNumberValue(TochSum(itog3)                                ,9,11,9,11);
 if itog4<>0 then MyxlSetCellNumberValue(TochSum(itog4)                                ,9,12,9,12);
 if itog5<>0 then MyxlSetCellNumberValue(TochSum(itog5)                                ,9,13,9,13);
