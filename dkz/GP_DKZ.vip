//
//--------------------------------
Procedure LoadGP;
{ LoadMarker(MarkK,'gp_m1');
  LoadMarker(MarkD,'gp_m2');
  LoadMarker(MarkC,'gp_m3');
  LoadMarker(MarkV,'gp_m4');
  LoadMarker(MarkP,'gp_m5');
  RereadRecord;
} //Procedure LoadGP;

//================================
//
//--------------------------------
procedure SetDefParams(var VipParams: TVipReportParams; wRep: word);
{
  #__UNUSED__(wRep)
      VipParams.TipVed := 1;  // оборотно-сальдовая
      VipParams.wKauOs[1] := cgKau_KatOrg;
      VipParams.wKauOs[2] := cgKau_Dogovor;
      VipParams.wKauOs[3] := cgKau_BaseDoc;
      VipParams.wVidOtch  := 0;
      VipParams.cPostPol  := 0;
      VipParams.cFilKor  := 0;
      VipParams.cDeltaVal  := 0;
      VipParams.cCachBank  := 0;
      VipParams.cHozOper  := 0;
      VipParams.SumMode   := 0;
      VipParams.MinSum    := 0;
      VipParams.MaxSum    := 0;
      VipParams.PageNum   := 1;
      VipParams.PageCount     := 0;
      VipParams.SaveRep := 36;

      set VipParams.BackMode := VipParams.BackMode and not 0040h;
      set VipParams.mKodSPO  := 0;
      set VipParams.KodSPO   := 0;
      iPickBuhNew.DeleteItem(lEntity, cgPick_PostPol);
      set VipParams.mKodSPK  := 0;
      set VipParams.KodSPK   := 0;
      iPickBuhNew.DeleteItem(lEntity, cgKau_Dogovor);
      iPickBuhNew.DeleteItem(lEntity, cgKau_Fpco);
      iPickBuhNew.DeleteItem(lEntity, wDKZ_vidv);
      iPickBuhNew.DeleteItem(lEntity, cgKau_KatPodr);
      //--------------------
      Marker := InitMarker(MarkK, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkK);
      //--------------------
      Marker := InitMarker(MarkD, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkD);
      //--------------------
      Marker := InitMarker(MarkC, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkC);
      //--------------------
      Marker := InitMarker(MarkV, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkV);
      //--------------------
      Marker := InitMarker(MarkP, 8, 100, 10);
      ClearMarker(Marker);
      DoneMarker(Marker, MarkP);
      //--------------------
      DeleteAllPicks;
} //procedure SetDefParams(var VipParams: TVipReportParams; wRep: word);



//================================
//
//--------------------------------
procedure LoadNastr(wReport: word; _cReport: comp);
{ cReport:=_cReport;
  timelog('LoadNastr: cReport:='+String(cReport,0,0));
  iPickBuhNew.DeletePickBuh(lEntity);
  //deleteallpicks;
  iBuhRep.LoadNastr(wReport, _cReport, VipParams);

  // новая настройка - заполним значения по умолчанию
  if (VipParams.cPlansSch = 0)
  {
    VipParams.cPlansSch := myPlansNo;
    if (wReport = cgRepBuh_AnDebts) or (wReport = cgRepBuh_CheckSaldoMon)
    {
      VipParams.BegDate := dGetTune('Dat_M_Ot');
      VipParams.EndDate := VipParams.BegDate;
    }
    else
    {
      VipParams.BegDate   := dGetTune('Dat_M_Ot');
      VipParams.EndDate   := Sub_Day(Add_Months(dGetTune('Dat_M_Ot'), 1), 1);
    }

    VipParams.ViOb      := 1;

    //установка параметров по умолчанию
    SetDefParams(VipParams, wReport);
    iPickBuhNew.MakePickBuh(lEntity);
    iBuhRep.SaveNastr(wReport, cReport, VipParams);
  }


  iPickBuhNew.GetPickBuh(lEntity);


  SavedParams := VipParams;
  RecordToDlg;
  LoadGP;
  SetAttrField(1,DlgOnDate);
  SetAttrField(2,DlgUslT);
  SetAttrField(3,ReportTip);
  RereadRecord(#BuhRep);
  RereadRecord;
} //procedure LoadNastr(wReport: word; cReport: comp);

procedure GetMyPlansNo;
{
  if (iPSManager.PickPlansSch(MyPlansNo))
  {
    ReadMyDSK(cReport,'GP_DKZ_cReport',true);
    If(cReport = 0)
    {cReport := iBuhRep.GetDefaultNastr(wReport, MyPlansNo);}    
    set cReport;
    LoadNastr(wReport, cReport);
  }
}


//================================
// Установка заголовка окна
//--------------------------------
procedure SetMainWindowTitle;
var Title : string;
{
  Title := 'Отчеты по ДКЗ' + ' (' + iPSManager.GetName(MyPlansNo) + ')';
  SetTitle(Title);
//  Event_SetTitle(Title);
}

//================================
// Инициализация параметров
//--------------------------------
function InitWithParam (_wReport: word; _cReport: comp; _wMode: word) : boolean;
{
  InitWithParam := true;

  if (not iPSManager.GetTunePlansSch(MyPlansNo))
  {
    InitWithParam := false;
    exit;
  }

  wReport := _wReport;
  cReport := _cReport;
  wMode   := _wMode;

  LoadNastr(wReport, cReport);

  RecordToDlg;
  SetMainWindowTitle;
  RereadRecord;
  PutCommand(cmCheckField);
} // InitWithParam

//================================
//
//--------------------------------
procedure QuerySaveNastr;
var
  NastrWasModified : boolean;
  NeedSave : boolean;
{
  NastrWasModified := ((SavedParams <> VipParams) );
  NeedSave := false;

  case wGetTune('FIN.REPORT.AUTOSAVE') of   // автосохранение настроек
    // да
    0: NeedSave := true;
    // по запросу
    1: if (NastrWasModified)
         if (Message('Настройка была изменена.'#13+
                     'Cохранить параметры?', YesNo) = cmYes)
           NeedSave := true;
  end; // case

  if (NeedSave)
  {
    iBuhRep.SaveNastr(wReport, cReport, VipParams);
    SavedParams := VipParams;
  }
}

//================================
//
//--------------------------------
procedure ClearFilter;
{
  var coTemp, coTemp2 : comp;
  var dTemp1, dTemp2  : date;

  coTemp  := VipParams.cPlansSch;     // сохранили
  dTemp1  := VipParams.BegDate;
  dTemp2  := VipParams.EndDate;
  coTemp2 := VipParams.cListGD;

  VipParams.cPlansSch := coTemp;      // восстановили
  VipParams.BegDate   := dTemp1;
  VipParams.EndDate   := dTemp2;
  VipParams.SumMode := 1;
  VipParams.cFeeSign := comp(0);
  VipParams.sFeeSign := '';
  VipParams.wVidOtch := word(0);

  iPickBuhNew.DeletePickBuh(lEntity);
  VipParams.cPostPol   := 0;
  VipParams.cFilKor    := 0;
  VipParams.cDeltaVal  := 0;
  VipParams.cCachBank  := 0;
  VipParams.cHozOper   := 0;
  VipParams.SaveRep    := 36;
  VipParams.PageNum    := 1;
  SetDefParams(VipParams, wReport);
  set VipParams.cJOrder := VipParams.cJOrder;
  set VipParams.cListGD := VipParams.cListGD;
  set VipParams.TiDk    := VipParams.TiDk;
} // procedure ClearFilter

//================================
//
//--------------------------------
function CheckParameters: boolean;
{
  result := false;

  if (not PackFields)
    exit;
 /*
  if (not CheckCalcPeriod(0,false)) {
    SelectField(#BegDate);
    Abort; Exit;
  }
  if (not CheckCalcPeriod(2,false)) {
    SelectField(#EndDate);
    abort; exit;
  }
 */
    if (VipParams.cJOrder = 0)
    {
       Message('Выберите настройку ДКЗ, пожалуйста', Error);
      SelectField(#JornTune.Name);
      exit;
    }



  result := true;
} //function CheckParameters: boolean;

//================================
// проверить фильтр по отбору
//--------------------------------
Function ChkFilterVal(_cRec:comp; _sTbl:string ):boolean; cacheable;
{ Result :=False;
  _Loop fullcache SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and
                                      cReport  == SpBuhRep.cEntity and
                             /*'gp_m1'*/_sTbl  == SpBuhRep.STBL    and
                         /*cDKZ_KatOrg*/ _cRec == SpBuhRep.crec
                                  ))
  { Result:=true;
    break;
  }

} //Function ChkFilterVal(_pKatOrg:comp; _sTabl:string ):boolean;

