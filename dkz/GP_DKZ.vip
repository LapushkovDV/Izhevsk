TableEvent table ttreeD;
cmTreeTop:  {    curOwnerD := 0;   }
cmTreeDown: {    curOwnerD := ttreeD.NRec; }
cmTreeUp:   {    curOwnerD := ttreeD.cOwner;}
cmTreeNeedOwner:
{  
  TreeJumpToRecord(trCat,   ttreeD.cOwner); // все родители до корня (NRec корня = 0)
  TreeJumpToRecord(trCat09, ttreeD.cOwner); // все родители до корня (NRec корня = 0)
}
cmTreeNodeType: 
{
  if (TreeIsTerminal(trCat)   or IsNew) TreeSetNodeType(trCat,   2);

  if (TreeIsTerminal(trCat09) or IsNew) 
  {  TreeSetNodeType(trCat09, 2); }
  else
  {
    If(BaseDocLevel > 0)  
    {
      if (TreeLevel(trCat09) = (BaseDocLevel - 1)) 
      { TreeSetNodeType(trCat09, 2); }
    }  
  }  
}         
end;

//**********************************************************
// События по таблицам
//**********************************************************
TableEvent table ttreeK;
cmTreeTop:  {    curOwnerK := 0;   }
cmTreeDown: {    curOwnerK := ttreeK.NRec; }
cmTreeUp:   {    curOwnerK := ttreeK.cOwner;}
cmTreeNeedOwner:
{
  TreeJumpToRecord(trCat2, ttreeK.cOwner); // все родители до корня (NRec корня = 0)
}
cmTreeNodeType: {if (TreeIsTerminal(trCat2) or IsNew) TreeSetNodeType(trCat2, 2);};
end;



//**********************************************************
// процедуры и функции 2
//**********************************************************

//====================================
// Центр ответственности
//------------------------------------
Function GetFpCoDog(_pDogovor:comp;var cc:comp;var ss:string):boolean;
{ Result:=false;
  if _pDogovor=0 then exit;
  vSpr.pDogovor_F:=_pDogovor;
  vSpr._Loop AttrDog
    vSpr._Loop KatPodrOtv
      {
        cc:=vSpr.KatPodrOtv.Nrec;
        ss:=vSpr.KatPodrOtv.Name;
        Result:=true;
      }
} //Function GetFpCoDog(_pDogovor):string;cacheable;//

//====================================
//Курирующее подразделение
//------------------------------------
Function GetMenDog(_pDogovor:comp;var cc:comp;var ss:string):boolean;
{ Result:=false;
  if _pDogovor=0 then exit;
  vSpr.pDogovor_F:=_pDogovor;
  vSpr._Loop AttrDog
    vSpr._Loop MenOtv
      {
        cc:=vSpr.MenOtv.Nrec;
        ss:=vSpr.MenOtv.FIO;
        Result:=true;
      }
} //Function GetMenDog(_pDogovor):string;cacheable;//

//====================================
//Курирующее подразделение
//------------------------------------
Function GetKurPodrDog(_pDogovor:comp;var cc:comp;var ss:string):boolean;
{ Result:=false;
  vSpr.pDogovor_F:=_pDogovor;
  vSpr._Loop Dogovor
    vSpr._Loop KuratPodr
    { var _sKod:string=vSpr.KuratPodr.Kod;
      var _id  :word  =pos('-',_sKod);
      //#919.#11.4.Курирующее подразделение - в начале наименования выводить код подразделения до символа <->.
      if _id>0 _sKod:=SubStr(_sKod,1,_id);
      cc:=vSpr.KuratPodr.Nrec;
      ss:=_sKod+' '+vSpr.KuratPodr.Name;
      Result:=true;
    }
} //Function GetKurPodrDog(_pDpgovor):string;cacheable;

//====================================
//Значение статьи бюджета
//------------------------------------
Function GetFPSTBUD(_pFPSTBUD:comp;var cc:comp;var ss:string):boolean;
{ Result:=false;
  if _pFPSTBUD=0 then exit;
  vSpr.pFPSTBUD:=_pFPSTBUD;
  vSpr._Loop FPSTBUD
      {
        cc:=vSpr.FPSTBUD.Nrec;
        ss:=trim(vSpr.FPSTBUD.Code)+' '+Trim(vSpr.FPSTBUD.Name);
        Result:=true;
      }
} //Function GetFPSTBUD(_pFPSTBUD:comp):string;cacheable;



//================================
//
//--------------------------------
procedure SetAttrField(tip:word;val:word);
{
/*
   i_SCREPBUH_DKZ_BEGDATE
   T_SCREPBUH_DKZ_с


   i_SCREPBUH_DKZ_DLGUSL1
   T_SCREPBUH_DKZ_от


   i_SCREPBUH_DKZ_DLGUSL2
   L_SCREPBUH_DKZ_до
*/
 case tip of
 1:
   {
     if val=0 then
       {
         cfsSetProp('i_SCREPBUH_DKZ_BEGDATE', cfpSkip, false);
         cfsSetProp('i_SCREPBUH_DKZ_BEGDATE', cfpVisible, true);
         cfsSetProp('T_SCREPBUH_DKZ_с', cfpSkip, false);
         cfsSetProp('T_SCREPBUH_DKZ_с', cfpVisible, true);
       }
       else
       {
         cfsSetProp('i_SCREPBUH_DKZ_BEGDATE', cfpSkip, true);
         cfsSetProp('i_SCREPBUH_DKZ_BEGDATE', cfpVisible, false);
         cfsSetProp('T_SCREPBUH_DKZ_с', cfpSkip, true);
         cfsSetProp('T_SCREPBUH_DKZ_с', cfpVisible, false);
         set BegDate:=EndDate;
       }

   }
 2:
   {
     if val=0 then
      {
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL2', cfpSkip, true);
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL2', cfpVisible, false);
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL1', cfpSkip, true);
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL1', cfpVisible, false);
         cfsSetProp('L_SCREPBUH_DKZ_до', cfpSkip, true);
         cfsSetProp('L_SCREPBUH_DKZ_до', cfpVisible, false);
         cfsSetProp('T_SCREPBUH_DKZ_от', cfpSkip, true);
         cfsSetProp('T_SCREPBUH_DKZ_от', cfpVisible, false);
      }

     if val=3 then
       {
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL2', cfpSkip, false);
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL2', cfpVisible, true);
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL1', cfpSkip, false);
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL1', cfpVisible, true);
         cfsSetProp('L_SCREPBUH_DKZ_до', cfpSkip, false);
         cfsSetProp('L_SCREPBUH_DKZ_до', cfpVisible, true);
         cfsSetProp('T_SCREPBUH_DKZ_от', cfpSkip, false);
         cfsSetProp('T_SCREPBUH_DKZ_от', cfpVisible, true);
       }
      if val=1 or Val=2
       {
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL2', cfpSkip, true);
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL2', cfpVisible, false);
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL1', cfpSkip, false);
         cfsSetProp('i_SCREPBUH_DKZ_DLGUSL1', cfpVisible, true);
         cfsSetProp('L_SCREPBUH_DKZ_до', cfpSkip, true);
         cfsSetProp('L_SCREPBUH_DKZ_до', cfpVisible, false);
         cfsSetProp('T_SCREPBUH_DKZ_от', cfpSkip, true);
         cfsSetProp('T_SCREPBUH_DKZ_от', cfpVisible, false);
       }
       SelectField(#DlgUslM);
       SelectField(#DlgUslT);
   }
  3:
  {
    //------------------------------
    // #3835 Для Акт инвентаризации по просроченной задолженности
    // Срок для учета просроченной задолженности
    var _boKol_Days_Prosr:boolean=false;
    case Val of //ReportTip of
    9:
    { _boKol_Days_Prosr:=true;
    }
    end;
    cfsSetProp('i_SCREPBUH_DKZ_Kol_Days_Prosr', cfpVisible, _boKol_Days_Prosr);
    cfsSetProp('L_SCREPBUH_DKZ_Срок_для_учета_просроченной_задолженности', cfpVisible, _boKol_Days_Prosr);
    cfsSetProp('L_SCREPBUH_DKZ_дней', cfpVisible, _boKol_Days_Prosr);

  }
  end;
} //procedure SetAttrField(tip:word;val:word);

//================================
//  Загрузка данных по сопроводительным документам
//--------------------------------
// надо сделать глобальными
var  dDateProsrT:date;
var  dDateProsrO:date;

//===========================
// Заполним параметры просрочки по накладным
Function FillKatsoprProsr(_pKatSopr:comp):boolean;
var
  _pCalPlan:comp;
  _NDays:longint;
  _dToPlanPays:Date=ZeroDate;
{ Result:=true;
  _NDays:=0;
  vKAtSopr.pKatSopr:=_pKatSopr;
  if vKAtSopr.getfirst katsopr=tsok  then //where ((pKatSopr == KatSopr.nrec))=tsok
  {
    _log('KatSopr='+vKAtSopr.KatSopr.nrec);
    set tOborot.cSoprDoc:=vKAtSopr.KatSopr.nrec;
    set tOborot.tidkgal :=vKAtSopr.KatSopr.vidsopr;
    set tOborot.tidkUser:=vKAtSopr.KatSopr.vidsopr;

    if(cDKZ_Dogovor <> 0)
    { set tOborot.nazna   := GetNaznaFromDog(cDKZ_Dogovor); }    
    If(tOborot.nazna = '')
    { set tOborot.nazna   := vKAtSopr.KatSopr.name; }
    
    set tOborot.dname   :=Get_KatDocName(vKAtSopr.KatSopr.vidsopr);
    set tOborot.dnum    :=vKAtSopr.KatSopr.nsopr;
    set tOborot.dsopr   :=vKAtSopr.KatSopr.dsopr;
    dDateProsrT := dgetattr(coKatSopr, vKAtSopr.KatSopr.nrec, 'Дата оплатить до');
    if dDateProsrT = date(0,0,0) then dDateProsrT := vKAtSopr.KatSopr.dSopr;
    /* датой считать дату из ВА Для KatSopr  ВА = "Дата оплатить до"
    if DlgUsl_chk=0 then
    { // стандартный поиск даты
     _pCalPlan:=vKAtSopr.KatSopr.cCalPlan;
     //Если по товарному ПКП присутствуют только ФинПКП с видом <аванс> (один или несколько),
     //то = дата сопроводительного документа
     //Если по товарному ПКП присутствуют хотя бы один ФинПКП с видом <по факту>,
     //то = самая поздняя из дат, определяемых по формуле:
     //Дата сопроводительного документа + количество дней из поля <В течение ___дней после выполнения> каждого ФинПКП по факту  (PLANPAYSADD.NDAYS)
     dDateProsrT:=Add_Day(vKAtSopr.KatSopr.DSopr,1);
     var _TermDefBy:integer=-10;
     vSpr.pCalplan:=_pCalplan;
     if vSpr.Getfirst CalPlan=tsok
     { vSpr._Loop PaySchem
       { vSpr._Loop PlanPays
         { vSpr._Loop CalPlan_F
           {              
             if _TermDefBy<=vSpr.CalPlan_F.TermDefBy then
             { 
               _TermDefBy:=vSpr.CalPlan_F.TermDefBy;
               if vSpr.CalPlan_F.TermDefBy=1
               {
                 if _NDays<vSpr.PlanPays.NDays
                 { _NDays:=vSpr.PlanPays.NDays; }
                 
                 //_dToPlanPays хранит дату "выполнить по" ФинПКП по факту
                 if (_dToPlanPays < vSpr.PlanPays.dTo)
                 { _dToPlanPays := vSpr.PlanPays.dTo; }
               }
             }
           } //vSpr._Loop CalPlan_F
         } //vSpr._Loop PlanPays
       } //_Loop PaySchem
       if _TermDefBy=1
       { 
         dDateProsrT:=Add_Day(dDateProsrT,_NDays);
         
         //#EM-316 максимальна дата "выполнить по" ФинПКП "по факту"  и выполнить в "течении дней"
         If(dDateProsrT < _dToPlanPays)
         { dDateProsrT := _dToPlanPays; }
       }
     } //if vSpr.Getfirst CalPlan=tsok
       timelog('SprDolg->FillKatsoprProsr:KATSOPR dDateProsrT='+DateToStr(dDateProsrT,'DD/MM/YYYY')
          +', _NDays='+string(_NDays));
   } //if DlgUsl_chk=0 then
   else
   {  // по хозоперации
     if Findsoprhoz(tOborot.tidkgal,tOborot.csoprdoc)
     {
       dDateProsrT:=vSoprHoz.soprhoz.datob;
     }
   }
   */
  } //if getfirst katsopr where ((tOborot.kauos[i] == KatSopr.nrec))=tsok then
} //Function FillKatsoprProsr;

//===========================
// Заполним параметры просрочки по накладным
Function FillPlPorProsr(_pPlPor:comp):boolean;
var
  _pCalPlan:comp;
  _NDays:longint;
{  Result:=true;
  _NDays:=0;
  set vPlPor.pPlPor:=_pPlPor;
  // if getfirst plpor where ((_pPlPor == plpor.nrec))=tsok then
  vPlPor._Loop PlPor
  {
    set tOborot.cSoprDoc:=vPlPor.plpor.nrec;
    set tOborot.tidkgal :=vPlPor.plpor.tidkgal;
    set tOborot.tidkUser:=vPlPor.plpor.TiDk;

    if(cDKZ_Dogovor <> 0)
    { set tOborot.nazna   := GetNaznaFromDog(cDKZ_Dogovor); }    
    If(tOborot.nazna = '')
    { set tOborot.nazna   := vPlPor.plpor.NAMEPL1; }
    
    set tOborot.dname   :=Get_KatDocName(vPlPor.plpor.tidkgal);
    set tOborot.dnum    :=vPlPor.plpor.NODOK;
    set tOborot.dsopr   :=vPlPor.plpor.datvip;

    dDateProsrO := dgetattr(coPlPor, vPlPor.plpor.nrec, 'Дата поставить до'); // Для PlPor  ВА = "Дата поставить до
    if dDateProsrO = date(0,0,0) then vPlPor.plpor.DATVIP;
    /* по ВА считать надо теперь Для PlPor  ВА = "Дата поставить до
    if DlgUsl_chk=0 then
    { // стандартный поиск даты

      //if getfirst basefin where ((plpor.nrec == basefin.cplpor)) =tsok
      vPlPor._Loop basefin
      {

        _pCalPlan:=vPlPor.Basefin.cCalPlan;
        //#EM-108 05.06.2020 снял условие "if vPlPor.Basefin.cKatSopr>0"
        //---------------------
        //1 день (следующий за датой оплаты платежного поручения) - добавить
        dDateProsrO:=Add_Day(vPlPor.Basefin.DDoc,1);

        var days_otsr:longint=0;
        if vPlPor.getfirst CalPlan_Fin=tsok
        { //Если фин.операция (Basefin) по платежному документу связана с ФинПКП
          //в с видом платежей <авансовый>,
          //то = Дата оплаты платежного поручения  + Количество дней из поля <отсрочка поставки дней> (DAYS_OTSR)

          if vPlPor.CalPlan_Fin.TermDefBy=0 //аванс
          { if vPlPor.getfirst planpaysavan=tsok
            { days_otsr := doGetAttr(coPlanPays, vPlPor.planpaysavan.nRec, '.Аванс. Отсрочка поставки, дни'); }

            If (days_otsr <> 0)
            {
              dDateProsrO:=Add_Day(dDateProsrO,days_otsr   );

            }
            Else
            {
              //#EM-108-2 предложение Груздев Василий
              //Если фин.операция по платежному документу связана с ФинПКП с видом платежей <авансовый>:
              //1.В ТовПКП, связанным с ФинПКП (аванс), задано значение <в период с : по :>.
              //    Заполняется: Значение поля <в период по> Товарного ПКП, связанного с ФинПКП (аванс).
              //2.В ТовПКП, связанным с ФинПКП (аванс), задано значение <в течение N дней после выполнения ФинПКП (аванс)>.
              //    Заполняется: Наибольшая дата в значении поля <Оплачен> платежных документов, связанных с ФинПКП (аванс)+ количество Nдней, заданное в ТовПКП в поле <в течение N дней после выполнения ФинПКП (аванс)>.
              if vPlPor.getfirst CalPlan_Tov=tsok
              {
                #Declare DayFromCalPlanTov

                if vPlPor.CalPlan_Tov.TermDefBy=0 //в период
                {
                 dDateProsrO:=Add_Day(vPlPor.CalPlan_Tov.dTo, 1);

                }
                else //в течении
                {
                 dDateProsrO:=Add_Day(dDateProsrO, vPlPor.CalPlan_Tov.NDays);

                }

                #End
                #DayFromCalPlanTov
              }
            }  

          }
          else
          { //Если фин.операция (Basefin) по платежному документу связана с ФинПКП
            //в с видом платежей <по факту>, то = Дата оплаты платежного поручения
            if vPlPor.getfirst PlanPaysAdd=tsok
            { //?? 04/08/2018 требование было отменено
              dDateProsrO:=Add_Day(dDateProsrO,vPlPor.PlanPaysAdd.NDays);

            }
          }
        } //if vPlPor.getfirst CalPlan_Fin=tsok
        else if vPlPor.getfirst CalPlan_Tov=tsok
        {
          //#EM-316 При отсутсвии ФинПКП опредлять по ТовПКП
          #DayFromCalPlanTov
        } //if vPlPor.getfirst CalPlan_Tov=tsok
        
        timelog('SprDolg->FillPlPorProsr:Basefin dDateProsrO='+DateToStr(dDateProsrO,'DD/MM/YYYY')
             +', days_otsr='+string(days_otsr));
      }
    } //if DlgUsl_chk=0 then
    else
    {  // по хозоперации
      if FindSoprhoz(tOborot.tidkgal,tOborot.csoprdoc)
      { dDateProsrO:=vSoprHoz.soprhoz.datob;

      }

    } //else if DlgUsl_chk=0 then
    */
  } //if getfirst plpor where ((tOborot.kauos[i] == plpor.nrec))=tsok then

} //Function FillPlPorProsr(_pPlPor:comp) boolean;

Function FillPlPorProsr2(_pPlPor:comp;cBaseDoc:comp):boolean;
var
  _pCalPlan:comp;
  _NDays:longint;
{  Result:=true;
  _NDays:=0;
  set vPlPor.pPlPor:=_pPlPor;
  // if getfirst plpor where ((_pPlPor == plpor.nrec))=tsok then
  vPlPor._Loop PlPor
  {
    set tOborot.cSoprDoc:=vPlPor.plpor.nrec;
    set tOborot.tidkgal :=vPlPor.plpor.tidkgal;
    set tOborot.tidkUser:=vPlPor.plpor.TiDk;

    if(cDKZ_Dogovor <> 0)
    { set tOborot.nazna   := GetNaznaFromDog(cDKZ_Dogovor); }
    If(tOborot.nazna = '')
    { set tOborot.nazna   := vPlPor.plpor.NAMEPL1; }

    set tOborot.dname   :=Get_KatDocName(vPlPor.plpor.tidkgal);
    set tOborot.dnum    :=vPlPor.plpor.NODOK;
    set tOborot.dsopr   :=vPlPor.plpor.datvip;

    dDateProsrO := dgetattr(coPlPor, vPlPor.plpor.nrec, 'Дата поставить до'); // Для PlPor  ВА = "Дата поставить до
    if dDateProsrO = date(0,0,0) then vPlPor.plpor.DATVIP;


    /*
    if DlgUsl_chk=0 then
    { // стандартный поиск даты

      //if getfirst basefin where ((plpor.nrec == basefin.cplpor)) =tsok
      if vPlPor.getfirst basefin where ((cBaseDoc == basefin.CBASEDOC))=tsok
      {

        _pCalPlan:=vPlPor.Basefin.cCalPlan;
        //#EM-108 05.06.2020 снял условие "if vPlPor.Basefin.cKatSopr>0"
        //---------------------
        //1 день (следующий за датой оплаты платежного поручения) - добавить
        dDateProsrO:=Add_Day(vPlPor.Basefin.DDoc,1);
        var days_otsr:longint=0;
        if vPlPor.getfirst CalPlan_Fin=tsok
        { //Если фин.операция (Basefin) по платежному документу связана с ФинПКП
          //в с видом платежей <авансовый>,
          //то = Дата оплаты платежного поручения  + Количество дней из поля <отсрочка поставки дней> (DAYS_OTSR)

          if vPlPor.CalPlan_Fin.TermDefBy=0 //аванс
          { if vPlPor.getfirst planpaysavan=tsok
            { days_otsr := doGetAttr(coPlanPays, vPlPor.planpaysavan.nRec, '.Аванс. Отсрочка поставки, дни'); }
            If (days_otsr <> 0)
            {
              dDateProsrO:=Add_Day(dDateProsrO,days_otsr   );
            }
            Else
            {
              //#EM-108-2 предложение Груздев Василий
              //Если фин.операция по платежному документу связана с ФинПКП с видом платежей <авансовый>:
              //1.В ТовПКП, связанным с ФинПКП (аванс), задано значение <в период с : по :>.
              //    Заполняется: Значение поля <в период по> Товарного ПКП, связанного с ФинПКП (аванс).
              //2.В ТовПКП, связанным с ФинПКП (аванс), задано значение <в течение N дней после выполнения ФинПКП (аванс)>.
              //    Заполняется: Наибольшая дата в значении поля <Оплачен> платежных документов, связанных с ФинПКП (аванс)+ количество Nдней, заданное в ТовПКП в поле <в течение N дней после выполнения ФинПКП (аванс)>.
              if vPlPor.getfirst CalPlan_Tov=tsok
              {
                #Declare DayFromCalPlanTov2
                if vPlPor.CalPlan_Tov.TermDefBy=0 //в период
                {
                 dDateProsrO:=Add_Day(vPlPor.CalPlan_Tov.dTo, 1);
                }
                else //в течении
                {
                 dDateProsrO:=Add_Day(dDateProsrO, vPlPor.CalPlan_Tov.NDays);
                }
                #End
                #DayFromCalPlanTov2
              }
            }

          }
          else
          { //Если фин.операция (Basefin) по платежному документу связана с ФинПКП
            //в с видом платежей <по факту>, то = Дата оплаты платежного поручения
            if vPlPor.getfirst PlanPaysAdd=tsok
            { //?? 04/08/2018 требование было отменено
              dDateProsrO:=Add_Day(dDateProsrO,vPlPor.PlanPaysAdd.NDays);
            }
          }
        } //if vPlPor.getfirst CalPlan_Fin=tsok
        else if vPlPor.getfirst CalPlan_Tov=tsok
        {
          //#EM-316 При отсутсвии ФинПКП опредлять по ТовПКП
          #DayFromCalPlanTov
        } //if vPlPor.getfirst CalPlan_Tov=tsok

        timelog('SprDolg->FillPlPorProsr:Basefin dDateProsrO='+DateToStr(dDateProsrO,'DD/MM/YYYY')
             +', days_otsr='+string(days_otsr));
      }
    } //if DlgUsl_chk=0 then
    else
    {  // по хозоперации
      if FindSoprhoz(tOborot.tidkgal,tOborot.csoprdoc)
      { dDateProsrO:=vSoprHoz.soprhoz.datob;
      }

    } //else if DlgUsl_chk=0 then
   */
  } //if getfirst plpor where ((tOborot.kauos[i] == plpor.nrec))=tsok then
} //Function FillPlPorProsr2(_pPlPor:comp;cBaseDoc:comp):boolean;

//===========================
// Заполним параметры просрочки по записям в книге продаж/покупок
Function FillBookPrZkProsr(_nrec :comp) : boolean;
{  
  Result := true;
  
  set vBookPrZk.pBookPrZk := _nrec;
  
  vBookPrZk._Loop BookPrZk
  {
    If (vBookPrZk.GetFirst FastFirstRow UsersDoc <> TsOk)
    { Continue; }
    
    set tOborot.cSoprDoc := vBookPrZk.BookPrZk.nrec;
    set tOborot.tidkgal  := vBookPrZk.UsersDoc.tipGal;
    set tOborot.tidkUser := vBookPrZk.UsersDoc.TipUsers;

    if(cDKZ_Dogovor <> 0)
    { set tOborot.nazna   := GetNaznaFromDog(cDKZ_Dogovor); }    
    If(tOborot.nazna = '')
    { set tOborot.nazna   := vBookPrZk.BookPrZk.nazn; }
    
    set tOborot.dname     := Get_KatDocName(tOborot.tidkgal);
    set tOborot.dnum      := vBookPrZk.BookPrZk.num;
    set tOborot.dsopr     := vBookPrZk.BookPrZk.DReg;
    if DlgUsl_chk=0
    { // стандартный поиск даты
      //1 день (следующий за датой оплаты) - добавить
      dDateProsrO := Add_Day(vBookPrZk.BookPrZk.DOpl, 1);
    }
    else
    {  // по хозоперации
      if FindSoprhoz(tOborot.tidkgal,tOborot.csoprdoc)
      { dDateProsrO:=vSoprHoz.soprhoz.datob; }
    }
  }
} //Function FillBookPrZkProsr

//===========================
// Заполним параметры просрочки по Ведомость депонирования
Function FillVedDeponirProsr(_nrec :comp) : boolean;
{  
  Result := true;
  
  set vVedDeponir.pVedDeponir := _nrec;
  
  vVedDeponir._Loop VedDeponir
  {   
    set tOborot.cSoprDoc := vVedDeponir.VedDeponir.nrec;
    set tOborot.tidkgal  := cgDoc_0024;//Ведомость депонирования
    set tOborot.tidkUser := cgDoc_0024;//Ведомость депонирования

    if(cDKZ_Dogovor <> 0)
    { set tOborot.nazna   := GetNaznaFromDog(cDKZ_Dogovor); }    
    If(tOborot.nazna = '')
    { set tOborot.nazna   := vVedDeponir.VedDeponir.name; }
    
    set tOborot.dname     := 'Ведомость депонирования';
    set tOborot.dnum      := vVedDeponir.VedDeponir.noDoc;
    set tOborot.dsopr     := vVedDeponir.VedDeponir.dForm;
    if DlgUsl_chk=0
    { // стандартный поиск даты
      //1 день (следующий за датой оплаты) - добавить
      dDateProsrO := Add_Day(vVedDeponir.VedDeponir.dForm, 1);
    }
    else
    {  // по хозоперации
      if FindSoprhoz(tOborot.tidkgal,tOborot.csoprdoc)
      { dDateProsrO:=vSoprHoz.soprhoz.datob; }
    }
  }
} //Function FillVedDeponirProsr

procedure LoadSoprDoc;
var
  tcc:comp;
  tss:string;
{
  for(i:=1;i<=6;i:=i+1)
  { 
    //#EM-389_2 - В настройке ДКЗ "76_04 сотрудники"  необходимо выгружать сотрудника
    if (cgKau_Persons = tOborot.tblos[i])
    { 
      set toborot.kontr := Trim(ShowKau(tOborot.tblos[i], tOborot.kauos[i]));
      break;
    }  
  
    //#EM-389_2 - В настройке ДКЗ "76 счет без 04 субсчета_организации"   необходимо выгружать контрагента
    if (cgKau_KatOrg = tOborot.tblos[i])
    {    
      vSpr.pKatOrg:=tOborot.kauos[i];
      vSpr._Loop KatOrg
      {
         set toborot.inn :=vSpr.KatOrg.unn;
         set toborot.corg:=vSpr.KatOrg.nrec;
         set toborot.ogrn:=vSpr.KatOrg.ogrn;
         break;
      }
      
      set toborot.kontr := Trim(ShowKau(tOborot.tblos[i], tOborot.kauos[i]));
      if cDKZ_KatOrg=0 
      { cDKZ_KatOrg:=tOborot.kauos[i]; }      
      break;
    }  
  } //for(i:=1;i<=6;i:=i+1)

  for(i:=1;i<=7;i:=i+1)
  {
    dDateProsrT:=ZeroDate;
    dDateProsrO:=ZeroDate;
    
    if cgKau_KatSopr=tOborot.tblos[i]
    {
      FillKatsoprProsr(Comp(tOborot.kauos[i]));
    }    
    Else if cgKau_plpor=tOborot.tblos[i]
    {
      FillPlPorProsr2(Comp(tOborot.kauos[i]),Comp(tOborot.kauos[3]));
    }
    Else if cgKau_BookPrZk=tOborot.tblos[i]
    {
      FillBookPrZkProsr(Comp(tOborot.kauos[i]));
    }
    Else if cgKau_VedDeponir=tOborot.tblos[i]
    {
      FillVedDeponirProsr(Comp(tOborot.kauos[i]));
    }
    else
    {
      Continue;
    }
    
     set tOborot.DateProsrO := dDateProsrO;
     set tOborot.DateProsrT := dDateProsrT;
     set tOborot.dVoznPr    := GetMinDate(tOborot.dVoznPr,GetMinDate(dDateProsrO,dDateProsrT));//GetMinDate
     set tOborot.MaxD       := GetMinDate(tOborot.MaxD,tOborot.dVoznPr);  //GetMinDate
     set tOborot.MinD       := GetMinDate(tOborot.MinD,tOborot.dVoznPr);// GetMinDate
     set tOborot.day_Prosr  := if (DlgUsl_chk=0,GetDaysProsr(tOborot.dVoznPr),GetDaysProsr2(tOborot.dVoznPr));
     break;
  } //for(i:=1;i<=7;i:=i+1)
    
  if cDKZ_Dogovor<>0 then
  {
    tcc:=0;tss:=''; if GetKurPodrDog(cDKZ_Dogovor,tcc,tss) {set tOborot.cPodr:=tcc; set toborot.sPodr:=tss;}
    tcc:=0;tss:=''; if GetFPSTBUD(coGetAttrID(coDogovor, cDKZ_Dogovor, pVA_DOGOVOR_KBK),tcc,tss) {set tOborot.cDDS:=tcc; set toborot.sDDS:=tss;}
    set tOborot.cCO:=cDKZ_CO; set toborot.sCO:=sDKZ_CO;
    tcc:=0;tss:=''; if GetMenDog(cDKZ_Dogovor,tcc,tss) {set tOborot.cMen:=tcc; set toborot.sMen:=tss;}
    set tOborot.cdog:=cDKZ_Dogovor;
    set tOborot.sdog:=string(cDKZ_Dogovor);
  }
  
  set tOborot.ob    := GetOB(tOborot.corg,tOborot.cdog);
  set tOborot.schet := tOborot.sch+if(toborot.subsch='','','.')+tOborot.subsch;
} //procedure LoadSoprDoc;


//================================
//
//--------------------------------
#Declare SetDayProsr(tOborot,tSum)
 var _day_Prosr:longint;
 var _day_year :longint;
 var _day_isk  :longint;

    _day_year:=CalcDaysBetweenDates(Date(1,1,Year(EndDate)),EndDate,false);    
    _day_Prosr:=abs(#tOborot.day_Prosr);
    
    //#3503.#44
    //Необходимо учитывать реальное кол-во дней в месяце. Например:
    //01.11.2018 по 31.12.2018 должно попасть в графу до 3-х месяцев, а согласно заложенному алгоритму попадает в графу свыше 3 месяцев, т.к. прошло 92 дня
    //ни хрена не понял, но как то сделаем.
    var _mes_Prosr:longint=0;
    
    if _day_Prosr<>0
    { var _Dtb:date=if(EndDate<#tOborot.dVoznPr,EndDate,#tOborot.dVoznPr );
      var _DtE:date=if(EndDate>#tOborot.dVoznPr,EndDate,#tOborot.dVoznPr );
      _mes_Prosr:=(month(_Dte)-month(_Dtb)) +12*(Year(_Dte)-Year(_Dtb))
             + if((1+Day(_DtE)-day(_Dtb))>=Last_day(_Dtb) ,1,0);
      //#EM-316 предложение Груздев Василий: Если число дней просрочки отрицательно, считать ее меньше 1-го месяца
      If(#tOborot.day_Prosr < 0)
      { _mes_Prosr:= 0; }
    }
    if          _day_Prosr<=   _day_year  then set #tOborot.sum_prosr[1]:=#tOborot.sum_prosr[1]+#tSum;
    if  _mes_Prosr<  1                               then set #tOborot.sum_prosr[2]:=#tOborot.sum_prosr[2]+#tSum;
    if  (1   <= _mes_Prosr) and (_mes_Prosr<   3)    then set #tOborot.sum_prosr[3]:=#tOborot.sum_prosr[3]+#tSum;
    if  (3   <= _mes_Prosr) and (_mes_Prosr<   6)    then set #tOborot.sum_prosr[4]:=#tOborot.sum_prosr[4]+#tSum;
    if  (6   <= _mes_Prosr) and (_mes_Prosr<  12)    then set #tOborot.sum_prosr[5]:=#tOborot.sum_prosr[5]+#tSum;
    if  (12  <= _mes_Prosr) and (_mes_Prosr<  36)    then set #tOborot.sum_prosr[6]:=#tOborot.sum_prosr[6]+#tSum;
    if  (36  <= _mes_Prosr)                          then set #tOborot.sum_prosr[7]:=#tOborot.sum_prosr[7]+#tSum;
    case ReportTip of
    9: _day_isk:=Kol_Days_Prosr;
    else
    { if DlgUslM<>0 then
      _day_isk:=DlgUslM  * 30;
    }
    end;
    if _day_isk<>0 then
    { if _day_Prosr>_day_isk then set #tOborot.istek_summa:=#tOborot.istek_summa+#tSum;
    }
#End

procedure LoadSumma(tSum:double);
{
  tOborot.tip:=if(MemNastr.tip<=2,1,3);
  if cDKZ_Dogovor<>0 then
    if Pos(string(cDKZ_Dogovor),toborot.sdog)=0 then
     {
       set toborot.sdog:=toborot.sdog+'#'+string(cDKZ_Dogovor);
     }
!  if timelog_status>2
    timelog('LoadSumma:ReportTip= '+string(ReportTip)
       +', MemNastr.tip='+string(MemNastr.tip)+', tSum='+string(tSum,0,2));
  case ReportTip of
  9:
  { case MemNastr.tip of
    2://Резерв на начало периода
    { set tOborot.summaR   := tOborot.summaR -tSum;//#3835.#5 - не тот знак
!      if timelog_status>2
        _log('Резерв на начало периода : '+string(tOborot.summaR,0,2));
      Exit;
    }
    3://Встречные обязательства
    { set tOborot.summaIn   := tOborot.summaIn+tSum;
!      if timelog_status>2
        _log('Встречные обязательства : '+string(tOborot.summaIn,0,2));

      Exit;
    }
    end;
  }
  end;
   set tOborot.summa      := tOborot.summa+tSum;
   #SetDayProsr(tOborot,tSum)
} //procedure LoadSumma(tSum:double);

