Function GetBookPrZkName(_nrec: Comp):string; cacheable;
{ 
  Result := '';

  set vBookPrZk.pBookPrZk := _nrec;  
  vBookPrZk._Loop BookPrZk
  {
    If (vBookPrZk.GetFirst FastFirstRow UsersDoc <> TsOk)
    { Continue; }
    
    Result := Get_KatDocName(vBookPrZk.UsersDoc.tipGal);
    Result += ' № '  + vBookPrZk.BookPrZk.num;
    Result += ' от ' + vBookPrZk.BookPrZk.DReg;
  }  
} //Function GetBookPrZkName

//-----------------------------------------------------
Function GetVedDeponirName(_nrec: Comp):string; cacheable;
{ 
  Result := '';

  set vVedDeponir.pVedDeponir := _nrec;  
  vVedDeponir._Loop VedDeponir
  {
    Result := 'Ведомость депонирования';
    Result += ' № '  + vVedDeponir.VedDeponir.noDoc;
    Result += ' от ' + vVedDeponir.VedDeponir.dForm;
  }  
} //Function GetVedDeponirkName

