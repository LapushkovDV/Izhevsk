                          + if(JornTune.TblOs[5] > 0, ' / '+GetAnalitikName(JornTune.TblOs[5]), '')
                          + if(JornTune.TblOs[6] > 0, ' / '+GetAnalitikName(JornTune.TblOs[6]), '')
                         ,7,1,7,1);  
  MyxlSetCellStringValue('Задолженность со сроком возникновения более '+Kol_Days_Prosr+' дней не оплаченная',7,3,7,3);               
 //====================================
  wexrow:=7;_NPP:=0;
  HeaderStrCount:=wexrow;
  wexrow++;
  MaxColCount:=18;
  MyXlCreaMatrix(1000,MaxColCount);
  wexrow--;
 //====================================

  RecursionPrint9(0,Integer(0),0);
 //====================================
  MyxlWriteMatrix(wexrow);
  xlFreeMatrix;
  matrixkl:=False;
  //====================================
  //=СУММ(C9:C33)/2
  //=СУММ(C8:C112)
/*
  #3835_EM-31 - т.к. отчет иерархический, то прямое суммирование ячеек лишено сммысла  
  xlSetCellFormula('=СУММ(B8:B'+String(wexrow-1)+')/2',6,2,6,2);
  xlSetCellFormula('=СУММ(C8:C'+String(wexrow-1)+')/2',6,3,6,3);
  xlSetCellFormula('=СУММ(E8:E'+String(wexrow-1)+')/2',6,4,6,4);
  xlSetCellFormula('=СУММ(F8:F'+String(wexrow-1)+')/2',6,5,6,5);
  xlSetCellFormula('=СУММ(G8:G'+String(wexrow-1)+')/2',6,6,6,6);
  xlSetCellFormula('=СУММ(H8:H'+String(wexrow-1)+')/2',6,7,6,7);
  xlSetCellFormula('=СУММ(I8:I'+String(wexrow-1)+')/2',6,8,6,8);
  xlSetCellFormula('=СУММ(J8:J'+String(wexrow-1)+')/2',6,9,6,9);
*/  
  //--------------------------
  xlWrapText(8, 1, wexrow, 8);

  inc(wexrow);
  inc(wexrow);
  xlAlignCells(xlRight, wexrow, 1, wexrow, 1);

  MyxlSetCellStringValue('Расчет выполнил(а)' ,wexrow, 1,wexrow, 1);
  xlSetActiveSheet(1);
  MyxlSetCellStringValue(sGetTune('USER.FIO') ,wexrow, 3,wexrow, 3);

} //procedure PR9;


//=====================================================
//10. Расчет сомнительных долгов
//-----------------------------------------------------

procedure PR10; {
  var reportDate:string = DateToStr(EndDate,'DD Mon YYYY');
  MyxlSetCellStringValue(reportDate,1,1,1,1);

  wexrow:=4;
  curcOrg:=0;
  curcDog:=0;

  curOrgRow := 0;
  curDogRow := 0;

  curOrgSum1 := 0;
  curOrgSum2 := 0;
  curOrgSum3 := 0;

  SumItogo1 := 0;
  SumItogo2 := 0;
  SumItogo3 := 0;


  _loop tOborot where ((0 == toborot.dkz)) ordered by toborot.gr[1] {//взять строку
    if (not NextVisual) {
       exit;
    }
    if tOborot.tip=2 and toborot.sum_prosr[7]=0 {
       continue;
    }
    LOOP_PR10;//обработка строки

  }
    SumItogo1 := SumItogo1 + curOrgSum1;
    SumItogo2 := SumItogo2 + curOrgSum2;
    SumItogo3 := SumItogo3 + curOrgSum3;
    wexrow := wexrow + 1;
    xlAlignCells(xlRight, wexrow, 1, wexrow, 11);
    xlSetFontStyle(xlBold ,wexrow, 1, wexrow, 11);
    xlSetBackColor(0D9D9D9h  ,wexrow,1,wexrow,11);

    xlFrameCells(63, xlThin, 0, 0,wexrow,1,wexrow,11);
    MyxlSetCellStringValue('Итого', wexrow,1,wexrow,1);
    MyxlSetCellStringValue(SumItogo1, wexrow,2,wexrow,2);
    MyxlSetCellStringValue(SumItogo2, wexrow,3,wexrow,3);
    MyxlSetCellStringValue(SumItogo3, wexrow,4,wexrow,4);

    xlSetCellFormula('=СУММ(F5:F'+(wexrow-1)+')', wexrow, 6, wexrow, 6);
    xlSetCellFormula('=СУММ(G5:G'+(wexrow-1)+')', wexrow, 7, wexrow, 7);
    xlSetCellFormula('=СУММ(H5:H'+(wexrow-1)+')', wexrow, 8, wexrow, 8);
    xlSetCellFormula('=СУММ(I5:I'+(wexrow-1)+')', wexrow, 9, wexrow, 9);
    xlSetCellFormula('=СУММ(J5:J'+(wexrow-1)+')', wexrow, 10, wexrow, 10);
    xlSetCellFormula('=СУММ(K5:K'+(wexrow-1)+')', wexrow, 11, wexrow, 11);
    xlSetCellFormula('=СУММ(B'+(wexrow)+':D'+(wexrow)+')', wexrow, 5, wexrow, 5);

} //procedure PR10;

//=====================================================
// 11 'Отчет по всей дебиторской/кредиторской задолженности'
//-----------------------------------------------------
procedure PR11;
var kolR, kolC, r1, i, j: longint;
{
  mtClear(tntRep11, mfNormal);
  //PutTableToDBF(tntoborot, 'dkz.dbf', ptfFullTable);
  _loop tOborot
  {
    var sch: string = SubStr(tOborot.schet,2,255);
    if getfirst tRep11 where ((tOborot.cOrg == tRep11.cOrg and tOborot.cdog == tRep11.cDog and tOborot.cCO == tRep11.cCO and sch == tRep11.sSchet)) <> tsOk
    {
      ClearBuffer(tntRep11);
      tRep11.cOrg := tOborot.cOrg;
      tRep11.cDog := tOborot.cdog;
      tRep11.cCO := tOborot.cCO;
      tRep11.sOrg := tOborot.Kontr;
      tRep11.sDog := ShowKau(cgKau_Dogovor, tOborot.cdog);
      tRep11.sCO := tOborot.sCO;
      tRep11.sSchet := sch;
      tRep11.sPerson := tOborot.sMen;
      tRep11.sPodr := tOborot.sPodr;
      insert current tRep11;
    }
    if tOborot.dkz = 0
      tRep11.doDeb += tOborot.summa;
    else
      tRep11.doKred += tOborot.summa;
    update current tRep11;
  }

  xlSetCellStringValue('Сведения о дебиторской и кредиторской задолженности по состоянию на ' + DateToStr(EndDate, 'DD.MM.YYYY') + ' года', 2, 1, 2, 1);
  xlSetCellStringValue('Задолженность по договору на ' + DateToStr(EndDate, 'DD.MM.YYYY') + ', руб.', 4, 3, 4, 3);

  kolR := RecordsInTable(tntRep11);
  kolC := 10;
  r1 := 8;
  xlCreateMatrix(kolR, kolC);
  if KolR > 2 then xlInsertRange(xlShiftDown, r1 + 1, 1, r1 + KolR - 2, KolC);
  if KolR < 2 then xlDeleteRange(xlShiftUp, r1, 1, r1 + 1 - KolR, KolC);
  i := 0;
  _loop tRep11 ordered by tRep11.sOrg, tRep11.sDog
  {
    j := 0;
    xlStWriteToMatrix(++i, ++j, tRep11.sOrg);
    xlStWriteToMatrix(  i, ++j, tRep11.sDog);
    xlStWriteToMatrix(  i, ++j, tRep11.sSchet);
    xlDoWriteToMatrix(  i, ++j, tRep11.doDeb);
    xlDoWriteToMatrix(  i, ++j, tRep11.doKred);
    j += 2;
    xlStWriteToMatrix(  i, ++j, tRep11.sPerson);
    xlStWriteToMatrix(  i, ++j, tRep11.sPodr);
    xlStWriteToMatrix(  i, ++j, tRep11.sCO);
  }
  xlWriteMatrixToExcel(r1, 1);
}

//=====================================================
// 12 'К паспорту предприятия. Деб./Кред. задолженность на дату'
//-----------------------------------------------------
procedure PR12;
var kolR, kolC, r1, i, j, lst: longint;
    addr: string;
    wClassIGK: word;
{
  wClassIGK := GetClassCode(coDogovor, 'Идентификатор государственного контракта');
  mtClear(tntRep12, mfNormal);  
  _loop tOborot ordered by tOborot.MinD
  {
    var sch: string = SubStr(tOborot.schet,2,255);
    if getfirst tRep12 where ((tOborot.dkz == tRep12.wType and tOborot.cOrg == tRep12.cOrg and tOborot.cdog == tRep12.cDog and sch == tRep12.sSchet)) <> tsOk
    {
      ClearBuffer(tntRep12);
      tRep12.wType := tOborot.dkz;
      tRep12.cOrg := tOborot.cOrg;
      tRep12.cDog := tOborot.cdog;
      if getfirst KatOrg where ((tOborot.cOrg == KatOrg.NRec)) = tsOk
      {
        _loop KatOrgDescr where ((tOborot.cOrg == KatOrgDescr.cRec))
        {
          if getfirst KatOrgDescr2 where ((KatOrgDescr.cGroup == KatOrgDescr2.NRec)) = tsOk
            tRep12.sGrOrg += if(tRep12.sGrOrg = '', '', ', ') + KatOrgDescr2.Name;
        }
        tRep12.sOrg := tOborot.Kontr;
        TOA.Bind(KatOrg.NRec);
        addr := Trim(TOA.GetJuridicalInfo.GetJuridicalAddressStr);
        if addr = ''
          addr := Trim(iAdrFunc.GetFullAddressInd(TOA.GetJuridicalInfo.GetPostAddress));
        if addr <> ''
          tRep12.sOrg += ', ' + addr;
      }
      if getfirst Dogovor where ((tOborot.cdog == Dogovor.NRec)) = tsOk
      {
        tRep12.sDog := ShowKau(cgKau_Dogovor, tOborot.cdog);
        tRep12.dExpiried := Dogovor.dEnd;
        if GetSegName(wClassIgk, Dogovor.NRec) <> ''
          tRep12.sIGK := 'Да';
      }
      tRep12.dDebt := tOborot.MinD;
      tRep12.sSchet := sch;
      if (tOborot.sch = '060' or tOborot.sch = '062' or tOborot.sch = '076') and tOborot.TBLOS[6] = 10043
        tRep12.sVidVz := ShowKau(10043, tOborot.kauos[6]);
      if (tOborot.sch = '076' and tOborot.subsch = '03' or tOborot.sch = '076' and tOborot.subsch = '09') and tOborot.TBLOS[3] = 10214
        tRep12.sVidOp := ShowKau(10214, tOborot.kauos[3]);
      insert current tRep12;
    }
    tRep12.doDebt += tOborot.summa;
    tRep12.doExpiried += tOborot.sum_prosr[4] + tOborot.sum_prosr[5] + tOborot.sum_prosr[6] + tOborot.sum_prosr[7];
    update current tRep12;
  }
  kolC := 12;
  r1 := 9;
  for (lst := 0; lst <= 1; lst++)
  {
    xlSetActiveSheetByName(if(lst = 0, 'ДЗ', 'КЗ'));
    xlSetCellStringValue('Сведения о ' + if(lst = 0, 'дебиторской', 'кредиторской') + ' задолженности по состоянию на ' + DateToStr(EndDate, 'DD.MM.YYYY') + ' года', 3, 2, 3, 2);
    kolR := 0;
    _loop tRep12 where ((lst == tRep12.wType))
      kolR++;
    xlCreateMatrix(kolR, kolC);
    if KolR > 2 then xlInsertRange(xlShiftDown, r1 + 1, 1, r1 + KolR - 2, KolC);
    if KolR < 2 then xlDeleteRange(xlShiftUp, r1, 1, r1 + 1 - KolR, KolC);
    i := 0;
    _loop tRep12 where ((lst == tRep12.wType)) ordered by tRep12.sOrg, tRep12.sDog
    {
      j := 1;
      xlStWriteToMatrix(++i, ++j, tRep12.sGrOrg);
      xlStWriteToMatrix(  i, ++j, tRep12.sOrg);
      xlStWriteToMatrix(  i, ++j, tRep12.sDog);
      xlStWriteToMatrix(  i, ++j, tRep12.dDebt);
      xlStWriteToMatrix(  i, ++j, tRep12.dExpiried);
      xlStWriteToMatrix(  i, ++j, tRep12.sSchet);
      xlDoWriteToMatrix(  i, ++j, tRep12.doDebt);
      xlDoWriteToMatrix(  i, ++j, tRep12.doExpiried);
      xlStWriteToMatrix(  i, ++j, tRep12.sIGK);
      xlStWriteToMatrix(  i, ++j, tRep12.sVidVz);
      xlStWriteToMatrix(  i, ++j, tRep12.sVidOp);
    }
    xlWriteMatrixToExcel(r1, 1);
    xlFreeMatrix;
  }
}
//=====================================================
//  Печать документа
//-----------------------------------------------------
procedure PrintReport;
var ReportName:string;
    _Count:longint;
{
  ReportName:='';
  Delilka:=1;

  _Count:=RecordsInTable(#ttreesx)+30;
  case ReportTip of
    0: {
        Var shead : String[64] = 'Значение для определения "Крупные суммы"';
        If (RunDialog('C_Common::GetDoubleWithHeader', shead, krupSumma) <> CmOk)
        { Exit; }

        ReportName:='gp_dkz_base';
        Delilka:=1000;
       }
    1: {
        ReportName:='gp_dkz_inv17';
       }
    2: {
        ReportName:='gp_dkz_invspr';
       }
    3: {
        ReportName:='gp_dkz_invspr';
        _Count:=RecordsInTable(#tOborot);
       }
    4: {
        ReportName:='gp_dkz_prosr';
        _Count:=RecordsInTable(#tOborot);
       }
    5: {
        ReportName:='gp_dkz_rasch';
        _Count:=RecordsInTable(#tOborot);
       }
    6: {
        Delilka:=1000;
         ReportName:='gp_dkz_dk';
        _Count:=RecordsInTable(#tOborot);
       }
    7: {
        ReportName:='gp_dkz_prdk';
        _Count:=RecordsInTable(#tOborot);
       }
    8: {
        ReportName:='gp_dkz_prdk';
        _Count:=RecordsInTable(#tOborot);
       }
    9: {
        ReportName:='GP_DKZ_Akt_Prosr';
       }
    10: {
        ReportName:='GP_DKZ_Somnit_Dolg';
        }
    11: ReportName:='GP_DKZ_United';
    12: ReportName:='GP_DKZ_Passport';
 end;
 if ReportName='' then exit;


 ExcelPath:= TranslatePath('%ClientStartPath%');
 xlCreateNewExcelWithTemplate(excelpath + 'XLS_ЭМ\BU\'+ReportName+'.xlsx',true);
 if (xlIsExcelValid) xlSetActiveWorkBookByName('1');
 //-----------------------
 MaxColCount:=30;
 xlFreeMatrix;
 matrixkl:=False;
 //-----------------------


 StartNewVisual(vtIndicatorVisual,vfTimer+vfBreak+vfConfirm,'Формирование отчета...',_Count);

 case ReportTip of
    0: PR1;        //'Дебиторская/Кредиторская задолженность(Крупные суммы)'
    1: PR2;        //'Акт инвентаризации ИНВ-17'
    2: PR3(1);     //'Справка к акту инвентаризации ИНВ-17'
    3: PR3(2);     //'Дебиторская и кредиторская задолженность контрагентов свыше 3-х лет'
    4: PR5;        //'Дебиторская и кредиторская задолженность контрагентов свыше 3-х лет'
    5: PR4;        //'Справка-расчёт по составу сомнительной задолженности'
    6: PR6;        //'Дебиторская и кредиторская задолженность'
    7: PR7(1);     //'Отчет по всей дебиторской/кредиторской задолженности'
    8: PR7(2);     //'Отчет по ДКЗ с просроченным сроком исковой давности'
    9: PR9;        //'Акт инвентаризации по просроченной задолженности'
    10: PR10;      //'Расчет сомнительных долгов'
    11: PR11;      //'Отчет по всей дебиторской/кредиторской задолженности'
    12: PR12;      //'К паспорту предприятия. Деб./Кред. задолженность на дату'
 end;
 //-----------------------
 xlFreeMatrix;
 matrixkl:=False;
 //-----------------------

 StopVisual('',0);
 xlkillExcel;
} //procedure PrintReport;





