//
//--------------------------------
procedure LoadMarker(NameMarker : string;mr:string);
var Marker : TPtr;
{

  Marker := InitMarker(NameMarker, 8, 100, 10,false);
  ClearMarker(Marker);
   _log('LoadMarker:Load '+NameMarker+'   '+mr);
  _loop SpBuhRep where ((BuhRepEntity == wEntity and
                         cReport  == cEntity and
                         mr  == STBL))
  {
    _log('   M='+GetMarkerCount(Marker)+' '+SpBuhRep.crec);
   InsertMarker(Marker, SpBuhRep.crec);
  }

 case mr of
  'gp_m1':  MarkerCount_K:=GetMarkerCount(Marker);
  'gp_m2':  MarkerCount_D:=GetMarkerCount(Marker);
  'gp_m3':  MarkerCount_C:=GetMarkerCount(Marker);
  'gp_m4':  MarkerCount_V:=GetMarkerCount(Marker);
  'gp_m5':  MarkerCount_P:=GetMarkerCount(Marker);
 end;
 DoneMarker(Marker, NameMarker);
} // IsValidMarker

//================================
//
//--------------------------------
procedure SaveMarker(NameMarker : string;mr:string);
var
  MarkerCount,i : longint;
  cc:comp;
{

  Marker := InitMarker(NameMarker, 8, 100, 10);
  MarkerCount := GetMarkerCount(Marker);
  delete SpBuhRep where ((BuhRepEntity == SpBuhRep.wEntity and cReport  == SpBuhRep.cEntity and  mr  == SpBuhRep.STBL));

  _log('SaveMarker Name='+NameMarker+', mr='+mr+', count='+string(MarkerCount)+', cRepot='+string(cReport,0,0));
  for (i:=0; i<MarkerCount; i:=i+1)
    if GetMarker(Marker, i, cc)
    {
      ClearBuffer(#SpBuhRep);
      SpBuhRep.wEntity := BuhRepEntity;
      SpBuhRep.cEntity := cReport;
      SpBuhRep.STBL    := mr;
      SpBuhRep.FNAME   := mr;
      SpBuhRep.FTYPE   := 17;
      SpBuhRep.cvalue  :=  1;
      SpBuhRep.crec:=cc;
      if insert current SpBuhRep =tsok {};
      _log('   M='+i+'   '+cc);
    }
  DoneMarker(Marker, '');
} //procedure SaveMarker(NameMarker : string;mr:string);


