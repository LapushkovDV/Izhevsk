 //КЗ - Итоговые суммы по организациям, которые не относятся к крупнейшим
 inc(wexrow); 
 MyxlSetCellStringValue('Прочие поставщики'          ,wexrow, 2,wexrow, 2);                                     
 if ((sumTot[0] - sumItg[0]) <> 0) { MyxlSetCellNumberValue(TochSum(sumTot[0] - sumItg[0]), wexrow,  9, wexrow,  9); }
