Fields
  ReportTip  ('Форма отчета'): [List 0 'Дебиторская/Кредиторская задолженность(Крупные суммы)'
                                    ,1 'Акт инвентаризации ИНВ-17'
                                    ,2 'Справка к акту инвентаризации ИНВ-17'
                                //  ,3 'Дебиторская и кредиторская задолженность контрагентов свыше 3-х лет'
                                    ,4 'Дебиторская и кредиторская задолженность контрагентов свыше 3-х лет' // 'Дебиторская и кредиторская задолженность с истекшим сроком исковой давности'
