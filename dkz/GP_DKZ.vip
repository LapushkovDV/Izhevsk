procedure GetDKZNastr;
var ts:string;
{
  _log('GetDKZNastr_0');
  if  getfirst jornTune = tsok then
  {
    delete all MemNastr;
    _log('GetDKZNastr_tsOk');
    _loop SpJorn
    {
     if spjorn.VIOB<>0 then continue;

     ClearBuffer(#MemNastr);

     set MemNastr.sch      := SpJorn.SCHET;
     set MemNastr.subsch   := SpJorn.SUBOSSCH;
     set MemNastr.TBLOS[1] := SpJorn.TBLOS[1];
     set MemNastr.TBLOS[2] := SpJorn.TBLOS[2];
     set MemNastr.TBLOS[3] := SpJorn.TBLOS[3];
     set MemNastr.TBLOS[4] := SpJorn.TBLOS[4];
     set MemNastr.TBLOS[5] := SpJorn.TBLOS[5];
     set MemNastr.TBLOS[6] := SpJorn.TBLOS[6];
     set MemNastr.kauos[1] := SpJorn.kauos[1];
     set MemNastr.kauos[2] := SpJorn.kauos[2];
     set MemNastr.kauos[3] := SpJorn.kauos[3];
     set MemNastr.kauos[4] := SpJorn.kauos[4];
     set MemNastr.kauos[5] := SpJorn.kauos[5];
     set MemNastr.kauos[6] := SpJorn.kauos[6];
     ts:=LPadCh(string(SpJorn.SeeSchet), '0', 3);
     set MemNastr.tip      := word(SubStr(ts,1,1));
     set MemNastr.dkz      := word(SubStr(ts,2,1));
     set MemNastr.saldo    := word(SubStr(ts,3,1));

     if getfirst spjornX where ((JornTune.nrec == SpJornX.cJornTune
                             and spjorn.wParam == SpJornX.wParam(NoIndex)
                             and (1=spjornx.VIOB)))   =tsok then
     {
         set MemNastr.schk      := SpJornX.SCHET;
         set MemNastr.subschk   := SpJornX.SUBOSSCH;
         set MemNastr.TBLkS[1] := SpJornx.TBLoS[1];
         set MemNastr.TBLkS[2] := SpJornx.TBLoS[2];
         set MemNastr.TBLkS[3] := SpJornx.TBLoS[3];
         set MemNastr.TBLkS[4] := SpJornx.TBLoS[4];
         set MemNastr.TBLkS[5] := SpJornx.TBLoS[5];
         set MemNastr.TBLkS[6] := SpJornx.TBLoS[6];
         set MemNastr.kauks[1] := SpJornx.kauos[1];
         set MemNastr.kauks[2] := SpJornx.kauos[2];
         set MemNastr.kauks[3] := SpJornx.kauos[3];
         set MemNastr.kauks[4] := SpJornx.kauos[4];
         set MemNastr.kauks[5] := SpJornx.kauos[5];
         set MemNastr.kauks[6] := SpJornx.kauos[6];
         ts:=LPadCh(string(SpJornX.SeeSchet), '0', 3);
         set MemNastr.tip      := word(SubStr(ts,1,1));
         set MemNastr.dkz      := word(SubStr(ts,2,1));
         set MemNastr.saldo    := word(SubStr(ts,3,1));

      }
      insert current MemNastr;
    }

  }
} //procedure GetDKZNastr;

