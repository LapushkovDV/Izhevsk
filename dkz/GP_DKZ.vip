{
 Result:=false;
 if MemNastr.kauos[i]=0 then Result:=true;
 else
  if oborot.kauos[i] = MemNastr.kauos[i] then Result:=true;
} //function  EnabledObKAUOS(i:word):boolean;

//================================
//
//--------------------------------
function  EnabledObKAUKS(i:word):boolean; // тут переворот происходит проводки для поиска кредитового сальдо
{
 Result:=false;
 if MemNastr.kauos[i]=0 then Result:=true;
 else
  if oborot.kauks[i] = MemNastr.kauos[i] then Result:=true;
} //function  EnabledObKAUKS(i:word):boolean; // тут переворот происходит проводки для поиска кредитового сальдо

//================================
//
//--------------------------------
procedure LoadGroup(_tip:word);
var i,j,k:word;fDoc:word;
{  
  for(i:=1;i<=6;i:=i+1)
  { a_gr[i]:='';
    a_cgr[i]:='0';
    a_wgr[i]:=0;
  }
  case _tip of
  0:
  { for(i:=1;i<=6;i:=i+1)
    { if JornTune.TblOs[i]=0 then Continue;
      for(j:=1;j<=6;j:=j+1)
      { if JornTune.TblOs[i] =wDKZ_D then
        { if (cgKau_katsopr=saldmoun.TblOs[j]) or
             (cgKau_plpor=saldmoun.TblOs[j])
          { a_gr[i]:=ShowKau(saldmoun.TblOs[j],saldmoun.kauOs[j]);
            a_cgr[i]:=saldmoun.kauOs[j];
            a_wgr[i]:=saldmoun.TblOs[j];
            fDoc:=j;
          }
        }
        else
        if JornTune.TblOs[i] =wDKZ_Sch then
        { a_gr[i]:=saldmoun.dbscheto;
          if getfirst buhschet where ((saldmoun.scheto == buhschet.schet and ''== buhschet.SUBSCH))=tsok
          {
           a_cgr[i]:=buhschet.nrec;
           a_wgr[i]:=wDKZ_Sch;
          }

        }
        else
        if JornTune.TblOs[i] =wDKZ_SubSch then
        { a_gr[i]:=saldmoun.subossch;
          if getfirst buhschet where ((saldmoun.scheto == buhschet.schet and saldmoun.subossch== buhschet.SUBSCH))=tsok
          {
           a_cgr[i]:=buhschet.nrec;
           a_wgr[i]:=wDKZ_SubSch;
          }
        }
        else
        if JornTune.TblOs[i] =wDKZ_SchSubSch then
        { a_gr[i]:=saldmoun.dbscheto+If(saldmoun.subossch<>'', '.'+saldmoun.subossch, '');
          if getfirst buhschet where ((saldmoun.scheto == buhschet.schet and saldmoun.subossch== buhschet.SUBSCH))=tsok
          {
           a_cgr[i]:=buhschet.nrec;
           a_wgr[i]:=wDKZ_SchSubSch;
          }          
        }
        else
        if JornTune.TblOs[i] =wDKZ_OrgSchSubSch then
        {           
          if getfirst buhschet where ((saldmoun.scheto == buhschet.schet and saldmoun.subossch== buhschet.SUBSCH))=tsok
          {           
            a_wgr[i] := wDKZ_OrgSchSubSch;                                             
            k        := GetNumKau(buhschet.kodTable, cgKau_KatOrg);
            If(k <> 0)
            {
              If(saldmoun.dbscheto = '76')
              {
                a_cgr[i] := saldmoun.kauOs[k]+'~'+buhschet.nrec;
                a_gr[i]  := ShowKau(cgKau_KatOrg, saldmoun.kauOs[k])+' '+saldmoun.dbscheto+If(saldmoun.subossch<>'', '.'+saldmoun.subossch, '');
              }
              else
              { 
                a_cgr[i] := saldmoun.kauOs[k]+'~'+0;
                a_gr[i]  := ShowKau(cgKau_KatOrg, saldmoun.kauOs[k]);
              }           
            } 
            Else
            {
              If(saldmoun.dbscheto = '76')
              {
                a_cgr[i] := 0+'~'+buhschet.nrec;
                a_gr[i]  := '???'+' '+saldmoun.dbscheto+If(saldmoun.subossch<>'', '.'+saldmoun.subossch, '');
              }
              else
              { 
                a_cgr[i] := 0+'~'+0;
                a_gr[i]  := '???';
              }           
            }
          }                    
        }
        else
        { if JornTune.TblOs[i]=saldmoun.TblOs[j] then
          {  a_gr[i]:=ShowKau(saldmoun.TblOs[j],saldmoun.kauOs[j]);
             a_cgr[i]:=saldmoun.kauOs[j];
             a_wgr[i]:=saldmoun.TblOs[j];
             break;
          }
        }
      } //for(j:=1;j<=6;j:=j+1)
      if Not((a_cgr[i]='')or(a_cgr[i]='0')) then continue;
      if JornTune.TblOs[i] =wDKZ_D then
      {
        //  А это уже другая история
      }
    }
  } //0
  1:
  {
    for(i:=1;i<=6;i:=i+1)
    {
        if JornTune.TblOs[i]=0 then Continue;

        if JornTune.TblOs[i] = wDKZ_D
        {
          if    (cgKau_katsopr =GetKauCode(oborot.tidkgal))
             or (cgKau_plpor   =GetKauCode(oborot.tidkgal))
          {
            a_gr[i]:=ShowKau(GetKauCode(oborot.tidkgal),oborot.csoprdoc);
            a_cgr[i]:=oborot.csoprdoc;
            a_wgr[i]:=GetKauCode(oborot.tidkgal);
          }        
          Else if(cgKau_BookPrZk=GetKauCode(oborot.tidkgal))
          {
            a_gr[i]  := GetBookPrZkName(oborot.csoprdoc);
            a_cgr[i] := oborot.csoprdoc;
            a_wgr[i] := GetKauCode(oborot.tidkgal);
          }                 
          Else if(cgKau_VedDeponir=GetKauCode(oborot.tidkgal))
          {
            a_gr[i]  := GetVedDeponirName(oborot.csoprdoc);
            a_cgr[i] := oborot.csoprdoc;
            a_wgr[i] := GetKauCode(oborot.tidkgal);
          }                 
        }
          
        for(j:=1;j<=6;j:=j+1)
          {
           if JornTune.TblOs[i] =wDKZ_D then
               {
                 if (cgKau_katsopr=oborot.TblOs[j]) or
                    (cgKau_plpor=oborot.TblOs[j])
                  {
                    a_gr[i]:=ShowKau(oborot.TblOs[j],oborot.kauOs[j]);
                    a_cgr[i]:=oborot.kauOs[j];
                    a_wgr[i]:=oborot.TblOs[j];
                  }
               }
               else
           if JornTune.TblOs[i] =wDKZ_Sch then
              {
                   a_gr[i]:=oborot.dbscheto;
                   if getfirst buhschet where ((oborot.scheto == buhschet.schet and ''== buhschet.SUBSCH))=tsok
                   {
                    a_cgr[i]:=buhschet.nrec;
                    a_wgr[i]:=wDKZ_Sch;
                   }
              }
              else
           if JornTune.TblOs[i] =wDKZ_SubSch then
              {
                   a_gr[i]:=oborot.subossch;
                   if getfirst buhschet where ((oborot.scheto == buhschet.schet and oborot.subossch== buhschet.SUBSCH))=tsok
                   {
                    a_cgr[i]:=buhschet.nrec;
                    a_wgr[i]:=wDKZ_SubSch;
                   }
              }
              else
           if JornTune.TblOs[i] =wDKZ_SchSubSch then
              {
                   a_gr[i]:=oborot.dbscheto+If(oborot.subossch<>'', '.'+oborot.subossch, '');
                   if getfirst buhschet where ((oborot.scheto == buhschet.schet and oborot.subossch== buhschet.SUBSCH))=tsok
                   {
                    a_cgr[i]:=buhschet.nrec;
                    a_wgr[i]:=wDKZ_SchSubSch;
                   }
              }
              else
           if JornTune.TblOs[i] =wDKZ_OrgSchSubSch then
              {
                   if getfirst buhschet where ((oborot.scheto == buhschet.schet and oborot.subossch== buhschet.SUBSCH))=tsok
                   {
                     a_wgr[i] := wDKZ_OrgSchSubSch;                     
                     k        := GetNumKau(buhschet.kodTable, cgKau_KatOrg);                   
                     If(k <> 0)
                     {
                       If(oborot.dbscheto = '76')
                       { 
                         a_cgr[i] := oborot.kauOs[k]+'~'+buhschet.nrec;                     
                         a_gr[i]  := ShowKau(cgKau_KatOrg, oborot.kauOs[k])+ ' '+oborot.dbscheto+If(oborot.subossch<>'', '.'+oborot.subossch, '');
                       }
                       else
                       {
                         a_cgr[i] := oborot.kauOs[k]+'~'+0;                     
                         a_gr[i]  := ShowKau(cgKau_KatOrg, oborot.kauOs[k]);
                       }                      
                     }                     
                     else
                     {
                       If(oborot.dbscheto = '76')
                       { 
                         a_cgr[i] := 0+'~'+buhschet.nrec;                     
                         a_gr[i]  := '???'+ ' '+oborot.dbscheto+If(oborot.subossch<>'', '.'+oborot.subossch, '');
                       }
                       else
                       {
                         a_cgr[i] := 0+'~'+0;                     
                         a_gr[i]  := '???';
                       }                      
                     }
                   }  
              }
              else
            {
            if JornTune.TblOs[i]=oborot.TblOs[j] then
             {
               a_gr[i]:=ShowKau(oborot.TblOs[j],oborot.kauOs[j]);
               a_cgr[i]:=oborot.kauOs[j];
               a_wgr[i]:=oborot.TblOs[j];
               break;
             }
            }
          }
        if Not((a_cgr[i]='')or(a_cgr[i]='0')) then continue;
        for(j:=1;j<=6;j:=j+1)
          {
           if JornTune.TblOs[i] =wDKZ_D then
               {
                 if (cgKau_katsopr=oborot.Tblks[j]) or
                    (cgKau_plpor=oborot.Tblks[j])
                 then
                  {
                    a_gr[i]:=ShowKau(oborot.Tblks[j],oborot.kauks[j]);
                    a_cgr[i]:=oborot.kauks[j];
                    a_wgr[i]:=oborot.Tblks[j];
                  }
               }
               else
           if JornTune.TblOs[i] =wDKZ_Sch then
              {
                   a_gr[i]:=oborot.krschetk;
                   if getfirst buhschet where ((oborot.schetk == buhschet.schet and ''== buhschet.SUBSCH))=tsok
                   {
                    a_cgr[i]:=buhschet.nrec;
                    a_wgr[i]:=wDKZ_Sch;
                   }
              }
              else
           if JornTune.TblOs[i] =wDKZ_SubSch then
              {
                   a_gr[i]:=oborot.SUBSCHK;
                   if getfirst buhschet where ((oborot.schetk == buhschet.schet and oborot.SUBSCHK== buhschet.SUBSCH))=tsok
                   {
                    a_cgr[i]:=buhschet.nrec;
                    a_wgr[i]:=wDKZ_SubSch;
                   }
              }
              else
           if JornTune.TblOs[i] =wDKZ_SchSubSch then
              {
                   a_gr[i]:=oborot.krschetk+If(oborot.SUBSCHK<>'', '.'+oborot.SUBSCHK, '');
                   if getfirst buhschet where ((oborot.schetk == buhschet.schet and oborot.SUBSCHK== buhschet.SUBSCH))=tsok
                   {
                    a_cgr[i]:=buhschet.nrec;
                    a_wgr[i]:=wDKZ_SchSubSch;
                   }
              }
              else
           if JornTune.TblOs[i] =wDKZ_OrgSchSubSch then
              {
                   if getfirst buhschet where ((oborot.schetk == buhschet.schet and oborot.SUBSCHK== buhschet.SUBSCH))=tsok
                   {
                     a_wgr[i] := wDKZ_OrgSchSubSch;                      
                     k        := GetNumKau(buhschet.kodTable, cgKau_KatOrg); 
                     If(k<>0)                     
                     {
                       If(oborot.krschetk = '76')
                       {
                         a_cgr[i] := oborot.kauks[k]+'~'+buhschet.nrec;                      
                         a_gr[i]  := ShowKau(cgKau_KatOrg, oborot.kauks[k])+ ' '+oborot.krschetk+If(oborot.SUBSCHK<>'', '.'+oborot.SUBSCHK, '');
                       }
                       Else
                       {
                         a_cgr[i] := oborot.kauks[k]+'~'+0;                      
                         a_gr[i]  := ShowKau(cgKau_KatOrg, oborot.kauks[k]);
                       }  
                     }
                     Else
                     {
                       If(oborot.krschetk = '76')
                       {
                         a_cgr[i] := 0+'~'+buhschet.nrec;                      
                         a_gr[i]  := '???'+' '+oborot.krschetk+If(oborot.SUBSCHK<>'', '.'+oborot.SUBSCHK, '');
                       }
                       Else
                       {
                         a_cgr[i] := 0+'~'+0;                      
                         a_gr[i]  := '???';
                       }  
                     }
                   } 
              }
/*              
              else
            {
            if JornTune.TblOs[i]=oborot.Tblks[j] then
             {
               a_gr[i]:=ShowKau(oborot.Tblks[j],oborot.kauks[j]);
               a_cgr[i]:=oborot.kauks[j];
               a_wgr[i]:=oborot.Tblks[j];
               break;
             }
            }
*/            
          }
         if Not((a_cgr[i]='')or(a_cgr[i]='0')) then continue;
         if JornTune.TblOs[i] =wDKZ_D then
          {
               a_gr[i]:=ShowKau(GetKauCode(oborot.tidkgal),oborot.csoprdoc);
               a_cgr[i]:=if(a_gr[i]='',0,oborot.csoprdoc);
               a_wgr[i]:=GetKauCode(oborot.tidkgal);
          }
    }
  } //1
  2:
  { for(i:=1;i<=6;i:=i+1)
    { 
      if JornTune.TblOs[i]=0 then Continue;
      
      if JornTune.TblOs[i] = wDKZ_D
      {
        if    (cgKau_katsopr=GetKauCode(oborot.tidkgal))
           or (cgKau_plpor  =GetKauCode(oborot.tidkgal))
        {
          a_gr[i]:=ShowKau(GetKauCode(oborot.tidkgal),oborot.csoprdoc);
          a_cgr[i]:=oborot.csoprdoc;
          a_wgr[i]:=GetKauCode(oborot.tidkgal);
        }        
        Else if(cgKau_BookPrZk=GetKauCode(oborot.tidkgal))
        {
          a_gr[i]  := GetBookPrZkName(oborot.csoprdoc);
          a_cgr[i] := oborot.csoprdoc;
          a_wgr[i] := GetKauCode(oborot.tidkgal);
        }               
        Else if(cgKau_VedDeponir=GetKauCode(oborot.tidkgal))
        {
          a_gr[i]  := GetVedDeponirName(oborot.csoprdoc);
          a_cgr[i] := oborot.csoprdoc;
          a_wgr[i] := GetKauCode(oborot.tidkgal);
        }               
      }
                  
      for(j:=1;j<=6;j:=j+1)
      { if JornTune.TblOs[i] =wDKZ_D then
        { if (cgKau_katsopr=oborot.Tblks[j]) or
             (cgKau_plpor=oborot.Tblks[j])
          {  a_gr[i]:=ShowKau(oborot.Tblks[j],oborot.kauks[j]);
             a_cgr[i]:=oborot.kauks[j];
             a_wgr[i]:=oborot.Tblks[j];
          }
        }
        else
        if JornTune.TblOs[i] =wDKZ_Sch then
        { a_gr[i]:=oborot.krschetk;
          if getfirst buhschet where ((oborot.schetk == buhschet.schet and ''== buhschet.SUBSCH))=tsok
          {
           a_cgr[i]:=buhschet.nrec;
           a_wgr[i]:=wDKZ_Sch;
          }
        }
        else
        if JornTune.TblOs[i] =wDKZ_SubSch then
        { a_gr[i]:=oborot.SUBSCHK;
          if getfirst buhschet where ((oborot.schetk == buhschet.schet and oborot.SUBSCHK== buhschet.SUBSCH))=tsok
          { a_cgr[i]:=buhschet.nrec;
            a_wgr[i]:=wDKZ_SubSch;
          }
        }
        else
        if JornTune.TblOs[i] =wDKZ_SchSubSch then
        { a_gr[i]:=oborot.krschetk+If(oborot.SUBSCHK<>'', '.'+oborot.SUBSCHK, '');
          if getfirst buhschet where ((oborot.schetk == buhschet.schet and oborot.SUBSCHK== buhschet.SUBSCH))=tsok
          { a_cgr[i]:=buhschet.nrec;
            a_wgr[i]:=wDKZ_SchSubSch;
          }
        }
        else
        if JornTune.TblOs[i] =wDKZ_OrgSchSubSch then
        { 
          if getfirst buhschet where ((oborot.schetk == buhschet.schet and oborot.SUBSCHK== buhschet.SUBSCH))=tsok
          {          
            a_wgr[i] := wDKZ_OrgSchSubSch;                       
            k        := GetNumKau(buhschet.kodTable, cgKau_KatOrg);
            If(k<>0)           
            { 
              If(oborot.krschetk = '76')
              {
                a_cgr[i] := oborot.kauks[k]+'~'+buhschet.nrec;            
                a_gr[i]  := ShowKau(cgKau_KatOrg, oborot.kauks[k])+' '+oborot.krschetk+If(oborot.SUBSCHK<>'', '.'+oborot.SUBSCHK, '');
              } 
              else
              {
                a_cgr[i] := oborot.kauks[k]+'~'+0;
                a_gr[i]  := ShowKau(cgKau_KatOrg, oborot.kauks[k]);
              }
            }
            Else
            {
              If(oborot.krschetk = '76')
              {
                a_cgr[i] := 0+'~'+buhschet.nrec;            
                a_gr[i]  := '???'+' '+oborot.krschetk+If(oborot.SUBSCHK<>'', '.'+oborot.SUBSCHK, '');
              } 
              else
              {
                a_cgr[i] := 0+'~'+0;            
                a_gr[i]  := '???';
              }
            }
