/*************************************************************************************************\
* Наименование: Обработка настроек с вызовом интерфейсов в компонентах                            *
* Контур/Модуль: Логистика                                                                        *
* Примечание:                                                                                     *
*                                                                                                 *
\*************************************************************************************************/

#include TuneSpec.vih
#include GetKau.vih
#include PickBuh.vih


#component "GP"
VipInterface GP_IntrTune_prices4period implements ObjIntrTuneComponent #Licensed_Free ;

// Обработчик точки расширения epIntrTuneComponent
// Должен вернуть FALSE если обработка проводилась. TRUE - если не проводилась.
handler with replace GP_IntrTune_prices4period on extensionPoint epIntrTuneComponent (TR: objTuneIntr; TVal: TTuneVal; Inter: string)
action
{
   var ifc : GP_IntrTune_prices4period;
   result := not ifc.TuneIntrComponent (TR, TVal, Inter);
}

#doc
 обработчики настроек
#end
//-----------------------------------
Interface GP_IntrTune_prices4period;
//-----------------------------------
#include ShowKau.Vpp
//-----------------------------------
#include GetKau.var
var
 Markers:tPtr;
 KAuMarkerName:string;
 wStr:string;
 j:longint;

Create view
 var
  wc_GroupMC :comp;
  as select KATLINK.nrec
 from
   KATLINK
 , groupmc
;

// Обязательно должна вернуть False если обработка не производилась, иначе true
Public Function TuneIntrComponent (TR: objTuneIntr; TVal: TTuneVal; Inter: string) : boolean;
{
  Var PrOk : boolean;  PrOk := False;

  TuneIntrComponent := true; // Чтобы в каждом case не писать это

  case UpCase(Inter) of
   'CHOOSE_GROUP_MC_EXCLUDE'://не пересчитывать средневзвешенные цены по данным группам
  {  Markers:=InitMarker('', 8, 200, 10);
     ClearMArker(Markers);

     var _Code:word=0;

     _loop KATLINK where ((      coGroupMC == KATLINK.CODETABLE
             and 'CHOOSE_GROUP_MC_EXCLUDE' == KATLINK.OWNNAME)) {
          InsertMarker(Markers, KATLINK.CREC);
        }

     KauMarkerName := iGetKau.GetMarkerName(cgKau_GroupMC);
     DoneMarker(Markers,KauMarkerName);

     If (iGetKau.GetCodeKau(cgiPickMult+cgiNotClear,cgKau_GroupMC,Comp(0)) <> 0) {
       Markers := InitMarker(KauMarkerName, 8, 50, 10);
       wstr:='';
       delete KATLINK where ((coGroupMC == KATLINK.CODETABLE
          and 'CHOOSE_GROUP_MC_EXCLUDE' == KATLINK.OWNNAME));

       TVal.CompVal:=0;

       for (j := 0; j < GetMarkerCount(Markers); j++) {
         if GetMarker(Markers, j, wc_GroupMC)
           if getfirst GroupMC where ((wc_GroupMC == groupmc.nrec)) = tsOK {
             insert into katLink  set
                KATLINK.CODETABLE:=coGroupMC
               ,KATLINK.OWNNAME  :='CHOOSE_GROUP_MC_EXCLUDE'
               ,KATLINK.CREC     :=GroupMC.Nrec
               ,KATLINK.Name     :=GroupMC.Name
               ,KatLink.Code     :=_Code //GroupMC.Kod
               ,KATLINK.CUSER    :=TVal.cUser
               ;
             wstr:=wstr+GroupMC.Kod+';';
             if j=0
               TVal.CompVal:=wc_GroupMC;
           }
       }//for (j := 0; j < GetMarkerCount(Markers); j++)
       TVal.strVal:=wstr;
       PrOk := true;
       DoneMarker(Markers,'')
     } //If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Persons,Comp(0)) <> 0)
  }
  else
    TuneIntrComponent := false;  // Если не зашли в обработку, то обязательно установим в false
  end;  // case

  if (PrOk)
    TR.UpdateTuneVal(TVal);
}     // TuneIntrComponent
end. // интерфейс
