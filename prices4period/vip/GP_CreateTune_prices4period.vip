#include CreateTune.vih

Handler with replace GP_prices4period_CreateTune on extensionPoint
  epCreateTuneComponent (TR: ObjCreateTuneEx) [205]
Action
{
  Result := true;
  TR.SetComponent('GP');
  // ------------------------------------------------------------------------
  TR.SetParent('Tune');
  TR.AddPartA('AVTOVAZ','АвтоВАЗ','');

  TR.SetParent('AVTOVAZ');


  TR.AddPartA('PRICES4PERIOD','Средневзвешенные цены','');
  TR.SetParent('PRICES4PERIOD');
  TR.AddTuneS('PRICES4PERIOD.GROUPMCEXCLUDE', 'Группы МЦ, исключаемые из пересчета', ftCompString,'','','');
     TR.AddIntr('CHOOSE_GROUP_MC_EXCLUDE');
}
