#include Query.vih
#include SaldoFuncs.vih
#include modifOrd.vih
#include ModifOrd.var
#include MTRFuncs.vih
#include SHManager.vih

#component "L_SaldoMTR"

interface prices4period_recalc 'Расчет средних цен МЦ', EscClose;
show at (,,60,13);

Table Struct tModifsDocs (
   wTable : word
 , cRec   : comp
)
with index (
 ind = wTable + cRec
)
;

table struct tTempMC (
   nRec     : comp
 , cRec     : comp
 , cMc      : comp
 , kol_ost    : double
 , sum_ost    : double
 , kol_prihod : double
 , sum_prihod : double
 , cSpOrder : comp
)
with index (
   ind0 = Nrec (unique, surrogate)
 , ind1 = cRec
 , ind2 = cMc
);

table struct tMoveMC (
   cMc      : comp
 , cSpOrder : comp
)
with index (
 index0 = cMc
);

//************************ Вьюха  *************************
create view
 var
    iMTRFun         : MTRFuncs;
    iSHoz           : SHmanager;
     cur_mc : comp = 0h;
     iSaldoFun : SaldoFuncs;
       DatBeg
     , DatEnd : date;
       _katmc
     , _log : string;
       _vibrano
     , _i
     , _izmenenoRash
     , _izmenenoVnutr
     , _izmenenoPrih
     , _izmenenoMontaj : longint;
       isProverka
     , isShowNewPrices : byte;
     _tekMonth : date;
as select
  if ( SPO_br.VidOrder = 0, 'П', 'Р')
    ( Fieldname = VidOper )
, if ( SklOrder_br.TipOrd = 1,
      if ( NOT IsValid(tnKatSopr_br), 'К',
                if (KatSopr_br.vidSopr = 611, 'В',
                        if ( ((KatSopr_br.vidSopr >= 101) and (KatSopr_br.vidSopr <= 106) or (KatSopr_br.vidSopr =  108) or
                              (KatSopr_br.vidSopr >= 201) and (KatSopr_br.vidSopr <= 206) or
                              (KatSopr_br.vidSopr >= 210) and (KatSopr_br.vidSopr <= 229) or
                              (KatSopr_br.vidSopr >= 521) and (KatSopr_br.vidSopr <= 522) or
                              (KatSopr_br.vidSopr  = 626) or  (KatSopr_br.vidSopr  = 636)), 'К', '*'))),
    if (SPO_br.TipOrd = 2, 'П',
      if (SPO_br.TipOrd = 3, 'В',
        if (SPO_br.TipOrd>= 4 and SPO_br.TipOrd<= 7, 'Д', '*'))))
    ( Fieldname = TipOper )
, if ( SklOrder_br.vidOrder = 0, ColorSklModulKSU2, ColorSklModulKSU3 )
    ( Fieldname = ColorVidOrder )
, if((wGetTune('Oper.FormatNamePodrMOL') = 0), KatMOL.Name, KatMOL.Kod + ' - ' + KatMOL.Name)
    ( FieldName = KatMOL1_Name )
//------------------------------------------------------------------------------
, if((wGetTune('Oper.FormatNamePodrMOL') = 0), KatPodr.Name, KatPodr.Kod + ' - ' + KatPodr.Name)
    ( FieldName = katpodr1_name )

 from
    Pick
  , KatMc MC_br
  , KatMc KatMc_check_group
  , SaldoMc
  , sOPRhOZ
  , tmpSaldo1
  , SpOrder SpOrder_SetPrice
  , SpOrder SpOrder_loop
  , SpOrder SPO_BR
  , SklOrder SklOrder_br
  , KatPodr
  , KatMOL
  , KatParty
  , KatSopr KatSopr_br
  , KATLINK
  , SpecMtr
  , SpOrder
  , SklOrder
  , KatMc
  , tTempMC
  , tTempMC tTempMC_br
  , tTempMC tTempMC_func
  , tMoveMC
  , tMoveMC tMoveMC_loop
  , tModifsDocs
 Where ((
        tMoveMC_loop.cSpOrder == SpOrder_loop.nrec
                  and  cur_mc == tTempMC_br.crec
           and tTempMC_br.cmc == MC_br.nrec
      and tTempMC_br.cSpOrder == SPO_br.nrec
      and    SPO_br.cSklOrder == SklOrder_br.NRec
      and   SklOrder_br.cSopr == KatSopr_br.NRec
      and       SPO_br.ccPodr == KatPodr.NRec
      and        SPO_br.ccMol == KatMOL.NRec
      and       SPO_br.cParty == KatParty.NRec

 ))
//order by MC_br.name, SklOrder_br.dOrd
 ;
Procedure MyLog(_str: string); {
  if isProverka = 1 then
    LogStrToFile(_log,DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS')  + ':'+_str);
}
Procedure MysqlAddStr(var query_handle : tptr; add_query_str: string); {
   sqlAddStr(query_handle, add_query_str);
   MyLog('sql: ' + add_query_str);
} //Function MysqlAddStr(var query_handle: longInt; add_query_str: string): longInt;

function isGroupMcNeedRecalc(_cGroupMC : comp) : boolean; cacheable; {
  result := true;
   if getfirst KATLINK where (( 'CHOOSE_GROUP_MC_EXCLUDE' == KATLINK.OWNNAME
                                           and _cGroupMC  == KATLINK.CREC (noindex))) = tsOK then result := false;
}

function FillMCFiltrTable : boolean; {
  result := true;

  if getfirst pick where ((cgPick_MC == Pick.wList)) <> tsOK {
     SetVisualHeader('Заполняем таблицу-фильтр по ТМЦ с учетом исключаемых групп');
    _loop KatMc_check_group { // нафиг все общие пересчеты... заполним сразу PICK с учетом исключаемых групп
      if isGroupMcNeedRecalc(KatMc_check_group.cGroupMc) then {
       insert Pick set
           Pick.wList := cgPick_MC
         , Pick.cRec  := KatMc_check_group.Nrec
        ;
      }
    }
  }

 var _ii : longint = 0;
  _loop pick where ((cgPick_MC == Pick.wList)) _ii++;

 StartNewVisual(vtIndicatorVisual ,vfTimer,'Заполнение таблицы-фильтра по ТМЦ',_ii);

  result := false;
  var strID : tptr;  strID   := 0;
  sqlFreeStr(strID);
  strID:=0;
  sqlAddStr(strID, 'table tblFiltrTMC_RECACL');
  sqlAddStr(strID, '(                  ');
  sqlAddStr(strID, ' cMc: comp        ');
  sqlAddStr(strID, ')                  ');
  sqlAddStr(strID, 'with index         ');
  sqlAddStr(strID, '(                  ');
  sqlAddStr(strID, ' a0 = cMc         ');
  sqlAddStr(strID, ');                 ');
  sqlDropTmpTable('tblFiltrTMC_RECACL');
  if sqlCreateTmpTable(strID, ctmNormal) = tsOk {
    result := true;
  }
  if result {
  _loop pick where ((cgPick_MC == Pick.wList)) {
    nextvisual
        if getfirst KatMc_check_group where ((Pick.cRec == KatMc_check_group.nrec)) = tsOK {
         if not isGroupMcNeedRecalc(KatMc_check_group.cGroupMc) {
               delete current Pick;
           } else {
              var _sqlstr : string =   'INSERT INTO tblFiltrTMC_RECACL (cMc) VALUES (' + ' #comp(' + string(Pick.cRec) + '))';
              sqlExecDirect(_sqlstr);
            }
        }
        //mylog('sql :' + _sqlstr);
   }
  }
  stopvisual('',0);
  if getfirst pick where ((cgPick_MC == Pick.wList)) <> tsok then result := false; // нет МЦ для пересчета, считать нечего
}
function PricePlanRecalc(_cMc : comp) : double; cacheable;{
  result := 0;
  if getfirst tTempMC_func where ((_cMc == tTempMC_func.cmc)) = tsOK {
     result := (tTempMC_func.sum_ost + tTempMC_func.sum_prihod) / (tTempMC_func.kol_ost + tTempMC_func.kol_prihod);
  }
}

procedure createDoocenka; {
  StartNewVisual(vtRotateVisual ,vfTimer,'Удаление предыдуших дооценочных ордеров',0);
  var _i : longint = 0;
  _loop sklorder where (( 0 == sklorder.SP
                      and 0 == sklorder.VIDORDER
                      and 4 == sklorder.TIPORD
                 and DatEnd == sklorder.DORD
             and 'DOOCENKA' == sklorder.NORDER (noindex) )) {
       _loop SpOrder where ((sklorder.NREC == SpOrder.cSklOrder)) {
          if getfirst pick where ((cgPick_MC == Pick.wList)) <> tsok // если нет фильтра
              or
             getfirst pick where ((cgPick_MC == Pick.wList and SpOrder.cmc == Pick.cRec)) = tsok { // если фильтр есть, то проверяем, что МЦ в нем
              iMTRFun.DelSpecMTR(coSpOrder, SpOrder.nrec);
              oModifOrds.AnySpOrder_Delete(TypeSpOrder(SpOrder.buffer));
          }
       }
       if getfirst SpOrder where ((sklorder.NREC == SpOrder.cSklOrder)) <> tsok then {
        If(GetFirst FastFirstRow SoprHoz Where((sklorder.Nrec == SoprHoz.cSoprDoc And 150 == SoprHoz.TipDoc)) = TsOk) {
          iSHoz.DelByHan(SoprHoz.BufferP);
         }
         Delete current sklorder;
        }
      _i++;
      if _i mod 23 = 0 then { //  чтобы не тормозила перерисовка визуализации
         setVisualHeader('Удаление предыдуших дооценочных ордеров' +
                       ''#13'' + string(_i));
      }
    }
 StopVisual('The End',vfTimer);

 StartNewVisual(vtRotateVisual ,vfTimer,'Расчет сальдо на конец периода',0);
  delete all tmpSaldo1;
          iSaldoFun.Store_Run_New( // хрен зате куда пропала фнкция это .. Store_run_new_ex
                                   DatEnd
                                 , true //складские остатки
                                 , false //производственные
                                 , False
                                 , False
                                 , -2 //МЦ - будут браться из PICK по крайней мере в Store_run_new_ex брались
                                 , 0h //склад
                                 , 0h //МОЛ
                                 , 0h //группам партий и партиям
                                 , true // выгружать остатки по МТР
                                 , 000100000000000Ah  //фильтр по ЦУ: ЦУ ЛИ,
                                 , 000100000000061Ch  //фильтр по ЦУ: вид собственности = Собственные
                                 , true  // группировать по складам
                                 , true  // группировать по МОЛ
                                 , true  // группировать по партиям
                                 , True  // bIncZeroKol  - вдруг списали количество, а цена осталась
                                 );
           StartNewVisual(vtIndicatorVisual ,vfTimer,'Просмотр остатков по ТМЦ, формирование дооценочных ордеров',RecordsInTable(tnTmpSaldo1));
           MyLog('Формирование дооценки');
           _loop TmpSaldo1 {
             if getfirst katmc where ((TmpSaldo1.CMC == katmc.nrec)) <> tsok then continue;
             if getfirst katpodr where ((tmpsaldo1.CPODR == katpodr.nrec)) <> tsOK then continue;

              nextvisual;

              MyLog('katpodr.kod = ' + katpodr.kod + ' barkod = ' + katmc.barkod + ' TmpSaldo1.kol = ' + string(TmpSaldo1.kol)+' TmpSaldo1.PRICE = ' + string(TmpSaldo1.PRICE) + ' PricePlanRecalc = ' + string(PricePlanRecalc(TmpSaldo1.CMC)));
              if TmpSaldo1.PRICE <> PricePlanRecalc(TmpSaldo1.CMC) {
                var _SumDoocenka : double = if(TmpSaldo1.kol = 0,1,TmpSaldo1.kol)*(PricePlanRecalc(TmpSaldo1.CMC) - TmpSaldo1.PRICE); //вдруг списали количество, а цена осталась
                mylog('   _SumDoocenka = ' + string(_SumDoocenka));
                if _SumDoocenka = 0 then continue;
                insert sklorder set
                   sklorder.DESCR   :=  sgettune('USER.DESCR')
                 , sklorder.DESGR   :=  sgettune('USER.DESGR')
                 , sklorder.NORDER  := 'DOOCENKA'
                 , sklorder.CPODR   := tmpsaldo1.CPODR
                 , sklorder.CMOL    := tmpsaldo1.CMOL
                 , sklorder.DORD    := DatEnd
                 , sklorder.YEARORD := year(DatEnd  )
                 , sklorder.TIPORD  := 4
                ;
                insert tModifsDocs set
                    tModifsDocs.wTable := coSklOrder
                  , tModifsDocs.cRec := SklOrder.nrec
                 ;
                // добавить данный документ в список для последубщей обработки ТХО
                clearbuffer(tnsporder);
                 sporder.DESCR     := sklorder.DESCR;
                 sporder.DESGR     := sklorder.DESGR;
                 sporder.CSKLORDER := sklorder.nrec ;
                 sporder.DORD      := sklorder.DORD ;
                 sporder.NPP       := 1             ;
                 sporder.TIPORD    := 4             ;
                 sporder.CMC       := tmpsaldo1.CMC ;
                 sporder.CPARTY    := tmpsaldo1.CPARTY;
                 sporder.SRPRICE   := _SumDoocenka    ;
                 sporder.RSRPRICE  := _SumDoocenka    ;
                 sporder.CCPODR    := sklorder.CPODR  ;
                 sporder.CCMOL     := sklorder.CMOL   ;
                 sporder.EMPTY     := 4               ;
                oModifOrds.AnySpOrder_insert(TypeSpOrder(SpOrder.buffer));

                clearbuffer(tnSpecmtr);
                 Specmtr.COTABLE   := coSpOrder        ;
                 Specmtr.CSPEC     := SpOrder.nrec     ;
                 Specmtr.CSALDTUNE := 000100000000000Ah;  //ЦУ ЛИ,
                 Specmtr.COBJ      := 000100000000061Ch;  //вид собственности = Собственные
                 Specmtr.CKAU[1]   := tmpsaldo1.CKAU[1];
                 Specmtr.CKAU[2]   := tmpsaldo1.CKAU[2];
                 Specmtr.CKAU[3]   := tmpsaldo1.CKAU[3];
                 Specmtr.CKAU[4]   := tmpsaldo1.CKAU[4];
                 Specmtr.CKAU[5]   := tmpsaldo1.CKAU[5];
                 Specmtr.CKAU[6]   := tmpsaldo1.CKAU[6];
                 Specmtr.CKAU[7]   := tmpsaldo1.CKAU[7];
                 Specmtr.CKAU[8]   := tmpsaldo1.CKAU[8];
                 Specmtr.CKAU[9]   := tmpsaldo1.CKAU[9];

               iMTRFun.InsUpdRec(SpecMTR.buffer);
               oModifOrds.AnySpOrder_update(TypeSpOrder(SpOrder.buffer));

                 ClearBuffer(tnSoprHoz);
                  SoprHoz.FilialNo := lGetTune('Konsolid.FilialNo');
                  SoprHoz.Direct   := 1;
                  SoprHoz.Descr    := SklOrder.Descr;
                  SoprHoz.DesGr    := SklOrder.DesGr;
                  SoprHoz.DatOb    := SklOrder.dOrd;
                  SoprHoz.NoDoc    := SklOrder.NOrder;
                  SoprHoz.TipDoc   := word(150);
                  SoprHoz.TiDkGal  := word(150);
                  SoprHoz.cSoprDoc := SklOrder.NRec;
                  SoprHoz.Summa    := SpOrder.SrPrice;
                  SoprHoz.SummaSp  := SpOrder.SrPrice;
                  iSHoz.InsByHan(SoprHoz.BufferP);
              }
            }
  StopVisual('The End',vfTimer);
  StopVisual('The End',vfTimer);

}

procedure setnewPrices; {
 StartNewVisual(vtIndicatorVisual, vfTimer, 'Установка цен',recordsintable(tntTempMC));
 delete all tModifsDocs;
    _loop tTempMC where tTempMC.cSpOrder <> 0h {
      nextvisual;
       if getfirst fastfirstrow SpOrder_SetPrice where ((tTempMC.cSpOrder == SpOrder_SetPrice.nrec)) = tsOK {
         if not (SpOrder_SetPrice.SP = 0          // склад
             and SpOrder_SetPrice.VIDORDER = 0    // приходный
             and ( SpOrder_SetPrice.TIPORD = 1    // внешние операции
                or SpOrder_SetPrice.TIPORD = 2) ) {

            if SpOrder_SetPrice.RSRPRICE <> PricePlanRecalc(SpOrder_SetPrice.cMc) then {
               //update Current SpOrder_SetPrice Set
                SpOrder_SetPrice.RSRPRICE := PricePlanRecalc(SpOrder_SetPrice.cMc);
                SpOrder_SetPrice.SRPRICE  := Round(PricePlanRecalc(SpOrder_SetPrice.cMc),2);
               oModifOrds.AnySpOrder_UpDate(TypeSpOrder(SpOrder_SetPrice.buffer))

             if getfirst SklOrder where ((SpOrder_SetPrice.cSklOrder == SklOrder.nrec)) = tsOK {
                  insert tModifsDocs set
                    tModifsDocs.wTable := coKatSopr
                  , tModifsDocs.cRec   := sklorder.CSOPR
                 ;
              }
           }
         }
       }
    }
 StopVisual('The End',vfTimer);
 createDoocenka;
 myLog('Список измененных документов');
 _loop tModifsDocs {
   myLog(string(tModifsDocs.wTable) + ' ' + string(tModifsDocs.cRec,0,0));
 }
}
SCREEN PROJ5;
  Fields
   _tekMonth : ['DD/MM/YYYY'],NoProtect;
   DatBeg : ['DD/MM/YYYY'],NOprotect;
   DatEnd : ['DD/MM/YYYY'],NOprotect;
   _katmc  : Protect, PickButton;
   isProverka :NOprotect;
   isShowNewPrices :NOprotect;
 Buttons
  cmNewMonth,,,'Начать обновление';
  cmOK,,,'Начать обновление';
  cmCancel,,,'Отмена';
 << 'Пересчет сальдо за период по МЦ'

  .@@@@@@@@@  <. Установить новый период  .>

 Период с .@@@@@@@@@@ по .@@@@@@@@@@
   МЦ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  [.] - показывать лог запроса`

  [.] - показывать список ТМЦ с новыми ценами перед пересчетом`

Будут пересчитаны средние цены за период

 <.   Начать  .>          <.   Отмена   .>
>>
END;

window winBrowseMC '';
tree trBrowseMC 'Список найденных МЦ и ордеров для установки цены';
  table tTempMC_br;
fields
  MC_br.name            'Наименование МЦ' ('Наименование МЦ'): [35], protect, noPickButton;
  MC_br.barkod          'Баркод МЦ' ('Баркод МЦ'): [10], protect, noPickButton;
  tTempMC_br.kol_ost    'Остаток','кол-во' ('остаток по МЦ количество'): [10], protect, noPickButton;
  tTempMC_br.sum_ost    'Остаток','сумма' ('остаток по МЦ сумма'): [10], protect, noPickButton;
  tTempMC_br.kol_prihod 'Приход','кол-во' ('приход по МЦ количество'): [10], protect, noPickButton;
  tTempMC_br.sum_prihod 'Приход','сумма' ('приход по МЦ сумма'): [10], protect, noPickButton;
  VidOper        'П'('Приход/расход')
                : [1], noPickButton,Protect, NoAutoSize, Centered,
                 { Font = {Color = ColorVidOrder; Bold = TRUE}};
//------------------------------------------------------------------------------
  TipOper        'Т'('Тип операции: К-внешняя, П-производство, В-внутренняя, Д-переоценка, *-прочие', , )
                : [1], noPickButton,Protect, NoAutoSize, Centered;

  SklOrder_br.DesGr 'Группа' : [5], Protect, NoAutoSize, noPickButton;
  SPO_BR.Descr  'Дескр' : [5], Protect, NoAutoSize, noPickButton;
  SklOrder_br.NOrder 'Номер': [6], Protect, NoAutoSize, noPickButton,{ Font = {BackColor = if (SklOrder_br.NOrder = '', ColorNeed, 0)}};
  SklOrder_br.dOrd  'Дата' : [10], Protect, NoAutoSize, noPickButton,Centered, { Font = {BackColor = if (Longint(SklOrder_br.dOrd) = Longint(0), ColorNeed, 0)}};
  katpodr1_name   'Подразделение' : [15], Protect, noPickButton, { Font = {BackColor = if (not IsValid(#KatPodr), ColorNeed, 0)}};
  KatMOL1_Name    'МОЛ' : [15], Protect, noPickButton;
  KatParty.KOD   'Партия', 'код' : [5], Protect, noPickButton;
  KatParty.Name  'Партия', 'наименование' : [15], noPickButton,Protect;
  SPO_BR.Kol    'Количество' (, , sci134EnEsc) : [12], [prSignsInKol, '\3p[|-]36`666`666`666`666.888'], NoAutoSize, EditButton, { Font = {Color = ColorVidOrder}}, noPickButton;
  SPO_BR.rSrPrice 'Цена' : [17], [brForSpOrder_Price, '\2p[|-]36`666`666`666`666.88'], NoAutoSize, noPickButton;
  PricePlanRecalc(MC_br.nrec) 'Цена','после пересчета' : [17], [brForSpOrder_Price, '\2p[|-]36`666`666`666`666.88'], NoAutoSize, noPickButton;
end;
end;
windowevent winBrowseMC;
  cmHotKeys: {
     case curtable of
      tntTempMC_br: PutHotCommand(RunMenu('Price4PeriodRecalc_HotKeys'));
     end;
    }
  cmValue1 : {
    setnewPrices;
    message('Цены установлены');
    closewindow(winBrowseMC);
  }

end;

TableEvent table tTempMC_br;
cmTreeTop:  {
     cur_mc := 0;
}
cmTreeDown: {
     cur_mc := tTempMC_br.NRec;
}
cmTreeUp:   {
     cur_mc := tTempMC_br.cRec;
}
cmTreeNodeType:{
  if (TreeIsTerminal(trBrowseMC)) TreeSetNodeType(trBrowseMC,   2);
}
end;
//------------------------------------------------------------------------------
// Инициализация главного окна
//------------------------------------------------------------------------------
Handleevent
cmInit: {
 //RunInterFace(L_SKLAD::COUNTSAL);
 _tekMonth := dGetTuneEx  ('TEKMONTH', 1, UserId );
 delete pick where ((cgPick_MC == Pick.wList));
 _katmc := '--все МЦ--';
  ReadMyDsk(DatBeg,'prices4period_recalc_DatBeg',false);
  ReadMyDsk(DatEnd,'prices4period_recalc_DatEnd',false);
// wSetTuneEx('PICK.SORTMC',1,UserID,_nastr)
}
cmNewMonth:
{
 if dGetTuneEx('TEKMONTH', 1, UserId ) > _tekMonth
  then
    {
     dSetTuneEx('TEKMONTH', 1, UserId, _tekMonth);
     Insert SaldoMc set dsaldo := _tekMonth;
    }
    else
     {
      Message('Новый период должен быть позже текущего');
      _tekMonth := dGetTuneEx('TEKMONTH', 1, UserId )
     }
}
cmDelOnProtect:{
 case curfield of
  #_katmc : {
      delete pick where ((cgPick_MC == Pick.wList));
      _katmc := '--все МЦ--';
   }
 end;
}
cmPick:
{
  case curfield of
  #_katmc : {
      RunInterFace(L_MCU::GETSOMEMC,-12345); // -12345 : не запрашивать кол-во
      _vibrano := 0;
       StartNewVisual(vtRotateVisual, vfTimer, 'Подсчет выбранного количества',1);
       _loop pick where ((cgPick_MC == Pick.wList)){
         setVisualHeader('Подсчет выбранного количества ' + _vibrano);
         _vibrano++
        }
       StopVisual('The End',vfTimer);
       _katmc := ' выбрано ' + _vibrano
   }
   end;
}
cmOK:
{

/*
 if getfirst pick where ((cgPick_MC == Pick.wList)) <> tsok {
   message('Не выбраны ТМЦ', error);
   stop; abort; exit;
 }
*/


  SaveMyDsk(DatBeg,'prices4period_recalc_DatBeg');
  SaveMyDsk(DatEnd,'prices4period_recalc_DatEnd');


 if DatBeg = to_date(0,0,0) {
   message('Дата начала расчета не может быть пустой', error);
   stop; abort; exit;
 }
 if DatEnd = to_date(0,0,0) {
   message('Дата окончания расчета не может быть пустой', error);
   stop; abort; exit;
 }
 if DatBeg > DatEnd {
   message('Дата начала расчета не может быть больше даты окончания пустой', error);
   stop; abort; exit;
 }


 StartNewVisual(vtRotateVisual, vfTimer, '',1);
   MyLog('Пересчет средних цен за период с ' + datetostr(datBeg,'DD.MM.YYYY') + ' по ' + datetostr(DatEnd,'DD.MM.YYYY'));
   MyLog('  по ' + _katmc + ' МЦ');
   MyLog('Начало ' + Cur_Time);

 _log := GetStringParameter('Files','OutputFilesDirectory',0) + '\prices4period_recalc'+'_'+DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS-SSS')+'.txt';

_izmenenoPrih := _izmenenoRash:= _izmenenoVnutr :=_izmenenoMontaj := 0;

 if not FillMCFiltrTable then {
   message('Нет ТМЦ для пересчета (см. настройку групп исключения) или не удалось заполнить временную таблицу-фильтр по ТМЦ', error);
   exit;
  }

 setvisualHeader('Запрос по приходным ордерам');

 delete all tMoveMC;
 delete all tTempMC;

  var hstr : tptr = 0;
  setvisualHeader('Запрос по ордерам');
  hstr := 0;
  mylog(' ------------ Запрос по ордерам          ');
  MysqlAddStr(hstr, '   select                                                                              ');
  MysqlAddStr(hstr, '     katmc.nrec  as cMc                                                                ');
  MysqlAddStr(hstr, '   , SpOrder_Rash.nrec as cSpOrder                                                     ');
  MysqlAddStr(hstr, '   from katmc                                                                          ');
  MysqlAddStr(hstr, '              join saldtune on saldtune.nrec = #comp('+string(000100000000000Ah,0,0) + ')'); // ЦУ ЛИ
  MysqlAddStr(hstr, '   join sporder SpOrder_Rash on SpOrder_Rash.SP = 0                                    ');
  MysqlAddStr(hstr, '                            and SpOrder_Rash.VIDORDER = 1                              ');
  MysqlAddStr(hstr, '                            and SpOrder_Rash.CMC = katmc.nRec                          ');
  MysqlAddStr(hstr, '                            and SpOrder_Rash.DORD between #date(' + datetostr(datBeg,'DD,MM,YYYY')+ ') and #date(' + datetostr(DatEnd,'DD,MM,YYYY')+ ')');
  MysqlAddStr(hstr, '   join specmtr cu on cu.csaldtune = saldtune.nrec                                     ');
  MysqlAddStr(hstr, '                   and cu.COTABLE = 1112                                               ');
  MysqlAddStr(hstr, '                   and cu.cspec = SpOrder_Rash.nrec                                    ');
  MysqlAddStr(hstr, '                              and cu.COBJ = #comp('+string(000100000000061Ch,0,0)+')'); // вид собственности = Собственные
  if getfirst pick where ((cgPick_MC == Pick.wList)) = tsok then MysqlAddStr(hstr, '  and katmc.nrec in (select tblFiltrTMC_RECACL.cmc from tblFiltrTMC_RECACL)     ');
  MysqlAddStr(hstr, ' and katmc.cGroupMC not in (select KATLINK.CREC from KATLINK where KATLINK.OWNNAME = ''CHOOSE_GROUP_MC_EXCLUDE'' )'); //не надо ручные пересчитывать
  MysqlAddStr(hstr, ' union all                                                                             ');
  MysqlAddStr(hstr, '  select                                                                               ');
  MysqlAddStr(hstr, '      katmc.nrec  as cMc                                                       ');
  MysqlAddStr(hstr, '    , SpOrder_Prih.nrec as cSpOrder                                            ');
  MysqlAddStr(hstr, '            from katmc                                                                 ');
  MysqlAddStr(hstr, '            join saldtune on saldtune.nrec = #comp('+string(000100000000000Ah,0,0) + ')'); // ЦУ ЛИ
  MysqlAddStr(hstr, '            join sporder SpOrder_Prih on SpOrder_Prih.SP = 0                           ');// склад
  MysqlAddStr(hstr, '                                     and SpOrder_Prih.VIDORDER = 0                     '); // приходный
  MysqlAddStr(hstr, '                                     and SpOrder_Prih.CMC = katmc.nRec                 ');
  MysqlAddStr(hstr, '                                     and SpOrder_Prih.DORD between #date(' + datetostr(datBeg,'DD,MM,YYYY')+ ') and #date(' + datetostr(DatEnd,'DD,MM,YYYY')+ ')');
  MysqlAddStr(hstr, '                                     and SpOrder_Prih.TIPORD in (1,2)                  ');
  MysqlAddStr(hstr, '            join specmtr cu on cu.csaldtune = saldtune.nrec                            ');
  MysqlAddStr(hstr, '                            and cu.COTABLE = 1112                                      ');
  MysqlAddStr(hstr, '                            and cu.cspec = SpOrder_Prih.nrec                           ');
  MysqlAddStr(hstr, '                            and cu.COBJ = #comp('+string(000100000000061Ch,0,0)+')');  // вид собственности = Собственные
  if getfirst pick where ((cgPick_MC == Pick.wList)) = tsok then MysqlAddStr(hstr, '  and katmc.nrec in (select tblFiltrTMC_RECACL.cmc from tblFiltrTMC_RECACL)     ');
  MysqlAddStr(hstr, ' and katmc.cGroupMC not in (select KATLINK.CREC from KATLINK where KATLINK.OWNNAME = ''CHOOSE_GROUP_MC_EXCLUDE'' )'); //не надо ручные пересчитывать
  MysqlAddStr(hstr, ' union all                                                                            ');
  MysqlAddStr(hstr, ' select                                                                               ');
  MysqlAddStr(hstr, '   katmc.nrec  as cMc                                                                 ');
  MysqlAddStr(hstr, ' , SpOrder_Vnutr.nrec as cSpOrder                                                     ');
  MysqlAddStr(hstr, ' from katmc                                                                           ');
  MysqlAddStr(hstr, '             join saldtune on saldtune.nrec = #comp('+string(000100000000000Ah,0,0) + ')'); // ЦУ ЛИ
  MysqlAddStr(hstr, ' join sporder SpOrder_Vnutr on SpOrder_Vnutr.SP = 0                                   ');
  MysqlAddStr(hstr, '                           and SpOrder_Vnutr.VIDORDER = 0                             ');
  MysqlAddStr(hstr, '                          and SpOrder_Vnutr.CMC = katmc.nRec                          ');
  MysqlAddStr(hstr, '                          and SpOrder_Vnutr.DORD between #date(' + datetostr(datBeg,'DD,MM,YYYY')+ ') and #date(' + datetostr(DatEnd,'DD,MM,YYYY')+ ')');
  MysqlAddStr(hstr, '                          and SpOrder_Vnutr.TIPORD = 3                                ');
  MysqlAddStr(hstr, '  join SKLORDER SKLORDER_Vnutr on SpOrder_Vnutr.cSklOrder = SKLORDER_Vnutr.nrec       ');
  MysqlAddStr(hstr, '                                                                                      ');
  MysqlAddStr(hstr, ' join specmtr cu on cu.csaldtune = saldtune.nrec                                      ');
  MysqlAddStr(hstr, '                 and cu.COTABLE = 1112                                                ');
  MysqlAddStr(hstr, '                 and cu.cspec = SpOrder_Vnutr.nrec                                    ');
  MysqlAddStr(hstr, '                             and cu.COBJ = #comp('+string(000100000000061Ch,0,0)+')'); // вид собственности = Собственные
  MysqlAddStr(hstr, ' where SKLORDER_Vnutr.cSopr <> #comp(0h)                                               '); //не надо ручные пересчитывать
  if getfirst pick where ((cgPick_MC == Pick.wList)) = tsok then MysqlAddStr(hstr, '  and katmc.nrec in (select tblFiltrTMC_RECACL.cmc from tblFiltrTMC_RECACL)     ');
  MysqlAddStr(hstr, ' and katmc.cGroupMC not in (select KATLINK.CREC from KATLINK where KATLINK.OWNNAME = ''CHOOSE_GROUP_MC_EXCLUDE'' )'); //не надо ручные пересчитывать
//  and katmc.nrec in (select tblFiltrTMC_RECACL.cmc from tblFiltrTMC_RECACL)

  var objQuery3 : iQuery;
    objQuery3 := queryManager.createQuery(hstr);
  if objQuery3.execute.errorCode != tsOk
   then {
        MyLog('Ошибка выполнения запроса '+ objQuery3.errorCode);
      }
  else {
    //sqlCopyInto(objQuery3, tntMoveMC, false);
      var _resSet : IResultSet = objQuery3.getResultSet;
      if _resSet.getFirst <> tsOK
      MyLog('результат запроса пустой ');
      while true {
         insert tMoveMC set
            tMoveMC.cMc     := _resSet.row.val('cMc')
          , tMoveMC.cSpOrder := _resSet.row.val('cSpOrder')
         ;
        mylog('insert tMoveMC cMc := ' + string(tMoveMC.cMc,0,0) + ' cSpOrder =' + string(tMoveMC.cSpOrder,0,0));
        if _resSet.getNext() <> tsOK then break;
      }
   }
  mylog('  выбрано записей '+ string(recordsintable(tntMoveMC)));

  setvisualHeader('Расчет сальдо на начало периода');
  delete all tmpSaldo1;
          iSaldoFun.Store_Run_New( // хрен зате куда пропала фнкция это .. Store_run_new_ex
                                   Sub_Day(DatBeg, 1)
                                 , true //складские остатки
                                 , false //производственные
                                 , False
                                 , False
                                 , -2 //МЦ - будут браться из PICK по крайней мере в Store_run_new_ex брались
                                 , 0h //склад
                                 , 0h //МОЛ
                                 , 0h //группам партий и партиям
                                 , False // выгружать остатки по МТР
                                 , 000100000000000Ah  //фильтр по ЦУ: ЦУ ЛИ,
                                 , 000100000000061Ch  //фильтр по ЦУ: вид собственности = Собственные
                                 , True  // группировать по складам
                                 , True  // группировать по МОЛ
                                 , True  // группировать по партиям
                                 , False  // bIncZeroKol
                                 );
           StartNewVisual(vtIndicatorVisual ,vfTimer,'Просмотр и группировка остатков по ТМЦ',RecordsInTable(tnTmpSaldo1));
            _loop TmpSaldo1 {
              nextvisual;
              if getfirst tTempMC where (( TmpSaldo1.CMC == tTempMC.cMc)) <> tsok then {
                insert tTempMC set tTempMC.cMc := TmpSaldo1.CMC;
                mylog(' _loop TmpSaldo1  insert tTempMC  tTempMC.cMc := ' + string(tTempMC.cMc,0,0))

               }
                update current tTempMC set
                  tTempMC.kol_ost := tTempMC.kol_ost + TmpSaldo1.kol
                , tTempMC.sum_ost := tTempMC.sum_ost + TmpSaldo1.kol*TmpSaldo1.PRICE
               ;
            }
  StopVisual('The End',vfTimer);
  mylog(' END _loop TmpSaldo1');
  mylog(' RecordsInTable(tntMoveMC_loop) = ' + string(RecordsInTable(tntMoveMC_loop)));

  StartNewVisual(vtIndicatorVisual ,vfTimer,'Просмотр выбранных позиций ордеров',RecordsInTable(tntMoveMC_loop));
  _loop tMoveMC_loop {
    nextvisual;
    mylog('  _loop tMoveMC_loop');

    if getfirst SpOrder_loop <> tsOK continue;
    mylog('  if getfirst SpOrder_loop = tsOK');
    if getfirst tTempMC where ((tMoveMC_loop.CMC == tTempMC.cMc)) <> tsok then  {
       insert tTempMC set tTempMC.cMc := tMoveMC_loop.CMC;
       mylog('  insert tTempMC  tTempMC.cMc := ' + string(tTempMC.cMc,0,0))
     }
    var isPrihod : boolean = false;
    if     SpOrder_loop.SP = 0          // склад
       and SpOrder_loop.VIDORDER = 0    // приходный
       and ( SpOrder_loop.TIPORD = 1    // внешние операции
          or SpOrder_loop.TIPORD = 2) then {
       update current tTempMC set
           tTempMC.kol_prihod := tTempMC.kol_prihod + SpOrder_loop.kol
         , tTempMC.sum_prihod := tTempMC.sum_prihod + SpOrder_loop.kol*SpOrder_loop.RSRPRICE
       ;
       isPrihod := true;
     }
     var _Nrec : comp = tTempMC.nrec;
    if not isPrihod then
        insert tTempMC set
           tTempMC.cRec     :=_Nrec
         , tTempMC.cSporder := SpOrder_loop.nrec
        ;
  }



  stopvisual;
  StopVisual;
  if isShowNewPrices = 1
    then runwindowmodal(winBrowseMC);
    else setnewPrices;

   if isProverka = 1 then ProcessText(_log,vfEscable or vfNewTitle or vfMacroSize,'Лог-файл');
}
//----------------------
End; // HandleEvent Interface
End. // Interface

Price4PeriodRecalc_HotKeys Menu
{
- 'Установить цены в ордерах', cmValue1, 'Установить цены в ордерах', , , , sci1Esc;
}
//------------------------------------------------------------------------------
// Отчеты пользователя
//------------------------------------------------------------------------------

#Component "F_UserReport"
ObjInterface IUserReport;
  // Запуск отчета на вvполнение при выборе его из списка отчетов
  procedure Run;
  // Наименование отчета в списке
  function GetReportName : String;
  // Наименования групп, в которvе входит отчет
  // +Группа n+1 делается подчиненной группе n
  function GetGroupName (Level : Word) : String;
  // Приоритет отчета - сортировка внутри группv вvполняется сначала
  // по приоритету, а затем по наименовани_
  function GetPriority : Integer;
  // ModuleID модулей, в которvх будет виден отчет
  // '*' - отчет будет виден в любом модуле
  function VisibleInModule (Ind : Byte) : String;
end;

VipInterface UserReport_Pereschet_MC Implements IUserReport;

Interface UserReport_Pereschet_MC

create view;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := '*';
  end;
end;
function GetPriority : Integer;
begin
  GetPriority := 0;
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := '';
  case Level of
    1 : GetGroupName := 'Склад';
  end;
end;

function GetReportName: String;
begin
  GetReportName := 'Пересчет Цен МЦ'
end;
!-------------------------------------------------------------------------------
procedure Run;
begin
  runinterface(L_SALDOMTR::PRICES4PERIOD_RECALC );
end;
!-------------------------------------------------------------------------------
end.
