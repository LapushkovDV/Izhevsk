#include Query.vih
#include SaldoFuncs.vih

#component "L_SaldoMTR"

interface prices4period_recalc 'Расчет средних цен МЦ', EscClose;
show at (,,60,11);

table struct tTempMC (
   nRec     : comp
 , cRec     : comp
 , cMc      : comp
 , kol_ost    : double
 , sum_ost    : double
 , kol_prihod : double
 , sum_prihod : double
 , cSpOrder : comp
)
with index (
   ind0 = Nrec (unique, surrogate)
 , ind1 = cRec
 , ind2 = cMc
);

table struct tMoveMC (
   cMc      : comp
 , cSpOrder : comp
)
with index (
 index0 = cMc
);

//************************ Вьюха  *************************
create view
 var
     cur_mc : comp = 0h;
     iSaldoFun : SaldoFuncs;
       DatBeg
     , DatEnd : date;
       _katmc
     , _log : string;
       _vibrano
     , _i
     , _izmenenoRash
     , _izmenenoVnutr
     , _izmenenoPrih
     , _izmenenoMontaj : longint;
     isProverka : byte;
     _tekMonth : date;
as select
  if ( SPO_br.VidOrder = 0, 'П', 'Р')
    ( Fieldname = VidOper )
, if ( SklOrder_br.TipOrd = 1,
      if ( NOT IsValid(tnKatSopr_br), 'К',
                if (KatSopr_br.vidSopr = 611, 'В',
                        if ( ((KatSopr_br.vidSopr >= 101) and (KatSopr_br.vidSopr <= 106) or (KatSopr_br.vidSopr =  108) or
                              (KatSopr_br.vidSopr >= 201) and (KatSopr_br.vidSopr <= 206) or
                              (KatSopr_br.vidSopr >= 210) and (KatSopr_br.vidSopr <= 229) or
                              (KatSopr_br.vidSopr >= 521) and (KatSopr_br.vidSopr <= 522) or
                              (KatSopr_br.vidSopr  = 626) or  (KatSopr_br.vidSopr  = 636)), 'К', '*'))),
    if (SPO_br.TipOrd = 2, 'П',
      if (SPO_br.TipOrd = 3, 'В',
        if (SPO_br.TipOrd>= 4 and SPO_br.TipOrd<= 7, 'Д', '*'))))
    ( Fieldname = TipOper )
, if ( SklOrder_br.vidOrder = 0, ColorSklModulKSU2, ColorSklModulKSU3 )
    ( Fieldname = ColorVidOrder )
, if((wGetTune('Oper.FormatNamePodrMOL') = 0), KatMOL.Name, KatMOL.Kod + ' - ' + KatMOL.Name)
    ( FieldName = KatMOL1_Name )
//------------------------------------------------------------------------------
, if((wGetTune('Oper.FormatNamePodrMOL') = 0), KatPodr.Name, KatPodr.Kod + ' - ' + KatPodr.Name)
    ( FieldName = katpodr1_name )

 from
    Pick
  , KatMc MC_br
  , SaldoMc
  , tmpSaldo1
  , SpOrder SpOrder_loop
  , SpOrder SPO_BR
  , SklOrder SklOrder_br
  , KatPodr
  , KatMOL
  , KatParty
  , KatSopr KatSopr_br
  , tTempMC
  , tTempMC tTempMC_br
  , tMoveMC
  , tMoveMC tMoveMC_loop
 Where ((
        tMoveMC_loop.cSpOrder == SpOrder_loop.nrec
                  and  cur_mc == tTempMC_br.crec
           and tTempMC_br.cmc == MC_br.nrec
      and tTempMC_br.cSpOrder == SPO_br.nrec
      and    SPO_br.cSklOrder == SklOrder_br.NRec
      and   SklOrder_br.cSopr == KatSopr_br.NRec
      and       SPO_br.ccPodr == KatPodr.NRec
      and        SPO_br.ccMol == KatMOL.NRec
      and       SPO_br.cParty == KatParty.NRec

 ))
 ;
Procedure MyLog(_str: string); {
  LogStrToFile(_log,DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS')  + ':'+_str);
}
Procedure MysqlAddStr(var query_handle : tptr; add_query_str: string); {
   sqlAddStr(query_handle, add_query_str);
   MyLog('sql: ' + add_query_str);
} //Function MysqlAddStr(var query_handle: longInt; add_query_str: string): longInt;

function FillMCFiltrTable : boolean; {
  if getfirst pick where ((cgPick_MC == Pick.wList)) <> tsok then exit;
 setvisualHeader('Заполнение таблицы-фильтра по ТМЦ');
  result := false;
  var strID : tptr;  strID   := 0;
  sqlFreeStr(strID);
  strID:=0;
  sqlAddStr(strID, 'table tblFiltrTMC_RECACL');
  sqlAddStr(strID, '(                  ');
  sqlAddStr(strID, ' cMc: comp        ');
  sqlAddStr(strID, ')                  ');
  sqlAddStr(strID, 'with index         ');
  sqlAddStr(strID, '(                  ');
  sqlAddStr(strID, ' a0 = cMc         ');
  sqlAddStr(strID, ');                 ');
  sqlDropTmpTable('tblFiltrTMC_RECACL');
  if sqlCreateTmpTable(strID, ctmNormal) = tsOk {
    result := true;
  }
  if result {
  _loop pick where ((cgPick_MC == Pick.wList)) {
        var _sqlstr : string =   'INSERT INTO tblFiltrTMC_RECACL (cMc) VALUES (' + ' #comp(' + string(Pick.cRec) + '))';
        sqlExecDirect(_sqlstr);
        //mylog('sql :' + _sqlstr);
   }
  }
}

SCREEN PROJ5;
  Fields
   _tekMonth : ['DD/MM/YYYY'],NoProtect;
   DatBeg : ['DD/MM/YYYY'],NOprotect;
   DatEnd : ['DD/MM/YYYY'],NOprotect;
   _katmc  : Protect, PickButton;
   isProverka :NOprotect;

 Buttons
  cmNewMonth,,,'Начать обновление';
  cmOK,,,'Начать обновление';
  cmCancel,,,'Отмена';
 << 'Пересчет сальдо за период по МЦ'

  .@@@@@@@@@  <. Установить новый период  .>

 Период с .@@@@@@@@@@ по .@@@@@@@@@@
   МЦ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  [.] - Проверить цены `

Будут пересчитаны средние цены за период

 <.   Начать  .>          <.   Отмена   .>
>>
END;

window winBrowseMC '';
tree trBrowseMC 'Дебиторская задолженность';
  table tTempMC_br;
fields
  MC_br.name            'Наименование МЦ' ('Наименование МЦ'): [35], protect;
  MC_br.barkod          'Баркод МЦ' ('Баркод МЦ'): [10], protect;
  tTempMC_br.kol_ost    'Остаток','кол-во' ('остаток по МЦ количество'): [10], protect;
  tTempMC_br.sum_ost    'Остаток','сумма' ('остаток по МЦ сумма'): [10], protect;
  tTempMC_br.kol_prihod 'Приход','кол-во' ('приход по МЦ количество'): [10], protect;
  tTempMC_br.sum_prihod 'Приход','кол-во' ('приход по МЦ сумма'): [10], protect;
  VidOper        'П'('Приход/расход')
                : [1], Protect, NoAutoSize, Centered,
                 { Font = {Color = ColorVidOrder; Bold = TRUE}};
//------------------------------------------------------------------------------
  TipOper        'Т'('Тип операции: К-внешняя, П-производство, В-внутренняя, Д-переоценка, *-прочие', , )
                : [1], Protect, NoAutoSize, Centered;

  SklOrder_br.DesGr 'Группа' : [5], Protect, NoAutoSize;
  SPO_BR.Descr  'Дескр' : [5], Protect, NoAutoSize;
  SklOrder_br.NOrder 'Номер': [6], Protect, NoAutoSize, { Font = {BackColor = if (SklOrder_br.NOrder = '', ColorNeed, 0)}};
  SklOrder_br.dOrd  'Дата' : [10], Protect, NoAutoSize, Centered, { Font = {BackColor = if (Longint(SklOrder_br.dOrd) = Longint(0), ColorNeed, 0)}};
  katpodr1_name   'Подразделение' : [15], Protect, { Font = {BackColor = if (not IsValid(#KatPodr), ColorNeed, 0)}};
  KatMOL1_Name    'МОЛ' : [15], Protect;
  KatParty.KOD   'Партия', 'код' : [5], Protect;
  KatParty.Name  'Партия', 'наименование' : [15], Protect;
  SPO_BR.Kol    'Количество' (, , sci134EnEsc) : [12], [prSignsInKol, '\3p[|-]36`666`666`666`666.888'], NoAutoSize, EditButton, { Font = {Color = ColorVidOrder}};
  SPO_BR.rSrPrice 'Цена' : [17], [brForSpOrder_Price, '\2p[|-]36`666`666`666`666.88'], NoAutoSize;
end;
end;

TableEvent table tTempMC_br;
cmTreeTop:  {
     cur_mc := 0;
}
cmTreeDown: {
     cur_mc := tTempMC_br.NRec;
}
cmTreeUp:   {
     cur_mc := tTempMC_br.cRec;
}
cmTreeNodeType:{
  if (TreeIsTerminal(trBrowseMC)) TreeSetNodeType(trBrowseMC,   2);
}
end;
//------------------------------------------------------------------------------
// Инициализация главного окна
//------------------------------------------------------------------------------
Handleevent
cmInit:
{
 //RunInterFace(L_SKLAD::COUNTSAL);
 _tekMonth := dGetTuneEx  ('TEKMONTH', 1, UserId )
 delete pick where ((cgPick_MC == Pick.wList));
// wSetTuneEx('PICK.SORTMC',1,UserID,_nastr)
}
cmNewMonth:
{
 if dGetTuneEx('TEKMONTH', 1, UserId ) > _tekMonth
  then
    {
     dSetTuneEx('TEKMONTH', 1, UserId, _tekMonth);
     Insert SaldoMc set dsaldo := _tekMonth;
    }
    else
     {
      Message('Новый период должен быть позже текущего');
      _tekMonth := dGetTuneEx('TEKMONTH', 1, UserId )
     }
}
cmPick:
{

  RunInterFace(L_MCU::GETSOMEMC,-12345); // -12345 : не запрашивать кол-во
  _vibrano := 0;
   StartNewVisual(vtRotateVisual, vfTimer, 'Подсчет выбранного количества',1);
   _loop pick where ((cgPick_MC == Pick.wList)){
     setVisualHeader('Подсчет выбранного количества ' + _vibrano);
     _vibrano++
    }
   StopVisual('The End',vfTimer);
   _katmc := ' выбрано ' + _vibrano
}
cmOK:
{

/*
 if getfirst pick where ((cgPick_MC == Pick.wList)) <> tsok {
   message('Не выбраны ТМЦ', error);
   stop; abort; exit;
 }
*/

 if DatBeg = to_date(0,0,0) {
   message('Дата начала расчета не может быть пустой', error);
   stop; abort; exit;
 }
 if DatEnd = to_date(0,0,0) {
   message('Дата окончания расчета не может быть пустой', error);
   stop; abort; exit;
 }
 if DatBeg > DatEnd {
   message('Дата начала расчета не может быть больше даты окончания пустой', error);
   stop; abort; exit;
 }


 StartNewVisual(vtRotateVisual, vfTimer, '',1);
   MyLog('Пересчет средних цен за период с ' + datetostr(datBeg,'DD.MM.YYYY') + ' по ' + datetostr(DatEnd,'DD.MM.YYYY'));
   MyLog('  по ' + _katmc + ' МЦ');
   MyLog('Начало ' + Cur_Time);

 _log := GetStringParameter('Files','OutputFilesDirectory',0) + '\prices4period_recalc'+'_'+DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS-SSS')+'.txt';

_izmenenoPrih := _izmenenoRash:= _izmenenoVnutr :=_izmenenoMontaj := 0;

 if not FillMCFiltrTable then {
   message('Не удалось заполнить временную таблицу-фильтр по ТМЦ', error)
  }

 setvisualHeader('Запрос по приходным ордерам');

 delete all tMoveMC;
 delete all tTempMC;

  var hstr : tptr = 0;
  setvisualHeader('Запрос по ордерам');
  hstr := 0;
  mylog(' ------------ Запрос по ордерам          ');
  MysqlAddStr(hstr, '   select                                                                              ');
  MysqlAddStr(hstr, '     katmc.nrec  as cMc                                                                ');
  MysqlAddStr(hstr, '   , SpOrder_Rash.nrec as cSpOrder                                                     ');
  MysqlAddStr(hstr, '   from katmc                                                                          ');
  MysqlAddStr(hstr, '              join saldtune on saldtune.nrec = #comp('+string(000100000000000Ah,0,0) + ')'); // ЦУ ЛИ
  MysqlAddStr(hstr, '   join sporder SpOrder_Rash on SpOrder_Rash.SP = 0                                    ');
  MysqlAddStr(hstr, '                            and SpOrder_Rash.VIDORDER = 1                              ');
  MysqlAddStr(hstr, '                            and SpOrder_Rash.CMC = katmc.nRec                          ');
  MysqlAddStr(hstr, '                            and SpOrder_Rash.DORD between #date(' + datetostr(datBeg,'DD,MM,YYYY')+ ') and #date(' + datetostr(DatEnd,'DD,MM,YYYY')+ ')');
  MysqlAddStr(hstr, '   join specmtr cu on cu.csaldtune = saldtune.nrec                                     ');
  MysqlAddStr(hstr, '                   and cu.COTABLE = 1112                                               ');
  MysqlAddStr(hstr, '                   and cu.cspec = SpOrder_Rash.nrec                                    ');
  MysqlAddStr(hstr, '                              and cu.COBJ = #comp('+string(000100000000061Ch,0,0)+')'); // вид собственности = Собственные
  if getfirst pick where ((cgPick_MC == Pick.wList)) = tsok then MysqlAddStr(hstr, '  and katmc.nrec in (select tblFiltrTMC_RECACL.cmc from tblFiltrTMC_RECACL)     ');
  MysqlAddStr(hstr, ' union all                                                                             ');
  MysqlAddStr(hstr, '  select                                                                               ');
  MysqlAddStr(hstr, '      katmc.nrec                                                               ');
  MysqlAddStr(hstr, '    , SpOrder_Prih.nrec as cSpOrder                                            ');
  MysqlAddStr(hstr, '            from katmc                                                                 ');
  MysqlAddStr(hstr, '            join saldtune on saldtune.nrec = #comp('+string(000100000000000Ah,0,0) + ')'); // ЦУ ЛИ
  MysqlAddStr(hstr, '            join sporder SpOrder_Prih on SpOrder_Prih.SP = 0                           ');// склад
  MysqlAddStr(hstr, '                                     and SpOrder_Prih.VIDORDER = 0                     '); // приходный
  MysqlAddStr(hstr, '                                     and SpOrder_Prih.CMC = katmc.nRec                 ');
  MysqlAddStr(hstr, '                                     and SpOrder_Prih.DORD between #date(' + datetostr(datBeg,'DD,MM,YYYY')+ ') and #date(' + datetostr(DatEnd,'DD,MM,YYYY')+ ')');
  MysqlAddStr(hstr, '                                     and SpOrder_Prih.TIPORD in (1,2)                  ');
  MysqlAddStr(hstr, '            join specmtr cu on cu.csaldtune = saldtune.nrec                            ');
  MysqlAddStr(hstr, '                            and cu.COTABLE = 1112                                      ');
  MysqlAddStr(hstr, '                            and cu.cspec = SpOrder_Prih.nrec                           ');
  MysqlAddStr(hstr, '                            and cu.COBJ = #comp('+string(000100000000061Ch,0,0)+')');  // вид собственности = Собственные
  if getfirst pick where ((cgPick_MC == Pick.wList)) = tsok then MysqlAddStr(hstr, '  and katmc.nrec in (select tblFiltrTMC_RECACL.cmc from tblFiltrTMC_RECACL)     ');
  MysqlAddStr(hstr, ' union all                                                                            ');
  MysqlAddStr(hstr, ' select                                                                               ');
  MysqlAddStr(hstr, '   katmc.nrec  as cMc                                                                 ');
  MysqlAddStr(hstr, ' , SpOrder_Vnutr.nrec as cSpOrder                                                     ');
  MysqlAddStr(hstr, ' from katmc                                                                           ');
  MysqlAddStr(hstr, '             join saldtune on saldtune.nrec = #comp('+string(000100000000000Ah,0,0) + ')'); // ЦУ ЛИ
  MysqlAddStr(hstr, ' join sporder SpOrder_Vnutr on SpOrder_Vnutr.SP = 0                                   ');
  MysqlAddStr(hstr, '                           and SpOrder_Vnutr.VIDORDER = 0                             ');
  MysqlAddStr(hstr, '                          and SpOrder_Vnutr.CMC = katmc.nRec                          ');
  MysqlAddStr(hstr, '                          and SpOrder_Vnutr.DORD between #date(' + datetostr(datBeg,'DD,MM,YYYY')+ ') and #date(' + datetostr(DatEnd,'DD,MM,YYYY')+ ')');
  MysqlAddStr(hstr, '                          and SpOrder_Vnutr.TIPORD = 3                                ');
  MysqlAddStr(hstr, '  join SKLORDER SKLORDER_Vnutr on SpOrder_Vnutr.cSklOrder = SKLORDER_Vnutr.nrec       ');
  MysqlAddStr(hstr, '                                                                                      ');
  MysqlAddStr(hstr, ' join specmtr cu on cu.csaldtune = saldtune.nrec                                      ');
  MysqlAddStr(hstr, '                 and cu.COTABLE = 1112                                                ');
  MysqlAddStr(hstr, '                 and cu.cspec = SpOrder_Vnutr.nrec                                    ');
  MysqlAddStr(hstr, '                             and cu.COBJ = #comp('+string(000100000000061Ch,0,0)+')'); // вид собственности = Собственные
  MysqlAddStr(hstr, ' where SKLORDER_Vnutr.cSopr = #comp(0h)                                               ');
  if getfirst pick where ((cgPick_MC == Pick.wList)) = tsok then MysqlAddStr(hstr, '  and katmc.nrec in (select tblFiltrTMC_RECACL.cmc from tblFiltrTMC_RECACL)     ');
//  and katmc.nrec in (select tblFiltrTMC_RECACL.cmc from tblFiltrTMC_RECACL)

  var objQuery3 : iQuery;
    objQuery3 := queryManager.createQuery(hstr);
  if objQuery3.execute.errorCode != tsOk
   then {
      MyLog('Ошибка выполнения запроса '+ objQuery3.errorCode);
      }
  else {
    sqlCopyInto(objQuery3, tntMoveMC, false);
  }
  mylog('  выбрано записей '+ string(recordsintable(tntMoveMC)));

  setvisualHeader('Расчет сальдо на начало периода');
  delete all tmpSaldo1;
          iSaldoFun.Store_Run_New( // хрен зате куда пропала фнкция это .. Store_run_new_ex
                                   Sub_Day(DatBeg, 1)
                                 , true //складские остатки
                                 , false //производственные
                                 , False
                                 , False
                                 , -2 //МЦ - будут браться из PICK по крайней мере в Store_run_new_ex брались
                                 , 0h //склад
                                 , 0h //МОЛ
                                 , 0h //группам партий и партиям
                                 , False // выгружать остатки по МТР
                                 , 000100000000000Ah  //фильтр по ЦУ: ЦУ ЛИ,
                                 , 000100000000061Ch  //фильтр по ЦУ: вид собственности = Собственные
                                 , True  // группировать по складам
                                 , True  // группировать по МОЛ
                                 , True  // группировать по партиям
                                 , False  // bIncZeroKol
                                 );
           StartNewVisual(vtIndicatorVisual ,vfTimer,'Просмотр и группировка остатков по ТМЦ',RecordsInTable(tnTmpSaldo1));
            _loop TmpSaldo1 {
              nextvisual;
              if getfirst tTempMC where (( TmpSaldo1.CMC == tTempMC.cMc)) <> tsok then insert tTempMC set tTempMC.cMc := TmpSaldo1.CMC;
                update current tTempMC set
                  tTempMC.kol_ost := tTempMC.kol_ost + TmpSaldo1.kol
                , tTempMC.sum_ost := tTempMC.sum_ost + TmpSaldo1.kol*TmpSaldo1.PRICE
               ;
            }
  StopVisual('The End',vfTimer);

  StartNewVisual(vtIndicatorVisual ,vfTimer,'Просмотр выбранных позиций ордеров',RecordsInTable(tntMoveMC_loop));
  _loop tMoveMC_loop {
    nextvisual;
    if getfirst SpOrder_loop <> tsOK continue;
    if getfirst tTempMC where ((tMoveMC_loop.CMC == tTempMC.cMc)) <> tsok then insert tTempMC set tTempMC.cMc := tMoveMC_loop.CMC;
    if     SpOrder_loop.SP = 0          // склад
       and SpOrder_loop.VIDORDER = 0    // приходный
       and ( SpOrder_loop.TIPORD = 1    // внешние операции
          or SpOrder_loop.TIPORD = 2) then {
       update current tTempMC set
           tTempMC.kol_prihod := tTempMC.kol_prihod + SpOrder_loop.kol
         , tTempMC.sum_prihod := tTempMC.sum_prihod + SpOrder_loop.kol*SpOrder_loop.RSRPRICE
       ;
     }
     var _Nrec : comp = tTempMC.nrec;
    insert tTempMC set
       tTempMC.cRec     :=_Nrec
     , tTempMC.cSporder := SpOrder_loop.nrec
    ;
  }
  stopvisual;
  StopVisual;
 runwindowmodal(winBrowseMC);


   /*
  _loop tPrihodMC {
    mylog('tPrihodMC.cMc = ' + string(tPrihodMC.cMc,0,0));
     _i++;
     SetVisualHeader(SubStr(Katmc.Name,1,30)+
                    ''#13''+ (100*_i/_vibrano) +' % выполнено');

       _Kol := _Summa := 0;

       if getfirst ostatkigrouptmc where (( TmpSaldo1.CMC == ostatkigrouptmc.cMc)) = tsok {
          _Kol   := ostatkigrouptmc.kol;
          _Summa := ostatkigrouptmc.Sum;
        }
      _Kol_Prih   := tPrihodMC.kol;
      _Summa_Prih := tPrihodMC.sum;

      if _Kol_Prih +_Kol =0 then continue; // нет остатков и прихода

       _Price := (_Summa_Prih + _Summa)/(_Kol_Prih +_Kol);
      mylog('katmc.barkod = ' + katmc.barkod+ ' _KolOst = ' + string(_Kol) + ' _SummaOst = '+ string(_Summa)+ ' _Kol_Prih = ' + string(_Kol_Prih) + ' _Summa_Prih = ' + _Summa_Prih + ' PriceToSet = ' + string(_Price));
      // расходные ордера

      _loop tRashodMC where ((tPrihodMC.cMc == tRashodMC.cMc)) {
