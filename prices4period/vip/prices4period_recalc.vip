          if Round(_Price,2) = Round(tRashodMC.RSRPRICE,2)then continue;

          if isProverka = 1 then {
                MyLog('Расходный|' + KatMc.Barkod +'|' +KatMc.Name+'|'+String(SpOrder_rash.RSRPRICE)+ '->'+ String(_Price));
           }
           else {
              if getfirst SpOrder_rash where ((tRashodMC.cSpOrder == SpOrder_rash.nrec)) = tsOK {
               mylog('exists SpOrder_rash');
              _izmenenoRash++;
                MyLog('Расходный|' + KatMc.Barkod +'|' +KatMc.Name+'|'+String(SpOrder_rash.RSRPRICE)+ '->'+ String(_Price));
                update Current SpOrder_rash Set
                    SpOrder_rash.RSRPRICE := _Price
                   ,SpOrder_rash.SRPRICE  := Round(_Price*SpOrder_rash.kol,2)/SpOrder_rash.kol
                 ;
               } else {
                  mylog('NOT! exists SpOrder_rash')
               }
           }
       } // end _loop SpOrder_Rash Where ((  0 == SPO_BR.SP

       // внутреннее перемещение и транзитные
     _loop tVnutrMC where ((tRashodMC.cMc == tVnutrMC.cMc)) {
       if Round(_Price,2) = Round(SpOrder_Vnutr.RSRPRICE,2)then continue;
          if isProverka = 1 then {
             MyLog('Внутренний|' + KatMc.Barkod +'|' +KatMc.Name+'|'+String(SpOrder_rash.RSRPRICE)+ '->'+ String(_Price));
         } else {
            if getfirst SpOrder_Vnutr where ((tRashodMC.cSpOrder == SpOrder_Vnutr.nrec)) = tsOK {
           _izmenenoVnutr++;
             MyLog('Внутренний|' + KatMc.Barkod +'|' +KatMc.Name+'|'+String(SpOrder_rash.RSRPRICE)+ '->'+ String(_Price));
              update Current SpOrder_Vnutr Set
                  SpOrder_Vnutr.RSRPRICE := _Price
                 ,SpOrder_Vnutr.SRPRICE  := Round(_Price*SpOrder_Vnutr.kol,2)/SpOrder_Vnutr.kol
               ;
         }
       }// end _loop SpOrder_Vnutr Where ((  0 == SPO_BR.SP
     } // end _loop KatMc
  }

   MyLog('Обработано позиций ордеров: ');
   MyLog('   - расходных: '+_izmenenoRash) ;
   MyLog('   - приходных по внутреннему перемещению: '+_izmenenoVnutr  );
   MyLog('Конец ' + Cur_Time);
*/
  StopVisual('The End',vfTimer);
   ProcessText(_log,vfEscable or vfNewTitle or vfMacroSize,'Лог-файл ошибок');
}

end;
end.

//------------------------------------------------------------------------------
// Отчеты пользователя
//------------------------------------------------------------------------------

#Component "F_UserReport"
ObjInterface IUserReport;
  // Запуск отчета на вvполнение при выборе его из списка отчетов
  procedure Run;
  // Наименование отчета в списке
  function GetReportName : String;
  // Наименования групп, в которvе входит отчет
  // +Группа n+1 делается подчиненной группе n
  function GetGroupName (Level : Word) : String;
  // Приоритет отчета - сортировка внутри группv вvполняется сначала
  // по приоритету, а затем по наименовани_
  function GetPriority : Integer;
  // ModuleID модулей, в которvх будет виден отчет
  // '*' - отчет будет виден в любом модуле
  function VisibleInModule (Ind : Byte) : String;
end;

VipInterface UserReport_Pereschet_MC Implements IUserReport;

Interface UserReport_Pereschet_MC

create view;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := '*';
  end;
end;
function GetPriority : Integer;
begin
  GetPriority := 0;
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := '';
  case Level of
    1 : GetGroupName := 'Склад';
  end;
end;

function GetReportName: String;
begin
  GetReportName := 'Пересчет Цен МЦ'
end;
!-------------------------------------------------------------------------------
procedure Run;
begin
  runinterface(L_SALDOMTR::PRICES4PERIOD_RECALC );
end;
!-------------------------------------------------------------------------------
end.
