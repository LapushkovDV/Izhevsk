! #2229 Z_STATIS.RES
! дополнить в расшифровку при формировании Статистических данных для П-4 информацию
!  код цеха , код категории
.Create view vKateg
var
 sKateg:string;
from KlKatego
where (( sKateg == KlKatego.NaiKat(noindex) ))
;
.create view vPerson
var
  _personsNrec: comp;
select Persons.Nrec
from Persons PersByFT, Persons PersByF, Persons,
     Catalogs CatEdu
where ((
  Root == PersByFT.Nrec and (PersByFT.FIO = ФИО and PersByFT.StrTabN = TabN) and
  Root == PersByF.Nrec and (PersByF.FIO = ФИО) and
  _personsNrec      == Persons.Nrec and
  Persons.Education == CatEdu.Nrec
));
!--  код Категория
.Function GetKategKod(_sKateg:string):string;
begin
 Result:='';
 vKateg.sKateg:=_sKateg;
 if vKateg.getfirst KlKatego=tsok
   Result:=vKateg.klkatego.kod
end.
!-- поиск сотрудника
.Function PersonFound: boolean;
begin
  if vPerson.getfirst PersByFT = tsOk
    vPerson._personsNrec := vPerson.PersByFT.Nrec
  else if vPerson.getfirst PersByF = tsOk
    vPerson._personsNrec := vPerson.PersByF.Nrec;
  else
  {
    result := false;
    exit;
  }
  result := vPerson.getfirst Persons = tsOk;
end.
!-- уровень образования
.Function GetEduLevel: string;
begin
  result := '';
  if PersonFound
    if vPerson.getfirst CatEdu = tsOk
      result := vPerson.CatEdu.Name;
end.
!-- возраст
.Function GetAge(mon: byte; wYear: word): string;
begin
  result := '';
  if PersonFound
  {
    var dBeg, dEnd: date;
    dBeg := vPerson.Persons.BornDate;
    dEnd := date(Last_Day(Date(1,mon, wYear)), mon, wYear);
    result := Year(dEnd) - Year(dBeg) - if(dEnd < date(Day(dBeg), Month(dBeg), wYear), 1, 0);
  }
end.
