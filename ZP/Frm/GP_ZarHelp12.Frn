!(Issue #1388) Справка о расчете среднего заработка из отпускных
.Var
  Page_Row:longint;
  _boCommonInfo:boolean
.endVar
.create view vFactOtpusk
as select FactOtpusk.cLsch
from FactOtpusk, klotpusk, klvidopl, klvidopl klvidoplA, klvidopl klvidoplB
where ((
  FactNrec == FactOtpusk.Nrec and
  Notpusk2 == KLOTPUSK.NOTPUS (noindex) and
  klotpusk.vidopl == klvidopl.vidopl and
  klotpusk.vidoplB1 == klvidoplA.vidopl and
  klotpusk.vidoplB2 == klvidoplB.vidopl
));
.create view v
as select GP_tZarHelp._year
from GP_tZarHelp, klvidopl klvidoplPrem,FactOtpusk,  sumvidop, Nachisl,Lschet
where ((
  root == klvidoplPrem.Nrec and (klvidoplPrem.vhvoe[6] = 'Х' and klvidoplPrem.vhvo[15]='+') and
  FactNrec == FactOtpusk.Nrec and
  FactOtpusk.clsch == sumvidop.clsch and
  FactOtpusk.clsch == Lschet.Nrec and
  GP_tZarHelp._year == sumvidop.yeark and
  month(strtodate(GP_tZarHelp._Mes, 'month')) == sumvidop.mes and
  klvidoplPrem.vidopl == sumvidop.vidopl
  //------------------
  and FactOtpusk.clsch == nachisl.clsch
//  and GP_tZarHelz._year == sumvidop.yearn
//  and GP_tZarHelz._Mes == sumvidop.mesn
  and GP_tZarHelp._year == nachisl.yeark
  and month(strtodate(GP_tZarHelp._Mes, 'month'))  == nachisl.mes
  and klvidoplPrem.vidoplp == nachisl.vidopl
  and klvidoplPrem.vidopl == nachisl.vidopls(noindex)

));
.create view v1
as select
  GP_tZarHelp._year
from GP_tZarHelp;
!-----------------------------------
.create view v_WT
var
  wMes :word;
  wYear:word;
  pLsch :comp;
  wRejim :word;//UP.ZAR.REJIM5
as select
  LsTab.Nrec
from LsTab, KlNdr
where  ((
     pLsch == LsTab.cLschet
and  wYear == LsTab.Yearn
and  wMes  == LsTab.MesN
and  wYear == klndr.YEARK
and  wMes  == klndr.MONTHK
and  wRejim     == klndr.rejim //1.12 Восемь часов в день сорок часов в неделю

))
;
!----------------------------------------
.var
  sumi: double;
  KolDnRab: double;
  Premi1: double;
  SumBezPr : double;
  koef2 : double;
  faktKalDn : integer;
  a : longint;
  skipIndex: longint;
  b : longint;
  DatanM2_1 : date;
  DatanM2_del : word;
.endvar
!-----------------------------------
.function CalcWorkDay(_wMes:word;_wYear:word):word;
var
  ii:word;
begin
 v_wt.wRejim :=coGetTune('UP.ZAR.REJIM5');
 Result:=0;
 if false
 { LoadWorkingTable (vFactOtpusk.FactOtpusk.cLsch, _wMes, _wYear);
   Result := WT_GetDays(dkWorking, stActual);

 }
 else
 { v_Wt.pLsch:=vFactOtpusk.FactOtpusk.cLsch;
   v_Wt.wMes :=_wMes ;
   v_Wt.wYear:=_wYear;
   if v_Wt.getfirst Klndr=tsok
     if v_Wt.getfirst Lstab=tsok
     for(ii:=1;ii<=31;ii++)
     { if (v_wt.LSTAB.DAYCHF[ii]>0 and v_wt.LSTAB.DAYCHF[ii]<25)
       or v_wt.LSTAB.DAYS[ii]='В'
       or v_wt.LSTAB.DAYS[ii]='ЛЧ'
//10032021 сказали чтобы НД попадало, 20210405 - убрать срочно!       or v_wt.LSTAB.DAYS[ii]='НД'
       { if v_Wt.KLNDR.DAYCHAS[ii]>0
           Result++;
       }
     }
 }
 end.
!-----------------------------------
.Function FillTmp:boolean;
begin
  //LoadWorkingTable (vFactOtpusk.FactOtpusk.cLsch, month(strtodate(Mes, 'Month')), word(Year));
  KolDnRab := CalcWorkDay(month(strtodate(Mes, 'Month')), word(Year)); //WT_GetDays(dkWorking, stActual);
  sumi := sumi + KolDnRab;
  v1.insert GP_tZarHelp set
    GP_tZarHelp._year:=year,
    GP_tZarHelp._mes:=mes,
    GP_tZarHelp._chasf:=chasf,
    GP_tZarHelp._chasGr:=chasGr,
    GP_tZarHelp._KolDnRab:=KolDnRab,
    GP_tZarHelp._KodFond:=KodFond ,
    GP_tZarHelp._Summab:=Summab ,
    GP_tZarHelp._Koef:=Koef,
    GP_tZarHelp._Summab1:=Summab1,
    GP_tZarHelp._Koef1:=Koef1,
    GP_tZarHelp._Summa:= Summa,
    GP_tZarHelp._Premi:= string(Premi);
  Result:=true;
end.
.Procedure SummPremi;
begin
if v.getfirst FactOtpusk = tsOk {}
if v.getfirst Lschet = tsOk {}
v._loop klvidoplPrem {
  v._loop sumvidop {
    if v.sumvidop.Datan>=v.lschet.DatPos
      Premi1 += v.sumvidop.summa;
  }
}
v._loop klvidoplPrem {
  v._loop Nachisl {
    if v.Nachisl.Datan>=v.lschet.DatPos
      Premi1 += v.Nachisl.summa;
  }
}
 end.
!-----------------------
.Begin

 Page_Row:=27;
 end.
