!--------------------------------------
! 1389 Протокол расчета среднего заработка
.var
__fio: string;
__tabn: string;
  Premi1,Premi2: double;
  PremiSum : double;
  PremiSum2: double;
  VsegoZar: double;
  IT_Su1   :double; //всего заработок
  IT_Su2   :double; //всего с учетом премии
  a: double;
  b: double;
  skipindex: longint ;
  c: longint;
  kl_Prem:boolean;
  _delta:double;
  _Sredchasf :double;
  _Sredchasf1:double;
  _SredchasGr:double;
  kl_first:boolean;
  rsltAlg30103: double;
  //-------------- Для расчета
  CS : IContextSession;
  CL : ContextList;
.endvar
!--------------------------------------
.create view v
as select GP_tZarHelZ._year
from GP_tZarHelz, klvidopl klvidoplPrem//, persons
, lschet, sumvidop, nachisl
, PrVidOpl PrVidOpl77
, PrVidOpl PrVidOpl7799
, Persons
where ((
  root == klvidoplPrem.Nrec and
   ( klvidoplPrem.VHVOE[6]='Х' //klvidoplPrem.vhod[2] = 'П'
    and klvidoplPrem.vhvo[13]='+')// and
  //and 'С' <<= persons.isEmployee
  //and 'У' >>= persons.isEmployee
  //and ( __TabN = persons.strtabn and persons.fio = __fio)
  //and persons.nrec == lschet.tperson and (lschet.sovm = 0)
  and 0      == Lschet.tabn
  and __TabN == Lschet.strtabn
  and (Hour(LSCHET.LASTTIME)=0)
  and lschet.tperson /== Persons.Nrec
  and (persons.fio = __fio)
  and lschet.nrec == sumvidop.clsch

  and lschet.nrec == PrVidOpl77.cLSch
  and 0           == PrVidOpl77.Choice
  and (PrVidOpl77.VidOpl = 77)

  and lschet.nrec == PrVidOpl7799.cLSch
  and 99          == PrVidOpl7799.Choice
  and (PrVidOpl7799.VidOpl = 77)

//  and GP_tZarHelz._year == sumvidop.yearn
//  and GP_tZarHelz._Mes == sumvidop.mesn
  and GP_tZarHelz._year == sumvidop.yeark
  and GP_tZarHelz._Mes == sumvidop.mes
  and klvidoplPrem.vidopl == sumvidop.vidopl
  and Lschet.DatPos<<= sumvidop.DataN(noindex)
  //------------------
  and lschet.nrec == nachisl.clsch
//  and GP_tZarHelz._year == sumvidop.yearn
//  and GP_tZarHelz._Mes == sumvidop.mesn
  and GP_tZarHelz._year == nachisl.yeark
  and GP_tZarHelz._Mes  == nachisl.mes
  and klvidoplPrem.vidoplp == nachisl.vidopl
  and klvidoplPrem.vidopl == nachisl.vidopls(noindex)
  and Lschet.DatPos<<= nachisl.DataN(noindex)

   ));
!--------------------------------------
.create view v1
as select GP_tZarHelZ._year
from GP_tZarHelZ;
!-----------------------------------
.create view v_WT
var
  wMes :word;
  wYear:word;
  pLsch :comp;
  wRejim :word;//UP.ZAR.REJIM5
as select
  LsTab.Nrec
from LsTab, KlNdr
where  ((
     pLsch == LsTab.cLschet
and  wYear == LsTab.Yearn
and  wMes  == LsTab.MesN
and  wYear == klndr.YEARK
and  wMes  == klndr.MONTHK
and  wRejim     == klndr.rejim //1.12 Восемь часов в день сорок часов в неделю

))
;
.Create view vKlVidopl
var
 _NVIDOPL:string;
as select klvidopl.NALG

from KlVidopl
where
((   _NVIDOPL == KLVIDOPL.NVIDOPL
and  KLVIDOPL.NALG == KLALG.KALG
));
!-----------------------------------
! Получить процент оплаты
!-----------------------------------
.Function GetProc:double;
begin
 Result:=1;
 set vKlVidopl._NVIDOPL:=trim(naim);
 var ii:word;
 //0D + 0D
 ii:=pos(chr(13)+chr(13),vKlVidopl._NVIDOPL);
 if ii>0
 {  vKlVidopl._NVIDOPL:=SubStr(vKlVidopl._NVIDOPL,ii+2,250);
 }
 vKlVidopl._NVIDOPL:=Replace(vKlVidopl._NVIDOPL,' (руб.)','');
 timelog('GP_Zarhelz1:GetProc _NVIDOPL='+vKlVidopl._NVIDOPL);
 if vKlVidopl.getfirst KLVIDOPL<>tsok then exit;
 if vKlVidopl.KLVIDOPL.VidOpl = 67                //#3259
   result := vKlVidopl.KLVIDOPL.KFOPL/100;
 else
 {
   timelog('GP_Zarhelz1:GetProc KLVIDOPL.NALG='+String(vKlVidopl.KLVIDOPL.NALG));
   if vKlVidopl.KLVIDOPL.NALG<100 then exit;
   if vKlVidopl.getfirst KLALG<>tsok then exit;
   timelog('GP_Zarhelz1:GetProc KLALG.STROALG='+vKlVidopl.KLALG.STROALG);
   //138 if ((WT_GetOverworkCalculationMethod(1)=2),SumalgNPD(70,93,'Ч'),SumalgNPD(70,93,'Д'))*KLVO_PROC/100
   if pos('KLVO_PROC',vKlVidopl.KLALG.STROALG)>0
   { Result:=vKlVidopl.KLVIDOPL.KFOPL/100;
     timelog('GP_Zarhelz1:GetProc Result='+String(Result,0,2));
   }
 }
end.
!-----------------------------------
.Function GetVidOpl: word;
begin
 Result := 0;
 set vKlVidopl._NVIDOPL := trim(naim);
 var ii: word;
 ii := pos(chr(13)+chr(13),vKlVidopl._NVIDOPL);
 if ii > 0
   vKlVidopl._NVIDOPL := SubStr(vKlVidopl._NVIDOPL,ii+2,250);
 vKlVidopl._NVIDOPL := Replace(vKlVidopl._NVIDOPL,' (руб.)','');
 if vKlVidopl.getfirst KLVIDOPL = tsok
   result := vKlVidopl.KLVIDOPL.VidOpl;
end.
.Procedure CheckLSchetDatUv;
Begin
 Var tmpNrec : Comp;
  
  //Может быть несколько записей в LSchet. Ищу запись, где нет даты увольнения 
  If(v.LSchet.DatUv <> ZeroDate)
  { 
    tmpNrec := v.LSchet.nrec;//запомнить идентификатор записи
    if (v.GetFirst LSchet Where(ZeroDate = LSchet.DatUv)) <> tsOk
    {
      //Если не удалось найти, то возврат к исходной 
      if v.GetFirst LSchet Where((tmpNrec == LSchet.nrec)) = tsOk
      {}
    }
  }  
End.
.Function GetPrVidOpl77Sum: double;
begin
  result := 0;
  __fio:= fio;
  __tabn:= tabn;
  if v.GetFirst LSchet = tsOk
  {
    CheckLSchetDatUv;
    if v.getfirst PrVidOpl77 = tsOk
      result := v.PrVidOpl77.Summa;
    else if v.getfirst PrVidOpl7799 = tsOk
      result := v.PrVidOpl7799.Summa;
  }
end.
!-----------------------------------
.function CalcWorkDay(_wMes:word;_wYear:word):word;
var
  ii:word;
begin
 v_wt.wRejim :=coGetTune('UP.ZAR.REJIM5');
 Result:=0;
   v_Wt.pLsch:=v.Lschet.Nrec;
   v_Wt.wMes :=_wMes ;
   v_Wt.wYear:=_wYear;
   if v_Wt.getfirst Klndr=tsok
     if v_Wt.getfirst Lstab=tsok
     for(ii:=1;ii<=31;ii++)
     { if (v_wt.LSTAB.DAYCHF[ii]>0 and v_wt.LSTAB.DAYCHF[ii]<25)
       or v_wt.LSTAB.DAYS[ii]='В'
       or v_wt.LSTAB.DAYS[ii]='ЛЧ'
       { if v_Wt.KLNDR.DAYCHAS[ii]>0
           Result++;
       }
     }
 end.
!--------------------------------------
.Procedure CalcItog_CH;
begin
  __fio:= fio;
  __tabn:= tabn;

  _Sredchasf :=double(trim(Sredchasf));
  _SredchasGr:=double(trim(SredchasGr));
  //if v.getfirst persons = tsOk {}
  if v.getfirst lschet = tsOk 
  { CheckLSchetDatUv; }
  //==== будем брать стандарт!!! =========
  timelog('GP_Zarhelz1:CalcItog_CH __fio='+__fio
       +', __tabn='+__tabn+', Lschet.strtabn='+v.Lschet.strtabn);

  //====== будем брать стандарт!!! ===========
  //EXIT;
  //==== будем брать стандарт!!! =========
  timelog('GP_Zarhelz1:CalcItog_CH _Sredchasf='+string(_Sredchasf,0,2)
       +', _SredchasGr='+string(_SredchasGr,0,2));
  if Раб_ч='Часы'
  {  _SredchasGr:=0;
     v._Loop fullcache GP_tZarHelZ
     { Loadworkingtable(v.lschet.Nrec,v.GP_tZarHelZ._mes,v.GP_tZarHelZ._year);
       v.update current GP_tZarHelZ
         set GP_tZarHelZ._chasGr:=String(WT_GetHoursEx(hkWorking , stPlanned , cfDisregardFilters),0,2);
       _SredchasGr:=_SredchasGr+double(v.GP_tZarHelZ._chasGr);
       timelog('GP_Zarhelz1:часы граф. '+string(v.GP_tZarHelZ._mes)+','+v.GP_tZarHelZ._chasGr+','+string(_SredchasGr))

     }
     // в часах пересчет не очень
     //_SredchasF :=WT_GetDays(hkWorking , stActual );
     //if _Sredchasf>_SredchasGr
     //_Sredchasf:=_SredchasGr;
  }
  else
  { _Sredchasf1:=_Sredchasf;
    _Sredchasf:=0;
    v._Loop fullcache GP_tZarHelZ
    { if v.GP_tZarHelZ._chasGr>26 // календарные?
      {  _Sredchasf:=_Sredchasf+v.GP_tZarHelZ._chasf;
      }
      else
      { _Sredchasf:=_Sredchasf+CalcWorkDay(v.GP_tZarHelZ._mes, v.GP_tZarHelZ._year );
      }
      timelog('GP_Zarhelz1:часы факт. '+string(v.GP_tZarHelZ._mes)+','+v.GP_tZarHelz._chasGr+','+string(_Sredchasf))
    }
    if _Sredchasf=0
      _Sredchasf:=_Sredchasf1;
  }
 end.
!--------------------------------------
.Procedure CalcPrem;
begin
  Premi1 := 0;
  Premi2 := 0;
_delta:=0;

  v._loop klvidoplPrem {
    v._loop sumvidop {
      if v.klvidoplPrem.Vidopl=30 // пока не знаем как
        Premi2 += v.sumvidop.summa
      else
        Premi1 += v.sumvidop.summa;

      timelog('GP_Zarhelz1:нач.арх.'+string(v.GP_tZarHelZ._mes)
         +','+string(v.GP_tZarHelZ._Year)+','+string(v.sumvidop.summa,0,2)+','+string(v.klvidoplPrem.Vidoplp))
    }
    v._loop nachisl {
      if v.klvidoplPrem.Vidopl=30
        Premi2 += v.nachisl.summa
      else
        Premi1 += v.nachisl.summa;
      timelog('GP_Zarhelz1:нач.тек.'+string(v.GP_tZarHelZ._mes)
        +','+string(v.GP_tZarHelZ._Year)+','+string(v.nachisl.summa,0,2)+','+string(v.klvidoplPrem.Vidoplp))
    }
  } //v._loop klvidoplPrem {

 PremiSum := PremiSum+  Premi1;
 PremiSum2:= PremiSum2+ Premi2;

 if not kl_Prem
 { timelog('GP_Zarhelz1:заработок 01 '+string(v.GP_tZarHelZ._mes)
        +','+string(v.GP_tZarHelZ._year)+','+v.GP_tZarHelZ._SredSumma
               +',ч.ф.'+string(_Sredchasf)+',ч.гр.'+string(_SredchasGr));
   _delta:=0;
   if _SredchasGr>0
   { _delta:=round((Premi2+Premi1)*_Sredchasf/_SredchasGr,2);
   }
   v.GP_tZarHelZ._SredSumma:=String(double(v.GP_tZarHelZ._SredSumma)
       -_delta,0,2);
   timelog('GP_Zarhelz1:заработок 02 '+string(v.GP_tZarHelZ._mes)
        +','+string(v.GP_tZarHelZ._year)+','+v.GP_tZarHelZ._SredSumma+','+string(_delta,0,2)
        +', ч.ф.'+string(_Sredchasf)+', ч.г.'+string(_SredchasGr)
        );
   v.update current GP_tZarHelZ;

 }
 c:= c+1;
 IT_su1+=double(v.GP_tZarHelZ._SredSumma);
end.
!--------------------------------------
.Procedure InsTmp;
begin

//c 70 алгоритмом  убирать не нужно
if double(SredPremi)>0 kl_Prem:=true;
v1.insert GP_tZarHelZ set
  GP_tZarHelZ._year:= Year(StrToDate(mes,'MM/YYYY')),
  GP_tZarHelZ._mes:= month(StrToDate(mes,'MM/YYYY')),
  GP_tZarHelZ._chasf:= chasf,
  GP_tZarHelZ._chasGr:= chasGr,
  GP_tZarHelZ._SredSumma:=double(SredSumma),//-double(SredPremi), - годовая не сидит в ЗП!!
  GP_tZarHelZ._SredKoef:=SredKoef
  ;
//С перерасчетом премии
end.
