create table default.EM_NeyavRV_Report "Сводка о потерях рабочего времени"
       with table_Code = 31625
       with tableOptions header, journal, corpo
(
      strtabn     : string
    , Kateg       : LongInt
    , cexoz       : comp
    , cex         : comp
    , Kodcex      : string
    , VidPr       : string
    , KodOtd      : string
    , Dolzhn      : string
    , datpos      : date
    , datuv       : date
    , clstab      : comp
    , clschet     : comp
    , sovm        : LongInt
    , fio         : string
    , PlanCh      : decimal(31, 15)
    , OtrabCh     : decimal(31, 15)
    , PlanDays    : decimal(31, 15)
    , PlanCalDays : decimal(31, 15)
    , OtrabDays   : decimal(31, 15)
    , OtrabHolid  : decimal(31, 15)
    , OtrabSverh  : decimal(31, 15)
    , Vid         : string
    , Name        : string
    , Prizn       : LongInt
    , chasf       : decimal(31, 15)
    , koldn       : decimal(31, 15)
    , SOVPROC     : decimal(31, 15)
    , KoldnPlan   : decimal(31, 15)
    , ChasfPlan   : decimal(31, 15)
    , strRes1     : string
    , strRes2     : string
    , strRes3     : string
    , compRes1    : comp
    , compRes2    : comp
    , compRes3    : comp
    , dRes1       : decimal(31, 15)
    , dRes2       : decimal(31, 15)
    , dRes3       : decimal(31, 15)
)
with index(
      v01=KodCex + Kateg + Vid
    , v02=Prizn
    , v03=KodCex + Kateg + Prizn + sovm
    , v04=KodCex + Vid + Kateg
    , v05=VidPr + Kateg + Vid
    , v06=VidPr + Kateg + Prizn
    , v07=VidPr + Vid + Kateg
    , v08=Vid + Kateg
    , v09=Prizn
    , v10=Kateg + Prizn
    , v11=KodCex + prizn + sovm
);