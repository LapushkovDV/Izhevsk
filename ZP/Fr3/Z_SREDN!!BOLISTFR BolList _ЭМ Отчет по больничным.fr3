<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="E:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40786,6755902083" ReportOptions.Description.Text="" ReportOptions.Name="_ЭМ Отчет по больничным" ReportOptions.LastChange="44226,4809924768" ScriptLanguage="PascalScript" ScriptText.Text="procedure GroupHeader2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;SORTTABN.&#34;DOPPR&#34;&#62; = '5' then&#13;&#10;    begin&#13;&#10;      Memo10.Visible := False;&#13;&#10;      Memo11.Visible := False;&#13;&#10;      Memo12.Visible := False;&#13;&#10;      Memo16.Visible := False;&#13;&#10;      Memo17.Visible := False;&#13;&#10;      Memo18.Visible := False;&#13;&#10;      Memo21.Visible := False;&#13;&#10;      Memo22.Visible := False;&#13;&#10;      Memo50.Visible := False;&#13;&#10;      Memo69.Visible := False;&#13;&#10;    //  Memo7.Width    := 150;&#13;&#10;     // Memo8.Width    := 150;   Memo8.Left := 150;&#13;&#10;     // Memo9.Width    := 380;   Memo9.Left := 300;&#13;&#10;    //  Memo13.Width   := 150;&#13;&#10;    //  Memo14.Width   := 150;   Memo14.Left := 150;&#13;&#10;    //  Memo15.Width   := 380;   Memo15.Left  := 300;&#13;&#10;    //  Memo19.Width   := 300;&#13;&#10;    //  Memo46.Width   := 300;&#13;&#10;    //  Memo20.Width   := 380;    Memo20.Left := 300;&#13;&#10;    //  Memo53.Width   := 380;    Memo53.Left := 300;&#13;&#10;    end&#13;&#10;  else&#13;&#10;    begin&#13;&#10;      Memo6.Visible  := True;&#13;&#10;      Memo10.Visible := True;&#13;&#10;      Memo11.Visible := True;&#13;&#10;      Memo12.Visible := True;&#13;&#10;      Memo16.Visible := True;&#13;&#10;      Memo17.Visible := True;&#13;&#10;      Memo18.Visible := True;&#13;&#10;      Memo21.Visible := True;&#13;&#10;      Memo22.Visible := True;&#13;&#10;      Memo5.Visible  := True;&#13;&#10;      Memo50.Visible := True;&#13;&#10;      Memo69.Visible := True;&#13;&#10;    //  Memo7.Width    := 97;&#13;&#10;    //  Memo8.Width    := 72.5;  Memo8.Left  := 96.92;&#13;&#10;    //  Memo9.Width    := 170;   Memo9.Left  := 170;&#13;&#10;    //  Memo13.Width   := 97;&#13;&#10;    //  Memo14.Width   := 72.5;  Memo14.Left := 96.92;&#13;&#10;    //  Memo15.Width   := 170;   Memo15.Left := 170;&#13;&#10;    //  Memo19.Width   := 187;&#13;&#10;    //  Memo46.Width   := 187;&#13;&#10;    //  Memo20.Width   := 155;   Memo20.Left := 186;&#13;&#10;    //  Memo53.Width   := 154;  Memo53.Left := 187;&#13;&#10;    end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo5OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;ZARPL.&#34;FIRSTYEAR&#34;&#62; &#60;&#62; 0) and  (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62; '5')  then&#13;&#10;    Memo5.Text  := FormatdateTime('YYYY', EncodeDate(&#60;ZARPL.&#34;FIRSTYEAR&#34;&#62;,1,1))&#13;&#10;  else&#13;&#10;    Memo5.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo13OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;ZARPL.&#34;FIRSTMONTH&#34;&#62; &#60;&#62; 0 then&#13;&#10;  begin&#13;&#10;    if &#60;SORTTABN.&#34;DOPPR&#34;&#62; = '5' then&#13;&#10;      Memo13.Text := FormatdateTime('mm', EncodeDate(1900,&#60;ZARPL.&#34;FIRSTMONTH&#34;&#62;,1))+&#60;SORTTABN.&#34;SEPARATOR&#34;&#62;+ FormatdateTime('YYYY', EncodeDate(&#60;ZARPL.&#34;FIRSTYEAR&#34;&#62;,1,1))&#13;&#10;    else  Memo13.Text := FormatdateTime('mmmm', EncodeDate(1900,&#60;ZARPL.&#34;FIRSTMONTH&#34;&#62;,1))&#13;&#10;  end&#13;&#10;  else Memo13.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;ZARPL.&#34;LASTYEAR&#34;&#62; &#60;&#62; 0) and  (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62; '5') then&#13;&#10;    Memo6.Text  := FormatdateTime('YYYY', EncodeDate(&#60;ZARPL.&#34;LASTYEAR&#34;&#62;,1,1))&#13;&#10;  else&#13;&#10;    Memo6.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo16OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   if &#60;ZARPL.&#34;LASTMONTH&#34;&#62; &#60;&#62; 0 then&#13;&#10;    Memo16.Text := FormatdateTime('MMMM', EncodeDate(1900,&#60;ZARPL.&#34;LASTMONTH&#34;&#62;,1))&#13;&#10;  else Memo16.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo14OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;ZARPL.&#34;FIRSTMONTH&#34;&#62; = 0 then Memo14.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo15OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;ZARPL.&#34;FIRSTMONTH&#34;&#62; = 0 then Memo15.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo46OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62;'') and ((&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 7) or (&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 4)) then&#13;&#10;    memo46.Text := &#60;SORTTABN.&#34;FIRSTYEARSUM&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo53OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62;'') and ((&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62; 7) or (&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 4)) then&#13;&#10;    memo53.text :=  memo46.Text&#13;&#10;  else memo53.text :=&#60;SORTTABN.&#34;FIRSTSUMRAS&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo54OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62;'') and (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62; '7')&#13;&#10;                               and (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62; '4') then&#13;&#10;    begin&#13;&#10;      memo54.DisplayFormat.Kind := fkNumeric;&#13;&#10;      memo54.DisplayFormat.FormatStr := '%2.2n';&#13;&#10;      memo54.text := memo46.Text;&#13;&#10;    end&#13;&#10;  else&#13;&#10;    begin&#13;&#10;      memo54.DisplayFormat.Kind := fkNumeric;&#13;&#10;      memo54.DisplayFormat.FormatStr := '%2.2n';&#13;&#10;      memo54.text := &#60;SORTTABN.&#34;ITOGORAS&#34;&#62;;&#13;&#10;    end;&#13;&#10; end;&#13;&#10;&#13;&#10;procedure Memo7OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;ZARPL.&#34;FIRSTMONTH&#34;&#62; &#60;&#62; 0 then&#13;&#10;  begin&#13;&#10;    if &#60;SORTTABN.&#34;DOPPR&#34;&#62; = '5' then&#13;&#10;      Memo7.Text := 'Месяц, год'&#13;&#10;    else   Memo7.Text := 'Месяц'&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;ZARPL.&#34;FIRSTDAYS&#34;&#62;=0) and (&#60;ZARPL.&#34;FIRSTZARP&#34;&#62;=0) and&#13;&#10;     (&#60;ZARPL.&#34;LASTDAYS&#34;&#62;=0)  and (&#60;ZARPL.&#34;LASTZARP&#34;&#62;=0)&#13;&#10;  then DetailData1.Visible := False&#13;&#10;  else DetailData1.Visible := True;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Footer1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (SUM(&#60;ZARPL.&#34;FIRSTDAYS&#34;&#62;,DetailData1)+SUM(&#60;ZARPL.&#34;LASTDAYS&#34;&#62;,DetailData1))= 0 then&#13;&#10;    begin&#13;&#10;      Footer1.Height := 0.50;&#13;&#10;      Memo49.Visible := True;&#13;&#10;    end&#13;&#10;  else&#13;&#10;    begin&#13;&#10;      Memo49.Visible := False;&#13;&#10;      Footer1.Height := 0;&#13;&#10;    end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;ARBOL.&#34;KOLDNM&#34;&#62; = 0) and (&#60;ARBOL.&#34;SUMMA&#34;&#62; = 0)   //(&#60;ARBOL.&#34;DATANM&#34;&#62; = 0) and (&#60;ARBOL.&#34;DATOK&#34;&#62; = 0) and&#13;&#10;  then DetailData2.Visible := False&#13;&#10;  else DetailData2.Visible := True;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ARBOLWITHPERCENTOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var okr : integer;&#13;&#10;begin&#13;&#10;  if (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 1) or (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 2) then&#13;&#10;    okr := 3&#13;&#10;  else okr := 2;&#13;&#10;  ARBOLWITHPERCENT.DisplayFormat.Kind := fkNumeric;&#13;&#10;  ARBOLWITHPERCENT.DisplayFormat.FormatStr := '%2.'+ IntToStr(okr) +'n';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ARBOLSUMMAOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var okr : integer;&#13;&#10;begin&#13;&#10;  if (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 1) or (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 2) then&#13;&#10;    okr := 3&#13;&#10;  else okr := 2;&#13;&#10;  ARBOLSUMMA.DisplayFormat.Kind := fkNumeric;&#13;&#10;  ARBOLSUMMA.DisplayFormat.FormatStr := '%2.'+ IntToStr(okr) +'n';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ARBOLSRZFZPMOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var okr : integer;&#13;&#10;begin&#13;&#10;  if (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 1) or (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 2) then&#13;&#10;    okr := 3&#13;&#10;  else okr := 2;&#13;&#10;  ARBOLSRZFZPM.DisplayFormat.Kind := fkNumeric;&#13;&#10;  ARBOLSRZFZPM.DisplayFormat.FormatStr := '%2.'+ IntToStr(okr) +'n';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo25OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;SORTTABN.&#34;DAYSORHOURS&#34;&#62; = 'Часов' then&#13;&#10;  begin&#13;&#10;    Memo25.Text := 'Средний час. заработок'&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo26OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;SORTTABN.&#34;DAYSORHOURS&#34;&#62; = 'Часов' then&#13;&#10;  begin&#13;&#10;    Memo26.Text := 'Средний час. из МРОТ'&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo32OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;SORTTABN.&#34;DAYSORHOURS&#34;&#62; = 'Часов' then&#13;&#10;  begin&#13;&#10;    Memo32.Text := 'Сред. ч.'&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." ShowProgress="False" PropData="">
