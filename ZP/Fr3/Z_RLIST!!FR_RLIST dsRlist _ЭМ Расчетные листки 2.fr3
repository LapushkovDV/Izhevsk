<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="E:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38526,6758464236" ReportOptions.Description.Text="" ReportOptions.Name="_ЭМ Расчетные листки 2" ReportOptions.LastChange="45750,3919221181" ScriptLanguage="PascalScript" ScriptText.Text="//19.03.2019 Memo94: Could not convert variant of type (OleStr) into type (Double)  - DetailData8, Неявки&#13;&#10;//замен&#13;&#10;//[TMPABSENCEATTR.&#34;DAYS&#34;] дн. [TMPABSENCEATTR.&#34;HOURS&#34; #n%2,2f] ч.&#13;&#10;//на&#13;&#10;//[TMPABSENCEATTR.&#34;DAYS&#34;] дн. [TMPABSENCEATTR.&#34;HOURS&#34;] ч.&#13;&#10;var&#13;&#10;  TrueNum, HeightFio : variant;&#13;&#10;  PageLineCount: variant;&#13;&#10;  TecCounter: variant;&#13;&#10;  strNonTaxible: variant;&#13;&#10;  s, FixedSNaRuki: string;&#13;&#10;  CountUd, CountP, st : integer;&#13;&#10;  ItogoUd, ItogoP, FixedSumNaRuki, UderCorpCard, TotalSum, DolgPred: double;&#13;&#10;  isThereCorpCard: boolean;&#13;&#10;//по работающим сотрудникам: 253 вид показывать в удержаниях, 500 вид удержания– сумма на руки&#13;&#10;//- по уволенным сотрудникам: если в результатах расчета 253 вид удержания (и нет 500),&#13;&#10;// то 253 выводить в сумму на руки, если в результатах расчета есть и 253 и 500,&#13;&#10;//то 253  - в удержаниях , 500- сумма на руки.&#13;&#10;  wType220:word; // 500 во&#13;&#10;  wType208:word; // 253 во&#13;&#10;// Для сортировки - при &#60;dsRlist.&#34;Type_Sort&#34;&#62;&#62;0 разрежем страницу по первым 10 символам&#13;&#10;  sKEY_SORT:string;&#13;&#10;&#13;&#10;procedure Memo14OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo14, Engine do&#13;&#10;  begin&#13;&#10;  if &#60;PAGE#&#62; = 1 then&#13;&#10;    s:= 'Предприятие : '+ &#60;dsRlist.&#34;XARNAME&#34;&#62;&#13;&#10;  else&#13;&#10;    s:= '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure BeforePrintNonTaxible(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;dsRlist.&#34;COUNTRYPARAM&#34;&#62; = 1 then&#13;&#10;    strNonTaxible := '=================    Стандартные вычеты: '+  FormatFloat('# ##0',&#60;NONTAXABLE.&#34;DONONTAXABLE&#34;&#62;)+'  ================= '&#13;&#10;  else&#13;&#10;    strNonTaxible := '=================    необлагаемая сумма: '+  FormatFloat('# ##0.00',&#60;NONTAXABLE.&#34;DONONTAXABLE&#34;&#62;)+ ' учтено:  '+ FormatFloat('# ##0.00',&#60;NONTAXABLE.&#34;DOACCOUNTED&#34;&#62;)  +'  ================= '&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Page1, Engine do&#13;&#10;  begin&#13;&#10;   TrueNum := 0;&#13;&#10;   PageLineCount := 62;&#13;&#10;   TecCounter := 0;&#13;&#10;   strNonTaxible := '';&#13;&#10;   TotalSum := 0;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  dsDataSet    : TFrxDAtaset;&#13;&#10;&#13;&#10;begin&#13;&#10;  CountUd := 0;&#13;&#10;  CountP  := 0;&#13;&#10;  TotalSum:= 0;&#13;&#10;  ItogoUd := 0;&#13;&#10;  DolgPred:= 0;&#13;&#10;  //-------------------------&#13;&#10;  // Определим куда надо печатать 253 - в удержаних или в сумму на руки.&#13;&#10;  wType220:=1; // 500 во - в сумму на руки&#13;&#10;  wType208:=0; // 253 во - в удержания&#13;&#10;&#13;&#10;  //if &#60;FORMARKS.&#34;sDatUv&#34;&#62;&#60;&#62;'' then // уволен&#13;&#10;  if False then // уволен&#13;&#10;  begin&#13;&#10;    dsDataSet := Report.GetDataSet('UderSum');&#13;&#10;    dsDataSet.First;&#13;&#10;    // читаем данные из потока&#13;&#10;    wType208:=1;&#13;&#10;    while not dsDataSet.EOF do&#13;&#10;    begin&#13;&#10;      if &#60;UderSum.&#34;UVidS&#34;&#62;=220 then begin&#13;&#10;        wType208:=0;&#13;&#10;        break;&#13;&#10;      end;&#13;&#10;      dsDataSet.Next;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;  //----------------------------&#13;&#10;  st := 1;&#13;&#10;  with MasterData1, Engine do&#13;&#10;  begin&#13;&#10; Inc(TecCounter);&#13;&#10; if TecCounter &#62; 1 then&#13;&#10;   Line3.Visible := true;&#13;&#10;&#13;&#10; //If ( ( (PageLineCount - TrueNum) &#60; ( &#60;FORMARKS.&#34;LINECOUNTER&#34;&#62; + &#60;FORMARKS.&#34;LINECOUNTER2&#34;&#62; + 1+5))&#13;&#10; //If ( ( (PageLineCount - TrueNum) &#60; ( &#60;FORMARKS.&#34;LINECOUNTER&#34;&#62; + &#60;FORMARKS.&#34;LINECOUNTER2&#34;&#62; + 1+5+5))&#13;&#10; If ( ( (PageLineCount - TrueNum) &#60; ( &#60;FORMARKS.&#34;LINECOUNTER&#34;&#62; + &#60;FORMARKS.&#34;LINECOUNTER2&#34;&#62;))&#13;&#10; or (   (&#60;dsRlist.&#34;Type_Sort&#34;&#62;&#62;0)&#13;&#10;    and (copy(&#60;Formarks.&#34;KEY_SORT&#34;&#62;,1,10)&#60;&#62;copy(sKEY_SORT,1,10) )&#13;&#10;    )&#13;&#10; ) and (TrueNum &#60;&#62; 0)&#13;&#10; then&#13;&#10; begin&#13;&#10;   NEWPAGE;&#13;&#10;   TrueNum := 0;&#13;&#10;   Line3.Visible := false;&#13;&#10;   sKEY_SORT:=&#60;Formarks.&#34;KEY_SORT&#34;&#62;;&#13;&#10; end;&#13;&#10; end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo52OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo52, Engine do&#13;&#10;  begin&#13;&#10; TrueNum := TrueNum + 4 + 2;//отдельной строкой оклад&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo53OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo53, Engine do&#13;&#10;  begin&#13;&#10; TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo54OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo54, Engine do&#13;&#10;  begin&#13;&#10; TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo55OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo55, Engine do&#13;&#10;  begin&#13;&#10; TrueNum := TrueNum + 2;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo69OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo69, Engine do&#13;&#10;  begin&#13;&#10; TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo51OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo51, Engine do&#13;&#10;  begin&#13;&#10; TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo60OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo60, Engine do&#13;&#10;  begin&#13;&#10; TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo64OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo64, Engine do&#13;&#10;  begin&#13;&#10;   if &#60;COUNT(DetailData3)&#62; = 0 then&#13;&#10;      Memo61.Frame.Typ := 6;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo63OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo63, Engine do&#13;&#10;  begin&#13;&#10; TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo67OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo67, Engine do&#13;&#10;  begin&#13;&#10;   if &#60;COUNT(DetailData3)&#62; &#62; 0 then&#13;&#10;      Memo61.Frame.Typ := 4&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo68OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo68, Engine do&#13;&#10;  begin&#13;&#10; TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo154OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo154, Engine do&#13;&#10;  begin&#13;&#10; TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo157OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo157, Engine do&#13;&#10;  begin&#13;&#10; TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo112O