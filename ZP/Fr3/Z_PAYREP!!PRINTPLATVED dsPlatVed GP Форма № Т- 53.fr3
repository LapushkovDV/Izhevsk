<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.DoublePass="True" EngineOptions.TempDir="E:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38533,4550155787" ReportOptions.Description.Text="" ReportOptions.Name="GP Форма № Т- 53" ReportOptions.LastChange="45749,6445331944" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  VedomPageNo: longint;    // Счетчик страниц внутри ведомости&#13;&#10;  VedomRowsCount: longint; // Счетчик строк внутри ведомости&#13;&#10;  VedomPageSum: variant;   // Счетчик итогов по странице&#13;&#10;  VedomTotalSum: variant;  // Счетчик итогов по ведомости&#13;&#10;&#13;&#10;  VedomPageNo1: longint;    // Счетчик страниц внутри ведомости&#13;&#10;  VedomRowsCount1: longint; // Счетчик строк внутри ведомости&#13;&#10;  VedomPageSum1: variant;   // Счетчик итогов по странице&#13;&#10;  VedomTotalSum1: variant;  // Счетчик итогов по ведомости&#13;&#10;&#13;&#10;procedure VedomDataOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  // для каждой новой ведомости счетчики обнуляются&#13;&#10;  VedomPageNo1:=VedomPageNo-1;&#13;&#10;  VedomRowsCount := 0;&#13;&#10;  VedomPageNo := 1;&#13;&#10;  VedomPageSum := 0.0;&#13;&#10;  VedomTotalSum := 0.0;&#13;&#10;&#13;&#10;  if &#60;dsPlatVed.&#34;BARCODE&#34;&#62; = '' then&#13;&#10;    BarCode1.visible := false&#13;&#10;  else&#13;&#10;    BarCode1.visible := true&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure RowsDataInvisibleOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  VedomRowsCount := VedomRowsCount + 1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure RowsFooterInvisibleOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Engine.NewPage;  // спецификация ведомости будет печататься с нового листа&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PageHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  // каждый новый лист увеличивает счетчик страниц внутри ведомости&#13;&#10;  VedomPageNo := VedomPageNo + 1;&#13;&#10;&#13;&#10;  // каждый новый лист обнуляет итог по странице&#13;&#10;  VedomPageSum := 0.0;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure RowsDataOnAfterCalcHeight(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  RowsChild.Visible := false;&#13;&#10;&#13;&#10;  if ((Engine.FreeSpace + 0.1) &#60; (TfrxDetailData(Sender).Height + RowsChild.Height)) then&#13;&#10;  begin&#13;&#10;    RowsChild.Visible := true;&#13;&#10;    Engine.ShowBand(RowsChild);&#13;&#10;    RowsChild.Visible := false;&#13;&#10;    Engine.NewPage;&#13;&#10;    Engine.ShowBand(RowsHeader);&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    if &#60;Line#&#62; = VedomRowsCount then&#13;&#10;      if ((Engine.FreeSpace + 0.1) &#60; (TfrxDetailData(Sender).Height + RowsChild.Height + RowsFooter.Height)&#13;&#10;                                      //+ Child4.Height + Child5.Height&#13;&#10;                                      + Child11.Height) then&#13;&#10;      begin&#13;&#10;        // особая печать последного человека на отдельном листе&#13;&#10;        // если конец ведосмости не умещается на листе&#13;&#10;        RowsChild.Visible := true;&#13;&#10;        Engine.ShowBand(RowsChild);&#13;&#10;        RowsChild.Visible := false;&#13;&#10;        Engine.NewPage;&#13;&#10;        Engine.ShowBand(RowsHeader);&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure RowsFooterOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  // печать недостающего итога по странице&#13;&#10;  RowsChild.Visible := true;&#13;&#10;  Engine.ShowBand(RowsChild);&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo504OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  // агрегация итогов после выводе поля на печать&#13;&#10;  VedomPageSum := VedomPageSum + &#60;TMPSPPLATVEDFR.&#34;SUMMA&#34;&#62;;&#13;&#10;  VedomTotalSum := VedomTotalSum + &#60;TMPSPPLATVEDFR.&#34;SUMMA&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  If &#60;dsPlatVed.&#34;PECHITOG&#34;&#62; = 0 then&#13;&#10;  begin&#13;&#10;     //------------------&#13;&#10;     Memo100.visible := false;&#13;&#10;     Memo111.visible := false;&#13;&#10;     Memo112.visible := false;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  // явная инициализация переменных скрипта передначалом генерации отчета&#13;&#10;  // рекомендуется делать поскольку автоматически переменные не инициализируются&#13;&#10;  VedomPageNo := 0;&#13;&#10;  VedomPageSum := 0.0;&#13;&#10;  VedomTotalSum := 0.0;&#13;&#10;  VedomRowsCount := 0;&#13;&#10;//=== итоги&#13;&#10;  VedomRowsCount1 := 0;&#13;&#10;  VedomPageNo1 := 1;&#13;&#10;  VedomPageSum1 := 0.0;&#13;&#10;  VedomTotalSum1 := 0.0;&#13;&#10;&#13;&#10;end." ShowProgress="False" PropData="">
