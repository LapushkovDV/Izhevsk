<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="A:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41096,3512201736" ReportOptions.Description.Text="" ReportOptions.Name="Опись предоставленных документов (Приложение 3 к Приказу ФСС РФ 04.02" ReportOptions.LastChange="44707,3830697685" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  VReportName : TfrxMemoView;&#13;&#10;  BaseDoc, BaseStrDoc: TStringList;&#13;&#10;//------------------------------------------&#13;&#10;// функция печати по ячейкам&#13;&#10;//------------------------------------------&#13;&#10;function PrintField(AllStr : string; CountCell : integer; NameCell : string): Extended;&#13;&#10;  var i : integer;&#13;&#10;begin&#13;&#10;  if ( trim(AllStr) = '' ) then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  for i := 1 to CountCell do&#13;&#10;  begin&#13;&#10;    VReportName := TfrxMemoView(Report.FindObject(NameCell + IntToStr(i)));&#13;&#10;    if ( VReportName &#60;&#62; nil ) then&#13;&#10;      VReportName.Text := Uppercase(Copy(AllStr, i, 1));&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;//------------------------------------------&#13;&#10;// функция печати дат по ячейкам&#13;&#10;//------------------------------------------&#13;&#10;function PrintDateField(PrintData : Date; NameCell : string): Extended;&#13;&#10;  var Day, Month, Year, DateStr : String;&#13;&#10;begin&#13;&#10;  if ( FormatDateTime('DD.MM.YYYY', PrintData,) &#60;&#62; '30.12.1899' ) then&#13;&#10;  begin&#13;&#10;    Day := IntToStr(DayOf(PrintData));&#13;&#10;&#13;&#10;    if ( Length(Day) = 1 ) then&#13;&#10;      Day := '0' + Day;&#13;&#10;&#13;&#10;    Month := IntToStr(MonthOf(PrintData));&#13;&#10;&#13;&#10;    if ( Length(Month) = 1 ) then&#13;&#10;      Month := '0' + Month;&#13;&#10;&#13;&#10;    Year  := IntToStr(YearOf(PrintData));&#13;&#10;&#13;&#10;    DateStr := Day + Month + Year;&#13;&#10;&#13;&#10;    PrintField(DateStr, 8, NameCell);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;//--------------------------------------&#13;&#10;// функция вывода текста в ячейку&#13;&#10;//-------------------------------------&#13;&#10;function PrintStrField(AllStr : string; NameCell : string): Extended;&#13;&#10;begin&#13;&#10;  VReportName := TfrxMemoView(Report.FindObject(NameCell));&#13;&#10;  if ( VReportName &#60;&#62; nil ) then&#13;&#10;    VReportName.Text := AllStr;&#13;&#10;end;&#13;&#10;&#13;&#10;//--------------------------------------&#13;&#10;// функция печати телефона&#13;&#10;//-------------------------------------&#13;&#10;function PrintPhone(AllStr : string; CountCell : integer; NameCell : string): Extended;&#13;&#10;  var len, l, i : integer;&#13;&#10;  var sym       : string;&#13;&#10;begin&#13;&#10;  l   := 1;&#13;&#10;  len := Length(AllStr);&#13;&#10;&#13;&#10;  for i := len+1 downto 1 do&#13;&#10;  begin&#13;&#10;    sym := copy(AllStr, i, 1);&#13;&#10;    case sym of&#13;&#10;    '1', '2', '3', '4', '5',&#13;&#10;    '6', '7', '8', '9', '0' :&#13;&#10;      begin&#13;&#10;        VReportName := TfrxMemoView(Report.FindObject(NameCell + IntToStr(l)));&#13;&#10;        if ( VReportName &#60;&#62; nil ) then&#13;&#10;          VReportName.Text := Copy(AllStr, i, 1);&#13;&#10;        l := l +1;&#13;&#10;      end;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure RegNumber0OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;StatementtoFssFR.&#34;REGNUMBER&#34;&#62; &#60;&#62; '' ) then&#13;&#10;    PrintField(&#60;StatementtoFssFR.&#34;REGNUMBER&#34;&#62;, 10, 'RegNumber');&#13;&#10;  PrintField(&#60;StatementtoFssFR.&#34;SKODDOP&#34;&#62;, 10, 'sKodDop');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure KodPod0OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintField(&#60;StatementtoFssFR.&#34;SKODPOD&#34;&#62;, 5, 'KodPod');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure INN0OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintField(&#60;StatementtoFssFR.&#34;INN&#34;&#62;, 12, 'INN');&#13;&#10;  PrintField(&#60;StatementtoFssFR.&#34;KPP&#34;&#62;, 9, 'KPP');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2925OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintPhone(&#60;StatementtoFssFR.&#34;STEL_PRED&#34;&#62;, 17, 'sTel_PredNum');&#13;&#10;end;&#13;&#10;&#13;&#10;function fboPrintStr( _str : string; _numS : integer; _sCode : string; i : integer ) : boolean;&#13;&#10;  var lenStr : integer; // длинна строки&#13;&#10;  var height : double; // высота строки&#13;&#10;  var calcI : integer;  // расчетный I&#13;&#10;  var NextI : integer;  // следующий за расчетным&#13;&#10;begin&#13;&#10;  Result := false;&#13;&#10;&#13;&#10;  lenStr := Length(_str);&#13;&#10;&#13;&#10;  if ( lenStr = 0 ) then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  VReportName := TfrxMemoView(Report.FindObject('Doc' + IntToStr(_numS)));&#13;&#10;&#13;&#10;  if ( VReportName &#60;&#62; nil ) and&#13;&#10;     ( VReportName.Text = '' ) then&#13;&#10;    calcI := 0&#13;&#10;  else&#13;&#10;    calcI := i;&#13;&#10;&#13;&#10;  VReportName := TfrxMemoView(Report.FindObject('Doc' + IntToStr(_numS+calcI)));&#13;&#10;  if ( VReportName &#60;&#62; nil ) then&#13;&#10;  begin&#13;&#10;    VReportName.Text := _str;&#13;&#10;    height := VReportName.Height;&#13;&#10;  end;&#13;&#10;&#13;&#10;  VReportName := TfrxMemoView(Report.FindObject('Doc' + IntToStr(_numS+calcI)+ 'Str'));&#13;&#10;  if ( VReportName &#60;&#62; nil ) then&#13;&#10;  begin&#13;&#10;    VReportName.Text := _sCode;   // Кол-во стр.&#13;&#10;    VReportName.Height := height;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure VidVipOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var i, num, _List, k : integer;&#13;&#10;  var dsDocum : TfrxDataSet;&#13;&#10;begin&#13;&#10;  case &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; of&#13;&#10;    1 : VidVip.Text := '1'; // Нетрудоспособность&#13;&#10;    2 : VidVip.Text := '2'; // Беременность и роды&#13;&#10;    3 : VidVip.Text := '3'; // Ранние сроки беременности&#13;&#10;    4 : VidVip.Text := '4'; // Рождение ребенка&#13;&#10;    5 : VidVip.Text := '5'; // Уход за ребенком&#13;&#10;    6 : VidVip.Text := '6'; // Проф. травма, болезнь&#13;&#10;    9 : VidVip.Text := '9'; // Отпуск застрахованного лица&#13;&#10;  end;&#13;&#10;&#13;&#10;  Doc1.Text := ''; Doc1Str.Text := '';&#13;&#10;  Doc2.Text := ''; Doc2Str.Text := '';&#13;&#10;  Doc3.Text := ''; Doc3Str.Text := '';&#13;&#10;  Doc4.Text := ''; Doc4Str.Text := '';&#13;&#10;  Doc5.Text := ''; Doc5Str.Text := '';&#13;&#10;  Doc6.Text := ''; Doc6Str.Text := '';&#13;&#10;  Doc7.Text := ''; Doc7Str.Text := '';&#13;&#10;  Doc8.Text := ''; Doc8Str.Text := '';&#13;&#10;  Doc9.Text := ''; Doc9Str.Text := '';&#13;&#10;  Doc10.Text := ''; Doc10Str.Text := '';&#13;&#10;  Doc11.Text := ''; Doc11Str.Text := '';&#13;&#10;  Doc12.Text := ''; Doc12Str.Text := '';&#13;&#10;  i := 0; num :=0;&#13;&#10;&#13;&#10;  BaseDoc := TStringList.Create();&#13;&#10;  BaseStrDoc := TStringList.Create();&#13;&#10;&#13;&#10;  dsDocum := Report.GetDataSet('TP_DOCUMENTS');&#13;&#10;  dsDocum.First;&#13;&#10;&#13;&#10;  while not dsDocum.EOF do&#13;&#10;  begin&#13;&#10;    BaseDoc.Add( dsDocum.Value('NAME_DOC') );&#13;&#10;    BaseStrDoc.Add( dsDocum.Value('PAGE_DOC'));&#13;&#10;    dsDocum.NEXT;&#13;&#10;  end;&#13;&#10;&#13;&#10;  for _List := 0 to BaseDoc.Count-1 do&#13;&#10;  begin&#13;&#10;    if ( fboPrintStr( BaseDoc[_List], (_List + 1), BaseStrDoc[_List], i ) = true ) then&#13;&#10;    begin&#13;&#10;     i := i + 1;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  BaseDoc.Free;&#13;&#10;  BaseStrDoc.Free;&#13;&#10; end;&#13;&#10;&#13;&#10;procedure Memo9OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintField(&#60;StatementtoFssFR.&#34;Email&#34;&#62;, 15, 'Email');&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." ShowProgress="False" OnReportPrint="frxHLOnReportPrint" PropData="">
