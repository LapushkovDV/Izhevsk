<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="E:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38526,6758464236" ReportOptions.Description.Text="" ReportOptions.Name="_ЭМ Расчетные листки(-сокращенная форма)" ReportOptions.LastChange="43820,5060605671" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;//[TOTALSUMMS.&#34;DOFORTAXATION&#34;] -&#62;Nal_Doxod&#13;&#10;//[TOTALSUMMS.&#34;DOTOTALRETURN&#34;] -&#62;Nal_Doxod&#13;&#10;  TrueNum, HeightFio : variant;&#13;&#10;  PageLineCount: variant;&#13;&#10;  TecCounter: variant;&#13;&#10;  strNonTaxible: variant;&#13;&#10;  s, FixedSNaRuki: string;&#13;&#10;  CountUd, CountP, st : integer;&#13;&#10;  ItogoUd, ItogoP, FixedSumNaRuki, UderCorpCard, TotalSum, DolgPred: double;&#13;&#10;  isThereCorpCard: boolean;&#13;&#10;  Wotk_Days: double;&#13;&#10;  Work_Hour: string;&#13;&#10;  Nal_tabHelp:double;&#13;&#10;  Nal_Doxod:double;&#13;&#10;  Nal_Vichet:double;&#13;&#10;  Nal_Summa:double;&#13;&#10;  Num_list:longint;&#13;&#10;  boChild1:boolean;&#13;&#10;//по работающим сотрудникам: 253 вид показывать в удержаниях, 500 вид удержания– сумма на руки&#13;&#10;//- по уволенным сотрудникам: если в результатах расчета 253 вид удержания (и нет 500),&#13;&#10;// то 253 выводить в сумму на руки, если в результатах расчета есть и 253 и 500,&#13;&#10;//то 253  - в удержаниях , 500- сумма на руки.&#13;&#10;&#13;&#10;  wType220:word; // 500 во&#13;&#10;  wType208:word; // 253 во&#13;&#10;// Для сортировки - при &#60;dsRlist.&#34;Type_Sort&#34;&#62;&#62;0 разрежем страницу по первым 10 символам&#13;&#10;  sKEY_SORT:string;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo14OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo14, Engine do&#13;&#10;  begin&#13;&#10;  if &#60;PAGE#&#62; = 1 then&#13;&#10;    s:= 'Предприятие : '+ &#60;dsRlist.&#34;XARNAME&#34;&#62;&#13;&#10;  else&#13;&#10;    s:= '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure BeforePrintNonTaxible(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;dsRlist.&#34;COUNTRYPARAM&#34;&#62; = 1 then&#13;&#10;    strNonTaxible := '=================    Стандартные вычеты: '+  FormatFloat('# ##0',&#60;NONTAXABLE.&#34;DONONTAXABLE&#34;&#62;)+'  ================= '&#13;&#10;  else&#13;&#10;    strNonTaxible := '=================    необлагаемая сумма: '+  FormatFloat('# ##0.00',&#60;NONTAXABLE.&#34;DONONTAXABLE&#34;&#62;)+ ' учтено:  '+ FormatFloat('# ##0.00',&#60;NONTAXABLE.&#34;DOACCOUNTED&#34;&#62;)  +'  ================= '&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Page1, Engine do&#13;&#10;  begin&#13;&#10;   TrueNum := 0;&#13;&#10;   PageLineCount := 62;&#13;&#10;   TecCounter := 0;&#13;&#10;   strNonTaxible := '';&#13;&#10;   TotalSum := 0;&#13;&#10;   Wotk_Days:= 0;&#13;&#10;   Work_Hour:= '';&#13;&#10;   Nal_tabHelp:= 0;&#13;&#10;   Nal_Doxod  := 0;&#13;&#10;   Nal_Vichet := 0;&#13;&#10;   Nal_Summa  := 0;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  dsDataSet    : TFrxDAtaset;&#13;&#10;begin&#13;&#10;  CountUd := 0;&#13;&#10;  CountP := 0;&#13;&#10;  TotalSum:=0;&#13;&#10;  ItogoUd:=0;&#13;&#10;  Nal_tabHelp:= 0;&#13;&#10;  Nal_Doxod  := 0;&#13;&#10;  Nal_Vichet := 0;&#13;&#10;  Nal_Summa  := 0;&#13;&#10;  DolgPred   := 0;&#13;&#10;  //-------------------------&#13;&#10;  // Определим куда надо печатать 253 - в удержаних или в сумму на руки.&#13;&#10;  wType220:=1; // 500 во - в сумму на руки&#13;&#10;  wType208:=0; // 253 во - в удержания&#13;&#10;&#13;&#10; //не надо if &#60;FORMARKS.&#34;sDatUv&#34;&#62;&#60;&#62;'' then // уволен&#13;&#10; //------------------------------------------------------&#13;&#10; //--- проверим - нужно ли выводить Child1&#13;&#10;  boChild1:=false;&#13;&#10;&#13;&#10;  dsDataSet := Report.GetDataSet('NACHISLSUM_GP');&#13;&#10;  dsDataSet.First;&#13;&#10;  boChild1:=not dsDataSet.EOF;&#13;&#10;  dsDataSet.Close;&#13;&#10;  if not  boChild1 then begin&#13;&#10;    dsDataSet := Report.GetDataSet('UderSum');&#13;&#10;    dsDataSet.First;&#13;&#10;    boChild1:=not dsDataSet.EOF;&#13;&#10;    dsDataSet.Close;&#13;&#10;  end;&#13;&#10;  if not  boChild1 then begin&#13;&#10;    dsDataSet := Report.GetDataSet('NeNachSum');&#13;&#10;    dsDataSet.First;&#13;&#10;    boChild1:=not dsDataSet.EOF;&#13;&#10;    dsDataSet.Close;&#13;&#10;  end;&#13;&#10;  Child6.Visible:=boChild1;&#13;&#10;  Child5.Visible:=boChild1;&#13;&#10;  Child4.Visible:=boChild1;&#13;&#10;  Child3.Visible:=boChild1;&#13;&#10;  Child1.Visible:=boChild1;&#13;&#10;  if not boChild1 then exit;&#13;&#10; //--- проверим - нужно ли выводить Child1&#13;&#10; //------------------------------------------------------&#13;&#10;&#13;&#10;&#13;&#10;  if False then // уволен&#13;&#10;  begin&#13;&#10;    dsDataSet := Report.GetDataSet('UderSum');&#13;&#10;    dsDataSet.First;&#13;&#10;    // читаем данные из потока&#13;&#10;    wType208:=1;&#13;&#10;    while not dsDataSet.EOF do&#13;&#10;    begin&#13;&#10;      if &#60;UderSum.&#34;UVidS&#34;&#62;=220 then begin&#13;&#10;        wType208:=0;&#13;&#10;        break;&#13;&#10;      end;&#13;&#10;      dsDataSet.Next;&#13;&#10;    end;&#13;&#10;    dsDataSet.Close;&#13;&#10;  end;&#13;&#10;  //----------------------------&#13;&#10;&#13;&#10;  st := 1;&#13;&#10;&#13;&#10;  with MasterData1, Engine do&#13;&#10;  begin&#13;&#10; Inc(TecCounter);&#13;&#10; //if TecCounter &#62; 1 then&#13;&#10; //  Line3.Visible := true;&#13;&#10;&#13;&#10; //If ((PageLineCount - TrueNum) &#60; ( &#60;FORMARKS.&#34;LINECOUNTER&#34;&#62; + &#60;FORMARKS.&#34;LINECOUNTER2&#34;&#62; + 1+5)) and (TrueNum &#60;&#62; 0) then&#13;&#10; //If ((PageLineCount - TrueNum) &#60; ( &#60;FORMARKS.&#34;LINECOUNTER&#34;&#62; + &#60;FORMARKS.&#34;LINECOUNTER2&#34;&#62; + 1+10)) and (TrueNum &#60;&#62; 0) then&#13;&#10; //-------------------------&#13;&#10; //If ( ( (PageLineCount - TrueNum) &#60; ( &#60;FORMARKS.&#34;LINECOUNTER&#34;&#62; + &#60;FORMARKS.&#34;LINECOUNTER2&#34;&#62; + 1+10))&#13;&#10; //or (   (&#60;dsRlist.&#34;Type_Sort&#34;&#62;&#62;0)&#13;&#10; //   and (copy(&#60;Formarks.&#34;KEY_SORT&#34;&#62;,1,10)&#60;&#62;copy(sKEY_SORT,1,10) )&#13;&#10; //   )&#13;&#10; //) and (TrueNum &#60;&#62; 0)&#13;&#10; //-------------------------&#13;&#10; IF (TrueNum &#60;&#62; 0)&#13;&#10; then&#13;&#10; begin&#13;&#10;   //NEWPAGE;&#13;&#10;   NewColumn;&#13;&#10;   TrueNum := 0;&#13;&#10;  // Line3.Visible := false;&#13;&#10;   sKEY_SORT:=&#60;Formarks.&#34;KEY_SORT&#34;&#62;;&#13;&#10; end;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo53OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo53, Engine do&#13;&#10;  begin&#13;&#10; TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo54OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo54, Engine do&#13;&#10;  begin&#13;&#10; TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo55OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo55, Engine do&#13;&#10;  begin&#13;&#10; TrueNum := TrueNum + 2;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo51OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo51, Engine do&#13;&#10;  begin&#13;&#10; TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo60OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo60, Engine do&#13;&#10;  begin&#13;&#10; TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo64OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo64, Engine do&#13;&#10;  begin&#13;&#10;   if &#60;COUNT(DetailData3)&#62; = 0 then&#13;&#10;      Memo61.Frame.Typ := 6;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo67OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo67, Engine do&#13;&#10;  begin&#13;&#10;   if &#60;COUNT(DetailData3)&#62; &#62; 0 then&#13;&#10;      Memo61.Frame.Typ := 4&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo25OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'SUMMA', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo23OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'NAMEVID', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo21OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'VID', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo20OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'KOLCH', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo18OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'KOLDN', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo14OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'SAVEMES', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo43OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('UDERSUM' , 'USUMMA', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo42OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('UDERSUM' , 'UNAMEVID', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo41OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('UDERSUM' , 'UVID', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo38OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('UDERSUM' , 'USAVEMES', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo7OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  HeightFio := Memo7.Height;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo7OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;if Memo7.Height &#62; HeightFio then&#13;&#10;  TrueNum :=  TrueNum + int(Memo7.Height/HeightFio);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//Child8.visible := false;&#13;&#10;&#13;&#10;if ((&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 220)&#13;&#10; and (&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 171) and&#13;&#10;   ((&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 208) or (wType208=0)) ) then&#13;&#10; ItogoUd := ItogoUd + &#60;UDERSUM.&#34;USUMMA&#34;&#62;;&#13;&#10;&#13;&#10;if (&#60;UderSum.&#34;UVidS&#34;&#62; = 171) then&#13;&#10;DolgPred := DolgPred + &#60;UDERSUM.&#34;USUMMA&#34;&#62;;&#13;&#10;&#13;&#10;//if ((&#60;UDERSUM.&#34;TYPEUD&#34;&#62; = 2) and (&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 220)) then&#13;&#10;//ItogoP := ItogoP + &#60;UDERSUM.&#34;USUMMA&#34;&#62;;&#13;&#10;&#13;&#10;//if ((&#60;UDERSUM.&#34;TYPEUD&#34;&#62; = 2) and (st = 1)) then&#13;&#10;//begin&#13;&#10;//Child8.visible := true;&#13;&#10;//end;&#13;&#10;&#13;&#10;st := &#60;UDERSUM.&#34;TYPEUD&#34;&#62;;&#13;&#10;if st = 1 then&#13;&#10;  CountUd := CountUd + 1;&#13;&#10;//if ((st = 2) and (&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 220)) then&#13;&#10;//  CountP := CountP + 1;&#13;&#10;&#13;&#10;isThereCorpCard := false;&#13;&#10;if (&#60;UderSum.&#34;UVidS&#34;&#62; = 220) or ((&#60;UderSum.&#34;UVidS&#34;&#62; = 208) and (wType208=1))  then&#13;&#10;begin&#13;&#10;       isThereCorpCard := true;&#13;&#10;       UderCorpCard := &#60;UderSum.&#34;USumma&#34;&#62;;&#13;&#10;       TotalSum := TotalSum + &#60;UderSum.&#34;USumma&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;Child7.visible := (&#13;&#10;       (&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 220)&#13;&#10;   and (&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 171)&#13;&#10;   and ((&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 208) or (wType208=0))&#13;&#10;    );&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData2OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//   if (CountP = 0) then&#13;&#10;//   begin&#13;&#10;//       Child8.visible := false;&#13;&#10;//   end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailFooter2OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;//Child10.visible := true;&#13;&#10;//Child11.visible := false;&#13;&#10;//Child12.visible := false;&#13;&#10;&#13;&#10;if (CountP = 0) then&#13;&#10;begin&#13;&#10;//Child10.visible := true;&#13;&#10;//Child11.visible := false;&#13;&#10;//Child12.visible := false;&#13;&#10;end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Header1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  ItogoUd := 0;&#13;&#10;  ItogoP := 0;&#13;&#10;  DolgPred := 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo23OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Memo23.Height &#62; HeightFio then&#13;&#10;  TrueNum :=  TrueNum + int(Memo23.Height/HeightFio);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo23OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  HeightFio := Memo23.Height;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo42OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  HeightFio := Memo42.Height;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo42OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Memo42.Height &#62; HeightFio then&#13;&#10;  TrueNum :=  TrueNum + int(Memo42.Height/HeightFio);&#13;&#10;end;&#13;&#10;&#13;&#10;//procedure Band65OnBeforePrint(Sender: TfrxComponent);&#13;&#10;//begin&#13;&#10;      // FixedSNaRuki := &#60;Pay.&#34;sNaRuki&#34;&#62;;&#13;&#10;     //  FixedSumNaRuki := &#60;Pay.&#34;doNaRuki&#34;&#62;;&#13;&#10;&#13;&#10;     //  if (isThereCorpCard) then&#13;&#10;     //  begin&#13;&#10;      //         FixedSNaRuki := 'СУММА НА РУКИ:';&#13;&#10;     //          FixedSumNaRuki := UderCorpCard;&#13;&#10;     //  end;&#13;&#10;     //----------------&#13;&#10;     //FixedSNaRuki := 'СУММА НА РУКИ:';&#13;&#10;     //TotalSum := TotalSum + &#60;Pay.&#34;doNaRuki&#34;&#62;;&#13;&#10;&#13;&#10;     //if (TotalSum &#60; 0) then&#13;&#10;     //  TotalSum := 0;&#13;&#10;//end;&#13;&#10;&#13;&#10;procedure DetailData1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  //TotalSum := TotalSum + 15;SUM(&#60;NACHISLSUM.&#34;SUMMA&#34;&#62;,DetailData1);&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure DetailData4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  //if  Copy(&#60;TP_WORKTIME.&#34;STYPETIME&#34;&#62;,0,pos('....',&#60;TP_WORKTIME.&#34;STYPETIME&#34;&#62;)-1)='ФАКТИЧЕСКИ ОТРАЮОТАНО ВРЕМЕНИ' then&#13;&#10;  if &#60;TP_WORKTIME.&#34;wTYPETIME&#34;&#62;=1 then&#13;&#10;  begin&#13;&#10;  //  [FormatFloat('#.00',Wotk_Days)]ДН. [Work_Hour]Ч.&#13;&#10;     Wotk_Days:=&#60;TP_WORKTIME.&#34;DDAYS&#34;&#62; ;&#13;&#10;     Work_Hour:=&#60;TP_WORKTIME.&#34;DHOURS&#34;&#62;;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData12OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  //Nal_tabHelp:=Nal_tabHelp+&#60;SMATHELP.&#34;DO_YEARSMH&#34;&#62;;&#13;&#10;  end;&#13;&#10;&#13;&#10;procedure DetailData9OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  //Nal_Doxod :=Nal_Doxod +&#60;TOTALSUMMS.&#34;DOTOTALRETURN&#34;&#62;;&#13;&#10;  //Nal_Doxod :=Nal_Doxod +&#60;TOTALSUMMS.&#34;DOFORTAXATION&#34;&#62;;&#13;&#10;  Nal_Doxod:=Nal_Doxod+&#60;TOTALSUMMS.&#34;DOTOTALRETURN&#34;&#62;;&#13;&#10;&#13;&#10;  Nal_Vichet:=Nal_Vichet+&#60;TOTALSUMMS.&#34;DOTOTALRETURN&#34;&#62;-&#60;TOTALSUMMS.&#34;DOFORTAXATION&#34;&#62;;&#13;&#10;  Nal_Summa :=Nal_Summa +&#60;TOTALSUMMS.&#34;DOTAX&#34;&#62;;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child12OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10; Child12.Visible:=&#60;FORMARKS.&#34;BOLN_SUM2&#34;&#62; &#62;0;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Child1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    TrueNum :=  TrueNum + int(Child1.Height/HeightFio);&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child8OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    TrueNum :=  TrueNum + int(Child8.Height/HeightFio);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child9OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    TrueNum :=  TrueNum + int(Child9.Height/HeightFio);&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo55OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   TrueNum :=  TrueNum +1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo57OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   TrueNum :=  TrueNum +1;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var ww_str:string;&#13;&#10;begin&#13;&#10;  //без этого не печатается код подразделения и должность&#13;&#10;  //&#60;FORMARKS.&#34;sAppoint&#34;&#62; &#60;FORMARKS.&#34;PODRKOD&#34;&#62;&#13;&#10;  ww_str:=&#60;FORMARKS.&#34;sPodrName&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Child8OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;     FixedSNaRuki := 'СУММА НА РУКИ:';&#13;&#10;     TotalSum := TotalSum + &#60;Pay.&#34;doNaRuki&#34;&#62;;&#13;&#10;     if (TotalSum &#60; 0) then&#13;&#10;       TotalSum := 0;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo25OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//   Nal_tabHelp:=Nal_tabHelp+ &#60;NachislSum_GP.&#34;SummaV&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo26OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  Nal_tabHelp:=&#60;FORMARKS.&#34;tabHelp&#34;&#62;;&#13;&#10;//  Nal_Vichet:=Nal_Vichet-Nal_tabHelp;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo20OnAfterData(Sender: TfrxComponent);&#13;&#10;var ww_str:string;&#13;&#10;begin&#13;&#10;//'152,00&#13;&#10;//'&#13;&#10;  ww_str:=Trim(Memo20.Text);&#13;&#10;  if (ww_str='0,00') or (ww_str='0:00')  then Memo20.Text:='';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData5OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  IF (&#60;TMPABSENCEATTR.&#34;MARK&#34;&#62;='В')&#13;&#10;  or (&#60;TMPABSENCEATTR.&#34;MARK&#34;&#62;='С')&#13;&#10;  or (&#60;TMPABSENCEATTR.&#34;MARK&#34;&#62;='СВ')&#13;&#10;  or (&#60;TMPABSENCEATTR.&#34;MARK&#34;&#62;='РВ')&#13;&#10;  or (&#60;TMPABSENCEATTR.&#34;MARK&#34;&#62;='РО')&#13;&#10;  or (&#60;TMPABSENCEATTR.&#34;MARK&#34;&#62;='Н')&#13;&#10;  then Child2.Visible:=false&#13;&#10;  else Child2.Visible:=true;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo82OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  Num_list:=0;&#13;&#10;  sKEY_SORT:='';&#13;&#10;end." ShowProgress="False" PropData="">
