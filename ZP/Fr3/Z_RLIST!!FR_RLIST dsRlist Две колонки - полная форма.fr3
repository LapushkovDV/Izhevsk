<?xml version="1.0" encoding="utf-8" standalone="no"?>
<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="A:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38526,6758464236" ReportOptions.Description.Text="" ReportOptions.Name="Две колонки - полная форма" ReportOptions.LastChange="44322,6777796875" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  PageLineCount: variant;&#13;&#10;  TecCounter: variant;&#13;&#10;  s: variant;&#13;&#10;  strNonTaxible: variant;&#13;&#10;  transferred: boolean;  // признак того, что РЛ перенесен на новую колонку/страницу&#13;&#10;  startY : extended;     // позиция с которой начали печатать РЛ&#13;&#10;  HeightOrg: extended; //ERP-884 размер строки предприятия&#13;&#10;  LineStep: extended; //ERP-884 количество строк от начала страницы&#13;&#10; FixedSNaRuki : string;&#13;&#10; TotalSum, ItogoUd, DolgPred, UderCorpCard : double;&#13;&#10;  isThereCorpCard: boolean;&#13;&#10;//по работающим сотрудникам: 253 вид показывать в удержаниях, 500 вид удержания– сумма на руки&#13;&#10;//- по уволенным сотрудникам: если в результатах расчета 253 вид удержания (и нет 500),&#13;&#10;// то 253 выводить в сумму на руки, если в результатах расчета есть и 253 и 500,&#13;&#10;//то 253  - в удержаниях , 500- сумма на руки.&#13;&#10;  wType220:word; // 500 во&#13;&#10;  wType208:word; // 253 во&#13;&#10;procedure BeforePrintNonTaxible(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;dsRlist.&#34;COUNTRYPARAM&#34;&#62; = 1 then&#13;&#10;    strNonTaxible := '====   Стандартные вычеты: '+ FormatFloat('# ##0',&#60;NONTAXABLE.&#34;DONONTAXABLE&#34;&#62;)+' ==== '&#13;&#10;  else&#13;&#10;    strNonTaxible := '====  необлагаемая сумма: '+  FormatFloat('# ##0.00',&#60;NONTAXABLE.&#34;DONONTAXABLE&#34;&#62;)+ ' учтено:  '+  FormatFloat('# ##0.00',&#60;NONTAXABLE.&#34;DOACCOUNTED&#34;&#62;)  +' ===== '&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Page1, Engine do&#13;&#10;  begin&#13;&#10;   PageLineCount := 40;&#13;&#10;   TecCounter := 0;&#13;&#10;   TotalSum := 0;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;// событие возникает перед началом печати очередного РЛ&#13;&#10;//--------------------------------------------------------------------&#13;&#10;procedure Band2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;   ItogoUd := 0;&#13;&#10;   TotalSum := 0;&#13;&#10;  // Определим куда надо печатать 253 - в удержаних или в сумму на руки.&#13;&#10;  wType220:=1; // 500 во - в сумму на руки&#13;&#10;  wType208:=0; // 253 во - в удержания&#13;&#10;  if ( Engine.CurY &#60;&#62; LineStep ) and ( transferred = true ) then&#13;&#10;  begin&#13;&#10;    case &#60;dsRlist.&#34;PARAMNEWLIST&#34;&#62; of&#13;&#10;      0 : begin // ERP-884&#13;&#10;           Engine.NewPage(); // создаем новую страницу т.к. на тек. уже нет места&#13;&#10;           Engine.CurY := LineStep; // устанавливаем координаты с учетом заголовка на новом листе&#13;&#10;          end;&#13;&#10;      1:&#13;&#10;        Engine.NewColumn;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  transferred := false;    // обнуляем признак переноса РЛ&#13;&#10;  startY := Engine.CurY;   // Запоминаем позицию, с которой будет печататься РЛ&#13;&#10;end;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;&#13;&#10;procedure Memo27OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo27, Engine do&#13;&#10;  begin&#13;&#10;    if ( &#60;PAGE#&#62; = 1 ) then&#13;&#10;      s:= 'Предприятие : ' + &#60;dsRlist.&#34;XARNAME&#34;&#62;&#13;&#10;    else&#13;&#10;      s:= '';&#13;&#10;  end;&#13;&#10;  HeightOrg := Memo27.Height;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo27OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  LineStep := 40;&#13;&#10;  if ( Memo27.Height &#62; HeightOrg ) then  //если шапка с предприятием не помещается в одну строку&#13;&#10;   if ( int(Memo27.Height/HeightOrg) = 1 ) then&#13;&#10;     LineStep := LineStep + 14 // увеличиваем отступ, 14 вычисленно опытным путем&#13;&#10;   else&#13;&#10;     LineStep := LineStep * int(Memo27.Height/HeightOrg);&#13;&#10;  Engine.CurY := LineStep;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo25OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'SUMMA', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo23OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'NAMEVID', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo21OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'VID', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo20OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'KOLCH', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo18OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'KOLDN', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo14OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('NACHISLSUM' , 'SAVEMES', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo43OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('UDERSUM' , 'USUMMA', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo42OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('UDERSUM' , 'UNAMEVID', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo41OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('UDERSUM' , 'UVID', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo38OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;  var&#13;&#10;  NRec: string;&#13;&#10;begin&#13;&#10;   NRec:=TfrxMemoView(Sender).TagSTR;&#13;&#10;   GalaxyOnClick('UDERSUM' , 'USAVEMES', NRec);&#13;&#10;end;&#13;&#10;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;// Процедура управляет видимостью бэндов в зависимости от настройки на страну&#13;&#10;//--------------------------------------------------------------------&#13;&#10;procedure SetVisible(nmbCountry: integer);&#13;&#10;begin&#13;&#10;  if nmbCountry = 1 then&#13;&#10;    begin&#13;&#10;      // скрываем бэнды, которые не показываются для РБ&#13;&#10;      RUS_YearInfo1.Visible := false;&#13;&#10;      RUS_YearInfo2.Visible := false;&#13;&#10;      RUS_YearInfo3.Visible := false;&#13;&#10;      RUS_YearInfo4.Visible := false;&#13;&#10;      RUS_YearInfo5.Visible := false;&#13;&#10;      RUS_YearInfo6.Visible := false;&#13;&#10;      RUS_YearInfo7.Visible := false;&#13;&#10;    end&#13;&#10;  else&#13;&#10;    begin&#13;&#10;      // скрываем бэнды, которые показываются только для РБ&#13;&#10;      BLR_MonSums.Visible := false;&#13;&#10;      BLR_MonDeduction.Visible := false;&#13;&#10;      BLR_NonTaxable.Visible := false;&#13;&#10;      BLR_YearSums.Visible := false;&#13;&#10;      BLR_YearDeduction.Visible := false;&#13;&#10;    end&#13;&#10;end;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;// После вычисления высоты любого бэнда определяем влезет ли он на текущую страницу&#13;&#10;//--------------------------------------------------------------------&#13;&#10;procedure OnAfterCalcHeight(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  // если не влезет, то отмечаем, что будет перенос на нувую колонку/страницу&#13;&#10;  if TfrxDataBand(sender).Height &#62; Engine.FreeSpace then&#13;&#10;    transferred := true;&#13;&#10;end;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;// Процедура печати линии между РЛ, которые находятся в одной колонке&#13;&#10;//--------------------------------------------------------------------&#13;&#10;procedure PrintLine;&#13;&#10;var&#13;&#10;  saveY : extended;&#13;&#10;  myBand: TfrxMasterData;&#13;&#10;  myLine: TfrxLineView;&#13;&#10;  Memo: TfrxMemoView;&#13;&#10;begin&#13;&#10;  saveY := Engine.CurY;&#13;&#10;  myBand := TfrxMasterData.Create(Page1);&#13;&#10;  myBand.Height := 0.2 * 37.7953;&#13;&#10;  myBand.visible := true;&#13;&#10;&#13;&#10;  myLine := TfrxLineView.Create(myBand);&#13;&#10;  myLine.Top := 0;&#13;&#10;  myLine.Frame.Style := fsDot;&#13;&#10;  myLine.Frame.Width := 3;&#13;&#10;  myLine.Frame.Color := clBlack;&#13;&#10;  myLine.Width := 13.36 * 37.7953;&#13;&#10;  myLine.Left  := 0.24 * 37.7953;&#13;&#10;  myLine.visible := true;&#13;&#10;&#13;&#10;  Engine.CurY := startY;&#13;&#10;  Engine.ShowBand(myBand);&#13;&#10;  Engine.CurY := saveY;&#13;&#10;end;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;&#13;&#10;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;// событие после печати футера.&#13;&#10;//--------------------------------------------------------------------&#13;&#10;procedure Footer1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not transferred then  // если не было переноса РЛ&#13;&#10;    if startY &#62; LineStep then    // и это был не первый РЛ в колонке (число подобрано вручную (заголовок учитываем))&#13;&#10;      PrintLine;           // печатаем линию&#13;&#10;end;&#13;&#10;//--------------------------------------------------------------------&#13;&#10;&#13;&#10;procedure RUS_YearInfo7OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;dsRlist.&#34;COUNTRYPARAM&#34;&#62; &#60;&#62; 1 then&#13;&#10;  begin&#13;&#10;    RUS_YearInfo7.visible := true;&#13;&#10;    if ((&#60;NONTAXABLE.&#34;DONONTAXABLE&#34;&#62;=0) and (&#60;NONTAXABLE.&#34;DOACCOUNTED&#34;&#62;=0) and (&#60;NONTAXABLE.&#34;DOPREFERENCEFORME&#34;&#62;=0) and&#13;&#10;       (&#60;NONTAXABLE.&#34;DOPREFERENCEFORKID&#34;&#62;=0) and (&#60;NONTAXABLE.&#34;DOREDUCTION&#34;&#62;=0) and (&#60;NONTAXABLE.&#34;DOPREVIOUSWORK&#34;&#62;=0)) then&#13;&#10;      RUS_YearInfo7.visible := false;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;TotalSumms.&#34;dPrevDoh&#34;&#62; &#62; 0 ) then&#13;&#10;    DetailData1.Visible := true&#13;&#10;  else&#13;&#10;    DetailData1.Visible := false;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Band10OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;     FixedSNaRuki := 'СУММА НА РУКИ:';&#13;&#10;     TotalSum := TotalSum + &#60;Pay.&#34;doNaRuki&#34;&#62;;&#13;&#10;&#13;&#10;     if (TotalSum &#60; 0) then&#13;&#10;       TotalSum := 0&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Band8OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ((&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 220)&#13;&#10;and (&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 171)&#13;&#10;//and (&#60;UderSum.&#34;UVid&#34;&#62; &#60;&#62; 226)&#13;&#10;and ((&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 208) or (wType208=0)) ) then&#13;&#10;  ItogoUd := ItogoUd + &#60;UDERSUM.&#34;USUMMA&#34;&#62;;&#13;&#10;&#13;&#10;if (&#60;UderSum.&#34;UVidS&#34;&#62; = 171) then&#13;&#10;  DolgPred := DolgPred + &#60;UDERSUM.&#34;USUMMA&#34;&#62;;&#13;&#10;&#13;&#10;isThereCorpCard := false;&#13;&#10;if&#13;&#10;(&#60;UderSum.&#34;UVidS&#34;&#62; = 220) or&#13;&#10;((&#60;UderSum.&#34;UVidS&#34;&#62; = 208) and (wType208=1))  then&#13;&#10;begin&#13;&#10;       isThereCorpCard := true;&#13;&#10;       UderCorpCard := &#60;UderSum.&#34;USumma&#34;&#62;;&#13;&#10;       TotalSum := TotalSum + &#60;UderSum.&#34;USumma&#34;&#62;;&#13;&#10;end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Child4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;Child4.Visible := (&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 220)&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;begin //инициализация отчета&#13;&#10;  SetVisible(&#60;dsRlist.&#34;COUNTRYPARAM&#34;&#62;);&#13;&#10;end." ShowProgress="False" PropData="">
