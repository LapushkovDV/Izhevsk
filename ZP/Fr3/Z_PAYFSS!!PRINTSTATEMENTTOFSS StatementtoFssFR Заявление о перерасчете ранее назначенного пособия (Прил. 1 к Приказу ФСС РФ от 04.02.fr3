<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="A:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="41096,3477047222" ReportOptions.Description.Text="" ReportOptions.Name="Заявление о перерасчете ранее назначенного пособия (Прил. 1 к Приказу ФСС РФ от 04.02" ReportOptions.LastChange="44711,644072963" ScriptLanguage="PascalScript" ScriptText.Text="var VReportName : TfrxMemoView;&#13;&#10;var iLen : integer;&#13;&#10;//------------------------------------------&#13;&#10;// функция печати по ячейкам&#13;&#10;//------------------------------------------&#13;&#10;function PrintField(AllStr : string; CountCell : integer; NameCell : string): Extended;&#13;&#10;  var i : integer;&#13;&#10;begin&#13;&#10;  for i := 1 to CountCell do&#13;&#10;  begin&#13;&#10;    VReportName := TfrxMemoView(Report.FindObject(NameCell + IntToStr(i)));&#13;&#10;    if ( VReportName &#60;&#62; nil ) then&#13;&#10;      VReportName.Text := Uppercase(Copy(AllStr, i, 1));&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;//------------------------------------------&#13;&#10;// функция печати дат по ячейкам&#13;&#10;//------------------------------------------&#13;&#10;function PrintDateField(PrintData : Date; NameCell : string): Extended;&#13;&#10;  var Day, Month, Year, DateStr : String;&#13;&#10;begin&#13;&#10;  if ( FormatDateTime('DD.MM.YYYY', PrintData) &#60;&#62; '30.12.1899' ) then&#13;&#10;  begin&#13;&#10;    Day := IntToStr(DayOf(PrintData));&#13;&#10;&#13;&#10;    if ( Length(Day) = 1 ) then&#13;&#10;      Day := '0' + Day;&#13;&#10;&#13;&#10;    Month := IntToStr(MonthOf(PrintData));&#13;&#10;&#13;&#10;    if ( Length(Month) = 1 ) then&#13;&#10;      Month := '0' + Month;&#13;&#10;&#13;&#10;    Year  := IntToStr(YearOf(PrintData));&#13;&#10;&#13;&#10;    DateStr := Day + Month + Year;&#13;&#10;&#13;&#10;    PrintField(DateStr, 8, NameCell);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;//--------------------------------------&#13;&#10;// очистим ячейки, чтобы не осталось мусора от предыдущих записей&#13;&#10;//--------------------------------------&#13;&#10;procedure pClearObjects(CountCell: integer; NameCell: string; boPoint: boolean);&#13;&#10;var i: integer;&#13;&#10;begin&#13;&#10;  for i := 1 to CountCell do&#13;&#10;  begin&#13;&#10;    VReportName := TfrxMemoView(Report.FindObject(NameCell + IntToStr(i)));&#13;&#10;    if (VReportName &#60;&#62; nil) then&#13;&#10;    begin&#13;&#10;      if boPoint and (i = 3) then&#13;&#10;        VReportName.Text := '.'&#13;&#10;      else&#13;&#10;        VReportName.Text := '';&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;//--------------------------------------&#13;&#10;// функция печати телефона&#13;&#10;//-------------------------------------&#13;&#10;function PrintPhone(AllStr : string; CountCell : integer; NameCell : string): Extended;&#13;&#10;  var len, l, i : integer;&#13;&#10;  var sym       : string;&#13;&#10;begin&#13;&#10;  pClearObjects(CountCell, NameCell, false);&#13;&#10;&#13;&#10;  l   := 1;&#13;&#10;  len := Length(AllStr);&#13;&#10;&#13;&#10;  for i := len+1 downto 1 do&#13;&#10;  begin&#13;&#10;    sym := copy(AllStr, i, 1);&#13;&#10;    case sym of&#13;&#10;    '1', '2', '3', '4', '5',&#13;&#10;    '6', '7', '8', '9', '0' :&#13;&#10;      begin&#13;&#10;        VReportName := TfrxMemoView(Report.FindObject(NameCell + IntToStr(l)));&#13;&#10;        if ( VReportName &#60;&#62; nil ) then&#13;&#10;          VReportName.Text := Copy(AllStr, i, 1);&#13;&#10;        l := l +1;&#13;&#10;      end;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;//--------------------------------------&#13;&#10;// функция печати по ячейкам в обратном порядке&#13;&#10;//-------------------------------------&#13;&#10;function PrintFieldBack(AllStr : string; CountCell : integer; NameCell : string): Extended;&#13;&#10;  var len, l, i : integer;&#13;&#10;begin&#13;&#10;  pClearObjects(CountCell, NameCell, true);&#13;&#10;&#13;&#10;  l := 0;&#13;&#10;  len := Length(AllStr);&#13;&#10;&#13;&#10;  if ( len &#62; CountCell ) then&#13;&#10;    len := CountCell;&#13;&#10;&#13;&#10;  for i := len+1 downto 1 do&#13;&#10;  begin&#13;&#10;    VReportName := TfrxMemoView(Report.FindObject(NameCell + IntToStr(l)));&#13;&#10;    if ( VReportName &#60;&#62; nil ) then&#13;&#10;      VReportName.Text := Copy(AllStr, i, 1);&#13;&#10;    l := l +1;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;//-------------------------------------&#13;&#10;procedure Memo11OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintField(&#60;StatementtoFssFR.&#34;SNAMEFSS&#34;&#62;, 135, 'sNameFss');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo990OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;FORMARKSB.&#34;R_FAM&#34;&#62; &#60;&#62; '' ) then&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;R_FAM&#34;&#62;, 27, 'Fam')&#13;&#10;  else&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;FAM&#34;&#62;, 27, 'Fam');&#13;&#10;&#13;&#10;  if ( &#60;FORMARKSB.&#34;R_NAME&#34;&#62; &#60;&#62; '' ) then&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;R_NAME&#34;&#62;, 27, 'Name')&#13;&#10;  else&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;NAME&#34;&#62;, 27, 'Name');&#13;&#10;&#13;&#10;  if ( &#60;FORMARKSB.&#34;R_PART&#34;&#62; &#60;&#62; '' ) then&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;R_PART&#34;&#62;, 27, 'Patr')&#13;&#10;  else&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;PART&#34;&#62;, 27, 'Patr');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo1013OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(19, 'NCard', false);&#13;&#10;  pClearObjects(72, 'NameBank', false);&#13;&#10;  pClearObjects(20, 'LSchet', false);&#13;&#10;  pClearObjects(9,  'Bik', false);&#13;&#10;&#13;&#10;  case &#60;FORMARKSB.&#34;VBANK&#34;&#62; of&#13;&#10;  1: begin&#13;&#10;       PrintField(&#60;FORMARKSB.&#34;NAMEBANK&#34;&#62;, 72, 'NameBank');&#13;&#10;       PrintField(&#60;FORMARKSB.&#34;NUMLSCH&#34;&#62;, 20, 'LSchet');&#13;&#10;       PrintField(&#60;FORMARKSB.&#34;BIK&#34;&#62;, 9, 'Bik');&#13;&#10;     end;&#13;&#10;  2: PrintField(&#60;FORMARKSB.&#34;NUMCARD&#34;&#62;, 19, 'NCard');&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo889OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintField(&#60;FORMARKSB.&#34;FAM&#34;&#62;, 24, 'Famil');&#13;&#10;  PrintField(&#60;FORMARKSB.&#34;NAME&#34;&#62;, 24, 'Nam');&#13;&#10;  PrintField(&#60;FORMARKSB.&#34;PART&#34;&#62;, 24, 'Pat');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo1158OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintDateField(&#60;FORMARKSB.&#34;PBORNDATE&#34;&#62;, 'DateBorn')&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2258OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(6,  'RegIndex', false);&#13;&#10;  pClearObjects(24, 'RegRegion', false);&#13;&#10;  pClearObjects(24, 'RegRaion', false);&#13;&#10;  pClearObjects(24, 'RegNasPunkt', false);&#13;&#10;  pClearObjects(24, 'RegStreet', false);&#13;&#10;  pClearObjects(8,  'RegHouse', false);&#13;&#10;  pClearObjects(3,  'RegKorpus', false);&#13;&#10;  pClearObjects(3,  'RegStroen', false);&#13;&#10;  pClearObjects(5,  'RegFlat', false);&#13;&#10;&#13;&#10;  if (  &#60;FORMARKSB.&#34;REGINDEX&#34;&#62; &#60;&#62; '') then&#13;&#10;  begin&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGINDEX&#34;&#62;, 6 , 'RegIndex');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGREGION&#34;&#62;, 24, 'RegRegion');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGRAION&#34;&#62;, 24, 'RegRaion');&#13;&#10;&#13;&#10;    if ( trim(&#60;FORMARKSB.&#34;REGNASPUNKT&#34;&#62;) &#60;&#62; '' ) then&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;REGNASPUNKT&#34;&#62;, 24, 'RegNasPunkt')&#13;&#10;    else&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;REGCITY&#34;&#62;, 24, 'RegNasPunkt');&#13;&#10;&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGSTREET&#34;&#62;, 24, 'RegStreet');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGHOUSE&#34;&#62;, 8, 'RegHouse');&#13;&#10;&#13;&#10;    if ( &#60;FORMARKSB.&#34;REGKORSOKR&#34;&#62; &#60;&#62; 'стр' ) then&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;REGKORPUS&#34;&#62;, 3, 'RegKorpus')&#13;&#10;    else&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;REGKORPUS&#34;&#62;, 3, 'RegStroen');&#13;&#10;&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGFLAT&#34;&#62;, 5, 'RegFlat');&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2550OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(6,  'LiveIndex', false);&#13;&#10;  pClearObjects(24, 'LiveRegion', false);&#13;&#10;  pClearObjects(24, 'LiveRaion', false);&#13;&#10;  pClearObjects(24, 'LiveNasPunkt', false);&#13;&#10;  pClearObjects(24, 'LiveStreet', false);&#13;&#10;  pClearObjects(8,  'LiveHouse', false);&#13;&#10;  pClearObjects(3,  'LiveKorpus', false);&#13;&#10;  pClearObjects(3,  'LiveStroen', false);&#13;&#10;  pClearObjects(5,  'LiveFlat', false);&#13;&#10;&#13;&#10;  if  ( &#60;FORMARKSB.&#34;VBANK&#34;&#62; &#60;&#62; 1 ) and         // почтовый перевод&#13;&#10;      ( &#60;FORMARKSB.&#34;LIVEINDEX&#34;&#62; &#60;&#62; '' ) then&#13;&#10;  begin&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEINDEX&#34;&#62;, 6, 'LiveIndex');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEREGION&#34;&#62;, 24, 'LiveRegion');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVERAION&#34;&#62;, 24, 'LiveRaion');&#13;&#10;&#13;&#10;    if ( trim(&#60;FORMARKSB.&#34;LIVENASPUNKT&#34;&#62;) &#60;&#62; '' ) then&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;LIVENASPUNKT&#34;&#62;, 24, 'LiveNasPunkt')&#13;&#10;    else&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;LIVECITY&#34;&#62;, 24, 'LiveNasPunkt');&#13;&#10;&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVESTREET&#34;&#62;, 24, 'LiveStreet');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEHOUSE&#34;&#62;, 8, 'LiveHouse');&#13;&#10;&#13;&#10;    if ( &#60;FORMARKSB.&#34;LIVEKORSOKR&#34;&#62; &#60;&#62; 'стр' ) then&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;LIVEKORPUS&#34;&#62;, 3, 'LiveKorpus')&#13;&#10;    else&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;LIVEKORPUS&#34;&#62;, 3, 'LiveStroen');&#13;&#10;&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEKORPUS&#34;&#62;, 3, 'LiveKorpus');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEFLAT&#34;&#62;, 5, 'LiveFlat');&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo3370OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FillMemoFieldsGroup('PerPhone', &#60;FORMARKSB.&#34;PERPHONE&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo3421OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(12, 'NonListBoln', false);&#13;&#10;  pClearObjects(8,  'DateListBoln', false);&#13;&#10;//  DateListBoln5.Text := '2';&#13;&#10;//  DateListBoln6.Text := '0';&#13;&#10;  pClearObjects(12, 'NumListBoln', false);&#13;&#10;  pClearObjects(8,  'DatListBoln', false);&#13;&#10;//  DatListBoln5.Text := '2';&#13;&#10;//  DatListBoln6.Text := '0';&#13;&#10;&#13;&#10;  case &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; of&#13;&#10;    1, 6:   // нетрудоспособность,  проф. травма, болезнь&#13;&#10;    begin&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;NONLISTBOLN&#34;&#62; , 12, 'NonListBoln');&#13;&#10;      PrintDateField(&#60;FORMARKSB.&#34;BOLDATEV&#34;&#62;, 'DateListBoln');&#13;&#10;    end;&#13;&#10;    2:      // беременность и роды&#13;&#10;    begin&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;NONLISTBOLN&#34;&#62; , 12, 'NumListBoln');&#13;&#10;      PrintDateField(&#60;FORMARKSB.&#34;BOLDATEV&#34;&#62; , 'DatListBoln');&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2490OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintField(&#60;StatementtoFssFR.&#34;XARNAME&#34;&#62;, 81, 'NameOrgan');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2475OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintDateField(&#60;StatementtoFssFR.&#34;DATADOC&#34;&#62;, 'DateFormOt');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2644OnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var TmpSnils : string;&#13;&#10;begin&#13;&#10;  TmpSnils := ReplaceStr(&#60;FORMARKSB.&#34;SNILSPER&#34;&#62;,'-','');&#13;&#10;  TmpSnils := ReplaceStr(TmpSnils,' ','');&#13;&#10;&#13;&#10;  PrintField(TmpSnils, 11, 'SnilsPer');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2575OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintField(&#60;FORMARKSB.&#34;INNPER&#34;&#62;, 12, 'INNPer');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2925OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FillMemoFieldsGroup('KodTel',  &#60;StatementtoFssFR.&#34;KodTel&#34;&#62;);&#13;&#10;  FillMemoFieldsGroup('TelSost', &#60;StatementtoFssFR.&#34;Tel_Sost&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2760OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(11, 'SrZar', true);&#13;&#10;&#13;&#10;  case &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; of&#13;&#10;    1, 2, 5,    // нетрудоспособность,  беременность и роды,  уход за ребенком&#13;&#10;    6, 9 :      // проф. травма болезнь, отпуск&#13;&#10;    begin&#13;&#10;      if ( StrToFloat(&#60;FORMARKSB.&#34;SRZAR&#34;&#62;) &#60;&#62; 0 ) then&#13;&#10;        PrintFieldBack(&#60;FORMARKSB.&#34;SRZAR&#34;&#62;, 11, 'SrZar');&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo105OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(4,  'YearFirst', false);&#13;&#10;  pClearObjects(11, 'SrZarFirst', true);&#13;&#10;&#13;&#10;  case &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; of&#13;&#10;    1, 2, 5,    // нетрудоспособность,  беременность и роды,  уход за ребенком&#13;&#10;    6, 9 :      // проф. травма болезнь, отпуск&#13;&#10;    begin&#13;&#10;      if (&#60;FORMARKSB.&#34;YEARFIRST&#34;&#62; &#60;&#62; 0) then&#13;&#10;        PrintField(&#60;FORMARKSB.&#34;YEARFIRST&#34;&#62;, 4, 'YearFirst');&#13;&#10;      if ( StrToFloat(&#60;FORMARKSB.&#34;SRZAR&#34;&#62;) &#60;&#62; 0 ) then&#13;&#10;        if ( StrToFloat(&#60;FORMARKSB.&#34;SRZARFIRST&#34;&#62;) &#60;&#62; 0 ) then&#13;&#10;          PrintFieldBack(&#60;FORMARKSB.&#34;SRZARFIRST&#34;&#62;, 11, 'SrZarFirst');&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo107OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(4,  'YearSecond', false);&#13;&#10;  pClearObjects(11, 'SrZarSecond', true);&#13;&#10;&#13;&#10;  case &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; of&#13;&#10;    1, 2, 5,    // нетрудоспособность,  беременность и роды,  уход за ребенком&#13;&#10;    6, 9 :      // проф. травма болезнь, отпуск&#13;&#10;    begin&#13;&#10;      if (&#60;FORMARKSB.&#34;YEARSEC&#34;&#62; &#60;&#62; 0) then&#13;&#10;        PrintField(&#60;FORMARKSB.&#34;YEARSEC&#34;&#62;, 4, 'YearSecond');&#13;&#10;      if ( StrToFloat(&#60;FORMARKSB.&#34;SRZAR&#34;&#62;) &#60;&#62; 0 ) then&#13;&#10;        if ( StrToFloat(&#60;FORMARKSB.&#34;SRZARSEC&#34;&#62;) &#60;&#62; 0 ) then&#13;&#10;          PrintFieldBack(&#60;FORMARKSB.&#34;SRZARSEC&#34;&#62;, 11, 'SrZarSecond')&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo3434OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(8,  'Ref12WeekDt', false);&#13;&#10;  pClearObjects(11, 'Ref12WeekNo', false);&#13;&#10;&#13;&#10;  if ( ( &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; = 3 ) or          // ранние сроки беременности&#13;&#10;       ( ( &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; = 2 ) and ( &#60;FORMARKSB.&#34;REASONEMPL&#34;&#62; = 1 ) ) ) and&#13;&#10;     (  &#60;FORMARKSB.&#34;REF12WEEKNO&#34;&#62; &#60;&#62; '' ) then&#13;&#10;  begin&#13;&#10;    PrintDateField(&#60;FORMARKSB.&#34;REF12WEEKDT&#34;&#62;, 'Ref12WeekDt');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REF12WEEKNO&#34;&#62;, 11, 'Ref12WeekNo');&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo112OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; = 5 ) or ( &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; = 2 ) then // уход за ребенком или БИР&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;DAY&#34;&#62;, 3, 'Day')&#13;&#10;  else&#13;&#10;    PrintField('', 3, 'Day');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Outline.LevelRoot;&#13;&#10;  Outline.AddItem(&#60;FORMARKSB.&#34;FAM&#34;&#62; + ' ' + &#60;FORMARKSB.&#34;NAME&#34;&#62; + ' ' + &#60;FORMARKSB.&#34;PART&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo2846OnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var dsOtkl : TfrxDataSet;&#13;&#10;begin&#13;&#10;  pClearObjects(8, 'PrDateBegin1', false);&#13;&#10;  pClearObjects(8, 'PrDateEnd1', false);&#13;&#10;  pClearObjects(9, 'PrAvg1', true);&#13;&#10;  pClearObjects(8, 'PrDateBegin2', false);&#13;&#10;  pClearObjects(8, 'PrDateEnd2', false);&#13;&#10;  pClearObjects(9, 'PrAvg2', true);&#13;&#10;&#13;&#10;  dsOtkl := Report.GetDataSet('tp_Otkl');&#13;&#10;  dsOtkl.First;&#13;&#10;&#13;&#10;  while not dsOtkl.EOF do&#13;&#10;  begin&#13;&#10;    if ( dsOtkl.Value('npp') = 1 ) then&#13;&#10;    begin&#13;&#10;      PrintDateField( dsOtkl.Value('dStart'), 'PrDateBegin1');&#13;&#10;      PrintDateField( dsOtkl.Value('dEnd'), 'PrDateEnd1');&#13;&#10;      PrintFieldBack( dsOtkl.Value('dAver'), 9, 'PrAvg1')&#13;&#10;    end;&#13;&#10;&#13;&#10;    if ( dsOtkl.Value('npp') = 2 ) then&#13;&#10;    begin&#13;&#10;      PrintDateField( dsOtkl.Value('dStart'), 'PrDateBegin2');&#13;&#10;      PrintDateField( dsOtkl.Value('dEnd'), 'PrDateEnd2');&#13;&#10;      PrintFieldBack( dsOtkl.Value('dAver'), 9, 'PrAvg2')&#13;&#10;    end;&#13;&#10;    dsOtkl.NEXT;&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sNmFSS1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  //PrintField(&#60;StatementtoFssFR.&#34;SNAMEFSS&#34;&#62;, 135, 'sNmFss');&#13;&#10;  PrintField(&#60;StatementtoFssFR.&#34;XARNAME&#34;&#62;, 135, 'sNmFss');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sSurNmEmpl1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;FORMARKSB.&#34;R_FAM&#34;&#62; &#60;&#62; '' ) then&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;R_FAM&#34;&#62;, 21, 'sSurNmEmpl')&#13;&#10;  else&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;FAM&#34;&#62;, 21, 'sSurNmEmpl');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sPatrEmpl1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;if ( &#60;FORMARKSB.&#34;R_PART&#34;&#62; &#60;&#62; '' ) then&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;R_PART&#34;&#62;, 21, 'sPatrEmpl')&#13;&#10;  else&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;PART&#34;&#62;, 21, 'sPatrEmpl');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sNameEmpl1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    if ( &#60;FORMARKSB.&#34;R_NAME&#34;&#62; &#60;&#62; '' ) then&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;R_NAME&#34;&#62;, 21, 'sNameEmpl')&#13;&#10;  else&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;NAME&#34;&#62;, 21, 'sNameEmpl');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo327OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintField(&#60;FORMARKSB.&#34;FAM&#34;&#62;,  24, 'SurNameBenefit');&#13;&#10;  PrintField(&#60;FORMARKSB.&#34;NAME&#34;&#62;, 24, 'sNameBenefit');&#13;&#10;  PrintField(&#60;FORMARKSB.&#34;PART&#34;&#62;, 24, 'sPatrBenefit');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo418OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var TmpSnils : string;&#13;&#10;begin&#13;&#10;  TmpSnils := ReplaceStr(&#60;FORMARKSB.&#34;SNILSPER&#34;&#62;,'-','');&#13;&#10;  TmpSnils := ReplaceStr(TmpSnils,' ','');&#13;&#10;  PrintField(TmpSnils, 11, 'Snils');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo407OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintDateField(&#60;FORMARKSB.&#34;PBORNDATE&#34;&#62;, 'dateofBorn')&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure AdressRegOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(6,  'sRegIndex', false);&#13;&#10;  pClearObjects(24, 'sRegRegion', false);&#13;&#10;  pClearObjects(24, 'RegRaion', false);&#13;&#10;  pClearObjects(24, 'sRegNasPunkt', false);&#13;&#10;  pClearObjects(24, 'sRegStreet', false);&#13;&#10;  pClearObjects(8,  'sRegHouse', false);&#13;&#10;  pClearObjects(3,  'sRegKorpus', false);&#13;&#10;  pClearObjects(3,  'sRegStroen', false);&#13;&#10;  pClearObjects(5,  'sRegFlat', false);&#13;&#10;&#13;&#10;  if (  &#60;FORMARKSB.&#34;REGINDEX&#34;&#62; &#60;&#62; '') then&#13;&#10;  begin&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGINDEX&#34;&#62;, 6 , 'sRegIndex');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGREGION&#34;&#62;, 24, 'sRegRegion');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGRAION&#34;&#62;, 24, 'sRegRaion');&#13;&#10;&#13;&#10;    if ( trim(&#60;FORMARKSB.&#34;REGNASPUNKT&#34;&#62;) &#60;&#62; '' ) then&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;REGNASPUNKT&#34;&#62;, 24, 'sRegNasPunkt')&#13;&#10;    else&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;REGCITY&#34;&#62;, 24, 'sRegNasPunkt');&#13;&#10;&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGSTREET&#34;&#62;, 24, 'sRegStreet');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGHOUSE&#34;&#62;, 8, 'sRegHouse');&#13;&#10;&#13;&#10;    if ( &#60;FORMARKSB.&#34;REGKORSOKR&#34;&#62; &#60;&#62; 'стр' ) then&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;REGKORPUS&#34;&#62;, 3, 'sRegKorpus')&#13;&#10;    else&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;REGKORPUS&#34;&#62;, 3, 'sRegStroen');&#13;&#10;&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;REGFLAT&#34;&#62;, 5, 'sRegFlat');&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AdressFactOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(6,  'sLiveIndex', false);&#13;&#10;  pClearObjects(24, 'sLiveRegion', false);&#13;&#10;  pClearObjects(24, 'sLiveRaion', false);&#13;&#10;  pClearObjects(24, 'sLiveNasPunkt', false);&#13;&#10;  pClearObjects(24, 'sLiveStreet', false);&#13;&#10;  pClearObjects(8,  'sLiveHouse', false);&#13;&#10;  pClearObjects(3,  'sLiveKorpus', false);&#13;&#10;  pClearObjects(3,  'sLiveStroen', false);&#13;&#10;  pClearObjects(5,  'sLiveFlat', false);&#13;&#10;&#13;&#10;  if  ( &#60;FORMARKSB.&#34;VBANK&#34;&#62; &#60;&#62; 1 ) and         // почтовый перевод&#13;&#10;      ( &#60;FORMARKSB.&#34;LIVEINDEX&#34;&#62; &#60;&#62; '' ) then&#13;&#10;  begin&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEINDEX&#34;&#62;, 6, 'sLiveIndex');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEREGION&#34;&#62;, 24, 'sLiveRegion');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVERAION&#34;&#62;, 24, 'sLiveRaion');&#13;&#10;&#13;&#10;    if ( trim(&#60;FORMARKSB.&#34;LIVENASPUNKT&#34;&#62;) &#60;&#62; '' ) then&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;LIVENASPUNKT&#34;&#62;, 24, 'sLiveNasPunkt')&#13;&#10;    else&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;LIVECITY&#34;&#62;, 24, 'sLiveNasPunkt');&#13;&#10;&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVESTREET&#34;&#62;, 24, 'sLiveStreet');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEHOUSE&#34;&#62;, 8, 'sLiveHouse');&#13;&#10;&#13;&#10;    if ( &#60;FORMARKSB.&#34;LIVEKORSOKR&#34;&#62; &#60;&#62; 'стр' ) then&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;LIVEKORPUS&#34;&#62;, 3, 'sLiveKorpus')&#13;&#10;    else&#13;&#10;      PrintField(&#60;FORMARKSB.&#34;LIVEKORPUS&#34;&#62;, 3, 'sLiveStroen');&#13;&#10;&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEKORPUS&#34;&#62;, 3, 'sLiveKorpus');&#13;&#10;    PrintField(&#60;FORMARKSB.&#34;LIVEFLAT&#34;&#62;, 5, 'sLiveFlat');&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure BANKOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(19, 'sNCard', false);&#13;&#10;  pClearObjects(72, 'sNameBank', false);&#13;&#10;  pClearObjects(20, 'sLSchet', false);&#13;&#10;  pClearObjects(9,  'sBik', false);&#13;&#10;&#13;&#10;  case &#60;FORMARKSB.&#34;VBANK&#34;&#62; of&#13;&#10;  1: begin&#13;&#10;       PrintField(&#60;FORMARKSB.&#34;NAMEBANK&#34;&#62;, 72, 'sNameBank');&#13;&#10;       PrintField(&#60;FORMARKSB.&#34;NUMLSCH&#34;&#62;, 20, 'sLSchet');&#13;&#10;       PrintField(&#60;FORMARKSB.&#34;BIK&#34;&#62;, 9, 'sBik');&#13;&#10;     end;&#13;&#10;  2: PrintField(&#60;FORMARKSB.&#34;NUMCARD&#34;&#62;, 19, 'sNCard');&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure TelefonPersOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FillMemoFieldsGroup('sPerPhone', &#60;FORMARKSB.&#34;PERPHONE_DIGEX&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo1111OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintDateField(&#60;StatementtoFssFR.&#34;DATADOC&#34;&#62;, 'sDateSved');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo1132OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FillMemoFieldsGroup('sTelStr', &#60;StatementtoFssFR.&#34;sTel_Sost&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sMailStr1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FillMemoFieldsGroup('sMailStr', &#60;StatementtoFssFR.&#34;Email&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo432OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  pClearObjects(4, 'TypeStat', false);&#13;&#10;&#13;&#10;  case &#60;FORMARKSB.&#34;TYPESTAT&#34;&#62; of&#13;&#10;    1 :  TypeStat1.Text := 'V';    // нетрудоспособность&#13;&#10;    2, 3 : TypeStat2.Text := 'V';  // беременность и роды, ранние сроки беременности&#13;&#10;    5 :  TypeStat3.Text := 'V';    // уход за ребенком&#13;&#10;    6 :  TypeStat4.Text := 'V';    // проф. травма, болезнь&#13;&#10;  end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo511OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  PrintDateField(&#60;StatementtoFssFR.&#34;DATADOC&#34;&#62;, 'DtPz');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sReasonCalc1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FillMemoFieldsGroup('sReasonCalc', &#60;StatementtoFssFR.&#34;sReason&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." ShowProgress="False" OnReportPrint="frxHLOnReportPrint" PropData="">
