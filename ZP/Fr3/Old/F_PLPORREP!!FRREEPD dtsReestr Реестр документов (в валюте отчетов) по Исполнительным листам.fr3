<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="C:\Users\ALEKSA~1.PAK\AppData\Local\Temp\" IniFile="\Software\Fast Report Editor" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38553,4058728356" ReportOptions.Description.Text="" ReportOptions.Name="Реестр документов (в валюте отчетов) по Исполнительным листам" ReportOptions.LastChange="45147,6295379167" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  UnnPlatPol : variant;&#13;&#10;  KppPlatPol : variant;&#13;&#10;  NamePlatPol: variant;&#13;&#10;  BankNamePlatPol: variant;&#13;&#10;  BankKod: variant;&#13;&#10;  BankSchet: variant;&#13;&#10;  BankSchet2 : variant;&#13;&#10;&#13;&#10;  OKTMOPlatPol : variant;&#13;&#10;  CAP_KONTRNAME  : variant;&#13;&#10;&#13;&#10;  MainBuhPos: variant;&#13;&#10;  MainBuhFIO: variant;&#13;&#10;  BossFio: variant;&#13;&#10;  BossPos: variant;&#13;&#10;&#13;&#10;procedure CheckBarCodeColumn(pMem : tFrxMemoView);&#13;&#10;begin&#13;&#10;  if &#60;PDOC.&#34;ISEXISTARCHIVE&#34;&#62; then&#13;&#10;    pMem.Visible := true&#13;&#10;  else&#13;&#10;   pMem.Visible := false;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo15OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo15, Engine do&#13;&#10;  begin&#13;&#10;  NamePlatPol := '';&#13;&#10;  if &#60;dtsReestr.&#34;ISORGPLAT&#34;&#62; then&#13;&#10;    begin&#13;&#10;      if &#60;PDOC.&#34;ORGPLATTUNENAME&#34;&#62; = '' then  NamePlatPol := &#60;PDOC.&#34;ORGPLATNAME&#34;&#62;&#13;&#10;      else NamePlatPol := &#60;PDOC.&#34;ORGPLATTUNENAME&#34;&#62; ;&#13;&#10;    end&#13;&#10;  else&#13;&#10;    if &#60;dtsReestr.&#34;ISORGPOL&#34;&#62; then&#13;&#10;    begin&#13;&#10;      if &#60;PDOC.&#34;ORGPOLTUNENAME&#34;&#62; = '' then NamePlatPol := &#60;PDOC.&#34;ORGPOLNAME&#34;&#62;&#13;&#10;      else NamePlatPol := &#60;PDOC.&#34;ORGPOLTUNENAME&#34;&#62;  ;&#13;&#10;    end&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo17OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo17, Engine do&#13;&#10;  begin&#13;&#10;  BankNamePlatPol := '';&#13;&#10;  if &#60;dtsReestr.&#34;ISORGPLAT&#34;&#62; then&#13;&#10;    BankNamePlatPol := &#60;PDOC.&#34;PLATBANKNAME&#34;&#62;&#13;&#10;  else if &#60;dtsReestr.&#34;ISORGPOL&#34;&#62; then&#13;&#10;         BankNamePlatPol := &#60;PDOC.&#34;POLBANKNAME&#34;&#62;;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo18OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo18, Engine do&#13;&#10;  begin&#13;&#10;  BankKod := '';&#13;&#10;  if &#60;dtsReestr.&#34;ISORGPLAT&#34;&#62; then&#13;&#10;    BankKod := &#60;PDOC.&#34;PLATBANKMFO1&#34;&#62;&#13;&#10;  else if &#60;dtsReestr.&#34;ISORGPOL&#34;&#62; then&#13;&#10;         BankKod := &#60;PDOC.&#34;POLBANKMFO1&#34;&#62;;&#13;&#10;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo19OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo19, Engine do&#13;&#10;  begin&#13;&#10;  BankSchet := '';&#13;&#10;  if &#60;dtsReestr.&#34;ISORGPLAT&#34;&#62; then&#13;&#10;    BankSchet := &#60;PDOC.&#34;PLATBANKSCHET1&#34;&#62;&#13;&#10;  else if &#60;dtsReestr.&#34;ISORGPOL&#34;&#62; then&#13;&#10;         BankSchet := &#60;PDOC.&#34;POLBANKSCHET1&#34;&#62;;&#13;&#10;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo32OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;     with Memo32, Engine do&#13;&#10;  begin&#13;&#10;  UnnPlatPol := '';&#13;&#10;  if &#60;dtsReestr.&#34;ISORGPLAT&#34;&#62; then&#13;&#10;    UnnPlatPol := &#60;PDOC.&#34;ORGPLATUNN&#34;&#62;&#13;&#10;  else if &#60;dtsReestr.&#34;ISORGPOL&#34;&#62; then&#13;&#10;         UnnPlatPol := &#60;PDOC.&#34;ORGPOLUNN&#34;&#62;;&#13;&#10;&#13;&#10;  KppPlatPol := '';&#13;&#10;&#13;&#10;  if &#60;dtsReestr.&#34;ISORGPLAT&#34;&#62; then&#13;&#10;    KppPlatPol := &#60;PDOC.&#34;ORGPLATKPP&#34;&#62;&#13;&#10;  else if &#60;dtsReestr.&#34;ISORGPOL&#34;&#62; then&#13;&#10;         KppPlatPol := &#60;PDOC.&#34;ORGPOLKPP&#34;&#62;;&#13;&#10;&#13;&#10;  if KppPlatPol &#60;&#62; '' then UnnPlatPol := UnnPlatPol + ' / ' + KppPlatPol;&#13;&#10;&#13;&#10;  end&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo39OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;  OKTMOPlatPol :='';&#13;&#10;  if &#60;dtsReestr.&#34;ISORGPLAT&#34;&#62; then&#13;&#10;    OKTMOPlatPol :=  &#60;PDOC.&#34;ORGPLATOKTMO&#34;&#62;&#13;&#10;  else if &#60;dtsReestr.&#34;ISORGPOL&#34;&#62; then&#13;&#10;         OKTMOPlatPol := &#60;PDOC.&#34;ORGPOLOKTMO&#34;&#62;;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CAP_KONTRNAME := '';&#13;&#10;  if &#60;dtsReestr.&#34;ISORGPLAT&#34;&#62; then&#13;&#10;    CAP_KONTRNAME := 'Плательщик'&#13;&#10;  else if &#60;dtsReestr.&#34;ISORGPOL&#34;&#62; then&#13;&#10;         CAP_KONTRNAME := 'Получатель'&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo37OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    BankSchet2 := '';&#13;&#10;  if &#60;dtsReestr.&#34;ISORGPLAT&#34;&#62; then&#13;&#10;    BankSchet2 :=  &#60;PDOC.&#34;PLATBANKSCHET2&#34;&#62;&#13;&#10;  else if &#60;dtsReestr.&#34;ISORGPOL&#34;&#62; then&#13;&#10;         BankSchet2 := &#60;PDOC.&#34;POLBANKSCHET2&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure mfDocOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//   CheckBarCodeColumn(Memo33);&#13;&#10;&#13;&#10;  MainBuhPos := &#60;dtsReestr.&#34;fsMainBuhPos&#34;&#62;;&#13;&#10;  if MainBuhPos = '' then&#13;&#10;    MainBuhPos := 'Главный бухгалтер';&#13;&#10;&#13;&#10;  MainBuhFIO :=  &#60;dtsReestr.&#34;fsMainBuhFIO&#34;&#62;;&#13;&#10;  if MainBuhFIO = '' then&#13;&#10;    MainBuhFIO :=  &#60;dtsReestr.&#34;TUNEMAINBUH&#34;&#62;;&#13;&#10;&#13;&#10;&#13;&#10;  BossPos := &#60;dtsReestr.&#34;fsBossPos&#34;&#62;;&#13;&#10;  if BossPos = '' then&#13;&#10;    BossPos := 'Заместитель генерального директора по экономике и финансам';&#13;&#10;&#13;&#10;  BossFio := &#60;dtsReestr.&#34;fsBossFio&#34;&#62;;&#13;&#10;  if BossFio = '' then&#13;&#10;    BossFio := 'Чулков Сергей Александрович';&#13;&#10;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." ShowProgress="False" PropData="">
