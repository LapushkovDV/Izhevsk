<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="A:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="38526,6758464236" ReportOptions.Description.Text="" ReportOptions.Name="Расчетные листки (ЭМ, с дублированием, новые)" ReportOptions.LastChange="44322,4518899421" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  TrueNum, HeightFio, FixedSumm: variant;&#13;&#10;  PageLineCount: variant;&#13;&#10;  TecCounter: variant;&#13;&#10;  s: variant;&#13;&#10;  firstpage:boolean;&#13;&#10;  TotalSum, DolgPred: double;&#13;&#10;&#13;&#10;procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Page1, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum := 0;&#13;&#10;    PageLineCount := 40;&#13;&#10;    TecCounter := 0;&#13;&#10;    firstpage := true;&#13;&#10;    TotalSum := 0;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Band2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TotalSum := 0;&#13;&#10;  with Band2, Engine do&#13;&#10;  begin&#13;&#10;  Inc(TecCounter);&#13;&#10;  if TecCounter &#62; 1 then&#13;&#10;    Line28.Visible := true;&#13;&#10;&#13;&#10;&#13;&#10; If (((PageLineCount - TrueNum) &#60; ( &#60;FORMARKS.&#34;LINECOUNTER&#34;&#62; + &#60;FORMARKS.&#34;LINECOUNTER2&#34;&#62; + 1)) and (not  firstpage)) then&#13;&#10; begin&#13;&#10;   NEWPAGE;&#13;&#10;   firstpage := false;&#13;&#10;   TrueNum := 0;&#13;&#10;   Line28.Visible := false;&#13;&#10; end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  If firstpage then&#13;&#10;    begin&#13;&#10;     TrueNum := 0;&#13;&#10;     firstpage := false;&#13;&#10;   end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo27OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo27, Engine do&#13;&#10;  begin&#13;&#10;  if &#60;PAGE#&#62; = 1 then&#13;&#10;    s:= 'Предприятие : ' + &#60;dsRlist.&#34;XARNAME&#34;&#62;&#13;&#10;  else&#13;&#10;    s:= '';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo42OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo42, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum := TrueNum + 4;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo289OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo289, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum := TrueNum + 4;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo49OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo49, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo56OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo56, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo64OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo64, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum := TrueNum + 2;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo71OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo71, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo78OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo78, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo81OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo81, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;//procedure Memo83OnBeforePrint(Sender: TfrxComponent);&#13;&#10;//begin&#13;&#10;//  with Memo83, Engine do&#13;&#10;//  begin&#13;&#10; //  if &#60;COUNT(DetailData3)&#62; = 0 then&#13;&#10; //     Memo61.Frame.Typ := 6;&#13;&#10;//  end&#13;&#10;//end;&#13;&#10;&#13;&#10;//procedure Memo213OnBeforePrint(Sender: TfrxComponent);&#13;&#10;//begin&#13;&#10;//  with Memo213, Engine do&#13;&#10;//  begin&#13;&#10; //  if &#60;COUNT(DetailData3)&#62; = 0 then&#13;&#10; //     Memo61.Frame.Typ := 6;&#13;&#10;&#13;&#10;//  end&#13;&#10;//end;&#13;&#10;&#13;&#10;//procedure Memo84OnBeforePrint(Sender: TfrxComponent);&#13;&#10;//begin&#13;&#10;//  with Memo84, Engine do&#13;&#10;//  begin&#13;&#10;//    TrueNum :=  TrueNum + 1&#13;&#10;//  end&#13;&#10;//end;&#13;&#10;&#13;&#10;procedure Memo86OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo86, Engine do&#13;&#10;  begin&#13;&#10; //  if &#60;COUNT(DetailData3)&#62; &#62; 0 then&#13;&#10; //     Memo61.Frame.Typ := 4&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo87OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo87, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo93OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo93, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo96OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo96, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum := TrueNum + 1;&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo103OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo103, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo108OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo108, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo113OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo113, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo118OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo118, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo288OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo288, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo123OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo123, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo128OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo128, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo130OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo130, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo135OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo135, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo140OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo140, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo145OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo145, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo149OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo149, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo155OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo155, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo159OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo159, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo160OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo160, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo167OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  with Memo167, Engine do&#13;&#10;  begin&#13;&#10;    TrueNum :=  TrueNum + 1&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;procedure fReportOnStartReport(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo36OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  HeightFio := Memo36.Height;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo36OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Memo36.Height &#62; HeightFio then&#13;&#10;    TrueNum :=  TrueNum + int(Memo36.Height/HeightFio);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Band19OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Band19.visible := true;&#13;&#10;  if ((&#60;NONTAXABLE.&#34;DONONTAXABLE&#34;&#62;=0) and (&#60;NONTAXABLE.&#34;DOACCOUNTED&#34;&#62;=0) and (&#60;NONTAXABLE.&#34;DOPREFERENCEFORME&#34;&#62;=0) and&#13;&#10;     (&#60;NONTAXABLE.&#34;DOPREFERENCEFORKID&#34;&#62;=0) and (&#60;NONTAXABLE.&#34;DOREDUCTION&#34;&#62;=0) and (&#60;NONTAXABLE.&#34;DOPREVIOUSWORK&#34;&#62;=0)) then&#13;&#10;    Band19.visible := false;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo41OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    Memo41.DisplayFormat.FormatStr := '%2.'+inttostr(&#60;dsRlist.&#34;COUNTTARIF&#34;&#62;)+'n';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo179OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    Memo179.DisplayFormat.FormatStr := '%2.'+inttostr(&#60;dsRlist.&#34;COUNTTARIF&#34;&#62;)+'n';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Band8OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;       if &#60;UderSum.&#34;UVidS&#34;&#62; = 171 then&#13;&#10;               DolgPred := DolgPred + &#60;UderSum.&#34;USumma&#34;&#62;;&#13;&#10;       if &#60;UderSum.&#34;UVidS&#34;&#62; = 220 then&#13;&#10;       begin&#13;&#10;               TotalSum := TotalSum + &#60;UderSum.&#34;USumma&#34;&#62;;&#13;&#10;       end;&#13;&#10;&#13;&#10;       Band8.visible := ((&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 220) and (&#60;UderSum.&#34;UVidS&#34;&#62; &#60;&#62; 171))&#13;&#10;end;&#13;&#10;&#13;&#10;//procedure Band10OnBeforePrint(Sender: TfrxComponent);&#13;&#10;//begin&#13;&#10;//       Band10.visible := false;&#13;&#10;      // if &#60;UderSum.&#34;UVidS&#34;&#62; = 220 then&#13;&#10;      //         Band10.visible := true;&#13;&#10;//&#13;&#10;//end;&#13;&#10;&#13;&#10;procedure DetailData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;      // DetailData2.visible := true;&#13;&#10;&#13;&#10;     //  if &#60;Pay.&#34;doNaRuki&#34;&#62; &#60;= 0 then&#13;&#10;     //          DetailData2.visible := false;&#13;&#10;     //  else&#13;&#10;     //  begin&#13;&#10;&#13;&#10;     //  end;&#13;&#10;&#13;&#10;     TotalSum := TotalSum + &#60;Pay.&#34;doNaRuki&#34;&#62;;&#13;&#10;&#13;&#10;     if TotalSum &#60; 0 then&#13;&#10;       TotalSum := 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PageHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DolgPred := 0;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;&#13;&#10;end." ShowProgress="False" OnStartReport="fReportOnStartReport" PropData="">
