<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.DoublePass="True" EngineOptions.TempDir="B:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="9" ReportOptions.CreateDate="39160,5286032176" ReportOptions.Description.Text="" ReportOptions.Name="_ЭМ Полная форма общей ведомости" ReportOptions.LastChange="43411,6455227315" ScriptLanguage="PascalScript" ScriptText.Text="var CrObj : TFrxMemoView;&#13;&#10;   TabNum : String;&#13;&#10;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross1OnPrintCellOwnGP(Memo: TfrxMemoView; RowIndex, ColumnIndex, CellIndex: Integer; RowValues, ColumnValues, Value: Variant);&#13;&#10;var _str:string;&#13;&#10;    _str2:string;&#13;&#10;begin&#13;&#10;  try begin&#13;&#10;   _str:=vartostr(RowValues[1]);&#13;&#10;   _str2:=vartostr(RowValues[2]);&#13;&#10;   _str:=copy(_str,21,10);&#13;&#10;  end;&#13;&#10;  except&#13;&#10;    _str:='';&#13;&#10;    _str2:='';&#13;&#10;  end;&#13;&#10;  if ((vartostr(RowValues[1]) = '  Количество дней') or (vartostr(RowValues[1]) = '  Количество часов')) then&#13;&#10;  begin&#13;&#10;    Memo.TagStr := '';&#13;&#10;    //если цифра в ячейке сответствует количеству отработанного времени или часов, то курсор принимает вид руки,&#13;&#10;    //показывая, что клик по этой ячейке не вызывает никакого события&#13;&#10;    Memo.Cursor := crDefault;&#13;&#10;  end&#13;&#10;  else&#13;&#10;//    Memo.TagStr := vartostr(ColumnValues[1])+'&#38;'+vartostr(RowValues[0])+'&#38;'+TabNum+'&#38;'+vartostr(RowValues[2]);&#13;&#10;    Memo.TagStr := vartostr(ColumnValues[1])+'&#38;'+_str+'&#38;'+TabNum+'&#38;'+_str2;&#13;&#10;&#13;&#10;  case TabNum of&#13;&#10;  '1': //начисления&#13;&#10;  begin&#13;&#10;  if DBCross1.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '2': //начисления&#13;&#10;  begin&#13;&#10;  if DBCross2.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '3': //неначисляемый доход&#13;&#10;  begin&#13;&#10;  if DBCross3.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '4': //неначисленный за сводом&#13;&#10;  begin&#13;&#10;  if DBCross4.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  end;//case&#13;&#10;&#13;&#10;  //если сумма в ячейке равна нулю, то курсор принимает вид руки,&#13;&#10;  //показывая, что клик по этой ячейке не вызывает никакого события&#13;&#10;  if (vartostr(Value) = '') then&#13;&#10;    Memo.Cursor := crDefault;&#13;&#10;end; //procedure DBCross1OnPrintCellOwnGP&#13;&#10;&#13;&#10;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross1OnPrintCellOwn(Memo: TfrxMemoView; RowIndex, ColumnIndex, CellIndex: Integer; RowValues, ColumnValues, Value: Variant);&#13;&#10;begin&#13;&#10;try begin&#13;&#10;  if ((vartostr(RowValues[1]) = '  Количество дней') or (vartostr(RowValues[1]) = '  Количество часов')) then&#13;&#10;  begin&#13;&#10;    Memo.TagStr := '';&#13;&#10;    //если цифра в ячейке сответствует количеству отработанного времени или часов, то курсор принимает вид руки,&#13;&#10;    //показывая, что клик по этой ячейке не вызывает никакого события&#13;&#10;    Memo.Cursor := crDefault;&#13;&#10;  end&#13;&#10;  else&#13;&#10;    Memo.TagStr := vartostr(ColumnValues[1])+'&#38;'+vartostr(RowValues[0])+'&#38;'+TabNum+'&#38;';//падает +vartostr(RowValues[2]);&#13;&#10;&#13;&#10;  case TabNum of&#13;&#10;  '1': //начисления&#13;&#10;  begin&#13;&#10;  if DBCross1.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '2': //начисления&#13;&#10;  begin&#13;&#10;  if DBCross2.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '3': //неначисляемый доход&#13;&#10;  begin&#13;&#10;  if DBCross3.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '4': //неначисленный за сводом&#13;&#10;  begin&#13;&#10;  if DBCross4.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  end;//case&#13;&#10;&#13;&#10;  //если сумма в ячейке равна нулю, то курсор принимает вид руки,&#13;&#10;  //показывая, что клик по этой ячейке не вызывает никакого события&#13;&#10;  if (vartostr(Value) = '') then&#13;&#10;    Memo.Cursor := crDefault;&#13;&#10;end except&#13;&#10; Memo.Cursor := crDefault;&#13;&#10;end;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross1OnPrintCell(Memo: TfrxMemoView; RowIndex, ColumnIndex, CellIndex: Integer; RowValues, ColumnValues, Value: Variant);&#13;&#10;begin&#13;&#10;try begin&#13;&#10;  if ((vartostr(RowValues[1]) = '  Количество дней') or (vartostr(RowValues[1]) = '  Количество часов')) then&#13;&#10;  begin&#13;&#10;    Memo.TagStr := '';&#13;&#10;    //если цифра в ячейке сответствует количеству отработанного времени или часов, то курсор принимает вид руки,&#13;&#10;    //показывая, что клик по этой ячейке не вызывает никакого события&#13;&#10;    Memo.Cursor := crDefault;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    if ((Pos('(КБК', vartostr(RowValues[1])) &#60;&#62; 0) and ( TabNum = '9')) then&#13;&#10;      Memo.TagStr := vartostr(ColumnValues[1])+'&#38;'+'(КБК'+vartostr(RowValues[0])+'&#38;'+TabNum&#13;&#10;    else&#13;&#10;      if ((Pos('( КБК', vartostr(RowValues[1])) &#60;&#62; 0) and ( TabNum = '9')) then&#13;&#10;        Memo.TagStr := vartostr(ColumnValues[1])+'&#38;'+'( КБК'+vartostr(RowValues[0])+'&#38;'+TabNum&#13;&#10;      else&#13;&#10;        Memo.TagStr := vartostr(ColumnValues[1])+'&#38;'+vartostr(RowValues[0])+'&#38;'+TabNum&#13;&#10;  end;&#13;&#10;&#13;&#10;  case TabNum of&#13;&#10;  '1': //начисления&#13;&#10;  begin&#13;&#10;  if DBCross1.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '2': //начисления&#13;&#10;  begin&#13;&#10;  if DBCross2.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '3': //неначисляемый доход&#13;&#10;  begin&#13;&#10;  if DBCross3.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '4': //неначисленный за сводом&#13;&#10;  begin&#13;&#10;  if DBCross4.isGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '6': //удержания&#13;&#10;  begin&#13;&#10;  if DBCross6.IsGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '7': //к выплате&#13;&#10;  begin&#13;&#10;  if DBCross7.IsGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  '9': //налоги на ФОТ&#13;&#10;  begin&#13;&#10;  if DBCross9.IsGrandTotalColumn(ColumnIndex) then&#13;&#10;     begin&#13;&#10;       Memo.TagStr := Memo.TagStr+'&#38;'+'IsGrTotal';&#13;&#10;      end;&#13;&#10;  end;&#13;&#10;  end; //case&#13;&#10;  //если сумма в ячейке равна нулю, то курсор принимает вид руки,&#13;&#10;  //показывая, что клик по этой ячейке не вызывает никакого события&#13;&#10;  if (vartostr(Value) = '') then&#13;&#10;    Memo.Cursor := crDefault;&#13;&#10;end&#13;&#10;except&#13;&#10;  Memo.Cursor := crDefault;&#13;&#10;end;&#13;&#10;end;&#13;&#10;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;// для сальдо на конец периода&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross8OnPrintCell(Memo: TfrxMemoView; RowIndex, ColumnIndex, CellIndex: Integer; RowValues, ColumnValues, Value: Variant);&#13;&#10;begin&#13;&#10;  if (vartostr(RowValues[0]) = '') then&#13;&#10;  begin&#13;&#10;    if (vartostr(RowValues[1]) = 'Долг за работником') then&#13;&#10;      Memo.TagStr := vartostr(ColumnValues[1]) + '&#38;17199&#38;' + TabNum&#13;&#10;    else&#13;&#10;      Memo.TagStr := vartostr(ColumnValues[1]) + '&#38;18199&#38;' + TabNum&#13;&#10;  end&#13;&#10;  else&#13;&#10;    Memo.TagStr := vartostr(ColumnValues[1])+'&#38;'+vartostr(RowValues[0])+'&#38;'+TabNum;&#13;&#10;&#13;&#10;  //если сумма в ячейке равна нулю, то курсор принимает вид руки,&#13;&#10;  //показывая, что клик по этой ячейке не вызывает никакого события&#13;&#10;  if (vartostr(Value) = '0') then&#13;&#10;    Memo.Cursor := crDefault;&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross8Cell0OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if ((TfrxMemoView(Sender).Memo.Text &#60;&#62; '') and (TfrxMemoView(Sender).TagSTr &#60;&#62; '')) then&#13;&#10;    GalaxyOnClick('FRITOG8','CKATPODR',TfrxMemoView(Sender).TagSTr);&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross8OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CrObj := DBCross8Object1;&#13;&#10;  TabNum := '8';&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;// для начислений&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross1Cell0OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if ((TfrxMemoView(Sender).Memo.Text &#60;&#62; '') and (TfrxMemoView(Sender).TagSTr &#60;&#62; '')) then&#13;&#10;    GalaxyOnClick('FRMASDATAZNACH1','CKATPODR',TfrxMemoView(Sender).TagSTr);&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross1OnPrintColumnHeader(Memo: TfrxMemoView; HeaderIndexes, HeaderValues, Value: Variant);&#13;&#10;begin&#13;&#10;  CrObj.Memo.Text := VarTosTr(Value);&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CrObj := DBCross1Object1;&#13;&#10;  TabNum := '1';&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;// для начисленных за сводом&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross2Cell0OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if ((TfrxMemoView(Sender).Memo.Text &#60;&#62; '') and (TfrxMemoView(Sender).TagSTr &#60;&#62; '')) then&#13;&#10;    GalaxyOnClick('FRMASDATAZNACH2','CKATPODR',TfrxMemoView(Sender).TagSTr);&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CrObj := DBCross2Object1;&#13;&#10;  TabNum := '2';&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;// для неначисленного дохода&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross3Cell0OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if ((TfrxMemoView(Sender).Memo.Text &#60;&#62; '') and (TfrxMemoView(Sender).TagSTr &#60;&#62; '')) then&#13;&#10;    GalaxyOnClick('FRMASDATAZNACH3','CKATPODR',TfrxMemoView(Sender).TagSTr);&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross3OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CrObj := DBCross3Object1;&#13;&#10;  TabNum := '3';&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;// для неначисленных за сводом&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross4Cell0OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if ((TfrxMemoView(Sender).Memo.Text &#60;&#62; '') and (TfrxMemoView(Sender).TagSTr &#60;&#62; '')) then&#13;&#10;    GalaxyOnClick('FRMASDATAZNACH4','CKATPODR',TfrxMemoView(Sender).TagSTr);&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross4OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CrObj := DBCross4Object1;&#13;&#10;  TabNum := '4';&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;// для сальдо на начало периода&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross5OnPrintCell(Memo: TfrxMemoView; RowIndex, ColumnIndex, CellIndex: Integer; RowValues, ColumnValues, Value: Variant);&#13;&#10;begin&#13;&#10;  if (vartostr(RowValues[0]) = '') then&#13;&#10;  begin&#13;&#10;    if (vartostr(RowValues[1]) = 'Долг за работником') then&#13;&#10;      Memo.TagStr := vartostr(ColumnValues[1]) + '&#38;14299&#38;' + TabNum&#13;&#10;    else&#13;&#10;      Memo.TagStr := vartostr(ColumnValues[1]) + '&#38;15299&#38;' + TabNum&#13;&#10;  end&#13;&#10;  else&#13;&#10;    Memo.TagStr := vartostr(ColumnValues[1])+'&#38;'+vartostr(RowValues[0])+'&#38;'+TabNum;&#13;&#10;&#13;&#10;  //если сумма в ячейке равна нулю, то курсор принимает вид руки,&#13;&#10;  //показывая, что клик по этой ячейке не вызывает никакого события&#13;&#10;  if (vartostr(Value) = '0') then&#13;&#10;    Memo.Cursor := crDefault;&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross5Cell0OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if ((TfrxMemoView(Sender).Memo.Text &#60;&#62; '') and (TfrxMemoView(Sender).TagSTr &#60;&#62; '')) then&#13;&#10;    GalaxyOnClick('FRITOG5','CKATPODR',TfrxMemoView(Sender).TagSTr);&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross5OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CrObj := DBCross5Object1;&#13;&#10;  TabNum := '5';&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;// для удержаний&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross6Cell0OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if ((TfrxMemoView(Sender).Memo.Text &#60;&#62; '') and (TfrxMemoView(Sender).TagSTr &#60;&#62; '')) then&#13;&#10;    GalaxyOnClick('FRMASDATAZNACH6','CKATPODR',TfrxMemoView(Sender).TagSTr);&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross6OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CrObj := DBCross6Object1;&#13;&#10;  TabNum := '6';&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;// для сумм к выплате&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross7Cell0OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if ((TfrxMemoView(Sender).Memo.Text &#60;&#62; '') and (TfrxMemoView(Sender).TagSTr &#60;&#62; '')) then&#13;&#10;    GalaxyOnClick('FRMASDATAZNACH7','CKATPODR',TfrxMemoView(Sender).TagSTr);&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross7OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  CrObj := DBCross7Object1;&#13;&#10;  TabNum := '7';&#13;&#10;end;&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;// для налогов на ФОТ&#13;&#10;//------------------------------------------------------------------------------&#13;&#10;procedure DBCross9Cell0OnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if ((TfrxMemoView(Sender).Memo.Text &#60;&#62; '') and (TfrxMemoView(Sender).TagSTr &#60;&#62; '')) then&#13;&#10;    GalaxyOnClick('FRMASDATAZNACH9','CKATPODR',TfrxMemoView(Sender).TagSTr);&#13;&#10;end;&#13;&#10;//-