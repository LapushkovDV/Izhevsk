<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="B:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40786,6755902083" ReportOptions.Description.Text="" ReportOptions.Name="_ЭМ Альтернативный листок нетрудоспособности" ReportOptions.LastChange="43481,4563286574" ScriptLanguage="PascalScript" ScriptText.Text="function fGetDayGraf : double;&#13;&#10;  var dsZarpl : TfrxDataSet;&#13;&#10;begin&#13;&#10;  Result := 0;&#13;&#10;&#13;&#10;  dsZarpl := Report.GetDataSet('Zarpl');&#13;&#10;  dsZarpl.First;&#13;&#10;&#13;&#10;  while not dsZarpl.EOF do&#13;&#10;  begin&#13;&#10;    Result := Result + dsZarpl.Value('GRAFIC');&#13;&#10;    dsZarpl.NEXT;&#13;&#10;  end; // while&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo13OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;ZARPL.&#34;MONTH&#34;&#62; &#60;&#62; 0 then&#13;&#10;  begin&#13;&#10;    Memo13.Text := FormatdateTime('mm', EncodeDate(1900,&#60;ZARPL.&#34;MONTH&#34;&#62;,1))+&#60;SORTTABN.&#34;SEPARATOR&#34;&#62;+ FormatdateTime('YYYY', EncodeDate(&#60;ZARPL.&#34;YEAR&#34;&#62;,1,1))&#13;&#10;  end&#13;&#10;  else Memo13.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo52OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  if (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62;'') and ((&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 7) or (&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 4)) then&#13;&#10;//    Memo52.Text := &#60;SORTTABN.&#34;DAYS&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo54OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62;'') and (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62; '7')&#13;&#10;                               and (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62; '4') then&#13;&#10;    begin&#13;&#10;//      memo54.DisplayFormat.Kind := fkNumeric;&#13;&#10;//      memo54.DisplayFormat.FormatStr := '%2.2n';&#13;&#10;//      memo54.text := memo46.Text;&#13;&#10;    end&#13;&#10;  else&#13;&#10;    begin&#13;&#10;//     memo54.DisplayFormat.Kind := fkNumeric;&#13;&#10;//      memo54.DisplayFormat.FormatStr := '%2.2n';&#13;&#10;//      memo54.text := &#60;SORTTABN.&#34;ITOGORAS&#34;&#62;;&#13;&#10;    end;&#13;&#10; end;&#13;&#10;&#13;&#10;&#13;&#10;procedure DetailData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if (&#60;ARBOL.&#34;KOLDNM&#34;&#62; = 0) and (&#60;ARBOL.&#34;SUMMA&#34;&#62; = 0)   //(&#60;ARBOL.&#34;DATANM&#34;&#62; = 0) and (&#60;ARBOL.&#34;DATOK&#34;&#62; = 0) and&#13;&#10;  then DetailData2.Visible := False&#13;&#10;  else DetailData2.Visible := True;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ARBOLWITHPERCENTOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var okr : integer;&#13;&#10;begin&#13;&#10;  if (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 1) or (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 2) then&#13;&#10;    okr := 3&#13;&#10;  else okr := 2;&#13;&#10;  ARBOLWITHPERCENT.DisplayFormat.Kind := fkNumeric;&#13;&#10;  ARBOLWITHPERCENT.DisplayFormat.FormatStr := '%2.'+ IntToStr(okr) +'n';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ARBOLSUMMAOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var okr : integer;&#13;&#10;begin&#13;&#10; if (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 1) or (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 2) then&#13;&#10;    okr := 3&#13;&#10;  else okr := 2;&#13;&#10;  ARBOLSUMMA.DisplayFormat.Kind := fkNumeric;&#13;&#10;  ARBOLSUMMA.DisplayFormat.FormatStr := '%2.'+ IntToStr(okr) +'n';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ARBOLSRZFZPMOnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var okr : integer;&#13;&#10;begin&#13;&#10;  if (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 1) or (&#60;SORTTABN.&#34;OKRUGL&#34;&#62; &#60;&#62; 2) then&#13;&#10;    okr := 3&#13;&#10;  else okr := 2;&#13;&#10;  ARBOLSRZFZPM.DisplayFormat.Kind := fkNumeric;&#13;&#10;  ARBOLSRZFZPM.DisplayFormat.FormatStr := '%2.'+ IntToStr(okr) +'n';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo12OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;ZARPL.&#34;COMPENSATION&#34;&#62; = 0 ) then Memo12.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DetailData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;  var dSum : double;&#13;&#10;begin&#13;&#10;  dSum := &#60;ZARPL.&#34;ZARP&#34;&#62;+&#60;ZARPL.&#34;COMPENSATION&#34;&#62;+&#60;ZARPL.&#34;LIMIT&#34;&#62;+&#60;ZARPL.&#34;ZARPYEAR&#34;&#62;+&#60;ZARPL.&#34;SUMRASCH&#34;&#62;;&#13;&#10;&#13;&#10;  if ( ( &#60;SORTTABN.&#34;WTYPEBL&#34;&#62; = 0 ) and ( dSum = 0 ) )  or&#13;&#10;     ( ( &#60;ZARPL.&#34;MONTH&#34;&#62; = 0 ) and ( &#60;ZARPL.&#34;DAYS&#34;&#62; = 0 ) )&#13;&#10;  then&#13;&#10;    DetailData1.Visible := false&#13;&#10;  else&#13;&#10;    DetailData1.Visible := true;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo74OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  if (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62;'') and ((&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 7) or (&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 4)) then&#13;&#10;//    Memo52.Text := &#60;SORTTABN.&#34;DAYS&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo8OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;ZARPL.&#34;MONTH&#34;&#62; = 0 then Memo8.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo9OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;ZARPL.&#34;GRAFIC&#34;&#62; = 0 ) then Memo9.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo17OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;ZARPL.&#34;LIMIT&#34;&#62; = 0 ) then Memo17.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo20OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;ZARPL.&#34;ZARPYEAR&#34;&#62; = 0 ) then  Memo20.text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo60OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;SORTTABN.&#34;VIDBL&#34;&#62; = '1' ) then&#13;&#10;    Memo60.Text := 'продолжающийся'&#13;&#10;  else&#13;&#10;    Memo60.Text := 'первичный';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo48OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  //  if (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62;'') and ((&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 7) or (&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 4)) then&#13;&#10;//    Memo52.Text := &#60;SORTTABN.&#34;DAYS&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo155OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  case &#60;SORTTABN.&#34;WMROT&#34;&#62; of&#13;&#10;  1,2 : Memo155.Text := 'Из МРОТ';&#13;&#10;  else&#13;&#10;     Memo155.Text := 'Огран.';&#13;&#10;  end;&#13;&#10;//_GP_&#13;&#10;     Memo155.Text := 'Огран.';&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo25OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;ARBOL.&#34;GRAFIC&#34;&#62; = 0 ) then Memo25.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo43OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  //  if (&#60;SORTTABN.&#34;DOPPR&#34;&#62; &#60;&#62;'') and ((&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 7) or (&#60;SORTTABN.&#34;DOPPR&#34;&#62; = 4)) then&#13;&#10;//    Memo52.Text := &#60;SORTTABN.&#34;DAYS&#34;&#62;;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo53OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;SORTTABN.&#34;ZASCHETPREV&#34;&#62; = 0 ) then Memo53.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure BarCode2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;SORTTABN.&#34;BARCODE&#34;&#62; = '' ) then&#13;&#10;    BarCode2.Visible := false&#13;&#10;  else&#13;&#10;    BarCode2.Visible := true;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo109OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;SORTTABN.&#34;MROT&#34;&#62; = 0 ) then  Memo109.Text := '';&#13;&#10;  Memo109.Top := Memo108.Top;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo33OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;SORTTABN.&#34;ZASCHETPREV&#34;&#62; = 0 ) then Memo33.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo35OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;SORTTABN.&#34;FYEAROGRAN&#34;&#62; = '' ) then&#13;&#10;    Memo35.Text := '';&#13;&#10;  Memo35.Height := sFieldYearOgran.Height;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo23OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo23.Height := sFieldYearOgran.Height;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo37OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo37.Height := sFieldYearOgran.Height;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo142OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;SORTTABN.&#34;OGRNFROMMROT&#34;&#62; = 0 ) then Memo142.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo44OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ( &#60;SORTTABN.&#34;OGRNFROMMROT&#34;&#62; = 0 ) then Memo44.Text := '';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo91OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Memo91.Top := Memo90.Top;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo153OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;SORTTABN.&#34;DAYSORHOURS&#34;&#62; = 'Часов' then&#13;&#10;  begin&#13;&#10;    Memo153.Text := 'Сред. ч.';&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." ShowProgress="False" PropData="">
