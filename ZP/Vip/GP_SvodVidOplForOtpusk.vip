procedure FillsumvidopSumByLschet;
{


  insert into sumvidopSum (Nrec, Summa, VidOpl, cLsch, CexOz, cPodrOz, Koldn, MesN, Mes, Summa30,Proc,
                          cSchetD,cSubSchD,cKAUD[1],cKAUD[2],cKAUD[3],cKAUD[4],cKAUD[5],cKAUD[6],
                        TblD[1],TblD[2],TblD[3],TblD[4],TblD[5],TblD[6],sReCalc, YearN, Tek)
  select sumvidop.Nrec,
         sumvidop.Summa,
         sumvidop.VidOPl,
         sumvidop.cLSch,
         sumvidop.CexOz,
         sumvidop.cPodr,
         sumvidop.Koldn,
         sumvidop.mesn,
         sumvidop.Mes,
         sumvidop.Summa30,
         sumvidop.Proc,
         sumvidop.cSchetD,
         sumvidop.cSubSchD,
         sumvidop.cKAUD[1],
         sumvidop.cKAUD[2],
         sumvidop.cKAUD[3],
         sumvidop.cKAUD[4],
         sumvidop.cKAUD[5],
         sumvidop.cKAUD[6],
         sumvidop.TblD[1],
         sumvidop.TblD[2],
         sumvidop.TblD[3],
         sumvidop.TblD[4],
         sumvidop.TblD[5],
         sumvidop.TblD[6],
         sumvidop.Otkuda,
         sumvidop.Yearn,
         integer(2)
  from sumvidop where ((vSvodVidOpl.VIDYear     == sumvidop.YearN(noindex) and
                        vSvodVidOpl.VIDMonthN  <<= sumvidop.mesn(noindex) and
                        vSvodVidOpl.VIDMonthK  >>= sumvidop.mesn(noindex)
                     )) and Foundmarker(vSvodVidOpl._PodrMArkerPointer, sumvidop.CexOz);



  insert into sumvidopSum (Nrec, Summa, VidOpl, cLsch, CexOz, cPodrOz, Koldn, MesN, Mes, Summa30,Proc,
                          cSchetD,cSubSchD,cKAUD[1],cKAUD[2],cKAUD[3],cKAUD[4],cKAUD[5],cKAUD[6],
                        TblD[1],TblD[2],TblD[3],TblD[4],TblD[5],TblD[6],sReCalc, YearN, Tek)
  select nachisl.Nrec,
         nachisl.Summa,
         nachisl.VidOPls,
         nachisl.cLSch,
         nachisl.CexOz,
         nachisl.cPodr,
         nachisl.Koldn,
         nachisl.mesn,
         nachisl.Mes,
         nachisl.Summa30,
         nachisl.Proc,
         nachisl.cSchetD,
         nachisl.cSubSchD,
         nachisl.cKAUD[1],
         nachisl.cKAUD[2],
         nachisl.cKAUD[3],
         nachisl.cKAUD[4],
         nachisl.cKAUD[5],
         nachisl.cKAUD[6],
         nachisl.TblD[1],
         nachisl.TblD[2],
         nachisl.TblD[3],
         nachisl.TblD[4],
         nachisl.TblD[5],
         nachisl.TblD[6],
         nachisl.Otkuda,
         nachisl.Yearn,
         integer(2)
  from nachisl where ((vSvodVidOpl.VIDYear     == nachisl.YearN(noindex) and
                        vSvodVidOpl.VIDMonthN  <<= nachisl.mesn(noindex) and
                        vSvodVidOpl.VIDMonthK  >>= nachisl.mesn(noindex)
                     )) and Foundmarker(vSvodVidOpl._PodrMArkerPointer, nachisl.CexOz);

  insert into sumvidopSum (Nrec, Summa, VidOpl, cLsch, CexOz, cPodrOz, Koldn, MesN, Mes, Summa30,Proc,
                          cSchetD,cSubSchD,cKAUD[1],cKAUD[2],cKAUD[3],cKAUD[4],cKAUD[5],cKAUD[6],
                        TblD[1],TblD[2],TblD[3],TblD[4],TblD[5],TblD[6],sReCalc, YearN, Tek)
  select nenach.Nrec,
         nenach.Summa,
         nenach.VidOPls,
         nenach.cLSch,
         nenach.CexOz,
         nenach.cPodr,
         nenach.Koldn,
         nenach.mesn,
         nenach.Mes,
         nenach.Summa30,
         nenach.Proc,
         nenach.cSchetD,
         nenach.cSubSchD,
         nenach.cKAUD[1],
         nenach.cKAUD[2],
         nenach.cKAUD[3],
         nenach.cKAUD[4],
         nenach.cKAUD[5],
         nenach.cKAUD[6],
         nenach.TblD[1],
         nenach.TblD[2],
         nenach.TblD[3],
         nenach.TblD[4],
         nenach.TblD[5],
         nenach.TblD[6],
         nenach.Otkuda,
         nenach.Yearn,
         integer(2)
  from nenach where ((vSvodVidOpl.VIDYear     == nenach.YearN(noindex) and
                        vSvodVidOpl.VIDMonthN  <<= nenach.mesn(noindex) and
                        vSvodVidOpl.VIDMonthK  >>= nenach.mesn(noindex)
                     )) and Foundmarker(vSvodVidOpl._PodrMArkerPointer, nenach.CexOz);




}

procedure FillPerevodByLschet;
{


  insert into tmp_Perevod (VidPer, MonthN, YEARN, Sumper, Oblags,CexOZ, Otkuda, Cnach, cLsch, Tek)
    select perevod.Vidper, 
           perevod.MESN, 
           perevod.YEARN,
           perevod.Sumper, 
           perevod.Oblags, 
           perevod.CexOZ, 
           perevod.Otkuda, 
           perevod.Cnach,
           perevod.cLsch,
           integer(2)
    from perevod where ((vSvodVidOpl.VIDYear     == perevod.YearN(noindex) and
                                   vSvodVidOpl.VIDMonthN  <<= perevod.MesN(noindex)  and
                                   vSvodVidOpl.VIDMonthK  >>= perevod.MesN(noindex)
                          )) and Foundmarker(vSvodVidOpl._PodrMArkerPointer, perevod.CexOz);


  insert into tmp_Perevod (VidPer, MonthN, YEARN, Sumper, Oblags,CexOZ, Otkuda, Cnach, cLsch, Tek)
    select perevodtek.Vidper, 
           perevodtek.MESN, 
           perevodtek.YEARN,
           perevodtek.Sumper, 
           perevodtek.Oblags, 
           perevodtek.CexOZ, 
           perevodtek.Otkuda, 
           perevodtek.Cnach,
           perevodtek.cLsch,
           integer(2)
    from perevodtek where ((vSvodVidOpl.VIDYear     == perevodtek.YearN(noindex) and
                                   vSvodVidOpl.VIDMonthN  <<= perevodtek.MesN(noindex)  and
                                   vSvodVidOpl.VIDMonthK  >>= perevodtek.MesN(noindex)
                          )) and Foundmarker(vSvodVidOpl._PodrMArkerPointer, perevodtek.CexOz);


}

procedure FillTmpLgNalLsZByLschet;
{

  // забьем льготы во временную таблицу
  insert into tmp_LgNalLsZ (NRec, LastUser, LastTime, LastDate, FilialNo, cLschet, VIDPER,
                            Proc, Summa, VIDPER1, Priznak, NomScale, Year, Mes, Proc1, YearEnd, MesEnd)
  select LgNalLsZ.NRec,
         LgNalLsZ.LastUser,
         LgNalLsZ.LastTime,
         LgNalLsZ.LastDate,
         LgNalLsZ.FilialNo,
         LgNalLsZ.cLschet,
         LgNalLsZ.VIDPER,
         LgNalLsZ.Proc,
         LgNalLsZ.Summa,
         LgNalLsZ.VIDPER1,
         LgNalLsZ.Priznak,
         LgNalLsZ.NomScale,
         LgNalLsZ.Year,
         LgNalLsZ.Mes,
         LgNalLsZ.Proc1,
         LgNalLsZ.YearEnd,
         LgNalLsZ.MesEnd
   from LgNalLsZ;

}
//-------------------------------------------------------------------------------
// виды оплаты 
//-------------------------------------------------------------------------------
function fNmVidOplDogStr: string;
var
  liCountMarker : longInt;
  cnRecVidOplDog: comp;
{
  fNmVidOplDogStr := 'Не заданы';

  liCountMarker   := GetMarkerCount(MarkerVidOplForOtpusk);

  case liCountMarker of
  0:
  {
    exit;
  }
  1:
  {
    GetMarker(MarkerVidOplForOtpusk, 0, cnRecVidOplDog);
    if ( getFirst KlVidOpl where (( cnRecVidOplDog == KlVidOpl.Nrec )) = tsOk )
    {
      fNmVidOplDogStr := string(KlVidOpl.VidOplP) + ', ' + KlvidOpl.NVidOpl;
    }
  }
  2..4:
  {
    fNmVidOplDogStr := 'Задано ' + string(liCountMarker) + ' вида оплаты';
  }
  else
  {
    fNmVidOplDogStr := 'Задано ' + string(liCountMarker) + ' видов оплаты';
  }
  end;
}//function fNmVidOplDogStr

screen scr1;
fields
  VIDYear      ('За какой год формировать отчета по видам неявок',hcNoContext,sci1Esc):noprotect,spinbutton [1, 1900, 2100];
  VIDMonthN    ('Укажите начальный месяц для формирования отчета',hcNoContext) :
    [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
          ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;
  VIDMonthK     ('Укажите месяц для формирования отчета',hcNoContext) :
    [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
          ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;
  [VidOplDogStr] fNmVidOplDogStr() ('Виды оплаты',, sci13Esc): protect, pickbutton;

  FiltrPodr  ('Фильтр по подразделению', hcNoContext): protect, pickbutton;

buttons
  cmOk,,,'Сформировать отчет', ,sci1Esc;
  cmCancel,,,'Выход', ,sci1Esc;
<<
 `Формировать за год`.@@@@@@     `с`.@@@@@@@@@@@@@ `по`.@@@@@@@@@@@@@

 `Виды оплаты `      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `По подразделениям (цехам) отнесения затрат:`
                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. ~С~формировать .>                            <.    ~О~тмена    .>

>>
end;

HandleEvent

cmInit:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);

  InitUser(1); // Инициализация Zar_User
  // Инициализация отчетных дат данными из настроек
  InitCurrentPeriodDates();

  if (not ReadMyDsk(VIDYear, 'VIDYear_SvodVidOpl', false))
    set VIDYear := Word(YearRas);

  if (not ReadMyDsk(VIDMonthN, 'VIDMonthN_SvodVidOpl', false))
    VIDMonthN := 1; // Январь (нумерация в списке с нуля).

  if (not ReadMyDsk(VIDMonthK, 'VIDMonthK_SvodVidOpl', false))
    VIDMonthK := MonthRas;

  MarkerVidOplForOtpusk := InitMarker('mVidoplDog_SvodVidOplForOtpusk', 8, 10, 10);

  if not ReadMyDsk(Filtrpodr,'k_Filtrpodr',false)
    {}
  mrkOuterClassfier:=InitMarker('FOT_NIK_mrkOuterClassfier',8,20,10); //маркер с отмеченными классификаторами

  if GetMarkerCount(mrkOuterClassfier) = 0
    MarkerNotNull:= false;
  else MarkerNotNull:=true;

  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  mtClear(#tmp_KlVidOpl, mfNormal);
  mtClear(#tmp_Perech, mfNormal);

  insert into tmp_KlVidOpl
  select KlVidOpl.Nrec, 
         KlVidOpl.Vidopl, 
         KlVidOpl.VidoplP, 
         KlVidOpl.NVIDOPL, 
         Trim(KlVidopl.VHVOE[19]),
         Trim(KlVidopl.VHVOE[32]), 
         Trim(KlVidopl.VHVOE[34]),
         Trim(KlVidopl.VHVOE[35]), 
         Trim(KlVidopl.VHVOE[5])
  from KlVidOpl;

  insert into tmp_Perech
  select Perech.VidPer, 
         Perech.NAMEPER
  from Perech;

  StopVisual('', 0);
}

cmUpdateRecord : update current zar_user;

cmCheckField:
{
  case CurField of
    #VIDYear:
    {
      if (VIDYear < 1900) or (VIDYear > YearRas) then
        Set VIDYear := Word(YearRas);
      if (VIDYear = YearRas) and (VIDMonthK > MonthRas) then
        Set VIDMonthK := Word(MonthRas);
    }

    #VIDMonthN:
    {
      if (VIDMonthN > VIDMonthK)
        set VIDMonthN := VIDMonthK;
    }

    #VIDMonthK:
    {
      if (VIDYear = YearRas) and (VIDMonthK > MonthRas) then
        Set VIDMonthK := Word(MonthRas);
      if (VIDMonthN > VIDMonthK)
        set VIDMonthN := VIDMonthK;
    }
  end;  //case
  PodrPubCheck; //Процедура для фильтров по подразд. и работникам
  RedrawPanel(#Zar_User);
}//cmCheckField

cmDelOnProtect:
{
  case CurField of
  #VidOplDogStr:
  //виды оплаты по договорам
  {
    ClearMarker(MarkerVidOplForOtpusk);
    RedrawPanel(CurTable);
  }
  end;
}

cmPick:
{
  if CurField = #VidOplDogStr
  {
    cTemp := comp(0);
    RunInterface(Z_Calc::PickZarEntity , 1, cTemp, 103, MarkerVidOplForOtpusk)
  }

  PodrPubPick; //Процедура для фильтров по подразд. и работникам
  RedrawPanel(#Zar_User);
} // cmPick

cmOk:
{

  intinit;

  update current Zar_User;

  if not FillMarks then  // Заполнение Formarks
  {
    abort;
    exit;
  }

  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  if GetMarkerCount(MarkerVidOplForOtpusk) = 0
  {
         Message(chr(3)+'Нет задан фильтр "Виды оплаты"', Information + OkButton);
         abort;
         exit;
  }

  var nom:integer;
  var Numcol:integer;
  nom:=2;
  Numcol:=1;

  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);

  ExcelPath:= TranslatePath('%ClientStartPath%');
                                                                                                          
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\SvodVidOpl.xlsx',true);                                      
  if (xlIsExcelValid)   xlSetActiveSheet(1);//активный лист

  XLPAGESETUPSETORIENTATION(xlLandscape);//альбомный лист
  XLPAGESETUPSETPAPERSIZE(xlPaperA4);//формат листа А4

  xlSetCellStringValue('Cводка отчислений по видам оплат c '+DateToStr(date(1,VIDMonthN,VIDYear), 'mon')
      +' по '+DateToStr(date(1,VIDMonthK,VIDYear), 'month')+' '+DateToStr(date(1,VIDMonthK,VIDYear), 'YYYY года'), 1, 3, 1, 3);
  xlSetFontStyle(xlBold, 1, 3, 1, 3);
  xlSetFontSize(18, 1, 3, 1, 3);

  StopVisual('', 0);

  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Обработка информации...', 1);

  mtClear(#sumvidopSum, mfNormal);
  mtClear(#tmp_LgNalLsZ, mfNormal);
  mtClear(#tmp_Perevod, mfNormal);
 
  // заполняем временную таблицу для подсчета
  FillsumvidopSumByLschet;
  // льготы по налогам на ФОТ
  FillTmpLgNalLsZByLschet;
  //налоги на ФОТ
  FillPerevodByLschet;

  StopVisual('', 0);

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Формирование отчета...', RecordsInTable(#tmp_KlVidOpl));

  p5 := p2_ := p3 := p11 := p12 := p8_1 := p8_2 := s8_1 := s8_2 := 0;
  Itog_p5 := Itog_p2_ := Itog_p3 := Itog_p11 := Itog_p12 := Itog_p8_1 := Itog_p8_2 := Itog_s8_1 := Itog_s8_2 := 0;
  Itog_SummaVidOp := 0;

  nom:=4;

  _loop FullCache tmp_KlVidOpl
  {

    if not NextVisual
      break;

    if not Foundmarker(MarkerVidOplForOtpusk, tmp_KlVidOpl.Nrec)
      continue;

    SummaVidOp := 0;
    p5 := p2_ := p3 := p11 := p12 := p8_1 := p8_2 := s8_1 := s8_2 := 0;

    _loop FullCache sumvidopSum
    {

      SummaVidOp      += sumvidopSum.Summa;
      Itog_SummaVidOp += sumvidopSum.Summa;

      _loop FullCache tmp_Perevod
      {

        if tmp_Perevod.VidPer = 5
        {
          p5      += tmp_Perevod.Sumper;
          Itog_p5 += tmp_Perevod.Sumper;
        }

        if tmp_Perevod.VidPer = 2
        {
          p2_      += tmp_Perevod.Sumper;
          Itog_p2_ += tmp_Perevod.Sumper;
        }

        if tmp_Perevod.VidPer = 3
        {
          p3      += tmp_Perevod.Sumper;
          Itog_p3 += tmp_Perevod.Sumper;
        }

        if tmp_Perevod.VidPer = 11
        {
          p11      += tmp_Perevod.Sumper;
          Itog_p11 += tmp_Perevod.Sumper;
        }

        if tmp_Perevod.VidPer = 12
        {
          p12      += tmp_Perevod.Sumper;
          Itog_p12 += tmp_Perevod.Sumper;
        }

        if tmp_Perevod.VidPer = 8
        {


//          if getfirst fastfirstrow tmp_LgNalLsZ = tsOk
//          {

		if round(tmp_Perevod.sumper/tmp_Perevod.OBLAGS,4)=0.0012
		{
                p8_2      += tmp_Perevod.Sumper;
                Itog_p8_2 += tmp_Perevod.Sumper;
                s8_2      += sumvidopSum.Summa;
                Itog_s8_2 += sumvidopSum.Summa;
		}
		else
		{
                p8_1      += tmp_Perevod.Sumper;
                Itog_p8_1 += tmp_Perevod.Sumper;
                s8_1      += sumvidopSum.Summa;
                Itog_s8_1 += sumvidopSum.Summa;
		}
        }

//	}	
/*
            //отмена льгот
            if ((substr(tmp_LgNalLsZ.LastUser,1,1) = ' ')
                  or (substr(tmp_LgNalLsZ.LastUser,1,1) = '')
                  or (substr(tmp_LgNalLsZ.LastUser,1,1) = 4))
                  and (tmp_LgNalLsZ.NomScale = 0)
                  and (tmp_LgNalLsZ.Proc = 100)
            {
                p8_1      += tmp_Perevod.Sumper;
                Itog_p8_1 += tmp_Perevod.Sumper;
                s8_1      += sumvidopSum.Summa;
                Itog_s8_1 += sumvidopSum.Summa;
            }
            else
            {

                p8_2      += tmp_Perevod.Sumper;
                Itog_p8_2 += tmp_Perevod.Sumper;
                s8_2      += sumvidopSum.Summa;
                Itog_s8_2 += sumvidopSum.Summa;
            }
          }
          else
          {
            p8_1      += tmp_Perevod.Sumper;
            Itog_p8_1 += tmp_Perevod.Sumper;
            s8_1      += sumvidopSum.Summa;
            Itog_s8_1 += sumvidopSum.Summa;
          }
*/



      }//_loop FullCache tmp_Perevod

    }//_loop FullCache sumvidopSum

    if SummaVidOp != 0
    {
      Numcol:=1;
      xlSetCellStringValue(tmp_KlVidOpl.VidOplP      , ++nom,   Numcol, nom, Numcol);
      xlSetCellStringValue(tmp_KlVidOpl.NVIDOPL      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(SummaVidOp                ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p5                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p2_                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p3                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p11                       ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p12                       ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p8_1                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p8_2                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p5+p2_+p3+p11+p12+p8_1+p8_2,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(s8_1                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(s8_2                      ,   nom, ++Numcol, nom, Numcol);

    }//_loop FullCache tmp_KlVidOpl

  }//_loop FullCache tmp_KlVidOpl


  if Itog_SummaVidOp != 0
  {
    Numcol:=1;
    xlSetCellStringValue('ВСЕГО'                   , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_SummaVidOp           ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p5                   ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p2_                   ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p3                   ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p11                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p12                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p8_1                 ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p8_2                 ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p5+Itog_p2_+Itog_p3+Itog_p11+Itog_p12+Itog_p8_1+Itog_p8_2 
                                                   ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_s8_1                 ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_s8_2                 ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 2);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  }

!  xlWrapText(5, 1, nom, Numcol);//перенос по словам
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB + xlInsideV + xlInsideH,
                      xlThin, xlContinuous, 0, 5, 1, nom, Numcol);//рамка xlThick - жирная

  StopVisual('',0);
  xlkillExcel;

  exitproc;

}

cmClose:
{
  SaveMyDSK(VIDYear,   'VIDYear_SvodVidOpl');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_SvodVidOpl');
  SaveMyDSK(VIDMonthK, 'VIDMonthK_SvodVidOpl');
  DoneMarker(MarkerVidOplForOtpusk, 'mVidoplDog_SvodVidOplForOtpusk');
  DoneMarker(_PodrMArkerPointer,'');
  DoneMarker(mrkOuterClassfier,'FOT_NIK_mrkOuterClassfier');
}

cmDone:
{
  SaveMyDSK(VIDYear,   'VIDYear_SvodVidOpl');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_SvodVidOpl');
  SaveMyDSK(VIDMonthK, 'VIDMonthK_SvodVidOpl');
  DoneMarker(MarkerVidOplForOtpusk, 'mVidoplDog_SvodVidOplForOtpusk');
  DoneMarker(_PodrMArkerPointer,'');
  DoneMarker(mrkOuterClassfier,'FOT_NIK_mrkOuterClassfier');
}

end;
end.

#include UserReport.vih

VipInterface UserReport_gp_SvodVidOplForOtpusk Implements IUserReport;
Interface UserReport_gp_SvodVidOplForOtpusk;

Procedure Run;
Begin
  runinterface(gp_SvodVidOplForOtpusk);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Cводка отчислений по видам оплат для отпуска';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.


