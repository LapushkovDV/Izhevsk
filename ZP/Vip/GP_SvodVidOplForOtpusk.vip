#include PAFilter.vih

interface gp_SvodVidOplforOtpusk 'Cводка отчислений по видам оплат для отпуска' EscClose, Gray;
  show at (,,80,10);

  table struct tmp_KlVidOpl 
  (
    Nrec   : comp,
    VidOpl : comp,
    VidOplP: longint,
    NVIDOPL: string,
    VHVOE19: string,
    VHVOE32: string,  //общая входимость в облагаемую базу ЕСН/СВ
                      //поле социальных налогов на вкладке Расчеты
    VHVOE34: string,  //входимость в отчетность
    VHVOE35: string,
    VHVOE5:  string
  )
  with index
  (
    tmp_KlPerOpl01 = VidOpl
  );

  table struct tmp_Perech  
  (  
    VidPer       : word,          // Номер по порядку
    NAMEPER      : string
  )
  with index 
  ( 
    tmp_Perech01 = VidPer
  );
  // суммы по графам
  table struct sumvidopSum   
  (
    Nrec          : Comp,
    Summa         : double,
    VidOpl        : longint,
    cLsch         : comp,
    CexOz         : comp,
    cNach         : comp,
    cPodrOZ       : comp,
    Koldn         : double,
    MesN          : word,
    Mes           : integer,
    Sovm          : word,
    Summa30       : double,
    Proc          : double,
    cSchetD       : string[20],
    cSubSchD      : string[21],
    cKAUD         : array [1..6] of Comp,
    TblD          : array [1..6] of Word,
    sReCalc       : string[1],
    YearN         : Integer,
    Tek           : Integer
  )
  with index 
  (
    sumvidopSum01 = VidOpl,
    sumvidopSum02 = MesN + YearN/* + CexOz*/,
    sumvidopSum03 = CexOz
  );

  table struct tmp_Perevod 
  (
    Nrec    : comp,
    VidPer  : word,          //Номер из классификатора
    YEARN   : integer,
    MonthN  : word,          //месяц, к которому относить
    CexOZ   : comp,          //подр.ОЗ для переведенных из другого фил-ла
    Sumper  : tSumma,         //сумма налога
    Oblags  : tSumma,         //база
    Otkuda  : s1,           //источник начислений
    Cnach   : tNrec,           // nrec источника начислений
    cLsch   : comp,
    Tek     : Integer
  )
  with index 
  ( 
    tmp_Perevod01 = VidPer + MonthN,
    tmp_Perevod02 = Otkuda + Cnach + CLSCH,
    tmp_Perevod03 = Tek + Cnach + CLSCH,
    tmp_Perevod04 = Cnach + CLSCH
  );

  table struct tmp_LgNalLsZ
  (
      NRec    : comp
    , LastUser : string[20]
    , LastTime : Time
    , LastDate : Date
    , FilialNo : Longint
    , cLschet  : comp
    , VIDPER   : Word
    , Proc     : Double
    , Summa    : Double
    , VIDPER1  : Word
    , Priznak  : Word
    , NomScale : Word
    , Year     : Word
    , Mes      : Word
    , Proc1    : Double
    , YearEnd  : Word
    , MesEnd   : Word
  )
  With Index
  (
      tmp_LgNalLsZ01 = cLschet
    , tmp_LgNalLsZ03 = VIDPER + cLschet + Year(Desc) + Mes(Desc)
    , tmp_LgNalLsZ04 = cLschet + VIDPER + Year(Desc) + Mes(Desc)
  );

create view vSvodVidOpl
var
  ExcelPath       : string;
  Marker, iCount, i, lTemp  : longint;
  _PodrMArkerPointer: Longint; // сам маркер
  CLSF              : CurLSFunctions;
  mrkOuterClassfier : longInt;   //маркер с отмеченными классификаторами
  MarkerNotNull     : boolean;   // флаг - маркер не пустой
  ClassSeg          : comp;      //nRec сегмента классификатора
  FiltrPublic       : string;
  MyFlag            : boolean;   //флаг для различных целей
  i1                : integer;   //для циклов
  p2                : double;
  VIDYear         : word;
  VIDMonthN       : word;
  VIDMonthK       : word;
  cTemp           : comp;
  MarkerVidOplForOtpusk    : longInt;
  SummaVidOp      : double;
  Itog_SummaVidOp : double;
  p5,p2_,p3,p11,p12,p8_1,p8_2,s8_1,s8_2: double;
  Itog_p5,Itog_p2_,Itog_p3,Itog_p11,Itog_p12,Itog_p8_1,Itog_p8_2, Itog_s8_1,Itog_s8_2: double;
  #include PAFilter.var
(
  FiltrPodr
)
as select
  #include GP_Podrfiltr1.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.

from
  Zar_User
  ,Lschet
!  ,Lschet Lschet1
  ,Lschet LschetN
  ,Persons PersonsN
!  ,Persons Persons1
!  ,SumVidOp
!  ,LgNalLsZ
!  ,nachislzakaz
!  ,Perevod
!  ,Perevod Perevod1
!  ,perevodtekzakaz
  ,sumvidopSum
  ,tmp_LgNalLsZ         //временная таблица льготы по работнику
!  ,tmp_LgNalLsZ tmp_LgNalLsZ1        //временная таблица льготы по работнику
  ,tmp_Perevod
  ,tmp_KlVidOpl
  ,tmp_Perech
  ,KlVidOpl
  ,CurLschet
where 
((
  _cLSchet                  == Formarks.Choice           
  and tmp_KlVidOpl.VidOpl  == sumvidopSum.VidOpl
  and sumvidopSum.Tek        == tmp_Perevod.Tek
  and sumvidopSum.Nrec       == tmp_Perevod.Cnach

  and tmp_Perevod.cLsch     == tmp_LgNalLsZ.cLschet 
  and tmp_Perevod.VidPer    == tmp_LgNalLsZ.VIDPER  
  and (tmp_Perevod.YEARN    >= tmp_LgNalLsZ.Year    
       and tmp_Perevod.MonthN   >= tmp_LgNalLsZ.MES)

  and #include GP_Podrfiltr2.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.
))
;

#include GP_PODRPAFilter.vpp
