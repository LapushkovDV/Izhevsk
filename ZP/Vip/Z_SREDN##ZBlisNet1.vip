cmValue30:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Смена статуса', 1);
  if (getfirst formarks where ((marksType == FORMARKS.CHOICE)) <> tsOk)
  {
    message('Нет помеченных записей');
  }
  else
  {
      PushPos(#FORMARKS);
      _loop formarks novisual where ((marksType == FORMARKS.CHOICE))
      {
        if (getfirst BLISNET where ((FORMARKS.CPODR == BLISNET.NREC)) = tsOk)
        {
          if (BLISNET.ELECTRONSICKLIST = 1)
          {
            BLISNET.ELECTRONSICKLIST:=6;
            update current BLISNET;
          }
        }
      }
      PopPos(#FORMARKS);
      RereadRecord(tnBlisnet);
      message('Статусы успешно поменяны');
  }
  StopVisual('', 0);
}
end;

end.
