OverloadFormats brBlisNet_all;

var MenuID:longint = 0;
var _sMenu:string='Z_Sredn::BlisnetBrowse_HotKeys';

Create view
  ZBlisNet
as select
  if(LSCHET.SUMMA27 = 0, 'нет', 'да') (fieldname = Summa27Str) //есть ли удержание в банк
from
  KatPodr GP_KatPodr
where((
  BLisNet.Cex == GP_KatPodr.Nrec
));


procedure LoadHotMenu;
{
    if country = ccBel
  {
    if typeRun <> 1   // вызов не из кадров
    {
      if UP_TekBud = cpFuture
        PutHotCommand(RunMenu('BlisnetBrowse_HotKeysb'))
      else
        PutHotCommand(RunMenu('BlisnetBrowse_HotKeys_Belarus'));
    }
  }
  else
  {
    if (typeRun <> 1)   // вызов не из кадров
    {
      if UP_TekBud = cpFuture
        PutHotCommand(RunMenu('BlisnetBrowse_HotKeysb'))
      else
      {
        //DeleteMenuHowDynamics(_sMenu);
        MenuID:=LoadMenuEx(_sMenu,false,true);
        if (not AddMenuItem(MenuID,'Сменить статус по помеченным',cmValue30))
          message('Ошибка добавления пункта меню');
        PutHotCommand(RunLoadMenu(MenuID));
      }
    }
    else // вызов из кадров
    {
      if  ( country = ccRus ) //РФ
        PutHotCommand(RunMenu('Blisnet_HotKeysK'));
    }
  }
}

//взято из BLisNet1
function fsGetPAYMENTSTATUS() : string;
{
  Result := '';

  case BLANKBLN.PAYMENTSTATUS of
    0                     : Result := '   ';
    cnStatPay_received    : Result := 'Получены сведения о необходимости осуществления выплаты';
    cnStatPay_sent        : Result := 'Отправлен на оплату';
    cnStatPay_paid        : Result := 'Выплачен';
    cnStatPay_failed      : Result := 'Оплата не прошла';
    cnStatPay_notificsent : Result := 'Направлено извещение о предоставлении доп. данных';

  end;
}

