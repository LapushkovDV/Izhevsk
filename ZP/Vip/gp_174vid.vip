#component "Z_Zar"
#include ZarAlg.vih

VipInterface zarAlgorithm_GP_174vid  implements IZarAlgorithm licensed(free);

interface zarAlgorithm_GP_174vid;
var
    pShowLog: Boolean;
    pRejim: Word;
    pYear: Word;
    DayNach:integer;
    DayEnd:integer;
    //Kolvo:integer;
    KolCh:double;


create view
var
    pLschet:comp;
    wMes,wYear:word;
  as select Lschet.Nrec
    from Lschet
    where ((
      pLschet == Lschet.Nrec
    ))
;

  public function CalcSum(Parameter: string): double;
  {
    result := 0;
    KolCh:=0;
  	DayNach:=day(uch_datan);
	  DayEnd:=day(uch_datok);
    pLschet:=uch_lsch;
    wMes  :=month(uch_datan);
    wYear :=year(uch_datan);

	  if getfirst lschet=tsok // where ((uch_lsch==lschet.nrec))=tsok
	  {
      if (LoadWorkingTable(pLschet, wMes, wYear) = 0) //загружаем табель
      {
        KolCh:=WT_GetHoursBwDays(hkWorking, 0, 8, stPlanned, DayNach, DayEnd);
      }
      /*do
      {
			}
		  while DayNach<=DayEnd */

		  result:=KolCh;
	  }
	}	//public function CalcSum    


  function GetDescription: string;
  {
    result := 'Оплата доп. дней по ух. за детьми-инвалидами';
  }

end.
