//VII. Доработка табеля учета рабочего времени
//$[RedMine]\em_dev\GP_Staff.Res
#include MacroSch.vpp
#include Contexts.vih  // Контексты
#include Protector.vih
#include GP_SCUD_MISCONDuctEdit.Vih
#include Z_WT##WTSCUD_MisConduct.vih


#component "Z_WT"
//=======================================
Interface WTSCUD_MisConduct;
var
 iGP_SCUD_MISCONDuctEdit:GP_SCUD_MISCONDuctEdit;
create view

var
  pWorkingTable:comp;
  SelectedRange:longint;
  pChange : comp;
  boPeriod: boolean;
  pGP_SCUD_Pers:comp;
  IsReadOnly:boolean;
as select LsTab.nrec,GP_SCUD_MISCON_D.*
From
  LsTab
, GP_SCUD_MISCON_D

where
((
    pWorkingTable == LsTab.Nrec
and LsTab.tPerson == Gp_Scud_Pers.cPersons
//------------------------
and GP_SCUD_Pers.Nrec == GP_SCUD_MISCON_D.cGP_SCUD_PERS
and LsTab.YearN        == GP_SCUD_MISCON_D.YearN
and LsTab.MesN         == GP_SCUD_MISCON_D.MesN
));


  function IsEditable: boolean;
  {
    result := False;
  }
  procedure OnPositionChanged;
  {
    //SetHelpAndStatusContext(TotalsBrowse, #ActualHoursStr, GetEditableStatusLine, hcUseOwner)
    //UpdateHelpLine;
  }


  #doc
    Перерисовывает своё содержимое.
  #end
  procedure ReDraw;
  { //if

  }
  #doc
    Обновляет и перерисовывает своё содержимое.
  #end
  procedure ReRead;
  { //UpdateTable;
    ReReadRecord(#LsTab);
    ReReadRecord(#GP_SCUD_MISCON_D);
  }
  #doc
    Сохраняет внесенные изменения.
  #end
  function UpdateIfModified: boolean;
  { //UpdateTable;
    Result:=true;
  }

  //------------------------------------------------------------------------------
  public procedure LinkTo(WorkingTable: comp;_SelectedRange:longint; _Change:comp;_Dbeg:date;_DEnd:date );
  { //bDayOfMonth:=DayOfMonth;
    SelectedRange:=_SelectedRange;
    set pChange := _Change;
    if _SelectedRange=-1
    { boPeriod:=false;
    }
    else
    { boPeriod:=True;
    }
    pWorkingTable := WorkingTable;
    if Getfirst Lstab=tsok
    { if getfirst GP_SCUD_PERS=tsok
       set pGP_SCUD_Pers:=GP_SCUD_PERS.Nrec
      else
       set pGP_SCUD_Pers:=-1;
    }
    else
    { set pGP_SCUD_Pers:=-1;
    }
    if timelog_Status>0
     Timelog('WTSCUD_MisConduct->LinkTo:pGP_SCUD_Pers='+string(pGP_SCUD_Pers,0,0)
      +',_DBeg='+DatetoStr(_Dbeg,'DD/MM/YYYY - ')+', _Dend='+DatetoStr(_DEnd,'DD/MM/YYYY'));
    if timelog_Status>0
     Timelog('WTSCUD_MisConduct->LinkTo:Final');
  }

  //------------------------------------------------------------------------------
// реализации методов IProtectable
//------------------------------------------------------------------------------
  public procedure SetProtected(Value: boolean);
  {
    IsReadOnly := Value;

    OnPositionChanged;
  }

  public function GetProtected: boolean;
  {
    result := IsReadOnly;
  }

//------------------------------------------------------
Browse brMisConDuct 'СКУД. Нарушения' (,,sci1Esc);
Table GP_SCUD_MISCON_D;
fields
  GP_SCUD_MISCON_D.DT_Ev 'Дата'  (,,sci1Esc) :[11],Protect;
  GP_SCUD_MISCON_D.TM_Ev 'Время' ('Пустое - контроль по общей продолжительности за день',,sci1Esc) :[6],Protect;
  GP_SCUD_MISCON_D.tDiff 'нарушено на' (,,sci1Esc) :[8],Protect;
  iGP_SCUD_MISCONDuctEdit.GetMisConDuctTypeName(GP_SCUD_MISCON_D.wMisConDuct) 'Тип' (,,sci1Esc):[20],Protect,NoDel;
end;

TableEvent Table GP_SCUD_MISCON_D;
cmSetDefault: Exit;
cmInsertRecord : Exit;
cmDeleteRecord: exit;
cmUpdateRecord:Exit;
end;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
HandleEvent
cmOnVipLoad:
{ Timelog_Init;
}
cmOnVipUnLoad:
{
}
end;
end.
