/*************************************************************************************************\
* Наименование:  Расхождения по распределению в разрезе сотрудников/видов оплат                   *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3047          |10/07/18|Ермолов К.Р.             |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih

interface gp_sravnach 'Параметры отчета' gray
Show at (,,33,7);

table struct t_klvidopl
(
tabnum: string,
vidopl: longint
)
with index
(
i1 = vidopl
)
;

table struct t_nachislzakaz
(
tabnum: string,
fio: string,
vidopl: longint,
sum: decimal(31,15)
)
with index
(
i1 = tabnum + vidopl (unique)
)
;

table struct t_sumvidop
(
tabnum: string,
fio: string,
vidopl: longint,
sum: decimal(31,15)
)
with index
(
i1 = tabnum + vidopl (unique)
)
;

table struct t_nachisl
(
tabnum: string,
fio: string,
vidopl: longint,
sum: decimal(31,15)
)
with index
(
i1 = tabnum + vidopl (unique)
)
;
table struct t_nenach
(
tabnum: string,
fio: string,
vidopl: longint,
sum: decimal(31,15)
)
with index
(
i1 = tabnum + vidopl (unique)
)
;

create view

var
excelpath, pstrtabn: string;
counter, countermatrix, pvidopl: longint;
sum, sumnz: double;
mes, rashod: word;
god: integer;

select t_nachislzakaz.tabnum from t_klvidopl, t_nachislzakaz, t_sumvidop, t_nachisl, t_nenach, lschet, persons
where ((lschet.tperson == persons.nrec));

screen scr ('Параметры отчета',,sci13Esc);
  fields
  rashod : [list
           1 'По всем',
           2 'Расхождения '], protect;
  mes : [list
        1 'Январь',
        2 'Февраль',
        3 'Март',
        4 'Апрель',
        5 'Май',
        6 'Июнь',
        7 'Июль',
        8 'Август',
        9 'Сентябрь',
        10 'Октябрь',
        11 'Ноябрь',
        12 'Декабрь'], protect;
  god: noprotect, spinbutton [1, 1917, 2117];
  buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Вид отчета: .@@@@@@@@@@@@
    Месяц:      .@@@@@@@@@@
    Год:        .@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  mes:= month(cur_date);
  god:= year(cur_date);
  rashod:= 1;
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from t_nachislzakaz;
  delete all from t_sumvidop;
  delete all from t_nachisl;
  delete all from t_nenach;

  sql
  select lschet.strtabn, persons.fio, klvidopl.vidoplp, sum(nachislzakaz.summa)
  from lschet
  left join persons on persons.nrec = lschet.tperson
  left join nachislzakaz on nachislzakaz.clsch = lschet.nrec
  left join klvidopl on klvidopl.vidoplp = nachislzakaz.vidopl
  left join katpodr on katpodr.nrec = lschet.cex
  inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
  where klvidopl.vhv = '+' and nachislzakaz.yearn = :(god) and nachislzakaz.mesn = :(mes)
  and katpodr1.kod <> '999' and katpodr1.kod <> '446'
  group by lschet.strtabn, persons.fio, klvidopl.vidoplp
  into t_nachislzakaz
  ;

  sql
  select lschet.strtabn, persons.fio, klvidopl.vidoplp, sum(sumvidop.summa)
  from lschet
  left join persons on persons.nrec = lschet.tperson
  left join sumvidop on sumvidop.clsch = lschet.nrec
  left join klvidopl on klvidopl.vidoplp = sumvidop.vidoplp
  left join katpodr on katpodr.nrec = lschet.cex
  inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
  where klvidopl.vhv = '+' and sumvidop.yearn = :(god) and sumvidop.mesn = :(mes)
  and katpodr1.kod <> '999' and katpodr1.kod <> '446'
  group by lschet.strtabn, persons.fio, klvidopl.vidoplp
  into t_sumvidop
  ;

  sql
  select lschet.strtabn, persons.fio, klvidopl.vidoplp, sum(nachisl.summa)
  from lschet
  left join persons on persons.nrec = lschet.tperson
  left join nachisl on nachisl.clsch = lschet.nrec
  left join klvidopl on klvidopl.vidoplp = nachisl.vidopl
  left join katpodr on katpodr.nrec = lschet.cex
  inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
  where klvidopl.vhv = '+' and nachisl.yearn = :(god) and nachisl.mesn = :(mes)
  and katpodr1.kod <> '999' and katpodr1.kod <> '446'
  group by lschet.strtabn, persons.fio, klvidopl.vidoplp
  into t_nachisl
  ;

  sql
  select lschet.strtabn, persons.fio, klvidopl.vidoplp, sum(nenach.summa)
  from lschet
  left join persons on persons.nrec = lschet.tperson
  left join nenach on nenach.clsch = lschet.nrec
  left join klvidopl on klvidopl.vidoplp = nenach.vidopl
  left join katpodr on katpodr.nrec = lschet.cex
  inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
  where klvidopl.vhv = '+' and nenach.yearn = :(god) and nenach.mesn = :(mes)
  and katpodr1.kod <> '999' and katpodr1.kod <> '446'
  group by lschet.strtabn, persons.fio, klvidopl.vidoplp
  into t_nenach
  ;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_sravnach.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  xlsetcellstringvalue('РАСХОЖДЕНИЯ ПО РАСПРЕДЕЛЕНИЮ В РАЗРЕЗЕ СОТРУДНИКОВ/ВИДОВ ОПЛАТ ЗА ' + mes + ' МЕСЯЦ ' + god + ' ГОДА', 1, 1, 1, 1);

  xlCreateMatrix(500, 6);

  countermatrix:= 0;
  counter:= 3;

  _loop lschet
  {
    pstrtabn:= lschet.strtabn;

    delete all from t_klvidopl;

    sql
    select lschet.strtabn, klvidopl.vidoplp
    from lschet
    left join persons on persons.nrec = lschet.tperson
    left join nachislzakaz on nachislzakaz.clsch = lschet.nrec
    left join klvidopl on klvidopl.vidoplp = nachislzakaz.vidopl
    left join katpodr on katpodr.nrec = lschet.cex
    inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
    where klvidopl.vhv = '+' and nachislzakaz.yearn = :(god) and nachislzakaz.mesn = :(mes) and lschet.strtabn = :(pstrtabn)
    and katpodr1.kod <> '999' and katpodr1.kod <> '446'
    group by lschet.strtabn, klvidopl.vidoplp
    into t_klvidopl
    ;

    sql
    select lschet.strtabn, klvidopl.vidoplp
    from lschet
    left join persons on persons.nrec = lschet.tperson
    left join sumvidop on sumvidop.clsch = lschet.nrec
    left join klvidopl on klvidopl.vidoplp = sumvidop.vidoplp
    left join katpodr on katpodr.nrec = lschet.cex
    inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
    where klvidopl.vhv = '+' and sumvidop.yearn = :(god) and sumvidop.mesn = :(mes) and lschet.strtabn = :(pstrtabn)
    and katpodr1.kod <> '999' and katpodr1.kod <> '446'
    group by lschet.strtabn, klvidopl.vidoplp
    into t_klvidopl
    ;

    sql
    select lschet.strtabn, klvidopl.vidoplp
    from lschet
    left join persons on persons.nrec = lschet.tperson
    left join nachisl on nachisl.clsch = lschet.nrec
    left join klvidopl on klvidopl.vidoplp = nachisl.vidopl
    left join katpodr on katpodr.nrec = lschet.cex
    inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
    where klvidopl.vhv = '+' and nachisl.yearn = :(god) and nachisl.mesn = :(mes) and lschet.strtabn = :(pstrtabn)
    and katpodr1.kod <> '999' and katpodr1.kod <> '446'
    group by lschet.strtabn, klvidopl.vidoplp
    into t_klvidopl
    ;

    sql
    select lschet.strtabn, klvidopl.vidoplp
    from lschet
    left join persons on persons.nrec = lschet.tperson
    left join nenach on nenach.clsch = lschet.nrec
    left join klvidopl on klvidopl.vidoplp = nenach.vidopl
    left join katpodr on katpodr.nrec = lschet.cex
    inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
    where klvidopl.vhv = '+' and nenach.yearn = :(god) and nenach.mesn = :(mes) and lschet.strtabn = :(pstrtabn)
    and katpodr1.kod <> '999' and katpodr1.kod <> '446'
    group by lschet.strtabn, klvidopl.vidoplp
    into t_klvidopl
    ;

    pvidopl:= 0;

    _loop t_klvidopl where ((lschet.strtabn == t_klvidopl.tabnum(noindex)))
    {
      if t_klvidopl.vidopl = pvidopl
      {
        delete current t_klvidopl;
      }
      else
      {
        pvidopl:= t_klvidopl.vidopl;
        sum:= 0;
        sumnz:= 0;

        _loop t_nachislzakaz where ((t_klvidopl.tabnum == t_nachislzakaz.tabnum and t_klvidopl.vidopl == t_nachislzakaz.vidopl))
        {
          sumnz:= t_nachislzakaz.sum;
        }

        _loop t_sumvidop where ((t_klvidopl.tabnum == t_sumvidop.tabnum and t_klvidopl.vidopl == t_sumvidop.vidopl))
        {
          sum:= sum + t_sumvidop.sum;
        }

        _loop t_nachisl where ((t_klvidopl.tabnum == t_nachisl.tabnum and t_klvidopl.vidopl == t_nachisl.vidopl))
        {
          sum:= sum + t_nachisl.sum;
        }

        _loop t_nenach where ((t_klvidopl.tabnum == t_nenach.tabnum and t_klvidopl.vidopl == t_nenach.vidopl))
        {
          sum:= sum + t_nenach.sum;
        }

        if rashod = 1
        {
          countermatrix++;
          xlStWriteToMatrix(countermatrix, 1, pstrtabn);
          xlStWriteToMatrix(countermatrix, 2, persons.fio);
          xlDoWriteToMatrix(countermatrix, 3, lschet.kateg);
          xlDoWriteToMatrix(countermatrix, 4, t_klvidopl.vidopl);
          xlDoWriteToMatrix(countermatrix, 5, sum);
          xlDoWriteToMatrix(countermatrix, 6, sumnz);
        }

        if rashod = 2
        {
          if sum <> sumnz
          {
            countermatrix++;
            xlStWriteToMatrix(countermatrix, 1, pstrtabn);
            xlStWriteToMatrix(countermatrix, 2, persons.fio);
            xlDoWriteToMatrix(countermatrix, 3, lschet.kateg);
            xlDoWriteToMatrix(countermatrix, 4, t_klvidopl.vidopl);
            xlDoWriteToMatrix(countermatrix, 5, sum);
            xlDoWriteToMatrix(countermatrix, 6, sumnz);
          }
        }

        if countermatrix = 500
        {
          xlWriteMatrixToExcel(counter, 1);
          counter:= counter + countermatrix;
          xlClearMatrix;
          countermatrix:= 0;
        }
      }
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  xlFreeMatrix;

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 1, 1, counter - 1, 6);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_sravnach Implements IUserReport;
Interface UserReport_sravnach;

Procedure Run;
Begin
  runinterface(gp_sravnach);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Расхождения по распределению в разрезе сотрудников/видов оплат';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Сверка результатов распределения';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
