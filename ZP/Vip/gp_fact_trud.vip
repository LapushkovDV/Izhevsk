\*************************************************************************************************/
#include UserReport.vih
#include Query.vih

interface gp_fact_trud 'Параметры отчета' gray
Show at (,,49,8);

Table Struct tRep
(
    kPodr    : string
  , nPodr    : string
  , cPodr    : comp
  , kCex     : string
  , nCex     : string
  , cCex     : comp
  , strtabn  : string
  , fio      : string
  , cPers    : comp
  , Razr     : word
  , Post     : string
  , zakaz    : string
  , chasf    : double
)
With Index
(
    i01 = cPodr+cCex+cPers
);

Table Struct tPodr
(
    kPodr : string
  , nPodr : string
  , cPodr : comp
  , chasf : double
)
With Index
(
    i01 = cPodr
);

Table Struct tCex
(
    kPodr : string
  , nPodr : string
  , cPodr : comp
  , kCex : string
  , nCex : string
  , cCex : comp
  , chasf : double
)
With Index
(
    i01 = cPodr+cCex
    ,i02 = cPodr
);
Table Struct tPers
(
    kPodr : string
  , nPodr : string
  , cPodr : comp
  , kCex : string
  , nCex : string
  , cCex : comp
  , strtabn : string
  , fio : string
  , cPers : comp
  , chasf : double
)
With Index
(
    i01 = cPodr+cCex+cPers
    ,i02 = cPodr+cCex
);

var
   ZakFilt : string;
   cZak     : comp;
   dBeg    : date;
   dEnd    : date;
   sBeg    : string;
   sEnd    : string;

create view
as select
   *
from
  tRep
, tPodr
, tCex
, tPers
, mnplan
;

Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  //MyLog('sql: ' + add_query_str);
}

Function FilltRep() : longint;
{
  result := 0;
  var qStr : longInt;
  sqlFreeStr(qStr);
  qStr := 0;
  StartNewVisual(vtRotateVisual, vfTimer, 'Cбор информации для отчета'  + ''#13 +
                                          'Период : ' + DateToStr(dBeg,'DD/MM/YYYY') + ' - ' + DateToStr(dEnd,'DD/MM/YYYY') + ';'#13, 0);

       MysqlAddStr(qStr, ' select                                                          ');
       MysqlAddStr(qStr, ' kd1.kod            as    kPodr                                  ');
       MysqlAddStr(qStr, ' ,kd1.name          as    nPodr                                  ');
       MysqlAddStr(qStr, ' ,kd1.nrec          as    cPodr                                  ');
       MysqlAddStr(qStr, ' ,kd.kod            as    kCex                                   ');
       MysqlAddStr(qStr, ' ,kd.name           as    nCex                                   ');
       MysqlAddStr(qStr, ' ,kd.nrec           as    cCex                                   ');
       MysqlAddStr(qStr, ' ,pers.strtabn      as    strtabn                                ');
       MysqlAddStr(qStr, ' ,pers.fio          as    fio                                    ');
       MysqlAddStr(qStr, ' ,pers.nrec         as    cPers                                  ');
       MysqlAddStr(qStr, ' ,gpnar.persrazr    as    Razr                                   ');
       MysqlAddStr(qStr, ' ,post.name         as    Post                                   ');
       MysqlAddStr(qStr, ' ,mn.number         as    zakaz                                  ');
       MysqlAddStr(qStr, ' ,sum(nar.chasf)  as    chasf                                  ');
       MysqlAddStr(qStr, ' from prnaryad nar                                               ');
       MysqlAddStr(qStr, ' left join sys_nar sn on sn.nrec=nar.mnrec                       ');
       MysqlAddStr(qStr, ' left join GP_PRNARYAD_EXT gpnar on nar.nrec=gpnar.CPRNARYAD     ');
       MysqlAddStr(qStr, ' left join persons pers on pers.nrec=nar.tperson                 ');
       MysqlAddStr(qStr, ' left join katpodr kd on kd.nrec=nar.cexoz                       ');
       MysqlAddStr(qStr, ' left join katpodr kd1 on kd1.kod=substring(kd.kod,1,3)          ');
       MysqlAddStr(qStr, ' left join mnplan mn on mn.nrec = nar.ckaud[1]                   ');
       MysqlAddStr(qStr, ' left join catalogs post on post.nrec=nar.cpodr                  ');
       MysqlAddStr(qStr, ' where                                                           ');
       MysqlAddStr(qStr, ' nar.datan>=#date('+sBeg+')                                      ');
       MysqlAddStr(qStr, ' and nar.datan<=#date('+sEnd+')                                  ');
       MysqlAddStr(qStr, ' and sn.choice not in (901,902,904,905,906)                      ');
       if ZakFilt<>''
       {
         MysqlAddStr(qStr, ' and mn.nrec not in (select crec from tmpZakFlt)                ');
       }
       MysqlAddStr(qStr, ' group by                                                        ');
       MysqlAddStr(qStr, ' kd1.kod                                                         ');
       MysqlAddStr(qStr, ' ,kd1.name                                                       ');
       MysqlAddStr(qStr, ' ,kd1.nrec                                                       ');
       MysqlAddStr(qStr, ' ,kd.kod                                                         ');
       MysqlAddStr(qStr, ' ,kd.name                                                        ');
       MysqlAddStr(qStr, ' ,kd.nrec                                                        ');
       MysqlAddStr(qStr, ' ,pers.strtabn                                                   ');
       MysqlAddStr(qStr, ' ,pers.fio                                                       ');
       MysqlAddStr(qStr, ' ,pers.nrec                                                      ');
       MysqlAddStr(qStr, ' ,gpnar.persrazr                                                 ');
       MysqlAddStr(qStr, ' ,post.name                                                      ');
       MysqlAddStr(qStr, ' ,mn.number                                                      ');
       MysqlAddStr(qStr, ' order by kd1.kod,kd.kod,pers.strtabn                            ');

  var objQuery :  iQuery;
      objQuery := queryManager.createQuery(qStr);

  if (objQuery.Execute.ErrorCode <> tsOk) then
  {
    Message('Ошибка выполнения запроса GetHrs ' + objQuery.ErrorCode, Error);
  }
  else
  {
    sqlCopyInto(objQuery, tntRep, true);
    result := RecordsInTable(tntRep);
  }

  sqlFreeStr(qStr);
  SetVisualHeader('Готово!');
  StopVisual;

  result:=result;
}

Function FilltPodr() : longint;
{
  result := 0;
  var qStr : longInt;
  sqlFreeStr(qStr);
  qStr := 0;
  StartNewVisual(vtRotateVisual, vfTimer, 'Cбор итого по цеху', 0);

       MysqlAddStr(qStr, ' select                                                          ');
       MysqlAddStr(qStr, ' kd1.kod                                                         ');
       MysqlAddStr(qStr, ' ,kd1.name                                                       ');
       MysqlAddStr(qStr, ' ,kd1.nrec                                                       ');
       MysqlAddStr(qStr, ' ,sum(nar.chasf)                                                 ');
       MysqlAddStr(qStr, ' from prnaryad nar                                               ');
       MysqlAddStr(qStr, ' left join sys_nar sn on sn.nrec=nar.mnrec                       ');
       MysqlAddStr(qStr, ' left join katpodr kd on kd.nrec=nar.cexoz                       ');
       MysqlAddStr(qStr, ' left join katpodr kd1 on kd1.kod=substring(kd.kod,1,3)          ');
       MysqlAddStr(qStr, ' left join mnplan mn on mn.nrec = nar.ckaud[1]                   ');
       MysqlAddStr(qStr, ' where                                                           ');
       MysqlAddStr(qStr, ' nar.datan>=#date('+sBeg+')                                      ');
       MysqlAddStr(qStr, ' and nar.datan<=#date('+sEnd+')                                  ');
       MysqlAddStr(qStr, ' and sn.choice not in (901,902,904,905,906)                      ');
       if ZakFilt<>''
       {
         MysqlAddStr(qStr, ' and mn.nrec not in (select crec from tmpZakFlt)                ');
       }
       MysqlAddStr(qStr, ' group by                                                        ');
       MysqlAddStr(qStr, ' kd1.kod                                                         ');
       MysqlAddStr(qStr, ' ,kd1.name                                                       ');
       MysqlAddStr(qStr, ' ,kd1.nrec                                                       ');
       MysqlAddStr(qStr, ' order by kd1.kod                                                ');

  var objQuery :  iQuery;
      objQuery := queryManager.createQuery(qStr);

  if (objQuery.Execute.ErrorCode <> tsOk) then
  {
    Message('Ошибка выполнения запроса FilltPodr ' + objQuery.ErrorCode, Error);
  }
  else
  {
    sqlCopyInto(objQuery, tntPodr, false);
    result := RecordsInTable(tntPodr);
  }

  sqlFreeStr(qStr);
  SetVisualHeader('Готово!');
  StopVisual;

  result:=result;
}

