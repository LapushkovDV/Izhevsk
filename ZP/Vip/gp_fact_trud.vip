Procedure FillRep();
{
  delete all tRep;
  delete all tPodr;
  delete all tCex;
  delete all tPers;

  FilltRep;
  FilltPodr;
  FilltCex;
  FilltPers;
}


Procedure DelPick();
{
  var objQuery: iQuery;
  var strID   : LongInt;

  sqlFreeStr(strID);
  strID := 0;

  StartNewVisual(vtRotateVisual, vfTimer, 'Очистка фильтра', 0);

  MysqlAddStr(strID, ' delete from tmpZakFlt');

  objQuery := queryManager.createQuery(strID);
  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('Ошибка очистки tmpZakFlt (DelPick) ' + objQuery.errorCode,error);
    StopVisual;
    Exit;
  }
  StopVisual;
}

Procedure InsPick(_c : comp);
{
  var objQuery: iQuery;
  var strID   : LongInt;

  sqlFreeStr(strID);
  strID := 0;

  MysqlAddStr(strID, ' insert tmpZakFlt (cRec)                                              ');
  MysqlAddStr(strID, ' select #comp(' + string(_c) + ')                                      ');
  MysqlAddStr(strID, ' where #comp(' + string(_c) + ') not in (select cRec from tmpZakFlt)  ');

  objQuery := queryManager.createQuery(strID);
  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('Ошибка заполнения tmpFlt (InsPick) ' + objQuery.errorCode,error);
    Exit;
  }
  sqlFreeStr(strID);
}

Procedure CreateTmpFlt();
{
  var objQuery: iQuery;
  var strID   : LongInt;

  strID := 0;
  sqlFreeStr(strID);

  StartNewVisual(vtRotateVisual, vfTimer, 'Создание временной таблицы для фильтров', 0);

  MysqlAddStr(strID, ' table tmpZakFlt        ');
  MysqlAddStr(strID, ' (                      ');
  MysqlAddStr(strID, '     cRec : comp        ');
  MysqlAddStr(strID, ' )                      ');
  MysqlAddStr(strID, ' with index             ');
  MysqlAddStr(strID, ' (                      ');
  MysqlAddStr(strID, '     i01 = cRec         ');
  MysqlAddStr(strID, ' );                     ');

  sqlDropTmpTable('tmpFlt');

  if sqlCreateTmpTable(strID, ctmNormal) <> tsOk
  {
    Message('Ошибка создания временной таблицы (CreateTmpFlt)' + 'tmpFlt', error);
  }
  sqlFreeStr(strID);
  StopVisual;
}

Procedure PrintReport;
{
   if (not xlCreateExcel('RepFactTrud' + DateToStr(Cur_Date(), '_YYYYMMDD') + TimeToStr(Cur_Time(), '_HHMMSS') + '.xlsx', true)) then
  {
    message('Не удалось открыть сессию Exel', error); exit;
  }
  if not xlIsExcelValid {
    message('Не удалось подключиться к Exel'); exit;
  }

  var row: integer =0;
  var col: integer;
    xlSetCellStringValue('Отчет по фактическому выполнению технологической трудоемкости с '+sBeg+' по '+sEnd, 1, 1 ,1 ,1);
    xlSetCellStringValue('№ цеха', 2, 1 ,2 ,1);
    xlSetCellStringValue('Наименование цеха', 2, 2 ,2 ,2);
    xlSetCellStringValue('Наименование участка', 2, 3 ,2 ,3);
    xlSetCellStringValue('Табельный №', 2, 4 ,2 ,4);
    xlSetCellStringValue('ФИО', 2, 5 ,2 ,5);
    xlSetCellStringValue('Наименование профессии (должность)', 2, 6 ,2 ,6);
    xlSetCellStringValue('Разряд', 2, 7 ,2 ,7);
    xlSetCellStringValue('Номер заказа', 2, 8 ,2 ,8);
    xlSetCellStringValue('Трудоемкость, н/ч', 2, 9 ,2 ,9);
    xlSetFontStyle(1,1,1,1,9);
    xlSetBackColor(0D9D9D9h,2,1,2,9);
    xlWrapText(2,1,2,9);
    var count: integer = 0;
    row:= 0;
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+ vfConfirm, 'Обработка выборки', recordsintable(tntPodr)+recordsintable(tntCex)+recordsintable(tntPers)+recordsintable(tntRep));
    SetVisualHeader('Заполнение печатной формы');
    xlCreateMatrix(recordsintable(tntPodr)+recordsintable(tntCex)+recordsintable(tntPers)+recordsintable(tntRep), 9);
    _loop tPodr
    {
      _loop tCex where ((tPodr.cPodr==tcex.cPodr))
      {
        _loop tPers where ((tcex.cPodr==tpers.cpodr and tcex.ccex==tpers.ccex))
        {
          _loop tRep where ((tpers.cPodr==trep.cpodr and tpers.cCex==trep.cCex and tpers.cpers==trep.cpers))
          {
            col := 0;
            count++;
            row++;
            xlStWriteToMatrix(  row, ++col, trep.kPodr);
            xlStWriteToMatrix(  row, ++col, trep.npodr);
            xlStWriteToMatrix(  row, ++col, trep.ncex );
            xlStWriteToMatrix(  row, ++col,chr(39) +  trep.strtabn );
            xlStWriteToMatrix(  row, ++col, trep.fio );
            xlStWriteToMatrix(  row, ++col, trep.post );
            xlStWriteToMatrix(  row, ++col,trep.razr );
            xlStWriteToMatrix(  row, ++col,chr(39) +  trep.zakaz );
            xlDoWriteToMatrix(  row, ++col, trep.chasf );
          }
          count++;
          row++;
          xlstWriteToMatrix(  row, 4,'Итого по сотруднику '+tPers.strtabn);
          xlDoWriteToMatrix(  row, 5, tpers.chasf);
           xlSetFontStyle(1,row+2,1,row+2,9);
        xlSetBackColor(0D9D9D9h,row+2,1,row+2,9);
        XlSetNumberFormat('#  ### ### ### ### ##0,00;[Красный]-#  ### ### ### ### ##0,00',row+2,5,row+2,5);

        }
        count++;
        row++;
        xlstWriteToMatrix(  row, 4,'Итого по участку '+tCex.kcex);
        xldoWriteToMatrix(  row, 5, tCex.chasf);
        xlSetFontStyle(1,row+2,1,row+2,9);
        xlSetBackColor(0D9D9D9h,row+2,1,row+2,9);
        XlSetNumberFormat('#  ### ### ### ### ##0,00;[Красный]-#  ### ### ### ### ##0,00',row+2,5,row+2,5);

      }
      count++;
      row++;
      xlstWriteToMatrix(  row, 4,chr(39) + 'Итого по цеху '+tPodr.kpodr);
      xldoWriteToMatrix(  row, 5, tPodr.chasf);
       xlSetFontStyle(1,row+2,1,row+2,9);
        xlSetBackColor(0D9D9D9h,row+2,1,row+2,9);
        XlSetNumberFormat('#  ### ### ### ### ##0,00;[Красный]-#  ### ### ### ### ##0,00',row+2,5,row+2,5);
    }
    XLWRITEMATRIXTOEXCEL(3, 1);
    XLFREEMATRIX;
    xlAlignCells(xlLeft,1,1,row+2,9);
    xlSetColumnWidth(8,1,1,row,1);
    xlSetColumnWidth(37,1,2,row,2);
    xlSetColumnWidth(27,1,3,row,3);
    xlSetColumnWidth(27,1,4,row,4);
    xlSetColumnWidth(27,1,5,row,5);
    xlSetColumnWidth(44,1,6,row,6);
    xlSetColumnWidth(7,1,7,row,7);
    xlSetColumnWidth(12,1,8,row,8);
    xlSetColumnWidth(14,1,9,row,9);
    XlSetNumberFormat('#  ### ### ### ### ##0,00;[Красный]-#  ### ### ### ### ##0,00',3,9,row+2,9);

  StopVisual;
  xlMergeCells(1,1,1,9);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0,1,1,row+2, 9);
  //xlAutoFit(1,1, row,9);
  xlKillExcel;

}

screen scr ('Параметры отчета',,sci13EscPM);
  fields

  ZakFilt: Protect,PickButton;
  dBeg: noprotect;
  dEnd: noprotect;
  buttons
    cmGo, ,, 'Сформировать' ,,;
    cmCancel, ,, 'Отмена' ,,;
    <<

 Исключить заказы:.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Период         с .@@@@@@@@@@@@ по .@@@@@@@@@@@@



    <.Сформировать.>         <. Отмена .>

    >>
end;

handleevent
cmInit:
{
  dBeg:=date(1,1,year(cur_date));
   //dEnd:=date(10,1,year(cur_date));
  dEnd:=date(last_day(cur_date),month(cur_date),year(cur_date));
  CreateTmpFlt();
}
cmPick:
{
  var _i : longint;
  case curfield of
   #ZakFilt:
    {
      DelPick();
      var _tmpMarkerName : string;
      var stMarker       : longint;

      if (iGetKau.GetCodeKau(cgiMulti, cgKau_Zakaz, cZak) <> 0) then
      {
        _tmpMarkerName := iGetKau.GetMarkerName(cgKau_Zakaz);
        stMarker       := InitMarker(_tmpMarkerName, 8, 10, 100, true);
        _i             := 0;
        while getmarker(stMarker, _i, cZak)
        {
          InsPick(cZak);
          _i++;
        }
        DoneMarker(stMarker, _tmpMarkerName);
      }
      if (getFirst MnPlan where ((cZak == MnPlan.nRec)) = tsOk) then
      {
        set ZakFilt := MnPlan.Number + if((_i-1) > 0, ' и еще ' + string(_i - 1), '');
      }
    }
 end;
 ReReadRecord;
}

cmDelOnProtect:
{
  case CurField of
    #ZakFilt:
    {
      set ZakFilt := '';
      set cZak := 0h;
      DelPick();
    }
  end;
  ReReadRecord;
}

cmGo:
{
  sbeg:=DateToStr(dBeg, 'DD,MM,YYYY');
  sEnd:=DateToStr(dEnd, 'DD,MM,YYYY');
  FillRep();
  PrintReport;
}

end;

end.

VipInterface UserReport_gp_fact_trud Implements IUserReport;
Interface UserReport_gp_fact_trud;

Procedure Run;
Begin
  runinterface(gp_fact_trud);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Фактическое выполнение технологической трудоемкости';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Наряды';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
