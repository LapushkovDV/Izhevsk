/*
 Штатная форма настройки печати "Реест документов (по текущему фильтру)"
 При вызове из собственных платёжных поручений Не содержит поле подписанты.
 Инициализация объекта iFeeSIgners происходит
 (1) iFeeSIgners.InitFeeSignersByTipDoc(TiDkGal)
    iFeeSIgners не работает с таким значением TiDkGal и не инициализируется

 Добавлен фрагмент из SeePlats.vip
 подписанты по контекстному меню "Реест документов (полный)"
 в SeePlats.vip Инициализация iFeeSIgners происходит
 (2) iFeeSigners.InitFeeSignersExt(cgReport_KassFro, true, false);
 если после (1) iFeeSigners.FeeSignersIsValid=False, то использую (2)

 Примечание:
 InitFeeSignersByTipDoc(TiDkGal) в итоге, вызывает InitFeeSignersExt(cgReport_KASSFRO, true, false)
*/
#component "F_PlPorRep"

Alter Interface PlParPrn;
ExtendTabbedSheets winPlPor;
ExtendFormats scUserTuneReestr;


Window winPlPor 'Настройка печати документа' EscClose, Gray;
  Show at (, 2, 52, 25);
Panel panUserTune;
  ViewTable;
TabbedSheet tshPlPor;
  Show at (, , , 19);

Screen scUserTuneReestr 'Реестр' ('Параметры подготовки документа к печати', hcBankPechPlatDoc, sci1EnEsc);
Fields
  ReeParamFR  ('Формат отчета при печати'): NoProtect;
  ParamDopOpt ('Печать всех/помеченных документов',, sci13EnEsc):
              [List 0 'документы в рамках ограничений', 1 'помеченные документы'], Protect;
  ParamSort   ('Сортировка документов при печати',, sci13EnEsc):
              [List 0 'текущая сортировка', 1 'очередность пометки'], Protect;
  sFeeSigners('Подписанты',, sci13Esc) : PickButton, Protect;    //  Добавлено поле "Подписанты"
  ParamViewR ('Не отображать окно настройки при печати'): NoProtect;
<<

 `Отчет в формате`
  (.) Бизнес-Текст      `
  (.) FastReport        `

 `Печать`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Сортировка`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@



 `Подписанты`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@


  [.] Не отображать окно настройки при печати`
>>
end; // Screen scUserTuneReestr;
End; // Panel panUserTune;
End; // TabedSheet
HandleEvent // winPlPor
cmINIT:
{
  if inherited::handleevent(cmInit) = heAbort
    Abort;

  if not iFeeSigners.FeeSignersIsValid
  if iFeeSigners.InitFeeSignersExt(cgReport_KassFro, true, false) // взял из SeePlats.vip
  {
    Set sFeeSigners := iFeeSigners.GetFeeSignersName;
    SetFieldAndLabelVisible(#sFeeSigners, true);
  }
}
end;   // HandleEvent winPlPor

end;   // winPlPor
end.


#doc
Расширение выгрузки PlPor в отчеты на FastReport
      [ORGPLATOKTMO] - ОКТМО Плательщика
      [ORGPOLOKTMO]  - ОКТМО Получателя
Два первых подписанта Должность, ФИО , бдут выведены как:
        fsMainBuhPos // Подписант1_Должность
        fsMainBuhFio // Подписант1_ФИО
        fsBossPos    // Подписант2_Должность
        fsBossFio    // Подписант2_ФИО

#end

Alter interface FRReePD;
OverLoad
datastream iFRReePD.dtsReestr;
Procedure LoadFeeSigners;
end;

Var
  cUserPERS : comp;
  sUserPERSPost,   sUserPERS: string;

create view
From PLPOR PLPOROKTMO
where
((
    PDoc.nRec == PLPOROKTMO.nRec
))
;
Procedure LoadFeeSigners;
{
  inherited::LoadFeeSigners;

  if not iFeeSigners.FeeSignersIsValid
  if iFeeSigners.InitFeeSignersExt(cgReport_KassFro, true, false) // взял из SeePlats.vip
  if (iFeeSigners.GetSignerFirst)
  {
    fsMainBuhPos :=iFeeSigners.GetSignerPosition(1); // Подписант1_Должность
    fsMainBuhFio :=iFeeSigners.GetSignerFIO(1);      // Подписант1_ФИО
    if (iFeeSigners.GetSignerNext)
    {
      fsBossPos :=iFeeSigners.GetSignerPosition(1); // Подписант2_Должность
      fsBossFio :=iFeeSigners.GetSignerFIO(1);      // Подписант2_ФИО
    }
  }
}
Procedure Init_User;
{ 
 // cUserPERS := coGetTune('User.Pers');
 //  sUserPERS := sGetTune('User.Pers');  User.Pers - нет такой настройки
  sUserPERS := sGetTune('User.FIO');
  sUserPERSPost := '';
  if sUserPERS = '' sUserPERS := 'Установите настройку Настройки Галактики\Общие настройки системы>Фамилия Имя Отчество';
}

//-----------------------
// Получить ОКТМО Организации
//-----------------------
Function GetORGOKTMO( pCORG:comp) :string;
{ 
  var Res: string = '' ;

  _Try // Чтоб подавить сообщение "Ничего не найдено"
  { sql
       select
       ATTRVAL.VSTRING
       from KATORG KATORGOKTMO
       inner join PODRINFO on KATORGOKTMO.nRec = PODRINFO.CPODR
       inner join attrnam on 1512 = attrnam.WTABLE and attrnam.name = 'Код ОКТМО'
       inner join attrval on attrnam.nRec = ATTRVAL.CATTRNAM and PODRINFO.nRec = ATTRVAL.CREC
       where
       KATORGOKTMO.nRec = (:pCORG)
       into (Res)
       ;

  }
  _Except
  else
  {
  }
  _Finally
  {
  }

  Result := Res;

}


datastream  iFRReePD.dtsReestr //{
  (
    [TUNEMAINBUH] sGetTune('MAINBUH');
    [EXEC_USERNAME] sUserPERS;
    [EXEC_USERPOST] sUserPERSPost;

    table Inherited::PDoc
    (
      [ORGPLATOKTMO] GetORGOKTMO(PLPOROKTMO.CPLAT);
      [ORGPOLOKTMO]  GetORGOKTMO(PLPOROKTMO.CPOL);

    );
  )
end; // datastream iFRReePD.dtsReestr }


HandleEvent
cmOnVipLoad:
{ Init_User;
  if  Inherited::HandleEvent(cmOnVipLoad)=heAbort Abort;
}
end; // HandleEvent
end.
