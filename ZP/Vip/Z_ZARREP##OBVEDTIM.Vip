//-------------------------------------
// Печать
//-------------------------------------
procedure printFR;
{ CalcItogFond_VA;

  if rep_em=0
  {
    Inherited::printFR;
  }
  else
  {
    Runfreport(DTSOBV, '_ЭМ Полная форма общей ведомости', false);
  }
  rep_em:=0;
}//procedure printFR;

//-------------------------------------
// Получить наименование подразделения фильтрации с кодом
//-------------------------------------
Function GetFiltrPodrGP:string;
{ Result:=FiltrPodr;
  // маркер с помеченными подразделениями, по которым формируется отчет
  _PodrMArkerFind := CLSF.LoadFullCurrentDepartmentList;
  vSpr.sPodr:=FiltrPodr;
  if vSpr.Getfirst Katpodr=tsok
   GetFiltrPodrGP:=vSpr.Katpodr.kod+' '+Result;
  DoneMArker(_PodrMArkerFind,'');
}//Function GetFiltrPodrGP:string;

//------------------------------------------------------------------------------
// процедура печати дочернего отчета по клику на сумме из полной ведомости в FastReport
procedure BuildChildFr(ExprFieldValue: string);
{ timelog('OBVEDTIM->BuildChildFr:ExprFieldValue'+ExprFieldValue );
  Inherited::BuildChildFr(ExprFieldValue);

}

//******************************************************************************
/////////////////////////// ОБРАБОТКА СОБЫТИЙ ИНТЕРФЕЙСА ///////////////////////
//******************************************************************************
datastream DTSOBV
( [Fond905] dmsu[01];
  [Fond906] dmsu[02];
  [Fond907] dmsu[03];
  [Fond908] dmsu[04];
  [Fond909] dmsu[05];
  [FILTRPODR_GP] GetFiltrPodrGP;
  table inherited::FrMasDataZnach1
  ( [Sort] GetSort(VA_KLVIDOPL_OVR,FrMasDataZnach1.TabNum,longInt(FrMasDataZnach1.tecopl),1);
    //GetSort - 20 знаков!
    [tecopl_s] GetSort(VA_KLVIDOPL_OVR,FrMasDataZnach1.TabNum,longInt(FrMasDataZnach1.tecopl),2)+String(longInt(FrMasDataZnach1.tecopl),4);
  );
  table FrItog50
  (
    [TabNum]   FrItog50.TabNum;
    [tecopl]   FrItog50.tecopl;
    [Name]     FrItog50.Name;
    [cKatPodr] FrItog50.cKatPodr;
    [Headname] FrItog50.HeadName;
    [Znach]    FrItog50.Znach;
  );

) //datastream DTSOBV
end;//DTSOBV

//******************************************************************************
/////////////////////////// ОБРАБОТКА СОБЫТИЙ ИНТЕРФЕЙСА ///////////////////////
//******************************************************************************
HandleEvent
//----------------------
cmInit:
{ timelog_init;
  timelog('OBVEDTIM->cmInit');
  VA_KLVIDOPL_OVR  :=ExtAttr_ID(coKlVidopl,'800 Группировка в ОВР');//группировка ОВР
  VA_KLVIDOPL_905  :=ExtAttr_ID(coKlVidopl,'905 Фонд заработной платы (ОВР)');//Фонд ЗП
  VA_KLVIDOPL_906  :=ExtAttr_ID(coKlVidopl,'906 Фонд НДФЛ (ОВР)');//Фонд НДФЛ
  VA_KLVIDOPL_907  :=ExtAttr_ID(coKlVidopl,'907 Фонд Страх. (ОВР)');//Фонд Страх.
  VA_KLVIDOPL_908  :=ExtAttr_ID(coKlVidopl,'908 Фонд Резерв (ОВР)');//Фонд Резерв
  VA_KLVIDOPL_909  :=ExtAttr_ID(coKlVidopl,'909 Фонд ЗП с отпусков будущих периодов (ОВР)');//Фонд ЗП с отпусков будущих периодов
  rep_em:=0;
  //------------------------------
  if  Inherited::HandleEvent(cmInit)=heAbort Abort;
  //------------------------------
} //cmInit:

CmValue1:
{  rep_em:=1;
   Inherited::HandleEvent(cmok);
}

CmHotKeys:  PutHotCommand(RunMenu('menudopem'));

end;
end.


menudopem menu
{
   - 'ОВР с фондами ЭМ',  CmValue1,'',,'',,sci1Esc;
}
