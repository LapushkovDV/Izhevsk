#component "Z_ZARREP"
#doc
Отчеты - Сводные Аналитические отчеты - Общая ведомость распределения
<p>#1994 отсортировать по доп.аналитика с аббревиатурой ОВР, добавить дополнительный раздел
#end
ALter Interface OBVEDTIM;
OverLoad
//Основной
datastream DTSOBV;
procedure printFR;
//Uder.VidUd->Uder.VidUdS
//  procedure LoadUder;  в новых exe уже Uder.VidUdS используется
//------------------------------------------------------------------------------
// процедура печати дочернего отчета по клику на сумме из полной ведомости в FastReport
procedure BuildChildFr(ExprFieldValue: string);

end; //OverLoad

var VA_KLVIDOPL_OVR  :comp;//группировка ОВР
var VA_KLVIDOPL_905  :comp;//Фонд ЗП
var VA_KLVIDOPL_906  :comp;//Фонд НДФЛ
var VA_KLVIDOPL_907  :comp;//Фонд Страх.
var VA_KLVIDOPL_908  :comp;//Фонд Резерв
var VA_KLVIDOPL_909  :comp;//Фонд ЗП с отпусков будущих периодов
var rep_em  :longint;//для печати отчета с разбивкой по фондам

var dmSu             :array [1..5] of Double;
// маркер с помеченными подразделениями, по которым формируется отчет
var  _PodrMArkerFind :longint;

//-------------------------------
Create view svod
from
  FrMasDataZnach FrItog50  // начисления - удержания
where ((
// для итогов по таблицам
   50 == FrItog50.TabNum   // начисления - удержания
));

//-------------------------------
Create view vSpr
var
  pVidoplP : word;
  sKau_Code: string;
  pSpkau   : Comp;
  sPodr:string;
as select KatKau.Name
From  KatKau, KlVidopl,SpKau , KatPodr
where
((   sKau_Code == KATKAU.CODE
and  pVidoplP  == KlVidopl.VidoplP
and  pSpKau    == SpKau.Nrec
and  sPodr     == KatPodr.Name
and (FoundMarker(_PodrMArkerFind,KatPodr.Nrec))
));


//====================================
// найти код аналитики по аббревиатуре
//====================================
Function GetKodGroupByAbbr(_sAbbr:string):longint;
{ Result:=0;
  vSpr.sKau_Code:=_sAbbr;
  if vSpr.getfirst katkau=tsok
    Result:=vSpr.KatKau.KodGroup;
} //Function GetKodGroupByAbbr(_sAbbr:string):longint;




//====================================
// получить ключ сортировки 20 символов.
//====================================
Function GetSort(_VA:comp;_TabNum:longint;_pVidoplP:word;_wTp:word):string;
var
  _name:string;
  ii:word;
{ Result:='';
  _name:='';
  case _TabNum of
  1,2,3,4://Начисления
  { if _VA=VA_KLVIDOPL_OVR
    { Result:='003';
      _Name:='Другие источники';
    }
    if _VA<>0
    { vSpr.pVidoplP:=_pVidoplP;
      if vSpr.Getfirst KlVidopl=tsok
      { vSpr.pSpkau:=coGetAttrID(coKlVidopl,vSpr.KlVidopl.Nrec,_VA);
        if vSpr.getfirst SpKau=tsok
        { Result:=vSpr.SpKau.Code;
          _Name :=vSpr.SpKau.Name;
        } //if vSpr.getfirst SpKau=tsok
      } //if vSpr.Getfirst KlVidopl=tsok
    } //if _VA<>0
  } //1,2://Начисления
  end;
  //отнормируем на 20 символов
  Result:=Norm_Fld(Result,20);
  if _wTp=1
  { Result:=Result+_Name;
  }
} //Function GetSort(_TabNum:longint;_pVidopl:word;_wTp:word;):string;




//====================================
// переместить в 1 раздел если заполнен ВА
//====================================
Procedure MoveTo1Razdel(_TabNum:integer);
{
  timelog('OBVEDTIM->MoveTo1Razdel:_TabNum='+string(_TabNum));
  _loop fullcache FrMasDataZnach where (( _TabNum == FrMasDataZnach.TabNum ))
  { timelog('OBVEDTIM->MoveTo1Razdel:FrMasDataZnach.tecopl='+string(FrMasDataZnach.tecopl));
    set vSpr.pVidoplP:=longInt(FrMasDataZnach.tecopl);
    if _TabNum<=10
    { if getfirst FrItog1 where (( _TabNum+10 == FrItog1.TabNum
            and FrMasDataZnach.HeadName == FrItog1.HeadName(noindex) ))=tsok
        update current FrItog1 set FrItog1.Znach :=FrItog1.Znach-FrMasDataZnach.Znach;
    }
    if vSpr.Getfirst KlVidopl=tsok
    { if coGetAttrID(coKlVidopl,vSpr.KlVidopl.Nrec,VA_KLVIDOPL_OVR)>0
      { timelog('OBVEDTIM- перебрасываем');
        update current FrMasDataZnach
          set FrMasDataZnach.TabNum:=1;
        if getfirst FrItog1 where (( 11 == FrItog1.TabNum
             and FrMasDataZnach.HeadName == FrItog1.HeadName(noindex) ))=tsok
          update current FrItog1 set FrItog1.Znach :=FrItog1.Znach+FrMasDataZnach.Znach;
      }
    }

  } //_loop fullcache FrMasDataZnach where (( 5 == FrMasDataZnach.TabNum ))

} //Procedure MoveTo1Razdel(_TabNum:longint);

//====================================
// найти итоги по аналитиками 905-909
//====================================
Function CalcItogFond_VA: boolean;
var ii:word;
    _VA:Comp;
{
  timelog('OBVEDTIM->CalcItogFond_VA');
  //тест
  //_loop fullcache FrMasDataZnach where (( 0 << FrMasDataZnach.TabNum ))
  //  timelog('OBVEDTIM-> tabnum='+string(FrMasDataZnach.TabNum)+','+FrMasDataZnach.tecopl);


  StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak + vfConfirm,'Подсчет итогов по фондам'
     ,RecordsInTable(#FrMasDataZnach));
  for(ii:=1;ii<=5;ii++)
  {  dmsu[ii]:=0;
  }
  //----------------------
  //просят перебросить в 1 раздел 189 код
  MoveTo1Razdel(15);//а я думал 5.
  //просят перебросить в 1 раздел 190 код
  MoveTo1Razdel(2);
  //-----------------
  // начисления - удержания
  _Loop  FrItog1
  { insert into FrItog50 set
       /*FrItog50.Nrec     := FrItog1.Nrec
     ,*/ FrItog50.TabNum   := 50 // тип таблицы (от 1 до 9)
     , FrItog50.tecopl   := FrItog1.tecopl  // код наименования
     , FrItog50.Name     := FrItog1.Name  // наименование
     , FrItog50.HeadName := FrItog1.HeadName  // код подразделения
     , FrItog50.cKatPodr := FrItog1.cKatPodr  // NRec подразделения
     , FrItog50.Znach    := FrItog1.Znach   // числовое значение
     ;
  } //FrItog1
  _Loop  FrItog6
  { if getfirst FrItog50 where (( 50 == FrItog50.TabNum
      and FrItog6.HeadName == FrItog50.HeadName(noindex) ))=tsok
    {    update current FrItog50 set FrItog50.Znach :=FrItog50.Znach-FrItog6.Znach;
    }
    else
    { insert into FrItog50 set
       /*FrItog50.Nrec     := FrItog6.Nrec
     ,*/ FrItog50.TabNum   :=50 // тип таблицы (от 1 до 9)
     , FrItog50.tecopl   := FrItog6.tecopl  // код наименования
     , FrItog50.Name     := FrItog6.Name  // наименование
     , FrItog50.HeadName := FrItog6.HeadName  // код подразделения
     , FrItog50.cKatPodr := FrItog6.cKatPodr  // NRec подразделения
     , FrItog50.Znach    := -FrItog6.Znach   // числовое значение
     ;
    }
  } //FrItog6



  //-----------------
  ReReadRecord(#FrMasDataZnach1);
  ReReadRecord(#FrMasDataZnach1);
  ReReadRecord(#FrMasDataZnach2);
  ReReadRecord(#FrMasDataZnach5);
  ReReadRecord(#FrItog1);
  ReReadRecord(#FrItog6);
  //-------------------------
  _Loop FrMasDataZnach where (( 4>>=FrMasDataZnach.TabNum ))
  { NextVisual;
    for(ii:=1;ii<=5;ii++)
    { case ii of
      01 : _VA :=VA_KLVIDOPL_905;
      02 : _VA :=VA_KLVIDOPL_906;
      03 : _VA :=VA_KLVIDOPL_907;
      04 : _VA :=VA_KLVIDOPL_908;
      05 : _VA :=VA_KLVIDOPL_909;
      end;
      vSpr.pVidoplP:=FrMasDataZnach.tecopl;
      if vSpr.Getfirst KlVidopl<>tsok continue;
      if coGetAttrID(coKlVidopl,vSpr.KlVidopl.Nrec,_VA)<>0
      { dmsu[ii]+=FrMasDataZnach.Znach;
      }
    }
  }//_Loop FrMasDataZnach where (( 4>>=FrMasDataZnach1.TabNum ))
  StopVisual('',0);
  Result:=true;
} //Function CalcItogFond: boolean;

