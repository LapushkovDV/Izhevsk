 MysqlAddStr(qStr, '           , persons.fio                        as PersFio       ');
 MysqlAddStr(qStr, '           , persons.nrec                       as PersNrec      ');
 MysqlAddStr(qStr, '           , lschet.strtabn                     as PersStrTabn   ');
 MysqlAddStr(qStr, '           , Sum(PrNaryad.chasf)                as chasf         ');
 MysqlAddStr(qStr, '          from                                                   ');
 MysqlAddStr(qStr, '                prnaryad                                         ');
 MysqlAddStr(qStr, '          left join sys_nar on sys_nar.nrec = prnaryad.mnrec     ');
