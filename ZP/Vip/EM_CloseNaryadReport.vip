screen scrMain ('Параметры отчета',,sci13EscPM);
  fields
 //  text1, noprotect;
  FiltrPodr : Protect,PickButton;

  _fDateB, noprotect;
  _fDateE, noprotect;
  _typeRep : noprotect;
  buttons
    cmGo, ,, 'Сформировать' ,,;
    cmCancel,,,'Выход',,;
    <<

Подразделения:.@@@@@@@@@@@@@@@@@@@@@@@@

 В период с:.@@@@@@@@@@  по:.@@@@@@@@@@

 (.) -предварительный`
 (.) -окончательный  `
    <.Сформировать.>     <. Закрыть .>

    >>
end;
handleevent
cmInit:
{
   _fDateB := to_date(1,month(dGetTune('UP.DATOTCH')),year(dGetTune('UP.DATOTCH'))) ;
   _fDateE   := to_date(last_day(_fDateB),month(_fDateB),year(_fDateB));

  GetDateFromTunes(_fDateB,_fDateE);
  if _fDateB = 0 or _fDateE = 0
  then
   {
    SetTunesFromDates(date(01,month(cur_date), year(cur_date)),date(Last_day(cur_date),month(cur_date), year(cur_date)));
    GetDateFromTunes(_fDateB,_fDateE);
   }

   GetFiltrPodr;
 rereadrecord;
}
cmDelOnProtect:
{
   case CurField of
   //--------------
   #FiltrPodr:
   {
    var _markerKau: tPtr = InitMarker(iGetKau.GetMarkerName(cgKau_KatPodr), 8, 10, 10);
     clearmarker(_markerKau);
     donemarker(_markerKau, iGetKau.GetMarkerName(cgKau_KatPodr));
     GetFiltrPodr;
     //   UpdateFilter;
   }
   end;
     ReReadRecord;
}
cmpick:
{
  case curfield of
   #FiltrPodr:
    {
      if ( iGetKau.GetCodeKau(cgiMulti, cgKau_KatPodr, 0h) <> 0 )
      {
       GetFiltrPodr;
      }
    }
 end;
 rereadrecord;
}
CmGO:
{
 logfilenm := '';
   SetTunesFromDates(_fDateB,_fDateE);
 StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);
 FillTmp_Naryad;

 if getfirst Tmp_Naryad = tsOK
 {
    PrintReport1;
    PrintReport2;
    PrintReport3;
  }
  else
  {
    message('Нет данных для формирования отчета!');
  }
  StopVisual;
}
end;
end.



#include UserReport.vih

VipInterface UserReport_EM_CloseNaryadReport Implements IUserReport;
Interface UserReport_EM_CloseNaryadReport;
Procedure Run;
{
 runinterface(EM::EM_CloseNaryadReport);
}
Function  GetReportName : String;
{
 GetReportName := 'Отчет по ежедневному анализу отработанного времени и закрытию нарядов';
}
Function  GetGroupName (Level : Word) : String;
{
 Level:=Level;GetGroupName := '';
}
function  GetPriority : Integer;
{
 GetPriority := 0;
}
function  VisibleInModule(Ind : Byte) : String;
{
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'SKLAD';
    2 : VisibleInModule := 'SUPPLYPLAN';
    3 : VisibleInModule := 'MENUZARP';
  end;
}
End.
