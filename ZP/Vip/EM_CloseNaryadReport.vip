 MysqlAddStr(qStr, '         , prnWithMes0.PersFio                                                                              ');
 MysqlAddStr(qStr, '         , prnWithMes0.PersNrec                                                                             ');
 MysqlAddStr(qStr, '         , prnWithMes0.PersStrTabn                                                                          ');
