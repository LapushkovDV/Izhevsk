 MysqlAddStr(qStr, '          left join lschet on lschet.nrec = prnaryad.clsch       ');
 MysqlAddStr(qStr, '          join attrnam an on an.wtable = 16003 and an.name =  ''Дата создания наряда'' ');
 MysqlAddStr(qStr, '          left join attrval av on av.wtable = an.wtable and av.crec = sys_nar.nrec and av.cattrnam = an.nrec');
 MysqlAddStr(qStr, '          where                                                                                             ');

 MysqlAddStr(qStr, '      prnaryad.DATAN between #date('+ datetostr(_fDateB,'DD,MM,YYYY') +') and #date('+ datetostr(_fDateE,'DD,MM,YYYY')+')');

case _typeRep of
 0 : MysqlAddStr(qStr, '      and sys_nar.choice in(3,203,901,905,906)                                                    ');  //'На проверку'  'Проверено Экономистом' Оформляемый'
 1 : MysqlAddStr(qStr, '      and sys_nar.choice in(3,203)                                                                ');  // проерен БТИЗ и расчитанные в прошлом периоде
end;

 MysqlAddStr(qStr, '          group by  coalesce(av.vdate, prnaryad.datan)                                                      ');
 MysqlAddStr(qStr, '             , katpodr.kod                                                                                  ');
 MysqlAddStr(qStr, '             , katpodr.nrec                                                                                 ');
 MysqlAddStr(qStr, '             , persons.fio                                                                                  ');
 MysqlAddStr(qStr, '             , persons.nrec                                                                                 ');
 MysqlAddStr(qStr, '             , lschet.strtabn                                                                               ');
if _typeRep = 0 //при предварительном отчете добавляем наряды из МЕС
  {
     MysqlAddStr(qStr, '             union all                                                                                      ');
     MysqlAddStr(qStr, '              select                                                                                        ');
     MysqlAddStr(qStr, '                 prn.PodrKod                                                                                ');
     MysqlAddStr(qStr, '               , prn.PodrNrec                                                                               ');
     MysqlAddStr(qStr, '               , prn.datecreate                                                                             ');
     MysqlAddStr(qStr, '               , prn.PersFio                                                                                ');
     MysqlAddStr(qStr, '               , prn.PersNrec                                                                               ');
