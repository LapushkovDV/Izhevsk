VipInterface EM_CloseNaryadReport Licensed(free);

interface EM_CloseNaryadReport 'Отчет по ежедневному анализу отработанного времени и закрытию нарядов' gray
Show at (,,50,8);

table struct tPodrPersYearMonth
(
    PodrKod : string
  , cPodr   : comp
  , cPers   : comp
  , Fio     : string
  , StrTabn : string
  , YearN   : word
  , MesN    : word
)
with index
(
  ind1 = PodrKod + cPers + StrTabn + YearN + MesN
, ind2 = YearN + MesN

)
;
table struct tPodrPers
(
    PodrKod : string
  , cPodr   : comp
  , cPers   : comp
  , Fio     : string
  , StrTabn : string
)
with index
(
  ind1 = PodrKod + cPers + StrTabn
)
;


table struct Tmp_Naryad
(
    PodrKod     : string "Подразделение"
  , cPodr       : comp   "Nrec подразделения"
  , Datecreate  : date   "Дата"
  , Fio         : string "ФИО"
  , cPers       : comp   "Nrec чела"
  , StrTabn     : string "Табельный номер"
  , PlanHRS     : Double "План часы табель"
  , FactHRS     : Double "Факт часы скуд"
  , SumChasF    : Double "Наряд-задания"
)
with index
(
 ind0 = PodrKod + cPers + StrTabn + Datecreate
)
;


table struct tSheet1
(
    PodrKod    : string "Цех"
  , cPodr      : comp   "Nrec подразделения"
  , Datecreate : date   "Дата"
  , PlanHRS    : double "План часы табель"
  , FactHRS    : double "Факт часы скуд"
  , SumChasF   : double "Наряд-задания"
)
with index
(
  ind1 = PodrKod + Datecreate
)
;


table struct tSheet2
(
    cPodr    : comp   "Nrec подразделения"
  , PodrKod  : string "Код подразделения"
  , Fio      : string "ФИО"
  , cPers    : comp   "Nrec чела"
  , StrTabn  : string "% оформления"
  , PlanHRS  : double "План часы"
  , FactHRS  : double "Факт часы"
  , SumChasF : double "Наряд-задания"
)
with index
(
 ind1 = PodrKod + cPers
)
;

table struct tSheet3
(
    cPodr    : comp   "Nrec подразделения"
  , PodrKod  : string "Код подразделения"
  , Fio      : string "ФИО"
  , cPers    : comp   "Nrec чела"
  , StrTabn  : string "% оформления"
  , Datecreate : date   "Дата"
  , PlanHRS  : double "План часы"
  , FactHRS  : double "Факт часы"
  , SumChasF : double "Наряд-задания"
)
with index
(
 ind1 = PodrKod + cPers + Datecreate
)
;

create view
var
   FiltrPodr : string;

   _fDateB
 , _fDateE   : date;

   sFileName
 , logfilenm : string = '';

  _typeRep : byte;
from
   Tmp_Naryad
 , tSheet1
 , tSheet2
 , tSheet3
 , tPodrPersYearMonth
 , tPodrPers
 , GP_SCUD_SALDO
;

Procedure GetDateFromTunes(var _dateB : date; var _dateE : date);
{
  var _dayBeg   : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_BEG');
  var _MonthBeg : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_BEG');
  var _YearBeg  : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_BEG');
  var _dayEnd   : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_END');
  var _MonthEnd : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_END');
  var _YearEnd  : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_END');

  _dateB :=  date(_dayBeg,_MonthBeg, _YearBeg);
  _dateE :=  date(_dayEnd,_MonthEnd, _YearEnd);
}
Procedure SetTunesFromDates(_dateB : date; _dateE : date);
{
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_BEG'  ,   day(_dateB) );
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_BEG', month(_dateB) );
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_BEG' ,  year(_dateB) );

  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_END'  ,   day(_dateE) );
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_END', month(_dateE) );
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_END' ,  year(_dateE) );
}

 Procedure myLog(_STR : string);
{
 if Logfilenm='' then logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0)+'\CloseNaryadReport_'+DateToStr(Cur_Date,'YYYY_MM_DD')+TimeToStr(Cur_Time,'HHMM')+'.log';
  LogStrtofile(logfilenm, _STR);
}
#include EM_CloseNaryadReport_PrintToExcel.vpp
Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  timelog('MysqlAddStr -> result '+add_query_str);
  MyLog('sql: ' + add_query_str);
}

procedure GetFiltrPodr;
{
 var _markerKau: tPtr = InitMarker(iGetKau.GetMarkerName(cgKau_KatPodr), 8, 10, 10);
 if getmarkercount(_markerKau) = 0
  then set FiltrPodr := '--ВСЕ--'
  else set FiltrPodr := 'Выбрано '+getmarkercount(_markerKau);
 donemarker(_markerKau, iGetKau.GetMarkerName(cgKau_KatPodr));
}
#declare fillTmp_Naryad(_DAY)
     if #_DAY > last_day(to_date(1,GP_SCUD_SALDO.MesN,GP_SCUD_SALDO.YearN)) then continue;

     _tmpDate := to_date(#_DAY,GP_SCUD_SALDO.MesN,GP_SCUD_SALDO.YearN);
     if (_tmpDate >= _fDateB) and (_tmpDate <= _fDateE)
      {
         if getfirst Tmp_Naryad where ((    tPodrPersYearMonth.PodrKod   == Tmp_Naryad.PodrKod
                                        and tPodrPersYearMonth.cPers   == Tmp_Naryad.cPers
                                        and tPodrPersYearMonth.StrTabn == Tmp_Naryad.StrTabn
                                        and                   _tmpDate == Tmp_Naryad.Datecreate
                                      )) <> tsOK
          {
            Insert Tmp_Naryad set
               Tmp_Naryad.cPodr      := tPodrPersYearMonth.cPodr
             , Tmp_Naryad.PodrKod    := tPodrPersYearMonth.PodrKod
             , Tmp_Naryad.cPers      := tPodrPersYearMonth.cPers
             , Tmp_Naryad.StrTabn    := tPodrPersYearMonth.StrTabn
             , Tmp_Naryad.Datecreate := _tmpDate
             , Tmp_Naryad.PodrKod    := tPodrPersYearMonth.PodrKod
             , Tmp_Naryad.Fio        := tPodrPersYearMonth.Fio
             , Tmp_Naryad.PlanHRS    := GP_SCUD_SALDO.CH_GRAFCH[#_DAY]
             , Tmp_Naryad.FactHRS    := GP_SCUD_SALDO.CH_FACTCH[#_DAY]
            ;
          }
      }
#end
procedure fillChasFactPlan;
{
  _loop tPodrPersYearMonth
   {
     if getfirst GP_SCUD_SALDO where (( tPodrPersYearMonth.cPers == GP_SCUD_SALDO.cPersons
                                    and tPodrPersYearMonth.YearN == GP_SCUD_SALDO.YearN
                                    and tPodrPersYearMonth.MesN  == GP_SCUD_SALDO.MesN
                                     )) = tsOK
     {
       var _tmpDate : date = 0;
       #fillTmp_Naryad(1)
       #fillTmp_Naryad(2)
       #fillTmp_Naryad(3)
       #fillTmp_Naryad(4)
       #fillTmp_Naryad(5)
       #fillTmp_Naryad(6)
       #fillTmp_Naryad(7)
       #fillTmp_Naryad(8)
       #fillTmp_Naryad(9)
       #fillTmp_Naryad(10)
       #fillTmp_Naryad(11)
       #fillTmp_Naryad(12)
       #fillTmp_Naryad(13)
       #fillTmp_Naryad(14)
       #fillTmp_Naryad(15)
       #fillTmp_Naryad(16)
       #fillTmp_Naryad(17)
       #fillTmp_Naryad(18)
       #fillTmp_Naryad(19)
       #fillTmp_Naryad(20)
       #fillTmp_Naryad(21)
       #fillTmp_Naryad(22)
       #fillTmp_Naryad(23)
       #fillTmp_Naryad(24)
       #fillTmp_Naryad(25)
       #fillTmp_Naryad(26)
       #fillTmp_Naryad(27)
       #fillTmp_Naryad(28)
       #fillTmp_Naryad(29)
       #fillTmp_Naryad(30)
       #fillTmp_Naryad(31)
     }
   }
}

