  else
  {
    sqlCopyInto(objQuery1, tntPodrPers, true);
  }
   var _markerKau : tPtr = InitMarker(iGetKau.GetMarkerName(cgKau_KatPodr), 8, 10, 10);
   var _markerCnt : longint = getMarkerCount(_markerKau);
   SetVisualHeader('Фильтрация по подразделениям');


  _loop tPodrPers
   {
     if not(_markerCnt = 0 or SearchMarker(_markerKau, tPodrPers.cPodr, 0))  // это надо по хорошему в запрос встаивть и мознги не иметь
         {
//          mylog(' !NO' + tPodrPers.PodrKod + ' ' +tPodrPers.Fio);
          continue;
         }
     var _tmpDate : date = _fDateB;
      do
      {
//          mylog(' !OK' + tPodrPers.PodrKod + ' ' + tPodrPers.Fio +  ' ' + _tmpDate);
         insert tPodrPersYearMonth set
            tPodrPersYearMonth.PodrKod := tPodrPers.PodrKod
          , tPodrPersYearMonth.cPodr   := tPodrPers.cPodr
          , tPodrPersYearMonth.cPers   := tPodrPers.cPers
          , tPodrPersYearMonth.Fio     := tPodrPers.Fio
          , tPodrPersYearMonth.StrTabn := tPodrPers.StrTabn
          , tPodrPersYearMonth.YearN   := Year(_tmpDate)
          , tPodrPersYearMonth.MesN    := month(_tmpDate)
         ;
        _tmpDate := Add_Months(_tmpDate,1)
      }
     while date(1,month(_tmpDate),year(_tmpDate)) < date(1,month(_fDateE),year(_fDateE))
   }


   SetVisualHeader('Фильтрация по подразделениям');

    _loop Tmp_Naryad
     {
      if not(_markerCnt = 0 or SearchMarker(_markerKau, Tmp_Naryad.cPodr, 0))  // это надо по хорошему в запрос встаивть и мознги не иметь
         {
          delete current Tmp_Naryad;
         }
         else
         {
           if getfirst tPodrPersYearMonth where  ((     Tmp_Naryad.PodrKod   == tPodrPersYearMonth.PodrKod
                                                    and Tmp_Naryad.cPers   == tPodrPersYearMonth.cPers
                                                    and Tmp_Naryad.StrTabn == tPodrPersYearMonth.StrTabn
                                           and year(Tmp_Naryad.datecreate) == tPodrPersYearMonth.YearN
                                          and month(Tmp_Naryad.datecreate) == tPodrPersYearMonth.MesN
                                                 )) <> tsOK
             {
               insert tPodrPersYearMonth set
                  tPodrPersYearMonth.cPodr   := Tmp_Naryad.cPodr
                , tPodrPersYearMonth.PodrKod := Tmp_Naryad.PodrKod
                , tPodrPersYearMonth.cPers   := Tmp_Naryad.cPers
                , tPodrPersYearMonth.StrTabn := Tmp_Naryad.StrTabn
                , tPodrPersYearMonth.YearN   := year(Tmp_Naryad.datecreate)
                , tPodrPersYearMonth.MesN    := month(Tmp_Naryad.datecreate)
                , tPodrPersYearMonth.FIO     := Tmp_Naryad.FIO
                ;
             }
         }
     }
   donemarker(_markerKau, iGetKau.GetMarkerName(cgKau_KatPodr));

   SetVisualHeader('Просмотр плановый и фактических часов по данным СКУД');
   fillChasFactPlan;

   SetVisualHeader('Подсуммирование итогов по отчетам');
    _loop Tmp_Naryad
     {

           // sheet1
            if getfirst tSheet1 where (( Tmp_Naryad.PodrKod == tSheet1.podrKod
                                  and Tmp_Naryad.datecreate == tSheet1.datecreate )) <> tsOK
             {
               Insert tSheet1 set
                  tSheet1.podrKod    := Tmp_Naryad.PodrKod
                , tSheet1.datecreate := Tmp_Naryad.datecreate
                , tSheet1.cPodr      := Tmp_Naryad.cPodr
               ;
             }
             update current tSheet1 set
                tSheet1.PlanHRS  := tSheet1.PlanHRS  + Tmp_Naryad.PlanHRS
              , tSheet1.FactHRS  := tSheet1.FactHRS  + Tmp_Naryad.FactHRS
              , tSheet1.SumChasF := tSheet1.SumChasF + Tmp_Naryad.SumChasF
             ;
           // sheet2
            if getfirst tSheet2 where (( Tmp_Naryad.PodrKod == tSheet2.podrKod
                                       and Tmp_Naryad.cPers == tSheet2.cPers )) <> tsOK
             {
               Insert tSheet2 set
                  tSheet2.podrKod := Tmp_Naryad.PodrKod
                , tSheet2.cPodr   := Tmp_Naryad.cPodr
                , tSheet2.cPers   := Tmp_Naryad.cPers
                , tSheet2.StrTabn := Tmp_Naryad.strtabn
                , tSheet2.Fio     := Tmp_Naryad.fio
               ;
             }
             update current tSheet2 set
                tSheet2.PlanHRS  := tSheet2.PlanHRS  + Tmp_Naryad.PlanHRS
              , tSheet2.FactHRS  := tSheet2.FactHRS  + Tmp_Naryad.FactHRS
              , tSheet2.SumChasF := tSheet2.SumChasF + Tmp_Naryad.SumChasF
             ;
           // sheet3
            if getfirst tSheet3 where (( Tmp_Naryad.PodrKod == tSheet3.podrKod
                                       and Tmp_Naryad.cPers == tSheet3.cPers
                                  and Tmp_Naryad.datecreate == tSheet3.datecreate )) <> tsOK
             {
               Insert tSheet3 set
                  tSheet3.podrKod    := Tmp_Naryad.PodrKod
                , tSheet3.datecreate := Tmp_Naryad.datecreate
                , tSheet3.cPodr      := Tmp_Naryad.cPodr
                , tSheet3.cPers      := Tmp_Naryad.cPers
                , tSheet3.StrTabn    := Tmp_Naryad.strtabn
                , tSheet3.Fio        := Tmp_Naryad.fio
               ;
             }
             update current tSheet3 set
                tSheet3.PlanHRS  := tSheet3.PlanHRS  + Tmp_Naryad.PlanHRS
              , tSheet3.FactHRS  := tSheet3.FactHRS  + Tmp_Naryad.FactHRS
              , tSheet3.SumChasF := tSheet3.SumChasF + Tmp_Naryad.SumChasF
             ;
     }

  StopVisual;
}

procedure PrintReport1;
{
  var _excelFile :string = GetStringParameter('Files','TmpFilesDirectory',0)+'CloseNaryadReport_1_'+UserName+'_'+DateToStr(Cur_Date,'YYYYMMDD')+'_'+TimeToStr(Cur_Time,'HHMMSS')+'.xlsx';
  if not CreateExcel(_excelFile)
    then {Stop; Abort; exit;}
  xlSetActiveSheet(1);
  xlSetSheetName(1, 'CloseNaryadReport_1_'+UserName);

 StartNewVisual(vtRotateVisual, vfBreak+vfTimer, 'Формирование отчета 1', 1);
 xlCreateMatrix(100,6);
  var Nrow0,nrow0FrameBold, Nrow, _column, nrowreal : longint;
 nrowreal := 1;
 Nrow := _column := 1;
 xlStWriteToMatrix(nrow, _column,'Выработка по подразделениям/участкам по датам');
 xlMergeCells(nrow,_column,nrow,_column+5);
 xlSetFontStyle(1,nrow,1,nrow,_column+5);
 Nrow++;
 _column := 1;
 xlStWriteToMatrix(nrow, _column,'Цех/место'); _column++;
 xlStWriteToMatrix(nrow, _column,'Дата'); _column++;
 xlStWriteToMatrix(nrow, _column,'План-часы'); _column++;
 xlStWriteToMatrix(nrow, _column,'Факт-часы'); _column++;
 xlStWriteToMatrix(nrow, _column,'Наряд-задания'); _column++;
 xlStWriteToMatrix(nrow, _column,'% оформления'); _column++;

 xlSetFontStyle(1,nrow,1,nrow,_column);
// Nrow++;
 _column := 1;
// xlSetFontStyle(1,nrow,1,nrow,10);
 xlSetcolumnWidth(15,1,1 ,1, 6);

MyPrintMatrixToExcel(Nrow,NrowReal);

  _loop tSheet1
   {
    _column := 1;
    nrow++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tSheet1.PodrKod    );  _column++;
    xldtWriteToMatrix(nrow, _column, tSheet1.Datecreate );  _column++;
    xlStWriteToMatrix(nrow, _column, tSheet1.PlanHRS    );  _column++;
    xlStWriteToMatrix(nrow, _column, tSheet1.FactHRS    );  _column++;
    xlStWriteToMatrix(nrow, _column, tSheet1.SumChasF   );  _column++;
    xlStWriteToMatrix(nrow, _column, if(tSheet1.FactHRS <> 0 , tSheet1.SumChasF/tSheet1.FactHRS,0)*100 );  ;
    MyPrintMatrixToExcel(Nrow,NrowReal);
   }
  xlWriteMatrixToExcel(NrowReal,1);
  xlSetNumberFormat('# ##0,00', 1, 4, nrow+nrowreal-1, _column);
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB, xlMedium, xlContinuous, 0, 2, 1, nrow+nrowreal-1, _column);
  xlWriteMatrixToExcel(NrowReal,1);
  xlSaveWorkBookByName(_excelFile);
  xlKillExcel;
  StopVisual('',0);
}

procedure PrintReport2;
{
  var _excelFile :string = GetStringParameter('Files','TmpFilesDirectory',0)+'CloseNaryadReport_2_'+UserName+'_'+DateToStr(Cur_Date,'YYYYMMDD')+'_'+TimeToStr(Cur_Time,'HHMMSS')+'.xlsx';
  if not CreateExcel(_excelFile)
    then {Stop; Abort; exit;}
  xlSetActiveSheet(1);
  xlSetSheetName(1, 'CloseNaryadReport_2_'+UserName);

 StartNewVisual(vtRotateVisual, vfBreak+vfTimer, 'Формирование отчета 2', 1);
 xlCreateMatrix(100,7+3);
  var Nrow0,nrow0FrameBold, Nrow, _column, nrowreal : longint;
 nrowreal := 1;
 Nrow := _column := 1;
 xlStWriteToMatrix(nrow, _column,'Выработка по сотрудникам за период');
 xlMergeCells(nrow,_column,nrow,_column+5);
 xlSetFontStyle(1,nrow,1,nrow,_column+5);
 Nrow++;
 _column := 1;
 xlStWriteToMatrix(nrow, _column,'Цех/место'); _column++;
 xlStWriteToMatrix(nrow, _column,'Дата'); _column++;
 xlStWriteToMatrix(nrow, _column,'ФИО'); _column++;
 xlStWriteToMatrix(nrow, _column,'План-часы'); _column++;
 xlStWriteToMatrix(nrow, _column,'Факт-часы'); _column++;
 xlStWriteToMatrix(nrow, _column,'Наряд-задания'); _column++;
 xlStWriteToMatrix(nrow, _column,'% оформления'); _column++;

/* xlStWriteToMatrix(nrow, _column,'.cPodr   '); _column++;
 xlStWriteToMatrix(nrow, _column,'.cPers   '); _column++;
 xlStWriteToMatrix(nrow, _column,'.StrTabn '); _column++;
*/

 xlSetFontStyle(1,nrow,1,nrow,_column);
// Nrow++;
 _column := 1;
// xlSetFontStyle(1,nrow,1,nrow,10);
 xlSetcolumnWidth(15,1,1 ,1, 7);
 xlSetcolumnWidth(40,1,3 ,1, 3);
MyPrintMatrixToExcel(Nrow,NrowReal);

  _loop tSheet2
   {
    _column := 1;
    nrow++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tSheet2.PodrKod    );  _column++;
    xlStWriteToMatrix(nrow, _column, '   -   ' );  _column++;
    xlStWriteToMatrix(nrow, _column, tSheet2.FIO );  _column++;
    xlStWriteToMatrix(nrow, _column, tSheet2.PlanHRS    );  _column++;
    xlStWriteToMatrix(nrow, _column, tSheet2.FactHRS    );  _column++;
    xlStWriteToMatrix(nrow, _column, tSheet2.SumChasF   );  _column++;
    xlStWriteToMatrix(nrow, _column, if(tSheet2.FactHRS <> 0 , tSheet2.SumChasF/tSheet2.FactHRS,0)*100 );  ; _column++;

/*    xlStWriteToMatrix(nrow, _column,  tSheet2.cPodr   ); _column++;
    xlStWriteToMatrix(nrow, _column,  tSheet2.cPers   ); _column++;
    xlStWriteToMatrix(nrow, _column,  tSheet2.StrTabn );
*/

    MyPrintMatrixToExcel(Nrow,NrowReal);
   }
  xlWriteMatrixToExcel(NrowReal,1);
  xlSetNumberFormat('# ##0,00', 1, 4, nrow+nrowreal-1, _column);
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB, xlMedium, xlContinuous, 0, 2, 1, nrow+nrowreal-1, _column);
  xlWriteMatrixToExcel(NrowReal,1);
  xlSaveWorkBookByName(_excelFile);
  xlKillExcel;
  StopVisual('',0);
}
