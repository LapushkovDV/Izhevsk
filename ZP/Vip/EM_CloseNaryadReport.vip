 MysqlAddStr(qStr, '             when 16 then SCUD_SALDO.CH_GRAFCH[16] when 17 then SCUD_SALDO.CH_GRAFCH[17] when 18 then SCUD_SALDO.CH_GRAFCH[18] when 19 then SCUD_SALDO.CH_GRAFCH[19] when 20 then SCUD_SALDO.CH_GRAFCH[20] ');
 MysqlAddStr(qStr, '             when 21 then SCUD_SALDO.CH_GRAFCH[21] when 22 then SCUD_SALDO.CH_GRAFCH[22] when 23 then SCUD_SALDO.CH_GRAFCH[23] when 24 then SCUD_SALDO.CH_GRAFCH[24] when 25 then SCUD_SALDO.CH_GRAFCH[25] ');
 MysqlAddStr(qStr, '             when 26 then SCUD_SALDO.CH_GRAFCH[26] when 27 then SCUD_SALDO.CH_GRAFCH[27] when 28 then SCUD_SALDO.CH_GRAFCH[28] when 29 then SCUD_SALDO.CH_GRAFCH[29] when 30 then SCUD_SALDO.CH_GRAFCH[30] ');
 MysqlAddStr(qStr, '             when 31 then SCUD_SALDO.CH_GRAFCH[31] end as PlanHRS');
 MysqlAddStr(qStr, '      , prnWithMes.chasf                as SumChasF              ');
 MysqlAddStr(qStr, '                                                                 ');
 MysqlAddStr(qStr, '   from                                                          ');
 MysqlAddStr(qStr, '   (select                                                       ');
 MysqlAddStr(qStr, '        prnWithMes0.PodrKod                                      ');
 MysqlAddStr(qStr, '      , prnWithMes0.PodrNrec                                     ');
 MysqlAddStr(qStr, '      , prnWithMes0.datecreate                                   ');
