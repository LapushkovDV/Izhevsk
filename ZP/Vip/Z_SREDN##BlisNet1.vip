Своими силами
Добавляем признак наличия совмещений в листках нетрудоспособности
\*************************************************************************************************/


#component "Z_Sredn"
alter interface BLisNet1;
ExtendFormats BLisNett3;
create view
as select
 if(getfirst lschet_EM = tsOK ,'     ЕСТЬ СОВМЕЩЕНИЕ','') (FieldName = EXISTSOVM_EM)
from
 lschet lschet_EM
 where
((
 blisnet.tperson == lschet_EM.tperson
 and(lschet_EM.datuv=0 and lschet_EM.sovm=3)
))
;
SCREEN BLisNett3;
fields
 EXISTSOVM_EM: {Font = {Color = 10}},skip;
<<



.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;
end.
