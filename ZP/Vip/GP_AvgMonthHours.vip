/*************************************************************************************************\
* Наименование: ZarAPI алгоритм "Среднемесячная норма рабочего времени"                           *
* Контур/Модуль: Заработная плата                                                                 *
* Пункт меню: Настройка / Заполнение каталогов / Виды оплат и скидок                              *
* Примечание:                                                                                     *
* Для использования нужно создать спец.алгоритм со следующим содержанием:                         *
* ZARALG('GP_ZP::GP_AvgMonthHours', '11, 2017, true')                                             *
* где                                                                                             *
*   параметр 1 - код режима работы (если параметр не передан, для получения его значения          *
*                вызывается UCH_REJIM);                                                           *
*   параметр 2 - год (если параметр не передан, для получения его значения вызывается UCH_YEAR);  *
*   параметр 3 - признак вывода лога (если true или on будет выведен лог работы алгоритма при     *
*                расчёте з/п, если параметр не передан лог не выводится).                         *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#762          |03/10/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include ZarAlg.vih

VipInterface zarAlgorithm_GP_AvgMonthHours implements IzarAlgorithm;

interface zarAlgorithm_GP_AvgMonthHours cacheable;

  create view
    from
      KlRejim,
      GP_KlRejim,
      GP_TimeNorms
    where ((
          KlRejim.NRec         == GP_KlRejim.cKlRejim
      and GP_KlRejim.cGP_PrCal == GP_PrCal.NRec
    ));

  var
    pShowLog: Boolean;
    pRejim: Word;
    pYear: Word;

  procedure LogInfo(S: String);
  begin
    if pShowLog then
      Displ(S);
  end;

  procedure LogError(S: String);
  begin
    Displ(if(not pShowLog, 'ОGP_AvgMonthHours: ', '') + 'Ошибка: ' + S);
  end;

  procedure ParseAlgParams(ParamStr: String);
  var
    I: Word;
    P: Byte;
    Value: String;
  begin
    pShowLog := false;
    pRejim := 0;
    pYear := 0;
    I := 0;
    do begin
      I++;
      P := InStr(',', ParamStr);
      if P > 0 then
      begin
        Value := SubStr(ParamStr, 1, P - 1);
        ParamStr := SubStr(ParamStr, P + 1, Length(ParamStr) - P);
      end else
        Value := ParamStr;
      Value := LoCase(Trim(Value));
      if Value != '' then
        case I of
          1: pRejim := Word(Value);
          2: pYear := Word(Value);
          3: pShowLog := (Value = 'on' or Value = 'true');
        end;
    end while P > 0;
    // По умолчанию берём режим из предварительной разноски
    if pRejim = 0 then
      pRejim := UCH_REJIML;
    // По умолчанию берём год из предварительной разноски
    if pYear = 0 then
      pYear := UCH_YEAR;
  end;

  function CalcSum(Parameter: String): Double;
  begin
    CalcSum := 0;
    ParseAlgParams(Parameter);
    LogInfo('Алгоритм GP_AvgMonthHours:');
    LogInfo(' Режим: ' + To_Char(pRejim));
    LogInfo(' Год: ' + To_Char(pYear));
    if GetFirst KlRejim where ((pRejim == KlRejim.Rejim)) != tsOk then
    begin
      LogError('Не найден режим с кодом ' + To_Char(pRejim));
      exit;
    end;
    LogInfo(' Производственный календарь: ' + GP_PrCal.Name);
    if GetFirst GP_TimeNorms where ((pYear == GP_TimeNorms.Year and GP_PrCal.NRec == GP_TimeNorms.cGP_PrCal)) != tsOk then
    begin
      LogError('Не найдена норма для пр.календаря "' + GP_PrCal.Name + '" за ' + To_Char(pYear) + ' год');
      exit;
    end;
    LogInfo(' Ср.мес.кол-во часов: ' + To_Char(GP_TimeNorms.Hours, 0, 2));
    CalcSum := GP_TimeNorms.Hours;
  end;

  function GetDescription: String;
  begin
    GetDescription := 'Среднемесячная норма рабочего времени';
  end;

end.
