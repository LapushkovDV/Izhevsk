#IFNDEF __GP_LSBANKREQ_VIH__
#DEFINE __GP_LSBANKREQ_VIH__

#component "GP_ZP"

objInterface GP_ObjDepFunc;

  // Копирует банковские реквизиты
  // _cLSchetSrc - ссылка на лицевой счет, из которого копируются банковские реквизиты
  // _cLSchetDst - ссылка на лицевой счет, в который копируются банковские реквизиты
  // _SilentMode - если true, сообщения об ошибках при копировании не выводятся
  // _StartPerDt - значение поля "Начало пересчета" для создаваемых удержаний
  function CopyBankReq(_cLSchetSrc: tNRec; _cLSchetDst: tNRec; _SilentMode: Boolean = false; _StartPerDt: Date = ZeroDate): Boolean;

  // Ищет лицевой счет с указанным табельным номером
  // _TabN - числовое представление табельного номера
  // _StrTabn - строковое представление табельного номера
  function FindLSchet(_TabN: tTabN; _StrTabn: TabnStr): tNRec;

end;

vipInterface GP_LSBankReq Implements GP_ObjDepFunc;
#endif
