//=====================================
//Отчет по заказам с расшифровкой по ВО
//, dbo.toInt64(katsopr.f$corg) as k2
//=====================================
// см также 03
//==============================
// запуск отчета
//==============================
Function CreateReport04 :boolean;
var ww_dt :date;
    ww_su:double;
    i,j :word;
{ CreateReport04:=false;
  UserDeskRep.ResWord[40] :=
    if((UserDeskRep.ResWord[37] and 1)>0,8,0)
   +if((UserDeskRep.ResWord[37] and 2)>0,128,0)
   +if((UserDeskRep.ResWord[37] and 4)>0,4,0) ;
  UserDeskRep.ResWord[38]:=1;
  // период Группировка 1
  UserDeskRep.ResWord[11]:=27; // по месяцу начисления
  UserDeskRep.ResWord[12]:=0;
  UserDeskRep.ResWord[31]:=0;
  //----- заказ + этап 'Группировка 2'
  UserDeskRep.ResWord[13]:=29;//4; // 
  UserDeskRep.ResWord[14]:=0;
  UserDeskRep.ResWord[32]:=0;
  //----- подразделение  'Группировка 3'
  UserDeskRep.ResWord[15]:=1;
  UserDeskRep.ResWord[16]:=0; 
  UserDeskRep.ResWord[33]:=0; 
  // по ФИО  //       Группировка 4
  UserDeskRep.ResWord[17]:=4; 
  UserDeskRep.ResWord[18]:=0; 
  UserDeskRep.ResWord[34]:=0; 
  //----- должность 'Группировка 5'
  UserDeskRep.ResWord[19]:=5; //29 ;
  UserDeskRep.ResWord[20]:=0 ;
  UserDeskRep.ResWord[35]:=0 ;
  //----- виды оплат 'Группировка 6'
  UserDeskRep.ResWord[41]:=6; // ;

  //----------------
  UserDeskRep.ResComp[20]:=0;
  Result:=CreateReport01;
  if Result PrintDoc_04(0);
} //Function CreateReport04 :boolean;



//===================================
Function PrintIT04( su_IT :double; ch_it :double; SName:string;wPrevLevel:word):boolean;
var ww_su:double;
{ 
  if HeaderStrCount<wexrow
  { MyxlFrameCells(63, 2, 1, 1, HeaderStrCount,1,wexrow,max_col);
    xlWrapText(HeaderStrCount ,1,wexrow,max_col);
  }
  wexrow:=wexrow+1; 
  if SName<>''
  {  wexcol:=3;
     MyPutExcel(SName,10,0,-1,-1) ; 
     xlMergeCells(wexrow,3, wexrow,7); //Объединяем ячейки
  }
  xlSetFontStyle(xlBold, wexrow,1,wexrow,10);
  wexcol:=8;
  MyPutExcelNumber(ch_it,1,10,0,-1,-1);  
  _Loop tmp_vo where ((  0 == tmp_vo.tp and 0 == tmp_vo.wLev )) ordered by index tmp_vo02
  { ww_su:=0 ;
    if getfirst tmp_vo_Sb where (( 0 == tmp_vo_sb.tp 
                      and wPrevLevel  == tmp_vo_sb.wLev 
                      and tmp_vo.name == tmp_vo_sb.name 
                      ))=tsok 
    { ww_su:=tmp_vo_Sb.Su[1] ;
      update current tmp_vo_Sb set tmp_vo_Sb.Su[1]:=0;
    }
    MyPutExcelNumber(ww_su,1,10,0,-1,-1);    
  }
  MyPutExcelNumber(su_IT,1,10,0,-1,-1);  
  MyxlFrameCells(63, 2, 1, 1,wexrow,8,wexrow,max_col);
  Result:=true;      
}//Function PrintIT04( su_IT :double; ch_it :double):boolean;

//===================================
Function PrintName4(ww_str:string):string;
var ii :word;
{  ii:=Pos('==',ww_str);
   if ii>0
     Result:=Substr(ww_Str,ii+2,255)
   else
   { ii:=Pos(':',ww_str);
     if ii>0
       Result:=Substr(ww_Str,ii+1,255)     
     else   
       Result:=ww_str;  
   }
   if pos('По месяцу начисления',TempDescr.name)>0  
   { Result:=Substr(Result,4,200);
     //1.По месяцу начисления:27== 2/0
   }
} //Function PrintName3(ww_str:string):string

//===================================
// Соберем суммы по видам оплат
//===================================
Procedure InsSumVOLev(wLevel:word; _Name:string;  ww_su:double);
{ if getfirst tmp_vo_Sb where (( 0 == tmp_vo_sb.tp and wLevel == tmp_vo_sb.wLev and _Name == tmp_vo_sb.Name  )) <>tsok
  { clearbuffer(#tmp_vo_Sb);
    tmp_vo_sb.tp:=0  ;
    tmp_vo_sb.wLev :=wLevel ;
    tmp_vo_sb.Name :=_Name ;
    tmp_vo_sb.Su[1]:=ww_su ;
    insert current tmp_vo_sb;
  }  
  else
  { update current tmp_vo_sb set tmp_vo_sb.Su[1]:=tmp_vo_sb.Su[1]+ww_su;
  }
} //Procedure InsSunVOLev(wLevel:word; _Vo:word;ww_su:double);


//===================================
Function PrintDoc_04(ww_type:word) : boolean;
VAR
 boIsTerm :boolean;
 wnpp:longint;
 wwkl:boolean;
 wLevel_Start: word;
 wCurLevel,wPrevLevel:longint=0;
 i:word;
 ww_sPeriod, ww_sTabn, ww_Sfio,ww_sPodr,ww_sDolg, ww_sZakaz, ww_sStage ,ww_SVo :string;
 // по заказу
 su_IT :double=0;
 ch_it :double=0;
 // по периоду
 su_IT_P :double=0;
 ch_it_P :double=0;
 // по поздразделению
 su_IT_Podr :double=0;
 ch_it_Podr :double=0;
 // всего
 su_IT_ALL :double=0;
 ch_it_ALL :double=0;
 ww_str:string;
{ PrintDoc_04 :=false ;
  if ExcelInit(nmtemplate,true,2009)<>0
  { message('Ошибка инициализации шаблона') ;
    exit ;
  }
  vZakaz.delete all tmp_Zakaz;
  vZakaz.delete all tmp_Zakaz;
  MainTree:=trTmpTree01;
  StartNewVisual(vtNumericVisual,vfTimer+vfBreak,'Идет печать...', vfTimer+vfBreak);
  wexrow:=1;wexcol:=1;
  MyPutExcel(commonformheader,10,0,-1,-1) ;
  wexrow:=4;wexcol:=4;
  MyPutExcel(//'Отчет '+sGetTune('MyOrg')   +' по заказам '
  
    +DateToStr(UserDeskRep.ResDate[1],'за период с DD/MM/YYYY по ') 
    +DateToStr(UserDeskRep.ResDate[2],'DD/MM/YYYY') 
    //+GetFilterName
    ,10,0,-1,-1);
  wexrow:=6;wexcol:=3;
  MyPutExcel('Подразделение:'+  if((UserDeskRep.ResWord[1] and 1)>0,fFltPodr,' ') ,10,0,-1,-1) ;
  wexrow:=7;wexcol:=3;
  MyPutExcel('Заказ:'+  if((UserDeskRep.ResWord[1] and  8)>0,fFltNazna,' ') ,10,0,-1,-1) ;
  wexrow:=8;wexcol:=3;
  MyPutExcel('Этап:' +  if((UserDeskRep.ResWord[1] and 16)>0,fFltStage,' ') ,10,0,-1,-1) ;
  HeaderStrCount:=12;//2;  
  wexcol:=9;
  wexrow:=HeaderStrCount;
  if getfirst  tmp_vo where ((  0 == tmp_vo.tp and 0 == tmp_vo.wLev ))<>tsok
  { insert into tmp_vo set tmp_vo.tp:=0, tmp_vo.name='';
  }

  _Loop fullcache tmp_Vo where (( 0 == tmp_Vo.TP and 0 == tmp_Vo.wLev )) ordered by index tmp_vo02
  { if wexcol<>9
    { xlInsertRange(xlShiftToRight,1,wexcol,HeaderStrCount,wexcol) ;
    }
    update current tmp_Vo set tmp_Vo.Col:=wexcol;
    MyPutExcel(tmp_Vo.Name ,10,0,-1,-1) ;
    
  }
  max_col:=wexcol;
  //-------------------------------------------  
  HeaderStrCount:=10;//2;  
  wexrow:=HeaderStrCount;
  MyXlCreaMatrix(10000,wexcol) ;
  wexrow:=wexrow-1;
  case ww_type of
  0,2: wwkl:=TreeGetFirstEx(MainTree );
  1: { wwkl:=true; wLevel_Start:=TreeLevel(MainTree);}
  else exit;
  end;
  wnpp:=0;
  ch_it:=0;
  su_IT:=0;
  su_IT_Podr :=0;
  ch_it_Podr :=0;

  wCurLevel:=-2;
  ww_sPeriod:='' ;
  ww_sTabn:=ww_Sfio:=ww_sPodr:=ww_sDolg:=ww_sZakaz:=ww_sStage :='';
  if  wwkl
  do
  {   if not nextvisual then break;
      Mylogwrite(false,string(wPrevLevel)+'->'+string(wCurLevel)+',TempDescr.name='+TempDescr.name+'/'+string(wnpp));
      wPrevLevel := wCurLevel;
      wCurLevel  := TreeLevel(MainTree);
      boIsTerm   := TreeIsTerminal( MainTree );
      //------ по подразделению
      if wPrevLevel>=wCurLevel and 
        (wCurLevel<=3 and wCurLevel>0)  
      { 
        PrintIT04(su_IT_Podr,ch_It_Podr,'Итого по '+ww_SPodr,3) ;
        su_IT_Podr:=0;ch_It_Podr:=0;
      } //if wPrevLevel>=wCurLevel and wCurLevel=0 and (su_it<>0  or ch_it>0)

      //-------------- по заказу
      if wPrevLevel>=wCurLevel and 
       ( (wCurLevel=2)	 //and ww_sZakaz<>trim(SubStr(PrintName3(TempDescr.name),1,60)) )
        or wCurLevel=1)  //and (su_it<>0  or ch_it>0)
      { 
        PrintIT04(su_IT,ch_It,'Итого по '+if(ww_sZakaz='','нет заказа',ww_sZakaz+'/'+ww_sStage),2);
        ch_it:=0 ;
        su_it:=0 ;
      } //if wPrevLevel>=wCurLevel and wCurLevel=0 and (su_it<>0  or ch_it>0)

      // по периоду
      if wPrevLevel>=wCurLevel and wCurLevel=1 //and (su_it<>0  or ch_it>0)
      { 
        PrintIT04(su_IT_P,ch_It_P,'Итого за '+ww_sPeriod,1);
        wexrow:=wexrow+2; 
        /*
        xlCopyToBuff(1, 1, 24,6)
        //только в таком порядке. В рабочей папке можно создать Excel.log
        if not xlPasteAllFromBuff(w_exrow_p+1, 1, w_exrow_p+24,6)
        { timelog('FormStud_AktSverkiByDog->PrintShap:xlPasteAllFromBuff ERROR='+xlGetLastError)
        }
        if not xlPasteFormatFromBuff(w_exrow_p+1, 1, w_exrow_p+24,6)
        */
        ch_it:=0 ;
        su_it:=0 ;
      } //if wPrevLevel>=wCurLevel and wCurLevel=0 and (su_it<>0  or ch_it>0)

      
      MyLogWrite(false,'Уровень='+string(wCurLevel)+', TempDescr.name='+TempDescr.name) ;
      Case wCurLevel of
      0:
      { 
        ch_it_ALL:=TempDescr.Sum[2] ;
        su_it_ALL:=TempDescr.Sum[3] ;

      }
      1: 
      { 
        ch_it_P:=TempDescr.Sum[2]  ;
        su_it_P:=TempDescr.Sum[3]  ;

        wexrow:=wexrow+1; wexcol:=2;
        ww_sPeriod:=PrintName3(TempDescr.name) ;
        MyPutExcel(ww_sPeriod,10,0,-1,-1);
        wexrow:=wexrow+1; wexcol:=1;
        MyPutExcel('пп',9,0,-1,-1)  ;
        MyPutExcel('Таб.№',9,0,-1,-1) ;
        MyPutExcel('ФИО',9,0,-1,-1)  ;
        MyPutExcel('Подразделение',9,0,-1,-1);
        MyPutExcel('Должность',9,0,-1,-1) ;
        MyPutExcel('Заказ',9,0,-1,-1)     ;
        MyPutExcel('Этап',9,0,-1,-1)      ;
        MyPutExcel('Количество отработанных часов',9,0,-1,-1)  ;
        MyPutExcel('Виды начислений',9,0,-1,-1)     ;
        wexrow:=wexrow+1 ;
        wexcol:=wexcol-1 ;
        _Loop fullcache tmp_Vo where (( 0 == tmp_Vo.TP and 0 == tmp_Vo.wLev )) ordered by index tmp_vo02
        {  MyPutExcel(tmp_Vo.Name ,10,0,-1,-1) ;
        }
        wexrow:=wexrow-1 ;       
        if max_col>10
        { xlMergeCells(wexrow,9, wexrow,max_col-1); //Объединяем ячейки
        }
        MyPutExcel('Сумма начисленной заработной платы, руб',9,0,-1,-1);
        for(i:=1;i<=8;i++)
          xlMergeCells(wexrow,i, wexrow+1,i); //Объединяем ячейки
        xlMergeCells(wexrow,max_col, wexrow+1,max_col); //Объединяем ячейки
        if wexrow<>11
        { xlCopyToBuff(11, 1, 12,max_col) ;
          if not xlPasteFormatFromBuff(wexrow, 1, wexrow+1,max_col) {}
        }  
        wexrow:=wexrow+1  ;
        HeaderStrCount:=wexrow;

        wnpp:=0;
        ww_Sfio:='';ww_sPodr:='';ww_sDolg:='';ww_sZakaz:='';ww_sStage:='';
      }
      2:
      {
        ch_it:=ch_it+TempDescr.Sum[2]  ;
        su_it:=su_it+TempDescr.Sum[3] ;
        ww_sZakaz:=trim(SubStr(PrintName3(TempDescr.name),1,60));
        ww_sStage:=trim(SubStr(PrintName3(TempDescr.name),61,250));
        ww_str:=if(ww_sZakaz='',' нет заказа',ww_sZakaz+'/'+ww_sStage);
        if vZakaz.GetFirst tmp_Zakaz where (( ww_str == tmp_Zakaz.Zakaz )) <>tsok
        {  vZakaz.tmp_Zakaz.Zakaz:=ww_Str ;
           vZakaz.tmp_Zakaz.ChasF:=TempDescr.Sum[2];
           vZakaz.tmp_Zakaz.Summa:=TempDescr.Sum[3];
           vZakaz.insert current tmp_Zakaz;
        }
        else 
        {
           vZakaz.tmp_Zakaz.ChasF:=vZakaz.tmp_Zakaz.ChasF+TempDescr.Sum[2];
           vZakaz.tmp_Zakaz.Summa:=vZakaz.tmp_Zakaz.Summa+TempDescr.Sum[3];
           vZakaz.update current tmp_Zakaz;
        } //if vZakaz.GetFirst tmp_Zakaz where (( ww_str == tmp_Zakaz.Zakaz )) <>tsok
      } //2
      3: // подразделение 
      { ww_SPodr:=PrintName3(TempDescr.name);
        ch_it_Podr:=TempDescr.Sum[2] ;
        su_it_podr:=TempDescr.Sum[3];

      }
      4:  // Фио
      { ww_Sfio :=PrintName3(TempDescr.name);
        ww_STabn:='';
        if getfirst Tobot where (( TempDescr.CREC == Tobot.Nrec ))=tsok
        { w_person:=ToBot.cut[1];
          if getfirst tmp_persons=0
          {  ww_STabn:=tmp_persons.tabn ;
          }
        }
        if ww_STabn=''
        { if getfirst tmp_persons where (( ww_Sfio == tmp_persons.fio )) =tsok
            ww_STabn:=tmp_persons.tabn ;
        }
      }
      5:
      { 
        ww_SDolg:=PrintName3(TempDescr.name);
        wexrow:=wexrow+1; wexcol:=1;
        wnpp:=wnpp+1;
        MyPutExcelNumber(WNPP,1,10,0,-1,-1); //1
        //MyPutExcel(lpad(' ',wcurlevel*2)+PrintName(TempDescr.name),10,0,-1,-1)
        MyPutExcel(ww_STabn,10,0,-1,-1);//2 ФИО
        MyPutExcel(ww_Sfio ,10,0,-1,-1);//2 ФИО
        MyPutExcel(ww_sPodr,10,0,-1,-1);//3 Подразделение
        MyPutExcel(ww_sDolg,10,0,-1,-1);//4 Должность
        MyPutExcel(ww_sZakaz,10,0,-1,-1);//5 Заказ
        MyPutExcel(chr(39)+ww_sStage,10,0,-1,-1);//6 Этап
        MyPutExcelNumber(round(TempDescr.sum[2],2),1,10,0,-1,-1);//7 Часы
        wexcol:=max_col;
        MyPutExcelNumber(round(TempDescr.sum[3],2),1,10,0,-1,-1);//8 Сумма

      } //  
      6:
      { ww_SVo:=PrintName3(TempDescr.name);
        InsSumVOLev(1,ww_SVo,TempDescr.sum[3]) ;
        InsSumVOLev(2,ww_SVo,TempDescr.sum[3]) ;
        InsSumVOLev(3,ww_SVo,TempDescr.sum[3]) ;
        InsSumVOLev(4,vZakaz.tmp_Zakaz.Zakaz+' '+ww_SVo,TempDescr.sum[3]) ;
        MyLogWrite(false,'ВО='+ww_SVo+', сумма='+String(TempDescr.sum[3],0,2)) ;
        
        if getfirst tmp_vo where (( 0 == tmp_vo.tp and 0 == tmp_vo.wLev and ww_SVo== tmp_vo.Name ))=tsok
        { wExcol:= tmp_vo.Col;
          MyLogWrite(false,'ВО='+ww_SVo+', сумма='+String(TempDescr.sum[3],0,2)+' вывели в '+string(wExcol) ) ;
          MyPutExcelNumber(round(TempDescr.sum[3],2),1,10,0,-1,-1);//8 Сумма
        }
      }
      end;
      case ww_type of
      0:
      { wwkl:=TreeGetNextEx(MainTree);
      }
      1:
      { wwkl:=TreeGetNextEx(MainTree);
        if wwkl
        if  ww_type=1 and TreeLevel(MainTree)<=wLevel_Start wwkl:=false;
      }
      2:
      { wwkl:=TreeGetNext(MainTree);
      }
      else
      { wwkl:=false;
      }
      end;
  }    
  While ( wwkl );
  if wexrow>1 // есть данные
  { 
    // подразделения
    PrintIT04(su_IT_Podr,ch_It_Podr,'Итого по '+ww_SPodr,3) ;
    // заказ
    PrintIT04(su_IT,ch_It,'Итого по '+ww_sZakaz+'/'+ww_sStage,2);
    // период
    PrintIT04(su_IT_P,ch_It_P,'Итого за '+ww_sPeriod,1);
    //HeaderStrCount:=wexrow+2
    //PrintIT04(su_IT_ALL,ch_It_ALL,'Всего по отчету');
    //---------- Итоги по заказам
    wexrow:=wexrow+1 ;
    vZakaz._Loop tmp_Zakaz
    { wExRow++;
      wexCol:=5 ;
      xlMergeCells(wexrow,5, wexrow,7); //Объединяем ячейки
      MyPutExcel('Итого по '+vZakaz.tmp_Zakaz.Zakaz,10,0,-1,-1);//6 Этап
      wexCol++;
      wexCol++;
      MyPutExcelNumber(round(vZakaz.tmp_Zakaz.ChasF,2),1,10,0,-1,-1);//7 Часы
      var ww_su:double=0;
      _Loop tmp_vo where ((  0 == tmp_vo.tp and 0 == tmp_vo.wLev )) ordered by index tmp_vo02
      { ww_su:=0;
        ww_str:=vZakaz.tmp_Zakaz.Zakaz+' '+tmp_vo.name ;
        //по заказам
        if getfirst tmp_vo_Sb where (( 0 == tmp_vo_sb.tp and 4 == tmp_vo_sb.wLev and ww_str == tmp_vo_sb.name ))=tsok 
        { ww_su:=tmp_vo_Sb.Su[1] ;
          //update current tmp_vo_Sb set tmp_vo_Sb.Su[1]:=0;
        }
        MyPutExcelNumber(ww_su,1,10,0,-1,-1) ;   
      } //_Loop tmp_vo where ((  0 == tmp_vo.tp and 0 == tmp_vo.wLev )) ordered by index tmp_vo02
      
      MyPutExcelNumber(round(vZakaz.tmp_Zakaz.Summa,2),1,10,0,-1,-1);//8 Сумма
      MyxlFrameCells(63, 2, 1, 1,wexrow,5,wexrow,max_col);

    } //vZakaz._Loop tmp_Zakaz;
    wexrow:=wexrow+2; wexcol:=2;
    MyPutExcel('Бухгалтер ______________________________' ,10,0,-1,-1);
    xlMergeCells(wexrow,2, wexrow,7); //Объединяем ячейки
    
  } //if wexrow>1
  
  MyxlWriteMatrix(wexrow);
  xlFreeMatrix;
  
  matrixkl:=False;
  //xlSetFontStyle(xlBold, wexrow,1,wexrow,17);
  MyXlEnd;
  StopVisual('',0);
  PrintDoc_04 :=true;
}
