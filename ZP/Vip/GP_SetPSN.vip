#include GP_SetPSN.vih
#include StrFunc.vih
#include AppFuncs.vih
#include CatFunc.vih

Interface GP_SetPSN;

var
  __sTbNmb:   string;
  __cAppoint: comp;
  __sFio:     string;
  iStrFunc:   StringFunctions;
  iAppFunc:   AppointmentsFunctions;
  iCatFunc:   CatalogsFunctions;

create view
from
  Persons
, Appointments
where
((
    __sTbNmb       == Persons.StrTabN (noindex)
and __cAppoint     == Appointments.nRec
));

function boLocate(_sTbNmb, _sFIO: string): boolean;
var
  sFIO: string = '';
{
  result := false;
  set __sTbNmb := _sTbNmb;
  if isValid(#Persons)
    _loop Persons
    {
      sFIO := Persons.FIO;
      if iStrFunc.GetFioIn(sFIO)
        if ( trim(_sFIO) = sFIO or trim(_sFIO) = Persons.FIO) 
        {
          result := true;
          exit;
        }
    }
}

function sGetDepartCode(_sOnDate: string): string;
var
  dOnDate: date = 0;
{
  result := '';
  dOnDate:= StrToDate(To_Char(Last_Day(StrToDate('01.'+_sOnDate, 'DD.MM.YY')))+'.'+_sOnDate, 'DD.MM.YY');
  set __cAppoint := iAppFunc.GetAppNrec_OnDate(Persons.nRec, dOnDate);
  if isValid(#Appointments)
    result := SubStr(iCatFunc.GetCatalogsCode(Appointments.Department), 1, 3);
}

end.