#include AttrTablePick.vih

#component "Z_KATPODR"
#doc
Каталог подразделения, Добавления подписантов для документов СКУДа
#end
Alter Interface KATPODR
var
  cAttr_SCUD_RUK:comp;//подписант за руководителя
  cAttr_SCUD_ZGD:comp;//подписант за ЗГД(фунец.руководителя)
  cAttr_SCUD_ISP:comp;//исполнитель по умолчанию
  oAttrTablePick:AttrTablePick;
//-----------------
// Для множественного задания подписантов
table struct tmp_podp
( Nrec:comp
 ,NPP :word
 ,Name:string
)
with index
(  tmp_podp01 = NPP + Name
  ,tmp_podp02 = Nrec
);

Create View vKatPodr
as select AttrVal_Podp1.Nrec
from
 AttrVal AttrVal_Podp1
,tmp_podp(tmp_podp01)
,tmp_podp tmp_podp_fnd(tmp_podp01)
, KatPodr PodrCheck
where ((
     coKatPodr      == AttrVal_Podp1.wTable
and  cAttr_SCUD_RUK == AttrVal_Podp1.cAttrNam
and  KatPodr.Nrec   == AttrVal_Podp1.cRec
));

//---------------------------
// Заполнить таблицу с подписями
//---------------------------
Procedure Fill_Tmp_podp;
var _wNpp:word;
{ delete all from tmp_podp;
  insert into tmp_podp  set
     tmp_podp.Nrec:= coGetAttrID(coKatPodr,KatPodr.NRec,cAttr_SCUD_RUK)
    ,tmp_podp.Name:= sGetAttrID(coKatPodr,KatPodr.NRec,cAttr_SCUD_RUK)
    ,tmp_podp.NPP:=1;
  _wNpp:=1;
  if getfirst AttrVal_Podp1<>tsok then exit;
  var hfile : longint;
  var sTmp  : string;
  hfile := CreateFileHandle('');
  if not File_OpenMemo(AttrVal_Podp1.VLVAR,hfile)
  { File_Close(hfile);
    exit;
  }
  File_Seek(hfile,0);
  while not File_Eof(hfile)
  { _wNpp++;
    File_ReadLn(sTmp,hfile);
    tmp_Podp.Nrec:=comp(substr(sTmp,1,pos(';',sTmp)-1));
    tmp_Podp.Name:=substr(sTmp,pos(';',sTmp)+1,200);
    tmp_Podp.NPP :=_wNpp;
    insert current tmp_Podp;
  }
  File_Close(hfile);
} //Procedure Fill_Tmp_podp;

//===============================================================
// сохранить подписантов
//===============================================================
Procedure Store_Tmp_podp;
{ var hfile : longint=0;
  var sTmp  : string='';
  var _wNpp:word=0;
  var _boExist:boolean=false;
  UpdateTable;
  _boExist:=(getfirst tmp_podp where (( 0 << tmp_podp.nrec )) =tsok);
  if _boExist
  { if getfirst tmp_podp=tsok
    { coSetAttrID(coKatpodr, KatPodr.Nrec , cAttr_SCUD_RUK, tmp_Podp.Nrec,tmp_Podp.Name);
    }
  }
  else // если нет, то очистим, но дальше еще нужно очистить мемо.
  { coSetAttrID(coKatpodr, KatPodr.Nrec , cAttr_SCUD_RUK, 0,'');
  }
  if Getfirst AttrVal_Podp1<>tsok
  { if _boExist
    { ClearBuffer(#AttrVal_Podp1);
      AttrVal_Podp1.wTable   :=coKatPodr     ;
      AttrVal_Podp1.cAttrNam :=cAttr_SCUD_RUK;
      AttrVal_Podp1.cRec     :=KatPodr.Nrec  ;
      insert current AttrVal_Podp1;
    }
    else Exit;//нет и нечего создавать
  }
  // даже если нет, нужно почистить мемо.
  hfile := CreateFileHandle('');
  if not File_OpenMemo(AttrVal_Podp1.VLVAR,hfile)
  { File_Close(hfile);
    exit;
  }
  File_Seek(hfile,0);
  File_Truncate(hfile);

  _loop tmp_Podp
  { if tmp_Podp.Nrec=0 continue;
    _wnpp++;
    if _wnpp=1
    { //AttrVal_Podp1.vComp:=tmp_Podp.Nrec;
      //AttrVal_Podp1.vString:=tmp_Podp.Name;
    }
    else
    { stmp:=string(tmp_Podp.Nrec,0,0)+';'+tmp_Podp.Name;
      File_WriteLn(sTmp,hfile);
    }
  }
  File_Close(hfile);
  update current AttrVal_Podp1;
} //Procedure StoreTmp_podp;


//*****************************************************
// Визуальные элементы
//*****************************************************
//------------------------------------------------------------------------------
// Задание подписантов
//------------------------------------------------------------------------------
window wGetPodp 'Заполните подписантов';
Show at (,,40,15);
Browse brGetPodp (,,sci1378Esc);
Table tmp_Podp;
Fields
  tmp_Podp.NPP 'п/п' : [5], NoProtect,NoPickButton,NoDel;
  tmp_Podp.Name 'Наименование' :[40],Protect,PickButton,NoDel;
end; //brGetGr
HandleEVent
cmInit:
{ Fill_Tmp_Podp;
}
cmDone:
{ Store_Tmp_Podp;
}
end;
end; //window wGetPodp


//'Z_KATPODR::KATPODR.WKATPODR.BASICINFOSCREEN.GRAFIKSTR'
ExtendFormats BasicInfoScreen;
