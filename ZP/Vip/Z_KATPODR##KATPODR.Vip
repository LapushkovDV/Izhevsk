                                                       Исп-ль .@@@@@@@@@@@@@@@




    >>
    end; // screen BasicInfoScreen

HandleEvent
cmValue66:
 {
   if (RunInterface('GP_ZP::PODRREFCOMPLEX', KatPodr.Nrec) <> cmCancel) then
   {
     Message('Ошибка открытия интерфейса привязки подразделений к комплексам'#13 +
              'RunInterface(GP_ZP::PodrRefComplex, ' + KatPodr.nRec + ')', Error);
   }
 }
End; //HandleEvent

end; //window wKatPodr


 //---------------------------------
 Procedure MyInit;
 //---------------------------------
 { cAttr_SCUD_RUK:=ExtAttr_CreateComp  (coKatpodr,'СКУД. Должность сотрудника c правом подписи за руководителя',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
   cAttr_SCUD_ZGD:=ExtAttr_CreateComp  (coKatpodr,'СКУД. Должность сотрудника с правом подписи за функц.руководителя',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
   cAttr_SCUD_ISP:=ExtAttr_CreateComp  (coKatpodr,'СКУД. Должность исполнителя по умолчанию',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
 }

//*******************************************
TableEvent Table tmp_Podp;
cmSetDefault:
{ Clearbuffer(#tmp_Podp);
  tmp_Podp.NPP:=1;
  if getlast tmp_podp_fnd=tsok
  { tmp_Podp.NPP:=tmp_podp_fnd.Npp+1;
  }
}
cmInsertRecord:
{ Insert current tmp_Podp;
}
cmDeleteRecord:
{ if message('Удалить подписанта?',YesNo)=cmYes
    delete current tmp_Podp;
}
cmUpdateRecord:
{ Update current tmp_Podp;
}
end;//TableEvent Table tmp_Podp

TableEvent
  Table KatPodr;
cmInsertRecord:
{
  if (getFirst FastFirstRow PodrCheck where ((KatPodr.Kod == PodrCheck.Kod)) = tsOk) then
  {
    Message(''#3'Структурное подразделение с таким кодом уже существует.'#13#3+
            'Отредактируйте код.', Warning + Ok);
    SelectField(#KatPodr.Kod);
    Abort;
    Exit;
  }
  else
  {
    case inherited :: handleEvent (cmInsertRecord) of
      heAbort : {Abort; Exit;}
      heStop  : {Stop;  Exit;}
    end;
  }
}
cmUpdateRecord:
{
  if (getFirst FastFirstRow PodrCheck where ((KatPodr.Kod == PodrCheck.Kod)) = tsOk) then
  {
    if (KatPodr.nRec <> PodrCheck.nRec) then
    {
      Message(''#3'Структурное подразделение с таким кодом уже существует.'#13#3+
            'Отредактируйте код.', Warning + Ok);
      SelectField(#KatPodr.Kod);
      Abort;
      Exit;
    }
  }
  case inherited :: handleEvent (cmUpdateRecord) of
    heAbort : {Abort; Exit;}
    heStop  : {Stop;  Exit;}
  end;
}
End;

 //---------------------------------
 HandleEvent
 //---------------------------------
 cmInit:
 { MyInit;
   case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
   end;


 } //cmInit:
 //---------------------------------
 cmPick:
 {  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
    end;
    case CurField of
    #Podp_Ruk,#Podp_ZGD,#Podp_ISP:
    {
      if (IsNew) SetModified(true);
      if (not UpdateTable) exit;
    }
    end;


    case CurField of
    //-----------------------
    #tmp_podp.Name:
    { var _cRec:comp;
      _cRec:=tmp_podp.nrec;
      if (RunInterface(GP_PickStaffStruct,cgiPick,_cRec,tmp_podp.Name) = cmDefault)
        if (_cRec<>tmp_podp.nrec)
        { set tmp_podp.nrec:=_cRec;
        }
    }
    //-----------------------
    #Podp_Ruk:{
      //if (oAttrTablePick.PickValue(coKatPodr, cAttr_SCUD_RUK, KatPodr.NRec)) set Podp_Ruk;
      RunWindowModal(wGetPodp);
    }
    //-----------------------
    #Podp_ZGD:{
      if (oAttrTablePick.PickValue(coKatPodr, cAttr_SCUD_ZGD, KatPodr.NRec)) {
        set Podp_ZGD;
      }
    }
    //-----------------------
    #Podp_ISP:{
      if (oAttrTablePick.PickValue(coKatPodr, cAttr_SCUD_ISP, KatPodr.NRec)) {
        set Podp_ISP;
      }
    }
    end;
 } //cmPick

 end;
end.
