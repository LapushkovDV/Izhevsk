#include userreport.vih
#include adrFunc.vih
#include CatFunc.vih

Interface EM_Army 'Параметры печати справок' gray
Show at (,,55,9);

Create View t1

var
  ICatFunc      : CatalogsFunctions;
  _sDepartment  : string;
  mDept         : LongInt;
  _wType        : word = 4;
  _n            : LongInt = 0;
  _wGender      : word = 0;
  _wMil         : word = 0;
  _wDate        : word = 1;
  _descr        : string = sGetTune('User.Descr');
  _log          : string = 'army.log';
as select
  1
from EM_UniDic, Em_UniDoc_head Em_UniDoc;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  _sDepartment, protect, pickbutton;
  _wGender                 : [List   0 'Все'
                                   , 1 'М'
                                   , 2 'Ж'], Protect;
  _wMil                    : [List   0 'Все'
                                   , 1 'Военнообязанный'
                                   , 2 'Военнослужащий'
                                   , 3 'Невоеннообязанный'
                                   , 4 'Подлежит призыву'], Protect;
 buttons
    cmGo, ,, 'Продолжить' ,,;
    <<

    По подразделению     .@@@@@@@@@@@@@@@@@@@@@
    `Пол       `         .@@@@@@@@@@@@@@@@@@@@@
    `Военнообязанность`  .@@@@@@@@@@@@@@@@@@@@@

    <.Продолжить.>

    >>
end;

Procedure MyLog(_str: string);
{
  LogStrToFile(_log,_str);
}

Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  MyLog('sql: ' + add_query_str);
}

Procedure UpdateFiltersState; //by Ermolov K.
{
  var SelCnt: LongInt;
  var cTemp: Comp;
  _sDepartment := '';
  SelCnt := GetMarkerCount(mDept);
  if SelCnt > 0 then
    if (SelCnt = 1) and GetMarker(mDept, 0, cTemp) then
      _sDepartment := ICatFunc.GetCatalogsName(cTemp);
    else
      _sDepartment := 'Выбрано подразделений: ' + String(SelCnt);
  ReReadRecord;
}

Procedure InsPicked();
{
  _descr := sGetTune('User.Descr');

  var _i : word = 0;

  while 1 = 1
  {
    var _cRec : comp = 0h;
    GetMarker(mDept, _i, _cRec);

    ClearBuffer(#Em_UniDic);
      Em_UniDic.nRec          := 0h;
      Em_UniDic.wType         := _wType;
      Em_UniDic.AddString[1]  := _descr;
      Em_UniDic.sName         := '4 Days';
      Em_UniDic.AddComp[1]    := _cRec;
      Em_UniDic.AddLongInt[1] := _n;
    Insert Current Em_UniDic;

    _i++;
   if _i >= GetMarkerCount(mDept) then break;
  }
}

Procedure DelPicked(_w : word);
{

  Delete From Em_UniDic where ((      _w       == Em_UniDic.wType
                                  and _descr   == Em_UniDic.AddString[1] (noIndex)
                                  and '4 Days' == Em_UniDic.sName        (noIndex)
                              ));
}

Procedure PrepareList();
{
  var qStr : longint = 0;
  var objQuery : iQuery;

  sqlFreeStr(qStr);

  StartNewVisual(vtRotateVisual, vfTimer, 'Сбор данных о сотрудниках', 0);

  SetVisualHeader('Сбор данных о сотрудниках');

  MysqlAddStr(qStr, ' insert Em_UniDoc_head (   DOCNUMB, addstring[1], wtype                              ');
  MysqlAddStr(qStr, '                    , addstring[2], addword[1], addstring[3]                         ');
  MysqlAddStr(qStr, '                    , adddate[1], addstring[4]                                       ');
  MysqlAddStr(qStr, '                    , addstring[5], adddate[2]                                       ');
  MysqlAddStr(qStr, '                    , addstring[6], adddate[3]                                       ');
  MysqlAddStr(qStr, ' )                                                                                   ');
  MysqlAddStr(qStr, ' select                                                                              ');
  MysqlAddStr(qStr, '   ''4 Days''                                                                        ');
  MysqlAddStr(qStr, ' , ''' + string(_descr) + '''                                                        ');
  MysqlAddStr(qStr, ' , ' + string(_wType) + '                                                            ');
  MysqlAddStr(qStr, ' , p.fio                                                                             ');
  MysqlAddStr(qStr, ' , d_year(p.borndate)                                                                ');
  MysqlAddStr(qStr, ' , coalesce(mc.name, ''-'')                                                          ');
  MysqlAddStr(qStr, ' , p.borndate                                                                        ');
  MysqlAddStr(qStr, ' , coalesce(catv.code, ''-'')                                                        ');
  MysqlAddStr(qStr, ' , coalesce(post.name, ''-'')                                                        ');
  MysqlAddStr(qStr, ' , coalesce(td.docdate,t6.datedoc )                                                  ');
  MysqlAddStr(qStr, ' , coalesce(td.docnmb,t6.numdoc )                                                    ');
  MysqlAddStr(qStr, ' , coalesce(td.docdate,t6.datedoc )                                                  ');
  MysqlAddStr(qStr, ' from persons p                                                                      ');
  MysqlAddStr(qStr, ' inner join em_unidic ud on 4 = ud.wtype and ''4 Days'' = ud.sname                   ');
  MysqlAddStr(qStr, '                         and ''' + string(_descr) + ''' = ud.addstring[1]            ');
  MysqlAddStr(qStr, ' left join conscription cn on p.nrec = cn.person                                     ');
  MysqlAddStr(qStr, ' left join catalogs mc on cn.milrank = mc.nrec                                       ');
  MysqlAddStr(qStr, ' left join catalogs catv on cn.vus = catv.nrec                                       ');
  MysqlAddStr(qStr, ' left join catalogs catp on p.department = catp.nrec                                 ');
  MysqlAddStr(qStr, ' left join appointments app on p.appointcur = app.nrec                               ');
  MysqlAddStr(qStr, ' left join catalogs post on app.post = post.nrec                                     ');
  MysqlAddStr(qStr, ' outer apply (                                                                       ');
  MysqlAddStr(qStr, '                select top 1                                                         ');
  MysqlAddStr(qStr, '                  titledoc.nrec     as tdoc                                          ');
  MysqlAddStr(qStr, '                from contdoc                                                         ');
  MysqlAddStr(qStr, '                inner join partdoc on contdoc.cpart = partdoc.nrec                   ');
  MysqlAddStr(qStr, '                inner join titledoc on partdoc.cdoc = titledoc.nrec                  ');
  MysqlAddStr(qStr, '                where contdoc.typeoper = 1                                           ');
  MysqlAddStr(qStr, '                      and p.nrec = contdoc.person                                    ');
  MysqlAddStr(qStr, '                order by contdoc.dprik desc                                          ');
  MysqlAddStr(qStr, ' ) t1                                                                                ');
  MysqlAddStr(qStr, ' outer apply (                                                                       ');
  MysqlAddStr(qStr, '                select top 1                                                         ');
  MysqlAddStr(qStr, '                  titledoc.nrec     as tdoc                                          ');
  MysqlAddStr(qStr, '                from contdoc                                                         ');
  MysqlAddStr(qStr, '                inner join partdoc on contdoc.cpart = partdoc.nrec                   ');
  MysqlAddStr(qStr, '                inner join titledoc on partdoc.cdoc = titledoc.nrec                  ');
  MysqlAddStr(qStr, '                where contdoc.typeoper = 5                                           ');
  MysqlAddStr(qStr, '                      and p.nrec = contdoc.person                                    ');
  MysqlAddStr(qStr, '                order by contdoc.dprik asc                                           ');
  MysqlAddStr(qStr, ' ) t5                                                                                ');
  MysqlAddStr(qStr, ' outer apply (                                                                       ');
  MysqlAddStr(qStr, '                select top 1                                                         ');
  MysqlAddStr(qStr, '                APPOINTMENTS.ORDERNMB   as numdoc                                    ');
  MysqlAddStr(qStr, '                ,APPOINTMENTS.ORDERDATE as datedoc                                   ');
  MysqlAddStr(qStr, '                from APPOINTMENTS                                                    ');
  MysqlAddStr(qStr, '                where p.APPOINTFIRST = APPOINTMENTS.nrec                             ');
  MysqlAddStr(qStr, '                order by APPOINTMENTS.ORDERDATE asc                                  ');
  MysqlAddStr(qStr, ' ) t6                                                                                ');
  MysqlAddStr(qStr, ' left join titledoc td on coalescen(t1.tdoc, t5.tdoc, #comp(0h)) = td.nrec   ');
  MysqlAddStr(qStr, ' where p.department = ud.addcomp[1]                                                  ');
  MysqlAddStr(qStr, '       and p.isemployee = ''С''                                                      ');
  MysqlAddStr(qStr, '       and (p.DisDate >= #date(26, 09, 2022) or 0 = p.disdate)                       ');
  if (_wGender = 1) then
    MysqlAddStr(qStr, '     and p.sex = ''М''                                                             ');
  if (_wGender = 2) then
    MysqlAddStr(qStr, '     and p.sex = ''Ж''                                                             ');
  if (_wMil = 1) then
    MysqlAddStr(qStr, '     and cn.consrel = #comp(000A000000039721h)                                     ');
  if (_wMil = 2) then
    MysqlAddStr(qStr, '     and cn.consrel = #comp(000A000000039722h)                                     ');
  if (_wMil = 3) then
    MysqlAddStr(qStr, '     and cn.consrel = #comp(000A00000003AF16h)                                     ');
  if (_wMil = 4) then
    MysqlAddStr(qStr, '     and cn.consrel = #comp(000A000000039723h)                                     ');



  objQuery := queryManager.createQuery(qStr);
  if (objQuery.execute.errorCode != tsOk ) then
  {
    Message('Ошибка поиска данных о сотрудниках (PrepareList) '+ objQuery.errorCode, Error);
  }
  StopVisual;
  sqlFreeStr(qStr);
}

HandleEvent
cmInit:
{
  DelPicked(_wType);

  Delete From Em_UniDoc where ((      _wType   == Em_UniDoc.wType
                                  and _descr   == Em_UniDoc.AddString[1] (noIndex)
                                  and '4 Days' == Em_UniDoc.DOCNUMB        (noIndex)
                              ));
}

cmPick:
{
  case CurField of
    #_sDepartment:
      {
        ClearMarker(mDept);
        DelPicked(_wType);
        RunInterface('Z_STAFFCAT::PickCatalog2', -11, 0, 100, 0);
        mDept := InitMarker('CatalogsMarker', 8, 30, 10);
        UpdateFiltersState;
        InsPicked();
        DoneMarker(mDept, 'CatalogsMarker');
      }
  end;
}

cmDelOnProtect:
{
  case CurField of
    #_sDepartment:
    {
      ClearMarker(mDept);
      UpdateFiltersState;
      DelPicked(_wType);
    }
  end;
}

cmGo:
{
  PrepareList();
  PutCommand(cmClose);
}

end;
End.

