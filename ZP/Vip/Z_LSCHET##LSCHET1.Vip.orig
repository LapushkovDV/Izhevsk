end; //ServicesScreen

tableevent table CurLSchet;
cmExprFieldChanged:
{
  case CurField of
  #vmYear1:
  {
    sSetAttr(coLschet, CURLSCHET.CLSCHET, anY1, ExprFieldValue);
  }
  #vmYear2:
  {
    sSetAttr(coLschet, CURLSCHET.CLSCHET, anY2, ExprFieldValue);
  }
  else
  {
    case Inherited :: HandleEvent (cmExprFieldChanged) of
      heStop : Stop;
      heAbort: Abort;
    end;
  }
  end;
}
end;



