Table Struct Tmp_KlOTpusk
( Vidopl:word
  ,IsRabDn:word
)
with index
( Tmp_KlOTpusk01 = Vidopl
);

//для контроля дубликатов начислений
table struct tmp_dn
( clsch  :comp
 ,vidopl :longint
 ,datan  :date
 ,datok  :date
 ,Znak   :longint
 ,YearN  :longint
 ,MesN   :longint
 ,kolDn  :Double
 ,kolchs :Double
 ,summa28:integer //условия  (Round(SUMVIDOP.SUMMA28)) // Спец поле для Листа
                  //          (fieldName = Fd_Summa28_Uslov),

)
with index
( tmp_dn01 = clsch+vidopl+Znak+YearN+MesN+datan+datok+kolDn+kolchs
);
