#component "Z_RESERV"
#doc
Резерв по отпускам.
Кол-во дней считаем как отношщение количества положеных дней деленное на 12
колво положенных дней = ВА к лицевому "Положено дней отпуска за год"
#end
alter interface RESERV;

  var _log : string = '';
procedure MyLog(_str: string);
{
  exit;
 if _log = '' then _log := GetStringParameter('Files', 'OutputFilesDirectory', 0)+'REZERV_DEBUG_'+Username+'_'+datetostr(cur_date,'YYYYMMDD')+timetostr(cur_time,'HHMMSS')+'.log';
 logstrtofile(_log,_str);
}

handleevent
cmValue2:
{
   inherited::handleevent(cmValue2);
  if wGettUne('NPOEM_OWN.ZP.Z_REZERV_CALDAYSOTPUSK_VA_12') = 1
   {
    mylog('inherited::handleevent(cmValue2); wGettUne(NPOEM_OWN.ZP.Z_REZERV_CALDAYSOTPUSK_VA_12) = 1');
//    if ( bSDZ ) {
       StartNewVisual(vtRotateVisual, vfTimer + vfBreak, 'Пошла родимая', pMarker.Count);
       _loop pMarker where (( comp(0) << pMarker.pNRec )) {
         if (GetFirst mtArxShtrf where (( pMarker.pNrec == mtArxShtrf.NRec )) = tsOk)
          if (GetFirst ArxShtrf = tsOk) {
            mylog('-------');
            mylog('inherited::handleevent(cmValue2); before ArxShtrf.Summa2 = ' + ArxShtrf.Summa2);
              ArxShtrf.Summa2  := Round(ArxShtrf.SumNach * ArxShtrf.KolDn, 2);
             update current ArxShtrf;
            mylog('inherited::handleevent(cmValue2); after ArxShtrf.Summa2 = ' + ArxShtrf.Summa2);
           }
        }
     stopvisual;
//     }
   }
}
end;
end.
