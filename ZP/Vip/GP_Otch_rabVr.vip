#include IDepartmentValidator.obj

Interface Gp_otch_rabVr 'Отчет о потерях рабочего времени' gray dialog;
  show (, , 115, 17);

  const
    stPlanned = 0;
    stActual = 1;
    hkWorking = 1;
    cfDisregardPeriod = 64;
  end;

var DepMarker: TPtr;
var DepartmentValidator: IDepartmentValidator;

table struct KodNeyav
(
Kod:string,
Name:string,
Priznak:integer,
Group:string

)
with index (N01=Priznak);


table struct VremNeyav
(
KodCex:string,
VidPr:string,
Vid:string,
Name:string, 
Prizn:integer,
Group:string,
sovm:integer
)
with index (v01=KodCex+vid+sovm, v02=vid,v03=KodCex+Prizn,v04=VidPr+Prizn,v05=VidPr+Vid,v06=Prizn);


table struct VremPodr
(
KodCex:string
)
with index (v01=KodCex);


table struct NeyavRV
(

strtabn:string,
Kateg:integer,
cexoz:comp,
cex:comp,
Kodcex:string,
VidPr:string,
KodOtd:string,
Dolzhn:string,
datpos:date,
datuv:date,
clstab:comp,
clschet:comp,
sovm:integer,
fio:string,
PlanCh:double,
OtrabCh:double,
PlanDays:double,
PlanCalDays:double,
OtrabDays:double,
OtrabHolid:double,
OtrabSverh:double,
Vid:string, 
Name:string, 
Prizn:integer,            
chasf:double,
koldn:double,
SOVPROC:double,
KoldnPlan:double,
ChasfPlan:double
)
with index(v01=KodCex+Kateg+Vid, v02=Prizn,v03=KodCex+Kateg+Prizn+sovm,v04=KodCex+Vid+Kateg,v05=VidPr+Kateg+Vid,v06=VidPr+Kateg+Prizn,v07=VidPr+Vid+Kateg
,v08=Vid+Kateg,v09=Prizn,v10=Kateg+Prizn,v11=KodCex+prizn+sovm
);

 
create view
var
  FiltrPublic       : string;
  p2                : double;
  Counter,cntmrk,Marker : longint;
  KodCex:string;
  DatNach1,DatNach2:date;
  ExcelPath:string;
  ExcelPath1:string;
  TipOtch:integer;
  NeyavKateg:double;
  NeyavKategPoter:double;
  NeyavCexVyh,NeyavCex:double;
  filtrpodr : string;
  NameFunc          : string;
  k,i: integer;
  cTemp             : Comp; 
  lTemp,iCount : longint;

  DatNachP:date;
  DatEndP:date;
  CalDaysMonth,RabDaysMonth:double;
  ProizvFunc:string;
  isdbf : integer;
  Filepath,flabel : string;

  as
 select
  *
   from KodNeyav
       ,neyavRV
       ,katpodr
       ,NeyavRV NeyavRV1
       ,Persons
       ,Zar_User
       ,DepFunc
       ,DepFunc DepFunc1 
       ,UOwrkTabel
       ,Attrnam
       ,Attrval
       ,Lstab
       ,Catalogs
       ,lschet
       ,MoveLsc
       ,TuneDef
       ,Tuneval
       ,VremPodr
       ,VremNeyav

 Condition ConPodr  = FoundMarker(DepMarker,katpodr.nrec)=true
 Condition ConPfunc = FoundMarker(Marker,KatPodr.cFunc)=true
;

  screen createdScreen;
   notablenavigation;
!    show (, , 160, 5);

    fields
      FiltrPodr('Заданный фильтр по подразделениям',, sci13Esc) :protect, PickButton;
      DatNach1 ('Начало периода'): noProtect;
      NameFunc   ('Производственная функция', hcNoContext): protect,pickbutton;
      DatNach2 ('Окончание периода'): noProtect;

      TipOtch ('Вид Отчета'):[ list 1
                                'Отчет №1. Потери рабочего времени с группировкой по цехам'
                               ,'Отчет №2. Потери рабочего времени с группировкой по производств. функции'
                               ,'Отчет №3. Потери рабочего времени по предприятию'
                               ,'Отчет №4. Отчет о фактически отработанном времени (в часах)'
                               ,'Отчет №5'
                             ] , protect;


      isdbf      : noprotect;
      flabel     : protect,skip;
      Filepath   : Protect,pickbutton;

    buttons
      cmRassch;
      cmButtonOT;

<<

   `По подразделениям` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@   Период                   <. Рассчитать .> <. Настройка  .>   
                                                        Начало:    .@@@@@@@@@@                                       
   `Функция`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@   Окончание: .@@@@@@@@@@   

   `Тип Отчета`        .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@


     [.] Выгрузка в dbf`
    .@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

>>
  end;


function  fNameFunc : string;
{

  if (GetMarkerCount(Marker) = 0)
  {
    Set fNameFunc := 'По всем';
  }
  else
  {

    if GetMarkerCount(Marker)> 1
      set fNameFunc := 'По нескольким функциям <'+ string(GetMarkerCount(Marker))+ '>';
    else
    {
      GetMarker(Marker, 0, cTemp);

      if GetFirst fastfirstrow DepFunc1 where((cTemp == DepFunc1.cFunc)) = tsOk
        set fNameFunc := DepFunc1.cFunc +', '+ DepFunc1.nmFunc;

    }

  }

}

Procedure FormUO;
begin
_loop UOWRKTABEL
{
        if getfirst attrnam where ((16045==attrnam.wtable and 'Тип потери рабочего времени'==attrnam.Name))=tsok
        {
                if getfirst attrval where ((16045==attrval.wtable and   UOWRKTABEL.Nrec==attrval.crec and attrnam.nrec==attrval.cattrnam))=tsok
                {
                 clearbuffer(#KodNeyav);
                 KodNeyav.Kod:=UOWRKTABEL.Num;
                 KodNeyav.name:=UOWRKTABEL.NAME;
                 KodNeyav.Priznak:=attrval.vdouble;

if attrval.vdouble=1 KodNeyav.Group:='Неявки';
if attrval.vdouble=2 KodNeyav.Group:='Потери. Отпуска ежегодные';
if attrval.vdouble=3 KodNeyav.Group:='Потери. Больничные';
if attrval.vdouble=4 KodNeyav.Group:='Потери. Адм. отпуск';
if attrval.vdouble=5 KodNeyav.Group:='Потери. Прочие';




                 insert current KodNeyav;
                }
        }
}
end;


Procedure RaschData;
begin
    StartNewVisual(vtNumericVisual,vfTimer,'Идёт расчет', 1);

Counter:=7;

  if filtrPodr='По всем'
  {
   if ConditionActiveinLeave(tcConpodr,tnkatpodr)=True
        PopConditionForLeave(tcConpodr,tnkatpodr);
  }
  else
  {
   if ConditionActiveinLeave(tcConpodr,tnkatpodr)=False
        PushConditionForLeave(tcConpodr,tnkatpodr);
  }

  if NameFunc='По всем'
  {
   if ConditionActiveinLeave(tcConPfunc,tnkatpodr)=True
        PopConditionForLeave(tcConPfunc,tnkatpodr);
  }
  else
  {
   if ConditionActiveinLeave(tcConPfunc,tnkatpodr)=False
        PushConditionForLeave(tcConPfunc,tnkatpodr);
  }

  _loop katpodr
   {

        if getfirst DEPFUNC where ((katpodr.CFUNC==DEPFUNC.CFUNC))=tsok
        {
        ProizvFunc:=DEPFUNC.NMFUNC;
        }
        else
        {
        ProizvFunc:='Не определена';
        }

       _loop lstab where ((year(datnach1)==lstab.yearn and month(datnach1)==lstab.mesn and katpodr.nrec==lstab.cex))
       {
       nextvisual;
         clearbuffer(#NeyavRV);

         if getfirst lschet where ((lstab.clschet==lschet.nrec))=tsok
         {
                if TipOtch<4
                {
                 if lschet.sovm>0 continue;
                }
                else
                {
                NeyavRV.sovm:=lschet.sovm;
                }
         }


         NeyavRV.strtabn:=lstab.strtabn;
         NeyavRV.Kateg:=lstab.kateg;
        
         if NeyavRV.kateg=0
         {
         NeyavRV.kateg:=-1;
         }

         NeyavRV.cex:=lstab.cex;
         NeyavRV.Kodcex:=substr(katpodr.kod,1,3);
         NeyavRV.KodOtd:=katpodr.kod;
         NeyavRV.VidPr:=ProizvFunc;

        

        if getfirst catalogs where ((lstab.cappoint==catalogs.nrec))=tsok
        {
        NeyavRV.Dolzhn:=catalogs.name;
        }

        if getfirst lschet where ((lstab.clschet==lschet.nrec))=tsok
        {
        NeyavRV.datpos:=lschet.datpos;
        NeyavRV.datuv:=lschet.datuv;
        }

         NeyavRV.clschet:=lstab.clschet;
         NeyavRV.clstab:=lstab.nrec;


                if getfirst persons where ((lstab.tperson==persons.nrec))=tsok
                {
                 NeyavRV.fio:=persons.fio;
                }


            if LoadWorkingTable(LStab.clschet, month(DatNach1), year(DatNach1)) = 0
            {

                  NeyavRV.PlanCh :=     WT_GHBD(hkWorking, 0, 0, stPlanned, datNach1, DatNach2);
                  NeyavRV.OtrabCh :=    WT_GHBD(hkWorking, 0, 0, stActual, datNach1, DatNach2);


                  NeyavRV.OtrabHolid:= WT_GetAbsencesHours(stActual, 'РВ', datNach1, DatNach2)+WT_GetAbsencesHours(stActual, 'РО', datNach1, DatNach2);
                  NeyavRV.OtrabSverh:= WT_GetAbsencesHours(stActual, 'С', datNach1, DatNach2);

                  if neyavRV.datpos>DatNach1 or (neyavRV.datuv<DatNach2 and neyavRV.datuv>date(0,0,0))
                  {
                  DatNachP:=DatNach1;
                  DatEndP:=DatNach2;
                  if month(neyavRV.datpos)=month(DatNach1) and year(neyavRV.datpos)=year(DatNach1) DatNachP:= neyavRV.datpos;
                  if (month(neyavRV.datuv)=month(DatNach2) and year(neyavRV.datuv)=year(DatNach2)) DatEndP:= neyavRV.datuv;

                  NeyavRV.PlanCalDays:=calcdaysbetweendates(DatNachP,DatEndP,false);
!calcdaysbetweendates(cur_date,date(31,05,2018),false)
                  }
                  else
                  {
                  NeyavRV.PlanCalDays:=calcdaysbetweendates(DatNach1,DatNach2,false);

                  }

                  NeyavRV.SOVPROC :=    NeyavRV.SOVPROC+lstab.SOVPROC;

                  NeyavRV.PlanDays :=   WT_GDBD(2,stPlanned, datNach1, DatNach2);
                  NeyavRV.OtrabDays :=  WT_GDBD(2,stActual, datNach1, DatNach2);

                  NeyavRV.Vid:= 'Итог рабочих';
                  NeyavRV.Prizn:=0;
                  insert current NeyavRV;

                 i:=1;
                do
                {
                _loop KodNeyav where ((i==KodNeyav.Priznak))
                        {

                        if KodNeyav.kod='ОЖ' and (NeyavRV.strtabn='002029' or NeyavRV.strtabn='001576') continue; //ларина, киселева Н

                        NeyavRV.Vid:=KodNeyav.Kod;
                        NeyavRV.Name:=KodNeyav.Name;
                        NeyavRV.Prizn:=i;
                        NeyavRV.Chasf:=WT_GetAbsencesHours(stActual, KodNeyav.Kod, datNach1, DatNach2);

                        NeyavRV.KoldnPlan:=WT_GetAbsencesWorkingDays(1,KodNeyav.Kod,DatNach1,DatNach2) ;
                        
                        
                        
                        if KodNeyav.kod='В'
                        {
!                       NeyavRV.ChasfPlan:=esHours(stPlanned, KodNeyav.Kod, datNach1, DatNach2);                        
                        NeyavRV.KoldnPlan:=NeyavRV.PlanCalDays-WT_GDBD(2,stPlanned, datNach1, DatNach2);
                        }
        

                        NeyavRV.Koldn:=WT_GetAbsencesDays(stActual, KodNeyav.Kod, datNach1, DatNach2);

                                if(NeyavRV.Koldn<>0 or NeyavRV.chasf<>0)
                                {
                                insert current NeyavRV;
                                }
                        }
                i++;
                }
                while i<6       


            }


       }
  }


_loop NeyavRV {
        if NeyavRV.Datpos > DatNach2 {
    if getFirst movelsc where ((NeyavRV.clschet == movelsc.clschet and (movelsc.datuv = Sub_Day(NeyavRV.datpos, 1)))) <> tsOK {
      delete current NeyavRV;
      continue;
    }
        }

        if NeyavRV.Datuv < DatNach1 and NeyavRV.Datuv <> date(0, 0, 0) {
          delete current NeyavRV;
    continue;
        }

        if NeyavRV.Datuv <= date(Last_Day(DatNach1), month(DatNach1), year(DatNach1)) and NeyavRV.Datuv <> date(0, 0, 0) {
          update current NeyavRV;
        }
}


//ExcelPath1:='\\dep968-terminal\User_disk\Galaktika\WorkFolder\ERPDB\Nikolai.Plinda\';
   if isdbf=1
        puttabletodbf(#NeyavRv,Filepath+'OtchRabVr.xls',ptfFullTable);


StopVisual('',0);
end;


HandleEvent

cmInit: {
          startNewVisual(vtRotateVisual, vfThread + vfTimer, 'Пожалуйста, подождите...', 100);
          InitWorkingTable;
          TipOtch:=1;

          DatNach1:=date(01,month(cur_date),year(cur_date));
          DatNach2:=date(last_day(cur_date),month(cur_date),year(cur_date));

          if getFirst tunedef where ((15013 == tunedef.nn)) = tsOK {
            if getFirst tuneval where ((tunedef.nrec == tuneval.ctune and (tuneval.obj = 1))) = tsOK {
            DatNach1 := tuneval.dateval;
            DatNach2 := date(15, month(tuneval.dateval), year(tuneval.dateval));
           }
         }
         FormUO;
         stopVisual('', 0);
         FiltrPodr:='По всем';
         DepMarker := InitMarker('', 8, 1, 1);

         Marker := InitMarker('MGetDepFunc', 8, 100, 10);
         NameFunc := fNameFunc();    

         flabel   :='Папка выгрузки'; 
         ClearFieldState(#flabel,sfVisible);
         ClearFieldState(#Filepath,sfVisible)  ;

}

cmPick:
{

  case CurField of

   #NameFunc:
   {
    DoneMarker( Marker, 'MGetDepFunc' );
    if (RunInterface('M_Control::SelDepFn', lTemp, word(2)) <> cmCancel)
    {
     Marker  := InitMarker('MGetDepFunc', 8, 100, 10);
     iCount  := GetMarkerCount( Marker );
     NameFunc := fNameFunc();
    }
   }


   #FiltrPodr:
   {
     if RunInterface('Z_KatPodr::SelectSalaryDepartments', 12, comp(DepMarker),
                        DepartmentValidator, ZeroDate, 0) = cmDefault
     {
      cntmrk:=GetMarkerCount(DepMarker);
       if cntmrk>0 filtrPodr  :='выбрано '+DoubleToStr(cntmrk,'666 666 667')+' подразд.'
          else filtrPodr  :='По всем';
     }
   }

            #filepath        :{
                                // filepath:=getdirname('Выберите папку сохранения dbf');
                                set Filepath := FileNetConnect_FolderDialog(Filepath, 'Выберите папку сохранения dbf');

                                if(filepath <> '')
                                  filepath := filepath+'\';
                                ReScanPanel(curtable);
                              }

  end; // case

  RedrawPanel(#Zar_User);
} // cmPick


cmDelOnProtect:{

                Case curfield of
                 #filtrPodr : {  
                                ClearMarker(DepMarker);
                                filtrPodr  :='По всем';
                              }
                 #NameFunc:
                 {
                  ClearMarker(Marker);
                   NameFunc := fNameFunc();    
                 }

                end;
                ReScanPanel(tnNotable);
               }


  CmCheckField:{
                 case curfield of
                 #isdbf :{
                          if isdbf=1
                          {
                           SetFieldState(#flabel,sfVisible);
                           SetFieldState(#Filepath,sfVisible)  ;
                          }
                          else
                          {
                           ClearFieldState(#flabel,sfVisible);
                           ClearFieldState(#Filepath,sfVisible)  ;
                          }
                         }
                end;
                ReScanpanel(tnNotable);
               } 

 cmButtonOT:
{
runinterface(GP_NastrUOTotrabVR);
delete all from KodNeyav;
FormUO;
}


cmRassch:
{
delete all from NeyavRv;
delete all from VremPodr;
delete all from VremNeyav;
CalDaysMonth:=last_day(DatNach1);

if month(DatNach1)=3 RabDaysMonth:=20;
if month(DatNach1)=4 RabDaysMonth:=21;
if month(DatNach1)=5 RabDaysMonth:=20;
RaschData;

StartNewVisual(vtNumericVisual,vfTimer,'Идёт формирование отчета', 1);

 ExcelPath:=StartPathName+'\xls_ЭМ\staff\';

    if TipOtch<4
    {
    xlCreateExcelWithTemplate(ExcelPath+'OtchRabVr.xlsx',true);
    xlSetCellStringValue(DateToStr(DatNach1, 'month')+' '+DateToStr(DatNach1, 'YYYY года'), 2, 4, 2, 4);
    }
    else
    {
    xlCreateExcelWithTemplate(ExcelPath+'FactOtrabVrW.xlsx',true);
    xlSetCellStringValue(DateToStr(DatNach1, 'month')+' '+DateToStr(DatNach1, 'YYYY года'), 2, 8, 2, 8);
    }
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');






if TipOtch=1 //
{
_loop NeyavRV
{
        if getfirst VremNeyav where ((NeyavRV.KodCex==VremNeyav.KodCex and NeyavRV.Vid==VremNeyav.Vid))<>tsok
        {
        clearbuffer(#VremNeyav);
        VremNeyav.Vid:=NeyavRV.Vid;
        VremNeyav.Name:=NeyavRV.Name;
        VremNeyav.Prizn:=NeyavRV.Prizn;
        VremNeyav.KodCex:=NeyavRV.KodCex;
        VremNeyav.KodCex:=NeyavRV.KodCex;
        insert current VremNeyav;
        }

        if getfirst VremPodr where ((NeyavRV.KodCex==VremPodr.KodCex))<>tsok
        {
        clearbuffer(#VremPodr);
        VremPodr.KodCex:=NeyavRV.KodCex;
        insert current VremPodr;
        }
}

   if isdbf=1
        puttabletodbf(#VremNeyav,Filepath+'VremNeyav.xls',ptfFullTable);

_loop VremPodr
{
        _loop VremNeyav where ((VremPodr.KodCex==VremNeyav.KodCex))
        {
                clearbuffer(#NeyavRv1);
                NeyavRv1.kateg:=0;
                NeyavRv1.KodCex:=VremNeyav.KodCex;
                NeyavRv1.Vid:=VremNeyav.Vid;
                NeyavRv1.Prizn:=VremNeyav.Prizn;

                _loop NeyavRv where ((VremNeyav.KodCex==NeyavRV.KodCex and VremNeyav.Vid==NeyavRV.Vid and 0<<NeyavRv.kateg))
                {
                  NeyavRV1.PlanCh :=    NeyavRV1.PlanCh+NeyavRV.PlanCh;
                  NeyavRV1.OtrabCh :=   NeyavRV1.OtrabCh+NeyavRV1.OtrabCh;
                  NeyavRV1.PlanDays :=  NeyavRV1.PlanDays+NeyavRV.PlanDays;
                  NeyavRV1.PlanCalDays := NeyavRV1.PlanCalDays+ NeyavRV.PlanCalDays;
                  NeyavRV1.OtrabDays := NeyavRV1.OtrabDays+NeyavRV.OtrabDays;
                  NeyavRV1.chasf :=     NeyavRV1.chasf+NeyavRV.chasf;
                  NeyavRV1.koldn :=     NeyavRV1.koldn+NeyavRV.koldn;
                  NeyavRV1.SOVPROC :=   NeyavRV1.Sovproc+NeyavRV.SOVPROC;
                  NeyavRV1.chasfPlan := NeyavRV1.chasfPlan+NeyavRV.chasfPlan;
                  NeyavRV1.koldnPlan := NeyavRV1.koldnPlan+NeyavRV.koldnPlan;

                }
                insert current NeyavRV1;

        }
}

Counter:=6;

_loop VremPodr
{

        _loop VremNeyav where ((VremPodr.KodCex==VremNeyav.KodCex and 0<<VremNeyav.Prizn))
        {
        i:=0;
        nextvisual;
        xlSetCellStringValue(VremNeyav.KodCex, Counter, 1, Counter, 1); 
        xlSetCellStringValue(VremNeyav.Vid, Counter, 2, Counter, 2);    
        xlSetCellStringValue(VremNeyav.Name, Counter, 3, Counter, 3);   

                do
                {
		        NeyavCex:=0;
                        NeyavKateg:=0;

                        _loop NeyavRv where ((VremNeyav.KodCex==NeyavRV.KodCex and VremNeyav.Vid==NeyavRV.Vid and i==NeyavRv.kateg))
                        {
                        NeyavKateg += NeyavRV.Koldn;
                        NeyavCex += NeyavRV.KoldnPlan;
                        }
			
		if NeyavRV.prizn>1
		{
		xlSetCellNumberValue(NeyavCex, Counter, i+4, Counter, i+4);
		xlSetCellNumberValue(NeyavKateg-NeyavCex, Counter+1, i+4, Counter+1, i+4);
		}
		else
		{
                xlSetCellNumberValue(NeyavKateg, Counter, i+4, Counter, i+4);
		}  		                  



                i++;
                }
                while i<8

	if NeyavRV.prizn>1
	{

        xlSetCellStringValue(VremNeyav.Vid+ ' (рабочие)', Counter, 2, Counter, 2);    


        xlSetCellStringValue(VremNeyav.KodCex, Counter+1, 1, Counter+1, 1); 
        xlSetCellStringValue(VremNeyav.Vid+ ' (на выходные)', Counter+1, 2, Counter+1, 2);    
        xlSetCellStringValue(VremNeyav.Name, Counter+1, 3, Counter+1, 3);   
	Counter++;

	}

        Counter++;
        }

       xlSetCellStringValue('ИТОГО ПО ЦЕХУ '+VremPodr.KodCex, Counter, 1, Counter, 1);  
       Counter++;

       xlSetCellStringValue('ВСЕГО НЕЯВОК ', Counter, 2, Counter, 2);   
        NeyavCex:=0;
        i:=0;
                do
                {
                        NeyavKateg:=0;
                        _loop NeyavRv where ((VremNeyav.KodCex==NeyavRV.KodCex and i==NeyavRv.kateg and 0<<NeyavRV.prizn))
                        {
                        NeyavKateg += NeyavRV.Koldn;
                        }
                
                    xlSetCellNumberValue(NeyavKateg, Counter, i+4, Counter, i+4);
                i++;
                }
                while i<8
       Counter++;

       xlSetCellStringValue('Отработано дней ', Counter, 2, Counter, 2);        
        NeyavCex:=0;
        i:=0;
                do
                {
                        NeyavKateg:=0;
                        _loop NeyavRv where ((VremNeyav.KodCex==NeyavRV.KodCex and i==NeyavRv.kateg and 0==NeyavRV.prizn))
                        {
                        NeyavKateg += NeyavRV.OtrabDays;
                        }
                
                    xlSetCellNumberValue(NeyavKateg, Counter, i+4, Counter, i+4);
                i++;
                }
                while i<8
       Counter++;

