#include UserReport.vih

VipInterface UserReport_Gp_otch_rabVr Implements IUserReport;
Interface UserReport_Gp_otch_rabVr;

Procedure Run;
Begin
  runinterfacenomodal(Gp_otch_rabVr);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Сводка о потерях рабочего времени в разрезе подразделений';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'MENUZARP';
    2 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;

End.
