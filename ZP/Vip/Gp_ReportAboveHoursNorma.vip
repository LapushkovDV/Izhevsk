/*************************************************************************************************\
* Наименование: Отчет "Сводка по сверхурочным часам работников с начала года"                     *
* Контур/Модуль: ЗП                                                                               *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2262         |16/04/18|Синяк Е.П.             |НПО Энергомаш                      *
\*************************************************************************************************/

#include IDepartmentValidator.obj

Interface Gp_ReportBySverhNorma;

var DepMarker: TPtr;
var DepartmentValidator: IDepartmentValidator;

 table struct tlschet
 (
   clsch   : comp
  ,fio     : string[150]
  ,strtabn : string[20]
  ,kolmes  : array[1..12] of double
 )
 with index
 (
   in1=clsch
  ,in2=strtabn
 );

  create view
   var pmes   : word;
       pyearn,i,i1 : integer;
       dbeg,dend : date;
       curh : double;
       curcount,countPickPodr : longint;
       yesbrk : boolean;
       FiltrPodr : string;
       Stat    : integer;
       XlRes   : boolean;
       row,cntcol,cntmrk     : longint;

   as select
    * 
   from lschet
       ,lstab
       ,tlschet
       ,persons
    where 
     ((
           lschet.nrec == lstab.clschet
       and lschet.tperson == persons.nrec
       and pyearn      == lstab.yearn
       and pmes        == lstab.mesn
     )) 
   ;

var let_ex  :array [1..14] of string;

Screen param;
  notablenavigation;
  fields

     i1        : noprotect ;
     pyearn    : noprotect ;
     FiltrPodr : protect,pickbutton;

 Buttons
   CmYes,Default;
   CmCancel;
<<

   `По` .@@@ `месяц` .@@@@ `года`


   `Подразделения` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@


    <.Сформировать.>     <.Отмена.>
>>

end;

Procedure MasLet;
{
    let_ex[1]:='A';
    let_ex[2]:='B';
    let_ex[3]:='C';
    let_ex[4]:='D';
    let_ex[5]:='E';
    let_ex[6]:='F';
    let_ex[7]:='G';
    let_ex[8]:='H';
    let_ex[9]:='I';
    let_ex[10]:='J';
    let_ex[11]:='K';
    let_ex[12]:='L';
    let_ex[13]:='M';
    let_ex[14]:='N';
}

  HandleEvent
   CmInit:{
            pyearn:=2018;
            i1:=2;
            FiltrPodr:='По всем';
            MasLet;
            DepMarker := InitMarker('', 8, 1, 1);
          }

   CmYes:{
            mtClear(#tlschet,fmNormal);
            curcount:=RecordsIntable(#lschet);
            yesbrk:=false;


            StartNewVisual(vtIndicatorVisual,vfBreak+vftimer,
                         ''#3'Формирую отчет...ожидайте'#13#3,curcount) ;

           if InitWorkingTable
            _loop lschet
            {
              if FiltrPodr<>'По всем'
                if (not FoundMarker(DepMarker,lschet.cex))
                  continue;

             if not nextvisual
              {
               Message('Формирование отчета было прервано...переформируйте заново');
               yesbrk:=true;
               break;
              }            


             for(i:=1;i<=i1;i++)
             {
              pmes:=i;
              dbeg:=date(1,i,pyearn);
              dend:=Date(last_day(dbeg),i,pyearn);


              if getfirst lstab=tsok
              {
               if LoadWorkingTable(LSchet.Nrec, pmes, pyearn) = 0
               {

                 curh:=WT_GetAbsencesHours(1,'С',dbeg,dend);

                 if curh<>0
                 {
                   if getfirst fastfirstrow tlschet where (( lschet.nrec == tlschet.clsch))<>tsok
                   {
                     ClearBuffer(#tlschet) ;
                     tlschet.clsch     :=lschet.nrec;
                     tlschet.fio       :=persons.fio;
                     tlschet.strtabn   :=lschet.strtabn;
                     tlschet.kolmes[i] :=curh;
                     insert current tlschet;
                   }
                   else
                    update current tlschet set tlschet.kolmes[i]:=curh;
                 }
               }
              }
             }
            }

           if (not yesbrk)
            StopVisual('',0);

            curcount :=Recordsintable(#tlschet);


            XlRes := xlCreateExcel((''), true);
            if (XlRes)
             XlRes := xlIsExcelValid;
            if (not XlRes)
              Message('не иннициализирован excel');

             row:=1;
             xlSetCellStringValue('Отчет по сверхурочным по '+Case(i1;
                                                                    1 : 'Январь ',
                                                                    2 : 'Февраль',
                                                                    3 : 'Март ',
                                                                    4 : 'Апрель ',
                                                                    5 : 'Май ' ,
                                                                    6 : 'Июнь '  ,
                                                                    7 : 'Июль '  ,
                                                                    8 : 'Август '  ,
                                                                    9 : 'Сентябрь ',
                                                                    10 : 'Октябрь ',
                                                                    11 : 'Ноябрь ' ,
                                                                    12 : 'Декабрь '
                                                            )+string(pyearn)+' года',1,2,1,2);
             inc(row);
             inc(row);
             xlSetCellStringValue('Сотрудник',row,1,row,1);
             xlSetColumnWidth(27,row,1,row,1);
             xlSetCellStringValue('Табельный',row,2,row,2);
             xlSetColumnWidth(15,row,2,row,2);
             cntcol:=2;

             for(i:=1;i<=i1;i++)
             {
              cntcol++;
              xlSetCellStringValue(Case(i;
                                                                    1 : 'Январь ',
                                                                    2 : 'Февраль',
                                                                    3 : 'Март ',
                                                                    4 : 'Апрель ',
                                                                    5 : 'Май ' ,
                                                                    6 : 'Июнь '  ,
                                                                    7 : 'Июль '  ,
                                                                    8 : 'Август '  ,
                                                                    9 : 'Сентябрь ',
                                                                    10 : 'Октябрь ',
                                                                    11 : 'Ноябрь ' ,
                                                                    12 : 'Декабрь '
                                         ),row,cntcol,row,cntcol);

             }
              xlSetCellStringValue('ИТОГО',row,cntcol+1,row,cntcol+1);

             xlSetColumnWidth(14,row,3,row,cntcol);
             xlAlignCellsEx(xlLeft,xlCenter,row,3,row,cntcol);
             xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideH or xlInsideV,xlThin,xlContinuous,1,row,1,row+curcount,cntcol+1);
             xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00', row+1,3,row+curcount,cntcol);


             _loop tlschet
             {
              inc(row);
              xlSetCellStringValue(tlschet.fio,row,1,row,1);
              xlSetCellStringValue(chr(39)+tlschet.strtabn,row,2,row,2);
              for(i:=1;i<=i1;i++)
              {
                xlSetCellNumberValue(tlschet.kolmes[i],row,2+i,row,2+i);
              }
              XlSetCellFormula('=СУММ('+let_ex[3]+string(row)+':'+let_ex[i1+2]+string(row)+')',row,i1+3,row,i1+3);  
             }
             xlSetCellStringValue('ИТОГО',row+1,1,row+1,1);
             xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00', 5,1,row+1,i1+2);

            for(i:=1;i<=i1;i++)
            {
             XlSetCellFormula('=СУММ('+let_ex[i+2]+string(4)+':'+let_ex[i+2]+string(row)+')',row+1,i+2,row+1,i+2);
            }
             XlSetCellFormula('=СУММ('+let_ex[i+2]+string(4)+':'+let_ex[i+2]+string(row)+')',row+1,cntcol+1,row+1,cntcol+1);

            xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideH or xlInsideV,xlThin,xlContinuous,1,3,1,row+1,cntcol+1);


             xlKillExcel;


          }

  CmPick: {

           Case curfield of
             #filtrPodr : {
  
                           if RunInterface('SelectSalaryDepartments', 12, comp(DepMarker),
                                               DepartmentValidator, ZeroDate, 0) = cmDefault
                           {
                            cntmrk:=GetMarkerCount(DepMarker);
                             if cntmrk>0 filtrPodr  :='выбрано '+DoubleToStr(cntmrk,'666 666 667')+' подразд.'
                                else filtrPodr  :='По всем';
                           }
                
                         }
            end;
             ReScanPanel(tnNotable);
          }

cmDelOnProtect:{

                Case curfield of
                 #filtrPodr : {  
                                ClearMarker(DepMarker);
                                filtrPodr  :='По всем';
                              }
                end;
                ReScanPanel(tnNotable);
               }

  end;
end.

#include UserReport.vih

VipInterface UserReport_Claim_ReportBySverhNorma Implements IUserReport;

Interface UserReport_Claim_ReportBySverhNorma;

create view;

!-------------------------------------------------------------------------------
// Запуск отчета на выполнение при выборе его из списка отчетов
procedure Run;
begin
  RunInterfaceNoModal('Gp_ReportBySverhNorma');
end;
!-------------------------------------------------------------------------------
// Наименование отчета в списке
function GetReportName: String;
begin
  GetReportName := 'Сводка по сверхурочным часам работников с начала года';
end;
!-------------------------------------------------------------------------------
// Наименования групп, в которые входит отчет
// Группа n+1 делается подчиненной группе n
// В данном случае будет иерархия:
// [+] Группа 1
//     [+] Группа 2
//         Отчет 1
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := '';
  case Level of
    1 : GetGroupName := 'Отчеты по табелям';
  end;
end;
!-------------------------------------------------------------------------------
// Приоритет отчета - сортировка внутри группы выполняется сначала
// по приоритету, а затем по наименованию
function GetPriority : Integer;
begin
  GetPriority := 0;
end;
!-------------------------------------------------------------------------------
// ModuleID модулей, в которых будет виден отчет
// '*' - отчет будет виден в любом модуле
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;
!-------------------------------------------------------------------------------
end.
