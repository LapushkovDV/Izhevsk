/*************************************************************************************************\
* Наименование:  Доработка интерфейса Заработная плата -> Документы -> Лицевые счета ->           *
*                Локальное меню ->  Смежные данные (Alt+C) ->  Закладка <Текущие данные> >        *
*                Выплаты в межпериод,  закладка <Отнесение затрат>                                *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    требуется начинать выбор распределения с номера заказа с последующим             *
*                автоматическим формированием счета бухгалтерского учета.                         *
*                Собирать перед Z_WT##WTCOSTSHARING.vip                                           *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#772          |10/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#3574         |31/10/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#include GetKau.Vih
#include Analytics.vih
#component "Z_MP"


Alter Interface JOBSHEETPARAMETERS;
OverLoad
  procedure Pick(OpenQuickChoice: boolean);
end;
//DEBITANALYTICSSTR
#include GetKau.Var
#include GP_Func_ZP.Var

var wKodAnalitik :word;//код "избранная аналитика"
var pTmp         :comp;
var pAnalytics    :IAnalytics;

//------------------------------------
// Установить параметры по плану
//------------------------------------
Procedure FillPSchKauParam;
var ii:word;
{ PSchKauParam.Schet :=DEBITACCOUNT;
  PSchKauParam.SubSch:=DEBITCONTROLACCOUNT;
  For(ii:=1;ii<=6;ii++)
  { PSchKauParam.cKau[ii]:=CA.GetAnalytics.GetKAU(ii);
    PSchKauParam.wTbl[ii]:=CA.GetAnalytics.GetTbl(ii);
  }
}//Procedure FillPSchKauParam;


//------------------------------------
// Установить параметры по плану
//------------------------------------
Procedure FillFromPSchKauParam;
var ii:word;
{
  CA.SetAccount(PSchKauParam.Schet);
  CA.SetControlAccount(PSchKauParam.SubSch);
  For(ii:=1;ii<=6;ii++)
  { pAnalytics.SetKAU(ii,PSchKauParam.cKau[ii]);
    pAnalytics.SetTbl(ii,PSchKauParam.wTbl[ii]);
  }

}//Procedure FillPSchKauParam;

//------------------------------------
// Установить параметры по плану
//------------------------------------
Function SetFieldsByMnPlan(_pMnPlan:comp):boolean;
var ii:word;
{ Result:=false;
  /*
  vSpr.pMnPlan:=_pMnPlan;
  if vSpr.getfirst MnPlan<>tsok exit;

  vSpr.pBuhSchet:=GetBuhschetByMnPlan;
  if vSpr.getfirst BuhSchet<>tsok exit;

  CA.SetAccount(substr(vSpr.BuhSchet.Schet,2,20));
  CA.SetControlAccount(vSpr.BuhSchet.SUBSCH);
  For(ii:=1;ii<=6;ii++)
  { if vSpr.BuhSchet.KODTABLE[ii]=cgKau_Zakaz
      { pAnalytics.SetKAU(ii,vSpr.pMnPlan);
        pAnalytics.SetTbl(ii,vSpr.BuhSchet.KODTABLE[ii]);
      }
  }
  */
  FillPSchKauParam;
  if pGP_Func_ZP.SetFieldsByMnPlan(_pMnPlan,PSchKauParam)
    FillFromPSchKauParam;

  CA.SetAnalytics(pAnalytics);
  Result:=true;
  SetModified(true);
  UpdateTable;
}//Function SetFieldsByMnPlan(_pMnPlan:comp);

//-------------------------------
//проверим субсчет по заказу, если не совпадает поменяем
Procedure Check_Analitic_MnPlan;
var ii:word;
{
  //pAnalytics:=CA.GetAnalytics;
  /*
  for(ii:=1;ii<=6;ii++)
  { if CA.GetAnalytics.GetTbl(ii)=cgKau_Zakaz
    { //проверим  счет заказа
      set vSpr.pMnPlan:=CA.GetAnalytics.GetKAU(ii);
      if vSpr.getfirst MnPlan=tsok
      { vSpr.pBuhSchet:=GetBuhschetByMnPlan;
        if vSpr.getfirst BuhSchet<>tsok exit;
        if DEBITACCOUNT <>substr(vSpr.BuhSchet.Schet,2,20)
        or DEBITCONTROLACCOUNT<>vSpr.BuhSchet.SUBSCH
        { SetFieldsByMnPlan(vSpr.pMnPlan)
        }

      } //if vSpr.getfirst pMnPlan=tsok
    } //if Lschet.Tbld[ii]=cgKau_Zakaz
  } //for(ii:=1;ii<=6;ii++)
  */
  FillPSchKauParam;
  if pGP_Func_ZP.Check_Analitic_MnPlan(PSchKauParam)
  { CA.SetAnalytics(pAnalytics);
    SetModified(true);
    UpdateTable;
  }
} //Procedure Check_Analitic_MnPlan;

  procedure Pick(OpenQuickChoice: boolean);
  {
      var need_Pick:boolean=true;
      case curField of
      //#Schetdeb, #SubSchdeb, #NamKaud:
      #DEBITACCOUNT,#DEBITCONTROLACCOUNT,#DEBITANALYTICSSTR:
      { if curField=#DEBITANALYTICSSTR
        { if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed'
        }
        if DEBITACCOUNT='' or (curField=#DEBITANALYTICSSTR and QuickChoiceName<>'')
        { pTmp:=0;
          if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
          { if  SetFieldsByMnPlan(pTmp)
            { case curField of
              #DEBITACCOUNT, #DEBITCONTROLACCOUNT: need_Pick:=false;
              end;
            }
          }
          else
          { message('Задайте счет');
            SelectField(#DEBITACCOUNT);
          }


        } //if Schetdeb=''

      } //#Schetdeb, #SubSchdeb, #NamKaud
      end; //case curField of
      //----------------------
      if need_Pick
      { Inherited::Pick(OpenQuickChoice);
        Check_Analitic_MnPlan;
      }
      //----------------------

  } //procedure Pick(OpenQuickChoice: boolean);

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
  //------------------------
  cmInit:
  { //"Настройки Галактики \ Управление персоналом \ Расчеты с персоналом \ Избранная аналитика"
    wKodAnalitik:=wGetTune('UP.ZAR.FAVORITEANALYTICS');
    //----------------------
    if  inherited :: handleEvent (cmInit)=heAbort then Abort;
    LoadVipRef(pAnalytics,'Z_Zar::Analytics');
    //----------------------

  }
  cmDone:
  { if not NullVipRef(pAnalytics)
    { FreeVipInterface(pAnalytics)
    }
    if  inherited :: handleEvent (cmDone)=heAbort then Abort;
  }
  //------------------------

  end;

end.
