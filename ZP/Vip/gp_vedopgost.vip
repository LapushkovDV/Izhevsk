/*************************************************************************************************\
* Наименование:  Ведомость оплаты гостиницы                                                       *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#813          |20/03/18 |Ермолов К.Р.             |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih
#include marker.vih

interface gp_vedopgost 'Параметры отчета'
Show at (,,50,9);

table struct otchper // Текущий отчетный период
(
  data: date
)
;

table struct otchet //Данные для отчета
(
  podr: string,
  tabnum: string,
  fio: string,
  summa: decimal(31,15)
)
with index
(
  i1 = podr + tabnum
)
;

table struct tSelPodr // Для фильтра по подразделениям
(
nrec: comp,
kod: string,
name: string
)
with index
(
i1 = kod,
i2 = nrec (unique)
)
;

table struct tSelPers // Для фильтра по сотрудникам
(
nrec: comp,
tabnum: string,
fio: string
)
with index
(
i1 = tabnum,
i2 = nrec (unique)
)
;

create view gp_vedopgost

var
mes, podr, pers: word;
counter, countpers: longint;
god: integer;
excelpath, Filtr_Katpodr, Filtr_Persons, cpodr, pUserName, fio, tabnum: string;
pMarkerpodr, pMarkerPers: IMarker(marker) new;
itog: double;
cpers: comp;

select * from otchper, tSelPodr, tSelPers, otchet;

window wnSelPodr 'Подразделения' doAccept, EscClose;
Show at (5,5,100,25);
Browse brtSelPodr ''
Table tSelPodr;
recMarker=pMarkerPodr {TselPodr.nrec};
Fields
tSelPodr.kod  'Код':[10],Protect,NoDel;
tSelPodr.name 'Наименование подразделения':[100],Protect,NoDel;
end;
end;

window wnSelPers 'Сотрудники' doAccept, EscClose;
Show at (5,5,100,25);
Browse brSelPers ''
Table tSelPers;
recMarker=pMarkerPers {tSelPers.nrec};
Fields
tSelPers.tabnum  'Табельный №':[14],Protect,NoDel;
tSelPers.fio 'ФИО':[100],Protect,NoDel;
end;
end;

screen scr ('Параметры отчета',,sci178EnEscInsPM);
  fields
  mes : [list
      1 'Январь',
      2 'Февраль',
      3 'Март',
      4 'Апрель',
      5 'Май',
      6 'Июнь',
      7 'Июль',
      8 'Август',
      9 'Сентябрь',
      10 'Октябрь',
      11 'Ноябрь',
      12 'Декабрь'], protect;
  god: noprotect, spinbutton [1, 1917, 2117];
  podr: noprotect, noframe;
  Filtr_Katpodr: pickbutton, noprotect;
  pers: noprotect, noframe;
  Filtr_Persons: pickbutton, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Месяц:.@@@@@@@@@@  Год:.@@@@@
    Фильтры по:
    [:] подразделениям`.@@@@@@@@@@@@@@@@@@@@@@@@
    [:] сотрудникам`   .@@@@@@@@@@@@@@@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  pUserName:= UserName();
  Filtr_katpodr:= 'Не установлен';
  Filtr_persons:= 'Не установлен';

  sql
  select dateval
  from tuneval
  where strempty = 'UP.DATOTCH' and obj = 10
  into otchper
  ;

  mes:= month(otchper.data);
  god:= year(otchper.data);

  sql
  select katpodr.nrec, katpodr.kod, katpodr.name
  from katpodr
  inner join zar_user on (upper(zar_user.ownname) = upper(:(pUserName)))
  where length(katpodr.kod) = 3 and (zar_user.podrshare <> '+' or (katpodr.nrec in (select userrights.crecds from userrights where zar_user.ownname = userrights.ownname)))
  into tSelPodr
  ;

  sql
  select persons.nrec, persons.strtabn, persons.fio
  from persons
  inner join katpodr on katpodr.nrec = persons.galdep
  into tSelPers
  ;
}

cmPick:
{
  if curfield = #Filtr_katpodr
  {
    runwindow(wnSelPodr);
  }

  if curfield = #Filtr_persons
  {
    runwindow(wnSelPers);
  }
}

cmCheckField:
{
  if curfield = #podr
  {
    if podr > 0
    {
      runwindow(wnSelPodr);
    }
    else
    {
      Filtr_katpodr:= 'Не установлен';
      pMarkerPodr.Unselectall;

      delete all from tSelPers;

      sql
      select persons.nrec, persons.strtabn, persons.fio
      from persons
      inner join katpodr on katpodr.nrec = persons.galdep
      into tSelPers
      ;
    }
  }

  if curfield = #pers
  {
    if pers > 0
    {
      runwindow(wnSelPers);
    }
    else
    {
      Filtr_persons:= 'Не установлен';
      pMarkerPers.Unselectall;
    }
  }
}

cmGo:
{
  delete all from otchet;

  if podr = 0 and pers = 0
  {
    if mes = month(otchper.data) and god = year(otchper.data)
    {
      sql
      select substring(katpodr.kod,1,3), persons.strtabn, persons.fio, uder.sumud
      from uder
      left join persons on persons.nrec = uder.tperson
      left join katpodr on katpodr.nrec = uder.cexoz
      where uder.vidud = 252
      into otchet
      ;
    }
    else
    {
      sql
      select substring(katpodr.kod,1,3), persons.strtabn, persons.fio, sumvidud.sumud
      from sumvidud
      left join persons on persons.nrec = sumvidud.tperson
      left join katpodr on katpodr.nrec = sumvidud.cexoz
      where sumvidud.vidudp = 252 and mesn = :(mes) and yearn = :(god)
      into otchet
      ;
    }
  }

  if pers = 1
  {
    SubBounds(tbRmtSelPers1);
    AddBounds(tbRmtSelPers2);

    if mes = month(otchper.data) and god = year(otchper.data)
    {
      _loop pMarkerpers
      {
        cpers:= tSelPers.nrec;

        sql
        select substring(katpodr.kod,1,3), persons.strtabn, persons.fio, uder.sumud
        from uder
        left join persons on persons.nrec = uder.tperson
        left join katpodr on katpodr.nrec = uder.cexoz
        where uder.vidud = 252 and persons.nrec = :(cpers)
        into otchet
        ;
      }
    }
    else
    {
      _loop pMarkerpers
      {
        cpers:= tSelPers.nrec;

        sql
        select substring(katpodr.kod,1,3), persons.strtabn, persons.fio, sumvidud.sumud
        from sumvidud
        left join persons on persons.nrec = sumvidud.tperson
        left join katpodr on katpodr.nrec = sumvidud.cexoz
        where sumvidud.vidudp = 252 and mesn = :(mes) and yearn = :(god) and persons.nrec = :(cpers)
        into otchet
        ;
      }
    }

    SubBounds(tbRmtSelPers2);
    AddBounds(tbRmtSelPers1);
  }

  if podr = 1 and pers = 0
  {
    SubBounds(tbRmtSelPodr1);
    AddBounds(tbRmtSelPodr2);

    if mes = month(otchper.data) and god = year(otchper.data)
    {
      _loop pMarkerpodr
      {
        cpodr:= tSelPodr.kod;

        sql
        select substring(katpodr.kod,1,3), persons.strtabn, persons.fio, uder.sumud
        from uder
        left join persons on persons.nrec = uder.tperson
        left join katpodr on katpodr.nrec = uder.cexoz
        where uder.vidud = 252 and substring(katpodr.kod,1,3) = :(cpodr)
        into otchet
        ;
      }
    }
    else
    {
      _loop pMarkerpodr
      {
        cpodr:= tSelPodr.kod;

        sql
        select substring(katpodr.kod,1,3), persons.strtabn, persons.fio, sumvidud.sumud
        from sumvidud
        left join persons on persons.nrec = sumvidud.tperson
        left join katpodr on katpodr.nrec = sumvidud.cexoz
        where sumvidud.vidudp = 252 and mesn = :(mes) and yearn = :(god) and substring(katpodr.kod,1,3) = :(cpodr)
        into otchet
        ;
      }
    }

    SubBounds(tbRmtSelPodr2);
    AddBounds(tbRmtSelPodr1);
  }

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_vedopgost.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  xlsetcellstringvalue('Ведомость оплаты гостиницы г. Химки, улица Бурденко, д. 1б', 1, 1, 1, 1);
  xlsetcellstringvalue('за ' + mes + '.' + god, 2, 1, 2, 1);

  counter:= 3;
  countpers:= 1;
  itog:= 0;

  if getfirst otchet = tsok
  {
    fio:= otchet.fio;
    tabnum:= otchet.tabnum;
  }

  _loop otchet
  {
    counter++;

    if fio = otchet.fio and tabnum = otchet.tabnum
    {
      itog:= itog + otchet.summa;
      xlsetcellstringvalue(countpers, counter, 1, counter, 1);
      xlsetcellstringvalue(otchet.podr, counter, 2, counter, 2);
      xlsetcellstringvalue(otchet.tabnum, counter, 3, counter, 3);
      xlsetcellstringvalue(otchet.fio, counter, 4, counter, 4);
      xlsetcellnumbervalue(otchet.summa, counter, 5, counter, 5);
    }
    else
    {
      countpers++;
      fio:= otchet.fio;
      tabnum:= otchet.tabnum;
      itog:= itog + otchet.summa;
      xlsetcellstringvalue(countpers, counter, 1, counter, 1);
      xlsetcellstringvalue(otchet.podr, counter, 2, counter, 2);
      xlsetcellstringvalue(otchet.tabnum, counter, 3, counter, 3);
      xlsetcellstringvalue(otchet.fio, counter, 4, counter, 4);
      xlsetcellnumbervalue(otchet.summa, counter, 5, counter, 5);
    }
  }

  counter++;
  xlsetfontstyle(1, counter, 1, counter, 5);
  xlmergecells(counter, 1, counter, 4);
  xlAlignCells(-4152, counter, 1, counter, 1);
  xlsetcellstringvalue('Итого по объекту:', counter, 1, counter, 1);
  xlsetcellnumbervalue(itog, counter, 5, counter, 5);

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 3, 1, counter, 5);

  counter++;
  xlsetcellstringvalue('Дата составления регистра ' + cur_date, counter, 1, counter, 1);

  StopVisual('',0);
  xlkillExcel;
}

end;

windowevent wnSelPodr;

cmdefault:
{
  if pMarkerpodr.count = 0
  {
    podr:= 0;
    pers:= 0;
    Filtr_persons:= 'Не установлен';
    Filtr_katpodr:= 'Не установлен';
    pMarkerpers.Unselectall;

    delete all from tSelPers;

    sql
    select persons.nrec, persons.strtabn, persons.fio
    from persons
    inner join katpodr on katpodr.nrec = persons.galdep
    into tSelPers
    ;
  }

  SubBounds(tbRmtSelPodr1);
  AddBounds(tbRmtSelPodr2);

  _loop pMarkerpodr
  {
    if pMarkerpodr.count = 1
    {
      podr:= 1;
      pers:= 0;
      Filtr_katpodr:= tSelPodr.kod + ' ' + tSelpodr.name;
      Filtr_persons:= 'Не установлен';
      cpodr:= tSelPodr.kod;
      pMarkerpers.Unselectall;

      delete all from tSelPers;

      sql
      select persons.nrec, persons.strtabn, persons.fio
      from persons
      inner join katpodr on katpodr.nrec = persons.galdep and substring(katpodr.kod,1,3) = :(cpodr)
      into tSelPers
      ;
    }
  }

  SubBounds(tbRmtSelPodr2);
  AddBounds(tbRmtSelPodr1);

  if pMarkerpodr.count > 1
  {
    podr:= 1;
    pers:= 0;
    Filtr_katpodr:= 'Выбрано ' + pMarkerpodr.count;
    Filtr_persons:= 'Не установлен';
    pMarkerpers.Unselectall;

    delete all from tSelPers;

    SubBounds(tbRmtSelPodr1);
    AddBounds(tbRmtSelPodr2);

    _loop pMarkerpodr
    {
      cpodr:= tSelPodr.kod;

      sql
      select persons.nrec, persons.strtabn, persons.fio
      from persons
      inner join katpodr on katpodr.nrec = persons.galdep and substring(katpodr.kod,1,3) = :(cpodr)
      into tSelPers
      ;
    }

    SubBounds(tbRmtSelPodr2);
    AddBounds(tbRmtSelPodr1);
  }
}

end;

windowevent wnSelPers;

cmDefault:
{
  if pMarkerpers.count = 0
  {
    pers:= 0;
    Filtr_persons:= 'Не установлен';
  }

  SubBounds(tbRmtSelPers1);
  AddBounds(tbRmtSelPers2);

  _loop pMarkerpers
  {
    if pMarkerpers.count = 1
    {
      pers:= 1;
      Filtr_persons:= tSelPers.fio;
    }
  }

  SubBounds(tbRmtSelPers2);
  AddBounds(tbRmtSelPers1);

  if pMarkerpers.count > 1
  {
    pers:= 1;
    Filtr_persons:= 'Выбрано ' + pMarkerpers.count;
  }
}

end;
end.

VipInterface UserReport_vedopgost Implements IUserReport;
Interface UserReport_vedopgost;

Procedure Run;
Begin
  runinterface(gp_vedopgost);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Ведомость оплаты гостиницы';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
