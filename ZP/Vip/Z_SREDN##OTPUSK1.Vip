#component "Z_SREDN"
#doc
Список отпусков
<p>#1191
<p>#2077
#end
Alter Interface OTPUSK1;
//------------------------------------------
// // c 20210822 change name screen  ExtendFormats totFactpuskPERMANENT;
ExtendFormats SCRLEFT_OTPPERIOD;
//------------------------------------------

Create view otpusk1
 var isExt : boolean;
as select
  if(LSCHET.SUMMA27 = 0, 'нет', 'да')
  (fieldname = Summa27Str) //есть ли удержание в банк
;
//----------------------
PANEL totFactpusk
  table Factotpusk;
// c 20210822 change name screen SCREEN totFactpuskPERMANENT ;
  SCREEN SCRLEFT_OTPPERIOD;

/*
#IFDEF _2019_02_13_
//Ошибка: Текущая область ввода перекрывается с TOTPUSKPERMANENT
  show (, 1,, 6.3) fixed_y;
#ELSE
  show (,,,9) fixed_y;
#ENDIF
*/
//  show (,,10,80)
  Fields
      Summa27Str  ('Признак перечисления зарплаты в банк',,) :Protect,NoDel;
<<






                        `Банк`     .@@@@@@@@@@
>>
  end;        // SCREEN totFactpuskPERMANENT
end;//PANEL totFactpusk
//----------------------

  HandleEvent
   cmExtendedDelete:{
                      isExt:=True;
                      inherited::handleEvent(cmExtendedDelete);
                    }

    cmShiftF9:      {
                     inherited::handleEvent(cmShiftF9);
                     {
                      if (isExt=False or (isExt=True and FlagOpl=0) )
                        if coGetTune('NPOEM_OWN.ZP.AlgUpdate') <> 0
                        {
                         if RunInterface( SimpleWayToRunAlgorithm
                       , coGetTune('NPOEM_OWN.ZP.AlgUpdate')
                       , word(2101) // в данном случае не суть...
                       ,FACTOTPUSK.NREC 
                       , comp(0)
                         ) <> cmCancel
                         {}
                        } 
                      isExt:=False;                       
                     }

                    }
   end;                 
end.
