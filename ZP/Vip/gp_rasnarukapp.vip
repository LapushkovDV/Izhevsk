      sql
      select appointments.person, persons.fio, l1.strtabn, katpodr.kod, catalogs.name, perevodtekzakaz.mesn, perevodtekzakaz.yearn, gp_kpi_pers_class.vidopl, gp_kpi_pers_class.fromdate, gp_kpi_pers_class.todate, persons.disdate,
      round(sum(coalesce(perevodtekzakaz2.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz3.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz5.sumper,0)), 2) +
      round(sum(coalesce(perevodtekzakaz11.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz12.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz14.sumper,0)), 2),
      round(sum(perevodtekzakaz8.sumper), 2), round(sum(perevodtekzakaz3.sumper), 2)
      from lschet
      left join appointments on appointments.caddnrec2 = lschet.nrec
      left join gp_kpi_pers_class on gp_kpi_pers_class.clink_app = appointments.nrec
      left join appointments a1 on a1.nrec = gp_kpi_pers_class.cappoint
      left join lschet l1 on l1.nrec = a1.caddnrec2
      left join perevodtekzakaz on perevodtekzakaz.clsch = l1.nrec and perevodtekzakaz.yearn = :(god) and (perevodtekzakaz.mesn = 10 or perevodtekzakaz.mesn = 11 or perevodtekzakaz.mesn = 12)
      left join perevodtekzakaz perevodtekzakaz2 on perevodtekzakaz2.nrec = perevodtekzakaz.nrec and perevodtekzakaz2.vidper = 2
      left join perevodtekzakaz perevodtekzakaz3 on perevodtekzakaz3.nrec = perevodtekzakaz.nrec and perevodtekzakaz3.vidper = 3
      left join perevodtekzakaz perevodtekzakaz5 on perevodtekzakaz5.nrec = perevodtekzakaz.nrec and perevodtekzakaz5.vidper = 5
      left join perevodtekzakaz perevodtekzakaz8 on perevodtekzakaz8.nrec = perevodtekzakaz.nrec and perevodtekzakaz8.vidper = 8
      left join perevodtekzakaz perevodtekzakaz11 on perevodtekzakaz11.nrec = perevodtekzakaz.nrec and perevodtekzakaz11.vidper = 11
      left join perevodtekzakaz perevodtekzakaz12 on perevodtekzakaz12.nrec = perevodtekzakaz.nrec and perevodtekzakaz12.vidper = 12
      left join perevodtekzakaz perevodtekzakaz14 on perevodtekzakaz14.nrec = perevodtekzakaz.nrec and perevodtekzakaz14.vidper = 14
      left join persons on l1.tperson = persons.nrec
      left join katpodr on katpodr.nrec = perevodtekzakaz.cexoz
      left join catalogs on catalogs.nrec = l1.cappoint
      where lschet.nrec = :(cpers)
      and (cast(substring(date2str('%yyyy', gp_kpi_pers_class.todate),1,4) as integer) = perevodtekzakaz.yearn or cast(substring(date2str('%yyyy', gp_kpi_pers_class.todate),1,4) as integer) = 0)
      and ((cast(substring(date2str('%MM', gp_kpi_pers_class.todate),1,2) as word) between 10 and 12) or (cast(substring(date2str('%MM', gp_kpi_pers_class.todate),1,2) as word) = 0))
      and ((cast(substring(date2str('%yyyy', gp_kpi_pers_class.fromdate),1,4) as integer) = perevodtekzakaz.yearn and cast(substring(date2str('%MM', gp_kpi_pers_class.fromdate),1,2) as word) <= 12)
      or cast(substring(date2str('%yyyy', gp_kpi_pers_class.fromdate),1,4) as integer) < perevodtekzakaz.yearn)
      group by appointments.person, persons.fio, l1.strtabn, katpodr.kod, catalogs.name, perevodtekzakaz.mesn, perevodtekzakaz.yearn, gp_kpi_pers_class.vidopl, gp_kpi_pers_class.fromdate, gp_kpi_pers_class.todate, persons.disdate
      into tPerevodtekVodSecr
      ;
    }
    GetOborot(31, 10, 12, god);
  }

  SubBounds(tbRmtSelPers2);
  AddBounds(tbRmtSelPers1);

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_rasnarukapp.xlsm',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  itogzp:= 0;
  itogs1:= 0;
  itogs2:= 0;
  itogs3:= 0;
  itognalog:= 0;
  ptabnum:= '';
  counter:= 2;
  countSheets:= 1;

  xlsetcellstringvalue('Расходы на руководящий аппарат за ' + kvartal + ' квартал ' + god + ' года', 1, 1, 1, 1);

  if getfirst tNachisl = tsok
  {
    ptabnum:= tNachisl.tabnum;
    sFIO:= tNachisl.fio;
    sPost:= tNachisl.post;
    cPersNrec:= tNachisl.persnrec;
    xlsetcellstringvalue(tNachisl.podr, 3, 3, 3, 3);
    xlsetcellstringvalue(tNachisl.tabnum, 3, 1, 3, 1);
    xlsetcellstringvalue(tNachisl.fio, 3, 2, 3, 2);
  }

  _loop tNachisl
  {
    counter++;

    if ptabnum = tNachisl.tabnum
    {
      itogzp:= itogzp + tNachisl.summa;

      if counter <> 3
      {
        xlmergecells(counter, 1, counter, 2);
      }

      xlsetcellstringvalue(tNachisl.podr, counter, 3, counter, 3);
      xlsetcellstringvalue(tNachisl.mes, counter, 4, counter, 4);
      xlsetcellNumberValue(round(tNachisl.summa/1000, 2), counter, 5, counter, 5);
      xlsetcellnumbervalue(0, counter, 6, counter, 6);
      xlsetcellnumbervalue(0, counter, 7, counter, 7);
      xlsetcellnumbervalue(0, counter, 8, counter, 8);

      _loop tPerevodtek where ((tNachisl.tabnum == tPerevodtek.tabnum and tNachisl.mes == tPerevodtek.mes and tNachisl.podr == tPerevodtek.podr))
      {
        itogs1:= itogs1 + tPerevodtek.s1;
        itogs2:= itogs2 + tPerevodtek.s2;
        itogs3:= itogs3 + tPerevodtek.s3;
        itognalog:= itogs1 + itogs2;

        xlsetcellNumberValue(round(tPerevodtek.s1/1000, 2), counter, 6, counter, 6);
        xlsetcellNumberValue(round(tPerevodtek.s2/1000, 2), counter, 7, counter, 7);
        xlsetcellNumberValue(round((tPerevodtek.s1 + tPerevodtek.s2)/1000, 2), counter, 8, counter, 8);
      }

      ZpSecr:= 0; ZpVod:= 0; NalogSecr:= 0; NalogVod:= 0; s1Secr:= 0; s2Secr:= 0; s1Vod:= 0; s2Vod:= 0;

      _loop tNachislVodSecr where ((tNachisl.persnrec == tNachislVodSecr.zgdnrec and 10002 == tNachislVodSecr.tip))
      {
        if (month(tNachislVodSecr.fromdate) > tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) >= tNachislVodSecr.year) delete current tNachislVodSecr

        else if (month(tNachislVodSecr.todate) < tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) <= tNachislVodSecr.year and tNachislVodSecr.todate <> 0) delete current tNachislVodSecr

        else if (month(tNachislVodSecr.todate) = tNachislVodSecr.mes and year(tNachislVodSecr.todate) = tNachislVodSecr.year and tNachislVodSecr.todate <> tNachislVodSecr.PersDisDate)
        ZpSecr:= ZpSecr + (tNachislVodSecr.summa/Last_day(tNachislVodSecr.todate)*Day(tNachislVodSecr.todate))

        else if (month(tNachislVodSecr.fromdate) = tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) = tNachislVodSecr.year and tNachislVodSecr.todate = tNachislVodSecr.PersDisDate)
        ZpSecr:= ZpSecr + (tNachislVodSecr.summa/Last_day(tNachislVodSecr.fromdate)*(Last_day(tNachislVodSecr.fromdate)-Day(tNachislVodSecr.fromdate)+1))

        else ZpSecr:= ZpSecr + tNachislVodSecr.summa;
      }

      _loop tPerevodtekVodSecr where ((tNachisl.persnrec == tPerevodtekVodSecr.zgdnrec and 10002 == tPerevodtekVodSecr.tip))
      {
        if (month(tPerevodtekVodSecr.fromdate) > tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) >= tPerevodtekVodSecr.year) delete current tPerevodtekVodSecr

        else if (month(tPerevodtekVodSecr.todate) < tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) <= tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate <> 0) delete current tPerevodtekVodSecr

        else if (month(tPerevodtekVodSecr.todate) = tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.todate) = tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate <> tPerevodtekVodSecr.PersDisDate)
        {
          NalogSecr:= NalogSecr + ((tPerevodtekVodSecr.s1+tPerevodtekVodSecr.s2)/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
          s1Secr:= s1Secr + (tPerevodtekVodSecr.s1/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
          s2Secr:= s2Secr + (tPerevodtekVodSecr.s2/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
        }

        else if (month(tPerevodtekVodSecr.fromdate) = tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) = tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate = tPerevodtekVodSecr.PersDisDate)
        {
          NalogSecr:= NalogSecr + ((tPerevodtekVodSecr.s1+tPerevodtekVodSecr.s2)/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
          s1Secr:= s1Secr + (tPerevodtekVodSecr.s1/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
          s2Secr:= s2Secr + (tPerevodtekVodSecr.s2/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
        }

        else
        {
          NalogSecr:= NalogSecr + tPerevodtekVodSecr.s1 + tPerevodtekVodSecr.s2;
          s1Secr:= s1Secr + tPerevodtekVodSecr.s1;
          s2Secr:= s2Secr + tPerevodtekVodSecr.s2;
        }
      }

      _loop tNachislVodSecr where ((tNachisl.persnrec == tNachislVodSecr.zgdnrec and 10001 == tNachislVodSecr.tip))
      {
        if (month(tNachislVodSecr.fromdate) > tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) >= tNachislVodSecr.year) delete current tNachislVodSecr

        else if (month(tNachislVodSecr.todate) < tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) <= tNachislVodSecr.year and tNachislVodSecr.todate <> 0) delete current tNachislVodSecr

        else if (month(tNachislVodSecr.todate) = tNachislVodSecr.mes and year(tNachislVodSecr.todate) = tNachislVodSecr.year and tNachislVodSecr.todate <> tNachislVodSecr.PersDisDate)
        ZpVod:= ZpVod + (tNachislVodSecr.summa/Last_day(tNachislVodSecr.todate)*Day(tNachislVodSecr.todate))

        else if (month(tNachislVodSecr.fromdate) = tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) = tNachislVodSecr.year and tNachislVodSecr.todate = tNachislVodSecr.PersDisDate)
        ZpVod:= ZpVod + (tNachislVodSecr.summa/Last_day(tNachislVodSecr.fromdate)*(Last_day(tNachislVodSecr.fromdate)-Day(tNachislVodSecr.fromdate)+1))

        else ZpVod:= ZpVod + tNachislVodSecr.summa;
      }

      _loop tPerevodtekVodSecr where ((tNachisl.persnrec == tPerevodtekVodSecr.zgdnrec and 10001 == tPerevodtekVodSecr.tip))
      {
        if (month(tPerevodtekVodSecr.fromdate) > tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) >= tPerevodtekVodSecr.year) delete current tPerevodtekVodSecr

        else if (month(tPerevodtekVodSecr.todate) < tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) <= tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate <> 0) delete current tPerevodtekVodSecr

        else if (month(tPerevodtekVodSecr.todate) = tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.todate) = tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate <> tPerevodtekVodSecr.PersDisDate)
        {
          NalogVod:= NalogVod + ((tPerevodtekVodSecr.s1+tPerevodtekVodSecr.s2)/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
          s1Vod:= s1Vod + (tPerevodtekVodSecr.s1/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
          s2Vod:= s2Vod + (tPerevodtekVodSecr.s2/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
        }

        else if (month(tPerevodtekVodSecr.fromdate) = tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) = tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate = tPerevodtekVodSecr.PersDisDate)
        {
          NalogVod:= NalogVod + ((tPerevodtekVodSecr.s1+tPerevodtekVodSecr.s2)/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
          s1Vod:= s1Vod + (tPerevodtekVodSecr.s1/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
          s2Vod:= s2Vod + (tPerevodtekVodSecr.s2/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
        }

        else
        {
          NalogVod:= NalogVod + tPerevodtekVodSecr.s1 + tPerevodtekVodSecr.s2;
          s1Vod:= s1Vod + tPerevodtekVodSecr.s1;
          s2Vod:= s2Vod + tPerevodtekVodSecr.s2;
        }
      }
    }
    else
    {
      xlsetfontstyle(1, counter, 1, counter, 8);
      xlmergecells(counter, 1, counter, 4);
      xlAlignCells(-4152, counter, 1, counter, 1);
      xlsetcellstringvalue('Итого руководитель: ', counter, 1, counter, 1);
      xlsetcellNumberValue(round(itogzp/1000, 2), counter, 5, counter, 5);
      xlsetcellNumberValue(round(itogs1/1000, 2), counter, 6, counter, 6);
      xlsetcellNumberValue(round(itogs2/1000, 2), counter, 7, counter, 7);
      xlsetcellNumberValue(round(itognalog/1000, 2), counter, 8, counter, 8);

      mes:= 0; VodSecTabnum:= '';

      _loop tNachislVodSecr where ((cPersNrec == tNachislVodSecr.zgdnrec and 10002 == tNachislVodSecr.tip))
      {
        if mes <> tNachislVodSecr.mes or VodSecTabnum <> tNachislVodSecr.tabnum
        {
          counter++;
          xlsetcellstringvalue(tNachislVodSecr.tabnum, counter, 1, counter, 1);
          xlsetcellstringvalue(tNachislVodSecr.fio, counter, 2, counter, 2);
          xlsetcellstringvalue(tNachislVodSecr.podr, counter, 3, counter, 3);
          xlsetcellstringvalue(tNachislVodSecr.mes, counter, 4, counter, 4);
          xlsetcellNumberValue(round(tNachislVodSecr.summa/1000, 2), counter, 5, counter, 5);
          xlsetcellnumbervalue(0, counter, 6, counter, 6);
          xlsetcellnumbervalue(0, counter, 7, counter, 7);
          xlsetcellnumbervalue(0, counter, 8, counter, 8);

          _loop tPerevodtekVodSecr where ((tNachislVodSecr.zgdnrec == tPerevodtekVodSecr.zgdnrec and 10002 == tPerevodtekVodSecr.tip
          and tNachislVodSecr.mes == tPerevodtekVodSecr.mes and tNachislVodSecr.tabnum == tPerevodtekVodSecr.tabnum))
          {
            xlsetcellNumberValue(round(tPerevodtekVodSecr.s1/1000, 2), counter, 6, counter, 6);
            xlsetcellNumberValue(round(tPerevodtekVodSecr.s2/1000, 2), counter, 7, counter, 7);
            xlsetcellNumberValue(round((tPerevodtekVodSecr.s1 + tPerevodtekVodSecr.s2)/1000, 2), counter, 8, counter, 8);
          }
        }

        mes:= tNachislVodSecr.mes;
        VodSecTabnum:= tNachislVodSecr.tabnum;
      }

      counter++;
      xlsetfontstyle(1, counter, 1, counter, 8);
      xlmergecells(counter, 1, counter, 4);
      xlAlignCells(-4152, counter, 1, counter, 1);
      xlsetcellstringvalue('Итого секретари: ', counter, 1, counter, 1);
      xlsetcellNumberValue(round(ZpSecr/1000, 2), counter, 5, counter, 5);
      xlsetcellNumberValue(round(s1Secr/1000, 2), counter, 6, counter, 6);
      xlsetcellNumberValue(round(s2Secr/1000, 2), counter, 7, counter, 7);
      xlsetcellNumberValue(round(NalogSecr/1000, 2), counter, 8, counter, 8);

      mes:= 0; VodSecTabnum:= '';

      _loop tNachislVodSecr where ((cPersNrec == tNachislVodSecr.zgdnrec and 10001 == tNachislVodSecr.tip))
      {
        if mes <> tNachislVodSecr.mes or VodSecTabnum <> tNachislVodSecr.tabnum
        {
          counter++;
          xlsetcellstringvalue(tNachislVodSecr.tabnum, counter, 1, counter, 1);
          xlsetcellstringvalue(tNachislVodSecr.fio, counter, 2, counter, 2);
          xlsetcellstringvalue(tNachislVodSecr.podr, counter, 3, counter, 3);
          xlsetcellstringvalue(tNachislVodSecr.mes, counter, 4, counter, 4);
          xlsetcellNumberValue(round(tNachislVodSecr.summa/1000, 2), counter, 5, counter, 5);
          xlsetcellnumbervalue(0, counter, 6, counter, 6);
          xlsetcellnumbervalue(0, counter, 7, counter, 7);
          xlsetcellnumbervalue(0, counter, 8, counter, 8);

          _loop tPerevodtekVodSecr where ((tNachislVodSecr.zgdnrec == tPerevodtekVodSecr.zgdnrec and 10001 == tPerevodtekVodSecr.tip
          and tNachislVodSecr.mes == tPerevodtekVodSecr.mes and tNachislVodSecr.tabnum == tPerevodtekVodSecr.tabnum))
          {
            xlsetcellNumberValue(round(tPerevodtekVodSecr.s1/1000, 2), counter, 6, counter, 6);
            xlsetcellNumberValue(round(tPerevodtekVodSecr.s2/1000, 2), counter, 7, counter, 7);
            xlsetcellNumberValue(round((tPerevodtekVodSecr.s1 + tPerevodtekVodSecr.s2)/1000, 2), counter, 8, counter, 8);
          }
        }

        mes:= tNachislVodSecr.mes;
        VodSecTabnum:= tNachislVodSecr.tabnum;
      }

      counter++;
      xlsetfontstyle(1, counter, 1, counter, 8);
      xlmergecells(counter, 1, counter, 4);
      xlAlignCells(-4152, counter, 1, counter, 1);
      xlsetcellstringvalue('Итого водители: ', counter, 1, counter, 1);
      xlsetcellNumberValue(round(ZpVod/1000, 2), counter, 5, counter, 5);
      xlsetcellNumberValue(round(s1Vod/1000, 2), counter, 6, counter, 6);
      xlsetcellNumberValue(round(s2Vod/1000, 2), counter, 7, counter, 7);
      xlsetcellNumberValue(round(NalogVod/1000, 2), counter, 8, counter, 8);

      xlAddSheet;
      xlRunMacro('PrintParam');
      xlSetSheetName(countSheets, sFIO);
      xlGetUsedRange(1, 1, 36, 4);
      xlSetColumnWidth(21, 1, 1, 1, 1);
      xlSetColumnWidth(35, 1, 2, 1, 2);
      xlSetRowHeight(20, 2, 1, 2, 1);
      xlSetFontStyle(1, 2, 2, 2, 2);
      xlSetFontSize(12, 2, 2, 2, 2);
      xlSetColumnWidth(21, 1, 3, 1, 3);
      xlSetRowHeight(33, 3, 1, 3, 1);
      xlSetFontStyle(1, 4, 1, 4, 4);
      xlWrapText(3, 2, 3, 2);
      xlSetColumnWidth(21, 1, 4, 1, 4);
      xlAlignCellsEx(-4108, -4108, 1, 1, 4, 4);
      xlMergeCells(1, 1, 1, 4);
      xlMergeCells(2, 2, 2, 4);
      xlMergeCells(3, 2, 3, 4);
      xlMergeCells(5, 1, 13, 1);
      xlAlignCellsEx(-4131, -4160, 5, 1, 5, 1);
      xlMergeCells(15, 1, 15, 4);
      xlSetFontStyle(1, 5, 1, 13, 1);
      xlSetFontStyle(1, 14, 1, 15, 4);
      xlAlignCells(-4152, 14, 1, 14, 1);
      xlMergeCells(18, 1, 18, 4);
      xlSetFontStyle(1, 17, 1, 18, 4);
      xlAlignCells(-4152, 17, 1, 17, 1);
      xlMergeCells(28, 1, 28, 4);
      xlSetFontStyle(1, 27, 1, 28, 4);
      xlAlignCells(-4152, 27, 1, 27, 1);
      xlMergeCells(31, 1, 31, 4);
      xlSetFontStyle(1, 30, 1, 31, 4);
      xlAlignCells(-4152, 30, 1, 30, 1);
      xlMergeCells(35, 1, 35, 4);
      xlSetFontStyle(1, 34, 1, 37, 4);
      xlAlignCells(-4152, 34, 1, 34, 1);
      xlAlignCells(-4152, 36, 1, 37, 1);
      xlSetFontSize(14, 37, 1, 37, 4);

      xlframecells(1+2+4+8+16+32, 3, 1, 1, 1, 1, 37, 4);

      xlCreateMatrix(37, 4);
      xlStWriteToMatrix(2, 1, 'ФИО');
      xlStWriteToMatrix(3, 1, 'ДОЛЖНОСТЬ');
      xlStWriteToMatrix(4, 1, 'Вид затрат');
      xlStWriteToMatrix(4, 2, 'Статья затрат');
      xlStWriteToMatrix(4, 3, 'Сумма (тыс. руб.)');
      xlStWriteToMatrix(4, 4, 'Примечание');
      xlStWriteToMatrix(5, 1, 'Зарплата');
      xlStWriteToMatrix(5, 2, 'Зарплата');
      xlStWriteToMatrix(5, 4, 'Руководитель');
      xlStWriteToMatrix(6, 2, 'Налоги на ЗП (от ФОТ)');
      xlStWriteToMatrix(7, 2, 'Медицинское страхование ФМС');
      xlStWriteToMatrix(8, 2, 'Зарплата');
      xlStWriteToMatrix(8, 4, 'Водитель');
      xlStWriteToMatrix(9, 2, 'Налоги на ЗП (от ФОТ)');
      xlStWriteToMatrix(10, 2, 'Медицинское страхование ФМС');
      xlStWriteToMatrix(11, 2, 'Зарплата');
      xlStWriteToMatrix(11, 4, 'Секретарь');
      xlStWriteToMatrix(12, 2, 'Налоги на ЗП (от ФОТ)');
      xlStWriteToMatrix(13, 2, 'Медицинское страхование ФМС');
      xlStWriteToMatrix(14, 1, 'ИТОГО:');
      xlStWriteToMatrix(15, 1, 'Профессиональные услуги');
      xlStWriteToMatrix(16, 2, 'Тренинги и семинары');
      xlStWriteToMatrix(17, 1, 'ИТОГО:');
      xlStWriteToMatrix(18, 1, 'Командировки');
      xlStWriteToMatrix(19, 2, 'Командировочные (суточные)');
      xlStWriteToMatrix(20, 2, 'Гостиница (проживание)');
      xlStWriteToMatrix(21, 2, 'Авиаперелеты');
      xlStWriteToMatrix(22, 2, 'Ж/д перевозки');
      xlStWriteToMatrix(23, 2, 'Трансфер');
      xlStWriteToMatrix(24, 2, 'Визовый сбор');
      xlStWriteToMatrix(25, 2, 'Представительские расходы');
      xlStWriteToMatrix(26, 2, 'Страховка');
      xlStWriteToMatrix(27, 1, 'ИТОГО:');
      xlStWriteToMatrix(28, 1, 'Аренда');
      xlStWriteToMatrix(29, 2, 'Аренда жилья');
      xlStWriteToMatrix(30, 1, 'ИТОГО:');
      xlStWriteToMatrix(31, 1, 'Связь');
      xlStWriteToMatrix(32, 2, 'Интернет (перс.)');
      xlStWriteToMatrix(33, 2, 'Мобильная связь');
      xlStWriteToMatrix(34, 1, 'ИТОГО:');
      xlStWriteToMatrix(35, 1, 'Прочие услуги');
      xlStWriteToMatrix(36, 1, 'ИТОГО:');
      xlStWriteToMatrix(37, 1, 'ВСЕГО:');

      xlStWriteToMatrix(1, 1, kvartal + ' квартал ' + god + ' года');
      xlStWriteToMatrix(2, 2, sFIO);
      xlStWriteToMatrix(3, 2, sPost);
      xlDoWriteToMatrix(5, 3, round(itogzp/1000, 2));
      xlDoWriteToMatrix(6, 3, round(itognalog/1000, 2));
      xlDoWriteToMatrix(7, 3, 0);
      xlDoWriteToMatrix(8, 3, round(ZpVod/1000, 2));
      xlDoWriteToMatrix(9, 3, round(NalogVod/1000, 2));
      xlDoWriteToMatrix(10, 3, 0);
      xlDoWriteToMatrix(11, 3, round(ZpSecr/1000, 2));
      xlDoWriteToMatrix(12, 3, round(NalogSecr/1000, 2));
      xlDoWriteToMatrix(13, 3, 0);

      _loop tOborot where ((cPersNrec == toborot.persnrec))
      {
        case tOborot.analitika of

          'Командировочные (суточные)': xlDoWriteToMatrix(19, 3, round(tOborot.summa/1000, 2));

          'Гостиница (проживание)': xlDoWriteToMatrix(20 , 3, round(tOborot.summa/1000, 2));

          'Авиаперелеты': xlDoWriteToMatrix(21, 3, round(tOborot.summa/1000, 2));

          'Ж/д перевозки': xlDoWriteToMatrix(22, 3, round(tOborot.summa/1000, 2));

          'Трансфер': xlDoWriteToMatrix(23, 3, round(tOborot.summa/1000, 2));

          'Визовый сбор': xlDoWriteToMatrix(24, 3, round(tOborot.summa/1000, 2));

          'Представительские расходы': xlDoWriteToMatrix(25, 3, round(tOborot.summa/1000, 2));

          'Страховка': xlDoWriteToMatrix(26, 3, round(tOborot.summa/1000, 2));

          'Интернет (перс.)': xlDoWriteToMatrix(32, 3, 0);

          'Мобильная связь': xlDoWriteToMatrix(33, 3, round(tOborot.summa/1000, 2));

        end;
      }

      xlWriteMatrixToExcel(1, 1);
      xlFreeMatrix;
      xlSetCellFormula('=СУММ(C5:C13)', 14, 3, 14, 3);
      xlSetCellFormula('=СУММ(C16)', 17, 3, 17, 3);
      xlSetCellFormula('=СУММ(C19:C26)', 27, 3, 27, 3);
      xlSetCellFormula('=СУММ(C29)', 30, 3, 30, 3);
      xlSetCellFormula('=СУММ(C32:C33)', 34, 3, 34, 3);
      xlSetCellFormula('=СУММ(C14;C17;C27;C30;C34;C36)', 37, 3, 37, 3);

      countSheets++;
      xlSetActiveSheet(countSheets);

      itogzp:= tNachisl.summa;
      itogs1:= 0;
      itogs2:= 0;
      itogs3:= 0;
      itognalog:= 0;
      ptabnum:= tNachisl.tabnum;
      sFIO:= tNachisl.fio;
      sPost:= tNachisl.post;
      cPersNrec:= tNachisl.persnrec;
      counter++;

      xlsetcellstringvalue(tNachisl.podr, counter, 3, counter, 3);
      xlsetcellstringvalue(tNachisl.tabnum, counter, 1, counter, 1);
      xlsetcellstringvalue(tNachisl.fio, counter, 2, counter, 2);
      xlsetcellstringvalue(tNachisl.mes, counter, 4, counter, 4);
      xlsetcellNumberValue(round(tNachisl.summa/1000, 2), counter, 5, counter, 5);
      xlsetcellnumbervalue(0, counter, 6, counter, 6);
      xlsetcellnumbervalue(0, counter, 7, counter, 7);
      xlsetcellnumbervalue(0, counter, 8, counter, 8);

      _loop tPerevodtek where ((tNachisl.tabnum == tPerevodtek.tabnum and tNachisl.mes == tPerevodtek.mes and tNachisl.podr == tPerevodtek.podr))
      {
        itogs1:= itogs1 + tPerevodtek.s1;
        itogs2:= itogs2 + tPerevodtek.s2;
        itogs3:= itogs3 + tPerevodtek.s3;
        itognalog:= itogs1 + itogs2;

        xlsetcellNumberValue(round(tPerevodtek.s1/1000, 2), counter, 6, counter, 6);
        xlsetcellNumberValue(round(tPerevodtek.s2/1000, 2), counter, 7, counter, 7);
        xlsetcellNumberValue(round((tPerevodtek.s1 + tPerevodtek.s2)/1000, 2), counter, 8, counter, 8);
      }
    }
  }

  counter++;
  xlsetfontstyle(1, counter, 1, counter, 8);
  xlmergecells(counter, 1, counter, 4);
  xlAlignCells(-4152, counter, 1, counter, 1);
  xlsetcellstringvalue('Итого руководитель: ', counter, 1, counter, 1);
  xlsetcellNumberValue(round(itogzp/1000, 2), counter, 5, counter, 5);
  xlsetcellNumberValue(round(itogs1/1000, 2), counter, 6, counter, 6);
  xlsetcellNumberValue(round(itogs2/1000, 2), counter, 7, counter, 7);
  xlsetcellNumberValue(round(itognalog/1000, 2), counter, 8, counter, 8);

  ZpSecr:= 0; ZpVod:= 0; NalogSecr:= 0; NalogVod:= 0; s1Secr:= 0; s2Secr:= 0; s1Vod:= 0; s2Vod:= 0;

  if getlast tNachisl = tsok
  {
    _loop tNachislVodSecr where ((tNachisl.persnrec == tNachislVodSecr.zgdnrec and 10002 == tNachislVodSecr.tip))
    {
      if (month(tNachislVodSecr.fromdate) > tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) >= tNachislVodSecr.year) delete current tNachislVodSecr

      else if (month(tNachislVodSecr.todate) < tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) <= tNachislVodSecr.year and tNachislVodSecr.todate <> 0) delete current tNachislVodSecr

      else if (month(tNachislVodSecr.todate) = tNachislVodSecr.mes and year(tNachislVodSecr.todate) = tNachislVodSecr.year and tNachislVodSecr.todate <> tNachislVodSecr.PersDisDate)
      ZpSecr:= ZpSecr + (tNachislVodSecr.summa/Last_day(tNachislVodSecr.todate)*Day(tNachislVodSecr.todate))

      else if (month(tNachislVodSecr.fromdate) = tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) = tNachislVodSecr.year and tNachislVodSecr.todate = tNachislVodSecr.PersDisDate)
      ZpSecr:= ZpSecr + (tNachislVodSecr.summa/Last_day(tNachislVodSecr.fromdate)*(Last_day(tNachislVodSecr.fromdate)-Day(tNachislVodSecr.fromdate)+1))

      else ZpSecr:= ZpSecr + tNachislVodSecr.summa;
    }

    _loop tPerevodtekVodSecr where ((tNachisl.persnrec == tPerevodtekVodSecr.zgdnrec and 10002 == tPerevodtekVodSecr.tip))
    {
      if (month(tPerevodtekVodSecr.fromdate) > tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) >= tPerevodtekVodSecr.year) delete current tPerevodtekVodSecr

      else if (month(tPerevodtekVodSecr.todate) < tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) <= tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate <> 0) delete current tPerevodtekVodSecr

      else if (month(tPerevodtekVodSecr.todate) = tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.todate) = tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate <> tPerevodtekVodSecr.PersDisDate)
      {
        NalogSecr:= NalogSecr + ((tPerevodtekVodSecr.s1+tPerevodtekVodSecr.s2)/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
        s1Secr:= s1Secr + (tPerevodtekVodSecr.s1/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
        s2Secr:= s2Secr + (tPerevodtekVodSecr.s2/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
      }

      else if (month(tPerevodtekVodSecr.fromdate) = tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) = tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate = tPerevodtekVodSecr.PersDisDate)
      {
        NalogSecr:= NalogSecr + ((tPerevodtekVodSecr.s1+tPerevodtekVodSecr.s2)/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
        s1Secr:= s1Secr + (tPerevodtekVodSecr.s1/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
        s2Secr:= s2Secr + (tPerevodtekVodSecr.s2/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
      }

      else
      {
        NalogSecr:= NalogSecr + tPerevodtekVodSecr.s1 + tPerevodtekVodSecr.s2;
        s1Secr:= s1Secr + tPerevodtekVodSecr.s1;
        s2Secr:= s2Secr + tPerevodtekVodSecr.s2;
      }
    }

    _loop tNachislVodSecr where ((tNachisl.persnrec == tNachislVodSecr.zgdnrec and 10001 == tNachislVodSecr.tip))
    {
      if (month(tNachislVodSecr.fromdate) > tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) >= tNachislVodSecr.year) delete current tNachislVodSecr

      else if (month(tNachislVodSecr.todate) < tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) <= tNachislVodSecr.year and tNachislVodSecr.todate <> 0) delete current tNachislVodSecr

      else if (month(tNachislVodSecr.todate) = tNachislVodSecr.mes and year(tNachislVodSecr.todate) = tNachislVodSecr.year and tNachislVodSecr.todate <> tNachislVodSecr.PersDisDate)
      ZpVod:= ZpVod + (tNachislVodSecr.summa/Last_day(tNachislVodSecr.todate)*Day(tNachislVodSecr.todate))

      else if (month(tNachislVodSecr.fromdate) = tNachislVodSecr.mes and year(tNachislVodSecr.fromdate) = tNachislVodSecr.year and tNachislVodSecr.todate = tNachislVodSecr.PersDisDate)
      ZpVod:= ZpVod + (tNachislVodSecr.summa/Last_day(tNachislVodSecr.fromdate)*(Last_day(tNachislVodSecr.fromdate)-Day(tNachislVodSecr.fromdate)+1))

      else ZpVod:= ZpVod + tNachislVodSecr.summa;
    }

    _loop tPerevodtekVodSecr where ((tNachisl.persnrec == tPerevodtekVodSecr.zgdnrec and 10001 == tPerevodtekVodSecr.tip))
    {
      if (month(tPerevodtekVodSecr.fromdate) > tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) >= tPerevodtekVodSecr.year) delete current tPerevodtekVodSecr

      else if (month(tPerevodtekVodSecr.todate) < tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) <= tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate <> 0) delete current tPerevodtekVodSecr

      else if (month(tPerevodtekVodSecr.todate) = tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.todate) = tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate <> tPerevodtekVodSecr.PersDisDate)
      {
        NalogVod:= NalogVod + ((tPerevodtekVodSecr.s1+tPerevodtekVodSecr.s2)/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
        s1Vod:= s1Vod + (tPerevodtekVodSecr.s1/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
        s2Vod:= s2Vod + (tPerevodtekVodSecr.s2/Last_day(tPerevodtekVodSecr.todate)*Day(tPerevodtekVodSecr.todate));
      }

      else if (month(tPerevodtekVodSecr.fromdate) = tPerevodtekVodSecr.mes and year(tPerevodtekVodSecr.fromdate) = tPerevodtekVodSecr.year and tPerevodtekVodSecr.todate = tPerevodtekVodSecr.PersDisDate)
      {
        NalogVod:= NalogVod + ((tPerevodtekVodSecr.s1+tPerevodtekVodSecr.s2)/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
        s1Vod:= s1Vod + (tPerevodtekVodSecr.s1/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
        s2Vod:= s2Vod + (tPerevodtekVodSecr.s2/Last_day(tPerevodtekVodSecr.fromdate)*(Last_day(tPerevodtekVodSecr.fromdate)-Day(tPerevodtekVodSecr.fromdate)+1));
      }

      else
      {
        NalogVod:= NalogVod + tPerevodtekVodSecr.s1 + tPerevodtekVodSecr.s2;
        s1Vod:= s1Vod + tPerevodtekVodSecr.s1;
        s2Vod:= s2Vod + tPerevodtekVodSecr.s2;
      }
    }
  }

  if getlast tNachisl = tsok
  {
    mes:= 0; VodSecTabnum:= '';

    _loop tNachislVodSecr where ((cPersNrec == tNachislVodSecr.zgdnrec and 10002 == tNachislVodSecr.tip))
    {
      if mes <> tNachislVodSecr.mes or VodSecTabnum <> tNachislVodSecr.tabnum
      {
        counter++;
        xlsetcellstringvalue(tNachislVodSecr.tabnum, counter, 1, counter, 1);
        xlsetcellstringvalue(tNachislVodSecr.fio, counter, 2, counter, 2);
        xlsetcellstringvalue(tNachislVodSecr.podr, counter, 3, counter, 3);
        xlsetcellstringvalue(tNachislVodSecr.mes, counter, 4, counter, 4);
        xlsetcellNumberValue(round(tNachislVodSecr.summa/1000, 2), counter, 5, counter, 5);
        xlsetcellnumbervalue(0, counter, 6, counter, 6);
        xlsetcellnumbervalue(0, counter, 7, counter, 7);
        xlsetcellnumbervalue(0, counter, 8, counter, 8);

        _loop tPerevodtekVodSecr where ((tNachislVodSecr.zgdnrec == tPerevodtekVodSecr.zgdnrec and 10002 == tPerevodtekVodSecr.tip
        and tNachislVodSecr.mes == tPerevodtekVodSecr.mes and tNachislVodSecr.tabnum == tPerevodtekVodSecr.tabnum))
        {
          xlsetcellNumberValue(round(tPerevodtekVodSecr.s1/1000, 2), counter, 6, counter, 6);
          xlsetcellNumberValue(round(tPerevodtekVodSecr.s2/1000, 2), counter, 7, counter, 7);
          xlsetcellNumberValue(round((tPerevodtekVodSecr.s1 + tPerevodtekVodSecr.s2)/1000, 2), counter, 8, counter, 8);
        }
      }

      mes:= tNachislVodSecr.mes;
      VodSecTabnum:= tNachislVodSecr.tabnum;
    }

    counter++;
    xlsetfontstyle(1, counter, 1, counter, 8);
    xlmergecells(counter, 1, counter, 4);
    xlAlignCells(-4152, counter, 1, counter, 1);
    xlsetcellstringvalue('Итого секретари: ', counter, 1, counter, 1);
    xlsetcellNumberValue(round(ZpSecr/1000, 2), counter, 5, counter, 5);
    xlsetcellNumberValue(round(s1Secr/1000, 2), counter, 6, counter, 6);
    xlsetcellNumberValue(round(s2Secr/1000, 2), counter, 7, counter, 7);
    xlsetcellNumberValue(round(NalogSecr/1000, 2), counter, 8, counter, 8);

    mes:= 0; VodSecTabnum:= '';

    _loop tNachislVodSecr where ((cPersNrec == tNachislVodSecr.zgdnrec and 10001 == tNachislVodSecr.tip))
    {
      if mes <> tNachislVodSecr.mes or VodSecTabnum <> tNachislVodSecr.tabnum
      {
        counter++;
        xlsetcellstringvalue(tNachislVodSecr.tabnum, counter, 1, counter, 1);
        xlsetcellstringvalue(tNachislVodSecr.fio, counter, 2, counter, 2);
        xlsetcellstringvalue(tNachislVodSecr.podr, counter, 3, counter, 3);
        xlsetcellstringvalue(tNachislVodSecr.mes, counter, 4, counter, 4);
        xlsetcellNumberValue(round(tNachislVodSecr.summa/1000, 2), counter, 5, counter, 5);
        xlsetcellnumbervalue(0, counter, 6, counter, 6);
        xlsetcellnumbervalue(0, counter, 7, counter, 7);
        xlsetcellnumbervalue(0, counter, 8, counter, 8);

        _loop tPerevodtekVodSecr where ((tNachislVodSecr.zgdnrec == tPerevodtekVodSecr.zgdnrec and 10001 == tPerevodtekVodSecr.tip
        and tNachislVodSecr.mes == tPerevodtekVodSecr.mes and tNachislVodSecr.tabnum == tPerevodtekVodSecr.tabnum))
        {
          xlsetcellNumberValue(round(tPerevodtekVodSecr.s1/1000, 2), counter, 6, counter, 6);
          xlsetcellNumberValue(round(tPerevodtekVodSecr.s2/1000, 2), counter, 7, counter, 7);
          xlsetcellNumberValue(round((tPerevodtekVodSecr.s1 + tPerevodtekVodSecr.s2)/1000, 2), counter, 8, counter, 8);
        }
      }

      mes:= tNachislVodSecr.mes;
      VodSecTabnum:= tNachislVodSecr.tabnum;
    }

    counter++;
    xlsetfontstyle(1, counter, 1, counter, 8);
    xlmergecells(counter, 1, counter, 4);
    xlAlignCells(-4152, counter, 1, counter, 1);
    xlsetcellstringvalue('Итого водители: ', counter, 1, counter, 1);
    xlsetcellNumberValue(round(ZpVod/1000, 2), counter, 5, counter, 5);
    xlsetcellNumberValue(round(s1Vod/1000, 2), counter, 6, counter, 6);
    xlsetcellNumberValue(round(s2Vod/1000, 2), counter, 7, counter, 7);
    xlsetcellNumberValue(round(NalogVod/1000, 2), counter, 8, counter, 8);
  }

  xlSetActiveSheet(1);

  xlAddSheet;
  xlRunMacro('PrintParam');
  xlSetSheetName(1, sFIO);
  xlGetUsedRange(1, 1, 36, 4);
  xlSetColumnWidth(21, 1, 1, 1, 1);
  xlSetColumnWidth(35, 1, 2, 1, 2);
  xlSetRowHeight(20, 2, 1, 2, 1);
  xlSetFontStyle(1, 2, 2, 2, 2);
  xlSetFontSize(12, 2, 2, 2, 2);
  xlSetColumnWidth(21, 1, 3, 1, 3);
  xlSetRowHeight(33, 3, 1, 3, 1);
  xlSetFontStyle(1, 4, 1, 4, 4);
  xlWrapText(3, 2, 3, 2);
  xlSetColumnWidth(21, 1, 4, 1, 4);
  xlAlignCellsEx(-4108, -4108, 1, 1, 4, 4);
  xlMergeCells(1, 1, 1, 4);
  xlMergeCells(2, 2, 2, 4);
  xlMergeCells(3, 2, 3, 4);
  xlMergeCells(5, 1, 13, 1);
  xlAlignCellsEx(-4131, -4160, 5, 1, 5, 1);
  xlMergeCells(15, 1, 15, 4);
  xlSetFontStyle(1, 5, 1, 13, 1);
  xlSetFontStyle(1, 14, 1, 15, 4);
  xlAlignCells(-4152, 14, 1, 14, 1);
  xlMergeCells(18, 1, 18, 4);
  xlSetFontStyle(1, 17, 1, 18, 4);
  xlAlignCells(-4152, 17, 1, 17, 1);
  xlMergeCells(28, 1, 28, 4);
  xlSetFontStyle(1, 27, 1, 28, 4);
  xlAlignCells(-4152, 27, 1, 27, 1);
  xlMergeCells(31, 1, 31, 4);
  xlSetFontStyle(1, 30, 1, 31, 4);
  xlAlignCells(-4152, 30, 1, 30, 1);
  xlMergeCells(35, 1, 35, 4);
  xlSetFontStyle(1, 34, 1, 37, 4);
  xlAlignCells(-4152, 34, 1, 34, 1);
  xlAlignCells(-4152, 36, 1, 37, 1);
  xlSetFontSize(14, 37, 1, 37, 4);

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 1, 1, 37, 4);

  xlCreateMatrix(37, 4);
  xlStWriteToMatrix(2, 1, 'ФИО');
  xlStWriteToMatrix(3, 1, 'ДОЛЖНОСТЬ');
  xlStWriteToMatrix(4, 1, 'Вид затрат');
  xlStWriteToMatrix(4, 2, 'Статья затрат');
  xlStWriteToMatrix(4, 3, 'Сумма (тыс. руб.)');
  xlStWriteToMatrix(4, 4, 'Примечание');
  xlStWriteToMatrix(5, 1, 'Зарплата');
  xlStWriteToMatrix(5, 2, 'Зарплата');
  xlStWriteToMatrix(5, 4, 'Руководитель');
  xlStWriteToMatrix(6, 2, 'Налоги на ЗП (от ФОТ)');
  xlStWriteToMatrix(7, 2, 'Медицинское страхование ФМС');
  xlStWriteToMatrix(8, 2, 'Зарплата');
  xlStWriteToMatrix(8, 4, 'Водитель');
  xlStWriteToMatrix(9, 2, 'Налоги на ЗП (от ФОТ)');
  xlStWriteToMatrix(10, 2, 'Медицинское страхование ФМС');
  xlStWriteToMatrix(11, 2, 'Зарплата');
  xlStWriteToMatrix(11, 4, 'Секретарь');
  xlStWriteToMatrix(12, 2, 'Налоги на ЗП (от ФОТ)');
  xlStWriteToMatrix(13, 2, 'Медицинское страхование ФМС');
  xlStWriteToMatrix(14, 1, 'ИТОГО:');
  xlStWriteToMatrix(15, 1, 'Профессиональные услуги');
  xlStWriteToMatrix(16, 2, 'Тренинги и семинары');
  xlStWriteToMatrix(17, 1, 'ИТОГО:');
  xlStWriteToMatrix(18, 1, 'Командировки');
  xlStWriteToMatrix(19, 2, 'Командировочные (суточные)');
  xlStWriteToMatrix(20, 2, 'Гостиница (проживание)');
  xlStWriteToMatrix(21, 2, 'Авиаперелеты');
  xlStWriteToMatrix(22, 2, 'Ж/д перевозки');
  xlStWriteToMatrix(23, 2, 'Трансфер');
  xlStWriteToMatrix(24, 2, 'Визовый сбор');
  xlStWriteToMatrix(25, 2, 'Представительские расходы');
  xlStWriteToMatrix(26, 2, 'Страховка');
  xlStWriteToMatrix(27, 1, 'ИТОГО:');
  xlStWriteToMatrix(28, 1, 'Аренда');
  xlStWriteToMatrix(29, 2, 'Аренда жилья');
  xlStWriteToMatrix(30, 1, 'ИТОГО:');
  xlStWriteToMatrix(31, 1, 'Связь');
  xlStWriteToMatrix(32, 2, 'Интернет (перс.)');
  xlStWriteToMatrix(33, 2, 'Мобильная связь');
  xlStWriteToMatrix(34, 1, 'ИТОГО:');
  xlStWriteToMatrix(35, 1, 'Прочие услуги');
  xlStWriteToMatrix(36, 1, 'ИТОГО:');
  xlStWriteToMatrix(37, 1, 'ВСЕГО:');

  xlStWriteToMatrix(1, 1, kvartal + ' квартал ' + god + ' года');
  xlStWriteToMatrix(2, 2, sFIO);
  xlStWriteToMatrix(3, 2, sPost);
  xlDoWriteToMatrix(5, 3, round(itogzp/1000, 2));
  xlDoWriteToMatrix(6, 3, round(itognalog/1000, 2));



  xlDoWriteToMatrix(7, 3, 0);
  xlDoWriteToMatrix(8, 3, round(ZpVod/1000, 2));
  xlDoWriteToMatrix(9, 3, round(NalogVod/1000, 2));
  xlDoWriteToMatrix(10, 3, 0);
  xlDoWriteToMatrix(11, 3, round(ZpSecr/1000, 2));
  xlDoWriteToMatrix(12, 3, round(NalogSecr/1000, 2));
  xlDoWriteToMatrix(13, 3, 0);

  _loop tOborot where ((cPersNrec == toborot.persnrec))
  {
    case tOborot.analitika of

      'Командировочные (суточные)': xlDoWriteToMatrix(19, 3, round(tOborot.summa/1000, 2));

      'Гостиница (проживание)': xlDoWriteToMatrix(20 , 3, round(tOborot.summa/1000, 2));

      'Авиаперелеты': xlDoWriteToMatrix(21, 3, round(tOborot.summa/1000, 2));

      'Ж/д перевозки': xlDoWriteToMatrix(22, 3, round(tOborot.summa/1000, 2));

      'Трансфер': xlDoWriteToMatrix(23, 3, round(tOborot.summa/1000, 2));

      'Визовый сбор': xlDoWriteToMatrix(24, 3, round(tOborot.summa/1000, 2));

      'Представительские расходы': xlDoWriteToMatrix(25, 3, round(tOborot.summa/1000, 2));

      'Страховка': xlDoWriteToMatrix(26, 3, round(tOborot.summa/1000, 2));

      'Интернет (перс.)': xlDoWriteToMatrix(32, 3, 0);

      'Мобильная связь': xlDoWriteToMatrix(33, 3, round(tOborot.summa/1000, 2));

    end;
  }

  xlWriteMatrixToExcel(1, 1);
  xlFreeMatrix;
  xlSetCellFormula('=СУММ(C5:C13)', 14, 3, 14, 3);
  xlSetCellFormula('=СУММ(C16)', 17, 3, 17, 3);
  xlSetCellFormula('=СУММ(C19:C26)', 27, 3, 27, 3);
  xlSetCellFormula('=СУММ(C29)', 30, 3, 30, 3);
  xlSetCellFormula('=СУММ(C32:C33)', 34, 3, 34, 3);
  xlSetCellFormula('=СУММ(C14;C17;C27;C30;C34;C36)', 37, 3, 37, 3);

  countSheets++;
  xlSetActiveSheet(countSheets);
  xlSetSheetName(countSheets, 'Общая информация');

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 8);

  xlRunMacro('ChangeFont');

  StopVisual('',0);
  xlkillExcel;
}

end;

windowevent wnSelPers;

cmDefault:
{
  if pMarkerpers.count = 0
  {
    Filtr_persons:= 'Не выбраны';
  }

  SubBounds(tbRmtSelPers1);
  AddBounds(tbRmtSelPers2);

  _loop pMarkerpers
  {
    if pMarkerpers.count = 1
    {
      Filtr_persons:= tSelPers.fio;
    }
  }

  SubBounds(tbRmtSelPers2);
  AddBounds(tbRmtSelPers1);

  if pMarkerpers.count > 1
  {
    Filtr_persons:= 'Выбрано ' + pMarkerpers.count;
  }

  rescanpanel(scr);
}

end;

end.

VipInterface UserReport_rasnarukapp Implements IUserReport;
Interface UserReport_rasnarukapp;

Procedure Run;
Begin
  runinterface(gp_rasnarukapp);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Расходы на руководящий аппарат';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
