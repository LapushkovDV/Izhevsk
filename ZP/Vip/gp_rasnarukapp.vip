#doc
      #60339    Костыль по Азовцеву
#end

#include userreport.vih
#include marker.vih
#include GP_GetFIOPostByPeriod.Vih

interface gp_rasnarukapp 'Параметры отчета' gray
Show at (,,40,7);

table struct tSelPers // Для фильтра по сотрудникам
(
nrec: comp,
kod: string,
post: string,
appdate: date,
disdate: date,
fio: string
)
with index
(
i1 = fio + appdate
)
;

table struct tNachisl // З/П
(
persnrec: comp,
fio: string,
tabnum: string,
podr: string,
post: string,
mes: word,
year: integer,
summa: decimal(31,15)
)
with index
(
i1 = fio + tabnum + mes,
i2 = tabnum + mes + podr (unique)
)
;

table struct tNachislVodSecr // З/П водителя и секретаря
(
zgdnrec: comp,
fio: string,
tabnum: string,
podr: string,
post: string,
mes: word,
year: integer,
tip: word,
fromdate: date,
todate: date,
PersDisDate: date,
summa: decimal(31,15)
)
with index
(
i1 = tip + mes,
i2 = zgdnrec + tip + mes
)
;

table struct tPerevodtek // Налоги на ФОТ
(
fio: string,
tabnum: string,
podr: string,
mes: word,
year: integer,
s1: decimal(31,15),
s2: decimal(31,15),
s3: decimal(31,15)
)
with index
(
i1 = fio + tabnum + mes,
i2 = tabnum + mes + podr (unique)
)
;

table struct tPerevodtekVodSecr // Налоги водителя и секретаря
(
zgdnrec: comp,
fio: string,
tabnum: string,
podr: string,
post: string,
mes: word,
year: integer,
tip: word,
fromdate: date,
todate: date,
PersDisDate: date,
s1: decimal(31,15),
s2: decimal(31,15)
)
with index
(
i1 = tip + mes,
i2 = zgdnrec + tip + mes + tabnum
)
;

table struct tOborot // Проводки
(
persnrec  : comp,
fio       : string,
analitika : string,
summa     : decimal(31,15)
)
with index
(
i1 = persnrec
)
;

create view gp_rasnarukapp

var
kvartal, mes: word;
counter, countSheets: longint;
god: integer;
excelpath, Filtr_Persons, pUserName, ptabnum, sFIO, sPost, VodSecTabnum: string;
pMarkerPers: IMarker(marker) new;
cpers, cPersNrec: comp;
itogzp, itogs1, itogs2, itogs3, itognalog,
ZpSecr, NalogSecr, ZpVod, NalogVod,
s1Secr, s2Secr, s1Vod, s2Vod: double;

select tSelPers.nrec from tSelPers, tNachisl, tPerevodtek, tOborot, tPerevodtekVodSecr, tNachislVodSecr;

Procedure GetOborot(_d, _m1, _m2, _y : word);
{
  var qStr : longint = 0;

  sqlFreeStr(qStr);

  sqlAddStr(qStr, '    select                                                                                                           ');
  sqlAddStr(qStr, '      persons.nrec                                              as  persnrec                                         ');
  sqlAddStr(qStr, '    , persons.fio                                               as  fio                                              ');
  sqlAddStr(qStr, '    , substring(attrval.vstring, 5, length(attrval.vstring))    as  analitika                                        ');
  sqlAddStr(qStr, '    , sum(oborot.sumob)                                         as  summa                                            ');
  sqlAddStr(qStr, '    from oborot                                                                                                      ');
  sqlAddStr(qStr, '    left join spkau on spkau.nrec = oborot.kauks[2]                                                                  ');
  sqlAddStr(qStr, '    inner join attrnam on attrnam.wtable = 8512 and attrnam.name = ''.Входит в отчет по руководителям''              ');
  sqlAddStr(qStr, '    inner join attrval on attrval.wtable = 8512 and attrval.cattrnam = attrnam.nrec and spkau.nrec = attrval.crec    ');
  sqlAddStr(qStr, '    left join persons on persons.nrec = oborot.kauks[1]                                                              ');
  sqlAddStr(qStr, '    where oborot.datob between #date(01                , ' + string(_m1) + ', ' + string(_y) + ')                    ');
  sqlAddStr(qStr, '                           and #date(' + string(_d) + ', ' + string(_m2) + ', ' + string(_y) + ')                    ');
  sqlAddStr(qStr, '          and spkau.name <> ''240 Закупка услуг сотовой связи''                                                      ');
  sqlAddStr(qStr, '    group by persons.nrec, persons.fio, substring(attrval.vstring, 5, length(attrval.vstring))                       ');
  sqlAddStr(qStr, '                                                                                                                     ');
  sqlAddStr(qStr, '    union all                                                                                                        ');
  sqlAddStr(qStr, '                                                                                                                     ');
  sqlAddStr(qStr, '    select                                                                                                           ');
  sqlAddStr(qStr, '      persons.nrec                                              as  persnrec                                         ');
  sqlAddStr(qStr, '    , persons.fio                                               as  fio                                              ');
  sqlAddStr(qStr, '    , ''Мобильная связь''                                       as  analitika                                        ');
  sqlAddStr(qStr, '    , sum(oborot.sumob)                                         as  summa                                            ');
  sqlAddStr(qStr, '    from oborot                                                                                                      ');
  sqlAddStr(qStr, '    left join spkau on spkau.nrec = oborot.kauks[6]                                                                  ');
  sqlAddStr(qStr, '    left join persons on persons.nrec = oborot.kauks[4]                                                              ');
  sqlAddStr(qStr, '    where oborot.datob between #date(01                , ' + string(_m1) + ', ' + string(_y) + ')                    ');
  sqlAddStr(qStr, '                           and #date(' + string(_d) + ', ' + string(_m2) + ', ' + string(_y) + ')                    ');
  sqlAddStr(qStr, '          and oborot.dbscheto <> ''19''                                                                              ');
  sqlAddStr(qStr, '          and oborot.krschetk = ''60''                                                                               ');
  sqlAddStr(qStr, '          and oborot.subschk = ''11''                                                                                ');
  sqlAddStr(qStr, '    group by persons.nrec, persons.fio                                                                               ');

  var objQuery : iQuery;
      objQuery := queryManager.createQuery(qStr);

  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('Ошибка обработки записей (GetOborot) ' + objQuery.errorCode, Error);
  }
  else
  {
    sqlCopyInto(objQuery, tntOborot, true);
  }
  sqlFreeStr(qStr);
}

window wnSelPers 'Сотрудники' doAccept, EscClose;
Show at (5,5,170,25);
Browse brSelPers '' ;
Table tSelPers;
recMarker=pMarkerPers {tSelPers.nrec};
Fields
tSelPers.fio 'ФИО':[40],Protect,NoDel;
tSelPers.kod  'Код подр.':[10],Protect,NoDel;
tSelPers.post  'Должность':[100],Protect,NoDel;
tSelPers.appdate 'Дата начала':[10],Protect,NoDel;
tSelPers.disdate 'Дата окончания':[10],Protect,NoDel;
end;
end;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  kvartal : [list
            1 '1',
            2 '2',
            3 '3',
            4 '4'], protect;
  god: noprotect, spinbutton [1, 1917, 2117];
  Filtr_Persons: pickbutton, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Квартал:      .@@@
    Год:          .@@@@@
    Лицевые счета:.@@@@@@@@@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  pUserName:= UserName();
  kvartal:= 1;
  god:= year(dgettune('UP.DATOTCH'));
  Filtr_Persons:= 'Не выбраны';

  SQL
  select Distinct lschet.nrec, CatDept.Code, CatPost.Name, Appointments.AppointDate, Appointments.DisMissDate, Persons.Fio
  From Catalogs CatPostMain
  inner join Catalogs CatPost on CatPost.cParent = CatPostMain.Nrec
  inner join Appointments on Appointments.Post = CatPost.Nrec and ((Appointments.LPrizn >= 0 and Appointments.LPrizn <= 3) or Appointments.LPrizn = 100)
  Inner join Persons on Persons.Nrec = Appointments.Person
  Inner join Catalogs CatDept on CatDept.Nrec = Appointments.Department
  inner join lschet on lschet.nrec = appointments.caddnrec2
  where CatPostMain.Name = '_Первые руководители и их заместители'

  union all

  select
    lschet.nrec, '511', 'Заместитель генерального директора по закупкам', #date(17, 07, 2023), #date(31, 12, 2023), 'Азовцев Константин Алексеевич'
  from lschet
  where lschet.nrec = #comp(0000000010050061h)

  into tSelPers
  ;
}

cmPick:
{
  if curfield = #Filtr_persons
  {
    runwindow(wnSelPers);
  }
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from tNachisl;
  delete all from tPerevodtek;
  delete all from tOborot;
  delete all from tNachislVodSecr;
  delete all from tPerevodtekVodSecr;

  SubBounds(tbRmtSelPers1);
  AddBounds(tbRmtSelPers2);

  if kvartal = 1
  {
    _loop pMarkerPers
    {
      cpers:= tSelPers.nrec;

      sql
      select persons.nrec, persons.fio, lschet.strtabn, katpodr.kod, catalogs.name, nachislzakaz.mesn, nachislzakaz.yearn, round(sum(nachislzakaz.summa), 2)
      from nachislzakaz
      left join lschet on lschet.nrec = nachislzakaz.clsch
      left join persons on lschet.tperson = persons.nrec
      left join katpodr on katpodr.nrec = nachislzakaz.cexoz
      left join catalogs on catalogs.nrec = lschet.cappoint
      where (nachislzakaz.mesn = 1 or nachislzakaz.mesn = 2 or nachislzakaz.mesn = 3) and nachislzakaz.yearn = :(god)
      and (nachislzakaz.vidopl <> 079 and nachislzakaz.vidopl <> 178 and nachislzakaz.vidopl <> 179
      and nachislzakaz.vidopl <> 180 and nachislzakaz.vidopl <> 181 and nachislzakaz.vidopl <> 182
      and nachislzakaz.vidopl <> 189) and nachislzakaz.clsch = :(cpers)
      group by persons.nrec, persons.fio, lschet.strtabn, katpodr.kod, catalogs.name, nachislzakaz.mesn, nachislzakaz.yearn
      into tNachisl
      ;

      sql
      select persons.fio, lschet.strtabn, katpodr.kod, perevodtekzakaz.mesn, perevodtekzakaz.yearn,
      round(sum(coalesce(perevodtekzakaz2.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz3.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz5.sumper,0)), 2) +
      round(sum(coalesce(perevodtekzakaz11.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz12.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz14.sumper,0)), 2),
      round(sum(perevodtekzakaz8.sumper), 2), round(sum(perevodtekzakaz3.sumper), 2)
      from perevodtekzakaz
      left join lschet on lschet.nrec = perevodtekzakaz.clsch
      left join persons on lschet.tperson = persons.nrec
      left join katpodr on katpodr.nrec = perevodtekzakaz.cexoz
      left join perevodtekzakaz perevodtekzakaz2 on perevodtekzakaz2.nrec = perevodtekzakaz.nrec and perevodtekzakaz2.vidper = 2
      left join perevodtekzakaz perevodtekzakaz3 on perevodtekzakaz3.nrec = perevodtekzakaz.nrec and perevodtekzakaz3.vidper = 3
      left join perevodtekzakaz perevodtekzakaz5 on perevodtekzakaz5.nrec = perevodtekzakaz.nrec and perevodtekzakaz5.vidper = 5
      left join perevodtekzakaz perevodtekzakaz8 on perevodtekzakaz8.nrec = perevodtekzakaz.nrec and perevodtekzakaz8.vidper = 8
      left join perevodtekzakaz perevodtekzakaz11 on perevodtekzakaz11.nrec = perevodtekzakaz.nrec and perevodtekzakaz11.vidper = 11
      left join perevodtekzakaz perevodtekzakaz12 on perevodtekzakaz12.nrec = perevodtekzakaz.nrec and perevodtekzakaz12.vidper = 12
      left join perevodtekzakaz perevodtekzakaz14 on perevodtekzakaz14.nrec = perevodtekzakaz.nrec and perevodtekzakaz14.vidper = 14
      where (perevodtekzakaz.mesn = 1 or perevodtekzakaz.mesn = 2 or perevodtekzakaz.mesn = 3)
      and perevodtekzakaz.yearn = :(god) and perevodtekzakaz.clsch = :(cpers)
      group by persons.fio, lschet.strtabn, katpodr.kod, perevodtekzakaz.mesn, perevodtekzakaz.yearn
      into tPerevodtek
      ;

      sql
      select appointments.person, persons.fio, l1.strtabn, katpodr.kod, catalogs.name, nachislzakaz.mesn, nachislzakaz.yearn, gp_kpi_pers_class.vidopl, gp_kpi_pers_class.fromdate, gp_kpi_pers_class.todate, persons.disdate, round(sum(nachislzakaz.summa), 2)
      from lschet
      left join appointments on appointments.caddnrec2 = lschet.nrec
      left join gp_kpi_pers_class on gp_kpi_pers_class.clink_app = appointments.nrec
      left join appointments a1 on a1.nrec = gp_kpi_pers_class.cappoint
      left join lschet l1 on l1.nrec = a1.caddnrec2
      left join nachislzakaz on nachislzakaz.clsch = l1.nrec
      and (nachislzakaz.mesn = 1 or nachislzakaz.mesn = 2 or nachislzakaz.mesn = 3) and nachislzakaz.yearn = :(god)
      and (nachislzakaz.vidopl <> 079 and nachislzakaz.vidopl <> 178 and nachislzakaz.vidopl <> 179
      and nachislzakaz.vidopl <> 180 and nachislzakaz.vidopl <> 181 and nachislzakaz.vidopl <> 182
      and nachislzakaz.vidopl <> 189)
      left join persons on l1.tperson = persons.nrec
      left join katpodr on katpodr.nrec = nachislzakaz.cexoz
      left join catalogs on catalogs.nrec = l1.cappoint
      where lschet.nrec = :(cpers)
      and (cast(substring(date2str('%yyyy', gp_kpi_pers_class.todate),1,4) as integer) = nachislzakaz.yearn or cast(substring(date2str('%yyyy', gp_kpi_pers_class.todate),1,4) as integer) = 0)
      and ((cast(substring(date2str('%MM', gp_kpi_pers_class.todate),1,2) as word) between 1 and 3) or (cast(substring(date2str('%MM', gp_kpi_pers_class.todate),1,2) as word) = 0))
      and ((cast(substring(date2str('%yyyy', gp_kpi_pers_class.fromdate),1,4) as integer) = nachislzakaz.yearn and cast(substring(date2str('%MM', gp_kpi_pers_class.fromdate),1,2) as word) <= 3)
      or cast(substring(date2str('%yyyy', gp_kpi_pers_class.fromdate),1,4) as integer) < nachislzakaz.yearn)
      group by appointments.person, persons.fio, l1.strtabn, katpodr.kod, catalogs.name, nachislzakaz.mesn, nachislzakaz.yearn, gp_kpi_pers_class.vidopl, gp_kpi_pers_class.fromdate, gp_kpi_pers_class.todate, persons.disdate
      into tNachislVodSecr
      ;

      sql
      select appointments.person, persons.fio, l1.strtabn, katpodr.kod, catalogs.name, perevodtekzakaz.mesn, perevodtekzakaz.yearn, gp_kpi_pers_class.vidopl, gp_kpi_pers_class.fromdate, gp_kpi_pers_class.todate, persons.disdate,
      round(sum(coalesce(perevodtekzakaz2.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz3.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz5.sumper,0)), 2) +
      round(sum(coalesce(perevodtekzakaz11.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz12.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz14.sumper,0)), 2),
      round(sum(perevodtekzakaz8.sumper), 2), round(sum(perevodtekzakaz3.sumper), 2)
      from lschet
      left join appointments on appointments.caddnrec2 = lschet.nrec
      left join gp_kpi_pers_class on gp_kpi_pers_class.clink_app = appointments.nrec
      left join appointments a1 on a1.nrec = gp_kpi_pers_class.cappoint
      left join lschet l1 on l1.nrec = a1.caddnrec2
      left join perevodtekzakaz on perevodtekzakaz.clsch = l1.nrec and perevodtekzakaz.yearn = :(god) and (perevodtekzakaz.mesn = 1 or perevodtekzakaz.mesn = 2 or perevodtekzakaz.mesn = 3)
      left join perevodtekzakaz perevodtekzakaz2 on perevodtekzakaz2.nrec = perevodtekzakaz.nrec and perevodtekzakaz2.vidper = 2
      left join perevodtekzakaz perevodtekzakaz3 on perevodtekzakaz3.nrec = perevodtekzakaz.nrec and perevodtekzakaz3.vidper = 3
      left join perevodtekzakaz perevodtekzakaz5 on perevodtekzakaz5.nrec = perevodtekzakaz.nrec and perevodtekzakaz5.vidper = 5
      left join perevodtekzakaz perevodtekzakaz8 on perevodtekzakaz8.nrec = perevodtekzakaz.nrec and perevodtekzakaz8.vidper = 8
      left join perevodtekzakaz perevodtekzakaz11 on perevodtekzakaz11.nrec = perevodtekzakaz.nrec and perevodtekzakaz11.vidper = 11
      left join perevodtekzakaz perevodtekzakaz12 on perevodtekzakaz12.nrec = perevodtekzakaz.nrec and perevodtekzakaz12.vidper = 12
      left join perevodtekzakaz perevodtekzakaz14 on perevodtekzakaz14.nrec = perevodtekzakaz.nrec and perevodtekzakaz14.vidper = 14
      left join persons on l1.tperson = persons.nrec
      left join katpodr on katpodr.nrec = perevodtekzakaz.cexoz
      left join catalogs on catalogs.nrec = l1.cappoint
      where lschet.nrec = :(cpers)
      and (cast(substring(date2str('%yyyy', gp_kpi_pers_class.todate),1,4) as integer) = perevodtekzakaz.yearn or cast(substring(date2str('%yyyy', gp_kpi_pers_class.todate),1,4) as integer) = 0)
      and ((cast(substring(date2str('%MM', gp_kpi_pers_class.todate),1,2) as word) between 1 and 3) or (cast(substring(date2str('%MM', gp_kpi_pers_class.todate),1,2) as word) = 0))
      and ((cast(substring(date2str('%yyyy', gp_kpi_pers_class.fromdate),1,4) as integer) = perevodtekzakaz.yearn and cast(substring(date2str('%MM', gp_kpi_pers_class.fromdate),1,2) as word) <= 3)
      or cast(substring(date2str('%yyyy', gp_kpi_pers_class.fromdate),1,4) as integer) < perevodtekzakaz.yearn)
      group by appointments.person, persons.fio, l1.strtabn, katpodr.kod, catalogs.name, perevodtekzakaz.mesn, perevodtekzakaz.yearn, gp_kpi_pers_class.vidopl, gp_kpi_pers_class.fromdate, gp_kpi_pers_class.todate, persons.disdate
      into tPerevodtekVodSecr
      ;
    }

    GetOborot(31, 1, 3, god);
  }

  if kvartal = 2
  {
    _loop pMarkerPers
    {
      cpers:= tSelPers.nrec;

      sql
      select persons.nrec, persons.fio, lschet.strtabn, katpodr.kod, catalogs.name, nachislzakaz.mesn, nachislzakaz.yearn, round(sum(nachislzakaz.summa), 2)
      from nachislzakaz
      left join lschet on lschet.nrec = nachislzakaz.clsch
      left join persons on lschet.tperson = persons.nrec
      left join katpodr on katpodr.nrec = nachislzakaz.cexoz
      left join catalogs on catalogs.nrec = lschet.cappoint
      where (nachislzakaz.mesn = 4 or nachislzakaz.mesn = 5 or nachislzakaz.mesn = 6) and nachislzakaz.yearn = :(god)
      and (nachislzakaz.vidopl <> 079 and nachislzakaz.vidopl <> 178 and nachislzakaz.vidopl <> 179
      and nachislzakaz.vidopl <> 180 and nachislzakaz.vidopl <> 181 and nachislzakaz.vidopl <> 182
      and nachislzakaz.vidopl <> 189) and nachislzakaz.clsch = :(cpers)
      group by persons.nrec, persons.fio, lschet.strtabn, katpodr.kod, catalogs.name, nachislzakaz.mesn, nachislzakaz.yearn
      into tNachisl
      ;

      sql
      select persons.fio, lschet.strtabn, katpodr.kod, perevodtekzakaz.mesn, perevodtekzakaz.yearn,
      round(sum(coalesce(perevodtekzakaz2.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz3.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz5.sumper,0)), 2) +
      round(sum(coalesce(perevodtekzakaz11.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz12.sumper,0)), 2) + round(sum(coalesce(perevodtekzakaz14.sumper,0)), 2),
      round(sum(perevodtekzakaz8.sumper), 2), round(sum(perevodtekzakaz3.sumper), 2)
      from perevodtekzakaz
      left join lschet on lschet.nrec = perevodtekzakaz.clsch
      left join persons on lschet.tperson = persons.nrec
      left join katpodr on katpodr.nrec = perevodtekzakaz.cexoz
      left join perevodtekzakaz perevodtekzakaz2 on perevodtekzakaz2.nrec = perevodtekzakaz.nrec and perevodtekzakaz2.vidper = 2
      left join perevodtekzakaz perevodtekzakaz3 on perevodtekzakaz3.nrec = perevodtekzakaz.nrec and perevodtekzakaz3.vidper = 3
      left join perevodtekzakaz perevodtekzakaz5 on perevodtekzakaz5.nrec = perevodtekzakaz.nrec and perevodtekzakaz5.vidper = 5
      left join perevodtekzakaz perevodtekzakaz8 on perevodtekzakaz8.nrec = perevodtekzakaz.nrec and perevodtekzakaz8.vidper = 8
      left join perevodtekzakaz perevodtekzakaz11 on perevodtekzakaz11.nrec = perevodtekzakaz.nrec and perevodtekzakaz11.vidper = 11
      left join perevodtekzakaz perevodtekzakaz12 on perevodtekzakaz12.nrec = perevodtekzakaz.nrec and perevodtekzakaz12.vidper = 12
      left join perevodtekzakaz perevodtekzakaz14 on perevodtekzakaz14.nrec = perevodtekzakaz.nrec and perevodtekzakaz14.vidper = 14
      where (perevodtekzakaz.mesn = 4 or perevodtekzakaz.mesn = 5 or perevodtekzakaz.mesn = 6)
      and perevodtekzakaz.yearn = :(god) and perevodtekzakaz.clsch = :(cpers)
