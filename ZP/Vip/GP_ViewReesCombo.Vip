* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#808          |09/01/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#1715         |19/01/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#1716         |19/01/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
//-- Z_PayRep иначе  не соберется.
#include Viewrees.vih
#include GP_ViewReesCombo.Vih

//На базе Z_PayRep::ViewReesCombo
//VipInterface GP_ViewReesCombo(Z_PayRep::ViewReesCombo) Parameters(DTB:date;)
Interface GP_ViewReesCombo;
var
 DTB:date;
 DTE:date;
 boRunInit:boolean;
 NoDog:boolean;
 boFltPodr:boolean;
Create view ReesVip
//where ((
// тормозит
//      Root == SbBan.Nrec(Noindex) and ((not NoDog) or  (SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A'))
//))
// без реестров на договора подряда  - придется хватать весь SetupFilters,
// поэтому делаем как основное условие
//Bounds ByNoDog Root == SbBan.Nrec(Noindex)
// and (SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
Bounds ByNoMerge = Root == SbBan.Prefix(noindex)
        and (SbBan.Prefix<>'R$$') //ordered by TableOrder
;
Parameters
  DTB,DTE,NoDog,boFltPodr;
//------------------------------------------------------------------------------
// устанавливаем даты фильтра по настройкам
//------------------------------------------------------------------------------
/*
  procedure InitDefDates;
  {
    Inherited::InitDefDates;
    D1:=DTB;D2:=DTE;
    UserD1:=D1;UserD2:=D2;
    FILTER:=1;
  }
*/
//------------------------------------------------------------------------------
// обновление флагов фильтров
//------------------------------------------------------------------------------
/*
  procedure UpdateFilter;
  { inherited::UpdateFilter
    if boRunInit FILTER:=1;
  }
*/
//------------------------------------------------------------------------------
window wFilters 'Выбор фильтров' EscClose;
show at (,,64,22);
HandleEvent
  cmPick:
  {
    case CurField of
    //------------
      #WorkPrefStr:
      {
        var V: variant;
        V := string(TM1);
        WorkPref.Definition.Pick(WorkPref.Definition.Layout, V);
        // если выбрали реестр по налогам на ФОТ, то игнорируем
#IFDEF _GP_
        if False
#ELSE
        if word(V) = 40
#ENDIF
          Message('Выбранный не является реестром по удержаниям!', Information);
        else
        {
          set TM1 := word(V);

          UpdateView;
          FBA.Load(DskUser + CurPref1);

          UpdateFilter;
        }
      }
    else
    { case inherited :: handleEvent (cmPick) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
      end;
    }
    end;
  }
end; // HandleEvent window wFilters
end; // window wFilters

HandleEvent
cmInit:
{ boRunInit:=true;
  if  inherited :: handleEvent (cmInit)=heAbort then Abort;
  // сбросим пометку с вложенных - теперь из не видно
  if (ModeView and vfMultipleSelection) = vfMultipleSelection
  {
    var ii:longint;
    var _cTmp:comp=0;
#ifdef _2020_09_30_
    var MarkVipl: TPtr = InitMarker('', 8, 200, 100);
    clearMarker(MarkVipl);
    MarkVipl0.ExportTo(MarkVipl);
#end
    for(ii:=0;ii<GetMarkerCount(MarkVipl);ii++)
    { if not GetMarker(MarkVipl,ii,_cTmp) then continue;
      _Loop SbBan1 where (( _cTmp == SbBan1.cNode ))
      { if FoundMarker(MarkVipl,SbBan1.Nrec)
          DeleteMarker(MarkVipl,SbBan1.Nrec);
      } //_Loop SbBan1 where (( _cTmp == SbBan1.cNode ))
    } //for(ii:=0;ii<GetMarkerCount(MarkVipl);ii++);
#ifdef _2020_09_30_
  MarkVipl0.ImportFrom(MarkVipl);
  DoneMarker(MarkVipl,'');
#end
  } //if (ModeView and vfMultipleSelection) = vfMultipleSelection

  //---------------------------------
  // переопределим фильтры
  boRunInit:=false;
  D1:=DTB;D2:=DTE;
  UserD1:=D1;UserD2:=D2;
  FILTER:=1;
  if boFltPodr
  { BitOnL(FILTER,3)
  }
  else
  { BitOffL(FILTER,3)
  }
  //if NoDog AddBounds(tbByNoDog);
  SetupFilters;
  //-----------
  AddBounds(tbByNoMerge);
  ReReadRecord(#SbBan);
  //-----------
  if not GetBit(2, Filter)
  { if BoundActive(tbByReal)
    { SubBounds(tbByReal);
      ReReadRecord(#SbBan);
    }
  }
  // переопределим фильтры
  //---------------------------------

} //cmInit
//----------------------
cmDefault:
{ if (ModeView and vfMultipleSelection) = vfMultipleSelection
  {
#ifdef _2020_09_30_
    var MarkVipl: TPtr = InitMarker('', 8, 200, 100);
    MarkVipl0.ExportTo(MarkVipl);
#end
    if GetMarkerCount(MarkVipl) = 0
      InsertMarker(MarkVipl, SBBAN.NREC);
    var ii:longint;
    var _cTmp:comp=0;
    for(ii:=0;ii<GetMarkerCount(MarkVipl);ii++)
    { if not GetMarker(MarkVipl,ii,_cTmp) then continue;
      _Loop SbBan1 where (( _cTmp == SbBan1.cNode ))
      { if not FoundMarker(MarkVipl,SbBan1.Nrec)
          InsertMarker(MarkVipl,SbBan1.Nrec);
      } //_Loop SbBan1 where (( _cTmp == SbBan1.cNode ))
    } //for(ii:=0;ii<GetMarkerCount(MarkVipl);ii++);
#ifdef _2020_09_30_
  MarkVipl0.ImportFrom(MarkVipl);
  DoneMarker(MarkVipl,'VedRees_Marker');
#end

  } //if (ModeView and vfMultipleSelection) = vfMultipleSelection
  if  inherited :: handleEvent (cmDefault)=heAbort then Abort;

} //cmDefault:
end;
end.
