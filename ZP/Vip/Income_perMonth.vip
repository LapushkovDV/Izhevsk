/*************************************************************************************************\
* Наименование:  Отчет для выверки ПС                                                           *
* Контур/Модуль: Заработная плата / Отчеты пользователя                                           *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#00000         |-       |Захарова Е.              |НПО Энергомаш                   *
* Доработка   |#88775         |21/01/25|Dmitrii.Lapygin          |НПО Энергомаш                   *
\*************************************************************************************************/
#include query.vih

interface Income_perMonth 'Отчет для выверки ПС' (,,sci1Esc), blue;
show(,,50,7);
table struct local t01 (
  tperson: comp,
  strtabn: string,
  fio: string,
  mesn: word,
  yearn: word,
  sum1: tSumma,
  kod: longint,
  mark32: string,
  mark34: string,
  markdie: string
)
with index (
  i01 = tperson
);
table struct local t02( //итоговая таблица
  tperson: comp,
  strtabn: string,
  fio: string,
  mesn:word,
  SVsumm:double,
  dtSVsumm:double,
  dtSVsumm11:double,
  dtSVsumm12:double,
  befNalog:double,
  aftNalog:double,
  sum1: tSumma,
  sum2: tSumma,
  sum3: tSumma,
  sum4: tSumma,
  kod2: string,
  kod3: string,
  kod4: string
)
with index (
  i01 = tperson
 ,i02 = tperson+mesn
);

table struct local tper ( //таблица с суммами СВ
  tpers: comp,
  mesn: word,
  yearn: word,
  summ: double,
  dtsumm: double,
  dtSVsumm11:double,
  dtSVsumm12:double
)
with index (
  i01 = tpers
 ,i02 = tpers+mesn+yearn
);
table struct local tmpNalog ( //таблица с налогами
  tpers: comp,
  mesn: word,
  yearn: word,
  befNalog: double,
  aftNalog: double
)
with index (
  i01 = tpers
 ,i02 = tpers+mesn+yearn
);



create view
var d1,d0: date;
    TypeRep: longint = 0;
    ii  :word;


as select t02.fio

from t01, t02,tper, tmpNalog
order by t02.fio,t02.mesn
;

screen scr02;
notablenavigation;
fields
  TypeRep ('Тип: Месяц / Год'): noProtect, NoFrame;
  d0: noprotect;
  d1: noprotect;
buttons
  cmPrintDoc;
<<
   Отчет по суммам дохода за месяц/период
  `Тип отчета` (.) Месяц`
               (.) Период`
   Последнее число месяца/период:.@@@@@@@@@@@@
                                 .@@@@@@@@@@@@
   <.   Сформировать   .>
>>
end;




Function fPrintDoc : longint; {
  result := 0;

  var stmt_str: longint = 0;
  sqlFreeStr(stmt_str);


  sqlAddStr(stmt_str, 'select ooo.tperson as tperson, ooo.strtabn as strtabn, ooo.fio as fio,ooo.mesn as mesn,                                                  ');
  sqlAddStr(stmt_str, 'ooo.yearn as yearn,sum(ooo.summa) as sum1, ooo.vo as kod, ooo.VHVOE[32] as mark32, ooo.VHVOE[34] as mark34                               ');
  sqlAddStr(stmt_str, ', case when d_month(ooo.dates[2])<=ooo.mesn and d_year(ooo.dates[2])<=ooo.yearn and ooo.dates[2]<>0  then ''+'' else ''-'' end as markdie    ');
  sqlAddStr(stmt_str, 'from                                                                                                                                     ');
  sqlAddStr(stmt_str, '(select opl.tperson,ls.dates[2],persons.strtabn,persons.fio,opl.mesn,opl.yearn,opl.summa, opl.vo, klvidopl.VHVOE[32], klvidopl.VHVOE[34] ');
  sqlAddStr(stmt_str, 'from (select nrec,tperson, clsch,cex,yearn,mesn,vidoplp vo, vidopl vosys, summa from sumvidop                                            ');
  sqlAddStr(stmt_str, 'union                                                                                                                                    ');
  sqlAddStr(stmt_str, 'select nrec,tperson,clsch,cex,yearn,mesn,vidopl vo, vidopls vosys,summa from nenach) opl                                                 ');
  sqlAddStr(stmt_str, 'join persons on opl.tperson=persons.nrec                                                                                                 ');
  sqlAddStr(stmt_str, 'join lschet ls on opl.clsch=ls.nrec                                                                                                      ');
  sqlAddStr(stmt_str, 'join katpodr on opl.cex=katpodr.nrec                                                                                                     ');
  sqlAddStr(stmt_str, 'join KLVIDOPL on opl.vosys=KLVIDOPL.vidopl                                                                                               ');
  sqlAddStr(stmt_str, 'where                                                                                                                                    ');
  if typerep=0
  {
    sqlAddStr(stmt_str, 'opl.yearn =' + string(year(d1)) + '                                             ');
    sqlAddStr(stmt_str, 'and opl.mesn = ' + string(month(d1)) + '                                                                    ');
  }
   if typerep=1
  {
    sqlAddStr(stmt_str, '(opl.yearn*65536 + opl.mesn*256 + 1)>=#date(' + DateToStr(d0, 'DD, MM, YYYY') +')    ');
    sqlAddStr(stmt_str, 'and (opl.yearn*65536 + opl.mesn*256 + 1)<=#date(' + DateToStr(d1, 'DD, MM, YYYY') +')      ');
  }
  sqlAddStr(stmt_str, 'and katpodr.kod not in (''Вет'', ''446'') and substring(katpodr.kod,1,1)<>''_''                                                          ');
  sqlAddStr(stmt_str, ') ooo                                                                                                                                    ');
  sqlAddStr(stmt_str, 'Group by ooo.tperson, ooo.strtabn ,ooo.fio,ooo.mesn,ooo.yearn, ooo.vo, ooo.VHVOE[32], ooo.VHVOE[34]                                      ');
  sqlAddStr(stmt_str, ', case when d_month(ooo.dates[2])<=ooo.mesn and d_year(ooo.dates[2])<=ooo.yearn and ooo.dates[2]<>0  then ''+'' else ''-'' end               ');
  sqlAddStr(stmt_str, 'order by ooo.fio                                                                                                                         ');

  var objQuery :  iQuery;
      objQuery := queryManager.createQuery(stmt_str);

  if (objQuery.Execute.ErrorCode <> tsOk) then
  {
    Message('Ошибка выполнения запроса ' + objQuery.ErrorCode, Error);
  }
  else
  {
    sqlCopyInto(objQuery, tnt01, true);
    result := RecordsInTable(tnt01);
  }

  sqlFreeStr(stmt_str);

  if typerep=1 //годовая версия отчета  0(месяц)/1(год)
  {
    // суммы страховых взносов
    sqlAddStr(stmt_str, 'select');
    sqlAddStr(stmt_str, 'per.tperson as tpers,per.mesn as mesn,per.yearn as yearn');
    sqlAddStr(stmt_str, ',sum(case when per.vidper = 5 then per.sumper else 0 end) as summ');
    sqlAddStr(stmt_str, ',sum(case when per.vidper in (11,12) then per.sumper else 0 end) as dtsumm');
    sqlAddStr(stmt_str, ',sum(case when per.vidper = 11 then per.sumper else 0 end) as dtSVsumm11');
    sqlAddStr(stmt_str, ',sum(case when per.vidper = 12 then per.sumper else 0 end) as dtSVsumm12');
    sqlAddStr(stmt_str, 'from perevod per');
    sqlAddStr(stmt_str, 'where');
    sqlAddStr(stmt_str, '(per.yearn*65536 + per.mesn*256 + 1)>=#date(' + DateToStr(d0, 'DD, MM, YYYY') +') ');
    sqlAddStr(stmt_str, 'and (per.yearn*65536 + per.mesn*256 + 1)<=#date(' + DateToStr(d1, 'DD, MM, YYYY') +') ');
    sqlAddStr(stmt_str, 'group by per.tperson,per.mesn,per.yearn');

    var objQuery :  iQuery;
        objQuery := queryManager.createQuery(stmt_str);

    if (objQuery.Execute.ErrorCode <> tsOk) then
    {
      Message('Ошибка выполнения запроса ' + objQuery.ErrorCode, Error);
    }
    else
    {
      sqlCopyInto(objQuery, tntper, true);
    }
    sqlFreeStr(stmt_str);

    // заполняем налоги до превыш. и после, циклом, тк месяца разбиты по столбам
    for(ii:=1; ii<=12; ii++)
    {
      sqlAddStr(stmt_str, '  select                                                              ');
      sqlAddStr(stmt_str, '  ss.tperson                                             as tpers     ');
      sqlAddStr(stmt_str, ' ,'+string(ii)+'                                         as mesn      ');
      sqlAddStr(stmt_str, ' ,'+string(year(d1))+'                                   as yearn     ');
      sqlAddStr(stmt_str, ' ,sum(ss.summa9['+string(ii)+'])                              as befNalog  ');
      sqlAddStr(stmt_str, ' ,sum(ss.snal['+string(ii)+'] - ss.summa9['+string(ii)+'])    as aftNalog  ');
      sqlAddStr(stmt_str, 'from sumupsoc ss                                                      ');
      sqlAddStr(stmt_str, 'where                                                                 ');
      sqlAddStr(stmt_str, 'ss.year=' + string(year(d1)) + '                                      ');
      sqlAddStr(stmt_str, 'and ss.vidper=5 and ss.snal['+string(ii)+']<>0                        ');
      sqlAddStr(stmt_str, 'group by                                                              ');
      sqlAddStr(stmt_str, '  ss.tperson                                                          ');

      var objQuery :  iQuery;
          objQuery := queryManager.createQuery(stmt_str);

      if (objQuery.Execute.ErrorCode <> tsOk) then
      {
        Message('Ошибка выполнения запроса для налога за месяц' + ii + ' ' + objQuery.ErrorCode, Error);
      }
      else
      {
        sqlCopyInto(objQuery, tntmpNalog, true);
      }
      sqlFreeStr(stmt_str);
    }// for(ii:=1; ii<=12; ii++)
  }
}

handleevent
cmInit:{
  d0 := date(1,month(cur_date),year(cur_date));
  d1 := date(last_day(cur_date),month(cur_date),year(cur_date));
  ClearFieldState(#d0,sfVisible);
}

cmCheckField:{
  case curfield of
   #TypeRep:{
        if TypeRep=0
        {
          d1 := date(last_day(cur_date),month(cur_date),year(cur_date));
          ClearFieldState(#d0,sfVisible);
        }
        else
        {
          SetFieldState(#d0,sfVisible);

        }
       }
  end;
}

cmPrintDoc: {
  delete all t01;
  delete all t02;
  delete all tPer;
  delete all tmpNalog;

  if TypeRep=1
  {
    if year(d0)<>year(d1)
    {
      message('Период должен быть в рамках года!');
      abort;
      exit;
    }
  }

   StartNewVisual(vtRotateVisual, vfBreak, 'Обработка выборки', 0);
      SetVisualHeader('Обработка результатов по запросу');
  fPrintDoc();
  _Loop t01
  {

    if (getFirst FastFirstRow t02 where ((t01.tperson == t02.tperson and t01.mesn == t02.mesn)) <> tsOk) then
    {
      ClearBuffer(#t02);
        t02.tperson := t01.tperson;
        t02.strtabn := t01.strtabn;
        t02.fio     := t01.fio;
        t02.mesn:= t01.mesn;
      Insert Current t02;
    }
  }


  var _sPr : string = '';
  _Loop t01
  {
    _sPr := t01.mark32 + t01.mark34 + t01.markdie;

    if (getFirst t02 where ((t01.tperson == t02.tperson and t01.mesn == t02.mesn)) = tsOk) then
    {
        t02.sum1    := t02.sum1+t01.sum1;

        case _sPr of
         '+--' : { update current t02 set t02.sum2 := t02.sum2 + t01.sum1; if t02.kod2='' {update current t02 set t02.kod2 := string(t01.kod)} else {update current t02 set t02.kod2 := t02.kod2 + ', ' + string(t01.kod)};}
         '++-' : { update current t02 set t02.sum2 := t02.sum2 + t01.sum1; if t02.kod2='' {update current t02 set t02.kod2 := string(t01.kod)} else {update current t02 set t02.kod2 := t02.kod2 + ', ' + string(t01.kod)};}
         '-+-' : { update current t02 set t02.sum3 := t02.sum3 + t01.sum1; if t02.kod3='' {update current t02 set t02.kod3 := string(t01.kod)} else {update current t02 set t02.kod3 := t02.kod3 + ', ' + string(t01.kod)};}
         '---','--+' : { update current t02 set t02.sum4 := t02.sum4 + t01.sum1; if t02.kod4='' {update current t02 set t02.kod4 := string(t01.kod)} else {update current t02 set t02.kod4 := t02.kod4 + ', ' + string(t01.kod)};}
         else { update current t02 set t02.sum3 := t02.sum3 + t01.sum1; if t02.kod3='' {update current t02 set t02.kod3 := string(t01.kod)} else {update current t02 set t02.kod3 := t02.kod3 + ', ' + string(t01.kod)};}
        end;

        if typerep=1
        {
          if getfirst tper where ((t01.tperson==tper.tpers and t01.mesn==tper.mesn and t01.yearn==tper.yearn )) = tsOk
          {
            t02.SVsumm:= tper.summ;
            t02.dtSVsumm:= tper.dtsumm;
            t02.dtSVsumm11:= tper.dtSVsumm11;
            t02.dtSVsumm12:= tper.dtSVsumm12;
            update current t02;
          }
          if getfirst tmpNalog where ((t01.tperson==tmpNalog.tpers and t01.mesn==tmpNalog.mesn and t01.yearn==tmpNalog.yearn )) = tsOk
          {
            t02.befNalog:= tmpNalog.befNalog;
            t02.aftNalog:= tmpNalog.aftNalog;
            update current t02;
          }
        }
    }
  }

  StopVisual;
  ReReadRecord;

  if (not xlCreateExcel('Rep57601' + DateToStr(Cur_Date(), '_YYYYMMDD') + TimeToStr(Cur_Time(), '_HHMMSS') + '.xlsx', true)) then
  {
    message('Не удалось открыть сессию Exel', error); exit;
  }
  if not xlIsExcelValid {
    message('Не удалось подключиться к Exel'); exit;
  }
  var row: integer =0;
  var col: integer =0;
    xlSetCellStringValue('Отчет для выверки ПС на '+month(d1)+'.'+year(d1), 1, 1 ,1 ,1);
    if typerep=1
    {
      xlSetCellStringValue('Отчет для выверки ПС на '+year(d1)+' год', 1, 1 ,1 ,1);
    }
    xlSetCellStringValue('п/п', 2, ++col ,2 ,col);
    xlSetCellStringValue('Табельный номер', 2, ++col ,2 ,col);
    xlSetCellStringValue('ФИО', 2, ++col ,2 ,col);
    if typerep=1
    {
      xlSetCellStringValue('Месяц', 2, ++col ,2 ,col);
    }
    xlSetCellStringValue('Доходы обл. страх. взносами', 2, ++col ,2 ,col);
    xlSetCellStringValue('Коды по доходам обл. страх. взносами', 2, ++col ,2 ,col);
    if typerep=1
    {
      xlSetCellStringValue('Сумма СВ, руб.', 2, ++col ,2 ,col);
      xlSetCellStringValue('Сумма СВ по доп. тарифу, руб.', 2, ++col ,2 ,col);
      xlSetCellStringValue('Список 1', 2, ++col ,2 ,col);
      xlSetCellStringValue('Список 2', 2, ++col ,2 ,col);
      xlSetCellStringValue('Сумма СВ 30%', 2, ++col ,2 ,col);
      xlSetCellStringValue('Сумма СВ 15,1%', 2, ++col ,2 ,col);
    }
    xlSetCellStringValue('Доходы не обл. страх. взносами', 2, ++col ,2 ,col);
    xlSetCellStringValue('Коды по доходам не обл. страх. взносами', 2, ++col ,2 ,col);
    xlSetCellStringValue('Доходы не явл. объектом н/о страх. взносами', 2, ++col ,2 ,col);
    xlSetCellStringValue('Коды по доходам не явл.', 2, ++col ,2 ,col);
    xlSetCellStringValue('Сумма дохода за месяц', 2, ++col ,2 ,col);
    if typerep=1
    {
      xlSetCellStringValue('Сумма дохода  (обл. и необл.) за месяц', 2, ++col ,2 ,col);
    }
    xlSetFontStyle(1,1,1,1,col);
    var st: integer =col;
    var countt: longint = 0;
    var counter: longint = 3;
    row:= 0;
    StartNewVisual(vtRotateVisual, vfBreak, 'Обработка выборки', 0);
    SetVisualHeader('Заполнение печатной формы');
    if (getfirst t02 = tsOk)
    {
    if(recordsintable(tnt02) = 0) message('Отсутствуют данные для построения отчета');
    else{


       xlCreateMatrix(recordsintable(tnt02), col);
       _loop t02{
        col := 0;
        countt++;
        row++;
        xlDoWriteToMatrix(  row, ++col, countt); //п/п
        xlStWriteToMatrix(  row, ++col, chr(39) + t02.strtabn);//Табельный номер
        xlStWriteToMatrix(  row, ++col, chr(39) + t02.fio);// фио
        if typerep=1
        {
          xlStWriteToMatrix(  row, ++col, chr(39) + t02.mesn); //Месяц
        }
        xlDoWriteToMatrix(  row, ++col, t02.sum2 );    //Доходы обл. страх. взносами
        xlStWriteToMatrix(  row, ++col, chr(39) + t02.kod2); //Коды по доходам обл. страх. взносами
        if typerep=1
        {
           xlDoWriteToMatrix(  row, ++col, t02.SVsumm );  //Сумма СВ, руб.
           xlDoWriteToMatrix(  row, ++col, t02.dtSVsumm ); //Сумма СВ по доп. тарифу, руб.
           xlDoWriteToMatrix(  row, ++col, t02.dtSVsumm11 );//Список 1
           xlDoWriteToMatrix(  row, ++col, t02.dtSVsumm12 );//Список 2
           xlDoWriteToMatrix(  row, ++col, t02.befNalog );//Сумма СВ 30%
           xlDoWriteToMatrix(  row, ++col, t02.aftNalog );//Сумма СВ 15,1%
        }
        xlDoWriteToMatrix(  row, ++col, t02.sum3 );//Доходы не обл. страх. взносами
        xlStWriteToMatrix(  row, ++col, chr(39) + t02.kod3); //Коды по доходам не обл. страх. взносами
        xlDoWriteToMatrix(  row, ++col, t02.sum4 );//Доходы не явл. объектом н/о страх. взносами
        xlStWriteToMatrix(  row, ++col, chr(39) + t02.kod4);//Коды по доходам не явл.
        xlDoWriteToMatrix(  row, ++col, t02.sum1 );//Сумма дохода за месяц
        if typerep=1
        {
         xlDoWriteToMatrix(  row, ++col, t02.sum1-t02.sum4 );     //Сумма дохода  (обл. и необл.) за месяц
        }

        if row = 1000
        {
          xlWriteMatrixToExcel(counter, 1);
          counter:= counter + row;
          xlClearMatrix;
          row:= 0;
        }
      }

    }
    XLWRITEMATRIXTOEXCEL(counter, 1);
    XLFREEMATRIX;
    counter:= counter + row;
    xlAlignCells(xlLeft,1,1,counter,st);
    xlSetColumnWidth(23,1,1,counter,st);
  }


  StopVisual;
  xlMergeCells(1,1,1,st);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0,1,1,counter, st);
  xlAutoFit(1,1, row,st);
  xlKillExcel;
}

end;
end.

#include UserReport.vih

VipInterface UserReport_Income_perMonth Implements IUserReport licensed(free);
Interface UserReport_Income_perMonth;

  create view;

  procedure Run;
  {
    runinterfacenomodal(Income_perMonth);
  }

  function GetReportName: String;
  {
    GetReportName := 'Отчет для выверки ПС';
  }

  function GetGroupName (Level : Word) : String;
  {
    if (Level = 1)
      GetGroupName := ''
    else
      GetGroupName := '';
  }

  function GetPriority : Integer;
  {
    GetPriority := 0;
  }

  function VisibleInModule(Ind : Byte) : String;
  {
    VisibleInModule := '';
    case Ind of
      1: result:= 'menuzarp';
    end;
  }
end.
