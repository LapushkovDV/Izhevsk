      if (tmpRasprLoop.wType = 0) then
      {
        tmpRasprLoop.dSum        := if ((100.0 - perc_goz) > 0.0, Round(Round((100.0 - perc_goz) / 100, 4)* tmpRasprLoop.dSum, 2), 0)  ;
        tmpRasprLoop.dNdfl       := if ((100.0 - perc_goz) > 0.0, Round(Round((100.0 - perc_goz) / 100, 4)* tmpRasprLoop.dNdfl, 2), 0)  ;
        update current tmpRasprLoop;
      }
      */
    }

    _Loop tmpRasprLoop where ((0h == tmpRasprLoop.cVplan))
    {
      SetVisualHeader('Просмотр текущего распределения (GP_AvansRaspr)'#13 +
                       tmpRasprLoop.sPerson);
      //MyLog('debug_tmpRasprLoop.sPerson = ' + tmpRasprLoop.sPerson);
      //MyLog('debug_tmpRasprLoop.clschet = ' + tmpRasprLoop.clschet);
      //MyLog('debug_dBeg = ' + dBeg);
      //MyLog('debug_dEnd = ' + dEnd);




        _Loop gp_raspavansLoop
        {
          //MyLog('debug_gp_raspavans.nrec = ' + gp_raspavans.nrec);

          if (getFirst tmpRasprIns where ((tmpRasprLoop.clschet == tmpRasprIns.clschet
                                           and gp_raspavansLoop.cvplan == tmpRasprIns.cVplan (noIndex)
                                           and gp_raspavansLoop.wtype == tmpRasprIns.wtype   (noIndex)
                                           )) <> tsOk)
          {
            tmpRasprIns.Buffer := tmpRasprLoop.Buffer;

            tmpRasprIns.dSumGoz := Round((tmpRasprLoop.dSum +tmpRasprLoop.dNdfl )* gp_raspavansLoop.procent / 100.0, coDecimalPoint);
            tmpRasprIns.dPercent := gp_raspavansLoop.procent;
            tmpRasprIns.cvPlan := gp_raspavansLoop.cVplan;
            tmpRasprIns.wType := gp_raspavansLoop.wType;
            Insert Current tmpRasprIns;
            MyLog('Fill_tmpRaspr tmpRasprIns.stabn = ' + tmpRasprIns.stabn);
            MyLog('Fill_tmpRaspr tmpRasprIns.dSumGoz = ' + tmpRasprIns.dSumGoz);
            MyLog('Fill_tmpRaspr tmpRasprIns.dPercent = ' + tmpRasprIns.dPercent);
          }
          Update current tmpRasprIns set tmpRasprIns.dPercentOld := gp_raspavansLoop.procent;

        }
        //MyLog('debug__Loop gp_raspavans     end');


    }


   _Loop tmpRasprLoop
    {
      if getfirst unidoc_vplan where (( word(31015)==unidoc_vplan.wtype
                                        and tmpRasprLoop.cVPlan==unidoc_vplan.cpodr))=tsOk
      {
        tmpRasprLoop.wtype:=word(3);
        tmpRasprLoop.cvplan:=comp(coVirtualcVPlan2);
        update current tmpRasprLoop;
      }
    }


  UpdateItogsByVPlan;
  //delete tmpRasprIns where ((2 >> tmpRasprIns.dPercent(noindex)));
  //delete from tmpRasprIns where tmpRasprIns.dPercent < 0.02;
  /*_Loop tmpRasprIns
  {
    logstrtofile('666-6.log', 'sTabN = ' + tmpRasprIns.sTabN + ' | ' + tmpRasprIns.dPercent + ' | ' + boolean(2 > tmpRasprIns.dPercent));
  }*/


  if (getFirst tmpRaspr = tsOk) then {ReScanPanel(tntmpRaspr);}
  sqlFreeStr(qStr);
  StopVisual;
}

Function CheckPodr(_cPodr: comp) : boolean; Cacheable;
{
  result := false;
    if(getfirst fastfirstrow  KatLinkPodr where ((     coKatPodr == KatLinkPodr.codeTable
                                                     and KL_code == KatLinkPodr.code
                                                       and KL_on == KatLinkPodr.ownname
                                                      and _cPodr == KatLinkPodr.cRec (noIndex)
                                                ))
      ) = tsOK then exit;
  result := true;
}

Function CheckLSchet(_cLs : comp) : boolean;
{
  result := false;
  if (getfirst fastfirstrow LschetCheck where ((_cLs == LschetCheck.nrec)) = tsOK)
  {

    if not CheckPodr(LschetCheck.cex) then exit;

    if(getfirst fastfirstrow  KatLinkPsn  where ((               coPersons == KatLinkPsn.codeTable
                                                   and             KL_code == KatLinkPsn.code
                                                   and               KL_on == KatLinkPsn.ownname
                                                   and LschetCheck.tPerson == KatLinkPsn.cRec (noIndex)
                                                ))
      ) = tsOK then exit;
     result := true;
  }
}

//сумма аванса/зп всех накладных - сумма по исключаемым подразделениям и людям
Function Get_Sum_vplan_WO_Excl(bFlag : boolean) : double; Cacheable;
{
  #__UNUSED__(bFlag)
  StartNewVisual(vtRotateVisual, vfTimer, 'Подсчет итогов с исключениями', 0);
  var _Sum  : double= 0.0;
  var _SumNDFL :double= 0.0;

  _Loop tmpRasprLoop_Fn_GOZ where ((0h == tmpRasprLoop_Fn_GOZ.cVPlan))
  {
    //if (CheckLSchet(tmpRasprLoop_Fn_GOZ.cLSchet)) then
    //{
    //      mylog(tmpRasprLoop.sPerson +'|'+tmpRasprLoop.sTabN+'|'+tmpRasprLoop.dSum+'|'+tmpRasprLoop.dNdfl);
    var perc_goz : double = Get_Total_Straight_Goz(tmpRasprLoop_Fn_GOZ.clschet);

    if 100.0 <= perc_goz then continue ;

    _Sum     := _Sum     + Round(tmpRasprLoop_Fn_GOZ.dSum  * (100.0 - perc_goz) / 100, coDecimalPoint);
    _SumNDFL := _SumNDFL + Round(tmpRasprLoop_Fn_GOZ.dNdfl * (100.0 - perc_goz) / 100, coDecimalPoint);

    mylog('Get_Sum_vplan_WO_Excl-> '+tmpRasprLoop_Fn_GOZ.sPerson +'|'+tmpRasprLoop_Fn_GOZ.sTabN+'|'+tmpRasprLoop_Fn_GOZ.dSum+'|'+tmpRasprLoop_Fn_GOZ.dNdfl+'|'+perc_goz+'|'+_Sum + '|'+_SumNDFL);
    //}
  }
  result := _Sum + _SumNDFL;
  StopVisual;
}

//вся тематика
Function Get_Total_Straight_Goz(_cLscht : comp) : double; Cacheable;
{
  result := 0.0;
  _loop tmpRasprLoop_Straight_Goz where ((  _cLscht == tmpRasprLoop_Straight_Goz.clschet
                             )) //and tmpRasprLoop_Straight_Goz.cVPlan <> 0h
                                and tmpRasprLoop_Straight_Goz.wType > 0
  {
    result += tmpRasprLoop_Straight_Goz.dPercent
  }
//  mylog('Get_Total_Straight_Goz-> '+tmpRasprLoop_Straight_Goz.sPerson +'|'+tmpRasprLoop_Straight_Goz.sTabN+'|'+tmpRasprLoop_Straight_Goz.dSum+'|'+tmpRasprLoop_Straight_Goz.dNdfl+'|'+result);
}

Function Get_Total_perc_Goz(_cLscht : comp) : double;
{
  result := 0.0;
  _loop tmpRasprLoop_Fn_GOZ where ((  _cLscht == tmpRasprLoop_Fn_GOZ.clschet
                             )) and tmpRasprLoop_Fn_GOZ.cVPlan <> 0h
//                                and tmpRasprLoop_Straight_Goz.wType <> 2
  {
    MyLog('Get_Total_perc_Goz tmpRasprLoop_Fn_GOZ.dPercent = ' + tmpRasprLoop_Fn_GOZ.dPercent);
    result += tmpRasprLoop_Fn_GOZ.dPercent
  }

}

//wAlg = 0 : считаем от суммы, wAlg = 1 : от процента
Procedure DistrPlanSum(wAlg : word);
{
  StartNewVisual(vtRotateVisual, vfTimer, 'Распределение суммы по накладным', 0);
  delete tmpRasprIns where (( tmpItog.cVplan == tmpRasprIns.cvPlan and 0 == tmpRasprIns.wType));
 // update current tmpItog set tmpItog.dSumRaspFactO := 0;

  if (tmpItog.dSumRaspPlan <= 0.0 and wAlg = 0)
    or (tmpItog.dPercent <= 0.0 and wAlg = 1)   then
  {
    UpdateItogsByVPlan;
    StopVisual;
    Exit;
  }
  var sItogZp : double = Get_Sum_vplan_WO_Excl(true);

  var dPerc : double = 0.0;
  if (wAlg = 0) then
  {
    dPerc := Round(tmpItog.dSumRaspPlan / sItogZp, coDecimalPoint+2) ;
    MyLog('DistrPlanSum wAlg = 0');
    MyLog('DistrPlanSum dPerc = ' + dPerc);
//    update current tmpItog set tmpItog.dPercent := dPerc * 100.0;
  }
  if (wAlg = 1) then
  {
    dPerc := tmpItog.dPercent / 100.0;
    MyLog('DistrPlanSum wAlg = 1');
    MyLog('DistrPlanSum dPerc = ' + dPerc);
  }

  /*
  _Loop tmpRasprLoop
  {
    MyLog('DistrPlanSum debug stabn --------------------------------- ');
    MyLog('DistrPlanSum debug stabn = ' + tmpRasprLoop.stabn);
    MyLog('DistrPlanSum debug cvplan = ' + tmpRasprLoop.cvplan);
    MyLog('DistrPlanSum debug stabn --------------------------------- ');
  }
  */

  _Loop tmpRasprLoop where ((0h == tmpRasprLoop.cVPlan))
  {
    MyLog('DistrPlanSum tmpRasprLoop.stabn = ' + tmpRasprLoop.stabn);
    /*if (not CheckLSchet(tmpRasprLoop.clschet)) then
    {
      MyLog('DistrPlanSum пропускаем');
      continue;
    }*/
/* варивант 1,0 beta
    var _curPerc : double = Get_Total_perc_Goz(tmpRasprLoop.clschet);  // прямые и накладные по гоз в сумме

    var _PercPersonal : double = Round(dPerc * 100, 2); // ввели/расчитали в интерыейс

    if _curPerc >= 100  then continue;   // если по ГОЗ уже 100 или даже большлше

//если ввели/расчитали процнт+уже проценты по всем ГОЗ больше 100 то перпсональный процент равен 100 - уже рспраделенное, т.е. мы
// будем рспраделеять не ввведнный процент, а остаток до 100
    if _PercPersonal + _curPerc > 100  then _PercPersonal := 100 - _curPerc;  // реальный проуцент который будем ставить на сумму для ркспределдения

    _PercPersonal := round(_PercPersonal / 100, 4);

    //tmpRasprIns.dSumGoz := Round((tmpRasprLoop.dSum + tmpRasprLoop.dNdfl) * _PercPersonal, 2);
    tmpRasprIns.Buffer := tmpRasprLoop.Buffer;

    var perc_goz : double = Get_Total_Straight_Goz(tmpRasprLoop.clschet); // сумма по прямым процентам ГОЗ

    var _perc_wo_goz : double = if ((100.0 - perc_goz) > 0.0, Round((100.0 - perc_goz) / 100, 4), 0); // остаток проуцента без ГОЗ


    tmpRasprIns.dSumGoz := Round(tmpRasprLoop.dSum * _perc_wo_goz * _PercPersonal, 2) + Round(tmpRasprLoop.dNdfl * _perc_wo_goz * _PercPersonal, 2);
*/

/* вариант 2... математику все-таки не наеб*шь

    var _curPercGOZ : double = Get_Total_perc_Goz(tmpRasprLoop.clschet);  // прямые и накладные по гоз в сумме
    MyLog('DistrPlanSum _curPercGOZ = ' + _curPercGOZ);
    if _curPercGOZ >= 100  then continue;   // если по ГОЗ уже 100 или даже большлше

    var _PercPersonal : double = Round(dPerc * 100, coDecimalPoint); // ввели/расчитали в интерыейс
    MyLog('DistrPlanSum _PercPersonal 1 = ' + _PercPersonal);

    //если ввели/расчитали процнт+уже проценты по всем ГОЗ больше 100 то перпсональный процент равен 100 - уже рспраделенное, т.е. мы
    // будем рспраделеять не ввведнный процент, а остаток до 100

    if _PercPersonal + _curPercGOZ > 100  then _PercPersonal := 100 - _curPercGOZ;  // реальный проуцент который будем ставить на сумму для ркспределдения
    MyLog('DistrPlanSum _PercPersonal 2 = ' + _PercPersonal);
    _PercPersonal := round(_PercPersonal / 100, coDecimalPoint+2);
    MyLog('DistrPlanSum _PercPersonal 3 = ' + _PercPersonal);



    //tmpRasprIns.dSumGoz := Round((tmpRasprLoop.dSum + tmpRasprLoop.dNdfl) * _PercPersonal, 2);
    tmpRasprIns.Buffer := tmpRasprLoop.Buffer;


    tmpRasprIns.dSumGoz := Round(tmpRasprLoop.dSum  * _PercPersonal, coDecimalPoint) + Round(tmpRasprLoop.dNdfl * _PercPersonal, coDecimalPointNDFL);
    MyLog('DistrPlanSum tmpRasprIns.dSum = ' + tmpRasprIns.dSum);
    MyLog('DistrPlanSum tmpRasprIns.dNdfl = ' + tmpRasprIns.dNdfl);
    MyLog('DistrPlanSum tmpRasprIns.dSumGoz = ' + tmpRasprIns.dSumGoz);
    tmpRasprIns.dPercent := Round(tmpRasprIns.dSumGoz / (tmpRasprLoop.dSum + tmpRasprLoop.dNdfl) * 100.0, coDecimalPoint);
    MyLog('DistrPlanSum tmpRasprIns.dPercent = ' + tmpRasprIns.dPercent);
*/


// а делать то надо вот так ....  математику все-таки не наеб*шь

  var _curPercGOZ : double = Get_Total_Straight_Goz(tmpRasprLoop.clschet);  // прямые и накладные по гоз в сумме
    if _curPercGOZ >= 100  then continue;   // если по ГОЗ уже 100 или даже большлше

    var _PercPersonal : double = Round((100 - _curPercGOZ )*dPerc , coDecimalPoint); // ввели/расчитали в интерыейс
    MyLog('DistrPlanSum _PercPersonal 1 = ' + _PercPersonal);

    //если ввели/расчитали процнт+уже проценты по всем ГОЗ больше 100 то перпсональный процент равен 100 - уже рспраделенное, т.е. мы
    // будем рспраделеять не ввведнный процент, а остаток до 100

    var _sumAlreadyRaspr : double = Get_Total_perc_Goz(tmpRasprLoop.clschet);

    if _PercPersonal + _sumAlreadyRaspr > 100  then _PercPersonal := 100 - _sumAlreadyRaspr;  // реальный проуцент который будем ставить на сумму для ркспределдения

    MyLog('DistrPlanSum _PercPersonal 2 = ' + _PercPersonal);
    _PercPersonal := round(_PercPersonal / 100, coDecimalPoint+2);
    MyLog('DistrPlanSum _PercPersonal 3 = ' + _PercPersonal);



    //tmpRasprIns.dSumGoz := Round((tmpRasprLoop.dSum + tmpRasprLoop.dNdfl) * _PercPersonal, 2);
    tmpRasprIns.Buffer := tmpRasprLoop.Buffer;


    tmpRasprIns.dSumGoz := Round((tmpRasprLoop.dSum  + tmpRasprLoop.dNdfl )* _PercPersonal, coDecimalPoint);
    MyLog('DistrPlanSum tmpRasprIns.dSum = ' + tmpRasprIns.dSum);
    MyLog('DistrPlanSum tmpRasprIns.dNdfl = ' + tmpRasprIns.dNdfl);
    MyLog('DistrPlanSum tmpRasprIns.dSumGoz = ' + tmpRasprIns.dSumGoz);
    tmpRasprIns.dPercent := Round(tmpRasprIns.dSumGoz / (tmpRasprLoop.dSum + tmpRasprLoop.dNdfl) * 100.0, coDecimalPoint);
    MyLog('DistrPlanSum tmpRasprIns.dPercent = ' + tmpRasprIns.dPercent);

    tmpRasprIns.wType := 0;
    tmpRasprIns.cvPlan := tmpItog.cVplan;
    if (getFirst gp_raspavansLoop where ((     tmpRasprIns.clschet == gp_raspavansLoop.clschet
                                          and 0 == gp_raspavansLoop.isarh
                                          and dBeg == gp_raspavansLoop.datan
                                          and dEnd == gp_raspavansLoop.dataok (noIndex)
                                          and tmpRasprIns.cvplan == gp_raspavansLoop.cvplan (noIndex)
                                          and tmpRasprIns.wtype == gp_raspavansLoop.wtype (noIndex)
                                          )) = tsOk ) then
    {
      tmpRasprIns.dPercentOld := gp_raspavansLoop.Procent;
      MyLog('DistrPlanSum tmpRasprIns.dPercentOld = ' + tmpRasprIns.dPercentOld);
    }
    Insert Current tmpRasprIns;


   // tmpItog.dSumRaspFactO := tmpItog.dSumRaspFactO  + tmpRasprIns.dSumGoz;
  }
//  Update current tmpItog;
  UpdateItogsByVPlan;
    if (getFirst tmpRaspr = tsOk) then {ReScanPanel(tntmpRaspr);}

      set _strWarning1 := 'ВНИМАНИЕ! Внесены изменения' ;
      set _strWarning2 := 'Данные в интерфейсе могут отличаться от хранимых';

  StopVisual;
}

Procedure DeleteFromGpRaspAvans;
{
  SetVisualHeader('Удаление записей распределения из базы');
  Delete From Gp_RaspAvans where ((       0 == Gp_RaspAvans.isarh
                                   and dBeg == Gp_RaspAvans.datan  (noIndex)
                                   and dEnd == Gp_RaspAvans.dataok (noIndex)
                                   //and    0 == Gp_RaspAvans.wtype (noIndex)
                                 ))
  ;
}

Procedure CopyToGpRaspAvansFromTRasp;
{
  SetVisualHeader('Сохранение записей распределения в базу');
  _Loop tmpRaspr
  {
    if tmpRaspr.dpercent < 2 or tmpRaspr.wtype = 2 or tmpRaspr.wtype = 3 or tmpRaspr.cvplan = 0h then continue; // это точно не надо сохранять

    //if (tmpRaspr.wtype = 1) then { continue; }
    Insert Gp_RaspAvans set
       gp_raspavans.isarh    := 0
     , gp_raspavans.datan    := dBeg
     , gp_raspavans.dataok   := dEnd
     , gp_raspavans.procent  := tmpRaspr.dpercent
     , gp_raspavans.wtype    := tmpRaspr.wtype
     , gp_raspavans.cvplan   := tmpRaspr.cvplan
     , gp_raspavans.cpersons := tmpRaspr.cperson
     , gp_raspavans.clschet  := tmpRaspr.clschet
     , gp_raspavans.TABN     := 0
     , gp_raspavans.STRTABN  := tmpRaspr.sTabN
     , gp_raspavans.CKATPODR := Lschet.cex
     , gp_raspavans.CMNPLAN  := 0h
     , gp_raspavans.CUSER    := UserID
     , gp_raspavans.DINPUT   := Cur_Date()

    ;
  }
}

Function CheckFactSum : boolean;
{
  _Loop tmpItog
  {
    if (tmpItog.cVPlan = comp(coVirtualcVPlan)) then
    {
      continue;
    }
    if ( tmpItog.dSumRaspPlan < tmpItog.dSumRaspFactO) then
    {
      result := false;
      Exit;
    }
  }
  result := true;
}

Procedure SavePlanSum;
{
  //сохраняем плановую сумму к распределению в spkau
  //записываем vplan.name и vplan.nrec
  if (getFirst FastFirstRow SpKau where ((      wSpKau == SpKau.KodGrKau
                                            and cSpKau == SpKau.cNode
//                                            and vPlanItog.Name == SpKau.Name
                                            and string(vPlanItog.nRec) == SpKau.LevelCode (noIndex)
                                        )) <> tsOk) then
  {
    ClearBuffer(#SpKau);
      SpKau.nRec      := 0h;
      SpKau.Name      := vPlanItog.Name;
      SpKau.LevelCode := string(vPlanItog.nRec);
      SpKau.cNode     := cSpKau;
      SpKau.KodGrKau  := wSpKau;
    Insert Current SpKau;
  }
   SpKau.Code := String(tmpItog.dSumRaspPlan);
  Update Current SpKau;
}

Procedure DeleteUnusedPlanSum;
{
  _Loop tmpItogLoop where tmpItogLoop.dSumRaspPlan = 0.0
  {
    if ( getFirst FastFirstRow SpKau where ((     wSpKau == SpKau.KodGrKau
                                              and cSpKau == SpKau.cNode
                                              and string(tmpItogLoop.cVPlan) == SpKau.LevelCode
                                           )) = tsOk) then
    {
      Delete Current SpKau;
    }
  }
}

Procedure ReFill_ExclPsn(_w : word);
{
  Delete All TmpIndPsn;

  Delete From KatLinkPsn where ((      coPersons == KatLinkPsn.codetable
                                   and KL_code   == KatLinkPsn.code
                                   and KL_on     == KatLinkPsn.ownName
                                   and 666       == KatLinkPsn.Tune1     (noIndex) ));

  var dUv : date = dGetTune('UP.DATOTCH');
  //чтобы не поломать текущее распределение
  if (dUv < date(01, 07, 2022)) then
  {
    Message('не прошли по дате');
    Exit;
  }
  else
  {
    var qStr : longint = 0;

    StartNewVisual(vtRotateVisual, vfTimer, 'Обработка списка сотрудников', 0);
    sqlFreeStr(qStr);

    if (_w = 0) then
    {
      MysqlAddStr(qStr, ' select distinct                                                                                                                          ');
      MysqlAddStr(qStr, '   persons.nrec as cpers                                                                                                                  ');
      MysqlAddStr(qStr, ' from persons                                                                                                                             ');
      MysqlAddStr(qStr, ' inner join attrnam an on 25001 = an.wtable and ''Физическое лицо (контрагент)'' = an.name                                                ');
      MysqlAddStr(qStr, ' inner join attrval av on 25001 = av.wtable and an.nrec = av.cattrnam and persons.nrec = av.crec                                          ');
      MysqlAddStr(qStr, ' inner join katorgdescr on av.vcomp = katorgdescr.crec                                                                                    ');
      MysqlAddStr(qStr, ' where    (persons.disdate = #date(0, 0, 0)                                                                                               ');
      MysqlAddStr(qStr, '        or persons.disdate > #date(' + Day(1) + ', ' + Month(dUv) + ', ' + Year(dUv) + '))                                                ');
      MysqlAddStr(qStr, '        and katorgdescr.cgroup = #comp(' + string(IndGroup) + ')                                                                          ');
      MysqlAddStr(qStr, '        and persons.nrec not in (                                                                                                         ');
      MysqlAddStr(qStr, '                                    select distinct                                                                                       ');
      MysqlAddStr(qStr, '                                      gp_raspavans.cpersons as cPers                                                                      ');
      MysqlAddStr(qStr, '                                    from gp_raspavans                                                                                     ');
      MysqlAddStr(qStr, '                                    where     gp_raspavans.isarh = 0                                                                      ');
      MysqlAddStr(qStr, '                                          and gp_raspavans.wtype <> 0                                                                     ');
      MysqlAddStr(qStr, '                                          and gp_raspavans.datan  >= #date(' + Day(1)        + ', ' + Month(dUv) + ', ' + Year(dUv) + ')  ');
      MysqlAddStr(qStr, '                                          and gp_raspavans.dataok <= #date(' + Last_Day(dUv) + ', ' + Month(dUv) + ', ' + Year(dUv) + ')  ');
      MysqlAddStr(qStr, '        )                                                                                                                                 ');
    }
    if (_w = 1) then
    {
      MysqlAddStr(qStr, ' select distinct                                                                                                                          ');
      MysqlAddStr(qStr, '   t.cPers as cPers                                                                                                                       ');
      MysqlAddStr(qStr, ' from (                                                                                                                                   ');
      MysqlAddStr(qStr, '         select                                                                                                                           ');
      MysqlAddStr(qStr, '           lschet.tperson as cPers                                                                                                        ');
      MysqlAddStr(qStr, '         from prnaryad                                                                                                                    ');
      MysqlAddStr(qStr, '         left join lschet on prnaryad.clsch = lschet.nrec                                                                                 ');
      MysqlAddStr(qStr, '         left join sys_nar on prnaryad.mnrec = sys_nar.nrec                                                                               ');
      MysqlAddStr(qStr, '         left join mnplan on case when prnaryad.tbld[1] = 7 then prnaryad.ckaud[1]                                                        ');
      MysqlAddStr(qStr, '                                  when prnaryad.tbld[2] = 7 then prnaryad.ckaud[2]                                                        ');
      MysqlAddStr(qStr, '                                  when prnaryad.tbld[3] = 7 then prnaryad.ckaud[3]                                                        ');
      MysqlAddStr(qStr, '                                  when prnaryad.tbld[4] = 7 then prnaryad.ckaud[4]                                                        ');
      MysqlAddStr(qStr, '                                  when prnaryad.tbld[5] = 7 then prnaryad.ckaud[5]                                                        ');
      MysqlAddStr(qStr, '                                  when prnaryad.tbld[6] = 7 then prnaryad.ckaud[6]                                                        ');
      MysqlAddStr(qStr, '                                  else #comp(0h)                                                                                          ');
      MysqlAddStr(qStr, '                             end = mnplan.nrec                                                                                            ');
      MysqlAddStr(qStr, '         left join buhschet on mnplan.canval2 = buhschet.nrec                                                                             ');
      MysqlAddStr(qStr, '         left join attrnam an on 25001 = an.wtable and ''Физическое лицо (контрагент)'' = an.name                                         ');
      MysqlAddStr(qStr, '         left join attrval av on 25001 = av.wtable and an.nrec = av.cattrnam and lschet.tperson = av.crec                                 ');
      MysqlAddStr(qStr, '         left join katorgdescr on av.vcomp = katorgdescr.crec                                                                             ');
      MysqlAddStr(qStr, '         where     sys_nar.choice < 900                                                                                                   ');
      MysqlAddStr(qStr, '               and prnaryad.datan >= #date(' + Day(1) + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                                         ');
      MysqlAddStr(qStr, '               and (#date(' + Day(1)        + ', ' + Month(dUv) + ', ' + Year(dUv) + ') <= prnaryad.DatOk or                              ');
      MysqlAddStr(qStr, '                    prnaryad.DatOk = #date(0, 0, 0))                                                                                      ');
      MysqlAddStr(qStr, '               and mnplan.nrec is not null                                                                                                ');
      MysqlAddStr(qStr, '               and lschet.summa27 <> 0                                                                                                    ');
      MysqlAddStr(qStr, '               and katorgdescr.cgroup = #comp(' + string(IndGroup) + ')                                                                   ');
      MysqlAddStr(qStr, '               and ( lschet.datuv = #date(0, 0, 0) or                                                                                     ');
      MysqlAddStr(qStr, '                     lschet.datuv >= #date(' + Day(1) + ', ' + Month(dUv) + ', ' + Year(dUv) + ') )                                       ');
      MysqlAddStr(qStr, '               and (substring(buhschet.schet, 2, 2) in (''25'', ''26'') or                                                                ');
      MysqlAddStr(qStr, '                    substring(mnplan.number, 1, 2) in (''70'', ''71'', ''72'', ''73'', ''74'', ''75'', ''76'', ''48'') or                 ');
      MysqlAddStr(qStr, '                    mnplan.number in (''239000000120'', ''239000300120'')                                                                 ');
      MysqlAddStr(qStr, '               )                                                                                                                          ');
      MysqlAddStr(qStr, '         union all                                                                                                                        ');
      MysqlAddStr(qStr, '         select                                                                                                                           ');
      MysqlAddStr(qStr, '           lschet.tperson as cPers                                                                                                        ');
      MysqlAddStr(qStr, '         from prvidopl                                                                                                                    ');
      MysqlAddStr(qStr, '         left join lschet on prvidopl.clsch = lschet.nrec                                                                                 ');
      MysqlAddStr(qStr, '         left join mnplan on case when prvidopl.tbld[1] = 7 then prvidopl.ckaud[1]                                                        ');
      MysqlAddStr(qStr, '                                  when prvidopl.tbld[2] = 7 then prvidopl.ckaud[2]                                                        ');
      MysqlAddStr(qStr, '                                  when prvidopl.tbld[3] = 7 then prvidopl.ckaud[3]                                                        ');
      MysqlAddStr(qStr, '                                  when prvidopl.tbld[4] = 7 then prvidopl.ckaud[4]                                                        ');
      MysqlAddStr(qStr, '                                  when prvidopl.tbld[5] = 7 then prvidopl.ckaud[5]                                                        ');
      MysqlAddStr(qStr, '                                  when prvidopl.tbld[6] = 7 then prvidopl.ckaud[6]                                                        ');
      MysqlAddStr(qStr, '                                  else #comp(0h)                                                                                          ');
      MysqlAddStr(qStr, '                             end = mnplan.nrec                                                                                            ');
      MysqlAddStr(qStr, '         left join buhschet on mnplan.canval2 = buhschet.nrec                                                                             ');
      MysqlAddStr(qStr, '         left join attrnam an on 25001 = an.wtable and ''Физическое лицо (контрагент)'' = an.name                                         ');
      MysqlAddStr(qStr, '         left join attrval av on 25001 = av.wtable and an.nrec = av.cattrnam and lschet.tperson = av.crec                                 ');
      MysqlAddStr(qStr, '         left join katorgdescr on av.vcomp = katorgdescr.crec                                                                             ');
      MysqlAddStr(qStr, '         where     prvidopl.datan between #date(' + Day(1)        + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                             ');
      MysqlAddStr(qStr, '                                      and #date(' + Last_Day(dUv) + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                             ');
      MysqlAddStr(qStr, '               and prvidopl.datok between #date(' + Day(1)        + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                             ');
      MysqlAddStr(qStr, '                                      and #date(' + Last_Day(dUv) + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                             ');
      MysqlAddStr(qStr, '               and mnplan.nrec is not null                                                                                                ');
      MysqlAddStr(qStr, '               and lschet.summa27 <> 0                                                                                                    ');
      MysqlAddStr(qStr, '               and katorgdescr.cgroup = #comp(' + string(IndGroup) + ')                                                                   ');
      MysqlAddStr(qStr, '               and ( lschet.datuv = #date(0, 0, 0) or                                                                                     ');
      MysqlAddStr(qStr, '                     lschet.datuv >= #date(' + Day(1) + ', ' + Month(dUv) + ', ' + Year(dUv) + ') )                                       ');
      MysqlAddStr(qStr, '               and (substring(buhschet.schet, 2, 2) in (''25'', ''26'') or                                                                ');
      MysqlAddStr(qStr, '                    substring(mnplan.number, 1, 2) in (''70'', ''71'', ''72'', ''73'', ''74'', ''75'', ''76'', ''48'') or                 ');
      MysqlAddStr(qStr, '                    mnplan.number in (''239000000120'', ''239000300120''))                                                                ');
      MysqlAddStr(qStr, ' ) t                                                                                                                                      ');
    }


    var objQuery: iQuery;
        objQuery := queryManager.createQuery(qStr);

    if (objQuery.execute.errorCode != tsOk) then
    {
      Message('Ошибка обработки списка сотрудников (ReFill_ExclPsn) ' + objQuery.errorCode, Error);
    }
    else
    {
      sqlCopyInto(objQuery, tnTmpIndPsn, true);
//      message(RecordsInTable(tnTmpIndPsn));
    }
    sqlFreeStr(qStr);

    _Loop TmpIndPsn
    {
      if (RecordExists KatLinkPsn where ((     coPersons       == KatLinkPsn.codetable
                                           and KL_code         == KatLinkPsn.code
                                           and KL_on           == KatLinkPsn.ownName
                                           and TmpIndPsn.cPers == KatLinkPsn.crec (noIndex) )) <> tsOk)
      Insert KatLinkPsn
      Set    KatLinkPsn.codetable := coPersons
           , KatLinkPsn.code      := KL_code
           , KatLinkPsn.ownName   := KL_on
           , KatLinkPsn.crec      := TmpIndPsn.cPers
           , KatLinkPsn.Tune1     := 666;               //признак того, что добавлено автоматом
    }

    StopVisual;
  }
}

HandleEvent
cmInit:
{
  set _log := 'em_avans_zar_' + DateToStr(Cur_Date(),'_YYYYMMDD')+ TimeToStr(Cur_Time(),'_HHMMSS') + '.log';

  if( getFirst KatKau where (( wGetTune('NPOEM_OWN.ZP.PLAN_DISTR_SPKAU') == KatKau.KodGroup )) <> tsOk ) then
  {
     Message('Не указана настройка ' + GetTuneName('NPOEM_OWN.ZP.PLAN_DISTR_SPKAU') + ''#13 +
             'Интерфейс работать не будет.', Error );
     Abort; Exit;
  }
  else
  {
    set wSpKau := KatKau.KodGroup;
  }

  /*
    чтобы по индивидуальным не формировались платежки по 2 рубля, убираем их автоматом
    из перечня сотрудников в список исключений
  */
  ReFill_ExclPsn(_TypeFot);

  _strWarning1 := _strWarning2 := '';
//  FillSpkau_period;
  Fill_tmpItog;
  Fill_tmpRaspr;
}

cmCheckField:
{
  case CurField of
    #_TypeFot :
    {
      /*
        чтобы по индивидуальным не формировались платежки по 2 рубля, убираем их автоматом
        из перечня сотрудников в список исключений
      */
      ReFill_ExclPsn(_TypeFot);
      Fill_tmpRaspr;
    }
    #tmpItog.dSumRaspPlan :
    {
      if (tmpItog.cVPlan = comp(coVirtualcVPlan)) then
      {
         tmpItog.dSumRaspPlan := 0.0;
      }
      if (tmpItog.dSumRaspPlan = 0.0) then
      {
        tmpItog.dPercent := 0.0;
      }
      Update current tmpItog;
      SavePlanSum;
      DistrPlanSum(0);
    }
    #tmpItog.dPercent :
    {
      tmpItog.dPercent := Round(tmpItog.dPercent, coDecimalPoint);
      if (tmpItog.dPercent = 0.0) then
      {
        tmpItog.dSumRaspPlan := 0.0;
      }
      Update current tmpItog;
      DistrPlanSum(1);
    }
  end;
  ReReadRecord;
}

cmValue1:
{
  Message('В работе');
}

cmHotKeys:
{
  PutHotCommand(RunDynMenu('GP_ZP::EmRaspAvansZar_HotKeys'));
}




cmValue11:
{
 set curTypeExcl := cgKau_KatPodr;
  Runwindowmodal(winPickExcludedPodr);
  ClearFuncCache;
  Message('Необходимо перераспределить суммы по сотрудникам',warning)
}

cmValue12:
{
 set curTypeExcl := cgKau_Persons;
  Runwindowmodal(winPickExcludedPsn);
  ClearFuncCache;
  Message('Необходимо перераспределить суммы по сотрудникам',warning)

}
cmValue14:
{
  Runwindowmodal(winPickExcludedVplan);
  ClearFuncCache;
  Message('Необходимо перераспределить суммы по сотрудникам',warning)

}

cmValue13:
{
/*
  Удаляем все из гп_распаванс, где
  and 0 == gp_raspavansLoop.isarh
  and dBeg == gp_raspavansLoop.datan
  and dEnd == gp_raspavansLoop.dataok (noIndex)
*/

  if (not CheckFactSum) then
  {
    Message('Фактическая сумма распределения превышает плановую'#13 +
            'Сохранение результата невозможно', Error);
    stop; abort; exit;
  }

  if (_TypeFot = 1) then
  {
    if (message('Вы сохраняете зар. плату за ' + datetostr(dBeg,'month YYYY') + ''#13 +
                'записи по распределению аванса по ГОЗ будут переведены в архив.'#13 +
                'Продолжить?', YesNo) <> cmYes) then
    {
       stop; abort; exit;
    }
  }
  StartNewVisual(vtRotateVisual, vfTimer, 'Распределение суммы по накладным', 0);
  update GP_RaspAvans where
         (( 0 == GP_RaspAvans.IsArh
         and ZeroDate <<GP_RaspAvans.DataOk(noindex)
         and dBeg >>GP_RaspAvans.DataOk(noindex)
           ))
  set GP_RaspAvans.IsArh:=1;


  DeleteFromGpRaspAvans;
  CopyToGpRaspAvansFromTRasp;
  DeleteUnusedPlanSum;
  //Fill_tmpItog;
  Fill_tmpRaspr;

  StopVisual;
}

end; //HandleEvent

End.

#include UserReport.vih

VipInterface UserReport_EM_AvansZar_Rasp Implements IUserReport Licensed(free);
Interface UserReport_EM_AvansZar_Rasp;

Procedure Run;
Begin
  if (wGetTune('NPOEM_OWN.ZP.DISTR_FAKT_AVANS_TO_GOZ') = 0) then
  {
    Message('У Вас нет прав для работы с данным интерфейсом'#13 +
            GetTuneName('NPOEM_OWN.ZP.DISTR_FAKT_AVANS_TO_GOZ'), Error );
  }
  else
  {
    runinterface(EM_AvansZar_Rasp);
  }
End;

Function GetReportName: String;
Begin
  GetReportName := 'Распределение заработной платы накладных по ГОЗ';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := '';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'MENUZARP';
  end;
end;

End.

EmRaspAvansZar_HotKeys Menu
{
  - 'Печать отчета', cmValue1, ,hcBankLMIntAnRep, 'Ctrl+P', kbCtrlP, sci1Esc;
