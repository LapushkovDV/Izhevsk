  vPlanRasp.name        'Тема'                    ('Тема'                     ,,sci1Esc)  : [30], Protect;
//  tmpRaspr.dSum         'Сумма выплаты'           ('Сумма выплаты'            ,,sci1Esc)  : [20, '\2p[|-]36`666`666`666`666`666.88'], Protect;
//  tmpRaspr.dNdfl        'НДФЛ'                    ('НДФЛ'                     ,,sci1Esc)  : [20, '\2p[|-]36`666`666`666`666`666.88'], Protect;
  tmpRaspr.dPercent     'Процент распределения'   ('Процент распределения'    ,,sci1Esc)  : [20, '\7p[|-]36`666`666`666`666`666.8899999'], Protect;
  tmpRaspr.dPercentOld  'Процент в базе (старый)' ('Процент в базе (старый)'  ,,sci1Esc)  : [20, '\7p[|-]36`666`666`666`666`666.8899999'], Protect;
//  tmpRaspr.dSumGoz      'Сумма с гос. заказа'     ('Сумма с гос. заказа'      ,,sci1Esc)  : [20, '\2p[|-]36`666`666`666`666`666.88'], Protect;
End; //brPers


Procedure MyLog(_str: string);
{
 timelog(ShortStrToWin('EM_AvansZar_Rasp -> '+_str));
}

Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  MyLog('sql: ' + add_query_str);
}

#declare WinExcludedRecs (TypeRecs, label, cgKau, coTable)
Window winPickExcluded#TypeRecs #label, DoAccept;
  Browse brPickExcluded#TypeRecs #label (#label,,sci178Esc);
    Table KatLink#TypeRecs;
  fields
      ShowKau(#cgKau, KatLink#TypeRecs.crec) #label (#label         ,,sci178Esc) : [100], Protect;

  end;

HandleEvent
cmInsert:
{
  if ( iGetKau.GetCodeKau(cgiMulti, #cgKau, 0h) <> 0 )
  {
    var _markerKau: tPtr = InitMarker(iGetKau.GetMarkerName(#cgKau), 8, 10, 10);
    var _i : longint = 0;
    var _crec : comp = 0h;
    if GetMarker(_markerKau, _i, _crec)
    do
    {
      if (RecordExists KatLink#TypeRecs where ((  #coTable == KatLink#TypeRecs.codetable
                                            and KL_code   == KatLink#TypeRecs.code
                                            and KL_on     == KatLink#TypeRecs.ownName
                                            and _crec     == KatLink#TypeRecs.crec (noIndex) )) <> tsOk)
      insert KatLink#TypeRecs
       set  KatLink#TypeRecs.codetable := #coTable
          , KatLink#TypeRecs.code      := KL_code
          , KatLink#TypeRecs.ownName   := KL_on
          , KatLink#TypeRecs.crec      := _crec
          ;
       _i++;
    } while GetMarker(_markerKau, _i, _crec)
    donemarker(_markerKau, iGetKau.GetMarkerName(#cgKau));
  }
  ReReadRecord;
}
cmDelete:
{
  Delete current KatLink#TypeRecs;
  ReReadRecord;
}
end;
End; //winPickExcludedPsn
#end

#WinExcludedRecs (Psn,  'Исключаемые сотрудники',    cgKau_Persons, coPersons)
#WinExcludedRecs (Podr, 'Исключаемые подразделения', cgKau_KatPodr, coKatPodr)


Window winPickExcludedVplan 'Исключаемые темы', DoAccept;
  Browse brPickExcludedVplan 'Исключаемые темы'('Исключаемые темы',,sci178Esc);
    Table unidoc_vplan;
  fields
      vPlanIskl.CODE 'Код' : [10], Protect;
      vPlanIskl.NAME 'Наименование' : [20], Protect;
  end;

HandleEvent
cmInsert:
{
   var _cVPlan: tNRec;
             _cVPlan := pOrderGrp;
             if (RunInterFace('GrvPlan', _cVPlan, 0, 17) != cmCancel)
             {
                set pOrderGrp := _cVPlan;
                insert unidoc_vplan
                set unidoc_vplan.wtype:=31015
                , unidoc_vplan.cpodr:=pOrderGrp
                , unidoc_vplan.ADDCOMP[1]:=pOrderGrp
                ;
             }

  ReReadRecord;
}

cmDelete:
{
  Delete current unidoc_vplan;
  ReReadRecord;
}
end;  //HandleEvent winPickExcludedVplan

End;   //winPickExcludedVplan

function Set_strPrefix : string;
{
 result := if (_TypeFot=0,'АВАНС',' ЗП');
}
procedure FillSpkau_period;
{
  //создаем в spkau папки год - месяц для хранения плановых сумм распределения
  var dUv : date = dGetTune('UP.DATOTCH');

  cSpKau := 0h;
  if (getFirst FastFirstRow SpKau where ((                  wSpKau == SpKau.KodGrKau
                                             and String(Year(dUv)) == SpKau.Code
                                            and String(Month(dUv)) == SpKau.Name (noIndex)
                                               and Set_strPrefix() == SpKau.LevelCode (noIndex)
                                        )) <> tsOk) then
  {
    ClearBuffer(#SpKau);
      SpKau.nRec      := 0h;
      SpKau.Code      := String(Year(dUv));
      SpKau.Name      := String(Month(dUv));
      SpKau.KodGrKau  := wSpKau;
      SpKau.LevelCode := Set_strPrefix();
    Insert Current SpKau;
  }
 set cSpKau := SpKau.nRec;
}

//  верхний брауз интерфейса. Собран из уникальных vplan
//  при условии наличия у них ссылки на счет, который имеет ИГК
Procedure Fill_tmpItog;
{
  StartNewVisual(vtRotateVisual, vfTimer, 'Сбор тем гос. заказов', 0);
  delete all tmpItog;

  var qStr : longint = 0;

  sqlFreeStr(qStr);

  MysqlAddStr(qStr, ' select distinct                                                                                                    ');
  MysqlAddStr(qStr, '   vplan.nrec    as cVPlan                                                                                          ');
  MysqlAddStr(qStr, ' , av.vcomp      as cBankSch                                                                                        ');
  //MysqlAddStr(qStr, ' , vplan.name    as sVPlan                                                                                        ');
  MysqlAddStr(qStr, ' , 0.0           as dSumRaspPlan                                                                                    ');
  MysqlAddStr(qStr, ' , 0.0           as dSumRaspFactS                                                                                   ');
  MysqlAddStr(qStr, ' , 0.0           as dSumRaspFactO                                                                                   ');
  MysqlAddStr(qStr, ' , 0.0           as sPercent                                                                                        ');
  MysqlAddStr(qStr, ' from vplan                                                                                                         ');
  MysqlAddStr(qStr, ' inner join attrnam an on ' + word(coVPlan) + ' = an.wtable and ''' + string(AnBankSch) + ''' = an.name             ');
  MysqlAddStr(qStr, ' inner join attrval av on ' + word(coVPlan) + ' = av.wtable and an.nrec = av.cattrnam and vplan.nrec = av.crec      ');
  MysqlAddStr(qStr, ' inner join attrnam an1 on ' + word(coVPlan) + ' = an1.wtable and ''' + string(AnArch) + ''' = an1.name             ');
  MysqlAddStr(qStr, '  left join attrval av1 on ' + word(coVPlan) + ' = av1.wtable and an1.nrec = av1.cattrnam and vplan.nrec = av1.crec ');
  MysqlAddStr(qStr, ' where coalesce(av1.vlongint, 0) <> 1                                                                               ');
  MysqlAddStr(qStr, ' union all                                                                                                          ');
  MysqlAddStr(qStr, ' select                                                                                                             ');
  MysqlAddStr(qStr, '   #comp('+string(coVirtualcVPlan)+')    as cVPlan                                                                  ');
  MysqlAddStr(qStr, ' , #comp(0h)     as cBankSch                                                                                        ');
  MysqlAddStr(qStr, ' , 0.0           as dSumRaspPlan                                                                                    ');
  MysqlAddStr(qStr, ' , 0.0           as dSumRaspFactS                                                                                   ');
  MysqlAddStr(qStr, ' , 0.0           as dSumRaspFactO                                                                                   ');
  MysqlAddStr(qStr, ' , 0.0           as sPercent                                                                                        ');
   MysqlAddStr(qStr, ' union all                                                                                                          ');
  MysqlAddStr(qStr, ' select                                                                                                             ');
  MysqlAddStr(qStr, '   #comp('+string(coVirtualcVPlan2)+')    as cVPlan                                                                  ');
  MysqlAddStr(qStr, ' , #comp(0h)     as cBankSch                                                                                        ');
  MysqlAddStr(qStr, ' , 0.0           as dSumRaspPlan                                                                                    ');
  MysqlAddStr(qStr, ' , 0.0           as dSumRaspFactS                                                                                   ');
  MysqlAddStr(qStr, ' , 0.0           as dSumRaspFactO                                                                                   ');
  MysqlAddStr(qStr, ' , 0.0           as sPercent                                                                                        ');

  var objQuery: iQuery;
      objQuery := queryManager.createQuery(qStr);
  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('Ошибка поиска гос. заказов (Fill_tmpItog) '+ objQuery.errorCode, Error);
    sqlFreeStr(qStr);
    StopVisual;
    Exit;
  }
  else
  {
    sqlCopyInto(objQuery, tntmpItog, true);
  }

  _Loop tmpItog
  {
    if (tmpItog.cVPlan = comp(coVirtualcVPlan) or tmpItog.cVPlan = comp(coVirtualcVPlan2)) then
    {
      continue;
    }
    if ( oIGK_Dog.GetFullIGKByBank(tmpItog.cBankSch) = '' ) then
    {
      Delete Current tmpItog;
    }
  }
  StopVisual;
}

Procedure UpdateItogsByVPlan;
{
  SetVisualHeader('Подсчет итогов по темам');
  PushPos(tntmpItog);
  _Loop tmpItog
  {
    tmpItog.dSumRaspFactO := 0;
    tmpItog.dSumRaspFactS := 0;

    _Loop tmpRasprLoop where ((tmpItog.cVplan == tmpRasprLoop.cVplan))
    {
      if (tmpRasprLoop.wType > 0) then
      {
        tmpItog.dSumRaspFactS := tmpItog.dSumRaspFactS  + tmpRasprLoop.dSumGoz;
      }
      //распределенные накладные
      if (tmpRasprLoop.wType = 0 and tmpRasprLoop.cVplan <> 0h) then
      {
        tmpItog.dSumRaspFactO := tmpItog.dSumRaspFactO  + tmpRasprLoop.dSumGoz;
      }
    }
    var x : double = Get_Sum_vplan_WO_Excl(true);
    //Mylog(vplan.name + '|' + tmpItog.dSumRaspFactO + '|' + x);
    tmpItog.dPercent := Round(tmpItog.dSumRaspFactO / x * 100, coDecimalPoint);
    Update current tmpItog;
  }
  if (getFirst tmpItog = tsOk) then {ReScanPanel(tntmpItog);}
  PopPos(tntmpItog);
}
Procedure LoadPlanSum;
{
FillSpkau_period;
    mylog('Procedure LoadPlanSum;');
    mylog('    wSpKau ='+ wSpKau);
    mylog('    cSpKau ='+ cSpKau);

  _Loop tmpItogLoop
  {
    Set tmpItogLoop.dSumRaspPlan := 0;
    mylog('     tmpItogLoop.cVPlan =  ' + tmpItogLoop.cVPlan) ;
    if ( getFirst FastFirstRow SpKau where ((     wSpKau == SpKau.KodGrKau
                                              and cSpKau == SpKau.cNode
                                              and string(tmpItogLoop.cVPlan) == SpKau.LevelCode
                                           )) = tsOk) then
    {
      mylog('     getFirst FastFirstRow SpKau where ((     wSpKau == SpKau.KodGrKau) Double(SpKau.Code) = ' + Double(SpKau.Code));
      Set tmpItogLoop.dSumRaspPlan := Double(SpKau.Code);
    }
    Update Current tmpItogLoop;
  }
  if (getFirst tmpItog = tsOk) then {ReScanPanel(tntmpItog);}
}

Procedure Fill_tmpRaspr;
{
  StartNewVisual(vtRotateVisual, vfTimer, 'Сбор сумм распределения по людям', 0);
  LoadPlanSum;
  delete all tmpRasprLoop;

  var qStr : longint = 0;
  ClearFuncCache;
  sqlFreeStr(qStr);

  var dUv : date = dGetTune('UP.DATOTCH');

  //аванс
  if (_TypeFot = 0) then
  {
    SetVisualHeader('Сбор сумм распределения аванса по людям');

    MysqlAddStr(qStr, ' select                                                                                                                                          ');
    MysqlAddStr(qStr, '   t.cLSchet                               as cLSchet                                                                                            ');
    MysqlAddStr(qStr, ' , t.cPerson                               as cPerson                                                                                            ');
    MysqlAddStr(qStr, ' , t.cVPlan                                as cVPlan                                                                                             ');
    MysqlAddStr(qStr, ' , t.sPerson                               as sPerson                                                                                            ');
    MysqlAddStr(qStr, ' , t.sTabN                                 as sTabN                                                                                              ');
    MysqlAddStr(qStr, ' , t.dSum                                  as dSum                                                                                               ');
    MysqlAddStr(qStr, ' , t.dNdfl                                 as dNdfl                                                                                              ');
    MysqlAddStr(qStr, ' , t.dPercent                              as dPercent                                                                                           ');
    MysqlAddStr(qStr, ' , t.dPercent                              as dPercentOld                                                                                        ');
    MysqlAddStr(qStr, ' , Round(t.dSum * t.dPercent / 100.0, 2)   as dSumGoz                                                                                            ');
    MysqlAddStr(qStr, ' , t.wType                                 as wType                                                                                              ');
    MysqlAddStr(qStr, ' from (                                                                                                                                          ');
    MysqlAddStr(qStr, ' select                                                                                                                                          ');
    MysqlAddStr(qStr, '   lschet.nrec                         as cLSchet                                                                                                ');
    MysqlAddStr(qStr, ' , persons.nrec                        as cPerson                                                                                                ');
    MysqlAddStr(qStr, ' , t_rasp.cVPlan                       as cVPlan                                                                                                 ');
    MysqlAddStr(qStr, ' , persons.fio                         as sPerson                                                                                                ');
    MysqlAddStr(qStr, ' , persons.strtabn                     as sTabN                                                                                                  ');
    MysqlAddStr(qStr, ' , sum(nach226.sumAV)                  as dSum                                                                                          ');
    //MysqlAddStr(qStr, ' , sum(lschet.avfakt)                           as dSum                                                                                          ');
    MysqlAddStr(qStr, ' , 0.0                                 as dNdfl                                                                                                  ');
    MysqlAddStr(qStr, ' , t_rasp.dPercent                     as dPercent                                                                                               ');
    MysqlAddStr(qStr, ' , t_rasp.wType                        as wType                                                                                                  ');
    MysqlAddStr(qStr, ' from  lschet                                                                                                                                    ');
    MysqlAddStr(qStr, ' inner join persons on lschet.tperson = persons.nrec                                                                                             ');
    MysqlAddStr(qStr, ' inner join katpodr on lschet.cex = katpodr.nrec                                                                                                 ');
    MysqlAddStr(qStr, ' outer apply (                                                                                                                                   ');
    MysqlAddStr(qStr, ' select sum(uder.sumud) sumAV from uder                                                                                                          ');
    MysqlAddStr(qStr, ' where mesn='+string(Month(dUv))+' and yearn='+string(Year(dUv))+' and VIDUDS=141                                                                ');
    MysqlAddStr(qStr, ' and uder.clsch=lschet.nrec                                                                                                                      ');
    MysqlAddStr(qStr, ' ) nach226                                                                                                                                       ');
    MysqlAddStr(qStr, ' outer apply (                                                                                                                                   ');
    MysqlAddStr(qStr, '                 select                                                                                                                          ');
    MysqlAddStr(qStr, '                   vplan.nrec            as cVplan                                                                                               ');
    MysqlAddStr(qStr, '                 , vplan.name            as sVplan                                                                                               ');
    MysqlAddStr(qStr, '                 , gp_raspavans.procent  as dPercent                                                                                             ');
    MysqlAddStr(qStr, '                 , gp_raspavans.wtype    as wtype                                                                                                ');
    MysqlAddStr(qStr, '                 from gp_raspavans                                                                                                               ');
    MysqlAddStr(qStr, '                 left join vplan on gp_raspavans.cvplan = vplan.nrec                                                                             ');
    MysqlAddStr(qStr, '                 where     lschet.nrec = gp_raspavans.clschet                                                                                    ');
    MysqlAddStr(qStr, '                       and persons.nrec = gp_raspavans.cpersons                                                                                  ');
    MysqlAddStr(qStr, '                       and gp_raspavans.isarh = 0                                                                                                ');
    MysqlAddStr(qStr, '                       and gp_raspavans.datan = #date(' + Day(1)   + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                                   ');
    MysqlAddStr(qStr, '                       and gp_raspavans.dataok = #date(' + Day(15) + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                                   ');
    MysqlAddStr(qStr, ' ) t_rasp                                                                                                                                        ');
    MysqlAddStr(qStr, ' where     nach226.sumAV > 0.01                                                                                                                  ');
    MysqlAddStr(qStr, '       and lschet.summa27 <> 0                                                                                                                   ');
    MysqlAddStr(qStr, '       and katpodr.kod not in (  ''446'', ''Вет''                                                                                       ');
    MysqlAddStr(qStr, '                               , ''_Профком'', ''_Студенты'', ''_ФИЗ ЛИЦ'', '''')                                                                ');
    MysqlAddStr(qStr, '       and ( lschet.datuv = #date(0, 0, 0) or lschet.datuv >= #date(' + Day(dUv) + ', ' + Month(dUv) + ', ' + Year(dUv) + ') )                   ');
    MysqlAddStr(qStr, ' group by    lschet.nrec                                                                                                                         ');
    MysqlAddStr(qStr, '           , persons.nrec                                                                                                                        ');
    MysqlAddStr(qStr, '           , t_rasp.cVPlan                                                                                                                       ');
    MysqlAddStr(qStr, '           , persons.fio                                                                                                                         ');
    MysqlAddStr(qStr, '           , persons.strtabn                                                                                                                     ');
    MysqlAddStr(qStr, '           , t_rasp.dPercent                                                                                                                     ');
    MysqlAddStr(qStr, '           , t_rasp.wType                                                                                                                        ');
    MysqlAddStr(qStr, ' ) t                                                                                                                                             ');

    var objQuery: iQuery;
      objQuery := queryManager.createQuery(qStr);
    if (objQuery.execute.errorCode != tsOk) then
    {
      Message('Ошибка сбора сумм аванса (Fill_tmpRaspr) '+ objQuery.errorCode, Error);
      sqlFreeStr(qStr);
      StopVisual;
      Exit;
    }
    else
    {
      sqlCopyInto(objQuery, tntmpRasprLoop, true);
      //RecalcItog;
    }

  }
  //ЗП
  if (_TypeFot = 1) then
  {
    SetVisualHeader('Сбор сумм распределения зар. платы по людям');
    /*
    ПЕУ разродилось на ТЗ, заменяем алгоритм сбора часов, разноски по темам
    MysqlAddStr(qStr, ' select                                                                                                                                                   ');
    MysqlAddStr(qStr, '   lschet.nrec                                         as cLSchet                                                                                         ');
    MysqlAddStr(qStr, ' , persons.nrec                                        as cPerson                                                                                         ');
    MysqlAddStr(qStr, ' , t_rasp.cVPlan                                       as cVPlan                                                                                          ');
    MysqlAddStr(qStr, ' , persons.fio                                         as sPerson                                                                                         ');
    MysqlAddStr(qStr, ' , lschet.strtabn                                      as sTabN                                                                                           ');
    MysqlAddStr(qStr, ' , coalesce(t_ls_sum.dSum  , 0)                        as dSum                                                                                            ');
    MysqlAddStr(qStr, ' , coalesce(t_ls_ndfl.dSum , 0)                        as dNdfl                                                                                           ');
    MysqlAddStr(qStr, ' , case when (t_SumH.dSum_vPlan = 0) then 0 else Round(t_rasp.dSumH_ls / t_SumH.dSum_vPlan, '+string(coDecimalPoint)+') end * 100 as dPercent                                      ');
    MysqlAddStr(qStr, ' , case when (t_SumH.dSum_vPlan = 0) then 0 else Round(t_rasp.dSumH_ls / t_SumH.dSum_vPlan, '+string(coDecimalPoint)+') end * 100 as dPercentOld                                   ');
    MysqlAddStr(qStr, ' , case when (t_SumH.dSum_vPlan = 0) then 0 else Round(t_ls_sum.dSum * t_rasp.dSumH_ls / t_SumH.dSum_vPlan, 2) end as dSumGoz                             ');
    MysqlAddStr(qStr, ' , case when (    coalesce(substring(t_prnaryad.ssch, 2, 2), substring(t_prvidopl.ssch, 2, 2)) in (''25'', ''26'')                                                                                    ');
    MysqlAddStr(qStr, '               or coalesce(substring(t_prnaryad.smnp, 2, 2), substring(t_prvidopl.smnp, 2, 2)) in (''70'', ''71'', ''72'', ''73'', ''74'', ''75'', ''76'', ''48'')                                    ');
    MysqlAddStr(qStr, '               or coalesce(t_prnaryad.smnp, t_prvidopl.smnp) in (''239000000120'', ''239000300120'')                                                                                 ');
    MysqlAddStr(qStr, '             ) then 0                                                                                                                                     ');
    MysqlAddStr(qStr, '        else t_rasp.wType                                                                                                                                 ');
    MysqlAddStr(qStr, '   end                                                as wType                                                                                            ');
    MysqlAddStr(qStr, ' , t_rasp.cBankS                                       as cBankS                                                                                          ');
    MysqlAddStr(qStr, ' from lschet                                                                                                                                              ');
    MysqlAddStr(qStr, ' inner join persons on lschet.tperson = persons.nrec                                                                                                      ');
    MysqlAddStr(qStr, '  left join katpodr on lschet.cex = katpodr.nrec                                                                                                          ');
    MysqlAddStr(qStr, ' outer apply (                                                                                                                                            ');
    MysqlAddStr(qStr, '                 select                                                                                                                                   ');
    MysqlAddStr(qStr, '                   sum(uder.sumud) as dSum                                                                                                                ');
    MysqlAddStr(qStr, '                 from uder                                                                                                                                ');
    MysqlAddStr(qStr, '                 where     lschet.nrec = uder.clsch                                                                                                       ');
    MysqlAddStr(qStr, '                       and uder.mesv = ' + Month(dUv) + '                                                                                                 ');
    MysqlAddStr(qStr, '                       and uder.yearv = ' + Year(dUv) + '                                                                                                 ');
    MysqlAddStr(qStr, '                       and uder.vidud = 500 having sum(uder.sumud) >= 0.01                                                                                ');
    MysqlAddStr(qStr, ' ) t_ls_sum                                                                                                                                               ');
    MysqlAddStr(qStr, ' outer apply (                                                                                                                                            ');
    MysqlAddStr(qStr, '                 select                                                                                                                                   ');
    MysqlAddStr(qStr, '                   sum(uder.sumud) as dSum                                                                                                                ');
    MysqlAddStr(qStr, '                 from uder                                                                                                                                ');
    MysqlAddStr(qStr, '                 where     lschet.nrec = uder.clsch                                                                                                       ');
    MysqlAddStr(qStr, '                       and uder.mesv = ' + Month(dUv) + '                                                                                                 ');
    MysqlAddStr(qStr, '                       and uder.yearv = ' + Year(dUv) + '                                                                                                 ');
    MysqlAddStr(qStr, '                       and uder.vidud = 213 having sum(uder.sumud) >= 0.01                                                                                ');
    MysqlAddStr(qStr, ' ) t_ls_ndfl                                                                                                                                              ');
    MysqlAddStr(qStr, ' outer apply (                                                                                                                                            ');
    MysqlAddStr(qStr, '                 select                                                                                                                                   ');
    MysqlAddStr(qStr, '                   mnplan.cvplan         as cVplan                                                                                                        ');
    MysqlAddStr(qStr, '                 , ''''                  as sVplan                                                                                                        ');
    MysqlAddStr(qStr, '                 , sum(prnaryad.chasf)   as dSumH_ls                                                                                                      ');
    MysqlAddStr(qStr, '                 , case when (av.vcomp is null) then 2 else 1 end  as wtype                                                                                                         ');
    MysqlAddStr(qStr, '                 , lschet.nrec           as clschet                                                                                                       ');
    MysqlAddStr(qStr, '                 , av.vcomp as cBankS                                                                                                                     ');
    MysqlAddStr(qStr, '                 from prnaryad                                                                                                                            ');
    MysqlAddStr(qStr, '                 left join sys_nar on prnaryad.mnrec = sys_nar.nrec                                                                                       ');
    MysqlAddStr(qStr, '                 left join mnplan on case when prnaryad.tbld[1] = 7 then prnaryad.ckaud[1]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[2] = 7 then prnaryad.ckaud[2]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[3] = 7 then prnaryad.ckaud[3]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[4] = 7 then prnaryad.ckaud[4]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[5] = 7 then prnaryad.ckaud[5]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[6] = 7 then prnaryad.ckaud[6]                                                       ');
    MysqlAddStr(qStr, '                                          else #comp(0h)                                                                                         ');
    MysqlAddStr(qStr, '                                     end = mnplan.nrec                                                                                           ');
    MysqlAddStr(qStr, '                 inner join attrnam an on ' + word(coVPlan) + ' = an.wtable and ''' + string(AnBankSch) + ''' = an.name                                   ');
    MysqlAddStr(qStr, '                  left join attrval av on ' + word(coVPlan) + ' = av.wtable and an.nrec = av.cattrnam and mnplan.cvplan = av.crec                         ');
    MysqlAddStr(qStr, '                 where     lschet.nrec = prnaryad.clsch                                                                                                   ');
    MysqlAddStr(qStr, '                       and sys_nar.choice < 900                                                                                                           ');
    MysqlAddStr(qStr, '                       and prnaryad.datan >= #date(' + Day(1)   + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                                               ');
    MysqlAddStr(qStr, '                       and (#date(' + Day(dUv)   + ', ' + Month(dUv) + ', ' + Year(dUv) + ') <= prnaryad.DatOk or prnaryad.DatOk = #date(0, 0, 0))        ');
    //добавляем доп ограничения 22/04/2021
    //MysqlAddStr(qStr, '                       and prnaryad.cschetd not in (''20'')                                                                                               ');

    MysqlAddStr(qStr, '                 group by mnplan.cvplan, av.vcomp                                                                                                         ');
    MysqlAddStr(qStr, ' ) t_rasp                                                                                                                                                 ');
    MysqlAddStr(qStr, ' left join (                                                                                                                                              ');
    MysqlAddStr(qStr, '                 select                                                                                                                                   ');
    MysqlAddStr(qStr, '                   sum(prnaryad.chasf) as dSum_vPlan, prnaryad.clsch as clsch                                                                             ');
    MysqlAddStr(qStr, '                 from prnaryad                                                                                                                            ');
    MysqlAddStr(qStr, '                 left join sys_nar on prnaryad.mnrec = sys_nar.nrec                                                                                       ');
    MysqlAddStr(qStr, '                 where     sys_nar.choice < 900                                                                                                           ');
    MysqlAddStr(qStr, '                       and prnaryad.datan >= #date(' + Day(1)   + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                                               ');
    MysqlAddStr(qStr, '                       and (#date(' + Day(dUv)   + ', ' + Month(dUv) + ', ' + Year(dUv) + ') <= prnaryad.DatOk or prnaryad.DatOk = #date(0, 0, 0))        ');
    //добавляем доп ограничения 22/04/2021
    //MysqlAddStr(qStr, '                       and prnaryad.cschetd not in (''20'')                                                                                               ');

    MysqlAddStr(qStr, '                 group by prnaryad.clsch                                                                                                                  ');
    MysqlAddStr(qStr, ' ) t_sumH on t_sumH.clsch = lschet.nrec                                                                                                                   ');

    //добавляем доп ограничения 22/04/2021
    MysqlAddStr(qStr, ' outer apply (                                                                                                                                   ');
    MysqlAddStr(qStr, '                 select top 1                                                                                                                    ');
    MysqlAddStr(qStr, '                   coalesce(mnplan.number, '''') as smnp                                                                                         ');
    MysqlAddStr(qStr, '                 , buhschet.schet as ssch                                                                                                        ');
    MysqlAddStr(qStr, '                 from prvidopl                                                                                                                   ');
    MysqlAddStr(qStr, '                 left join mnplan on case when prvidopl.tbld[1] = 7 then prvidopl.ckaud[1]                                                       ');
    MysqlAddStr(qStr, '                                          when prvidopl.tbld[2] = 7 then prvidopl.ckaud[2]                                                       ');
    MysqlAddStr(qStr, '                                          when prvidopl.tbld[3] = 7 then prvidopl.ckaud[3]                                                       ');
    MysqlAddStr(qStr, '                                          when prvidopl.tbld[4] = 7 then prvidopl.ckaud[4]                                                       ');
    MysqlAddStr(qStr, '                                          when prvidopl.tbld[5] = 7 then prvidopl.ckaud[5]                                                       ');
    MysqlAddStr(qStr, '                                          when prvidopl.tbld[6] = 7 then prvidopl.ckaud[6]                                                       ');
    MysqlAddStr(qStr, '                                          else #comp(0h)                                                                                         ');
    MysqlAddStr(qStr, '                                     end = mnplan.nrec                                                                                           ');
    MysqlAddStr(qStr, '                 left join buhschet on mnplan.canval2 = buhschet.nrec                                                                            ');
    MysqlAddStr(qStr, '                 where LSchet.nrec = prvidopl.clsch                                                                                              ');
    MysqlAddStr(qStr, '                       and prvidopl.datan >= #date(' + Day(1)   + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                                      ');
    MysqlAddStr(qStr, '                       and prvidopl.datok <= #date(' + Last_Day(dUv) + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                                 ');
    MysqlAddStr(qStr, ' ) t_prvidopl                                                                                                                                    ');
    MysqlAddStr(qStr, '                                                                                                                                                 ');
    MysqlAddStr(qStr, ' outer apply (                                                                                                                                   ');
    MysqlAddStr(qStr, '                 select top 1                                                                                                                    ');
    MysqlAddStr(qStr, '                   coalesce(mnplan.number, '''') as smnp                                                                                         ');
    MysqlAddStr(qStr, '                 , buhschet.schet as ssch                                                                                                        ');
    MysqlAddStr(qStr, '                 from prnaryad                                                                                                                   ');
    MysqlAddStr(qStr, '                 left join sys_nar on prnaryad.mnrec = sys_nar.nrec                                                                              ');
    MysqlAddStr(qStr, '                 left join mnplan on case when prnaryad.tbld[1] = 7 then prnaryad.ckaud[1]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[2] = 7 then prnaryad.ckaud[2]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[3] = 7 then prnaryad.ckaud[3]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[4] = 7 then prnaryad.ckaud[4]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[5] = 7 then prnaryad.ckaud[5]                                                       ');
    MysqlAddStr(qStr, '                                          when prnaryad.tbld[6] = 7 then prnaryad.ckaud[6]                                                       ');
    MysqlAddStr(qStr, '                                          else #comp(0h)                                                                                         ');
    MysqlAddStr(qStr, '                                     end = mnplan.nrec                                                                                           ');
    MysqlAddStr(qStr, '                 left join buhschet on mnplan.canval2 = buhschet.nrec                                                                            ');
    MysqlAddStr(qStr, '                 where LSchet.nrec = prnaryad.clsch                                                                                              ');
    MysqlAddStr(qStr, '                       and prnaryad.datan = #date(' + Day(1)   + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                                       ');
    MysqlAddStr(qStr, '                       and prnaryad.datok = #date(' + Last_Day(dUv) + ', ' + Month(dUv) + ', ' + Year(dUv) + ')                                  ');
    MysqlAddStr(qStr, '                       and sys_nar.choice < 900                                                                                                  ');
    MysqlAddStr(qStr, ' ) t_prnaryad                                                                                                                                    ');
    // конец доп ограничений 22/04/2021
    MysqlAddStr(qStr, ' where (    t_ls_ndfl.dsum is not null                                                                                                           ');
    MysqlAddStr(qStr, '         or t_ls_sum.dSum is not null )                                                                                                          ');
    MysqlAddStr(qStr, '        and katpodr.kod not in (  ''446'', ''999'', ''Вет''                                                                                      ');
    MysqlAddStr(qStr, '                                , ''_Профком'', ''_Студенты'', ''_ФИЗ ЛИЦ'', '''')                                                               ');
    MysqlAddStr(qStr, '        and ( lschet.datuv = #date(0, 0, 0) or lschet.datuv >= #date(' + Day(dUv) + ', ' + Month(dUv) + ', ' + Year(dUv) + ') )                  ');
    MysqlAddStr(qStr, '        and lschet.summa27 <> 0                                                                                                                  ');
    //MysqlAddStr(qStr, '        and t_prvidopl.cprvidopl is null                                                                                                         ');
    //MysqlAddStr(qStr, '        and t_prnaryad.cprnaryad is null                                                                                                         ');
    */



    MysqlAddStr(qStr, '  select                                                                                                                                                         ');
    MysqlAddStr(qStr, '    lschet.nrec                                         as cLSchet                                                                                               ');
    MysqlAddStr(qStr, '  , persons.nrec                                        as cPerson                                                                                               ');
    MysqlAddStr(qStr, '  , coalesce(t_rasp.cVPlan, t_rasp2.cVPlan)             as cVPlan                                                                                                ');
    MysqlAddStr(qStr, '  , persons.fio                                         as sPerson                                                                                               ');
    MysqlAddStr(qStr, '  , lschet.strtabn                                      as sTabN                                                                                                 ');
    MysqlAddStr(qStr, '  , coalesce(t_ls_sum.dSum  , 0)                        as dSum                                                                                                  ');
    MysqlAddStr(qStr, '  , coalesce(t_ls_ndfl.dSum , 0)                        as dNdfl                                                                                                 ');
    MysqlAddStr(qStr, '  , case when (coalesce(t_SumH.dSum_vPlan, t_SumH2.dSum_vPlan) = 0) then 0                                                                                       ');
    MysqlAddStr(qStr, '         else Round(coalesce(t_rasp.dSumH_ls, t_rasp2.dSumH_ls) * 100 / coalesce(t_SumH.dSum_vPlan, t_SumH2.dSum_vPlan), 2)                                      ');
    MysqlAddStr(qStr, '    end                                           as dPercent                                                                                                    ');
    MysqlAddStr(qStr, '  , case when (coalesce(t_SumH.dSum_vPlan, t_SumH2.dSum_vPlan) = 0) then 0                                                                                       ');
    MysqlAddStr(qStr, '         else Round(coalesce(t_rasp.dSumH_ls, t_rasp2.dSumH_ls) * 100 / coalesce(t_SumH.dSum_vPlan, t_SumH2.dSum_vPlan), 2)                                      ');
    MysqlAddStr(qStr, '    end                                           as dPercentOld                                                                                                 ');
    MysqlAddStr(qStr, '  , case when (coalesce(t_SumH.dSum_vPlan, t_SumH2.dSum_vPlan) = 0) then 0                                                                                       ');
    MysqlAddStr(qStr, '         else Round(coalesce(t_ls_sum.dSum, 0) * coalesce(t_rasp.dSumH_ls, t_rasp2.dSumH_ls) / coalesce(t_SumH.dSum_vPlan, t_SumH2.dSum_vPlan), 2)                            ');
    MysqlAddStr(qStr, '            + Round(coalesce(t_ls_ndfl.dSum, 0) * coalesce(t_rasp.dSumH_ls, t_rasp2.dSumH_ls) / coalesce(t_SumH.dSum_vPlan, t_SumH2.dSum_vPlan), 0)                           ');
    MysqlAddStr(qStr, '    end                                                 as dSumGoz                                                                                               ');
    MysqlAddStr(qStr, '  , coalesce(t_rasp.wType, t_rasp2.wType)               as wType                                                                                                 ');
    MysqlAddStr(qStr, '  , coalesce(t_rasp.cBankS, t_rasp2.cBankS)             as cBankS                                                                                                ');
    MysqlAddStr(qStr, '  from lschet                                                                                                                                                    ');
    MysqlAddStr(qStr, '  inner join persons on lschet.tperson = persons.nrec                                                                                                            ');
    MysqlAddStr(qStr, '   left join katpodr on lschet.cex = katpodr.nrec                                                                                                                ');
    MysqlAddStr(qStr, '  outer apply (                                                                                                                                                  ');
    MysqlAddStr(qStr, '                  select                                                                                                                                         ');
    MysqlAddStr(qStr, '                    sum(uder.sumud) as dSum                                                                                                                      ');
