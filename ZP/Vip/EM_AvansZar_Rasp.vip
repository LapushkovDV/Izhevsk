//003889
#include IGK_Dog.vih
#include Query.vih
#include GetKau.vih
#include GetKau.var

#doc
    1.  Один и тот же сотрудник может выполнять основную тематическую работу и в этом же месяце работы накладного характера, поэтому  исправление в пункт 1.
        <Основные тематические работники, заработная плата которых учитывается на 20  счете бухгалтерского учета по темам ГОЗ и любым другим темам, в т. ч. коммерческим,
        может попадать в категорию персонала накладного характера при распределении зарплаты по темам ГОЗ и коммерческим, при этом тематический (прямой) заказ
        и заказы накладного характера проставляются в наряде или табеле>.
    2.  Распределение заработной платы накладного характера основывается на шифре заказа, все заказы на счетах 25, 26 являются признаком накладного персонала
        (70:,71:,72:,73:,74:,75:,76:).
    3.  Основные тематические работники, заработная плата которых учитывается на 23  счете бухгалтерского учета по темам ГОЗ и любым другим темам, в т. ч. коммерческим,
        также может попадать в категорию персонала накладного характера при распределении зарплаты по темам ГОЗ и коммерческим, при этом тематический (прямой) заказ
        и заказы накладного характера проставляются  также в наряде или табеле.
    4.  Кроме указанных в п. 2 заказов накладного характера для выплаты заработной платы со счетов ГОЗ также включаются работники, зарплата которых отражается на заказах 48:,
        239000000120, 239000300120.
    5.  Необходимо учитывать представленный перечень исключаемых подразделений для выплаты по ГОЗ.
#end
const
 coDecimalPoint = 2; //до какого округляем проценты в БД
// coDecimalPointNDFL = 0;   не будем по НДФЛ до рубля округлоять, это только портит общшие суммы и не имеет отнощшения к реальности в данном контексте.
 coVirtualcVPlan = 999999999;
 coVirtualcVPlan2 = 888888888;
end;

VipInterface EM_AvansZar_Rasp Licensed(free);

Interface EM_AvansZar_Rasp 'Распределение аванса и ЗП' EscClose;

Procedure Fill_tmpItog; Forward;
Procedure Fill_tmpRaspr; Forward;
Function Get_Sum_vplan_WO_Excl(bFlag : boolean) : double; Forward;
Function Get_Total_perc_Goz(_cLscht : comp) : double; Forward;
Function Get_Total_Straight_Goz(_cLscht : comp) : double; Forward;
Function CheckLSchet(_cLs : comp) : boolean; Forward;

Const
  AnBankSch = 'Банковские счета';
  AnArch    = 'Архив';
  KL_code   = 35183;
  KL_on     = 'SR00035183';
  IndGroup  = 000A00000000000Fh;
End;

table struct tmpItog
(
  cVPlan        : comp
, cBankSch      : comp
, dSumRaspPlan  : double
, dSumRaspFactS : double
, dSumRaspFactO : double
, dPercent      : double
)
with index
(
  i01 = cVPlan
);

table struct tmpRaspr
(
  cLSchet       : comp
, cPerson       : comp
, cVPlan        : comp
, sPerson       : string
, sTabN         : string
, dSum          : double
, dNdfl         : double
, dPercent      : double
, dSumGoz       : double
, wType         : word
, cBankS        : comp
, dPercentOld   : double
)
with index
(
  i01 = cLSchet
, i02 = cVPlan + wType
, i03 = cVPlan + cLSchet
);

table struct tmpExcludedRecs
(
  wType : word
, cRec  : comp
)
with index
(
  i01 = wType + cRec
);

Table Struct TmpIndPsn
(
    cPers : comp
)
With Index
(
    i01 = cPers
);


Create View rView

var
  _log         : string = '';
  _TypeFot     : longint = 0;
  oIGK_Dog     : iIGK_Dog;
  dBeg         : date;
  dEnd         : date;
  curTypeExcl  : word;
  wSpKau       : word;
  cSpKau       : comp;
  _strWarning1 : string = '';
  _strWarning2 : string = '';
  SumAll : double = 0.0;
  pOrderGrp: tNRec;

As

select
  if( tmpRaspr.wType = 0, 'Накладные', if (tmpRaspr.wType = 1, 'Прямые', if(tmpRaspr.wType = 2, 'Прямые не ГОЗ', if(tmpRaspr.wType = 3, 'Прочее не ГОЗ', '???')) )) (FieldName = TypePer)
, if( tmpItog.cVPlan = comp(coVirtualcVPlan),'Прямые, не ГОЗ', if (tmpItog.cVPlan = comp(coVirtualcVPlan2),'Прочее не ГОЗ',vPlanItog.Name) )        (FieldName = svPlanItog)
from
  vPlan vPlanItog
, vPlan vPlanRasp
, vPlan vPlanIskl
, tmpItog
, tmpItog tmpItogLoop
, tmpRaspr

, tmpRaspr tmpRasprLoop
, tmpRaspr tmpRasprLoop2
, tmpRaspr tmpRasprIns
, tmpRaspr tmpRasprLoop_Fn_GOZ
, tmpRaspr tmpRasprLoop_Straight_Goz
, gp_raspavans
, gp_raspavans gp_raspavansLoop
, Lschet LschetCheck
, KatPodr
, KatLink KatLinkPsn
, KatLink KatLinkPodr

, em_unidoc_head unidoc_vplan

, KatKau
, SpKau

, TmpIndPsn
where ((
                       root == tmpRaspr.cVPlan
        and (tmpRaspr.cVPlan <> 0 /*and tmpRaspr.cVPlan <> comp(coVirtualcVPlan)*/)
and      tmpRaspr.cVPlan == vPlanRasp.nrec
and       tmpItog.cVPlan == vPlanItog.nrec

and     tmpRaspr.clSchet == lSchet.nRec
and           lSchet.cex == katpodr.nrec

and tmpRasprLoop.clschet == gp_raspavansLoop.clschet

and                    0 == gp_raspavansLoop.isarh
and                 dBeg == gp_raspavansLoop.datan
and                 dEnd == gp_raspavansLoop.dataok (noIndex)

and            coPersons == KatLinkPsn.codeTable
and              KL_code == KatLinkPsn.code
and                KL_on == KatLinkPsn.ownname

and            coKatPodr == KatLinkPodr.codeTable
and              KL_code == KatLinkPodr.code
and                KL_on == KatLinkPodr.ownname

and            31015 == unidoc_vplan.wtype
and            unidoc_vplan.ADDCOMP[1] == vPlanIskl.NRec
))
;

Screen scRasp (,,sci1Esc);
Show at (,,,2);
Table tmpItog; //NoTableNavigation;
Fields
    _TypeFot                    ('Тип: Аванс / ЗП')               : noProtect, NoFrame;
    DateToStr(dGetTune('UP.DATOTCH'),'Month YYYY')      ('Текущий период ЗП') : SKIP, {Font = {Color = ColorMark}};
    _strWarning1                 ('предупреждение, что данные в интерфейсе могут отличаться от тех, что в БД')   : SKIP, {Font = {BackColor = if(length(_strWarning1) = 0,0,ColorSysRed)}};
    SumAll + Get_Sum_vplan_WO_Excl(true)         ('Сумма НР без исключений')       : [10, '\2p[|-]36`666`666`666`666`666.88'], Protect;
    _strWarning2                 ('предупреждение, что данные в интерфейсе могут отличаться от тех, что в БД')   : SKIP, {Font = {BackColor = if(length(_strWarning2) = 0,0,ColorSysRed)}};
    Get_Sum_vplan_WO_Excl(true) ('Сумма НР с исключениями')       : [10, '\2p[|-]36`666`666`666`666`666.88'], Protect;
Buttons
    cmValue11, [singleLine],,, 'Исключенные подразделения',, sci1Esc;
    cmValue12, [singleLine],,, 'Исключенные сотрудники',, sci1Esc;
    cmValue14, [singleLine],,, 'Исключенные темы',, sci1Esc;
    cmValue13, [singleLine],,, 'Сохранить',, sci1Esc;
<<
  `Выполнять распределение для` (.) Аванса`             <. Исключенные подразделения .>   Период обработки: .@@@@@@@@@@@@@@@@@
                                (.) Зар. платы`         <. Исключенные сотрудники    .> .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   Общая сумма ЗП накладных       .@@@@@@@@@@@@@@@@@    <. Исключенные темы          .> .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   Общая сумма ЗП накл. с искл.   .@@@@@@@@@@@@@@@@@    <. Сохранить расчет          .>
>>
End; //scRasp

Browse brItog 'Итоги распределения аванса и ЗП' (,,Sci1Esc);
Show At (,3,,10);

Table tmpItog;
Fields
  svPlanItog /*vPlanItog.name*/                  'Тема'                                ('Наименование темы'               ,,sci1Esc)  : [50], Protect;
  tmpItog.dSumRaspFactS + tmpItog.dSumRaspFactO  'Итоговая сумма выплаты'              ('Итоговая сумма выплаты'          ,,sci1Esc)  : [10, '\2p[|-]36`666`666`666`666`666.88'], Protect;
  tmpItog.dSumRaspPlan                           'Плановая сумма распределения'        ('Плановая сумма распределения'    ,,sci1Esc)  : [10, '\2p[|-]36`666`666`666`666`666.88'], noProtect;
  tmpItog.dSumRaspFactS                          'Факт. сумма распределения прямых'    ('Фактическая сумма распределения' ,,sci1Esc)  : [10, '\2p[|-]36`666`666`666`666`666.88'], Protect;
  tmpItog.dSumRaspFactO                          'Факт. сумма распределения накладных' ('Фактическая сумма распределения' ,,sci1Esc)  : [10, '\2p[|-]36`666`666`666`666`666.88'], Protect,
                                                  {Font = {BackColor = if(tmpItog.cVPlan <> comp(coVirtualcVPlan), if(tmpItog.dSumRaspFactO > tmpItog.dSumRaspPlan, ColorError, 0), 0)}};
  tmpItog.dPercent                               'Процент распределения'               ('Процент распределения'           ,,sci1Esc)  : [10, '\7p[|-]36`666`666`666`666`666.8899999'], noProtect;

End; //brItog
