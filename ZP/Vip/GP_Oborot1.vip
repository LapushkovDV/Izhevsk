#include PAFilter.vih

interface gp_Oborot1 'Ведомость затрат КБ по элементам в разрезе счетов, отделов за месяц с нарастающим итогом с начала года' EscClose, Gray;
  show at (,,80,10);

  table struct TMP_Oborot   
  (

    Schet  : string[20],
    Kod    : string[3],
    Number : string[20],
    Name   : string[250],
    datob  : date,
    Summ   : double
  )
  with index 
  (
    TMP_Oborot01 =  Schet + Kod + Number + Name
  );

create view vOborot
var
  ExcelPath       : string;
  Marker, iCount, i, lTemp  : longint;
  _PodrMArkerPointer: Longint; // сам маркер
  CLSF              : CurLSFunctions;
  mrkOuterClassfier : longInt;   //маркер с отмеченными классификаторами
  MarkerNotNull     : boolean;   // флаг - маркер не пустой
  ClassSeg          : comp;      //nRec сегмента классификатора
  FiltrPublic       : string;
  MyFlag            : boolean;   //флаг для различных целей
  i1                : integer;   //для циклов
  p2                : double;
  VIDYear         : word;
  VIDMonthN       : word;
  VIDMonthK       : word;
  cTemp           : comp;
  RecPlsch        : comp;
  DlgSchetD       : string;
  nMarkers        : string[30];
  UnikMarker      : LongInt;
  cRec            : comp;
  MarkerForCyrcle : longint;
  Oborot_Schet    : string;
  Oborot_Kod      : string;
  Oborot_Number   : string;
  Oborot_Name     : string;
  Oborot_SummM    : double;
  Oborot_SummK    : double;
  Oborot_SummY    : double;

  Oborot_SummSchetM    : double;
  Oborot_SummSchetK    : double;
  Oborot_SummSchetY    : double;

  Oborot_SummKodM    : double;
  Oborot_SummKodK    : double;
  Oborot_SummKodY    : double;

  Oborot_SummNumberM    : double;
  Oborot_SummNumberK    : double;
  Oborot_SummNumberY    : double;

  Vsego_SummM    : double;
  Vsego_SummK    : double;
  Vsego_SummY    : double;

  Summ01M  : double;
  Summ02M  : double;
  Summ04M  : double;
  Summ69M  : double;

  Summ01K  : double;
  Summ02K  : double;
  Summ04K  : double;
  Summ69K  : double;

  Summ01Y  : double;
  Summ02Y  : double;
  Summ04Y  : double;
  Summ69Y  : double;

  Vsego_Summ01M  : double;
  Vsego_Summ02M  : double;
  Vsego_Summ04M  : double;
  Vsego_Summ69M  : double;

  Vsego_Summ01K  : double;
  Vsego_Summ02K  : double;
  Vsego_Summ04K  : double;
  Vsego_Summ69K  : double;

  Vsego_Summ01Y  : double;
  Vsego_Summ02Y  : double;
  Vsego_Summ04Y  : double;
  Vsego_Summ69Y  : double;
  #include PAFilter.var
(
  FiltrPodr
)
as select
  #include GP_Podrfiltr1.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.

from
  Zar_User
  ,TMP_Oborot
  ,Lschet
//  ,Lschet Lschet1
  ,Lschet LschetN
  ,Persons PersonsN
//  ,Persons Persons1
  ,CurLSchet
  ,BuhSchet
where 
((
  _cLSchet                  == Formarks.Choice           

  and #include GP_Podrfiltr2.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.
))
;

#include GP_PODRPAFilter.vpp

function MyFoundmarker(_Marker:longint; Str:string): boolean;
{
  var s1:string;
  MyFoundmarker:= false;

  FOR (i := 0; i <= GetMarkerCount(MarkerForCyrcle)-1; i:=i+1)
  {
    GetMarker(MarkerForCyrcle, i, s1);
    if s1 = Str
    {
      MyFoundmarker:= true;
    }
  }
}

procedure FillOborot;
{
  mtClear(#TMP_Oborot, mfNormal);

  insert into TMP_Oborot (Schet 
                          ,Kod   
                          ,Number
                          ,Name  
                          ,datob
                          ,Summ  
                         )
  select oborot.dbscheto
         ,substr(katpodr.kod,1,3)
         ,mnplan.number
         ,stzatr.name
         ,oborot.datob
         ,oborot.sumob
  from oborot,katpodr,stzatr,mnplan,PlansSch where ((
  
  date(1,vOborot.VIDMonthN,vOborot.VIDYear)  <<= Oborot.DatOb
  and date(Last_day(date(1,vOborot.VIDMonthK,vOborot.VIDYear)),vOborot.VIDMonthK,vOborot.VIDYear)  >>= Oborot.DatOb
  and oborot.kauos[4] == katpodr.nrec 
  and oborot.kauos[2] == stzatr.nrec 
  and oborot.kauos[1] == mnplan.nrec
  and Oborot.cPlansSch == PlansSch.nRec
                      )) and Foundmarker(vOborot._PodrMArkerPointer, oborot.kauos[4]) 
                         and MyFoundmarker(vOborot.MarkerForCyrcle, PlansSch.Kod + oborot.dbscheto)
                      ;

}

screen scr1;
fields
  VIDYear      ('За какой год формировать отчета по видам неявок',hcNoContext,sci1Esc):noprotect,spinbutton [1, 1900, 2100];
  VIDMonthN    ('Укажите начальный месяц для формирования отчета',hcNoContext) :
    [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
          ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;
  VIDMonthK     ('Укажите месяц для формирования отчета',hcNoContext) :
    [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
          ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;

  DlgSchetD  ('Фильтр по счетам', hcNoContext): Protect, PickButton;

  FiltrPodr  ('Фильтр по подразделению', hcNoContext): protect, pickbutton;

buttons
  cmOk,,,'Сформировать отчет', ,sci1Esc;
  cmCancel,,,'Выход', ,sci1Esc;
<<
 `Формировать за год`.@@@@@@     `с`.@@@@@@@@@@@@@ `по`.@@@@@@@@@@@@@

 `Cчета             `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `По подразделениям (цехам) отнесения затрат:`
                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. ~С~формировать .>                            <.    ~О~тмена    .>

>>
end;

HandleEvent

cmInit:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);

  InitUser(1); // Инициализация Zar_User
  // Инициализация отчетных дат данными из настроек
  InitCurrentPeriodDates();

  if (not ReadMyDsk(VIDYear, 'VIDYear_Oborot', false))
    set VIDYear := Word(YearRas);

  if (not ReadMyDsk(VIDMonthN, 'VIDMonthN_Oborot', false))
    VIDMonthN := 1; // Январь (нумерация в списке с нуля).

  if (not ReadMyDsk(VIDMonthK, 'VIDMonthK_Oborot', false))
    VIDMonthK := MonthRas;

  if not ReadMyDsk(Filtrpodr,'k_Filtrpodr',false)
    {}
  mrkOuterClassfier:=InitMarker('Oborot_mrkOuterClassfier',8,20,10); //маркер с отмеченными классификаторами

  if GetMarkerCount(mrkOuterClassfier) = 0
    MarkerNotNull:= false;
  else MarkerNotNull:=true;

  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  nMarkers := 'gt' + lPadCh(string(cgPick_Schet),'0',2) + 'buhschet';
  UnikMarker := InitMarker(nMarkers,8,200,100,false);

  RecPlSch := coGetTune('FIN.USER.CPLANSSCH');
  if RecPlSch = 0
    RecPlSch := coGetTune('KONSOLID.CPLANSSCH');

  MarkerForCyrcle := initmarker('',22,200,100,false);

  FOR (i := 0; i <= GetMarkerCount(UnikMarker)-1; i:=i+1)
  {
    GetMarker(UnikMarker, i, cRec);
    if (GetFirst BuhSchet where ((cRec==BuhSchet.NRec))=tsOk)
    {
      if not Foundmarker(MarkerForCyrcle, BuhSchet.SCHET)
        InsertMarker(MarkerForCyrcle, BuhSchet.SCHET);
    }
  }

  DlgSchetD := 'Множественный выбор ('+GetMarkerCount(MarkerForCyrcle)+')';

  StopVisual('', 0);
}

cmUpdateRecord : update current zar_user;

cmCheckField:
{
  case CurField of
    #VIDYear:
    {
      if (VIDYear < 1900) or (VIDYear > YearRas) then
        Set VIDYear := Word(YearRas);
      if (VIDYear = YearRas) and (VIDMonthK > MonthRas) then
        Set VIDMonthK := Word(MonthRas);
    }

    #VIDMonthN:
    {
      if (VIDMonthN > VIDMonthK)
        set VIDMonthN := VIDMonthK;
    }

    #VIDMonthK:
    {
      if (VIDYear = YearRas) and (VIDMonthK > MonthRas) then
        Set VIDMonthK := Word(MonthRas);
      if (VIDMonthN > VIDMonthK)
        set VIDMonthN := VIDMonthK;
    }
  end;  //case
  PodrPubCheck; //Процедура для фильтров по подразд. и работникам
  RedrawPanel(#Zar_User);
}//cmCheckField

cmDelOnProtect:
{
  case CurField of
  end;
}

cmPick:
{
  if (CurField = #DlgSchetD)
  {
    var tmpnRec  : comp;
    var tmpSchet : tSchet3;
    var tmpSubSch  : tSubSch;

    donemarker(unikMarker, nMarkers);

    if (RunInterface(F_BUHSCHET::GetBuhSchet,cgiMulti,RecPlSch,tmpSchet,tmpSubSch)<>cmCancel)
      {
        UnikMarker := InitMarker(nMarkers,8,200,100,false);

        ClearMarker(MarkerForCyrcle);
        
        FOR (i := 0; i <= GetMarkerCount(UnikMarker)-1; i:=i+1)
        {
          GetMarker(UnikMarker, i, cRec);
          if (GetFirst BuhSchet where ((cRec==BuhSchet.NRec))=tsOk)
          {
            if not Foundmarker(MarkerForCyrcle, BuhSchet.SCHET)
              InsertMarker(MarkerForCyrcle, BuhSchet.SCHET);
          }
        }

        DlgSchetD := 'Множественный выбор ('+GetMarkerCount(MarkerForCyrcle)+')';

      }
      else
      {
        abort;  stop;  exit;
      }

  }
  PodrPubPick; //Процедура для фильтров по подразд. и работникам
  RedrawPanel(#Zar_User);
} // cmPick

cmOk:
{

  intinit;

  update current Zar_User;
/*
  if not FillMarks then  // Заполнение Formarks
  {
    abort;
    exit;
  }
*/
  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  var nom:integer;
  var Numcol:integer;
  nom:=3;
  Numcol:=1;

  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);

  ExcelPath:= TranslatePath('%ClientStartPath%');
                                                                                                          
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Oborot.xlsx',true);                                      
  if (xlIsExcelValid)   xlSetActiveSheet(1);//активный лист

  XLPAGESETUPSETORIENTATION(xlLandscape);//альбомный лист
  XLPAGESETUPSETPAPERSIZE(xlPaperA4);//формат листа А4

  xlSetCellStringValue('Ведомость затрат КБ по элементам в разрезе счетов, отделов за месяц с нарастающим итогом с начала года c '+DateToStr(date(1,VIDMonthN,VIDYear), 'mon')
      +' по '+DateToStr(date(1,VIDMonthK,VIDYear), 'month')+' '+DateToStr(date(1,VIDMonthK,VIDYear), 'YYYY года'), 1, 3, 1, 3);
  xlSetFontStyle(xlBold, 1, 3, 1, 3);
  xlSetFontSize(18, 1, 3, 1, 3);

  StopVisual('', 0);

  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Обработка информации...', 1);

  // заполняем временную таблицу для подсчета
  FillOborot;

  StopVisual('', 0);

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Формирование отчета...', RecordsInTable(#TMP_Oborot));

  Oborot_SummM := Oborot_SummK := Oborot_SummY := 0; 
  Oborot_SummSchetM := Oborot_SummSchetK := Oborot_SummSchetY := 0;
  Oborot_SummKodM := Oborot_SummKodK := Oborot_SummKodY := 0;
  Oborot_SummNumberM := Oborot_SummNumberK := Oborot_SummNumberY := 0;
  Vsego_SummM := Vsego_SummK := Vsego_SummY := 0;
  Summ01M := Summ01K := Summ01Y := Summ02M := Summ02K := Summ02Y := 0;
  Summ04M := Summ04K := Summ04Y := Summ69M := Summ69K := Summ69Y := 0;
  Vsego_Summ01M := Vsego_Summ01K := Vsego_Summ01Y := Vsego_Summ02M := Vsego_Summ02K := Vsego_Summ02Y := 0;
  Vsego_Summ04M := Vsego_Summ04K := Vsego_Summ04Y := Vsego_Summ69M := Vsego_Summ69K := Vsego_Summ69Y := 0;

  If getfirst fastfirstrow TMP_Oborot  = tsok
  {

    Oborot_Schet  := TMP_Oborot.Schet;
    Oborot_Kod    := TMP_Oborot.Kod;
    Oborot_Number := TMP_Oborot.Number;
    Oborot_Name   := TMP_Oborot.Name;

  }

  _loop TMP_Oborot
  {

    if not NextVisual
      break;

    if Oborot_Schet  != TMP_Oborot.Schet or Oborot_Kod != TMP_Oborot.Kod 
       or Oborot_Name != TMP_Oborot.Name
    {

      Numcol:=1;
      xlSetCellStringValue(Oborot_Schet              , ++nom,   Numcol, nom, Numcol);
      xlSetCellStringValue(Oborot_Kod                ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Oborot_Number             ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Oborot_Name               ,   nom, ++Numcol, nom, Numcol);

      xlSetCellStringValue(Oborot_SummM                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Oborot_SummK                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Oborot_SummY                  ,   nom, ++Numcol, nom, Numcol);

      Oborot_Name   := TMP_Oborot.Name;
      Oborot_Number    := TMP_Oborot.Number;
      Oborot_SummM  := Oborot_SummK := Oborot_SummY := 0; 
    }

    if Oborot_Schet  != TMP_Oborot.Schet or Oborot_Kod != TMP_Oborot.Kod 
    {

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по отделу '+ Oborot_Kod                       , ++nom,   Numcol, nom, Numcol);

      Numcol:=4;
      xlSetCellStringValue(Oborot_SummKodM                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Oborot_SummKodK                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Oborot_SummKodY                  ,   nom, ++Numcol, nom, Numcol);

      xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      Oborot_Kod    := TMP_Oborot.Kod;
      Oborot_SummKodM := Oborot_SummKodK := Oborot_SummKodY := 0;
    }

    if Oborot_Schet  != TMP_Oborot.Schet
    {

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по Счету '+ Oborot_Schet                       , ++nom,   Numcol, nom, Numcol);

      Numcol:=4;
      xlSetCellStringValue(Oborot_SummSchetM                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Oborot_SummSchetK                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Oborot_SummSchetY                  ,   nom, ++Numcol, nom, Numcol);

      xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по 01 '                       , ++nom,   Numcol, nom, Numcol);

      Numcol:=4;
      xlSetCellStringValue(Summ01M                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Summ01K                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Summ01Y                  ,   nom, ++Numcol, nom, Numcol);

      xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по 02 '                      , ++nom,   Numcol, nom, Numcol);

      Numcol:=4;
      xlSetCellStringValue(Summ02M                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Summ02K                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Summ02Y                  ,   nom, ++Numcol, nom, Numcol);

      xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по 04 '                       , ++nom,   Numcol, nom, Numcol);

      Numcol:=4;
      xlSetCellStringValue(Summ04M                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Summ04K                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Summ04Y                  ,   nom, ++Numcol, nom, Numcol);

      xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по 69 '                      , ++nom,   Numcol, nom, Numcol);

      Numcol:=4;
      xlSetCellStringValue(Summ69M                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Summ69K                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Summ69Y                  ,   nom, ++Numcol, nom, Numcol);

      xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      Oborot_Schet    := TMP_Oborot.Schet;
      Oborot_SummSchetM := Oborot_SummSchetK := Oborot_SummSchetY := 0;
      Summ01M := Summ01K := Summ01Y := Summ02M := Summ02K := Summ02Y := 0;
      Summ04M := Summ04K := Summ04Y := Summ69M := Summ69K := Summ69Y := 0;
    }

    if VIDMonthK = month(TMP_Oborot.datob)
    {
      Oborot_SummM       += TMP_Oborot.Summ;
      Oborot_SummSchetM  += TMP_Oborot.Summ;
      Oborot_SummKodM    += TMP_Oborot.Summ;
      Oborot_SummNumberM += TMP_Oborot.Summ;
      Vsego_SummM        += TMP_Oborot.Summ;

      case substr(TMP_Oborot.Name,1,2) of
        '01': {
          Summ01M += TMP_Oborot.Summ;
          Vsego_Summ01M += TMP_Oborot.Summ;
        }

        '02': {
          Summ02M += TMP_Oborot.Summ;
          Vsego_Summ02M += TMP_Oborot.Summ;
        }

        '04': {
          Summ04M += TMP_Oborot.Summ;
          Vsego_Summ04M += TMP_Oborot.Summ;
        }

        '69': {
          Summ69M += TMP_Oborot.Summ;
          Vsego_Summ69M += TMP_Oborot.Summ;
        }
      end;
    }

    if ((month(TMP_Oborot.datob)-1) div 3 + 1) = ((VIDMonthK-1) div 3 + 1)
    {
      Oborot_SummK       += TMP_Oborot.Summ;
      Oborot_SummSchetK  += TMP_Oborot.Summ;
      Oborot_SummKodK    += TMP_Oborot.Summ;
      Oborot_SummNumberK += TMP_Oborot.Summ;
      Vsego_SummK        += TMP_Oborot.Summ;

      case substr(TMP_Oborot.Name,1,2) of
        '01': {
          Summ01K += TMP_Oborot.Summ;
          Vsego_Summ01K += TMP_Oborot.Summ;
        }

        '02': {
          Summ02K += TMP_Oborot.Summ;
          Vsego_Summ02K += TMP_Oborot.Summ;
        }

        '04': {
          Summ04K += TMP_Oborot.Summ;
          Vsego_Summ04K += TMP_Oborot.Summ;
        }

        '69': {
          Summ69K += TMP_Oborot.Summ;
          Vsego_Summ69K += TMP_Oborot.Summ;
        }
      end;
    }

    Oborot_SummY       += TMP_Oborot.Summ;
    Oborot_SummSchetY  += TMP_Oborot.Summ;
    Oborot_SummKodY    += TMP_Oborot.Summ;
    Oborot_SummNumberY += TMP_Oborot.Summ;
    Vsego_SummY        += TMP_Oborot.Summ;

    case substr(TMP_Oborot.Name,1,2) of
      '01': {
        Summ01Y += TMP_Oborot.Summ;
        Vsego_Summ01Y += TMP_Oborot.Summ;
      }

      '02': {
        Summ02Y += TMP_Oborot.Summ;
        Vsego_Summ02Y += TMP_Oborot.Summ;
      }

      '04': {
        Summ04Y += TMP_Oborot.Summ;
        Vsego_Summ04Y += TMP_Oborot.Summ;
      }

      '69': {
        Summ69Y += TMP_Oborot.Summ;
        Vsego_Summ69Y += TMP_Oborot.Summ;
      }
    end;


  }

  if Oborot_SummY != 0
  {
    Numcol:=1;
    xlSetCellStringValue(Oborot_Schet              , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(Oborot_Kod                ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Oborot_Number             ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Oborot_Name               ,   nom, ++Numcol, nom, Numcol);

    xlSetCellStringValue(Oborot_SummM                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Oborot_SummK                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Oborot_SummY                  ,   nom, ++Numcol, nom, Numcol);
  }

  if Oborot_SummKodY != 0
  {
    Numcol:=1;
    xlSetCellStringValue('ИТОГО по отделу '+ Oborot_Kod                       , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Oborot_SummKodM                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Oborot_SummKodK                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Oborot_SummKodY                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  }

  if Oborot_SummSchetY != 0
  {
    Numcol:=1;
    xlSetCellStringValue('ИТОГО по Счету '+ Oborot_Schet                       , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Oborot_SummSchetM                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Oborot_SummSchetK                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Oborot_SummSchetY                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

    Numcol:=1;
    xlSetCellStringValue('ИТОГО по 01 '                       , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Summ01M                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Summ01K                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Summ01Y                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

    Numcol:=1;
    xlSetCellStringValue('ИТОГО по 02 '                      , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Summ02M                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Summ02K                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Summ02Y                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

    Numcol:=1;
    xlSetCellStringValue('ИТОГО по 04 '                       , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Summ04M                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Summ04K                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Summ04Y                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

    Numcol:=1;
    xlSetCellStringValue('ИТОГО по 69 '                      , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Summ69M                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Summ69K                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Summ69Y                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  }

  if Vsego_SummY != 0
  {
    Numcol:=1;
    xlSetCellStringValue('ВСЕГО'                       , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Vsego_SummM                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_SummK                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_SummY                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

    Numcol:=1;
    xlSetCellStringValue('ВСЕГО по 01'                       , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Vsego_Summ01M                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_Summ01K                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_Summ01Y                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

    Numcol:=1;
    xlSetCellStringValue('ВСЕГО по 02'                       , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Vsego_Summ02M                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_Summ02K                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_Summ02Y                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

    Numcol:=1;
    xlSetCellStringValue('ВСЕГО по 04'                       , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Vsego_Summ04M                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_Summ04K                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_Summ04Y                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

    Numcol:=1;
    xlSetCellStringValue('ВСЕГО по 69'                       , ++nom,   Numcol, nom, Numcol);

    Numcol:=4;
    xlSetCellStringValue(Vsego_Summ69M                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_Summ69K                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_Summ69Y                  ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  }

  xlWrapText(4, 1, nom, Numcol);//перенос по словам
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB + xlInsideV + xlInsideH,
                      xlThin, xlContinuous, 0, 4, 1, nom, Numcol);//рамка xlThick - жирная

  StopVisual('',0);
  xlkillExcel;

  exitproc;

}

cmClose:
{
  SaveMyDSK(VIDYear,   'VIDYear_Oborot');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_Oborot');
  SaveMyDSK(VIDMonthK, 'VIDMonthK_Oborot');
  DoneMarker(_PodrMArkerPointer,'');
  DoneMarker(mrkOuterClassfier,'Oborot_mrkOuterClassfier');
  DoneMarker(MarkerForCyrcle, '');
  donemarker(unikMarker, nMarkers);

}

cmDone:
{
  SaveMyDSK(VIDYear,   'VIDYear_Oborot');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_Oborot');
  SaveMyDSK(VIDMonthK, 'VIDMonthK_Oborot');
  DoneMarker(_PodrMArkerPointer,'');
  DoneMarker(mrkOuterClassfier,'Oborot_mrkOuterClassfier');
  DoneMarker(MarkerForCyrcle, '');
  donemarker(unikMarker, nMarkers);

}

end;
end.

#include UserReport.vih

VipInterface UserReport_gp_Oborot1 Implements IUserReport;
Interface UserReport_gp_Oborot1;

Procedure Run;
Begin
  runinterface(gp_Oborot1);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Ведомость затрат КБ по элементам в разрезе счетов, отделов';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
