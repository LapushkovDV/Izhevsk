#include PAFilter.vih


interface gp_OtchSverx 'Отчет о работе сверхурочно и работе в выходные дни' EscClose, Gray;
  show at (,,80,10);

  table struct tmp_KlVidOpl 
  (
    Nrec   : comp,
    VidOpl : longint,
    VidOplP: longint,
    NVIDOPL: string,
    VHVOE19: string,
    VHVOE32: string,  //общая входимость в облагаемую базу ЕСН/СВ
                      //поле социальных налогов на вкладке Расчеты
    VHVOE34: string,  //входимость в отчетность
    VHVOE35: string,
    VHVOE5:  string
  )
  with index
  (
    tmp_KlPerOpl01 = VidOpl
  );
  // суммы по графам
  table struct nachislzakazSum   
  (
    Nrec          : Comp,
    Summa         : double,
    VidOpl        : longint,
    VidOplP       : longint,
    cLsch         : comp,
    CexOz         : comp,
    cNach         : comp,
    cPodrOZ       : comp,
    Koldn         : double,
    CHASF         : double,
    MesN          : word,
    Mes           : integer,
    Sovm          : word,
    Summa30       : double,
    Proc          : double,
    cSchetD       : string[20],
    cSubSchD      : string[21],
    cKAUD         : array [1..6] of Comp,
    TblD          : array [1..6] of Word,
    sReCalc       : string[1],
    YearN         : Integer,
    Tek           : Integer,
    Podr3         : string[3]
  )
  with index 
  (
    nachislzakazSum01 = Podr3+clsch, nc02=clsch
  );

  table struct tmp_WT   
  (
    KoldnRV       : double,
    CHASFRV       : double,
    CHASFSverx    : double,
    CHASFRO       : double,
    sPodr3        : string[3]
  )
  with index 
  (
    tmp_WT01 = sPodr3
  );

create view vOtchSverx
var
  ExcelPath       : string;
  i               : integer;
  VIDYear         : word;
  VIDMonthN       : word;
  cLschetNrec     : comp;
  cTemp           : comp;
  MarkerVidOpl    : longInt;
  ItogCol         : integer;
  Otch_Podr3      : string[3];
  RVD,RVCh, CCh, ROCh: double;
  DateB           : date;          // дата начала
  DateE           : date;          // дата окончания
  Kolvo:longint;
  #include PAFilter.var
(
  FiltrPodr,
  FiltrPublic
)
as select
  #include GP_Podrfiltr1.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.

from
  Zar_User
  ,Lschet
//  ,Lschet Lschet1
  ,Lschet LschetN
  ,Persons PersonsN
//  ,Persons Persons1
//  ,SumVidOp
//  ,nachislzakaz
  ,nachislzakazSum
  ,tmp_KlVidOpl
  ,KlVidOpl
  ,tmp_WT
  ,KatPodr
  ,CurLschet
where 
((
  _cLSchet                    == Formarks.Choice           
  and #include GP_Podrfiltr2.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.
))
;

#include GP_PODRPAFilter.vpp
var lVidOpl   : array [0..0] of longInt;
var ChVidOpl  : array [0..0] of Double;
var SumVidOpl : array [0..0] of Double;

procedure FillnachislzakazSumByLschet;
{
  cLschetNrec := Formarks.cLschet;




  insert into nachislzakazSum (Nrec, Summa, VidOpl, VidOplP, cLsch, CexOz, cPodrOz, Koldn, CHASF, MesN, Mes, Summa30,Proc,
                          cSchetD,cSubSchD,cKAUD[1],cKAUD[2],cKAUD[3],cKAUD[4],cKAUD[5],cKAUD[6],
                        TblD[1],TblD[2],TblD[3],TblD[4],TblD[5],TblD[6],sReCalc, YearN, Tek, Podr3)
  select nachislzakaz.Nrec,
         nachislzakaz.Summa,
         nachislzakaz.VidOPlS,
         nachislzakaz.VidOPl,
         nachislzakaz.cLSch,
         nachislzakaz.CexOz,
         nachislzakaz.cPodr,
         nachislzakaz.Koldn,
!        if(nachislzakaz.sisopl=20,nachislzakaz.CHASF,0),
         nachislzakaz.CHASF,
         nachislzakaz.MesV,
         nachislzakaz.Mes,
         nachislzakaz.Summa30,
         nachislzakaz.Proc,
         nachislzakaz.cSchetD,
         nachislzakaz.cSubSchD,
         nachislzakaz.cKAUD[1],
         nachislzakaz.cKAUD[2],
         nachislzakaz.cKAUD[3],
         nachislzakaz.cKAUD[4],
         nachislzakaz.cKAUD[5],
         nachislzakaz.cKAUD[6],
         nachislzakaz.TblD[1],
         nachislzakaz.TblD[2],
         nachislzakaz.TblD[3],
         nachislzakaz.TblD[4],
         nachislzakaz.TblD[5],
         nachislzakaz.TblD[6],
         nachislzakaz.Otkuda,
         nachislzakaz.YearV,
         integer(2),
         substr(katpodr.kod,1,3)
  from nachislzakaz where (( vOtchSverx.cLschetNrec == nachislzakaz.cLsch and
                        vOtchSverx.VIDYear     == nachislzakaz.YearN(noindex) and
                        vOtchSverx.VIDMonthN   == nachislzakaz.MesN(noindex) and
                        nachislzakaz.CexOz          == KatPodr.Nrec   and
                        nachislzakaz.VidOPlS        == tmp_KlVidOpl.VidOpl
                      )) and Foundmarker(vOtchSverx.MarkerVidOpl, tmp_KlVidOpl.Nrec) 
!			and (nachislzakaz.param='Распред-Сделка' or nachislzakaz.param='Переносим')
			and Nachislzakaz.kateg = 1
//                         and (nachislzakaz.SisOpl = 20)// or nachislzakaz.SisOpl = 30)
                         //and nachislzakaz.Summa != 0 
                         ;


     

}

procedure FillWT;
{
  cLschetNrec := Formarks.cLschet;

  if LoadWorkingTable(cLschetNrec, VIDMonthN, VIDYear) = 0
  {

    RVD := RVCh := CCh := ROCh := 0;


          RVD  += WT_GetAbsencesDays(stActual , 'РВ', DateB, DateE); 
          RVCh += WT_GetAbsencesHours(stActual, 'РВ', DateB, DateE);
          CCh  += WT_GetAbsencesHours(stActual, 'С' , DateB, DateE);
          ROCh += WT_GetAbsencesHours(stActual, 'РО', DateB, DateE);
  
    if getfirst fastfirstrow Lschet where((Formarks.cLschet == Lschet.Nrec)) = tsOk
    {
    
      if getfirst fastfirstrow KatPodr where((Lschet.Cex      == KatPodr.Nrec)) = tsOk
      {
    
        if getfirst fastfirstrow tmp_WT where((substr(katpodr.kod,1,3) == tmp_WT.sPodr3)) = tsOk
        {
          tmp_WT.KoldnRV    += RVD ; 
          tmp_WT.CHASFRV    += RVCh;
          tmp_WT.CHASFSverx += CCh ;
          tmp_WT.CHASFRO    += ROCh;
          update current tmp_WT;
        }
        else
        {
!	  if(RVD<>0 or RVCh<>0 or CCh<>0 or ROch<>0)
!	  {

          ClearBuffer(#tmp_WT);
          tmp_WT.KoldnRV    += RVD ; 
          tmp_WT.CHASFRV    += RVCh;
          tmp_WT.CHASFSverx += CCh ;
          tmp_WT.CHASFRO    += ROCh;
          tmp_WT.sPodr3     := substr(katpodr.kod,1,3);
          insert current tmp_WT;

          clearbuffer(#nachislzakazsum);
	  nachislzakazsum.Podr3:=tmp_WT.sPodr3;
	  insert current nachislzakazsum;
!	  }

        }
  
      }//if getfirst fastfirstrow KatPodr where((Lschet.Cex      == KatPodr.Nrec)) = tsOk
  
    }//if getfirst fastfirstrow Lschet where((Formarks.cLschet == Lschet.Nrec)) = tsOk
  
  }//if LoadWorkingTable(Formarks.cLschet, VIDMonthN, VIDYear) = 0

}

//-------------------------------------------------------------------------------
// виды оплаты 
//-------------------------------------------------------------------------------
function fNmVidOplDogStr: string;
var
  liCountMarker : longInt;
  cnRecVidOplDog: comp;
{
  fNmVidOplDogStr := 'Не заданы';

  liCountMarker   := GetMarkerCount(MarkerVidOpl);

  case liCountMarker of
  0:
  {
    exit;
  }
  1:
  {
    GetMarker(MarkerVidOpl, 0, cnRecVidOplDog);
    if ( getFirst KlVidOpl where (( cnRecVidOplDog == KlVidOpl.Nrec )) = tsOk )
    {
      fNmVidOplDogStr := string(KlVidOpl.VidOplP) + ', ' + KlvidOpl.NVidOpl;
    }
  }
  2..4:
  {
    fNmVidOplDogStr := 'Задано ' + string(liCountMarker) + ' вида оплаты';
  }
  else
  {
    fNmVidOplDogStr := 'Задано ' + string(liCountMarker) + ' видов оплаты';
  }
  end;
}//function fNmVidOplDogStr

screen scr1;
fields
  VIDYear      ('За какой год формировать отчета по видам неявок',hcNoContext,sci1Esc):noprotect,spinbutton [1, 1900, 2100];
  VIDMonthN    ('Укажите начальный месяц для формирования отчета',hcNoContext) :
    [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
          ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;
  [VidOplDogStr] fNmVidOplDogStr() ('Виды оплаты',, sci13Esc): protect, pickbutton;
  Zar_User.GrupStN ('Выбор фильтра для отчета', hcNoContext): noprotect;
  FiltrPodr  ('Фильтр по подразделению', hcNoContext): protect, pickbutton;
  FiltrPublic('Фильтр по работникам', hcNoContext): protect,pickbutton;

buttons
  cmOk,,,'Сформировать отчет', ,sci1Esc;
  cmCancel,,,'Выход', ,sci1Esc;
<<
 `Формировать за год`.@@@@@@     `за`.@@@@@@@@@@@@@

 `Виды оплаты `      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  [.] подразделению` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] работникам   ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. ~С~формировать .>                            <.    ~О~тмена    .>

>>
end;

HandleEvent

cmInit:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);

  InitUser(1); // Инициализация Zar_User
  // Инициализация отчетных дат данными из настроек
  InitCurrentPeriodDates();

  LockLogFile;

  if (not InitWorkingTable)
    {abort;exit;}

  if (not ReadMyDsk(VIDYear, 'VIDYear_OtchSverx', false))
    set VIDYear := Word(YearRas);

  if (not ReadMyDsk(VIDMonthN, 'VIDMonthN_OtchSverx', false))
    VIDMonthN := 1; // Январь (нумерация в списке с нуля).

  MarkerVidOpl := InitMarker('mVidoplDog_OtchSverx', 8, 10, 10);

  mtClear(#tmp_KlVidOpl, mfNormal);
  insert into tmp_KlVidOpl
  select KlVidOpl.Nrec, 
         KlVidOpl.Vidopl, 
         KlVidOpl.VidoplP, 
         KlVidOpl.NVIDOPL, 
         Trim(KlVidopl.VHVOE[19]),
         Trim(KlVidopl.VHVOE[32]), 
         Trim(KlVidopl.VHVOE[34]),
         Trim(KlVidopl.VHVOE[35]), 
         Trim(KlVidopl.VHVOE[5])
  from KlVidOpl;

  StopVisual('', 0);
}

cmUpdateRecord : update current zar_user;

cmCheckField:
{
  case CurField of
    #VIDYear:
    {
      if (VIDYear < 1900) or (VIDYear > YearRas) then
        Set VIDYear := Word(YearRas);
      if (VIDYear = YearRas) and (VIDMonthN > MonthRas) then
        Set VIDMonthN := Word(MonthRas);
    }

    #VIDMonthN:
    {
      if (VIDYear = YearRas) and (VIDMonthN > MonthRas) then
        Set VIDMonthN := Word(MonthRas);
    }

  end;  //case
  PodrPubCheck; //Процедура для фильтров по подразд. и работникам
  RedrawPanel(#Zar_User);
}//cmCheckField

cmDelOnProtect:
{
  case CurField of
  #VidOplDogStr:
  //виды оплаты по договорам
  {
    ClearMarker(MarkerVidOpl);
    RedrawPanel(CurTable);
  }
  end;
}

cmPick:
{
  if CurField = #VidOplDogStr
  {
    cTemp := comp(0);
    RunInterface(Z_Calc::PickZarEntity , 1, cTemp, 103, MarkerVidOpl)
  }

  PodrPubPick; //Процедура для фильтров по подразд. и работникам
  RedrawPanel(#Zar_User);
} // cmPick

cmOk:
{
DateB:=date(1,VidMonthN,VidYear);
DateE:=date(last_day(DateB),VidMonthN,VidYear);


//  intinit;

  if GetMarkerCount(MarkerVidOpl) = 0
  {
         Message(chr(3)+'Нет задан фильтр "Виды оплаты"', Information + OkButton);
         abort;
         exit;
  }

  var nom:integer;
  var Numcol:integer;
  nom:=2;
  Numcol:=1;

  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);

  ExcelPath:= TranslatePath('%ClientStartPath%');
                                                                                                          
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\OtchSverx.xlsx',true);                                      
  if (xlIsExcelValid)   xlSetActiveSheet(1);//активный лист

  XLPAGESETUPSETORIENTATION(xlLandscape);//альбомный лист
  XLPAGESETUPSETPAPERSIZE(xlPaperA4);//формат листа А4

  xlSetCellStringValue('Отчет о работе сверхурочно и работе в выходные дни за '+DateToStr(date(1,VIDMonthN,VIDYear), 'month')+' '+DateToStr(date(1,VIDMonthN,VIDYear), 'YYYY года'), 1, 3, 1, 3);
  xlSetFontStyle(xlBold, 1, 3, 1, 3);
  xlSetFontSize(18, 1, 3, 1, 3);

  update current Zar_User;

  nom:=3;
  Numcol:=1;

  _loop FullCache tmp_KlVidOpl
  {

    if not Foundmarker(MarkerVidOpl, tmp_KlVidOpl.Nrec)
      continue;

    Numcol += 3;
    lVidOpl[(Numcol-4)/3]     := tmp_KlVidOpl.VidOpl;
    xlSetCellStringValue('Вид оплаты '+tmp_KlVidOpl.VidOplp  ,   nom, Numcol, nom, Numcol);
    xlMergeCells(nom, Numcol, nom, Numcol+2);// об]единение ячеек

    xlSetCellStringValue('Нормо-часы'  ,   nom+1,   Numcol,   nom+1, Numcol);
    xlSetCellStringValue('Часы'        ,   nom+1,   Numcol+1, nom+1, Numcol+1);
    xlSetCellStringValue('Сумма'       ,   nom+1,   Numcol+2, nom+1, Numcol+2);
  }

  Numcol += 2;

  ItogCol := ((Numcol-3)/3);
  if ItogCol > 0
    ItogCol -= 1;

  xlSetCellStringValue('Табель'        ,   nom, ++Numcol, nom, Numcol);
  xlMergeCells(nom, Numcol, nom, Numcol+3);// об]единение ячеек

  xlSetCellStringValue('Выходные дни(РВ)'            ,     nom+1,   Numcol, nom+1, Numcol);
  xlSetCellStringValue('Часы в выходные(РВ)'         ,     nom+1, ++Numcol, nom+1, Numcol);
  xlSetCellStringValue('Часы переработки'            ,     nom+1, ++Numcol, nom+1, Numcol);
  xlSetCellStringValue('Работа за отгулы, часов(РО)' ,     nom+1, ++Numcol, nom+1, Numcol);

  xlSetFontStyle(xlBold              , nom-1, 1, nom, Numcol);
  xlAlignCellsEx(xlCenter,xlCenter   , nom-1, 1, nom, Numcol); //текст в ячейке по центру

  xlSetCellStringValue('Суммарно'        ,   nom, ++Numcol, nom, Numcol);
  xlMergeCells(nom, Numcol, nom, Numcol+3);// об]единение ячеек

  xlSetCellStringValue('Выходные дни'            ,   ++nom,   Numcol, nom, Numcol);
  xlSetCellStringValue('Нормо-часы'         ,     nom, ++Numcol, nom, Numcol);
  xlSetCellStringValue('Чел-часы (по табелю)'            ,     nom, ++Numcol, nom, Numcol);
  xlSetCellStringValue('Сумма' ,     nom, ++Numcol, nom, Numcol);

  xlSetFontStyle(xlBold              , nom-1, 1, nom, Numcol);
  xlAlignCellsEx(xlCenter,xlCenter   , nom-1, 1, nom, Numcol); //текст в ячейке по центру
  nom++;

  if not FillMarks then  // Заполнение Formarks
  {
    abort;
    exit;
  }

  StopVisual('', 0);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Обработка информации...', RecordsInTable(#Formarks));

  mtClear(#nachislzakazSum, mfNormal);
  mtClear(#tmp_WT, mfNormal);
 
  _loop Formarks
  {

    if not NextVisual
      break;


    if getfirst lschet where ((Formarks.cLschet==lschet.nrec))=tsok
	{
		if lschet.kateg=1
		{
    // заполняем временную таблицу для подсчета
!    Kolvo:=RecordsIntable(#nachislzakazSum);

	    FillnachislzakazSumByLschet;
   	    FillWT;
		}
	}

!    if(  Kolvo<>RecordsIntable(#nachislzakazSum))
!    {

!    if getfirst nachislzakazSum where ((Formarks.cLschet==nachislzakazSum.clsch))=tsok
!    {

!    }
!    }

  }//_loop Formarks

  StopVisual('', 0);

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Формирование отчета...', RecordsInTable(#nachislzakazSum));

/*
  If getfirst fastfirstrow nachislzakazSum  = tsok
  {
    Otch_Podr3 := nachislzakazSum.Podr3;
  }
*/
  _loop FullCache nachislzakazSum ordered by nachislzakazSum.podr3
  {
    Otch_Podr3 := nachislzakazSum.Podr3;
    break;
  }

  nom:=4;

  _loop FullCache nachislzakazSum ordered by nachislzakazSum.podr3
  {

    if not NextVisual
      break;

    if Otch_Podr3 != nachislzakazSum.Podr3
    {

      Numcol:=1;
      xlSetCellStringValue(Otch_Podr3                      , ++nom,   Numcol, nom, Numcol);
    
      xlSetCellStringValue(VIDYear                         ,   nom, ++Numcol, nom, Numcol);
                           
      xlSetCellStringValue(VIDMonthN                       ,   nom, ++Numcol, nom, Numcol);

      for(i := 0; i <= ItogCol; i++)
      {
        xlSetCellStringValue(ChVidOpl[i]                   ,   nom, ++Numcol, nom, Numcol);
        Numcol++;
        xlSetCellStringValue(SumVidOpl[i]                  ,   nom, ++Numcol, nom, Numcol);
      }

      if getfirst fastfirstrow tmp_WT where((Otch_Podr3 == tmp_WT.sPodr3)) = tsOk
      {
        xlSetCellStringValue(tmp_WT.KoldnRV                  ,   nom, ++Numcol, nom, Numcol);
        xlSetCellStringValue(tmp_WT.CHASFRV                  ,   nom, ++Numcol, nom, Numcol);
        xlSetCellStringValue(tmp_WT.CHASFSverx               ,   nom, ++Numcol, nom, Numcol);
        xlSetCellStringValue(tmp_WT.CHASFRO                  ,   nom, ++Numcol, nom, Numcol);

  xlSetCellFormula('=P'+Nom   				,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=D'+Nom+'+G'+Nom   			,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=Q'+Nom+'+R'+Nom+'+S'+Nom   	,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=F'+Nom+'+I'+Nom+'+L'+Nom+'+O'+Nom   ,   nom, ++Numcol, nom, Numcol);

      }
      else
        Numcol+=4;

      Otch_Podr3 := nachislzakazSum.Podr3;

      for(i := 0; i <= ItogCol; i++)
      {
        ChVidOpl[i]  := 0;
        SumVidOpl[i] := 0;
      }

    }

    for(i := 0; i <= ItogCol; i++)
    {
      if lVidOpl[i] = nachislzakazSum.VidOpl
      {
	if (nachislzakazSum.VidOpl=9 or nachislzakazSum.VidOpl=11)
	{
        ChVidOpl[i]  += nachislzakazSum.CHASF;
	}
        SumVidOpl[i] += nachislzakazSum.Summa;
      }
    }
/*
    Numcol:=1;
    xlSetCellStringValue(nachislzakazSum.Podr3     , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(nachislzakazSum.VidOplP   ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(nachislzakazSum.Summa     ,   nom, ++Numcol, nom, Numcol);
*/
  }//_loop FullCache nachislzakazSum

  var IVsego : double;
  IVsego := 0;

  for(i := 0; i <= ItogCol; i++)
    IVsego += SumVidOpl[i];

  if IVsego != 0
  {

    Numcol:=1;
    xlSetCellStringValue(Otch_Podr3                      , ++nom,   Numcol, nom, Numcol);
  
    xlSetCellStringValue(VIDYear                         ,   nom, ++Numcol, nom, Numcol);
                         
    xlSetCellStringValue(VIDMonthN                       ,   nom, ++Numcol, nom, Numcol);

    for(i := 0; i <= ItogCol; i++)
    {
      xlSetCellStringValue(ChVidOpl[i]                   ,   nom, ++Numcol, nom, Numcol);
      Numcol++;
      xlSetCellStringValue(SumVidOpl[i]                  ,   nom, ++Numcol, nom, Numcol);
    }

    if getfirst fastfirstrow tmp_WT where((Otch_Podr3 == tmp_WT.sPodr3)) = tsOk
    {
      xlSetCellStringValue(tmp_WT.KoldnRV                ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(tmp_WT.CHASFRV                ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(tmp_WT.CHASFSverx             ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(tmp_WT.CHASFRO                ,   nom, ++Numcol, nom, Numcol);

  xlSetCellFormula('=P'+Nom   				,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=D'+Nom+'+G'+Nom   			,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=Q'+Nom+'+R'+Nom+'+S'+Nom   	,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=F'+Nom+'+I'+Nom+'+L'+Nom+'+O'+Nom   ,   nom, ++Numcol, nom, Numcol);

    }
    else
      Numcol+=4

  }

  Numcol := 1;
  xlSetCellStringValue('ВСЕГО'                        , ++nom,   Numcol, nom, Numcol);
  
  Numcol += 2;

  for(i := 0; i <= ItogCol; i++)
  {
    xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
    xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
    xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
  }

  xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);
  xlSetCellFormula('=СУММ(R[-'+Integer(nom-5)+']C:R[-1]C)'   ,   nom, ++Numcol, nom, Numcol);


  xlMergeCells(nom, 1, nom, 3);// об]единение ячеек
  xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

  xlWrapText(3, 1, nom, Numcol);//перенос по словам
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB + xlInsideV + xlInsideH,
                      xlThin, xlContinuous, 0, 3, 1, nom, Numcol);//рамка xlThick - жирная

  StopVisual('',0);
  xlkillExcel;

//  exitproc;

}

cmClose:
{
  SaveMyDSK(VIDYear,   'VIDYear_OtchSverx');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_OtchSverx');
  DoneMarker(MarkerVidOpl, 'mVidoplDog_OtchSverx');
  DoneWorkingTable;
  UnLockLogFile;
}

cmDone:
{
  SaveMyDSK(VIDYear,   'VIDYear_OtchSverx');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_OtchSverx');
  DoneMarker(MarkerVidOpl, 'mVidoplDog_OtchSverx');
  DoneWorkingTable;
  UnLockLogFile;
}

end;
end.

