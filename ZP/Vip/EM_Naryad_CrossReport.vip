//************************************************************
#component "EM"
Interface EM_Naryad_CrossReport 'Кросс-\Отчет по нарядам из трех баз' (,,sci17EnEsc), EscClose;
//************************************************************
Show At (,,50,7);
//----------------------------------------
table struct tfPodr
(
   nrec : comp
  ,Kod  : string
)
with index
(
  ind0 = nrec
, ind1 = Kod
)
;

table struct tfStatus
(
  name : string
)
with index
(
 ind1 = name
)
;

table struct tReportSvod
(
   Day    : date
 , planVP : double
 , FactVP : double
)
with index
(
 ind0 = Day
)
;

table struct tReport
(
  Number     : string
, Status     : string
, PodrKod    : string
, totalChasF : double
, year       : word
, month      : word
, day        : date
, SystemSrc  : string
, Location   : string
)
with index
(
   ind0 = Number
 , ind1 = day
)
;
Create View
var
   _log : string = 'ReportCrossReport.log';
   _fDateB
 , _fDateE  : date;
   _fPlanVP : double;
   _fPodr   : string;
   _fTypeRep : byte;
// _BarKod : string;
as select
 tReport.number
from
   KatPodr
 , tReport
 , tfPodr
 , tReportSvod
 , tfStatus
;

Procedure GetDateFromTunes(var _dateB : date; var _dateE : date);
{
  var _dayBeg   : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_BEG');
  var _MonthBeg : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_BEG');
  var _YearBeg  : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_BEG');
  var _dayEnd   : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_END');
  var _MonthEnd : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_END');
  var _YearEnd  : word = wgettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_END');

  _dateB :=  date(_dayBeg,_MonthBeg, _YearBeg);
  _dateE :=  date(_dayEnd,_MonthEnd, _YearEnd);
}
Procedure SetTunesFromDates(_dateB : date; _dateE : date);
{
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_BEG'  ,   day(_dateB) );
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_BEG', month(_dateB) );
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_BEG' ,  year(_dateB) );

  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_END'  ,   day(_dateE) );
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_END', month(_dateE) );
  wsettune('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_END' ,  year(_dateE) );
}
Screen ScrMain;
Fields
 _fTypeRep : [List 0 'Предварительный', 1 'Окончательный'], protect;
 _fDateB  : NoProtect;
 _fDateE  : NoProtect;
 _fPlanVP : NoProtect;
 _fPodr   : Protect, PickButton;
buttons
  cmOK,;
  cmCancel,;
<< 'Кросс-отчет по нарядам (ЕРП-АММ-МЕС)'

   Тип отчета.@@@@@@@@@@@@@@@@@@@@@@@@@@
     Период с.@@@@@@@@@@@ по.@@@@@@@@@@@
      План ВП.@@@@@@@@@@@
Подразделения.@@@@@@@@@@@@@@@@@@@@@@@@@@

   <.Сформировать.>      <.Отмена.>
>>
end;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
Procedure MyLog(_str: string);
{
   If Upcase(UserName) = 'LAPUSHKOV_DV'
    {
      LogStrToFile(_log,_str);
    }
}
Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
   sqlAddStr(query_handle, add_query_str);
   MyLog('sql: ' + add_query_str);
} //Function MysqlAddStr(var query_handle: longInt; add_query_str: string): longInt;

Procedure FilltReport;
{
  delete all tReport;
  delete all tReportSvod;
    var hstr : longint = 0;

    MysqlAddStr(hstr, 'select * from EM_NARYAD_CROSS_BD');

    SetVisualHeader('Выполнение запроса SQL');
  var objQuery: iQuery;
    objQuery := queryManager.createQuery(hstr);
  if objQuery.execute.errorCode != tsOk
   then {
      message('Ошибка выполнения запроса '+ objQuery.errorCode,error);
      }
  else
  {
    SetVisualHeader('Перенос данных во временную таблицу');
    sqlCopyInto(objQuery, tntReport, true);
//    MyLog('за ' + _dOrd + ' найдено ' +recordsintable(tntNewPrices)+ ' спецификаций ордеров');
  }

}

#include EM_Naryad_CrossReport_PrintToExcel.vpp

HandleEvent
cmInit:
{
  GetDateFromTunes(_fDateB,_fDateE);
  if _fDateB = 0 or _fDateE = 0
  then
   {
    SetTunesFromDates(date(01,month(cur_date), year(cur_date)),date(Last_day(cur_date),month(cur_date), year(cur_date)));
    GetDateFromTunes(_fDateB,_fDateE);
   }
}
cmPick:
{
  case curfield of
   #_fPodr:
    {
       if iGetKau.GetCodeKau(cgiMulti,cgKau_KatPodr,Comp(0)) <> cmCancel {
         delete all tfPodr;
         var _tmpName : string= iGetKau.GetMarkerName(cgKau_KatPodr);
         var Marker_Tmp  : longint = InitMarker(_tmpName, 8, 50, 10, True);

         var i: integer = 0;
         for (i:=0; i<GetMarkerCount(Marker_Tmp); i++) {
           var tmpNrec: comp = 0h;
           if (GetMarker(Marker_Tmp, i, tmpNrec))
           if getfirst KatPodr Where ((tmpNrec == KatPOdr.nrec)) = tsOK{
             Insert tfPodr set
               tfPodr.nrec := KatPodr.Nrec
              ,tfPodr.Kod  := KatPodr.Kod
              ;

           }
         }
         DoneMarker(Marker_Tmp,_tmpName);
       }
     _fPodr := 'Выбрано ' + recordsInTable(tntfPodr);
    }
   end;
   rereadrecord;
}
cmOK:
{
  if _fDateE < _fDateB or _fDateE = 0 or _fDateB = 0
   {
     message('Некорректные даты',error);
     Stop; abort; exit;
   }
   if recordsInTable(tntfPodr) = 0
   {
     message('Выберите подразделения',error);
     Stop; abort; exit;
   }
   if _fPlanVP <= 0
   {
     message('План ВП должен быть больше 0',error);
     Stop; abort; exit;
   }
   SetTunesFromDates(_fDateB,_fDateE);
   delete all tfStatus;
   case _fTypeRep of
    0:
    {
     Insert tfStatus set tfStatus.name :='На проверку';
     Insert tfStatus set tfStatus.name :='На согласовании';
		 Insert tfStatus set tfStatus.name :='Оплачен';
		 Insert tfStatus set tfStatus.name :='Оформляемый';
     Insert tfStatus set tfStatus.name :='Проверен БТЗ';
		 Insert tfStatus set tfStatus.name :='Проверено Экономистом';
     Insert tfStatus set tfStatus.name :='Рассчитан';
     Insert tfStatus set tfStatus.name :='Сформирован';
     Insert tfStatus set tfStatus.name :='Утвержден';
    }
    1:
    {
     Insert tfStatus set tfStatus.name := 'Проверен БТЗ';
		 Insert tfStatus set tfStatus.name :='Оплачен';
    }
   end;

   StartNewVisual(vtRotateVisual, vfTimer, 'Сбор данных', 0);
   FilltReport;

    _Loop tReport
      {
        SetvisualHeader('Фильтрация ' + tReport.PodrKod);
//        logstrtofile('Cross_tReport.log',tReport.PodrKod);
        if(getfirst tfPodr where tReport.PodrKod = tfPodr.kod) <> tsOK
         then {
           delete current tReport;
//           logstrtofile('Cross_tReport.log','            Удалено');
         }
      }

    _Loop tReport
      {
        SetvisualHeader('Фильтрация ' + tReport.Status);
//        logstrtofile('Cross_tReport.log',tReport.PodrKod);
        if(getfirst tfStatus where tReport.Status = tfStatus.name) <> tsOK
         then {
           delete current tReport;
//           logstrtofile('Cross_tReport.log','            Удалено');
         }
      }




 var _tmpDateB : date = _fDateB;
 var _planVP_OneDay : double = _fPlanVP/CalcDaysBetweenDates(_fDateB,_fDateE, false);
 var _planVP_curDay : double = 0;
 var _FactVP_curDay : double = 0;
    do
    {
    var _totChas : double = 0;
    _Loop tReport where ((_tmpDateB == tReport.day))
     {
       _totChas := _totChas + tReport.totalChasF
      // CalcDaysBetweenDates(date(19,06,2020),cur_date, false)
     }
     _planVP_curDay := _planVP_curDay + _planVP_OneDay;
     _FactVP_curDay := _FactVP_curDay + _totChas;

      insert tReportSvod set
       tReportSvod.Day    := _tmpDateB
      ,tReportSvod.planVP := _planVP_curDay
      ,tReportSvod.FactVP := _FactVP_curDay
     ;
      _tmpDateB := Add_day(_tmpDateB,1);
    } while _tmpDateB <= _fDateE

   if getfirst tReport = tsOK
    {
      PrintToExcel;
    }
    else
    {
      message('Нет данных для формирования отчета',error);
    }
   StopVisual;
}

end;
end.

#include UserReport.vih

VipInterface UserReport_EM_Naryad_CrossReport Implements IUserReport licensed(free);
Interface UserReport_EM_Naryad_CrossReport;

  create view;

  procedure Run;
  {
    runinterfacenomodal(EM::EM_Naryad_CrossReport);
  }

  function GetReportName: String;
  {
    GetReportName := 'Кросс-отчет по нарядам';
  }

  function GetGroupName (Level : Word) : String;
  {
    if (Level = 1)
      GetGroupName := ''
    else
      GetGroupName := '';
  }

  function GetPriority : Integer;
  {
    GetPriority := 0;
  }

  function VisibleInModule(Ind : Byte) : String;
  {
    VisibleInModule := '';
    case Ind of
      1: result:= 'STAFFMAINMENU';
      2: result:= 'menuzarp';
    end;
  }
end.
