/*
   Фильтры по подразделениям для различных отчетов
*/

function FillMarks: boolean;
{
  var Result: boolean;
  Result := PAF.CheckPersonalAccountFilter(0);
  FillMarks := Result;
  if (not Result)
  {
    SelectField(#FiltrPublic);
    Message('Не задан фильтр по работникам', Error + OkButton);
  }
  ReReadRecord(#ZAR_USER);
}


procedure ProcessCheck;
{
  case Zar_User.GrupStN xor PAF.GetFilterState of   // какой фильтр изменился ?
    1: // по подразделению
      if (Zar_User.GrupStN and 1) > 0
      {
        SelectField(#FiltrPodr);
        putcommand(cmPick);
      }
      else
      {
        PAF.ClearDepartmentFilter;
        ReReadRecord(#ZAR_USER);
      };

    2: // по работникам
      if (Zar_User.GrupStN and 2) > 0
      {
        SelectField(#FiltrPublic);
        putcommand(cmPick);
      }
      else
      {
        PAF.ClearPersonalAccountFilter;
        ReReadRecord(#ZAR_USER);
      }

  end; // case
}

//------------------------------------------------------------------------------
//  Обработка Checkbox - фильтр по работникам и сотрудникам
//------------------------------------------------------------------------------
procedure PodrPubCheck;
{
   case CurField of
     #ZAR_USER.GRUPSTN:
       ProcessCheck;
   end;  //case
}

//------------------------------------------------------------------------------
//  Выбор подразделения и работников
//------------------------------------------------------------------------------
procedure PodrPubPick;
{
 case CurField of
    #FiltrPodr:
    {
      PAF.ChangeDepartmentFilter(true);
      ReReadRecord(#ZAR_USER);
    }
    #FiltrPublic:
    {
      PAF.ChangePersonalAccountFilter(0);
      ReReadRecord(#ZAR_USER);
    }
  end; // case
}

//------------------------------------------------------------------------------
//   Инициализация Zar_User
//------------------------------------------------------------------------------
procedure InitUser(parm : word);
{
  PAF.InitFilter(Parm <> 0, Parm = 0);
  ReReadRecord(#ZAR_USER);
}

//------------------------------------------------------------------------------
// Заполнение Formarks
//------------------------------------------------------------------------------
function FillMarksCho(choiced:word) : boolean;
begin
  var Result: boolean;
  Result := PAF.CheckPersonalAccountFilter(choiced);
  FillMarksCho := Result;
  if (not Result)
  {
    SelectField(#FiltrPublic);
    Message('Не задан фильтр по работникам', Error + OkButton);
  }
  ReReadRecord(#ZAR_USER);
end;
