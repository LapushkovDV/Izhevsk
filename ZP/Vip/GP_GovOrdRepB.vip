  delete all tZakWithNDFL;
   _try
   { // получим список групп заказов, по которым выделяем НДФЛ
    sql
     select grzak.nrec
      from vplan grzak
      join attrnam an on an.wtable = 31015
                       and an.name = 'Выделять НДФЛ с аванса'
      join attrval av on av.cAttrnam = an.nrec
                         and av.crec = grzak.nrec
     where av.vdouble = 1
    into tZakWithNDFL;
    ;
   }
  _except else{}

   if isAvans = 1
    {
      if GetFirst tZakWithNDFL where ((pOrderGrp == tZakWithNDFL.cZak)) <> tsOK
       then isAvans := 0;
    }
    StopVisual('', 0);
  }

  // Обработка одной оплаты
  #ifdef __DEBUG__
  procedure ProcessOpl(Prefix: String; M: Byte; Y: Word; VidOplS: Word; DB: Date; DE: Date; Sum: Double; Days: Double; Hours: Double); 
  #else
  procedure ProcessOpl(VidOplS: Word; Sum: Double); 
  #end
  {
    if getFirst KlVidOpl where ((VidOplS == KlVidOpl.VidOpl)) != tsOk then
    {
      oGP_Log.Error('Оплата с сист. кодом ' + To_Char(VidOplS) + ' не найдена в классификаторе видов оплат');
      exit;
    }
    #ifdef __DEBUG__
    oGP_Log.Info(' ' + To_Char(KlVidOpl.VidOplP) +
     ' Сумма: ' + To_Char(Sum, 0, 2));
    #end
    case KlVidOpl.VidOplP of
      1..3: 
        NachOklad += Sum; // начислено: оклад (4)
      6..7, 11, 15, 51..57, 62, 65, 68, 75, 91, 98:
        NachNadb += Sum; // начислено: надбавки (5)
      21..40:
        NachPremia += Sum; // начислено: премия (6)
      5, 140: NachCommand += Sum; // начислено: командировка (7)
      74,111..113,115..133,134,135:
        NachOtp += Sum; // начислено: отпуск (8)
      83, 84, 95:
        NachPos3Days += Sum; // начислено: пособие за 3 дня (9)
      189:
        InZadOrg += Sum; // вх.задолж.: За организацией (12)
      85,86,87,88,89,289:
        NachVyhPos += Sum; //выходные пособия
      114:
        NachKomOtp += Sum; //компенсанция за неиспользованный отпуск
      else
        NachOther += Sum; // начислено: другие доходы (10)
    end;
  }

  // Обработка одной оплаты
  #ifdef __DEBUG__
  procedure ProcessUd(Prefix: String; M: Byte; Y: Word; VidUdS: Word; DB: Date; DE: Date; Sum: Double); 
  #else
  procedure ProcessUd(VidUdS: Word; Sum: Double); 
  #end
  {
    if getFirst KlVidUd where ((VidUdS == KlVidUd.VidUd)) != tsOk then
    {
      oGP_Log.Error('Удержание с сист. кодом ' + To_Char(VidUdS) + ' не найдена в классификаторе удержанией');
      exit;
    }
    #ifdef __DEBUG__
     oGP_Log.Info(' ' + To_Char(KlVidUd.VidUd) +
     ' Сумма: ' + To_Char(Sum, 0, 2));
    #end
    case KlVidUd.VidUdP of
      213, 262, 221,222,224,239: // сист. 182,183,17
        UderNDFL += Sum; // удержано: НДФЛ (14)
      225, 226:
        UderAvans += Sum; // удержано: аванс (15)
      227, 253:
        UderRazVypl += Sum; // удержано: разовые выплаты (16)
      214:
        UderProfVz += Sum; // удержано: проф. взносы (18)
      211:
        InZadRab += Sum; // вх.задолж.: За работником (13)
      171:
        OutZadOrg += Sum; // исх.задолж.: За организацией (19)
      500:
        PerToBank += Sum; // К выплате (21)
      501:
       UderOther += 0;// Выплата уволенным
      else
        UderOther += Sum; // удержано: оплата гост., оплата путевок, подотчетн. суммы (17)
    end;
  }

  procedure ClearRecData;
  {
    NachOklad := 0;
    NachNadb := 0;
    NachPremia := 0;
    NachCommand := 0;
    NachOtp := 0;
    NachPos3Days := 0;
    NachVyhPos :=0;
    NachKomOtp :=0;
    NachOther := 0;
    InZadOrg := 0;
    InZadRab := 0;
    UderNDFL := 0;
    UderAvans := 0;
    UderRazVypl := 0;
    UderOther := 0;
    UderProfVz := 0;
    PerToBank := 0;
    OutZadOrg := 0;
    OutZadRab := 0;
  }

  procedure CalcRecData;
  {
    #ifdef __DEBUG__
    oGP_Log.Info('');
    oGP_Log.Info('Таб.№ ' + GetStrTabN(SData.TabN, SData.StrTabN) + ' ' + Persons.FIO);
    #end
    ClearRecData;
    if sotrmezh=0
    {
    // Оплаты, начисленные в текущем месяце
    _loop Nachisl where((
          LSchet.NRec == Nachisl.cLSch
      and pYear       == Nachisl.YearN
      and pMonth      == Nachisl.MesN
    ))
    {
      #ifdef __DEBUG__
      ProcessOpl('ТО', Nachisl.Mes, Nachisl.YearK, Nachisl.VidOplS, Nachisl.DataN, Nachisl.DatOk,
       Nachisl.Summa, Nachisl.KolDn, Nachisl.ChasF);
      #else
      ProcessOpl(Nachisl.VidOplS, Nachisl.Summa);
      #end
    }
    }


 _NachByProj2 := 0;
 _NdflByProj2 := 0;
//    if sdata.PartProc = 0
/*    _loop TmpNachisl where((
          LSchet.NRec == TmpNachisl.cLSch
      and pYear       == TmpNachisl.YearN
      and pMonth      == TmpNachisl.MesN
    ))
    {
     _NachByProj2 := _NachByProj2 + TmpNachisl.Summa //ProcessOpl(TmpNachisl.VidOplS, TmpNachisl.Summa);
    }
*/
     _loop tSumReestr where((LSchet.NRec == tSumReestr.CLSCH))
      {
       _NachByProj2 := _NachByProj2 + tSumReestr.SUMOPL;

       if sotrmezh=1
       {
         ProcessOpl(tSumReestr.VidOpl, tSumReestr.SUMOPL) ;
       }


//      logstrtofile('c:\temp\tmplog.log',string(LSchet.NRec) + ' ' + _NachByProj2);
      }
       _loop tSumNdfl where((LSchet.NRec == tSumNdfl.CLSCH))
      {
         _NdflByProj2 := _NdflByProj2 + tSumNdfl.SUMOPL;

          if sotrmezh=1
       {
         ProcessOpl(tSumNdfl.VidOpl, tSumNdfl.SUMOPL) ;
       }

      }


   if sotrmezh=0
    {
    // Оплаты, начисленные в прошлых месяцах
    _loop SumVidOp where((
          LSchet.NRec == SumVidOp.cLSch
      and pYear       == SumVidOp.YearN
      and pMonth      == SumVidOp.MesN
    ))
    {
      #ifdef __DEBUG__
      ProcessOpl('ПО', SumVidOp.Mes, SumVidOp.YearK, SumVidOp.VidOpl, SumVidOp.DataN, SumVidOp.DatOk,
       SumVidOp.Summa, SumVidOp.KolDn, SumVidOp.ChasF);
      #else
      ProcessOpl(SumVidOp.VidOpl, SumVidOp.Summa);
      #end
    }
    }
    // RM #2458, замечание от 09.07.2018 - суммы неначисленные в этой форме не учитываются
    // Суммы неначисленные
    /*
    _loop NeNach where((
          LSchet.NRec == NeNach.cLSch
      and pYear       == NeNach.YearN
      and pMonth      == NeNach.MesN
    ))
    {
      #ifdef __DEBUG__
      ProcessOpl('НО', NeNach.Mes, NeNach.YearK, NeNach.VidOplS, NeNach.DataN, NeNach.DatOk,
       NeNach.Summa, NeNach.KolDn, NeNach.ChasF);
      #else
      ProcessOpl(NeNach.VidOplS, NeNach.Summa);
      #end
    }
    */
    if sotrmezh=0
    {
    // Удержания, удержанные в текущем месяце
    _loop Uder where((
          pYear       == Uder.YearN
      and pMonth      == Uder.MesN
      and LSchet.NRec == Uder.cLSch
    ))
    {
      #ifdef __DEBUG__
      ProcessUd('ТУ', Uder.Mes, Uder.YearK, Uder.VidUdS, Uder.DataN, Uder.DatOk, Uder.SumUd);
      #else
      ProcessUd(Uder.VidUdS, Uder.SumUd);
      #end
    }
    // Удержания, удержанные в прошлых месяцах
    _loop SumVidUd where((
          LSchet.NRec == SumVidUd.cLSch
      and pYear       == SumVidUd.YearN
      and pMonth      == SumVidUd.MesN
    ))
    {
      #ifdef __DEBUG__
      ProcessUd('ПУ', SumVidUd.Mes, SumVidUd.YearK, SumVidUd.VidUd, SumVidUd.DataN, SumVidUd.DatOk, SumVidUd.SumUd);
      #else
      ProcessUd(SumVidUd.VidUd, SumVidUd.SumUd);
      #end
    }

    if isAvans = 1 then UderAvans := lschet.avfakt;
    }
    // начислено: всего (11)
    NachTotal := NachOklad + NachNadb + NachPremia + NachCommand + NachOtp + NachPos3Days + NachVyhPos+ NachKomOtp + NachOther;
    // удержано: всего (-)
    UderTotal := UderNDFL + UderAvans + UderRazVypl + UderOther + UderProfVz;
    // На руки - расчетная сумма
    var ToPayCalc: tSumma = InZadOrg - InZadRab + NachTotal - UderTotal - OutZadOrg;

    if  (sotrdelete=1 and pwDElType=0) or sotrmezh=1
    {
      ToPayCalc:= InZadOrg - InZadRab + NachTotal - UderTotal - OutZadOrg + _NachByProj2;
    }
    // Если удержано больше, чем начислено, образуется задолженность за работником на конец месяца
    if (ToPayCalc < 0)
    {
      // К выплате (21)
      ToPay := 0;
      // исх.задолж.: За работником (20)
      OutZadRab := Abs(ToPay); 
    }
    else
      // К выплате (21)
      ToPay := ToPayCalc;
    // Начислено по проекту, руб. (23)
    if (ToPay > 0)
      NachByProj := Round(ToPay * SData.PartProc * 0.01, 0);
    else
      NachByProj := 0;
    #ifdef __DEBUG__
    oGP_Log.Info(' Вх.задолженность: за организацией: ' + To_Char(InZadOrg, 0, 2) + ' за работником: ' + To_Char(InZadRab, 0, 2));
    oGP_Log.Info(' Итого начислено: ' + To_Char(NachTotal, 0, 2));
    oGP_Log.Info(' Итого удержано: ' + To_Char(UderTotal, 0, 2));
    oGP_Log.Info(' Перечислено з/п банк: ' + To_Char(PerToBank, 0, 2));
    oGP_Log.Info(' На руки (расчетная сумма): ' + To_Char(ToPayCalc, 0, 2));
    oGP_Log.Info(' На руки: ' + To_Char(ToPay, 0, 2));
    oGP_Log.Info(' Исх.задолженность: за организацией: ' + To_Char(OutZadOrg, 0, 2) + ' за работником: ' + To_Char(OutZadRab, 0, 2));
    #end
  }

  //------------------------------------------------------------------------------------------------------------------------------

  var
    // Переменные для работы с Excel
    RecCnt: longint; // Количество строк в отчёте
    FirstCol: longint; // Номер первой колонки отчёта
    LastCol: longint; // Номер последней колонки отчёта
    FirstHeadRow: longint; // Номер первой строки шапки отчёта
    LastHeadRow: longint; // Номер последней строки шапки отчёта
    FirstBodyRow: longint; // Номер первой строки тела отчёта
    LastBodyRow: longint; // Номер последней строки отчёта

  // Исключение для генерации ошибок, связанных с выводом в Excel файл
  exception ExOnExecelError;

  // Генерирует ошибку, связанную с выводом в Excel файл
  procedure ExcelError(ErrCode: word; AddInfo: string);
  {
    var ErrText: string;
    case ErrCode of
      XE_BAD_OP:
        ErrText := 'не удалось выполнить операцию с Excel-файлом';
      XE_CREATE_FILE:
        ErrText := 'не удалось создать файл';
      XE_OPEN_FILE:
        ErrText := 'не удалось открыть файл';
      XE_INIT_FILE:
        ErrText := 'не удалось инициализировать Excel';
      XE_CREATE_MATRIX:
        ErrText := 'не удалось создать матрицу';
      XE_OUT_MATRIX:
        ErrText := 'не удалось вывести матрицу в отчёт';
      XE_WRITE_TO_MATRIX:
        ErrText := 'не удалось записать значение в матрицу';
      XE_WRONG_TEMPLATE:
        ErrText := 'в xlt шаблоне не найден лист с именем';
      XE_FORMAT_CELL:
        ErrText := 'не удалось отформатировать ячейку';
      XE_SET_CELL_VALUE:
        ErrText := 'не удалось записать значение в ячейку';
      XE_RUN_MACRO:
        ErrText := 'не удалось запустить макрос';
      XE_ADD_SHEET:
        ErrText := 'не удалось добавить вкладку';
      XE_DEL_SHEET:
        ErrText := 'не удалось удалить вкладку';
      XE_RENAME_SHEET:
        ErrText := 'не удалось переименовать вкладку';
      XE_FREE_MATRIX:
        ErrText := 'не удалось освободить матрицу';
      XE_SET_CELL_FORMULA:
        ErrText := 'не удалось записать формулу';
    else
      ErrText := '';
    end;
    oGP_Log.Error(ErrText + ' ' + AddInfo);
    _raise ExOnExecelError;
  }

  // Эта Функция делает более удобной проверку результата операции с Excel
  // Первым параметром передаем функцию, которая работает с Excel, а вторым и третьим - информацию об ошибке,
  // которая будет выведена, если эта функция вернёт false (т.е. выполнится с ошибкой)
  procedure xlOp(IsCorrect: Boolean; ErrCode: word; AddInfo: string);
  {
    if (not IsCorrect)
      ExcelError(ErrCode, AddInfo);
  }

  // Создаёт Excel файл и создаёт в нём вкладки для вывода отчёта
  procedure PrepareExcelFile(OutFileName: string);
  {
    if (ExistFile(OutFileName))
      DeleteFile(OutFileName);
    SetVisualHeader('Создание Excel-файла...');
    // Создаем файл Excel
    xlOp(xlCreateExcel(OutFileName, True), XE_CREATE_FILE, OutFileName);
    xlOp(xlIsExcelValid, XE_INIT_FILE, '');
    // Переименуем вкладки
    // Если в отчете меньше вкладок, чем нам нужно добавим недостающие
    var TabCnt: word = 0;
    xlOp(xlGetSheetsCount(TabCnt), XE_ADD_SHEET, '');
    while TabCnt < TAB_CNT do
    {
      xlOp(xlAddSheet, 11, '');
      TabCnt++;
    }
    // Если в больше вкладок, чем нам нужно, удалим лишние
    while TabCnt > TAB_CNT do
    {
      xlOp(xlDeleteSheet(1), XE_DEL_SHEET, '');
      TabCnt--;
    }
    // Переименуем вкладки
    xlOp(xlSetSheetName(1, TAB_TITLE_1), XE_RENAME_SHEET, '');
  }

  procedure OutTitle(var R: longint);
  {
    // Название собственной организации
    xlOp(xlSetCellStringValue(Trim(sGetTune('MYORG')), R, 1, R, 1), XE_SET_CELL_VALUE, '');
    // Название фильтра по подразделению
    // xlOp(xlSetCellStringValue(FiltrPodr, ++R, 1, R, 1), XE_SET_CELL_VALUE, '');
    // Выводим заголовок
    xlOp(xlSetCellStringValue(REP_TITLE + ' по гос.заказу "' + vPlan.Name + '" ('+if(pwType = 0,'накладные','прямые')+') за ' +
     DateToStr(To_Date(1, pMonth, pYear), 'month YYYY') + ' года' + 'от          №', ++R, 1, R, 1), XE_SET_CELL_VALUE, '');
    // сделаем его жирным
    xlOp(xlSetFontStyle(xlBold, R, 1, R + 1, 1), XE_FORMAT_CELL, '');
    // и крупным
    xlOp(xlSetFontSize(12, R, 1, R + 1, 1), XE_FORMAT_CELL, '');
    R++;
  }

  // Вывод шапки отчёта
  procedure OutHeader(var R: longint);
  {
    SetVisualHeader('Форматирование Excel-файла...');
    FirstCol := 1;

    var C: word = FirstCol - 1;
    // ПП (1)
    xlOp(xlSetCellStringValue('ПП', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(6, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlMergeCells(R, C, R + 3, C), XE_FORMAT_CELL, '');
    // Таб.№ (2)
    xlOp(xlSetCellStringValue('Таб.№', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(8, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlMergeCells(R, C, R + 3, C), XE_FORMAT_CELL, '');
    // Ф И О (3)
    xlOp(xlSetCellStringValue('Ф И О', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(20, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlMergeCells(R, C, R + 3, C), XE_FORMAT_CELL, '');

    // Начислено, руб. (4 - 11)
    xlOp(xlSetCellStringValue('Начислено, руб.', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R, C, R, C + 9), XE_FORMAT_CELL, '');
    // За сентябрь 2016 г (по видам оплат) (4 - 10)
    xlOp(xlSetCellStringValue('За ' + DateToStr(To_Date(1, pMonth, pYear), 'month YYYY') + 
     ' г. (по видам оплат)', R + 1, C, R + 1, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 1, C, R + 1, C + 6), XE_FORMAT_CELL, '');
    // оклад (4)
    xlOp(xlSetCellStringValue('оклад', R + 2, C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // надбавки (5)
    xlOp(xlSetCellStringValue('надбавки', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // премия (6)
    xlOp(xlSetCellStringValue('премия', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // командировка (7)
    xlOp(xlSetCellStringValue('команди-ровка', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // отпуск (8)
    xlOp(xlSetCellStringValue('отпуск', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // пособие за 3 дня (б/лист) (9)
    xlOp(xlSetCellStringValue('оплата первых трех дней нетрудоспособности', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // другие доходы (10)
    xlOp(xlSetCellStringValue('оплата сверхуроч. работ,работа в выходные дни и доплата в ночное время', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    //выходные пособия
    xlOp(xlSetCellStringValue('выходные пособия', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
     //выходные пособия
    xlOp(xlSetCellStringValue('компенсация за неиспользованный отпуск', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // всего (11)
    xlOp(xlSetCellStringValue('всего', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 1, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');

    // Сумма, руб. (12 - 13)
    xlOp(xlSetCellStringValue('Сумма задолженности на начало месяца, руб.', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R, C, R + 1, C + 1), XE_FORMAT_CELL, '');
    // За организацией (12)
    xlOp(xlSetCellStringValue('За органи-зацией', R + 2, C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R + 2, C, R + 2, C), XE_FORMAT_CELL, '');
    // За работником (13)
    xlOp(xlSetCellStringValue('За работ-ником', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R + 2, C, R + 2, C), XE_FORMAT_CELL, '');

    // Удержано и зачтено, руб. (14 - 18)
    xlOp(xlSetCellStringValue('Удержано и зачтено, руб.', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R, C, R, C + 4), XE_FORMAT_CELL, '');
    // НДФЛ (14)
    xlOp(xlSetCellStringValue('НДФЛ', R + 1, C, R + 1, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 1, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // аванс (15)
    xlOp(xlSetCellStringValue('аванс', R + 1, ++C, R + 1, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 1, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // разовые выплаты (16)
    xlOp(xlSetCellStringValue('разовые выплаты', R + 1, ++C, R + 1, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 1, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // оплата гост., оплата путевок, подотчетн.суммы (17)
    xlOp(xlSetCellStringValue('оплата гост., оплата путевок, подотчетн. суммы', R + 1, ++C, R + 1, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 1, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // проф.взносы (18)
    xlOp(xlSetCellStringValue('проф. взносы', R + 1, ++C, R + 1, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 1, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');

    // Сумма, руб. (19 - 20)
    xlOp(xlSetCellStringValue('Сумма задолженности на конец месяца, руб.', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R, C, R + 1, C + 1), XE_FORMAT_CELL, '');
    // За организацией (19)
    xlOp(xlSetCellStringValue('За органи-зацией', R + 2, C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    // За работником (20)
    xlOp(xlSetCellStringValue('За работ-ником', R + 2, ++C, R + 2, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');

    // К выплате (21)
    xlOp(xlSetCellStringValue('К выплате', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');

    // % участия (22)
    xlOp(xlSetCellStringValue('% участия', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');

    // Начислено по проекту, руб. (23)
    xlOp(xlSetCellStringValue('Начислено по проекту, руб.', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R, C, R + 3, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');


    LastCol := C;

    var i: byte = 0;
    for(C := FirstCol; C <= LastCol; C++)
    {
      xlOp(xlSetCellNumberValue(++i, LastHeadRow, C, LastHeadRow, C), XE_SET_CELL_VALUE, '');
    }

    // Выравниваем содержимое ячеек шапки по верхнему краю и по центру
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, FirstCol, LastHeadRow, LastCol), XE_FORMAT_CELL, '');
    // Устанавливаем текстовый формат для всех ячеек шапки
    xlOp(xlSetNumberFormat('@', FirstHeadRow, FirstCol, LastHeadRow, LastCol), XE_FORMAT_CELL, '');
    // Делаем шрифт шапки жирным
    xlOp(xlSetFontStyle(xlBold, FirstHeadRow, FirstCol, LastHeadRow - 1, LastCol), XE_FORMAT_CELL, '');;
    // Увеличиваем высоту шапки
    xlOp(xlSetRowHeight(45, LastHeadRow - 1, FirstCol, LastHeadRow - 1, LastCol), XE_FORMAT_CELL, '');

    // Для всех ячеек в форме включаем перенос слов
    xlOp(xlWrapText(FirstHeadRow, FirstCol, LastHeadRow, LastCol), XE_FORMAT_CELL, '');
    // Рисуем границы ячеек для шапки
    xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB + xlInsideV + xlInsideH, xlThin, 0, 0, 
     FirstHeadRow, FirstCol, LastHeadRow, LastCol), XE_FORMAT_CELL, '');

    // Задаем текстовый формат для табельного номера и фамилии
    xlOp(xlSetNumberFormat('@', FirstBodyRow, FirstCol + 1, LastBodyRow + 1, FirstCol + 2), XE_FORMAT_CELL, '');
    // Выровняем таб.№ по центру
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstBodyRow, FirstCol + 1, LastBodyRow + 1, FirstCol + 1), XE_FORMAT_CELL, '');
    // Задаем формат с двумя знаками после запятой для всех полей с суммами (кроме "Начислено по проекту, руб.")
    xlOp(xlSetNumberFormat(SumFormat2D, FirstBodyRow, FirstCol + 3, LastBodyRow + 1, LastCol ), XE_FORMAT_CELL, '');

    R += 5;
  }

  // Преобразовывает номер колонки Excel в буквенный код
  function xlColCode(C: longint): string;
  {
    xlColCode := '';
    do
    {
      xlColCode := Chr(65 + (C - 1) mod 26) + xlColCode;
      C := (C - 1) div 26;
    }
    While (C > 0);
  }

  // Формирует формулу для подсчёта итогов
  function GetTotalFormula(RTop, RBottom, Col: longint): string;
  {
    var ColCode: string = xlColCode(Col);
    // result := '=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;' + ColCode + To_Char(RTop) + ':' + ColCode + To_Char(RBottom);
    result := '=СУММ(' + ColCode + To_Char(RTop) + ':' + ColCode + To_Char(RBottom);
  }

  procedure OutTotals(var R: longint);
  {
    var C: word = FirstCol - 1;
    // Ф И О
    xlOp(xlMergeCells(R, ++C, R, C + 2), XE_FORMAT_CELL, '');
    xlOp(xlSetCellStringValue('ИТОГО', R, C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlAlignCellsEx(xlRight, xlTop, R, C, R, C), XE_FORMAT_CELL, '');
    // Итоги по всем колонкам, начиная с 4-й
    for(C := FirstCol + 3; C <= LastCol; C++)
    {
      // По колонке % участия итог не нужен
      if (C = LastCol - 1)
        continue;
      xlOp(xlSetCellFormula(GetTotalFormula(FirstBodyRow, LastBodyRow, C), R, C, R, C), XE_SET_CELL_FORMULA, '');
    }

    // Рисуем границы ячеек
    xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB + xlInsideV + xlInsideH, xlThin, 0, 0,
     FirstBodyRow, FirstCol, R, LastCol), XE_FORMAT_CELL, '');
    xlOp(xlSetFontStyle(xlBold, R, FirstCol, R, LastCol), XE_FORMAT_CELL, '');
    R++;
  }

  // Вывод тела отчёта
  procedure OutBody(var R: longint);
  {
    SetVisualHeader('Вывод данных в отчет...');

    var NPP: longint = 0;
    RecCnt:=0;
    _loop SData ordered by SData.fio
    {
      if (IsAborted)
        break;
      NextVisual;

      CalcRecData;
      if sotrdelete=1 or sotrmezh=1
      {
        if _NachByProj2=0 then continue;
      }


/*      if UderAvans =  0 then
       {
         RecCnt := RecCnt - 1;
         LastBodyRow := LastBodyRow - 1;
         continue;
       }
*/
      RecCnt++;
      NPP++;

      var C: word = FirstCol - 1;

      // ПП (1)
      xlOp(xlSetCellNumberValue(NPP, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Таб.№ (2)
      xlOp(xlSetCellStringValue(GetStrTabN(SData.TabN, SData.StrTabN), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Ф И О (3)
      xlOp(xlSetCellStringValue(GetSurnameWithInitials(Persons.FIO), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: оклад (4)
      xlOp(xlSetCellNumberValue(NachOklad, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: надбавки (5)
      xlOp(xlSetCellNumberValue(NachNadb, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: премия (6)
      xlOp(xlSetCellNumberValue(NachPremia, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: командировка (7)
      xlOp(xlSetCellNumberValue(NachCommand, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: отпуск (8)
      xlOp(xlSetCellNumberValue(NachOtp, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: пособие за 3 дня (9)
      xlOp(xlSetCellNumberValue(NachPos3Days, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: другие доходы (10)
      xlOp(xlSetCellNumberValue(NachOther, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: выходные пособия
      xlOp(xlSetCellNumberValue(NachVyhPos, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: выходные пособия
      xlOp(xlSetCellNumberValue(NachKomOtp, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // начислено: всего (11)
      xlOp(xlSetCellNumberValue(NachTotal, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // вх.задолж.: За организацией (12)
      xlOp(xlSetCellNumberValue(InZadOrg, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // вх.задолж.: За работником (13)
      xlOp(xlSetCellNumberValue(InZadRab, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // удержано: НДФЛ (14)
      //xlOp(xlSetCellNumberValue(if(isAvans = 1,if(UderAvans <=0,0,1),UderNDFL), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      if (recalcNdfl = 1 or sotrmezh=1) then
      {
        xlOp(xlSetCellNumberValue(_NdflByProj2, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      }
      else
      {
        xlOp(xlSetCellNumberValue(UderNDFL, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      }
      // удержано: аванс (15)
      xlOp(xlSetCellNumberValue(UderAvans, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // удержано: разовые выплаты (16)
      if (sotrdelete=1 and pwDElType=0)
      {
        xlOp(xlSetCellNumberValue(UderRazVypl-_NachByProj2, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      }
      else
      {
        xlOp(xlSetCellNumberValue(UderRazVypl, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      }

      // удержано: оплата гост., оплата путевок, подотчетн. суммы (17)
      xlOp(xlSetCellNumberValue(UderOther, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // удержано: проф. взносы (18)
      xlOp(xlSetCellNumberValue(UderProfVz, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // исх.задолж.: За организацией (19)
      xlOp(xlSetCellNumberValue(OutZadOrg, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // исх.задолж.: За работником (20)
      xlOp(xlSetCellNumberValue(OutZadRab, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      if sotrmezh=1
      {
      // К выплате (21)
      xlOp(xlSetCellNumberValue(_NachByProj2, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // % участия (22)
      xlOp(xlSetCellNumberValue(100, R, ++C, R, C), XE_SET_CELL_VALUE, '');

      }
      else
      {
      // К выплате (21)
      xlOp(xlSetCellNumberValue(if(isAvans = 1 ,0 ,ToPay), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // % участия (22)
      xlOp(xlSetCellNumberValue(if(SData.PartProc <> 0 , SData.PartProc , if(ToPay =  0,0,round(_NachByProj2/ToPay*100,2))) , R, ++C, R, C), XE_SET_CELL_VALUE, '');
      }

      // Начислено по проекту, руб. (23)

      // попробуем всегда с реестров выводить
       xlOp(xlSetCellNumberValue(_NachByProj2, R, ++C, R, C), XE_SET_CELL_VALUE, '');
/*
      if isAvans = 0 {
       xlOp(xlSetCellNumberValue(if(SData.PartProc <> 0 ,NachByProj,_NachByProj2), R, ++C, R, C), XE_SET_CELL_VALUE, '');
       }
       else {
         //xlsetcellformula('=ОКРУГЛ((RC[-8]+RC[-9])*RC[-1]/100;0)-RC[-9]',R, ++C, R, C)
         xlsetcellformula('=ОКРУГЛ((RC[-8])*RC[-1]/100;0)-RC[-9]',R, ++C, R, C) //NТоля Бабич сказал так лучше
       }
*/
      R++;
    }
  }

  procedure OutFooter(var R: longint);
  {
    var D: Date = To_Date(1, pMonth, pYear);
    D := To_Date(Last_Day(D), pMonth, pYear);

    var GlBuxPosition: string = '';
    var GlBuxFIO: string = '';
    var OtvetstvPosition: string = 'Начальник отдела расчетов с персоналом  управления по бухгалтерскому сопровождению АО "НПО Энергомаш"';
    var OtvetstvFIO: string = 'Моисеева Е.И.';

    // Выбираем группу подписантов
    if oGP_Signers.Init(SG_CONST_REP, SG_TAG_REP, false, D) then
    {
      var S: string;
      if oGP_Signers.GetFirst('GlBux') then // Роль = "Гл. бухгалтер"
      {
        S := oGP_Signers.GetPosition(1);
        if (S != '')
          GlBuxPosition := S;
        GlBuxFIO := oGP_Signers.GetFIO(1, 2);
      }
      if oGP_Signers.GetFirst('Otvetstv') then // Роль "Ответственный"
      {
        S := oGP_Signers.GetPosition(1);
        if (S != '')
          OtvetstvPosition := S;
        OtvetstvFIO := oGP_Signers.GetFIO(1, 2);
      }
    }
    // Номер колонки для вывода фамилии зависит от макс. длины наименования должности
    var GlBuxPositionLen: byte = Length(GlBuxPosition);
    var OtvetstvPositionLen: byte = Length(OtvetstvPosition);
    var L: byte = 0;
    if (GlBuxPositionLen > OtvetstvPositionLen)
      L := GlBuxPositionLen;
    else
      L := OtvetstvPositionLen;
    var C: byte = L div 10 + 2;
    if (C < 6)
      C := 6;
    // Главный бухгалтер
    xlOp(xlSetCellStringValue(GlBuxPosition, R + 1, 1, R + 1, 1), XE_SET_CELL_VALUE, '');
    xlOp(xlSetCellStringValue(GlBuxFIO, R + 1, C, R + 1, C), XE_SET_CELL_VALUE, '');
    // Начальник отдела расчетов с персоналом
    xlOp(xlSetCellStringValue(OtvetstvPosition, R + 3, 1, R + 3, 1), XE_SET_CELL_VALUE, '');
    xlOp(xlSetCellStringValue(OtvetstvFIO, R + 3, C, R + 3, C), XE_SET_CELL_VALUE, '');
    R += 4;
  }

  // Формирует отчёт
  procedure CreateReport;
  {
    oGP_Log.Init('#(GPInt).log', true, true, true);
    IsAborted := false;
    PrepareData;
    if (IsAborted)
      exit;

    SumFormat2D := '# ##0' + GetDecimalSeparator + '00';

    RecCnt := RecordsInTable(#SData);
    if (RecCnt = 0)
    {
      Message('Нет данных для формирования отчёта');
      exit;
    }

    var OutFileName: string = GetDefaultUserPath + '#(GPNam) ' + DateToStr(To_Date(1, pMonth, pYear), 'MM.YYYY') + '.xlsx';
    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);
    _try
    {
      PrepareExcelFile(OutFileName);
      var R: longint = 1;
      // Выводим заголовок отчёта
      OutTitle(R);
      FirstHeadRow := R;
      LastHeadRow := FirstHeadRow + 4; // Высота шапки - 5 строк
      FirstBodyRow := LastHeadRow + 1;
      LastBodyRow := FirstBodyRow + RecCnt - 1;
      // Выводим шапку отчёта
      OutHeader(R);
      // Выводим тело отчёта
      OutBody(R);
      LastBodyRow := FirstBodyRow + RecCnt - 1;
      // Выводим итоги
      OutTotals(R);
      // Выводим подвал отчёта
      OutFooter(R);
    end
    _except on ExOnExecelError, ExUserBreak:
    {
      IsAborted := true;
    }
    StopVisual('',0);
    xlKillExcel;
    oGP_Log.Done(true);
  }

  handleEvent
    cmInit:
      {
        iFeeSigners.InitFeeSigners(SG_CONST_REP);
        if (AskParam)
          CreateReport;
        abort;
      }
    cmDelOnProtect:
      case CurField of
        #vPlan.Name:
          set pOrderGrp := 0;
        //#MnPlan.Number:
        //  set pOrder := 0;
        #pSignerGrp:
          set pSignerGrp := '';
      end;
  end;

end.

