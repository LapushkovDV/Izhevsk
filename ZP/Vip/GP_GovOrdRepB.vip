/*************************************************************************************************\
* Наименование: Расчётная ведомость по гос.заказу Ангара                                          *
* Контур/Модуль: Заработная плата                                                                 *
* Пункт меню: Отчеты / Отчеты пользователя / Отчеты по распределению затрат / Расчётная ведомость *
*             по гос.заказу Ангара                                                                *
* Примечание:                                                                                     *
* Отличия этого отчёта от GP_GovOrdRep:                                                           *
* 1. Добавлена колонка "% участия"                                                                *
* 2. Изменени алгоритмом расчёта колонки "Начислено по проекту, руб. (23)".                       *
* 3. В колонку "надбавки" добавлены оплаты с польз.кодами 56, 91, 98; исключена оплата с польз.   *
* кодом 8.                                                                                        *
* 4. В колонку "премия" включаются оплаты с польз.кодами 21..38 (было 21..31).                    *
* 5. В колонку "командировка" добавлена оплата с польз.кодом 140.                                 *
* 4. В колонку "отпуск" включаются оплаты с польз.кодами 111..133 (было 111..113).                *
*                                                                                                 *
* P.S. Предлагал сделать параметр, но клиент настоял на отдельном отчёте.                         *
*                                                                                                 *
* Вид работы  |Номер задачи  |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2458         |24/05/18|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include GP_Log.vih // Объектный интерфейс для вывода протокола
#include FeeSigners.Vih // Функции работы с подписантами
#include GP_Signers.vih // Библиотека для вывода подписей в отчетах
// #include GetKau.Vih

#define GPInt GP_GovOrdRepB // #(GPInt)                  F
#define GPNam Расчётная ведомость по гос.заказу все// #(GPNam)

interface GP_GovOrdRepB '#(GPNam)' EscClose;

  const
    SG_CONST_REP = cgReport_7400; // код группы отчётов для выбора подписантов
    SG_TAG_REP = 'GovOrdRep'; // код группы отчётов для выбора подписантов
    REP_TITLE = 'Расчётная ведомость'; // Заголовок отчёта
    TAB_CNT = 1; // Количество закладок в отчёте
    TAB_TITLE_1 = 'Отчёт'; // Название закладки 1
    // Константы ошибок при работе с Excel
    XE_BAD_OP           =  0; // не удалось выполнить операцию с Excel-файлом
    XE_CREATE_FILE      =  1; // не удалось создать файл
    XE_OPEN_FILE        =  2; // не удалось открыть файл
    XE_INIT_FILE        =  3; // не удалось инициализировать Excel
    XE_CREATE_MATRIX    =  4; // не удалось создать матрицу
    XE_FREE_MATRIX      =  5; // не удалось освободить матрицу
    XE_OUT_MATRIX       =  6; // не удалось вывести матрицу в отчёт
    XE_WRITE_TO_MATRIX  =  7; // не удалось записать значение в матрицу
    XE_FORMAT_CELL      =  8; // не удалось отформатировать ячейку
    XE_SET_CELL_VALUE   =  9; // не удалось записать значение в ячейку
    XE_SET_CELL_FORMULA = 10; // не удалось записать формулу
    XE_RUN_MACRO        = 11; // не удалось запустить макрос
    XE_ADD_SHEET        = 12; // не удалось добавить вкладку
    XE_DEL_SHEET        = 13; // не удалось удалить вкладку
    XE_RENAME_SHEET     = 14; // не удалось переименовать вкладку
    XE_WRONG_TEMPLATE   = 15; // в xlt шаблоне не найден лист с именем
  end;

  // #include GetKau.var
  #include FeeSigners.var
  #include GP_Signers.var

  // Данные для отчета

table struct tZakWithNDFL
(
 cZak : comp
)
with index
(
 ind0 = cZak
)
;
table struct tSumReestr
(
   CLSCH  : comp
  ,SUMOPL : double
  ,vidopl : word
)
with index
(
 ind0 = CLSCH
)
;
table struct tSumNdfl
(
   CLSCH  : comp
  ,SUMOPL : double
  ,vidopl : word
)
with index
(
 ind0 = CLSCH
)
;
  table struct TmpNachisl
(
   CLSCH  : comp
  ,yearN   : word
  ,mesn    : word
  ,tabn    : longint
  ,STRTABN : string
  ,vidoplS : word
  ,Summa    : double
)
with index
 (
   ind0 = CLSCH +  yearN +  mesn
 )
 ;

  table struct SData
  (
    cLSchet: tNRec, // Ссылка на лицевой счет работника
    TabN: tTabN, // Табельный номер
    StrTabN: TabNStr, // Строковое значение табельного номера
    CPERSONS: tNRec, // ссылка на persons
    PartProc: Double, // Процент участия
    fio: string // fio
  )
  with index
  (
    SData01 = Fio,
!   SData01 = TabN + StrTabN,
    SData02 = cLSchet,
    SData03 = StrTabN
  );

  create view
    var
        isAvans
      , recalcNdfl
      , sotrdelete
      , sotrmezh
      , pMonth
      , pwType // Месяц отчётного периода
      , pwDElType: byte; // Для уволенных
        pYear: word; // Год отчётного периода
        pBegDate      // Дата начала отчетного периода
      , pEndDate
      , pSotrDate
      , pSotrDate0
      , pForSotrDate
      , pMezhDate
      , pForMezhDate : date; // Дата окончания отчетного периода + Дата уволенного сотрудника
        pSignerGrp: string; // Группа подписантов
        pOrderGrp: tNRec; // Группа заказа
      // pOrder: tNRec; // Заказ
    from
      Zar_User,
      SData (SData01),
//      GP_RaspAvans,
      Nachisl,
      SumVidOp,
      // NeNach,
      KlVidOpl,
      Uder,
      SumVidUd,
      KlVidUd
      ,TmpNachisl
      ,tSumReestr
      ,tSumNdfl
      ,tZakWithNDFL
    where ((
          UserName       == Zar_User.OwnName
      and pOrderGrp      == VPlan.NRec
      //and pOrder         == MnPlan.NRec
      and SData.cLSchet  == LSchet.NRec
      and LSchet.TPerson == Persons.NRec
    ))
    ;

  var
    IsAborted: boolean;
    SumFormat2D: string;
    // Данные по текущей строке отчета
    NachOklad: tSumma; // начислено: оклад (4)
    NachNadb: tSumma; // начислено: надбавки (5)
    NachPremia: tSumma; // начислено: премия (6)
    NachCommand: tSumma; // начислено: командировка (7)
    NachOtp: tSumma; // начислено: отпуск (8)
    NachPos3Days: tSumma; // начислено: пособие за 3 дня (9)
    NachOther: tSumma; // начислено: другие доходы (10)
    NachVyhPos: tSumma;// насичлено выходные пособия
    NachKomOtp: tSumma;
    NachTotal: tSumma; // начислено: всего (11)
    InZadOrg: tSumma; // вх.задолж.: За организацией (12)
    InZadRab: tSumma; // вх.задолж.: За работником (13)
    UderNDFL: tSumma; // удержано: НДФЛ (14)
    UderAvans: tSumma; // удержано: аванс (15)
    UderRazVypl: tSumma; // удержано: разовые выплаты (16)
    UderOther: tSumma; // удержано: оплата гост., оплата путевок, подотчетн. суммы (17)
    UderProfVz: tSumma; // удержано: проф. взносы (18)
    UderTotal: tSumma; // удержано: всего (-)
    OutZadOrg: tSumma; // исх.задолж.: За организацией (19)
    OutZadRab: tSumma; // исх.задолж.: За работником (20)
    PerToBank: tSumma; // удержано: перечислено з/п в банк (-)
    ToPay: tSumma; // К выплате (21)
    NachByProj, _NachByProj2, _NdflByProj2: tSumma; // Начислено по проекту, руб. (23)

  #include GP_Log.var

  window winParam '#(GPNam)' DoAccept, EscClose, Gray;
    show at (,, 74, 13);

    screen scrParam ('',, sci1EnEsc);
    fields
      pMonth ('Месяц'):
       [LIST
         1 'Январь',
         2 'Февраль',
         3 'Март',
         4 'Апрель',
         5 'Май',
         6 'Июнь',
         7 'Июль',
         8 'Август',
         9 'Сентябрь',
         10 'Октябрь',
         11 'Ноябрь',
         12 'Декабрь'
       ], protect;
      pYear ('Год отчетного периода'): noprotect, SpinButton [1, 1, 9999];
      vPlan.Name ('Группа заказа',, sci13EnEsc): protect;
      //MnPlan.Number ('Код заказа',, sci13EnEsc): protect;

      pwType ('Тип "Накладные"/"Прямые"'):
       [LIST 0 'Накладные',1 'Прямые'], protect;

      pSignerGrp ('Группа подписантов',, sci13EnEsc): protect;
      isAvans  : NoProtect;
      recalcNdfl  : NoProtect;
      sotrdelete : NoProtect;
      pSotrDate  : NoProtect;
      pwDElType  ('Тип "Меж.выплата"/"Выплата увол."'):
       [LIST 0 'Меж.выплата',1 'Выплата увол.'], protect;
      pForSotrDate  : NoProtect;
      pSotrDate0 : NoProtect;
      sotrmezh   : NoProtect;
      pMezhDate : NoProtect;
      pForMezhDate : NoProtect;
    buttons
      cmOk,,, 'Ввод - принять выбор',,sci1Esc;
      cmCancel,,, 'Отмена',,sci1Esc;
    <<
`Отчетный период     `.@@@@@@@@@@@.@@@@@ года
`Госзаказ            `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Тип                 `.@@@@@@@@@@@@@@@@@@@@@@
!`Заказ               `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Группа подписантов  `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

      [:] - к авансу`
      [:] - пересчитать НДФЛ под реестр`
      [:] - уволенные`    `Дата выплаты     `.@@@@@@@@@@   .@@@@@@@@@@
                          `Дата формирования`.@@@@@@@@@@
                          `Дата уволенных   `.@@@@@@@@@@
      [:] - меж. выплаты` `Дата выплаты     `.@@@@@@@@@@
                          `Дата формирования`.@@@@@@@@@@
                        <.  ~O~K  .> <.О~т~мена.>
    >>
    end;

    handleEvent
      cmPick:
        case CurField of
          #vPlan.Name:
          {
             var _cVPlan: tNRec;
             _cVPlan := pOrderGrp;
             if (RunInterFace('GrvPlan', _cVPlan, 0, 17) != cmCancel)
               set pOrderGrp := _cVPlan;
          }
          /*
          #MnPlan.Number:
          {
             var _cMnPlan: tNRec;
             _cMnPlan := pOrder;
             if (iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, _cMnPlan) != 0)
               set pOrder := _cMnPlan;
          }
          */
          #pSignerGrp:
            if (iFeeSigners.RunMainWindow(1))
              set pSignerGrp := iFeeSigners.GetFeeSignersName;
        end;
      cmOk:
        PutCommand(cmDefault);
    end;
  end;

  function InitParam: boolean;
  {
    isAvans := 0;
    InitParam := False;
    var pYearRas: integer = 0;
    var pMonthRas: integer = 0;
    if (not GetUserDate(pYearRas, pMonthRas, 0, ZeroDate, ZeroDate))
      exit;
    if (not ReadMyDsk(pMonth, '#(GPInt)_pMonth', false))
      pMonth := pMonthRas;
    if (not ReadMyDsk(pYear, '#(GPInt)_pYear', false))
      pYear := pYearRas;
    if (not ReadMyDsk(pOrderGrp, '#(GPInt)_pOrderGrp', false))
     pOrderGrp := 0;
    // if (not ReadMyDsk(pOrder, '#(GPInt)_pOrder', false))
    //   pOrder := 0;

    if (not ReadMyDsk(pSignerGrp, 'FeeSigners_' + To_Char(SG_CONST_REP) + '_' + SG_TAG_REP, true))
      pSignerGrp := '';
    InitParam := True;
  }

  procedure SaveParam;
  {
    SaveMyDsk(pMonth, '#(GPInt)_pMonth');
    SaveMyDsk(pYear, '#(GPInt)_pYear');
    SaveMyDsk(pOrderGrp, '#(GPInt)_pOrderGrp');
    // SaveMyDsk(pOrder, '#(GPInt)_pOrder');
    SaveMyDsk(pSignerGrp, 'FeeSigners_' + To_Char(SG_CONST_REP) + '_' + SG_TAG_REP);
  }

  function AskParam: boolean;
  {
    AskParam := False;
    if (not InitParam)
      exit;
    if (RunWindowModal(winParam) = cmDefault)
    {
      AskParam := True;
      SaveParam;
    }
  }

  /*
  function LSInfo: string;
  {
    result := '(Таб.№ ' + GetStrTabn(Lschet.TabN, Lschet.StrTabn) + ' ' + Persons.FIO + ')';
  }
  */

  procedure PrepareData;
  {
    IsAborted := false;

    pBegDate := To_Date(16, pMonth, pYear);
    pEndDate := To_Date(Last_Day(pBegDate), pMonth, pYear);

    if isAvans = 1 then
     {
       pEndDate := to_date(15,month(pEndDate),year(pEndDate));
     }

    oGP_Log.SetVerboseMode(true);

    #ifdef __DEBUG__
    oGP_Log.Info('#(GPNam) за ' + DateToStr(To_Date(1, pMonth, pYear), 'month YYYY') + ' года');
    #end

    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Построение списка работников...', 1);
    delete all sData;


    _try
     {
       if sotrdelete=0 and sotrmezh=0
       {
          sql
            select
             distinct
               GP_RaspAvans.cLSchet
              ,GP_RaspAvans.TabN
              ,GP_RaspAvans.StrTabN
              ,GP_RaspAvans.CPERSONS
              ,GP_RaspAvans.Procent
              ,persons.fio
            from GP_RaspAvans

            left join persons on GP_RaspAvans.CPERSONS = persons.nrec
                 //GP_RaspAvans.IsArh  =0
            where  GP_RaspAvans.CVPLAN =  :(pOrderGrp)
            and  GP_RaspAvans.Datan <=  :(pBegDate)
            and (GP_RaspAvans.DataOk = 0 or GP_RaspAvans.DataOk = :(pEndDate))
//            and GP_RaspAvans.WTYPE  in(0, case when 1 = :(isAvans) then 1 else 0 end)
            and GP_RaspAvans.WTYPE  =:(pwType)
            and GP_RaspAvans.ISARH = 0
            and GP_RaspAvans.Procent <> 0

          union all

             select distinct
                         ls.nrec
                        ,nZak.tabn
                        ,nZak.STRTABN
                        ,pers.nrec
                        ,0
                        ,pers.fio
              from nachislzakaz nZak
                join lschet ls on nZak.CLSCH=ls.nrec
                join persons pers on pers.nrec=ls.tperson
                join mnplan zakaz on zakaz.nrec = nZak.CKAUD[1]
                left join  vPlan on vplan.nrec = zakaz.CVPLAN
                inner join attrnam an on 31015= an.wtable and 'Банковские счета' = an.name
                left join attrval av on  31015= av.wtable and an.nrec = av.cattrnam and vplan.nrec = av.crec

               where
                 nZak.yearN = :(pYear)
             and nZak.mesn = :(pMonth)
             and zakaz.CVPLAN = :(pOrderGrp)
             /*and coalesce(av.vcomp,#comp(0)) = case :(pwType)
                                                 when 0 then 0
                                                 when 1 then coalesce(av.vcomp,#comp(99999999999))   // определяем прямые заказы.
                                                end       */
             and nZak.CLSCH not in
             (
                  select
                   distinct
                     GP_RaspAvans.cLSchet
                  from GP_RaspAvans
                  where
                           GP_RaspAvans.CVPLAN =  :(pOrderGrp)
                      and  GP_RaspAvans.Datan <=  :(pBegDate)
                      and (GP_RaspAvans.DataOk = 0 or GP_RaspAvans.DataOk = :(pEndDate))
                      and GP_RaspAvans.WTYPE  =:(pwType)
                      and GP_RaspAvans.ISARH = 0
                      and GP_RaspAvans.Procent <> 0
             )


           into SData
            ;
       }
       if sotrdelete=1
       {
         pBegDate := To_Date(1, pMonth+1, pYear);
             sql
             select distinct
                         ls.nrec
                        ,ls.tabn
                        ,ls.STRTABN
                        ,pers.nrec
                        ,0
                        ,pers.fio
              from lschet ls
              join persons pers on pers.nrec=ls.tperson
              where ls.datuv<= :(pSotrDate0) and ls.datuv<>0
           into SData
            ;
       }
       if sotrmezh=1
       { pBegDate := To_Date(1, pMonth, pYear);
             sql
             select distinct
                         ls.nrec
                        ,ls.tabn
                        ,ls.STRTABN
                        ,pers.nrec
                        ,0
                        ,pers.fio
              from lschet ls
              join persons pers on pers.nrec=ls.tperson
              where ls.datuv>= :(pBegDate) or ls.datuv=0
           into SData
            ;
       }




     }
     _except else {}


          delete all tmpNachisl;
        delete all tSumReestr;
        delete all tSumNdfl;
     _try
     {
    pBegDate := To_Date(01, pMonth, pYear);
/*
      sql
         select
            nZak.CLSCH
           ,nZak.yearN
           ,nZak.mesn
           ,nZak.tabn
           ,nZak.STRTABN
           ,nZak.vidoplS
           ,nZak.Summa
          from nachislzakaz nZak
           join mnplan zakaz on zakaz.nrec = nZak.CKAUD[1]
           where
                 nZak.yearN = :(pYear)
             and nZak.mesn = :(pMonth)
             and zakaz.CVPLAN = :(pOrderGrp)
         into TmpNachisl  ;
*/
          var _PREFIX : string = '';
          var _VIDUD  : word   = 199; // аванс


        if isavans = 1
         {
           _PREFIX := 'R$A';
           _VIDUD  := 141; // аванс


                sql
          select
             spplban.CLSCH as CLSCH
            ,spplban.SUMOPL as  SUMOPL
            ,spplban.vidopl as  vidopl
          from sbban
          join spplban on spplban.CSBBAN = SBBAN.nrec
//          left join lschet ls on ls.nrec = spplban.CLSCH
//          left join persons pers on pers.nrec = ls.tperson
          join attrnam an on an.wtable = :(coSbBan)
                            and an.name = 'Группа заказов'
          join attrval av on   av.wtable = an.wtable
                             and av.crec = sbban.nrec
                         and av.cattrnam = an.nrec
          join attrnam an_spplban on an_spplban.wtable = :(coSpplBan)
                                 and an_spplban.name   = :(coAttrSpplBan_wtype_Zatraty)
          left join attrval av_spplban on av_spplban.wtable   = an_spplban.wtable
                                      and av_spplban.crec     = spplban.nrec
                                      and av_spplban.cattrnam = an_spplban.nrec
          where sbban.datan = :(pBegDate) // '03.2019'

            and sbban.PREFIX = :(_PREFIX)
            and sbban.VIDUD  = :(_VIDUD)

            and av.vcomp =  :(pOrderGrp)
            and coalesce(av_spplban.vDouble,0) = :(pwType)
             into tSumReestr
          ;

              sql
          select
             spplban.CLSCH as CLSCH
            ,spplban.SUMOPL as  SUMOPL
            ,spplban.vidopl as  vidopl
          from sbban
          join spplban on spplban.CSBBAN = SBBAN.nrec
          join attrnam an on an.wtable = :(coSbBan)
                            and an.name = 'Группа заказов'
          join attrval av on   av.wtable = an.wtable
                             and av.crec = sbban.nrec
                         and av.cattrnam = an.nrec
          join attrnam an_spplban on an_spplban.wtable = :(coSpplBan)
                                 and an_spplban.name   = :(coAttrSpplBan_wtype_Zatraty)
          left join attrval av_spplban on av_spplban.wtable   = an_spplban.wtable
                                      and av_spplban.crec     = spplban.nrec
                                      and av_spplban.cattrnam = an_spplban.nrec
          where sbban.datan = :(pBegDate) // '03.2019'

            and sbban.PREFIX = :(_PREFIX)
            and sbban.VIDUD in (182,183,17,55,56,57) //= :(_VIDUD)

            and av.vcomp =  :(pOrderGrp)
            and coalesce(av_spplban.vDouble,0) = :(pwType)
         into tSumNdfl
         ;
         }
         else
         {
           _PREFIX := 'R$Z';


           if sotrdelete = 1
           { ////  УВОЛЕННЫЕ
             //_VIDUD  := 208;
             If pwDElType =0
             {
               _VIDUD  := 208;
             }
             else
             {
               _VIDUD  := 229;
             }
                sql
          select
             spplban.CLSCH as CLSCH
            ,spplban.SUMOPL as  SUMOPL
            ,spplban.vidopl as  vidopl
          from sbban
          join spplban on spplban.CSBBAN = SBBAN.nrec
//          left join lschet ls on ls.nrec = spplban.CLSCH
//          left join persons pers on pers.nrec = ls.tperson
          join attrnam an on an.wtable = :(coSbBan)
                            and an.name = 'Группа заказов'
          join attrval av on   av.wtable = an.wtable
                             and av.crec = sbban.nrec
                         and av.cattrnam = an.nrec
          join attrnam an_spplban on an_spplban.wtable = :(coSpplBan)
                                 and an_spplban.name   = :(coAttrSpplBan_wtype_Zatraty)
          left join attrval av_spplban on av_spplban.wtable   = an_spplban.wtable
                                      and av_spplban.crec     = spplban.nrec
                                      and av_spplban.cattrnam = an_spplban.nrec
          where sbban.datan = :(pBegDate) // '03.2019'

            and sbban.PREFIX in ('R$Z','RV','RB','RO')//:(_PREFIX)
            and sbban.VIDUD  = :(_VIDUD)

            and av.vcomp =  :(pOrderGrp)
             and coalesce(av_spplban.vDouble,0) = :(pwType)
             and sbban.datok=:(pSotrDate)
             and sbban.dform=:(pForSotrDate)
           into tSumReestr
         ;

             sql
          select
             spplban.CLSCH as CLSCH
            ,spplban.SUMOPL as  SUMOPL
            ,spplban.vidopl as  vidopl
          from sbban
          join spplban on spplban.CSBBAN = SBBAN.nrec
          join attrnam an on an.wtable = :(coSbBan)
                            and an.name = 'Группа заказов'
          join attrval av on   av.wtable = an.wtable
                             and av.crec = sbban.nrec
                         and av.cattrnam = an.nrec
          join attrnam an_spplban on an_spplban.wtable = :(coSpplBan)
                                 and an_spplban.name   = :(coAttrSpplBan_wtype_Zatraty)
          left join attrval av_spplban on av_spplban.wtable   = an_spplban.wtable
                                      and av_spplban.crec     = spplban.nrec
                                      and av_spplban.cattrnam = an_spplban.nrec
          where sbban.datan = :(pBegDate) // '03.2019'

            and sbban.PREFIX in ('R$Z','RV','RB','RO')//:(_PREFIX)
            and sbban.VIDUD in (182,183,17,55,56,57) //= :(_VIDUD)

            and av.vcomp =  :(pOrderGrp)
            and coalesce(av_spplban.vDouble,0) = :(pwType)
            and sbban.datok=:(pSotrDate)
            and sbban.dform=:(pForSotrDate)
         into tSumNdfl
         ;
           }
           else if sotrmezh=1
