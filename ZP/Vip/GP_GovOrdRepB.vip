#include UserReport.vih

vipinterface UserReport_GP_GovOrdRepB implements IUserReport;

interface UserReport_GP_GovOrdRepB;

  procedure Run;
  {
    RunInterface('GP_GovOrdRepB');
  }

  function GetReportName: string;
  {
    result := 'Расчётная ведомость по гос.заказу';
  }

  function GetGroupName(Level: word): string;
  {
    result := '';
    case Level of
      1: result := 'Отчеты по распределению затрат';
    end;
  }

  function GetPriority: integer;
  {
    result := 0;
  }

  function VisibleInModule(Ind: byte): string;
  {
    result := '';
    case Ind of
      1: VisibleInModule := 'MENUZARP';
    end;
  }

end.
