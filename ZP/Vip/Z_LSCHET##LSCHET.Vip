/*************************************************************************************************\
* Наименование: Лицевые счета                                                                     *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:Регистрация дополнительных пунктов меню модуля "Заработная плата"                    *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#795          |07/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#2087         |19/03/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#include GP_ZP_RaspZakazPers.Vih

#component "Z_LSCHET"
#doc
 Лицевые счета
<p>#795 Регистрация дополнительных пунктов меню модуля "Заработная плата"
<p>#2087 Добавить фильтр в лицевых счетах по статусу.

#end

//******************************************************************************
Alter Interface LSCHET;
//******************************************************************************
OverLoad
procedure SetupFilter;
end;

ExtendFormats RRR1;

Function MyGetStatus(_pLschet:comp;_tm:time; _wFlt_Status:word):boolean;forward;

Create view
  ZLSchet
var wFilter :word;
    //ISLSCHETCLOSED = if( Hour(LSCHET.LASTTIME) <> byte(1), 'Открыт для расчета', 'Закрыт для расчета')
    wFlt_Status :word;
//#2087
//condition Status  MyGetStatus(CURLSCHET.CLSCHET,LSCHET.LASTTIME,wFlt_Status)
bounds byStatus  CURLSCHET.CLSCHET /== LSCHET.NREC(noindex)
    and (MyGetStatus(CURLSCHET.CLSCHET,LSCHET.LASTTIME,wFlt_Status) )
;
//#2087
Function MyGetStatus(_pLschet:comp;_tm:time; _wFlt_Status:word):boolean;cacheable;
var _wStat:word;
{ Result:=true;
  _wStat:=0;
  _wStat:=Hour(_tm);
  if _wStat<>1 _wStat:=0;
  Result:=_wStat=_wFlt_Status;
};

//------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------
procedure SetupFilter;
{ if BoundActive(tbbyStatus)
    SubBounds(tbbyStatus);
  ClearFuncCache;
  Inherited::SetupFilter ;
  if IsBitCTW(wFilter,1)
  { //PushConditionForLeave(tcStatus, #CURLSCHET);
    AddBounds(tbbyStatus);
    ReReadRecord(#CurLschet);
  }
} //procedure SetupFilter;

//**********************************
// форматы окна
//**********************************
OverLoadFormats FilterScreen;
window AccountsFilterWindow 'Фильтр по дате увольнения' EscClose, gray;
#IFDEF _GP_
  show at (,,47,8);
#ELSE
  show at (,,47,7);
#ENDIF
  screen FilterScreen ;
    fields
      SaveFilter
        ('Фильтр по дате увольнения сотрудника',, sci1Esc): noprotect;

      MinFireDate
        ('Минимальная допустимая дата увольнения; оставьте пустой для просмотра всех работающих на начало расчетного периода',,sci13Esc): noprotect;

      MaxFireDate
        ('Максимальная допустимая дата увольнения; оставьте пустой для просмотра всех уволенных на начало расчетного периода',,sci13Esc): noprotect;
#IFDEF _GP_
      wFilter:NoProtect;
      wFlt_Status:[List 0 'Открыт для расчета',1 'Закрыт для расчета'],Protect;
#ENDIF
    buttons
      cmOk, default,,'Применить фильтр', hcNoContext, sci1Esc;
      cmClose,,,'Закрыть окно установки фильтра', hcNoContext, sci1Esc;
  <<

 `Просматривать лицевые счета`
   (.) все`
   (.) работающих и уволенных с...`.@@@@@@@@@@
   (.) уволенных до...`            .@@@@@@@@@@
#IFDEF _GP_
   Дополнительно
   [.] По статусу ` .@@@@@@@@@@@
#ENDIF
     <.Применить.>            <. Отмена  .>
  >>
  end; // screen FilterScreen
  HandleEvent
  cmOk:
  {
    SaveMyDsk(wFilter, 'AccountsFilter: wFilter');
    SaveMyDsk(wFlt_Status, 'AccountsFilter: wFlt_Status');

    case inherited :: handleEvent (cmOk) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
    end;
  }
  end;
end; //window AccountsFilterWindow

//******************************************************************************
browse RRR1 (, hclschet, sci1478Esc);
show at (,,,26);
Table CurLSchet;
Fields
  katpodr.kod 'код.подр' ('код.подр') :[6],Protect,NoDel;
end;
//******************************************************************************

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
  //--------------------------
  cmInit:
  {
    cfsSetProp('c_RRR1_KATPODR.KOD_код.подр',cfpIndex,integer(3));

    if not ReadMyDsk(wFilter, 'AccountsFilter: wFilter',false) wFilter:=0;
    if not ReadMyDsk(wFlt_Status, 'AccountsFilter: wFlt_Status',false) wFlt_Status:=0;

    case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
    end;
  }
  //--------------------------
  cmValue59://Распределение по ГосОборонЗаказам ->GP_MenuZarp.vip->GP_Lschet_HotKeys_Rasp
  { RunInterface('GP_ZP_RaspZakazPers', CURLSCHET.CLSCHET, 0, 0, ZeroDate, ZeroDate, 0);

  }

  //--------------------------
  //
  //buttons cmValue7,,, 'Ввод исходных данных для распределения затрат', hcZarLCcost_sharing, scbut;
  cmValue60://Распределение затрат ->GP_MenuZarp.vip ->GP_Lschet_HotKeys_Rasp
  { RunInterface('CostSharing', CURLSCHET.CLSCHET, 0);

  }
  end;
end.
