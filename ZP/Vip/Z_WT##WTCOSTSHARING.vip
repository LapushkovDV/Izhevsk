//'Z_WT::ZLSTAB.WORKINGTABLEWINDOW.WTCONTAINEREMBEDDED.Z_WT##WTCONTAINER.PAGE4.Z_WT::WTHANDCORRECTIONMASK.HANDCORRECTIONBROWSE.MASKWORKINGHOURSSTR'
//VII. Доработка табеля учета рабочего времени
#include MacroSch.vpp
#include Contexts.vih  // Контексты
#include Protector.vih

#include Z_WT##WTCOSTSHARING.vih

#component "Z_WT"
//=======================================
Interface WTCOSTSHARING;
Function GetItChas:double;forward;
Function GetItChas_IT:double;forward;
create view
as select
   GetItChas()       (Fieldname=ItChas)
 , GetItChas_IT()    (Fieldname=ItChas_IT)
 , Calc_ChasF_Sum   (if(IsValidAll(tnbrPrvidopl),GetDoubleFromChasF(ACTUALTIMESTR),0),0) (Fieldname=RapsChas   )
 , Calc_ChasF_Sum_IT(if(IsValidAll(tnbrPrvidopl),GetDoubleFromChasF(ACTUALTIMESTR),0),0) (Fieldname=RapsChas_IT)
 , ItChas    - RapsChas    (Fieldname=OstChas)
 , ItChas_IT - RapsChas_IT (Fieldname=OstChas_IT)

Bounds byPeriod = DBeg <<= brPrvidopl.Dataf(noindex)
            and   DEnd>>= brPrvidopl.Dataf(noindex)
// возможно нужно еще фильтр по дате окончания
//            and   DEnd<<=brPrvidopl.Datok(noindex)
 ordered by TableOrder
;




