//------------------------------------------------------------------------------
browse CostSharingBrowse (,, sci1378Esc);
Show at (,2,,);
 table brPrvidopl;
  fields
    {font = {color = if((brPrvidopl.NREC = 0) and not IsModified, ColorSysGray, 0)}};
    SCHETDEB
      'Счет': [10], protect, pickbutton;
    SUBSCHDEB
      'Субсчет': [10], protect, pickbutton;
    NAMKAUD
      'КАУ': [30], protect, pickbutton;
    KATPODR.NAME
      'Подразделение ОЗ' ('Подразделение отнесения затрат'): [20], protect, pickbutton;
    ActualTimeStr
      'Часы' ('Количество отработанных часов',, sci178Esc): [6], noprotect, noautosize, right;
    BasicStr
      'Основной' ('Признак объекта затрат'): [9], protect, noautosize, left, pickbutton;
    HOZOPER.NAME1
      'Хозоперация': [20], protect, pickbutton;
    brPrvidopl.PARAM
      'Параметр': [10], noprotect, pickbutton;
//-----------------
  brPrvidopl.DATAF 'Дата с' : [11],NoProtect; // DATAN - PeriodBegining
  brPrvidopl.Datok 'Дата по' : [11],NoProtect;
  //[Procent] Calc_ChasF_Proc(GetDoubleFromChasF(ACTUALTIMESTR),0)
  Procent '%' :[6,2],Protect, NoAutoSize ;

end; //browse CostSharingBrowse

Function GetItChas:double;
{ Result:=Chasf_Period;
}

Function GetItChas_IT:double;
{ Result:=Chasf_IT;
}

//---------------------------
  function IsEditable: boolean;
  {
    result := IsAvailable and not IsReadOnly;
  }
  procedure OnPositionChanged;
  {
    //SetHelpAndStatusContext(TotalsBrowse, #ActualHoursStr, GetEditableStatusLine, hcUseOwner)
    //UpdateHelpLine;
  }


  #doc
    Перерисовывает своё содержимое.
  #end
  procedure ReDraw;
  { ReScanPanel(#brPrvidopl)

  }
  #doc
    Обновляет и перерисовывает своё содержимое.
  #end
  procedure ReRead;
  { UpdateTable;
    ReReadRecord(#brPrvidopl)

  }
  #doc
    Сохраняет внесенные изменения.
  #end
  function UpdateIfModified: boolean;
  { UpdateTable;
    Result:=true;
  }


  //------------------------------------------------------------------------------
  public procedure LinkTo(WorkingTable: comp;_SelectedRange:longint; _Change:comp;_Dbeg:date;_DEnd:date );
  { //bDayOfMonth:=DayOfMonth;
    DEnd:=_DEnd;
    DBeg:=_DBeg;
    SelectedRange:=_SelectedRange;
    set pChange := _Change;
    if _SelectedRange=-1
    { if BoundActive(tbbyPeriod)
       SubBounds(tbbyPeriod);
      boPeriod:=false;
    }
    else
    { if not BoundActive(tbbyPeriod)
       AddBounds(tbbyPeriod);
      boPeriod:=True;
    }
    //------------------------------
    //Chasf_Period:=Chasf_Period+Calc_Absence;
    //Chasf_Period:= WT_GetHoursEx(hkWorking, stActual, 0);
    //Chasf_Period:= WT_GetHoursEx(hkPaid, stActual, 0);
    //#767.#19
    //Chasf_IT    := WT_GetHoursEx(hkPaid, stActual,cfDisregardFilters);
    //Chasf_IT     :=WT_GetHoursEx(hkWorking, stActual, cfDisregardFilters)+Calc_Absence;
    //2018.09.19 Отпуска стали добавляться  с cfDisregardFilters
    Chasf_IT     :=WT_GetHoursEx(hkWorking, stActual, 0)+Calc_Absence;
    //WT_GetHoursEx(1, 1, 0) +
    // WT_GetHours(hkOverwork,1)+WT_GetHours(hkOverworkRest,1)
    // WT_GetHours(6,1)+WT_GetHours(7,1)
    Chasf_period :=Chasf_IT;
    //-------------------
    pWorkingTable := WorkingTable;
    UpdateTable;
    if Getfirst Lstab=tsok
    { set PersonalAccount:=LsTab.cLschet;
      set PeriodBeginning:=AD_FirstDate(Date(1,LsTab.Mesn,LsTab.YearN));
    }
    else
    { set PersonalAccount:=0;
    }
    SetEditMode(PersonalAccount<>0);

    ReReadRecord(#brPrvidopl);
    UpdateTitle;


  }
//------------------------------------------------------------------------------
// реализации методов IProtectable
//------------------------------------------------------------------------------
  public procedure SetProtected(Value: boolean);
  {
    IsReadOnly := Value;

    OnPositionChanged;
  }

  public function GetProtected: boolean;
  {
    result := IsReadOnly or (not IsAvailable);
  }

//----- cmInit
Procedure LoadInterFace;
{     TimeSep := ':';
      boModeLsTab:=true;
      if coGetTune('UP.TekBud') <> 1 then   //расчетный период - текущий
      { if boGetTune('UP.ZAR.NO_RASCH_ZP')//Запрещен расчет ЗП
        { //message('Распределение затрат запрещено текущими настройками.');
          //abort;
          //exit;
        }
      }
      if (not GetUserTuneParam(myPlansNo))
      { //abort;
        //exit;
      }
      var CL: ContextList;
      if not CL.Add(CS, 'IntInit')
      { //abort;
        exit;
      }
      if not CL.Add(CS, 'WorkingTable')
      { //abort;
        exit;
      }
      PeriodBeginning:=AD_FirstDate(dGetTune('UP.DATOTCH'));
      var Changed: boolean;
      ReadMyDsk(EnhancedTimeFormat, riWorkingTableEnhancedTimeFormat, Changed);
      PushBounds(tbByPersonalAccount);

      LoadVipRef(DataProtector, 'Protector');
      DataProtector.LinkTo(cfsGetCurrentContainerSelf, '');
      DataProtector.SetProtectedStatusCtx(sci1478Esc);

      //SetEditMode(PersonalAccount = 0);
}//Procedure LoadInterFace;


//******************************************************************************
//TableEvent table Prvidopl ->Z_ZAR##COSTSHARINF
//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
HandleEvent
cmOnVipLoad:
{ PushBounds(tbByPersonalAccount);
  //уже есть ReadMyDsk(EnhancedTimeFormat, riWorkingTableEnhancedTimeFormat, false);
  LoadInterFace;
  IsEmbedded := true;

}
cmOnVipUnLoad:
{

}
end;
end.
