/*************************************************************************************************\
* Наименование:  Доработка интерфейса Лицевой счет - смежные данные - постоянные доплаты          *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    требуется начинать выбор распределения с номера заказа с последующим             *
*                автоматическим формированием счета бухгалтерского учета.                         *
*                Собирать перед Z_WT##WTCOSTSHARING.vip                                           *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#770          |10/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#1759         |25/01/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#3574         |31/10/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
//'Z_BASEMENT::FIXEDADDITIONALPAYMENTS.FIXEDADDPAYMENTSBLANKFORMWINDOW.DOPLATAPERMANENT_PERSONAL.DOPLATA.SUMMA'
#include GetKau.Vih
#component "Z_BASEMENT"
Alter Interface FIXEDADDITIONALPAYMENTS;
#include GetKau.Var
#include GP_Func_ZP.Var

var wKodAnalitik :word;//код "избранная аналитика"
var pTmp         :comp;
Create View vSpr
var
 pBuhSchet:comp;
 pMnPlan  :comp;
From BuhSchet,MnPlan
where ((
    pBuhSchet == BuhSchet.Nrec
and pMnPlan   == MnPlan.Nrec
));


//------------------------------------
// Найти бухсчет по заказу
//------------------------------------
Function GetBuhschetByMnPlan:comp;
{  Result:=0;
   if vSpr.MNPLAN.WKODGR1=5063
   { Result :=vspr.MNPLAN.CANVAL1;
   }
   else
   if vSpr.MNPLAN.WKODGR2=5063
   { Result :=vSpr.MNPLAN.CANVAL2;
   }
} //Function GetBuhschetByMnPlan:comp;

//------------------------------------
// получить номер заказа
//------------------------------------
Function GetMnPlan:string;
var ii:word;
{ Result:='';
  For(ii:=1;ii<=6;ii++)
  {
      if Doplata.tbld[ii]=cgKau_Zakaz
      { vSpr.pMnPlan:=Doplata.cKaud[ii];
        if vSpr.getfirst MnPlan=tsok
          Result:=vSpr.MnPlan.Number;
        break;
      }
  }
} //Function GetMnPlan:string;

//------------------------------------
// Установить параметры по плану
//------------------------------------
Function SetFieldsByMnPlan(_pMnPlan:comp):boolean;
{ Result:=false;
  #FUNC_ZP_Fill_To_SchKauParam(Doplata,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.SetFieldsByMnPlan(_pMnPlan,PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(Doplata,cSchetD,cSubSchD,cKaud,Tbld)
    Result:=true;
    SetModified(true);
    UpdateTable;
  }
}//Function SetFieldsByMnPlan(_pMnPlan:comp);

//-------------------------------
//проверим субсчет по заказу, если не совпадает поменяем
Procedure Check_Analitic_MnPlan;
{ #FUNC_ZP_Fill_To_SchKauParam(Doplata,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.Check_Analitic_MnPlan(PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(Doplata,cSchetD,cSubSchD,cKaud,Tbld)
    SetModified(true);
    UpdateTable;
  }
} //Procedure Check_Analitic_MnPlan;


//'Z_BASEMENT::FIXEDADDITIONALPAYMENTS.DOPLATABROWSE.KLVIDOPL.NVIDOPL'
extendformats DOPLATABROWSE;
extendformats PersonalPayments;
//------------------------------------------------------------------------------
browse DoplataBrowse 'Доплаты' (, hcDoplata, sci1478EscInsC8);
  show at (,3,,19);
  table DOPLATA;
fields
  KatPodr.Kod  'Подр.' ('Код подразделения') :[6],Protect,NoDel, noautosize;
  [Zakaz] GetMnPlan()  'Заказ' :[8],Protect,NoDel, noautosize;
  NAMEORDER 'Приказ УП' ('') :[15],Protect,NoDel, noautosize;
  ' '  '' :[20], Protect , noautosize;
end; //browse DoplataBrowse

//------------------------------------------------------------------------------
browse PersonalPayments 'Доплаты' (, hcDoplata, sci1478EscIns);
  show at (,3,,19);
  table DOPLATA;
fields
  KatPodr.Kod  'Подр.' ('Код подразделения') :[6],Protect,NoDel, noautosize;
  Zakaz   'Заказ' :[8],Protect,NoDel, noautosize;
  NAMEORDER 'Приказ УП' ('') :[15],Protect,NoDel, noautosize;
  ' '  '' :[20], Protect , noautosize;
end; //PersonalPayments

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
  //------------------------
  cmInit:
  { //"Настройки Галактики \ Управление персоналом \ Расчеты с персоналом \ Избранная аналитика"
    wKodAnalitik:=wGetTune('UP.ZAR.FAVORITEANALYTICS');
    //----------------------
    if  inherited :: handleEvent (cmInit)=heAbort then Abort;
    //----------------------

  }
  //------------------------
  cmPick:
  {
      var need_Pick:boolean=true;
      case curField of
      #Schetdeb, #SubSchdeb, #NamKaud:
      { if curField=#NamKaud
        { if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed'
        }
        if Schetdeb='' or (QuickChoiceName<>'' and curField=#NamKaud )
        { pTmp:=0;
          if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
          { if  SetFieldsByMnPlan(pTmp)
            { case curField of
              #Schetdeb, #SubSchdeb: need_Pick:=false;
              end;
            }
          }
          else
          { message('Задайте счет');
            SelectField(#Schetdeb);
          }


        } //if Schetdeb=''

      } //#Schetdeb, #SubSchdeb, #NamKaud
      end; //case curField of
      //----------------------
      if need_Pick
      { if  inherited :: handleEvent (cmPick)=heAbort then Abort;
        if curField=#NamKaud //and QuickChoiceName=''
        { Check_Analitic_MnPlan;
        }
      }
      //----------------------
  }

  end;

end.
