// (Issue #824) Сводка о потерях рабочего времени в разрезе категорий работающих 
// (Issue #824) Макет расчета с выводом результата в текстовый файл
// (Issue #824) Вывод в Excel
// (Issue #824) 26/02/2018 Код. Причина: справочник <Вид Производства> в таблице DEPFUNC.
// (Issue #824) 28/03/2018 Добавил запуск из "Отчеты пользователя" Код. Причина: справочник <Вид Производства> в таблице DEPFUNC.
#include Marker.vih

interface GP_MissTime  'Сводка о потерях рабочего времени в разрезе категорий работающих' Cyan;
show(10,5,180,30);


const
  KatCount = 8;   // Количество категорий от 1 до 7   +1: 8 Ветераны

  cUse          =        1b ;  // Есть коды, которые к неявкам не относятся у них этот флаг 0
  cTip          =       10b ;  // Признак целого дня 0 - целодневная, 1 - не целодневная считать часы за каждый день
  c1Otchet      =      100b ;  // коды под параметр 2.    Вид неявки  <Вид неявки>
  c2WorkNeed    =     1000b ;  // коды под параметр 3.    Неявки служебные
  c3Vacation    =    10000b ;  // коды под параметр 4.    Неявки по отпускам
  c4Sick        =   100000b ;  // коды под параметр 5.    Неявки по нетрудоспособности
  c5AdmVacation =  1000000b ;  // коды под параметр 6.    Неявки по административным отпускам
  c6Other       = 10000000b ;  // коды под параметр 7.    Прочие неявки

  cFontBold = cUse + c1Otchet;

end;

//среднесписочная численность по текущему цеху
table struct mtStat // выбрка для средней численности
(
  wKateg:  word
, fSumS:    double
)
with index
(
  mtStat001 = wKateg
);

// Временная для фильтров "Подразделение"
table struct tSelPodr
(
  nRec: comp,
  KOD:  string[20],
  NAME: string,
  Mark: boolean,
  ItogLine: longint, // Первая строка вывода итога.

  WorkingDays : array[1..KatCount] of double // Всего по табелю - общее количество дней, отработанных по табелю данного подразделения
)
with index (p01=NAME (desc ), pRpt = Mark + KOD, p3 = nRec);

/*
// Промежуточные Итоги по подразделению
table struct tRptRes
(
   cRec: comp,       // ссылка на подразделение
   KOD:  string[20], // Код подразделения
   NAME: string      // наименование подразделения
  ,dOtchet      : array[1..KatCount] of double //
  ,dWorkNeed    : array[1..KatCount] of double //
  ,dVacation    : array[1..KatCount] of double //
  ,dSick        : array[1..KatCount] of double //
  ,dAdmVacation : array[1..KatCount] of double //
  ,dOther       : array[1..KatCount] of double //
)
with index (p01=cRec);
*/

// Настройка по неявкам
table struct tNastr
(
  nRec   : comp,  // по порядку внутри
  cParent: comp,
  npp    : longint,  // сортировка
  NUM: string,
  NAME: string,
  kod:longint // код назначения неявки в отчете побитовая
//  tip: boolean // Признак целого дня false - целодневная, true - не целодневная считать часы за каждый день
)
with index (p01=nRec (Unique,autoinc), p02= cParent + npp);


// Результат расчета по неявкам для подразделения
table struct tRptRes
(
  cPodr  : comp, // nRec подразделения
  cRec   : comp, // nRec неявки
  DD     : array[1..KatCount] of double // Дней по категориям
)
with index (p01=cPodr + cRec);

 type tRec_Itog = record
        dOtchet      : array[1..KatCount] of double; //
        dWorkNeed    : array[1..KatCount] of double; //
        dVacation    : array[1..KatCount] of double; //
        dSick        : array[1..KatCount] of double; //
        dAdmVacation : array[1..KatCount] of double; //
        dOther       : array[1..KatCount] of double; //

      WorkingOthers  : array[1..KatCount] of double; // Отработано дней - количество дней явок, все дни по табелю НЕ перечисленные во входном параметре <Вид неявки>
end;

var
  pMarker:IMarker(Marker) new;
  pMarkerPodr:IMarker(Marker) new;
  cList, cItog:comp;

  Filtr_cMNF, LastFiltr_cMNF:longInt ;
  Filtr_KatMNF: string;

  Filtr_cKatPODR:comp;
  Filtr_Katpodr: string;
  Marker_Count :longint;

  cRptDep: comp;

  sDskPrefix: string;
  bPauseBeforOutExcel: boolean;

  Counter, HeadRow: longInt;

create view vM
var
   cRootNode, cNode:comp;
   wFilter,   wFilter_A:word;
   DTB,  DTE  :date;
   dNeedSave: boolean;
//   filtr_KatPodr : String;
as select DepCat.NRec, tSelPodr.nRec

// Вспомогательные настройки
 ,if((DepCat.kod and cUse         ) >0,'V','') (fieldname=fUSE         )  // Есть коды, которые к неявкам не относятся у них этот флаг пустой
 ,if((DepCat.kod and cTip         ) >0,'ч','') (fieldname=fTip         )  // Признак целого дня 0 - целодневная, 1 - не целодневная считать часы за каждый день

// Настройки по ТЗ отчета
 ,if((DepCat.kod and c1Otchet     ) >0,'V','') (fieldname=f1Otchet     )  // коды под параметр 2.       Вид неявки  <Вид неявки>
 ,if((DepCat.kod and c2WorkNeed   ) >0,'V','') (fieldname=f2WorkNeed   )  // коды под параметр 3.       Неявки служебные
 ,if((DepCat.kod and c3Vacation   ) >0,'V','') (fieldname=f3Vacation   )  // коды под параметр 4.       Неявки по отпускам
 ,if((DepCat.kod and c4Sick       ) >0,'V','') (fieldname=f4Sick       )  // коды под параметр 5.       Неявки по нетрудоспособности
 ,if((DepCat.kod and c5AdmVacation) >0,'V','') (fieldname=f5AdmVacation)  // коды под параметр 6.       Неявки по административным отпускам
 ,if((DepCat.kod and c6Other      ) >0,'V','') (fieldname=f6Other      )  // коды под параметр 7.       Прочие неявки
//  ,if((DepCat.tip),'ч','') (fieldname=fTip)         // ч - считать по часам


from
   tNastr DepCat    // пока не знаю как это лучше назвать оставил DepCat (UOKOD,UOCAT,Neyav,)
  ,tNastr DepCat_Sub
  ,tNastr tNastrMark
  ,tNastr

 , tSelPodr
 , tSelPodr RptPodr // (pRpt) Mark + KOD
 , Lschet , Persons
 , tRptRes
 , tRptRes RptRes
 , DEPFUNC KatMNF
 , mtStat
 where
((
          cNode == DepCat.cParent
and DepCat.NRec == DepCat_Sub.cParent


and pMarker.pNRec == tNastrMark.nRec

and   true == RptPodr.Mark   // для вывода с сортировкой по КОДУ Подразделения
          and RptPodr.nRec == Lschet.CEX
                          and LSchet.tPerson == Persons.nrec

          and RptPodr.nRec == RptRes.cPodr
          and  DepCat.nRec == RptRes.cRec

   and Filtr_cMNF == KatMNF.CFUNC

   and root == mtStat.wKateg

))
;



