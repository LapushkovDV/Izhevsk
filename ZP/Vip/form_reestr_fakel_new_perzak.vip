Interface form_reestr_fakel2   escclose;

Show at (,,73,10);

table struct tReestrNDFLSUM
(
   cLsch  : comp
  ,SUMOPL : double
  ,cVplan : comp
)
with index
(
 ind0 = cVplan + cLsch
)
;
table struct PerZakTemp
(
  strtabn     : string[6],
  Vidper      : longint,
  clsch       : comp,
  Sumper      : double,
//  SummGosZak  : double,
  PriznGosZak : string[50],
  KolvoGosZak : integer,
  cschetd     : string[20],
  ckaud1      : comp,
  PriznZatr   : integer,
  cexoz       : comp,
  cex         : string[3],
  Priznak     : string,
  fio         : string,
  cvplan      : comp
)
with index (pz01=PriznZatr+ckaud1, pz02=clsch+Priznak,pz03=Priznak+kolvoGosZak);
;

table struct PerZak
(
strtabn:string,
Strah:double,
DopSpis1:double,
DopSpis2:double,
DopSpis1Spec:double,
DopSpis2Spec:double,
FOMS:double,
FSS:double,
Travm:double,
PriznakFakel:integer,
cvplan:comp,
name:string
)
with index (p01=cvplan)
;

table struct GP_Rasp_SV_GosZakaz
(
   clsch      : comp
 , strtabn    : string
 , yearn      : longint
 , mesn       : integer
 , name       : string[20]
 , vidper     : integer
 , cvplan     : comp
 , sumper     : double
// , SummGosZak : double

)
with index
(
    rsg01 = cvplan + vidper + clsch
  , rsg02 = yearn + mesn
)
;



 
create view jView

var
ParamReport : byte;
Counter : longint;
KodCex:string;
METKA:boolean;
DatNach1,DatNach2:date;
VsegoAvPl,VsegoAvF:double;
i15,i16,i17:double;
NrecAttrUO:comp;
ExcelPath:string;
ExcelPath1:string;

NrecPers:longint;
TypeAccount:integer;
NameBank:string;
NumberAccount:string;
Surname:string;
Name:string;
Otch:string;
Status:string;
PriznF:boolean;
priznReDo:integer;
SummGZ:double;

   pmes : word ;
   pyearn : integer;
   flabel,FiltrPodr : string;
   countPickPodr : longint ;
   stat,isdbf : integer;
   Filepath : string;
   stmt, stmt_str : longint;
   nrecisklpodr1,nrecisklpodr2 : comp;

as select lschet.nrec
from
   lschet
 , PerZak, PerZakTemp, perevodtekzakaz, persons, pick
 , katpodr
 , GP_Rasp_SV_GosZakaz
 , GP_Rasp_SV_GosZakaz GP_Rasp_SV_GosZakazNakl
 , tReestrNDFLSUM
 , gp_raspavans gp_raspavansLoop
 , vPLan
where
((
        pyearn        == perevodtekzakaz.yearn (noindex)
    and pmes          == perevodtekzakaz.mesn  (noindex)


    and perevodtekzakaz.tperson==persons.nrec
    and perevodtekzakaz.cexoz==katpodr.nrec
))
;


 Screen Scrparam 'Форма реестра "Факел" с 01/06/2018';
   table lschet;
    fields

  pmes       : noprotect;
  pyearn     : noprotect;
  FiltrPodr  : protect,pickbutton;
  ParamReport ('Вариант отчета',, sci13EnEsc):
              [List 0 'К расчету'
                  , 1 'К авансу'
                  , 2 'К расчету с учетом аванса'
               ], Protect;


  buttons
    cmOk, default,, '~В~вод ', hcOkHelp, sci1Esc;

<<
     `За` .@@@ `месяц` .@@@@ `года`

     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  ` Фильтр по подразделению`

     Вид отчета .@@@@@@@@@@@@@@@@

     <. Сформировать .>
>>

 end;

Procedure ClearQuery(Var liHandle: Longint);
{
  if (liHandle != 0)
  {
    sqlFreeStr(liHandle);
    liHandle := 0;
  }
}


procedure FormDataRasp;
{
    StartNewVisual(vtNumericVisual,vfTimer,'Заполняем временную таблицу', 1);


    if filtrPodr<>'По всем'
    {

      sqlDropTmpTable('selpodr');
      sqlAddStr(stmt_str, 'TABLE selpodr ( nrecpodr   : Comp ) WITH INDEX (selpodr1 = nrecpodr);');
      sqlCreateTmpTable(stmt_str,ctmDynamicIndex);
      sqlFreeStr(stmt_str);
      stmt_str:=0;

     _loop pick where (( word(11) == pick.wlist))
     {
       ClearQuery(stmt);
       sqlAddStr(stmt, 'INSERT INTO selpodr');
       sqlAddStr(stmt, '(');
       sqlAddStr(stmt, '  nrecpodr');
       sqlAddStr(stmt, ')');
       sqlAddStr(stmt, 'VALUES');
       sqlAddStr(stmt, '(');
       sqlAddStr(stmt, '  #comp(' + pick.crec + ')');
       sqlAddStr(stmt, ')');
       sqlExecDirect(stmt);
     }  

    }

    MtClear(#GP_Rasp_SV_GosZakaz,mfNormal);

    stmt := sqlAllocStmt;
	sqlAddStr(stmt_str, 'select ');
	sqlAddStr(stmt_str, '     t1.clsch as clsch');
	sqlAddStr(stmt_str, '    ,t1.strtabn as strtabn');
	sqlAddStr(stmt_str, '    ,t1.yearn as yearn');
	sqlAddStr(stmt_str, '    ,t1.mesn as mesn');
	sqlAddStr(stmt_str, '    ,t1.vidper as vidper');
	sqlAddStr(stmt_str, '    ,Case When vplan.nrec is not null then vPlan.name else '+''''+'Основные'+''''+' end as name');
	sqlAddStr(stmt_str, '    ,Case When vplan.nrec is not null then t1.cvplan else #comp(0) end as cvplan');
	sqlAddStr(stmt_str, '    ,Sum(t1.sumper) as sumper ');
!	sqlAddStr(stmt_str, '       ');
!	sqlAddStr(stmt_str, '       ');
	sqlAddStr(stmt_str, '    from');
	sqlAddStr(stmt_str, '     (  ');
	sqlAddStr(stmt_str, '      select ');
	sqlAddStr(stmt_str, '        p.clsch ');
	sqlAddStr(stmt_str, '       ,p.strtabn ');
	sqlAddStr(stmt_str, '       ,p.vidper');
	sqlAddStr(stmt_str, '       ,p.sumper' );
	sqlAddStr(stmt_str, '       ,p.ckaud[1] as ckau1 ');
	sqlAddStr(stmt_str, '       ,p.cschetd');
	sqlAddStr(stmt_str, '       ,p.cexoz');
	sqlAddStr(stmt_str, '       ,Substring(Katpodr.kod,1,3) as kodpodr');
	sqlAddStr(stmt_str, '       ,P.KAUEXTR[1] as cvplan');
	sqlAddStr(stmt_str, '       ,Case When p.tbld[1]=7 then Cast(1 as word) else Cast(0 as word) end as PriznZatr');
	sqlAddStr(stmt_str, '       ,p.yearn');
	sqlAddStr(stmt_str, '       ,p.mesn');
	sqlAddStr(stmt_str, '      from perevodtekzakaz p left join persons pers on p.tperson=pers.nrec');
           if filtrpodr<>'По всем'
    		   sqlAddStr(stmt_str, '                   inner join selpodr on p.cexoz=selpodr.nrecpodr');
	sqlAddStr(stmt_str, '                              left join katpodr on p.cexoz=katpodr.nrec');
	sqlAddStr(stmt_str, '       where p.yearn=? and p.mesn=? and p.vidper<>13  and p.cexoz<>? and p.cexoz<>?');
	sqlAddStr(stmt_str, '      )t1 left join vplan on t1.cvplan=vplan.nrec');
	sqlAddStr(stmt_str, '          left join attrnam an on an.wtable = 31015');
	sqlAddStr(stmt_str, '                             and an.name = ''Выделять НДФЛ с аванса'' ');
	sqlAddStr(stmt_str, '          left join attrval av on av.cAttrnam = an.nrec ');
	sqlAddStr(stmt_str, '                               and av.crec = vPlan.nrec ');
  if ParamReport <> 0 then {
    	sqlAddStr(stmt_str, '             where av.vdouble = 1 '); // только крашеные заказы так определяем
   }
	sqlAddStr(stmt_str, '       group by t1.clsch  ');
	sqlAddStr(stmt_str, '               ,t1.strtabn');
	sqlAddStr(stmt_str, '               ,t1.yearn');
	sqlAddStr(stmt_str, '               ,t1.mesn');
	sqlAddStr(stmt_str, '               ,t1.vidper');
	sqlAddStr(stmt_str, '               ,Case When vplan.nrec is not null then vPlan.name else '+''''+'Основные'+''''+' end');
	sqlAddStr(stmt_str, '               ,Case When vplan.nrec is not null then t1.cvplan else #comp(0) end');

           sqlPrepare(stmt,stmt_str);
       	   sqlbindparam(stmt,1,pyearn);
       	   sqlbindparam(stmt,2,pmes);
       	   sqlbindparam(stmt,3,nrecisklpodr1);
       	   sqlbindparam(stmt,4,nrecisklpodr2);

   		   sqlExecute(stmt);

 		   if (sqlFetchIntoByname(stmt,#GP_Rasp_SV_GosZakaz) != tsOk)
			        Message('not tsOk select (');
			sqlFreeStmt(stmt);
            sqlFreeStr(stmt);

     delete all tReestrNDFLSUM;
  _try
   {
    var _datetmpEnd : date = date(last_Day(date(01,pmes, pyearn)),pmes, pyearn);
    var _datetmpBeg : date = date(01,pmes, pyearn);
     sql
      select
         SppLban.cLsch as cLsch
        ,sum(spplban.SUMOPL) as  SUMOPL
      //  ,sum(spplban.SUMUD) as  SUMUD
        ,av.vcomp as cVplan
      //  ,SBBAN.PREFIX
       from sbban
       join spplBan on spplBan.cSbban = sbban.nrec
       join attrnam an on an.wtable = 16060
                  and an.name = 'Группа заказов'
       join attrval av on av.cattrnam = an.nrec
        and av.crec = sbban.nrec
      where    sbban.vidud = 182
          and sbban.datan between :(_datetmpBeg) and :(_datetmpEnd)//#date(01,04,2019) and #date(30,04,2019)
      //    and av.vcomp = #comp(000A000000000001h)
          and SBBAN.PREFIX = 'R$A'
      group by
         SppLban.cLsch
        ,av.vcomp
        ,SBBAN.PREFIX
     into tReestrNDFLSUM
     ;
   }
   _except else {};

  StopVisual('',0);


 // Пока старый метод базовой выборки данных сохраним (чтобы было оперативно с чем сравнить какое время если что не так...). Код Выше - Аналогичное заполнение временной таблицы через dsql
