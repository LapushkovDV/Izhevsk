*/
}
function getSumAvansNDFLbycVplancLsch : double;
{
  var _result : double = 0;
  if getfirst tReestrNDFLSUM where ((GP_Rasp_SV_GosZakaz.cvplan == tReestrNDFLSUM.cVplan
                 and GP_Rasp_SV_GosZakaz.clsch == tReestrNDFLSUM.cLsch )) = tsOK
  {
   _result := tReestrNDFLSUM.SUMOPL
  }
 result := _result;
}
function getsumwithavans : double;
{
  var _result : double = 0;
     case ParamReport of
      1 :{ _result := getSumAvansNDFLbycVplancLsch}
      2 :{ _result := GP_Rasp_SV_GosZakaz.sumper - getSumAvansNDFLbycVplancLsch}
     else{ _result := GP_Rasp_SV_GosZakaz.sumper}
     end;
 result := _result;
}
function getvPLanName(_cVplan : comp) : string; cacheable;
{
   result := '';
 if Getfirst vPLan where ((_cVplan == vPLan.nrec )) = tsOK
  {
   Result := vPLan.name;
  }
}
procedure FormReestrPredMes;
{

// распределдяем по процетам накладных все , что по perevodtekzakaz на пустых гозах сидиит
// будем использовать процент распределдения по ЗП - согласовано с Лыковой 20210507
    StartNewVisual(vtNumericVisual,vfTimer,'Формирование данных', 1);
    setvisualheader('Отнесение ОСНОВНЫХ по ГОЗ на основе распределения ЗП по ГОЗ');
  var _dBeg : date = to_date(16, pmes, pyearn);
  var _dEnd : date = to_date(last_day(_dBeg), pmes, pyearn);
	_loop GP_Rasp_SV_GosZakaz where ((0 == GP_Rasp_SV_GosZakaz.cvplan))
  {
    	nextvisual;
      pushpos(tnGP_Rasp_SV_GosZakaz);
    _loop gp_raspavansLoop where ((GP_Rasp_SV_GosZakaz.clsch == gp_raspavansLoop.clschet
                                                   and    0 <<= gp_raspavansLoop.isarh (noindex)// нужны и архивные и не архивные
                                                   and _dBeg == gp_raspavansLoop.datan (noindex) // ровно с 16 процент по ЗП идет
                                                   and _dEnd == gp_raspavansLoop.dataok (noIndex) // ровно по конец месяца по ЗП идет
                                                       and 0 == gp_raspavansLoop.wtype (noIndex) // только накладные берем
                                  ))
    {
      if gp_raspavansLoop.cvplan = 0h or gp_raspavansLoop.procent = 0 then continue;

      if getfirst GP_Rasp_SV_GosZakazNakl where ((gp_raspavansLoop.cvplan    == GP_Rasp_SV_GosZakazNakl.cVplan
                                              and GP_Rasp_SV_GosZakaz.vidper == GP_Rasp_SV_GosZakazNakl.vidper
                                              and GP_Rasp_SV_GosZakaz.clsch  == GP_Rasp_SV_GosZakazNakl.clsch
                                                 )) <> tsOK
       {
          GP_Rasp_SV_GosZakazNakl.buffer := GP_Rasp_SV_GosZakaz.buffer;
          GP_Rasp_SV_GosZakazNakl.sumper := 0;
          GP_Rasp_SV_GosZakazNakl.name   := getvPLanName(gp_raspavansLoop.cvplan);
          GP_Rasp_SV_GosZakazNakl.cvplan := gp_raspavansLoop.cvplan;
          Insert current GP_Rasp_SV_GosZakazNakl;
       }
       var _sum : double = round(GP_Rasp_SV_GosZakaz.sumper*gp_raspavansLoop.procent/100.0,2);
       if _sum > GP_Rasp_SV_GosZakaz.SumPer then _sum := GP_Rasp_SV_GosZakaz.SumPer;

        GP_Rasp_SV_GosZakazNakl.SumPer := GP_Rasp_SV_GosZakazNakl.SumPer + _sum;
        GP_Rasp_SV_GosZakaz.SumPer := GP_Rasp_SV_GosZakaz.SumPer         - _sum;
//        if GP_Rasp_SV_GosZakaz.SumPer <0 then GP_Rasp_SV_GosZakaz.SumPer := 0 ;
       update current GP_Rasp_SV_GosZakazNakl;
       update current GP_Rasp_SV_GosZakaz;
    }
      poppos(tnGP_Rasp_SV_GosZakaz);
  }


    setvisualheader('Формирование данных');
	_loop GP_Rasp_SV_GosZakaz// where ((0==GP_Rasp_SV_GosZakaz.cvplan))
	{
	nextvisual;
		if getfirst perzak where ((GP_Rasp_SV_GosZakaz.cvplan==perzak.cvplan))<>tsok
		{
  		clearbuffer(#PerZak);
  		Perzak.cvplan:=GP_Rasp_SV_GosZakaz.cvplan;
  		PerZak.name:=GP_Rasp_SV_GosZakaz.name;
  		insert current PerZak;
		}

      case GP_Rasp_SV_GosZakaz.vidper of
			2: {
    			perzak.FSS:=perzak.FSS + getsumwithavans;
         }
      3: {
	     		perzak.FOMS:=perzak.FOMS + getsumwithavans;
  		 	 }
			5: {
          perzak.strah:=perzak.Strah + getsumwithavans;
         }
      8: {
         	Perzak.Travm:=perzak.Travm + getsumwithavans;
         }
      11:{
    			perzak.DopSpis1Spec:=perzak.DopSpis1Spec + if(ParamReport = 1,0,GP_Rasp_SV_GosZakaz.sumper);
         }
			12:{
           if GP_Rasp_SV_GosZakaz.strtabn='000568'
 			      {
              perzak.DopSpis2:=perzak.DopSpis2 + if(ParamReport = 1,0,GP_Rasp_SV_GosZakaz.sumper);
//				perzak.DopSpis2Spec:=perzak.DopSpis2Spec+GP_Rasp_SV_GosZakaz.sumper;
            }
			    	else
    				{
             perzak.DopSpis2Spec:=perzak.DopSpis2Spec + if(ParamReport = 1,0,GP_Rasp_SV_GosZakaz.sumper);
		    		}
 			   }
       end;
			update current perzak;

	}
StopVisual('',0);

              XlSetCellStringValue('Сводка отчислений во внебюджетные фонды '+Case(pmes;
                                                                    1 : 'Январь',
                                                                    2 : 'Февраль',
                                                                    3 : 'Март',
                                                                    4 : 'Апрель',
                                                                    5 : 'Май',
                                                                    6 : 'Июнь',
                                                                    7 : 'Июль',
                                                                    8 : 'Август',
                                                                    9 : 'Сентябрь',
                                                                    10 : 'Октябрь',
                                                                    11 : 'Ноябрь',
                                                                    12 : 'Декабрь'
                                                                ) +' '+String(pyearn) + ' года.'
                                 ,1,3,1,3);
Counter:=5;
	
	_loop perzak ordered by perzak.cvplan
	{
	xlsetcellStringValue(Perzak.name,Counter,1,Counter,1);
	xlsetcellNumberValue(round(PerZak.strah,2),Counter,2,Counter,2);
	xlsetcellNumberValue(round(PerZak.DopSpis1,2),Counter,3,Counter,3);
	xlsetcellNumberValue(round(PerZak.DopSpis2,2),Counter,4,Counter,4);
	xlsetcellNumberValue(round(PerZak.DopSpis1Spec,2),Counter,5,Counter,5);
	xlsetcellNumberValue(round(PerZak.DopSpis2Spec,2),Counter,6,Counter,6);
	xlsetcellNumberValue(round(PerZak.FOMS,2),Counter,7,Counter,7);
	xlsetcellNumberValue(round(PerZak.FSS,2),Counter,8,Counter,8);
	xlsetcellNumberValue(round(PerZak.Travm,2),Counter,9,Counter,9);
	Counter++;
	}
}



HandleEvent
 CmInit:{
delete all from perzak;
delete all from perzaktemp;
          pmes:=Month(dgettune('UP.DATOTCH'));
          pyearn:=Year(dgettune('UP.DATOTCH'));
          FiltrPodr:='По всем';
          flabel   :='Папка выгрузки'; 
          ClearFieldState(#flabel,sfVisible);
          ClearFieldState(#Filepath,sfVisible)  ;

          if getfirst fastfirstrow katpodr where (('Клинский филиал - Спортивно- оздоровительный центр санаторного типа "Вымпел"' == katpodr.name))=tsok
           nrecisklpodr1:=katpodr.nrec;
          if getfirst fastfirstrow katpodr where (('Вымпел договорники' == katpodr.name))=tsok
           nrecisklpodr2:=katpodr.nrec;
        }

CmDelOnProtect:{
                 Case Curfield of 
                  #filtrPodr: { filtrPodr:='По всем';}
                 end;
                 ReScanpanel(curtable);
               }

  CmCheckField:{
                 case curfield of
                 #isdbf :{
                          if isdbf=1
                          {
                           SetFieldState(#flabel,sfVisible);
                           SetFieldState(#Filepath,sfVisible)  ;
                          }
                          else
                          {
                           ClearFieldState(#flabel,sfVisible);
                           ClearFieldState(#Filepath,sfVisible)  ;
                          }
                         }
                end;
                ReScanpanel(curtable);
               } 
cmPick:
{

       Case curfield of
         #filtrPodr : {
  
                       delete novisual Pick where (( 11 == Pick.wList ));
                       countPickPodr  :=0;
                       if runinterface('Z_KATPODR::GetSomePodr')<>cmcancel
                       {
                         FOR (
                               Stat := GetFirst Pick where ((word(11) == Pick.wList));
                               Stat  = tsOk;
                               Stat := GetNext  Pick where ((word(11) == Pick.wList))
                              )
                                          countPickPodr  :=  countPickPodr  + 1;
                            {            
                                   filtrPodr  :='выбрано '+DoubleToStr(countPickPodr,'666 666 667')+' подразд.';
                            }
                       }
                
                      }
            #filepath        :{
                                filepath:=getdirname('Выберите папку сохранения dbf');
                                if(filepath <> '')
                                  filepath := filepath+'\';
                                ReScanPanel(curtable);
                              }
         end;
         ReScanPanel(curtable);
}
CmOk:
{

 ExcelPath:=StartPathName+'\xls_ЭМ\staff\';

    xlCreateExcelWithTemplate(ExcelPath+'form_reestr_fakel.xlsx',true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');


!if PriznReDo=1
!{
delete GP_Rasp_SV_GosZakaz where ((pYearn==GP_Rasp_SV_GosZakaz.Yearn and pMes==GP_Rasp_SV_GosZakaz.mesn));
FormDataRasp;
FormReestrPredMes;
!}
!else
!{
!FormReestrPredMes;
!}


xlkillExcel;

}








end;
end.



