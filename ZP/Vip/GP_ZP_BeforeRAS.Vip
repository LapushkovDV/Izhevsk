/*************************************************************************************************\
* Наименование:  Ведение заказов/проектов - Распределение ФОТ работников по заказам               *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    проверка данных перед расчетом зарплаты                                          *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#773          |10/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#doc
 проверка данных перед расчетом зарплаты
#end
Interface ZAR_BeforeRAS;
create view vZAR_BeforeRAS
var
 NEEDREP :word;
 wc_lsch:comp;
 kl_inv :boolean;
 Marker :longint;
 w_datotch:date;//дата начала отчетного периода
 Tabn_Format :word;

as select 
  lschet.tabn
from 
 formarks(FORMARKS12)
 ,lschet 
 ,lschet lschet_m
 ,LGNALLSZ, LGNALLSZ LGNALLSZ_M
 , LGNALLSZ LGNALLSZ_C
 , child
where ((
 0 == formarks.choice
and formarks.CLSCHET == lschet_m.nrec
and lschet_m.nrec == LGNALLSZ_M.clschet
and LGNALLSZ_M.nrec == LGNALLSZ_C.nrec
and 0 == APPLDOCS.WTABLE
AND formarks.CLSCHET == APPLDOCS.crec
and wc_lsch == lschet.nrec
and wc_lsch == LGNALLSZ.CLSCHET
and wc_lsch == child.clsch
));
parameters NeedRep;
//=====================
Procedure Chk_Childs;
{ if getfirst fastfirstrow child=0
  { _loop fullcache child
    { if lschet_m.datuv<>date(0,0,0) and lschet_m.datuv<child.datok
      { displ('Таб.№ '+if(Tabn_Format=0,string(lschet_m.tabn),lschet_m.strtabn)
         +' изменена дата окончания пособия '+if(CHILD.PMAMA=0,' детям ',' матери')
         + DateToStr(child.datok,'c DD/MM/YYYY')
         +' на дату увольнения '+DateToStr(lschet_m.datuv,'DD/MM/YYYY')); 
        update current child set child.datok:=lschet.datuv;
        if CHILD.PMAMA<>0
        { if  month(child.datok)=month(w_datotch)
          and year(child.datok)=year(w_datotch)
          { update current child
            set  Child.Summa :=round(50*day(child.datok)/last_day(w_datotch),2);
            displ('сумма пересчитана на '+string(Child.Summa))
          }  
        }
      }
      if child.datok<w_datotch and Child.Summa<>0
      { //update current child  set   Child.Summa := 0 ,Child.Summai := 0
        //    ,Child.Summa2:= 0 ,Child.SumUd  := 0        ;
       displ('Таб.№ '+if(Tabn_Format=0,string(lschet_m.tabn),lschet_m.strtabn)
         //+' Обнулена сумма пособия '+if(CHILD.PMAMA=0,' детям ',' матери')
         +' ненулевая сумма пособия '+if(CHILD.PMAMA=0,' детям ',' матери')
         +' по периоде назначения меньше текущего') 
     }
    }  //_loop fullcache child
  }  
} //Procedure Chk_Childs

//=====================
HandleEvent
cmInit:
{ w_datotch:=dgettune('UP.DATOTCH');
  StartNewVisual (vtIndicatorVisual,vfTimer,'Идет проверка данных перед расчетом',recordsintable(#Formarks));
  Marker:=InitMarker('', 8, 200, 10); 
  Tabn_Format:=wgettune('FORMATCLOCKNUMBER');
  _loop fullcache Formarks
  { NextVisual;
    if getfirst fastfirstrow lschet_m=0 {}
    wc_lsch:=formarks.CLSCHET;
    if getfirst fastfirstrow lschet=0 {}
    kl_inv:=false;
    if getfirst fastfirstrow LGNALLSZ_M=0
    { kl_inv:=true;
    }
    Chk_Childs;
    ClearMarker(Marker);
    _loop fullcache appldocs
    { wc_lsch:=APPLDOCS.cTIPDOC;
      if getfirst fastfirstrow lschet=0 {}
      if kl_inv  // ставим льготы по инвалидности
      { _loop LGNALLSZ_M
        {  if getfirst fastfirstrow LGNALLSZ where ((
                 wc_lsch == LGNALLSZ.CLSCHET
              and LGNALLSZ_M.VIDPER == LGNALLSZ.VIDPER
              and LGNALLSZ_M.YEAR == LGNALLSZ.YEAR
              and LGNALLSZ_M.MES == LGNALLSZ.MES
              and LGNALLSZ_M.NOMSCALE == LGNALLSZ.NOMSCALE(noindex)
              and LGNALLSZ_M.PROC == LGNALLSZ.PROC(noindex)
              and LGNALLSZ_M.VIDPER1 == LGNALLSZ.VIDPER1(noindex)
              and LGNALLSZ_M.YEAREND == LGNALLSZ.YEAREND(noindex)
              and LGNALLSZ_M.MESEND == LGNALLSZ.MESEND(noindex)
            ))<>0  
           { if getfirst LGNALLSZ_C=0
             { LGNALLSZ_C.NREC:=0 ;
               LGNALLSZ_C.clschet:=wc_lsch;
               insert current LGNALLSZ_C;
               InsertMarker(Marker,LGNALLSZ_C.NREC)
             }
           }
           else
           {  InsertMarker(Marker,LGNALLSZ.NREC)
           }
        } //_loop LGNALLSZ_M
        _loop  fullcache LGNALLSZ
        { if not foundmarker(Marker,LGNALLSZ.nrec)
            delete current LGNALLSZ;
        
        } //_loop  fullcache LGNALLSZ
      }
      Chk_Childs;
    } //_loop fullcache appldocs
  } //_loop fullcache Formarks 
  DoneMarker(Marker,'');
  StopVisual('',0);
  Closeinterface(cmDone);
  abort ; exit ;
} //cmInit;
end;
end.
