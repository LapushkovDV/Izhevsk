/*************************************************************************************************\
* Наименование:  Ведомость инвентаризации резерва отпусков                                        *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3844          |15/01/19 |Ермолов К.Р.            |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih

interface gp_vedinvrezotpusk

table struct tab1
(
sch: string,
zakaznum: string,
podr: string,
sum1: decimal(31,15),
sum2: decimal(31,15)
)
with index
(
i1 = sch + zakaznum
)
;

const
invent: string = 'Инвентаризация резерва на отпуск Декабрь 2018г.';
end;

create view

var
ExcelPath, numSch: string;
counter: longint;
allsum1, schsum1, allsum2, schsum2: double;

as select * from tab1;

handleevent

cmInit:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from tab1;

  sql
  select oborot.dbscheto, mnplan.number, substring(katpodr.kod,1,3), sum(case when oborot.kauks[1]=#comp(858) then oborot.sumob else 0 end), sum(case when oborot.kauks[1]=#comp(2814749767106816) then oborot1.sumob else 0 end)
  from plpor
  left join oborot on plpor.nrec=oborot.csoprdoc and oborot.tidk=10
  left join mnplan on oborot.kauos[1]=mnplan.nrec
  left join oborot oborot1 on oborot.nrec=oborot1.nrec
  left join katpodr on oborot.kauos[4]=katpodr.nrec
  where plpor.namepl1=:(invent)
  group by oborot.dbscheto, mnplan.number, substring(katpodr.kod,1,3)
  into tab1;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_vedinvrezotpusk.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  counter:= 2;
  if getfirst tab1 = tsok then numSch:= tab1.sch;

  xlsetcellstringvalue(invent, 1, 1, 1, 1);

  _loop tab1
  {
    counter++;

    if tab1.sch = numSch
    {
      allsum1:= allsum1 + tab1.sum1;
      allsum2:= allsum2 + tab1.sum2;
      schsum1:= schsum1 + tab1.sum1;
      schsum2:= schsum2 + tab1.sum2;
      xlsetcellstringvalue(tab1.sch, counter, 1, counter, 1);
      xlsetcellstringvalue(tab1.zakaznum, counter, 2, counter, 2);
      xlsetcellstringvalue(tab1.podr, counter, 3, counter, 3);
      xlsetcellnumbervalue(tab1.sum1, counter, 4, counter, 4);
      xlsetcellnumbervalue(tab1.sum2, counter, 5, counter, 5);
    }
    else
    {
      xlmergecells(counter, 1, counter, 3);
      xlsetfontstyle(1, counter, 1, counter, 5);
      xlsetcellstringvalue('Итого по счету ' + numSch, counter, 1, counter, 1);
      xlsetcellnumbervalue(schsum1, counter, 4, counter, 4);
      xlsetcellnumbervalue(schsum2, counter, 5, counter, 5);

      schsum1:= tab1.sum1;
      schsum2:= tab1.sum2;
      numSch:= tab1.sch;
      allsum1:= allsum1 + tab1.sum1;
      allsum2:= allsum2 + tab1.sum2;
      counter++;

      xlsetcellstringvalue(tab1.sch, counter, 1, counter, 1);
      xlsetcellstringvalue(tab1.zakaznum, counter, 2, counter, 2);
      xlsetcellstringvalue(tab1.podr, counter, 3, counter, 3);
      xlsetcellnumbervalue(tab1.sum1, counter, 4, counter, 4);
      xlsetcellnumbervalue(tab1.sum2, counter, 5, counter, 5);
    }
  }

  counter++;

  xlmergecells(counter, 1, counter, 3);
  xlmergecells(counter + 1, 1, counter + 1, 3);
  xlsetfontstyle(1, counter, 1, counter + 1, 5);
  xlsetcellstringvalue('Итого по счету ' + numSch, counter, 1, counter, 1);
  xlsetcellnumbervalue(schsum1, counter, 4, counter, 4);
  xlsetcellnumbervalue(schsum2, counter, 5, counter, 5);
  xlsetcellstringvalue('ИТОГО', counter + 1, 1, counter + 1, 1);
  xlsetcellnumbervalue(allsum1, counter + 1, 4, counter + 1, 4);
  xlsetcellnumbervalue(allsum2, counter + 1, 5, counter + 1, 5);

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter + 1, 5);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_vedinvrezotpusk Implements IUserReport;
Interface UserReport_vedinvrezotpusk;

Procedure Run;
Begin
  runinterface(gp_vedinvrezotpusk);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Ведомость инвентаризации резерва отпусков';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
