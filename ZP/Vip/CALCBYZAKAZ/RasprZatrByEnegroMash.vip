              StopVisual('',0);

        li1:=sqlExecDirect(vliSQLCommand);

        MtClear(#tlschet,fmNormal);

        stmt := sqlAllocStmt;
        sqlAddStr(stmt_str,'select ');
        sqlAddStr(stmt_str,'      l.nrec  ');
        sqlAddStr(stmt_str,'     ,l.tabn  ');
        sqlAddStr(stmt_str,'     ,l.strtabn  ');
        sqlAddStr(stmt_str,'     ,l.tperson  ');
        sqlAddStr(stmt_str,'     ,l.cex  ');
        sqlAddStr(stmt_str,'     ,l.cpodr  ');
        sqlAddStr(stmt_str,'     ,p.fio  ');
        sqlAddStr(stmt_str,'  from     ');
        sqlAddStr(stmt_str,'    (   ');
        sqlAddStr(stmt_str,'      select ');
        sqlAddStr(stmt_str,'        distinct ');
        sqlAddStr(stmt_str,'         clsch');
!        sqlAddStr(stmt_str,'        from nachislzakaz');
        sqlAddStr(stmt_str,'        from nachisl');
        sqlAddStr(stmt_str,'         where mesn=? and yearn=?');
        sqlAddStr(stmt_str,'     )t1 inner join lschet l on t1.clsch=l.nrec');
        sqlAddStr(stmt_str,'         inner join persons p on l.tperson=p.nrec');
        sqlAddStr(stmt_str,'         inner join selMarksLs sel on l.nrec = sel.nrec ');
!        sqlAddStr(stmt_str,'       ');
!        sqlAddStr(stmt_str,'       ');

        sqlBindparam(stmt,1,pmes);
        sqlBindparam(stmt,2,pyearn);
        sqlPrepare(stmt,stmt_str);

        li1:=sqlExecute(stmt);

        if (sqlFetchInto(stmt,#tlschet) != tsOk)
   	      Message('not tsOk select (');

         sqlFreeStr(stmt_str); 
         sqlFreeStmt(stmt);
        
        setBounds(#n1);
        setBounds(#Nfot);

!        RebuildPanels;
         ReReadRecord(#tlschet);
         ReReadRecord(#N1);
         if getfirst tlschet=tsok  SetColumnTitle(BrwNach,#N1.summa,'Сумма по затратам '+chr(13)+GetSumColumn(tlschet.nrec));

          xlKillExcel;


              if islog=1
               if (efile.GetSize)>1
              {
