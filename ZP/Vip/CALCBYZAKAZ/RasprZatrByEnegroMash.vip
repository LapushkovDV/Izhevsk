                          xlSetCellStringValue(dolj.name,row,4,row,4);
                          xlSetCellStringValue('В распределении затрат не определены аналитики . Дата начала :'+DateTostr(PrVidopl.Datan,'DD.MM.YYYY')+' Дата окончания :'+DateTostr(PrVidopl.Datok,'DD.MM.YYYY'),row,5,row,5);
                          xlSetCellNumberValue(tnachisl.summa,row,6,row,6);
                         }

                         firsterr:=0;
                        }

  /*
                     if not ((sumnach-sumcalc)<0)
