!                        efile.writeln('  !!!Error в данном наряде не задан '+if(nachisl1.CSCHETD='' and nachisl1.CSUBSCHD='','счет и субсчет',if(nachisl1.CSCHETD='','счет','субсчет')));
                         efile.writeln('  !!!Error в данном наряде не задан счет');
                       }

                        if islog=1
