        ,TBLD[1]   
        ,TBLD[2]   
        ,TBLD[3]   
        ,TBLD[4]   
        ,TBLD[5]   
        ,TBLD[6]   
        ,CSCHETK   
        ,CSUBSCHK  
        ,CKAUD[1]  
        ,CKAUD[2]  
        ,CKAUD[3]  
        ,CKAUD[4]  
        ,CKAUD[5]  
        ,CKAUD[6]  
        ,TBLK[1]   
        ,TBLK[2]   
        ,TBLK[3]   
        ,TBLK[4]   
        ,TBLK[5]   
        ,TBLK[6]   
        ,CLSCH
        ,CNACH
        ,OTKUDA
        ,TPERSON
        ,VIDOPL
        ,VIDOPLS
        ,YEARK
        ,YEARN
        ,STRTABN
        ,KAUEXTR[1]
        ,KAUEXTR[2]
        ,KAUEXTR[3]
        ,KAUEXTR[4]
        ,KAUEXTR[5]
        ,KAUEXTR[6]
        ,TBLEXTR[1]
        ,TBLEXTR[2]
        ,TBLEXTR[3]
        ,TBLEXTR[4]
        ,TBLEXTR[5]
        ,TBLEXTR[6]
        from perevod
         where YEARN=:(pyearn) and mesn=:(pmes)
        into tperevodmes byname
        ;        
       }

     StopVisual('',0);        
}

Procedure ReLoadKlOpl;
{
    MtClear(#tvidopl,fmNormal);
     sql select
      klvidopl.vidopl,klvidopl.vidoplp
       from
      klvidopl
       where exists (select  1 from klvxod where klvidopl.vidopl=klvxod.vidopl and klvxod.nomer=52)
      into tvidopl byname;
      ;
}

Procedure SetSourceData;
{

}



tableEvent table tlschet;
 CmPositionChanged :   SetColumnTitle(BrwNach,#N1.summa,'Сумма по затратам '+chr(13)+GetSumColumn(tlschet.nrec));
end;

TableEvent table zar_user;
cmUpdateRecord:
  update current zar_user;

cmCheckField:
{

   case curfield of
     #islog :{
              exit;
             }

     #filtr :{// filtr :=filtr-(filtr XOR 0);
               if filtr=1
               {
                 ClusterDisabledField(#filtr, word(2));
                 clearfieldstate(#filtrls,sfVisible);
                 SetFieldState(#filtrpodr,sfVisible);

                  if FiltrPodr<>'По всем'
                  {
                    ReLoadMarkbyPodr;
                  }
                  else
                  {
                   ReLoadMarkbyAll;
                  }

               }
               else
                if filtr=2
               {
                 ClusterDisabledField(#filtr, word(1));
                 clearfieldstate(#filtrpodr,sfVisible);
                 SetFieldState(#filtrls,sfVisible);
                 ReloadMarksbyLs;
               }
               else
                if filtr=0
                {
                 ClusterDisabledField(#filtr, word(0));
                 SetFieldState(#filtrls,sfVisible);
                 SetFieldState(#filtrpodr,sfVisible);
                }

             }

     #pmes : {
!              if Message('Действительно хотите изменить мес');
!               SetSourceData;
               if pmes_=pmes {flagArh:=false; _tiprec:='0';} else {flagArh:=true; _tiprec:='2'}
!               Message('flagArh='+flagArh);

               ReloadAllNach;
             }
   end;

!  PodrPubCheck; //Процедура для фильтров по подразд. и работникам
         if filtr<>0 ReLoadtmp;

         ReReadRecord(#tlschet);
         ReReadRecord(#N1);
         ReReadRecord(#NFot);
}

end;  //tableevent


 HandleEvent
  CmInit:{

          deletefile('c:\debug\GetFiltrZarInit.txt');

!          if (not IntInit)
!          {
!           abort;
!           exit;
!          }

         wViewMode:=0;

//         InitUser(1); // Инициализация Zar_User

         if (Not InitTmpTable(ctmDynamicIndex))
           exit;

         pl:=cogettune('Fin.User.cPlansSch');
          if getfirst planssch where ((pl == planssch.nrec))=tsok codplan:=planssch.kod;

         mtClear(#tplan,fmNormal);

         FiltrPodr:='По всем';
         FiltrLs:='Не задан';

         if ReadMyDsk(FiltrPodr,'FiltrPodrForRas',false) {}
         if ReadMyDsk(FiltrLs,'FiltrLsForRas',false) {}

         if ReadMyDsk(Filtr,'FiltrForRas',false)
         {
          if filtr=1
          {
            ClusterDisabledField(#filtr, word(2));
            clearfieldstate(#filtrls,sfVisible);
            SetFieldState(#filtrpodr,sfVisible);

            if FiltrPodr<>'По всем'
         	   {
              ReLoadMarkbyPodr;
            }
            else
            {
             ReLoadMarkbyAll;
            }

          }
          else
           if filtr=2
          {
            ClusterDisabledField(#filtr, word(1));
            clearfieldstate(#filtrpodr,sfVisible);
            SetFieldState(#filtrls,sfVisible);

            if FiltrLs<>'Не задан'
             ReloadMarksbyLs;

          }
          else
           if filtr=0
           {
            ClusterDisabledField(#filtr, word(0));
            SetFieldState(#filtrls,sfVisible);
            SetFieldState(#filtrpodr,sfVisible);
           }
         }

         sql
          select
           buhschet.nrec as nrec
          ,Substring(buhschet.schet,2,length(buhschet.schet)-1) as schet
          ,buhschet.subsch as subsch
          ,Case
            When KODTABLE[1]=7 then 1
            When KODTABLE[2]=7 then 2
            When KODTABLE[3]=7 then 3
            When KODTABLE[4]=7 then 4
            When KODTABLE[5]=7 then 5
            When KODTABLE[6]=7 then 6
          end as levelz
         from
          buhschet
           where cplanssch=:(pl)
           and KODTABLE[1]=7 or KODTABLE[2]=7 or KODTABLE[3]=7 or KODTABLE[4]=7 or KODTABLE[5]=7 or KODTABLE[6]=7
           into tplan byname
          ;

          sql select
            mnplan.nrec 
           ,mnplan.cvplan
          from mnplan inner join vplan on mnplan.cvplan = vplan.nrec
  //          and vplan.name in ('Факел-2','Ангара','Нафтил','Форсаж')
  // мля ... убираем костыль
                join attrnam aN ON an.wtable =31015
                               and an.name = 'Банковские счета'
                join attrval av on av.cAttrnam = an.nrec
                               and av.crec = vplan.nrec
                join KatBank kb on kb.nrec = av.vcomp
                join attrnam aNigk ON anigk.wtable =1421
                               and anigk.name = 'Ссылка на ИГК'
                join attrval avigk on avigk.cAttrnam = anigk.nrec
                             and avigk.crec = kb.nrec
                             and coalesce(avigk.vcomp,#comp(0)) <> #comp(0)

           where mnplan.typeplan=17
          into tvplan byname
          ;


!         pmes:=Month(dgettune('UP.DATOTCH'));
!         pyearn:=Year(dgettune('UP.DATOTCH'));

         pmes:=Month(dgettune('NPOEM_OWN.ZP.DATOTCHZAK'));
         pyearn:=Year(dgettune('NPOEM_OWN.ZP.DATOTCHZAK'));

!         pmes_:=pmes;//Month(dgettune('UP.DATOTCH'));
!         pyearn_:=pyearn;

!         if pmes_=pmes {flagArh:=false ; _tiprec:='0'} else {flagArh:=true; _tiprec:='2';}
         if Month(dgettune('UP.DATOTCH'))=pmes {flagArh:=false ; _tiprec:='0'} else {flagArh:=true; _tiprec:='2';}

         ClearQuery(vliSQLCommand);
         sqlAddStr(vliSQLCommand, 'INSERT INTO selMarksLs');
         sqlAddStr(vliSQLCommand, '(');
         sqlAddStr(vliSQLCommand, '  nrec');
         sqlAddStr(vliSQLCommand, ')');

        firstrec:=1;

        StartNewVisual(vtRotateVisual, vfTimer+vfBreak,
                         ''#3'Предварительная загрузка данных.'#13#3,1);


        _loop tformarks
        {
         if isvalid(#lschet)
         {

          if firstrec=1
           sqlAddStr(vliSQLCommand, 'select  #comp(' +lschet.nrec+ ')'+' from dual')
          else
           sqlAddStr(vliSQLCommand, 'union all select  #comp(' +lschet.nrec+ ')'+' from dual');
         }
          firstrec:=0;
        }

        StopVisual('',0);        

        li1:=sqlExecDirect(vliSQLCommand);

        MtClear(#tlschet,fmNormal);

        stmt := sqlAllocStmt;
        sqlAddStr(stmt_str,'select ');
        sqlAddStr(stmt_str,'      l.nrec  ');
        sqlAddStr(stmt_str,'     ,l.tabn  ');
        sqlAddStr(stmt_str,'     ,l.strtabn  ');
        sqlAddStr(stmt_str,'     ,l.tperson  ');
        sqlAddStr(stmt_str,'     ,l.cex  ');
        sqlAddStr(stmt_str,'     ,l.cpodr  ');
        sqlAddStr(stmt_str,'     ,p.fio   ');
        sqlAddStr(stmt_str,'  from     ');
        sqlAddStr(stmt_str,'    (   ');
        sqlAddStr(stmt_str,'      select ');
        sqlAddStr(stmt_str,'        distinct ');
        sqlAddStr(stmt_str,'         clsch');
        sqlAddStr(stmt_str,'        from '+if(flagArh=False,'nachisl','sumvidop'));
!        sqlAddStr(stmt_str,'        from nachisl');
        sqlAddStr(stmt_str,'         where mesn=? and yearn=?');
        sqlAddStr(stmt_str,'     )t1 inner join lschet l on t1.clsch=l.nrec');
        sqlAddStr(stmt_str,'         inner join persons p on l.tperson=p.nrec');
        sqlAddStr(stmt_str,'         inner join selMarksLs sel on l.nrec = sel.nrec ');
!        sqlAddStr(stmt_str,'       ');

        sqlBindparam(stmt,1,pmes);
        sqlBindparam(stmt,2,pyearn);
        sqlPrepare(stmt,stmt_str);

        li1:=sqlExecute(stmt);

        if (sqlFetchInto(stmt,#tlschet) != tsOk)
   	      Message('not tsOk select (');

        sqlFreeStr(stmt_str); 
        sqlFreeStmt(stmt);

         SetFormat(BrwNach);

         SetColumnTitle(BrwNach,#N1.summa,'Сумма по затратам '+chr(13)+GetSumColumn(tlschet.nrec));

!         islog:=1;
!          NoCaclFot:=1;

         // подгурзим GP_RASPVO в память (нет пока нужных индексов там....)
          sql select
           nrec
	      ,schet
	      ,subsch
	      ,vidoplp
	      ,cMnplan
	      ,CADDFLD[1] as CADDFLD
	      from 
	       gp_raspvo
          where 
           gp_raspvo.tp=0 and gp_raspvo.isarh=0
          into tgp_raspvo byname;

          SelectableButton(ParamForm,CmValue1,false);

        // add 27/03/2018 в атрибуте к katpodr тоже могут лежать критерии (не)обнуления часов
        if getfirst fastfirstrow katkau where ((     1   == katkau.sysnum
                                                 and 0   == katkau.isactive
                                                 and 'Вид производства' == katkau.name
                                              ))=tsok
        {
         _loop spkau where (( katkau.kodgroup == spkau.kodgrkau))
         {
          if spkau.name='Конструкторское бюро' NrecIskPodr1:=spkau.nrec;
          if spkau.name='Научно-испытательный комплекc' NrecIskPodr2:=spkau.nrec;
         }


          atr_vid_manuf:=oExAttr.CreateAttrComp(word(1413),'Вид производства',word(5),word(1),katkau.kodgroup);
        }

!       Message('atr_vid_manuf='+atr_vid_manuf+'|'+NrecIskPodr1+'|'+NrecIskPodr2);


      if getfirst fastfirstrow KatNotes Where (( 1202          == KatNotes.VidDoc
                                                and 'Закрытый' == KatNotes.name (noindex)
                                              ))=tsok
        closenote:=Katnotes.nrec
      else
        Message('Не удалось найти статус '+''''+'Закрытый'+''''+' к производственным заказам !');



        ReloadAllNach;

        NMarker := InitMarker('', 8, 4, 1) ;
       if getfirst katpodrchk where (( '555' == katpodrchk.kod ))=tsok nrec555:=katpodrchk.nrec;

!         ResetBounds(#katpodr);
!         if getfirst fastfirstrow katpodr where (( '446' ==  katpodr.kod))=tsok
!           isklpodr:=katpodr.nrec;
!         SetBounds(#katpodr);

       }

CmDelOnProtect:{
                 Case Curfield of 
                  #filtrPodr: { filtrPodr:='По всем'; ReLoadMarkbyAll; if filtr>0 ReLoadtmp;}
                  #FiltrLs  : { FiltrLs:='Не задан';}
                 end;
                 ReReadRecord(#tlschet);
                 ReReadRecord(#N1);
                 ReScanpanel(curtable);
               }


cmPick:
{
!  PodrPubPick; //Процедура для фильтров по подразд. и работникам

       Case curfield of
         #filtrPodr : {
  
                       delete novisual Pick where (( 11 == Pick.wList ));
                       countPickPodr  :=0;
                       if runinterface('Z_KATPODR::GetSomePodr')<>cmcancel
                       {
                         FOR (
                               Stat := GetFirst Pick where ((word(11) == Pick.wList));
                               Stat  = tsOk;
                               Stat := GetNext  Pick where ((word(11) == Pick.wList))
                              )
                                          countPickPodr  :=  countPickPodr  + 1;
                            {            
                                   filtrPodr  :='выбрано '+DoubleToStr(countPickPodr,'666 666 667')+' подразд.';
                            }
                          ReLoadMarkbyPodr;
                       }
                
                      }

          #filtrLs  : {                                             	
                        if RunInterface('GetMyLs')=CmDefault
                         {
                           Marker := InitMarker('SelMyLs', 8, 200, 100) ;
                           filtrLs:= 'выбрано '+getMarkerCount(Marker) +' л/с';
                           DoneMarker(Marker,'SelMyLs');
                           ReloadMarksbyLs;
                         }
                      }

           #KauZakaz :{
                       if (iGetKau.GetCodeKau(cgiPick,word(7),N1.CKAUD[1])>0)
                        {
                         update current N1; 
                        }
                      }

           #n1.chasf :{
                        if RunWindowModal(WinChangeVal)=CmDefault
                        {
                         update current N1 set N1.chasf:=dvalue;
                        }
                      }
       end;

        if (curfield=#filtrPodr or curfield=#filtrLs)
        {
         if filtr>0 ReLoadtmp;
          ReReadRecord(#tlschet);
          ReReadRecord(#N1);
        }
}
 CmOk:{

        if Message('Внимание ! Будут модифицированы данные в Базе Данных '+chr(13)+
                   'Уверены, что продолжим ?',YesNo+Confirmation)<>CmYes
         {
          exit;
         }

!        Message('CmOk');
        deletefile('c:\debug\GetFiltrZar.txt');

//        MtClear(#tperevod,fmNormal);
        MtClear(#tperevodmes,fmNormal);



        dN1:=Date(1,pmes,pyearn);
        dN2:=Date(last_Day(dN1),pmes,pyearn);

        ReloadAllPer;
        ReloadAllNach;


              if islog=1
              {
               deletefile(GetPathParameter('files', 'OutputFilesDirectory', 0)+'logcalczatr.txt');
               eFile.OpenFile(GetPathParameter('files', 'OutputFilesDirectory', 0)+'logcalczatr.txt', stCreate);
              }



    // загрузим все входимости 1 раз....
    ReLoadKlOpl;

    // загрузим все наряды за месяц
    mtClear(#tNaryad,fmNormal);
    sql select
       //prnaryad.nrec
       prnaryad.tabn
      ,prnaryad.strtabn
      ,prnaryad.vidopl
      ,prnaryad.mes
      ,min(prnaryad.datan) as datan
      ,max(prnaryad.datok) as datok
      ,Sum(prnaryad.chasf) as chasf // prnaryad.NrmTime as chasf
      ,Sum(prnaryad.summa) as summa
      ,prnaryad.koldn
      ,prnaryad.cschetd
      ,prnaryad.csubschd
      ,prnaryad.TBLD[1]
      ,prnaryad.TBLD[2]
      ,prnaryad.TBLD[3]
      ,prnaryad.TBLD[4]
      ,prnaryad.TBLD[5]
      ,prnaryad.TBLD[6]
      ,prnaryad.CKAUD[1]
      ,prnaryad.CKAUD[2]
      ,prnaryad.CKAUD[3]
      ,prnaryad.CKAUD[4]
      ,prnaryad.CKAUD[5]
      ,prnaryad.CKAUD[6]
      ,prnaryad.ckaud[3] as czak
      ,prnaryad.clsch
      ,prnaryad.tperson
    from prnaryad inner join sys_nar on prnaryad.mnrec=sys_nar.nrec and sys_nar.choice<500
       where prnaryad.datan>=:(dN1) and prnaryad.datok<=:(dN2) and prnaryad.vidopl in(1,7,9,11)
group by
       prnaryad.tabn
      ,prnaryad.strtabn
      ,prnaryad.vidopl
      ,prnaryad.mes
      ,prnaryad.koldn
      ,prnaryad.cschetd
      ,prnaryad.csubschd
      ,prnaryad.TBLD[1]
      ,prnaryad.TBLD[2]
      ,prnaryad.TBLD[3]
      ,prnaryad.TBLD[4]
      ,prnaryad.TBLD[5]
      ,prnaryad.TBLD[6]
      ,prnaryad.CKAUD[1]
      ,prnaryad.CKAUD[2]
      ,prnaryad.CKAUD[3]
      ,prnaryad.CKAUD[4]
      ,prnaryad.CKAUD[5]
      ,prnaryad.CKAUD[6]
      ,prnaryad.ckaud[3]
      ,prnaryad.clsch
      ,prnaryad.tperson
     into tNaryad byname;

     ResetBounds(#n1);
     ResetBounds(#nFot);

!         if (Not InitTmpTable(ctmDynamicIndex))
!           exit;

!         ClearQuery(vliSQLCommand);
!         sqlAddStr(vliSQLCommand, 'INSERT INTO selMarksLs');
!         sqlAddStr(vliSQLCommand, '(');
!         sqlAddStr(vliSQLCommand, '  nrec');
!         sqlAddStr(vliSQLCommand, ')');

        firstrec:=1;

        if Verify(CntMarkLs) curcount:=CntMarkLs else curcount:=0;
//        Message('curcount='+curcount);
!       StartNewVisual(vtRotateVisual, vfTimer+vfBreak,
!                         ''#3'Идет расчет..ожидайте.'#13#3,1);
         StartNewVisual(vtIndicatorVisual,vfBreak+vftimer,
                       ''#3'Идет расчет .. ожидайте..'#13#3,curcount) ;

         _loop tformarks
        {
!         Message('tformarks.CPODR='+tformarks.CPODR);
                    if not nextvisual
                    {
                    Message('Формирование отчета было прервано...переформируйте заново');
!                    yesbrk:=true;
                    break;
                    }

/*
          if firstrec=1
           sqlAddStr(vliSQLCommand, 'select  #comp(' +lschet.nrec+ ')'+' from dual')
          else
           sqlAddStr(vliSQLCommand, 'union all select  #comp(' +lschet.nrec+ ')'+' from dual');
*/
!           if humancalc<>0
!            if humancalc<>tformarks.cpodr
!             continue;

!         firstrec:=0;


          if isvalid(#lschet)
          {

           delete novisual from N1 where (( lschet.nrec == N1.CLSCH and pyearn == n1.yearn and pmes  == n1.mesn ));
           delete novisual from nFot where (( lschet.nrec == nFot.CLSCH  and pyearn  == Nfot.yearn (noindex)   and pmes == Nfot.mesn  (noindex) ));
           IsNoGosinAvans:=True;

           if getfirst katpodrchk where (( lschet.KASSIR1 == katpodrchk.kod ))=tsok nrec555:=katpodrchk.nrec;

          if islog=1
           {
            efile.writeln('-----------------------------------------------------------------');
!            efile.writeln('Таб№'+lschet.tabn+' Всего часов по затратам:'+SumZatr);
            efile.writeln('Табельный№ '+lschet.strtabn+'('+lschet.nrec+')');
           }

!           //сразу посмотрим есть ли 52 оплаты по текущему табельному в нужном периоде
!           yes52:=(RecordExists nachislchk where ((LSCHET.NREC   == nachislchk.clsch and pyearn == nachislchk.yearn and pmes  == nachislchk.mesn and 52==nachislchk.vidopl (noindex) )) )
           //и тоже самое по 1 ВОПЛ
           //yes1  :=(RecordExists nachislchk where ((LSCHET.NREC   == nachislchk.clsch and pyearn == nachislchk.yearn and pmes  == nachislchk.mesn and 1==nachislchk.vidopl (noindex) )) );
             yes1  :=(RecordExists tNaryadchk where ((LSCHET.NREC   == tNaryadchk.clsch)) );

!           Message('yes1='+yes1+'|'+LSCHET.NREC);
!           exit;

           if islog=1
           {
!            efile.writeln('      52я входимость ='+if(yes52=0,'есть','отсутствует'));
            efile.writeln('1 вид оплаты(сделка) '+if(yes1=0,'есть','отсутствует'));
            efile.writeln('');
           }


           // цикл по начислениям...
           _loop tnachisl
           {
            yes52:=(getfirst tvidopl where ((tnachisl.vidopl == tvidopl.vidoplp)));
            dN:=tnachisl.datan;
            dK:=tnachisl.datok;
            //add 07022018 Если начисляем за будущий месяц, то поищем все все в текущем...
            if (tnachisl.mes>tnachisl.mesn and tnachisl.yearn=tnachisl.yeark)
            {
             dN:=date(01,tnachisl.mesn,tnachisl.yearn);
             dK:=date(last_day(dN),tnachisl.mesn,tnachisl.yearn);
            }
            sumnach:=tnachisl.summa;
            sumcalc :=0;
            chascalc:=0;
            delta_  :=0;
            delta_ch:=0;
            delta_dn:=0;
            daycalc :=0;
            sparam:='';

            if islog=1
             {
              efile.writeln('');
              efile.writeln(' начисление='+tnachisl.vidopl+if(yes52=0,'(входит','(не входит')+' в 52 вид входимости) На сумму :'+tnachisl.summa+' Дата начала='+dN+' Дата конца='+dK);
             }

             if not isvalid(#klvidopl)
             {
              if islog=1
               {
                efile.writeln('  Error не удалось найти соответствие в классификаторе оплат по виду оплаты :');
                continue;
               }
             }

            if klvidopl.vhv='-'
             continue;
            

             if klvidopl.VHVOE[36]='1' //Если Из классификатора видов оплат, то просто перенос...
             {
              sparam:='Переносим';

              if islog=1
               {
                efile.writeln('   Начисление='+''''+'Из классификатора видов оплат'+''''+'. Просто переносим.');
               }
               Insert_DopTable1;
             }
             else
              if Klvidopl.VHVOE[36]='2' //'Из лицевого счета работника'? , то не все так просто....
              {
               if islog=1
                {
                 efile.writeln('   Начисление='+''''+'Из лицевого счета работника'+'''');
                }

               if (yes52<>0 or (tnachisl.sisopl=20 and (tnachisl.vidopl=10 or tnachisl.vidopl=72 or tnachisl.vidopl=9 or tnachisl.vidopl=70 )) )
               {
                 if islog=1
                  efile.writeln('    Просто Перенос');

                  sparam:='Переносим';

                 if (tnachisl.CSCHETD='') //or nachisl.CSUBSCHD='')
                  if islog=1
                  {
!                    efile.writeln('  !!!Error Не задан '+if(nachisl.CSCHETD='' and nachisl.CSUBSCHD='','счет и субсчет в начислении',if(nachisl.CSCHETD='','счет в начислении','субсчет в начислении')));
                    efile.writeln('  !!!Error Не задан счет в начислении');
                  }

                if islog=1
                {
                 iserror:=true;
                 for(li1:=1;li1<6;li1++)
                 {
                  if (tnachisl.CKAUD[li1]<>0)
                  {
                   iserror:=false;
                   break;
                  }
                 }
                 if iserror
                  efile.writeln('  !!!Error Не определены аналитике в начислении');
                }

                 Insert_DopTable1;
               }
               else
               {
!                 if islog=1
!                  efile.writeln('    -Входит в 52ю входимость.Перенос');

                 if (yes1=0 and tnachisl.vidopl<>5) // входит в 52 и есть сделка --> распределяем по 1 ВОПЛ (точнее, по новым уточнениям по нарядам...)
                 {
                   sparam:='Распред-Сделка';

                   if tnachisl.tudasuda=1
                    if islog=1
                    efile.writeln('  По текущему табельному есть наряды по сдельной и повременной ВОПЛам !');
                    //efile.writeln('    Нашли нарядов по совпадению по датам на '+SumSdel1+ ' часов.');

                  if (tnachisl.tudasuda=1 and (SumSdel1>0 or SumSdel2>0))
                  {
                   if islog=1
                   {
                    efile.writeln('    База распределения - Сделка');
                    efile.writeln('    Нашли нарядов(2) по совпадению по датам на '+SumSdel1+ ' часов.')
                    efile.writeln('    Нашли нарядов(3) по совпадению по датам на '+SumSdel2+ ' часов.')
                   }

                   firsterr:=1;
                   if SumSdel1>0
                   {
                     _loop nachisl2
                    {
                     curkoef:=nachisl2.chasf/SumSdel1*100;

                     if islog=1
                       efile.writeln('   -Наряд(2) . Часов по наряду:'+nachisl2.chasf+'.Коээфициент:'+curkoef);

                     sum_high_precision :=  (tNachisl.summa*curkoef/100);
                     sumkoef  :=Round(sum_high_precision+delta_,2);
                     delta_   := delta_ + (sum_high_precision - sumkoef);

                     sum_high_precision_ch := (tNachisl.chasf*curkoef/100);

                     sumchasf   :=Round(sum_high_precision_ch+delta_ch,2);
                     delta_ch   := delta_ch + (sum_high_precision_ch - sumchasf);

                     sum_high_precision_dn := (tNachisl.koldn*curkoef/100);
                     sumday   :=Round(sum_high_precision_dn+delta_dn,2);
                     delta_dn   := delta_dn + (sum_high_precision_dn - sumday);

                     sumcalc:=sumcalc+sumkoef;
                     chascalc:=chascalc+sumchasf;
                     daycalc :=daycalc+sumday;

                     if islog=1
                      efile.writeln('          -Данное начисление. '+'.Начисленная сумма:'+DoubleToStr(tNachisl.summa,'[|-]\d$3666666666666.88888')+'.Сумма по коэффициенту:'+DoubleToStr(sumkoef,'[|-]\d$3666666666666.88888'));

                     if not ((abs(sumnach)-abs(sumcalc))<0)
                       Insert_DopTable31;
                     else
                     {
                      if firsterr=0
                      {
                       break;
                      }
                      else
                      {
                        Insert_DopTable31;
                        update current N1 set N1.summa:=N1.summa+(sumnach-sumcalc);
                        firsterr:=0;
                      }
                     }
                    }// _loop nachisl2

                   }//if SumSdel1>0

                   else
                   {
                     _loop nachisl3
                    {
                     curkoef:=nachisl3.chasf/SumSdel2*100;

                     if islog=1
                       efile.writeln('   -Наряд(3) . Часов по наряду:'+nachisl3.chasf+'.Коээфициент:'+curkoef);

                     sum_high_precision :=  (tNachisl.summa*curkoef/100);
                     sumkoef  :=Round(sum_high_precision+delta_,2);
                     delta_   := delta_ + (sum_high_precision - sumkoef);

                     sum_high_precision_ch := (tNachisl.chasf*curkoef/100);

                     sumchasf   :=Round(sum_high_precision_ch+delta_ch,2);
                     delta_ch   := delta_ch + (sum_high_precision_ch - sumchasf);

                     sum_high_precision_dn := (tNachisl.koldn*curkoef/100);
                     sumday   :=Round(sum_high_precision_dn+delta_dn,2);
                     delta_dn   := delta_dn + (sum_high_precision_dn - sumday);

                     sumcalc:=sumcalc+sumkoef;
                     chascalc:=chascalc+sumchasf;
                     daycalc :=daycalc+sumday;

                     if islog=1
                      efile.writeln('          -Данное начисление. '+'.Начисленная сумма:'+DoubleToStr(tNachisl.summa,'[|-]\d$3666666666666.88888')+'.Сумма по коэффициенту:'+DoubleToStr(sumkoef,'[|-]\d$3666666666666.88888'));

                     if not ((abs(sumnach)-abs(sumcalc))<0)
