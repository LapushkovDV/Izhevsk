         sqlFreeStr(stmt_str); 
         sqlFreeStmt(stmt);
*/
        
        setBounds(#n1);
        setBounds(#Nfot);

!        RebuildPanels;
         ReReadRecord(#tlschet);
         ReReadRecord(#N1);
         if not ConditionActiveInLeave(tccon1,tntformarks)//humancalc=0
          if getfirst tlschet=tsok  SetColumnTitle(BrwNach,#N1.summa,'Сумма по затратам '+chr(13)+GetSumColumn(tlschet.nrec));
         else
          if getfirst tlschet where ((humancalc == tlschet.nrec))=tsok SetColumnTitle(BrwNach,#N1.summa,'Сумма по затратам '+chr(13)+GetSumColumn(tlschet.nrec));


              if islog=1
               if (efile.GetSize)>1
              {
               eFile.Close;
               ProcessText (GetPathParameter('files', 'OutputFilesDirectory', 0)+'logcalczatr.txt',
                vfNewTitle Or vfMacroSize,
                'Протокол  расчета');
              }

      }



 CmValue1:{

           exit; //временно
      }


 CmValue2:{

        if Message('Внимание ! Будут модифицированы данные в Базе Данных '+chr(13)+
                   'Уверены, что продолжим ?',YesNo+Confirmation)<>CmYes
         {
          exit;
         }

        deletefile('c:\debug\GetFiltrZar.txt');

//        MtClear(#tperevod,fmNormal);

        MtClear(#tperevodmes,fmNormal);

         ReloadAllPer;
         ReloadAllNach;

              if islog=1
              {
               deletefile(GetPathParameter('files', 'OutputFilesDirectory', 0)+'logcalczatr.txt');
               eFile.OpenFile(GetPathParameter('files', 'OutputFilesDirectory', 0)+'logcalczatr.txt', stCreate);
              }


     dN1:=Date(1,pmes,pyearn);
     dN2:=Date(last_Day(dN1),pmes,pyearn);

!    if (not FillMarks) // Заполнение Formarks
!    {
!      abort;
!      exit;
!    }

    // загрузим все входимости 1 раз....
     ReLoadKlOpl;

    // загрузим все наряды за месяц
    mtClear(#tNaryad,fmNormal);
    sql select
//       nrec
       tabn
      ,strtabn
      ,vidopl
      ,mes
      ,min(prnaryad.datan) as datan
      ,max(prnaryad.datok) as datok
      ,Sum(prnaryad.chasf) as chasf // prnaryad.NrmTime as chasf
      ,Sum(prnaryad.summa) as summa
      ,koldn
      ,cschetd
      ,csubschd
      ,TBLD[1]
      ,TBLD[2]
      ,TBLD[3]
      ,TBLD[4]
      ,TBLD[5]
      ,TBLD[6]
      ,CKAUD[1]
      ,CKAUD[2]
      ,CKAUD[3]
      ,CKAUD[4]
      ,CKAUD[5]
      ,CKAUD[6]
      ,ckaud[3] as czak
      ,clsch
      ,tperson
    from prnaryad where prnaryad.datan>=:(dN1) and prnaryad.datok<=:(dN2) and prnaryad.vidopl in(1,7)
group by
       tabn
      ,strtabn
      ,vidopl
      ,mes
      ,koldn
      ,cschetd
      ,csubschd
      ,TBLD[1]
      ,TBLD[2]
      ,TBLD[3]
      ,TBLD[4]
      ,TBLD[5]
      ,TBLD[6]
      ,CKAUD[1]
      ,CKAUD[2]
      ,CKAUD[3]
      ,CKAUD[4]
      ,CKAUD[5]
      ,CKAUD[6]
      ,ckaud[3]
      ,clsch
      ,tperson
     into tNaryad byname;

     ResetBounds(#n1);
     ResetBounds(#nFot);

         if (Not InitTmpTable(ctmDynamicIndex))
           exit;

         ClearQuery(vliSQLCommand);
         sqlAddStr(vliSQLCommand, 'INSERT INTO selMarksLs');
         sqlAddStr(vliSQLCommand, '(');
         sqlAddStr(vliSQLCommand, '  nrec');
         sqlAddStr(vliSQLCommand, ')');

        firstrec:=1;

        if Verify(CntMarkLs) curcount:=CntMarkLs else curcount:=0;
//        Message('curcount='+curcount);
         StartNewVisual(vtIndicatorVisual,vfBreak+vftimer,
                       ''#3'Идет расчет .. ожидайте..'#13#3,curcount) ;

         _loop tformarks
        {
                    if not nextvisual
                    {
                    Message('Формирование отчета было прервано...переформируйте заново');
                    break;
                    }


          if isvalid(#lschet)
          {

!           delete novisual from N1 where (( lschet.nrec == N1.CLSCH));
!           delete novisual from nFot where (( lschet.nrec == nFot.CLSCH));
            delete novisual from nFot where (( lschet.nrec == nFot.CLSCH  and pyearn  == Nfot.yearn (noindex)   and pmes == Nfot.mesn  (noindex) ));


          if firstrec=1
           sqlAddStr(vliSQLCommand, 'select  #comp(' +lschet.nrec+ ')'+' from dual')
          else
           sqlAddStr(vliSQLCommand, 'union all select  #comp(' +lschet.nrec+ ')'+' from dual');

          if islog=1
           {
            efile.writeln('-----------------------------------------------------------------');
!            efile.writeln('Таб№'+lschet.tabn+' Всего часов по затратам:'+SumZatr);
            efile.writeln('Табельный№ '+lschet.strtabn+'('+lschet.nrec+')');
           }

!           //сразу посмотрим есть ли 52 оплаты по текущему табельному в нужном периоде
!           yes52:=(RecordExists nachislchk where ((LSCHET.NREC   == nachislchk.clsch and pyearn == nachislchk.yearn and pmes  == nachislchk.mesn and 52==nachislchk.vidopl (noindex) )) )
           //и тоже самое по 1 ВОПЛ
           //yes1  :=(RecordExists nachislchk where ((LSCHET.NREC   == nachislchk.clsch and pyearn == nachislchk.yearn and pmes  == nachislchk.mesn and 1==nachislchk.vidopl (noindex) )) );
             yes1  :=(RecordExists tNaryadchk where ((LSCHET.NREC   == tNaryadchk.clsch)) );

!           Message('yes1='+yes1+'|'+LSCHET.NREC);
!           exit;

           if islog=1
           {
!            efile.writeln('      52я входимость ='+if(yes52=0,'есть','отсутствует'));
            efile.writeln('1 вид оплаты(сделка) '+if(yes1=0,'есть','отсутствует'));
            efile.writeln('');
           }


           // цикл по начислениям...
           _loop tnachisl
           {
            yes52:=(getfirst tvidopl where ((tnachisl.vidopl == tvidopl.vidoplp)));
            dN:=tnachisl.datan;
            dK:=tnachisl.datok;
            sumnach:=tnachisl.summa;
            sumcalc :=0;
            chascalc:=0;
            delta_  :=0;
            delta_ch:=0;
            delta_dn:=0;
            daycalc :=0;

            if islog=1
             {
              efile.writeln('');
              efile.writeln(' начисление='+tnachisl.vidopl+if(yes52=0,'(входит','(не входит')+' в 52 вид входимости) На сумму :'+tnachisl.summa+' Дата начала='+dN+' Дата конца='+dK);
             }

             if not isvalid(#klvidopl)
             {
              if islog=1
               {
                efile.writeln('  Error не удалось найти соответствие в классификаторе оплат по виду оплаты :');
                continue;
               }
             }

            if klvidopl.vhv='-'
             continue;
            

              //нужно побить еще начисления на ФОТ....
              cz:=tnachisl.nrec;
              trec:=tnachisl.tiprec;
              if Verify(CntNachZakaz) {}

               efile.writeln('     ');
               efile.writeln('     Записей NachislZakaz='+CntNachZakaz);

               if CntNachZakaz=0
               {
                efile.writeln('        Не сформированы записи NachislZakaz по текущему nachisl. Недостаточно данных для формирования PerevodTekZakaz !');
                continue;
               }


              _loop tPerevodmes
              {
!               if isvalid(#tPerevodMes)
!               {
                delta_   :=0;
                sumcalc  :=0;

                if islog=1
                {
                 efile.writeln('     Начисление на ФОТ :'+tPerevodMes.sumper);
                }

                if CntNachZakaz=1
                {
                 _loop nN where ((cz == nN.CNACHISL and trec == nN.otkuda (noindex) )) 
                 {
                  Insert_DopTableFot1;
                 }
                }
                else
                 if CntNachZakaz>1
                {

                 firsterr:=1;
                 _loop nN where ((cz == nN.CNACHISL and trec == nN.otkuda (noindex) )) 
                 {

                  curkoefp:=nN.summa/tNachisl.summa*100;

                  sum_high_precision :=  (tPerevodMes.sumper*curkoefp/100);
                  sumkoefp  :=Round(sum_high_precision+delta_,13);
                  delta_   := delta_ + (sum_high_precision - sumkoefp);

                  sumcalc :=sumcalc+sumkoefp;

                  if islog=1
                   efile.writeln('          -Данное начисление.Сумма:'+DoubleToStr(nN.summa,'[|-]\d$3666666666666.88888888888')+'.Сумма по коэффициенту:'+DoubleToStr(sumkoefp,'[|-]\d$3666666666666.88888')+'.Часов по коэфф:'+DoubleToStr(sumchasf,'[|-]\d$3666666666666.88888888888')+'.Delta by current record:'+DoubleToStr(delta_,'[|-]\d$3666666666666.888888888'));

                    if not ((abs(sumnach)-abs(sumcalc))<0)
                      Insert_DopTableFot2;
                    else
                    {
                      if firsterr=0
                      {
                       break;
                      }
                      else
                      {
                        Insert_DopTableFot2;
                        update current nFot set nFot.sumper:=nFot.sumper+(sumnach-sumcalc);
                        firsterr:=0;
                      }
                    }


                 }
                 efile.writeln('          -last delta='+DoubleToStr(delta_,'[|-]\d$3666666666666.8888888888888'));
                 if delta_<>0
                  update current nFot set nFot.sumper:=nFot.sumper+delta_;
                }

!               }
              }

           }


          }
          firstrec:=0;
        }

              StopVisual('',0);

        li1:=sqlExecDirect(vliSQLCommand);

        MtClear(#tlschet,fmNormal);

        stmt := sqlAllocStmt;
        sqlAddStr(stmt_str,'select ');
        sqlAddStr(stmt_str,'      l.nrec  ');
        sqlAddStr(stmt_str,'     ,l.tabn  ');
        sqlAddStr(stmt_str,'     ,l.strtabn  ');
        sqlAddStr(stmt_str,'     ,l.tperson  ');
        sqlAddStr(stmt_str,'     ,l.cex  ');
        sqlAddStr(stmt_str,'     ,l.cpodr  ');
        sqlAddStr(stmt_str,'     ,p.fio  ');
        sqlAddStr(stmt_str,'  from     ');
        sqlAddStr(stmt_str,'    (   ');
        sqlAddStr(stmt_str,'      select ');
        sqlAddStr(stmt_str,'        distinct ');
        sqlAddStr(stmt_str,'         clsch');
!        sqlAddStr(stmt_str,'        from nachislzakaz');
        sqlAddStr(stmt_str,'        from nachisl');
        sqlAddStr(stmt_str,'         where mesn=? and yearn=?');
        sqlAddStr(stmt_str,'     )t1 inner join lschet l on t1.clsch=l.nrec');
        sqlAddStr(stmt_str,'         inner join persons p on l.tperson=p.nrec');
        sqlAddStr(stmt_str,'         inner join selMarksLs sel on l.nrec = sel.nrec ');
!        sqlAddStr(stmt_str,'       ');
!        sqlAddStr(stmt_str,'       ');

        sqlBindparam(stmt,1,pmes);
        sqlBindparam(stmt,2,pyearn);
        sqlPrepare(stmt,stmt_str);

        li1:=sqlExecute(stmt);

        if (sqlFetchInto(stmt,#tlschet) != tsOk)
   	      Message('not tsOk select (');

         sqlFreeStr(stmt_str); 
         sqlFreeStmt(stmt);
        
        setBounds(#n1);
        setBounds(#Nfot);

!        RebuildPanels;
         ReReadRecord(#tlschet);
         ReReadRecord(#N1);
