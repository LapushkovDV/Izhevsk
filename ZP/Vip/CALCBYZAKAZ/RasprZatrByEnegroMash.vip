                      if (PrVidopl.CSCHETD='') //or PrVidopl.CSUBSCHD='')
                       if islog=1
                       {
                        efile.writeln('  !!!Error в данном распределении затрат не задан счет');
                       }

                        if islog=1
                        {
                         iserror:=true;
                         for(li1:=1;li1<6;li1++)
                         {
                          if (PrVidopl.CKAUD[li1]<>0)
                          {
                           iserror:=false;
                           break;
                          }
                         }
                         if iserror
