                       break;
                      }
                      else
                      {
                        Insert_DopTable2;
                        update current N1 set N1.summa:=N1.summa+(sumnach-sumcalc);
                        firsterr:=0;
                      }
                    }


                   }
                  efile.writeln('После всего sumnach='+DoubleToStr(sumnach,'[|-]\d$3666666666666.88888')+'|sumcalc='+DoubleToStr(sumcalc,'[|-]\d$3666666666666.88888')+' delta='+DoubleToStr(sumnach-sumcalc,'[|-]\d$3666666666666.88888'));

                  if (sumnach-sumcalc)<>0
