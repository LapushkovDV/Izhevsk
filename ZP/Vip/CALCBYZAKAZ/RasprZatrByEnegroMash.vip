Function CntMainPlan : longint;
{
 var cntplan: longint;

  Result  :=0;
  cntplan :=0;

  sql select count( *) from  nachislzakaz n
        inner join mnplan on n.tbld[1]=mnplan.nrec
        inner join vplan on mnplan.cvplan = vplan.nrec
        //and vplan.name in ('Факел-2','Ангара','Нафтил','Форсаж')
        // мля ... убираем костыль
        join attrnam aN ON an.wtable =31015
                       and an.name = 'Банковские счета'
        join attrval av on av.cAttrnam = an.nrec
                       and av.crec = vplan.nrec
        join KatBank kb on kb.nrec = av.vcomp
        join attrnam aNigk ON anigk.wtable =1421
                       and anigk.name = 'Ссылка на ИГК'
        join attrval avigk on avigk.cAttrnam = anigk.nrec
                     and avigk.crec = kb.nrec
                     and coalesce(avigk.vcomp,#comp(0)) <> #comp(0)
     where n.clsch=:(lschet.nrec) and n.yearn=:(pyearn) and n.mesn=:(pmes) and n.tbld[1]=7

  into (cntplan)
  ;

  Result:=cntplan;
}


Procedure SetViewMode(pwVM : word);
{

  if ( wViewMode = 0 )
    {
!      Message('Режим начислений на ФОТ еще дорабатывается');
!      exit;
      SetFormat(BrwNachFot);
      RescanPanel(#Nfot);
    }
  else
    {
      SetFormat(BrwNach);
      RescanPanel(#N1);
    }

  wViewMode := pwVM XOR 1 ;
}


Procedure ReloadMarksbyLs;
{
  MtClear(#tFormarks,fmNormal);
  Marker := InitMarker('SelMyLs', 8, 200, 100) ;
  if GetMarkerCount(Marker)>0
   for(i:=0;i<=GetMarkerCount(Marker);i++)
   {
     if GetMarker(Marker,i,nrecn)
      Insert tFormarks set tFormarks.choice:=_cLSchet , tFormarks.cpodr:=nrecn;
   }
  DoneMarker(Marker,'SelMyLs');  
}

Procedure ReLoadMarkbyPodr;
{
  MtClear(#tFormarks,fmNormal);

  FOR (
        Stat := GetFirst Pick where ((word(11) == Pick.wList));
        Stat  = tsOk;
        Stat := GetNext  Pick where ((word(11) == Pick.wList))
       )
 {
!   if pick.crec=isklpodr
!    continue;
   _loop lschet1 where ((Pick.cRec == lschet1.cex /*and (lschet1.cex<>isklpodr)*/ ))  
   {
     Insert tFormarks set tFormarks.choice:=_cLSchet , tFormarks.cpodr:=lschet1.nrec;
   }
 }

}

Procedure ReLoadMarkbyAll;
{
  MtClear(#tFormarks,fmNormal);

!   _loop lschet1
!   {
!     Insert tFormarks set tFormarks.choice:=_cLSchet , tFormarks.cpodr:=lschet1.nrec;
!   }
  sql select
    nrec as cpodr
   ,Cast(0 as word) as choice
  from lschet
   into tFormarks byName;
}

Procedure ReLoadtmp;
{

       if (Not InitTmpTable(ctmDynamicIndex))
          exit;

         ClearQuery(vliSQLCommand);
         sqlAddStr(vliSQLCommand, 'INSERT INTO selMarksLs');
         sqlAddStr(vliSQLCommand, '(');
         sqlAddStr(vliSQLCommand, '  nrec');
         sqlAddStr(vliSQLCommand, ')');

        firstrec:=1;

        StartNewVisual(vtRotateVisual, vfTimer+vfBreak,
                         ''#3'Предварительная загрузка данных.'#13#3,1);


        _loop tformarks
        {
!         Message('tformarks.CPODR='+tformarks.CPODR);
         if isvalid(#lschet)
         {
!           Message('if isvalidall');
!          logstrtofile('c:\debug\GetFiltrZarInit.txt',lschet.tabn);

          if firstrec=1
           sqlAddStr(vliSQLCommand, 'select  #comp(' +lschet.nrec+ ')'+' from dual')
          else
           sqlAddStr(vliSQLCommand, 'union all select  #comp(' +lschet.nrec+ ')'+' from dual');
         }
          firstrec:=0;
        }

        StopVisual('',0);        

        li1:=sqlExecDirect(vliSQLCommand);

        MtClear(#tlschet,fmNormal);

        stmt := sqlAllocStmt;
        sqlAddStr(stmt_str,'select ');
        sqlAddStr(stmt_str,'      l.nrec  ');
        sqlAddStr(stmt_str,'     ,l.tabn  ');
        sqlAddStr(stmt_str,'     ,l.strtabn  ');
        sqlAddStr(stmt_str,'     ,l.tperson  ');
        sqlAddStr(stmt_str,'     ,l.cex  ');
        sqlAddStr(stmt_str,'     ,l.cpodr  ');
        sqlAddStr(stmt_str,'     ,p.fio  ');
        sqlAddStr(stmt_str,'  from     ');
        sqlAddStr(stmt_str,'    (   ');
        sqlAddStr(stmt_str,'      select ');
        sqlAddStr(stmt_str,'        distinct ');
        sqlAddStr(stmt_str,'         clsch');
!        sqlAddStr(stmt_str,'        from nachisl');
        sqlAddStr(stmt_str,'        from '+if(flagArh=False,'nachisl','sumvidop'));
        sqlAddStr(stmt_str,'         where mesn=? and yearn=?');
        sqlAddStr(stmt_str,'     )t1 inner join lschet l on t1.clsch=l.nrec');
        sqlAddStr(stmt_str,'         inner join persons p on l.tperson=p.nrec');
        sqlAddStr(stmt_str,'         inner join selMarksLs sel on l.nrec = sel.nrec ');
!        sqlAddStr(stmt_str,'       ');
!        sqlAddStr(stmt_str,'       ');

        sqlBindparam(stmt,1,pmes);
        sqlBindparam(stmt,2,pyearn);
        sqlPrepare(stmt,stmt_str);

        li1:=sqlExecute(stmt);

        if (sqlFetchInto(stmt,#tlschet) != tsOk)
   	      Message('not tsOk select (');

         sqlFreeStr(stmt_str); 
         sqlFreeStmt(stmt);
}

Procedure ReloadAllNach;
{
 
  StartNewVisual(vtRotateVisual, vfTimer+vfBreak,
                    ''#3'Предварительная загрузка всех начислений.'#13#3,1);

//  Message('flagArh='+flagArh);

  mtClear(#tNachisl,fmNormal);
  if (not flagArh)
  {

    sql
     select
        n.nrec
       ,n.CEX    
       ,n.CEXOZ  
       ,n.CPODR  
       ,n.MES    
       ,n.MESN   
       ,n.YEARN  
       ,n.VIDOPL 
       ,n.KATEG  
!       ,n.DATAN  
!       ,n.DATOK
       ,Case  When (notes.nrec is not null and notes.nrec=:(closenote) and n.mes<n.mesn)
            then :(dN1)
            else n.DATAN
        end as datan
       ,Case  When (notes.nrec is not null and notes.nrec=:(closenote) and n.mes<n.mesn)
            then :(dN2)
            else n.DATOK
        end as datok
       ,n.KOLDN  as KOLDN
!     ,n.CHASF  
       ,Case When prnaryad.nrec is not null then
          Case When
             Round(n.summa,2)=Round(prnaryad.summprem,2) then Cast(0 as Double)
             else n.CHASF
          end
         else n.CHASF
       end as CHASF
       ,n.SUMMA as SUMMA
       ,n.CSCHETD 
       ,n.CSUBSCHD
       ,n.CKAUD[1]
       ,n.CKAUD[2]
       ,n.CKAUD[3]     
       ,n.CKAUD[4]
       ,n.CKAUD[5]
       ,n.CKAUD[6] 
       ,n.TBLD[1]
       ,n.TBLD[2]
       ,n.TBLD[3]
       ,n.TBLD[4]
       ,n.TBLD[5]
       ,n.TBLD[6]
       ,n.CSCHETK  
       ,n.CSUBSCHK 
       ,n.CKAUD[1]
       ,n.CKAUD[2]
       ,n.CKAUD[3]     
       ,n.CKAUD[4]
       ,n.CKAUD[5]
       ,n.CKAUD[6] 
       ,n.TBLK[1]
       ,n.TBLK[2]
       ,n.TBLK[3]
       ,n.TBLK[4]
       ,n.TBLK[5]
       ,n.TBLK[6]
       ,n.CLSCH  
       ,n.TPERSON
       ,n.SISOPL 
       ,n.CODTAR 
       ,n.RAZR   
       ,n.VIDOPLS
       ,n.DATAV  
       ,n.MESV   
       ,n.YEARV  
       ,n.YEARK  
       ,n.KOLDNGR
       ,n.CHASGR 
       ,n.STRTABN
       ,n.KAUEXTR[1]
       ,n.KAUEXTR[2]
       ,n.KAUEXTR[3]
       ,n.KAUEXTR[4]
       ,n.KAUEXTR[5]
       ,n.KAUEXTR[6]
       ,n.TBLEXTR[1]
       ,n.TBLEXTR[2]
       ,n.TBLEXTR[3]
       ,n.TBLEXTR[4]
       ,n.TBLEXTR[5]
       ,n.TBLEXTR[6]
       ,Cast('0' as String) as tiprec
       ,Coalesce(atr.vcomp,#comp(0)) as isklpodr
       ,Case When (notes.nrec is not null and notes.nrec=:(closenote) and n.mes<n.mesn)
         then 1
         else 0
        end as closenach
       ,Case When tNar.strtabn is not null then 1 else 0 end as tudasuda
      from nachisl n 
                     outer apply
                     (
                      select
                         nar.strtabn
                      from prnaryad nar
                        where n.clsch=nar.clsch and nar.datan>=:(dN1) and nar.datok<=:(dN2) and nar.vidopl in (1,7)
                      group by
                        nar.strtabn
                        having count(distinct nar.vidopl)>1
                     ) tNar

                     left join prnaryad on Case When n.vidopl in(1,9,10) then n.cpodr else #comp(-1) end = prnaryad.nrec
                     left join attrval atr on n.cexoz=atr.crec and atr.wtable=1413 and atr.cattrnam=:(atr_vid_manuf) and atr.vcomp in(:(NrecIskPodr1),:(NrecIskPodr2))
                     left join mnplan on Case when n.tbld[1]=7 then n.ckaud[1]
                                              when n.tbld[2]=7 then n.ckaud[2]
                                              when n.tbld[3]=7 then n.ckaud[3]
                                              when n.tbld[4]=7 then n.ckaud[4]
                                              when n.tbld[5]=7 then n.ckaud[5]
                                              when n.tbld[6]=7 then n.ckaud[6]
                                              else #comp(0)
                                          end  = mnplan.nrec
                     left join katnotes notes on mnplan.cstatus = notes.nrec
       where n.yearn=:(pyearn) and n.mesn=:(pmes)


      union
     select
        n.nrec   
       ,n.CEX    
       ,n.CEXOZ  
       ,n.CPODR  
       ,n.MES    
       ,n.MESN   
       ,n.YEARN  
       ,n.VIDOPL 
       ,n.KATEG  
       ,n.DATAN  
       ,n.DATOK  
       ,n.KOLDN  
       ,n.CHASF  
       ,n.SUMMA  
       ,n.CSCHETD 
       ,n.CSUBSCHD
       ,n.CKAUD[1]
       ,n.CKAUD[2]
       ,n.CKAUD[3]     
       ,n.CKAUD[4]
       ,n.CKAUD[5]
       ,n.CKAUD[6] 
       ,n.TBLD[1]
       ,n.TBLD[2]
       ,n.TBLD[3]
       ,n.TBLD[4]
       ,n.TBLD[5]
       ,n.TBLD[6]
       ,n.CSCHETK  
       ,n.CSUBSCHK 
       ,n.CKAUD[1]
       ,n.CKAUD[2]
       ,n.CKAUD[3]     
       ,n.CKAUD[4]
       ,n.CKAUD[5]
       ,n.CKAUD[6] 
       ,n.TBLK[1]
       ,n.TBLK[2]
       ,n.TBLK[3]
       ,n.TBLK[4]
       ,n.TBLK[5]
       ,n.TBLK[6]
       ,n.CLSCH  
       ,n.TPERSON
       ,n.SISOPL 
       ,n.CODTAR 
       ,n.RAZR   
       ,n.VIDOPLS
       ,n.DATAV  
       ,n.MESV   
       ,n.YEARV  
       ,n.YEARK  
       ,n.KOLDNGR
       ,n.CHASGR 
       ,n.STRTABN
       ,n.KAUEXTR[1]
       ,n.KAUEXTR[2]
       ,n.KAUEXTR[3]
       ,n.KAUEXTR[4]
       ,n.KAUEXTR[5]
       ,n.KAUEXTR[6]
       ,n.TBLEXTR[1]
       ,n.TBLEXTR[2]
       ,n.TBLEXTR[3]
       ,n.TBLEXTR[4]
       ,n.TBLEXTR[5]
       ,n.TBLEXTR[6]
       ,Cast('1' as String) as tiprec
       ,Coalesce(atr.vcomp,#comp(0)) as isklpodr
       ,Cast(0 as Word) as closenach
       ,Cast(0 as Word) as tudasuda
      from NeNach n
             left join attrval atr on n.cexoz=atr.crec and atr.wtable=1413 and atr.cattrnam=:(atr_vid_manuf) and atr.vcomp in(:(NrecIskPodr1),:(NrecIskPodr2))
       where n.yearn=:(pyearn) and n.mesn=:(pmes)
      into tNachisl byName;
   }
   else
   {
    sql
     select
        n.nrec   
       ,n.CEX    
       ,n.CEXOZ  
       ,n.CPODR  
       ,n.MES    
       ,n.MESN   
       ,n.YEARN  
       ,n.VIDOPLP as VIDOPL
!       ,Cast(0 as word) as KATEG  
       ,n.kateg
       ,n.DATAN  
!       ,n.DATOK  
!       ,n.KOLDN  
       ,Case  When (notes.nrec is not null and notes.nrec=:(closenote) and n.mes<n.mesn)
            then :(dN1)
            else n.DATAN
        end as datan
       ,Case  When (notes.nrec is not null and notes.nrec=:(closenote) and n.mes<n.mesn)
            then :(dN2)
            else n.DATOK
        end as datok
!     ,n.CHASF  
       ,Case When prnaryad.nrec is not null then
          Case When
             Round(n.summa,2)=Round(prnaryad.summprem,2) then Cast(0 as Double)
             else n.CHASF
          end
         else n.CHASF
       end as CHASF
       ,n.SUMMA  
       ,n.CSCHETD 
       ,n.CSUBSCHD
       ,n.CKAUD[1]
       ,n.CKAUD[2]
       ,n.CKAUD[3]     
       ,n.CKAUD[4]
       ,n.CKAUD[5]
       ,n.CKAUD[6] 
       ,n.TBLD[1]
       ,n.TBLD[2]
       ,n.TBLD[3]
       ,n.TBLD[4]
       ,n.TBLD[5]
       ,n.TBLD[6]
       ,n.CSCHETK  
       ,n.CSUBSCHK 
       ,n.CKAUK[1]
       ,n.CKAUK[2]
       ,n.CKAUK[3]     
       ,n.CKAUK[4]
       ,n.CKAUK[5]
       ,n.CKAUK[6] 
       ,n.TBLK[1]
       ,n.TBLK[2]
       ,n.TBLK[3]
       ,n.TBLK[4]
       ,n.TBLK[5]
       ,n.TBLK[6]
       ,n.CLSCH  
       ,n.TPERSON
       ,n.SISOPL 
       ,Cast(0 as word) as CODTAR//n.CODTAR 
       ,Cast(0 as word) as RAZR//n.RAZR   
       ,n.VIDOPL as VIDOPLS
       ,n.DATAV  
       ,n.MESV   
       ,n.YEARV  
       ,n.YEARK  
       ,n.KOLDNGR
       ,n.CHASGR 
       ,n.STRTABN
       ,n.KAUEXTR[1]
       ,n.KAUEXTR[2]
       ,n.KAUEXTR[3]
       ,n.KAUEXTR[4]
       ,n.KAUEXTR[5]
       ,n.KAUEXTR[6]
       ,n.TBLEXTR[1]
       ,n.TBLEXTR[2]
       ,n.TBLEXTR[3]
       ,n.TBLEXTR[4]
       ,n.TBLEXTR[5]
       ,n.TBLEXTR[6]
       ,Cast('2' as String) as tiprec
       ,Coalesce(atr.vcomp,#comp(0)) as isklpodr
       ,Case When (notes.nrec is not null and notes.nrec=:(closenote) and n.mes<n.mesn)
         then 1
         else 0
        end as closenach
       ,Case When tNar.strtabn is not null then 1 else 0 end as tudasuda
      from Sumvidop n 
                     outer apply
                     (
                      select
                         nar.strtabn
                      from prnaryad nar
                        where n.clsch=nar.clsch and nar.datan>=:(dN1) and nar.datok<=:(dN2) and nar.vidopl in (1,7)
                      group by
                        nar.strtabn
                        having count(distinct nar.vidopl)>1
                     ) tNar

                      left join prnaryad on Case When n.vidoplp in(1,9,10) then n.cpodroz else #comp(-1) end = prnaryad.nrec
                      left join attrval atr on n.cexoz=atr.crec and atr.wtable=1413 and atr.cattrnam=:(atr_vid_manuf) and atr.vcomp in(:(NrecIskPodr1),:(NrecIskPodr2))//and (atr.vcomp=:(NrecIskPodr1) or atr.vcomp=:(NrecIskPodr2))//
                      left join mnplan on Case when n.tbld[1]=7 then n.ckaud[1]
                                              when n.tbld[2]=7 then n.ckaud[2]
                                              when n.tbld[3]=7 then n.ckaud[3]
                                              when n.tbld[4]=7 then n.ckaud[4]
                                              when n.tbld[5]=7 then n.ckaud[5]
                                              when n.tbld[6]=7 then n.ckaud[6]
                                              else #comp(0)
                                          end  = mnplan.nrec
                     left join katnotes notes on mnplan.cstatus = notes.nrec
       where n.yearn=:(pyearn) and n.mesn=:(pmes) 
      union
     select
        n.nrec   
       ,n.CEX    
       ,n.CEXOZ  
       ,n.CPODR  
       ,n.MES    
       ,n.MESN   
       ,n.YEARN  
       ,n.VIDOPL 
       ,n.KATEG  
       ,n.DATAN  
       ,n.DATOK  
       ,n.KOLDN  
       ,n.CHASF  
       ,n.SUMMA  
       ,n.CSCHETD 
       ,n.CSUBSCHD
       ,n.CKAUD[1]
       ,n.CKAUD[2]
       ,n.CKAUD[3]     
       ,n.CKAUD[4]
       ,n.CKAUD[5]
       ,n.CKAUD[6] 
       ,n.TBLD[1]
       ,n.TBLD[2]
       ,n.TBLD[3]
       ,n.TBLD[4]
       ,n.TBLD[5]
       ,n.TBLD[6]
       ,n.CSCHETK  
       ,n.CSUBSCHK 
       ,n.CKAUD[1]
       ,n.CKAUD[2]
       ,n.CKAUD[3]     
       ,n.CKAUD[4]
       ,n.CKAUD[5]
       ,n.CKAUD[6] 
       ,n.TBLK[1]
       ,n.TBLK[2]
       ,n.TBLK[3]
       ,n.TBLK[4]
       ,n.TBLK[5]
       ,n.TBLK[6]
       ,n.CLSCH  
       ,n.TPERSON
       ,n.SISOPL 
       ,n.CODTAR 
       ,n.RAZR   
       ,n.VIDOPLS
       ,n.DATAV  
       ,n.MESV   
       ,n.YEARV  
       ,n.YEARK  
       ,n.KOLDNGR
       ,n.CHASGR 
       ,n.STRTABN
       ,n.KAUEXTR[1]
       ,n.KAUEXTR[2]
       ,n.KAUEXTR[3]
       ,n.KAUEXTR[4]
       ,n.KAUEXTR[5]
       ,n.KAUEXTR[6]
       ,n.TBLEXTR[1]
       ,n.TBLEXTR[2]
       ,n.TBLEXTR[3]
       ,n.TBLEXTR[4]
       ,n.TBLEXTR[5]
       ,n.TBLEXTR[6]
       ,Cast('1' as String) as tiprec
       ,Coalesce(atr.vcomp,#comp(0)) as isklpodr
       ,Cast(0 as Word) as closenach
       ,Cast(0 as Word) as tudasuda
      from NeNach n
        left join attrval atr on n.cexoz=atr.crec and atr.wtable=1413 and atr.cattrnam=:(atr_vid_manuf) and atr.vcomp in(:(NrecIskPodr1),:(NrecIskPodr2))
       where n.yearn=:(pyearn) and n.mesn=:(pmes) 
      into tNachisl byName;
   }
     StopVisual('',0);        

