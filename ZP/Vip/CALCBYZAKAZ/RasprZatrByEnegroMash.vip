var  oExAttr  : iExtAttr;

 Function GetSumColumn (c : comp) : double; forward;
 Function GetAnotherPrvd (l : comp) : double; Forward;
 Function GetAnotherPrvd_970 (l : comp) : double; Forward;
 Function GetSumNar  (l : comp) : double; Forward;
 Function GetSumNar1 (l : comp ; d1 : date ; d2 : date) : double; Forward;
 Function GetSumNar2 (l : comp ; d1 : date ; d2 : date) : double; Forward;

 create view
  var
   oIGK_Dog: iIGK_Dog;
   filtr : word;
   firstrec,li1,islog,stat,i,cntnar : integer ;
   stmt,stmt_str,vliSQLCommand,countPickPodr,Marker : LongInt ; 
   pmes,pmes_ : word ;
   pyearn,pyearn_ : integer;
   dN,dK,dN1,dN2 : date ;
   curkoef,curkoef7 : double;
   sumkoef : double;
   sumkoefp,curkoefp : decimal(31,15);
   yes52,yes1,curcount,firsterr : integer;
!   dper1,dper2 : date;
   sumnach,sumcalc,delta_,sum_high_precision,delta_ch,delta_dn,sum_high_precision_ch,sum_high_precision_dn : decimal(31,15);
   chascalc,daycalc,sumchasf,sumday : double;
   wViewMode : word;
   cz,pl: comp;
   codplan : string[1];
   level_c,err_ls1 : integer ;
   czak_c,nrecn,isklpodr,LSCHETNREC  : comp    ;
   FiltrPodr,FiltrLs : string;
   iserror : boolean;

   aFileName : string  ;
   XlRes : boolean;
   row : longint;
   trec : string[1];

   cursch_,cursub_: string[20];
   cfnc,onematr,rowmatrx,counter : longint;
   yesbrk : boolean;
   Filepath : string;
   zak64,zak68 : comp ;
   sch64,subsch64,sch68,subsch68,sparam : string[20];
   sum64 : decimal(31,15);
   NoCaclFot : integer;
   humancalc,NrecIskPodr1,NrecIskPodr2,atr_vid_manuf,closenote: comp;
   flagArh,IsNoGosinAvans : boolean;
   _tiprec : string[1] ;
   dvalue: double;
   NMarker: longint;
   dmark : word;
   SumSdelV : double; 
    nrec555  : comp ;
!   sp_main : boolean;

!(
!FiltrPodr,
!FiltrPublic
!)
  as select
!     PAF.GetDepartmentFilterStr,
!     PAF.GetPersonalAccountFilterStr,
!     ZAR_USER.GRUPSTN,
   GetAnotherPrvd(LSCHET.NREC) (fieldname=SumZatrDop)
  ,GetAnotherPrvd_970(LSCHET.NREC) (fieldname=SumZatrDop_970)
  ,GetSumNar(LSCHET.NREC) (fieldname=SumSdel)
  ,GetSumNar1(LSCHET.NREC,tnachisl.datan,tnachisl.datok) (fieldname=SumSdel1)
  ,GetSumNar2(LSCHET.NREC,tnachisl.datan,tnachisl.datok) (fieldname=SumSdel2)
  ,if(isvalid(tnkatpodr1),substr(katpodr1.kod,1,3)+'-'+katpodr.name,'не определено') (fieldname=KodNamePodr)
  //, *
  from 
    Zar_User
  , LSCHET
  , LSCHET LSCHET1
  , tFormarks 
  , tlschet(in4)
  , persons
  , persons persons1
  , katpodr
  , katpodr katpodr1
  , katpodr katpodrchk
  , catalogs dolj
  , nachislzakaz
  , nachislzakaz n1
  , nachislzakaz n2
  , nachislzakaz n3
  , nachislzakaz nN
  , tnachisl
  //, nachisl
!  , nachisl nachislchk
!  , nachisl nachisl1
!  , tperevod
  , klvidopl
  , klvidopl kl
  , KlVidopl KlVidoplp
  , tvidopl
  , prvidopl
  , PrVidopl PrVidoplSdop
//  , PerevodTek
  , tperevodmes
  , PerevodTekzakaz NFot
!  , PerevodTekzakaz
  , Perech
  , tplan
  , tNaryad
  , tNaryad tNaryadchk
  , tNaryad nachisl1
  , tNaryad nachisl2
  , tNaryad nachisl3
  , tNaryad tNaryadf
  , tgp_raspvo
  , Vplan
  , Vplan vplanNfot
  , MNPLAN
  , Mnplan MnplanGr
  , PICK
  , PlanSsch
  , KatKau
  , Spkau
  , KatNotes
  , Gp_RaspAvans
  , tvplan
  , katpodr podrzatz

  ,(select Sum(PrVidoplS.chasf) (fieldname=SumZatr) from PrVidopl PrVidoplS
       where ((word(18)==PrVidoplS.choice and LSCHET.NREC  == PrVidoplS.clsch and dN == PrVidoplS.Dataf (noindex) and dK==PrVidoplS.Datok (noindex) )) )

!  ,(select Sum(PrVidoplSdop.chasf) (fieldname=SumZatrDop) from PrVidopl PrVidoplSdop
!       where ((word(18)==PrVidoplSdop.choice and LSCHETNREC  == PrVidoplSDop.clsch and dN1<<= PrVidoplSDop.Dataf (noindex) and dN2>>=PrVidoplSDop.Datok (noindex)
!                 and ( (PrVidoplSDop.Dataf<dN and PrVidoplSDop.Datok>=dk) or ( PrVidoplSDop.Dataf=dN and PrVidoplSDop.Datok>dk ) )
!             ))
!   )

  ,(select Sum(NachislS.Chasf) (fieldname=SumSdel7) from tNachisl NachislS
       where ((LSCHET.NREC   == nachislS.clsch and pyearn == nachislS.yearn and pmes  == nachislS.mesn and 7==nachislS.vidopls (noindex) )) )

  ,(select Sum(NachislTot.Summa) (fieldname=SumTotal) from tNachisl NachislTot
       where ((TLSCHET.NREC   == nachislTot.clsch and pyearn == nachislTot.yearn and pmes  == nachislTot.mesn and _tiprec == nachislTot.tiprec (noindex))) )

  ,(select count( *) (fieldname=CntMarkLs) from tFormarks)  

  ,(select count( *) (fieldname=CntNachZakaz) from nachislzakaz nachislzakaz3 where (( cz == nachislzakaz3.cnachisl and trec == nachislzakaz3.otkuda (noindex) ))  )

!  ,(select Sum(tNaryad.Chasf) (fieldname=SumSdel) from tNaryad where ((LSCHET.NREC   ==  tNaryad.clsch)) and /*FoundMarker(nMarker,tNaryad.vidopl)=true*/ SearchMarker(nMarker,tNaryad.vidopl,indxmark)=true )

  where
  ((
     UserName == Zar_User.OwnName
  and _clschet == tformarks.CHOICE
  and tformarks.cpodr == LSCHET.NREC

  and LSCHET.NREC   == tnachisl.clsch
  and pyearn        == tnachisl.yearn
  and pmes          == tnachisl.mesn
  and tnachisl.vidopls == klvidopl.vidopl
!   and (nachisl.vhv<>'-')

  and lschet.cex    == katpodr1.nrec
  and lschet.tperson == persons1.nrec
  and lschet.cappoint == dolj.nrec

  and word(18)     == PrVidopl.choice 
  and LSCHET.NREC  == PrVidopl.clsch
!  and dN1          == PrVidopl.Datan (noindex)
!  and dN1          <<= PrVidopl.Datan (noindex)

!  and tnachisl.tiprec == tperevod.otkuda
!  and tnachisl.nrec  == tperevod.cnach 

!  and tperevod.nrec  == tperevodmes.nrec//PerevodTek.nrec

  and tnachisl.tiprec == tperevodmes.otkuda
  and tnachisl.nrec  == tperevodmes.cnach 

  and tlschet.tperson == persons.nrec
  and tlschet.cex     == katpodr.nrec
  and tlschet.nrec    == n1.CLSCH
  and pyearn          == n1.yearn
  and pmes            == n1.mesn
  and n1.vidopls      == kl.vidopl
  and n1.CKAUD[1]     == MnplanGr.nrec
  and n1.cexoz        == podrzatz.nrec
  and mnPlanGr.cvplan == vplan.nrec

  and tlschet.nrec    == Nfot.clsch
  and pyearn          == Nfot.yearn (noindex)
  and pmes            == Nfot.mesn  (noindex)
  and nFot.VidPer     == Perech.VidPer
  and nFot.VidOpls  == KlVidOplp.VidOpl

  and nFot.KAUEXTR[1] == vplanNfot.nrec

/*
  and LSCHET.NREC   == nachisl1.clsch
  and pyearn        == nachisl1.yearn
  and pmes          == nachisl1.mesn
   and 1            == nachisl1.vidopl (noindex)
*/
  and LSCHET.NREC   == nachisl1.clsch
   and ( FoundMarker(nMarker,nachisl1.vidopl)=true )

  and LSCHET.NREC   == nachisl2.clsch
  and  (       dN           <= nachisl2.datan
         and   dK           >= nachisl2.datok)

  and LSCHET.NREC   == nachisl3.clsch
  and  (       dN           >= nachisl3.datan
         and   dK           <= nachisl3.datok)


  and lschet.nrec    == n3.CLSCH
  and pyearn          == n3.yearn
  and pmes            == n3.mesn

  ))

!  ordered 
   Condition Con1= tformarks.cpodr=humancalc

  ;

file efile;

!#include PAFILTER.VPP
#include crt2.vpp
#include zatrfuncs.vpp

 Function GetSumColumn (c : comp) : double;
 {
  Result:=0;
  _loop N2 where (( c == N2.CLSCH and pyearn == n2.yearn and  pmes == n2.mesn))
   Result:=Result+N2.summa;
 }

 Function GetAnotherPrvd (l : comp) : double;
 {
  Result:=0;
  _loop PrVidoplSdop
       where ((word(18)==PrVidoplSdop.choice and l == PrVidoplSDop.clsch /*and dN1<<= PrVidoplSDop.Dataf (noindex) and dN2>>=PrVidoplSDop.Datok (noindex)*/
                 and ( (PrVidoplSDop.Dataf<=dN and PrVidoplSDop.Datok>=dk) or ( PrVidoplSDop.Dataf=dN and PrVidoplSDop.Datok>dk ) )
             ))
   {
     Result:=Result+PrVidoplSdop.chasf;
   }
 }

 Function GetAnotherPrvd_970 (l : comp) : double;
 {
  Result:=0;
  _loop PrVidoplSdop
       where ((word(18)==PrVidoplSdop.choice and l == PrVidoplSDop.clsch and 'К'==PrVidoplSDop.param(noindex) and dN>>= PrVidoplSDop.Dataf (noindex) and dk<<=PrVidoplSDop.Datok (noindex)
!                 and ( (PrVidoplSDop.Dataf<=dN and PrVidoplSDop.Datok>=dk) or ( PrVidoplSDop.Dataf=dN and PrVidoplSDop.Datok>dk ) )
             ))
   {
     Result:=Result+PrVidoplSdop.chasf;
   }
 }


 Function GetSumNar (l : comp) : double;
 {
  Result:=0;
  _loop tNaryadf where ((LSCHET.NREC   ==  tNaryadf.clsch)) and FoundMarker(nMarker,tNaryadf.vidopl)=true
  {
   Result:=Result+tNaryadf.Chasf;
  }
 }

  Function GetSumNar1 (l : comp; d1 : date ; d2 : date) : double;
 {
  Result:=0;
  _loop tNaryadf where (( l == tNaryadf.clsch and (d1<= tNaryadf.datan and d2>=tNaryadf.datok) ))
  {
   Result:=Result+tNaryadf.Chasf;
  }

 }

 Function GetSumNar2 (l : comp; d1 : date ; d2 : date) : double;
 {
  Result:=0;
  _loop tNaryadf where (( l == tNaryadf.clsch and (d1>= tNaryadf.datan and d2<=tNaryadf.datok) ))
  {
   Result:=Result+tNaryadf.Chasf;
  }

 }

screen ParamForm '' ;
 show at (,,,6);
table zar_user;
!  bevel b2 {1, 3, 69, 9, bsLowered, bsFrame};
  fields
!    vYear ('За какой год формировать табель учета рабочего времени', hcRabTabForm, scEnterz)
!    : noprotect, spinbutton[1, 1, 3000];
!    VedMonth ('Укажите месяц для формирования табеля учета рабочего времени', hcRabTabParam)
!    : [LIST ' '], protect;
    pmes : protect,skip;
    pyearn : protect,skip;
    islog  : noprotect;
!    Zar_User.GrupStN ('Выберите фильтр для расчета', hcRabTabForm, scenterz);
!    FiltrPodr('Заданный фильтр по подразделению', hcRabTabForm, scenter3z): protect;//,pickbutton;
!    FiltrPublic('Выберите работников для проведения расчета', hcRabTabForm, scenter3z): protect;//,pickbutton;
     filtr : noprotect;
     FiltrPodr : protect,pickbutton;
     FiltrLs : protect,pickbutton;
     NoCaclFot : noprotect;
  buttons
    cmOk,,, '~В~вод ', hcOkHelp, sci1Esc;
    CmValue1,,,;
    CmValue2,,,;
    CmValue3,,,;
!    cmCancel,,, '~О~тмена', hcCancelHelp, sci1Esc;
    CmValue4,,,;
  << 'Параметры формирования табеля учета рабочего времени'

   `За` .@@@ `месяц` .@@@@ `года`    [.] выводить лог расчета`
   `Фильтры по:`
     [.] подразделению ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
     [.] работникам `    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

       [.] не рассчитывать налоги на ФОТ`
      <. Рассчитать все .>  <. Рассчитать начисления .> <. Рассчитать начисления на ФОТ.> <.Проверить данные для расчета.>  <. Выгрузить в XLS .>
  >>
 end;

Browse BrwLsch (,,/*sci14Esc*/sciADV149Esc);
 show at (,7,45,);
 table tlschet;
     Fields
!  tlschet.tabn    'Таб№'   : [10],protect;
  tlschet.strtabn 'Таб№'   : [10],protect;
  if(isvalid(#tlschet),SumTotal,0)        'Всего начислений' : [11,'\5p[|-]36 666 666 666 666.88'],protect;
!  Verify(SumTotal)  'Всего начислений' : [11,'\2p[|-]36 666 666 666 666.88888'],protect;
  tlschet.fio/*persons.fio*/     'ФИО'   : [50],protect;
  katpodr.kod     'КодПодр'   : [10],protect;
  katpodr.name    'Подразделение'   : [50],protect;
end;

! tabbedsheet top tabbed;
!   show at (46,7,,);
  Browse BrwNach 'Начисления' ;
   show at (46,7,,);
    table N1;
     Fields
    {Font = {Italic=(N1.otkuda='1');Color=if(N1.otkuda='1',ColorSysTeal,0)}};     

//     N1.vidopl    'Вид оплаты'   : [7],protect;
     kl.vidoplp   'Вид оплаты пользов.'   : [7],protect;
     kl.nvidopl   'Наименование оплаты'     : [35],protect;
     N1.koldn     'Дни'                     : [5.2],protect;
     N1.chasf     'Часы'                    : [5.2],protect;
     N1.summa     'Сумма по затратам'       : [11,'\2p[|-]36 666 666 666 666.88'],protect,{Font = {BackColor =ColorError }};
     N1.CSCHETD+'/'+N1.CSUBSCHD  'Счет/Субсчет'  : [6],protect;
     [KauZakaz] ShowKau(N1.TBLD[1],N1.CKAUD[1]) 'Заказ' :  [25],protect;
     podrzatz.kod+'/'+Substr(podrzatz.name,1,15) 'ЦехОЗ'  : [20],protect;
//     if(isvalid(tnVplan),Vplan.name,'')  'Группа заказов' :  [25],protect;
     N1.param   'Способ расчета'    : [20],protect;
!  DoubleTostr
  end;

  Browse BrwNachFot 'Начисления на ФОТ';
   show at (46,7,,);
    table nFot;
      fields
    {Font = {Italic=(nFot.otkuda='1');Color=if(nFot.otkuda='1',ColorSysTeal,0)}};     

        nFot.Vidper  'Номер','переч.'  : [8],protect;
        PERECH.NAMEPER 'Перечисление'  : [20],protect;
        klvidoplp.VidOplp  'Код','начисл.' ('Код вида оплаты, на который начислен налог',,):[6],protect;
        nFot.SumPer 'Сумма' ('Сумма перечисления',,):[12,2],protect;

     nFot.CSCHETD+'/'+nFot.CSUBSCHD  'Счет/Субсчет'  : [6],protect;
     ShowKau(nFot.TBLD[1],nFot.CKAUD[1]) 'Заказ'  : [25],protect;
     if(isvalid(tnvplanNfot),vplanNfot.name,'')  'Группа заказов' :  [16],protect;
  end;
! end;


