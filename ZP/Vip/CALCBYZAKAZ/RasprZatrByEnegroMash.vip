                         }
                         if iserror
                          efile.writeln('  !!!Error Не определены аналитики в данном распределении затрат');
                        }

  
                     if not ((abs(sumnach)-abs(sumcalc))<0)
                       Insert_DopTable2;
                    else
                     {
                       if firsterr=0
                       {
                        break;
                       }
                       else
                       {
                         Insert_DopTable2;
                         update current N1 set N1.summa:=N1.summa+(sumnach-sumcalc);
                         firsterr:=0;
                       }
                     }


                    }
                   }

                   efile.writeln('После всего sumnach='+DoubleToStr(sumnach,'[|-]\d$3666666666666.88888')+'|sumcalc='+DoubleToStr(sumcalc,'[|-]\d$3666666666666.88888')+' delta='+DoubleToStr(sumnach-sumcalc,'[|-]\d$3666666666666.88888'));

                   if (sumnach-sumcalc)<>0
                   {
                     update current N1 set N1.summa:=N1.summa+(sumnach-sumcalc);
                   }

                   if (tnachisl.chasf-chascalc)<>0
                   {
                     update current N1 set N1.chasf:=N1.chasf+(tnachisl.chasf-chascalc);
                   }

                   if (tnachisl.koldn-daycalc)<>0
                   {
                    update current N1 set N1.koldn:=N1.koldn+(tnachisl.koldn-daycalc);
                   }

                  }
                  else // не нашлось если ни одного prvidopl в данной ситуации, то вставляем как есть с аналитикой из л/с
                  {
                   if islog=1
                     efile.writeln('      Подставляем аналитики из лицевого счета');

                    sparam:=sparam+'(3)';

                   if (lschet.CSCHETD='') //or lschet.CSUBSCHD='')
                    if islog=1
                    {
                     efile.writeln('  !!!Error Не задан счет в л/с');
                    }

                        if islog=1
                        {
                         iserror:=true;
                         for(li1:=1;li1<6;li1++)
                         {
                          if (lschet.CKAUD[li1]<>0)
                          {
                           iserror:=false;
                           break;
                          }
                         }
                         if iserror
                          efile.writeln('  !!!Error Не определены аналитики в л/с');
                        }

                   Insert_DopTable4;
                  }

                  } //else 2
                 }
                }
               }
              }
             else
              {
               if islog=1
               {
                efile.writeln('  Error ? нужный признак в классификаторе ВОПЛ имеет другое значение ('+Klvidopl.VHVOE[36]+')');
               }

              }


           }  // loop tnaschisl


           // add 15/06/2018 // По аналогии с отчетом Факела нужно проверять на присутствие текущего человека в GP_RASPAVANS
           //                   Если он там есть и все заказы, посчитанные в цикле по начислениям Выше, <>ГОЗ

            if getfirst fastfirstrow Gp_RaspAvans where (( lschet.nrec == Gp_RaspAvans.clschet
                                                          and        0 == Gp_RaspAvans.Isarh
                                                          and       dN1 >>= Gp_RaspAvans.datan
                                                          and       dN2 <<= Gp_RaspAvans.dataok  (noindex)
                                                          and          0 == Gp_RaspAvans.WTYPE (noindex) // только накладные
                                                        ))=tsok
             {

               if islog=1
               {
                efile.writeln('  Под текущему таб№ есть разноска по основным группам заказов');
               }

               if CntMainPlan=0
               {
                 var cursumnach3,cursumnachT : decimal(31,15)  = 0 ;
                 var curchasf3,curchasfT: double =0 ;
                 IsNoGosinAvans:=false;

                 _loop n3
                 {
                   cursumnachT:=n3.summa;
                   cursumnach3:=0;
                   curchasfT  :=n3.chasf;
                   curchasf3  :=0;

                   if islog=1
                   {
                    efile.writeln('   -- Начисление :'+n3.vidopl+' на сумму :'+DoubleToStr(n3.summa,'[|-]\d$3666666666666.88888')+' часов :'+DoubleToStr(n3.chasf,'[|-]\d$3666666666666.88888'));
                   }


                  _loop Gp_RaspAvans where (( lschet.nrec == Gp_RaspAvans.clschet
                                                          and        0 == Gp_RaspAvans.Isarh
                                                          and       dN1 >>= Gp_RaspAvans.datan
                                                          and       dN2 <<= Gp_RaspAvans.dataok  (noindex)
                                                          and          0 == Gp_RaspAvans.WTYPE (noindex) // только накладные
                                                        ))
                   {
                    if islog=1
                    {
                     efile.writeln('         --- процент= :'+Gp_RaspAvans.Procent+' . Рассчитанная сумма= '+DoubleToStr(Round(cursumnachT*Gp_RaspAvans.Procent/100,2),'[|-]\d$3666666666666.88888')+'. Рассчитано часов= '+DoubleToStr(Round(curchasfT*Gp_RaspAvans.Procent/100,2),'[|-]\d$3666666666666.88888'));
                    }


                     nachislzakaz.Buffer:=type$nachislzakaz(n3.buffer);
                     nachislzakaz.nrec  :=GetNextNrec(tnnachislzakaz,0);
                     nachislzakaz.summa :=Round(cursumnachT*Gp_RaspAvans.Procent/100,2);
                     nachislzakaz.chasf :=Round(curchasfT*Gp_RaspAvans.Procent/100,2);
                     nachislzakaz.Kauextr[1]:=Gp_RaspAvans.cVplan;
                     nachislzakaz.tblextr[1]:=200;
                     insert current nachislzakaz;
                     cursumnach3:=cursumnach3+nachislzakaz.summa;
                     curchasf3:=curchasf3+nachislzakaz.chasf;
                   }

//                  update current n3 set n3.summa:=cursumnach3;
                   update current n3 set n3.summa:=n3.summa-cursumnach3 , n3.chasf :=n3.chasf-curchasf3 ;

                 }
               }
!               else
!                Message('есть гоз');
             }



           if NoCaclFot=1 continue;

           // цикл по начислениям...
           _loop tnachisl
           {
              //нужно побить еще начисления на ФОТ....
              cz  :=tnachisl.nrec;
              trec:=tnachisl.tiprec;

              if Verify(CntNachZakaz) {}  // побилось текущее начисление на N-штук или нет...

               efile.writeln('     ');
               efile.writeln('     Записей NachislZakaz='+CntNachZakaz);

              _loop tPerevodmes
              {
                delta_   :=0;
                sumcalc  :=0;

                if islog=1
                {
                 efile.writeln('     Начисление на ФОТ :'+tPerevodMes.sumper);
                }

                if CntNachZakaz=1
                {
                 _loop nN where ((cz == nN.CNACHISL and trec == nN.otkuda (noindex))) 
                 {
                  Insert_DopTableFot1;
                 }
                }
                else
                 if CntNachZakaz>1
                {

                 firsterr:=1;
                 _loop nN where ((cz == nN.CNACHISL and trec == nN.otkuda (noindex) )) 
                 {
                  sumnach:=tNachisl.summa;

                  curkoefp:=nN.summa/tNachisl.summa*100;

                  sum_high_precision :=  (tPerevodMes.sumper*curkoefp/100);
                  sumkoefp  :=Round(sum_high_precision+delta_,13);
                  delta_   := delta_ + (sum_high_precision - sumkoefp);

                  sumcalc :=sumcalc+sumkoefp;

                  if islog=1
                   efile.writeln('          -Данное начисление.Сумма:'+DoubleToStr(nN.summa,'[|-]\d$3666666666666.88888888888')+'.Сумма по коэффициенту:'+DoubleToStr(sumkoefp,'[|-]\d$3666666666666.88888')+'.Часов по коэфф:'+DoubleToStr(sumchasf,'[|-]\d$3666666666666.88888888888')+'.Delta by current record:'+DoubleToStr(delta_,'[|-]\d$3666666666666.888888888'));

                    if not ((abs(sumnach)-abs(sumcalc))<0)
                      Insert_DopTableFot2;
                    else
                    {
                      if firsterr=0
                      {
                       break;
                      }
                      else
                      {
                        Insert_DopTableFot2;
                        update current nFot set nFot.sumper:=nFot.sumper+(sumnach-sumcalc);
                        firsterr:=0;
                      }
                    }


                 }
                 efile.writeln('          -last delta='+DoubleToStr(delta_,'[|-]\d$3666666666666.8888888888888'));
                 if delta_<>0
                  update current nFot set nFot.sumper:=nFot.sumper+delta_;
                }

              }
             }
             // Add 11/03/2019 Если человек "не зашел" в Gp_avans Выше по условию. то
             // то нужно проапдейтить по нему perevodtekzakaz-ы поля KAUEXTR[1] - присвоить значению этого поля группу заказов которые ГОЗ... 
             if IsNoGosinAvans=True              
              if getfirst fastfirstrow Gp_RaspAvans where (( lschet.nrec == Gp_RaspAvans.clschet
                                                          and        0 == Gp_RaspAvans.Isarh
                                                          and       dN1 >>= Gp_RaspAvans.datan
                                                          and       dN2 <<= Gp_RaspAvans.dataok  (noindex)
                                                          and          0 == Gp_RaspAvans.WTYPE (noindex) // только накладные
                                                        ))<>tsok
             {
              var NrecGrGosZak: comp = 0h ;

               if islog=1
               {
                efile.writeln('  Под текущему таб№ нет разноски по Gp_RaspAvans. Будем анализировать массив Perevodtekzakaz');
               }


               _loop Nfot where ((
                                       lschet.nrec    == Nfot.clsch
                                   and pyearn         == Nfot.yearn (noindex)
                                   and pmes           == Nfot.mesn  (noindex)
                                ))

               {
                NrecGrGosZak:=GetGozZak(nFot.CKAUD[1]);
                if NrecGrGosZak<>0
                 update current nFot set nFot.KAUEXTR[1]:=NrecGrGosZak;
               }
             }
          }
          firstrec:=0;
        }

              StopVisual('',0);
  /*
        li1:=sqlExecDirect(vliSQLCommand);

        MtClear(#tlschet,fmNormal);

        stmt := sqlAllocStmt;
        sqlAddStr(stmt_str,'select ');
        sqlAddStr(stmt_str,'      l.nrec  ');
        sqlAddStr(stmt_str,'     ,l.tabn  ');
        sqlAddStr(stmt_str,'     ,l.strtabn  ');
        sqlAddStr(stmt_str,'     ,l.tperson  ');
        sqlAddStr(stmt_str,'     ,l.cex  ');
        sqlAddStr(stmt_str,'     ,l.cpodr  ');
        sqlAddStr(stmt_str,'     ,p.fio  ');
        sqlAddStr(stmt_str,'  from     ');
        sqlAddStr(stmt_str,'    (   ');
