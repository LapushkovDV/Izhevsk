                   }
                   else
                   {
                    InsertMarker(nMarker,1);
                    InsertMarker(nMarker,7);
                    InsertMarker(nMarker,9);
                    InsertMarker(nMarker,11);
                    if islog=1
                     efile.writeln('  insert all getmarkercount='+GetMarkerCount(nMarker));
                   }

                  if islog=1
                   efile.writeln('     getmarkercount='+GetMarkerCount(nMarker));



