}


Procedure ReloadAllPer;
{
  StartNewVisual(vtRotateVisual, vfTimer+vfBreak,
                    ''#3'Предварительная загрузка всех начислений на ФОТ'#13#3,1);

     if (not flagArh)
       {
/*
        sql
         select
          nrec
         ,cnach
         ,otkuda
        from perevodtek
         where YEARN=:(pyearn) and mesn=:(pmes)
        into tperevod byname
        ;
*/
        sql
         select
         NREC    
        ,CEX     
        ,CEXOZ   
        ,CPODR   
        ,CPODROZ 
        ,MES     
        ,MESN    
        ,VIDPER  
        ,SUMPER  
        ,CSCHETD 
        ,CSUBSCHD
        ,CKAUD[1]  
        ,CKAUD[2]  
        ,CKAUD[3]  
        ,CKAUD[4]  
        ,CKAUD[5]  
        ,CKAUD[6]  
        ,TBLD[1]   
        ,TBLD[2]   
        ,TBLD[3]   
        ,TBLD[4]   
        ,TBLD[5]   
        ,TBLD[6]   
        ,CSCHETK   
        ,CSUBSCHK  
        ,CKAUD[1]  
        ,CKAUD[2]  
        ,CKAUD[3]  
        ,CKAUD[4]  
        ,CKAUD[5]  
        ,CKAUD[6]  
        ,TBLK[1]   
        ,TBLK[2]   
        ,TBLK[3]   
        ,TBLK[4]   
        ,TBLK[5]   
        ,TBLK[6]   
        ,CLSCH
        ,CNACH
        ,OTKUDA
        ,TPERSON
        ,VIDOPL
        ,VIDOPLS
        ,YEARK
        ,YEARN
        ,STRTABN
        ,KAUEXTR[1]
        ,KAUEXTR[2]
        ,KAUEXTR[3]
        ,KAUEXTR[4]
        ,KAUEXTR[5]
        ,KAUEXTR[6]
        ,TBLEXTR[1]
        ,TBLEXTR[2]
        ,TBLEXTR[3]
        ,TBLEXTR[4]
        ,TBLEXTR[5]
        ,TBLEXTR[6]
        from perevodtek
         where YEARN=:(pyearn) and mesn=:(pmes)
        into tperevodmes byname
        ;        
        
       }
       else
       {
/*
        sql
         select
          nrec
         ,cnach
         ,otkuda
        from perevod
         where YEARN=:(pyearn) and mesn=:(pmes)
        into tperevod byname
        ;
*/
        sql
         select
         NREC    
        ,CEX     
        ,CEXOZ   
        ,CPODR   
        ,CPODROZ 
        ,MES     
        ,MESN    
        ,VIDPER  
        ,SUMPER  
        ,CSCHETD 
        ,CSUBSCHD
        ,CKAUD[1]  
        ,CKAUD[2]  
