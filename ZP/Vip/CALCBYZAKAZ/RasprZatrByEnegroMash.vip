                      {
                       break;
                      }
                      else
                      {
                        Insert_DopTable32;
                        update current N1 set N1.summa:=N1.summa+(sumnach-sumcalc);
                        firsterr:=0;
                      }
                     }
                    }//_loop nachisl3

                   }//else


                  }
                  else
                  {

                  Clearmarker(NMarker);
                  if islog=1
                   efile.writeln('  before getmarkercount='+GetMarkerCount(nMarker));


