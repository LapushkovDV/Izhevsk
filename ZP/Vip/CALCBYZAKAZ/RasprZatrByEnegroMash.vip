                          efile.writeln('Табельный№ '+lschet.strtabn+'. В распределении затрат не определены аналитики . Дата начала :'+DateTostr(PrVidopl.Datan,'DD.MM.YYYY')+' Дата окончания :'+DateTostr(PrVidopl.Datok,'DD.MM.YYYY'));
                          row++;
                          xlSetCellStringValue(lschet.strtabn,row,1,row,1);
