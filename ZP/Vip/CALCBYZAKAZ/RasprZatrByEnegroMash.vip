                    cntnar:=0  ;

                    _loop nachisl1
                    {
                     curkoef:=nachisl1.chasf/SumSdelv*100;
                     if (tNachisl.vidopls=7 and nachisl1.vidopl=7)
                     {
!                      if islog=1
