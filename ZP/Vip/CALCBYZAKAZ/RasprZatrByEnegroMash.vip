 table struct tNachisl
 (
   nrec   : comp
  ,CEX    : comp
  ,CEXOZ  : comp
  ,CPODR  : comp
  ,MES    : word
  ,MESN   : word
  ,YEARN  : integer
  ,VIDOPL : longint
  ,KATEG  : word
  ,DATAN  : date
  ,DATOK  : date
  ,KOLDN  : double
  ,CHASF  : double
  ,SUMMA  : double
  ,CSCHETD  : string[20]
  ,CSUBSCHD : string[20]
  ,CKAUD    : array[1..6] of comp
  ,TBLD     : array[1..6] of word
  ,CSCHETK  : string[20]
  ,CSUBSCHK : string[20]
  ,CKAUK    : array[1..6] of comp
  ,TBLK     : array[1..6] of word
  ,CLSCH    : comp
  ,TPERSON  : comp
  ,SISOPL   : word
  ,CODTAR   : word
  ,RAZR     : word
  ,VIDOPLS  : longint
  ,DATAV    : date
  ,MESV     : word
  ,YEARV    : integer
  ,YEARK    : integer
  ,KOLDNGR  : double
  ,CHASGR   : double
  ,STRTABN  : string[20]
  ,KAUEXTR  : array[1..6] of comp
  ,TBLEXTR  : array[1..6] of word
  ,tiprec   : string[1]
  ,isklpodr : comp
  ,CloseNach : word
  ,tudasuda  : word
 )
 with index
 (
   in1=CLSCH+YEARN+MESN 
 );

 table struct tperevodmes
 (
   NREC      : comp
  ,CEX       : comp
  ,CEXOZ     : comp
  ,CPODR     : comp
  ,CPODROZ   : comp
  ,MES       : word
  ,MESN      : word
  ,VIDPER    : word
  ,SUMPER    : double
  ,CSCHETD   : string[20]
  ,CSUBSCHD  : string[20]
  ,CKAUD     : array[1..6] of comp
  ,TBLD      : array[1..6] of word
  ,CSCHETK   : string[20]
  ,CSUBSCHK  : string[20]
  ,CKAUK     : array[1..6] of comp
  ,TBLK      : array[1..6] of word
  ,CLSCH     : comp
  ,CNACH     : comp
  ,OTKUDA    : string[1]
  ,TPERSON   : comp
  ,VIDOPL    : longint
  ,VIDOPLS   : longint
  ,YEARK     : integer
  ,YEARN     : integer
  ,STRTABN  : string[20]
  ,KAUEXTR  : array[1..6] of comp
  ,TBLEXTR  : array[1..6] of word
 )
 with index
 (
!   in1= nrec
  in1=otkuda+cnach
 );


 table struct tNaryad
 (
//   nrec     : comp
   tabn     : longint
  ,strtabn  : string[20]
  ,vidopl   : longint
  ,TBLD     : array[1..6] of word
  ,CKAUD    : array[1..6] of comp
  ,mes      : word
  ,datan    : date
  ,datok    : date
  ,chasf    : double
  ,summa    : double
  ,koldn    : double
  ,cschetd  : string[20]
  ,csubschd : string[20]
  ,czak     : comp        //PRNARYAD.CKAUD[3]
  ,clsch    : comp
  ,tperson  : comp
 )
 with index
 (
   in1 = clsch
  ,in2 = clsch + datan + datok
 );

 table struct tFormarks
 (
   choice : word
  ,cpodr  : comp
 )
 with index 
 (
  in1= CHOICE
 )
 ;

 table struct tplan
 (
  nrec    : comp
 ,schet   : string[20]
 ,subsch  : string[20]
 ,levelz  : integer
 )
 with index
 (
  i1=schet+subsch
  ,i2=nrec
 )
 ;

 table struct tgp_raspvo
 (
    nrec       : comp
   ,schet      : string[20]
   ,subsch     : string[20]
   ,vidoplp    : longint
   ,cMnplan    : comp
   ,CADDFLD    : comp
 )
 with index
 (
   in1=schet+vidoplp+CADDFLD
 );

/*
 table struct tperevod
 (
    nrec   : comp
   ,cnach  : comp
   ,otkuda : string[1] //0-nachisl, 1-nenach
 )
  with index
 (
  in1=otkuda+cnach
 )
 ;
*/

 table struct tlschet
 (
   nrec : comp
  ,tabn : longint
  ,strtabn : string[20]
  ,TPERSON : comp
  ,CEX     : comp
  ,CPODR   : comp
  ,FIO     : string[60]
 )
 with index
 (
  in1=nrec
 ,in2=cex+tabn+strtabn
 ,in3=tabn 
 ,in4=fio+CEX
 );

  table struct tvidopl
  (
    vidopl  : word
   ,vidoplp : word
  )
  with index
  (
   in1=vidoplp
  );

  table struct tvplan
  (
    nrec   : comp
   ,cvplan : comp
  )
  with index
  (
   in1=nrec
  );

