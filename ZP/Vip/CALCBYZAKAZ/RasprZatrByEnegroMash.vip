  CmValue4:{

             if not isvalid(#tlschet)
             {
              Message('Нет данных для выгрузки по текущим ограничениям !');
              exit;
             }

             rowmatrx:=0;

             _loop tlschet
              _loop n1
              {
               rowmatrx++;
              }



            Filepath:=StartPathName+'\XLS_ЭМ\Staff\RaspredZarplByZakaz.xlsx';

            if (not ExistFile(Filepath))
            {
             Message('Не удалось найти шаблон RaspredZarplByZakaz.xlsx');
             exit;
            }

             xlCreateExcelWithTemplate(Filepath,True);


             StartNewVisual(vtIndicatorVisual,vfBreak+vftimer,
                         ''#3'Выгрузка данных в xls  ..'#13#3,rowmatrx) ;

             onematr:=XlCreateMatrixEx(rowmatrx,7); //ФИО+ТАБ+ПОДРАЗДЕЛ+ВИДОПЛ+СЧЕТ+ЗАКАЗ+СУММА

             yesbrk:=false;
             counter:=0;

             _loop tlschet
              _loop n1
             {

              if not nextvisual
              {
               Message('Формирование отчета было прервано...переформируйте заново');
               yesbrk:=true;
               xlKillExcel;
               break;
              }            

        	  inc(counter);
              XlSTWriteToMatrixEx(onematr,counter,1,tlschet.fio);
              XlSTWriteToMatrixEx(onematr,counter,2,tlschet.strtabn);
              XlSTWriteToMatrixEx(onematr,counter,3,SubStr(katpodr.kod,1,3)+'-'+katpodr.name);
              XlSTWriteToMatrixEx(onematr,counter,4,string(kl.vidoplp));
              XlSTWriteToMatrixEx(onematr,counter,5,N1.CSCHETD+'.'+N1.CSUBSCHD);
              XlSTWriteToMatrixEx(onematr,counter,6,ShowKau(N1.TBLD[1],N1.CKAUD[1]));
              XlDoWriteToMatrixEx(onematr,counter,7,N1.summa);
             }

           if xlWriteMatrixToExcelEx(onematr,1,1)=true
              xlClearMatrix;

           if (not yesbrk)
            StopVisual('',0);
  	        xlKillExcel;



           }

  CmValue7:{
             humancalc:=tlschet.nrec;
!            logstrtofile('c:\debug\ttppkkgg.log','set humancalc='+humancalc);
             PushConditionForleave(tccon1,tntFormarks);
             ProcessCommand(CmOk);
             PopConditionForleave(tccon1,tntFormarks);
!             humancalc:=0;
           }

  CmDone :{
            SaveMyDsk(Filtr,'FiltrForRas');
            SaveMyDsk(FiltrPodr,'FiltrPodrForRas');
            SaveMyDsk(FiltrLs,'FiltrLsForRas');
          }
 end;
end.

