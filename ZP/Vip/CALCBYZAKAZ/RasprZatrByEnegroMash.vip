                      efile.writeln('    is not verify');
!                      SumSdel:=0;
                     SumSdelV:=0;
                    }
!                    if Verify(SumSdel7) {}
                  if (Sumsdelv=0 and (tNachisl.vidopls=9 or tNachisl.vidopls=70 or tNachisl.vidopls=11 or tNachisl.vidopls=72))
