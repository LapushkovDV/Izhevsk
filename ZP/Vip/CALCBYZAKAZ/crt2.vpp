#define ss sqlAddStr(vliSQLCommand, '
#define se ');

Procedure ClearQuery(Var liHandle: Longint);
{
  if (liHandle != 0)
  {
    sqlFreeStr(liHandle);
    liHandle := 0;
  }
}


Function InitTmpTable(wModeTmpT: Word): Boolean;
{
  Var vbResult     : Boolean;                        // Результат функции
  Var vliSQLCommand: Longint;                        // Handle SQL-команды
  Var vliErrorCode : Longint;                        // Код ошибки

  _try
  {
    vbResult := False;

    sqlDropTmpTable('selMarksLs');

    #ss  TABLE selMarksLs      #se
    #ss  (                     #se
    #ss    nrec        : Comp  #se
    #ss  )                     #se
    #ss WITH INDEX             #se
    #ss (                      #se
    #ss   in1 = nrec          #se
    #ss );                     #se


    vliErrorCode := sqlCreateTmpTable(vliSQLCommand, wModeTmpT);
    ClearQuery(vliSQLCommand);

!    Message('vliErrorCode='+vliErrorCode);

    if (vliErrorCode != 0)
      Exit;
    vbResult := True;
  } // _try

  _finally
  {
    if (vliErrorCode != 0)
      Message('Ошибка при выполнении SQL-сценария (Создание временных таблиц): код = ' + String(vliErrorCode), Error);

    InitTmpTable := vbResult;
  } // _finally
}
