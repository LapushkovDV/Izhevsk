!                 N1.SUMMA31    := tnachisl.SUMMA31  ;
!                 N1.SUMMA32    := tnachisl.SUMMA32     ;
!                 N1.SUMMA33    := tnachisl.SUMMA33     ;
!                 N1.SUMMA34    := tnachisl.SUMMA34     ;
!                 N1.BRIGADE    := tnachisl.BRIGADE     ;
!                 N1.OLDCLSCH   := tnachisl.OLDCLSCH    ;
                 N1.STRTABN    := tnachisl.STRTABN     ;
                 N1.KAUEXTR[1] := tnachisl.KAUEXTR[1]  ;
                 N1.KAUEXTR[2] := tnachisl.KAUEXTR[2]  ;
                 N1.KAUEXTR[3] := tnachisl.KAUEXTR[3]  ;
                 N1.KAUEXTR[4] := tnachisl.KAUEXTR[4]  ;
                 N1.KAUEXTR[5] := tnachisl.KAUEXTR[5]  ;
                 N1.KAUEXTR[6] := tnachisl.KAUEXTR[6]  ;
                 N1.TBLEXTR[1] := tnachisl.TBLEXTR[1]  ;
                 N1.TBLEXTR[2] := tnachisl.TBLEXTR[2]  ;
                 N1.TBLEXTR[3] := tnachisl.TBLEXTR[3]  ;
                 N1.TBLEXTR[4] := tnachisl.TBLEXTR[4]  ;
                 N1.TBLEXTR[5] := tnachisl.TBLEXTR[5]  ;
                 N1.TBLEXTR[6] := tnachisl.TBLEXTR[6]  ;
!                 N1.CPSNLINKS  := tnachisl.CPSNLINKS   ;
                 N1.CPRVID     := PrVidopl.nrec       ;
                 N1.CNACHISL   := tnachisl.nrec        ;
                 N1.otkuda     := tnachisl.tiprec     ;
                 Insert Current N1;

                 level_c :=0;
                 czak_c  :=0;


                 if GetZakazInDoptableNew(
                                       cursch_,cursub_,N1.VIDOPL,N1.CEXOZ,level_c,czak_c
                                      )=True
                 {
                  if level_c<>0
                  {
                    if cursch_=if(chls=true,lschet.CSCHETD,tnachisl.cschetd)
                      Update current N1 set N1.TBLD[level_c] := 7, N1.CKAUD[level_c]:=czak_c;
                    else
                    {
                      N1.CSCHETD    := cursch_ ;
                      N1.CSUBSCHD   := cursub_ ;
                      N1.TBLD[level_c] := 7 ;
                      N1.CKAUD[level_c]:=czak_c;
                      Update current N1;
                    }
                  }
                 }
                 else
                  if (N1.VIDOPL=64 and N1.CKAUD[1]=comp(0)) // Add 07072018 Пока по 64 ВидОплу если встретили такое что не определился заказ - то ищем по особому алгоритму...
                {
                   #SubZapros64
                }

                 if ( (N1.VIDOPL=68  or N1.VIDOPL=65) and N1.CEX<>N1.CEXOZ)
                 {
                  #SubZapros68
                 }
}

Procedure Insert_DopTableFot2;
{
                 ClearBuffer(#nFot);
!                 nFot.TABN       := PerevodTek.TABN      ;
                 nFot.CEX        := tPerevodmes.CEX       ;
                 nFot.CEXOZ      := if(lschet.kassir1=0,tPerevodmes.CEXOZ,nrec555) ;
                 nFot.CPODR      := tPerevodmes.CPODR     ;
                 nFot.CPODROZ    := tPerevodmes.CPODROZ   ;
                 nFot.MES        := tPerevodmes.MES       ;
                 nFot.MESN       := tPerevodmes.MESN      ;
                 nFot.VIDPER     := tPerevodmes.VIDPER    ;
                 nFot.SUMPER     := sumkoefp;//PerevodTek.
                 nFot.CSCHETD    := nN.CSCHETD ;//nachisl.CSCHETD
                 nFot.CSUBSCHD   := nN.CSUBSCHD; //nachisl.CSUBSCHD
                 for(li1:=1;li1<6;li1++)
                 {
                  nFot.CKAUD[li1]   := nN.CKAUD[li1];//nachisl.CKAUD[1]
!                  if lschet.CKAUD[li1]<>0
!                   break;
                 }
                 for(li1:=1;li1<6;li1++)
                 {
                  nFot.TBLD[li1]    := nN.TBLD[li1];//nachisl.TBLD[1]
!                  if lschet.TBLD[li1]<>0
!                   break;
                 }

                 nFot.CSCHETK    := tPerevodmes.CSCHETK  ;
                 nFot.CSUBSCHK   := tPerevodmes.CSUBSCHK ;
                 nFot.CKAUK[1]   := tPerevodmes.CKAUK[1] ;
                 nFot.CKAUK[2]   := tPerevodmes.CKAUK[2] ;
                 nFot.CKAUK[3]   := tPerevodmes.CKAUK[3] ;
                 nFot.CKAUK[4]   := tPerevodmes.CKAUK[4] ;
                 nFot.CKAUK[5]   := tPerevodmes.CKAUK[5] ;
                 nFot.CKAUK[6]   := tPerevodmes.CKAUK[6] ;
                 nFot.TBLK[1]    := tPerevodmes.TBLK[1]  ;
                 nFot.TBLK[2]    := tPerevodmes.TBLK[2]  ;
                 nFot.TBLK[3]    := tPerevodmes.TBLK[3]  ;
                 nFot.TBLK[4]    := tPerevodmes.TBLK[4]  ;
                 nFot.TBLK[5]    := tPerevodmes.TBLK[5]  ;
                 nFot.TBLK[6]    := tPerevodmes.TBLK[6]  ;
                 nFot.CLSCH      := tPerevodmes.CLSCH    ;
                 nFot.CNACH      := nN.nrec;//nachisl.nrec        ;
                 nFot.OTKUDA     := tPerevodmes.OTKUDA   ;
                 nFot.TPERSON    := tPerevodmes.TPERSON  ;
                 nFot.VIDOPL     := tPerevodmes.VIDOPL   ;
                 nFot.VIDOPLS    := tPerevodmes.VIDOPLS  ;
                 nFot.YEARK      := tPerevodmes.YEARK    ;
                 nFot.YEARN      := tPerevodmes.YEARN    ;
!                 nFot.CHOZOPER   := tPerevodmes.CHOZOPER ;
!                 nFot.PARAM      := tPerevodmes.PARAM    ;
!                 nFot.CMAINDOC   := tPerevodmes.nrec;//tPerevodmes.CMAINDOC ;
!                 nFot.SISOPL     := tPerevodmes.SISOPL   ;
!                 nFot.CODTAR     := tPerevodmes.CODTAR   ;
!                 nFot.RAZR       := tPerevodmes.RAZR     ;
!                 nFot.CAPPOINT   := tPerevodmes.CAPPOINT ;
!                 nFot.KATEG      := tPerevodmes.KATEG    ;
!                 nFot.OBLAGS     := tPerevodmes.OBLAGS   ;
!                 nFot.OBLAGSO    := tPerevodmes.OBLAGSO  ;
!                 nFot.BRIGADE    := tPerevodmes.BRIGADE  ;
!                 nFot.OLDCLSCH   := tPerevodmes.OLDCLSCH ;
                 nFot.STRTABN    := tPerevodmes.STRTABN  ;
!                 nFot.PRIZN1     := tPerevodmes.PRIZN1   ;
!                 nFot.PRIZN2     := tPerevodmes.PRIZN2   ;
                 nFot.KAUEXTR[1] := if((nN.Kauextr[1]<>0 and nN.tblextr[1]=200),nN.Kauextr[1],comp(0));
                 nFot.KAUEXTR[2] := tPerevodmes.KAUEXTR[2]  ;
                 nFot.KAUEXTR[3] := tPerevodmes.KAUEXTR[3]  ;
                 nFot.KAUEXTR[4] := tPerevodmes.KAUEXTR[4]  ;
                 nFot.KAUEXTR[5] := tPerevodmes.KAUEXTR[5]  ;
                 nFot.KAUEXTR[6] := tPerevodmes.KAUEXTR[6]  ;
                 nFot.TBLEXTR[1] := tPerevodmes.TBLEXTR[1]  ;
                 nFot.TBLEXTR[2] := tPerevodmes.TBLEXTR[2]  ;
                 nFot.TBLEXTR[3] := tPerevodmes.TBLEXTR[3]  ;
                 nFot.TBLEXTR[4] := tPerevodmes.TBLEXTR[4]  ;
                 nFot.TBLEXTR[5] := tPerevodmes.TBLEXTR[5]  ;
                 nFot.TBLEXTR[6] := tPerevodmes.TBLEXTR[6]  ;
                 Insert Current nFot;

                 level_c :=0;
                 czak_c  :=0;

                 if GetZakazInDoptableNew(
                                       NFot.CSCHETD,NFot.CSUBSCHD,NFot.VIDOPL,NFot.CEXOZ,level_c,czak_c
                                      )=True
                 {
                  if level_c<>0
                   Update current NFot set NFot.CKAUD[level_c]:=czak_c;
                 }

}

