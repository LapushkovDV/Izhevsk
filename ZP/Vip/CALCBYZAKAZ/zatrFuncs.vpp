                //ШПЗ тут берем из PrVididOpl       ;
                 N1.CSCHETD    := PrVidopl.CSCHETD ;//nachisl.CSCHETD
                 N1.CSUBSCHD   := PrVidopl.CSUBSCHD;//nachisl.CSUBSCHD

                 for(li1:=1;li1<6;li1++)
