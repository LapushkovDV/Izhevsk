Procedure Insert_DopTable4;
{
//  var cursch_,cursub_: string[20] = '' ;
 var chls : boolean;

      chls:=true;
      cursch_:=lschet.CSCHETD;
      cursub_:=lschet.CSUBSCHD;

      if cursch_=''
      {
       chls:=false;
       cursch_:=tnachisl.CSCHETD;
       cursub_:=tnachisl.CSUBSCHD;
      }

!                Insert N1 set
                 ClearBuffer(#N1);
!                 N1.TABN       := tnachisl.TABN      ;
                 N1.CEX        := tnachisl.CEX       ;
                 N1.CEXOZ      := if(lschet.kassir1=0,tnachisl.CEXOZ,nrec555) ;
                 N1.CPODR      := tnachisl.CPODR     ;
!                 N1.CPODROZ    := tnachisl.CPODROZ   ;
                 N1.MES        := tnachisl.MES       ;
                 N1.MESN       := tnachisl.MESN      ;
                 N1.YEARN      := tnachisl.YEARN     ;
                 N1.VIDOPL     := tnachisl.VIDOPL    ;
                 N1.KATEG      := tnachisl.KATEG     ;
                 N1.DATAN      := tnachisl.DATAN     ;
                 N1.DATOK      := tnachisl.DATOK     ;
                 N1.KOLDN      := tnachisl.KOLDN     ;
                 N1.CHASF      := tnachisl.CHASF     ;
                 N1.SUMMA      := tnachisl.summa     ;
!                 N1.PRIZPR     := tnachisl.PRIZPR ;
                //ШПЗ тут берем из Nachisl
                 N1.CSCHETD    := cursch_;//nachisl.CSCHETD
                 N1.CSUBSCHD   := cursub_; //nachisl.CSUBSCHD
                 for(li1:=1;li1<6;li1++)
                 {
                  N1.CKAUD[li1]   := if(chls=true,lschet.CKAUD[li1],tnachisl.CKAUD[li1]);//nachisl.CKAUD[1]
!                  if(chls=true,lschet.CKAUD[li1],nachisl.CKAUD[li1])<>0
                   if chls=true
                   {
                    if lschet.CKAUD[li1]<>0
                      break;
                   }
                   else
                   {
                    if tnachisl.CKAUD[li1]<>0
                      break;
                   }
                 }
                 for(li1:=1;li1<6;li1++)
                 {
                  N1.TBLD[li1]    := if(chls=true,lschet.TBLD[li1],tnachisl.TBLD[li1]);//nachisl.TBLD[1]
!                   if(chls=true,lschet.TBLD[li1],tnachisl.TBLD[li1])<>0
!                   break;
                   if chls=true
                   {
                    if lschet.TBLD[li1]<>0
                      break;
                   }
                   else
                   {
                    if tnachisl.TBLD[li1]<>0
                      break;
                   }

                 }

