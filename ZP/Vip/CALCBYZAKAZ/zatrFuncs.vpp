                 N1.TBLK[3]    := tnachisl.TBLK[3]  ;
                 N1.TBLK[4]    := tnachisl.TBLK[4]  ;
                 N1.TBLK[5]    := tnachisl.TBLK[5]  ;
                 N1.TBLK[6]    := tnachisl.TBLK[6]  ;
                 N1.CLSCH      := tnachisl.CLSCH    ;
                 N1.TPERSON    := tnachisl.TPERSON  ;
                 N1.SISOPL     := tnachisl.SISOPL   ;
                 N1.CODTAR     := tnachisl.CODTAR   ;
                 N1.RAZR       := tnachisl.RAZR     ;
                 N1.VIDOPLS    := tnachisl.VIDOPLS  ;
!                 N1.OTKUDA     := tnachisl.OTKUDA   ;
!                 N1.CAPPOINT   := tnachisl.CAPPOINT ;
!                 N1.CHOZOPER   := tnachisl.CHOZOPER ;
                 N1.PARAM      := sparam    ;
!                 N1.CMAINDOC   := tnachisl.CMAINDOC ;
                 N1.DATAV      := tnachisl.DATAV    ;
!                 N1.SUMMAVKL   := tnachisl.SUMMAVKL ;
!                 N1.PROC       := tnachisl.PROC     ;
!                 N1.MINSUM     := tnachisl.MINSUM   ;
                 N1.MESV       := tnachisl.MESV     ;
                 N1.YEARV      := tnachisl.YEARV    ;
                 N1.YEARK      := tnachisl.YEARK    ;
                 N1.KOLDNGR    := tnachisl.KOLDNGR  ;
                 N1.CHASGR     := tnachisl.CHASGR   ;
!                 N1.DATE1      := tnachisl.DATE1    ;
!                 N1.DATE2      := tnachisl.DATE2    ;
!                 N1.DATE3      := tnachisl.DATE3    ;
!                 N1.SUMMA27    := tnachisl.SUMMA27   ;
!                 N1.SUMMA28    := tnachisl.SUMMA28   ;
!                 N1.SUMMA29    := tnachisl.SUMMA29   ;
!                 N1.SUMMA30    := tnachisl.SUMMA30   ;
!                 N1.SUMMA31    := tnachisl.SUMMA31   ;
!                 N1.SUMMA32    := tnachisl.SUMMA32   ;
!                 N1.SUMMA33    := tnachisl.SUMMA33   ;
!                 N1.SUMMA34    := tnachisl.SUMMA34   ;
!                 N1.BRIGADE    := tnachisl.BRIGADE   ;
!                 N1.OLDCLSCH   := tnachisl.OLDCLSCH  ;
                 N1.STRTABN    := tnachisl.STRTABN    ;
                 N1.KAUEXTR[1] := tnachisl.KAUEXTR[1] ;
                 N1.KAUEXTR[2] := tnachisl.KAUEXTR[2] ;
                 N1.KAUEXTR[3] := tnachisl.KAUEXTR[3] ;
                 N1.KAUEXTR[4] := tnachisl.KAUEXTR[4] ;
                 N1.KAUEXTR[5] := tnachisl.KAUEXTR[5] ;
                 N1.KAUEXTR[6] := tnachisl.KAUEXTR[6] ;
                 N1.TBLEXTR[1] := tnachisl.TBLEXTR[1] ;
                 N1.TBLEXTR[2] := tnachisl.TBLEXTR[2] ;
                 N1.TBLEXTR[3] := tnachisl.TBLEXTR[3] ;
                 N1.TBLEXTR[4] := tnachisl.TBLEXTR[4] ;
                 N1.TBLEXTR[5] := tnachisl.TBLEXTR[5] ;
                 N1.TBLEXTR[6] := tnachisl.TBLEXTR[6] ;
!                 N1.CPSNLINKS  := tnachisl.CPSNLINKS  ;
                 N1.CPRVID     := PrVidopl.nrec      ;
                 N1.CNACHISL   := tnachisl.nrec       ;
                 N1.otkuda     := tnachisl.tiprec     ;
                 Insert current N1;

                 level_c :=0;
                 czak_c  :=0;

                 if GetZakazInDoptableNew(
                                       cursch_,cursub_,N1.VIDOPL,N1.CEXOZ,level_c,czak_c
                                      )=True
                 {
                  if level_c<>0
                  {
                    if cursch_=PrVidopl.CSCHETD
                      Update current N1 set N1.TBLD[level_c] := 7,N1.CKAUD[level_c]:=czak_c;
                    else
                    {
                      N1.CSCHETD    := cursch_ ;
                      N1.CSUBSCHD   := cursub_ ;
                      N1.TBLD[level_c] := 7 ;
                      N1.CKAUD[level_c]:=czak_c;
                      Update current N1;
                    }
                  }
                 }
                 else
                  if (N1.VIDOPL=64 and N1.CKAUD[1]=comp(0)) // Add 07072018 Пока по 64 ВидОплу если встретили такое что не определился заказ - то ищем по особому алгоритму...
                 {
                  #SubZapros64
                 }

                 if ( (N1.VIDOPL=68  or N1.VIDOPL=65) and N1.CEX<>N1.CEXOZ)
                 {
                  #SubZapros68
                 }

}

Procedure Insert_DopTable3;
{
      cursch_:=nachisl1.CSCHETD;
      cursub_:=nachisl1.CSUBSCHD;

!                Insert N1 set
                 ClearBuffer(#N1);
!                 N1.TABN       := tnachisl.TABN      ;
                 N1.CEX        := tnachisl.CEX       ;
                 N1.CEXOZ      := if(lschet.kassir1=0,tnachisl.CEXOZ,nrec555)   ;
                 N1.CPODR      := tnachisl.CPODR     ;
!                 N1.CPODROZ    := tnachisl.CPODROZ   ;
                 N1.MES        := tnachisl.MES       ;
                 N1.MESN       := tnachisl.MESN      ;
                 N1.YEARN      := tnachisl.YEARN     ;
                 N1.VIDOPL     := tnachisl.VIDOPL    ;
                 N1.KATEG      := tnachisl.KATEG     ;
                 N1.DATAN      := tnachisl.DATAN     ;
                 N1.DATOK      := tnachisl.DATOK     ;
                 N1.KOLDN      := sumday;//nachisl.KOLDN     ;
                 N1.CHASF      := sumchasf;//nachisl.CHASF     ;
                 N1.SUMMA      := sumkoef           ;
!                 N1.PRIZPR     := tnachisl.PRIZPR    ;
                //ШПЗ тут берем из Nachisl           ;
                 N1.CSCHETD    := nachisl1.CSCHETD ;//nachisl.CSCHETD
                 N1.CSUBSCHD   := nachisl1.CSUBSCHD;//nachisl.CSUBSCHD
                 for(li1:=1;li1<6;li1++)
                 {
                  N1.CKAUD[li1]   := nachisl1.CKAUD[li1];//nachisl.CKAUD[1]
!                  if N1.CKAUD[li1]<>0
!                   break;
                 }
                 for(li1:=1;li1<6;li1++)
                 {
                  N1.TBLD[li1]    := nachisl1.TBLD[li1];//nachisl.TBLD[1]
!                  if nachisl.TBLD[li1]<>0
!                   break;
!                  if N1.TBLD[li1]=7
!                   if nachisl1.czak<>0
!                    N1.CKAUD[li1]:=nachisl1.czak;
                 }

                 N1.CSCHETK    := tnachisl.CSCHETK ;
                 N1.CSUBSCHK   := tnachisl.CSUBSCHK;
                 N1.CKAUK[1]   := tnachisl.CKAUK[1];
                 N1.CKAUK[2]   := tnachisl.CKAUK[2];
                 N1.CKAUK[3]   := tnachisl.CKAUK[3];
                 N1.CKAUK[4]   := tnachisl.CKAUK[4];
                 N1.CKAUK[5]   := tnachisl.CKAUK[5];
                 N1.CKAUK[6]   := tnachisl.CKAUK[6];
                 N1.TBLK[1]    := tnachisl.TBLK[1] ;
                 N1.TBLK[2]    := tnachisl.TBLK[2] ;
                 N1.TBLK[3]    := tnachisl.TBLK[3] ;
                 N1.TBLK[4]    := tnachisl.TBLK[4] ;
                 N1.TBLK[5]    := tnachisl.TBLK[5] ;
                 N1.TBLK[6]    := tnachisl.TBLK[6] ;
                 N1.CLSCH      := tnachisl.CLSCH   ;
                 N1.TPERSON    := tnachisl.TPERSON ;
                 N1.SISOPL     := tnachisl.SISOPL  ;
                 N1.CODTAR     := tnachisl.CODTAR  ;
                 N1.RAZR       := tnachisl.RAZR    ;
                 N1.VIDOPLS    := tnachisl.VIDOPLS  ;
!                 N1.OTKUDA     := tnachisl.OTKUDA   ;
!                 N1.CAPPOINT   := tnachisl.CAPPOINT ;
!                 N1.CHOZOPER   := tnachisl.CHOZOPER ;
                 N1.PARAM      := sparam;//tnachisl.PARAM    ;
!                 N1.CMAINDOC   := tnachisl.CMAINDOC ;
                 N1.DATAV      := tnachisl.DATAV    ;
!                 N1.SUMMAVKL   := tnachisl.SUMMAVKL ;
!                 N1.PROC       := tnachisl.PROC     ;
!                 N1.MINSUM     := tnachisl.MINSUM   ;
                 N1.MESV       := tnachisl.MESV     ;
                 N1.YEARV      := tnachisl.YEARV    ;
                 N1.YEARK      := tnachisl.YEARK    ;
                 N1.KOLDNGR    := tnachisl.KOLDNGR  ;
                 N1.CHASGR     := tnachisl.CHASGR   ;
!                 N1.DATE1      := tnachisl.DATE1    ;
!                 N1.DATE2      := tnachisl.DATE2    ;
!                 N1.DATE3      := tnachisl.DATE3    ;
!                 N1.SUMMA27    := tnachisl.SUMMA27  ;
!                 N1.SUMMA28    := tnachisl.SUMMA28  ;
!                 N1.SUMMA29    := tnachisl.SUMMA29  ;
!                 N1.SUMMA30    := tnachisl.SUMMA30  ;
!                 N1.SUMMA31    := tnachisl.SUMMA31  ;
!                 N1.SUMMA32    := tnachisl.SUMMA32  ;
!                 N1.SUMMA33    := tnachisl.SUMMA33  ;
!                 N1.SUMMA34    := tnachisl.SUMMA34  ;
!                 N1.BRIGADE    := tnachisl.BRIGADE   ;
!                 N1.OLDCLSCH   := tnachisl.OLDCLSCH  ;
                 N1.STRTABN    := tnachisl.STRTABN    ;
                 N1.KAUEXTR[1] := tnachisl.KAUEXTR[1] ;
                 N1.KAUEXTR[2] := tnachisl.KAUEXTR[2] ;
                 N1.KAUEXTR[3] := tnachisl.KAUEXTR[3] ;
                 N1.KAUEXTR[4] := tnachisl.KAUEXTR[4] ;
                 N1.KAUEXTR[5] := tnachisl.KAUEXTR[5] ;
                 N1.KAUEXTR[6] := tnachisl.KAUEXTR[6] ;
                 N1.TBLEXTR[1] := tnachisl.TBLEXTR[1] ;
                 N1.TBLEXTR[2] := tnachisl.TBLEXTR[2] ;
                 N1.TBLEXTR[3] := tnachisl.TBLEXTR[3] ;
                 N1.TBLEXTR[4] := tnachisl.TBLEXTR[4] ;
                 N1.TBLEXTR[5] := tnachisl.TBLEXTR[5] ;
                 N1.TBLEXTR[6] := tnachisl.TBLEXTR[6] ;
!                 N1.CPSNLINKS  := tnachisl.CPSNLINKS  ;
                 N1.CPRVID     := PrVidopl.nrec      ;
                 N1.CNACHISL   := tnachisl.nrec       ;
                 N1.otkuda     := tnachisl.tiprec     ;
                 Insert current N1;

                 level_c :=0;
                 czak_c  :=0;


                 if GetZakazInDoptableNew(
                                       cursch_,cursub_,N1.VIDOPL,N1.CEXOZ,level_c,czak_c
                                      )=True
                 {
                  if level_c<>0
                  {
                    if cursch_=nachisl1.CSCHETD
                      Update current N1 set N1.TBLD[level_c] := 7,N1.CKAUD[level_c]:=czak_c;
                    else
                    {
                      N1.CSCHETD    := cursch_ ;
                      N1.CSUBSCHD   := cursub_ ;
                      N1.TBLD[level_c] := 7 ;
                      N1.CKAUD[level_c]:=czak_c;
                      Update current N1;
                    }
                  }
                 }
                 else
                  if (N1.VIDOPL=64 and N1.CKAUD[1]=comp(0)) // Add 07072018 Пока по 64 ВидОплу если встретили такое что не определился заказ - то ищем по особому алгоритму...
                 {
                   #SubZapros64
                 }

                 if ( (N1.VIDOPL=68 or N1.VIDOPL=65) and N1.CEX<>N1.CEXOZ)
                 {
                  #SubZapros68
                 }
}

