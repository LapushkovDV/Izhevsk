Interface GetMyLs 'Выберите лицевые счета' ,DoAccept;

 table struct tlschet
 (
   nrec    : comp
  ,tperson : comp
  ,tabn    : longint
  ,strtabn : string[20]
  ,datuv   : date
  ,fio     : string[60]
  ,name    : string[120]
  ,cex     : comp
 )
 with index
 (
  in1=strtabn
 ,in2=tabn
 ,in3=fio
 );


  create view
   var Marker: longint ;

   as
  select
   * from 
   tlschet(in3)
  ,persons
  ,katpodr
   where 
   ((
         tlschet.tperson == persons.nrec
    and  tlschet.cex == katpodr.nrec
   ))
   ;

 Browse BrwLs (,,sci1EnIns);
  table tlschet;
   fields

      {font = {color = if( FoundMarker(Marker,tlschet.nrec)=true, /*ColorError*/ColorMark, 0)}};
      tlschet.STRTABN 'Таб. номер' ('Табельный номер работника',hcMarkIt,): [10], protect, noautosize;
      tlschet.FIO 'Работник' ('Фамилия, имя и отчество работника',hcMarkIt,):[28], protect;
      KATPODR.NAME  'Подразделение'('Подразделение',hcMarkIt,):[20],protect;
      KATPODR.kod  'Код'('Подразделение',hcMarkIt,):[20],protect;
      tlschet.DATUV 'Уволен' ('Дата увольнения',hcMarkIt,):[10], protect, noautosize;
 end;

  HandleEvent
    Cminit :{
             Marker := InitMarker('SelMyLs', 8, 200, 100) ;
             ClearMarker(Marker);

             sql select 
              l.nrec
             ,l.tperson
             ,l.tabn
             ,l.strtabn
             ,l.datuv
             ,Coalesce(p.fio,'') as fio
             ,Coalesce(k.name,'') as name
             ,l.cex

            from lschet l left join persons p on l.tperson = p.nrec
                          left join katpodr k on l.cex = k.nrec
              into tlschet byname;

              if getfirst tlschet=tsok {}
            }

    CmMarkUnMark :{

                   if (not FoundMarker(Marker,tlschet.nrec))
                    {
                     InsertMarker(Marker,tlschet.nrec);
                    }
                   else
                    DeleteMarker(Marker,tlschet.nrec);

	               ReDrawCurrentAndGo(GetCurrentFormat, True);
                 }

    cmSelectAll :{
                  PushPos(#tlschet);
                  _loop tlschet
                  {
                   if (not FoundMarker(Marker,tlschet.nrec))
                    {
                     InsertMarker(Marker,tlschet.nrec);
                    }
                  }

                  PushPos(#tlschet);
                  RescanPanel(#tlschet);
               }

   cmUnSelectAll :{
                   ClearMarker(Marker);
                   RescanPanel(#tlschet);
                  }
    CmDefault:{

                 if GetMarkerCount(marker)=0 InsertMarker(Marker,tlschet.nrec);

                 DoneMarker(Marker,'SelMyLs');
              }
  end;
end.
