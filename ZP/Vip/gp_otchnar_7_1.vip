 */
}

end;
end.

VipInterface UserReport_gp_otchnar7_1 Implements IUserReport;
Interface UserReport_gp_otchnar7_1;

Procedure Run;
Begin
  runinterface(gp_otchnar7_1);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Ведомость сдельного заработка по заказам (Предварительная)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Наряды';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
