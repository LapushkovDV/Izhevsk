#include GetKau.Vih
#include GP_ZP_RaspZakazPers.Vih
#component "Z_LSCHET"
Alter Interface LSCHET1;
OverLoad
procedure Lschet_Pick; //Заполнение счета субсчета и КАУ
end;

ExtendFormats ServicesScreen;

#include GetKau.Var
#include GP_Func_ZP.Var

Const
  anY2 = 'Год БЛ';
end;

var wKodAnalitik :word;//код "избранная аналитика"
var pTmp         :comp;

Create view vlschet
as
select
  lGetAttr(coLschet, LSCHET.nrec, anY2) (FieldName = vmYear2)
;


//------------------------------------
// Установить параметры по плану
//------------------------------------
Function SetFieldsByMnPlan(_pMnPlan:comp):boolean;
{ Result:=false;
  #FUNC_ZP_Fill_To_SchKauParam(Lschet,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.SetFieldsByMnPlan(_pMnPlan,PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(Lschet,cSchetD,cSubSchD,cKaud,Tbld)
    Result:=true;
    SetModified(true);
    UpdateTable;
  }
}//Function SetFieldsByMnPlan(_pMnPlan:comp);

//-------------------------------
//проверим субсчет по заказу, если не совпадает поменяем
Procedure Check_Analitic_MnPlan;
{ #FUNC_ZP_Fill_To_SchKauParam(Lschet,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.Check_Analitic_MnPlan(PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(Lschet,cSchetD,cSubSchD,cKaud,Tbld)
    SetModified(true);
    UpdateTable;
  }
} //Procedure Check_Analitic_MnPlan;

procedure Lschet_Pick; //Заполнение счета субсчета и КАУ
{
      var need_Pick:boolean=true;
      case curField of
      #Schetdeb, #SubSchdeb, #NamKaud:
      { if curField=#NamKaud
        { if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed'
        }
        if Schetdeb='' or (QuickChoiceName<>'' and curField=#NamKaud )
        { pTmp:=0;
          if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
          { if  SetFieldsByMnPlan(pTmp)
            { case curField of
              #Schetdeb, #SubSchdeb: need_Pick:=false;
              end;
            }
          }
          if Schetdeb=''
          { message('Задайте счет');
            SelectField(#Schetdeb);
          }


        } //if Schetdeb=''

      } //#Schetdeb, #SubSchdeb, #NamKaud
      end; //case curField of
      //----------------------
      if need_Pick
      { Inherited::Lschet_Pick;
        if curField=#NamKaud //and QuickChoiceName=''
        { Check_Analitic_MnPlan;
        }
      }

      //----------------------

} //procedure Lschet_Pick; //Заполнение счета субсчета и КАУ

screen ServicesScreen (, hclschet, sclschet);
table CurLSchet;
  fields
    vmYear2 ('Расчет по заявлению: вместо второго календарного года', hclschet) : noProtect;

<<







                    `На    ` .@@@@@@@@@@










>>

end; //ServicesScreen

tableevent table CurLSchet;
cmExprFieldChanged:
{
  case CurField of
    #vmYear2:
    {
      lSetAttr(coLschet, CURLSCHET.CLSCHET, anY2, ExprFieldValue);
    }
    else
    {
      case Inherited :: HandleEvent (cmExprFieldChanged) of
        heStop : Stop;
        heAbort: Abort;
      end;
    }
  end;
}
end;


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
  //------------------------
  cmInit:
  { //"Настройки Галактики \ Управление персоналом \ Расчеты с персоналом \ Избранная аналитика"
    wKodAnalitik:=wGetTune('UP.ZAR.FAVORITEANALYTICS');
    //----------------------
    if  inherited :: handleEvent (cmInit)=heAbort then Abort;
    //----------------------
    cfsSetProp('L_SERVICESSCREEN_Первый_год', 'Origin_X', 8);
    cfsSetProp('i_SERVICESSCREEN_LSSUMMA39', 'Origin_X', 95);
    cfsSetProp('i_SERVICESSCREEN_LSSUMMA39', 'Size_X', 80);

    cfsSetProp('L_SERVICESSCREEN_Второй_год', 'Origin_X', 185);
    cfsSetProp('i_SERVICESSCREEN_LSSUMMA40', 'Origin_X', 306);
    cfsSetProp('i_SERVICESSCREEN_LSSUMMA40', 'Size_X', 92);

    cfsSetProp('L_SERVICESSCREEN_На', 'Origin_X', 440);
    cfsSetProp('i_SERVICESSCREEN_vmYear2', 'Origin_X', 538);
    cfsSetProp('i_SERVICESSCREEN_vmYear2', 'Size_X', 84);
  }

  //--------------------------
  cmValue59://Распределение по ГосОборонЗаказам ->GP_MenuZarp.vip->GP_Lschet_HotKeys_Rasp
  { RunInterface('GP_ZP_RaspZakazPers', CURLSCHET.CLSCHET, 0, 0, ZeroDate, ZeroDate, 0);

  }

  //--------------------------
  //
  //buttons cmValue7,,, 'Ввод исходных данных для распределения затрат', hcZarLCcost_sharing, scbut;
  cmValue60://Распределение затрат ->GP_MenuZarp.vip ->GP_Lschet_HotKeys_Rasp
  { RunInterface('CostSharing', CURLSCHET.CLSCHET, 0);

  }
  end;

end.
