/*************************************************************************************************\
* Наименование: Предварительный расчет отпуска                                                    *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Документы / Все приказы по персоналу                                                *
* Примечания:                                                                                     *
* В интерфейс Заработная плата / Операции / Отпуска / Расчет отпускных добавлен параметр          *
* "Предварительный расчёт".                                                                       *
* Если при расчёте отпуска этот параметр включён, то суммы за текущий отчетный месяц не           *
* учитываются при расчёте.                                                                        *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#777          |13/09/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_Sredn"

alter interface RaschetOtpB;

  OverloadFormats FormParOtp_RF;

  screen FormParOtp_RF;
    bevel b1 {1, 4, 2, 5, bsLowered, bsHorizontal};
  fields
     Z_OFlag (, hcRaschetOtpB, sci1Esc): protect;
     ZarOtp ('Установка режима расчета', hcRaschetOtpB, sci1Esc): noProtect;
     FiltrOtpusk ('Наименование выбранного отпуска (<Del> - указать все отпуска)', hcRaschetOtpB, sci13Esc): protect;
     OtpType ('Тип рассчитываемого отпуска', hcRaschetOtpB, sci1Esc): noProtect;
     SaveNdfl ('Признак необходимости cохранения сумм удержаний при наличии реестра на перечисление', hcRaschetOtpB, sci1Esc): noProtect;
   buttons
     cmValue3,,, '~П~араметры расчета отпуска ', hczar_otp_paramRacheta, sci1Esc;
     cmOk,Default,, '~В~вод ', hczar_otp_paramRacheta, sci1Esc;
     cmCancel,,, '~О~тмена', hczar_otp_paramRacheta, sci1Esc;
  << 'Параметры расчета больничных'
`Выполнить расчет`  .@@@
  [.] отпуска  `                <. Параметры расчета отпуска .>
  [.] зарплаты `
  [.] предварительный расчёт `
 ───────────────────────────────────────────────────────────────
  Расчет провести для отпуска
  Вид отпуска   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@,
  выбрав его (их) среди   (.) помеченных отпусков       `
                          (.) отпусков с нулевой суммой `

  [.] cохранять суммы удержаний при наличии реестра на перечисление`

        <.Расчет.>                <.Отмена.>
  >>
  end;

end.
