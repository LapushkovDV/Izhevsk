procedure FillnachislzakazSumByLschet;
{

  insert into nachislzakazSum (Nrec, Summa, VidOpl, VidOplP, NVIDOPL, cLsch, CexOz, cPodrOz, Koldn, MesN, Mes,Summa30,Proc,
                          cSchetD,cSubSchD,cKAUD[1],cKAUD[2],cKAUD[3],cKAUD[4],cKAUD[5],cKAUD[6],
                          TblD[1],TblD[2],TblD[3],TblD[4],TblD[5],TblD[6], sReCalc, YearN, Tek, Podr3, Zakaz)
  select nachislzakaz.Nrec,
         nachislzakaz.Summa,
         nachislzakaz.VidOPlS,
         nachislzakaz.VidOPl,
         tmp_KlVidOpl.NVIDOPL,
         nachislzakaz.cLSch,
         nachislzakaz.CexOz,
         nachislzakaz.cPodr,
         nachislzakaz.Koldn,
         nachislzakaz.MesV,
         nachislzakaz.Mes,
         nachislzakaz.Summa30,
         nachislzakaz.Proc,
         nachislzakaz.cSchetD,
         nachislzakaz.cSubSchD,
         nachislzakaz.cKAUD[1],
         nachislzakaz.cKAUD[2],
         nachislzakaz.cKAUD[3],
         nachislzakaz.cKAUD[4],
         nachislzakaz.cKAUD[5],
         nachislzakaz.cKAUD[6],
         nachislzakaz.TblD[1],
         nachislzakaz.TblD[2],
         nachislzakaz.TblD[3],
         nachislzakaz.TblD[4],
         nachislzakaz.TblD[5],
         nachislzakaz.TblD[6],
         nachislzakaz.Otkuda,
         nachislzakaz.YearV,
         integer(2),
         substr(katpodr.kod,1,3),
         mnplan.number
   from nachislzakaz where ((vSvodZakCex.VIDYear     == nachislzakaz.YearN(noindex)         and
                       vSvodZakCex.VIDMonthN  <<= nachislzakaz.MesN(noindex)          and
                       vSvodZakCex.VIDMonthK  >>= nachislzakaz.MesN(noindex)          and
                       nachislzakaz.CexOz           == KatPodr.Nrec          and
                       nachislzakaz.VidOPlS         == tmp_KlVidOpl.VidOpl   and
                       nachislzakaz.cKAUD[1]        == mnplan.nrec
                      )) and Foundmarker(vSvodZakCex.MarkerVidOpl, tmp_KlVidOpl.Nrec) 
                         and Foundmarker(vSvodZakCex._PodrMArkerPointer, nachislzakaz.CexOz);
//                         and nachislzakaz.Summa != 0 (noindex);
}

procedure FillPerevodByLschet;
{


  insert into tmp_Perevod (VidPer, MonthN, YEARN, Sumper, Oblags,CexOZ, Otkuda, Cnach, cLsch, Tek)
    select perevodtekzakaz.Vidper, 
           perevodtekzakaz.MESN, 
           perevodtekzakaz.YEARN,
           perevodtekzakaz.Sumper, 
           perevodtekzakaz.Oblags, 
           perevodtekzakaz.CexOZ, 
           perevodtekzakaz.Otkuda, 
           perevodtekzakaz.Cnach,
           perevodtekzakaz.cLsch,
           integer(2)
    from perevodtekzakaz where ((vSvodZakCex.VIDYear     == perevodtekzakaz.YearN(noindex) and
                                   vSvodZakCex.VIDMonthN  <<= perevodtekzakaz.MesN(noindex)  and
                                   vSvodZakCex.VIDMonthK  >>= perevodtekzakaz.MesN(noindex)
                          )) and Foundmarker(vSvodZakCex._PodrMArkerPointer, perevodtekzakaz.CexOz);

}

procedure FillTmpLgNalLsZByLschet;
{

  // забьем льготы во временную таблицу
  insert into tmp_LgNalLsZ (NRec, LastUser, LastTime, LastDate, FilialNo, cLschet, VIDPER,
                            Proc, Summa, VIDPER1, Priznak, NomScale, Year, Mes, Proc1, YearEnd, MesEnd)
  select LgNalLsZ.NRec,
         LgNalLsZ.LastUser,
         LgNalLsZ.LastTime,
         LgNalLsZ.LastDate,
         LgNalLsZ.FilialNo,
         LgNalLsZ.cLschet,
         LgNalLsZ.VIDPER,
         LgNalLsZ.Proc,
         LgNalLsZ.Summa,
         LgNalLsZ.VIDPER1,
         LgNalLsZ.Priznak,
         LgNalLsZ.NomScale,
         LgNalLsZ.Year,
         LgNalLsZ.Mes,
         LgNalLsZ.Proc1,
         LgNalLsZ.YearEnd,
         LgNalLsZ.MesEnd
   from LgNalLsZ;

}
//-------------------------------------------------------------------------------
// виды оплаты 
//-------------------------------------------------------------------------------
function fNmVidOplDogStr: string;
var
  liCountMarker : longInt;
  cnRecVidOplDog: comp;
{
  fNmVidOplDogStr := 'Не заданы';

  liCountMarker   := GetMarkerCount(MarkerVidOpl);

  case liCountMarker of
  0:
  {
    exit;
  }
  1:
  {
    GetMarker(MarkerVidOpl, 0, cnRecVidOplDog);
    if ( getFirst KlVidOpl where (( cnRecVidOplDog == KlVidOpl.Nrec )) = tsOk )
    {
      fNmVidOplDogStr := string(KlVidOpl.VidOplP) + ', ' + KlvidOpl.NVidOpl;
    }
  }
  2..4:
  {
    fNmVidOplDogStr := 'Задано ' + string(liCountMarker) + ' вида оплаты';
  }
  else
  {
    fNmVidOplDogStr := 'Задано ' + string(liCountMarker) + ' видов оплаты';
  }
  end;
}//function fNmVidOplDogStr

screen scr1;
fields
  VIDYear      ('За какой год формировать отчета по видам неявок',hcNoContext,sci1Esc):noprotect,spinbutton [1, 1900, 2100];
  VIDMonthN    ('Укажите начальный месяц для формирования отчета',hcNoContext) :
    [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
          ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;
  VIDMonthK     ('Укажите месяц для формирования отчета',hcNoContext) :
    [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
          ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;
  [VidOplDogStr] fNmVidOplDogStr() ('Виды оплаты',, sci13Esc): protect, pickbutton;

  FiltrPodr  ('Фильтр по подразделению', hcNoContext): protect, pickbutton;

buttons
  cmOk,,,'Сформировать отчет', ,sci1Esc;
  cmCancel,,,'Выход', ,sci1Esc;
<<
 `Формировать за год`.@@@@@@     `с`.@@@@@@@@@@@@@ `по`.@@@@@@@@@@@@@

 `Виды оплаты `      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `По подразделениям (цехам) отнесения затрат:`
                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. ~С~формировать .>                            <.    ~О~тмена    .>

>>
end;

HandleEvent

cmInit:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);

  InitUser(1); // Инициализация Zar_User
  // Инициализация отчетных дат данными из настроек
  InitCurrentPeriodDates();

  if (not ReadMyDsk(VIDYear, 'VIDYear_SvodZakCex', false))
    set VIDYear := Word(YearRas);

  if (not ReadMyDsk(VIDMonthN, 'VIDMonthN_SvodZakCex', false))
    VIDMonthN := 1; // Январь (нумерация в списке с нуля).

  if (not ReadMyDsk(VIDMonthK, 'VIDMonthK_SvodZakCex', false))
    VIDMonthK := MonthRas;

  MarkerVidOpl := InitMarker('mVidoplDog_SvodZakCex', 8, 10, 10);

  if not ReadMyDsk(Filtrpodr,'k_Filtrpodr',false)
    {}
  mrkOuterClassfier:=InitMarker('FOT_NIK_mrkOuterClassfier',8,20,10); //маркер с отмеченными классификаторами

  if GetMarkerCount(mrkOuterClassfier) = 0
    MarkerNotNull:= false;
  else MarkerNotNull:=true;

  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  mtClear(#tmp_KlVidOpl, mfNormal);
  mtClear(#tmp_Perech, mfNormal);

  insert into tmp_KlVidOpl
  select KlVidOpl.Nrec, 
         KlVidOpl.Vidopl, 
         KlVidOpl.VidoplP, 
         KlVidOpl.NVIDOPL, 
         Trim(KlVidopl.VHVOE[19]),
         Trim(KlVidopl.VHVOE[32]), 
         Trim(KlVidopl.VHVOE[34]),
         Trim(KlVidopl.VHVOE[35]), 
         Trim(KlVidopl.VHVOE[5])
  from KlVidOpl;

  insert into tmp_Perech
  select Perech.VidPer, 
         Perech.NAMEPER
  from Perech;

  StopVisual('', 0);
}

cmUpdateRecord : update current zar_user;

cmCheckField:
{
  case CurField of
    #VIDYear:
    {
      if (VIDYear < 1900) or (VIDYear > YearRas) then
        Set VIDYear := Word(YearRas);
      if (VIDYear = YearRas) and (VIDMonthK > MonthRas) then
        Set VIDMonthK := Word(MonthRas);
    }

    #VIDMonthN:
    {
      if (VIDMonthN > VIDMonthK)
        set VIDMonthN := VIDMonthK;
    }

    #VIDMonthK:
    {
      if (VIDYear = YearRas) and (VIDMonthK > MonthRas) then
        Set VIDMonthK := Word(MonthRas);
      if (VIDMonthN > VIDMonthK)
        set VIDMonthN := VIDMonthK;
    }
  end;  //case
  PodrPubCheck; //Процедура для фильтров по подразд. и работникам
  RedrawPanel(#Zar_User);
}//cmCheckField

cmDelOnProtect:
{
  case CurField of
  #VidOplDogStr:
  //виды оплаты по договорам
  {
    ClearMarker(MarkerVidOpl);
    RedrawPanel(CurTable);
  }
  end;
}

cmPick:
{
  if CurField = #VidOplDogStr
  {
    cTemp := comp(0);
    RunInterface(Z_Calc::PickZarEntity , 1, cTemp, 103, MarkerVidOpl)
  }

  PodrPubPick; //Процедура для фильтров по подразд. и работникам
  RedrawPanel(#Zar_User);
} // cmPick

cmOk:
{

  intinit;

  update current Zar_User;

  if not FillMarks then  // Заполнение Formarks
  {
    abort;
    exit;
  }

  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  if GetMarkerCount(MarkerVidOpl) = 0
  {
         Message(chr(3)+'Нет задан фильтр "Виды оплаты"', Information + OkButton);
         abort;
         exit;
  }

  var nom:integer;
  var Numcol:integer;
  nom:=2;
  Numcol:=1;

  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);

  ExcelPath:= TranslatePath('%ClientStartPath%');
                                                                                                          
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\SvodZakCex.xlsx',true);
  if (xlIsExcelValid)   xlSetActiveSheet(1);//активный лист

  XLPAGESETUPSETORIENTATION(xlLandscape);//альбомный лист
  XLPAGESETUPSETPAPERSIZE(xlPaperA4);//формат листа А4

  xlSetCellStringValue('Cводка отчислений по видам оплат по заказам и цехам c '+DateToStr(date(1,VIDMonthN,VIDYear), 'mon')
      +' по '+DateToStr(date(1,VIDMonthK,VIDYear), 'month')+' '+DateToStr(date(1,VIDMonthK,VIDYear), 'YYYY года'), 1, 3, 1, 3);
  xlSetFontStyle(xlBold, 1, 3, 1, 3);
  xlSetFontSize(18, 1, 3, 1, 3);

  StopVisual('', 0);

  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Обработка информации...', 1);

  mtClear(#nachislzakazSum, mfNormal);
  mtClear(#tmp_LgNalLsZ, mfNormal);
  mtClear(#tmp_Perevod, mfNormal);
 
  // заполняем временную таблицу для подсчета
  FillnachislzakazSumByLschet;
  // льготы по налогам на ФОТ
  FillTmpLgNalLsZByLschet;
  //налоги на ФОТ
  FillPerevodByLschet;

  StopVisual('', 0);

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Формирование отчета...', RecordsInTable(#nachislzakazSum));

  p5 := p2_ := p3 := p11 := p12 := p8_1 := p8_2 := s8_1 := s8_2 := 0;
  Itog_p5 := Itog_p2 := Itog_p3 := Itog_p11 := Itog_p12 := Itog_p8_1 := Itog_p8_2 := Itog_s8_1 := Itog_s8_2 := 0;
  Vsego_p5 := Vsego_p2 := Vsego_p3 := Vsego_p11 := Vsego_p12 := Vsego_p8_1 := Vsego_p8_2 := Vsego_s8_1 := Vsego_s8_2 := 0;

  nom:=4;

  SummaVidOp := Itog_SummaVidOp := Vsego_SummaVidOp := 0;

  ZakCex_Zakaz := ZakCex_cSchetD  := ZakCex_Podr3 := '';
  ZakCex_VidOplP  := 0;

  If getfirst fastfirstrow nachislzakazSum  = tsok
  {

    ZakCex_VidOplP  := nachislzakazSum.VidOplP;
    ZakCex_NVIDOPL  := nachislzakazSum.NVIDOPL;
    ZakCex_Podr3    := nachislzakazSum.Podr3;
    ZakCex_cSchetD  := nachislzakazSum.cSchetD;
    ZakCex_Zakaz    := nachislzakazSum.Zakaz;

  }

  _loop FullCache nachislzakazSum
  {

    if not NextVisual
      break;

    if ZakCex_VidOplP  != nachislzakazSum.VidOplP or
       ZakCex_Podr3    != nachislzakazSum.Podr3   or
       ZakCex_Zakaz    != nachislzakazSum.Zakaz   or  ZakCex_cSchetD  != nachislzakazSum.cSchetD
    {
      Numcol:=1;
      xlSetCellStringValue(ZakCex_VidOplP            , ++nom,   Numcol, nom, Numcol);
      xlSetCellStringValue(ZakCex_NVIDOPL            ,   nom, ++Numcol, nom, Numcol);

      xlSetCellStringValue(ZakCex_Podr3              ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(ZakCex_cSchetD            ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(ZakCex_Zakaz              ,   nom, ++Numcol, nom, Numcol);

      xlSetCellStringValue(SummaVidOp                ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p5                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p2_                       ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p3                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p11                       ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p12                       ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p8_1                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p8_2                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(p5+p2_+p3+p11+p12+p8_1+p8_2,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(s8_1                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(s8_2                      ,   nom, ++Numcol, nom, Numcol);
  
      ZakCex_VidOplP  := nachislzakazSum.VidOplP;
      ZakCex_NVIDOPL  := nachislzakazSum.NVIDOPL;
      ZakCex_Podr3    := nachislzakazSum.Podr3;
      ZakCex_Zakaz    := nachislzakazSum.Zakaz;

      SummaVidOp      := 0;

      p5 := p2_ := p3 := p11 := p12 := p8_1 := p8_2 := s8_1 := s8_2 := 0;

    }//ZakCex_VidOplP  != nachislzakazSum.VidOplP

    if ZakCex_cSchetD  != nachislzakazSum.cSchetD
    {
      Numcol:=1;

      xlSetCellStringValue('Итого по СЧЕТУ ' + ZakCex_cSchetD , ++nom,   Numcol, nom, Numcol);
    
      Numcol += 4;

      xlSetCellStringValue(Itog_SummaVidOp           ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_p5                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_p2                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_p3                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_p11                       ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_p12                       ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_p8_1                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_p8_2                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_p5+Itog_p2+Itog_p3+Itog_p11+Itog_p12+Itog_p8_1+Itog_p8_2,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_s8_1                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Itog_s8_2                      ,   nom, ++Numcol, nom, Numcol);

      xlMergeCells(nom, 1, nom, 5);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  
      ZakCex_cSchetD  := nachislzakazSum.cSchetD;

      Itog_SummaVidOp := 0;

      Itog_p5 := Itog_p2 := Itog_p3 := Itog_p11 := Itog_p12 := Itog_p8_1 := Itog_p8_2 := Itog_s8_1 := Itog_s8_2 := 0;
    }//ZakCex_cSchetD  != nachislzakazSum.cSchetD

    SummaVidOp       += nachislzakazSum.Summa;
    Itog_SummaVidOp  += nachislzakazSum.Summa;
    Vsego_SummaVidOp += nachislzakazSum.Summa;

    _loop FullCache tmp_Perevod
    {

      if tmp_Perevod.VidPer = 5
      {
        p5      += tmp_Perevod.Sumper;
        Itog_p5 += tmp_Perevod.Sumper;
        Vsego_p5 += tmp_Perevod.Sumper;
      }

      if tmp_Perevod.VidPer = 2
      {
        p2_     += tmp_Perevod.Sumper;
        Itog_p2 += tmp_Perevod.Sumper;
        Vsego_p2 += tmp_Perevod.Sumper;
      }

      if tmp_Perevod.VidPer = 3
      {
        p3      += tmp_Perevod.Sumper;
        Itog_p3 += tmp_Perevod.Sumper;
        Vsego_p3 += tmp_Perevod.Sumper;
      }

      if tmp_Perevod.VidPer = 11
      {
        p11      += tmp_Perevod.Sumper;
        Itog_p11 += tmp_Perevod.Sumper;
        Vsego_p11 += tmp_Perevod.Sumper;
      }

      if tmp_Perevod.VidPer = 12
      {
        p12      += tmp_Perevod.Sumper;
        Itog_p12 += tmp_Perevod.Sumper;
        Vsego_p12 += tmp_Perevod.Sumper;
      }

      if tmp_Perevod.VidPer = 8
      {

//          if getfirst fastfirstrow tmp_LgNalLsZ = tsOk
//          {

		if round(tmp_Perevod.sumper/tmp_Perevod.OBLAGS,4)=0.0012
		{
                p8_2      += tmp_Perevod.Sumper;
                Itog_p8_2 += tmp_Perevod.Sumper;
	        Vsego_p8_2 += tmp_Perevod.Sumper;
                s8_2      += nachislzakazSum.Summa;
                Itog_s8_2 += nachislzakazSum.Summa;
                Vsego_s8_2 += nachislzakazSum.Summa;
		}
		else
		{
                p8_1      += tmp_Perevod.Sumper;
                Itog_p8_1 += tmp_Perevod.Sumper;
                Vsego_p8_1 += tmp_Perevod.Sumper;		
                s8_1      += nachislzakazSum.Summa;
                Itog_s8_1 += nachislzakazSum.Summa;
                Vsego_s8_1 += nachislzakazSum.Summa;		
		}
       }

//	}	
/*
          //отмена льгот
          if ((substr(tmp_LgNalLsZ.LastUser,1,1) = ' ')
                or (substr(tmp_LgNalLsZ.LastUser,1,1) = '')
                or (substr(tmp_LgNalLsZ.LastUser,1,1) = 4))
                and (tmp_LgNalLsZ.NomScale = 0)
                and (tmp_LgNalLsZ.Proc = 100)
          {
              p8_1      += tmp_Perevod.Sumper;
              Itog_p8_1 += tmp_Perevod.Sumper;
              Vsego_p8_1 += tmp_Perevod.Sumper;
              s8_1      += nachislzakazSum.Summa;
              Itog_s8_1 += nachislzakazSum.Summa;
              Vsego_s8_1 += nachislzakazSum.Summa;
          }
          else
          {

              p8_2      += tmp_Perevod.Sumper;
              Itog_p8_2 += tmp_Perevod.Sumper;
              Vsego_p8_2 += tmp_Perevod.Sumper;
              s8_2      += nachislzakazSum.Summa;
              Itog_s8_2 += nachislzakazSum.Summa;
              Vsego_s8_2 += nachislzakazSum.Summa;
          }
        }
        else
        {
          p8_1      += tmp_Perevod.Sumper;
          Itog_p8_1 += tmp_Perevod.Sumper;
          Vsego_p8_1 += tmp_Perevod.Sumper;
          s8_1      += nachislzakazSum.Summa;
          Itog_s8_1 += nachislzakazSum.Summa;
          Vsego_s8_1 += nachislzakazSum.Summa;
        }
*/
!      }

    }//_loop FullCache tmp_Perevod

  }//_loop FullCache nachislzakazSum

  if SummaVidOp != 0
  {
    Numcol:=1;
    xlSetCellStringValue(ZakCex_VidOplP            , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(ZakCex_NVIDOPL            ,   nom, ++Numcol, nom, Numcol);

    xlSetCellStringValue(ZakCex_Podr3              ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(ZakCex_cSchetD            ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(ZakCex_Zakaz              ,   nom, ++Numcol, nom, Numcol);

    xlSetCellStringValue(SummaVidOp                ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p5                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p2_                       ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p3                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p11                       ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p12                       ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p8_1                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p8_2                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p5+p2_+p3+p11+p12+p8_1+p8_2,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(s8_1                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(s8_2                      ,   nom, ++Numcol, nom, Numcol);

  }//ZakCex_VidOplP  != nachislzakazSum.VidOplP

  if Itog_SummaVidOp  != 0
  {
    Numcol := 1;

    xlSetCellStringValue('Итого по Счету ' + ZakCex_cSchetD , ++nom,   Numcol, nom, Numcol);
  
    Numcol += 4;

    xlSetCellStringValue(Itog_SummaVidOp                ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p5                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p2                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p3                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p11                       ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p12                       ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p8_1                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p8_2                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_p5+Itog_p2+Itog_p3+Itog_p11+Itog_p12+Itog_p8_1+Itog_p8_2,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_s8_1                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog_s8_2                      ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 5);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

  }//ZakCex_cSchetD  != nachislzakazSum.cSchetD

  if Vsego_SummaVidOp  != 0
  {
    Numcol := 1;

    xlSetCellStringValue('ВСЕГО'                        , ++nom,   Numcol, nom, Numcol);
  
    Numcol += 4;

    xlSetCellStringValue(Vsego_SummaVidOp                ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_p5                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_p2                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_p3                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_p11                       ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_p12                       ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_p8_1                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_p8_2                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_p5+Vsego_p2+Vsego_p3+Vsego_p11+Vsego_p12+Vsego_p8_1+Vsego_p8_2,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_s8_1                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Vsego_s8_2                      ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 5);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

  }//ZakCex_cSchetD  != nachislzakazSum.cSchetD

  xlWrapText(5, 1, nom, Numcol);//перенос по словам
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB + xlInsideV + xlInsideH,
                      xlThin, xlContinuous, 0, 5, 1, nom, Numcol);//рамка xlThick - жирная

  StopVisual('',0);
  xlkillExcel;

  exitproc;

}

cmClose:
{
  SaveMyDSK(VIDYear,   'VIDYear_SvodZakCex');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_SvodZakCex');
  SaveMyDSK(VIDMonthK, 'VIDMonthK_SvodZakCex');
  DoneMarker(MarkerVidOpl, 'mVidoplDog_SvodZakCex');
}

cmDone:
{
  SaveMyDSK(VIDYear,   'VIDYear_SvodZakCex');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_SvodZakCex');
  SaveMyDSK(VIDMonthK, 'VIDMonthK_SvodZakCex');
  DoneMarker(MarkerVidOpl, 'mVidoplDog_SvodZakCex');
}

end;
end.

#include UserReport.vih

VipInterface UserReport_gp_SvodZakCex Implements IUserReport;
Interface UserReport_gp_SvodZakCex;

Procedure Run;
Begin
  runinterface(gp_SvodZakCex);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Cводка отчислений по видам оплат по заказам и цехам';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.


