#doc
Расшифровка базы страховых взносов
для начисления страховых взносов на обязательное пенсионное(медицинское) страхование
#end

Interface GP_Base_Of_Insurance 'Расшифровка базы страховых взносов', EscClose;
Show at (,,50,14);

//---------------------------------------------
Table struct tmp_sbor
(  Pa:word      // "1 - начисления,2 перечисления, 3 удержания"
  ,VidoplP :word
  ,Summa :double
  ,PR    :word
  ,StrTabn:string[30]
  ,Fio    :string[100]
)
with index
( tmp_sbor01 = PA+VidoplP
 ,tmp_sbor02 = Fio+StrTabn
);

//---------------------------------------------
Table struct tmp_su12
(  Pa:word
  ,Summa :array [1..12] of double

)
with index
( tmp_su12 = PA
);

Table struct Tmp_Report
(  TBL:string[10]
  ,Row:string[10]
  ,sRow:string
  ,sVidOplP:string
  ,Summa: Double
)
with index
( Tmp_Report01=TBL+ROW
);
//--------------------------------------
Var
  //---------------
  iCatFunc            : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  iQBuilder:GP_QueryBuilder new;
  //для стандартного фильтра по подразделению
  PAF:  TraditionalPersonalAccountFilter;
  CLSF:      CurLSFunctions;
  //-----------------------
  viCYPersons         : ChoiseYourPersons;
  //-----------------------
  wMesB,wMesE, wYear:word;
  wTypeSB :word  ;//0 - за который, 1 в котором
  All_Su   :double;// итоговая сумма
  sPopdis  :string;// подпись отчета
  sDolg    :string;// подпись отчета
  sUserName:string;// пользователь
  ExecuteErrorCode:longint; //код ошибки SQL запросов
  dm_su:array[1..20] of double;
  wVidPer  :longint;
  wPodrR   :word;//наличие фильтра по подразделению
#include Excel_Var.vpp
  //-----------------------------------------
  // Фильтры - базовые
  //-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
   isFilterRun  :boolean;////признак работы ограничений
   wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;
   #mrkfld_(KatPodr)
   DepList:longint;

Create view
var
 sTbl:string;
as select KlVidopl.Nrec, Tmp_Sbor.*, Tmp_report.*,tmp_su12.*
, (PAF.GetDepartmentFilterStr)  (fieldname = FiltrPodr)

from KlVidopl
  , Tmp_Sbor, Tmp_report(Tmp_Report01),tmp_su12
  , Perech
where
((  sTbl == Tmp_report.TBL
and sUserName    == ZAR_USER.OWNNAME

));
//------------------------------------
Create view vSpr
var
  pPerson :comp;
From Persons, Appointments
where
((  pPerson == Persons.Nrec
and Persons.Appointcur == Appointments.Nrec
));

//--------------------------------
Create  view vZar_User
var
   pPodr:comp;
as select Zar_User.Nrec
From
   Zar_User
  ,USERRIGHTS
where
((   sUserName  == Zar_User.OwnName
and  sUserName  == USERRIGHTS.OWNNAME
));
