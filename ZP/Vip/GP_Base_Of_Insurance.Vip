  procedure SetupDepartments(Change: comp);
  {
    var p2: double;    // для компиляции
    var PrCex: comp;
    PrCex := ZAR_USER.CURCEX;
    RunInterface('GetPodaln', Change, prCex, p2);
  }

//=======================================
  SQL QUERY SqlTmp_Nach =
       SELECT
          COALESCE(SubString(EXCLASSSEG.NAME,1,1),'')  TBL//:word
         ,COALESCE(SubString(EXCLASSSEG.NAME,3,2),'')  Row//:word
         ,COALESCE(SubString(EXCLASSSEG.NAME,6,200),'') sRow
         ,COALESCE(EXCLASSSEG.Value,'') sVidOplP
         ,Sum(Nachisl.Summa) as Summa
       From  KlVidopl
       Inner join ExClassName on  ExClassName.wTable=15010 //57 Classcode
                                      and  ExClassName.Name  ='Налогооблагаемая база по страховым взносам'
       Inner join exclassval on exclassval.classcode = EXCLASSNAME.classcode
                            and exclassval.wtable    = ExClassName.wTable
                            and exclassval.crec      = KlVidopl.Nrec
       Inner join exclassseg on exclassseg.nrec = exclassval.cclassseg
       inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:sUserName) ) //Filter_User
       Left Outer join Nachisl on Nachisl.Vidopls = KlVidopl.Vidopl
       and  (ZU.POdrShare <> '+'
          or (Nachisl.cexoz in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
          )
       %Filter_Nach
       %FilterP_Nach
       Group by
          COALESCE(SubString(EXCLASSSEG.NAME,1,1),'')
         ,COALESCE(SubString(EXCLASSSEG.NAME,3,2),'')
         ,COALESCE(SubString(EXCLASSSEG.NAME,6,200),'')
         ,COALESCE(EXCLASSSEG.Value,'')
       ;
//=======================================
  SQL QUERY SqlTmp_NeNach =
        SELECT
          COALESCE(SubString(EXCLASSSEG.NAME,1,1),'')  TBL//:word
         ,COALESCE(SubString(EXCLASSSEG.NAME,3,2),'')  Row//:word
         ,COALESCE(SubString(EXCLASSSEG.NAME,6,200),'') sRow
         ,COALESCE(EXCLASSSEG.Value,'') sVidOplP
         ,Sum(NeNach.Summa) as Summa
       From NeNach
       inner join KlVidopl on KlVidopl.Vidopl = NeNach.Vidopls
       Inner join ExClassName on  ExClassName.wTable=15010 //57 Classcode
                                      and  ExClassName.Name  ='Налогооблагаемая база по страховым взносам'
       Inner join exclassval on exclassval.classcode = EXCLASSNAME.classcode
                            and exclassval.wtable    = ExClassName.wTable
                            and exclassval.crec      = KlVidopl.Nrec
       Inner join exclassseg on exclassseg.nrec = exclassval.cclassseg
       inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:sUserName))
       //тут записей мало чего плодить Left Outer
       and
          (ZU.POdrShare <> '+'
          or (NeNach.cexoz in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
          )
       %Filter_NeNach
       %FilterP_NeNach
       Group by
          COALESCE(SubString(EXCLASSSEG.NAME,1,1),'')
         ,COALESCE(SubString(EXCLASSSEG.NAME,3,2),'')
         ,COALESCE(SubString(EXCLASSSEG.NAME,6,200),'')
         ,COALESCE(EXCLASSSEG.Value,'')
       ;
//=======================================
  SQL QUERY SqlTmp_SumVidop =
        SELECT
          COALESCE(SubString(EXCLASSSEG.NAME,1,1),'')  TBL//:word
         ,COALESCE(SubString(EXCLASSSEG.NAME,3,2),'')  Row//:word
         ,COALESCE(SubString(EXCLASSSEG.NAME,6,200),'') sRow
         ,COALESCE(EXCLASSSEG.Value,'') sVidOplP
         ,Sum(SumVidop.Summa) as Summa
       //From SumVidop
       //Inner join KlVidopl on KlVidopl.Vidopl = SumVidop.Vidopl
       From  SumVidop
       inner join KlVidopl on KlVidopl.Vidopl = SumVidop.Vidopl
       Inner join ExClassName on  ExClassName.wTable=15010 //57 Classcode
                                      and  ExClassName.Name  ='Налогооблагаемая база по страховым взносам'
       Inner join exclassval on exclassval.classcode = EXCLASSNAME.classcode
                            and exclassval.wtable    = ExClassName.wTable
                            and exclassval.crec      = KlVidopl.Nrec
       Inner join exclassseg on exclassseg.nrec = exclassval.cclassseg
       inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:sUserName))
       //left outer
       //inner join SumVidop on KlVidopl.Vidopl = SumVidop.Vidopl
       where
          (ZU.POdrShare <> '+'
          or (SumVidop.cexoz in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
          )
       %Filter_SumVidop
       %FilterP_SumVidop
       Group by
          COALESCE(SubString(EXCLASSSEG.NAME,1,1),'')
         ,COALESCE(SubString(EXCLASSSEG.NAME,3,2),'')
         ,COALESCE(SubString(EXCLASSSEG.NAME,6,200),'')
         ,COALESCE(EXCLASSSEG.Value,'')
       ;
