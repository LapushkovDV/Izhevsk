Procedure SaveParam;
{ SaveMyDsk(wMesB ,'GP_Base_Of_Insurance_wMesB' );
  SaveMyDsk(wMesE ,'GP_Base_Of_Insurance_wMesE' );
  SaveMyDsk(wYear,'GP_Base_Of_Insurance_wYear' );
  SaveMyDsk(wTypeSB,'GP_Base_Of_Insurance_wTypeSB' );//0 - за который, 1 в котором
  SaveMyDsk(sPopdis,'GP_Base_Of_Insurance_sPopdis' );//
  SaveMyDsk(sDolg  ,'GP_Base_Of_Insurance_sDolg  ' );
  SaveMyDsk(wFilter,'GP_Base_Of_Insurance_wFilter' );

} //Procedure SaveParam;

//------------------------------------
//
//------------------------------------
Procedure ReadParam;
{ if not ReadMyDsk(wMesB  ,'GP_Base_Of_Insurance_wMesB'  ,false) wMesB  :=MonthRas;
  if not ReadMyDsk(wMesE  ,'GP_Base_Of_Insurance_wMesE'  ,false) wMesE  :=MonthRas;
  if not ReadMyDsk(wYear  ,'GP_Base_Of_Insurance_wYear'  ,False) wYear  :=YearRas;
  if not ReadMyDsk(wTypeSB,'GP_Base_Of_Insurance_wTypeSB',False) wTypeSB:=1;//0 - за который, 1 в котором
  if not ReadMyDsk(sPopdis,'GP_Base_Of_Insurance_sPopdis',False) sPopdis:=sGetTune('USER.FIO');//
  if not ReadMyDsk(sDolg  ,'GP_Base_Of_Insurance_sDolg  ',False) sDolg  :='Начальник отдела расчетов с персоналом';
  if not ReadMyDsk(wFilter,'GP_Base_Of_Insurance_wFilter',False) wFilter:=0;

} //Procedure ReadParam;

//--------------------------------
// Создадим и наполним временную таблицу фильтром по подразделению
//--------------------------------
Procedure FillTempVib;
{     stmt:=0;
    CreateTempVib;
    wPodrR:=0;
    if IsBitCTW(wFilter,1)
    { wPodrR:=wPodrR+2;
      InsTempVibByMarker(01,DepList       );// Подразделения
    }
    else
    if vZar_User.getfirst ZAR_USER=tsok
     if vZar_User.ZAR_USER.PODRSHARE = '+'
     { wPodrR:=wPodrR+1;
       vZar_User._Loop USERRIGHTS
         InsTempVibOne(01,vZar_User.USERRIGHTS.crecds);//
     }


} //Procedure FillTempVib;

