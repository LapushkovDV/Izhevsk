#include PAFilter.vih
#include UserReport.vih

interface GP_SvodVneBud 'Сводка отчислений во внебюджетные фонды' EscClose, Gray;
  show at (,,80,10);

table struct SvodVneBud
(
nmfunc : string,
kod    : string,
name   : string,
vidper : word,
sumper : double   
)
with index
(
SvodVneBud1 = nmfunc + kod + name + vidper
)
;

table struct SvodVneBudTek
(
nmfunc : string,
kod    : string,
name   : string,
vidper : word,
sumper : double   
)
with index
(
SvodVneBudTek1 = nmfunc + kod + name + vidper
)
;

const
  xlBold      = 1;
  xlItalic    = 2;
  xlUnderline = 4;
  xlLandscape=                         2;
  xlPaperA4=                           9;
  xlBorderL   = 1;
  xlBorderR   = 2;
  xlBorderT   = 4;
  xlBorderB   = 8;
  xlInsideH   = 16;
  xlInsideV   = 32;
  xlDiagonalD = 64;
  xlDiagonalU = 128;
  xlThin     = 2;
  xlContinuous    =  1;

end;

create view gp_SvodVneBud

var
  ExcelPath: string;
  i: integer;
  YearFill    : integer;
  MonthBeg,
  MonthEnd   : word;

from 
  SvodVneBud
, SvodVneBudTek
, Perech
;

screen scr ('Параметры отчета',,sci178EnEscInsPM);
!  show at (,,,1)
  fields
  YearFill:         NoProtect, spinbutton [1, 1900, 2100];
  MonthBeg('Отчетный месяц', ,sci13Esc):
                 [LIST 1
                 'Январь',
                 'Февраль',
                 'Март',
                 'Апрель',
                 'Май',
                 'Июнь',
                 'Июль',
                 'Август',
                 'Сентябрь',
                 'Октябрь',
                 'Ноябрь',
                 'Декабрь'
                 ] Protect;
  MonthEnd('Отчетный месяц',,sci13Esc):
                 [LIST 1
                 'Январь',
                 'Февраль',
                 'Март',
                 'Апрель',
                 'Май',
                 'Июнь',
                 'Июль',
                 'Август',
                 'Сентябрь',
                 'Октябрь',
                 'Ноябрь',
                 'Декабрь'
                 ] Protect;

buttons
    cmGo, ,, 'Сформировать отчет' ,,;
    <<
   `Год`.@@@@@`Месяц с`.@@@@@@@@@@`Месяц по`.@@@@@@@@@@

    <.Сформировать отчет.>

    >>

end;

handleevent

cmInit:
{

  // Инициализация отчетных дат данными из настроек
  InitCurrentPeriodDates();

  if (not ReadMyDSK(YearFill, 'YearFill_SvodVneBud', false))
          YearFill := YearRas;
  if (not ReadMyDSK(MonthBeg, 'MonthBeg_SvodVneBud', false))
          MonthBeg := MonthRas;
  if (not ReadMyDSK(MonthEnd, 'MonthEnd_SvodVneBud', false))
          MonthEnd := MonthRas;

}

cmCheckField:
{
  if CurField = #MonthBeg
  {
     if MonthBeg > MonthEnd
       MonthBeg := MonthEnd
  }
  if CurField = #MonthEnd
  {
     if MonthBeg > MonthEnd
       MonthEnd := MonthBeg
  }
}

cmGo:
{

  var nom:integer;
  var Numcol:integer;
  nom:=2;
  Numcol:=1;

  xlCreateExcel('Сводка отчислений во внебюджетные фонды',true);

  XLPAGESETUPSETORIENTATION(xlLandscape);//альбомный лист
  XLPAGESETUPSETPAPERSIZE(xlPaperA4);//формат листа А4

  xlSetCellStringValue('Сводка отчислений во внебюджетные фонды c '+DateToStr(date(1,MonthBeg,YearFill), 'mon')
      +' по '+DateToStr(date(1,MonthEnd,YearFill), 'month')+' '+DateToStr(date(1,MonthBeg,YearFill), 'YYYY года'), 2, 1, 2, 1);
  xlSetFontStyle(xlBold, 2, 1, 2, 1);
  xlSetFontSize(18, 2, 1, 2, 1);

  xlMergeCells(++nom, numCol, nom, numCol);
  xlSetCellStringValue('Тип подразделения',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(15, nom, Numcol, nom, Numcol); //ширина ячейки

  xlMergeCells(nom, ++numCol, nom, numCol);
  xlSetCellStringValue('Подразделение',nom, Numcol, nom, Numcol);
  xlSetColumnWidth(50, nom, Numcol, nom, Numcol); //ширина ячейки

  xlMergeCells(nom, ++numCol, nom, numCol);
  if GetFirst fastfirstrow Perech where ((5  == Perech.VidPer )) = tsOk
    xlSetCellStringValue(PERECH.NAMEPER,nom, Numcol, nom, Numcol);
  xlSetColumnWidth(15, nom, Numcol, nom, Numcol); //ширина ячейки

  xlMergeCells(nom, ++numCol, nom, numCol);
  if GetFirst fastfirstrow Perech where ((11  == Perech.VidPer )) = tsOk
    xlSetCellStringValue(PERECH.NAMEPER,nom, Numcol, nom, Numcol);
  xlSetColumnWidth(15, nom, Numcol, nom, Numcol); //ширина ячейки

  xlMergeCells(nom, ++numCol, nom, numCol);
  if GetFirst fastfirstrow Perech where ((12  == Perech.VidPer )) = tsOk
    xlSetCellStringValue(PERECH.NAMEPER,nom, Numcol, nom, Numcol);
  xlSetColumnWidth(15, nom, Numcol, nom, Numcol); //ширина ячейки

  xlMergeCells(nom, ++numCol, nom, numCol);
  xlSetCellStringValue('Всего',nom, Numcol, nom, Numcol);
  xlSetColumnWidth(15, nom, Numcol, nom, Numcol); //ширина ячейки

  xlMergeCells(nom, ++numCol, nom, numCol);
  if GetFirst fastfirstrow Perech where ((3  == Perech.VidPer )) = tsOk
    xlSetCellStringValue(PERECH.NAMEPER,nom, Numcol, nom, Numcol);
  xlSetColumnWidth(15, nom, Numcol, nom, Numcol); //ширина ячейки

  xlMergeCells(nom, ++numCol, nom, numCol);
  if GetFirst fastfirstrow Perech where ((2  == Perech.VidPer )) = tsOk
    xlSetCellStringValue(PERECH.NAMEPER,nom, Numcol, nom, Numcol);
  xlSetColumnWidth(15, nom, Numcol, nom, Numcol); //ширина ячейки

  xlMergeCells(nom, ++numCol, nom, numCol);
  if GetFirst fastfirstrow Perech where ((8  == Perech.VidPer )) = tsOk
    xlSetCellStringValue(PERECH.NAMEPER,nom, Numcol, nom, Numcol);
  xlSetColumnWidth(15, nom, Numcol, nom, Numcol); //ширина ячейки

  xlMergeCells(nom, ++numCol, nom, numCol);
  xlSetCellStringValue('ИТОГО',nom, Numcol, nom, Numcol);
  xlSetColumnWidth(15, nom, Numcol, nom, Numcol); //ширина ячейки

StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Обработка информации', 1);

delete all SvodVneBud;
delete all SvodVneBudTek;

sql
select
DEPFUNC.nmfunc,
substring(katpodr1.kod,1,3),
katpodr1.name,
perevod.vidper,
sum(perevod.sumper)
from katpodr
left join katpodr katpodr1 on substring(katpodr.kod,1,3) = katpodr1.kod
left join depfunc on katpodr1.cfunc = depfunc.cfunc
left join perevod on katpodr.nrec=perevod.cexoz and (perevod.vidper = 2 or perevod.vidper = 3 or perevod.vidper = 5 or perevod.vidper = 8 or perevod.vidper = 11 or perevod.vidper = 12 or perevod.vidper = 14)
  where perevod.yearn = :(YearFill) and perevod.mesn >= :(MonthBeg) and perevod.mesn <= :(MonthEnd)
group by
katpodr1.name,
substring(katpodr1.kod,1,3),
perevod.vidper,
DEPFUNC.nmfunc
into SvodVneBud
;

sql
select
DEPFUNC.nmfunc,
substring(katpodr1.kod,1,3),
katpodr1.name,
perevodTek.vidper,
sum(perevodTek.sumper)
from katpodr
left join katpodr katpodr1 on substring(katpodr.kod,1,3) = katpodr1.kod
left join depfunc on katpodr1.cfunc = depfunc.cfunc
left join perevodTek on katpodr.nrec=perevodTek.cexoz and (perevodTek.vidper = 2 or perevodTek.vidper = 3 or perevodTek.vidper = 5 or perevodTek.vidper = 8 or perevodTek.vidper = 11 or perevodTek.vidper = 12 or perevodtek.vidper = 14)
  where perevodTek.yearn = :(YearFill) and perevodTek.mesn >= :(MonthBeg) and perevodTek.mesn <= :(MonthEnd)
group by
katpodr1.name,
substring(katpodr1.kod,1,3),
perevodTek.vidper,
DEPFUNC.nmfunc
into SvodVneBudTek
;

_loop SvodVneBudTek
{
  If getfirst fastfirstrow SvodVneBud where((SvodVneBudTek.nmfunc  == SvodVneBud.nmfunc
                                            and SvodVneBudTek.kod     == SvodVneBud.kod   
                                            and SvodVneBudTek.name    == SvodVneBud.name  
                                            and SvodVneBudTek.vidper  == SvodVneBud.vidper
                                           )) = tsok
  {
    SvodVneBud.sumper += SvodVneBudTek.sumper;
    update current SvodVneBud;
  }
  else
  {

    ClearBuffer(#SvodVneBud);
//    SvodVneBud.Buffer := SvodVneBudTek.Buffer ;  
    SvodVneBud.nmfunc  := SvodVneBudTek.nmfunc  ;
    SvodVneBud.kod     := SvodVneBudTek.kod ;  
    SvodVneBud.name    := SvodVneBudTek.name;  
    SvodVneBud.vidper  := SvodVneBudTek.vidper;
    SvodVneBud.sumper  := SvodVneBudTek.sumper ;
    insert current SvodVneBud;

  }
}

StopVisual('',0);

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Формирование отчета...', RecordsInTable(#SvodVneBud));

  nom:=3;
  var Itog,d5,d11,d12,d5_11_12,d3,d2,d8 : double;
  var KB_Itog,KB_d5,KB_d11,KB_d12,KB_d5_11_12,KB_d3,KB_d2,KB_d8 : double;
  var Podr_Itog,Podr_d5,Podr_d11,Podr_d12,Podr_d5_11_12,Podr_d3,Podr_d2,Podr_d8 : double;
  var KB_nmfunc : string='';
  var KB_Podr : string='';
  Itog := d5 := d11 := d12 := d5_11_12 := d3 := d2 := d8 := 0;
  Podr_Itog := Podr_d5 := Podr_d11 := Podr_d12 := Podr_d5_11_12 := Podr_d3 := Podr_d2 := Podr_d8 := 0;
  KB_Itog := KB_d5 := KB_d11 := KB_d12 := KB_d5_11_12 := KB_d3 := KB_d2 := KB_d8 := 0;

  If getfirst fastfirstrow SvodVneBud  = tsok
  {
    KB_nmfunc := SvodVneBud.nmfunc;
    KB_Podr   := SvodVneBud.Kod +', '+SvodVneBud.Name;
  }

  _loop SvodVneBud
  {

    if not NextVisual
      break;

    if (KB_Podr <> SvodVneBud.Kod +', '+SvodVneBud.Name)  or (KB_nmfunc <> SvodVneBud.nmfunc)
    {
      Numcol:=1;
      xlSetCellStringValue(KB_nmfunc                        , ++nom,   Numcol, nom, Numcol);
      xlSetCellStringValue(KB_Podr                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Podr_d5                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Podr_d11                         ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Podr_d12                         ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Podr_d5_11_12                    ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Podr_d3                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Podr_d2                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Podr_d8                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Podr_Itog                        ,   nom, ++Numcol, nom, Numcol);

      KB_Podr := SvodVneBud.Kod +', '+SvodVneBud.Name;
      Podr_Itog := Podr_d5 := Podr_d11 := Podr_d12 := Podr_d5_11_12 := Podr_d3 := Podr_d2 := Podr_d8 := 0;
    }

    if KB_nmfunc <> SvodVneBud.nmfunc
    {

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по '+KB_nmfunc       , ++nom,   Numcol, nom, Numcol);
      xlSetCellStringValue(''                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(KB_d5                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(KB_d11                         ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(KB_d12                         ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(KB_d5_11_12                    ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(KB_d3                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(KB_d2                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(KB_d8                          ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(KB_Itog                        ,   nom, ++Numcol, nom, Numcol);

      KB_nmfunc := SvodVneBud.nmfunc;
      KB_Itog := KB_d5 := KB_d11 := KB_d12 := KB_d5_11_12 := KB_d3 := KB_d2 := KB_d8 := 0;
    }

    if SvodVneBud.vidper = 5
    {
      d5 += SvodVneBud.sumper;
      KB_d5 += SvodVneBud.sumper;
      Podr_d5 += SvodVneBud.sumper;
    }

    if SvodVneBud.vidper = 11
    {
      d11 += SvodVneBud.sumper;
      KB_d11 += SvodVneBud.sumper;
      Podr_d11 += SvodVneBud.sumper;
    }

    if SvodVneBud.vidper = 12
    {
      d12 += SvodVneBud.sumper;
      KB_d12 += SvodVneBud.sumper;
      Podr_d12 += SvodVneBud.sumper;
    }

    if SvodVneBud.vidper = 5 or SvodVneBud.vidper = 11 or SvodVneBud.vidper = 12
    {
      d5_11_12 += SvodVneBud.sumper;
      KB_d5_11_12 += SvodVneBud.sumper;
      Podr_d5_11_12 += SvodVneBud.sumper;
    }

    if SvodVneBud.vidper = 3
    {
      d3 += SvodVneBud.sumper;
      KB_d3 += SvodVneBud.sumper;
      Podr_d3 += SvodVneBud.sumper;
    }

    if SvodVneBud.vidper = 2
    {
      d2 += SvodVneBud.sumper;
      KB_d2 += SvodVneBud.sumper;
      Podr_d2 += SvodVneBud.sumper;
    }

    if SvodVneBud.vidper = 8
    {
      d8 += SvodVneBud.sumper;
      KB_d8 += SvodVneBud.sumper;
      Podr_d8 += SvodVneBud.sumper;
    }

    Itog += SvodVneBud.sumper;
    KB_Itog += SvodVneBud.sumper;
    Podr_Itog += SvodVneBud.sumper;
  }

  if Podr_Itog != 0 or KB_Itog != 0 or Itog != 0
  {

    Numcol:=1;
    xlSetCellStringValue(KB_nmfunc                        , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(KB_Podr                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Podr_d5                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Podr_d11                         ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Podr_d12                         ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Podr_d5_11_12                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Podr_d3                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Podr_d2                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Podr_d8                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Podr_Itog                        ,   nom, ++Numcol, nom, Numcol);

  }

  if KB_Itog != 0 or Itog != 0
  {

    Numcol:=1;
    xlSetCellStringValue('ИТОГО по '+KB_nmfunc       , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(''                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(KB_d5                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(KB_d11                         ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(KB_d12                         ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(KB_d5_11_12                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(KB_d3                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(KB_d2                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(KB_d8                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(KB_Itog                        ,   nom, ++Numcol, nom, Numcol);

  }

  if Itog != 0
  {
    Numcol:=1;
    xlSetCellStringValue('ИТОГО по Предприятию'      , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(''                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(d5                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(d11                         ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(d12                         ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(d5_11_12                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(d3                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(d2                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(d8                          ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Itog                        ,   nom, ++Numcol, nom, Numcol);
  }

  xlWrapText(3, 1, nom, Numcol);//перенос по словам
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB + xlInsideV + xlInsideH,
                      xlThin, xlContinuous, 0, 3, 1, nom, Numcol);//рамка xlThick - жирная

  StopVisual('',0);
  xlkillExcel;

}

cmClose:
{
  SaveMyDSK(YearFill, 'YearFill_SvodVneBud');
  SaveMyDSK(MonthBeg, 'MonthBeg_SvodVneBud');
  SaveMyDSK(MonthEnd, 'MonthEnd_SvodVneBud');
}

cmDone:
{
  SaveMyDSK(YearFill, 'YearFill_SvodVneBud');
  SaveMyDSK(MonthBeg, 'MonthBeg_SvodVneBud');
  SaveMyDSK(MonthEnd, 'MonthEnd_SvodVneBud');
}
end;
end.

VipInterface UserReport_gp_SvodVneBud Implements IUserReport;
Interface UserReport_gp_SvodVneBud;

Procedure Run;
Begin
  runinterface(gp_SvodVneBud);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Сводка отчислений во внебюджетные фонды';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := '';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
