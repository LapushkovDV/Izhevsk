* Наименование:  Форма 0553102 "Распределение заработной платы по счетам и заказам."              *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Ведомость распределения ЗП по балансовым счетам                                  *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#811          |28/01/18|Валента А.В.             |НПО Энергомаш                    *
* Разработка  |#51414        |23/05/23|kurennykh                |НПО Энергомаш                    *
* Разработка  |#51415        |23/05/23|kurennykh                |НПО Энергомаш                    *
* Разработка  |#NaN          |06/06/23|kurennykh                |НПО Энергомаш                    *
* Разработка  |#56306        |17/08/23|kurennykh                |НПО Энергомаш                    *
\*************************************************************************************************/


#include UserReport.vih

#doc
      #51414  Добавив графы <Наименование заказа>, <Статус заказа> и наличия/отсутствия НЗП

      #51415  Добавить графу "Нормо-часы" (информация из СФ30)

      06/06/23  Попросили поменять внешний вид таблицы

      #56306  Сальдо н-часов из БУ и фильтр по счетам
#end

interface gp_VedRasprZP 'Ведомость распределения ЗП по балансовым счетам' EscClose, Gray;
  show at (,,60,17);

table struct TmpVedRasprZP
(
  csch    : string
, number  : string
, mnname  : string
, mnstat  : string
, kod     : string
, sal     : double
, salhrs  : double
, hrs     : double
, sum1    : double
, sum2    : double
, sum3    : double
, per1    : double
, per2    : double
, per3    : double
, per4    : double
, per5    : double
, per6    : double
)
with index
(
  TmpVedRasprZP1 = csch + number + kod
, TmpVedRasprZP2 = kod + csch + number
)
;

table struct TmpVedRasprZPTek
(
  csch    : string
, number  : string
, mnname  : string
, mnstat  : string
, kod     : string
, sal     : double
, salhrs  : double
, hrs     : double
, sum1    : double
, sum2    : double
, sum3    : double
, per1    : double
, per2    : double
, per3    : double
, per4    : double
, per5    : double
, per6    : double
)
with index
(
  TmpVedRasprZPTek1 = csch + number + kod //+ Name
, TmpVedRasprZPTek2 = csch + number
)
;

table struct TmpSal
(
  csch    : string
, number  : string
, mnname  : string
, mnstat  : string
, kod     : string
, wtype   : word
, sal     : double
)
with index
(
  i01 = csch + number
, i02 = wtype
);

const
  xlBold        = 1;
  xlItalic      = 2;
  xlUnderline   = 4;
  xlLandscape   = 2;
  xlPaperA4     = 9;
  xlBorderL     = 1;
  xlBorderR     = 2;
  xlBorderT     = 4;
  xlBorderB     = 8;
  xlInsideH     = 16;
  xlInsideV     = 32;
  xlDiagonalD   = 64;
  xlDiagonalU   = 128;
  xlThin        = 2;
  xlContinuous  = 1;

end;

create view vVedRasprZP

var
  ExcelPath: string;
  i,srcdat: integer;
  YearFill    : integer;
  MonthBeg,
  MonthEnd   : word;
  wUse30_31  : word;
  wUseSaldH  : word;
  wUseSchet  : word = 31;
  dbeg,dend : date;
as select
  TmpVedRasprZP.*
, TmpVedRasprZPTek.*
from 
  TmpVedRasprZP
, TmpVedRasprZPTek
, TmpSal
;

screen scr ('Параметры отчета',,sci178EnEscInsPM);
!  show at (,,,1)
  fields
  YearFill:         NoProtect, spinbutton [1, 1900, 2100];
  MonthBeg('Отчетный месяц', ,sci13Esc):
                 [LIST 1
                 'Январь',
                 'Февраль',
                 'Март',
                 'Апрель',
                 'Май',
                 'Июнь',
                 'Июль',
                 'Август',
                 'Сентябрь',
                 'Октябрь',
                 'Ноябрь',
                 'Декабрь'
                 ] Protect;
  MonthEnd('Отчетный месяц',,sci13Esc):
                 [LIST 1
                 'Январь',
                 'Февраль',
                 'Март',
                 'Апрель',
                 'Май',
                 'Июнь',
                 'Июль',
                 'Август',
                 'Сентябрь',
                 'Октябрь',
                 'Ноябрь',
                 'Декабрь'
                 ] Protect;
   srcdat       :[LIST 1 'По данным модуля з/п','по сформированным проводкам'],protect;

    wUse30_31 : noProtect, noFrame;
    wUseSaldH : noProtect, noFrame;
    wUseSchet : noProtect;
buttons
    cmGo, ,, 'Сформировать отчет' ,,;
    <<
   `Год`.@@@@@`Месяц с`.@@@@@@@@@@`Месяц по`.@@@@@@@@@@
   .@@@@@@@@@@@@@@@@@@@@@@@@@@@

   [:] Без 30 и 31 видов оплат`
   [:] Выводить вх. сальдо н-ч по СФ.30`

   Использовать счета БУ
   [.] 20`
   [.] 23`
   [.] 25`
   [.] 26`
   [.] 29`

    <.Сформировать отчет.>
    >>

end;

handleevent

cmInit:
{

  // Инициализация отчетных дат данными из настроек
  InitCurrentPeriodDates();

  if (not ReadMyDSK(YearFill, 'YearFill_VedRasprZP', false))
          YearFill := YearRas;
  if (not ReadMyDSK(MonthBeg, 'MonthBeg_VedRasprZP', false))
          MonthBeg := MonthRas;
  if (not ReadMyDSK(MonthEnd, 'MonthEnd_VedRasprZP', false))
          MonthEnd := MonthRas;
  if (not ReadMyDSK(wUse30_31, 'wUse30_31_VedRasprZP', false))
          wUse30_31 := 0;

  srcdat:=1;
  dbeg:=date(1,MonthBeg,YearFill);  
  dend:=date(last_day(date(1,MonthEnd,YearFill)),MonthEnd,YearFill);
}

cmCheckField:
{
  if CurField = #MonthBeg
  {
     if MonthBeg > MonthEnd
       MonthBeg := MonthEnd;

     dbeg:=date(1,MonthBeg,YearFill); 
  }
  if CurField = #MonthEnd
  {
     if MonthBeg > MonthEnd
       MonthEnd := MonthBeg;

     dend:=date(last_day(date(1,MonthEnd,YearFill)),MonthEnd,YearFill);
  }
  if (CurField = #srcdat)
  {
    if (srcdat = 1) then
    {}
    else
    {
      wUseSaldH := 0;
    }
  }
}

cmGo:
{

  var nom:integer;
  var Numcol:integer;
  nom:=2;
  Numcol:=1;

  ExcelPath:= TranslatePath('%ClientStartPath%');

  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\VedRasprZP.xlsx',true);
  if (xlIsExcelValid)   xlSetActiveSheet(1);//активный лист

  XLPAGESETUPSETORIENTATION(xlLandscape);//альбомный лист
  XLPAGESETUPSETPAPERSIZE(xlPaperA4);//формат листа А4

  xlSetCellStringValue('Ведомость распределения ЗП по балансовым счетам c '+DateToStr(date(1,MonthBeg,YearFill), 'mon')
      +' по '+DateToStr(date(1,MonthEnd,YearFill), 'month')+' '+DateToStr(date(1,MonthBeg,YearFill), 'YYYY года'), 1, 3, 1, 3);
  xlSetFontStyle(xlBold, 1, 3, 1, 3);
  xlSetFontSize(18, 1, 3, 1, 3);


  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Обработка информации', 1);

  delete all TmpVedRasprZP;
  delete all TmpVedRasprZPTek;
  delete all TmpSal;



  if srcdat = 1
  {
    sql
    select
      case when (s.subossch <> '') then substring(s.scheto, 2, 2) + '.' + s.subossch else substring(s.scheto, 2, 2) end                   as csch
    , mnplan.number                                                   as number
    , mnplan.name                                                     as mnname
    , katnotes.name                                                   as mnstat
    , katpodr.kod + ',' + katpodr.name                                as kod
    , 0                                                               as wtype
    , sum(case when s.viob = 1 then s.sums else -1.0 * s.sums end)    as sal
    from saldmoun s
    inner join katpodr on s.kauos[1] = katpodr.nrec
    inner join mnplan on s.kauos[3] = mnplan.nrec
    left join katnotes on mnplan.cstatus = katnotes.nrec
    where s.scheto in ('020', '023')
          and s.datesal = :(dbeg)
    group by   case when (s.subossch <> '') then substring(s.scheto, 2, 2) + '.' + s.subossch else substring(s.scheto, 2, 2) end
             , mnplan.number
             , mnplan.name
             , katnotes.name
             , katpodr.kod + ',' + katpodr.name
    into TmpSal;

    if (wUseSaldH = 1) then
    {
      sql
      select
        case when (bs.subsch <> '') then substring(bs.schet, 2, 2) + '.' + bs.subsch else substring(bs.schet, 2, 2) end                   as csch
      , mnplan.number                                                   as number
      , mnplan.name                                                     as mnname
      , katnotes.name                                                   as mnstat
      , katpodr.kod + ',' + katpodr.name                                as kod
      , 1                                                               as wtype
      , sum(case when s.viob = 1 then s.sums else -1.0 * s.sums end)    as sal
      from saldmoun s
      inner join buhschet bs on s.kauos[5] = bs.nrec
      inner join katpodr on s.kauos[4] = katpodr.nrec
      inner join mnplan on s.kauos[2] = mnplan.nrec
      left join katnotes on mnplan.cstatus = katnotes.nrec
      where     s.scheto = '7СФ'
            and s.subossch = '30'
            and bs.schet in ('020', '023')
            and s.datesal = :(dbeg)
      group by   case when (bs.subsch <> '') then substring(bs.schet, 2, 2) + '.' + bs.subsch else substring(bs.schet, 2, 2) end
               , mnplan.number
               , mnplan.name
               , katnotes.name
               , katpodr.kod + ',' + katpodr.name
      into TmpSal;
    }

    sql
    select
      case when (nachislzakaz.csubschd <> '') then nachislzakaz.cschetd+'.'+nachislzakaz.csubschd else nachislzakaz.cschetd end
    , mnplan.number
    , mnplan.name
    , katnotes.name
    , substring(katpodr1.kod,1,3)+','+katpodr1.name
    , 0.0
    , 0.0
    , sum(case when nachislzakaz.vidopl in (1, 3, 5, 9,  10) then nachislzakaz.chasf else 0.0 end)
    , sum(nachislzakaz1.summa)
    , sum(nachislzakaz2.summa)
    , sum(nachislzakaz3.summa)
    , sum(perevodtekzakaz1.sumper)
    , sum(perevodtekzakaz2.sumper)
    , sum(perevodtekzakaz3.sumper)
    , sum(perevodtekzakaz4.sumper)
    , sum(perevodtekzakaz5.sumper)
    , sum(perevodtekzakaz6.sumper)
    from katpodr
          left join katpodr katpodr1 on substring(katpodr.kod,1,3) = katpodr1.kod
          left join nachislzakaz on katpodr.nrec=nachislzakaz.cexoz
          left join mnplan on mnplan.nrec = nachislzakaz.ckaud[1]
          left join katnotes on mnplan.cstatus = katnotes.nrec
          left join klvidopl on klvidopl.vidopl = nachislzakaz.vidopls
          left join stzatr on stzatr.nrec = klvidopl.kauextr[1]
          left join nachislzakaz nachislzakaz1 on nachislzakaz1.nrec = nachislzakaz.nrec and nachislzakaz1.vidopls = klvidopl.vidopl
                                              and klvidopl.kauextr[1] = stzatr.nrec and stzatr.name in ('01 Основная з/плата','Основная з/плата, включая Премии')
          left join nachislzakaz nachislzakaz2 on nachislzakaz2.nrec = nachislzakaz.nrec and nachislzakaz2.vidopls = klvidopl.vidopl
                                              and klvidopl.kauextr[1] = stzatr.nrec and stzatr.name in ('02 Дополнительная з/плата','Дополнительная з/плата')
          left join nachislzakaz nachislzakaz3 on nachislzakaz3.nrec = nachislzakaz.nrec and nachislzakaz3.vidopls = klvidopl.vidopl
                                              and klvidopl.kauextr[1] = stzatr.nrec and stzatr.name = '04 Премии'
          left join perevodtekzakaz on nachislzakaz.nrec = perevodtekzakaz.cnach and (perevodtekzakaz.vidper = 5)
          left join perevodtekzakaz perevodtekzakaz1 on perevodtekzakaz.cnach = perevodtekzakaz1.cnach and perevodtekzakaz1.vidper=2
          left join perevodtekzakaz perevodtekzakaz2 on perevodtekzakaz.cnach = perevodtekzakaz2.cnach and perevodtekzakaz2.vidper=3
          left join perevodtekzakaz perevodtekzakaz3 on perevodtekzakaz.cnach = perevodtekzakaz3.cnach and perevodtekzakaz3.vidper=5
          left join perevodtekzakaz perevodtekzakaz4 on perevodtekzakaz.cnach = perevodtekzakaz4.cnach and perevodtekzakaz4.vidper=8
          left join perevodtekzakaz perevodtekzakaz5 on perevodtekzakaz.cnach = perevodtekzakaz5.cnach and perevodtekzakaz5.vidper=11
          left join perevodtekzakaz perevodtekzakaz6 on perevodtekzakaz.cnach = perevodtekzakaz6.cnach and (perevodtekzakaz6.vidper=12 or perevodtekzakaz6.vidper=14)
    where (nachislzakaz.yearn = :(YearFill) and nachislzakaz.mesn >= :(MonthBeg) and nachislzakaz.mesn <= :(MonthEnd))
       and nachislzakaz.cschetd<>'96' and nachislzakaz.cschetd<>'69'  and nachislzakaz.cschetd<>'91' and nachislzakaz.cschetd<>'76'
       and nachislzakaz.vidopl<>181 and nachislzakaz.vidopl<>182
    //20180517 >>>>
       and (0= :(wUse30_31) or  (nachislzakaz.vidopl<>30 and nachislzakaz.vidopl<>31))
    //20180517 <<<<<
       and substring(katpodr1.kod,1,3)<>'446'
    group by
      case when (nachislzakaz.csubschd <> '') then nachislzakaz.cschetd+'.'+nachislzakaz.csubschd else nachislzakaz.cschetd end
    , mnplan.number
    , mnplan.name
    , katnotes.name
    , substring(katpodr1.kod,1,3)+','+katpodr1.name
    into TmpVedRasprZPTek;
  }
  else
  {
    sql
    select
      t1.schsub
    , '' //t1.number
    , '' //t1.name
    , '' //t1.stat
    , t1.podr
    , Sum(t1.sal) as sal
    , Sum(t1.salhrs) as salhrs
    , Sum(t1.hrs) as hrs
    , Sum(t1.sumosn) as sumosn
    , Sum(t1.sumdop) as sumdop
    , Sum(t1.sumprem) as sumprem
    , Sum(t1.sumfss) as sumfss
    , Sum(t1.summedik) as summedik
    , Sum(t1.sumpens) as sumpens
    , Sum(t1.sumtravm) as sumtravm
    , Sum(t1.sumspis1) as sumspis1
    , Sum(t1.sumspis2) as sumspis2
    from
     (
       select
         case when (ob.subossch <> '') then Substring(ob.scheto,2,2) ||'.'|| ob.subossch else Substring(ob.scheto,2,2) end as schsub
       , mn.number
       , mn.name
       , katnotes.name
       , substring(podr.kod,1,3) || ',' || podr.name as podr
       , Cast(0 as double) as sal
       , Cast(0 as double) as salhrs
       , Cast(0 as double) as hrs
       , Case when st.name in ('01 Основная з/плата','Основная з/плата, включая Премии') then ob.sumob else Cast(0 as double) end as sumosn
       , Case when st.name in ('02 Дополнительная з/плата','Дополнительная з/плата') then ob.sumob else Cast(0 as double) end as sumdop
       , Case when st.name='04 Премии' then ob.sumob else Cast(0 as double) end as sumprem
       , Cast(0 as double) as sumpens
       , Cast(0 as double) as summedik
       , Cast(0 as double) as sumfss
       , Cast(0 as double) as sumtravm
       , Cast(0 as double) as sumspis1
       , Cast(0 as double) as sumspis2
       from oborot ob left join mnplan mn on ob.kauos[3]= mn.nrec
                      inner join stzatr st on ob.kauos[2] = st.nrec
                             and st.name in ('01 Основная з/плата','02 Дополнительная з/плата','04 Премии','Основная з/плата, включая Премии','Дополнительная з/плата')
                      inner join katpodr podr on ob.kodspo=podr.nrec
                      left join katnotes on mn.cstatus = katnotes.nrec
       where (
                  ob.scheto='020'
                  or  ob.scheto='023'
                  or (ob.scheto='025' and ob.subossch='01')
                  or (ob.scheto='026' and ob.subossch='01')
                  or ob.scheto='029'
                 )
                 and ob.schetk<>'096'
                 and ob.datob>=:(dbeg) and ob.datob<=:(dend)

       union all

       select
         case when (ob.subossch <> '') then Substring(ob.scheto,2,2) ||'.'|| ob.subossch else Substring(ob.scheto,2,2) end as schsub
       , mn.number
       , mn.name
       , katnotes.name
       , substring(podr.kod,1,3) || ',' || podr.name as podr
       , Cast(0 as double) as sal
       , Cast(0 as double) as salhrs
       , Cast(0 as double) as hrs
       , Cast(0 as double) as sumosn
       , Cast(0 as double) as sumdop
       , Cast(0 as double) as sumprem
       , Case When ob.subschk='021' then ob.sumob else Cast(0 as double) end as sumpens
       , Case When ob.subschk='031' then ob.sumob else Cast(0 as double) end as summedik
       , Case When ob.subschk='01' then ob.sumob else Cast(0 as double) end as sumfss
       , Case When ob.subschk='011' then ob.sumob else Cast(0 as double) end as sumtravm
       , Case When ob.subschk='025' then ob.sumob else Cast(0 as double) end as sumspis1
       , Case When ob.subschk='026' then ob.sumob else Cast(0 as double) end as sumspis2
       from oborot ob left join mnplan mn on ob.kauos[3] = mn.nrec
                      inner join stzatr st on ob.kauos[2] = st.nrec and st.name in ('69 Отчисления с з/платы', 'Отчисления с з/платы')
                      inner join katpodr podr on ob.kodspo=podr.nrec and substring(podr.kod,1,3)<>'446'
                      left join katnotes on mn.cstatus = katnotes.nrec
        where (
                  (
                  ob.scheto='020'
                  or  ob.scheto='023'
                  or (ob.scheto='025' and ob.subossch='01')
                  or (ob.scheto='026' and ob.subossch='01')
                  or ob.scheto='029'
                  )
                   and ob.schetk='069'
                 )
                 and ob.datob>=:(dbeg) and ob.datob<=:(dend)

       union all

       select
         case when (s.subossch <> '') then Substring(s.scheto,2,2) ||'.'|| s.subossch else Substring(s.scheto,2,2) end as schsub
       , mn.number
       , mn.name
       , katnotes.name
       , substring(podr.kod,1,3) || ',' || podr.name as podr
       , case when (s.viob = 1) then s.sums else -1.0 * s.sums end as sal
       , Cast(0 as double) as salhrs
       , Cast(0 as double) as hrs
       , Cast(0 as double) as sumosn
       , Cast(0 as double) as sumdop
       , Cast(0 as double) as sumprem
       , Cast(0 as double) as sumpens
       , Cast(0 as double) as summedik
       , Cast(0 as double) as sumfss
       , Cast(0 as double) as sumtravm
       , Cast(0 as double) as sumspis1
       , Cast(0 as double) as sumspis2
       from saldmoun s left join mnplan mn on s.kauos[3] = mn.nrec
                      inner join stzatr st on s.kauos[2] = st.nrec
                      inner join katpodr podr on s.kodspo=podr.nrec and substring(podr.kod,1,3) <> '446'
                      left join katnotes on mn.cstatus = katnotes.nrec
       where s.scheto in ('020', '023', '029')
             and s.datesal = :(dbeg)

       union all

       select
         case when (bs.subsch <> '') then Substring(bs.schet,2,2) ||'.'|| bs.subsch else Substring(bs.schet,2,2) end as schsub
       , mn.number
       , mn.name
       , katnotes.name
       , '01,НПО "Энергомаш"' as podr
       , Cast(0 as double) as sal
       , Cast(0 as double) as salhrs
       , ob.sumob as hrs
       , Cast(0 as double) as sumosn
       , Cast(0 as double) as sumdop
       , Cast(0 as double) as sumprem
       , Cast(0 as double) as sumpens
       , Cast(0 as double) as summedik
       , Cast(0 as double) as sumfss
       , Cast(0 as double) as sumtravm
       , Cast(0 as double) as sumspis1
       , Cast(0 as double) as sumspis2
       from oborot ob left join mnplan mn on ob.kauos[2] = mn.nrec
                      left join katnotes on mn.cstatus = katnotes.nrec
                      inner join buhschet bs on ob.kauos[5] = bs.nrec

       where     ob.scheto = '7СФ'
             and ob.subossch = '30'
             and ob.schetk = '7СФ'
             and ob.subschk = '00'
             and ob.datob >= :(dbeg) and ob.datob <= :(dend)

     )t1
    group by t1.schsub,t1.podr
    into TmpVedRasprZPTek;
  }

  if MonthBeg<=4 and MonthEnd>=4 and YearFill=2024
  {
    sql
    select
         buhschet.code
       , mnplan.number
       , mnplan.name
       , ''
       , katpodr.kod+', '+katpodr.name as podr
       , Cast(0 as double) as sal
       , Cast(0 as double) as salhrs
       , Cast(0 as double) as hrs
       , Cast(0 as double) as sumosn
       , Cast(0 as double) as sumdop
       , Cast(0 as double) as sumprem
       , Cast(0 as double) as sumpens
       , Cast(0 as double) as summedik
       , Cast(0 as double) as sumfss
       , sum(oborot.sumob) as sumtravm
       , Cast(0 as double) as sumspis1
       , Cast(0 as double) as sumspis2
       from oborot
       left join mnplan on oborot.kauos[3]=mnplan.nrec
       left join katpodr on oborot.kauos[1]=katpodr.nrec
       left join buhschet on buhschet.nrec = mnplan.canval2
       where oborot.nodok in ('001478','001479','001480') and datob=#date(30,04,2024)
       and oborot.scheto in ('020', '023', '025', '026', '029')
       group by katpodr.kod,katpodr.name ,mnplan.number,buhschet.code,mnplan.name
    into TmpVedRasprZPTek;

  }

_loop TmpVedRasprZPTek
{


  If getfirst fastfirstrow TmpVedRasprZP where((TmpVedRasprZPTek.csch  == TmpVedRasprZP.csch
                                            and TmpVedRasprZPTek.number  == TmpVedRasprZP.number  
                                            and TmpVedRasprZPTek.kod     == TmpVedRasprZP.kod   
                                           )) = tsok
  {
    TmpVedRasprZP.sal   += TmpVedRasprZPTek.sal;
    TmpVedRasprZP.salhrs+= TmpVedRasprZPTek.salhrs;
    TmpVedRasprZP.hrs   += TmpVedRasprZPTek.hrs;
    TmpVedRasprZP.sum1  += TmpVedRasprZPTek.sum1;
    TmpVedRasprZP.sum2  += TmpVedRasprZPTek.sum2;
    TmpVedRasprZP.sum3  += TmpVedRasprZPTek.sum3;
    TmpVedRasprZP.per1  += TmpVedRasprZPTek.per1;
    TmpVedRasprZP.per2  += TmpVedRasprZPTek.per2;
    TmpVedRasprZP.per3  += TmpVedRasprZPTek.per3;
    TmpVedRasprZP.per4  += TmpVedRasprZPTek.per4;
    TmpVedRasprZP.per5  += TmpVedRasprZPTek.per5;
    TmpVedRasprZP.per6  += TmpVedRasprZPTek.per6;
    update current TmpVedRasprZP;
  }
  else
  {

    ClearBuffer(#TmpVedRasprZP);
//    VedRasprZP.Buffer := VedRasprZPTek.Buffer   
    TmpVedRasprZP.csch  := trim(TmpVedRasprZPTek.csch);
    TmpVedRasprZP.number:= trim(TmpVedRasprZPTek.number);
    TmpVedRasprZP.mnname:= trim(TmpVedRasprZPTek.mnname);
    TmpVedRasprZP.mnstat:= trim(TmpVedRasprZPTek.mnstat);
    TmpVedRasprZP.kod   := TmpVedRasprZPTek.kod;   
    TmpVedRasprZP.sal   := TmpVedRasprZPTek.sal;
    TmpVedRasprZP.salhrs:= TmpVedRasprZPTek.salhrs;
    TmpVedRasprZP.hrs   := TmpVedRasprZPTek.hrs;
    TmpVedRasprZP.sum1  := TmpVedRasprZPTek.sum1;
    TmpVedRasprZP.sum2  := TmpVedRasprZPTek.sum2;
    TmpVedRasprZP.sum3  := TmpVedRasprZPTek.sum3;
    TmpVedRasprZP.per1  := TmpVedRasprZPTek.per1;
    TmpVedRasprZP.per2  := TmpVedRasprZPTek.per2;
    TmpVedRasprZP.per3  := TmpVedRasprZPTek.per3;
    TmpVedRasprZP.per4  := TmpVedRasprZPTek.per4;
    TmpVedRasprZP.per5  := TmpVedRasprZPTek.per5;
    TmpVedRasprZP.per6  := TmpVedRasprZPTek.per6;
    insert current TmpVedRasprZP;

  }
}

  _Loop TmpSal
  {
    if (TmpSal.wType = 0) then
    {
      if getFirst FastFirstRow TmpVedRasprZP where ((       TmpSal.csch     == TmpVedRasprZP.csch
                                                        and TmpSal.number   == TmpVedRasprZP.number
                                                        //and TmpSal.kod      == TmpVedRasprZP.kod
                                                   )) = tsOk
      {
        TmpVedRasprZP.sal   += TmpSal.sal;
        Update Current TmpVedRasprZP;
      }
    }
    if (TmpSal.wType = 1) then
    {
      if getFirst FastFirstRow TmpVedRasprZP where ((       TmpSal.csch     == TmpVedRasprZP.csch
                                                        and TmpSal.number   == TmpVedRasprZP.number
                                                        and TmpSal.kod      == TmpVedRasprZP.kod
                                                   )) = tsOk
      {
        TmpVedRasprZP.salhrs   += TmpSal.sal;
        Update Current TmpVedRasprZP;
      }
    }
  }

  _Loop TmpVedRasprZP where (('07002' == TmpVedRasprZP.number (noIndex)))
  {
    logstrtofile('666.log', TmpVedRasprZP.number + ' ' + TmpVedRasprZP.kod + ' ' + TmpVedRasprZP.salhrs);
  }

  StopVisual('',0);

  if ((wUseSchet and 1) = 0) then
  {
    Delete TmpVedRasprZP where SubStr(TmpVedRasprZP.csch, 1, 2) = '20';
  }
  if ((wUseSchet and 2) = 0) then
  {
    Delete TmpVedRasprZP where SubStr(TmpVedRasprZP.csch, 1, 2) = '23';
  }
  if ((wUseSchet and 4) = 0) then
  {
    Delete TmpVedRasprZP where SubStr(TmpVedRasprZP.csch, 1, 2) = '25';
  }
  if ((wUseSchet and 8) = 0) then
  {
    Delete TmpVedRasprZP where SubStr(TmpVedRasprZP.csch, 1, 2) = '26';
  }
  if ((wUseSchet and 16) = 0) then
  {
    Delete TmpVedRasprZP where SubStr(TmpVedRasprZP.csch, 1, 2) = '29';
  }

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Формирование отчета...', RecordsInTable(#TmpVedRasprZP)*2);

  nom:=4;
  var ItogS,ItogP,s1,s2,s3,p1,p2,p3,p4,p5,p6, sal, h, sh : double;
  var VS_ItogS,VS_ItogP,VS_s1,VS_s2,VS_s3,VS_p1,VS_p2,VS_p3,VS_p4,VS_p5,VS_p6,VS_sal,VS_h,VS_sh : double;
  var Zk_ItogS,Zk_ItogP,Zk_s1,Zk_s2,Zk_s3,Zk_p1,Zk_p2,Zk_p3,Zk_p4,Zk_p5,Zk_p6, Zk_sal, Zk_h, Zk_sh : double;

  var VS_csch, Zk_csch, Zk_nm, Zk_St : string='';

  ItogS := ItogP := s1 := s2 := s3 := p1 := p2 := p3 := p4 := p5 := p6 := sal := h := sh := 0;

  VS_ItogS := VS_ItogP := VS_s1 := VS_s2 := VS_s3 := VS_p1 := VS_p2 := VS_p3 := VS_p4 := VS_p5 := VS_p6 := VS_sal := VS_h := VS_sh := 0;
  Zk_ItogS := Zk_ItogP := Zk_s1 := Zk_s2 := Zk_s3 := Zk_p1 := Zk_p2 := Zk_p3 := Zk_p4 := Zk_p5 := VS_p6 := Zk_sal := Zk_h := Zk_sh := 0;

  If getfirst fastfirstrow TmpVedRasprZP ordered index TmpVedRasprZP1 = tsok
  {
    VS_csch := TmpVedRasprZP.csch;
    Zk_csch := TmpVedRasprZP.number;
    Zk_nm := TmpVedRasprZP.mnname;
    Zk_St := TmpVedRasprZP.mnstat;
  }

  _loop TmpVedRasprZP ordered index TmpVedRasprZP1
  {

    if not NextVisual
      break;

    if Zk_csch <> TmpVedRasprZP.number or VS_csch <> TmpVedRasprZP.csch
    {

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по заказу '+Zk_csch       , ++nom,   Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(chr(39) + Zk_nm           ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(chr(39) + Zk_St           ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_sal                    ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_sh                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_h                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_s1                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_s2                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_s3                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_ItogS                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_ItogP                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p3                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p2                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p1                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p4                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p5                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p6                     ,   nom, ++Numcol, nom, Numcol);

!      xlMergeCells(nom, 1, nom, 3);// об]единение ячеек
      xlSetFontStyle(xlItalic , nom, 1, nom, Numcol);

      Zk_csch := TmpVedRasprZP.number;
      Zk_nm := TmpVedRasprZP.mnname;
      Zk_St := TmpVedRasprZP.mnstat;
      Zk_ItogS := Zk_ItogP := Zk_s1 := Zk_s2 := Zk_s3 := Zk_p1 := Zk_p2 := Zk_p3 := Zk_p4 := Zk_p5 := Zk_p6 := Zk_sal := Zk_h := Zk_sh := 0;
    }

    if VS_csch <> TmpVedRasprZP.csch
    {

