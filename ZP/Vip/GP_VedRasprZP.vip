//========================================================================================

  xlSetActiveSheet(2);//активный лист

  nom:=4;
  ItogS := ItogP := s1 := s2 := s3 := p1 := p2 := p3 := p4 := p5 := p6 := Sal := h := sh := 0;

  VS_ItogS := VS_ItogP := VS_s1 := VS_s2 := VS_s3 := VS_p1 := VS_p2 := VS_p3 := VS_p4 := VS_p5 := VS_p6 := VS_p5 := VS_p6 := VS_Sal := VS_h := VS_sh := 0;
  Zk_ItogS := Zk_ItogP := Zk_s1 := Zk_s2 := Zk_s3 := Zk_p1 := Zk_p2 := Zk_p3 := Zk_p4 := Zk_p5 := VS_p6 := Zk_sal := Zk_h := Zk_sh := 0;

  If getfirst fastfirstrow TmpVedRasprZP ordered index TmpVedRasprZP2  = tsok
  {
    VS_csch := substr(TmpVedRasprZP.kod,1,3);
    Zk_csch := TmpVedRasprZP.number;
    Zk_nm := TmpVedRasprZP.mnname;
    Zk_St := TmpVedRasprZP.mnstat;
  }

  _loop TmpVedRasprZP ordered index TmpVedRasprZP2
  {

    if not NextVisual
      break;

    if Zk_csch <> TmpVedRasprZP.number or VS_csch <> substr(TmpVedRasprZP.kod,1,3)
    {

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по заказу '+Zk_csch       , ++nom,   Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(chr(39) + Zk_nm           ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(chr(39) + Zk_St           ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_sal                    ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_sh                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_h                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_s1                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_s2                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_s3                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_ItogS                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_ItogP                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p3                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p2                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p1                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p4                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p5                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(Zk_p6                     ,   nom, ++Numcol, nom, Numcol);

!      xlMergeCells(nom, 1, nom, 3);// об]единение ячеек
      xlSetFontStyle(xlItalic , nom, 1, nom, Numcol);

      Zk_csch := TmpVedRasprZP.number;
      Zk_nm := TmpVedRasprZP.mnname;
      Zk_St := TmpVedRasprZP.mnstat;
      Zk_ItogS := Zk_ItogP := Zk_s1 := Zk_s2 := Zk_s3 := Zk_p1 := Zk_p2 := Zk_p3 := Zk_p4 := Zk_p5 := Zk_p6 := Zk_sal := Zk_h := Zk_sh := 0;
    }

    if VS_csch <> substr(TmpVedRasprZP.kod,1,3)
    {

      Numcol:=1;
      xlSetCellStringValue('ИТОГО по подразделению '+VS_csch       , ++nom,   Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_sal                    ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_sh                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_h                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_s1                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_s2                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_s3                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_ItogS                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_ItogP                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p3                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p2                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p1                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p4                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p5                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p6                     ,   nom, ++Numcol, nom, Numcol);

!      xlMergeCells(nom, 1, nom, 3);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      VS_csch := substr(TmpVedRasprZP.kod,1,3);
      VS_ItogS := VS_ItogP := VS_s1 := VS_s2 := VS_s3 := VS_p1 := VS_p2 := VS_p3 := VS_p4 := VS_p5 := VS_p6 := VS_sal := VS_h := VS_sh := 0;
    }

    Numcol:=1;
    xlSetCellStringValue(TmpVedRasprZP.csch                    , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.number                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.kod                     ,   nom, ++Numcol, nom, Numcol);
//    xlSetCellStringValue(TmpVedRasprZP.kod+', '+TmpVedRasprZP.Name ,   nom, ++Numcol, nom, Numcol);

    ++Numcol; //xlSetCellStringValue(TmpVedRasprZP.sal                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.salhrs                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.hrs                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.sum1                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.sum2                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.sum3                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.sum1+TmpVedRasprZP.sum2+TmpVedRasprZP.sum3                                             ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per1+TmpVedRasprZP.per2+TmpVedRasprZP.per3+TmpVedRasprZP.per4+TmpVedRasprZP.per5+TmpVedRasprZP.per6,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per3                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per2                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per1                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per4                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per5                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per6                    ,   nom, ++Numcol, nom, Numcol);

    ItogS    += TmpVedRasprZP.sum1+TmpVedRasprZP.sum2+TmpVedRasprZP.sum3;
    ItogP    += TmpVedRasprZP.per1+TmpVedRasprZP.per2+TmpVedRasprZP.per3+TmpVedRasprZP.per4+TmpVedRasprZP.per5+TmpVedRasprZP.per6;
    s1 += TmpVedRasprZP.sum1;
    s2 += TmpVedRasprZP.sum2; 
    s3 += TmpVedRasprZP.sum3;
    p1 += TmpVedRasprZP.per1;
    p2 += TmpVedRasprZP.per2;
    p3 += TmpVedRasprZP.per3;
    p4 += TmpVedRasprZP.per4;
    p5 += TmpVedRasprZP.per5;
    p6 += TmpVedRasprZP.per6;
    sal += TmpVedRasprZP.per5;
    h += TmpVedRasprZP.hrs;
    sh += TmpVedRasprZP.salhrs;
    VS_ItogS += TmpVedRasprZP.sum1+TmpVedRasprZP.sum2+TmpVedRasprZP.sum3;
    VS_ItogP += TmpVedRasprZP.per1+TmpVedRasprZP.per2+TmpVedRasprZP.per3+TmpVedRasprZP.per4+TmpVedRasprZP.per5+TmpVedRasprZP.per6;
    VS_s1 += TmpVedRasprZP.sum1;
    VS_s2 += TmpVedRasprZP.sum2; 
    VS_s3 += TmpVedRasprZP.sum3;
    VS_p1 += TmpVedRasprZP.per1;
    VS_p2 += TmpVedRasprZP.per2;
    VS_p3 += TmpVedRasprZP.per3;
    VS_p4 += TmpVedRasprZP.per4;
    VS_p5 += TmpVedRasprZP.per5;
    VS_p6 += TmpVedRasprZP.per6;
    VS_sal += TmpVedRasprZP.per5;
    VS_h += TmpVedRasprZP.hrs;
    VS_sh += TmpVedRasprZP.salhrs;
    Zk_ItogS += TmpVedRasprZP.sum1+TmpVedRasprZP.sum2+TmpVedRasprZP.sum3;
    Zk_ItogP += TmpVedRasprZP.per1+TmpVedRasprZP.per2+TmpVedRasprZP.per3+TmpVedRasprZP.per4+TmpVedRasprZP.per5+TmpVedRasprZP.per6;
    Zk_s1 += TmpVedRasprZP.sum1;
    Zk_s2 += TmpVedRasprZP.sum2; 
    Zk_s3 += TmpVedRasprZP.sum3;
    Zk_p1 += TmpVedRasprZP.per1;
    Zk_p2 += TmpVedRasprZP.per2;
    Zk_p3 += TmpVedRasprZP.per3;
    Zk_p4 += TmpVedRasprZP.per4;
    Zk_p5 += TmpVedRasprZP.per5;
    Zk_p6 += TmpVedRasprZP.per6;
    Zk_sal += TmpVedRasprZP.per5;
    Zk_h   += TmpVedRasprZP.hrs;
    Zk_sh   += TmpVedRasprZP.salhrs;
  }

  if Zk_ItogS != 0  or  Zk_ItogP != 0 or VS_ItogS != 0  or  VS_ItogP != 0 or ItogS != 0 or ItogP != 0
  {

    Numcol:=1;
    xlSetCellStringValue('ИТОГО по заказу '+Zk_csch       , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(chr(39) + Zk_nm           ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(chr(39) + Zk_St           ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_sal                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_sh                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_h                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_s1                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_s2                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_s3                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_ItogS                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_ItogP                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p3                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p2                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p1                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p4                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p5                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p6                     ,   nom, ++Numcol, nom, Numcol);

!    xlMergeCells(nom, 1, nom, 3);// об]единение ячеек
    xlSetFontStyle(xlItalic , nom, 1, nom, Numcol);
  }

  if VS_ItogS != 0  or  VS_ItogP != 0 or ItogS != 0 or ItogP != 0
  {

    Numcol:=1;
    xlSetCellStringValue('ИТОГО по подразделению '+VS_csch       , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_sal                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_sh                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_h                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_s1                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_s2                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_s3                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_ItogS                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_ItogP                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p3                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p2                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p1                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p4                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p5                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p6                     ,   nom, ++Numcol, nom, Numcol);

!    xlMergeCells(nom, 1, nom, 3);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  }

  if ItogS != 0 or ItogP != 0
  {
    Numcol:=1;
    xlSetCellStringValue('ВСЕГО'                   , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(sal                       ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(sh                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(h                         ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(s1                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(s2                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(s3                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(ItogS                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(ItogP                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p3                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p2                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p1                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p4                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p5                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(p6                        ,   nom, ++Numcol, nom, Numcol);

!    xlMergeCells(nom, 1, nom, 3);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  }

  xlWrapText(5, 1, nom, Numcol);//перенос по словам
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB + xlInsideV + xlInsideH,
                      xlThin, xlContinuous, 0, 5, 1, nom, Numcol);//рамка xlThick - жирная

  if (wUseSaldH = 0) then
  {
    xlDeleteRange(xlShiftToLeft, 3, 7 , nom, 7);
  }

  xlSetActiveSheet(1);//активный лист

  StopVisual('',0);
  xlkillExcel;

}

cmClose:
{
  SaveMyDSK(YearFill, 'YearFill_VedRasprZP');
  SaveMyDSK(MonthBeg, 'MonthBeg_VedRasprZP');
  SaveMyDSK(MonthEnd, 'MonthEnd_VedRasprZP');
  SaveMyDSK(wUse30_31,'wUse30_31_VedRasprZP');

}

cmDone:
{
  SaveMyDSK(YearFill, 'YearFill_VedRasprZP');
  SaveMyDSK(MonthBeg, 'MonthBeg_VedRasprZP');
  SaveMyDSK(MonthEnd, 'MonthEnd_VedRasprZP');
}
end;
end.

VipInterface UserReport_gp_VedRasprZP Implements IUserReport;
Interface UserReport_gp_VedRasprZP;

Procedure Run;
Begin
  runinterface(gp_VedRasprZP);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Ведомость распределения ЗП по балансовым счетам';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := '';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.

/*
      left join perevodtekzakaz on nachislzakaz.nrec = perevodtekzakaz.cnach and (perevodtekzakaz.vidper = 2 or perevodtekzakaz.vidper = 3 or perevodtekzakaz.vidper = 5 or perevodtekzakaz.vidper = 8 or perevodtekzakaz.vidper = 11 or perevodtekzakaz.vidper = 12)
      left join perevodtekzakaz perevodtekzakaz1 on perevodtekzakaz.nrec = perevodtekzakaz1.nrec and perevodtekzakaz1.vidper=2
      left join perevodtekzakaz perevodtekzakaz2 on perevodtekzakaz.nrec = perevodtekzakaz2.nrec and perevodtekzakaz2.vidper=3
      left join perevodtekzakaz perevodtekzakaz3 on perevodtekzakaz.nrec = perevodtekzakaz3.nrec and perevodtekzakaz3.vidper=5
      left join perevodtekzakaz perevodtekzakaz4 on perevodtekzakaz.nrec = perevodtekzakaz4.nrec and perevodtekzakaz4.vidper=8
      left join perevodtekzakaz perevodtekzakaz5 on perevodtekzakaz.nrec = perevodtekzakaz5.nrec and perevodtekzakaz5.vidper=11
      left join perevodtekzakaz perevodtekzakaz6 on perevodtekzakaz.nrec = perevodtekzakaz6.nrec and perevodtekzakaz6.vidper=12
*/

/*
sql
select
SumVidOp.cschetd+'.'+SumVidOp.csubschd,
mnplan.number,
substring(katpodr1.kod,1,3)+','+katpodr1.name
,sum(SumVidOp1.summa)
,sum(SumVidOp2.summa)
,sum(SumVidOp3.summa)
,sum(perevod1.sumper)
,sum(perevod2.sumper)
,sum(perevod3.sumper)
,sum(perevod4.sumper)
,sum(perevod5.sumper)
,sum(perevod6.sumper)
from katpodr
      left join katpodr katpodr1 on substring(katpodr.kod,1,3) = katpodr1.kod
      left join SumVidOp on katpodr.nrec=SumVidOp.cexoz
      left join mnplan on mnplan.nrec = SumVidOp.ckaud[1]
      left join klvidopl on klvidopl.vidopl = SumVidOp.vidopl
      left join stzatr on stzatr.nrec = klvidopl.kauextr[1]
      left join SumVidOp SumVidOp1 on SumVidOp1.nrec = SumVidOp.nrec and SumVidOp1.vidopl = klvidopl.vidopl and klvidopl.kauextr[1] = stzatr.nrec and stzatr.name = '01 Основная з/плата'
      left join SumVidOp SumVidOp2 on SumVidOp2.nrec = SumVidOp.nrec and SumVidOp2.vidopl = klvidopl.vidopl and klvidopl.kauextr[1] = stzatr.nrec and stzatr.name = '02 Дополнительная з/плата'
      left join SumVidOp SumVidOp3 on SumVidOp3.nrec = SumVidOp.nrec and SumVidOp3.vidopl = klvidopl.vidopl and klvidopl.kauextr[1] = stzatr.nrec and stzatr.name = '04 Премии'
      left join perevod on SumVidOp.nrec = perevod.cnach and (perevod.vidper = 2 or perevod.vidper = 3 or perevod.vidper = 5 or perevod.vidper = 8 or perevod.vidper = 11 or perevod.vidper = 12)
      left join perevod perevod1 on perevod.nrec = perevod1.nrec and perevod1.vidper=2
      left join perevod perevod2 on perevod.nrec = perevod2.nrec and perevod2.vidper=3
      left join perevod perevod3 on perevod.nrec = perevod3.nrec and perevod3.vidper=5
      left join perevod perevod4 on perevod.nrec = perevod4.nrec and perevod4.vidper=8
      left join perevod perevod5 on perevod.nrec = perevod5.nrec and perevod5.vidper=11
      left join perevod perevod6 on perevod.nrec = perevod6.nrec and perevod6.vidper=12
where (SumVidOp.yearn = :(YearFill) and SumVidOp.mesn >= :(MonthBeg) and SumVidOp.mesn <= :(MonthEnd)) 
   and SumVidOp.cschetd<>'96' and SumVidOp.cschetd<>'69'  and SumVidOp.cschetd<>'91'
group by
SumVidOp.cschetd+'.'+SumVidOp.csubschd,
mnplan.number,
substring(katpodr1.kod,1,3)+','+katpodr1.name
into TmpVedRasprZP;
*/
