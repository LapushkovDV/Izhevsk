      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_sal                    ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_sh                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_h                      ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_s1                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_s2                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_s3                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_ItogS                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_ItogP                  ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p3                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p2                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p1                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p4                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p5                     ,   nom, ++Numcol, nom, Numcol);
      xlSetCellStringValue(VS_p6                     ,   nom, ++Numcol, nom, Numcol);

!      xlMergeCells(nom, 1, nom, 3);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      VS_csch := TmpVedRasprZP.csch;
      VS_ItogS := VS_ItogP := VS_s1 := VS_s2 := VS_s3 := VS_p1 := VS_p2 := VS_p3 := VS_p4 := VS_p5 := VS_p6 := VS_sal := VS_h := VS_sh := 0;
    }

    Numcol:=1;
    xlSetCellStringValue(TmpVedRasprZP.csch                    , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.number                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.kod                     ,   nom, ++Numcol, nom, Numcol);
//    xlSetCellStringValue(TmpVedRasprZP.kod+', '+TmpVedRasprZP.Name ,   nom, ++Numcol, nom, Numcol);

    ++Numcol; //xlSetCellStringValue(TmpVedRasprZP.sal                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.salhrs                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.hrs                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.sum1                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.sum2                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.sum3                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.sum1+TmpVedRasprZP.sum2+TmpVedRasprZP.sum3                                             ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per1+TmpVedRasprZP.per2+TmpVedRasprZP.per3+TmpVedRasprZP.per4+TmpVedRasprZP.per5+TmpVedRasprZP.per6,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per3                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per2                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per1                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per4                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per5                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(TmpVedRasprZP.per6                    ,   nom, ++Numcol, nom, Numcol);

    ItogS    += TmpVedRasprZP.sum1+TmpVedRasprZP.sum2+TmpVedRasprZP.sum3;
    ItogP    += TmpVedRasprZP.per1+TmpVedRasprZP.per2+TmpVedRasprZP.per3+TmpVedRasprZP.per4+TmpVedRasprZP.per5+TmpVedRasprZP.per6;
    s1 += TmpVedRasprZP.sum1;
    s2 += TmpVedRasprZP.sum2; 
    s3 += TmpVedRasprZP.sum3;
    p1 += TmpVedRasprZP.per1;
    p2 += TmpVedRasprZP.per2;
    p3 += TmpVedRasprZP.per3;
    p4 += TmpVedRasprZP.per4;
    p5 += TmpVedRasprZP.per5;
    p6 += TmpVedRasprZP.per6;
    sal += TmpVedRasprZP.sal;
    h   += TmpVedRasprZP.hrs;
    sh  += TmpVedRasprZP.salhrs;

    VS_ItogS += TmpVedRasprZP.sum1+TmpVedRasprZP.sum2+TmpVedRasprZP.sum3;
    VS_ItogP += TmpVedRasprZP.per1+TmpVedRasprZP.per2+TmpVedRasprZP.per3+TmpVedRasprZP.per4+TmpVedRasprZP.per5+TmpVedRasprZP.per6;
    VS_s1 += TmpVedRasprZP.sum1;
    VS_s2 += TmpVedRasprZP.sum2; 
    VS_s3 += TmpVedRasprZP.sum3;
    VS_p1 += TmpVedRasprZP.per1;
    VS_p2 += TmpVedRasprZP.per2;
    VS_p3 += TmpVedRasprZP.per3;
    VS_p4 += TmpVedRasprZP.per4;
    VS_p5 += TmpVedRasprZP.per5;
    VS_p6 += TmpVedRasprZP.per6;
    VS_sal += TmpVedRasprZP.sal;
    VS_h += TmpVedRasprZP.hrs;
    VS_sh += TmpVedRasprZP.salhrs;

    Zk_ItogS += TmpVedRasprZP.sum1+TmpVedRasprZP.sum2+TmpVedRasprZP.sum3;
    Zk_ItogP += TmpVedRasprZP.per1+TmpVedRasprZP.per2+TmpVedRasprZP.per3+TmpVedRasprZP.per4+TmpVedRasprZP.per5+TmpVedRasprZP.per6;
    Zk_s1 += TmpVedRasprZP.sum1;
    Zk_s2 += TmpVedRasprZP.sum2; 
    Zk_s3 += TmpVedRasprZP.sum3;
    Zk_p1 += TmpVedRasprZP.per1;
    Zk_p2 += TmpVedRasprZP.per2;
    Zk_p3 += TmpVedRasprZP.per3;
    Zk_p4 += TmpVedRasprZP.per4;
    Zk_p5 += TmpVedRasprZP.per5;
    Zk_p6 += TmpVedRasprZP.per6;
    Zk_sal += TmpVedRasprZP.sal;
    Zk_h   += TmpVedRasprZP.hrs;
    Zk_sh   += TmpVedRasprZP.salhrs;

  }

  if Zk_ItogS != 0  or  Zk_ItogP != 0 or VS_ItogS != 0  or  VS_ItogP != 0 or ItogS != 0 or ItogP != 0
  {

    Numcol:=1;
    xlSetCellStringValue('ИТОГО по заказу '+Zk_csch       , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(chr(39) + Zk_nm           ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(chr(39) + Zk_St           ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_sal                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_sh                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_h                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_s1                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_s2                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_s3                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_ItogS                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_ItogP                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p3                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p2                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p1                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p4                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p5                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(Zk_p6                     ,   nom, ++Numcol, nom, Numcol);

!    xlMergeCells(nom, 1, nom, 3);// об]единение ячеек
    xlSetFontStyle(xlItalic , nom, 1, nom, Numcol);
  }

  if VS_ItogS != 0  or  VS_ItogP != 0 or ItogS != 0 or ItogP != 0
  {

    Numcol:=1;
    xlSetCellStringValue('ИТОГО по счету '+VS_csch       , ++nom,   Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_sal                    ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_sh                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_h                      ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_s1                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_s2                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_s3                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_ItogS                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_ItogP                  ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p3                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p2                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p1                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p4                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p5                     ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(VS_p6                     ,   nom, ++Numcol, nom, Numcol);

