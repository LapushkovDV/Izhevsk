    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(''                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(sal                       ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(sh                        ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(h                         ,   nom, ++Numcol, nom, Numcol);
    xlSetCellStringValue(s1                        ,   nom, ++Numcol, nom, Numcol);
