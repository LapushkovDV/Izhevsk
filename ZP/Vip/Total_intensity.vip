#component "EM"
const
 cofZakazEmpty = 'Выберите заказ';
 cofPodrEmpty = 'Выберите подразделение';
 cofTpsEmpty = 'Выберите номер ТПс';
end;
Interface Total_intensity 'Фактическая трудоемкость по паспортам (971)' (,,sci17EnEsc), EscClose;
//************************************************************
Show At (,,50,12);
//----------------------------------------
table struct nrec_tosearch
(
    kpNrec: comp
  , kpKod: string
)
with index
(
    i01 = kpNrec
  , i02 = kpKod
);
table struct nrec_tosearch2
(
    tpsNrec: comp
  , tpsName: string
)
with index
(
    i01 = tpsNrec
  , i02 = tpsName
);


table struct treport_2
(
   podrnrec :comp
 , tpsnrec :comp
 , ZakNumber  : string
 , tps        : string
 , Shas       : double
 , sPodr      : string
)
with index
(
  ind0 = ZakNumber
, ind1 = podrnrec
, ind2 = tpsnrec
)
;
var _log : string;
Create View
var

_cFltrMnPlan: comp;

 _fZakaz
 , _fPodr
 , _fTPs : string;

as select
 treport_2.ZakNumber
from
   treport_2
 , KatPodr
 , MnPLan
 , katparty
 , nrec_tosearch
 , nrec_tosearch2

;

Screen ScrMain ;
Fields
 _fZakaz  : Protect, pickbutton;
 _fPodr   : protect, pickbutton;
 _fTPs    : protect, pickbutton;

buttons
  cmOK,;
  cmCancel,;
<< 'Фактическая трудоемкость по паспортам (971)'
 Фильтр
                           по заказу.@@@@@@@@@@@@@@@@@@@@@@@@@@
                   по подразделениям.@@@@@@@@@@@@@@@@@@@@@@@@@@
 по номеру технологического паспорта.@@@@@@@@@@@@@@@@@@@@@@@@@@

   <.Сформировать.>      <.Отмена.>
>>
end;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
Procedure MyLog(_str: string);
{
   If Upcase(UserName) = 'Ekaterina.Zakharova'
    {
      LogStrToFile(_log,_str);
    }
}
Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
   sqlAddStr(query_handle, add_query_str);
   MyLog('sql: ' + add_query_str);
}


Function Filltreport_2(p1, podr, tps: comp) : longint;
{

  var hstr : longint = 0;
  rereadrecord;

    MysqlAddStr(hstr, 'select                                                                                  ');
    MysqlAddStr(hstr, 'par.nrec as tpsnrec                                                                        ');
    MysqlAddStr(hstr, ', kp.nrec as podrnrec                                                                        ');
    MysqlAddStr(hstr, ', mnp.number  as ZakNumber                                                                        ');
    MysqlAddStr(hstr, ', Sum(pn.ChasF) as Shas                                                                         ');
    MysqlAddStr(hstr, ', Coalesce(pnExt.TPs,'''') as tps                                                         ');
    MysqlAddStr(hstr, ', coalesce(kp.kod, '''') as sPodr                                                               ');
    MysqlAddStr(hstr, 'from sys_nar sn                                                                                 ');
    MysqlAddStr(hstr, 'join prnaryad pn on pn.MNREC = sn.nrec                                                          ');
    MysqlAddStr(hstr, 'join Attrnam anSystem on anSystem.name = ''.СистемаИсточник'' and anSystem.wtable = 16003       ');
    MysqlAddStr(hstr, 'left join attrval avSystem on avSystem.cattrnam = anSystem.nrec and avSystem.wtable = anSystem.wtable and avSystem.crec = sn.nrec');
    MysqlAddStr(hstr, 'left join katpodr kp   on  pn.CEXOZ = kp.nrec                                                                                    ');
    MysqlAddStr(hstr, 'left join mnplan mnp   on  pn.ckaud[1] = mnp.nrec                                                                                ');
    MysqlAddStr(hstr, 'left join GP_PRNARYAD_EXT pnExt on pnExt.cPrNaryad = Pn.nrec                                                                     ');
    MysqlAddStr(hstr, 'left join katparty par on par.kod= pnExt.tps                                    ');
    MysqlAddStr(hstr, 'where                                                                                  ');
    MysqlAddStr(hstr, 'sn.choice in (3,203)                                                                  ');
    MysqlAddStr(hstr, 'and mnp.nrec = #comp(' + string(p1) + ')                                               ');
    //LogStrToFile('999.txt', 'nrec_tosearch2 подр '+string(podr));
    if podr<>0h {MysqlAddStr(hstr, 'and kp.nrec = #comp(' + string(podr) + ')                                ');}
    //LogStrToFile('999.txt', 'nrec_tosearch2 тпс '+string(tps));
    if tps<>0h {MysqlAddStr(hstr, 'and par.nrec = #comp(' + string(tps,0,0) + ')                                  ');}
    MysqlAddStr(hstr, 'group by                                                                               ');
    MysqlAddStr(hstr, '  mnp.number                                                                              ');
    MysqlAddStr(hstr, ', coalesce(pnExt.TPs, '''')                                                            ');
    MysqlAddStr(hstr, ', coalesce(kp.kod, '''')                                                                ');
    MysqlAddStr(hstr, ', kp.nrec                                                                              ');
    MysqlAddStr(hstr, ', par.nrec                                                                              ');
    MysqlAddStr(hstr, '    order by                                                                            ');
    MysqlAddStr(hstr, 'coalesce(kp.kod, '''')                                                                  ');
    MysqlAddStr(hstr, ',Coalesce(pnExt.TPs,'''')                                                              ');



  var objQuery: iQuery;
    objQuery := queryManager.createQuery(hstr);
  if objQuery.execute.errorCode != tsOk
   then {
      message('Ошибка выполнения запроса '+ objQuery.errorCode,error);
      }
  else
  {
    sqlCopyInto(objQuery, tntreport_2, true);
    result := 1;
  }

}

#include Total_intensity_PrintToExcel.vpp

HandleEvent
cmInit:
{
  _log := 'Total_intensity.log';
 _fZakaz   := cofZakazEmpty;
 _fPodr    := cofPodrEmpty;
 _fTPs     := cofTpsEmpty;

}
cmPick:
{
  delete all treport_2;
  case curfield of
   #_fZakaz:
    {
         set _fZakaz   := cofZakazEmpty;
         var p1: comp = 0h;
         set _cFltrMnPlan := 0h;
         if (iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, p1) <> 0 ) then
         {
            if (getFirst MnPlan where ((p1 == MnPlan.nRec)) = tsOk) then
          {
            set _cFltrMnPlan := p1;
            set _fZakaz:= 'Выбран ' + mnplan.number;
          }
         }


   }

   #_fPodr: {

   var _tmpMarkerName : string;
      var stMarker       : longint;
      var _i : longint;
      delete all nrec_tosearch;
      var kp: comp = 0h;
      set _fPodr = cofPodrEmpty;
      if (iGetKau.GetCodeKau(cgiMulti, cgKau_KatPodr, kp) <> 0) then
      {
        _tmpMarkerName := iGetKau.GetMarkerName(cgKau_KatPodr);
        stMarker       := InitMarker(_tmpMarkerName, 8, 10, 100, true);

        _i             := 0;
        while getmarker(stMarker, _i, kp)
        {

          if (getFirst KatPodr where ((kp == KatPodr.nRec)) = tsOk) then
          {
            insert Nrec_toSearch set kpNrec:=kp, kpKod:=KatPodr.kod;

            if _fpodr <> cofPodrEmpty {
                 set _fpodr := _fpodr+ ', '+KatPodr.kod;
            }
            else  set _fpodr :='Выбрано ' +KatPodr.kod;

          }
          _i++;
        }
        DoneMarker(stMarker, _tmpMarkerName);
      } else{}; }

   #_fTPs:{
   var _tmpMarkerName : string;
      var stMarker       : longint;
      var _i : longint;
      var tps: comp = 0h;
      set _fTPs     := cofTpsEmpty;
      delete all nrec_tosearch2;
      if (iGetKau.GetCodeKau(cgiMulti, cgKau_KatParty, tps) <> 0) then
      {
        _tmpMarkerName := iGetKau.GetMarkerName(cgKau_KatParty);
        stMarker       := InitMarker(_tmpMarkerName, 8, 10, 100, true);

        _i             := 0;

        while getmarker(stMarker, _i, tps)
        {

          if (getFirst KatParty where ((tps == KatParty.nRec)) = tsOk) then
          {
            insert Nrec_toSearch2 set tpsNrec:=tps, tpsName:=KatParty.name;

            if _fTPs <> cofTPsEmpty {
                 set _fTPs := _fTPs+ ', '+KatParty.name;
            }
            else  set _fTPs := 'Выбран '+KatParty.name;

          }
          _i++;
        }


        DoneMarker(stMarker, _tmpMarkerName);
      } else{}; }
   end;
   rereadrecord;
}
cmdelonprotect:
{
case curfield of
   #_fZakaz: {
     _fZakaz := cofZakazEmpty;
     set _cFltrMnPlan := 0;
   }
   #_fpodr : {_fPodr := cofPodrEmpty;
   delete all nrec_tosearch;}
   #_fTPs  : {_fTPs  := cofTpsEmpty;
   delete all nrec_tosearch2;}
   end;
  rereadrecord;
}

cmOK:
{
   delete all treport_2;
   if _cFltrMnplan<>0h
  {
    StartNewVisual(vtRotateVisual, vfBreak+vfTimer, 'Запрос данных', 1);
    SetVisualHeader('Выполнение запроса SQL');
    if recordsintable(tnnrec_tosearch)>0 and recordsintable(tnnrec_tosearch2)>0{
      _loop nrec_tosearch{
        _loop nrec_tosearch2 {
          LogStrToFile('999.txt', 'nrec_tosearch2 проверка оба '+nrec_tosearch2.tpsName+' |||| '+nrec_tosearch.kpKod);
          Filltreport_2(_cFltrMnPlan, nrec_tosearch.kpNrec, nrec_tosearch2.tpsNrec);}

      }
    }
    else{
      if recordsintable(tnnrec_tosearch)>0 {

        _loop nrec_tosearch  {
          LogStrToFile('999.txt', 'nrec_tosearch2 проверка подр '+RecordsInTable(tnnrec_tosearch)+' '+nrec_tosearch.kpNrec);
          Filltreport_2(_cFltrMnPlan, nrec_tosearch.kpNrec, 0h);}

      }
      else{
      if recordsintable(tnnrec_tosearch2)>0 {

        _loop nrec_tosearch2 {
         LogStrToFile('999.txt', 'nrec_tosearch2 проверка тпс '+RecordsInTable(tnnrec_tosearch2)+' '+nrec_tosearch2.tpsNrec);
          Filltreport_2(_cFltrMnPlan, 0h, nrec_tosearch2.tpsNrec);}

      }
      else{
      filltreport_2(_cFltrMnPlan, 0h, 0h)
      }
      }
    }
    stopvisual;

  }
   else message('Выберите номер заказа');



   if getfirst treport_2 = tsOK
    {
      PrintToExcel;
    }
    else
    {
      message('Нет данных для формирования отчета',error);
    }
 if VisualizationActive StopVisual('',0);
}

end;
end.

#include UserReport.vih

VipInterface UserReport_Total_intensity Implements IUserReport licensed(free);
Interface UserReport_Total_intensity;

  create view;

  procedure Run;
  {
    runinterfacenomodal(EM::Total_intensity);
  }

  function GetReportName: String;
  {
    GetReportName := 'Фактическая трудоемкость по паспортам (971)';
  }

  function GetGroupName (Level : Word) : String;
  {
    if (Level = 1)
      GetGroupName := ''
    else
      GetGroupName := '';
  }

  function GetPriority : Integer;
  {
    GetPriority := 0;
  }

  function VisibleInModule(Ind : Byte) : String;
  {
    VisibleInModule := '';
    case Ind of
      1: result:= 'STAFFMAINMENU';
      2: result:= 'menuzarp';
    end;
  }
end.
