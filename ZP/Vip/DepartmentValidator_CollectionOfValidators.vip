#component "Z_KATPODR"

#include DepartmentValidator_CollectionOfValidators.vih
interface DepartmentValidator_CollectionOfValidators;

function IDepartmentValidator.Valid(B: #TDepartmentToValidate): boolean;
{
  result := true;
  var i: longint;
  for (i := 0; i < _cnt and result; i++)
    result := result and _validators[i].Valid(B);
}

end.
