#include UserReport.vih
#include TXmlTables.tbl
#include XMLConverter.vih
#include StrFunc.vih
#include MainLschetForPersons.vih
#include ExtAttr.Vih


#define GPInt GP_ImpBankCardSbb // #(GPInt)
#define GPNam Загрузка данных по картам Сбербанка // #(GPNam)

Interface #(GPInt) '#(GPNam) (ЭМ)' EscClose, Gray;

table struct ttImpData
(
  sF : string
, sI : string
, sO : string
, sSer : string
, sNmb : string
, sPas : string
, cLSchet : comp
, cPsn    : comp
)
with index
(
  ttImpData00 = sPas
);
table struct ttLog
(
  sTbNmb : string
, sFIO   : string
, sSer   : string
, sNmb   : string
, sReason: string
, wType  : word
, sCNom  : string
)
with index
(
  ttLog00 = wType + sFIO
);

var
  oXMLConverter : XMLConverter;
  iStrFunc      : StringFunctions;
  MLFP          : MainLschetForPersons;
  sImpFile    : string;
  sPoluchatel
, sBank       : string;
  cPoluchatel
, cBank       : comp;
  sNmbPassp
, sSerPassp   : string;
  cLS         : comp;
  iImpCount
, iImpTotal   : integer = 0;
  cAttrNam    : comp;
#include ExtAttr.var

create view viM
from
  Passports
, Persons
, LSchet
, Shtraf
, KatOrg
, KatBank
, ttImpData
, ttLog
where
((
    integer(502)     == Passports.SysCode
and sNmbPassp        == Passports.Nmb
and (sSerPassp       =  replace(Passports.Ser,' ',''))
and Passports.Person == Persons.nRec
and cLS              == LSchet.nRec
and cPoluchatel      == KatOrg.nRec
and cBank            == KatBank.nRec
))
;

//Выделяем TxmlNode в отдельную выборку
//иначе получаем пустую TxmlNode после 
//выполнения oXMLConverter.LoadTxmlTables
//Почему так не знаю
create view viI
from
  TxmlNode
;

form frm('ImpBankCardSbb.out', 'ImpBankCardSbb');

function isCheckParam : boolean;
{
  result:=false;
  if sImpFile<>'' and sPoluchatel<>'' and sBank<>''
    result:=true
  else
    message('Не задан обязательный параметр!',Error);
}
function sSetPoluName(cAny : comp) : string;
{
  result:='';
  set cPoluchatel:=cAny;
  if isvalid(#KatOrg)
    result:=KatOrg.Name;
}
function sSetBankName(cAny : comp) : string;
{
  result:='';
  set cBank:=cAny;
  if isvalid(#KatBank)
    result:=KatBank.Name;
}

window WinImp '#(GPNam)' Gray;
  show at (,,67,9);
Screen s1(,,sci1Esc);
  fields
    sImpFile    ('Файл загрузки',,sci13Esc): {Font = {BackColor = if(sImpFile    = '', ColorNeed, 0)}},Protect, PickButton ;
    sPoluchatel ('Получатель'   ,,sci13Esc): {Font = {BackColor = if(sPoluchatel = '', ColorNeed, 0)}},Protect, PickButton ;
    sBank       ('Банк'         ,,sci13Esc): {Font = {BackColor = if(sBank       = '', ColorNeed, 0)}},Protect, PickButton ;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
<<

 `Файл загрузки` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Данные банка `
 `Получатель   ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Банк         ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <. ~С~формировать .>                           <. ~З~акрыть .>

>>
end;

HandleEvent
  cmPick:
  {
    case CurField of
      #sPoluchatel:
        if (RunInterface('GETKATOR', cPoluchatel,comp(0),false,comp(0),comp(0)) = cmDefault)
          set sPoluchatel := sSetPoluName(cPoluchatel);
      #sBank:
        if (RunInterface('GETBANK', cPoluchatel, cBank) = cmDefault)
          set sBank       := sSetBankName(cBank);
      #sImpFile:
          set sImpFile    := GetFileName('*.xml','Выбор файла...');
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sPoluchatel: {cPoluchatel := 0; set sPoluchatel := sSetPoluName(cPoluchatel);
                     cBank       := 0; set sBank       := sSetBankName(cBank);      }
      #sBank:       {cBank       := 0; set sBank       := sSetBankName(cBank);      }
      #sImpFile:    {                  set sImpFile    := '';                       }
    end;
  }
  cmOK:
  {
    if not isCheckParam
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
end;
end;//WinImp

function isImportOk : boolean;
{
  result:=false;
  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Импорт из XML-файла', 0);
  oXMLConverter.Init;
  if (not oXMLConverter.LoadTxmlTables(sImpFile))
  {
    message('Чтение из xml-файла в таблицы в памяти завершено с ошибками');
    StopVisual;
    exit;
  }
  if viI.getfirst TxmlNode = tsOk
  {
    viI._loop TxmlNode
    {
      if (not NextVisual) break;
      case viI.TxmlNode.Name of
      'Сотрудник'   : ClearBuffer(#ttImpData);
      'Фамилия'     : ttImpData.sF := viI.TxmlNode.sVal;
      'Имя'         : ttImpData.sI := viI.TxmlNode.sVal;
      'Отчество'    : ttImpData.sO := viI.TxmlNode.sVal;
      'ЛицевойСчет' : ttImpData.sPas := viI.TxmlNode.sVal;
      'Серия'       : ttImpData.sSer := viI.TxmlNode.sVal;
      'Номер'       : ttImpData.sNmb := viI.TxmlNode.sVal;
      'Результат'   : insert current ttImpData;
      end;
    }
  }
  StopVisual;
  if isvalid(#ttImpData) result:=true;
}

function isChekFIO : boolean;
{
  result:=false;
  if  UpCase(trim(ttImpData.sF)) = UpCase(iStrFunc.Get_LastName (Persons.FIO))
  and UpCase(trim(ttImpData.sI)) = UpCase(iStrFunc.Get_FirstName(Persons.FIO))
  and UpCase(trim(ttImpData.sO)) = UpCase(iStrFunc.GetPatronymic(Persons.FIO))
    result := true;
}

procedure InstLog(_wType: word; _sAny : string);
{
  ClearBuffer(#ttLog);
  ttLog.sFIO:= ttImpData.sF +' '+ ttImpData.sI +' '+ ttImpData.sO;
  ttLog.sSer:= ttImpData.sSer;
  ttLog.sNmb:= ttImpData.sNmb;
  ttLog.wType:= _wType;
  if ( _wType = 1 ) ttLog.sCNom:= _sAny;
  ttLog.sReason:= _sAny;
  insert current ttLog;
}

procedure InsertShtraf(_wVidUd: word);
{
  ClearBuffer(#Shtraf);
  if ( getfirst Shtraf where((LSchet.nRec == Shtraf.cLSch and _wVidUd == Shtraf.VidUd)) <> tsOk )
  {
    Shtraf.VidUd   := _wVidUd;
    Shtraf.cLSch   := LSchet.nRec;
    Shtraf.TPerson := LSchet.TPerson;
    Shtraf.Cex     := LSchet.Cex;
    Shtraf.StrTabN := LSchet.StrTabN;
//     Shtraf.cPol    := LSchet.cPodr;
    if ( insert current Shtraf <> tsOk ) {}
  }
  if ( _wVidUd = 220 )
    Shtraf.PrPer  := 2;
  Shtraf.Pometka  := '+';
  Shtraf.cBankPol := LSchet.cLSchDop;
  Shtraf.FIO      := Persons.FIO;
  Shtraf.NomLSh   := LSchet.Pasport;
/* before 20180521
  if ( Shtraf.cPol <> comp(0) )
    Shtraf.cPol   := LSchet.cPodr;
*/
  Shtraf.cPol   := LSchet.cPodr;
  if ( update current Shtraf <> tsOk ) {}
}

procedure MakeImport;
{
  var sDateC: string = DateToStr(Cur_Date, 'DD.MM.YYYY');

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Обработка данных.', 0);
  if isvalid(#ttImpData)
  _loop ttImpData
  {
    iImpTotal++;
    if (not NextVisual) break;
    set sNmbPassp := ttImpData.sNmb;
    set sSerPassp := replace(ttImpData.sSer,' ','');
    if isvalid(#Passports)
    {
      if isvalid(#Persons)
      {
        if isChekFIO
        {
          if MLFP.GetMainLschet(Persons.nRec, cLS)
          {
            set cLS := cLS; //прикол MS-SQL, так надо иначе не работает
            if isvalid(#LSchet)
            {
              LSchet.cPodr    := cPoluchatel;
              LSchet.cLSchDop := cBank;
              LSchet.Pasport  := ttImpData.sPas;
              LSchet.Summa27  := 1;
              update current LSchet;
              iImpCount++;
              InsertShtraf(220);
              InsertShtraf(141);
              InstLog(1, ttImpData.sPas);
              oExtAttr.sSetAttrID(coLSchet, LSchet.nRec, cAttrNam, sDateC);
            }
          }
          else
            InstLog(3, 'Не найден лицевой счет сотрудника.');
        }
        else
          InstLog(3, 'Не совпадает ФИО сотрудника ('+Persons.FIO+').');
      }
    }
    else
      InstLog(3, 'Не найден паспорт сотрудника.');
  }
  insert ttLog set ttLog.wType := 0, ttLog.sFIO := sDateC+' загружено:';
  insert ttLog set ttLog.wType := 2, ttLog.sFIO := 'НЕ УДАЛОСЬ ЗАГРУЗИТЬ:';
  frm.ReInit;
  if not (frm.Error)
  {
    frm.write('Успешно импортировано записей '+iImpCount+' из '+iImpTotal);

    if isvalid(#ttLog)
    {
  
      frm.PutEventById(feDoLoop, fcisErrorsSbb);
      _loop ttLog ordered index ttLog00
      {
        frm.write(ttLog.sSer+' '+ttLog.sNmb+' '+ttLog.sFIO);
        frm.write(ttLog.sReason);
      }
      frm.putevent(febreak);
      frm.putevent(febreak);
    }
    frm.ShowFile;
  }
  StopVisual;
}

handleevent
cmInit:
{
  viI.delete all from TxmlNode;
  if (not (ReadMyDsk(cPoluchatel, '#(GPInt)_cPoluchatel', false)))
    set cPoluchatel:= 0; set sPoluchatel  := sSetPoluName(cPoluchatel);
  if (not (ReadMyDsk(cBank      , '#(GPInt)_cBank'      , false)))
    set cBank      := 0; set sBank        := sSetBankName(cBank);
  if (not (ReadMyDsk(sImpFile   , '#(GPInt)_sImpFile'   , false)))
    set sImpFile   := '';
  cAttrNam := oExtAttr.AttrId(coLSchet, 'Примечание по перечислению');
  if ( cAttrNam = comp(0) )
    cAttrNam := oExtAttr.CreateAttr(coLSchet, 'Примечание по перечислению', cgAttrType_Str);

  if RunWindowModal(WinImp)=cmDefault
  {
    if isImportOk
    MakeImport;
  }
  SaveMyDsk (cPoluchatel, '#(GPInt)_cPoluchatel');
  SaveMyDsk (cBank      , '#(GPInt)_cBank'      );
  SaveMyDsk (sImpFile   , '#(GPInt)_sImpFile'   );
  closeinterface(cmDefault);
}
end;
end.

VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;
Procedure Run;                                  {runinterface(#(GPInt));}
Function  GetReportName               : String; {GetReportName := '#(GPNam) (ЭМ)';}
Function  GetGroupName (Level : Word) : String; {Level:=Level;GetGroupName := '';}
function  GetPriority                 : Integer;{GetPriority := 1;}
function  VisibleInModule(Ind : Byte) : String; {Ind:=Ind; VisibleInModule := 'STAFFMAINMENU';}
End.