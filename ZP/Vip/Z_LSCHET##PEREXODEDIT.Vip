/*************************************************************************************************\
* Наименование:  Доработка интерфейса Лицевой счет-> Переходы в межпериод                         *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    требуется начинать выбор распределения с номера заказа с последующим             *
*                автоматическим формированием счета бухгалтерского учета.                         *
*                Собирать перед Z_WT##WTCOSTSHARING.vip                                           *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#771          |10/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#3574         |31/10/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#include GetKau.Vih
#component "Z_LSCHET"
Alter Interface PEREXODEDIT;
OverLoad
  procedure PickWithParamCode(paramCode: word);
end;

#include GetKau.Var
#include GP_Func_ZP.Var

var wKodAnalitik :word;//код "избранная аналитика"

var pTmp         :comp;
//----------------------------------
// для распределения затрат
Create view vCostSharing
var DT_Perexod:date; //Дата перехода
    DT_Period :date;//дата начала периода
    pLschet:comp;
From PRVIDOPL
Where
((      pcCostSharing == PRVIDOPL.CHOICE
    and pLschet == PRVIDOPL.CLSCH
    and DT_Period == PRVIDOPL.DATAN (noindex)
    and DT_Perexod == Prvidopl.Dataf(noindex)

));


//------------------------------------
// Установить параметры по плану
//------------------------------------
Function SetFieldsByMnPlan(_pMnPlan:comp):boolean;
{ Result:=false;
  #FUNC_ZP_Fill_To_SchKauParam(Perexod,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.SetFieldsByMnPlan(_pMnPlan,PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(Perexod,cSchetD,cSubSchD,cKaud,Tbld)
    Result:=true;
    SetModified(true);
    UpdateTable;
  }
  //set Perexod.FLAGS2:=Perexod.FLAGS2 or pchSHPZ;
  PushPos(#PerexodParams);

  if getfirst PerexodParams where (( parSchSubsch ==  PerexodParams.ParamCode ))=tsok
  { PerexodParams.Value := GetParamValue(PerexodParams.ParamCode, PerexodParams.BitMask);
    update current PerexodParams;
  }
  if getfirst PerexodParams where (( parKAU ==  PerexodParams.ParamCode ))=tsok
  { PerexodParams.Value := GetParamValue(PerexodParams.ParamCode, PerexodParams.BitMask);
    update current PerexodParams;
  }
  if getfirst PerexodParams where (( parKAU ==  PerexodParams.ParamCode ))=tsok
  { PerexodParams.Value := GetParamValue(PerexodParams.ParamCode, PerexodParams.BitMask);
    update current PerexodParams;
  }
  if getfirst PerexodParams where (( parFavoriteAn ==  PerexodParams.ParamCode ))=tsok
  { PerexodParams.Value := GetParamValue(PerexodParams.ParamCode, PerexodParams.BitMask);
    update current PerexodParams;
  }
  PopPos(#PerexodParams) ;
  Result:=true;
  SetModified(true);
  UpdateTable;
}//Function SetFieldsByMnPlan(_pMnPlan:comp);

//-------------------------------
//проверим субсчет по заказу, если не совпадает поменяем
Procedure Check_Analitic_MnPlan;
{ #FUNC_ZP_Fill_To_SchKauParam(Perexod,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.Check_Analitic_MnPlan(PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(Perexod,cSchetD,cSubSchD,cKaud,Tbld)
    SetModified(true);
    UpdateTable;
  }
} //Procedure Check_Analitic_MnPlan;


//------------------------------------------------------------------------------
// редактирование параметров перехода
//------------------------------------------------------------------------------
procedure PickWithParamCode(paramCode: word);
{ var need_Pick:boolean=true;
  case paramCode of
   parSchSubsch
  ,parKAU:
  { if paramCode=parKAU
    { if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed'
    }
    if Perexod.cSchetD='' or (paramCode=parKAU and QuickChoiceName <> '')
    { pTmp:=0;
      if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
      {
        if SetFieldsByMnPlan(pTmp)
        { if paramCode=parSchSubsch
          { need_Pick:=false
          }
        }
      }
    }
  }
  end;
  if need_Pick
  { Inherited::PickWithParamCode(paramCode);
    if paramCode=parKAU Check_Analitic_MnPlan;

  }
} //procedure PickWithParamCode(paramCode: word);

//-----------------------------------------------
// синхронизируем переходы в разбивке по счетам
// if _Option =1 - корректируем дату начала
// if _Option =2 - корректируем дату окончания
//-----------------------------------------------
Function Sync_ShareCost (_DT_Perexod_B:date;_DT_Perexod_E:date; _Option:word=0):boolean;
//var _DT_CorrNext_Period:boolean;
{ Result:=true;
  vCostSharing.DT_Perexod:=_DT_Perexod_B;
  vCostSharing.DT_Period:=date(1,month(_DT_Perexod_B),year(_DT_Perexod_B));
  vCostSharing.pLschet:=Perexod.cLsch;
  if vCostSharing.getfirst PrVidopl=tsok
  { if _Option=0
    { if Perexod.DatOK<>vCostSharing.PrVidopl.DATOK
      { //изменилась дата - сначала найдем после этой даты
        Sync_ShareCost(Add_Day(_DT_Perexod_E,1),ZeroDate,1);
        set vCostSharing.DT_Perexod:=_DT_Perexod_B;
      }
    } //if _Option==0
    vCostSharing._Loop fullcache PrVidopl
    { if (_Option and 1)>0
      { vCostSharing.update current PrVidopl set PrVidopl.Dataf:=_Dt_Perexod_b;
      }
      else
      if (_Option and 2)>0
      { vCostSharing.update current PrVidopl set PrVidopl.Datok:=_Dt_Perexod_E;
      }
      else
      { if vCostSharing.PrVidopl.Dataf<>Perexod.DatIzm
        or vCostSharing.PrVidopl.DatOk<>Perexod.DatOk
        { vCostSharing.PrVidopl.Dataf:=Perexod.DatIzm;
          vCostSharing.PrVidopl.DatOk:=Perexod.DatOk;
          vCostSharing.update current PrVidopl;
        }
      }

    }
  }//if vCostSharing.getfirst PrVidopl=tsok
} //Function Sync_ShareCost (_DT_Perexod:date;_Option:word):boolean;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
  //------------------------
  cmInit:
  { //"Настройки Галактики \ Управление персоналом \ Расчеты с персоналом \ Избранная аналитика"
    wKodAnalitik:=wGetTune('UP.ZAR.FAVORITEANALYTICS');
    //----------------------
    if  inherited :: handleEvent (cmInit)=heAbort then Abort;
    //----------------------

  }
  cmCheckField:
  { if  inherited :: handleEvent (cmCheckField)=heAbort then Abort;
    case CurField of
    #PEREXOD.DATIZM:
    { var ww_dt:date;
      ww_dt:=StrToDate(Replace(OldFieldValue,'.','/'),'DD/MM/YYYY');
      if ww_dt<>ZeroDate Sync_ShareCost(ww_dt,Perexod.DatOk,0);
    }
    #PEREXOD.DATOK:
    { var ww_dt:date;
      ww_dt:=StrToDate(Replace(OldFieldValue,'.','/'),'DD/MM/YYYY');
      if ww_dt<>ZeroDate Sync_ShareCost(Perexod.DatIzm,ww_dt,0);
    }
    end;
  }

  end;
end.
