/*************************************************************************************************\
* Наименование: Предварительный расчет отпуска                                                    *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Документы / Все приказы по персоналу                                                *
* Примечания:                                                                                     *
* В интерфейс Заработная плата / Операции / Отпуска / Расчет отпускных добавлен параметр          *
* "Предварительный расчёт".                                                                       *
* Если при расчёте отпуска этот параметр включён, то суммы за текущий отчетный месяц не           *
* учитываются при расчёте.                                                                        *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#777          |13/09/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_Sredn"

alter interface RasOtp;

  const
    stPreliminaryCalc = 4; // Предварительный расчёт
  end;

  var
    SaveFlagArme: Word;
    NeedRestoreFlagArme: Boolean;

  // Определяет какой элемент массива Arme соответствует месяцу CM и году CY
  function LocateArmeIndex(AMonth: Byte; AYear: Word; CM: Byte; CY: Word): Byte;
  var
    M: Byte;
    Y: Word;
  begin
    result := 0;
    for(M := 1; M <= 12; M++)
    begin
      Y := if(M >= AMonth, AYear - 1, AYear);
      if CM = M and CY = Y then
      begin
        result := M;
        exit;
      end;
    end;
  end;

  // Проходит по всем выделенным отпускам и изменяет пометку для текущего месяца
  procedure UpdateMarks(NewState: Char);
  var
    DOtchB, DOtchE: Date;
    ArmeIndex: Byte;
  begin
    DOtchB := dGetTune('UP.DATOTCH');
    //если в будущем месяце
    if coGetTune('UP.TEKBUD')=1
    { DOtchB :=Add_Months(DOtchB,1);
    }
    DOtchE := To_Date(Last_Day(DOtchB), Month(DOtchB), Year(DOtchB));


    // Проходим по всем помеченным отпускам
    _loop Formarks where ((MyO == Formarks.Choice)) ordered by index ForMarks10
    begin
      // Если это отпуск будущего периода
      if FactOtpusk.FactYearBeg > DOtchE then
      begin
        // Определяем индекс, соответствующий текущему отчётному месяцу
        ArmeIndex := LocateArmeIndex(AD_Month(Otpusk.DataN), 
         if(IsValid(tnFactOtpusk), FactOtpusk.PeriodYear, AD_Year(Otpusk.DataN)), Month(DOtchB), Year(DOtchB));
        if ArmeIndex != 0 then
        begin
          // Меняем пометку для текущего отчётного месяца на закладке "Суммы и коэффициенты расчетного периода" отпуска
          update current Otpusk set Otpusk.Arme[ArmeIndex] := NewState;
        end;
      end;
    end;
  end;

  handleEvent                                                                   
    cmInit:
      begin
        inherited::handleEvent(cmInit);
        NeedRestoreFlagArme := false;
        // Если в поле "Выполнить расчет" включен параметр "Предварительный расчёт"
        if (ZarOtp and stPreliminaryCalc) != 0 then
        begin
          // Запоминаем значение параметра "Сохранять пометки"
          SaveFlagArme := wGetTune('UP.ZAR.FlagArme');
          // Включаем параметр "Сохранять пометки"
          if SaveFlagArme != 1 then
          begin
            wSetTune('UP.ZAR.FlagArme', 1);
            NeedRestoreFlagArme := true;
          end;
          UpdateMarks('-');
        end else
        begin
          // Если в поле "Выполнить расчет" выключен параметр "Предварительный расчёт"
          // Так, как могли остаться "-" от запуска предварительного расчёта,
          // которые не будут включены в расчёт, если будет включён параметр "Сохранять пометки",
          // для всех отпусков будущего месяца поставим "+" у текущего месяца
          UpdateMarks('+');
        end;
      end;
    cmDone:
      begin
        inherited::handleEvent(cmDone);
        if NeedRestoreFlagArme then
          wSetTune('UP.ZAR.FlagArme', SaveFlagArme);
      end;
  end;

end.
