#component "Z_DocsFss"
Alter Interface Notifications;



window winParam 'Параметры получения сообщений с Портала СФР', escclose;

handleevent

cmValue7:
{

  if wParMessage_ = 3
  {
    inherited :: HandleEvent(cmValue7);
  }
  else
  {
    message('Получить сообщения можно только за период',Information);
    stop; abort;
  }
}

end; //handleevent win

end; //win

end.
