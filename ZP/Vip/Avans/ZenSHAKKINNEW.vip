#include IDepartmentValidator.obj

#component "GP_ZP"

Interface ZenSHAKKINNEW 'Аванс' gray;
  show (, , 161, 32);

const
!    stPlanned = 0;
  stPlanned         = -1;//балансный
  stActual          = 1;
  hkWorking         = 1;
  cfDisregardPeriod = 64;
end;

var
  Counter  : longint;
  KodCex   : string;
  DatNach1
, DatNach2 : date;
  VsegoAvPl
, VsegoAvF : double;
  i12
, i13
, i14      : double;
  NRecSb
, NRecGP
, NRecRB   : comp;
  isSaved  : boolean;

create view
var
  stPodr       : string;
  sFileNameNew : string;
as select
  SubStr(KatPodr2.Kod, 1, 3) 
    (FieldName = KodCex)
, *
from
  UserRights
, Persons
, LSchet
, movelsc
, LStab
, KatPodr
, KatPodr KatPodrF
, KatPodr KatPodr2
, uowrktabel
, Catalogs
, AttrVal
, GP_PersAv
, GP_PersAv GP_PersAv2
, LSchet LSchet2
, GP_NeyavAv
//, pick
//, Pick PickPodr
where
((
//    PickPodr.cRec        == KatPodr.NRec
//AND word(11)             == PickPodr.wList
//AND
    LSchet.tPerson       == Persons.NRec
AND UserID               == Zar_User.cUser
AND KatPodr.NRec         == UserRights.cRecDs
AND UserID               == UserRights.cUser
AND LSchet.NRec          == Shtraf.cLSch 
AND 187                  == Shtraf.VidUd

AND GP_PersAv.cKatPodr   == KatPodr2.NRec
));

var DepMarker: TPtr;
var DepartmentValidator: IDepartmentValidator;

  screen createdScreen;
    show (, , 160, 5);

/*
    bevel
      divisionBevel {1, 1, 55, 5, bsLowered, bsFrame};
    bevel
      periodBevel {56, 1, 83, 5, bsLowered, bsFrame};
    bevel
      totalBevel {133, 1, 161, 5, bsLowered, bsFrame};
*/

    fields
      stPodr              ('Подразделения'    , , sci13Esc ) : Protect, PickButton;
      DatNach1            ('Начало периода'                ) : noProtect;
      VsegoAvPl           ('Плановый аванс'                ) : [10.2], protect;
      DatNach2            ('Окончание периода'             ) : noProtect;
      VsegoAvF            ('Фактический аванс'             ) : [10.2], protect;

    buttons
      cmRassch;
      cmSohr;
      cmButtonOT;
      cmPriravn;
      cmExcel;
      cmTotal, default;

<<

    Фильтр по подразделению:                              Период                   <. Рассчитать .><. Сохранить  .><. Настройка  .>    Всего:
   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@     Начало:    .@@@@@@@@@@                                                       Плановый:    .@@@@@@@@@@
                                                          Окончание: .@@@@@@@@@@   <. Приравнять .><.   Excel    .><.    Итог    .>    Фактический: .@@@@@@@@@@

>>
  end;

  browse createdBrowse
    show (, 6, 160, 31);

    table
      GP_PersAv;

    fields
      GP_PersAv.tabn        #3'Табельный'
                          , #3'номер'            : [10]  , Protect;
      GP_PersAv.fio         #3'ФИО'              : [30]  , Protect;
      KodCex                #3'Цех'              : [10]  , Protect;
!      GP_PersAv.DatProvTab #3'Дата проверки'
!                      , #3'табеля'           : [10]  , Protect;
      GP_PersAv.DatPos      #3'Дата приема'      : [10]  , Protect;
      GP_PersAv.DatUv       #3'Дата увольнения'  : [10]  , Protect;
      GP_PersAv.SistOpl     #3'СистОпл'          : [7]   , Protect;
      GP_PersAv.Perech      #3'Перечисление'     : [10]  , Protect;
      GP_PersAv.ProcAlim    #3'Алименты,%'       : [5]   , Protect;
      GP_PersAv.PriznAlim   #3'Учитывать'
                          , #3'Алименты'         : [5]   , Protect, PickButton;

      GP_PersAv.Otrab       #3'Отработано'       : [11.2], Protect;
      GP_PersAv.OtrabNO     #3'Опл.неявки'
                          , #3'(К, Г, МО и др.)' : [11.2], Protect;
      GP_PersAv.OtrabNN     #3'Неопл.неявки'
                          , #3'(Б, ОЖ, ДО и др.)': [11.2], Protect;
      GP_PersAv.OtrabV      #3'Отработано,'
                          , #3'ВСЕГО,ч'          : [11.2], Protect;
      GP_PersAv.PlanCh      #3'По плану'
                          , #3'(с учетом НВ)'    : [11.2], Protect;
      GP_PersAv.AVplan      #3'Аванс плановый'   : [11.2], Protect;
      GP_PersAv.AVRasch     #3'Аванс расчетный'  : [11.2], Protect;
      GP_PersAv.AVfact      #3'Аванс фактический': [11.2], NoProtect;
  end;
//*****************************************************************************
Procedure FormUO;
{
  _loop UOWRKTABEL
    if (GetFirst AttrVal where ((16045            == AttrVal.wtable 
                             AND 2814749767106684 == AttrVal.cAttrNam 
                             AND UOWRKTABEL.NRec  == AttrVal.cRec)) = tsOk)
      {
        ClearBuffer(#GP_NeyavAv);
        GP_NeyavAv.Kod     := UOWRKTABEL.Num;
        GP_NeyavAv.Priznak := AttrVal.vdouble;
        insert current GP_NeyavAv;
      }
}
//*****************************************************************************
Function GetFiltrName : string;
{
  result := '';
  var cnt : longint; cnt := GetMarkerCount(DepMarker);

  if (cnt = 1)
    {
      var cr : comp;
      GetMarker(DepMarker, 0, cr);
      if (GetFirst KatPodrF where (( cr == KatPodrF.NRec ))= tsOk)
        result := KatPodrF.Name;
    }
  else
    result := 'Выбрано: ' + string(cnt);
}
//*****************************************************************************
Function GetFiltrCode : string;
{
  result := '';
  var cnt : longint; cnt := GetMarkerCount(DepMarker);

  if (cnt > 0)
    {
      var cr : comp;
      var i  : longint;

      for ( i := 0; i < cnt; i++ )
        if GetMarker( DepMarker, i, cr )
          if (GetFirst KatPodrF where (( cr == KatPodrF.NRec ))= tsOk)
            result += if (trim(result) = '', '', ', ') + KatPodrF.Kod;
    }
  else result := '';
}
//*****************************************************************************
procedure Rebuild(bCheckProt : boolean);
{
  if (bCheckProt)
    if (GetFirst UserRights <> tsOk)
      Exit;

  delete all GP_PersAv;
  delete all GP_NeyavAv;

  _LOOP LSchet where ((KatPodr.NRec == LSchet.cex))
    {
      nextvisual;
      ClearBuffer(#GP_PersAv);
      GP_PersAv.Cex      := LSchet.Cex;
      GP_PersAv.tabn     := LSchet.StrTabn;
      GP_PersAv.razr     := LSchet.razr;
      GP_PersAv.tarsetka := LSchet.codtar;

      if (GetFirst Catalogs where ((LSchet.cappoint == Catalogs.NRec)) = tsOk)
        GP_PersAv.Dolzhn := Catalogs.Name;

      GP_PersAv.cKatPodr := Katpodr.NRec;

      GP_PersAv.NRec   := LSchet.NRec;
      GP_PersAv.datuv  := LSchet.datuv;
      GP_PersAv.datpos := LSchet.datpos;
      GP_PersAv.AvPlan := LSchet.Avplan;
      GP_PersAv.AvFact := LSchet.summa29;

      if (GetFirst Persons = tsOk)
        GP_PersAv.fio  := Persons.fio;

      _loop shtraf where ((LSchet.NRec == Shtraf.clsch 
                       AND 187         == Shtraf.vidud))
        GP_PersAv.ProcAlim := GP_PersAv.ProcAlim+shtraf.UDCHES / shtraf.UDZNAM * 100;

     GP_PersAv.ProcAlim := Round(GP_PersAv.ProcAlim,2);

     if (LSchet.sisopl=20)
       {
         //GP_PersAv.AvPlan:=WT_GHBD(hkWorking or cfDisregardPeriod, 0, 0, stPlanned, date(1,month(datNach1),year(datNach1)), date(last_day(datNach1),month(datNach1),year(datNach1)) )*LSchet.tarif;
         //GP_PersAv.AvPlan:=round(GP_PersAv.AvPlan,-1);
         GP_PersAv.sistOpl:='Сдельная';
       }
     else
       {
         GP_PersAv.AvPlan  := round(LSchet.tarif/2,-2);
         GP_PersAv.sistOpl := 'Повр.';
       }

     if (GetFirst LStab where ((year(DatNach1)  == LStab.yearn 
                            AND month(DatNach1) == LStab.mesn 
                            AND LSchet.NRec     == LStab.CLSchet)) = tsOk)
       GP_PersAv.DatProvTab := LStab.LASTDATE;

     if LoadWorkingTable(LSchet.NRec, month(DatNach1), year(DatNach1)) = 0
       {
         GP_PersAv.PlanCh := WT_GHBD(hkWorking or cfDisregardPeriod, 0, 0, stPlanned, datNach1, DatNach2);// - WT_GetAbsencesHours(stActual, 'НВ', datNach1, DatNach2);
         GP_PersAv.Otrab  := WT_GHBD(hkWorking                     , 0, 0, stActual , datNach1, DatNach2);

        _loop GP_NeyavAv where ((1 == GP_NeyavAv.Priznak))
          {
            GP_PersAv.OtrabNO := GP_PersAv.OtrabNO + WT_GetAbsencesHours(stActual, GP_NeyavAv.Kod, datNach1, DatNach2);

            if (WT_GetAbsencesHours(stActual, GP_NeyavAv.Kod, datNach1, DatNach2) > 0)
              GP_PersAv.OtrabNO_R:=GP_PersAv.OtrabNO_R+','+GP_NeyavAv.Kod+'='+WT_GetAbsencesHours(stActual, GP_NeyavAv.Kod, datNach1, DatNach2);
          }

        _loop GP_NeyavAv where ((2 == GP_NeyavAv.Priznak))
          {
            GP_PersAv.OtrabNN := GP_PersAv.OtrabNN + WT_GetAbsencesHours(stActual, GP_NeyavAv.Kod, datNach1, DatNach2);

            if WT_GetAbsencesHours(stActual, GP_NeyavAv.Kod, datNach1, DatNach2)>0
              GP_PersAv.OtrabNN_R := GP_PersAv.OtrabNN_R + ',' + GP_NeyavAv.Kod + '=' + WT_GetAbsencesHours(stActual, GP_NeyavAv.Kod, datNach1, DatNach2);
          }

        if (GP_PersAv.OtrabNO = 0)
          GP_PersAv.OtrabNO_R := '';

        if (GP_PersAv.OtrabNN = 0)
          GP_PersAv.OtrabNN_R := '';

        GP_PersAv.OtrabV:=GP_PersAv.Otrab+GP_PersAv.OtrabNO;

        //GP_PersAv.avRasch:=round(GP_PersAv.avplan/GP_PersAv.PlanCh*GP_PersAv.OtrabV,-1);
        GP_PersAv.avRasch := GP_PersAv.avplan/GP_PersAv.PlanCh*GP_PersAv.OtrabV;//*(if(GP_PersAv.ProcAlim<>0,GP_PersAv.ProcAlim/100,1));
        GP_PersAv.avRasch := round(GP_PersAv.avRasch,-2);
        if (GP_PersAv.avRasch > GP_PersAv.avplan)
          GP_PersAv.avRasch := GP_PersAv.AvPlan;
      }

    if (GetFirst shtraf where ((LSchet.NRec==shtraf.clsch AND 141==shtraf.vidud))=tsOk)
      {
        if shtraf.cpol=NRecSB GP_PersAv.Perech:='СБ';
        if shtraf.cpol=NRecGP GP_PersAv.Perech:='ГП';
        if shtraf.cpol=NRecRB GP_PersAv.Perech:='РБ';
      }
    else
      {
        if LSchet.CPODR=NRecSB GP_PersAv.Perech:='СБ';
        else if LSchet.CPODR=NRecGP GP_PersAv.Perech:='ГП';
        else if LSchet.CPODR=NRecRB GP_PersAv.Perech:='РБ';
        else GP_PersAv.Perech:='Касса';
      }

    insert current GP_PersAv;
    isSaved := false;
  }
}
//*****************************************************************************
function CheckSaved : boolean;
{
  if (isSaved) 
    {
      _LOOP GP_PersAv2
        if (GetFirst LSchet2 where ((GP_PersAv2.NRec == LSchet2.NRec)) = tsOk)
          if (LSchet2.summa28 <> GP_PersAv2.avfact OR  
              LSchet2.summa29 <> GP_PersAv2.avfact OR
              LSchet2.avplan  <> GP_PersAv2.avplan OR
              LSchet2.summa13 <> GP_PersAv2.avfact OR
              LSchet2.avfakt  <> GP_PersAv2.avfact)
            { 
              isSaved := false;
              break;
            }
    }

  result := isSaved;
}
//*****************************************************************************
HandleEvent

cmInit:
  {
    isSaved := true;
    DepMarker := InitMarker('ZenSHAKKIN', 8, 1, 1);
    set sFileNameNew := TranslatePath(sGetTune('NPOEM_OWN.ZP.ShablonAvans'));
    NRecSB:=2814749767107017;//сбербанк
    NRecGP:=2814749767107012;//газпромбанк
    NRecRB:=2814749767107016;//росбанк

    startNewVisual(vtRotateVisual, vfThread + vfTimer, 'Пожалуйста, подождите...', 100);
    InitWorkingTable;
    set stPodr:= GetFiltrName;
    DatNach1 := dGetTune('UP.DATOTCH');
    DatNach2 := date(15, month(DatNach1), year(DatNach1));
    insert current GP_PersAv; //служебная запись, не обращать внимания
    FormUO;
    stopVisual('', 0);
  }

cmDone:
  {
    DoneWorkingTable;
    DoneMarker(DepMarker, '');
  }

cmButtonOT:
  {
    runinterface(NastrUOTavans);
    delete all from GP_NeyavAv;
    FormUO;
  }

cmCheckField:
  {
    update current GP_PersAv;
  }

cmPriravn:
  {
    _loop GP_PersAv
      {
        GP_PersAv.AvFact:=GP_PersAv.AvRasch;
        update current GP_PersAv;
      }
  }

cmSohr:
  {
    _loop GP_PersAv
      if (GetFirst LSchet where ((GP_PersAv.NRec==LSchet.NRec)) = tsOk)
        {
          LSchet.summa28 := GP_PersAv.avfact;
          LSchet.summa29 := GP_PersAv.avfact;
          LSchet.avplan  := GP_PersAv.avplan;
          LSchet.summa13 := GP_PersAv.avfact;
          LSchet.avfakt  := GP_PersAv.avfact;
          update current LSchet;
        }

    isSaved := true;
  }

cmExcel:
  {
    i12       := 0;
    i13       := 0;
    i14       := 0;

    if (trim(sFileNameNew) = '')
      {
        ShowTune('Необходимо задать шаблон!', 'NPOEM_OWN.ZP.ShablonAvans');
        Exit;
      }
    if (NOT ExistFile(sFileNameNew))
      {
        ShowTune('Шаблона с заданным именем "' +  sFileNameNew + '" не существует!', 'NPOEM_OWN.ZP.ShablonAvans');
        Exit;
      }

    //xlCreateExcelWithTemplate('c:\debug\rash_avans.xls',true)
    xlCreateExcelWithTemplate(sFileNameNew,true);  
    //xlCreateExcelWithTemplate(TranslatePath('c:\debug\rash_avans.xls', true);
    if (xlIsExcelValid) 
      xlSetActiveWorkBookByName('1');

    xlsetCellStringValue(GetFiltrCode,2,5,2,5);
    xlSetFontStyle(1,2,6,2,6);
    xlsetCellStringValue(datetostr(DatNach1,'Month'),3,5,3,5);
    xlsetCellNumberValue(datetostr(DatNach1,'YYYY'),3,6,3,6);

    Counter:=8;
    _loop GP_PersAv
      {
        if (GetFirst KatPodr2 = tsOk)
          xlsetcellStringValue(KodCex, Counter, 1, Counter, 1);

        xlsetcellStringValue('''' + GP_PersAv.tabn, Counter, 2, Counter, 2);
        xlsetcellStringValue(GP_PersAv.fio      , Counter, 3, Counter, 3);
        xlsetcellStringValue(GP_PersAv.Perech   , Counter, 4, Counter, 4);
        xlsetcellDateValue  (GP_PersAv.DatPos   , Counter, 5, Counter, 5);
        xlsetcellDateValue  (GP_PersAv.DatUv    , Counter, 6, Counter, 6);
        xlsetcellNumberValue(GP_PersAv.Otrab    , Counter, 7, Counter, 7);
        xlsetcellStringValue(GP_PersAv.OtrabNO_R, Counter, 8, Counter, 8);
        xlsetcellStringValue(GP_PersAv.OtrabNN_R, Counter, 9, Counter, 9);
        xlsetcellNumberValue(GP_PersAv.OtrabV   , Counter,10, Counter,10);
        xlsetcellNumberValue(GP_PersAv.PlanCh   , Counter,11, Counter,11);
        xlsetcellNumberValue(GP_PersAv.AVPlan   , Counter,12, Counter,12);
        i12 := i12 + GP_PersAv.AVPlan;                                      
        xlsetcellNumberValue(GP_PersAv.AVRasch  , Counter,13, Counter,13);
        i13 := i13 + GP_PersAv.AVRasch;                                     
        xlsetcellNumberValue(GP_PersAv.AVFact   , Counter,14, Counter,14);
        i14 := i14 + GP_PersAv.AVFact;

        Counter := Counter + 1;
      }

    xlsetCellStringValue('ИТОГО',Counter,2,Counter,2);

    xlsetcellNumberValue(i12,Counter,12,Counter,12);
    xlsetcellNumberValue(i13,Counter,13,Counter,13);
    xlsetcellNumberValue(i14,Counter,14,Counter,14);

    xlSetFontStyle(1, Counter,1,Counter,20);
    xlSetFontSize(12,       8,1,Counter,20);


    xlkillExcel;
  }

cmTotal:
  {
    set VsegoAvPl := 0;
    set VsegoAvF  := 0;

    _loop GP_PersAv
      {
        set VsegoAvPl := VsegoAvPl + GP_PersAv.AvPlan;
        set VsegoAvF  := VsegoAvF  + GP_PersAv.AvFact;
      }

    ReReadRecord(#GP_PersAv);
  }

cmPick:
  {
    case (CurField) of
      #stPodr:
        {
          CheckSaved;
          if RunInterface('Z_KatPodr::SelectSalaryDepartments', 12, comp(DepMarker), DepartmentValidator, ZeroDate, 0) = cmDefault

          //if ( RunInterface('Z_KatPodr::GetSomePodr') = cmCancel )
          {}
          set stPodr:= GetFiltrName;
        }

      #GP_PersAv.priznAlim: 
        {
          if (GP_PersAv.priznAlim='V')
            {
              GP_PersAv.priznAlim := '';
              GP_PersAv.AvRasch   := GP_PersAv.avplan / GP_PersAv.PlanCh * GP_PersAv.OtrabV;
            }
          else
            {
              GP_PersAv.priznAlim := 'V';
              GP_PersAv.AvRasch   := round(GP_PersAv.AvRasch * (100 - GP_PersAv.ProcAlim) / 100, -2);
            }
          //message(GP_PersAv.AvRasch);
          update current GP_PersAv;
          ReReadRecord(#GP_PersAv);
          reScanPanel(#GP_PersAv);
        }
    end;
  }

cmDelOnProtect:
  {
    case Curfield of
      #stPodr :
        {
          CheckSaved;
          //delete all pick where ((word(11) == Pick.wlist));
          ClearMarker(DepMarker);
          set stPodr  := GetFiltrName
        }
    end;
  }

cmRassch:
  {
    delete all from GP_PersAv;

    StartNewVisual(vtNumericVisual,vfTimer,'Идёт расчет', 1);

    Counter := 6;

    var bCheckProt : boolean; bCheckProt := if (IsValid(#Zar_User) , (Zar_User.PodrShare <> '+'), false);

    var cnt : longint; cnt :=  GetMarkerCount(DepMarker);

    if (cnt > 0)
      {
        var cRec : comp;
        var i : longint;

        for( i := 0; i < cnt; inc(i))
          if ( GetMarker(DepMarker, i, cRec) )
            if (GetFirst KatPodr where ((cRec == KatPodr.NRec)) = tsOk)
              Rebuild(bCheckProt);
      }
    else
      _LOOP KatPodr
         Rebuild(bCheckProt);

    _loop GP_PersAv 
      {
	if (GP_PersAv.Datpos > DatNach2) 
          if (GetFirst movelsc where ((GP_PersAv.NRec == movelsc.cLSchet 
                                 AND (movelsc.datuv = Sub_Day(GP_PersAv.datpos, 1)))) <> tsOk)
            {
              delete current GP_PersAv;
              continue;
            }

	if (GP_PersAv.Datuv < DatNach1 AND GP_PersAv.Datuv <> date(0, 0, 0))
          {
	    delete current GP_PersAv;
            continue;
	  }

	if (GP_PersAv.Datuv <= date(Last_Day(DatNach1), month(DatNach1), year(DatNach1)) 
        AND GP_PersAv.Datuv <> date(0, 0, 0)) 
         {
           GP_PersAv.AvRasch := 0;
           GP_PersAv.AvFact := 0;
	   update current GP_PersAv;
	 }
     }

    StopVisual('',0);

    reScanPanel(#GP_PersAv);
    if (recordsInTable(#GP_PersAv) <> 0) 
      {
        GetFirst GP_PersAv;
      }
  }

cmHotKeys :
  PutHotCommand(RunMenu('GP_ZP::mnuZenSHAKKIN'));

cmValFld1:
  if (IsValid(#GP_PersAv))
    RunInterface('Z_LSchet::LSchet1', GP_PersAv.Cex, GP_PersAv.NRec, 0, 0);

cmDone:
  if (NOT CheckSaved)
    {
      Message('Перед выходом необходимо сохранить данные!');
      Abort;
    }

end;
end.

//*****************************************************************************

mnuZenSHAKKIN Menu
{
- 'Лицевой счет', cmValFld1, 'Открыть лицевой счет',,,;
}
