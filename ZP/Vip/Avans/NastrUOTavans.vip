#component "GP_ZP"

interface NastrUOTavans 'Настройка'  gray dialog;
  show (, , 81, 29);

table struct TabelRA
(
nREC:COMP,
Kod:string,
Name:string,
PriznA:double,
NameA:string
)
with index (VH01=kod,VH02=Name);

create view createdView
  as
select * from  UOWRKTABEL, attrnam, attrval, TabelRA;

  browse createdBrowse;
    show (, , 80, 25);

    table
      TabelRA;

    fields
      TabelRA.Kod 'Код': [5], protect;
      TabelRA.Name 'Наименование': [35], protect;
      TabelRA.PriznA 'Код'#13'входимости': [5], protect, pickButton;
      TabelRA.NameA 'Наименование','входимости': [35], protect;
  end;

  screen createdScreen;
    show (, 26, 80, 28);

  buttons
    cmOK;

<<

  <. Применить .>

>>

  end;

procedure UpdateAttrVh;
begin

if getfirst attrnam where ((16045==attrnam.wtable and 'Входимость в аванс'==attrnam.Name))=tsok
{
	if getfirst attrval where ((16045==attrval.wtable and   TabelRA.Nrec==attrval.crec and attrnam.nrec==attrval.cattrnam))=tsok
	{
	attrval.vdouble:=TabelRA.PriznA;
	update current attrval;
	}
	else
	{
	clearbuffer (#attrval);
	attrval.cattrnam:=attrnam.nrec;
	attrval.vdouble:=TabelRA.PriznA;
	attrval.wtable:=attrnam.wtable;
	attrval.crec:=TabelRA.Nrec;
	insert current attrval;
	}
}
end;







HandleEvent
cmInit:
{
//текстовое значение параметров решил прописать жестко в коде - очень уж их мало, заказчик клятвенно заверил, что быть других не может
//названия атрибутов также зашиты жестко ввиду невозможности использовать настройки

_loop UOWRKTABEL
{
clearbuffer(#TabelRA);
TabelRA.nrec:=UOWRKTABEL.Nrec;
TabelRA.Name:=UOWRKTABEL.NAME;
TabelRA.Kod:=UOWRKTABEL.NUM;


if getfirst attrnam where ((16045==attrnam.wtable and 'Входимость в аванс'==attrnam.Name))=tsok
{
if getfirst attrval where ((16045==attrval.wtable and UOWRKTABEL.nrec==attrval.crec and attrnam.nrec==attrval.cattrnam))=tsok
{
TabelRA.PriznA:=attrval.vdouble;
}
}

if TabelRA.PriznA=0 TabelRA.NameA:='Не обрабатывается';
if TabelRA.PriznA=1 TabelRA.NameA:='Включается в отработанное время';
if TabelRA.PriznA=2 TabelRA.NameA:='Не включается в отработанное время';

insert current TabelRA;

}
}

cmPick:
{
      Case CurField Of

       #TabelRA.PriznA:
       {
	if TabelRA.PriznA=2 TabelRA.PriznA:=50;
	if TabelRA.PriznA=1 TabelRA.PriznA:=2;
	if TabelRA.PriznA=0 TabelRA.PriznA:=1;
	if TabelRA.PriznA=50 TabelRA.PriznA:=0;

if TabelRA.PriznA=0 TabelRA.NameA:='Не обрабатывается';
if TabelRA.PriznA=1 TabelRA.NameA:='Включается в отработанное время';
if TabelRA.PriznA=2 TabelRA.NameA:='Не включается в отработанное время';


       update current    TabelRA;
       }



end;
RescanPanel(tnTabelRA);
}



cmOK:
{
_loop TabelRA
{
UpdateAttrVh;
}
}

cmCheckField:
  { 
  }
end;
end.

