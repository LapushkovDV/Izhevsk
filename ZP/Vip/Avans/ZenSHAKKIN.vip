     */

    StopVisual('',0);
    ReReadRecord(#PersAV);
    if getfirst PersAV=tsok {}
    reScanPanel(#PersAV);
    timelog('ZenSHAKKIN->cmRassch:Finish');
  }

cmHotKeys :
  PutHotCommand(RunMenu('GP_ZP::mnuZenSHAKKIN'));

cmValFld1:
  if (IsValid(#PersAv))
    RunInterface('Z_LSchet::LSCHET1', PersAv.Cex, PersAv.nrec, 0, 0);

cmDone:
  CheckSaved;

end;
end.

mnuZenSHAKKIN Menu
{
- 'Лицевой счет', cmValFld1, 'Открыть лицевой счет',,,;
}
