#include IDepartmentValidator.obj

#component "GP_ZP"

//*******************************************
Interface ZenSHAKKIN 'Аванс' gray;
//**********************************
  show (, , 161, 32);

  const
//    stPlanned = 0;
    stPlanned = -1;//балансный
    stActual = 1;
    hkWorking = 1;
    cfDisregardPeriod = 64;
  end;

var
  Counter  : longint;
  KodCex   : string;
  DatNach1
, DatNach2 : date;
  VsegoAvPl
, VsegoAvF : double;
  i12
, i13
, i14      : double;
  NrecSb
, NrecGP
, NrecRB   : comp;
  isSaved  : boolean;
  bSaveConf: boolean;
  bCheckProt : boolean;
//------------------------------
table struct PersAv
(
  nrec       : comp
, fio        : string
, tabn       : string
,KodPodr     :string
, DatProvTab : date
, Datpos     : date
, DatUv      : date
, priznAlim  : string
, procAlim   : double
, sistOpl    : string
, Perech     : String
, AvPlan     : double
, AvRasch    : double
, AvFact     : double
, Otrab      : double
, OtrabNO    : double
, OtrabNN    : double
, OtrabNO_R  : string
, OtrabNN_R  : string
, OtrabV     : double
, PlanCh     : double
, razr       : word
, tarsetka   : word
, Dolzhn     : string
, Cex        : comp
)
with index (p01=tabn, p02=fio);

table struct NeyavAV
(
Kod:string,
Priznak:integer
)
with index (N01=Priznak);
 
create view createdView
var
 stPodr       : string;
 sFileNameNew : string;
 pUserID      : comp;
 sUserName     :string;
 wMesN  :word;
 wYearn :word;
as select
 Lschet.Nrec
from
  userrights
, persons
, lschet
, movelsc
, lstab
, KatPodr
, KatPodr KatPodrF
, uowrktabel
, shtraf shtraf_alim
//, attrval
, PersAv
, NeyavAv
//, pick
//, Pick PickPodr
where
((
//    PickPodr.cRec        == KatPodr.NRec
//AND word(11)             == PickPodr.wList
//AND
     KatPodr.NRec == LSchet.cex
and (Lschet.Datuv=ZeroDate or Lschet.Datuv>=DatNach1)
and lschet.tPerson       == Persons.NRec
//AND pUserID               == Zar_User.cUser - не везде может быть заполнен
AND sUserName            == Zar_User.OwnName
//--------------------------------
AND KatPodr.NRec         == UserRights.cRecDs
//AND pUserID               == UserRights.cUser
AND sUserName            == UserRights.OWNNAME
//--------------------------
and lschet.nrec == shtraf.clsch
and 141 == shtraf.vidud
and lschet.nrec == shtraf_alim.clsch
and 187 == shtraf_alim.vidud
and (shtraf_alim.DATOK =ZeroDate or shtraf_alim.DATOK>=DatNach1  )
and lschet.nrec == lstab.CLSCHET
and wYearn ==lstab.yearn
and wMesN  ==lstab.mesn
and Lschet.Nrec == movelsc.clschet
and Sub_Day(Lschet.datpos, 1) == movelsc.datuv(noindex)
));

Create view vSpr
var
   pCatalogs:comp;
From Catalogs
where ((
  pCatalogs == Catalogs.nrec
))  ;


var DepMarker: TPtr;
var DepartmentValidator: IDepartmentValidator;

  screen createdScreen;
    show (, , 160, 5);

/*
    bevel
      divisionBevel {1, 1, 55, 5, bsLowered, bsFrame};
    bevel
      periodBevel {56, 1, 83, 5, bsLowered, bsFrame};
    bevel
      totalBevel {133, 1, 161, 5, bsLowered, bsFrame};
*/

    fields
      stPodr              ('Подразделения'    , , sci13Esc ) : Protect, PickButton;
      DatNach1            ('Начало периода'                ) : noProtect;
      VsegoAvPl           ('Плановый аванс'                ) : [10.2], protect;
      DatNach2            ('Окончание периода'             ) : noProtect;
      VsegoAvF            ('Фактический аванс'             ) : [10.2], protect;

    buttons
      cmRassch;
      cmSohr;
      cmButtonOT;
      cmPriravn;
      cmExcel;
      cmTotal, default;

<<

    Фильтр по подразделению:                              Период                   <. Рассчитать .><. Сохранить  .><. Настройка  .>    Всего:
   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@     Начало:    .@@@@@@@@@@                                                       Плановый:    .@@@@@@@@@@
                                                          Окончание: .@@@@@@@@@@   <. Приравнять .><.   Excel    .><.    Итог    .>    Фактический: .@@@@@@@@@@

>>
  end;

  browse createdBrowse;
    show (, 6, 160, 31);

    table
      PersAv;

    fields
      PersAv.tabn       'Табельный'
                      , 'номер'            : [10]  , Protect;
      PersAv.fio        'ФИО'              : [30]  , Protect;
      PersAv.KodPodr     'Цех'              : [10]  , Protect;
!      PersAv.DatProvTab 'Дата проверки'
!                      , 'табеля'           : [10]  , Protect;
      PersAv.DatPos     'Дата приема'      : [10]  , Protect;
      PersAv.DatUv      'Дата увольнения'  : [10]  , Protect;
      PersAv.SistOpl    'СистОпл'          : [7]  , Protect;
      PersAv.Perech     'Перечисление'     : [10]  , Protect;
      PersAv.ProcAlim   'Алименты,%'       : [5]  , Protect;
      PersAv.PriznAlim  'Учитывать'
                      , 'Алименты'         : [5], Protect, PickButton;

      PersAv.Otrab      'Отработано'       : [11.2], Protect;
      PersAv.OtrabNO    'Опл.неявки'
                      , '(К, Г, МО и др.)' : [11.2], Protect;
      PersAv.OtrabNN    'Неопл.неявки'
                      , '(Б, ОЖ, ДО и др.)': [11.2], Protect;
      PersAv.OtrabV     'Отработано,'
                      , 'ВСЕГО,ч'          : [11.2], Protect;
      PersAv.PlanCh     'По плану'
                      , '(с учетом НВ)'    : [11.2], Protect;
      PersAv.AVplan     'Аванс плановый'   : [11.2], Protect;
      PersAv.AVRasch    'Аванс расчетный'  : [11.2], Protect;
      PersAv.AVfact     'Аванс фактический': [11.2], NoProtect;
  end;

Procedure FormUO;
{ var _pVA_UO_VHV_Avans:comp=ExtAttr_ID(coUOWRKTABEL,'Входимость в аванс');
  var _fVA_UO_VHV_Avans:double;
  timelog('ZenSHAKKIN->FormUO');

  _loop UOWRKTABEL
   // if getfirst attrval where ((16045==attrval.wtable and 2814749767106684==attrval.cattrnam and UOWRKTABEL.nrec==attrval.crec))=tsok
  {  _fVA_UO_VHV_Avans:=doGetAttrID(coUOWRKTABEL,UOWRKTABEL.Nrec,_pVA_UO_VHV_Avans);
     if _fVA_UO_VHV_Avans>0
      {
        timelog('ZenSHAKKIN->FormUO:'+UOWRKTABEL.Num);
        clearbuffer(#NeyavAv);
        NeyavAv.Kod:=UOWRKTABEL.Num;
        NeyavAv.Priznak:=_fVA_UO_VHV_Avans;//attrval.vdouble;
        insert current NeyavAv;
      }
  }
} //Procedure FormUO;

Function GetFiltrName : string;
{
  result := '';
  var cnt : longint; cnt := GetMarkerCount(DepMarker);

  if (cnt = 1)
    {
      var cr : comp;
      GetMarker(DepMarker, 0, cr);
      if (getfirst KatPodrF where (( cr == KatPodrF.Nrec ))= tsOk)
        result := KatPodrF.Name;
    }
  else
    result := 'Выбрано: ' + string(cnt);
}

Function GetFiltrCode : string;
{
  result := '';
  var cnt : longint; cnt := GetMarkerCount(DepMarker);

  if (cnt > 0)
    {
      var cr : comp;
      var i  : longint;

      for ( i := 0; i < cnt; i++ )
        if GetMarker( DepMarker, i, cr )
          if (GetFirst KatPodrF where (( cr == KatPodrF.Nrec ))= tsOk)
            result += if (trim(result) = '', '', ', ') + KatPodrF.Kod;
    }
  else result := '';
}

Function GetCatalogsName(_pCatalogs:comp):string; cacheable;
{ Result:='';
  vSpr.pCatalogs:=_pCatalogs;
  vSpr._Loop Catalogs
    Result:=vSpr.Catalogs.Name
} //Function GetCatalogsName(_pCatalogs:comp):string; cacheable;

Function  Rebuild:boolean;//(bCheckProt : boolean);
{ Result:=false;
  timelog('ZenSHAKKIN->Rebuild:Start '+KatPodr.Kod);
  if (bCheckProt)
    if (GetFirst UserRights <> tsOk)
    { Result:=true;
      Exit;
    }
  timelog('ZenSHAKKIN->Rebuild:Start '+KatPodr.Kod);

   _LOOP fullcache LSchet
   {
     if not nextvisual
     { Exit;

     }
     timelog('ZenSHAKKIN->Rebuild:Lschet.StrTabn='+Lschet.StrTabn);

      if (Lschet.Datpos > DatNach2)
         // if (GetFirst movelsc where ((PersAv.nrec == movelsc.clschet
         //                        and (movelsc.datuv = Sub_Day(PersAv.datpos, 1)))) <> tsOK)
         if getfirst movelsc=tsok
            {
              //delete current PersAv;
              continue;
            }

     	//if (PersAv.Datuv < DatNach1 and PersAv.Datuv <> date(0, 0, 0))
      if Lschet.Datuv<>ZeroDate
        if Lschet.Datuv < DatNach1
      { //delete current PersAV;
          continue;
	    }
     timelog('ZenSHAKKIN->Rebuild:PersAv');

     clearbuffer(#PersAv);
     PersAv.Cex      := lschet.Cex;
     PersAv.tabn     := lschet.StrTabn;
     PersAv.razr     := lschet.razr;
     PersAv.tarsetka := lschet.codtar;

     //if (getfirst catalogs where ((lschet.cappoint==catalogs.nrec))=tsok)
       PersAv.Dolzhn:=GetCatalogsName(lschet.cappoint) ;//catalogs.name;

     PersAv.KodPodr:= substr(Katpodr.kod,1,3);

     PersAv.nrec   := lschet.nrec;
     PersAv.datuv  := lschet.datuv;
     PersAv.datpos := lschet.datpos;
     PersAv.AvPlan := lschet.Avplan;
     PersAv.AvFact := lschet.AvFakt;

     //if (GetFirst persons = tsok)
     _Loop fullcache persons
       PersAv.fio  := persons.fio;

    _loop fullcache shtraf_alim //where ((lschet.nrec==shtraf.clsch and 187==shtraf.vidud))
      PersAv.ProcAlim:=PersAv.ProcAlim+shtraf_alim.UDCHES/shtraf_alim.UDZNAM*100;

    PersAv.ProcAlim:=round(PersAv.ProcAlim,2);

    if (lschet.sisopl=20)
      {
        //PersAv.AvPlan:=WT_GHBD(hkWorking or cfDisregardPeriod, 0, 0, stPlanned, date(1,month(datNach1),year(datNach1)), date(last_day(datNach1),month(datNach1),year(datNach1)) )*lschet.tarif;
        //PersAv.AvPlan:=round(PersAv.AvPlan,-1);
        PersAv.sistOpl:='Сдельная';
      }
    else
      {
        PersAv.AvPlan  := round(lschet.tarif/2,-2);
        PersAv.sistOpl := 'Повр.';
      }

    //if getfirst lstab where ((year(DatNach1)==lstab.yearn and month(DatNach1)==lstab.mesn and lschet.nrec==lstab.CLSCHET))=tsok
    _Loop fullcache LsTab
      PersAv.DatProvTab:=LSTAB.LASTDATE;
    timelog('ZenSHAKKIN->Rebuild:LoadWorkingTable');

    if LoadWorkingTable(LSchet.Nrec, wMesn, wYearN) = 0
    {
        PersAv.PlanCh := WT_GHBD(hkWorking or cfDisregardPeriod, 0, 0, stPlanned, datNach1, DatNach2);// - WT_GetAbsencesHours(stActual, 'НВ', datNach1, DatNach2);
        PersAv.Otrab  := WT_GHBD(hkWorking, 0, 0, stActual, datNach1, DatNach2);

        _loop NeyavAv where ((1==NeyavAv.Priznak))
        { PersAv.OtrabNO:=PersAv.OtrabNO+WT_GetAbsencesHours(stActual, NeyavAv.Kod, datNach1, DatNach2);
          if (WT_GetAbsencesHours(stActual, NeyavAv.Kod, datNach1, DatNach2) > 0)
          { PersAv.OtrabNO_R:=PersAv.OtrabNO_R+','+NeyavAv.Kod+'='+WT_GetAbsencesHours(stActual, NeyavAv.Kod, datNach1, DatNach2);
          }
        }

        _loop NeyavAv where ((2==NeyavAv.Priznak))
        { PersAv.OtrabNN:=PersAv.OtrabNN+WT_GetAbsencesHours(stActual, NeyavAv.Kod, datNach1, DatNach2);
          if WT_GetAbsencesHours(stActual, NeyavAv.Kod, datNach1, DatNach2)>0
          { PersAv.OtrabNN_R:=PersAv.OtrabNN_R+','+NeyavAv.Kod+'='+WT_GetAbsencesHours(stActual, NeyavAv.Kod, datNach1, DatNach2);
          }
        }

        if (PersAv.OtrabNO = 0)
          PersAv.OtrabNO_R := '';

        if (PersAv.OtrabNN = 0)
          PersAv.OtrabNN_R := '';

        PersAv.OtrabV:=PersAv.Otrab+PersAv.OtrabNO;

        //PersAv.avRasch:=round(PersAv.avplan/PersAv.PlanCh*PersAv.OtrabV,-1);
        PersAv.avRasch := PersAv.avplan/PersAv.PlanCh*PersAv.OtrabV;//*(if(PersAv.ProcAlim<>0,PersAv.ProcAlim/100,1));
        PersAv.avRasch := round(PersAv.avRasch,-2);
        if (PersAv.avRasch > PersAv.avplan)
          PersAv.avRasch := PersAv.AvPlan;
    } //if LoadWorkingTable(LSchet.Nrec, wMesn, wYearN) = 0
    PersAv.Perech:='Касса';
    //if (getfirst shtraf where ((lschet.nrec==shtraf.clsch and 141==shtraf.vidud))=tsok)
    if (LSchet.Summa27)<>0
    { if getfirst shtraf=tsok //
      { if shtraf.cpol=NrecSB PersAv.Perech:='СБ';
        if shtraf.cpol=NrecGP PersAv.Perech:='ГП';
        if shtraf.cpol=NrecRB PersAv.Perech:='РБ';
      }
      else
      { if LSCHET.CPODR=NrecSB PersAv.Perech:='СБ';
        else if LSCHET.CPODR=NrecGP PersAv.Perech:='ГП';
        else if LSCHET.CPODR=NrecRB PersAv.Perech:='РБ';
      }
    }
    if (PersAv.Datuv <= date(Last_Day(DatNach1), month(DatNach1), year(DatNach1))
        and PersAv.Datuv <> date(0, 0, 0))
    { PersAv.AvRasch := 0;
        PersAv.AvFact := 0;
	  }
    insert current PersAv;
    isSaved := false;
    timelog('ZenSHAKKIN->Rebuild:END Lschet');
  } //_LOOP LSchet where ((KatPodr.NRec == LSchet.cex))
  Result:=true;
  timelog('ZenSHAKKIN->Rebuild:Finish');

} //Function  Rebuild:boolean;

procedure CheckSaved;
{
   if (NOT isSaved)
     if (Message('Сохранить данные?', YesNo ) = cmYes)
     {
       PutCommand(cmSohr);
     }
}

HandleEvent

cmInit:
  { pUserID:=UserID();
    sUserName:=UserName();
    timelog_Init;
    timelog('ZenSHAKKIN->cmInit');
    bCheckProt := if (getfirst Zar_User=tsok , (Zar_User.PodrShare = '+'), true);// было <>

    bSaveConf := (wGetTune('NPOEM_OWN.ZP.Avans.Conf') = 1);
    isSaved := true;
    DepMarker := InitMarker('ZenSHAKKIN', 8, 1, 1);
    set sFileNameNew := TranslatePath(sGetTune('NPOEM_OWN.ZP.ShablonAvans'));
    NrecSB:=2814749767107017;//сбербанк
    NrecGP:=2814749767107012;//газпромбанк
    NrecRB:=2814749767107016;//росбанк

    startNewVisual(vtRotateVisual, vfThread + vfTimer, 'Пожалуйста, подождите...', 100);
    InitWorkingTable;
    set stPodr:= GetFiltrName;
    DatNach1 := dGetTune('UP.DATOTCH');
    DatNach2 := date(15, month(DatNach1), year(DatNach1));
    insert current PersAv; //служебная запись, не обращать внимания
    FormUO;
    stopVisual('', 0);
  }

cmDone:
  {
    CheckSaved;
    DoneWorkingTable;
    DoneMarker(DepMarker, '');
  }

cmButtonOT:
  {
    runinterface(NastrUOTavans);
    delete all from NeyavAv;
    FormUO;
  }

cmCheckField:
  {
    update current PersAV;
  }

cmPriravn:
  {
    _loop PersAv
      {
        PersAv.AvFact:=PersAv.AvRasch;
        update current PersAv;
      }
  }

cmSohr:
  {
    if (bSaveConf)
      if (Message('Имеются не сохраненные данные. Сохранить?', YesNo) <> cmYes)
        Exit;

    _loop PersAv
      if (getfirst lschet where ((PersAv.nrec==lschet.nrec)) = tsok)
        {
          //По просьбе Плинда Н.
          //lschet.summa28 := persAv.avfact;
          //lschet.summa29 := persAv.avfact;
          lschet.avplan  := persAv.avplan;
          lschet.summa13 := persAv.avfact;
          lschet.avfakt  := persAv.avfact;
          update current lschet;
        }

    isSaved := true;
  }

cmExcel:
  {
    i12       := 0;
    i13       := 0;
    i14       := 0;

    if (trim(sFileNameNew) = '')
      {
        ShowTune('Необходимо задать шаблон!', 'NPOEM_OWN.ZP.ShablonAvans');
        Exit;
      }
    if (NOT ExistFile(sFileNameNew))
      {
        ShowTune('Шаблона с заданным именем "' +  sFileNameNew + '" не существует!', 'NPOEM_OWN.ZP.ShablonAvans');
        Exit;
      }
    xlkillExcel;

    //xlCreateExcelWithTemplate('c:\debug\rash_avans.xls',true)
    xlCreateExcelWithTemplate(sFileNameNew,true);  
    //xlCreateExcelWithTemplate(TranslatePath('c:\debug\rash_avans.xls', true);
    if (xlIsExcelValid) 
      xlSetActiveWorkBookByName('1');
    StartNewVisual(vtNumericVisual,vfTimer,'Идёт печать', RecordsInTable(#PersAv));

    xlsetCellStringValue(GetFiltrCode,2,5,2,5);
    xlSetFontStyle(1,2,6,2,6);
    xlsetCellStringValue(datetostr(DatNach1,'Month'),3,5,3,5);
    xlsetCellNumberValue(datetostr(DatNach1,'YYYY'),3,6,3,6);
    Counter:=RecordsInTable(#PersAv);
    if not xlCreateMatrix(Counter+1,14)
    { message('Ошибка создания матрицы для вывода в Excel '+xlGetLastError());
    }
    Counter:=1;
    PushPos(#PersAv);
    _loop PersAv
      { if not NextVisual then break;
        xlStWriteToMatrix(Counter, 1, PersAv.KodPodr    );
        xlStWriteToMatrix(Counter, 2, '''' + PersAv.tabn);
        xlStWriteToMatrix(Counter, 3, PersAv.fio        );
        xlStWriteToMatrix(Counter, 4, PersAv.Perech     );
        xlDtWriteToMatrix(Counter, 5, PersAv.DatPos     );
        xlDtWriteToMatrix(Counter, 6, PersAv.DatUv      );
        xlDoWriteToMatrix(Counter, 7, PersAv.Otrab      );
        xlStWriteToMatrix(Counter, 8, PersAv.OtrabNO_R  );
        xlStWriteToMatrix(Counter, 9, PersAv.OtrabNN_R  );
        xlDoWriteToMatrix(Counter,10, PersAv.OtrabV     );
        xlDoWriteToMatrix(Counter,11, PersAv.PlanCh     );
        xlDoWriteToMatrix(Counter,12, PersAv.AVPlan     );
        i12 := i12 + PersAv.AVPlan;
        xlDoWriteToMatrix(Counter,13, PersAv.AVRasch);
        i13 := i13 + PersAv.AVRasch;
        xlDoWriteToMatrix(Counter,14, PersAv.AVFact);
        i14 := i14 + PersAv.AVFact;

        Counter := Counter + 1;
      }
    xlWriteMatrixToExcel(8,1);
    xlFreeMatrix;
    Counter:=Counter+8;
    xlsetCellStringValue('ИТОГО',Counter,2,Counter,2);

    xlsetcellNumberValue(i12,Counter,12,Counter,12);
    xlsetcellNumberValue(i13,Counter,13,Counter,13);
    xlsetcellNumberValue(i14,Counter,14,Counter,14);

    xlSetFontStyle(1, Counter,1,Counter,20);
    xlSetFontSize(12,       8,1,Counter,20);


    xlkillExcel;
    PopPos(#PersAv);
    ReScanPanel(#PersAv);
    StopVisual('',0);
  }

cmTotal:
  {
    set VsegoAvPl := 0;
    set VsegoAvF  := 0;

    _loop PersAv
      {
        set VsegoAvPl := VsegoAvPl + PersAv.AvPlan;
        set VsegoAvF  := VsegoAvF  + PersAv.AvFact;
      }

    ReReadRecord(#PersAv);
  }

cmPick:
  {
    case (CurField) of
      #stPodr:
        {
          CheckSaved;
          if RunInterface('Z_KatPodr::SelectSalaryDepartments', 12, comp(DepMarker), DepartmentValidator, ZeroDate, 0) = cmDefault

          //if ( RunInterface('Z_KatPodr::GetSomePodr') = cmCancel )
          {}
          set stPodr:= GetFiltrName;
        }

      #PersAv.priznAlim: 
        {
          if (PersAv.priznAlim='V')
            {
              PersAv.priznAlim := '';
              PersAv.AvRasch   := PersAv.avplan / PersAv.PlanCh * PersAv.OtrabV;
            }
          else
            {
              PersAv.priznAlim := 'V';
              PersAv.AvRasch   := round(PersAv.AvRasch * (100 - PersAv.ProcAlim) / 100, -2);
            }
          //message(PersAv.AvRasch);
          update current PersAv;
          ReReadRecord(#PersAv);
          reScanPanel(#PersAV);
        }
    end;
  }

cmDelOnProtect:
  {
    case Curfield of
      #stPodr :
        {
          CheckSaved;
          //delete all pick where ((word(11) == Pick.wlist));
          ClearMarker(DepMarker);
          set stPodr  := GetFiltrName
        }
    end;
  }

cmRassch:
  {
    delete all from PersAv;
    timelog('ZenSHAKKIN->cmRassch:START');

    StartNewVisual(vtIndicatorVisual,vfTimer+vfBreak+vfConfirm,'Идёт расчет', RecordsInTable(#Lschet));

    Counter := 6;
    //--------------------------------
    wYearN:=year (DatNach1);
    wMesN :=month(DatNach1);
    //--------------------------------


    var cnt : longint; cnt :=  GetMarkerCount(DepMarker);

    if (cnt > 0)
      {
        var cRec : comp;
        var i : longint;

        for( i := 0; i < cnt; inc(i))
          if ( GetMarker(DepMarker, i, cRec) )
            if (GetFirst KatPodr where ((cRec == KatPodr.NRec)) = tsOk)
            { if not Rebuild break;
            }
      }
    else
      _LOOP KatPodr
         if not Rebuild break;

     //-- перенес в расчет
     /*
    _loop fullcache PersAv
    {  if (PersAv.Datpos > DatNach2)
          if (GetFirst movelsc where ((PersAv.nrec == movelsc.clschet 
                                 and (movelsc.datuv = Sub_Day(PersAv.datpos, 1)))) <> tsOK)
            {
              delete current PersAv;
              continue;
            }

     	if (PersAv.Datuv < DatNach1 and PersAv.Datuv <> date(0, 0, 0))
      { delete current PersAV;
          continue;
	    }
      if (PersAv.Datuv <= date(Last_Day(DatNach1), month(DatNach1), year(DatNach1))
