#include UserReport.vih
#include ComFiltr.vih
#include CatFunc.vih
#include AdrFunc.vih
#include StrFunc.vih
#include AppFuncs.vih
#include MainLschetForPersons.vih
#include GP_XlOutExt.vih


#define GPInt GP_ExpOpenCardSbb // #(GPInt)
#define GPNam Выгрузка данных для Сбербанка // #(GPNam)

Interface #(GPInt) '#(GPNam) (ЭМ)' EscClose, Gray;
  show (,,86,12);

const
#include Excel.inc;
end;

table struct ttPerFlt // для фильтра по персоналу
(
  cRecPers : comp
)
with index
(
  ttPerFlt01  = cRecPers
);

table struct ttResStr // статический набор данных
(
  nRec      : comp
, cRecPers  : comp
, sFIO      : string
, sF        : string
, sI        : string
, sO        : string
, dBorn     : date
, sBorn     : string
, sGrazhd   : string
//fakt
, sLIdx      : string
, sLRegion   : string
, sLRegionS  : string
, sLRajon    : string
, sLRajonS   : string
, sLGorod    : string
, sLGorodS   : string
, sLNasPunkt : string
, sLNasPunktS: string
, sLUlitsa   : string
, sLUlitsaS  : string
, sLDom      : string
, sLKorpus   : string
, sLKvartira : string
//Propis
, sBIdx      : string
, sBRegion   : string
, sBRegionS  : string
, sBRajon    : string
, sBRajonS   : string
, sBGorod    : string
, sBGorodS   : string
, sBNasPunkt : string
, sBNasPunktS: string
, sBUlitsa   : string
, sBUlitsaS  : string
, sBDom      : string
, sBKorpus   : string
, sBKvartira : string
//pass
, sRezi     : string
, sTypPass  : string
, sSerPass  : string
, sNomPass  : string
, sKtoPass  : string
, dKtoPass  : date
, sTelDom   : string
, sTelRab   : string
, sTelMob   : string
, sEMail    : string
, sPost     : string
, sINN      : string
)
with index
(
  ttResStr00 = nRec(Surrogate)
, ttResStr01 = cRecPers
, ttResStr02 = sFIO
);

var
  VCommonFiltr  : CommonFiltr; // Для встраивания фильтра по подразделениям / сотрудникам
  MadeReport    : boolean;
  mPsn          : TPtr;
  iCatFunc      : CatalogsFunctions;
  iAdrFunc      : AddressFunc;
  iStrFunc      : StringFunctions;
  iAppFunc      : AppointmentsFunctions;
  MLFP          : MainLschetForPersons;
  iOut          : GP_XlOutExt;
  sFullName     : string;
  lRB, lRE,
  lCB, lCE,
  lDB, lDE,
  iNPP          : integer = 0;
  sShKl         : array [1..67] of string;
  isDiffAddr    : boolean;

create view
var
  cLSch : comp;
from
  Persons
, Passports
, Passports PassINN
, Communications
, LSchet
, ttPerFlt
, ttResStr
where
((
    ttPerFlt.cRecPers == Persons.nRec
and Persons.PasspRus  == Passports.nRec
and Persons.nRec      == Communications.Person
and Persons.nRec      == PassINN.Person
and integer(505)      == PassINN.SysCode
and cLSch             == LSchet.nRec
))
;

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

function sRetPhoneList(sAny : string) : string;
{
  result:='';
  if isvalid(#Communications)
  _loop Communications
    if Pos(sAny,LoCase(iCatFunc.GetCatalogsName(Communications.ComType)))<>0
      result+=if(Trim(result)<>'','; ','')+Communications.Addr;
}
function sRetEMailList(sAny : string) : string;
{
  result:='';
  if isvalid(#Communications)
  _loop Communications
    if Pos(sAny,LoCase(iCatFunc.GetCatalogsName(Communications.ComType)))<>0
      result+=if(Trim(result)<>'','; ','')+Communications.EMail;
}

function isDiffAddrCheck : boolean;
{
  result := false;
  if ttResStr.sLIdx       <> ttResStr.sBIdx      
  or ttResStr.sLRegion    <> ttResStr.sBRegion   
  or ttResStr.sLRajon     <> ttResStr.sBRajon    
  or ttResStr.sLGorod     <> ttResStr.sBGorod    
  or ttResStr.sLNasPunkt  <> ttResStr.sBNasPunkt 
  or ttResStr.sLUlitsa    <> ttResStr.sBUlitsa   
  or ttResStr.sLDom       <> ttResStr.sBDom      
  or ttResStr.sLKorpus    <> ttResStr.sBKorpus   
  or ttResStr.sLKvartira  <> ttResStr.sBKvartira 
    result := true;
}

