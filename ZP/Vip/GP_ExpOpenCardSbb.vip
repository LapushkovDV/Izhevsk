procedure RetSTerr(sAny : string; var sLObj : string; var sSObj : string);
Var
  wI   : word;
  wPos : word;
  wLen : word;
{
  if sAny <> ''
    for(wI:=1; wI<=67; wI++)
    {
      wLen := Length(sShKl[wI]);
      //сначала проверяем в конце
      wPos := Pos(' '+sShKl[wI],sAny);
      if wPos <> 0
      {
        sLObj := SubStr(sAny,1,wPos-1);
        sSObj := sShKl[wI];//SubStr(sAny,wPos+1,wLen);
        exit;
      }
      //На всякий случай проверяем в начале
      wPos := Pos(sShKl[wI]+' ',sAny);
      if wPos = 1
      {
        sLObj := SubStr(sAny,wLen+2,Length(sAny)-(wLen+1));
        sSObj := sShKl[wI];//SubStr(sAny,1,wLen);
        exit;
      }
    }
}

procedure Run;
var kol, i    : integer = 0;
    cPersNRec : comp;
    cAddrNeed : comp;
    sAny      : string;
    iRow      : integer = 0;
{
  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);

  InitShortKLAdr;

  if (VCommonFiltr.GetPsnCount = 0)
    VCommonFiltr.SelectAllPsn;

  mPsn := InitMarker('#(GPInt)_PSN_'+UserName(),8,200,100);
  mPsn := VCommonFiltr.GetPersonsMarker;
  kol  := GetMarkerCount(mPsn);
  RestartVisual('Формирование таблицы фильтров.',1);
  while i < kol
  {
    GetMarker(mPsn, i++, cPersNRec);
    insert ttPerFlt set ttPerFlt.cRecPers := cPersNRec;
    If (not NextVisual) break;
  }
  
  RestartVisual('Формирование данных для выгрузки.',1);
  if IsValid(#ttPerFlt)
  _loop ttPerFlt
  {
    if (not NextVisual) break;  
    if IsValid(#Persons)
    {
      ClearBuffer(#ttResStr);
      ttResStr.cRecPers := Persons.nRec;
      ttResStr.sFIO     := Persons.FIO ;
      ttResStr.sF       := UpCase(iStrFunc.Get_LastName (Persons.FIO));
      ttResStr.sI       := UpCase(iStrFunc.Get_FirstName(Persons.FIO));
      ttResStr.sO       := UpCase(iStrFunc.GetPatronymic(Persons.FIO));
      ttResStr.dBorn    := Persons.BornDate;
      ttResStr.sBorn    := iAdrFunc.GetFullAddressInd(Persons.BornAddr);
      sAny := iCatFunc.GetCatalogsCode(Persons.Gr);
      ttResStr.sGrazhd  := if(sAny='1' or sAny='2','РОССИЯ',iCatFunc.GetCatalogsName(Persons.Gr));
      //fact
      cAddrNeed          := Persons.LiveAddr;
      ttResStr.sLIdx     := iAdrFunc.GetAddressInd(cAddrNeed);
      ttResStr.sLDom     := iAdrFunc.GetHouse     (cAddrNeed);
      ttResStr.sLKorpus  := iAdrFunc.GetCorpus    (cAddrNeed);
      ttResStr.sLKvartira:= iAdrFunc.GetFlat      (cAddrNeed);
      RetSTerr(iAdrFunc.GetStreetName(cAddrNeed)   ,ttResStr.sLUlitsa  ,ttResStr.sLUlitsaS  );
      cAddrNeed          := iAdrFunc.GetATDNRec   (cAddrNeed);
      RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed,20),ttResStr.sLRegion  ,ttResStr.sLRegionS  );
      RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed, 3),ttResStr.sLRajon   ,ttResStr.sLRajonS   );
      RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed, 4),ttResStr.sLGorod   ,ttResStr.sLGorodS   );
      RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed, 5),ttResStr.sLNasPunkt,ttResStr.sLNasPunktS);
      //propis
      cAddrNeed          := Persons.PasspAddr;
      ttResStr.sBIdx     := iAdrFunc.GetAddressInd(cAddrNeed);
      ttResStr.sBDom     := iAdrFunc.GetHouse     (cAddrNeed); //message(ttResStr.sDom);
      ttResStr.sBKorpus  := iAdrFunc.GetCorpus    (cAddrNeed);
      ttResStr.sBKvartira:= iAdrFunc.GetFlat      (cAddrNeed);
      RetSTerr(iAdrFunc.GetStreetName(cAddrNeed)   ,ttResStr.sBUlitsa  ,ttResStr.sBUlitsaS  );
      cAddrNeed         := iAdrFunc.GetATDNRec   (cAddrNeed);
      RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed,20),ttResStr.sBRegion  ,ttResStr.sBRegionS  );
      RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed, 3),ttResStr.sBRajon   ,ttResStr.sBRajonS   );
      RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed, 4),ttResStr.sBGorod   ,ttResStr.sBGorodS   );
      RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed, 5),ttResStr.sBNasPunkt,ttResStr.sBNasPunktS);

      ttResStr.sTelDom  := sRetPhoneList('дом');//'НЕ ИМЕЮ'
      ttResStr.sTelRab  := sRetPhoneList('раб');
      ttResStr.sTelMob  := sRetPhoneList('Личный сотовый номер');
      sAny := sRetPhoneList('тел.сот.');
      if sAny <> ''
        ttResStr.sTelMob+= if(Length(ttResStr.sTelMob)<>0,'; ','')+sAny;
      if ttResStr.sTelDom='' ttResStr.sTelDom := 'НЕ ИМЕЮ';
      if ttResStr.sTelRab='' ttResStr.sTelRab := 'НЕ ИМЕЮ';
      if ttResStr.sTelMob='' ttResStr.sTelMob := 'НЕ ИМЕЮ';
      ttResStr.sEMail   := sRetEMailList('e-mail');
      ttResStr.sPost    := iAppFunc.GetAppPost(iAppFunc.GetAppNrec_OnDate(Persons.nRec,Cur_Date));
      if IsValid(#Passports)
      {
        ttResStr.sTypPass := iCatFunc.GetCatalogsName(Passports.DocName);
        ttResStr.sSerPass := Replace(Passports.Ser, ' ', '');
        ttResStr.sNomPass := Passports.Nmb;
        ttResStr.sKtoPass := Passports.GivenBy+' '+Passports.GivenPodr;// Passports.GivenPodr;
        ttResStr.dKtoPass := Passports.GivenDate;
      }
      if IsValid(#PassINN)
        ttResStr.sINN     := PassINN.NMB;
      if MLFP.GetMainLschet(Persons.nRec, cLSch)
      {
        set cLSch := cLSch; //прикол MS-SQL, так надо иначе не работает
        if IsValid(#LSchet)
          ttResStr.sRezi  := if(LSchet.Summa10=0,'РЕЗИДЕНТ','НЕ РЕЗИДЕНТ');
      }
      insert current ttResStr;
    }
  }
  if isvalid(#ttResStr)
  {
    if not xlCreateExcelWithTemplate(sFullName, true)
    {
      message('Невозможно открыть заданный XLS-файл!',Error);
      StopVisual;
      exit;
    }
    
    if not xlSetActiveSheetByName('Общий')
    {
      message('Задан XLS-файл с неправильной структурой!',Error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    lRB  := 4;
    lDB  := lRB + 1;
    lCB  := 1;
    lCE  := 6;
    iNPP := 1;
    RestartVisual('Выгрузка данных.',1);

    _loop ttResStr iRow++; 

    #define FrmCl lDE,lCE++
  
    if (not xlCreateMatrix(iRow,4))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    iNPP:=1;
    lDE :=1;
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;
      lCE := 1;
      xlStWriteToMatrix(#FrmCl,       iNPP++               );
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sF         ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sI         ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sO         ));
      lDE++;
    }
    xlSetNumberFormat('@', 5, 6,iRow+5,10);
    if (not xlWriteMatrixToExcel(5,6))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;

    if (not xlCreateMatrix(iRow,37))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    lDE :=1;
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;
      lCE := 1;
      xlDtWriteToMatrix(#FrmCl,       ttResStr.dBorn       );
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sBorn      ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sGrazhd    ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLIdx      ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLRegion   ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLRegionS  ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLRajon    ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLRajonS   ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLGorod    ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLGorodS   ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLNasPunkt ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLNasPunktS));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLUlitsa   ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLUlitsaS  ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLDom      ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLKorpus   ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sLKvartira ));
      isDiffAddr:=isDiffAddrCheck;
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBIdx       ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBRegion    ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBRegionS   ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBRajon     ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBRajonS    ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBGorod     ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBGorodS    ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBNasPunkt  ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBNasPunktS ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBUlitsa    ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBUlitsaS   ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBDom       ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBKorpus    ),''));
      xlStWriteToMatrix(#FrmCl,if(isDiffAddr,upcase(ttResStr.sBKvartira  ),''));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sRezi      ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sTypPass   ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sSerPass   ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sNomPass   ));
      xlDtWriteToMatrix(#FrmCl,       ttResStr.dKtoPass    );
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sKtoPass   ));
      lDE++;
    }
    xlSetNumberFormat('@',5,14,iRow+5,47);
    xlSetNumberFormat('@',5,49,iRow+5,49);
    if (not xlWriteMatrixToExcel(5,13))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;
  
    if (not xlCreateMatrix(iRow,3))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    lDE :=1;
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;
      lCE := 1;
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sTelDom   ));
//       xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sTelRab   )); //'8-495-2869206'
      xlStWriteToMatrix(#FrmCl,'8-495-2869206'); //'8-495-2869206'
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sTelMob   ));
      lDE++;
    }
    xlSetNumberFormat('@',5,51,iRow+5,53);
    if (not xlWriteMatrixToExcel(5,51))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;

    if (not xlCreateMatrix(iRow,2))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    lDE :=1;
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;
      lCE := 1;
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sEMail    ));
      xlStWriteToMatrix(#FrmCl,upcase(ttResStr.sPost     ));
      lDE++;
    }
    xlSetNumberFormat('@',5,56,iRow+5,57);
    if (not xlWriteMatrixToExcel(5,56))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;

    if (not xlCreateMatrix(iRow,1))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    lDE :=1;
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;
      lCE := 1;
      xlStWriteToMatrix(#FrmCl, 'ZK0SS110000'              );
      lDE++;
    }
    xlSetNumberFormat('@',5,60,iRow+5,60);
    if (not xlWriteMatrixToExcel(5,60)) 
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;

    if (not xlCreateMatrix(iRow,1))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    lDE :=1;
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;
      lCE := 1;
      xlStWriteToMatrix(#FrmCl, upcase(ttResStr.sINN      ));
      lDE++;
    }
    xlSetNumberFormat('@',5,65,iRow+5,65);
    if (not xlWriteMatrixToExcel(5,65))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;

// B 180321
    if (not xlCreateMatrix(iRow,2))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    lDE :=1;
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;
      lCE := 1;
      xlStWriteToMatrix(#FrmCl,'9040');
      xlStWriteToMatrix(#FrmCl,'7771');
      lDE++;
    }
    xlSetNumberFormat('@',5,65,iRow+5,79);
    xlSetNumberFormat('@',5,65,iRow+5,80);
    if (not xlWriteMatrixToExcel(5,79))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;
// E 180321
    xlAutoFit(4,6,lDE+4,65);
    xlKillExcel;
  }
  else
  {
    message('Нет данных для формирования отчета!');
  }
  StopVisual;
}

embedded ComFiltrEmbedded 'Фильтры' interface VCommonFiltr;
  show (,,85,6);
end
Screen s2(,,sci1Esc);
  show (,7,85,11);
  fields
    sFullName ('Файл выгрузки',,sci13Esc): {Font = {BackColor = if(sFullName    = '', ColorNeed, 0)}},Protect, PickButton ;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
  <<

   `Файл выгрузки` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     <. ~С~формировать .>                         <. ~З~акрыть .>
  >>
end;

handleevent
  cmInit:
  {
    delete all from ttPerFlt;
    delete all from ttResStr;
    MadeReport:= false;
    if (not (ReadMyDsk(sFullName,'#(GPInt)_sFullName', false)))
      set sFullName := '';
  }
  cmPick:
  {
    case CurField of
      #sFullName: set sFullName := GetFileName('*.xls;*.xlsx','Выбор файла...');
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sFullName: set sFullName := '';
    end;
  }
  cmOk:
  {
    if trim(sFullName)='' {message('Не задан файл приемник!',Error); exit;}
    Run;
    MadeReport:= true;
    VCommonFiltr.IntClose(MadeReport);
    VCommonFiltr.StoreAllParams;
    Notify(cmEvaluateAndModify, 0);
    DoneMarker(mPsn,      '#(GPInt)_PSN_');
    SaveMyDsk (sFullName, '#(GPInt)_sFullName');
    closeinterface(cmDefault);
  }
  cmCancel:
  {
    VCommonFiltr.IntClose(MadeReport);
    DoneMarker(mPsn,      '#(GPInt)_PSN_'     );
    SaveMyDsk (sFullName, '#(GPInt)_sFullName');
  }
end;
end.



VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;
Procedure Run;                                  {runinterface(#(GPInt));}
Function  GetReportName               : String; {GetReportName := '#(GPNam) (ЭМ)';}
Function  GetGroupName (Level : Word) : String; {Level:=Level;GetGroupName := '';}
function  GetPriority                 : Integer;{GetPriority := 3;}
function  VisibleInModule(Ind : Byte) : String; {Ind:=Ind; VisibleInModule := 'STAFFMAINMENU';} // для Пушковой Перенесено из MENUZARP';}
End.
