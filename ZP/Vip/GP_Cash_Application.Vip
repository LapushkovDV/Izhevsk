     if vBank.getfirst KatBank=tsok
       if vBank.getfirst KatOrg=tsok
         ww_str:=ww_str+' '+if(vBank.KatOrg.ShortName<>'',vBank.KatOrg.ShortName,vBank.KatOrg.Name);
     ww_str:=ReplSymBol(ww_Str);
     ww_str:=SubStr(ww_Str,1,30);
     MyLogWrite(false,'НДФЛ18 Лист '+ww_str+', tmp_prn_cash.NPP='+string(tmp_prn_cash.NPP)) ;
#IFDEF GP_Cash_Application_Diff_File
    //надо добавить лист
    if not boFirst
    { xlSetActiveSheet(1);
      xlAddSheet;
      xlSetActiveSheet(1);
      SetPaperParam;
      SetWidthNDFL();
      if not xlSetActiveSheet(kol_ndfl)
      { message('Ошибка установки листа с форматом!');
      }
      xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
      //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
      xlSetActiveSheet(1);
      // только в таком порядке. В рабочей папке можно создать Excel.log
      xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
      xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
      //чтобы снять выделение после вставки
      xlCopyToBuff(1, 1, 1,1);
      xlPasteAllFromBuff(1, 1, 1,1);
      SetWidthNDFL;
    }
#ELSE
     xlSetActiveSheet(1);
     xlAddSheet;

     xlSetActiveSheet(1);
     SetPaperParam;
     SetWidthNDFL();
     if True //not xlCopyExtFormat(book_ndfl,'NDFL') - Ломает даже копирование буфера
     { //MyLogWrite(false,'НДФЛ Лист '+ww_str+' ошибка обновления!' ) ;
       //MyLogWrite(false,'Ошибка :'+xlGetLastError() );
       //---------------------
       SetWidthNDFL;
       //---------------------
       xlSetActiveWorkBookByName(book_Main);
       wexrow:=1;wexcol:=1;
       MyPutExcel('-',9,0,-1,-1);

       //-------------- пробуем все
       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
       xlSetActiveWorkBookByName(book_Main);
       // только в таком порядке. В рабочей папке можно создать Excel.log
       xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------

       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       xlSetActiveWorkBookByName(book_Main);
       xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------
       //чтобы снять выделение после вставки
       xlCopyToBuff(1, 1, 1,1);
       //xlPasteAllFromBuff(1, 1, 1,1);

     }
#ENDIF
     SetPaperParam;
     boFirst:=false;
     if not xlSetSheetName(1,ww_str )
     { MyLogWrite(false,'НДФЛ18 Лист '+ww_str+' ошибка наименования!' );
       MyLogWrite(false,xlGetLastError() );

     }
     _wPeriod:=wPeriod;
     //#808.#56
     //Если выбран тип заявки за <2 половину> (03.2018) и среди помеченных реестров
     //есть реестра будущего периода (04.2018)
     //то в отдельном листе по НДФЛ будущего периода (сейчас он формируется),
     //необходимо изменить вывод строк <Назначение платежа> и <Срок уплаты налога>,
     //а именно: поскольку это НДФЛ будущего периода, то вместо текста <с зарплаты> выводить <с отпускных и окончательного расчета>.
     if tmp_prn_cash.DataN>DT_Period
        _wPeriod:=2;
     wexrow:=1;wexcol:=1;
     MyPutExcel('',9,0,-1,-1);
     //создаем лист
     //------------------------------

     //--------------------------------
     _sPeriod:=DateToStr(tmp_prn_cash.DataN,'MM.YYYY');//SubStr(tmp_prn_cash.Name,2,7);

     //--------------------------------
     //[03.2018] НДФЛ "Управление финансов Администрац...[КПП:990132001,ОКТМО:55000000]
     //#808.47
     sKPP:=vBank.KatOrg.KodPlatNds;
     sOKTMO:='';
     ii:=pos('[КПП:',tmp_prn_cash.NameVed);
     if ii>0
     { sKPP:=Substr(tmp_prn_cash.NameVed,ii+5,9);
     }
     ii:=pos('ОКТМО:',tmp_prn_cash.NameVed);
     if ii>0
     { sOKTMO:=Substr(tmp_prn_cash.NameVed,ii+6,8);
     }

     //от 06.01.20 18  № 972/ 3
     ww_Str:=DateToStr(DTAppl,'DD.MM.YYYY')+' № РКУ-ЭМ/ '+sNumber;

     wexrow:=7; wexcol:=1;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Прошу оплатить сумму
     wexrow:=9; wexcol:=2;
     MyPutExcel(string(tmp_prn_cash.SumNeed),0,0,-1,-1); //
     MyPutExcel('('+DoubleToStr(tmp_prn_cash.SumNeed,'4')+') рублей' ,0,0,-1,-1); //
     //Назначение платежа
     ww_str:='Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников';
     if sKPP='990132001' //#808.47
     { ww_str:=ww_str+' отдела экспедиции по материально-техническому обеспечению летно-конструкторских испытаний';
     }
     ww_dog:='';
     var _wNazn:string='';
     case tmp_prn_cash.Npp of
     1:
     { if tmp_prn_cash.Prefix='R#Z' or tmp_prn_cash.Prefix='R#A'
       { ww_str:='Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников за '
                   +DateToStr(DT_Period,'month YYYY')+' с  выплаты вознаграждения по договору оказания услуг ';
         //+ № 808/17 от 02.05.2017
         vdog.pLschet:=tmp_prn_cash.cvPlan;
         if vDog.getfirst prvidopl=tsok
         if vDog.getfirst sys_mbf=tsok
         if vDog.getfirst DOGPODR=tsok
         { ww_dog:=' № '+vDog.DOGPODR.DSCDOC
                +' от '+DateToStr(vDog.DOGPODR.LASTDATE,'DD.MM.YYYY');
           _wNazn:=sGetAttrID(coDOGPODR,vDog.DOGPODR.Nrec,pVA_DOGPODR_Content);
         }

         ww_dog:=ww_dog+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
         ww_str:=ww_Str+ww_dog;

       }
       else
       if (tmp_prn_cash.SIDE= coKATKAU or tmp_prn_cash.SIDE=coOTPDOP)
       and tmp_prn_cash.wKau= cgKau_Dogovor
       { ww_str:='Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников за '
                   +DateToStr(DT_Period,'month YYYY')+' с  выплаты вознаграждения по договору оказания услуг ';
         vDogovor.pDogovor :=tmp_prn_cash.cKau;
         if vDogovor.Getfirst Dogovor=tsok
           ww_dog:='№ '+vDogovor.DOGOVOR.NoDoc
                +' от '+DateToStr(vDogovor.DOGOVOR.DDoc,'DD.MM.YYYY');
         if vDogovor.getfirst AttrDog=tsok
           _wNazn:=vDogovor.AttrDog.Subject1;
         ww_dog:=ww_dog+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
         ww_str:=ww_Str+ww_dog;
       }
       else
       //Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников за февраль 2018 с
       //материальной помощи  на погребение   (Фио)
       { ww_str:=ww_str+' за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY г.');
         if tmp_prn_cash.VidOpl>0
         { if getfirst KlVidopl where (( tmp_prn_cash.VidOpl  == KLVIDOPL.VIDOPL ))=tsok
           { //ww_str:=ww_str+' '+My_Sclonenie(KLVIDOPL.NVidopl,12);
             ww_str:=ww_str+' с  "'+KLVIDOPL.NVidopl+'"';
           }
           ww_str:=ww_str+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
         }
       }
     }
     else
     //ww_Str:=''       с зарплаты  за декабрь 2017  (Заказ)
     { case _wPeriod of
       0: ww_str:=ww_str+ ' с аванса за '  +DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');
       1: ww_str:=ww_str+ ' с зарплаты за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');
       2: ww_str:=ww_str+ ' за '           +DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY')
        +' с отпускных  и  окончательного расчета ';
       end;
       if sKPP='990132001' //#808.47
       { ww_str:=ww_str+' Байконур';
       }
       ww_str:=ww_str+ '('+tmp_prn_cash.Zakaz +')';
     }
     end;
     //ww_str:=ww_str+ if(tmp_prn_cash.Npp=1,' - КАССА',' - БАНК');
     wexrow:=13; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     if ww_dog<>''
     { wexrow:=14; wexcol:=2;
       MyPutExcel(ww_dog,0,0,-1,-1); //
     }
     //ИНН/КПП
     /*
     ww_str:='5047008220/504701001';
     if pos('[КПП:',tmp_prn_cash.Name)>0
     { ww_str:='5047008220/'+SubStr(tmp_prn_cash.Name,pos('[КПП:',tmp_prn_cash.Name)+5,9);
     }
     ww_str:='ИНН/КПП '+ww_Str;
     wexrow:=22; wexcol:=4;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     */
     //Налоговый период
     ww_str:='МС.'+_sPeriod;
     wexrow:=26; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Срок уплаты  налога
     ww_str:='';
     if ww_dog<>'' //tmp_prn_cash.Prefix='R#Z' or tmp_prn_cash.Prefix='R#A'
       ww_str:='в день перечисления вознаграждения по договору '+ww_dog
     else
       case _wPeriod of
       0: ww_str:='в день перечисления аванса за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');//;+'(БАНК)';
       1: ww_str:='в день перечисления зарплаты за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');//+'(БАНК)';
       2: ww_str:=' в день перечисления отпускных и оконч. расчета за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');//+' (БАНК)';
       end;
     wexrow:=35; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //--------------------------
     Print_NDFL_Pol;
     //подписи
     Print_NDFL_Podp;
   } //_Loop tmp_prn_cash where (( 118 == tmp_prn_cash.pa ))
   Result:=True;
} //Function Print_Ndfl18Perc(_Zakaz:string;_Su:double; _wtp:word);

//-------------------------------------------------
// Налоги на фот wOpt_FSS=0
//-------------------------------------------------
Function SborDataFOT(_wTp:word):boolean;
var pUserId:comp;
    pUserName:string;
    wErr:word;
{ Result:=false;
  pUserId  :=UserID();
  pUserName:=UserName();
  timelog('GP_Cash_Application->SborDatafot:START');

  delete all tmp_prn_cash;
  wVidPerFSS:=0;
  if getfirst Perech where (( 2== Perech.NomGraf(noindex) )) =tsok
  { wVidperFSS:=Perech.VidPer
  }
  wVidPerTravm:=0;//NomGraf=0
  if getfirst Perech where (( 'Т' == PERECH.PARAM(noindex) )) =tsok
  { wVidperTravm:=Perech.VidPer
  }
  //-------------------------------------------
  wMonth:=month(DT_PERIOD);
  wYear :=year (DT_PERIOD);
  //-------------------------------------------
  // Реестры
  //-------------------------------------------

  _try
  {
    timelog('GP_Cash_Application->SborDatafot:Вариант 1');
    var hStrFilter,hStrFilterR:longint;
    var Q: IQuery;
    hStrFilter :=0;
    hStrFilterR:=0;
    if wOpt_FSS=0
    {
      Q:=queryManager.createQuery(SQLQuery(
      Select
       PERECH.NAMEPER    as  Name //  нужен только период!!! [01.2018]
      ,Sum(SPPLBAN.SUMOPL)  SumNeed //:double "Требуемая выплата"
      ,102 Pa    //  :word   "0 ведомости, 1 реестры"
      //1 касса, 2 - банк
      ,Perech.VidPer as NPP     //:word
      ,0 VidUd //:word
      ,0 VidOpl //:word
      ,Max(sbban.prefix) Prefix  //:word
      ,SubString(COALESCE(vPlan.Name,'Основная'),1,100) as Zakaz
      ,#comp(0) as cvPlan // :comp "Группа заказов"
      ,SbBan.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
      ,SbBan.DataN as DATAN
      ,'' as NameVed
       ,#comp(0) as Nrec
       //--- аналитика
       ,0        as SIDE //Код среза аналитик
       ,0        as wKau //Код аналитики
       ,#Comp(0) as cKau //Аналитика
       , coalesce(nplat.kodplat,'') as  kodplat
      From SbBan
      inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
      left  join nplat    on nplat.nrec = sbban.cplat //coalesce(nplat.kodplat,'') as  kodplat
      inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
      inner join PERECH  on PERECH.VidPer= SbBan.VidPer
      inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
      Left Outer join AttrVal on AttrVal.cAttrNam=:(ATTR_SB_VPLAN)
                      and AttrVal.wTable = 16060
                      and AttrVal.cRec   = SbBan.Nrec
      Left Outer join vPlan on vPlan.Nrec= AttrVal.vComp
       where
      //    SbBan.DATOK>=:(DTB) //дата выплаты
      //and SbBan.DATOK<=:(DTE) //дата выплаты
          SbBan.DForm>=:(DTB) //дата выплаты
      and SbBan.DForm<=:(DTE) //дата выплаты
      // Не фот
      and SBBAN.Prefix='S$'
      //объединенный
      and SBBAN.Prefix<>'R$$'
       %Filter
       %FilterR
      and (ZU.POdrShare <> '+'
        or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
        )
      Group by
        PERECH.NAMEPER
       ,SbBan.cBankPol
       ,SbBan.DATAN
       ,PERECH.VIDPER
       ,SubString(COALESCE(vPlan.Name,'Основная'),1,100)
       , nplat.kodplat
      )); //queryManager.createQuery(SQLQuery(
    } //if wOpt_FSS=0
    else
    {
      timelog('GP_Cash_Application->SborDatafot:Вариант 2');

#undef _GP_CAsh_Application_SPis2
#DECLARE  _GP_CAsh_Application_SPis2
      CASE WHEN PERECH.VIDPER=12 and Perevod.StrTabn='000568' then 1 else 0 end
#END
      Q:=queryManager.createQuery(SQLQuery(
      Select
       PERECH.NAMEPER    as  Name //  нужен только период!!! [01.2018]
      ,Sum(Perevod.SUMPER) as  SumNeed //:double "Требуемая выплата"
      ,102 as Pa    //  :word   "0 ведомости, 1 реестры"
      ,Perech.VidPer as NPP     //:word
      ,0 as VidUd //:word
      //список 2
      ,#_GP_CAsh_Application_SPis2 as VidOpl //:word
      ,'SS' as Prefix  //:word
      ,SubString(COALESCE(vPlan.Name,'Основная'),1,100) as Zakaz
      ,#comp(0) as cvPlan // :comp "Группа заказов"
      ,PERECH.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
      ,#Date(0,0,0) as DATAN
      ,'' as NameVed
       ,#comp(0) as Nrec
       //--- аналитика
       ,0        as SIDE //Код среза аналитик
       ,0        as wKau //Код аналитики
       ,#Comp(0) as cKau //Аналитика
       , '' as  kodplat
      From %PerevodDB Perevod
      inner join PERECH  on PERECH.VidPer= Perevod.VidPer
      inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
      %Filter_R

      Left Outer join MnPlan on MnPlan.Nrec=
         CASE WHEN Perevod.TBLD[1] = 7 THEN Perevod.CKAUD[1]  //cgKau_Zakaz
            //  WHEN Perevod.TBLD[2] = 7 THEN Perevod.CKAUD[2]
            //  WHEN Perevod.TBLD[3] = 7 THEN Perevod.CKAUD[3]
            //  WHEN Perevod.TBLD[4] = 7 THEN Perevod.CKAUD[4]
            //  WHEN Perevod.TBLD[5] = 7 THEN Perevod.CKAUD[5]
            //  WHEN Perevod.TBLD[6] = 7 THEN Perevod.CKAUD[6]
         else #Comp(0) end
       Left outer join vPlan on vPlan.Nrec = Perevod.KAUEXTR[1]//MnPlan.cVplan
       where Perevod.YearN = :(wYear) and Perevod.Mesn=:(wMonth)

       %Filter
      Group by
        PERECH.NAMEPER
       ,PERECH.cBankPol
       ,PERECH.VIDPER
       ,#_GP_CAsh_Application_SPis2
       ,SubString(COALESCE(vPlan.Name,'Основная'),1,100)
      )); //queryManager.createQuery(SQLQuery(
      /*
      if wMonth=MonthRas and wYear=YearRas
      { Q.setMacro('PerevodDB' ,'PerevodTek' );
      }
      else
      { Q.setMacro('PerevodDB' ,'Perevod' );
      }
      */
      Q.setMacro('PerevodDB','PEREVODTEKZAKAZ');
    } //if wOpt_FSS=0

    if Zar_User.POdrShare = '+'
    { Q.setMacro('Filter_R' , 'inner join USERRIGHTS UR on UR.crecds=Perevod.cexoz and UR.OWNNAME= ZU.OWNNAME  ' );
    }

    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',Marker_KatPodr));
      if wOpt_FSS=0
      {  sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',DepList));
      }
      else
      {  sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and Perevod.cexoz ',DepList));
      }
      timelog('GP_Cash_Application->SborDatafot:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    {
      Q.setMacro('Filter' ,hStrFilter );
      sqlFreeStr(hStrFilter);
    }
    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса ФОТ при отборе значений ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
      timelog('SborDataFOT этап 2 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));

    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса ФОТ '+ExploreException);
  }
  _finally
  {
  }
  //-------------------------------------------
  //#808.#85
  //- сумма Итого, из отчета ЗП- Отчеты - Отчеты пользователя- Отчеты на DSQL запросах - отчет <Расходы на ФСС>:
  // суммы больничных по ФСС отнимем ниже, здесь сразу уберем перечисления по 174 во
  if wOpt_FSS<>0
  {

    _try
    {
      timelog('GP_Cash_Application->SborDatafot:Вариант 1');
      var hStrFilter,hStrFilterR:longint;
      var Q: IQuery;
      hStrFilter :=0;
      hStrFilterR:=0;
      if wOpt_FSS=1
      {

        Q:=queryManager.createQuery(SQLQuery(
        Select
         PERECH.NAMEPER    as  Name //  нужен только период!!! [01.2018]
        ,Sum(-Perevod.SUMPER) as  SumNeed //:double "Требуемая выплата"
        ,102 as Pa    //  :word   "0 ведомости, 1 реестры"
        ,Perech.VidPer as NPP     //:word
        ,0 as VidUd //:word
        ,0 as VidOpl //:word
        ,'SS' as Prefix  //:word
        ,'Основная' as Zakaz
        ,#comp(0) as cvPlan // :comp "Группа заказов"
        ,PERECH.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
        ,#Date(0,0,0) as DATAN
        ,'' as NameVed
         ,#comp(0) as Nrec
         //--- аналитика
         ,0        as SIDE //Код среза аналитик
         ,0        as wKau //Код аналитики
         ,#Comp(0) as cKau //Аналитика
        From %PerevodDB Perevod
        inner join PERECH  on PERECH.VidPer = :(wVidPerFss)
        inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
        %Filter_R

         where Perevod.YearN = :(wYear) and Perevod.Mesn=:(wMonth)
         //#808.#85
         and perevod.vidopl=174
         and perevod.cschetd='69'
         and perevod.csubschd='01'

         %Filter
        Group by
          PERECH.NAMEPER
         ,PERECH.cBankPol
         ,PERECH.VIDPER
        )); //queryManager.createQuery(SQLQuery(
        Q.setMacro('PerevodDB','PEREVODTEKZAKAZ');
        if (hStrFilter<>0)
        { Q.setMacro('Filter' ,hStrFilter );
          sqlFreeStr(hStrFilter);
        }
        if (Q.Execute.ErrorCode<>0)
           message('Ошибка выполнения DSQL запроса ФОТ при отборе значений ('+string(Q.ErrorCode)+').',error)
        else
        { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
          timelog('SborDataFOT этап 2 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));

        }

      }//if wOpt_FSS=1
    }
    _except
    else
    { timelog('Возникло исключение при запуске запроса ФОТ2 '+ExploreException);
    }
    _finally
    {
    }

    //-------------------------------------------
    var ii:word;
    var _wvidper:word=0;
    for(ii:=1;ii<=2;ii++)
    { case ii of
        1:_wvidper:=wVidPerFSS;
        2:_wvidper:=wVidPerTravm;
      end;
      _try
      {
        var hStrFilter,hStrFilterR:longint;
        var Q: IQuery;
        hStrFilter :=0;
        hStrFilterR :=0;
        if wOpt_FSS_RZ=0
        { if  wMonth=MonthRas and wYear =YearRas
          { Q:=queryManager.createQuery(SQLQuery(
            Select
             PERECH.NAMEPER    as  Name //  нужен только период!!! [01.2018]
            ,Sum(-Nachisl.SUMMA)  SumNeed //:double "Требуемая выплата"
            ,102 as Pa    //  :word   "0 ведомости, 1 реестры"
            //1 касса, 2 - банк
            ,Perech.VidPer as NPP     //:word
            ,0 as VidUd //:word
            ,0 as VidOpl //:word
            ,'SS' as Prefix  //:word
            ,'Основная' as Zakaz
            ,#comp(0) as cvPlan // :comp "Группа заказов"
            ,PERECH.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
            ,#Date(0,0,0) as DATAN
            ,'' as NameVed
             ,#comp(0) as Nrec
             //--- аналитика
             ,0        as SIDE //Код среза аналитик
             ,0        as wKau //Код аналитики
             ,#Comp(0) as cKau //Аналитика
             ,'' as kodplat
            From Perech
            inner join Nachisl on Nachisl.CSCHETD =PERECH.CSCHETK
                              and Nachisl.CSUBSCHD=PERECH.CSUBSCHK
             and Nachisl.MesV =:(wMonth) //дата выплаты
             and Nachisl.YearV=:(wYear) //дата выплаты
             %Filter_Nach
            inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
            %Filter_R
             where (Perech.VidPer = :(_wVidPer)
             )
            //and (ZU.POdrShare <> '+'
            //  or (Nachisl.cexoz in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
            //  )
            Group by
              PERECH.NAMEPER
             ,PERECH.cBankPol
             ,PERECH.VIDPER
            )); //queryManager.createQuery(SQLQuery(
            if IsBitCTW(wFilter,1)
            { sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and Nachisl.Cexoz ',DepList));
              timelog('GP_Cash_Application->SborDatafot:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

            }
            if Zar_User.POdrShare = '+'
            { Q.setMacro('Filter_R' , 'inner join USERRIGHTS UR on UR.crecds=Nachisl.cexoz and UR.OWNNAME= ZU.OWNNAME  ' );
            }

          } //if  wMonth=MonthRas and wYear =YearRas
          else
          { Q:=queryManager.createQuery(SQLQuery(
            Select
             PERECH.NAMEPER    as  Name //  нужен только период!!! [01.2018]
            ,Sum(-SumVidop.SUMMA)  SumNeed //:double "Требуемая выплата"
            ,102 Pa    //  :word   "0 ведомости, 1 реестры"
            //1 касса, 2 - банк
            ,Perech.VidPer as NPP     //:word
            ,0 as VidUd //:word
            ,0 as VidOpl //:word
            ,'SS' as Prefix  //:word
            ,'Основная' as Zakaz
            ,#comp(0) as cvPlan // :comp "Группа заказов"
            ,PERECH.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
            ,#Date(0,0,0) as DATAN
            ,'' as NameVed
             ,#comp(0) as Nrec
             //--- аналитика
             ,0        as SIDE //Код среза аналитик
             ,0        as wKau //Код аналитики
             ,#Comp(0) as cKau //Аналитика
             ,'' as  kodplat
            From Perech
            inner join SumVidop on   SumVidop.CSCHETD=PERECH.CSCHETK
                     and          SumVidop.CSUBSCHD=PERECH.CSUBSCHK
               and SumVidop.YearN=:(wYear) //дата выплаты
               and SumVidop.MesN =:(wMonth) //дата выплаты
             %Filter_Nach
            inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
            %Filter_R
             where (Perech.VidPer = :(_wVidPer)
             )
            //and (ZU.POdrShare <> '+'
            //  or (SumVidop.cexoz in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
            //  )
            Group by
              PERECH.NAMEPER
             ,PERECH.cBankPol
             ,PERECH.VIDPER
            )); //queryManager.createQuery(SQLQuery(
            if IsBitCTW(wFilter,1)
            { sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and SumVidop.Cexoz ',DepList));
              timelog('GP_Cash_Application->SborDatafot:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));
            }
            if Zar_User.POdrShare = '+'
            { Q.setMacro('Filter_R' , 'inner join USERRIGHTS UR on UR.crecds=SumVidop.cexoz and UR.OWNNAME= ZU.OWNNAME  ' );
            }
          } //else if  wMonth=MonthRas and wYear =YearRas
        } //if wOpt_FSS_RZ=0
        else //NACHISLZAKAZ
        {
          Q:=queryManager.createQuery(SQLQuery(
          Select
           PERECH.NAMEPER    as  Name //  нужен только период!!! [01.2018]
          ,Sum(-SumVidop.SUMMA)  SumNeed //:double "Требуемая выплата"
          ,102 Pa    //  :word   "0 ведомости, 1 реестры"
          //1 касса, 2 - банк
          ,Perech.VidPer as NPP     //:word
          ,0 as VidUd //:word
          ,0 as VidOpl //:word
          ,'SS' as Prefix  //:word
          ,'Основная' as Zakaz
          ,#comp(0) as cvPlan // :comp "Группа заказов"
          ,PERECH.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
          ,#Date(0,0,0) as DATAN
          ,'' as NameVed
           ,#comp(0) as Nrec
           //--- аналитика
           ,0        as SIDE //Код среза аналитик
           ,0        as wKau //Код аналитики
           ,#Comp(0) as cKau //Аналитика
           ,'' as  kodplat
          From Perech
          inner join NACHISLZAKAZ SumVidop on   SumVidop.CSCHETD=PERECH.CSCHETK
                   and          SumVidop.CSUBSCHD=PERECH.CSUBSCHK
             and SumVidop.YearN=:(wYear) //дата выплаты
             and SumVidop.MesN =:(wMonth) //дата выплаты
           %Filter_Nach
          inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
          %Filter_R
           where (Perech.VidPer = :(_wVidPer)
           )
          //and (ZU.POdrShare <> '+'
          //  or (SumVidop.cexoz in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
          //  )
          Group by
            PERECH.NAMEPER
           ,PERECH.cBankPol
           ,PERECH.VIDPER
          )); //queryManager.createQuery(SQLQuery(
          if IsBitCTW(wFilter,1)
          { sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and SumVidop.Cexoz ',DepList));
            timelog('GP_Cash_Application->SborDatafot:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));
          }
          if Zar_User.POdrShare = '+'
          { Q.setMacro('Filter_R' , 'inner join USERRIGHTS UR on UR.crecds=SumVidop.cexoz and UR.OWNNAME= ZU.OWNNAME  ' );
          }
        } //else if wOpt_FSS_RZ=0

        if (hStrFilter<>0)
        {
          Q.setMacro('Filter_Nach' ,hStrFilter );
          sqlFreeStr(hStrFilter);
        }
        if (Q.Execute.ErrorCode<>0)
           message('Ошибка выполнения DSQL запроса ФОТ(Больн. и т.п.) при отборе значений ('+string(Q.ErrorCode)+').',error)
        else
        { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
          timelog('SborDataFOT этап 3 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));

        }
      }
      _except
      else
      { timelog('Возникло исключение при запуске запроса ФОТ(Больн. и т.п.)  '+ExploreException);
      }
      _finally
      {
      }
    } //for(ii:=1;ii<=2;ii++)
  } //if wOpt_FSS<>0
  Result:=true;
  delete all tmp_prn_zakaz;
  _Loop tmp_prn_cash
  { if getfirst tmp_prn_zakaz where (( tmp_prn_cash.Zakaz == tmp_prn_zakaz.Zakaz )) =tsok continue;
    Insert into tmp_prn_zakaz
     set tmp_prn_zakaz.Zakaz:=tmp_prn_cash.Zakaz
      , tmp_prn_zakaz.pa:=if(tmp_prn_cash.Zakaz='Основная',0,1)
     ;
  } //_Loop tmp_prn_cash

} //Function SborDataFOT(_wTp:word):boolean;

//--------------------------------------
// установить ширину столбцов
//--------------------------------------
Procedure SetWidthFOT();
{ xlSetColumnWidth(36,1,01,1,01);//01
  xlSetColumnWidth(20,1,02,1,02);//02
  xlSetColumnWidth(22,1,03,1,03);//03
  xlSetColumnWidth(22,1,04,1,04);//04
  xlSetColumnWidth(16,1,05,1,05);//05
  xlSetColumnWidth(13,1,06,1,06);//06
  xlSetColumnWidth(23,1,07,1,07);//07
  xlSetColumnWidth(0,1,08,1,08);//08
  xlSetColumnWidth(0,1,09,1,09);//09
  xlSetColumnWidth(0,1,10,1,10);//10
  SetPaperParam;

} //Procedure SetWidthNDFL();

//------------------------------------------
// печать заявки налоги на фот
//------------------------------------------
Function Print_FOT(_Zakaz:string;boFirst:boolean):boolean;
var ww_dt:date;
    ww_str:string;
    kol_ndfl:longint;
    _sPeriod:string;
    ndfl_row:longint;
    ndfl_col:longint;
{  Result:=false;
   GetPeriod;
   ww_dt:=date(1,wMonth,wYear);
   kol_ndfl:=0;
   matrixkl:=false;
   ndfl_row:=270;
   ndfl_col:=10;
#IFDEF GP_Cash_Application_Diff_File
   if not boFirst
   {    xlSetActiveSheet(1);
        xlAddSheet;
        xlSetActiveSheet(1);
        SetPaperParam;
        SetWidthFOT        ;
        xlSetSheetName(1,_Zakaz);
        if not xlSetActiveSheet(kol_List)
        { message('Ошибка установки листа с форматом!');
        }
        xlCopyToBuff(1, 1, 300,10);
        //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
        xlSetActiveSheet(1);
        // только в таком порядке. В рабочей папке можно создать Excel.log
        xlPasteAllFromBuff(1, 1, 300,10);
        xlPasteFormatFromBuff(1, 1, 300,10);
        //чтобы снять выделение после вставки
        xlCopyToBuff(1, 1, 1,1);
        xlPasteAllFromBuff(1, 1, 1,1);
   }
   else
   { xlSetColumnWidth(0,1,08,1,08);//08
     xlSetColumnWidth(0,1,09,1,09);//09
     xlSetColumnWidth(0,1,10,1,10);//10
   }
#ELSE
   xlSetActiveSheet(1);
   xlAddSheet;
   xlSetActiveSheet(1);
   SetPaperParam;
   MyLogWrite(false,'ФОТ Лист '+ww_str+', tmp_prn_cash.NPP='+string(tmp_prn_cash.NPP)) ;
   if True //not xlCopyExtFormat(book_ndfl,'NDFL') - Ломает даже копирование буфера
   { //MyLogWrite(false,'НДФЛ Лист '+ww_str+' ошибка обновления!' ) ;
     //MyLogWrite(false,'Ошибка :'+xlGetLastError() );
     //---------------------
     xlSetActiveWorkBookByName(book_Main);
     SetWidthFOT();
     xlSetActiveWorkBookByName(book_Main);
     wexrow:=1;wexcol:=1;
     MyPutExcel('-',9,0,-1,-1);

     //-------------- пробуем все
     xlSetActiveWorkBookByName(book_ndfl);
     xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
     //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
     xlSetActiveWorkBookByName(book_Main);
     // только в таком порядке. В рабочей папке можно создать Excel.log
     xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
     //------------------------

     xlSetActiveWorkBookByName(book_ndfl);
     xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
     xlSetActiveWorkBookByName(book_Main);
     xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
     //------------------------
     //чтобы снять выделение после вставки
     xlCopyToBuff(1, 1, 1,1);
     xlPasteAllFromBuff(1, 1, 1,1);
   }
#ENDIF
   xlSetSheetName(1,_Zakaz+', '+string(Kol_List));
   var _wnpp:word=0;
   var _dmsu:array [1..30] of double;
   var _itSu:double=0;
   var _StartRow:longint;
   for(_wNpp:=1;_wNpp<=30;_wNpp++) _dmsu[_wNpp]:=0;

   _Loop tmp_prn_cash where (( _Zakaz == tmp_prn_cash.Zakaz
    and 102 == tmp_prn_cash.pa ))
   { if tmp_prn_cash.NPP=0 then continue;
     _wnpp:=tmp_prn_cash.NPP;
     if tmp_prn_cash.vidopl>0 and tmp_prn_cash.NPP=12
       _wnpp:=14; //список 2
     _dmsu[_wnpp]+=tmp_prn_cash.SumNeed;
     //--------------------------------
   }
   _sPeriod:=DateToStr(DT_Period,'MM.YYYY');//SubStr(tmp_prn_cash.Name,2,7);
   var _sSrok:string='до 15.'+DateToStr(DTAppl,'MM.YYYY г.');
   //--------------------------------
   wexrow:=1;wexcol:=1;
   MyPutExcel('',0,0,-1,-1); //
   ww_Str:=DateToStr(DTAppl,'от DD.MM.YYYY')+' № РКУ-ЭМ/ '+sNumber;
   var _Nazn:string='';
   var _NaznDT:string;
   _NaznDT:=DateToStr(DT_Period,'за month YYYYг. ')+'('+_Zakaz+')';
   wexrow:=4;wexcol:=1;
   MyPutExcel(ww_Str,0,0,-1,-1); //

   for(_wNpp:=1;_wNpp<=22;_wNpp++)
   { //if getfirst Perech where (( _Npp == Perech.VidPer ))<>tsok then continue;

     case _wNpp of  //Прошу оплатить
     //В раздел 1. заявки включать информацию по налогу на ФОТ с кодом
     5:
     { _StartRow:=6;
       _Nazn:='Взносы на обязательное пенсионное страхование по основному тарифу ';
     }
     //В раздел 2. заявки включать информацию по налогу на ФОТ с кодом
     //---
     3:
     { _StartRow:=39; //33
       _Nazn:=' Взносы на обязательное медицинское страхование ';
     }
     //В раздел 3. заявки включать информацию по налогу на ФОТ с кодом
     //---
     20:  //пока не будет никакого
     { _StartRow:=72;//33
       _Nazn:='Страховые  взносы  по дополнительному тарифу на лиц ,занятых на работах ,указанных в п.1 ч.1.ст.30 ФЗ от 28.12.13.№400-ФЗ '
        //+'(Список №1 тариф не зависит от спецоценки) '

     }
     //В раздел 4. заявки включать информацию по налогу на ФОТ с кодом
     14:
     { _StartRow:=105;
       _Nazn:='Страховые взносы  по дополнительному тарифу на лиц ,занятых на работах ,указанных в п.п. 2-18 ч.1. ст.30 ФЗ от 28.12.13.№ 400-ФЗ '
       //+' (Список № 2 тариф не зависит от спецоценки)'
       ;
     }
     //В раздел 5. заявки включать информацию по налогу на ФОТ с кодом
     11:
     { _StartRow:=138;
       _Nazn:='Страховые взносы  по дополнительному тарифу на лиц ,занятых на работах ,указанных в п.1 ч.1.ст.30 ФЗ от 28.12.13.№ 400-ФЗ '
        //+' (Список №1 тариф  зависит от спецоценки) '
        ;
     }
     //В раздел 6. заявки включать информацию по налогу на ФОТ с кодом
     12:
     { _StartRow:=171;
       _Nazn:='Страховые  взносы  по дополнительному тарифу на лиц ,занятых на работах ,указанных в п.п. 2-18 ч.1. ст.30 ФЗ от 28.12.13.№ 400-ФЗ  '
         //+'(Список № 2 тариф  зависит от спецоценки) '
        ;
     }
     //В раздел 7. заявки включать информацию по налогу на ФОТ с кодом
     2:
     { _StartRow:= 204;
       _Nazn:='Взносы  на обязательное социальное страхование на случай  временной нетрудоспособности и в связи с материнством';
     }
     //В раздел 8. заявки включать информацию по налогу на ФОТ с кодом
     8:
     { _StartRow:=237;
       //wVidPerTravm
       if _Zakaz='Основная'
         _dmsu[_wNpp]:=_dmsu[_wNpp]-fPutevka;
       _Nazn:='Взносы  на обязательное социальное страхование от несчастных случаев '
         +'на производстве и профессиональных заболеваний' ;
     }
     else continue;
     end;
     _dmsu[_wNpp]:=Round(_dmsu[_wNpp],2);
     _itSu:=_itSu+_dmsu[_wNpp];
     //Прошу оплатить сумму
     wexrow:=_StartRow+1; wexcol:=2;
     if _dmsu[_wNpp]=0
       ww_str:='Нет данных'
     else
       ww_str:=DoubleToStr(_dmsu[_wNpp],'666 666 666 666 руб. 88 коп.')
                    +'('+DoubleToString(0,_dmsu[_wNpp])+')';
     MyPutExcel(GroupWrap(ww_str,1,70),0,0,-1,-1); //
     wexrow:=_StartRow+2; wexcol:=2;
     MyPutExcel(GroupWrap(ww_str,2,70)+' '+GroupWrap(ww_str,3,70),0,0,-1,-1); //
     //Назначение платежа
     wexrow:=_StartRow+3; wexcol:=2;
     MyPutExcel(_Nazn,0,0,-1,-1); //
     wexrow:=_StartRow+4; wexcol:=6;
     MyPutExcel(_NaznDT,0,0,-1,-1); //
     //Налоговый период
     ww_str:='МС.'+_sPeriod;
     wexrow:=_StartRow+22; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Срок уплаты  налога
     wexrow:=_StartRow+31; wexcol:=2;
     MyPutExcel(_sSrok,0,0,-1,-1); //

   } //for(_wNpp:=1;_wNpp<=20;_wNpp++)
   wexrow:=271;
   wexcol:=1;
   ww_str:='Итого сумма отчислений по страховым взносам '+_NaznDt+' составит:';
   MyPutExcel(ww_Str,0,0,-1,-1); //
   ww_str:=DoubleToStr(_itSu,'666 666 666 666 руб. 88 коп.');
   wexrow:=272;
   wexcol:=5;
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //--------------------------
   //подписи
   ww_str:=sDolgUser+' '+sPodrUser;
   wexrow:=275;
   wexcol:=1;
   MyPutExcel(ww_Str,0,0,-1,-1); //
   ww_str:=MyGetInitial(sFioUser,true);
   wexcol:=5;
   MyPutExcel(ww_Str,0,0,-1,-1); //

   Result:=True;
} //Function Print_FOT(_Zakaz:string;_Su:double; _wtp:word);

//-------------------------------------------------
// Профсоюзные взносы 1% 214 , 197 системный
//-------------------------------------------------
Function SborDataProf(_wTp:word):boolean;
var pUserId:comp;
    pUserName:string;
    wErr:word;
{ Result:=false;
  pUserId  :=UserID();
  pUserName:=UserName();

  //-------------------------------------------
  // Реестры
  //-------------------------------------------
  _try
  {
    var hStrFilter :longint;
    var hStrFilterR:longint;
    var Q: IQuery;
    hStrFilter :=0;
    hStrFilterR:=0;
     var _wMes :word;
     var _wYear:word;
     _wMes:=month(DT_Period);
     _wYear:=year(DT_Period);

/* Нет Реестра!!!!!
    Q:=queryManager.createQuery(SQLQuery(
    Select
     ''    as  Name //SbBan.name
    ,Sum(SPPLBAN.SUMOPL)  SumNeed //:double "Требуемая выплата"
    ,103 Pa    //  :word   "0 ведомости, 1 реестры"
    //1 касса, 2 - банк
    ,0 as NPP     //:word
    ,0 as VidUd //:word
    ,0 VidOpl //:word
    ,Max(sbban.prefix) Prefix  //:word
    ,'' as Zakaz
    ,#comp(0) as cvPlan // :comp "Группа заказов"
    ,SbBan.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
    ,SbBan.DataN as DATAN
    ,'' as NameVed
       ,#comp(0) as Nrec
       //--- аналитика
       ,0        as SIDE //Код среза аналитик
       ,0        as wKau //Код аналитики
       ,#Comp(0) as cKau //Аналитика
    From SbBan
    inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    where
    //    SbBan.DATOK>=:(DTB) //дата выплаты
    //and SbBan.DATOK<=:(DTE) //дата выплаты
        SbBan.DForm>=:(DTB) //дата выплаты
    and SbBan.DForm<=:(DTE) //дата выплаты
    and (SBBAN.VidUd=197) // профсоюзный
    //17.01.2017
    //3. В выборке данных не должны участвовать реестра с типом "ДОГП" - по договорам подряда.
    and SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A'
    // Не фот
    and SBBAN.Prefix<>'S$'
    //объединенный
    and SBBAN.Prefix<>'R$$'
     %Filter
     %FilterR
    and (ZU.POdrShare <> '+'
      or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    Group by
      SbBan.cBankPol
     ,SbBan.DATAN
     //,sbban.prefix
    )); //queryManager.createQuery(SQLQuery(
*/
    Q:=queryManager.createQuery(SQLQuery(
    Select
       ''    as  Name //SbBan.name
      ,Sum(UDER.SUMUD)  SumNeed //:double "Требуемая выплата"
      ,103 Pa    //  :word   "0 ведомости, 1 реестры"
      //1 касса, 2 - банк
      ,0 as NPP     //:word
      ,0 as VidUd //:word
      ,0 VidOpl //:word
      ,'' Prefix  //:word
      ,'' as Zakaz
      ,#comp(0) as cvPlan // :comp "Группа заказов"
      ,0 as cRec   // "ссылка на документ"    - будем подбивать по банкам
      ,#date(0,0,0) as DATAN
      ,'' as NameVed
       ,#comp(0) as Nrec
       //--- аналитика
       ,0        as SIDE //Код среза аналитик
       ,0        as wKau //Код аналитики
       ,#Comp(0) as cKau //Аналитика
       , '' as  kodplat
    From %Prof_Table UDER
    inner join Lschet  on Lschet.Nrec  = UDER.cLsch
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    where
        Uder.YearN=:(_wYear) and Uder.MesN=:(_wMes)
    and (%Prof_VidUd=197) // профсоюзный
     %Filter
    and (ZU.POdrShare <> '+'
      or (Uder.cexoz in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    )); //queryManager.createQuery(SQLQuery(
    if date(1,_wMes,_wYear)<date(1,MonthRas,YearRas)
    { Q.setMacro('Prof_Table' ,'SUMVIDUD' );
      Q.setMacro('Prof_VidUd' ,'UDER.VIDUD' );
    }
    else
    { Q.setMacro('Prof_Table' ,'UDER' );
      Q.setMacro('Prof_VidUd' ,'UDER.VIDUDS' );
    }
    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',Marker_KatPodr));
      sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and Uder.Cexoz ',DepList));
      timelog('GP_Cash_Application->SborDataProf:фильтр по реестрам hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    { Q.setMacro('Filter' ,hStrFilter );
      sqlFreeStr(hStrFilter);
    }
    if (hStrFilterR<>0)
    { Q.setMacro('FilterR' ,hStrFilterR );
      sqlFreeStr(hStrFilterR);
    }
    if (Q.Execute.ErrorCode<>0)
    {  message('Ошибка выполнения DSQL запроса ПРОФС. при отборе значений ('+string(Q.ErrorCode)+').',error)
    }
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
      timelog('SborDataProf этап 2 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));
    }

  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса ПРОФС. '+ExploreException);
  }
  _finally
  {
  }
  Result:=true;
} //Function SborDataProf(_wTp:word):boolean;


//------------------------------------------
// печать заявки профсоюзный взнос
//------------------------------------------
Function Print_prof:boolean;
var ww_dt:date;
    ww_str:string;
    kol_ndfl:longint;
    _sPeriod:string;
    prof_row:longint;
    prof_col:longint;
{  Result:=false;
   GetPeriod;
   ww_dt:=date(1,wMonth,wYear);
   kol_ndfl:=0;
   matrixkl:=false;
   prof_row:=29;
   prof_col:=10;

   _Loop tmp_prn_cash where (( 103 == tmp_prn_cash.pa ))
   {
     kol_ndfl++;
     // а вдруг будет не уникально - добавим номер диста
     ww_str:='ПРОФ'+string(kol_ndfl,2);
     vbank.pKatBank:=tmp_prn_cash.cRec;
     if vBank.getfirst KatBank=tsok
       if vBank.getfirst KatOrg=tsok {}
     ww_str:=ReplSymBol(ww_Str);
     ww_str:=SubStr(ww_Str,1,30);
     MyLogWrite(false,'ПРОФ Лист '+ww_str+', tmp_prn_cash.NPP='+string(tmp_prn_cash.NPP)) ;
#IFDEF GP_Cash_Application_Diff_File
#ELSE
     //------------------------------
     //создаем лист
     xlSetActiveSheet(1);
     xlAddSheet;
     xlSetActiveSheet(1);
     SetPaperParam;
     if True //not xlCopyExtFormat(book_ndfl,'NDFL') - Ломает даже копирование буфера
     { //---------------------
       xlSetActiveWorkBookByName(book_Main);
       xlSetColumnWidth(36,1,01,1,01);//01
       xlSetColumnWidth(21,1,02,1,02);//02
       xlSetColumnWidth(19,1,03,1,03);//03
       xlSetColumnWidth(20,1,04,1,04);//04
       xlSetColumnWidth(16,1,05,1,05);//05
       xlSetColumnWidth(12,1,06,1,06);//06
       xlSetColumnWidth(16,1,07,1,07);//07
       xlSetColumnWidth(03,1,08,1,08);//08
       xlSetColumnWidth(03,1,09,1,09);//09
       xlSetColumnWidth(03,1,10,1,10);//10



       xlSetActiveWorkBookByName(book_Main);
       wexrow:=1;wexcol:=1;
       MyPutExcel('-',9,0,-1,-1);

       //-------------- пробуем все
       xlSetActiveWorkBookByName(book_prof);
       xlCopyToBuff(1, 1, prof_row,prof_col);
       //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
       xlSetActiveWorkBookByName(book_Main);
       // только в таком порядке. В рабочей папке можно создать Excel.log
       xlPasteAllFromBuff(1, 1, prof_row,prof_col);
       //------------------------

       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, prof_row,prof_col);
       xlSetActiveWorkBookByName(book_Main);
       xlPasteFormatFromBuff(1, 1, prof_row,prof_col);


       //------------------------
       //чтобы снять выделение после вставки
       xlCopyToBuff(1, 1, 1,1);
       xlPasteAllFromBuff(1, 1, 1,1);

     }
#ENDIF
     if not xlSetSheetName(1,ww_str )
     { MyLogWrite(false,'ПРОФНДФЛ Лист '+ww_str+' ошибка наименования!' );
       MyLogWrite(false,xlGetLastError() );

     }
     wexrow:=1;wexcol:=1;
     MyPutExcel('',9,0,-1,-1);
     //создаем лист
     //------------------------------
     var _wMes :word;
     var _wYear:word;
     _wMes:=month(DT_Period);
     _wYear:=year(DT_Period);

     //--------------------------------
     _sPeriod:=DateToStr(DT_Period,'MM.YYYY');//SubStr(tmp_prn_cash.Name,2,7);
     //--------------------------------

     //от 06.01.20 18  № 972/ 3
     ww_Str:=DateToStr(DTAppl,'DD.MM.YYYY')+' № РКУ-ЭМ/ '+sNumber;

     wexrow:=7; wexcol:=1;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Прошу оплатить сумму
     wexrow:=11; wexcol:=2;
     MyPutExcel(DoubleToStr(tmp_prn_cash.SumNeed,'666 666 666 666,88')+' рублей' ,0,0,-1,-1); //
     //Назначение платежа
     //Профсоюзные взносы за декабрь  2017  удержаны с сотрудников АО "НПО Энергомаш" в сумме :
     ww_str:='Профсоюзные взносы за '+DateToStr(DT_Period,'month YYYY')+'  удержаны с сотрудников ' + sGetTune('MYORG') + ' в сумме' ;
     wexrow:=10; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     XlMergeCells(wexrow,2,wexrow,7);
     //2.  ДЛЯ   ИНФОРМАЦИИ:
     //Фонд оплаты труда за декабрь 2017  составил:  313 256  тыс. руб.
     delete all tmp_Sb_One;
     var _Fond:double;
     _Fond:=0;
     var _VA_KLVIDOPL_FOND:comp;
     _VA_KLVIDOPL_FOND:=ExtAttr_ID(coKlVidopl,'905 Фонд заработной платы (ОВР)');
     var _VA_KLVIDOPL_FOND_Val:comp;
     _VA_KLVIDOPL_FOND_Val:=0;
     vKau.wKodGrKau:=10054;
     vKau.sNameKau :='Входит в Фонд ЗП';
     if vKau.getfirst SpKau=tsok
       _VA_KLVIDOPL_FOND_Val:=vKau.Spkau.Nrec;
     var hStrFilter :longint=0;
     var Q: IQuery;
     var wErr:word=0;
     timelog('_VA_KLVIDOPL_FOND='+string(_VA_KLVIDOPL_FOND)
            +', _VA_KLVIDOPL_FOND_Val='+string(_VA_KLVIDOPL_FOND_Val)
            +',_wYear='+string(_wYear)
            +',_wMes=' +string(_wMes)
            );
     if date(1,_wMes,_wYear)<date(1,MonthRas,YearRas)
     { Q:=queryManager.createQuery(SQLQuery(
        select sum(Nachisl.Summa)  as Summa
        ,0 as PA
        From Sumvidop Nachisl
        inner join KlVidopl on KlVidopl.VidOpl = Nachisl.VidOpl //Nachisl.VidOpl
        //                   and KLVIDOPL.VHVO[5]='+'
        inner join AttrVal on AttrVal.wTable = 15010
                 and AttrVal.cRec = KlVidopl.Nrec
                 and AttrVal.cAttrNam = :(_VA_KLVIDOPL_FOND)
                 and AttrVal.VComp    = :(_VA_KLVIDOPL_FOND_VAL)
        where Nachisl.Yearn=:(_wYear) and Nachisl.Mesn=:(_wMes)
        %Filter
        //into (_Fond);
       ));
     }
     else
     { Q:=queryManager.createQuery(SQLQuery(
          select sum(Nachisl.Summa) as Summa
          ,0 as PA
          From Nachisl
          inner join KlVidopl on KlVidopl.VidOpl = Nachisl.VidOpls // Nachisl.VidOpls
          //                   and KLVIDOPL.VHVO[5]='+'
          inner join AttrVal on AttrVal.wTable = 15010
                   and AttrVal.cRec = KlVidopl.Nrec
                   and AttrVal.cAttrNam = :(_VA_KLVIDOPL_FOND)
                   and AttrVal.VComp    = :(_VA_KLVIDOPL_FOND_VAL)
          where Nachisl.YearV=:(_wYear) and Nachisl.MesV=:(_wMes)
          %Filter
          //into (_Fond);
        ));
     }
     if IsBitCTW(wFilter,1)
     { sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and Nachisl.Cexoz ',DepList));
     }
     if (hStrFilter<>0)
     { Q.setMacro('Filter' ,hStrFilter );
       sqlFreeStr(hStrFilter);
     }
     if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса ПРОФС. Сумма при отборе значений ('+string(Q.ErrorCode)+').',error)
     else
     { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_sb_one,true);
       timelog('SborDataProf этап 3 '+String(wErr)+', '+RecordsInTable(TNtmp_sb_one));
     }
     ReReadRecord(#tmp_sb_one);
     if getfirst tmp_sb_one=tsok
     { _Fond:=tmp_sb_one.Summa;

     }
     ww_str:='Фонд оплаты труда за '+DateToStr(DT_PERIOD,'month YYYY')+' составил:  '+DoubleToStr(Round(_Fond/1000,2),'666 666 666.99')+' тыс. руб.';

     wexrow:=13; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     XlMergeCells(wexrow,2,wexrow,7);

     //-----------------------------
     //подписи

     wexrow:=23; wexcol:=3;
     MyPutExcel(MyGetInitial(sFioZGD,true),12,0,-1,-1); //

     wexrow:=27; wexcol:=3;
//     MyPutExcel(MyGetInitial(sMainBuh,true),12,0,-1,-1); //
     MyPutExcel(MyGetInitial(sFioZambuh,true),12,0,-1,-1); //

     wexrow:=19;  wexcol:=2;
     MyPutExcel(MyGetInitial(sFioUser,True)+if(sTelUser<>'',', '+sTelUser,''),12,0,-1,-1); //

     //03.03.2018 wexrow:=17;  wexcol:=2;
     //03.03.2018 MyPutExcel(MyGetInitial(sFioZambuh,True)+if(sTelZambuh<>'',', '+sTelZambuh,''),12,0,-1,-1); //

   } //_Loop tmp_prn_cash where (( 101 == tmp_prn_cash.pa ))
   Result:=True;
} //Function Print_Prof(_Zakaz:string;_Su:double; _wtp:word);


//-------------------------------------------------
// выплаты физ.лицам
//-------------------------------------------------
Function SborDataMat(_wTp:word):boolean;
var pUserId:comp;
    pUserName:string;
    wErr:word;
{ Result:=false;
  pUserId  :=UserID();
  pUserName:=UserName();

  //-------------------------------------------
  // Реестры
  //-------------------------------------------
  _try
  {
    var hStrFilter,hStrFilterP,hStrFilterR:longint;
    var Q: IQuery;
    hStrFilter :=0;
    hStrFilterP:=0;
    hStrFilterR:=0;
    Q:=queryManager.createQuery(SQLQuery(
    Select

       //SubString(SbBan.name,1,9)    as  Name //  нужен только период!!! [01.2018]
       #GP_Cash_Application_Podr_Case(SpPlBan.Fio,SubString(SbBan.name,1,9))  as Name
      ,Sum(SPPLBAN.SUMOPL)  SumNeed //:double "Требуемая выплата"
      ,105 Pa    //  :word   "0 ведомости, 1 реестры"
      //1 касса, 2 - банк
      //,CASE WHEN COALESCE(PlVed.cLsch,#comp(0))=#comp(0) THEN 2 ELSE 1 END as NPP     //:word
      //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
      ,#GP_Cash_Application_Podr_Case(1,2) as NPP
      ,CASE WHEN (SBBAN.VidUd in (182,183,184,17,55,56,57)) THEN 182 ELSE 0 END VidUd //:word
      ,#GP_Cash_Application_Podr_Case(SPPLBAN.VidOpl,0)  as  VidOpl //:word
      ,Max(sbban.prefix) Prefix  //:word
      ,SubString(COALESCE(vPlan.Name,'Основная'),1,100) as Zakaz
      ,COALESCE(vPlan.Nrec,#comp(0)) as cvPlan // :comp "Группа заказов"
      ,SbBan.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
      ,SbBan.DATAN  as Datan
      ,'' as NameVed
       //,#comp(0) as Nrec
       ,#GP_Cash_Application_Podr_Case(SPPLBAN.cLsch,#comp(0) ) as nrec
       //--- аналитика
       ,SbBan.SIDE as SIDE //Код среза аналитик
       ,SbBan.wKau as wKau //Код аналитики
       ,SbBan.cKau as cKau //Аналитика
       , coalesce(nplat.kodplat,'') as  kodplat
    From SbBan
    //inner join KatBank on KatBank.Nrec   = SbBan.cBankPol
    inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
    inner join KatPodr on KatPodr.Nrec = Lschet.Cex
    left  join nplat    on nplat.nrec = sbban.cplat //coalesce(nplat.kodplat,'') as  kodplat
    // проверим что есть ведомость по человеку
    //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
    /*
    Left Outer join
    ( select SpPlved.cLsch as cLsch
      From PlatVed
      inner join SPPLVED on SPPLVED.CPLATVED = PlatVed.Nrec
      inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
      where
          PLATVED.DFORM>=:(DTB)
      and PLATVED.DFORM<=:(DTE)
      %FilterP
      and (ZU.POdrShare <> '+' or
        ( SPPLVED.cex in
           (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME)
        )
        )
      Group by
        SpPlved.cLsch
    ) Plved on PlVed.cLsch= SPPLBAN.cLsch
    */
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    Left Outer join AttrVal on AttrVal.cAttrNam=:(ATTR_SB_VPLAN)
                    and AttrVal.wTable = 16060
                    and AttrVal.cRec   = SbBan.Nrec
    Left Outer join vPlan on vPlan.Nrec= AttrVal.vComp
    where
    //    SbBan.DATOK>=:(DTB) //дата выплаты
    //and SbBan.DATOK<=:(DTE) //дата выплаты
        SbBan.DForm>=:(DTB) //дата выплаты
    and SbBan.DForm<=:(DTE) //дата выплаты
    and #GP_Cash_Application_Podr_Case(1,2)=1
    //and (SBBAN.VidUd=182 or SBBAN.vidud=183 or SBBAN.vidud=184) // не подоходный
    //17.01.2017
    //3. В выборке данных не должны участвовать реестра с типом "ДОГП" - по договорам подряда.
    and SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A'
    // Не фот
    and SBBAN.Prefix<>'S$'
    //объединенный
    and SBBAN.Prefix<>'R$$'
     %Filter
     %FilterR
    and (ZU.POdrShare <> '+'
      or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    Group by
     #GP_Cash_Application_Podr_Case(SpPlBan.Fio,SubString(SbBan.name,1,9))
     ,SbBan.cBankPol
     //#808.#75 - не сбивать реестры
     ,SbBan.Nrec
     ,SubString(COALESCE(vPlan.Name,'Основная'),1,100)
     ,COALESCE(vPlan.Nrec,#comp(0))  // :comp "Группа заказов"
     //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
     // ,CASE WHEN COALESCE(PlVed.cLsch,#comp(0))=#comp(0) THEN 2 ELSE 1 END  //as NPP     //:word
     ,CASE WHEN (SBBAN.VidUd in (182,183,184,17,55,56,57) ) THEN 182 ELSE 0 END
     ,#GP_Cash_Application_Podr_Case(1,2)
     ,#GP_Cash_Application_Podr_Case(SPPLBAN.VidOpl,0)
     ,SbBan.DATAN
     ,SbBan.SIDE //Код среза аналитик
     ,SbBan.wKau //Код аналитики
     ,SbBan.cKau //Аналитика
     ,#GP_Cash_Application_Podr_Case(SPPLBAN.cLsch,#comp(0) )
     ,nplat.kodplat
     //,sbban.prefix
    )); //queryManager.createQuery(SQLQuery(
    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',Marker_KatPodr));
      sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',DepList));
      sqlAddStr(hStrFilterP,iQBuilder.MakeCriteriaFromMarker(' and platved.cex ',DepList));
      timelog('GP_Cash_Application->SborDataNDFL:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if IsBitCTW(wFilter,2)
    { sqlAddStr(hStrFilterR,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Nrec ',Marker_SbBan));
      timelog('GP_Cash_Application->SborDataNDFL:фильтр по реестрам hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    {
      Q.setMacro('Filter' ,hStrFilter );
      sqlFreeStr(hStrFilter);
    }
    if (hStrFilterR<>0)
    {
      Q.setMacro('FilterR' ,hStrFilterR );
      sqlFreeStr(hStrFilterR);
    }
    if (hStrFilterP<>0)
    {
      Q.setMacro('FilterP',hStrFilterP);
      sqlFreeStr(hStrFilterP);
    }
    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса физ.лица при отборе значений ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
      timelog('SborDataMAT этап 2 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса физ.лица '+ExploreException);
  }
  _finally
  {
  }
  Result:=true;
} //Function SborDataMat(_wTp:word):boolean;


//--------------------------------------
// установить ширину столбцов
//--------------------------------------
Procedure SetWidthMat();
{ xlSetColumnWidth(36,1,01,1,01);//01
  xlSetColumnWidth(16,1,02,1,02);//02
  xlSetColumnWidth(16,1,03,1,03);//03
  xlSetColumnWidth(16,1,04,1,04);//04
  xlSetColumnWidth(22,1,05,1,05);//05
  xlSetColumnWidth(21,1,06,1,06);//06
  xlSetColumnWidth(13,1,07,1,07);//07
  // не влазит
  xlSetRowHeight(31 ,16,1,16,10);//10
} //Procedure SetWidthMat();

