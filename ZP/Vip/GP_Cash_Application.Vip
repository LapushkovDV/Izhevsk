//
//---------------------------------
Procedure SaveParam;
{ SaveMyDsk(wFilter  ,'GP_Cash_Application_wFilter'  );
  SaveMyDsk(DTB      ,'GP_Cash_Application_DTB'      );
  SaveMyDsk(DTE      ,'GP_Cash_Application_DTE'      );
  SaveMyDsk(DT_Period,'GP_Cash_Application_DT_Period');
  SaveMyDsk(wPeriod  ,'GP_Cash_Application_wPeriod'  );
  SaveMyDsk(DTAppl   ,'GP_Cash_Application_DTAppl'   );//Дата заявки
  //========================
  SaveMyDsk(fDeponent,'GP_Cash_Application_fDeponent');//Депонент
  SaveMyDsk(fPutevka ,'GP_Cash_Application_fPutevka');//сумма путевок (нужно вычесть из суммы травматизма)
  //========================

  SaveMyDsk(wOption    ,'GP_Cash_Application_wOption'  );//Опции
  SaveMyDsk(wOpt_Uder  ,'GP_Cash_Application_Uder'     );//Добавить удержания
  SaveMyDsk(wOpt_FSS   ,'GP_Cash_Application_FSS'      );//формировать из Perevod
  SaveMyDsk(wOpt_FSS_RZ,'GP_Cash_Application_FSS_RZ'   );//формировать из Perevod

  SaveMyDsk(sNumber  ,'GP_Cash_Application_sNumber'  );//номер
  SaveMyDsk(logfilekl,'GP_Cash_Application_logfilekl');

  SaveMyDsk(sFioZambuh ,'GP_Cash_Application_sFioZambuh' );
  SaveMyDsk(sDolgZambuh,'GP_Cash_Application_sDolgZambuh');
  SaveMyDsk(sTelZambuh ,'GP_Cash_Application_sTelZambuh' );
  SaveMyDsk(sFioUser   ,'GP_Cash_Application_sFioUser'   );
  SaveMyDsk(sPodrUser  ,'GP_Cash_Application_sPodrUser'  );
  SaveMyDsk(sDolgUser  ,'GP_Cash_Application_sDolgUser'  );
  SaveMyDsk(sTelUser   ,'GP_Cash_Application_sTelUser'   );


  DoneMarker(Marker_KatPodr,'GP_Cash_Application_KatPodr');
  DoneMarker(Marker_SbBan,'GP_Cash_Application_SbBan');
  DoneMarker(Marker_PlatVed,'GP_Cash_Application_PlatVed');
  DoneMarker(Marker_Tmp,'');
} //Procedure SaveParam;

//---------------------------------
Procedure ReadParam;
{ if not ReadMyDsk(wFilter   ,'GP_Cash_Application_wFilter'  ,false) wFilter:=0;;
  if not ReadMyDsk(DTB       ,'GP_Cash_Application_DTB'      ,false) DTB:=date(1,MonthRas,YearRas);
  if not ReadMyDsk(DTE       ,'GP_Cash_Application_DTE'      ,false) DTE:=date(Last_day(DTB),MonthRas,YearRas);
  if not ReadMyDsk(DT_Period ,'GP_Cash_Application_DT_Period',false) DT_Period:=date(1,MonthRas,YearRas);

  if not ReadMyDsk(wPeriod   ,'GP_Cash_Application_wPeriod'  ,false) wPeriod:=0;
  if not ReadMyDsk(DTAppl    ,'GP_Cash_Application_DTAppl'   ,false) DTAppl:=Cur_Date;//Дата заявки
  //-----------------------------------
  if not ReadMyDsk(fDeponent ,'GP_Cash_Application_fDeponent',false) fDeponent:=0;//Депонент
  if not ReadMyDsk(fPutevka  ,'GP_Cash_Application_fPutevka' ,false) fPutevka :=0;//сумма путевок (нужно вычесть из суммы травматизма)
  //-----------------------------------

  if not ReadMyDsk(wOption    ,'GP_Cash_Application_wOption'  ,false) wOption     := 1 ;//Опции
  if not ReadMyDsk(wOpt_Uder  ,'GP_Cash_Application_Uder'     ,false) wOpt_Uder   := 0 ;//Добавить удержания
  if not ReadMyDsk(wOpt_FSS   ,'GP_Cash_Application_FSS'      ,false) wOpt_FSS    := 1 ;//формировать из Perevod
  if not ReadMyDsk(wOpt_FSS_RZ,'GP_Cash_Application_FSS'      ,false) wOpt_FSS_RZ := 1 ;//формировать из Perevod
  if not ReadMyDsk(sNumber    ,'GP_Cash_Application_sNumber'  ,false) sNumber     := '';//номер
  if not ReadMyDsk(logfilekl  ,'GP_Cash_Application_logfilekl',false) logfilekl   := false;//номер

  if not ReadMyDsk(sFioZambuh ,'GP_Cash_Application_sFioZambuh' ,false) sFioZambuh :='Никитина Е.К.';
  if not ReadMyDsk(sDolgZambuh,'GP_Cash_Application_sDolgZambuh',false) sDolgZambuh:='';
  if not ReadMyDsk(sTelZambuh ,'GP_Cash_Application_sTelZambuh' ,false) sTelZambuh :='' ;
  if not ReadMyDsk(sFioUser   ,'GP_Cash_Application_sFioUser'   ,false) sFioUser   :=sGetTune('USER.FIO') ;
  if not ReadMyDsk(sPodrUser  ,'GP_Cash_Application_sPodrUser'  ,false) sPodrUser  :='';
  if not ReadMyDsk(sDolgUser  ,'GP_Cash_Application_sDolgUser'  ,false) sDolgUser  :='';
  if not ReadMyDsk(sTelUser   ,'GP_Cash_Application_sTelUser'   ,false) sTelUser   :='';
  vPers.pPerson:=GetPersonsByUser(UserID());
  if sTelUser=''
  { vPers.pPerson:=GetPersonsByUser(UserID());
    if vPers.pPerson>0
    { sTelUser:=GetTelUser;
    }
  }
  if sDolgUser=''
  { if vPers.Getfirst Persons=tsok
    { if vPers.Getfirst Appointments=tsok
        sDolgUser:=GetCatalogsName(vPers.Appointments.Post);
    }
  }
  if sPodrUser=''
  { if vPers.Getfirst Persons=tsok
    { if vPers.Getfirst Appointments=tsok
        sPodrUser:=GetCatalogsCode(vPers.Appointments.Department);
    }
  }
  ReadPodpisant;

  Marker_KatPodr :=InitMarker('GP_Cash_Application_KatPodr'  , 8, 50, 10, True);
  Marker_SbBan   :=InitMarker('GP_Cash_Application_SbBan'  , 8, 50, 10, True);
  Marker_PlatVed :=InitMarker('GP_Cash_Application_PlatVed', 8, 50, 10, True);
  Marker_TMP     :=InitMarker('', 8, 50, 10, True);
} //Procedure SaveParam;

