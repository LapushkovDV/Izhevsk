//------------------------------------------
// печать заявки договора подряда
//------------------------------------------
Function Print_DOG(_wtp:word=0):boolean;
var ww_dt:date;
    ww_str:string;
    kol_ndfl:longint;
    _sPeriod:string;
    ndfl_row:longint;
    ndfl_col:longint;
    boFirst:boolean;
{  Result:=false;
   GetPeriod;

   ww_dt:=date(1,wMonth,wYear);
   kol_ndfl:=0;
   matrixkl:=false;
   ndfl_row:=40;
   ndfl_col:=8;
   boFirst:=true;
   _Loop tmp_prn_cash where (( 106 == tmp_prn_cash.pa and 0 == tmp_prn_cash.Vidud(noindex) ))
   {
     //------------------------------
     //создаем лист
     kol_ndfl++;

     // а вдруг будет не уникально - добавим номер диста
     ww_str:='ДОГ '+string(kol_ndfl,2)+'-'+tmp_prn_cash.Name;
     //1932 замеч. от 21.02.2018 не разбивать по кассе/банк+' '+if(tmp_prn_cash.NPP=1,'К','Б');
     vbank.pKatBank:=tmp_prn_cash.cRec;
     if vBank.getfirst KatBank=tsok
       if vBank.getfirst KatOrg=tsok
         ww_str:=ww_str+' '+if(vBank.KatOrg.ShortName<>'',vBank.KatOrg.ShortName,vBank.KatOrg.Name);
     ww_str:=ReplSymBol(ww_Str);
     ww_str:=SubStr(ww_Str,1,30);
     MyLogWrite(false,'Договора подряда '+ww_str+', tmp_prn_cash.NPP='+string(tmp_prn_cash.NPP)) ;
#IFDEF GP_Cash_Application_Diff_File
    //надо добавить лист
    if not boFirst
    { xlSetActiveSheet(1);
      xlAddSheet;
      xlSetActiveSheet(1);
      SetWidthDOG();
      SetPaperParam;
      if not xlSetActiveSheet(kol_ndfl)
      { message('Ошибка установки листа с форматом!');
      }
      xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
      //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
      xlSetActiveSheet(1);
      // только в таком порядке. В рабочей папке можно создать Excel.log
      xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
      xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
      //чтобы снять выделение после вставки
      xlCopyToBuff(1, 1, 1,1);
      xlPasteAllFromBuff(1, 1, 1,1);
      SetWidthDOG;
    }
#ELSE
     xlSetActiveSheet(1);
     xlAddSheet;
     xlSetActiveSheet(1);
     SetWidthDOG();
     SetPaperParam;
     if True //not xlCopyExtFormat(book_ndfl,'NDFL') - Ломает даже копирование буфера
     { //MyLogWrite(false,'НДФЛ Лист '+ww_str+' ошибка обновления!' ) ;
       //MyLogWrite(false,'Ошибка :'+xlGetLastError() );
       //---------------------
       SetWidthDOG;
       //---------------------
       xlSetActiveWorkBookByName(book_Main);
       wexrow:=1;wexcol:=1;
       MyPutExcel('-',9,0,-1,-1);

       //-------------- пробуем все
       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
       xlSetActiveWorkBookByName(book_Main);
       // только в таком порядке. В рабочей папке можно создать Excel.log
       xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------

       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       xlSetActiveWorkBookByName(book_Main);
       xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------
       //чтобы снять выделение после вставки
       xlCopyToBuff(1, 1, 1,1);
       //xlPasteAllFromBuff(1, 1, 1,1);

     }
#ENDIF
     boFirst:=false;
     if not xlSetSheetName(1,ww_str )
     { MyLogWrite(false,'ДОГ Лист '+ww_str+' ошибка наименования!' );
       MyLogWrite(false,xlGetLastError() );

     }
     wexrow:=1;wexcol:=1;
     MyPutExcel('',9,0,-1,-1);
     //создаем лист
     //------------------------------

     //--------------------------------
     _sPeriod:=DateToStr(tmp_prn_cash.DataN,'MM.YYYY');//SubStr(tmp_prn_cash.Name,2,7);
     //--------------------------------

     //от 06.01.20 18  № 972/ 3
     ww_Str:=DateToStr(DTAppl,'от DD.MM.YYYY')+' № РКУ-ЭМ/ '+sNumber;

     wexrow:=7; wexcol:=1;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Прошу оплатить сумму
     wexrow:=10; wexcol:=2;
     MyPutExcelNumber(tmp_prn_cash.SumNeed,2,0,0,-1,-1); //
     MyPutExcel('('+DoubleToStr(tmp_prn_cash.SumNeed,'4 ) рублей 88 коп.') ,0,0,-1,-1); //
     if getfirst tmp_prn_cash01 where (( tmp_prn_cash.pa == tmp_prn_cash01.pa
       and tmp_prn_cash.Name == tmp_prn_cash01.name(noindex)
       and 182 == tmp_prn_cash01.Vidud(noindex)
     )) =tsok
     { wexrow:=11; wexcol:=2;
       MyPutExcelNumber(tmp_prn_cash01.SumNeed,2,0,0,-1,-1); //
       MyPutExcel('('+DoubleToStr(tmp_prn_cash01.SumNeed,'4 ) рублей 88 коп.') ,0,0,-1,-1); //
     }
     //--------------------------
     //Договор
     ww_str:='';
     var _wNazn:string='';
     vdog.pLschet:=tmp_prn_cash.cvPlan;
     if vDog.getfirst prvidopl=tsok
       if vDog.getfirst sys_mbf=tsok
         if vDog.getfirst DOGPODR=tsok
         { ww_str:='договор № '+vDog.DOGPODR.DSCDOC
                +' от '+DateToStr(vDog.DOGPODR.LASTDATE,'DD.MM.YYYY');
           _wNazn:=sGetAttrID(coDOGPODR,vDog.DOGPODR.Nrec,pVA_DOGPODR_Content);
         }
     if ww_str=''
     if tmp_prn_cash.Vidopl>0
     { vDoplata.pLschet:=tmp_prn_cash.cvPlan;
       vDoplata.wVidopl:=tmp_prn_cash.Vidopl;
       if vDoplata.getlast Doplata=tsok
       if vDoplata.getfirst OtpDop=tsok
       { var jj:word;
         For(jj:=1;jj<=6;jj++)
         { //if vDoplata.Doplata.tblExtr[jj]=cgKau_Dogovor
           if vDoplata.OtpDop.tblD[jj]=cgKau_Dogovor
           { //vDogovor.pDogovor:=vDoplata.Doplata.KauExtr[jj];
             vDogovor.pDogovor:=vDoplata.OtpDop.cKaud[jj];
             if vDogovor.getfirst Dogovor=tsok
             { ww_str:='договор  № '+vDogovor.DOGOVOR.NoDoc
                +' от '+DateToStr(vDogovor.DOGOVOR.DDoc,'DD.MM.YYYY');
               if vDogovor.getfirst AttrDog=tsok
                _wNazn:=vDogovor.AttrDog.Subject1;
             }
             break;
           }
         }
       } //if vDoplata.getlast Doplata=tsok
     } //if ww_str=''-> if tmp_prn_cash.Vidopl>0
     wexrow:=15; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //--------------------------
     //Назначение платежа
     ww_str:=_wNazn;
     if ww_Str=''
     if tmp_prn_cash.VidOpl>0
     { if getfirst KlVidopl where (( tmp_prn_cash.VidOpl  == KLVIDOPL.VIDOPL ))=tsok
         { //ww_str:=ww_str+' '+My_Sclonenie(KLVIDOPL.NVidopl,12);
           ww_str:=ww_str+'"'+KLVIDOPL.NVidopl+'"';
         }
         ww_str:=ww_str+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
     }
     //ww_str:=ww_str+ if(tmp_prn_cash.Npp=1,' - КАССА',' - БАНК');
     wexrow:=14; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //--------------------------
     Print_DOG_Pol;
     //подписи
     Print_DOG_Podp;
   } //_Loop tmp_prn_cash where (( 101 == tmp_prn_cash.pa ))
   Result:=True;
} //Function Print_Dog(_Zakaz:string;_Su:double; _wtp:word);


//----------------------------------
// Формирование отчета
//----------------------------------
Function FormDoc:boolean;
var  werr:word;
     _boFirst:boolean;
{ Result:=true;
  timelog('GP_Cash_Application->FormDoc START');
  _boFirst:=true;
  //---------------------
  CreateTempVib;
  //---------------------
  if IsBitCTW(wFilter,1)
  { if DepList <> 0
      DoneMarker(DepList, '');
    DepList := CLSF.LoadCurrentDepartmentList;
    InsTempVibByMarker(01,DepList  );
  }
  wMonth:=month(DT_Period);
  wYear :=Year(DT_Period);

  //---------------------
  sMacro:=GetStringParameter('Files','OutputFilesDirectory',0)+'!Macro.Out';
  if FileExist(sMacro) DeleteFile(sMacro);
  //---------------------
  vDog.tm:=2;
  if DT_Period<Date(1,MonthRas,YearRas)
  { vDog.tm:=2;
  }
  // печатаем за будущий период
  if date(1,month(DT_Period),year(DT_Period))>dGetTune('Up.DATOTCH')
  { vDog.tm:=88
  }
  pVA_DOGPODR_Content:=ExtAttr_Create(coDOGPODR,'Краткое содержание договора',cgAttrType_Str);
  //---------------------

  if sFioZambuh='' sFioZambuh:='Никитина Е.К.';
  if sFioUser  ='' sFioUser  :=sGetTune('USER.FIO');
  if sMainBuh  ='' sMainBuh  :=sGetTune('MAINBUH');
  file_ndfl       :=translatepath('%ClientStartPath%#_MYXLSPATH_\')+'GP_Cash_Application_NDFL.Xlsx';
  file_ndfl15perc :=translatepath('%ClientStartPath%#_MYXLSPATH_\')+'GP_Cash_Application_NDFL15.Xlsx';
  file_ndfl18perc :=translatepath('%ClientStartPath%#_MYXLSPATH_\')+'GP_Cash_Application_NDFL18.Xlsx';
  file_prof :=translatepath('%ClientStartPath%#_MYXLSPATH_\')+'GP_Cash_Application_PROF.Xlsx';
  file_Strax:=translatepath('%ClientStartPath%#_MYXLSPATH_\')+'GP_Cash_Application_STRAX.Xlsx';
  file_Mat  :=translatepath('%ClientStartPath%#_MYXLSPATH_\')+'GP_Cash_Application_Mat.Xlsx';
  delete all tmp_prn_cash;
  delete all tmp_prn_zakaz;
  if IsBitCtW(wOption,2)
  {
    if (not FileExist(file_ndfl))
    { message('Не нашли шаблон заявки на НДФЛ'
      +chr(13)+file_ndfl
      );
      Exit;
    }
    if (not FileExist(file_ndfl15perc))
    { message('Не нашли шаблон заявки на НДФЛ 15%'
      +chr(13)+file_ndfl15perc
      );
      Exit;
    }
    if (not FileExist(file_ndfl18perc))
    { message('Не нашли шаблон заявки на НДФЛ 18%'
      +chr(13)+file_ndfl18perc
      );
      Exit;
    }

  }
  if IsBitCtW(wOption,3)
  {
    if not FileExist(file_strax)
    { message('Не нашли шаблон заявки на страховые взносы'
      +chr(13)+file_strax
      );
      Exit;
    }
  }
  if IsBitCtW(wOption,4)
  {
    if not FileExist(file_prof)
    { message('Не нашли шаблон заявки на проф.взносы'
      +chr(13)+file_prof
      );
      Exit;
    }
  }
  if IsBitCtW(wOption,5)
  {
    if not FileExist(file_Mat)
    { message('Не нашли шаблон заявки на выплаты физ.лицам'
      +chr(13)+file_Mat
      );
      Exit;
    }
  }
  LogFileNm:=GetStringParameter('Files','OutputFilesDirectory',0)+'!GP_Cach_Apl.Log';
  if FileExist(LogFileNm) DeleteFile(LogFileNm);
  //-------------------------------------------
  sFioZGD:='';
  if vSpr.getfirst StaffStruct=tsok
  { if vSpr.getfirst Appointments=tsok
      if vSpr.getfirst Persons=tsok
        sFioZGD:=vSpr.Persons.Fio;
  }
  //-------------------------------------------


#IFDEF GP_Cash_Application_Diff_File
#ELSE
  werr:=ExcelInit('GP_Cash_Application.Xlsx',true);
  xlDisplayAlerts(false);
  book_main:='';
  xlGetActiveWorkBookName(book_main);
  CreatePaperParam;

#ENDIF
  if IsBitCtW(wOption,1)
  {
#IFDEF GP_Cash_Application_Diff_File
    werr:=ExcelInit('GP_Cash_Application.Xlsx',true);
    CreatePaperParam;
    xlDisplayAlerts(false);
#ENDIF
    MyLogWrite(true,'START');
    Result:=False;
    //MTRetrieve(#tmp_prn_cash,mfFilters);
    //--------------------------
    delete all tmp_prn_cash;
    delete all tmp_prn_cash01;
    //--------------------------
    Result:=SborData;
    if Result
    { if not iNextVisual('Ждите, идет формирование отчета') exit;
      kol_List:=0;
      _boFirst:=true;

      _Loop fullcache tmp_prn_zakaz
      { kol_List++;

        Result:=PrintDoc(tmp_prn_zakaz.Zakaz,_boFirst);
        If Not Result break;
        update current tmp_prn_zakaz;
        _boFirst:=false;
      }
    }
#IFDEF GP_Cash_Application_Diff_File
    xlKillExcel;
#ENDIF
  }//if IsBitCtW(wOption,1)

  //------------------------------------------
  //печать НДФЛ
  if Result
  if IsBitCtW(wOption,2)
  { MyLogWrite(false,'НДФЛ ');
    book_ndfl:='';
    do
    { Result:=SborDataNdfl(1);
      if not Result exit;
      //Result:=xlOpenWorkBook(file_ndfl);
#IFDEF GP_Cash_Application_Diff_File
      werr:=ExcelInit('GP_Cash_Application_NDFL.Xlsx',true);
#ELSE
      Result:=xlOpenWorkBook(file_ndfl);
      if not Result
      { message('Ошибка открытия шаблона '
         +chr(13)+file_ndfl
        );
        break;
      }
#ENDIF
      xlGetActiveWorkBookName(book_ndfl);
      CreatePaperParam;
      MyLogWrite(false,'НДФЛ Книга '+book_ndfl) ;
      //Result:=xlSetActiveWorkBookByName(book_main);
#IFDEF GP_Cash_Application_Diff_File
#ELSE
      if not Result
      { message('Ошибка установки книги '+book_main);
        break;
      }
#ENDIF
      Result:=Print_Ndfl;
      if not Result break;
    } while false
#IFDEF GP_Cash_Application_Diff_File
    xlKillExcel;
#ELSE
    if book_ndfl<>''
      xlCloseWorkBookByName(book_ndfl);
#ENDIF

MyLogWrite(false,'НДФЛ 15%');
    book_ndfl:='';
    do
    { Result:=SborDataNdfl15perc(1);
      if not Result exit;
      //Result:=xlOpenWorkBook(file_ndfl);
#IFDEF GP_Cash_Application_Diff_File
//      message('debug werr:=ExcelInit(GP_Cash_Application_NDFL15.Xlsx,true);');
      werr:=ExcelInit('GP_Cash_Application_NDFL15.Xlsx',true);
#ELSE
//      message('debug xlOpenWorkBook(file_ndfl15perc);');
      Result:=xlOpenWorkBook(file_ndfl15perc);
      if not Result
      { message('Ошибка открытия шаблона '
         +chr(13)+file_ndfl15perc
        );
        break;
      }
#ENDIF
      xlGetActiveWorkBookName(book_ndfl);
      CreatePaperParam;
      MyLogWrite(false,'НДФЛ Книга '+book_ndfl) ;
      //Result:=xlSetActiveWorkBookByName(book_main);
#IFDEF GP_Cash_Application_Diff_File
#ELSE
      if not Result
      { message('Ошибка установки книги '+book_main);
        break;
      }
#ENDIF
      Result:=Print_Ndfl15Perc;
      if not Result break;
    } while false

#IFDEF GP_Cash_Application_Diff_File
    xlKillExcel;
#ELSE
    if book_ndfl<>''
      xlCloseWorkBookByName(book_ndfl);
#ENDIF

MyLogWrite(false,'НДФЛ 18%');
    book_ndfl:='';
    do
    { Result:=SborDataNdfl18perc(1);
      if not Result exit;

#IFDEF GP_Cash_Application_Diff_File

      werr:=ExcelInit('GP_Cash_Application_NDFL18.Xlsx',true);
#ELSE

      Result:=xlOpenWorkBook(file_ndfl18perc);
      if not Result
      { message('Ошибка открытия шаблона '
         +chr(13)+file_ndfl18perc
        );
        break;
      }
#ENDIF
      xlGetActiveWorkBookName(book_ndfl);
      CreatePaperParam;
      MyLogWrite(false,'НДФЛ Книга '+book_ndfl) ;
      //Result:=xlSetActiveWorkBookByName(book_main);
#IFDEF GP_Cash_Application_Diff_File
#ELSE
      if not Result
      { message('Ошибка установки книги '+book_main);
        break;
      }
#ENDIF
      Result:=Print_Ndfl18Perc;
      if not Result break;
    } while false

#IFDEF GP_Cash_Application_Diff_File
    xlKillExcel;
#ELSE
    if book_ndfl<>''
      xlCloseWorkBookByName(book_ndfl);
#ENDIF
  } //if IsBitCtW(wOption,2)

  //--------------------------------
  //печать налоги на фот
  if IsBitCtW(wOption,3)
  { MyLogWrite(false,'ФОТ ');
    wMonth:=month(DT_Period);
    wYear :=Year(DT_Period);

    book_strax:='';
    do
    { Result:=SborDataFot(1);
      if not Result break;
      _boFirst:=true;
//exe\XLS_ЭМ\ZP\\GP_Cash_Application_Strax.Xlsx
//               GP_Cash_Application_STRAX.xlsx
#IFDEF GP_Cash_Application_Diff_File
      werr:=ExcelInit('GP_Cash_Application_STRAX.xlsx',true);
      xlDisplayAlerts(false);
#ELSE
      Result:=xlOpenWorkBook(file_strax);
      if not Result
      { message('Ошибка открытия шаблона '
         +chr(13)+file_strax
        );
        break;
      }
#ENDIF
      book_main:='';
      xlGetActiveWorkBookName(book_main);
      CreatePaperParam;

      kol_List:=0;
      _Loop fullcache tmp_prn_zakaz
      { kol_List++;
        Result:=Print_Fot(tmp_prn_zakaz.Zakaz,_boFirst);
        _boFirst:=false;
      }
      if not Result break;
    } while false
#IFDEF GP_Cash_Application_Diff_File
    xlKillExcel;
#else
    if book_strax<>''  xlCloseWorkBookByName(book_strax);
#ENDIF
  } //if IsBitCtW(wOption,2)

  //--------------------------------
  //печать профсоюзные взносы
  if IsBitCtW(wOption,4)
  {
    wMonth:=month(DT_Period);
    wYear :=Year(DT_Period);
    MyLogWrite(false,'ПРОФ ');
    book_prof:='';
    do
    { Result:=SborDataProf(1);
      if not Result exit;
#IFDEF GP_Cash_Application_Diff_File
      werr:=ExcelInit('GP_Cash_Application_Prof.xlsx',true);
#ELSE
      Result:=xlOpenWorkBook(file_prof);
      xlDisplayAlerts(false);
      if not Result
      { message('Ошибка открытия шаблона '
         +chr(13)+file_prof
        );
        break;
      }
#ENDIF
      xlGetActiveWorkBookName(book_prof);
      CreatePaperParam;
      MyLogWrite(false,'Профс. Книга '+book_prof) ;

#IFDEF GP_Cash_Application_Diff_File
#ELSE
      Result:=xlSetActiveWorkBookByName(book_main);
      if not Result
      { message('Ошибка установки книги '+book_main);
        break;
      }
#ENDIF
      Result:=Print_Prof;
      if not Result break;
    } while false
#IFDEF GP_Cash_Application_Diff_File
    xlKillExcel;
#ELSE
    if book_Prof<>''
      xlCloseWorkBookByName(book_prof);
#ENDIF
  } //if IsBitCtW(wOption,4)

  //------------------------------------------
  //печать заявки на выплаты физ.лицам
  if Result
  if IsBitCtW(wOption,5)
  { MyLogWrite(false,'Физ.лица ');
    book_Mat:='';
    wMonth:=month(DT_Period);
    wYear :=Year(DT_Period);
    do
    { Result:=SborDataMAT(1);
      if not Result exit;
      /*
      if getfirst tmp_prn_cash where (( 105 == tmp_prn_cash.pa
         and 0 == tmp_prn_cash.Vidud(noindex) )) <>tsok
      then break;
      */
      //Result:=xlOpenWorkBook(file_ndfl);
#IFDEF GP_Cash_Application_Diff_File
      werr:=ExcelInit('GP_Cash_Application_MAT.Xlsx',true);
#ELSE
      Result:=xlOpenWorkBook(file_Mat);
      if not Result
      { message('Ошибка открытия шаблона '
         +chr(13)+file_Mat
        );
        break;
      }
#ENDIF
      CreatePaperParam;
      xlGetActiveWorkBookName(book_mat);
      MyLogWrite(false,'Физ.лица Книга '+book_mat) ;
      //Result:=xlSetActiveWorkBookByName(book_main);
#IFDEF GP_Cash_Application_Diff_File
#ELSE
      if not Result
      { message('Ошибка установки книги '+book_main);
        break;
      }
#ENDIF
      Result:=Print_Mat;
      if not Result break;
    } while false
#IFDEF GP_Cash_Application_Diff_File
    xlKillExcel;
#ELSE
    if book_mat<>''
      xlCloseWorkBookByName(book_mat);
#ENDIF
  } //if IsBitCtW(wOption,5)
  //печать заявки на выплаты физ.лицам
  //------------------------------------------

  //------------------------------------------
  //печать заявки на выплаты Договора подряда
  if Result
  if IsBitCtW(wOption,6)
  { MyLogWrite(false,'Договора подряда ');
    wMonth:=month(DT_Period);
    wYear :=Year(DT_Period);
    book_Mat:='';
    do
    { Result:=SborDataDog(1);
      if not Result exit;
      /*
      if getfirst tmp_prn_cash where (( 106 == tmp_prn_cash.pa
         and 0 == tmp_prn_cash.Vidud(noindex) )) <>tsok
      then break;
      */
      //Result:=xlOpenWorkBook(file_ndfl);
#IFDEF GP_Cash_Application_Diff_File
      werr:=ExcelInit('GP_Cash_Application_DOG.Xlsx',true);
#ELSE
      Result:=xlOpenWorkBook(file_Mat);
      if not Result
      { message('Ошибка открытия шаблона '
         +chr(13)+file_Mat
        );
        break;
      }
#ENDIF
      xlGetActiveWorkBookName(book_mat);
      CreatePaperParam;
      MyLogWrite(false,'Договора подряда Книга '+book_mat) ;
      //Result:=xlSetActiveWorkBookByName(book_main);
#IFDEF GP_Cash_Application_Diff_File
#ELSE
      if not Result
      { message('Ошибка установки книги '+book_main);
        break;
      }
#ENDIF
      Result:=Print_Dog(1);
      if not Result break;
    } while false
#IFDEF GP_Cash_Application_Diff_File
    xlKillExcel;
#ELSE
    if book_mat<>''
      xlCloseWorkBookByName(book_mat);
#ENDIF
  } //if IsBitCtW(wOption,6)
  //печать заявки на выплаты по договорам подряда
  //------------------------------------------


  //MyXlEnd;
  timelog('GP_Cash_Application->FormDoc Finish');
} //Function FormDoc:boolean;


  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_KatPodr
    { #mrkfiltr_(KatPodr_Flt,KatPodr,Nrec,wc_nrec,KatPodr_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_SbBan
    { #mrkfiltr_(SbBan_Flt,SbBan,Nrec,wc_nrec,SbBan_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_PlatVed
    { #mrkfiltr_(PlatVed_Flt,PlatVed,Nrec,wc_nrec,PlatVed_Flt.NoDoc+DateToStr(PLATVED_Flt.DFORM,' от DD.MM.YYYY') )
    }
    ReScanPanel(#Zar_user);
  } //Procedure SetFilterNM(_Field:longint)


//-------------------------------
//
//-------------------------------
Procedure MyCheckPeriod;
{ set wPeriod:=if(Day(DTE)>15,0,1);
}

//-------------------------------------
Screen scrParam 'Параметры формирования' (,,sci1Esc);
Table Zar_user;
Fields
  DT_Period :['MM/YYYY'] , NoProtect;
  DTAppl ('Дата заявки' ) : NoProtect;
  sNumber('Номер заявки') : NoProtect;
  //sFeeSigners ('Группа подписантов (F3 - выбор)' , , sci13Esc) : Protect;
  //  `Подписанты:` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  sFioZambuh  ('ФИО зам.главного бухгалтера'      ): NoProtect,PickButton;
  sTelZambuh  ('Телефон зам.главного бухгалтера'  ): NoProtect,NoPickButton;
  sDolgZambuh ('Должность зам.главного бухгалтера'): NoProtect,PickButton;
  sPodrUser   ('Код подразделения Исполнителя'    ): NoProtect,NoPickButton;
  sFioUser    ('ФИО Исполнителя'                  ): NoProtect,PickButton;
  sTelUser    ('Телефон Исполнителя'              ): NoProtect,NoPickButton;
  sDolgUser   ('Должность Исполнителя'            ): NoProtect,PickButton;

  DTB  : NoProtect;
  DTE  : NoProtect;
  wPeriod:[List 0 '1 половину',1 '2 половину',2 'Межпериод' ],Protect;
  fDeponent:NoProtect;
  fPutevka ('сумма путевок, отнимается из перечислений травматизма'):NoProtect;
  logfilekl:NoProtect;
  wFilter:NoProtect;
  //FILTR_KatPodr : Protect,PickButton;
  FiltrPodr: Protect,PickButton;
  FILTR_SbBan   : Protect,PickButton;
// Пока нет интерфейса выбора
  FILTR_PlatVed : Protect,PickButton;
  wOption:NoProtect;
  wOpt_Uder:NoProtect;
  wOpt_FSS ('по перечислениям - выплаты за счет ФСС и травматизма  '):NoProtect;
  wOpt_FSS_RZ ('собрать выплаты за счет ФСС и травматизма из сумм распределенных по заказам '):NoProtect;

Buttons
  cmOk,default,,'Сформировать отчет', hcOplTrudhlp, sci1Esc;
  cmCancel,,,'Выход', hcOplTrudhlp, sci1Esc;
<<
  `Расчетный период формирования`  .@@@@@@@@@@@@@@@@@@
  `Дата заявки`       .@@@@@@@@@@ Номер .@@@@@@@@@@@@@
  `Зам.гл.бухгалтера` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Телефон` .@@@@@@@@ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Исполнитель`.@@@@@ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Телефон` .@@@@@@@@ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Период отбора документов на выплату(реестры/вед.)`
  `c` .@@@@@@@@@@@@@ `по` .@@@@@@@@@@@@
  `за`.@@@@@@@@@@@@@ `месяца`
  `Депонент`.@@@@@@@@@@@ `Путевки`.@@@@@@@@@@@
  `Фильтры`                 [.] Отладка`
  [.] По подразделению`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] По реестрам`     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] По ведомостям`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Сформировать заявку на перечисление`
  [.] з/п, аванса и т.п.`   [:] +алим. и т.д из удер.`
  [.] НДФЛ`
  [.] налогов на ФОТ` [:] Перечисления` [:] распр.заказ`
  [.] профсоюзных взносов`
  [.] физическим лицам`
  [.] Договора подряда`
   <.~С~формировать.>           <.   ~О~тмена   .>
>>
end; //scrParam 'Параметры формирования' (,,sci1Esc), Cyan;

//procedure InitFlt(DV: IDepartmentValidator);
procedure InitFlt;
{
  if NullVipRef(CLSF)
    GetVipInterface(CLSF);

  if NullVipRef(PAF)
    LoadVipInterface(PAF);

  // обновляем даты
  /*
  CheckDatesForFiltr;

  ResetNeedPostMsg;

  MesType := mgtStandart;

  IPAFilterExtOption2(PAF).InitPAFilterMode(DV, cexozDate1, cexozDate2, PAFExtOption);
  SetNeedPostMsg;
  */
}

//--------------------------------------------
// Обработчик событий интерфейса
//--------------------------------------------
HandleEvent
cmInit:
{ TimeLog_Init;
  TimeLog('GP_Cash_Application->cmInit');
  nameNastr:='GP_CASH_APPL_';
  ReadParam;
  var CL: ContextList;
  if (not CL.Add(CS, 'IntInit'))
  {
  }
  InitFlt;
  FiltrPodr:=PAF.GetDepartmentFilterStr;

  TimeLog('GP_Cash_Application->cmInit:001 '+FiltrPodr);
  DT_Period:=date(1,MonthRas,YearRas);
  SetFilterNm(0);
  ATTR_SB_VPLAN:=ExtAttr_CreateComp(coSBBAN,'Группа заказов', cgAttrType_Comp, word(100), coVPlan );
  ATTR_B_INN   :=ExtAttr_Create(coKatBank,'ИНН', cgAttrType_Str );
  TimeLog('GP_Cash_Application->cmInit:002');

  sUserName:=UserName();
  TimeLog('GP_Cash_Application->cmInit:003');
  iFeeSigners.InitFeeSigners(cgReport_KASSFRO);

  TimeLog('GP_Cash_Application->cmInit:004');

  if vCatalogs.Getfirst Catalogs where (( -11 == Catalogs.SysCode))=tsok
  vSpr.cat_main_M11:=vCatalogs.Catalogs.Nrec ;//iCatFunc.GetCatalogsNRec(-11);
  sFioZGD:='';
  if vSpr.getfirst catalogs<>tsok
  { message('Не найдено подразделение с кодом 506'
     +chr(13)+'Заместитель генерального директора по экономике и финансам'
    );
  }
  PutCommand(cmValue2);
  TimeLog('GP_Cash_Application->cmInit:finish');
}
cmValue2:
{ TimeLog('GP_Cash_Application->cmValue2');
}
cmCheckField:
{ case CurField of
  #DTB:
  { if DTB>DTE
    { message('Дата окончания не может быть'
           + chr(13)+'меньше даты начала');
      DTE:=DTB;
      MyCheckPeriod;
    }
  }
  #DTE:
  { if DTB>DTE
    { message('Дата начала не может быть'
           + chr(13)+'больше даты окончания');
      DTB:=DTE;
    }
    MyCheckPeriod;
  }
  #wFilter:
  { if (not isBitCtW(wFilter,1))
    //and isBitCtW(word(OldFieldValue),1)
    { PAF.ClearDepartmentFilter;
    }
    ReReadRecord(#ZAR_USER);
  }
  end;
} //cmCheckField:
cmDone:
{ SaveParam;
  if DepList <> 0
    DoneMarker(DepList, '');

}

cmPick:
{
   case CurField of
   //------------
   #sFeeSigners:
   { iFeeSigners.RunWindowFeeSigners(1);
     set sFeeSigners := iFeeSigners.GetFeeSignersName;
     GetPodpisant;
   }
   //----------------------------
    #sFioZambuh,#sDolgZambuh
   ,#sFioUser,#sDolgUser  :
   {
      var wK:word;
      var DummyMarker1, DummyMarker2: TPtr;
      var _pTmp:comp=0;
      var _cRec:comp;
      DummyMarker1 := InitMarker('', 8, 10, 10);
      DummyMarker2 := InitMarker('', 8, 1, 1);
      wK:=0;
      _pTmp:=0;

      if (viCYPersons.Choice(DummyMarker1, 3, vfCanSelect, wK, _cRec, DummyMarker2))
      {
        set _pTmp:=viCYPersons.GetPsnByKindChoice(wK, _cRec);
        vPers.pPerson :=_pTmp;
        if vPers.Getfirst Persons=tsok
        { case CurField of
          #sFioZambuh,#sDolgZambuh:
          { sFioZambuh:=vPers.Persons.Fio;
            if vPers.Getfirst Appointments=tsok
             sDolgZambuh:=GetCatalogsName(vPers.Appointments.Post);
          }
          #sFioUser,#sDolgUser:
          { sFioUser:=vPers.Persons.Fio;
            if vPers.Getfirst Appointments=tsok
              sDolgUser:=GetCatalogsName(vPers.Appointments.Post);
            sPodrUser:=GetCatalogsCode(vPers.Appointments.Department);
            sTelUser:=GetTelUser();
          }
          end;
        }
      }
      DoneMarker(DummyMarker1, '');
      DoneMarker(DummyMarker2, '');
   }

   //------------
   #FiltrPodr:
   {
     SetupDepartments(comp(11));
     //UpdateFilter;
     if PAF.IsDepartmentFilterSet <> IsBitCtW(wFilter,1)
       BitOnW(wFilter,1);
     FiltrPodr:=PAF.GetDepartmentFilterStr;
   }
   //------------
   #Filtr_KatPodr:
   {
     if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
     { //_PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;
          //CopyMarker(Marker_KatPodr,_PodrMArkerPointer);
          SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,1);
     }
   }
   //------------
   #Filtr_SbBan:
   {
      //#1932 - просят сбрасывать пометку перед выбором
      //StoreMarker(Marker_SbBan,'VedRees_Marker');
      ClearMarker(Marker_Tmp);
      StoreMarker(Marker_Tmp,'VedRees_Marker');
      var MO: IModeOptions(DefinedModeOptions);
      MO.SetFlags(0, vfMultipleSelection);
      if RunInterface('GP_ViewReesCombo', MO,DTB,DTE,false,IsBitCtW(wFilter,1))<>cmCancel
      { Marker_SbBan := InitMarker('VedRees_Marker', 8, 200, 7);
        SetFilterNM(#Filtr_SbBan);
        BitOnW(wFilter,2);
      }
   }
   //------------
   #Filtr_PlatVed:
   { //#1932 - просят сбрасывать пометку перед выбором
     //CopyMarker(Marker_Tmp,Marker_PlatVed);
     ClearMarker(Marker_Tmp);
     if RunInterface(GP_TablVed,0,Marker_Tmp)<>cmCancel
     { CopyMarker(Marker_PlatVed,Marker_Tmp);
       SetFilterNM(#Filtr_PlatVed)
     }
   }
   end;//case CurField of
   ReReadRecord(#ZAR_USER);

} //cmPick:


cmDelOnProtect:
{  case CurField of
   //--------------
   #FiltrPodr:
   {
     PAF.ClearDepartmentFilter;
     ReReadRecord(#ZAR_USER);
     BitOffW(wFilter,1);
     //   UpdateFilter;
   }

   //------------
   #Filtr_KatPodr:
   { ClearMarker(Marker_KatPodr);
     SetFilterNM(#Filtr_KatPodr);
     BitOffW(wFilter,1);
   }
   //------------
   #Filtr_SbBan:
   { ClearMarker(Marker_SbBan);
     SetFilterNM(#Filtr_SbBan);
     BitOffW(wFilter,2);
   }
   //------------
   #Filtr_PlatVed:
   { ClearMarker(Marker_PlatVed);
     SetFilterNM(#Filtr_PlatVed)
   }
   end;
} //cmDelOnProtect:

cmOk:
{  StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Подготовка данных для отчета',0);
   if not FormDoc then message('Ошибки при формировании');
   StopVisual('',0);
   xlKillExcel;
   //CloseInterFace(cmDone);
}
end;
end.
