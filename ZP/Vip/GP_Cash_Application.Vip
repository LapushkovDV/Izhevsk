//------------------------------------
// Сбор данных
//------------------------------------
#undef GP_Cash_Application_Podr_Case
#declare GP_Cash_Application_Podr_Case (fld1,fld2)
     Case KATPODR.KOD
     WHEN 'Ветераны'  THEN #(fld1)
     WHEN '__ФИЗ ЛИЦ' THEN #(fld1)
     WHEN '_ФИЗ ЛИЦ'  THEN #(fld1)
     WHEN 'Вет'       THEN #(fld1)
     WHEN '_Студенты' THEN #(fld1)
     else #(fld2) END
#end
#undef GP_Cash_Application_Podr_Case_NDFL
#declare GP_Cash_Application_Podr_Case_NDFL (fld1,fld2)
    CASE SBBAN.Prefix
    WHEN 'R#Z' THEN #(fld1)
    WHEN 'R#A' THEN #(fld1)
    else
      Case KATPODR.KOD
      WHEN 'Ветераны'  THEN #(fld1)
      WHEN '__ФИЗ ЛИЦ' THEN #(fld1)
      WHEN '_ФИЗ ЛИЦ'  THEN #(fld1)
      WHEN 'Вет'       THEN #(fld1)
      WHEN '_Студенты' THEN #(fld1)
      else #(fld2) END
    END
#end

Function SborData:boolean;
var pUserId:comp;
    pUserName:string;
    wErr:word;
{ Result:=false;
  pUserId  :=UserID();
  pUserName:=UserName();
  //Платежные ведомости
#undef GP_Cash_Application_NPP
#declare GP_Cash_Application_NPP
    ,CASE WHEN COALESCE(KATPODR.Name,'''')='Ветераны' THEN 12 ELSE
       //если уволенный и тип формирования '0$Z'
       CASE WHEN ((COALESCE(Lschet.DatUv,#Date(0,0,0))>#Date(0,0,0))  and (:(wPeriod)<>1) and (PLATVED.PREFIX='0$Z') ) THEN 2 ELSE
         CASE PLATVED.PREFIX
         WHEN  '0$Z'  THEN 1 // на выдачу зарплаты
         WHEN  '0$ZM'	THEN 1 // на выдачу зарплаты
         WHEN  '0$A'	THEN 1 // на выдачу аванса
         WHEN  '0$D'	THEN 0 // ежемесячных пособий
         WHEN  '0$M'	THEN 0 //	ежемесячных пособий
         WHEN  '0$RD'	THEN 0 //	единовременных пособий
         WHEN  '0$V'	THEN 0 //	начислений и выплат
         WHEN  '0$U'	THEN 0 //	удержаний и выплат
         WHEN  '0#Z'	THEN 9 //	зарплаты по договорам
         WHEN  '0#A'	THEN 9 //	аванса по договорам
         WHEN  '0$O'	THEN 2 //	выплаты отпускных
         WHEN  '0$P'	THEN 0 //	премии с учетом КТУ
         WHEN  '0$AL'	THEN 8 //	выплаты алиментов
         WHEN  '0$B'	THEN 0 //	больничных листов
         WHEN  'VMp'	THEN 0 //	выплат межпериода
         WHEN  '0$PS'	THEN 5 //	подотчетных сумм
         WHEN  '000'  THEN 12 //		прочие
         ELSE 0
         //CASE PLATVED.PREFIX
         END
         //CASE WHEN Lschet.DatUv<>#Date(0,0,0)  THEN 2 ELSE
       END
     // CASE WHEN COALESCE(KATPODR.Name,'''')='Ветераны' THEN 12 ELSE
     END
#end
  _Try
  { var hStrFilter:longint;
    var hStrFilterV:longint;
    var Q: IQuery;
    hStrFilter :=0;
    hStrFilterV:=0;
    Q:=queryManager.createQuery(SQLQuery(
      select
         '' as Name//    :string "Наименование банка/выплаты"
        ,Sum(SPPLVED.SUMUD) as SumNeed //:double "Требуемая выплата"
        ,0 as Pa //     :word   "0 ведомости, 1 реестры"
        #GP_Cash_Application_NPP as NPP
       , SPPLVED.VidUD  as VidUD
       , SPPLVED.VidOpl as VidOpl
       , PlatVed.Prefix
       , 'Основная' as Zakaz
       , #comp(0) as cvPlan // :comp "Группа заказов"
       , #comp(0) as cRec   // "ссылка на документ"        ,
       , #Date(0,0,0) as DATAN
       , '' as NameVed
       ,#comp(0) as Nrec
       //--- аналитика
       ,0        as SIDE //Код среза аналитик
       ,0        as wKau //Код аналитики
       ,#Comp(0) as cKau //Аналитика

      From PlatVed
      inner join SPPLVED on SPPLVED.CPLATVED = PlatVed.Nrec
      inner join Lschet  on Lschet.Nrec = SPPLVED.cLsch
      left outer join KatPodr on KatPodr.Nrec = SPPLVED.cex
      inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
      where
          PLATVED.DFORM>=:(DTB)
      and PLATVED.DFORM<=:(DTE)
      and (:(wOpt_UDER)=0 or (not SPPLVED.VidUD in (185,186,187,191,188,189,190)) )
      %FilterP
      %FilterV
      and (ZU.POdrShare <> '+' or
        ( SPPLVED.cex in
           (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME)
        )
        )
      Group by
         PlatVed.Prefix, SPPLVED.VidUD, SPPLVED.VidOpl
         // при добавлении условий по Lschet в NPP пришлось добавить
        ,Lschet.DatUV //без этого запуск в галактике падает с сообщением
                      //Столбец "T$LSCHET.F$DATUV" недопустим в списке выбора, поскольку он не содержится ни в агрегатной  функции, ни в предложении GROUP BY.
        ,KATPODR.Name //без этого запуск в галактике падает с сообщением
                      //Столбец "T$KATPODR.F$NAME" недопустим в списке выбора, поскольку он не содержится ни в агрегатной  функции, ни в предложении GROUP BY.
        #GP_Cash_Application_NPP
    )); //queryManager.createQuery(SQLQuery(
    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and platved.cex ',Marker_KatPodr));
      sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and platved.cex ',DepList));
      timelog('GP_Cash_Application->SborData:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if IsBitCTW(wFilter,3)
    { sqlAddStr(hStrFilterV,iQBuilder.MakeCriteriaFromMarker(' and Platved.Nrec ',Marker_PlatVed));
      timelog('GP_Cash_Application->SborData:фильтр по ведомостям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));
    }
    if (hStrFilter<>0)
    {
      Q.setMacro('FilterP',hStrFilter);
      sqlFreeStr(hStrFilter);
    }
    if (hStrFilterV<>0)
    {
      Q.setMacro('FilterV',hStrFilterV);
      sqlFreeStr(hStrFilterV);
    }

    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса 1 при отборе значений ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
      timelog('SborData этап 1 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса 001 '+ExploreException);
  }
  _finally
  {
  }
  Result:=true;

  //-------------------------------------------
  // Реестры
  //-------------------------------------------
/*
RV	начислений и выплат
RU	удержаний и выплат
R$A	на выдачу аванса
RD	ежемесячных пособий
RRD	единовременных пособий
R#Z	зарплаты по договорам
R#A	аванса по договорам
RO	выплаты отпускных
RP	премии с учетом КТУ
RB	больничных листов
R$Z	по итогам расчета ЗП
S$	налогов на ФОТ
*/
#undef GP_Cash_Application_NPP
#undef GP_Cash_Application_Name
#declare GP_Cash_Application_Name
    CASE  when KatPodr.Kod='446' then 'КЛИН'
          when GR_KatOrg.Name='Индивидуальный счет' THEN 'ИНД.СЧЕТ'
          when GR_KatOrg.Name='Индивидуальный (зарплатный)' THEN 'ИНД.СЧЕТ'
          when GR_KatOrg.Name='1. Индивидуальный (зарплатный)' THEN 'ИНД.СЧЕТ'
          when InStr('РОСБАНК',UPPER(KatBank.Name),1)>0  then 'РОСБАНК'
          when InStr('ГАЗПРОМ',UPPER(KatBank.Name),1)>0
            or InStr(' ГПБ',UPPER(KatBank.Name),1)>0
            //or InStr('ГАЗПРОМ',UPPER(SbBan.Name),1)>0
             then 'ГАЗПРОМ' //"АО "Газпромбанк""
          when InStr('ВТБ',UPPER(KatBank.Name),1)>0 THEN 'ВТБ'      // ВТБ
          when InStr('ПРОМСВЯЗ',UPPER(KatBank.Name),1)>0 THEN 'ПРОМСВ'      // ПромСвязьБанк
          when InStr('СБЕРБАНК',UPPER(KatBank.Name),1)>0 then 'Сбербанк'
          else 'ИНД.СЧЕТ' END
#end
#declare GP_Cash_Application_NPP
   CASE WHEN PERSONS.DDOP1>=:(DTB) THEN 5
   ELSE
     CASE
     when SPPLBAN.VidUd =186 or SPPLBAN.VidUd=187 or sbban.prefix='R$AL' THEN 4
     ELSE
       CASE
        when sbban.prefix='RO' then 50
        when sbban.prefix='RB' then 62
        when (sbban.Datan = :(DT_Period) ) and (SPPLBAN.VidUd=229) then 1 // #EM-55
        when sbban.Datan> :(DT_Period) then 2
        when ( :(wPeriod)=0 and sbban.prefix='R$A')
          or ( :(wPeriod)=1 and sbban.prefix='R$Z') then 1
       else 2//все остальное на зарплату
       END
     END
   END
#end
  _try
  {
    var hStrFilter :longint;
    var hStrFilterR:longint;
    var Q: IQuery;
    hStrFilter :=0;
    hStrFilterR:=0;
    // Весь межпериод можно поймать по  and SbBan.cSbBan<>#Comp(0)
    Q:=queryManager.createQuery(SQLQuery(
    Select
        #GP_Cash_Application_Name
         as  Name //   :string "Наименование банка/выплаты"
      ,Sum(SPPLBAN.SUMOPL)  SumNeed //:double "Требуемая выплата"
      ,1 Pa    //  :word   "0 ведомости, 1 реестры"
      ,#GP_Cash_Application_NPP
        as NPP     //:word
      ,SPPLBAN.VidUd  VidUd //:word
      ,SPPLBAN.VidOpl VidOpl //:word
      ,sbban.prefix Prefix  //:word
      ,SubString(COALESCE(vPlan.Name,'Основная'),1,100) as Zakaz
      ,COALESCE(vPlan.Nrec,#comp(0)) as cvPlan // :comp "Группа заказов"
      , #comp(0) as cRec   // "ссылка на документ"        ,
      , sbban.Datan as DATAN
      , '' as NameVed
      ,#comp(0) as Nrec
       //--- аналитика
       ,0        as SIDE //Код среза аналитик
       ,0        as wKau //Код аналитики
       ,#Comp(0) as cKau //Аналитика
       ,coalesce(nplat.kodplat,'') as  kodplat
    From SbBan
    inner join KatBank on KatBank.Nrec   = SbBan.cBankPol
    inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
    inner join Persons on Persons.Nrec = SPPLBAN.tPerson
    inner join KatPodr on KatPodr.Nrec = Lschet.Cex // SPPLBAN.CEX пустой!
    left join nplat    on nplat.nrec = sbban.cplat //coalesce(nplat.kodplat,'') as  kodplat
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    Left Outer join AttrVal on AttrVal.cAttrNam=:(ATTR_SB_VPLAN)
                    and AttrVal.wTable = 16060
                    and AttrVal.cRec   = SbBan.Nrec
    Left Outer join vPlan on vPlan.Nrec= AttrVal.vComp
    Left Outer join (select Descriptors.cRec, Min(Groups.Name) as Name
      from KatOrgDescr Descriptors
      Left Outer join  KatOrgDescr Groups on Groups.NRec = Descriptors.cGroup
      group by Descriptors.cRec
      ) GR_KatOrg   on GR_KatOrg.cRec = SbBan.cPol
    where
    //    SbBan.DATOK>=:(DTB) //дата выплаты
    //and SbBan.DATOK<=:(DTE) //дата выплаты
        SbBan.DForm>=:(DTB) //дата выплаты
    and SbBan.DForm<=:(DTE) //дата выплаты
    and SBBAN.VidUd not in (182,183,184,17,55,56,57) // не подоходный
    //17.01.2017
    //3. В выборке данных не должны участвовать реестра с типом "ДОГП" - по договорам подряда.
    and SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A'
    // Не фот
    and SBBAN.Prefix<>'S$'
    and SBBAN.Prefix<>'R$$' //объединенный
    and (:(wOpt_UDER)=0 or (not SPPLBAN.VidUd in (185,186,187,191,188,189,190)) )
     %Filter
     %FilterR
    and (ZU.POdrShare <> '+'
      or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    Group by
      #GP_Cash_Application_Name
     ,PERSONS.DDOP1
     ,SPPLBAN.VidUd
     ,SPPLBAN.VidOpl
     ,sbban.prefix
     ,#GP_Cash_Application_NPP
     ,SubString(COALESCE(vPlan.Name,'Основная'),1,100)
     ,COALESCE(vPlan.Nrec,#comp(0))  // :comp "Группа заказов"
     ,sbban.Datan
     , nplat.kodplat
    )); //queryManager.createQuery(SQLQuery(
    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',Marker_KatPodr));
      sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',DepList));
      timelog('GP_Cash_Application->SborData:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_KatPodr));

    }
    if IsBitCTW(wFilter,2)
    { sqlAddStr(hStrFilterR,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Nrec ',Marker_SbBan));
      timelog('GP_Cash_Application->SborData:фильтр по реестрам hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    {
      Q.setMacro('Filter',hStrFilter);
      sqlFreeStr(hStrFilter);
    }
    if (hStrFilterR<>0)
    {
      Q.setMacro('FilterR',hStrFilterR);
      sqlFreeStr(hStrFilterR);
    }
    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса 2 при отборе значений ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
      timelog('SborData этап 2 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса 002 '+ExploreException);
  }
  _finally
  {
  }
  //----------------------------------
  if wOpt_UDER>0
  { //185 Алименты через кассу
    //186 Алименты почтой
    //187, 191 Удержания алиментов в банк
    //188 Удержания по исполнительным листам через банк
    //189 Сбор по перечислению алиментов
    //190 Удержания по исполнительным листам - почтой
    _try
    {
      var _sTable:string='';
      var _Fld_Ud:string='';
      if wMonth=MonthRas and wYear=YearRas
      {  _sTable:='UDER';
         _Fld_Ud:='VidUds';
      }
      else
      {  _sTable:='SUMVIDUD';
         _Fld_Ud:='VidUd';
      }
      PrepareSQLQuery('Select ');
      PrepareSQLQuery('     ''''   as  Name'); // 1  :string "Наименование банка/выплаты"
      PrepareSQLQuery(',Sum(UDER.SUMUD) as  SumNeed'); // 2 :double "Требуемая выплата"
      PrepareSQLQuery(',CASE when UDER.'+_Fld_Ud+'=185 THEN 0 ELSE 1 END as Pa');  //3  :word   "0 ведомости, 1 реестры"
      PrepareSQLQuery(',CASE when UDER.'+_Fld_Ud+'=185 THEN 8 else 4 END as NPP');     //4 :word
      PrepareSQLQuery(',UDER.'+_Fld_Ud+' as VidUd ');//5 :word
      PrepareSQLQuery(',0 as VidOpl ');//6 :word
      PrepareSQLQuery(',''R$AL'' as Prefix ');  //7 :word
      PrepareSQLQuery(',''Основная'' as Zakaz '); //8
      PrepareSQLQuery(',#comp(0) as cvPlan ');// 9 :comp "Группа заказов"
      PrepareSQLQuery(',#comp(0) as cRec   ');//10 "ссылка на документ"        ,
      PrepareSQLQuery(',#date(1,'+string(wMonth)+','+string(wYear)+') as DATAN'); //11 #(DT_Period)
      PrepareSQLQuery(','' '' as NameVed');
      PrepareSQLQuery(',UDER.cLsch as Nrec');
       //--- аналитика
      PrepareSQLQuery(',0        as SIDE'); //Код среза аналитик
      PrepareSQLQuery(',0        as wKau'); //Код аналитики
      PrepareSQLQuery(',#Comp(0) as cKau'); //Аналитика
      PrepareSQLQuery('From '+_sTable+' UDER');
      PrepareSQLQuery('inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = '''+PUserName+''') ');
      if Zar_User.POdrShare = '+'
      { PrepareSQLQuery('inner join USERRIGHTS UR on UR.crecds=UDER.cexoz and UR.OWNNAME= ZU.OWNNAME  ' );
      }
      if IsBitCTW(wFilter,1)
      { PrepareSQLQuery(' inner join tempvib VibPodr on VibPodr.wlist=1 and VibPodr.crec = Uder.cexoz ');

      }
      PrepareSQLQuery('where Uder.'+_Fld_Ud+' in(185,186,187,191,188,189,190)');
      PrepareSQLQuery('and UDER.SumUd<>0');
      PrepareSQLQuery('and UDER.MesN  ='+string(wMonth));
      PrepareSQLQuery('and UDER.YearN ='+string(wYear));
      PrepareSQLQuery('Group by');
      PrepareSQLQuery('  UDER.'+_Fld_Ud);
      PrepareSQLQuery(' ,UDER.cLsch');
      PrepareSQLQuery(' ,CASE when UDER.'+_Fld_Ud+' =185 THEN 0 ELSE 1 END');
      PrepareSQLQuery(' ,CASE when UDER.'+_Fld_Ud+' =185 THEN 8 else 4 END');
      stmt:=0;
      stmt := sqlAllocStmt;
      wErr:=ExecDSQLex(tntmp_prn_cash);
      ReReadRecord(#tmp_prn_cash);
      timelog('SborData этап 3 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));

    }
    _except
    else
    { timelog('Возникло исключение при запуске запроса 003 '+ExploreException);
    }
    _finally
    {
    }
  } //if wOpt_UDER>0
  delete all tmp_prn_zakaz;
  _Loop fullcache tmp_prn_cash
  { //удалим все меньше 0
    if tmp_prn_cash.SumNeed<0
    { delete current tmp_prn_cash;
      continue;
    } //if tmp_prn_cash.SumNeed<0

    if getfirst tmp_prn_zakaz where (( tmp_prn_cash.Zakaz == tmp_prn_zakaz.Zakaz )) =tsok continue;
    Insert into tmp_prn_zakaz
     set tmp_prn_zakaz.Zakaz:=tmp_prn_cash.Zakaz
      , tmp_prn_zakaz.pa:=if(tmp_prn_cash.Zakaz='Основная',0,1)
     ;
  }
} //Function SborData:boolean;


//------------------------------------
//заменить запрещенные символы
//------------------------------------
Function ReplSymbol(_w:string):string;
{ Result:=replace(_w,'\','') ;
  Result:=replace(Result,'/','');
  Result:=replace(Result,'_','');
  Result:=replace(Result,'.','');
  Result:=replace(Result,':','');
}
//------------------------------------
//получить краткое название месяца
//------------------------------------
Function GetShotMon(ww_str:string):string;
{ Result:=ww_str;
  if Length(ww_str)<6 exit;
  case ww_str of
  'январь'   : Result:='янв.';
  'февраль'  : Result:='фев.';
  'апрель'   : Result:='апр.';
  'август'   : Result:='авг.';
  'сентябрь' : Result:='сент.';
  'октябрь'  : Result:='окт.';
  'ноябрь'   : Result:='ноябрь';
  'декабрь'  : Result:='дек.';
  end;

} //Function GetShotMon(ww_str:string):string;


Function MyRound(w:double):double;
{ //Result:=Round(w+0.49,0);
  Result:=Round(w,2);
}

//-- определить период
Procedure GetPeriod;
{ wMonth:=month(DTE);
  wYear :=Year(DTE);
  if wPeriod=1 //Day(DTE)<=15// Предыдущий месяц
  { wMonth:=wMonth-1;
    if wMonth=0
    { wYear:=wYear-1;
      wMonth:=12;
    }
  }
} //Procedure GetPeriod;

//------------------------------------
//Печать данных
//------------------------------------
Function PrintDoc(_Zakaz:string;boFirst:boolean):boolean;
var maxColCount:word;
    ww_str:string;
    ww_otp:string;
    ww_zar:string;
    ww_sdvig:word;
    isAllOk:boolean;
    ww_DT:date;
    ww_DT_P:date;
{ Result:=false;
  ww_str:='';
  //надо добавить лист
  if not boFirst
  {     xlSetActiveSheet(1);
        xlAddSheet;
        xlSetActiveSheet(1);
        xlSetSheetName(1,_Zakaz);
        SetPaperParam;
        if not xlSetActiveSheet(kol_List)
        { message('Ошибка установки листа с форматом!');
        }
        xlCopyToBuff(1, 1, 63,13);
        //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
        xlSetActiveSheet(1);
        // только в таком порядке. В рабочей папке можно создать Excel.log
        xlPasteAllFromBuff(1, 1, 63,13);
        xlPasteFormatFromBuff(1, 1, 63,13);
        //чтобы снять выделение после вставки
        xlCopyToBuff(1, 1, 1,1);
        xlPasteAllFromBuff(1, 1, 1,1);
        SetPaperParam;

  }
  else
  { xlSetSheetName(1,_Zakaz);
  }
//-----
  // ширины столбцов не скопировались
  xlSetColumnWidth(03,1,01,50,01);//01
  xlSetColumnWidth(07,1,02,50,02);//02
  xlSetColumnWidth(09,1,03,50,03);//03
  xlSetColumnWidth(05,1,04,50,04);//04
  xlSetColumnWidth(05,1,05,50,05);//05
  xlSetColumnWidth(13,1,06,50,06);//06
  xlSetColumnWidth(03,1,07,50,07);//07
  xlSetColumnWidth(09,1,08,50,08);//08
  xlSetColumnWidth(09,1,09,50,09);//09
  xlSetColumnWidth(09,1,10,50,10);//10
  xlSetColumnWidth(05,1,11,50,11);//11
  xlSetColumnWidth(13,1,12,50,12);//12
  xlSetColumnWidth(09,1,13,50,13);//13
//--------------------------------------
  matrixkl:=false;
  //------------------------
  GetPeriod;
  //------------------------
  ww_DT:=DATE(1,wMonth,wYear);
  ww_DT_P:=DT_Period;
  isAllOk:=true;
  ww_zar:=if(wPeriod=0,'аванс за 1  половину '+DateToStr(ww_DT_P,'mon YYYY'),'з/п за '+DateToStr(ww_DT_P,'month YYYY'));
  ww_otp:='Отпуска - '+GetShotMon(DateToStr(DT_Period,'month'))
     +','+GetShotMon(DateToStr(Add_Months(DT_Period,1),'month'));
  //---------------------
  wexrow:=5;
  wexcol:=10;
  MyPutExcel(MyGetInitial(My_Sclonenie(sFioZGD,23),False),12,0,-1,-1); //

  wexrow:=64;
  wexcol:=12;
  MyPutExcel(MyGetInitial(sMainBuh,False),12,0,-1,-1); //

  wexrow:=65;
  wexcol:=3;
  MyPutExcel(MyGetInitial(sFioUser,True)+if(sTelUser<>'',', '+sTelUser,''),12,0,-1,-1); //

  wexrow:=66;
  wexcol:=3;
  MyPutExcel(chr(13)+DateToStr(cur_date,'DD.MM.YYYY'),12,0,-1,-1); //

  //проставим сразу сумму по банкам
  wexrow:=30;
  wexcol:=2;
  MyPutExcel(ww_zar,9,0,-1,-1); //
  wexcol:=8;
  MyPutExcel(ww_zar,9,0,-1,-1); //

  wexrow:=33;
  wexcol:=2;
  MyPutExcel(ww_otp,9,0,-1,-1); //
  wexcol:=8;
  MyPutExcel(ww_otp,9,0,-1,-1); //

  wexrow:=40;
  wexcol:=8;
  MyPutExcel(ww_otp,9,0,-1,-1); //

  wexrow:=39;
  wexcol:=2;
  MyPutExcel(ww_zar,9,0,-1,-1); //
  wexcol:=8;
  MyPutExcel(ww_zar,9,0,-1,-1); //

  wexrow:=42;
  wexcol:=2;
  MyPutExcel(ww_otp,9,0,-1,-1); //

  wexrow:=43;
  wexcol:=8;
  MyPutExcel(ww_zar,9,0,-1,-1); //

  wexrow:=46;
  wexcol:=8;
  MyPutExcel(ww_otp,9,0,-1,-1); //

  wexrow:=48;
  wexcol:=2;
  MyPutExcel(ww_zar,9,0,-1,-1); //

  wexrow:=51;
  wexcol:=2;
  MyPutExcel(ww_otp,9,0,-1,-1); //

  wexrow:=57;
  wexcol:=2;
  MyPutExcel(ww_zar,9,0,-1,-1); //

  wexrow:=60;
  wexcol:=2;
  MyPutExcel(ww_otp,9,0,-1,-1);

  //-------------------
  wexrow:=7;
  wexcol:=2;
  case wPeriod of
  0: ww_str:='Прошу Вас дать указание на выплату аванса за '+DateToStr(ww_DT_P,'MM.YYYY г.') ;
  1: ww_str:='Прошу Вас дать указание на выплату з/п за '+DateToStr(ww_DT_P,'MM.YYYY г.') ;
  2: ww_str:='Прошу Вас дать указание на выплату окончательного расчета и отпускных за '+DateToStr(DTE,'MM.YYYY г.');
  end;
  // в шаблоне xlMergeCells(wexrow,2, wexrow,12); //
  MyPutExcel(ww_Str,11,0,-1,-1); //

  wexrow:=8;
  wexcol:=2;
  ww_Str:=+' по ' + sGetTune('MYORG') + ' "'+_Zakaz+ '", в следующем объеме ';
  // в шаблоне xlMergeCells(wexrow,2, wexrow,12); //
  MyPutExcel(ww_Str,11,0,-1,-1); //

  wexrow:=9;
  wexcol:=2;
  ww_str:='Дата выплаты '+DateToStr(DTAppl, 'DD.MM.YYYY');
  // в шаблоне xlMergeCells(wexrow,2, wexrow,12); //
  MyPutExcel(ww_Str,11,0,-1,-1); //

  wexrow:=12;
  wexcol:=2;

  ww_str:=if(wPeriod=0,'аванс за 1 половину '+DateToStr(ww_DT,'mon YYYY'),'з/плата '+'за '+DateToStr(ww_DT_P,'month YYYY')) ;
  MyPutExcel(ww_Str,11,0,-1,-1); //

  wexrow:=13;
  wexcol:=2;
  ww_str:='Увольнение, отпуск - '+DateToStr(ww_dt_P,'month')+', '+DateToStr(add_months(ww_DT_P,1),'month YYYY');
  MyPutExcel(ww_Str,11,0,-1,-1); //

  ww_sdvig:=0;
  excel_Null_Need:=True;
  //-------------------------------------------
  // чтобы иметь возможность прерваться
  do {
    MyLogWrite(false,'== ВСЕ  ==');

    //-- вывод по ведомостям
    MyLogWrite(false,'== ВЕДОМОСТИ  ==');

    _Loop fullcache tmp_prn_cash where (( _Zakaz == tmp_prn_cash.Zakaz
     and  0 == tmp_prn_cash.Pa )) ordered by index tmp_prn_cash01
    { if not NextVisual then break;
      if tmp_prn_cash.NPP=0
      { case tmp_prn_cash.VidUd of
        //1	з/плата за 1 половину месяца 2017
        220,229,180: tmp_prn_cash.NPP:=1; // #EM-55
        //2	Увольнение, отпуск - февраля, марта 2017
        //3	премия
        196://4	Командировки
          tmp_prn_cash.NPP:=4;
        //5	Хозяйственные нужды
        //6	Депоненты
        //7	Увечья
        186: //8	Алименты
          tmp_prn_cash.NPP:=8;
        //9	Договора подряда
        //10	Ссуда
        //11	Командировочные расходы
        //181://12	Прочие выплаты - мат.пом. Ветеранам
        // говорят надо в 1 или во 2 строку  tmp_prn_cash.NPP:=12;
        end;
        if tmp_prn_cash.NPP=0
        { if getfirst klvidopl where (( tmp_prn_cash.VidOpl == klvidopl.vidopl ))=tsok
          { if pos('премия',loCase(KLVIDOPL.NVIDOPL))>0
              tmp_prn_cash.NPP:=3;
            if pos('отпуск',loCase(KLVIDOPL.NVIDOPL))>0
              tmp_prn_cash.NPP:=50;
          }
        } //if tmp_prn_cash.NPP=0
        // Здесь можно включить по видам оплат
        if tmp_prn_cash.NPP=0
        {
          case tmp_prn_cash.VidOpl of
          //1	з/плата за 1 половину месяца 2017
          87://2	Увольнение, отпуск - февраля, марта 2017
            tmp_prn_cash.NPP:=2;
          //3	премия
          //4	Командировки
          //5	Хозяйственные нужды
          //6	Депоненты
          //7	Увечья
          //8	Алименты
          //9	Договора подряда
          //10	Ссуда
          //11	Командировочные расходы
          //12	Прочие выплаты - мат.пом. Ветеранам
          end;
          if tmp_prn_cash.Npp=0
          { //tmp_prn_cash.Npp:=if(wPeriod=2,2,1);
            //что то не понятно, то одно то другое
            //В параметрах выбираем "1 половина месяца". В заявке платежные ведомости
            //на аванс и платежная ведомость межпериода "Объединились в 1-ю строку"
            tmp_prn_cash.Npp:=2;
          }
        } //if tmp_prn_cash.NPP=0
        update current tmp_prn_cash;
      }
      MyLogWrite(false,'NPP='+string(tmp_prn_cash.NPP)+',VidUd='+string(tmp_prn_cash.VidUd)
                  +',VidOpl='+string(tmp_prn_cash.VidOpl)
                  +',SumNeed='+string(tmp_prn_cash.SumNeed,0,2)
                  );

      if tmp_prn_cash.NPP=0 then continue;
      if getfirst tmp_prn_cash01 where (( _Zakaz == tmp_prn_cash01.Zakaz and 3 == tmp_prn_cash01.pa
            and  tmp_prn_cash.NPP == tmp_prn_cash01.NPP )) <>tsok
      { clearbuffer(#tmp_prn_cash01);
        tmp_prn_cash01.PA     :=3;
        tmp_prn_cash01.NPP    :=tmp_prn_cash.NPP;
        tmp_prn_cash01.SumNeed:=tmp_prn_cash.SumNeed;
        tmp_prn_cash01.Zakaz  :=_Zakaz;
        insert current tmp_prn_cash01;
      }
      else update current tmp_prn_cash01 set tmp_prn_cash01.SumNeed:=tmp_prn_cash01.SumNeed + tmp_prn_cash.SumNeed;
    } //_Loop fullcache tmp_prn_cash where (( 0 == tmp_prn_cash.Pa))
    //обнулим
    for(ww_sdvig:=1;ww_sdvig<=12;ww_sdvig++)
    { wexrow:=11+ww_sdvig;
      wexcol:=12;
      MyPutExcelNumber(0,2,10,0,-1,-1);
    }
    // выводим на печать
    _Loop tmp_prn_cash01 where (( _Zakaz == tmp_prn_cash01.Zakaz and 3 == tmp_prn_cash01.pa ))
    { wexrow:=11+tmp_prn_cash01.NPP;
      wexcol:=12;
      MyPutExcelNumber(MyRound(tmp_prn_cash01.SumNeed),2,10,0,-1,-1);
      tmp_prn_zakaz.Su_kassa:=tmp_prn_zakaz.Su_kassa+tmp_prn_cash01.SumNeed;
    } //_Loop tmp_prn_cash01 where (( 3 == tmp_prn_cash.pa ))
    if _Zakaz='Основная'
    { wexrow:=11+6;
      wexcol:=12;
      MyPutExcelNumber(MyRound(fDeponent),2,10,0,-1,-1);
    }

    //---------------------------------
    //Реестры
    var _wnpp:word=0;
    var _dmsu:array [1..100] of double;
    for(_wNpp:=1;_wNpp<=100;_wNpp++) _dmsu[_wNpp]:=0;
    MyLogWrite(false,'== РЕЕСТРЫ  ==');

    _Loop tmp_prn_cash where (( _Zakaz == tmp_prn_cash.Zakaz and 1 == tmp_prn_cash.pa ))
    { if tmp_prn_cash.Npp = 4 //Алименты
      { _dmsu[24]:=_dmsu[24]+tmp_prn_cash.SumNeed;
        MyLogWrite(false,'Алименты NPP='+string(tmp_prn_cash.NPP)+',VidUd='+string(tmp_prn_cash.VidUd)
                  +',VidOpl='+string(tmp_prn_cash.VidOpl)
                  +',SumNeed='+string(tmp_prn_cash.SumNeed,0,2)
                  +',Prefix='+tmp_prn_cash.Prefix
                  );
        continue;
      }
      if tmp_prn_cash.Npp = 5 //Под расчет умершему
      { _dmsu[25]:=_dmsu[25]+tmp_prn_cash.SumNeed;
        MyLogWrite(false,'Под расчет умершему NPP='+string(tmp_prn_cash.NPP)+',VidUd='+string(tmp_prn_cash.VidUd)
                  +',VidOpl='+string(tmp_prn_cash.VidOpl)
                  +',SumNeed='+string(tmp_prn_cash.SumNeed,0,2)
                  +',Prefix='+tmp_prn_cash.Prefix
                  );
        continue;
      }
      /*
      if trim(tmp_prn_cash.Name)='ИНД.СЧЕТ' //
      {
           case tmp_prn_cash.kodplat of
            '1': _dmsu[23]:=_dmsu[23]+tmp_prn_cash.SumNeed;
            '2': _dmsu[23+31]:=_dmsu[23+31]+tmp_prn_cash.SumNeed;
             else _dmsu[_wnpp+tmp_prn_cash.Npp]:=_dmsu[_wnpp+tmp_prn_cash.Npp]+tmp_prn_cash.SumNeed
            end;


//        _dmsu[23]:=_dmsu[23]+tmp_prn_cash.SumNeed;
        MyLogWrite(false,'!!! ИНД.СЧЕТ NPP='+string(tmp_prn_cash.NPP)+',VidUd='+string(tmp_prn_cash.VidUd)
                  +',VidOpl='+string(tmp_prn_cash.VidOpl)
                  +',SumNeed='+string(tmp_prn_cash.SumNeed,0,2)
                  +',Prefix='+tmp_prn_cash.Prefix
                  );

        continue;
      }
      */      //--------------------------
      if ((tmp_prn_cash.Npp=0 or tmp_prn_cash.Npp>2) and tmp_prn_cash.Npp<>50) and tmp_prn_cash.Npp<>62 Continue;
      _wnpp:=0;
      CASE trim(tmp_prn_cash.Name) of
      'КЛИН' :
      { _wnpp:=15;
      }
      'РОСБАНК':
      { _wnpp:=0;

      }
      'ГАЗПРОМ':
      { _wnpp:=5;
      }
      'Сбербанк':
      { _wnpp:=10;
      }
      'ВТБ':
      { _wnpp:=25;
      }
      'ПРОМСВ': // промсвязьбанк
      { _wnpp:=7;
      }
      else //continue;
       {
        if trim(tmp_prn_cash.Name)='ИНД.СЧЕТ' //
         {
          _wnpp:=20;
         }
         else
         {
          continue;
         }
       }
      end;
      MyLogWrite(false,tmp_prn_cash.Name+' NPP='+string(tmp_prn_cash.NPP)+',VidUd='+string(tmp_prn_cash.VidUd)
                  +',VidOpl='+string(tmp_prn_cash.VidOpl)
                  +',SumNeed='+string(tmp_prn_cash.SumNeed,0,2)
                  +',Prefix='+tmp_prn_cash.Prefix
                  +',DATAN='+DateTOSTR(tmp_prn_cash.DATAN,'DD.MM.YYYY')
                  );
      case _wnpp of
        0,5,10,20,7,25:
         {
           //0 rosbank
           //5 gazprombank
           //10 Sberbank
           // 20 individ
           // 7 промсвязьбанк
           // 25 втб
           case tmp_prn_cash.kodplat of
            '1': _dmsu[_wnpp+tmp_prn_cash.Npp]:=_dmsu[_wnpp+tmp_prn_cash.Npp]+tmp_prn_cash.SumNeed
            '4': _dmsu[_wnpp+tmp_prn_cash.Npp+31]:=_dmsu[_wnpp+tmp_prn_cash.Npp+31]+tmp_prn_cash.SumNeed
             else _dmsu[_wnpp+tmp_prn_cash.Npp]:=_dmsu[_wnpp+tmp_prn_cash.Npp]+tmp_prn_cash.SumNeed
            end;
         }
       else
        _dmsu[_wnpp+tmp_prn_cash.Npp]:=_dmsu[_wnpp+tmp_prn_cash.Npp]+tmp_prn_cash.SumNeed;
        end;
      tmp_prn_zakaz.Su_Bank:=tmp_prn_zakaz.Su_Bank+tmp_prn_cash01.SumNeed;
    } //_Loop tmp_prn_cash01 where (( 1 == tmp_prn_cash.pa ))

    //---------------------------------------
    //'КЛИН'
    wexrow:=39;wexcol:=12;
    MyPutExcelNumber(_dmsu[16],2,9,0,-1,-1);
    wexrow:=40;wexcol:=12;
    MyPutExcelNumber(_dmsu[17]+_dmsu[65]+_dmsu[77],2,9,0,-1,-1);
//'РОСБАНК':
    wexrow:=30;wexcol:=6;
    MyPutExcelNumber(_dmsu[1],2,9,0,-1,-1);    // ЗП
    wexrow:=31;wexcol:=6;
    MyPutExcelNumber(_dmsu[2+31],2,9,0,-1,-1); //пособия, компенс.

    wexrow:=33;wexcol:=6;
    MyPutExcelNumber(_dmsu[50],2,9,0,-1,-1);    // отп уволь
    wexrow:=34;wexcol:=6;
    MyPutExcelNumber(_dmsu[2],2,9,0,-1,-1); //Увольнение
    wexrow:=35;wexcol:=6;
    MyPutExcelNumber(_dmsu[62],2,9,0,-1,-1); //Больничные

//'ГАЗПРОМ':
    wexrow:=30;wexcol:=12;
    MyPutExcelNumber(_dmsu[6],2,9,0,-1,-1); // ЗП
    wexrow:=31;wexcol:=12;
    MyPutExcelNumber(_dmsu[7+31],2,9,0,-1,-1); //пособия, компенс.

    wexrow:=33;wexcol:=12;
    MyPutExcelNumber(_dmsu[55],2,9,0,-1,-1); // отп уволь
    wexrow:=34;wexcol:=12;
    MyPutExcelNumber(_dmsu[7],2,9,0,-1,-1); //Увольнение
    wexrow:=35;wexcol:=12;
    MyPutExcelNumber(_dmsu[67],2,9,0,-1,-1); //Больничные

    //'Сбербанк':
    wexrow:=39;wexcol:=6;
    MyPutExcelNumber(_dmsu[11],2,9,0,-1,-1);
    wexrow:=40;wexcol:=6;
    MyPutExcelNumber(_dmsu[12+31],2,9,0,-1,-1); //пособия, компенс.

    wexrow:=42;wexcol:=6;
    MyPutExcelNumber(_dmsu[60],2,9,0,-1,-1);
    wexrow:=43;wexcol:=6;
    MyPutExcelNumber(_dmsu[12],2,9,0,-1,-1); //Увольнение
    wexrow:=44;wexcol:=6;
    MyPutExcelNumber(_dmsu[72],2,9,0,-1,-1); //Больничные

    //---------------------------------------
    //Индивидуальный счет
    wexrow:=43;wexcol:=12;
    MyPutExcelNumber(_dmsu[21],2,9,0,-1,-1); // зп
    wexrow:=44;wexcol:=12;
    MyPutExcelNumber(_dmsu[22+31],2,9,0,-1,-1);   //пособия, компенс

    wexrow:=46;wexcol:=12;
    MyPutExcelNumber(_dmsu[70],2,9,0,-1,-1); // отпуска
    wexrow:=47;wexcol:=12;
    MyPutExcelNumber(_dmsu[22],2,9,0,-1,-1);   //Увольнение
    wexrow:=48;wexcol:=12;
    MyPutExcelNumber(_dmsu[82],2,9,0,-1,-1); //Больничные

        //'ПромСвязьБанк':
    wexrow:=48;wexcol:=6;
    MyPutExcelNumber(_dmsu[8],2,9,0,-1,-1);
    wexrow:=49;wexcol:=6;
    MyPutExcelNumber(_dmsu[9+31],2,9,0,-1,-1); //пособия, компенс.

    wexrow:=51;wexcol:=6;
    MyPutExcelNumber(_dmsu[57],2,9,0,-1,-1);
    wexrow:=52;wexcol:=6;
    MyPutExcelNumber(_dmsu[9],2,9,0,-1,-1); //Увольнение
    wexrow:=53;wexcol:=6;
    MyPutExcelNumber(_dmsu[69],2,9,0,-1,-1); //Больничные

        //'ВТБ':
    wexrow:=57;wexcol:=6;
    MyPutExcelNumber(_dmsu[26],2,9,0,-1,-1);
    wexrow:=58;wexcol:=6;
    MyPutExcelNumber(_dmsu[27+31],2,9,0,-1,-1); //пособия, компенс.

    wexrow:=60;wexcol:=6;
    MyPutExcelNumber(_dmsu[75],2,9,0,-1,-1);
    wexrow:=61;wexcol:=6;
    MyPutExcelNumber(_dmsu[27],2,9,0,-1,-1); //Увольнение
    wexrow:=62;wexcol:=6;
    MyPutExcelNumber(_dmsu[87],2,9,0,-1,-1); //Больничные



    //Алименты - банк
    wexrow:=51;wexcol:=12;
    MyPutExcelNumber(_dmsu[24],2,9,0,-1,-1);
    //Под расчет умершему
    wexrow:=52;wexcol:=12;
    MyPutExcelNumber(_dmsu[25],2,9,0,-1,-1);
  } while false ;

  Result:=true;
} //Function PrintDoc:boolean;


//-------------------------------------------------
// НДФЛ
//-------------------------------------------------
Function SborDataNDFL(_wTp:word):boolean;
var pUserId:comp;
    pUserName:string;
    wErr:word;
    wDog:word;
{ Result:=false;
  pUserId  :=UserID();
  pUserName:=UserName();
  // Договора
  wDog:=if(IsBitCtW(wOption,6),1,0);


  //-------------------------------------------
  // Реестры
  //-------------------------------------------
  _try
  {
    var hStrFilter,hStrFilterP,hStrFilterR:longint;
    var Q: IQuery;
    hStrFilter :=0;
    hStrFilterP:=0;
    hStrFilterR:=0;
    Q:=queryManager.createQuery(SQLQuery(
    Select

     //SubString(SbBan.name,1,9)    as  Name //  нужен только период!!! [01.2018]
     #GP_Cash_Application_Podr_Case_NDFL(SpPlBan.Fio,'')  as Name
    ,Sum(SPPLBAN.SUMOPL)  SumNeed //:double "Требуемая выплата"
    ,101 Pa    //  :word   "0 ведомости, 1 реестры"
    //1 касса, 2 - банк
    //,CASE WHEN COALESCE(PlVed.cLsch,#comp(0))=#comp(0) THEN 2 ELSE 1 END as NPP     //:word
    //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
    ,#GP_Cash_Application_Podr_Case_NDFL(1,2) as NPP
    ,0 VidUd //:word
    ,#GP_Cash_Application_Podr_Case_NDFL(SPPLBAN.VidOpl,0)  as  VidOpl //:word
    ,Max(sbban.prefix) Prefix  //:word
    ,SubString(COALESCE(vPlan.Name,'Основная'),1,100) as Zakaz
    ,CASE WHEN (SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
        THEN COALESCE(vPlan.Nrec,#comp(0))
        ELSE SPPLBAN.cLsch END  as cvPlan // :comp "Группа заказов"
    ,SbBan.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
    ,SbBan.DATAN  as Datan
//Нужно обойти ситуацию
//[05.2018] НДФЛ УФК по МО (Межрайонная ИФНС  Рос...[КПП:504701001,ОКТМО:46783000]
//[05.2018] НДФЛ "УФК по МО (Межрайонная ИФНС  Ро...[КПП:504701001,ОКТМО:46783000]
    ,//REPLACE(REPLACE(REPLACE(REPLACE(SubString(SBBAN.NAME,1,40),'в банк',''),'"',''),' ',''),'[КПП','')+
      SubString(SBBAN.NAME,INSTR('[КПП:',SBBAN.NAME,1),200)
      as NameVed
     ,#GP_Cash_Application_Podr_Case_NDFL(SbBan.Nrec,#Comp(0)) as Nrec
       //--- аналитика
     ,SbBan.SIDE as SIDE //Код среза аналитик
     ,SbBan.wKau as wKau //Код аналитики
     ,SbBan.cKau as cKau //Аналитика
     , coalesce(nplat.kodplat,'') as  kodplat
    From SbBan
    //inner join KatBank on KatBank.Nrec   = SbBan.cBankPol
    inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
    inner join KatPodr on KatPodr.Nrec = Lschet.Cex
    left  join nplat    on nplat.nrec = sbban.cplat //coalesce(nplat.kodplat,'') as  kodplat
    // проверим что есть ведомость по человеку
    //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
    /*
    Left Outer join
    ( select SpPlved.cLsch as cLsch
      From PlatVed
      inner join SPPLVED on SPPLVED.CPLATVED = PlatVed.Nrec
      inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
      where
          PLATVED.DFORM>=:(DTB)
      and PLATVED.DFORM<=:(DTE)
      %FilterP
      and (ZU.POdrShare <> '+' or
        ( SPPLVED.cex in
           (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME)
        )
        )
      Group by
        SpPlved.cLsch
    ) Plved on PlVed.cLsch= SPPLBAN.cLsch
    */
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    Left Outer join AttrVal on AttrVal.cAttrNam=:(ATTR_SB_VPLAN)
                    and AttrVal.wTable = 16060
                    and AttrVal.cRec   = SbBan.Nrec
    Left Outer join vPlan on vPlan.Nrec= AttrVal.vComp
    where
    //    SbBan.DATOK>=:(DTB) //дата выплаты
    //and SbBan.DATOK<=:(DTE) //дата выплаты
        SbBan.DForm>=:(DTB) //дата выплаты
    and SbBan.DForm<=:(DTE) //дата выплаты
    and (SBBAN.VidUd in (182,183,184) ) // НДФЛ
    //17.01.2017
    //3. В выборке данных не должны участвовать реестра с типом "ДОГП" - по договорам подряда.
    and ((SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
      or 1=:(wDog)
      )
    // Не фот
    and SBBAN.Prefix<>'S$'
    //объединенный
    and SBBAN.Prefix<>'R$$'
     %Filter
     %FilterR
    and (ZU.POdrShare <> '+'
      or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    Group by
     //GP_Cash_Application_Podr_Case(SpPlBan.Fio,SubString(SbBan.name,1,9))
      #GP_Cash_Application_Podr_Case_NDFL(SpPlBan.Fio,'')
     ,SbBan.cBankPol
     ,SubString(COALESCE(vPlan.Name,'Основная'),1,100)
     ,CASE WHEN (SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
        THEN COALESCE(vPlan.Nrec,#comp(0))
        ELSE SPPLBAN.cLsch END  // :comp "Группа заказов"
     //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
     // ,CASE WHEN COALESCE(PlVed.cLsch,#comp(0))=#comp(0) THEN 2 ELSE 1 END  //as NPP     //:word
     ,#GP_Cash_Application_Podr_Case_NDFL(1,2)
     ,#GP_Cash_Application_Podr_Case_NDFL(SPPLBAN.VidOpl,0)
     ,SbBan.DATAN
     //#808.#77.#1 В заявке на перечисление НДФЛ должно быть столько листов сколько помечено реестров по НДФЛ
     ,#GP_Cash_Application_Podr_Case_NDFL(SbBan.Nrec,#Comp(0))
     ,SbBan.SIDE //Код среза аналитик
     ,SbBan.wKau //Код аналитики
     ,SbBan.cKau //Аналитика

     ,//REPLACE(REPLACE(REPLACE(REPLACE(SubString(SBBAN.NAME,1,40),'в банк',''),'"',''),' ',''),'[КПП','')+
      SubString(SBBAN.NAME,INSTR('[КПП:',SBBAN.NAME,1),200)
      , nplat.kodplat
     //,sbban.prefix
    )); //queryManager.createQuery(SQLQuery(
    //
    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',Marker_KatPodr));
      sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',DepList));
      sqlAddStr(hStrFilterP,iQBuilder.MakeCriteriaFromMarker(' and platved.cex ',DepList));
      timelog('GP_Cash_Application->SborDataNDFL:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if IsBitCTW(wFilter,2)
    { sqlAddStr(hStrFilterR,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Nrec ',Marker_SbBan));
      timelog('GP_Cash_Application->SborDataNDFL:фильтр по реестрам hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    {
      Q.setMacro('Filter' ,hStrFilter );
      sqlFreeStr(hStrFilter);
    }
    if (hStrFilterP<>0)
    {
      Q.setMacro('FilterP',hStrFilterP);
      sqlFreeStr(hStrFilterP);
    }
    if (hStrFilterR<>0)
    {
      Q.setMacro('FilterR',hStrFilterR);
      sqlFreeStr(hStrFilterR);
    }
    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса НДФЛ при отборе значений ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
      timelog('SborDataNDFL этап 2 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса НДФЛ '+ExploreException);
  }
  _finally
  {
  }
  Result:=true;
} //Function SborDataNDFL(_wTp:word):boolean;

Function SborDataNdfl18perc(_wTp:word):boolean;
var pUserId:comp;
    pUserName:string;
    wErr:word;
    wDog:word;
{ Result:=false;
  pUserId  :=UserID();
  pUserName:=UserName();
  // Договора
  wDog:=if(IsBitCtW(wOption,6),1,0);


  //-------------------------------------------
  // Реестры
  //-------------------------------------------
  _try
  {
    var hStrFilter,hStrFilterP,hStrFilterR:longint;
    var Q: IQuery;
    hStrFilter :=0;
    hStrFilterP:=0;
    hStrFilterR:=0;
    Q:=queryManager.createQuery(SQLQuery(
    Select

     //SubString(SbBan.name,1,9)    as  Name //  нужен только период!!! [01.2018]
     #GP_Cash_Application_Podr_Case_NDFL(SpPlBan.Fio,'')  as Name
    ,Sum(SPPLBAN.SUMOPL)  SumNeed //:double "Требуемая выплата"
    ,118 Pa    //  :word   "0 ведомости, 1 реестры"
    //1 касса, 2 - банк
    //,CASE WHEN COALESCE(PlVed.cLsch,#comp(0))=#comp(0) THEN 2 ELSE 1 END as NPP     //:word
    //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
    ,#GP_Cash_Application_Podr_Case_NDFL(1,2) as NPP
    ,0 VidUd //:word
    ,#GP_Cash_Application_Podr_Case_NDFL(SPPLBAN.VidOpl,0)  as  VidOpl //:word
    ,Max(sbban.prefix) Prefix  //:word
    ,SubString(COALESCE(vPlan.Name,'Основная'),1,100) as Zakaz
    ,CASE WHEN (SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
        THEN COALESCE(vPlan.Nrec,#comp(0))
        ELSE SPPLBAN.cLsch END  as cvPlan // :comp "Группа заказов"
    ,SbBan.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
    ,SbBan.DATAN  as Datan
//Нужно обойти ситуацию
//[05.2018] НДФЛ УФК по МО (Межрайонная ИФНС  Рос...[КПП:504701001,ОКТМО:46783000]
//[05.2018] НДФЛ "УФК по МО (Межрайонная ИФНС  Ро...[КПП:504701001,ОКТМО:46783000]
    ,//REPLACE(REPLACE(REPLACE(REPLACE(SubString(SBBAN.NAME,1,40),'в банк',''),'"',''),' ',''),'[КПП','')+
      SubString(SBBAN.NAME,INSTR('[КПП:',SBBAN.NAME,1),200)
      as NameVed
     ,#GP_Cash_Application_Podr_Case_NDFL(SbBan.Nrec,#Comp(0)) as Nrec
       //--- аналитика
     ,SbBan.SIDE as SIDE //Код среза аналитик
     ,SbBan.wKau as wKau //Код аналитики
     ,SbBan.cKau as cKau //Аналитика
     , coalesce(nplat.kodplat,'') as  kodplat
    From SbBan
    //inner join KatBank on KatBank.Nrec   = SbBan.cBankPol
    inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
    inner join KatPodr on KatPodr.Nrec = Lschet.Cex
    left  join nplat    on nplat.nrec = sbban.cplat //coalesce(nplat.kodplat,'') as  kodplat
    // проверим что есть ведомость по человеку
    //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
    /*
    Left Outer join
    ( select SpPlved.cLsch as cLsch
      From PlatVed
      inner join SPPLVED on SPPLVED.CPLATVED = PlatVed.Nrec
      inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
      where
          PLATVED.DFORM>=:(DTB)
      and PLATVED.DFORM<=:(DTE)
      %FilterP
      and (ZU.POdrShare <> '+' or
        ( SPPLVED.cex in
           (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME)
        )
        )
      Group by
        SpPlved.cLsch
    ) Plved on PlVed.cLsch= SPPLBAN.cLsch
    */
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    Left Outer join AttrVal on AttrVal.cAttrNam=:(ATTR_SB_VPLAN)
                    and AttrVal.wTable = 16060
                    and AttrVal.cRec   = SbBan.Nrec
    Left Outer join vPlan on vPlan.Nrec= AttrVal.vComp
    where
    //    SbBan.DATOK>=:(DTB) //дата выплаты
    //and SbBan.DATOK<=:(DTE) //дата выплаты
        SbBan.DForm>=:(DTB) //дата выплаты
    and SbBan.DForm<=:(DTE) //дата выплаты
    and (SBBAN.VidUd in (55) ) // НДФЛ
    //17.01.2017
    //3. В выборке данных не должны участвовать реестра с типом "ДОГП" - по договорам подряда.
    and ((SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
      or 1=:(wDog)
      )
    // Не фот
    and SBBAN.Prefix<>'S$'
    //объединенный
    and SBBAN.Prefix<>'R$$'
     %Filter
     %FilterR
    and (ZU.POdrShare <> '+'
      or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    Group by
     //GP_Cash_Application_Podr_Case(SpPlBan.Fio,SubString(SbBan.name,1,9))
      #GP_Cash_Application_Podr_Case_NDFL(SpPlBan.Fio,'')
     ,SbBan.cBankPol
     ,SubString(COALESCE(vPlan.Name,'Основная'),1,100)
     ,CASE WHEN (SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
        THEN COALESCE(vPlan.Nrec,#comp(0))
        ELSE SPPLBAN.cLsch END  // :comp "Группа заказов"
     //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
     // ,CASE WHEN COALESCE(PlVed.cLsch,#comp(0))=#comp(0) THEN 2 ELSE 1 END  //as NPP     //:word
     ,#GP_Cash_Application_Podr_Case_NDFL(1,2)
     ,#GP_Cash_Application_Podr_Case_NDFL(SPPLBAN.VidOpl,0)
     ,SbBan.DATAN
     //#808.#77.#1 В заявке на перечисление НДФЛ должно быть столько листов сколько помечено реестров по НДФЛ
     ,#GP_Cash_Application_Podr_Case_NDFL(SbBan.Nrec,#Comp(0))
     ,SbBan.SIDE //Код среза аналитик
     ,SbBan.wKau //Код аналитики
     ,SbBan.cKau //Аналитика

     ,//REPLACE(REPLACE(REPLACE(REPLACE(SubString(SBBAN.NAME,1,40),'в банк',''),'"',''),' ',''),'[КПП','')+
      SubString(SBBAN.NAME,INSTR('[КПП:',SBBAN.NAME,1),200)
      , nplat.kodplat
     //,sbban.prefix
    )); //queryManager.createQuery(SQLQuery(
    //
    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',Marker_KatPodr));
      sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',DepList));
      sqlAddStr(hStrFilterP,iQBuilder.MakeCriteriaFromMarker(' and platved.cex ',DepList));
      timelog('GP_Cash_Application->SborDataNDFL:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if IsBitCTW(wFilter,2)
    { sqlAddStr(hStrFilterR,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Nrec ',Marker_SbBan));
      timelog('GP_Cash_Application->SborDataNDFL:фильтр по реестрам hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    {
      Q.setMacro('Filter' ,hStrFilter );
      sqlFreeStr(hStrFilter);
    }
    if (hStrFilterP<>0)
    {
      Q.setMacro('FilterP',hStrFilterP);
      sqlFreeStr(hStrFilterP);
    }
    if (hStrFilterR<>0)
    {
      Q.setMacro('FilterR',hStrFilterR);
      sqlFreeStr(hStrFilterR);
    }
    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса НДФЛ18 при отборе значений ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
      timelog('SborDataNdfl18perc этап 2 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса НДФЛ18 '+ExploreException);
  }
  _finally
  {
  }
  Result:=true;
} //Function SborDataNdfl18perc

Function SborDataNdfl15perc(_wTp:word):boolean;
var pUserId:comp;
    pUserName:string;
    wErr:word;
    wDog:word;
{ Result:=false;
  pUserId  :=UserID();
  pUserName:=UserName();
  // Договора
  wDog:=if(IsBitCtW(wOption,6),1,0);


  //-------------------------------------------
  // Реестры
  //-------------------------------------------
  _try
  {
    var hStrFilter,hStrFilterP,hStrFilterR:longint;
    var Q: IQuery;
    hStrFilter :=0;
    hStrFilterP:=0;
    hStrFilterR:=0;
    Q:=queryManager.createQuery(SQLQuery(
    Select

     //SubString(SbBan.name,1,9)    as  Name //  нужен только период!!! [01.2018]
     #GP_Cash_Application_Podr_Case_NDFL(SpPlBan.Fio,'')  as Name
    ,Sum(SPPLBAN.SUMOPL)  SumNeed //:double "Требуемая выплата"
    ,115 Pa    //  :word   "0 ведомости, 1 реестры"
    //1 касса, 2 - банк
    //,CASE WHEN COALESCE(PlVed.cLsch,#comp(0))=#comp(0) THEN 2 ELSE 1 END as NPP     //:word
    //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
    ,#GP_Cash_Application_Podr_Case_NDFL(1,2) as NPP
    ,0 VidUd //:word
    ,#GP_Cash_Application_Podr_Case_NDFL(SPPLBAN.VidOpl,0)  as  VidOpl //:word
    ,Max(sbban.prefix) Prefix  //:word
    ,SubString(COALESCE(vPlan.Name,'Основная'),1,100) as Zakaz
    ,CASE WHEN (SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
        THEN COALESCE(vPlan.Nrec,#comp(0))
        ELSE SPPLBAN.cLsch END  as cvPlan // :comp "Группа заказов"
    ,SbBan.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
    ,SbBan.DATAN  as Datan
//Нужно обойти ситуацию
//[05.2018] НДФЛ УФК по МО (Межрайонная ИФНС  Рос...[КПП:504701001,ОКТМО:46783000]
//[05.2018] НДФЛ "УФК по МО (Межрайонная ИФНС  Ро...[КПП:504701001,ОКТМО:46783000]
    ,//REPLACE(REPLACE(REPLACE(REPLACE(SubString(SBBAN.NAME,1,40),'в банк',''),'"',''),' ',''),'[КПП','')+
      SubString(SBBAN.NAME,INSTR('[КПП:',SBBAN.NAME,1),200)
      as NameVed
     ,#GP_Cash_Application_Podr_Case_NDFL(SbBan.Nrec,#Comp(0)) as Nrec
       //--- аналитика
     ,SbBan.SIDE as SIDE //Код среза аналитик
     ,SbBan.wKau as wKau //Код аналитики
     ,SbBan.cKau as cKau //Аналитика
     , coalesce(nplat.kodplat,'') as  kodplat
    From SbBan
    //inner join KatBank on KatBank.Nrec   = SbBan.cBankPol
    inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
    inner join KatPodr on KatPodr.Nrec = Lschet.Cex
    left  join nplat    on nplat.nrec = sbban.cplat //coalesce(nplat.kodplat,'') as  kodplat
    // проверим что есть ведомость по человеку
    //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
    /*
    Left Outer join
    ( select SpPlved.cLsch as cLsch
      From PlatVed
      inner join SPPLVED on SPPLVED.CPLATVED = PlatVed.Nrec
      inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
      where
          PLATVED.DFORM>=:(DTB)
      and PLATVED.DFORM<=:(DTE)
      %FilterP
      and (ZU.POdrShare <> '+' or
        ( SPPLVED.cex in
           (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME)
        )
        )
      Group by
        SpPlved.cLsch
    ) Plved on PlVed.cLsch= SPPLBAN.cLsch
    */
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    Left Outer join AttrVal on AttrVal.cAttrNam=:(ATTR_SB_VPLAN)
                    and AttrVal.wTable = 16060
                    and AttrVal.cRec   = SbBan.Nrec
    Left Outer join vPlan on vPlan.Nrec= AttrVal.vComp
    where
    //    SbBan.DATOK>=:(DTB) //дата выплаты
    //and SbBan.DATOK<=:(DTE) //дата выплаты
        SbBan.DForm>=:(DTB) //дата выплаты
    and SbBan.DForm<=:(DTE) //дата выплаты
    and (SBBAN.VidUd in (17) ) // НДФЛ
    //17.01.2017
    //3. В выборке данных не должны участвовать реестра с типом "ДОГП" - по договорам подряда.
    and ((SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
      or 1=:(wDog)
      )
    // Не фот
    and SBBAN.Prefix<>'S$'
    //объединенный
    and SBBAN.Prefix<>'R$$'
     %Filter
     %FilterR
    and (ZU.POdrShare <> '+'
      or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    Group by
     //GP_Cash_Application_Podr_Case(SpPlBan.Fio,SubString(SbBan.name,1,9))
      #GP_Cash_Application_Podr_Case_NDFL(SpPlBan.Fio,'')
     ,SbBan.cBankPol
     ,SubString(COALESCE(vPlan.Name,'Основная'),1,100)
     ,CASE WHEN (SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A')
        THEN COALESCE(vPlan.Nrec,#comp(0))
        ELSE SPPLBAN.cLsch END  // :comp "Группа заказов"
     //1932 замеч. от 21.02.2018 не разбивать по кассе/банк
     // ,CASE WHEN COALESCE(PlVed.cLsch,#comp(0))=#comp(0) THEN 2 ELSE 1 END  //as NPP     //:word
     ,#GP_Cash_Application_Podr_Case_NDFL(1,2)
     ,#GP_Cash_Application_Podr_Case_NDFL(SPPLBAN.VidOpl,0)
     ,SbBan.DATAN
     //#808.#77.#1 В заявке на перечисление НДФЛ должно быть столько листов сколько помечено реестров по НДФЛ
     ,#GP_Cash_Application_Podr_Case_NDFL(SbBan.Nrec,#Comp(0))
     ,SbBan.SIDE //Код среза аналитик
     ,SbBan.wKau //Код аналитики
     ,SbBan.cKau //Аналитика

     ,//REPLACE(REPLACE(REPLACE(REPLACE(SubString(SBBAN.NAME,1,40),'в банк',''),'"',''),' ',''),'[КПП','')+
      SubString(SBBAN.NAME,INSTR('[КПП:',SBBAN.NAME,1),200)
      , nplat.kodplat
     //,sbban.prefix
    )); //queryManager.createQuery(SQLQuery(
    //
    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',Marker_KatPodr));
      sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',DepList));
      sqlAddStr(hStrFilterP,iQBuilder.MakeCriteriaFromMarker(' and platved.cex ',DepList));
      timelog('GP_Cash_Application->SborDataNDFL:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if IsBitCTW(wFilter,2)
    { sqlAddStr(hStrFilterR,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Nrec ',Marker_SbBan));
      timelog('GP_Cash_Application->SborDataNDFL:фильтр по реестрам hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    {
      Q.setMacro('Filter' ,hStrFilter );
      sqlFreeStr(hStrFilter);
    }
    if (hStrFilterP<>0)
    {
      Q.setMacro('FilterP',hStrFilterP);
      sqlFreeStr(hStrFilterP);
    }
    if (hStrFilterR<>0)
    {
      Q.setMacro('FilterR',hStrFilterR);
      sqlFreeStr(hStrFilterR);
    }
    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса НДФЛ при отборе значений ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
      timelog('SborDataNDFL этап 2 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса НДФЛ '+ExploreException);
  }
  _finally
  {
  }
  Result:=true;
} //Function SborDataNDFL(_wTp:word):boolean;

//--------------------------------------
// установить ширину столбцов
//--------------------------------------
Procedure SetWidthNDFL();
{ xlSetColumnWidth(36,1,01,1,01);//01
  xlSetColumnWidth(21,1,02,1,02);//02
  xlSetColumnWidth(19,1,03,1,03);//03
  xlSetColumnWidth(19,1,04,1,04);//04
  xlSetColumnWidth(16,1,05,1,05);//05
  xlSetColumnWidth(16,1,06,1,06);//06
  xlSetColumnWidth(16,1,07,1,07);//07
  xlSetColumnWidth(03,1,08,1,08);//08
  xlSetColumnWidth(03,1,09,1,09);//09
  xlSetColumnWidth(03,1,10,1,10);//10
  // не влазит
  xlSetRowHeight(54 ,13,1,13,10);//10
} //Procedure SetWidthNDFL();

//-------------------------------------------------
// НДФЛ - получатель
//-------------------------------------------------
Procedure Print_NDFL_Pol;
var ww_str :string;
{
  //ИНН/КПП 5047008220  /504701001
  if sKPP='' sKPP:=sGetTune('KOD_UCHET');
  ww_str:='ИНН/КПП 5047008220 /'+sKPP;
  wexrow:=22; wexcol:=4;
  MyPutExcel(ww_Str,0,0,-1,-1); //

  //Получатель	ИНН 5047062900  КПП 504701001  Управление Федерального казначейства (УФК) по Московской

   wexrow:=38; wexcol:=2;

   //getNameUderS
   ww_str:= 'ИНН '+vBank.KatOrg.Unn+' КПП '+vBank.KatOrg.KodPlatNds+' '+GroupWrap(vBank.KatOrg.Name,1,55);
   MyPutExcel(ww_Str,0,0,-1,-1); //
   wexrow:=24; wexcol:=2;
   MyPutExcel(sOKTMO,0,0,-1,-1); //

  //области (Межрайонная ИФНС России №13  по Московской области)
   wexrow:=39; wexcol:=2;
   ww_str:=Substr(vBank.KatOrg.Name, Length(GroupWrap(vBank.KatOrg.Name,1,55))+1,250);
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //Банк получателя	ГУ Банка России по ЦФО
   wexrow:=40; wexcol:=2;
   ww_str:= vBank.KatBank.Name; //Письмо от 03.12.2018 +if(vBank.KATBANK.ADDR<>'',', '+vBank.KATBANK.ADDR,'');
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //Р/сч получателя
//40 101 8108 4525 0010 102
//40 101 8108 4525 001 010
//40101810845250010103

   wexrow:=41; wexcol:=2;
   ww_str:=   substr(vBank.KatBank.SCHET1, 1,2) //40
        +' '+ substr(vBank.KatBank.SCHET1, 3,3) //101
        +' '+ substr(vBank.KatBank.SCHET1, 6,4) //8108
        +' '+ substr(vBank.KatBank.SCHET1,10,4) //4525
        +' '+ substr(vBank.KatBank.SCHET1,14,4) //0010
        +' '+ substr(vBank.KatBank.SCHET1,18,3) //102
    ;
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //К/сч получателя
   wexrow:=42; wexcol:=2;
   ww_str:=   substr(vBank.KatBank.SCHET2, 1,2) //40
        +' '+ substr(vBank.KatBank.SCHET2, 3,3) //101
        +' '+ substr(vBank.KatBank.SCHET2, 6,4) //8108
        +' '+ substr(vBank.KatBank.SCHET2,10,4) //4525
        +' '+ substr(vBank.KatBank.SCHET2,14,4) //0010
        +' '+ substr(vBank.KatBank.SCHET2,18,3) //102
    ;
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //ИНН
   wexrow:=41; wexcol:=6;
   ww_str:='';
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //БИК	044525000
   wexrow:=42; wexcol:=6;
   ww_str:=vBank.KATBANK.MFO1;
   MyPutExcel(ww_Str,0,0,-1,-1); //
} //Procedure Print_NDFL_Pol;

//-------------------------------------------------
// НДФЛ - подписи
//-------------------------------------------------
Procedure Print_NDFL_Podp;
{  wexrow:=49; wexcol:=3;
   MyPutExcel(MyGetInitial(sFioZGD,true),12,0,-1,-1); //

   wexrow:=53; wexcol:=3;
//   MyPutExcel(MyGetInitial(sMainBuh,true),12,0,-1,-1); //
   MyPutExcel(MyGetInitial(sFioZambuh,true),12,0,-1,-1); //
   wexrow:=45;  wexcol:=3;
   MyPutExcel(MyGetInitial(sFioUser,True)+if(sTelUser<>'',', '+sTelUser,''),12,0,-1,-1); //

   wexrow:=44;  wexcol:=3;
   //03.03.2018 MyPutExcel(MyGetInitial(sFioZambuh,True)+if(sTelZambuh<>'',', '+sTelZambuh,''),12,0,-1,-1); //
} //Procedure Print_NDFL_Pol;
//------------------------------------------
// печать заявки НДФЛ
//------------------------------------------
Function Print_Ndfl:boolean;
var ww_dt:date;
    ww_str:string;
    ww_dog:string;
    kol_ndfl:longint;
    _sPeriod:string;
    ndfl_row:longint;
    ndfl_col:longint;
    boFirst:boolean;
    ii:word;
    _wPeriod:word;
{  Result:=false;
   GetPeriod;
   ww_dt:=date(1,wMonth,wYear);
   kol_ndfl:=0;
   matrixkl:=false;
   ndfl_row:=60;
   ndfl_col:=10;
   boFirst:=true;
   _Loop tmp_prn_cash where (( 101 == tmp_prn_cash.pa ))
   {
     if not NextVisual then Exit;
     //------------------------------
     //создаем лист
     kol_ndfl++;
     ww_dog:='';
     // а вдруг будет не уникально - добавим номер диста
     ww_str:='НДФЛ'+string(kol_ndfl,2)+'-'+tmp_prn_cash.Zakaz;
     //1932 замеч. от 21.02.2018 не разбивать по кассе/банк+' '+if(tmp_prn_cash.NPP=1,'К','Б');
     vbank.pKatBank:=tmp_prn_cash.cRec;
     if vBank.getfirst KatBank=tsok
       if vBank.getfirst KatOrg=tsok
         ww_str:=ww_str+' '+if(vBank.KatOrg.ShortName<>'',vBank.KatOrg.ShortName,vBank.KatOrg.Name);
     ww_str:=ReplSymBol(ww_Str);
     ww_str:=SubStr(ww_Str,1,30);
     MyLogWrite(false,'НДФЛ Лист '+ww_str+', tmp_prn_cash.NPP='+string(tmp_prn_cash.NPP)) ;
#IFDEF GP_Cash_Application_Diff_File
    //надо добавить лист
    if not boFirst
    { xlSetActiveSheet(1);
      xlAddSheet;
      xlSetActiveSheet(1);
      SetPaperParam;
      SetWidthNDFL();
      if not xlSetActiveSheet(kol_ndfl)
      { message('Ошибка установки листа с форматом!');
      }
      xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
      //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
      xlSetActiveSheet(1);
      // только в таком порядке. В рабочей папке можно создать Excel.log
      xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
      xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
      //чтобы снять выделение после вставки
      xlCopyToBuff(1, 1, 1,1);
      xlPasteAllFromBuff(1, 1, 1,1);
      SetWidthNDFL;
    }
#ELSE
     xlSetActiveSheet(1);
     xlAddSheet;

     xlSetActiveSheet(1);
     SetPaperParam;
     SetWidthNDFL();
     if True //not xlCopyExtFormat(book_ndfl,'NDFL') - Ломает даже копирование буфера
     { //MyLogWrite(false,'НДФЛ Лист '+ww_str+' ошибка обновления!' ) ;
       //MyLogWrite(false,'Ошибка :'+xlGetLastError() );
       //---------------------
       SetWidthNDFL;
       //---------------------
       xlSetActiveWorkBookByName(book_Main);
       wexrow:=1;wexcol:=1;
       MyPutExcel('-',9,0,-1,-1);

       //-------------- пробуем все
       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
       xlSetActiveWorkBookByName(book_Main);
       // только в таком порядке. В рабочей папке можно создать Excel.log
       xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------

       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       xlSetActiveWorkBookByName(book_Main);
       xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------
       //чтобы снять выделение после вставки
       xlCopyToBuff(1, 1, 1,1);
       //xlPasteAllFromBuff(1, 1, 1,1);

     }
#ENDIF
     SetPaperParam;
     boFirst:=false;
     if not xlSetSheetName(1,ww_str )
     { MyLogWrite(false,'НДФЛ Лист '+ww_str+' ошибка наименования!' );
       MyLogWrite(false,xlGetLastError() );

     }
     _wPeriod:=wPeriod;
     //#808.#56
     //Если выбран тип заявки за <2 половину> (03.2018) и среди помеченных реестров
     //есть реестра будущего периода (04.2018)
     //то в отдельном листе по НДФЛ будущего периода (сейчас он формируется),
     //необходимо изменить вывод строк <Назначение платежа> и <Срок уплаты налога>,
     //а именно: поскольку это НДФЛ будущего периода, то вместо текста <с зарплаты> выводить <с отпускных и окончательного расчета>.
     if tmp_prn_cash.DataN>DT_Period
        _wPeriod:=2;
     wexrow:=1;wexcol:=1;
     MyPutExcel('',9,0,-1,-1);
     //создаем лист
     //------------------------------

     //--------------------------------
     _sPeriod:=DateToStr(tmp_prn_cash.DataN,'MM.YYYY');//SubStr(tmp_prn_cash.Name,2,7);

     //--------------------------------
     //[03.2018] НДФЛ "Управление финансов Администрац...[КПП:990132001,ОКТМО:55000000]
     //#808.47
     sKPP:=vBank.KatOrg.KodPlatNds;
     sOKTMO:='';
     ii:=pos('[КПП:',tmp_prn_cash.NameVed);
     if ii>0
     { sKPP:=Substr(tmp_prn_cash.NameVed,ii+5,9);
     }
     ii:=pos('ОКТМО:',tmp_prn_cash.NameVed);
     if ii>0
     { sOKTMO:=Substr(tmp_prn_cash.NameVed,ii+6,8);
     }

     //от 06.01.20 18  № 972/ 3
     ww_Str:=DateToStr(DTAppl,'DD.MM.YYYY')+' № РКУ-ЭМ/ '+sNumber;

     wexrow:=7; wexcol:=1;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Прошу оплатить сумму
     wexrow:=9; wexcol:=2;
     MyPutExcel(string(tmp_prn_cash.SumNeed),0,0,-1,-1); //
     MyPutExcel('('+DoubleToStr(tmp_prn_cash.SumNeed,'4')+') рублей' ,0,0,-1,-1); //
     //Назначение платежа
     ww_str:='Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников';
     if sKPP='990132001' //#808.47
     { ww_str:=ww_str+' отдела экспедиции по материально-техническому обеспечению летно-конструкторских испытаний';
     }
     ww_dog:='';
     var _wNazn:string='';
     case tmp_prn_cash.Npp of
     1:
     { if tmp_prn_cash.Prefix='R#Z' or tmp_prn_cash.Prefix='R#A'
       { ww_str:='Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников за '
                   +DateToStr(DT_Period,'month YYYY')+' с  выплаты вознаграждения по договору оказания услуг ';
         //+ № 808/17 от 02.05.2017
         vdog.pLschet:=tmp_prn_cash.cvPlan;
         if vDog.getfirst prvidopl=tsok
         if vDog.getfirst sys_mbf=tsok
         if vDog.getfirst DOGPODR=tsok
         { ww_dog:=' № '+vDog.DOGPODR.DSCDOC
                +' от '+DateToStr(vDog.DOGPODR.LASTDATE,'DD.MM.YYYY');
           _wNazn:=sGetAttrID(coDOGPODR,vDog.DOGPODR.Nrec,pVA_DOGPODR_Content);
         }

         ww_dog:=ww_dog+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
         ww_str:=ww_Str+ww_dog;

       }
       else
       if (tmp_prn_cash.SIDE= coKATKAU or tmp_prn_cash.SIDE=coOTPDOP)
       and tmp_prn_cash.wKau= cgKau_Dogovor
       { ww_str:='Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников за '
                   +DateToStr(DT_Period,'month YYYY')+' с  выплаты вознаграждения по договору оказания услуг ';
         vDogovor.pDogovor :=tmp_prn_cash.cKau;
         if vDogovor.Getfirst Dogovor=tsok
           ww_dog:='№ '+vDogovor.DOGOVOR.NoDoc
                +' от '+DateToStr(vDogovor.DOGOVOR.DDoc,'DD.MM.YYYY');
         if vDogovor.getfirst AttrDog=tsok
           _wNazn:=vDogovor.AttrDog.Subject1;
         ww_dog:=ww_dog+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
         ww_str:=ww_Str+ww_dog;
       }
       else
       //Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников за февраль 2018 с
       //материальной помощи  на погребение   (Фио)
       { ww_str:=ww_str+' за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY г.');
         if tmp_prn_cash.VidOpl>0
         { if getfirst KlVidopl where (( tmp_prn_cash.VidOpl  == KLVIDOPL.VIDOPL ))=tsok
           { //ww_str:=ww_str+' '+My_Sclonenie(KLVIDOPL.NVidopl,12);
             ww_str:=ww_str+' с  "'+KLVIDOPL.NVidopl+'"';
           }
           ww_str:=ww_str+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
         }
       }
     }
     else
     //ww_Str:=''       с зарплаты  за декабрь 2017  (Заказ)
     { case _wPeriod of
       0: ww_str:=ww_str+ ' с аванса за '  +DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');
       1: ww_str:=ww_str+ ' с зарплаты за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');
       2: ww_str:=ww_str+ ' за '           +DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY')
        +' с отпускных  и  окончательного расчета ';
       end;
       if sKPP='990132001' //#808.47
       { ww_str:=ww_str+' Байконур';
       }
       ww_str:=ww_str+ '('+tmp_prn_cash.Zakaz +')';
     }
     end;
     //ww_str:=ww_str+ if(tmp_prn_cash.Npp=1,' - КАССА',' - БАНК');
     wexrow:=13; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     if ww_dog<>''
     { wexrow:=14; wexcol:=2;
       MyPutExcel(ww_dog,0,0,-1,-1); //
     }
     //ИНН/КПП
     /*
     ww_str:='5047008220/504701001';
     if pos('[КПП:',tmp_prn_cash.Name)>0
     { ww_str:='5047008220/'+SubStr(tmp_prn_cash.Name,pos('[КПП:',tmp_prn_cash.Name)+5,9);
     }
     ww_str:='ИНН/КПП '+ww_Str;
     wexrow:=22; wexcol:=4;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     */
     //Налоговый период
     ww_str:='МС.'+_sPeriod;
     wexrow:=26; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Срок уплаты  налога
     ww_str:='';
     if ww_dog<>'' //tmp_prn_cash.Prefix='R#Z' or tmp_prn_cash.Prefix='R#A'
       ww_str:='в день перечисления вознаграждения по договору '+ww_dog
     else
       case _wPeriod of
       0: ww_str:='в день перечисления аванса за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');//;+'(БАНК)';
       1: ww_str:='в день перечисления зарплаты за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');//+'(БАНК)';
       2: ww_str:=' в день перечисления отпускных и оконч. расчета за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');//+' (БАНК)';
       end;
     wexrow:=35; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //--------------------------
     Print_NDFL_Pol;
     //подписи
     Print_NDFL_Podp;
   } //_Loop tmp_prn_cash where (( 101 == tmp_prn_cash.pa ))
   Result:=True;
} //Function Print_Ndfl(_Zakaz:string;_Su:double; _wtp:word);

Function Print_Ndfl15Perc:boolean;
var ww_dt:date;
    ww_str:string;
    ww_dog:string;
    kol_ndfl:longint;
    _sPeriod:string;
    ndfl_row:longint;
    ndfl_col:longint;
    boFirst:boolean;
    ii:word;
    _wPeriod:word;
{  Result:=false;
   GetPeriod;
   ww_dt:=date(1,wMonth,wYear);
   kol_ndfl:=0;
   matrixkl:=false;
   ndfl_row:=60;
   ndfl_col:=10;
   boFirst:=true;
   _Loop tmp_prn_cash where (( 115 == tmp_prn_cash.pa ))
   {
     if not NextVisual then Exit;
     //------------------------------
     //создаем лист
     kol_ndfl++;
     ww_dog:='';
     // а вдруг будет не уникально - добавим номер диста
     ww_str:='НДФЛ15'+string(kol_ndfl,2)+'-'+tmp_prn_cash.Zakaz;
     //1932 замеч. от 21.02.2018 не разбивать по кассе/банк+' '+if(tmp_prn_cash.NPP=1,'К','Б');
     vbank.pKatBank:=tmp_prn_cash.cRec;
     if vBank.getfirst KatBank=tsok
       if vBank.getfirst KatOrg=tsok
         ww_str:=ww_str+' '+if(vBank.KatOrg.ShortName<>'',vBank.KatOrg.ShortName,vBank.KatOrg.Name);
     ww_str:=ReplSymBol(ww_Str);
     ww_str:=SubStr(ww_Str,1,30);
     MyLogWrite(false,'НДФЛ15 Лист '+ww_str+', tmp_prn_cash.NPP='+string(tmp_prn_cash.NPP)) ;
#IFDEF GP_Cash_Application_Diff_File
    //надо добавить лист
    if not boFirst
    { xlSetActiveSheet(1);
      xlAddSheet;
      xlSetActiveSheet(1);
      SetPaperParam;
      SetWidthNDFL();
      if not xlSetActiveSheet(kol_ndfl)
      { message('Ошибка установки листа с форматом!');
      }
      xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
      //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
      xlSetActiveSheet(1);
      // только в таком порядке. В рабочей папке можно создать Excel.log
      xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
      xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
      //чтобы снять выделение после вставки
      xlCopyToBuff(1, 1, 1,1);
      xlPasteAllFromBuff(1, 1, 1,1);
      SetWidthNDFL;
    }
#ELSE
     xlSetActiveSheet(1);
     xlAddSheet;

     xlSetActiveSheet(1);
     SetPaperParam;
     SetWidthNDFL();
     if True //not xlCopyExtFormat(book_ndfl,'NDFL') - Ломает даже копирование буфера
     { //MyLogWrite(false,'НДФЛ Лист '+ww_str+' ошибка обновления!' ) ;
       //MyLogWrite(false,'Ошибка :'+xlGetLastError() );
       //---------------------
       SetWidthNDFL;
       //---------------------
       xlSetActiveWorkBookByName(book_Main);
       wexrow:=1;wexcol:=1;
       MyPutExcel('-',9,0,-1,-1);

       //-------------- пробуем все
       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
       xlSetActiveWorkBookByName(book_Main);
       // только в таком порядке. В рабочей папке можно создать Excel.log
       xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------

       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       xlSetActiveWorkBookByName(book_Main);
       xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------
       //чтобы снять выделение после вставки
       xlCopyToBuff(1, 1, 1,1);
       //xlPasteAllFromBuff(1, 1, 1,1);

     }
#ENDIF
     SetPaperParam;
     boFirst:=false;
     if not xlSetSheetName(1,ww_str )
     { MyLogWrite(false,'НДФЛ15 Лист '+ww_str+' ошибка наименования!' );
       MyLogWrite(false,xlGetLastError() );

     }
     _wPeriod:=wPeriod;
     //#808.#56
     //Если выбран тип заявки за <2 половину> (03.2018) и среди помеченных реестров
     //есть реестра будущего периода (04.2018)
     //то в отдельном листе по НДФЛ будущего периода (сейчас он формируется),
     //необходимо изменить вывод строк <Назначение платежа> и <Срок уплаты налога>,
     //а именно: поскольку это НДФЛ будущего периода, то вместо текста <с зарплаты> выводить <с отпускных и окончательного расчета>.
     if tmp_prn_cash.DataN>DT_Period
        _wPeriod:=2;
     wexrow:=1;wexcol:=1;
     MyPutExcel('',9,0,-1,-1);
     //создаем лист
     //------------------------------

     //--------------------------------
     _sPeriod:=DateToStr(tmp_prn_cash.DataN,'MM.YYYY');//SubStr(tmp_prn_cash.Name,2,7);

     //--------------------------------
     //[03.2018] НДФЛ "Управление финансов Администрац...[КПП:990132001,ОКТМО:55000000]
     //#808.47
     sKPP:=vBank.KatOrg.KodPlatNds;
     sOKTMO:='';
     ii:=pos('[КПП:',tmp_prn_cash.NameVed);
     if ii>0
     { sKPP:=Substr(tmp_prn_cash.NameVed,ii+5,9);
     }
     ii:=pos('ОКТМО:',tmp_prn_cash.NameVed);
     if ii>0
     { sOKTMO:=Substr(tmp_prn_cash.NameVed,ii+6,8);
     }

     //от 06.01.20 18  № 972/ 3
     ww_Str:=DateToStr(DTAppl,'DD.MM.YYYY')+' № РКУ-ЭМ/ '+sNumber;

     wexrow:=7; wexcol:=1;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Прошу оплатить сумму
     wexrow:=9; wexcol:=2;
     MyPutExcel(string(tmp_prn_cash.SumNeed),0,0,-1,-1); //
     MyPutExcel('('+DoubleToStr(tmp_prn_cash.SumNeed,'4')+') рублей' ,0,0,-1,-1); //
     //Назначение платежа
     ww_str:='Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников';
     if sKPP='990132001' //#808.47
     { ww_str:=ww_str+' отдела экспедиции по материально-техническому обеспечению летно-конструкторских испытаний';
     }
     ww_dog:='';
     var _wNazn:string='';
     case tmp_prn_cash.Npp of
     1:
     { if tmp_prn_cash.Prefix='R#Z' or tmp_prn_cash.Prefix='R#A'
       { ww_str:='Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников за '
                   +DateToStr(DT_Period,'month YYYY')+' с  выплаты вознаграждения по договору оказания услуг ';
         //+ № 808/17 от 02.05.2017
         vdog.pLschet:=tmp_prn_cash.cvPlan;
         if vDog.getfirst prvidopl=tsok
         if vDog.getfirst sys_mbf=tsok
         if vDog.getfirst DOGPODR=tsok
         { ww_dog:=' № '+vDog.DOGPODR.DSCDOC
                +' от '+DateToStr(vDog.DOGPODR.LASTDATE,'DD.MM.YYYY');
           _wNazn:=sGetAttrID(coDOGPODR,vDog.DOGPODR.Nrec,pVA_DOGPODR_Content);
         }

         ww_dog:=ww_dog+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
         ww_str:=ww_Str+ww_dog;

       }
       else
       if (tmp_prn_cash.SIDE= coKATKAU or tmp_prn_cash.SIDE=coOTPDOP)
       and tmp_prn_cash.wKau= cgKau_Dogovor
       { ww_str:='Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников за '
                   +DateToStr(DT_Period,'month YYYY')+' с  выплаты вознаграждения по договору оказания услуг ';
         vDogovor.pDogovor :=tmp_prn_cash.cKau;
         if vDogovor.Getfirst Dogovor=tsok
           ww_dog:='№ '+vDogovor.DOGOVOR.NoDoc
                +' от '+DateToStr(vDogovor.DOGOVOR.DDoc,'DD.MM.YYYY');
         if vDogovor.getfirst AttrDog=tsok
           _wNazn:=vDogovor.AttrDog.Subject1;
         ww_dog:=ww_dog+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
         ww_str:=ww_Str+ww_dog;
       }
       else
       //Налог на доходы физических лиц, удержанный налоговым агентом с доходов работников за февраль 2018 с
       //материальной помощи  на погребение   (Фио)
       { ww_str:=ww_str+' за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY г.');
         if tmp_prn_cash.VidOpl>0
         { if getfirst KlVidopl where (( tmp_prn_cash.VidOpl  == KLVIDOPL.VIDOPL ))=tsok
           { //ww_str:=ww_str+' '+My_Sclonenie(KLVIDOPL.NVidopl,12);
             ww_str:=ww_str+' с  "'+KLVIDOPL.NVidopl+'"';
           }
           ww_str:=ww_str+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
         }
       }
     }
     else
     //ww_Str:=''       с зарплаты  за декабрь 2017  (Заказ)
     { case _wPeriod of
       0: ww_str:=ww_str+ ' с аванса за '  +DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');
       1: ww_str:=ww_str+ ' с зарплаты за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');
       2: ww_str:=ww_str+ ' за '           +DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY')
        +' с отпускных  и  окончательного расчета ';
       end;
       if sKPP='990132001' //#808.47
       { ww_str:=ww_str+' Байконур';
       }
       ww_str:=ww_str+ '('+tmp_prn_cash.Zakaz +')';
     }
     end;
     //ww_str:=ww_str+ if(tmp_prn_cash.Npp=1,' - КАССА',' - БАНК');
     wexrow:=13; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     if ww_dog<>''
     { wexrow:=14; wexcol:=2;
       MyPutExcel(ww_dog,0,0,-1,-1); //
     }
     //ИНН/КПП
     /*
     ww_str:='5047008220/504701001';
     if pos('[КПП:',tmp_prn_cash.Name)>0
     { ww_str:='5047008220/'+SubStr(tmp_prn_cash.Name,pos('[КПП:',tmp_prn_cash.Name)+5,9);
     }
     ww_str:='ИНН/КПП '+ww_Str;
     wexrow:=22; wexcol:=4;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     */
     //Налоговый период
     ww_str:='МС.'+_sPeriod;
     wexrow:=26; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Срок уплаты  налога
     ww_str:='';
     if ww_dog<>'' //tmp_prn_cash.Prefix='R#Z' or tmp_prn_cash.Prefix='R#A'
       ww_str:='в день перечисления вознаграждения по договору '+ww_dog
     else
       case _wPeriod of
       0: ww_str:='в день перечисления аванса за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');//;+'(БАНК)';
       1: ww_str:='в день перечисления зарплаты за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');//+'(БАНК)';
       2: ww_str:=' в день перечисления отпускных и оконч. расчета за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY');//+' (БАНК)';
       end;
     wexrow:=35; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //--------------------------
     Print_NDFL_Pol;
     //подписи
     Print_NDFL_Podp;
   } //_Loop tmp_prn_cash where (( 101 == tmp_prn_cash.pa ))
   Result:=True;
} //Function Print_Ndfl15Perc(_Zakaz:string;_Su:double; _wtp:word);

Function Print_Ndfl18Perc:boolean;
var ww_dt:date;
    ww_str:string;
    ww_dog:string;
    kol_ndfl:longint;
    _sPeriod:string;
    ndfl_row:longint;
    ndfl_col:longint;
    boFirst:boolean;
    ii:word;
    _wPeriod:word;
{  Result:=false;
   GetPeriod;
   ww_dt:=date(1,wMonth,wYear);
   kol_ndfl:=0;
   matrixkl:=false;
   ndfl_row:=60;
   ndfl_col:=10;
   boFirst:=true;
   _Loop tmp_prn_cash where (( 118 == tmp_prn_cash.pa ))
   {
     if not NextVisual then Exit;
     //------------------------------
     //создаем лист
     kol_ndfl++;
     ww_dog:='';
     // а вдруг будет не уникально - добавим номер диста
     ww_str:='НДФЛ18'+string(kol_ndfl,2)+'-'+tmp_prn_cash.Zakaz;
