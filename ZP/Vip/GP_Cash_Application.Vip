Procedure Print_DOG_Pol;
var ww_str:string;
    ww_pol:string;
{

   wexrow:=22; wexcol:=2;
   //ww_pol:=vBank.KatOrg.Name;
   ww_pol:=tmp_prn_cash.Name;
   ww_str:=ww_pol;//GroupWrap(ww_pol,1,50);
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //-------------------
   //wexrow:=32; wexcol:=6;
   //ww_str:= vBank.KatOrg.Unn
   //MyPutExcel(ww_Str,0,0,-1,-1); //

   //wexrow:=33; wexcol:=2;
