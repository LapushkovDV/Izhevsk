//-------------------------
Table Struct local tmp_prn_Zakaz
( pa:word//
 ,Zakaz:string
 ,Su_Kassa:double
 ,Su_Bank :double
 ,cvPlan  :comp "Группа заказов"
)
with index
( tmp_prn_Zakaz01 =pa+Zakaz
 ,tmp_prn_Zakaz02 =Zakaz
);
//------------------------
Table Struct local tmp_prn_cash
(  Name    :string  "Наименование банка/выплаты"
  ,SumNeed :double  "Требуемая выплата"
  ,Pa      :word "0 ведомости, 1 реестры"
  ,NPP     :word
  ,VidUd   :word
  ,VidOpl  :word
  ,Prefix  :string //было 10
  ,Zakaz   :string
  ,cvPlan  :comp "Группа заказов"
  ,cRec    :comp "ссылка на документ"
  ,DATAN   :date //SBBAN.DATAN
  ,NameVed :string
  ,Nrec    :comp
  //--- аналитика
  ,SIDE    :longint//Код среза аналитик
  ,wKau    :word//Код аналитики
  ,cKau    :comp//Аналитика
  ,kodplat : string //Код платежа
)
with index
( tmp_prn_cash01 = Zakaz+ pa+ name
 ,tmp_prn_cash02 = Zakaz+ pa+ NPP
 ,tmp_prn_cash03 = pa+Zakaz+Name
);
//-------------------------
table Struct local tmp_Sb_One
( Summa :double
 ,PA:word
)
;

//-------------------------------------
Create view
var
  pSbBan :comp;
as select ZAR_User.Nrec
,tmp_prn_cash.*, tmp_Sb_One.*

From
   Klvidopl
 , ZAR_User
 , Perech
 , tmp_prn_cash
 , tmp_prn_cash  tmp_prn_cash01
 , tmp_prn_Zakaz(tmp_prn_Zakaz01)
 , tmp_Sb_One
 //---- фильтры
 , PLATVED PLATVED_FLT
 , SBBAN SBBAN_Flt
 , KatPodr KatPodr_Flt

where ((
     sUserName    == ZAR_USER.OWNNAME
and  tmp_prn_cash.Vidopl == Klvidopl.Vidopl
//------------------------------------
//  фильтры
and wc_nrec == SBBAN_Flt.Nrec      // Сотрудники
and wc_nrec == PLATVED_Flt.Nrec           // Подразделения

));

//------------------------------------
Create view vPers
var
  pPerson :comp;
From Persons, Appointments
    ,COMMUNICATIONS
where
((  pPerson == Persons.Nrec
and Persons.Appointcur == Appointments.Nrec
and pPerson  == COMMUNICATIONS.Person
and 2 == COMMUNICATIONS.OBJTYPE
));

Create view vSpr
var
  cat_main_M11:comp;
as select catalogs.Name
from catalogs
,StaffStruct
,Appointments
,Persons
where ((
    cat_main_M11 == Catalogs.MainLink
and 0            == Catalogs.Lpr
//Заместитель генерального директора по экономике и финансам
and '506'        == Catalogs.Code
and Catalogs.Nrec== StaffStruct.Department
and DTE>>=StaffStruct.DInPut
and ( StaffStruct.DClose=ZeroDate or StaffStruct.DClose>=DTE  )
and StaffStruct.Nrec == Appointments.StaffStr
//----------------
and DTE>>=Appointments.AppointDate(noindex)
and (Appointments.DisMissDate=ZeroDate or Appointments.DisMissDate>=DTE )
and Appointments.Person == Persons.Nrec

))
;
//------------------------------------
create view vBank
var
  pKatBank:comp ;
as select KAtOrg.Name
from Katbank,KAtOrg
where (( pKatBank == KatBank.Nrec
   and   KatBank.cOrg == KAtOrg.Nrec
)) ;

//-----------------------------
create view vDog
//-----------------------------
var
  pLschet:comp;
  tm:word ;
as select Prvidopl.Nrec
from DOGPODR,prvidopl,SYS_MBF
where
((    //prmnrec == prvidopl.mnrec and
      TM      == prvidopl.choice
  and pLschet == prvidopl.cLsch
  and prvidopl.mnrec == SYS_MBF.Nrec
  and comp(SYS_MBF.NODOC) == DOGPODR.NREC
));

//-----------------------------
create view vDoplata
//-----------------------------
var
  pLschet:comp;
  wVidopl:word ;
as select Doplata.Nrec
from Doplata, OtpDop
where
((    pLschet == Doplata.cLsch
  and wVidopl == Doplata.Vidopl
  and DOPLATA.OldcLsch  == OtpDop.Nrec


));

//-----------------------------
create view vDogovor
//-----------------------------
var
  pDogovor:comp;
From Dogovor, AttrDog
where ((
    pDogovor == Dogovor.Nrec
and Dogovor.Nrec == AttrDog.cDogovor
));

//-----------------------------
create view vKau
//-----------------------------
var
  wKodGrKau:word;
  sNameKau :string;
As select spkau.name
from spkau
where ((
    wKodGrKau == spkau.KodGrKau
and sNameKau  == spkau.Name
));

create view vCatalogs
var
  pCatalogs: comp;
as select catalogs.nrec
From Catalogs
where ((
  pCatalogs == catalogs.nrec
));

