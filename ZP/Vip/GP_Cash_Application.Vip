Procedure Print_MAT_Pol;
var ww_str:string;
    ww_pol:string;
{

   wexrow:=27; wexcol:=2;
   //ww_pol:=vBank.KatOrg.Name;
   ww_pol:=tmp_prn_cash.Name;
   ww_str:=GroupWrap(ww_pol,1,50);
   MyPutExcel(ww_Str,0,0,-1,-1); //
   wexrow:=28; wexcol:=2;
   ww_str:=Substr(ww_pol, Length(GroupWrap(ww_pol,1,50))+1,250);
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //-------------------
   //wexrow:=32; wexcol:=6;
   //ww_str:= vBank.KatOrg.Unn
   //MyPutExcel(ww_Str,0,0,-1,-1); //

   //wexrow:=33; wexcol:=2;
   //ww_str:= vBank.KatOrg.KodPlatNds
   //MyPutExcel(ww_Str,0,0,-1,-1); //

   //Банк получателя	ГУ Банка России по ЦФО
   wexrow:=31; wexcol:=2;
   ww_str:= vBank.KatBank.Name;
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //Р/сч получателя
//40 101 8108 4525 0010 102
//40 101 8108 4525 001 010
//40101810845250010103

   wexrow:=32; wexcol:=2;
   ww_str:=   substr(vBank.KatBank.SCHET1, 1,2) //40
        +' '+ substr(vBank.KatBank.SCHET1, 3,3) //101
        +' '+ substr(vBank.KatBank.SCHET1, 6,4) //8108
        +' '+ substr(vBank.KatBank.SCHET1,10,4) //4525
        +' '+ substr(vBank.KatBank.SCHET1,14,4) //0010
        +' '+ substr(vBank.KatBank.SCHET1,18,3) //102
    ;
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //К/сч получателя
   wexrow:=33; wexcol:=2;
   ww_str:=   substr(vBank.KatBank.SCHET2, 1,2) //40
        +' '+ substr(vBank.KatBank.SCHET2, 3,3) //101
        +' '+ substr(vBank.KatBank.SCHET2, 6,4) //8108
        +' '+ substr(vBank.KatBank.SCHET2,10,4) //4525
        +' '+ substr(vBank.KatBank.SCHET2,14,4) //0010
        +' '+ substr(vBank.KatBank.SCHET2,18,3) //102
    ;
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //ИНН
   wexrow:=32; wexcol:=6;
   ww_str:=sGetAttrID(coKatBank,vBank.KatBank.Nrec,ATTR_B_INN);
   MyPutExcel(ww_Str,0,0,-1,-1); //
   //БИК	044525000
   wexrow:=33; wexcol:=6;
   ww_str:=vBank.KATBANK.MFO1;
   MyPutExcel(ww_Str,0,0,-1,-1); //
} //Procedure Print_MAT_Pol;

