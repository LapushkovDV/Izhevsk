//------------------------------------------
// печать заявки ФИЗ.ЛИЦАМ
//------------------------------------------
Function Print_Mat(_wtp:word=0):boolean;
var ww_dt:date;
    ww_str:string;
    kol_ndfl:longint;
    _sPeriod:string;
    ndfl_row:longint;
    ndfl_col:longint;
    boFirst:boolean;
{  Result:=false;
   GetPeriod;
   ww_dt:=date(1,wMonth,wYear);
   kol_ndfl:=0;
   matrixkl:=false;
   ndfl_row:=55;
   ndfl_col:=8;
   boFirst:=true;
   _Loop tmp_prn_cash where (( 105 == tmp_prn_cash.pa and 0 == tmp_prn_cash.Vidud(noindex) ))
   {
     //------------------------------
     //создаем лист
     kol_ndfl++;

     // а вдруг будет не уникально - добавим номер диста
     ww_str:='ФЗ '+string(kol_ndfl,2)+'-'+tmp_prn_cash.Name;
     //1932 замеч. от 21.02.2018 не разбивать по кассе/банк+' '+if(tmp_prn_cash.NPP=1,'К','Б');
     vbank.pKatBank:=tmp_prn_cash.cRec;
     if vBank.getfirst KatBank=tsok
       if vBank.getfirst KatOrg=tsok
         ww_str:=ww_str+' '+if(vBank.KatOrg.ShortName<>'',vBank.KatOrg.ShortName,vBank.KatOrg.Name);
     ww_str:=ReplSymBol(ww_Str);
     ww_str:=SubStr(ww_Str,1,30);
     MyLogWrite(false,'ФИЗ.Лица Лист '+ww_str+', tmp_prn_cash.NPP='+string(tmp_prn_cash.NPP)) ;
     timelog('GP_Cash_Application->Print_Mat:ФИЗ.Лица Лист '+ww_str+', tmp_prn_cash.NPP='+string(tmp_prn_cash.NPP)) ;
     timelog('GP_Cash_Application->Print_Mat:tmp_prn_cash.Vidopl='+string(tmp_prn_cash.Vidopl)+', .Nrec='+string(tmp_prn_cash.NRec,0,0)) ;
#IFDEF GP_Cash_Application_Diff_File
    //надо добавить лист
    if not boFirst
    { xlSetActiveSheet(1);
      xlAddSheet;
      xlSetActiveSheet(1);
      SetPaperParam;
      SetWidthMAT();
      if not xlSetActiveSheet(kol_ndfl)
      { message('Ошибка установки листа с форматом!');
      }
      xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
      //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
      xlSetActiveSheet(1);
      // только в таком порядке. В рабочей папке можно создать Excel.log
      xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
      xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
      //чтобы снять выделение после вставки
      xlCopyToBuff(1, 1, 1,1);
      xlPasteAllFromBuff(1, 1, 1,1);
      SetWidthNDFL;
    }
#ELSE
     xlSetActiveSheet(1);
     xlAddSheet;
     xlSetActiveSheet(1);
     SetPaperParam;
     SetWidthMAT();
     if True //not xlCopyExtFormat(book_ndfl,'NDFL') - Ломает даже копирование буфера
     { //MyLogWrite(false,'НДФЛ Лист '+ww_str+' ошибка обновления!' ) ;
       //MyLogWrite(false,'Ошибка :'+xlGetLastError() );
       //---------------------
       SetWidthMAT;
       //---------------------
       xlSetActiveWorkBookByName(book_Main);
       wexrow:=1;wexcol:=1;
       MyPutExcel('-',9,0,-1,-1);

       //-------------- пробуем все
       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       //xlInsertRange(xlShiftDown, wexrow, 1, wexrow,255) //
       xlSetActiveWorkBookByName(book_Main);
       // только в таком порядке. В рабочей папке можно создать Excel.log
       xlPasteAllFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------

       xlSetActiveWorkBookByName(book_ndfl);
       xlCopyToBuff(1, 1, ndfl_row,ndfl_col);
       xlSetActiveWorkBookByName(book_Main);
       xlPasteFormatFromBuff(1, 1, ndfl_row,ndfl_col);
       //------------------------
       //чтобы снять выделение после вставки
       xlCopyToBuff(1, 1, 1,1);
       //xlPasteAllFromBuff(1, 1, 1,1);

     }
#ENDIF
     boFirst:=false;
     if not xlSetSheetName(1,ww_str )
     { MyLogWrite(false,'ФЛ Лист '+ww_str+' ошибка наименования!' );
       MyLogWrite(false,xlGetLastError() );

     }
     wexrow:=1;wexcol:=1;
     MyPutExcel('',9,0,-1,-1);
     //создаем лист
     //------------------------------

     //--------------------------------
     _sPeriod:=DateToStr(tmp_prn_cash.DataN,'MM.YYYY');//SubStr(tmp_prn_cash.Name,2,7);
     //--------------------------------

     //от 06.01.20 18  № 972/ 3
     ww_Str:=DateToStr(DTAppl,'от DD.MM.YYYY')+' № РКУ-ЭМ/ '+sNumber;

     wexrow:=6; wexcol:=1;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //Прошу оплатить сумму
     wexrow:=12; wexcol:=2;
     MyPutExcelNumber(tmp_prn_cash.SumNeed,2,0,0,-1,-1); //
     MyPutExcel('('+DoubleToStr(tmp_prn_cash.SumNeed,'4 ) рублей 88 коп.') ,0,0,-1,-1); //
     if getfirst tmp_prn_cash01 where (( tmp_prn_cash.pa == tmp_prn_cash01.pa
       and tmp_prn_cash.Name == tmp_prn_cash01.name(noindex)
       and 182 == tmp_prn_cash01.Vidud(noindex)
       and (
             ( tmp_prn_cash.SIDE=0 or tmp_prn_cash.SIDE=tmp_prn_cash01.SIDE) //Код среза аналитик
         and ( tmp_prn_cash.cKau=0 or tmp_prn_cash.cKau=tmp_prn_cash01.cKau) //Аналитика
         )
     )) =tsok
     { wexrow:=13; wexcol:=2;
       MyPutExcelNumber(tmp_prn_cash01.SumNeed,2,0,0,-1,-1); //
       MyPutExcel('('+DoubleToStr(tmp_prn_cash01.SumNeed,'4 ) рублей 88 коп.') ,0,0,-1,-1); //
       //delete current tmp_prn_cash01;
     }
     //---- Назначение платежа
     timelog('GP_Cash_Application->Print_Mat:SIDE='+string(tmp_prn_cash.SIDE,0,0)
       +',wKau='+string(tmp_prn_cash.wKau,0,0)
       +',cKau='+string(tmp_prn_cash.cKau,0,0)
     );

     var _wNazn:string='';
     ww_str:='';
     case Abs(tmp_prn_cash.SIDE) of
     coKATKAU, coOTPDOP:
     { case tmp_prn_cash.wKau of
       cgKau_Dogovor:
       { vDogovor.pDogovor :=tmp_prn_cash.cKau;
         if vDogovor.Getfirst Dogovor=tsok
           ww_Str:='договор № '+vDogovor.DOGOVOR.NoDoc
                +' от '+DateToStr(vDogovor.DOGOVOR.DDoc,'DD.MM.YYYY');
         if vDogovor.getfirst AttrDog=tsok
           _wNazn:=vDogovor.AttrDog.Subject1;

       }
       else
       { if ww_Str=''
           if tmp_prn_cash.wKau>0
             ww_Str:=ShowKau(tmp_prn_cash.wKau, tmp_prn_cash.cKau);
       }
       end;
     }
     end;
     timelog('GP_Cash_Application->Print_Mat:ww_str='+ww_str) ;

     if ww_str=''
     if tmp_prn_cash.Vidopl>0
     { set vDoplata.pLschet:=tmp_prn_cash.Nrec;
       set vDoplata.wVidopl:=tmp_prn_cash.Vidopl;
       if vDoplata.getlast Doplata=tsok
       if vDoplata.getfirst OtpDop=tsok
       { var jj:word;
         timelog('GP_Cash_Application->Print_Mat:нашли доплату') ;

         For(jj:=1;jj<=6;jj++)
         { //if vDoplata.Doplata.tblExtr[jj]=cgKau_Dogovor
           if vDoplata.OtpDop.tbld[jj]=cgKau_Dogovor
           { //vDogovor.pDogovor:=vDoplata.Doplata.KauExtr[jj];
             vDogovor.pDogovor:=vDoplata.OtpDop.cKauD[jj];
             if vDogovor.getfirst Dogovor=tsok
             { ww_str:='договор  № '+vDogovor.DOGOVOR.NoDoc
                +' от '+DateToStr(vDogovor.DOGOVOR.DDoc,'DD.MM.YYYY');
               if vDogovor.getfirst AttrDog=tsok
                _wNazn:=vDogovor.AttrDog.Subject1;
             }
             break;
           }
         }
       }
     } //if ww_str=''-> if tmp_prn_cash.Vidopl>0
     if ww_Str<>''
     { wexrow:=21;
       wexcol:=2;
       MyPutExcel(ww_Str,0,0,-1,-1); //
     }
     ww_str:=_wNazn+' ';

     case tmp_prn_cash.Npp of
     1:
     { //ww_str:=ww_str+' за '+DateToStr(StrToDate(_sPeriod,'MM.YYYY'),' month YYYY г.');
       if tmp_prn_cash.VidOpl>0
       { if getfirst KlVidopl where (( tmp_prn_cash.VidOpl  == KLVIDOPL.VIDOPL ))=tsok
         { //ww_str:=ww_str+' '+My_Sclonenie(KLVIDOPL.NVidopl,12);
           ww_str:=ww_str+'"'+KLVIDOPL.NVidopl+'"';
           wexrow:=48; wexcol:=2;
           MyPutExcel('б/сч '+KLVIDOPL.cSchetK+'/'+KLVIDOPL.cSubSchK,0,0,-1,-1); //
         }
         ww_str:=ww_str+' ('+MyGetInitial(tmp_prn_cash.Name,true)+')';
       }
     }
     end;
     //ww_str:=ww_str+ if(tmp_prn_cash.Npp=1,' - КАССА',' - БАНК');
     wexrow:=16; wexcol:=2;
     MyPutExcel(ww_Str,0,0,-1,-1); //
     //--------------------------
     Print_MAT_Pol;
     //подписи
     Print_MAT_Podp;
   } //_Loop tmp_prn_cash where (( 101 == tmp_prn_cash.pa ))
   Result:=True;
} //Function Print_Mat(_Zakaz:string;_Su:double; _wtp:word);

//-------------------------------------------------
// выплаты Договора подряда
//-------------------------------------------------
Function SborDataDog(_wTp:word):boolean;
var pUserId:comp;
    pUserName:string;
    wErr:word;
{ Result:=false;
  timelog('SborDataDOG Start ');

  pUserId  :=UserID();
  pUserName:=UserName();

  //-------------------------------------------
  // Реестры
  //-------------------------------------------
  _try
  {
    var hStrFilter,hStrFilterP,hStrFilterR:longint;
    var Q: IQuery;
    hStrFilter :=0;
    hStrFilterP:=0;
    hStrFilterR:=0;
    Q:=queryManager.createQuery(SQLQuery(
    Select

     //SubString(SbBan.name,1,9)    as  Name //  нужен только период!!! [01.2018]
     SpPlBan.Fio  as Name
    ,Sum(SPPLBAN.SUMOPL)  SumNeed //:double "Требуемая выплата"
    ,106 Pa    //  :word   "0 ведомости, 1 реестры"
    ,1 as NPP
    ,CASE WHEN (SBBAN.VidUd in (182,183,184,17,55,56,57)) THEN 182 ELSE 0 END VidUd //:word
    ,SPPLBAN.VidOpl  as  VidOpl //:word
    ,Max(sbban.prefix) Prefix  //:word
    ,'' as Zakaz
    ,SPPLBAN.cLsch as cvPlan // :comp "Группа заказов"
    ,SbBan.cBankPol as cRec   // "ссылка на документ"    - будем подбивать по банкам
    ,SbBan.DATAN  as Datan
    ,'' as NameVed
       ,#comp(0) as Nrec
       //--- аналитика
       ,0        as SIDE //Код среза аналитик
       ,0        as wKau //Код аналитики
       ,#Comp(0) as cKau //Аналитика
       ,coalesce(nplat.kodplat,'') as  kodplat
    From SbBan
    //inner join KatBank on KatBank.Nrec   = SbBan.cBankPol
    inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
    inner join KatPodr on KatPodr.Nrec = Lschet.Cex
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    left  join nplat    on nplat.nrec = sbban.cplat //coalesce(nplat.kodplat,'') as  kodplat
    Left Outer join AttrVal on AttrVal.cAttrNam=:(ATTR_SB_VPLAN)
                    and AttrVal.wTable = 16060
                    and AttrVal.cRec   = SbBan.Nrec
    Left Outer join vPlan on vPlan.Nrec= AttrVal.vComp
    where
    //    SbBan.DATOK>=:(DTB) //дата выплаты
    //and SbBan.DATOK<=:(DTE) //дата выплаты
        SbBan.DForm>=:(DTB) //дата выплаты
    and SbBan.DForm<=:(DTE) //дата выплаты
    and (SBBAN.Prefix='R#Z' or SBBAN.Prefix='R#A')
    // Не фот
    and SBBAN.Prefix<>'S$'
    //объединенный
    and SBBAN.Prefix<>'R$$'
     %Filter
     %FilterR
    and (ZU.POdrShare <> '+'
      or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    Group by
      SpPlBan.Fio
     ,SbBan.cBankPol
     ,SPPLBAN.cLsch
     ,CASE WHEN (SBBAN.VidUd in(182,183,184,17,55,56,57)) THEN 182 ELSE 0 END
     ,SPPLBAN.VidOpl
     ,SbBan.DATAN
     ,nplat.kodplat
     //,sbban.prefix
    )); //queryManager.createQuery(SQLQuery(
    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',Marker_KatPodr));
      sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Cex ',DepList));
      sqlAddStr(hStrFilterP,iQBuilder.MakeCriteriaFromMarker(' and platved.cex ',DepList));
      timelog('GP_Cash_Application->SborDataDOG:фильтр по подразделениям hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if IsBitCTW(wFilter,2)
    { sqlAddStr(hStrFilterR,iQBuilder.MakeCriteriaFromMarker(' and SbBan.Nrec ',Marker_SbBan));
      timelog('GP_Cash_Application->SborDataDOG:фильтр по реестрам hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    {
      Q.setMacro('Filter' ,hStrFilter );
      sqlFreeStr(hStrFilter);
    }
    if (hStrFilterR<>0)
    {
      Q.setMacro('FilterR' ,hStrFilterR );
      sqlFreeStr(hStrFilterR);
    }
    if (hStrFilterP<>0)
    {
      Q.setMacro('FilterP',hStrFilterP);
      sqlFreeStr(hStrFilterP);
    }
    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса по договорам подряда при отборе значений ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash,true);
      timelog('SborDataDOG этап 2 '+String(wErr)+', '+RecordsInTable(TNtmp_prn_cash));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса по договорам подряда 2 '+ExploreException);
  }
  _finally
  {
  }
  Result:=true;
} //Function SborDataDog(_wTp:word):boolean;

//--------------------------------------
// установить ширину столбцов
//--------------------------------------
Procedure SetWidthDog();
{ xlSetColumnWidth(36,1,01,1,01);//01
  xlSetColumnWidth(16,1,02,1,02);//02
  xlSetColumnWidth(16,1,03,1,03);//03
  xlSetColumnWidth(16,1,04,1,04);//04
  xlSetColumnWidth(22,1,05,1,05);//05
  xlSetColumnWidth(21,1,06,1,06);//06
  xlSetColumnWidth(13,1,07,1,07);//07
  // не влазит
  xlSetRowHeight(31 ,16,1,16,10);//10
} //Procedure SetWidthMat();


