Function GetCatalogsName(_pCatalogs:comp):string;Cacheable;
{ Result:='';
  vCatalogs.pCatalogs:=_pCatalogs;
  vCatalogs._Loop Catalogs
    Result:=vCatalogs.Catalogs.Name
} //Function GetCatalogsName(_pCatalogs:comp):string;Cacheable;

//---------------------------------
//
//---------------------------------
Function GetCatalogsCode(_pCatalogs:comp):string;Cacheable;
{ Result:='';
  vCatalogs.pCatalogs:=_pCatalogs;
  vCatalogs._Loop Catalogs
    Result:=vCatalogs.Catalogs.Code
} //Function GetCatalogsName(_pCatalogs:comp):string;Cacheable;


//---------------------------------
//
//---------------------------------
Procedure GetPodpisant;
{   sPodpis1    := '';
    sPodpis1Dol := '';
    sPodpis1Npp := 999;
    sPodpis2    := '';
    sPodpis2Dol := '';
    sPodpis2Npp := 999;

    if (iFeeSigners.FeeSignersIsValid)
      {
        var wFeeSignersNum, wFeeSignersCount : word;
        wFeeSignersCount := iFeeSigners.GetFeeSignersCount;

        if (iFeeSigners.GetSignerFirst)
        {
          For (wFeeSignersNum := 1; wFeeSignersNum <= wFeeSignersCount; wFeeSignersNum++)
          {
             if (iFeeSigners.GetSignerRole = 'Согласовано (шапка)')
             {
               sSogls     := iFeeSigners.GetSignerFIO(7);
               sSoglsDol  := iFeeSigners.GetSignerPosition(1);
             }
             else if (iFeeSigners.GetSignerRole = 'Утверждающее лицо')
             {
               sUtve     := iFeeSigners.GetSignerFIO(7);
               sUtveDol  := iFeeSigners.GetSignerPosition(1);
             }
             else if (iFeeSigners.GetSignerRole = 'Проверяющее лицо')
             {
               if (iFeeSigners.GetSignerNumber < sPodpis1Npp)
                 {
                   sPodpis2    := sPodpis1;
                   sPodpis2Dol := sPodpis1Dol;
                   sPodpis2Npp := sPodpis1Npp;
                   sPodpis1    := iFeeSigners.GetSignerFIO(7);
                   sPodpis1Dol := iFeeSigners.GetSignerPosition(1);
                   sPodpis1Npp := iFeeSigners.GetSignerNumber;
                 }
               else if (iFeeSigners.GetSignerNumber < sPodpis2Npp)
                 {
                   sPodpis2    := iFeeSigners.GetSignerFIO(7);
                   sPodpis2Dol := iFeeSigners.GetSignerPosition(1);
                   sPodpis2Npp := iFeeSigners.GetSignerNumber;
                 }
             }
             else if (iFeeSigners.GetSignerRole = 'Ответственный')
             {
               sOtv     := iFeeSigners.GetSignerFIO(7);
               sOtvD    := iFeeSigners.GetSignerFIO(9);
               sOtvDol  := iFeeSigners.GetSignerPosition(1);
               sOtvDolD := iFeeSigners.GetSignerPosition(3);
             }
             else if (iFeeSigners.GetSignerRole = 'Согласовано (подножие)')
             {
               sSogls2     := iFeeSigners.GetSignerFIO(7);
               sSogls2Dol  := iFeeSigners.GetSignerPosition(1);
             }
             else if (iFeeSigners.GetSignerRole = 'Зам. директор')
             {
               sZamDir     := iFeeSigners.GetSignerFIO(7);
               sZamDirD    := iFeeSigners.GetSignerFIO(9);
               sZamDirDol  := iFeeSigners.GetSignerPosition(1);
               sZamDirDolD  := iFeeSigners.GetSignerPosition(3);
             }
             else if (iFeeSigners.GetSignerRole = 'Согласовано')
             {
               sSoglsOsn    := iFeeSigners.GetSignerFIO(7);
               sSoglsOsnD   := iFeeSigners.GetSignerFIO(9);
               sSoglsOsnDol := iFeeSigners.GetSignerPosition(1);
               sSoglsOsnDolD:= iFeeSigners.GetSignerPosition(3);
             }
             else if (iFeeSigners.GetSignerRole = 'Гл. бухгалтер')
             {
               sMainBuh     := iFeeSigners.GetSignerFIO(7);
               sMainBuhD    := iFeeSigners.GetSignerFIO(9);
               sMainBuhDol  := iFeeSigners.GetSignerPosition(1);
               sMainBuhDolD := iFeeSigners.GetSignerPosition(3);
             }
             else if (iFeeSigners.GetSignerRole = 'Руководитель организации')
             {
               sBoss        := iFeeSigners.GetSignerFIO(7);
               sBossDol     := iFeeSigners.GetSignerPosition(1);
             }


            if (not iFeeSigners.GetSignerNext)
              break;
          }
        }
      }

    SaveMyDsk(sSogls       , nameNastr + '_sSogls');
    SaveMyDsk(sSoglsDol    , nameNastr + '_sSoglsDol');
    SaveMyDsk(sSogls2      , nameNastr + '_sSogls2');
    SaveMyDsk(sSogls2Dol   , nameNastr + '_sSogls2Dol');
    SaveMyDsk(sUtve        , nameNastr + '_sUtve');
    SaveMyDsk(sUtveDol     , nameNastr + '_sUtveDol');
    SaveMyDsk(sPodpis2     , nameNastr + '_sPodpis2');
    SaveMyDsk(sPodpis2Dol  , nameNastr + '_sPodpis2Dol');
    SaveMyDsk(sPodpis2Npp  , nameNastr + '_sPodpis2Npp');
    SaveMyDsk(sPodpis1     , nameNastr + '_sPodpis1');
    SaveMyDsk(sPodpis1Dol  , nameNastr + '_sPodpis1Dol');
    SaveMyDsk(sOtv         , nameNastr + '_sOtv');
    SaveMyDsk(sOtvD        , nameNastr + '_sOtvD');
    SaveMyDsk(sOtvDol      , nameNastr + '_sOtvDol');
    SaveMyDsk(sOtvDolD     , nameNastr + '_sOtvDolD');
    SaveMyDsk(sPodpis1Npp  , nameNastr + '_sPodpis1Npp');
    SaveMyDsk(sZamDir      , nameNastr + '_sZamDir');
    SaveMyDsk(sZamDirD     , nameNastr + '_sZamDirD');
    SaveMyDsk(sZamDirDol   , nameNastr + '_sZamDirDol');
    SaveMyDsk(sZamDirDolD  , nameNastr + '_sZamDirDolD');
    SaveMyDsk(sSoglsOsn    , nameNastr + '_sSoglsOsn');
    SaveMyDsk(sSoglsOsnD   , nameNastr + '_sSoglsOsnD');
    SaveMyDsk(sSoglsOsnDol , nameNastr + '_sSoglsOsnDol');
    SaveMyDsk(sSoglsOsnDolD, nameNastr + '_sSoglsOsnDolD');
    SaveMyDsk(sMainBuh     , nameNastr + '_sMainBuh');
    SaveMyDsk(sMainBuhD    , nameNastr + '_sMainBuhD');
    SaveMyDsk(sMainBuhDol  , nameNastr + '_sMainBuhDol');
    SaveMyDsk(sMainBuhDolD , nameNastr + '_sMainBuhDolD');
    SaveMyDsk(sBoss        , nameNastr + '_sBoss   ');
    SaveMyDsk(sBossDol     , nameNastr + '_sBossDol');

    SaveMyDsk(sFeeSigners, nameNastr + '_sFeeSigners');


}//Procedure GetPodpisant;

//-------------------------------
// Получить телефоны
//-------------------------------
Function GetTelUser:string;
{ Result:='';
  if vPers.pPerson=0 then exit;

  vPers._Loop  COMMUNICATIONS
  {
    if GetCatalogsName(vPers.COMMUNICATIONS.COMTYPE)='Рабочий номер'
      Result:=Result+if(Result<>'',',','')+vPers.COMMUNICATIONS.ADDR;
  }
} //Function GetTelUser:string;

