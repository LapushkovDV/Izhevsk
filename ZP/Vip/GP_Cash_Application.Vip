Procedure ReadPodpisant;
{   if not ReadMyDsk(sSogls       , nameNastr + '_sSogls'       ,false) {}
    if not ReadMyDsk(sSoglsDol    , nameNastr + '_sSoglsDol'    ,false) {}
    if not ReadMyDsk(sSogls2      , nameNastr + '_sSogls2'      ,false) {}
    if not ReadMyDsk(sSogls2Dol   , nameNastr + '_sSogls2Dol'   ,false) {}
    if not ReadMyDsk(sUtve        , nameNastr + '_sUtve'        ,false) {}
    if not ReadMyDsk(sUtveDol     , nameNastr + '_sUtveDol'     ,false) {}
    if not ReadMyDsk(sPodpis2     , nameNastr + '_sPodpis2'     ,false) {}
    if not ReadMyDsk(sPodpis2Dol  , nameNastr + '_sPodpis2Dol'  ,false) {}
    if not ReadMyDsk(sPodpis2Npp  , nameNastr + '_sPodpis2Npp'  ,false) {}
    if not ReadMyDsk(sPodpis1     , nameNastr + '_sPodpis1'     ,false) {}
    if not ReadMyDsk(sPodpis1Dol  , nameNastr + '_sPodpis1Dol'  ,false) {}
    if not ReadMyDsk(sOtv         , nameNastr + '_sOtv'         ,false) {}
    if not ReadMyDsk(sOtvD        , nameNastr + '_sOtvD'        ,false) {}
    if not ReadMyDsk(sOtvDol      , nameNastr + '_sOtvDol'      ,false) {}
    if not ReadMyDsk(sOtvDolD     , nameNastr + '_sOtvDolD'     ,false) {}
    if not ReadMyDsk(sPodpis1Npp  , nameNastr + '_sPodpis1Npp'  ,false) {}
    if not ReadMyDsk(sZamDir      , nameNastr + '_sZamDir'      ,false) {}
    if not ReadMyDsk(sZamDirD     , nameNastr + '_sZamDirD'     ,false) {}
    if not ReadMyDsk(sZamDirDol   , nameNastr + '_sZamDirDol'   ,false) {}
    if not ReadMyDsk(sZamDirDolD  , nameNastr + '_sZamDirDolD'  ,false) {}
    if not ReadMyDsk(sSoglsOsn    , nameNastr + '_sSoglsOsn'    ,false) {}
    if not ReadMyDsk(sSoglsOsnD   , nameNastr + '_sSoglsOsnD'   ,false) {}
    if not ReadMyDsk(sSoglsOsnDol , nameNastr + '_sSoglsOsnDol' ,false) {}
    if not ReadMyDsk(sSoglsOsnDolD, nameNastr + '_sSoglsOsnDolD',false) {}
    if not ReadMyDsk(sMainBuh     , nameNastr + '_sMainBuh'     ,false) {}
    if not ReadMyDsk(sMainBuhD    , nameNastr + '_sMainBuhD'    ,false) {}
    if not ReadMyDsk(sMainBuhDol  , nameNastr + '_sMainBuhDol'  ,false) {}
    if not ReadMyDsk(sMainBuhDolD , nameNastr + '_sMainBuhDolD' ,false) {}
    if not ReadMyDsk(sBoss        , nameNastr + '_sBoss   '     ,false) {}
    if not ReadMyDsk(sBossDol     , nameNastr + '_sBossDol'     ,false) {}

    if not ReadMyDsk(sFeeSigners, nameNastr + '_sFeeSigners'    ,false) {}


} //Procedure ReadPodpisant;

