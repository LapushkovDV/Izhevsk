
/*************************************************************************************************\
* Наименование:  Ведение заказов/проектов - Распределение ФОТ работников по заказам               *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    Запуск - Настройка - Распределение ФОТ работников по заказам                     *
*                также встроен в "Виды оплат и удержаний"                                         *
* 1770 - добавить привязку произв.функции                                                         *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#773          |07/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#1770         |29/01/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#include GetKau.vih
#include Marker.vih
#include GP_ZP_RaspZakazVO.Vih
#doc
Распределение видов оплат/удержаний по заказам
#end
Interface GP_ZP_RaspZakazVO 'Распределение видов оплат по заказам' , EscClose;
show at (,,100,20);
//------------------------------------
// декларация сложного фильтра
//------------------------------------
Function isFilterAnCorrect(ww_nrec:comp): boolean; forward;
//---------------------------------------
// Получить план счетов по заказу
//---------------------------------------
Function GetMnPlanBuhSchet(_pMnPlan:comp) :comp;forward;
//---------------------------------------
// Получить наименование вида оплат
//---------------------------------------
Function GetVidOplUdName(_wTp:word; _Vidopl:word):string;forward;
Function GetVidOplUdName_Flt:string;forward;
//-----------------------------------------
Table Struct tmp_err
( mes:string[200]
)
with index
( tmp_err01 = mes
);
//-----------------------------------------
#include GetKau.var
//-----------------------------------------

var
//-----------------------------------------
// объекты
//-----------------------------------------
  pMarkerActive : IMarker(Marker) new; // функция пометки
  pMarkerArh    : IMarker(Marker) new; // функция пометки
//-----------------------------------------
  pTmp:comp;
  isOpenSearch:boolean;
  Type_Run:boolean;//тип запуска - true - RunInterface
  wpr_CurUserAdmin:boolean;//pr_CurUserAdmin
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
   wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   l_nrec  :longint;
   KauMarkerName:string;
   Marker_Tmp :longint;
   Dsk_Suffix :string;
   #mrkfld_(KatPodr)
   #mrkfld_(MnPlan)
   #mrkfld_(DepFunc)
// Фильтры
//-----------------------------------------
create view
var
  //---------- Параметры -----------------
  wTp        :word;//  тип 0- виды оплат, 1 - удержанич
  wVidopls   :word;// системный вид оплат
  wVidopls_A :word;// системный вид оплат
  pKatPodr   :comp;// ссылка на подразделение
  pDepFunc   :comp;// производственная функция
  pMnPlan    :comp;// ссылка на заказ
  pBuhSchet_Z:comp;// ссылка на заказ
  dDatan     :date;// заданный период c
  dDatok     :date;// заданный период по
  wisArh     :word; // 0 - активная, 1 архив
  //-----------------------------
  sSchet,sSchet_A   :string[22];//Фильтр по счету
  sSubSch,sSubSch_A  :string[22];//Фильтр по счету
  dOtchPer :date;//дата начала отчетного периода
  myPlansNo:comp ; // PlansSch.nrec - план счетов
as select
   GP_RaspVO.Nrec
 , GetVidOplUdName(wTp,GP_RaspVO.VidOpl) (FieldName=VidOplUdName, FieldTitle='Наименование вида оплат')
 , GetVidOplUdName_Flt() (FieldName=VidOplUdName_Flt, FieldTitle='Наименование вида оплат')
From
  GP_RaspVO
 ,KatPodr
 ,MnPlan
 ,X$USERS
 ,BuhSchet
 ,BuhSchet BuhSchet_Z //счет в заказе
 ,KlVidOpl
 ,KlVidUd
 ,PlansSch
 ,DepFunc
//------- фильтры
 , KatPodr KatPodr_Flt
 , MnPlan  MnPlan_Flt
 , DepFunc DepFunc_Flt
 , BuhSchet BuhSchet_Flt
 , KlVidopl KlVidOpl_Flt
 , KlVidUd  KlVidUd_Flt
 //----------------
 ,tmp_err // для протокола

where ((
    wTp                 == GP_RaspVO.TP
and wisArh              == GP_RaspVO.isArh
//======================
//GP_ZP_Function.Vpp
and myPlansNo == PlansSch.nrec
//======================

and GP_RaspVO.cKatPodr   == KatPodr.Nrec
and GP_RaspVO.cAddFld[1] == DepFunc.cFunc
and GP_RaspVO.cMnPlan    == MnPlan.Nrec
and pBuhSchet_Z          == BuhSchet_Z.nrec
//and GP_RaspVO.cBuhSchet == BuhSchet.Nrec
and GP_RaspVO.cUser      == X$USERS.atl_nrec
and GP_RaspVO.VidOpl     == KlVidOpl.Vidopl
and GP_RaspVO.VidOpl     == KlVidUd.Vidud
// счет
and PlansSch.Kod+GP_RaspVO.Schet == BuhSchet.Schet
and GP_RaspVO.SubSch             == BuhSchet.SubSch
//------- фильтры
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == MnPlan_Flt.Nrec
and l_nrec == DepFunc_Flt.cFunc
and PlansSch.Kod+sSchet == BuhSchet_Flt.Schet
and sSubSch             == BuhSchet_Flt.SubSch
and wVidopls == KlVidOpl_Flt.VidOpl
and wVidopls == KlVidUd_Flt.VidUd

  ))
//На этой вкладке должны отображаться все записи таблицы, у которых дата окончания действия равна, или больше текущего отчетного периода
Bounds byActive
         wTp                == GP_RaspVO.TP
     and wisArh             == GP_RaspVO.isArh
//по тз так   and (dOtchPer<GP_RaspVO.DatOk or GP_RaspVO.DatOk=ZeroDate)

Bounds byArh
         wTp                == GP_RaspVO.TP
    and  wisArh             == GP_RaspVO.isArh
//по тз так  and (dOtchPer>GP_RaspVO.DatOk or GP_RaspVO.DatOk=ZeroDate)
Bounds ByKatpodr  pKatpodr   == GP_RaspVO.cKatpodr(noindex) ordered by TableOrder
Bounds ByMnPlan   pMnPlan    == GP_RaspVO.cMnPlan (noindex) ordered by TableOrder
Bounds BySchet    sSchet_A   == GP_RaspVO.Schet(noindex) ordered by TableOrder
Bounds BySubSch   sSubSch_A  == GP_RaspVO.SubSch(noindex) ordered by TableOrder
Bounds ByVidOpl   wVidopls_A == GP_RaspVO.VidOpl(noindex) ordered by TableOrder
Bounds ByDepFunc  pDepFunc   == GP_RaspVO.cAddFld[1](noindex) ordered by TableOrder

condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_RaspVo.Nrec))

; //create view

Parameters
  wTp
#doc
1  тип 0- виды оплат, 1 - удержанич
#end
 ,wVidopls
#doc
2 системный вид оплат
#end
 ,pKatPodr
#doc
3 ссылка на подразделение
#end
 ,dDatan
#doc
4 заданный период c
#end
 ,dDatok
#doc
5 заданный период по
#end
 ,wisArh
#doc
6 0 - активная, 1 архив
#end
 ,pDepFunc
#doc
7 производственная функция
#end

;

//******************************************************************************
// Функции
//******************************************************************************
  //-------------------------------------------
  //------------------------------------
  // Наименование интерфейса
  //------------------------------------
  Function GetInterfaceName:string;
  { Result:=#(__InterfaceName__);
  }

  //------------------------------------
  // Отразить в протоколе
  //------------------------------------
  Procedure MyLog(const _err:string);
  { if getfirst tmp_err where (( _err == Tmp_err.mes ))<>tsok
    { displ(_err);
      insert into tmp_err set tmp_err.mes:=_err;

    }
  } //Procedure MyLog()const _err:string);

  //------------------------------------
  // сохранить параметры
  //------------------------------------
  Procedure SaveParam;
  { SaveMyDsk(wFilter  ,GetInterfaceName+Dsk_Suffix+'_wFilter');
    SaveMyDsk(sSchet   ,GetInterfaceName+Dsk_Suffix+'_sSchet' );
    SaveMyDsk(sSubSch  ,GetInterfaceName+Dsk_Suffix+'_sSibSch');
    SaveMyDsk(wVidOpls ,GetInterfaceName+Dsk_Suffix+'_wVidOpls');
    DoneMarker(Marker_KatPodr, GetInterfaceName+Dsk_Suffix+'_KatPodr');
    DoneMarker(Marker_MnPlan , GetInterfaceName+Dsk_Suffix+'_MnPlan' );
    DoneMarker(Marker_DepFunc, GetInterfaceName+Dsk_Suffix+'_DepFunc');

    DoneMarker(Marker_KatPodr_A, '');
    DoneMarker(Marker_MnPlan_A , '');
    DoneMarker(Marker_DepFunc_A, '');
  } //Procedure SaveParam;

  //------------------------------------
  // восстановить параметры
  //------------------------------------
  Procedure ReadParam;
  { if not ReadMyDsk(wFilter  ,GetInterfaceName+Dsk_Suffix+'_wFilter',false) wFilter:=0;
    if not ReadMyDsk(sSchet   ,GetInterfaceName+Dsk_Suffix+'_sSchet' ,false) sSchet :='';
    if not ReadMyDsk(sSubSch  ,GetInterfaceName+Dsk_Suffix+'_sSibSch',false) sSubSch:='';
    if wVidOpls=0
    { if not ReadMyDsk(wVidOpls ,GetInterfaceName+Dsk_Suffix+'_wVidOpls',false) wVidOpls:=0;

    }
    Marker_KatPodr  :=InitMarker(GetInterfaceName+Dsk_Suffix+'_KatPodr', 8, 50, 10, True);
    Marker_MnPlan   :=InitMarker(GetInterfaceName+Dsk_Suffix+'_MnPlan' , 8, 50, 10, True);
    Marker_DepFunc  :=InitMarker(GetInterfaceName+Dsk_Suffix+'_DepFunc', 8, 50, 10, True);

    Marker_KatPodr_A  :=InitMarker('' , 8, 50, 10, True);
    Marker_MnPlan_A   :=InitMarker('' , 8, 50, 10, True);
    Marker_DepFunc_A  :=InitMarker('' , 8, 50, 10, True);

  }

  //------------------------------------
  // декларация сложного фильтра
  //------------------------------------
  function isFilterAnCorrect(ww_nrec:comp): boolean; cacheable;
  { Result:=true;
    if IsBitCTW(wFilter,1)
    { if Count_Katpodr>1
      { If not FoundMarker(Marker_Katpodr_A,GP_RaspVo.cKatPodr)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,2)
    { if Count_MnPlan>1
      { If not FoundMarker(Marker_MnPlan_A,GP_RaspVo.cMnPlan)
        { Result:=false;
          Exit;
        }
      }
    }

    if IsBitCTW(wFilter,5)
    { if Count_DepFunc>1
      { If not FoundMarker(Marker_DepFunc_A,GP_RaspVo.cAddFld[1])
        { Result:=false;
          Exit;
        }
      }
    }

  }//function isFilterAnCorrect(ww_nrec:comp): boolean;


    //-------------------------------------------
  // скопировать фильтры в данные для отборв
  //-------------------------------------------
  Procedure CopyToA;
  { CopyMarker(Marker_Katpodr_A ,Marker_Katpodr);
    CopyMarker(Marker_MnPlan_A  ,Marker_MnPlan );
    CopyMarker(Marker_DepFunc_A ,Marker_DepFunc);

    sSchet_A  :=sSchet;
    sSubSch_A :=sSubSch;
    wVidOpls_A:=wVidOpls;
  } //Procedure CopyToA;

  //-------------------------------------------
  // восстановить данные для задания фильтрации
  // из данных для отбора
  //-------------------------------------------
  Procedure RestFromA;
  { CopyMarker(Marker_Katpodr,Marker_Katpodr_A);
    CopyMarker(Marker_MnPlan ,Marker_MnPlan_A );
    CopyMarker(Marker_DepFunc,Marker_DepFunc_A);

    sSchet  :=sSchet_A;
    sSubSch :=sSubSch_A;
    wVidOpls:=wVidOpls_A;
  } //Procedure RestFromA;

    //-------------------------------------------
  #doc
    Установить ограничения
  #end
  Function SetFilterBounds(_IsArch:word) : boolean;
  { Result:=false;
    if ConditionActiveInLeave(tcFilterAn, #GP_RaspVo)
    { PopConditionForLeave(tcFilterAn, #GP_RaspVo);
    }
    case wIsArh of
    0: PushBounds(tbByActive);
    1: PushBounds(tbByArh);
    end;
    If BoundActive(tbByKatpodr) SubBounds(tbByKatpodr);
    If BoundActive(tbByMnPlan ) SubBounds(tbByMnPlan );
    If BoundActive(tbBySubSch ) SubBounds(tbBySubSch );
    If BoundActive(tbBySchet  ) SubBounds(tbBySchet  );
    If BoundActive(tbByVidOpl ) SubBounds(tbByVidOpl );
    If BoundActive(tbByDepFunc) SubBounds(tbByDepFunc);
    //-----------------
    CopyToA;
    //-----------------
    ClearFuncCache; // очистим кэш функций
    var need_FilterAn:boolean=false;
    set wIsArh:=_IsArch;
    if IsBitCTW(wFilter,1)
    {  Count_Katpodr:=GetMarkerCount(Marker_Katpodr);
       GetMarker(Marker_Katpodr,0,pKatPodr);
       if Count_Katpodr=1
       {
         AddBounds(tbByKatpodr);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,2)
    {  Count_MnPlan:=GetMarkerCount(Marker_MnPlan);
       GetMarker(Marker_MnPlan,0,pMnPlan);

       if Count_MnPlan=1
       { AddBounds(tbByMnPlan);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,3)
    {  AddBounds(tbBySchet);
       if sSubSch<>''
         AddBounds(tbBySubSch);

    }
    if IsBitCTW(wFilter,4)
    {  AddBounds(tbByVidOpl);
    }
    if IsBitCTW(wFilter,5)
    {  Count_DepFunc:=GetMarkerCount(Marker_DepFunc);
       GetMarker(Marker_DepFunc,0,pDepFunc);

       if Count_DepFunc=1
       { AddBounds(tbByDepFunc);
       }
       else need_FilterAn:=true;
    }

    // использование сложного фильтра
    if need_FilterAn
    { PushConditionForLeave(tcFilterAn, #GP_RaspVo);
    }
    ReReadRecord(#GP_RaspVo);
    Result:=true;
  } //Function SetFilterBounds : boolean;

  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_Katpodr
    { #mrkfiltr_(Katpodr_Flt,Katpodr,Nrec,wc_nrec,Katpodr_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_MnPlan
    { #mrkfiltr_(MnPlan_Flt,MnPlan,Nrec,wc_nrec,MnPlan_Flt.Number)
    }
    if _Field=0 or _Field=#Filtr_DepFunc
    { #mrkfiltr_(DepFunc_Flt,DepFunc,cFunc,l_nrec,DEPFUNC_Flt.NMFUNC)
    }
    ReScanPanel(#Katpodr_Flt);
  } //Procedure SetFilterNM(_Field:longint)


#doc
  Проверить наличие распределения по заказам за период
  _wTP - 0 виды оплат
         1 виды удержаний
#end  
  function FindZakazByPeriod(
           _wVIDOPLS: word // вид оплаты/удержаний
          ;_wTP :word //0 оплата, 1 удержание
          ;_cPodr:comp //ссылка на подразделение
          ;_Schet:string=''// счет бухгалтерского учета
          ;_SubSch:string=''//субсчет бухгалтерского учета
          ;_DataN: Date = ZeroDate// дата начала периода
          ;_DataOk: Date = ZeroDate// дата окончания периода
          ;_pDepFunc:comp=0 //функция
          ): comp;cacheable;
  {  Result:=0;
     if (GetLast GP_RaspVO where (( _wTp == GP_RaspVO.TP
         and _wVIDOPLS == GP_RaspVO.VIDOPL
         and _cPodr    == GP_RaspVO.cKatpodr(noindex) //_cPodr:comp //ссылка на подразделение
         and _Schet    == GP_RaspVO.Schet(noindex)// счет бухгалтерского учета
         and _SubSch   == GP_RaspVO.SubSch(noindex)//субсчет бухгалтерского учета
         and _pDepFunc == GP_RaspVO.cAddFld[1](noindex)
         and _DataOk  >>= GP_RaspVO.DataN(noindex)// дата начала периода
         and (_DataN <= GP_RaspVO.DataOK or GP_RaspVO.DataOK=ZeroDate)
         )) =tsok)
     {  Result:=GP_RaspVO.cMnPlan;
     }
     if wpr_CurUserAdmin//pr_CurUserAdmin
     { MyLog('FindZakazByPeriod '+string(_wTp)+', _wVIDOPLS='+string(_wVIDOPLS)+', _cPodr='+string(_cPodr)
        +',_Schet='+_Schet+',_SubSch='+_SubSch+' , DataN='+DateToStr(_DataN,'DD.MM.YYYY')
        +' , DataOk='+DateToStr(_DataOk,'DD.MM.YYYY')
        +' , _pDepFunc='+String(_pDepFunc,0,0)
        +' , Result='+string(Result)
        )
     }
  } //function FindRaspZakazByPeriod(

  //---------------------------------------
  // Получить план счетов по заказу
  //---------------------------------------
  Function GetMnPlanBuhSchet(_pMnPlan:comp) :comp;
  { Result:=0;
    //cgKau_BuhSchet             = 5063;  // Счета бухгалтерского учета
    if _pMnPlan=0 exit;
    if MNPLAN.WKODGR1=5063
    { Result :=MNPLAN.CANVAL1;
    }
    else
    if MNPLAN.WKODGR2=5063
    { Result :=MNPLAN.CANVAL2;
    }
  }//Function GetMnPlanSchet(_pMnPlan:comp) :comp;

  //---------------------------------------
  // Получить наименование вида оплат
  //---------------------------------------
  Function GetVidOplUdName(_wTp:word; _Vidopl:word):string;cacheable;
  { Result:='';
    if _Vidopl=0 exit;
    if _wTp=0
    { Result:=KlVidOpl.NVidOpl;
    }
    else
    { Result:=KlVidUd.NVidUd;
    }

  }//Function GetVidOplUdName(_wTp:word; _Vidopl:word):string;forward;

    //---------------------------------------
  // Получить наименование вида оплат
  //---------------------------------------
  Function GetVidOplUdName_Flt:string;
  { Result:='';
    if wVidopls=0 exit;
    if wTp=0
    { Result:=string(KlVidOpl_flt.VidOplP)+' '+KlVidOpl_flt.NVidOpl;
    }
    else
    { Result:=string(KlVidUd_flt.VidUDP)+' '+KlVidUd.NVidUd;
    }

  }//Function GetVidOplUdName(_wTp:word; _Vidopl:word):string;forward;

  //---------------------------------------
  // Инициализация интерфейса
  //---------------------------------------
  Procedure LoadInterface(_Type:boolean);
  var _wFilter:word;
      _title  :string;
  {   Type_Run:=_Type;
      _title :='Распределение видов оплат по заказам';
      if wTp=1
        _title :='Распределение видов удержаний по заказам';
      dOtchPer:=dGetTune('UP.DATOTCH');
      wpr_CurUserAdmin:= pr_CurUserAdmin();
      delete all tmp_err;
      GetPlansSchNrec (myPlansNo);//GP_ZP_Function.Vpp
      if getfirst GP_RaspVO where (( wTp == GP_RaspVO.TP
              and  0 == GP_RaspVO.IsArh
              and ZeroDate <<GP_RaspVO.DataOk(noindex)
              and dOtchPer >>GP_RaspVO.DataOk(noindex)
              )) =tsok
      { update GP_RaspVO where
              ((  wTp == GP_RaspVO.TP
              and 0   == GP_RaspVO.IsArh
              and ZeroDate <<GP_RaspVO.DataOk(noindex)
              and dOtchPer >>GP_RaspVO.DataOk(noindex)
                ))
        set GP_RaspVO.IsArh:=1;

      }
      Dsk_Suffix:=if(wTp=0,'','U');
      ClusterDisabledField(#wFilter,0);
      _wFilter:=0;
      if wVidOpls>0
      { Dsk_Suffix:=Dsk_Suffix+'Vo';
        ClusterDisabledField(#wFilter,8);
        ClearFieldOption(#VidOplUdName_Flt, ofSelectable);
        BitOnW(_wFilter,4);
      }
      else
      { SetFieldOption(#VidOplUdName_Flt, ofSelectable)

      }
      ReadParam;
      //просуммируем маску фильтра
      wFilter:=wFilter or _wFilter;
      SetTitle(_Title);
  } //Procedure LoadInterface;

  //---------------------------------------
  // ДеИнициализация интерфейса
  //---------------------------------------
  Procedure UnLoadInterface(_Type:boolean);
  { SaveParam;
  }//Procedure UnLoadInterface(_Type:boolean);


//******************************************************************************
// Форматы
//******************************************************************************
Window wnFilter 'Установите фильтры'  Cyan, EscClose;
  Show at (,,60,10);
Screen scrFilter 'Фильтры' ('Фильтры',,sci13Esc);
Table Katpodr_Flt;
Fields
  wFilter :NoProtect;
  Filtr_KatPodr    : PickButton,Protect,QuickChoice;
  Filtr_MnPlan     : PickButton,Protect,QuickChoice;
  sSchet           : PickButton,Protect,QuickChoice;
  sSubSch          : PickButton,Protect,QuickChoice;
  BuhSchet_Flt.Name: PickButton,Protect,QuickChoice;
  VidOplUdName_Flt : PickButton,Protect,QuickChoice;
  Filtr_DepFunc    : PickButton,Protect,QuickChoice;
Buttons
  cmOk    ,,, 'Задать учебный год', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;
<<
  `Фильтр по`
  [.] Подразделения` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] Заказы       ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] Счет/субсчет ` .@@@@@@.@@@@@@.@@@@@@@@@@@@@@@@@@@@
  [.] Вид оплат    ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] Функция      ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. Продолжить .>  <.   Отмена   .>
>>
end; //Screen scrFilter (,,sci13Esс);
HandleEvent
cmInit:
{ SetFilterNm(0);
}
cmOk:
{ CloseWindowEx(wnFilter,cmDefault)

}
end;// HandleEvent
end; //Windows wnFilter 'Установите фильтры' , Cyan, EscClose;

//-------------------------------------
TabbedSheet bottom tab_Rasp;
//-------------------------------------
#UNDEF brRasp
#DECLARE brRasp (sciEditFld, wActive, Protect,Title)
Table GP_RaspVO;
RecMarker = pMarker#(wActive) { GP_RaspVO.nRec };
Fields
  GP_RaspVO.VidOplP    'Код'#13'#(Title)'       ('вид  #(Title)',,#(sciEditFld)):[5],Protect,PickButton,QuickChoice;
  VidOplUdName         'Наименование'#13'вида #(Title)'    ('вид  #(Title)',,#(sciEditFld)):[15],Protect,PickButton,QuickChoice;
  KatPodr.Kod          'Код'#13'подразделения'  ('код подразделения'                             ,,):[14],Protect,PickButton,QuickChoice;
  KatPodr.Name         'Подразделение'          ('подразделение сотрудника'                      ,,):[25],Protect,PickButton,QuickChoice;
  DEPFUNC.NMFUNC       'Функция'                ('произв.функция подразделения сотрудника'                      ,,):[25],Protect,PickButton,QuickChoice;
  GP_RaspVO.Procent    'Процент'                ('поля для ручного ввода цифрового значения (10; 15,24; 30,5 и т.д.)',,#(sciEditFld)):[6,2],#(Protect);
  GP_RaspVO.Schet      'Счет'                   (' Наименование счета'                            ,,):[10],Protect,NoDel,PickButton,QuickChoice;
  GP_RaspVO.SubSch     'Субсчет'                (' Наименование счета'                            ,,):[10],Protect,NoDel,PickButton,QuickChoice;
  BuhSchet.Name        'Наименование'#13'счета' (' Наименование счета'                            ,,):[20],Protect,NoDel,PickButton,QuickChoice;
  MnPlan.Number        'Код'#13'заказа'         (' аналитика <Заказ>'                            ,,):[10],Protect,NoDel,PickButton,QuickChoice;
  GP_RaspVO.Datan      'Дата'#13'начала'        ('дата начала действия записи'      ,,#(sciEditFld)):[12],#(Protect);
  GP_RaspVO.DataOk      'Дата'#13'окончания'     ('дата окончания действия условий'  ,,#(sciEditFld)):[12],#(Protect);
  GP_RaspVo.isArh      'Арх.'                   :[5],[List 0 'нет','да'], Protect;
  x$users.XU$FULLNAME  'Автор'                  ('Пользователь, создавший запись'   ,,#(sciEditFld)):[12],Protect,NoDel,NoPickButton;

  GP_RaspVO.DInput  'Дата'#13'ввода'            ('дата ввода'                       ,,#(sciEditFld)):[12],Protect,NoDel,NoPickButton;
#END
Browse brRaspActive 'Активные записи' ('Активные записи ',,sci1378Esc);
#brRasp(sci178Esc,Active,NoProtect,оплат)
end;
Browse brRaspArh   'Архив' ('Архив',,sci1Esc);
#brRasp(sci1Esc,Arh,Protect,оплат)
end;

end;//TabbedSheet bottom tab_Rasp;
#UNDEF brRasp

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  TableEvent Table GP_RaspVO;
  //--------------------------
  cmSetDefault:
  { //Пока не уверен ClearBuffer(#GP_RaspVO)
    if wIsArh=1
    { //Message('В архивных записях изменение запрещено');
      abort;
    }

    GP_RaspVO.Nrec:=0;
    GP_RaspVO.TP       := wTp   ;// ссылка на лицевой счет
    GP_RaspVO.VidOpl   := wVidopls;// ссылка на справочник
    if wVidopls<>0
    { if wTp=0
      { GP_RaspVO.VidOplp:=KlVidOpl.Vidoplp
      }
      else
      { GP_RaspVO.VidOplp:=KlVidUd.Vidudp
      }
    }
    GP_RaspVO.cKatPodr := pKatPodr;// ссылка на подразделение
    GP_RaspVO.Datan    := dDatan  ;// заданный период c
    GP_RaspVO.DataOk   := dDatok  ;// заданный период по
    GP_RaspVO.isArh    := wisArh  ;
    GP_RaspVO.cUser    := UserId();
    GP_RaspVO.DInput   := Cur_Date;
    GP_RaspVO.Schet    := sSchet;
    GP_RaspVO.SubSch   := sSubSch;
    if IsBitCTW(wFilter,1)
    { GP_RaspVO.cKatPodr:=pKatPodr;
    }
    if IsBitCTW(wFilter,2)
    { GP_RaspVO.cMnPlan:=pMnPlan;
    }
  } //cmSetDefault:

  //--------------------------
  cmInsertRecord:
  { if wisArh=1
    { Message('В архивных записях изменение запрещено');
      ReReadRecord(#GP_RaspVO);
      abort;
    }
    Insert Current GP_RaspVO;
  }//cmInsertRecord:

  //--------------------------
  cmUpdateRecord:
  { if (wisArh=1 and GP_RaspVo.isArh=1)
    { Message('В архивных записях изменение запрещено');
      ReReadRecord(#GP_RaspVO);
      SetModified(false);
      Exit;
    }
    Update Current GP_RaspVO;
  } //cmUpdateRecord:

  //--------------------------
  cmCheckField:
  { Case Curfield of
    #GP_RaspVo.isArh:
    { if GP_RaspVo.DataOk<>ZeroDate
      if GP_RaspVo.DataOk<dOtchPer and GP_RaspVo.isArh=0
      { if message('Период записи находится в архиве!'
          +chr(13)+'Убрать дату окончания?',YesNo)<>cmYes
        { set GP_RaspVo.isArh:=1;
        }
        else
        { GP_RaspVo.DataOk:=ZeroDate;
        }
      }
    }
    #GP_RaspVO.DataN:
    { if GP_RaspVO.DataOk<>ZeroDate
      { if GP_RaspVO.DataOk<GP_RaspVO.DataN
        { Message('Дата окончания меньше даты начала');
          set GP_RaspVO.DataOk:=GP_RaspVO.DataN
        }
      }
    }
    #GP_RaspVO.DataOk:
    { if GP_RaspVO.DataOk<>ZeroDate
      { if GP_RaspVO.DataOk<GP_RaspVO.DataN
        { Message('Дата окончания меньше даты начала');
          set GP_RaspVO.DataOk:=GP_RaspVO.DataN;
        }
        if GP_RaspVO.DataOk<dOtchPer
        { if Message('Дата окончания меньше даты начала периода'
            +chr(13)+'Запись будет переведена в архив'
            +chr(13)+'Исправить?'
           ,YesNo )=cmYes
          {  set GP_RaspVO.DataOk:=Date(Last_Day(dOtchPer),Month(dOtchPer),Year(dOtchPer));
          }
          else
          { set GP_RaspVO.isArh:=1;
            update current GP_RaspVo;
            SetModiFied(False);
            //ReReadRecord(#GP_RaspVo);
          }
        } //if GP_RaspVO.DataOk<dOtchPer
      } //if GP_RaspVO.DataOk<>ZeroDate
    } //#GP_RaspVO.DataOk:
    end;
  } //cmCheckField:

  //--------------------------
  cmDeleteRecord:
  { if wIsArh=1
    { Message('В архивных записях изменение запрещено');
      abort;
      exit;
    }

    if Message('Удалить запись'
      +chr(13)+if(GP_RaspVO.Datan<>ZeroDate,DateToStr(GP_RaspVO.Datan,' от DD.MM.YYYY'),'')
        ,YesNo      )=cmYes
    { Delete Current GP_RaspVO;
    }
  } //cmDeleteRecord:
  end; //TableEvent Table GP_RaspVO

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //--------------------------
    cmInit:
    { LoadInterface(true);
      SetFilterBounds(wIsArh);
    }
    cmDone:
    { UnLoadInterface(true)

    }
    //--------------------------
    cmOnVipLoad:
    { LoadInterface(false);
    }
    //--------------------------
    cmOnVipUnLoad:
    { UnLoadInterface(false);
    }

    //--------------------------
    cmOpenSearch :
    {
      isOpenSearch:= true;
      ProcessCommand(cmPick);
      isOpenSearch:= false;
    }

    //--------------------------
    cmPick:
    {
      //сначала обработаем фильтры, для других полей будет запрет
      case CurField of
      #Filtr_Katpodr:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Katpodr);
        StoreMarker(Marker_KatPodr,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_KatPodr,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_KatPodr,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          BitOnW(wFilter,1);
          SetFilterNm(#Filtr_Katpodr);
        }
        exit;
      }
      #Filtr_MnPlan:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Zakaz);
        StoreMarker(Marker_MnPlan,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Zakaz,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_MnPlan,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_MnPlan);
          BitOnW(wFilter,2);
        }
        exit;
      }
      #Filtr_DepFunc:
      { KauMarkerName := 'MGetDepFunc';
        StoreMarker(Marker_DepFunc,KauMarkerName);
        l_nrec:=0;
        if RunInterface(SelDepFn, l_nrec, 2)<>cmCancel //M_CONTROL
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_DepFunc,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_DepFunc);
          BitOnW(wFilter,5);
        }
        exit;
      }

      #sSchet, #sSubSch, #BuhSchet_Flt.Name :
      { var _sSchet:string;
        _sSchet:=PlansSch.Kod+sSchet;
        if runinterface(F_BUHSCHET::GETBUHSCHET,cgiPick,MyPlansNo,_sSchet,sSubSch)<>cmCancel //cgiPickMult cgiNotClear
        { set  sSchet :=Substr(_sSchet,2,100);
          set  sSubSch:=sSubSch;
          BitOnW(wFilter,3);
        }
        exit;
      }
      #VidOplUdName_Flt:
      {
        var _wVidOpl:LongInt;// ТИП другой!
        _wVidOpl:=wVidopls;
        if wTp=0
        { if runinterface('VidOplU',_wVidOpl)<>cmCancel
          { set wVidopls:=_wVidOpl;
            BitOnW(wFilter,4);
          }
        }
        else
        { if runinterface('VidUderU',GP_RaspVO.vidopl)<>cmCancel
          { set wVidopls:=wVidopls;
            BitOnW(wFilter,4);
          }
        }
        exit;
      }
      end;

      //------------------------------------
      if wIsArh=1
      { if (CurField<>#GP_RaspVo.isArh)
        { Message('В архивных записях изменение запрещено');
          exit;
        }
        else
        if GP_RaspVo.DataOk<>ZeroDate
        { if GP_RaspVo.DataOk<dOtchPer
          { message('Признак архива не может быть изменен для записей прошлых периодов')
          }
        }
      }//if wIsArh=1
      //------------------------------------
      var _cgi:word;
      _cgi:=if(QuickChoiceName<>'',cgiPick, cgiPickMult);
      Case Curfield of
      #KatPodr.Kod ,#KatPodr.Name:
      { if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed';
        pTmp:=GP_RaspVO.cKatPodr;
        if iGetKau.GetCodeKau(_cgi, cgKau_Katpodr, pTmp)<>0 //cmCancel
        { if _cgi=cgiPick
          { set GP_RaspVO.cKatPodr:=pTmp;
          }
          else
          { var ii:longint=0;
            KauMarkerName := iGetKau.GetMarkerName(cgKau_Katpodr);
            Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
            For(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
            { if GetMarker(Marker_Tmp,ii,pTmp) {}
              if ii=0
              { set GP_RaspVO.cKatPodr:=pTmp;
                SetModified(true);
                UpdateTable;
              }
              else
              { GP_RaspVO.Nrec:=0;
                GP_RaspVO.cKatPodr:=pTmp;
                //остальное просто скопируем
                Insert Current GP_RaspVO;
              }
            }
            DoneMarker(Marker_Tmp,'');

          } //else if _cgi=cgiPick
        } //if iGetKau.GetCodeKau(_cgi, cgKau_Katpodr, pTmp)<>0 //cmCancel
        ReScanPanel(#GP_RaspVO);
      } //#KatPodr.Kod ,#KatPodr.Name
      #DEPFUNC.NMFUNC : //     'Функция'
      { var ltmp:longint;
        lTmp:=GP_RaspVO.cAddFld[1];
        if RunInterface(SelDepFn, lTmp, 0)<>cmCancel //M_CONTROL
        { set GP_RaspVO.cAddFld[1]:=lTmp
        }
      } //#DEPFUNC.NMFUNC
      #MnPlan.Number:
      { if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed';
        pTmp:=GP_RaspVO.cMnPlan;
        if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
        { set GP_RaspVO.cMnPlan:=pTmp;
          pBuhSchet_Z:=0;
          if getfirst MNPlan=tsok
          { pBuhSchet_Z:=GetMnPlanBuhSchet(GP_RaspVO.cMnPlan);
          }
          if getfirst BuhSchet_Z=tsok
          { set GP_RaspVO.cBuhSchet:=BuhSchet_Z.Nrec;
            var isNeed:boolean=false;
            if GP_RaspVO.Schet=''
            { isNeed:=true;
            }
            else
            { if GP_RaspVO.Schet <>Substr(BuhSchet_Z.Schet,2,100)
              or GP_RaspVO.SubSch<>BuhSchet_Z.SubSch
                if message('Заменить счет '+GP_RaspVO.Schet+'/'+GP_RaspVO.SubSch
                  +chr(13)+'на '+Substr(BuhSchet_Z.Schet,2,100)+'/'+BuhSchet_Z.SubSch
                 ,YesNo)=cmYes
                 isNeed:=true;

            }
            if IsNeed
            { set GP_RaspVO.Schet    :=Substr(BuhSchet_Z.Schet,2,100);
              set GP_RaspVO.SubSch   :=BuhSchet_Z.SubSch;
            }
            ReScanPanel(#GP_RaspVO);
          }
        }//if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
        ReScanPanel(#GP_RaspVO);
      }
      #VidOplUdName,#GP_RaspVO.VidOplP:
      {
        if (QuickChoiceName <> '')  QuickChoiceName := if(CurField=#GP_RaspVO.VidOplP,'qcKau_Needed','qcKau_Needed_Name');
        var _wVidOpl:LongInt;// ТИП другой!
        _wVidOpl:=GP_RaspVO.VidOpl;
        if wTp=0
        { if runinterface('VidOplU',_wVidOpl)<>cmCancel
          { set GP_RaspVO.VidOpl:=_wVidOpl;
            set GP_RaspVO.VidOplp:=KlVidOpl.Vidoplp;
          }
        }
        else
        { if runinterface('VidUderU',GP_RaspVO.vidopl)<>cmCancel
          { set GP_RaspVO.VidOpl:=GP_RaspVO.VidOpl;
            set GP_RaspVO.VidOplp:=KlVidUd.Vidudp
          }
        }
        SetModified(true);
        UpdateTable;
      }
      #GP_RaspVO.Schet,#GP_RaspVO.SubSch,#BuhSchet.Name:
      { var _sSchet:string;
        _sSchet:=PlansSch.Kod+GP_RaspVO.Schet;
        if runinterface(F_BUHSCHET::GETBUHSCHET,cgiPick,MyPlansNo,_sSchet,GP_RaspVO.SubSch)<>cmCancel //cgiPickMult cgiNotClear
        { set  GP_RaspVO.Schet :=Substr(_sSchet,2,100);
          set  GP_RaspVO.SubSch:=GP_RaspVO.SubSch;
          set  GP_RaspVO.cBuhSchet:=BuhSchet.Nrec;
          SetModified(true);
          UpdateTable;
        }
      }
      end;
    } //cmPick:

    //--------------------------
    cmDelOnProtect:
    {
      Case Curfield of
      #Filtr_Katpodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,1);
        wFilter:=SetBit(wFilter,1,false);
        SetFilterNm(#Filtr_Katpodr);
        exit;
      }
      #Filtr_MnPlan:
      { ClearMarker(Marker_MnPlan);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_MnPlan);
        exit;
      }
      #sSchet:
      { set sSchet:='';
        set sSubSch:='';
        BitOffW(wFilter,3);
        exit;
      }
      #sSubSch:
      { set sSubSch:='';
        exit;
      }
      #BuhSchet_Flt.Name:
      { set sSchet:='';
        set sSubSch:='';
        BitOffW(wFilter,3);
        exit;
      }
      #VidOplUdName_Flt:
      { set wVidOpls:=0;
        BitOffW(wFilter,4);
        exit;
      }
      #Filtr_DepFunc:
      { ClearMarker(Marker_DepFunc);
        BitOffW(wFilter,5);
        SetFilterNm(#Filtr_DepFunc);
        exit;
      }
      end;
      //------------------------------------
      if wIsArh=1
      { Message('В архивных записях изменение запрещено');
        exit;
      }
      case curField of
      #KatPodr.Kod ,#KatPodr.Name:
      { set GP_RaspVO.cKatPodr:=0;
      }
      #DEPFUNC.NMFUNC : //     'Функция'
      { set GP_RaspVO.cAddFld[1]:=0;
      }
      end;
      //------------------------------------
    }
    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
        RunInterface('ExClassifier', coGP_RaspVO, GP_RaspVO.nRec);
    }

        //--------------------------
    cmFilterSave:
    { UpdateTable;
      //CopyToA; - расскоментировать при наличии проблем
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(wIsArh);
      }
      else RestFromA;
    }

    //--------------------------
    cmValue1: // Скопировать запись
    { UpdateTable;
      if wIsArh=1
      { message('Копирование записей в архиве запрещено');
        abort;
      }
      if isValid(#GP_RaspVo)
      { if message('Скопировать текущую запись?',YesNo)=cmYes
        { GP_RaspVo.Nrec:=0;
          GP_RaspVo.cUser:=UserId();
          GP_RaspVO.DInput   := Cur_Date;
          insert current GP_RaspVo;
          ReScanPanel(#GP_RaspVo);
        }

      } //if isValid(#GP_RaspVo)
    } //cmValue1
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
        RunInterface('Attribute', coGP_RaspVO, GP_RaspVO.nRec);
    }

    //--------------------------
    cmChangeTabbedSheetFormat:
    { case Target of
      brRaspActive :
      { wTp:=0;
        SetFilterBounds(0);
      }
      brRaspArh    :
      { wTp:=0;
        SetFilterBounds(1);
      }
      end;

    } //cmChangeTabbedSheetFormat:

    //--------------------------
    cmHotKeys:
    { ProcessCommand(RunMenu('GP_ZP_RaspZakazVO_mnu'));

    }
  end;//HandleEvent

end.

//меню
GP_ZP_RaspZakazVo_mnu menu
{
- 'Копировать'     , cmValue1, '', hcProc_NagrKaf, 'Alt+1',kbAlt1, scMenuCtx;
-----------;
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Внешняя классификация', cmPickClass , 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
- 'Внешние атрибуты'     , cmPickAttr  , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

} //GP_ZP_RaspZakazPers_mnu menu
