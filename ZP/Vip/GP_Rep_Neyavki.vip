#include Contexts.vih
#include userreport.vih
//#include PsnFuncs.vih
#include XlReport.vih
#include Query.vih

#component "GP_ZP"

interface GP_Rep_Neyavki 'Отчет по неявкам (М,ОЖ,ДО)' escClose;
show(,,38,6);

table struct TmpPers (
  cLSchet      : comp,
  cPers        : comp,
  StrTabN      : string[20],
  FIO          : string[80],
  Yearn        : word,
  Mesn         : word
) with index (
  i01 = cLSchet+Yearn+Mesn
);

table struct TmpIncome (
  cLSchet      : comp,
  cPers        : comp,
  Yearn        : word,
  Mesn         : word,
  Vidopl       : longint,
  SumIncome    : tSumma
) with index (
  i01 = cLSchet+Yearn+Mesn
);

table struct TmpItogPers (
  cLSchet      : comp,
  cPers        : comp,
  StrTabN      : string[20],
  FIO          : string[80],
  Yearn        : word,
  Mesn         : word,
  Neyavka      : string,
  Vidopl       : string,
  SumIncome    : tSumma
) with index (
  i01 = cLSchet+Yearn+Mesn
 ,i02 = cLSchet+Yearn+Mesn+Neyavka
);

var
  RowNo   : longint;
  ColNo   : longint;
  cc   : longint;
  counter : longint;
  colst : longint;
  dLastDay: date;
  dEnd: date;
  wMesn:word;
  wYearn:word;
  sVidopl:string;
  dSumma:double;
  sExcelFname:string;
  CS: IContextSession;

create view
as select *
from  TmpPers,TmpIncome,TmpItogPers
order by TmpItogPers.FIO
;

/*Procedure MyLog(_str: string);
{
  LogStrToFile('doptariff.txt',_str);
} */

Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  //MyLog('sql: ' + add_query_str);
}

Procedure InsTables(); //заполняем базу для сбора отчета
{
  var qStr : longint = 0;
  var objQuery : iQuery;

  StartNewVisual(vtRotateVisual, vfTimer, 'Сбор данных', 0);

  sqlFreeStr(qStr);

    MysqlAddStr(qStr, '   select                                           ');
  MysqlAddStr(qStr, '   lt.clschet             as cLSchet                 ');
  MysqlAddStr(qStr, '  ,lt.tperson             as cPers                   ');
  MysqlAddStr(qStr, '  ,pers.strtabn           as StrTabN                 ');
  MysqlAddStr(qStr, '  ,pers.fio               as FIO                     ');
  MysqlAddStr(qStr, '  ,lt.yearn               as Yearn                   ');
  MysqlAddStr(qStr, '  ,lt.mesn                as Mesn                    ');
  MysqlAddStr(qStr, '  from lstab lt                                      ');
  MysqlAddStr(qStr, '  join persons pers on lt.tperson=pers.nrec          ');
  MysqlAddStr(qStr, '  where lt.yearn='+wYearn+' and lt.mesn='+wMesn+'    ');

  objQuery := queryManager.createQuery(qStr);
  if (objQuery.execute.errorCode != tsOk ) then
  {
    Message('Ошибка поиска данных (TmpPers) '+ objQuery.errorCode, Error);
    sqlFreeStr(qStr);
    StopVisual;
    abort;
    Exit;
  }
  else
  {
    sqlCopyInto(objQuery, tnTmpPers, true);
  }

  sqlFreeStr(qStr);

  MysqlAddStr(qStr, '   select                                                       ');
  MysqlAddStr(qStr, '   sd.clsch             as cLSchet                              ');
  MysqlAddStr(qStr, '  ,sd.tperson           as cPers                                ');
  MysqlAddStr(qStr, '  ,sd.yearn             as Yearn                                ');
  MysqlAddStr(qStr, '  ,sd.mesn              as Mesn                                 ');
  MysqlAddStr(qStr, '  ,sd.vidoplp           as Vidopl                               ');
  MysqlAddStr(qStr, '  ,sum(sd.summa)        as SumIncome                            ');
  MysqlAddStr(qStr, '  from sumvidop sd                                              ');
  MysqlAddStr(qStr, '  where sd.yearn='+wYearn+' and sd.mesn='+wMesn+'               ');
  MysqlAddStr(qStr, '  group by sd.clsch, sd.tperson, sd.yearn , sd.mesn ,sd.vidoplp ');

 MysqlAddStr(qStr, '  union all                                                             ');

 MysqlAddStr(qStr, '  select                                                                ');
 MysqlAddStr(qStr, '   nach.clsch             as cLSchet                                    ');
 MysqlAddStr(qStr, '  ,nach.tperson           as cPers                                      ');
 MysqlAddStr(qStr, '  ,nach.yearn             as Yearn                                      ');
 MysqlAddStr(qStr, '  ,nach.mesn              as Mesn                                       ');
 MysqlAddStr(qStr, '  ,nach.vidopl           as Vidopl                                      ');
 MysqlAddStr(qStr, '  ,sum(nach.summa)        as SumIncome                                  ');
 MysqlAddStr(qStr, '  from nachisl nach                                                     ');
 MysqlAddStr(qStr, '  where nach.yearn='+wYearn+' and nach.mesn='+wMesn+'                   ');
 MysqlAddStr(qStr, '  group by nach.clsch, nach.tperson, nach.yearn , nach.mesn ,nach.vidopl');

 MysqlAddStr(qStr, '  union all                                                             ');

 MysqlAddStr(qStr, '   select                                                               ');
 MysqlAddStr(qStr, '   nn.clsch             as cLSchet                                      ');
 MysqlAddStr(qStr, '  ,nn.tperson           as cPers                                        ');
 MysqlAddStr(qStr, '  ,nn.yearn             as Yearn                                        ');
 MysqlAddStr(qStr, '  ,nn.mesn              as Mesn                                         ');
 MysqlAddStr(qStr, '  ,nn.vidopl           as Vidopl                                        ');
 MysqlAddStr(qStr, '  ,sum(nn.summa)        as SumIncome                                    ');
 MysqlAddStr(qStr, '  from nenach nn                                                        ');
 MysqlAddStr(qStr, '  where nn.yearn='+wYearn+' and nn.mesn='+wMesn+'                       ');
 MysqlAddStr(qStr, '  group by nn.clsch, nn.tperson, nn.yearn , nn.mesn ,nn.vidopl          ');

  objQuery := queryManager.createQuery(qStr);
  if (objQuery.execute.errorCode != tsOk ) then
  {
    Message('Ошибка поиска данных (TmpIncome) '+ objQuery.errorCode, Error);
    sqlFreeStr(qStr);
    StopVisual;
    abort;
    Exit;
  }
  else
  {
    sqlCopyInto(objQuery, tnTmpIncome, true);
  }

  sqlFreeStr(qStr);

  StopVisual;
}

Procedure InsItog();//собираем все в одну таблицу
var jj:word;
{
  var ii:longint;
  StartNewVisual(vtRotateVisual, vfTimer, 'Отбор сотрудников с неявками', 0);
  //Заполняем только тех работников, у которых есть неявки 'М','ОЖ','ДО'
   _loop TmpPers
  {
    ClearBuffer(#TmpItogPers);
    if (LoadWorkingTable(TmpPers.cLSchet, TmpPers.Mesn, TmpPers.Yearn) = 0) //загружаем табель
    {
      if WT_LoadMonthlyAbsences = 0 //проверка на наличие неявок
       {
         var _AbsenceCount:longint=WT_GetAbsenceCount(atMonthly); //записываем кол неявок
         for(jj := 0; jj < _AbsenceCount; Inc(jj))
         {
           var _aaMark:string;
           _aaMark:='';
           if not WT_GetAbsenceAttribute(atMonthly, jj, aaMark, _aaMark) then continue; //получаем тип неявки
           case _aaMark of
           'М','ОЖ','ДО':
           {
             if getfirst TmpItogPers where ((TmpPers.cLSchet==TmpItogPers.cLSchet and TmpPers.Yearn==TmpItogPers.Yearn
                                              and TmpPers.Mesn==TmpItogPers.Mesn and _aaMark==TmpItogPers.Neyavka )) <> tsOk
             {
               TmpItogPers.cLSchet   := TmpPers.cLSchet;
               TmpItogPers.cPers     := TmpPers.cPers;
               TmpItogPers.StrTabN   := TmpPers.StrTabN;
               TmpItogPers.FIO       := TmpPers.FIO;
               TmpItogPers.Yearn     := TmpPers.Yearn;
               TmpItogPers.Mesn      := TmpPers.Mesn;
               TmpItogPers.Neyavka   := _aaMark;
               TmpItogPers.Vidopl    := '';
               TmpItogPers.SumIncome := 0;
               insert current TmpItogPers;
             }//if getfirst TmpItogPers

           }//'М','ОЖ','ДО'
           end;
         } //for(jj := 0; jj < _AbsenceCount; Inc(jj))
       }//if WT_LoadMonthlyAbsences = 0
    }// if (LoadWorkingTable(TmpPers.cLSchet, TmpPers.Mesn, TmpPers.Yearn) = 0)
  }//_loop TmpPers
  StopVisual;

  //Собриаем суммы дохода
  StartNewVisual(vtRotateVisual, vfTimer, 'Собираем суммы дохода', 0);
  _loop TmpItogPers
  {
    ii:=0;
    _loop TmpIncome where ((TmpItogPers.cLSchet==TmpIncome.cLSchet and TmpItogPers.yearn==TmpIncome.yearn and TmpItogPers.mesn==TmpIncome.mesn))
    {
      ii++;
      if ii=1
      {
        sVidopl:= string(TmpIncome.Vidopl);
        dSumma := TmpIncome.sumincome;
      }
      if ii>1
      {
        sVidopl:=sVidopl+','+string(TmpIncome.Vidopl);
        dSumma :=dSumma+TmpIncome.sumincome;
      }
    }//_loop TmpIncome

   if ii>0
   {

     TmpItogPers.vidopl:=sVidopl;
     TmpItogPers.SumIncome:=dSumma;
     update current TmpItogPers;
   }
  }//_loop TmpItogPers
  StopVisual;

}

Procedure PrintEx();
{
  var _k : longint = 0;
  _k := recordsintable(tnTmpItogPers);
  if _k=0
  {
    message('Нет данных для построения отчета!');
    abort;exit;
  }

  StartNewVisual(vtRotateVisual, vfTimer, 'Печать', 0);
  if (not xlCreateExcel('Rep_Neyavki' + DateToStr(Cur_Date(), '_DD_MM_YYYY') + TimeToStr(Cur_Time(), '_HH_MM_SS') + '.xlsx', true)) then
  {
    message('Не удалось открыть сессию Exel', error); exit;
  }
  if not xlIsExcelValid {
    message('Не удалось подключиться к Exel'); exit;
  }

  ColNo := 0;
  // Заполняем шапку
  xlSetCellStringValue('Отчет по неявкам ("М","ОЖ","ДО") за '+DateToStr(dLastDay, 'month YYYY'), 1, 1 ,1 ,1);
  xlSetCellStringValue('№ п/п', 2, ++ColNo ,2 ,ColNo);
  xlSetCellStringValue('Ф. И. О.', 2, ++ColNo ,2 ,ColNo);
  xlSetCellStringValue('Таб. номер', 2, ++ColNo ,2 ,ColNo);
  xlSetCellStringValue('Код в табеле', 2, ++ColNo ,2 ,ColNo);
  xlSetCellStringValue('Вид оплат', 2, ++ColNo ,2 ,ColNo);
  xlSetCellStringValue('Сумма дохода за месяц', 2, ++ColNo ,2 ,ColNo);
  colst:=ColNo;
  //Заполняем данными
  xlCreateMatrix(_k, ColNo);
  RowNo := 0;
  CC:=0;
  counter:=3;

  _loop TmpItogPers
  {
    CC++; RowNo++;
    ColNo := 0;
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + CC                     );
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + TmpItogPers.fio        );
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + TmpItogPers.StrTabN    );
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + TmpItogPers.Neyavka    );
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + TmpItogPers.Vidopl     );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           TmpItogPers.SumIncome  );

    if RowNo = 1000
        {
          xlWriteMatrixToExcel(counter, 1);
          counter:= counter + RowNo;
          xlClearMatrix;
          RowNo:= 0;
        }
  }
  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + RowNo;
  XLFREEMATRIX;
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0,
                 2, 1, counter, colst);
  xlAlignCells(xlLeft,1,1,counter,colst);
  xlSetColumnWidth(23,1,1,counter,colst);
  xlKillExcel;
  StopVisual;
}

screen sc1 (,,sci1EnEsc);
  fields
    dLastDay: NoProtect;
  buttons
    cmOk, default;
    cmCancel;
<<

 `Последняя дата месяца`.@@@@@@@@@@@@@

 <. Продолжить .>        <. Отмена .>
>>
end;

handleevent
  cmInit:
  {
    dLastDay:=date(last_day(cur_date), month(cur_date), year(cur_date));

    var CL: ContextList;
    // захват прикладных контекстов
    if (not CL.Add(CS, 'WorkingTable'))
    {
      abort;
      exit;
    }

  }

  cmOk:
  {
    wMesn  := month(dLastDay);
    wYearn := year(dLastDay);

    InsTables;
    InsItog;
    PrintEx;
  }

end;
end.


VipInterface UserReport_GP_Rep_Neyavki Implements IUserReport;
Interface UserReport_GP_Rep_Neyavki;

Procedure Run;
Begin
  RunInterfaceNoModal(GP_ZP::GP_Rep_Neyavki);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Отчет по мобилизованным и отпусках (М,ОЖ,ДО)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  #__UNUSED__(Level)
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 0;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
