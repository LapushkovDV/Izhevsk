#component "Z_SREDN"
#doc
Список отпусков
<p>#1191
<p>#2077
<p>#3209 добавить 2 колонки: дата утверждения приказа и кто утвердил приказ
#end
Alter Interface ZOTPUSK1;
//'Z_SREDN::OTPUSK1.FZARP.AROTPUSKBROWSE.PODNALO1'
//------------------------------------------
ExtendFormats FactOtpusk;
//------------------------------------------
//------------------------
var
//#3209
 pVA_TitleDoc_Confirm_User:comp;//'.Утвердил, Пользователь'
 pVA_TitleDoc_Confirm_Date:comp;//'.Утвердил, Дата'
//**************************************888888
Create view
  ZOtpusk
as select
  if(LSCHET.SUMMA27 = 0, 'нет', 'да')
  (fieldname = Summa27Str) //есть ли удержание в банк

;

Create view vSpr
var
 pUserID:comp;
as select X$users.XU$FULLNAME
from X$users(ReadOnly)
where ((
  pUserId == X$users.Atl_Nrec
));

//----------------------
// утвердил приказ
//----------------------
Function GetOrderUser(_pContDoc:comp):string;cacheable;
{ Result:='';
  if not IsValidAll(#TitleDoc) then exit;
  vSpr.pUserID:=comp(sGetAttrID(coTitleDoc,TitleDoc.Nrec,pVA_TitleDoc_Confirm_User));
  if vSpr.pUserID=0 vSpr.pUserID:=TitleDoc.Atl_LastUser;
  if vSpr.Getfirst X$users = tsok Result:=MyGetInitial(vSpr.X$users.XU$FULLNAME,True);
} //Function GetOrderUser(_pContDoc:comp):string;cacheable;

//----------------------
// утвердил приказ
//----------------------
Function GetOrderDate(_pContDoc:comp):date;cacheable;
{ Result:=ZeroDate;
  if not IsValidAll(#TitleDoc) then exit;
  Result:=dGetAttrID(coTitleDoc,TitleDoc.Nrec,pVA_TitleDoc_Confirm_Date);
  if Result=ZeroDate Result:=TitleDoc.Atl_LastDate;
} //Function GetOrderDate(_pContDoc:comp):date;cacheable;

//*********************************************8
//------------------------------------------------------------------------------
  browse FactOtpusk ( , hcotpras, scintiVInsPM);
  //show at (,,,18);
  table FACTOTPUSK;
    Fields
      katpodr.kod 'код.подр' ('код.подр') :[6],Protect,NoDel;
      Summa27Str 'Банк' ('Признак перечисления зарплаты в банк',,) :[4],Protect,NoDel;
      GetOrderDate(FactOtpusk.cContDoc) 'дата утверждения' :[11],Protect,NoDel;
      GetOrderUser(FactOtpusk.cContDoc) 'утвердил приказ'  :[15],Protect,NoDel;
  end;//browse FactOtpusk;

//******************************************************************************
// события интерфейса
//******************************************************************************
HandleEvent
//-------------
cmInit:
{ //--- #3209
  pVA_TitleDoc_Confirm_User:=ExtAttr_Create(coTitleDoc,'.Утвердил, Пользователь',cgAttrType_Str);
  pVA_TitleDoc_Confirm_Date:=ExtAttr_Create(coTitleDoc,'.Утвердил, Дата'        ,cgAttrType_Date);

  //--------------------
  case Inherited::HandleEvent(cmInit) of
  heAbort :  Abort;
  heStop  :  Exit;
  end;
  //--------------------
}
end;
end.
