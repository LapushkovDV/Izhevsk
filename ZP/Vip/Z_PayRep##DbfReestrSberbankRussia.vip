    cmPick:
    {
      case CurField of
        #CurDirFilePath:
        {
          SetDirPathName(FileNetConnect_FolderDialog(DirPathName,'Выбор каталога ...'));
          boChangeField := true;
          //RefreshPath;
        }
      else inherited :: handleEvent (cmPick);
     end; // case CurField of
    }
  end;  // HandleEvent window SberbankRussiaTemplateWindow   */

end.
