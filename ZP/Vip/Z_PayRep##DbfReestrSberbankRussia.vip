#COMPONENT "Z_PayRep"
Alter interface DbfReestrSberbankRussia;
overload
function GetUseFileName: string;
function GetNumb( cSym : char ) : string;
procedure LoadFromTemplate;
function GetDirFilePath( boLoadPar : boolean ): string;
procedure pSaveNameFileSbBan(sFileName_: string);
function GetAssignation: string;
end;

var EMBatchMode: boolean = false;

function GetAssignation: string;
{
  if EMBatchMode
    Result := GetNumZach;
  else
    Result := inherited::GetAssignation;
}

procedure pSaveNameFileSbBan(sFileName_: string);
{
  if EMBatchMode
  {
    var sName: string = BuhXml_ExtractFileName(sFileName_);
    sSetAttr(coSbban, SbBan.Nrec, 'Имя файла', sName);
    exit;
  }
  inherited::pSaveNameFileSbBan(sFileName_);
}

  function GetNumb( cSym : char ) : string;
  {
    case UseNumRees of
     0: Result := LPadCh(GetSessionNumb, cSym, 2);         // 0 - номер сессии -> счетчика сессий
     1: Result := LPadCh(SbBan.LastUser, cSym, LenStretch);// 1 - из реестра SbBan.LastUser
    end;
  }

  function GetUseFileName: string;
  {
     var EM_Type: string;
     EM_Type := '';
      case SBBAN.PREFIX of     // function GetVidDoc(Pref: string): string; из Z_PAYREP::VIEWREESCOMBO (Z\Z_PayRep\vip\VIEWREES.VIP)
        'R$A':  EM_Type := 'ap';//'АВАН';
        'R$Z':  EM_Type := 'zp';//'ИТРЗ';
        else EM_Type := 'vp';//'ГР';
        /*
        'R$$':  EM_Type := 'vp';//'ГР';
        'R$AL': EM_Type := 'АЛИМ';
        'R$D':  EM_Type := 'СТВЗ';
        'S$':   EM_Type := 'НФОТ';
        'RV':   EM_Type := 'НЧВП';
        'RU':   EM_Type := 'УДВП';
        'RM':   EM_Type := 'ПМАТ';
        'RD':   EM_Type := 'ПДЕТ';
        'RRD':  EM_Type := 'РДЕТ';
        'R#Z':  EM_Type := 'ДОГП';
        'R#A':  EM_Type := 'ДОГП';
        'RO':   EM_Type := 'ОТПС';
        'RP':   EM_Type := 'ПРЕМ';
        'RB':   EM_Type := 'БЛНЛ';
        */
      end;
        
    // обновим маску имени файла
    SetMaskFileName;
    // формируем полное имя файла
    var gozAbbr: string = '';
    if EMBatchMode
      gozAbbr := sGetAttr(covPlan, coGetAttr(coSbBan, SbBan.Nrec, 'Группа заказов'), 'Аббревиатура');
    if gozAbbr <> '' gozAbbr := gozAbbr + '_';
    Result := gozAbbr + GetPrefixFileName + LPadCh(GetBankFileName, '0', 4) + EM_Type + DateToStr(Cur_Date,'YYMM')+ GetNumb('0') +
              GetAdditionalAttr + '.' + GetFileExtension;

//  По Шаблону Энергомаш

  }
  procedure LoadFromTemplate;
  {
    inherited :: LoadFromTemplate;
   // RefreshPath;
  }
  function GetDirFilePath( boLoadPar : boolean ): string;
  {
    RefreshPath;
    result := inherited :: GetDirFilePath( boLoadPar);
    timelog('GetDirFilePath = ' + Result);
  }
