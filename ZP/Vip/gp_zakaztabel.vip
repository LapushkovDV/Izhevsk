          xlsetcellstringvalue(itogpodr10, lastRow + 8, lastCol + 1, lastRow + 8, lastCol + 1);
          xlsetfontstyle(1, lastRow + 5, lastCol + 1, lastRow + 8, lastCol + 1);
        }

        i13:= 0;
        i5:= 0;
        i9:= 0;
        i10:= 0;
      }

      lastRow:= lastRow + 8;
      xlframecells(1+2+4+8+32, 3, 1, 1, NextPodr + 2, 1, lastRow + 1, lastCol + 1);
    }

  if countpodr <> 0
  {
    delete all from tzakaz;

    ClearQuery(vliSQLCommand);
    PrepareSQLQuery('select mnplan.number, nachislzakaz.vidopl, sum(nachislzakaz.chasf)');
    PrepareSQLQuery('from mnplan');
    PrepareSQLQuery('left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7');
    PrepareSQLQuery('left join katpodr on katpodr.nrec = nachislzakaz.cexoz');
    PrepareSQLQuery('inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)');
    PrepareSQLQuery('join attrnam an1 on an1.wtable = 1413 and an1.name = ''Вид производства''');
    PrepareSQLQuery('left join attrval on attrval.crec = katpodr.nrec and attrval.cattrnam = an1.nrec and attrval.wtable = 1413');
    PrepareSQLQuery('where attrval.vstring = ''Научно-испытательный комплекc'' and (katpodr1.nrec in (select tSelPodrUser.nrec from tSelPodrUser)) and mnplan.number <> ''''  and nachislzakaz.yearn = '+god+'');
    PrepareSQLQuery('and (nachislzakaz.vidopl = 1 or nachislzakaz.vidopl = 3 or nachislzakaz.vidopl = 5 or nachislzakaz.vidopl = 9 or nachislzakaz.vidopl = 10)');
    PrepareSQLQuery('group by mnplan.number, nachislzakaz.vidopl');
    stmt:=0;
    stmt := sqlAllocStmt;
    wErr:=ExecDSQLex(tntzakaz);

    delete all from tzakazmes;

    ClearQuery(vliSQLCommand);
    PrepareSQLQuery('select mnplan.number, nachislzakaz.mesn, nachislzakaz.vidopl, sum(nachislzakaz.chasf)');
    PrepareSQLQuery('from mnplan');
    PrepareSQLQuery('left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7');
    PrepareSQLQuery('left join katpodr on katpodr.nrec = nachislzakaz.cexoz');
    PrepareSQLQuery('inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)');
    PrepareSQLQuery('join attrnam an1 on an1.wtable = 1413 and an1.name = ''Вид производства''');
    PrepareSQLQuery('left join attrval on attrval.crec = katpodr.nrec and attrval.cattrnam = an1.nrec and attrval.wtable = 1413');
    PrepareSQLQuery('where attrval.vstring = ''Научно-испытательный комплекc'' and (katpodr1.nrec in (select tSelPodrUser.nrec from tSelPodrUser)) and mnplan.number <> ''''  and nachislzakaz.yearn = '+god+'');
    PrepareSQLQuery('and (nachislzakaz.vidopl = 1 or nachislzakaz.vidopl = 3 or nachislzakaz.vidopl = 5 or nachislzakaz.vidopl = 9 or nachislzakaz.vidopl = 10)');
    PrepareSQLQuery('group by mnplan.number, nachislzakaz.mesn, nachislzakaz.vidopl');
    stmt:=0;
    stmt := sqlAllocStmt;
    wErr:=ExecDSQLex(tntzakazmes);

    lastRow:= lastRow + 3;
    counterC:= 3;
    itogvidpr13:= 0;
    itogvidpr5:= 0;
    itogvidpr9:= 0;
    itogvidpr10:= 0;
    sumvidpr13:= 0;

    xlsetcellstringvalue('ИТОГО НИК', LastRow, 2, LastRow, 2);
    xlsetcellstringvalue('Я', LastRow, 3, LastRow, 3);
    xlsetcellstringvalue('К', LastRow + 1, 3, LastRow + 1, 3);
    xlsetcellstringvalue('Р', LastRow + 2, 3, LastRow + 2, 3);
    xlsetcellstringvalue('С', LastRow + 3, 3, LastRow + 3, 3);
    xlsetfontstyle(1, LastRow, 2, LastRow + 3, 3);
    xlAlignCells(-4108, LastRow, 2, LastRow, 2);

    ItogRasshifr;
  }

    xlsetcellstringvalue('Фактически отработанные часы (табель)', 1, 1, 1, 1);
    xlmergecells(1, 1, 1, lastCol + 1);
    xlAlignCells(-4108, 1, 1, 1, lastCol + 1);


  xlkillExcel;
}

SubBounds(tbRmtSelPodr2);
AddBounds(tbRmtSelPodr1);
StopVisual('',0);
}

end;

windowevent wnSelPodr;

cmDefault:
{
    if pMarkerpodr.count = 0
    {
      podr:= 'Не выбрано';
    }

    SubBounds(tbRmtSelPodr1);
    AddBounds(tbRmtSelPodr2);

    _loop pMarkerpodr
    {
      if pMarkerpodr.count = 1
      {
        podr:= tSelPodr.kod + ' ' + tSelpodr.name;
      }
    }

    SubBounds(tbRmtSelPodr2);
    AddBounds(tbRmtSelPodr1);

    if pMarkerpodr.count > 1
    {
      podr:= 'Выбрано ' + pMarkerpodr.count;
    }

  rescanpanel(scr);
}

end;
end.

VipInterface UserReport_zakaztabel Implements IUserReport;
Interface UserReport_zakaztabel;

Procedure Run;
Begin
  runinterface(gp_zakaztabel);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Фактически отработанные часы (табель)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Экономическая и статистическая отчетность';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

end.
