      xlsetcellnumbervalue(itogvidprDEC9, LastRow + 62, lastCol + 1, LastRow + 62, lastCol + 1);
      xlsetcellnumbervalue(itogvidprDEC10, LastRow + 63, lastCol + 1, LastRow + 63, lastCol + 1);
    }

    xlsetfontstyle(1, LastRow, lastCol + 1, LastRowI, lastCol + 1);

    xlframecells(1+2+4+8+32, 3, 1, 1, Lastrow - 1, 1, lastRowI + 1, lastCol + 1);

end;

handleevent

cmInit:
{
  pUserName:= UserName();
  god:= year(dgettune('UP.DATOTCH'));
  podr:= 'Не выбрано';

  sql
  select katpodr1.nrec, katpodr1.kod, katpodr1.name, attrval.vstring
  from katpodr
  inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
  join attrnam an1 on an1.wtable = 1413 and an1.name = 'Вид производства'
  left join attrval on attrval.crec = katpodr.nrec and attrval.cattrnam = an1.nrec and attrval.wtable = 1413
  inner join zar_user on (upper(zar_user.ownname) = upper(:(pUserName)))
  where (attrval.vstring = 'Конструкторское бюро' or attrval.vstring = 'Научно-испытательный комплекc') and (zar_user.podrshare <> '+' or (katpodr1.nrec in (select userrights.crecds from userrights where zar_user.ownname = userrights.ownname)))
  group by katpodr1.nrec, katpodr1.kod, katpodr1.name, attrval.vstring
  into tSelPodr
  ;
}

cmPick:
{
  if curfield = #podr
  {
    runwindow(wnSelPodr);
  }
}

cmCheckField:
{
  if curfield = #rasshifr
  {
    if rasshifr = '0' then vid:= 0;
    if rasshifr = '1' then vid:= 1;
  }
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

    delete all from otchet;
    delete all from tzakaz;

    SubBounds(tbRmtSelPodr1);
    AddBounds(tbRmtSelPodr2);

    sqlDropTmpTable ('tSelPodrUser');
    sqlCreateTmpTable('table tSelPodrUser (nrec: comp) with index (i1 = nrec);', ctmNormal);

    _loop pMarkerPodr
    {
      cpodr := tSelPodr.nrec;

      stmt := sqlAllocStmt;
      ClearQuery(vliSQLCommand);
      PrepareSQLQuery('insert into tSelPodrUser (nrec) values (#comp('+string(cpodr)+')) ');
      ExecDSQLex(0);
    }

    ClearQuery(vliSQLCommand);
    PrepareSQLQuery('select mnplan.number');
    PrepareSQLQuery('from mnplan');
    PrepareSQLQuery('left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7');
    PrepareSQLQuery('left join katpodr on katpodr.nrec = nachislzakaz.cexoz');
    PrepareSQLQuery('inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)');
    PrepareSQLQuery('join attrnam an1 on an1.wtable = 1413 and an1.name = ''Вид производства''');
    PrepareSQLQuery('left join attrval on attrval.crec = katpodr.nrec and attrval.cattrnam = an1.nrec and attrval.wtable = 1413');
    PrepareSQLQuery('where (attrval.vstring = ''Конструкторское бюро'' or attrval.vstring = ''Научно-испытательный комплекc'') and (katpodr1.nrec in (select tSelPodrUser.nrec from tSelPodrUser)) and mnplan.number <> ''''  and nachislzakaz.yearn = '+god+'');
    PrepareSQLQuery('group by mnplan.number');
    stmt:=0;
    stmt := sqlAllocStmt;
    wErr:=ExecDSQLex(tntzakaz);

  if vid = 0
  {
    _loop pMarkerpodr
    {
      ckod:= tSelpodr.kod;

      sql
      select attrval.vstring, katpodr1.kod, mnplan.number, nachislzakaz.mesn, 0, sum(nachislzakaz.chasf)
      from mnplan
      left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7
      left join katpodr on katpodr.nrec = nachislzakaz.cexoz
      inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
      join attrnam an1 on an1.wtable = 1413 and an1.name = 'Вид производства'
      left join attrval on attrval.crec = katpodr.nrec and attrval.cattrnam = an1.nrec and attrval.wtable = 1413
      where (attrval.vstring = 'Конструкторское бюро' or attrval.vstring = 'Научно-испытательный комплекc') and katpodr1.kod = :(ckod) and nachislzakaz.yearn = :(god) and mnplan.number <> ''
      and (nachislzakaz.vidopl = 1 or nachislzakaz.vidopl = 3 or nachislzakaz.vidopl = 5 or nachislzakaz.vidopl = 9 or nachislzakaz.vidopl = 10)
      group by attrval.vstring, katpodr1.kod, mnplan.number, nachislzakaz.mesn
      into otchet
      ;
    }

    ExcelPath:= TranslatePath('%ClientStartPath%');
    xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_zakaztabel.xlsx',true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

    counterC:= 3;
    lastRow:= 2;
    nextPodr:= 2;

    _loop tzakaz
    {
      counterC++;
      xlsetfontstyle(1, 2, counterC, 2, counterC);
      xlmergecells(2, counterC, 3, counterC);
      xlAlignCellsex(-4108, -4160, 2, counterC, 2, counterC);
      xlsetcellstringvalue(tzakaz.zakaznmb, 2, counterC, 2, counterC);
    }

    lastCol:= counterC;
    xlsetfontstyle(1, 2, lastCol + 1, 2, lastCol + 1);
    xlmergecells(2, lastCol + 1, 3, lastCol + 1);
    xlAlignCellsex(-4108, -4160, 2, lastCol + 1, 2, lastCol + 1);
    xlsetcellstringvalue('ИТОГО', 2, lastCol + 1, 2, lastCol + 1);

    xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, 3, lastCol + 1);

    countpodr:= 0;

    _loop pMarkerpodr where tSelPodr.vidpr = 'Конструкторское бюро'
    {
      countpodr++;
      ckod:= tSelPodr.kod;
      counterC:= 3;
      nextPodr:= lastRow;
      counterS:= nextPodr;
      itogJAN:= 0;
      itogFEB:= 0;
      itogMAR:= 0;
      itogAPR:= 0;
      itogMAY:= 0;
      itogJUN:= 0;
      itogJUL:= 0;
      itogAUG:= 0;
      itogSEP:= 0;
      itogOCT:= 0;
      itogNOV:= 0;
      itogDEC:= 0;
      itogvidprJAN:= 0;
      itogvidprFEB:= 0;
      itogvidprMAR:= 0;
      itogvidprAPR:= 0;
      itogvidprMAY:= 0;
      itogvidprJUN:= 0;
      itogvidprJUL:= 0;
      itogvidprAUG:= 0;
      itogvidprSEP:= 0;
      itogvidprOCT:= 0;
      itogvidprNOV:= 0;
      itogvidprDEC:= 0;

      Vyvod;

      counterC:= 3;

      while counterC < lastCol
      {
        counterC++;
        xlgetcellvalue(2, counterC, zakaznmb);
        itogzakaz:= 0;

        _loop otchet where ckod = otchet.podr and zakaznmb = otchet.zakaz
        {
          itogzakaz:= itogzakaz + otchet.chas;
          xlsetcellstringvalue('ИТОГО', lastRow + 2, 2, lastRow + 2, 2);
          xlsetfontstyle(1, lastRow + 2, 2, lastRow + 2, 2);
          xlsetcellstringvalue(itogzakaz, lastRow + 2, counterC, lastRow + 2, counterC);
          xlsetfontstyle(1, lastRow + 2, counterC, lastRow + 2, counterC);
          itogpodr:= itogJAN + itogFEB + itogMAR + itogAPR + itogMAY + itogJUN + itogJUL + itogAUG + itogSEP + itogOCT + itogNOV + itogDEC;
          xlsetcellstringvalue(itogpodr, lastRow + 2, lastCol + 1, lastRow + 2, lastCol + 1);
          xlsetfontstyle(1, lastRow + 2, lastCol + 1, lastRow + 2, lastCol + 1);
        }
      }

      lastRow:= lastRow + 2;
      xlframecells(1+2+4+8+32, 3, 1, 1, NextPodr + 2, 1, lastRow + 1, lastCol + 1);
    }

  if countpodr <> 0
  {
    delete all from tzakaz;

    ClearQuery(vliSQLCommand);
    PrepareSQLQuery('select mnplan.number, 0, sum(nachislzakaz.chasf)');
    PrepareSQLQuery('from mnplan');
    PrepareSQLQuery('left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7');
    PrepareSQLQuery('left join katpodr on katpodr.nrec = nachislzakaz.cexoz');
