      }

      sumvidprJAN13:= 0;
      sumvidprFEB13:= 0;
      sumvidprMAR13:= 0;
      sumvidprAPR13:= 0;
      sumvidprMAY13:= 0;
      sumvidprJUN13:= 0;
      sumvidprJUL13:= 0;
      sumvidprAUG13:= 0;
      sumvidprSEP13:= 0;
      sumvidprOCT13:= 0;
      sumvidprNOV13:= 0;
      sumvidprDEC13:= 0;
      sumvidpr13:= 0;
    }

    xlsetcellnumbervalue(itogvidpr13, LastRow, lastCol + 1, LastRow, lastCol + 1);
    xlsetcellnumbervalue(itogvidpr5, LastRow + 1, lastCol + 1, LastRow + 1, lastCol + 1);
