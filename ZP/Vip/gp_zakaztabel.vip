    if LastRowI >= LastRow + 43
    {
      xlsetcellnumbervalue(itogvidprAUG13, LastRow + 40, lastCol + 1, LastRow + 40, lastCol + 1);
      xlsetcellnumbervalue(itogvidprAUG5, LastRow + 41, lastCol + 1, LastRow + 41, lastCol + 1);
      xlsetcellnumbervalue(itogvidprAUG9, LastRow + 42, lastCol + 1, LastRow + 42, lastCol + 1);
      xlsetcellnumbervalue(itogvidprAUG10, LastRow + 43, lastCol + 1, LastRow + 43, lastCol + 1);
    }

    if LastRowI >= LastRow + 48
    {
