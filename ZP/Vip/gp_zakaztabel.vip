      xlsetcellnumbervalue(itogvidprSEP5, LastRow + 46, lastCol + 1, LastRow + 46, lastCol + 1);
      xlsetcellnumbervalue(itogvidprSEP9, LastRow + 47, lastCol + 1, LastRow + 47, lastCol + 1);
      xlsetcellnumbervalue(itogvidprSEP10, LastRow + 48, lastCol + 1, LastRow + 48, lastCol + 1);
    }

    if LastRowI >= LastRow + 53
    {
      xlsetcellnumbervalue(itogvidprOCT13, LastRow + 50, lastCol + 1, LastRow + 50, lastCol + 1);
      xlsetcellnumbervalue(itogvidprOCT5, LastRow + 51, lastCol + 1, LastRow + 51, lastCol + 1);
      xlsetcellnumbervalue(itogvidprOCT9, LastRow + 52, lastCol + 1, LastRow + 52, lastCol + 1);
      xlsetcellnumbervalue(itogvidprOCT10, LastRow + 53, lastCol + 1, LastRow + 53, lastCol + 1);
    }

