screen scr ('Параметры отчета',,sci13Esc);
  fields
  god: noprotect, spinbutton [1, 1917, 2117];
  podr: pickbutton, noprotect;
  rasshifr: noprotect, noframe;
  buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Год:           .@@@@@
    Подразделения: .@@@@@@@@@@@@@@@@@@@@
    [.] Выводить расшифровку`

    <.Сформировать.>

    >>
end;

procedure Vyvod;
begin

while counterC < lastCol
      {
        counterC++;
        xlgetcellvalue(2, counterC, zakaznmb);
        itogzakaz:= 0;

        _loop otchet where ckod = otchet.podr and zakaznmb = otchet.zakaz
        {
          xlsetcellstringvalue(ckod, counterS + 2, 1, counterS + 2, 1);
          xlAlignCells(-4108, counterS + 2, 1, counterS + 2, 1);
          xlsetfontstyle(1, counterS + 2, 1, counterS + 2, 1);

          if otchet.mes = 1
          {
            counterS:= counterS + 2;
            xlsetcellstringvalue('Январь', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogJAN:= itogJAN + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogJAN, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 2
          {
            counterS:= counterS + 4;
            xlsetcellstringvalue('Февраль', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogFEB:= itogFEB + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogFEB, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 3
          {
            counterS:= counterS + 6;
            xlsetcellstringvalue('Март', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogMAR:= itogMAR + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogMAR, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 4
          {
            counterS:= counterS + 8;
            xlsetcellstringvalue('Апрель', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogAPR:= itogAPR + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogAPR, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 5
          {
            counterS:= counterS + 10;
            xlsetcellstringvalue('Май', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogMAY:= itogMAY + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogMAY, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 6
          {
            counterS:= counterS + 12;
            xlsetcellstringvalue('Июнь', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogJUN:= itogJUN + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogJUN, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 7
          {
            counterS:= counterS + 14;
            xlsetcellstringvalue('Июль', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogJUL:= itogJUL + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogJUL, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 8
          {
            counterS:= counterS + 16;
            xlsetcellstringvalue('Август', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogAUG:= itogAUG + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogAUG, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 9
          {
            counterS:= counterS + 18;
            xlsetcellstringvalue('Сентябрь', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogSEP:= itogSEP + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogSEP, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 10
          {
            counterS:= counterS + 20;
            xlsetcellstringvalue('Октябрь', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogOCT:= itogOCT + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogOCT, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 11
          {
            counterS:= counterS + 22;
            xlsetcellstringvalue('Ноябрь', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogNOV:= itogNOV + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogNOV, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }

          if otchet.mes = 12
          {
            counterS:= counterS + 24;
            xlsetcellstringvalue('Декабрь', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);
            xlsetcellnumbervalue(otchet.chas, counterS, counterC, counterS, counterC);
            itogDEC:= itogDEC + otchet.chas;
            xlsetfontstyle(1, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogDEC, counterS, lastCol + 1, counterS, lastCol + 1);
            if lastRow < counterS then lastRow:= counterS;
            counterS:= NextPodr;
          }
        }
      }

end;

procedure Itog;
begin

    while counterC < lastCol
    {
      counterC++;
      xlgetcellvalue(2, counterC, zakaznmb);

      _loop tzakaz where zakaznmb = tzakaz.zakaznmb
      {
        xlsetcellnumbervalue(tzakaz.chas, LastRow, counterC, LastRow, counterC);
        xlsetfontstyle(1, LastRow, counterC, LastRow, counterC);
        itogvidpr:= itogvidpr + tzakaz.chas;

        _loop tzakazmes where ((tzakaz.zakaznmb == tzakazmes.zakaznmb))
        {
          if tzakazmes.mes = 1
          {
            xlsetcellstringvalue('Январь', LastRow + 2, 2, LastRow + 2, 2);
            xlsetfontstyle(1, LastRow + 2, 2, LastRow + 2, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 2, counterC, LastRow + 2, counterC);
            itogvidprJAN:= itogvidprJAN + tzakazmes.chas;
            if LastRowI < LastRow + 2 then LastRowI:= LastRow + 2;
          }

          if tzakazmes.mes = 2
          {
            xlsetcellstringvalue('Февраль', LastRow + 4, 2, LastRow + 4, 2);
            xlsetfontstyle(1, LastRow + 4, 2, LastRow + 4, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 4, counterC, LastRow + 4, counterC);
            itogvidprFEB:= itogvidprFEB + tzakazmes.chas;
            if LastRowI < LastRow + 4 then LastRowI:= LastRow + 4;
          }

          if tzakazmes.mes = 3
          {
            xlsetcellstringvalue('Март', LastRow + 6, 2, LastRow + 6, 2);
            xlsetfontstyle(1, LastRow + 6, 2, LastRow + 6, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 6, counterC, LastRow + 6, counterC);
            itogvidprMAR:= itogvidprMAR + tzakazmes.chas;
            if LastRowI < LastRow + 6 then LastRowI:= LastRow + 6;
          }

          if tzakazmes.mes = 4
          {
            xlsetcellstringvalue('Апрель', LastRow + 8, 2, LastRow + 8, 2);
            xlsetfontstyle(1, LastRow + 8, 2, LastRow + 8, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 8, counterC, LastRow + 8, counterC);
            itogvidprAPR:= itogvidprAPR + tzakazmes.chas;
            if LastRowI < LastRow + 8 then LastRowI:= LastRow + 8;
          }

          if tzakazmes.mes = 5
          {
            xlsetcellstringvalue('Май', LastRow + 10, 2, LastRow + 10, 2);
            xlsetfontstyle(1, LastRow + 10, 2, LastRow + 10, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 10, counterC, LastRow + 10, counterC);
            itogvidprMAY:= itogvidprMAY + tzakazmes.chas;
            if LastRowI < LastRow + 10 then LastRowI:= LastRow + 10;
          }

          if tzakazmes.mes = 6
          {
            xlsetcellstringvalue('Июнь', LastRow + 12, 2, LastRow + 12, 2);
            xlsetfontstyle(1, LastRow + 12, 2, LastRow + 12, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 12, counterC, LastRow + 12, counterC);
            itogvidprJUN:= itogvidprJUN + tzakazmes.chas;
            if LastRowI < LastRow + 12 then LastRowI:= LastRow + 12;
          }

          if tzakazmes.mes = 7
          {
            xlsetcellstringvalue('Июль', LastRow + 14, 2, LastRow + 14, 2);
            xlsetfontstyle(1, LastRow + 14, 2, LastRow + 14, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 14, counterC, LastRow + 14, counterC);
            itogvidprJUL:= itogvidprJUL + tzakazmes.chas;
            if LastRowI < LastRow + 14 then LastRowI:= LastRow + 14;
          }

          if tzakazmes.mes = 8
          {
            xlsetcellstringvalue('Август', LastRow + 16, 2, LastRow + 16, 2);
            xlsetfontstyle(1, LastRow + 16, 2, LastRow + 16, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 16, counterC, LastRow + 16, counterC);
            itogvidprAUG:= itogvidprAUG + tzakazmes.chas;
            if LastRowI < LastRow + 16 then LastRowI:= LastRow + 16;
          }

          if tzakazmes.mes = 9
          {
            xlsetcellstringvalue('Сентябрь', LastRow + 18, 2, LastRow + 18, 2);
            xlsetfontstyle(1, LastRow + 18, 2, LastRow + 18, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 18, counterC, LastRow + 18, counterC);
            itogvidprSEP:= itogvidprSEP + tzakazmes.chas;
            if LastRowI < LastRow + 18 then LastRowI:= LastRow + 18;
          }

          if tzakazmes.mes = 10
          {
            xlsetcellstringvalue('Октябрь', LastRow + 20, 2, LastRow + 20, 2);
            xlsetfontstyle(1, LastRow + 20, 2, LastRow + 20, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 20, counterC, LastRow + 20, counterC);
            itogvidprOCT:= itogvidprOCT + tzakazmes.chas;
            if LastRowI < LastRow + 20 then LastRowI:= LastRow + 20;
          }

          if tzakazmes.mes = 11
          {
            xlsetcellstringvalue('Ноябрь', LastRow + 22, 2, LastRow + 22, 2);
            xlsetfontstyle(1, LastRow + 22, 2, LastRow + 22, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 22, counterC, LastRow + 22, counterC);
            itogvidprNOV:= itogvidprNOV + tzakazmes.chas;
            if LastRowI < LastRow + 22 then LastRowI:= LastRow + 22;
          }

          if tzakazmes.mes = 12
          {
            xlsetcellstringvalue('Декабрь', LastRow + 24, 2, LastRow + 24, 2);
            xlsetfontstyle(1, LastRow + 24, 2, LastRow + 24, 2);
            xlsetcellnumbervalue(tzakazmes.chas, LastRow + 24, counterC, LastRow + 24, counterC);
            itogvidprDEC:= itogvidprDEC + tzakazmes.chas;
            if LastRowI < LastRow + 24 then LastRowI:= LastRow + 24;
          }
        }
      }
    }

    xlsetcellnumbervalue(itogvidpr, LastRow, lastCol + 1, LastRow, lastCol + 1);
    if LastRowI >= LastRow + 2 then xlsetcellnumbervalue(itogvidprJAN, LastRow + 2, lastCol + 1, LastRow + 2, lastCol + 1);
    if LastRowI >= LastRow + 4 then xlsetcellnumbervalue(itogvidprFEB, LastRow + 4, lastCol + 1, LastRow + 4, lastCol + 1);
    if LastRowI >= LastRow + 6 then xlsetcellnumbervalue(itogvidprMAR, LastRow + 6, lastCol + 1, LastRow + 6, lastCol + 1);
    if LastRowI >= LastRow + 8 then xlsetcellnumbervalue(itogvidprAPR, LastRow + 8, lastCol + 1, LastRow + 8, lastCol + 1);
    if LastRowI >= LastRow + 10 then xlsetcellnumbervalue(itogvidprMAY, LastRow + 10, lastCol + 1, LastRow + 10, lastCol + 1);
    if LastRowI >= LastRow + 12 then xlsetcellnumbervalue(itogvidprJUN, LastRow + 12, lastCol + 1, LastRow + 12, lastCol + 1);
    if LastRowI >= LastRow + 14 then xlsetcellnumbervalue(itogvidprJUL, LastRow + 14, lastCol + 1, LastRow + 14, lastCol + 1);
    if LastRowI >= LastRow + 16 then xlsetcellnumbervalue(itogvidprAUG, LastRow + 16, lastCol + 1, LastRow + 16, lastCol + 1);
    if LastRowI >= LastRow + 18 then xlsetcellnumbervalue(itogvidprSEP, LastRow + 18, lastCol + 1, LastRow + 18, lastCol + 1);
    if LastRowI >= LastRow + 20 then xlsetcellnumbervalue(itogvidprOCT, LastRow + 20, lastCol + 1, LastRow + 20, lastCol + 1);
    if LastRowI >= LastRow + 22 then xlsetcellnumbervalue(itogvidprNOV, LastRow + 22, lastCol + 1, LastRow + 22, lastCol + 1);
    if LastRowI >= LastRow + 24 then xlsetcellnumbervalue(itogvidprDEC, LastRow + 24, lastCol + 1, LastRow + 24, lastCol + 1);
    xlsetfontstyle(1, LastRow, lastCol + 1, LastRowI, lastCol + 1);

    xlframecells(1+2+4+8+32, 3, 1, 1, Lastrow - 1, 1, lastRowI + 1, lastCol + 1);

end;

procedure VyvodRasshifr;
begin

while counterC < lastCol
      {
        counterC++;
        xlgetcellvalue(2, counterC, zakaznmb);
        itogzakaz:= 0;
        sum13:= 0;
        checkmes:= 1;

        _loop otchet where ckod = otchet.podr and zakaznmb = otchet.zakaz
        {
          xlsetcellstringvalue(ckod, counterS + 2, 1, counterS + 2, 1);
          xlAlignCells(-4108, counterS + 2, 1, counterS + 2, 1);
          xlsetfontstyle(1, counterS + 2, 1, counterS + 2, 1);

          if otchet.mes = 1
          {
            if checkmes <> otchet.mes then sum13:= 0;
            checkmes:= otchet.mes;

            counterS:= counterS + 2;
            xlsetcellstringvalue('Январь', counterS, 2, counterS, 2);
            xlsetfontstyle(1, counterS, 2, counterS, 2);

            xlsetcellstringvalue('Я', counterS, 3, counterS, 3);
            xlsetcellstringvalue('К', counterS + 1, 3, counterS + 1, 3);
            xlsetcellstringvalue('Р', counterS + 2, 3, counterS + 2, 3);
            xlsetcellstringvalue('С', counterS + 3, 3, counterS + 3, 3);
            xlsetfontstyle(1, counterS, 3, counterS + 3, 3);

            if otchet.vidop = 1 or otchet.vidop = 3
            {
              sum13:= sum13 + otchet.chas;
              xlsetcellnumbervalue(sum13, counterS, counterC, counterS, counterC);
              itogJAN13:= itogJAN13 + otchet.chas;
            }

            if otchet.vidop = 5
            {
              xlsetcellnumbervalue(otchet.chas, counterS + 1, counterC, counterS + 1, counterC);
              itogJAN5:= itogJAN5 + otchet.chas;
            }

            if otchet.vidop = 9
            {
              xlsetcellnumbervalue(otchet.chas, counterS + 2, counterC, counterS + 2, counterC);
              itogJAN9:= itogJAN9 + otchet.chas;
            }

            if otchet.vidop = 10
            {
              xlsetcellnumbervalue(otchet.chas, counterS + 3, counterC, counterS + 3, counterC);
              itogJAN10:= itogJAN10 + otchet.chas;
            }

            xlsetfontstyle(1, counterS, lastCol + 1, counterS + 3, lastCol + 1);
            xlsetcellnumbervalue(itogJAN13, counterS, lastCol + 1, counterS, lastCol + 1);
            xlsetcellnumbervalue(itogJAN5, counterS + 1, lastCol + 1, counterS + 1, lastCol + 1);
            xlsetcellnumbervalue(itogJAN9, counterS + 2, lastCol + 1, counterS + 2, lastCol + 1);
