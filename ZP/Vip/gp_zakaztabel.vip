#include marker.vih
#include userreport.vih

interface gp_zakaztabel 'Параметры отчета' gray
Show at (,,42,7);

table struct tSelPodr
(
nrec: comp,
kod: string,
name: string,
vidpr: string
)
with index
(
i1 = kod,
i2 = nrec (unique)
)
;

table struct otchet
(
vidpr:string,
podr: string,
zakaz: string,
mes: word,
vidop: longint,
chas: double
)
with index
(
i1 = vidpr + podr + zakaz + mes + vidop (unique)
)
;

table struct tzakaz
(
zakaznmb: string,
vidop: longint,
chas: double
)
with index
(
i1 = zakaznmb + vidop (unique)
)
;

table struct tzakazmes
(
zakaznmb: string,
mes: word,
vidop: longint,
chas: double
)
with index
(
i1 = zakaznmb + mes + vidop (unique)
)
;
;

create view zakaztabel

var
ExcelPath, zakaznmb, strmes, podr, pUserName, cutzakaznmb, ckod, rasshifr: string;
god: integer;
counterS, counterC, lastCol, itogCol, wErr, lastRow, nextPodr, LastRowI: longint;
