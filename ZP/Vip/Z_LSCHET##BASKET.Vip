//#region Визуальная часть

overloadformats brwZarSignal;
overloadformats scrLookRaise;
overloadformats scrLookLsch;

embedded embActiveFilters interface;
show (,,,3) fixed_y;
end;

tree 1 trZarSignal 'Иерархическое представление' (,hcBasket,sci18EscIns) ;
show(,4,,8);
table tZarSignal;
recmarker = _tZarSignalMarker { tZarSignal.Nrec };
fields
  {font = {color = if(tZarSignal.IsProcessed = 1, ColorSysGray, 0);}};
  tZarSignal.TitleDocNmb  'Номер приказа'             : [8], protect;
  tZarSignal.TitleDocDate 'Дата приказа'              : [8], protect;
  tZarSignal.TitleDocText 'Краткое содержание'        : [8], protect;
  tZarSignal.OperDate     'Дата операции'             : [10], protect;

  [tZarSignalMsgName]
    SignalName(tZarSignal.MsgCode, tZarSignal.IsSubstitution = 1)
    'Операция' ('Операция'): [8], protect;

  tZarSignal.Date1        'Дата начала изменений'     : [10], protect;
  tZarSignal.Sum          'Сумма'                     : [10,2], protect;
  tZarSignal.Percent      'Процент'                   : [10,2], protect;
  tZarSignal.StrTabn      'Таб. №'                    : [10], protect;
  tZarSignal.Fio          'Сотрудник'                 : [20], protect;
  tZarSignal.KatPodrKod   'Код подразделения'         : [10], protect;
  tZarSignal.KatPodrName  'Наименование подразделения': [20], protect;
  tZarSignal.OrderNumber  'Номер заказа'              : [5], protect;
  tZarSignal.ProjectCode  'Проект'                    : [5], protect;
  //#1171.#16
  [User_Modify] MyGetInitial(X$USERS_SH.XU$FULLNAME,true)  'Изменивший запись' : [20], protect,NoDel;
end;

handleevent
  cmTreeTop       : _tZarSignalParentNrec := 0;
  cmTreeUp        : _tZarSignalParentNrec := tZarSignal.ParentNrec;
  cmTreeDown      : _tZarSignalParentNrec := tZarSignal.Nrec;
  cmTreeNodeType  : if (tZarSignal.IsLeaf = 1) TreeSetNodeType(trZarSignal, ntfText);
  cmTreeNeedOwner : TreeJumpToRecord(trZarSignal, tZarSignal.ParentNrec);
end;

//********************************
screen scrLookPrVidOpl (,hcbasketWAll, sci18Esc);
show at (,9) fixed_y;
table LOADZARSIGNAL;
bevel b1 {61, 8, 80, 14, bsLowered, bsFrame};
fields
  MsgName: protect;

  PERSONS.FIO: protect;
  if(isValid(#ZarSignal)
    ,if(getfirst fastfirstrow KlVidOpl where((ZarSignal.Word3 == KlVidOpl.VidOpl)) = tsOk,
    KlVidOpl.NVidOpl, ''),'' ) ('Вид оплаты'):
    {Font = {BackColor = if(isValid(#ZarSignal),if(ZARSIGNAL.COMP1_M = 'И', ColorNeed, 0),'')}}, protect;

  ZARSIGNAL.DATE1 ('Дата начала действия доплаты'):
    {Font = {BackColor = if(ZARSIGNAL.DATE1_M = 'И', ColorNeed, 0)}}, protect;

  ZARSIGNAL.DATE2 ('Дата окончания действия доплаты'):
    {Font = {BackColor = if(ZARSIGNAL.DATE2_M = 'И', ColorNeed, 0)}}, protect;

  if(getfirst fastfirstrow KlVidUd where((ZarSignal.Word4 == KlVidUd.VidUd)) = tsOk,
    KlVidUd.NVidUd, '' ) ('Вид удержания'):
    {Font = {BackColor = if(ZARSIGNAL.COMP1_M = 'И', ColorNeed, 0)}}, protect;

  FixedAddPaymentSumStr ('Сумма'): [13.2],
    {Font = {BackColor = if(ZARSIGNAL.DOUBLE1_M = 'И', ColorNeed, 0)}}, protect;

  sPerCent ('Валюта'):
    {Font = {BackColor = if(ZARSIGNAL.COMP2_M = 'И', ColorNeed, 0)}}, protect;

  FixedAddPaymentPercentStr ('Процент'): [13.2],
    {Font = {BackColor = if(ZARSIGNAL.DOUBLE1_M = 'И', ColorNeed, 0)}}, protect;

  ZARSIGNAL.DATE10
    ('Дата утверждения приказа, на основании которого создана запись'): protect;

  ZARSIGNAL.STRING2
    ('Номер приказа, на основании которого создана запись'): protect;
  SyncText('Сообщение о синхронизации'):
    skip,
    {Font = {Bold = true; Color = 2}}, protect;

<<
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Вид оплаты`                                 `Начало`       `Окончание`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@   .@@@@@@@@@@@
`Вид удержания`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Сумма`          `Валюта`        `Процент`
 .@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@  .@@@@@@@@@@


                                                              `Дата приказа`
                                                               .@@@@@@@@@@@
                                                              `Номер приказа`
                                                               .@@@@@@@@@@@@@@
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end; // scrLookPrVidOpl
