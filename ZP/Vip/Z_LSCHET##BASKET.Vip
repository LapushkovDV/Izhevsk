#component "Z_LSCHET"
#doc
Интерфейс на работу с рабочей корзиной
  Доработки системы для учета по заказам.pptx
#end

Alter Interface BASKET ;

Overload
#ifndef _2020_09_30_
  Procedure NewDoplata;
#else
  function NewDoplata: boolean;
#end
  function SignalName(_Code: word; _bZam: boolean): string;
  function ProcessChangeAddPayment: boolean;
  function ProcessZarSignal: boolean;
  procedure UpdateView;
  function UpdatePersonalAccount(var _changeDatUv: boolean): boolean;
  procedure SetupBounds(_CurRecord: comp);
  procedure DeleteRecords(ProcessedOnly: boolean);
  procedure SetDoplata(IsNew: boolean);
end;//Overload

table struct tZarSignal (
  Nrec          : comp,
  ParentNrec    : comp,
  ZarSignalNrec : comp,
  KatPodrKod    : string[20],
  KatPodrName   : string[150],
  TitleDocNrec  : comp,
  TitleDocNmb   : string[20],
  TitleDocDate  : date,
  TitleDocText  : string[100],
  TitleDocTable : word,
  IsProcessed   : byte,
  Sum           : double,
  Percent       : double,
  StrTabn       : string[20],
  Fio           : string[60],
  OperDate      : date,
  Date1         : date,
  MsgCode       : word,
  IsSubstitution: byte,
  OrderNrec     : comp,
  OrderNumber   : string[20],
  ProjectNrec   : comp,
  ProjectCode   : string[20],
  IsLeaf        : byte
) with index (
  i00 = Nrec (unique, surrogate),
  i01 = IsLeaf + TitleDocNrec,
  i11 = IsLeaf + TitleDocDate + TitleDocNmb,
  i02 = ParentNrec + TitleDocDate + TitleDocNmb + OperDate,
  i03 = ZarSignalNrec
);

//***************************************
var
//***************************************
  EAH            : ExtrAnalyticsHelper;         // Переменная типа интерфейс ExtrAnalyticsHelper
  pGP_Staff_Func : GP_Staff_Func;
  //----------------------------------------
  _visibleHidden   : GP_VisibleHidden;            // скрыть/показать поля
  _prVidOplHelper  : GP_ZP::GP_PrVidOplHelper;    // поиск и создание sys_mbf, prvidopl
  _katKau          : oKatKauEdit;

  _attrNamNrecContDocOrder:  comp;
  _attrNamNrecPartDocOrder:  comp;
  _attrNamNrecTitleDocOrder: comp;

  _cgKau_ProductionType:       word;
  _attrNamNrecContDocProject:  comp;
  _attrNamNrecPartDocProject:  comp;
  _attrNamNrecTitleDocProject: comp;

  _attrNamNrecPartDocHidden: comp;

  _tZarSignalMarker : IPosMarker(PosMarker) new;
  _filterManager    : GP_IUserFilterManager noauto;
  _filterStore      : GP_UserFilterStoreDSK noauto;
  _filterManagerView: GP_UserFilterManagerViewActiveFilters noauto;

  _hierMode: byte;
//---- настройки
//-- #2070 'Заполнять поле "Выплачено(аванс)" в начислениях и выплатах межпериода'

  NPOEM_OWN_ZP_MP_Vipl:boolean;
//---- #2228
  //Запретить обработку ранее обработанных записей РК
  DISABLE_Processed_Rec:boolean;
  //Разрешать обрабатывать записи РК за прошлые отчетные периоды (кол-во месяцев от тек.периода)
  Process_month:word;
  Process_DT   :date;
  //Предлагать удаление обработанных записей
  Auto_DEL     :boolean;

//***************************************
//Основная вьюха из базового интерфейса
create view First
var
  _tZarSignalParentNrec: comp;
  _buhSchetNrec: comp;
Select tZarSignal.Nrec
From
    tZarSignal,
    tZarSignal tZarSignalForZS,
    BuhSchet,
    X$USERS X$USERS_SH,
    OtpDop
Where ((
      _tZarSignalParentNrec     == tZarSignal.ParentNrec
  and ZarSignal.Nrec            == tZarSignalForZS.ZarSignalNrec
  and tZarSignalForZS.OrderNrec == MnPlan.Nrec
  and DOPLATA.OldcLsch          == OtpDop.Nrec

  //#1171.#16
  and ZARSIGNAL.ATL_LASTUSER    == X$USERS_SH.Atl_Nrec
  and _buhSchetNrec             == BuhSchet.Nrec
))
bounds ByZarSignalNrec = tZarSignal.ZarSignalNrec == LoadZarSignal.Signal
;

//Для определения заголовка приказа
create view vPrik
as select contdoc.Nrec
from contdoc, partdoc, titledoc;

//Для построения иерархии tZarSignal
create view vHier
as select zs.Nrec
from tZarSignal zs, tZarSignal zsTitleDoc
     ,tZarSignal zsChild
     /*
     (select count(*) (fieldname=cnt), sum(zsChild.Sum) (fieldname=sum)
      from tZarSignal zsChild
      where ((
        1               == zsChild.IsLeaf and
        zs.TitleDocDate == zsChild.TitleDocDate and
        zs.TitleDocNmb  == zsChild.TitleDocNmb
      ))
     ) tChildCnt,
     (select count(*) (fieldname=pcnt)
      from tZarSignal zsProcessedChild
      where ((
        1               == zsProcessedChild.IsLeaf and
        zs.TitleDocDate == zsProcessedChild.TitleDocDate and
        zs.TitleDocNmb  == zsProcessedChild.TitleDocNmb and (zsProcessedChild.IsProcessed = 1)
      ))
     ) tProcessedChildCnt
     */
where ((
  1               == zs.IsLeaf and (zs.ParentNrec = 0) and
  1               == zsTitleDoc.IsLeaf and
  zs.TitleDocDate == zsTitleDoc.TitleDocDate and
  zs.TitleDocNmb  == zsTitleDoc.TitleDocNmb  and
  //===========
  1               == zsChild.IsLeaf and
  zs.TitleDocDate == zsChild.TitleDocDate and
  zs.TitleDocNmb  == zsChild.TitleDocNmb

));

//Для синхронизации пометок tZarSignal и LoadZarSignal
create view vSyncMarker
var
  _marker: TPtr;
as select tZarSignal.Nrec
from tZarSignal, LoadZarSignal
where ((
  root == tZarSignal.Nrec and (FoundMarker(vSyncMarker._marker, vSyncMarker.tZarSignal.Nrec))
));


