/*************************************************************************************************\
* Наименование:  Ведение заказов/проектов - Распределение ФОТ работников по заказам               *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    Запуск - Настройка - Распределение ФОТ работников по заказам                     *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#798          |10/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#include GP_ZP_RaspZakazVO.Vih
#component "Z_CALC"
//******************************************************************************
Alter InterFace KLVIDOPL;
//******************************************************************************
VAR
  ATTR_RASP_ZAKAZ:comp;
//----------------------------
Create view
  Vklvidopl
AS SELECT
  word(doGetAttrID(coKlVidopl,Klvidopl.Nrec,ATTR_RASP_ZAKAZ)) (FieldName=Rasp_Zakaz,FieldTitle='Распределять по заказам')
;

//******************************************************************************
// Форматы
//******************************************************************************
ExtendFormats klvidoplpermanent;
Panel klvidopl
  table klVIDOPL;
// tabbedsheet bottom tsPlVed
screen klvidoplpermanent;
Fields
  Rasp_Zakaz ('Распределять по заказам'):NoProtect;
/*

*/
<<

                                                               [.] Распр.по заказам`

>>
end;
end; //Panel klvidopl
//===========================
TableEvent Table KlVidOpl;
//===========================
  cmExprFieldChanged :
  { inherited :: handleEvent (cmExprFieldChanged);
    case curfield of
    #Rasp_Zakaz:
    { doSetAttrID(coKlVidOpl,KlVidOpl.NREC,ATTR_RASP_ZAKAZ,double(trim(ExprFieldValue)))
    }
    end;
  }
end; //TableEvent Table KlVidOpl;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
HandleEvent
cmInit:
{ ATTR_RASP_ZAKAZ:=ExtAttr_Create(coKlVidopl,'Признак распределения по заказам',cgAttrType_Dbl);
  //----------------------
  if  inherited :: handleEvent (cmInit)=heAbort then Abort;
  //----------------------

}
//Распределение по заказам - см GP_MenuZarp.vip
//добавлен пункт в меню Z_CALC##KLVIDOPL
cmValue60:
{ var _wVidOpl:word;
  _wVidOpl:=KlVidOpl.VidOpl;
  RunInterface(GP_ZP_RaspZakazVO,0,_wVidOpl,0,0,0)

}
end;
end.
