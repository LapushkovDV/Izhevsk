#component "Z_SREDN"

Alter Interface VOTPUSK;

ExtendFormats OTPUSK;

Create view
  ZOtpusk
as
select
  emPodr.Kod
from
  KatPodr emPodr
where ((
          Otpusk.Cex == emPodr.nRec
));

panel p;

Browse Otpusk(,hcVOView, scintiVInsPM);
  recMarker = pMarker {Otpusk.NREC};
Fields
  emPodr.Kod 'Код подр.'('Код подразделения из л/с'):[10],protect;
end; // Browse Otpusk

end; // panel p

end.
