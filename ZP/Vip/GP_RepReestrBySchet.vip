function PrintRepStrahByReestr: boolean;
var r1, kolR, kolC, i, j, npp, nList: longint;
    sVidPer: string;
    lstNames: array [1..1] of string;
    lstRows: array [1..1] of longint;
{
  Result := false;
  sVidPer := '';
  nList := 0;
  SetLimit(lstNames, 0);
  _loop tRepStrahByReestr ordered by tRepStrahByReestr.sVidPer
  {
    if sVidPer <> tRepStrahByReestr.sVidPer
    {
      nList++;
      sVidPer := tRepStrahByReestr.sVidPer;
      lstNames[nList] := sVidPer;
      lstRows[nList] := 0;
    }
    lstRows[nList]++;
  }

  for (nList := 1; nList <= Count(lstNames); nList++)
  {
    XLRUNMACRO('CopyList(Реестр страховых взносов, Реестр взносов ' + lstNames[nList] + ')');
    XLSETACTIVESHEETBYNAME('Реестр взносов ' + lstNames[nList]);
    XLSETCELLSTRINGVALUE(lstNames[nList], 2, 1, 2, 1);
    XLSETCELLSTRINGVALUE(DateToStr(dReport, 'month YYYY'), 3, 1, 3, 1);
    r1 := 7;
    kolC := 14;
    kolR := lstRows[nList];
    PrepareRoundErrors(kolC);
    XLCREATEMATRIX(kolR, kolC);
    if KolR > 2 then XLINSERTRANGE(xlShiftDown, r1 + 1, 1, r1 + KolR - 2, KolC);
    if KolR < 2 then XLDELETERANGE(xlShiftUp, r1, 1, r1 + 1 - KolR, KolC);
    i := npp := 0;
    _loop tRepStrahByReestr where ((lstNames[nList] == tRepStrahByReestr.sVidPer)) ordered by tRepStrahByReestr.dPlat
    {
      j := 0;
      XLDOWRITETOMATRIX(++i, ++j, ++npp);
      XLSTWRITETOMATRIX(  i, ++j, tRepStrahByReestr.num);
      XLSTWRITETOMATRIX(  i, ++j, DateToStr(tRepStrahByReestr.dPlat, 'DD.MM.YYYY'));
      XLSTWRITETOMATRIX(  i, ++j, tRepStrahByReestr.sBank);
      XLSTWRITETOMATRIX(  i, ++j, '=RC[1]+RC[2]+RC[3]+RC[4]+RC[5]');
      xlRdWriteToMatrix(  i, ++j, tRepStrahByReestr.sumSchet[1]);
      xlRdWriteToMatrix(  i, ++j, tRepStrahByReestr.sumSchet[2]);
      xlRdWriteToMatrix(  i, ++j, tRepStrahByReestr.sumSchet[3]);
      xlRdWriteToMatrix(  i, ++j, tRepStrahByReestr.sumSchet[4]);
      xlRdWriteToMatrix(  i, ++j, tRepStrahByReestr.sumSchet[0]);
      XLSTWRITETOMATRIX(  i, ++j, '=RC[-6]-RC[-1]');
      XLSTWRITETOMATRIX(  i, ++j, '=RC[-6]');
      XLSTWRITETOMATRIX(  i, ++j, '=RC[-6]+RC[-5]');
      XLSTWRITETOMATRIX(  i, ++j, '=RC[-5]');
    }
    XLWRITEMATRIXTOEXCEL(r1, 1);
    XLFREEMATRIX;
  }
  Result := true;
}

function PrintReports: boolean;
var sXl: string;
{
  Result := false;
  sXl := TranslatePath('%StartPath%XLS_ЭМ\ZP\GP_RepReestrBySchet.xlt');
  if not ExistFile(sXl)
  {
    message('Не найден шаблон'#13 + sXl, error);
    exit;
  }
  if not XLCREATEEXCELWITHTEMPLATE(sXl, true)
  {
    message('Ошибка запуска шаблона'#13 + sXl, error);
    exit;
  }
  XLDISPLAYALERTS(false);

  if getfirst tRepZpByReestr = tsOk
    PrintRepZpByReestr;
  else
    XLDELETESHEETBYNAME('Реестр платежей ЗП');
  if getfirst tRepZpByDept = tsOk
    PrintRepZpByDept;
  else
    XLDELETESHEETBYNAME('Реестр ЗП по подразд.');
  if getfirst tRepZpByTabN = tsOk
    PrintRepZpByTabN;
  else
    XLDELETESHEETBYNAME('Реестр ЗП по сотрудникам');
  if getfirst tRepNDFLByReestr = tsOk
    PrintRepNDFLByReestr;
  else
    XLDELETESHEETBYNAME('Реестр платежей НДФЛ');
  if getfirst tRepStrahByReestr = tsOk
    PrintRepStrahByReestr;
  XLDELETESHEETBYNAME('Реестр страховых взносов');//с этого листа берутся копии, сам он не нужен

  XLKILLEXCEL;
  Result := true;
}

function FillCommonData: boolean;
var objQuery: IQuery;
    yearN, mesN: word;
{
  Result := false;
  sVPlan0 := 'Несубсидируемое';
  sVPlan1 := '0100 001';
  sVPlan2 := '0888 001';
  sVPlan3 := '0888 013';
  yearN := Year(dReport);
  mesN := Month(dReport);
  sqlCreateTmpTable('table tReeBySchetSumZ (cLSchet: comp, sm23: double, smAll: double) with index (i1 = cLSchet);', ctmNormal);
  objQuery := queryManager.createQuery(SQLQUERY(.
    insert tReeBySchetSumZ (cLSchet, sm23, smAll)
    select
      NachislZakaz.cLsch
    , sum(case when NachislZakaz.cSchetD = '23' then NachislZakaz.Summa else 0.0 end) 
    , sum(NachislZakaz.Summa)
    from NachislZakaz
    where NachislZakaz.YearN = :(yearN) and NachislZakaz.MesN = :(MesN) and NachislZakaz.cSchetD in ('23', '25')
    group by NachislZakaz.cLsch
  .));
  if (objQuery.execute.errorCode <> tsOk)
  {
    message('Ошибка выборки начислений по заказам: ' + objQuery.errorCode, error);
    exit;
  } 
  mtClear(tntRepZpByReestr, mfNormal);
  mtClear(tntRepZpByDept, mfNormal);
  mtClear(tntRepZpByTabN, mfNormal);
  mtClear(tntRepNDFLByReestr, mfNormal);
  mtClear(tntRepStrahByReestr, mfNormal);

  Result := true;
}

function GetDataZpByReestr: boolean;
var cAttrVPlan: comp;
    objQuery: IQuery;
{
  Result := false;
  cAttrVPlan := ExtAttr_ID(coSbBan, 'Группа заказов');
 
  objQuery := queryManager.createQuery(SQLQUERY(.
    select
      AllData.NRec
    , AllData.Num
    , AllData.dPlat
    , AllData.sBank
    , AllData.sumSchet0 "sumSchet[0]"
    , AllData.sumSchet1 "sumSchet[1]"
    , AllData.sumSchet2 "sumSchet[2]"
    , AllData.sumSchet23 - AllData.sumSchet2 "sumSchet[3]"
    , AllData.sumSchet4 "sumSchet[4]"
    from (
      select
        SbBan.NRec NRec
      , SbBan.LastUser num
      , SbBan.DatOk dPlat
      , case coalesce(AttrVal.vString, '') 
          when '' then 'Коммерческие'
          when :(svPlan1) then 'Субсидия'
          when :(svPlan2) then 'Субсидия'
          when :(svPlan3) then 'Субсидия'
          when :(svPlan0) then AttrVal.vString
          else 'Гос. заказ (' || AttrVal.vString || ')'
        end sBank: string
      , case when coalesce(AttrVal.vString, '') not in (:(svPlan1), :(svPlan2), :(svPlan3)) then SbBan.Summa else 0.0 end sumSchet0
      , case when coalesce(AttrVal.vString, '') =:(svPlan1) then SbBan.Summa else 0.0 end sumSchet1
      , case when coalesce(AttrVal.vString, '') =:(svPlan2) then 
          coalesce((
            select sum(round(SpPlBan.SumOpl * tReeBySchetSumZ.sm23 / tReeBySchetSumZ.smAll, 2))
            from SpPlBan 
            inner join tReeBySchetSumZ on SpPlBan.cLsch = tReeBySchetSumZ.cLSchet
            where SpPlBan.cSbBan = SbBan.NRec
          ), 0.0)
        else 0.0 
        end sumSchet2
      , case when coalesce(AttrVal.vString, '') =:(svPlan2) then SbBan.Summa else 0.0 end sumSchet23
      , case when coalesce(AttrVal.vString, '') =:(svPlan3) then SbBan.Summa else 0.0 end sumSchet4
      from SbBan
      left join AttrVal on 16060 = AttrVal.wTable and SbBan.NRec = AttrVal.cRec and :(cAttrVPlan) = AttrVal.cAttrNam
      where SbBan.DataN = :(dReport) and SbBan.PrizDel in (1,2) and SbBan.Prefix <> 'R$$'
    ) AllData
  .));
  if (objQuery.execute.errorCode = tsOk)
    sqlCopyInto(objQuery, tntRepZpByReestr, true);
  else
  {
    message('Ошибка выборки ЗП: ' + objQuery.errorCode, error);
    exit;
  }
  Result := true;
}

function GetDataZpByDept: boolean;
var cAttrVPlan: comp;
    yearN, mesN, yearNext, mesNext: word;
    objQuery: IQuery;
{
  Result := false;
  cAttrVPlan := ExtAttr_ID(coSbBan, 'Группа заказов');
  yearN := Year(dReport);
  mesN := Month(dReport);
  yearNext := Year(Add_Months(dReport, 1));
  mesNext := Month(Add_Months(dReport, 1));

  //внутри запроса задумывалось надолго
  sqlCreateTmpTable('table tReeBySchetSumRee (CexOz: comp, sumGoz: double, sumKom: double, sumSub: double, sumUnSub: double) with index (i1 = CexOz);', ctmNormal);
  objQuery := queryManager.createQuery(SQLQUERY(.
    insert tReeBySchetSumRee (CexOz, sumGoz, sumKom, sumSub, sumUnSub)
      select
        ZarOper.CexOz
      , sum(case when coalesce(AttrVal.vString, '') not in ('', :(svPlan0), :(sVPlan1), :(sVPlan2), :(sVPlan3)) then ZarOper.Summa else 0.0 end): double
      , sum(case when coalesce(AttrVal.vString, '') = '' then ZarOper.Summa else 0.0 end): double
      , sum(case when coalesce(AttrVal.vString, '') in (:(sVPlan1), :(sVPlan2), :(sVPlan3)) then ZarOper.Summa else 0.0 end): double
      , sum(case when coalesce(AttrVal.vString, '') = :(sVPlan0) then ZarOper.Summa else 0.0 end): double
      from SbBan
      left join AttrVal on 16060 = AttrVal.wTable and SbBan.NRec = AttrVal.cRec and :(cAttrVPlan) = AttrVal.cAttrNam
      inner join SpPlBan on SbBan.NRec = SpPlBan.cSbban
      inner join ZarOper on SpPlBan.NRec = ZarOper.cPlPor and 16061 = ZarOper.PrizPr
      where SbBan.DataN = :(dReport) and SbBan.PrizDel in (1,2) and SbBan.Prefix <> 'R$$' and
      (
        :(wRepDate) = 0 or SbBan.DatOk = :(dPay)
      )
      group by ZarOper.CexOz
  .));
  if (objQuery.execute.errorCode <> tsOk)
  {
    message('Ошибка выборки ЗП по подразделениям (реестры): ' + objQuery.errorCode, error);
    exit;
  }

  objQuery := queryManager.createQuery(SQLQUERY(.
    select
      coalesce(KatPodr.Kod, '-') Kod
    , coalesce(KatPodr.Name, '-') Name
    , sum(NachUd.sumNach) sumNach
    , sum(NachUd.sumUd) sumUd
    , sum(NachUd.sumGoz) sumGoz
    , sum(NachUd.sumKom) sumKom
    , sum(NachUd.sumSub) sumSub
    , sum(NachUd.sumUnSub) sumUnSub
    from 
    (
      select 
        Nachisl.CexOz
      , sum(Nachisl.Summa) sumNach
      , 0.0 sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from Nachisl
      where Nachisl.YearN = :(yearN) and Nachisl.MesN = :(mesN)
      group by Nachisl.CexOz

      union all
      select 
        SumVidOp.CexOz
      , sum(SumVidOp.Summa) sumNach
      , 0.0 sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from SumVidOp
      where SumVidOp.YearN = :(yearN) and SumVidOp.MesN = :(mesN)
      group by SumVidOp.CexOz

      union all
      select 
        Uder.CexOz 
      , 0.0 sumNach
      , sum(Uder.SumUd) sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from Uder
      inner join KlVidUd on Uder.VidUds = KlVidUd.VidUd and 
      (
        :(wRepDate) = 0 and KlVidUd.VhVo3 <> '0'
        or :(wRepDate) = 1 and KlVidUd.VidUdP not in (500, 226)
      )
      where Uder.YearN = :(yearN) and Uder.MesN = :(mesN) 
      group by Uder.CexOz

      union all
      select 
        SumVidUd.CexOz
      , 0.0 sumNach
      , sum(SumVidUd.SumUd) sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from SumVidUd
      inner join KlVidUd on SumVidUd.VidUd = KlVidUd.VidUd and 
      (
        :(wRepDate) = 0 and KlVidUd.VhVo3 <> '0'
        or :(wRepDate) = 1 and KlVidUd.VidUdP not in (500, 226)
      )
      where SumVidUd.YearN = :(yearN) and SumVidUd.MesN = :(mesN) 
      group by SumVidUd.CexOz

      union all
      select
        PrMonth.Cex CexOz
      , 0.0 sumNach
      , sum(PrMonth.Summa9) sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from PrMonth
      where PrMonth.YearN = :(yearNext) and PrMonth.MesN = :(mesNext) and PrMonth.Summa9 <> 0
      group by PrMonth.Cex

      union all
      select
        tReeBySchetSumRee.CexOz
        , 0.0 sumNach
        , 0.0 sumUd
        , tReeBySchetSumRee.sumGoz
        , tReeBySchetSumRee.sumKom
        , tReeBySchetSumRee.sumSub
        , tReeBySchetSumRee.sumUnSub
      from tReeBySchetSumRee
    ) NachUd
    inner join KatPodr on NachUd.CexOz = KatPodr.NRec and SubString(KatPodr.Kod, 1, 3) <> '446'
    group by
      coalesce(KatPodr.Kod, '-')
    , coalesce(KatPodr.Name, '-')
  .));
  if (objQuery.execute.errorCode = tsOk)
    sqlCopyInto(objQuery, tntRepZpByDept, true);
  else
  {
    message('Ошибка выборки ЗП по подразделениям: ' + objQuery.errorCode, error);
    exit;
  }
  sqlDropTmpTable('tReeBySchetSumRee');
  Result := true;
}

function GetDataZpByTabn: boolean;
var cAttrVPlan: comp;
    yearN, mesN, yearNext, mesNext: word;
    objQuery: IQuery;
{
  Result := false;
  cAttrVPlan := ExtAttr_ID(coSbBan, 'Группа заказов');
  yearN := Year(dReport);
  mesN := Month(dReport);
  yearNext := Year(Add_Months(dReport, 1));
  mesNext := Month(Add_Months(dReport, 1));

  //внутри запроса задумывалось надолго
  sqlCreateTmpTable('table tReeBySchetSumRee (CexOz: comp, cLSch: comp, sumGoz: double, sumKom: double, sumSub: double, sumUnSub: double) with index (i1 = CexOz);', ctmNormal);
  objQuery := queryManager.createQuery(SQLQUERY(.
    insert tReeBySchetSumRee (CexOz, cLSch, sumGoz, sumKom, sumSub, sumUnSub)
      select
        ZarOper.CexOz
      , ZarOper.cLschet
      , sum(case when coalesce(AttrVal.vString, '') not in ('', :(svPlan0), :(sVPlan1), :(sVPlan2), :(sVPlan3)) then ZarOper.Summa else 0.0 end): double
      , sum(case when coalesce(AttrVal.vString, '') = '' then ZarOper.Summa else 0.0 end): double
      , sum(case when coalesce(AttrVal.vString, '') in (:(sVPlan1), :(sVPlan2), :(sVPlan3)) then ZarOper.Summa else 0.0 end): double
      , sum(case when coalesce(AttrVal.vString, '') = :(sVPlan0) then ZarOper.Summa else 0.0 end): double
      from SbBan
      left join AttrVal on 16060 = AttrVal.wTable and SbBan.NRec = AttrVal.cRec and :(cAttrVPlan) = AttrVal.cAttrNam
      inner join SpPlBan on SbBan.NRec = SpPlBan.cSbban
      inner join ZarOper on SpPlBan.NRec = ZarOper.cPlPor and 16061 = ZarOper.PrizPr
      where SbBan.DataN = :(dReport) and SbBan.PrizDel in (1,2) and SbBan.Prefix <> 'R$$' and
      (
        :(wRepDate) = 0 or SbBan.DatOk =:(dPay)
      )
      group by ZarOper.CexOz, ZarOper.cLschet
  .));
  if (objQuery.execute.errorCode <> tsOk)
  {
    message('Ошибка выборки ЗП по подразделениям (реестры): ' + objQuery.errorCode, error);
    exit;
  }

  objQuery := queryManager.createQuery(SQLQUERY(.
    select
      LSchet.StrTabN TabN
    , KatPodr.Kod sPodr
    , sum(NachUd.sumNach) sumNach
    , sum(NachUd.sumUd) sumUd
    , sum(NachUd.sumGoz) sumGoz
    , sum(NachUd.sumKom) sumKom
    , sum(NachUd.sumSub) sumSub
    , sum(NachUd.sumUnSub) sumUnSub
    from 
    (
      select 
        Nachisl.CexOz, Nachisl.cLsch
      , sum(Nachisl.Summa) sumNach
      , 0.0 sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from Nachisl
      where Nachisl.YearN = :(yearN) and Nachisl.MesN = :(mesN)
      group by Nachisl.CexOz, Nachisl.cLsch

      union all
      select 
        SumVidOp.CexOz, SumVidOp.cLsch
      , sum(SumVidOp.Summa) sumNach
      , 0.0 sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from SumVidOp
      where SumVidOp.YearN = :(yearN) and SumVidOp.MesN = :(mesN)
      group by SumVidOp.CexOz, SumVidOp.cLsch

      union all
      select 
        Uder.CexOz, Uder.cLsch
      , 0.0 sumNach
      , sum(Uder.SumUd) sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from Uder
      inner join KlVidUd on Uder.VidUds = KlVidUd.VidUd and 
      (
        :(wRepDate) = 0 and KlVidUd.VhVo3 <> '0'
        or :(wRepDate) = 1 and KlVidUd.VidUdP not in (500, 226)
      )
      where Uder.YearN = :(yearN) and Uder.MesN = :(mesN) 
      group by Uder.CexOz, Uder.cLsch

      union all
      select 
        SumVidUd.CexOz, SumVidUd.cLsch
      , 0.0 sumNach
      , sum(SumVidUd.SumUd) sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from SumVidUd
      inner join KlVidUd on SumVidUd.VidUd = KlVidUd.VidUd and 
      (
        :(wRepDate) = 0 and KlVidUd.VhVo3 <> '0'
        or :(wRepDate) = 1 and KlVidUd.VidUdP not in (500, 226)
      )
      where SumVidUd.YearN = :(yearN) and SumVidUd.MesN = :(mesN) 
      group by SumVidUd.CexOz, SumVidUd.cLsch

      union all
      select
        PrMonth.Cex CexOz, PrMonth.cLsch
      , 0.0 sumNach
      , sum(PrMonth.Summa9) sumUd
      , 0.0 sumGoz
      , 0.0 sumKom
      , 0.0 sumSub
      , 0.0 sumUnSub
      from PrMonth
      where PrMonth.YearN = :(yearNext) and PrMonth.MesN = :(mesNext) and PrMonth.Summa9 <> 0
      group by PrMonth.Cex, PrMonth.cLsch

      union all
      select
          tReeBySchetSumRee.CexOz
        , tReeBySchetSumRee.cLSch
        , 0.0 sumNach
        , 0.0 sumUd
        , tReeBySchetSumRee.sumGoz
        , tReeBySchetSumRee.sumKom
        , tReeBySchetSumRee.sumSub
        , tReeBySchetSumRee.sumUnSub
      from tReeBySchetSumRee

    ) NachUd
    inner join LSchet on NachUd.cLSch = LSchet.NRec
    inner join KatPodr on NachUd.CexOz = KatPodr.NRec and SubString(KatPodr.Kod, 1, 3) <> '446'
    group by
      LSchet.StrTabN
    , KatPodr.Kod
  .));
  if (objQuery.execute.errorCode = tsOk)
    sqlCopyInto(objQuery, tntRepZpByTabN, true);
  else
  {
    message('Ошибка выборки ЗП по подразделениям: ' + objQuery.errorCode, error);
    exit;
  }
  sqlDropTmpTable('tReeBySchetSumRee');
  Result := true;
}

function GetDataNDFLByReestr: boolean;
var cAttrVPlan: comp;
    objQuery: IQuery;
{
  Result := false;
  cAttrVPlan := ExtAttr_ID(coSbBan, 'Группа заказов');
 
  objQuery := queryManager.createQuery(SQLQUERY(.
    select
      AllData.NRec
    , AllData.Num
    , AllData.dPlat
    , AllData.sBank
    , AllData.sumSchet0 "sumSchet[0]"
    , AllData.sumSchet1 "sumSchet[1]"
    , AllData.sumSchet2 "sumSchet[2]"
    , AllData.sumSchet23 - AllData.sumSchet2 "sumSchet[3]"
    , AllData.sumSchet4 "sumSchet[4]"
    from (
      select
        SbBan.NRec NRec
      , SbBan.LastUser num
      , SbBan.DatOk dPlat
      , case coalesce(AttrVal.vString, '') 
          when '' then 'Коммерческие'
          when :(svPlan1) then 'Субсидия'
          when :(svPlan2) then 'Субсидия'
          when :(svPlan3) then 'Субсидия'
          when 'Несубсидируемое' then AttrVal.vString
          else 'Гос. заказ (' || AttrVal.vString || ')'
        end sBank: string
      , case when coalesce(AttrVal.vString, '') not in (:(svPlan1), :(svPlan2), :(svPlan3)) then SbBan.Summa else 0.0 end sumSchet0
      , case when coalesce(AttrVal.vString, '') =:(svPlan1) then SbBan.Summa else 0.0 end sumSchet1
      , case when coalesce(AttrVal.vString, '') =:(svPlan2) then 
          coalesce((
            select sum(round(SpPlBan.SumOpl * tReeBySchetSumZ.sm23 / tReeBySchetSumZ.smAll, 2))
            from SpPlBan 
            inner join tReeBySchetSumZ on SpPlBan.cLsch = tReeBySchetSumZ.cLSchet
            where SpPlBan.cSbBan = SbBan.NRec
          ), 0.0)
        else 0.0 
        end sumSchet2
      , case when coalesce(AttrVal.vString, '') =:(svPlan2) then SbBan.Summa else 0.0 end sumSchet23
      , case when coalesce(AttrVal.vString, '') =:(svPlan3) then SbBan.Summa else 0.0 end sumSchet4
      from SbBan
      left join AttrVal on 16060 = AttrVal.wTable and SbBan.NRec = AttrVal.cRec and :(cAttrVPlan) = AttrVal.cAttrNam
      where SbBan.DataN = :(dReport) and SbBan.PrizDel = 3 and SbBan.Prefix <> 'R$$'
    ) AllData
  .));
  if (objQuery.execute.errorCode = tsOk)
    sqlCopyInto(objQuery, tntRepNDFLByReestr, true);
  else
  {
    message('Ошибка выборки НДФЛ: ' + objQuery.errorCode, error);
    exit;
  }
  Result := true;
}

function GetDataStrahByReestr: boolean;
var cAttrVPlan: comp;
    objQuery: IQuery;
{
  Result := false;
  cAttrVPlan := ExtAttr_ID(coSbBan, 'Группа заказов');
 
  objQuery := queryManager.createQuery(SQLQUERY(.
    select
      AllData.NRec
    , AllData.sVidPer
    , AllData.Num
    , AllData.dPlat
    , AllData.sBank
    , AllData.sumSchet0 "sumSchet[0]"
    , AllData.sumSchet1 "sumSchet[1]"
    , AllData.sumSchet2 "sumSchet[2]"
    , AllData.sumSchet23 - AllData.sumSchet2 "sumSchet[3]"
    , AllData.sumSchet4 "sumSchet[4]"
    from (
      select
        SbBan.NRec NRec
      , case SbBan.VidPer
          when 2 then 'ФСС'
          when 3 then 'ФОМС'
          when 8 then 'Травматизм'
          else 'ПФР'
        end sVidPer
      , SbBan.LastUser num
      , SbBan.DatOk dPlat
      , case coalesce(AttrVal.vString, '') 
          when '' then 'Коммерческие'
          when :(svPlan1) then 'Субсидия'
          when :(svPlan2) then 'Субсидия'
          when :(svPlan3) then 'Субсидия'
          when 'Несубсидируемое' then AttrVal.vString
          else 'Гос. заказ (' || AttrVal.vString || ')'
        end sBank: string
      , case when coalesce(AttrVal.vString, '') not in (:(svPlan1), :(svPlan2), :(svPlan3)) then SbBan.Summa else 0.0 end sumSchet0
      , case when coalesce(AttrVal.vString, '') =:(svPlan1) then SbBan.Summa else 0.0 end sumSchet1
      , case when coalesce(AttrVal.vString, '') =:(svPlan2) then 
          coalesce((
            select sum(round(SpPlBan.SumOpl * tReeBySchetSumZ.sm23 / tReeBySchetSumZ.smAll, 2))
            from SpPlBan 
            inner join tReeBySchetSumZ on SpPlBan.cLsch = tReeBySchetSumZ.cLSchet
            where SpPlBan.cSbBan = SbBan.NRec
          ), 0.0)
        else 0.0 
        end sumSchet2
      , case when coalesce(AttrVal.vString, '') =:(svPlan2) then SbBan.Summa else 0.0 end sumSchet23
      , case when coalesce(AttrVal.vString, '') =:(svPlan3) then SbBan.Summa else 0.0 end sumSchet4
      from SbBan
      left join AttrVal on 16060 = AttrVal.wTable and SbBan.NRec = AttrVal.cRec and :(cAttrVPlan) = AttrVal.cAttrNam
      where SbBan.DataN = :(dReport) and SbBan.PrizDel = 9 and SbBan.Prefix <> 'R$$'
    ) AllData
  .));
  if (objQuery.execute.errorCode = tsOk)
    sqlCopyInto(objQuery, tntRepStrahByReestr, true);
  else
  {
    message('Ошибка выборки страховых взносов: ' + objQuery.errorCode, error);
    exit;
  }
  Result := true;
}

function CreateReports: boolean;
{
  Result := false;
  if not FillCommonData exit;
  if not NextVisual exit;

  if (wReport and 00001b) <> 0
    if not GetDataZpByReestr exit;
  if not NextVisual exit;

  if (wReport and 00010b) <> 0
    if not GetDataZpByDept exit;
  if not NextVisual exit;

  if (wReport and 00100b) <> 0
    if not GetDataZpByTabn exit;
  if not NextVisual exit;

  if (wReport and 01000b) <> 0
    if not GetDataNDFLByReestr exit;
  if not NextVisual exit;

  if (wReport and 10000b) <> 0
    if not GetDataStrahByReestr exit;
  if not NextVisual exit;
  Result := true;
}

handleEvent
  cmInit:
  {
    dReport := dGetTune('UP.DATOTCH');
    wReport := 11111b;
  }
  cmOK:
  {
    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Подготовка отчетов', 0);
    dReport := date(1, Month(dReport), Year(dReport));
    if CreateReports
    {
      PrintReports;
      CloseInterface(cmDefault);
    }
    StopVisual;
  }
end;
!-------------------------------------------------------------------------------
procedure Run;
{
  RunWindowModal(wnMainWindow);
}
function GetReportName: String;
{
  Result := 'Реестры на перечисление с разбивкой по счетам учета';
}
function GetGroupName (Level : Word) : String;
{
  #__UNUSED__(Level)
  Result := '';
}
function GetPriority : Integer;
{
  Result := 0;
}
function VisibleInModule(Ind : Byte) : String;
{
  Result := '';
  case Ind of
    1 : Result := 'MENUZARP';
  end;
}
!-------------------------------------------------------------------------------
end.
