#include UserReport.vih
#include Query.vih

VipInterface UserReport_GP_RepReestrBySchet implements IUserReport;
interface UserReport_GP_RepReestrBySchet 'Реестры на перечисление с разбивкой по счетам учета';
show (,,75,10);

table struct tRepZpByReestr (NRec: comp, num: string, dPlat: date, sBank: string, sumSchet: array[0..4] of double) (i1 = NRec, i2 = dPlat);
table struct tRepZpByDept (kod: string, name: string, sumNach: double, sumUd: double, sumGoz: double, sumKom: double, sumSub: double, sumUnSub: double) (i1 = kod);
table struct tRepZpByTabN (tabn: string, sPodr: string, sumNach: double, sumUd: double, sumGoz: double, sumKom: double, sumSub: double, sumUnSub: double) (i1 = tabn);
table struct tRepNDFLByReestr (NRec: comp, num: string, dPlat: date, sBank: string, sumSchet: array[0..4] of double) (i1 = NRec, i2 = dPlat);
table struct tRepStrahByReestr (NRec: comp, sVidPer: string, num: string, dPlat: date, sBank: string, sumSchet: array[0..4] of double) (i1 = NRec, i2 = sVidPer + dPlat);
create view
var dReport, dPay: date;
    wReport, wRepDate: word;
    sVPlan0, sVPlan1, sVPlan2, sVPlan3: string;//dsql глючит, если параметры элементы массива (
as select *
from
  tRepNDFLByReestr
, tRepStrahByReestr
, tRepZpByDept
, tRepZpByReestr
, tRepZpByTabN
;

screen sc1;
notablenavigation;
fields
  dReport: [, 'Month YYYY'], noprotect;
  wReport: noprotect;
  wRepDate: noprotect, noframe;
  dPay: noprotect;
buttons
  cmOK;
  cmCancel;
<<
  `Период` .@@@@@@@@@@@@@@@@@@@@@@
   `Отчеты`
  [.] Реестр платежей ЗП`
  [.] Реестр ЗП по подразделениям`  [.] Только с датой выплаты` .@@@@@@@@@@
  [.] Реестр ЗП по сотрудникам`
  [.] Реестр платежей по НДФЛ`
  [.] Реестр платежей по страховым взносам`

  <. Сформировать .> <.    Отмена    .>
>>
end;

var eps: array [1..1] of double;
procedure PrepareRoundErrors(maxCol: word);
var i: longint;
{
  SetLimit(eps, maxCol);
  for (i := 1; i <= maxCol; i++)
    eps[i] := 0;
}
function xlRdWriteToMatrix(row, col: longint; value: double; precision: integer = 2): boolean;
var v: double;
{
  v := Round(value + eps[col], precision);
  eps[col] := value + eps[col] - v;
  Result := XLDOWRITETOMATRIX(row, col, v);
}

function PrintRepZpByReestr: boolean;
var r1, kolR, kolC, i, j, npp: longint;
{
  Result := false;
  XLSETACTIVESHEETBYNAME('Реестр ЗП');
  XLSETCELLSTRINGVALUE(DateToStr(dReport, 'month YYYY'), 3, 1, 3, 1);
  r1 := 7;
  kolC := 14;
  kolR := RecordsInTable(tntRepZpByReestr);
  PrepareRoundErrors(kolC);
  XLCREATEMATRIX(kolR, kolC);
  if KolR > 2 then XLINSERTRANGE(xlShiftDown, r1 + 1, 1, r1 + KolR - 2, KolC);
  if KolR < 2 then XLDELETERANGE(xlShiftUp, r1, 1, r1 + 1 - KolR, KolC);
  i := npp := 0;
  _loop tRepZpByReestr ordered by tRepZpByReestr.dPlat
  {
    j := 0;
    XLDOWRITETOMATRIX(++i, ++j, ++npp);
    XLSTWRITETOMATRIX(  i, ++j, tRepZpByReestr.num);
    XLSTWRITETOMATRIX(  i, ++j, DateToStr(tRepZpByReestr.dPlat, 'DD.MM.YYYY'));
    XLSTWRITETOMATRIX(  i, ++j, tRepZpByReestr.sBank);
    XLSTWRITETOMATRIX(  i, ++j, '=RC[1]+RC[2]+RC[3]+RC[4]+RC[5]');
    xlRdWriteToMatrix(  i, ++j, tRepZpByReestr.sumSchet[1]);
    xlRdWriteToMatrix(  i, ++j, tRepZpByReestr.sumSchet[2]);
    xlRdWriteToMatrix(  i, ++j, tRepZpByReestr.sumSchet[3]);
    xlRdWriteToMatrix(  i, ++j, tRepZpByReestr.sumSchet[4]);
    xlRdWriteToMatrix(  i, ++j, tRepZpByReestr.sumSchet[0]);
    XLSTWRITETOMATRIX(  i, ++j, '=RC[-6]-RC[-1]');
    XLSTWRITETOMATRIX(  i, ++j, '=RC[-6]');
    XLSTWRITETOMATRIX(  i, ++j, '=RC[-6]+RC[-5]');
    XLSTWRITETOMATRIX(  i, ++j, '=RC[-5]');
  }
  XLWRITEMATRIXTOEXCEL(r1, 1);
  Result := true;
}

function PrintRepZpByDept: boolean;
var r1, kolR, kolC, i, j, npp: longint;
{
  Result := false;
  XLSETACTIVESHEETBYNAME('Реестр ЗП по подразд.');
  XLSETCELLSTRINGVALUE(DateToStr(dReport, 'month YYYY'), 2, 1, 2, 1);
  r1 := 9;
  kolC := 10;
  kolR := RecordsInTable(tntRepZpByDept);
  PrepareRoundErrors(kolC);
  XLCREATEMATRIX(kolR, kolC);
  if KolR > 2 then XLINSERTRANGE(xlShiftDown, r1 + 1, 1, r1 + KolR - 2, KolC);
  if KolR < 2 then XLDELETERANGE(xlShiftUp, r1, 1, r1 + 1 - KolR, KolC);
  i := npp := 0;
  _loop tRepZpByDept ordered by tRepZpByDept.kod
  {
    j := 0;
    XLDOWRITETOMATRIX(++i, ++j, ++npp);
    XLSTWRITETOMATRIX(  i, ++j, tRepZpByDept.kod);
    XLSTWRITETOMATRIX(  i, ++j, tRepZpByDept.name);
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumNach);
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumUd);
    XLSTWRITETOMATRIX(  i, ++j, '=RC[1]+RC[2]');
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumGoz);
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumKom + tRepZpByDept.sumSub + tRepZpByDept.sumUnSub);
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumKom + tRepZpByDept.sumUnSub);
    XLSTWRITETOMATRIX(  i, ++j, '=RC[-2]-RC[-1]');
  }
  XLWRITEMATRIXTOEXCEL(r1, 1);
  Result := true;
}

