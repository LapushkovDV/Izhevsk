/*************************************************************************************************\
* Наименование:  Распределение затрат на отпуска по счетам и заказам                              *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#810          |16/04/18 |Ермолов К.Р.             |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih
#include GetKau.vih
#include Query.vih

interface gp_raszatotpusk 'Параметры отчета' gray
show at (,, 40, 10);

table struct otchet
(
sch: string,
zakaznmb: string,
fot: decimal(31,15),
strah: decimal(31,15)
)
with index
(
i1 = sch + zakaznmb (unique)
)
;

table struct tFot
(
sch: string,
zakaznmb: string,
sum: decimal(31,15)
)
with index
(
i1 = sch + zakaznmb (unique)
)
;

table struct tStrah
(
sch: string,
zakaznmb: string,
sum: decimal(31,15)
)
with index
(
i1 = sch + zakaznmb (unique)
)
;

#include Getkau.var
var mPodr: TPtr;

function GetMPodrFld: string;
{
  result := '';
  var cnt: longint = GetMarkerCount(mPodr);
  case cnt of
    0:
      result := '';
    1:
    {
      var c: comp = 0;
      if GetMarker(mPodr, 0, c)
        result := ShowKau(cgKau_KatPodr, c);
    }
    else
      result := 'Выбрано подразделений: ' + cnt;
  end;
}

create view gp_raszatotpusk

var
ExcelPath: string;
mes1, mes2, vid: word;
god: integer;
proc1, proc2: double;
counter: longint;
q: IQuery;

select otchet.sch
 ,GetMPodrFld() (fieldname=mPodrFld)
from otchet, tFot, tStrah, perech
where ((13 == perech.vidper));

screen scr ('Параметры отчета',,sci1Esc);
  fields
  mes1 : [list
      1 'Январь',
      2 'Февраль',
      3 'Март',
      4 'Апрель',
      5 'Май',
      6 'Июнь',
      7 'Июль',
      8 'Август',
      9 'Сентябрь',
      10 'Октябрь',
      11 'Ноябрь',
      12 'Декабрь'], protect;
  mes2 : [list
      1 'Январь',
      2 'Февраль',
      3 'Март',
      4 'Апрель',
      5 'Май',
      6 'Июнь',
      7 'Июль',
      8 'Август',
      9 'Сентябрь',
      10 'Октябрь',
      11 'Ноябрь',
      12 'Декабрь'], protect;
  god: noprotect, spinbutton [1, 1917, 2117];
  proc1: [4.2], noprotect;
  proc2: [4.2], noprotect;
  vid : [list
      1 'По данным модуля з/п',
      2 'По сформированным проводкам'], protect;
  mPodrFld: protect, pickbutton;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Месяц c .@@@@@@@@@@ по .@@@@@@@@@@
    Год:    .@@@@@
    % отч. для ФОТ               .@@@@
    % отч. для страх. взносов    .@@@@
    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    Подразделения .@@@@@@@@@@@@@@@@@@@

    <.Сформировать.>

    >>
end;

  sql query q1 =
  select buhschet.code, mnplan.number, sum(nachislzakaz.summa)/100*:proc1,  (sum(nachislzakaz.summa)/100*:proc1 )/100*:proc2
  from mnplan
  left join buhschet on buhschet.nrec = mnplan.canval2
  left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7
  inner join lschet ls on nachislzakaz.clsch=ls.nrec
  inner join klvidopl on klvidopl.vidopl = nachislzakaz.vidopls
  inner join attrval on attrval.crec = klvidopl.nrec
  inner join attrnam on attrnam.nrec = attrval.cattrnam and attrnam.name = '908 Фонд Резерв (ОВР)'
  inner join katpodr on katpodr.nrec = nachislzakaz.cexoz and katpodr.nrec in (select TmpPodr.nrec from TmpPodr)
  where (nachislzakaz.mesn between :mes1 and :mes2) and nachislzakaz.yearn = :god
  and ( (ls.dates[2]=0) or (ls.dates[2]<>0 and d_month(ls.dates[2])<nachislzakaz.mesn and (d_year(ls.dates[2])<nachislzakaz.yearn or d_year(ls.dates[2])=nachislzakaz.yearn)) )
  group by buhschet.code, mnplan.number
  ;

  sql query q2 =
  select oborot.dbscheto, mnplan.number, sum(oborot.sumob), 0
  from oborot
  inner join mnplan on mnplan.nrec = oborot.kauos[1]
  inner join spkau on spkau.nrec = oborot.kauks[1]
  inner join stzatr on stzatr.nrec = oborot.kauos[2]
  left join katpodr on katpodr.nrec = oborot.kodspo and katpodr.nrec in (select TmpPodr.nrec from TmpPodr)
  where ((spkau.name = 'Резерв (фактический) отпуск')
  or (spkau.name = 'Резерв (фактический) отпуск Налоги' and  stzatr.name = '69 Отчисления с з/платы'))
  and (cast(substring(date2str('%MM', oborot.datob),1,2) as word) between :mes1 and :mes2 )
  and cast(substring(date2str('%yyyy', oborot.datob),1,4) as integer) = :god
  group by oborot.dbscheto, mnplan.number
  ;

  sql query q3 =
  select oborot.dbscheto, mnplan.number,  sum(oborot.sumob)
  from oborot
  inner join mnplan on mnplan.nrec = oborot.kauos[1]
  inner join spkau on spkau.nrec = oborot.kauks[1]
  inner join stzatr on stzatr.nrec = oborot.kauos[2]
  left join katpodr on katpodr.nrec = oborot.kodspo and katpodr.nrec in (select TmpPodr.nrec from TmpPodr)
  where spkau.name = 'Резерв (фактический) отпуск'
  and (cast(substring(date2str('%MM', oborot.datob),1,2) as word) between :mes1 and :mes2 )
  and cast(substring(date2str('%yyyy', oborot.datob),1,4) as integer) = :god
  group by oborot.dbscheto, mnplan.number
  ;

  sql query q4 =
  select oborot.dbscheto, mnplan.number, sum(oborot.sumob)
  from oborot
  inner join mnplan on mnplan.nrec = oborot.kauos[1]
  inner join spkau on spkau.nrec = oborot.kauks[1]
  inner join stzatr on stzatr.nrec = oborot.kauos[2]
  left join katpodr on katpodr.nrec = oborot.kodspo and katpodr.nrec in (select TmpPodr.nrec from TmpPodr)
  where spkau.name = 'Резерв (фактический) отпуск Налоги' and  stzatr.name = '69 Отчисления с з/платы'
  and (cast(substring(date2str('%MM', oborot.datob),1,2) as word) between :mes1 and :mes2 )
  and cast(substring(date2str('%yyyy', oborot.datob),1,4) as integer) = :god
  group by oborot.dbscheto, mnplan.number
  ;

handleevent

cmInit:
{
  god:= year(dgettune('UP.DATOTCH'));
  mes1:= month(dgettune('UP.DATOTCH'));
  mes2:= month(dgettune('UP.DATOTCH'));
  mPodr := InitMarker('gp_raszatotpusk_mPodr', 8, 10, 10, true);
  vid:= 1;
  proc1:= perech.procper;
  proc2:= 30.2;
}

cmDone:
{
  DoneMarker(mPodr, 'gp_raszatotpusk_mPodr');
}

cmPick:
{
  case curfield of
    #mPodrFld:
    {
      if iGetKau.GetCodeKau(cgiMulti, cgKau_KatPodr, 0) > 0
      {
        DoneMarker(mPodr, '');
        mPodr := InitMarker(iGetKau.GetMarkerName(cgKau_KatPodr), SizeOf(Comp), 10, 100, true);
        ReReadRecord;
      }
    }
  end;
}

cmDelOnProtect:
{
  case curfield of
    #mPodrFld:
    {
      ClearMarker(mPodr);
      ReReadRecord;
    }
  end;
}

cmGo:
{
  var err: integer = 0;
  err := sqlCreateTmpTable('Table TmpPodr (Nrec: comp);', ctmNormal);

  var stmt: longint = sqlAllocStmt;
  sqlPrepare(stmt, 'insert TmpPodr (Nrec) values (?)');
  var i: longint = 0;
  var c: comp = 0;
  for(i := 0; GetMarker(mPodr, i, c); i++)
  {
    sqlBindParam(stmt, 1, c);
    err := sqlExecute(stmt);
  }
  sqlFreeStmt(stmt);

if mes1 > mes2 then message('Неправильно задан период')
else
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from otchet;
  delete all from tFot;
  delete all from tStrah;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_raszatotpusk.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  if mes1 = mes2 then xlsetcellstringvalue('ЗА ' + mes1 + ' МЕСЯЦ ' + god + ' ГОДА', 2, 1, 2, 1)
  else xlsetcellstringvalue('ЗА ПЕРИОД С ' + mes1 + ' МЕСЯЦА ПО ' + mes2 + ' МЕСЯЦ ' + god + ' ГОДА', 2, 1, 2, 1);

  counter:= 4;

if vid = 1
{
  q:= queryManager.createQuery(q1);
  q.setParam('mes1', mes1);
  q.setParam('mes2', mes2);
  q.setParam('god', god);
  q.setParam('proc1', proc1);
  q.setParam('proc2', proc2);
  if q.execute.errorcode = tsOk
    sqlCopyInto(q, tnOtchet, false)
  else
    Message('Ошибка выполнения запроса: ' + q.errorCode);

  _loop otchet
  {
    counter++;
    xlsetcellstringvalue(otchet.sch, counter, 1, counter, 1);
    xlsetcellstringvalue(otchet.zakaznmb, counter, 2, counter, 2);
    xlsetcellnumbervalue(otchet.fot, counter, 3, counter, 3);
    if otchet.fot = 0
    {
      xlsetcellnumbervalue(0, counter, 4, counter, 4)
    }
    else
    {
      xlsetcellnumbervalue(otchet.strah, counter, 4, counter, 4);
    }
    xlsetcellstringvalue('=RC[-1]+RC[-2]', counter, 5, counter, 5);
  }

  counter++;
  xlmergecells(counter, 1, counter, 2);
  xlAlignCells(-4152, counter, 1, counter, 1);
  xlsetfontstyle(1, counter, 1, counter, 5);
  xlsetcellstringvalue('Итого:', counter, 1, counter, 1);
  xlsetcellformula('=СУММ(C5:C' + (counter - 1) + ')', counter, 3, counter, 3);
  xlsetcellformula('=СУММ(D5:D' + (counter - 1) + ')', counter, 4, counter, 4);
  xlsetcellformula('=СУММ(E5:E' + (counter - 1) + ')', counter, 5, counter, 5);
}
if vid = 2
{
  q:= queryManager.createQuery(q2);
  q.setParam('mes1', mes1);
  q.setParam('mes2', mes2);
  q.setParam('god', god);
  if q.execute.errorcode = tsOk
    sqlCopyInto(q, tnOtchet, false)
  else
    Message('Ошибка выполнения запроса: ' + q.errorCode);

  q:= queryManager.createQuery(q3);
  q.setParam('mes1', mes1);
  q.setParam('mes2', mes2);
  q.setParam('god', god);
  if q.execute.errorcode = tsOk
    sqlCopyInto(q, tntFot, false)
  else
    Message('Ошибка выполнения запроса: ' + q.errorCode);

  q:= queryManager.createQuery(q4);
  q.setParam('mes1', mes1);
  q.setParam('mes2', mes2);
  q.setParam('god', god);
  if q.execute.errorcode = tsOk
    sqlCopyInto(q, tntStrah, false)
  else
    Message('Ошибка выполнения запроса: ' + q.errorCode);

  _loop otchet
  {
    counter++;
    xlsetcellstringvalue(otchet.sch, counter, 1, counter, 1);
    xlsetcellstringvalue(otchet.zakaznmb, counter, 2, counter, 2);
    xlsetcellnumbervalue(otchet.fot, counter, 5, counter, 5);

    if getfirst tFot where ((otchet.sch == tFot.sch and otchet.zakaznmb == tFot.zakaznmb)) = tsok then xlsetcellnumbervalue(tFot.sum, counter, 3, counter, 3);
    if getfirst tStrah where ((otchet.sch == tStrah.sch and otchet.zakaznmb == tStrah.zakaznmb)) = tsok then xlsetcellnumbervalue(tStrah.sum, counter, 4, counter, 4);

  }

  counter++;
  xlmergecells(counter, 1, counter, 2);
  xlAlignCells(-4152, counter, 1, counter, 1);
  xlsetfontstyle(1, counter, 1, counter, 5);
  xlsetcellstringvalue('Итого:', counter, 1, counter, 1);
  xlsetcellformula('=СУММ(C5:C' + (counter - 1) + ')', counter, 3, counter, 3);
  xlsetcellformula('=СУММ(D5:D' + (counter - 1) + ')', counter, 4, counter, 4);
  xlsetcellformula('=СУММ(E5:E' + (counter - 1) + ')', counter, 5, counter, 5);
}
  xlframecells(1+2+4+8+16+32, 3, 1, 1, 3, 1, counter, 5);

  StopVisual('',0);
  xlkillExcel;
}
  SqlDropTmpTable('TmpPodr');
}

end;
end.

VipInterface UserReport_raszatotpusk Implements IUserReport;
Interface UserReport_raszatotpusk;

Procedure Run;
Begin
  runinterface(gp_raszatotpusk);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Распределение затрат на отпуска по счетам и заказам';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Экономическая и статистическая отчетность';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
