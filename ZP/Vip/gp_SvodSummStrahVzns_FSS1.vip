interface gp_BazaNazhFss1 'База начисления ФСС от 10.05.2018' EscClose, Gray;
  show at (,,80,10);

table struct Svod
(
kod    : integer, //номер строки шаблона
type   : integer, //с нарастающим итогом или текущий месяц
sumper : double, //сумма
isArh  :integer //по текщему месяцу, по архиву, 1-архив, 2 -текущий месяц, 3 - неначисляемые суммы
)
with index
(
SvodVneBud1 = Kod+type+isArh
)
;

create view SvodSummStrahVzns

var
  ExcelPath: string;
  i: integer;
  YearFill    : integer;
  MonthBeg,
  MonthEnd   : word;


Summ4000:double;//narast itog
Summ4000_1:double;
Summ50000:double;
Summ50000_1:double;
SummPrev:double;//Narast Itog
SummPrev_1:double;
SummDo:double;//Narast Itog
SummDo_1:double;
SummPosle:double;
SummPosle_1:double;


from 
 Svod, prmonth, katpodr, katpodr katpodr1, sumulsoc, svod svod1, Helptabn
where 
((prmonth.cex==katpodr.nrec
and sumulsoc.cex==katpodr1.nrec))
;

screen scr ('Параметры отчета',,sci178EnEscInsPM);
!  show at (,,,1)
  fields
  YearFill:         NoProtect, spinbutton [1, 1900, 2100];
  MonthBeg('Отчетный месяц', ,sci13Esc):
                 [LIST 1
                 'Январь',
                 'Февраль',
                 'Март',
                 'Апрель',
                 'Май',
                 'Июнь',
                 'Июль',
                 'Август',
                 'Сентябрь',
                 'Октябрь',
                 'Ноябрь',
                 'Декабрь'
                 ] Protect;
  MonthEnd('Отчетный месяц',,sci13Esc):
                 [LIST 1
                 'Январь',
                 'Февраль',
                 'Март',
                 'Апрель',
                 'Май',
                 'Июнь',
                 'Июль',
                 'Август',
                 'Сентябрь',
                 'Октябрь',
                 'Ноябрь',
                 'Декабрь'
                 ] Protect;

buttons
    cmGo, ,, 'Сформировать отчет' ,,;
    <<
   `Год`.@@@@@`Месяц с`.@@@@@@@@@@`Месяц по`.@@@@@@@@@@

    <.Сформировать отчет.>

    >>

end;

handleevent

cmInit:
{
!ExcelPath:='\\dep968-terminal\User_disk\Galaktika\WorkFolder\ERPDB\Nikolai.Plinda\';

  ExcelPath:= TranslatePath('%ClientStartPath%');

  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\zp\gp_Baza_Fss.xlsx',true);
  if (xlIsExcelValid)   xlSetActiveSheet(1);//активный лист


  // Инициализация отчетных дат данными из настроек
  InitCurrentPeriodDates();

  if (not ReadMyDSK(YearFill, 'YearFill_SvodVneBud', false))
          YearFill := YearRas;
  if (not ReadMyDSK(MonthBeg, 'MonthBeg_SvodVneBud', false))
          MonthBeg := MonthRas;
  if (not ReadMyDSK(MonthEnd, 'MonthEnd_SvodVneBud', false))
          MonthEnd := MonthRas;

}

cmCheckField:
{
  if CurField = #MonthBeg
  {
     if MonthBeg > MonthEnd
       MonthBeg := MonthEnd
  }
  if CurField = #MonthEnd
  {
     if MonthBeg > MonthEnd
       MonthEnd := MonthBeg
  }
}

cmGo:
{


StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Обработка информации', 1);

delete all Svod;

//Сумма облагаемых видов оплат 
sql 
select 1,1,sum(sumvidop.summa),1 from sumvidop
left join klvidopl on sumvidop.vidopl=klvidopl.vidopl
left join katpodr on sumvidop.cexoz=katpodr.nrec
where
KLVIDOPL.VHVOE[34]='+' 
and sumvidop.yearn=:(YearFill) and sumvidop.mesn = :(MonthEnd)
and katpodr.kod<>'446' and katpodr.kod<>'Вет'
into Svod
;


sql
select 
1,2,sum(sumvidop.summa),1
from sumvidop
left join klvidopl on sumvidop.vidopl=klvidopl.vidopl
left join katpodr on sumvidop.cexoz=katpodr.nrec
where
KLVIDOPL.VHVOE[34]='+' 
and sumvidop.yearn=:(YearFill) and sumvidop.mesn >= :(MonthBeg) and sumvidop.mesn <= :(MonthEnd)
and katpodr.kod<>'446' and katpodr.kod<>'Вет'
into Svod
;


