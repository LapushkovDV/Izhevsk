;




              XlSetCellStringValue(' '+Case(MonthEnd;
                                                                    1 : 'Январь',
                                                                    2 : 'Февраль',
                                                                    3 : 'Март',
                                                                    4 : 'Апрель',
                                                                    5 : 'Май',
                                                                    6 : 'Июнь',
                                                                    7 : 'Июль',
                                                                    8 : 'Август',
                                                                    9 : 'Сентябрь',
                                                                    10 : 'Октябрь',
                                                                    11 : 'Ноябрь',
                                                                    12 : 'Декабрь'
                                                                ) +' '+String(YearFill) + ' года.'
                                 ,2,2,2,2);





!message(RecordsInTable(#Svod));

	_loop svod 
	{
		_loop svod1 where ((svod.kod==svod1.kod and svod.type==svod1.type and svod.isArh<<svod1.isArh))
		{
		svod.sumper:=svod.sumper+svod1.sumper;
		update current svod;
		delete current svod1;
		}

	}


_loop svod
{
xlSetCellNumberValue(Svod.sumper,5+Svod.Kod,1+Svod.type,5+Svod.Kod,1+Svod.type);
}

!puttabletodbf(#Svod,ExcelPath+'Svod.xls',ptfFullTable);
xlKillExcel;




StopVisual('',0);





}

cmClose:
{
  SaveMyDSK(YearFill, 'YearFill_SvodVneBud');
  SaveMyDSK(MonthBeg, 'MonthBeg_SvodVneBud');
  SaveMyDSK(MonthEnd, 'MonthEnd_SvodVneBud');
}

cmDone:
{
  SaveMyDSK(YearFill, 'YearFill_SvodVneBud');
  SaveMyDSK(MonthBeg, 'MonthBeg_SvodVneBud');
  SaveMyDSK(MonthEnd, 'MonthEnd_SvodVneBud');
}
end;
end.

#include UserReport.vih

VipInterface UserReport_Gp_SvodSummStrahVznsFss1 Implements IUserReport;
Interface UserReport_Gp_SvodSummStrahVznsFss1;

Procedure Run;
Begin
  runinterface(gp_BazaNazhFss1);
End;

Function GetReportName: String;
Begin
  GetReportName := 'БАЗА ФСС от 10.05.2018';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
