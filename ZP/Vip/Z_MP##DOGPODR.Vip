#component "Z_MP"
Alter interface DOGPODR;
OverLoad
  procedure SetEditMode(mode: boolean);
end;
var
  pVA_DOGPODR_Content :comp;
create view Zdogpodr
 as select
  sGetAttrID(coDOGPODR,DOGPODR.Nrec,pVA_DOGPODR_Content) (Fieldname=VA_DOGPODR_Content,FieldTitle='Краткое содержание договора');
;

//---------------------------
ExtendFormats VIEWDOGPODR;
//---------------------------
  browse ViewDogPodr(,hcZar_KATdogPodr, sci1478EscIns);
    table DOGPODR;
    fields
      {font = {color = if (MarkedSign <> '', ColorMark, 0)}};
    VA_DOGPODR_Content 'Краткое содержание договора' (,,sci1478EscIns) :[25],Protect;
  end;//browse ViewDogPodr(,hcZar_KATdogPodr, sci1478EscIns);

//-----------------------------------
//Установка режима редактирования
procedure SetEditMode(mode: boolean);
{ Inherited::SetEditMode(mode);
  ToggleFieldProtected(#VA_DOGPODR_Content,not editMode);
} //procedure SetEditMode(mode: boolean);


//---------------------------
// События интерфейса
//---------------------------
HandleEvent
cmInit:
{   pVA_DOGPODR_Content:=ExtAttr_Create(coDOGPODR,'Краткое содержание договора',cgAttrType_Str);
    case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
    end;
}
cmExprFieldChanged:
{ case CurField of
  #VA_DOGPODR_Content:
  { sSetAttrID(coDOGPODR,DOGPODR.Nrec,pVA_DOGPODR_Content,ExprFieldValue);
  }
  end;
  case inherited :: handleEvent (cmExprFieldChanged) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
}
end;
end.
