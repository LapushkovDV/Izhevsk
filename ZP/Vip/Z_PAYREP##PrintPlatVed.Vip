#include PechPlvn.vih

#component "Z_PAYREP"
#doc
 ЗП - отчеты - расчеты по оплате труда - Платежная ведомость - печать
#end
Alter interface PrintPlatVed;
OverLoad
datastream dsPlatVed;
procedure IPrintPlatVed.FormData;  //формирование

end;

var
	Schet_Korr:string;// Корреспондирующий счет - текстовое поле, по умолчанию <70>
	DTRAS_B,DTRAS_E:date;// Расчетный период - период дат
	Nazn_Vipl:string;// Назначение выплаты - длинное текстовое поле
  Fio_Sos        // составитель
, Dgn_Sos        // должность составителя
    :string;
	Dgn_ruk:string;
	Dgn_Buh:string;
	Dgn_Exe:string;
	Dov_ruk:string;
	Dov_Buh:string;
	Dov_Exe:string;
Create view SPlatVed
as select PassportRus.Nrec
from
  Lschet LschetFr
 ,Persons  PersonsFR
 ,PassPorts PassportRus
where
((
    tmpSPPlatVedFR.cLsch == LschetFR.Nrec
and LschetFR.tPerson == PersonsFR.Nrec
and PersonsFR.PASSPRUS == PassportRus.Nrec
));


//===========================
Procedure ReadParam;
{ if not ReadMyDsk(Schet_Korr, 'PECHPLVN_Schet_Korr'     ,false) Schet_Korr:='70' ;
	if not ReadMyDsk(DTRAS_B   , 'PECHPLVN_Schet_DTRAS_B'  ,false) DTRAS_B:=Cur_Date;
  if not ReadMyDsk(DTRAS_E   , 'PECHPLVN_Schet_DTRAS_E'  ,false) DTRAS_E:=Cur_Date;
	if not ReadMyDsk(Nazn_Vipl , 'PECHPLVN_Schet_Nazn_Vipl',false) Nazn_Vipl:='';
  // составитель
  if not ReadMyDsk(Fio_Sos, 'PlVed_Fio_Sos', false)
    Fio_Sos := '';
  if not ReadMyDsk(Dgn_Sos, 'PlVed_Dgn_Sos', false)
    Dgn_Sos := '';

  if not ReadMyDsk(Dgn_ruk   , 'PECHPLVN_Dgn_ruk'  ,false) Dgn_ruk:='';
  if not ReadMyDsk(Dgn_Buh   , 'PECHPLVN_Dgn_Buh'  ,false) Dgn_Buh:='';
  if not ReadMyDsk(Dgn_Exe   , 'PECHPLVN_Dgn_Exe'  ,false) Dgn_Exe:='';
  if not ReadMyDsk(Dov_ruk   , 'PECHPLVN_Dov_ruk'  ,false) Dov_ruk:='';
  if not ReadMyDsk(Dov_Buh   , 'PECHPLVN_Dov_Buh'  ,false) Dov_Buh:='';
  if not ReadMyDsk(Dov_Exe   , 'PECHPLVN_Dov_Exe'  ,false) Dov_Exe:='';
} //Procedure ReadParam;

//=================================
//#1714 просит в поле примечание выводить серию и номер паспорта.
Function GetPrim:string;
{ Result:='';
  if getfirst fastfirstrow LschetFR<>tsok then exit;
  if getfirst fastfirstrow PersonsFR<>tsok then exit;
  if PersonsFR.Fio<>tmpSPPlatVedFR.FIO exit;
  if getfirst fastfirstrow PassportRus<>tsok then exit;
  //#1714.#6
  Result:=PassportRus.Ser+' '+PassportRus.Nmb;
} //Function GetPrim:string;


//*************************************************
datastream dsPlatVed
(
  [strPodr1  ] if(PlatVed.Name='все доступные подразделения','все подразделения',PlatVed.Name);
  // вместо [dsPlatVed."KORSCHET"]
	[Schet_Korr] Schet_Korr;// Корреспондирующий счет - текстовое поле, по умолчанию <70>
  //[dsPlatVed."DATEN"]
  //    DateN := date(Day(SpplVed.DataN),month(SpplVed.DataN),Year(SpplVed.DataN));//НачДень_ДатаВед

  [DTRAS_B   ] DTRAS_B;
  //    DateK := AM_LastDate(AD_month(SpplVed.DataN),AD_Year(SpplVed.LastDate));//КончДень_ДатаВед
  [DTRAS_E   ] DTRAS_E;// Расчетный период - период дат
	[Nazn_Vipl ] Nazn_Vipl;// Назначение выплаты - длинное текстовое поле
  [Fio_Sos]       Fio_Sos;
  [Dgn_Sos]       Dgn_Sos;
  [Dgn_ruk]       Dgn_ruk;
  [Dgn_Buh]       Dgn_Buh;
  [Dgn_Exe]       Dgn_Exe;
  [Dov_ruk]       Dov_ruk;
  [Dov_Buh]       Dov_Buh;
  [Dov_Exe]       Dov_Exe;

  table inherited::tmpSPPlatVedFR
  ( [FIO_IO]          MyGetInitial(tmpSPPlatVedFR.FIO,True);
    [CodePodr3]       SubStr(tmpSPPlatVedFR.PCode,1,3);
    [Prim]            GetPrim;//примечание #1714.#6
  );
)
end;//datastream DTS_NForm9a
//*************************************************

procedure FormData;  //формирование
{ ReadParam;
  inherited :: FormData;
}

//*************************************************
end.
