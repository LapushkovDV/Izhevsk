/*************************************************************************************************\
* Наименование: Формирование (переформирование) платежных ведомостей на выдачу зарплаты                  *
* Контур/Модуль:Заработная плата                                                                  *
* Примечание: Если ведомость формируется без расчета, то Prmonth.tPerson=0                        *
*             и как следствие spplved.tperson=0                                                   *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#000          |22/07/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#component "Z_PAYREP"
#doc
 Формирование (переформирование) платежных ведомостей на выдачу зарплаты
 У некоторых не заполняется spplved.tperson
 update prmonth from Lschet where (( 0 == prmonth.tperson(noindex) and prmonth.clsch /==lschet.nrec )) set prmonth.tperson:=Lschet.tPerson;
 update spplved from Lschet where (( 0 == spplved.tperson(noindex) and spplved.clsch /==lschet.nrec )) set spplved.tperson:=Lschet.tPerson;

#end

Alter Interface ZarplVed;
OverLoad
  procedure InsSpecVed(B: TYPE$SZAROPER);
end;
//------------------------------------------------------------------------------
// формируем спецификацию к ведомости
//------------------------------------------------------------------------------
  procedure InsSpecVed(B: TYPE$SZAROPER);
  { if B.cPerson=0
    { if getfirst LSCHET where ((B.CLSCHET == LSCHET.NREC)) = tsOk
        B.cPerson:=Lschet.tPerson;

    }
    Inherited::InsSpecVed(B);
  } //procedure InsSpecVed(B: TYPE$SZAROPER);
end.
