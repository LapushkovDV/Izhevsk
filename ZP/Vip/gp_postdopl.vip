/*************************************************************************************************\
* Наименование:  Перечень постоянных доплат                                                       *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3818          |09/01/19 |Ермолов К.Р.            |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih

interface gp_postdopl 'Параметры отчета' gray
Show at (,,36,8);

table struct tab1
(
vidopl: integer,
tabnum: string,
fio: string,
post: string,
datuv: date,
datnach: date,
datok: date,
proc: integer,
sum: decimal(31,15),
oklad: decimal(31,15),
kod: string,
podr: string,
otdel_kod: string,
otdel: string
)
with index
(
i1 = tabnum + vidopl
)
;

create view

var
ExcelPath: string;
counter, countermatrix: longint;

as select * from tab1;

handleevent

cmInit:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from tab1;

  sql
  select klvidopl.vidoplp, doplata.strtabn, persons.fio, catalogs.name, lschet.datuv, doplata.datan, doplata.datok,
  doplata.proc, doplata.summa, lschet.tarif, substring(katpodr.kod,1,3), k1.name, katpodr.kod, katpodr.name
  from doplata
  left join lschet on lschet.nrec = doplata.clsch
  left join katpodr on katpodr.nrec = lschet.cex
  left join persons on persons.nrec = lschet.tperson
  left join catalogs on catalogs.nrec = lschet.cappoint
  left join katpodr k1 on k1.nrec = katpodr.cpodr
  left join klvidopl on klvidopl.vidopl = doplata.vidopl
  where doplata.pometka <> '-'
  into tab1
  ;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath + 'XLS_ЭМ\ZP\gp_postdopl.xlsx', true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  counter:= 3;
  countermatrix:= 0;

  xlCreateMatrix(500, 14);

  _loop tab1
  {
    countermatrix++;
    xlDoWriteToMatrix(countermatrix, 1, tab1.vidopl);
    xlStWriteToMatrix(countermatrix, 2, tab1.tabnum);
    xlStWriteToMatrix(countermatrix, 3, tab1.fio);
    xlStWriteToMatrix(countermatrix, 4, tab1.post);
    xlDtWriteToMatrix(countermatrix, 5, tab1.datuv);
    xlDtWriteToMatrix(countermatrix, 6, tab1.datnach);
    xlDtWriteToMatrix(countermatrix, 7, tab1.datok);
    xlDoWriteToMatrix(countermatrix, 8, tab1.proc);
    xlDoWriteToMatrix(countermatrix, 9, tab1.sum);
    xlDoWriteToMatrix(countermatrix, 10, tab1.oklad);
    xlStWriteToMatrix(countermatrix, 11, tab1.kod);
    xlStWriteToMatrix(countermatrix, 12, tab1.podr);
    xlStWriteToMatrix(countermatrix, 13, tab1.otdel_kod);
    xlStWriteToMatrix(countermatrix, 14, tab1.otdel);

    if countermatrix = 500
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  xlFreeMatrix;

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter - 1, 14);

  StopVisual('',0);
  xlkillExcel;

}

end;
end.

VipInterface UserReport_postdopl Implements IUserReport;
Interface UserReport_postdopl;

Procedure Run;
Begin
  runinterface(gp_postdopl);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Перечень постоянных доплат';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
