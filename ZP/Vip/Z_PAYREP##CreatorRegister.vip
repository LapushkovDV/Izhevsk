#include CreatorPlatDocs.vih
#component "Z_PAYREP"
Alter Interface CreatorRegister
OverLoad
   function ICleanerPlatDocs.Del(Tbl: word; Ref: comp): longint;
end;
function  ICleanerPlatDocs.Del(Tbl: word; Ref: comp): longint;
{ Result:=Inherited::Del(Tbl,Ref);
  if Result=tsok
  { DeleteAllAttr(Tbl,Ref);
    DeleteAllClassVal(Tbl,Ref);
  }
}

end.
