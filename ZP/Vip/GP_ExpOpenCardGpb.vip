  sR[ 6] := 'Е';  sL[ 6] :=  'E';
  sR[ 7] := 'Ё';  sL[ 7] :=  'E';
  sR[ 8] := 'Ж';  sL[ 8] :=  'ZH';
  sR[ 9] := 'З';  sL[ 9] :=  'Z';
  sR[10] := 'И';  sL[10] :=  'I';
  sR[11] := 'Й';  sL[11] :=  'I';
  sR[12] := 'К';  sL[12] :=  'K';
