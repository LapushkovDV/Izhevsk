}

function sOutGPB(_sAny: string): string;
{
  _sAny := UpCase(_sAny);
  result:= Replace(_sAny, 'Ё', 'Е');
}

function sRus2Lat(sAny : string) : string;
Var
  wI: word;
{
  if sAny <> ''
    for(wI:=1; wI<=33; wI++) sAny:=Replace(sAny,sR[wI],sL[wI]);
  result:=sAny;
}
