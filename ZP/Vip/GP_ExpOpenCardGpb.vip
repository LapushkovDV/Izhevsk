#define GPInt GP_ExpOpenCardGpb // #(GPInt)
#define GPNam Выгрузка данных для Газпромбанка // #(GPNam)

Interface #(GPInt) '#(GPNam) (ЭМ)' EscClose, Gray;
  show (,,86,9);

const
#include Excel.inc;
end;

table struct ttPerFlt // для фильтра по персоналу
(
  cRecPers : comp
)
with index
(
  ttPerFlt01  = cRecPers
);

table struct ttResStr // статический набор данных
(
  nRec      : comp
, cRecPers  : comp
, sFIO      : string
, sF        : string
, sI        : string
, sO        : string
, sPol      : string
, sCountry  : string
, sIdx      : string
, sRegion   : string
, sRajon    : string
, sGorod    : string
, sNasPunkt : string
, sUlitsa   : string
, sDom      : string
, sKorpus   : string
, sKvartira : string
, sTypPass  : string
, sSerPass  : string
, sNomPass  : string
, sPodrPass : string
, sKtoPass  : string
// , dKtoPass  : date
// , dBorn     : date
, dKtoPass  : string // дату банк просит
, dBorn     : string //  текстом
, sBorn     : string
, sGrazhd   : string
, sTelDom   : string
, sTelMob    : string
, sTelRab   : string
, sILat     : string
, sFLat     : string
, sEMail    : string
, sINN      : string
, sSNILS    : string
)
with index
(
  ttResStr00 = nRec(Surrogate)
, ttResStr01 = cRecPers
, ttResStr02 = sFIO
);

var
  VCommonFiltr  : CommonFiltr; // Для встраивания фильтра по подразделениям / сотрудникам
  MadeReport    : boolean;
  mPsn          : TPtr;
  iCatFunc      : CatalogsFunctions;
  iAdrFunc      : AddressFunc;
  iStrFunc      : StringFunctions;
  iOut          : GP_XlOutExt;
  sFullName     : string;
  sDefaultPhone : string;
  lRB, lRE,
  lCB, lCE,
  lDB, lDE,
  iNPP          : integer = 0;
  sR, sL        : array[1..33] of string[4];
  sShKl         : array [1..67] of string;
  sShKlGPB      : array [1..67] of string;

create view
from
  Persons
, Passports
, Passports PassINN
, Passports PassSNILS
, Communications
, ttPerFlt
, ttResStr
, STerr
where
((
    ttPerFlt.cRecPers == Persons.nRec
and Persons.PasspRus  == Passports.nRec
and Persons.nRec      == Communications.Person
and Persons.nrec == PassINN.person 
and 505          == PassINN.syscode
and Persons.nrec == PassSNILS.person 
and 501          == PassSNILS.syscode
))
;

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

