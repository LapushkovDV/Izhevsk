  sR[22] := 'Ф';  sL[22] :=  'F';
  sR[23] := 'Х';  sL[23] :=  'KH';
  sR[24] := 'Ц';  sL[24] :=  'TS';
  sR[25] := 'Ч';  sL[25] :=  'CH';
  sR[26] := 'Ш';  sL[26] :=  'SH';
