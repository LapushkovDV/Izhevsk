function RetSTerr(_sAny : string; _wMode: word): string; cacheable;
Var
  wI   : word;
  wPos : word;
  wLen : word;
  sLObj
 ,sSObj
 ,sSGPB: string = '';
{
  result := '';
  if _sAny <> ''
    for(wI:=1; wI<=67; wI++)
    {
      wLen := Length(sShKl[wI]);
      //сначала проверяем в конце
      wPos := Pos(' '+sShKl[wI],_sAny);
      if wPos <> 0
      {
        sLObj := SubStr(_sAny,1,wPos-1);
        sSObj := sShKl[wI];//SubStr(sAny,wPos+1,wLen);
        sSGPB := if(sShKlGPB[wI]<>'', sShKlGPB[wI], sSObj);
      }
      //На всякий случай проверяем в начале
      wPos := Pos(sShKl[wI]+' ',_sAny);
      if wPos = 1
      {
        sLObj := SubStr(_sAny,wLen+2,Length(_sAny)-(wLen+1));
        sSObj := sShKl[wI];//SubStr(sAny,1,wLen);
        sSGPB := if(sShKlGPB[wI]<>'', sShKlGPB[wI], sSObj);
      }
    }
  case _wMode of
  0: result := sLObj;
  1: result := sSObj+'.'+sLObj;
  2: result := sSGPB+'.'+sLObj;
  end;
  if ( result = '.' ) result := '';
}

function sRetCountry(_cAny: comp): string;
{
  result := '';
  if ( _cAny = comp(0) ) exit;
  do
  {
    if ( getfirst STerr where((_cAny == STerr.nRec)) = tsOk )
    {
      if ( length(STerr.SGNI_Code) = 3 ) 
      {
        result := STerr.SName;
        exit;
      }
      else
        _cAny := STerr.cParent;
    }
    else exit;
  } while true;
}
procedure Run;
var kol, i    : integer = 0;
    cPersNRec : comp;
    cAddrNeed : comp;
{
  sDefaultPhone := '7 (000) 0000000';
  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);
  InitRus2Lat;
  InitShortKLAdr;
  if (VCommonFiltr.GetPsnCount = 0)
    VCommonFiltr.SelectAllPsn;

  mPsn := InitMarker('#(GPInt)_PSN_'+UserName(),8,200,100);
  mPsn := VCommonFiltr.GetPersonsMarker;
  kol  := GetMarkerCount(mPsn);
  RestartVisual('Формирование таблицы фильтров.',1);
  while i < kol
  {
    GetMarker(mPsn, i++, cPersNRec);
    insert ttPerFlt set ttPerFlt.cRecPers := cPersNRec;
    If (not NextVisual) break;
  }
  
  RestartVisual('Формирование данных для выгрузки.',1);
  if IsValid(#ttPerFlt)
  _loop ttPerFlt
  {
    if (not NextVisual) break;  
    if IsValid(#Persons)
    {
      ClearBuffer(#ttResStr);
      cAddrNeed         := iAdrFunc.GetAddressToDate(Persons.nRec,4,Cur_Date);
      ttResStr.cRecPers := Persons.nRec;
      ttResStr.sFIO     := Persons.FIO ;
      ttResStr.sPol     := Persons.Sex ;
      ttResStr.sF       := UpCase(iStrFunc.Get_LastName (Persons.FIO));
      ttResStr.sI       := UpCase(iStrFunc.Get_FirstName(Persons.FIO));
      ttResStr.sO       := UpCase(iStrFunc.GetPatronymic(Persons.FIO));
      ttResStr.sCountry := sRetCountry(iAdrFunc.GetATDNRec(cAddrNeed));// iAdrFunc.GetNameATD   (cAddrNeed, 1);
      if ( UpCase(ttResStr.sCountry) = 'РОССИЯ' ) ttResStr.sCountry := 'Российская Федерация';
      ttResStr.sIdx     := iAdrFunc.GetAddressInd(cAddrNeed);
      ttResStr.sUlitsa  := RetSTerr(iAdrFunc.GetStreetName(cAddrNeed), 0);
      if ( Trim(ttResStr.sUlitsa) <> '' ) ttResStr.sUlitsa := 'УЛ.'+ttResStr.sUlitsa;
      ttResStr.sDom     := iAdrFunc.GetHouse     (cAddrNeed); //message(ttResStr.sDom);
      if ( trim(ttResStr.sDom) <> '') ttResStr.sDom := 'Д.'+ ttResStr.sDom;
      ttResStr.sKorpus  := iAdrFunc.GetCorpus    (cAddrNeed);
      if ( trim(ttResStr.sKorpus) <> '') ttResStr.sKorpus := 'СТР.'+ ttResStr.sKorpus;
      ttResStr.sKvartira:= iAdrFunc.GetFlat      (cAddrNeed);
      if ( trim(ttResStr.sKvartira) <> '') ttResStr.sKvartira := 'КВ.'+ ttResStr.sKvartira;
      cAddrNeed         := iAdrFunc.GetATDNRec   (cAddrNeed);
      ttResStr.sRegion  := iAdrFunc.GetNameATD   (cAddrNeed,20);// RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed,20), 1);
      ttResStr.sRajon   := iAdrFunc.GetNameATD   (cAddrNeed, 3);
      ttResStr.sGorod   := RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed, 4), 0);
       if ( Trim(ttResStr.sGorod) <> '' ) ttResStr.sGorod := 'ГОР.'+ttResStr.sGorod;
//       if ( Trim(ttResStr.sGorod) <> '' ) ttResStr.sGorod := ttResStr.sGorod;
      if ( UpCase(ttResStr.sRegion) = 'МОСКВА Г'  and trim(ttResStr.sGorod) = '' )
      {
         ttResStr.sGorod := 'ГОР.'+RetSTerr(ttResStr.sRegion, 0);
//         ttResStr.sGorod := RetSTerr(ttResStr.sRegion, 0);
        ttResStr.sRegion:= RetSTerr(ttResStr.sRegion, 0);
      }
      ttResStr.sNasPunkt:= RetSTerr(iAdrFunc.GetNameATD   (cAddrNeed, 5), 0);
//       if ( Trim(ttResStr.sNasPunkt) <> '' ) ttResStr.sNasPunkt := 'ГОР.'+ttResStr.sNasPunkt;
      if ( Trim(ttResStr.sNasPunkt) <> '' ) ttResStr.sNasPunkt := ttResStr.sNasPunkt;
      ttResStr.dBorn    := DateToStr(Persons.BornDate, 'DD/MM/YYYY');
      ttResStr.sBorn    := iAdrFunc.GetFullAddressInd(Persons.BornAddr);
      ttResStr.sGrazhd  := iCatFunc.GetCatalogsName(Persons.Gr);
      if ( UpCase(ttResStr.sGrazhd) = 'РОССИЯ' ) ttResStr.sGrazhd := 'РФ';
      ttResStr.sTelMob  := sRepPhoneList('моб');
      ttResStr.sTelDom  := sRepPhoneList('дом');
      ttResStr.sTelRab  := sRepPhoneList('раб');
      ttResStr.sILat    := sRus2Lat(ttResStr.sI);
      ttResStr.sFLat    := sRus2Lat(ttResStr.sF);
      if IsValid(#Passports)
      {
        ttResStr.sTypPass := iCatFunc.GetCatalogsName(Passports.DocName);// ПАСПОРТ ГРАЖДАНИНА РОССИИ
        ttResStr.sSerPass := Replace(Passports.Ser, ' ', '');
        ttResStr.sNomPass := Passports.Nmb;
        if ( UpCase(ttResStr.sTypPass) = 'ПАСПОРТ ГРАЖДАНИНА РОССИИ' )
        {
          ttResStr.sTypPass := 'ПАСПОРТ ГРАЖДАНИНА РФ';
          ttResStr.sSerPass := Replace(ttResStr.sSerPass, ' ', '');
        }
        ttResStr.sPodrPass:= Passports.GivenPodr;
        ttResStr.sKtoPass := Passports.GivenBy;//+' '+Passports.GivenPodr;
        ttResStr.dKtoPass := DateToStr(Passports.GivenDate, 'DD/MM/YYYY');
      }
      if IsValid(#PassINN)
        ttResStr.sINN   := PassINN.NMB;
      if IsValid(#PassSNILS)
        ttResStr.sSNILS := PassSNILS.NMB;
      ttResStr.sEMail   := sRetEMailList('электронная почта');
      insert current ttResStr;
    }
  }
  if isvalid(#ttResStr)
  {
    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xlsb';
//    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xls';
    xlCreateExcel(sFullName, TRUE);
    lRB  := 1;
    lDB  := lRB + 1;
    lCB  := 1;
    lCE  := 1;
    iNPP := 1;
    RestartVisual('Выгрузка данных.',1);
    
    #define FrmHd  lRB,  lCE,  lRB,  lCE
    iOut.Header1Row('Номер п/п',#FrmHd); lCE++;
    iOut.Header1Row('Код организации',#FrmHd); lCE++;
    iOut.Header1Row('Фамилия',#FrmHd); lCE++;
    iOut.Header1Row('Имя',#FrmHd); lCE++;
    iOut.Header1Row('Отчество',#FrmHd); lCE++;
    iOut.Header1Row('Пол',#FrmHd); lCE++;
    iOut.Header1Row('Страна',#FrmHd); lCE++;
    iOut.Header1Row('Индекс',#FrmHd); lCE++;
    iOut.Header1Row('Регион',#FrmHd); lCE++;
    iOut.Header1Row('Район',#FrmHd); lCE++;
    iOut.Header1Row('Город',#FrmHd); lCE++;
    iOut.Header1Row('Населенный пункт',#FrmHd); lCE++;
    iOut.Header1Row('Улица',#FrmHd); lCE++;
    iOut.Header1Row('Дом',#FrmHd); lCE++;
    iOut.Header1Row('Корпус',#FrmHd); lCE++;
    iOut.Header1Row('Квартира',#FrmHd); lCE++;
    iOut.Header1Row('Тип паспорта',#FrmHd); lCE++;
    iOut.Header1Row('Серия паспорта',#FrmHd); lCE++;
    iOut.Header1Row('Номер паспорта',#FrmHd); lCE++;
    iOut.Header1Row('Код подразделения',#FrmHd); lCE++;
    iOut.Header1Row('Когда выдан',#FrmHd); lCE++;
    iOut.Header1Row('Кем выдан',#FrmHd); lCE++;
    iOut.Header1Row('Дата рождения',#FrmHd); lCE++;
    iOut.Header1Row('Место рождения',#FrmHd); lCE++;
    iOut.Header1Row('Гражданство',#FrmHd); lCE++;
    iOut.Header1Row('Телефон домашний',#FrmHd); lCE++;
    iOut.Header1Row('Телефон служебный',#FrmHd); lCE++;
    iOut.Header1Row('Телефон мобильный',#FrmHd); lCE++;
    iOut.Header1Row('Адрес электронной почты',#FrmHd); lCE++;
    iOut.Header1Row('Контрольная информация',#FrmHd); lCE++;
    iOut.Header1Row('Имя в латинской транскрипции',#FrmHd); lCE++;
    iOut.Header1Row('Фамилия в латинской транскрипции',#FrmHd);  lCE++;
    iOut.Header1Row('ИНН',#FrmHd);  lCE++;
    iOut.Header1Row('СНИЛС',#FrmHd);//  lCE++;

    _loop ttResStr iNPP++; 
    if (not xlCreateMatrix(iNPP+1,lCE))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
//     xlSetNumberFormat('@',lRB, 1,iNPP+1,   19);
//     xlSetNumberFormat('dd/mm/yyyy',lRB,20,iNPP+1,   20);
//     xlSetNumberFormat('@',lRB,21,iNPP+1,   21);
//     xlSetNumberFormat('dd/mm/yyyy',lRB,22,iNPP+1,   22);
//     xlSetNumberFormat('@',lRB,23,iNPP+1,--lCE);
    xlSetNumberFormat('@',lRB, 1,iNPP+1, lCE);

    iNPP:=1;
    lDE :=1;

    #define FrmCl lDE,lCE++
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;
      lCE := 1;
      xlStWriteToMatrix(#FrmCl,iNPP++);                     //  iOut.Header1Row('Номер',#FrmHd); lCE++;                           
      xlStWriteToMatrix(#FrmCl,'1337');                     //  iOut.Header1Row('Код организации',#FrmHd); lCE++;                 
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sF        ));//  iOut.Header1Row('Фамилия',#FrmHd); lCE++;                         
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sI        ));//  iOut.Header1Row('Имя',#FrmHd); lCE++;                             
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sO        ));//  iOut.Header1Row('Отчество',#FrmHd); lCE++;                        
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sPol      ));//  iOut.Header1Row('Пол',#FrmHd); lCE++;                             
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sCountry  ));//  iOut.Header1Row('Страна',#FrmHd); lCE++;                          
      xlStWriteToMatrix(#FrmCl,UpCase(ttResStr.sIdx      ));//  iOut.Header1Row('Индекс',#FrmHd); lCE++;                          
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sRegion   ));//  iOut.Header1Row('Регион',#FrmHd); lCE++;                          
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sRajon    ));//  iOut.Header1Row('Район',#FrmHd); lCE++;                           
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sGorod    ));//  iOut.Header1Row('Город',#FrmHd); lCE++;                           
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sNasPunkt ));//  iOut.Header1Row('Населенный пункт',#FrmHd); lCE++;                
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sUlitsa   ));//  iOut.Header1Row('Улица',#FrmHd); lCE++;                           
      xlStWriteToMatrix(#FrmCl,UpCase(ttResStr.sDom      ));//  iOut.Header1Row('Дом',#FrmHd); lCE++;                             
      xlStWriteToMatrix(#FrmCl,UpCase(ttResStr.sKorpus   ));//  iOut.Header1Row('Корпус',#FrmHd); lCE++;                          
      xlStWriteToMatrix(#FrmCl,UpCase(ttResStr.sKvartira ));//  iOut.Header1Row('Квартира',#FrmHd); lCE++;                        
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sTypPass  ));//  iOut.Header1Row('Тип паспорта',#FrmHd); lCE++;                    
      xlStWriteToMatrix(#FrmCl,UpCase(ttResStr.sSerPass  ));//  iOut.Header1Row('Серия паспорта',#FrmHd); lCE++;                  
      xlStWriteToMatrix(#FrmCl,UpCase(ttResStr.sNomPass  ));//  iOut.Header1Row('Номер',#FrmHd); lCE++;                           
//       xlDtWriteToMatrix(#FrmCl,        ttResStr.dKtoPass   );//  iOut.Header1Row('Когда выдан',#FrmHd); lCE++;                     
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sPodrPass ));//  iOut.Header1Row('Кем выдан',#FrmHd); lCE++;                       
      xlStWriteToMatrix(#FrmCl,        ttResStr.dKtoPass   );//  iOut.Header1Row('Когда выдан',#FrmHd); lCE++;                     
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sKtoPass  ));//  iOut.Header1Row('Кем выдан',#FrmHd); lCE++;                       
      xlStWriteToMatrix(#FrmCl,        ttResStr.dBorn      );//  iOut.Header1Row('Дата рождения',#FrmHd); lCE++;                   
//       xlDtWriteToMatrix(#FrmCl,        ttResStr.dBorn      );//  iOut.Header1Row('Дата рождения',#FrmHd); lCE++;                   
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sBorn     ));//  iOut.Header1Row('Место рождения',#FrmHd); lCE++;                  
      xlStWriteToMatrix(#FrmCl,sOutGPB(ttResStr.sGrazhd   ));//  iOut.Header1Row('Гражданство',#FrmHd); lCE++;                     
      xlStWriteToMatrix(#FrmCl,UpCase(ttResStr.sTelDom   ));//  iOut.Header1Row('Телефон домашний',#FrmHd); lCE++;                
      xlStWriteToMatrix(#FrmCl,'8-495-2869206');// UpCase(ttResStr.sTelRab   ) // iOut.Header1Row('Телефон служебный',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sTelMob    );//  iOut.Header1Row('Мобильный телефон',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sEMail    );//  iOut.Header1Row('ttResStr.sEMail',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,'');                         //  iOut.Header1Row('Контрольная информация',#FrmHd); lCE++;

      xlStWriteToMatrix(#FrmCl,'');                         //  iOut.Header1Row('Контрольная информация',#FrmHd); lCE++;          
      xlStWriteToMatrix(#FrmCl,UpCase(ttResStr.sILat     ));//  iOut.Header1Row('Имя в латинской транскрипции',#FrmHd); lCE++;    
      xlStWriteToMatrix(#FrmCl,UpCase(ttResStr.sFLat     ));//  iOut.Header1Row('Фамилия в латинской транскрипции',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl, ttResStr.sINN);
      xlStWriteToMatrix(#FrmCl, ttResStr.sSNILS);
      lDE++;
    }
    xlStWriteToMatrix(lDE,1,'ИТОГО ДЕРЖАТЕЛЕЙ:'+(--iNPP));
    RestartVisual('Вставка данных в Excel.',1);
    if (not xlWriteMatrixToExcel(2,1))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;
    xlAutoFit(lRB,lCB,lDE,lCE);
    xlSetSheetName(1, 'РЕЕСТР');

    xlKillExcel;
  }
  else
  {
    message('Нет данных для формирования отчета!');
  }
  StopVisual;
}

embedded ComFiltrEmbedded 'Фильтры' interface VCommonFiltr;
  show (,,85,6);
end
Screen s2(,,sci1Esc);
  show (,7,85,8);
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
  <<
     <. ~С~формировать .>                         <. ~З~акрыть .>
  >>
end;

handleevent
  cmInit:
  {
    delete all from ttPerFlt;
    delete all from ttResStr;
    MadeReport:= false;
  }
  cmOk:
  {
    Run;
    MadeReport:= true;
    VCommonFiltr.IntClose(MadeReport);
    VCommonFiltr.StoreAllParams;
    Notify(cmEvaluateAndModify, 0);
    DoneMarker(mPsn, '#(GPInt)_PSN_' + UserName());
    closeinterface(cmDefault);
  }
  cmCancel:
  {
    VCommonFiltr.IntClose(MadeReport);
    DoneMarker(mPsn, '#(GPInt)_PSN_' + UserName());
  }
end;
end.



VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;
Procedure Run;                                  {runinterface(#(GPInt));}
Function  GetReportName               : String; {GetReportName := '#(GPNam) (ЭМ)';}
Function  GetGroupName (Level : Word) : String; {Level:=Level;GetGroupName := '';}
function  GetPriority                 : Integer;{GetPriority := 3;}
function  VisibleInModule(Ind : Byte) : String; {Ind:=Ind; VisibleInModule := 'STAFFMAINMENU';} // для Пушковой Перенесено из MENUZARP';}
End.
