// Галактика 9.10 - модуль "Заработная плата"
// Интерфейс параметров формирования РСВ с 2017 года
//------------------------------------------------------------------------------
#include ZRep_Common.vih
#include ZRep_CommonFunc.vih
#include RepConst.vih
#include RSV_1.Vih
#include RSV2017.vih
#component "Z_Report"

#doc
  НАСТРОЙКА ПАРАМЕТРОВ ФОРМИРОВАНИЯ РСВ (с 2017 года) (РФ)
#end

Alter Interface RSV2017_Param ;
  show at (,,86,30);
Overload
  procedure pFormDocum_RSV2017;
end;

//create view vRSV2017_Param
//***********************************************************************
// RSV2017_Param->pFormDocum_RSV2017:=== LschetD.StrTabn=000496
// RSV2017_Param->pFormDocum_RSV2017:RSV1_F.pAddSumLs(LschetD.nRec, rSumLS, rSumLSNeg)
// Internal error 1 (Не удалось выделить динамическую память)
// in MS70DRV.DLL at 00041E62

procedure pFormDocum_RSV2017;
var
  wMonth
 ,wMonthKv
 ,wCurTar
 ,wPrOPS_
 ,wPrFOMS_
 ,wPrFSS_
 ,wJobLs
 ,wJobLsYear
 ,wJobLsKv  : word;

  doSumR6
 ,doSumPers
 ,doTmp
 ,doSumContr: double;

  boMonthKv : boolean;

  doSummaV  : array [1..3] of double;  //ИТОГО сумма выплат  в Разделе 3 по каждому месяцу квартала
  doSummaB  : array [1..3] of double;  //ИТОГО база          в Разделе 3 по каждому месяцу квартала
  doSummaBD : array [1..3] of double;  //ИТОГО база по дог.  в Разделе 3 по каждому месяцу квартала
  doSummaVzn: array [1..3] of double;  //ИТОГО сумма взносов в Разделе 3 по каждому месяцу квартала

  doSummaV_Foms  : array [1..3] of double;  //ИТОГО сумма выплат  в Разделе 3 по каждому месяцу квартала
  doSummaB_Foms  : array [1..3] of double;  //ИТОГО база          в Разделе 3 по каждому месяцу квартала
  doSummaVzn_Foms: array [1..3] of double;  //ИТОГО сумма взносов в Разделе 3 по каждому месяцу квартала

  doSummaV_SP1  : array [1..3] of double;  //ИТОГО сумма выплат  в Разделе 3 по каждому месяцу квартала
  doSummaB_SP1  : array [1..3] of double;  //ИТОГО база          в Разделе 3 по каждому месяцу квартала
  doSummaVzn_SP1: array [1..3] of double;  //ИТОГО сумма взносов в Разделе 3 по каждому месяцу квартала

  doSummaV_SP2  : array [1..3] of double;  //ИТОГО сумма выплат  в Разделе 3 по каждому месяцу квартала
  doSummaB_SP2  : array [1..3] of double;  //ИТОГО база          в Разделе 3 по каждому месяцу квартала
  doSummaVzn_SP2: array [1..3] of double;  //ИТОГО сумма взносов в Разделе 3 по каждому месяцу квартала

  doSumVznLs: array [1..3] of double;  //ИТОГО сумма взносов в Разделе 3 по сотруднику
  doSummaVznRep: array [1..12] of double;  //ИТОГО сумма взносов в Разделе 3 по каждому месяцу года
{
  Timelog_Init;
  Timelog('RSV2017_Param->pFormDocum_RSV2017:Start');
  delete all tp_SumTar;

  CurDesGr := sGetTune('User.DesGr');
  CurDescr := sGetTune('User.Descr');
  StoreMarker(MarkerVidOplDog, 'mVidoplDog_RSV_1');
  m_WorkKindList   := o_WorkKindManager.GetList;  // Получаем ссылку на маркер с выбранными видами работ
  SaveMyDsk(m_WorkKindList, 'm_WorkKindList_RSV2017');
  m_WorkKindList_For   := o_WorkKindManager_For.GetList;  // Получаем ссылку на маркер с выбранными видами работ
  SaveMyDsk(m_WorkKindList_For, 'm_WorkKindList_For_RSV2017');

  boWorkList_For := false;
  if ( GetMarkerCount (m_WorkKindList_For) > 0 )  // если не пуст..
    boWorkList_For := true;

  //создание документа РСВ
  ClearBuffer(#ZRepDocum);
  ZRepDocum.NumDocum   := cgReport_RSV_2017;
  ZRepDocum.Year       := YearRep;
  ZRepDocum.wPeriod    := wRepPeriod;
  ZRepDocum.NmDocum    := sNmDocum_RSV + ' ('+CurDescr+' '+DateToStr(Cur_Date, 'DD.MM.YYYY') +')';
  ZRepDocum.DesGr      := CurDesGr;
  ZRepDocum.Descr      := CurDescr;
  ZRepDocum.wTune[1]   := wMonthBeg;
  ZRepDocum.wTune[2]   := wRazdRsv;
  ZRepDocum.wTune[3]   := wTarifCode;
  ZRepDocum.wTune[6]   := wRasshifr;
  ZRepDocum.wTune[5]   := wRasshifrR3;
  // формирование расшифровки приложений 2,3,4
  if ((wRasshifr or coRasshifr) <> 0)
    ZRepDocum.sPath2   := sRasshPath;

  ZRepDocum.sPath3     := to_char(cPATRec, 0, 0);
  ZRepDocum.Status     := cnStatus_Oform;
  ZRepDocum.cKatNotes  := oNotes.GetFirstNote(cgDoc_0796, ZRepDocum.Status);
  ZRepDocum.dtDocum[1] := Cur_Date;

  ZRepDocum.NumCorr    := wNumCor;
  ZRepDocum.TypeDoc    := if ( wNumCor = 0, 0, 1 );

//  if ( wNumCor <> 0 )
  //  ZRepDocum.cLinkDoc := cRecDocLink;
  ZRepDocum.cDocPred   := cRecPredDoc;

  insert current ZRepDocum;
  oStatlog.StatLog_Insert(cgDoc_0796, ZRepDocum.nRec, 'Создание нового отчета - РСВ-1');

  cRecDocum_ := ZRepDocum.nRec;

  if ( not RSV1_F.fboInitParam(ZRepDocum.nRec, cnMainRazd6, 0, 0) ) {}
  wMonthEnd := RSV1_F.fwGetMonthEndPerRsv;

  //Титульный лист
  pFillTitleInformation;

  //Раздел 1
  //приложение 5
  ClearBuffer(#ZRepDetail);
  ZRepDetail.cRecDocum := ZRepDocum.nRec;
  ZRepDetail.NumRazd   := cnRazd_1;
  ZRepDetail.NumPage   := cnRazd1_Attachment5;
  ZRepDetail.PriznPage := cnTabb_1;
  insert current ZRepDetail;

  //приложение 6
  ClearBuffer(#ZRepDetail);
  ZRepDetail.cRecDocum := ZRepDocum.nRec;
  ZRepDetail.NumRazd   := cnRazd_1;
  ZRepDetail.NumPage   := cnRazd1_Attachment6;
  ZRepDetail.PriznPage := cnTabb_1;
  insert current ZRepDetail;

  iPageNumber++;
  iAttachmentNumber++;
  //приложение 7
  ClearBuffer(#ZRepDetail);
  ZRepDetail.cRecDocum := ZRepDocum.nRec;
  ZRepDetail.NumRazd   := cnRazd_1;
  ZRepDetail.NumPage   := cnRazd1_Attachment7;
  ZRepDetail.PriznPage := cnTabb_1;
  insert current ZRepDetail;
  iPageNumber++;
  iAttachmentNumber++;
  //РАЗДЕЛ 2
  RSV2017_F.fCreateRecRazd(ZRepDocum.nRec, cnRazd_2, cnRazd2_Attachment, 0);
  iPageNumber += 2;
  iAttachmentNumber++;
  //Заполнение Раздела 3 новой формы РСВ-1
  delete all tp_Formarks;
  delete Formarks where (( cReportFss == Formarks.Choice ));

  StartNewVisual(vtNumericVisual, vfTimer + vfBreak, 'Подготовка данных для РСВ....', 1);
  _loop Formarks novisual
    NextVisual;
  RecordCount := VisualCount;
  StopVisual('', 0);

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak,
                 'Подготовка данных для РСВ...'#13, RecordCount);
  _try
  {
    _loop fullCACHE Formarks
    {
      NextVisual;
      if ( GetFirst LschetD <> tsOk ) continue;

      //исключаем лицевые счета - не физ лица
      if ( LschetD.CHAR4 = '-' ) continue;

      var i_For: longint = 0;
      if ( boWorkList_For and SearchMarker(m_WorkKindList_For, LschetD.sovm, i_For) )
        continue;

      //102.184964
      //LSCHETD.CHAR13 <> '+' за весь период работы
      //LSCHET.CHAR14  = '+', переведен в другой филиал
      var wPrDop_: word = 0;
      if ( LschetD.datUv <> ZeroDate and year(LschetD.datUv) = YearRep and ( LSCHETD.CHAR13 <> '+' ) and ( LSCHETD.CHAR14 = '+' ) )
        wPrDop_ := 1;

      // загрузка пометок ForMarks для объекта 4-фсс
      pInsFormarks4Fss(wPrDop_);

      if ( APAI.First(LschetD.nRec) )
      {
        do
        {
          if ( getfirst LSchetD where (( APAI.GetAdjacent == LSchetD.NREC )) = tsOk )
            pInsFormarks4Fss(0);

        } while APAI.Next;
      } // if
    }//_loop fullCACHE Formarks
  }//_try
  _except
    on ExUserBreak:
    {
    };
  _finally
  {
    StopVisual('', 0);
  }

  pSetParametr4Fss;

  pFillRazdel1;
  pFillR1Attachment14;
  pFillR1Attachment2;
  pAddSumPredDocFSS;
  pFillR1Attachment3;
  pFillR1Attachment4;

  // Для приложения 8, 10
  iPageNumber += 3;
  iAttachmentNumber += 3;

  var lCountP : longInt = 0;
  _loop ForeignInf
  {
    ClearBuffer(#ZRepDetail);
    ZRepDetail.cRecDocum := ZRepDocum.nRec;
    ZRepDetail.NumRazd   := cnRazd_1;
    ZRepDetail.NumPage   := cnRazd1_Attachment9;
    ZRepDetail.PriznPage := cnTabb_1;
    ZRepDetail.fio       := ForeignInf.SurName;
    ZRepDetail.snmDoc1   := ForeignInf.NamePers;
    ZRepDetail.snmDoc2   := ForeignInf.Patronymic;
    ZRepDetail.sNumDocum := ForeignInf.INN;
    ZRepDetail.sNmDop    := ForeignInf.SNILS;
    ZRepDetail.sNmDop2   := ForeignInf.GrajCode;
    ZRepDetail.SummaV[4] := ForeignInf.SummaAll;
    ZRepDetail.SummaV[1] := ForeignInf.Summa1;
    ZRepDetail.SummaV[2] := ForeignInf.Summa2;
    ZRepDetail.SummaV[3] := ForeignInf.Summa3;
    Insert current ZRepDetail;
    lCountP++;
  }

  iPageNumber += integer(round(lCountP/2));
  iAttachmentNumber += integer(round(lCountP/2));

  Card_F.pDoneParam;
  //Пока формирование раздела 3 вынесено отдельно!!!
  if ( ZRepDocum.wTune[3] > 0 )
    wMainTar   := ZRepDocum.wTune[3];
  else
    wMainTar := RSV1_F.fwGetMainTar;
  ResetBounds(#tp_SumCodeTar);
  delete all tp_SumCodeTar;
  SetBounds(#tp_SumCodeTar);
  ResetBounds(#tp_SumDopTar);
  delete all tp_SumDopTar;
  SetBounds(#tp_SumDopTar);
  for ( wMonth := 1; wMonth <= 3; inc(wMonth) )
  {
    doSummaV[wMonth]   := 0;
    doSummaB[wMonth]   := 0;
    doSummaBD[wMonth]  := 0;
    doSummaVzn[wMonth] := 0;
    doSumVznLs[wMonth] := 0;

    doSummaV_Foms[wMonth]   := 0;
    doSummaB_Foms[wMonth]   := 0;
    doSummaVzn_Foms[wMonth] := 0;

    doSummaV_SP1[wMonth]    := 0;
    doSummaB_SP1[wMonth]    := 0;
    doSummaVzn_SP1[wMonth]  := 0;

    doSummaV_SP2[wMonth]    := 0;
    doSummaB_SP2[wMonth]    := 0;
    doSummaVzn_SP2[wMonth]  := 0;
  }

  for ( wMonth := 1; wMonth <= 12; inc(wMonth) )
    doSummaVznRep[wMonth] := 0;

  boWorkListLoaded := false;
  if ( GetMarkerCount (m_WorkKindList) > 0 )  // если не пуст..
      boWorkListLoaded := true;

  delete all tp_CntFl;
  StartNewVisual(vtNumericVisual, vfTimer + vfBreak, 'Подсчет количества записей для Раздела 3...', 1);
  _loop Formarks novisual
    NextVisual;
  RecordCount := VisualCount;
  StopVisual('', 0);
  Timelog('RSV2017_Param->pFormDocum_RSV2017:Подготовка данных для заполнения Раздела 3 формы РСВ ');
  Timelog('RSV2017_Param->pFormDocum_RSV2017:RecordCount='+to_char(RecordCount));

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak,
                 'Подготовка данных для заполнения Раздела 3 формы РСВ...'#13, RecordCount);
  _try
  {
    iPageNumber += 2; // для раздела 1.3.1 две вкладки
    iPageNumber += 10;// для раздела 1.3.2 10 стр
    ZRep_CommonF.pInitPerech;

    VidPer_OPS   := ZRep_CommonF.fwGetVidPer(cnVidPer_OPS);
    VidPer_FOMS  := ZRep_CommonF.fwGetVidPer(cnVidPer_FOMS);
    VidPer_FSS   := ZRep_CommonF.fwGetVidPer(cnVidPer_FSS);

    lnCount4_P2   := 0;
    lnCount5_P2   := 0;
    lnCount1_P2   := 0;
    lnCount2_P2   := 0;
    lnCount3_P2   := 0;
    lnNumberLs    := 0;
    if ( wNumCor <> 0 )
    {
      if ( GetLast mt_PersDate = tsOk )
        lnNumberLs := mt_PersDate.lnNumerPF;
    }

    wMonthBeg := if ( wMonthBeg = 0, 1, wMonthBeg);
    if ( wRepPeriod <> cnPeriod_1_Kvart and cRecPredDoc <> 0 )
    {
      for ( wMonth := 4; wMonth <= 12; inc(wMonth) )
      {
        wMonthKv := RSV1_F.fwGetMonthKv(wMonth, wRepPeriod);
        if ( wMonthKv = 1 )
          wMonthBeg := wMonth;
      }
    }
    Timelog('RSV2017_Param->pFormDocum_RSV2017:DefZL.ClearCashZL');
    if ( DefZL.ClearCashZL ) {}

    //Добавление сумм по сотрудникам из пред. документа,
    //импортированного из другой базы данных без ссылок на ЛС

    _loop fullCACHE Formarks
    {
      NextVisual;
      if ( GetFirst LschetD <> tsOk ) continue;
       Timelog('RSV2017_Param->pFormDocum_RSV2017:=== LschetD.StrTabn='+LschetD.StrTabn);

      //исключаем лицевые счета - не физ лица
      if ( LschetD.CHAR4 = '-' ) continue;

      //102.184964
      //LSCHETD.CHAR13 <> '+' за весь период работы
      //LSCHET.CHAR14  = '+', переведен в другой филиал
      if ( LschetD.datUv <> ZeroDate and year(LschetD.datUv) = YearRep and ( LSCHETD.CHAR13 <> '+' ) and ( LSCHETD.CHAR14 = '+' ) )
        continue;

      delete all tp_CntFl;
      Timelog('RSV2017_Param->pFormDocum_RSV2017:RSV1_F.pAddSumLs(LschetD.nRec, rSumLS, rSumLSNeg)');
      RSV1_F.pAddSumLs(LschetD.nRec, rSumLS, rSumLSNeg);

      cRecLsch := LschetD.nRec;
      //Заполнение Раздела 3 суммами из предыдущего отчета
      Timelog('RSV2017_Param->pFormDocum_RSV2017:pAddSumLsfromPredDoc');
      pAddSumLsfromPredDoc;

      var boSumFomsandFss: boolean = true;
      var i_For: longint = 0;
      if ( boWorkList_For and SearchMarker(m_WorkKindList_For, LschetD.sovm, i_For) )
         boSumFomsandFss := false;

      //заполнение раздела 6 основными суммами
      doSumR6      := 0;
      doSumPers    := 0;
      doSumContr   := 0;
      wJobLsKv     := 0;
      wJobLsYear   := 0;
      for ( wMonth := 1; wMonth <= 3; inc(wMonth) )
        doSumVznLs[wMonth] := 0;
      for ( wMonth := wMonthBeg; wMonth <= wMonthEnd; inc(wMonth) )
      {
        boMonthKv := false;
        Timelog(' wMonth='+to_char(wMonth));

        DefZL.ClearCashLSchetZL(rSumLS.cLsch);
        wPrOPS_  := word(DefZL.GetStatusZL(rSumLS.cLsch, VidPer_OPS,  ZRepDocum.Year, wMonth));
        wPrFOMS_ := word(DefZL.GetStatusZL(rSumLS.cLsch, VidPer_FOMS, ZRepDocum.Year, wMonth));
        wPrFSS_  := word(DefZL.GetStatusZL(rSumLS.cLsch, VidPer_FSS,  ZRepDocum.Year, wMonth));
        Timelog(' not boSumFomsandFs='+to_char(wMonth));

        if ( not boSumFomsandFss )
        {
           wPrFOMS_ := 0;
           wPrFSS_  := 0;
        }

        //ОПС
        rSumLS.SumV[wMonth]           := fdoProvSum(rSumLS.SumV[wMonth]       ,    2);
        rSumLS.SumN1[wMonth]          := fdoProvSum(rSumLS.SumN1[wMonth]      ,    2);
        rSumLS.SumN2[wMonth]          := fdoProvSum(rSumLS.SumN2[wMonth]      ,    2);
        rSumLS.SumBDog[wMonth]        := fdoProvSum(rSumLS.SumBDog[wMonth]    ,    2);
        rSumLS.SumP[wMonth]           := fdoProvSum(rSumLS.SumP[wMonth]       ,    2);
        rSumLS.SumVznStr[wMonth]      := fdoProvSum(rSumLS.SumVznStr[wMonth]  ,    2);
        rSumLS.SumVznStrP[wMonth]     := fdoProvSum(rSumLS.SumVznStrP[wMonth] ,    2);

        //ФОМС
        rSumLS.SumVF[wMonth]          := if ( boSumFomsandFss, fdoProvSum(rSumLS.SumVF[wMonth]      ,    2), 0);
        rSumLS.SumN1F[wMonth]         := if ( boSumFomsandFss, fdoProvSum(rSumLS.SumN1F[wMonth]     ,    2), 0);
        rSumLS.SumN2F[wMonth]         := if ( boSumFomsandFss, fdoProvSum(rSumLS.SumN2F[wMonth]     ,    2), 0);
        rSumLS.SumVznFOMS[wMonth]     := if ( boSumFomsandFss, fdoProvSum(rSumLS.SumVznFOMS[wMonth] ,    2), 0);

        //СПИСОК 1 - суммы выплат
        rSumLS.SumVSP1[wMonth]        := fdoProvSum(rSumLS.SumVSP1[wMonth]     ,   2);
        rSumLS.SumVPk4_SP1[wMonth]    := fdoProvSum(rSumLS.SumVPk4_SP1[wMonth] ,   2);
        rSumLS.SumVPk34_SP1[wMonth]   := fdoProvSum(rSumLS.SumVPk34_SP1[wMonth],   2);
        rSumLS.SumVPk33_SP1[wMonth]   := fdoProvSum(rSumLS.SumVPk33_SP1[wMonth],   2);
        rSumLS.SumVPk32_SP1[wMonth]   := fdoProvSum(rSumLS.SumVPk32_SP1[wMonth],   2);
        rSumLS.SumVPk31_SP1[wMonth]   := fdoProvSum(rSumLS.SumVPk31_SP1[wMonth],   2);
        //СПИСОК 1 - н е о б л а г а е м ы е суммы
        rSumLS.SumNSP1[wMonth]        := fdoProvSum(rSumLS.SumNSP1[wMonth],        2);
        rSumLS.SumNPk4_SP1[wMonth]    := fdoProvSum(rSumLS.SumNPk4_SP1[wMonth],    2);
        rSumLS.SumNPk34_SP1[wMonth]   := fdoProvSum(rSumLS.SumNPk34_SP1[wMonth],   2);
        rSumLS.SumNPk33_SP1[wMonth]   := fdoProvSum(rSumLS.SumNPk33_SP1[wMonth],   2);
        rSumLS.SumNPk33_SP1[wMonth]   := fdoProvSum(rSumLS.SumNPk33_SP1[wMonth],   2);
        rSumLS.SumNPk32_SP1[wMonth]   := fdoProvSum(rSumLS.SumNPk32_SP1[wMonth],   2);
        rSumLS.SumNPk31_SP1[wMonth]   := fdoProvSum(rSumLS.SumNPk31_SP1[wMonth],   2);
        //СПИСОК 1 - взносы
        rSumLS.SumVznSp1[wMonth]      := fdoProvSum(rSumLS.SumVznSp1[wMonth],      2);
        rSumLS.SumVznPk4_SP1[wMonth]  := fdoProvSum(rSumLS.SumVznPk4_SP1[wMonth],  2);
        rSumLS.SumVznPk34_SP1[wMonth] := fdoProvSum(rSumLS.SumVznPk34_SP1[wMonth], 2);
        rSumLS.SumVznPk33_SP1[wMonth] := fdoProvSum(rSumLS.SumVznPk33_SP1[wMonth], 2);
        rSumLS.SumVznPk32_SP1[wMonth] := fdoProvSum(rSumLS.SumVznPk32_SP1[wMonth], 2);
        rSumLS.SumVznPk31_SP1[wMonth] := fdoProvSum(rSumLS.SumVznPk31_SP1[wMonth], 2);
        //СПИСОК 2 - суммы выплат
        rSumLS.SumVSP2[wMonth]        := fdoProvSum(rSumLS.SumVSP2[wMonth],        2);
        rSumLS.SumVPk4_SP2[wMonth]    := fdoProvSum(rSumLS.SumVPk4_SP2[wMonth],    2);
        rSumLS.SumVPk34_SP2[wMonth]   := fdoProvSum(rSumLS.SumVPk34_SP2[wMonth],   2);
        rSumLS.SumVPk33_SP2[wMonth]   := fdoProvSum(rSumLS.SumVPk33_SP2[wMonth],   2);
        rSumLS.SumVPk32_SP2[wMonth]   := fdoProvSum(rSumLS.SumVPk32_SP2[wMonth],   2);
        rSumLS.SumVPk31_SP2[wMonth]   := fdoProvSum(rSumLS.SumVPk31_SP2[wMonth],   2);
        //СПИСОК 2 - н е о б л а г а е м ы е суммы
        rSumLS.SumNSP2[wMonth]        := fdoProvSum(rSumLS.SumNSP2[wMonth],        2);
        rSumLS.SumNPk4_SP2[wMonth]    := fdoProvSum(rSumLS.SumNPk4_SP2[wMonth],    2);
        rSumLS.SumNPk34_SP2[wMonth]   := fdoProvSum(rSumLS.SumNPk34_SP2[wMonth],   2);
        rSumLS.SumNPk33_SP2[wMonth]   := fdoProvSum(rSumLS.SumNPk33_SP2[wMonth],   2);
        rSumLS.SumNPk32_SP2[wMonth]   := fdoProvSum(rSumLS.SumNPk32_SP2[wMonth],   2);
        rSumLS.SumNPk31_SP2[wMonth]   := fdoProvSum(rSumLS.SumNPk31_SP2[wMonth],   2);
        //СПИСОК 2 - взносы
        rSumLS.SumVznSp2[wMonth]      := fdoProvSum(rSumLS.SumVznSp2[wMonth]     , 2);
        rSumLS.SumVznPk4_SP2[wMonth]  := fdoProvSum(rSumLS.SumVznPk4_SP2[wMonth] , 2);
        rSumLS.SumVznPk34_SP2[wMonth] := fdoProvSum(rSumLS.SumVznPk34_SP2[wMonth], 2);
        rSumLS.SumVznPk33_SP2[wMonth] := fdoProvSum(rSumLS.SumVznPk33_SP2[wMonth], 2);
        rSumLS.SumVznPk32_SP2[wMonth] := fdoProvSum(rSumLS.SumVznPk32_SP2[wMonth], 2);
        rSumLS.SumVznPk31_SP2[wMonth] := fdoProvSum(rSumLS.SumVznPk31_SP2[wMonth], 2);

        wMonthKv := RSV1_F.fwGetMonthKv(wMonth, ZRepDocum.wPeriod);
        Timelog(' case wMonthKv of');
        case wMonthKv of
        1, 2, 3:
        {
          boMonthKv := true;
          doSummaV[wMonthKv]   := doSummaV[wMonthKv]   + rSumLS.SumV[wMonth];
          doSummaB[wMonthKv]   := doSummaB[wMonthKv]   + rSumLS.SumV[wMonth]
                                                       - rSumLS.SumN1[wMonth]
                                                       - rSumLS.SumN2[wMonth]
                                                       - rSumLS.SumP[wMonth];
          doSummaBD[wMonthKv]  := doSummaBD[wMonthKv]  + rSumLS.SumBDog[wMonth];
          doSummaVzn[wMonthKv] := doSummaVzn[wMonthKv] + rSumLS.SumVznStr[wMonth];
          doSumVznLs[wMonthKv] := doSumVznLs[wMonthKv] + rSumLS.SumVznStr[wMonth];
          //ФОМС
          doSummaV_Foms[wMonthKv]   := doSummaV_Foms[wMonthKv]   + rSumLS.SumVF[wMonth];
          doSummaB_Foms[wMonthKv]   := doSummaB_Foms[wMonthKv]   + rSumLS.SumVF[wMonth] - rSumLS.SumN1F[wMonth] - rSumLS.SumN2F[wMonth];
          doSummaVzn_Foms[wMonthKv] := doSummaVzn_Foms[wMonthKv] + rSumLS.SumVznFOMS[wMonth];

          //СПИСОК 1
          doSummaV_SP1[wMonthKv]    := doSummaV_SP1[wMonthKv]   + rSumLS.SumVSP1[wMonth]
                                                                + rSumLS.SumVPk4_SP1[wMonth]
                                                                + rSumLS.SumVPk34_SP1[wMonth]
                                                                + rSumLS.SumVPk33_SP1[wMonth]
                                                                + rSumLS.SumVPk32_SP1[wMonth]
                                                                + rSumLS.SumVPk31_SP1[wMonth];

          doSummaB_SP1[wMonthKv]    := doSummaB_SP1[wMonthKv]   + rSumLS.SumVSP1[wMonth]
                                                                + rSumLS.SumVPk4_SP1[wMonth]
                                                                + rSumLS.SumVPk34_SP1[wMonth]
                                                                + rSumLS.SumVPk33_SP1[wMonth]
                                                                + rSumLS.SumVPk32_SP1[wMonth]
                                                                + rSumLS.SumVPk31_SP1[wMonth]
                                                                - rSumLS.SumNSP1[wMonth]
                                                                - rSumLS.SumNPk4_SP1[wMonth]
                                                                - rSumLS.SumNPk34_SP1[wMonth]
                                                                - rSumLS.SumNPk33_SP1[wMonth]
                                                                - rSumLS.SumNPk32_SP1[wMonth]
                                                                - rSumLS.SumNPk31_SP1[wMonth];

          doSummaVzn_SP1[wMonthKv]  := doSummaVzn_SP1[wMonthKv] + rSumLS.SumVznSp1[wMonth]
                                                                + rSumLS.SumVznPk4_SP1[wMonth]
                                                                + rSumLS.SumVznPk34_SP1[wMonth]
                                                                + rSumLS.SumVznPk33_SP1[wMonth]
                                                                + rSumLS.SumVznPk32_SP1[wMonth]
                                                                + rSumLS.SumVznPk31_SP1[wMonth];

          //СПИСОК 2
          doSummaV_SP2[wMonthKv]    := doSummaV_SP2[wMonthKv]   + rSumLS.SumVSP2[wMonth]
                                                                + rSumLS.SumVPk4_SP2[wMonth]
                                                                + rSumLS.SumVPk34_SP2[wMonth]
                                                                + rSumLS.SumVPk33_SP2[wMonth]
                                                                + rSumLS.SumVPk32_SP2[wMonth]
                                                                + rSumLS.SumVPk31_SP2[wMonth];

          doSummaB_SP2[wMonthKv]    := doSummaB_SP2[wMonthKv]   + rSumLS.SumVSP2[wMonth]
                                                                + rSumLS.SumVPk4_SP2[wMonth]
                                                                + rSumLS.SumVPk34_SP2[wMonth]
                                                                + rSumLS.SumVPk33_SP2[wMonth]
                                                                + rSumLS.SumVPk32_SP2[wMonth]
                                                                + rSumLS.SumVPk31_SP2[wMonth]
                                                                - rSumLS.SumNSP2[wMonth]
                                                                - rSumLS.SumNPk4_SP2[wMonth]
                                                                - rSumLS.SumNPk34_SP2[wMonth]
                                                                - rSumLS.SumNPk33_SP2[wMonth]
                                                                - rSumLS.SumNPk32_SP2[wMonth]
                                                                - rSumLS.SumNPk31_SP2[wMonth];

          doSummaVzn_SP2[wMonthKv]  := doSummaVzn_SP2[wMonthKv] + rSumLS.SumVznSp2[wMonth]
                                                                + rSumLS.SumVznPk4_SP2[wMonth]
                                                                + rSumLS.SumVznPk34_SP2[wMonth]
                                                                + rSumLS.SumVznPk33_SP2[wMonth]
                                                                + rSumLS.SumVznPk32_SP2[wMonth]
                                                                + rSumLS.SumVznPk31_SP2[wMonth];

        } //case wMonthKv of
        end;

        doSumR6    := doSumR6 + abs(rSumLS.SumV[wMonth]) + abs(rSumLS.SumVznStr[wMonth]) + abs(rSumLS.SumVznStrP[wMonth]);
        doSumContr := abs(rSumLS.SumV[wMonth]) + abs(rSumLS.SumN1[wMonth])     + abs(rSumLS.SumN2[wMonth]) +
                      abs(rSumLS.SumP[wMonth]) + abs(rSumLS.SumVznStr[wMonth]) + abs(rSumLS.SumVznStrP[wMonth]);

        Timelog('   if ( doSumContr < cn_ContrMinSum )');
        if ( doSumContr < cn_ContrMinSum )
        {
          wJobLs := if ( fboSearchPeriodJob(wMonth, ZRepDocum.Year), 1, 0 );
          if ( wJobLsYear = 0 and wJobLs = 1 )
            wJobLsYear := 1;

          if ( wJobLsYear = 0 and wMonth >= 2 )
          {
            var wNppMonth: word;
            for ( wNppMonth := 1; wNppMonth < wMonth; inc(wNppMonth) )
              if ( fboSearchPeriodJob(wNppMonth, ZRepDocum.Year) )
              {
                wJobLsYear := 1;
                break;
              }
          }

          if ( boMonthKv )
          {
            if ( wJobLsKv = 0 and wJobLs = 1 )
              wJobLsKv := 1;
          }
        }
        else
          wJobLs := 0;

        Timelog('   if ( doSumContr > cn_ContrMinSum or wJobLs = 1 )');
        if ( doSumContr > cn_ContrMinSum or wJobLs = 1 )
        {
          if ( wPrOPS_ = 1 )
          {
            rSumLS.wPrOPS[4] := 1;
             case wMonthKv of
             1, 2, 3: rSumLS.wPrOPS[wMonthKv ] := 1;
             end;
          }
          if ( wPrFOMS_ = 1 )
          {
            rSumLS.wPrFOMS[4] := 1;
             case wMonthKv of
             1, 2, 3: rSumLS.wPrFOMS[wMonthKv] := 1;
             end;
          }

          if ( wPrFSS_ = 1 )
          {
            rSumLS.wPrFSS[4] := 1;
            case wMonthKv of
            1, 2, 3: rSumLS.wPrFSS[wMonthKv] := 1;
            end;
          }
        }
        doSummaVznRep[wMonth]  := doSummaVznRep[wMonth] + rSumLS.SumVznStr[wMonth];
      }//for ( wMonth := wMonthBeg; wMonth <= wMonthEnd; inc(wMonth) )
      var boCheckSumDog: boolean;
      boCheckSumDog := true;
      doTmp         := 0;
      doSumContr    := 0;
      Timelog('   if ( rSumLS.wPrFSS[4] = 1 )');
      if ( rSumLS.wPrFSS[4] = 1 )
      {
        for ( wMonth := wMonthBeg; wMonth <= wMonthEnd; inc(wMonth) )
        {
          Timelog('   if ( rSumLS.wPrFSS[4] = 1 ) wMonth='+to_char(wMonth));
          doTmp      := doTmp + rSumLS.SumBDog[wMonth] - (rSumLS.SumV[wMonth] -  rSumLS.SumN1[wMonth] -
                                                          rSumLS.SumN2[wMonth] - rSumLS.SumP[wMonth]);
          doSumContr := doSumContr + rSumLS.SumBDog[wMonth];
          if ( abs(rSumLS.SumBDog[wMonth] - (rSumLS.SumV[wMonth] -  rSumLS.SumN1[wMonth] -
                                             rSumLS.SumN2[wMonth] - rSumLS.SumP[wMonth])) > cn_ContrMinSum )
          {
            boCheckSumDog := false;
            break;
          }
        }//for ( wMonth := wMonthBeg; wMonth <= wMonthEnd; inc(wMonth) )

        //база по договорам подряда = базе для начисления взносов по каждому месяцу
        //и при этом есть суммы по договорам подряда
        //считаем сотрудника не застрахованным в ФСС, это договорник
        if ( boCheckSumDog and abs(doSumContr) > cn_ContrMinSum and abs(doTmp) < cn_ContrMinSum )
        {
          for ( wMonth := 1; wMonth <= 4; inc(wMonth) )
            rSumLS.wPrFSS[wMonth] := 0;
        }
        else
        {
          for ( wMonth := wMonthBeg; wMonth <= wMonthEnd; inc(wMonth) )
          {
            wMonthKv := RSV1_F.fwGetMonthKv(wMonth, ZRepDocum.wPeriod);

            case wMonthKv of
            1, 2, 3:
            {
              if ( ( abs(rSumLS.SumBDog[wMonth]) > cn_ContrMinSum ) and
                   ( abs(rSumLS.SumBDog[wMonth] - (rSumLS.SumV[wMonth] -  rSumLS.SumN1[wMonth] -
                                                   rSumLS.SumN2[wMonth] - rSumLS.SumP[wMonth])) < cn_ContrMinSum ) )
              {
                rSumLS.wPrFSS[wMonthKv] := 0;
              }
            }
            end;
          }
        }
      }

      if ( abs(doSumR6) < cn_ContrMinSum )
//        if ( fboCheck_LS )//сотрудник работал в отчетном периоде и включена галочка
        if ( fboCheck_LS_Month )//сотрудник работал в отчетном периоде и включена галочка
        {                 //"формировать при отсутствии данных"
          doSumR6 := 100;
        }

      doSumPers := 0;
      Timelog('   if ( doSumR6 > cn_ContrMinSum )');
      if ( doSumR6 > cn_ContrMinSum )
      {
        for ( wMonth := wMonthBeg; wMonth <= wMonthEnd; inc(wMonth) )
        {
          wMonthKv := RSV1_F.fwGetMonthKv(wMonth, ZRepDocum.wPeriod);
          case wMonthKv of
          1, 2, 3:
          {
            doSumPers := doSumPers + abs(rSumLS.SumV[wMonth]) + abs(rSumLS.SumN1[wMonth])     + abs(rSumLS.SumN2[wMonth]) +
                                    abs(rSumLS.SumP[wMonth])  + abs(rSumLS.SumVznStr[wMonth]) + abs(rSumLS.SumVznStrP[wMonth]);

            //Приложение 2
            RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment2, 0, rSumLS.wTarif[wMonth], wMonthKv, cnCount_Fl, rSumLS.wPrFSS[wMonthKv]);
            if ( ( rSumLS.Prizn[wMonth] = 2 ) and ( rSumLS.Proc[wMonth] > cn_ContrMinSum ) and rSumLS.wTarif[wMonth] <> wMainTar )
            {
              //Подраздел 1.1 - суммы взносов ОПС
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_11, 0, rSumLS.wTarif[wMonth], wMonthKv, cnCount_Fl, rSumLS.wPrOPS[wMonthKv]);
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_11, 0, wMainTar, wMonthKv, cnCount_Fl, rSumLS.wPrOPS[wMonthKv]);
              //Подраздел 1.2 - суммы взносов Ф О М С
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_12, 0, rSumLS.wTarif[wMonth], wMonthKv, cnCount_Fl, rSumLS.wPrFOMS[wMonthKv]);
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_12, 0, wMainTar, wMonthKv, cnCount_Fl, rSumLS.wPrFOMS[wMonthKv]);
            }
            else
            {
              //Подраздел 1.1 - суммы взносов ОПС
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_11, 0, rSumLS.wTarif[wMonth], wMonthKv, cnCount_Fl, rSumLS.wPrOPS[wMonthKv]);
              //Подраздел 1.2 - суммы взносов Ф О М С
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_12, 0, rSumLS.wTarif[wMonth], wMonthKv, cnCount_Fl, rSumLS.wPrFOMS[wMonthKv]);
            }
            //Приложение 2
            RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment2, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrFSS[4]);
            if ( ( rSumLS.Prizn[wMonth] = 2 ) and ( rSumLS.Proc[wMonth] > cn_ContrMinSum ) and rSumLS.wTarif[wMonth] <> wMainTar )
            {
              //Подраздел 1.1 - суммы взносов ОПС
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_11, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrOPS[4]);
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_11, 0, wMainTar, 4, cnCount_Fl, rSumLS.wPrOPS[4]);
              //Подраздел 1.2 - суммы взносов Ф О М С
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_12, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrFOMS[4]);
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_12, 0, wMainTar, 4, cnCount_Fl, rSumLS.wPrFOMS[4]);
            }
            else
            {
              //Подраздел 1.1 - суммы взносов ОПС
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_11, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrOPS[4]);
              //Подраздел 1.2 - суммы взносов Ф О М С
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_12, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrFOMS[4]);
            }
          }//1, 2, 3
          end;
        }//for ( wMonth := wMonthBeg; wMonth <= wMonthEnd; inc(wMonth) )

       Timelog('  if ( abs(doSumPers) > cn_ContrMinSum )');
        if ( abs(doSumPers) > cn_ContrMinSum )
          pFill_SumLsch(cnMainRazd6, cnMainSumRazd6, 0)
        else
        //сумм нет
        {
          if ( wJobLsYear = 1 ) //сотрудник работал в отчетном году
          {
            if ( wJobLsKv = 0 ) //сотрудник НЕ работал в отчетном квартале, это уволенный (начислений тоже нет)
              pFill_SumLsch(cnMainRazd6, cnMainSumRazd6Uv, 0)
            else
            //сотрудник РАБОТАЛ в отчетном квартале, но начислений нет
              if ( ( wRazdRsv and 1 ) = 1 )// и включен флажок "формировать при отсутствии начислений"
                pFill_SumLsch(cnMainRazd6, cnMainSumRazd6, 0)
            //сотрудник является застрахованным с начала года
              else
                if ( rSumLS.wPrOPS[4] > cn_ContrMinSum )
                  pFill_SumLsch(cnMainRazd6, cnMainSumRazd6Uv, 0);
          }
          else
            if ( abs(doSumR6) > cn_ContrMinSum ) //сотрудник НЕ работал в отчетном году, но есть суммы
              pFill_SumLsch(cnMainRazd6, cnMainSumRazd6Uv, 0)
        }
      }//if ( doSumR6 > cn_ContrMinSum )
      else
      //сотрудник работал в отчетном году, но НЕ работал в отчетном квартале, это уволенный (начислений тоже нет)
        if ( abs(doSumPers) < cn_ContrMinSum and wJobLsYear = 1 and wJobLsKv = 0 )
        {
          Timelog('  if ( GetFirst ZRepLschPred = tsOk )');
          if ( GetFirst ZRepLschPred = tsOk )
          {
            if ( ZRepLschPred.SumN2[4] > 0 )
              rSumLS.wPrOps[4]  := word(ZRepLschPred.SumN2[4]);
            if ( ZRepLsch.SumN2[8] > 0 )
              rSumLS.wPrFOMS[4] := word(ZRepLschPred.SumN2[8]);
            if ( ZRepLschPred.SumN2[12] > 0 )
              rSumLS.wPrFSS[4]  := word(ZRepLschPred.SumN2[12]);
          }

          var iC: longint = 0;
          if ( not ( boWorkListLoaded and ( SearchMarker(m_WorkKindList, LschetD.sovm, iC) ) ) )
            pFill_SumLsch(cnMainRazd6, cnMainSumRazd6Uv, 0);
        }

      Timelog('  for ( wMonth := wMonthBeg; wMonth <= wMonthEnd; inc(wMonth) ) )');
      for ( wMonth := wMonthBeg; wMonth <= wMonthEnd; inc(wMonth) )
      {
        wMonthKv := RSV1_F.fwGetMonthKv(wMonth, ZRepDocum.wPeriod);
        case wMonthKv of
        1, 2, 3: {}
        else
        {
          doSumContr := abs(rSumLS.SumV[wMonth]) + abs(rSumLS.SumN1[wMonth])     + abs(rSumLS.SumN2[wMonth]) +
                        abs(rSumLS.SumP[wMonth]) + abs(rSumLS.SumVznStr[wMonth]) + abs(rSumLS.SumVznStrP[wMonth]) + doSumR6;
          if ( doSumContr < cn_ContrMinSum )
            if ( fboCheck_LS_Month )
               doSumContr := 100;

          Timelog('  if ( doSumContr > cn_ContrMinSum )');
          if ( doSumContr > cn_ContrMinSum )
          {
            //Приложение 2
            RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment2, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrFSS[4]);
            if ( ( rSumLS.Prizn[wMonth] = 2 ) and ( rSumLS.Proc[wMonth] > cn_ContrMinSum ) and rSumLS.wTarif[wMonth] <> wMainTar )
            {
              //Подраздел 1.1 - суммы взносов ОПС
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_11, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrOPS[4]);
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_11, 0, wMainTar, 4, cnCount_Fl, rSumLS.wPrOPS[4]);
              //Подраздел 1.2 - суммы взносов Ф О М С
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_12, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrFOMS[4]);
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_12, 0, wMainTar, 4, cnCount_Fl, rSumLS.wPrFOMS[4]);
            }
            else
            {
              //Подраздел 1.1 - суммы взносов ОПС
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_11, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrOPS[4]);
              //Подраздел 1.2 - суммы взносов Ф О М С
              RSV2017_F.pAddFltoReport(cnRazd_1, cnRazd1_Attachment1_12, 0, rSumLS.wTarif[wMonth], 4, cnCount_Fl, rSumLS.wPrFOMS[4]);
            }
          }
        }
        end;
      }

      //заполнение разделов суммами по тарифу
      //формируем с учетом предыдущего документа
      Timelog('  if ( ZRepDocum.cDocPred <> comp(0) )');
      if ( ZRepDocum.cDocPred <> comp(0) )
      {
        _loop ZRepDetail where (( ZRepDocum.cDocPred     == ZRepDetail.cRecDocum and
                                  cnRazd_1               == ZRepDetail.NumRazd   and
                                  cnRazd1_Attachment1_11 == ZRepDetail.NumPage
                               ))
          pCreate_tp_SumCodeTar(ZRepDetail.TarCode);
      }

      Timelog('  pFill_tp_SumCodeTar;');
      pFill_tp_SumCodeTar;
      //заполнение разделов суммами по доп. тарифу
      Timelog(' pFill_RazdelDopTar;');
      pFill_RazdelDopTar;
      //****** после формирования с учётом совместительства заполним количество физ.лиц *****
      _loop tp_CntFl where (( cnRazd_1 == tp_CntFl.NumRazd ))
      {
        case tp_CntFl.NumPage of
        cnRazd1_Attachment1_11,
        cnRazd1_Attachment1_12:
        {
          if ( GetFirst tp_SumCodeTar where (( tp_CntFl.PriznPage == tp_SumCodeTar.wCodTar )) <> tsOk )
          {
            ClearBuffer(#tp_SumCodeTar);
            tp_SumCodeTar.wCodTar := tp_CntFl.PriznPage;
            insert current tp_SumCodeTar;
          }
//          if ( GetFirst tp_SumCodeTar where (( tp_CntFl.PriznPage == tp_SumCodeTar.wCodTar )) = tsOk )
 //         {
            for ( wMonth := 1; wMonth <= 5; inc(wMonth) )
            {
              if ( tp_CntFl.NumPage = cnRazd1_Attachment1_11 )
              {
                tp_SumCodeTar.CountFl[wMonth]      := tp_SumCodeTar.CountFl[wMonth]      + tp_CntFl.lnCountI[wMonth];
                tp_SumCodeTar.CountFlVzn[wMonth]   := tp_SumCodeTar.CountFlVzn[wMonth]   + tp_CntFl.lnCountVzn[wMonth];
                tp_SumCodeTar.CountFlP[wMonth]     := tp_SumCodeTar.CountFlP[wMonth]     + tp_CntFl.lnCountVznP[wMonth];
              }
              else
              {
                tp_SumCodeTar.CntFlFOMS[wMonth]    := tp_SumCodeTar.CntFlFOMS[wMonth]    + tp_CntFl.lnCountI[wMonth];
                tp_SumCodeTar.CntFlVznFOMS[wMonth] := tp_SumCodeTar.CntFlVznFOMS[wMonth] + tp_CntFl.lnCountVzn[wMonth];
              }
            }
            update current tp_SumCodeTar;
          //}
        }
        cnRazd1_Attachment2:
        {
          lnCount4_P2 := lnCount4_P2 + tp_CntFl.lnCountI[4];
          lnCount5_P2 := lnCount5_P2 + tp_CntFl.lnCountI[5];
          lnCount1_P2 := lnCount1_P2 + tp_CntFl.lnCountI[1];
          lnCount2_P2 := lnCount2_P2 + tp_CntFl.lnCountI[2];
          lnCount3_P2 := lnCount3_P2 + tp_CntFl.lnCountI[3];
        }
        else
        {
          if ( GetFirst tp_SumDopTar where (( tp_CntFl.NumRazd == tp_SumDopTar.wNumRazd and
                                              tp_CntFl.NumPage == tp_SumDopTar.wCodOsn  and
                                              tp_CntFl.NumPk   == tp_SumDopTar.wPodkl
                                           )) = tsOk )
          {
            for ( wMonth := 1; wMonth <= 5; inc(wMonth) )
            {
              tp_SumDopTar.CountFl[wMonth]    := tp_SumDopTar.CountFl[wMonth]    + tp_CntFl.lnCountI[wMonth];
              tp_SumDopTar.CountFlVzn[wMonth] := tp_SumDopTar.CountFlVzn[wMonth] + tp_CntFl.lnCountVzn[wMonth];
            }
            update current tp_SumDopTar;
          }
          else
          {
            ClearBuffer(#tp_SumDopTar);
            tp_SumDopTar.wNumRazd := tp_CntFl.NumRazd;
            tp_SumDopTar.wCodOsn  := tp_CntFl.NumPage;
            tp_SumDopTar.wPodkl   := tp_CntFl.NumPk;
            for ( wMonth := 1; wMonth <= 5; inc(wMonth) )
            {
              tp_SumDopTar.CountFl[wMonth]    := tp_CntFl.lnCountI[wMonth];
              tp_SumDopTar.CountFlVzn[wMonth] := tp_CntFl.lnCountVzn[wMonth];
            }
            insert current tp_SumDopTar;
          }
        }
        end;
      }//_loop tp_CountFl where (( cnRazd_1 == tp_CntFl.NumRazd ))
      Timelog('RSV2017_Param->pFormDocum_RSV2017:>>>> LschetD.StrTabn='+LschetD.StrTabn+'<<<<<<<<<<<<<<<');

    }//_loop fullCACHE Formarks
    ResetBounds(#tp_SumCodeTar);
    if ( GetFirst ZRepDetail where (( ZRepDocum.nRec       == ZRepDetail.cRecDocum and
                                      cnRazd_1             == ZRepDetail.NumRazd   and
                                      cnRazd1_Attachment2  == ZRepDetail.NumPage   and
                                      cnTabb_1             == ZRepDetail.PriznPage
                                   )) = tsOk )
    {
      ZRepDetail.CountFL[5] := lnCount4_P2; //Количество ЗЛ, всего с начала расчетного периода
      ZRepDetail.CountFL[4] := lnCount5_P2; //Количество ЗЛ, всего за три месяца
      ZRepDetail.CountFL[1] := lnCount1_P2; //Количество ЗЛ, 1 месяц
      ZRepDetail.CountFL[2] := lnCount2_P2; //Количество ЗЛ, 2 месяц
      ZRepDetail.CountFL[3] := lnCount3_P2; //Количество ЗЛ, 3 месяц
      update current ZRepDetail;
    }
  }//_try
  _except
    on ExUserBreak:
    {
    };
  _finally
  {
    StopVisual('', 0);
  }

  Timelog(' END _Loop Formarks');
  for ( wMonth := 1; wMonth <= 3; inc(wMonth) )
  {
    //Сумма выплат
    ZRepDocum.SummaDop[wMonth]    := doSummaV[wMonth];
    //База
    ZRepDocum.SummaDop[wMonth+3]  := doSummaB[wMonth];
    //Взносы
    ZRepDocum.SummaDop[wMonth+6]  := doSummaVzn[wMonth];
    //=== Ф О М С ====
    //Сумма выплат
    ZRepDocum.SummaFoms[wMonth]   := doSummaV_Foms[wMonth];
    //База
    ZRepDocum.SummaFoms[wMonth+3] := doSummaB_Foms[wMonth];
    //Взносы
    ZRepDocum.SummaFoms[wMonth+6] := doSummaVzn_Foms[wMonth];
    //СПИСОК 1
    //Сумма выплат
    ZRepDocum.SummaPk1[wMonth]    := doSummaV_SP1[wMonth];
    //База
    ZRepDocum.SummaPk1[wMonth+3]  := doSummaB_SP1[wMonth];
    //Взносы
    ZRepDocum.SummaPk1[wMonth+6]  := doSummaVzn_SP1[wMonth];
    //СПИСОК 2
    //Сумма выплат
    ZRepDocum.SummaCor[wMonth]    := doSummaV_SP2[wMonth];
    //База
    ZRepDocum.SummaCor[wMonth+3]  := doSummaB_SP2[wMonth];
    //Взносы
    ZRepDocum.SummaCor[wMonth+6]  := doSummaVzn_SP2[wMonth];
  }

  update current ZRepDocum;

  // формирование расшифровки приложений 2,3,4
  Timelog(' формирование расшифровки приложений 2,3,4');
  if ((wRasshifr or coRasshifr) <> 0)
  {
    RSV2017_PrintR.pSetRecDocum(ZRepDocum.nRec);
    // Расшифровка приложения 2 РСВ-2017
    RSV2017_PrintR.pPrintRasshAttachment(wMonthEnd, wTypeVO);
  }

  ResetBounds(#tp_SumCodeTar);
  if ( GetFirst tp_SumCodeTar <> tsOk )
  {
    ClearBuffer(#tp_SumCodeTar);
    tp_SumCodeTar.wCodTar := wMainTar;
    insert current tp_SumCodeTar;
  }
  else
  {
    wCurTar := tp_SumCodeTar.wCodTar;
    if ( GetFirst tp_SumCodeTar where (( wMainTar == tp_SumCodeTar.wCodTar )) <> tsOk )
      wMainTar := wCurTar;
  }

  iPageNumber += 2; // cnRazd1_Attachment1_11, cnRazd1_Attachment1_12

  Timelog(' _loop tp_SumCodeTar');
  _loop tp_SumCodeTar
  {
    if ( tp_SumCodeTar.wCodTar = wMainTar )
    {
      pFillRazdelRsv_KodTar(cnRazd1_Attachment1_11, cnTabb_1, tp_SumCodeTar.wCodTar);
      pFillRazdelRsv_KodTar(cnRazd1_Attachment1_12, cnTabb_1, tp_SumCodeTar.wCodTar);
    }
    else
    {
      pFillRazdelRsv_KodTar(cnRazd1_Attachment1_11, cnTabb_2, tp_SumCodeTar.wCodTar);
      pFillRazdelRsv_KodTar(cnRazd1_Attachment1_12, cnTabb_2, tp_SumCodeTar.wCodTar);
    }
  }

  //Добавим суммы из пред. документа
  pAddSumPredDoc;

  pFill_RazdelPk;
  pFill_Razdel1;

  // записываем количество сформированных страниц
  update ZRepInfo where (( ZRepDocum.nRec == ZRepInfo.cRecDocum and
                           cnRazd_Titl    == ZRepInfo.wFirstNb1 ))
  set ZRepInfo.wCount[4] := iPageNumber,
      ZRepInfo.wCount[5] := iAttachmentNumber;

  //Для подраздела 1.4 добавим код тарифа
  if getfirst ZRepDetail where ((ZRepDocum.nRec  == ZRepDetail.cRecDocum and
                                 cnRazd_1        == ZRepDetail.NumRazd   and
                                 cnRazd1_Att1_14 == ZRepDetail.NumPage   and
                                 cnTabb_1        == ZRepDetail.PriznPage )) = tsOk
  {
    ZRepDetail.TarCode := if(ZRepDocum.wTune[3]>0,ZRepDocum.wTune[3],RSV1_F.fwGetMainTar);
    update current ZRepDetail;
  }

  //включен параметр включать уволенных
  if ( ( wRazdRsv and 8 ) = 8 )
  {
    update ZRepLschPred where (( ZRepDocum.nRec     == ZRepLschPred.cRecDocum and
                                 cnMainRazd6        == ZRepLschPred.wPrDoc    and
                                 cnMainSumRazd6Uv   == ZRepLschPred.wPrSum
                              ))
      set ZRepLschPred.wPrSum = cnMainSumRazd6;
  }
  Timelog('RSV2017_Param->pFormDocum_RSV2017:finish');
} // pFormDocum_RSV2017

end. // interface
