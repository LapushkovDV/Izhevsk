#include Rsv_1.Vih
#include RSV_1_FUNC.vih
#include Contexts.vih     // обработка контекстов
#include LgotNalLSch.vih  // работа с таблицей LgNalLsZ
#include NeoblSumForm.VIH // Функции формирования необлагаемых сумм
#include WorkCnFunc.vih   // Функции для определения класса, подкласса условий труда
#include PAXRefs.vih      // перекрестные ссылки лицевых счетов
#include RSV_1_FillTbl.vih
#include StrFunc.vih      // Функции работы со строками
#include Pmntents.VIH
#include futureFOT.vih

//var FilBuf: FillFotFut;

#doc
  ФУНКЦИИ ФОРМИРОВАНИЯ РСВ-1 (ПФ РФ)
#end
#component "Z_Report"

Alter Interface RSV_1_FUNC;
OverLoad
  procedure objRSV_1_FUNC.pAddSumLs(cRecLschet: comp; var rSumLS: TSumLS; var rSumLSNeg: TSumLS);
  procedure pSearhSum_LS(Month_: word; var rSumLS: TSumLS; var rSumLSNeg: TSumLS);
  procedure pSearhVzn_LS(wPrOsn: word; var rSumLS, rSumLSNeg: TSumLS);
end;
//create view vRSV_1_FUNC


//***********************************************************************
//  процедура поиска сумм по сотруднику
//***********************************************************************
procedure pSearhSum_LS(Month_: word; var rSumLS: TSumLS; var rSumLSNeg: TSumLS);
var
  wPrizn        : word;

  doSum28MP
 ,doSumtmp      : double;

  boUchSum
 ,boUchNullCexOZ
 ,boAddNeoblSum : boolean;

  VidOplSMP
 ,VidOplPMP     : longInt;
{
  wMonth    := Month_;
  Timelog('RSV_1_FUNC->pSearhSum_LS:001');

  boUchSum := true;

  sParam_ := if ( YearRep <= 2014, cSocnalPaymentInsurancePart, cSocnalPaymentSolidPart);
  if ( GetFirst tp_Perech = tsOk ) {}

  boUchNullCexOZ := false;

  //102.184964
  if (YearRep >= 2016)
    if ( LSCHET.DAT6 <> ZeroDate and Year(LSCHET.DAT6) = YearRep and LSCHET.CHAR13 <> '+' )
      boUchNullCexOZ := true;

  Timelog('RSV_1_FUNC->pSearhSum_LS:002');
  if ( day(LSCHET.DAT7) > 0 )
  //заполнена дата, с которой не удерживается НДФЛ в ЛС
  {
   Timelog('RSV_1_FUNC->pSearhSum_LS:003');
    //текущая дата - дата после смерти
    if ( date(day(1), Month_, YearRep ) >= date (1, Month(LSCHET.DAT7), Year(LSCHET.DAT7)) )
    {
      //отч. год и год смерти совпадают
      if ( YearRep = Year(LSCHET.DAT7) )
      {
        if ( word(SumUlSoc.Summa2[Month(LSCHET.DAT7)]) = 1 )
          boUchSum := false;
      }
      else
      {
        sParam_ := if ( Year(LSCHET.DAT7) <= 2014, cSocnalPaymentInsurancePart, cSocnalPaymentSolidPart);
        if ( GetFirst tp_Perech = tsOk )
          if ( GetFirst SumUlSocSyn where (( LSchet.nRec       == SumUlSocSyn.cLsch and
                                             Year(LSCHET.DAT7) == SumUlSocSyn.Year  and
                                             tp_Perech.Vidper  == SumUlSocSyn.Vidper )) = tsOk )
             if ( word(SumUlSocSyn.Summa2[Month(LSCHET.DAT7)]) = 1 )
               boUchSum := false;
      }
    }
  }

  Timelog('RSV_1_FUNC->pSearhSum_LS:004');
  if ( rSumLS.Prizn[wMonth] = 5 ) //застрахованный в ПФР иностранец
  {
    doSumtmp := Get_NalogSV(VidPer_FOMS, 1, date(1, wMonth, YearRep), 0, wLgScale_LS[wMonth]);
    if ( abs(doSumtmp) < cn_ContrMinSum )   //отчисления в ФФОМС не производятся
      rSumLS.Prizn[wMonth] := 10;
  }

  boAddNeoblSum := true;
  if ( LSCHET.DAT6 <> Date(0,0,0) )
  {
    if ( ( Year(LSCHET.DAT6) = YearRep ) and ( wMonth < Month(LSCHET.DAT6) ) )
    {
      boAddNeoblSum := false;
    }
  }

  Timelog('RSV_1_FUNC->pSearhSum_LS:005');
  wPrizn    := rSumLS.Prizn[wMonth];
  doSumNY   := if ( boAddNeoblSum, fdoGetSumNY(wPrizn, wMonth, 0),  0);
  doSumNY1  := if ( boAddNeoblSum, fdoGetSumNY(wPrizn, wMonth, 1),  0);
  doSumNY2  := if ( boAddNeoblSum, fdoGetSumNY(wPrizn, wMonth, 2),  0);
  doSumNY0  := if ( boAddNeoblSum, (doSumNY - doSumNY1 - doSumNY2), 0);

  doSum28MP := 0;
  VidOplSMP := 0;
  VidOplPMP := 0;
  Timelog('RSV_1_FUNC->pSearhSum_LS:006');
  _loop SumVidOp
  {
    if ( not fboCheckVidOpl(SumVidOp.VidOpl) ) continue;

    if ( not boUchNullCexOZ )
      if ( SumVidop.CexOZ = comp(0) )
         continue;

    if ( not(boUchSum) ) continue;

    rSumLS.SumV[wMonth]  := rSumLS.SumV[wMonth]  + SumVidOp.Summa;
    rSumLS.SumVF[wMonth] := rSumLS.SumVF[wMonth] + SumVidOp.Summa;
    if ( ( abs(SumVidOp.Summa) > cn_ContrMinSum ) and ( SumVidOp.Summa < -1.00*cn_ContrMinSum ) )
    {
      rSumLSNeg.SumV[wMonth]  := rSumLSNeg.SumV[wMonth]  + SumVidOp.Summa;
      rSumLSNeg.SumVF[wMonth] := rSumLSNeg.SumVF[wMonth] + SumVidOp.Summa;
    }

    //заполнение расшифровки
    pFill_tp_SumCodeTar(rSumLS.cLsch, SumVidOp.cLsch, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], SumVidOp.Summa,
                        rSumLS.Prizn[wMonth], cn_SummaV_Tar, SumVidOp.VidOpl, SumVidOp.VidOplP);
    //заполнение сумм с подклассами
    pFillSummaVDopTar(SumVidOp.Summa28, SumVidOp.Summa, wMonth, cnSummaV, rSumLS, rSumLSNeg);

    if ( rSumLS.Prizn[wMonth] = 10 )
    //отчисления в ФФОМС не производятся
    {
      rSumLS.SumN1F[wMonth] := rSumLS.SumN1F[wMonth] + SumVidOp.Summa;
      if ( ( abs(SumVidOp.Summa) > cn_ContrMinSum ) and ( SumVidOp.Summa < -1.00*cn_ContrMinSum ) )
        rSumLSNeg.SumN1F[wMonth] := rSumLSNeg.SumN1F[wMonth] + SumVidOp.Summa;
    }

    // м а т п о м о щ ь
    if ( tp_Vidopl.VHVOE19 = 'М' and ( abs(doSumNY) > cn_ContrMinSum ) ) //м а т п о м о щ ь
    {
      doSum28MP  := SumVidOp.Summa28;
      VidOplSMP  := SumVidOp.VidOpl;
      VidOplPMP  := SumVidOp.VidOplP;

      pAddSumNeobl(SumVidOp.cLsch, SumVidOp.Summa, SumVidOp.Summa28, rSumLS, rSumLSNeg, doSum28MP, VidOplSMP, VidOplPMP);
      continue;
    } // if ( tp_Vidopl.VHVOE[19] = 'М' )

    //Учесть нормативы затрат для начислений по договорам отчуждения прав/авторским
    if ( fboboNeblNorm(coSumVidOp, rSumLS, rSumLSNeg) ) continue;

    // н е о б л а г а е м ы е суммы
    if ( fboSumNeobl(wPrizn) )
    {
      rSumLS.SumN1[wMonth]  := rSumLS.SumN1[wMonth]  + SumVidOp.Summa;
      if ( ( abs(SumVidOp.Summa) > cn_ContrMinSum ) and ( SumVidOp.Summa < -1.00*cn_ContrMinSum ) )
        rSumLSNeg.SumN1[wMonth]  := rSumLSNeg.SumN1[wMonth]  + SumVidOp.Summa;

      if ( rSumLS.Prizn[wMonth] <> 10 )
      {
        rSumLS.SumN1F[wMonth] := rSumLS.SumN1F[wMonth] + SumVidOp.Summa;
        if ( ( abs(SumVidOp.Summa) > cn_ContrMinSum ) and ( SumVidOp.Summa < -1.00*cn_ContrMinSum ) )
          rSumLSNeg.SumN1F[wMonth] := rSumLSNeg.SumN1F[wMonth] + SumVidOp.Summa;
      }
      pFillSummaVDopTar(SumVidOp.Summa28, SumVidOp.Summa, wMonth, cnSummaN, rSumLS, rSumLSNeg);
      //заполнение расшифровки
      pFill_tp_SumCodeTar(rSumLS.cLsch, SumVidOp.cLsch, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], SumVidOp.Summa,
                          rSumLS.Prizn[wMonth], cn_SummaNeobl_Tar, SumVidOp.VidOpl, SumVidOp.VidOplP);

      continue;
    }

    // расходы к вычету
    if ( fboSumNeoblRasx )
    {
      rSumLS.SumN2[wMonth]  := rSumLS.SumN2[wMonth]  + SumVidOp.Summa;
      if ( ( abs(SumVidOp.Summa) > cn_ContrMinSum ) and ( SumVidOp.Summa < -1.00*cn_ContrMinSum ) )
        rSumLSNeg.SumN2[wMonth]  := rSumLSNeg.SumN2[wMonth]  + SumVidOp.Summa;

      if ( rSumLS.Prizn[wMonth] <> 10 )
      {
        rSumLS.SumN2F[wMonth] := rSumLS.SumN2F[wMonth] + SumVidOp.Summa;
        if ( ( abs(SumVidOp.Summa) > cn_ContrMinSum ) and ( SumVidOp.Summa < -1.00*cn_ContrMinSum ) )
          rSumLSNeg.SumN2F[wMonth] := rSumLSNeg.SumN2F[wMonth] + SumVidOp.Summa;
      }

      pFillSummaVDopTar(SumVidOp.Summa28, SumVidOp.Summa, wMonth, cnSummaN, rSumLS, rSumLSNeg);
      //заполнение расшифровки
      pFill_tp_SumCodeTar(rSumLS.cLsch, SumVidOp.cLsch, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], SumVidOp.Summa,
                          rSumLS.Prizn[wMonth], cn_SummaRas_Tar, SumVidOp.VidOpl, SumVidOp.VidOplP);
      continue;
    }

  }//_loop SumVidOp
  Timelog('RSV_1_FUNC->pSearhSum_LS:007');

  _loop Nachisl
  {
    if ( not fboCheckVidOpl(Nachisl.VidOpls) ) continue;

    if ( not boUchNullCexOZ )
      if ( Nachisl.CexOZ = comp(0) )
         continue;

    if ( not(boUchSum) ) continue;

    rSumLS.SumV[wMonth]   := rSumLS.SumV[wMonth]  + Nachisl.Summa;
    rSumLS.SumVF[wMonth]  := rSumLS.SumVF[wMonth] + Nachisl.Summa;
    if ( ( abs(Nachisl.Summa) > cn_ContrMinSum ) and ( Nachisl.Summa < -1.00*cn_ContrMinSum ) )
    {
      rSumLSNeg.SumV[wMonth]   := rSumLSNeg.SumV[wMonth]  + Nachisl.Summa;
      rSumLSNeg.SumVF[wMonth]  := rSumLSNeg.SumVF[wMonth] + Nachisl.Summa;
    }

    //заполнение расшифровки
    pFill_tp_SumCodeTar(rSumLS.cLsch, Nachisl.cLsch, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], Nachisl.Summa,
                        rSumLS.Prizn[wMonth], cn_SummaV_Tar, Nachisl.VidOplS, Nachisl.VidOpl);
    //заполнение сумм с подклассами
    pFillSummaVDopTar(Nachisl.Summa28, Nachisl.Summa, wMonth, cnSummaV, rSumLS, rSumLSNeg);

    if ( rSumLS.Prizn[wMonth] = 10 )
    //отчисления в ФФОМС не производятся
      rSumLS.SumN1F[wMonth] := rSumLS.SumN1F[wMonth] + Nachisl.Summa;

    // м а т п о м о щ ь
    if ( tp_Vidopl.VHVOE19 = 'М' and ( abs(doSumNY) > cn_ContrMinSum ) ) //м а т п о м о щ ь
    {
      doSum28MP  := Nachisl.Summa28;
      VidOplSMP  := Nachisl.VidOplS;
      VidOplPMP  := Nachisl.VidOpl;

      pAddSumNeobl(Nachisl.cLsch, Nachisl.Summa, Nachisl.Summa28, rSumLS, rSumLSNeg, doSum28MP, VidOplSMP, VidOplPMP);
      continue;
    } // if ( tp_Vidopl.VHVOE[19] = 'М' )

    //Учесть нормативы затрат для начислений по договорам отчуждения прав/авторским
    if ( fboboNeblNorm(coNachisl, rSumLS, rSumLSNeg) ) continue;

    // н е о б л а г а е м ы е суммы
    if ( fboSumNeobl(wPrizn) )
    {
      rSumLS.SumN1[wMonth]  := rSumLS.SumN1[wMonth]  + Nachisl.Summa;
      if ( ( abs(Nachisl.Summa) > cn_ContrMinSum ) and ( Nachisl.Summa < -1.00*cn_ContrMinSum ) )
        rSumLSNeg.SumN1[wMonth]  := rSumLSNeg.SumN1[wMonth]  + Nachisl.Summa;
      if ( rSumLS.Prizn[wMonth] <> 10 )
      {
        rSumLS.SumN1F[wMonth] := rSumLS.SumN1F[wMonth] + Nachisl.Summa;
        if ( ( abs(Nachisl.Summa) > cn_ContrMinSum ) and ( Nachisl.Summa < -1.00*cn_ContrMinSum ) )
          rSumLSNeg.SumN1F[wMonth] := rSumLSNeg.SumN1F[wMonth] + Nachisl.Summa;
      }
      pFillSummaVDopTar(Nachisl.Summa28, Nachisl.Summa, wMonth, cnSummaN, rSumLS, rSumLSNeg);
      //заполнение расшифровки
      pFill_tp_SumCodeTar(rSumLS.cLsch, Nachisl.cLsch, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], Nachisl.Summa,
                          rSumLS.Prizn[wMonth], cn_SummaNeobl_Tar, Nachisl.VidOplS, Nachisl.VidOpl);
      continue;
    }

    // расходы к вычету
    if ( fboSumNeoblRasx )
    {
      rSumLS.SumN2[wMonth]  := rSumLS.SumN2[wMonth]  + Nachisl.Summa;
      if ( ( abs(Nachisl.Summa) > cn_ContrMinSum ) and ( Nachisl.Summa < -1.00*cn_ContrMinSum ) )
        rSumLSNeg.SumN2[wMonth]  := rSumLSNeg.SumN2[wMonth]  + Nachisl.Summa;

      if ( rSumLS.Prizn[wMonth] <> 10 )
      {
        rSumLS.SumN2F[wMonth] := rSumLS.SumN2F[wMonth] + Nachisl.Summa;
        if ( ( abs(Nachisl.Summa) > cn_ContrMinSum ) and ( Nachisl.Summa < -1.00*cn_ContrMinSum ) )
          rSumLSNeg.SumN2F[wMonth] := rSumLSNeg.SumN2F[wMonth] + Nachisl.Summa;
      }
      pFillSummaVDopTar(Nachisl.Summa28, Nachisl.Summa, wMonth, cnSummaN, rSumLS, rSumLSNeg);
      //заполнение расшифровки
      pFill_tp_SumCodeTar(rSumLS.cLsch, Nachisl.cLsch, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], Nachisl.Summa,
                          rSumLS.Prizn[wMonth], cn_SummaRas_Tar, Nachisl.VidOplS, Nachisl.VidOpl);
      continue;
    }

  }//_loop Nachisl
  Timelog('RSV_1_FUNC->pSearhSum_LS:008');

  _loop NeNach
  {
    if ( not fboCheckVidOpl(NeNach.VidOpls) ) continue;

    if ( not boUchNullCexOZ )
      if ( NeNach.CexOZ = comp(0) )
         continue;

    if ( not(boUchSum) ) continue;

    rSumLS.SumV[wMonth]   := rSumLS.SumV[wMonth]  + NeNach.Summa;
    rSumLS.SumVF[wMonth]  := rSumLS.SumVF[wMonth] + NeNach.Summa;
    if ( ( abs(NeNach.Summa) > cn_ContrMinSum ) and ( NeNach.Summa < -1.00*cn_ContrMinSum ) )
    {
      rSumLSNeg.SumV[wMonth]   := rSumLSNeg.SumV[wMonth]  + NeNach.Summa;
      rSumLSNeg.SumVF[wMonth]  := rSumLSNeg.SumVF[wMonth] + NeNach.Summa;
    }
    //заполнение расшифровки
    pFill_tp_SumCodeTar(rSumLS.cLsch, NeNach.cLsch, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], NeNach.Summa,
                        rSumLS.Prizn[wMonth], cn_SummaV_Tar, NeNach.VidOplS, NeNach.VidOpl);

    //заполнение сумм с подклассами
    pFillSummaVDopTar(NeNach.Summa28, NeNach.Summa, wMonth, cnSummaV, rSumLS, rSumLSNeg);

    if ( rSumLS.Prizn[wMonth] = 10 )
    //отчисления в ФФОМС не производятся
    {
      rSumLS.SumN1F[wMonth] := rSumLS.SumN1F[wMonth] + NeNach.Summa;
      if ( ( abs(NeNach.Summa) > cn_ContrMinSum ) and ( NeNach.Summa < -1.00*cn_ContrMinSum ) )
        rSumLSNeg.SumN1F[wMonth] := rSumLSNeg.SumN1F[wMonth] + NeNach.Summa;
    }

    // м а т п о м о щ ь
    if ( tp_Vidopl.VHVOE19 = 'М' and ( abs(doSumNY) > cn_ContrMinSum ) ) //м а т п о м о щ ь
    {
      doSum28MP  := NeNach.Summa28;
      VidOplSMP  := NeNach.VidOplS;
      VidOplPMP  := NeNach.VidOpl;

      pAddSumNeobl(NeNach.cLsch, NeNach.Summa, NeNach.Summa28, rSumLS, rSumLSNeg, doSum28MP, VidOplSMP, VidOplPMP);
      continue;
    } // if ( tp_Vidopl.VHVOE[19] = 'М' )

    //Учесть нормативы затрат для начислений по договорам отчуждения прав/авторским
    if ( fboboNeblNorm(coNeNach, rSumLS, rSumLSNeg) ) continue;

    // н е о б л а г а е м ы е суммы
    if ( fboSumNeobl(wPrizn) )
    {
      rSumLS.SumN1[wMonth]  := rSumLS.SumN1[wMonth]  + NeNach.Summa;
      if ( ( abs(NeNach.Summa) > cn_ContrMinSum ) and ( NeNach.Summa < -1.00*cn_ContrMinSum ) )
        rSumLSNeg.SumN1[wMonth]  := rSumLSNeg.SumN1[wMonth]  + NeNach.Summa;
      if ( rSumLS.Prizn[wMonth] <> 10 )
      {
        rSumLS.SumN1F[wMonth] := rSumLS.SumN1F[wMonth] + NeNach.Summa;
        if ( ( abs(NeNach.Summa) > cn_ContrMinSum ) and ( NeNach.Summa < -1.00*cn_ContrMinSum ) )
          rSumLSNeg.SumN1F[wMonth] := rSumLSNeg.SumN1F[wMonth] + NeNach.Summa;
      }
      pFillSummaVDopTar(NeNach.Summa28, NeNach.Summa, wMonth, cnSummaN, rSumLS, rSumLSNeg);
      //заполнение расшифровки
      pFill_tp_SumCodeTar(rSumLS.cLsch, NeNach.cLsch, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], NeNach.Summa,
                          rSumLS.Prizn[wMonth], cn_SummaNeobl_Tar, NeNach.VidOplS, NeNach.VidOpl);
      continue;
    }

    // расходы к вычету
    if ( fboSumNeoblRasx )
    {
      rSumLS.SumN2[wMonth]  := rSumLS.SumN2[wMonth]  + NeNach.Summa;
      if ( ( abs(NeNach.Summa) > cn_ContrMinSum ) and ( NeNach.Summa < -1.00*cn_ContrMinSum ) )
        rSumLSNeg.SumN2[wMonth]  := rSumLSNeg.SumN2[wMonth]  + NeNach.Summa;

      if ( rSumLS.Prizn[wMonth] <> 10 )
      {
        rSumLS.SumN2F[wMonth] := rSumLS.SumN2F[wMonth] + NeNach.Summa;
        if ( ( abs(NeNach.Summa) > cn_ContrMinSum ) and ( NeNach.Summa < -1.00*cn_ContrMinSum ) )
          rSumLSNeg.SumN2F[wMonth] := rSumLSNeg.SumN2F[wMonth] + NeNach.Summa;
      }
      pFillSummaVDopTar(NeNach.Summa28, NeNach.Summa, wMonth, cnSummaN, rSumLS, rSumLSNeg);
      //заполнение расшифровки
      pFill_tp_SumCodeTar(rSumLS.cLsch, Nachisl.cLsch, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], Nachisl.Summa,
                          rSumLS.Prizn[wMonth], cn_SummaRas_Tar, NeNach.VidOplS, NeNach.VidOpl);
      continue;
    }
  }//_loop NeNach

  Timelog('RSV_1_FUNC->pSearhSum_LS:010');
  if (( abs(doSumNY) > cn_ContrMinSum ) and ( boUchSum ))
  {
    rSumLS.SumN1[wMonth]  := rSumLS.SumN1[wMonth]    + doSumNY;
    if ( ( abs(NeNach.Summa) > cn_ContrMinSum ) and ( NeNach.Summa < -1.00*cn_ContrMinSum ) )
      rSumLSNeg.SumN1[wMonth]  := rSumLSNeg.SumN1[wMonth]    + doSumNY;

    if ( rSumLS.Prizn[wMonth] <> 10 )
    //отчисления в ФФОМС не производятся
    {
      rSumLS.SumN1F[wMonth] := rSumLS.SumN1F[wMonth] + doSumNY;
      if ( ( abs(NeNach.Summa) > cn_ContrMinSum ) and ( NeNach.Summa < -1.00*cn_ContrMinSum ) )
        rSumLSNeg.SumN1F[wMonth] := rSumLSNeg.SumN1F[wMonth] + doSumNY;
    }

    pFillSummaVDopTar(doSum28MP, doSumNY, wMonth, cnSummaN, rSumLS, rSumLSNeg);
    //заполнение расшифровки
    pFill_tp_SumCodeTar(rSumLS.cLsch, Lschet.nRec, wMonth, rSumLS.wTarif[wMonth], rSumLS.Proc[wMonth], doSumNY,
                          rSumLS.Prizn[wMonth], cn_SummaNeobl_Tar, VidOplSMP, VidOplPMP);
    doSumNY  := 0;
    doSumNY0 := 0;
    doSumNY1 := 0;
    doSumNY2 := 0;
  }
  Timelog('RSV_1_FUNC->pSearhSum_LS:011');
}

//***********************************************************************
//  процедура поиска сумм страховых взносов по сотрудник
//***********************************************************************
procedure pSearhVzn_LS(wPrOsn: word; var rSumLS, rSumLSNeg: TSumLS);
var
  wLg_Scale
 ,wCatLgot_
 ,wPrizn
 ,VidPerStrah
 ,wMonth_    : word;

  doSumVznStr
 ,doSumNalSolB
 ,doSumtemp  : double;

  boStrahVzn : array [1..12] of boolean;

  doSumVB    : array [1..12] of double;  //суммы ограничения по месяцам
  _Buff      :tSumulsoc;
{
  Timelog('RSV_1_FUNC->pSearhVzn_LS:001');
  if ( wPrOsn = 1 )
  //основной лицевой счет
  {
    for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
    {
      rSumLS.wTarif[wMonth_] := wCodeTar_Main[wMonth_];
      wLgScale_LS[wMonth_]   := wScale;
    }
  }
  if ( YearRep <= 2014 )
  {
    // НАКОПИТЕЛЬНАЯ часть взносов
    sParam_    := cSocnalPaymentStoragePart;
    if ( GetFirst tp_Perech = tsOk )
      if ( GetFirst SumUlSoc = tsOk )
      {
        for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
        {
          doSumVznStr := SumUlSoc.sNal[wMonth_];
          rSumLS.SumVznStr[wMonth_]   := rSumLS.SumVznStr[wMonth_]  + doSumVznStr;
          if ( SumUlSoc.sNal[wMonth_] < -1*cn_ContrMinSum )
            rSumLSNeg.SumVznStr[wMonth_] := rSumLSNeg.SumVznStr[wMonth_]  + fdoGetNegSumVzn(SumUlSoc.cLsch, wMonth_, SumUlSoc.Vidper);
        }
      }

    // СТРАХОВАЯ часть взносов
    for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
    {
      doSumVB[wMonth_]    := 0;
      boStrahVzn[wMonth_] := false;
    }

    sParam_    := cSocnalPaymentInsurancePart;
    if ( GetFirst tp_Perech = tsOk )
      if ( GetFirst SumUlSoc = tsOk )
      {
        for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
        {
          doSumVznStr := SumUlSoc.sNal[wMonth_];
          wPrizn      := if ( word(SumUlSoc.Summa2[wMonth_]) = 3, 0, word(SumUlSoc.Summa2[wMonth_]));
          rSumLS.SumVznStr[wMonth_]      := rSumLS.SumVznStr[wMonth_]  + doSumVznStr;
          if ( SumUlSoc.sNal[wMonth_] < -1*cn_ContrMinSum )
            rSumLSNeg.SumVznStr[wMonth_] := rSumLSNeg.SumVznStr[wMonth_]  + fdoGetNegSumVzn(SumUlSoc.cLsch, wMonth_, SumUlSoc.Vidper);
          doSumVB[wMonth_]               := SumUlSoc.SumV[wMonth_];
          rSumLS.Prizn[wMonth_]          := if ( word(SumUlSoc.Summa2[wMonth_]) = 3, 0, word(SumUlSoc.Summa2[wMonth_]));
          rSumLS.Proc[wMonth_]           := SumUlSoc.Summa3[wMonth_];
          rSumLS.wTarif[wMonth_]         := fwGetTarLS(wPrizn, tp_Perech.VidPer, wMonth_, wLg_Scale, wCatLgot_);
          rSumLS.wCatLgot[wMonth_]       := wCatLgot_;
          wLgScale_LS[wMonth_]           := wLg_Scale;
          boStrahVzn[wMonth_]            := true;
        }
        VidPerStrah      := tp_Perech.VidPer;
      }

    // СОЛИДАРНАЯ часть взносов
    //сумму взносов по солидарной части необходимо отражать в отчете до предельного ограничения
    //в SumUlSoc.SNAL[i] хранится сумма налога со всей суммы дохода без учета ограничения
    //сумму дохода, с которой удерживаются взносы, определим из соответствующей суммы взносов по страховой
    //части, и уже от этой суммы определим сумму взносов по солидарной части с учетом ограничения
    sParam_ := cSocnalPaymentSolidPart;
    if ( GetFirst tp_Perech = tsOk )
      if ( GetFirst SumUlSoc = tsOk )
      {
        for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
        {
          rSumLS.SumVznStrP[wMonth_] := SumUlSoc.sNal[wMonth_];
!          if ( rSumLS.SumVznStrP[wMonth_] < -1.00*cn_ContrMinSum )
!             rSumLSNeg.SumNVznP[wMonth_] := fdoGetNegSumVzn(SumUlSoc.cLsch, wMonth_, SumUlSoc.Vidper);

          if ( not boStrahVzn[wMonth_] )
          {
            rSumLS.SumVznStr[wMonth_] := rSumLS.SumVznStr[wMonth_] + SumUlSoc.sNal[wMonth_];
          }
          else
          {
            //облагаемая база = 0, взносы не считаем
            if ( abs(doSumVB[wMonth_]) > cn_ContrMinSum )
            {
              doSumNalSolB               := Get_NalogSV(tp_Perech.VidPer, doSumVB[wMonth_], date(1, wMonth_, YearRep), 0, if ( rSumLS.Prizn[wMonth_] > 1, wLgScale_LS[wMonth_], wScale));
              rSumLS.SumVznStr[wMonth_]  := rSumLS.SumVznStr[wMonth_]      + doSumNalSolB;
              rSumLS.SumVznStrP[wMonth_] := SumUlSoc.sNal[wMonth_]         - doSumNalSolB;
!              if ( doSumNalSolB < -1*cn_ContrMinSum )
!                rSumLSNeg.SumNVzn := rSumLSNeg.SumNVzn + doSumNalSolB;
            }
          }
        }
      }
  }
  else
  {
   Timelog('RSV_1_FUNC->pSearhVzn_LS:002');
    sParam_ := cSocnalPaymentSolidPart;
    if ( GetFirst tp_Perech = tsOk )
    {
      if ( GetFirst SumUlSoc = tsOk )
      {
        for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
        {
          //проверка для расчёта будущего периода
          if ( YearRep = YearFut and wMonth_ = MonthFut ) continue;

          wPrizn := if ( word(SumUlSoc.Summa2[wMonth_]) = 3, 0, word(SumUlSoc.Summa2[wMonth_]));

          if ( wPrOsn = 1 )
          //основной лицевой счет
          {
            rSumLS.Prizn[wMonth_]      := wPrizn;
            rSumLS.Proc[wMonth_]       := SumUlSoc.Summa3[wMonth_];
            rSumLS.wTarif[wMonth_]     := fwGetTarLS(wPrizn, tp_Perech.VidPer, wMonth_, wLg_Scale, wCatLgot_);
            rSumLS.wCatLgot[wMonth_]   := wCatLgot_;
            wLgScale_LS[wMonth_]       := wLg_Scale;
          }

          //сумма превышения
          rSumLS.SumP[wMonth_]       := rSumLS.SumP[wMonth_]       + SumUlSoc.SUMMA4[wMonth_];
          if ( SumUlSoc.SUMMA4[wMonth_] < -1.00*cn_ContrMinSum )
            rSumLSNeg.SumP[wMonth_]  := rSumLSNeg.SumP[wMonth_]    + SumUlSoc.SUMMA4[wMonth_];
          //заполнение расшифровки
          pFill_tp_SumCodeTar(rSumLS.cLsch, SumUlSoc.cLsch, wMonth_, rSumLS.wTarif[wMonth_], rSumLS.Proc[wMonth_], SumUlSoc.SUMMA4[wMonth_],
                              rSumLS.Prizn[wMonth_], cn_SummaPrev_Tar, 0, 0);

          //сумма взносов с базы
          if ( YearRep < 2017 )
            doSumVznStr := Get_NalogSV(tp_Perech.VidPer, SumUlSoc.SumV[wMonth_], date(1, wMonth_, YearRep), 0, if ( wPrizn > 1, wLg_Scale, wScale))
          else
            doSumVznStr := Round(SumUlSoc.Summa9[wMonth_], 6);

          rSumLS.SumVznStr[wMonth_]   := rSumLS.SumVznStr[wMonth_]  + doSumVznStr;
          if ( doSumVznStr < -1.00*cn_ContrMinSum )
            rSumLSNeg.SumVznStr[wMonth_] := rSumLSNeg.SumVznStr[wMonth_]  + fdoGetNegSumVzn(SumUlSoc.cLsch, wMonth_, SumUlSoc.Vidper);

          //заполнение расшифровки
          pFill_tp_SumCodeTar(rSumLS.cLsch, SumUlSoc.cLsch, wMonth_, rSumLS.wTarif[wMonth_], rSumLS.Proc[wMonth_], doSumVznStr,
                              rSumLS.Prizn[wMonth_], cn_VznStrah_Tar, 0, 0);

        //сумма взносов с превышения
        if ( abs(SumUlSoc.SUMMA4[wMonth_]) > cn_ContrMinSum )
        {
          doSumtemp := Round(SumUlSoc.sNal[wMonth_], 6) - doSumVznStr;
          rSumLS.SumVznStrP[wMonth_]      := rSumLS.SumVznStrP[wMonth_]    + doSumtemp;
          pFill_tp_SumCodeTar(rSumLS.cLsch, SumUlSoc.cLsch, wMonth_, rSumLS.wTarif[wMonth_], rSumLS.Proc[wMonth_], doSumtemp,
                            rSumLS.Prizn[wMonth_], cn_VznPrev_Tar, 0, 0);
          if ( doSumtemp < -1.00*cn_ContrMinSum )
            rSumLSNeg.SumVznStrP[wMonth_] := rSumLSNeg.SumVznStrP[wMonth_] + doSumtemp;
        }
      }//for
    }
  }
  }//if ( YearRep > 2014 )
   Timelog('RSV_1_FUNC->pSearhVzn_LS:003');

  //сумма взносов Ф О М С
  if ( GetFirst SumUlSocFOMS = tsOk )
  {
    for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
    {
      //проверка для расчёта будущего периода
      if ( YearRep = YearFut and wMonth_ = MonthFut ) continue;

      if ( abs(SumUlSocFOMS.sNal[wMonth_]) > cn_ContrMinSum )
      {
        rSumLS.SumVznFOMS[wMonth_] := rSumLS.SumVznFOMS[wMonth_] + SumUlSocFOMS.sNal[wMonth_];
        if ( SumUlSocFOMS.sNal[wMonth_] < -1.00*cn_ContrMinSum )
          rSumLSNeg.SumVznFOMS[wMonth_] := rSumLSNeg.SumVznFOMS[wMonth_] + fdoGetNegSumVzn(SumUlSocFOMS.cLsch, wMonth_, SumUlSocFOMS.Vidper);
        //заполнение расшифровки
        pFill_tp_SumCodeTar(rSumLS.cLsch, SumUlSoc.cLsch, wMonth_, rSumLS.wTarif[wMonth_], rSumLS.Proc[wMonth_], SumUlSocFOMS.sNal[wMonth_],
                            rSumLS.Prizn[wMonth_], cn_SumVZNFoms_Tar, 0, 0);
      }
    }
  }
   Timelog('RSV_1_FUNC->pSearhVzn_LS:004');
  //проверка для расчёта будущего периода
  if ( YearRep = YearFut )
  {
    for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
    {
      if ( wMonth_ <> MonthFut ) continue;
      Timelog('RSV_1_FUNC->pSearhVzn_LS:004.001 '+string(wMonth_));

      if ( FillFot.GetSumUlsocBuf(LSchet.nRec, VidPer_FOMS, _Buff) )
      {
        rSumLS.SumVznFOMS[wMonth_] := rSumLS.SumVznFOMS[wMonth_] + _Buff.sNal[wMonth_];
      }

      Timelog('RSV_1_FUNC->pSearhVzn_LS:004.002 '+string(wMonth_));
      sParam_ := cSocnalPaymentSolidPart;
      if ( GetFirst tp_Perech = tsOk )
      {
       Timelog('RSV_1_FUNC->pSearhVzn_LS:004.003 '+string(wMonth_));
        if ( FillFot.GetSumUlsocBuf(LSchet.nRec, tp_Perech.VidPer, _Buff) )
        {
          wPrizn := if ( word(_Buff.Summa2[wMonth_]) = 3, 0, word(_Buff.Summa2[wMonth_]));

          if ( wPrOsn = 1 )
          //основной лицевой счет
          {
            rSumLS.Prizn[wMonth_]      := wPrizn;
            rSumLS.Proc[wMonth_]       := _Buff.Summa3[wMonth_];
            rSumLS.wTarif[wMonth_]     := fwGetTarLS(wPrizn, tp_Perech.VidPer, wMonth_, wLg_Scale, wCatLgot_);
            rSumLS.wCatLgot[wMonth_]   := wCatLgot_;
            wLgScale_LS[wMonth_]       := wLg_Scale;
          }

          //сумма превышения
          rSumLS.SumP[wMonth_]       := rSumLS.SumP[wMonth_]       + _Buff.SUMMA4[wMonth_];
          if ( _Buff.SUMMA4[wMonth_] < -1.00*cn_ContrMinSum )
            rSumLSNeg.SumP[wMonth_]  := rSumLSNeg.SumP[wMonth_]    + _Buff.SUMMA4[wMonth_];
          //заполнение расшифровки
       Timelog('RSV_1_FUNC->pSearhVzn_LS:004.004 '+string(wMonth_));
          pFill_tp_SumCodeTar(rSumLS.cLsch, _Buff.cLsch, wMonth_, rSumLS.wTarif[wMonth_], rSumLS.Proc[wMonth_], _Buff.SUMMA4[wMonth_],
                              rSumLS.Prizn[wMonth_], cn_SummaPrev_Tar, 0, 0);

          //сумма взносов с базы
          if ( YearRep < 2017 )
            doSumVznStr := Get_NalogSV(tp_Perech.VidPer, _Buff.SumV[wMonth_], date(1, wMonth_, YearRep), 0, if ( wPrizn > 1, wLg_Scale, wScale));
          else
            doSumVznStr := Round(_Buff.Summa9[wMonth_], 6);

       Timelog('RSV_1_FUNC->pSearhVzn_LS:004.005 '+string(wMonth_));
          rSumLS.SumVznStr[wMonth_]   := rSumLS.SumVznStr[wMonth_]  + doSumVznStr;
          if ( doSumVznStr < -1.00*cn_ContrMinSum )
            rSumLSNeg.SumVznStr[wMonth_] := rSumLSNeg.SumVznStr[wMonth_]  + fdoGetNegSumVzn(_Buff.cLsch, wMonth_, _Buff.Vidper);

          //заполнение расшифровки
       Timelog('RSV_1_FUNC->pSearhVzn_LS:004.006 '+string(wMonth_));
          pFill_tp_SumCodeTar(rSumLS.cLsch, _Buff.cLsch, wMonth_, rSumLS.wTarif[wMonth_], rSumLS.Proc[wMonth_], doSumVznStr,
                              rSumLS.Prizn[wMonth_], cn_VznStrah_Tar, 0, 0);

          //сумма взносов с превышения
          if ( abs(_Buff.SUMMA4[wMonth_]) > cn_ContrMinSum )
          {
            doSumtemp := Round(_Buff.sNal[wMonth_], 6) - doSumVznStr;
            rSumLS.SumVznStrP[wMonth_]      := rSumLS.SumVznStrP[wMonth_]    + doSumtemp;
            pFill_tp_SumCodeTar(rSumLS.cLsch, _Buff.cLsch, wMonth_, rSumLS.wTarif[wMonth_], rSumLS.Proc[wMonth_], doSumtemp,
                              rSumLS.Prizn[wMonth_], cn_VznPrev_Tar, 0, 0);
            if ( doSumtemp < -1.00*cn_ContrMinSum )
              rSumLSNeg.SumVznStrP[wMonth_] := rSumLSNeg.SumVznStrP[wMonth_] + doSumtemp;
          }
       Timelog('RSV_1_FUNC->pSearhVzn_LS:004.005 '+string(wMonth_));
        }
       Timelog('RSV_1_FUNC->pSearhVzn_LS:004.006 ');
      }
       Timelog('RSV_1_FUNC->pSearhVzn_LS:004.007 ');
    }
       Timelog('RSV_1_FUNC->pSearhVzn_LS:004.008 ');
  }

  Timelog('RSV_1_FUNC->pSearhVzn_LS:005');
  if (  VidDoc_ =  cnMainRazd6 and ( ZRepDocum.wTune[6] and 1 ) = 1 )
  //формируем основные сведения Раздела 6
  //учитывать д о н а ч и с л е н и я взносов
    pSearchDonach;
  Timelog('RSV_1_FUNC->pSearhVzn_LS:006');
} // procedure pSearhVzn_LS


public procedure pAddSumLs(cRecLschet: comp; var rSumLS: TSumLS; var rSumLSNeg: TSumLS);
var
  i
 ,wMonth_ : word;

  doTemp  : double;
{
  Timelog('RSV_1_FUNC->pAddSumLs:start');
  ClearAdvRecord(rSumLS);
  ClearAdvRecord(rSumLSNeg);
  cRecLschet1  := cRecLschet;
  if ( GetFirst Lschet <> tsOK ) exit;

  rSumLS.cLsch := cRecLschet1;
  Timelog('RSV_1_FUNC->pAddSumLs:001');
  pSearhVzn_LS(1, rSumLS, rSumLSNeg);
  Timelog('RSV_1_FUNC->pAddSumLs:001_01');
  for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
  {
    Timelog('RSV_1_FUNC->pAddSumLs:pSearhSum_LS  '+string(wMonth_));
    pSearhSum_LS(wMonth_, rSumLS, rSumLSNeg);
  }

  Timelog('RSV_1_FUNC->pAddSumLs:002');
  if ( rSumLS.wPrDopTar = 1 )
  {
    // заполнение tp_Perevod по спискам 1 и 2
    delete all tp_Perevod;
    pFill_tp_Perevod(cRecLschet, VidPer_Spis1);
    pFill_tp_Perevod(cRecLschet, VidPer_Spis2);
    ResetBounds(#Nachisl);
    ResetBounds(#NeNach);
    ResetBounds(#SumVidOp);
    PushBounds(tbbnNachisl);
    PushBounds(tbbnNeNach);
    PushBounds(tbbnSumVidOp);
    for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
    {
      pSearhSumVznDopTar_LS(wMonth_, rSumLS, rSumLSNeg);
    }
    PopBounds(tbbnNachisl);
    PopBounds(tbbnNeNach);
    PopBounds(tbbnSumVidOp);
    SetBounds(#Nachisl);
    SetBounds(#NeNach);
    SetBounds(#SumVidOp);
  }
  Timelog('RSV_1_FUNC->pAddSumLs:003');

  if ( liCountM_Dg > 0 )
  {
    for (  i := 0; i < liCountM_Dg; inc(i) )
    {
      if ( GetMarker(MarkerVidOplDog, i, cRecOplDog) )
      {
        if ( getFirst tp_VidOplDog  = tsOk )
        {
          for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
          {
            rSumLS.SumBDog[wMonth_] := rSumLS.SumBDog[wMonth_] + fdoGetSumBase(wMonth_, doTemp);
            if ( doTemp < -1*cn_ContrMinSum )
              rSumLSNeg.SumBDog[wMonth_] := rSumLSNeg.SumBDog[wMonth_] + doTemp;
          }
        }
      }
    }
  }

  Timelog('RSV_1_FUNC->pAddSumLs:004');
  if ( APAI.First(cRecLschet) )
  {
    do
    {
      cRecLschet1 := APAI.GetAdjacent;
      if ( GetFirst Lschet = tsOK )
      {
        pSearhVzn_LS(0, rSumLS, rSumLSNeg);
        for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
        {
          pSearhSum_LS(wMonth_, rSumLS, rSumLSNeg);
        }

        if ( rSumLS.wPrDopTar = 1 )
        {
          // заполнение tp_Perevod по спискам 1 и 2
          delete all tp_Perevod;
  Timelog('RSV_1_FUNC->pAddSumLs:if ( rSumLS.wPrDopTar = 1 )');
          pFill_tp_Perevod(cRecLschet1, VidPer_Spis1);
          pFill_tp_Perevod(cRecLschet1, VidPer_Spis2);
          ResetBounds(#Nachisl);
          ResetBounds(#NeNach);
          ResetBounds(#SumVidOp);
          PushBounds(tbbnNachisl);
          PushBounds(tbbnNeNach);
          PushBounds(tbbnSumVidOp);
          for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
          {
            pSearhSumVznDopTar_LS(wMonth_, rSumLS, rSumLSNeg);
          }
          PopBounds(tbbnNachisl);
          PopBounds(tbbnNeNach);
          PopBounds(tbbnSumVidOp);
          SetBounds(#Nachisl);
          SetBounds(#NeNach);
          SetBounds(#SumVidOp);
        }

        if ( liCountM_Dg > 0 )
        {
  Timelog('RSV_1_FUNC->pAddSumLs:if ( liCountM_Dg > 0 )');
          for (  i := 0; i < liCountM_Dg; inc(i) )
          {
            if ( GetMarker(MarkerVidOplDog, i, cRecOplDog) )
            {
              if ( getFirst tp_VidOplDog  = tsOk )
              {
                for ( wMonth_ := wMonthBegPer; wMonth_ <= wMonthEnd; inc(wMonth_) )
                {
                  rSumLS.SumBDog[wMonth_] := rSumLS.SumBDog[wMonth_] + fdoGetSumBase(wMonth_, doTemp);
                  if ( doTemp < -1*cn_ContrMinSum )
                    rSumLSNeg.SumBDog[wMonth_] := rSumLSNeg.SumBDog[wMonth_] + doTemp;
                }
              }
            }
          }
        }
      }
    }
    while APAI.Next;
  }//if ( APAI.First(cRecLschet) )
  Timelog('RSV_1_FUNC->pAddSumLs:finish');
}  // public procedure pAddSumLs


end. // interface
