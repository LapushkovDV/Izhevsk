/*************************************************************************************************\
* Наименование:  Расчет страховых взносов на резерв в разрезе видов оплат                         *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3048          |10/07/18|Ермолов К.Р.             |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih

interface gp_sverstrah 'Параметры отчета' gray
Show at (,,33,9);

table struct t_sotr
(
tabnum: string,
fio: string,
vidopl: longint,
nalog: decimal(31,15),
rez: decimal(31,15),
rezotpusk: decimal(31,15)
)
with index
(
i1 = tabnum + fio + vidopl (unique)
)
;

table struct t_vidop
(
vidopl: longint,
nalog: decimal(31,15),
rez: decimal(31,15),
rezotpusk: decimal(31,15)
)
with index
(
i1 = vidopl (unique)
)
;

create view

var
excelpath: string;
counter, countermatrix: longint;
mes, filtr: word;
god: integer;
sumnalog, sumrez, sumrezotpusk, proc1, proc2: double;

as select t_vidop.vidopl
from t_vidop, t_sotr, perech
where ((13 == perech.vidper));

screen scr ('Параметры отчета',,sci1Esc);
  fields
  filtr : [list
           1 'По сотрудникам',
           2 'По видам оплат'], protect;
  mes : [list
        1 'Январь',
        2 'Февраль',
        3 'Март',
        4 'Апрель',
        5 'Май',
        6 'Июнь',
        7 'Июль',
        8 'Август',
        9 'Сентябрь',
        10 'Октябрь',
        11 'Ноябрь',
        12 'Декабрь'], protect;
  god: noprotect, spinbutton [1, 1917, 2117];
  proc1: [4.2], noprotect;
  proc2: [4.2], noprotect;
  buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Фильтр:     .@@@@@@@@@@@@@
    Месяц:      .@@@@@@@@@@
    Год:        .@@@@@
    % отч. для ФОТ       .@@@@
    % отч. для стр.взн.  .@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  mes:= month(cur_date);
  god:= year(cur_date);
  filtr:= 1;
  proc1:= perech.procper;
  proc2:= 30.2;
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);
  ExcelPath:= TranslatePath('%ClientStartPath%');

  sumnalog:= 0;
  sumrez:= 0;
  sumrezotpusk:= 0;

  if filtr = 1
  {
    delete all from t_sotr;

    sql
    select lschet.strtabn, persons.fio, klvidopl.vidoplp, sum(nachislzakaz.summa)/100*:(proc2), sum(nachislzakaz.summa)/100*:(proc1),  (sum(nachislzakaz.summa)/100*:(proc1))/100*:(proc2)
    from mnplan
    left join buhschet on buhschet.nrec = mnplan.canval2
    left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7
    inner join lschet ls on nachislzakaz.clsch=ls.nrec
    inner join klvidopl on klvidopl.vidopl = nachislzakaz.vidopls
    inner join attrval on attrval.crec = klvidopl.nrec
    inner join attrnam on attrnam.nrec = attrval.cattrnam and attrnam.name = '908 Фонд Резерв (ОВР)'
    left join lschet on lschet.nrec = nachislzakaz.clsch
    left join persons on persons.nrec = lschet.tperson
    left join katpodr on katpodr.nrec = nachislzakaz.cexoz
    inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
    where nachislzakaz.mesn = :(mes) and nachislzakaz.yearn = :(god)
    and ( (ls.dates[2]=0) or (ls.dates[2]<>0 and d_month(ls.dates[2])<nachislzakaz.mesn and (d_year(ls.dates[2])<nachislzakaz.yearn or d_year(ls.dates[2])=nachislzakaz.yearn)) )
    group by lschet.strtabn, persons.fio, klvidopl.vidoplp
    into t_sotr
    ;

    xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_sverstrah1.xlsx',true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

    xlsetcellstringvalue('РАСЧЕТ СТРАХОВЫХ ВЗНОСОВ НА РЕЗЕРВ В РАЗРЕЗЕ ВИДОВ ОПЛАТ ЗА ' + mes + ' МЕСЯЦ ' + god + ' ГОДА', 1, 1, 1, 1);

    xlCreateMatrix(500, 6);
    countermatrix:= 0;
    counter:= 3;

    _loop t_sotr
    {
      countermatrix++;
      sumnalog:= sumnalog + t_sotr.nalog;
      sumrez:= sumrez + t_sotr.rez;
      xlStWriteToMatrix(countermatrix, 1, t_sotr.tabnum);
      xlStWriteToMatrix(countermatrix, 2, t_sotr.fio);
      xlDoWriteToMatrix(countermatrix, 3, t_sotr.vidopl);
      xlDoWriteToMatrix(countermatrix, 4, t_sotr.nalog);
      xlDoWriteToMatrix(countermatrix, 5, t_sotr.rez);
      if t_sotr.rez = 0
      {
        xlDoWriteToMatrix(countermatrix, 6, 0);
      }
      else
      {
        sumrezotpusk:= sumrezotpusk + t_sotr.rezotpusk;
        xlDoWriteToMatrix(countermatrix, 6, t_sotr.rezotpusk);
      }

      if countermatrix = 500
      {
        xlWriteMatrixToExcel(counter, 1);
        counter:= counter + countermatrix;
        xlClearMatrix;
        countermatrix:= 0;
      }
    }

    xlWriteMatrixToExcel(counter, 1);
    counter:= counter + countermatrix;
    xlFreeMatrix;

    xlsetfontstyle(1, counter, 1, counter, 6);
    xlmergecells(counter, 1, counter, 3);
    xlAlignCells(-4152, counter, 1, counter, 1);
    xlsetcellstringvalue('ИТОГО', counter, 1, counter, 1);
    xlsetcellstringvalue(sumnalog, counter, 4, counter, 4);
    xlsetcellstringvalue(sumrez, counter, 5, counter, 5);
    xlsetcellstringvalue(sumrezotpusk, counter, 6, counter, 6);

    xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 6);
  }

  if filtr = 2
  {
    delete all from t_vidop;

    sql
    select klvidopl.vidoplp, sum(nachislzakaz.summa)/100*:(proc2), sum(nachislzakaz.summa)/100*:(proc1),  (sum(nachislzakaz.summa)/100*:(proc1))/100*:(proc2)
    from mnplan
    left join buhschet on buhschet.nrec = mnplan.canval2
    left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7
    inner join lschet ls on nachislzakaz.clsch=ls.nrec
    inner join klvidopl on klvidopl.vidopl = nachislzakaz.vidopls
    inner join attrval on attrval.crec = klvidopl.nrec
    inner join attrnam on attrnam.nrec = attrval.cattrnam and attrnam.name = '908 Фонд Резерв (ОВР)'
    left join lschet on lschet.nrec = nachislzakaz.clsch
    left join persons on persons.nrec = lschet.tperson
    left join katpodr on katpodr.nrec = nachislzakaz.cexoz
    inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)
    where nachislzakaz.mesn = :(mes) and nachislzakaz.yearn = :(god)
    and ( (ls.dates[2]=0) or (ls.dates[2]<>0 and d_month(ls.dates[2])<nachislzakaz.mesn and (d_year(ls.dates[2])<nachislzakaz.yearn or d_year(ls.dates[2])=nachislzakaz.yearn)) )
    group by klvidopl.vidoplp
    into t_vidop
    ;

    xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_sverstrah2.xlsx',true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

    xlsetcellstringvalue('СВЕРКА НАЛОГОВ ЗА ' + mes + ' МЕСЯЦ ' + god + ' ГОДА', 1, 1, 1, 1);

    xlCreateMatrix(50, 4);
    countermatrix:= 0;
    counter:= 3;

    _loop t_vidop
    {
      countermatrix++;
      sumnalog:= sumnalog + t_vidop.nalog;
      sumrez:= sumrez + t_vidop.rez;
      xlDoWriteToMatrix(countermatrix, 1, t_vidop.vidopl);
      xlDoWriteToMatrix(countermatrix, 2, t_vidop.nalog);
      xlDoWriteToMatrix(countermatrix, 3, t_vidop.rez);
      if t_vidop.rez = 0
      {
        xlDoWriteToMatrix(countermatrix, 4, 0);
      }
      else
      {
        sumrezotpusk:= sumrezotpusk + t_vidop.rezotpusk;
        xlDoWriteToMatrix(countermatrix, 4, t_vidop.rezotpusk);
      }

      if countermatrix = 50
      {
        xlWriteMatrixToExcel(counter, 1);
        counter:= counter + countermatrix;
        xlClearMatrix;
        countermatrix:= 0;
      }
    }

    xlWriteMatrixToExcel(counter, 1);
    counter:= counter + countermatrix;
    xlFreeMatrix;

    xlsetfontstyle(1, counter, 1, counter, 4);
    xlAlignCells(-4152, counter, 1, counter, 1);
    xlsetcellstringvalue('ИТОГО', counter, 1, counter, 1);
    xlsetcellstringvalue(sumnalog, counter, 2, counter, 2);
    xlsetcellstringvalue(sumrez, counter, 3, counter, 3);
    xlsetcellstringvalue(sumrezotpusk, counter, 4, counter, 4);

    xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 4);
  }

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_sverstrah Implements IUserReport;
Interface UserReport_sverstrah;

Procedure Run;
Begin
  runinterface(gp_sverstrah);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Расчет страховых взносов на резерв в разрезе видов оплат';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Сверка результатов распределения';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
