#include userreport.vih

Interface GP_SverNaryadTabForeSis20 'Сверка нарядов и табелей по сдельной оплате труда' gray dialog;
show (, , 100, 15);

/* sql select top 10 Persons.STRTABN, Persons.FIO
from lschet
inner join Persons on lschet.tPerson = Persons.nRec
inner join LSTAB on lschet.nRec = LSTAB.CLSCHET
inner join PRNARYAD on lschet.nRec = PRNARYAD.CLSCH
where lschet.Sisopl=20 and Persons.ISEMPLOYEE = 'С'
;  */ 


Table struct mtRepNar
(
 strTabN: string[20]
,FIO: string[100]
,sCEX: string[100]
,D: Date
,CHF: double
,sNARYAD: string[100]

) with index (i1=strTabN);

create view vNar
var 
D0 : Date;
pYEARN: integer;
pMESN, LastDay, iD: word;
select lschet.nrec

from lschet , Persons, LSTAB, PRNARYAD, SYS_NAR, KATPODR, mtRepNar
where
((
	     'С' == Persons.ISEMPLOYEE
and Persons.nRec == lschet.tPerson and (lschet.Sisopl=20)

and   lschet.nRec == LSTAB.CLSCHET
       and pYEARN == LSTAB.YEARN
       and pMESN  == LSTAB.MESN

and   lschet.nRec == PRNARYAD.CLSCH
!// and D0 <<= PRNARYAD.DATAN (noindex)
!// and D0 >>= PRNARYAD.DATOK (noindex)
and PRNARYAD.MNREC == SYS_NAR.nRec

AND SYS_NAR.CEX == KATPODR.NREC
and root == mtRepNar.strTabN
))
;

Screen scrParam ;
table lschet;
fields
  pMESN      : noprotect;
  pYEARN     : noprotect;

  buttons
    cmOk, default,, '~В~вод ', hcOkHelp, sci1Esc;

<<

     `За` .@@@ `месяц` .@@@@ `года`


     <. Сформировать .>

>>

 end;
	
HandleEvent
 CmInit:{
   pMESN := 10 ;//Month(Cur_Date);
   pYearN := 2018;//Year(Cur_Date);
        }
CmOk:
{
   delete all mtRepNar;

  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Выборка данных ...', 100);
   LastDay := Last_Day(Date(01,pMESN,pYEARN));

   _LOOP Persons
   _LOOP lschet
   _Loop LSTAB
   for(iD:=1; iD <= LastDay; iD++)
   if LSTAB.DAYCHF[iD] > 0  and  LSTAB.DAYCHF[iD] < 24.999
   {
     D0 := Date(iD,pMESN,pYEARN);
     var sNar: string ='';

     _LOOP PRNARYAD
     if D0 >= PRNARYAD.DATAN
     if D0 <= PRNARYAD.DATOK
     _LOOP SYS_NAR
     {
        if sNar = '' sNar := SYS_NAR.NMNEM
        else
        if Instr(SYS_NAR.NMNEM,sNar) = 0
        sNar := sNar +', '+ SYS_NAR.NMNEM;
     }

    insert into mtRepNar set
                mtRepNar.strTabN := Persons.STRTABN
               ,mtRepNar.FIO     := Persons.FIO
               ,mtRepNar.sCex    := KatPodr.KOD+ ' ' + KatPodr.NAME
               ,mtRepNar.D       := D0 
               ,mtRepNar.CHF     := LSTAB.DAYCHF[iD]
               ,mtRepNar.sNARYAD := sNAR
              ;
     
   }
SetVisualHeader('Выгрузка в Excel');
var FName: string = GetStringParameter('Files','OutputFilesDirectory',0) + 'mtRepNar.xls';
DeleteFile(FName);

vNar.PutTableToDBF (#mtRepNar,FName,0);


  if (not ExistFile(FName))
  { message('Не файла "'+FName+'"',error);
  }
  else
  if (not xlCreateExcelWithTemplate(FName,true))
  {
       Message('Ошибка открытия файла: "' + FName + '"');
  }
  else
  {

#define _xlOut(_Col,_S)    xlSetCellStringValue(#_S,1,#_Col,1,#_Col);
     #_xlOut(1,'Таб №')  // strTabN: string[20] 
     #_xlOut(2,'ФИО')    //,FIO: string[100]
     #_xlOut(3,'Цех')    //,sCEX: string[100]
     #_xlOut(4,'Дата')   //,D: Date
     #_xlOut(5,'Часов')  //,CHF: double
     #_xlOut(6,'Наряды') //,sNARYAD: string[100]
     
     xlkillExcel;
  }

 StopVisual('',0);

}
end;
end.


VipInterface UserReport_zpSverNTSis20 Implements IUserReport;
Interface UserReport_zpSverNTSis20;

Procedure Run;
Begin
  runinterface(GP_SverNaryadTabForeSis20);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Сверка нарядов и табелей по сдельной оплате труда';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
