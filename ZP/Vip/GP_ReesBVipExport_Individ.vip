#component "GP_ZP"
#include GP_ReesBVipExportObj.vih
#include GP_FRFormatterOfReestr.vih

interface GP_ReesBVipExport_Individ;
var pGP_FRForm: GP_FRFormatterOfReestr;
create view
as select * from
  KatOrg
, KatOrgDescr, KatOrgDescr KatOrgDescr2
, SbBan
;

property GP_ReesBVipExportObj.Caption: string read 'Индивидуальный';
function ChooseReesToApply(mRee: TPtr): TPtr;
var m: TPtr;
    i: longint;
    cRec: comp;
    sCode: string;
{
  m := InitMarker('', 8, 1, 1);
  for (i := 0; i < GetMarkerCount(mRee); i++)
  {
    GetMarker(mRee, i, cRec);
    if getfirst SbBan where ((cRec == SbBan.NRec)) = tsOk
      _loop KatOrgDescr where ((SbBan.cPol == KatOrgDescr.cRec))
        if getfirst KatOrgDescr2 where ((KatOrgDescr.cGroup == KatOrgDescr2.NRec)) = tsOk
        {
          sCode := SubStr(Trim(KatOrgDescr2.Name), 1, 3);
          if sCode = '01.' or sCode = '08.'
          {
            InsertMarker(m, cRec);
            break;
          }
        }
  }
  Result := m;
}

function Export(cRec: comp; sPath: string; var fileName: string): boolean;
var sGrZ: string;
    ATTR_SB_VPLAN: comp;
{
  Result := false;
  if sPath[length(sPath)] <> '\' sPath += '\';
  ATTR_SB_VPLAN:=ExtAttr_ID(coSBBAN,'Группа заказов');
  if getfirst SbBan where ((cRec == SbBan.NRec)) <> tsOk
    exit;
  fileName := '-нет-';
  if getfirst KatOrg where ((SbBan.cPol == KatOrg.NRec)) = tsOk
    fileName := 'Инд_' + ExtractWord(1, KatOrg.Name, ' ');
  sGrZ := sGetAttrID(coSbBan, SbBan.Nrec, ATTR_SB_VPLAN);
  if sGrz <> ''
    fileName += '_' + sGrz;

  if not ExistFile(sPath + fileName + '.PDF')
    fileName += '.PDF';
  else
  {
    var ii: byte = 1;
    While ExistFile(sPath + fileName  + '_' + LPadCh(ii, '0', 2) + '.PDF')
      ii++;
    fileName += LPadCh(ii, '0', 2) + '_' + LPadCh(ii, '0', 2) + '.PDF';
  }
  var sPrim: string = '';
  case SbBan.Prefix of
    //Зарплата
    'R$Z', 'R#Z': sPrim := 'за 2 половину ' + DateToStr(SbBan.DataN, 'mon YYYY г.');
    //Аванс
    'R$A', 'R#A': sPrim := 'за 1 половину ' + DateToStr(SbBan.DataN, 'mon YYYY г.');
    //Отпуск, Больничный
    'RO', 'RB': sPrim := 'отпускных/больничных за ' + DateToStr(SbBan.DataN, 'month YYYY г.');
    //МатПомощь
    'RV': sPrim := 'единовременной выплаты мобилизованному за ' + DateToStr(SbBan.DataN, 'month YYYY г.');
  end;
  if sPrim <> ''
  {
    if sGrZ <> '' sPrim += ' ' + sGrZ;
    sSetAttr(coSbBan, SbBan.NRec, 'Примечание', sPrim);    
  }
  sSetAttr(coSbBan,SbBan.NRec,'Имя файла',fileName);

  pGP_FRForm.RunPDFBatch(cRec, 'GP Индивидуальный Счет', sPath + fileName);
  Result := true;
}
end.
