#doc
Добавление пунктов меню модуля "Заработная плата" - основное, локальные меню интерфейсов
#end

handler with replace GP_MenuDynamic_AddItems_MenuZarp on ExtensionPoint GP_MenuDynamic_AddItems
action
{
  result:=true;
  timelog_init;
  var MenuID:longint=0;
  MenuID:=0;
  //-------------------------------------
  DeleteMenuHowDynamics('Z_MENU::menuzarp');
  DeleteMenuHowDynamics('Z_Menu::zarnastr');
  DeleteMenuHowDynamics('Z_MENU::MEGPER');

  DeleteMenuHowDynamics('Z_Menu::Reports');
  DeleteMenuHowDynamics('Z_CALC::KlVidopl_HotKeys');
  DeleteMenuHowDynamics('Z_Lschet::Lschet_HotKeys');
  DeleteMenuHowDynamics('Z_Lschet::Lschet_DopInf');
  DeleteMenuHowDynamics('Z_MENU::PaymentsPopup');
  DeleteMenuHowDynamics('Z_KATPODR::mnuKatPodr');
  //-------------------------------------

  _try {
    //------------------------------------------------------------
    //Добавление подменю в модуле заработная плата  - настройка
    //------------------------------------------------------------
    timelog('Z_Menu::zarnastr');
    MenuID:=LoadMenuEx('Z_Menu::zarnastr',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddSubMenuDynamic(MenuID,'GP_ZP::GP_ZarNastr',sGetTune('NPOEM_OWN.OWNMNU'),'','')
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_Menu::zarnastr'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню модуля "Заработная плата - Настройки"'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }

  //-------------------------------------
  // Z_Menu::Reports
  //-------------------------------------
  _try {
    //------------------------------------------------------------
    //Добавление подменю в модуле заработная плата  - настройка
    //------------------------------------------------------------
    timelog('Z_Menu::Reports');
    MenuID:=LoadMenuEx('Z_Menu::Reports',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddSubMenuDynamic(MenuID,'GP_ZP::GP_ZarReports',sGetTune('NPOEM_OWN.OWNMNU'),'','')
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_Menu::Reports'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню модуля "Заработная плата - Отчеты"'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }
  //------------------------------------
  //Z_CALC##KLVIDOPL - локальное меню
  //------------------------------------
  MenuID:=0;
  _try {
    timelog('Z_CALC::KlVidopl_HotKeys');
    MenuID:=LoadMenuEx('Z_CALC::KlVidopl_HotKeys',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddMenuItemEx(MenuID,'Распределение по заказам'
              ,'Распределение по заказам',hcHotKeySaveDoc,cmValue60,0)//kbCtrlF2);
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_CALC::KlVidopl_HotKeys'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню модуля "Заработная плата - Настройки"'#13+
              ExploreException,error);
    }
  _finally {
     if (MenuID<>0) DisposeLoadMenu(MenuID);
  }




  //------------------------------------------------------------
  //Добавление подменю в модуле заработная плата  - отчеты - реестры по перечислениям
  //------------------------------------------------------------

  MenuID:=0;
  _try {
    timelog('Z_PayRep::RegistersPopUp1');
    MenuID:=LoadMenuEx('Z_PayRep::RegistersPopUp1',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddSubMenuDynamic(MenuID,'GP_ZP::EM_REESTR_HotKeys_SUMMIR',sGetTune('NPOEM_OWN.OWNMNU'),'','')
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_PayRep::RegistersPopUp1'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню модуля "Заработная плата  - отчеты - реестры по перечислениям  "'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }

  //------------------------------------------------------------
  //Добавление подменю в модуле заработная плата  - операции  - реестры межрасчетного периода
  //------------------------------------------------------------

  MenuID:=0;
  _try {
    timelog('Z_PayRep::TreeRees_1_HotKeys');
    MenuID:=LoadMenuEx('Z_PayRep::TreeRees_1_HotKeys',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddSubMenuDynamic(MenuID,'GP_ZP::EM_REESTR_HotKeys_SUMMIR',sGetTune('NPOEM_OWN.OWNMNU'),'','')
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_PayRep::TreeRees_1_HotKeys'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню модуля "Заработная плата  - операции  - реестры межрасчетного периода  "'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }
  //------------------------------------------------------------
  //Добавление подменю в модуле заработная плата  - лицевые счета - локальное меню
  //------------------------------------------------------------
  MenuID:=0;
  _try {
    timelog('Z_Lschet::Lschet_HotKeys');
    MenuID:=LoadMenuEx('Z_Lschet::Lschet_HotKeys',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddSubMenuDynamic(MenuID,'GP_ZP::GP_Lschet_HotKeys_Rasp','Распределение','','')
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_Lschet::Lschet_HotKeys'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню модуля "Заработная плата - лицевые счета - локальное меню"'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }

  //------------------------------------------------------------
  //Добавление подменю в модуле заработная плата  - лицевые счета - редактирование - локальное меню
  //------------------------------------------------------------
  MenuID:=0;
  _try {
    timelog('Z_Lschet::Lschet_DopInf');
    MenuID:=LoadMenuEx('Z_Lschet::Lschet_DopInf',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddSubMenuDynamic(MenuID,'GP_ZP::GP_Lschet_HotKeys_Rasp','Распределение','','')
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_Lschet::Lschet_DopInf'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню модуля "Заработная плата - лицевые счета - локальное меню"'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }

  //------------------------------------------------------------
  //Добавление подменю в модуле заработная плата  - операции
  //------------------------------------------------------------
  MenuID:=0;
  _try {
    timelog('Z_MENU::MEGPER');
    //MenuID:=LoadMenuEx('Z_MENU::menuzarp',false,true);
    MenuID:=LoadMenuEx('Z_MENU::MEGPER',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddSubMenuDynamic(MenuID,'GP_ZP::GP_Avans',sGetTune('NPOEM_OWN.OWNMNU'),'','')
    {
      _raise ExAddMenuItemError;
    }
    //if (not StoreMenuHowDynamics(MenuID,'Z_MENU::MEGPER'))
    if (not StoreMenuHowDynamics(MenuID,'Z_MENU::MEGPER'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню модуля "Заработная плата - операции - локальное меню"'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }

  //------------------------------------------
  // Операции - расчет - Выплаты в межпериод - Редактирование - локальное меню
  // Разработка  |#1810

  //------------------------------------------
  MenuID:=0;
  _try {
    timelog('Z_MENU::PaymentsPopup');
    //MenuID:=LoadMenuEx('Z_MENU::menuzarp',false,true);
    MenuID:=LoadMenuEx('Z_MP::PaymentsPopup',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddMenuItemEx(MenuID,'Копирование записи'
              ,'Копирование текущей записи записи, заданное кол-во раз',hcHotKeySaveDoc,cmValue60,0)//kbCtrlF2);
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_MP::PaymentsPopup'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню модуля "Заработная плата - операции - локальное меню"'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }


  //SR00029721
  MenuID:=0;
  _try
  {
    MenuID:=LoadMenuEx('Z_KATPODR::mnuKatPodr', false, true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddMenuItemEx(MenuID,'Настройка связей с функц. компл.'
              ,'Настройка связей с функц. компл.', '', cmValue66, 0)
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_KATPODR::mnuKatPodr'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:
    {
      Message('Ошибка регистрации меню модуля "Заработная плата - Настройки"'#13+
              ExploreException,error);
    }
  _finally
  {
     if (MenuID <> 0) DisposeLoadMenu(MenuID);
  }

} //handler with replace


#doc
Удаление пунктов меню модуля "Заработная плата"
#end
handler with replace GP_MenuDynamic_DelItems_MenuZarp on ExtensionPoint GP_MenuDynamic_DelItems
action
{
  result:=true;

  DeleteMenuHowDynamics('Z_Menu::zarnastr');
  DeleteMenuHowDynamics('Z_Menu::Reports');
  DeleteMenuHowDynamics('Z_CALC::KlVidopl_HotKeys');
  DeleteMenuHowDynamics('Z_Lschet::Lschet_HotKeys');
  DeleteMenuHowDynamics('Z_Lschet::Lschet_DopInf');
  DeleteMenuHowDynamics('Z_Menu::MEGPER');
  DeleteMenuHowDynamics('Z_MENU::PaymentsPopup');
  DeleteMenuHowDynamics('Z_KATPODR::mnuKatPodr');
}
