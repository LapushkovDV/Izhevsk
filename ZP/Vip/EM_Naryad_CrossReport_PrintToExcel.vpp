
function CreateExcel (FExcelName : string) : boolean;
{
  StartNewVisual(vtRotateVisual, vfBreak+vfTimer, 'Инициализация EXCEL', 1);
    result := true;

    DeleteFile(FExcelName);

    if (not xlCreateExcel(FExcelName, true))
    {
      message('ОШИБКА! Не удалось инициализировать сессию Excel', Error);
      xlKillExcel;
      result := false;
      exit;
    }

    if (not xlIsExcelValid)
    {
      message('ОШИБКА! Не удалось инициализировать сессию Excel', Error);
      xlKillExcel;
      result := false;
      exit
    }
  var xlCount : word;
  xlCount := 0;
   Do
   {
    xlGetSheetsCount(xlCount);
    xlDeleteSheet(xlCount);
   } while xlCount > 2

  if xlCount < 2 then xlAddSheet;
   StopVisual('',0);
}
Procedure MyPrintMatrixToExcel(var nrow, nrowReal : longint);
{
 if nrow = 100 then
  {
   xlWritematrixToExcel(nrowReal,1);
   xlclearMatrix;
   nrowReal := nrowReal + nrow;
   nrow := 0;
  }
}
#declare PrintFiltrs
   nrow++;

 case _fTypeRep of
  0: xlStWriteToMatrix(nrow, 1,'!!!!ПРЕДВАРИТЕЛЬНЫЙ!!!!');
  1: xlStWriteToMatrix(nrow, 1,'!!!!ОКОНЧАТЕЛЬНЫЙ!!!!');
 end;
   nrow++;
var _FiltrStr : string ='' ;
 xlStWriteToMatrix(nrow, column,'Фильтры:');

   nrow++;
   xlStWriteToMatrix(nrow, column,'Подразделения');
   MyPrintMatrixToExcel(Nrow,NrowReal);
 _loop tfPodr
   {
     _FiltrStr := _FiltrStr + ' | ' +tfPodr.Kod;
     if length(_FiltrStr ) > 230 then
      {
       nrow++;
       xlStWriteToMatrix(nrow, column,_FiltrStr);
       MyPrintMatrixToExcel(Nrow,NrowReal);
       _FiltrStr := '';
      }
   }
   nrow++;
   xlStWriteToMatrix(nrow, column,_FiltrStr);
   MyPrintMatrixToExcel(Nrow,NrowReal);

   nrow++;
   xlStWriteToMatrix(nrow, column,'Статус наряда:');
   MyPrintMatrixToExcel(Nrow,NrowReal);

  _FiltrStr := '';
 _loop tfStatus
 {
     _FiltrStr := _FiltrStr + ' | ' +tfStatus.name ;
     if length(_FiltrStr ) > 230 then
      {
       nrow++;
       xlStWriteToMatrix(nrow, column,_FiltrStr);
       MyPrintMatrixToExcel(Nrow,NrowReal);
       _FiltrStr := '';
      }
 }
   nrow++;
   xlStWriteToMatrix(nrow, column,_FiltrStr);
   MyPrintMatrixToExcel(Nrow,NrowReal);


nrow++;
nrow++;
#end
Procedure PrintSheet_AllNaryad;
{

  xlCreateMatrix(100,17);

  var Nrow0,nrow0FrameBold, Nrow, column, nrowreal : longint;
 nrowreal := 1;
 Nrow := column := 1;


 xlStWriteToMatrix(nrow, column,'');

/*
  Добавьте вывод фильтров в отчет
*/

 xlStWriteToMatrix(nrow, 1,'Кросс-отчет по нарядам/список нарядов за период с '+datetostr(_fDateB,'DD/MM/YYYY')+' по '+datetostr(_fDateE,'DD/MM/YYYY'));
 xlMergeCells(nrow,column,nrow,column+5);
 xlSetFontStyle(1,nrow,1,nrow,10);
 nrow++;
 nrow++;
 column := 1;

#PrintFiltrs


 xlSetColumnWidth(15,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Номер наряда'); column++;
 xlSetColumnWidth(20,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Статус'); column++;
 xlSetColumnWidth(12,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Подразделение'); column++;
 xlSetColumnWidth(12,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Часы'); column++;
 xlSetColumnWidth(12,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Год'); column++;
 xlSetColumnWidth(12,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'месяц'); column++;
 xlSetColumnWidth(12,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'День создания (учетная дата)'); column++;
 xlSetColumnWidth(12,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Система-источник'); column++;
 xlSetColumnWidth(20,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Текущее расположение');
// Nrow++;
 column := 1;
// xlSetFontStyle(1,nrow,1,nrow,10);

 MyPrintMatrixToExcel(Nrow,NrowReal);
 _Loop tReport
 {
   var _column : word = 1;
   nrow++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tReport.Number    );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.Status    );  _column++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tReport.PodrKod   );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.totalChasF);  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.year      );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.month     );  _column++;
    xldtWriteToMatrix(nrow, _column, tReport.day       );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.SystemSrc );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.Location  );

   setvisualHeader('Печать отчета'+
    +''#13''+tReport.Number);
   MyPrintMatrixToExcel(Nrow,NrowReal);

 }
 xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB, xlMedium, xlContinuous, 0, 2, 1, nrow+nrowreal-1, 9);
 xlSetNumberFormat('# ##0,00',2, 4, nrow+nrowreal-1, 4);
 xlWriteMatrixToExcel(NrowReal,1);

}


Procedure PrintSheet_SvodNaryad;
{

  xlCreateMatrix(100,17);

  var Nrow0,nrow0FrameBold, Nrow, column, nrowreal : longint;
 nrowreal := 1;
 Nrow := column := 1;


 xlStWriteToMatrix(nrow, column,'');

/*
  Добавьте вывод фильтров в отчет
*/

 xlStWriteToMatrix(nrow, 1,'Кросс-отчет по нарядам/СВОД нарядов за период с '+datetostr(_fDateB,'DD/MM/YYYY')+' по '+datetostr(_fDateE,'DD/MM/YYYY'));
 xlMergeCells(nrow,column,nrow,column+5);
 xlSetFontStyle(1,nrow,1,nrow,10);
 Nrow++;
 Nrow++;
 column := 1;

#PrintFiltrs

 xlSetColumnWidth(15,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'День'); column++;
 xlSetColumnWidth(12,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'План ВП'); column++;
 xlSetColumnWidth(12,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Факт ВП'); column++;
 xlSetColumnWidth(12,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'% выполнения'); column++;

// Nrow++;
 column := 1;
// xlSetFontStyle(1,nrow,1,nrow,10);

 MyPrintMatrixToExcel(Nrow,NrowReal);
 _Loop tReportSvod
 {
   var _column : word = 1;
   nrow++;
    xlDtWriteToMatrix(nrow, _column, tReportSvod.Day    );  _column++;
    xlDoWriteToMatrix(nrow, _column, tReportSvod.planVP  );  _column++;
    xlDoWriteToMatrix(nrow, _column, tReportSvod.FactVP  );  _column++;
    xlDoWriteToMatrix(nrow, _column, 100*tReportSvod.FactVP/tReportSvod.planVP  );  _column++;

   setvisualHeader('Печать отчета'+
    +''#13''+tReportSvod.Day );
   MyPrintMatrixToExcel(Nrow,NrowReal);

 }
 xlSetNumberFormat('# ##0,00',2, 2, nrow+nrowreal-1, 4);
 xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB, xlMedium, xlContinuous, 0, 2, 1, nrow+nrowreal-1, 4);
 xlWriteMatrixToExcel(NrowReal,1);
}

Procedure PrintToExcel;
{
  var _excelFile :string = GetStringParameter('Files','TmpFilesDirectory',0)+'EM_Naryad_CrossReport_'+UserName+'_'+DateToStr(Cur_Date,'YYYYMMDD')+'_'+TimeToStr(Cur_Time,'HHMMSS')+'.xlsx';
  if not CreateExcel(_excelFile)
    then {Stop; Abort; exit;}


  StartNewVisual(vtRotateVisual, vfBreak+vfTimer, 'Формирование отчета', 1);

    xlSetActiveSheet(1);
    xlSetSheetName(1, 'Список нарядов _'+UserName);
    PrintSheet_AllNaryad;
    xlSetActiveSheet(2);
    xlSetSheetName(2, 'Очет сводный _'+UserName);
    PrintSheet_SvodNaryad;

 xlSaveWorkBookByName(_excelFile);
 xlKillExcel;
 StopVisual('',0);
}
