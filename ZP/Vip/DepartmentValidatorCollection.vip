#component "Z_KATPODR"

#include DepartmentValidatorCollection.vih
interface DepartmentValidatorCollection;

var
  _validators: array[0..0] of IDepartmentValidator;
  _cnt: longint = 0;

procedure Add(validator: IDepartmentValidator);
{
  _validators[_cnt] := validator;
  _cnt++;
}

function Remove(validator: IDepartmentValidator): boolean;
{
  result := false;

  var i: longint;
  i := FindItem(_validators, validator);

  if i >= 0 and i < _cnt
    result := ArrAtDelete(_validators, i);
}

function Find(validator: IDepartmentValidator): boolean;
{
  result := FindItem(_validators, validator) >= 0;
}

end.
