/*************************************************************************************************\
* Наименование:  Инвентаризация резерва на отпуск                                                 *
* Контур/Модуль: Кадры                                                                            *
* Примечание:    Формирует бухсправку с корректирующими проводками для выравнивания резерва на 96 *
*                счете с данными из модуля Управление персоналом (Оценочные обязательства)        *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#0000         |25/08/18|Евдокимов М.А.           |НПО Энергомаш                    *
* Разработка  |#0000         |21/01/21|kurennykh                |НПО Энергомаш                    *
\*************************************************************************************************/
#include Query.vih
#include GetKau.vih
#include aTuneIer.vih
#include Plpor.vih
#include PlporSimple.vih
#include AtlProtocol.vih
#include MainLschetForPersons.vih

#component "GP_ZP"

interface GP_InvVacationReserve 'Инвентаризация резерва на отпуск' escClose;
show(,,150,);

const
  PLPOR_TIDK = 10;
  PLPOR_TIDKGAL = 10;
  PICKREP_WLIST_MNPLAN = 1;
end;

table struct tSaldo96 (
  TblOs      : array[1..6] of word,
  KauOs      : array[1..6] of comp,
  KodSpo     : comp,
  SumS       : double
) with index (
  i01 = KauOs[1] + KauOs[2] + KodSpo
);

table struct tInv (
  StrTabN : string[20],
  FIO     : string[60],
  PodrCode: string[100],
  PodrName: string,
  cPerson : comp,
  cPodr   : comp,
  SumBuhD : double,
  SumBuhK : double,
  NalBuhD : double,
  NalBuhK : double,
  SumStaff: double,
  NalStaff: double,
  SumDelta: double,
  NalDelta: double
) with index (
 i01 = FIO + PodrCode
);

table struct tRaspr (
  wType   : word, //Тип записи: 0-распределение по сотруднику, 1-распределение по подразделению
  cRec    : comp, //Если wType = 0 - ссылка на сотрудника, если wType = 1 - ссылка на подразделение
  cRezerv : comp,
  SchetO  : string[21],
  SubOsSch: string[21],
  TblOs   : array[1..6] of word,
  KauOs   : array[1..6] of comp,
  KodSpo  : comp,
  SumOb   : double
) with index (
  i01 = wType + cRec + cRezerv
);

var
  _getKau      : GetKau;          //объект для выбора аналитик
  _plporSimple : PlporSimple;     //объект для формирования бухсправки
  _mlfp        : MainLSchetForPersons; //объект для получения лицевого счета по сотруднику
  _protocol    : IAtlProtocol(AtlProtocol) new; //протокол для вывода сообщений
  _dInv        : date;            //дата инвентаризации
  _cPlansSch   : comp;            //план счетов для анализа проводок
  cgKau_Rezerv : word;            //код аналитики Резервы
  _cRezervOtp  : comp;            //Аналитика 96 счета Резервы 'Резерв (фактический) отпуск'
  _cRezervNal  : comp;            //Аналитика 96 счета Резервы 'Резерв (фактический) отпуск Налоги'
  _cKatPodrEM  : comp;            //Подразделение Энергомаш
  _plPorNrec   : comp;            //nrec созданной платежки
  _cRezerv     : comp;            //Резерв для формирования проводок (отпуск/налоги)
  _tRasp_wType : word;            //Вид записи в таблице tRaspr (0-по сотрудникам, 1-по подразделениям)
  _tRasp_cRec  : comp;            //Ссылка на сотрудника/подразделение в таблице tRaspr
  _lschetNrec  : comp;
  _cLSKatPodr  : comp;
  //_cOwnFil     : comp;
create view
  (RezervOtpFld,
   RezervNalFld,
   KatPodrEMFld)
as select
  ShowKau(cgKau_Rezerv, _cRezervOtp),
  ShowKau(cgKau_Rezerv, _cRezervNal),
  ShowKau(cgKau_KatPodr, _cKatPodrEM)
from
  tSaldo96,
  tRaspr,
  UserDeskRep,
  PickRep PickRepMnPlan,
  PlansSch,
  BuhSchet BuhSchet96,
  PlPor,
  SoprHoz,
  LSchet,
  KatPodr LSKatPodr,
  KatKau,
  SpKau,
  tInv,
  Oborot,
  KatPodr
where ((
      _cRezerv             == tSaldo96.KauOs[2]
  and tInv.cPerson         == tSaldo96.KauOs[1]
  and tInv.cPodr           == tSaldo96.KodSpo

  and _tRasp_wType         == tRaspr.wType
  and _tRasp_cRec          == tRaspr.cRec
  and _cRezerv             == tRaspr.cRezerv

  and cgGP_Report_21002    == UserDeskRep.NRep
  and ''                   == UserDeskRep.OwnName

  and UserDeskRep.Nrec     == PickRepMnPlan.cUserDeskRep
  and PICKREP_WLIST_MNPLAN == PickRepMnPlan.wList

  and _cPlansSch           == PlansSch.Nrec
  and PlansSch.Kod + '96'  == BuhSchet96.Schet
  and '01'                   == BuhSchet96.SubSch

  and _plPorNrec           == PlPor.Nrec

  and PlPor.TiDk           == SoprHoz.TipDoc
  and PlPor.Nrec           == SoprHoz.cSoprDoc

  and _lschetNrec               == LSchet.Nrec
  and _cLSKatPodr               == LSKatPodr.Nrec
));
;

//******************************************************************************
//#region Визуальная часть

window wParameters 'Параметры' escClose doAccept;
  show(,,63, 15);

  screen scParameters (,,sciEn13Esc);
    show(,,,7) fixed_y;
    fields
      PlansSch.Name ('План счетов для анализа проводок'): protect, pickbutton;
      RezervOtpFld ('Аналитика 96 счета Резервы "Резерв (фактический) отпуск"'): protect, pickbutton;
      RezervNalFld ('Аналитика 96 счета Резервы "Резерв (фактический) отпуск Налоги"'): protect, pickbutton;
      KatPodrEMFld ('Подразделение "Энергомаш"'): protect, pickbutton;
<<

`План счетов`              .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Резерв "отпуск"`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Резерв "отпуск Налоги"`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Подразделение "Энергомаш"`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

Заказы, на которые не распределять корректировку резерва
>>
  end;

  browse brExclMnPlan (,,sci1378Esc);
    show(,8,,);
    table PickRepMnPlan;
    fields
      [ExclMnPlanFld] ShowKau(cgKau_Zakaz, PickRepMnPlan.cRec) 'Исключаемый заказ': protect, pickbutton;
  end;

  tableevent table PickRepMnPlan;
    cmInsertRecord: insert current PickRepMnPlan;
    cmUpdateRecord: update current PickRepMnPlan;
    cmDeleteRecord: delete current PickRepMnPlan;
    cmPick:
    {
      var c: comp = PickRepMnPlan.cRec;
      var cnt: longint = _getKau.GetCodeKau(cgiMulti, cgKau_Zakaz, c);
      if cnt = 1
        set PickRepMnPlan.cRec := c;
      else if cnt > 1
      {
        var m: TPtr = InitMarker(_getKau.GetMarkerName(cgKau_Zakaz), 8, 10, 10, false);
        GetMarker(m, 0, c);
        set PickRepMnPlan.cRec := c;
        UpDateTable;
        var i: longint;
        for (i := 1; GetMarker(m, i, c); i++)
        {
          ClearBuffer(tnPickRepMnPlan);
          PickRepMnPlan.cRec := c;
          Insert current PickRepMnPlan;
        }
        DoneMarker(m, '');
      }
      RescanPanel(#PickRepMnPlan);
    }
  end;

  handleevent

    cmPick:
    {
      case curfield of
        #PlansSch.Name:
        {
          var c: comp = PlansSch.Nrec;
          if RunInterface(F_PLANSSCH::GetPlansSchEx, c, cgiPick) = cmDefault
          {
            set _cPlansSch := c;
            RereadRecord;
          }
        }
        #RezervOtpFld:
        {
          var c: comp = _cRezervOtp;
          if _getKau.GetCodeKau(cgiPick, cgKau_Rezerv, c) > 0
          {
            set _cRezervOtp := c;
            ReReadRecord;
          }
        }
        #RezervNalFld:
        {
          var c: comp = _cRezervNal;
          if _getKau.GetCodeKau(cgiPick, cgKau_Rezerv, c) > 0
          {
            set _cRezervNal := c;
            ReReadRecord;
          }
        }
        #KatPodrEMFld:
        {
          var c: comp = _cKatPodrEM;
          if _getKau.GetCodeKau(cgiPick, cgKau_KatPodr, c) > 0
          {
            set _cKatPodrEM := c;
            ReReadRecord;
          }
        }
      end;
    }

  end; //handleevent window wParameters

end; //window wParameters

screen sc1;
  show (,,,2) fixed_y;
  fields
    _dInv: noprotect;
  buttons
    cmRefreshInv, default;
    cmCreateBuhSpr;
    cmParameters;
<<
`Дата инвентаризации`.@@@@@@@@@@ <. Обновить .> <. Сформировать бухсправку .> <. Настройки .>
>>
end;

browse br1;
  show(,3,,);
  table tInv;
  fields
    tInv.StrTabN   '','Табельный','номер'                : [10], protect;
    tInv.FIO       '','','ФИО'                           : [20], protect;
    tInv.PodrCode  '','Код','подразделения'              : [10], protect;
    tInv.PodrName  '','Наименование','подразделения'     : [20], protect;
    tInv.SumBuhD   'Зарплата','96 cчет','Дебет'          : [12,'\2p[|-]3666`666`666`666.88'], protect, browseSum;
    tInv.SumBuhK   'Зарплата','96 cчет','Кредит'         : [12,'\2p[|-]3666`666`666`666.88'], protect, browseSum;
    tInv.NalBuhD   'Налоги','96 cчет','Дебет'            : [12,'\2p[|-]3666`666`666`666.88'], protect, browseSum;
    tInv.NalBuhK   'Налоги','96 cчет','Кредит'           : [12,'\2p[|-]3666`666`666`666.88'], protect, browseSum;
    tInv.SumStaff  'Зарплата','оценочные','обязательства': [12,'\2p[|-]3666`666`666`666.88'], protect, browseSum;
    tInv.NalStaff  'Налоги','оценочные','обязательства'  : [12,'\2p[|-]3666`666`666`666.88'], protect, browseSum;
    tInv.SumDelta  'Зарплата','корректировка',''         : [12,'\2p[|-]3666`666`666`666.88'], protect, browseSum;
    tInv.NalDelta  'Налоги','корректировка',''           : [12,'\2p[|-]3666`666`666`666.88'], protect, browseSum;
end;

