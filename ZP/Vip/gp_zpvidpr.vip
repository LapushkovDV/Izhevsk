handleevent

cmInit:
{
  pUserName:= UserName();
  mes:= month(dgettune('UP.DATOTCH'));
  god:= year(dgettune('UP.DATOTCH'));
  podr:= '¥ ¢ë¡à ­®';

  sql
  select katpodr.nrec, katpodr.kod, katpodr.name
  from katpodr
  inner join zar_user on (upper(zar_user.ownname) = upper(:(pUserName)))
  where length(katpodr.kod) = 3 and (zar_user.podrshare <> '+' or (katpodr.nrec in (select userrights.crecds from userrights where zar_user.ownname = userrights.ownname)))
  into tSelPodr
  ;
}

cmPick:
{
  if curfield = #podr
  {
    runwindow(wnSelPodr);
  }
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, '”®à¬¨à®¢ ­¨¥ ®âç¥â ...', 1);

  sqlDropTmpTable ('tSelPodrUser');
  sqlCreateTmpTable('table tSelPodrUser (nrec: comp) with index (i1 = nrec);', ctmNormal);

  SubBounds(tbRmtSelPodr1);
  AddBounds(tbRmtSelPodr2);

  _loop pMarkerpodr
  {
    cpodr:= tSelPodr.nrec;

    stmt := sqlAllocStmt;
    ClearQuery(vliSQLCommand);
    PrepareSQLQuery('insert into tSelPodrUser (nrec) values (#comp('+string(cpodr)+')) ');
    ExecDSQLex(0);
  }

  SubBounds(tbRmtSelPodr2);
  AddBounds(tbRmtSelPodr1);

  delete all from otchet;

  ClearQuery(vliSQLCommand);
  PrepareSQLQuery('select attrval.vstring, sumvidop.kateg, lschet.sovm, sum(sumvidop.summa)');
  PrepareSQLQuery('from sumvidop');
  PrepareSQLQuery('left join lschet on lschet.nrec = sumvidop.clsch');
  PrepareSQLQuery('left join katpodr on katpodr.nrec = sumvidop.cexoz');
  PrepareSQLQuery('inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)');
  PrepareSQLQuery('left join attrval on attrval.crec = katpodr.nrec and attrval.cattrnam = #comp(0001000000000167h) and attrval.wtable = 1413');
  PrepareSQLQuery('where sumvidop.yearn = '+god+' and sumvidop.mesn = '+mes+' and (sumvidop.kateg <> 0 and sumvidop.kateg <> 8) and sovm <> 5');
  PrepareSQLQuery('and attrval.vstring <> ''ƒ ¥¯à®¬ëè«¥­­ ï £àã¯¯  à áå®¤®¢'' and attrval.vstring <> ''¡é¥å®§ï©áâ¢¥­­ë¥ à áå®¤ë''');
  PrepareSQLQuery('and attrval.vstring <> ''”¨«¨ «ë ”¨«¨ «ë'' and attrval.vstring <> ''ˆ'' and (katpodr1.nrec in (select tSelPodrUser.nrec from tSelPodrUser))');
  PrepareSQLQuery('group by attrval.vstring, sumvidop.kateg, lschet.sovm');
  stmt:=0;
  stmt := sqlAllocStmt;
  wErr:=ExecDSQLex(tnotchet);

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_Œ\ZP\gp_zpvidpr.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  xlSetActiveSheet(1);

!  xlSetSheetName(1, '”’ ¯® ãà®¢­î ­ ª« ¤­ëå à áå®¤®¢'):

  if getfirst otchet = tsok
  {
    xlsetcellstringvalue('ˆâ®£® ' + otchet.vidpr, 3, 1, 3, 1);
