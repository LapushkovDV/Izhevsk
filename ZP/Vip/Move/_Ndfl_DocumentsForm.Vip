// Заплатка на 2НДФЛ
// в справку идут доходы с сиcтемным типом <100
// после установки патчей проверить
// Байшев Андрей Владимирович 114 вид оплат
// 2012 2014 - коды 109,110
#component "Z_Report"
Alter Interface Ndfl_DocumentsForm;
OverLoad
function fboSysCode1_100: boolean;
//procedure pFill_tp_VidOpl;
function fsGetCode(var sCodeSkid: s5): s5;

end;
function fboSysCode1_100: boolean;
{
  case tp_Vidopl.SysCode of
  1..100:
  {
    fboSysCode1_100 := true;
  }
#IFDEF _GP_
  109,110:
  {
    fboSysCode1_100 := true;
  }
#ENDIF
  else
  {
    fboSysCode1_100 := false;
  }
  end;
} //function fboSysCode1_100: boolean;

function fsGetCode(var sCodeSkid: s5): s5;
{ Result:=Inherited::fsGetCode(sCodeSkid);
  case tp_Vidopl.SysCode of
  109 : Result:='2013';
  110 : Result:='2014';
  end;
}
