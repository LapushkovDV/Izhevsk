#include GP_Protector.vih
#include GP_SumVidUd.vih

#include GP_ZSumVidUd.vih
interface GP_ZSumVidUd;

var S_Yeark, S_Mes: integer;
    S_VidUd: word;

Create view ZSumVidUd
bounds GP_PrMesN = LS_Nrec == SumVidUd.cLsch and
                   S_Yeark == SumVidUd.YEARN and S_Mes == SumVidUd.MESN;

Parameters S_Yeark,S_Mes,S_VidUd;

HandleEvent
cmInit:{
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  var p:GP_Protector;
  p.LinkTo(cfsGetCurrentContainerSelf, '');
  p.ProtectedStatusCtx := sci1EnEsc;
  p.AutoPalette := true;
  p.SetProtected(true);

  AddBounds(tbGP_PrMesN);
  if (getfirst SumVidUd
      where((
        LS_Nrec == SumVidUd.cLsch and S_VidUd == SumVidUd.VIDUD and
        S_Yeark == SumVidUd.YEARN and S_Mes == SumVidUd.MESN
      ))=tsok) {};
}
cmDefault:{
  RunInterfaceNoModal('GP_SumVidUd', LS_Nrec, TabNom, LS_Cex, SUMVIDUD.NREC, p2);
}
cmDelOnProtect:{
  abort;
}
end;

end.
