/*************************************************************************************************\
* Наименование: Интерфейс просмотра нарядов                                                       *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:  Заработная плата -> Операции -> НПО "Энергомаш" -> Просмотр нарядов                *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#0000         |01/09/18|Евдокимов М.А.           |НПО Энергомаш                    *
* Разработка  |#3895         |30/01/19|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/

#include GP_QualityCostsHelper.vih
#include DepTree.vih
#include GP_Naryad2PotrTrud.Vih

#component "GP_ZP"

//*************************************************************
Interface GP_NariadView 'Просмотр нарядов "Энергомаш"' escclose;
//*************************************************************

//********************************************
table struct tChoice (
  Choice: word,
  Name: string
) with index (
  i01 = Choice
);

//********************************************
#include GP_Naryad2PotrTrud.Var

//********************************************
var
  _qualityCostsHelper: GP_QualityCostsHelper; //Хэлпер для работы с затратами на качество
  _mAvailableDepartments: TPtr;
  _Shablon_TrudPotr     :comp; //NPOEM_OWN.ZP.NARYAD.EXPORT.Shablon
//********************************************
create view
  var
    _SysNarNrec: comp;
as select
  if (IsValid(tnKatPodr), Trim(LTrim(KatPodr.Kod + ', ' + KatPodr.Name, ',')), '')
    (fieldname = DepartmentStr),
  Sys_Nar.SummaNar + Sys_Nar.SummaPrem
    (fieldname = TotalSum),
  Time2StrDef(tTotals.ChasF)
    (fieldname=TotalChasF),
  Time2StrDef(PrNaryad.NrmTime)
    (fieldname=NrmTimeFld),
  Time2StrDef(PrNaryad.ChasF)
    (fieldname=ChasFFld),
  Time2StrDef(GP_PrNaryad_Ext.NrmTimePZ)
    (fieldname=NrmTimePZFld),
  _qualityCostsHelper.sPrichNesootv(coSys_Nar, Sys_Nar.Nrec)
    (fieldname=PrichNesootv),
  _qualityCostsHelper.sShZK(coSys_Nar, Sys_Nar.Nrec)
    (fieldname=ShZK),
  GetSurnameWithInitials(Persons.FIO)
    (fieldname = WorkerName),
  if(isValid(tntChoiceSys_Nar), tChoiceSys_Nar.Name, '')
    (fieldname = ChoiceFld)
from
  Sys_Nar,
  ( select
      Sum(PrNaryadSum.ChasF) (fieldName=ChasF)
    from
      PrNaryad PrNaryadSum
    where ((
      Sys_Nar.Nrec /== PrNaryadSum.MNrec
    ))
  ) tTotals,
  tChoice tChoiceAllowed,
  tChoice tChoiceSys_Nar,
  X$Users,
  KatPodr,
  PrNaryad (PRNARYAD06),
  GP_PrNaryad_Ext,
  Persons,
  KlVidOpl,
  MnPlan,
  Catalogs,
  tChoice
where ((
  Sys_Nar.Atl_LastUser  == x$Users.Atl_Nrec          and
  Sys_Nar.Cex           == KatPodr.Nrec              and
  Sys_Nar.Choice        == tChoiceSys_Nar.Choice     and
  Sys_Nar.Nrec          == PrNaryad.MNrec            and
  PrNaryad.Nrec         == GP_PrNaryad_Ext.cPrNaryad and
  PrNaryad.tPerson      == Persons.Nrec              and
  PrNaryad.VidOpl       == KlVidOpl.VidOpl           and
  PrNaryad.cKauD[1]     == MnPlan.Nrec               and
  PrNaryad.cPodr        == Catalogs.Nrec
))
bounds BySysNarChoice = Root == Sys_Nar.Nrec and (FoundMarker(_mAvailableDepartments, Sys_Nar.Cex)) and
                        Sys_Nar.Choice /== tChoiceAllowed.Choice
bounds BySysNarNrec = _SysNarNrec == Sys_Nar.Nrec;

DataStream dsNariad
(
  table Sys_Nar
  (
    [NMnem]        Sys_Nar.NMnem;
    [DataN]        Sys_Nar.DataN;
    [DatOk]        Sys_Nar.DatOk;
    [CheckDate]    Sys_Nar.CheckDate;
    [Cex]          DepartmentStr;
    [SummaNar]     Sys_Nar.SummaNar;
    [SummaPrem]    Sys_Nar.SummaPrem;
    [TotalSum]     TotalSum;
    [TotalChasF]   TotalChasF;
    [Creator]      x$Users.XU$FullName;
    [ShZK]         ShZK;
    [PrichNesootv] PrichNesootv;
    table PrNaryad
    (
      [WorkerName] WorkerName;
      [ProfName]   Catalogs.Name;
      [StrTabN]    PrNaryad.StrTabN;
      [PersRazr]   GP_PrNaryad_Ext.PersRazr;
      [KTY]        PrNaryad.KTY * 100;
      [TPs]        GP_PrNaryad_Ext.TPs;
      [ZNP]        GP_PrNaryad_Ext.ZNP;
      [DSEName]    GP_PrNaryad_Ext.DSEName;
      [OperName]   GP_PrNaryad_Ext.OperName;
      [KolVo]      PrNaryad.KolVo;
      [KolVoGodn]  GP_PrNaryad_Ext.KolVoGodn;
      [OperRazr]   GP_PrNaryad_Ext.OperRazr;
      [GrOpl]      GP_PrNaryad_Ext.GrOpl;
      [NrmTime]    PrNaryad.NrmTime;
      [Rascen]     PrNaryad.Rascen;
      [NrmTimePZ]  GP_PrNaryad_Ext.NrmTimePZ;
      [RascenPZ]   GP_PrNaryad_Ext.RascenPZ;
      [Summa]      PrNaryad.Summa;
      [Proc]       PrNaryad.Proc;
      [SummPrem]   PrNaryad.SummPrem;
      [VidOplP]    KlVidOpl.VidOplP;
      [ChasF]      PrNaryad.ChasF;
      [Zakaz]      MnPlan.Number;
    );
  );
)
end;

Procedure PrintDoc;
{
  _SysNarNrec := Sys_Nar.Nrec;
  PushPos(tnSys_Nar);
  if BoundActive(tbBySysNarChoice)
    SubBounds(tbBySysNarChoice);
  if not BoundActive(tbBySysNarNrec)
    AddBounds(tbBySysNarNrec);
  RunFReport(dsNariad, '', true);
  SubBounds(tbBySysNarNrec);
  AddBounds(tbBySysNarChoice);
  PopPos(tnSys_Nar);
}

procedure AddChoice(wChoice: word; sName: string);
{
  insert tChoice set tChoice.Choice := wChoice, tChoice.Name := sName;
}


//============================================
// Установка статуса наряда
//--------------------------------------------
procedure SetCurSysNarChoice(wChoice: word);
{
  if wChoice != Sys_Nar.Choice
  { update current Sys_Nar set Sys_Nar.Choice := wChoice;
    //------- #3895 ----------------
    if Sys_Nar.Choice=3
    if _Shablon_TrudPotr>0
    { pGP_Naryad2PotrTrud.ExportNaryad(Sys_Nar.Nrec,1,false);
    } //if Sys_Nar.Choice=3
  }
  RescanPanel(tnSys_Nar);
} //procedure SetCurSysNarChoice(wChoice: word);

function InsertDepartmentIntoMarker(B: TKatPodr): boolean;
{
  InsertMarker(_mAvailableDepartments, B.Nrec);
  result := true;
}

window wndChoice 'Cтатус' escclose, doaccept, cyan;
  show(,,40,5);
  browse brChoice;
    table tChoice;
    fields
      tChoice.Name 'Наименование': [10], Protect;
  end;
end; //window wndChoice

browse brSysNar ( , , sci1Esc);
  table Sys_Nar;
  fields
    Sys_Nar.NMnem        '', 'Наименование'                           ('Наименование наряда'):   [30], Protect;
    Sys_Nar.DataN        '', 'Начало'                         ('Период наряда - дата начала'):   [10], Protect;
    Sys_Nar.DatOk        '', 'Окончание'                   ('Период наряда - дата окончания'):   [10], Protect;
    DepartmentStr        '', 'Подразделение'                                ('Подразделение'):   [18], Protect;
    TotalSum             'Сумма', 'заработка'                                       ('Всего'): [11,2], NoAutosize, Protect;
    TotalChasF           'Нормо-', 'часы'                                      ('Нормо-часы'):    [8], Right, Protect;
    x$Users.XU$FullName  '', 'Создатель'                     ('Пользователь создавший наряд'):   [20], Protect;
    Sys_Nar.CheckDate    '', 'Проверен'                              ('Дата проверки наряда'):   [11], Protect, NoAutosize;
    ChoiceFld            '', 'Статус'                                              ('Статус'):   [11], Protect, NoAutosize;
end; //browse brSysNar;

window wEdit 'Редактирование наряда' escclose;
  Show(, , 90, 22);

  screen scEdit ( , , sci1Esc);
    show at (,,,5) FIXED_Y;
    Table SYS_NAR;
    Fields
        Sys_Nar.NMnem        ('Наименование наряда')                : Protect;
        Sys_Nar.DataN        ('Дата начала работ по наряду')        : {font = {bold = true}}, Protect;
        Sys_Nar.DatOk        ('Дата окончания работ по наряду')     : {font = {bold = true}}, Protect;
        Sys_Nar.CheckDate    ('Дата проверки наряда')               : Protect;
        ChoiceFld            ('Проверен')                           : Protect, PickButton;
        TotalChasF           ('Нормо-часы')                         : [10.2], Protect;
        Sys_Nar.SummaNar     ('Сумма наряда')                       : [10.2], Protect;
        Sys_Nar.SummaPrem    ('Сумма премии')                       : [10.2], Protect;
        TotalSum             ('Всего')                              : [10.2], Protect;
        PrichNesootv         ('Причина несоответствия')             : Protect;
        ShZK                 ('Шифр затрат на качество')            : Protect;
  <<
`Наряд`                   `Начало`    `Окончание` `Проверен`  `Статус`
 .@@@@@@@@@@@@@@@@@@@@@@@@.@@@@@@@@@@ .@@@@@@@@@@ .@@@@@@@@@@ .@@@@@@@@@@@@@
`Норма времени` `Сумма`    `ТОН`      `Всего`      `Причина несоответствия` `Шифр СМК`
 .@@@@@@@@@@@@@@.@@@@@@@@@@.@@@@@@@@@@.@@@@@@@@@@@@.@@@@@@@@@@@@@@@@@@@@@@@@.@@@@@@@@@@@@
  >>
  end; //screen scEdit

  browse brEdit ( , , sci1Esc);
    show at (,6,,);
    Table PrNaryad;
    fields
      WorkerName                  'Ф.И.О.'                                       : [15], Protect;
      Catalogs.Name               'Профессия'                                    : [15], Protect;
      PrNaryad.StrTabN            'Таб. №'                                       : [6], Protect;
      GP_PrNaryad_Ext.PersRazr    'Разряд','рабочего'                            : [6], Protect;
      PrNaryad.KTY * 100          '%'                                            : [4,1], Protect;
      GP_PrNaryad_Ext.TPs         'Номер','ТПс'                                  : [15], Protect;
      GP_PrNaryad_Ext.ZNP         'Номер','ЗНП'                                  : [8], Protect;
      GP_PrNaryad_Ext.DSEName     'Номер,','наименование','ДСЕ'                  : [15], Protect;
      GP_PrNaryad_Ext.OperName    'Номер,','наименование','операции'             : [15], Protect;
      PrNaryad.KolVo              'Кол-во,','шт.'                                : [8], Protect;
      GP_PrNaryad_Ext.KolVoGodn   'Кол-во','годных, шт.'                         : [8], Protect;
      GP_PrNaryad_Ext.OperRazr    'Разряд','работы'                              : [5], Protect;
      GP_PrNaryad_Ext.GrOpl       'Группа','оплаты'                              : [5], Protect;
      NrmTimeFld                  'Норма на','обработку','Время'                 : [8], Protect;
      PrNaryad.Rascen             'Норма на','обработку','Расценка'              : [10,2], Protect;
      NrmTimePZFld                'Подготовительно-','заключительное','Время'    : [8], Protect;
      GP_PrNaryad_Ext.RascenPZ    'Подготовительно-','заключительное','Расценка' : [10,2], Protect;
      PrNaryad.Summa              'Сумма','заработка'                            : [10,2], Protect;
      PrNaryad.Proc               '%', 'ТОН.'                                    : [5,1], Protect;
      PrNaryad.SummPrem           'ТОН'                                          : [10,2], Protect;
      KlVidOpl.VidOplP            'Вид','оплаты'                                 : [5], Protect;
      ChasFFld                    'Нормо-','часы'                                : [8], Protect;
      MnPlan.Number               '№','заказа'                                   : [10], Protect;
  end;

  handleevent

    cmHotKeys:
      PutHotCommand(RunMenu('GP_NariadView_Menu'));

    cmPrintDoc:
      PrintDoc;

  end;

end; //window wEdit


//******************************************
///\/\/\/\/\ События интерфейса /\/\/\/\/\/\
//******************************************
Handleevent
//---------------------
  cmDefault:
    RunWindow(wEdit);

//---------------------
  cmPrintDoc:
    PrintDoc;

//---------------------
  cmPick:
  {
    case CurField of
      #ChoiceFld:
      { if RunWindowModal(wndChoice) = cmDefault
          SetCurSysNarChoice(tChoice.Choice);
      }
    end;
  }

//---------------------
  cmInit:
  {

    _Shablon_TrudPotr     :=coGetTune('NPOEM_OWN.ZP.NARYAD.EXPORT.Shablon');
    //Формируем список статусов нарядов
    AddChoice(3  , 'Проверен');
    AddChoice(901, 'На проверку');
    AddChoice(902, 'Отклонен');
    AddChoice(903, 'Будущий период');
    AddChoice(904, 'Ошибка');

    //Формируем маркер с доступными пользователю подразделениями согласно
    //настроек доступности подразделений в модуле Заработная плата.
    _mAvailableDepartments := InitMarker('', 8, 500, 100, true);
    var DI: IDepartmentIterator;
    LoadVipRef(DI, 'DepartmentIterator');
    BindEvent(InsertDepartmentIntoMarker, DI.CollectDepartment);    //когда уже лямбды прикрутят?!
    DI.IterateDepartments(0, ifTreatAsPlainList);
    UnBindEvent(InsertDepartmentIntoMarker, DI.CollectDepartment);
    InsertMarker(_mAvailableDepartments, 0);

    //Устанавливаем фильтр по статусам и доступным подразделениям
    AddBounds(tbBySysNarChoice);

    ReReadRecord(tnSys_Nar);
  }

//---------------------
  cmDone:
    DoneMarker(_mAvailableDepartments, '');

end;

end.


GP_NariadView_Menu Menu
{
  - 'Печать наряда', cmPrintDoc, 'Печать наряда' ,hcNoContext, 'Ctrl+P', kbCtrlP, sci1Esc;
}
