#component "Z_PAYREP"
#doc
 ЗП - отчеты - расчеты по оплате труда - Реестры - печать по Alt+P
#end
Alter interface ReestrForTransferRep;
OverLoad
datastream dsReestrForTransfer;
function fFillData: boolean;
end;

//========================================
var  ATTR_B_INN:comp;//ВА ИНН к KatBank
var  ATTR_B_KPP:comp;//ВА КПП к KatBank
var  ATTR_SB_PRIM :comp;//ВА Примечание к SBBAB


create view  vReestrForTransferRep
From
   SpPlBan SpPlBan_Print
,  KatOrg KatOrg_SpPlBan
,  KATBANK KATBANK_SPPLBAN
,  Katb
,  Persons Persons_Print
,  SHTRAF SHTRAF_Print
,  SbBan SbBan_Print
,  SbBan SbBan_child
where
((   tmpSbBanFR.cSbBan   == SbBan_Print.Nrec
and  tmpSpPlBanFR.cSbBan == SpPlBan_Print.cSbBan
and  tmpSpPlBanFR.FIO    == SpPlBan_Print.Fio
and ( // ( Longint(tmpSpPlBanFR.Tabn) = SpPlBan_Print.Tabn
      //  and SpPlBan_Print.Tabn>0
      // ) or
       tmpSpPlBanFR.Tabn = SpPlBan_Print.StrTabN
   )
and  SpPlBan_Print.cBankPol == KATBANK_SPPLBAN.Nrec
and  KATBANK_SPPLBAN.cOrg  == KatOrg_SpPlBan.Nrec
and  KATBANK_SPPLBAN.CBANK == KATB.NREC
and  SpPlBan_Print.tPerson == Persons_Print.Nrec
//--------------------------
and SbBan.Nrec == SbBan_Child.cNode
//----------------------------------
//and  SPPlBan.cPodr == Shtraf.Nrec(noindex)
// Связь с постоянными удержаниями (для определения типа счета банка (показал Старпович В.))
and SPPLBAN_Print.cLsch     == SHTRAF_Print.cLsch
and SPPLBAN_Print.VIDUD     == SHTRAF_Print.VidUd
//-------------------------
and SPPLBAN_Print.PAYNUM   == SHTRAF_Print.LASTUSER(noindex)
and SPPLBAN_Print.CPOL     == SHTRAF_Print.CPOL    (noindex)
and SPPLBAN_Print.CBANKPOL == SHTRAF_Print.CBANKPOL(noindex)
//-------------------------
and Date(Last_Day(SbBan_Print.DataN), month(SbBan_Print.DataN), year(SbBan_Print.DataN))    >>=SHTRAF_Print.DATANSK(Noindex)
//and ( SHTRAF_Print.DatOK=ZeroDate or SHTRAF_Print.DatOK>SbBan_Print.DataN )
and ( (SHTRAF_Print.DatOK=date(0,0,0) or SHTRAF_Print.DatOK>SbBan.DataN)
  and ( SHTRAF_Print.FIO='' or SPPlBan_Print.FIO = SHTRAF_Print.FIO)
 )

))
Bounds ByPrintSP tmpSbBanFR.cSbBan == tmpSpPlBanFR.cSbBan
;

Procedure Init_Attr;
{ ATTR_B_INN:=ExtAttr_Create(coKatBank,'ИНН', cgAttrType_Str );
  ATTR_B_KPP:=ExtAttr_Create(coKatBank,'КПП', cgAttrType_Str );
  ATTR_SB_PRIM:=ExtAttr_Create(coSBBAN,'Примечание'    , cgAttrType_Str);
}


Function GetPersFio():string;
{ Result:='';
  if getfirst spPlBan_Print<>tsok
  { timelog('ReestrForTransferRep->GetPersFio:нет spPlBan_Print');
    exit;
  }
  if getfirst Persons_Print<>tsok
  { timelog('ReestrForTransferRep->GetPersFio:нет Persons_Print');
    exit;

  }
  Result:=Persons_Print.Fio
} //Function GetPersFio():string;

Function GetBankName:string;
{ if getfirst spPlBan_Print<>tsok
  { timelog('ReestrForTransferRep->GetPersFio:нет spPlBan_Print');
    exit;
  }
  if getfirst KATBANK_SPPLBAN<>tsok
  { timelog('ReestrForTransferRep->GetPersFio:нет KATBANK_SPPLBAN');
    exit;
  }
  if getfirst KATORG_SPPLBAN<>tsok
  { timelog('ReestrForTransferRep->GetPersFio:нет KATORG_SPPLBAN');
    //exit;
  }
  if getfirst Shtraf_Print<>tsok
  { //timelog('ReestrForTransferRep->GetPersFio:нет Shtraf_Print');
    //exit;
  }

  Result:=KATBANK_SPPLBAN.name;
} //Function GetBankName:string;

//-----------------------
// Получить ИНН Банка
//-----------------------
Function GetBankInn(_pKatBank:comp; _sInn:string ) :string;
{ Result:=sGetAttrID(coKatBank,_pKatBank,ATTR_B_INN);
  if Result='' Result:=_sInn;
}


//-----------------------
// Получить ИНН Банка
//-----------------------
Function GetBankKPP(_pKatBank:comp; _sKPP:string ) :string;
{ Result:=sGetAttrID(coKatBank,_pKatBank,ATTR_B_KPP);
  if Result='' Result:=_sKPP;
}

Function GetUIN( _Name:string ) :string;
{ //УИН:
  Result:='';
  _Name:=UpCase(_Name);
  if pos('УИН:',_Name)>0
  { Result:=trim(SubStr(_Name,pos('УИН:',_Name)+4,200 ));
  }
}

Function GetPrim:string;
//за [IIF((<tmpSbBanFR."Prefix">='R$A') or (<tmpSbBanFR."Prefix">='RO') ,'1 половину','2 половину')] [Copy(<tmpSbBanFR."sDATAN"> ,1,7)]
{ Result:=sGetAttrID(coSbBan,SbBan_Print.Nrec,ATTR_SB_Prim);
  if Result=''
    if SbBan_Print.cNode>0
      Result:=sGetAttrID(coSbBan,SbBan_Print.cNode,ATTR_SB_Prim);
  if Result=''
   Result:='за '+if(SBBAN_Print.Prefix='R$A' or SBBAN_Print.Prefix='RO' ,'1 половину','2 половину')
      +DateToStr(SbBan_Print.DataN,' mon YYYY г');
}


datastream dsReestrForTransfer //{
( [MyOrg] sGetTune('MyOrg');
  table Inherited::tmpSbBanFR
  (
    [Prefix]  SbBan_Print.Prefix;
    [Prim]    GetPrim;
    table Inherited::tmpSpPlBanFR
    (
      [FIO3]      My_Sclonenie(tmpSpPlBanFR.FIO,23,0);
      [Bank_name] GetBankName;//KATBANK_SPPLBAN.name;
      [Schet1]    KATBANK_SPPLBAN.Schet1;
      [Schet2]    KATBANK_SPPLBAN.Schet2;
      [MFO1]      KATBANK_SPPLBAN.MFO1;
      [POL]       KatOrg_SpPlBan.Name;//КПП
      [INN]       GetBankInn(SpPlBan_Print.cBankPol,KatOrg_SpPlBan.UNN )    ;//: tNRec        "Номер записи"
      [KPP]       GetBankKPP(SpPlBan_Print.cBankPol,KatOrg_SpPlBan.KodPLatNDS);//КПП
      [UIN]       GetUIN(SbBan_Print.Name);
      [NOMLSH]    SPPLBAN_Print.NOMLSH;
      [NomCard]   SPPLBAN_Print.NomCard;
      [FIO_Pers]  GetPersFio();
      [ISP_LIST]  SHTRAF_Print.LASTUSER ;//
      [NamePl1]   SHTRAF_Print.namepl1; //назначение платежа 1
      [NamePl2]   SHTRAF_Print.namepl2; //назначение платежа 2

    );
  );
)
end; // datastream EReestr }

function fFillData: boolean;
var i: longInt;
{ ResetBounds(#tmpSPpLBan);
  timelog_init;
  Init_Attr;
  delete all tmpSPpLBan;
  SetBounds(#tmpSPpLBan);
  var _nRec         : comp    = comp(0);
  var loMarkerCount : longInt = GetMarkerCount(MarkedReg);   // количество элементов в маркере
  for (i := 0; i < loMarkerCount; i++)
  {
    if not GetMarker(MarkedReg, i, _nRec)
      continue;
    if (getFirst SbBan where ((_nRec == SbBan.nRec)) <> tsOk)
      continue;
    if SbBan.Prefix='R$$'
    { _Loop SbBan_Child
       if not FoundMarker(MarkedReg,SbBan_Child.Nrec)
         InsertMarker(MarkedReg,SbBan_Child.Nrec);
    }
  }
  //---------------------------
  Result:=Inherited::fFillData;
  //---------------------------
  if Result
  { PushBounds(tbByPrintSP);
    ReReadRecord(#tmpSpPlBanFR);
  }

} //function fFillData: boolean;

end.
