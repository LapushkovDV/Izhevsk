table struct tmpVPlan
(
  Name          : string
, cVPlan        : comp
, cBankSch      : comp
, dSumRaspPlan  : double
, dSumRaspFactS : double
, dSumRaspFactO : double
, dPercent      : double
)
with index
(
  i01 = cVPlan
);

table struct tmpMnPlan
(
  Number         : string
  ,ownname       : string
  ,Name          : string
  ,KatNotesName  : string
  ,vPlanName     : string
  ,StartDate     : date
  ,EndDate       : date
  ,cMnPlan       : comp
  ,cVPlan        : comp
  ,SchDt         : string
  ,SubSchDt      : string
  ,dSummRaspr    : double
)
with index
(
  i01 = ownname + cMnPlan
  ,i02 = ownname + cVPlan
);
Table Struct tmpHrs
(
    cPodr   : comp
  , cMnPlan : comp
  , ownname : string
  , clSchet : comp
  , sTabN   : string
  , sFIO    : string
  , dTabHrs : double
  , dNarHrs : double
  , SummZP         : double
  , SummRaspr      : double
  , SummItogZP     : double
  , SummItogRaspr  : double
  , SummR          : double
  , dTabHrsItog    : double
  , wOtkuda        : word
)
with index
(
    i01 = ownname + cMnPlan + cPodr
  , i02 = ownname + clSchet + cMnPlan
);

Create View rView

var
  oIGK_Dog         : iIGK_Dog;
  iStrFunc         : StringFunctions;
  PE               : IPaymentEnterings;    // проверго входимоздей
  refAttrTablePick : AttrTablePick;
  iExAttr          : iExtAttr;
  CS               : IContextSession;
  _log           : string = '';
  _dOtch         : date;
  _dEnd          : date;
  _sPeriod       : string;
  _sPodr, _sMnPlan  : string;
  _cPodr, _cMnPlan  : comp;
  KL_code   : word;
  KL_on     : string;
  DliaTest  : word;
  _getKau : GetKau;
cgrplan : comp;
  Filter_mPodr,
  Filter_Marker   : TPtr;
  tmpMarker:                    TPtr;
As

//select
//  if(GetMarkerCount(KategMarker) > 0,selected,notSelected) (FieldName = FiltrKateg),
//  if( tmpVPlan.cVPlan = comp(coVirtualcVPlan), 'Прямые, не ГОЗ', vPlanItog.Name)        (FieldName = svPlanItog)
from
  KatPodr
, KatPodr KatPodrName
, MnPlan
, FpPeriod
, tmpHrs
, tmpHrs tmpHrsLsch
, tmpVPlan
, tmpMnPlan
, tmpMnPlan tmpMnPlanLsch
//, tmpMnPlan tmpMnPlanSch
, lSchet
, Persons
, Sys_Nar
, PrNaryad
, LastNumD
//, BuhSchet
//, vplan
//, KLKATEGO
//, vPlan     vPlanItog
//, vPlan     vPlanFiltr
, KatNotes
, KatLink   KatLinkPodr
, KatLink   KatLinkPodrAll
, KatLink   KatLinkMnPlan
, tmpMnPlan tmpMnPlanAll
, KatLink   KatLinkLsch
, tmpHrs    tmpHrsSumm
, tmpHrs    tmpHrsItogZP
, tmpMnPlan tmpMnPlanItogRaspr
, tmpHrs    tmpHrsItogRaspr
, tmpVPlan  tmpVPlanI
, tmpMnPlan tmpMnPlanI
, tmpHrs    tmpHrsI
, sumvidop
, nachisl
, katlink
where((
comp(2814749767106805) == mnplan.CSTATUS (noIndex)//Утвержден
and             KL_on == tmpMnPlan.ownname
and tmpVPlan.cVPlan   == tmpMnPlan.cVPlan

and         coKatPodr == KatLinkPodr.codeTable
and           KL_code == KatLinkPodr.code
and             KL_on == KatLinkPodr.ownname
and tmpMnPlan.cMnPlan == KatLinkPodr.CUSER (noIndex)

and KatLinkPodr.CREC  == KatPodrName.Nrec

and          coMnPlan == KatLinkMnPlan.codeTable
and           KL_code == KatLinkMnPlan.code
and             KL_on == KatLinkMnPlan.ownname
and tmpMnPlan.cMnPlan == KatLinkMnPlan.CUSER (noIndex)

AND KL_on             == tmpHrs.ownname
and KatLinkPodr.CUSER == tmpHrs.cMnPlan
and KatLinkPodr.CREC  == tmpHrs.cPodr

and KL_on             == KatLinkLsch.ownname
AND KL_on             == tmpMnPlanLsch.ownname
AND KL_on             == tmpHrsLsch.ownname

AND KL_on                == tmpMnPlanAll.ownname

and            coKatPodr == KatLinkPodrAll.codeTable
and              KL_code == KatLinkPodrAll.code
and                KL_on == KatLinkPodrAll.ownname
and tmpMnPlanAll.cMnPlan == KatLinkPodrAll.CUSER (noIndex)

//AND KL_on                == tmpMnPlanAll.ownname
//and KatLinkPodrAll.CUSER == tmpMnPlanAll.cMnPlan

AND KL_on                == tmpHrsSumm.ownname

AND tmpHrsSumm.ownname   == tmpHrsItogZP.ownname
AND tmpHrsSumm.clSchet   == tmpHrsItogZP.clSchet
AND tmpHrsSumm.cMnPlan   == tmpHrsItogZP.cMnPlan

and             KL_on    == tmpMnPlanItogRaspr.ownname
AND             KL_on    == tmpHrsItogRaspr.ownname
AND tmpHrsSumm.clSchet   == tmpHrsItogRaspr.clSchet
AND tmpMnPlanItogRaspr.cMnPlan  == tmpHrsItogRaspr.cMnPlan

and             KL_on    == tmpMnPlanI.ownname
and tmpVPlanI.cVPlan     == tmpMnPlanI.cVPlan
AND             KL_on    == tmpHrsI.ownname
and tmpMnPlanI.cMnPlan   == tmpHrsI.cMnPlan
))
;

