
function CreateExcel (FExcelName : string) : boolean;
{
  StartNewVisual(vtRotateVisual, vfBreak+vfTimer, 'Инициализация EXCEL', 1);
    result := true;

    DeleteFile(FExcelName);

    if (not xlCreateExcel(FExcelName, true))
    {
      message('ОШИБКА! Не удалось инициализировать сессию Excel', Error);
      xlKillExcel;
      result := false;
      exit;
    }

    if (not xlIsExcelValid)
    {
      message('ОШИБКА! Не удалось инициализировать сессию Excel', Error);
      xlKillExcel;
      result := false;
      exit
    }
  var xlCount : word;
  xlCount := 0;
   Do
   {
    xlGetSheetsCount(xlCount);
    xlDeleteSheet(xlCount);
   } while xlCount > 1

    xlSetActiveSheet(1);
    xlSetSheetName(1, 'Algoritm_CheckQuotas_'+UserName);

   StopVisual('',0);
}

Procedure MyPrintMatrixToExcel(var nrow, nrowReal : longint);
{
 if nrow = 100 then
  {
   xlWritematrixToExcel(nrowReal,1);
   xlclearMatrix;
   nrowReal := nrowReal + nrow;
   nrow := 0;
  }
}

procedure  PrintColumns(_nrow, _column : word);
{
  _loop tColumns
  {
    xlStWriteToMatrix(_nrow, _column + tColumns.nppColumn,tColumns.name);
  }
}
Procedure UpdateAllSum(_cParent : comp; _summa : double);
{
  if getfirst tColumns where ((_cParent == tColumns.nrec and 0 == tColumns.TypeRec)) = tsOK
       {
        update current tColumns set tColumns.summa := tColumns.summa + _summa;
        pushpos(tntColumns);
         UpdateAllSum(tColumns.cParent, _summa);
        poppos(tntColumns);
/*        mylog('UpdateAllSum name     ='+ tColumns.name
            + '|nppColumn='+ tColumns.nppColumn
            + '|nrec     ='+ tColumns.nrec
            + '|cParent  ='+ tColumns.cParent
            + '|TypeRec  ='+ tColumns.TypeRec
            + '|Summa    ='+ tColumns.Summa
             )
*/
       }
}
procedure UpdateAllColumnsSum;
{
  _loop tcolumns1 where tColumns1.TypeRec = 1 and tColumns1.summa <> 0 {
/*      mylog('UpdateAllColumnsSumname     ='+ tColumns1.name
          + '|nppColumn='+ tColumns1.nppColumn
          + '|nrec     ='+ tColumns1.nrec
          + '|cParent  ='+ tColumns1.cParent
          + '|TypeRec  ='+ tColumns1.TypeRec
          + '|Summa    ='+ tColumns1.Summa
      );
*/
      UpdateAllSum(tColumns1.cParent,tColumns1.summa);
    }
}
procedure PrintColumnsToRow(_nrow, _column : longint; _buftReportPers : type$tReportPers);
{
 update tColumns set Summa := 0; // в это поле будем суммировать все по 1 строке, сначала занулим

        mylog('PrintColumnsToRow ' +
             +'|Tabn       = ' + _buftReportPers.Tabn
             +'|PodrUp     = ' + _buftReportPers.PodrUp
             +'|Podr       = ' + _buftReportPers.Podr
             +'|Dolj       = ' + _buftReportPers.Dolj
             +'|Kategor    = ' + _buftReportPers.Kategor
             +'|KategorKod = ' + _buftReportPers.KategorKod
             +'|YearN      = ' + _buftReportPers.YearN
             +'|MesN       = ' + _buftReportPers.MesN
             +'|SisOpl     = ' + _buftReportPers.SisOpl
             );

 _loop tReport where (( _buftReportPers.lsNrec     == tReport.lsNrec
                    and _buftReportPers.cPodr      == tReport.cPodr
                    and _buftReportPers.cDolj      == tReport.cDolj
                    and _buftReportPers.KategorKod == tReport.KategorKod
                    and _buftReportPers.SisOplKod  == tReport.SisOplKod
                    and _buftReportPers.YearN      == tReport.YearN
                    and _buftReportPers.MesN       == tReport.MesN
                     ))
   {
        mylog('PrintColumnsToRow |  _loop tReport ' +
            + '|tReport.summa = ' + tReport.summa
             );

      if getfirst tColumns where ((tReport.VidOplp == tColumns.Vidoplp and 1 == tColumns.TypeRec)) = tsOK
       {
        update current tColumns set tColumns.summa := tColumns.summa + tReport.summa;
        mylog('PrintColumnsToRow |  _loop tReport ' +
            + '|tReport.VidOplp = ' + tReport.VidOplp
             );

       }
   }
    UpdateAllColumnsSum;
   _loop tColumns
    {
      if tColumns.summa <> 0 then
       { xlDoWriteToMatrix(_nrow, _column + tColumns.nppColumn, tColumns.summa);
/*          mylog('PrintColumnsToRow     ='+ tColumns.name
              + '|nppColumn='+ tColumns.nppColumn
              + '|nrec     ='+ tColumns.nrec
              + '|cParent  ='+ tColumns.cParent
              + '|TypeRec  ='+ tColumns.TypeRec
              + '|Summa    ='+ tColumns.Summa
          );
*/
       }
    }
}

Procedure PrintReportToExcel;
{
  var _excelFile :string = GetStringParameter('Files','TmpFilesDirectory',0)+'EM_Nachisl_ESOT_'+UserName+'_'+DateToStr(Cur_Date,'YYYYMMDD')+'_'+TimeToStr(Cur_Time,'HHMMSS')+'.xlsx';
  if not CreateExcel(_excelFile)
    then {Stop; Abort; exit;}


 StartNewVisual(vtIndicatorVisual , vfTimer + vfBreak ,'Вывод в EXCEL', recordsintable(tntReportPers));

  xlCreateMatrix(100,15 + recordsIntable(tntColumns) + 5);

  var Nrow0,nrow0FrameBold, Nrow, column, nrowreal, column0 : longint;
 nrowreal := 1;
 Nrow := column := 1;


 xlStWriteToMatrix(nrow, column,'Заработная плата персонала по видам выплат за период с ' + datetostr(_dateBeg,'DD.MM.YYYY')+ ' по '+datetostr(_dateEnd,'DD.MM.YYYY'));

/*
  Добавьте вывод фильтров в отчет
*/
 xlMergeCells(nrow,column,nrow,column+20);
 xlSetFontStyle(1,nrow,1,nrow,20);
 Nrow++;
 column := 1;
 xlStWriteToMatrix(nrow, column,'Таб. №'); column++;
 xlStWriteToMatrix(nrow, column,'Подразделение'); column++;
 xlStWriteToMatrix(nrow, column,'Внутреннее структурное подразделение'); column++;
 xlStWriteToMatrix(nrow, column,'Профессия / должность'); column++;
 xlStWriteToMatrix(nrow, column,'Разряд / категорийность'); column++;
 xlStWriteToMatrix(nrow, column,'Месяц года'); column++;
 xlStWriteToMatrix(nrow, column,'Категория персонала'); column++;
 xlStWriteToMatrix(nrow, column,'Форма оплаты'); column++;
 xlStWriteToMatrix(nrow, column,'Возраст работника'); column++;
 xlStWriteToMatrix(nrow, column,'Стаж работы в организации (лет)'); column++;
 xlStWriteToMatrix(nrow, column,'Урочное время (часы)'); column++;
 xlStWriteToMatrix(nrow, column,'Сверх. уроч. (часы)'); column++;
 xlStWriteToMatrix(nrow, column,'Вых. дни (часы)'); column++;
 xlStWriteToMatrix(nrow, column,'Объем выработки (н/ч)'); column++;
 xlStWriteToMatrix(nrow, column,'Плановая норма рабочего времени'); column++;

 column0 := column -1 ;
 PrintColumns(nrow, column0);
 xlSetFontStyle(1,nrow,1,nrow,column0 + recordsIntable(tntColumns));
// Nrow++;
 column := 1;
// xlSetFontStyle(1,nrow,1,nrow,10);


 xlSetColumnWidth(7,1,1 ,1, 1);
 xlSetColumnWidth(7,1,2 ,1, 2);
 xlSetColumnWidth(10,1,3 ,1, 3);
 xlSetColumnWidth(50,1,4 ,1, 4);


 xlSetColumnWidth(6,1,6 ,1, 6);
 xlSetColumnWidth(24,1,7 ,1, 7);
 MyPrintMatrixToExcel(Nrow,NrowReal);

  _loop tReportPers
   {
     nextvisual;
    var _column : word = 1;
    nrow++;
    xlStWriteToMatrix(nrow, _column, chr(39) + tReportPers.Tabn ); _column++;
    xlStWriteToMatrix(nrow, _column, chr(39) + tReportPers.PodrUp     ); _column++;
    xlStWriteToMatrix(nrow, _column, chr(39) + tReportPers.Podr       ); _column++;
    xlStWriteToMatrix(nrow, _column, tReportPers.Dolj           );       _column++;
    xlStWriteToMatrix(nrow, _column, '' ); _column++;
    xlDoWriteToMatrix(nrow, _column, tReportPers.YearN + '.'+ tReportPers.MesN); _column++;
    xlDoWriteToMatrix(nrow, _column, tReportPers.KategorKod + ' ' + tReportPers.Kategor ); _column++;
    xlStWriteToMatrix(nrow, _column, tReportPers.SisOpl         ); _column++;
    xlDoWriteToMatrix(nrow, _column, tReportPers.Vozrast        ); _column++;// возраст
    xlStWriteToMatrix(nrow, _column, tReportPers.StajNaOrg      ); _column++;// стаж на предприятии
    xldoWriteToMatrix(nrow, _column, tReportPers.UrochTime      ); _column++;// Урочное время (часы)
    xldoWriteToMatrix(nrow, _column, tReportPers.SverhUrochTime ); _column++;// Сверх. уроч. (часы)
    xlDoWriteToMatrix(nrow, _column, tReportPers.VihodnTime     ); _column++;// Вых. дни (часы)
    xlDoWriteToMatrix(nrow, _column, tReportPers.Vyrabotka      ); _column++;// Объем выработки (н/ч)
    xlDoWriteToMatrix(nrow, _column, tReportPers.PlanNormTime   ); _column++;// Планов

    PrintColumnsToRow(nrow, column0, tReportPers.Buffer);
    MyPrintMatrixToExcel(Nrow,NrowReal);
  }
 xlWriteMatrixToExcel(NrowReal,1);
 SetVisualHeader('Вывод в EXCEL'+
   + ''#13'' + 'Разлиновка');
 xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB + xlInsideH + xlInsideV, xlThin, xlContinuous, 0, 2, 1, nrow+nrowreal-1, column0 + recordsIntable(tntColumns));
 SetVisualHeader('Вывод в EXCEL'+
   + ''#13'' + 'Установка переноса слов');
 xlWrapText(1,1, nrow+nrowreal-1, column0 + recordsIntable(tntColumns));

 SetVisualHeader('Вывод в EXCEL'+
   + ''#13'' + 'Установка формата отображения цифр');

 xlSetNumberFormat('# ##0,00',2, 11, nrow+nrowreal-1, column0 + recordsIntable(tntColumns));

 SetVisualHeader('Вывод в EXCEL'+
   + ''#13'' + 'Выполнение макроса');
var _fileMacros : string = GetStringParameter('Files','TmpFilesDirectory',0)+'EM_Nachisl_ESOT_'+UserName+'_'+DateToStr(Cur_Date,'YYYYMMDD')+'_'+TimeToStr(Cur_Time,'HHMMSS')+'.pas';
deletefile(_fileMacros);

logstrtofile(_fileMacros,'Sub MacrosReport');
logstrtofile(_fileMacros,'    Rows("2:2").Select ');
logstrtofile(_fileMacros,'    With Selection     ');
logstrtofile(_fileMacros,'        .HorizontalAlignment = xlGeneral ');
logstrtofile(_fileMacros,'        .VerticalAlignment = xlTop       ');
logstrtofile(_fileMacros,'        .WrapText = True                 ');
logstrtofile(_fileMacros,'        .Orientation = 90                ');
logstrtofile(_fileMacros,'        .AddIndent = False               ');
logstrtofile(_fileMacros,'        .IndentLevel = 0                 ');
logstrtofile(_fileMacros,'        .ShrinkToFit = False             ');
logstrtofile(_fileMacros,'        .ReadingOrder = xlContext        ');
logstrtofile(_fileMacros,'        .MergeCells = False              ');
logstrtofile(_fileMacros,'    End With                             ');
logstrtofile(_fileMacros,'    Selection.RowHeight = 114            ');
logstrtofile(_fileMacros,'    Selection.RowHeight = 164.25         ');
logstrtofile(_fileMacros,'    Selection.AutoFilter                 ');
logstrtofile(_fileMacros,'End Sub                                  ');

 xlIMPORTMODULE(_fileMacros);
 xlRunMacro('MacrosReport');
 xlSaveWorkBookByName(_excelFile);
 xlKillExcel;
 StopVisual('',0);
}
