#component "Z_ZARREP"
Alter Interface STRZARNASTR;
var
   pUserId:comp;
create view
bounds byUserID pUserId ==  NastrRep.NASTR3(noindex) ordered by TableOrder
;
HandleEvent
cmInit:
{ pUserId:=UserId();
  AddBounds(tbbyUserID);
  if  inherited :: handleEvent (cmInit)=heAbort then Abort;
}
#IFDEF _GP_
cmSetDefault:
{ //нет стандарта
  ClearBuffer(#NastrRep);
  NastrRep.NASTR3:=pUseRID;
  NastrRep.choice:=Choice;
}
#ENDIF
cmValue2:
{
  if NameNastrRep = ''
  {
    Message('Вы не задали название настроек отчета', Information);
    abort;
    exit;
  }
  if getfirst NastrRep where (( Choice == NastrRep.Choice and
                                NameNastrRep == NastrRep.NameNastr
#IFDEF _GP_
       and  pUseRID == NastrRep.NASTR3(NoIndex)
#ENDIF
                                )) = tsOk
  {
    if Message('Настройки '+ NameNastrRep + ' уже существует.'+ char(13)
                + 'Заменить?', YesNo + Confirmation) = cmYes
    {
      NrecNastr := NastrRep.Nrec;
      VidNastr := 2;
    }
    else
    {
      abort;
      exit;
    }
  }
  else
  {
    clearbuffer(#NastrRep);
    NastrRep.Choice := Choice;
    NastrRep.NameNastr := NameNastrRep;
#IFDEF _GP_
    NastrRep.NASTR3:=pUseRID;
#ENDIF
    insert current NastrRep;
    if getfirst NastrRep where (( Choice == NastrRep.Choice and
                                NameNastrRep == NastrRep.NameNastr
#IFDEF _GP_
       and  pUseRID == NastrRep.NASTR3(NoIndex)
#ENDIF

                                )) = tsOk
    {
      NrecNastr := NastrRep.Nrec;
      VidNastr := 1;
    }
  }
  SaveMyDsk(VidNastr,'VidNastr_NastrRep');
  CloseInterface(cmOk);
}

end;
end.
