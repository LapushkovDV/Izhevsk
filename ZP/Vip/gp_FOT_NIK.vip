#include PAFilter.vih

interface gp_FOT_NIK 'ФОТ НИК' EscClose, Gray;
  show at (,,80,10);

  table struct PodrMy
  (
    nmfunc:String,
    kod   :String,
    name  :String,
    Nrec  :Comp, 
    cFunc :longint
  )
  with index
  (
    PodrMy1 = kod + name
  )
  ;
  
  table struct tmp_KlVidOpl 
  (
    Nrec   : comp,
    VidOpl : comp,
    VidOplP: longint,
    NVIDOPL: string,
    VHVOE19: string,
    VHVOE32: string,  //общая входимость в облагаемую базу ЕСН/СВ
                      //поле социальных налогов на вкладке Расчеты
    VHVOE34: string,  //входимость в отчетность
    VHVOE35: string,
    VHVOE5:  string,
    KAUEXTR  : array [1..6] of Comp,
    TBLEXTR  : array [1..6] of Word
  )
  with index
  (
    tmp_KlPerOpl01 = VidOpl
  );

  table struct nachislzakazSum   
  (
    Nrec          : Comp,
    Summa         : double,
    VidOpl        : longint,
    VidOplP       : longint,
    cLsch         : comp,
    Cex           : comp,
    CexOz         : comp,
    cNach         : comp,
    cPodrOZ       : comp,
    Koldn         : double,
    MesN          : word,
    Mes           : integer,
    Sovm          : word,
    Summa30       : double,
    Proc          : double,
    cSchetD       : string[20],
    cSubSchD      : string[21],
    cKAUD         : array [1..6] of Comp,
    TblD          : array [1..6] of Word,
    sReCalc       : string[1],
    YearN         : Integer,
    Tek           : Integer,
    Kod           : String
  )
  with index 
  (
    nachislzakazSum01 = cSchetD + Kod + VidOplP + cKAUD[1]
  );

create view vFOT_NIK
var
  ExcelPath       : string;
  Marker, iCount, i, lTemp  : longint;
  PodrMarker        : comp;    // nNec подразделения
  _PodrMArkerPointer: Longint; // сам маркер
  CLSF              : CurLSFunctions;
  mrkOuterClassfier : longInt;   //маркер с отмеченными классификаторами
  MarkerNotNull     : boolean;   // флаг - маркер не пустой
  ClassSeg          : comp;      //nRec сегмента классификатора
  FiltrPublic       : string;
  MyFlag            : boolean;   //флаг для различных целей
  i1                : integer;   //для циклов
  p2                : double;
  MKat              : word;
  cCexOz            : Comp;
  NameFunc          : string;
  cTemp             : Comp; 
  ItogCol           : integer;
  FOT_cSchetD       : string;
  FOT_Kod           : string;
  FOT_VidOplP       : Longint;
  FOT_cKAUD         : Comp;
  VIDYear         : word;
  VIDMonthN       : word;
  VIDMonthK       : word;
  #include PAFilter.var
(
  FiltrPodr
)
as select
  #include GP_Podrfiltr1.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.
from
  Zar_User
  ,Lschet
!  ,Lschet Lschet1
  ,Lschet LschetN
  ,Persons PersonsN
!  ,Persons Persons1
  ,PodrMy
  ,nachislzakazSum
  ,DepFunc
  ,DepFunc DepFunc1 
  ,tmp_KlVidOpl
!  ,KlVxod
!  ,OtpDop
  ,CURLSCHET
  ,PLANSSCH
  ,mnplan
where 
((
  _cLSchet                 == Formarks.Choice      and          
  #include GP_Podrfiltr2.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.
))
;

#include GP_PODRGET_US0.VPP
#include GP_PODRPAFilter.vpp
var PodrNrec: array [0..0] of Comp;
var Schet   : array [0..0] of double;
var Kod     : array [0..0] of double;
var VidOpl  : array [0..0] of double;
var KAU     : array [0..0] of Comp;
var Vsego   : array [0..0] of double;

function fNameFunc : string; forward;

/*
function PodrIsMarked: boolean;
{
  if MarkerNotNull
  {
    MyFlag:= false;
    for (i1:= 0; i1 < GetMarkerCount(mrkOuterClassfier); i1:= i1 + 1)
    {
      if (GetMarker(mrkOuterClassfier, i1, ClassSeg))
      {
        if GetFirst ExClassVal = tsOk
          MyFlag:= true;
      }
    }
    PodrIsMarked:= MyFlag;
  }
  else
    PodrIsMarked:= true;
}
*/

function  fNameFunc : string;
{

  if (GetMarkerCount(Marker) = 0)
  {
    Set fNameFunc := 'не установлен';
  }
  else
  {

    if GetMarkerCount(Marker)> 1
      set fNameFunc := 'По нескольким функциям <'+ string(GetMarkerCount(Marker))+ '>';
    else
    {
      GetMarker(Marker, 0, cTemp);

      if GetFirst fastfirstrow DepFunc1 where((cTemp == DepFunc1.cFunc)) = tsOk
        set fNameFunc := DepFunc1.cFunc +', '+ DepFunc1.nmFunc;

    }

  }

}

procedure FillnachislzakazSumByLschet;
{
  cCexOz := PodrMy.Nrec;



  insert into nachislzakazSum (Nrec, Summa, VidOpl, VidOplP, cLsch, Cex, CexOz, cPodrOz, Koldn, MesN, Mes, Summa30,Proc,
                          cSchetD,cSubSchD,cKAUD[1],cKAUD[2],cKAUD[3],cKAUD[4],cKAUD[5],cKAUD[6],
                        TblD[1],TblD[2],TblD[3],TblD[4],TblD[5],TblD[6],sReCalc, YearN, Tek, kod)
  select nachislzakaz.Nrec,
         nachislzakaz.Summa,
         nachislzakaz.VidOPlS,
         nachislzakaz.VidOPl,
         nachislzakaz.cLSch,
         nachislzakaz.Cex,
         nachislzakaz.CexOz,
         nachislzakaz.cPodr,
         nachislzakaz.Koldn,
         nachislzakaz.MesV,
         nachislzakaz.Mes,
         nachislzakaz.Summa30,
         nachislzakaz.Proc,
         nachislzakaz.cSchetD,
         nachislzakaz.cSubSchD,
         nachislzakaz.cKAUD[1],
         nachislzakaz.cKAUD[2],
         nachislzakaz.cKAUD[3],
         nachislzakaz.cKAUD[4],
         nachislzakaz.cKAUD[5],
         nachislzakaz.cKAUD[6],
         nachislzakaz.TblD[1],
         nachislzakaz.TblD[2],
         nachislzakaz.TblD[3],
         nachislzakaz.TblD[4],
         nachislzakaz.TblD[5],
         nachislzakaz.TblD[6],
         nachislzakaz.Otkuda,
         nachislzakaz.YearV,
         integer(2),
         RTrim(if (GetAnyKau(cgAkSimple, tmp_KlVidOpl.TBLEXTR[1], tmp_KlVidOpl.KAUEXTR[1]), GivenAnName(cgAnName), ''))
  from nachislzakaz,tmp_KlVidOpl where (( vFOT_NIK.cCexOz         == nachislzakaz.CexOz 
                       and vFOT_NIK.VIDYear     == nachislzakaz.YearV(noindex) 
                       and vFOT_NIK.VIDMonthN  <<= nachislzakaz.MesV(noindex) 
                       and vFOT_NIK.VIDMonthK  >>= nachislzakaz.MesV(noindex)
			and (nachislzakaz.cschetd<>'69' and nachislzakaz.cschetd<>'91' and nachislzakaz.cschetd<>'96')
                                     and nachislzakaz.VidOPlS     == tmp_KlVidOpl.VidOpl)) and nachislzakaz.Summa != 0;

}
screen scr1;
fields
  VIDYear      ('За какой год формировать отчета по видам неявок',hcNoContext,sci1Esc):noprotect,spinbutton [1, 1900, 2100];
  VIDMonthN    ('Укажите начальный месяц для формирования отчета',hcNoContext) :
    [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
          ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;
  VIDMonthK     ('Укажите месяц для формирования отчета',hcNoContext) :
    [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
          ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;

  NameFunc   ('Производственная функция', hcNoContext): protect,pickbutton;

  FiltrPodr('Заданный фильтр по подразделениям',, sci13Esc) :protect, PickButton;

buttons
  cmOk,,,'Сформировать отчет', ,sci1Esc;
  cmCancel,,,'Выход', ,sci1Esc;
<<
 `Формировать за год`.@@@@@      `с`.@@@@@@@@@@@@@ `по`.@@@@@@@@@@@@@

 `Функция`        .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `По подразделениям (цехам) отнесения затрат:`
                  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. ~С~формировать .>                            <.    ~О~тмена    .>

>>
end;

HandleEvent

cmInit:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);


  InitUser(1); // Инициализация Zar_User
  // Инициализация отчетных дат данными из настроек
  InitCurrentPeriodDates();

  if (not ReadMyDsk(VIDYear, 'VIDYear_FOT_NIK', false))
    set VIDYear := Word(YearRas);

  if (not ReadMyDsk(VIDMonthN, 'VIDMonthN_FOT_NIK', false))
    VIDMonthN := 1; // Январь (нумерация в списке с нуля).

  if (not ReadMyDsk(VIDMonthK, 'VIDMonthK_FOT_NIK', false))
    VIDMonthK := MonthRas;

  mtClear(#tmp_KlVidOpl, mfNormal);

  insert into tmp_KlVidOpl
  select KlVidOpl.Nrec, 
         KlVidOpl.Vidopl, 
         KlVidOpl.VidoplP, 
         KlVidOpl.NVIDOPL, 
         Trim(KlVidopl.VHVOE[19]),
         Trim(KlVidopl.VHVOE[32]), 
         Trim(KlVidopl.VHVOE[34]),
         Trim(KlVidopl.VHVOE[35]), 
         Trim(KlVidopl.VHVOE[5]),
         KlVidOpl.KAUEXTR[1],
         KlVidOpl.KAUEXTR[2],
         KlVidOpl.KAUEXTR[3],
         KlVidOpl.KAUEXTR[4],
         KlVidOpl.KAUEXTR[5],
         KlVidOpl.KAUEXTR[6],
         KlVidOpl.TBLEXTR[1],
         KlVidOpl.TBLEXTR[2],
         KlVidOpl.TBLEXTR[3],
         KlVidOpl.TBLEXTR[4],
         KlVidOpl.TBLEXTR[5],
         KlVidOpl.TBLEXTR[6]
  from KlVidOpl;

  Marker := InitMarker('MGetDepFunc', 8, 100, 10);

  NameFunc := fNameFunc();

  if not ReadMyDsk(Filtrpodr,'k_Filtrpodr',false)
    {}
  mrkOuterClassfier:=InitMarker('FOT_NIK_mrkOuterClassfier',8,20,10); //маркер с отмеченными классификаторами

  if GetMarkerCount(mrkOuterClassfier) = 0
    MarkerNotNull:= false;
  else MarkerNotNull:=true;

  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  StopVisual('', 0);
}

cmUpdateRecord : update current zar_user;

cmCheckField:
{
  case CurField of
    #VIDYear:
    {
      if (VIDYear < 1900) or (VIDYear > YearRas) then
        Set VIDYear := Word(YearRas);
      if (VIDYear = YearRas) and (VIDMonthK > MonthRas) then
        Set VIDMonthK := Word(MonthRas);
    }

    #VIDMonthN:
    {
      if (VIDMonthN > VIDMonthK)
        set VIDMonthN := VIDMonthK;
    }

    #VIDMonthK:
    {
      if (VIDYear = YearRas) and (VIDMonthK > MonthRas) then
        Set VIDMonthK := Word(MonthRas);
      if (VIDMonthN > VIDMonthK)
        set VIDMonthN := VIDMonthK;
    }
  end;  //case
}//cmCheckField

cmDelOnProtect:
{
  case CurField of
   #NameFunc:
   {
     ClearMarker(Marker);
   }
  end; // case
}

cmPick:
{

  case CurField of
   #NameFunc:
   {
    DoneMarker( Marker, 'MGetDepFunc' );
    if (RunInterface(M_Control::SelDepFn, lTemp, word(2)) <> cmCancel)
    {
     Marker  := InitMarker('MGetDepFunc', 8, 100, 10);
     iCount  := GetMarkerCount( Marker );
     NameFunc := fNameFunc();
    }
   }
   #FiltrPodr:
   {
     update current Zar_User;

     if RunInterface(Z_KatPodr::GetPodAln, comp(11), Zar_User.CurCex,p2) <> cmCancel
     {
       ReReadRecord(#Zar_User);
       if Getfirst KatPodr = 0 {};
     }

   }
  end; // case

  RedrawPanel(#Zar_User);
} // cmPick

cmOk:
{

  intinit;

  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  if not FillMarks then  // Заполнение Formarks
  {
    abort;
    exit;
  }

  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка к загрузке...', 1);

  mtClear(#PodrMy, mfNormal);

  sql
  select
  DEPFUNC.nmfunc,
  katpodr.kod,
  katpodr.name,
  katpodr.Nrec,
  KatPodr.cFunc
  from katpodr
  left join depfunc on katpodr.nrec=depfunc.cfunc
  into PodrMy
  ;

  _loop FullCache PodrMy
    if not Foundmarker(_PodrMArkerPointer, PodrMy.Nrec)
      delete current PodrMy;

  _loop FullCache PodrMy
    if not Foundmarker(Marker, PodrMy.cFunc)
      delete current PodrMy;

  var nom:integer;
  var Numcol:integer;
  nom:=2;
  Numcol:=1;

  ExcelPath:= TranslatePath('%ClientStartPath%');
                                                                                                          
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\FOT_NIK.xlsx',true);
  if (xlIsExcelValid)   xlSetActiveSheet(1);//активный лист

  XLPAGESETUPSETORIENTATION(xlLandscape);//альбомный лист
  XLPAGESETUPSETPAPERSIZE(xlPaperA4);//формат листа А4

  xlSetCellStringValue('ФОТ НИК c '+DateToStr(date(1,VIDMonthN,VIDYear), 'mon')
      +' по '+DateToStr(date(1,VIDMonthK,VIDYear), 'month')+' '+DateToStr(date(1,VIDMonthK,VIDYear), 'YYYY года'), 1, 3, 1, 3);
  xlSetFontStyle(xlBold, 1, 3, 1, 3);
  xlSetFontSize(18, 1, 3, 1, 3);

  nom:=3;
  Numcol:=4;

  _loop FullCache PodrMy
  {

    PodrNrec[Numcol-4] := PodrMy.Nrec;
    xlSetCellStringValue(PodrMy.kod  ,   nom, ++Numcol, nom, Numcol);

  }

  ItogCol := Numcol-5;

  xlSetCellStringValue('ВСЕГО'        ,   nom, ++Numcol, nom, Numcol);

  xlSetFontStyle(xlBold, nom, 4, nom, Numcol);
  xlAlignCellsEx(xlCenter,xlCenter, nom, 1, nom, Numcol); //текст в ячейке по центру
  xlSetColumnWidth(20, nom, 4, nom, Numcol); //ширина ячейки

  StopVisual('', 0);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Обработка информации...', RecordsInTable(#Formarks));

  mtClear(#nachislzakazSum, mfNormal);
 
  _loop FullCache PodrMy
  {

    if not NextVisual
      break;

    // заполняем временную таблицу для подсчета
    FillnachislzakazSumByLschet;

  }//_loop Formarks

  StopVisual('', 0);

  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfConfirm, 'Формирование отчета...', iCount);

  nom:=3;

  for(i := 0; i <= ItogCol; i++)
  {
    Schet[i] := Kod[i] := VidOpl[i] := KAU[i] := Vsego[i] := 0;
  }

  FOT_cSchetD := FOT_Kod := '';
  FOT_cKAUD   := FOT_VidOplP := 0 ;
 
  If getfirst fastfirstrow nachislzakazSum  = tsok
  {
    FOT_cSchetD := nachislzakazSum.cSchetD;
    FOT_Kod     := nachislzakazSum.Kod;
    FOT_VidOplP := nachislzakazSum.VidOplP;
    FOT_cKAUD   := nachislzakazSum.cKAUD[1];

  }

  _loop FullCache nachislzakazSum
  {

    if FOT_cKAUD != nachislzakazSum.cKAUD[1] or FOT_VidOplP != nachislzakazSum.VidOplP or FOT_Kod != nachislzakazSum.Kod or FOT_cSchetD != nachislzakazSum.cSchetD
    {

      Numcol:=1;
      xlSetCellStringValue(FOT_cSchetD                     , ++nom,   Numcol, nom, Numcol);
    
      xlSetCellStringValue(FOT_Kod                         ,   nom, ++Numcol, nom, Numcol);
    
      xlSetCellStringValue(FOT_VidOplP                     ,   nom, ++Numcol, nom, Numcol);

      if getfirst fastfirstrow mnplan where((FOT_cKAUD == mnplan.nrec)) = tsOK
        xlSetCellStringValue(mnplan.number                 ,   nom, ++Numcol, nom, Numcol);
      else Numcol++;

      for(i := 0; i <= ItogCol; i++)
      xlSetCellStringValue(VidOpl[i]                       ,   nom, ++Numcol, nom, Numcol);

      xlSetCellFormula('=СУММ(RC[-'+(ItogCol+1)+']:RC[-1])',   nom, ++Numcol, nom, Numcol);

      FOT_VidOplP := nachislzakazSum.VidOplP;
      FOT_cKAUD   := nachislzakazSum.cKAUD[1];

      for(i := 0; i <= ItogCol; i++)
        VidOpl[i]  := 0;
    }

    if FOT_Kod != nachislzakazSum.Kod or FOT_cSchetD != nachislzakazSum.cSchetD
    {

      Numcol:=1;
      xlSetCellStringValue('Итого по элементу ' + FOT_Kod , ++nom,   Numcol, nom, Numcol);
    
      Numcol += 3;

      for(i := 0; i <= ItogCol; i++)
      xlSetCellStringValue(Kod[i]                         ,   nom, ++Numcol, nom, Numcol);

      xlSetCellFormula('=СУММ(RC[-'+(ItogCol+1)+']:RC[-1])'   ,   nom, ++Numcol, nom, Numcol);

      xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      FOT_Kod := nachislzakazSum.Kod;

      for(i := 0; i <= ItogCol; i++)
        Kod[i]  := 0;
    }

    if FOT_cSchetD != nachislzakazSum.cSchetD
    {

      Numcol:=1;
      xlSetCellStringValue('Итого по счету ' + FOT_cSchetD, ++nom,   Numcol, nom, Numcol);
    
      Numcol += 3 ;

      for(i := 0; i <= ItogCol; i++)
      xlSetCellStringValue(Schet[i]                       ,   nom, ++Numcol, nom, Numcol);

      xlSetCellFormula('=СУММ(RC[-'+(ItogCol+1)+']:RC[-1])'   ,   nom, ++Numcol, nom, Numcol);

      xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
      xlSetFontStyle(xlBold , nom, 1, nom, Numcol);

      FOT_cSchetD := nachislzakazSum.cSchetD;

      for(i := 0; i <= ItogCol; i++)
        Schet[i]  := 0;
    }

    for(i := 0; i <= ItogCol; i++)
    {

      if PodrNrec[i] = nachislzakazSum.CexOz
      {
        VidOpl[i]       += nachislzakazSum.Summa;
        Kod[i]          += nachislzakazSum.Summa;
        Schet[i]        += nachislzakazSum.Summa;
        KAU[i]          += nachislzakazSum.Summa;
        Vsego[i]        += nachislzakazSum.Summa;
      }
      else
        Numcol ++;

    }

  } //_loop nachislzakazSum

  var IVidOpl : double;
  IVidOpl := 0;

  for(i := 0; i <= ItogCol; i++)
    IVidOpl += VidOpl[i];

  if IVidOpl != 0
  {

    Numcol:=1;
    xlSetCellStringValue(FOT_cSchetD                     , ++nom,   Numcol, nom, Numcol);
  
    xlSetCellStringValue(FOT_Kod                         ,   nom, ++Numcol, nom, Numcol);
  
    xlSetCellStringValue(FOT_VidOplP                     ,   nom, ++Numcol, nom, Numcol);

    if getfirst fastfirstrow mnplan where((FOT_cKAUD == mnplan.nrec)) = tsOK
      xlSetCellStringValue(mnplan.number                 ,   nom, ++Numcol, nom, Numcol);
    else Numcol++;

    for(i := 0; i <= ItogCol; i++)
    xlSetCellStringValue(VidOpl[i]                       ,   nom, ++Numcol, nom, Numcol);

    xlSetCellFormula('=СУММ(RC[-'+(ItogCol+1)+']:RC[-1])',   nom, ++Numcol, nom, Numcol);
  }

  var IKod : double;
  IKod := 0;

  for(i := 0; i <= ItogCol; i++)
    IKod += Kod[i];

  if IKod != 0
  {

    Numcol:=1;
    xlSetCellStringValue('Итого по элементу ' + FOT_Kod , ++nom,   Numcol, nom, Numcol);
  
    Numcol += 3;

    for(i := 0; i <= ItogCol; i++)
    xlSetCellStringValue(Kod[i]                         ,   nom, ++Numcol, nom, Numcol);

    xlSetCellFormula('=СУММ(RC[-'+(ItogCol+1)+']:RC[-1])'   ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  }

  var ISchet : double;
  ISchet := 0;

  for(i := 0; i <= ItogCol; i++)
    ISchet += Schet[i];

  if ISchet != 0
  {

    Numcol:=1;
    xlSetCellStringValue('Итого по счету ' + FOT_cSchetD, ++nom,   Numcol, nom, Numcol);
  
    Numcol += 3 ;

    for(i := 0; i <= ItogCol; i++)
    xlSetCellStringValue(Schet[i]                       ,   nom, ++Numcol, nom, Numcol);

    xlSetCellFormula('=СУММ(RC[-'+(ItogCol+1)+']:RC[-1])'   ,   nom, ++Numcol, nom, Numcol);

    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  }

  var IVsego : double;
  IVsego := 0;

  for(i := 0; i <= ItogCol; i++)
    IVsego += Vsego[i];

  if IVsego != 0
  {
 
    Numcol:=1;
    xlSetCellStringValue('ВСЕГО'                        , ++nom,   Numcol, nom, Numcol);
    
    Numcol += 3 ;
    
    for(i := 0; i <= ItogCol; i++)
    xlSetCellStringValue(Vsego[i]                       ,   nom, ++Numcol, nom, Numcol);
    
    xlSetCellFormula('=СУММ(RC[-'+(ItogCol+1)+']:RC[-1])'   ,   nom, ++Numcol, nom, Numcol);
    
    xlMergeCells(nom, 1, nom, 4);// об]единение ячеек
    xlSetFontStyle(xlBold , nom, 1, nom, Numcol);
  }

  xlWrapText(3, 1, nom, Numcol);//перенос по словам
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB + xlInsideV + xlInsideH,
                      xlThin, xlContinuous, 0, 3, 1, nom, Numcol);//рамка xlThick - жирная

  StopVisual('',0);
  xlkillExcel;

  exitproc;

}

cmClose:
{
  SaveMyDSK(VIDYear,   'VIDYear_FOT_NIK');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_FOT_NIK');
  SaveMyDSK(VIDMonthK, 'VIDMonthK_FOT_NIK');
  SaveMyDsk(FiltrPodr, 'k_FiltrPodr');
  DoneMarker(_PodrMArkerPointer,'');
  DoneMarker(mrkOuterClassfier,'FOT_NIK_mrkOuterClassfier');

  DoneMarker( Marker, 'MGetDepFunc');
}

cmDone:
{
  SaveMyDSK(VIDYear,   'VIDYear_FOT_NIK');
  SaveMyDSK(VIDMonthN, 'VIDMonthN_FOT_NIK');
  SaveMyDSK(VIDMonthK, 'VIDMonthK_FOT_NIK');
  SaveMyDsk(FiltrPodr, 'k_FiltrPodr');
  DoneMarker(_PodrMArkerPointer,'');
  DoneMarker(mrkOuterClassfier,'FOT_NIK_mrkOuterClassfier');

  DoneMarker( Marker, 'MGetDepFunc');
}

end;
end.

#include UserReport.vih

VipInterface UserReport_gp_FOT_NIK Implements IUserReport;
Interface UserReport_gp_FOT_NIK;

Procedure Run;
Begin
  runinterface(gp_FOT_NIK);
End;

Function GetReportName: String;
Begin
  GetReportName := 'ФОТ НИК';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
