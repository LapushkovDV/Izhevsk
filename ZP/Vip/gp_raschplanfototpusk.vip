/*************************************************************************************************\
* Наименование:  Расчет планового ФОТ на отпуска по году                                          *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3886          |21/01/18 |Ермолов К.Р.            |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih

interface gp_raschplanfototpusk 'Параметры отчета' gray
Show at (,,20,5);

table struct tab1
(
tabnum: string,
fio: string,
koldays: double,
sum: decimal(31,15),
itogo: decimal(31,15)
)
with index
(
i1 = tabnum + fio (unique)
)
;

create view

var
ExcelPath: string;
counter, countermatrix: longint;
god: integer;
psum: double;

as select * from tab1;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  god: noprotect, spinbutton [1, 1917, 2117];
  buttons
  cmGo, ,, 'Сформировать' ,,;
  <<

  Год: .@@@@@

  <.Сформировать.>

  >>
end;

handleevent

cmInit:
{
  god:= year(cur_date);
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from tab1;

  sql
  select lschet.strtabn, persons.fio, sum(planotpusk.duration), avg(arxshtrf.sumnach), sum(planotpusk.duration) * avg(arxshtrf.sumnach)
  from planotpusk
  left join appointments on appointments.nrec = planotpusk.appoint and appointments.lprizn = 0
  inner join lschet on lschet.nrec = appointments.caddnrec2
  left join arxshtrf on arxshtrf.clsch = lschet.nrec and cast(substring(date2str('%yyyy', arxshtrf.datan),1,4) as integer) = :(god) - 1 and arxshtrf.vidud = 1
  left join persons on persons.nrec = lschet.tperson
  where cast(substring(date2str('%yyyy', planotpusk.planyearbeg),1,4) as integer) = :(god) and planotpusk.wstatus = 0
  and (persons.disdate = 0 or cast(substring(date2str('%yyyy', persons.disdate),1,4) as integer) > :(god) - 1)
  group by lschet.strtabn, persons.fio
  into tab1
  ;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_raschplanfototpusk.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  xlSetCellStringValue('Расчет планового ФОТ на отпуска за ' + god + ' год', 1, 1, 1, 1);

  xlCreateMatrix(1000, 5);

  psum:= 0;
  countermatrix:= 0;
  counter:= 3;

  _loop tab1
  {
    countermatrix++;
    psum:= psum + tab1.itogo;
    xlStWriteToMatrix(countermatrix, 1, tab1.tabnum);
    xlStWriteToMatrix(countermatrix, 2, tab1.fio);
    xlStWriteToMatrix(countermatrix, 3, tab1.koldays);
    xlStWriteToMatrix(countermatrix, 4, tab1.sum);
    xlStWriteToMatrix(countermatrix, 5, tab1.itogo);

    if countermatrix = 1000
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  xlFreeMatrix;

  xlMergeCells(counter, 1, counter, 4);
  xlSetCellStringValue('ИТОГО', counter, 1, counter, 1);
  xlAlignCells(-4152, counter, 1, counter, 1);
  xlSetFontStyle(1, counter, 1, counter, 5);
  xlSetCellNumberValue(psum, counter, 5, counter, 5);

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 5);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_raschplanfototpusk Implements IUserReport;
Interface UserReport_raschplanfototpusk;

Procedure Run;
Begin
  runinterface(gp_raschplanfototpusk);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Расчет планового ФОТ на отпуска по году';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Сводные отчеты по зарплате';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
