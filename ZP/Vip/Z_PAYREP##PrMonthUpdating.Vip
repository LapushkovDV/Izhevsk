/*************************************************************************************************\
* Наименование: Информация о начислениях и выплатах заработной платы по периодам                  *
* Контур/Модуль:Заработная плата                                                                  *
* Примечание: Если ведомость формируется без расчета, то Prmonth.tPerson=0                        *
*             и как следствие spplved.tperson=0                                                   *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#000          |22/07/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#component "Z_PAYREP"
#doc
 Информация о начислениях и выплатах заработной платы по периодам
 Если ведомость формируется без расчета, то Prmonth.tPerson=0                        *
 и как следствие spplved.tperson=0
 update prmonth from Lschet where (( 0 == prmonth.tperson(noindex) and prmonth.clsch /==lschet.nrec )) set prmonth.tperson:=Lschet.tPerson;
 update spplved from Lschet where (( 0 == spplved.tperson(noindex) and spplved.clsch /==lschet.nrec )) set spplved.tperson:=Lschet.tPerson;
 Все равно не помогает.

#end

Alter Interface PrMonthUpdating;
OverLoad
  procedure CheckPrMonthRecordAndInsIfNecessary(B: TYPE$PRMONTH);
end;
//------------------------------------------------------------------------------
// Создаем в таблице PRMONTH запись для очередного месяца при ее отсутствии
//------------------------------------------------------------------------------
procedure CheckPrMonthRecordAndInsIfNecessary(B: TYPE$PRMONTH);
{
  // при отсутствии записи PRMONTH для создаваемого периода
  if getfirst NextPrmonth where ((B.CLSCH == NextPrmonth.CLSCH
    and NextYear == NextPrmonth.YEARN and NextMonth == NextPrmonth.MESN)) <> tsOk
  {
    // если вставляемый период не является расчетным или следующим за ним
    //if (AM_FirstDate(NewMonth, NewYear) > Add_Months(FirstDayRas, 1))
    //or (AM_FirstDate(NewMonth, NewYear) < FirstDayRas)
    if Months_Between(AM_FirstDate(NextMonth, NextYear), FirstDayRas) > 1
      exit;

    ClearBuffer(#NextPrmonth);
    NextPrmonth.CLSCH   := B.CLSCH;
    NextPrmonth.CEX     := B.CEX;
    NextPrmonth.TABN    := B.TABN;
    NextPrmonth.STRTABN := B.STRTABN;
    NextPrmonth.YEARN   := NextYear;
    NextPrmonth.MESN    := NextMonth;
    insert current NextPrmonth;
  }
#IFDEF _GP_
  if NextPrmonth.tPerson=0
  { if getfirst Lschet where (( NextPrmonth.CLSCH == Lschet.Nrec )) =tsok
    { update current NextPrmonth set NextPrmonth.tPerson:=Lschet.tPerson;
    }
  }
#ENDIF
} //CheckPrMonthRecordAndInsIfNecessary
end.
