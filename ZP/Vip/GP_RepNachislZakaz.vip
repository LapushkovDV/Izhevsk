#include UserReport.vih

VipInterface UserReport_GP_RepNachislZakaz implements IUserReport;
interface UserReport_GP_RepNachislZakaz 'Начисленная з/п по счетам';
show (,,55,4);
table struct tRep (mesN: word, yearN: word, cSchetD: string, smAll: double, sm957: double) (i1 = yearN + mesN + cSchetD);

create view
var dBeg, dEnd: date;
as select * from tRep;

screen sc1 (,,sci1EnEsc);
notablenavigation;
fields
  dBeg: noProtect;
  dEnd: noProtect;
buttons
  cmOK;
  cmCancel;
<<

`Период формирования с` .@@@@@@@@@@@ `по` .@@@@@@@@@@@

 <. Сформировать .>                <.    Отмена    .>
>>
end;

function GetData: boolean;
var dBegLong, dEndLong: longint;
{
  Result := false;
  dBegLong := Year(dBeg) * 100 + Month(dBeg);
  dEndLong := Year(dEnd) * 100 + Month(dEnd);

  mtClear(tntRep, mfNormal);
  sql select
      NachislZakaz.MesN
    , NachislZakaz.YearN
    , NachislZakaz.cSchetD
    , sum(case when KatPodr.Kod <> '446' then NachislZakaz.Summa else 0.0 end) smAll: double
    , sum(case when KatPodr.Kod like '957%' then NachislZakaz.Summa else 0.0 end) sm957: double
    from NachislZakaz
    inner join KatPodr on NachislZakaz.Cex = KatPodr.Nrec
    inner join klvidopl on nachislzakaz.vidopls=klvidopl.vidopl and KLVIDOPL.NALG<>98
    where ((NachislZakaz.YearN * 100 + NachislZakaz.MesN) between :(dBegLong) and :(dEndLong))
           and katpodr.kod not in ('Вет%' , '_%')
    group by
      NachislZakaz.MesN
    , NachislZakaz.YearN
    , NachislZakaz.cSchetD
  into tRep ByName;

  Result := getfirst tRep = tsOK;
  if not Result
    message('Нет данных для формирования отчета!', Warning);
}

function PrintReport: boolean;
var r1, kolR, kolC, i, j: longint;
{
  Result := false;
  if not xlCreateExcel('', true)
  {
    message('Ошибка запуска Excel', error);
    exit;
  }

  r1 := 2;
  kolC := 4;
  kolR := RecordsInTable(tntRep) + 1;
  xlCreateMatrix(kolR, kolC);

  xlSetCellStringValue('Начисленная з/п по счетам', 1, 1, 1, 1);
  xlSetFontStyle(xlBold, 1, 1, 2, kolC);
  xlMergeCells(1, 1, 1, kolC);
  xlAlignCellsEx(xlCenter, xlCenter, 1, 1, 2, kolC);
  xlSetNumberFormat('@', r1, 1, r1 + kolR - 1, kolC);
  xlSetNumberFormat('### ### ### ##0'+xlGetDecimalSeparator+'00;-### ### ### ##0'+xlGetDecimalSeparator+'00;', r1 + 1, 3, r1 + kolR - 1, 4);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, r1, 1, r1 + kolR - 1, kolC);
  xlAutoFit(r1, 1, r1 + kolR - 1, kolC);
  xlSetColumnWidth(20, 1, 1, 1, kolC);

  i := 0;
  j := 0;
  xlStWriteToMatrix(++i, ++j, 'Период');
  xlStWriteToMatrix(  i, ++j, 'Счет Дт');
  xlStWriteToMatrix(  i, ++j, 'Начислено');
  xlStWriteToMatrix(  i, ++j, '957');
  _loop tRep ordered by index i1
  {
    j := 0;
    xlStWriteToMatrix(++i, ++j, DateToStr(date(1, tRep.mesN, tRep.yearN), 'Month YYYY'));
    xlStWriteToMatrix(  i, ++j, tRep.cSchetD);
    xlDoWriteToMatrix(  i, ++j, tRep.smAll);
    xlDoWriteToMatrix(  i, ++j, tRep.sm957);
  }

  xlWriteMatrixToExcel(r1, 1);
  xlKillExcel;
  Result := true;
}
handleEvent
  cmOK:
  {
    StartNewVisual(vtRotateVisual, vfTimer, 'Формирование отчета', 0);
    if GetData
      PrintReport;
    StopVisual;
  }
end;
!-------------------------------------------------------------------------------
procedure Run;
{
  RunWindowModal(wnMainWindow);
}
function GetReportName: String;
{
  Result := 'Начисленная з/п по счетам';
}
function GetGroupName (Level : Word) : String;
{
  #__UNUSED__(Level)
  Result := '';
}
function GetPriority : Integer;
{
  Result := 0;
}
function VisibleInModule(Ind : Byte) : String;
{
  Result := '';
  case Ind of
    1 : Result := 'MENUZARP';
  end;
}
!-------------------------------------------------------------------------------
end.
