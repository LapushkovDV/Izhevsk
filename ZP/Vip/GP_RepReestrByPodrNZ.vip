#include UserReport.vih
#include Query.vih

VipInterface UserReport_GP_RepReestrByPodrNZ implements IUserReport;
interface UserReport_GP_RepReestrByPodrNZ 'Реестры на перечисление по подразделениям (одноразовый)';
show (,,40,4);

table struct tRepZpByDept (kod: string, name: string, sumNach: double, sumUd: double, sumGoz: double, sumOther: double, sumExc: double) (i1 = kod);
table struct tRepZpByTabN (kod: string, name: string, tabn: string, sumNach: double, sumUd: double, sumGoz: double, sumOther: double, sumExc: double) (i1 = kod + tabn);
create view
var dReport: date;
    sVPlan0, sVPlan1, sVPlan2, sVPlan3: string;
as select *
from
  tRepZpByDept
, tRepZpByTabN
;

screen sc1;
notablenavigation;
fields
  dReport: [, 'Month YYYY'], noprotect;
buttons
  cmOK;
  cmCancel;
<<
 `Период` .@@@@@@@@@@@@@@@@@@@@@@

  <. Сформировать .> <.    Отмена    .>
>>
end;

var eps: array [1..1] of double;
procedure PrepareRoundErrors(maxCol: word);
var i: longint;
{
  SetLimit(eps, maxCol);
  for (i := 1; i <= maxCol; i++)
    eps[i] := 0;
}
function xlRdWriteToMatrix(row, col: longint; value: double; precision: integer = 2): boolean;
var v: double;
{
  v := Round(value + eps[col], precision);
  eps[col] := value + eps[col] - v;
  Result := XLDOWRITETOMATRIX(row, col, v);
}

function PrintRepZpByDept: boolean;
var r1, kolR, kolC, i, j, npp: longint;
{
  Result := false;
  XLSETACTIVESHEETBYNAME('Реестр ЗП по подразд.');
  XLSETCELLSTRINGVALUE(DateToStr(dReport, 'month YYYY'), 2, 1, 2, 1);
  r1 := 9;
  kolC := 10;
  kolR := RecordsInTable(tntRepZpByDept);
  PrepareRoundErrors(kolC);
  XLCREATEMATRIX(kolR, kolC);
  if KolR > 2 then XLINSERTRANGE(xlShiftDown, r1 + 1, 1, r1 + KolR - 2, KolC);
  if KolR < 2 then XLDELETERANGE(xlShiftUp, r1, 1, r1 + 1 - KolR, KolC);
  i := npp := 0;
  _loop tRepZpByDept ordered by tRepZpByDept.kod
  {
    j := 0;
    XLDOWRITETOMATRIX(++i, ++j, ++npp);
    XLSTWRITETOMATRIX(  i, ++j, tRepZpByDept.kod);
    XLSTWRITETOMATRIX(  i, ++j, tRepZpByDept.name);
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumNach);
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumUd);
    XLSTWRITETOMATRIX(  i, ++j, '=RC[1]+RC[2]');
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumGoz);
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumOther);
    xlRdWriteToMatrix(  i, ++j, tRepZpByDept.sumExc);
    XLSTWRITETOMATRIX(  i, ++j, '=RC[-2]-RC[-1]');
  }
  XLWRITEMATRIXTOEXCEL(r1, 1);
  Result := true;
}

function PrintRepZpByTabN: boolean;
var r1, kolR, kolC, i, j, npp: longint;
{
  Result := false;
  XLSETACTIVESHEETBYNAME('Реестр ЗП по сотрудникам');
  XLSETCELLSTRINGVALUE(DateToStr(dReport, 'month YYYY'), 2, 1, 2, 1);
  r1 := 9;
  kolC := 10;
  kolR := RecordsInTable(tntRepZpByTabN);
  PrepareRoundErrors(kolC);
  XLCREATEMATRIX(kolR, kolC);
  if KolR > 2 then XLINSERTRANGE(xlShiftDown, r1 + 1, 1, r1 + KolR - 2, KolC);
  if KolR < 2 then XLDELETERANGE(xlShiftUp, r1, 1, r1 + 1 - KolR, KolC);
  i := npp := 0;
  _loop tRepZpByTabN ordered by tRepZpByTabN.kod, tRepZpByTabN.tabn
  {
    j := 0;
    XLDOWRITETOMATRIX(++i, ++j, ++npp);
    XLSTWRITETOMATRIX(  i, ++j, tRepZpByTabN.tabn);
    XLSTWRITETOMATRIX(  i, ++j, tRepZpByTabN.kod);
    xlRdWriteToMatrix(  i, ++j, tRepZpByTabN.sumNach);
    xlRdWriteToMatrix(  i, ++j, tRepZpByTabN.sumUd);
    XLSTWRITETOMATRIX(  i, ++j, '=RC[1]+RC[2]');
    xlRdWriteToMatrix(  i, ++j, tRepZpByTabN.sumGoz);
    xlRdWriteToMatrix(  i, ++j, tRepZpByTabN.sumOther);
    xlRdWriteToMatrix(  i, ++j, tRepZpByTabN.sumExc);
    XLSTWRITETOMATRIX(  i, ++j, '=RC[-2]-RC[-1]');
  }
  XLWRITEMATRIXTOEXCEL(r1, 1);
  Result := true;
}

function PrintReports: boolean;
var sXl: string;
{
  Result := false;
  sXl := TranslatePath('%StartPath%XLS_ЭМ\ZP\GP_RepReestrBySchet.xlt');
  if not ExistFile(sXl)
  {
    message('Не найден шаблон'#13 + sXl, error);
    exit;
  }
  if not XLCREATEEXCELWITHTEMPLATE(sXl, true)
  {
    message('Ошибка запуска шаблона'#13 + sXl, error);
    exit;
  }
  XLDISPLAYALERTS(false);

  XLDELETESHEETBYNAME('Реестр платежей ЗП');
  XLDELETESHEETBYNAME('Реестр платежей НДФЛ');
  XLDELETESHEETBYNAME('Реестр страховых взносов');
  if getfirst tRepZpByDept = tsOk
    PrintRepZpByDept;
  if getfirst tRepZpByTabN = tsOk
    PrintRepZpByTabN;
  XLKILLEXCEL;
  Result := true;
}

function FillCommonData: boolean;
var objQuery: IQuery;
    yearN, mesN: word;
{
  Result := false;
  var cANUns: comp = ExtAttr_ID(coMnPlan, 'Несубсидируемое');
  sVPlan0 := 'Несубсидируемое';
  sVPlan1 := '0100 001';
  sVPlan2 := '0888 001';
  sVPlan3 := '0888 013';
  yearN := Year(dReport);
  mesN := Month(dReport);
  sqlCreateTmpTable('table tReeBySchetSumZ (cLSchet: comp, sumUnSub: double, sumAll: double) with index (i1 = cLSchet);', ctmNormal);
  objQuery := queryManager.createQuery(SQLQUERY(.
    insert tReeBySchetSumZ (cLSchet, sumUnSub, sumAll)
    select
      NachislZakaz.cLsch
    , sum(case when NachislZakaz.cSchetD not in ('20','23','25','26','96') or coalesce(AttrVal.vLongint, 0) = 1 then NachislZakaz.Summa else 0.0 end) 
    , sum(NachislZakaz.Summa)
    from NachislZakaz
    left join MnPlan on NachislZakaz.cKauD[1] = MnPlan.NRec
    left join AttrVal on 11027 = AttrVal.wTable and MnPlan.NRec = AttrVal.cRec and :(cAnUns) = AttrVal.cAttrNam 
    inner join KlVidOpl on NachislZakaz.VidOpls = KlVidOpl.VidOpl and KlVidOpl.NAlg <> 98 and KlVidOpl.cSchetD <> '91' and KlVidOpl.cSchetD <> '44' and KlVidOpl.cSchetD <> '69' and KlVidOpl.cSchetD <> '76'
    where NachislZakaz.YearN = :(yearN) and NachislZakaz.MesN = :(MesN)
    group by NachislZakaz.cLsch
  .));
  if (objQuery.execute.errorCode <> tsOk)
  {
    message('Ошибка выборки начислений по заказам: ' + objQuery.errorCode, error);
    exit;
  } 
  mtClear(tntRepZpByDept, mfNormal);

  Result := true;
}

function GetDataZpByDept: boolean;
var cAttrVPlan: comp;
    yearN, mesN, yearNext, mesNext: word;
    objQuery: IQuery;
{
  Result := false;
  cAttrVPlan := ExtAttr_ID(coSbBan, 'Группа заказов');
  yearN := Year(dReport);
  mesN := Month(dReport);
  yearNext := Year(Add_Months(dReport, 1));
  mesNext := Month(Add_Months(dReport, 1));

  //внутри запроса задумывалось надолго
  sqlCreateTmpTable('table tReeBySchetSumRee (CexOz: comp, sumGoz: double, sumOther: double, sumExc: double) with index (i1 = CexOz);', ctmNormal);
  objQuery := queryManager.createQuery(SQLQUERY(.
    insert tReeBySchetSumRee (CexOz, sumGoz, sumOther, sumExc)
    select
      ZarOperInfo.CexOz
    , ZarOperInfo.sumGoz
    , (ZarOperInfo.sumAll - ZarOperInfo.sumGoz)
    , ZarOperInfo.sumUnSubs + (ZarOperInfo.sumAll - ZarOperInfo.sumGoz - ZarOperInfo.sumUnSubs) * case when tReeBySchetSumZ.cLSchet is null then 0.0 else tReeBySchetSumZ.sumUnSub / tReeBySchetSumZ.sumAll end
    from
    (
      select
        ZarOper.CexOz
      , ZarOper.cLschet
      , sum(case when coalesce(AttrVal.vString, '') not in ('', :(svPlan0), :(sVPlan1), :(sVPlan2), :(sVPlan3)) then ZarOper.Summa else 0.0 end) sumGoz: double
      , sum(case 
          when coalesce(AttrVal.vString, '') in ('', :(svPlan0), :(sVPlan1), :(sVPlan2), :(sVPlan3)) 
           and (KlVidOpl.VidOplP in (102, 83, 84, 95, 78, 79, 80, 81, 97) or SubString(KatPodr.Kod,1,3) in ('446', '957'))
          then ZarOper.Summa 
          else 0.0 end) sumUnSubs: double
      , sum(ZarOper.Summa) sumAll: double
      from SbBan
      left join AttrVal on 16060 = AttrVal.wTable and SbBan.NRec = AttrVal.cRec and :(cAttrVPlan) = AttrVal.cAttrNam
      inner join SpPlBan on SbBan.NRec = SpPlBan.cSbban
      inner join ZarOper on SpPlBan.NRec = ZarOper.cPlPor and 16061 = ZarOper.PrizPr
      left join KlVidOpl on ZarOper.FilialNo = KlVidOpl.VidOpl
      left join KatPodr on ZarOper.CexOz = KatPodr.NRec
      where SbBan.DataN = :(dReport) and SbBan.PrizDel in (1,2) and SbBan.Prefix <> 'R$$'
      group by
        ZarOper.CexOz
      , ZarOper.cLschet
    ) ZarOperInfo
    left join tReeBySchetSumZ on ZarOperInfo.cLschet = tReeBySchetSumZ.cLSchet and tReeBySchetSumZ.sumAll <> 0.0
  .));
  if (objQuery.execute.errorCode <> tsOk)
  {
    message('Ошибка выборки ЗП по подразделениям (реестры): ' + objQuery.errorCode, error);
    exit;
  }

  objQuery := queryManager.createQuery(SQLQUERY(.
    select
      coalesce(KatPodr.Kod, '-') Kod
    , coalesce(KatPodr.Name, '-') Name
    , sum(NachUd.sumNach) sumNach
    , sum(NachUd.sumUd) sumUd
    , sum(NachUd.sumGoz) sumGoz
    , sum(NachUd.sumOther) sumOther
    , sum(NachUd.sumExc) sumExc
    from 
    (
      select 
        Nachisl.CexOz
      , sum(Nachisl.Summa) sumNach
      , 0.0 sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from Nachisl
      where Nachisl.YearN = :(yearN) and Nachisl.MesN = :(mesN)
      group by Nachisl.CexOz

      union all
      select 
        SumVidOp.CexOz
      , sum(SumVidOp.Summa) sumNach
      , 0.0 sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from SumVidOp
      where SumVidOp.YearN = :(yearN) and SumVidOp.MesN = :(mesN)
      group by SumVidOp.CexOz

      union all
      select 
        Uder.CexOz 
      , 0.0 sumNach
      , sum(Uder.SumUd) sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from Uder
      inner join KlVidUd on Uder.VidUds = KlVidUd.VidUd and KlVidUd.VidUdP not in (226, 253, 236)
      where Uder.YearN = :(yearN) and Uder.MesN = :(mesN) 
      group by Uder.CexOz

      union all
      select 
        SumVidUd.CexOz
      , 0.0 sumNach
      , sum(SumVidUd.SumUd) sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from SumVidUd
      inner join KlVidUd on SumVidUd.VidUd = KlVidUd.VidUd and KlVidUd.VidUdP not in (226, 253, 236)
      where SumVidUd.YearN = :(yearN) and SumVidUd.MesN = :(mesN) 
      group by SumVidUd.CexOz

      union all
      select
        PrMonth.Cex CexOz
      , 0.0 sumNach
      , sum(PrMonth.Summa9) sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from PrMonth
      where PrMonth.YearN = :(yearNext) and PrMonth.MesN = :(mesNext) and PrMonth.Summa9 <> 0
      group by PrMonth.Cex

      union all
      select
        tReeBySchetSumRee.CexOz
        , 0.0 sumNach
        , 0.0 sumUd
        , tReeBySchetSumRee.sumGoz
        , tReeBySchetSumRee.sumOther
        , tReeBySchetSumRee.sumExc
      from tReeBySchetSumRee
    ) NachUd
    inner join KatPodr on NachUd.CexOz = KatPodr.NRec and SubString(KatPodr.Kod, 1, 3) <> '446'
    group by
      coalesce(KatPodr.Kod, '-')
    , coalesce(KatPodr.Name, '-')
  .));
  if (objQuery.execute.errorCode = tsOk)
    sqlCopyInto(objQuery, tntRepZpByDept, true);
  else
  {
    message('Ошибка выборки ЗП по подразделениям: ' + objQuery.errorCode, error);
    exit;
  }
  sqlDropTmpTable('tReeBySchetSumRee');
  Result := true;
}


function GetDataZpByTabN: boolean;
var cAttrVPlan: comp;
    yearN, mesN, yearNext, mesNext: word;
    objQuery: IQuery;
{
  Result := false;
  cAttrVPlan := ExtAttr_ID(coSbBan, 'Группа заказов');
  yearN := Year(dReport);
  mesN := Month(dReport);
  yearNext := Year(Add_Months(dReport, 1));
  mesNext := Month(Add_Months(dReport, 1));

  //внутри запроса задумывалось надолго
  sqlCreateTmpTable('table tReeBySchetSumRee (CexOz: comp, cLSch: comp, sumGoz: double, sumOther: double, sumExc: double) with index (i1 = CexOz);', ctmNormal);
  objQuery := queryManager.createQuery(SQLQUERY(.
    insert tReeBySchetSumRee (CexOz, cLSch, sumGoz, sumOther, sumExc)
    select
      ZarOperInfo.CexOz
    , ZarOperInfo.cLSch
    , ZarOperInfo.sumGoz
    , (ZarOperInfo.sumAll - ZarOperInfo.sumGoz)
    , ZarOperInfo.sumUnSubs + (ZarOperInfo.sumAll - ZarOperInfo.sumGoz - ZarOperInfo.sumUnSubs) * case when tReeBySchetSumZ.cLSchet is null then 0.0 else tReeBySchetSumZ.sumUnSub / tReeBySchetSumZ.sumAll end
    from
    (
      select
        ZarOper.CexOz
      , ZarOper.cLschet cLsch
      , sum(case when coalesce(AttrVal.vString, '') not in ('', :(svPlan0), :(sVPlan1), :(sVPlan2), :(sVPlan3)) then ZarOper.Summa else 0.0 end) sumGoz: double
      , sum(case 
          when coalesce(AttrVal.vString, '') in ('', :(svPlan0), :(sVPlan1), :(sVPlan2), :(sVPlan3)) 
           and (KlVidOpl.VidOplP in (102, 83, 84, 95, 78, 79, 80, 81, 97) or SubString(KatPodr.Kod,1,3) in ('446', '957'))
          then ZarOper.Summa 
          else 0.0 end) sumUnSubs: double
      , sum(ZarOper.Summa) sumAll: double
      from SbBan
      left join AttrVal on 16060 = AttrVal.wTable and SbBan.NRec = AttrVal.cRec and :(cAttrVPlan) = AttrVal.cAttrNam
      inner join SpPlBan on SbBan.NRec = SpPlBan.cSbban
      inner join ZarOper on SpPlBan.NRec = ZarOper.cPlPor and 16061 = ZarOper.PrizPr
      left join KlVidOpl on ZarOper.FilialNo = KlVidOpl.VidOpl
      left join KatPodr on ZarOper.CexOz = KatPodr.NRec

      left join DocPodot on 3 = DocPodot.TipDoc and SbBan.NRec = DocPodot.cVtDoc
      left join DocPodot DocPodotUp on 3 = DocPodotUp.TipDoc and SbBan.cNode = DocPodotUp.cVtDoc
      left join KlVidUd on SbBan.VidUd = KlVidUd.VidUd
      where SbBan.DataN = :(dReport) and SbBan.PrizDel in (1,2) and SbBan.Prefix <> 'R$$'
            and (DocPodot.NRec is not null or DocPodotUp.NRec is not null) //and KlVidUd.VidUdP not in (213, 226, 253, 236) 
            
      group by
        ZarOper.CexOz
      , ZarOper.cLschet
    ) ZarOperInfo
    left join tReeBySchetSumZ on ZarOperInfo.cLsch = tReeBySchetSumZ.cLSchet and tReeBySchetSumZ.sumAll <> 0.0
  .));
  if (objQuery.execute.errorCode <> tsOk)
  {
    message('Ошибка выборки ЗП по подразделениям (реестры): ' + objQuery.errorCode, error);
    exit;
  }

  objQuery := queryManager.createQuery(SQLQUERY(.
    select
      coalesce(KatPodr.Kod, '-') Kod
    , coalesce(KatPodr.Name, '-') Name
    , coalesce(LSchet.StrTabN, '-') TabN
    , sum(NachUd.sumNach) sumNach
    , sum(NachUd.sumUd) sumUd
    , sum(NachUd.sumGoz) sumGoz
    , sum(NachUd.sumOther) sumOther
    , sum(NachUd.sumExc) sumExc
    from 
    (
      select 
        Nachisl.CexOz
      , Nachisl.cLsch
      , sum(Nachisl.Summa) sumNach
      , 0.0 sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from Nachisl
      where Nachisl.YearN = :(yearN) and Nachisl.MesN = :(mesN)
      group by Nachisl.CexOz, Nachisl.cLsch

      union all
      select 
        SumVidOp.CexOz
      , SumVidOp.cLsch
      , sum(SumVidOp.Summa) sumNach
      , 0.0 sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from SumVidOp
      where SumVidOp.YearN = :(yearN) and SumVidOp.MesN = :(mesN)
      group by SumVidOp.CexOz, SumVidOp.cLsch

      union all
      select 
        Uder.CexOz 
      , Uder.cLsch
      , 0.0 sumNach
      , sum(Uder.SumUd) sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from Uder
      inner join KlVidUd on Uder.VidUds = KlVidUd.VidUd and KlVidUd.VidUdP not in (226, 253, 236)
      where Uder.YearN = :(yearN) and Uder.MesN = :(mesN) 
      group by Uder.CexOz, Uder.cLsch

      union all
      select 
        SumVidUd.CexOz
      , SumVidUd.cLsch
      , 0.0 sumNach
      , sum(SumVidUd.SumUd) sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from SumVidUd
      inner join KlVidUd on SumVidUd.VidUd = KlVidUd.VidUd and KlVidUd.VidUdP not in (226, 253, 236)
      where SumVidUd.YearN = :(yearN) and SumVidUd.MesN = :(mesN) 
      group by SumVidUd.CexOz, SumVidUd.cLsch

      union all
      select
        PrMonth.Cex CexOz
      , PrMonth.cLsch
      , 0.0 sumNach
      , sum(PrMonth.Summa9) sumUd
      , 0.0 sumGoz
      , 0.0 sumOther
      , 0.0 sumExc
      from PrMonth
      where PrMonth.YearN = :(yearNext) and PrMonth.MesN = :(mesNext) and PrMonth.Summa9 <> 0
      group by PrMonth.Cex, PrMonth.cLsch

      union all
      select
        tReeBySchetSumRee.CexOz
        , tReeBySchetSumRee.cLsch
        , 0.0 sumNach
        , 0.0 sumUd
        , tReeBySchetSumRee.sumGoz
        , tReeBySchetSumRee.sumOther
        , tReeBySchetSumRee.sumExc
      from tReeBySchetSumRee
    ) NachUd
    inner join KatPodr on NachUd.CexOz = KatPodr.NRec and SubString(KatPodr.Kod, 1, 3) <> '446'
    inner join LSchet on NachUd.cLSch = LSchet.NRec
    group by
      coalesce(KatPodr.Kod, '-')
    , coalesce(KatPodr.Name, '-')
    , coalesce(LSchet.StrTabN, '-')
  .));
  if (objQuery.execute.errorCode = tsOk)
    sqlCopyInto(objQuery, tntRepZpByTabn, true);
  else
  {
    message('Ошибка выборки ЗП по подразделениям: ' + objQuery.errorCode, error);
    exit;
  }
  sqlDropTmpTable('tReeBySchetSumRee');
  Result := true;
}

function CreateReports: boolean;
{
  Result := false;
  if not FillCommonData exit;
  if not NextVisual exit;

  if not GetDataZpByDept exit;
  if not GetDataZpByTabN exit;
  Result := true;
}

handleEvent
  cmInit:
  {
    dReport := dGetTune('UP.DATOTCH');
  }
  cmOK:
  {
    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Подготовка отчета', 0);
    dReport := date(1, Month(dReport), Year(dReport));
    if CreateReports
    {
      PrintReports;
      CloseInterface(cmDefault);
    }
    sqlDropTmpTable('tReeBySchetSumZ');
    StopVisual;
  }
end;
!-------------------------------------------------------------------------------
procedure Run;
{
  RunWindowModal(wnMainWindow);
}
function GetReportName: String;
{
  Result := 'Реестры на перечисление по подразделениям (одноразовый)';
}
function GetGroupName (Level : Word) : String;
{
  #__UNUSED__(Level)
  Result := '';
}
function GetPriority : Integer;
{
  Result := 0;
}
function VisibleInModule(Ind : Byte) : String;
{
  Result := '';
  case Ind of
    1 : Result := 'MENUZARP';
  end;
}
!-------------------------------------------------------------------------------
end.
