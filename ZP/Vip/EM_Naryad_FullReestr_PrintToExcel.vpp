
function CreateExcel (FExcelName : string) : boolean;
{
  StartNewVisual(vtRotateVisual, vfBreak+vfTimer, 'Инициализация EXCEL', 1);
    result := true;

    DeleteFile(FExcelName);

    if (not xlCreateExcel(FExcelName, true))
    {
      message('ОШИБКА! Не удалось инициализировать сессию Excel', Error);
      xlKillExcel;
      result := false;
      exit;
    }

    if (not xlIsExcelValid)
    {
      message('ОШИБКА! Не удалось инициализировать сессию Excel', Error);
      xlKillExcel;
      result := false;
      exit
    }
  var xlCount : word;
  xlCount := 0;
   Do
   {
    xlGetSheetsCount(xlCount);
    xlDeleteSheet(xlCount);
   } while xlCount > 2

  if xlCount < 2 then xlAddSheet;
   StopVisual('',0);
}
Procedure MyPrintMatrixToExcel(var nrow, nrowReal : longint);
{
 if nrow = 100 then
  {
   xlWritematrixToExcel(nrowReal,1);
   xlclearMatrix;
   nrowReal := nrowReal + nrow;
   nrow := 0;
  }
}

Procedure PrintSheet_AllNaryad;
{

  xlCreateMatrix(100,20);

  var Nrow0,nrow0FrameBold, Nrow, column, nrowreal : longint;
 nrowreal := 1;
 Nrow := column := 1;


 xlStWriteToMatrix(nrow, column,'');

/*
  Добавьте вывод фильтров в отчет
*/

 xlStWriteToMatrix(nrow, 1,'Детальная ведомость по нарядам');
 xlMergeCells(nrow,column,nrow,column+5);
 xlSetFontStyle(1,nrow,1,nrow,10);
 nrow++;
 nrow++;

 column := 1;

  nrow++;

 xlStWriteToMatrix(nrow, column,'Период:'  + datetostr(date(01,_fmonthB, _fYearB),' month YYYY') + '-' + datetostr(date(01,_fMonthE, _fYearE ),' month YYYY'));

   nrow++;
   xlStWriteToMatrix(nrow, column,'Система-источник: ' + if(_fERP=1,' ERP ','')+if(_fAMM=1,' AMM ','')+if(_fMES=1,' MES ',''));
   MyPrintMatrixToExcel(Nrow,NrowReal);

var _FiltrStr : string ='';
_FiltrStr := 'Заказы: ';
  if _fZakaz <> cofZakazEmpty
   {
           var _tmpName : string= iGetKau.GetMarkerName(7);
           var Marker_Tmp  : longint = InitMarker(_tmpName, 8, 50, 10, True);
          var i: integer = 0;
           for (i:=0; i<GetMarkerCount(Marker_Tmp); i++)
           {
             var tmpNrec: comp = 0h;
             if (GetMarker(Marker_Tmp, i, tmpNrec))
             if getfirst mnplan where ((tmpNrec == mnplan.nrec)) = tsOK
              {
               _FiltrStr := _FiltrStr + ' | ' +mnplan.number
              }
               if length(_FiltrStr ) > 230 then
                {
                 nrow++;
                 xlStWriteToMatrix(nrow, column,_FiltrStr);
                 MyPrintMatrixToExcel(Nrow,NrowReal);
                 _FiltrStr := '';
                }
           }
         nrow++;
         xlStWriteToMatrix(nrow, column,_FiltrStr);
         MyPrintMatrixToExcel(Nrow,NrowReal);
   }
   nrow++;

_FiltrStr := 'Подразделения: ';
  if _fPodr <> cofPodrEmpty
   {
           var _tmpName : string= iGetKau.GetMarkerName(cgKau_KatPodr);
           var Marker_Tmp  : longint = InitMarker(_tmpName, 8, 50, 10, True);
          var i: integer = 0;
           for (i:=0; i<GetMarkerCount(Marker_Tmp); i++)
           {
             var tmpNrec: comp = 0h;
             if (GetMarker(Marker_Tmp, i, tmpNrec))
             if getfirst katpodr where ((tmpNrec == katpodr.nrec)) = tsOK
              {
               _FiltrStr := _FiltrStr + ' | ' +katpodr.kod
              }
               if length(_FiltrStr ) > 230 then
                {
                 nrow++;
                 xlStWriteToMatrix(nrow, column,_FiltrStr);
                 MyPrintMatrixToExcel(Nrow,NrowReal);
                 _FiltrStr := '';
                }
           }
         nrow++;
         xlStWriteToMatrix(nrow, column,_FiltrStr);
         MyPrintMatrixToExcel(Nrow,NrowReal);
   }

  MyPrintMatrixToExcel(Nrow,NrowReal);


nrow++;
nrow++;

 Nrow0 := nrow;
 xlSetColumnWidth(7,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'№ п/п'); column++;
 xlStWriteToMatrix(nrow, column,'Дата'); column++;
 xlStWriteToMatrix(nrow, column,'Номер наряда'); column++;
 xlStWriteToMatrix(nrow, column,'Заказ'); column++;
 xlStWriteToMatrix(nrow, column,'Подразделение'); column++;
 xlStWriteToMatrix(nrow, column,'Подразделение 2'); column++;
 xlStWriteToMatrix(nrow, column,'Таб. №'); column++;
  xlSetColumnWidth(32,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'ФИО'); column++;
  xlSetColumnWidth(32,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Профессия'); column++;
  xlSetColumnWidth(32,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Номер ЗНП'); column++;
 xlSetColumnWidth(30,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Номер ТПс'); column++;
 xlSetColumnWidth(40,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Номер, наименование ДСЕ'); column++;
  xlSetColumnWidth(22,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Номер, наименование операции'); column++;
  xlSetColumnWidth(10,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Кол-во годных, шт.'); column++;
  xlSetColumnWidth(10,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Рязряд работы'); column++;
  xlSetColumnWidth(10,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Норма времени на одну штуку(н/ч)'); column++;
  xlSetColumnWidth(10,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Подготовительно-заключительное время (н/ч)'); column++;
  xlSetColumnWidth(10,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Процент участия (КТУ) %'); column++;
  xlSetColumnWidth(10,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'Нормо-часы'); column++;
  xlSetColumnWidth(10,1,Column ,1, Column);
 xlStWriteToMatrix(nrow, column,'(ERP, AMM, MES)');
// Nrow++;
 column := 1;
// xlSetFontStyle(1,nrow,1,nrow,10);

 MyPrintMatrixToExcel(Nrow,NrowReal);
var _npp : longint =0;
 _Loop tReport
 {
   var _column : word = 1;
   nrow++;
   _npp++;
    xlStWriteToMatrix(nrow, _column, _npp);  _column++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tReport.mesYear);  _column++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tReport.NarNumber );  _column++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tReport.ZakNumber );  _column++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tReport.sPodr );  _column++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tReport.sPodrM );  _column++;
    xlStWriteToMatrix(nrow, _column, chr(39)+tReport.strTabn   );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.FIO       );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.Proff     );  _column++;
    xlStWriteToMatrix(nrow, _column, chr(39) + tReport.ZNP     );  _column++;

    xlStWriteToMatrix(nrow, _column, chr(39)+tReport.tps       );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.DSEName   );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.OperName  );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.KolVoGodnZakaz);  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.OperRazr      );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.NrmTime       );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.NrmTimePZ     );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.KTY           );  _column++;
    xldoWriteToMatrix(nrow, _column, tReport.Shas          );  _column++;
    xlStWriteToMatrix(nrow, _column, tReport.Sys           );  _column++;

   setvisualHeader('Печать отчета'+
    +''#13''+_npp);
   MyPrintMatrixToExcel(Nrow,NrowReal);

 }
 xlWriteMatrixToExcel(NrowReal,1);
   setvisualHeader('Печать отчета'+
    +''#13''+'разлиновка');
 xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, nrow0, 1, nrow+nrowreal-1, 20);
   setvisualHeader('Печать отчета'+
    +''#13''+'установка форматов');

 xlSetNumberFormat('# ##0,00',2, 4, nrow+nrowreal-1, 20);

   setvisualHeader('Печать отчета'+
    +''#13''+'установка разбиения текста');
 xlWrapText(Nrow0,1,nrow+nrowreal-1, 20);


}


Procedure PrintToExcel;
{
  var _excelFile :string = GetStringParameter('Files','TmpFilesDirectory',0)+'EM_Naryad_FullReestr_'+UserName+'_'+DateToStr(Cur_Date,'YYYYMMDD')+'_'+TimeToStr(Cur_Time,'HHMMSS')+'.xlsx';
  if not CreateExcel(_excelFile)
    then {Stop; Abort; exit;}


  StartNewVisual(vtRotateVisual, vfBreak+vfTimer, 'Формирование отчета', 1);

    xlSetActiveSheet(1);
    xlSetSheetName(1, 'Список нарядов_'+UserName);
    PrintSheet_AllNaryad;

 xlSaveWorkBookByName(_excelFile);
 xlKillExcel;
 if VisualizationActive StopVisual('',0);
}
