#component "Z_Zar"
#include ZarAlg.vih

VipInterface ZarAlgorithm_SREDNOTPUSKMATHELP  implements IZarAlgorithm licensed(free);

interface ZarAlgorithm_SREDNOTPUSKMATHELP;

create view
var
    pLschet:comp;
    _log :string ='';
 select
  ao.RASZARZ
from otpusk ot, arotpusk ao
where (( pLschet == ot.CLSCH
      and (ot.choice <> 3 )
      and ot.nrec == ao.COTPUSK
     ))
;
Procedure MyLog(_str: string);
{
  if _log = '' then _log := GetStringParameter('Files','OutputFilesDirectory',0) + 'ZarAlgorithm_SREDNOTPUSKMATHELP_' + DateToStr(cur_date, 'DDMMYYYY') + '_' + timetostr(Cur_time, 'HHMMSS') + '.log';
  LogStrToFile(_log, _str);
}

public function CalcSum(Parameter: string): double;
{
  MyLog('ZarAlgorithm_SREDNOTPUSKMATHELP -> CalcSum' );
  result := 0;
   set pLschet:=uch_lsch;
  MyLog(' pLschet = ' + String(pLschet,0,0));
  if getfirst ot=tsok // where ((uch_lsch==lschet.nrec))=tsok
  {
    MyLog('if getfirst ot=tsok ');
    if getfirst ao = tsOK
    {
      MyLog('if getfirst ao = tsOK');
      result := ao.RASZARZ;
      MyLog('result = ' + string(result));
    }
  }
}

function GetDescription: string;
{
  result := 'Получение суммы средне-дневного заработка из расчитанного отпуска';
}

end.
