#component "Z_Sredn"
alter interface VozOtpusk;
ExtendFormats OtpOtz;

Create view VOtpusk
from
  KatPodr GP_KatPodr
where((
  OtpOtz.Cex == GP_KatPodr.Nrec
));

browse OtpOtz(,,sci1378InsPm);
table OtpOtz;
fields
//  {font = {color = if(IsMarked, ColorMark, if((OTPOTZ.OBRAB = 'O') or (OTPOTZ.OBRAB = 'A') or (OTPOTZ.OBRAB = ForcedSign) or (OTPOTZ.OBRAB = 'TA'), 0, ColorSysGray))}};
  GP_KatPodr.Kod 'Код','подразделения' ('Код подразделения',hcOtpOtz, sci178InsPM):[15],Protect,NoDel,NoAutoSize;
  bcase(OtpOtz.OBRAB = 'O' or OtpOtz.OBRAB = 'A' or OtpOtz.OBRAB = ForcedSign or OtpOtz.OBRAB = 'TA': 'Проведен'; 'Не проведен')
    'Проведен/','не проведен' ('Проведен/не проведен',hcOtpOtz, sci178InsPM):[12],Protect,NoDel,NoAutoSize;
end;

end.
