#doc
Сверка начислений с КИС Настройки Энергомаш - утилиты
#end
VipInterface GP_Sverka_Nachsil Licensed(free);
Interface GP_Sverka_Nachsil 'Сверка начислений с КИС ' , EscClose;

//---------------------------------------
Function ChkErr(_tPersons:comp;_wSovm:word;_wType:word;_Vidopl:word) : boolean; forward;
//----------------------------------
Table Struct tmp_Sverka //20
(
   tPerson :comp       //1
  ,FIO     :string//2
  ,GALDCODE :string //3 код подразделения
  ,Sovm    :word //4 0 = Основное место работы
  ,wType   :word //5 тип 1 - начисление, 2 удержание
  ,Vidopl  :longint //6
  ,Summa   :decimal(30,15)//double //9
  ,GALDOCNUMB       :string //10 СНИЛС
// загрузка
  ,CITEZENID        :comp //11 Persons.Nrec
  ,CODE             :longint  //13  вид олпаты/удеражния
  ,SUMM             :double//18
  ,FACTWORKHOURS    :double//19
  ,FACTWORKDAYS     :double//20
  ,FACETCONTENT     :string //22 начисл., удержания
  ,PLANWH           :double //23 плановые часы
  ,PLANWD           :double //24 плановые дни
  ,DCODE            :string //26 код подразделения
  ,WORKTYPE         :string //27 Вид работы
  ,FIOFULL          :string //29
  ,DOCNUMB          :string //30 СНИЛС
//----------------
//,YEARK   :word //7
//,Mes     :word //8
//----------------
  //,WORKCODE         :longint//12 тип работы
  //,SR004            :string[50]  //14 [20]
  //,YEARNUM          :word //15
  //,CORRECTIONMONTH  :word //16
  //,CORRECTIONYEAR   :word //17
//,EMPLOYEEID       :comp//21
//,HANDSSUMM        :longint//25
//,ID               :comp     //28

)
with index
( tmp_Sverka01 =  tPerson + Sovm + wType+ Vidopl //+ YEARK + Mes
 ,tmp_Sverka02 =  Fio+sovm+wType+ Vidopl //+ YEARK + Mes
 ,tmp_Sverka03 =  GALDOCNUMB+sovm+wType+ Vidopl //+ YEARK + Mes
);
//----------------------------------
var
  nm_file:string;
  nm_file_dv:string; // файл с долгами и выплатами.
  logfilenm:string;
  logfilekl:boolean;
  wYear_Flt,wMonth_Flt:word;
  wYear_Flt2,wMonth_Flt2:word;
  wOption:word;
  wFlt:word;
  fDelta:double;
//--- Для поиска
    _Sovm    :word; // 0 = Основное место работы
   _wType   :word; // тип 1 - начисление, 2 удержание
   _Vidopl  :word;
   _GALDOCNUMB       :string[30]; //СНИЛС
   _klFind:word;
   _sFio:string;
   _sPost:string;

  //-----------------------------------------
  // Фильтры - базовые
  //-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
   isFilterRun  :boolean;////признак работы ограничений
   wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;
   #mrkfld_(KatPodr)

//----------------------------------
Create view
var
  Podr_kod:string;
  pPersons:comp;
as select Lschet.Nrec, tmp_sverka.*
From Lschet
 ,tmp_Sverka(tmp_Sverka01)
 ,KatPodr
 ,KatPodr KatPodr_Flt
 ,KatPodr KatPodr_Find
 ,Persons
where ((
    wc_nrec ==  KatPodr_Flt.Nrec
and Podr_kod == KatPodr_Find.Kod
and pPersons == Persons.Nrec
and wYear_Flt2  == PRMONTH.YEARN
and wMonth_Flt2 == PRMONTH.MESN

))
bounds byErr root == tmp_Sverka.FIO
 and (ChkErr(tmp_Sverka.tPerson,tmp_Sverka.Sovm,tmp_Sverka.wType,tmp_Sverka.Vidopl) )
 ordered by TableOrder

;
//------------------------------------
Create view vSpKau
var
  pSpKau:comp;
as select SpKau.name
From SpKau
where ((
   pSpKau == Spkau.nrec
)); //Create view vSpKau


#include Excel_Imp.Vpp
#include Sql_Func.Vpp


//------------------------------------------------
// and (ChkErr(tmp_Sverka.tPersons,tmp_Sverka.wSovm,tmp_Sverka.GALDOCNUMB,tmp_Sverka.DOCNUMB) )

Function ChkErr(_tPersons:comp;_wSovm:word;_wType:word;_Vidopl:word) : boolean;
{ Result:=True;
#UNDEF GP_Sverka_Nachisl_CHK
#DECLARE GP_Sverka_Nachisl_CHK (FLD,FLD1)
  if tmp_sverka.#(FLD)<>tmp_sverka.#(FLD1) exit;
#END
  if not IsBitCTW(wOption,1)
  { #GP_Sverka_Nachisl_CHK(FIO,FIOFULL )//Отработанное время план
    #GP_Sverka_Nachisl_CHK(GALDCODE,DCODE )//Отработанное время план
    #GP_Sverka_Nachisl_CHK(GALDOCNUMB,DOCNUMB )//Отработанное время план
  }
  if not IsBitCTW(wOption,2)
  { if abs(tmp_sverka.Summa-tmp_sverka.SUMM)>fDelta then exit;//Отработанное время план
  }
  Result:=False;

} //Function ChkErr(_podr_kod:string;_sFio:string) : boolean; Cacheable;

#include ShowKau.Vpp
//------------------------------------------------
// Получить значение аналитики
//------------------------------------------------
Function GetAnaliticName(_KodGroup:word;_cKau:comp):string; Cacheable;
{ Result:='';
  if _KodGroup>10000
  { vSpkau.pSpKau:=_cKau;
    if vSpKau.getfirst spkau=tsok
      Result:=vSpKau.Spkau.name;
  }
  else
  { Result:=#ShowKau(_KodGroup,_cKau);
  }
} //Function GetAnaliticName(_KodGroup:word;_cKau:comp):string; Cacheable;

//------------------------------------------------
// Получить значение аналитики
//------------------------------------------------
Function GetAnaliticNrec(_KodGroup:word;_sKau:string):comp; Cacheable;
{ Result:=0;
  if _KodGroup>10000
  {
    if vSpKau.getfirst spkau where (( _KodGroup == spKau.KodGrKau and _sKau== SpKau.name)) =tsok
      Result:=vSpKau.Spkau.nrec;
  }
  else
  { Result:=0;
  }
} //Function GetAnaliticName(_KodGroup:word;_cKau:comp):string; Cacheable;



Function Fill_Tmp_Table:boolean;
var ii:word;
    _StypeVed:string;
    wErr:Longint;
{   Result:=False;

  Timelog('GP_Sverka_Nachisl->Fill_Tmp_Table:START 001');
  delete all tmp_sverka;
  //---------------------------------------------
  NextVisual;
  Timelog('GP_Sverka_Nachisl->Fill_Tmp_Table:START 002');
  //SQL
  ClearQuery(vliSQLCommand);

  PrepareSQLQuery('select');
  PrepareSQLQuery(' Nachisl.tPerson as tPerson'); //01 :comp
  PrepareSQLQuery(',Persons.FIO as FIO'); //02    :string[100]
  PrepareSQLQuery(',COALESCE(Katpodr.Kod,'' '') as GALDCODE'); //03 :string[20] //код подразделения
  PrepareSQLQuery(',CASE WHEN COALESCE(Lschet.Sovm,0)=3 THEN 3 ELSE 0 END as Sovm');  //04  :word // 0 = Основное место работы
  PrepareSQLQuery(',1 as wType'); //05  :word // тип 1 - начисление, 2 удержание
  PrepareSQLQuery(',Nachisl.Vidopl as Vidopl');  //06 :word
  PrepareSQLQuery(',Sum(Nachisl.Summa)  as Summa'); //09 :double
  PrepareSQLQuery(',TRIM(COALESCE(PASSPORTS.NMB,'' '')) as  GALDOCNUMB'); //10      :string[30] //СНИЛС

// загрузка
  PrepareSQLQuery(',Nachisl.tPerson as CITEZENID'); //11       :comp //Persons.Nrec
  PrepareSQLQuery(',0 as CODE');           //13  :string  //вид олпаты/удеражния
  PrepareSQLQuery(',0.00 as SUMM');            //18 :double
  PrepareSQLQuery(',0.00 as FACTWORKHOURS');   //19 :double
  PrepareSQLQuery(',0.00 as FACTWORKDAYS');    //20 :double
  PrepareSQLQuery(','' '' as FACETCONTENT');    // :string //22 начисл., удержания
  PrepareSQLQuery(',0.00 as  PLANWH ');         // :double //23 плановые часы
  PrepareSQLQuery(',0.00 as PLANWD  ');        // :double //24 плановые дни
  PrepareSQLQuery(','' '' as DCODE  ');         // :string[20] //26 код подразделения
  PrepareSQLQuery(','' '' as WORKTYPE');        // :string[100] //27  Вид работы
  PrepareSQLQuery(','' '' as FIOFULL');         //29 :string[50]
  PrepareSQLQuery(','' '' as DOCNUMB');         //30 :string[30] //СНИЛС

  //,0 as YEARK //Nachisl.YEARK  //07  :word
  //,0 as Mes//Nachisl.Mes    //08 :word
  //,0 as WORKCODE       //12  :longint //тип работы
  //,'' as SR004         //14   :string  //[20]
  //,0 as YEARNUM         //15 :word
  //,0 as CORRECTIONMONTH //16 :word
  //,0 as CORRECTIONYEAR  //17 :word
  //,#comp(0) as EMPLOYEEID      //21 :comp
  //,#Comp(0) as HANDSSUMM       //25 [20]
  //,#Comp(0) as ID              //28 :comp
  PrepareSQLQuery('  From Nachisl');
  PrepareSQLQuery('  inner join Persons on Persons.Nrec = Nachisl.tPerson  ');
  PrepareSQLQuery('  inner join Lschet  on Lschet.Nrec = Nachisl.cLsch');
  PrepareSQLQuery('  Left Outer join KatPodr on KatPodr.Nrec = Lschet.Cex');// Nachisl.cexoz
  PrepareSQLQuery('  left outer join PASSPORTS on PASSPORTS.PERSON=PERSONS.NREC');   // страховой номер
  PrepareSQLQuery('                      and  PASSPORTS.SYSCODE = 501  ');// страховой номер
  PrepareSQLQuery('  where Nachisl.MesV ='+string(wMonth_Flt)+' and Nachisl.YearV='+string(wYear_Flt));
  PrepareSQLQuery('  group by ');
  PrepareSQLQuery('     Nachisl.tPerson '); //:comp
  PrepareSQLQuery('    ,Persons.FIO ');//    :string[100]
  PrepareSQLQuery('    ,Lschet.sovm ');
  PrepareSQLQuery('    ,CASE WHEN COALESCE(Lschet.Sovm,0)=3 THEN 3 ELSE 0 END ');  //04  :word // 0 = Основное место работы
  PrepareSQLQuery('    ,Nachisl.Vidopl ');// :word
  PrepareSQLQuery('    ,COALESCE(PASSPORTS.NMB,'' '')');   //      :string[30] //СНИЛС
  PrepareSQLQuery('    ,COALESCE(Katpodr.Kod,'' '')  ');
  stmt:=0;
  stmt := sqlAllocStmt;
  wErr:=ExecDSQLex(tntmp_sverka);

  Timelog('GP_Sverka_Nachisl->Fill_Tmp_Table:Nachsil 003 '+string(wErr)+','+RecordsInTable(tntmp_sverka));
  NextVisual;

  //---------------------------------------------
  NextVisual;
  Timelog('GP_Sverka_Nachisl->Fill_Tmp_Table:START Nenach 002');
  //SQL
  ClearQuery(vliSQLCommand);

  PrepareSQLQuery('select');
  PrepareSQLQuery(' Nenach.tPerson as tPerson'); //01 :comp
  PrepareSQLQuery(',Persons.FIO as FIO'); //02    :string[100]
  PrepareSQLQuery(',COALESCE(Katpodr.Kod,'' '') as GALDCODE'); //03 :string[20] //код подразделения
  PrepareSQLQuery(',CASE WHEN COALESCE(Lschet.Sovm,0)=3 THEN 3 ELSE 0 END as Sovm');  //04  :word // 0 = Основное место работы
  PrepareSQLQuery(',1 as wType'); //05  :word // тип 1 - начисление, 2 удержание
  PrepareSQLQuery(',Nenach.Vidopl as Vidopl');  //06 :word
  PrepareSQLQuery(',Sum(Nenach.Summa)  as Summa'); //09 :double
  PrepareSQLQuery(',TRIM(COALESCE(PASSPORTS.NMB,'' '')) as  GALDOCNUMB'); //10      :string[30] //СНИЛС

// загрузка
  PrepareSQLQuery(',Nenach.tPerson as CITEZENID'); //11       :comp //Persons.Nrec
  PrepareSQLQuery(',0 as CODE');           //13  :string  //вид олпаты/удеражния
  PrepareSQLQuery(',0.00 as SUMM');            //18 :double
  PrepareSQLQuery(',0.00 as FACTWORKHOURS');   //19 :double
  PrepareSQLQuery(',0.00 as FACTWORKDAYS');    //20 :double
  PrepareSQLQuery(','' '' as FACETCONTENT');    // :string //22 начисл., удержания
  PrepareSQLQuery(',0.00 as  PLANWH ');         // :double //23 плановые часы
  PrepareSQLQuery(',0.00 as PLANWD  ');        // :double //24 плановые дни
  PrepareSQLQuery(','' '' as DCODE  ');         // :string[20] //26 код подразделения
  PrepareSQLQuery(','' '' as WORKTYPE');        // :string[100] //27  Вид работы
  PrepareSQLQuery(','' '' as FIOFULL');         //29 :string[50]
  PrepareSQLQuery(','' '' as DOCNUMB');         //30 :string[30] //СНИЛС

  //,0 as YEARK //Nachisl.YEARK  //07  :word
  //,0 as Mes//Nachisl.Mes    //08 :word
  //,0 as WORKCODE       //12  :longint //тип работы
  //,'' as SR004         //14   :string  //[20]
  //,0 as YEARNUM         //15 :word
  //,0 as CORRECTIONMONTH //16 :word
  //,0 as CORRECTIONYEAR  //17 :word
  //,#comp(0) as EMPLOYEEID      //21 :comp
  //,#Comp(0) as HANDSSUMM       //25 [20]
  //,#Comp(0) as ID              //28 :comp
  PrepareSQLQuery('  From Nenach');
  PrepareSQLQuery('  inner join Persons on Persons.Nrec = Nenach.tPerson  ');
  PrepareSQLQuery('  inner join Lschet  on Lschet.Nrec = Nenach.cLsch');
  PrepareSQLQuery('  Left Outer join KatPodr on KatPodr.Nrec = Lschet.Cex');// Nachisl.cexoz
  PrepareSQLQuery('  left outer join PASSPORTS on PASSPORTS.PERSON=PERSONS.NREC');   // страховой номер
  PrepareSQLQuery('                      and  PASSPORTS.SYSCODE = 501  ');// страховой номер
  PrepareSQLQuery('  where Nenach.MesV ='+string(wMonth_Flt)+' and Nenach.YearV='+string(wYear_Flt));
  PrepareSQLQuery('  group by ');
  PrepareSQLQuery('     Nenach.tPerson '); //:comp
  PrepareSQLQuery('    ,Persons.FIO ');//    :string[100]
  PrepareSQLQuery('    ,Lschet.sovm ');
  PrepareSQLQuery('    ,CASE WHEN COALESCE(Lschet.Sovm,0)=3 THEN 3 ELSE 0 END ');  //04  :word // 0 = Основное место работы
  PrepareSQLQuery('    ,Nenach.Vidopl ');// :word
  PrepareSQLQuery('    ,COALESCE(PASSPORTS.NMB,'' '')');   //      :string[30] //СНИЛС
  PrepareSQLQuery('    ,COALESCE(Katpodr.Kod,'' '')  ');
  stmt:=0;
  stmt := sqlAllocStmt;
  wErr:=ExecDSQLex(tntmp_sverka);

  Timelog('GP_Sverka_Nachisl->Fill_Tmp_Table:Nenach 003 '+string(wErr)+','+RecordsInTable(tntmp_sverka));
  NextVisual;

  //---------------------------------------
  Timelog('GP_Sverka_Nachisl->Fill_Tmp_Table:START 004');


    //----------------------------
  PrepareSQLQuery('select');
  PrepareSQLQuery(' Uder.tPerson as tPerson'); //:comp
  PrepareSQLQuery(',Persons.FIO  as FIO');//    :string[100]
  PrepareSQLQuery(',COALESCE(Katpodr.Kod,'' '') as  GALDCODE'); // :string[20] //код подразделения
  PrepareSQLQuery(',CASE WHEN Lschet.Sovm=3 THEN 3 ELSE 0 END  as Sovm');  //  :word // 0 = Основное место работы
  PrepareSQLQuery(',2 as  wType'); //  :word // тип 1 - начисление, 2 удержание
  PrepareSQLQuery(',Uder.VidUd as Vidopl'); // :word
  PrepareSQLQuery(',Sum(Uder.SumUd) as Summa');  // :double
  PrepareSQLQuery(',TRIM(COALESCE(PASSPORTS.NMB,'' ''))  as GALDOCNUMB'); //      :string[30] //СНИЛС
// загрузка
  PrepareSQLQuery(',Uder.tPerson as CITEZENID'); //       :comp //Persons.Nrec
  PrepareSQLQuery(',0 as CODE');           //  :string  //вид олпаты/удеражния
  PrepareSQLQuery(',0.00 as SUMM');            // :double
  PrepareSQLQuery(',0.00 as FACTWORKHOURS');   // :double
  PrepareSQLQuery(',0.00 as FACTWORKDAYS');    // :double
  PrepareSQLQuery(','' '' as FACETCONTENT');    // :string // начисл., удержания
  PrepareSQLQuery(',0.00 as PLANWH');          // :double // плановые часы
  PrepareSQLQuery(',0.00 as PLANWD');          // :double // плановые дни
  PrepareSQLQuery(','' '' as DCODE');           // :string[20] //код подразделения
  PrepareSQLQuery(','' '' as WORKTYPE');        // :string[100] // Вид работы
  PrepareSQLQuery(','' '' as FIOFULL');         // :string[50]
  PrepareSQLQuery(','' '' as DOCNUMB');         // :string[30] //СНИЛС
  PrepareSQLQuery('  From Uder');
  PrepareSQLQuery('  inner join Persons on Persons.Nrec =Uder.tPerson ');
  PrepareSQLQuery('  inner join Lschet  on Lschet.Nrec  = Uder.cLsch    ');
  PrepareSQLQuery('  Left Outer join KatPodr on KatPodr.Nrec = Lschet.Cex');
  PrepareSQLQuery('  left outer join PASSPORTS on PASSPORTS.PERSON=PERSONS.NREC');   // страховой номер
  PrepareSQLQuery('                      and  PASSPORTS.SYSCODE = 501');  // страховой номер
  PrepareSQLQuery('  where Uder.MesV ='+string(wMonth_Flt)+' and Uder.YearV='+string(wYear_Flt));
  PrepareSQLQuery('  group by');
  PrepareSQLQuery('     Uder.tPerson');  //:comp
  PrepareSQLQuery('    ,Persons.FIO ');//    :string[100]
  PrepareSQLQuery('    ,Lschet.sovm ');
  PrepareSQLQuery('    ,CASE WHEN COALESCE(Lschet.Sovm,0)=3 THEN 3 ELSE 0 END');    //  :word // 0 = Основное место работы
  PrepareSQLQuery('    ,Uder.VidUd ');// :word
  PrepareSQLQuery('    ,COALESCE(Katpodr.Kod,'' '') ');  //      :string[30] //СНИЛС
  PrepareSQLQuery('    ,COALESCE(PASSPORTS.NMB,'' '')  ');
  stmt:=0;
  stmt := sqlAllocStmt;
  wErr:=ExecDSQLex(tntmp_sverka);




  //---------------------------------------
  wMonth_Flt2 :=wMonth_Flt+1;
  wYear_Flt2  :=wYear_Flt;
  if wMonth_Flt2=13
  { wMonth_Flt2:=1;
    wYear_Flt2++;
  }

  ClearQuery(vliSQLCommand);

  PrepareSQLQuery('select');
  PrepareSQLQuery(' PrMonth.tPerson as tPerson'); //:comp
  PrepareSQLQuery(',Persons.FIO+'' Касса''  as FIO');//    :string[100]
  PrepareSQLQuery(',COALESCE(Katpodr.Kod+''К'','' '') as  GALDCODE'); // :string[20] //код подразделения
  PrepareSQLQuery(',CASE WHEN Lschet.Sovm=3 THEN 3 ELSE 0 END  as Sovm');  //  :word // 0 = Основное место работы
  PrepareSQLQuery(',2 as  wType'); //  :word // тип 1 - начисление, 2 удержание
  PrepareSQLQuery(',500 as Vidopl'); // :word
  PrepareSQLQuery(',Sum(PRMONTH.SUMMA9) as Summa');  // :double PRMONTH.NOZAR
  PrepareSQLQuery(',TRIM(COALESCE(PASSPORTS.NMB,'' ''))  as GALDOCNUMB'); //      :string[30] //СНИЛС
// загрузка
  PrepareSQLQuery(',PRMONTH.tPerson as CITEZENID'); //       :comp //Persons.Nrec
  PrepareSQLQuery(',0 as CODE');           //  :string  //вид олпаты/удеражния
  PrepareSQLQuery(',0.00 as SUMM');            // :double
  PrepareSQLQuery(',0.00 as FACTWORKHOURS');   // :double
  PrepareSQLQuery(',0.00 as FACTWORKDAYS');    // :double
  PrepareSQLQuery(','' '' as FACETCONTENT');    // :string // начисл., удержания
  PrepareSQLQuery(',0.00 as PLANWH');          // :double // плановые часы
  PrepareSQLQuery(',0.00 as PLANWD');          // :double // плановые дни
  PrepareSQLQuery(','' '' as DCODE');           // :string[20] //код подразделения
  PrepareSQLQuery(','' '' as WORKTYPE');        // :string[100] // Вид работы
  PrepareSQLQuery(','' '' as FIOFULL');         // :string[50]
  PrepareSQLQuery(','' '' as DOCNUMB');         // :string[30] //СНИЛС
  PrepareSQLQuery('  From PRMONTH');
  PrepareSQLQuery('  inner join Persons on Persons.Nrec = PRMONTH.tPerson ');
  PrepareSQLQuery('  inner join Lschet  on Lschet.Nrec  = PRMONTH.cLsch    ');
  PrepareSQLQuery('  Left Outer join KatPodr on KatPodr.Nrec = Lschet.Cex');
  PrepareSQLQuery('  left outer join PASSPORTS on PASSPORTS.PERSON=PERSONS.NREC');   // страховой номер
  PrepareSQLQuery('                      and  PASSPORTS.SYSCODE = 501');  // страховой номер
  PrepareSQLQuery('  where PRMONTH.MesN ='+string(wMonth_Flt2)+' and PRMONTH.YearN='+string(wYear_Flt2));
  PrepareSQLQuery('  and PRMONTH.NOZAR<>0');
  PrepareSQLQuery('  group by');
  PrepareSQLQuery('     PrMonth.tPerson');  //:comp
  PrepareSQLQuery('    ,Persons.FIO+'' Касса''  ');//    :string[100]
  PrepareSQLQuery('    ,COALESCE(Katpodr.Kod+''К'','' '') '); // :string[20] //код подразделения
  PrepareSQLQuery('    ,Lschet.sovm ');
  PrepareSQLQuery('    ,CASE WHEN COALESCE(Lschet.Sovm,0)=3 THEN 3 ELSE 0 END');    //  :word // 0 = Основное место работы
  PrepareSQLQuery('    ,COALESCE(PASSPORTS.NMB,'' '')  ');
  stmt:=0;
  stmt := sqlAllocStmt;
  wErr:=ExecDSQLex(tntmp_sverka);

  //---------------------------
  ReReadRecord(#tmp_sverka);
  /*
  if GetMarkerCount(Marker_Katpodr)>0
  { delete from tmp_kpi_sum where (( root == tmp_kpi_sum.sortname
      and ( not FoundMarker(Marker_KatPodr,tmp_ы.cex) )
     ))

  }
  */
  NextVisual;
  delete tmp_sverka where (( 0 == tmp_sverka.Summa(noindex) ));
  Result:=True;
  Timelog('GP_Sverka_Nachisl_Import->Fill_Tmp_Table: UDER wErr='+string(wErr)+','+RecordsInTable(tntmp_sverka));

  Timelog('GP_Sverka_Nachisl_Import->Fill_Tmp_Table:Finish');

} //Procedure Fill_Tmp_Table;


//--------------------
//
//--------------------
Procedure  FindRec;
{
    _klFind:=0 ;
    do
    { if getfirst tmp_sverka where
      ((   _GALDOCNUMB == tmp_sverka.GALDOCNUMB
       and _Sovm    == tmp_sverka.Sovm
       and _wType   == tmp_sverka.wType
       and _Vidopl  == tmp_sverka.Vidopl
      ))=tsok
      { _klFind:=2;
      }
      else
      if getfirst tmp_sverka where
      ((   _GALDOCNUMB == tmp_sverka.GALDOCNUMB
       and 0        == tmp_sverka.Sovm
       and _wType   == tmp_sverka.wType
       and _Vidopl  == tmp_sverka.Vidopl
      ))=tsok
      { _klFind:=3;
      }
      if _klFind>0 break ;
      if pPersons=0 then continue;
      if getfirst Persons <>tsok break;
      // tmp_Sverka01 =  tPerson + Sovm + wType+ Vidopl + YEARK + Mes
      // ,tmp_Sverka03 =  GALDOCNUMB+sovm+wType+ Vidopl + YEARK + Mes

       if getfirst tmp_sverka where
        ((   pPersons == tmp_sverka.tPerson
         and _Sovm    == tmp_sverka.Sovm
         and _wType   == tmp_sverka.wType
         and _Vidopl  == tmp_sverka.Vidopl
        ))=tsok
        { _klFind:=2;
        }
        else
        if getfirst tmp_sverka where
        ((   pPersons == tmp_sverka.tPerson
         and 0        == tmp_sverka.Sovm
         and _wType   == tmp_sverka.wType
         and _Vidopl  == tmp_sverka.Vidopl
        ))=tsok
        { _klFind:=3;
        }
    } while false;
    //-- не нашли!
    if _klFind<2
    { clearbuffer(#tmp_sverka);
      tmp_sverka.GALDOCNUMB:=_GALDOCNUMB;
      tmp_sverka.Sovm     :=_Sovm;
      tmp_sverka.wType    :=_wType;
      tmp_sverka.Vidopl   :=_Vidopl;
      tmp_sverka.tPerson  :=pPersons;
      Insert current tmp_sverka;
    }
} //Procedure  FindRec;

//-----------------------------------------
//
//-----------------------------------------
Function FormDoc:boolean;
var ii:word;
{ Result:=False;
  logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0);
  Timelog('GP_Sverka_Nachisl_Import->FormDoc:Start');
  if not FileExist(nm_file)
  { message('Не нашли файл '
     +chr(13)+nm_file );
    Exit;
  }
  if not FileExist(nm_file_DV)
  { message('Не нашли файл '
     +chr(13)+nm_file_DV );
    Exit;
  }
  if BoundActive(tbbyErr)  SubBounds(tbbyErr);
  ReReadRecord(#tmp_sverka);
  Delete all tmp_sverka;
  ClearFuncCache;
  //------------------------------
  Fill_Tmp_Table;
  logfilekl:=true;
  //------------------------------
  var isAllOk:boolean=true;
  //====================================
  v_Imp.num_col:=60;// иначе первые 50
  Timelog('GP_Sverka_Nachisl_Import->ReadDataFromExcel:Start');
  XlKillExcel;
  //--------------------------
  v_Imp.num_col:=30;
  if not ReadDataFromExcel(0,nm_file,'SQL Results',False,true)
  { message('Ошибка импорта из'
       +chr(13)+nm_file
       +chr(13)+'Лист=SQL Results'
       );
      exit ;
  }
  Timelog('GP_Sverka_Nachisl_Import->ReadDataFromExcel:Finish');
  //====================================
  var wexrow_:longint;
  wexrow_:=0;
  var wkl_err:boolean;
  wkl_err:=false;
  Count_Katpodr:=GetMarkerCount(Marker_Katpodr);
  Timelog('GP_Sverka_Nachisl_Import->Import:Start');
  XlKillExcel;
  v_imp._loop tmp_excel
  { if not nextvisual then
    { isAllOk:=false;
        break;
    }

    wexrow_++ ;
    if wexrow_=1
    { continue;
    }
    //=========================================
    // Не будем с 0
    if MyDouble(v_imp.tmp_excel.dmcell[9])=0 continue;
    //=========================================

    Podr_kod:=LpadCh(v_imp.tmp_excel.dmcell[17],'0',3);
    if IsBitCTW(wFlt,1)
    { Podr_kod:=LpadCh(v_imp.tmp_excel.dmcell[03],'0',3);
    }
    if Count_Katpodr>0
    {
      if getfirst KatPodr_Find<>tsok continue;
      if not FoundMarker(Marker_KatPodr,KatPodr_Find.Nrec) continue;
    }
    Podr_kod:=LpadCh(v_imp.tmp_excel.dmcell[17],'0',3);
    ii:=Pos(' ',Podr_kod);
    if ii>0 Podr_kod:=SubStr(Podr_kod,1,ii-1);
    _sFio    :=Replace(v_imp.tmp_excel.dmcell[20],'. .','.');
    _Sovm:=if(trim(v_imp.tmp_excel.dmcell[18])='Совместительство',3,0); //'Основное место работы;


    _wType:=if(v_imp.tmp_excel.dmcell[13]='Начисление',1,2);
    _Vidopl:=word(v_imp.tmp_excel.dmcell[4]);
    //--------------------------------
    if _wType=2
    { case _Vidopl of
      216,217,218: continue;//у нас в неначисляемых!!
      end;
    }
    //--------------------------------
     //  ,YEARK   :word  ,Mes     :word
    _GALDOCNUMB:=trim(v_imp.tmp_excel.dmcell[21]);
    if _sFio='' then continue;
    pPersons:=0;
    set pPersons:=comp(v_imp.tmp_excel.dmcell[2]);
    _klFind:=0 ;
    //--------------------
    FindRec;
    //--------------------

    var wColumn:longint;
    wColumn:=2;
    // номер колонки после вывода !!!
// загрузка
    tmp_Sverka.CITEZENID        :=v_imp.tmp_excel.dmcell[wColumn];wColumn++;//02 Persons.Nrec
    //tmp_Sverka.WORKCODE         :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//03 longint //тип работы
    tmp_Sverka.CODE             :=word(v_imp.tmp_excel.dmcell[wColumn]);
    wColumn++;//04 string  //вид олпаты/удеражния
    //tmp_Sverka.SR004            :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//05 string  //[20]
    //tmp_Sverka.YEARNUM          :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//06 word
    //tmp_Sverka.CORRECTIONMONTH  :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//07 word
    //tmp_Sverka.CORRECTIONYEAR   :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//08 word
    tmp_Sverka.SUMM             :=tmp_Sverka.SUMM+MyDouble(v_imp.tmp_excel.dmcell[wColumn]);
    wColumn++;//09 double
    tmp_Sverka.FACTWORKHOURS    :=tmp_Sverka.FACTWORKHOURS+MyDouble(v_imp.tmp_excel.dmcell[wColumn]);
    wColumn++;//10 double
    tmp_Sverka.FACTWORKDAYS     :=tmp_Sverka.FACTWORKDAYS+MyDouble(v_imp.tmp_excel.dmcell[wColumn]);
    wColumn++;//11 double
    //tmp_Sverka.EMPLOYEEID       :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//12 comp
    tmp_Sverka.FACETCONTENT     :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//13 string // начисл., удержания
    tmp_Sverka.PLANWH           :=v_imp.tmp_excel.dmcell[wColumn];wColumn++;
    //14 double // плановые часы
    tmp_Sverka.PLANWD           :=v_imp.tmp_excel.dmcell[wColumn];wColumn++;
    //15 double // плановые дни
    //tmp_Sverka.HANDSSUMM        :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;
    //16 longint
    tmp_Sverka.DCODE            :=v_imp.tmp_excel.dmcell[wColumn];wColumn++;
    //17 string[20] //код подразделения
    tmp_Sverka.WORKTYPE         :=v_imp.tmp_excel.dmcell[wColumn];wColumn++;
    //18 string[100] // Вид работы
    //tmp_Sverka.ID               :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//19 comp
    tmp_Sverka.FIOFULL          :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//20 string[50]
    tmp_Sverka.DOCNUMB          :=v_imp.tmp_excel.dmcell[wColumn];
    wColumn++;//21 string[30] //СНИЛС
    update current tmp_sverka;
  } //v_imp._loop tmp_excel

  //===================================
  //Долги и выплаты
  //nm_file_dv
  v_Imp.num_col:=10;
  if not ReadDataFromExcel(0,nm_file_DV,'Лист1',False,true)
  { message('Ошибка импорта из'
       +chr(13)+nm_file_dv
       +chr(13)+'Лист=Лист1'
       );
      exit ;
  }
  Timelog('GP_Sverka_Nachisl_Import->ReadDataFromExcel:Долги и выплаты');
  //====================================
  wexrow_:=0;
  wkl_err:=false;
  Count_Katpodr:=GetMarkerCount(Marker_Katpodr);
  Timelog('GP_Sverka_Nachisl_Import->Import:Start Долги и выплаты');
  XlKillExcel;
  v_imp._loop tmp_excel
  { if not nextvisual then
    { isAllOk:=false;       break;
    }
    wexrow_++ ;
    if wexrow_=1
    { continue;
    }
    //=========================================
    // Не будем с 0
    if MyDouble(v_imp.tmp_excel.dmcell[5])=0
    and MyDouble(v_imp.tmp_excel.dmcell[6])=0
    and MyDouble(v_imp.tmp_excel.dmcell[7])=0
    continue;
    //=========================================

    Podr_kod:=LpadCh(v_imp.tmp_excel.dmcell[04],'0',3);

    _sFio  :=Replace(v_imp.tmp_excel.dmcell[1]+' '+v_imp.tmp_excel.dmcell[2]+' '+v_imp.tmp_excel.dmcell[3],'. .','.');
    _Sovm  :=if(trim(v_imp.tmp_excel.dmcell[09])='Совместительство',3,0); //'Основное место работы;
    _GALDOCNUMB:=trim(v_imp.tmp_excel.dmcell[08]);
    if trim(_sFio)='' then continue;

    var jj :word;
    pPersons:=0;
    For(jj:=1;jj<=2;jj++)
    { //1 - сумма на руки
      //2 - долг на начало
      //3 - долг на конец
      var _su:double;
      _su:=0;
      case jj of
      1:// - сумма на руки 500 удержание
      { _wType:=2;
        _Vidopl:=500;//Перечисление з/п в банк (системный)
        _su:=MyDouble(v_imp.tmp_excel.dmcell[06]);
      }
      2:// - долг на конец
      { _wType:=2;
        _Vidopl:=171;//Перечисление з/п в банк (системный)
        _su:=MyDouble(v_imp.tmp_excel.dmcell[07]);
      }
      //не надо! Двоим
      3:// - долг на начало
      { continue;
        _wType:=1;
        _Vidopl:=189;//Долг за предприятием
        _su:=MyDouble(v_imp.tmp_excel.dmcell[05]);

      }
      end;
      if _su=0 continue;
      _klFind:=0 ;
      //--------------------
      FindRec;
      //--------------------
      var wColumn:longint;
      wColumn:=2;
      // номер колонки после вывода !!!
      tmp_Sverka.CODE      :=word(_Vidopl);
      tmp_Sverka.SUMM      :=tmp_Sverka.SUMM+_su;
      tmp_Sverka.DCODE     :=v_imp.tmp_excel.dmcell[04]; //tmp_Sverka.GALDCODE; // пусть совпадают
      tmp_Sverka.WORKTYPE  :=v_imp.tmp_excel.dmcell[09];
      tmp_Sverka.FIOFULL   :=_sFio;
      tmp_Sverka.DOCNUMB   :=_GALDOCNUMB;
      wColumn++;//21 string[30] //СНИЛС
      update current tmp_sverka;
    }//For(jj:=;jj<=3;jj++)
  } //v_imp._loop tmp_excel

  //Долги и выплаты
  //===================================
  Timelog('GP_Sverka_Nachisl_Import->Import:Finish');
  if getfirst tmp_sverka=tsok {}
  ReScanPanel(#tmp_sverka);
  ClearFuncCache;
  Result:=true;
} //FomdDoc


//====================================================
Window wnGetFond 'Результаты' (,,sci1ESC);
//====================================================
Screen scrRes;
Show at (,,,4);
Table tmp_sverka;

Fields
 [Err]  if(BoundActive(tbbyErr),'Только отклонения','') : Protect, NoDel;
 wOption: NoProtect;
 //,['6666.88999']
 fDelta :[10.3], NoProtect;
Buttons
  cmValue2    ,,, 'Только ошибки', hcAllBOk, scGalDial;
//  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;
<<
  <.Только ошибки/Все .> .@@@@@@@@@@@@@@@@@@@          [.] Не проверять ФИО`
                         Сверять суммы с погр..@@@@@@  [.] Не проверять Суммы`
>>
end;
#UNDEF GP_Sverka_Nachisl_IMP_FLD
#DECLARE GP_Sverka_Nachisl_IMP_FLD (FLD,FLD1, Title, Format)
  tmp_sverka.#(FLD) #(Title)  : #(Format) , Protect,NoDel,
  {Font={Color=if(tmp_sverka.#(FLD)<>tmp_sverka.#(FLD1),ColorsysRed,ColorSysBlack)}};
  tmp_sverka.#(FLD1) 'КИС'  : #(Format) , Protect,NoDel,
  {Font={Color=if(tmp_sverka.#(FLD)<>tmp_sverka.#(FLD1),ColorsysRed,ColorSysBlack)}};
  [D_#(FLD)] if(tmp_sverka.#(FLD)<>tmp_sverka.#(FLD1),1,0) 'Д':[3],Protect;
#END
Browse brRes (,,sci1ESC);
Show at (,5,,);
Table tmp_sverka;
//fixedLeft (tmp_sverka.FIO,tmp_sverka.FIOFULL) ;
Fields

  #GP_Sverka_Nachisl_IMP_FLD(FIO,FIOFULL,'ФИО',[20])
  tmp_sverka.Sovm 'Совм' : [10] ,[List 0 'Основное',3 'Совместительство'],Protect;
  tmp_sverka.wType 'Тип' : [10] ,[List 1 'Начисление',2 'удержание'],Protect;
  #GP_Sverka_Nachisl_IMP_FLD(Vidopl,Code,'Вид оплат',[7])
  #GP_Sverka_Nachisl_IMP_FLD(Summa,Summ,'Сумма',[13.2])
  tmp_sverka.Summa-tmp_sverka.Summ 'Разница' :[13.2],Protect;
  #GP_Sverka_Nachisl_IMP_FLD(GALDCODE,DCODE,'Подр.',[10])
  #GP_Sverka_Nachisl_IMP_FLD(GALDOCNUMB,DOCNUMB,'СНИЛС',[20])
end;
HandleEvent
cmCheckfield:
{ case curField of
  #fDelta:
  { ClearFuncCache;
    ReReadRecord(#tmp_sverka);
  }
  end;
}
cmValue2:
{
  if BoundActive(tbbyErr)  SubBounds(tbbyErr)
  else                     AddBounds(tbbyErr);
  ClearFuncCache;
  ReReadRecord(#tmp_sverka);
  ReScanPanel(#tmp_sverka);

}
end;
end;//Window wnGetFond

//---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_KatPodr
    { #mrkfiltr_(KatPodr_Flt,KatPodr,Nrec,wc_nrec,KatPodr_Flt.Name)
    }
    ReScanPanel(#KatPodr_Flt);
  } //Procedure SetFilterNM(_Field:longint)


Screen scrParam;
Table KatPodr_Flt;
Fields
  wYear_flt:NoProtect;
  wMonth_Flt:NoProtect;
  'SQL Results' :Protect;
  nm_file:NoProtect, PickButton;
  'Лист1' :Protect;
  nm_file_dv:NoProtect, PickButton;
//  Filtr_Katpodr : Protect, PickButton;
//  Только подразделения
//  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
Buttons
  cmOk    ,,, 'Установить фильтр', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;

<<
  Год    .@@@@@@@@@@@@@@@@@@
  Месяц  .@@@@@@@@@@@@@@@@@@  Лист .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  Файл   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  Долги и выплаты             Лист .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  Файл   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 <. Продолжить .>  <.   Отмена   .>
>>
end;


HandleEvent
  cmInit:
  { nm_file:='';
    fDelta :=0.01;
    if not ReadMyDsk(nm_file,'GP_Sverka_Nachisl_Import_nm_file',False)
    {  //nm_file:=TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\ZP\Начисления и удержания КИС Январь 20180205 12-49.xls';//Начисления ЯНВ.xlsx' ;
       //nm_file:='Начисления ЯНВ.xlsx';
       nm_file:='Начисления и удержания КИС Январь 20180205 12-49.xls';
    }
    if not ReadMyDsk(nm_file_dv,'GP_Sverka_Nachisl_Import_nm_file_dv',False)
    {  //nm_file:=TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\ZP\Начисления ЯНВ.xlsx' ;
       nm_file_dv:='Начисления ЯНВ_Долг_Выпл.xlsx';
    }
    if not ReadMyDsk(wFlt,'GP_Sverka_Nachisl_Import_wFlt',False)  wFlt:=0;
    logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0)
                               +'!TimeLog.log';
    timelog_init;
    wMonth_Flt:=MonthRas;
    wYear_Flt :=YearRas;
    wOption:=1;
    Marker_KatPodr   :=InitMarker('GP_Sverka_Nachisl_Import_KatPodr'  , 8, 50, 10, True);
    SetFilterNm(0);
  }
  cmDone:
  { DoneMarker(Marker_Katpodr , 'GP_Sverka_Nachisl_Import_Katpodr'  );
    SaveMyDsk(wFlt,'GP_Sverka_Nachisl_Import_wFlt');
    SaveMyDsk(nm_file   ,'GP_Sverka_Nachisl_Import_nm_file');
    SaveMyDsk(nm_file_dv,'GP_Sverka_Nachisl_Import_nm_file_dv');

  }
  cmOk:
  { SaveMyDsk(nm_file,'GP_Sverka_Nachisl_Import_nm_file');
    SaveMyDsk(nm_file_dv,'GP_Sverka_Nachisl_Import_nm_file_dv');

    StartNewVisual(vtNumericVisual, vfTimer+vfThread, 'Ждите, идет сбор данных', 0);
    FormDoc;
    StopVisual('',0);
    if VisualizationActive
      StopVisual('',0);
    RunWindow(wnGetFond);
  }
  cmCheckField:
  { case curField of
    #wOption:
    { ClearFuncCache;
      ReReadRecord(#tmp_sverka);
    }
    #nm_file:
    { if not FileExist(nm_file) message('Файл не найден!');

    }
    end;
  }
  cmPick:
  { case CurField of
    #nm_file:
    { var ww_str:string=GetFileName('*.xlsx','Выберите файл начислений из КИС');
      if ww_str<>'' set nm_file:=ww_str;
    }
    #nm_file_dv:
    { var ww_str:string=GetFileName('*.xlsx','Выберите файл долгов и выплат из КИС');
      if ww_str<>'' set nm_file_dv:=ww_str;
    }

    #Filtr_Katpodr:
    { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
      { SetFilterNm(#Filtr_Katpodr);
        BitOnW(wFilter,5);
      }
    }
    end;
  }
  cmDelOnProtect:
  {   case CurField of
      //------------------------------
      #Filtr_Katpodr:
      { ClearMarker(Marker_Katpodr);
        SetFilterNm(#Filtr_Katpodr);
      }
      end;
  }
  end;

end.
