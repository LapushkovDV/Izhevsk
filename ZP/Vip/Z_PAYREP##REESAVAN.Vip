/*
Очередь сообщений
1. Формировать документы на основе выгруженных данных?
2. Сформирован документ № 0000007 на сумму 100000.00
    Перечисление аванса в банк
3. Запустить деление реестров
*/
//------------------------
#include GP_GRVPLAN.Vih
//------------------------
#component "Z_PAYREP"
Alter InterFace REESAVAN;
OverLoad
  procedure InsertDocument;
  function Processing: word;
  procedure LoadSetting;
  function GetDocName(SysCode: word): string;
end;
//'Z_PAYREP::REESAVAN.SCRHEADING.docName' =3
//-----------------------------
var
//-----------------------------
  MarkerSB:Longint;
  ATTR_SB_VPLAN:comp;//ВА Группа заказов к SBBAB
//------------------------
// фильтры
//------------------------
   wFilter:word;
   Marker_Count :longint;
   wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   Marker_Tmp :longint;
   #mrkfld_(vPlan)
//-----------------------------

create view X
as select
  vPlan_Flt.Name
From
  vPlan vPlan_Flt
where ((
  wc_nrec == vPlan_Flt.Nrec
))  ;

  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_vPlan
    { #mrkfiltr_(vPlan_Flt,vPlan,Nrec,wc_nrec,vPlan_Flt.Name)
    }
    ReScanPanel(#Zar_User);
  } //Procedure SetFilterNM(_Field:longint)

//------------------------------------------------------------------------------
// вставить заполненный документ в БД
//------------------------------------------------------------------------------
  procedure InsertDocument;
  { Inherited::InsertDocument;
    InsertMarker(MarkerSB,SbBan.Nrec);
  }
//------------------------------------------------------------------------------
// Производит выгрузку данных для формирования
//------------------------------------------------------------------------------
  function Processing: word;
  { ClearMarker(MarkerSB);
    timelog('REESAVAN->Processing');
    Result:=Inherited::Processing;
    case TiDk of
    //----------
    coSBBAN:
    { if DocName=3 or DocName=4 // по банку и заказу
      { ClearMarker(Marker_Tmp);
        if (wFilter and 1)>0
        { CopyMarker(Marker_Tmp,Marker_vPlan);
          StoreMarker(Marker_Tmp,'GP_ZP_ReestrDiv_vPlan');
        }
        else
        { StoreMarker(Marker_Tmp,'GP_ZP_ReestrDiv_vPlan');
        }
        SaveMyDsk(DocName, 'GP_ZP_ReestrDiv_WorkType');
        RunInterFace(GP_ZP::GP_ZP_ReestrDiv,MarkerSB, true);
        ClearMyDsk('GP_ZP_ReestrDiv_WorkType');
        ClearMarker(Marker_Tmp);
        StoreMarker(Marker_Tmp,'GP_ZP_ReestrDiv_vPlan');
      }
    }
    //----------
    coPLATVED:
    {
    }
    end;

  } //function Processing: word;

//------------------------------------------------------------------------------
// сформировать наименование реестра/ведомости
//------------------------------------------------------------------------------
  function GetDocName(SysCode: word): string;
  { Result:=Inherited::GetDocName(SysCode);
    case TiDk of
    //----------
    coSBBAN:
    { //Result := Result + DA.GetName(SysCode) + ' ';
      if DocName=3 or DocName=4 // по банку и заказу
      { if getfirst KATBANK where ((SBBAN.CBANKPOL == KATBANK.NREC)) = tsOk
             Result := Result +if(pos('в банк',Result)=0,'в банк','')
             +' "' + KATBANK.NAME + '"';
      }
    }
    //----------
    coPLATVED:
    {
    }
    end;


  } //function GetDocName(SysCode: word): string;

//------------------------------------------------------------------------------
// загрузка настроек
//------------------------------------------------------------------------------
  procedure LoadSetting;
  { Inherited::LoadSetting;
    //Переопределим значения для поля DocName
    var ArName: array[1..1] of string;
    var ArCode: array[1..1] of longint;

    SetLimit(ArName, 0);
    SetLimit(ArCode, 0);
    case TiDk of
    //----------
    coSBBAN:
    { ArCode[Count(ArCode)+1] := 0;
      ArCode[Count(ArCode)+1] := 1;
      ArCode[Count(ArCode)+1] := 2;
      ArCode[Count(ArCode)+1] := 3;//<<<< новое значение!
      ArCode[Count(ArCode)+1] := 4;//<<<< новое значение!
      ArName[Count(ArName)+1] := 'по получателю';
      ArName[Count(ArName)+1] := 'по банку';
      ArName[Count(ArName)+1] := 'по назн. платежа';
      ArName[Count(ArName)+1] := 'по банку и гос.заказу';//<<<< новое значение!
      ArName[Count(ArName)+1] := 'по банку, гос.заказу и субсидии';//<<<< новое значение!
      SetEnumList(ScrHeading, #DocName, ArName, ArCode);
    }
    //----------
    coPLATVED:
    {
    }
    end;
    if not IsPacketForm
    { if not ReadMyDsk(DocName,     GetDocPref + ':DocName', false) or (DocName > 4) //>2 в стандарте
        if not ReadMyDsk(DocName,   PrefDsk + ':DocName', false) or (DocName > 4)  //>2 в стандарте
          DocName := 0;
    }
  } //procedure LoadSetting;
//******************************************************************************
// Форматы
//******************************************************************************
ExtendFormats ScrHeading;
//------------------------------------------------------------------------------
Panel Params;
show at (,,,12);
table Zar_User;
screen ScrHeading ''; show at (,,,6) fixed_Y;
//bevel b1 {0, 0, 80, 6, bsLowered, bsFrame};
fields
 wFilter     :NoProtect;
 Filtr_vPlan ('Выделять реестра по следующим госзаказам',,sci13Esc): PickButton,Protect;
<<



                               [.] Выделять только след.заказы` .@@@@@@@@@@@@@


>>
end; // screen
end;//Zar_User
//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
  //--------------------------
  cmInit:
  { timelog_init;
    MarkerSB:=InitMarker('',8,500,100);
    Marker_Tmp   :=InitMarker(''                         , 8, 50, 10, True);
    ATTR_SB_VPLAN:=ExtAttr_CreateComp(coSBBAN,'Группа заказов', cgAttrType_Comp, word(100), coVPlan );
    Marker_vPlan :=InitMarker('REESAVAN_vPlan'  , 8, 50, 10, True);
    if not ReadMyDsk(wFilter,'REESAVAN_wFilter',False) wFilter:=0;
    SetFilterNM(0);

    if  Inherited::HandleEvent(cmInit)=heAbort Abort;
  } //cmInit:
  cmDone:
  { if  Inherited::HandleEvent(cmDone)=heAbort Abort;
     DoneMarker(MarkerSB,'');
     DoneMarker(Marker_tmp  ,'');
     DoneMarker(Marker_vPlan,'REESAVAN_vPlan');
     SaveMyDsk(wFilter,'REESAVAN_wFilter');
  }
  cmPick:
  { if  Inherited::HandleEvent(cmPick)=heAbort Abort;
    case CurField of
    #Filtr_vPlan:
    { var pVPlan:comp;
      GetMarker(Marker_vPlan,0,pVPlan);
      if (RunInterface(GP_GRVPLAN,pVPlan,0
        ,17//pWorkType
        ,Marker_vPlan
         ) <> cmCancel)
      {
        //ClearMarker(Marker_vPlan);
        //InsertMarker(Marker_vPlan,pVPlan);
        SetFilterNM(0);
      } //if (RunInterface(GRVPLAN,pVPlan,0
    } //Filtr_vPlan:
    end;
  }
  cmDelOnProtect:
  { if  Inherited::HandleEvent(cmDelOnProtect)=heAbort Abort;
    case CurField of
    #Filtr_vPlan:
    { ClearMarker(Marker_vPlan);
      SetFilterNM(0);
    }
    end;
  }

  end;
end.
