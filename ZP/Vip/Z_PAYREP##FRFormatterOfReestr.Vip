#component "Z_PAYREP"
#doc
 ЗП - отчеты - расчеты по оплате труда - Реестры - печать
#end
Alter interface FRFormatterOfReestr;
OverLoad
  datastream EReestr;
//  procedure PrepareData;
end;

var  ATTR_B_INN:comp;//ВА ИНН к KatBank
var  ATTR_B_KPP:comp;//ВА КПП к KatBank
var  ATTR_SB_PRIM :comp;//ВА Примечание к SBBAB
var  sPrim     :string;
var  pSBBAN    :comp;
var  sUNN      :string;
var  sFIO, sNomCard :string;
var  sNOMLSH   :tNomLSch;
var  pLsch     :comp;
//******************************
table Struct local tmp_SPPLBAN
(  cSbBan   :comp
  ,cSPPLBAN :comp
  ,cLsch    :comp
  ,FIO      :string
  ,SumOpl   :double
  ,NomCard  :string
  ,NOMLSH   :tNomLSch
)
with index
(  tmp_SPPLBAN01 = Fio + NOMLSH
  ,tmp_SPPLBAN02 = cLsch
);
//******************************
create view
From
   KatOrg KatOrg_SpPlBan
 , tmp_SPPLBAN
where
((
     KATBANK_SPPLBAN.cOrg  == KatOrg_SpPlBan.Nrec
and  KATBANK_SPPLBAN.CBANK == KATB.NREC
//---------------------------
//and  SPPlBan.cPodr == Shtraf.Nrec(noindex)
//-------------------------
and SPPLBAN.PAYNUM   == SHTRAF.LASTUSER(noindex)
and SPPLBAN.CPOL     == SHTRAF.CPOL    (noindex)
and SPPLBAN.CBANKPOL == SHTRAF.CBANKPOL(noindex)

//-------------------------
and Date(Last_Day(SbBan.DataN), month(SbBan.DataN), year(SbBan.DataN))    >>=SHTRAF.DATANSK(Noindex)
and ( (SHTRAF.DatOK=date(0,0,0) or SHTRAF.DatOK>SbBan.DataN)
  and ( SHTRAF.FIO='' or SPPlBan.FIO = SHTRAF.FIO)
 )
))
;



Procedure Init_Attr;
{ timelog_init;
  ATTR_B_INN  :=ExtAttr_Create(coKatBank,'ИНН', cgAttrType_Str );
  ATTR_B_KPP  :=ExtAttr_Create(coKatBank,'КПП', cgAttrType_Str );
  ATTR_SB_PRIM:=ExtAttr_Create(coSBBAN,'Примечание'    , cgAttrType_Str);
}

//-----------------------
// Получить ИНН Банка
//-----------------------
Function GetBankInn(_pKatBank:comp; _sInn:string ) :string;
{ Result:=sGetAttrID(coKatBank,_pKatBank,ATTR_B_INN);
  if Result='' Result:=_sInn;
}



//-----------------------
// Получить ИНН Банка
//-----------------------
Function GetBankKPP(_pKatBank:comp; _sKPP:string ) :string;
{ Result:=sGetAttrID(coKatBank,_pKatBank,ATTR_B_KPP);
  if Result='' Result:=_sKPP;
}

Function GetUIN( _Name:string ) :string;
{ //УИН:
  Result:='';
  _Name:=UpCase(_Name);
  if pos('УИН:',_Name)>0
  { Result:=trim(SubStr(_Name,pos('УИН:',_Name)+4,200 ));
  }
}

Function GetPrim:string;
{ Result:=sGetAttrID(coSbBan,SBBAN.NRec,ATTR_SB_Prim);
  if Result=''
    if SBBAN.cNode>0
      Result:=sGetAttrID(coSbBan,SBBAN.cNode,ATTR_SB_Prim);
  if Result=''
    Result:='за '+if(SBBAN.Prefix='R$A' or SBBAN.Prefix='RO' ,'1 половину','2 половину')
      +DateToStr(SbBan.DataN,' mon YYYY г');
}



//<SPPLBAN."FIO">+<SPPLBAN."NomCard">+<SPPLBAN."NOMLSH">
datastream EReestr //{
  ( //[MyOrg] sGetTune('MyOrg');
    table Inherited::KATBANK_SPPLBAN
    (
      [INN] GetBankInn(KATBANK_SPPLBAN.Nrec,KatOrg_SpPlBan.UNN)     ;//: tNRec        "Номер записи"
      [KPP] GetBankKPP(KATBANK_SPPLBAN.Nrec,KatOrg_SpPlBan.KodPLatNDS);//КПП
      [POL] KatOrg_SpPlBan.Name;
    );
    //000000000C11695Fh
    //000A000000004B9Dh
    table Inherited::SBBAN
    ( [Prim] GetPrim;
    );
    table Inherited::SPPLBAN
    ( [FIO3] My_Sclonenie(SPPLBAN.FIO,23,0);
      [ISP_LIST] if(isValidAll(#SHTRAF),SHTRAF.LASTUSER,'') ;//
      [UIN]      GetUIN(SbBan.Name);
      [NamePl1]  if(isValidAll(#SHTRAF),SHTRAF.namepl1,''); //назначение платежа 1
      [NamePl2]  if(isValidAll(#SHTRAF),SHTRAF.namepl2,''); //назначение платежа 2
      // вместо [SUM(<SPPLBAN."SUMOPL">,MasterData2)]
    );
    table tmp_SPPLBAN
    ( [cSbBan]    tmp_SPPLBAN.cSbBan;
      [cSPPLBAN]  tmp_SPPLBAN.cSPPLBAN;
      [cLsch]     tmp_SPPLBAN.cLsch;
      [FIO]       tmp_SPPLBAN.FIO;
      [SumOpl]    tmp_SPPLBAN.SumOpl;
      [NomCard]   tmp_SPPLBAN.NomCard;
      [NomLSch]   tmp_SPPLBAN.NOMLSH;
    );
  )
end; // datastream EReestr }

