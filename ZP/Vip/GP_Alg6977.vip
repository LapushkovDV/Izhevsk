!#include galnet.inc end;
!#include glovars.inc
!#include galaktika.vil


#include ExtAttr.vih

#define OBJINT_ALGORITM
#include objintpl.vin

#component "M_MnPlan"
VipInterface Algoritm_6977 implements oAlgoritm_Sys;
Interface Algoritm_6977;

create view
var
 cWorkFormPl,ccdoc: Comp;
 wEvnCode: Word;
 sEvnLine: String;
 pfactotpusk:comp;
as select factotpusk.Nrec
from
  FormPl(ReadOnly)
 ,factotpusk
 ,shtraf
where ((
  //'настройка алгоритма
    cWorkFormPl         == FormPl.NRec
and pfactotpusk ==factotpusk.nrec
and factOtpusk.clsch==shtraf.clsch
and 15==shtraf.vidud and '+'==shtraf.pometka(noindex)
and pfactotpusk ==otpusk.cfactotpusk
))
 ;

exception ExUser1, ExUser2;

Function GetNum : word;
{
  GetNum := 6977;
}

function GetName : string;
{
  GetName := 'test run calc_dopotpusk';
}

Function GetMemo ( st:oSteckCommonString ) : Boolean;
{
  GetMemo := True;

  st.push('After-дорасчет отпуска');
}

Function GetNameInter : String;
{
  GetNameInter := 'Algoritm_6977' ;
}

Function GetNameInterPr : String;
{
  GetNameInterPr := 'AlgoritmSetup_6977' ;
}

//=======================================================================
// 'ИНИЦИАЛИЗАЦИЯ АЛГОРИТМА'
//-----------------------------------------------------------------------
//'коды ситуаций - до 49 включительно
Function InitInter( Var pt:TRecAcc ) : Boolean;
{
  InitInter := False;

_try
{
 pt.Visua    := Word(0);
 pt.MessEnd  := Word(0);

  cWorkFormPl := pt.cFormPl;
  if (GetFirst FormPl <> tsOk)
  {
   wEvnCode := 1;
   sEvnLine := 'Пользовательский алгоритм не найден (скорее всего, он был удален)';
   _raise ExUser2;
  }

 InitInter := True;
}  //'_try

_except
 on ExUser1:
  pt.Error := 1;

 on ExUser2:
 {
  Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally
{
 //'
}
}

//=======================================================================
// 'ЗАВЕРШЕНИЕ РАБОТЫ С ИНТЕРФЕЙСОМ'
//-----------------------------------------------------------------------
Function DoneInter( Var pt:TRecAcc ) : Boolean;
{
 #__UNUSED__(pt)
 DoneInter := True;
}

//=======================================================================
Function RunInter( wflag:Word; Var pt:TRecAcc ) : Boolean;
{
  #__UNUSED__(wflag)

_try {
  RunInter := False;

  if (pt.Visua = 0)
    StartNewVisual(vtRotateVisual, vfTimer+vfBreak+vfConfirm,GetName+'...', 0);

!  Message('pt.cpnRec='+pt.cpnRec);
   set pfactotpusk :=pt.cpnrec;
if getfirst factotpusk=tsok // where ((pt.cpnrec==factotpusk.nrec))=tsok
{
	_Loop shtraf// if getfirst shtraf where ((factOtpusk.clsch==shtraf.clsch and 15==shtraf.vidud and '+'==shtraf.pometka(noindex)))=tsok
	{
		factotpusk.SUMOPL:=0;
		_loop otpusk //where ((pt.cpnrec==otpusk.cfactotpusk))
		{
		otpusk.sumopl:=otpusk.sumopl-round(shtraf.sumud/last_day(otpusk.datok)*otpusk.koldn,-1);
		if otpusk.SUMOPL<0 otpusk.sumopl:=0;
		update current otpusk;
		factotpusk.SUMOPL:=factotpusk.SUMOPL+otpusk.sumopl;
		}
	update current factOtpusk;
	}

}


  RunInter := True;
}  //'_try

_except
 on ExUser1: pt.Error := 1;

 on ExUser2:{
   Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally {
  if (pt.Visua = 0) StopVisual('', 0);

  DoneInter(pt);
}
}
end.
