/*************************************************************************************************\
* Наименование:  Ведомость распределения н/ч для ПЭУ                                              *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата     |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2313          |27/04/18 |Ермолов К.Р.             |НПО Энергомаш                  *
* Разработка  |#2313          |01/03/21 |kurennykh                |НПО Энергомаш                  *
\*************************************************************************************************/

#include userreport.vih
#include marker.vih

interface gp_economnormchas 'Параметры отчета' gray
Show at (,,40,7);

table struct tSelVidpr
(
nrec: comp,
name: string
)
with index
(
i1 = nrec (autoinc, unique)
)
;

table struct meschas
(
vidpr: string,
podr: string,
sch: string,
subsch: string,
zakaznmb: string,
chas: double
)
with index
(
i1 = vidpr + podr + zakaznmb (unique)
)
;

table struct godchas
(
vidpr: string,
podr: string,
sch: string,
subsch: string,
zakaznmb: string,
chas: double
)
with index
(
i1 = vidpr + podr + zakaznmb (unique)
)
;

create view economnormchas

var
excelpath, vidpr, cvidpr, pVidpr, pPodr, formVidprChas, formVidprChasGod: string;
counter, counterf: longint;
mes: word;
god: integer;
pMarkerVidpr: Imarker(marker) new;
chaspodr, chasvidpr, godchaspodr, godchasvidpr: double;
HrsType : longint = 0;
as select * from tSelVidpr, meschas, godchas;

window wnSelVidpr 'Вид производства' doAccept, EscClose;
Show at (5,5,50,35);
Browse brSelVidpr '' ;
Table tSelVidpr;
recMarker=pMarkerVidpr {tSelVidpr.nrec};
Fields
tSelVidpr.NAME 'Вид производства':[100],Protect,NoDel;
end;
end;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  vidpr: pickbutton, protect;
  mes : [list
        1 'Январь',
        2 'Февраль',
        3 'Март',
        4 'Апрель',
        5 'Май',
        6 'Июнь',
        7 'Июль',
        8 'Август',
        9 'Сентябрь',
        10 'Октябрь',
        11 'Ноябрь',
        12 'Декабрь'], protect;
  god: noprotect, spinbutton [1, 1917, 2117];
  HrsType: noProtect, NoFrame;
  buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Виды производства: .@@@@@@@@@@@@
    Месяц:             .@@@@@@@@@@
    Год:               .@@@@@

    `Брать н-часы из`  (.) табеля`
                       (.) нарядов`

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  mes:= month(dgettune('UP.DATOTCH'));
  god:= year(dgettune('UP.DATOTCH'));
  Vidpr:= 'Не выбрано';

  sql
  select #comp(0), attrval.vstring
  from attrval
  inner join attrnam on attrnam.nrec = attrval.cattrnam and attrnam.name = 'Вид производства'
  where attrval.vstring = 'Основное производство' or attrval.vstring = 'Инструментальное производство' or attrval.vstring = 'Вспомогательное производство'
  or attrval.vstring = 'Конструкторское бюро' or attrval.vstring = 'Научно-испытательный комплекc' or attrval.vstring = 'Холдинг'
  group by attrval.vstring
  into tSelVidpr
  ;
}

cmPick:
{
  if curfield = #vidpr
  {
    runwindow(wnSelVidpr);
  }
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from meschas;
  delete all from godchas;

  SubBounds(tbRmtSelVidpr1);
  AddBounds(tbRmtSelVidpr2);

  _loop pMarkerVidpr
  {
    cVidpr:= tSelVidpr.name;
    if (HrsType = 0) then
    {
      sql
      select attrval.vstring, substring(katpodr.kod,1,3), substring(buhschet.schet,2,length(buhschet.schet)), buhschet.subsch, mnplan.number, sum(case when nachislzakaz.vidopl in (1, 3, 5, 9, 10) then nachislzakaz.chasf else 0 end)
      from mnplan
      left join buhschet on buhschet.nrec = mnplan.canval2
      left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7
      left join katpodr on katpodr.nrec = nachislzakaz.cexoz
      join attrnam an1 on an1.wtable = 1413 and an1.name = 'Вид производства'
      left join attrval on attrval.crec = katpodr.nrec and attrval.cattrnam = an1.nrec and attrval.wtable = 1413
      where nachislzakaz.mesn = :(mes) and nachislzakaz.yearn = :(god) and attrval.vstring = :(cvidpr)
      group by attrval.vstring, substring(katpodr.kod,1,3), substring(buhschet.schet,2,length(buhschet.schet)), buhschet.subsch, mnplan.number
      into meschas;

      sql
      select attrval.vstring, substring(katpodr.kod,1,3), substring(buhschet.schet,2,length(buhschet.schet)), buhschet.subsch, mnplan.number, sum(case when nachislzakaz.vidopl in (1, 3, 5, 9, 10) then nachislzakaz.chasf else 0 end)
      from mnplan
      left join buhschet on buhschet.nrec = mnplan.canval2
      left join nachislzakaz on nachislzakaz.ckaud[1] = mnplan.nrec and nachislzakaz.tbld[1] = 7
      left join katpodr on katpodr.nrec = nachislzakaz.cexoz
      join attrnam an1 on an1.wtable = 1413 and an1.name = 'Вид производства'
      left join attrval on attrval.crec = katpodr.nrec and attrval.cattrnam = an1.nrec and attrval.wtable = 1413
      where nachislzakaz.yearn = :(god) and nachislzakaz.mes between 1 and :(mes) and attrval.vstring = :(cvidpr)
      group by attrval.vstring, substring(katpodr.kod,1,3), substring(buhschet.schet,2,length(buhschet.schet)), buhschet.subsch, mnplan.number
      into godchas;
    }
    if (HrsType = 1) then
    {
      sql
        select attrval.vstring, substring(katpodr.kod,1,3), substring(buhschet.schet,2,length(buhschet.schet)), buhschet.subsch, mnplan.number, sum(prn.chasf)
        from prnaryad prn
        inner join sys_nar sn on sn.nrec =  prn.mnrec and sn.choice in(3, 203)
        left join mnplan on prn.ckaud[1] = mnplan.nrec
        left join buhschet on buhschet.nrec = mnplan.canval2
        left join katpodr on prn.cexoz = katpodr.nrec
        left join attrnam an1 on an1.wtable = 1413 and an1.name = 'Вид производства'
        left join attrval on katpodr.nrec = attrval.crec and an1.nrec = attrval.cattrnam and attrval.wtable = 1413
        where prn.datan between (01 + :(mes) * 256 + :(god) * 256 * 256) and (31 + :(mes) * 256 + :(god) * 256 * 256)
              and attrval.vstring = :(cvidpr)
        group by attrval.vstring, substring(katpodr.kod,1,3), substring(buhschet.schet,2,length(buhschet.schet)), buhschet.subsch, mnplan.number
      into meschas;

      sql
        select attrval.vstring, substring(katpodr.kod,1,3), substring(buhschet.schet,2,length(buhschet.schet)), buhschet.subsch, mnplan.number, sum(prn.chasf)
        from prnaryad prn
        inner join sys_nar sn on sn.nrec =  prn.mnrec and sn.choice in(3, 203)
        left join mnplan on prn.ckaud[1] = mnplan.nrec
        left join buhschet on buhschet.nrec = mnplan.canval2
        left join katpodr on prn.cexoz = katpodr.nrec
        left join attrnam an1 on an1.wtable = 1413 and an1.name = 'Вид производства'
        left join attrval on katpodr.nrec = attrval.crec and an1.nrec = attrval.cattrnam and attrval.wtable = 1413
        where prn.datan between (01 + 01 * 256 + :(god) * 256 * 256) and (31 + :(mes) * 256 + :(god) * 256 * 256)
              and attrval.vstring = :(cvidpr)
        group by attrval.vstring, substring(katpodr.kod,1,3), substring(buhschet.schet,2,length(buhschet.schet)), buhschet.subsch, mnplan.number
      into godchas;
    }
  }

  SubBounds(tbRmtSelVidpr2);
  AddBounds(tbRmtSelVidpr1);

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_economnormchas.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  if getfirst meschas = tsok
  {
    pVidpr:= meschas.vidpr;
    pPodr:= meschas.podr;
  }

  xlsetcellstringvalue('ВЕДОМОСТЬ РАСПРЕДЕЛЕНИЯ Н/ЧАСОВ ЗА ' + mes + ' МЕСЯЦ ' + god + ' ГОДА', 1, 1, 1, 1);
  counter:= 2;
  counterf:= counter + 1;
  formVidprChas:= '=СУММ(';
  formVidprChasGod:= '=СУММ(';

  _loop meschas
  {
    counter++;

    if meschas.vidpr = pVidpr
    {
      if meschas.podr = pPodr
      {
        chaspodr:= chaspodr + meschas.chas;
        xlsetcellstringvalue(meschas.podr, counter, 1, counter, 1);
        xlsetcellstringvalue(meschas.sch, counter, 2, counter, 2);
        xlsetcellstringvalue(meschas.subsch, counter, 3, counter, 3);
        xlsetcellstringvalue(meschas.zakaznmb, counter, 4, counter, 4);
        xlsetcellnumbervalue(meschas.chas, counter, 5, counter, 5);

        _loop godchas where ((meschas.vidpr == godchas.vidpr and meschas.podr == godchas.podr and meschas.zakaznmb == godchas.zakaznmb))
        {
          xlsetcellnumbervalue(godchas.chas, counter, 6, counter, 6);
          godchaspodr:= godchaspodr + godchas.chas;
        }
      }
      else
      {
        xlmergecells(counter, 1, counter, 4);
        xlAlignCells(-4152, counter, 1, counter, 1);
        xlsetfontstyle(1, counter, 1, counter, 6);
        xlsetcellstringvalue('Итого по ' + pPodr, counter, 1, counter, 1);
        xlsetcellformula('=СУММ(E' + counterf + ':E' + (counter - 1) + ')', counter, 5, counter, 5);
        xlsetcellformula('=СУММ(F' + counterf + ':F' + (counter - 1) + ')', counter, 6, counter, 6);
        pPodr:= meschas.podr;
        chasvidpr:= chasvidpr + chaspodr;
        godchasvidpr:= godchasvidpr + godchaspodr;
        chaspodr:= 0;
        godchaspodr:= 0;
        formVidprChas:= formVidprChas + 'E' + counter + ';';
        formVidprChasGod:= formVidprChasGod + 'F' + counter + ';';
        counter++;
        counterf:= counter;

        chaspodr:= chaspodr + meschas.chas;
        xlsetcellstringvalue(meschas.podr, counter, 1, counter, 1);
        xlsetcellstringvalue(meschas.sch, counter, 2, counter, 2);
        xlsetcellstringvalue(meschas.subsch, counter, 3, counter, 3);
        xlsetcellstringvalue(meschas.zakaznmb, counter, 4, counter, 4);
        xlsetcellnumbervalue(meschas.chas, counter, 5, counter, 5);

        _loop godchas where ((meschas.vidpr == godchas.vidpr and meschas.podr == godchas.podr and meschas.zakaznmb == godchas.zakaznmb))
        {
          xlsetcellnumbervalue(godchas.chas, counter, 6, counter, 6);
          godchaspodr:= godchaspodr + godchas.chas;
        }
      }
    }
    else
    {
      xlmergecells(counter, 1, counter, 4);
      xlAlignCells(-4152, counter, 1, counter, 1);
      xlsetfontstyle(1, counter, 1, counter, 6);
      xlsetcellstringvalue('Итого по ' + pPodr, counter, 1, counter, 1);
      xlsetcellformula('=СУММ(E' + counterf + ':E' + (counter - 1) + ')', counter, 5, counter, 5);
      xlsetcellformula('=СУММ(F' + counterf + ':F' + (counter - 1) + ')', counter, 6, counter, 6);
      pPodr:= meschas.podr;
      chasvidpr:= chasvidpr + chaspodr;
      godchasvidpr:= godchasvidpr + godchaspodr;
      chaspodr:= 0;
      godchaspodr:= 0;
      formVidprChas:= formVidprChas + 'E' + counter + ')';
      formVidprChasGod:= formVidprChasGod + 'F' + counter + ')';
      counter++;

      xlmergecells(counter, 1, counter, 4);
      xlAlignCells(-4152, counter, 1, counter, 1);
      xlsetfontstyle(1, counter, 1, counter, 6);
      xlsetcellstringvalue('ВСЕГО ПО ' + pVidpr, counter, 1, counter, 1);
      xlsetcellformula(formVidprChas, counter, 5, counter, 5);
      xlsetcellformula(formVidprChasGod, counter, 6, counter, 6);
      pVidpr:= meschas.vidpr;
      chasvidpr:= 0;
      godchasvidpr:= 0;
      counter++;
      counterf:= counter;
      formVidprChas:= '=СУММ(';
      formVidprChasGod:= '=СУММ(';

      chaspodr:= chaspodr + meschas.chas;
      xlsetcellstringvalue(meschas.podr, counter, 1, counter, 1);
      xlsetcellstringvalue(meschas.sch, counter, 2, counter, 2);
      xlsetcellstringvalue(meschas.subsch, counter, 3, counter, 3);
      xlsetcellstringvalue(meschas.zakaznmb, counter, 4, counter, 4);
      xlsetcellnumbervalue(meschas.chas, counter, 5, counter, 5);

      _loop godchas where ((meschas.vidpr == godchas.vidpr and meschas.podr == godchas.podr and meschas.zakaznmb == godchas.zakaznmb))
      {
        xlsetcellnumbervalue(godchas.chas, counter, 6, counter, 6);
        godchaspodr:= godchaspodr + godchas.chas;
      }
    }
  }

  if getlast meschas = tsok
  {
    counter++;
    xlmergecells(counter, 1, counter, 4);
    xlAlignCells(-4152, counter, 1, counter, 1);
    xlsetfontstyle(1, counter, 1, counter, 6);
    xlsetcellstringvalue('Итого по ' + pPodr, counter, 1, counter, 1);
    xlsetcellformula('=СУММ(E' + counterf + ':E' + (counter - 1) + ')', counter, 5, counter, 5);
    xlsetcellformula('=СУММ(F' + counterf + ':F' + (counter - 1) + ')', counter, 6, counter, 6);
    pPodr:= meschas.podr;
    chasvidpr:= chasvidpr + chaspodr;
    godchasvidpr:= godchasvidpr + godchaspodr;
    chaspodr:= 0;
    godchaspodr:= 0;
    formVidprChas:= formVidprChas + 'E' + counter + ')';
    formVidprChasGod:= formVidprChasGod + 'F' + counter + ')';
    counter++;

    xlmergecells(counter, 1, counter, 4);
    xlAlignCells(-4152, counter, 1, counter, 1);
    xlsetfontstyle(1, counter, 1, counter, 6);
    xlsetcellstringvalue('ВСЕГО ПО ' + pVidpr, counter, 1, counter, 1);
    xlsetcellformula(formVidprChas, counter, 5, counter, 5);
    xlsetcellformula(formVidprChasGod, counter, 6, counter, 6);
    pVidpr:= meschas.vidpr;
    chasvidpr:= 0;
    godchasvidpr:= 0;
  }

  xlframecells(1+2+4+8+16+32, 2, 1, 1, 2, 1, counter, 6);

  StopVisual('',0);
  xlkillExcel;
}

end;

windowevent wnSelVidpr;

cmdefault:
{
    if pMarkerVidpr.count = 0
    {
      Vidpr:= 'Не выбрано';;
    }

    SubBounds(tbRmtSelVidpr1);
    AddBounds(tbRmtSelVidpr2);

    _loop pMarkerVidpr
    {
      if pMarkerVidpr.count = 1
      {
        Vidpr:= tSelVidpr.name;
      }
    }

    SubBounds(tbRmtSelVidpr2);
    AddBounds(tbRmtSelVidpr1);

    if pMarkerVidpr.count > 1
    {
      Vidpr:= 'Выбрано ' + pMarkerVidpr.count;
    }

    rescanpanel(scr);
}

end;
end.

VipInterface UserReport_economnormchas Implements IUserReport;
Interface UserReport_economnormchas;

Procedure Run;
Begin
  runinterface(gp_economnormchas);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Ведомость распределения н/ч для ПЭУ';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Экономическая и статистическая отчетность';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
