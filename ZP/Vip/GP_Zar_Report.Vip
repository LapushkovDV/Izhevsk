//_________________________________________________
// настройка пользователя в init interface
// оперделяет в глобальные переменные
//       myPlansNo     - текущий номер ПЛАНА СЧЕТОВ
//================================
function GetUserTuneParam (var myPlansNo  : comp)    // текущий план счетов
: boolean;
var cPLANSRab : comp; //рабочее поле
{
  GetUserTuneParam := false;
  cPLANSRab := 0;
  myPlansNo :=coGetTune('KONSOLID.CPLANSSCH'); // План счетов из Консолидации
  if (myPlansNo = 0)
    { message(''#3'Установите текущий план счетов!',okButton);
      Exit;
    }
  cPLANSRab := coGetTune('FIN.USER.CPLANSSCH');
  if cPLANSRab <> 0
     myPlansNo  := cPLANSRab;
  if (modifier GetFirst PlansSch
       where (( myPlansNo == PlansSch.NRec )) <> tsOk)
    { message(''#3'Утеряна настройка планов счетов!' +
           ''#13#3'Проведите настройку!' +
           ''#13#3'Установите текущий план счетов.',okButton);
      Exit;
    }
  GetUserTuneParam := true;
}


