/*************************************************************************************************\
* Наименование:  Доработка интерфейса Заработная плата -> Документы -> Лицевые счета ->           *
*                Локальное меню ->  Смежные данные (Alt+C) ->  Закладка <Текущие данные> >        *
*                Выплаты в межпериод,  закладка <Отнесение затрат>                                *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    требуется начинать выбор распределения с номера заказа с последующим             *
*                автоматическим формированием счета бухгалтерского учета.                         *
*                Собирать перед Z_WT##WTCOSTSHARING.vip                                           *
* 1810 - Копирование строки заданное кол-во раз                                                   *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#772          |10/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#1810         |04/02/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#2070         |16/03/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#3297         |24/08/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#3574         |31/10/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#include GetKau.Vih
#include marks.vih
#component "Z_MP"
//*****************************************
Alter Interface PRVIDOPL1;
//*****************************************
OverLoad
procedure SetPaymentSum(Sum: double; currencyParamsChanged: boolean);
Procedure SetPrVidOplDefault(PAMI: IPersonalAccountMarksIterator;
                            DateForParams: date);
procedure ImportDataFromXLS;
end;//OverLoad
#include GetKau.Var
#include GP_Func_ZP.Var

var wKodAnalitik :word;//код "избранная аналитика"
var pTmp         :comp;//временная для выбора
var wClone_Copy     :word;//кол-во копий
//---- настройки
//-- #2070
var NPOEM_OWN_ZP_MP_Vipl:boolean;//'Заполнять поле "Выплачено(аванс)" в начислениях и выплатах межпериода'

//----------------------------

Create View vSpr
var
 pBuhSchet:comp;
 pMnPlan  :comp;
From BuhSchet,MnPlan
where ((
    pBuhSchet == BuhSchet.Nrec
and pMnPlan   == MnPlan.Nrec
));



//------------------------------------
//--- импорт  #3297
//------------------------------------
procedure ImportDataFromXLS;
{ Inherited::ImportDataFromXLS;
  if (FlagImport <> 1)
    exit; //флаг импорта выключен
  _Loop fullcache TABLEIMPORT
  { if TABLEIMPORT.NSchetDeb=''
    { if (TABLEIMPORT.MnPlanNo <> '')
      { if (getFirst MnPlan where ((  toMnfZakaz == MnPlan.TypePlan // производственный заказ
                                    and TABLEIMPORT.MnPlanNo == MnPlan.Number )) = tsOk)
        { vSpr.pMnPlan:=MnPlan.Nrec;
          if vSpr.Getfirst MnPlan=tsok
          { vSpr.pBuhSchet:= pGP_Func_ZP.GetBuhschetByMnPlanCur(MnPlan.Nrec);
            if vSpr.getfirst BuhSchet=tsok
            { TABLEIMPORT.NSchetDeb   :=substr(vSpr.BuhSchet.Schet,2,20);
              TABLEIMPORT.NSubSchetDeb:=vSpr.BuhSchet.SUBSCH;
              update current TABLEIMPORT;
            }
          } //if vSpr.Getfirst MnPlan=tsok
        } //if (getFirst MnPlan where ((
      } //if (TABLEIMPORT.MnPlanNo <> '')

    } //
  } //_Loop TABLEIMPORT

} //procedure ImportDataFromXLS;


//------------------------------------
// Установить параметры по плану
//------------------------------------
Function SetFieldsByMnPlan(_pMnPlan:comp):boolean;
var ii:word;
{ Result:=false;
  #FUNC_ZP_Fill_To_SchKauParam(PrVidOpl,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.SetFieldsByMnPlan(_pMnPlan,PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(PrVidOpl,cSchetD,cSubSchD,cKaud,Tbld)
    Result:=true;
    SetModified(true);
    UpdateTable;
  }
}//Function SetFieldsByMnPlan(_pMnPlan:comp);

//-------------------------------
//проверим субсчет по заказу, если не совпадает поменяем
Procedure Check_Analitic_MnPlan;
{ #FUNC_ZP_Fill_To_SchKauParam(PrVidOpl,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.Check_Analitic_MnPlan(PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(PrVidOpl,cSchetD,cSubSchD,cKaud,Tbld)
    SetModified(true);
    UpdateTable;
  }
} //Procedure Check_Analitic_MnPlan;

//-- #2070
//procedure TransferPayments;
//-- if IsDelayPayment - тоже обнуляет
Procedure SetPrVidOplDefault(PAMI: IPersonalAccountMarksIterator;
                            DateForParams: date);
{ Inherited::SetPrVidOplDefault(PAMI,DateForParams);
  if not NPOEM_OWN_ZP_MP_Vipl//'Заполнять поле "Выплачено(аванс)" в начислениях и выплатах межпериода'
  { PRVIDOPL.SUMUD:=0;
  }
} //Procedure SetPrVidOplDefault

//-------------------------------
// Установка суммы выплаты
//-------------------------------
procedure SetPaymentSum(Sum: double; currencyParamsChanged: boolean);
{ var _boUder:boolean=false;
  if PRVIDOPL.SUMUD>0 _boUder:=true;
  Inherited::SetPaymentSum(Sum, currencyParamsChanged);
  //-- #2070
  if not NPOEM_OWN_ZP_MP_Vipl//'Заполнять поле "Выплачено(аванс)" в начислениях и выплатах межпериода'
  { if not _boUder
    { SYS_MBF.SUMMAUD := SYS_MBF.SUMMAUD - PRVIDOPL.SUMUD;
      PRVIDOPL.SUMUD:=0;
    }
  }
} //procedure SetPaymentSum(Sum: double; currencyParamsChanged: boolean);

//******************************************************************************
// Форматы
//******************************************************************************
ExtendFormats rrr;

browse rrr 'Основная' (,, scprvidopl);
  show at (,,,22);
  table PRVIDOPL;
  fields
    //{font = {color = if(Mark <> '', ColorMark, 0)}};
       SCHETDEB
          'Счет': [4], protect, noautosize;
       SUBSCHDEB
          'С/сч': [4], protect, noautosize;
       NAMKAUD
          'КАУ': [40], protect, PickButton;
       HozOper.Name1
          'ТХО' ('Наименование типовой хозяйственной операции'): [40], protect, pickbutton;
       PrVidOpl.param
          'Параметр' ('Параметр типовой хозяйственной операции'): [20], noprotect, pickbutton, noautosize;
       '    '  ' ' :[10],Protect;
end;//browse rrr

  //******************************************************************************
  // Визуальная часть
  //******************************************************************************
  Window wnCloneParam 'Параметры копирования спецификации'  Cyan, EscClose;
    Show at (,,72,7);
  Screen scrClone '' ('Параметры копирования спецификации',,sci1Esc);
  Table PrVidopl;
  Fields
    wClone_Copy  (,,):NoProtect;//
  Buttons
    cmOk    ,,, 'копирования спецификацию', hcAllBOk, scGalDial;
    cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;
  <<
 `Количество копий `  .@@@@@@@@@@

 <. Продолжить .>  <.   Отмена   .>
  >>
  end; //Screen scrFilter (,,sci13Esс);

  HandleEvent
  cmInit:
  { wClone_Copy :=1;
  }
  cmCheckField:
  { case CurField of
    #wClone_Copy:
    { if wClone_Copy>10
      { message('Кол-во копий не может быть больше 10');
      }
    }
    end;
  }
  cmOk:
  { if wClone_Copy>10
    { message('Кол-во копий не может быть больше 10');
      CloseWindowEx(wnCloneParam,cmDone)

    }
    else
      CloseWindowEx(wnCloneParam,cmDefault)

  }
  end; // HandleEvent
  end; // Windows wnFilter 'Установите фильтры' , Cyan, EscClose;


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
  //------------------------
  cmInit:
  { timelog_init;
    timelog('PRVIDOPL1->cmInit');
    //"Настройки Галактики \ Управление персоналом \ Расчеты с персоналом \ Избранная аналитика"
    wKodAnalitik:=wGetTune('UP.ZAR.FAVORITEANALYTICS');
    //-- #2070
    NPOEM_OWN_ZP_MP_Vipl:=boGetTune('NPOEM_OWN.ZP.MP_Vipl');//'Заполнять поле "Выплачено(аванс)" в начислениях и выплатах межпериода'

    //----------------------
    if  inherited :: handleEvent (cmInit)=heAbort then Abort;
    //Погосский К.В. для Факела
    StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Обработка информации', RecordsInTable(#PrVidOpl));
    
    if wGetTune('UP.FakelGAL.Fakel') = 1
    {
      PushPos(#prvidopl);
      _loop PRVIDOPL
      {
        if not NextVisual
          break;
    
        if PRVIDOPL.VIDOPL = 101 and PRVIDOPL.SUMMA3 = 0
        {
          PRVIDOPL.SUMMA3 := LSCHET.TARIF;
          update current PRVIDOPL;
        }
      }
      PopPos(#prvidopl);
    }
    
    StopVisual('',0);
  }
  //------------------------
  cmPick:
  {
      var need_Pick:boolean=true;
      case curField of
      #Schetdeb, #SubSchdeb, #NamKaud:
      { if curField=#NamKaud
        { if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed'
        }
        if Schetdeb='' or (QuickChoiceName<>'' and curField=#NamKaud )
        { pTmp:=0;
          if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
          { if  SetFieldsByMnPlan(pTmp)
            { case curField of
              #Schetdeb, #SubSchdeb: need_Pick:=false;
              end;
            }
          }
          else
          { message('Задайте счет');
            SelectField(#Schetdeb);
          }


        } //if Schetdeb=''

      } //#Schetdeb, #SubSchdeb, #NamKaud
      end; //case curField of
      //----------------------
      if need_Pick
      { if  inherited :: handleEvent (cmPick)=heAbort then Abort;
        if curField=#NamKaud
        { Check_Analitic_MnPlan;
        }

      }
      //Погосский К.В. для Факела
      if wGetTune('UP.FakelGAL.Fakel') = 1
      {
      
        case CurField of
          #PRVIDOPL.TABN, #PRVIDOPL.STRTABN, #fFIO:
          {
            if PRVIDOPL.VIDOPL = 101 and PRVIDOPL.SUMMA3 = 0
            {
              PRVIDOPL.SUMMA3 := LSCHET.TARIF;
              update current PRVIDOPL;
            
              ReDrawPanel(CurTable);
            }
          }
        end;                //case
      
      }
  }
  cmValue60:
  { if CurTable<>#PrVidopl
    { Message('Копирование возможно только для спецификации');
      exit;
    }
    if RunWinDowModal(wnCloneParam)=cmDefault
    { var ii:word;
      UpdateTable;
      for(ii:=1;ii<=wClone_Copy;ii++)
      { Prvidopl.Nrec:=0;
        Insert current Prvidopl;
      }
      ReScanPanel(#PrVidopl);
    } //if RunWinDowModal(wnCloneParam)=cmOk
  } //cmValue60:
  end;

end.
