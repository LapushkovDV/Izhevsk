//-------------------------------------------------
// инициализировать зарплату
//-------------------------------------------------
function GetMilkPice : double;
var dBeg, dEnd : date;
{
  Result := 0;
  dBeg := date(1, pmes, pyearn);
  dEnd := date(Last_Day(dBeg), pmes, pyearn);
  _loop VALZAR where ((coGetTune('NPOEM_OWN.ZP.MILK') == valzar.kodvalut and dBeg <<= valzar.datval and dEnd >>= valzar.datval))
    if Result < valzar.sumrubl
      Result := valzar.sumrubl;
}

HandleEvent
cmInit :
{
  InitWorkingTable;
  FiltrPodr:='По всем';
  pyearn:=year(cur_date);
  pmes:=month(cur_date)-1;
  bbLoadZar := false;
  if pmes = 0
  {
    pmes := 12;
    pyearn -= 1;
  }

!  pyearn:=2001;
!  pmes:=1;
  DepMarker := InitMarker('', 8, 1, 1);
  lsMarker  := InitMarker('', 8, 100, 10, FALSE);
  ReloadLs;
  ReloadAllNach;
  InitKorrTabel;

  if getfirst tlschet=tsok
   {
    ReReadRecord(#mSumvidop);
    ReReadRecord(#KorrSumm);
   }
}
CmEdit:
{
  RunInterface('LSchet1',comp(0),tlschet.nrec,0,0);
}

CmMarkUnMark :
{
   if (not FoundMarker(lsMarker,tlschet.nrec))
     {
      InsertMarker(lsMarker,tlschet.nrec);
     }
    else
     {
      DeleteMarker(lsMarker,tlschet.nrec);
     }
 ReDrawCurrentAndGo(GetCurrentFormat, True);
}
cmSelectAll :
{
  PushPos(#tlschet);
   _loop tlschet
   {
    if (not FoundMarker(lsMarker,tlschet.nrec))
    {
     InsertMarker(lsMarker,tlschet.nrec);
    }
   }
  PopPos(#tlschet);
  ReScanPanel(#tlschet);
}
cmUnSelectAll :
{
 ClearMarker(lsMarker);
 ReScanPanel(#tlschet);
}
cmPick:
{
 Case curfield of
   #filtrPodr :
     {
       if RunInterface('SelectSalaryDepartments', 12, comp(DepMarker),
                           DepartmentValidator, ZeroDate, 0) = cmDefault
       {
        cntmrk:=GetMarkerCount(DepMarker);
         if cntmrk>0 filtrPodr  :='выбрано '+DoubleToStr(cntmrk,'666 666 667')+' подразд.'
            else filtrPodr  :='По всем';

        ReloadLs;
        ReloadAllNach;
       }
     }
  end;
 ReReadRecord(tntlschet);
 ReReadRecord(#mSumvidop);
 ReReadRecord(#KorrSumm);
}
cmDelOnProtect:
{

 Case curfield of
  #filtrPodr :
    {
     ClearMarker(DepMarker);
     filtrPodr  :='По всем';
     ReloadLs;
     ReloadAllNach;
    }
 end;
  ReReadRecord(#tlschet);
  ReReadRecord(#mSumvidop);
  ReReadRecord(#KorrSumm);
}
cmCheckField:
{
 Case curfield of
  #pmes,#pyearn:
   {
    ReloadLs;
    ReloadAllNach;
    InitKorrTabel;
    ReReadRecord(tntlschet);
    ReReadRecord(#mSumvidop);
    ReReadRecord(#KorrSumm);
    }
  end;
}
CmValue1:
{
  FullTable();
	if GetMarkerCount(lsMarker)=0
	{
    Message('Ничего не выбрано',error) ;
    stop; abort; exit;
	}

  PushConditionForLeave(tcConls,tntlschet);
  var doMilkPrice : double = GetMilkPice;

  _loop tLschet
  {
    if getfirst lstab where ((tLschet.nrec==lstab.clschet and pyearn==lstab.yearn and pMes==lstab.mesn))=tsok
  	{
      tarifMesn := lstab.tarif;
     	if lstab.sisopl=20
     	{
        message('сдельщик');
     		exit;
     	}

      if LoadWorkingTable(LStab.clschet, pMes, pYearn) <> 0 then continue;

     	if getfirst prvidopl1=tsok
     	{
        message('Сформирована ведомость. Перерасчет запрещен');
        exit;
     	}

     	delete from KorrSumm1 where ((tlschet.nrec == KorrSumm1.clsch));
  //		message (tarifMesn);

      if getfirst klrejim where ((lstab.rejim == klrejim.rejim))=tsok
     	{
     	  if getfirst GP_KLREJIM where ((klrejim.nrec == GP_KLREJIM.CKLREJIM))=tsok
     		{
     		  if getfirst GP_TIMENORMS where ((GP_KLREJIM.CGP_PRCAL == GP_TIMENORMS.CGP_PRCAL
                                                     and pYearn == GP_TIMENORMS.YEAR))=tsok
     			{
            NormaVr := GP_TIMENORMS.HOURS;
     			}
     		}
     	}

     	_loop gp_TimeTable where ((tLschet.nrec == GP_TIMETABLE.clschet
                                   and pyearn == GP_TIMETABLE.yearn
                                   and   pMes == GP_TIMETABLE.monthn))
     	{
        i := Day(gp_TimeTable.DBeg);
        //Есть случаи, когда дата окончания начисления mSumVidOpl.DatOk меньше даты окончания месяца,
        //а корректировка табеля выполняется по дням после mSumVidOpl.DatOk. Расширяем период
        //действия начисления до конца месяца.
        FixSalaryDates(tLschet.nrec);
     		do
     		{
          if lstab.DAYCHF[i]>100
            ChasfDay:=0;
          else
            ChasfDay:=lstab.daychf[i];

     			if ChasfDay<>gp_timeTable.DHOURS[i]
     			{
            var dDatAn : date = to_date(i,pmes,pyearn);

            _loop mSumvidop
     				{
              if mSumVidOp.vidoplp = 63
                continue;//Соберем отдельно, так как по нему доплата рассчитывается за весь период, а не за один день


              SummK:=0;
              if mSumvidop.datok<dDatAn or mSumvidop.datan>dDatAn continue;

     					if mSumvidop.datok=dDatAn and mSumvidop.datan=dDatAn
     					{
                ChasfDayKorr:=mSumvidop.chasf;
                SummK:=mSumvidop.summa;
     					}
     					else
     					{
                ChasfDayKorr:=(gp_timeTable.DHOURS[i]);//-DHOURSADD[i]);
     					}

     					if klvidopl.VHVOE[31]='+'
     					{
                if getfirst KorrSumm where ((lstab.clschet == KorrSumm.clsch and mSumvidop.vidopl == KorrSumm.vidopl
                                         and dDatAn == KorrSumm.datan and 0 == KorrSumm.prizn ))!=tsOK
                {
                  clearbuffer(#KorrSumm);
                  KorrSumm.prizn   := 0;
                  KorrSumm.clsch   := lstab.clschet;
                  KorrSumm.strtabn := lstab.strtabn;
                  KorrSumm.kateg   := lstab.kateg;
                  KorrSumm.cex     := lstab.cex;
                  KorrSumm.tperson := lstab.tperson;
                  KorrSumm.vidoplp := mSumvidop.vidoplp;
                  KorrSumm.vidopl  := mSumvidop.vidopl;
                  KorrSumm.proc    := mSumvidop.proc;
                  KorrSumm.SisOpl  := lstab.SisOpl;
                  KorrSumm.SummaB  := mSumvidop.summa;
                  KorrSumm.chasfB  := mSumvidop.chasf;
                  KorrSumm.datan   := dDatAn;
                  KorrSumm.datok   := dDatAn;

                  KorrSumm.proc    := mSumvidop.proc;
                  if (KorrSumm.proc = 0)
                  {
                    if (GetFirst tmpProc = tsOk)
                    {
                      KorrSumm.proc := double(tmpProc.dSum);

  //                    if KorrSUmm.vidoplp = 38
  //                    then KorrSumm.proc := KorrSumm.proc*100;
                    }
                  }

                  if (KorrSumm.proc = 0)
                    KorrSumm.proc := KlVidOpl.KFOPL;

                  if (KorrSumm.proc = 0)
                    KorrSumm.proc:=100;

  //  						  if WT_GHBD(hkWorking, 0, 0, stActual, date(i,pmes,pyearn), date(i,pmes,pyearn))<>0
  //  						  {
                    if KorrSumm.vidoplp <> 3
                    {
                      KorrSumm.chasf := -(ChasfDayKorr);
                      KorrSumm.koldn := -1;
                    }
                    else
                    {
                      KorrSumm.chasf := -(gp_timeTable.DHOURS[i]-gp_timeTable.DHOURSADD[i]-(if(gp_timeTable.dMark[i]='РВ' or gp_timeTable.dMark[i]='РО',gp_timeTable.DHOURS[i],0)));
                      KorrSumm.koldn := -1;
                    }
  //  						  }
                  if SummK<>0
                    KorrSumm.Summa  := -SummK;

                  if KorrSumm.chasf<>0 then insert current KorrSumm;
                }
                else
                {
                  if SummK<>0
                    KorrSumm.Summa  += -SummK;

                  KorrSumm.SummaB  += mSumvidop.summa;
                  KorrSumm.chasfB  += mSumvidop.chasf;

                  update current KorrSumm;
                }


                if getfirst KorrSumm where ((lstab.clschet == KorrSumm.clsch and mSumvidop.vidopl == KorrSumm.vidopl
                                         and dDatAn == KorrSumm.datan and 1 == KorrSumm.prizn ))!=tsOK
                {
                  clearbuffer(#KorrSumm);
                  KorrSumm.prizn   := 1;
                  KorrSumm.clsch   := lstab.clschet;
                  KorrSumm.strtabn := lstab.strtabn;
                  KorrSumm.kateg   := lstab.kateg;
                  KorrSumm.cex     := lstab.cex;
                  KorrSumm.tperson := lstab.tperson;
                  KorrSumm.vidoplp := mSumvidop.vidoplp;
                  KorrSumm.vidopl  := mSumvidop.vidopl;
                  KorrSumm.datan   := dDatAn;
                  KorrSumm.datok   := dDatAn;
                  KorrSumm.proc    := mSumvidop.proc;
                  KorrSumm.SisOpl  := lstab.SisOpl;
                  KorrSumm.SummaB  := mSumvidop.summa;
                  KorrSumm.chasfB  := mSumvidop.chasf;

                  if msumvidop.proc=0
                  {
                    if (GetFirst tmpProc = tsOk)
                    {
                      KorrSumm.proc := double(tmpProc.dSum);
  //                    if KorrSUmm.vidoplp=38
  //                    then KorrSumm.proc := KorrSumm.proc*100;
                    }
                  }

                  if msumvidop.proc=0
                    KorrSumm.proc := KlVidOpl.KFOPL;

                  if KorrSumm.proc=0
                  then KorrSumm.proc:=100;

                  //if LoadWorkingTable(LStab.clschet, pMes, pYearn) <> 0 then continue;

                  if WT_GHBD(hkWorking, 0, 0, stActual, dDatAn, dDatAn)<>0//проверка на выходной
                  {
                    case KorrSumm.vidoplp of
                      3, 102 :
                      {
                        KorrSumm.chasf := ChasfDay - WT_GetAbsencesHours(stActual, 'С', dDatAn, dDatAn);
                        KorrSumm.koldn := 1;
                      };
                      else
                      {
                        KorrSumm.chasf := ChasfDay;
                        KorrSumm.koldn := 1;
                      }
                    end;
                  }
                  else
                  {
                    case KorrSumm.vidoplp of
                      3, 51, 52, 53, 102 : {};
                      else
                      {
                        KorrSumm.chasf := ChasfDay;
                        KorrSumm.koldn := 1;
                      }
                    end;
                  }

                  if KorrSumm.chasf<>0 insert current KorrSumm;
                }
              }
            }

            if (wGetTune('UP.FakelGAL.Fakel') = 1)
            {
              if WT_GetAbsencesHours(stActual, 'РВ', dDatAn, dDatAn)<>0// and (mSumvidop.vidoplp=9 or mSumvidop.vidoplp=70)
              {
                if getfirst KorrSumm where ((lstab.clschet == KorrSumm.clsch
                                                    and 71 == KorrSumm.vidoplp
                                                and dDatAn == KorrSumm.datan))<>tsok
                {
                  clearbuffer(#KorrSumm);
                  KorrSumm.prizn   := 1;
                  KorrSumm.clsch   := lstab.clschet;
                  KorrSumm.cex     := lstab.cex;
                  KorrSumm.strtabn := lstab.strtabn;
                  KorrSumm.kateg   := lstab.kateg;
                  KorrSumm.tperson := lstab.tperson;
                  KorrSumm.datan   := dDatAn;
                  KorrSumm.datok   := dDatAn;
                  KorrSumm.chasf   := chasfDay;//lstab.DAYCHF[i];
                  KorrSumm.koldn   := 1;
                  KorrSumm.vidoplp := 71;
                  KorrSumm.vidopl  := 71;
                  KorrSumm.proc    := 200;
                  insert current KorrSumm;
                }
              }

              if WT_GetAbsencesHours(stActual, 'РО', dDatAn, dDatAn) <> 0// and (mSumvidop.vidoplp=9)
              {
                if getfirst KorrSumm where ((lstab.clschet == KorrSumm.clsch
                                                    and 94 == KorrSumm.vidoplp
                                                and dDatAn == KorrSumm.datan))<>tsok
                {
                  clearbuffer(#KorrSumm);
                  KorrSumm.prizn   := 1;
                  KorrSumm.clsch   := lstab.clschet;
                  KorrSumm.cex     := lstab.cex;
                  KorrSumm.strtabn := lstab.strtabn;
                  KorrSumm.kateg   := lstab.kateg;
                  KorrSumm.tperson := lstab.tperson;
                  KorrSumm.datan   := dDatAn;
                  KorrSumm.datok   := dDatAn;
                  KorrSumm.chasf   := chasfDay;//lstab.DAYCHF[i];
                  KorrSumm.proc    := 100;
                  KorrSumm.koldn   := 1;
                  KorrSumm.vidoplp := 94;
                  KorrSumm.vidopl  := 94;
                  insert current KorrSumm;
                }
              }
            }
            else
            {
              if WT_GetAbsencesHours(stActual, 'РВ', dDatAn, dDatAn)<>0// and (mSumvidop.vidoplp=9 or mSumvidop.vidoplp=70)
              {
                if getfirst KorrSumm where ((lstab.clschet == KorrSumm.clsch
                                                     and 9 == KorrSumm.vidoplp
                                                and dDatAn == KorrSumm.datan))<>tsok
                {
                  clearbuffer(#KorrSumm);
                  KorrSumm.prizn   := 1;
                  KorrSumm.clsch   := lstab.clschet;
                  KorrSumm.cex     := lstab.cex;
                  KorrSumm.strtabn := lstab.strtabn;
                  KorrSumm.kateg   := lstab.kateg;
                  KorrSumm.tperson := lstab.tperson;
                  KorrSumm.datan   := dDatAn;
                  KorrSumm.datok   := dDatAn;
                  KorrSumm.chasf   := chasfDay;//lstab.DAYCHF[i];
                  KorrSumm.koldn   := 1;
                  KorrSumm.vidoplp := 9;
                  KorrSumm.vidopl  := 9;
                  KorrSumm.proc    := 100;
                  insert current KorrSumm;
                  KorrSumm.vidoplp := 70;
                  KorrSumm.vidopl  := 70;
                  insert current KorrSumm;
                }
              }

              if WT_GetAbsencesHours(stActual, 'РО', dDatAn, dDatAn) <> 0// and (mSumvidop.vidoplp=9)
              {
                if getfirst KorrSumm where ((lstab.clschet == KorrSumm.clsch
                                                     and 9 == KorrSumm.vidoplp
                                                and dDatAn == KorrSumm.datan))<>tsok
                {
                  clearbuffer(#KorrSumm);
                  KorrSumm.prizn   := 1;
                  KorrSumm.clsch   := lstab.clschet;
                  KorrSumm.cex     := lstab.cex;
                  KorrSumm.strtabn := lstab.strtabn;
                  KorrSumm.kateg   := lstab.kateg;
                  KorrSumm.tperson := lstab.tperson;
                  KorrSumm.datan   := dDatAn;
                  KorrSumm.datok   := dDatAn;
                  KorrSumm.chasf   := chasfDay;//lstab.DAYCHF[i];
                  KorrSumm.proc    := 100;
                  KorrSumm.koldn   := 1;
                  KorrSumm.vidoplp := 9;
                  KorrSumm.vidopl  := 9;
                  insert current KorrSumm;
                }
              }
            }

            if WT_GetAbsencesHours(stActual, 'С', dDatAn, dDatAn)<>0// and (mSumvidop.vidoplp=9 or mSumvidop.vidoplp=70)
            {
              if getfirst KorrSumm where ((lstab.clschet == KorrSumm.clsch
                                                  and 10 == KorrSumm.vidoplp
                                              and dDatAn == KorrSumm.datan))<>tsok
              {
                clearbuffer(#KorrSumm);
                KorrSumm.prizn   := 1;
                KorrSumm.clsch   := lstab.clschet;
                KorrSumm.cex     := lstab.cex;
                KorrSumm.strtabn := lstab.strtabn;
                KorrSumm.kateg   := lstab.kateg;
                KorrSumm.tperson := lstab.tperson;
                KorrSumm.datan   := dDatAn;
                KorrSumm.datok   := dDatAn;

                if (WT_GetAbsencesHours(stActual, 'С', dDatAn, dDatAn)>2)
                {
                  Sverh1 := 2;
                  Sverh2 := WT_GetAbsencesHours(stActual, 'С', dDatAn, dDatAn)-2;
                }
                else
                {
                  Sverh2 := 0;
                  Sverh1 := WT_GetAbsencesHours(stActual, 'С', dDatAn, dDatAn);
                }

                KorrSumm.chasf   := Sverh1+Sverh2;
                KorrSumm.koldn   := 1;
                KorrSumm.vidoplp := 10;
                KorrSumm.vidopl  := 11;
                KorrSumm.proc    := 100;
                insert current KorrSumm;

                KorrSumm.chasf   := Sverh1/2+Sverh2;
                KorrSumm.vidoplp := 72;
                KorrSumm.vidopl  := 72;
                insert current KorrSumm;
              }
            }

            if WT_GetAbsencesHours(stActual, 'К', dDatAn, dDatAn)<>0// and (mSumvidop.vidoplp=9)
            {
              if getfirst KorrSumm where ((lstab.clschet == KorrSumm.clsch
                                                   and 5 == KorrSumm.vidoplp
                                              and dDatAn == KorrSumm.datan))<>tsok
              {
                clearbuffer(#KorrSumm);
                KorrSumm.prizn:=1;
                KorrSumm.clsch:=lstab.clschet;
                KorrSumm.strtabn:=lstab.strtabn;
                KorrSumm.kateg:=lstab.kateg;
                KorrSumm.cex:=lstab.cex;
                KorrSumm.tperson:=lstab.tperson;
                KorrSumm.datan:=dDatAn;
                KorrSumm.datok:=dDatAn;
                KorrSumm.chasf:=chasfDay;//lstab.DAYCHF[i];
                KorrSumm.koldn:=1;
                KorrSumm.vidoplp:=5;
                KorrSumm.vidopl:=5;
                insert current KorrSumm;
              }
            }
          }
          i++;
        }
        while i<day(gp_TimeTable.DEnd)+1

      }

      //Сбор данных по 63-ему виду доплаты
      //Очередное извращение, собираем все доплаты за период в разрезе тарифа (на случай если работник переводился в течении месяца)
      // и потом уже на эти часы высчитываем изменение
      clearbuffer(#KorrSumm);
      KorrSumm.clsch   := lstab.clschet;
      KorrSumm.strtabn := lstab.strtabn;
      KorrSumm.kateg   := lstab.kateg;
      KorrSumm.cex     := lstab.cex;
      KorrSumm.tperson := lstab.tperson;
      KorrSumm.vidoplp := 63;
      KorrSumm.vidopl  := 63;
      KorrSumm.datan   := date(1,pmes,pyearn);
      KorrSumm.datok   := date(last_day(KorrSumm.datan),pmes,pyearn);
      KorrSumm.proc    := 0;
      KorrSumm.SisOpl  := lstab.SisOpl;

      _loop mSumvidop
     	{
        if mSumVidOp.vidoplp != 63
          continue;//Соберем отдельно, так как по нему доплата рассчитывается за весь период, а не за один день

        if mSumvidop.datok<KorrSumm.datan or mSumvidop.datan>KorrSumm.datok
          continue;
        //message(mSumvidop.chasf);
        if msumvidop.proc=0
          KorrSumm.proc := mSumvidop.proc;

        if msumvidop.proc=0
          if (GetFirst tmpProc = tsOk)
            KorrSumm.proc := double(tmpProc.dSum);

        if msumvidop.proc=0
          KorrSumm.proc := KlVidOpl.KFOPL;

        if KorrSumm.proc=0
          KorrSumm.proc:=100;

        KorrSumm.chasf += -mSumvidop.chasf;
      }

      KorrSumm.chasf += WT_GHBD(hkNight  , 0, 0, stActual, KorrSumm.datan, KorrSumm.datok);
      KorrSumm.prizn := if(KorrSumm.chasf > 0, 1, 0);
      if (KorrSumm.chasf <> 0)
        insert current KorrSumm;
    }

    //Удалим из расчета, если есть (их быть и не должно, но вдруг уберут фильтр по ним), все записи по 11-224 виду оплаты где система оплаты сдельная
    delete all KorrSumm where ((tLschet.nrec == KorrSumm.clsch and 224 == KorrSumm.vidopl and 20 == KorrSumm.SisOpl));

    _loop KorrSumm where ((tLschet.nrec == KorrSumm.clsch and KorrSumm.vidopl /== KlVidOpl2.VidOpl))
    {
      KorrSumm.POSLRAS := KlVidOpl2.POSLRAS;

      if (KorrSumm.vidopl = 224//ИСН
       or KorrSumm.vidopl = 38)//Ежемесячная премия ОПР
       and KorrSumm.KATEG = 1
        if getfirst fastfirstrow KatPodr where ((KorrSumm.cex == katPodr.nRec))=tsOK
          if (SubStr(KatPodr.Kod, 1, 3) <> '750')
            KorrSumm.bISN_750 := true;

      update current KorrSumm;
    }

    _loop KorrSumm where ((tLschet.nrec == KorrSumm.clsch)) ordered by KorrSumm.POSLRAS
    {
      if KorrSumm.summa <> 0 continue;
      if  KorrSumm.vidoplp = 3  or KorrSumm.vidoplp = 53 //or KorrSumm.vidoplp = 32 убрали не пользуемся
         //or KorrSumm.vidoplp = 51 or KorrSumm.vidoplp = 52 or KorrSumm.vidoplp = 54 - пересчитывается ниже, на основании других видов оплат
       or KorrSumm.vidoplp = 55 or KorrSumm.vidoplp = 57// or KorrSumm.vidoplp = 62 - пересчитывается ниже, на основании других видов оплат
       or KorrSumm.vidoplp = 75
      {
        KorrSumm.summa := KorrSumm.chasf/wt_ghbd(1 or 64,0,24,-1,to_date(01, pMes, pYearn),to_date(last_day(to_date(1,pmes,pyearn)), pMes, pYearn))*tarifMesn*KorrSumm.proc/100;
      }

      if  KorrSumm.vidoplp = 68//Доплата при совмещ.профес.,расшир.зон обслуж.,увел.об.
      {
        //(Сумма начисления/Часы, за которые начислено) * Часы доначисления
        KorrSumm.summa := (KorrSumm.summaB/KorrSumm.chasfB) * KorrSumm.chasf;
      }

      if KorrSumm.vidoplp = 10
      then KorrSumm.proc := 100;// else KorrSumm.proc:=100;

      if KorrSumm.vidoplp = 9 or KorrSumm.vidoplp = 10
      or KorrSumm.vidoplp = 70 or KorrSumm.vidoplp = 72
      or KorrSumm.vidoplp = 63
      {
        KorrSumm.summa := KorrSumm.chasf/NormaVr*tarifMesn*KorrSumm.proc/100;
        if KorrSumm.vidoplp = 72
        then KorrSumm.chasf:=0;
      }

      if  KorrSumm.vidoplp = 21 or KorrSumm.vidoplp = 22 or KorrSumm.vidoplp = 23 or KorrSumm.vidoplp=34
      {
        SummRasp:=0;
        _loop KorrSumm1 where (KorrSumm1.vidoplp = 9 or KorrSumm1.vidoplp = 10 or KorrSumm1.vidoplp = 3)
                           and KorrSumm1.datan = KorrSumm.datan and KorrSumm1.prizn = KorrSumm.prizn and KorrSumm.clsch = KorrSumm1.clsch
        {
          SummRasp += KorrSumm1.summa;
        }
        KorrSumm.summa := SummRasp*KorrSumm.proc/100;
      }

      if  KorrSumm.vidoplp = 40 //Ежемесячная премия за результаты выполнения показателей прем
      {
        SummRasp:=0;
        _loop KorrSumm1 where (KorrSumm1.vidoplp = 9 or KorrSumm1.vidoplp = 10 or KorrSumm1.vidoplp = 3 or KorrSumm1.vidoplp = 72)
                               and KorrSumm1.datan = KorrSumm.datan and KorrSumm1.prizn = KorrSumm.prizn and KorrSumm.clsch = KorrSumm1.clsch
        {
          SummRasp += KorrSumm1.summa;
        }
        KorrSumm.summa := SummRasp*KorrSumm.proc/100;
      }

      if  KorrSumm.vidoplp = 38 //Ежемесячная премия ОПР
      {
        SummRasp:=0;
        _loop KorrSumm1 where (KorrSumm1.vidoplp = 9 or KorrSumm1.vidoplp = 10 or KorrSumm1.vidoplp = 3 or KorrSumm1.vidoplp = 72 or (KorrSumm1.vidoplp = 70 and KorrSumm.bISN_750))
                               and KorrSumm1.datan = KorrSumm.datan and KorrSumm1.prizn = KorrSumm.prizn and KorrSumm.clsch = KorrSumm1.clsch
        {
          SummRasp += KorrSumm1.summa;
        }
        KorrSumm.summa := SummRasp*KorrSumm.proc/100;
      }

      if KorrSumm.vidoplp = 6// and KorrSumm.Summa=>0
      {
          SummRasp:=0;
          _loop KorrSumm1 where (KorrSumm1.vidoplp = 1 or KorrSumm1.vidoplp = 9 or KorrSumm1.vidoplp = 10 or KorrSumm1.vidoplp = 3)
                               and KorrSumm1.datan = KorrSumm.datan and KorrSumm1.prizn = KorrSumm.prizn and KorrSumm.clsch = KorrSumm1.clsch
          {
            SummRasp += KorrSumm1.summa;
          }
          KorrSumm.summa := SummRasp*KorrSumm.proc/100;
      }

      if KorrSumm.vidoplp = 62 // ВРЕДНОСТЬ
      {
        SummRasp:=0;
        _loop KorrSumm1 where (KorrSumm1.vidoplp = 1 or KorrSumm1.vidoplp = 9 or KorrSumm1.vidoplp = 10 or KorrSumm1.vidoplp = 3 or KorrSumm1.vidoplp = 72)
                           and KorrSumm1.datan = KorrSumm.datan and KorrSumm1.prizn = KorrSumm.prizn and KorrSumm.clsch = KorrSumm1.clsch
        {
          SummRasp += KorrSumm1.summa;
        }
        KorrSumm.summa := SummRasp*KorrSumm.proc/100;
      }

        //Секретность и шифры
      if  KorrSumm.vidoplp = 51
       or KorrSumm.vidoplp = 52
       or KorrSumm.vidoplp = 54
      {
        SummRasp:=0;
        _loop KorrSumm1 where (KorrSumm1.vidoplp = 3 or KorrSumm1.vidoplp = 10 or KorrSumm1.vidoplp = 72)
                           and KorrSumm1.datan = KorrSumm.datan and KorrSumm1.prizn = KorrSumm.prizn and KorrSumm.clsch = KorrSumm1.clsch
        {
          SummRasp += KorrSumm1.summa;
        }
        KorrSumm.summa := SummRasp*KorrSumm.proc/100;
      }

      if KorrSumm.vidoplp = 11//ИСН
      {
        SummRasp:=0;
        if KorrSumm.vidopl = 224//ИСН
        {
          _loop KorrSumm1 where (KorrSumm1.vidopl = 7 or KorrSumm1.vidopl = 9
                              or KorrSumm1.vidopl = 11 or KorrSumm1.vidopl = 70
                              or KorrSumm1.vidopl = 72)
                             and KorrSumm1.datan = KorrSumm.datan and KorrSumm1.prizn = KorrSumm.prizn and KorrSumm.clsch = KorrSumm1.clsch
          {
            if not (KorrSumm.bISN_750)
              if (KorrSumm1.vidopl = 9  or KorrSumm1.vidopl = 70)
                continue;
            SummRasp += KorrSumm1.summa;

          }
            KorrSumm.summa := SummRasp*KorrSumm.proc/100;
        }
        else if KorrSumm.vidopl = 229//ИСН (Breton)
        {
          var SummRasp7 : double = 0;
          var SummRasp1 : double = 0;
          _loop KorrSumm1 where (KorrSumm1.vidopl = 1 or KorrSumm1.vidoplp = 7
                              or KorrSumm1.vidopl = 9 or KorrSumm1.vidopl = 11
                              or KorrSumm1.vidopl = 70 or KorrSumm1.vidopl = 72)
                             and KorrSumm1.datan = KorrSumm.datan and KorrSumm1.prizn = KorrSumm.prizn and KorrSumm.clsch = KorrSumm1.clsch
          {
            if KorrSumm1.vidopl = 1
              SummRasp1 += KorrSumm1.summa;
            else if KorrSumm1.vidopl = 7
              SummRasp7 += KorrSumm1.summa;
            else
              SummRasp += KorrSumm1.summa;
          }
          KorrSumm.summa := (SummRasp + if(SummRasp7 = 0, SummRasp1, SummRasp7))*KorrSumm.proc/100;
        }
      }

      if KorrSumm.vidopl = 102//Молоко
      {
        KorrSumm.summa := KorrSumm.koldn * 0.5 * doMilkPrice;
      }

      KorrSumm.summa := round(KorrSumm.summa,2);
      update current KorrSumm;
    }
  }

  if ConditionActiveinLeave(tcConls,tntlschet)=True
    PopConditionForLeave(tcConls,tntlschet);

!ExcelPath1:='\\dep968-terminal\User_disk\Galaktika\WorkFolder\ERPDB\Nikolai.Plinda\';
!	puttabletodbf(#KorrSumm,ExcelPath1+'KorrSumm2.xls',ptfFullTable);
  ReReadRecord(#KorrSumm);
}

CmValue2:
{
  if GetMarkerCount(lsMarker)=0
	{
    Message('Ничего не выбрано',error);
    stop; abort; exit;
	}

  PushConditionForLeave(tcConls,tntlschet);

//Проверим, что по имеющимся данным не сформирована другая ведомость
  MtClear(#tErr_Sys_mbf,mfNormal);
  MtClear(#tErr_prvidopl,mfNormal);
  var mrLSchet : longint = InitMarker('', 8, 100, 10, FALSE);
  //Сгруппируем все записи
  _loop KorrSumm1 where (KorrSumm1.prizn < 2 and KorrSumm1.summa<>0)
  {
    var dDate1 : date = date(1, Month(KorrSumm1.datan), Year(KorrSumm1.datan));
    if getfirst KorrSumm2 where ((KorrSumm1.clsch  == KorrSumm2.clsch
                              and KorrSumm1.vidopl == KorrSumm2.vidopl
                              and dDate1           == KorrSumm2.datan
                              and 2                == KorrSumm2.prizn))!=tsOK
    {
      ClearBuffer(#KorrSumm2);
      KorrSumm2.Buffer  := KorrSumm1.Buffer;

      KorrSumm2.prizn   := 2;
      KorrSumm2.datan   := dDate1;
      KorrSumm2.datok   := Date(Last_Day(KorrSumm1.datan), Month(KorrSumm1.datan), Year(KorrSumm1.datan));

      insert current KorrSumm2;
    }
    else
    {
      KorrSumm2.CHASF   += KorrSumm1.chasf;
      KorrSumm2.koldn   += KorrSumm1.koldn;
      KorrSumm2.summa   += KorrSumm1.summa;

      update current KorrSumm2;
    }


  }

  _loop tlschet
  {
    _loop KorrSumm where (KorrSumm.prizn = 2 and KorrSumm.summa<>0)
    {
      _loop prvidopl where  ((KorrSumm.clsch  == prvidopl.clsch
                          and               0 == prvidopl.choice
                          and (prvidopl.DATAN >= KorrSumm.datan
                           and prvidopl.datok <= KorrSumm.datok
                           and prvidopl.vidopl = KorrSumm.vidopl)
                          and PrVidOpl.MNREC  == sys_mbf.nrec))
      {
        if getfirst tErr_Sys_mbf where ((sys_mbf.nrec == tErr_Sys_mbf.nRec)) != tsOK
        {
          ClearBuffer(#tErr_Sys_mbf);
          tErr_Sys_mbf.nRec := sys_mbf.nrec;
          tErr_sys_mbf.sName := SYS_MBF.NMNEM;
          insert current tErr_sys_mbf;
        }

        if getfirst tErr_prvidopl where ((prvidopl.nRec == tErr_prvidopl.nRec)) != tsOK
        {
          ClearBuffer(#tErr_prvidopl);
          tErr_prvidopl.nRec    := prvidopl.nRec;
          tErr_prvidopl.sFIO    := Persons.Fio;
          tErr_prvidopl.cLschet := KorrSumm.clsch;
          tErr_prvidopl.mNrec   := sys_mbf.nrec;
          tErr_prvidopl.doSumm  := prvidopl.summa;
          tErr_prvidopl.dDateB  := KorrSumm.datan;
          tErr_prvidopl.dDateE  := KorrSumm.datok;
          insert current tErr_prvidopl;
        }

        InsertMarker(mrLSchet, KorrSumm.clsch);
      }
    }
  }

  var iii : longint = 0;
  _loop tlschet
  {
    if FoundMarker(mrLSchet, tlschet.nrec)
      continue;

    _loop KorrSumm1 where ((tlschet.nrec == KorrSumm1.clsch and 2 == KorrSumm1.prizn)) ordered by KorrSumm1.vidoplp
    {
      if (KorrSumm1.summa = 0)
        continue;

      if getfirst prvidopl where ((KorrSumm1.cprvidopl==prvidopl.nrec))=tsok
        break;

      iii++;
      if (iii = 1)
      {
        clearbuffer(#SYS_MBF);
        SYS_MBF.NMNEM  := 'Корректировка за '+cur_date;
        SYS_MBF.NMPODR := 'все подразделения';
        SYS_MBF.CEX    := 0;
        SYS_MBF.DATAN  := to_date(1,pmes,pYearn);
        SYS_MBF.DATOK  := to_date(28,pmes,pYearn);
        SYS_MBF.KASSIR := 65535;
        SYS_MBF.mnrec  := 1001;
        insert current SYS_MBF;
      }

      if getfirst prvidopl where ((KorrSumm1.datan  == prvidopl.datan(noindex)
                               and KorrSumm1.vidopl == prvidopl.vidopl(noindex)
                               and KorrSumm1.clsch  == prvidopl.clsch
                               and                0 == prvidopl.choice))<>tsok
      {
        clearbuffer(#prvidopl);
        prvidopl.CEX      := KorrSumm1.cex;
        prvidopl.cexoz    := KorrSumm1.cex;
        prvidopl.MNREC    := sys_mbf.nrec;
        prvidopl.POMETKA  := '+';
        prvidopl.VIDOPL   := korrSumm1.vidopl;
        prvidopl.MES      := month(KorrSumm1.datan);
        prvidopl.DATAN    := KorrSumm1.datan;
        prvidopl.DATok    := KorrSumm1.datok;
        prvidopl.CLSCH    := KorrSumm1.clsch;
        prvidopl.Tperson  := KorrSumm1.tperson;
        prvidopl.CHASF    := KorrSumm1.chasf;
        prvidopl.koldn    := KorrSumm1.koldn;
        prvidopl.summa    := KorrSumm1.summa;
        prvidopl.summaR   := KorrSumm1.summa;
        prvidopl.proc     := KorrSumm1.proc;
        prvidopl.STRTABN  := korrSumm1.strtabn;
        prvidopl.KATEG    := KorrSumm1.Kateg;
        prvidopl.CAPPOINT := KorrSumm1.Cappoint;
        insert current prvidopl;

        KorrSumm1.cprvidopl := prvidopl.nrec;
        update current KorrSumm1;
      }
      else
      {
        prvidopl.CHASF   += KorrSumm1.chasf;
        prvidopl.koldn   += KorrSumm1.koldn;
        prvidopl.summa   += KorrSumm1.summa;
        prvidopl.summaR  += KorrSumm1.summa;

        KorrSumm1.cprvidopl :=prvidopl.nrec;
        update current KorrSumm1;


        if prvidopl.summa=0
          delete current prvidopl;
        else
          update current prvidopl;
      }
    }
  }

  donemarker(mrLSchet, '');

  if ConditionActiveinLeave(tcConls,tntlschet)=True
    PopConditionForLeave(tcConls,tntlschet);


  if getfirst tErr_Sys_mbf = tsOK
  {
    //Есть дубли, создадим протокол
    var sFileName : string = CreateTmpFileName;
    if ExistFile(sFileName)
      DeleteFile(sFileName);

    LogStrToFile(sFileName, '**********По некоторым сотрудникам формирование ведомости невозможно!********');
    LogStrToFile(sFileName, '-----------------------------------------------------------------------------');
    LogStrToFile(sFileName, 'Найдены следующие, ранее созданные документы:');
    _loop tErr_Sys_mbf ordered by index i2
    {
      LogStrToFile(sFileName, '   ' + tErr_Sys_mbf.sName);

      _loop tErr_prvidopl where ((tErr_Sys_mbf.nRec == tErr_prvidopl.mNrec)) ordered by index i3
        LogStrToFile(sFileName, '      ' + tErr_prvidopl.sFIO + ', ' + DateToStr(tErr_prvidopl.dDateB, 'DD.MM.YYYY') + '-' + DateToStr(tErr_prvidopl.dDateE, 'DD.MM.YYYY')+', ' + DoubleToStr(tErr_prvidopl.doSumm, '\2p[|-]36`666`666`666`666`667.88'));
    }

    ProcessText(sFileName, vfNewTitle Or vfMacroSize,  'Протокол проверки');
  }

  message('Ведомость '+if(iii = 0, 'не', '')+' создана');
}
end;
end.




#include UserReport.vih

VipInterface UserReport_gp_recalc_korr_tabel Implements IUserReport;
Interface UserReport_gp_recalc_korr_tabel;

Procedure Run;
Begin
  runinterface(GP_recalc_korr_tabel);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Обработка корректировочных табелей';
End;


Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Обработка корректировочных табелей';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
