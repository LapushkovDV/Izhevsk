//*****************************************************************************
create view
var
  FiltrPodr : string  ;
   stmt
 , stmt_str
 , curcount
 , cntmrk
 , i
 , lsMarker : longint;
   nrecn    : comp;

 from
  tlschet(in4)
, persons
, katpodr
, mSumvidop
, mSumvidop_gr
, KorrSumm, KorrSumm KorrSumm1, KorrSumm KorrSumm2
, klvidopl, klvidopl klvidopl2
, sys_mbf
, prvidopl
, prvidopl prvidopl1
, prvidopl prvidopl2
, tmpProc
, lstab
, Gp_Timetable
, Klrejim
, Gp_TimeNorms
, Gp_klrejim
, tErr_Sys_mbf
, tErr_prvidopl
, ValZar
where
((
    tlschet.tperson  == persons.nrec
AND tlschet.cex      == katpodr.nrec

AND tlschet.nrec     == mSumvidop.clsch
AND tlschet.nrec     == mSumvidop_gr.clsch
AND tlschet.nrec     == KorrSumm.clsch
AND mSumvidop.vidopl == klvidopl.vidopl
AND tlschet.nrec     == prvidopl2.CLSCH
AND      0           == prvidopl2.CHOICE

AND string(mSumvidop.vidopl) == tmpProc.Code
AND tlschet.nrec     == tmpProc.cLSChet
and KorrSumm.cprvidopl == prvidopl1.nrec
//AND tlschet.cex      == tmpProc.cPodr
))

 Condition Conls  = FoundMarker(lsMarker,tlschet.nrec)=true
;

create view vFix
var
  _cLSch : comp;
  _dBeg  : date;
as select
  mSumvidop.Nrec
from mSumvidop
   , mSumvidop mNextSumvidop
where ((
  vFix._cLSch == mSumVidOp.cLSch  and
  pyearn      == mSumVidOp.YearN  and
  pmes        == mSumVidOp.MesN   and
  7           == mSumVidOp.VidOpl and
  (vFix.mSumVidOp.DataN >= vFix._dBeg) and

  vFix._cLSch == mNextSumvidop.cLSch  and
  pyearn      == mNextSumvidop.YearN  and
  pmes        == mNextSumvidop.MesN   and
  7           == mNextSumvidop.VidOpl and
  (vFix.mNextSumvidop.DataN >= vFix.mSumVidOp.DatOk)
))
order by mSumVidOp.DataN, mNextSumvidop.DataN
;
//Выстраивает даты начала и окончания начислений по окладу в неразрывные интервалы с начала до конца месяца
//Пример: есть начисления оклад1 с 03.04 по 10.04, оклад2 с 15.04 по 20.04
//        результат: оклад1 с 01.04 по 14.04, оклад2 с 15.04 по 30.04
procedure FixSalaryDates(__cLSch: comp);
{
  vFix._cLSch := __cLSch;
  vFix._dBeg  := Date(1, pmes, pyearn);
  var dEndMonth : date = Date(Last_Day(vFix._dBeg), pmes, pyearn);
  while vFix.getfirst mSumVidOp = tsOk
  {
    var isDirty : boolean = false;

    if vFix.mSumVidOp.DataN > vFix._dBeg
    {
      vFix.mSumVidOp.DataN := vFix._dBeg;
      isDirty := true;
    }

    if vFix.getfirst mNextSumVidOp = tsOk
    {
      if vFix.mNextSumVidOp.DataN > Add_Day(vFix.mSumVidOp.DatOk, 1)
      {
        vFix.mSumVidOp.DatOk := Sub_Day(vFix.mNextSumVidOp.DataN, 1);
        isDirty := true;
      }
    }
    else if vFix.mSumVidOp.DatOk < dEndMonth
    {
      vFix.mSumVidOp.DatOk := dEndMonth;
      isDirty := true;
    }

    if isDirty
      vFix.update current mSumVidOp;

    vFix._dBeg := Add_Day(vFix.mSumVidOp.DatOk, 1);
  }
}

