//*****************************************************************************
  SQL QUERY SqltmpProc =
    SELECT 
        SP.cLschet  as cLSChet,
        D.cKatPodr  as cPodr,
        R.Code      as Code, 
        CASE F.Npp
             WHEN 01 THEN CASE WHEN SP.FARRVALUE[01] = '' THEN '0.00' ELSE SP.FARRVALUE[01] END
             WHEN 02 THEN CASE WHEN SP.FARRVALUE[02] = '' THEN '0.00' ELSE SP.FARRVALUE[02] END
             WHEN 03 THEN CASE WHEN SP.FARRVALUE[03] = '' THEN '0.00' ELSE SP.FARRVALUE[03] END
             WHEN 04 THEN CASE WHEN SP.FARRVALUE[04] = '' THEN '0.00' ELSE SP.FARRVALUE[04] END
             WHEN 05 THEN CASE WHEN SP.FARRVALUE[05] = '' THEN '0.00' ELSE SP.FARRVALUE[05] END
             WHEN 06 THEN CASE WHEN SP.FARRVALUE[06] = '' THEN '0.00' ELSE SP.FARRVALUE[06] END
             WHEN 07 THEN CASE WHEN SP.FARRVALUE[07] = '' THEN '0.00' ELSE SP.FARRVALUE[07] END
             WHEN 08 THEN CASE WHEN SP.FARRVALUE[08] = '' THEN '0.00' ELSE SP.FARRVALUE[08] END
             WHEN 09 THEN CASE WHEN SP.FARRVALUE[09] = '' THEN '0.00' ELSE SP.FARRVALUE[09] END
             WHEN 10 THEN CASE WHEN SP.FARRVALUE[10] = '' THEN '0.00' ELSE SP.FARRVALUE[10] END
             WHEN 11 THEN CASE WHEN SP.FARRVALUE[11] = '' THEN '0.00' ELSE SP.FARRVALUE[11] END
             WHEN 12 THEN CASE WHEN SP.FARRVALUE[12] = '' THEN '0.00' ELSE SP.FARRVALUE[12] END
             WHEN 13 THEN CASE WHEN SP.FARRVALUE[13] = '' THEN '0.00' ELSE SP.FARRVALUE[13] END
             WHEN 14 THEN CASE WHEN SP.FARRVALUE[14] = '' THEN '0.00' ELSE SP.FARRVALUE[14] END
             WHEN 15 THEN CASE WHEN SP.FARRVALUE[15] = '' THEN '0.00' ELSE SP.FARRVALUE[15] END
             WHEN 16 THEN CASE WHEN SP.FARRVALUE[16] = '' THEN '0.00' ELSE SP.FARRVALUE[16] END
             WHEN 17 THEN CASE WHEN SP.FARRVALUE[17] = '' THEN '0.00' ELSE SP.FARRVALUE[17] END
             WHEN 18 THEN CASE WHEN SP.FARRVALUE[18] = '' THEN '0.00' ELSE SP.FARRVALUE[18] END
             WHEN 19 THEN CASE WHEN SP.FARRVALUE[19] = '' THEN '0.00' ELSE SP.FARRVALUE[19] END
             WHEN 20 THEN CASE WHEN SP.FARRVALUE[20] = '' THEN '0.00' ELSE SP.FARRVALUE[20] END
        END as dSum
    FROM
        GP_KPI_ALG ALG
      , GP_KPI_Raise R
      , GP_KPI_FIELDS F  
      , GP_KPI_DOC_SP SP
      , GP_KPI_DOC D
    WHERE (    case when r.code='22' then 'Нормативный процент для расчета премии' 
                    when r.code='38' then 'Общий процент с 01/03/2019'
		    else 'Фактический процент' end           =  ALG.Name
      AND  ALG.NRec         =  F.cGP_KPI_ALG
      AND  R.NRec           =  F.cDoc
      AND  R.NRec           =  SP.cGP_KPI_Raise 
      //AND  :pLSChet         =  SP.cLschet 
      AND  SP.cGP_KPI_DOC   =  D.NRec    
      AND  :pYear           =  D.wYear   
      AND  :pMonth          =  D.wMonth  
    //  AND  :pPodr           =  D.cKatPodr 
          )  
    ;

//*****************************************************************************
Procedure ClearQuery(Var liHandle: Longint);
{
  if (liHandle != 0)
  {
    sqlFreeStr(liHandle);
    liHandle := 0;
  }
}
//*****************************************************************************
procedure InitKorrTabel;
{
	_loop tLschet
	{
	  if getfirst lstab where ((tLschet.nrec==lstab.clschet and pyearn==lstab.yearn and pMes==lstab.mesn))=tsok
	  {

		  _loop gp_TimeTable where ((tLschet.nrec == GP_TIMETABLE.clschet
                                   and pyearn == GP_TIMETABLE.yearn
                                   and   pMes == GP_TIMETABLE.monthn))
		  {
				i := Day(gp_TimeTable.DBeg);
				do
				{

					if (lstab.DAYCHF[i]>100)
            ChasfDay:=0;
          else
            ChasfDay:=lstab.daychf[i];

					if (ChasfDay<>gp_timeTable.DHOURS[i])  or
             (LoCase(trim(lstab.DAYS[i])) <> LoCase(trim(gp_timeTable.dMark[i])) and
             (LoCase(trim(gp_timeTable.dMark[i])) = 'нн' or LoCase(trim(lstab.DAYS[i])) = 'б'))
			    {
			      tlschet.prizn := 'Корр';
            tlschet.DCrCorr := gp_timeTable.DFORM;
					  update current tLschet;
					  i := 35;
					}
				  i++;
				}
				while (i<day(gp_TimeTable.DEnd)+1)

        if (tlschet.prizn = 'Корр')
          break;
			}
		}

	}
}

procedure FullTable;
{ 
  var stmt             : Longint;
  var ExecuteErrorCode : longint;
  _try
    {
      delete all tmpProc;
      ClearQuery(stmt);
      stmt             := sqlAllocStmt;
      ExecuteErrorCode := sqlPrepare(stmt, SqltmpProc);

      if (ExecuteErrorCode = 0)
        {
          sqlBindParamByName(stmt,'pName'     , 'Фактический процент');
          sqlBindParamByName(stmt,'pYear'     , pyearn);
          sqlBindParamByName(stmt,'pMonth'    , pmes);

          ExecuteErrorCode := SqlExecute(stmt);

          if (ExecuteErrorCode = 0)
            { 
              ExecuteErrorCode := SqlFetchIntoByName(stmt, #tmpProc);
              ReReadRecord(#tmpProc);
              if (ExecuteErrorCode <> 0)
                Message('Ошибка : ' + string(ExecuteErrorCode)); 
            }
          else 
            Message('Ошибка : ' + string(ExecuteErrorCode)); 
        }
      else
        Message('Ошибка : ' + string(ExecuteErrorCode));
    }
  _finally
    {
    }
}
//*****************************************************************************
Procedure ReloadLs;
{
  if filtrPodr<>'По всем'                       	
   {
     sqlDropTmpTable('selpodr');
     sqlAddStr(stmt_str, 'TABLE selpodr ( nrecpodr   : Comp ) WITH INDEX (selpodr1 = nrecpodr);');
     sqlCreateTmpTable(stmt_str,ctmDynamicIndex);
     sqlFreeStr(stmt_str);
     stmt_str:=0;
  
     for(
         i:=0;
         i<GetMarkerCount(DepMarker);
         inc(i)
        )
       {
         GetMarker(DepMarker,i,nrecn);
         ClearQuery(stmt);
         sqlAddStr(stmt, 'INSERT INTO selpodr');
         sqlAddStr(stmt, '(');
         sqlAddStr(stmt, '  nrecpodr');
         sqlAddStr(stmt, ')');
         sqlAddStr(stmt, 'VALUES');
         sqlAddStr(stmt, '(');
         sqlAddStr(stmt, '  #comp(' + nrecn + ')');
         sqlAddStr(stmt, ')');
         sqlExecDirect(stmt);
       }  
   }

   MtClear(#tlschet,mfNormal);

   stmt := sqlAllocStmt;

   sqlAddStr(stmt_str,'select ');
   sqlAddStr(stmt_str,'      l.nrec  ');
   sqlAddStr(stmt_str,'     ,l.tabn  ');
   sqlAddStr(stmt_str,'     ,l.strtabn  ');
   sqlAddStr(stmt_str,'     ,l.tperson  ');
   sqlAddStr(stmt_str,'     ,l.cex  ');
   sqlAddStr(stmt_str,'     ,l.cpodr  ');
   sqlAddStr(stmt_str,'     ,p.fio  ');
   sqlAddStr(stmt_str,'     ,l.sisopl  ');
   sqlAddStr(stmt_str,'  from     ');
   sqlAddStr(stmt_str,'    (   ');
   sqlAddStr(stmt_str,'      select ');
   sqlAddStr(stmt_str,'        distinct ');
   sqlAddStr(stmt_str,'         clsch');
   sqlAddStr(stmt_str,'       from sumvidop s');
   sqlAddStr(stmt_str, '               inner join katpodr podr on s.cex=podr.nrec');

   if filtrpodr<>'По всем'
     sqlAddStr(stmt_str, '             inner join selpodr on s.cex=selpodr.nrecpodr');
   sqlAddStr(stmt_str,'                inner join gp_timetable on s.clsch=gp_timetable.clschet and gp_timetable.yearn=? and gp_timetable.monthn=?');

   sqlAddStr(stmt_str,'         where s.mesn=? and s.yearn=?');

   sqlAddStr(stmt_str,'     )t1 inner join lschet l on t1.clsch=l.nrec');
   sqlAddStr(stmt_str,'         inner join persons p on l.tperson=p.nrec');

   sqlbindparam(stmt,1,pyearn);
   sqlbindparam(stmt,2,pmes);
   sqlbindparam(stmt,3,pmes);
   sqlbindparam(stmt,4,pyearn);
   sqlPrepare(stmt,stmt_str);

   sqlExecute(stmt);

   if (sqlFetchInto(stmt,#tlschet) != tsOk)
     Message('not tsOk select (');

   sqlFreeStmt(stmt);
   sqlFreeStr(stmt);

}
//*****************************************************************************
Procedure ReloadAllNach;
{
  StartNewVisual(vtRotateVisual, vfTimer+vfBreak,''#3'Загружаю данные...'#13#3,1);

   mtclear(#mSumvidop,fmNormal);
   mtclear(#mSumvidop_gr,fmNormal);
   mtclear(#KorrSumm,fmNormal);

   sql
    select *
     from sumvidop n
    where n.yearn=:(pyearn) and n.mesn=:(pmes) 
    into mSumvidop byName;

   sql
    select n.clsch,n.vidoplp,sum(n.summa) as summa,sum(n.chasf) as chasf,sum(n.koldn) as koldn
     from sumvidop n
    where n.yearn=:(pyearn) and n.mesn=:(pmes) 
    group by n.vidoplp, n.clsch
    into mSumvidop_gr byName;



  StopVisual('',0);
}
