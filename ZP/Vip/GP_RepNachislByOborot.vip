#include UserReport.vih

VipInterface UserReport_GP_RepNachislByOborot implements IUserReport;
interface UserReport_GP_RepNachislByOborot 'Выплаты по Банкам по платежам';
show (,,55,5);

table struct tRep (datVip: date, datOb: date, nodok: string, cBank: comp, sBank: string, sumPlat: double) (i1 = datVip);
table struct tGrp (dt: date, sum1: double, sum2: double) (i1 = dt);

create view
var dBeg, dEnd: date;
    wVidRep: word;
as select * from tGrp, tRep;

screen sc1 (,,sci1EnEsc);
notablenavigation;
fields
  dBeg: noProtect;
  dEnd: noProtect;
  wVidRep: [list 'Страховый взносы', 'НДФЛ', 'Заработная плата'], noProtect;
buttons
  cmOK;
  cmCancel;
<<

`Период формирования с` .@@@@@@@@@@@ `по` .@@@@@@@@@@@
`Вид отчета` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. Сформировать .>                <.    Отмена    .>
>>
end;

function GetDataStrah: boolean;
{
  Result := false;
  mtClear(tntRep, mfNormal);
  sql
  select
    PlPor.DatVip
  , PlPor.DatOb
  , PlPor.NoDok
  , coalesce(KatBank.NRec, #comp(0)) cBank: comp
  , coalesce(KatBank.Name,'') || ',' || coalesce(KatBank.Schet1, '') sBank: string
  , PlPor.SumPlat
  from
  (
    select distinct Soprhoz.cSoprDoc
    from Oborot
    inner join SoprHoz on Oborot.cSoprHoz = SoprHoz.NRec and 1 = SoprHoz.TiDkGal
    where Oborot.SchetO = '069'
      and Oborot.SchetK = '051'
      and Oborot.KauOs[1] = #comp(4611812628326827933)
      and Oborot.DesGr = '01'
      and Oborot.DatOb between :(dBeg) and :(dEnd)
  ) tDocs
  inner join PlPor on tDocs.cSoprDoc = PlPor.NRec
  left join KatBank on PlPor.cBankPlat = KatBank.NRec
  into tRep ByName;

  Result := getfirst tRep = tsOK;
  if not Result
    message('Нет данных для формирования отчета!', Warning);
}

function GetDataNdfl: boolean;
{
  Result := false;
  mtClear(tntRep, mfNormal);
  sql
  select
    PlPor.DatVip
  , PlPor.DatOb
  , PlPor.NoDok
  , coalesce(KatBank.NRec, #comp(0)) cBank: comp
  , coalesce(KatBank.Name,'') || ',' || coalesce(KatBank.Schet1, '') sBank: string
  , PlPor.SumPlat
  from
  (
    select distinct Soprhoz.cSoprDoc
    from Oborot
    inner join SoprHoz on Oborot.cSoprHoz = SoprHoz.NRec and 1 = SoprHoz.TiDkGal
    where Oborot.SchetO = '068'
      and Oborot.SubOsSch = '01'
      and Oborot.SchetK = '051'
      and Oborot.KauOs[1] = #comp(4611812628326827933)
      and Oborot.DesGr = '01'
      and Oborot.DatOb between :(dBeg) and :(dEnd)
  ) tDocs
  inner join PlPor on tDocs.cSoprDoc = PlPor.NRec
  left join KatBank on PlPor.cBankPlat = KatBank.NRec
  into tRep ByName;

  Result := getfirst tRep = tsOK;
  if not Result
    message('Нет данных для формирования отчета!', Warning);
}

function GetDataZp: boolean;
{
  Result := false;
  mtClear(tntRep, mfNormal);
  sql
  select
    PlPor.DatVip
  , PlPor.DatOb
  , PlPor.NoDok
  , coalesce(KatBank.NRec, #comp(0)) cBank: comp
  , coalesce(KatBank.Name,'') || ',' || coalesce(KatBank.Schet1, '') sBank: string
  , PlPor.SumPlat
  from
  (
    select distinct Soprhoz.cSoprDoc
    from Oborot
    inner join SoprHoz on Oborot.cSoprHoz = SoprHoz.NRec and 1 = SoprHoz.TiDkGal
    where Oborot.SchetO = '070'
      and Oborot.SchetK = '051'
      and Oborot.DesGr = '01'
      and Oborot.DatOb between :(dBeg) and :(dEnd)
  ) tDocs
  inner join PlPor on tDocs.cSoprDoc = PlPor.NRec
  left join KatBank on PlPor.cBankPlat = KatBank.NRec
  into tRep ByName;

  Result := getfirst tRep = tsOK;
  if not Result
    message('Нет данных для формирования отчета!', Warning);
}

function GroupData: boolean;
var dt: date;
{
  Result := false;
  mtClear(tntGrp, mfNormal);
  _loop tRep
  {
    dt := date(1, month(tRep.datOb), year(tRep.datOb));
    if getfirst tGrp where ((dt == tGrp.dt)) <> tsOk
    {
      ClearBuffer(tntGrp);
      tGrp.dt := dt;
      insert current tGrp;
    }
    if tRep.cBank = 000A0000000001DEh or tRep.cBank = 000A0000000001DFh or tRep.cBank = 000A000000003C11h
      tGrp.sum1 += tRep.SumPlat;
    else
      tGrp.sum2 += tRep.SumPlat;
    update current tGrp;
  }
  Result := true;
}

function PrintRepGrp: boolean;
var r1, kolR, kolC, i, j: longint;
{
  Result := false;
  if not xlCreateExcel('', true)
  {
    message('Ошибка запуска Excel', error);
    exit;
  }

  r1 := 2;
  kolC := 4;
  kolR := RecordsInTable(tntGrp) + 1;
  xlCreateMatrix(kolR, kolC);

  xlSetCellStringValue(iCase(wVidRep; 'Страховый взносы', 'НДФЛ', 'Заработная плата';''), 1, 1, 1, 1);
  xlSetFontStyle(xlBold, 1, 1, 2, kolC);
  xlMergeCells(1, 1, 1, kolC);
  xlAlignCellsEx(xlCenter, xlCenter, 1, 1, 2, kolC);
  xlSetNumberFormat('@', r1, 1, r1 + kolR - 1, kolC);
  xlSetNumberFormat('### ### ### ##0'+xlGetDecimalSeparator+'00;-### ### ### ##0'+xlGetDecimalSeparator+'00;', r1 + 1, 2, r1 + kolR - 1, 4);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, r1, 1, r1 + kolR - 1, kolC);
  xlAutoFit(r1, 1, r1 + kolR - 1, kolC);
  xlSetColumnWidth(20, 1, 1, 1, kolC);

  i := 0;
  j := 0;
  xlStWriteToMatrix(++i, ++j, 'Месяц');
  xlStWriteToMatrix(  i, ++j, 'ГПБ, СБ');
  xlStWriteToMatrix(  i, ++j, 'Остальные');
  xlStWriteToMatrix(  i, ++j, 'Итого');
  _loop tGrp ordered by index i1
  {
    j := 0;
    xlStWriteToMatrix(++i, ++j, DateToStr(tGrp.dt, 'Month YYYY'));
    xlDoWriteToMatrix(  i, ++j, tGrp.sum1);
    xlDoWriteToMatrix(  i, ++j, tGrp.sum2);
    xlDoWriteToMatrix(  i, ++j, tGrp.sum1 + tGrp.sum2);
  }

  xlWriteMatrixToExcel(r1, 1);
  xlKillExcel;
  Result := true;
}

function PrintReport: boolean;
var r1, kolR, kolC, i, j: longint;
{
  Result := false;
  if not xlCreateExcel('', true)
  {
    message('Ошибка запуска Excel', error);
    exit;
  }

  r1 := 2;
  kolC := 5;
  kolR := RecordsInTable(tntRep) + 1;
  xlCreateMatrix(kolR, kolC);

  xlSetCellStringValue(iCase(wVidRep; 'Страховый взносы', 'НДФЛ', 'Заработная плата';''), 1, 1, 1, 1);
  xlSetFontStyle(xlBold, 1, 1, 2, kolC);
  xlMergeCells(1, 1, 1, kolC);
  xlAlignCellsEx(xlCenter, xlCenter, 1, 1, 2, kolC);
  xlSetNumberFormat('@', r1, 1, r1 + kolR - 1, kolC);
  xlSetNumberFormat('### ### ### ##0'+xlGetDecimalSeparator+'00;-### ### ### ##0'+xlGetDecimalSeparator+'00;', r1 + 1, 5, r1 + kolR - 1, 5);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, r1, 1, r1 + kolR - 1, kolC);
  xlAutoFit(r1, 1, r1 + kolR - 1, kolC);
  xlSetColumnWidth(20, 1, 1, 1, kolC);

  i := 0;
  j := 0;
  xlStWriteToMatrix(++i, ++j, 'Дата платежа');
  xlStWriteToMatrix(  i, ++j, 'Дата выписки');
  xlStWriteToMatrix(  i, ++j, 'Номер ПП');
  xlStWriteToMatrix(  i, ++j, 'Банк, откуда');
  xlStWriteToMatrix(  i, ++j, 'Сумма ПП');
  _loop tRep ordered by index i1
  {
    j := 0;
    xlStWriteToMatrix(++i, ++j, DateToStr(tRep.datOb, 'DD.MM.YYYY'));
    xlStWriteToMatrix(  i, ++j, DateToStr(tRep.datVip, 'DD.MM.YYYY'));
    xlStWriteToMatrix(  i, ++j, tRep.nodok);
    xlStWriteToMatrix(  i, ++j, tRep.sBank);
    xlDoWriteToMatrix(  i, ++j, tRep.SumPlat);
  }

  xlWriteMatrixToExcel(r1, 1);
  xlKillExcel;
  Result := true;
}

handleEvent
  cmOK:
  {
    StartNewVisual(vtRotateVisual, vfTimer, 'Формирование отчета', 0);
    var f: boolean = icase(wVidRep; GetDataStrah, GetDataNdfl, GetDataZp; false);
    if f
    {
      PrintReport;
      if GroupData
        PrintRepGrp;
    }
    StopVisual;
  }
end;
!-------------------------------------------------------------------------------
procedure Run;
{
  RunWindowModal(wnMainWindow);
}
function GetReportName: String;
{
  Result := 'Выплаты по Банкам по платежам';
}
function GetGroupName (Level : Word) : String;
{
  #__UNUSED__(Level)
  Result := '';
}
function GetPriority : Integer;
{
  Result := 0;
}
function VisibleInModule(Ind : Byte) : String;
{
  Result := '';
  case Ind of
    1 : Result := 'MENUZARP';
  end;
}
!-------------------------------------------------------------------------------
end.
