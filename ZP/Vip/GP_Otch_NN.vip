/*************************************************************************************************\
* Наименование: Отчет по неявкам по невыясненным обстоятельствам                                  *
* Контур/Модуль: ЗП                                                                               *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3252         |14/08/18|Кучин Д.Л.             |НПО Энергомаш                      *
\*************************************************************************************************/


Interface Gp_otch_nn doaccept, escclose;

create view 
var
Counter:longint;
k,i:integer;
DatNach,DatOkon:date;
God,MesEnd,MesBeg:longint;
excelPath:string;

as select *
from
lschet, lstab, katpodr

where ((    lschet.cex  == katpodr.nrec
        and lschet.nrec == lstab.clschet 
        and god         == lstab.yearn 
        and i           == lstab.mesn
        and lschet.tperson  == persons.nrec
));


Screen scrParams (,,sci1EnEsc);
!  Show At (,,,5);
Fields
DatNach:noprotect;
DatOkon:noprotect;
Buttons
  cmOk       ,,,'Начать' ,,sci1Esc;
  cmCancel   ,,,'Выйти    ' ,,sci1Esc;
<<


Дата начала расчета       .@@@@@@@@@@
Дата окончания расчета    .@@@@@@@@@@




   <.  Сформировать   .>     <.  Отмена  .>
>>
end;


HandleEvent
CmInit:
{
}


cmOk:
{

    ExcelPath:=StartPathName+'\xls_ЭМ\staff\';

    xlCreateExcelWithTemplate(ExcelPath+'gP_Otch_NN.xlsx',true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');
    Counter:=7;

    StartNewVisual(vtNumericVisual,vfTimer+vfBreak,'Обработка табелей',1);


    God:=year(DatNach);
    MesBeg:=month(DatNach);
    MesEnd:=month(DatOkon);

    xlSetCellStringValue(DatNach+'-'+DatOkon, 4, 2, 4, 2);

    i:=MesBeg;


	do
	{
		_loop lschet
		{
		nextvisual;
			if lschet.datuv>date(0,0,0) and lschet.datuv<DatNach continue;

			k:=1;
	
			do
			{
				if lstab.days[k]='НН'
				{
			       xlSetCellStringValue(lstab.strtabn, Counter, 1, Counter, 1);
			       xlSetCellStringValue(persons.fio, Counter, 2, Counter, 2);
			       xlSetCellStringValue(substr(katpodr.kod,1,3), Counter, 3, Counter, 3);
			       xlSetCellDateValue(date(k,i,god), Counter, 4, Counter, 4);
				counter++;

				}

			k++;
			}
			while k<31

		}
		

	i++;
	}
	while i<MesEnd


xlkillExcel;

StopVisual('',0);

closeinterface(-1);

}



end;
end.


#include UserReport.vih

VipInterface UserReport_gp_otch_nn Implements IUserReport;

Interface UserReport_gp_otch_nn;

create view;

!-------------------------------------------------------------------------------
// Запуск отчета на выполнение при выборе его из списка отчетов
procedure Run;
begin
  RunInterfaceNoModal('gp_otch_nn');
end;
!-------------------------------------------------------------------------------
// Наименование отчета в списке
function GetReportName: String;
begin
  GetReportName := 'Информация по НН';
end;
!-------------------------------------------------------------------------------
// Наименования групп, в которые входит отчет
// Группа n+1 делается подчиненной группе n
// В данном случае будет иерархия:
// [+] Группа 1
//     [+] Группа 2
//         Отчет 1
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := '';
  case Level of
    1 : GetGroupName := 'Отчеты по табелям';
  end;
end;
!-------------------------------------------------------------------------------
// Приоритет отчета - сортировка внутри группы выполняется сначала
// по приоритету, а затем по наименованию
function GetPriority : Integer;
begin
  GetPriority := 0;
end;
!-------------------------------------------------------------------------------
// ModuleID модулей, в которых будет виден отчет
// '*' - отчет будет виден в любом модуле
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;
!-------------------------------------------------------------------------------
end.


