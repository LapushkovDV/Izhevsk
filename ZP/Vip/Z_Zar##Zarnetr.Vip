#component "z_zar"
#doc
Расчет зарплаты
#798 - не используется
#2067 - блокируем распределение затрат
#end
alter interface ZARNETR
  ( '')
;
  overload
  end;
Procedure MySetParam ;
{   //#2067 - блокируем распределение затрат
    BitOffW(CALCULATIONOPTIONS,2);
    rescanpanel(#ZAR_USER) ;
} //Procedure MySetParam ;

//-----------------------------------------
// из cmInit стандартного интерфейса
//-----------------------------------------
Function Get_Param_mask:word;
{
  var Param_mask: word = 0; // маска для параметров расчета
  if (coGetTune('UP.TekBud') = 1) // расчетный период - будущий
  {
    if (MySetDefParam = ccBel) or (MySetDefParam = ccRus) // РБ или РФ
    { // закрыть только распределение затрат
      Param_mask := 2;
      //CalculationOptions := CalculationOptions and not 2; // снять галочки со скрываемых пунктов
    }
    else
    { // закрыть и распределение затрат и расчет налогов на ФОТ
      Param_mask := 10;
      //CalculationOptions := CalculationOptions and not 10; // снять галочки со скрываемых пунктов
    }
  } //if (coGetTune('UP.TekBud') = 1) // расчетный период - будущий
  else
  {
    if boGetTune('UP.Zar.No_Rasch_FOT')
    {
      Param_mask := 8;
      //CalculationOptions := CalculationOptions and not 8;
    }
    if boGetTune('UP.Zar.No_Rasch_ZP')
    {
      Param_mask := 7;
      //CalculationOptions := CalculationOptions and not 7;

      if boGetTune('UP.Zar.No_Rasch_FOT')
      {
        Param_mask := 15;
        //CalculationOptions := CalculationOptions and not 15;
      }
    }
  } //else if (coGetTune('UP.TekBud') = 1) // расчетный период - будущий

  Result:=Param_mask;
} //Function Get_Param_mask:word;


//********************************************
// События интерфейса
//********************************************
HandleEvent
cmCheckField :
{ MySetParam ;
  Inherited::HandleEvent(cmCheckField); 
  MySetParam ;
}
cmInit:
{ Inherited::HandleEvent(cmInit);
  //message('CALCULATIONOPTIONS = '+string(CALCULATIONOPTIONS))
  //DIVIDE:=0;
  //PutCommand(cmCheckField)
  MySetParam;

  //message('CALCULATIONOPTIONS = '+string(CALCULATIONOPTIONS))
  //#2067
  var Param_mask: word = 0; // маска для параметров расчета
  Param_mask:=Get_Param_mask or 2;
  ClusterDisabledField(#CALCULATIONOPTIONS, Param_mask);
  cfsSetProp('ci_SALARYACCOUNTINGSCREEN_CALCULATIONOPTIONS_Распределение_затрат',cfpVisible,False);
  cfsSetProp('ci_SALARYACCOUNTINGSCREENDISTR_CALCULATIONOPTIONS_Распределение_затрат',cfpVisible,False);
}
cmOk :
{ /*
  if DIVIDE<>0
  { message('Правильное положение переключателя в предварительной разноске'
     +chr(13)+'"Разбивать" (может "разбивать по  переходам")'
     +chr(13)+'Если уверены нажмите "Да"',YesNo) <>cmYes
    { DIVIDE:=0    
    }
  }//if DIVIDE<>0
  */
  if true 
  { //if (ADDITIONALOPTIONS and 1)>0
    MySetParam ; 
  }
  //Цикл по Formarks
  //пока не будем - возможно корректировка льгот на инвалидов, пособий на детей и так далее
  //RunInterface('GP_ZP_BeforeRAS',1)


  //"Настройки Галактики \ Управление персоналом \ Общие настройки \ Больничные, отпуска, расчеты по среднему \ Формировать справку о среднем заработке при расчете зарплаты"
  //boSetTune('UP.ZAR.ZU.FSORAS',False)
  
  Inherited::HandleEvent(cmOK); 
  //в распределением затрат - sharecost.vip RunInterface('ZAR_AFTERRAS',0) ;
  if (CALCULATIONOPTIONS and 4) >0
  { //RunInterface('GP_ZP_AFTERRAS',2,0,0) ;  // удержания
  }
  if (CALCULATIONOPTIONS and 8) >0
  { //RunInterface('GP_ZP_AFTERRAS',1,0,0) ;  // налоги на фот
  }
}
end;
end.
