/*************************************************************************************************\
* Наименование: Разработать интерфейс ввода нарядов                                               *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:  Перенос сумм аванса с расчета в лицевой счет                                  *
\*************************************************************************************************/
#include Query.vih


interface GP_Avans_SetNaryad 'Установка нарядов к расчету аванса' escclose;
table struct tSetNaryad
(
 Nrec : comp
)
with index
(
 ind0 = nrec
)
;
Create view
var  _log :string;
as
select tSetNaryad.nrec
from
  tSetNaryad
, PrNaryad
;
Procedure MyLog(_str: string);
{
//   If Upcase(UserName) = 'LAPUSHKOV_DV'
//    {
      LogStrToFile(_log,_str);
//    }
}
Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
   sqlAddStr(query_handle, add_query_str);
//   MyLog('sql: ' + add_query_str);
} //Function MysqlAddStr(var query_handle: longInt; add_query_str: string): longInt;

procedure SetNaryadtoAvans;
{
  _log := 'GP_Avans_SetSumToLschet_'+DateToSTr(cur_date,'YYYYMMDD') + '_' +TimeToStr(Cur_Time,'HHMMSS')+'.log';
  StartNewVisual(vtRotateVisual, vfTimer, 'Он сказал поехали и махнул рукой', 0);
  delete all tSetNaryad;
  var _dateOtchPer : date = dgettune('UP.DATOTCH');
 setvisualheader('Запрос SQL');
    var hstr : longint = 0;

MysqlAddStr(hstr, '   select prnaryad.nrec ');
MysqlAddStr(hstr, '    from sys_nar        ');
MysqlAddStr(hstr, '    join prnaryad on prnaryad.mnrec=sys_nar.nrec');
MysqlAddStr(hstr, '    where sys_nar.choice=3                      ');
MysqlAddStr(hstr, '     and  prnaryad.datok > #date('+datetostr(_dateOtchPer,'15,MM,YYYY')+') ');
MysqlAddStr(hstr, '     and  prnaryad.vidopl not in (9,11,70,72) ');

  var objQuery: iQuery;
    objQuery := queryManager.createQuery(hstr);
  if objQuery.execute.errorCode != tsOk
   then {
      logstrtofile(_log,'Ошибка выполнения запроса '+ objQuery.errorCode);
      }
  else
  {
    sqlCopyInto(objQuery, tntSetNaryad, true);
  }
   StopVisual;
   StartNewVisual(vtIndicatorVisual, vfTimer, '', recordsintable(tntSetNaryad));
   _loop tSetNaryad
    {
      nextvisual;
      if getfirst fastfirstrow PrNaryad where ((tSetNaryad.nrec == prNaryad.nrec)) = tsOK
       update current PrNaryad set prnaryad.datan = date(01,Month(_dateOtchPer),year(_dateOtchPer)), prnaryad.datok =date(15,Month(_dateOtchPer),year(_dateOtchPer))
    }
    stopvisual;
    Message('Выполнено/ Изменено позиций нарядов: '+ recordsintable(tntSetNaryad));
}
handleevent
cminit:
{
    var _dateOtchPer : date = dgettune('UP.DATOTCH');
  if Message('Установить дату окончания нарядов в ' + date(15,Month(_dateOtchPer),year(_dateOtchPer)) + ' для расчета аванса?', Confirmation + YesNo) = cmYes
    then SetNaryadtoAvans;
}
end;
end.
