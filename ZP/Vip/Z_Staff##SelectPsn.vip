#component "Z_Staff"

alter interface SelectPsn;

create view
from
  Persons PsnBorn
where
((
  tmpPersons.Nrec == PsnBorn.nRec
));

ExtendFormats brwPsn;
browse brwPsn;
  Fields
    //{ Font = { Color = if ( MarkerStr = 'v', ColorMark, 0 )}};
    PsnBorn.BornDate 'Дата', 'рождения': [12], protect;
end;

end.
