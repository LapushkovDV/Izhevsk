/*************************************************************************************************\
* Наименование: Справка расчета доплаты до среднего заработка при временной нетрудоспособности    *
* Контур/Модуль: Заработная плата / Отчеты / НПО Энергомаш                                        *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#0000         |19/10/18|Евдокимов М.А.           |НПО Энергомаш                    *
* Разработка  |#5906         |27/08/19|Торохов А.П.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include XlReport.vih
#include PAFilter.vih
#include Query.vih

#component "GP_ZP"

interface GP_SprDoplSrZar 'Справка расчета доплаты до среднего заработка при временной нетрудоспособности' escClose;
show(,,67,10);


table struct tSums (
  cLSch    : comp,
  dDate    : date,
  DaysKlndr: double,
  DaysWT   : array[1..31] of double,
  DaysCoeff: double,
  FOT      : double,
  Prem     : double
) with index (
  i01 = cLSch + dDate
);


create view
var
  _year    : word;
  _month   : word;
  _qSumFOT : IQuery;
  _qSumPrem: IQuery;
  pXL      : XLSRepBuilder;
  _yeark   : word;
  _monthk  : word;
  #include PAFilter.var
(
  FiltrPodr
 ,FiltrPublic
)
as select
  #include GP_Podrfiltr1.vpp
from
  Zar_User
 ,CurLSchet
 ,Lschet LschetN
 ,Persons PersonsN
 ,LSchet LSchetFM
 ,Catalogs CatPost
 ,PrVidOpl
 ,Persons PersonsFM
 ,KatPodr KatPodrFM
 ,Klndr
 ,tSums
 ,KlVidOpl KlVidOplPrem
 ,Nachisl
 ,SumVidOp
where ((
      root == KlVidOplPrem.Nrec and
      (    KlVidOplPrem.VHVOE[6]='Х'
       and KlVidOplPrem.vhvo[13]='+'
      )  
  and _cLSchet              == Formarks.Choice
  and ForMarks.cLSchet      == LSchetFM.Nrec
  and LSchetFM.TPerson      == PersonsFM.Nrec
  and LSchetFM.Cex          == KatPodrFM.Nrec
  and LSchetFM.Rejim        == Klndr.Rejim
  and LSchetFM.cAppoint     == CatPost.Nrec
  and 95                    == PrVidOpl.VidOpl
  and (PrVidOpl.cLSch        = ForMarks.cLSchet
  and  Year(PrVidOpl.DataN)  = _year
  and  Month(PrVidOpl.DataN) = _month)
  and _yeark                == Klndr.YearK
  and _monthk               == Klndr.MonthK  
  and ForMarks.cLschet      == tSums.cLSch
  and #include GP_Podrfiltr2.vpp

  and LSchetFM.nrec        == SumVidOp.cLsch
  and _yeark               == SumVidOp.yearK
  and _monthk              == SumVidOp.mes
  and KlVidOplPrem.vidOpl  == SumVidOp.vidOpl
  and LSchetFM.datPos     <<= SumVidOp.dataN(noindex)
  and LSchetFM.nrec        == Nachisl.cLsch
  and _yeark               == Nachisl.yearK
  and _monthk              == Nachisl.mes
  and KlVidOplPrem.vidoplP == Nachisl.vidOpl
  and KlVidOplPrem.vidOpl  == Nachisl.vidOpls(noindex)
  and Lschet.datPos       <<= Nachisl.dataN(noindex)
));

#include GP_PODRPAFilter.vpp


screen scr1;
  table Zar_User;
  fields
    _year     ('Год доплаты', hcNoContext, sci1Esc): NoProtect, SpinButton [1, 1900, 2100];
    _month    ('Месяц доплаты', hcNoContext):
      [LIST 1 ' Январь',' Февраль',' Март',' Апрель',' Май',' Июнь',' Июль',
              ' Август',' Сентябрь',' Октябрь',' Ноябрь',' Декабрь'], protect;
    Zar_User.GrupStN  ('Выберите фильтр для расчета', hcZar_ChildProtokolRB, sci1Esc): noprotect;
    FiltrPodr('Заданный фильтр по подразделению', hcZar_ChildProtokolRB,sci13Esc) : protect;
    FiltrPublic('Заданный фильтр по работникам', hcZar_ChildProtokolRB,sci13Esc)  : protect;
  buttons
    cmOk, default;
    cmCancel;
<<

   Анализировать доплаты до среднего заработка при временной нетрудоспособности
  `за год`.@@@@@@ `месяц`.@@@@@@@@@@

   `Фильтры по`
   [.] подразделениям`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   [.] работникам    `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <. ~С~формировать .>                      <.    ~О~тмена    .>
>>
end;


sql query qSumFOT =
select
  sum(s.summa)
from SumVidOp s
join KlVidOpl vo
  on vo.VidOpl = s.VidOpl
where
      s.cLSch     = :cLSch
  and s.YearN     = :Year
  and s.MesN      = :Month
  and vo.VHVO[15] = '+'
  and vo.VHVOE[6] = '-';
function GetSumFOT(cLSch: comp; wYear: word; bMonth: byte): double;
{
  if _qSumFOT = NullRef
    _qSumFOT := queryManager.createQuery(qSumFOT);
  result := _qSumFOT.setParam('cLSch', cLSch)
                    .setParam('Year', wYear)
                    .setParam('Month', bMonth)
                    .getResultValue;
}


sql query qSumPrem =
select
  sum(s.summa)
from SumVidOp s
join KlVidOpl vo
  on vo.VidOpl = s.VidOpl
where
      s.cLSch     = :cLSch
  and s.YearN     = :Year
  and s.MesN      = :Month
  and vo.VHVO[15] = '+'
  and vo.VHVOE[6] <> '-';
function GetSumPrem(cLSch: comp; wYear: word; bMonth: byte): double;
{
  if _qSumPrem = NullRef
    _qSumPrem := queryManager.createQuery(qSumPrem);
  result := _qSumPrem.setParam('cLSch', cLSch)
                     .setParam('Year', wYear)
                     .setParam('Month', bMonth)
                     .getResultValue;
}

//#5906 - алгоритм расчета премии взят из #1389
Function CalcPrem: Double;
{
  Var premi1 : Double = 0;
  Var premi2 : Double = 0;

  _loop KlVidOplPrem 
  {
    _loop SumVidOp 
    {
      if (KlVidOplPrem.Vidopl = 30)
      { premi2 += SumVidOp.summa; }
      else
      { premi1 += SumVidOp.summa; }
    }
    
    _loop Nachisl 
    {
      if KlVidOplPrem.Vidopl=30
      { premi2 += Nachisl.summa; }
      else
      { premi1 += Nachisl.summa; }
    }
  }

  Result := premi1 + premi2;
}

procedure PrintXLSReport(sXLTFileName: string; isCreateXLT: boolean = false);
{
  var sXLSFileName: string = if(isCreateXLT,
                                pXL.CreateXLT(sXLTFileName, true),
                                pXL.CreateReport(sXLTFileName, true));
  pXL.CreateVar(sXLSFileName);

  if getfirst PersonsFM = tsOk
  {
    pXL.SetStringVar('FIO', PersonsFM.FIO);
    pXL.SetStringVar('StrTabN', PersonsFM.StrTabN);
  }
  else
  {
    pXL.SetStringVar('FIO', '');
    pXL.SetStringVar('StrTabN', '');
  }

  if getfirst KatPodrFM = tsOk
  {
    pXL.SetStringVar('PodrKod', KatPodrFM.Kod);
    pXL.SetStringVar('PodrName', KatPodrFM.Name);
  }
  else
  {
    pXL.SetStringVar('PodrKod' , '');
    pXL.SetStringVar('PodrName', '');
  }

  pXL.SetStringVar('Post', if(getfirst CatPost = tsOk, CatPost.Name, ''));
  pXL.SetNumberVar('Tarif', LSchetFM.Tarif);
  if getfirst PrVidOpl = tsOk
  {
    pXL.SetDateVar('DataN', PrVidOpl.DataN);
    pXL.SetDateVar('DatOk', PrVidOpl.DatOk);
    pXL.SetNumberVar('ChasF', PrVidOpl.ChasF);
    pXL.SetNumberVar('Summa', PrVidOpl.Summa);
    pXL.SetNumberVar('KolDn', PrVidOpl.KolDn);
  }

  pXL.PublishVar;

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('Main');
  pXL.CreateTblFld('Date');
  pXL.CreateTblFld('DateStr');
  pXL.CreateTblFld('DaysKlndr');
  pXL.CreateTblFld('DaysCoeff');
  pXL.CreateTblFld('dkSpecial');
  pXL.CreateTblFld('dkWorking');
  pXL.CreateTblFld('dkHoliday');
  pXL.CreateTblFld('dkWeekEnd');
  pXL.CreateTblFld('dkOverWork');
  pXL.CreateTblFld('dkOverworkRest');
  pXL.CreateTblFld('dkEvening');
  pXL.CreateTblFld('dkNight');
  pXL.CreateTblFld('dkWorkingForAvgEarnings');
  pXL.CreateTblFld('dkAdvanceable');
  pXL.CreateTblFld('dkPaid');
  pXL.CreateTblFld('dkWorkingHoliday');
  pXL.CreateTblFld('dkWorkingWeekend');
  pXL.CreateTblFld('dkWholeWorking');
  pXL.CreateTblFld('dkAppearance');
  pXL.CreateTblFld('dkWeekendHoliday');
  pXL.CreateTblFld('dkEnabled');
  pXL.CreateTblFld('dkHarmfulConditions');
  pXL.CreateTblFld('dkCalendarWorking');
  pXL.CreateTblFld('dkOrderedWeekendWork');
  pXL.CreateTblFld('dkPaidOrderedWeekendWork');
  pXL.CreateTblFld('dkOrderedOvertimeWork');
  pXL.CreateTblFld('dkCalendarVacation');
  pXL.CreateTblFld('dkTimeForSickListEnteringKind');
  pXL.CreateTblFld('dkOrderedWeekendWorkForLeave');
  pXL.CreateTblFld('dkOrderedOvertimeWorkForLeave');
  pXL.CreateTblFld('dkWorkingWorkingHoliday');
  pXL.CreateTblFld('dkWorkingWeekendHoliday');
  pXL.CreateTblFld('dkICOrdinary');
  pXL.CreateTblFld('dkICHarmful');
  pXL.CreateTblFld('FOT');
  pXL.CreateTblFld('Prem');
  if not isCreateXLT
    _loop tSums
    {
      if tSums.dDate = 0 continue;
      pXL.ClearTblBuffer;
      pXL.SetTblDateFldValue  ('Date'                         , tSums.dDate);
      pXL.SetTblStringFldValue('DateStr'                      , DateToStr(tSums.dDate,'YYYY Month'));
      pXL.SetTblNumberFldValue('DaysKlndr'                    , tSums.DaysKlndr);
      pXL.SetTblNumberFldValue('DaysCoeff'                    , tSums.DaysCoeff);
      pXL.SetTblNumberFldValue('FOT'                          , tSums.FOT);
      pXL.SetTblNumberFldValue('Prem'                         , tSums.Prem);
      pXL.SetTblNumberFldValue('dkSpecial'                    , tSums.DaysWT[dkSpecial]                    );
      pXL.SetTblNumberFldValue('dkWorking'                    , tSums.DaysWT[dkWorking]                    );
      pXL.SetTblNumberFldValue('dkHoliday'                    , tSums.DaysWT[dkHoliday]                    );
      pXL.SetTblNumberFldValue('dkWeekEnd'                    , tSums.DaysWT[dkWeekEnd]                    );
      pXL.SetTblNumberFldValue('dkOverWork'                   , tSums.DaysWT[dkOverWork]                   );
      pXL.SetTblNumberFldValue('dkOverworkRest'               , tSums.DaysWT[dkOverworkRest]               );
      pXL.SetTblNumberFldValue('dkEvening'                    , tSums.DaysWT[dkEvening]                    );
      pXL.SetTblNumberFldValue('dkNight'                      , tSums.DaysWT[dkNight]                      );
      pXL.SetTblNumberFldValue('dkWorkingForAvgEarnings'      , tSums.DaysWT[dkWorkingForAvgEarnings]      );
      pXL.SetTblNumberFldValue('dkAdvanceable'                , tSums.DaysWT[dkAdvanceable]                );
      pXL.SetTblNumberFldValue('dkPaid'                       , tSums.DaysWT[dkPaid]                       );
      pXL.SetTblNumberFldValue('dkWorkingHoliday'             , tSums.DaysWT[dkWorkingHoliday]             );
      pXL.SetTblNumberFldValue('dkWorkingWeekend'             , tSums.DaysWT[dkWorkingWeekend]             );
      pXL.SetTblNumberFldValue('dkWholeWorking'               , tSums.DaysWT[dkWholeWorking]               );
      pXL.SetTblNumberFldValue('dkAppearance'                 , tSums.DaysWT[dkAppearance]                 );
      pXL.SetTblNumberFldValue('dkWeekendHoliday'             , tSums.DaysWT[dkWeekendHoliday]             );
      pXL.SetTblNumberFldValue('dkEnabled'                    , tSums.DaysWT[dkEnabled]                    );
      pXL.SetTblNumberFldValue('dkHarmfulConditions'          , tSums.DaysWT[dkHarmfulConditions]          );
      pXL.SetTblNumberFldValue('dkCalendarWorking'            , tSums.DaysWT[dkCalendarWorking]            );
      pXL.SetTblNumberFldValue('dkOrderedWeekendWork'         , tSums.DaysWT[dkOrderedWeekendWork]         );
      pXL.SetTblNumberFldValue('dkPaidOrderedWeekendWork'     , tSums.DaysWT[dkPaidOrderedWeekendWork]     );
      pXL.SetTblNumberFldValue('dkOrderedOvertimeWork'        , tSums.DaysWT[dkOrderedOvertimeWork]        );
      pXL.SetTblNumberFldValue('dkCalendarVacation'           , tSums.DaysWT[dkCalendarVacation]           );
      pXL.SetTblNumberFldValue('dkTimeForSickListEnteringKind', tSums.DaysWT[dkTimeForSickListEnteringKind]);
      pXL.SetTblNumberFldValue('dkOrderedWeekendWorkForLeave' , tSums.DaysWT[dkOrderedWeekendWorkForLeave] );
      pXL.SetTblNumberFldValue('dkOrderedOvertimeWorkForLeave', tSums.DaysWT[dkOrderedOvertimeWorkForLeave]);
      pXL.SetTblNumberFldValue('dkWorkingWorkingHoliday'      , tSums.DaysWT[dkWorkingWorkingHoliday]      );
      pXL.SetTblNumberFldValue('dkWorkingWeekendHoliday'      , tSums.DaysWT[dkWorkingWeekendHoliday]      );
      pXL.SetTblNumberFldValue('dkICOrdinary'                 , tSums.DaysWT[dkICOrdinary]                 );
      pXL.SetTblNumberFldValue('dkICHarmful'                  , tSums.DaysWT[dkICHarmful]                  );
      pXL.InsTblRow;
    }
  pXL.PublishTbl('Main');
  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
}


handleevent

  cmOk:
  {
    StartNewVisual(vtRotateVisual, vfTimer, 'Формирование справки-расчета', 0);
    var cnt: integer = 0;

    intinit;
    if not FillMarks
    {
      abort;
      exit;
    }

    if not InitWorkingTable exit;

    var i: byte = 0;
    var d1: date;
    var d2: date;
    var d : date;

    mtClear(tntSums, mfNormal);
    _loop ForMarks
    {
      if getfirst LSchetFM != tsOk continue;
      if getfirst PrVidOpl != tsOk continue;

      //#5906 PrVidOpl.lastDate - дата назначения, 12 месяцев отсчитывать от этой даты
      d1 := Sub_Months(date(1, Month(PrVidOpl.lastDate), Year(PrVidOpl.lastDate)), 12);
      d2 := Add_Months(d1, 11);

      for(d := d1; d <= d2; d := Add_Months(d, 1))
      {
        _yeark  := Year(d);
        _monthk := Month(d);

        ClearBuffer(tntSums);
        tSums.cLSch := ForMarks.cLSchet;
        tSums.dDate := d;
        //Дни по графику
        if getfirst Klndr = tsOk
        {
          var ld: byte = Last_Day(d);
          for(i := 1; i <= ld; i++)
            if Klndr.DayChas[i] != 0 or Klndr.DayMin[i] != 0
              tSums.DaysKlndr += 1;
        }
        //Дни по табелю
        if LoadWorkingTable(tSums.cLSch, Month(tSums.dDate), Year(tSums.dDate)) = 0
        {
          tSums.DaysWT[dkSpecial]                    := WT_GetDays(dkSpecial                    , stActual);  //1   больничный/отпуск/уже уволен/еще не принят на работу
          tSums.DaysWT[dkWorking]                    := WT_GetDays(dkWorking                    , stActual);  //2   день, считающийся рабочим по закону (зависит от настроек)
          tSums.DaysWT[dkHoliday]                    := WT_GetDays(dkHoliday                    , stActual);  //3   праздничный день
          tSums.DaysWT[dkWeekEnd]                    := WT_GetDays(dkWeekEnd                    , stActual);  //4   выходной (для типа графика stActual фактически означает, помечен ли этот день именно что условным обозначением выходного)
          tSums.DaysWT[dkOverWork]                   := WT_GetDays(dkOverWork                   , stActual);  //5   дни работы сверхурочно
          tSums.DaysWT[dkOverworkRest]               := WT_GetDays(dkOverworkRest               , stActual);  //6   дни работы сверхурочно
          tSums.DaysWT[dkEvening]                    := WT_GetDays(dkEvening                    , stActual);  //7   дни работы вечером
          tSums.DaysWT[dkNight]                      := WT_GetDays(dkNight                      , stActual);  //8   дни работы ночью
          tSums.DaysWT[dkWorkingForAvgEarnings]      := WT_GetDays(dkWorkingForAvgEarnings      , stActual);  //10  рабочие дни с точки зрения расчета по среднему
          tSums.DaysWT[dkAdvanceable]                := WT_GetDays(dkAdvanceable                , stActual);  //11  день, за который можно выплатить аванс (рабочий день по плану и либо рабочий день по факту, либо день, на который пришлось оплачиваемое отклонение)
          tSums.DaysWT[dkPaid]                       := WT_GetDays(dkPaid                       , stActual);  //12  оплачиваемый день (рабочий день, либо день, на который пришлось оплачиваемое отклонение)
          tSums.DaysWT[dkWorkingHoliday]             := WT_GetDays(dkWorkingHoliday             , stActual);  //13  работа в праздничный день за оплату (как в рабочий по плану, так и в нерабочий по плану)
          tSums.DaysWT[dkWorkingWeekend]             := WT_GetDays(dkWorkingWeekend             , stActual);  //14  работа в выходной день за оплату
          tSums.DaysWT[dkWholeWorking]               := WT_GetDays(dkWholeWorking               , stActual);  //15  все отработанные дни (без учета настроек "рабочие часы за вычетом...")
          tSums.DaysWT[dkAppearance]                 := WT_GetDays(dkAppearance                 , stActual);  //16  дни явки
          tSums.DaysWT[dkWeekendHoliday]             := WT_GetDays(dkWeekendHoliday             , stActual);  //17  нерабочий праздничный день
          tSums.DaysWT[dkEnabled]                    := WT_GetDays(dkEnabled                    , stActual);  //18  не отброшенный фильтром день
          tSums.DaysWT[dkHarmfulConditions]          := WT_GetDays(dkHarmfulConditions          , stActual);  //19  дни работы во вредных условиях. Опирается только на признак "условия работы" в отклонениях
          tSums.DaysWT[dkCalendarWorking]            := WT_GetDays(dkCalendarWorking            , stActual);  //20  календарные дни работы
          tSums.DaysWT[dkOrderedWeekendWork]         := WT_GetDays(dkOrderedWeekendWork         , stActual);  //21  дни работы по приказу на работу в выходные
          tSums.DaysWT[dkPaidOrderedWeekendWork]     := WT_GetDays(dkPaidOrderedWeekendWork     , stActual);  //22  дни оплачиваемой работы по приказу на работу в выходные
          tSums.DaysWT[dkOrderedOvertimeWork]        := WT_GetDays(dkOrderedOvertimeWork        , stActual);  //23  дни работы по приказу на работу сверхурочно
          tSums.DaysWT[dkCalendarVacation]           := WT_GetDays(dkCalendarVacation           , stActual);  //24  календарные дни для расчета отпуска
          tSums.DaysWT[dkTimeForSickListEnteringKind]:= WT_GetDays(dkTimeForSickListEnteringKind, stActual);  //25  дни для времени, входящего в расчет больничного
          tSums.DaysWT[dkOrderedWeekendWorkForLeave] := WT_GetDays(dkOrderedWeekendWorkForLeave , stActual);  //26  дни работы в выходные по приказу, за отгул
          tSums.DaysWT[dkOrderedOvertimeWorkForLeave]:= WT_GetDays(dkOrderedOvertimeWorkForLeave, stActual);  //27  дни работы сверхурочно по приказу, за отгул
          tSums.DaysWT[dkWorkingWorkingHoliday]      := WT_GetDays(dkWorkingWorkingHoliday      , stActual);  //28  дни работы в рабочий по плану праздничный день
          tSums.DaysWT[dkWorkingWeekendHoliday]      := WT_GetDays(dkWorkingWeekendHoliday      , stActual);  //29  дни работы в нерабочий по плану праздничный день за оплату
          tSums.DaysWT[dkICOrdinary]                 := WT_GetDays(dkICOrdinary                 , stActual);  //30  дни, отработанные в нормальных условиях труда (с кодом вредности ICOrdinary ), и приравнивающиеся к таковым
          tSums.DaysWT[dkICHarmful]                  := WT_GetDays(dkICHarmful                  , stActual);  //31  дни, отработанные во вредных условиях труда (с кодом вредности ICHarmful ), и приравнивающиеся к таковым
        }
        tSums.DaysCoeff  := Round(tSums.DaysWT[dkCalendarVacation] / Last_Day(d) * doGetTune('UP.ZAR.ODSREDDAY'), 2);
        tSums.FOT        := GetSumFOT(ForMarks.cLSchet, _yeark, _monthk);
        
        //#5906 - алгоритм расчета премии взят из #1389        
        //tSums.Prem       := GetSumPrem(ForMarks.cLSchet, _yeark, _monthk);        
        tSums.Prem       := CalcPrem;
        
        insert current tSums;
      } //for(d...
      PrintXlsReport(TranslatePath('%StartPath%\XLS_ЭМ\ZP\SprDoplSrZar.xltm'), false);
      cnt++;
    } //_loop ForMarks
    DoneWorkingTable;
    exitproc;
    StopVisual('', 0);
    if cnt = 0
      Message('Отсутствуют данные для формирования справки');
  }

  cmInit:
  {
    InitUser(1);
    InitCurrentPeriodDates();
    if not ReadMyDsk(_year, 'GP_SprOtp_Year', false)   _year  := word(YearRas);
    if not ReadMyDsk(_month, 'GP_SprOtp_Month', false) _month := MonthRas;
  }

  cmDone:
  {
    SaveMyDsk(_year, 'GP_SprOtp_Year');
    SaveMyDsk(_month, 'GP_SprOtp_Month');
  }

  cmCheckField:
  {
    PodrPubCheck;
    RedrawPanel(#Zar_User);
  }

  cmPick:
  {
    PodrPubPick;
    RedrawPanel(#Zar_User);
  }

end; //handleevent

end.
