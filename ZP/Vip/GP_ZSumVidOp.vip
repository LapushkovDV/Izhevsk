#include GP_Protector.vih
#include GP_SumVidOp.vih

#include GP_ZSumVidOp.vih
interface GP_ZSumVidOp;

Create view ZSumVidOp
bounds GP_PrMesN = LS_Nrec == SumVidOp.cLsch and
                   S_Yeark == SumVidOp.YEARN and S_Mes == SumVidOp.MESN;

Tableevent table SumVidOp;
cmDefault:{
  RunInterfaceNoModal('GP_SumVidOp', LS_Nrec, TabNom, LS_Cex, SumVidOp_nrec, p2);
}
cmDelOnProtect:{
  abort;
}
end;

HandleEvent
cmInit:{
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  var p:GP_Protector;
  p.LinkTo(cfsGetCurrentContainerSelf, '');
  p.ProtectedStatusCtx := sci1EnEsc;
  p.AutoPalette := true;
  p.SetProtected(true);

  AddBounds(tbGP_PrMesN);
  if (getfirst SumVidOp
      where((
        LS_Nrec == SumVidOp.cLsch and S_Vidopl == SumVidOp.VIDOPL and
        S_Yeark == SumVidOp.YEARN and S_Mes == SumVidOp.MESN
      ))=tsok) {};
}
cmHotKeys:{//Перекрываем событие предка

}
end;

end.
