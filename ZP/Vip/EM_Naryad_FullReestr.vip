//************************************************************
#component "EM"
const
 cofZakazEmpty = 'Выберите заказ';
 cofPodrEmpty = 'Выберите подразделение';
end;
Interface EM_Naryad_FullReestr 'Отчет по нарядам со всеми данными из МЕС и АММ' (,,sci17EnEsc), EscClose;
//************************************************************
Show At (,,50,12);
//----------------------------------------
table struct treport
(
   mesYear    : string
 , NarNumber  : string
 , ZakNumber  : string
 , strTabn    : string
 , FIO        : string
 , Proff      : string
 , tps        : string
 , DSEName    : string
 , OperName   : string
 , KolVoGodnZakaz : double
 , OperRazr   : word
 , NrmTime    : double
 , NrmTimePZ  : double
 , KTY        : double
 , Shas       : double
 , Sys        : string
 , ZNP        : string
 , sPodr      : string
 , sPodrM     : string
)
with index
(
  ind0 = mesYear
)
;

Create View
var
   _log : string = 'EM_Naryad_FullReestr.log';
  _fmonthB
, _fYearB
, _fMonthE
, _fYearE
, _fERP
, _fAMM
, _fMES   : word;

 _fZakaz
 , _fPodr  : string;

as select
 tReport.mesYear
from
   treport
 , KatPodr
 , MnPLan
;

Screen ScrMain ;
Fields
 _fmonthB : [LIST 1 'Январь', 2 'Февраль', 3 'Март',4 'Апрель',5 'Май',6 'Июнь',7 'Июль',8 'Август',9 'Сентябрь',10 'Октябрь',11 'Ноябрь',12 'Декабрь'], Protect;
 _fYearB  : NoProtect;
 _fMonthE : [LIST 1 'Январь', 2 'Февраль', 3 'Март',4 'Апрель',5 'Май',6 'Июнь',7 'Июль',8 'Август',9 'Сентябрь',10 'Октябрь',11 'Ноябрь',12 'Декабрь'], Protect;
 _fYearE  : NoProtect;
 _fZakaz  : Protect, pickbutton;
 _fPodr   : protect, pickbutton;
 _fERP    : Noprotect;
 _fAMM    : Noprotect;
 _fMES    : Noprotect;
buttons
  cmOK,;
  cmCancel,;
<< 'Отчет по нарядам c данными из АММ и МЕС'
     Период
  c .@@@@@@@@@@ .@@@@@ по .@@@@@@@@@@ .@@@@@

Фильтр
        по заказам.@@@@@@@@@@@@@@@@@@@@@@@@@@
 по подразделениям.@@@@@@@@@@@@@@@@@@@@@@@@@@
 по системе возникновения наряда [:] ERP`
                                 [:] AMM`
                                 [:] MES`

   <.Сформировать.>      <.Отмена.>
>>
end;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
Procedure MyLog(_str: string);
{
   If Upcase(UserName) = 'LAPUSHKOV_DV'
    {
      LogStrToFile(_log,_str);
    }
}
Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
   sqlAddStr(query_handle, add_query_str);
   MyLog('sql: ' + add_query_str);
} //Function MysqlAddStr(var query_handle: longInt; add_query_str: string): longInt;

function CreateTMPFiltTable(_KAUNUMBER : word):boolean;
{
  result := false;
  var strID   : LongInt;  strID   := 0;
  sqlFreeStr(strID);
  strID:=0;

  case _KAUNUMBER of
   cgKau_Zakaz  : if _fZakaz = cofZakazEmpty then exit
   cgKau_KatPodr: if _fPodr  = cofPodrEmpty  then exit
  end;
                   var _tmpName : string= iGetKau.GetMarkerName(_KAUNUMBER);
                   var Marker_Tmp  : longint = InitMarker(_tmpName, 8, 50, 10, True);

            if GetMarkerCount(Marker_Tmp) = 0 exit;

            CreateTMPFiltTable := false;
            sqlAddStr(strID, 'table tblFilt'+_KAUNUMBER);
            sqlAddStr(strID, '(');
            sqlAddStr(strID, ' cRec: comp');
            sqlAddStr(strID, ')');
            sqlAddStr(strID, 'with index');
            sqlAddStr(strID, '(');
            sqlAddStr(strID, ' a0 = cRec');
            sqlAddStr(strID, ');');
            sqlDropTmpTable('tblFilt'+_KAUNUMBER);
            if sqlCreateTmpTable(strID, ctmNormal) = tsOk
            {
              result := true;
            }
            if result
            {


            var i: integer = 0;
               for (i:=0; i<GetMarkerCount(Marker_Tmp); i++)
               {
                 var tmpNrec: comp = 0h;
                 if (GetMarker(Marker_Tmp, i, tmpNrec))
                 sqlExecDirect('INSERT INTO tblFilt'+_KAUNUMBER+' (cRec) VALUES (' + ' #comp(' + string(tmpNrec) + '))');
               }
              //  CreateTMPFiltTable := true;
            }

}

Procedure FilltReport;
{
  delete all tReport;

    var hstr : longint = 0;

  StartNewVisual(vtRotateVisual, vfBreak+vfTimer, 'Запрос данных', 1);
    MysqlAddStr(hstr, 'select                                                                                  ');
    MysqlAddStr(hstr, '  cast(pn.mes as string) + ''.''+ cast(year(datetime(pn.datan,0)) as string) as mesYear   ');
    MysqlAddStr(hstr, ', sn.nmnem  as NarNumber                                                                            ');
    MysqlAddStr(hstr, ', mnp.number  as ZakNumber                                                                          ');
    MysqlAddStr(hstr, ', p.strtabn as strTabn                                                                            ');
    MysqlAddStr(hstr, ', p.fio      as FIO                                                                           ');
    MysqlAddStr(hstr, ', coalesce(GoljKau.name,doljCat.name,'''') as Proff                                       ');
    MysqlAddStr(hstr, ', Coalesce(pnExt.TPs,'''') as tps                                                         ');
    MysqlAddStr(hstr, ', Coalesce(pnExt.DSEName,'''') as DSEName                                                 ');
    MysqlAddStr(hstr, ', Coalesce(pnExt.OperName,'''') as OperName                                               ');
    MysqlAddStr(hstr, ', Sum(Coalesce(pnExt.KolVoGodnZakaz,0)) as KolVoGodnZakaz                               ');
    MysqlAddStr(hstr, ', Coalesce(pnExt.OperRazr,0) as OperRazr                                               ');
    MysqlAddStr(hstr, ', Sum(pn.NrmTime) as NrmTime                                                            ');
    MysqlAddStr(hstr, ', Sum(Coalesce(pnExt.NrmTimePZ,0)) as NrmTimePZ                                         ');
    MysqlAddStr(hstr, ', Sum(pn.KTY * 100 )as KTY                                                              ');
    MysqlAddStr(hstr, ', Sum(pn.ChasF) as Shas                                                                 ');
    MysqlAddStr(hstr, ', case when pnExt.nrec is null then ''ERP'' else coalesce(avSystem.vString,''AMM'') end as Sys');
    MysqlAddStr(hstr, ', coalesce(pnExt.ZNP, '''') as ZNP                                                                                            ');
    MysqlAddStr(hstr, ', coalesce(kp.kod, '''') as sPodr                                                                                            ');
    MysqlAddStr(hstr, ', coalesce(tapp.spodr, '''') as sPodrM                                                                                            ');
    MysqlAddStr(hstr, 'from sys_nar sn                                                                              ');
    MysqlAddStr(hstr, 'join prnaryad pn on pn.MNREC = sn.nrec                                                       ');
    MysqlAddStr(hstr, 'join Attrnam anSystem on anSystem.name = ''.СистемаИсточник'' and anSystem.wtable = 16003      ');
    //MysqlAddStr(hstr, 'left join EM_NARYAD_PODR np on sn.nrec = np.narNrec                                   ');
    MysqlAddStr(hstr, 'left join attrval avSystem on avSystem.cattrnam = anSystem.nrec and avSystem.wtable = anSystem.wtable and avSystem.crec = sn.nrec');
    MysqlAddStr(hstr, 'left join lschet ls   on  pn.CLSCH = ls.nrec                                                                                     ');
    MysqlAddStr(hstr, 'left join katpodr kp   on  pn.CEXOZ = kp.nrec                                                                                    ');
    MysqlAddStr(hstr, 'left join persons p   on  ls.tperson = p.nrec                                                                                    ');
    MysqlAddStr(hstr, 'left join mnplan mnp   on  pn.ckaud[1] = mnp.nrec                                                                                ');
    MysqlAddStr(hstr, 'left join catalogs doljCat   on  doljCat.nrec = pn.cpodr                                                                         ');
    MysqlAddStr(hstr, 'join attrnam anDolj on anDolj.name = ''Профессия'' and anDolj.wTable = 25031                                                       ');
    MysqlAddStr(hstr, 'left join attrval avDolj on avDolj.cattrnam = anDolj.nrec and avDolj.wtable = anDolj.wtable and avDolj.crec =doljCat.nrec        ');
    MysqlAddStr(hstr, 'left join SpKau GoljKau on GoljKau.nrec = avDolj.vComp                                                                           ');
    MysqlAddStr(hstr, 'left join GP_PRNARYAD_EXT pnExt on pnExt.cPrNaryad = Pn.nrec                                                                     ');
    if CreateTMPFiltTable(cgKau_Zakaz)
    {
      MysqlAddStr(hstr, 'join tblFilt'+cgKau_Zakaz+' on tblFilt'+cgKau_Zakaz+'.crec= mnp.nrec                                                                     ');
    }

    if CreateTMPFiltTable(cgKau_KatPodr)
    {
      MysqlAddStr(hstr, 'join tblFilt'+cgKau_KatPodr+' on tblFilt'+cgKau_KatPodr+'.crec= kp.nrec                                                                     ');
    }
    MysqlAddStr(hstr, 'outer apply (                                                                                 ');
    MysqlAddStr(hstr, '                select top 1                                                                  ');
    MysqlAddStr(hstr, '                  catp.code as spodr                                                          ');
    MysqlAddStr(hstr, '                from appointments app                                                         ');
    MysqlAddStr(hstr, '                inner join catalogs catp on app.department = catp.nrec                        ');
    MysqlAddStr(hstr, '                where app.person = p.nrec                                                     ');
    MysqlAddStr(hstr, '                      and app.post = pn.cpodr                                                 ');
    MysqlAddStr(hstr, '                      and ( (pn.datan between app.appointdate and app.dismissdate) or         ');
    MysqlAddStr(hstr, '                            (pn.datan >= app.appointdate and app.dismissdate = #date(0,0,0))  ');
    MysqlAddStr(hstr, '                      )                                                                       ');
    MysqlAddStr(hstr, ') tapp                                                                                        ');

    MysqlAddStr(hstr, 'where                                                                                                                            ');
    MysqlAddStr(hstr, 'sn.choice in (3,203)                                                                                                             ');
    MysqlAddStr(hstr, 'and pn.datan between #date(01,'+_fmonthB+','+_fYearB+') and #date(31,'+_fmonthE+','+_fYearE+')                                   ');
    MysqlAddStr(hstr, ' and case when pnExt.nrec is null then ''ERP'' else coalesce(avSystem.vString,''AMM'') end in ('''' '+if(_fERP=1,' ,''ERP'' ','')+if(_fAMM=1,' ,''AMM'' ','')+if(_fMES=1,', ''MES'' ','')+')');
    MysqlAddStr(hstr, 'group by   cast(pn.mes as string) + ''.''+ cast(year(datetime(pn.datan,0)) as string)                                            ');
    MysqlAddStr(hstr, ', sn.nmnem                                                                                                                       ');
    MysqlAddStr(hstr, ', mnp.number                                                                                                                     ');
    MysqlAddStr(hstr, ', p.strtabn                                                                                                                      ');
    MysqlAddStr(hstr, ', p.fio                                                                                                                          ');
    MysqlAddStr(hstr, ', coalesce(GoljKau.name,doljCat.name,'''')                                                                                       ');
    MysqlAddStr(hstr, ', Coalesce(pnExt.TPs,'''')                                                                                                       ');
    MysqlAddStr(hstr, ', Coalesce(pnExt.DSEName,'''')                                                                                                   ');
    MysqlAddStr(hstr, ', Coalesce(pnExt.OperName,'''')                                                                                                  ');
    MysqlAddStr(hstr, ', Coalesce(pnExt.OperRazr,0)                                                                                                     ');
    MysqlAddStr(hstr, ', case when pnExt.nrec is null then ''ERP'' else coalesce(avSystem.vString,''AMM'') end                                          ');
    MysqlAddStr(hstr, ', coalesce(pnExt.ZNP, '''')                                                                                                      ');
    MysqlAddStr(hstr, ', coalesce(kp.kod, '''')                                                                                                         ');
    MysqlAddStr(hstr, ', coalesce(tapp.spodr, '''')                                                                                                         ');
    //MysqlAddStr(hstr, ', coalesce(np.podrkod, '''')                                                                                                     ');

    SetVisualHeader('Выполнение запроса SQL');
  var objQuery: iQuery;
    objQuery := queryManager.createQuery(hstr);
  if objQuery.execute.errorCode != tsOk
   then {
      message('Ошибка выполнения запроса '+ objQuery.errorCode,error);
      }
  else
  {
    SetVisualHeader('Перенос данных во временную таблицу');
    sqlCopyInto(objQuery, tntReport, true);
//    MyLog('за ' + _dOrd + ' найдено ' +recordsintable(tntNewPrices)+ ' спецификаций ордеров');
  }
stopvisual;
}

#include EM_Naryad_FullReestr_PrintToExcel.vpp

HandleEvent
cmInit:
{
 _fmonthB  := _fMonthE := month(Cur_date);
 _fYearB   := _fYearE := year(Cur_DATE);
 _fERP     :=  _fAMM :=  _fMES  := 1;
 _fZakaz   := cofZakazEmpty;
 _fPodr    :=  cofPodrEmpty;
}
cmPick:
{
  case curfield of
   #_fZakaz:
    {
       if iGetKau.GetCodeKau(cgiMulti,cgKau_Zakaz,Comp(0)) <> cmCancel {
         var _tmpName : string= iGetKau.GetMarkerName(cgKau_Zakaz);
         var Marker_Tmp  : longint = InitMarker(_tmpName, 8, 50, 10, True);

/*
      var i: integer = 0;
         for (i:=0; i<GetMarkerCount(Marker_Tmp); i++) {
           var tmpNrec: comp = 0h;
           if (GetMarker(Marker_Tmp, i, tmpNrec))
           if getfirst KatPodr Where ((tmpNrec == KatPOdr.nrec)) = tsOK{
           }
         }
*/
  if GetMarkerCount(Marker_Tmp) = 0
   then _fZakaz := cofZakazEmpty
   else _fZakaz := 'Выбрано ' + GetMarkerCount(Marker_Tmp) ;
         DoneMarker(Marker_Tmp,_tmpName);
       }
   }
   #_fpodr:
    {
       if iGetKau.GetCodeKau(cgiMulti,cgKau_KatPodr,Comp(0)) <> cmCancel {
         var _tmpName : string= iGetKau.GetMarkerName(cgKau_KatPodr);
         var Marker_Tmp  : longint = InitMarker(_tmpName, 8, 50, 10, True);

/*
      var i: integer = 0;
         for (i:=0; i<GetMarkerCount(Marker_Tmp); i++) {
           var tmpNrec: comp = 0h;
           if (GetMarker(Marker_Tmp, i, tmpNrec))
           if getfirst KatPodr Where ((tmpNrec == KatPOdr.nrec)) = tsOK{
           }
         }
*/
  if GetMarkerCount(Marker_Tmp) = 0
   then _fPodr := cofPodrEmpty
   else _fPodr := 'Выбрано ' + GetMarkerCount(Marker_Tmp);
         DoneMarker(Marker_Tmp,_tmpName);
       }
   }

   end;
   rereadrecord;
}
cmdelonprotect:
{
case curfield of
   #_fZakaz: _fZakaz := cofZakazEmpty
   #_fpodr : _fPodr := cofPodrEmpty
   end;
  rereadrecord;
}

cmOK:
{



  if Date(01,_fmonthB,_fyearB) > Date(01,_fmonthE,_fyearE)
   {
     message('Некорректный период',error);
     Stop; abort; exit;
   }

   if  _fERP = 0 and _fAMM =0 and _fMES = 0
   {
     message('Выберите системы-источник нарядов',error);
     Stop; abort; exit;
   }


   FilltReport;


   if getfirst tReport = tsOK
    {
      PrintToExcel;
    }
    else
    {
      message('Нет данных для формирования отчета',error);
    }
 if VisualizationActive StopVisual('',0);
}

end;
end.

#include UserReport.vih

VipInterface UserReport_EM_Naryad_FullReestr Implements IUserReport licensed(free);
Interface UserReport_EM_Naryad_FullReestr;

  create view;

  procedure Run;
  {
    runinterfacenomodal(EM::EM_Naryad_FullReestr);
  }

  function GetReportName: String;
  {
    GetReportName := 'Детальный отчет по нарядам';
  }

  function GetGroupName (Level : Word) : String;
  {
    if (Level = 1)
      GetGroupName := ''
    else
      GetGroupName := '';
  }

  function GetPriority : Integer;
  {
    GetPriority := 0;
  }

  function VisibleInModule(Ind : Byte) : String;
  {
    VisibleInModule := '';
    case Ind of
      1: result:= 'STAFFMAINMENU';
      2: result:= 'menuzarp';
    end;
  }
end.
