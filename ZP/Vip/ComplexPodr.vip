#doc
Привязка подразделений к комплексам
#end

#include Query.vih
#include GetKau.Vih

Interface PodrRefComplex 'Привязка подразделений к комплексам';
Show(5,1,150,25);

Const
  wKodGrKau = 10718;
  wKauPodr  = 2;
  wKauCompl = 10689;
End;

Table Struct tbDateRec
(
  cSpKau  : comp
, dBeg    : date
, dEnd    : date
)
With Index
(
  i01 = cSpKau
);

#include GetKau.Var

Create View
Var
  cPodr     : comp;
  cCompl    : comp;
  _log      : string = '';
  sCodeTune : string = 'NPOEM_OWN.KAT.KATPODR.COMPLEX';
As
Select
  KatPodr.Kod + ' ' + KatPodr.Name  (FieldName = Podr)
, tbDateRec.dBeg                    (FieldName = dBeg)
, tbDateRec.dEnd                    (FieldName = dEnd)
, ComplexPodr.Name                  (FieldName = ComplPodr)
From
  SpKau
, tbDateRec
, KauReff     PodrReff
, KauReff     ComplReff
, KatPodr
, SpKau       ComplexPodr
Where
((
         wKodGrKau == SpKau.KodGrKau

and     SpKau.nRec == tbDateRec.cSpKau

and     SpKau.nRec == PodrReff.cRec
and        coSpKau == PodrReff.coTable
and       wKauPodr == PodrReff.wKau
and  PodrReff.cKau == KatPodr.nRec

and     SpKau.nRec == ComplReff.cRec
and        coSpKau == ComplReff.coTable
and      wKauCompl == ComplReff.wKau
and ComplReff.cKau == ComplexPodr.nRec

))
and    KatPodr.nRec = cPodr
;

Parameters cPodr;

Procedure MyLog(_str: string);
{
  if _log = '' then _log := 'PodrCoplex_' + DateToStr(cur_date, 'DDMMYYYY') + '_' + timetostr(Cur_time, 'HHMMSS') + '.log';
  LogStrToFile(_log, _str);
}
Procedure MysqlAddStr(var query_handle : longInt; add_query_str : string);
{
  sqlAddStr(query_handle, add_query_str);
  MyLog('sql: ' + add_query_str);
}

Procedure Fill_tbDateRec;
{
  delete all from tbDateRec;

  var qStr : longint = 0;

  sqlFreeStr(qStr);

  MysqlAddStr(qStr, ' select                                                                                                                                                                  ');
  MysqlAddStr(qStr, '   SpKau.nRec as cSpKau                                                                                                                                                  ');
  MysqlAddStr(qStr, ' , cast(substring(SpKau.Code, 1, 2) as integer) + cast(substring(SpKau.Code, 3, 2) as integer) * 256+ cast(substring(SpKau.Code, 5, 4) as integer) * 256 * 256 as dBeg   ');
  MysqlAddStr(qStr, ' , cast(substring(SpKau.Name, 1, 2) as integer) + cast(substring(SpKau.Name, 3, 2) as integer) * 256+ cast(substring(SpKau.Name, 5, 4) as integer) * 256 * 256 as dEnd   ');
  MysqlAddStr(qStr, ' from SpKau                                                                                                                                                              ');
  MysqlAddStr(qStr, ' where SpKau.KodGrKau = cast(' + wKodGrKau + ' as word)                                                                                                                  ');

  var objQuery: iQuery;
      objQuery := queryManager.createQuery(qStr);
  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('Ошибка заполнения временной таблицы '+ objQuery.errorCode, Error);
    Exit;
  }
  else
  {
    sqlCopyInto(objQuery, tntbDateRec, true);
  }
  sqlFreeStr(qStr);
}

Function Check_dBeg(dt : date) : boolean;
{
  Result := false;
  PushPos(#SpKau);
  _Loop SpKau
  {
    if (dt >= tbDateRec.dBeg and dt <= tbDateRec.dEnd) then
    {
      Message('Дата начала нового интервала не должна входить в уже существующий'#13 +
              'интервал ' + ComplexPodr.Name + ' : ' + tbDateRec.dBeg + ' - ' + tbDateRec.dEnd, Error);
      PopPos(#SpKau);
      Exit;
    }
  }
  PopPos(#SpKau);
  Result := true;
}

Function Check_dEnd(dt1, dt2 : date) : boolean;
{
  Result := false;
  if (dt1 = Date(0, 0, 0)) then
  {
    Message('Сперва необходимо ввести дату начала интервала.', Error);
    Result := false;
    Exit;
  }

  if (dt2 <= dt1) then
  {
    Message('Дата конца нового интервала должна быть больше'#13 +
            'даты его начала' + ' : ' + dt1, Error);
    Result := false;
    Exit;
  }

  PushPos(#SpKau);
  _Loop SpKau
  {
    if (dt2 >= tbDateRec.dBeg and dt2 < tbDateRec.dEnd) then
    {
      Message('Дата конца нового интервала не должна входить в уже существующий'#13 +
              'интервал ' + ComplexPodr.Name + ' : ' +tbDateRec.dBeg + ' - ' + tbDateRec.dEnd, Error);
      PopPos(#SpKau);
      Exit;
    }
  }
  PopPos(#SpKau);
  Result := true;
}

Screen scMMain 'Редактирование привязки подразделений к комплексам' (,,sci1Esc);
Show at (,,,6);

Fields
  Podr      ('Подразделение',,) : Protect;

<<

 Подразделение .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

>>

End; //scMMain

Browse brSpecifM 'Редактирование привязки подразделений к комплексам' (,,Sci178Esc);
Show At (,7,,);

Table SpKau;

Fields
  Podr           'Подразделение' ('Номер и наименование',,sci178) : [100], Protect;
  ComplPodr      'Комплекс' ('Комплекс подразделений',,sci1378) : [20], Protect, PickButton;
  dBeg           'Дата начала' ('Дата начала',,sci178) : [15], noProtect;
  dEnd           'Дата окончания' ('Дата окончания',,sci178) : [15], noProtect;
End; //brSpecifM

TableEvent Table SpKau;
cmSetDefault:
{
  if (wGetTune(sCodeTune) > 0) then
  {
    ClearBuffer(#SpKau);
      SpKau.nRec := 0h;
      SpKau.Code := '';
      SpKau.Name := '';
      SpKau.KodGrKau := wKodGrKau;
    Insert Current SpKau;
    SetNew(false);

    ClearBuffer(#tbDateRec);
      tbDateRec.cSpKau := SpKau.nRec;
      tbDateRec.dBeg := Date(0, 0, 0);
      tbDateRec.dEnd := Date(0, 0, 0);
    Insert Current tbDateRec;

    ClearBuffer(#PodrReff);
      PodrReff.nRec := 0h;
      PodrReff.cRec := SpKau.nRec;
      PodrReff.coTable := coSpKau;
      PodrReff.wKau := wKauPodr;
      PodrReff.cKau := cPodr;
    Insert Current PodrReff;
    SetNew(false);

    ClearBuffer(#ComplReff);
      ComplReff.nRec := 0h;
      ComplReff.cRec := SpKau.nRec;
      ComplReff.coTable := coSpKau;
      ComplReff.wKau := wKauCompl;
      ComplReff.cKau := 0h;
    Insert Current ComplReff;
    SetNew(false);
  }
  else
  {
    Message('Вы не имеете права создавать записи привязки к комплексам согласно настройке '#13 +
             GetTuneName(sCodeTune), Error);
    Abort;
  }
}

cmCheckField:
{
  if (wGetTune(sCodeTune) > 0) then
  {
    case CurField of
      #dBeg :
      {
        Update Current tbDateRec;
        if (not Check_dBeg(tbDateRec.dBeg)) then
        {
          Set tbDateRec.dBeg := StrToDate(OldFieldValue, 'DD/MM/YYYY');
          Abort;
        }
        Update Current tbDateRec;
        Set SpKau.Code := DateToStr(tbDateRec.dBeg, 'DDMMYYYY');
        Update Current SpKau;
      }
      #dEnd :
      {
        Update Current tbDateRec;
        if (not Check_dEnd(tbDateRec.dBeg, tbDateRec.dEnd)) then
        {
          Set tbDateRec.dEnd := StrToDate(OldFieldValue, 'DD/MM/YYYY');
          Abort;
        }
        Update Current tbDateRec;
        Set SpKau.Name := DateToStr(tbDateRec.dEnd, 'DDMMYYYY');
        Update Current SpKau;
      }
    end;
  }
  else
  {
    Message('Вы не имеете права редактировать записи привязки к комплексам согласно настройке '#13 +
             GetTuneName(sCodeTune), Error);
    Abort;
  }
}

cmDeleteRecord:
{
  if (wGetTune(sCodeTune) = 2) then
  {
    if (message('Удалить текущую запись о соответствии?'#13 + 'Возможно некорректное отображение данных в отчетах.', YesNo) = cmYes) then
    {
      Delete Current PodrReff;
      Delete Current ComplReff;
      Delete Current tbDateRec;
      Delete Current SpKau;
    }
    else Abort;
  }
  else
  {
    Message('Вы не имеете права удалять записи привязки к комплексам согласно настройке '#13 +
             GetTuneName(sCodeTune), Error);
    Abort;
  }

}
End; //TableEvent SpKau

HandleEvent
cmInit:
{
  Fill_tbDateRec;
}
cmPick:
{
  if (wGetTune(sCodeTune) > 0) then
  {
    case CurField of
      #ComplPodr :
      {
        cCompl := ComplexPodr.nRec;
        if (iGetKau.GetCodeKau(cgiNo or cgiPickLeaf, wKauCompl, cCompl) <> 0 ) then
        {
          if (getFirst SpKau SpKau1 where ((cCompl == SpKau1.nRec)) = tsOk) then
          {
            Set ComplReff.cKau := cCompl;
            Update Current ComplReff;
            ReReadRecord;
          }
        }
      }
    end;
  }
  else
  {
    Message('Вы не имеете права редактировать записи привязки к комплексам согласно настройке '#13 +
             GetTuneName(sCodeTune), Error);
    Abort;
  }
}
End; //HandleEvent
End.
