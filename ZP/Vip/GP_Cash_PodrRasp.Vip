//----------------------------------
// Формирование отчета
//----------------------------------
Function FormDoc:boolean;
{ timelog('GP_Cash_PodrRasp->FormDoc START: wPeriod='+string(wPeriod));
  Result:=False;
  //--------------------------
  case wTyperep of
  1:
  { //при запуске двух версии ломается почему то
    ReReadRecord(#tmp_prn_cash);
    MTRetrieve(#tmp_prn_cash,mfFilters+mfClear);
    //--------------------------
    delete all tmp_prn_cash;

    if Not SborData exit;
    if not iNextVisual('Ждите, идет формирование отчета') exit;
    Result:=PrintDoc;
  }
  2:
  { //при запуске двух версии ломается почему то
    ReReadRecord(#tmp_prn_cash);
    MTRetrieve(#tmp_prn_cash02,mfFilters+mfClear);
    //--------------------------
    delete all tmp_prn_cash02;
    if Not SborData02 exit;
    if not iNextVisual('Ждите, идет формирование отчета') exit;
    Result:=PrintDoc02;
  }
  end;
  timelog('GP_Cash_PodrRasp->FormDoc Finish: wPeriod='+string(wPeriod));
} //Function FormDoc:boolean;


  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_SbBan
    { #mrkfiltr_(SbBan_Flt,SbBan,Nrec,wc_nrec,SbBan_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_PlatVed
    { #mrkfiltr_(PlatVed_Flt,PlatVed,Nrec,wc_nrec,PlatVed_Flt.Name)
    }
    ReScanPanel(#Zar_user);
  } //Procedure SetFilterNM(_Field:longint)


//-------------------------------
//
//-------------------------------
Procedure MyCheckPeriod;
{ set wPeriod:=if(Day(DTE)>15,0,1);
}

