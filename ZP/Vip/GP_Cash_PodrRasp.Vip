//----------------------------------------------------------
Interface GP_Cash_PodrRasp 'Распределение выплат по подразделениям';
Show at (,,53,9) ;
//----------------------------------------------------------
Var
  //---------------
  iQBuilder:GP_QueryBuilder new;
  //---------------
  DTB, DTE : date;
  DTAppl   : date;//Дата заявки
  sFioZGD  :string;
  wMonth,wYear:word;
  wPeriod:word;
  wTypeRep:word;
  sNumVed:string;//номер ведомости для сводной
  //-----------------------------------------
  // Фильтры - базовые
  //-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
   isFilterRun  :boolean;////признак работы ограничений
   wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;
   #mrkfld_(SbBan)
   #mrkfld_(PlatVed)
//-------------------------
Table Struct  local tmp_prn_cash
(  Name    :string//"1 Наименование банка/выплаты"
  ,Podr_Kod:string[100]//"2"  для сводной поменяем местами c Name
  ,SumNeed :tSumma     //"3 Требуемая выплата"
  ,StrTabn :string[100]//"4"
  ,Pa      :word       //"5 1- ведомости, 0 реестры"
  ,Fio     :string[100]//"6"
  ,VidUd   :word       //"7"
  ,VidOpl  :longint    //"8"
  ,Prefix  :string[100]//"9"
)
with index
( tmp_prn_cash01 = Podr_Kod+pa+Name+Fio
 ,tmp_prn_cash02 = Name+pa+Podr_Kod+Fio
);

Table Struct local tmp_prn_cash02
(  Name    :string//"1 Наименование банка/выплаты"
  ,Podr_Kod:string[100]//"2"  для сводной поменяем местами c Name
  ,SumNeed :double     //"3 Требуемая выплата"
  ,StrTabn :string[100] //"4"
  ,Pa      :word       //"5 1- ведомости, 0 реестры"
  ,Fio     :string[100]//"6"
  ,VidUd   :word       //"7"
  ,VidOpl  :longint    //"8"
  ,Prefix  :string[100]//"9"
)
with index
( tmp_prn_cash02 =Name+pa+Podr_Kod+Fio
);

//-------------------------------------
Create view
var
  pSbBan :comp;
  sUserName:string;
as select Zar_User.Nrec,tmp_prn_cash.*,tmp_prn_cash02.*
From
   Zar_User(ReadOnly)
//#1715.#4 , tmp_prn_cash(tmp_prn_cash01) +
//изменена группировка в отчете
//GP_ZP!!GP_CASH_PODRRASP DsCach_PodrRasp Отчет по реестрам и платежным ведомостям.fr3
//<tmp_prn_cash."Podr_Kod">+IntToStr(<tmp_prn_cash."Pa">)+<tmp_prn_cash."Name">
//на
//<tmp_prn_cash."Name">+IntToStr(<tmp_prn_cash."Pa">)+<tmp_prn_cash."Podr_Kod">
 , tmp_prn_cash  (tmp_prn_cash02)
 , tmp_prn_cash02(tmp_prn_cash02)
 //---- фильтры
 , PLATVED PLATVED_FLT
 , SBBAN SBBAN_Flt

where ((
    sUserName == Zar_User.OwnName
//and tmp_prn_cash.Vidopl == Klvidopl.Vidopl
//------------------------------------
//  фильтры
and wc_nrec == SBBAN_Flt.Nrec      // Сотрудники
and wc_nrec == PLATVED_Flt.Nrec           // Подразделения
//-----------------



)) ;

Create view vSpr
var
  cat_main_M11:comp;
as select catalogs.Name
from catalogs
,StaffStruct
,Appointments
,Persons
where ((
    cat_main_M11 == Catalogs.MainLink
and 0            == Catalogs.Lpr
//Заместитель генерального директора по экономике и финансам
and '506'        == Catalogs.Code
and Catalogs.Nrec== StaffStruct.Department
and DTE>>=StaffStruct.DInPut
and ( StaffStruct.DClose=ZeroDate or StaffStruct.DClose>=DTE  )
and StaffStruct.Nrec == Appointments.StaffStr
and DTE>>=Appointments.AppointDate(noindex)
and (Appointments.DisMissDate=ZeroDate or Appointments.DisMissDate>=DTE )
and Appointments.Person == Persons.Nrec

))
;
//------------------------------------
Parameters
  wTypeRep
#doc
  1- c расшифровкой по людям
  2- сводная
#end
;

//---------------------------------
Procedure SaveParam;
{ SaveMyDsk(wFilter,'GP_Cash_PodrRasp_wFilter');
  SaveMyDsk(DTB    ,'GP_Cash_PodrRasp_DTB'    );
  SaveMyDsk(DTE    ,'GP_Cash_PodrRasp_DTE'    );
  SaveMyDsk(wPeriod,'GP_Cash_PodrRasp_wPeriod');
  SaveMyDsk(DTAppl ,'GP_Cash_PodrRasp_DTAppl' );//Дата заявки
  SaveMyDsk(sNumVed,'GP_Cash_PodrRasp_sNumVed');

  DoneMarker(Marker_SbBan,'GP_Cash_PodrRasp_SbBan');
  DoneMarker(Marker_PlatVed,'GP_Cash_PodrRasp_PlatVed');
} //Procedure SaveParam;

//---------------------------------
Procedure ReadParam;
{ if not ReadMyDsk(wFilter   ,'GP_Cash_PodrRasp_wFilter'  ,false) wFilter:=0;;
  if not ReadMyDsk(DTB       ,'GP_Cash_PodrRasp_DTB'      ,false) DTB:=date(1,MonthRas,YearRas);
  if not ReadMyDsk(DTE       ,'GP_Cash_PodrRasp_DTE'      ,false) DTE:=date(Last_day(DTB),MonthRas,YearRas);
  if not ReadMyDsk(wPeriod   ,'GP_Cash_PodrRasp_wPeriod'  ,false) wPeriod:=0;
  if not ReadMyDsk(DTAppl    ,'GP_Cash_PodrRasp_DTAppl'   ,false) DTAppl:=Cur_Date;//Дата заявки
  if not ReadMyDsk(sNumVed   ,'GP_Cash_PodrRasp_sNumVed'  ,false) sNumVed:='001';

  Marker_SbBan  :=InitMarker('GP_Cash_PodrRasp_SbBan'  , 8, 50, 10, True);
  Marker_PlatVed:=InitMarker('GP_Cash_PodrRasp_PlatVed', 8, 50, 10, True);
} //Procedure SaveParam;


#undef GP_Cash_PodrRasp_NPP
#declare GP_Cash_PodrRasp_NPP
    ,CASE WHEN COALESCE(KATPODR.Name,'''')='Ветераны' THEN 12 ELSE
       CASE PLATVED.PREFIX
       WHEN  '0$Z'  THEN 1 // на выдачу зарплаты
       WHEN  '0$ZM'	THEN 1 // на выдачу зарплаты
       WHEN  '0$A'	THEN 1 // на выдачу аванса
       WHEN  '0$D'	THEN 0 // ежемесячных пособий
       WHEN  '0$M'	THEN 0 //	ежемесячных пособий
       WHEN  '0$RD'	THEN 0 //	единовременных пособий
       WHEN  '0$V'	THEN 0 //	начислений и выплат
       WHEN  '0$U'	THEN 0 //	удержаний и выплат
       WHEN  '0#Z'	THEN 9 //	зарплаты по договорам
       WHEN  '0#A'	THEN 9 //	аванса по договорам
       WHEN  '0$O'	THEN 2 //	выплаты отпускных
       WHEN  '0$P'	THEN 0 //	премии с учетом КТУ
       WHEN  '0$AL'	THEN 8 //	выплаты алиментов
       WHEN  '0$B'	THEN 0 //	больничных листов
       WHEN  'VMp'	THEN 0 //	выплат межпериода
       WHEN  '0$PS'	THEN 5 //	подотчетных сумм
       WHEN  '000'  THEN 12 //		прочие
       ELSE 0 END END   //   :word
#end

#undef GP_Cash_PodrRasp_NameB
//  /SubString(

#declare GP_Cash_PodrRasp_NameB
  SubString(CASE  when COALESCE(KatPodr.Kod,' ')='446' then ' КЛИН'
          when COALESCE(GR_KatOrg.Name,' ')='Индивидуальный счет'            THEN 'Индивидуальный счет'
          when COALESCE(GR_KatOrg.Name,' ')='Индивидуальный (зарплатный)'    THEN 'Индивидуальный счет'
          when COALESCE(GR_KatOrg.Name,' ')='1. Индивидуальный (зарплатный)' THEN 'Индивидуальный счет'
          when InStr('РОСБАНК',UPPER(KatBank.Name),1)>0  then ' Банк "РОСБАНК" (ПАО)'
          when InStr('ГАЗПРОМ',UPPER(KatBank.Name),1)>0
            or InStr(' ГПБ',UPPER(KatBank.Name),1)>0
            or InStr('ГАЗПРОМ',UPPER(SbBan.Name),1)>0
             then ' Банк "ГАЗПРОМБАНК" (АО)' //"АО "Газпромбанк""
          when InStr('СБЕРБАНК',UPPER(KatBank.Name),1)>0 then ' Банк "СБЕРБАНК" (ПАО)'
          else 'Индивидуальный счет' END,1,150)
#end
//,1,150)

//------------------------------------
// Сбор данных
//------------------------------------
Function SborData:boolean;
var pUserId:comp;
    pUserName:string;
    wErr:longint;
{ Result:=false;
  pUserId  :=UserID();
  pUserName:=UserName();
  //Платежные ведомости
  _Try
  { SQL select
     'Касса НПО' as  Name
     ,SubString(KatPodr.Kod,1,3) as Podr_Kod
     ,SPPLVED.SUMUD  as SumNeed // "Требуемая выплата"
     ,SubString(SPPLVED.StrTabn,1,50) as StrTabn
     ,1              as PA //Pa      :word "1- ведомости, 0 реестры d"
     ,SubString(Persons.Fio,1,50) as fio
     ,SPPLVED.VidUD  as VidUD
     ,SPPLVED.VidOpl as VidOpl
     ,SubString(PlatVed.Prefix,1,50) as Prefix
    From PlatVed
    inner join SPPLVED on SPPLVED.CPLATVED = PlatVed.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLVED.cLsch
    inner join Persons on Persons.Nrec = SPPLVED.tPerson
    left outer join KatPodr on KatPodr.Nrec = SPPLVED.cex
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    where
        PLATVED.DFORM>=:(DTB)
    and PLATVED.DFORM<=:(DTE)
    // case не получилось собрать
    and (

          (:(wPeriod)=0 and PlatVed.Prefix='0$A')
       or (:(wPeriod)=1 and PlatVed.Prefix='0$Z')
       or (:(wPeriod)=2 and PlatVed.Prefix<>'0$A')// and PlatVed.Prefix<>'0$Z')
       or (:(wPeriod)=3)
       )
    and (ZU.POdrShare <> '+' or
      ( SPPLVED.cex in
         (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME)
      )
      )
    into tmp_prn_cash;
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса 001 '+ExploreException);
  }
  _finally
  {
  }
  Result:=true;
  timelog('отобрали в 001 '+string(RecordsInTable(#tmp_prn_cash)));
  //-------------------------------------------
  // Реестры
  //-------------------------------------------
  _try
  {
    var hStrFilter:longint;
    var Q: IQuery New;
    hStrFilter:=0;
    Q:=queryManager.createQuery(SQLQuery(
    Select
      #GP_Cash_PodrRasp_NameB     as  Name    //1   :string "Наименование банка/выплаты"
     ,SubString(KatPodr.Kod,1,3)  as Podr_Kod //2
     ,SPPLBAN.SUMOPL              as SumNeed  //3 "Требуемая выплата"
     ,SubString(SPPLBAN.StrTabn,1,50)    as StrTabn  //4
     ,0                           as PA       //5 Pa      :word "1- ведомости, 0 реестры d"
     ,SubString(Persons.Fio,1,50) as FIO      //6
     ,SPPLBAN.VidUd  as VidUd                 //7 :word
     ,SPPLBAN.VidOpl as VidOpl                //8 :word
     ,SubString(sbban.prefix,1,50) as Prefix                //9 :string
    From SbBan
    inner join KatBank on KatBank.Nrec   = SbBan.cBankPol
    inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
    inner join Persons on Persons.Nrec = SPPLBAN.tPerson
    inner join KatPodr on KatPodr.Nrec = Lschet.Cex // SPPLBAN.CEX пустой!
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    Left Outer join (select Descriptors.cRec, Min(Groups.Name) as Name
      from KatOrgDescr Descriptors
      Left Outer join  KatOrgDescr Groups on Groups.NRec = Descriptors.cGroup
      group by Descriptors.cRec
      ) GR_KatOrg   on GR_KatOrg.cRec = SbBan.cPol
    where
    //    SbBan.DATOK>=:(DTB) //дата выплаты
    //and SbBan.DATOK<=:(DTE) //дата выплаты
        SbBan.DForm>=:(DTB) //дата выплаты
    and SbBan.DForm<=:(DTE) //дата выплаты
    %Filter_Prefix
    /*
    and ( (:(wPeriod)=0 and SbBan.Prefix='R$A')
       or (:(wPeriod)=1 and SbBan.Prefix='R$Z')
       or (:(wPeriod)=2 and SbBan.Prefix<>'R$A' and SbBan.Prefix<>'R$Z')
       or (:(wPeriod)=3)
       )
    */
    and SBBAN.VidUd<>182 and SBBAN.vidud<>183 and SBBAN.vidud<>184 // не подоходный
    //17.01.2017
    //3. В выборке данных не должны участвовать реестра с типом "ДОГП" - по договорам подряда.
    and SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A'
    // Не фот
    and SBBAN.Prefix<>'S$'
     %Filter
    and (ZU.POdrShare <> '+'
      or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    )); //queryManager.createQuery(SQLQuery(
    if IsBitCTW(wFilter,1)
    { sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker('and SbBan.Nrec ',Marker_SbBan));
      timelog('GP_Cash_PodrRasp->SborData:фильтр по реестрам hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    {
      Q.setMacro('Filter',hStrFilter);
      sqlFreeStr(hStrFilter);
    }
    case wPeriod of
    0: Q.setMacro('Filter_Prefix',' and SbBan.Prefix=''R$A'' ');
    1: Q.setMacro('Filter_Prefix',' and SbBan.Prefix=''R$Z'' and SbBan.CNODE=#comp(0) ');
    2:
     if DTB<date(1,3,2018)
      Q.setMacro('Filter_Prefix',' and SbBan.Prefix<>''R$A''  ');
     else
      Q.setMacro('Filter_Prefix',' and SbBan.Prefix<>''R$A'' and (SbBan.Prefix<>''R$Z'' or SbBan.CNODE<>#comp(0) ) ');
    3: Q.setMacro('Filter_Prefix',' ');
    end;
    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса при отборе значений 2 ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,tnTmp_prn_cash,true);
      if wErr=30003
      { message('Обнаружена ошибка при отборе данных по реестрам'
           +chr(13)+'Закройте все окна и повторите запуск')

      }
      Timelog(' wErr ='+wErr+', отобрали '+RecordsInTable(tnTmp_prn_cash));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса 001 '+ExploreException);
  }
  _finally
  {
  }
  timelog('отобрали в 002 '+string(RecordsInTable(#tmp_prn_cash)));

} //Function SborData:boolean;


//------------------------------------
// Сбор данных
//------------------------------------
Function SborData02:boolean;
var pUserId:comp;
    pUserName:string;
    wErr:longint;
{ Result:=false;
  pUserId  :=UserID();
  pUserName:=UserName();
  //Платежные ведомости
  _Try
  { SQL select
      'Касса НПО'  as  Name
     ,SubString(KatPodr.Kod,1,3)         as Podr_Kod
     ,sum(SPPLVED.SUMUD) as SumNeed // "Требуемая выплата"
     ,'' as StrTabn
     ,1  as PA //Pa      :word "1- ведомости, 0 реестры d"
     ,'' as Fio //Persons.Fio as fio
     ,0  as VidUD // SPPLVED.VidUD
     ,0  as VidOpl // SPPLVED.VidUD
     ,'' as Perfix // PlatVed.Prefix
    From PlatVed
    inner join SPPLVED on SPPLVED.CPLATVED = PlatVed.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLVED.cLsch
    inner join Persons on Persons.Nrec = SPPLVED.tPerson
    left outer join KatPodr on KatPodr.Nrec = SPPLVED.cex
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    where
        PLATVED.DFORM>=:(DTB)
    and PLATVED.DFORM<=:(DTE)
    and ( (:(wPeriod)=0 and PlatVed.Prefix='0$A')
       or (:(wPeriod)=1 and PlatVed.Prefix='0$Z')
       or (:(wPeriod)=2 and PlatVed.Prefix<>'0$A')// and PlatVed.Prefix<>'0$Z')
       or (:(wPeriod)=3)
       )
    and (ZU.POdrShare <> '+' or
      ( SPPLVED.cex in
         (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME)
      )
      )
    Group by
     SubString(KatPodr.Kod,1,3)
    into tmp_prn_cash02;
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса 001 '+ExploreException);
  }
  _finally
  {
  }
  Result:=true;
  timelog('отобрали в 001 '+string(RecordsInTable(#tmp_prn_cash)));

  //-------------------------------------------
  // Реестры
  //-------------------------------------------
  _try
  {
    var hStrFilter:longint;
    var Q: IQuery New;
    hStrFilter:=0;
    Q:=queryManager.createQuery(SQLQuery(
    Select
      #GP_Cash_PodrRasp_NameB as Name //1   :string "Наименование банка/выплаты"
     ,SubString(KatPodr.Kod,1,3)    as Podr_Kod //2
     ,Sum(SPPLBAN.SUMOPL)        as SumNeed //3 "Требуемая выплата"
     ,'' as StrTabn // SPPLBAN.StrTabn         //4
     ,0  as PA //5 Pa      :word "1- ведомости, 0 реестры d"
     ,'' as FIO //6 Persons.Fio
     ,0  as VidUd //7 :word SPPLBAN.VidUd
     ,0  as VidOpl //8 :word
     ,'' as Prefix  //9 :word
    From SbBan
    inner join KatBank on KatBank.Nrec   = SbBan.cBankPol
    inner join SPPLBAN on SPPLBAN.CSBBAN = SbBan.Nrec
    inner join Lschet  on Lschet.Nrec  = SPPLBAN.cLsch
    inner join Persons on Persons.Nrec = SPPLBAN.tPerson
    inner join KatPodr on KatPodr.Nrec = Lschet.Cex // SPPLBAN.CEX пустой!
    inner join ZAR_USER ZU on (upper(ZU.OWNNAME) = upper(:(PUserName)))
    Left Outer join (select Descriptors.cRec, Min(Groups.Name) as Name
      from KatOrgDescr Descriptors
      Left Outer join  KatOrgDescr Groups on Groups.NRec = Descriptors.cGroup
      group by Descriptors.cRec
      ) GR_KatOrg   on GR_KatOrg.cRec = SbBan.cPol
    where
    //    SbBan.DATOK>=:(DTB) //дата выплаты
    //and SbBan.DATOK<=:(DTE) //дата выплаты
        SbBan.DForm>=:(DTB) //дата выплаты
    and SbBan.DForm<=:(DTE) //дата выплаты
    and SBBAN.VidUd<>182 and SBBAN.vidud<>183 and SBBAN.vidud<>184 // не подоходный
    %Filter02_Prefix
    /*
    and ( (:(wPeriod)=0 and SbBan.Prefix='R$A')
       or (:(wPeriod)=1 and SbBan.Prefix='R$Z')
       or (:(wPeriod)=2 and SbBan.Prefix<>'R$A' and SbBan.Prefix<>'R$Z')
       or (:(wPeriod)=3)
       )
     */
    //17.01.2017
    //3. В выборке данных не должны участвовать реестра с типом "ДОГП" - по договорам подряда.
    and SBBAN.Prefix<>'R#Z' and SBBAN.Prefix<>'R#A'
    // Не фот
    and SBBAN.Prefix<>'S$'
     %Filter02
    and (ZU.POdrShare <> '+'
      or (Lschet.cex in (Select UR.crecds from USERRIGHTS UR  where ZU.OWNNAME = UR.OWNNAME ) )
      )
    Group by
      SubString(KatPodr.Kod,1,3)  //1   :string "Наименование банка/выплаты"
     ,#GP_Cash_PodrRasp_NameB //2

    )); //queryManager.createQuery(SQLQuery(
    if IsBitCTW(wFilter,1)
    { sqlAddStr(hStrFilter,iQBuilder.MakeCriteriaFromMarker('and SbBan.Nrec ',Marker_SbBan));
      timelog('GP_Cash_PodrRasp->SborData:фильтр по реестрам hStrFilter='+string(hStrFilter)+','+GetMarkerCount(Marker_SbBan));

    }
    if (hStrFilter<>0)
    {
      Q.setMacro('Filter02',hStrFilter);
      sqlFreeStr(hStrFilter);
    }
    case wPeriod of
    0: Q.setMacro('Filter02_Prefix',' and SbBan.Prefix=''R$A'' ');
    1: Q.setMacro('Filter02_Prefix',' and SbBan.Prefix=''R$Z'' and SbBan.CNODE=#comp(0) ');
    2:
     if DTB<date(1,3,2018)
      Q.setMacro('Filter02_Prefix',' and SbBan.Prefix<>''R$A''  ');
     else
      Q.setMacro('Filter02_Prefix',' and SbBan.Prefix<>''R$A'' and (SbBan.Prefix<>''R$Z'' or SbBan.CNODE<>#comp(0) ) ');
    3: Q.setMacro('Filter02_Prefix',' ');
    end;

    if (Q.Execute.ErrorCode<>0)
       message('Ошибка выполнения DSQL запроса при отборе значений 2 ('+string(Q.ErrorCode)+').',error)
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_prn_cash02,true);
      if wErr=30003
      { message('Обнаружена ошибка при отборе данных по реестрам'
           +chr(13)+'Закройте все окна и повторите запуск')

      }
      Timelog(' wErr ='+wErr+', отобрали '+RecordsInTable(tnTmp_prn_cash));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса 001 '+ExploreException);
  }
  _finally
  {
  }
  timelog('отобрали в 002 '+string(RecordsInTable(#tmp_prn_cash)));

} //Function SborData02:boolean;


//------------------------------------
//получить краткое название месяца
//------------------------------------
Function GetShotMon(ww_str:string):string;
{ Result:=ww_str;

  if Length(ww_str)<6 exit;
  case ww_str of
  'январь'   : Result:='янв.';
  'февраль'  : Result:='фев.';
  'апрель'   : Result:='апр.';
  'август'   : Result:='авг.';
  'сентябрь' : Result:='сент.';
  'октябрь'  : Result:='окт.';
  'ноябрь'   : Result:='ноябрь';
  'декабрь'  : Result:='дек.';
  end;

} //Function GetShotMon(ww_str:string):string;


Function MyRound(w:double):double;
{ //Result:=Round(w+0.49,0);
  Result:=Round(w,2);
}
//--------------------------------
// получить наименование периода
//--------------------------------
Function GetPeriodName:string;
{ Result:=case(wperiod;0:'за 1 половину ',1:'за 2 половину ',2:'межпериод ',3:'за период ';'')
   +if(wPeriod=3,
     if(DTB=DTE,DateToStr(DTB,'DD.MM.YYYY')
                  ,'c '+DateToStr(DTB,'DD.MM.YYYY')+' по ' +DateToStr(DTE,'DD.MM.YYYY')
                 )
    ,DateToStr(DTAppl,'MM.YYYY'));
} //Function GetPeriodName:string;

DataStream DsCach_PodrRasp
( [Period] wPeriod;
  [Period_S] GetPeriodName;
  [DTAppl] DTAppl;
  [DTB] DTB;
  [DTE] DTE;


  Table tmp_prn_cash
  ( [Name    ]  tmp_prn_cash.Name;
    [Podr_Kod]  tmp_prn_cash.Podr_Kod;
    [SumNeed ]  tmp_prn_cash.SumNeed;
    [StrTabn ]  tmp_prn_cash.StrTabn;
    [Pa      ]  tmp_prn_cash.Pa;
    [Fio     ]  tmp_prn_cash.Fio;
    [Fio_IO  ]  MyGetInitial(tmp_prn_cash.Fio,True);
    [VidUd   ]  tmp_prn_cash.VidUd;
    [VidOpl  ]  tmp_prn_cash.VidOpl;
    [Prefix  ]  tmp_prn_cash.Prefix;
  );
)
end;

//------------------------------------
//Печать данных
//------------------------------------
Function PrintDoc:boolean;
var FReport: LongInt;
    ReportNames: array [0..0] of String;
#IFDEF _2019_02_13_
    ExportParam:String;
#ELSE
    ExportParam:frxPDFExportParam;
#ENDIF
{ Result:=True;
  var boPrintToPDF:boolean=false;
  if not boPrintToPDF
  { RunFReportByGroup(DsCach_PodrRasp,'CASHRASP');
  }
  else
  { FReport := FRCreate(DsCach_PodrRasp);
    FRGetReportNames(FReport, ReportNames);
    if (count(ReportNames)>0)
    { if (FROpenReport(FReport, ReportNames[0]))
      {
#IFDEF _2019_02_13_
      //'Pages=1-5;Picture=False;DeleteEmptyRows=True;OpenAfterExport=True'
      ExportParam:='ShowDialog=False;OpenAfterExport=True';
#ELSE
        ClearAdvRecord(ExportParam);
        FRGetDefaultParameters(frExportPDF, ExportParam);
        ExportParam.Pages:='';
        ExportParam.ShowDialog := False;
        ExportParam.OpenAfterExport := True;
#ENDIF
        if (FRSetParameters(FReport, frExportPDF, ExportParam))
         FRExportReport(FReport, frExportPDF, '');
      } //if (FROpenReport(FReport, ReportNames[0]))
    }
    else
    { Result:=false;
    }
    FRDestroy(FReport);
  } //else if not boPrintToPDF
} //Function PrintDoc:boolean;


