   <.~С~формировать.>        <.   ~О~тмена   .>
>>
end; //scrParam 'Параметры формирования' (,,sci1Esc), Cyan;

//--------------------------------------------
// Обработчик событий интерфейса
//--------------------------------------------
HandleEvent
cmInit:
{ TimeLog_Init;
  TimeLog('GP_Cash_PodrRasp->cmInit');
  sUserName:=UserName();
  ReadParam;
  Case wTypeRep of
  1:
  { SetFormat(scrParam);
    SetTitle('Распределение выплат по подразделениям');
  }
  2:
  { SetFormat(scrParam02);
    SetTitle('Сводная ведомость выплат по подразделениям');
  }
  end;
  SetFilterNm(0);
  //cat_main_M11:=iCatFunc.GetCatalogsNRec(-11);
  vSpr.cat_main_M11:=0;
  if vSpr.getfirst catalogs where (( -11 == Catalogs.SysCode ))=tsok
  { var _Pnrec:comp=vSpr.Catalogs.Nrec;
    set vSpr.cat_main_M11:=_pNrec;
  }
  sFioZGD:='';
  if vSpr.getfirst catalogs<>tsok
  { message('Не найдено подразделение с кодом 506'
     +chr(13)+'Заместитель генерального директора по экономике и финансам'
    );
  }
  TimeLog('GP_Cash_PodrRasp->cmInit:finish cat_main_M11='+string(vSpr.cat_main_M11,0,0));
  ReScanPanel(#Zar_user);
}

cmCheckField:
{ case CurField of
  #DTB:
  { if DTB>DTE
    { message('Дата окончания не может быть'
           + chr(13)+'меньше даты начала');
      DTE:=DTB;
      MyCheckPeriod;
    }
  }
  #DTE:
  { if DTB>DTE
    { message('Дата начала не может быть'
           + chr(13)+'больше даты окончания');
      DTB:=DTE;
    }
    MyCheckPeriod;
  }
  end;
}
cmDone:
{ SaveParam;
}

cmPick:
{
   case CurField of
   #Filtr_SbBan:
   {  StoreMarker(Marker_SbBan,'VedRees_Marker');
      var MO: IModeOptions(DefinedModeOptions);
      MO.SetFlags(0, vfMultipleSelection);
      if RunInterface('GP_ViewReesCombo', MO,DTB,DTE,True)<>cmCancel
      { Marker_SbBan := InitMarker('VedRees_Marker', 8, 200, 7);
        SetFilterNM(#Filtr_SbBan)
      }
   }
   #Filtr_PlatVed:
   {
     SetFilterNM(#Filtr_PlatVed)

   }
   end;//case CurField of
} //cmPick:

cmDelOnProtect:
{  case CurField of
   #Filtr_SbBan:
   { ClearMarker(Marker_SbBan);
     SetFilterNM(#Filtr_SbBan)
   }
   #Filtr_PlatVed:
   { ClearMarker(Marker_PlatVed);
     SetFilterNM(#Filtr_PlatVed)
   }
   end;
} //cmDelOnProtect:

cmOk:
{  StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Подготовка данных для отчета',0);
   if not FormDoc then message('Ошибки при формировании');
   StopVisual('',0);
   //CloseInterFace(cmDone);
}
end;
end.
