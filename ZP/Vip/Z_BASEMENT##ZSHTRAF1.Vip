#component "Z_BASEMENT"
#doc
Постоянные удержания
<p>#2033 вывести в интерфейсе удержаний поле таблицы SHTRAF.NAMEPL2.
<p>#2154 в/у 233,234 (два пользовательских, в обои вывести),236,237,244)
#end
//------------------------------------------------------------------------------
Alter Interface ZSHTRAF1 ;
//------------------------------------------------------------------------------
OverLoad
procedure SetupTransferChargePayeeFields;
end;
//------------------------------------------------------------------------------
//ExtendFormats SHTRAF3;  - не надо
//------------------------------------------------------------------------------
//'Z_BASEMENT::ZSHTRAF1.MAINWINDOWBLANK.SHTRAF3.PAYMENTPURPOSESTR1'

procedure SetupTransferChargePayeeFields;
{ Inherited::SetupTransferChargePayeeFields;
  case KLVIDUD.VIDUD of
  //#2033
   187//232 Удержания алиментов в банк
  //#2154
  ,33 //233 Штрафы по решению муницип. комиссии
  ,189//234 Исполнительные листы в пользу государства
  ,204//234 Штрафы по решению муниципальной комиссии
  ,206//236 Перечисление в банк физическим лицам
  ,12 //237 Подарки детям сотрудников
  ,24 //244 Удержание штрафов ГИБДД
  :
  {
#IFDEF _2018_12_14_
    SetFieldState(#TransferChargePurposeStr, sfVisible);
    ShowLabel4Field(#TransferChargePurposeStr);
#ELSE
    SetFieldState(#PaymentPurposeStr2, sfVisible);
    ShowLabel4Field(#PaymentPurposeStr2);
#ENDIF
  }
  end;
} //procedure SetupTransferChargePayeeFields;

//**************************************
  ExtendFormats SHTRAFBrowse;
  browse SHTRAFBrowse 'удержания' (, hcshtraf, sci1478EscInsC8);
  //  show at (,3,,18);
    table SHTRAF;
    fields
//      {Font={Color=if(RetentionMarkerStr <> '', ColorMark, 0)}};
      NAMEXTRKAU 'Дополнительная','аналитика' :[20],Protect,NoDel;
  end; //browse SHTRAFBrowse
//**************************************
  ExtendFormats Retentions;
  browse Retentions 'удержания' (, hcshtraf, sci1478EscIns);
  //  show at (,3,,18);
    table SHTRAF;
    fields
//      {Font={Color=if(RetentionMarkerStr <> '', ColorMark, 0)}};
      NAMEXTRKAU 'Дополнительная','аналитика' :[20],Protect,NoDel;
  end; //browse Retentions

end.
