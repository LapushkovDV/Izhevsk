/*************************************************************************************************\
* Наименование: Производственные календари                                                        *
* Контур/Модуль: Заработная плата                                                                 *
* Пункт меню: Настройка / НПО Энергомаш / Среднемесячные нормы рабочего времени                   *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#761          |22/09/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

interface GP_PrCalendars 'Производственные календари' cyan;
  show at (,, 91, 20);

  create view
    from
      GP_PrCal (GP_PrCal02);

  var 
    pPickMode: Word; // cgiNo(0) - просмотр, cgiPick(1) - выбор
    pcCurRec: tNRec; // NRec выбранной записи
    IsEditMode: Boolean;

  parameters 
    pPickMode, // cgiNo(0) - просмотр, cgiPick(1) - выбор
    pcCurRec; // NRec выбранной записи

  browse brGP_PrCal (, hcNoContext);
    table GP_PrCal;
  fields          
    GP_PrCal.Code 'Код': [20], noAutoSize;
    GP_PrCal.Name 'Наименование': [50];
    GP_PrCal.WeekLength 'Продолжительность', 'рабочей недели': [19], noAutoSize;
  end;

  procedure SwitchEditMode(pEditMode: Boolean);
  begin
    IsEditMode := pEditMode;
    ToggleFieldProtected(#GP_PrCal.Code, not IsEditMode);
    ToggleFieldProtected(#GP_PrCal.Name, not IsEditMode);
    ToggleFieldProtected(#GP_PrCal.WeekLength, not IsEditMode);
    if IsEditMode then
    begin
      // Включение режима редактирования
      SetInterfaceOptions(opEscClose);
      SetHelpAndStatusContext(brGP_PrCal, -1, sci1478Esc, hcKeepCurrent);
      DisableCommand(cmDefault);
      DisableCommand(cmEdit);
      EnableCommand(cmInsert);
      EnableCommand(cmDelete);
    end else
    begin
      // Выключение режима редактирования
      SetInterfaceOptions(opEscClose or opCyanInterface or opDoAccept);
      SetHelpAndStatusContext(brGP_PrCal, -1, if(pPickMode = cgiNo, sci1478Esc, sci1478EnEsc), hcKeepCurrent);
      EnableCommand(cmDefault);
      EnableCommand(cmEdit);
      DisableCommand(cmInsert);
      DisableCommand(cmDelete);
    end;
    RescanPanel(CurTable);
  end;

  handleEvent
    cmInit:
      begin
        if pcCurRec != 0 then
          if getfirst GP_PrCal where ((pcCurRec == GP_PrCal.NRec)) != tsOk then
            if getfirst GP_PrCal = tsOk then
            begin
            end;
        SwitchEditMode(False);
      end;
    cmInsertRecord:
      insert current GP_PrCal;
    cmUpdateRecord:
      update current GP_PrCal;
    cmDeleterecord:
      if Message('Удалить текущую запись?', YesNo) = Yes then
        delete current GP_PrCal;
    cmEdit:
      if not IsEditMode then
        SwitchEditMode(True);
    cmCancel:
      if IsEditMode then
      begin
        SwitchEditMode(False);
        abort;
      end;
    cmDefault:
      if IsEditMode or pPickMode = cgiNo then
        abort
      else
        if not IsValid(tnGP_PrCal) then
          abort
        else
          pcCurRec := GP_PrCal.nRec;
  end;

end.
