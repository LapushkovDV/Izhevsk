#include ZarNachislUder.vih
#include ExtAttr.Vih
//#include ExpRList.vih
#component "z_zar"


vipinterface ZarNachislUderParam_ValGRMnPlan implements IZarNachislUderParam //IZarNachislUder
#ifdef ATL51
licensed (Free)
#end
;


//vipinterface*****************************************************************
Interface ZarNachislUderParam_ValGrMnPlan '' EscClose;
const
  cont_kau_MnPlan = 7;
end;
create view ValMnPlan
  var
  columnName:string;
  NrecTab   :longint;
  pnrec :comp ;
  w_type :word;
  wc_spkau:comp;
as select  Nachisl.nrec
from NACHISL ,Sumvidop
 ,PerevodTek , Perevod
 ,MnPlan,vPlan
where ((
     pnrec ==Nachisl.nrec
and  pnrec ==Sumvidop.nrec
and  pnrec ==Perevod.nrec
and  pnrec ==PerevodTek.nrec
and  wc_spkau == MnPlan.Nrec
and  MnPlan.cvPlan == vPlan.Nrec
)) ;

function GetValue(ParNrec : comp; NumbTable :longint ):string;
var ii:word;

{
  GetValue := '';
  wc_spkau:=0;
  set pnrec := ParNrec ;
  case NumbTable of
  coNachisl:
  { if getfirst fastfirstrow Nachisl  = tsOk
    { for(ii:=1;ii<=6;ii++)
       if Nachisl.tbld[ii]=cont_kau_MnPlan
       { wc_spkau:=Nachisl.CKAUD[ii] ;
         break;
       }
    }
  }
  coSumvidop:
  { if getfirst fastfirstrow Sumvidop  = tsOk
    { for(ii:=1;ii<=6;ii++)
       if Sumvidop.tbld[ii]=cont_kau_MnPlan
       { wc_spkau:=Sumvidop.CKAUD[ii];
         break;
       }
    }
  }
  coPerevod:
  { if getfirst fastfirstrow Perevod  = tsOk
    { for(ii:=1;ii<=6;ii++)
       if Perevod.tbld[ii]=cont_kau_MnPlan
       { wc_spkau:=Perevod.CKAUD[ii] ;
         break;
       }
    }
  }
  coPerevodTek:
  { if getfirst fastfirstrow PerevodTek  = tsOk
    { for(ii:=1;ii<=6;ii++)
       if PerevodTek.tbld[ii]=cont_kau_MnPlan
       { wc_spkau:=PerevodTek.CKAUD[ii] ;
         break;
       }
    }
  }
  else exit;
  end ;
  //if getfirst fastfirstrow spkau=0     GetValue:=spkau.name;
  if w_type=0
  { Result:='Прочие заказы';
    if getfirst Mnplan=tsok
      if getfirst vPlan=tsok
         Result:=' '+vPlan.Name
  }
  else
  { if getfirst Mnplan=tsok
      if getfirst vPlan=tsok
          Result:=string(vPlan.Nrec)
  }

}

function GetColName: string;
{
  GetColName := 'Группа Заказа';
}

function GetDescription: string;
{
  GetDescription := 'Получить наименование группы заказа' ;
}
#doc
устанавливает параметры
#end
procedure SetParameter(cParameter: comp; wParameter : word; sParameter : string);
{   w_type:=wParameter;

}
#doc
функция возвращает строку с параметрами для отображения в интерфейсе
#end
function GetParamStr : string;
{ //GetParamStr :='тип '+string(w_type);
  GetParamStr :='Заказ';
}
#doc
интерфейс для редактирования параметров(например выбор вида аналитики)
#end
Function EditParameters : word;
{ EditParameters:=0
}

  HandleEvent
  cmInit: { // Abort;
  }
  cmOnVipLoad:
  { w_type:=0;
  }
  end;
end.
