#include ZarNachislUder.vih
#include ExtAttr.Vih
//#include ExpRList.vih
#component "z_zar"




vipinterface ZarNachislUderParam_ValSTAGE implements IZarNachislUderParam
#ifdef ATL51
licensed (Free)
#end
;

//vipinterface*****************************************************************
interface ZarNachislUderParam_ValSTAGE '' EscClose;
create view ValNAZNA
  var
  columnName:string;
  NrecTab   :longint;
  pnrec :comp ;
  wc_lsch: comp;
  w_dtb :date;
  wc_staff:comp;
  KodAnStage:longint;// Zakaz
  
  wc_spkau:comp;
as select  Nachisl.nrec
from NACHISL ,Sumvidop 
 ,PerevodTek , Perevod   ,SPKAU 
where (( 
     pnrec ==Nachisl.nrec
and  pnrec ==Sumvidop.nrec
and  pnrec ==Perevod.nrec
and  pnrec ==PerevodTek.nrec
and  wc_spkau == SPKAU.Nrec 
and 0  == KatKau.ISACTIVE
and 0  == KatKau.PARAMKAU
and 'Этапы заказов' == KatKau.Name

)) ; 

function GetValue(ParNrec : comp; NumbTable :longint ):string;
var ii:word;

{
  GetValue := '';
  wc_spkau:=0;
  if KodAnStage=0 then Exit;
  set pnrec := ParNrec ;
  case NumbTable of
  coNachisl:  
  { if getfirst fastfirstrow Nachisl  = tsOk
    { for(ii:=1;ii<=6;ii++)
       if Nachisl.tbld[ii]=KodAnStage 
       { wc_spkau:=Nachisl.CKAUD[ii] ;
         break;
       }
    }
  }  
  coSumvidop:  
  { if getfirst fastfirstrow Sumvidop  = tsOk
    { for(ii:=1;ii<=6;ii++)
       if Sumvidop.tbld[ii]=KodAnStage 
       { wc_spkau:=Sumvidop.CKAUD[ii];
         break;
       }
    }
  }  
  coPerevod:  
  { if getfirst fastfirstrow Perevod  = tsOk
    { for(ii:=1;ii<=6;ii++)
       if Perevod.tbld[ii]=KodAnStage 
       { wc_spkau:=Perevod.CKAUD[ii] ;
         break;
       }
    }
  }  
  coPerevodTek:  
  { if getfirst fastfirstrow PerevodTek  = tsOk
    { for(ii:=1;ii<=6;ii++)
       if PerevodTek.tbld[ii]=KodAnStage 
       { wc_spkau:=PerevodTek.CKAUD[ii];
         break;
       }
    }
  }  
  else exit;
  end ;
  if getfirst fastfirstrow spkau=0
     GetValue:=spkau.Code;      
}

function GetColName: string;
{
  GetColName := 'Этап заказа';
}

function GetDescription: string;
{
  GetDescription := 'Получить этап заказа' ;
}
#doc
устанавливает параметры
#end
procedure SetParameter(cParameter: comp; wParameter : word; sParameter : string);
{
}

#doc
функция возвращает строку с параметрами для отображения в интерфейсе
#end
function GetParamStr : string;
{ GetParamStr:=''
}
#doc
интерфейс для редактирования параметров(например выбор вида аналитики)
#end
Function EditParameters : word;
{  EditParameters:=0
}

HandleEvent
cmInit: Abort;
end;
HandleEvent
cmOnVipLoad:
{ KodAnStage:=0;
  if getfirst katkau=0
    KodAnStage:=katkau.kodgroup;
}
end;  
end.

