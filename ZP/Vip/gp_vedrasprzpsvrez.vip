Procedure CreateTmpFlt();
{
  var objQuery: iQuery;
  var strID   : LongInt;

  strID := 0;
  sqlFreeStr(strID);

  StartNewVisual(vtRotateVisual, vfTimer, 'Работа с фильтром', 0);

  MysqlAddStr(strID, ' table tmpFlt');
  MysqlAddStr(strID, ' (                      ');
  MysqlAddStr(strID, '     wKau : word        ');
  MysqlAddStr(strID, '   , cRec : comp        ');
  MysqlAddStr(strID, ' )                      ');
  MysqlAddStr(strID, ' with index             ');
  MysqlAddStr(strID, ' (                      ');
  MysqlAddStr(strID, '     i01 = cRec         ');
  MysqlAddStr(strID, ' );                     ');

  sqlDropTmpTable('tmpFlt');

  if sqlCreateTmpTable(strID, ctmNormal) <> tsOk
  {
    Message('Ошибка (CreateTmpFlt)' + 'tmpFlt', error);
    StopVisual;
    Exit;
  }

  sqlFreeStr(strID);
  StopVisual;
}

Procedure DelPick(_w : word; _s : string);
{
  var objQuery: iQuery;
  var strID   : LongInt;

  sqlFreeStr(strID);
  strID := 0;

  StartNewVisual(vtRotateVisual, vfTimer, 'Очистка фильтра', 0);

  MysqlAddStr(strID, ' delete from ' + _s + ' where wKau = ' + string(_w));

  objQuery := queryManager.createQuery(strID);
  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('Ошибка ' + _s + ' (DelPick) ' + objQuery.errorCode,error);
    StopVisual;
    Exit;
  }
  StopVisual;
}

Procedure InsPick(_w : word; _s : string; _c : comp; _n : string);
{
  var objQuery: iQuery;
  var strID   : LongInt;

  sqlFreeStr(strID);
  strID := 0;

  MysqlAddStr(strID, ' insert ' + _s + ' (wKau, cRec)                                                                         ');
  MysqlAddStr(strID, ' select ' + string(_w) + ', #comp(' + string(_c) + ')                                                   ');
  MysqlAddStr(strID, ' where #comp(' + string(_c) + ') not in (select cRec from ' + _s + ' where wKau = ' + string(_w) + ' )  ');

  objQuery := queryManager.createQuery(strID);
  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('Ошибка ' + _s + ' (InsPick) ' + objQuery.errorCode,error);
    Exit;
  }
  sqlFreeStr(strID);
}

Procedure FillTables(_month: Word; _year: Word);
{
  var qStr : longint = 0;
  var oResultSet : IResultSet;
  var schet : string = if(_year < 2020, '320','020');
  var kauNumber : word = if(schet = '020', 3, 1);
  sqlFreeStr(qStr);

  MysqlAddStr(qStr, '  select                                                                                                                       ');
  MysqlAddStr(qStr, '    nachislzakaz.yearn                                                                                                         ');
  MysqlAddStr(qStr, '  , nachislzakaz.mesn                                                                                                          ');
  MysqlAddStr(qStr, '  , katpodr1.kod                                                                                                               ');
  MysqlAddStr(qStr, '  , nachislzakaz.vidopl                                                                                                        ');
  MysqlAddStr(qStr, '  , mnplan.number                                                                                                              ');
  MysqlAddStr(qStr, '  , buhschet.code                                                                                                              ');
  MysqlAddStr(qStr, '  , sum(case when (klvidopl.nalg = 98) then 0.0 else nachislzakaz.summa end)                                                   ');
  MysqlAddStr(qStr, '  , sum(case when nachislzakaz.vidopl in (1, 3, 5, 9, 10) then nachislzakaz.chasf else 0 end)                                  ');
  MysqlAddStr(qStr, '  , sum(p5.sumper)                                                                                                             ');
  MysqlAddStr(qStr, '  , sum(p2.sumper)                                                                                                             ');
  MysqlAddStr(qStr, '  , sum(p3.sumper)                                                                                                             ');
  MysqlAddStr(qStr, '  , sum(p8.sumper)                                                                                                             ');
  MysqlAddStr(qStr, '  , case when (coalesce(trf.s, 0.0) = 0.0) then 0.0 else sum(p13.sumper * trezfot.s / trf.s) end                                    ');                                                                   //fotrez
  MysqlAddStr(qStr, '  , case when (coalesce(trezfot.s, 0.0) = 0.0) then 0.0                                                                             ');
  MysqlAddStr(qStr, '          else case when (coalesce(trf.s, 0.0) = 0.0) then 0.0                                                                      ');
  MysqlAddStr(qStr, '                    else sum(p13.sumper * trezfot.s / trf.s)                                                                        ');
  MysqlAddStr(qStr, '               end * coalesce(trezstr.s, 0.0) / trezfot.s end                                                                       ');
  MysqlAddStr(qStr, '  , sum(coalesce(p11.sumper,0))+sum(coalesce(p12.sumper,0))                                                                         ');
  MysqlAddStr(qStr, '  from mnplan                                                                                                                 ');
  //MysqlAddStr(qStr, '  inner join tmpFlt on nachislzakaz.ckaud[1] = tmpFlt.cRec                                                                          ');
  MysqlAddStr(qStr, '  inner join nachislzakaz on mnplan.nrec = nachislzakaz.ckaud[1]                                                                    ');
  MysqlAddStr(qStr, '  left join klvidopl on nachislzakaz.vidopl = klvidopl.vidopl                                                                    ');
  MysqlAddStr(qStr, '  left join buhschet on buhschet.nrec = mnplan.canval2                                                                              ');
  MysqlAddStr(qStr, '  left join katpodr on katpodr.nrec = nachislzakaz.cexoz                                                                            ');
  MysqlAddStr(qStr, '  inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)                                                          ');
  MysqlAddStr(qStr, '  left join perevodtekzakaz p2 on p2.cnach = nachislzakaz.nrec and p2.mesn = nachislzakaz.mesn and p2.vidper =2                     ');
  MysqlAddStr(qStr, '  left join perevodtekzakaz p3 on p3.cnach = nachislzakaz.nrec and p3.mesn = nachislzakaz.mesn and p3.vidper =3                     ');
  MysqlAddStr(qStr, '  left join perevodtekzakaz p5 on p5.cnach = nachislzakaz.nrec and p5.mesn = nachislzakaz.mesn and p5.vidper =5                     ');
  MysqlAddStr(qStr, '  left join perevodtekzakaz p8 on p8.cnach = nachislzakaz.nrec and p8.mesn = nachislzakaz.mesn and p8.vidper =8                     ');
  MysqlAddStr(qStr, '  left join perevodtekzakaz p11 on p11.cnach = nachislzakaz.nrec and p11.mesn = nachislzakaz.mesn and p11.vidper =11                ');
  MysqlAddStr(qStr, '  left join perevodtekzakaz p12 on p12.cnach = nachislzakaz.nrec and p12.mesn = nachislzakaz.mesn and p12.vidper =12                ');
  MysqlAddStr(qStr, '  left join perevodtekzakaz p13 on p13.cnach = nachislzakaz.nrec and p13.mesn = nachislzakaz.mesn and p13.vidper =13                ');
  MysqlAddStr(qStr, '  left join perech per13 on per13.vidper = 13                                                                                       ');

  MysqlAddStr(qStr, ' outer apply (                                                                                                              ');
  MysqlAddStr(qStr, '   select                                                                                                                   ');
  MysqlAddStr(qStr, '     sum(p13.sumper) as s                                                                                                   ');
  MysqlAddStr(qStr, '   from nachislzakaz nz                                                                                                       ');
  MysqlAddStr(qStr, '   left join perevodtekzakaz p13 on p13.cnach = nz.nrec and p13.mesn = nz.mesn and p13.vidper = 13      ');
  MysqlAddStr(qStr, '   where nz.mesn = '+string(_month)+'                                                                              ');
  MysqlAddStr(qStr, '         and nz.yearn = '+string(_year)+'                                                                          ');
  MysqlAddStr(qStr, '         and nz.tbld[1] = 7                                                                                       ');
  MysqlAddStr(qStr, '         and nz.ckaud[1] = mnplan.nrec                                                                            ');
  MysqlAddStr(qStr, ' ) trf                                                                                                                      ');

  MysqlAddStr(qStr, ' outer apply (                                                                                                              ');
  MysqlAddStr(qStr, '   select                                                                                                                   ');
  MysqlAddStr(qStr, '       sum(oborot.sumob)                                                s                                                   ');
  MysqlAddStr(qStr, '   from oborot                                                                                                              ');
  MysqlAddStr(qStr, '   inner join spkau on oborot.kauks[2] = spkau.nrec                                                                         ');
  MysqlAddStr(qStr, '   where cast(substring(date2str(''%MM'', oborot.datob),1,2) as word) = '+_month+'                                           ');
  MysqlAddStr(qStr, '         and cast(substring(date2str(''%yyyy'', oborot.datob),1,4) as integer) = '+_year+'                                   ');
  MysqlAddStr(qStr, '         and oborot.scheto in (''020'', ''023'', ''025'', ''026'', ''029'')                                                 ');
  MysqlAddStr(qStr, '         and oborot.schetk = ''096''                                                                                        ');
  MysqlAddStr(qStr, '         and oborot.kauos[' + kauNumber + '] = mnplan.nrec                                                                  ');
  MysqlAddStr(qStr, '         and spkau.name = ''ФОТ''                                                                                           ');
  MysqlAddStr(qStr, ' ) trezfot                                                                                                                  ');

  MysqlAddStr(qStr, ' outer apply (                                                                                                              ');
  MysqlAddStr(qStr, '   select                                                                                                                   ');
  MysqlAddStr(qStr, '       sum(oborot.sumob)                                                s                                                   ');
  MysqlAddStr(qStr, '   from oborot                                                                                                              ');
  MysqlAddStr(qStr, '   inner join spkau on oborot.kauks[2] = spkau.nrec                                                                         ');
  MysqlAddStr(qStr, '   where cast(substring(date2str(''%MM'', oborot.datob),1,2) as word) = '+_month+'                                           ');
  MysqlAddStr(qStr, '         and cast(substring(date2str(''%yyyy'', oborot.datob),1,4) as integer) = '+_year+'                                   ');
  MysqlAddStr(qStr, '         and oborot.scheto in (''020'', ''023'', ''025'', ''026'', ''029'')                                                 ');
  MysqlAddStr(qStr, '         and oborot.schetk = ''096''                                                                                        ');
  MysqlAddStr(qStr, '         and oborot.kauos[' + kauNumber + '] = mnplan.nrec                                                                  ');
  MysqlAddStr(qStr, '         and spkau.name = ''Налоги на ФОТ''                                                                                 ');
  MysqlAddStr(qStr, ' ) trezstr                                                                                                                  ');

  MysqlAddStr(qStr, '  where     nachislzakaz.mesn = '+string(_month)+'                                                                           ');
  MysqlAddStr(qStr, '        and nachislzakaz.yearn = '+string(_year)+'                                                                           ');
  MysqlAddStr(qStr, '        and mnplan.nrec = #comp(' + string(tSelZakaz.cMnp) + ')                                                                           ');
//  MysqlAddStr(qStr, '        and nachislzakaz.vidopl <> 181     комментарий  в начале отчёта                                                                                   ');
//  MysqlAddStr(qStr, '        and mnplan.nrec in (select cRec from tmpFlt)                                                                           ');
  MysqlAddStr(qStr, '  group by nachislzakaz.yearn, nachislzakaz.mesn, katpodr1.kod, nachislzakaz.vidopl, mnplan.number, buhschet.code, per13.procper, trezfot.s, trf.s, trezstr.s        ');

  if string(_month)=4 and  string(_year)=2024
  {
    MysqlAddStr(qStr, ' union all    ');
    MysqlAddStr(qStr, 'select 2024,4,katpodr.kod,0,mnplan.number,buhschet.code,0,0,0,0,0,sum(oborot.sumob),0,0,0');
    MysqlAddStr(qStr, 'from oborot                                                      ');
    MysqlAddStr(qStr, 'left join mnplan on oborot.kauos[3]=mnplan.nrec                 ');
    MysqlAddStr(qStr, 'left join katpodr on oborot.kauos[1]=katpodr.nrec                ');
    MysqlAddStr(qStr, 'left join buhschet on buhschet.nrec = mnplan.canval2             ');
    MysqlAddStr(qStr, 'where oborot.nodok in (''001478'',''001479'',''001480'') and datob=#date(30,04,2024)');
    MysqlAddStr(qStr, 'and oborot.scheto in (''020'', ''023'', ''025'', ''026'', ''029'')      ');
    MysqlAddStr(qStr, '        and mnplan.nrec = #comp(' + string(tSelZakaz.cMnp) + ')       ');
    MysqlAddStr(qStr, 'group by katpodr.kod,mnplan.number,buhschet.code,mnplan.name ');
  }



  var q:IQuery = queryManager.createQuery(qStr);
  if q.execute.errorCode != 0
    Message('Ошибка выполнения запроса: ' + q.errorCode);
  else
    sqlCopyInto(q, tntab1, false);


   sqlFreeStr(qStr);
}

Procedure Fill_tSelZakaz();
{
  var qStr : longint = 0;
  var oResultSet : IResultSet;

  sqlFreeStr(qStr);

  MysqlAddStr(qStr, '  select                                          ');
  MysqlAddStr(qStr, '    mnplan.number, mnplan.nrec, 0.0, 0.0, 0.0     ');
  MysqlAddStr(qStr, '  , 0.0, 0.0, 0.0, 0.0                            ');
  MysqlAddStr(qStr, '  , 0.0, 0.0                                      ');
  MysqlAddStr(qStr, '  from tmpFlt                                     ');
  MysqlAddStr(qStr, '  inner join mnplan on tmpFlt.cRec = mnplan.nrec  ');
  MysqlAddStr(qStr, '  where wKau = 7                                  ');


  var q : IQuery = queryManager.createQuery(qStr);
  if (q.execute.errorCode != 0) then
  {
    Message('Ошибка выполнения запроса (Fill_tSelZakaz) : ' + q.errorCode);
  }
  else
  {
    sqlCopyInto(q, tntSelZakaz, false);
  }

  sqlFreeStr(qStr);
}

Procedure MakeItogs();
{
  _Loop tab1
  {
    if (GetFirst FastFirstRow tmpItogsMY where ((     tab1.zakaznum == tmpItogsMY.zakaznum
                                                  and tab1.fgod     == tmpItogsMY.fgod
                                                  and tab1.fmes     == tmpItogsMY.fmes      )) <> tsOk)
    {
      ClearBuffer(#tmpItogsMY);
        tmpItogsMY.fgod     := tab1.fgod;
        tmpItogsMY.fmes     := tab1.fmes;
        tmpItogsMY.zakaznum := tab1.zakaznum;
        tmpItogsMY.summa    := tab1.summa;
        tmpItogsMY.nch      := tab1.nch;
        tmpItogsMY.pfr      := tab1.pfr;
        tmpItogsMY.fss      := tab1.fss;
        tmpItogsMY.foms     := tab1.foms;
        tmpItogsMY.travm    := tab1.travm;
        tmpItogsMY.fotrez   := tab1.fotrez;
        tmpItogsMY.strahrez := tab1.strahrez;
        tmpItogsMY.travmrez := tab1.travmrez;
      Insert Current tmpItogsMY;
    }
    else
    {
      tmpItogsMY.summa    := tmpItogsMY.summa    + tab1.summa;
      tmpItogsMY.nch      := tmpItogsMY.nch      + tab1.nch;
      tmpItogsMY.pfr      := tmpItogsMY.pfr      + tab1.pfr;
      tmpItogsMY.fss      := tmpItogsMY.fss      + tab1.fss;
      tmpItogsMY.foms     := tmpItogsMY.foms     + tab1.foms;
      tmpItogsMY.travm    := tmpItogsMY.travm    + tab1.travm;
      tmpItogsMY.fotrez   := tmpItogsMY.fotrez   + tab1.fotrez;
      tmpItogsMY.strahrez := tmpItogsMY.strahrez + tab1.strahrez;
      tmpItogsMY.travmrez := tmpItogsMY.travmrez + tab1.travmrez;
      Update Current tmpItogsMY;
    }

    if (GetFirst FastFirstRow tmpItogsY where ((      tab1.zakaznum == tmpItogsY.zakaznum
                                                  and tab1.fgod     == tmpItogsY.fgod      )) <> tsOk)
    {
      ClearBuffer(#tmpItogsY);
        tmpItogsY.fgod     := tab1.fgod;
        tmpItogsY.zakaznum := tab1.zakaznum;
        tmpItogsY.summa    := tab1.summa;
        tmpItogsY.nch      := tab1.nch;
        tmpItogsY.pfr      := tab1.pfr;
        tmpItogsY.fss      := tab1.fss;
        tmpItogsY.foms     := tab1.foms;
        tmpItogsY.travm    := tab1.travm;
        tmpItogsY.fotrez   := tab1.fotrez;
        tmpItogsY.strahrez := tab1.strahrez;
        tmpItogsY.travmrez := tab1.travmrez;
      Insert Current tmpItogsY;
    }
    else
    {
      tmpItogsY.summa    := tmpItogsY.summa    + tab1.summa;
      tmpItogsY.nch      := tmpItogsY.nch      + tab1.nch;
      tmpItogsY.pfr      := tmpItogsY.pfr      + tab1.pfr;
      tmpItogsY.fss      := tmpItogsY.fss      + tab1.fss;
      tmpItogsY.foms     := tmpItogsY.foms     + tab1.foms;
      tmpItogsY.travm    := tmpItogsY.travm    + tab1.travm;
      tmpItogsY.fotrez   := tmpItogsY.fotrez   + tab1.fotrez;
      tmpItogsY.strahrez := tmpItogsY.strahrez + tab1.strahrez;
      tmpItogsY.travmrez := tmpItogsY.travmrez + tab1.travmrez;
      Update Current tmpItogsY;
    }

    if (GetFirst FastFirstRow tSelZakaz where ((tab1.zakaznum == tSelZakaz.zakaznum)) = tsOk) then
    {
      tSelZakaz.summa    := tSelZakaz.summa    + tab1.summa;
      tSelZakaz.nch      := tSelZakaz.nch      + tab1.nch;
      tSelZakaz.pfr      := tSelZakaz.pfr      + tab1.pfr;
      tSelZakaz.fss      := tSelZakaz.fss      + tab1.fss;
      tSelZakaz.foms     := tSelZakaz.foms     + tab1.foms;
      tSelZakaz.travm    := tSelZakaz.travm    + tab1.travm;
      tSelZakaz.fotrez   := tSelZakaz.fotrez   + tab1.fotrez;
      tSelZakaz.strahrez := tSelZakaz.strahrez + tab1.strahrez;
      tSelZakaz.travmrez := tSelZakaz.travmrez + tab1.travmrez;
      Update Current tSelZakaz;
    }
  }
}

Procedure PrepareData();
{
  StartNewVisual(vtNumericVisual, vfTimer + vfBreak + vfConfirm, 'Сбор данных для отчета...', 1);

  delete all from tab1;
  delete all from tProvod;
  delete all from tmpItogsMY;
  delete all from tmpItogsY;
  delete all from tSelZakaz;

  oborotzakaz:= if(countgod < 2020, '320', '020');

  Fill_tSelZakaz();

  _Loop tSelZakaz
  {
    countmes := mes1;
    countgod := god1;

    if god1 = god2 and mes1 <= mes2
    {
      while countmes <= mes2
      {
        FillTables(countmes, god1);

        countmes++;
      }
    }

    if god1 < god2
    {
      while countgod <= god2
      {
        if countgod = god2
        {
          while countmes <= mes2
          {
            FillTables(countmes, countgod);

            countmes++;
          }
        }
        else
        {
          while countmes <= 12
          {
            FillTables(countmes, countgod);

            countmes++;
          }
        }

        countgod++;
        countmes:= 1;
      }
    }
  }

  MakeItogs();

  StopVisual;
}

Procedure PrintRep();
{
  StartNewVisual(vtNumericVisual, vfTimer + vfBreak + vfConfirm, 'Печать отчета...', 1);

  var RowNo : longint = 0;
  var ColNo : longint = 0;
  var StRow : longint = 0;

  var firstRow : longint = 3;
  var kolR : longint = 10 * RecordsInTable(tntSelZakaz) + RecordsInTable(tntmpItogsY) + 3 * RecordsInTable(tntmpItogsMY) + RecordsInTable(tntab1);
  var kolC : longint = 15;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_vedrasprzpsvrez.xlsx',true);
  if (xlIsExcelValid) then
  {
    xlSetActiveWorkBookByName('1');
  }

  if ((mes1 = mes2) and (god1 = god2)) then
  {
    xlsetcellstringvalue('ВЕДОМОСТЬ РАСПРЕДЕЛЕНИЯ З/П, С/В И РЕЗЕРВА ЗА ' + mes1 + ' МЕСЯЦ ' + god1 + ' ГОДА', 1, 1, 1, 1);
  }
  else
  {
    xlsetcellstringvalue('ВЕДОМОСТЬ РАСПРЕДЕЛЕНИЯ З/П, С/В И РЕЗЕРВА ЗА ПЕРИОД С ' + mes1 + ' МЕСЯЦА ' + god1 + ' ГОДА ПО ' + mes2 + ' МЕСЯЦ ' + god2 + ' ГОДА', 1, 1, 1, 1);
  }

  xlCreateMatrix(kolR, kolC);

  _Loop tSelZakaz
  {
    _Loop tmpItogsMY where ((tSelZakaz.zakaznum == tmpItogsMY.zakaznum)) ordered by fgod, fmes
    {
      _Loop tab1 where ((tmpItogsMY.zakaznum == tab1.zakaznum and
                         tmpItogsMY.fgod     == tab1.fgod and
                         tmpItogsMY.fmes     == tab1.fmes          ))
      {
        ColNo := 0;
        xlStWriteToMatrix(++RowNo, ++ColNo, chr(39) + tab1.fGod     );
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tab1.fMes     );
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tab1.podr     );
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tab1.vidopl   );
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tab1.zakaznum );
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tab1.sch      );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tab1.summa    );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tab1.nch      );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tab1.pfr      );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tab1.fss      );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tab1.foms     );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tab1.travm    );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tab1.fotrez   );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tab1.strahrez );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tab1.travmrez );
      }


      ColNo := 0;
      xlStWriteToMatrix(++RowNo, ++ColNo, chr(39) + 'Итого по заказу ' + tmpItogsMY.zakaznum     );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                  );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                  );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                  );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                  );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                  );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsMY.summa    );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsMY.nch      );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsMY.pfr      );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsMY.fss      );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsMY.foms     );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsMY.travm    );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsMY.fotrez   );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsMY.strahrez );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsMY.travmrez );

      xlMergeCells(firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);
      xlAlignCellsEx(xlRight, xlRight, firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);
      xlSetFontStyle(xlBold, firstRow + RowNo - 1, 1, firstRow + RowNo - 1, kolC);

      ColNo := 1;
      RowNo++;
      xlStWriteToMatrix(  RowNo,   ColNo, chr(39) + 'Итого ФОТ'                         );
      xlDoWriteToMatrix(  RowNo,       7,           tmpItogsMY.summa + tmpItogsMY.fotrez  );
      xlMergeCells(firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);
      xlSetFontStyle(xlBold, firstRow + RowNo - 1, 1, firstRow + RowNo - 1, kolC);
      xlAlignCellsEx(xlRight, xlRight, firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);


      ColNo := 1;
      RowNo++;
      xlStWriteToMatrix(  RowNo,   ColNo, chr(39) + 'Итого страховые отчисления'                                                          );
      xlDoWriteToMatrix(  RowNo,       7,           tmpItogsMY.pfr + tmpItogsMY.fss + tmpItogsMY.foms + tmpItogsMY.travm + tmpItogsMY.strahrez + tmpItogsMY.travmrez );
      xlMergeCells(firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);
      xlSetFontStyle(xlBold, firstRow + RowNo - 1, 1, firstRow + RowNo - 1, kolC);
      xlAlignCellsEx(xlRight, xlRight, firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);
    }
    /*
    _Loop tmpItogsY where ((tSelZakaz.zakaznum == tmpItogsY.zakaznum)) ordered by fgod
    {
      ColNo := 0;
      xlStWriteToMatrix(++RowNo, ++ColNo, chr(39) + 'Итого за ' + tmpItogsY.fgod + ' год по заказу ' + tmpItogsY.zakaznum     );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                 );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                 );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                 );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                 );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                 );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsY.summa    );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsY.nch      );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsY.pfr      );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsY.fss      );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsY.foms     );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsY.travm    );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsY.fotrez   );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsY.strahrez );
      xlDoWriteToMatrix(  RowNo, ++ColNo,           tmpItogsY.travmrez );

      xlMergeCells(firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);
      xlAlignCellsEx(xlRight, xlRight, firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);
    }

    ColNo := 0;
    xlStWriteToMatrix(++RowNo, ++ColNo, chr(39) + 'Итого по заказу ' + tSelZakaz.zakaznum  );
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                   );
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                   );
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                   );
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                   );
    xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + ''                   );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.summa      );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.nch        );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.pfr        );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.fss        );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.foms       );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.travm      );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.fotrez     );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.strahrez   );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.travmrez   );
    xlDoWriteToMatrix(  RowNo, ++ColNo,           tSelZakaz.fotrez + tSelZakaz.strahrez     );

    xlMergeCells(firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);
    xlSetFontStyle(xlBold, firstRow + RowNo - 1, 1, firstRow + RowNo - 1, ColNo);
    xlAlignCellsEx(xlRight, xlRight, firstRow + RowNo - 1, 1, firstRow + RowNo - 1, 6);
    */


    xlSetNumberFormat('### ### ### ##0' + xlGetDecimalSeparator + ' 00', firstRow, 7, firstRow + RowNo - 1, 16);

    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, 3, 1, 1, firstRow + StRow, 1, firstRow + RowNo - 1, kolC);

    RowNo++;
    RowNo++;

    StRow := RowNo;
  }

  XLWRITEMATRIXTOEXCEL(firstRow, 1);
  XLFREEMATRIX;


  xlAutoFit(1, 1, firstRow + RowNo - 1, kolC);

  xlKillExcel;
  StopVisual;
}

//*****************************************************************************
// события интерфейса
//*****************************************************************************
handleevent

cmInit:
{
  timelog_init;
  mes1:= month(cur_date);
  god1:= year(cur_date);
  mes2:= month(cur_date);
  god2:= year(cur_date);

  CreateTmpFlt();
}

cmPick:
{
  if curfield = #fzakaz
  {
    var _i : longint;
    DelPick(cgKau_Zakaz, 'tmpFlt');
    var _tmpMarkerName : string;
    var stMarker       : longint;

    if (iGetKau.GetCodeKau(cgiMulti, cgKau_Zakaz, _cMnP) <> 0) then
    {
      _tmpMarkerName := iGetKau.GetMarkerName(cgKau_Zakaz);
      stMarker       := InitMarker(_tmpMarkerName, 8, 10, 100, true);
      _i             := 0;
      while getmarker(stMarker, _i, _cMnP)
      {
        if (getFirst FastFirstRow MnPlan where ((_cMnP == MnPlan.nRec)) = tsOk) then
        {
          InsPick(cgKau_Zakaz, 'tmpFlt', _cMnP, MnPlan.Number);
          _i++;
        }
      }
      DoneMarker(stMarker, _tmpMarkerName);
    }
    set fzakaz := MnPlan.Number + if((_i-1) > 0, ' и еще ' + string(_i-1), '');
  }
  ReReadRecord;
}

cmGo:
{
  var isAllOk : boolean = true;

  if ((god1 = god2 and mes1 > mes2) or god1 > god2) then
  {
    message('Указан не правильный период');
  }
  else
  {
    PrepareData();

    PrintRep();
  }
}

end;

end.

VipInterface UserReport_vedrasprzpsvrez Implements IUserReport;
Interface UserReport_vedrasprzpsvrez;

Procedure Run;
Begin
  runinterface(gp_vedrasprzpsvrez);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Распределение з/п, с/в и резерва';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Экономическая и статистическая отчетность';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
