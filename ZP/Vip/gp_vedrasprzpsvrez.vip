var
  counter, countermatrix, countstr: longint;
  excelpath, pzakaz, fzakaz, pzakaznum, oborotzakaz: string;
  mes1, mes2, countmes: word;
  god1, god2, countgod, kaunumber: integer;
  psum, sumnch, sumpfr, sumfss, sumfoms, sumtravm, sumfotrez, sumstrahrez, sumtravmrez, itogofot, itogostrah, itogprovod, srezfot, srezstr: double;
  _cMnP      : comp;

as
select
  1
from
  tab1
, tSelZakaz
, tProvod
, tmpItogsY
, tmpItogsMY
, MnPlan;


