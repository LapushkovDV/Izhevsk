Show at (,,35,8);

table struct tab1
(
  fgod    : word,
  fmes    : word,
  podr    : string,
  vidopl  : longint,
  zakaznum: string,
  sch     : string,
  summa   : double,
  nch     : double,
  pfr     : double,
  fss     : double,
  foms    : double,
  travm   : double,
  fotrez  : double,
  strahrez: double,
  travmrez: double
)
with index
(
    i1 = zakaznum + fgod + fmes + podr + vidopl
  , i2 = fgod + fmes
);

Table Struct tmpItogsMY
(
    fgod     : word
  , fmes     : word
  , zakaznum : string
  , summa    : double
  , nch      : double
  , pfr      : double
  , fss      : double
  , foms     : double
  , travm    : double
  , fotrez   : double
  , strahrez : double
  , travmrez : double
)
with index
(
    i01 = zakaznum + fgod + fmes
  , i02 = fgod + fmes
);

Table Struct tmpItogsY
(
    fgod     : word
  , zakaznum : string
  , summa    : double
  , nch      : double
  , pfr      : double
  , fss      : double
  , foms     : double
  , travm    : double
  , fotrez   : double
  , strahrez : double
  , travmrez : double
)
with index
(
    i01 = zakaznum + fgod
  , i02 = fgod
);

table struct tProvod
(
  fgod    : word,
  fmes    : word,
  zakaznum: string,
  sch     : string,
  podr    : string,
  summa   : double,
  stzatr  : string,
  kschet  : string,
  schetname : string,
  schetkod  : string
)
with index
(
  i1 = zakaznum + fgod + fmes + podr + stzatr
)
;

table struct tSelZakaz
(
    zakaznum : string
  , cmnp     : comp
  , summa    : double
  , nch      : double
  , pfr      : double
  , fss      : double
  , foms     : double
  , travm    : double
  , fotrez   : double
  , strahrez : double
  , travmrez : double
)
with index
(
    i1 = zakaznum
)
;

#include GetKau.var

var _log : string = 'gp_vedrasprzpsvrez.log';
Procedure MyLog(_str: string);
{
  LogStrToFile(_log,_str);
}
Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  MyLog('sql: ' + add_query_str);
}




