//------------------------------------
// групповая замена полей
//------------------------------------
Procedure GroupChangeFields;
var _wVar:variant;
    _sVar:string;
{ if wIsArh=1 exit;//в архиве не будем делать групповое изменение
  if pMarkerActive.Count=0 exit;
  _wVar:='';
  _sVar:='';
  case curfield of
  #GP_RaspAvans.isArh:
  { _wVar:=GP_RaspAvans.isArh;
    _sVar:='"Признак архива"'
  }
  #GP_RaspAvans.Procent:
  { _wVar:=GP_RaspAvans.Procent;
    _sVar:='"Процент"'
  }
  #GP_RaspAvans.DataN:
  { _wVar:=GP_RaspAvans.DataN;
    _sVar:='"Дата начала"'
  }
  #GP_RaspAvans.DataOk:
  { _wVar:=GP_RaspAvans.DataOk;
    _sVar:='"Дата окончания"'
  }
  else exit;
  end;
  if message('Отмечено '+string(pMarkerActive.Count)+' записей'
    +chr(13)+'Выполнить замену поля '+_sVar+' в них?'
     , YesNo     )<>cmYes
  { Exit;
  }
  UpdateTable;
  PushPos(#GP_RaspAvans);
  // две пометки - ругается
  //SubBounds(tbRmGP_RaspAvans1);
  //AddBounds(tbRmGP_RaspAvans2);
  //Marker_Tmp := InitMarker('', 8, 100, 10);
  //var jj:longint;
  //pMarkerActive.ExportToAll(Marker_tmp);
  //for(jj:=0;jj<GetMarKerCount(Marker_tmp);jj++)
  //{ if GetMarker(Marker_tmp,jj,wc_nrec)
  _Loop pMarkerActive where (( root == pMarkerActive.pNrec ))
  {
    if getfirst  GP_RaspAvans_FND where (( pMarkerActive.pNrec == GP_RaspAvans_FND.Nrec )) <>tsok continue;
    MyLog('GroupChangeFields _wVar= '+string(_wVar)+','+string(GP_RaspAvans_FND.Nrec,0,0) );

    case curfield of
    #GP_RaspAvans.isArh  : GP_RaspAvans_FND.isArh  := _wVar;
    #GP_RaspAvans.Procent: GP_RaspAvans_FND.Procent:= _wVar;
    #GP_RaspAvans.DataN  : GP_RaspAvans_FND.DataN  := _wVar;
    #GP_RaspAvans.DataOk : GP_RaspAvans_fND.DataOk := _wVar;
    end;
    update current GP_RaspAvans_FND;
  }
  //SubBounds(tbRmGP_RaspAvans2);
  //AddBounds(tbRmGP_RaspAvans1);
  //PopPos(#GP_RaspAvans);
  ReReadRecord(#GP_RaspAvans);
} //Procedure GroupChangeFields;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  TableEvent Table GP_RaspAvans;
  //--------------------------
  cmSetDefault:
  { //Пока не уверен ClearBuffer(#GP_RaspAvans)
    //MakeBufferRaspAvans;
    exit;
  } //cmSetDefault:
  cmInsert:
  { //delete all ForMarks;
    UpdateTable;
    if RunWindowModal(wnInsertRec)=cmDefault
    { StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak, 'Выгрузка данных', RecordsInTable(#ForMarks));

      _Loop ForMarks
      { if not NextVisual then break;
        pLsch:=Formarks.cPodr;
        var _Procent:double=Procent_Ins+CalcProcent(0);
        if _Procent>100
        { _Procent:=Procent_Ins-(_Procent-100)

        }
        else
        { _Procent:=Procent_Ins

        }
        if _Procent<=0 continue;

        MakeBufferRaspAvans;
        GP_RaspAvans.cLschet:=Formarks.cPodr;
        if getfirst Lschet=tsok
        { GP_RaspAvans.cPersons := Lschet.tPerson;
          GP_RaspAvans.cKatPodr := Lschet.Cex;
          GP_RaspAvans.Tabn     := Lschet.Tabn;
          GP_RaspAvans.StrTabn  := Lschet.StrTabn;
          GP_RaspAvans.Procent  := _Procent;
          GP_RaspAvans.cMnPlan  := pMnPlanIns;
          GP_RaspAvans.cvPlan   := pvPlanIns;

        }
        insert current GP_RaspAvans;
      }
      ReReadRecord(#GP_RaspAvans);
      StopVisual('',0);
    }
    abort ;
    exit;
  }
  //--------------------------
  cmInsertRecord:
  { if wisArh=1
    { Message('В архивных записях изменение запрещено');
      ReReadRecord(#GP_RaspAvans);
      abort;
    }
    Insert Current GP_RaspAvans;
  }//cmInsertRecord:
  //--------------------------
  cmIdle:
  { Count_2_del:=0;
  }
  //--------------------------
  cmUpdateRecord:
  { if (wisArh=1
    and GP_RaspAvans.isArh=1)
    { Message('В архивных записях изменение запрещено');
      ReReadRecord(#GP_RaspAvans);
      SetModified(false);
      Exit;
    }
    Update Current GP_RaspAvans;
  } //cmUpdateRecord:

  //--------------------------
  cmCheckField:
  { Case Curfield of
    #GP_RaspAvans.isArh:
    { if GP_RaspAvans.DataOk<>ZeroDate
      if GP_RaspAvans.DataOk<dOtchPer and GP_RaspAvans.isArh=0
      { message('Период записи находится в архиве!');
        set GP_RaspAvans.isArh:=1;
      }

    }
    #GP_RaspAvans.Procent:
    { var wProcent:double;
      pLsch:=GP_RaspAvans.cLschet;
      wProcent:=CalcProcent(GP_RaspAvans.Nrec)+GP_RaspAvans.Procent;
      if wProcent>100
      { set GP_RaspAvans.Procent:=GP_RaspAvans.Procent-(wProcent-100);
      }
    }
    #GP_RaspAvans.DataN:
    { if GP_RaspAvans.DataOk<>Date(0,0,0)
      { if GP_RaspAvans.DataOk<GP_RaspAvans.DataN
        { Message('Дата окончания меньше даты начала');
          set GP_RaspAvans.DataOk:=GP_RaspAvans.DataN
        }
      }
    }

    #GP_RaspAvans.DataOk:
    { if GP_RaspAvans.DataOk<>ZeroDate
      { if GP_RaspAvans.DataOk<GP_RaspAvans.DataN
        { Message('Дата окончания меньше даты начала');
          set GP_RaspAvans.DataOk:=GP_RaspAvans.DataN;

        }
        else
        { set GP_RaspAvans.DataOk:=GP_RaspAvans.DataOk;
        }
        if GP_RaspAvans.DataOk<dOtchPer
        { if Message('Дата окончания меньше даты начала отчетного периода'
            +chr(13)+'Запись будет переведена в архив'
            +chr(13)+'Исправить?'
           ,YesNo )=cmYes
          {  set GP_RaspAvans.DataOk:=Date(Last_Day(dOtchPer),Month(dOtchPer),Year(dOtchPer));
          }
          else
          { GP_RaspAvans.isArh:=1;
            update current GP_RaspAvans;
            SetModiFied(False);
            ReReadRecord(#GP_RaspAvans);
          }
        }
      } //if GP_RaspAvans.DataOk<>ZeroDate
    } //#GP_RaspAvans.DataOk:
    end;
    GroupChangeFields;
  } //cmCheckField:

  //--------------------------
  cmDeleteRecord:
  { if wIsArh=1
    { Message('В архивных записях изменение запрещено');
        abort;
    }
    if pMarkerActive.Count>0
    { Count_2_del:=pMarkerActive.Count+1
    }
    if Count_2_del<=0
    {
      if Message('Удалить запись'
      +chr(13)+if(isValid(#Persons),Persons.Fio,'')+if(GP_RaspAvans.Datan<>ZeroDate,DateToStr(GP_RaspAvans.Datan,' от DD.MM.YYYY'),'')
        ,YesNo      )=cmYes
      { Delete Current GP_RaspAvans;
      }
    } // если есть пометка добавляем без предупреждения
    else
    {
      Delete Current GP_RaspAvans;
      Count_2_del--;
    }
  } //cmDeleteRecord:
  end; //TableEvent Table GP_RaspAvans

  //---------------------------------
  tableevent table Zar_User;
  cmUpdateRecord:
  {
    update current Zar_User;
  }
  cmCheckField:
  { //UpdateFilter;
  }
  end;


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //--------------------------
    cmInit:
    {
      LoadInterface;
      SetFilterBounds(wIsArh);
      SetFilterNM;
    }
    cmDone:
    { UnLoadInterface
    }
    //--------------------------
    cmOnVipLoad:
    { LoadInterface
    }
    cmOnVipLoad:
    { UnLoadInterface
    }

    //--------------------------
    cmOpenSearch :
    {
      isOpenSearch:= true;
      ProcessCommand(cmPick);
      isOpenSearch:= false;
    }

    //--------------------------
    cmPick:
    {
      case CurField of
      #Filtr_Katpodr,
      #Filtr_MnPlan,
      #Filtr_Persons,
      #Filtr_Lschet:
      {
      }
      else
      { if wIsArh=1
        { if (CurField<>#GP_RaspAvans.isArh)
          { Message('В архивных записях изменение запрещено');
            exit;
          }
          else
          if GP_RaspAvans.DataOk<>ZeroDate
          { if GP_RaspAvans.DataOk<dOtchPer
            { message('Признак архива не может быть изменен для записей прошлых периодов')
            }
          }
        }//if wIsArh=1
      }
      end
      Case Curfield of
      #vPlan.Name:
      {
        var ccomp : comp;
        ccomp := GP_RaspAvans.cvPlan;
        if (RunInterFace(GrvPlan,ccomp,LongInt(0)
           ,17//pWorkType
           ) <> cmCancel)
        {
          set GP_RaspAvans.cvPlan := ccomp;
          GroupChangeFields;

        }
      }
      /*
      #GP_RaspAvans.StrTabn,#GP_RaspAvans.Tabn,#Persons.Fio,#Katpodr.Kod,#Katpodr.Name:
      { pTmp:=GP_RaspAvans.cLschet;
        PAF_One.Change(PickOptions);
        var PAMI: IPersonalAccountMarksIterator;
        PAMI := PAF_One.GetMarks.GetIterator;
        StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak, 'Выгрузка данных', PAF_One.GetMarks.GetCount);
        var ww_first:boolean=true;
        _try
        {
          if PAMI.First
          {
            do
            {
              if not NextVisual then break;
              if ww_first
              { set GP_RaspAvans.cLschet:=PAMI.GetPersonalAccount;
              }
              else
              { MakeBufferRaspAvans;
                set GP_RaspAvans.cLschet:=PAMI.GetPersonalAccount;
              }
              if getfirst Lschet=tsok
              { set GP_RaspAvans.cPersons := Lschet.tPerson;
                set GP_RaspAvans.cKatPodr := Lschet.Cex;
                set GP_RaspAvans.Tabn     := Lschet.Tabn;
                set GP_RaspAvans.StrTabn  := Lschet.StrTabn;
                set GP_RaspAvans.Procent  := PAMI.GetValue;
              }
              if ww_first
              { SetModified(true);
                UpdateTable;
                ww_first:=false;
              }
              else
              { Insert current GP_RaspAvans;
              }
            }
            while PAMI.Next;
         }
       }
       _except
         on ExUserBreak: {}
       _finally
         StopVisual('', 0);

        ReScanPanel(#GP_RaspAvans)

      }
      */
      #MnPlan.Number:
      { if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed';
        pTmp:=GP_RaspAvans.cMnPlan;
        if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
        { set GP_RaspAvans.cMnPlan:=pTmp;
          if getfirst MnPlan=tsok
            set GP_RaspAvans.cvPlan:=MnPlan.cvPlan;
          GroupChangeFields;
        }
        ReScanPanel(#GP_RaspAvans)
      }
      #Filtr_Katpodr:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Katpodr);
        StoreMarker(Marker_KatPodr,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_KatPodr,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_KatPodr,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,1);
        }
      }
      #Filtr_MnPlan:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Zakaz);
        StoreMarker(Marker_MnPlan,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Zakaz,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_MnPlan,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_MnPlan);
          BitOnW(wFilter,2);
        }
      }
      #Filtr_Persons:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Persons);
        StoreMarker(Marker_Persons,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Persons,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_Persons,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_Persons);
          BitOnW(wFilter,3);
        }
      }
      #Filtr_Lschet:
      { PAF_One.Change(PickOptions);
        var PAMI: IPersonalAccountMarksIterator;
        PAMI := PAF_One.GetMarks.GetIterator;
        StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak, 'Выгрузка данных', PAF_One.GetMarks.GetCount);
        ClearMarker(Marker_Lschet);
        _try
        { if PAMI.First
          { do
            {
              if not NextVisual then break;
              InsertMarker(Marker_Lschet,PAMI.GetPersonalAccount);
            }
            while PAMI.Next;
          }
        }
        _except
          on ExUserBreak: {}
        _finally
          StopVisual('', 0);
        SetFilterNm(#Filtr_Lschet);
        BitOnW(wFilter,4);
      }
      end;
    } //cmPick:

    cmDelOnProtect:
    {
      Case Curfield of
      #Filtr_Katpodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,1);
        SetFilterNm(#Filtr_Katpodr);
      }
      #Filtr_MnPlan:
      { ClearMarker(Marker_MnPlan);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_MnPlan);
      }
      #Filtr_Persons:
      { ClearMarker(Marker_Persons);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_Persons);
      }
      #Filtr_Lschet:
      { ClearMarker(Marker_Lschet);
        BitOffW(wFilter,4);
        SetFilterNm(#Filtr_Lschet);
      }
      end;
    } //cmDelOnProtect:

    //--------------------------
    cmFilterSave:
    { UpdateTable;
      //CopyToA; - расскоментировать при наличии проблем
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(wIsArh);
      }
      else RestFromA

    }

    //--------------------------
    cmValue1: // Скопировать запись
    { UpdateTable;
      if wIsArh=1
      { message('Копирование записей в архиве запрещено');
        abort;
      }
      if isValid(#GP_RaspAvans)
      { if pMarkerActive.Count>0
        { if message('Скопировать '+string(pMarkerActive.Count)+ ' записей?',YesNo)=cmYes
          { _Loop pMarkerActive where (( root == pMarkerActive.pNrec ))
            {
              if getfirst  GP_RaspAvans_FND where (( pMarkerActive.pNrec == GP_RaspAvans_FND.Nrec )) <>tsok continue;
              GP_RaspAvans_FND.Nrec:=0;
              GP_RaspAvans_FND.cUser:=UserId();
              GP_RaspAvans_FND.DInput   := Cur_Date;
              insert current GP_RaspAvans_FND;
            }
            ReReadRecord(#GP_RaspAvans);
          }


        }
        else
        if message('Скопировать текущую запись?',YesNo)=cmYes
        { GP_RaspAvans.Nrec:=0;
          GP_RaspAvans.cUser:=UserId();
          GP_RaspAvans.DInput   := Cur_Date;
          insert current GP_RaspAvans;
          ReScanPanel(#GP_RaspAvans);

        }

      }
    } //cmValue1

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
        RunInterface('ExClassifier', coGP_RaspAvans, GP_RaspAvans.nRec);
    }

    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
        RunInterface('Attribute', coGP_RaspAvans, GP_RaspAvans.nRec);
    }

    //--------------------------
    cmChangeTabbedSheetFormat:
    { UpdateTable;
      case Target of
      brRaspActive:
      { SetFilterBounds(0);
      }
      brRaspArh:
      { SetFilterBounds(1);
      }
      end;

    } //cmChangeTabbedSheetFormat:


    //--------------------------
    cmHotKeys:
    {
      ProcessCommand(RunMenu('GP_ZP_RaspZakazPers_mnu'));

    }

    cmValue2:
    {
      RunInterfaceNoModal('GP_ZP::ZenSHAKKIN');
    }

    cmValue3:
    {
      RunInterfaceNoModal('GP_ZP::ZenSHAKKINNEW');
    }

    cmValue4:
    {
      CalcPercentPryamyeAll;
    }

  end;//HandleEvent
end.//Interface GP_ZP_RaspZakazPers

//меню
GP_ZP_RaspZakazPers_mnu menu
{
- 'Копировать'                 , cmValue1, '', hcProc_NagrKaf, 'Alt+1',kbAlt1, scMenuCtx;
- 'Расчет аванса'              , cmValue2, '', hcProc_NagrKaf, 'Alt+2',kbAlt2, scMenuCtx;
//- 'Расчет аванса (сохранение)' , cmValue3, '', hcProc_NagrKaf, 'Alt+3',kbAlt3, scMenuCtx;
 -----------;
- 'Добавление % по "прямым" за прошлый месяц'              , cmValue4, '', hcProc_NagrKaf, 'Alt+3',kbAlt3, scMenuCtx;
 -----------;
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Внешняя классификация', cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
- 'Внешние атрибуты'     , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

} //GP_ZP_RaspZakazPers_mnu menu
