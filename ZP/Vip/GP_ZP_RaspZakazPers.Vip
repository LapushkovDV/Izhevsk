//------------------------------------------------------------------------------
//  Выбор подразделения и работников
//------------------------------------------------------------------------------
procedure UpdateFilter;
{
  // корректируем флаг фильтра по подразделениям если необходимо
  if ( PAF.IsDepartmentFilterSet <> IsBitCTW(CurFilters,1) )
    BitOnW(CurFilters,1);
  // корректируем флаг фильтра по ЛС если необходимо
  if PAF.IsPersonalAccountFilterSet <> IsBitCTW(CurFilters,2)
    BitOnW(CurFilters,2);

  //if GetBit(4, CurFilters) <> ( (Day(DateBeg) > 0) or (Day(DateEnd) > 0) )
  //  BitOnW(CurFilters,3);;

  OldFilters := CurFilters;

  ReScanPanel(CurTable);
} // procedure UpdateFilter


procedure PodrPubPick;
{ case CurField of
    #FiltrPodr:
    {
/*
#ifdef AdvancedDepartmentFilterExtOptions
      IPAFilterExtOption(PAF).ChangeDepartmentFilterExtOptions(
        true, DepartmentValidator,
        cexozDate1, cexozDate2, PAFExtOption);
#else //{
#ifdef AdvancedDepartmentFilter
      ITraditionalPersonalAccountFilterExt(PAF).ChangeDepartmentFilterExt(true, DepartmentFilterDate);
#else
      PAF.ChangeDepartmentFilter(true);
#end
#end //}
*/
      PAF.ChangeDepartmentFilter(true);
      ReReadRecord(#Zar_user);
    }

    #FiltrPublic:
    {
      PAF.ChangePersonalAccountFilter(0);
      ReReadRecord(#Zar_user);
    }
  end; // case
  UpdateFilter;
}

procedure CalcPercentPryamyeAll;
{
StartNewVisual(vtRotateVisual, vfTimer , 'Просмотр реестров за предыдущий месяц', 0);
  var _curOtchPer : date = sub_months(dgettune('UP.DATOTCH'),1);
  var _curOtchPerAddmonth1 : date = dgettune('UP.DATOTCH');
  delete all tmpPercPrevMonth;
    _try
     {
            sql
            select
               t.CLSCH as clSch
              ,t.grZak as cVplan
              ,round(100*case when t.SUMOPLALL <> 0 then t.SUMOPL/t.SUMOPLALL else 0 end ,2) as  Percent
            from(
            select
               spplban.CLSCH as CLSCH
              ,spplban.strtabn
              ,av.vcomp as grZak
              ,GrZakaz.name
              ,Sum(spplban.SUMOPL)   as  SUMOPL
              ,ReestrAll.SUMOPL as  SUMOPLALL
            from sbban
            join spplban on spplban.CSBBAN = SBBAN.nrec
            join attrnam an on an.wtable = 16060
                              and an.name = 'Группа заказов'
            join attrval av on av.cattrnam = an.nrec
                           and av.crec = sbban.nrec
            join vplan GrZakaz on GrZakaz.nrec = av.vcomp
            left join
                      (
                       select
                         spplban.CLSCH as CLSCH
                        ,sum(spplban.SUMOPL) as  SUMOPL
                      from sbban
                      join spplban on spplban.CSBBAN = SBBAN.nrec

                      where sbban.datan = :(_curOtchPer)//#date(01,02,2019)
                        and sbban.PREFIX = 'R$Z'
                        and sbban.VIDUD = 220

                        group by spplban.CLSCH
                      ) reestrAll on ReestrAll.cLsch = SpplBan.clSch
                      join attrnam an_spplban on an_spplban.wtable = :(coSpplBan)
                                             and an_spplban.name   = :(coAttrSpplBan_wtype_Zatraty)
                      join attrval av_spplban on av_spplban.wtable   = an_spplban.wtable
                                             and av_spplban.crec     = spplban.nrec
                                             and av_spplban.cattrnam = an_spplban.nrec
            where sbban.datan =  :(_curOtchPer)// #date(01,02,2019)
                        and sbban.PREFIX = 'R$Z'
                        and sbban.VIDUD = 220
                        and Coalesce(av.vcomp,#comp(0h)) <> #comp(0h)
                        and av_spplban.vDouble = 1 // только прямые
            group by
               spplban.CLSCH
              ,spplban.strtabn
              ,av.vcomp
              ,GrZakaz.name
              ,ReestrAll.SUMOPL
            ) t
/*
выдедяем всех, а вот НДФл....
            where t.grZak in ( select grzak.nrec
                                          from vplan grzak
                                          join attrnam an on an.wtable = 31015
                                                           and an.name = 'Распределять аванс по ГоЗ'
                                          join attrval av on av.cAttrnam = an.nrec
                                                             and av.crec = grzak.nrec
                                          where av.vdouble = 1
                              )
*/
         into tmpPercPrevMonth
        ;
      }
     _except else {}

  var _log : string = 'avans.log';
  LogStrToFile(_log, '-----------------------------------------------------');
  _loop tmpPercPrevMonth
  {
   if (tmpPercPrevMonth.Percent < 2)
    continue;
   if getfirst Lschet_1  where ((tmpPercPrevMonth.cLsch == Lschet_1.nrec)) = tsOK // да  медленно, но и хрен с ним, это запускается один раз в месяц
   {
     LogStrToFile(_log, 'Lschet_1.nrec = ' + Lschet_1.nrec);
     LogStrToFile(_log, 'Lschet_1.strtabn = ' + Lschet_1.strtabn);
     LogStrToFile(_log, '');
    if(getfirst Gp_RaspAvans where ((tmpPercPrevMonth.cLsch == Gp_RaspAvans.CLSCHET
                                           and 0 == Gp_RaspAvans.WTYPE(noindex)
                     and tmpPercPrevMonth.cVPlan == Gp_RaspAvans.CVPLAN(Noindex)
                     ))
        and ( Gp_RaspAvans.DATAN <= _curOtchPer and (Gp_RaspAvans.DATAOK = 0 or Gp_RaspAvans.DATAOK > _curOtchPer)
            )
       ) <> tsOK
     {  LogStrToFile(_log, 'Point 1');
        if getfirst Gp_RaspAvans where ((tmpPercPrevMonth.cLsch == Gp_RaspAvans.CLSCHET
                                               and 0 == Gp_RaspAvans.isArh
                                               and 1 == Gp_RaspAvans.WTYPE(noindex)
                         and tmpPercPrevMonth.cVPlan == Gp_RaspAvans.CVPLAN(Noindex))) <> tsOK
         {
           LogStrToFile(_log, 'Point 2');
            Insert Gp_RaspAvans set
              Gp_RaspAvans.TABN     := Lschet_1.tabN
             ,Gp_RaspAvans.STRTABN  := Lschet_1.STRTABN
             ,Gp_RaspAvans.CLSCHET  := Lschet_1.nrec
             ,Gp_RaspAvans.CPERSONS := Lschet_1.tPerson
             ,Gp_RaspAvans.CKATPODR := Lschet_1.cex
             ,Gp_RaspAvans.CMNPLAN  := 0h
             ,Gp_RaspAvans.DATAN    := date(01,month(_curOtchPerAddmonth1),year(_curOtchPerAddmonth1))
             ,Gp_RaspAvans.DATAOK   := date(15,month(_curOtchPerAddmonth1),year(_curOtchPerAddmonth1))
             ,Gp_RaspAvans.ISARH    := 0
             ,Gp_RaspAvans.CUSER    := UserID
             ,Gp_RaspAvans.DINPUT   := Cur_date
             ,Gp_RaspAvans.CVPLAN   := tmpPercPrevMonth.cVPlan
             ,Gp_RaspAvans.WTYPE    := 1
            ;
         }
         update current Gp_RaspAvans set Gp_RaspAvans.PROCENT  := tmpPercPrevMonth.Percent;
         LogStrToFile(_log, 'Point 3');
      }
    }
  }
 stopVisual;
 rereadrecord;
}
//******************************************************************************
// Функции
//******************************************************************************
  //==============================================================================
  //
  //==============================================================================
  Procedure MyLog(ww:string);
  {
    timelog(ww)
  }


  //------------------------------------
  // Наименование интерфейса
  //------------------------------------
  Function GetInterfaceName:string;
  { Result:=#(__InterfaceName__);
  }
  //------------------------------------
  // сохранить параметры
  //------------------------------------
  Procedure SaveParam;
  { SaveMyDsk(wFilter  ,GetInterfaceName+'_wFilter');
    //-----------------------
    DoneMarker(Marker_Lschet_A , '' );
    DoneMarker(Marker_Persons_A, '' );
    DoneMarker(Marker_KatPodr_A, '' );
    DoneMarker(Marker_MnPlan_A , '' );
    //-----------------------
    if Need_Read_Param
    {
      DoneMarker(Marker_Lschet , GetInterfaceName+'_Lschet' );
      DoneMarker(Marker_Persons, GetInterfaceName+'_Persons');
      DoneMarker(Marker_KatPodr, GetInterfaceName+'_KatPodr');
      DoneMarker(Marker_MnPlan , GetInterfaceName+'_MnPlan' );
    }
    else
    {
      DoneMarker(Marker_Lschet , '' );
      DoneMarker(Marker_Persons, '' );
      DoneMarker(Marker_KatPodr, '' );
      DoneMarker(Marker_MnPlan , '' );
    }
  } //Procedure SaveParam;

  //------------------------------------
  // восстановить параметры
  //------------------------------------
  Procedure ReadParam;
  { if Need_Read_Param
    { if not ReadMyDsk(wFilter,GetInterfaceName+'_wFilter',false) wFilter:=0;
      Marker_Lschet   :=InitMarker(GetInterfaceName+'_Lschet' , 8, 50, 10, True);
      Marker_Persons  :=InitMarker(GetInterfaceName+'_Persons', 8, 50, 10, True);
      Marker_KatPodr  :=InitMarker(GetInterfaceName+'_KatPodr', 8, 50, 10, True);
      Marker_MnPlan   :=InitMarker(GetInterfaceName+'_MnPlan' , 8, 50, 10, True);
    }
    else
    {
      Marker_Lschet   :=InitMarker('' , 8, 50, 10, True);
      Marker_Persons  :=InitMarker('', 8, 50, 10, True);
      Marker_KatPodr  :=InitMarker('', 8, 50, 10, True);
      Marker_MnPlan   :=InitMarker('' , 8, 50, 10, True);

    }
    Marker_Lschet_A   :=InitMarker('' , 8, 50, 10, True);
    Marker_Persons_A  :=InitMarker('' , 8, 50, 10, True);
    Marker_KatPodr_A  :=InitMarker('' , 8, 50, 10, True);
    Marker_MnPlan_A   :=InitMarker('' , 8, 50, 10, True);
  } //  Procedure ReadParam;

  //------------------------------------
  // декларация сложного фильтра
  //------------------------------------
  function isFilterAnCorrect(ww_nrec:comp): boolean; cacheable;
  { Result:=true;
    #__UNUSED__(ww_nrec)
    if IsBitCTW(wFilter,1)
    { if Count_Katpodr>1
      { If not FoundMarker(Marker_Katpodr_A,GP_RaspAvans.cKatPodr)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,2)
    { if Count_MnPlan>1
      { If not FoundMarker(Marker_MnPlan_A,GP_RaspAvans.cMnPlan)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,3)
    { if Count_Persons>1
      { If not FoundMarker(Marker_Persons_A,GP_RaspAvans.cPersons)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,4)
    { if Count_Lschet>1
      { If not FoundMarker(Marker_Lschet_A,GP_RaspAvans.cLschet)
        { Result:=false;
          Exit;
        }
      }
    }

  }//function isFilterAnCorrect(ww_nrec:comp): boolean;

  //-------------------------------------------
  #doc
    Проверить наличие распределения по заказам за период
  #end
  function FindFirstRaspZakazByPeriod(_pPerson: tNRec; _pLschet:tNRec;  _DataN: Date;  _DataOk: Date; var _pZakaz:comp;var _dProcent:double; var _vPlan:comp; var _wType : word): boolean;
  {  Result    :=false;
     _pZakaz   :=0;
     _vPlan    :=0;
     _dProcent :=0;
     _wType    := 0;
     MyLog('FindFirstRaspZakazByPeriod '+string(_pLschet)
        +' , DataN='+DateToStr(_DataN,'DD.MM.YYYY')
        +' , DataOk='+DateToStr(_DataOk,'DD.MM.YYYY')
     );
     if _pLschet>0
     { if getfirst GP_RaspAvans where (( _pLschet == GP_RaspAvans.clschet
            and 0 == GP_RaspAvans.isArh
            and _DataOk>>=GP_RaspAvans.DataN
            and (_DataN <=GP_RaspAvans.DataOk or GP_RaspAvans.DataOk=0)
        ))=tsok
       { Result:=true;
         _pZakaz  :=GP_RaspAvans.cMnPlan;
         _vPlan   :=GP_RaspAvans.cvPlan;
         _dProcent:=GP_RaspAvans.Procent;
         _wType   := GP_RaspAvans.wType;
         MyLog('FindFirstRaspZakazByPeriod'
              +'   _pLschet='+string(_pLschet)
              +', _dProcent='+string(_dProcent,0,2)
              +',   _pZakaz='+string(_pZakaz)
              +',    _vPlan='+string(_vPlan,0,0)
              +',    _wType='+string(_wType)
             )
       }
     } //if _pLschet>0
  } //function FindFirstRaspZakazByPeriod(_pPerson: tNRec; _pLschet:tNRec;  _DataN: Date;  _DataOk: Date; var _pZakaz:comp; _dProcent:double): boolean;

  function FindNextRaspZakazByPeriod(_pPerson: tNRec; _pLschet:tNRec;  _DataN: Date;  _DataOk: Date; var _pZakaz:comp;var _dProcent:double; var _vPlan:comp; var _wType : word): boolean;
  {  Result    :=false;
     _pZakaz   :=0;
     _vPlan    :=0;
     _dProcent :=0;
     _wType    := 0 ;
     if _pLschet>0
     { if getNext GP_RaspAvans where (( _pLschet == GP_RaspAvans.clschet
            and 0 == GP_RaspAvans.isArh
            and _DataOk>>=GP_RaspAvans.DataN
            and (_DataN <=GP_RaspAvans.DataOk or GP_RaspAvans.DataOk=0)
        ))=tsok
       { Result:=true;
         _pZakaz  :=GP_RaspAvans.cMnPlan;
         _vPlan   :=GP_RaspAvans.cvPlan;
         _dProcent:=GP_RaspAvans.Procent;
         _wType   := GP_RaspAvans.wType ;
         MyLog('FindNextRaspZakazByPeriod'
              +'   _pLschet='+string(_pLschet)
              +', _dProcent='+string(_dProcent,0,2)
              +',   _pZakaz='+string(_pZakaz)
              +',    _vPlan='+string(_vPlan,0,0)
              +',    _wType='+string(_wType)
             )

       }
     } //if _pLschet>0
  } //function FindNextRaspZakazByPeriod(_pPerson: tNRec; _pLschet:tNRec;  _DataN: Date;  _DataOk: Date; var _pZakaz:comp; _dProcent:double): boolean;


  //-------------------------------------------
  // скопировать фильтры в данные для отборв
  //-------------------------------------------
  Procedure CopyToA;
  { CopyMarker(Marker_Katpodr_A,Marker_Katpodr);
    CopyMarker(Marker_MnPlan_A ,Marker_MnPlan );
    CopyMarker(Marker_Persons_A,Marker_Persons);
    CopyMarker(Marker_Lschet_A ,Marker_Lschet );
  } //Procedure CopyToA;

  //-------------------------------------------
  // восстановить данные для задания фильтрации
  // из данных для отбора
  //-------------------------------------------
  Procedure RestFromA;
  { CopyMarker(Marker_Katpodr,Marker_Katpodr_A);
    CopyMarker(Marker_MnPlan ,Marker_MnPlan_A );
    CopyMarker(Marker_Persons,Marker_Persons_A);
    CopyMarker(Marker_Lschet ,Marker_Lschet_A );
  } //Procedure RestFromA;

  //-------------------------------------------
  #doc
    Установить ограничения
  #end
  Function SetFilterBounds(_IsArch:word) : boolean;
  { Result:=false;
    if ConditionActiveInLeave(tcFilterAn, #GP_RaspAvans)
    { PopConditionForLeave(tcFilterAn, #GP_RaspAvans);
    }
    case wIsArh of
    0: PushBounds(tbByActive);
    1: PushBounds(tbByArh);
    end;
    If BoundActive(tbByKatpodr) SubBounds(tbByKatpodr);
    If BoundActive(tbByMnPlan ) SubBounds(tbByMnPlan );
    If BoundActive(tbByPersons) SubBounds(tbByPersons);
    If BoundActive(tbByLschet ) SubBounds(tbByLschet );
    //-----------------------
    CopyToA;
    //-----------------------
    ClearFuncCache; // очистим кэш функций
    var need_FilterAn:boolean=false;
    set wIsArh:=_IsArch;
    if IsBitCTW(wFilter,1)
    {  Count_Katpodr:=GetMarkerCount(Marker_Katpodr);
       if Count_Katpodr=1
       { GetMarker(Marker_Katpodr,0,pKatPodr);
         AddBounds(tbByKatpodr);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,2)
    {  Count_MnPlan:=GetMarkerCount(Marker_MnPlan);
       if Count_MnPlan=1
       { GetMarker(Marker_MnPlan,0,pMnPlan);
         AddBounds(tbByMnPlan);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,3)
    {  Count_Persons:=GetMarkerCount(Marker_Persons);
       if Count_Persons=1
       { GetMarker(Marker_Persons,0,pPersons);
         AddBounds(tbByPersons);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,4)
    {  Count_Lschet:=GetMarkerCount(Marker_Lschet);
       if Count_Lschet=1
       { GetMarker(Marker_Lschet,0,pLsch);
         AddBounds(tbByLschet);
       }
       else need_FilterAn:=true;
    }

    // использование сложного фильтра
    if need_FilterAn
    { PushConditionForLeave(tcFilterAn, #GP_RaspAvans);
    }
    ReReadRecord(#GP_RaspAvans);
    Result:=true;
  } //Function SetFilterBounds : boolean;

  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_Katpodr
    { #mrkfiltr_(Katpodr_Flt,Katpodr,Nrec,wc_nrec,Katpodr_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_MnPlan
    { #mrkfiltr_(MnPlan_Flt,MnPlan,Nrec,wc_nrec,MnPlan_Flt.Number)
    }
    if _Field=0 or _Field=#Filtr_Lschet
    { #mrkfiltr_(Lschet_Flt,Lschet,Nrec,wc_nrec,if(FormatClockNumber=0,string(Lschet_Flt.Tabn),Lschet_Flt.StrTabn))
    }
    if _Field=0 or _Field=#Filtr_Persons
    { #mrkfiltr_(Persons_Flt,Persons,Nrec,wc_nrec,Persons_Flt.Fio)
    }
    ReScanPanel(#Katpodr_Flt);
  } //Procedure SetFilterNM(_Field:longint)

  //---------------------------------------
  // Формирование буфера записи
  //---------------------------------------
  Procedure MakeBufferRaspAvans;
  { ClearBuffer(#GP_RaspAvans);
    GP_RaspAvans.Nrec:=0;
    if dDatan=ZeroDate
    dDatan:=date(1,MonthRas,YearRas);
    GP_RaspAvans.cLschet  := plsch   ;// ссылка на лицевой счет
    GP_RaspAvans.cPersons := pPersons;// ссылка на карточку
    GP_RaspAvans.cKatPodr := pKatPodr;// ссылка на подразделение
    GP_RaspAvans.Datan    := dDatan  ;// заданный период c
    GP_RaspAvans.DataOk   := dDatok  ;// заданный период по
    GP_RaspAvans.isArh    := wisArh  ;
    GP_RaspAvans.cUser    := UserId();
    GP_RaspAvans.DInput   := Cur_Date;
    if pLsch>0
    { if getfirst Lschet_F=tsok
      { GP_RaspAvans.Tabn:=Lschet_F.Tabn;
        GP_RaspAvans.StrTabn:=Lschet_F.StrTabn;
        GP_RaspAvans.cPersons:=Lschet_F.tPerson;
        GP_RaspAvans.cKatPodr:=Lschet_F.cex;
      }
    }
    else
    if pPersons>0 and isValid(#Persons_F)
    { GP_RaspAvans.Tabn:=Persons_F.Tabnmb;
      GP_RaspAvans.StrTabn:=Persons_F.StrTabn;
      GP_RaspAvans.cKatPodr:=Persons_F.GalDep;
      if GetFirst Appointments_F=tsok
        GP_RaspAvans.cLschet:=Appointments_F.cAddNrec2;
    }
  } //Procedure MakeBufferRaspAvans;

  //---------------------------------------
  // Рассчитать процент
  //---------------------------------------
  Function CalcProcent(_cNrec:comp):double;
  { Result:=0;
    _Loop GP_RaspAvans_Fnd
    { if  GP_RaspAvans_Fnd.NREC=_cNrec CONTINUE;
      Result+=GP_RaspAvans_Fnd.Procent;
    }

  }

  Procedure LoadInterface;
  { dOtchPer:=dGetTune('UP.DATOTCH');
    MyLog('LoadInterface Start');
    if dDatan=ZeroDate
    dDatan:=date(1,MonthRas,YearRas);
    FormatClockNumber:=wGetTune('FormatClockNumber');
    var CL: ContextList;

    if not CL.Add(CS, 'IntInit')
    {
    }
    CLSF.ReScan;

    set sUserName:=UserName();
    case FormatClockNumber of
    0:
    { SetFieldState  (#GP_RaspAvans.Tabn   ,sfVisible);
      ClearFieldState(#GP_RaspAvans.StrTabn,sfVisible);
    }
    1:
    { SetFieldState  (#GP_RaspAvans.StrTabn,sfVisible);
      ClearFieldState(#GP_RaspAvans.Tabn   ,sfVisible);
    }
    end; //FormatClockNumber
    if getfirst GP_RaspAvans where (( 0 == GP_RaspAvans.IsArh
              and ZeroDate <<GP_RaspAvans.DataOk(noindex)
              and dOtchPer >>GP_RaspAvans.DataOk(noindex)
              )) =tsok
    { update GP_RaspAvans where
              (( 0 == GP_RaspAvans.IsArh
              and ZeroDate <<GP_RaspAvans.DataOk(noindex)
              and dOtchPer >>GP_RaspAvans.DataOk(noindex)
                ))
       set GP_RaspAvans.IsArh:=1;

    }

    //-----------------------
    ClusterDisabledField(#wFilter,0);
    Need_Read_Param:=true;
    if pLsch>0 or pPersons>0 or pMnPlan>0 or pKatPodr>0
    { Need_Read_Param:=false;

    }
    var _Title:string='';
    ReadParam;
    if pKatPodr>0
    { BitOnW(wFilter,1);
      InsertMarker(Marker_KatPodr,pKatPodr);
      ClusterDisabledField(#wFilter,1);
      ClearFieldOption(#Filtr_KatPodr, ofSelectable);
      wc_nrec:=pKatPodr;
      if getfirst KatPodr_flt=tsok
        _Title:=_Title+' Подразд.'+Katpodr.Name;
    }
    if pMnPlan>0
    { BitOnW(wFilter,2);
      InsertMarker(Marker_MnPlan,pMnPlan);
      ClusterDisabledField(#wFilter,2);
      ClearFieldOption(#Filtr_MnPlan, ofSelectable);
      wc_nrec:=pMnPlan;
      if getfirst MnPlan_flt=tsok
        _Title:=_Title+' Заказ.'+MnPlan.Name;
    }
    if pPersons>0
    { BitOnW(wFilter,3);
      InsertMarker(Marker_Persons,pPersons);
      ClusterDisabledField(#wFilter,8);
      ClearFieldOption(#Filtr_Persons, ofSelectable);
      wc_nrec:=pPersons;
      if getfirst Persons_flt=tsok
        _Title:=_Title+' Сотрудник '+Persons.Fio;
    }
    if pLsch>0
    { BitOnW(wFilter,4);
      InsertMarker(Marker_Lschet,pLsch);
      ClusterDisabledField(#wFilter,8);
      ClearFieldOption(#Filtr_Lschet, ofSelectable);
      wc_nrec:=pLsch;
      if getfirst Lschet_flt=tsok
      {  _Title:=_Title+' Л/сч.'+GetStrTabn(Lschet_flt.Tabn,Lschet_flt.StrTabn)
      }
      //ClearFieldOption(#Filtr_Persons, ofSelectable);
    }
    if _Title<>''
    { SetTitle('Распределение по заказам:'+_Title)
    }
    //-----------------------
    MyLog('LoadInterface PAF') ;
    LoadVipRef(PAF_One, 'PersonalAccountFilter');
    MyLog('LoadInterface PickOptions');
    LoadVipRef(PickOptions, 'Z_LSCHET::VPICKOPTIONS');
    MyLog('LoadInterface PickOptions');
    Paf.InitFilter(true, true);


    //PickOptions.SetGroup(if (PP.GetDefaultDepartment = 0, -1, PP.GetDefaultDepartment));
    //SetFlags;
    PickOptions.SetCashier(Cashier);
    PickOptions.SetShowValue(true);
    PickOptions.SetDefaultValue(0);
    PickOptions.SetValuePrecision(2);
    PickOptions.SetValueTitle('Процент');
    PickOptions.SetValueDescr('Процент выплаты');
    MyLog('LoadInterface finish');
  } //Procedure LoadInterface;

  //---------------------------------------
  // ДеИнициализация интерфейса
  //---------------------------------------
  Procedure UnLoadInterface;
  { SaveParam;
    if Not NullVipRef(PickOptions)
    { FreeVipInterface(PickOptions)

    }
    if Not NullVipRef(PAF_One)
    { FreeVipInterface(PAF_One)

    }
  }

