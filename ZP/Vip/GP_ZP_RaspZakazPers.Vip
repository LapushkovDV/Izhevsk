{ closeWindowEx(wnInsertRec,cmDefault)
}
cmPick:
{ UpdateTable;
  case CurField of
  #FiltrPodr,
  #FiltrPublic:
  {
    PodrPubPick; //Процедура для фильтров по подразд. и работникам
  }
  #vPlanIns.Name :
  {  if (RunInterFace(GrvPlan,pvPlanIns,LongInt(0)
         ,17//pWorkType
         ) <> cmCancel)
      set pvPlanIns:=pvPlanIns;
  }
  #MnPlanIns.Number :
  {     if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pMnPlanIns)<>0 //cmCancel
          set pMnPlanIns:=pMnPlanIns;
  }
  end;
  ReScanPanel(#ZAR_USER);
}
end;
end;//Window wnInsertRec


