  KatPodr.Kod          'Код'#13'подразделения' ('код подразделения'                             ,,):[10],Protect,NoDel,PickButton;
  KatPodr.Name         'Подразделение'         ('подразделение сотрудника'                      ,,):[10],Protect,NoDel,PickButton;
  GP_RaspAvans.Procent 'Процент'               ('поля для ручного ввода цифрового значения (10; 15,24; 30,5 и т.д.)',,#(sciEditFld)):[6,2],#(Protect);
  MnPlan.Number        'Код'#13'заказа'        (' аналитика <Заказ>'                            ,,):[10],Protect,NoDel,PickButton;
  vPlan.Name           'Группа'#13'заказа'     (' аналитика <Заказ>'                            ,,):[10],Protect,NoDel,PickButton;
  GP_RaspAvans.Datan   'Дата'#13'начала'       ('дата начала действия записи'      ,,#(sciEditFld)):[12],#(Protect);
  GP_RaspAvans.DataOk  'Дата'#13'окончания'    ('дата окончания действия условий'  ,,#(sciEditFld)):[12],#(Protect);
  GP_RaspAvans.isArh   'Арх.'                  :[5],[List 0 'нет','да'], Protect;
  x$users.XU$FULLNAME  'Автор'                 ('Пользователь, создавший запись'   ,,#(sciEditFld)):[10],Protect,NoDel,NoPickButton;
  GP_RaspAvans.DInput  'Дата'#13'ввода'        ('дата ввода'                       ,,#(sciEditFld)):[10],Protect,NoDel,NoPickButton;
#END
Browse brRaspActive 'Активные записи' ('Активные записи ',,sci1378Esc);
#brRasp(sci178Esc,Active,NoProtect)
end;
Browse brRaspArh   'Архив' ('Архив',,sci1Esc);
#brRasp(sci1Esc,Arh,Protect)
end;
end;//TabbedSheet bottom tab_Rasp;
