  TypeZakaz            'Тип заказа'            ('Тип заказа'                       ,,#(sciEditFld)):[5],Protect,NoDel,NoPickButton
                                                                               ,{font = {backcolor = if(GP_RaspAvans.wtype = 1,7,0)}};
