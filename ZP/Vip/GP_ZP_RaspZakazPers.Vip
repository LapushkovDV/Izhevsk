Window wnInsertRec 'Задайте параметры добавления'
show at (,,70,9);
Screen scrInsert;
Table Zar_user;
Fields
   vPlanIns.Name (,,sci13Esc) : Protect,PickButton;
   MnPlanIns.Name (,,sci13Esc) : Protect,PickButton;
   Procent_Ins :noProtect;
   //-------------------------
   CurFilters//Zar_User.GrupStN
   ('Выберите фильтр для расчета',hcVshkala,sci13Esc) : noprotect;

   FiltrPodr('Заданный фильтр по подразделению',hcVshkala,sci13Esc)  : protect;
   FiltrPublic('Выберите работников для проведения расчета',hcVshkala,sci13Esc) : protect;
 buttons
    cmOk,default,, 'Выполнить функцию выбора шкалы',hcVshkala,sci1Esc;
    cmCancel,,,'~О~тмена',hcVshkala,sci1Esc;

<<
 Группа заказов.@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Гос.Заказ     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Процент       .@@@@@@@@@@@@@
 ┌─ Фильтры по: ───────────────────────────────────────────────────┐
 │ [.] подразделению ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ │
 │ [.] работникам    ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ │
 └─────────────────────────────────────────────────────────────────┘
         <.~П~родолжить.>           <.Отмена.>
>>
end;
HandleEvent
cmInit:
{ UpdateFilter;
}
