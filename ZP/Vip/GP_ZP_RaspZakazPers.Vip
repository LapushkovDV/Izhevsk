#include Marker.Vih
#include GetKau.Vih
#include Contexts.vih
#include Marks.vih
#include PAFILTER.VIH   // функц-л работы с подразделениями и тек. лицевыми
#include PmntPrms.vih   // PaymentParameters.Vih
//------------------------------------
#include GP_ZP_RaspZakazPers.Vih
//------------------------------------

#doc
Распределения заказов по работникам
#end
//------------------------------------
Interface GP_ZP_RaspZakazPers 'Распределение ФОТ работников по заказам' , EscClose;
//------------------------------------
show at (,,100,20);
table struct tmpPercPrevMonth
 (
     clSch   : comp
    ,cVplan  : comp
    ,Percent : double
 )
 with index
 (
  ind0 = clSch
 )
 ;
//------------------------------------
// декларация сложного фильтра
//------------------------------------
function isFilterAnCorrect(ww_nrec:comp): boolean; forward;

//-----------------------------------------
#include GetKau.var
//-----------------------------------------

var
//-----------------------------------------
// объекты
//-----------------------------------------
  pMarkerActive : IMarker(Marker) new; // функция пометки
  pMarkerArh    : IMarker(Marker) new; // функция пометки
//-----------------------------------------
// выбор лицевых счетов
//-----------------------------------------
  CS            : IContextSession;
  CLSF           : CurLSFunctions;
  PAF_One       : IPersonalAccountFilter; // Выбор работников
#include PAFilter.var
  PickOptions   : IPickOptions;
  Cashier:                    word;

//-----------------------------------------
  pTmp:comp;
  isOpenSearch:boolean;
  FormatClockNumber:word;//wGetTune('FormatClockNumber')
  Need_Read_Param: boolean;//Нужно читать/сохранять параметры
  CurFilters,OldFilters:word;
  Count_2_del:longint;
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
   wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;

   #mrkfld_(KatPodr)
   #mrkfld_(MnPlan)
   #mrkfld_(Persons)
   #mrkfld_(Lschet)
create view
var
  //------ Параметры ---------------
  plsch    :comp;// ссылка на лицевой счет
  pPersons :comp;// ссылка на карточку
  pKatPodr :comp;// ссылка на подразделение
  pMnPlan  :comp;// ссылка на заказ
  dDatan   :date;// заданный период c
  dDatok   :date;// заданный период по
  wisArh   :word; // 0 - активная, 1 архив
  pMnPlanIns:comp;//вставка заказа
  pvPlanIns :comp;//группа планов
  Procent_Ins:double;
  sUserName :comp;
  //----------------------------
  dOtchPer :date;//дата начала отчетного периода
as select GP_RaspAvans.Nrec
  ,PAF.GetDepartmentFilterStr() (FieldName=FiltrPodr)
  ,PAF.GetPersonalAccountFilterStr() (FieldName=FiltrPublic)
  ,if (GP_RaspAvans.wtype = 0,'Накладные',
       if(GP_RaspAvans.wtype = 1,'Прямые','!!НЕОПРЕДЕЛЕНО!!!!'
       )
      ) (FieldName=TypeZakaz)

From
  GP_RaspAvans
 ,GP_RaspAvans GP_RaspAvans_FND
 ,KatPodr
 ,Lschet
 ,Persons
 ,MnPlan
 ,Lschet  Lschet_F // Для поиска
 ,Persons Persons_F // Для поиска
 ,Lschet  Lschet_1 // костыляка  для проверки валидности
 ,Appointments Appointments_F// Для поиска
 ,X$USERS
//------- фильтры
 , KatPodr KatPodr_Flt
 , MnPlan  MnPlan_Flt
 , Persons Persons_Flt
 , Lschet  Lschet_Flt
 , ForMarks
 //------------------
 , MnPlan MnPlanIns
 , vPlan vPlanIns
 , vPlan
 , tmpPercPrevMonth
where ((
    wisArh                == GP_RaspAvans.isArh
and GP_RaspAvans.cPersons == Persons.Nrec
and GP_RaspAvans.cLschet  == Lschet.Nrec
and GP_RaspAvans.cKatPodr == KatPodr.Nrec
and GP_RaspAvans.cMnPlan  == MnPlan.Nrec
and GP_RaspAvans.cUser    == X$USERS.atl_nrec
and GP_RaspAvans.cvPlan   == vPlan.Nrec
and plsch                 == Lschet_F.Nrec
and plsch ==  GP_RaspAvans_FND.cLschet
and dDatan >>=   GP_RaspAvans_Fnd.Datan(noindex)
and (GP_RaspAvans_Fnd.Dataok=ZeroDate or GP_RaspAvans_Fnd.Dataok>dDatan)

and pPersons              == Persons_F.Nrec
and if(Persons_F.AppointCur>0,Persons_F.AppointCur,Persons_F.AppointLast) == Appointments_F.Nrec// Для поиска
and _cLschet == ForMarks.Choice
and sUserName == Zar_user.OwnName
and pvPlanIns == vPlanIns.nrec
and pMnPlanIns == MnPlanIns.nrec

//------- фильтры
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == MnPlan_Flt.Nrec
and wc_nrec == Persons_Flt.Nrec
and wc_nrec == Lschet_Flt.Nrec
//------------------------------

  ))
//На этой вкладке должны отображаться все записи таблицы, у которых дата окончания действия равна, или больше текущего отчетного периода
Bounds byActive
      wisArh                == GP_RaspAvans.isArh ordered by TableOrder
//по тз так   and (dOtchPer<GP_RaspAvans.DatOk or GP_RaspAvans.DatOk=ZeroDate)

Bounds byArh   wisArh                == GP_RaspAvans.isArh ordered by TableOrder
//по тз так  and (dOtchPer>GP_RaspAvans.DatOk or GP_RaspAvans.DatOk=ZeroDate)
Bounds ByKatpodr  pKatpodr == GP_RaspAvans.cKatpodr(noindex) ordered by TableOrder
Bounds ByMnPlan   pMnPlan  == GP_RaspAvans.cMnPlan (noindex) ordered by TableOrder
Bounds ByPersons  pPersons == GP_RaspAvans.cPersons(noindex) ordered by TableOrder
Bounds ByLschet   pLsch    == GP_RaspAvans.cLschet (noindex) ordered by TableOrder
condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_RaspAvans.Nrec))

; //create view

Parameters
  plsch
#doc
  ссылка на лицевой счет
#end
 ,pPersons
#doc
 ссылка на карточку
#end
 ,pKatPodr
#doc
 ссылка на подразделение
#end
 ,dDatan
#doc
 заданный период c
#end
 ,dDatok
#doc
 заданный период по
#end
 ,wisArh
#doc
 0 - активная, 1 архив
#end
;

