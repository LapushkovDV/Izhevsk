#component "Z_MP"

//******************************************************************************
Alter Interface avans;
//******************************************************************************


ExtendFormats BROWSECLASSICAL;
ExtendFormats lschetb;


browse BROWSECLASSICAL (, hcPAvans, scavans);
show at(,3,,);
table CURLSCHET;
Fields
  sTXOGetField('KATBANK','NAME',coTXOGetField('LSCHET','CLSCHDOP',LSCHET.NREC)) 'БАНК':[10],Protect,NoDel;
End;


browse lschetb (, hcPAvans, scavans);
show at(,3,,);
table LSCHET;
Fields
  sTXOGetField('KATBANK','NAME',coTXOGetField('LSCHET','CLSCHDOP',LSCHET.NREC)) 'БАНК':[10],Protect,NoDel;
End;


end.
