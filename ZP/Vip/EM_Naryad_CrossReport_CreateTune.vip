#include CreateTune.vih

Handler with replace EM_Naryad_CrossReport_DateModifyTune on extensionPoint
  epDateModifyTuneEx (TS: ObjStartCreateTuneEx) [1]
Action
{
  // Здесь указываем дату, когда последний раз изменяли этот файл, чтобы автоматически запускалось
  // обновление реестра настроек
  TS.SetLastDateModTuneComp('EM', 17, 8, 2018);
  Result := true;
}

Handler with replace EM_Naryad_CrossReport_CreateTune on extensionPoint
  epCreateTuneComponent (TR: ObjCreateTuneEx) [210]
Action
{
  Result := true;

  TR.SetParent('NPOEM_OWN');
  //-----------------------------------
  //-----------------------------------
  // NPOEM_OWN.ZP.NARYAD
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddPartA('NPOEM_OWN.ZP.NARYAD','Наряды','');
  TR.SetParent('NPOEM_OWN.ZP.NARYAD');

  TR.AddTuneU('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_BEG'  , 'Кросс-отчет по нарядам. День. Начало'    , ftWord,0, '','');
  TR.AddTuneU('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_BEG', 'Кросс-отчет по нарядам. Месяц. Начало'   , ftWord,0, '','');
  TR.AddTuneU('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_BEG' , 'Кросс-отчет по нарядам. Год. Начало'     , ftWord,0, '','');

  TR.AddTuneU('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_DAY_END'  , 'Кросс-отчет по нарядам. День. Окончание' , ftWord,0, '','');
  TR.AddTuneU('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_MONTH_END', 'Кросс-отчет по нарядам. Месяц. Окончание', ftWord,0, '','');
  TR.AddTuneU('NPOEM_OWN.ZP.NARYAD.CROSSREPORTNARYAD_YEAR_END' , 'Кросс-отчет по нарядам. Год. Окончание'  , ftWord,0, '','');

}
