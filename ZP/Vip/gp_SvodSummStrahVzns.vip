#include UserReport.vih

VipInterface UserReport_Gp_SvodSummStrahVzns Implements IUserReport;
Interface UserReport_Gp_SvodSummStrahVzns;

Procedure Run;
Begin
  runinterface(gp_SvodSummStrahVzns);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Сводка расчетных сумм и взносов';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по зарплате ПУ';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
