Summ4000:=0;//narast itog
Summ4000_1:=0;
Summ50000:=0;
Summ50000_1:=0;
var _year:word = if(MonthEnd+1=13,1,0)+YearFill;
var _Mes :word = if(MonthEnd+1=13,1,MonthEnd+1);
_loop PRMONTH where ((_year==PRMONTH.yearn and _Mes ==Prmonth.mesn))//учесть декабрь
{
  nextvisual;
	_loop HELPTABN where ((prmonth.nrec==Helptabn.CPRMONTH))
	{
	if helptabn.filialno<>0 continue;

	if katpodr.kod='446' or katpodr.kod='Вет' continue;

		if CKLSHLG=000A000000000001h
		{
		Summ4000:=Summ4000+HELPTABN.MONFOT-HELPTABN.MONOHELP;
		Summ4000_1:=Summ4000_1+HELPTABN.MFOT-HELPTABN.MOFOT;
		}

		if CKLSHLG=000A000000000002h
		{
		Summ50000:=Summ50000+HELPTABN.MONFOT-HELPTABN.MONOHELP;
		Summ50000_1:=Summ50000_1+HELPTABN.MFOT-HELPTABN.MOFOT;
		}
	}
}

clearbuffer(#svod);
svod.kod:=9;
svod.type:=2;
svod.sumper:=Summ4000_1;
insert current svod;

clearbuffer(#svod);
svod.kod:=9;
svod.type:=1;
svod.sumper:=Summ4000;
insert current svod;

clearbuffer(#svod);
svod.kod:=10;
svod.type:=2;
svod.sumper:=Summ50000_1;
insert current svod;

clearbuffer(#svod);
svod.kod:=10;
svod.type:=1;
svod.sumper:=Summ50000;
insert current svod;


SummPrev:=0;//Narast Itog
SummPrev_1:=0;
SummDo:=0;//Narast Itog
SummDo_1:=0;
SummPosle:=0;
SummPosle_1:=0;


_loop sumulsoc where ((YearFill==sumulsoc.year and 5==sumulsoc.vidper))
{

	if katpodr1.kod='446' or katpodr1.kod='Вет' continue;

	if (sumulsoc.strtabn='001101' and MonthEnd<3) continue;//дубровина. думать

i:=1;

	if sumulsoc.strtabn='001101' i:=3;//дубровина. думать

SummPrev_1:=SummPrev_1+sumulsoc.SUMma4[MonthEnd];
SummDo_1:=SummDo_1+sumulsoc.Summa9[MonthEnd];
SummPosle_1:=SummPosle_1+sumulsoc.SNAL[MonthEnd]-sumulsoc.Summa9[MonthEnd];


	do
	{
	SummPrev:=SummPrev+sumulsoc.SUMma4[i];
	SummDo:=SummDo+sumulsoc.Summa9[i];
	SummPosle:=SummPosle+sumulsoc.SNAL[i]-sumulsoc.Summa9[i];
	i++;
	}
	while i<=MonthEnd

}



sql
select 12,1,sum(sumvidop.summa),1
from sumvidop
left join klvidopl on sumvidop.vidopl=klvidopl.vidopl
left join katpodr on sumvidop.cexoz=katpodr.nrec
inner join lschet on sumvidop.CLSCH = lschet.nrec and d_month(lschet.dat7) <= :(MonthEnd) and d_month(lschet.dat7) <> 0
where
KLVIDOPL.VHVOE[34]='+'
and sumvidop.yearn=:(YearFill) and sumvidop.mesn=:(MonthEnd) and sumvidop.mesn >= d_month(lschet.dat7)
and sumvidop.vidopl<>106 and sumvidop.vidopl<>107 and sumvidop.vidopl<>83 and sumvidop.vidopl<>84
and katpodr.kod<>'446' and katpodr.kod<>'Вет'
into Svod;

