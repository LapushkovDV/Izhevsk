perevodtek.yearn=:(YearFill) and perevodtek.mesn >= :(MonthBeg) and perevodtek.mesn <= :(MonthEnd)
and perevodtek.vidper=8
and katpodr.kod<>'446' and katpodr.kod<>'Вет'
// что за костыль неведомый галактика нам подарила ...  and substring(katpodr.kod,1,1)<>'_'
into Svod
;




sql
select 30,1,sum(perevodtek.oblagso),2
from perevodtek
left join katpodr on perevodtek.cexoz=katpodr.nrec
where
perevodtek.yearn=:(YearFill) and perevodtek.mesn = :(MonthEnd)
and (perevodtek.vidper=11 or perevodtek.vidper=12 or perevodtek.vidper=14)
and katpodr.kod<>'446' and katpodr.kod<>'Вет'
// что за костыль неведомый галактика нам подарила ... and substring(katpodr.kod,1,1)<>'_'
into Svod
;

