SummPrev_1:=0;
SummPrev:=0;
_loop sumulsoc where ((YearFill==sumulsoc.year and 2==sumulsoc.vidper))
{

	if katpodr1.kod='446' or katpodr1.kod='Вет' continue;

	if (sumulsoc.strtabn='001101' and MonthEnd=1) continue;//дубровина. думать

i:=1;
SummPrev_1:=SummPrev_1+sumulsoc.SUMma10[MonthEnd]-sumulsoc.SUMV[MonthEnd];

	do
	{
	SummPrev:=SummPrev+sumulsoc.SUMma10[i]-sumulsoc.SUMV[i];
	i++;
	}
	while i<=MonthEnd
}

clearbuffer(#svod);
svod.kod:=23;
svod.type:=1;
svod.sumper:=SummPrev_1;
insert current svod;

