#component "Z_PAYREP"
#doc
Заработная плата - Операции - Реестры межрасчетного периода
#end
//========================================
Alter InterFace TREEREES;
//OverLoad
//временно
//end;


#include ExtAttr.var
Table Struct tNazna
(
    nrSbb : comp
  , nrPlp : comp
  , vidud : word
  , datan : date
  , datok : date
  , dform : date
  , prefix :string
  , goz : string
  , abgoz : string
  , files : string
  , bank :string
  , prizn :string
  , kol :word
  ,schet:string
)
with index
(
    i01 = nrSbb
  , i02 = nrPlp
);

//========================================
var  ATTR_SB_VPLAN:comp;//ВА Группа заказов к SBBAB
var  ATTR_SB_PRIM :comp;//ВА Примечание к SBBAB
var pvPlanIns :comp;
var sbbgoz:comp;
var mSbb :comp;
//========================================
create view X
as select KatOrg_V.Name
From KatOrg KatOrg_V
, tNazna
, plpor plp
where
((
  SbBan.cPol == KatOrg_V.Nrec
)); //Create view ReesVip

//========================================
Create view vSpr
var pOrg:comp;
as select Groups.Name
from
  KatOrgDescr Groups
, KatOrgDescr Descriptors
where ((
// для отображения списка групп, в которые входит текущая организация или группа
 /*KatOrgImp.NRec*/ pOrg    == Descriptors.cRec
and Descriptors.cGroup == Groups.NRec
));

create view SBBB
as select *
From Sbban sbbansss

where((
   sbbgoz == sbbansss.cnode
)); //Create view ReesVip

;



//------------------------------------------------------------------------------
//'L_KATORG::KATORG.GROUPSBROWSE.DESCRIPTORGROUPNAME'
Function GetGrOrg( _pOrg:comp ) :String; cacheable;
var _wExist:word;
    _KolRecs:longint;
{ Result:='';
  _wExist:=0;
  vSpr.pOrg:=_pOrg;
  _KolRecs:=0;
  vSpr._Loop fullcache Descriptors
  { if vSpr.getfirst Groups <>tsok continue;
    Result:=vSpr.GroupS.Name;
    if   Result='Зарплатный проект'   BitOnW(_wExist,1)
    else
    if Result='Индивидуальный счет' BitOnW(_wExist,2);
    _KolRecs++;
  } //vSpr._Loop fullcahce Descriptors
  if _KolRecs>1
  { if   IsBitCTW(_wExist,1)
    { Result:='Зарплатный проект';
    }
    else
    if IsBitCTW(_wExist,2)
    { Result:='Индивидуальный счет';
    }
  }
} //Function GetGrOrg( pOrg:comp ) :String;
//------------------------------------------------------------------------------
ExtendFormats brRegistry;
//------------------------------------------------------------------------------
browse brRegistry 'Реестры межрасчетного периода' (, hcSberb, sci178EscExTree_InsLevelMark);
show at (,,,22);
table SbBan;
  fields
//-- GP
    [VPLAN_NAME] sGetAttrID(coSbBan,SbBan.Nrec,ATTR_SB_VPLAN)
      'Группа заказов'('Группа заказов'):[10], protect, pickbutton, noAutoSize;
    KatOrg_v.Name
      'Получатель'('организация получатель'): [20],protect, noAutoSize,  noDel;
    [GRORG] GetGrOrg(SbBan.cPol)
      'Группа организ.'('Группа организации получателя'): [20], protect, noAutoSize, noDel;
    [SPrim] sGetAttrID(coSbBan,SbBan.Nrec,ATTR_SB_Prim)
       'Примечание' : [20], Protect,NoDel;
end;

HandleEvent
cmInit:
{ ATTR_SB_VPLAN:=ExtAttr_CreateComp(coSBBAN,'Группа заказов', cgAttrType_Comp, word(100), coVPlan );
  ATTR_SB_PRIM :=ExtAttr_Create    (coSBBAN,'Примечание'    , cgAttrType_Str);
  if  Inherited::HandleEvent(cmInit)=heAbort Abort;
}
cmPick:
{
  inherited:: handleEvent (cmPick);

   case CurField of
   #VPLAN_NAME:
   {
      if (RunInterFace(GrvPlan,pvPlanIns,LongInt(0),17) <> cmCancel)
      {
        if getfirst vplan where((pvPlanIns==vplan.nrec))=tsok
        {
          coSetAttrID(coSbBan,SbBan.Nrec,ATTR_SB_VPLAN,vplan.nrec,vplan.name);
          sbbgoz:=SbBan.Nrec;
          sbbb._loop sbbansss
          {
            coSetAttrID(coSbBan,sbbb.sbbansss.Nrec,ATTR_SB_VPLAN,vplan.nrec,vplan.name);
          }


        };
      };
   }
   end;
   ReReadRecord;

}

cmDelOnProtect:
{
  inherited:: handleEvent (cmDelOnProtect);

   case CurField of
   #VPLAN_NAME:
   {
      ExtAttr_DeleteValueID(coSbBan,SbBan.Nrec,ATTR_SB_VPLAN);
      sbbgoz:=SbBan.Nrec;
      sbbb._loop sbbansss
          {
            ExtAttr_DeleteValueID(coSbBan,sbbb.sbbansss.Nrec,ATTR_SB_VPLAN);
          }
   }
   end;
   ReReadRecord;

}
 cmValue35:
  {
    delete all from tNazna;

    _loop  MarkVipl0  where ((root==MarkVipl0.pNrec))
    {
      //message(MarkVipl0.pNrec);
      mSbb:=MarkVipl0.pNrec;
      sql
      select sbban.nrec
            ,plpor.nrec
            ,sbban.vidud
            ,sbban.datan
            ,sbban.datok
            ,sbban.dform
            ,sbban.prefix
            ,avGoz.vstring
            ,abGoz.vstring
            ,avFile.vstring
            ,katorg.name
            ,case when katorg.KODPLATNDS='' then case when katorg.codes[20]='+' then '2' else '1'  end else '0'  end
            ,count(rr.tab)
            ,bank.schet1
      from sbban
      join docpodot on 3=docpodot.tipdoc and docpodot.cvtdoc=sbban.nrec
      join plpor on plpor.nrec=docpodot.cprdoc
      left join attrval avGoz on 16060=avGoz.wtable and #comp(000A000000000073h)=avGoz.cattrnam and sbban.nrec=avGoz.crec
      left join attrval abGoz on 31015=abGoz.wtable and #comp(000A000000006FC6h)=abGoz.cattrnam and avGoz.vcomp=abGoz.crec
      left join attrval avFile on 16060=avFile.wtable and #comp(000A000000000723h)=avFile.cattrnam and sbban.nrec=avFile.crec
      left join attrval avBank on 31015=avBank.wtable and #comp(00010000000001C0h)=avBank.cattrnam and avGoz.vcomp=avBank.crec
      left join katbank bank on bank.nrec=avBank.vcomp
      left join katorg on sbban.cpol=katorg.nrec
      outer apply( select distinct spp.tperson as tab
      from spplban spp
      where spp.csbban=sbban.nrec
      )as rr
      where sbban.nrec=:(mSbb) and sbban.prefix<>'R$$'
      group by sbban.nrec
            ,plpor.nrec
            ,sbban.vidud
            ,sbban.datan
            ,sbban.datok
            ,sbban.dform
            ,sbban.prefix
            ,avGoz.vstring
            ,abGoz.vstring
            ,avFile.vstring
            ,katorg.name
            ,case when katorg.KODPLATNDS='' then case when katorg.codes[20]='+' then '2' else '1'  end else '0'  end
            ,bank.schet1
      into tNazna;
       RereadRecord(tntNazna);

       //для групповых реестров
       sql
      select sbban.nrec
            ,plpor.nrec
            ,sbban.vidud
            ,sbban.datan
            ,sbban.datok
            ,sbban.dform
            ,sbb.prefix
            ,avGoz.vstring
            ,abGoz.vstring
            ,avFile.vstring
            ,katorg.name
            ,case when katorg.KODPLATNDS='' then case when katorg.codes[20]='+' then '2' else '1'  end else '0'  end
            ,count(rr.tab)
            ,bank.schet1
      from sbban
      join sbban sbb on sbb.cnode=sbban.nrec
      join docpodot on 3=docpodot.tipdoc and docpodot.cvtdoc=sbb.nrec
      join plpor on plpor.nrec=docpodot.cprdoc
      left join attrval avGoz on 16060=avGoz.wtable and #comp(000A000000000073h)=avGoz.cattrnam and sbban.nrec=avGoz.crec
      left join attrval abGoz on 31015=abGoz.wtable and #comp(000A000000006FC6h)=abGoz.cattrnam and avGoz.vcomp=abGoz.crec
      left join attrval avFile on 16060=avFile.wtable and #comp(000A000000000723h)=avFile.cattrnam and sbban.nrec=avFile.crec
      left join attrval avBank on 31015=avBank.wtable and #comp(00010000000001C0h)=avBank.cattrnam and avGoz.vcomp=avBank.crec
      left join katbank bank on bank.nrec=avBank.vcomp
      left join katorg on sbban.cpol=katorg.nrec
      outer apply( select distinct spp.tperson as tab
      from spplban spp
      where spp.csbban=sbb.nrec
      )as rr
      where sbban.nrec=:(mSbb) and sbban.prefix='R$$'
      group by sbban.nrec
            ,plpor.nrec
            ,sbban.vidud
            ,sbban.datan
            ,sbban.datok
            ,sbban.dform
            ,sbb.prefix
            ,avGoz.vstring
            ,abGoz.vstring
            ,avFile.vstring
            ,katorg.name
            ,case when katorg.KODPLATNDS='' then case when katorg.codes[20]='+' then '2' else '1'  end else '0'  end
            ,bank.schet1
      into tNazna;

      RereadRecord(tntNazna);
    }

    var ln3,ln2:longint;

    //message(recordsintable(tntNazna));
    if recordsintable(tntNazna)>0
    {
      _loop tNazna
      {

        //message(tNazna.prefix);
        if getfirst plp where ((tnazna.nrPlp==plp.nrec))=tsOk
        {
          case tNazna.bank of
          'ПАО "Промсвязьбанк"':
            {

              case tNazna.prefix of
              'R$Z':
              {
                set plp.NAMEPL1:='HK491, Пер. денежных средств Резидентам'+'//Реестр//№'+substr(tNazna.files,1,12)+', от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+' г.,';
                set plp.NAMEPL2:='кол-во '+tNazna.kol+', по Дог  №68153-09-20-01 от 21.09.2020г.'+' з/п за  2 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+'. НДФЛ удержан';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;

              }
               'R$A':
              {
                set plp.NAMEPL1:='HK491, Пер. денежных средств Резидентам'+'//Реестр//№'+substr(tNazna.files,1,12)+', от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+' г.,';
                set plp.NAMEPL2:='кол-во '+tNazna.kol+', по Дог  №68153-09-20-01 от 21.09.2020г.'+' з/п за  1 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+'. НДФЛ удержан';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RO':
              {
                set plp.NAMEPL1:='HK491, Пер. денежных средств Резидентам'+'//Реестр//№'+substr(tNazna.files,1,12)+', от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+' г.,';
                set plp.NAMEPL2:='кол-во '+tNazna.kol+', по Дог  №68153-09-20-01 от 21.09.2020г.'+' Отпускные. НДФЛ удержан';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RB':
              {
                set plp.NAMEPL1:='HK491, Пер. денежных средств Резидентам'+'//Реестр//№'+substr(tNazna.files,1,12)+', от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+' г.,';
                set plp.NAMEPL2:='кол-во '+tNazna.kol+', по Дог  №68153-09-20-01 от 21.09.2020г.'+' Больничные. НДФЛ удержан';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
                'RV':
              {
                set plp.NAMEPL1:='HK491, Пер. денежных средств Резидентам'+'//Реестр//№'+substr(tNazna.files,1,12)+', от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+' г.,';
                set plp.NAMEPL2:='кол-во '+tNazna.kol+', по Дог  №68153-09-20-01 от 21.09.2020г.'+' Матпомощь';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }

              end;
            }
            'ПАО "Сбербанк"':
            {
                  if substr(tNazna.files,Length(tNazna.files)-6,1) ='0'
              {
                ln3:=Length(tNazna.files)-5;
                ln2:=1;
              }
              else
              {
                ln3:=Length(tNazna.files)-6;
                ln2:=2;
              }

              case tNazna.prefix of
              'R$Z':
              {
                set plp.NAMEPL1:='Пер. з/п за 2 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+', сотр. АО НПО Энергомаш '+'на счета карт согласно ';
                set plp.NAMEPL2:='Договору №40440150 от 22.12.2015г. по реестру №'+substr(tNazna.files,ln3,ln2)+' от '+DateToStr(tNazna.dform,'DD.MM.YYYY')+'. НДФЛ удержан.';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;

              }
               'R$A':
              {
                set plp.NAMEPL1:='Пер. з/п за 1 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+', сотр. АО НПО Энергомаш '+'на счета карт согласно';
                set plp.NAMEPL2:=' Договору №40440150 от 22.12.2015г. по реестру №'+substr(tNazna.files,ln3,ln2)+' от '+DateToStr(tNazna.dform,'DD.MM.YYYY')+'. НДФЛ удержан.';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RO':
              {
                set plp.NAMEPL1:='Пер. отпускных сотр. АО НПО Энергомаш'+' на счета карт согласно';
                set plp.NAMEPL2:=' Договору №40440150 от 22.12.2015г. по реестру №'+substr(tNazna.files,ln3,ln2)+' от '+DateToStr(tNazna.dform,'DD.MM.YYYY')+'. НДФЛ удержан.';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RB':
              {
                set plp.NAMEPL1:='Пер. больничных сотр. АО НПО Энергомаш'+' на счета карт согласно';
                set plp.NAMEPL2:=' Договору №40440150 от 22.12.2015г. по реестру №'+substr(tNazna.files,ln3,ln2)+' от '+DateToStr(tNazna.dform,'DD.MM.YYYY')+'. НДФЛ удержан.';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
                'RV':
              {
                set plp.NAMEPL1:='Пер. матпомощи за '+DateToStr(tNazna.datan,'MM.YYYY')+', сотр. АО НПО Энергомаш'+' на счета карт согласно';
                set plp.NAMEPL2:=' Договору №40440150 от 22.12.2015г. по реестру №'+substr(tNazna.files,ln3,ln2)+'. ';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }

              end;
            }

            'Банк ВТБ (ПАО)':
            {

              case tNazna.prefix of
              'R$Z':
              {
                set plp.NAMEPL1:='Пер. з/п за 2 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+', на основании зарплатного проекта'+' ЗП-2021-0100/24от 19.07.2021';
                set plp.NAMEPL2:='Реестр '+substr(tNazna.files,1,21)+substr(tNazna.files,Length(tNazna.files)-9,6)+' от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+'.'+' Все налоги уплачены';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;

              }
               'R$A':
              {
                set plp.NAMEPL1:='Пер. з/п за 1 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+', на основании зарплатного проекта'+' ЗП-2021-0100/24от 19.07.2021';
                set plp.NAMEPL2:='Реестр '+substr(tNazna.files,1,21)+substr(tNazna.files,Length(tNazna.files)-9,6)+' от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+'.'+' Все налоги уплачены';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RO':
              {
                set plp.NAMEPL1:='Пер. отпускных, на основании зарплатного проекта'+' ЗП-2021-0100/24от 19.07.2021';
                set plp.NAMEPL2:='Реестр '+substr(tNazna.files,1,21)+substr(tNazna.files,Length(tNazna.files)-9,6)+' от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+'.'+' Все налоги уплачены';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RB':
              {
                set plp.NAMEPL1:='Пер. больничных, на основании зарплатного проекта'+' ЗП-2021-0100/24от 19.07.2021';
                set plp.NAMEPL2:='Реестр '+substr(tNazna.files,1,21)+substr(tNazna.files,Length(tNazna.files)-9,6)+' от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+'.'+' Все налоги уплачены';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
                'RV':
              {
                set plp.NAMEPL1:='Пер. матпомощи, на основании зарплатного проекта'+' ЗП-2021-0100/24от 19.07.2021';
                set plp.NAMEPL2:='Реестр '+substr(tNazna.files,1,21)+substr(tNazna.files,Length(tNazna.files)-9,6)+' от '+DateToStr(tNazna.datok,'DD.MM.YYYY')+'.'+' Все налоги уплачены';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }

              end;
            }

            'Банк ГПБ (АО)':
            {

              case tNazna.prefix of
              'R$Z':
              {
                set plp.NAMEPL1:='Пер. з/п за 2 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+','+'согласно //реестру//'+substr(tNazna.files,1,Length(tNazna.files)-5)+' от '+substr(tNazna.files,6,2)+'.'+substr(tNazna.files,4,2)+'.20'+substr(tNazna.files,2,2);
                set plp.NAMEPL2:='дог 985-12-370/12675 от 04.09.2012, кол распоряжений,'+'вкл в //реестр//'+tNazna.kol+'. НДФЛ удержан';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;

              }
               'R$A':
              {
                set plp.NAMEPL1:='Пер. з/п за 1 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+','+'согласно //реестру//'+substr(tNazna.files,1,Length(tNazna.files)-5)+' от '+substr(tNazna.files,6,2)+'.'+substr(tNazna.files,4,2)+'.20'+substr(tNazna.files,2,2);
                set plp.NAMEPL2:='дог 985-12-370/12675 от 04.09.2012, кол распоряжений,'+'вкл в //реестр//'+tNazna.kol+'. НДФЛ удержан';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RO':
              {
                set plp.NAMEPL1:='Пер. отпускных, '+'согласно //реестру//'+substr(tNazna.files,1,Length(tNazna.files)-5)+' от '+substr(tNazna.files,6,2)+'.'+substr(tNazna.files,4,2)+'.20'+substr(tNazna.files,2,2);
                set plp.NAMEPL2:='дог 985-12-370/12675 от 04.09.2012, кол распоряжений,'+'вкл в //реестр//'+tNazna.kol+'. НДФЛ удержан';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RB':
              {
                set plp.NAMEPL1:='Пер. больничных, '+'согласно //реестру//'+substr(tNazna.files,1,Length(tNazna.files)-5)+' от '+substr(tNazna.files,6,2)+'.'+substr(tNazna.files,4,2)+'.20'+substr(tNazna.files,2,2);
                set plp.NAMEPL2:='дог 985-12-370/12675 от 04.09.2012, кол распоряжений,'+'вкл в //реестр//'+tNazna.kol+'. НДФЛ удержан';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
                'RV':
              {
                set plp.NAMEPL1:='Перевод матпомощи, '+'согласно //реестру//'+substr(tNazna.files,1,Length(tNazna.files)-5)+' от '+substr(tNazna.files,6,2)+'.'+substr(tNazna.files,4,2)+'.20'+substr(tNazna.files,2,2);
                set plp.NAMEPL2:='дог 985-12-370/12675 от 04.09.2012, кол распоряжений,'+'вкл в //реестр//'+tNazna.kol+'.';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }

              end;
            }
             'Росбанк филиал Акционерного общества "ТБанк"':
            {
              if substr(tNazna.files,Length(tNazna.files)-6,1) ='0'
              {
                ln3:=Length(tNazna.files)-5;
                ln2:=1;
              }
              else
              {
                ln3:=Length(tNazna.files)-6;
                ln2:=2;
              }

              case tNazna.prefix of
              'R$Z':
              {
                set plp.NAMEPL1:='Пер. з/п за 2 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+'сотр. АО НПО Энергомаш,'+'по дог.№8718121509 от 08.12.2015 согл. ';
                set plp.NAMEPL2:='реестру № '+substr(tNazna.files,ln3,ln2)+' от '+DateToStr(tNazna.dform,'DD.MM.YYYY')+','+' общее кол-во платежей '+tNazna.kol+'. НДФЛ удержан. ';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;

              }
               'R$A':
              {
                  set plp.NAMEPL1:='Пер. з/п за 1 пол. '+DateToStr(tNazna.datan,'MM.YYYY')+'сотр. АО НПО Энергомаш,'+'по дог.№8718121509 от 08.12.2015 согл. ';
                set plp.NAMEPL2:='реестру № '+substr(tNazna.files,ln3,ln2)+' от '+DateToStr(tNazna.dform,'DD.MM.YYYY')+','+' общее кол-во платежей '+tNazna.kol+'. НДФЛ удержан. ';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RO':
              {
                set plp.NAMEPL1:='Перевод отпускных сотр. АО НПО Энергомаш,'+'по дог.№8718121509 от 08.12.2015 согл. ';
                set plp.NAMEPL2:='реестру № '+substr(tNazna.files,ln3,ln2)+' от '+DateToStr(tNazna.dform,'DD.MM.YYYY')+','+' общее кол-во платежей '+tNazna.kol+'. НДФЛ удержан. ';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RB':
              {
                set plp.NAMEPL1:='Перевод больничных сотр. АО НПО Энергомаш,'+'по дог.№8718121509 от 08.12.2015 согл. ';
                set plp.NAMEPL2:='реестру № '+substr(tNazna.files,ln3,ln2)+' от '+DateToStr(tNazna.dform,'DD.MM.YYYY')+','+' общее кол-во платежей '+tNazna.kol+'. НДФЛ удержан. ';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
                'RV':
              {
                set plp.NAMEPL1:='Пер. матпомощи за '+DateToStr(tNazna.datan,'MM.YYYY')+'сотр. АО НПО Энергомаш,'+'по дог.№8718121509 от 08.12.2015 согл. ';
                set plp.NAMEPL2:='реестру № '+substr(tNazna.files,ln3,ln2)+' от '+DateToStr(tNazna.dform,'DD.MM.YYYY')+','+' общее кол-во платежей '+tNazna.kol+'. ';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }

              end;
            }
            else
            {
              if tNazna.prizn=1
              {
                case tNazna.prefix of
               'R$Z':
              {
                set plp.NAMEPL1:='Перечисление зарплаты за 2 половину '+DateToStr(tNazna.datan,'mon YYYY')+'. НДФЛ удержан. '+tNazna.goz;
                set plp.NAMEPL2:='';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;

              }
               'R$A':
              {
                set plp.NAMEPL1:='Перечисление зарплаты за 1 половину '+DateToStr(tNazna.datan,'mon YYYY')+'. НДФЛ удержан. '+tNazna.goz;
                set plp.NAMEPL2:='';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RO':
              {
                set plp.NAMEPL1:='Перечисление отпускных за '+DateToStr(tNazna.datan,'mon YYYY')+'. НДФЛ удержан. '+tNazna.goz;
                set plp.NAMEPL2:='';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
               'RB':
              {
                set plp.NAMEPL1:='Перечисление отпускных за '+DateToStr(tNazna.datan,'mon YYYY')+'. НДФЛ удержан. '+tNazna.goz;
                set plp.NAMEPL2:='';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
                'RV':
              {
                set plp.NAMEPL1:='Перечисление единовременной выплаты мобилизованному '+DateToStr(tNazna.datan,'mon YYYY')+'. НДФЛ удержан.';
                set plp.NAMEPL2:='';
                set plp.NAMEPL3:='';
                set plp.NAMEPL4:=tNazna.schet;
                update current plp;
              }
              end;

              }

            }


          end;


        }
      }
      message('Назначения сформированны');
    }


  }
   cmValue36:
  {
    oExtAttr.Pick(true,coSbBan,SbBan.Nrec);
  }


  cmExp:
{
  var m: TPtr = InitMarker('', 8, 1, 1);
  MarkVipl0.ExportTo(m);
  if GetMarkerCount(m) = 0
    InsertMarker(m, SbBan.NRec);
  RunInterface('GP_ZP::GP_ReesBVipBatchExport', m);
  DoneMarker(m, '');
}

end;
end.
