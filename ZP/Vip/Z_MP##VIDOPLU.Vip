#component "Z_MP"
#Doc
Интерфейс на таблицу  VIDOPLU 'Выбор видов оплат'
2017-09-11 Добавление быстрого выбора
#end
Alter InterFace VIDOPLU;
QuickChoice qcKau_Needed
{
  AcceptField = KlVIDOPL.Vidopl;
  ViewField = KlVIDOPL.VidoplP;
  ViewField = KlVIDOPL.NVidopl;
  // только текстовый поля!
  SearchField = KlVIDOPL.NVidopl;
  OnOpen : {
  }
  OnClose : {
    PaymentKind := KLVIDOPL.VIDOPL;
  }
}
QuickChoice qcKau_Needed_Name
{
  AcceptField = KlVIDOPL.Vidopl;
  ViewField = KlVIDOPL.NVidopl;
  ViewField = KlVIDOPL.VidoplP;
  SearchField = KlVIDOPL.NVidOpl;
  OnOpen : {
  }
  OnClose : {
     PaymentKind := KLVIDOPL.VIDOPL;
  }
}

