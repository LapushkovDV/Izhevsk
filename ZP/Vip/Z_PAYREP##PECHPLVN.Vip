#component "Z_PAYREP"
#doc
 ЗП - отчеты - расчеты по оплате труда - Платежная ведомость - печать
#end
Alter interface PECHPLVN;
//---------------------------------
OverLoad
  function ButtonStatus: boolean;
end;

//---------------------------------
var
	Schet_Korr:string;// Корреспондирующий счет - текстовое поле, по умолчанию <70>
	DTRAS_B,DTRAS_E:date;// Расчетный период - период дат
	Nazn_Vipl:string;// Назначение выплаты - длинное текстовое поле
	Dgn_ruk:string;
	Dgn_Buh:string;
	Dgn_Exe:string;
	Dov_ruk:string;
	Dov_Buh:string;
	Dov_Exe:string;

//---------------------------------
Procedure SaveParam;
{ SaveMyDsk(Schet_Korr, 'PECHPLVN_Schet_Korr'     ) ;// Корреспондирующий счет - текстовое поле, по умолчанию <70>
	SaveMyDsk(DTRAS_B   , 'PECHPLVN_Schet_DTRAS_B'  ) ;
  SaveMyDsk(DTRAS_E   , 'PECHPLVN_Schet_DTRAS_E'  ) ; // Расчетный период - период дат
	SaveMyDsk(Nazn_Vipl , 'PECHPLVN_Schet_Nazn_Vipl') ; // Назначение выплаты - длинное текстовое поле)

  SaveMyDsk(Dgn_ruk , 'PECHPLVN_Dgn_ruk') ; 
  SaveMyDsk(Dgn_Buh , 'PECHPLVN_Dgn_Buh') ; 
  SaveMyDsk(Dgn_Exe , 'PECHPLVN_Dgn_Exe') ; 
  SaveMyDsk(Dov_ruk , 'PECHPLVN_Dov_ruk') ; 
  SaveMyDsk(Dov_Buh , 'PECHPLVN_Dov_Buh') ; 
  SaveMyDsk(Dov_Exe , 'PECHPLVN_Dov_Exe') ; 
}

//---------------------------------
Procedure ReadParam;
{ if not ReadMyDsk(Schet_Korr, 'PECHPLVN_Schet_Korr'     ,false) Schet_Korr:='70' ;
	if not ReadMyDsk(DTRAS_B   , 'PECHPLVN_Schet_DTRAS_B'  ,false) DTRAS_B:=Cur_Date;
  if not ReadMyDsk(DTRAS_E   , 'PECHPLVN_Schet_DTRAS_E'  ,false) DTRAS_E:=Cur_Date;
	if not ReadMyDsk(Nazn_Vipl , 'PECHPLVN_Schet_Nazn_Vipl',false) Nazn_Vipl:='';

  if not ReadMyDsk(Dgn_ruk   , 'PECHPLVN_Dgn_ruk'  ,false) Dgn_ruk:='';
  if not ReadMyDsk(Dgn_Buh   , 'PECHPLVN_Dgn_Buh'  ,false) Dgn_Buh:='';
  if not ReadMyDsk(Dgn_Exe   , 'PECHPLVN_Dgn_Exe'  ,false) Dgn_Exe:='';
  if not ReadMyDsk(Dov_ruk   , 'PECHPLVN_Dov_ruk'  ,false) Dov_ruk:='';
  if not ReadMyDsk(Dov_Buh   , 'PECHPLVN_Dov_Buh'  ,false) Dov_Buh:='';
  if not ReadMyDsk(Dov_Exe   , 'PECHPLVN_Dov_Exe'  ,false) Dov_Exe:='';
}

//------------------------------------------------------------------------------
// Статус кнопки True- Excel
//------------------------------------------------------------------------------
function ButtonStatus: boolean;
{  //#1714.4 При печати объединенной платежной ведомости выводить то же окно параметров формирования,
   //        что и для обычной платежной ведомости.
   // в cmInit интерфейса
   //  WinParam := if ((prVip < 20) or (prVip = 99),1, 2 );
   if prVip = 100
   { set WinParam :=1 ;
   }
   Result:=Inherited::ButtonStatus;
} //function ButtonStatus: boolean;


//****************************************************************8
ExtendFormats  sParPlVed1;
ExtendFormats  sParPlVed1_dop;
//ExtendFormats  SPARPLVED2;
//****************************************************************8
window WParPlVed 'Параметры печати платежной ведомости' (, hcParPrintPlVed, ) escclose, gray;
    show at (5, 1, 81, 23);
panel pSortPick;
table zar_user;
Screen sParPlVed1 'Настройки печати' ;
  fields
	  Schet_Korr ('Корреспондирующий счет - текстовое поле, по умолчанию <70>'): NoProtect;
	  DTRAS_B    ('Расчетный период - период дат, начало      ') : NoProtect;
    DTRAS_E    ('Расчетный период - период дат, окончание   ') : NoProtect;
	  Nazn_Vipl  ('Назначение выплаты - длинное текстовое поле') : NoProtect;
<< 'Параметры печати платежной ведомости'









                            Корр.счет  .@@@@@@
                            Расч.Период.@@@@@@@@@@-.@@@@@@@@@@
                            Назначение .@@@@@@@@@@@@@@@@@@@@@@






>>
end;//sParPlVed1
Screen sParPlVed1_dop 'Параметры для сведений на бумаге';
  fields
    Dgn_ruk ('Должность',hcParPrintPlVed,sci1Esc): noprotect;
    Dov_ruk ('Должность',hcParPrintPlVed,sci1Esc): noprotect;
    Dgn_Buh ('Должность',hcParPrintPlVed,sci1Esc): noprotect;
    Dov_Buh ('Доверенность',hcParPrintPlVed,sci1Esc): noprotect;
    Dgn_Exe ('Доверенность',hcParPrintPlVed,sci1Esc): noprotect;
    Dov_Exe ('Доверенность',hcParPrintPlVed,sci1Esc): noprotect;
<<
                                                       Должность               Доверенность
                                               .@@@@@@@@@@@@@@@@@@@@@@@  .@@@@@@@@@@@@@@@@@@@@@@@
                                               .@@@@@@@@@@@@@@@@@@@@@@@  .@@@@@@@@@@@@@@@@@@@@@@@
                                               .@@@@@@@@@@@@@@@@@@@@@@@  .@@@@@@@@@@@@@@@@@@@@@@@








>>
end; // screen
HandleEvent
  cmCheckField:
  { if  inherited :: handleEvent (cmCheckField)=heAbort then Abort;

    case CurField of
    #VidPlVed:
    { //---- по стандарту ButtonStatus вызывается в cmValue1, но что то он не всегда пашет
      ButtonStatus;
      //------------------------------
      // IsFormT53 определяется  в ButtonStatus
      if IsFormT53 and toc = 0// если полная для Росси
      {
        SetFieldState(#InfoField1, sfVisible);
        SetFieldState(#InfoField2, sfVisible);
        SetFieldState(#FormType, sfVisible);
      }
      else
      {
        ClearFieldState(#InfoField1, sfVisible);
        ClearFieldState(#InfoField2, sfVisible);
        ClearFieldState(#FormType, sfVisible);
      }
       ReScanPanel(#zar_user);

    }
    end;
  }
end;//HandleEvent panel pSortPick;
end;//panel pSortPick;
HandleEvent
//------------------
cmInit:
{  ReadParam;
   //#1714.4 При печати объединенной платежной ведомости выводить то же окно параметров формирования,
   //        что и для обычной платежной ведомости.
   // в cmInit интерфейса
   //  WinParam := if ((prVip < 20) or (prVip = 99),1, 2 );
   if prVip = 100
   { set WinParam :=1 ;

   }

   //----------------------------
   if Zar_User.RVal_7=0 set Zar_User.RVal_7:=9; //глубина иерархии
   if  inherited :: handleEvent (cmInit)=heAbort then Abort;
   ReScanPanel(#zar_user);

   cfsSetProp('i_SPARPLVED1_DOP_FIO_RUK','Size_X',257); 
   cfsSetProp('i_SPARPLVED1_DOP_FIO_BUH','Size_X',257); 
   cfsSetProp('i_SPARPLVED1_DOP_FIO_EXE','Size_X',257); 
}
//------------------
cmDone:
{ SaveParam;
  if  inherited :: handleEvent (cmDone)=heAbort then Abort;
}
//------------------
cmOk:
{ SaveParam;
  if  inherited :: handleEvent (cmOk)=heAbort then Abort;
}

end;
end;//window WParPlVed
end.
