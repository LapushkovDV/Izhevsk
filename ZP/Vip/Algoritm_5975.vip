#include AlgCalc.vih
#include oAlgFldSys.vih
#include TMnPlan.vih
#include oAlgInDocList.vih
#include Algor.vih
#include StatLog.vih
#include GP_Log.vih
#include GP_Naryad2PotrTrud.Vih


#component "M_MnPlan"
#doc
Настройка алгоритма
Контроль данных  "Потребности в материальных ресурсах" на основе данных нарядов
Контур/Модуль: Планирование Производства
<p>#3895
#end

VipInterface Algoritm_5975 Implements oAlgoritm_Sys;
Interface Algoritm_5975;
#include GP_Naryad2PotrTrud.var
Create view
Var
 nrecFormPl    : Comp;//Настройка алгоритма
 pDoc          : Comp;//ссылка на документ
As Select FormPl.NRec
From
  FormPl
 ,MnPlan
Where
((
      nrecFormPl    == FormPl.NRec
  and pDoc == MnPlan.Nrec
));

//------------------------
//Номер системного алгоритма
Function GetNum: Word;
{ GetNum := 5975;
}

//------------------------
Function GetName: String;
{ GetName := '3895.Контроль потребности в трудовых ресурсах';
}

//------------------------
Function GetMemo(st: oSteckCommonString): Boolean;
{ GetMemo := True;
  st.Push(GetName);
  st.Push('    На основе данных нарядов');
  st.Push('    Заработная плата -> Операции -> НПО Энергомаш -> Просмотр нарядов <Энергомаш>');
  st.Push('    ======================');
End;

//------------------------
Function GetNameInter: String;
{ GetNameInter := 'Algoritm_'+GetNum;
}

//------------------------
Function GetNameInterPr: String;
{ GetNameInterPr := 'Algoritm_'+GetNum+'_Setup';
}

//------------------------
Function InitInter(Var pt: TRecAcc): Boolean;
{#__UNUSED__(pt)
 InitInter := True;
}

//------------------------
// Записать в лог
Procedure MyWriteLog(_wmes:string);
{ pGP_Naryad2PotrTrud.WriteLog(_wmes);
} //Procedure MyWriteLog(_wmes:string);

//------------------------
//Запуск алгоритма
Function RunInter(wflag: Word; Var pt: TRecAcc): Boolean;
{ #__UNUSED__(wflag,pt)
  Var i           : LongInt;
  Var isShowLog   : Boolean;//Вести и показать лог-файл смены статуса
  var isAllOk     : boolean=true;
  RunInter  := False;
  isShowLog  := True;
  nrecFormPl := pt.cFormPl;
  //Настройка алгоритма
  If(GetFirst FastFirstRow FormPl = TsOk)
  { isShowLog := (FormPl.resLngInt[1]<>0);//
  }
  pGP_Naryad2PotrTrud.InitLog(if(isShowLog,'GP_Naryad2PotrTrud.txt',''));


  //Настройка алгоритма
  do {
    If(GetFirst FastFirstRow FormPl <> TsOk)
    { Message('Не найдена настройка алгоритма (pt.cFormPl): '+pt.cFormPl);
      //если нет настройки для статуса
      pt.Binding:=8;
      break;
    }
    //pDoc:=pt.cpNrec;
    //pt.stSpMnPlan.NRec
    pDoc:=pt.cMnPlan;
    If(isShowLog){MyWriteLog('Номер настройки алгоритма (pt.cFormPl): '+pt.cFormPl);}
    If(isShowLog){MyWriteLog('Номер ссылки (pt.cpNrec): '+pt.cpNrec);}
    If(isShowLog){MyWriteLog('Тип ссылки (pt.TypeCpNrec): '+pt.TypeCpNrec);}
    If(isShowLog){MyWriteLog('ссылка на план '+string(pDoc,0,0));}

    if getfirst MnPlan<>tsok
    { If(isShowLog){MyWriteLog('Не нашли потребность ');}

    }
    else
    { If(isShowLog){MyWriteLog('Пересчитываем потребность '+MnPlan.Number+' '+MnPlan.Name);}

      if not pGP_Naryad2PotrTrud.CheckDoc(pDoc,MnPlan.cKatPodr,MnPlan.STARTDATE)
      {   pt.Binding:=8;
      }
    }
  } while false;//
  If(isShowLog)   pGP_Naryad2PotrTrud.InitLog('');

} //Function RunInter(wflag: Word; Var pt: TRecAcc): Boolean;

End.
