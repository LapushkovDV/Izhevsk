/*************************************************************************************************\
* Наименование: ZarAPI алгоритм "Расчет 64 вида оплаты"                           *
* Контур/Модуль: Заработная плата                                                                 *
* Пункт меню: Настройка / Заполнение каталогов / Виды оплат и скидок                              *
* Примечание:                                                                                     *
* Для использования нужно создать спец.алгоритм со следующим содержанием:                         *
* ZARALG('GP_ZP::GP_64vid')                                             *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |              |03/10/17|Плинда Н.А.              |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_Zar"
#include ZarAlg.vih

VipInterface zarAlgorithm_GP_64vid  implements IZarAlgorithm licensed(free);

interface zarAlgorithm_GP_64vid;
var
    pShowLog: Boolean;
    pRejim: Word;
    pYear: Word;
    DayNach:integer;
    DayEnd:integer;
    Kolvo:integer;
    Dlina:double;


create view
var
    pLschet:comp;
    wMes,wYear:word;
  as select Lschet.Nrec
    from
      lstab, Lschet,klrejim,GP_KlRejim,GP_PrCal
      ,variance
    where ((
      pLschet == Lschet.Nrec
   and lschet.rejim==klrejim.rejim
   and klrejim.nrec==GP_KlRejim.cKlRejim
   and GP_KlRejim.cGP_PrCal == GP_PrCal.NRec
   and lschet.nrec==lstab.clschet
   and wYear==lstab.yearn

   and wMes==lstab.mesn
    ))
      ;

  public function CalcSum(Parameter: string): double;
  {
    result := 0;

  	DayNach:=day(uch_datan);
	  DayEnd:=day(uch_datok);
    pLschet:=uch_lsch;
    wMes  :=month(uch_datan);
    wYear :=year(uch_datan);
	if getfirst lschet=tsok // where ((uch_lsch==lschet.nrec))=tsok
	{
		if lschet.sisopl<>20 or lschet.sovm=3
		{
		result := 0;
		}
		else
		{
		kolvo:=0;
			if getfirst lstab =tsok // where ((lschet.nrec==lstab.clschet and year(uch_datan)==lstab.yearn and month(uch_datan)==lstab.mesn))=tsok
			{
				do
				{
					if lstab.days[DayNach]='В'
					{

            // проверляем наличие отклонения
            if getfirst variance where((lstab.nrec == variance.clstab and DayNach>>=variance.beginning(noindex) and DayNach<<=variance.ending(noindex)))=tsOk
            {

              if variance.cuo<>comp(0001000000000001h) and variance.cuo<>comp(0000000000000006h)// если не НН и не ДО тогда прибавляем дни
              {

                Kolvo++;
              }
            }
            else
            {

              Kolvo++;
            }
					}

				DayNach++;
				}
				while DayNach<=DayEnd
			}

			if getfirst klrejim=tsok // where ((lschet.rejim==klrejim.rejim))=tsok
			{
				if getfirst GP_KlRejim=tsok // where ((klrejim.nrec==GP_KlRejim.cKlRejim))=tsok
				{
				        if getfirst GP_PrCal=tsok // where ((GP_KlRejim.cGP_PrCal == GP_PrCal.NRec))=tsok
					{
					Dlina:=round(GP_PrCal.WEEKLENGTH/5,0);
					}
				}
			          
			}



    //logstrtofile('summ64.txt','кол дней'+ kolvo);
		result:=Dlina*lschet.tarif*kolvo/2;
		}
	}	    
  }	

  function GetDescription: string;
  {
    result := 'Доплата за нерабочие праздничные дни';
  }

end.
