#doc
Функции по заработной плате
#3574 функционал замены ссылок на ПС в модуле Заработная плата, для перехода с одного ПС на другой.
#end
//************************************
Interface GP_Func_ZP;
//************************************
Create View
var
 pBuhSchet:comp;
 pMnPlan  :comp;
 pPLansSch:comp;
 sSch   :string;
 sSubsch:string;
From
   BuhSchet
  ,BuhSchet BuhSchet_cur
  ,MnPlan
  ,PLansSch
where ((
    pBuhSchet == BuhSchet.Nrec
and sSch      == BuhSchet_cur.SCHET
and sSubsch   == BuhSchet_cur.Subsch

and pMnPlan   == MnPlan.Nrec
and pPLansSch == PLansSch.Nrec
));


Constructor Init;
{ Result:=True;
  timelog_Init;
  timelog('GP_Func_ZP->cmInit');
  // текущий план счетов
  //"Настройки Галактики \ Бухгалтерский контур \ План счетов по умолчанию"
  set pPlansSch:=coGetTune('KONSOLID.CPLANSSCH');

} //  Constructor Init;

//------------------------------------
// Найти бухсчет по заказу
//------------------------------------
Function GetBuhschetByMnPlan(_pMnPlan:comp):comp;Cacheable;
{  Result:=0;
   if Timelog_Status>0  timelog('GP_Func_ZP->GetBuhschetByMnPlan:_pMnPlan='+ShowKau(cgKau_Zakaz,_pMnPlan));
   if _pMnPlan=0 then exit;
   set pMnPlan:=_pMnPlan;
   if getfirst MnPlan<>tsok then Exit;
   if MNPLAN.WKODGR1=5063
   { Result :=MNPLAN.CANVAL1;
   }
   else
   if MNPLAN.WKODGR2=5063
   { Result :=MNPLAN.CANVAL2;
   }
   if Timelog_Status>0  timelog('GP_Func_ZP->GetBuhschetByMnPlan:Result='+String(Result,0,0));

} //Function GetBuhschetByMnPlan:comp;

Function GetBuhschetByMnPlanCur(_pMnPlan:comp):comp;Cacheable;
{
  set Result:=GetBuhschetByMnPlan(_pMnPlan);
  if Timelog_Status>0  timelog('GP_Func_ZP->GetBuhschetByMnPlanCur:_pMnPlan='+ShowKau(cgKau_Zakaz,_pMnPlan));
  if Result=0 then Exit;
  set pBuhSchet:=Result;
  if Getfirst Buhschet<>tsok then Exit  ;
  if Buhschet.cPlansSch = pPLansSch then exit;
  set sSch   :=PlansSch.kod+SuBstr(Buhschet.Schet,2,20);
  set sSubSch:=Buhschet.SubSch;
  if sSubSch='' // Нет субсчета
  { case sSch of //План счетов НПО Энергомаш (для экспорта в 1С)
    '325','326': sSubSch:='01'
    end;
  }
  if Timelog_Status>0  timelog('GP_Func_ZP->GetBuhschetByMnPlanCur:sSch='+sSch+', sSubSch='+sSubSch);
  if getfirst Buhschet_cur=tsok
  { set Result:=Buhschet_cur.Nrec;
    if Timelog_Status>0  timelog('GP_Func_ZP->GetBuhschetByMnPlanCur:нашли 001'+sSch+', sSubSch='+sSubSch);
  }
  else
  { set sSubSch:='';
    if getfirst Buhschet_cur=tsok
    { set Result:=Buhschet_cur.Nrec;
      if Timelog_Status>0  timelog('GP_Func_ZP->GetBuhschetByMnPlanCur:нашли 002'+sSch+', sSubSch='+sSubSch);
    }
  }
  if Timelog_Status>0  timelog('GP_Func_ZP->GetBuhschetByMnPlanCur:BuhSchet_Cur.Schet='+BuhSchet_Cur.Schet+', BuhSchet_Cur.SubSch='+BuhSchet_Cur.SubSch);
} //Function GetBuhschetByMnPlanCur(_pMnPlan:comp):comp;Cacheable;


//------------------------------------
// Установить параметры по плану
//------------------------------------
Function SetFieldsByMnPlan(_pMnPlan:comp;var PSchKauParam:TSchKauParam ):boolean;
var ii:word;
{ Result:=false;
  set pMnPlan:=_pMnPlan;
  if getfirst MnPlan<>tsok exit;

  set pBuhSchet:=GetBuhschetByMnPlanCur(pMnPlan);
  if getfirst BuhSchet<>tsok exit;
  if Timelog_Status>0  timelog('GP_Func_ZP->SetFieldsByMnPlan:BuhSchet.Schet='+BuhSchet.Schet+', BuhSchet.SubSch='+BuhSchet.SubSch);

  PSchKauParam.Schet :=substr(BuhSchet.Schet,2,20);
  PSchKauParam.SubSch:=BuhSchet.SUBSCH;
  For(ii:=1;ii<=6;ii++)
  {   if PSchKauParam.wTbl[ii] <>BuhSchet.KODTABLE[ii]
      { PSchKauParam.wTbl[ii] :=BuhSchet.KODTABLE[ii];
        PSchKauParam.cKau[ii]:=0;
      }
      if BuhSchet.KODTABLE[ii]=cgKau_Zakaz
      { PSchKauParam.wTbl[ii] :=BuhSchet.KODTABLE[ii];
        PSchKauParam.cKau[ii]:=_pMnPlan;
        if Timelog_Status>0  timelog('GP_Func_ZP->SetFieldsByMnPlan:Заказ '+string(PSchKauParam.cKau[ii],0,0));

      }
  }
  Result:=true;
}//Function SetFieldsByMnPlan(_pMnPlan:comp);

//-------------------------------
//проверим субсчет по заказу, если не совпадает поменяем
Function Check_Analitic_MnPlan(var PSchKauParam:TSchKauParam ):boolean;
{ Result:=False ;
  //FUNC_ZP_Fill_To_SchKauParam(Lschet,cSchetD,cSubSchD,cKaud,Tbld)
  //pGP_Func_ZP.Check_Analitic_MnPlan();
  var ii:word;
  for(ii:=1;ii<=6;ii++)
  { if PSchKauParam.wTbl[ii]=cgKau_Zakaz
    { //проверим  счет заказа
      pMnPlan:=PSchKauParam.cKau[ii];
      if getfirst MnPlan=tsok
      { pBuhSchet:=GetBuhschetByMnPlanCur(pMnPlan);
        if getfirst BuhSchet<>tsok exit;
        if PSchKauParam.Schet <>substr(BuhSchet.Schet,2,20)
        or PSchKauParam.SubSch<>BuhSchet.SUBSCH
        { SetFieldsByMnPlan(pMnPlan,PSchKauParam);
          Result:=true;
        }

      } //if vSpr.getfirst pMnPlan=tsok
    } //if Lschet.Tbld[ii]=cgKau_Zakaz
  } //for(ii:=1;ii<=6;ii++)
} //Procedure Check_Analitic_MnPlan;

end.
