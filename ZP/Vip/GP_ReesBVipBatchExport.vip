#include GP_ReesBVipExportObj.vih

interface GP_ReesBVipBatchExport 'Пакетная выгрузка реестров на перечисление';
show (,,145,30);
table struct tData (NRec: comp, iFace: string, fileName: string, doCount: double, doSumma: double, sort: string) (i1 = nrec, i2 = iFace + sort, i3 = sort);
table struct tExportFaces (Name: string, Caption: string) (i1 = Name);

create view
var sExpPath: string;
    mRee: TPtr;
    ATTR_SB_VPLAN: comp;
    numRee: string[4];
as select * from 
  SbBan, SbBan SbBanVw
, tData, tData tDataVw
, tExportFaces, tExportFaces tExportFacesVw, tExportFaces tExportFacesVw2
, UserDeskRep
where ((tDataVw.NRec == SbBanVw.NRec and tDataVw.iFace == tExportFacesVw.Name))
order by tDataVw.sort
;
parameters mRee;

function GetVidDoc(Pref: string): string;
{
  Result := 'н/о';

  case Pref of
    'R$$':  Result := 'ГР';
    'RV':   Result := 'НЧВП';
    'RU':   Result := 'УДВП';
    'RM':   Result := 'ПМАТ';
    'RD':   Result := 'ПДЕТ';
    'RRD':  Result := 'РДЕТ';
    'R#Z':  Result := 'ДОГП';
    'R#A':  Result := 'ДОГП';
    'RO':   Result := 'ОТПС';
    'RP':   Result := 'ПРЕМ';
    'RB':   Result := 'БЛНЛ';
    'R$A':  Result := 'АВАН';
    'R$Z':  Result := 'ИТРЗ';
    'R$AL': Result := 'АЛИМ';
    'R$D':  Result := 'СТВЗ';
    'S$':   Result := 'НФОТ';
  end;
}

screen sc1 (,,sci1Esc);
show (,,,3) fixed_Y;
notablenavigation;
fields
  sExpPath (,,sci134Esc): noprotect, pickbutton, editbutton;
  numRee: noprotect;
buttons
  cmOK, default;
  cmReset, [singleLine];
<<
 `Путь для выгрузки`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  <.  Выгрузить  .> 
 `№ реестра Сбербанк` .@@@@ <. Сбросить .>
>>
end;
browse br2 (,,sci14Esc);
show (,4,,);
table tDataVw;
fields
  {font = {color = if(tDataVw.iFace = '', ColorSysRed, 0)}};
  GetVidDoc(SbBanVw.Prefix) 'Док.': [5], noautosize, protect;
  SbBanVw.dForm 'Дата': [10], noautosize, protect;
  SbBanVw.LastUser 'Номер': [10], noautosize, protect;
  SbBanVw.Name 'Наименование': [40], protect;
  sGetAttrID(coSbBan, SbBanVw.NRec, ATTR_SB_VPLAN) 'Группа заказов': [15], protect;
  tDataVw.doCount 'Сотрудников ': [10], protect;
  tDataVw.doSumma 'Сумма': [14.2,'\2p[|-]3666`666`666`666`666`667.88'], protect;
  tExportFacesVw.Caption 'Форма выгрузки' (,,sci13Esc): [15], protect, pickbutton;
  tDataVw.fileName 'Файл': [25], protect, {hyperlink = tDataVw.fileName <> ''};
end;

window wPickFace 'Выбор формата выгрузки' DoAccept, EscClose;
show (,,25,10);
browse br3 (,,sci1EnEsc);
table tExportFacesVw2;
fields
  tExportFacesVw2.Caption 'Формат выгрузки': protect;
end;
end;

function GetSberReeNum: string;
{
  Result := '';
  if getfirst UserDeskRep where ((cgReport_7810 == UserDeskRep.nRep and 'Реестр в СберБанк' == UserDeskRep.RepName)) <> tsOk
    exit;
  if length(UserDeskRep.ResCode[20]) >= 13
    Result := trim(SubStr(UserDeskRep.ResCode[20], 10, 4));
}
function SetSberReeNum(num: string): boolean;
var s: string;
{
  Result := false;
  if getfirst UserDeskRep where ((cgReport_7810 == UserDeskRep.nRep and 'Реестр в СберБанк' == UserDeskRep.RepName)) <> tsOk
    exit;
  num := LPad(substr(trim(num), 1, 4), 4);
  s := Pad(substr(UserDeskRep.ResCode[20], 1, 9), 9) + num;
  if length(UserDeskRep.ResCode[20]) > 13
    s += SubStr(UserDeskRep.ResCode[20], 14, 255);
  UserDeskRep.ResCode[20] := s;
  update current UserDeskRep;
  Result := true;
}

function FilltData: boolean;
var i, cnt: longint;
    cRec: comp;
    mPers: TPtr;
{
  Result := false;
  for (i := 0; i < GetMarkerCount(mRee); i++)
  {
    GetMarker(mRee, i, cRec);
    if getfirst SbBan where ((cRec == SbBan.NRec)) <> tsOK
      continue;
    sql select count(distinct SpPlBan.tPerson)
    from SpPlBan
    inner join SbBan on SpPlBan.cSbBan = SbBan.NRec
    where SbBan.NRec = :(cRec) or SbBan.cNode = :(cRec)
    into (cnt);

    ClearBuffer(tntData);
    tData.NRec := cRec;
    tData.doCount := cnt;
    tData.doSumma := SbBan.Summa;
    tData.Sort := ''#255 + sGetAttrID(coSbBan, cRec, ATTR_SB_VPLAN);
    insert current tData;
  }
  DoneMarker(mPers, '');
  Result := true;
}

function InitExportInterfaces: boolean;
var i: longint;
    iRef: GP_ReesBVipExportObj;
    mGoodRee: TPtr;
{
  Result := false;
  mtClear(tntExportFaces, mfNormal);
  if LoadImplementationList('GP_ZP::GP_ReesBVipExportObj', 'GP_ReesBVipExport_')
    for (i := 0; i < GetImplementationCount; i++)
      if LoadVipRef(iRef, GetImplementationName(i))
      {
        ClearBuffer(tntExportFaces);
        tExportFaces.Name := GetImplementationName(i);
        tExportFaces.Caption := iRef.Caption;
        insert current tExportFaces;
        mGoodRee := iRef.ChooseReesToApply(mRee);
        _loop tData
          if FoundMarker(mGoodRee, tData.NRec)
          {
            tData.iFace := tExportFaces.Name;
            tData.Sort := tExportFaces.Caption + sGetAttrID(coSbBan, tData.NRec, ATTR_SB_VPLAN);
            update current tData;
          }
        DoneMarker(mGoodRee, '');
        FreeVipInterface(iRef);
      }
  UnLoadImplementationList;
  Result := true;
}

function RunExport: boolean;
var skipCnt: longint;
    iRef: GP_ReesBVipExportObj;
{
  Result := false;
  skipCnt := 0;
  _loop tData
    if tData.iFace = ''
      skipCnt++;
  if skipCnt > 0
    if message('Для ' + skipCnt + ' реестра(ов) не задан формат выгрузки!'#13'Продолжить?', YesNo) <> cmYes
      exit;
  StartNewVisual(vtRotateVisual, vfTimer, 'Выгрузка реестров', 0);
  _loop tExportFaces
  {
    NextVisual;
    if getfirst tData where ((tExportFaces.Name == tData.iFace)) <> tsOk
      continue;
    if not LoadVipRef(iRef, tExportFaces.Name)
      continue;
    _loop tData where ((tExportFaces.Name == tData.iFace)) ordered by tData.sort
    {
      NextVisual;
      iRef.Export(tData.NRec, sExpPath, tData.fileName);
      update current tData;
    }
    FreeVipInterface(iRef);
  }
  StopVisual;
  set numRee := GetSberReeNum;
  RereadRecord(tntDataVw);
  Result := true;
}

handleEvent
  cmInit:
  {
    ReadMyDsk(sExpPath, 'GP_ReesBVipBatchExport_Path', true);
    ATTR_SB_VPLAN := ExtAttr_ID(coSBBAN, 'Группа заказов');
    set numRee := GetSberReeNum;
    FilltData;
    InitExportInterfaces;
  }
  cmDone:
  {
    SaveMyDsk(sExpPath, 'GP_ReesBVipBatchExport_Path');
  }
  cmPick:
  {
    case CurField of
      #sExpPath:
      {
        set sExpPath := GetDirName('Выберите путь для выгрузки', sExpPath);
      }
      #tExportFacesVw.Caption:
      {
        if RunWindowModal(wPickFace) = cmDefault
        {
          tDataVw.iFace := tExportFacesVw2.Name;
          update current tDataVw;
        }
      }
    end;
  }
  cmEdit:
  {
    if curTable = tntDataVw
    {
      RunInterface('Z_PayRep::BrowRees', tDataVw.NRec, 1, 0);
      exit;
    }
    case CurField of
      #sExpPath:
      {
        if ExistFile(sExpPath + '\.')
        {
          var res: integer;
          ExecProgram('explorer.exe', sExpPath, '', pfDontWait, res);
        }
      }
    end;
  }
  cmHyperLink:
  {
    case CurField of
      #tDataVw.fileName:
      {
        if tDataVw.fileName <> ''
          if ExistFile(sExpPath + '\' + tDataVw.fileName)
          {
            var res: integer;
            ExecProgram('start', sExpPath + '\' + tDataVw.fileName, '', pfDontWait, res);
          }
      }
    end;
  }
  cmOK: RunExport;
  cmReset:
  {
    SetSberReeNum('  00');
    set numRee := GetSberReeNum;
  }
  cmCheckField:
  {
    case curField of
      #numRee: SetSberReeNum(numRee);
    end;
  }
end;
end.