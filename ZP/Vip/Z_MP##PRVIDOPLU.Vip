/*************************************************************************************************\
* Наименование:  Доработка интерфейса Заработная плата -> Документы -> Лицевые счета ->           *
*                Локальное меню ->  Смежные данные (Alt+C) ->  Закладка <Текущие данные> >        *
*                Выплаты в межпериод,  закладка <Отнесение затрат>                                *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    требуется начинать выбор распределения с номера заказа с последующим             *
*                автоматическим формированием счета бухгалтерского учета.                         *
*                Собирать перед Z_WT##WTCOSTSHARING.vip                                           *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#772          |10/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#3574         |31/10/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#include GetKau.Vih
#component "Z_MP"
Alter Interface PRVIDOPLU;
Overload
  function FillExcelFilesTbl: boolean;  //просматриваем каталог и занносим пути к файлам в таблицу в памяти

end;
#include GetKau.Var
#include GP_Func_ZP.Var

var wKodAnalitik :word;//код "избранная аналитика"
var pTmp         :comp;
Create View vSpr
var
 pBuhSchet:comp;
 pMnPlan  :comp;
From BuhSchet,MnPlan
where ((
    pBuhSchet == BuhSchet.Nrec
and pMnPlan   == MnPlan.Nrec
));


//----------------------------------------------
// Переключаем на импорт одного файла - см Z_MP##VVODSU.Vip
//----------------------------------------------
function FillExcelFilesTbl: boolean;  //просматриваем каталог и заносим пути к файлам в таблицу в памяти
{ delete all EXCELFILES;
  result := false;
  if not FileExist(XLSDirPath)
  { message('Не нашли файл для импорта'
     +chr(13)+XLSDirPath );
    Exit
  }
  EXCELFILES.Path :=XLSDirPath;  //GetFirstFile(XLSDirPath, '*.xls');
  insert current EXCELFILES;
  Result:=true;
} //  function FillExcelFilesTbl: boolean;  //просматриваем каталог и заносим пути к файлам в таблицу в памяти

//------------------------------------
// Найти бухсчет по заказу
//------------------------------------
Function GetBuhschetByMnPlan:comp;
{  Result:=0;
   if vSpr.MNPLAN.WKODGR1=5063
   { Result :=vspr.MNPLAN.CANVAL1;
   }
   else
   if vSpr.MNPLAN.WKODGR2=5063
   { Result :=vSpr.MNPLAN.CANVAL2;
   }
} //Function GetBuhschetByMnPlan:comp;

//------------------------------------
// Установить параметры по плану
//------------------------------------
Function SetFieldsByMnPlan(_pMnPlan:comp):boolean;
var ii:word;
{ Result:=false;
  #FUNC_ZP_Fill_To_SchKauParam(PrVidOpl,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.SetFieldsByMnPlan(_pMnPlan,PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(PrVidOpl,cSchetD,cSubSchD,cKaud,Tbld)
    Result:=true;
    SetModified(true);
    UpdateTable;
  }
}//Function SetFieldsByMnPlan(_pMnPlan:comp);

//-------------------------------
//проверим субсчет по заказу, если не совпадает поменяем
Procedure Check_Analitic_MnPlan;
{ #FUNC_ZP_Fill_To_SchKauParam(PrVidOpl,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.Check_Analitic_MnPlan(PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(PrVidOpl,cSchetD,cSubSchD,cKaud,Tbld)
    SetModified(true);
    UpdateTable;
  }
} //Procedure Check_Analitic_MnPlan;


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
  //------------------------
  cmInit:
  { //"Настройки Галактики \ Управление персоналом \ Расчеты с персоналом \ Избранная аналитика"
    wKodAnalitik:=wGetTune('UP.ZAR.FAVORITEANALYTICS');
    //----------------------
    if  inherited :: handleEvent (cmInit)=heAbort then Abort;
    //----------------------

  }
  //------------------------
  cmPick:
  {
      var need_Pick:boolean=true;
      case curField of
      #Schetdeb, #SubSchdeb, #NamKaud:
      { if curField=#NamKaud
        { if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed'
        }
        if Schetdeb='' or (QuickChoiceName<>'' and curField=#NamKaud )
        { pTmp:=0;
          if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
          { if  SetFieldsByMnPlan(pTmp)
            { case curField of
              #Schetdeb, #SubSchdeb: need_Pick:=false;
              end;
            }
          }
          else
          { message('Задайте счет');
            SelectField(#Schetdeb);
          }


        } //if Schetdeb=''

      } //#Schetdeb, #SubSchdeb, #NamKaud
      end; //case curField of
      //----------------------
      if need_Pick
      { if  inherited :: handleEvent (cmPick)=heAbort then Abort;
        if curField=#NamKaud
        { Check_Analitic_MnPlan;
        }
      }
      //----------------------
  }

  end;

end.
