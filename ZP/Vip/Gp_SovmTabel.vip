/********************************************************************************************************\
* Наименование: Отчет "Соответствие табелей физических лиц по основному месту работы и совместительству" *
* Контур/Модуль: ЗП                                                                                      *
* Примечание:                                                                                            *
*                                                                                                        *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                                  *
* -----------------------------------------------------------------------------------------------        *
* Разработка  |#2259         |16/04/18|Синяк Е.П.             |НПО Энергомаш                             *
\********************************************************************************************************/

Interface GP_CompareZarSovm;
 table struct tsovm
 (
   strtabn  : string[20]
  ,fio      : string[150]
  ,pnrec    : comp
  ,sovm     : word
  ,cntls    : integer
  ,days     : array[1..31] of string [5]
  ,dbug     : array[1..31] of string [1]
  ,isbug    : word
 )
 with index
 (
   in0=sovm
  ,in1=pnrec+sovm
 );

 create view
  var
    pyearn,i,pmes,lday : integer;
    cday : double ;
    ischeckday,ischeckday1 : boolean;
    curcount : integer;
    XlRes   : boolean;
    row,cntcol     : longint;
    fday : date;


  as select *
   from
  tsovm
 ,tsovm tsovm1
 ;


Screen param;
 Viewtable;
  fields

     pmes        : noprotect ;
     pyearn    : noprotect ;

 Buttons
   CmYes,Default;
   CmCancel;
<<

   `За` .@@@ `месяц` .@@@@ `года`


    <.Сформировать.>     <.Отмена.>
>>

end;

 HandleEvent
  CmInit:{

          pmes:=Month(dgettune('UP.DATOTCH'));
          pyearn:=Year(dgettune('UP.DATOTCH'));
         }

  CmYes :{
           MtClear(#tSovm,fmNormal);

           fday:=date(1,pmes,pyearn);

           _try
           {
            sql
             select
             t1.strtabn
            ,p.fio
            ,p.nrec
            ,t1.sovm
            ,t1.cntls
            ,lstab.days[1]
            ,lstab.days[2]
            ,lstab.days[3]
            ,lstab.days[4]
            ,lstab.days[5]
            ,lstab.days[6]
            ,lstab.days[7]
            ,lstab.days[8]
            ,lstab.days[9]
            ,lstab.days[10]
            ,lstab.days[11]
            ,lstab.days[12]
            ,lstab.days[13]
            ,lstab.days[14]
            ,lstab.days[15]
            ,lstab.days[16]
            ,lstab.days[17]
            ,lstab.days[18]
            ,lstab.days[19]
            ,lstab.days[20]
            ,lstab.days[21]
            ,lstab.days[22]
            ,lstab.days[23]
            ,lstab.days[24]
            ,lstab.days[25]
            ,lstab.days[26]
            ,lstab.days[27]
            ,lstab.days[28]
            ,lstab.days[29]
            ,lstab.days[30]
            ,lstab.days[31]
            from
            (
             select
             l.nrec
             ,l.tperson
             ,l.strtabn
             ,l.sovm
             ,Count( *) Over(partition by tperson) as CntLs
            from lschet l
              where exists (select top 1 nrec from lstab where l.nrec=lstab.clschet and lstab.yearn=:(pyearn) and lstab.mesn=:(pmes))
                   and (l.datuv=#date(0,0,0) or l.datuv>=:(fday))
            )t1 inner join persons p on t1.tperson=p.nrec
                inner join lstab on t1.nrec=lstab.clschet and lstab.yearn=:(pyearn) and lstab.mesn=:(pmes)
             where t1.cntls>1
            into tSovm
            ;
           }
           _except
            on ExDataBase: {
                           }
            else  {
                  }

//           Message(RecordsIntable(#tSovm));
           curcount:=0;

           if RecordsIntable(#tSovm)=0
           {
             exit;
           }

          lday:=last_day(date(1,pmes,pyearn));


           _loop tsovm where ((  0 == tsovm.sovm )) 
           {
             if getfirst tsovm1 where ((tsovm.pnrec == tsovm1.pnrec and 0 << tsovm1.sovm ))=tsok
             {
              for(i:=1;i<=lday;i++) //у совместителя не может быть числа в дне табеля, если у основго (0) не число
              {
!               cday:=-1;
               ischeckday:=false;

               _try
               {
                double(tsovm.days[i]);                
               }
               _except
                on ExNumberConvert:{
!                                     continue;
                                      ischeckday:=true;
                                    }

               if (not ischeckday)
               {
                continue;
               }
               else
               {

                ischeckday1:=false;

                _try
                {
                 double(tsovm1.days[i]);                
                }
                _except
                 on ExNumberConvert:{
                                      ischeckday1:=true;
                                    }

                if (ischeckday=true and ischeckday1=false)
                {
                 update current tsovm set tsovm.dbug[i]:='X';
                 if tsovm.isbug<>1 {tsovm.isbug:=1; update current tsovm;}
                }
               }

              }

              if tsovm.isbug=0
              {
               delete current tsovm;
               delete current tsovm1;
              }
              else
               curcount++;
             }
           }

            XlRes := xlCreateExcel((''), true);
            if (XlRes)
             XlRes := xlIsExcelValid;
            if (not XlRes)
              Message('не иннициализирован excel');

             row:=1;
             xlSetCellStringValue('Отчет о расхождении данных в табелях совместителей за '+Case(pmes;
                                                                    1 : 'Январь ',
                                                                    2 : 'Февраль',
                                                                    3 : 'Март ',
                                                                    4 : 'Апрель ',
                                                                    5 : 'Май ' ,
                                                                    6 : 'Июнь '  ,
                                                                    7 : 'Июль '  ,
                                                                    8 : 'Август '  ,
                                                                    9 : 'Сентябрь ',
                                                                    10 : 'Октябрь ',
                                                                    11 : 'Ноябрь ' ,
                                                                    12 : 'Декабрь '
                                                            )+string(pyearn)+' года',1,2,1,2);

             inc(row);
             inc(row);
             xlSetCellStringValue('Сотрудник',row,1,row,1);
             xlSetColumnWidth(37,row,1,row,1);
             xlSetCellStringValue('Табельный основной',row,2,row,2);
             xlSetColumnWidth(15,row,2,row,2);
             xlSetCellStringValue('Табельный совмещения.',row,3,row,3);
             xlSetColumnWidth(15,row,3,row,3);
             cntcol:=3;


             for(i:=1;i<=lday;i++)
             {
              cntcol++;
              xlSetCellStringValue(string(i),row,cntcol,row,cntcol);                                   
             }
             xlSetColumnWidth(3,row,4,row,cntcol);
             xlAlignCellsEx(xlLeft,xlCenter,row,3,row,cntcol);
             xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideH or xlInsideV,xlThin,xlContinuous,1,row,1,row+curcount,cntcol);

            _loop tsovm where (( 0 == tsovm.sovm )) 
            {
             if getfirst tsovm1 where ((tsovm.pnrec == tsovm1.pnrec and 0 << tsovm1.sovm ))=tsok {}            

             row++;
             xlSetCellStringValue(tsovm.fio,row,1,row,1);
             xlSetCellStringValue(chr(39)+tsovm.strtabn,row,2,row,2);
             xlSetCellStringValue(chr(39)+tsovm1.strtabn,row,3,row,3);
             for(i:=1;i<=lday;i++)
             {
              xlSetCellStringValue(tsovm.dbug[i],row,i+3,row,i+3);                                   
             }
            }

             xlKillExcel;
         }
 end;

end.


#include UserReport.vih

VipInterface UserReport_Claim_CompareZarSovm Implements IUserReport;

Interface UserReport_Claim_CompareZarSovm;

create view;

!-------------------------------------------------------------------------------
// Запуск отчета на выполнение при выборе его из списка отчетов
procedure Run;
begin
  RunInterfaceNoModal('GP_CompareZarSovm');
end;
!-------------------------------------------------------------------------------
// Наименование отчета в списке
function GetReportName: String;
begin
  GetReportName := 'Соответствие табелей физических лиц по основному месту работы и совместительству';
end;
!-------------------------------------------------------------------------------
// Наименования групп, в которые входит отчет
// Группа n+1 делается подчиненной группе n
// В данном случае будет иерархия:
// [+] Группа 1
//     [+] Группа 2
//         Отчет 1
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := '';
  case Level of
    1 : GetGroupName := 'Отчеты по табелям';
  end;
end;
!-------------------------------------------------------------------------------
// Приоритет отчета - сортировка внутри группы выполняется сначала
// по приоритету, а затем по наименованию
function GetPriority : Integer;
begin
  GetPriority := 0;
end;
!-------------------------------------------------------------------------------
// ModuleID модулей, в которых будет виден отчет
// '*' - отчет будет виден в любом модуле
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;
!-------------------------------------------------------------------------------
end.
