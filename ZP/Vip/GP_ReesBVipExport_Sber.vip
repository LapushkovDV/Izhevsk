#component "GP_ZP"
#include GP_ReesBVipExportObj.vih

interface GP_ReesBVipExport_Sber;
create view
var cEmFilterOrg: comp;
as select * from
  KatOrg KatOrgEM
, SbBan SbBanEM
;

property GP_ReesBVipExportObj.Caption: string read 'СберБанк';
function ChooseReesToApply(mRee: TPtr): TPtr;
var m: TPtr;
    i: longint;
    cRec: comp;
{
  m := InitMarker('', 8, 1, 1);
  for (i := 0; i < GetMarkerCount(mRee); i++)
  {
    GetMarker(mRee, i, cRec);
    if getfirst SbBanEM where ((cRec == SbBanEM.NRec)) = tsOk
      if SbBanEM.cPol = cEmFilterOrg
        InsertMarker(m, cRec);
  }
  Result := m;
}

function Export(cRec: comp; sPath: string; var fileName: string): boolean;
{
  Result := false;
  EMBatchMode := true;
  SbbanNRec := cRec;
  LoadUserPreferences;
  LoadRegisterData;

  if getfirst UserDeskRep where ((cgReport_7810 == UserDeskRep.nRep and 'Реестр в СберБанк' == UserDeskRep.RepName)) <> tsOk
    exit;
  CurDeskRep := UserDeskRep.NRec;

  LoadFromTemplate;
  SetDirPathName(sPath);

  fileName := GetUseFileName;
  var Res: boolean = false;
  case GetFormatFile of
    EXT_DBF: Res := ExportToDbf;
    EXT_XML: Res := CreateXML;
    EXT_XMLTXT: Res := CreateXmlTxt;
  end;

  if not Res
    fileName := '';
  //
  SaveUserPreferences;
  EMBatchMode := false;
  Result := true;
}

handleEvent
  cmOnVipLoad:
  {
    if getfirst KatOrgEM where (('ПАО "Сбербанк"' == KatOrgEM.Name)) = tsOk
      cEmFilterOrg := KatOrgEM.NRec;
    inherited::HandleEvent(cmOnVipLoad);
  }
end;
end.