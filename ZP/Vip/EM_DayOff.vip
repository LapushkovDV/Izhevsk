#include userreport.vih
#include adrFunc.vih
#include CatFunc.vih

Interface EM_DayOff 'Параметры отчета' gray
Show at (,,55,7);

Create View t1

var
  ICatFunc      : CatalogsFunctions;
  _sDepartment  : string;
  mDept         : LongInt;
  _wType        : word = 4;
  _descr        : string;
  _n            : LongInt = 0;
as select
  1
from EM_UniDic;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  _n, noProtect, noPickButton;
  _sDepartment, protect, pickbutton;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Начинать нумерацию с .@@@@@@@@@@

    По подразделению     .@@@@@@@@@@@@@@@@@@@@@

    <.Продолжить.>

    >>
end;

Procedure UpdateFiltersState; //by Ermolov K.
{
  var SelCnt: LongInt;
  var cTemp: Comp;
  _sDepartment := '';
  SelCnt := GetMarkerCount(mDept);
  if SelCnt > 0 then
    if (SelCnt = 1) and GetMarker(mDept, 0, cTemp) then
      _sDepartment := ICatFunc.GetCatalogsName(cTemp);
    else
      _sDepartment := 'Выбрано подразделений: ' + String(SelCnt);
  ReReadRecord;
}

Procedure InsPicked();
{
  _descr := sGetTune('User.Descr');

  var _i : word = 0;

  while 1 = 1
  {
    var _cRec : comp = 0h;
    GetMarker(mDept, _i, _cRec);

    ClearBuffer(#Em_UniDic);
      Em_UniDic.nRec          := 0h;
      Em_UniDic.wType         := _wType;
      Em_UniDic.AddString[1]  := _descr;
      Em_UniDic.sName         := '4 Days';
      Em_UniDic.AddComp[1]    := _cRec;
      Em_UniDic.AddLongInt[1] := _n;
    Insert Current Em_UniDic;

    _i++;
   if _i >= GetMarkerCount(mDept) then break;
  }
}

Procedure DelPicked();
{
  _descr := sGetTune('User.Descr');
  Delete From Em_UniDic where ((      _wType   == Em_UniDic.wType
                                  and _descr   == Em_UniDic.AddString[1] (noIndex)
                                  and '4 Days' == Em_UniDic.sName        (noIndex)
                              ));
}

HandleEvent

cmPick:
{
  case CurField of
    #_sDepartment:
      {
        ClearMarker(mDept);
        DelPicked();
        RunInterface('Z_STAFFCAT::PickCatalog2', -11, 0, 100, 0);
        mDept := InitMarker('CatalogsMarker', 8, 30, 10);
        UpdateFiltersState;
        InsPicked();
        DoneMarker(mDept, 'CatalogsMarker');
      }
  end;
}

cmDelOnProtect:
{
  case CurField of
    #_sDepartment:
    {
      ClearMarker(mDept);
      UpdateFiltersState;
      DelPicked();
    }
  end;
}

cmGo:
{
  SaveMyDsk(_n, '4Days_n');
  PutCommand(cmClose);
}

end;
End.
