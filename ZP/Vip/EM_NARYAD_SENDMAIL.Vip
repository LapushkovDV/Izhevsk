#include EM_NARYAD_SENDMAIL.Vih
#include GP_EmailRun.Vih

#doc
Контроль событий по подразделениям, например не закрытые нарушения
#end
Interface EM_NARYAD_SENDMAIL 'Контроль событий по подразделениям' (,,sci1Esc) , EscClose ;
Show at (,,70,20);
//--------------------------------------------
// Для отправки пользователям
//--------------------------------------------
Table struct tmp_user
(
   LoginName : string // :string[50]
 , Fio       : string // :string[50]
 , Mail      : string//:string
)
with index
(
 ind0 = LoginName
)
;

Table Struct tmp_user_podr
(
    LoginName : string[50]
  , Fio       : string
  , Mail      : string
  , cPodr     : comp
  , PodrKod   : string
  , PodrName  : string
)
with index
(
  ind1 = LoginName
 ,ind2 = Fio
);
//------------------------
#include GP_EmailRun.Var
//------------------------
var
//-------------------
//  iGP_SCUD_EventsEdit :GP_SCUD_EventsEdit New;
//------------------------------
  wAuto:word;
  wMesRas  ,wYearRas  :word;

  DTB,DTE:date;
//----------------------------------------
  email_num_row:longint;
//-------- Настройки
 NPOEM_OWN_EMAIL_TYPE:word=1;//Тип отправки EMAIL
//-----------------------------
#include Excel_var.vpp
//-----------------------------
Create view
var
 pGP_SCUD_PERS: comp;
as select
  tmp_user.loginname
From
    tmp_user
  , tmp_user_podr
where ((tmp_user.LoginName == tmp_user_podr.LoginName))
;
//*****************************************************************************

Parameters
  wAuto
#doc
  1 - автоматический запуск
#end
;
//**************************************
//===============================================================
#include Sql_func.vpp
//===============================================================
#doc
 Окно с паузой. Во избежания вылета галактики при автозапуске нужно сделать паузу
 Падает NowRun
#end
window wnPause 'Пауза' show at (,,10,5);
 screen scrPause;
 <<
    Пауза
 >>
 end;
End;

Procedure MyLog(w:string);
{ if Logfilenm=''
  { logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0)+
      '\EM_NARYAD_SENDMAIL_'+DateToStr(Cur_Date,'YYYY_MM_DD')+TimeToStr(Cur_Time,'HHMM')+'.log';
     MyLog('EM_NARYAD_SENDMAIL на '+string(wMEsRas)+'/'+string(wYearRas));
  }
  LogStrtofile(logfilenm,w);
}

//===============================================================
// Записать текст сообщения
//===============================================================
Procedure Write_Mess(w:string);
{ email_num_row++;
  pGP_EmailRun.Write_Text(email_num_row,w);
} //Procedure Write_Mess(w:string);

//===============================================================
//Запуск отправки почты
//C:\SQLDB\ERPDB\TASKS\GAL_SCUD_PodrCheck\out\EM_NARYAD_SENDMAIL.xlsx
//===============================================================
Procedure RunEmail;
var
  _wMesRas  ,_wYearRas  :word;
  isAllOk:boolean;
  _email_attach1:string;
  maxColCount:word;
{


  timelog('EM_NARYAD_SENDMAIL->RunEmail START ');
  nmtemplate:='EM_NARYAD_SENDMAIL.xlsx';
  maxColCount:=8;
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfconfirm,''#3'Выполнение рассылки'
     ,LongInt(RecordsInTable(#tmp_user)));

  _loop tmp_user
   {
     var _DepList :longint;
     _DepList := initmarker('EM_NARYAD_SENDMAIL_FILTRPODR', 8, 200, 100) ;
     ClearMarker(_DepList);
      _Loop tmp_user_podr
      {
       InsertMarker(_DepList,tmp_user_podr.cPodr);

      }
//    message(getmarkercount(_DepList));
    DoneMarker(_DepList,'EM_NARYAD_SENDMAIL_FILTRPODR');
    var _fileAttach : string = '';
    RunInterface(GP_ZP::gp_otchnar6_new , _fileAttach
                                        , tmp_user.LoginName
                                        , _DepList // маркер с подразщделениями
                                        , 0  // автоопределение в отчете
                                        , 0  // автоопределение в отчете
                                        , 1); // автозапуск
    timelog('EM_NARYAD_SENDMAIL->RunEmail tmp_user.Fio='+tmp_user.Fio+', mail='+tmp_user.mail);
    email_num_row:=0;
    //var lObj:longint=UserOfficeFilial(tmp_user.cUser);
    if tmp_user.mail='' then continue;
    Write_Mess('Добрый день, '+tmp_user.Fio);
    _wMesRas:=0;
    _wYearRas:=0;
    Write_Mess('<p><b>Во вложении отчет по нарядам</b>');
     timelog('EM_NARYAD_SENDMAIL->RunEmail XlKillExcel');

    timelog('EM_NARYAD_SENDMAIL->RunEmail отправляем почту ');

    if not pGP_EmailRun.EmailSend
     ( NPOEM_OWN_EMAIL_TYPE// : word ;
       ,tmp_user.mail // _email_addr :string ;
       ,'Отчет по нарядам на '+DateToStr(Cur_Date,'DD.MM.YYYY') // _email_subject :string ;
       ,'' //_email_text :string ;
       ,_fileAttach //_email_attach1 :string ;
       ,'' //_email_attach2 :string ;
       ,'' //_email_attach3 :string ;
       ,'' //_email_attach4 :string ;
       ,''//'"INTERFACE Z_StaffOrders::OrdersList('+string(TitleDoc.Nrec,0,0)+')"' //_email_attach5 :string ;
       ,'' //_email_addr_copy :string='';
       ,'' //_email_addr_from :string=''
      ) then break;
    timelog('EM_NARYAD_SENDMAIL->RunEmail отправили');

  } //_Loop tmp_user
  StopVisual('',0);
  timelog('EM_NARYAD_SENDMAIL->RunEmail Finish');
} //Procedure RunEmail;

//-----------------------------------------
//
//-----------------------------------------
Function FormDoc:boolean;//
Var ii:word;
{ Result:=false;
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfconfirm,'Выбор данных',0);

  timelog('EM_NARYAD_SENDMAIL->FormDoc START');
  delete all tmp_user_podr;
 _try
 {
   sql
      select distinct
          Zar_User.OwnName as LoginName// :string[50]
        , X$Users.XU$FullName as Fio// :string[50]
        , COMMUNICATIONS.Email as Mail//:string
        , KatPodr.nrec as cPodr
        , KatPodr.kod as PodrKod
        , KatPodr.Name as PodrName
      From Zar_User
      inner join X$Users on X$Users.XU$LoginName='cb\'+ ZAR_USER.OWNNAME
      inner join GP_USERRIGHTS on GP_USERRIGHTS.OWNNAME = ZAR_USER.OWNNAME
       and GP_USERRIGHTS.wType = 4
      inner join Katpodr on KatPodr.Nrec = GP_USERRIGHTS.cRecDs
      inner join USERRIGHTS on USERRIGHTS.cRecDs= Katpodr.Nrec
      inner join GP_SCUD_Pers on GP_SCUD_Pers.cKatpodr = KatPodr.Nrec
      inner join TuneDef TuneDefP on TuneDefP.Code='USER.PERSON'
      inner join TuneVal TuneValP on TuneValP.cUser=X$Users.Atl_nrec
            and TuneValP.cTune =TuneDefP.Nrec
      inner join Persons PersonsP on PersonsP.Nrec = TuneValP.COMPVAL
        inner join COMMUNICATIONS on COMMUNICATIONS.Person = PersonsP.Nrec
           and 3 = COMMUNICATIONS.OBJTYPE and  ''<COMMUNICATIONS.Email
   into tmp_user_podr;
 }
 _except else{}

 delete all tmp_user;
 _try
 {
      sql
      select distinct
          Zar_User.OwnName as LoginName// :string[50]
        , X$Users.XU$FullName as Fio// :string[50]
        , COMMUNICATIONS.Email as Mail//:string
      From Zar_User
      inner join X$Users on X$Users.XU$LoginName='cb\'+ ZAR_USER.OWNNAME
      inner join GP_USERRIGHTS on GP_USERRIGHTS.OWNNAME = ZAR_USER.OWNNAME
       and GP_USERRIGHTS.wType = 4
      inner join Katpodr on KatPodr.Nrec = GP_USERRIGHTS.cRecDs
      inner join USERRIGHTS on USERRIGHTS.cRecDs= Katpodr.Nrec
      inner join GP_SCUD_Pers on GP_SCUD_Pers.cKatpodr = KatPodr.Nrec
      inner join TuneDef TuneDefP on TuneDefP.Code='USER.PERSON'
      inner join TuneVal TuneValP on TuneValP.cUser=X$Users.Atl_nrec
            and TuneValP.cTune =TuneDefP.Nrec
      inner join Persons PersonsP on PersonsP.Nrec = TuneValP.COMPVAL
        inner join COMMUNICATIONS on COMMUNICATIONS.Person = PersonsP.Nrec
           and 3 = COMMUNICATIONS.OBJTYPE and  ''<COMMUNICATIONS.Email
     into tmp_user;
 }
 _except else {}

  StopVisual('',0);
  Result:=true;
  timelog('EM_NARYAD_SENDMAIL->FormDoc Finish');

} //Function FormDoc:boolean;//

Screen scrMain 'Список пользователей'  ;
Show at (,,,2);
Fields
  'Excel' : Protect;
Buttons
  cmOk    ,,, 'продолжить выполнение', hcAllBOk, scGalDial;
<<
  <.Выполнить рассылку.>  `Тип отчета` .@@@@@@@@@@@@@@@
>>
end;

Browse brMain 'Список пользователей'  ;
Show at (,3,,12);
Table tmp_user;
Fields
 tmp_user.LoginName 'Логин' :[20],Protect,NoDel;
 tmp_user.Fio       'Фио'   :[20],Protect,NoDel;
 tmp_user.mail      'eMail' :[20],Protect,NoDel;
end;
Browse brMainSp 'Список Подразделений'  ;
Show at (,13,,) ;
Table tmp_user_podr;
Fields
  tmp_user_podr.Podrkod 'Код подр.' :[10],Protect,NoDel;
  tmp_user_podr.PodrName 'Подразделение наименование' :[10],Protect,NoDel;
end;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { timelog_init;
      timelog('EM_NARYAD_SENDMAIL->cmInit wAuto='+string(wAuto));
      NPOEM_OWN_EMAIL_TYPE:=wGetTune('NPOEM_OWN.EMAIL_TYPE');//Тип отправки EMAIL
      //PutCommand(cmValue1);
      FormDoc;
      if wAuto=1
      { timelog('EM_NARYAD_SENDMAIL->cmInit:автозапуск RunEmail');
        RunEmail;
        RunWindow(wnPause);
        StartTimer(cmValue2,2,False);
      }
    }
    cmValue2:
    { timelog('EM_NARYAD_SENDMAIL->cmValue2');

      StopTimer(cmValue2);
      closeinterface(cmDone) ;
    }
    cmOk: RunEmail;
  end;

end.
