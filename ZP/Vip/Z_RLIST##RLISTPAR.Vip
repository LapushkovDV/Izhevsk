#include FR_RList.vih
#component "Z_RLIST"
Alter Interface RLISTPAR;

table struct ForMarksEM = ForMarks;
create view
from ForMarksEM
,ForMarks
;
//Добавляем возможность изменение настройки сортировки
var NPOEM_OWN_ZP_RList_SortDef:word;
_exportPDFForPortal : byte;

//'Z_RLIST::RLISTPAR.WNASTROYKA.NASTROYKA.SUMODN'
//------------------------------------------
ExtendFormats Nastroyka;
ExtendFormats FormPar ;
//------------------------------------------
function isExistZayavlenie(_cRec : comp) : Boolean; Cacheable;
{
  var  __cRec : comp = 0h;
         _try
          {
           sql
            select  // проверка наличия заявления
             top 1
              ls.nrec
            from EM_ZAYAVKA_PITANIE Zayav
            join Gp_Status GPStatus on GPStatus.nrec  = zayav.STATUS
            join GP_SCUD_PERS ScudPers on zayav.CGP_SCUD_PERS = ScudPers.nrec
            join persons pers on pers.nrec = ScudPers.cPersons
            join lSchet ls on ls.tPerson = pers.nrec
            where Zayav.wTypeDoc = 106
              and GPStatus.name = 'УТВЕРЖДЕН'
              and ls.nrec = :(_cRec)
              into (__cRec);
          }
          _Except else{
          }
          _Finally{
          }
  result := if(__cRec <> 0h,true,false);
}
//TabbedSheet top  RListParamSheet2
screen FormPar 'Формирование расчетных листков';
fields
 _exportPDFForPortal: noProtect;
<<





























  [.] - Учитывать заявления на получение расчетных листков (FR полная форма в PDF)`
>>
end;
//end;

window wNastroyka 'Настройки печати', doAccept, EscClose, Gray;
  //show at (,, 70, 21);

screen Nastroyka;
  table Zar_User;
Fields
   NPOEM_OWN_ZP_RList_SortDef ('Не работает при установленных группировках или при вкл. сортировке по ФИО')
     : [List 0  'по умолчанию'
            ,1  'по коду подразделения +ФИО'
            ,2  'по 3 символам кода подразделения +ФИО'
              ], Protect;
<< 'Настройки печати'
 `Сортировка ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@



















>>
end;//screen Nastroyka;
HandleEvent
cmCheckField:
{  case inherited :: handleEvent (cmInit) of
   heAbort:{abort;exit;}
   heStop:{stop;exit;}
   end;
   case CurField of
    #NPOEM_OWN_ZP_RList_SortDef: wSetTune('NPOEM_OWN.ZP.RList_SortDef',NPOEM_OWN_ZP_RList_SortDef);
   end;
}
end; // handle
end; // window wNastroyka
handleevent
cminit:
{
   NPOEM_OWN_ZP_RList_SortDef:=0;
   if ExistTune('NPOEM_OWN.ZP.RList_SortDef')
      NPOEM_OWN_ZP_RList_SortDef:=wGetTune('NPOEM_OWN.ZP.RList_SortDef');


   if ExistTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal')
    if wGetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal') <> 1
      then wSetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal', 1);

   set _exportPDFForPortal := wGetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal');

   case inherited :: handleEvent (cmInit) of
   heAbort:{abort;exit;}
   heStop:{stop;exit;}
   end;

}
cmcheckField:
{
 inherited :: handleEvent (cmcheckField);

 if (RListForm and 1) = 0 then // Если снята галка "Полная форма листа"
  {
   set _exportPDFForPortal := 0;
   rereadrecord;
  }
}
cmOk:
{
//  Message('cmOK')
    wSetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal',_exportPDFForPortal) ;

    if wGetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal') = 1
//       GetCurrentFormat
     if getcurrentformat() <> FORMPAR
     {
      wSetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal',0) ;
     }


    if ( RListFormType = cn_FastRep ) and wGetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal') = 1 //wGetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal') = 1// UpCase(USERNAME) = 'LAPUSHKOV_DV'
    {
   //
      if (wYearBeg <> wYearEnd) or (wMonthBeg <> wMonthEnd)
       then
       {
         Message('Формирование PDF файлов возможно только за один месяц',error);
         stop; abort; exit;
       }
      FillMarks;
      delete all ForMarksEM ;
      insert into ForMarksEM (MARKED, FIELD1, CPODR, CLSCHET, FIELD2, STRTABN, FIELD4, CHOICE, FIO, PrBornDate, SUMMA)
      select MARKED, FIELD1, CPODR, CLSCHET, FIELD2, STRTABN, FIELD4, CHOICE, FIO, PrBornDate, SUMMA from ForMarks;
      StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Формирование PDF файлов...', RecordsInTable(#FormarksEM));
      LockLogFile;

      _loop ForMarksEM
       {
        if isExistZayavlenie(ForMarksEM.CLSCHET)
         {
          if not nextvisual then break;
          delete all ForMarks ;
          ForMarks.buffer := type$ForMarks(ForMarksEM.Buffer);
          Insert current ForMarks ;

          var iFrRList: FR_RList;
          if iFrRList.FillReport(oRListPar(self))
           then iFrRList.ShowReports;
         }
       }
      wSetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal',0);
   //   message(recordsintable(tnForMarks))
      delete all ForMarks ; // непонятно почему то в таблице одна запись всегда есть 0_0
      _loop ForMarksEM
       {
        if not isExistZayavlenie(ForMarksEM.CLSCHET)
        {
          insert into ForMarks set
                ForMarks.MARKED     := ForMarksEM.MARKED
              , ForMarks.FIELD1     := ForMarksEM.FIELD1
              , ForMarks.CPODR      := ForMarksEM.CPODR
              , ForMarks.CLSCHET    := ForMarksEM.CLSCHET
              , ForMarks.FIELD2     := ForMarksEM.FIELD2
              , ForMarks.STRTABN    := ForMarksEM.STRTABN
              , ForMarks.FIELD4     := ForMarksEM.FIELD4
              , ForMarks.CHOICE     := ForMarksEM.CHOICE
              , ForMarks.FIO        := ForMarksEM.FIO
              , ForMarks.PrBornDate := ForMarksEM.PrBornDate
              , ForMarks.SUMMA      := ForMarksEM.SUMMA
            ;
        }
       }
//       Message(recordsintable(tnForMarks));
      StopVisual('', 0);
      if recordsintable(tnForMarks) > 1  then
       {
         inherited :: handleEvent (cmOK);
       }
      wSetTune('NPOEM_OWN.ZP.RList_ExportToPDFForPortal',1);
      delete all ForMarks ;
      insert into ForMarks (MARKED, FIELD1, CPODR, CLSCHET, FIELD2, STRTABN, FIELD4, CHOICE, FIO, PrBornDate, SUMMA)
      select MARKED, FIELD1, CPODR, CLSCHET, FIELD2, STRTABN, FIELD4, CHOICE, FIO, PrBornDate, SUMMA from ForMarksEM;
    }
    else
    {
     inherited :: handleEvent (cmOK);
    }
}
end;

end.
