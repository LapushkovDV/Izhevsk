/*************************************************************************************************\
* Наименование:  Импорт номера банковского счета в лицевой счет из файла                          *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    Настройка - Каталоги - Зарплатные проекты -                                      *
*                Газпромбанк - Добавление банковских реквизитов                                   *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |EM-102        |30/12/19|Торохов А.П.            |НПО Энергомаш                     *
\*************************************************************************************************/

#component "Z_Service"

Alter InterFace ImportBankAccountNumber;

OverLoad
Procedure MakeExcelPreview;
procedure pSetFormat(wTypeImport: word);
End;

procedure pSetFormat(wTypeImport: word);
{
  If UpCase(Trim(ZarplProject.nameProject)) <> 'ГАЗПРОМБАНК'
  {
    Inherited::pSetFormat(wTypeImport);
    Exit;
  }

  SetFieldState(#SerandNumber,     sfVisible);
  ClearFieldState(#PREVIEW.sBankCardNumber, sfVisible);
  ClearFieldState(#PREVIEW.DATBEG, sfVisible);
  ClearFieldState(#PREVIEW.DATEND, sfVisible);
  ClearFieldState(#PREVIEW.sResult,  sfVisible);
}


Procedure MakeExcelPreview;
{
  var isMtPersons : Boolean = False;
  var bFound      : boolean = false;
  var recLine     : Record
                      npp       : String;
                      sDoc      : String;
                      ser       : String;
                      nmb       : String;
                      familiya  : String;
                      imya      : String;
                      otchestvo : String;
                      ban       : String;
                    End;
  
  If UpCase(Trim(ZarplProject.nameProject)) <> 'ГАЗПРОМБАНК'
  {
    Inherited::MakeExcelPreview; 
    Exit;
  }

  if not CheckExcelState
    exit;

  xlDisplayAlerts(False);
  StartNewVisual(vtRotateVisual, vfTimer + vfConfirm, 'Подготовка списка для импорта', 1);

  row := 2; //Первая строка - наименование столбцов

  PushBounds(tbbnPersons);
  PushBounds(tbbnLSCHET);      
  do
  {
    If(Not NextVisual)
    { Break; }
    
     ClearAdvRecord(recLine);
    xlGetCellValue(row, 1, recLine.npp      );
    xlGetCellValue(row, 3, recLine.sDoc     );
    xlGetCellValue(row, 4, recLine.ser      );
    xlGetCellValue(row, 5, recLine.nmb      );
    xlGetCellValue(row, 6, recLine.familiya );
    xlGetCellValue(row, 7, recLine.imya     );
    xlGetCellValue(row, 8, recLine.otchestvo);
    xlGetCellValue(row, 9, recLine.ban      );
    
    sFIOfromXML := Trim(recLine.familiya+' '+recLine.imya+' '+recLine.otchestvo);
    
    If (sFIOfromXML = '')
    { Break; }
    
    If(Not isMtPersons)
    {
      insert into mt_Persons (nRec, FIO)
        select Persons.nRec, Trim(UpCase(GetSurnameWithInitials(Persons.FIO)))
        from Persons
        where (('С'  == Persons.IsEmployee));      
      isMtPersons := True;
    }        
    
    sFIOfromXML  := Trim(UpCase(GetSurnameWithInitials(sFIOfromXML)));
    bFound       := False;
    _loop mt_PERSONS
    {
      if (not IsValid(#PERSONS))
      { continue; }
      
      if    (UpCase(Replace(PASSPORTS.SER, ' ', '')) <> UpCase(Replace(recLine.ser, ' ', ''))) 
         Or (UpCase(Replace(PASSPORTS.NMB, ' ', '')) <> UpCase(Replace(recLine.nmb, ' ', ''))) 
      { continue; }
      
      _Loop LSchet
      {
        ClearBuffer(#PREVIEW);
        PREVIEW.PANREC            := LSCHET.NREC;
        PREVIEW.STRTABN           := GetStrTabN(LSCHET.TABN, LSCHET.STRTABN);        
        PREVIEW.FULLNAME          := PERSONS.FIO;
        PREVIEW.DEPARTMENT        := LSCHET.CEX;
        PREVIEW.DATHIRED          := LSCHET.DATPOS;
        PREVIEW.DATDISMISS        := LSCHET.DATUV;                
        PREVIEW.BANKACCOUNTNUMBER := recLine.ban;
        PREVIEW.SeriesDoc         := recLine.ser;
        PREVIEW.sNumberDoc        := recLine.nmb;
        PREVIEW.sCodeDoc          := recLine.sDoc;
        insert current PREVIEW;
        bFound := true; // нашли хотя бы один лицевой счет
      }       
    }//_loop mt_PERSONS
        
    If(Not bFound)
    {      
      ClearBuffer(#PREVIEW);
      PREVIEW.STRTABN           := 'не найден';
      PREVIEW.FULLNAME          := Trim(recLine.familiya+' '+recLine.imya+' '+recLine.otchestvo);
      PREVIEW.BANKACCOUNTNUMBER := recLine.ban;
      PREVIEW.SeriesDoc         := recLine.ser; 
      PREVIEW.sNumberDoc        := recLine.nmb; 
      PREVIEW.sCodeDoc          := recLine.sDoc;
      insert current PREVIEW;       
    }       
    row++;
  }
  While (recLine.familiya<>'') and (recLine.imya<>'');

  PopBounds(tbbnPersons);
  PopBounds(tbbnLSCHET);
  StopVisual;
  xlKillExcel;  
}

End.