#IFNDEF _2018_10_19_
Function Find_Val:boolean;
{ Result:=vFnd.getfirst tmp_spr_gp=tsok;
}
Function Get_Val:string;
{ Result:=vFnd.tmp_spr_gp.Val;
}
Procedure Ins_Val(var  _Val:string);
{ vFnd.insert into tmp_spr_gp set tmp_spr_gp.KLUCH:=_Kluch
    ,tmp_spr_gp.cSpr :=_cSpr
    ,tmp_spr_gp.Val  :=_Val
    ;
}
Procedure Ins_Val1(var  _Val:string; var _Kod:string);
{ vFnd.insert into tmp_spr_gp set tmp_spr_gp.KLUCH:=_Kluch
    ,tmp_spr_gp.cSpr :=_cSpr
    ,tmp_spr_gp.Val  :=_Val
    ,tmp_spr_gp.Kod  :=_Kod
    ;
}
