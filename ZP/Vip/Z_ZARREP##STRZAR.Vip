create view
as select tmp_nach_gp.*,tmp_Perech_gp.*,tmp_uder_gp.*
From tmp_nach_gp,tmp_Perech_gp,tmp_uder_gp
Bounds bytmp_nach_gpVidopl   tmp_nach_gp.VIDOPLS   == KlVidopl1.Vidopl
Bounds bytmp_Perech_gpVidopl tmp_Perech_gp.VIDOPLS == KlVidopl1.Vidopl
Bounds bytmp_Perech_gpS      tmp_Perech_gp.VIDPER  == perech.vidper
;

