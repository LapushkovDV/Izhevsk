Function GetAnyKau_My(_tbl:word;_ckau:comp):string;
// GetAnyKau(cgAkNoDef, #DeclValue.TBLD[kaucounter], #DeclValue.CKAUD[kaucounter]);
{ vFnd._Kluch:='GetAnyKau'+string(_tbl);
  vFnd._cSpr:=_cKAu;
  if Find_Val
  { Result:=Get_Val;
  }
  else
  { GetAnyKau(cgAkNoDef, _tbl,_ckau);
    Result:= ''''+GivenAnName(1);
    Ins_Val(Result);
  }
}

//-- GP
Function GetPost(_pNrec:comp):string;
{ vFnd._Kluch:='GetPost';
  vFnd._cSpr:=_pNrec;

  if Find_Val
  { Result:=Get_Val;
  }
  else
  { Result:='';
    if getfirst fastfirstrow Catalogs where (( _pNrec == Catalogs.Nrec)) =tsok
       Result:= Catalogs.Name;
    Ins_Val(Result);
  }

}


