//------------------------------------------------------------------------------------------------------------
// инициализируем Excel
//------------------------------------------------------------------------------------------------------------
procedure InitializeExcel;
var
  aFileName,wstr: String;
  akolfile :longint;
  aFileName1: string ;
  aPictBook:string;
{
 //GP xlCreateExcel('Отчет1', true);
 xlOpenNewExcel(true);
 aFileName:=GetStringParameter('Files','OutputFilesDirectory',0) + 'Состав зарплаты.Xlsm';
 akolfile:=0 ;
  if true //FileExist(aFileName)
  {
    if not DeleteFile(aFileName)
    { do
      { akolfile:=akolfile+1 ;
        if akolfile>20 then
        { akolfile:=0 ;
        }
        aFileName1:=substr(aFileName,1,pos('.',aFileName)-1)+'d'+string(akolfile)+'.xls';
        if FileExist(aFileName1)
        { DeleteFile(aFileName1)
        }
      } while fileexist(aFileName1)
      if akolfile=0
      { message('Ошибка при удалении файла '+chr(13)+aFileName+
        chr(13)+'возможно он открыт другой программой') ;
        exit ;
      }
      else aFileName:=aFileName1 ;
    }
  } //if false //FileExist(aFileName)
  aPictBook:='';
  if XLGETACTIVEWORKBOOKNAME(aPictBook)
    xlSaveAsWorkBookByName(aPictbook, aFileName);


//GP  - заменил 100 на 1000 , 5000 уже обратный эффект
  if isBitCtW(wGp_Options,1)
    xlCreateMatrix(Matrix_Row1, DimOfArray2)
  else
    xlCreateMatrix(100, DimOfArray2);
  if (xlIsExcelValid)
    xlSetActiveWorkBookByName('Отчет');

  countPage := 1;
  FormNewPageData();

  InsertInXLSparameters;
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak, 'Идет формирование отчета', 50);

  // Определим версию Excel в параметр sVersion:
  // 9  - Excel 2000
  // 10 - Excel 2002
  // 11 - Excel 2003
  // 12 - Excel 2007
  // 14 - Excel 2010
  if not(xlGetVersionExcelInstall(sVersion)) // Если не удалось определить версию Excel
    sVersion := '9';                         // будем считать, что установлена самая старая (9 - Excel 2000)

  boUseDopColumn:=false;
  if getfirst tmpNastr where (( 'П' == tmpNastr.typeCol ))=tsok
    boUseDopColumn:=true
  else
  if getfirst tmpNastr where (( 'ПП' == tmpNastr.typeCol ))=tsok
    boUseDopColumn:=true
}
//------------------------------------------------------------------------------------------------------------
//  Формирование новой страницы с данными
//------------------------------------------------------------------------------------------------------------
procedure FormNewPageData;
{ //Inherited::FormNewPageData
  if countPage = 1
  {
    xlSetSheetName(countPage, 'исходные данные');
  }
  else
    xlSetSheetName(countPage, 'исходные данные(' + string(countPage) + ')');
  xlSetActiveSheet(countPage);
  countPage := countPage + 1;
  xlSetCellStringValue('Наименование', 1, 1, 1, 1);
  xlSetCellStringValue('Сумма', 1, 2, 1, 2);
  xlSetCellStringValue('Вид работы', 1, 3, 1, 3);
  xlSetCellStringValue('Подразделение', 1, 4, 1, 4);
  xlSetCellStringValue('Код подразделения', 1, 5, 1, 5);
  xlSetCellStringValue('Категория', 1, 6, 1, 6);
  xlSetCellStringValue('Счет', 1, 7, 1, 7);
  xlSetCellStringValue('Субсчет', 1, 8, 1, 8);
  xlSetCellStringValue('ХозОперация', 1, 9, 1, 9);
  xlSetCellStringValue('Группа начисления', 1, 10, 1, 10);
  xlSetCellStringValue('Пол', 1, 11, 1, 11);
  xlSetCellStringValue('Табельный номер', 1, 12, 1, 12);
  xlSetCellStringValue('ФИО', 1, 13, 1, 13);
  xlSetCellStringValue('Месяц, за который', 1, 14, 1, 14);
  xlSetCellStringValue('Год, за который', 1, 15, 1, 15);
  xlSetCellStringValue('Месяц, в котором', 1, 16, 1, 16);
  xlSetCellStringValue('Год, в котором', 1, 17, 1, 17);
  xlSetCellStringValue('ТИП', 1, 18, 1, 18);
  xlSetCellStringValue('На вид оплаты', 1, 19, 1, 19);
  xlSetCellStringValue('Система оплаты', 1, 20, 1, 20);
  xlSetCellStringValue('Должность', 1, 21, 1, 21);
  xlSetCellStringValue('системный код', 1, 22, 1, 22);
  xlSetCellStringValue('пользовательский код', 1, 23, 1, 23);
//GP
  xlSetCellStringValue('Количество дн.по грф'  , 1, 24, 1, 24);
  xlSetCellStringValue('Часы по графику'       , 1, 25, 1, 25);
  xlSetCellStringValue('Количество дней'       , 1, 26, 1, 26);
  xlSetCellStringValue('Количество часов'      , 1, 27, 1, 27);
  xlSetCellStringValue('Наименование категории', 1, 28, 1, 28);
  xlSetCellStringValue('Код Цеха'              , 1, 29, 1, 29);
  xlSetCellStringValue('Образование'           , 1, 30, 1, 30);
  xlSetCellStringValue('Возраст'               , 1, 31, 1, 31);
//END GP
  Kaucounter := 0;
  if KauDepth > 0
  {
    for(kaucounter := 1; kaucounter <= kauDepth; kaucounter := kaucounter + 1)
    {
      xlSetCellStringValue('КАУ' + string(kaucounter), 1, ConstFields + kaucounter, 1, ConstFields + kaucounter);
    }
  }
  ColNum := 0;
  _loop tmpNastr where (( 'П'== tmpNastr.typeCol ))
  {
    ColNum := ColNum + 1;
    xlSetCellStringValue( tmpNastr.Name,1 ,ConstFields + KauDepth + ColNum,1 ,ConstFields + kaucounter + ColNum );
  }
  _loop tmpNastr where (( 'ПП'== tmpNastr.typeCol ))
  {
    if not NullVipRef(ArrAlgP[tmpNastr.numberAlg])
    {
      ColNum := ColNum + 1;
      xlSetCellStringValue( ArrAlgP[tmpNastr.numberAlg].GetColName,1 ,ConstFields + KauDepth + ColNum,1 ,ConstFields + kaucounter + ColNum );
    }
  }
  lCol:=34+kauDepth-3;
  xlSetCellStringValue( lCol,1 ,118,1 ,118);

} //procedure FormNewPageData;
