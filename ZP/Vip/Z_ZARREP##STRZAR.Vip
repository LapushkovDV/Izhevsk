Function DirectFindKatego_Kod(ust: word): string;
{ vFnd._Kluch:='DirectFindKatego_KOD';
  vFnd._cSpr:=ust;
  if Find_Val
  { Result:=ParseWord(Get_Val,1,';');
    sKateg:=ParseWord(Get_Val,2,';');
  }
  else
  { if GetFirst KLKATEGO where ((ust == KLKATEGO.KOD)) = tsOk
    {  Result := KlKatego.Kod;
       sKateg := KlKatego.NAIKAT;
    }
    else
    {  Result := '';
       sKateg:='без категории';
    }
    Ins_Val(Result+';'+sKateg);
  }
}

//------------------------------------------------------------------------------------------------------------
// Поиск категории через табель
//------------------------------------------------------------------------------------------------------------
Function FindKatego(ust: comp; DateForKategory: date): string;
{ vFnd._Kluch:='FindKatego'+string(DateForKategory);
  vFnd._cSpr:=ust;
  if Find_Val
  { Result:=Get_Val;
  }
  else
  { Result:=Inherited::FindKatego(ust,DateForKategory);
    Ins_Val(Result);
  }
}


//------------------------------------------------------------------------------------------------------------
// Поиск категории через табель
//------------------------------------------------------------------------------------------------------------
Function FindKatego_KOD(ust: comp; DateForKategory: date): string;
{ vFnd._Kluch:='FindKatego'+string(DateForKategory);
  vFnd._cSpr:=ust;
  if Find_Val
  { Result:=ParseWord(Get_Val,1,';');
    sKateg:=ParseWord(Get_Val,2,';');
  }
  else
  { sKateg:=Inherited::FindKatego(ust,DateForKategory);
    if sKateg<>'без категории'
      Result:=KlKatego.Kod
    else
      Result:='';
    Ins_Val(Result+';'+sKateg);
  }
}
