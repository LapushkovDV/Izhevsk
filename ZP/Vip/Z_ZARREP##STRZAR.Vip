//------------------------------------------------------------------------------------------------------------
// проверим - используется ли поле
// 192 во - не попал в отбор 226,13	Капитоненков Денис Васильевич
//------------------------------------------------------------------------------------------------------------
Function GetUseFLD(_Field:string):boolean;
var _sFld:Array [1..5] of string;
    jj:word;
{ Result:=false;
  for(jj:=1;jj<=5;jj++)
    _sFld[jj]:='';
   case _Field of
     'VIDOPL','VIDOPLP','VIDOPLS'
    ,'VIDPER','NAMEPER'
    ,'VIDUD','VIDUDP','VIDUDS' :
   { _sFld[01]:='Наименование';
     _sFld[02]:='Группа начисления';
     _sFld[03]:='На вид оплаты';
     _sFld[04]:='Системный код';
     _sFld[05]:='Пользовательский код';
   }
   // 'CLSCH'
   'NSOVM':
   { _sFld[01]:='Вид работы';
   }
    'SISOPL'
   ,'NASISOPL':
   { _sFld[02]:='Система оплаты';
   }
   'CEX','CEXOZ':
   { _sFld[01]:='Подразделение';
     _sFld[02]:='Код подразделения';
   }
    'KATEG'
   ,'NAIKAT'   :
   { _sFld[01]:='Категория';
     _sFld[02]:='Наименование категории';
   }
   'CSCHETD' ,'CSCHETK': _sFld[01]:='Счет';
   'CSUBSCHD','CSUBSCHK':_sFld[01]:='Субсчет';
   'CHOZOPER','HOZOPER_NAME': _sFld[01]:='ХозОперация';
   'TPERSON','FIO','SEX'
   :
   { _sFld[01]:='Пол';
     _sFld[02]:='ФИО';
   }
   'TABN','STRTABN' : _sFld[01]:='Табельный номер';
   'MES','MESK'     : _sFld[01]:='Месяц, за который';
   'YEAR','YEARK'   : _sFld[01]:='Год, за который';
   'MESV','MESN'    : _sFld[02]:='Месяц, в котором';
   'YEARV','YEARN'  :_sFld[01]:='Год, в котором';
  //_sFld[01]:='ТИП'';
   'CAPPOINT','POST':  _sFld[01]:='Должность';
  'TBLD[1]','CKAUD[1]','TBLK[1]','CKAUK[1]' :   _sFld[01]:='КАУ1';
  'TBLD[2]','CKAUD[2]','TBLK[2]','CKAUK[2]' :   _sFld[02]:='КАУ2';
  'TBLD[3]','CKAUD[3]','TBLK[3]','CKAUK[3]' :   _sFld[03]:='КАУ3';
  'TBLD[4]','CKAUD[4]','TBLK[4]','CKAUK[4]' :   _sFld[04]:='КАУ4';
  'TBLD[5]','CKAUD[5]','TBLK[5]','CKAUK[5]' :   _sFld[05]:='КАУ5';
  'TBLD[6]','CKAUD[6]','TBLK[6]','CKAUK[6]' :   _sFld[06]:='КАУ6';
  end;
  //----------------
  for(jj:=1;jj<=5;jj++)
    if _sFld[jj]<>''
      if getfirst tmpNastr where ((
        'C' == tmpNastr.typeCol and _sFld[jj]== tmpNastr.Name
        and ( numberRow<>0 or numberCol<>0 or numberFlt<>0)
        ))=tsok
      { Result:=true;
        Exit;
      }

} //Function GetUseFLD(_Field:string):boolean;

//------------------------------------------------------------------------------------------------------------
//   Заменим скобки чтобы добавить в as
//------------------------------------------------------------------------------------------------------------
#IFNDEF _2018_10_19_

Function sReplArray(const w:string):string;
{ Result:=Replace(Replace(w,'[',''),']','');
}
#ENDIF //IFNDEF _2018_10_19_


//------------------------------------------------------------------------------------------------------------
// Добавление полей
//------------------------------------------------------------------------------------------------------------
Function Add_Field(_Table:String;_Field:string;L:word;_wTP:word;_comma:string):boolean;
var _boGroup:boolean;
    _sFld_Name:string;
{ Result:=false;
  _boGroup:=false;
  _Field:=UpCase(Trim(_Field));
  _sFld_Name:=_Table+'.'+_Field;
  case _Table of
  'PERSONS'  :
  { if _Field='AGE'
     _sFld_name:='COALESCE('+string(WYEAREND)
      +'-Year(DATETIME(Persons.BornDate,0))-(CASE WHEN MONTH(DATETIME(Persons.BornDate,0))>'
                                       +String(WMONTHEND)+' THEN 1 ELSE 0 END),0)'
    else
     _sFld_Name:='COALESCE('+_sFld_Name+',''!?'' )';
  }
  'KLKATEGO' :
  { if _Field='KOD'
      _sFld_Name:='COALESCE('+_sFld_Name+',0 )';
    else
      _sFld_Name:='COALESCE('+_sFld_Name+',''!?'' )';
  }
  'KLSOVM'   : _sFld_Name:='COALESCE('+_sFld_Name+',''без вида работы'' )';
  'HOZOPER'  : _sFld_Name:='COALESCE('+_sFld_Name+','' '' )';
  'CATALOGS' : _sFld_Name:='COALESCE('+_sFld_Name+','' '' )';
  'CATEDUCATION' : _sFld_Name:='COALESCE('+_sFld_Name+','' '' )';
  'KLSISOPL' : _sFld_Name:='COALESCE('+_sFld_Name+','' '' )';
  end;
  //Задана группировка
  if IsBitCtW(wGP_Options,2)
  { _boGroup:=GetUseFLD(_Field);
    // если вызов из group by уберем поля без группировок,
    // иначе добавим агрегатные функции
    if not _boGroup
    { if _wTp=1 then
      { exit;
      }
      else
      { case _Field of
        'SUMMA','SUMUD','SUMPER'
        ,'KOLDNGR'//││Количество дн.по грф
        ,'CHASGR' //││Часы по графику
        ,'KOLDN'  //││Количество дней
        ,'CHASF'  //││Количество часов
        :
        _sFld_Name:='Sum('+_sFld_Name+') as '+sReplArray(_Field);
        else
        _sFld_Name:='Max('+_sFld_Name+') as '+sReplArray(_Field);
        end;
      }
    } //if not _boGroup
    else
    {
      if _wTp=1
      { if _comma='' _sFld_Name:='Group by '+_sFld_Name
      }
    } //else if not _boGroup
  } //if IsBitCtW(wGP_Options,2)
  else
  { if _wtp=1 then exit;

  } //else if IsBitCtW(wGP_Options,2)
  Result:=true;
  PrepareSQLQuery(_comma+_sFld_Name);

} //Function Add_Field(_Table:String;_Field:string;L:word;_wTP:word;_comma:string):boolean;

//------------------------------------------------------------------------------------------------------------
// Добавление полей удержания
//------------------------------------------------------------------------------------------------------------
Procedure Add_Fields_Uder(_Table:String;L:word;_wTP:word);
var _comma:string; //запятая
{
    _comma:='';
    if Add_Field(_Table,'Nrec     ',L,_wTp,_comma) _comma:=',';//
    if Add_Field(_Table,'TABN     ',L,_wTp,_comma) _comma:=',';//│Табельный номер
    if Add_Field(_Table,'CEXOZ    ',L,_wTp,_comma) _comma:=',';//│Цех отнесения затрат
    if Add_Field(_Table,'MESN     ',L,_wTp,_comma) _comma:=',';//│Месяц, в котором удержано
    if Add_Field(_Table,'MES      ',L,_wTp,_comma) _comma:=',';//│Месяц, за который удержано
    if L=1
    { if Add_Field(_Table,'VIDUDP   ',L,_wTp,_comma) _comma:=',';//│Вид удержания пользов
    }
    else
    { if Add_Field(_Table,'VIDUD    ',L,_wTp,_comma) _comma:=',';//│Вид удержания пользов

    }
    if Add_Field(_Table,'SUMUD    ',L,_wTp,_comma) _comma:=',';//│Сумма удержания
    if L=1
    { if _wTp=0
      { PrepareSQLQuery(',0.00 as CHASF  ');//  ││Количество часов
        PrepareSQLQuery(',0.00 as KOLDN  ');//  ││Количество дней
      }
    }
    else
    { if Add_Field(_Table,'CHASF    ',L,_wTp,_comma) _comma:=',';//│Количество часов
      if Add_Field(_Table,'KOLDN    ',L,_wTp,_comma) _comma:=',';//│Количество дней
    }
    if Add_Field(_Table,'CSCHETK  ',L,_wTp,_comma) _comma:=',';//│кредит. счет
    if Add_Field(_Table,'CSUBSCHK ',L,_wTp,_comma) _comma:=',';//│Субсчет кредит. счета
    if Add_Field(_Table,'CKAUK[1] ',L,_wTp,_comma) _comma:=',';//│КАУ кредит. счета[1]
    if Add_Field(_Table,'CKAUK[2] ',L,_wTp,_comma) _comma:=',';//│КАУ кредит. счета[1]
    if Add_Field(_Table,'CKAUK[3] ',L,_wTp,_comma) _comma:=',';//│КАУ кредит. счета[1]
    if Add_Field(_Table,'CKAUK[4] ',L,_wTp,_comma) _comma:=',';//│КАУ кредит. счета[1]
    if Add_Field(_Table,'CKAUK[5] ',L,_wTp,_comma) _comma:=',';//│КАУ кредит. счета[1]
    if Add_Field(_Table,'CKAUK[6] ',L,_wTp,_comma) _comma:=',';//│КАУ кредит. счета[1]
    if Add_Field(_Table,'TBLK[1]  ',L,_wTp,_comma) _comma:=',';//│таблицы КАУ кредит. счета[1]
    if Add_Field(_Table,'TBLK[2]  ',L,_wTp,_comma) _comma:=',';//│таблицы КАУ кредит. счета[1]
    if Add_Field(_Table,'TBLK[3]  ',L,_wTp,_comma) _comma:=',';//│таблицы КАУ кредит. счета[1]
    if Add_Field(_Table,'TBLK[4]  ',L,_wTp,_comma) _comma:=',';//│таблицы КАУ кредит. счета[1]
    if Add_Field(_Table,'TBLK[5]  ',L,_wTp,_comma) _comma:=',';//│таблицы КАУ кредит. счета[1]
    if Add_Field(_Table,'TBLK[6]  ',L,_wTp,_comma) _comma:=',';//│таблицы КАУ кредит. счета[1]
    if Add_Field(_Table,'CLSCH    ',L,_wTp,_comma) _comma:=',';//│Код работника из ЛСЧ
    if Add_Field(_Table,'TPERSON  ',L,_wTp,_comma) _comma:=',';//│Код работника из ФЛ
    if Add_Field(_Table,'PRPER    ',L,_wTp,_comma) _comma:=',';//│Признак удер
    if L=1
    { if Add_Field(_Table,'VIDUD   ',L,_wTp,_comma) _comma:=',';//│Системный Вид удержания
    }
    else
    { if Add_Field(_Table,'VIDUDS   ',L,_wTp,_comma) _comma:=',';//│Системный Вид удержания
    }
    if Add_Field(_Table,'CHOZOPER ',L,_wTp,_comma) _comma:=',';//│Ссылка на ТХО
    if Add_Field(_Table,'MESV     ',L,_wTp,_comma) _comma:=',';//│Месяц выплаты
    if Add_Field(_Table,'YEARV    ',L,_wTp,_comma) _comma:=',';//│Год выплаты
    if Add_Field(_Table,'CAPPOINT ',L,_wTp,_comma) _comma:=',';//│Ссылка на должность
    if Add_Field(_Table,'KATEG    ',L,_wTp,_comma) _comma:=',';//│Код категории(должности)
    if Add_Field(_Table,'STRTABN  ',L,_wTp,_comma) _comma:=',';//│строковый табельный номер
    if Add_Field(_Table,'YEARK    ',L,_wTp,_comma) _comma:=',';//│Год, за который удержано
    if Add_Field(_Table,'YEARN    ',L,_wTp,_comma) _comma:=',';//│Год, в котором удержано
    if Add_Field(_Table,'DATAN    ',L,_wTp,_comma) _comma:=',';//│
    if Add_Field('PERSONS','FIO',L,_wTp,_comma) _comma:=',';//│
    if Add_Field('PERSONS','SEX',L,_wTp,_comma) _comma:=',';//│
    if _wTp=0
    { //PrepareSQLQuery(', '' '' as KLKATEGO_NAIKAT');
    }
    if Add_Field('KLSOVM'  ,'NSOVM'   ,L,_wTp,_comma) _comma:=',';//│
    if Add_Field('HOZOPER' ,'NAME1'   ,L,_wTp,_comma) _comma:=',';//│
    if Add_Field('CATALOGS','NAME'    ,L,_wTp,_comma) _comma:=',';//│
    if Add_Field('CATEDUCATION','NAME',L,_wTp,_comma) _comma:=',';//│
    if Add_Field('PERSONS','AGE'      ,L,_wTp,_comma) _comma:=',';//│
} //Procedure Add_Fields_Uder(_Table:String;L:word;_wTP:word);
//------------------------------------------------------------------------------------------------------------
// Обработка удержаний
//------------------------------------------------------------------------------------------------------------
function UderLoop_DSQL: boolean;
var
  j: longInt;
  l: word;
  wErr:word;
  _Table:string;
  isAllOk:boolean;
{ Result:=false;
  MTRetrieve(#tmp_uder_gp,mfFilters + mfClear);
  stmt:=0;
  delete all tmp_uder_gp;
  dBegin := AM_FirstDate(byte(wMonthBeg), integer(wYearBeg));
  dEnd   := AM_FirstDate(byte(wMonthEnd), integer(wYearEnd));
  isAllOk:=true;
  //==================сам запрос ===================
  CreateTempVib;
  _loop tmpPodr
  { InsTempVibOne(01,tmpPodr.Nrec);//
  }
  _loop tmpvidud
  { if GetFirst KLVIDUD where ((tmpvidud.VidUdP == KLVIDUD.VIDUD)) = tsOK
    InsTempVibOne(02,KLVIDUD.Nrec)  //tmpViDopl.VIDOPLS == klvidopl1.VIDOPL      and
  }
  _loop tmpViDoplU
  { if GetFirst KLVIDOPL where ((tmpViDoplU.VIDOPLS == KLVIDOPL.VIDOPL)) = tsOK

    InsTempVibOne(03,klvidopl.Nrec)  //tmpViDopl.VIDOPLS == klvidopl1.VIDOPL      and
  }
  PushBounds(tnKlVidopl1);
  For(l:=1;l<=2;l++)
  { if not iNextVisual('Выборка удержаний, Этап '+string(L))
    { isAllOk:=false;
      break;
    }
    case l of
    1:
    { _Table:='SUMVIDUD';
      if dBegin>= dGetTune('Up.DatOtch') continue;
    }
    2:
    { _Table:='UDER';
      if DEnd< dGetTune('Up.DatOtch') continue;
    }
    end;
    ClearQuery(vliSQLCommand);
    //if boGP_SCUD_Pers   InsTempVibByMarker(01,Marker_GP_SCUD_Pers  );//Сотрудники

    PrepareSQLQuery('select ');
    Add_Fields_Uder(_Table,L,0);
    PrepareSQLQuery('From '+_Table);
    PrepareSQLQuery('inner join tempvib VibPodr on VibPodr.wlist=1 and VibPodr.crec = '+_Table+'.cexoz');
    if GetMarkerCount(UderMarkers)>0 //( lnCount_UderMarkers > 0 )
    { case l of
      1:   PrepareSQLQuery('Inner join KlVidUd on KlVidUd.VidUd = '+_Table+'.Vidud');
      else PrepareSQLQuery('Inner join KlVidUd on KlVidUd.VidUd = '+_Table+'.VidudS');
      end;
      PrepareSQLQuery('inner join tempvib VibOpl on VibOpl.wlist=2 and VibOpl.crec = KlVidUd.Nrec ');
    }
    //  if ( not fboCheckUder(SUMVIDUD.PrPer) ) continue;
    if ( ( wNotPr and 16 ) = 16 )
    { if ( lnCount_NachMarkers > 0 )
      //if ( GetFirst tmpViDoplU where (( lVidVopl_ == tmpViDoplU.VIDOPLS )) <> tsOk )
      { PrepareSQLQuery('Inner join KlVidOpl on KlVidOpl.VidOpl = '+_Table+'.PrPer');
        PrepareSQLQuery('inner join tempvib VibOpl1 on VibOpl1.wlist=3 and VibOpl1.crec = KlVidOpl.Nrec ');

      }
    }
    PrepareSQLQuery('left outer join Persons on Persons.Nrec  = '+_Table+'.tPerson');
    PrepareSQLQuery('left outer join Lschet   on Lschet.Nrec  = '+_Table+'.cLsch  ');
    PrepareSQLQuery('left outer join KLSOVM   on KLSOVM.Sovm  = Lschet.Sovm');
    PrepareSQLQuery('left outer join HOZOPER  on HOZOPER.Nrec = '+_Table+'.cHozOper');
    PrepareSQLQuery('left outer join CATALOGS on CATALOGS.Nrec= '+_Table+'.cAppoint');
    PrepareSQLQuery('left outer join CATALOGS CATEDUCATION on CATEDUCATION.Nrec= Persons.EDUCATION');
    PrepareSQLQuery('where ');
    case l of
    2:
    { PrepareSQLQuery( _Table+'.YearV>='+string(wYearBeg)+' and '+_Table+'.YearV<='+string(wYearEnd) );
      PrepareSQLQuery(' and ('+_Table+'.YearV<'+string(wYearEnd) +' or '+_Table+'.MesV<='+string(wMonthEnd)+')');
      PrepareSQLQuery(' and ('+_Table+'.YearV>'+string(wYearBeg) +' or '+_Table+'.MesV>='+string(wMonthBeg)+')');
    }
    else
    { PrepareSQLQuery( _Table+'.YearN>='+string(wYearBeg)+' and '+_Table+'.YearN<='+string(wYearEnd) );
      PrepareSQLQuery(' and ('+_Table+'.YearN<'+string(wYearEnd) +' or '+_Table+'.MesN<='+string(wMonthEnd)+')');
      PrepareSQLQuery(' and ('+_Table+'.YearN>'+string(wYearBeg) +' or '+_Table+'.MesN>='+string(wMonthBeg)+')');
    }
    end;
    if IsBitCTW(wGP_Options,2)
    { Add_Fields_Uder(_Table,L,1);
    }
    stmt:=0;
    stmt := sqlAllocStmt;
    wErr:=ExecDSQLex(tntmp_uder_gp);

  } //For(l:=1;l<=3;l++)
  //----------------------
  j := 1;
  RESULT:=TRUE;

  if ( not InitWorkingTable ) exit;
  //----------------------
  if not isAllOk then exit;

  StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak, 'Обработка удержаний за ' +
      datetostr(dBegin,'month')  , recordsintable(#tmp_uder_gp)/Matrix_Row1);
  timelog('Отобрали '+string(RecordsInTable(#tmp_uder_gp)));
  _Loop tmp_uder_gp
  {       if (j = Matrix_Row1)
          { if not NextVisual
            { isAllOk:=False;
          Message('Процесс прерван пользователем', Information);
          StopVisual('',0);
          StopVisual('',0);
          xlSetAppVisibleMode(false);
          xlKillExcel;
          Result := false;
          Exit;

              break;
            }
            if wNewPage = 1
            {
              if (i > 65436 and word(sVersion) <= word(11))     // sVersion: 9  - Excel 2000; 10 - Excel 2002;
                or (i > 1048476 and word(sVersion) >= word(12)) // 11 - Excel 2003; 12 - Excel 2007; 14 - Excel 2010
              {
                FormNewPageData();
                i := Matrix_Row2;
              }
            }
            xlWriteMatrixToExcel((i - Matrix_Row3), 1);
            j := 1;
            xlClearMatrix;
          }
          //if getfirst Catalogs where ((SUMVIDUD.Cappoint == Catalogs.NREC)) <> tsOk
          //{
          //  Catalogs.Name := '';//чтобы не выводить предыдущую должность
          //};
          #FullFilMatrixU(tmp_uder_gp);
          inc(j);
          inc(i);
  } //tmp_uder_gp
  StopVisual('',0);
  xlWriteMatrixToExcel((i + 1) - j, 1);
  xlClearMatrix;
  DoneWorkingTable;
} // procedure UderLoop_DQL




//------------------------------------------------------------------------------------------------------------
// Обработка удержаний
//------------------------------------------------------------------------------------------------------------
function UderLoop: boolean;
{
 if IsBitCtW(wGP_Options,1)
    Result:=UderLoop_DSQL
  else
    Result:=Inherited::UderLoop;
} //function UderLoop: boolean;

//------------------------------------------------------------------------------------------------------------
// Добавление полей начисление
//------------------------------------------------------------------------------------------------------------
Procedure Add_Fields_Nach(_Table:String;L:word;_wTP:word);
var _comma:string; //запятая
{
    _comma:='';
    if Add_Field(_Table,'Nrec     ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'LASTUSER ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CLSCH    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CEXOZ    ',L,_wTp,_comma) _comma:=',';
    case L of
    1:
    { if Add_Field(_Table,'VIDOPL  ',L,_wTp,_comma) _comma:=',';
      if Add_Field(_Table,'VIDOPLP ',L,_wTp,_comma) _comma:=',';
    }
    else
    { if Add_Field(_Table,'VIDOPLS  ',L,_wTp,_comma) _comma:=',';
      if Add_Field(_Table,'VIDOPL   ',L,_wTp,_comma) _comma:=',';
    }
    end;
    if Add_Field(_Table,'KATEG    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CSCHETD  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CSUBSCHD ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TPERSON  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TABN     ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'STRTABN  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CAPPOINT ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CHOZOPER ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'MES      ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'MESN     ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'YEARN    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'YEARK    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'SISOPL   ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[1] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[2] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[3] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[4] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[5] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[6] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[1]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[2]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[3]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[4]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[5]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[6]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'SUMMA    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'KOLDNGR  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CHASGR   ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'KOLDN    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CHASF    ',L,_wTp,_comma) _comma:=',';
    if Add_Field('PERSONS','FIO',L,_wTp,_comma) _comma:=',';//│
    if Add_Field('PERSONS','SEX',L,_wTp,_comma) _comma:=',';//│
//-------------
    if Add_Field('KLKATEGO','NAIKAT',L,_wTp,_comma) _comma:=',';//│
    if Add_Field('KLSOVM'  ,'NSOVM' ,L,_wTp,_comma) _comma:=',';//│
    if Add_Field('HOZOPER' ,'NAME1' ,L,_wTp,_comma) _comma:=',';//│
    if Add_Field('CATALOGS','NAME'  ,L,_wTp,_comma) _comma:=',';//│
    if Add_Field('KLSISOPL','NaSisOpl',L,_wTp,_comma) _comma:=',';//│KlSisOpl.SisOpl
//-------------
    if Add_Field('CATEDUCATION','NAME',L,_wTp,_comma) _comma:=',';//│
    if Add_Field('PERSONS','AGE'      ,L,_wTp,_comma) _comma:=',';//│

} //Procedure Add_Fields_Nach(_Table:String;_wTP:word);

//------------------------------------------------------------------------------------------------------------
// Обработка начислений
//------------------------------------------------------------------------------------------------------------
function SumVidOpLoop_DSQL: boolean;
var
  j: longInt;
  l: word;
  wErr:word;
  _Table:string;
  isAllOk:boolean;
{ Result:=false;
  MTRetrieve(#tmp_nach_gp,mfFilters + mfClear);
  stmt:=0;
  delete all tmp_nach_gp;
  dBegin := AM_FirstDate(byte(wMonthBeg), integer(wYearBeg));
  dEnd   := AM_FirstDate(byte(wMonthEnd), integer(wYearEnd));
  isAllOk:=true;
  //==================сам запрос ===================
  CreateTempVib;
  _loop tmpPodr
  { InsTempVibOne(01,tmpPodr.Nrec);//
  }
  _loop tmpvidopl
  { InsTempVibOne(02,klvidopl1.Nrec)  //tmpViDopl.VIDOPLS == klvidopl1.VIDOPL      and
  }
  PushBounds(tnKlVidopl1);
  For(l:=1;l<=3;l++)
  { if not iNextVisual('Выборка начислений, Этап '+string(L))
    { isAllOk:=false;
      break;
    }
    case l of
    1:
    { _Table:='SUMVIDOP';
      if dBegin>= dGetTune('Up.DatOtch') continue;
    }
    2:
    { _Table:='Nachisl';
      if DEnd< dGetTune('Up.DatOtch') continue;
    }
    3: _Table:='NeNach';
    end;
    ClearQuery(vliSQLCommand);
    //if boGP_SCUD_Pers   InsTempVibByMarker(01,Marker_GP_SCUD_Pers  );//Сотрудники

    PrepareSQLQuery('select ');
    Add_Fields_Nach(_Table,L,0);
    PrepareSQLQuery('From '+_Table);
    PrepareSQLQuery('inner join tempvib VibPodr on VibPodr.wlist=1 and VibPodr.crec = '+_Table+'.cexoz');
    if ( lnCount_NachMarkers > 0 )
    { case l of
      1:   PrepareSQLQuery('Inner join KlVidopl on KlVidopl.Vidopl = '+_Table+'.Vidopl');
      else PrepareSQLQuery('Inner join KlVidopl on KlVidopl.Vidopl = '+_Table+'.VidoplS');
      end;
      PrepareSQLQuery('inner join tempvib VibOpl on VibOpl.wlist=2 and VibOpl.crec = KlVidopl.Nrec ');
    }
    PrepareSQLQuery('left outer join Persons  on Persons.Nrec = '+_Table+'.tPerson');
    PrepareSQLQuery('left outer join Lschet   on Lschet.Nrec  = '+_Table+'.cLsch  ');
    PrepareSQLQuery('left outer join KLKATEGO on KLKATEGO.KOD = '+_Table+'.KATEG  ');
    PrepareSQLQuery('left outer join KLSOVM   on KLSOVM.Sovm  = Lschet.Sovm');
    PrepareSQLQuery('left outer join HOZOPER  on HOZOPER.Nrec = '+_Table+'.cHozOper');
    PrepareSQLQuery('left outer join CATALOGS on CATALOGS.Nrec= '+_Table+'.cAppoint');
    PrepareSQLQuery('left outer join KLSISOPL on KLSISOPL.SISOPL= Lschet.SiSopl');
    PrepareSQLQuery('left outer join CATALOGS CATEDUCATION on CATEDUCATION.Nrec= Persons.EDUCATION');
    PrepareSQLQuery('where ');
    case l of
    2:
    { PrepareSQLQuery( _Table+'.YearV>='+string(wYearBeg)+' and '+_Table+'.YearV<='+string(wYearEnd) );
      PrepareSQLQuery(' and ('+_Table+'.YearV<'+string(wYearEnd) +' or '+_Table+'.MesV<='+string(wMonthEnd)+')');
      PrepareSQLQuery(' and ('+_Table+'.YearV>'+string(wYearBeg) +' or '+_Table+'.MesV>='+string(wMonthBeg)+')');
    }
    else
    { PrepareSQLQuery( _Table+'.YearN>='+string(wYearBeg)+' and '+_Table+'.YearN<='+string(wYearEnd) );
      PrepareSQLQuery(' and ('+_Table+'.YearN<'+string(wYearEnd) +' or '+_Table+'.MesN<='+string(wMonthEnd)+')');
      PrepareSQLQuery(' and ('+_Table+'.YearN>'+string(wYearBeg) +' or '+_Table+'.MesN>='+string(wMonthBeg)+')');
    }
    end;
    if IsBitCTW(wGP_Options,2)
    { Add_Fields_Nach(_Table,L,1);
    }
    stmt:=0;
    stmt := sqlAllocStmt;
    wErr:=ExecDSQLex(tntmp_nach_gp);

  } //For(l:=1;l<=3;l++)
  //----------------------
  j := 1;
  //----------------------
  if not isAllOk then exit;
  PushBounds(tbbytmp_nach_gpVidopl);
  StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak, 'Обработка начислений за ' +
      datetostr(dBegin,'month')  , recordsintable(#tmp_nach_gp)/Matrix_Row1);
  timelog('Отобрали '+string(RecordsInTable(#tmp_nach_gp)));
  _Loop tmp_nach_gp
  {       if (j = Matrix_Row1)
          { if not NextVisual
            { isAllOk:=False;
              break;
            }
            if wNewPage = 1
            {
              if (i > 65436 and word(sVersion) <= word(11))     // sVersion: 9  - Excel 2000; 10 - Excel 2002;
                or (i > 1048476 and word(sVersion) >= word(12)) // 11 - Excel 2003; 12 - Excel 2007; 14 - Excel 2010
              {
                FormNewPageData();
                i := Matrix_Row2;
              }
            }
            xlWriteMatrixToExcel((i - Matrix_Row3), 1);
            j := 1;
            xlClearMatrix;
          }
          //if getfirst Catalogs where ((tmp_nach_gp.Cappoint == Catalogs.NREC)) <> tsOk
          //{Catalogs.Name := '';};
          #FulFilMatrix(tmp_nach_gp);
          xlDoWriteToMatrix(j, 2, tmp_nach_gp.SUMMA);
          inc(j);
          inc(i);
  } //_Loop tmp_nach_gp
  Result:=isAllOk;
  xlWriteMatrixToExcel((i + 1) - j, 1);
  xlClearMatrix;
  StopVisual('',0) ;
  PushBounds(tnKlVidopl1);
} //function SumVidOpLoop_DSQL: boolean;

function SumVidOpLoop: boolean;
{ if IsBitCtW(wGP_Options,1)
    Result:=SumVidOpLoop_DSQL
  else
    Result:=Inherited::SumVidOpLoop;
}


//------------------------------------------------------------------------------------------------------------
// Добавление полей Перечисления
//------------------------------------------------------------------------------------------------------------
Procedure Add_Fields_Perech(_Table:String;L:word;_wTP:word);
var _comma:string; //запятая
{
    _comma:='';
    if Add_Field(_Table,'Nrec     ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'LASTUSER ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CLSCH    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CEXOZ    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'VIDOPLS  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'VIDOPL   ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'KATEG    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CSCHETD  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CSUBSCHD ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TPERSON  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TABN     ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'STRTABN  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CAPPOINT ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CHOZOPER ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'MES      ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'MESN     ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'YEARN    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'YEARK    ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'SISOPL   ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[1] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[2] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[3] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[4] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[5] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CKAUD[6] ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[1]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[2]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[3]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[4]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[5]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'TBLD[6]  ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'SUMPER   ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'VIDPER   ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'OTKUDA   ',L,_wTp,_comma) _comma:=',';
    if Add_Field(_Table,'CNACH    ',L,_wTp,_comma) _comma:=',';
    if _wTp=0
    { PrepareSQLQuery(',0.00 as KOLDNGR');// ││Количество дн.по грф
      PrepareSQLQuery(',0.00 as CHASGR ');//   ││Часы по графику
      PrepareSQLQuery(',0.00 as KOLDN  ');//  ││Количество дней
      PrepareSQLQuery(',0.00 as CHASF  ');//  ││Количество часов
    }
    if Add_Field('PERSONS','FIO',L,_wTp,_comma) _comma:=',';//│
    if Add_Field('PERSONS','SEX',L,_wTp,_comma) _comma:=',';//│
//-------------
    if Add_Field('KLKATEGO','NAIKAT',L,_wTp,_comma) _comma:=',';//│
    if Add_Field('KLSOVM'  ,'NSOVM' ,L,_wTp,_comma) _comma:=',';//│
    if Add_Field('HOZOPER' ,'NAME1' ,L,_wTp,_comma) _comma:=',';//│
    if Add_Field('CATALOGS','NAME'  ,L,_wTp,_comma) _comma:=',';//│
    if Add_Field('KLSISOPL','NaSisOpl',L,_wTp,_comma) _comma:=',';//│KlSisOpl.SisOpl
//-------------
    if Add_Field('CATEDUCATION','NAME',L,_wTp,_comma) _comma:=',';//│
    if Add_Field('PERSONS','AGE'      ,L,_wTp,_comma) _comma:=',';//│
} //Procedure Add_Fields_Perech(_Table:String;_wTP:word);

//------------------------------------------------------------------------------------------------------------
// Обработка налогов на ФОТ
//------------------------------------------------------------------------------------------------------------
function PerevodLoop_DSQL: boolean;
var
  j     : longInt;
  Group :boolean;
  //---
  wErr:word;
  l: word;
  _Table:string;
  isAllOk:boolean;

{
  delete all tmpNalog;
  Group := false;
  Result := true;
  j := 1;
  dBegin := AM_FirstDate(byte(wMonthBeg), integer(wYearBeg));
  dEnd   := AM_FirstDate(byte(wMonthEnd), integer(wYearEnd));
  if ( recordExists tmpNastr where (( 'Группа начисления' == tmpNastr.name and 0 << tmpNastr.numberFlt )) = tsOk )
  {
    Group := true;
    PushBounds(tbNalogFot);
    _loop tmpVidOpl
    {
      _loop klperopl
      {
        StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak, 'Обработка налогов', RecordsInTable(#Perech));
        _loop perech where (( klperopl.vidper == perech.vidper ))
        {
          NextVisual;
          if (recordExists tmpNalog where (( perech.vidper == tmpNalog.Nalog )) <> tsOk)
          {
            clearbuffer(#tmpNalog);
            tmpNalog.Nalog := perech.vidper;
            insert current tmpNalog;
          }
        }
        StopVisual('',0);
      }
    }
    Popbounds(tbNalogFot);
  }

  //GP  ======================================
  Result:=false;
  MTRetrieve(#tmp_Perech_gp,mfFilters + mfClear);
  stmt:=0;
  delete all tmp_Perech_gp;
  isAllOk:=true;
  //==================сам запрос ===================
  CreateTempVib;
  _loop tmpPodr
  { InsTempVibOne(01,tmpPodr.Nrec);//
  }
  _loop tmpvidopl
  { InsTempVibOne(02,klvidopl1.Nrec)  //tmpViDopl.VIDOPLS == klvidopl1.VIDOPL      and
  }

  if ( Group )
  { _loop tmpnalog
    { if getfirst Perech where (( tmpnalog.Nalog == Perech.VidPer )) =tsok
      InsTempVibOne(03,Perech.Nrec)  //tmpViDopl.VIDOPLS == klvidopl1.VIDOPL      and
    }
  }
  else
  { _Loop  tmpPerech
    { if getfirst Perech where (( tmpPerech.VidPer == Perech.VidPer )) =tsok
      InsTempVibOne(03,Perech.Nrec)  //tmpViDopl.VIDOPLS == klvidopl1.VIDOPL      and
    }
  }
  PushBounds(tnKlVidopl1);
  PushBounds(tnPerech);

  For(l:=1;l<=2;l++)
  { if not iNextVisual('Выборка перечислений, Этап '+string(L))
    { isAllOk:=false;
      break;
    }
    case l of
    1:
    { _Table:='PEREVOD';
      if dBegin>= dGetTune('Up.DatOtch') continue;
    }
    2:
    { _Table:='PEREVODTEK';
      if dEnd< dGetTune('Up.DatOtch') continue;
    }
    end;
    ClearQuery(vliSQLCommand);
    //if boGP_SCUD_Pers   InsTempVibByMarker(01,Marker_GP_SCUD_Pers  );//Сотрудники

    PrepareSQLQuery('select ');
    Add_Fields_PERECH(_Table,L,0);
    PrepareSQLQuery('From '+_Table);
    PrepareSQLQuery('inner join tempvib VibPodr on VibPodr.wlist=1 and VibPodr.crec = '+_Table+'.cexoz');
    if ( lnCount_NachMarkers > 0 )
    { PrepareSQLQuery('Inner join KlVidopl on KlVidopl.Vidopl = '+_Table+'.VidoplS');
      PrepareSQLQuery('inner join tempvib VibOpl on VibOpl.wlist=2 and VibOpl.crec = KlVidopl.Nrec ');
    }
    if True // всегда нужно ( Group )
    { PrepareSQLQuery('Inner join Perech on Perech.VidPer = '+_Table+'.VidPer');
      PrepareSQLQuery('inner join tempvib VibPerech on VibPerech.wlist=3 and VibPerech.crec = Perech.Nrec ');
    }
    PrepareSQLQuery('left outer join Persons  on Persons.Nrec = '+_Table+'.tPerson');
    PrepareSQLQuery('left outer join Lschet   on Lschet.Nrec  = '+_Table+'.cLsch  ');
    PrepareSQLQuery('left outer join KLKATEGO on KLKATEGO.KOD = '+_Table+'.KATEG  ');
    PrepareSQLQuery('left outer join KLSOVM   on KLSOVM.Sovm  = Lschet.Sovm');
    PrepareSQLQuery('left outer join HOZOPER  on HOZOPER.Nrec = '+_Table+'.cHozOper');
    PrepareSQLQuery('left outer join CATALOGS on CATALOGS.Nrec= '+_Table+'.cAppoint');
    PrepareSQLQuery('left outer join KLSISOPL on KLSISOPL.SISOPL= Lschet.SiSopl');
    PrepareSQLQuery('left outer join CATALOGS CATEDUCATION on CATEDUCATION.Nrec= Persons.EDUCATION');

    PrepareSQLQuery('where ');
    PrepareSQLQuery( _Table+'.YearN>='+string(wYearBeg)+' and '+_Table+'.YearN<='+string(wYearEnd) );
    PrepareSQLQuery(' and ('+_Table+'.YearN<'+string(wYearEnd) +' or '+_Table+'.MesN<='+string(wMonthEnd)+')');
    PrepareSQLQuery(' and ('+_Table+'.YearN>'+string(wYearBeg) +' or '+_Table+'.MesN>='+string(wMonthBeg)+')');
    if IsBitCTW(wGP_Options,2)
    { Add_Fields_PERECH(_Table,L,1);
    }
    stmt:=0;
    stmt := sqlAllocStmt;
    wErr:=ExecDSQLex(tntmp_Perech_gp);

  } //For(l:=1;l<=3;l++)
     PushBounds(tbbytmp_Perech_gpVidopl);
     PushBounds(tbbytmp_Perech_gpS);

    StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak, 'Обработка налогов за ' +
     datetostr(dBegin,'month')  , recordsintable(#tmp_Perech_gp)/Matrix_Row1);
    timelog('Отобрали '+string(RecordsInTable(#tmp_nach_gp)));
    _loop tmp_Perech_gp
    {
              if ( j = Matrix_Row1 )
              { if not NextVisual
                { isAllOk:=False;
                  break;
                }

                if ( wNewPage = 1 )
                {
                  if (i > 65436 and word(sVersion) <= word(11))     // sVersion: 9  - Excel 2000; 10 - Excel 2002;
                    or (i > 1048476 and word(sVersion) >= word(12)) // 11 - Excel 2003; 12 - Excel 2007; 14 - Excel 2010
                  {
                    FormNewPageData();
                    i := Matrix_Row2;
                  }
                }
                xlWriteMatrixToExcel((i - Matrix_Row3), 1);
                j := 1;
                xlClearMatrix;
              }
              //if ( getfirst Catalogs where ((tmp_Perech_gp.Cappoint == Catalogs.NREC)) <> tsOk )
              //{Catalogs.Name := '';};
              #FulFilMatrix(tmp_Perech_gp);
              xlDoWriteToMatrix(j, 2, tmp_Perech_gp.SUMPER);
              inc(j);
              inc(i);
  }//_loop tmp_Perech_gp
  PushBounds(tnKlVidopl1);
  PushBounds(tnPerech);
  xlWriteMatrixToExcel((i + 1) - j, 1);
  xlClearMatrix;
  StopVisual('',0) ;
  Result:=isAllOk;
} //PerechOpLoop_DSQL

//------------------------------------------------------------------------------------------------------------
// Обработка налогов на ФОТ
//------------------------------------------------------------------------------------------------------------
function PerevodLoop: boolean;
{ if IsBitCtW(wGP_Options,1)
    Result:=PerevodLoop_DSQL
  else
    Result:=Inherited::PerevodLoop;
}

//================================
// включение / отключение закладок
//================================
Procedure MySetTabbedSheetVisible(ww_format:longint;ww_Visible:boolean; ww_comment:string='');
{
    if ww_Visible
    {  if not GetTabbedSheetVisible(ww_format)
       {  SetTabbedSheetVisible(ww_format, True);
       }
    }
    else
    {  if GetTabbedSheetVisible(ww_format)
       { SetTabbedSheetVisible(ww_format, false);
       }
    }
} //Procedure MySetTabbedSheetVisible(ww_format:longint;ww_Visible:boolean);



//****************************************************************8
ExtendFormats  Analisys;
screen Analisys 'Основные параметры';
  table ZAR_USER;
  fields
    wGP_Options:NoProtect;
  <<














   `Опции` [.] Использовать DSQL`
           [.] Группировать данные по заданным строкам/столбцам`


  >>
  end; // screen Analisys
//****************************************************************8


HandleEvent
  cmInit:
  { Timelog_Init;
    if not ReadMyDsk(wGP_Options,'STRZAR_wGP_Options',false) wGP_Options:=0;
    MySetTabbedSheetVisible(ANALISYS3,not boGetTune('NPOEM_OWN.ZP.Rep.STRZAR_Macros'),'ANALISYS3');
    if  inherited :: handleEvent (cmInit)=heAbort then Abort;

  }
  //--- берем целиком
  cmSaveLoadNastr:
  {
    var NrecNastr,Choice : comp;
    var VidNastr : word;
    Choice := 0;
    if RunInterface(StrZarNastr, NrecNastr, Choice) = cmOk
    {
      ReadMyDsk(VidNastr,'VidNastr_NastrRep',false);
      var counterRec, countRow, countCol, countFlt : word;
      counterRec := 0;
      countRow   := 0;
      CountCol   := 0;
      CountFlt   := 0;

      case VidNastr of
      0: // сброс настроек
      {
        SetTitle('Структура заработной платы');
        LoadParameters;
        ClearMarker(NachMarkers);
        ClearMarker(GrMarkers);
        ClearMarker(UderMarkers);
        ClearMarker(PerechMarkers);
        ierDepth := 0;
        kauDepth := 0;
        LoadGroupingData();
        wAddInfo := 0;
        wNotPr   := 0;
        SetFieldVisible(#FiltrUder,(wAddInfo and 4) > 0);
        SetFieldVisible(#FiltrFot,(wAddInfo and 2) > 0);
        set UserColumns  := 'Нет пользовательских колонок в отчете';
        delete all tmpNastr where (( 'П' == tmpNastr.typeCol ));
        delete all tmpNastr where (( 'ПП' == tmpNastr.typeCol ));
        delete all tmpUserNastr;
      }
      1,2: // сохранение настроек
      {
        if getfirst NastrRep where ((NrecNastr == NastrRep.Nrec)) = tsOk
        {
          SetTitle('Структура заработной платы. Отчет ' + NastrRep.NameNastr);
          NastrRep.CheckNr1 := wMonthBeg;
          NastrRep.CheckNr2 := wMonthEnd ;
          NastrRep.CheckNr3 := wYearBeg;
          NastrRep.NastrW1  := wYearEnd;
          NastrRep.NastrW2  := wAddInfo;
          NastrRep.Ierarh   := ierDepth;
          NastrRep.KAU := kauDepth;
          NastrRep.Path := Spath;
          NastrRep.Nastr1 := comp(ourClassCode);
#IFDEF _GP_
          NastrRep.NASTRSTR3:=string(wGP_Options)+';' // Исп.DSQL
            ;
#ENDIF
          _loop tmpNastr where (( 'C' == tmpNastr.typeCol )) ordered by tmpNastr.Name
          {
            inc(counterRec);
            if tmpNastr.NumberRow > 0
            {
              inc(countRow);
              NastrRep.NumberRow[counterRec] := tmpNastr.NumberRow;
            }
            else
            {
              NastrRep.NumberRow[counterRec] := 0;
            }
            if tmpNastr.NumberCol > 0
            {
              inc(countCol);
              NastrRep.NumberCol[counterRec] := tmpNastr.NumberCol;
            }
            else
            {
              NastrRep.NumberCol[counterRec] := 0;
            }
            if tmpNastr.NumberFlt > 0
            {
              inc(countFlt);
              NastrRep.NumberFlt[counterRec] := tmpNastr.NumberFlt;
            }
            else
            {
              NastrRep.NumberFlt[counterRec] := 0;
            }
          }
          update current NastrRep;
          delete all NastrRep where ((NrecNastr == NastrRep.Nastr1));
            _loop tmpNastr where (( 'П' == tmpNastr.typeCol ))
            {
              ClearBuffer(#NastrRep);
              NastrRep.Nastr1       := NrecNastr;
              NastrRep.Choice       := 1;
              NastrRep.NameNastr    := tmpNastr.name;
              NastrRep.Path         := tmpNastr.NameAlg;
              NastrRep.NumberRow[1] := tmpNastr.NumberRow;
              NastrRep.NumberCol[1] := tmpNastr.NumberCol;
              NastrRep.NumberFlt[1] := tmpNastr.NumberFlt;
              NastrRep.NastrW1 := 0;
              insert current NastrRep;
            }
            _loop tmpNastr where (( 'ПП' == tmpNastr.typeCol ))
            {
              ClearBuffer(#NastrRep);
              NastrRep.Nastr1       := NrecNastr;
              NastrRep.Choice       := 1;
              NastrRep.NameNastr    := tmpNastr.name;
              NastrRep.Path         := tmpNastr.NameAlg;
              NastrRep.NumberRow[1] := tmpNastr.NumberRow;
              NastrRep.NumberCol[1] := tmpNastr.NumberCol;
              NastrRep.NumberFlt[1] := tmpNastr.NumberFlt;
              NastrRep.NastrW1      := 1;
              insert current NastrRep;
            }
#IFDEF _GP_
            //Виды оплат -------------
            var ii:longint;
            var vid: longInt;
            var _nrec:comp;
            For(ii:=0; ii<GetMarkerCount(NachMarkers); ii++ )
            { GetMarker(NachMarkers, ii, vid);
              ClearBuffer(#NastrRep);
              NastrRep.Nastr1       := NrecNastr;
              NastrRep.Choice       := 2;
              NastrRep.NameNastr    := string(vid);
              NastrRep.Path         := '';
              NastrRep.NumberRow[1] := vid;
              NastrRep.NastrW1      := 2;
              insert current NastrRep;

            } //For(ii:=0; ii<GetMarkerCount(NachMarkers); ii++ )
            // подразделения
            _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;
            for(ii:= 0; ii< GetMarkerCount(_PodrMArkerPointer); ii:= ii+ 1)
            { GetMarker(_PodrMArkerPointer, ii, _nrec);
              ClearBuffer(#NastrRep);
              NastrRep.Nastr1       := NrecNastr;
              NastrRep.Choice       := 3;
              NastrRep.NameNastr    := string(_nrec);
              NastrRep.Path         := '';
              NastrRep.NumberRow[1] := vid;
              NastrRep.NastrW1      := 2;
              insert current NastrRep;
            }
            DoneMarker(_PodrMArkerPointer, '');

#ENDIF
        }
      }
      3: // загрузка настроек
      {
        if getfirst NastrRep where ((NrecNastr == NastrRep.Nrec)) = tsOk
        {
          SetTitle('Структура заработной платы. Отчет ' + NastrRep.NameNastr);
          wMonthBeg := NastrRep.CheckNr1;
          wMonthEnd := NastrRep.CheckNr2;
          wYearBeg  := NastrRep.CheckNr3;
          wYearEnd  := NastrRep.NastrW1;
          wAddInfo  := NastrRep.NastrW2;
          SetFieldVisible(#FiltrUder,(wAddInfo and 4) > 0);
          SetFieldVisible(#FiltrFot,(wAddInfo and 2) > 0);
          ierDepth  := NastrRep.Ierarh;
          kauDepth  := NastrRep.KAU;
#IFDEF _GP_
          wGP_Options:=ParseWord(NastrRep.NASTRSTR3,1,';');
#ENDIF

          LoadGroupingData();
          Spath := NastrRep.Path;
          ourClassCode := word(NastrRep.Nastr1);

          _loop tmpNastr where (( 'C' == tmpNastr.typeCol )) ordered by tmpNastr.Name
          {
            inc(counterRec);
            tmpNastr.NumberRow := NastrRep.NumberRow[counterRec];
            tmpNastr.NumberCol := NastrRep.NumberCol[counterRec];
            tmpNastr.NumberFlt := NastrRep.NumberFlt[counterRec];

            update current tmpnastr;
          }

          delete all tmpNastr where (( 'П' == tmpNastr.typeCol ));
          delete all tmpNastr where (( 'ПП' == tmpNastr.typeCol ));
          delete all tmpUserNastr;
#IFDEF _GP_
          ClearMarker(NachMarkers);
          var vid: longInt;
          // фильтр по видам оплат
          _loop NastrRep where ((NrecNastr == NastrRep.Nastr1 and 2 == NastrRep.Choice(noindex)))
          { vid:=NastrRep.NumberRow[1];
            InsertMarker(NachMarkers,vid);
          }
          _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;
          ClearMarker(_PodrMArkerPointer);
          _loop NastrRep where ((NrecNastr == NastrRep.Nastr1 and 3 == NastrRep.Choice(noindex)))
          { InsertMarker(_PodrMArkerPointer,comp(NastrRep.NameNastr));
          }
          CLSF.ReScanIfNecessary(_PodrMArkerPointer);
          DoneMarker(_PodrMArkerPointer, '');
#ENDIF

          _loop NastrRep where ((NrecNastr == NastrRep.Nastr1 and 1 == NastrRep.Choice(noindex)))
          {
            clearbuffer(#tmpNastr);
            tmpNastr.name      := NastrRep.NameNastr;
            tmpNastr.NameAlg   := NastrRep.Path;
            if NastrRep.NastrW1 = 0
            {
              tmpNastr.typeCol   := 'П';
              // в группировках восстанавливаются только колонки без параметров
              tmpNastr.NumberRow := NastrRep.NumberRow[1];
              tmpNastr.NumberCol := NastrRep.NumberCol[1];
              tmpNastr.NumberFlt := NastrRep.NumberFlt[1];
            }
            else
            {
              // загрузим пользовательские колонки с параметром
              tmpNastr.typeCol   := 'ПП';
              var UserInterface : IZarNachislUderParam;
              var InterfaceName : string;
              var P:integer;
              InterfaceName := tmpNastr.NameAlg;
              if InterfaceName = ''
                continue;
              if tmpNastr.NumberAlg = 0
                tmpNastr.NumberAlg := count(ArrAlgP) + 1;
              P := Pos('::', InterfaceName);
              if LoadVipRef(ArrAlgP[tmpUserNastr.NumberAlg],
                   SubStr(InterfaceName, 1, byte(if(P > 0, P + 1, 0))) + 'ZarNachislUderParam_' +
                   SubStr(InterfaceName, byte(if(P > 0, P + 2, 1)), 255))
              {}
            }
            insert current tmpNastr;

            clearbuffer(#tmpUserNastr);
            tmpUserNastr.NameAlg := NastrRep.Path;
            tmpUserNastr.Name    := NastrRep.NameNastr;
            tmpUserNastr.NumberAlg := tmpNastr.NumberAlg;
            if NastrRep.NastrW1 = 0
            {
              tmpUserNastr.ParamStr := '<не поддерживаются>';
              tmpUserNastr.NeedParams := 0;
            }
            else
            {
              tmpUserNastr.ParamStr := '<не заданы>';
              tmpUserNastr.NeedParams := 1;
            }
            insert current tmpUserNastr;
          }
          if getfirst tmpUserNastr = tsOk
            set UserColumns := 'Заданы дополнительные колонки '
          else
            set UserColumns  := 'Нет пользовательских колонок в отчете';

          GroupTypeROW := '';
          GroupTypeCol := '';
          GroupTypeFlt := '';
          counterRec   := 0;
          _loop tmpNastr ordered by tmpNastr.NumberRow
          {
            inc(counterRec);
            if (tmpNastr.NumberRow > 0)
              GroupTypeROW := GroupTypeROW + if(GroupTypeROW= '', '', '/') + tmpnastr.NAME;
          }

          counterRec := 0;
          _loop tmpNastr ordered by tmpNastr.NumberCol
          {
            inc(counterRec);
            if (tmpNastr.NumberCol > 0)
              GroupTypeCol := GroupTypeCol + if(GroupTypeCol= '', '', '/') + tmpnastr.NAME;
          }

          counterRec := 0;
          _loop tmpNastr ordered by tmpNastr.NumberFlt
          {
            inc(counterRec);
            if (tmpNastr.NumberFlt > 0)
              GroupTypeFlt := GroupTypeFlt + if(GroupTypeFlt= '', '', '/') + tmpnastr.NAME;
          }

          if GroupTypeRow = ''
            GroupTypeRow:= 'Группировка не выбрана';
          if GroupTypeCol = ''
            GroupTypeCol:= 'Группировка не выбрана';
          if GroupTypeFlt = ''
            GroupTypeFlt:= 'Группировка не выбрана';
          Set GroupTypeRow := GroupTypeRow;
          Set GroupTypeCol := GroupTypeCol;
          Set GroupTypeFlt := GroupTypeFlt;
         }
      }
      end; //case
#IFDEF _GP_
      FulFillingTMP; // набивка таблицы по  групповому маркеру
#ENDIF
      ReScanPanel(tnZAR_USER);
    }
  }

cmOk:
{ timelog('STRZAR:Start');
  //MTRetrieve(#tmp_spr_gp,mfFilters + mfClear);
#IFNDEF _2018_10_19_
  vFnd.ResetBounds(vFnd.tntmp_spr_gp);
  vFnd.delete all tmp_spr_gp where (( root==tmp_spr_gp.KLUCH ));
  vFnd.SetBounds(vFnd.tntmp_spr_gp);
#endif
  pPersons:=0;
  pLschet:=0;
  SaveMyDsk(wGP_Options,'STRZAR_wGP_Options');

  if  inherited :: handleEvent (cmOk)=heAbort then Abort;
  timelog('STRZAR:Finish');
  if VisualizationActive() StopVisual('',0);
  XlKillExcel;
}

end;
end.
