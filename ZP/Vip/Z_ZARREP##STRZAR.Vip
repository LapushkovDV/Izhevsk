//------------------------------------------------------------------------------------------------------------
// Поиск названия подразделения
//------------------------------------------------------------------------------------------------------------
function KatPodrNameByIer(cREC: comp): string;
var
  i: integer;
  ierArray: array[1..10] of string;
  KodArray: array[1..10] of string;

{ vFnd._Kluch:='KatPodrNameByIer';
  vFnd._cSpr:=cRec;
  if Find_Val
  { Result:=Get_Val;
    katPodrKod:=vFnd.tmp_spr.kod;
  }
  else
  {
    Result := '';
    if ierDepth= 0
      Result := 'Все выбранные подразделения';
    else
    {
      for(i := 1; i<= 10; i := i+ 1)
      {
        ierArray[i] := '';
        KodArray[i] := '';
      }
      i := 0;
      while ( cREC <> 0 and i < 10 )
      {
        if ( GetFirst katpodr where (( cREC == katpodr.NREC )) <> tsok ) break;

        inc(i);
        ierArray[i] := katpodr.NAME;
        KodArray[i] := katpodr.KOD;
        cREC        := katpodr.CPODR;
#IFDEF _GP_
        if cREc=0 break;
#ENDIF
      }

      var curIer: integer;
      curIer := integer(i - (ierDepth - 1));

      if curIer <= 0
        curIer := 1;

      Result     := ierArray[curIer];
      katPodrKod := KodArray[curIer];
    }
    Ins_Val1(Result,katPodrKod);
#IFDEF _GP_
    if Timelog_Status>0
    { //timelog('KatPodrNameByIer:Result='+Result+',katPodrKod='+katPodrKod);
    }
#ENDIF
  }
} //function KatPodrNameByIer(cREC: comp): string;




//------------------------------------------------------------------------------------------------------------
// Набивка матрицы по начислениям
//------------------------------------------------------------------------------------------------------------
#declare FulFilMatrix(DeclValue)
  //xlStWriteToMatrix(j, 3, FindSovm_My(#DeclValue.CLSCH));//GP
  xlStWriteToMatrix(j, 3, #DeclValue.NSOVM);//GP
  xlStWriteToMatrix(j, 4, KatPodrNameByIer(#DeclValue.CEXOZ));
  xlStWriteToMatrix(j, 5, ''''+trim(katPodrKod));
  //xlStWriteToMatrix(j, 6, DirectFindKatego(#DeclValue.Kateg));
  xlStWriteToMatrix(j, 6, #DeclValue.Kateg);
  xlStWriteToMatrix(j, 7, ''''+#DeclValue.CSCHETD);
  xlStWriteToMatrix(j, 8, ''''+#DeclValue.CSUBSCHD);
  xlStWriteToMatrix(j, 9,  #Declvalue.HOZOPER_NAME);
  xlStWriteToMatrix(j, 10, FindClass);
  xlStWriteToMatrix(j, 11, #DeclValue.SEx);//FindSex_My(#DeclValue.TPERSON));//GP
  xlStWriteToMatrix(j, 12, ''''+GetStrTabn(#DeclValue.TABN,#DeclValue.StrTABN));
  xlStWriteToMatrix(j, 13, #DeclValue.Fio); //Persons.FIO);
  xlStWriteToMatrix(j, 14, string(#DeclValue.MES));
  xlStWriteToMatrix(j, 15, string(#DeclValue.YearK));
  xlStWriteToMatrix(j, 16, string(#DeclValue.MESN));
  xlStWriteToMatrix(j, 17, string(#DeclValue.YearN));

  //if ( ( wNotPr and 2 ) <> 2 )
  //  wSisOpl_ := LSchet.SisOpl;
  if (co#declValue <> coPEREVOD) and (co#declValue <> coPEREVODTEK)
  and (tn#declValue  <> tntmp_Perech_gp)
  {
    xlStWriteToMatrix(j, 18, 'Начисление');
    xlStWriteToMatrix(j, 19, fsNmOpl(KlVidOpl1.VidOpl));
    xlStWriteToMatrix(j, 1, string(klvidopl1.NVIDOPL) + ' (' + string(KlVidOpl1.VIDOPLP) + ')');
    xLStWriteToMatrix(j, 22, string(KlVidOpl1.VidOpl));
    xLStWriteToMatrix(j, 23, string(KlVidOpl1.VidOplP));

    if ( ( wNotPr and 2 ) = 2 )
      wSisOpl_ := #DeclValue.SisOpl;
  }
  else
  {
    xlStWriteToMatrix(j, 18, 'Налог на ФОТ');
    xlStWriteToMatrix(j, 1, string(PERECH.NAMEPER) + ' (' + string(PERECH.VIDPER) + ')');
    xLStWriteToMatrix(j, 22, string(PERECH.VIDPER));
    xLStWriteToMatrix(j, 23, string(PERECH.VIDPER));

    var lVid: longint=0;
    if (tn#declValue  = tntmp_Perech_gp)
    { lVid       := tmp_Perech_gp.VIDOPLS;
      sOtkuda_   := tmp_Perech_gp.Otkuda;
      cNrecNach_ := tmp_Perech_gp.cNach;

    }
    else
    if co#declValue = coPEREVOD
    {
      lVid       := PEREVOD.VIDOPLS;
      sOtkuda_   := PEREVOD.Otkuda;
      cNrecNach_ := PEREVOD.cNach;
    }
    else
    {
      lVid       := PEREVODTEK.VIDOPLS;
      sOtkuda_   := PEREVODTEK.Otkuda;
      cNrecNach_ := PEREVODTEK.cNach;
    }
    xlStWriteToMatrix(j, 19, fsNmOpl(lVid));

    if ( ( wNotPr  and 2 ) = 2 )
    {
      case sOtkuda_ of
      '1':
      {
        if ( GetFirst NeNachPer = tsOk )
          wSisOpl_ := NeNachPer.SisOpl;
      }
      '0':
      {
        if ( GetFirst NachislPer = tsOk )
          wSisOpl_ := NachislPer.SisOpl;
      }
      '2':
      {
        if ( GetFirst SumVidOpPer = tsOk )
          wSisOpl_ := SumVidOpPer.SisOpl;
      }
      end;
    }
  }

  // система оплаты
  /*if ( ( wNotPr  and 2 ) = 2 and  wSisOpl_ = 0 )
    wSisOpl_ := LSchet.SisOpl;
  if ( GetFirst KlSisOpl = tsOk )
    xlStWriteToMatrix(j, 20, string(KlSisOpl.NaSisOpl)); // система оплаты
  */
  xlStWriteToMatrix(j, 20, #DeclValue.NaSisOpl); // система оплаты
  //xLStWriteToMatrix(j, 21, string(Catalogs.Name)); //должность
  xLStWriteToMatrix(j, 21, #DeclValue.POST   ); //должность
//GP
  xLStWriteToMatrix(j, 24, #DeclValue.KOLDNGR); //Количество дн.по грф
  xLStWriteToMatrix(j, 25, #DeclValue.CHASGR ); //Часы по графику
  xLStWriteToMatrix(j, 26, #DeclValue.KOLDN  ); //Количество дней
  xLStWriteToMatrix(j, 27, #DeclValue.CHASF  ); //Количество часов
  xlStWriteToMatrix(j, 28, #DeclValue.NAIKAT ); //Наименование категории
  xlStWriteToMatrix(j, 29, ''''+trim(substr(katPodrKod,1,3))); //Код цеха
  xlStWriteToMatrix(j, 30, #DeclValue.Education); //Образование
  xlStWriteToMatrix(j, 31, #DeclValue.Age      ); //Возраст

//------------
  Kaucounter := 0;
  if KauDepth > 0
  {
    for(kaucounter := 1; kaucounter <= kauDepth; kaucounter := kaucounter + 1)
    {
      //GetAnyKau(cgAkNoDef, #DeclValue.TBLD[kaucounter], #DeclValue.CKAUD[kaucounter]);
      if #DeclValue.TBLD[kaucounter]>0
      { xlStWriteToMatrix(j, ConstFields + kaucounter, GetAnyKau_My( #DeclValue.TBLD[kaucounter], #DeclValue.CKAUD[kaucounter]));
      }
    }
  }
  // возможность подключения Vip-интерфейса
  if boUseDopColumn
  { var Colnum :integer;
    var P,k : integer;
    ColNum := 0;
    var InterfaceName: string;
    k:=0;
    _loop tmpNastr where (( 'П' == tmpNastr.typeCol ))
    {
      ColNum := ColNum + 1;

      if ( Pos('CHAS', UpCase(tmpNastr.NameAlg)) > 0 )
        xlDoWriteToMatrix(j, ConstFields + kauDepth + ColNum, Double(Replace(ArrAlg[k].GetValue(#declValue.Nrec,co#DeclValue), ',', '.')) )
      else
        xlStWriteToMatrix(j, ConstFields + kauDepth + ColNum, Replace(ArrAlg[k].GetValue(#declValue.Nrec,co#DeclValue), ',', '.') );
      k:=k+1;
    }

    _loop tmpNastr where (( 'ПП' == tmpNastr.typeCol ))
    {
      if not NullVipRef(ArrAlgP[tmpNastr.numberAlg])
      {
        ColNum := ColNum + 1;
        if ( UpCase(tmpNastr.nameAlg) = 'Z_ZAR::EXTATTRLS' )
          ArrAlgP[tmpNastr.numberAlg].SetParameter(0,0,tmpNastr.paramAlg);

        xlStWriteToMatrix(j, ConstFields + kauDepth + ColNum, Replace(ArrAlgP[tmpNastr.numberAlg].GetValue(#declValue.Nrec,co#DeclValue), ',', '.') );
      }
    }
  }

  xlSetCellStringValue( lCol,1 ,123,1 ,123);
#end
