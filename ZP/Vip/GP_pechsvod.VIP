                      pXL.SetTblStringFldValue('Код_КПП', GetCodeKPP(CexozGlub));
                      pXL.SetTblStringFldValue('Код_ОКАТО', GetCodeOKATO(CexozGlub,tmp_VedGroup.pComp4));
                    }
