        {
          TekCexRec := tmp_VedGroup.cRec2;

          while (GroupFlag = tsOK) and (Category = GetTbl(tmp_VedGroup.cRec1,4))
                and (Sex = GetTbl(tmp_VedGroup.cRec1,3))and (TekGrPodr = tmp_VedGroup.cRec6)and (TekCexRec = tmp_VedGroup.cRec2) do
          {
            if ( ( TekCexRec = 0 ) ) or ( TekCexRec <> 0 )
            {
              for(i := 1; i <= 8; i++)
              {
                sumtab[i] := 0; sumopl[i] := 0;
                sumtek[i] := 0; res[i]    := 0;
                sumlow[i] := 0; sumrec[i] := 0;
              }

              if ( TekCexRec = 0 ) then
                KatPodrC.Name := ''
              else
                TSFlag1 := getfirst KatPodrC;

              if ( TekCexRec = 0 ) then
                TSFlag1 := tsOk;

              if ( TSFlag1 = tsok )
              {
                Nomp := 1;

                if (GroupFlag = tsOK) and (Category = GetTbl(tmp_VedGroup.cRec1,4))
                   and (Sex = GetTbl(tmp_VedGroup.cRec1,3))and (TekGrPodr = tmp_VedGroup.cRec6)and (TekCexRec = tmp_VedGroup.cRec2)
                {
                  if ( oParamSvod.prFormType = 0 )
                  {
                    OutA.PutEventById(feTrue,fcTekVednu);
                    OutA.Write(KatPodrC.Name)
                  }
                  else
                  {
                    pXL.ClearTblBuffer;

                    if ( oParamSvod.prUderType < 5 )
