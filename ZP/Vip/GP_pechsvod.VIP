      }
      else
      {
        pXL.ClearTblBuffer;
        pXL.SetTblStringFldValue('Ном_пп', 'Категория: ' + getKateg );
        pXL.InsTblRow;
      }
    }

    for (i := 1; i <= 8; i++)
      QSummaPodr[i] := 0;

    while (GroupFlag = tsOK) and (Category = GetTbl(tmp_VedGroup.cRec1,4)) do
    {
