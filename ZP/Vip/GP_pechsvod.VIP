         tmp_VedGroup.PSTRING2(length=30), tmp_VedGroup.CREC3,tmp_VedGroup.PSTRING3, tmp_VedGroup.CREC4, tmp_VedGroup.CREC5;

  while (GroupFlag = tsOK)  do
  {
