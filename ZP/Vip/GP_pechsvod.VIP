                      pXL.SetTblStringFldValue('Уровень', '6');
                      pXL.SetTblStringFldValue('Ном_пп', 'Итого:');
                      pXL.SetTblStringFldValue('ФИО1', CurrFio);
                      pXL.SetTblStringFldValue('Должность', CurPost);

                      for (i:= 1; i <= 8; i++)
                        pXL.SetTblNumberFldValue('Сумма_удерж'+ i, sumtab[i]);

                      pXL.InsTblRow;
                    }

                    if (GroupFlag = tsOK) and (Category = GetTbl(tmp_VedGroup.cRec1,1))
                       and (TekCexRec = tmp_VedGroup.cRec2) then
                      if (oParamSvod.prFormType = 0)
                        OutA.PutEventById(feTrue,fcNotLast);
                  }

                  for (i:= 1; i <= 8; i++)
                    sumtek[i] += sumtab[i];

                }// while

                if  ( oParamSvod.prUderType = 6) // с реквизитами
                {
                  CexozGlub := 0;
                  cnRecPodrOz := if(cpComp4 = comp(0), cpComp5, cpComp4);

                  if GetBoundOrganization(GetDepartmentReduction(cnRecPodrOz, oParamSvod.prVedGlub), OrganizationRef)
                    CexozGlub := GetDepartmentReduction(cnRecPodrOz,  oParamSvod.prVedGlub);
                }

                if ( oParamSvod.prFormType = 0 )
                {
                  OutA.PutEventById(feBreak,fcvedteknu);
                  OutA.Write(KatPodrC.Name);

                  if ( oParamSvod.prUderType = 6) // с реквизитами
                  {
                    OutA.Write(GetCodeGNI(CexozGlub));
                    OutA.Write(GetCodeKPP(CexozGlub));
                    OutA.Write(GetCodeOKATO(CexozGlub,tmp_VedGroup.pComp4));
                  }
                  else
                    OutA.SkipFormat(3);

                  for (i:= 1; i <= 5; i++)
                    OutA.write(sumtek[i], 2);  // {сумма по цеху}
                }
                else
                {
                  pXL.ClearTblBuffer;
                  pXL.SetTblStringFldValue('Уровень', '7');

                  if ( oParamSvod.prUderType > 4 )
                  {
                    pXL.SetTblStringFldValue('Ном_пп', KatPodrC.Name);

                    if ( oParamSvod.prUderType = 6) // с реквизитами
                    {
