                              OutA.SkipFormat(1);

                          if ( oParamSvod.prFormType = 0 )
                          {
                            OutA.write(QVidOpl);
                            OutA.write(tmp_VedGroup.pDouble1, 2);
                            OutA.write(tmp_VedGroup.pDouble2, 2);
                            OutA.write(tmp_VedGroup.pDouble3, 2);
                            OutA.write(tmp_VedGroup.pDouble9, 2);
                            OutA.write(tmp_VedGroup.pDouble4, 2);
                            OutA.write(tmp_VedGroup.pDouble5, 2);
                          }
                          else
                          {
                            if ( oParamSvod.prUderType < 5 )
                            {
                              pXL.SetTblStringFldValue('Код_удерж1',QVidOpl);
                              pXL.SetTblNumberFldValue('Сумма_удерж1', tmp_VedGroup.pDouble1);
                              pXL.SetTblNumberFldValue('Сумма_удерж2', tmp_VedGroup.pDouble2);
                              pXL.SetTblNumberFldValue('Сумма_удерж3', tmp_VedGroup.pDouble3);
                              pXL.SetTblNumberFldValue('Процент', tmp_VedGroup.pDouble9);
                              pXL.SetTblNumberFldValue('Сумма_удерж4', tmp_VedGroup.pDouble4);
                              pXL.SetTblNumberFldValue('Сумма_удерж5', tmp_VedGroup.pDouble5);
                              pXL.SetTblNumberFldValue('Сумма_удерж6', tmp_VedGroup.pDouble6);
                              pXL.SetTblNumberFldValue('Сумма_удерж7', tmp_VedGroup.pDouble7);
                              pXL.SetTblNumberFldValue('Сумма_удерж8', tmp_VedGroup.pDouble8);

                              pXL.InsTblRow;
                            }
                          }

                          Nomp := Nomp + 1;
                      }

                      sumopl[1] += round(tmp_VedGroup.pDouble1, 2);
                      sumopl[2] += round(tmp_VedGroup.pDouble2, 2);
                      sumopl[3] += round(tmp_VedGroup.pDouble3, 2);
                      sumopl[4] += round(tmp_VedGroup.pDouble4, 2);
                      sumopl[5] += round(tmp_VedGroup.pDouble5, 2);
                      sumopl[6] += round(tmp_VedGroup.pDouble6, 2);
                      sumopl[7] += round(tmp_VedGroup.pDouble7, 2);
                      sumopl[8] += round(tmp_VedGroup.pDouble8, 2);
                      nextvisual;

                      if  oParamSvod.prSort = 0
                        GroupFlag := getnext tmp_VedGroup ordered  by tmp_VedGroup.cRec1, tmp_VedGroup.CREC6, tmp_VedGroup.CREC2, tmp_VedGroup.CREC3, tmp_VedGroup.PSTRING3, tmp_VedGroup.CREC4, tmp_VedGroup.CREC5;
                      else
                        GroupFlag := getnext tmp_VedGroup ordered  by tmp_VedGroup.cRec1, tmp_VedGroup.CREC6,
                                     tmp_VedGroup.CREC2, tmp_VedGroup.PSTRING2(length=30), tmp_VedGroup.CREC3, tmp_VedGroup.PSTRING3, tmp_VedGroup.CREC4, tmp_VedGroup.CREC5;
                    }

                    if ( ( oParamSvod.prUderType <> 3 ) and ( oParamSvod.prUderType <> 4 ) ) and ( ( oParamSvod.prUderType <> 1 ) and ( oParamSvod.prUderType < 5 ) )
                    {
                      if (oParamSvod.prFormType = 0)
                      {
                        for (i:= 1; i <= 5; i++)
                        {
                          if i = 4
                            OutA.SkipFormat(1);

                          OutA.write(sumopl[i], 2);
                        }
                      }
                      else
                      {
                        for (i:= 1; i <= 8; i++)
                          pXL.SetTblNumberFldValue('Сумма_удерж'+ i, sumopl[i]);

                        pXL.InsTblRow;
                      }

                        if ( oParamSvod.prUderType <> 1 ) and ( oParamSvod.prUderType < 5 ) then
                          Nomp := Nomp + 1;
                    }

                    for (i := 1; i <= 8; i++)
                      sumtab[i] += sumopl[i];
                  }

                  if ( oParamSvod.prUderType = 3 ) or ( oParamSvod.prUderType = 4 ) then
                  {
                    if (oParamSvod.prFormType = 0)
                    {
                      for (i:= 1; i <= 5; i++)
                      {
                        if i=4
                          OutA.SkipFormat(1);

                        OutA.write(sumtab[i], 2);
                      }
                    }
                    else
                    {
                      for (i:= 1; i <= 8; i++)
                        pXL.SetTblNumberFldValue('Сумма_удерж' + i, sumtab[i]);

                      pXL.InsTblRow;
                    }

                    Nomp := Nomp + 1;
                  }

