                        pXL.SetTblStringFldValue('ФИО1', CurrFio);
                        pXL.SetTblStringFldValue('Должность', CurPost );
                        pXL.SetTblStringFldValue('Период', getPeriodVip );
                      }

                      if ( (oParamSvod.prInOtch and 1) = 1 )
                      {
                        if (trim(CurPost) <> '' )
                        {
                          if (oParamSvod.prFormType = 0)
                          {
                            if ( oParamSvod.prVedSvod = 0 ) and ( ( oParamSvod.prUderType<>3 ) or ( oParamSvod.prUderType<>4 ) or ( oParamSvod.prUderType<5 ) )
                              OutA.write(CurPost);
                            else
                              OutA.write('('+CurPost+')');
                          }
                        }
                        else
                          if ( oParamSvod.prFormType = 0 )
                            OutA.SkipFormat(1);
                      }
                      else
                        if ( oParamSvod.prFormType = 0 )
                          OutA.SkipFormat(1);

                      if ( oParamSvod.prFormType = 0 )
                        OutA.SkipFormat(1);
                    }

                    while (GroupFlag = tsOK) and (Category = GetTbl(tmp_VedGroup.cRec1,4))
                           and (Sex = GetTbl(tmp_VedGroup.cRec1,3))and (TekGrPodr = tmp_VedGroup.cRec6)and (TekCexRec = tmp_VedGroup.cRec2)
                           and (QcLsch = tmp_VedGroup.pComp1) do
                    {
                      QVidOpl   := tmp_VedGroup.cRec4;
                      QVidOplMy := tmp_VedGroup.cRec5;

                      for (i:= 1; i <= 8; i++)
                        sumopl[i] := 0;

                      if ( oParamSvod.prUderType = 0 ) or ( oParamSvod.prUderType = 2 )
                      {
                        if ( oParamSvod.prFormType = 0 )
                          OutA.write(Nomp);
                        else
                        {
                          pXL.SetTblStringFldValue('Уровень', '5');
                          pXL.SetTblStringFldValue('Ном_пп', String(Nomp));
                        }

                        if ( oParamSvod.prFormType = 0 )
                        {
                          OutA.write(tmp_VedGroup.pString3);
                          OutA.write(CurrFio);
                          OutA.write(tmp_VedGroup.wMesVip);
                          OutA.write(tmp_VedGroup.wMesV);
                          OutA.write(tmp_VedGroup.wMesZ);
                          OutA.write(tmp_VedGroup.wYearV);
                          OutA.write(tmp_VedGroup.wYearZ);
                        }
                        else
                        {
                          pXL.SetTblStringFldValue('Код_подр', sKodePodr); // GP 812
                          pXL.SetTblStringFldValue('Таб_номер', ''''+tmp_VedGroup.pString3);
                          pXL.SetTblStringFldValue('ФИО1', CurrFio);
                          pXL.SetTblStringFldValue('Должность', CurPost );
                          pXL.SetTblStringFldValue('Период', getPeriodVip );
                        }

                        if ((oParamSvod.prInOtch and 1) = 1)
                        {
                          if (trim(CurPost) <> '' )
                          {
                            if ( oParamSvod.prFormType = 0 )
                            {
                              if ( oParamSvod.prVedSvod = 0)and((oParamSvod.prUderType<>3)or(oParamSvod.prUderType<>4)or(oParamSvod.prUderType<5))
                                OutA.write(CurPost);
                              else
                                OutA.write('('+CurPost+')');
                            }
                          }
                          else if (oParamSvod.prFormType = 0) OutA.SkipFormat(1);
                        }
                        else
                          if ( oParamSvod.prFormType = 0 )
                            OutA.SkipFormat(1);

                          if ( oParamSvod.prFormType = 0 )
                            OutA.write(QVidOpl);
                          else
                            pXL.SetTblStringFldValue('Код_удерж1', QVidOpl);
                      }

                      while ( GroupFlag = tsOK ) and ( Category = GetTbl(tmp_VedGroup.cRec1,4) )
                            and ( Sex = GetTbl(tmp_VedGroup.cRec1,3) ) and ( TekGrPodr = tmp_VedGroup.cRec6 ) and ( TekCexRec = tmp_VedGroup.cRec2 )
                            and ( QcLsch = tmp_VedGroup.pComp1 ) and ( QVidOpl = tmp_VedGroup.cRec4 )and
                                ( QVidOplMy = tmp_VedGroup.cRec5 ) do
                      {
                        if ( oParamSvod.prUderType = 1 ) or ( oParamSvod.prUderType > 4 ) then
                        {
                          if (oParamSvod.prFormType = 0)
                            OutA.write(Nomp);
                          else
