                    }
                  }

                  while (GroupFlag = tsOK) and (Category = GetTbl(tmp_VedGroup.cRec1,4))
                        and (Sex = GetTbl(tmp_VedGroup.cRec1,3))and (TekGrPodr = tmp_VedGroup.cRec6)and (TekCexRec = tmp_VedGroup.cRec2) do
                  {
                    QcLsch  := tmp_VedGroup.pComp1;
                    cpComp4 := tmp_VedGroup.pComp4;
                    cpComp5 := tmp_VedGroup.pComp5;

                    var iPF: PersonsFunctions;

                    CurrFio := if(tmp_VedGroup.PSTRING2='','<отсутствует>', iPF.GetStrFIO_ZAR(tmp_VedGroup.PSTRING2));
                    CurPost := iCatFunc.GetCatalogsName(tmp_VedGroup.pComp3);

                    for (i := 1; i <= 8; i++)
                      sumtab[i] := 0;

                    if ( oParamSvod.prUderType = 3 ) or ( oParamSvod.prUderType = 4 ) then
                    {
