                  pXL.SetTblStringFldValue('Уровень', '8');
                  pXL.SetTblStringFldValue('Ном_пп', 'Итого:');
                  pXL.SetTblStringFldValue('ФИО1', KatPodrC.Name);

                  for (i:= 1; i <= 8; i++)
                    pXL.SetTblNumberFldValue('Сумма_удерж'+ i, sumtek[i] + sumlow[i]);   // {сумма по цеху}

                  pXL.InsTblRow;
                }
              }
            }

            for (i := 1; i <= 8; i++)
              res[i] := sumtek[i] + sumlow[i];

            var flagvalid: boolean;

            recpar := TekCexRec;
            flagvalid := (getfirst Zkauved = tsOk);

            if not flagvalid then
            {
              ClearBuffer(#Zkauved);
              Zkauved.cRec1 := TekCexRec;
            }

            Zkauved.pDouble1 += res[1];
            Zkauved.pDouble2 += res[2];
            Zkauved.pDouble3 += res[3];
            Zkauved.pDouble4 += res[4];
            Zkauved.pDouble5 += res[5];
            Zkauved.pDouble6 += res[6];
            Zkauved.pDouble7 += res[7];
            Zkauved.pDouble8 += res[8];

            if flagvalid
              update current Zkauved
            else
              insert current Zkauved;

            if getfirst Zkauved = tsOk then
            {
              QSummaPodr[1]   += Zkauved.pDouble1;
              QSummaPodr[2]   += Zkauved.pDouble2;
              QSummaPodr[3]   += Zkauved.pDouble3;
              QSummaPodr[4]   += Zkauved.pDouble4;
              QSummaPodr[5]   += Zkauved.pDouble5;
              QSummaPodr[6]   += Zkauved.pDouble6;
              QSummaPodr[7]   += Zkauved.pDouble7;
              QSummaPodr[8]   += Zkauved.pDouble8;

              QSummaSex[1]    += Zkauved.pDouble1;
              QSummaSex[2]    += Zkauved.pDouble2;
              QSummaSex[3]    += Zkauved.pDouble3;
              QSummaSex[4]    += Zkauved.pDouble4;
              QSummaSex[5]    += Zkauved.pDouble5;
              QSummaSex[6]    += Zkauved.pDouble6;
              QSummaSex[7]    += Zkauved.pDouble7;
              QSummaSex[8]    += Zkauved.pDouble8;

              QSummaGrPodr[1] +=  Zkauved.pDouble1;
              QSummaGrPodr[2] +=  Zkauved.pDouble2;
              QSummaGrPodr[3] +=  Zkauved.pDouble3;
              QSummaGrPodr[4] +=  Zkauved.pDouble4;
              QSummaGrPodr[5] +=  Zkauved.pDouble5;
              QSummaGrPodr[6] +=  Zkauved.pDouble6;
              QSummaGrPodr[7] +=  Zkauved.pDouble7;
              QSummaGrPodr[8] +=  Zkauved.pDouble8;
            }
          }

          if (oParamSvod.prFormType = 0)
            OutA.PutEventById(feBreak,fcvedmainnu);

          TekCex :=  oParamSvod.proCex;

          delete all Zkauved;
        }
      }

      if ( oParamSvod.prUderType > 4 )
      {
        if ( oParamSvod.prFormType = 0 )
        {
          OutA.PutEventByID(feTrue, fcVEDNU_GrPodrITOG);
          OutA.Write(prNameGrPodr);

          for (i:= 1; i <= 5; i++)
            OutA.write(QSummaGrPodr[i], 2);
        }
        else
        {
          pXL.ClearTblBuffer;
          pXL.SetTblStringFldValue('Уровень', '9');
          pXL.SetTblStringFldValue('Ном_пп', 'Итого:');
          pXL.SetTblStringFldValue('ФИО1', prNameGrPodr);

          for (i:= 1; i <= 8; i++)
            pXL.SetTblNumberFldValue('Сумма_удерж'+ i, QSummaGrPodr[i]);

          pXL.InsTblRow;
        }
      }
    }

    if (oParamSvod.prFormType = 0)
      OutA.PutEventById(feBreak,fcVedNuGrPodr);

    if (GroupBySex)
    {
      if (oParamSvod.prFormType = 0)
      {
        OutA.PutEventByID(feTrue, fcVEDNU_SexITOG);
        OutA.Write( sGetSex(Sex, 1) );

        for (i := 1; i <= 5; i++)
          OutA.write(QSummaSex[i], 2);
      }
      else
      {
        pXL.ClearTblBuffer;
        pXL.SetTblStringFldValue('Уровень', '10');
        pXL.SetTblStringFldValue('Ном_пп', 'Итого по:');
        pXL.SetTblStringFldValue('ФИО1', sGetSex(Sex, 1) );

        for (i:= 1; i <= 8; i++)
          pXL.SetTblNumberFldValue('Сумма_удерж'+ i, QSummaSex[i]);

        pXL.InsTblRow;

      }
    }
  }

  if ( oParamSvod.prFormType = 0 )
    OutA.PutEventById(feBreak, fcVEDNU_Sex);

  for (i:= 1; i <= 8; i++)
    QSummaAll[i] += QSummaPodr[i];

  if ( GroupByCategory )
  {
    if ( oParamSvod.prFormType = 0 )
    {
      OutA.PutEventByID(feTrue, fcVEDNU_CATEGITOG);
      OutA.Write('категории "' + getKateg + '"');

        for (i:= 1; i <= 5; i++)
          OutA.write(QSummaPodr[i], 2);
      }
      else
      {
        pXL.ClearTblBuffer;
        pXL.SetTblStringFldValue('Уровень', '11');
        pXL.SetTblStringFldValue('Ном_пп', 'Итого по:');
        pXL.SetTblStringFldValue('ФИО1', 'категории "' + getKateg +'"');

        for (i:= 1; i <= 8; i++)
          pXL.SetTblNumberFldValue('Сумма_удерж'+ i, QSummaPodr[i]);

        pXL.InsTblRow;
      }
    }
  }

  if ( oParamSvod.prFormType = 0 )
  {
    OutA.PutEventById(feBreak, fcVEDNU_CATEGORY);

    prName := CLSF.GetDepartmentFilterStr;
    OutA.write(prname);

    for (i:= 1; i <= 5; i++)
      OutA.write(QSummaAll[i], 2);

    StopVisual('',0);

    if ( not OutA.error )
      OutA.showFile('')
    else
      OutA.abortForm;
  }
  else
  {
    pXL.ClearTblBuffer;
    pXL.SetTblStringFldValue('Уровень', '12');
    pXL.SetTblStringFldValue('Ном_пп', 'Итого по:');
    pXL.SetTblStringFldValue('ФИО1', CLSF.GetDepartmentFilterStr);

    for (i := 1; i <= 8; i++)
      pXL.SetTblNumberFldValue('Сумма_удерж'+ i, QSummaAll[i]);

    pXL.InsTblRow;

    StopVisual('',0);

    pXL.PublishTbl('VedSvod1'); // 'VedSvod1'
    pXL.LoadReport(sXLSFileName);
    pXL.DisConnectExcel;
  }
  Abort;
}  // cmInit
end; //HandleEvent
end.   //interface
