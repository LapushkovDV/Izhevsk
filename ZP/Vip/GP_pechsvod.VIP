/*************************************************************************************************\
* Наименование:  Печать свода начислений "Вспомогательные ведомости"                              *
*                Дополнительные поля                                                              *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    Отчеты - Сводные аналитические отчеты -                                          *
*                Вспомогательные ведомости - Свод по видам начислений/удержаний                   *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#812          |22/04/18|Потапов А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
// Перекрываем стандартный интерфейс т.к. корректно вклинится докомпиляцией или точкой расширения 
// не представляется возможным из-за структуры интерфейса
// Стандартный код не меняется
// Все дополнения выделены комментарием // GP 812
// При обновлении - просто перенести в обновленный исходник куски кода с // GP 812
#include CLSFuncs.vih
#include PAFILTER.vih                    // работа с фильтрами по сотрудникам и подразделениям
#include TotalOrganizationAttributes.vih // работа с атрибутами организации
#include OrganizationInfo.vih            // Объявления объектных интерфейсов для выборки информации об организации
#include xlReport.vih
#include AdrFunc.vih                     // Функции работы с адресами
#include PsnFuncs.vih
#include Contexts.vih
#include CatFunc.vih                     // Функции работы с CATALOGS
#include vedsvod.vih

#component "Z_ZarRep"

#doc
Печать свода начислений "Вспомогательные ведомости"
#end
interface pechsvod 'Свод начислений' DoAccept, EscClose;

table struct tmp_VedGroup
(
  CREC1     : tNrec,
  CREC2     : tNrec,
  CREC3     : tNrec,
  CREC4     : tNrec,
  CREC5     : tNrec,
  CREC6     : tNrec,
  PCOMP1    : tNrec,
  PCOMP3    : tNrec,
  PCOMP4    : tNrec,
  PCOMP5    : tNrec,
  PDOUBLE1  : Double,
  PDOUBLE2  : Double,
  PDOUBLE3  : Double,
  PDOUBLE4  : Double,
  PDOUBLE5  : Double,
  PDOUBLE6  : Double,
  PDOUBLE7  : Double,
  PDOUBLE8  : Double,
  PDOUBLE9  : Double,
  wMesVip   : word,
  wMesZ     : word,
  wMesV     : word,
  wYearV    : word,
  wYearZ    : word,
  PSTRING1  : s60,
  PSTRING2  : s60,
  PSTRING3  : s60        //табельный номер
)
with index
(
  tmp_VedGroup01  =  CREC1 + CREC6 + CREC2 + CREC3 + PSTRING3 + CREC4 + CREC5,
  tmp_VedGroup02  =  CREC1 + CREC6 + CREC2 + PSTRING2(Length=30) + CREC3 + PSTRING3+
                     CREC4 + CREC5,
  tmp_VedGroup03  =  CREC4 + CREC5
);

  create view Lnachisl
    var
      oParamSvod  : oVedSvod;
      pXL       : XLSRepBuilder;  // объект формирования Excel-отчетов
      pxlrepsetup : xlrepsetup;
      QVidOpl   : longint; // Код выплат
      QVidOplMy : longint; // Код выплат
      QcLsch    : comp;
      TekCex    : comp;
      TekCexRec : comp;
      TekGrPodr : comp;
      LastCex   : comp;
      Tsflag    : word;

      prNvidopl : STRING[60]; // length(Klvidopl.nvidopl) = 60
      prName    : STRING[40];
      nomp      : word;
      prPodr    : comp;
      cPCOMP4   : comp;
      cPCOMP5   : comp;
      i         : integer;
      GroupByCategory:  boolean;
      GroupByWorker  :  boolean;
      GroupBySex     :  boolean;
      prNameGrPodr   : string;
      CurPost
     ,CurrFio   : string;
      wYear     : word;
      Category  : word;
      Sex       : word;
      GroupFlag : word;
      IsBreaked : boolean;
      recpar    : comp;
      CexozGlub, OrganizationRef: comp;
      TaxationInfo: IOrganizationTaxationInfo;
      iAdrFunc    : AddressFunc;    // Переменная типа интерфейс AddressFunc
      cnRecPodrOz : comp;
      CLSF    : CurLSFunctionsChild;
      ind     : integer;
      TSFlag1 : word;
      con     : integer;
      curcex1 : comp;
      iCatFunc  : CatalogsFunctions;     // Переменная типа интерфейс CatalogsFunctions
      My : TPtr;
      sXLSFileName
    , sXLTFileName
    , ID          : string;
  #include PAFILTER.VAR

    as select
      LSchet.nrec,
      LSchet.TabN,
      LSchet.StrTabn,
      KatPodr.Nrec,
      KatPodr.Name,
      VedGroup.*,
      tmp_VedGroup.*
    from
      VedGroup(build),
      tmp_VedGroup(build),
      ZKAUVED(build),
      KlVidopl,
      KlVidUd,
      LSchet,
      synonym lschet lschett,
      KatPodr,
      Formarks,
      KatPodr  KatPodrC,
      klvidopl klvidoplMy,
      klvidopl klvidoplM,
      KlVidUd  KlVidUdM,
      KlKatego,
      KATKOD,
      synonym KatKod KatKodGNI,
      GrPodr,
      LSchet LSPodr, // GP 812
      ExtCatLinks // GP 812
    where
    ((
      recpar          == Zkauved.Crec1     and
      Category        == KlKatego.Kod      and
      _clschet        == Formarks.Choice   and
      TekCexRec       == KatPodrC.Nrec     and
      QVidOplMy       == klvidoplMy.vidopl and
      oParamSvod.prprvidop  == klvidopl.vidopl
      // GP 812
      and tmp_VedGroup.PCOMP1 == LSPodr.nRec
      and 11 == ExtCatLinks.ObjType
      and 1 == ExtCatLinks.ModType
      and LSPodr.Cex == ExtCatLinks.ExtCat
      // GP 812
    ));
//------------------------------------------------------------------------------
  parameters oParamSvod;
//------------------------------------------------------------------------------
  form OutA('vednu.OUT','vednu') with novisual;
//------------------------------------------------------------------------------
  #include TotalOrganizationAttributes.var // объявление и инициализация TOA
//------------------------------------------------------------------------------
  var
    sumtek        : array [1..8]  of double;
    sumlow        : array [1..8]  of double;
    sumrec        : array [1..8]  of double;
    sumtab        : array [1..8]  of double;
    sumopl        : array [1..8]  of double;
    res           : array [1..8]  of double;
    QSummaGrPodr  : Array [1..8]  of double;
    QSummaSex     : Array [1..8]  of double;
    QSummaPodr    : Array [1..8]  of double;
    QSummaAll     : Array [1..8]  of double;
//------------------------------------------------------------------------------
// #include DepartmentTreeSession.vpp
// GP 812
var DepartmentTreeSession: IContextSession;

function CaptureDepartmentTreeContext: boolean;
{
  var CL: ContextList;
  Result := CL.Add(DepartmentTreeSession, 'DepartmentTree');
}

// ----- Код Подразделения
function sKodePodr: string;
{
  result:='';
  if IsValid(#LSPodr)
    if IsValid(#ExtCatLinks)
      result:=''''+SubStr(iCatFunc.GetCatalogsCode(ExtCatLinks.StaffCat), 1, 3);
}
// GP 812
// ----- Код ГНИ -------------------
function GetCodeGNI(CexozGlub: comp): string;
var    CodeGNI: string;
 nRecKPP,c_Gni: comp;
{
  CodeGNI := '';
  c_Gni   := comp(0);
  nRecKPP := comp(0);

  if (GetDepartmentKpp(CexozGlub, nRecKPP))
    if ( GetFirst KATKOD where (( nRecKPP == KATKOD.NREC )) =  tsOk )
      c_Gni    := KATKOD.CORG1;

  if (GetFirst KatKodGNI  where (( c_Gni == KatKodGNI.NREC )) = tsOk )
    CodeGNI := KatKodGNI.Kod;

  GetCodeGNI := CodeGNI;
}
// ----- Код КПП -------------------
function GetCodeKPP(CexozGlub: comp): string;
var CodeKPP: string;
    nRecKPP: comp;
{
  CodeKPP := '';
  nRecKPP := comp(0);

   if GetDepartmentKpp(CexozGlub, nRecKPP)
   {
     if GetFirst KATKOD where ((nRecKPP == KATKOD.NREC)) =  tsOk
       CodeKPP := KATKOD.Kod;
   }
   // на случай, если для организации КПП введено вручную, а не выбрано из справочника КПП
   // (для подразделения вручную КПП ввести нельзя)
   if  Trim(CodeKPP) = ''
   {
     if IOrganizationInfoFinder(TaxationInfo).Seek(OrganizationRef)
       CodeKPP := Trim(TaxationInfo.GetKppStr)   // КПП
   }

  GetCodeKPP := CodeKPP;
}

// ----- Код ОКАТО -----------------
function GetCodeOKATO(CexozGlub: comp; nRecAnalitic: comp): string;
{
  var CodeOKATO: string = '';

  nRecAnalitic:=nRecAnalitic;// Убираем предупреждения компилятора.
  GetDepartmentOkato(CexozGlub, CodeOKATO);

  result := CodeOKATO;
}
//-----------------------------------
function sGetSex(_wSex, _wParam : word) : string;
{
  Result := 'пол не указан';

  case _wSex of
  1: Result := if( _wParam = 0, 'Женщины', 'женщинам' );
  2: Result := if( _wParam = 0, 'Мужчины', 'мужчинам' );
  end;
} // sGetSex
//-----------------------------------
function getKateg : string;
{
  Result := 'без названия';

  if ( getfirst KLKATEGO = tsOk )
    Result := KLKATEGO.NAIKAT;
} // getKateg
//-----------------------------------
function getPeriodVip : string;
{
  Result := '';

  if ( oParamSvod.prLocFlag6 = 0 )
  {
    Result :=  LPadCh(string(tmp_VedGroup.wMesV), '0', 2) + '.' +
               SubStr(string(tmp_VedGroup.wYearV), 3, 2);
  }
  else
  {
    Result :=  LPadCh(string(tmp_VedGroup.wMesZ), '0', 2) + '.' +
               SubStr(string(tmp_VedGroup.wYearZ), 3, 2);
  }
} // getPeriodVip
//------------------------------------
HandleEvent
cmInit:
{
  // GP 812
  if not CaptureDepartmentTreeContext
    abort;
  // GP 812
  GroupByCategory := ((oParamSvod.prGrouping and 1) > 0);
  GroupByWorker := ((oParamSvod.prGrouping and 2) > 0);
  GroupBySex := ((oParamSvod.prGrouping and 4) > 0);

  IsBreaked := False;

  OrganizationRef := coGetTune('MyOrg');
  LoadVipRef(TaxationInfo, 'OrganizationTaxationInfo');
  // GP 812
  ID := 'GP_SvodVed';
  // GP 812
  sXLTFileName := oParamSvod.prSvodVedName;
  // GP 812
  if (trim(sXLTFileName) = '')
    sXLTFileName := TranslatePath('%ClientStartPath%XLS_ЭМ\ZP\' + ID + '.xlt');
  // GP 812
  case oParamSvod.prVedSvod of
  0:
  {
    if ( oParamSvod.prprvidop = -1 )
      PRnvidopl := 'по нескольким видам оплат'
    else
    {
      if ( GetFirst klvidopl = tsOk )
        PRnvidopl := klvidopl.Nvidopl
      else
        PRnvidopl := 'по выбранным видам начислений';
    }

    if ( ( oParamSvod.prPoCexOZ and 1 ) > 0 )
      tsFlag := RunInterface('Formnc1', oParamSvod, oParamSvod.prUderType, IsBreaked);
    else
      tsFlag := RunInterface('Formnc', oParamSvod, oParamSvod.prUderType, IsBreaked);

    if IsBreaked {abort; exit;};

    if ( oParamSvod.prFormType = 0 )
    {
      case oParamSvod.prUderType of
       1:
       {
         case oParamSvod.prInOtch of
          0: OutA.SetGroup('Svodnc');
          1: OutA.SetGroup('Svodnc1');
          3: OutA.SetGroup('Svod1proc');
          2: OutA.SetGroup('Svodproc');
         end;
       }

       3: OutA.SetGroup('13zp');
       4: OutA.SetGroup('ProfVznos');
       5: OutA.SetGroup('SvodGrPodr');
       else
       {
         if ( (oParamSvod.prInOtch and 1) = 1 )
           OutA.SetGroup('Svodnc1');
         else
           OutA.SetGroup('Svodnc');
       }
       end; //case
     }
  }

  1:    // по удержаниям
  {
    if (oParamSvod.prprvidud = -1) then
      PRnvidopl := 'по нескольким видам удержаний'
    else
    {
      if GetFirst klvidud where (( oParamSvod.prprvidud == klvidud.vidud )) = 0
        PRnvidopl := klvidud.NVidUd
      else
        PRnvidopl := 'по выбранным видам удержаний';
    }

    if ( oParamSvod.prPoCexOZ and 1 ) > 0
      tsFlag := RunInterface('formudOZ', oParamSvod, oParamSvod.prUderType );
    else
      tsFlag := RunInterface('FormUd', oParamSvod, oParamSvod.prUderType);

    if IsBreaked {abort; exit;};

    if ( oParamSvod.prFormType = 0 )
    {
      case oParamSvod.prUderType of
       5 : OutA.SetGroup('SvodGrPodrUd');
       6 : OutA.SetGroup('SvodGrPodrUdR'); // с реквизитами
      else
        OutA.SetGroup('SvodUd');
      end;
    }
  }

  2:
  {
    wYear := if(oParamSvod.prVedYear3 = 0, YearRas, YearRas - 1);

    if ( YearRas = wYear ) and ( MonthRas = oParamSvod.prVedMonth3 )
      RunInterface('FormDolg', oParamSvod );
    else
      RunInterface('ArxDolg', oParamSvod );

    GroupByWorker := False;

    if ( oParamSvod.prFormType = 0 )
      OutA.SetGroup('SvodDolg');
  }
  end; //case

  if ( getfirst VedGroup <> tsOK )
  {
    if getfirst formarks <> tsok
      message(chr(3)+'В выбранных подразделениях нет лицевых счетов на '+datetostr(date(1,oParamSvod.prVedMonth1,oParamSvod.prVedYear1),'month')+' '+string(oParamSvod.prVedYear1)+'г.',CancelButton);
    else
      message(chr(3)+'Не найдена информация для формирования ведомости ',CancelButton);
    abort; exit;
  }

  rereadrecord;

  if ( oParamSvod.prFormType = 0 )
    if (OutA.error) and ( oParamSvod.prFormType = 0 ) { abort; exit; }

  StartNewVisual( vtIndicatorVisual, vfTimer, ''#3'Формирование временной таблицы', RecordsInTable(#VedGroup));

  _loop VedGroup novisual
  {
    ClearBuffer(#tmp_VedGroup);
    tmp_VedGroup.CREC1    := VedGroup.CREC1;     // группировка
    tmp_VedGroup.CREC2    := VedGroup.CREC2;     // глубина иерархии
    tmp_VedGroup.CREC3    := VedGroup.CREC3;     // Tabn
    tmp_VedGroup.CREC4    := VedGroup.CREC4;  
    tmp_VedGroup.CREC5    := VedGroup.CREC5;
    tmp_VedGroup.PCOMP1   := VedGroup.PCOMP1;    // cLsch
    tmp_VedGroup.PCOMP3   := VedGroup.PCOMP3;    // cAppoint
    tmp_VedGroup.PCOMP4   := VedGroup.PCOMP4;    // _VidOplP
    tmp_VedGroup.PCOMP5   := VedGroup.PCOMP5;    // _VidOplS
    tmp_VedGroup.PDOUBLE1 := VedGroup.PDOUBLE1;  // Koldn
    tmp_VedGroup.PDOUBLE2 := VedGroup.PDOUBLE2;  // Chasf
    tmp_VedGroup.PDOUBLE3 := VedGroup.PDOUBLE3;  // summa
    tmp_VedGroup.PDOUBLE4 := VedGroup.PDOUBLE4;  // summa
    tmp_VedGroup.PDOUBLE5 := VedGroup.PDOUBLE5;  // summa
    tmp_VedGroup.PDOUBLE6 := VedGroup.PDOUBLE6;
    tmp_VedGroup.PDOUBLE7 := VedGroup.PDOUBLE7;
    tmp_VedGroup.PDOUBLE8 := VedGroup.PDOUBLE8;
    tmp_VedGroup.PDOUBLE9 := VedGroup.PDOUBLE9;
    tmp_VedGroup.wMesVip  := VedGroup.pWord3;    // MesV
    tmp_VedGroup.wMesZ    := VedGroup.pWord4;    // Mes
    tmp_VedGroup.wMesV    := VedGroup.pWord5;    // MesN
    tmp_VedGroup.wYearV   := VedGroup.pWord6;
    tmp_VedGroup.wYearZ   := VedGroup.pWord7;

    if ( oParamSvod.prUderType > 4 )
    {
      if GetFirst KatPodr Where (( VedGroup.CREC2  ==  KatPodr.NRec)) = tsoK
      {
        tmp_VedGroup.CREC6 := KatPodr.cGrPodr;

        if GetFirst GrPodr Where (( KatPodr.cGrPodr  ==  GrPodr.NRec)) =tsoK
          tmp_VedGroup.PSTRING1 := GrPodr.Name;
        else
          tmp_VedGroup.PSTRING1 := 'без группы';
      }
      else
        tmp_VedGroup.PSTRING1 := 'без группы';
    }

    tmp_VedGroup.PSTRING2 := VedGroup.PSTRING2;
    //заполняем поле с табельным номером
    if ( getfirst lschett where ((VedGroup.pComp1 == Lschett.Nrec))= tsOk )
      tmp_VedGroup.PSTRING3 := GetStrTabn(LSCHETT.TABN, LSCHETT.StrTABN);

    insert current tmp_VedGroup;
    nextvisual;
  } // _loop

  StopVisual('',0);

  StartNewVisual( vtIndicatorVisual, vfTimer, ''#3'Печать вспомогательной ведомости', RecordsInTable(#tmp_VedGroup));

  TOA.Bind(0); // связываем TOA с собственной организацией

  if ( oParamSvod.prFormType = 1 )
  {
    Set sXLSFileName := pXL.CreateReport(sXLTFileName, true);
    pXL.CreateVar(sXLSFileName);
    pXL.SetNumberVar('Заголовок', oParamSvod.prVedSvod);
    pXL.SetNumberVar('Дата_Форм', oParamSvod.prUderType);
    pXL.SetNumberVar('Признак', oParamSvod.prInOtch);
    pXL.SetStringVar('CommonFormHeader', CommonFormHeader);
    pXL.SetStringVar('Организация', 'ОРГАНИЗАЦИЯ: ' + Trim(TOA1.GetNaming.GetFullName));
    pXL.SetStringVar('ВидОплаты', LoCase(prnvidopl));
    pXL.SetStringVar('Год_Расч', String(oParamSvod.prVedYear1));
    // GP 812
    pXL.SetStringVar('Отв_Исп', 'Дата составления: '+DateToStr(Cur_Date, 'DD.MM.YYYY')+' Исполнитель: '+sGetTune('User.FIO'));
    // GP 812

    if ( oParamSvod.prVedSvod = 2 )
    {
      pXL.SetStringVar('Дата_Расч', 'за ' + datetostr(to_date(1,oParamSvod.prVedMonth3,YearRas),'month') + ' ' + String(wYear) + 'г.');
      pXL.SetStringVar('Период_Расч', 'за период с '+ datetostr(to_date(1,oParamSvod.prVedMonth1,YearRas),'mon') +  ' ' +
                                      String(oParamSvod.prVedYear1) + ' по ' + datetostr(to_date(1,oParamSvod.prVedMonth3,YearRas),'month') +  ' ' +
                                      String(wYear));
    }
    else
    {
      pXL.SetStringVar('Дата_Расч', 'за ' + datetostr(to_date(1,oParamSvod.prVedMonth2,YearRas),'month') + ' ' + String(oParamSvod.prVedYear2) + 'г.');
      pXL.SetStringVar('Период_Расч', 'за период с '+ datetostr(to_date(1,oParamSvod.prVedMonth1,YearRas),'mon') + ' ' +
                                      String(oParamSvod.prVedYear1) + ' по ' + datetostr(to_date(1,oParamSvod.prVedMonth2,YearRas),'month') + ' ' +
                                      String(oParamSvod.prVedYear2));
    }
  }
  else
  {
    OutA.write( Trim(TOA1.GetNaming.GetFullName) );
    OutA.write( LoCase(prnvidopl) );
    OutA.Write( datetostr(to_date(1,oParamSvod.prVedMonth1,YearRas), 'mon') );
    OutA.Write( oParamSvod.prVedYear1 );
    OutA.Write( oParamSvod.prLocFlag6 );

    if ( oParamSvod.prVedSvod = 2 )
    {
      OutA.Write( datetostr(to_date(1,oParamSvod.prVedMonth3,YearRas),'month') );
      OutA.Write( wYear );
    }
    else
    {
      OutA.Write( datetostr(to_date(1,oParamSvod.prVedMonth2,YearRas),'month') );
      OutA.Write( oParamSvod.prVedYear2 );
    }
  }

  TekCex := oParamSvod.proCex;
  prName := PAF.GetDepartmentFilterStr;

  if ( oParamSvod.prFormType = 1 )
  {
    pXL.SetStringVar('Пр_подр', prname);
    pXL.PublishVar;
    pXL.CreateTbls(sXLSFileName);
    pXL.CreateTbl('VedSvod');
    pXL.CreateTblFld('Удерж');
    pXL.CreateTblFld('Код_польз');
    pXL.CreateTblFld('Код_сист');
    pXL.CreateTblFld('Наим_удерж');
  }
  else
    OutA.write(prname);

  GroupFlag := getfirst tmp_VedGroup;

  while ( GroupFlag = tsOK )  do
  {
    QVidOpl   := tmp_VedGroup.cRec4;
    QVidOplMy := tmp_VedGroup.cRec5;

      case oParamSvod.prVedSvod of
        0:
        {
          if (GetFirst fastfirstrow klvidoplM where ((tmp_VedGroup.cRec5 == klvidoplM.vidopl)) = tsOk )
          {
            if ( oParamSvod.prFormType = 0 )
            {
              OutA.Write(klvidoplM.vidoplp);
              OutA.Write(klvidoplM.vidopl);
              OutA.Write(klvidoplM.Nvidopl);
            }
            else
            {
              if ( oParamSvod.prUderType < 5 )
              {
                pXL.ClearTblBuffer;
                pXL.SetTblStringFldValue('Код_польз', String(klvidoplM.vidoplp));
                pXL.SetTblStringFldValue('Код_сист', String(klvidoplM.vidopl));
                pXL.SetTblStringFldValue('Наим_удерж', String(klvidoplM.Nvidopl));
                pXL.InsTblRow;
              }
            }
          }
          else
          {
            if ( oParamSvod.prFormType = 0 )
              OutA.SkipFormat(3);
          }
        }
        1:
        {
          if (GetFirst fastfirstrow klvidudM
            where ((tmp_VedGroup.cRec5 == klvidudM.vidud)) = tsOk )
          {
            if (oParamSvod.prFormType = 1)
            {
              if ( oParamSvod.prUderType < 5 )
              {
                pXL.ClearTblBuffer;
                pXL.SetTblStringFldValue('Код_польз', String(klvidudM.vidudp));
                pXL.SetTblStringFldValue('Код_сист', String(klvidudM.vidud));
                pXL.SetTblStringFldValue('Наим_удерж', String(klvidudM.Nvidud));
                pXL.InsTblRow;
              }
            }
            else
            {
              OutA.Write(klvidudM.vidudp);
              OutA.Write(klvidudM.vidud);
              OutA.Write(klvidudM.Nvidud);
            }
          }

        }
        else
        {
          if ( oParamSvod.prFormType = 0 )
            OutA.skipformat(3);
        }
      end; //case

     while ( GroupFlag = tsOK ) and ( QVidOpl = tmp_VedGroup.cRec4 ) and
