//    pLschet:=uch_lsch;
//    wMes  :=month(uch_datan);
//    wYear :=year (uch_datan);
    result := iGP_KPI_Alg.getEM_KOEFF_ERS(uch_lsch,uch_datok);
  }//public function CalcSum(Parameter: string): double;

  //-----------------------------
  // Наименование алгоритма
  //-----------------------------
  Function GetDescription: string;
  { result := 'Коэффициент из документа "Лист оценки сотрудника" по лицевому счету';
  } //function GetDescription: string;
end.
