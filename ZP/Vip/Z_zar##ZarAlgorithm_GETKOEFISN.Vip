#include ZarAlg.vih
#include GP_KPI_Alg.vih
#component "Z_Zar"

VipInterface ZarAlgorithm_GETKOEFISN implements IZarAlgorithm licensed(free);
#doc
Получение коэффициента индивидуальной стимулирующей надбавки
Коэффициент из документа "Лист оценки сотрудника"
Для использования нужно создать спец.алгоритм со следующим содержанием:
ZARALG('GP_ZP::GETKOEFISN')
#end
Interface ZarAlgorithm_GETKOEFISN cacheable;
//----------------------------
