//	PeriodEnd  :date;
//-----------------------
// Накопим проценты и суммы
//---------------------
create view
var
    pLschet:comp;
//    wMes,wYear:word;
 as select
   Lschet.Nrec
from Lschet
 where ((
       pLschet == Lschet.Nrec
  ));
