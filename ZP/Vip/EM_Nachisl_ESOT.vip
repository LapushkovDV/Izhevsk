    MysqlAddStr(hstr, '  left join lschet ls on ls.nrec = svo.CLSCH                                          ');
    MysqlAddStr(hstr, '  left join klvidopl kvo on kvo.VIDOPLP = svo.VIDOPL                                  ');
    MysqlAddStr(hstr, ' where 1 + 256*SvO.mesN  +svo.yearN*256*256 between #date('+DateToStr(_DateBeg,'DD,MM,YYYY')+') and #date('+DateToStr(_DateEnd,'DD,MM,YYYY')+') ');
    MysqlAddStr(hstr, '   and SvO.VIDOPL <> 189 //lолг за предприятием не учитываем тут                      ');
    MysqlAddStr(hstr, ' group by                                                                             ');
    MysqlAddStr(hstr, '   ls.strtabn                                                                         ');
    MysqlAddStr(hstr, ' , ls.nrec                                                                            ');
    MysqlAddStr(hstr, ' , SvO.YEarN                                                                          ');
    MysqlAddStr(hstr, ' , SvO.mesN                                                                           ');
    MysqlAddStr(hstr, ' , case when length(podr.kod) = 3 then podr.kod else podrUp.kod end                   ');
    MysqlAddStr(hstr, ' , case when length(podr.kod) = 3 then '''' else podr.kod end                           ');
    MysqlAddStr(hstr, ' , dolj.name                                                                          ');
    MysqlAddStr(hstr, ' , klkatego.NAIKAT                                                                    ');
    MysqlAddStr(hstr, ' , klsisopl.NASISOPL                                                                  ');
    MysqlAddStr(hstr, ' , klsisopl.SISOPL                                                                  ');
    MysqlAddStr(hstr, ' , kvo.VIDOPLP                                                                        ');
    MysqlAddStr(hstr, ' , dolj.nrec                                                                          ');
    MysqlAddStr(hstr, ' , klkatego.kod                                                                       ');
    MysqlAddStr(hstr, ' , podr.nrec                                                                          ');
    MysqlAddStr(hstr, ' , ls.TPERSON                                                                         ');
    MysqlAddStr(hstr, ' ) t                                                                                  ');
//    MysqlAddStr(hstr, '   where tabn in (''003752'',''002020'')                                                  ');
    MysqlAddStr(hstr, ' group by                                                                             ');
    MysqlAddStr(hstr, '   Tabn                                                                              ');
    MysqlAddStr(hstr, ' , lsNrec                                                                            ');
    MysqlAddStr(hstr, ' , cPerson                                                                            ');
    MysqlAddStr(hstr, ' , PodrUp                                                                            ');
    MysqlAddStr(hstr, ' , Podr                                                                              ');
    MysqlAddStr(hstr, ' , cPodr                                                                              ');
    MysqlAddStr(hstr, ' , Dolj                                                                              ');
    MysqlAddStr(hstr, ' , cDolj                                                                              ');
    MysqlAddStr(hstr, ' , Kategor                                                                           ');
    MysqlAddStr(hstr, ' , KategorKod                                                                           ');
    MysqlAddStr(hstr, ' , YearN                                                                             ');
    MysqlAddStr(hstr, ' , MesN                                                                              ');
    MysqlAddStr(hstr, ' , SisOpl                                                                            ');
    MysqlAddStr(hstr, ' , SisOplKod                                                                         ');
    MysqlAddStr(hstr, ' , VidOplp                                                                            ');


  var objQuery: iQuery;
      objQuery := queryManager.createQuery(hstr);

    if objQuery.execute.errorCode != tsOk
     then {MyLog('Ошибка выполнения запроса '+ objQuery.errorCode);
           exit;
          }
        else
        {sqlCopyInto(objQuery, tntReport, true);
        }
 delete all tReportPers;

 StartNewVisual(vtIndicatorVisual , vfTimer + vfBreak ,'Группировка полученных начислений по перемещениям сотрудников'
         +''#13''+'Просмотр табелей', recordsintable(tntReport));

  _loop tReport
  {
    if not nextvisual then break;

/*
mylog('========================  Tabn       ' +tReport.Tabn +'|lsNrec = ' +tReport.lsNrec+'|cPerson = ' +tReport.cPerson+'|PodrUp = ' +tReport.PodrUp+'|Podr = ' +tReport.Podr
  );
mylog('|cPodr      ' +tReport.cPodr+
+'|Dolj = ' +tReport.Dolj
+'|cDolj = ' +tReport.cDolj
+'|Kategor = ' +tReport.Kategor
+'|KategorKod = ' +tReport.KategorKod
+'|YearN = ' +tReport.YearN
+'|MesN = ' +tReport.MesN
+'|SisOpl = ' +tReport.SisOpl
+'|SisOplKod = ' +tReport.SisOplKod
+'|VidOpl = ' +tReport.VidOpl
+'|Vyrabotka = ' +tReport.Vyrabotka
+'|summa = ' +tReport.summa
);
*/


   if getfirst tReportPers where ((tReport.lsNrec     == tReportPers.lsNrec
                               and tReport.cPodr      == tReportPers.cPodr
                               and tReport.cDolj      == tReportPers.cDolj
                               and tReport.KategorKod == tReportPers.KategorKod
                               and tReport.SisOplKod  == tReportPers.SisOplKod
                               and tReport.YearN      == tReportPers.YearN
                               and tReport.MesN       == tReportPers.MesN
                                  )) <> tsOK
    then {
         insert tReportPers set
              tReportPers.Tabn       := tReport.Tabn
            , tReportPers.lsNrec     := tReport.lsNrec
            , tReportPers.PodrUp     := tReport.PodrUp
            , tReportPers.Podr       := tReport.Podr
            , tReportPers.cPodr      := tReport.cPodr
            , tReportPers.Dolj       := tReport.Dolj
            , tReportPers.cDolj      := tReport.cDolj
            , tReportPers.Kategor    := tReport.Kategor
            , tReportPers.KategorKod := tReport.KategorKod
            , tReportPers.YearN      := tReport.YearN
            , tReportPers.MesN       := tReport.MesN
            , tReportPers.SisOpl     := tReport.SisOpl
            , tReportPers.SisOplKod  := tReport.SisOplKod
            , tReportPers.cPerson    := tReport.cPerson
            , tReportPers.Vozrast    := if(getfirst persons where ((tReport.cPerson == persons.nrec)) = tsok,year(sub_date(cur_date,BORNDATE))-1,0)
            , tReportPers.StajNaOrg  := getStajOnOrg(tReport.cPerson)
          ;
         ReReadWorkingTable;
        }
      update current tReportPers set tReportPers.Vyrabotka  := tReportPers.Vyrabotka + tReport.Vyrabotka;
  }
stopvisual;

}

procedure FillKlVidOplByExclassSeg(_cExClasssSeg : comp);
{
_loop ecv where ((      1021 == ecv.CLASSCODE
           and _cExClasssSeg == ecv.CCLASSSEG ))
 if getfirst KVO where ((ecv.CREC == kvo.nrec)) = tsOK
 {
  if getfirst tColumns1 where ((kvo.vidoplp == tColumns1.vidoplp
                                     and 1 == tColumns1.TypeRec
                             )) <> tsOK then
   {

    _nppColumn++;
     insert tColumns1 set
        tColumns1.name      := kvo.nVidOpl + ' ('+kvo.VidOplP+')'
      , tColumns1.nppColumn := _nppColumn
      , tColumns1.nrec      := kvo.nrec
      , tColumns1.vidoplp   := kvo.vidoplp
      , tColumns1.cParent   := _cExClasssSeg
      , tColumns1.TypeRec   := 1 // Вид оплаты
     ;
      mylog('FillKlVidOplByExclassSeg ' +
      +'|name = '+tColumns1.name
      +'|nppColumn = '+tColumns1.nppColumn
      +'|nrec = '+tColumns1.nrec
      +'|cParent = '+ tColumns1.cParent
      +'|TypeRec = '+ tColumns1.TypeRec
      +'|vidoplp = ' + tColumns1.vidoplp
      );

   }
 }
}

procedure FillDataExclasseg(_cGroup : comp);
{
  setvisualheader('Просмотр внешней классификации видов оплат');
  _loop ecs where ((1021 == ecs.classcode and '' << ecs.name)) and ecs.cGroup = _cGroup
   {
    if(getfirst tColumns where ((ecs.nrec == tColumns.nrec
                                    and 0 == tColumns.TypeRec// классификатор
                               ))
      ) <> tsOK
       {
         _nppColumn++;
         insert tColumns set
            tColumns.name      := ecs.name
          , tColumns.nppColumn := _nppColumn
          , tColumns.nrec      := ecs.nrec
          , tColumns.cParent   := ecs.cGroup
          , tColumns.TypeRec   := 0 // классификатор
         ;
          mylog('FillDataExclasseg ' +
          +'|name = '+tColumns.name
          +'|nppColumn = '+tColumns.nppColumn
          +'|nrec = '+tColumns.nrec
          +'|cParent = '+tColumns.cParent
          +'|TypeRec = '+tColumns.TypeRec
          +'|vidoplp = ' + tColumns.vidoplp
              );

          FillKlVidOplByExclassSeg(ecs.nrec);
          pushpos(tnEcs);
           FillDataExclasseg(ecs.nrec);
          poppos(tnEcs);
       }
   }
}
handleevent
cmDelOnProtect:
 {
   _fPodr   := coStrAllPodr;
   rereadrecord;
 }
cmPick:{
  case curfield of
   #_fPodr : {
        if iGetKau.GetCodeKau(cgiMulti + cgiNotClear, cgKau_KatPodr, 0h) > 0
        {
          var lKauMar :longint= InitMarker(iGetKau.GetMarkerName(cgKau_KatPodr), 8, 100, 10);
          if GetMarkerCount(lKauMar) = 0
            then set  _fPodr := coStrAllPodr
            else set  _fPodr := 'Выбрано '+GetMarkerCount(lKauMar)
           ;
         donemarker(lKauMar,iGetKau.GetMarkerName(cgKau_KatPodr));
        }
     }
  end;
}
cmInit:
{
 if getfirst catalogs where ((89 == catalogs.syscode)) <> tsOK
  {
    message('В каталоге не найдена системная запись catalogs.syscode = 89 "Стаж работы на предприятии"',error);
    stop; abort; exit;
  }

  _cCatStajOnOrg :=catalogs.nrec;

  _DateBeg := cur_date;
  _DateEnd := cur_date;
  _fPodr   := coStrAllPodr; // = '--ВСЕ--'
}

cmok:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all tColumns;
  delete all tReport;
  delete all tReportPers;

  FillDataSQL;
  if getfirst tReport <> tsOK then
  {
    message('Нет данных для формирования отчета',error);
    StopVisual;
    stop; abort; exit;
  }
  _nppColumn := 0;
  FillDataExclasseg(0h);

  PrintReportToExcel;
    StopVisual;
}

end;
end.

VipInterface UserReport_EM_Nachisl_ESOT Implements IUserReport;
Interface UserReport_EM_Nachisl_ESOT;

Procedure Run;
Begin
  runinterface(EM_Nachisl_ESOT);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Начисления с группировкой по ЕСОТ';
End;

Function GetGroupName (Level : Word) : String;
Begin
#__UNUSED__(Level)
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'MENUZARP';
  end;
end;

End.
