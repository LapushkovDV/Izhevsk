if CreateTMPFiltTable(cgKau_KatPodr) then
   {
    MysqlAddStr(hstr, '     join ' + GetTAbleName(cgKau_KatPodr)+ ' on ' + GetTAbleName(cgKau_KatPodr)+'.crec = podr.nrec');
   }
    MysqlAddStr(hstr, '  left join catalogs Dolj on Dolj.nrec = svo.CAPPOINT                                 ');
    MysqlAddStr(hstr, '  left join KlKatego on klkatego.kod = svo.KATEG                                      ');
