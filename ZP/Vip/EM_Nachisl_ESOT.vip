    MysqlAddStr(hstr, ' , podr.nrec as cPodr                                                                ');
    MysqlAddStr(hstr, ' , dolj.name          as Dolj                                                        ');
    MysqlAddStr(hstr, ' , dolj.nrec          as cDolj                                                        ');
    MysqlAddStr(hstr, ' , klkatego.NAIKAT    as Kategor                                                     ');
    MysqlAddStr(hstr, ' , klkatego.kod       as KategorKod                                                  ');
    MysqlAddStr(hstr, ' , SvO.YEarN as YearN                                                                ');
    MysqlAddStr(hstr, ' , SvO.mesN as MesN                                                                  ');
    MysqlAddStr(hstr, ' , klsisopl.NASISOPL as SisOpl                                                       ');
    MysqlAddStr(hstr, ' , klsisopl.SISOPL as SisOplKod                                                       ');
    MysqlAddStr(hstr, ' , kvo.VIDOPLP as VidOplp                                                             ');
    MysqlAddStr(hstr, ' , Sum(case when kvo.VIDOPLP in (1,9,10) and svo.PROC = 0 then SvO.chasf else 0 end) as Vyrabotka     ');
