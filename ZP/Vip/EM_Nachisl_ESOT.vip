    MysqlAddStr(hstr, ' , klkatego.NAIKAT                                                                    ');
    MysqlAddStr(hstr, ' , klsisopl.NASISOPL                                                                  ');
    MysqlAddStr(hstr, ' , klsisopl.SISOPL                                                                  ');
    MysqlAddStr(hstr, ' , kvo.VIDOPLP                                                                        ');
    MysqlAddStr(hstr, ' , dolj.nrec                                                                          ');
    MysqlAddStr(hstr, ' , klkatego.kod                                                                       ');
    MysqlAddStr(hstr, ' , podr.nrec                                                                          ');
    MysqlAddStr(hstr, ' , ls.TPERSON                                                                         ');
    MysqlAddStr(hstr, '                                                                                      ');
    MysqlAddStr(hstr, ' union all                                                                            ');
    MysqlAddStr(hstr, '                                                                                      ');
    MysqlAddStr(hstr, ' select                                                                              ');
    MysqlAddStr(hstr, '   ls.strtabn as Tabn                                                                ');
    MysqlAddStr(hstr, ' , ls.nrec as lsNrec                                                                 ');
    MysqlAddStr(hstr, ' , ls.TPERSON as cPERSON                                                             ');
    MysqlAddStr(hstr, ' , case when length(podr.kod) = 3 then podr.kod else podrUp.kod end as PodrUp        ');
