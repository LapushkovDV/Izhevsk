/*************************************************************************************************\
* Наименование: Постоянные перечисления в банк                                                    *
* Контур/Модуль: Заработная плата                                                                 *
* Пункт меню: Отчеты / Отчеты пользователя / Документы / Банковские реквизиты сотрудников         *
* Примечание:                                                                                     *
* Это интерфейс предназначен для ввода номеров счетов для перечисления заработной платы и аванса. *
*                                                                                                 *
* Вид работы  |Номер задачи  |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1668         |17/01/18|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include PShtraf.vih

interface GP_PickSh 'Постоянные перечисления в банк' doAccept, escClose, cyan;
  show at (,,, 79);

#IfDef _2019_02_13_
#include PometkaRP.inc
#EndIf

  create view
    Var
      TabNom: String;
      LS_NRec: Comp; // ссылка на ЛС
      cOrg: Comp; // ссылка на организацию
      CB: Comp; // ссылка на банк
      CNS: tNomLSch;
      CNC: String[35];
      LS_Summa27: Double;
    from
      Shtraf,
      Persons,
      KlVidUd,
      Sys_Dog
    where ((
          LS_NRec         == Shtraf.cLSch
      and (Shtraf.VidUd = 199 or // Перечисление аванса
       Shtraf.VidUd >= 141 and Shtraf.VidUd <= 145 or // Перечисление аванса
       Shtraf.VidUd >= 206 and Shtraf.VidUd <= 210 or // Перечисление з/п
       Shtraf.VidUd >= 220 and Shtraf.VidUd <= 230) // Перечисление з/п
      and LS_NRec         == LSchet.NRec
      and LSchet.TPerson  == Persons.NRec    
      and Shtraf.VidUd    == KLVidUd.VidUd
      and Shtraf.cPol     == KatOrg.NRec
      and Shtraf.cBankPol == KatBank.NRec
    ));

  parameters LS_NRec, cOrg, CB, CNS, CNC, LS_Summa27;

  browse brwShtraf (, hcShtraf, sci1478EnEsc);
    table Shtraf;
    fields
      VidUdp 'Вид', 'перечис.' ('Код вида перечисления', hcShtraf): [5], protect;
      NVidUd 'Наименование', 'перечисления' ('Наименование вида перечисления', hcShtraf): [10], protect;
      KatOrg.NAME 'Наименование', 'организации'('Наименование организации-получателя', hcShtraf): [20], protect;
      KatBank.NAME 'Банк', 'получателя' ('Банк получателя', hcShtraf): [20], protect;
      Shtraf.NomLsh 'Номер лице-', 'вого счета'('Номер лицевого счета', hcShtraf): [10], protect;
      Shtraf.NomCard 'Номер карты' ('Номер карты', hcShtraf): [10], protect;
      Shtraf.Pometka 'В рас', 'чет' ('Проставьте "-", если вид перечисления не используется в расчете', hcPometka, sci1378EnEsc): [3], protect;
  end;

  handleEvent
    cmInit:
      begin
        // Инициализация отчетных дат данными из настроек
        InitCurrentPeriodDates();
        if GetFirst Shtraf != 0 then
          if Message(''#3'У работника нет постоянных перечислений в банк!'#13#3'Добавить?', OkCancel) != Cancel then
            RunInterface(ZShtraf1, LSchet.NRec)
          else
           abort;
      end;
    cmDeleteRecord:
      if Message('Удалить текущую запись?', Confirmation + YesNo) = Yes then
      begin
        delete Sys_Dog where ((coShtraf == Sys_Dog.TblK[1] and Shtraf.NRec == Sys_Dog.cKAUK[1]));
        delete current Shtraf;
      end;
    cmInsert:
      begin
        abort;
        RunInterface(ZShtraf1, LSchet.NRec);
        ReReadRecord;
      end;
    cmEdit:
      begin
        RunInterface(ZShtraf1, LSchet.NRec);
        ReReadRecord;
      end;
    cmDefault:
      begin
        LS_Summa27 := 1; // удерживается в сбербанк
        if Shtraf.cPol != 0 then
          cOrg := Shtraf.cPol;
        if Shtraf.cBankPol != 0 then
          CB := Shtraf.cBankPol;
        if Trim(Shtraf.NomLsh) != '' then
          CNS := Shtraf.NomLsh;
        if Trim(Shtraf.NomCard) != '' then
          CNC := Shtraf.NomCard;
        set Shtraf.Pometka := coActiveRP;
        update current Shtraf;
        if Shtraf.PrPer != 2 then
          Message('Установите признак перечисления всей зарплаты в данном виде перечисления', Warning);
        var RabNRec: Comp;
        RabNRec := Shtraf.NRec;
        _loop Shtraf
        begin
          if RabNRec != Shtraf.NRec and Shtraf.PrPer = 2 then
          begin
            set Shtraf.Pometka := coInactiveRP;
            Update current Shtraf;
          end;
        end;
      end;
    cmPick:
      if CurField = #Shtraf.Pometka then
      begin
        if not IsValid(#Shtraf) then
        begin
          abort;
          exit;
        end;
        case Shtraf.Pometka of
          coActiveRP:
            set Shtraf.Pometka := coInactiveRP;
          coInactiveRP:
            set Shtraf.Pometka := coArchivedRP;
          coArchivedRP:
            set Shtraf.Pometka := coActiveRP;
          else
            set Shtraf.Pometka := coActiveRP;
        end;
        update current Shtraf;
        var RabNRec: Comp = Shtraf.NRec;
        _loop Shtraf
        begin
          if RabNRec != Shtraf.NRec and Shtraf.PrPer = 2 then
          begin
            set Shtraf.Pometka := coInactiveRP;
            update current Shtraf;
          end;
        end;
        ReReadRecord;
      end;
    cmDone:
      begin
        LS_Summa27 := 0; // удерживается в сбербанк
        _loop Shtraf
        begin
          if Shtraf.PrPer = 2 and (Shtraf.Pometka != coInactiveRP and Shtraf.Pometka != coArchivedRP) and Shtraf.DataN <= DatRas then
          begin
            LS_Summa27 := 1; // удерживается в сбербанк
            if Shtraf.cPol != 0 then
              cOrg := Shtraf.cPol;
            if Shtraf.cBankPol != 0 then
              CB := Shtraf.cBankPol;
            if Trim(Shtraf.NomLsh) != '' then
              CNS := Shtraf.NomLsh;
            if Trim(Shtraf.NomCard) != '' then
              CNC := Shtraf.NomCard;
          end;
        end;
        LSchet.SUMMA27 := LS_Summa27; // удерживается в сбербанк
        if LS_Summa27 = 1 then
        begin
          LSchet.cPodr := cOrg;
          LSchet.cLSchDop := CB;
          LSchet.Pasport := CNS;
          LSchet.NomCard := CNC;
        end;
        if update current LSchet != tsOk then
        begin
        end;
      end;
  end;

end.
