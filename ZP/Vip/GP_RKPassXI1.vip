interface #(GPInt);

table struct mtRKPR // Таблица с результатами
(
  wRow: word
, fVal: array[3..11] of double
)
with index
(
  mtRKPR00 = wRow
);

table struct mtRKDetail // Таблица с расшифровкой
(
  cPsn     : comp
, cDept    : comp
, sFIO     : string[60]
, sTabNmb  : string[20]
, sCodeDept: string[10]
, sPost    : string
, wMonth   : word
, sRow     : string
, fVal     : double
, fSum     : double
)
with index
(
  mtRKDetail01 = cPsn + wMonth + cDept
, mtRKDetail02 = wMonth + sFIO
);


table struct mtVidOplFZP // Классификатор выплат для расчета ФЗП
(
  lVidOpl: longint
)
with index
(
  mtVidOplFZP01 = lVidOpl
);

table struct mpPlanRKT // Классификатор планов для отбора персонала занятого в производстве РКТ
(
  cRecPl: comp
)
with index
(
  mpPlanRKT00 = cRecPl
);

const
#include Excel.inc;
end;

var 
  dRep      : date;
  dRepCur   : date;
  wMonthsRep: word;
  sFileRep  : string  = '';
  isAlone   : boolean = true; // На будущее, для "тихого" вызова методов отчета
  wPrintRash: word;
  mPost1
 ,mPost2
 ,mPost3    : TPtr;
  sPost1
 ,sPost2
 ,sPost3    : string;
  oSrSpStat : StatisObj; // для расчета ССЧ
  oEduFnc   : EducFunctions; // образования
  oCatFnc   : CatalogsFunctions; // каталоги
  oStrFnc   : StringFunctions;
  oChRPD    : GP_ChRPD; // проверка утвержденный ли приказ по персоналу
  oUDR      : GP_UDR_RKStat;
  sPost1201 : array[1..46] of string;
  sPost1202 : array[1..56] of string;
  sPost1203 : array[1..11] of string;


create view
var
  __dRepB: date; // начало периода для выборки
  __dRepE: date; // конец периода для выборки
  __YearV: integer; // год для выборки
  __MesV:  word; // месяц для выборки
  __sPost: string; //должность
  __cParentB
, __cParentD
, __cParentP: comp;
from
  mtRKPR
, mtRKDetail
, Appointments
, LSchet     
, Persons
, StaffStruct
, KlKatego
, KlRejim
, ContDoc CDoc1
//, ContDoc CDoc5
, ContDoc CDoc8
, KlVidopl
, SumVidOp
, mtVidOplFZP
, mtVidOplFZP mtVidOplFZP_I
, MNPlan
, VPlan
, mpPlanRKT
, NACHISLZAKAZ
, mpPlanRKT mpRKT1
, mpPlanRKT mpRKT2
, mpPlanRKT mpRKT3
, mpPlanRKT mpRKT4
, mpPlanRKT mpRKT5
, mpPlanRKT mpRKT6
, Catalogs CatPost
where
((
// ----------------
// основная выборка
    __dRepE >>= Appointments.AppointDate
and ( __dRepB <= Appointments.DismissDate or Appointments.DismissDate = 0 )
and Appointments.cAddnRec2 == LSchet.nRec
and Appointments.Person == Persons.nRec
and Appointments.StaffStr == StaffStruct.nRec
and StaffStruct.EmpCategory == KlKatego.nRec
and Appointments.WorkRegime == KlRejim.nRec
and Appointments.nRec == CDoc1.cStr and (CDoc1.TypeOper = integer(1))
//and Appointments.nRec == CDoc5.cStr and (CDoc8.TypeOper = integer(5))
and Appointments.nRec == CDoc8.cStr and (CDoc8.TypeOper = integer(8))
// ----------------
// для расчета ФЗП
and LSchet.nRec     == SumVidOp.cLSch
and __YearV         == SumVidOp.YearN
and __MesV          == SumVidOp.MesN
and SumVidOp.VidOpl == mtVidOplFZP.lVidOpl
// ----------------
// для отбора персонала занятого в производстве РКТ
and LSchet.nRec     == NACHISLZAKAZ.cLSch
and __MesV          == NACHISLZAKAZ.MesN
and __YearV         == NACHISLZAKAZ.YearN
and (  NACHISLZAKAZ.TblD[1] = 7
    or NACHISLZAKAZ.TblD[2] = 7
    or NACHISLZAKAZ.TblD[3] = 7
    or NACHISLZAKAZ.TblD[4] = 7
    or NACHISLZAKAZ.TblD[5] = 7
    or NACHISLZAKAZ.TblD[6] = 7)
and NACHISLZAKAZ.cKAUD[1] == mpRKT1.cRecPl
and NACHISLZAKAZ.cKAUD[2] == mpRKT2.cRecPl
and NACHISLZAKAZ.cKAUD[3] == mpRKT3.cRecPl
and NACHISLZAKAZ.cKAUD[4] == mpRKT4.cRecPl
and NACHISLZAKAZ.cKAUD[5] == mpRKT5.cRecPl
and NACHISLZAKAZ.cKAUD[6] == mpRKT6.cRecPl
// ----------------
// для классификатора для отбора персонала занятого в производстве РКТ
and VPlan.nRec == MNPlan.cVPlan
//
/*
and 0 == CatPost.LPr
and __cMainLink == CatPost.MainLink
and (trim(upcase(__sPost)) = trim(upcase(CatPost.Name)))
*/
));

//Заполнение строки должностей/профессий
function sSetPostName(_mSetPost: TPtr): string;
{
  if (getMarkerCount(_mSetPost) = 0)
  {
    result := 'Не выбрано';
    exit;
  }
  else
    if (getMarkerCount(_mSetPost) = 1)
    {
      var cTmp: comp;
      GetMarker(_mSetPost, 0, cTmp);
        result := oCatFnc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько должностей/профессий (' + string(getMarkerCount(_mSetPost)) + ')';
}

//проверка на пересечение Должности/профессии для строк
function isCheckCrossPost(_mAny: TPtr; wPost: word): boolean;
{
  var mTemp: tPtr = InitMarker('', 8, 1000, 100);
  var cPost: comp;
  var ii   : integer;
  var sPost: array[1..3] of string[50];
  
  sPost[1] := 'Руководители';
  sPost[2] := 'Административный персонал';        
  sPost[3] := 'Хозяйственный персонал';                           
  
  result := false;
  
  if ( wPost <> 1 ) AddMarker(mTemp, mPost1);
  if ( wPost <> 2 ) AddMarker(mTemp, mPost2);
  if ( wPost <> 3 ) AddMarker(mTemp, mPost3);
  
  for (ii:= 0; ii < GetMarkerCount(_mAny); ii++)
  {
    GetMarker(_mAny, ii, cPost);
    if FoundMarker(mTemp, cPost)
    {
      message('В строке: '+sPost[wPost]+''#3+Chr(13)+'Дложность/профессия: '+oCatFnc.GetCatalogsName(cPost)+''#3+Chr(13)+' уже выбрана в другом параметре!'#3, Error);
      result := true;
    }
  }

  DoneMarker(mTemp, '');
}

// инициализация входных параметров

function cPost(_sAny: string): comp;
{
  result := 0;
  set __sPost := _sAny;
  if ( getfirst CatPost where ((__cParentB == CatPost.cParent and (trim(upcase(__sPost)) = trim(upcase(CatPost.Name))) )) = tsOk )
    result := CatPost.nRec
  else
    if ( getfirst CatPost where ((__cParentD == CatPost.cParent and (trim(upcase(__sPost)) = trim(upcase(CatPost.Name))) )) = tsOk )
      result := CatPost.nRec
    else
      if ( getfirst CatPost where ((__cParentP == CatPost.cParent and __sPost == CatPost.Name)) = tsOk )
        result := CatPost.nRec
//  if isValid(#CatPost)
/*
and 0 == CatPost.LPr
and __cMainLink == CatPost.MainLink
and (trim(upcase(__sPost)) = trim(upcase(CatPost.Name)))
__cParentD
__cParentP
*/
}
