procedure InitParam;
{
  set dRep := oUDR.ReadDate('RKPassXI1_dRep');
  if dRep = 0
    set dRep := To_Date(31,12,Year(Cur_Date));

  set wPrintRash := oUDR.ReadWord('RKPassXI1_wPrintRash');
  mPost1 := oUDR.ReadMarker('RKPassXI1_mPost1'); set sPost1 := sSetPostName(mPost1); if isCheckCrossPost(mPost1, 1) set sPost1 := '!'+sPost1;
  mPost2 := oUDR.ReadMarker('RKPassXI1_mPost2'); set sPost2 := sSetPostName(mPost2); if isCheckCrossPost(mPost2, 2) set sPost2 := '!'+sPost2;
  mPost3 := oUDR.ReadMarker('RKPassXI1_mPost3'); set sPost3 := sSetPostName(mPost3); if isCheckCrossPost(mPost3, 3) set sPost3 := '!'+sPost3;
  if ( GetMarkerCount(mPost1) = 0 ) {Init1201; set sPost1 := sSetPostName(mPost1);}
  if ( GetMarkerCount(mPost2) = 0 ) {Init1202; set sPost2 := sSetPostName(mPost2);}
  if ( GetMarkerCount(mPost3) = 0 ) {Init1203; set sPost3 := sSetPostName(mPost3);}
}

// сохранение входных параметров
procedure SaveParam;
{
  oUDR.SaveDate  ('RKPassXI1_dRep'      , dRep      );
  oUDR.SaveWord  ('RKPassXI1_wPrintRash', wPrintRash);

  oUDR.SaveMarker('RKPassXI1_mPost1', mPost1);// DoneMarker(mPost1, '');
  oUDR.SaveMarker('RKPassXI1_mPost2', mPost2);// DoneMarker(mPost2, '');
  oUDR.SaveMarker('RKPassXI1_mPost3', mPost3);// DoneMarker(mPost3, '');
}

// очистка таблицы с результатом
procedure ClearResult;
{
  delete all from mtRKPR;
}

// есть ли что выводить в отчет
function isOutResult: boolean;
{
  result := false;
  if isValid(#mtRKPR)
    result := true;
}

// проверка корректности параметров отчета
function isCheckRepParam(_isAlone : boolean) : boolean;
{
  result := false;
  
  if dRep = 0
  {
    if _isAlone
      message('Не задана дата!');
    exit;
  }
  
  if (  GetMarkerCount(mPost1) = 0
     or GetMarkerCount(mPost2) = 0
     or GetMarkerCount(mPost3) = 0 )
  {if _isAlone message('Не заданы должности/профессии!', Error); exit;}

  if (  isCheckCrossPost(mPost1, 1)
     or isCheckCrossPost(mPost2, 2)
     or isCheckCrossPost(mPost3, 3) )
  {if _isAlone message('Пересечение должностей/профессий заданных в параметрах!', Error); exit;}

  result := true;
}

//++++++++++++++++++++++++++++++++++++++++++++++++
// окно с параметрами
window wGP_RKPassXI1 'Параметры формирования. Лист XI-1.' Gray;
  show at (,, 80, 12);
Screen sEx(,, sci1Esc);
  fields
    dRep   ('Дата формирования'):   {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    sPost1 ('Должности/профессии'): {Font = {BackColor = if(sPost1 = 'Не выбрано', ColorNeed, if(pos('!', sPost1) = 1, ColorError, 0))}},protect, pickButton;
    sPost2 ('Должности/профессии'): {Font = {BackColor = if(sPost2 = 'Не выбрано', ColorNeed, if(pos('!', sPost2) = 1, ColorError, 0))}},protect, pickButton;
    sPost3 ('Должности/профессии'): {Font = {BackColor = if(sPost3 = 'Не выбрано', ColorNeed, if(pos('!', sPost3) = 1, ColorError, 0))}},protect, pickButton;
    wPrintRash  ('Печать расшифровки'), noprotect;
buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
    cmValue1,,,'Инициализировать',,;
<< 'Параметры отчета'

 `Дата формирования`.@@@@@@@@@@@@
   
 `Должности/профессии для строк:`
  `1201 Руководители              `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `1202 Административный персонал `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `1203 Хозяйственный персонал    `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  [.] Печать расшифровки`

  <.~С~формировать.>  <.   ~О~тмена   .> <.~Д~олжности/профессии по умолчанию.>
>>
end;

HandleEvent
  cmInit:
  {
    InitParam;
  }
  cmOK:
  {
    if not isCheckRepParam(isAlone)
      exit;
    SaveParam;
    CloseWindowEx(CurWindow,cmDefault);
  }
  cmCancel:
  {
    SaveParam;
    CloseWindowEx(CurWindow,cmCancel);
  }
  cmValue1:
  {
    StartNewVisual(vtRotateVisual, vfTimer,'', 1);
    SetVisualTitle('Инициализация Должностей/профессий.');
    SetVisualHeader('Строка 1201');
    ClearMarker(mPost1); Init1201; set sPost1 := sSetPostName(mPost1);
    SetVisualHeader('Строка 1202');
    NextVisual;
    ClearMarker(mPost2); Init1202; set sPost2 := sSetPostName(mPost2);
    SetVisualHeader('Строка 1203');
    NextVisual;
    ClearMarker(mPost3); Init1203; set sPost3 := sSetPostName(mPost3);
    stopvisual;
  }
  cmPick:
  {
    case CurField of
      #sPost1:
        if (RunInterface('PICKCATALOGEX', -22, 0, Comp(100), mPost1) = cmDefault)
          {set sPost1:= sSetPostName(mPost1); if isCheckCrossPost(mPost1, 1) set sPost1 := '!'+sPost1;}
      #sPost2:
        if (RunInterface('PICKCATALOGEX', -22, 0, Comp(100), mPost2) = cmDefault)
          {set sPost2:= sSetPostName(mPost2); if isCheckCrossPost(mPost2, 2) set sPost2 := '!'+sPost2;}
      #sPost3:
        if (RunInterface('PICKCATALOGEX', -22, 0, Comp(100), mPost3) = cmDefault)
          {set sPost3:= sSetPostName(mPost3); if isCheckCrossPost(mPost3, 3) set sPost3 := '!'+sPost3;}
    end;
  }
/* тут почему то не работает :(
  cmDelOnProtect:
  {
    message('asdasdasd');
    case CurField of
      #sPost1: {ClearMarker(mPost1); set sPost1 := sSetPostName(mPost1);}
      #sPost2: {ClearMarker(mPost2); set sPost2 := sSetPostName(mPost2);}
      #sPost3: {ClearMarker(mPost3); set sPost3 := sSetPostName(mPost3);}
    end;
  }
*/
end;
end;//wGP_RKPassXI1
//++++++++++++++++++++++++++++++++++++++++++++++++

// результат запуска окна с параметрами
function isSetRepParam: boolean;  
{
  result := false;
  if ( RunWindowModal(wGP_RKPassXI1) = cmDefault )
    result := true;
}//function isSetRepParam

// создать новый файл отчета из шаблона
function OpenNewRKPass: boolean;
{
  result := false;
  sFileRep := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\ZP\Форма_Паспорта.xlsx';
  if xlCreateExcelWithTemplate(sFileRep, true)
    result := true;
}// function OpenNewRKPass: boolean;

// добавить значение к результату
procedure AddRes(_wRow, _wCol: word; _fVal: double);
{
  if ( ( _wRow < 9 or _wRow > 50 ) or ( _wCol < 3 or _wCol > 11 ) )
    exit;
  ClearBuffer(#mtRKPR);
  if ( getfirst mtRKPR where((_wRow == mtRKPR.wRow)) <> tsOk )
  {
    mtRKPR.wRow := _wRow;
    if ( insert current mtRKPR <> tsOk ) {}
  }
  mtRKPR.fVal[_wCol] += _fVal;
  if ( update current mtRKPR <> tsOk ) {}
}// AddRes(_wRow, _wCol: word; _fVal: double);

// установить значение результата
procedure SetRes(_wRow, _wCol: word; _fVal: double);
{
  if ( ( _wRow < 9 or _wRow > 50 ) or ( _wCol < 3 or _wCol > 11 ) )
    exit;
  ClearBuffer(#mtRKPR);
  if ( getfirst mtRKPR where((_wRow == mtRKPR.wRow)) <> tsOk )
  {
    mtRKPR.wRow := _wRow;
    if ( insert current mtRKPR <> tsOk ) {}
  }
  mtRKPR.fVal[_wCol] := _fVal;
  if ( update current mtRKPR <> tsOk ) {}
}// procedure SetRes(_wRow, _wCol: word; _fVal: double);

// спозиционировался ли курсор на строке отчета
function isLocateRes(_wRow: word): boolean;
{
  result := false;
  if ( getfirst mtRKPR where((_wRow == mtRKPR.wRow)) = tsOk )
    result := true;
}// function isLocateRes(_wRow: word): boolean;

// номер диапазона возраста
function wWhatAge: word;
{
  var wAge: word = 0;
  wAge := Year(dRepCur - Persons.BornDate) - 1;
  if wAge < 30 {result := 4;}
  else
    if wAge < 35 {result := 5;}
    else
      if wAge < 40 {result := 6;}
      else
        if wAge < 50 {result := 7;}
        else
          if wAge < 60 {result := 8;}
          else {result := 9;}
}

// персонал занят в производстве РКТ
function isRKT: boolean;
{
  var iKAU: word;

  result := false;
  
  if isValid(#NACHISLZAKAZ)
  _loop NACHISLZAKAZ
  {
    for(iKAU := 1; iKAU <= 6; iKAU++)
    {
      if ( NACHISLZAKAZ.TblD[iKAU] = 7 )
        case iKAU of
        1: {if isValid(#mpRKT1) result := true;}
        2: {if isValid(#mpRKT2) result := true;}
        3: {if isValid(#mpRKT3) result := true;}
        4: {if isValid(#mpRKT4) result := true;}
        5: {if isValid(#mpRKT5) result := true;}
        6: {if isValid(#mpRKT6) result := true;}
        end;
    }
    if result
      exit;
  }
}

// заполнение классификатора видов оплат для расчета ФЗП
function InitVidOpl: boolean;
{
  result := false;
  var cEA_KlVidOpl_905: comp = ExtAttr_ID(coKlVidopl, '905 Фонд заработной платы (ОВР)');//Фонд ЗП
  if ( cEA_KlVidOpl_905 = comp(0) )
    exit;
  _loop KlVidopl
    if ( coGetAttrID(coKlVidopl, KlVidopl.Nrec, cEA_KlVidOpl_905) <> comp(0) )
      insert mtVidOplFZP_I set mtVidOplFZP_I.lVidOpl := KlVidopl.VidOpl;
  if isValid(#mtVidOplFZP_I)
    result := true;
}

// заполнение классификатора планов для расчета персонала по производству РКТ
procedure InitPlanRKT;
{
  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'', 0);
  SetVisualTitle('Инициализация аналитик РКТ.');
  SetVisualHeader('Выбрано записей:');
  _loop VPlan
  {
    if VPlan.Code = 999
      continue;
    if isValid(#MNPlan)
    _loop MNPlan
    {
      if (not NextVisual)
        break;
      insert mpPlanRKT 
       set
        mpPlanRKT.cRecPl := MNPlan.nRec;
    }
  }
  StopVisual;
}

// добавить блок данных в таблицу результата
procedure AddFullRes(_wRow, _wAgeCol: word; _fKol, _fSum: double);
{
  AddRes(_wRow, 3, _fKol);
  AddRes(_wRow, _wAgeCol, _fKol);
  AddRes(_wRow, 11, _fSum);
  if ( wPrintRash = 1 )
  {
    clearbuffer(#mtRKDetail);
    if ( getfirst mtRKDetail where((  Persons.nRec           == mtRKDetail.cPsn 
                                  and month(dRepCur)         == mtRKDetail.wMonth
                                  and appointments.Department == mtRKDetail.cDept)) <> tsOk )
    {
      mtRKDetail.cPsn     := Persons.nRec;
      mtRKDetail.cDept    := StaffStruct.Department;
      mtRKDetail.sFIO     := Persons.FIO;
      mtRKDetail.sTabNmb  := Persons.StrTabN;
      mtRKDetail.sCodeDept:= oCatFnc.GetCatalogsCode(appointments.Department);
      mtRKDetail.sPost    := oCatFnc.GetCatalogsName(appointments.Post);
      mtRKDetail.wMonth   := month(dRepCur);
      mtRKDetail.fVal     := 0;
      mtRKDetail.fSum     := 0;
      mtRKDetail.sRow     := '';
      insert current mtRKDetail;
    }
    if ( pos((' ' + to_char(_wRow)), mtRKDetail.sRow) = 0 )
      mtRKDetail.sRow += ' ' + to_char(_wRow);
    if ( _wRow = 9 )
    {
      mtRKDetail.fSum += _fSum;
      mtRKDetail.fVal += _fKol;
//      if ( mtRKDetail.fVal < 1 ) mtRKDetail.fVal += _fKol;
    }
    update current mtRKDetail;
  }
}

// добавить данные по сотруднику в таблицу результата
procedure AddData(_fVal: double; _lPeriod: longint);
{
  var fOneFZP:   double = 0.0; // сумма в ФЗП по текущему сотруднику
  var wAgeCol:   word   = wWhatAge; // номер колонки возрастных групп
  var wKatKod:   word   = if(isValid(#KlKatego), KlKatego.Kod, 0); // код категории
  var wEduLevel: word   = oEduFnc.GetPsnMaxEducOnDate(Persons.nRec, dRep); // уровень образования
  var sKodPodr:  string = oCatFnc.GetCatalogsCode(StaffStruct.Department); // код подразделения из СЕШР
  var isOP:      boolean= false; // Промышленно-производственный персонал
  var isAUP:     boolean= false; // АУП
  var isNPP:     boolean= false; // непромышленный персонал 
  var sKompl:    string = oCatFnc.GetCatalogsName(Persons.ComplSrc); // источник комплектации
  
  set __YearV := Year(dRepCur);
  set __MesV  := Month(dRepCur);

  // определяем в какие разделы попадает сотрудник
  if ( wKatKod = 8 ) //их там нет, но прибить на всякий случай надо
    exit;
  if ( sKodPodr = '957-2' or sKodPodr = '957-3' )
    isNPP := true;

  if ( not isNPP )
    if ( FoundMarker(mPost1, StaffStruct.Post) or FoundMarker(mPost2, StaffStruct.Post) or FoundMarker(mPost3, StaffStruct.Post) )
      isAUP := true;

  if ( ( not isAUP ) and ( not isNPP ) )
    isOP  := true;
  
/*
  if ( Trim(LSchet.CSchetD) = '26' or Trim(LSchet.CSchetD) = '44' ) and ( not isNPP ) 
    isAUP := true;
*/
/*
  if ( Trim(LSchet.CSchetD) = '20' )
    isOP  := true;
*/

  // считаем ФЗП по сотруднику
/*
    if ( getfirst mtRKDetail where((  Persons.nRec           == mtRKDetail.cPsn 
                                  and month(dRepCur)         == mtRKDetail.wMonth
                                  and appointments.Department == mtRKDetail.cDept)) <> tsOk )
*/

  if ( _lPeriod = 0 ) //считаем один раз только по первому периоду иначе будут задвоения, затроения ФОТ и т.п.
    if ( getfirst mtRKDetail where((  Persons.nRec           == mtRKDetail.cPsn 
                                  and month(dRepCur)         == mtRKDetail.wMonth
                                  and appointments.Department == mtRKDetail.cDept)) <> tsOk )
      if isValid(#SumVidOp)
        _loop SumVidOp
          if isValid(#mtVidOplFZP)
            fOneFZP += SumVidOp.Summa;
  
  // далее первый параметр AddFullRes - номер строки в Экселе
  AddFullRes(9, wAgeCol, _fVal, fOneFZP);
  // razdel 11xx
  if isOP
  {
    AddFullRes(10, wAgeCol, _fVal, fOneFZP);
    case wKatKod of
    1, 2, 3, 4:
    {
      AddFullRes(11, wAgeCol, _fVal, fOneFZP);
      if ( wEduLevel = 7 )
        AddFullRes(12, wAgeCol, _fVal, fOneFZP);
    }
    6, 7:
    {
      AddFullRes(13, wAgeCol, _fVal, fOneFZP);
      case wEduLevel of
      7:         AddFullRes(14, wAgeCol, _fVal, fOneFZP);
      9, 10, 11: AddFullRes(15, wAgeCol, _fVal, fOneFZP);
      end;
    }
    end;
    case wKatKod of 
    3, 4:
    {
      AddFullRes(16, wAgeCol, _fVal, fOneFZP);
      if ( wEduLevel = 7 )
        AddFullRes(17, wAgeCol, _fVal, fOneFZP);
    }
    end;
  }// razdel 11xx
  // razdel 12xx
  if isAUP
  {
    AddFullRes(18, wAgeCol, _fVal, fOneFZP);
    if FoundMarker(mPost1, appointments.Post)
      AddFullRes(19, wAgeCol, _fVal, fOneFZP);
    if FoundMarker(mPost2, appointments.Post)
      AddFullRes(20, wAgeCol, _fVal, fOneFZP);
    if FoundMarker(mPost3, appointments.Post)
      AddFullRes(21, wAgeCol, _fVal, fOneFZP);
/*
    case wKatKod of
    5:          AddFullRes(19, wAgeCol, _fVal, fOneFZP);
    6, 7:       AddFullRes(20, wAgeCol, _fVal, fOneFZP);
    1, 2, 3, 4: AddFullRes(21, wAgeCol, _fVal, fOneFZP);
    end;
*/
  }// razdel 12xx
  // razdel 13xx
  if isNPP
    AddFullRes(22, wAgeCol, _fVal, fOneFZP);
  // razdel 13xx
  if ( wEduLevel = 10 or wEduLevel = 11 or oEduFnc.isPsnAcadOnDate(Persons.nRec, dRep) )
    AddFullRes(50, wAgeCol, _fVal, fOneFZP);

  // razdel 14xx
  if isRKT
  {
    AddFullRes(23, wAgeCol, _fVal, fOneFZP);
    if isOP
      AddFullRes(24, wAgeCol, _fVal, fOneFZP);
    if isAUP
      AddFullRes(25, wAgeCol, _fVal, fOneFZP);
  }// razdel 14xx
  
  // razdel 15xx по ТЗ отсутствует

  // razdel 20xx
  if ( Appointments.AppointDate >= __dRepB )
    if isValid(#CDoc1)
      if oChRPD.isConfirmed(CDoc1.nRec)
      {
        AddFullRes(29, wAgeCol, 1, 0);
        if isOP
        {
          AddFullRes(30, wAgeCol, 1, 0);
          case wKatKod of
          1, 2: AddFullRes(31, wAgeCol, 1, 0);
          6:    AddFullRes(32, wAgeCol, 1, 0);
          end;
        }
        if isAUP
          AddFullRes(33, wAgeCol, 1, 0);
        if isNPP
          AddFullRes(34, wAgeCol, 1, 0);

        if ( sKompl = 'В рамках договора целевого обучения*' )
          AddFullRes(35, wAgeCol, 1, 0)
        else
          if ( sKompl = 'По направлению службы занятости*' )
            AddFullRes(38, wAgeCol, 1, 0)
          else
            if ( sKompl = 'По заявке рекрутинговым агентством*' )
              AddFullRes(39, wAgeCol, 1, 0)
            else
              if ( Pos(UpCase('Работа в России'), UpCase(sKompl)) <> 0 )
                AddFullRes(40, wAgeCol, 1, 0)
              else
                if ( ( Pos('*', sKompl) <> Length(sKompl) )
                 and ( sKompl <> 'вольный найм' ) 
                 and ( sKompl <> 'Внешние источники комплектования' ) )
                {
                  case wEduLevel of
                  7:         AddFullRes(37, wAgeCol, 1, 0);
                  9, 10, 11: AddFullRes(36, wAgeCol, 1, 0);
                  end;
                }

      }

  // razdel 30xx
  if ( Appointments.DismissDate <= __dRepE )
    if isValid(#CDoc8)
      if oChRPD.isConfirmed(CDoc8.nRec)
      {
        AddFullRes(41, wAgeCol, 1, 0);
        if isOP
        {
          AddFullRes(42, wAgeCol, 1, 0);
          case wKatKod of
          1, 2: AddFullRes(43, wAgeCol, 1, 0);
          6:    AddFullRes(44, wAgeCol, 1, 0);
          end;
        }
        if isAUP
          AddFullRes(45, wAgeCol, 1, 0);
        if isNPP
          AddFullRes(46, wAgeCol, 1, 0);
        if oCatFnc.GetCatalogsCode(Persons.DisReason) = '11'
          AddFullRes(47, wAgeCol, 1, 0)
        else
          if oCatFnc.GetCatalogsCode(Persons.DisMotive) = 'п.2 ст.81 ТК'
            AddFullRes(49, wAgeCol, 1, 0)
          else
            AddFullRes(48, wAgeCol, 1, 0);
      }

}

// заполняем таблицу результата
function isMakeReport(_isAlone: boolean): boolean;
{
  var fValR:   double;
  var lPeriod: longint;
  var dRepCurB, dRepCurE: date;
  var wMonthRepCur: word;
  result := false;
  
  InitPlanRKT;
  if not InitVidOpl
    if _isAlone
      message('Нет привязки видов оплат к Фонду заработной платы!'+Chr(13)
             +'Данные по Фонду заработной платы не будут сформированы.', Error);

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'', 0);
  SetVisualTitle('Формирую данные для Листа XI-1 в Excel.');

  InitWorkingTable;

  dRepCurB   := To_Date(1, 1, Year(dRep));  
  wMonthsRep := Months_Between(dRep, dRepCurB) + 1;

//  if 2+2=4
  for(wMonthRepCur := 1; wMonthRepCur <= wMonthsRep; wMonthRepCur++)
  {
    dRepCur := To_Date(1, wMonthRepCur, Year(dRep)); 
    set __dRepB := dRepCur; 
    dRepCur := To_Date(Last_Day(dRepCur), wMonthRepCur, Year(dRep)); 
    set __dRepE := dRepCur; //dRepCur
    
    SetVisualHeader('Обработано записей на '+dRepCur+':');

    if isValid(#Appointments)
    _loop Appointments
    {
      // вне штата пропускаем
      if not isValid(#StaffStruct) 
        continue;
      if isvalid(#LSchet)
      if isvalid(#Persons)
      // только основное место работы, основное назначение, не в декрете и т.п.
      if LSchet.Sovm = 0 /*LSchet.Sovm < 3*/ and Appointments.lPrizn=0 and Appointments.Rate<>0 
      {
/*
        var isNeedFullCalc: boolean = false;
        if ( oStrFnc.isHitPeriod(__dRepB, __dRepE, Appointments.AppointDate) or oStrFnc.isHitPeriod(__dRepB, __dRepE, Appointments.DismissDate) )
          isNeedFullCalc := true;
*/
        var isNeedFullCalc: boolean = false;
        if ( Appointments.AppointDate <> 0 )
          if oStrFnc.isHitPeriod(__dRepB, __dRepE, Appointments.AppointDate)
            isNeedFullCalc := true;
        if ( Appointments.DismissDate <> 0 )
          if oStrFnc.isHitPeriod(__dRepB, __dRepE, Appointments.DismissDate)
            isNeedFullCalc := true;
        if isvalid(#KlRejim)
          if ( KlRejim.Hours <> 40 )
            isNeedFullCalc := true;
            
        if (not NextVisual)
          break;
        if isNeedFullCalc
        {
          if ( LoadWorkingTable(LSchet.nRec, Month(__dRepB), Year(__dRepB)) <> 0 )
            continue;
          if WT_LoadPeriods(cfChanges) {};
          for(lPeriod := 0; lPeriod < WT_GetPeriodCount; inc(lPeriod))
          {
            if not WT_GetPeriod(lPeriod, __dRepB, __dRepE)
              continue;
            oSrSpStat.SetDate := __dRepB;
            oSrSpStat.SetPeriod := lPeriod;
            oSrSpStat.RaschSrednSpisochn(LSchet.nrec, 0, 0);
            fValR := oSrSpStat.GetSrChisl; // ??? 
    //        fValR := round(oSrSpStat.GetSrChisl, 0);
    //        AddData(if(fValR > 1, 1, fValR)); //!!!!!!!!!!!!!
            AddData( fValR /*/ wMonthsRep*/, lPeriod); //!!!!!!!!!!!!!
          }
        }
        else
        {
//          AddData( 1, 0);
          AddData( Appointments.Rate, 0);
        }
      }
    }
  }
  StopVisual;
//  DoneWorkingTable;
  if isOutResult
    result := true;
}// function isMakeReport: boolean;

// выводим в Эксел результат отчета
procedure PrintReport/*(_isAlone: boolean)*/;
{
//  var isOkFile:   boolean = false;
  var wRow, wCol: word;

/*
  if _isAlone
    isOkFile := OpenNewRKPass;
  
  if not isOkFile
  {
    if _isAlone
      message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\ZP', Error);
    exit;
  }
*/
  
  if xlSetActiveSheetByName('XI-1')
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Выгружаю данные для Листа XI-1 в Excel.', 0);
    xlSetCellStringValue(sGetTune('MYORG'), 2, 3, 2, 3);
    for(wRow := 9; wRow <= 50; wRow++)
      if isLocateRes(wRow)
      {
        SetRes(wRow, 11, Round(mtRKPR.fVal[11]/1000, 0));
        if ( mtRKPR.fVal[3] <> 0 )
          SetRes(wRow, 10, Round(mtRKPR.fVal[11]/mtRKPR.fVal[3]/*/wMonthsRep*/, 0));
      }
    for(wRow := 9; wRow <= 50; wRow++)
    {
      if (not NextVisual)
        break;
      if isLocateRes(wRow)
        for(wCol:= 3; wCol <= 11; wCol++)
          xlSetCellNumberValue(mtRKPR.fVal[wCol]/if(( wCol < 10 and ( wRow < 29 or wRow = 50) ) , wMonthsRep, 1), wRow, wCol, wRow, wCol);
    }
    StopVisual;
  }
/*
  if _isAlone
    xlKillExcel;
*/
}// PrintReport(_isAlone: boolean);

procedure PrintDetail(_isAlone: boolean);
{
  if (wPrintRash = 1) and _isAlone
  {
    var i, j : integer = 0;
    var s    : string = '';
    xlGetSheetsCount(j);
    while i<=j
    {
      xlSetActiveSheet(++i);
      xlGetSheetName(i,s);
      if s='XI-1' break;
    }
    xlSetActiveSheet(++i);
    xlAddSheet;
    xlSetSheetName(i,'Расшифровка XI-1'); 
    xlSetActiveSheet(i);

    if isvalid(#mtRKDetail)
    {
      var lRecCount: longint = recordsintable(#mtRKDetail);
      var lLine : longint = 0;
      var lRB, lRE, lCB, lCE : longint = 1;
      StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Выгружаю расшифровку для Листа XI-1 в Excel.', 0);
      lRB := lRE := 2;
      xlMergeCells(1,1,1,4);
      xlSetCellStringValue('Расшифровка листа XI-1. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
      lCE := 0;
      var lBeginError, lBegin : longint = 0;
      lCE++; xlSetCellStringValue('№ п/п',lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue('Месяц',lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue('Таб.ном.',lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue('Подразделение',lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue('Должность'+chr(10)+'профессия',lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue('ССЧ',lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue('ФОТ',lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue('В строках',lRE,lCE,lRE,lCE);
      lRE++;
      
      if (not xlCreateMatrix(lRecCount, lCE))
      {
        message('Ошибка функции xlCreateMatrix.',error);
        xlKillExcel;
        StopVisual;
        exit;
      }
      #define FrmCl lRE, lCE
      lRE := 1;
      _loop mtRKDetail ordered index mtRKDetail02
      {
        if (not NextVisual) break;
        lCE := 0;
        ++lCE; xlStWriteToMatrix(#FrmCl, ++lLine);       
        ++lCE; xlStWriteToMatrix(#FrmCl, mtRKDetail.wMonth   );       
        ++lCE; xlStWriteToMatrix(#FrmCl, mtRKDetail.sTabNmb  );       
        ++lCE; xlStWriteToMatrix(#FrmCl, mtRKDetail.sFIO     );       
        ++lCE; xlStWriteToMatrix(#FrmCl, mtRKDetail.sCodeDept);       
        ++lCE; xlStWriteToMatrix(#FrmCl, mtRKDetail.sPost);       
        ++lCE; xlDoWriteToMatrix(#FrmCl, mtRKDetail.fVal     );       
        ++lCE; xlDoWriteToMatrix(#FrmCl, mtRKDetail.fSum     );       
        ++lCE; xlStWriteToMatrix(#FrmCl, mtRKDetail.sRow     );       
        lRE++;
      }
      lRE++;
      xlSetNumberFormat('@', lRB+1,  1, lRE,  6);
      xlSetNumberFormat('# ##0,00;-# ##0,00;', lRB+1,  7, lRE,  7);
      xlSetNumberFormat('@', lRB+1,  8, lRE,  8);
      if (not xlWriteMatrixToExcel(3,1))
        message('Ошибка функции xlWriteMatrixToExcel.',error);
      xlFreeMatrix;
      xlWrapText(lRB,lCB,lRB,lCE);
      xlAutoFit(lRB,lCB,lRE,lCE);
      xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
      xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
      StopVisual;
    }
  }
}//PrintDetail(_isAlone: boolean);

// сам отчет )))
procedure MakeReport(_isAlone: boolean);
{
  if isSetRepParam
  {
    if isMakeReport(_isAlone)
    {
      var isOkFile:   boolean = false;
      
      if _isAlone
        isOkFile := OpenNewRKPass;
      
      if not isOkFile
      {
        if _isAlone
          message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\ZP', Error);
        exit;
      }
      
      PrintReport/*(_isAlone)*/;
      
      PrintDetail(_isAlone);

      if _isAlone
        xlKillExcel;
    }
    else
      if _isAlone
        message('Нет данных для отчета.', Information);
  }
//  SaveParam;
}// procedure MakeReport(_isAlone: boolean);


handleevent
  cmInit:
  {
    ClearResult;
//    set __cMainLink := oCatFnc.GetCatalogsNRec(-22);
    __cParentB := oCatFnc.GetCatalogsNRec(1400);
    __cParentD := oCatFnc.GetCatalogsNRec(49);
    __cParentP := oCatFnc.GetCatalogsNRec(13);
    MakeReport(isAlone);
//    SaveParam;
    CloseInterface(cmDefault);
    abort;
    exit;
  }
  cmDelOnProtect:
  {
    case CurField of
      #sPost1: {ClearMarker(mPost1); set sPost1 := sSetPostName(mPost1);}
      #sPost2: {ClearMarker(mPost2); set sPost2 := sSetPostName(mPost2);}
      #sPost3: {ClearMarker(mPost3); set sPost3 := sSetPostName(mPost3);}
    end;
  }
end;
end.

