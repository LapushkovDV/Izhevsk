#include CreateTune.vih

Handler with replace GP_DateModifyTune on extensionPoint
  epDateModifyTuneEx (TS: ObjStartCreateTuneEx) [1]
Action
{
  // Здесь указываем дату, когда последний раз изменяли этот файл, чтобы автоматически запускалось
  // обновление реестра настроек
  TS.SetLastDateModTuneComp('GP', 17, 8, 2018);
  Result := true;
}

Handler with replace GP_CreateTune_ZP on extensionPoint
  epCreateTuneComponent (TR: ObjCreateTuneEx) [210]
Action
{
  Result := true;

  TR.SetParent('NPOEM_OWN');
  //-----------------------------------
  // NPOEM_OWN.ZP
  TR.AddPartA('NPOEM_OWN.ZP','Заработная плата','');
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddTuneS('NPOEM_OWN.ZP.ShablonAvans', 'Шаблон аванса', ftString,'', '','');
  TR.AddTuneS('NPOEM_OWN.ZP.Avans.Conf', 'Сохранение данных аванса', ftList,0, '','');
      TR.AddList(0, 'Без подтверждения');
      TR.AddList(1, 'По подтверждению');

  //#1786
  TR.AddTuneU('NPOEM_OWN.ZP.RList_SortDef', 'Расч.листки сортировать по (не работает с уст.флагами или с груп.)'
               , ftList,0, '','');
      TR.AddList(0, 'по умолчанию');
      TR.AddList(1, 'по коду подразделения +ФИО');
      TR.AddList(2, 'по 3 символам кода подразделения +ФИО');
  TR.AddTuneU('NPOEM_OWN.ZP.RList_ExportToPDFForPortal', 'Расч.листки формировать отдельно PDF для каждого работника'
               , ftList,0, '','');
      TR.AddList(0, 'нет');
      TR.AddList(1, 'да');

  TR.AddTuneU('NPOEM_OWN.ZP.RList_Vipl_Info', 'Расч.листки выводить информацию о выплатах'
               , ftList,0, '','');
      TR.AddList(0, 'нет');
      TR.AddList(1, 'Полную');
  //-- #2070 Заполнение поля "Выплачено (аванс) в зависимости от настройки.
  TR.AddTuneS('NPOEM_OWN.ZP.MP_Vipl', 'Заполнять поле "Выплачено(аванс)" в начислениях и выплатах межпериода', ftBoolean,'', '','');
  // #1818 нужный расчет желательно делать и в закрытом периоде по настройке.
  TR.AddTuneS('NPOEM_OWN.ZP.DatOtchZak','Отчетный период для пересчета ФОТ позаказно', ftDate, DateToStr(date(1, month(cur_date), year(cur_date)), 'DD/MM/YYYY'), 'MM/YYYY', '');
  //#2516 --
  TR.AddTuneU('NPOEM_OWN.ZP.ARCH_EDIT', 'Разрешить редактирование архивов "Суммы по видам оплат/удержаний","Архив налогов на фот"'
               , ftboolean,0, '','');
  TR.AddTuneS('NPOEM_OWN.ZP.AlgUpdate', 'Алгоритм после расчета отпуска и удержаний', ftComp, '0', '', 0);
    TR.AddIntr('PickAlgor');

   TR.AddTuneS('NPOEM_OWN.ZP.TRUNCATE_AVANS', 'В Функционале переноса аванса в ЛС: обрезать суммы до'
               , ftList,0, '','');
      TR.AddList(0, 'не обрезать');
      TR.AddList(1, '1');
      TR.AddList(2, '10');
      TR.AddList(3, '100');

  TR.AddTuneS('NPOEM_OWN.ZP.Z_REZERV_CALDAYSOTPUSK_VA_12', 'Резерв. по отпускам. Кол-во дней считать по ВА к лицевому/12'
               , ftList,0, '','');
      TR.AddList(0, 'нет');
      TR.AddList(1, 'да');

  TR.AddTuneS('NPOEM_OWN.ZP.Z_ZARLISTSENDEMAIL_LOCALFOLDER_FOR_FILES', 'Рассылка РЛ. Локальная папка, где хранятся расчетные листки', ftString,'', '','');


  // NPOEM_OWN.ZP
  //--------------------------

  //-----------------------------------
  // NPOEM_OWN.ZP.REP
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddPartA('NPOEM_OWN.ZP.REP','Отчеты','');
  TR.SetParent('NPOEM_OWN.ZP.Rep');
  TR.AddTuneU('NPOEM_OWN.ZP.Rep.STRZAR_Macros', 'Состав заработной платы. Скрыть закладку с настройкой макроса'
               , ftboolean,0, '','');
  TR.AddTuneU('NPOEM_OWN.ZP.Rep.PDF', 'Печать в PDF(где доступно)' , ftboolean,1, '','');

  TR.SetParent('NPOEM_OWN.ZP.Rep');
  TR.AddTuneS('NPOEM_OWN.ZP.AccTypeZP', 'Контрагент. Тип З/П', ftComp, '0', '','');
    TR.AddIntr('GETKATORGTYPE');

  TR.SetParent('NPOEM_OWN.ZP.Rep');
  TR.AddTuneS('NPOEM_OWN.ZP.AccTypeIS', 'Контрагент. Тип ИС', ftComp, '0', '','');
    TR.AddIntr('GETKATORGTYPE');

  // NPOEM_OWN.ZP.REP
  //-----------------------------------

  //-----------------------------------
  // NPOEM_OWN.ZP.NARYAD
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddPartA('NPOEM_OWN.ZP.NARYAD','Наряды','');
  TR.SetParent('NPOEM_OWN.ZP.NARYAD');


  TR.AddTuneS('NPOEM_OWN.ZP.NARYAD.USERROLE', 'Роль пользователя при работе с нарядами', ftList,0, '','');
      TR.AddList(0, 'Экономист');
      TR.AddList(1, 'БТЗ');
      TR.AddList(2, 'БТЗ+Экономист');
      TR.AddList(3, 'Экономист(шифр заказа)');
  TR.AddTuneS('NPOEM_OWN.ZP.NARYAD.ALLOWCHECKBTZ', 'Разрешать переводить в статус "Проверен БТЗ"', ftboolean,1, '','');


  //------------------
    TR.AddPartA('NPOEM_OWN.ZP.NARYAD.EXPORT','Экспорт','');
    TR.SetParent('NPOEM_OWN.ZP.NARYAD.EXPORT');
    //--- #3895
      TR.AddTuneS('NPOEM_OWN.ZP.NARYAD.EXPORT.Shablon', 'Шаблон "Потребность в трудовых ресурсах"', ftComp, '0', '', 0);
        TR.AddIntr('PICKNASTRPLTONEEDTR');
      TR.AddTuneS('NPOEM_OWN.ZP.NARYAD.EXPORT.Hozoper', 'ТХО в Хозоперации "Потребность в трудовых ресурсах"', ftComp, '0', '', 0);
        TR.AddIntr('GETHOZOPER_1204'); //GP_IntrTune_Logistics.vip
      TR.AddTuneS('NPOEM_OWN.ZP.NARYAD.EXPORT.DESCR', 'Дескриптор экспорта', ftString, '0', '', 0);
      TR.AddTuneS('NPOEM_OWN.ZP.NARYAD.EXPORT.Status_Create', 'Статус создания "Потребность в трудовых ресурсах"', ftComp, '0', '', 0);
        TR.AddIntr('GETNOTE_PROIZV'); //GP_IntrTune_Logistics.vip
      TR.AddTuneS('NPOEM_OWN.ZP.NARYAD.EXPORT.Status_Change', 'Статус изменения "Потребность в трудовых ресурсах"', ftComp, '0', '', 0);
        TR.AddIntr('GETNOTE_PROIZV'); //GP_IntrTune_Logistics.vip
      TR.AddTuneS('NPOEM_OWN.ZP.NARYAD.EXPORT.Cex', 'Формировать потребность на уровне цеха(нет ''-'' в коде)', ftBoolean, '0', '', 0);


  // NPOEM_OWN.ZP.NARYAD
  //-----------------------------------


  //-----------------------------------
  // Рабочая корзина
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddPartA('NPOEM_OWN.ZP.BASKET','Рабочая корзина','');
  TR.SetParent('NPOEM_OWN.ZP.BASKET');
  //#2228
  TR.AddTuneU('NPOEM_OWN.ZP.BASKET.DISABLE_Processed_Rec', 'Запретить обработку ранее обработанных записей РК'
                , ftboolean,1, '','');
  TR.AddTuneU('NPOEM_OWN.ZP.BASKET.Process_month', 'Разрешать обрабатывать записи РК за прошлые отчетные периоды (кол-во месяцев от тек.периода)'
                , ftWord,0, '','');
  //Удалить обработанные сообщения (1)?
  TR.AddTuneU('NPOEM_OWN.ZP.BASKET.Auto_DEL', 'Предлагать удаление обработанных записей'
                , ftboolean,1, '','');

  //SR00029721
  TR.SetParent('NPOEM_OWN.KAT');
  TR.AddPartA('NPOEM_OWN.KAT.KATPODR', 'Подразделения', '');
  TR.SetParent('NPOEM_OWN.KAT.KATPODR');
  TR.AddTuneU('NPOEM_OWN.KAT.KATPODR.COMPLEX', 'Права доступа для редактирования привязки к комплексам', ftList, 0, '', '');
      TR.AddList(0, 'только просмотр');
      TR.AddList(1, 'редактирование');
      TR.AddList(2, 'все права');

  //Для ЭМ - всегда "да", для НИИМАШа - "нет"
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddTuneS('NPOEM_OWN.ZP.MOVE_FAKT_AVANS_TO_LSCHET', 'Переносить фактический аванс для уволенных в текущем месяце', ftList,0, '','');
      TR.AddList(0, 'да');
      TR.AddList(1, 'нет');

  //Определяет доступ к интерфейсу, в котором определяется с каких крашеных счетов платить людям аванс и ЗП
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddTuneU('NPOEM_OWN.ZP.DISTR_FAKT_AVANS_TO_GOZ', 'Доступ к интерфейсу распределения накладной ЗП по ГОЗ', ftList,0, '','');
      TR.AddList(0, 'нет');
      TR.AddList(1, 'да');

  //Пользовательская аналитика, в которую сохраняются плановые суммы выплат аванса и ЗП с крашеных счетов
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddTuneS('NPOEM_OWN.ZP.PLAN_DISTR_SPKAU', 'Аналитика для хранения плановых сумм к распределению', ftWord, 'Нет', '', ' ');
    TR.AddIntr('GetKauTable');
  //SR00036086
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddTuneS('NPOEM_OWN.ZP.MILK', 'Валюта литр молока', ftComp, '0', '', 0);
    TR.AddIntr('GETMILK'); //Gp_Logistics
  //
  TR.SetParent('NPOEM_OWN.ZP');
  TR.AddTuneS('NPOEM_OWN.ZP.COMREESTRMINSUM', 'Минимальная сумма для коммерческих реестров на перечисление', ftDouble, '50.00', '', 0);
  // Рабочая корзина
  //-----------------------------------
}
