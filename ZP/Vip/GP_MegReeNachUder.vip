Interface GP_MegReeNachUder;

 create view
  var CH : word;
      Filepath : string ;
      row,cnt1,cnt2,onematr : longint;

 as select
  * 
 from prvidopl
     ,LSCHET
     ,KATPODR
     ,PERSONS
     ,KLVIDOPL
     ,KLVIDUD
  where 
  ((
         CH                  == prvidopl.choice
     and PRVIDOPL.CLSCH      == LSCHET.NREC 
     and PRVIDOPL.CEX        == KATPODR.NREC
     and LSCHET.TPERSON      == PERSONS.NREC
     and PRVIDOPL.VIDOPL     == KLVIDOPL.VIDOPL
     and PRVIDOPL.VIDUD      == KLVIDUD.VIDUD

  ));
  
 HandleEvent
  CmInit:{

           Filepath:=StartPathName+'\XLS_ЭМ\Staff\GP_ReeNachUder.xlsx';

           if (not ExistFile(Filepath))
           {
            Message('Не удалось найти шаблон GP_ReeNachUder.xlsx');
            exit;
           }

           sql
            select
             count( *)
            from prvidopl
             where   0 = prvidopl.choice
             into (cnt1) 
           ;          

           sql
            select
             count( *)
            from prvidopl
             where   1 = prvidopl.choice
             into (cnt2) 
           ;          

	
           StartNewVisual(vtRotateVisual, vfTimer+vfBreak,
                           ''#3'Идет выгрузка в xls. Ожидайте'#13#3,1);


           xlCreateExcelWithTemplate(Filepath,True);
           xlSetActiveSheet(1);
           onematr:=XlCreateMatrixEx(cnt1,8);

           CH:=word(0);
           row:=0;

           _loop prvidopl
           {
            inc(row);
            XlSTWriteToMatrixEx(onematr,row,1,Prvidopl.StrTabn);
            XlSTWriteToMatrixEx(onematr,row,2,Persons.fio);
            if getfirst KlVidopl=tsok
             XlSTWriteToMatrixEx(onematr,row,3,KlVidopl.vidoplp);

            XlDoWriteToMatrixEx(onematr,row,4,PrvidOpl.summa);
            XlSTWriteToMatrixEx(onematr,row,5,DateToStr(PrVidopl.datan,'DD.MM.YYYY'));
            XlSTWriteToMatrixEx(onematr,row,6,DateToStr(PrVidopl.datok,'DD.MM.YYYY'));
            XlSTWriteToMatrixEx(onematr,row,7,(SubStr(katpodr.kod,1,3)));
            if lschet.datuv<>date(0,0,0)
             XlSTWriteToMatrixEx(onematr,row,8,DateToStr(lschet.datuv,'DD.MM.YYYY'));
           }

           if xlWriteMatrixToExcelEx(onematr,2,1)=true
            {
             xlClearMatrix;
             xlFreeMatrix;
            }

           xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideH or xlInsideV,xlThin,xlContinuous,1,2,1,row+1,8);

           xlSetActiveSheet(2);

           CH:=word(1);
           row:=0;

           onematr:=XlCreateMatrixEx(cnt2,8);

           _loop prvidopl
           {
            inc(row);
            XlSTWriteToMatrixEx(onematr,row,1,Prvidopl.StrTabn);
            XlSTWriteToMatrixEx(onematr,row,2,Persons.fio);
            if getfirst KlVidUd=tsok
             XlSTWriteToMatrixEx(onematr,row,3,KlVidUd.vidudp);

            XlDoWriteToMatrixEx(onematr,row,4,PrvidOpl.summa);
            XlSTWriteToMatrixEx(onematr,row,5,DateToStr(PrVidopl.datan,'DD.MM.YYYY'));
            XlSTWriteToMatrixEx(onematr,row,6,DateToStr(PrVidopl.datok,'DD.MM.YYYY'));
            XlSTWriteToMatrixEx(onematr,row,7,(SubStr(katpodr.kod,1,3)));
            if lschet.datuv<>date(0,0,0)
             XlSTWriteToMatrixEx(onematr,row,8,DateToStr(lschet.datuv,'DD.MM.YYYY'));
           }

           if xlWriteMatrixToExcelEx(onematr,2,1)=true
            {
             xlClearMatrix;
             xlFreeMatrix;
            }

           xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideH or xlInsideV,xlThin,xlContinuous,1,2,1,row,8);


           xlSetActiveSheet(1);
         	xlKillExcel;

          StopVisual('',0);	
         }
 end;

end.

#include UserReport.vih

VipInterface UserReport_Claim_PersRepMeg Implements IUserReport;

Interface UserReport_Claim_PersRepMeg;

create view;

!-------------------------------------------------------------------------------
// Запуск отчета на выполнение при выборе его из списка отчетов
procedure Run;
begin
  RunInterfaceNoModal('GP_MegReeNachUder');
end;
!-------------------------------------------------------------------------------
// Наименование отчета в списке
function GetReportName: String;
begin
  GetReportName := 'Реестр межрасчетных начислений и удержаний';
end;
!-------------------------------------------------------------------------------
// Наименования групп, в которые входит отчет
// Группа n+1 делается подчиненной группе n
// В данном случае будет иерархия:
// [+] Группа 1
//     [+] Группа 2
//         Отчет 1
function GetGroupName (Level : Word) : String;
begin
//  GetGroupName := 'Реестр межрасчетных начислений и удержаний';
  case Level of
    1 : GetGroupName := 'Сводные отчеты по зарплате';
//    2 : GetGroupName := 'Группа 2';
  end;
end;
!-------------------------------------------------------------------------------
// Приоритет отчета - сортировка внутри группы выполняется сначала
// по приоритету, а затем по наименованию
function GetPriority : Integer;
begin
  GetPriority := 0;
end;
!-------------------------------------------------------------------------------
// ModuleID модулей, в которых будет виден отчет
// '*' - отчет будет виден в любом модуле
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'MENUZARP';
  end;
end;
!-------------------------------------------------------------------------------
end.
