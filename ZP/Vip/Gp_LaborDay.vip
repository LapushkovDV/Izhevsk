/*************************************************************************************************\
* Наименование: Отчет "Анализ табеля учета рабочего времени на дату"                              *
* Контур/Модуль: ЗП                                                                               *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2260         |16/04/18|Синяк Е.П.             |НПО Энергомаш                      *
\*************************************************************************************************/

#include IDepartmentValidator.obj

Interface Gp_TabelLaborOneDay;

 table struct reptable
 (
   strtabn : string[20]
  ,fio     : string[60]
  ,kodpodr : string[20]
  ,rejim   : word
  ,d       : double
  ,s       : string[5]
 )
 with index
 (
  in1=strtabn
 );

var DepMarker: TPtr;
var DepartmentValidator: IDepartmentValidator;

  create view
   var
    sday : date; 
    pday,pmes : byte;
    pyearn :  integer;
    filtrpodr : string;
    cntmrk,i : longint;
    stmt, stmt_str, curcount : longint;
    nrecn : comp ;
    XlRes : boolean;
    rowshp,row : longint ;


  as select
   *
  from reptable 
  ;

Procedure ClearQuery(Var liHandle: Longint);
{
  if (liHandle != 0)
  {
    sqlFreeStr(liHandle);
    liHandle := 0;
  }
}


Screen param;
  notablenavigation;
  fields

     sday        : noprotect ;
     FiltrPodr : protect,pickbutton;

 Buttons
   CmYes,Default;
   CmCancel;
<<

   `Формировать за` .@@@@@@@@@@


   `Подразделения` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@


    <.Сформировать.>     <.Отмена.>
>>

end;

  HandleEvent
   CmInit:{
            pyearn:=2018;
            sday :=cur_date;
            pday:=day(cur_date);
            pmes:=month(cur_date);
            FiltrPodr:='По всем';
            DepMarker := InitMarker('', 8, 1, 1);
          }


  CmPick: {

           Case curfield of
             #filtrPodr : {
  
                           if RunInterface('SelectSalaryDepartments', 12, comp(DepMarker),
                                               DepartmentValidator, ZeroDate, 0) = cmDefault
                           {
                            cntmrk:=GetMarkerCount(DepMarker);
                             if cntmrk>0 filtrPodr  :='выбрано '+DoubleToStr(cntmrk,'666 666 667')+' подразд.'
                                else filtrPodr  :='По всем';
                           }
                
                         }
            end;
             ReScanPanel(tnNotable);
          }

cmDelOnProtect:{

                Case curfield of
                 #filtrPodr : {  
                                ClearMarker(DepMarker);
                                filtrPodr  :='По всем';
                              }
                end;
                ReScanPanel(tnNotable);
               }

  CmCheckField : {
                  case curfield of
                   #sday  : { 
                             pday  :=day(sday);
                             pmes  :=month(sday);
                             pyearn:=year(sday);
                            }
                  end;
                 }

  CmYes :{

          if filtrPodr<>'По всем'
          {

            sqlDropTmpTable('selpodr');
            sqlAddStr(stmt_str, 'TABLE selpodr ( nrecpodr   : Comp ) WITH INDEX (selpodr1 = nrecpodr);');
            sqlCreateTmpTable(stmt_str,ctmDynamicIndex);
            sqlFreeStr(stmt_str);
            stmt_str:=0;


            for(
                i:=0;
                i<GetMarkerCount(DepMarker);
                inc(i)
               )

           {
             GetMarker(DepMarker,i,nrecn);
             ClearQuery(stmt);
             sqlAddStr(stmt, 'INSERT INTO selpodr');
             sqlAddStr(stmt, '(');
             sqlAddStr(stmt, '  nrecpodr');
             sqlAddStr(stmt, ')');
             sqlAddStr(stmt, 'VALUES');
             sqlAddStr(stmt, '(');
             sqlAddStr(stmt, '  #comp(' + nrecn + ')');
             sqlAddStr(stmt, ')');
             sqlExecDirect(stmt);
           }  


          }


           MtClear(#reptable,mfNormal);

           stmt := sqlAllocStmt;
		   sqlAddStr(stmt_str, 'select ');
		   sqlAddStr(stmt_str, '    l.strtabn         ');
		   sqlAddStr(stmt_str, '   ,Coalesce(p.fio,'+''''+'не определено'+''''+') as fio');
		   sqlAddStr(stmt_str, '   ,Coalesce(Substring(podr.kod,1,3),'+''''+'не определено'+''''+') as kodpodr');
		   sqlAddStr(stmt_str, '   ,l.rejim       ');
		   sqlAddStr(stmt_str, '   ,l.daychf['+string(pday)+'] as d');
		   sqlAddStr(stmt_str, '   ,l.days['+string(pday)+'] as s');
		   sqlAddStr(stmt_str, 'from lstab l left join persons p on l.tperson=p.nrec');
    	   sqlAddStr(stmt_str, '               inner join katpodr podr on l.cex=podr.nrec');
!    	   sqlAddStr(stmt_str, '               inner join klrejim rej on l.regim=rej.rejim');
           if filtrpodr<>'По всем'
    		   sqlAddStr(stmt_str, '               inner join selpodr on l.cex=selpodr.nrecpodr');

		   sqlAddStr(stmt_str, '        where l.yearn=? and l.mesn=? ');
           sqlPrepare(stmt,stmt_str);
       	   sqlbindparam(stmt,1,pyearn);
       	   sqlbindparam(stmt,2,pmes);

   		   sqlExecute(stmt);

 		   if (sqlFetchInto(stmt,#reptable) != tsOk)
			        Message('not tsOk select (');
			sqlFreeStmt(stmt);
            sqlFreeStr(stmt);


       	   curcount:=Recordsintable(#reptable);


                XlRes := xlCreateExcel((''), true);
                if (XlRes)
                XlRes := xlIsExcelValid;
                 if (not XlRes)
                 Message('не иннициализирован excel');

                 row:=1;
                 xlSetCellStringValue('Табель за '+DateToStr(sday,'DD/MM/YYYY'),1,1,1,1);
                 inc(row);


                 rowshp:=row+1;
                 xlSetCellStringValue('Табельный',row,1,row,1);
                 xlSetColumnWidth(11,row,1,row,1);

                 xlSetCellStringValue('Фамилия',row,2,row,2);
                 xlSetColumnWidth(45,row,2,row,2);

                 xlSetCellStringValue('КодПодр',row,3,row,3);
                 xlSetColumnWidth(7,row,3,row,3);

                 xlSetCellStringValue('КодРежим',row,4,row,4);
                 xlSetColumnWidth(7,row,4,row,4);

                 xlSetCellStringValue('Метка',row,5,row,5);
                 xlSetColumnWidth(5,row,5,row,5);

                 xlSetCellStringValue('Дата',row,6,row,6);
                 xlSetColumnWidth(10,row,6,row,6);

                 xlSetFontStyle(1, row, 1, row, 6);

                _loop reptable
                {
                 inc(row);
                 xlSetCellStringValue(chr(39)+reptable.strtabn,row,1,row,1);
                 xlSetCellStringValue(reptable.fio,row,2,row,2);
                 xlSetCellStringValue(reptable.kodpodr,row,3,row,3);
                 xlSetCellStringValue(reptable.rejim,row,4,row,4);
                 xlSetCellStringValue(reptable.s,row,5,row,5);
                 xlSetCellStringValue(DateTostr(sday,'DD.MM.YYYY'),row,6,row,6);
                 xlSetCellStringValue(1,row,7,row,7);
                }


               xlFreeze(rowshp,1);
               xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideH or xlInsideV,xlThin,xlContinuous,1,rowshp-1,1,row,7);

               xlKillExcel;

         }
 end;
end.


#include UserReport.vih

VipInterface UserReport_Claim_TabelLaborOneDay Implements IUserReport;

Interface UserReport_Claim_TabelLaborOneDay;

create view;

!-------------------------------------------------------------------------------
// Запуск отчета на выполнение при выборе его из списка отчетов
procedure Run;
begin
  RunInterfaceNoModal('Gp_TabelLaborOneDay');
end;
!-------------------------------------------------------------------------------
// Наименование отчета в списке
function GetReportName: String;
begin
  GetReportName := 'Анализ табеля учета рабочего времени на дату';
end;
!-------------------------------------------------------------------------------
// Наименования групп, в которые входит отчет
// Группа n+1 делается подчиненной группе n
// В данном случае будет иерархия:
// [+] Группа 1
//     [+] Группа 2
//         Отчет 1
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := '';
  case Level of
    1 : GetGroupName := 'Отчеты по табелям';
  end;
end;
!-------------------------------------------------------------------------------
// Приоритет отчета - сортировка внутри группы выполняется сначала
// по приоритету, а затем по наименованию
function GetPriority : Integer;
begin
  GetPriority := 0;
end;
!-------------------------------------------------------------------------------
// ModuleID модулей, в которых будет виден отчет
// '*' - отчет будет виден в любом модуле
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;
!-------------------------------------------------------------------------------
end.
