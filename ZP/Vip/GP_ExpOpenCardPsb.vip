procedure Run;
var kol, i    : integer = 0;
    cPersNRec : comp;
    cAddrNeed : comp;
{
  sDefaultPhone := '7 (000) 0000000';
  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);
  InitRus2Lat;
  InitShortKLAdr;
  if (VCommonFiltr.GetPsnCount = 0)
    VCommonFiltr.SelectAllPsn;

  mPsn := InitMarker('#(GPInt)_PSN_'+UserName(),8,200,100);
  mPsn := VCommonFiltr.GetPersonsMarker;
  kol  := GetMarkerCount(mPsn);
  RestartVisual('Формирование таблицы фильтров.',1);
  while i < kol
  {
    GetMarker(mPsn, i++, cPersNRec);
    insert ttPerFlt set ttPerFlt.cRecPers := cPersNRec;
    If (not NextVisual) break;
  }
  
  RestartVisual('Формирование данных для выгрузки.',1);
  if IsValid(#ttPerFlt)
  _loop ttPerFlt
  {
    if (not NextVisual) break;  
    if IsValid(#Persons)
    {
      ClearBuffer(#ttResStr);
      cAddrNeed         := Persons.PasspAddr;

      ttResStr.cRecPers := Persons.nRec;
      ttResStr.sTabNmb  := Persons.strtabn;

      ttResStr.sFIO     := Persons.FIO ;
      ttResStr.sPol     := if(Persons.Sex = 'М', 1, 2);
      ttResStr.sF       := iStrFunc.Get_LastName (Persons.FIO);
      ttResStr.sI       := iStrFunc.Get_FirstName(Persons.FIO);
      ttResStr.sO       := iStrFunc.GetPatronymic(Persons.FIO);
      ttResStr.sAdr     := iAdrFunc.GetFullAddressInd(Persons.PasspAddr);
      ttResStr.dBorn    := DateToStr(Persons.BornDate, 'DD.MM.YYYY');
      ttResStr.sBorn    := iAdrFunc.GetFullAddressInd(Persons.BornAddr);
      ttResStr.sTelMob  := sRepPhoneList('моб');
      ttResStr.sTelDom  := sRepPhoneList('дом');
      ttResStr.sTelRab  := sRepPhoneList('раб');
      ttResStr.sILat    := sRus2Lat(ttResStr.sI);
      ttResStr.sFLat    := sRus2Lat(ttResStr.sF);
      if IsValid(#Passports)
      {
        ttResStr.sSerPass := Passports.Ser;
        ttResStr.sNomPass := Passports.Nmb;
        ttResStr.sTypPass := '21';
        ttResStr.sPodrPass:= Passports.GivenPodr;
        ttResStr.sKtoPass := Passports.GivenBy;
        ttResStr.dKtoPass := DateToStr(Passports.GivenDate, 'DD.MM.YYYY');
      }
      if IsValid(#appointments)
      {
        ttResStr.sAppTaxRate := Appointments.TaxRate;
        if IsValid(#app)
        {
           ttResStr.sAppoint := app.Name;
        }
      }
      if IsValid(#Gr)
      {
        ttResStr.sGrazhd  := Gr.CATDATA;
      }
      ttResStr.sEMail   := sRetEMailList('электронная почта');
      ttResStr.sAppDate := DateToStr(Persons.AppDate, 'DD.MM.YYYY');;
      insert current ttResStr;
    }
  }
  if isvalid(#ttResStr)
      {
    //    00523 - код, присвоенный организации,
    //2 - признак операции (файл на зачисление),
    //MMDDYYYY
    sFileName := '005232'+DateToStr(Cur_Date, 'MMDD')+'01';
    sFullName := GetDefaultUserPath + '\'+sFileName+'.xlsx';
    xlCreateExcel(sFullName, TRUE);
    lRB  := 1;
    lDB  := lRB + 1;
    lCB  := 1;
    lCE  := 1;
    iNPP := 1;
    RestartVisual('Выгрузка данных.',1);
    
    #define FrmHd  lRB,  lCE,  lRB,  lCE
    iOut.Header1Row('№ строки',#FrmHd); lCE++;
    iOut.Header1Row('Тип карты',#FrmHd); lCE++;
    iOut.Header1Row('Табельный номер',#FrmHd); lCE++;
    iOut.Header1Row('Фамилия',#FrmHd); lCE++;
    iOut.Header1Row('Имя',#FrmHd); lCE++;
    iOut.Header1Row('Отчество',#FrmHd); lCE++;
    iOut.Header1Row('Пол держателя карты(муж- 1, жен -2)',#FrmHd); lCE++;
    iOut.Header1Row('Эмбоссируемые данные, имя',#FrmHd); lCE++;
    iOut.Header1Row('Эмбоссируемые данные, фамилия',#FrmHd); lCE++;
    iOut.Header1Row('Кодовое слово',#FrmHd); lCE++;
    iOut.Header1Row('Дата рождения',#FrmHd); lCE++;
    iOut.Header1Row('Место рождения',#FrmHd); lCE++;
    iOut.Header1Row('Гражданство',#FrmHd); lCE++;
    iOut.Header1Row('Документ, удостоверяющий личность, Код',#FrmHd); lCE++;
    iOut.Header1Row('Документ, удостоверяющий личность, Серия, номер)',#FrmHd); lCE++;
    iOut.Header1Row('Документ, удостоверяющий личность, Когда выдан',#FrmHd); lCE++;
    iOut.Header1Row('Документ, удостоверяющий личность, Кем выдан',#FrmHd); lCE++;
    iOut.Header1Row('Документ, удостоверяющий личность, Код подразделения',#FrmHd); lCE++;
    iOut.Header1Row('Миграционная карта, Серия номер',#FrmHd); lCE++;
    iOut.Header1Row('Миграционная карта, Дата выдачи',#FrmHd); lCE++;
    iOut.Header1Row('Миграционная карта, Дата окончания',#FrmHd); lCE++;
    iOut.Header1Row('Документ на право пребывания на территории РФ, Серия Номер',#FrmHd); lCE++;
    iOut.Header1Row('Документ на право пребывания на территории РФ, Дата выдачи',#FrmHd); lCE++;
    iOut.Header1Row('Документ на право пребывания на территории РФ, Дата окончания',#FrmHd); lCE++;
    iOut.Header1Row('Адрес регистрации в РФ (в соответствии с форматом КЛАДР)',#FrmHd); lCE++;
    iOut.Header1Row('Адрес электронной почты',#FrmHd); lCE++;
    iOut.Header1Row('Рабочий телефон',#FrmHd); lCE++;
    iOut.Header1Row('Домашний телефон',#FrmHd); lCE++;
    iOut.Header1Row('Мобильный телефон',#FrmHd); lCE++;
    iOut.Header1Row('Должность',#FrmHd); lCE++;
    iOut.Header1Row('Место доставки карт для сетевых и федеральных проектов',#FrmHd); lCE++;
    iOut.Header1Row('Дата принятия на работу',#FrmHd); lCE++;
    iOut.Header1Row('Должностной оклад',#FrmHd);  lCE++;

    _loop ttResStr iNPP++; 
    if (not xlCreateMatrix(iNPP+1,lCE))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    xlSetNumberFormat('@',lRB, 1,iNPP+1, lCE);

    iNPP:=1;
    lDE :=1;

    #define FrmCl lDE,lCE++
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;
      lCE := 1;
      xlStWriteToMatrix(#FrmCl,iNPP++              );//  iOut.Header1Row('Номер',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,'2.0'               );//  iOut.Header1Row('Тип карты',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sTabNmb    );//  iOut.Header1Row('Табельный номер',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sF         );//  iOut.Header1Row('Фамилия',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sI         );//  iOut.Header1Row('Имя',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sO         );//  iOut.Header1Row('Отчество',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sPol       );//  iOut.Header1Row('Пол держателя карты(муж- 1, жен -2)',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sILat      );//  iOut.Header1Row('Эмбоссируемые данные, имя',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sFLat      );//  iOut.Header1Row('Эмбоссируемые данные, фамилия',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,''                  );//  iOut.Header1Row('Кодовое слово',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.dBorn      );//  iOut.Header1Row('Дата рождения',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sBorn      );//  iOut.Header1Row('Место рождения',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,'643'               );//  iOut.Header1Row('Гражданство',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,'21'                );//  iOut.Header1Row('Документ, удостоверяющий личность, Код',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sSerPass + ' ' + ttResStr.sNomPass);//  iOut.Header1Row('Документ, удостоверяющий личность, Серия, номер)',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.dKtoPass   );//  iOut.Header1Row('Документ, удостоверяющий личность, Когда выдан',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sKtoPass   );//  iOut.Header1Row('Документ, удостоверяющий личность, Кем выдан',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sPodrPass  );//  iOut.Header1Row('Документ, удостоверяющий личность, Код подразделения',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,''                  );//  iOut.Header1Row('Миграционная карта, Серия номер',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,''                  );//  iOut.Header1Row('Миграционная карта, Дата выдачи',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,''                  );//  iOut.Header1Row('Миграционная карта, Дата окончания',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,''                  );//  iOut.Header1Row('Документ на право пребывания на территории РФ, Серия Номер',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,''                  );//  iOut.Header1Row('Документ на право пребывания на территории РФ, Дата выдачи',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,''                  );//  iOut.Header1Row('Документ на право пребывания на территории РФ, Дата окончания',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sAdr       );//  iOut.Header1Row('Адрес регистрации в РФ (в соответствии с форматом КЛАДР)',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sEMail     );//  iOut.Header1Row('Адрес электронной почты',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,'7 (495) 2869206'   );//  iOut.Header1Row('Рабочий телефон',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sTelDom    );//  iOut.Header1Row('Домашний телефон',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sTelMob    );//  iOut.Header1Row('Мобильный телефон',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sAppoint   );//  iOut.Header1Row('Должность',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,''                  );//  iOut.Header1Row('Место доставки карт для сетевых и федеральных проектов',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sAppDate   );//  iOut.Header1Row('Дата принятия на работу',#FrmHd); lCE++;
      xlStWriteToMatrix(#FrmCl,ttResStr.sAppTaxRate);//  iOut.Header1Row('Дата принятия на работу',#FrmHd); lCE++;
      lDE++;
    }
    RestartVisual('Вставка данных в Excel.',1);
    if (not xlWriteMatrixToExcel(2,1))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;
    xlAutoFit(lRB,lCB,lDE,lCE);
    xlSetSheetName(1, 'РЕЕСТР');

    xlKillExcel;
  }
  else
  {
    message('Нет данных для формирования отчета!');
  }
  StopVisual;
}

embedded ComFiltrEmbedded 'Фильтры' interface VCommonFiltr;
  show (,,85,6);
end
Screen s2(,,sci1Esc);
  show (,7,85,8);
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
  <<
     <. ~С~формировать .>                         <. ~З~акрыть .>
  >>
end;

handleevent
  cmInit:
  {
    delete all from ttPerFlt;
    delete all from ttResStr;
    MadeReport:= false;
  }
  cmOk:
  {
    Run;
    MadeReport:= true;
    VCommonFiltr.IntClose(MadeReport);
    VCommonFiltr.StoreAllParams;
    Notify(cmEvaluateAndModify, 0);
    DoneMarker(mPsn, '#(GPInt)_PSN_' + UserName());
    closeinterface(cmDefault);
  }
  cmCancel:
  {
    VCommonFiltr.IntClose(MadeReport);
    DoneMarker(mPsn, '#(GPInt)_PSN_' + UserName());
  }
end;
end.



VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;
Procedure Run;                                  {runinterface(#(GPInt));}
Function  GetReportName               : String; {GetReportName := '#(GPNam) (ЭМ)';}
Function  GetGroupName (Level : Word) : String; {Level:=Level;GetGroupName := '';}
function  GetPriority                 : Integer;{GetPriority := 3;}
function  VisibleInModule(Ind : Byte) : String; {Ind:=Ind; VisibleInModule := 'STAFFMAINMENU';} // для Пушковой Перенесено из MENUZARP';}
End.
