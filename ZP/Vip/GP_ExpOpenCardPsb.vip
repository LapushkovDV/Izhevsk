#include UserReport.vih
#include ComFiltr.vih
#include CatFunc.vih
#include AdrFunc.vih
#include StrFunc.vih
#include GP_XlOutExt.vih


#define GPInt GP_ExpOpenCardPsb // #(GPInt)
#define GPNam Выгрузка данных для Промсвязьбанка // #(GPNam)

Interface #(GPInt) '#(GPNam) (ЭМ)' EscClose, Gray;
  show (,,86,9);

const
#include Excel.inc;
end;

table struct ttPerFlt // для фильтра по персоналу
(
  cRecPers : comp
)
with index
(
  ttPerFlt01  = cRecPers
);

table struct ttResStr // статический набор данных
(
  nRec       : comp
, cRecPers   : comp
, sTabNmb    : string
, sFIO       : string
, sF         : string
, sI         : string
, sO         : string
, sPol       : string
, sAdr       : string
, sTypPass   : string
, sSerPass   : string
, sNomPass   : string
, sPodrPass  : string
, sKtoPass   : string
, dKtoPass   : string
, dBorn      : string
, sBorn      : string
, sGrazhd    : string
, sTelDom    : string
, sTelMob    : string
, sTelRab    : string
, sILat      : string
, sFLat      : string
, sEMail     : string
, sAppoint   : string
, sAppDate   : string
, sAppTaxRate: string
)
with index
(
  ttResStr00 = nRec(Surrogate)
, ttResStr01 = cRecPers
, ttResStr02 = sFIO
);

var
  VCommonFiltr  : CommonFiltr; // Для встраивания фильтра по подразделениям / сотрудникам
  MadeReport    : boolean;
  mPsn          : TPtr;
  iCatFunc      : CatalogsFunctions;
  iAdrFunc      : AddressFunc;
  iStrFunc      : StringFunctions;
  iOut          : GP_XlOutExt;
  sFullName,
  sFileName,
  sDefaultPhone : string;
  lRB, lRE,
  lCB, lCE,
  lDB, lDE,
  iNPP          : integer = 0;
  sR, sL        : array[1..33] of string[4];
  sShKl         : array [1..67] of string;
  sShKlGPB      : array [1..67] of string;

create view
from
  Persons
, Passports
, Passports PassINN
, Passports PassSNILS
, Communications
, ttPerFlt
, ttResStr
//, STerr
, appointments
, catalogs app
, catalogs Gr
where
((
    ttPerFlt.cRecPers == Persons.nRec
and Persons.Gr   == Gr.nrec
and Persons.PasspRus  == Passports.nRec
and Persons.nRec      == Communications.Person
and Persons.nrec == PassINN.person 
and 505          == PassINN.syscode
and Persons.nrec == PassSNILS.person 
and 501          == PassSNILS.syscode
and persons.appointcur == appointments.nrec
and appointments.post == app.nrec
))
;

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

function formatPhone(sAny : string) : string;
{
  result := sAny;
  result := Replace(result, '+', '');
  result := Replace(result, '-', '');
  result := Replace(result, '(', ' (');
  result := Replace(result, ')', ') ');
}

function sRepPhoneList(sAny : string) : string;
{
  result:='';
  if isvalid(#Communications)
  _loop Communications
    if Pos(sAny,LoCase(iCatFunc.GetCatalogsName(Communications.ComType)))<>0
      result+=if((Trim(result)<>''),'; ','')+formatPhone(Communications.Addr);

  if(Trim(result) = '')
    result:= sDefaultPhone;
}


function sRetEMailList(sAny : string) : string;
{
  result:='';
  if isvalid(#Communications)
  _loop Communications
    if ( Pos(sAny, LoCase(iCatFunc.GetCatalogsName(Communications.ComType))) <> 0 )
      result += if(Trim(result) <> '', '; ', '') + Communications.EMail;
}

procedure InitRus2Lat;
{
  sR[ 1] := 'А';  sL[ 1] :=  'A';
  sR[ 2] := 'Б';  sL[ 2] :=  'B';
  sR[ 3] := 'В';  sL[ 3] :=  'V';
  sR[ 4] := 'Г';  sL[ 4] :=  'G';
  sR[ 5] := 'Д';  sL[ 5] :=  'D';
  sR[ 6] := 'Е';  sL[ 6] :=  'E';
  sR[ 7] := 'Ё';  sL[ 7] :=  'E';
  sR[ 8] := 'Ж';  sL[ 8] :=  'ZH';
  sR[ 9] := 'З';  sL[ 9] :=  'Z';
  sR[10] := 'И';  sL[10] :=  'I';
  sR[11] := 'Й';  sL[11] :=  'I';
  sR[12] := 'К';  sL[12] :=  'K';
  sR[13] := 'Л';  sL[13] :=  'L';
  sR[14] := 'М';  sL[14] :=  'M';
  sR[15] := 'Н';  sL[15] :=  'N';
  sR[16] := 'О';  sL[16] :=  'O';
  sR[17] := 'П';  sL[17] :=  'P';
  sR[18] := 'Р';  sL[18] :=  'R';
  sR[19] := 'С';  sL[19] :=  'S';
  sR[20] := 'Т';  sL[20] :=  'T';
  sR[21] := 'У';  sL[21] :=  'U';
  sR[22] := 'Ф';  sL[22] :=  'F';
  sR[23] := 'Х';  sL[23] :=  'KH';
  sR[24] := 'Ц';  sL[24] :=  'TS';
  sR[25] := 'Ч';  sL[25] :=  'CH';
  sR[26] := 'Ш';  sL[26] :=  'SH';
  sR[27] := 'Щ';  sL[27] :=  'SCSH';
  sR[28] := 'Ы';  sL[28] :=  'Y';
  sR[29] := 'Ъ';  sL[29] :=  'IE';
  sR[30] := 'Ь';  sL[30] :=  '';
  sR[31] := 'Э';  sL[31] :=  'E';
  sR[32] := 'Ю';  sL[32] :=  'IU';
  sR[33] := 'Я';  sL[33] :=  'IA';
}

function sRus2Lat(sAny : string) : string;
Var
  wI: word;
{
  if sAny <> ''
    sAny := UpCase(sAny);
    for(wI:=1; wI<=33; wI++) sAny:=Replace(sAny,sR[wI],sL[wI]);
  result:=sAny;
}
