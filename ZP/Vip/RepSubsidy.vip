    MysqlAddStr(strID, ' );                     ');

    sqlDropTmpTable('tmpPropsNg');

    if sqlCreateTmpTable(strID, ctmNormal) <> tsOk
    {
      Message('éË®°™† ·Æß§†≠®Ô ¢‡•¨•≠≠Æ© ‚†°´®ÊÎ (CreateTmpProps) ' + 'tmpPropsNg', error);
    }

    strID := 0;
    sqlFreeStr(strID);

    SetVisualHeader('é°‡†°Æ‚™† Ø•‡•¢Æ§‚•™ß†™†ß ØÆ ´/· ® Åì');

    MysqlAddStr(strID, ' insert tmpPropsNg (s, clsch, sMnp, sVplan)                                                                         ');
    MysqlAddStr(strID, ' select                                                                                                             ');
    MysqlAddStr(strID, '   sum(pvz.sumper)  as s                                                                                            ');
    MysqlAddStr(strID, ' , pvz.clsch        as clsch                                                                                        ');
    MysqlAddStr(strID, ' , coalesce(mnplan.number, '''')    as smnp                                                                                         ');
    MysqlAddStr(strID, ' , coalesce(vplan.name, '''')       as svplan                                                                                       ');
    MysqlAddStr(strID, ' from perevodtekzakaz pvz                                                                                           ');
    MysqlAddStr(strID, ' left join mnplan on pvz.ckaud[1] = mnplan.nrec                                                                     ');
    MysqlAddStr(strID, ' left join vplan on mnplan.cvplan = vplan.nrec                                                                      ');
    MysqlAddStr(strID, ' left join buhschet bs on mnplan.canval2 = bs.nrec                                                                  ');
    MysqlAddStr(strID, ' left join katpodr on pvz.cex = katpodr.nrec                                                                        ');
    MysqlAddStr(strID, ' left join attrnam an on 31015 = an.wtable                                                                          ');
    MysqlAddStr(strID, '                          and ''Å†≠™Æ¢·™®• ·Á•‚†'' = an.name                                                        ');
    MysqlAddStr(strID, ' left join attrval av on 31015 = av.wtable                                                                          ');
    MysqlAddStr(strID, '                          and an.nrec = av.cattrnam                                                                 ');
    MysqlAddStr(strID, '                          and vplan.nrec = av.crec                                                                  ');
    MysqlAddStr(strID, ' where     pvz.yearn = ' + Year(TmpDates.dBeg) + '                                                                  ');
    MysqlAddStr(strID, '       and substring(bs.schet, 2, 2) = ''20''                                                                       ');
    MysqlAddStr(strID, '       and substring(katpodr.kod, 1, 3) not in (''446'', ''957'')                                                   ');
    MysqlAddStr(strID, '       and ((coalesce(av.vcomp, #comp(0h)) = #comp(0h)) or (coalesce(mnplan.cvplan, #comp(0h)) = #comp(0h)))        ');
