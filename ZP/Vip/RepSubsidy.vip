              (InStr('áÄ êÄÅéíõ èé êÖåéçíì', UpCase(TmpRepAgr.sNazna1)) <> 0) or
              (InStr('çÑë 20% áÄ èêÖÑéëíÄÇãÖçàÖ', UpCase(TmpRepAgr.sNazna1)) <> 0) or
              (InStr('êä-îàçÄçë', UpCase(TmpRepAgr.sOrgPol)) <> 0)

        ) then
        {
          Continue;
        }

        if (_wTypeRun <= 1) then
        {
          if (_wIskl = 1) then
          {
            if ((Month(TmpDates.dEnd) = Month(_dEnd)) and (Year(TmpDates.dEnd) = Year(_dEnd)) and ( Month(Add_Months(TmpDates.dEnd, 1)) = Month(TmpRepAgr.dPlat) )) then
            {
