Table Struct TmpDates
(
    cPeriod : comp
  , sPeriod : string
  , dBeg    : date
  , dEnd    : date
  , dZpExc  : date
  , dZpInc  : date
)
With Index
(
    i01 = cPeriod
);

Table Struct TmpRep
(
    s          : double
  , splpor     : string
  , skazplpor  : string
  , dPlat      : date
  , sBankPlat  : string
  , sOrgPol    : string
  , sBankPol   : string
  , sNazna1    : string
  , sNazna2    : string
  , sNazna3    : string
  , sNazna4    : string
  , sPodr      : string
  , sbs        : string
  , stabn      : string
  , sfio       : string
  , cPeriod    : comp
  , sPeriod    : string
)
With Index
(
    i01 = cPeriod
  , i02 = cPeriod + skazplpor
  , i03 = splpor + skazplpor + dPlat + sBankPlat + sOrgPol + sBankPol + sNazna1 + sNazna2 + sNazna3 + sNazna4 + sPodr + stabn + cPeriod
  , i04 = sPodr
);

Table Struct TmpRepPz
(
    s          : double
  , splpor     : string
  , skazplpor  : string
  , dPlat      : date
  , sBankPlat  : string
  , sOrgPol    : string
  , sBankPol   : string
  , sNazna1    : string
  , sNazna2    : string
  , sNazna3    : string
  , sNazna4    : string
  , sPodr      : string
  , sMnp       : string
  , svPlan     : string
  , sbs        : string
  , stabn      : string
  , sfio       : string
  , cPeriod    : comp
  , sPeriod    : string
)
With Index
(
    i01 = cPeriod
  , i02 = cPeriod + skazplpor
  , i03 = splpor + skazplpor + dPlat + sBankPlat + sOrgPol + sBankPol + sNazna1 + sNazna2 + sNazna3 + sNazna4 + sPodr + stabn + cPeriod
  , i04 = sPodr
);

Table Struct TmpRepPv
(
    sbs      : string
  , cPeriod  : comp
  , sPeriod  : string
  , nachsum  : double
  , totsum   : double
  , s5       : double
  , s11      : double
  , s12      : double
  , s2       : double
  , s8       : double
  , s3       : double
  , s0       : double
  , s5i      : double
  , s11i     : double
  , s12i     : double
  , s2i      : double
  , s8i      : double
  , s3i      : double
)
With Index
(
    i01 = cPeriod
);

Table Struct TmpRepAgr
(
    splpor     : string
  , skazplpor  : string
  , dPlat      : date
  , sBankPlat  : string
  , sOrgPol    : string
  , sBankPol   : string
  , sNazna1    : string
  , sNazna2    : string
  , sNazna3    : string
  , sNazna4    : string
  , sPodr      : string
  , sbs        : string
  , stabn      : string
  , sfio       : string
  , cPeriod    : comp
  , sPeriod    : string
  , s          : array[1..10] of double
)
With Index
(
    i01 = splpor + skazplpor + dPlat + sBankPlat + sOrgPol + sBankPol + sNazna1 + sNazna2 + sNazna3 + sNazna4 + sPodr + stabn + cPeriod
  , i02 = cPeriod + skazplpor
);

Table Struct TmpReestrR
(
    s           : double
  , sPodr       : string
  , sPodrName   : string
)
With index
(
    i01 = sPodr
);

Create View rView

var
  _log                : string = '';
  _FileName           : string = 'ëØ‡†¢™† Æ ‡†·Ø‡•§•´•≠®®';
  _dBeg, _dEnd        : date;
  _wTypeRun, _wDetail : word;
  _wIskl : word = 0;
  NoRowReal : word = 4;
As
Select
  1
From
  FpPeriod
, KatPodr
, TmpDates
, TmpRep
, TmpRepPz
, TmpRepPv
, TmpRepAgr
, TmpReestrR
;

Procedure MyLog(_str: string);
{
  if _log = '' then _log := 'HierRep' + DateToStr(cur_date,'_YYYYMMDD') + timetostr(cur_time,'_HHMMSS') + '.log';
  LogStrToFile(_log, _str);
}

Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  MyLog('sql: ' + add_query_str);
}

Procedure SetCellFormula(sFormula: string; aRow, aCol: longint);  //Á•·‚≠Æ ·Ø•‡ „ ™Æ£Æ-‚Æ
{
  xlSetCellFormula(sFormula, aRow, aCol, aRow, aCol);
}

Procedure MakeDates();
{
  Delete All TmpDates;
  var nDate : date = Date(0, 0, 0);
  _Loop FpPeriod where ((4h == FpPeriod.ctPer)) and _dBeg <= FpPeriod.dBeg and _dEnd >= FpPeriod.dEnd
  {
    nDate := Add_Months(Date(12, Month(FpPeriod.dBeg), Year(FpPeriod.dBeg)), 1);

    ClearBuffer(#TmpDates);
      TmpDates.cPeriod := FpPeriod.nRec;
      TmpDates.sPeriod := FpPeriod.Name;
      TmpDates.dBeg    := FpPeriod.dBeg;
      TmpDates.dEnd    := FpPeriod.dEnd;
      TmpDates.dZpExc  := if(Day_Of_Week(Date(12, Month(FpPeriod.dBeg), Year(FpPeriod.dBeg))) = 7,
                              Date(10, Month(FpPeriod.dBeg), Year(FpPeriod.dBeg)),
                              if(Day_Of_Week(Date(12, Month(FpPeriod.dBeg), Year(FpPeriod.dBeg))) = 6,
                                  Date(11, Month(FpPeriod.dBeg), Year(FpPeriod.dBeg)),
                                  Date(12, Month(FpPeriod.dBeg), Year(FpPeriod.dBeg)))
                          );
      TmpDates.dZpInc  := if(Day_Of_Week(Date(12, Month(nDate), Year(nDate))) = 7,
                              Date(10, Month(nDate), Year(nDate)),
                              if(Day_Of_Week(Date(12, Month(nDate), Year(nDate))) = 6,
                                  Date(11, Month(nDate), Year(nDate)),
                                  Date(12, Month(nDate), Year(nDate)))
                          );
    Insert Current TmpDates;
  }
}

Procedure MySqlJoinPlPorKazna(qStr: longint);
{
  MysqlAddStr(qStr, ' outer apply (');
  MysqlAddStr(qStr, '   select top 1');
  MysqlAddStr(qStr, '     PlPorK.NRec');
  MysqlAddStr(qStr, '   from PlPor PlPorK');
  MysqlAddStr(qStr, '   left join katbank kbstrInner on plpork.cbankpol = kbstrInner.nrec');
  MysqlAddStr(qStr, '   where plporK.cbankplat in (#comp(000A0000000001DEh), #comp(000A0000000001DFh), #comp(000A000000003C11h))');
  MysqlAddStr(qStr, '     and (                                                                                                                              ');
  MysqlAddStr(qStr, '       plpor.datvip <= plporK.datvip and plporK.datvip <= #date(' + Day(TmpDates.dEnd) + ', ' + Month(TmpDates.dEnd) + ', ' + Year(TmpDates.dEnd) + ')');
  MysqlAddStr(qStr, '       or (plporK.datvip = #date(' + Day(TmpDates.dZpInc) + ', ' + Month(TmpDates.dZpInc) + ', ' + Year(TmpDates.dZpInc) + '))     ');
  MysqlAddStr(qStr, '     )                                                                                                                              ');
  MysqlAddStr(qStr, '     and (plporK.datvip <> #date(' + Day(TmpDates.dZpExc) + ', ' + Month(TmpDates.dZpExc) + ', ' + Year(TmpDates.dZpExc) + ') or    ');
  MysqlAddStr(qStr, '          plpork.nodok in (                                                                                                         ');
  MysqlAddStr(qStr, '                         ''7996'', ''7997'', ''8017'', ''8013'', ''8015''                                                           ');
  MysqlAddStr(qStr, '                       , ''8016'', ''8018'', ''8019'', ''8007'', ''8004''                                                           ');
  MysqlAddStr(qStr, '                       , ''8001'', ''7991'', ''7988'', ''8743'', ''8859''                                                           ');
  MysqlAddStr(qStr, '                       , ''8873'', ''8854'', ''8855'', ''8856'', ''8857''                                                           ');
  MysqlAddStr(qStr, '                       , ''8858'', ''8863'', ''8879'', ''8882'', ''8883''                                                           ');
  MysqlAddStr(qStr, '                       , ''8886'', ''8890''))                                                                                       ');
  MysqlAddStr(qStr, '     and abs(plpor.sumplat - plporK.sumplat) < 0.01                                                                                 ');
  MysqlAddStr(qStr, '     and plporK.tidk <> 1');
  MysqlAddStr(qStr, '     and kbstr.name = kbstrInner.name');
  MysqlAddStr(qStr, '   order by plporK.datvip');
  MysqlAddStr(qStr, ' ) KaznPlPor');
  MysqlAddStr(qStr, ' left join plpor plporkazna on KaznPlPor.NRec = plporkazna.nrec                                                                           ');
}

Procedure AgregateMainRep();
{
  _Loop TmpRep
  {
    if (getFirst FastFirstRow TmpRepAgr where ((
                                                  TmpRep.splpor     == TmpRepAgr.splpor      and
                                                  TmpRep.skazplpor  == TmpRepAgr.skazplpor   and
                                                  TmpRep.dPlat      == TmpRepAgr.dPlat       and
                                                  TmpRep.sBankPlat  == TmpRepAgr.sBankPlat   and
                                                  TmpRep.sOrgPol    == TmpRepAgr.sOrgPol     and
                                                  TmpRep.sBankPol   == TmpRepAgr.sBankPol    and
                                                  TmpRep.sNazna1    == TmpRepAgr.sNazna1     and
                                                  TmpRep.sNazna2    == TmpRepAgr.sNazna2     and
                                                  TmpRep.sNazna3    == TmpRepAgr.sNazna3     and
                                                  TmpRep.sNazna4    == TmpRepAgr.sNazna4     and
                                                  TmpRep.sPodr      == TmpRepAgr.sPodr       and
                                                  TmpRep.stabn      == TmpRepAgr.stabn       and
                                                  TmpRep.cPeriod    == TmpRepAgr.cPeriod          )) <> tsOk ) then
    {
      ClearBuffer(#TmpRepAgr);
        TmpRepAgr.splpor     := TmpRep.splpor     ;
        TmpRepAgr.skazplpor  := TmpRep.skazplpor  ;
        TmpRepAgr.dPlat      := TmpRep.dPlat      ;
        TmpRepAgr.sBankPlat  := TmpRep.sBankPlat  ;
        TmpRepAgr.sOrgPol    := TmpRep.sOrgPol    ;
        TmpRepAgr.sBankPol   := TmpRep.sBankPol   ;
        TmpRepAgr.sNazna1    := TmpRep.sNazna1    ;
        TmpRepAgr.sNazna2    := TmpRep.sNazna2    ;
        TmpRepAgr.sNazna3    := TmpRep.sNazna3    ;
        TmpRepAgr.sNazna4    := TmpRep.sNazna4    ;
        TmpRepAgr.sPodr      := TmpRep.sPodr      ;
        TmpRepAgr.stabn      := TmpRep.stabn      ;
        TmpRepAgr.sfio       := TmpRep.sfio       ;
        TmpRepAgr.cPeriod    := TmpRep.cPeriod    ;
        TmpRepAgr.sPeriod    := TmpRep.sPeriod    ;
        case TmpRep.sBs of
          '20' :
                  {
                    TmpRepAgr.s[1] := TmpRep.s;
                  }
          '23' :
                  {
                    TmpRepAgr.s[2] := TmpRep.s;
                  }
          '25' :
                  {
                    TmpRepAgr.s[3] := TmpRep.s;
                  }
          '26' :
                  {
                    TmpRepAgr.s[4] := TmpRep.s;
                  }
          '29' :
                  {
                    TmpRepAgr.s[5] := TmpRep.s;
                  }
          '91' :
                  {
                    TmpRepAgr.s[6] := TmpRep.s;
                  }
          '96' :
                  {
                    TmpRepAgr.s[7] := TmpRep.s;
                  }
          'àëäã' :
                  {
                    TmpRepAgr.s[8] := TmpRep.s;
                  }
          '≠•‚ ·Á•‚†' :
                  {
                    TmpRepAgr.s[9] := TmpRep.s;
                  }
        end;
      Insert Current TmpRepAgr;
    }
    else
    {
      case TmpRep.sBs of
          '20' :
                  {
                    TmpRepAgr.s[1] := TmpRepAgr.s[1] + TmpRep.s;
                  }
          '23' :
                  {
                    TmpRepAgr.s[2] := TmpRepAgr.s[2] + TmpRep.s;
                  }
          '25' :
                  {
                    TmpRepAgr.s[3] := TmpRepAgr.s[3] + TmpRep.s;
                  }
          '26' :
                  {
                    TmpRepAgr.s[4] := TmpRepAgr.s[4] + TmpRep.s;
                  }
          '29' :
                  {
                    TmpRepAgr.s[5] := TmpRepAgr.s[5] + TmpRep.s;
                  }
          '91' :
                  {
                    TmpRepAgr.s[6] := TmpRepAgr.s[6] + TmpRep.s;
                  }
          '96' :
                  {
                    TmpRepAgr.s[7] := TmpRepAgr.s[7] + TmpRep.s;
                  }
          'àëäã' :
                  {
                    TmpRepAgr.s[8] := TmpRepAgr.s[8] + TmpRep.s;
                  }
          '≠•‚ ·Á•‚†' :
                  {
                    TmpRepAgr.s[9] := TmpRepAgr.s[9] + TmpRep.s;
                  }
      end;
      Update Current TmpRepAgr;
    }
  }
}

Procedure GetZp(_w : word);
{
  var cANUns: comp = ExtAttr_ID(coMnPlan, 'ç•·„°·®§®‡„•¨Æ•');
  var qStr       : longint = 0;
  var oResultSet : IResultSet;

  sqlFreeStr(qStr);

  MysqlAddStr(qStr, ' select                                                                                                                                   ');
  MysqlAddStr(qStr, '   sum(spplban.sumopl * coalesce(ts.s, 0.0) / coalesce(tss.s, 0.0))        as s                                                           ');
  if (_w >= 1) then
  {
    MysqlAddStr(qStr, ' , plpor.nodok                                                             as splpor                                                      ');
    MysqlAddStr(qStr, ' , plporkazna.nodok                                                        as skazplpor                                                   ');
    MysqlAddStr(qStr, ' , plporkazna.datob                                                        as dPlat                                                       ');
    MysqlAddStr(qStr, ' , katbank.name + '', '' + katbank.schet1                                  as sBankPlat                                                   ');
    MysqlAddStr(qStr, ' , ko.name                                                                 as sOrgPol                                                     ');
    MysqlAddStr(qStr, ' , kb.name                                                                 as sBankPol                                                    ');
    MysqlAddStr(qStr, ' , plporkazna.namepl1                                                      as sNazna1                                                     ');
    MysqlAddStr(qStr, ' , plporkazna.namepl2                                                      as sNazna2                                                     ');
    MysqlAddStr(qStr, ' , plporkazna.namepl3                                                      as sNazna3                                                     ');
    MysqlAddStr(qStr, ' , plporkazna.namepl4                                                      as sNazna4                                                     ');
    MysqlAddStr(qStr, ' , ts.spodr                                                                as sPodr                                                   ');
  }
  else
  {
    MysqlAddStr(qStr, ' , ''''                                                             as splpor                                                      ');
    MysqlAddStr(qStr, ' , ''''                                                             as skazplpor                                                   ');
  }
  MysqlAddStr(qStr, ' , coalesce(ts.sbs, '''')                                                  as sbs                                                         ');
  if (_w = 2) then
  {
    MysqlAddStr(qStr, ' , lschet.strtabn                                                        as stabn                                                       ');
    MysqlAddStr(qStr, ' , persons.fio                                                           as sfio                                                        ');
  }
  else
  {
    MysqlAddStr(qStr, ' , ''''                                                                  as stabn                                                       ');
    MysqlAddStr(qStr, ' , ''''                                                                  as sfio                                                        ');
  }
  MysqlAddStr(qStr, ' , #comp(0h)                                                               as cPeriod                                                     ');
  MysqlAddStr(qStr, ' , ''''                                                                    as sPeriod                                                     ');
  MysqlAddStr(qStr, ' from sbban                                                                                                                               ');
  MysqlAddStr(qStr, ' left join spplban on sbban.nrec = spplban.csbban                                                                                         ');
  MysqlAddStr(qStr, ' left join klvidopl on spplban.vidopl = klvidopl.vidopl                                                                                   ');
  MysqlAddStr(qStr, ' left join lschet on spplban.clsch = lschet.nrec                                                                                          ');
  MysqlAddStr(qStr, ' left join persons on spplban.tperson = persons.nrec                                                                                      ');
  MysqlAddStr(qStr, ' left join docpodot on sbban.nrec = docpodot.cvtdoc                                                                                       ');
  MysqlAddStr(qStr, ' left join plpor on docpodot.cprdoc = plpor.nrec                                                                                          ');
  MysqlAddStr(qStr, ' left join katbank kbstr on plpor.cbankpol = kbstr.nrec                                                                                   ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MySqlJoinPlPorKazna(qStr);
  MysqlAddStr(qStr, ' left join katbank on plporkazna.cbankplat = katbank.nrec                                                                                 ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' left join katorg ko on plporkazna.cpol = ko.nrec                                                                                         ');
  MysqlAddStr(qStr, ' left join katbank kb on plporkazna.cbankpol = kb.nrec                                                                                    ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' outer apply (                                                                                                                            ');
  MysqlAddStr(qStr, '               select                                                                                                                     ');
  MysqlAddStr(qStr, '                 case when (substring(katpodr.kod, 1, 3) in (''446'', ''957'')) then ''àëäã''                                             ');
  if TmpDates.dBeg >= date(1,11,2022)
  {
    MysqlAddStr(qStr, '                      when coalesce(AttrVal.vLongint, 0) = 1 then ''àëäã''                                                              ');
  }
  MysqlAddStr(qStr, '                      else substring(bs.schet, 2, 2)                                                                                      ');
  MysqlAddStr(qStr, '                 end as sbs                                                                                                               ');
  MysqlAddStr(qStr, '               , katpodr.kod               as spodr                                                                                       ');
  MysqlAddStr(qStr, '               , sum(nz.summa)             as s                                                                                           ');
  MysqlAddStr(qStr, '               from                                                                                                                       ');
  MysqlAddStr(qStr, '               nachislzakaz nz                                                                                                            ');
  MysqlAddStr(qStr, '               inner join klvidopl kl on nz.vidopls = kl.vidopl                                                                           ');
  MysqlAddStr(qStr, '               inner join lschet ls on nz.clsch = ls.nrec                                                                                 ');
  MysqlAddStr(qStr, '               inner join persons on ls.tperson = persons.nrec                                                                            ');
  MysqlAddStr(qStr, '               left join mnplan on nz.ckaud[1] = mnplan.nrec                                                                              ');
  MysqlAddStr(qStr, '               left join AttrVal on 11027 = AttrVal.wTable and mnplan.NRec = AttrVal.cRec and #comp(' + cAnUns + ') = AttrVal.cAttrNam    ');
  MysqlAddStr(qStr, '               left join vplan on mnplan.cvplan = vplan.nrec                                                                              ');
  MysqlAddStr(qStr, '               left join buhschet bs on mnplan.canval2 = bs.nrec                                                                          ');
  MysqlAddStr(qStr, '               left join katpodr on nz.cex = katpodr.nrec                                                                                 ');
  MysqlAddStr(qStr, '                where     ' + string(Month(TmpDates.dBeg)) + ' = nz.mesn                                                                  ');
  MysqlAddStr(qStr, '                      and ' + string(Year(TmpDates.dBeg)) + ' = nz.yearn                                                                  ');
  MysqlAddStr(qStr, '                      and kl.nalg <> 98                                                                                                   ');
  MysqlAddStr(qStr, '                      and nz.clsch = spplban.clsch                                                                                        ');
  MysqlAddStr(qStr, '                      and kl.cschetd not in (''91'', ''44'', ''69'', ''76'', ''96'')                                                              ');
  MysqlAddStr(qStr, '               group by case when (substring(katpodr.kod, 1, 3) in (''446'', ''957'')) then ''àëäã''                                      ');
  if TmpDates.dBeg >= date(1,11,2022)
  {
    MysqlAddStr(qStr, '                      when coalesce(AttrVal.vLongint, 0) = 1 then ''àëäã''                                                              ');
  }
  MysqlAddStr(qStr, '                      else substring(bs.schet, 2, 2)                                                                                      ');
  MysqlAddStr(qStr, '                 end, katpodr.kod                                                                                                         ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' ) ts                                                                                                                                     ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' outer apply (                                                                                                                            ');
  MysqlAddStr(qStr, '               select                                                                                                                     ');
  MysqlAddStr(qStr, '                 sum(nz.summa)             as s                                                                                           ');
  MysqlAddStr(qStr, '               from                                                                                                                       ');
  MysqlAddStr(qStr, '               nachislzakaz nz                                                                                                            ');
  MysqlAddStr(qStr, '               inner join klvidopl kl on nz.vidopls = kl.vidopl                                                                           ');
  MysqlAddStr(qStr, '               inner join lschet ls on nz.clsch = ls.nrec                                                                                 ');
  MysqlAddStr(qStr, '               inner join persons on ls.tperson = persons.nrec                                                                            ');
  MysqlAddStr(qStr, '               left  join mnplan on nz.ckaud[1] = mnplan.nrec                                                                             ');
  MysqlAddStr(qStr, '               left join vplan on mnplan.cvplan = vplan.nrec                                                                              ');
  MysqlAddStr(qStr, '               left join buhschet bs on mnplan.canval2 = bs.nrec                                                                          ');
  MysqlAddStr(qStr, '               where     ' + string(Month(TmpDates.dBeg)) + ' = nz.mesn                                                                   ');
  MysqlAddStr(qStr, '                     and ' + string(Year(TmpDates.dBeg)) + ' = nz.yearn                                                                   ');
  MysqlAddStr(qStr, '                     and kl.nalg <> 98                                                                                                    ');
  MysqlAddStr(qStr, '                     and kl.cschetd not in (''91'', ''44'', ''69'', ''76'', ''96'')                                                               ');
  MysqlAddStr(qStr, '                     and nz.clsch = spplban.clsch                                                                                         ');
  MysqlAddStr(qStr, ' ) tss                                                                                                                                    ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
