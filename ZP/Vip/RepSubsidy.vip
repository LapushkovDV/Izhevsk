  MysqlAddStr(qStr, '             (substring(katbank.schet1, length(katbank.schet1)-3, 4) = ''1888'' and katbank.name = ''èÄé ëÅÖêÅÄçä'')                      ');
  MysqlAddStr(qStr, '           )*/                                                                                                                              ');
  MysqlAddStr(qStr, '       and plpor.cbankplat = #comp(2814749767119575)                                                                                      ');
  MysqlAddStr(qStr, '       and sbban.vidud in (17, 182, 184, 213) //çÑîã                                                                                       ');
  MysqlAddStr(qStr, '       and coalesce(plporkazna.nrec, #comp(0h)) <> #comp(0h)                                                                              ');
  MysqlAddStr(qStr, '       and coalesce(sumall.s,0.0) = 0.0                                                                                                  ');
  MysqlAddStr(qStr, '       and sbban.vidud not in (187, 189, 197, 209)                                                                              ');
  MysqlAddStr(qStr, '       and (klvidopl.cschetd in (''96'') or ((klvidopl.cschetd = '''') and (coalesce(nz.cnt, 0) = 0) and lschet.datuv between #date(1, ' + Month(TmpDates.dBeg) + ', ' + Year(TmpDates.dBeg) + ') ');
  MysqlAddStr(qStr, '                                                                                            and #date(' + Day(TmpDates.dEnd) + ', ' + Month(TmpDates.dEnd) + ', ' + Year(TmpDates.dEnd) + ')))  ');
  MysqlAddStr(qStr, '       and substring(katpodr.kod, 1, 3) not in (''446'')                                                 ');

  if (_w >= 1) then
  {
    MysqlAddStr(qStr, ' group by  ');
    MysqlAddStr(qStr, '           plpor.nodok                                                                                                                    ');
    MysqlAddStr(qStr, '         , plporkazna.nodok                                                                                                               ');
    MysqlAddStr(qStr, '         , plporkazna.datob                                                                                                           ');
    MysqlAddStr(qStr, '         , ko.name                                                                                                                    ');
    MysqlAddStr(qStr, '         , kb.name                                                                                                                    ');
    MysqlAddStr(qStr, '         , plporkazna.namepl1                                                                                                          ');
    MysqlAddStr(qStr, '         , plporkazna.namepl2                                                                                                          ');
    MysqlAddStr(qStr, '         , plporkazna.namepl3                                                                                                          ');
    MysqlAddStr(qStr, '         , plporkazna.namepl4                                                                                                          ');
    MysqlAddStr(qStr, '         , katpodr.kod                                                                                                                        ');
  }
  if (_w = 2) then
  {
    MysqlAddStr(qStr, '       , lschet.strtabn                                                                                                                 ');
    MysqlAddStr(qStr, '       , persons.fio                                                                                                                    ');
  }

  var objQuery : iQuery;
      objQuery := queryManager.createQuery(qStr);

  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('éË®°™† Æ°‡†°Æ‚™® ß†Ø®·•© (GetZp) ' + objQuery.errorCode, Error);
  }
  else
  {
    sqlCopyInto(objQuery, tnTmpRep, true);
  }
  sqlFreeStr(qStr);
}

