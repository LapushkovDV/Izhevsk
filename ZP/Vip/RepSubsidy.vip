  MysqlAddStr(qStr, '       and plpor.cbankplat = #comp(2814749767119575)                                                                                      ');
  MysqlAddStr(qStr, '       and sbban.vidud not in (17, 182, 184, 213) //çÑîã                                                                                       ');
  MysqlAddStr(qStr, '       and coalesce(plporkazna.nrec, #comp(0h)) <> #comp(0h)                                                                              ');
  MysqlAddStr(qStr, '       and sbban.vidud not in (187, 189, 197, 209)                                                                              ');
  MysqlAddStr(qStr, '       and klvidopl.cschetd in (''96'')                                                                           ');
  MysqlAddStr(qStr, '       and substring(katpodr.kod, 1, 3) not in (''446'')                                                 ');
  MysqlAddStr(qStr, ' group by case when(substring(katpodr.kod, 1, 3) in (''957'')) then ''àëäã'' else ''96'' end                                          ');
  MysqlAddStr(qStr, '         , plpor.nodok                                                                                                                    ');
  MysqlAddStr(qStr, '         , plporkazna.nodok                                                                                                               ');
  MysqlAddStr(qStr, '         , plporkazna.datob                                                                                                           ');
  MysqlAddStr(qStr, '         , katbank.name + '', '' + katbank.schet1                                                              ');
  MysqlAddStr(qStr, '         , ko.name                                                                                                                    ');
  MysqlAddStr(qStr, '         , kb.name                                                                                                                    ');
  MysqlAddStr(qStr, '         , plporkazna.namepl1                                                                                                          ');
  MysqlAddStr(qStr, '         , plporkazna.namepl2                                                                                                          ');
  MysqlAddStr(qStr, '         , plporkazna.namepl3                                                                                                          ');
  MysqlAddStr(qStr, '         , plporkazna.namepl4                                                                                                          ');
  MysqlAddStr(qStr, '         , katpodr.kod                                                                                                                        ');
  MysqlAddStr(qStr, '       , lschet.strtabn                                                                                                                 ');
  MysqlAddStr(qStr, '       , persons.fio                                                                                                                    ');

  var objQuery : iQuery;
      objQuery := queryManager.createQuery(qStr);

  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('éË®°™† Æ°‡†°Æ‚™® ß†Ø®·•© (GetReestrZp) ' + objQuery.errorCode, Error);
  }
  else
  {
    sqlCopyInto(objQuery, tnTmpRep, true);
  }
  sqlFreeStr(qStr);
}

Procedure AgregateReestrRep();
{
  _Loop TmpDates Ordered By cPeriod
  {
    _Loop TmpRep where ((TmpDates.cPeriod == TmpRep.cPeriod)) Ordered By skazplpor
    {
      if (
                (InStr('äéåÄçÑ', UpCase(TmpRep.sNazna1)) <> 0) or
                (InStr('äéåÄçÑ', UpCase(TmpRep.sNazna2)) <> 0) or
                (InStr('äéåÄçÑ', UpCase(TmpRep.sNazna3)) <> 0) or
                (InStr('äéåÄçÑ', UpCase(TmpRep.sNazna4)) <> 0) or

                (InStr('äéêèéê', UpCase(TmpRep.sNazna1)) <> 0) or
                (InStr('äéêèéê', UpCase(TmpRep.sNazna2)) <> 0) or
                (InStr('äéêèéê', UpCase(TmpRep.sNazna3)) <> 0) or
                (InStr('äéêèéê', UpCase(TmpRep.sNazna4)) <> 0) or
                (InStr('ééé'   , UpCase(TmpRep.sOrgPol)) <> 0) or
                (InStr('ÇõÑÄóÄ ÑÖçÖÜçõï ëêÖÑëíÇ èéÑéíóÖí', UpCase(TmpRep.sNazna1)) <> 0) or
                (InStr('ÇõÑÄóÄ ÑÖçÖÜçõï ëêÖÑëíÇ èéÑ éíóÖí', UpCase(TmpRep.sNazna1)) <> 0) or
                (InStr('áÄ êÄÅéíõ èé êÖåéçíì', UpCase(TmpRep.sNazna1)) <> 0) or
                (InStr('çÑë 20% áÄ èêÖÑéëíÄÇãÖçàÖ', UpCase(TmpRep.sNazna1)) <> 0) or
                (InStr('êä-îàçÄçë', UpCase(TmpRep.sOrgPol)) <> 0)

      ) then
      {
        Continue;
      }

      if (_wIskl = 1) then
      {
        if ((Month(TmpDates.dEnd) = Month(_dEnd)) and (Year(TmpDates.dEnd) = Year(_dEnd)) and ( Month(Add_Months(TmpDates.dEnd, 1)) = Month(TmpRep.dPlat) )) then
        {
          if ((InStr('éíèìëä', UpCase(TmpRep.sNazna1)) <> 0) or
              (InStr('éíèìëä', UpCase(TmpRep.sNazna2)) <> 0) or
              (InStr('éíèìëä', UpCase(TmpRep.sNazna3)) <> 0) or
              (InStr('éíèìëä', UpCase(TmpRep.sNazna4)) <> 0)) then
          {
            Continue;
          }
        }
      }

      if (SubStr(TmpRep.sPodr, 1, 3) = '957') then
      {
        Continue;
      }



      if (getFirst FastFirstRow TmpReestrR where ((TmpRep.sPodr == TmpReestrR.sPodr)) <> tsOk) then
      {
        ClearBuffer(#TmpReestrR);
          TmpReestrR.s      := TmpRep.s;
          TmpReestrR.sPodr  := TmpRep.sPodr;
        Insert Current TmpReestrR;
      }
      else
      {
        Set TmpReestrR.s := TmpReestrR.s + TmpRep.s;
        Update Current TmpReestrR;
      }
    }
  }

  _Loop TmpReestrR
  {
    if (getFirst FastFirstRow KatPodr where ((TmpReestrR.sPodr == KatPodr.Kod)) = tsOk) then
    {
      Set TmpReestrR.sPodrName := KatPodr.Name;
      Update Current TmpReestrR;
    }
  }
}

Procedure GetSums(_w : word);
{
  if (_w = 0) then
  {
    GetZp(_wDetail);
  }
  if (_w = 1) then
  {
    GetNdfl(_wDetail);
  }
  if (_w = 2) then
  {
    GetPerevod();
  }
  if (_w = 3) then
  {
    CreateTmpProps();
    GetZp96BySchet(_wDetail);
  }
  if (_w = 4) then
  {
    CreateTmpProps();
    GetNdfl96BySchet(_wDetail);
  }
  if (_w = 5) then
  {
    GetReestrZp();
  }
  if (_w = 6) then
  {
    GetReestrPz(_wDetail, 1);
  }
  if (_w = 7) then
  {
    CreateTmpProps();
    GetZp96BySchetPz(_wDetail, 1);
  }
  if (_w = 8) then
  {
    GetReestrPz(_wDetail, 2);
  }
  if (_w = 9) then
  {
    CreateTmpProps();
    GetZp96BySchetPz(_wDetail, 2);
  }
  if (_w = 10) then
  {
    GetZpMilk(_wDetail);
  }
  if (_w = 11) then
  {
    GetZpByVidOpl(_wDetail, ' in (83, 84, 86, 95)', ' and plporkazna.NoDok in (''982'', ''986'', ''989'', ''3125'', ''3133'', ''3145'', ''4310'', ''4317'', ''4324'', ''4539'', ''4542'', ''4689'', ''6792'', ''6839'', ''7601'', ''7703'', ''7704'', ''8560'')');
  }
  if (_w = 12) then
  {
    GetZpByVidOpl(_wDetail, ' in (83, 84, 86, 95)', '', true);
  }
  if (_w = 13) then
  {
    GetZpWOPlPor(_wDetail, 1);
  }
  if (_w = 14) then
  {
    CreateTmpProps();
    GetZp96BySchetWOPlpor(_wDetail, 1);
  }
  if (_w = 15) then
  {
    GetZpWOPlPorN(_wDetail, 2);
  }
  if (_w = 16) then
  {
    CreateTmpProps();
    GetZp96BySchetWOPlporN(_wDetail, 2);
  }
}

#declare RepHeadTxt(sTxt)
