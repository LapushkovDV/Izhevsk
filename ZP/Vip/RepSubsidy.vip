  MysqlAddStr(qStr, ' left join plpor on docpodot.cprdoc = plpor.nrec                                                                                          ');
  MysqlAddStr(qStr, ' left join katbank kbstr on plpor.cbankpol = kbstr.nrec                                                                                   ');
  MysqlAddStr(qStr, '                                                                                                                                          ');

  MysqlAddStr(qStr, ' left join katbank on plpor.cbankplat = katbank.nrec                                                                                 ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' left join katorg ko on plpor.cpol = ko.nrec                                                                                         ');
  MysqlAddStr(qStr, ' left join katbank kb on plpor.cbankpol = kb.nrec                                                                                    ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' outer apply (                                                                                                                            ');
  MysqlAddStr(qStr, '               select                                                                                                                     ');
  MysqlAddStr(qStr, '                 case when (substring(katpodr.kod, 1, 3) in (''446'', ''957'')) then ''àëäã''                                             ');
  if TmpDates.dBeg >= date(1,11,2022)
  {
    MysqlAddStr(qStr, '                      when coalesce(AttrVal.vLongint, 0) = 1 then ''àëäã''                                                              ');
  }
  MysqlAddStr(qStr, '                      else substring(bs.schet, 2, 2)                                                                                      ');
  MysqlAddStr(qStr, '                 end as sbs                                                                                                               ');
  MysqlAddStr(qStr, '               , katpodr.kod               as spodr                                                                                       ');
  MysqlAddStr(qStr, '               , sum(nz.summa)             as s                                                                                           ');
