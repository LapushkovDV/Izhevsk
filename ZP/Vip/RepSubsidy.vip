Procedure GetZp96BySchet(_w : word);
{
  var qStr       : longint = 0;
  var oResultSet : IResultSet;

  sqlFreeStr(qStr);

  MysqlAddStr(qStr, ' select                                                                                                                                   ');
  MysqlAddStr(qStr, '   sum(spplban.sumopl*coalesce(sumposch.s,0.0)/coalesce(sumall.s,0.0))        as s                                                           ');
  if (_w >= 1) then
  {
    MysqlAddStr(qStr, ' , plpor.nodok                                                             as splpor                                                      ');
    MysqlAddStr(qStr, ' , plporkazna.nodok                                                        as skazplpor                                                   ');
    MysqlAddStr(qStr, ' , plporkazna.datob                                                        as dPlat                                                       ');
    MysqlAddStr(qStr, ' , ko.name                                                                 as sOrgPol                                                     ');
    MysqlAddStr(qStr, ' , kb.name                                                                 as sBankPol                                                    ');
    MysqlAddStr(qStr, ' , plporkazna.namepl1                                                       as sNazna1                                                     ');
    MysqlAddStr(qStr, ' , plporkazna.namepl2                                                       as sNazna2                                                     ');
    MysqlAddStr(qStr, ' , plporkazna.namepl3                                                       as sNazna3                                                     ');
    MysqlAddStr(qStr, ' , plporkazna.namepl4                                                       as sNazna4                                                     ');
    MysqlAddStr(qStr, ' , katpodr.kod                                                              as sPodr                                                   ');
  }
  else
  {
    MysqlAddStr(qStr, ' , ''''                                                             as splpor                                                      ');
    MysqlAddStr(qStr, ' , ''''                                                             as skazplpor                                                   ');
  }
  MysqlAddStr(qStr, ' , case when (substring(katpodr.kod, 1, 3) = ''957'') then /*sumposch.sbs + */''àëäã'' else sumposch.sbs end          as sbs                                                         ');
  if (_w = 2) then
  {
    MysqlAddStr(qStr, ' , lschet.strtabn                                                        as stabn                                                       ');
    MysqlAddStr(qStr, ' , persons.fio                                                           as sfio                                                        ');
  }
  else
  {
    MysqlAddStr(qStr, ' , ''''                                                                  as stabn                                                       ');
    MysqlAddStr(qStr, ' , ''''                                                                  as sfio                                                        ');
  }
  MysqlAddStr(qStr, ' , #comp(0h)                                                               as cPeriod                                                     ');
  MysqlAddStr(qStr, ' , ''''                                                                    as sPeriod                                                     ');
  MysqlAddStr(qStr, ' from sbban                                                                                                                               ');
  MysqlAddStr(qStr, ' left join spplban on sbban.nrec = spplban.csbban                                                                                         ');
  MysqlAddStr(qStr, ' left join klvidopl on spplban.vidopl = klvidopl.vidopl                                                                                   ');
  MysqlAddStr(qStr, ' left join lschet on spplban.clsch = lschet.nrec                                                                                          ');
  MysqlAddStr(qStr, ' left join persons on spplban.tperson = persons.nrec                                                                                      ');
  MysqlAddStr(qStr, ' left join docpodot on sbban.nrec = docpodot.cvtdoc                                                                                       ');
  MysqlAddStr(qStr, ' left join plpor on docpodot.cprdoc = plpor.nrec                                                                                          ');
  MysqlAddStr(qStr, ' left join katbank kbstr on plpor.cbankpol = kbstr.nrec                                                                                   ');
  MysqlAddStr(qStr, ' left join katpodr on spplban.cex = katpodr.nrec                                                                                          ');
  MySqlJoinPlPorKazna(qStr);
  MysqlAddStr(qStr, ' left join katbank on plporkazna.cbankplat = katbank.nrec                                                                                 ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' left join katorg ko on plporkazna.cpol = ko.nrec                                                                                         ');
  MysqlAddStr(qStr, ' left join katbank kb on plporkazna.cbankpol = kb.nrec                                                                                    ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' left join tmpProp sumall on spplban.clsch = sumall.clsch                                                                                 ');
  MysqlAddStr(qStr, ' left join tmpProps sumposch on spplban.clsch = sumposch.clsch                                                                            ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' where (  (plpor.datvip between #date(1, ' + Month(TmpDates.dBeg) + ', ' + Year(TmpDates.dBeg) + ')                               ');
  MysqlAddStr(qStr, '                                    and #date(' + Day(TmpDates.dEnd) + ', ' + Month(TmpDates.dEnd) + ', ' + Year(TmpDates.dEnd) + ')) or  ');
  MysqlAddStr(qStr, '              (plpor.datvip between #date(1, ' + Month(TmpDates.dZpInc) + ', ' + Year(TmpDates.dZpInc) + ')                               ');
  MysqlAddStr(qStr, '                                    and #date(' + Last_Day(TmpDates.dZpInc) + ', ' + Month(TmpDates.dZpInc) + ', ' + Year(TmpDates.dZpInc) + '))) ');
  MysqlAddStr(qStr, '       and plpor.cbankplat = #comp(2814749767119575)                                                                                      ');
  MysqlAddStr(qStr, '       and sbban.vidud not in (17, 182, 184, 213) //çÑîã                                                                                       ');
  MysqlAddStr(qStr, '       and coalesce(plporkazna.nrec, #comp(0h)) <> #comp(0h)                                                                              ');
  MysqlAddStr(qStr, '       and coalesce(sumall.s,0.0) <> 0.0                                                                                                  ');
  MysqlAddStr(qStr, '       and sbban.vidud not in (187, 189, 197, 209)                                                                              ');
  MysqlAddStr(qStr, '       and klvidopl.cschetd in (''96'')                                                                           ');
  MysqlAddStr(qStr, '       and substring(katpodr.kod, 1, 3) not in (''446'')                                                 ');
  MysqlAddStr(qStr, ' group by case when (substring(katpodr.kod, 1, 3) = ''957'') then /*sumposch.sbs + */''àëäã'' else sumposch.sbs end ');
  if (_w >= 1) then
  {
    MysqlAddStr(qStr, '         , plpor.nodok                                                                                                                    ');
    MysqlAddStr(qStr, '         , plporkazna.nodok                                                                                                               ');
    MysqlAddStr(qStr, '         , plporkazna.datob                                                                                                           ');
    MysqlAddStr(qStr, '         , ko.name                                                                                                                    ');
    MysqlAddStr(qStr, '         , kb.name                                                                                                                    ');
    MysqlAddStr(qStr, '         , plporkazna.namepl1                                                                                                          ');
    MysqlAddStr(qStr, '         , plporkazna.namepl2                                                                                                          ');
    MysqlAddStr(qStr, '         , plporkazna.namepl3                                                                                                          ');
    MysqlAddStr(qStr, '         , plporkazna.namepl4                                                                                                          ');
    MysqlAddStr(qStr, '         , katpodr.kod                                                                                                                        ');
  }
  if (_w = 2) then
  {
    MysqlAddStr(qStr, '       , lschet.strtabn                                                                                                                 ');
    MysqlAddStr(qStr, '       , persons.fio                                                                                                                    ');
  }

  MysqlAddStr(qStr, 'union all ');

  MysqlAddStr(qStr, ' select                                                                                                                                   ');
  MysqlAddStr(qStr, '   sum(spplban.sumopl)        as s                                                           ');
  if (_w >= 1) then
  {
    MysqlAddStr(qStr, ' , plpor.nodok                                                             as splpor                                                      ');
    MysqlAddStr(qStr, ' , plporkazna.nodok                                                        as skazplpor                                                   ');
    MysqlAddStr(qStr, ' , plporkazna.datob                                                        as dPlat                                                       ');
    MysqlAddStr(qStr, ' , ko.name                                                                 as sOrgPol                                                     ');
    MysqlAddStr(qStr, ' , kb.name                                                                 as sBankPol                                                    ');
    MysqlAddStr(qStr, ' , plporkazna.namepl1                                                       as sNazna1                                                     ');
    MysqlAddStr(qStr, ' , plporkazna.namepl2                                                       as sNazna2                                                     ');
    MysqlAddStr(qStr, ' , plporkazna.namepl3                                                       as sNazna3                                                     ');
    MysqlAddStr(qStr, ' , plporkazna.namepl4                                                       as sNazna4                                                     ');
    MysqlAddStr(qStr, ' , katpodr.kod                                                              as sPodr                                                   ');
  }
  else
  {
    MysqlAddStr(qStr, ' , ''''                                                             as splpor                                                      ');
    MysqlAddStr(qStr, ' , ''''                                                             as skazplpor                                                   ');
  }
  MysqlAddStr(qStr, ' , ''≠•‚ ·Á•‚†''          as sbs                                                         ');
  if (_w = 2) then
  {
    MysqlAddStr(qStr, ' , lschet.strtabn                                                        as stabn                                                       ');
    MysqlAddStr(qStr, ' , persons.fio                                                           as sfio                                                        ');
  }
  else
  {
    MysqlAddStr(qStr, ' , ''''                                                                  as stabn                                                       ');
    MysqlAddStr(qStr, ' , ''''                                                                  as sfio                                                        ');
  }
  MysqlAddStr(qStr, ' , #comp(0h)                                                               as cPeriod                                                     ');
  MysqlAddStr(qStr, ' , ''''                                                                    as sPeriod                                                     ');
  MysqlAddStr(qStr, ' from sbban                                                                                                                               ');
  MysqlAddStr(qStr, ' left join spplban on sbban.nrec = spplban.csbban                                                                                         ');
  MysqlAddStr(qStr, ' left join klvidopl on spplban.vidopl = klvidopl.vidopl                                                                                   ');
  MysqlAddStr(qStr, ' left join lschet on spplban.clsch = lschet.nrec                                                                                          ');
  MysqlAddStr(qStr, ' left join persons on spplban.tperson = persons.nrec                                                                                      ');
  MysqlAddStr(qStr, ' left join docpodot on sbban.nrec = docpodot.cvtdoc                                                                                       ');
  MysqlAddStr(qStr, ' left join plpor on docpodot.cprdoc = plpor.nrec                                                                                          ');
  MysqlAddStr(qStr, ' left join katbank kbstr on plpor.cbankpol = kbstr.nrec                                                                                   ');
  MysqlAddStr(qStr, ' left join katpodr on spplban.cex = katpodr.nrec                                                                                          ');
  MySqlJoinPlPorKazna(qStr);
  //MysqlAddStr(qStr, ' left join plpor plporkazna on 1 = 1                                                                                                      ');
  MysqlAddStr(qStr, ' left join katbank on plporkazna.cbankplat = katbank.nrec                                                                                 ');
  MysqlAddStr(qStr, '                                                                                                                                          ');
  MysqlAddStr(qStr, ' left join katorg ko on plporkazna.cpol = ko.nrec                                                                                         ');
  MysqlAddStr(qStr, ' left join katbank kb on plporkazna.cbankpol = kb.nrec                                                                                    ');
