#end

Procedure LoadToXlsxPv();
{
  if (not xlCreateExcel(_FileName + DateToStr(cur_date,'_YYYYMMDD')+ timetostr(cur_time,'_HHMMSS')+'.xlsx' , true)) then
  {
    Message('éË®°™† ·Æß§†≠®Ô ≠Æ¢Æ£Æ ‰†©´† Excel" ' + _FileName + '"', Error);
    Exit;
  }
  else
  {
    var RowNo : longint = 1;
    var ColNo : longint = 1;

    if (xlIsExcelValid) then
    {
      xlSetActiveWorkBookByName('1');
    }

    xlSetCellStringValue('Äé "çèé ù≠•‡£Æ¨†Ë ®¨. †™. Ç.è. É´„Ë™Æ"', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlItalic, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo, ColNo + 7);
    xlAlignCellsEx(xlRight, xlCenter, RowNo, ColNo, RowNo, ColNo + 7);

    RowNo++;
    RowNo++;

    #RepHeadTxt('è•‡®Æ§')
    #RepHeadTxt('ëÁ•‚ Ñ‚')
    #RepHeadTxt('ç†Á®·´•≠Æ')
    #RepHeadTxt('Çß≠Æ·Î (¢·•£Æ)')
    #RepHeadTxt('èîê')
    #RepHeadTxt('èîê (Ø.1 Á.1 ·‚.30 ¸400-îá)')
    #RepHeadTxt('èîê (Ø.Ø.2-18 Á.1 ·‚.30 ¸400-îá)')
    #RepHeadTxt('îëë')
    #RepHeadTxt('îëë ‚‡†¢¨†‚®ß¨')
    #RepHeadTxt('îîéåë')
    #RepHeadTxt('àëäã')

    #RepHeadTxt('àëäã èîê')
    #RepHeadTxt('àëäã èîê (Ø.1 Á.1 ·‚.30 ¸400-îá)')
    #RepHeadTxt('àëäã èîê (Ø.Ø.2-18 Á.1 ·‚.30 ¸400-îá)')
    #RepHeadTxt('àëäã îëë')
    #RepHeadTxt('àëäã îëë ‚‡†¢¨†‚®ß¨')
    #RepHeadTxt('àëäã îîéåë')

    RowNo := 0;
    var firstRow: longint = 4;
    var kolR: longint = RecordsInTable(tnTmpRepPv);
    var kolC: longint = 17;
    xlCreateMatrix(kolR, kolC);
    xlSetNumberFormat('### ### ### ##0'+xlGetDecimalSeparator+' 00', firstRow, 3, firstRow + kolR - 1, 17);
    _Loop TmpDates Ordered By cPeriod
    {
      _Loop TmpRepPv where ((TmpDates.cPeriod == TmpRepPv.cPeriod))
      {
        ColNo := 0;
        xlStWriteToMatrix(++RowNo, ++ColNo, chr(39) + TmpDates.sPeriod);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + TmpRepPv.sBs);

        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.nachsum);
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.totsum );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s5     );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s11    );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s12    );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s2     );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s8     );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s3     );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s0     );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s5i    );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s11i   );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s12i   );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s2i    );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s8i    );
        xlDoWriteToMatrix(  RowNo, ++ColNo, TmpRepPv.s3i    );
      }
    }
    XLWRITEMATRIXTOEXCEL(firstRow, 1);
    XLFREEMATRIX;

    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, firstRow - 1, 1, firstRow + RowNo - 1, kolC);
    xlAutoFit(1, 1, firstRow + RowNo - 1, kolC);

    xlKillExcel;
  }
}

var eps: array [1..1] of double;
procedure PrepareRoundErrors(maxCol: word);
var i: longint;
{
  SetLimit(eps, maxCol);
  for (i := 1; i <= maxCol; i++)
    eps[i] := 0;
}
function xlRdWriteToMatrix(row, col: longint; value: double; precision: integer = 2): boolean;
var v: double;
{
  v := Round(value + eps[col], precision);
  eps[col] := value + eps[col] - v;
  Result := XLDOWRITETOMATRIX(row, col, v);
}

Procedure LoadToXlsx();
{
  if (not xlCreateExcel(_FileName + DateToStr(cur_date,'_YYYYMMDD')+ timetostr(cur_time,'_HHMMSS')+'.xlsx' , true)) then
  {
    Message('éË®°™† ·Æß§†≠®Ô ≠Æ¢Æ£Æ ‰†©´† Excel" ' + _FileName + '"', Error);
    Exit;
  }
  else
  {
    var RowNo : longint = 1;
    var ColNo : longint = 1;

    if (xlIsExcelValid) then
    {
      xlSetActiveWorkBookByName('1');
    }

    xlSetCellStringValue('Äé "çèé ù≠•‡£Æ¨†Ë ®¨. †™. Ç.è. É´„Ë™Æ"', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlItalic, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo, ColNo + 7);
    xlAlignCellsEx(xlRight, xlCenter, RowNo, ColNo, RowNo, ColNo + 7);

    RowNo++;
    RowNo++;

    #RepHeadTxt('è•‡®Æ§')
    #RepHeadTxt('20 ·Á•‚')
    #RepHeadTxt('23 ·Á•‚')
    #RepHeadTxt('25 ·Á•‚')
    #RepHeadTxt('26 ·Á•‚')
    #RepHeadTxt('29 ·Á•‚')
    #RepHeadTxt('44, 69, 76, 91 ·Á•‚†')
    #RepHeadTxt('96 ·Á•‚')
    #RepHeadTxt('àëäã')
    if (_wDetail >= 1) then
    {
      #RepHeadTxt('èÆ§‡†ß§•´•≠®•')
      #RepHeadTxt('è´†‚•¶™† ERP áè')
      #RepHeadTxt('è´†‚•¶™† ä†ß≠†')
      #RepHeadTxt('Ñ†‚† Ø´†‚•¶†')
      #RepHeadTxt('Å†≠™ Ø´†‚•´ÏÈ®™')
      #RepHeadTxt('äÆ≠‚‡†£•≠‚ ØÆ´„Á†‚•´Ï')
      #RepHeadTxt('Å†≠™ ØÆ´„Á†‚•´Ï')
      #RepHeadTxt('è‡®¨. 1')
      #RepHeadTxt('è‡®¨. 2')
      #RepHeadTxt('è‡®¨. 3')
      #RepHeadTxt('è‡®¨. 4')
    }
    if (_wDetail = 2) then
    {
      #RepHeadTxt('í†°•´Ï≠Î© ≠Æ¨•‡')
      #RepHeadTxt('îàé')
    }

    RowNo := 0;
    var firstRow: longint = 4;
    var kolR: longint = RecordsInTable(tnTmpRepAgr);
    var kolC: longint = if (_wDetail = 0, 9, if (_wDetail = 1, 20, 22));
    PrepareRoundErrors(kolC);
    xlCreateMatrix(kolR, kolC);
    xlSetNumberFormat('### ### ### ##0'+if(_wTypeRun = 1, '', xlGetDecimalSeparator+' 00'), firstRow, 2, firstRow + kolR - 1, 9);

    _Loop TmpDates Ordered By cPeriod
    {
      _Loop TmpRepAgr where ((TmpDates.cPeriod == TmpRepAgr.cPeriod)) Ordered By skazplpor
      {

        if (
              (InStr('äéåÄçÑ', UpCase(TmpRepAgr.sNazna1)) <> 0) or
              (InStr('äéåÄçÑ', UpCase(TmpRepAgr.sNazna2)) <> 0) or
              (InStr('äéåÄçÑ', UpCase(TmpRepAgr.sNazna3)) <> 0) or
              (InStr('äéåÄçÑ', UpCase(TmpRepAgr.sNazna4)) <> 0) or

              (InStr('äéêèéê', UpCase(TmpRepAgr.sNazna1)) <> 0) or
              (InStr('äéêèéê', UpCase(TmpRepAgr.sNazna2)) <> 0) or
              (InStr('äéêèéê', UpCase(TmpRepAgr.sNazna3)) <> 0) or
              (InStr('äéêèéê', UpCase(TmpRepAgr.sNazna4)) <> 0) or
              (InStr('ééé'   , UpCase(TmpRepAgr.sOrgPol)) <> 0) or
              (InStr('ÇõÑÄóÄ ÑÖçÖÜçõï ëêÖÑëíÇ èéÑéíóÖí', UpCase(TmpRepAgr.sNazna1)) <> 0) or
              (InStr('ÇõÑÄóÄ ÑÖçÖÜçõï ëêÖÑëíÇ èéÑ éíóÖí', UpCase(TmpRepAgr.sNazna1)) <> 0) or
              (InStr('áÄ êÄÅéíõ èé êÖåéçíì', UpCase(TmpRepAgr.sNazna1)) <> 0) or
              (InStr('çÑë 20% áÄ èêÖÑéëíÄÇãÖçàÖ', UpCase(TmpRepAgr.sNazna1)) <> 0) or
              (InStr('êä-îàçÄçë', UpCase(TmpRepAgr.sOrgPol)) <> 0)

        ) then
        {
          Continue;
        }

        if (_wTypeRun <= 1) then
        {
          if (_wIskl = 1) then
          {
            if ((Month(TmpDates.dEnd) = Month(_dEnd)) and (Year(TmpDates.dEnd) = Year(_dEnd)) and ( Month(Add_Months(TmpDates.dEnd, 1)) = Month(TmpRepAgr.dPlat) )) then
            {
              if ((InStr('éíèìëä', UpCase(TmpRepAgr.sNazna1)) <> 0) or
                  (InStr('éíèìëä', UpCase(TmpRepAgr.sNazna2)) <> 0) or
                  (InStr('éíèìëä', UpCase(TmpRepAgr.sNazna3)) <> 0) or
                  (InStr('éíèìëä', UpCase(TmpRepAgr.sNazna4)) <> 0)) then
              {
                Continue;
              }
            }
          }
        }

        ColNo := 0;
        xlStWriteToMatrix(++RowNo, ++ColNo, chr(39) + TmpDates.sPeriod    );
        var i: longint;
        for (i := 1; i <= 8; i++)
          xlRdWriteToMatrix(RowNo, ++ColNo, TmpRepAgr.s[i], if(_wTypeRun = 1, 0, 2));
        if (_wDetail >= 1) then
        {
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sPodr    );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.splpor   );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.skazplpor);
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.dPlat    );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sBankPlat);
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sOrgPol  );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sBankPol );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sNazna1  );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sNazna2  );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sNazna3  );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sNazna4  );
        }
        if (_wDetail = 2) then
        {
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sTabN);
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepAgr.sFio );
        }
      }
    }
    XLWRITEMATRIXTOEXCEL(firstRow, 1);
    XLFREEMATRIX;

    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, firstRow - 1, 1, firstRow + RowNo - 1, kolC);
    xlAutoFit(1, 1, firstRow + RowNo - 1, kolC);

    xlKillExcel;
  }
}

