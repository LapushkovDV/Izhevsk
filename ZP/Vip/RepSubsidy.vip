  MysqlAddStr(qStr, '               left join katpodr on nz.cex = katpodr.nrec                                                                                 ');
  MysqlAddStr(qStr, '                where     ' + string(Month(TmpDates.dBeg)) + ' = nz.mesn                                                                  ');
  MysqlAddStr(qStr, '                      and ' + string(Year(TmpDates.dBeg)) + ' = nz.yearn                                                                  ');
