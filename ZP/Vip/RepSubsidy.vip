      #RepHeadTxt('Å†≠™ ØÆ´„Á†‚•´Ï')
      #RepHeadTxt('è‡®¨. 1')
      #RepHeadTxt('è‡®¨. 2')
      #RepHeadTxt('è‡®¨. 3')
      #RepHeadTxt('è‡®¨. 4')
    }
    if (_wDetail = 2) then
    {
      #RepHeadTxt('í†°•´Ï≠Î© ≠Æ¨•‡')
      #RepHeadTxt('îàé')
    }

    RowNo := 0;
    var firstRow: longint = 4;
    var kolR: longint = RecordsInTable(tnTmpRepPz);
    var kolC: longint = if (_wDetail = 0, 2, if (_wDetail = 1, 15, 17));
    xlCreateMatrix(kolR, kolC);
    xlSetNumberFormat('### ### ### ##0'+xlGetDecimalSeparator+' 00', firstRow, 2, firstRow + kolR - 1, 9);

    _Loop TmpDates Ordered By cPeriod
    {
      _Loop TmpRepPz where ((TmpDates.cPeriod == TmpRepPz.cPeriod)) Ordered By skazplpor
      {

        if (
              (InStr('äéåÄçÑ', UpCase(TmpRepPz.sNazna1)) <> 0) or
              (InStr('äéåÄçÑ', UpCase(TmpRepPz.sNazna2)) <> 0) or
              (InStr('äéåÄçÑ', UpCase(TmpRepPz.sNazna3)) <> 0) or
              (InStr('äéåÄçÑ', UpCase(TmpRepPz.sNazna4)) <> 0) or

              (InStr('äéêèéê', UpCase(TmpRepPz.sNazna1)) <> 0) or
              (InStr('äéêèéê', UpCase(TmpRepPz.sNazna2)) <> 0) or
              (InStr('äéêèéê', UpCase(TmpRepPz.sNazna3)) <> 0) or
              (InStr('äéêèéê', UpCase(TmpRepPz.sNazna4)) <> 0) or
              (InStr('ééé'   , UpCase(TmpRepPz.sOrgPol)) <> 0) or
              (InStr('ÇõÑÄóÄ ÑÖçÖÜçõï ëêÖÑëíÇ èéÑéíóÖí', UpCase(TmpRepPz.sNazna1)) <> 0) or
              (InStr('ÇõÑÄóÄ ÑÖçÖÜçõï ëêÖÑëíÇ èéÑ éíóÖí', UpCase(TmpRepPz.sNazna1)) <> 0) or
              (InStr('áÄ êÄÅéíõ èé êÖåéçíì', UpCase(TmpRepPz.sNazna1)) <> 0) or
              (InStr('çÑë 20% áÄ èêÖÑéëíÄÇãÖçàÖ', UpCase(TmpRepPz.sNazna1)) <> 0) or
              (InStr('êä-îàçÄçë', UpCase(TmpRepPz.sOrgPol)) <> 0)

        ) then
        {
          Continue;
        }

        if (_wTypeRun <= 1) then
        {
          if (_wIskl = 1) then
          {
            if ((Month(TmpDates.dEnd) = Month(_dEnd)) and (Year(TmpDates.dEnd) = Year(_dEnd)) and ( Month(Add_Months(TmpDates.dEnd, 1)) = Month(TmpRepPz.dPlat) )) then
            {
              if ((InStr('éíèìëä', UpCase(TmpRepPz.sNazna1)) <> 0) or
                  (InStr('éíèìëä', UpCase(TmpRepPz.sNazna2)) <> 0) or
                  (InStr('éíèìëä', UpCase(TmpRepPz.sNazna3)) <> 0) or
                  (InStr('éíèìëä', UpCase(TmpRepPz.sNazna4)) <> 0)) then
              {
                Continue;
              }
            }
          }
        }

        ColNo := 0;
        xlStWriteToMatrix(++RowNo, ++ColNo, chr(39) + TmpDates.sPeriod    );
        var i: longint;
        xlDoWriteToMatrix(RowNo, ++ColNo, TmpRepPz.s);
        if (_wDetail >= 1) then
        {
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sPodr    );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sMnp     );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sVplan   );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.splpor   );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.skazplpor);
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.dPlat    );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sBankPlat);
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sOrgPol  );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sBankPol );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sNazna1  );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sNazna2  );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sNazna3  );
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sNazna4  );
        }
        if (_wDetail = 2) then
        {
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sTabN);
          xlStWriteToMatrix(RowNo, ++ColNo, chr(39) + TmpRepPz.sFio );
        }
      }
    }
    XLWRITEMATRIXTOEXCEL(firstRow, 1);
    XLFREEMATRIX;

    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, firstRow - 1, 1, firstRow + RowNo - 1, kolC);
    xlAutoFit(1, 1, firstRow + RowNo - 1, kolC);

    xlKillExcel;
  }
}

