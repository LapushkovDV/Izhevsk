    {
      Message('éË®°™† ¢ÎØÆ´≠•≠®Ô ß†Ø‡Æ·† (tmpPropNg) ' + objQuery.ErrorCode, Error);
    }

    strID := 0;
    sqlFreeStr(strID);

    SetVisualHeader('ëÆß§†≠®• ¢‚Æ‡Æ© ¢‡•¨•≠≠Æ© ‚†°´®ÊÎ §´Ô Ø‡ÆØÆ‡Ê®© 96');

    MysqlAddStr(strID, ' table tmpPropsNg       ');
