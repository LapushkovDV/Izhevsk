Procedure GetZpWOPlPor(_w : word; _n : word);
{
  var cANUns: comp = ExtAttr_ID(coMnPlan, 'ç•·„°·®§®‡„•¨Æ•');
  var qStr       : longint = 0;
  var oResultSet : IResultSet;

  sqlFreeStr(qStr);

  MysqlAddStr(qStr, ' select                                                                                                                                   ');
  MysqlAddStr(qStr, '   sum(spplban.sumopl * coalesce(ts.s, 0.0) / coalesce(tss.s, 0.0))        as s                                                           ');
  if (_w >= 1) then
  {
    MysqlAddStr(qStr, ' , plpor.nodok                                                             as splpor                                                      ');
    MysqlAddStr(qStr, ' , plpor.nodok                                                        as skazplpor                                                   ');
    MysqlAddStr(qStr, ' , plpor.datob                                                        as dPlat                                                       ');
    MysqlAddStr(qStr, ' , katbank.name + '', '' + katbank.schet1                                  as sBankPlat                                                   ');
    MysqlAddStr(qStr, ' , ko.name                                                                 as sOrgPol                                                     ');
    MysqlAddStr(qStr, ' , kb.name                                                                 as sBankPol                                                    ');
    MysqlAddStr(qStr, ' , plpor.namepl1                                                      as sNazna1                                                     ');
    MysqlAddStr(qStr, ' , plpor.namepl2                                                      as sNazna2                                                     ');
    MysqlAddStr(qStr, ' , plpor.namepl3                                                      as sNazna3                                                     ');
    MysqlAddStr(qStr, ' , plpor.namepl4                                                      as sNazna4                                                     ');
    MysqlAddStr(qStr, ' , ts.spodr                                                                as sPodr                                                   ');
  }
  else
  {
    MysqlAddStr(qStr, ' , ''''                                                             as splpor                                                      ');
    MysqlAddStr(qStr, ' , ''''                                                             as skazplpor                                                   ');
  }
  MysqlAddStr(qStr, ' , coalesce(ts.sbs, '''')                                                  as sbs                                                         ');
  if (_w = 2) then
  {
    MysqlAddStr(qStr, ' , lschet.strtabn                                                        as stabn                                                       ');
    MysqlAddStr(qStr, ' , persons.fio                                                           as sfio                                                        ');
  }
  else
  {
    MysqlAddStr(qStr, ' , ''''                                                                  as stabn                                                       ');
    MysqlAddStr(qStr, ' , ''''                                                                  as sfio                                                        ');
  }
