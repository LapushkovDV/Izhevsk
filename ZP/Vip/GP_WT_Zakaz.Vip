}
cmTreeNodeType:
{ //onSetPosition(U_XML_TABLE.Nrec);
  if (TreeIsTerminal(fCurrMainFormat))
  if getfirst tmp_wt_zak_Sub<>tsok
   TreeSetNodeType(fCurrMainFormat, ntfText);
}
