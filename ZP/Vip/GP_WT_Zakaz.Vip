const
 cgFilter_Post  =5;
 cgFilter_Podr  =6;
 cgFilter_Kateg =7;
 cgFilter_Pers  =8;
 //-- группировки
 cg_s_Len_a_gr = 8;
 //=====================
 cg_s_code_Department     = 01;
 cg_s_name_Department     = 'Подразделение';
 cg_s_code_cex            = 02;
 cg_s_name_cex            = 'цех';
 cg_s_code_Kateg          = 03;
 cg_s_name_Kateg          = 'Категория сотрудников';
 cg_s_code_Post           = 04;
 cg_s_name_Post           = 'Должность';
 cg_s_code_Year           = 05;
 cg_s_name_Year           = 'Год';
 cg_s_code_quarter        = 06;
 cg_s_name_quarter        = 'квартал';
 cg_s_code_month          = 07;
 cg_s_name_month          = 'Месяц';
 cg_s_code_Pers           = 08;
 cg_s_name_Pers           = 'Сотрудник';
end;

//----------------------------------------------
//===============================
//==== Для выбора работников на DSLQ
table struct tmp_wt_zak
(  Fio        :string
  ,Nrec       :comp
  ,cPersons   :comp
  ,cLschet    :comp
  ,cLsTab     :comp
  ,cKatPodr   :comp
  ,Podr_Kod   :string[40]
  ,Podr_Name  :string[200]
  ,Podr_Kod_C :string[40]
  ,Podr_Name_C:string[200]
  ,StrTabn    :string[40]
  ,Kateg      :word
  ,Post       :string
  ,cPost      :comp
  ,MesN       :word
  ,YearN      :word
  ,Rate       :double "Ставка"
  ,Sovm       :word   "Вид работы"
  ,ZakTp      :word  "Источник заказов"
  //-------------
  ,pr         :word
  ,LevCode    :string[100]
  ,LevName    :string
  ,LevKod     :string
  ,LevTitle   :string
  ,cRec       :comp
  //-------------
  ,Itogo      :double
  ,dmd        :Array [1..100] of double
  ,dms        :Array [1..100] of string[100]
)
with index
( tmp_wt_zak01 = cRec+Fio+cLschet+YearN+Mesn+Podr_kod+cPost+Kateg
 ,tmp_wt_zak02 = Nrec(AutoInc, Unique)
 ,tmp_wt_zak03 = PR+FIO+cRec
 ,tmp_wt_zak04 = PR+FIO+cLschet+YearN+Mesn+cKatPodr+cPost+Kateg
);
//------------------
// Для предвыборки табеля
Table Struct tmp_wt_z_LsTab
( cLstab  :comp
 ,cPerexod:comp
 ,cKatPodr:comp
 ,Podr_Kod   :string
 ,Podr_Name  :string
 ,Podr_Kod_C :string
 ,cAppoint:comp
 ,Kateg   :word
 ,Fio     :string
 ,StrTabn :string
 ,cPersons:comp
 ,cLschet :comp
 ,Sovm    :word
 ,sPost   :string
 ,MesN    :word
 ,YearN   :integer
)
with index
( tmp_wt_z_LsTab01 = cLsTab + cPerexod
);

!-------------------------------------------------------------------------------
! Для поиска распределения по заказам
!-------------------------------------------------------------------------------
Table Struct tmp_wt_Zakaz
(  cLschet:comp
  ,Yearn  :word
  ,Mesn   :word
  ,cZakaz :comp
  ,sZakaz :string[30]
  ,Proc   :double
  ,Tp     :word//тип формирования - по распределению авансов, по нарядам, по распределению затрат
)
with index
( tmp_wt_Zakaz01=cLschet +YearN+MesN
);

!-------------------------------------------------------------------------------
Table Struct tbl_name_gr "Группировки"
(
  npp  : word   "npp",
  kod  : word   "kod",
  name : string "name"
)
With Index
(
  ind01 = npp,
  ind03 = kod(Unique),
  ind02 = name(Unique)
);


