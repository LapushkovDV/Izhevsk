var
 CS: IContextSession; // для захвата прикладного контекста табеля
 iCatFunc  : CatalogsFunctions;
 piTuneIer : iTuneIer; //objTuneIer;
 oGP_Log   : GP_Log;
 iQBuilder:GP_QueryBuilder new;
var
 IndexNo        :Longint;
 NameGroup      :String;
 KodGroup       :String;
 nppTmp         :Word;
 kodTmp         :Word;
 wSort          :word;
 fCurrMainFormat:longint;//основной формат
 kol_fld        :word; //кол-во выводимых полей
 isPodrShare    :boolean; //включено разграничение прав
 sUserName      :string;// текущий пользователь
 pNotationRV1,pNotationRV2,  pNotationK,pNotationC:comp;
 DTB,DTE :date; //период формирования отчета
 WT_DTB,WT_DTE :date; //период формирования отчета
 wYearN :word; // год табеля
 wMesN  :word; // месяц табеля
 ActualHours:double;
 ch_work    :double; //итого отработано
 zakaz_max  :word;
#include Excel_Var.Vpp
//------- фильтры
  Marker_Count :longint;
  KauMarkerName:string;
  Marker_Tmp :longint;
  wFilter    :longint;
//----------------------------------------------
Create View
var
  pUserDeskRep:comp;
  pPersons    :comp;
  pNode       :comp;
  wc_Nrec     :comp;
  pLschet     :comp;
  pPEREXOD    :comp;
as select tmp_wt_zak.*,tmp_wt_z_LsTab.*
,if(UserDeskRep.RESLNGINT[05]=1,CatPost_Flt.Name
   ,if(UserDeskRep.RESLNGINT[05]>1,'Выбрано '+string(UserDeskRep.RESLNGINT[05])+' записей'
      ,'не задано'  ) ) (FieldName=Flt_Post)
,if(UserDeskRep.RESLNGINT[06]=1,Katpodr_Flt1.Name
   ,if(UserDeskRep.RESLNGINT[06]>1,'Выбрано '+string(UserDeskRep.RESLNGINT[06])+' записей'
      ,'не задано'  ) ) (FieldName=Flt_Podr)
,if(UserDeskRep.RESLNGINT[07]=1,KlKatego_Flt.NaiKat
   ,if(UserDeskRep.RESLNGINT[07]>1,'Выбрано '+string(UserDeskRep.RESLNGINT[07])+' записей'
      ,'не задано'  ) ) (FieldName=Flt_Kateg)
,if(UserDeskRep.RESLNGINT[08]=1,Persons_Flt.Fio
   ,if(UserDeskRep.RESLNGINT[08]>1,'Выбрано '+string(UserDeskRep.RESLNGINT[08])+' записей'
      ,'не задано'  ) ) (FieldName=Flt_Persons)
from
   UserDeskRep
  //==============Вывод
  ,tmp_wt_zak    (tmp_wt_zak01)
  ,tmp_wt_zak tmp_wt_zak_Sub
  ,tmp_wt_zak tmp_wt_zak_fnd
  ,tbl_name_Gr(ind01)
  ,tbl_name_Gr tbl_LLL(ind01)
  ,tbl_name_Gr tbl_RRR(ind01)
  ,tmp_wt_z_LsTab(tmp_wt_z_LsTab01)
  ,tmp_wt_Zakaz
  // фильтры
  , KatPodr KatPodr_Flt
  , KatPodr KatPodr_Flt1
  , Catalogs CatPost_Flt
  , KlKatego KlKatego_Flt
  , Persons  Persons_Flt
  , PEREXOD
where  ((
//--------------- для визуализации
    pNode == tmp_wt_zak.cRec
and tmp_wt_zak.Nrec == tmp_wt_zak_Sub.cRec
//--------   Настройки отчета
and cgGP_Report_21001 == UserDeskRep.NRep
and sUserName         == UserDeskRep.OwnName
and pLschet == LsTab.cLschet
and wYearN == LsTab.YearN
and wMesN  == LsTab.MesN
and pPEREXOD == PEREXOD.Nrec
// распределение позаказно
and pLschet == tmp_wt_Zakaz.cLschet
and wYearN  == tmp_wt_Zakaz.YearN
and wMesN   == tmp_wt_Zakaz.MesN
//-----------
and pLschet  == prnaryad.clsch
and WT_dte>>=prnaryad.DataN(noindex)
and (WT_dtb <=prnaryad.DatOk or prnaryad.DatOk=ZeroDate)
//-----------
and pLschet  == GP_RASPAVANS.cLschet
//and 0 == GP_RaspAvans.isArh
and WT_dte  >>=GP_RaspAvans.DataN (noindex)
and (WT_dtB <=GP_RaspAvans.DataOk or GP_RaspAvans.DataOk=ZeroDate)
//-----------
// Распределение затрат
and pcCostSharing   == PRVIDOPL.CHOICE
and pLschet         == PRVIDOPL.CLSCH
and WT_DTB          == PRVIDOPL.DATAN (noindex)

//-----------------
and UserDeskRep.ResComp[1]  == AllMemo.Nrec
//-----------------
and UserDeskRep.ResComp[5] == CatPost_Flt.Nrec
and UserDeskRep.ResComp[6] == Katpodr_Flt1.Nrec
and UserDeskRep.ResComp[7] == KlKatego_Flt.Nrec
and UserDeskRep.ResComp[8] == Persons_Flt.Nrec
//----------- Группировки
and 0 == tbl_LLL.npp
AND 0 << tbl_RRR.npp

//----------------------------
and wc_Nrec == KatPodr_Flt.Nrec
))
;
//----------------------------
create view lPMarker
var pUserDeskRep :comp;
as select PickRep.cUserDeskRep
From PickRep
where ((
  pUserDeskRep  == PickRep.cUserDeskRep
))
;


//--------------------------------
Create  view vZar_User
var
   pPodr:comp;
as select Zar_User.Nrec
From
   Zar_User
  ,GP_USERRIGHTS
  ,USERRIGHTS
  ,KatLink
where
((   sUserName  == Zar_User.OwnName
and  sUserName  == GP_USERRIGHTS.OWNNAME
//and  pPodr    == GP_USERRIGHTS.crecds
and  0          == GP_USERRIGHTS.wType
and  sUserName  == USERRIGHTS.OWNNAME
//and  pPodr    == GP_USERRIGHTS.crecds
//and  0          == USERRIGHTS.wType
//--------------------------
and  sUserName == katlink.OWNNAME
and  coGrPodr  == katlink.CODETABLE
and  0         == katlink.code

));
//------------------------------------
Create view vSpr
var
  pPerson :comp;
  pMnPlan :comp;
  pVPlan :comp;
  pLschet:comp;
  pPost  :comp;
  dDTE:date;
From Persons
   , Appointments,MnPlan,VPlan
   , Appointments Appointments2(APNTBYPERSON)
where
((  pPerson == Persons.Nrec
and Persons.Appointcur == Appointments.Nrec
and pMnPlan  == MnPlan.Nrec
and pVplan   == Vplan.Nrec
and pPerson ==  Appointments2.Person
and pLschet ==  Appointments2.cAddNrec2(noindex)
and pPost   ==  Appointments2.Post(noindex)
and dDTE    >>= Appointments2.AppointDate


));

//------------------------------------
create view vPodr
var
 sPodr_kod:string;
From KatPodr
where (( sPodr_kod == KatPodr.kod));

//------------------------------------
Create view v1
from  UOWRKTABEL;


