/*************************************************************************************************\
* Наименование: Формирование ведомости на уволенных                                               *
* Контур/Модуль: ЗП                                                                               *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#5907         |11/04/18|Плинда Н.А.              |НПО Энергомаш                     *
\*************************************************************************************************/

interface gp_formVedUv 'Обработка перечислений уволенных на дату' EscClose, Gray;
  show at (,,80,10);


create view
as select
 lschet.nrec
from
  shtraf
, lschet
, uder
;

var
DataForm : date;
Counter :longint;
Metka:boolean;
SummUder:double;

screen scr ('Параметры отчета',,sci178EnEscInsPM);
!  show at (,,,1)
  fields
  DataForm:         NoProtect;

buttons
    cmGo, ,, 'Обработать' ,,;
    <<
   `Дата увольнения`.@@@@@@@@@@

    <.Сформировать.>

    >>

end;

handleevent
cmGo:
{

 if DataForm=date(0,0,0)
 {
  message('Нулевая дата!');
  exit;
 }

 METKA := FALSE;
 Counter:=0;

	_loop lschet
	{
	if lschet.datuv<>DataForm
	continue;


	SummUder:=0;
//		_loop uder where ((lschet.nrec==uder.clsch and year(DataForm)==uder.yearn and month(DataForm)-1==uder.mesn and 220==uder.viduds))
		_loop uder where ((lschet.nrec==uder.clsch and year(Add_Months(DataForm,-1))==uder.yearn and month(Add_Months(DataForm,-1))==uder.mesn and 220==uder.viduds))
		{
  		uder.vidud    :=501;
  		uder.viduds   :=229;
  		uder.INTUD[3] :=229;
	  	update current uder;
	  	SummUder := SummUder + uder.sumud;
		}

		if SummUder>0
		{
  		clearbuffer(#shtraf);
  		 shtraf.CEX      := lschet.cex;
  		 shtraf.NOMDOK   := 1;
  		 shtraf.POMETKA  := '-';
  		 shtraf.VIDUD    := 229;
  		 shtraf.SUMUDALL := SummUder;
  		 shtraf.SUMUD    := SummUder;
  		 shtraf.datok    := date(last_day(date(1,month(Add_Months(DataForm,-1)),year(Add_Months(DataForm,-1)))),month(Add_Months(DataForm,-1)),year(Add_Months(DataForm,-1)));
  		 shtraf.NAMEPL1  := 'Выплата уволенным';
  		 shtraf.PRPER    := 1;
  		 shtraf.OSTATPR  := -summUder;
  		 shtraf.CLSCH    := lschet.nrec;
  		 shtraf.TPERSON  := lschet.tperson;
  		 shtraf.FLAG3    := '+';
  		 shtraf.STRTABN  := lschet.strtabn;
  		insert current shtraf;
  		Metka := true;
  		Counter++;
		}


	}

 if Metka=true
 {
   message('Дата обработана по '+Counter+' сотрудникам. Формируйте реестры по 501 коду!');
 }
 else
 {
   message('Нет данных для обработки!');
 }
}

end;
end.



#include UserReport.vih

VipInterface UserReport_gp_formVedUv Implements IUserReport;
Interface UserReport_gp_formVedUv;

Procedure Run;
Begin
  runinterface(gp_formVedUv);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Обработка перечислений уволенных на дату';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Обработка корректировочных табелей';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
