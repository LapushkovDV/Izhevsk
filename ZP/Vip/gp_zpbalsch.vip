windowevent wnSelmnf;

cmdefault:
{

  sqlDropTmpTable ('tSelmnfUser');
  sqlCreateTmpTable('table tSelmnfUser (name: string) with index (i1 = name);', ctmNormal);

    SubBounds(tbRmtSelmnf1);
    AddBounds(tbRmtSelmnf2);

    _loop pmarkermnf
    {
      Filtr_cmnf := tSelmnf.name;

      stmt := sqlAllocStmt;
      ClearQuery(vliSQLCommand);
      PrepareSQLQuery('insert into tSelmnfUser (name) values ('''+Filtr_cmnf+''') ');
      ExecDSQLex(0);
    }

    delete all from tSelPodr;

    ClearQuery(vliSQLCommand);
    PrepareSQLQuery('select katpodr1.nrec, katpodr1.kod, katpodr1.name');
    PrepareSQLQuery('from katpodr');
    PrepareSQLQuery('inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)  ');
    PrepareSQLQuery('inner join extcatlinks on extcatlinks.extcat = katpodr.nrec');
    PrepareSQLQuery('inner join catalogs on catalogs.nrec = extcatlinks.staffcat');
    PrepareSQLQuery('inner join attrval on attrval.crec = catalogs.nrec');
    PrepareSQLQuery('inner join attrnam on attrnam.nrec = attrval.cattrnam');
    PrepareSQLQuery('inner join zar_user on (upper(zar_user.ownname) = upper('''+pUserName+'''))');
    PrepareSQLQuery('where attrnam.name = ''Вид производства'' and (attrval.vstring in (select tSelmnfUser.name from tSelmnfUser)) and (zar_user.podrshare <> ''+'' or (katpodr.nrec in (select userrights.crecds from userrights where zar_user.ownname = userrights.ownname)))');
    PrepareSQLQuery('group by katpodr1.nrec, katpodr1.kod, katpodr1.name');
    PrepareSQLQuery('order by katpodr1.kod');
    stmt:=0;
    stmt := sqlAllocStmt;
    wErr:=ExecDSQLex(tntSelPodr);

    pMarkerpodr.UnselectAll;

    if pMarkermnf.count = 0
    {
      Filtr_mnf:= 'Не выбрано';
      Filtr_katpodr:= 'Выберете вид производства';
    }

    _loop pMarkermnf
    {
      if pMarkermnf.count = 1
      {
        Filtr_mnf:= tSelmnf.name;
        Filtr_katpodr:= 'Не выбрано';
      }
    }

    SubBounds(tbRmtSelmnf2);
    AddBounds(tbRmtSelmnf1);

    if pMarkermnf.count > 1
    {
      Filtr_mnf:= 'Выбрано ' + pMarkermnf.count;
      Filtr_katpodr:= 'Не выбрано';
    }
}

end;

windowevent wnSelPodr;

cmdefault:
{
    if pMarkerpodr.count = 0 and pMarkermnf.count <> 0
    {
      Filtr_katpodr:= 'Не выбрано';
    }

    if pMarkerpodr.count = 0 and pMarkermnf.count = 0
    {
      Filtr_katpodr:= 'Выберете вид производства';
    }

    SubBounds(tbRmtSelPodr1);
    AddBounds(tbRmtSelPodr2);

    _loop pMarkerpodr
    {
      if pMarkerpodr.count = 1
      {
        Filtr_katpodr:= tSelPodr.kod + ' ' + tSelpodr.name;
      }
    }

    SubBounds(tbRmtSelPodr2);
    AddBounds(tbRmtSelPodr1);

    if pMarkerpodr.count > 1
    {
      Filtr_katpodr:= 'Выбрано ' + pMarkerpodr.count;
    }
}

end;

end.

VipInterface UserReport_zpbalsch Implements IUserReport;
Interface UserReport_zpbalsch;

Procedure Run;
Begin
  runinterface(gp_zpbalsch);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Ведомость распределения з/п по балансовым счетам (с резервом на отпуска)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Экономическая и статистическая отчетность';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
