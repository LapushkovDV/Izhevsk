      PrepareSQLQuery('                    )) ');
      PrepareSQLQuery('left join nachislzakaz nachisl3 on nachisl3.nrec = nachislzakaz.nrec and nachisl3.vidopls = klvidopl.vidopl and klvidopl.kauextr[1] = stzatr.nrec ');
      PrepareSQLQuery('and (stzatr.name = ''04 Премии'' or stzatr.name = ''04.1 Премия не уменьшающая налогообл.базу'' or stzatr.name = ''104 Проект "Управление качеством:автоматизированный учет отступлений от КД и ТД '' ');
      PrepareSQLQuery('or stzatr.name = ''106 Проект "Управление качеством: разработка и внедрение системы учета затрат ка'')');
      PrepareSQLQuery('where nachislzakaz.mesn = '+mes+' and nachislzakaz.yearn = '+god+' and (katpodr1.nrec in (select tSelPodrUser.nrec from tSelPodrUser))');
      stmt:=0;
      stmt := sqlAllocStmt;
      wErr:=ExecDSQLex(tncomplex);

      delete all from complex2;


     ClearQuery(vliSQLCommand);
      PrepareSQLQuery('select');
      PrepareSQLQuery(' sum(coalesce(perevodtekzakaz8.sumper,0)),');
      PrepareSQLQuery('sum(coalesce(perevodtekzakaz2.sumper,0)) + sum(coalesce(perevodtekzakaz3.sumper,0)) + sum(coalesce(perevodtekzakaz5.sumper,0)) + sum(coalesce(perevodtekzakaz11.sumper,0)) +');
      PrepareSQLQuery('sum(coalesce(perevodtekzakaz12.sumper,0)) + sum(coalesce(perevodtekzakaz14.sumper,0)), sum(coalesce(perevodtekzakaz13.sumper,0))');
      PrepareSQLQuery('from mnplan');
      PrepareSQLQuery('left join perevodtekzakaz on perevodtekzakaz.mesn = '+mes+'');
      PrepareSQLQuery('    and perevodtekzakaz.yearn = '+god+'');
      PrepareSQLQuery('    and perevodtekzakaz.vidper = 8');
      PrepareSQLQuery('    and perevodtekzakaz.ckaud[1] = mnplan.nrec');
      PrepareSQLQuery('    and perevodtekzakaz.tbld[1] = 7');
      PrepareSQLQuery('left join katpodr on katpodr.nrec = perevodtekzakaz.cexoz');
      PrepareSQLQuery('inner join katpodr katpodr1 on katpodr1.kod = substring(katpodr.kod,1,3)');
      PrepareSQLQuery('    and (katpodr1.nrec in (select tSelPodrUser.nrec from tSelPodrUser))');
      PrepareSQLQuery('inner join extcatlinks on extcatlinks.extcat = katpodr.nrec');
      PrepareSQLQuery('inner join catalogs on catalogs.nrec = extcatlinks.staffcat');
      PrepareSQLQuery('inner join attrval on attrval.crec = catalogs.nrec');
      PrepareSQLQuery('inner join attrnam on attrnam.nrec = attrval.cattrnam and attrnam.name = ''Вид производства'' ');
      PrepareSQLQuery('left join perevodtekzakaz perevodtekzakaz2 on perevodtekzakaz2.cnach = perevodtekzakaz.cnach and perevodtekzakaz2.mesn = perevodtekzakaz.mesn and perevodtekzakaz2.vidper =2');
      PrepareSQLQuery('left join perevodtekzakaz perevodtekzakaz3 on perevodtekzakaz3.cnach = perevodtekzakaz.cnach and perevodtekzakaz3.mesn = perevodtekzakaz.mesn and perevodtekzakaz3.vidper =3');
      PrepareSQLQuery('left join perevodtekzakaz perevodtekzakaz5 on perevodtekzakaz5.cnach = perevodtekzakaz.cnach and perevodtekzakaz5.mesn = perevodtekzakaz.mesn and perevodtekzakaz5.vidper =5');
      PrepareSQLQuery('left join perevodtekzakaz perevodtekzakaz8 on perevodtekzakaz8.cnach = perevodtekzakaz.cnach and perevodtekzakaz8.mesn = perevodtekzakaz.mesn and perevodtekzakaz8.vidper =8');
      PrepareSQLQuery('left join perevodtekzakaz perevodtekzakaz11 on perevodtekzakaz11.cnach = perevodtekzakaz.cnach and perevodtekzakaz11.mesn = perevodtekzakaz.mesn and perevodtekzakaz11.vidper =11');
      PrepareSQLQuery('left join perevodtekzakaz perevodtekzakaz12 on perevodtekzakaz12.cnach = perevodtekzakaz.cnach and perevodtekzakaz12.mesn = perevodtekzakaz.mesn and perevodtekzakaz12.vidper =12');
      PrepareSQLQuery('left join perevodtekzakaz perevodtekzakaz14 on perevodtekzakaz14.cnach = perevodtekzakaz.cnach and perevodtekzakaz14.mesn = perevodtekzakaz.mesn and perevodtekzakaz14.vidper =14');
      PrepareSQLQuery('left join perevodtekzakaz perevodtekzakaz13 on perevodtekzakaz13.cnach = perevodtekzakaz.cnach and perevodtekzakaz13.mesn = perevodtekzakaz.mesn and perevodtekzakaz13.vidper = 13');
     stmt:=0;
      stmt := sqlAllocStmt;
      wErr:=ExecDSQLex(tncomplex2);

        counter++;
        xlmergecells(counter,1,counter,5);
        xlsetcellstringvalue('Всего по комплексам:', counter,1,counter,1);
        xlsetcellnumbervalue(complex.ozp, counter,6,counter,6);
        xlsetcellnumbervalue(complex.dzp + complex2.s3, counter,7,counter,7);
        xlsetcellnumbervalue(complex.prem, counter,8,counter,8);
        xlsetcellstringvalue('=RC[-3]+RC[-2]+RC[-1]', counter,9,counter,9);
        xlsetfontstyle(1, counter, 1, counter, 12);
        xlsetcellnumbervalue(complex2.s1, counter,10,counter,10);
        xlsetcellnumbervalue(complex2.s2, counter,11,counter,11);
        xlsetcellstringvalue('=RC[-3]+RC[-2]+RC[-1]', counter,12,counter,12);

SubBounds(tbRmtSelPodr2);
AddBounds(tbRmtSelPodr1);

xlframecells(1+2+4+8+16+32, 3, 1, 1, 7, 1, counter, 12);

StopVisual('',0);
