//VII. Доработка табеля учета рабочего времени
//$[RedMine]\em_dev\GP_Staff.Res
#include MacroSch.vpp
#include Contexts.vih  // Контексты
#include Protector.vih
#include GP_SCUD_EventsEdit.vih

#include Z_WT##WTSCUD_Events.vih

#component "Z_WT"
//=======================================
Interface WTSCUD_Events;
var
// iGP_SCUD_EventsEdit:GP_SCUD_EventsEdit;
 iGP_SCUD_EventsEdit:GP_SCUD_Ev_IN;
create view
var
  pWorkingTable:comp;
  SelectedRange:longint;
  pChange : comp;
  boPeriod: boolean;
  pGP_SCUD_Pers:comp;
  IsReadOnly:boolean;
as select LsTab.nrec
From LsTab
where
((
    pWorkingTable == LsTab.Nrec
and LsTab.tPerson == Gp_Scud_Pers.cPersons
))
;


  function IsEditable: boolean;
  {
    result := False;
  }
  procedure OnPositionChanged;
  {
    //SetHelpAndStatusContext(TotalsBrowse, #ActualHoursStr, GetEditableStatusLine, hcUseOwner)
    //UpdateHelpLine;
  }


  #doc
    Перерисовывает своё содержимое.
  #end
  procedure ReDraw;
  { //if

  }
  #doc
    Обновляет и перерисовывает своё содержимое.
  #end
  procedure ReRead;
  { //UpdateTable;
    ReReadRecord(#LsTab)

  }
  #doc
    Сохраняет внесенные изменения.
  #end
  function UpdateIfModified: boolean;
  { //UpdateTable;
    Result:=true;
  }

  //------------------------------------------------------------------------------
  public procedure LinkTo(WorkingTable: comp;_SelectedRange:longint; _Change:comp;_Dbeg:date;_DEnd:date );
  { //bDayOfMonth:=DayOfMonth;
    SelectedRange:=_SelectedRange;
    set pChange := _Change;
    if _SelectedRange=-1
    { boPeriod:=false;
    }
    else
    { boPeriod:=True;
    }
    pWorkingTable := WorkingTable;
    if Getfirst Lstab=tsok
    { if getfirst GP_SCUD_PERS=tsok
       set pGP_SCUD_Pers:=GP_SCUD_PERS.Nrec
      else
       set pGP_SCUD_Pers:=-1;
    }
    else
    { set pGP_SCUD_Pers:=-1;
    }
    if timelog_Status>0
     Timelog('WTSCUD_Events->LinkTo:pGP_SCUD_Pers='+string(pGP_SCUD_Pers,0,0)
      +',_DBeg='+DatetoStr(_Dbeg,'DD/MM/YYYY - ')+', _Dend='+DatetoStr(_DEnd,'DD/MM/YYYY'));
    iGP_SCUD_EventsEdit.InitParam(
       cgiNotEdit //_IntMode
      ,0 //_Nrec
      ,pGP_SCUD_Pers //_cGP_SCUD_Pers
      ,0 //_cKatpodr
      ,0 //_cKatOrg
      ,_DBeg
      ,_DEnd
      ,false);
    if timelog_Status>0
     Timelog('WTSCUD_Events->LinkTo:Final');
  }

  //------------------------------------------------------------------------------
// реализации методов IProtectable
//------------------------------------------------------------------------------
  public procedure SetProtected(Value: boolean);
  {
    IsReadOnly := Value;

    OnPositionChanged;
  }

  public function GetProtected: boolean;
  {
    result := IsReadOnly;
  }

//------------------------------------------------------
Embedded emDocSP 'Выходы сотрудника' Interface    iGP_SCUD_EventsEdit.wnEventsPers;
//..show at (,17,60,);
end;



//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
HandleEvent
cmOnVipLoad:
{ Timelog_Init;
}
cmOnVipUnLoad:
{
}
end;
end.
