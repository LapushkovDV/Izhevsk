#component "Z_KATPODR"
#doc
ЗП/Настройка/Администратор/Настройки пользователей
Переключение на линейный режим на закладке подразделения
#end

Alter Interface SELPODR;
var
  IsCurrTree: boolean; // дерево или список
//*******************************************************************
// Визуальная часть
//*******************************************************************
browse brPodr;
  Table KatPodr;
  recMarker = PMarker {KatPodr.Nrec};
Fields
  //{font = {color = if (Marked, ColorMark, 0 )}};
  //MarkedStr 'V' ('Пометка подразделения'): [1], protect, noAutoSize;
  KatPodr.Name 'Наименование' ('Наименование подразделения'): [50], protect;
  KatPodr.Kod  'Код' ('Код подразделения'): [20], protect;
End;

//**************************************************************
//***********   Процедуры и функции ****************************
//**************************************************************


//**************************************************************
//*********** С О Б Ы Т И Я   И Н Т Е Р Ф Е Й С А **************
//**************************************************************
HandleEvent
  cmInit:
  { IsCurrTree:=true;
    case inherited::handleEvent(cmInit) of
     heAbort: { abort; exit; }
     heStop: { stop; exit; }
    end;

  }

  cmAccording :
  { var _pNrec:comp;
    _pNrec:=KATPODR.Nrec;
    if IsCurrTree  // из дерева в список
    { IsCurrTree := false;
      ResetBounds(tnKatPodr);
      if getfirst KatPodr where (( _pNrec == KatPodr.Nrec ))=tsok {}
      SetFormat(brPodr);
      ReScanPanel(tnKatPodr);
    }
    else  // из списка в дерево
    { IsCurrTree := true;
      PushBounds(tnKatPodr);
      SetFormat(trPodr);
      ReScanPanel(tnKatPodr);
      TreeJumpToRecord(trPodr, _pNrec);
      ReScanPanel(tnKatPodr);
    }
  }
  cmHotKeys:
  {  PutHotCommand(RunMenu('mnuSELPODR_HoyKey'));
  }

end;
end.

//-----------------
#IFDEF _GP_
mnuSELPODR_HoyKey Menu
{
 - 'Режим представления: линейный/иерархический',cmAccording,'Режим представления: линейный/иерархический',hcNoContext,'Alt+S',kbAltS, sci1Esc;
}
#ENDIF
