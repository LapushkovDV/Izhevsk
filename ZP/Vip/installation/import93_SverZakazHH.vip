/*************************************************************************************************\
* Наименование: Сверка часов по заказу из КИС с Галактикой                                        *
* Контур/Модуль: Зарплата.                                                                        *
* Примечание:  Нужен только на этапе импорта и сверки данных из КИС. Запускается из АРД отчетов.  *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1800         |31/01/18|Шунин А.Г.               |НПО Энергомаш                    *
* Разработка  |#1813         |05/01/18|Шунин А.Г.               |НПО Энергомаш                    *
\*************************************************************************************************/

Interface import93_SverZakazHH   escclose;

table struct tZakK
(
  tPerson: comp,
  SOVM: word,
  FIO   : string[80],
  Number: string[30],
  line: longint,
  xlHH: double,
  kAll: word,
  WORKTYPE2: string[30],
  key: word
)
with index (p01=tPerson + SOVM + kAll + Number);

table struct tZakG
(
  tPerson: comp,
  SOVM: word,
  CLSCH  : comp,
  FIO   : string[80],
  Number: string[30],
  NumRec:comp,
  galHH: double,
  kAll: word,
  key: word
)
with index (p01= tPerson + SOVM+ kAll  + Number,
p02= tPerson + SOVM+ kAll  + NumRec
);


create view vM

var
Counter, MaxLine, MaxCol : longint;
ExcelFile:string;

NrecPers:longint;

xlFIO, PAYBILL1, DOCNUMB, WORKTYPE, WORKTYPE2  :string;
PAYTIME1 : double;
bBbk : boolean;
kAll : word;

wSOVM : word;

pDate: Date;


from  persons, PRVIDOPL,MNPLAN, MNPLAN MNPLAN2, prnaryad
, tZakK
, tZakG
, tZakG ZakGal
, PASSPORTS
where
((
       /*
SQL
select

from persons
inner join LSCHETon persons.nRec = LSCHET.tPerson
            */
      persons.nRec == LSCHET.tPerson

 and
                18 == PRVIDOPL.CHOICE
and    LSCHET.nRec == PRVIDOPL.CLSCH
and         pDate  == PRVIDOPL.DATAN (noindex)


and
     PRVIDOPL.CKAUD[1] == MNPLAN.nRec

AND     LSCHET.CKAUD[1] == MNPLAN2.nRec

and
         LSCHET.tPerson == ZakGal.tPerson
and         LSCHET.Sovm == ZakGal.Sovm
and               kAll  == ZakGal.kAll
and       MNPLAN.nRec   == ZakGal.NumRec


 /*
and     LSCHET.nrec == LSTAB.CLSCHET
and 2018 == YEARN
and 1==LSTAB.MESN
    */

/*
        tZakG.tPerson  == ZakGal2.tPerson
and     tZakG.Sovm     == ZakGal2.Sovm
and     tZakG.kAll     == ZakGal2.kAll
and     tZakG.Number   == ZakGal2.Number
  */

))

;


procedure xlOut1(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}

function PovremenSCHIK_Out: word;
{
  var iKey: word = 0;
  PovremenSCHIK_Out := iKey;

  if tZakK.WORKTYPE2 <> 'Повременщик' exit;


      _LOOP Persons where (( tZakK.tPerson == Persons.nRec))
      {
        wSovm := tZakK.Sovm;


        if getfirst LSCHET where (( Persons.nRec == LSCHET.tPerson and wSovm == LSCHET.Sovm (noindex) )) <> tsOK
        if wSovm = 0
        {
          xlOut1(1,'Нет л/с в Галактике');
          exit; // continue;

        }else
        {
          if getfirst LSCHET where (( Persons.nRec == LSCHET.tPerson and wSovm << LSCHET.Sovm (noindex) )) <> tsOK
          {
            xlOut1(1,'Нет л/с в Галактике');
            exit; // continue;
          }
        }

        iKey++;
        if getfirst prnaryad where (( LSCHET.nRec ==prnaryad.clsch )) = tsOK
        {
          xlOut1(1,'Работает по нарядам');
        }
        else
          xlOut1(1,'Нет в Галактике и Наряд не найден');

      }

  PovremenSCHIK_Out := iKey;
}

  screen createdScreen;
    fields
      pDate: noProtect;
      ExcelFile:NoProtect, PickButton;

    buttons
      cmRassch;
<<

 `PRVIDOPL.DATAN`
  .@@@@@@@@@@@

  Файл КИС.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

                  <. Пуск .>
>>
  end;
HandleEvent

CmInit:
{

  if not ReadMyDsk(pDate   , 'SverZakazHH_pDate'  ,    false) pDate := Date(01,02,2018);
  if not ReadMyDsk(ExcelFile , 'SverZakazHH_ExcelFile',    false)
  {
    ExcelFile := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\';
    ExcelFile := ExcelFile+'ЗАКАЗЫ ЯНВ СПИСКОМ_1.xlsx'
  }
}
cmRassch:
{
 SaveMyDsk(pDate    , 'SverZakazHH_pDate');
 SaveMyDsk(ExcelFile  , 'SverZakazHH_ExcelFile');

MaxLine := RecordsInTable(#persons);
StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Загрузка заказов из Галактики ...', MaxLine div 5);

Counter:=1;
_Loop persons
{
if ( ( persons.DISDATE = Date(0,0,0)) or (persons.DISDATE >= pDate) )
_Loop LSCHET
{

  Counter++;

  if Counter mod 5 = 0
  if not nextvisual  bBbk := true;
  if bBbk break;

  kAll := 0;

   _Loop PRVIDOPL
   _Loop MNPLAN
   {
      if getfirst ZakGal = tsOK
      {
        ZakGal.galHH := ZakGal.galHH + PRVIDOPL.CHASF  ;
        UpDate current ZakGal;
      }
      else
      {
        clearbuffer(#tZakG);
        tZakG.tPerson:= persons.nRec;

        tZakG.SOVM := LSCHET.SOVM;

        tZakG.CLSCH  := LSCHET.nRec;
        tZakG.FIO    :=persons.FIO;
        tZakG.Number :=MNPLAN.Number;
        tZakG.galHH  := PRVIDOPL.CHASF;
        tZakG.NumRec := MNPLAN.nRec;
        insert current tZakG;

      }

     // kAll++;

   }

  // if kAll = 0
  if LSCHET.CKAUD[1] > 0
  {
      _Loop MNPLAN2
      {
        clearbuffer(#tZakG);
        tZakG.tPerson:= persons.nRec;
        tZakG.SOVM := LSCHET.SOVM;
        tZakG.CLSCH  := LSCHET.nRec;
        tZakG.FIO    := persons.FIO;
        tZakG.Number := MNPLAN2.Number;
        tZakG.NumRec := MNPLAN2.nRec;
        tZakG.kAll := 1;

        insert current tZakG;

      }
  }

}

  if bBbk break;

}
vM.PutTableToDBF (#tZakG,'tZakG00.XLS',0);

UpDate tZakG set tZakG.Number := trim (tZakG.Number ),  tZakG.SOVM := if(tZakG.SOVM > 0 ,1,0);

// Не понятно почему, но записи tZakG не группирует.
// Группруем ещё раз

StopVisual('',0);



    xlCreateExcelWithTemplate(ExcelFile,true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');


    xlGetUsedRange(0,0,MaxLine,MaxCol);

StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel ...', MaxLine div 5);

Counter:=1;

while counter < MaxLine
do
{
  Counter++;

  if Counter mod 5 = 0
  if not nextvisual break;

  xlgetcellvalue(Counter, 2,NrecPers );

if NrecPers=0
{
break;
}
  xlgetcellvalue(Counter, 4,xlFIO  );

  kAll := 0 ; // Тут как признак поиска в persons

  if getfirst persons where ((NrecPers==persons.nrec and ( ( persons.DISDATE = Date(0,0,0)) or (persons.DISDATE >= pDate) )   ))<>tsok
  {
    xlOut1(1,'Не найден PERSON');

    //
    //    Ищем по ФИО и СНИЛС
    //

    xlgetcellvalue(Counter, 6,DOCNUMB  ); DOCNUMB := trim(DOCNUMB);

    _Loop persons where (('С' == persons.ISEMPLOYEE and xlFIO==persons.FIO and ( ( persons.DISDATE = Date(0,0,0)) or (persons.DISDATE >= pDate) )  ))
    {

      _Loop  PASSPORTS where ((persons.nrec == PASSPORTS.person
                                    and 501 == PASSPORTS.SYSCODE ))

      {
        if DOCNUMB = trim(PASSPORTS.NMB)   {kAll++; break;}

      }

        if kAll > 0  break;
    }

    if kAll = 0 continue;



  }//  if getfirst persons where ((NrecPers==persons.nrec))<>tsok

  if kAll = 0  xlOut1(7,'Найден по ID') else xlOut1(7,'Нашёл по ФИО и СНИЛС');


  xlFIO := trim(xlFIO);
  Persons.FIO := trim(Persons.FIO);

  if UpCase(xlFIO) <> UpCase(Persons.FIO)
  xlOut1(1,'ФИО не совпадает');


    xlOut1(2,String(persons.nrec,0,0)  );
    xlOut1(3,Persons.FIO               );


  xlgetcellvalue(Counter, 7,PAYBILL1); PAYBILL1 := trim(Replace(PAYBILL1,'К','')); // Убрать "К" в Заказе
  xlgetcellvalue(Counter, 8,PAYTIME1);
  xlgetcellvalue(Counter,10,WORKTYPE);
  if PAYTIME1 > 0.01 kAll := 0 else kAll := 1;

    wSOVM := 0; // основной
    if WORKTYPE='СОВМ.' wSOVM := 1;

  xlgetcellvalue(Counter,12,WORKTYPE2);



  if getfirst tZakK where (( persons.nrec == tZakK.tPerson and wSOVM == tZakK.SOVM and kAll == tZakK.kAll and PAYBILL1 == tZakK.Number)) = tsOK
  {

     if tZakK.key = 10
     {
       if WORKTYPE2 <> 'Сдельщик'
       xlOut1(8,'А был Сдельщиком в строке' + tZakK.line);

     }else
     {
       if WORKTYPE2 = 'Сдельщик'
       xlOut1(8,'А теперь Сдельщиком');

     }



     if kAll = 1
     {
       xlOut1(1,'Дубль в Excel');

     }else
     {
       tZakK.xlHH := tZakK.xlHH + PAYTIME1;
       UpDate current tZakK;
       xlOut1(1,'Учтено суммой');
     }
  }
  else
  {

      clearbuffer(#tZakK);
      tZakK.kAll := kAll;
      tZakK.tPerson:= persons.nrec;
      tZakK.Sovm := wSOVM;
      tZakK.FIO    := xlFIO;
      tZakK.Number := PAYBILL1;
      tZakK.xlHH   := PAYTIME1;
      tZakK.line := Counter;
      tZakK.WORKTYPE2 := WORKTYPE2;
      if WORKTYPE2 = 'Сдельщик' tZakK.key := 10;     // пометка, чтоб потом пропустить
      insert current tZakK;
  }

} // do while counter < MaxLine




vM.PutTableToDBF (#tZakK,'tZakK0.XLS',0);

vM.PutTableToDBF (#tZakG,'tZakG0.XLS',0);

  SetVisualHeader('Обработка данных этап 1/4');

//
//     от КИС по Галактике
//
// Пропускаем сдельщиков. Удаляем их из таблиц для сверки
_Loop tZakK
if tZakK.key = 10
{

    _LOOP tZakG where (( tZakK.tPerson == tZakG.tPerson and tZakK.Sovm == tZakG.Sovm))
    {
      Delete current tZakG;
    }


   Counter := tZakK.Line;
   xlOut1(1,'Сдельщик пропускаю');

}

// Повременщик . Только проверить наличие наряда
Delete tZakK where tZakK.key = 10;


vM.PutTableToDBF (#tZakK,'tZakKSd.XLS',0);


 SetVisualHeader('Обработка данных этап 2/4');

// Проверяеем полнеое совпадение

_Loop tZakK
if getfirst tZakG where (( tZakK.tPerson == tZakG.tPerson
                          and tZakK.Sovm == tZakG.Sovm
                          and tZakK.kAll == tZakG.kAll
                        and tZakK.Number == tZakG.Number  )) = tsOK
{
  tZakK.Key :=1;
  Update current tZakK;


  Counter := tZakK.Line;

  if tZakK.kAll = 0
  {
    if tZakK.xlHH = tZakG.galHH
    xlOut1(1,'Cовпадает')
    else
    {
      xlOut1(1,'Не совпадают часы');
      xlOut1(4, tZakG.galHH  );
    }

  }else
  {
    xlOut1(1,'Cовпадает')
  }

  Delete current tZakG;

}else
{
  // Если в Excel часы=пусто, проверяем в табеле Заказ
  // Если в Табеле заказ совпадает - Заказ есть в табеле
  if tZakK.kAll = 1
  {
    if getfirst tZakG where (( tZakK.tPerson == tZakG.tPerson
                              and tZakK.Sovm == tZakG.Sovm
                                       and 0 == tZakG.kAll
                            and tZakK.Number == tZakG.Number  )) = tsOK
    {

       Counter := tZakK.Line;
       xlOut1(1,'Совпадает Заказ в табеле');
       xlOut1(4, tZakG.galHH );
       xlOut1(5, tZakG.Number);

        tZakK.Key :=2;
        Update current tZakK;

        Delete current tZakG;

        continue;
    }


  }else
  {

    if getfirst tZakG where (( tZakK.tPerson == tZakG.tPerson
                              and tZakK.Sovm == tZakG.Sovm
                                       and 1 == tZakG.kAll
                            and tZakK.Number == tZakG.Number  )) = tsOK
    {

       Counter := tZakK.Line;
       xlOut1(1,'Совпадает с Заказом в лицевом');
       xlOut1(6,tZakG.Number);

        tZakK.Key :=3;
        Update current tZakK;

        Delete current tZakG;

        continue;
    }

  }

    Counter := tZakK.Line;

    if PovremenSCHIK_Out = 0
    xlOut1(1,'Нет в Галактике');

}

vM.PutTableToDBF (#tZakG,'tZakG1.XLS',0);

 SetVisualHeader('Обработка данных этап 3/4');

// Delete tZakK where tZakK.Key > 0;

_Loop tZakK
if tZakK.Key  = 0
if tZakK.kAll = 1
if getfirst tZakG where (( tZakK.tPerson == tZakG.tPerson
                          and tZakK.Sovm == tZakG.Sovm
                          and tZakK.kAll == tZakG.kAll )) = tsOK
{
  tZakK.Key := 4;
  Update current tZakK;


  Counter := tZakK.Line;

    if PovremenSCHIK_Out = 0
      xlOut1(1,'Не тот ЗАКАЗ' );

  xlOut1(6, ''''+tZakG.Number  );


  Delete current tZakG;

}

_Loop tZakG
if tZakG.kAll =1
if getfirst tZakK where (( tZakG.tPerson == tZakK.tPerson
                          and tZakG.Sovm == tZakK.Sovm
                                   and 0 == tZakK.kAll
                        and tZakG.Number == tZakK.Number )) = tsOK

{
   Counter := tZakK.Line;

   xlOut1(1,'Совпадает с Заказом в лицевом');
   xlOut1(6,tZakG.Number);

   tZakK.Key := tZakK.Key + 100;
   Update current tZakK;

   Delete current tZakG;

}

_Loop tZakG
if tZakG.kAll =0
if getfirst tZakK where (( tZakG.tPerson == tZakK.tPerson
                          and tZakG.Sovm == tZakK.Sovm
                                   and 1 == tZakK.kAll
                        and tZakG.Number == tZakK.Number )) = tsOK

{
   Counter := tZakK.Line;
   if tZakK.Key = 0
   xlOut1(1,'Совпадает с Заказом в табеле');

   xlOut1(4, tZakG.galHH );
   xlOut1(5, tZakG.Number);

   tZakK.Key := tZakK.Key + 100;
   Update current tZakK;

   Delete current tZakG;

}



vM.PutTableToDBF (#tZakG,'tZakG2.XLS',0);
vM.PutTableToDBF (#tZakK,'tZakK2.XLS',0);


 SetVisualHeader('Обработка данных этап 4/4');

// от Галактике по КИС

Counter := MaxLine + 1;
xlSetCellStringValue('Данные из Галактики, которых нет в Excel',Counter, 4 ,Counter,4);
  xlSetCellStringValue('tPerson h'  ,Counter, 1 ,Counter,1);
  xlSetCellStringValue('tPerson D' ,Counter, 2 ,Counter,2);
  xlSetCellStringValue('Откуда'   ,Counter, 3 ,Counter,3);
  xlSetCellStringValue('FIO'    ,Counter, 4 ,Counter,4);

  xlSetCellStringValue('Заказ' ,Counter, 7 ,Counter,7);

  if tZakG.kAll = 0
  xlSetCellStringValue('galHH'  ,Counter, 8 ,Counter,8);

  xlSetCellStringValue('kisHH' ,Counter, 9 ,Counter,9);
  xlSetCellStringValue('Gal_SOVM' ,Counter, 10 ,Counter,10);

Counter++;
_Loop tZakG
if getfirst tZakK where (( tZakG.tPerson == tZakK.tPerson
                          and tZakG.Sovm == tZakK.Sovm
                          and tZakG.kAll == tZakK.kAll
                        and tZakG.Number == tZakK.Number )) <> tsOK

{
 Counter ++;
  xlSetCellStringValue(String(tZakG.tPerson,0,0) ,Counter, 1 ,Counter,1);
  xlSetCellStringValue(tZakG.tPerson ,Counter, 2 ,Counter,2);
  xlSetCellStringValue('Галактика'  ,Counter, 3 ,Counter,3);
  xlSetCellStringValue(tZakG.FIO    ,Counter, 4 ,Counter,4);

  xlSetCellStringValue(''''+tZakG.Number ,Counter, 7 ,Counter,7);

  if tZakG.kAll = 0
  xlSetCellStringValue(tZakG.galHH  ,Counter, 8 ,Counter,8);

  xlSetCellStringValue(tZakG.Sovm ,Counter, 10 ,Counter,10);

}
else
{
  Counter ++;
  xlSetCellStringValue(String(tZakG.tPerson,0,0) ,Counter, 1 ,Counter,1);
  xlSetCellStringValue(tZakG.tPerson ,Counter, 2 ,Counter,2);
  xlSetCellStringValue('Галактика НЕ ПОНЯТНО'  ,Counter, 3 ,Counter,3);
  xlSetCellStringValue(tZakG.FIO    ,Counter, 4 ,Counter,4);

  xlSetCellStringValue(tZakG.Number ,Counter, 7 ,Counter,7);

  if tZakG.kAll = 0
  xlSetCellStringValue(tZakG.galHH  ,Counter, 8 ,Counter,8);

  xlSetCellStringValue(''''+tZakK.Number ,Counter, 9 ,Counter,9);

  xlSetCellStringValue(tZakG.Sovm ,Counter, 10 ,Counter,10);

}



Counter := 1;
         xlOut1(1,'Статус'            );
         xlOut1(2,'Persons.nRec'      );
         xlOut1(3,'Persons.FIO'       );
         xlOut1(4,'Часы в Галактике'  );
         xlOut1(5,'Заказ в Табеле Галактики'  );
         xlOut1(6,'Заказ в Лицевом Галактики'  );

         xlOut1(7,'Статус поиска');
         xlOut1(8,'Статус постоянства Сдельщика');


StopVisual('',0);
xlkillExcel;

CloseInterface(cmDone);
}

  cmPick:
  { case CurField of
    #ExcelFile:
    { var ww_str:string=GetFileName('*.xlsx','Выберите файл c данными по заказам с часами из КИС');
      if ww_str<>''
      {


         //if Yes=Message('Заменить шаблон этим файлом? ',YesNo)
         {


         }

         set ExcelFile:=ww_str;
      }
    }
    end;
  }



end;
end.




.form import93_SverZakazHH
.nameinlist 'SverZakazHH Сверка часов по заказу из КИС с Галактикой с Учетом Повременщиков 5'
.ard
.begin
runinterface(import93_SverZakazHH);
end.
.endform
