StopVisual('',0);
#_TimeLog('--- end Load Gal --');

#_TimeLog('--- beg DBF --');

LoadFromDBF;
#_TimeLog('--- end DBF --');
if  DBFError < 30000
{
  delete all S;
      /*
ExcelPath:='d:\Source20112017\';

    xlCreateExcelWithTemplate(ExcelPath+'SUMOPL_2017_+ID_+FIO_11.xlsx',true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');
    */
ExcelPath := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\ZP\';


    xlCreateExcelWithTemplate(ExcelPath+'Начисления ЯНВ.xlsx',true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');



  xlGetUsedRange(0,0,MaxLine,MaxCol);

StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Выполняется обработка ...', MaxLine div 5);

dSum:=0;
fSum:=0;
Counter:=1;



#_TimeLog('--- beg Excel --');

while counter < maxLine
do
{
  Counter++;

  if Counter mod 5 = 0
  if not nextvisual break;

  xlgetcellvalue(Counter, 2, NrecPers   );
  xlgetcellvalue(Counter, 4, KodVid    );
  xlgetcellvalue(Counter, 5, MesVK   );
  xlgetcellvalue(Counter, 6, GodVK);
  xlgetcellvalue(Counter, 9, SumN);
  xlgetcellvalue(Counter, 13, VidZap);
  xlgetcellvalue(Counter, 18, VidNazn);
  xlgetcellvalue(Counter, 20, famil);

                          






        if getfirst persons where ((NrecPers==persons.nrec))=tsok
        {


                if ((VidNazn='Основное место работы' or VidNazn='Декретный отпуск') ) // and VidZap='Начисление')
                {
                 if getfirst lschet where ((persons.nrec==lschet.tperson and 0==lschet.sovm(noindex)))=tsok
                  {
                  PoiskS;
                  }
                  else
                  {
                   xlSetCellStringValue('Не нашел основное!',Counter,24,Counter,24);
                  PoiskS_fault;
                  }

                }


            if (VidNazn='Совместительство' ) // and VidZap='Начисление')
                {
                 if getfirst lschet where ((persons.nrec==lschet.tperson and 0<<lschet.sovm(noindex)))=tsok
                  {
                  PoiskS;
            }
                  else
                  {
                   xlSetCellStringValue('Не нашел совместителя!',Counter,24,Counter,24);
                  PoiskS_fault;
                  }

                }

        }
        else
        {

            if getfirst persons where (('С'==persons.isemployee and famil==persons.fio(noindex)))=tsok
            {
              if ((VidNazn='Основное место работы' or VidNazn='Декретный отпуск') ) //  and VidZap='Начисление')
                {
                 if getfirst lschet where ((persons.nrec==lschet.tperson and 0==lschet.sovm(noindex)))=tsok
                  {
                  PoiskS;
                  }
                  else
                  {
                   xlSetCellStringValue('Не нашел основное!',Counter,24,Counter,24);
                  PoiskS_fault;
                  }

                }



            if (VidNazn='Совместительство' ) // and VidZap='Начисление')
                {
                 if getfirst lschet where ((persons.nrec==lschet.tperson and 0<<lschet.sovm(noindex)))=tsok
                  {
                  PoiskS;
                  }
                  else
                  {
                   xlSetCellStringValue('Не нашел совместителя!',Counter,24,Counter,24);
                  PoiskS_fault;
                  }
                }


           }
           else
           {
           xlSetCellStringValue('Физ. лица нет в базе данных!',Counter,24,Counter,24);
           PoiskS_fio;
           }

        }

}

StopVisual('',0);
xlkillExcel;

#_TimeLog('--- end Excel --');

}

_loop s
{
        _loop n where ((s.clsch==n.clsch and s.vidopl==n.vidopl))
        {
        s.summaGal:=s.summaGal+n.summa;
        update current s;
        delete current n;
        }
}

_loop n
{
clearbuffer(#s);
s.clsch:=n.clsch;
s.strtabn:=n.strtabn;
s.tperson:=n.tperson;
s.summaGal:=n.summa;
s.vidopl:=n.vidopl;
s.what:=n.what;
s.PODR:=n.PODR;
s.Metka:='Нет в КИС';
insert current s;
}

_loop s where ((''==s.fio))
{
        if getfirst persons where ((s.tperson==persons.nrec))=tsok
        {
        s.fio:=persons.fio;
        update current s;
        }
}

var NewFileName : string;
 NewFileName := TranslatePath('%HOMEDRIVE%%HOMEPATH%') + '\Documents\';
 NewFileName := Replace(NewFileName,'\\','\');
 NewFileName := NewFileName + 'sverka';
var ii: word;
    ii := 0;
    While ExistFile(NewFileName + '_'+ if(ii < 10, '0','') + string(ii) + '.xls')
     ii++;

 NewFileName := NewFileName + '_'+ if(ii < 10, '0','') + string(ii) + '.xls';


   puttabletodbf(#s,NewFileName, ptfFullTable);

ExecProgram('start', NewFileName,'', pfDontWait , 0);

        

#_TimeLog('---завершено--');
}

 
end;
end.

.form resurs_sumopl_full2
.nameinlist 'resurs_sumopl_full  Сверка начислений с кодом Подразделения за Февраль 2018 DSQL'
.ard
.begin
runinterface(resurs_sumopl_full2);
end.
.endform
