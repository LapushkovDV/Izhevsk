Interface resurs_sumopl_full2   escclose;

table struct SverkaKisGal
(
clsch:comp,
strtabn:string[20],
tperson:comp,
vidopl:longint,
What:string[11],
metka:string,
fio:string,
summaKis:double, //Decimal[31,15],
summaGal:Decimal[31,15],
PODR:string[20]


) 
with index (s01=clsch+vidopl, s02=fio, s03=tperson+vidopl);


table struct NachislGal
(
clsch:comp,
strtabn:string[20],
tperson:comp,
vidopl:longint,
metka:string,
What:string[11],
fio:string,
PODR:string[20],
summa: Decimal[31,15]
) 
with index (s01=clsch+vidopl);

 
create view jView

var
Counter, MaxLine, MaxCol : longint;
ExcelPath:string;
RaiseNrec:longint;
Nrec_NPO_Z:comp;
Nrec_NPO_K:comp;
NrecLS:comp;

NrecPers:longint;  
KodVid    :string;
MesVK:integer;
GodVK:integer;
SumN:double ;
dSum :double ;
SumNLast:double;
KodVidLast    :string;
NrecPersLast:longint;
fSum :double;
VidNazn :string;
VidZap:string;
famil:string;

wMES: word;
wYEAR: integer;



as select * 
from  lschet,persons, NachislGal n, SverkaKisGal s , KatPodr;

#define _TimeLog(_str) LogStrTofile('KGCompare.log', _DateTimeToStr(_CurDateTime,'DD.MM.YY HH:NN:SS:SSS') + ' ' + #_Str)

#include Sql_Func.Vpp

var DBFError : longint;
var DBFNAME:string;
procedure LoadFromDBF;
{

  DBFNAME := 'sverka.DBF';

var NewFileName : string;
 NewFileName := TranslatePath('%HOMEDRIVE%%HOMEPATH%') + '\Documents\';
 NewFileName := Replace(NewFileName,'\\','\');
 NewFileName := NewFileName + DBFNAME;


  DBFNAME := NewFileName;
  DBFError := 0;
    var ldbf : longint;
  if not fileexist(DBFNAME) then
  { //logstrtofile(wlogfilenm,'нет файла '+nmpath+'\'+nmdbf)
    DBFError:=-1000 ;
    exit;
  }
StartNewVisual(vtNumericVisual,vfTimer,'Загрузка данных КИС из DBF', 1);

    ldbf := DBFOpen(DBFNAME,stOpenRead);
    if ldbf = 0
    {
      DBFError := -10;
    }
    else
    if DBFGetFirst(ldbf) <> 0
    {
      DBFError := -100;
    }
    do
    {
      nextvisual;
        clearbuffer(#s);
        s.Metka:=       DBFGetFieldValue(ldbf, 'METKA'); //'По фио';

      IF not (s.Metka = 'Нет в КИС')
      {
        s.SummaKis:=DBFGetFieldValue(ldbf, 'SUMMAKIS');//SumN;
        s.clsch:=  comp(DBFGetFieldValue(ldbf, 'CLSCH')); //0;
        s.tperson:=comp(DBFGetFieldValue(ldbf, 'TPERSON'));
        s.strtabn:=     DBFGetFieldValue(ldbf, 'STRTABN');//0;//persons.strtabn;
        s.fio:=         DBFGetFieldValue(ldbf, 'FIO');//famil;
        s.vidopl:=longint(DBFGetFieldValue(ldbf, 'VIDOPL'));//KodVid;
      s.What :=       DBFGetFieldValue(ldbf, 'WHAT');//
        insert current s;
      DBFError++;
      }
    }
    while DBFGetNext(ldbf) = 0

    DBFClose(ldbf);
StopVisual('',0);

}

procedure PoiskS;
{
        if getfirst s where ((lschet.nrec==s.clsch and KodVid==s.vidopl))<>tsok
        {
        clearbuffer(#s);
        s.Metka:='По ID';
        s.tperson:=lschet.tperson;
        s.strtabn:=lschet.strtabn;
        s.clsch:=lschet.nrec;
        s.vidopl:=KodVid;
        s.SummaKis:=SumN;
  s.What := VidZap;
        if getfirst Katpodr where ((lschet.cex==katpodr.nrec ))=tsok
        {
        s.PODR := Katpodr.KOD;
        }

        insert current s;       
        }
        else
        {
        s.SummaKis:=s.SummaKis+SumN;
        update current s;       
        }
}

procedure PoiskS_fio;
{
        if getfirst s where ((NrecPers==s.Tperson and KodVid==s.vidopl))<>tsok
        {
        clearbuffer(#s);
        s.Metka:='По фио';
        s.clsch:=0;
        s.tperson:=NrecPers;
        s.strtabn:=0;//persons.strtabn;
        s.fio:=famil;
        s.vidopl:=KodVid;
        s.SummaKis:=SumN;
        s.What := VidZap;

        insert current s;
        }
        else
        {
        s.SummaKis:=s.SummaKis+SumN;
        update current s;       
        }
}

procedure PoiskS_fault;
{
        if getfirst s where ((NrecPers==s.Tperson and KodVid==s.vidopl))<>tsok
        {
        clearbuffer(#s);
        s.Metka:='Нет соотв л/с';
        s.clsch:=0;
        s.tperson:=NrecPers;
        s.strtabn:=0;//persons.strtabn;
        s.fio:=famil;
        s.vidopl:=KodVid;
        s.SummaKis:=SumN;
  s.What := VidZap;
        insert current s;
        }
        else
        {
        s.SummaKis:=s.SummaKis+SumN;
        update current s;       
        }
}



HandleEvent

