  PrepareSQLQuery('left join  Katpodr on UDER.cexoz=katpodr.nrec                    ');
  PrepareSQLQuery('where ( :(wYEAR)=UDER.YEARN and :(wMES)=UDER.MESN and UDER.SUMUD  <> 0 )   ');
  PrepareSQLQuery(') U_NACH                                                         ');
  PrepareSQLQuery('Group by    ');
  PrepareSQLQuery('clsch       ');
  PrepareSQLQuery(',vidopl     ');
  PrepareSQLQuery(',tperson    ');
  PrepareSQLQuery(',strtabn    ');
  PrepareSQLQuery(',What       ');
  PrepareSQLQuery(',PODR       ');

  stmt := sqlAllocStmt;

          var _IdTable:longint;
              _IdTable:=#n;
  ExecDSQLex2(_IdTable,1);

