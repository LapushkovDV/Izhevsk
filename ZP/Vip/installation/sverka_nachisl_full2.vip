  PrepareSQLQuery('where ( :(wYEAR)=Nenach.YEARN and :(wMES) =Nenach.MESN and Nenach.summa <> 0 )   ');
  PrepareSQLQuery('union all                                                              ');
  PrepareSQLQuery('select                                                                 ');
  PrepareSQLQuery('         UDER.clsch clsch                                              ');
  PrepareSQLQuery('        ,UDER.vidUD vidopl                                             ');
  PrepareSQLQuery('        ,UDER.tperson tperson                                          ');
  PrepareSQLQuery('        ,UDER.strtabn strtabn                                          ');
  PrepareSQLQuery('        ,UDER.SUMUD summa0                                             ');
  PrepareSQLQuery('        ,''Удержание'' What                                              ');
  PrepareSQLQuery('        ,Katpodr.KOD PODR                                              ');
