*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2145         |27/03/18|Шунин А.Г.               |НПО Энергомаш                    *
\*************************************************************************************************/
// (Issue:#2145) Сверка данных по отпускам КИС и Галактика
Interface GP_HollidayCompare 'Сверка данных по отпускам КИС и Галактика (КИС из Excel)' gray dialog;
show (, , 100, 15);

const
  stActual = 1;
  dkCalendarVacation = 24; //  календарные дни для расчета отпуска
end;

table struct tmOTPUSK
(
   vid       :string     //Вид назначения
  ,TabNMBS   :string[20]     //Таб. номер
  ,FIO       :string[60]     //ФИО
  ,OTP_DBEG  :Date     //Дата начала отпуска
  ,OTP_Kdeys :Word     //Количество дней
  ,OTP_VID   :string     //Вид отпуска
  ,i1        :string[1]  //Исходные данные
  ,i2        :string[1]  //Формула расчета
  ,Podr_KOD  :string[20] //Код подразделения
  ,Podr_NAME :string[150]//Наименование подразделения
  ,POST      :string     //Должность
                       // Рабочий период 1 (заканчивается в 2018 году)
  ,P1_BEG    :date         //Начало
  ,P1_END    :date         //Окончание
  ,i3        :string[1]    //Полагается за период
  ,i4        :string[1]    //Остаток на начало периода
                       //Рабочий период 2 (начинается в 2018 году)
  ,P2_BEG    :string[1]    //Начало 
  ,P2_END    :string[1]    //Окончание
  ,i5        :string[1]    //Полагается за период
  ,i6        :string[1]    //Остаток на начало периода
  ,st        :string[100]    //СТАТУС из проверки
)
with index
(
 tmOTPUSKi1= TabNMBS + FIO + OTP_DBEG + OTP_Kdeys
);

var
 Counter, MaxLine, MaxCol , ii, Coli: longint;

 NrecPers: longint;
 ExcelFileName: string;

 WORKTYPE, xlSNILS, xlFIO, xlVACTYPE: String;
 cLSCH: comp;
 wSOVM, wSovmBase : word;

 DatNach1,DatNach2, xDatuv: date;
 wDiM : word;

 // номера колонок в Excel по заголовку
 lCITEZENID, lWORKTYPE, lFIO : Longint;
 lFIRSTDAY,     lLASTDAY,       lPERIODSTART,   lPERIODEND , lSTATUSNAME, lDCODE: Longint;

 sFIRSTDAY,     sLASTDAY,       sPERIODSTART,   sPERIODEND , sSTATUSNAME, sDCODE: String;
 dFIRSTDAY,     dLASTDAY,       dPERIODSTART,   dPERIODEND : Date;

 predNrecPers: longint;
 predwSovmBase : word;

 xDMONTH, xDYEAR, wFlagDop: word;

 nm_file, sDCODE_OK: string;


create view vM
 as
select * from  persons, lschet, passports , PUTVACATION , WORKPERIOD , KLOTPUSK , tmOTPUSK , appointments, CATALOGS
;
  screen createdScreen;
    fields
    xDatuv:NoProtect, PickButton;
      nm_file:NoProtect, PickButton;
    wFlagDop:NoProtect;
   sDCODE_OK:NoProtect;
    buttons
      cmRassch;  cmDOFILE;
<<
  Дата увольнения.@@@@@@@@@@@@@@ - если уволен до этой даты, пропускать

  Файл КИС.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Обработка:`
 [.] Удалять строки с кодами подразделений`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] Пропускать строки с "Проектный"`
 [.] В выгрузку отпусков только без ошибок`

                  <. Пуск .>

  с выгрузкой отпусков для занрузки в Галактику штатным способом

                                          <. ФАЙЛ .>

>>
  end;


function ReadColNumByNamesOK: boolean;
Var str: string;
   lCol:longint;
{
str := '';
lCITEZENID  := 0; lWORKTYPE := 0; lFIO := 0;
lFIRSTDAY := 0; lLASTDAY:= 0; lPERIODSTART:= 0; lPERIODEND:= 0; lSTATUSNAME := 14;  lDCODE := 4;

lCol:=0;
    while lCol <= MaxCol // по Колонкам первой строки
    do
    {
      lCol++;

        xlgetcellvalue(1, lCol   ,str );
        str  := UpCase(trim( str ));
            Case str of
        'CITEZENID': lCITEZENID :=lCol;
         'FIRSTDAY': lFIRSTDAY     :=lCol;
          'LASTDAY': lLASTDAY    :=lCol;
      'PERIODSTART': lPERIODSTART    :=lCol;
        'PERIODEND': lPERIODEND    :=lCol;
     'WORKUNITTYPE': lWORKTYPE  :=lCol;
             'FIO' : lFIO := lCol;
       'STATUSNAME': lSTATUSNAME  := lCol;
            'DCODE': lDCODE  := lCol;

            end; // Case
    }

    if lCITEZENID  = 0 or lFIRSTDAY = 0 or lLASTDAY = 0 or lPERIODSTART = 0 or lPERIODEND = 0 or lWORKTYPE=0 or lFIO = 0
    {
        message ( 'Ошибка формата файла. Не найдена колонка'
                +''#13'CITEZENID='+ lCITEZENID
                +''#13'FIRSTDAY='+ lFIRSTDAY
                +''#13'LASTDAY='+ lLASTDAY
                +''#13'PERIODSTART='+ lPERIODSTART
                +''#13'PERIODEND='+ lPERIODEND
                +''#13'FIO='+ lFIO
                +''#13'WORKTYPE ='+ lWORKTYPE

                );
       ReadColNumByNamesOK := False;
    }
    else
    ReadColNumByNamesOK := true;
}


procedure xlOut1(pCol:longint;pStr: string);
{
  
  if 2  = pCol // Статус проверки
  {
    if tmOTPUSK.St<>'' exit // выводить только первый статус об ошибке
    else
    tmOTPUSK.St := pStr;

  }

  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);

}// procedure xlOut1

procedure xlOut2(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}//  procedure xlOut2

#define _DateS(_Str) date(substr(#_Str,1,2),substr(#_Str,4,2),substr(#_Str,7,4))


Function LschetFound:boolean;
{

   wSOVM := wSovmBase;

   result := true;

   if getfirst lschet where ((persons.nrec==lschet.tperson and wSOVM == LSCHET.SOVM (noindex) )) <>tsok
   {
        if wSOVM = 0 result := False
        else
        {
          wSOVM := 5; // Внешнее совместительство
          if getfirst lschet where ((persons.nrec==lschet.tperson and wSOVM == LSCHET.SOVM (noindex) )) <>tsok
          {
              wSOVM := 3; // Внутреннее совместительство
              if getfirst lschet where ((persons.nrec==lschet.tperson and wSOVM == LSCHET.SOVM (noindex) )) <>tsok
              {
                xlOut2( 2, 'Не найден Л/С' );
                result := False;
              }
          }

        }
   }

}

#define _DateFromXL(_Var) xlgetcellvalue(Counter,l#_Var,s#_Var ); s#_Var := Trim(s#_Var); d#_Var := date(substr(s#_Var,1,2),substr(s#_Var,4,2),substr(s#_Var,7,4));

procedure DoAnalize;
{
 clearbuffer(tntmOTPUSK);

 xlOut1( 7, ''''+persons.STRTABN); // 2-MaxCol

    if persons.DISDATE > date(0, 0, 0)
    {
        xlOut1( 6, DateToStr(persons.DISDATE,'у_DD.MM.YYYY') );

        if persons.DISDATE <= xDatuv
        {
          xlOut1( 2, 'Сотрудник уволен' );

          if (wFlagDop and 100b) > 0 exit;
        }
    }


// Читаем Даты  dFIRSTDAY,      dLASTDAY,       dPERIODSTART,   dPERIODEND
#_DateFromXL(PERIODEND)
#_DateFromXL(LASTDAY)

    if   persons.APPDATE > dLASTDAY   or
         persons.APPDATE > dPERIODEND
    {

         xlOut1( 2, 'Принят позже конца периода LASTDAY или PERIODEND' );
         xlOut1( 6, DateToStr(persons.APPDATE,'п_DD.MM.YYYY') );

         if (wFlagDop and 100b) > 0  exit; //  continue;
    }

#_DateFromXL(PERIODSTART)
#_DateFromXL(FIRSTDAY)


  // WORKPERIOD.WTYPEPERIOD - 0,1,2 - что это за периоды ???

    if getfirst WORKPERIOD where (( persons.nrec == WORKPERIOD.CPERSON and persons.APPOINTCUR == WORKPERIOD.CAPPOINTMENT and
    word(0) ==  WORKPERIOD.WTYPEPERIOD  and
                dPERIODSTART == WORKPERIOD.DPERBEG (noindex)// Дата начала рабочего периода
              and dPERIODEND == WORKPERIOD.DPEREND (noindex)   )) <> tsOK
    {

      xlOut1( 2, '1 WORKPERIOD не найден' );
      if (wFlagDop and 100b) > 0  exit; //  continue;
    }



xlgetcellvalue(Counter, 15, xlVACTYPE ); xlVACTYPE := trim(xlVACTYPE);

var cVACTYPE : comp = 0;
Case xlVACTYPE of

'Ежегодный отпуск': cVACTYPE := 4000F1AE305D90CBh;
'Дополнительный отпуск работникам с ненормированным рабочим днем': cVACTYPE := 0001000000000002h  ;
'Дополнительный отпуск работникам с ненормированным рабочим днем (деньгами)': cVACTYPE := 0001000000000002h; // Чтоб в Excel-е не делать замену = предидущему таких 31 позиция 
'Дополнительный отпуск сотрудников занятым на работах с вредными условиями труда':  cVACTYPE :=  0001000000000021h ;
'Дополнительный отпуск станочникам (по Кол. договору)': cVACTYPE := 000100000000000Ah  ;
else
{

  xlOut1( 8, 'ПРОЧИЕ');

  Case xlVACTYPE of // Case2
  'Дополнительный отпуск работникам с ненормированным рабочим днем (деньгами)': cVACTYPE := 0001000000000014h  ;
  'Дополнительный отпуск за "Байконур"': cVACTYPE := 0001000000000009h  ;
  'Дополнительный отпуск за конфидециальность': cVACTYPE := 000100000000000Eh  ;
  'Дополнительный отпуск участникам ликвидации аварий на ЧАЭС и других радиационных аварий': cVACTYPE := 0001000000000013h ;
  end; // Case2 xlVACTYPE

}
end; // Case xlVACTYPE


  var xlKolDays : word = 0;

    if getfirst PUTVACATION where (( WORKPERIOD.nRec == PUTVACATION.CWORKPERIOD and 0 == PUTVACATION.WTYPEVAC and cVACTYPE == PUTVACATION.CKLOTPUSK )) <> tsOK
    {
      xlOut1( 2, '2 PUTVACATION не найден' );
      if (wFlagDop and 100b) > 0   exit; //       continue;
    }
    else
    {
      if PUTVACATION.CKLOTPUSK <> cVACTYPE
      {
        xlOut1( 2, '3 Не тот KLOTPUSK' );

        if getfirst KLOTPUSK where (( PUTVACATION.cKLOTPUSK == KLOTPUSK.nrec )) = tsOK
        xlOut1( 1, KLOTPUSK.NOTPUS)
        else
        xlOut1( 1, 'KLOTPUSK не найден');

        if (wFlagDop and 100b) > 0 exit;
      }
      else
      {


        xlgetcellvalue(Counter, 19, xlKolDays );

        if  PUTVACATION.WDAYCOUNT <> xlKolDays
        {
          xlOut1( 1, KLOTPUSK.NOTPUS);
          xlOut1( 2, '4 Другое количество дней');

          if (wFlagDop and 100b) > 0  exit;
        }

      }

//      = WDAYCOUNT // Количество дней
//    вид отпуска
// Ежегодный отпуск


    }
/*
// PUTVACATION.CPERSON
WDAYCOUNT // Количество положенных дней отпуска

DBEGBALANCE
DENDBALANCE
DBEGVALIDITY
DENDVALIDITY
WCOUNTWAY

*/

    xlgetcellvalue(Counter, 17, xlKolDays );

    xlOut1( 2, 'Проверка прошла' );

    tmOTPUSK.vid       := 'Основное';
    tmOTPUSK.TabNMBS   := Persons.STRTABN;
    tmOTPUSK.FIO       := Persons.FIO;
    tmOTPUSK.OTP_DBEG  := dFIRSTDAY;
    tmOTPUSK.OTP_Kdeys := xlKolDays;

    if getfirst KLOTPUSK where (( cVACTYPE == KLOTPUSK.nrec )) = tsOK
    tmOTPUSK.OTP_VID   := KLOTPUSK.NOTPUS;


    if getfirst appointments where (( persons.APPOINTCUR == appointments.nrec)) = tsOK
    {

      if getfirst Catalogs where ((  appointments.DEPARTMENT == Catalogs.nRec )) = tsOK
      {
         tmOTPUSK.Podr_KOD  := Catalogs.Code;
         tmOTPUSK.Podr_NAME := Catalogs.NAME;
      }

      if getfirst Catalogs where ((  appointments.POST == Catalogs.nRec )) = tsOK
         tmOTPUSK.POST      := Catalogs.NAME;

    }


    tmOTPUSK.P1_BEG    := dPERIODSTART;
    tmOTPUSK.P1_END    := dPERIODEND  ;

    insert current tmOTPUSK; 

}

HandleEvent

cmInit: {
  startNewVisual(vtRotateVisual, vfThread + vfTimer, 'Пожалуйста, подождите...', 100);
    InitWorkingTable;
  stopVisual('', 0);

  if not ReadMyDsk(nm_file    , 'HolliCmp_nm_file',    false) nm_file := '';
 xDatuv := Cur_Date;
 xDatuv := Date( 01 ,MONTH(xDatuv),YEAR(xDatuv));
 xDatuv := Date( 01 ,04 ,YEAR(xDatuv));

 sDCODE_OK:=';011;013;033;042;043;045;081;082;099;104;337;504;505;506;511;513;514;521;643;724;751;757;768;779;786;810;832;834;902;908;917;920;924;943;944;949;958;961;969;987;990;991;992;994;995;';

 wFlagDop := 11b;
}


 cmDone:  DoneWorkingTable;




cmRassch:
{

  SaveMyDsk(nm_file    , 'HolliCmp_nm_file');
  Delete all tmOTPUSK;


  if nm_file <> '' then ExcelFileName := nm_file
  else
  {
    ExcelFileName := 'GP_HollidayCmp.xlsx';
    ExcelFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ExcelFileName ;
  }


  if (not ExistFile(ExcelFileName))
  { message('Не найден шаблон файла "'+ExcelFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(ExcelFileName,true))
  { message('Ошибка создания нового файла в Excel"'+ExcelFileName+'".',error);
    exit;
  }

    if (xlIsExcelValid) xlSetActiveSheetByName('1');

    xlGetUsedRange(0,0,MaxLine,MaxCol);

predNrecPers:=0;  predwSovmBase :=100;

StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel ...', MaxLine div 5);

// Пишем заголовки для своих колонок
Counter := 1;
        xlOut2( 1, 'ГАЛ_Отпуск'       );
        xlOut2( 2, 'Статус'       );
        xlOut2( 3, 'Lschet.nRec' );
        xlOut2( 4, 'FIO'          );
        xlOut2( 5, 'Поиск Лицевого Cчета');
        xlOut2( 6, 'Дата увольнения');
        xlOut2( 7, 'ГАЛ_ТабN');
        xlOut2( 8, 'VACTYPE');

// Читаем заголовок и находим номера колонок по названию полей

if ReadColNumByNamesOK
while counter < MaxLine
do
{
  Counter++;

  if Counter mod 5 = 0
  if not nextvisual break;

if (wFlagDop and 01b) > 0
{
    xlgetcellvalue(Counter, lDCODE, sDCODE);  sDCODE := ';' + trim(sDCODE) + ';';
    if Instr(sDCODE, sDCODE_OK )  > 0
    {

      xlDeleteRange(xlShiftUp, Counter, 1 , Counter, MaxCol +8);
      Counter--; // потом его ++ и он останется на текущей строке, которая, после удаления, будет "следущей"
      continue;
    }
}

// не проверять если STATUSNAME = Проектный
if (wFlagDop and 10b) > 0
{
    xlgetcellvalue(Counter, lSTATUSNAME, sSTATUSNAME); sSTATUSNAME := trim(sSTATUSNAME);
    if sSTATUSNAME = 'Проектный'
    {
        xlOut1( 2, 'Проверка прошла' );
        continue;
    }
}

  xlgetcellvalue(Counter, lCITEZENID,NrecPers );




// признак лицевого счета основной или совмещение
xlgetcellvalue(Counter, lWORKTYPE, WORKTYPE); WORKTYPE := trim(WORKTYPE);

wSovmBase := 0;// Основное место работы  или  Декретный отпуск
if WORKTYPE='Совместитель' wSovmBase := 1;

if wSovmBase = 1 continue; // совместителей пропускать


// Если сотрудник то-же что и на предидущей строке, то его искать не надо
// и повторно инициировать для него табель не надо.

if ( predNrecPers = NrecPers ) and ( predwSovmBase = wSovmBase )
{
DoAnalize;
continue;
}

cLSCH := comp(0);

 //----------------------------------------------------------------------------
 // Поиск лицевого счета сотрудника по ID, СНИЛС, полному ФИО, и  Фимилия И.О.
 //#region

    if getfirst persons where ((NrecPers==persons.nrec))<>tsok
    {

        xlgetcellvalue(Counter,18,xlSNILS );
        xlSNILS := trim(xlSNILS);


        _Loop passports where ((501==passports.syscode and xlSNILS == passports.NMB))
        if getfirst persons where ((passports.person==persons.nrec))=tsOK
        {
          if LschetFound
          {
             cLSCH := lschet.nRec;
             xlSetBackColor( 49407 , Counter, 18 , Counter,  18);
             xlOut1( 5,'По СНИЛС');
             break;
          }
        }

        if cLSCH = comp(0)
        {

          _Loop passports where ((501==passports.syscode and xlSNILS == passports.NMB))
          if getfirst persons where ((passports.person==persons.nrec))=tsOK
          if Getfirst lschet where (( Persons.nRec== lschet.tperson )) = tsOK
          {
             cLSCH := lschet.nRec;

             xlSetBackColor( 49407 , Counter, lWORKTYPE, Counter, lWORKTYPE);
             xlSetBackColor( 49407 , Counter, MaxCol+2 , Counter,  MaxCol+3);
             xlOut1( 5,'По СНИЛС первый попавшийся лицевой');

             break;
          }

        }

      if cLSCH = comp(0) // Ищем по Фамилия И.О. или по полному ФИО
      {

        xlgetcellvalue(Counter, lFIO ,xlFIO );    xlFIO := Trim(xlFIO);

        if Instr('.', xlFIO) > 0
        {
          // Ищем по Фамилия И.О.

          _Loop persons where (ExtractWord(1,xlFIO,' ') = ExtractWord(1,persons.fio,' ') )
          if xlFIO = ( ExtractWord(1,persons.fio,' ') + ' ' + Substr(ExtractWord(2,persons.fio,' '),1,1) + '. '+ Substr(ExtractWord(3,persons.fio,' '),1,1) + '.' )
          if LschetFound
          {
             cLSCH := lschet.nRec;
             xlSetBackColor( 49407 , Counter, MaxCol+3 , Counter,  MaxCol+3);
             xlOut1( 5,'По Фамилия И.О.');

             break;
          }

          if cLSCH = comp(0)
          {
             // Берём первый попавшийся лицевой счет по Фамилия И.О.
              _Loop persons where (ExtractWord(1,xlFIO,' ') = ExtractWord(1,persons.fio,' ') )
              if xlFIO = ( ExtractWord(1,persons.fio,' ') + ' ' + Substr(ExtractWord(2,persons.fio,' '),1,1) + '. '+ Substr(ExtractWord(3,persons.fio,' '),1,1) + '.' )
              if Getfirst lschet where (( Persons.nRec== lschet.tperson )) = tsOK
              {
                 cLSCH := lschet.nRec;

                 xlSetBackColor( 49407 , Counter, lWORKTYPE, Counter, lWORKTYPE);
                 xlSetBackColor( 49407 , Counter, MaxCol+2 , Counter,  MaxCol+3);
                 xlOut1( 5,'По Фамилия И.О. первый попавшийся лицевой');

                 break;
              }

              if cLSCH = comp(0)
              {
                xlOut1( 2, 'Не найден сотрудник' );
                xlOut1( 5, 'По Фамилия И.О.');

                continue;
              }
          }
        }
        else
        {
          // Ищем по Полному ФИО

          _Loop persons where ( xlFIO = persons.fio )
          if LschetFound
          {
             cLSCH := lschet.nRec;
             xlSetBackColor( 49407 , Counter, MaxCol+3 , Counter,  MaxCol+3);
             xlSetBackColor( 49407 , Counter, 6        , Counter,  6       );
             xlOut1( 5,'По Полному ФИО');
             break;
          }

          if cLSCH = comp(0)
          {
             // Берём первый попавшийся лицевой счет по Фамилия И.О.
              _Loop persons where ( xlFIO = persons.fio )
              if Getfirst lschet where (( Persons.nRec== lschet.tperson )) = tsOK
              {
                 cLSCH := lschet.nRec;

                 xlSetBackColor( 49407 , Counter, lWORKTYPE, Counter, lWORKTYPE);
                 xlSetBackColor( 49407 , Counter, MaxCol+2 , Counter,  MaxCol+3);
                 xlOut1( 5,'По Полному ФИО первый попавшийся лицевой');

                 break;
              }

              if cLSCH = comp(0)
              {
                xlOut1( 2, 'Не найден лицевой счет' );
                xlOut1( 5, 'По Полному ФИО');
                continue;
              }
          }

        }  // Ищем по Полному ФИО

      } // if ... Ищем по Фамилия И.О. или по полному ФИО
    }
    else
    {
        xlOut1( 3, 'Persons.nRec=' + string(Persons.nRec,0,0) );
        xlOut1( 4, Persons.FIO              );

        if not LschetFound
        {   // Excel из КИС есть 5 записей с ссылкой на Persons с другим LSchet.SOVM
            // у таких сотрудников есть вторая запись в Persons c "парвильным" LSchet.SOVM
            // Ищем запись в Persons с таким-же ФИО, но c "парвильным" LSchet.SOVM

            xlFIO :=Persons.FIO;

            _Loop persons where (xlFIO = Persons.FIO)
            {
              xlOut1( 3, 'Persons.nRec=' + string(Persons.nRec,0,0) );
              xlOut1( 4, Persons.FIO              );

              if LschetFound
              {
                 cLSCH := lschet.nRec;
                 xlSetBackColor( 49407 , Counter, MaxCol+2 , Counter,  MaxCol+3);
                 xlOut1( 5, 'По CITEZENID, потом по Полному ФИО');
                 break;
              }

            }

            if cLSCH = comp(0)
            {
               // Берём первый попавшийся
               if Getfirst lschet where (( Persons.nRec== lschet.tperson )) = tsOK
               {
                 cLSCH := lschet.nRec;
                 xlSetBackColor( 49407 , Counter, lWORKTYPE, Counter, lWORKTYPE);
                 xlSetBackColor( 49407 , Counter, MaxCol+2 , Counter,  MaxCol+3);

                 xlOut1( 5, 'По CITEZENID, потом по Полному ФИО первый попавшийся');

                 // 00000FFh , Counter, lWORKTYPE, Counter, lWORKTYPE); Красный для фона темновато
               }
               else
               {
                 xlOut1( 2, 'Не найден сотрудник' );
                 continue;
               }
            }

        }
        else
        {
          xlOut1( 5,'По CITEZENID');
          cLSCH := lschet.nRec
        }

    }
 // Поиск лицевого счета сотрудника по ID, СНИЛС, полному ФИО, и  Фимилия И.О.
 //----------------------------------------------------------------------------
 //#endregion


        xlOut1( 3, string(cLSCH,0,0) );
        xlOut1( 4, Persons.FIO       );

  SetVisualHeader(counter + '/' + MaxLine + ' расчет по ' + Persons.FIO);


   if getfirst lschet where (( cLSCH == lschet.nRec ))=tsOK
   {
        predNrecPers := NrecPers;
        predwSovmBase := wSovmBase ;

        DoAnalize;

  }//  _loop lschet

} // while counter < MaxLine



xlkillExcel;

StopVisual('',0);

PutCommand(cmDOFILE);

}
cmDOFILE:
{


      var OutPath, OutFNAME: string;

       OutPath := GetPathParameter('Files','TmpFilesDirectory',0);
       OutFNAME := '#OTP_LOAD.XLS';
       DeleteFile(OutPath + OutFNAME);
       vM.PutTableToDBF (#tmOTPUSK,OutPath + OutFNAME,0);

       ExcelFileName := 'GP_OTPUSK_FOR_LOAD.xls';
       ExcelFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ExcelFileName ;
        if (not ExistFile(ExcelFileName))
        { message('Не найден шаблон файла "'+ExcelFileName+'"',error);
          exit;
        }

        if (not xlCreateExcelWithTemplate(ExcelFileName,true))
        { message('Ошибка создания нового файла в Excel"'+ExcelFileName+'".',error);
          exit;
        }

        if (xlIsExcelValid) xlSetActiveSheetByName('1');

        xlSetCellStringValue(OutPath ,3,3,3,3);
        xlSetCellStringValue(OutFNAME,4,4,4,4);

        if not xlRunMacro('DBF2REPORT') {} //  message('Ошибка запуска макроса');

        xlkillExcel;

}
  cmPick:
  { case CurField of
    #nm_file:
    { var ww_str:string=GetFileName('*.xlsx','Выберите файл c данными по Табелям из КИС');
      if ww_str<>''
      {
         set nm_file:=ww_str;
      }
    }
    end;
  }

end;
end.

.form GP_HollidayCompareFRM
.nameInlist 'GP_HollidayCompare Сверка данных по отпускам КИС и Галактика (КИС из Excel)'
.ard
.f 'NUL'
.begin
 runInterface(GP_HollidayCompare);
 end.
.endForm

