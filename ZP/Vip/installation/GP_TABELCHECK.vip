      PersAv.DatUv 'Дата увольнения': [10], protect;
      PersAv.Otrab 'Отработано': [11.2], protect;
     // PersAv.OtrabNO 'Опл.неявки', '(К, Г, МО и др.)': [11.2], protect;
     // PersAv.OtrabNN 'Неопл.неявки', '(Б, ОЖ, ДО и др.)': [11.2], protect;

      PersAv.Night 'Ночные часы,', ',ч': [11.2], protect;
