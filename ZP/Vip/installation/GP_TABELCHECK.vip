Interface GP_TABELCHECK 'Табель. Расчет табеля в Галактике и сверка с данными из Excel' gray dialog;
//  show (, , 161, 32);
  show (, , 50, 15);

  const
    stPlanned = 0;
    stActual = 1;
    hkWorking =1; // рабочие часы
    hkEvening =2; // часы работы вечером
    hkNight   =3; // часы работы ночью
    hkHoliday =4; // часы работы в праздничные дни, кроме работы за отгул hkWorkingHoliday и hkWeekendHoliday
    hkWeekend =5; // часы работы в выходные за оплату
    hkOverwork=6; // сверхурочные

    cfDisregardPeriod = 64;
end;

var
Counter, MaxLine, MaxCol , ii, Coli: longint;
NrecPers: longint;
  KodCex:string;
  DatNach1,DatNach2:date;
  VsegoAvPl,VsegoAvF:double;
  i15,i16,i17:double;
ExcelFileName,  xDbeg ,   xDEnd, WORKTYPE, pStr: string;


  lCITEZENID,lDYEAR, lDMONTH , lWORKTYPE, lSkipFlag: Longint;

//  xDMONTH: Byte;
  xDMONTH,xDYEAR: word;

  bSkipByFlag:boolean;


wSOVM : word;


table struct TabelRA
(
nREC:COMP,
Kod:string,
Name:string,
PriznA:double,
NameA:string
)
with index (VH01=kod,VH02=Name);

table struct PersAv
(
nrec:comp,
Line: longint,
SOVM: word,
fio:string,
tabn:longint,
DatProvTab:date,
Datpos:date,
DatUv:date,
AvRasch:double,
Otrab:double,
Night:double,
Holiday:double,
Weekend:double,
OtrabNO:double,
OtrabNN:double,
OtrabNO_R:string,
OtrabNN_R:string,
OtrabV:double,
PlanCh:double,
razr:word,
tarsetka:word,
Dolzhn:string
)
with index (p01=tabn, p02=fio);

table struct NeyavAV
(
Kod:string,
Priznak:integer,
// Col:Longint, // Колонка в шаблоне с кем сравнивать
Otrab7:double
)
with index (N01 = Priznak + Kod);
 
create view vM
  as
select * from  persons, lschet, lstab, catalogs, PersAv, NeyavAv
,katpodr katpodrSynonym
//,katpodr
// ,uowrktabel
// , attrval
where ((KodCex == katpodrSynonym.kod));

  screen createdScreen;
//    show (, , 160, 15);

//    bevel
//      divisionBevel {1, 1, 55, 5, bsLowered, bsFrame};

    fields
 //     KodCex ('Код подразделения'): noProtect;
   //   katpodrSynonym.name ('Наименование подразделения'): protect;
      bSkipByFlag: noProtect;

    buttons
      cmRassch;
<<

 `Формировать`
 (.) Cчитать все записи из Excel. Долго!`
 (.) Считать только по флагу`
     Флаг- ячейка в колонке R ( Cal_FLAG ) в шаблоне.
     Если в ячейке значение 1 - делать расчет по строке.
     Любое другое значение - пропускать строку.

                 <. Пуск .>
>>
  end;
