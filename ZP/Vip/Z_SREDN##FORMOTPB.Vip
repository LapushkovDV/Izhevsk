/*************************************************************************************************\
* Наименование:  Формирование отпусков                                                            *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    Блокирование формирования при пометке более 10 работников                        *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1509         |03/12/17|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_SREDN"
#doc
Параметры формирования отпусков - блокируем массовое добавления
#end

Alter Interface FORMOTPB;

HandleEvent
cmOk :
{ if FILTRPUBLIC='не установлен'
  { Message('Установите фильтр по работникам!');
    Exit;
  }
  //несколько работников (32 из 63)
  var col_vib:longint=0;
  var ww_str:string='';
  if pos('(',FILTRPUBLIC)>0
  { ww_str:=SubStr(FILTRPUBLIC,pos('(',FILTRPUBLIC)+1,2);
    ww_str:=SubStr(ww_str,1,pos(' ',ww_str)-1);
    col_vib:=Longint(ww_str);
    if col_Vib>10
    { if message('Помечено '+string(col_Vib)+' работников!'
        +chr(13)+'Продолжить?' ,YesNo
       ) <>cmYes
      { exit;
      }
    }
  } //if pos('(',FILTRPUBLIC)>0
  if inherited::handleEvent (cmOk)=heAbort then Abort;
} //cmOk :
end;
end.
