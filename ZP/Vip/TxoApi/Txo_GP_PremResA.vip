function  D_Quart  (Date):                        byte;    external 'atllib_.dll#D_Quart';
//#include AtlLib_.vih

#include Query.vih
#include TxoApi.vih

VipInterface Txo_GP_PremResA Implements ObjTxoIdentPlugin Licensed(Free);
Interface Txo_GP_PremResA;

var PremiumType:word;
    sSchet, sSubSchet: string;

table struct tPremiumReserve (
  cLSchet: comp,
  cPodr: comp,
  SumReserve: double
);

create view
from
  tPremiumReserve,
  PlPor, PlansSch, LSchet
where((
  tPremiumReserve.cLSchet==LSchet.NRec
));

sql query qPremiumReserve =
  select LSchet.NRec as cLSchet,
         sp.cKatPodr,
         cast(
           case f.Npp
                when 1  then sp.fArrValue[1]
                when 2  then sp.fArrValue[2]
                when 3  then sp.fArrValue[3]
                when 4  then sp.fArrValue[4]
                when 5  then sp.fArrValue[5]
                when 6  then sp.fArrValue[6]
                when 7  then sp.fArrValue[7]
                when 8  then sp.fArrValue[8]
                when 9  then sp.fArrValue[9]
                when 10 then sp.fArrValue[10]
                when 11 then sp.fArrValue[11]
                when 12 then sp.fArrValue[12]
                when 13 then sp.fArrValue[13]
                when 14 then sp.fArrValue[14]
                when 15 then sp.fArrValue[15]
                when 16 then sp.fArrValue[16]
                when 17 then sp.fArrValue[17]
                when 18 then sp.fArrValue[18]
                when 19 then sp.fArrValue[19]
                when 20 then sp.fArrValue[20]
           end
         as double) as SumReserve
  from GP_KPI_Doc doc
  join GP_KPI_DOC_SP sp on sp.cgp_kpi_doc = doc.Nrec and sp.cgp_kpi_raise = #comp(0)
  join GP_TypeDocs on GP_TypeDocs.wType = doc.wType
  join GP_KPI_Fields f on f.wType = gp_typedocs.wType and f.cDoc = GP_TypeDocs.Nrec and f.Name = :PremiumReserveFieldName
  join LSchet on LSchet.Nrec = sp.cLSchet
  where doc.wType       = :Type and
        doc.wYear       = :Year and
        doc.wMonth      = :Month
;

function ExecQuery(CurDate:date; aType:word):boolean;
var CurQuarter:byte;
    CurYear:word;
    CurFieldName:string;
{
  result := false;

  CurQuarter:=D_Quart(CurDate);
  CurYear:=Year(CurDate);

  var s: longint = 0;
  sqlAddStr(s, qPremiumReserve);
  sqlAddStr(s, 'and Lschet.cSchetD ='+'''' + sSchet + '''');
  if (sSubSchet <> '') sqlAddStr(s, 'and Lschet.cSubSchD ='+'''' + sSubSchet + '''');
  case PremiumType of
    0:{
      sqlAddStr(s, 'and doc.hArrComp[1] = #comp(' + CurQuarter + ')');
      sqlAddStr(s, 'and doc.hArrComp[2] = #comp(' + CurYear + ')');
      sqlAddStr(s, 'and BitAnd(doc.hArrComp[4], 1) = 1');

      CurFieldName:=sGetTune('NPOEM_OWN.BU.RezervKvartPrem.FieldName');
    }
    1:{
      sqlAddStr(s, 'and doc.hArrComp[3] = #comp(' + CurYear + ')');
      sqlAddStr(s, 'and BitAnd(doc.hArrComp[4], 2) = 2');

      CurFieldName:=sGetTune('NPOEM_OWN.BU.RezervGodPrem.FieldName');
    }
  end;

  var rs: IResultSet;
  rs := queryManager.createQuery(s)
                   .setParam('Type', aType)
                   .setParam('Year', Year(CurDate))
                   .setParam('Month', Month(CurDate))
                   .setParam('PremiumReserveFieldName', CurFieldName)
                   .getResultSet;

  if (rs.count>0)
    result := sqlCopyInto(rs, #tPremiumReserve, false) = tsOk
  else
    result := true;
}

Function GetHeadPodr(PodrIn: comp): comp;
var
PodrOut: comp;
{
  Result:= PodrIn;

  SQL
  Select k.Nrec
  From KatPodr
  Left Join KatPodr k on k.Nrec = KatPodr.cPodr and k.Kod = SubString(KatPodr.Kod,1,3)
  Where KatPodr.Nrec = :(PodrIn)
  Into (PodrOut)
  ;

  if (PodrOut <> comp(0)) Result:= PodrOut;
}

Window WinParam 'Параметры' Gray, EscClose, DoAccept;
Show at (25,5,70,12);

tabbedsheet tbParam;
Screen scParams 'Параметры' (,,sci1Esc);
NoTableNavigation;
fields
  PremiumType :NoProtect;
  sSchet: NoProtect;
  sSubSchet: NoProtect;
buttons
  cmOk, Default,, 'Ввод выбранных параметров';
  cmCancel,,,'Отмена выбранных параметров';
<<
 `Тип премии`
   (.) квартальная`   `Счет`    .@@@
   (.) годовая`       `Субсчет` .@@@

  <.Продолжить.>               <.  Отмена  .>
>>
end;

screen scInfo 'Информация' (,,sci1Esc);
<<
 Циклическая аналитика:
   <режим 0> - Счет из ЛС, аналитика из ЛС
   <режим 1> - Подразделение из ЛС, МВЗ,
             Сотрудник
>>
end;
end;

HandleEvent
cmInit:{
  PremiumType:=0;
  sSchet:= '';
  sSubSchet:= '';
}
cmOk:{
  PutCommand(cmDefault);
}
end;
end;//WinParam

function GetInfo:string;
{
  result := 'Резерв премии, начисление';
}

function ParamGen:string;
{
  if (sSubSchet <> '') result := '[Тип:'+string(PremiumType)+'][Счет:'+sSchet+'][Субсчет:'+sSubSchet+']'
  else result := '[Тип:'+string(PremiumType)+'][Счет:'+sSchet+']';
}

procedure ParamParser(hTxo:longint);
var i:longint;
{
  PremiumType:=0;

  for(i:=1; i <= TxoParamCount(hTxo); i++) {
    case TxoParamName(hTxo, i) of
      'ТИП': PremiumType := word(TxoParamValue(hTxo, i));
      'СЧЕТ': sSchet:= string(TxoParamValue(hTxo, i));
      'СУБСЧЕТ': sSubSchet:= string(TxoParamValue(hTxo, i));
    end;
  }
}

function ParamMaster:string;
{
  result := '';

  if (RunWindowModal(WinParam) = cmDefault)
    result := ParamGen;
}

procedure TxoBodyAddKauArray(hTxo:longint; flKau:word; Tbl:tTabKau; Kau:tGetKau);
var i:word;
{
  for(i:=1;i<=cLastKAU;i++)
    TxoBodyAddKau(hTxo,  flKau, Tbl[i], Kau[i]);
}

procedure StoreCycles(hTxo:longint; buf:TTxoApiInfoDoc);
{
  TxoAllowRecallStoreCycles(hTxo);

  ParamParser(hTxo);

  delete all tPremiumReserve;

  //Ограничение по ТХО
  if (getfirst fastfirstrow PlPor where((buf.cSoprDoc==PlPor.NRec))<>tsok) {
    TxoDebugMsg(hTxo,'exit','Не найдена бух справка с NRec='+string(buf.cSoprDoc,0,0)+'!');
    exit;
  }
  if (getfirst fastfirstrow PlansSch where((buf.cPlansSch==PlansSch.NRec))<>tsok) {
    TxoDebugMsg(hTxo,'exit','Не найден план счетов с NRec='+string(buf.cPlansSch,0,0)+'!');
    exit;
  }

  var res:boolean;
  //Ведомости премирования среднего звена
  res:=ExecQuery(PlPor.DatVip, 102);
  if (not res) {
    TxoDebugMsg(hTxo,'exit','Ошибка выполнения DSQL запроса.');
    exit;
  }

  //Ведомости премирования высшего звена
  res:=ExecQuery(PlPor.DatVip, 103);
  if (not res) {
    TxoDebugMsg(hTxo,'exit','Ошибка выполнения DSQL запроса.');
    exit;
  }

  _loop tPremiumReserve {
    TxoBodyClear(hTxo);

    TxoBodyAddSchet(hTxo, wFlKau_Mode0, PlansSch.Kod+LSchet.cSchetD, LSchet.cSubSchD);
    TxoBodyAddKauArray(hTxo, wFlKau_Mode0, LSchet.TblD, LSchet.cKauD);

    TxoBodyAddKau(hTxo, wFlKau_Mode1, cgKau_KatPodr, GetHeadPodr(tPremiumReserve.cPodr));
    TxoBodyAddKau(hTxo, wFlKau_Mode1, 10044, GetHeadPodr(tPremiumReserve.cPodr));

    TxoBodyAddKau(hTxo, wFlKau_Mode1, cgKau_Persons, LSchet.tPerson+coPersonsSdvig);
    TxoBodyAddKau(hTxo, wFlKau_Mode2, cgKau_Persons, LSchet.nrec ); //EM-259

    TxoBodySetSum(hTxo, tPremiumReserve.SumReserve, 0, 0);

    TxoBodyInsert(hTxo);
  }//_loop tPremiumReserve
  update PlPor where((buf.cSoprDoc==PlPor.NRec)) set
    PlPor.Denosch6 := if(PremiumType = 0, 'РезервКвПрем_', 'РезервГодПрем_') +
                      Year(PlPor.DatVip) +
                      if(PremiumType = 0, '_' + D_Quart(PlPor.DatVip), '');
}

End.
