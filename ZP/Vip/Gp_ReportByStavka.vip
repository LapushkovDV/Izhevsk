Interface Gp_ReportByChangeStavka, Gray;
 Show at (,,62,15);

 table struct reptable
 (
   nrecse    : comp 
  ,podrname  : string
  ,podrcode  : string[50]
  ,doljname  : string
  ,usllabor  : string
  ,dinput    : date
  ,dclose    : date
  ,remark    : string[40]
 )
 with index
 (
  in1=podrcode
 );

 Create View
  var
    dbeg,dend : date;
    fDept     : string;
    Marker     : longint;
    cCount,i,NumPick : longint;
    PickRec : comp;
    ce_nrec  : comp;
    stmt, stmt_str, curcount : longint;
    XlRes : boolean;
    aFileName  : string  ;
    rowshp,row : longint ;

  from
   reptable
 ;

var maspodr : array [1] of comp ;

 Screen ScrMain ;
  notablenavigation;
   fields

    dbeg       : noprotect;
    dend       : noprotect;
    fDept      : [50],protect,pickbutton;

 Buttons
   CmYes,Default;
   CmCancel;
<<

     Период Изменения в ШР .@@@@@@@@@@ по .@@@@@@@@@@

    `Фильтр по подразделению` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@


    <.Сформировать.>     <.Отмена.>
>>
 end;

Procedure ClearQuery(Var liHandle: Longint);
{
  if (liHandle != 0)
  {
    sqlFreeStr(liHandle);
    liHandle := 0;
  }
}

FUNCTION DateToInt_  (_Date : Date): longint ;
{   
  Result :=(65536 * Year(_Date) + 256 * Month(_Date) + Day(_Date));
}


 HandleEvent
  CmInit:{
           fDept:='не задан';
           SetLimit(Maspodr, 0);
           dbeg:=date(1,Month(Cur_Date),Year(Cur_date));
           dend:=Cur_date;
         }

  CmPick:{
           case curfield of
            #fDept:{

                    if (RunInterface(PickCatalog2,Integer(-11),
                               ce_nrec, Comp(100)) = cmDefault)
                     {
                      SetLimit(Maspodr, 0);

                      Marker := InitMarker('CatalogsMarker', 8, 100, 10);
                      cCount := GetMarkerCount(Marker);
                      NumPick := 0;
                      fDept:='';

                      for(i := 0; i < cCount; i++)
                       if GetMarker(Marker, i, PickRec)
                      {
                       NumPick++;
                       maspodr[i+1]:=PickRec;
                      }
                      ClearMarker(Marker);
                      DoneMarker(Marker,'CatalogsMarker');
                      fDept:='выбрано :'+string(Numpick)+' записей';
                     }
                   }
            end;

            RescanPanel(tnNoTable);
          }

  CmDelonProtect:{

                   case curfield of
                    #fDept :{
                              fDept:='не задан';  SetLimit(Maspodr, 0);
                            }
                   end;
                   RescanPanel(tnNoTable);
                 }

  CmYes :{

          if fDept<>'не задан'
          {

            sqlDropTmpTable('selpodr');
            sqlAddStr(stmt_str, 'TABLE selpodr ( nrecpodr   : Comp ) WITH INDEX (selpodr1 = nrecpodr);');
            sqlCreateTmpTable(stmt_str,ctmDynamicIndex);
            sqlFreeStr(stmt_str);
            stmt_str:=0;


           for(i := 1; i <= Count(maspodr); Inc(i))
           {
!             stmt := sqlAllocStmt;
             ClearQuery(stmt);
             sqlAddStr(stmt, 'INSERT INTO selpodr');
             sqlAddStr(stmt, '(');
             sqlAddStr(stmt, '  nrecpodr');
             sqlAddStr(stmt, ')');
             sqlAddStr(stmt, 'VALUES');
             sqlAddStr(stmt, '(');
             sqlAddStr(stmt, '  #comp(' + maspodr[i] + ')');
             sqlAddStr(stmt, ')');
             sqlExecDirect(stmt);
           }  


          }

           MtClear(#reptable,mfNormal);

           stmt := sqlAllocStmt;
		   sqlAddStr(stmt_str, 'select ');
		   sqlAddStr(stmt_str, '    s.nrec as nrecse  ');
		   sqlAddStr(stmt_str, '   ,podr.name as podrname');
		   sqlAddStr(stmt_str, '   ,podr.code as podrcode');
		   sqlAddStr(stmt_str, '   ,dolj.name as doljname');
		   sqlAddStr(stmt_str, '   ,Coalesce(usl.name,'+''''+'не определено'+''''+') as usllabor');
		   sqlAddStr(stmt_str, '   ,s.dinput as dinput');
		   sqlAddStr(stmt_str, '   ,s.dclose as dclose');
		   sqlAddStr(stmt_str, '   ,Case      ');
		   sqlAddStr(stmt_str, '      when (s.dinput between '+DateToInt_(dbeg)+' and '+DateToInt_(dend)+ ') then '+''''+'Введена новая должность'+'''');
		   sqlAddStr(stmt_str, '      when  (s.dclose between '+DateToInt_(dbeg)+' and '+DateToInt_(dend)+') then '+''''+'Закрыта должность'+'''');
		   sqlAddStr(stmt_str, '      else '+''''+''+'''');
		   sqlAddStr(stmt_str, '    end as remark');
		   sqlAddStr(stmt_str, 'from staffstruct s inner join catalogs podr on s.department = podr.nrec ');
           if fDept<>'не задан'
    		   sqlAddStr(stmt_str, '               inner join selpodr on podr.nrec=selpodr.nrecpodr');

		   sqlAddStr(stmt_str, '                   inner join catalogs dolj on s.post = dolj.nrec ');
		   sqlAddStr(stmt_str, '                   left join catalogs usl on s.workcond = usl.nrec');

		   sqlAddStr(stmt_str, '    where ');
		   sqlAddStr(stmt_str, '       not 0 = Case ');
		   sqlAddStr(stmt_str, '                when (s.dinput between '+DateToInt_(dbeg)+' and '+DateToInt_(dend)+') then 1');
		   sqlAddStr(stmt_str, '                when (s.dclose between '+DateToInt_(dbeg)+' and '+DateToInt_(dend)+') then 2');
		   sqlAddStr(stmt_str, '                else 0');
		   sqlAddStr(stmt_str, '               end ');
           sqlPrepare(stmt,stmt_str);
   		   sqlExecute(stmt);

 		   if (sqlFetchInto(stmt,#reptable) != tsOk)
			        Message('not tsOk select (');
			sqlFreeStmt(stmt);
            sqlFreeStr(stmt);

!           yesbrk:=false;
     	   curcount:=Recordsintable(#reptable);


                XlRes := xlCreateExcel((aFileName), true);
                if (XlRes)
                XlRes := xlIsExcelValid;
                 if (not XlRes)
                 Message('не иннициализирован excel');

                 row:=1;
                 xlSetCellStringValue('Сформировано за период с '+DateToStr(dbeg,'DD/MM/YYYY')+' по '+DateToStr(dend,'DD/MM/YYYY'),1,2,1,2);
                 inc(row);
!                 inc(row);

                 rowshp:=row+1;
                 xlSetCellStringValue('Подразделение',row,1,row,1);
                 xlSetColumnWidth(45,row,1,row,1);

                 xlSetCellStringValue('Должность',row,2,row,2);
                 xlSetColumnWidth(35,row,2,row,2);

                 xlSetCellStringValue('Условия труда',row,3,row,3);
                 xlSetColumnWidth(20,row,3,row,3);

                 xlSetCellStringValue('Дата ввода',row,4,row,4);
                 xlSetColumnWidth(11,row,4,row,4);

                 xlSetCellStringValue('Дата закрытия',row,5,row,5);
                 xlSetColumnWidth(15,row,5,row,5);

                 xlSetCellStringValue('Причина',row,6,row,6);
                 xlSetColumnWidth(26,row,6,row,6);

                 xlSetFontStyle(1, row, 1, row, 6);

                _loop reptable
                {
                 inc(row);
                 xlSetCellStringValue(reptable.podrname+'('+reptable.podrcode+')',row,1,row,1);
                 xlSetCellStringValue(reptable.doljname,row,2,row,2);
                 xlSetCellStringValue(reptable.usllabor,row,3,row,3);
                 if reptable.dinput<>date(0,0,0)
                  xlSetCellStringValue(chr(39)+DateToStr(reptable.dinput,'DD/MM/YYYY'),row,4,row,4);
                 if reptable.dclose<>date(0,0,0)
                 xlSetCellStringValue(chr(39)+DateToStr(reptable.dclose,'DD/MM/YYYY'),row,5,row,5);
                 xlSetCellStringValue(reptable.remark,row,6,row,6);
                }

               xlFreeze(rowshp,1);
               xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideH or xlInsideV,xlThin,xlContinuous,1,rowshp-1,1,row,6);

               xlKillExcel;




         }
  end;
end.

#include UserReport.vih

VipInterface UserReport_Claim_ChangeStavka Implements IUserReport;

Interface UserReport_Claim_ChangeStavka;

create view;

!-------------------------------------------------------------------------------
// Запуск отчета на выполнение при выборе его из списка отчетов
procedure Run;
begin
  RunInterfaceNoModal('Gp_ReportByChangeStavka');
end;
!-------------------------------------------------------------------------------
// Наименование отчета в списке
function GetReportName: String;
begin
  GetReportName := 'Отчет по вновь созданным позициям штатного расписания';
end;
!-------------------------------------------------------------------------------
// Наименования групп, в которые входит отчет
// Группа n+1 делается подчиненной группе n
// В данном случае будет иерархия:
// [+] Группа 1
//     [+] Группа 2
//         Отчет 1
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := '';
  case Level of
    1 : GetGroupName := 'Отчеты по вредным условиям труда';
  end;
end;
!-------------------------------------------------------------------------------
// Приоритет отчета - сортировка внутри группы выполняется сначала
// по приоритету, а затем по наименованию
function GetPriority : Integer;
begin
  GetPriority := 0;
end;
!-------------------------------------------------------------------------------
// ModuleID модулей, в которых будет виден отчет
// '*' - отчет будет виден в любом модуле
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;
!-------------------------------------------------------------------------------
end.
