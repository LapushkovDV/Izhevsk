#include GP_Protector.vih

#include GP_SumVidUd.vih
interface GP_SumVidUd;

PANEL SuMUD
table sumvidud;

HandleEvent
cmDelOnProtect:{
  abort;
}
end;
end;

HandleEvent
cmInit:{
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  var p:GP_Protector;
  p.LinkTo(cfsGetCurrentContainerSelf, '');
  p.ProtectedStatusCtx := sci1Esc;
  p.AutoPalette := true;
  p.SetProtected(true);
}
end;

end.
