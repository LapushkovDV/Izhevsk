/*************************************************************************************************\
* Наименование: Среднемесячные нормы рабочего времени                                             *
* Контур/Модуль: Заработная плата                                                                 *
* Пункт меню: Настройка / НПО Энергомаш / Среднемесячные нормы рабочего времени                   *
* Примечание:                                                                                     *
* Для добавления пункта меню Настройка / Заполнение каталогов / Графики работ / Среднемесячные    *
* нормы рабочего времени нужно запустить интерфейс GP_COMMON::GP_MENUDYNAMIC под администратором  *
* и нажать кнопку "Добавить".                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#761          |22/09/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

interface GP_EditTimeNorms 'Среднемесячные нормы рабочего времени' cyan;
  show at (,, 63, 20);

  create view
    from
      GP_TimeNorms (GP_TimeNorms02)
    where ((
      GP_TimeNorms.cGP_PrCal == GP_PrCal.NRec
    ));

  var 
    pPickMode: Word; // cgiNo(0) - просмотр, cgiPick(1) - выбор
    pcCurRec: tNRec; // NRec выбранной записи
    IsEditMode: Boolean;

  parameters 
    pPickMode, // cgiNo(0) - просмотр, cgiPick(1) - выбор
    pcCurRec; // NRec выбранной записи

  browse brTimeNorms (, hcNoContext, sci1478EnEsc);
    table GP_TimeNorms;
  fields          
    GP_TimeNorms.Year 'Год': [5], noAutoSize;
    GP_PrCal.Name 'Наименование': [40];
    GP_TimeNorms.Hours 'Среднемесячное', 'кол-во часов': [16.2], noAutoSize;
  end;

  procedure SwitchEditMode(pEditMode: Boolean);
  begin
    IsEditMode := pEditMode;
    ToggleFieldProtected(#GP_TimeNorms.Year, not IsEditMode);
    ToggleFieldProtected(#GP_TimeNorms.Hours, not IsEditMode);
    if IsEditMode then
    begin
      // Включение режима редактирования
      SetInterfaceOptions(opEscClose);
      SetHelpAndStatusContext(brTimeNorms, -1, sci1478Esc, hcKeepCurrent);
      SetHelpAndStatusContext(brTimeNorms, #GP_PrCal.Name, sci13478Esc, hcKeepCurrent);
      DisableCommand(cmDefault);
      DisableCommand(cmEdit);
      EnableCommand(cmInsert);
      EnableCommand(cmDelete);
    end else
    begin
      // Выключение режима редактирования
      SetInterfaceOptions(opEscClose or opCyanInterface or opDoAccept);
      SetHelpAndStatusContext(brTimeNorms, -1, if(pPickMode = cgiNo, sci1478Esc, sci1478EnEsc), hcKeepCurrent);
      // SetHelpAndStatusContext(brTimeNorms, #GP_PrCal.Name, sci1478Esc, hcKeepCurrent);
      EnableCommand(cmDefault);
      EnableCommand(cmEdit);
      DisableCommand(cmInsert);
      DisableCommand(cmDelete);
    end;
    RescanPanel(CurTable);
  end;

  handleEvent
    cmInit:
      begin
        if pcCurRec != 0 then
          if getfirst GP_TimeNorms where ((pcCurRec == GP_TimeNorms.NRec)) != tsOk then
            if getfirst GP_TimeNorms = tsOk then
            begin
            end;
        SwitchEditMode(False);
      end;
    cmInsertRecord:
      insert current GP_TimeNorms;
    cmUpdateRecord:
      update current GP_TimeNorms;
    cmDeleterecord:
      if Message('Удалить текущую запись?', YesNo) = Yes then
        delete current GP_TimeNorms;
    cmEdit:
      if not IsEditMode then
        SwitchEditMode(True);
    cmCancel:
      if IsEditMode then
      begin
        SwitchEditMode(False);
        abort;
      end;
    cmDefault:
      if IsEditMode or pPickMode = cgiNo then
        abort
      else
        if not IsValid(tnGP_TimeNorms) then
          abort
        else
          pcCurRec := GP_TimeNorms.nRec;
    cmPick:
      case CurField of
        #GP_PrCal.Name:
          begin
            var _cGP_PrCal: tNRec = GP_TimeNorms.cGP_PrCal;
            if RunInterface('GP_PrCalendars', cgiPick, _cGP_PrCal) = cmDefault then
              set GP_TimeNorms.cGP_PrCal := _cGP_PrCal;
          end;
      end;
    cmDelOnProtect:
      if IsEditMode then
        case CurField of
          #GP_PrCal.Name:
            set GP_TimeNorms.cGP_PrCal := 0;
        end;
  end;

end.
