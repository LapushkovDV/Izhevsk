#component "Z_MP"
#doc
Заработная плата -> Операции - Начисления и выплаты - Расчет
Скачет курсор при системной сортировке
#end
Alter Interface SYS_MBF;

//------------------------------------------------------------------------------
HandleEvent

cmMarkUnMark:
{
  if not IsValid(#SYS_MBF)
    exit;

  if IsValid(#FORMARKS)
    delete current FORMARKS;
  else
  {
    clearbuffer(#formarks);
    MarkCurrentCalc;
  }
#IFDEF _GP_
  // скачет курсор при системной сортировке
  RedrawCurrentAndGo(GetCurrentFormat(),true);
#ELSE
  if getnext SYS_MBF = tsOk {};
  RescanPanel(#SYS_MBF);
#ENDIF
}
end;
end.
