Interface form_reestr_fakel1   escclose;

Show at (,,73,14);

table struct PerZakTemp
(
strtabn:string[6],
Vidper:longint,
clsch:comp,
Sumper:double,
SummGosZak:double,
PriznGosZak:string[50],
cschetd:string[20],
ckaud1:comp,
PriznZatr:integer,
cexoz:comp,
cex:string[3],
Priznak:string,
fio:string
)
with index (pz01=PriznZatr+ckaud1, pz02=clsch+Priznak);
;

table struct PerZak
(
strtabn:string,
Strah:double,
DopSpis1:double,
DopSpis2:double,
DopSpis1Spec:double,
DopSpis2Spec:double,
FOMS:double,
FSS:double,
Travm:double,
PriznakFakel:integer,
cvplan:comp,
name:string
)
with index (p01=cvplan)
;


 
create view jView

var
Counter : longint;
KodCex:string;
METKA:boolean;
DatNach1,DatNach2:date;
VsegoAvPl,VsegoAvF:double;
i15,i16,i17:double;
NrecAttrUO:comp;
ExcelPath:string;
ExcelPath1:string;

NrecPers:longint;
TypeAccount:integer;
NameBank:string;
NumberAccount:string;
Surname:string;
Name:string;
Otch:string;
Status:string;
PriznF:boolean;

   pmes : word ;
   pyearn : integer;
   flabel,FiltrPodr : string;
   countPickPodr : longint ;
   stat,isdbf : integer;
   Filepath : string;

as select * 
from  lschet, PerZak,PerZak perzak1, PerZakTemp,PerZakTemp PerZakTemp1, perevodtekzakaz, persons, persons persons1, pick
      ,Vplan, Mnplan, GP_RASPAVANS,GP_RASPAVANS GP_RASPAVANS1,katpodr

where
((

        pyearn        == perevodtekzakaz.yearn (noindex)
    and pmes          == perevodtekzakaz.mesn  (noindex)


    and perevodtekzakaz.tperson==persons.nrec
    and perevodtekzakaz.cexoz==katpodr.nrec

    and pyearn        == perevodtek.yearn
    and pmes          == perevodtek.mesn
!     and (178<perevodtek.vidopl and 183>perevodtek.vidopl)


    and perevodtek.tperson==persons1.nrec

))
;


 Screen Scrparam ;
   table lschet;
    fields

  pmes       : noprotect;
  pyearn     : noprotect;
  FiltrPodr  : protect,pickbutton;
  isdbf      : noprotect;
  flabel     : protect,skip;
  Filepath   : NoProtect,pickbutton;

  buttons
    cmOk, default,, '~В~вод ', hcOkHelp, sci1Esc;

<<
     `За` .@@@ `месяц` .@@@@ `года`

     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  ` Фильтр по подразделению`

     [.] Формировать расшифровку`
    .@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     <. Сформировать .>

>>

 end;






HandleEvent
 CmInit:{
delete all from perzak;
delete all from perzaktemp;
          pmes:=Month(dgettune('UP.DATOTCH'));
          pyearn:=Year(dgettune('UP.DATOTCH'));
          FiltrPodr:='По всем';
          flabel   :='Папка выгрузки'; 
          ClearFieldState(#flabel,sfVisible);
          ClearFieldState(#Filepath,sfVisible)  ;
        }

CmDelOnProtect:{
                 Case Curfield of 
                  #filtrPodr: { filtrPodr:='По всем';}
                 end;
                 ReScanpanel(curtable);
               }

  CmCheckField:{
                 case curfield of
                 #isdbf :{
                          if isdbf=1
                          {
                           SetFieldState(#flabel,sfVisible);
                           SetFieldState(#Filepath,sfVisible)  ;
                          }
                          else
                          {
                           ClearFieldState(#flabel,sfVisible);
                           ClearFieldState(#Filepath,sfVisible)  ;
                          }
                         }
                end;
                ReScanpanel(curtable);
               } 
cmPick:
{

       Case curfield of
         #filtrPodr : {
  
                       delete novisual Pick where (( 11 == Pick.wList ));
                       countPickPodr  :=0;
                       if runinterface('Z_KATPODR::GetSomePodr')<>cmcancel
                       {
                         FOR (
                               Stat := GetFirst Pick where ((word(11) == Pick.wList));
                               Stat  = tsOk;
                               Stat := GetNext  Pick where ((word(11) == Pick.wList))
                              )
                                          countPickPodr  :=  countPickPodr  + 1;
                            {            
                                   filtrPodr  :='выбрано '+DoubleToStr(countPickPodr,'666 666 667')+' подразд.';
                            }
                       }
                
                      }
            #filepath        :{
                                // filepath:=getdirname('Выберите папку сохранения dbf');
                                set Filepath := FileNetConnect_FolderDialog(Filepath, 'Выберите папку сохранения dbf');

                                if(filepath <> '')
                                  filepath := filepath+'\';
                                ReScanPanel(curtable);
                              }
         end;
         ReScanPanel(curtable);
}
CmOk:
{

 ExcelPath:=StartPathName+'\xls_ЭМ\staff\';

    xlCreateExcelWithTemplate(ExcelPath+'form_reestr_fakel.xlsx',true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');



    StartNewVisual(vtNumericVisual,vfTimer,'Заполняем временную таблицу', 1);

_loop perevodtekZakaz
{
nextvisual;

!if perevodtekzakaz.strtabn<>'002963'
!continue;

if perevodtekzakaz.vidper=13
continue;

  if FiltrPodr<>'По всем'
   if getfirst pick where (( word(11) == pick.wlist and perevodtekZakaz.cexoz == pick.crec))<>tsok
     continue;



clearbuffer(#PerZakTemp);
PerZakTemp.clsch:=Perevodtekzakaz.clsch;
PerZakTemp.strtabn:=Perevodtekzakaz.strtabn;
PerZakTemp.vidper:=Perevodtekzakaz.vidper;
PerZakTemp.sumper:=Perevodtekzakaz.sumper;
PerZakTemp.ckaud1:=Perevodtekzakaz.ckaud[1];
PerZakTemp.cschetd:=Perevodtekzakaz.cschetd;
PerZakTemp.cexoz:=Perevodtekzakaz.cexoz;
PerZakTemp.CEX:=substr(Katpodr.kod,1,3);

if Perevodtekzakaz.tbld[1]=7  PerZakTemp.PriznZatr:=1;

PerZakTemp.fio:=persons.fio;



insert current PerZakTemp;
}


if getfirst katpodr where (('Клинский филиал - Спортивно- оздоровительный центр санаторного типа "Вымпел"' == katpodr.name))=tsok
  delete PerZakTemp where PerZakTemp.cexoz=katpodr.nrec;//00000000006D1886h;
if getfirst katpodr where (('Вымпел договорники' == katpodr.name))=tsok
  delete PerZakTemp where PerZakTemp.cexoz=katpodr.nrec;//000000000266E93Ch;

StopVisual('',0);

    StartNewVisual(vtNumericVisual,vfTimer,'Факел прямые', 1);

_loop vplan where (vplan.name='Факел-2' or vplan.name='Ангара' or vplan.name='Нафтил' or vplan.name='Форсаж')
{
        _loop mnplan where ((vplan.nrec==mnplan.cvplan))
        {
                _loop PerZakTemp where ((mnplan.nrec==PerZakTemp.ckaud1 and 1==PerZakTemp.PriznZatr))
                {
                nextvisual;

!clearbuffer(#Perzak);
!perzak.strtabn:=perzakTemp.strtabn
                if getfirst perzak where ((vplan.nrec==perzak.cvplan))<>tsok
                {
                clearbuffer(#Perzak);
                perzak.cvplan:=vplan.nrec;
                perzak.name:=vplan.name;
                insert current perzak;
                }
                
                if perZakTemp.vidper=5  perzak.strah       :=perzak.Strah+perzakTemp.sumper;
                if perZakTemp.vidper=3  perzak.FOMS        :=perzak.FOMS+perZakTemp.sumper;
                if perZakTemp.vidper=2  perzak.FSS         :=perzak.FSS+perZakTemp.sumper;
                if perZakTemp.vidper=11 perzak.DopSpis1Spec:=perzak.DopSpis1Spec+perZakTemp.sumper;
                if perZakTemp.vidper=12 perzak.DopSpis2Spec:=perzak.DopSpis2Spec+perZakTemp.sumper;
                if perZakTemp.vidper=8  perzak.Travm       :=perzak.Travm+perZakTemp.sumper;
                update current perzak;

                PerZakTemp.Priznak:=vplan.name+'_прямые';
                PerZakTemp.SummGosZak:=perZakTemp.sumper;
                update current PerZakTemp;

                _loop PerZakTemp1 where ((PerzakTemp.clsch==PerzakTemp1.clsch and ''==PerZakTemp1.Priznak))
                {
                PerZakTemp1.priznak:='Накладные_прямые';
                update current PerZakTemp1;
                }


                }
        }
}




StopVisual('',0);

    StartNewVisual(vtNumericVisual,vfTimer,'Факел накладные', 1);

_loop lschet 
{
nextvisual;

Metka:=False;

        if getfirst GP_raspavans1 where ((lschet.nrec==Gp_RaspAvans1.clschet and 0==gp_raspavans1.isarh))=tsok
        {
                _loop perZakTemp where ((lschet.nrec==perZakTemp.clsch and ''==PerZakTemp.Priznak))
                {

                        _loop GP_raspavans where ((lschet.nrec==Gp_RaspAvans.clschet and 0==gp_raspavans.isarh))
                        {
                        Metka:=True;



                                if getfirst perzak where ((Gp_RaspAvans.cvplan==perzak.cvplan))<>tsok
                                {
                                clearbuffer(#Perzak);
                                perzak.cvplan:=Gp_RaspAvans.cvplan;

                                        if getfirst vplan where ((Gp_RaspAvans.cvplan==vplan.nrec))=tsok
                                        {
                                        perzak.name:=vplan.name;
                                        }
                                insert current perzak;
                                }

                        if perZakTemp.vidper=5  perzak.strah       :=perzak.Strah+perzakTemp.sumper*(GP_raspAvans.procent)/100;
                        if perZakTemp.vidper=3  perzak.FOMS        :=perzak.FOMS+perZakTemp.sumper*(GP_raspAvans.procent)/100;
                        if perZakTemp.vidper=2  perzak.FSS         :=perzak.FSS+perZakTemp.sumper*(GP_raspAvans.procent)/100;
                        if perZakTemp.vidper=11 perzak.DopSpis1Spec:=perzak.DopSpis1Spec+perZakTemp.sumper*(GP_raspAvans.procent)/100;
                        if perZakTemp.vidper=12 perzak.DopSpis2Spec:=perzak.DopSpis2Spec+perZakTemp.sumper*(GP_raspAvans.procent)/100;
                        if perZakTemp.vidper=8  perzak.Travm       :=perzak.Travm+perZakTemp.sumper*(GP_raspAvans.procent)/100;

                        update current perzak;

                        PerZakTemp.SummGosZak:=PerZakTemp.SummGosZak+perZakTemp.sumper*(GP_raspAvans.procent)/100;
                        PerZakTemp.PriznGosZak:=PerZakTemp.PriznGosZak+'_'+perzak.name+'_'+GP_raspAvans.procent+'%';
                        PerZakTemp.Priznak:='ГосЗаказ_накл';
                        update current PerZakTemp;
                        }
                }

        }
                _loop perZakTemp where ((lschet.nrec==perZakTemp.clsch))// and ''==PerZakTemp.Priznak))
                {

                if getfirst perzak where ((0==perzak.cvplan))<>tsok
                {
                clearbuffer(#Perzak);
                perzak.cvplan:=0;
                perzak.name:='Накладные';
                insert current perzak;
                }




                if perZakTemp.vidper=5  perzak.strah:=perzak.Strah+perZakTemp.sumper;
                if perZakTemp.vidper=3  perzak.FOMS:=perzak.FOMS+perZakTemp.sumper;
                if perZakTemp.vidper=2  perzak.FSS:=perzak.FSS+perZakTemp.sumper;
                if perZakTemp.vidper=11 perzak.DopSpis1Spec:=perzak.DopSpis1Spec+perZakTemp.sumper;
                
                if perzakTemp.strtabn='000568'  
                {
                if perZakTemp.vidper=12 perzak.DopSpis2:=perzak.DopSpis2+perZakTemp.sumper;
                }
                else
                {
                if perZakTemp.vidper=12 perzak.DopSpis2Spec:=perzak.DopSpis2Spec+perZakTemp.sumper;
                }

                if perZakTemp.vidper=8  perzak.Travm:=perzak.Travm+perZakTemp.sumper;
                update current perzak;

!insert current perzak;
                }

        }
        
        if getfirst perzak where ((0==perzak.cvplan))=tsok
                {
                        _loop perzak1 where ((0<<perzak1.cvplan))
                        {

                        perzak.strah:=perzak.Strah-perZak1.Strah;
                        perzak.FOMS:=perzak.FOMS-perZak1.FOMS;
                        perzak.FSS:=perzak.FSS-perZak1.FSS;
                        perzak.DopSpis1Spec:=perzak.DopSpis1Spec-perZak1.DopSpis1Spec;
                        perzak.DopSpis2Spec:=perzak.DopSpis2Spec-perZak1.DopSpis2Spec;
                        perzak.Travm:=perzak.Travm-perZak1.travm;
                        update current perzak;
                        }
                }       


  if isdbf=1
        puttabletodbf(#perzakTemp,Filepath+'perzakTemp.xls',ptfFullTable);

              XlSetCellStringValue('Сводка отчислений во внебюджетные фонды '+Case(pmes;
                                                                    1 : 'Январь',
                                                                    2 : 'Февраль',
                                                                    3 : 'Март',
                                                                    4 : 'Апрель',
                                                                    5 : 'Май',
                                                                    6 : 'Июнь',
                                                                    7 : 'Июль',
                                                                    8 : 'Август',
                                                                    9 : 'Сентябрь',
                                                                    10 : 'Октябрь',
                                                                    11 : 'Ноябрь',
                                                                    12 : 'Декабрь'
                                                                ) +' '+String(pyearn) + ' года.'
                                 ,1,3,1,3);


Counter:=5;
        
        _loop perzak ordered by perzak.cvplan
        {

        xlsetcellStringValue(Perzak.name,Counter,1,Counter,1);
        xlsetcellNumberValue(round(PerZak.strah,2),Counter,2,Counter,2);
        xlsetcellNumberValue(round(PerZak.DopSpis1,2),Counter,3,Counter,3);
        xlsetcellNumberValue(round(PerZak.DopSpis2,2),Counter,4,Counter,4);
        xlsetcellNumberValue(round(PerZak.DopSpis1Spec,2),Counter,5,Counter,5);
        xlsetcellNumberValue(round(PerZak.DopSpis2Spec,2),Counter,6,Counter,6);
        xlsetcellNumberValue(round(PerZak.FOMS,2),Counter,7,Counter,7);
        xlsetcellNumberValue(round(PerZak.FSS,2),Counter,8,Counter,8);
        xlsetcellNumberValue(round(PerZak.Travm,2),Counter,9,Counter,9);
        Counter++;
        }



StopVisual('',0);
xlkillExcel;

}








end;
end.



