#component "GP_ZP"

#include GP_PerOpl_Helper.vih
interface GP_PerOpl_Helper;

create view
var
  _vidOpl: word;
  _vidPer: word;
  _date: date;
  _naimSocSysCode: comp;
  _lschetNrec: comp;
as select SumUlSoc.Nrec
from SumUlSoc,     //Суммы к обложению по сотруднику по налогу по году
     PodNals,      //Строки шкалы процентов налога
     PodNals PodNalsExists
where ((
  _vidOpl         == KlPerOpl.VidOpl and

  _vidPer         == Perech.VidPer   and

  _lschetNrec     == SumUlSoc.cLSch  and
  year(_date)     == SumUlSoc.Year   and
  _vidPer         == SumUlSoc.VidPer and

  _naimSocSysCode == PodNals.Choice  and
  _date          >>= PodNals.DatRec  and
  _vidPer         == PodNals.VidPer  and

  _naimSocSysCode == PodNalsExists.Choice and
  _vidPer         == PodNalsExists.VidPer
));

create view vFSS
var
  _year: word;
as select KlChild3.Summa
from KlChild3  //Ограничения по ФСС
where ((
  -2     == KlChild3.VidOpl and
  _year >>= KlChild3.YearInt
));

function GetFSSMaxSum(aDate: date): double;
{
  vFSS._year := year(aDate);
  if vFSS.getlast KlChild3 = tsOk
    result := vFSS.KlChild3.Summa
  else
    result := 999999999;
}

function PodNalsExists(aVidPer: word): boolean;
{
  result := false;
  _vidPer := aVidPer;
  if getfirst Perech != tsOk exit;
  if Perech.Param = '+' or
     Perech.Param = 'С' or
     Perech.Param = 'Н' or
     Perech.Param = 'Л' or
     Perech.Param = '1' or
     Perech.Param = '2'
  {
    _naimSocSysCode := coGetTune('UP.ZAR.XP.SCALE_ESN');
    result := getfirst PodNalsExists = tsOk;
  }
}

//Возвращает процент налога на фот/страхового взноса с кодом aVidPer
//на дату aDate. aSumma - сумма к обложению с начала года по дату
function GetPodNalsPercent(aVidPer: word; aDate: date; aSumma: double): double;
{
  result := 0;
  _vidPer := aVidPer;
  _date   := aDate;
  _naimSocSysCode := coGetTune('UP.ZAR.XP.SCALE_ESN');
  var startInt: double;
  startInt := -1;
  _loop PodNals
  {
    if startInt < aSumma and PodNals.EndInt >= aSumma
    {
      result := PodNals.Proc;
      break;
    }
    startInt := PodNals.EndInt;
  }
}

//Возвращает сумму к обложению по соц. налогу с кодом aVidPer по лицевому счету aLSchetNrec
//с начала года по дату aDate
function GetSumUlSocSumma10(aLSchetNrec: comp; aVidPer: word; aDate: date): double;
{
  var d: double = 0;

  _lschetNrec := aLSchetNrec;
  _date       := aDate;
  _vidPer     := aVidPer;

  if getfirst SumUlSoc = tsOk
  {
    var i, imax: byte;
    imax := Month(aDate);
    for (i := 1; i <= imax; i++)
      d += SumUlSoc.Summa10[i];
  }

  result := d;
}

//Возвращает процент соц. налога с кодом aVidPer для лицевого счета aLSchetNrec
//на дату aDate
function GetPerechPercent(aLSchetNrec: comp; aVidPer: word; aDate: date): double;
{
  if PodNalsExists(aVidPer)
  {
    var summa10: double;
    summa10 := GetSumUlSocSumma10(aLSchetNrec, aVidPer, aDate);
    if aVidPer = 2 and summa10 > GetFSSMaxSum(aDate)
      result := 0
    else
      result := GetPodNalsPercent(aVidPer, aDate, summa10);
  }
  else
  {
    _vidPer := aVidPer;
    if getfirst Perech = tsOk
      result := Perech.ProcPer;
  }
}

end.
