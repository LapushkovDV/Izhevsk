/*************************************************************************************************\
* Наименование:  Отчет по начислениям за текущий месяц                                            *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:                                                                                     *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1836         |19/01/18|Ермолов К.Р.             |НПО Энергомаш                    *
\*************************************************************************************************/
#include UserReport.vih
#include marker.vih

interface gp_otchetnach'Параметры отчета' gray
Show at (,,45,7);

table struct otchper
(
  data: date
)
;

table struct tSelPodr // Для маркера по подразделениям
(
nrec: comp,
kod: string,
name: string
)
with index
(
i1 = nrec (unique)
)
;

table struct otchet
(
  podr: string,
  tabnum: string,
  fio: string,
  zakaznum: string,
  sch: string,
  vidopl: word,
  nvidopl: string,
  chasf: double,
  koldn: double,
  chasgr: double,
  koldngr: double,
  summa: decimal(31,15)
)
;

create view otchetnach

var
ExcelPath, podr, cpodr, pUserName, podrloop: string;
counter: longint;
mes, god : integer;
pMarkerpodr: Imarker(marker) new;

as select * from otchper, tSelPodr, otchet;

window wnSelPodr 'Подразделения' doAccept, EscClose;
Show at (5,5,100,25);
Browse brtSelPodr '';
Table tSelPodr;
recMarker=pMarkerPodr {TselPodr.nrec};
Fields
tSelPodr.kod  'Код':[10],Protect,NoDel;
tSelPodr.name 'Наименование подразделения':[100],Protect,NoDel;
end;
end;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  podr: pickbutton, noprotect;
  mes : [list
      1 'Январь',
      2 'Февраль',
      3 'Март',
      4 'Апрель',
      5 'Май',
      6 'Июнь',
      7 'Июль',
      8 'Август',
      9 'Сентябрь',
      10 'Октябрь',
      11 'Ноябрь',
      12 'Декабрь'], protect;
  god: noprotect, spinbutton [1, 1917, 2117];
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Подразделения: .@@@@@@@@@@@@@@@@@@@@
    Месяц:         .@@@@@@@@@@
    Год:           .@@@@@

    <.Сформировать.>

    >>

end;

handleevent

cmInit:
{
  sql
  select dateval
  from tuneval
  where strempty = 'UP.DATOTCH' and obj = 10
  into otchper
  ;

  podr:= 'Не выбрано';
  mes:= month(otchper.data);
  god:= year(otchper.data);
  pUserName:= UserName();

  sql
  select katpodr.nrec, katpodr.kod, katpodr.name
  from katpodr
  inner join zar_user on (upper(zar_user.ownname) = upper(:(pUserName)))
  where length(katpodr.kod) = 3 and (zar_user.podrshare <> '+' or (katpodr.nrec in (select userrights.crecds from userrights where zar_user.ownname = userrights.ownname)))
  into tSelPodr
  ;
}

cmPick:
{
  if curfield = #podr
  {
    runwindow(wnSelPodr);
  }
}

cmGo:
{

ExcelPath:=TranslatePath('%ClientStartPath%');

    xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\ZP\gp_otchetnach.xlsx',true);
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');


StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

counter:= 2;
xlsetcellstringvalue('ОТЧЕТ ПО НАЧИСЛЕНИЯМ ЗА ' + mes + ' МЕСЯЦ ' + god + ' ГОДА', 1, 1, 1, 1);

SubBounds(tbRmtSelPodr1);
AddBounds(tbRmtSelPodr2);

delete all from otchet;

if mes = month(otchper.data) and god = year(otchper.data)
{
  _loop pMarkerpodr
  {
    cpodr:= tSelPodr.kod;

    sql
    select substring(katpodr.kod,1,3), nachisl.strtabn, persons.fio, mnplan.number, nachisl.cschetd, nachisl.vidopl,
    klvidopl.nvidopl, nachisl.chasf, nachisl.koldn, nachisl.chasgr, nachisl.koldngr, nachisl.summa
    from nachisl
    left join persons on persons.nrec = nachisl.tperson
    left join mnplan on mnplan.nrec = nachisl.ckaud[1]
    left join klvidopl on klvidopl.vidopl = nachisl.vidopls
    left join katpodr on katpodr.nrec = nachisl.cexoz
    where substring(katpodr.kod,1,3) = :(cpodr) and nachisl.mesn = :(mes) and nachisl.yearn = :(god)
    into otchet
    ;
  }
}
else
{
  _loop pMarkerpodr
  {
    cpodr:= tSelPodr.kod;

    sql
    select substring(katpodr.kod,1,3), nachislzakaz.strtabn, persons.fio, mnplan.number, nachislzakaz.cschetd, nachislzakaz.vidopl,
    klvidopl.nvidopl, nachislzakaz.chasf, nachislzakaz.koldn, nachislzakaz.chasgr, nachislzakaz.koldngr, nachislzakaz.summa
    from nachislzakaz
    left join persons on persons.nrec = nachislzakaz.tperson
    left join mnplan on mnplan.nrec = nachislzakaz.ckaud[1]
    left join klvidopl on klvidopl.vidopl = nachislzakaz.vidopls
    left join katpodr on katpodr.nrec = nachislzakaz.cexoz
    where substring(katpodr.kod,1,3) = :(cpodr) and nachislzakaz.mesn = :(mes) and nachislzakaz.yearn = :(god)
    into otchet
    ;
  }
}

if getfirst otchet = tsok
{
  podrloop:= otchet.podr;
}

_loop otchet
{
  counter++;

  if otchet.podr = podrloop
  {
    xlsetcellstringvalue(otchet.tabnum, counter, 1, counter, 1);
    xlsetcellstringvalue(otchet.fio, counter, 2, counter, 2);
    xlsetcellstringvalue(otchet.podr, counter, 3, counter, 3);
    xlsetcellstringvalue(otchet.zakaznum, counter, 4, counter, 4);
    xlsetcellstringvalue(otchet.sch, counter, 5, counter, 5);
    xlsetcellnumbervalue(otchet.vidopl, counter, 6, counter, 6);
    xlsetcellstringvalue(otchet.nvidopl, counter, 7, counter, 7);
    xlsetcellnumbervalue(otchet.chasf, counter, 8, counter, 8);
    xlsetcellnumbervalue(otchet.koldn, counter, 9, counter, 9);
    xlsetcellnumbervalue(otchet.chasgr, counter, 10, counter, 10);
    xlsetcellnumbervalue(otchet.koldngr, counter, 11, counter, 11);
    xlsetcellnumbervalue(otchet.summa, counter, 12, counter, 12);
  }
  else
  {
    podrloop:= otchet.podr;
    counter++;
    xlsetcellstringvalue(otchet.tabnum, counter, 1, counter, 1);
    xlsetcellstringvalue(otchet.fio, counter, 2, counter, 2);
    xlsetcellstringvalue(otchet.podr, counter, 3, counter, 3);
    xlsetcellstringvalue(otchet.zakaznum, counter, 4, counter, 4);
    xlsetcellstringvalue(otchet.sch, counter, 5, counter, 5);
    xlsetcellnumbervalue(otchet.vidopl, counter, 6, counter, 6);
    xlsetcellstringvalue(otchet.nvidopl, counter, 7, counter, 7);
    xlsetcellnumbervalue(otchet.chasf, counter, 8, counter, 8);
    xlsetcellnumbervalue(otchet.koldn, counter, 9, counter, 9);
    xlsetcellnumbervalue(otchet.chasgr, counter, 10, counter, 10);
    xlsetcellnumbervalue(otchet.koldngr, counter, 11, counter, 11);
    xlsetcellnumbervalue(otchet.summa, counter, 12, counter, 12);
  }
}

SubBounds(tbRmtSelPodr2);
AddBounds(tbRmtSelPodr1);

StopVisual('',0);
xlkillExcel;


}

end;

windowevent wnSelPodr;

cmDefault:
{
    if pMarkerpodr.count = 0
    {
      podr:= 'Не выбрано';
    }

    SubBounds(tbRmtSelPodr1);
    AddBounds(tbRmtSelPodr2);

    _loop pMarkerpodr
    {
      if pMarkerpodr.count = 1
      {
        podr:= tSelPodr.kod + ' ' + tSelpodr.name;
      }
    }

    SubBounds(tbRmtSelPodr2);
    AddBounds(tbRmtSelPodr1);

    if pMarkerpodr.count > 1
    {
      podr:= 'Выбрано ' + pMarkerpodr.count;
    }
}

end;
end.

VipInterface UserReport_OtchNach Implements IUserReport;
Interface UserReport_OtchNach;

Procedure Run;
Begin
  runinterface(gp_otchetnach);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Отчет по начислениям';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Сводные отчеты по зарплате';
    end;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'menuzarp';
  end;
end;

End.
