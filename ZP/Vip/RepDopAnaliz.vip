#include Query.vih
#include GetKau.Vih
#include Marker.Vih

VipInterface RepDopAnaliz Licensed(free);

Interface RepDopAnaliz 'Отчет для доп. анализа' EscClose;
Show At(,,66,9);

Table Struct tmpPodr
(
    cPodr : comp
  , sPodr : string
)
with index
(
    i01 = cPodr
);

Table Struct tmpPers
(
    cPers : comp
  , sPers : string
)
with index
(
    i01 = cPers
);

Table Struct tmpHrs
(
    cPodr   : comp
  , sPodr   : string
  , clSchet : comp
  , sTabN   : string
  , sFio    : string
  , dHrs1   : double
  , dHrs2   : double
  , dHrs3   : double
  , dHrs4   : double
  , dTar    : double
  , dSum    : double
)
with index
(
    i01 = cPodr
  , i02 = clSchet
);

Create View rView

var
  _log           : string = '';

  _dOtch         : date;
  _sPeriod       : string;
  _sPodr         : string;
  _sPers         : string;
  _dSum          : double;
  _cPodr         : comp;
  _cPeriod       : comp;
  _cPers         : comp;

  _getKau        : GetKau;

As

select
  1
from
  KatPodr
, FpPeriod
, tmpPodr
, tmpPers
, tmpHrs
, lSchet
, Persons
, Nachisl
, SumVidOp
;


Screen scr1 'Отчет для доп. анализа' (,,sci13Esc);
Show At(,,,);

Fields

  _sPeriod    ('Текущий период')          :   Protect,   PickButton;
  _sPodr      ('Подразделение')           :   Protect,   PickButton;
  _sPers      ('Сотрудник')               :   Protect,   PickButton;
  _dSum       ('Предельная сумма')        : noProtect, noPickButton;

Buttons
  cmOk    ,,,'Сформировать',,sci1Esc;
  cmCancel,,,'Отмена'      ,,sci1Esc;
<<

 Текущий период  .@@@@@@@@@@@@@@@@@@@@@@@@@@@

 Подразделение   .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Сотрудник       .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Сумма пред.     .@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <. Сформировать .>  <. Отмена .>

>>
End; //scr1


Procedure GetTabHrs();
{
  Delete All tmpHrs;

  var dH : double = 0.0;
  if (InitWorkingTable)
  {
    _Loop tmpPodr
    {
      StartNewVisual(vtRotateVisual, vfTimer, 'Обработка лицевых счетов'#13 +
                                              'Подразделение ' + tmpPodr.sPodr  , 0);

      _Loop lSchet where ((tmpPodr.cPodr == lSchet.Cex))
      {
        if (lSchet.DatUv <> Date(0, 0, 0) and lSchet.DatUv < FpPeriod.dBeg) then
        {
          Continue;
        }

        if (_sPers <> '') then
        {
          if (getFirst FastFirstRow tmpPers where ((lSchet.tPerson == tmpPers.cPers)) <> tsOk) then
          {
            Continue;
          }
        }

        if (LoadWorkingTable(lSchet.nRec, Month(FpPeriod.dBeg), Year(FpPeriod.dEnd)) = 0)
        {
          ClearBuffer(#tmpHrs);
            tmpHrs.cPodr    := tmpPodr.cPodr;
            tmpHrs.sPodr    := tmpPodr.sPodr;
            tmpHrs.clSchet  := lSchet.nRec;
            tmpHrs.sTabN    := lSchet.StrTabN;
            if (getFirst FastFirstRow Persons where ((lSchet.tPerson == Persons.nRec)) = tsOk) then
            {
              tmpHrs.sFio   := Persons.Fio;
            }
            tmpHrs.dHrs1  := WT_GetHoursBwDates(hkWorking,  0, 0, stActual, FpPeriod.dBeg, FpPeriod.dEnd);
            tmpHrs.dHrs2  := WT_GetHoursBwDates(hkWeekend,  0, 0, stActual, FpPeriod.dBeg, FpPeriod.dEnd);
            tmpHrs.dHrs3  := WT_GetHoursBwDates(hkOrderedWeekendWorkForLeave,  0, 0, stActual, FpPeriod.dBeg, FpPeriod.dEnd);
            tmpHrs.dHrs4  := WT_GetHoursBwDates(hkOverwork, 0, 0, stActual, FpPeriod.dBeg, FpPeriod.dEnd);
            tmpHrs.dTar   := lSchet.Tarif;
            if (_dOtch >= FpPeriod.dBeg and _dOtch <= FpPeriod.dEnd) then
            {
              _Loop Nachisl where ((lSchet.nRec == Nachisl.cLsch))
              {
                tmpHrs.dSum := tmpHrs.dSum + Nachisl.Summa;
              }
            }
            else
            {
              _Loop SumVidOp where ((Month(FpPeriod.dBeg) == SumVidOp.MesN and Year(FpPeriod.dBeg) == SumVidOp.YearN and lSchet.nRec == SumVidOp.cLsch))
              {
                tmpHrs.dSum := tmpHrs.dSum + SumVidOp.Summa;
              }
            }
          Insert Current tmpHrs;
        }
      }
      StopVisual;
    }
  }
  DoneWorkingTable;
}

Procedure PrintRep();
{
  if (not xlCreateExcel('RepDopAn' + DateToStr(Cur_Date(), '_YYYYMMDD') + TimeToStr(Cur_Time(), '_HHMMSS') + '.xlsx', true)) then
  {
    Message('Ошибка создания нового файла Excel', Error);
    Exit;
  }
  else
  {
    StartNewVisual(vtNumericVisual, vfTimer, 'Выгрузка отчета в Excel', 0);

    var RowNo : longint = 1;
    var ColNo : longint = 1;
    var _k : longint = RecordsInTable(tntmpHrs);


    var i : longint = 0;

    if (xlIsExcelValid) then
    {
      xlSetActiveWorkBookByName('1');
    }

    xlSetCellStringValue('Отчет для дополнительного анализа за период с ' + DateToStr(FpPeriod.dBeg, 'DD.MM.YYYY') + ' по ' + DateToStr(FpPeriod.dEnd, 'DD.MM.YYYY'), RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo, ColNo + 6);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo + 6);
    RowNo := RowNo + 2;

    xlSetCellStringValue('Подразделение', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Т/Н', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('ФИО', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Отработанное время по графику', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Отработанное время в выходные дни', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Отработанное время в выходные дни за отгул', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Отработанное время сверхурочно', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Тариф/Оклад', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Общая сумма всех начислений', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    RowNo++;

    _Loop tmpHrs
    {
      if (_dSum <> 0.0) then
      {
        if (tmpHrs.dSum < _dSum) then
        {
          _k := _k - 1;
          Continue;
        }
      }

      ColNo := 1;

      xlSetCellStringValue(chr(39) + tmpHrs.sPodr , RowNo, ColNo, RowNo, ColNo); ColNo++;
      xlSetCellStringValue(chr(39) + tmpHrs.sTabN , RowNo, ColNo, RowNo, ColNo); ColNo++;
      xlSetCellStringValue(chr(39) + tmpHrs.sFio  , RowNo, ColNo, RowNo, ColNo); ColNo++;
      xlSetCellStringValue(          tmpHrs.dHrs1 , RowNo, ColNo, RowNo, ColNo); ColNo++;
      xlSetCellStringValue(          tmpHrs.dHrs2 , RowNo, ColNo, RowNo, ColNo); ColNo++;
      xlSetCellStringValue(          tmpHrs.dHrs3 , RowNo, ColNo, RowNo, ColNo); ColNo++;
      xlSetCellStringValue(          tmpHrs.dHrs4 , RowNo, ColNo, RowNo, ColNo); ColNo++;
      xlSetCellStringValue(          tmpHrs.dTar  , RowNo, ColNo, RowNo, ColNo); ColNo++;
      xlSetCellStringValue(          tmpHrs.dSum  , RowNo, ColNo, RowNo, ColNo);

      RowNo++;
    }

    xlSetNumberFormat('### ### ### ##0' + xlGetDecimalSeparator + ' 00', 4, 4, 4 + _k, 9);

    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, 3, 1, 3 + _k, 9);

    xlAutoFit(1, 1, 3 + _k, 9);

    xlKillExcel;
    StopVisual;
  }

}


HandleEvent

cmInit:
{
  _dOtch := dGetTune('UP.DATOTCH');
}

cmPick:
{
  var _i : longint;
  case CurField of
    #_sPodr:
    {
      Delete All tmpPodr;
      var _tmpMarkerName : string;
      var stMarker       : longint;

      if (iGetKau.GetCodeKau(cgiMulti, cgKau_KatPodr, _cPodr) <> 0) then
      {
        _tmpMarkerName := iGetKau.GetMarkerName(cgKau_KatPodr);
        stMarker       := InitMarker(_tmpMarkerName, 8, 10, 100, true);
        _i             := 0;
        while getmarker(stMarker, _i, _cPodr)
        {
          if (getFirst KatPodr where ((_cPodr == KatPodr.nRec)) = tsOk) then
          {
            ClearBuffer(#tmpPodr);
              set tmpPodr.cPodr := KatPodr.nRec;
              set tmpPodr.sPodr := KatPodr.Kod;
            Insert Current tmpPodr;
          }
          _i++;
        }
        DoneMarker(stMarker, _tmpMarkerName);
      }
      if (getFirst KatPodr where ((_cPodr == KatPodr.nRec)) = tsOk) then
      {
        set _sPodr := KatPodr.Kod + if((_i-1) > 0, ' и еще ' + string(_i-1), '');
      }
    }

    #_sPers:
    {
      Delete All tmpPers;
      var _tmpMarkerName : string;
      var stMarker       : longint;

      if (iGetKau.GetCodeKau(cgiMulti, cgKau_Persons, _cPers) <> 0) then
      {
        _tmpMarkerName := iGetKau.GetMarkerName(cgKau_Persons);
        stMarker       := InitMarker(_tmpMarkerName, 8, 10, 100, true);
        _i             := 0;
        while getmarker(stMarker, _i, _cPers)
        {
          if (getFirst Persons where ((_cPers == Persons.nRec)) = tsOk) then
          {
            ClearBuffer(#tmpPers);
              set tmpPers.cPers := Persons.nRec;
              set tmpPers.sPers := Persons.Fio;
            Insert Current tmpPers;
          }
          _i++;
        }
        DoneMarker(stMarker, _tmpMarkerName);
      }
      if (getFirst Persons where ((_cPers == Persons.nRec)) = tsOk) then
      {
        set _sPers := Persons.Fio + if((_i-1) > 0, ' и еще ' + string(_i-1), '');
      }
    }

    #_sPeriod:
    {
      if (iGetKau.GetCodeKau(cgiPick, cgKau_FpPeriod, _cPeriod) <> 0) then
      {
        if (getFirst FpPeriod where ((_cPeriod == FpPeriod.nRec)) = tsOk) then
        {
          set _sPeriod := FpPeriod.Name;
        }
      }
    }
  end;
  ReReadRecord;
}

cmDelOnProtect:
{
  case CurField of
    #_sPodr:
    {
      set _cPodr := 0h;
      set _sPodr := '';
      Delete All tmpPodr;
    }
    #_sPers:
    {
      set _cPers := 0h;
      set _sPers := '';
      Delete All tmpPers;
    }
    #_sPeriod:
    {
      set _cPeriod := 0h;
      set _sPeriod := '';
    }
  end;
  ReReadRecord;
}

cmOk:
{
  if (_sPodr = '') then
  {
    Message('Выбор подразделения обязателен');
    Exit;
  }

  GetTabHrs();
  if (RecordsInTable(tntmpHrs) = 0) then
  {
    Message('Нет данных для построения отчета');
    Exit;
  }
  PrintRep();
}

end;

End.

#include UserReport.vih

VipInterface UserReport_RepDopAnaliz Implements IUserReport;
Interface UserReport_RepDopAnaliz;

Procedure Run;
Begin
  RunInterface(RepDopAnaliz);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Отчет для доп. анализа';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'MENUZARP';
  end;
end;

End.
