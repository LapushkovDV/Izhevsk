#include GP_FRFormatterOfReestr.Vih
#include FRRecordDefinition.vih


#doc
  FastReport-форматтер данных для электронных реестров. </brief>
  Наследник от Z_PAYREP##FRFormatterOfReestr.Vip
#end

Interface GP_FRFormatterOfReestr; //(FRFormatterOfReestr)
var
  sNameForm:string;
create view
Bounds ByChildSbBan  SBBANNRec == SbBan.cNode
//        and (SbBan.VidUd<>182)
Bounds ByChildSpPlBan  SbBan.Nrec ==  SPPLBAN.csbban
bounds byPrnSbBan   tmp_SPPLBAN.csbban   == SbBan.Nrec
bounds byPrnSPPLBAN tmp_SPPLBAN.cSPPLBAN == SPPLBAN.Nrec
;


Window wnPrim 'Введите наименование перечисления', EscClose;
show at (,,50,6);
Screen scrPrim(,,sci1Esc);
Table SbBan;
Fields
  sPrim :NoProtect;
Buttons
  cmOk,default,,'Сформировать отчет', hcOplTrudhlp, sci1Esc;
  cmCancel,,,'Выход', hcOplTrudhlp, sci1Esc;
<<
 `Наименование перечисления`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <.Продолжить.>    <. ~О~тмена .>

>>
end; //Screen scrPrim
HandleEvent
cmOk:
{
  CloseWindowEx(wnPrim,cmOk);
}
end;
end;// Window wnPrim

//----------------------------------------
// Печать
//----------------------------------------
function IFRFormatterOfReestr.Run(prmSBBANNRec: tNrec): boolean;
var FReport: LongInt;
    ReportNames: array [0..0] of String;
#IFDEF _2019_02_13_
    ExportParam:String;
#ELSE
    ExportParam:frxPDFExportParam;
#ENDIF
{
#IFDEF _GP_
  PushBounds(#SbBan);
  PushBounds(#SpPlBan);
  ResetBounds(#tmp_SPPLBAN);
  delete all tmp_SPPLBAN;
#ENDIF
  SBBANNRec := prmSBBANNRec;
  // Подготовим некоторые данные:
#IFDEF _GP_
  if GetFirst SbBan=tsok
   if SbBan.Prefix='R$$'
   { PushBounds(tbByChildSbBan);
     PushBounds(tbByChildSpPlBan);
   }
  _Loop SbBan
  {
#ENDIF
    PrepareData();
#IFDEF _GP_
    var _pSbBan:comp=SbBan.Nrec;
    insert into tmp_SpPlBan select
         SPPLBAN.cSbBan
        ,SPPLBAN.Nrec
        ,SPPLBAN.cLsch
        ,SPPLBAN.FIO
        ,SPPLBAN.SumOpl
        ,SPPLBAN.NomCard
        ,SPPLBAN.NOMLSH
      from SPPLBAN where (( _pSbBan == SPPLBAN.cSbBan ))
    ;
  }
  PushBounds(tbbyPrnSPPLBAN);
  PushBounds(tbbyPrnSbBan);
#ENDIF
  // Кэш параметра Windows.VisualThread
  var oldValue: boolean;
  _try
  {
    // Есть проблема 101.41251 - зависание при включенной настройке VisualThread
    // Поэтому сейчас вручную ставим настройку в on
    // а по завершению в off
    oldValue := GetBooleanParameter('Windows', 'VisualThread', 0);
    // Отключаем вывод визуализации в отдельном потоке:
    SetBooleanParameter('Windows', 'VisualThread', ifNoModifiedFlag, false);

    // Запускаем FR-форматер: (идет визуализация)
    if sNameForm=''
    { RunFReport(EReestr, sNameForm, true);
    }
    else
    { FReport := FRCreate(EReestr);
      FRGetReportNames(FReport, ReportNames);
      var ii:word;
      if (count(ReportNames)>0)
      { For(ii:=0;ii<count(ReportNames);ii++)
        { timelog('GP_FRFormatterOfReestr:'+ReportNames[ii]);
          if ReportNames[ii]=sNameForm
          if (FROpenReport(FReport, ReportNames[ii]))
          {
#IFDEF _2019_02_13_
            //'Pages=1-5;Picture=False;DeleteEmptyRows=True;OpenAfterExport=True'
            ExportParam:='ShowDialog=False;OpenAfterExport=True';
#ELSE
            ClearAdvRecord(ExportParam);
            FRGetDefaultParameters(frExportPDF, ExportParam);
            ExportParam.Pages:='';
            ExportParam.ShowDialog := False;
            ExportParam.OpenAfterExport := True;
#ENDIF
            if (FRSetParameters(FReport, frExportPDF, ExportParam))
             FRExportReport(FReport, frExportPDF, '');
          } //if (FROpenReport(FReport, ReportNames[0]))
        }
      }
      else
      { RunFReport(EReestr, sNameForm, true);
      }
      FRDestroy(FReport);
    } //else if not boPrintToPDF

  }
  _finally
  {
    // Возвращаем на место значение старого параметра Windows.VisualThread
    SetBooleanParameter('Windows', 'VisualThread', ifNoModifiedFlag, oldValue);
  }

  Result := true;//
} // public function Run
//--------------------------------
Function RunPDF(_pNrec:comp;_NameForm:string; Need_Prim:boolean=false) :boolean;
{ //ATTR_SB_PRIM в Z_PAYREP##FRFormatterOfReestr.Vip

  sPrim:=sGetAttrID(coSbBan,_pNrec,ATTR_SB_Prim);
  if Need_Prim
  { if RunWindowModal(wnPrim)<>cmOk exit;
    sSetAttrID(coSbBan,_pNrec,ATTR_SB_Prim,sPrim)
  }

  sNameForm:=_NameForm;
  timelog_Init;
  Run(_pNrec);
  Result:=True;
}

Function RunPDFBatch(_pNrec:comp; _NameForm, _FileName:string) :boolean;
var FReport: LongInt;
    ReportNames: array [0..0] of String;
    ExportParam:String;
{
  Result := false;
  sNameForm := _NameForm;
  PushBounds(#SbBan);
  PushBounds(#SpPlBan);
  ResetBounds(#tmp_SPPLBAN);
  delete all tmp_SPPLBAN;
  SBBANNRec := _pNrec;
  if GetFirst SbBan=tsok
   if SbBan.Prefix='R$$'
   { 
     PushBounds(tbByChildSbBan);
     PushBounds(tbByChildSpPlBan);
   }
  _Loop SbBan
  {
    PrepareData();
    var _pSbBan:comp=SbBan.Nrec;
    insert into tmp_SpPlBan 
    select SPPLBAN.cSbBan, SPPLBAN.Nrec, SPPLBAN.cLsch, SPPLBAN.FIO, SPPLBAN.SumOpl, SPPLBAN.NomCard, SPPLBAN.NOMLSH 
    from SPPLBAN where (( _pSbBan == SPPLBAN.cSbBan ));
  }
  PushBounds(tbbyPrnSPPLBAN);
  PushBounds(tbbyPrnSbBan);
  // Кэш параметра Windows.VisualThread
  var oldValue: boolean;
  _try
  {
    // Есть проблема 101.41251 - зависание при включенной настройке VisualThread
    // Поэтому сейчас вручную ставим настройку в on
    // а по завершению в off
    oldValue := GetBooleanParameter('Windows', 'VisualThread', 0);
    // Отключаем вывод визуализации в отдельном потоке:
    SetBooleanParameter('Windows', 'VisualThread', ifNoModifiedFlag, false);

    FReport := FRCreate(EReestr);
    FRGetReportNames(FReport, ReportNames);
    var ii:word;
    if (count(ReportNames)>0)
    { 
      For(ii:=0;ii<count(ReportNames);ii++)
      { 
        timelog('GP_FRFormatterOfReestr:'+ReportNames[ii]);
        if ReportNames[ii]=sNameForm
        if (FROpenReport(FReport, ReportNames[ii]))
        {
          ExportParam:='ShowDialog=False;OpenAfterExport=False';
          if (FRSetParameters(FReport, frExportPDF, ExportParam))
            FRExportReport(FReport, frExportPDF, _FileName);
        }
      }
    }
    FRDestroy(FReport);
  }
  _finally
  {
    // Возвращаем на место значение старого параметра Windows.VisualThread
    SetBooleanParameter('Windows', 'VisualThread', ifNoModifiedFlag, oldValue);
  }
  Result:=True;
}
end.
