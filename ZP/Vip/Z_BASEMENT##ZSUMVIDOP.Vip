#include GP_Protector.vih

#component "Z_BASEMENT"
#doc
 Наименование: Лицевые счета - Смежные данные - Суммы по видам оплат
 Контур/Модуль: Зарплата
 <p>#2516 запрет редактирования данные на вкладке АРХИВНЫЕ ДАННЫЕ.
#end;
Alter Interface ZSUMVIDOP;
var
  DataProtector       : IGP_Protector2;//защита полей от модификации
//************************************************
// события интерфейса
//************************************************
HandleEvent
cmInit:
{ //Разрешить редактирование архивов "Суммы по видам оплат/удержаний","Архив налогов на фот"
  if not boGetTune('NPOEM_OWN.ZP.ARCH_EDIT')
  { //ProtectRecord(#SUMVIDOP,true); не срабатывает
    LoadVipRef(DataProtector, 'GP_Protector');
    DataProtector.LinkToExt(cfsGetCurrentContainerSelf, '', true);
    DataProtector.ProtectedStatusCtx := sci14Esc;
    DataProtector.AutoPalette := true;
    DataProtector.SetProtected(true);
    FreeVipInterface(DataProtector);
  }
  else
  { //ProtectRecord(#SUMVIDOP,False);
  }
  //----------------------
  if  inherited :: handleEvent (cmInit)=heAbort then Abort;
  //----------------------

}
end;
end.
