Function getColorForRow(_wStatus : word; _MNPLANENDDATE, _PRNARYADDATOK: date) : word; cacheable;
{
  result := 0;
   case _wStatus of
     2,5,6 :
      {
        if date(01,month(_MNPLANENDDATE), year(_MNPLANENDDATE)) <  date(01,month(_PRNARYADDATOK), year(_PRNARYADDATOK))
        result := ColorError
      }
   end;
}


