function IsProtectedRecord : boolean;
{
  //result := ProtectedCheckedNaryad AND CheckedDate <> ZeroDate;
  result := ProtectedCheckedNaryad or Sys_Nar.CheckDate <> ZeroDate or Sys_Nar.choice = 3 ;//and IsValidAll(tnGP_PrNaryad_Ext);

  if (isProt <> result)
    {
      if (result)
        {
//          SetFieldOption(#SYS_NAR.NMNEM, ofProtected);
          SetFieldOption(#SYS_NAR.DATAN, ofProtected);
          SetFieldOption(#SYS_NAR.DATOK, ofProtected);
//          SetFieldOption(#Sys_Nar.CheckDate, ofProtected);

          SetFieldOption(#StandardTimeStr  , ofProtected);
          SetFieldOption(#PRNARYAD.SUMMA   , ofProtected);
          SetFieldOption(#PRNARYAD.PROC    , ofProtected);
          SetFieldOption(#PRNARYAD.SUMMPREM, ofProtected);
          SetFieldOption(#PRNARYAD.DATAN   , ofProtected);
          SetFieldOption(#PRNARYAD.DATOK   , ofProtected);

        }
       else
        {
//          ClearFieldOption(#SYS_NAR.NMNEM, ofProtected);
          ClearFieldOption(#SYS_NAR.DATAN, ofProtected);
          ClearFieldOption(#SYS_NAR.DATOK, ofProtected);
//          ClearFieldOption(#Sys_Nar.CheckDate, ofProtected);

          ClearFieldOption(#StandardTimeStr  , ofProtected);
          ClearFieldOption(#PRNARYAD.SUMMA   , ofProtected);
          ClearFieldOption(#PRNARYAD.PROC    , ofProtected);
          ClearFieldOption(#PRNARYAD.SUMMPREM, ofProtected);
          ClearFieldOption(#PRNARYAD.DATAN   , ofProtected);
          ClearFieldOption(#PRNARYAD.DATOK   , ofProtected);

        }



      //-1 не надо, тогда уже ''
      SetHelpAndStatusContext(scrEdit,     -1, if (result, sci17Esc, sci178Esc), hcNoContext);
      SetHelpAndStatusContext(scrEdit, #PrichNesootvFld , if (result, sci1Esc , sci13Esc ), hcNoContext);
      SetHelpAndStatusContext(scrEdit, #ShZKFld         , if (result, sci1Esc , sci13Esc ), hcNoContext);
      SetHelpAndStatusContext(scrEdit, #PrichKartRazrFld, if (result, sci1Esc , sci13Esc ), hcNoContext);

      SetHelpAndStatusContext(brwEdit, -1               , if (result, sci1Esc , sci178Esc) , hcNoContext);
      SetHelpAndStatusContext(brwEdit, #PRNARYAD.TABN   , if (result, sci1Esc , sci1378Esc), hcNoContext);
      SetHelpAndStatusContext(brwEdit, #PRNARYAD.STRTABN, if (result, sci1Esc , sci1378Esc), hcNoContext);
      SetHelpAndStatusContext(brwEdit, #PRNARYAD.DATAN  , if (result, sci1Esc , sci1378Esc), hcNoContext);
      SetHelpAndStatusContext(brwEdit, #PRNARYAD.DATOK  , if (result, sci1Esc , sci1378Esc), hcNoContext);
      SetHelpAndStatusContext(brwEdit, #WorkerName      , if (result, sci1Esc , sci1378Esc), hcNoContext);
      SetHelpAndStatusContext(brwEdit, #NamKAUD         , if (result, sci1Esc , sci1378Esc), hcNoContext);
      SetHelpAndStatusContext(brwEdit, #PaymentKindStr  , if (result, sci1Esc , sci1378Esc), hcNoContext);

      ProtectRecord(#PRNARYAD, result);

    }
      //ProtectRecord(#SYS_NAR,  result);
     if not (IsValidAll(tnGP_PrNaryad_Ext) or Sys_Nar.CheckDate <> ZeroDate or Sys_Nar.choice = 3 ) {
//        message('not IsValidAll');
//       ClearFieldOption(#SYS_NAR.NMNEM, ofProtected);
       CfsSetProp('i_SCREDIT_SYS_NAR.NMNEM'   ,'PROTECT', FALSE);
       CfsSetProp('i_SCREDIT_SHZKFLD'         ,'DefaultPickButton', TRUE);
       CfsSetProp('i_SCREDIT_PRICHNESOOTVFLD' ,'DefaultPickButton', TRUE);
       CfsSetProp('i_SCREDIT_PRICHKARTRAZRFLD','DefaultPickButton', TRUE);
       ClearFieldOption(#PRNARYAD.SUMMA   , ofProtected);
      }
      else {
//        message('IsValidAll');
       CfsSetProp('i_SCREDIT_SYS_NAR.NMNEM'   ,'PROTECT', true) ;
       SetFieldOption(#PRNARYAD.SUMMA   , ofProtected);
       CfsSetProp('i_SCREDIT_SHZKFLD'         ,'DefaultPickButton',FALSE);
       CfsSetProp('i_SCREDIT_PRICHNESOOTVFLD' ,'DefaultPickButton',FALSE);
       CfsSetProp('i_SCREDIT_PRICHKARTRAZRFLD','DefaultPickButton',FALSE);
      }

  if isValidAll(tnGP_PrNaryad_Ext)
   {
     SetHelpAndStatusContext(scrEdit,     -1, sci1Esc, hcNoContext);
   }
  isProt := result;
//  result := false;
}
//*****************************************************************************
Function CheckPN : boolean;
{
  result := true;
  if isValidAll(tnGP_PrNaryad_Ext) then exit; // для АММ не проверяем
  if ((PrNaryad.VidOpl=1 or PrNaryad.VidOpl=7) AND PrNaryad.NRMTIME = 0)
    {
      result := false;
      Exit;
    }

  if(NamKAUD  = '')
    {
      result := false;
      Exit;
    }

  if(PrNaryad.VidOpl  = 0)
    {
      result := false;
      Exit;
    }     
}

Function CheckPrNaryad(_boUpdate:boolean=false) : boolean;
{ if _boUpdate
// - эта же функция идет в cmUpdateRecord - и сие приводит к зацикливанию
    UpdateTable;
  result := true;

  PushPos(#PrNaryad);
  _LOOP PrNaryad
    {
      result := CheckPN;
      if (NOT result)
        break;
    }
  PopPos(#PrNaryad);

  //#2642 Проверка на заполненность причины несоответствия
  result := result and IsPrichNesootvValid;
}

//*****************************************************************************

HandleEvent
    cmPrintDoc:
      PrintDoc;

cmInit:
  {

    if (NOT CheckPrNaryad)
      nRecProtect := SYS_NAR.NRec;
    else
      nRecProtect := 0;
    if IsValidAll(tnGP_PrNaryad_Ext)
     then SetFormat(brwEditAMM)
     else SetFormat(brwEdit) ;
    if isValidAll(tnAvError) and AvError.VsTRING <> ''
     then
      {
       CfsSetProp('i_SCREDIT_AVERROR.VSTRING','Visible',true);
       CfsSetProp('L_SCREDIT_Описание_ошибки','Visible',true);
      }
     else
      {
       CfsSetProp('i_SCREDIT_AVERROR.VSTRING','Visible',false);
       CfsSetProp('L_SCREDIT_Описание_ошибки','Visible',False);
      }
  }

cmOpenSearch:
  {
    if IsProtected(CurTable)
      {
        abort;
        exit;
      }

    case CurField of
      #PaymentKindStr,
      #PremiumPaymentKindStr:
      {
        QuickChoiceName := 'qcPaymentUserNumber';
        ProcessCommand(cmPick);
      }
      else
      {
       ProcessCommand(cmPick);
       abort;
      }
      end;
    }

cmHotKeys:
  {
    var ComponentName: string; ComponentName := '#__COMPONENT__::';

    if wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE') = 1 or wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE')  = 2 // роль BTZ admin
    {
     enablecommand(cmValue4);
    }
    else
    {
     Disablecommand(cmValue4);
    }
    if (curTable = #PRNARYAD)
      PutHotCommand(RunDynMenu(ComponentName + 'GPPrNaryad_HotKeys;'));
  }
cmvalue3:
{
//  message(bogettune('UP.ZAR.WT.ENHANCEDTIMEFORMAT'));
 bosettune('UP.ZAR.WT.ENHANCEDTIMEFORMAT',not bogettune('UP.ZAR.WT.ENHANCEDTIMEFORMAT'));
 rereadrecord;
}

cmValue2:
  {
    if (Message('Сделать копию текущей записи?', Confirmation + YesNo) <> cmYes)
      exit;

    if (not UpdateTable)
      exit;

    var OldOwner: comp; OldOwner := PRNARYAD.NREC;
    PRNARYAD.NREC      := GetNextNRec(tnPRNARYAD, 0);
    PRNARYAD.SUMMA     := 0;
    PRNARYAD.SUMMPREM  := 0;
    prnaryad.ckaud[6]  := prnaryad.nrec;
    insert current prnaryad;
    RereadRecord(CurTable);

    if CharacterClockNumbers
      SelectField(#PRNARYAD.STRTABN);
    else
      SelectField(#PRNARYAD.TABN);
  }
/* по идее все проверки на корректность должны быть при смене статуса, а не тут
cmDone:
  {
    if (NOT CheckPrNaryad) and sys_nar.choice <> 904
      {
        Message('Не все обязательные поля были заполнены! _');
        Abort;
      }
  }
*/
end;
End;

panel pJobSheets;
  table SYS_NAR;

browse brw ('', hcZar_NaryadObject, sci1478EnIns);
  show (,,,);
fields {font = {Color = if(IsErrorZakaz(Sys_Nar.Nrec, Sys_Nar.Atl_lasttime),10,0)}};

    JobSheetMarkedStr                                                                      :    [1], Skip, NoAutosize;
    ChoiceFld            'Статус'               ('Статус наряда')    :    [14], Skip, NoAutosize;
    MonthUshStr          'Месяц учета'               ('Месяц учета')    :    [14], Skip, NoAutosize;
    NaryadSource         'Система',' ввода наряда.'  ('Система в которой был внесен наряд',,):    [5], Skip, NoAutosize, Centered,
          {font = {color = if(JobSheetMarked, ColorMark, if (IsValidAll(#PRNARYAD), 0, ColorSysGray)); BackColor = if(IsValidAll(tnGP_PrNaryad_Ext),ColorSysTeal,0)}};
     NaryadDateCreate    'Дата ввода','наряда'  ('Дата ввода наряда',,):    [6],Protect;
    StateFlag            'Расч.'  ('"+" - была разноска, "++" - был расчет и разноска',,):    [5], Skip, NoAutosize, Centered;
    SYS_NAR.NMNEM        'Наименование'                           ('Наименование наряда'):   [30], Protect;
    TotalChasF(Sys_nar.nrec,Sys_nar.atl_lasttime)   'Норма времени' ('Норма времени'):   [8.4,'666`666,8888'], Protect,
          {font = {BackColor = if(TotalChasF(Sys_nar.nrec,Sys_nar.atl_lasttime) = 0,ColorError,0)}};
    SYS_NAR.SUMMANAR     'Сумма'                                      ('Сумма по наряду'): [11,2], NoAutosize, Protect;
    SYS_NAR.SUMMAPREM    'ТОН'                                     ('Премия на наряд'): [11,2], NoAutosize, Protect;
    TotalSum             'Всего'                                                ('Всего'): [11,2], NoAutosize, Protect;
    x$Users.XU$FULLNAME  'Создатель'                     ('Пользователь создавший наряд'):   [20], Protect;
    DepartmentStr        'Подразделение'                 ('Подразделение')               :   [18], Protect;
    //CheckedDate          'Проверен'               ('Дата проверки наряда')               :   [11], Protect, NoAutosize;
    Sys_Nar.CheckDate    'Проверен'               ('Дата проверки наряда')               :   [11], Protect, NoAutosize;
    AvError.VsTRING      'Ошибка'               ('Описание ошибки')               :   [11], Protect, NoAutosize;
end;



var pTmp         :comp;


Function SetFieldsByMnPlan(_pMnPlan:comp):boolean;
var ii:word;
{ Result:=false;

  #FUNC_ZP_Fill_To_SchKauParam(PRNARYAD,cSchetD,cSubSchD,cKaud,Tbld)
  if pGP_Func_ZP.SetFieldsByMnPlan(_pMnPlan,PSchKauParam)
  { #FUNC_ZP_Fill_From_SchKauParam(PRNARYAD,cSchetD,cSubSchD,cKaud,Tbld)
  }
  Result:=true;
  SetModified(true);
  UpdateTable;
}//Function SetFieldsByMnPlan(_pMnPlan:comp);

Function GetUserTuneParam(var myPlansNo: comp // #docl текущий план счетов
                         ): boolean;
var cPlansRab: comp; // рабочее поле
{
  result := false;
  cPlansRab := 0;
  myPlansNo := coGetTune('Konsolid.cPlansSch'); // План счетов из Консолидации

  if (myPlansNo = 0)
  {
    message('Установите текущий план счетов', Information);
    exit;
  }

  cPlansRab := coGetTune('Fin.User.cPlansSch');

  if (cPlansRab <> 0)
    myPlansNo := cPlansRab;

  if (GetFirst PlansSch where (( myPlansNo == PlansSch.NRec )) <> tsOk)
  {
    message('Утеряна настройка планов счетов.'#13 +
            'Проведите настройку.'#13 +
            'Установите текущий план счетов.', Information);
    exit;
  }

  result := true;
}
//*****************************************************************************
Function GetJobSheetDefaultNameNew(Number : longint) : string;
{
  if (Number < 10)
    result := 'Наряд №0' + string(Number);
  else
    result := 'Наряд №' + string(Number);
}
//*****************************************************************************
function ShouldDeleteJobs: boolean;
{

 var kol: word; kol := GetMarkerCount(JobMarkers);
  if (kol <> 0)
    result := Message('Удалить помеченные записи (' + String(kol) + ')?', Confirmation + YesNo) = cmYes
  else
    result := Message('Удалить текущую запись?', Confirmation + YesNo) = cmYes;
}
//*****************************************************************************
Function UpdateJob  : boolean;
{
  timelog('GP_Nariad->UpdateJob:start');
  result := false;

  if (IsProtectedRecord)
    Exit;

  _try
  {
    if not isValidAll(tnGP_PrNaryad_Ext) then
     {
      set PRNARYAD.MES   := AD_Month(PRNARYAD.DATAN);
      set PRNARYAD.CHASF := PRNARYAD.NRMTIME;
     }
      if update current PRNARYAD=tsok {}
  }
  _except
    on ExDatabase:
    {
      Message(ExploreException, Error);
    }
  RecalcPremia;

  timelog('GP_Nariad->UpdateJob:finish');
  result := true;
} // procedure UpdateJob
Function DeleteJobs : boolean;
{
  result := false;

  if (IsProtectedRecord)
    Exit;

  var I: integer;
  ReSetBounds(#PRNARYAD);
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak, 'Удаление записей', GetMarkerCount(JobMarkers));

  _try
  {
    I := 0;
    while I < GetMarkerCount(JobMarkers)
    {
      var RecNum: comp;
      GetMarker(JobMarkers, I, RecNum);
      if (getfirst PRNARYAD where ((RecNum == PRNARYAD.NREC)) <> tsOk)
      {
        AtDeleteMarker(JobMarkers, I);
        continue;
      }
      NextVisual;

      if (personalAccount <> 0)
      {
        ReSetBounds(#SYS_NAR);
        if getfirst SYS_NAR where ((PRNARYAD.MNREC == SYS_NAR.NREC)) <> tsOk {}
      }

      _try
      {
        delete current PRNARYAD;
        AtDeleteMarker(JobMarkers, I);
      }
      _finally
        if (personalAccount <> 0)
          SetBounds(#SYS_NAR);
    }
    RecalcPremia;
  }
  _except
    on ExDatabase:
    {
      Message(ExploreException, Error);
  }
  _finally
  {
    SetBounds(#PRNARYAD);
    StopVisual('', 0);
  }

  result := false;
}
Function InsertJob  : boolean;
{
  result := false;

  _try
  {
    if (insert current PRNARYAD = tsOk)
      {
        set prnaryad.ckaud[6]:=prnaryad.nrec;
        if (update current prnaryad = tsOk)
          {}
        RecalcPremia;
      }
  }
  _except
    on ExDatabase:
    {
      Message(ExploreException, Error);
    }

  result := true;
}
//*****************************************************************************
procedure DeleteCurrentJob;
{
  var Empty: boolean = (GetMarkerCount(JobMarkers) = 0);

  if Empty
    InsertMarker(JobMarkers, PRNARYAD.NREC);

  DeleteJobs;

  if Empty
    ClearMarker(JobMarkers);
}
//*****************************************************************************
Function MyCheckDate : boolean;
{
  if (NOT IsValidAll(#PRNARYAD))
    result := true;
  else
    if (prnaryad.vidopl=1 or prnaryad.vidopl=7)
      result := PRNARYAD.NRMTIME <> 0 AND NamKauD <> '';
    else
       result := NamKauD <> '' AND PRNARYAD.VIDOPL <> 0;
}
//*****************************************************************************

TableEvent
  Table PRNARYAD;
cmSetDefault:
  {
    if not (sys_nar.choice = 906 or  sys_nar.choice = 103)
      {
        stop;
        Abort;
        Exit;
      }

    ClearBuffer(#PRNARYAD);
    PRNARYAD.MNREC    := SYS_NAR.NREC;
    PRNARYAD.DATAN    := SYS_NAR.DATAN;
    PRNARYAD.DATOK    := SYS_NAR.DATOK;
    PRNARYAD.MES      := AD_month(SYS_NAR.DATAN);
    prnaryad.VIDPREM  := 1;
    prnaryad.CEX      := SYS_NAR.CEX;
    prnaryad.KTY      := 1;
    prnaryad.ckaud[6] := prnaryad.nrec;

    if CharacterClockNumbers
      SelectField(#PRNARYAD.STRTABN);
    else
      SelectField(#PRNARYAD.TABN);
  }

cmCheckRecord:
  { timelog('GP_Nariad->cmCheckRecord:Start');

    if (PRNARYAD.CLSCH = 0)
      {
        Message('Выберите лицевой счет работника', Warning + OkButton);
        abort;
        if CharacterclockNumbers
          Selectfield(#PRNARYAD.STRTABN);
        else
          SelectField(#PRNARYAD.TABN);
        exit;
      }
     timelog('GP_Nariad->cmCheckRecord:finish');
  }
/*
cmSetCurField:
  {
    case Target of
      #PRNARYAD.TABN,
      #PRNARYAD.STRTABN:
        if (PRNARYAD.CLSCH = 0)
          PutCommand(cmPick);
    end;
  }
*/
cmDeleterecord:
  {
    if (IsProtectedRecord)
    {
      Message('Запись защищена от редактирования', Warning + OkButton);
      stop;
      Exit;
    }

   if isValidAll(tnGP_PrNaryad_Ext) then {
      stop;
      Exit;
   }

    if ShouldDeleteJobs
      DeleteCurrentJob;

    RedRawPanel(#PrNaryad);
    ReReadRecord(#SYS_NAR);

    if (CurWindow = WinEdit)
      {
        nRecProtect := 0;

        if (NOT CheckPN)
          nRecProtect := SYS_NAR.NRec;
        else 
          if (NOT CheckPrNaryad)
            nRecProtect := SYS_NAR.NRec;
      }
  }

cmInsertRecord:
  {
   if isValidAll(tnGP_PrNaryad_Ext) then
   {
     stop; exit;
   }
    if (NOT InsertJob)
      Abort;

    ReReadRecord(#SYS_NAR);

    if (CurWindow = WinEdit)
      {
        nRecProtect := 0;

        if (NOT CheckPN)
          nRecProtect := SYS_NAR.NRec;
        else 
          if (NOT CheckPrNaryad)
            nRecProtect := SYS_NAR.NRec;
      }
  }

cmUpdateRecord:
  {
    timelog('GP_Nariad->cmUpdateRecord PRNARYAD:start');
    if (NOT UpdateJob)      {}

    timelog('GP_Nariad->cmUpdateRecord PRNARYAD:001');
    //ReReadRecord(#SYS_NAR);
    ReScanPanel(#SYS_NAR);
    timelog('GP_Nariad->cmUpdateRecord PRNARYAD:002');
    if (CurWindow = WinEdit)
      {
        nRecProtect := 0;

        if (NOT CheckPN)
          nRecProtect := SYS_NAR.NRec;
        else 
          if (NOT CheckPrNaryad)
            nRecProtect := SYS_NAR.NRec;
      }
    timelog('GP_Nariad->cmUpdateRecord PRNARYAD:finish');
  }

cmExprFieldChanged:
  {
    case CurField of
      #StandardTimeStr:
      {
        SetModified(true);
        var Value: double;
        _try
        {
          Value := Str2Time(ExprFieldValue);

          if (Value < 0)
          {
            Message('Введено недопустимое количество часов', Error + OkButton);
            //abort;
            exit;
          }

          set PRNARYAD.CHASF   := Value;
          set PRNARYAD.NRMTIME := Value;
        }
        _except
          on ExNumberConvert:
          {
            Message('Введена недопустимая величина', Error + OkButton);
            //abort;
          }
      }
    end; //case
  }

cmDelOnProtect:
  {
    if not( Sys_Nar.Choice = 901 or Sys_Nar.Choice = 906) then {exit};
    if (IsProtectedRecord)
      {
        Abort;
        Exit;
      }

    case CurField of
      #PaymentKindStr:        set PRNARYAD.VIDOPL := 0;
      #PremiumPaymentKindStr: set PRNARYAD.VIDPREM := 0;
      #Catalogs.Name:         set PRNARYAD.CPODR    := 0;     // обнулим должность
      #NamKAUD:
      {
        #DelonProtect_Deb (PrNaryad, #Schetdeb, #SubSchdeb, #NamKAUD);
      }
    end; //case
  }

cmPick:
  {
    if not( Sys_Nar.Choice = 901 or Sys_Nar.Choice = 906 or Sys_Nar.Choice = 103) then {exit};
    if (IsProtectedRecord)
      {
        Abort;
        Exit;
      }

    case CurField of
      #PRNARYAD.TABN,
      #PRNARYAD.STRTABN,
      #WorkerName:
      {
         SelectPersonalAccount(true);
      }
      #NamKaud:
      {
       if isValidAll(tnGP_PrNaryad_Ext)
        {
        if not (sys_nar.choice = 901   // ne proverku
             and (  wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE') = 3 // economist
               //  or wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE') = 2 // admin
                 )
               )
          then {
            stop; exit;
          }
        }
        if (QuickChoiceName <> '')
          QuickChoiceName := 'qcKau_Needed' ;

        pTmp:=0;
        if (iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp) <> 0)  //cmCancel
          if (SetFieldsByMnPlan(pTmp))
            {}
       RecalcPremia;
      }
      #PaymentKindStr:
      {
        RunInterface('Z_Zar::PICKOPL', PRNARYAD.VIDOPL);
        set PRNARYAD.VIDPREM := PRNARYAD.VIDOPL;
      }
      #PremiumPaymentKindStr: RunInterface('Z_Zar::PICKOPL', PRNARYAD.VIDPREM);

    end; //case
  }

cmCheckField:
  {

    timelog('GP_Nariad->cmCheckField:start');
    case CurField of
      #PRNARYAD.PROC,
      #PRNARYAD.SUMMAPR,
      #PRNARYAD.SUMMA:
        CalcJobPremium;
      #PRNARYAD.DATAN
    , #PRNARYAD.DATOK:
      {
         if (PRNARYAD.DATOK <> ZeroDate AND PRNARYAD.DATAN > PRNARYAD.DATOK)
           {
             Message('Дата окончания меньше чем дата начала.');
             Abort;
             Exit;
           }

      }
      #PRNARYAD.TBLEXTR[1] :
      {
        //приказ 920 от 29/12/2021 о введении в действие ненужного положения
        Update Current PRNARYAD;
      }
    end;
    timelog('GP_Nariad->cmCheckField:finish');
  }
end;
//*****************************************************************************
TableEvent 
  Table SYS_NAR;

cmSetDefault:
  {
    if (IsProtectedRecord)
      {
        Abort;
        Exit;
      }

    if currentPeriod = 2
      Exit;

    SYS_NAR.CHOICE  := jobSheetType;
    SYS_NAR.MNREC   := Longint(GetLastNumD(2003));
    SYS_NAR.NMNEM   := GetJobSheetDefaultNameNew(SYS_NAR.MNREC);
    sys_nar.DATAN   := date(1,Month(if(jobSheetType = 103, add_months(otchPeriod,1),otchPeriod)),Year(if(jobSheetType = 103, add_months(otchPeriod,1),otchPeriod)));
		sys_nar.DATOK   := date(Last_Day(if(jobSheetType = 103, add_months(otchPeriod,1),otchPeriod)),Month(if(jobSheetType = 103, add_months(otchPeriod,1),otchPeriod)),Year(if(jobSheetType = 103, add_months(otchPeriod,1),otchPeriod)));
    sys_nar.PRKAUOT := 3;

    if BoundActive(tbAvailableDepartmentsFilter)
    {
      GetMarker(departmentList, 0, SYS_NAR.CEX);
    }
    PickDepartment;

    if (sys_nar.cex = comp(0))
      {
        Abort;
        Exit;
      }

  }

cmCheckField:
  {

   case curtable of
    #Sys_Nar:
     {
       if Sys_Nar.choice = 3
        {
          message('Наряд нельзя редактировать',error);
          rescanpanel(tnprnaryad);
          stop; abort;exit;
        }
     }
   end;
    timelog('GP_Nariad->cmCheckField:start sys_nar');
    case CurField of
    //  #CheckedDate
    //, #CheckedDate2:
    #Sys_Nar.CheckDate:
        if ((NOT MyCheckDate)
          //AND (SYS_NAR.LASTTIME <> time(0,0,0,0)))
          and Sys_Nar.CheckDate<>ZeroDate)
          {
            //set SYS_NAR.LASTTIME := longint(0);
            set Sys_Nar.CheckDate:=ZeroDate;
            Message('Невозможно установить дату, так как не все значения заданы!');
          }
      #SYS_NAR.DATAN
    , #SYS_NAR.DATOK:
         if (SYS_NAR.DATOK <> ZeroDate AND SYS_NAR.DATAN > SYS_NAR.DATOK)
           {
             Message('Дата окончания меньше чем дата начала.');
             Abort;
             Exit;
           }
    end
    timelog('GP_Nariad->cmCheckField sys_nar:finish');
  }

cmCheckRecord:
  {

    timelog('GP_Nariad->cmCheckRecord sys_nar:start');
    if (NOT FoundMarker(departmentList, SYS_NAR.CEX))
      {
        SelectField(#DepartmentStr);

        if Message('При заданном фильтре по подразделениям, текущий наряд станет недоступен для просмотра.'#13 +
          'Изменить подразделение наряда?'#13#13 +
          '"Да" - выбрать другое подразделение.'#13 +
          '"Нет" - наряд будет скрыт так как не удовлетворяет условиям фильтра.', Warning + YesNo) <> cmNo
        {
          SelectField(#DepartmentStr);
          PickDepartment;
        }
      }

    timelog('GP_Nariad->cmCheckRecord sys_nar:finish');
  }

cmPick:
  {
     if not( Sys_Nar.Choice = 901 or Sys_Nar.Choice = 906 or Sys_Nar.Choice = 905) then {exit};
    case curfield of
      #ChoiceFld:
      {
/*
Варианты перевода статусов:
1. Если занесен вручную:
     906  - создается
     906 -> 3 Конец
2. Если из АММ пришел
     901 - создается
     901 -> 905
     901 -> 902  тут в АММ что то должны сделать с ним
     905 -> 902  тут в АММ что то должны сделать с ним
     905 -> 3   Конец

*/
//      setVisibleAllChoice;
      SetHiddenAllChoice;

       if not IsValidAll(tnGP_PrNaryad_Ext)
        {
          if Sys_Nar.Choice = 906 or Sys_Nar.Choice = 901{
              if (NOT MyCheckDate)
                {
                 Message('Не все параметры указаны', error);
                 exit;
                }

             if Sys_Nar.Choice = 906
              {
               if not CheckNormChasByZero(Sys_nar.nrec)
               {
                 Message('По 9, 10, 1 виду оплат не может быть нулевых часов',error);
                 exit;
               }

              }



              if (nariadHasBadOrderStatusData(SYS_NAR.NREC)) {
                   Message('Недопустимые статусы заказов!'
                    + ''#13''+ 'Обратитесь в ПЭУ', error);
                   exit;
              }

              if  wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE') = 1
               or wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE')  = 2 // роль BTZ admin
              {
                  ShowChoice(3);
              }
           }
           else{
              exit;
            }
        }
        else{
          case Sys_Nar.Choice of
              901:{
                /*
                    if (NOT MyCheckDate)
                     {
                       Message('Не все параметры указаны', error);
                       exit;
                     }
                */

                   ShowChoice(902);//, 'Отклонен'); отклонить могут все


                    //Проверка на статус и дату заказов
                    if (nariadHasBadOrderStatusData(SYS_NAR.NREC)) {
                       Message('Недопустимые статусы заказов!', error);
                    }
                    else {

                           if month(otchPeriod) = month(PRNARYAD.datan)
                           if( getfirst PRNARYAD where ((SYS_NAR.NREC == PRNARYAD.MNREC))
                                      and PrNaryad.CKAUD[1] = 0h
                             ) <> tsOK
                           if wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE') = 0 or wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE')  = 2 or wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE')  = 3// роль экономист admin
                           {
                            if( getfirst PRNARYAD where ((SYS_NAR.NREC == PRNARYAD.MNREC))
                                     and PRNARYAD.ChasF = 0
                                     and (PRNARYAD.VIDOPL <> 70 and PRNARYAD.VIDOPL <> 72 and PRNARYAD.VIDOPL <> 0) // тут могут быть 0 часы
                                     ) <> tsOk { // если есть с 0 нормой, то только в отклоненные
                                ShowChoice(905);//, 'Проверено Экономистом');
                              }
                           }
                    }
                  }
              905:{
                    if (NOT MyCheckDate)
                     {
                       Message('Не все параметры указаны', error);
                       exit;
                     }
                   if wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE') = 1 or wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE')  = 2 // роль BTZ admin
                   {
                    ShowChoice(902);//, 'Отклонен');
                    if month(otchPeriod) = month(PRNARYAD.datan) ShowChoice(3);//, 'utverzhden BTZ');
                   }
                  }
               else{
                  exit;
                }
            end;
        }
        if getfirst tChoiceBrowse <> tsOK {exit;}
        if RunWindowModal(wndChoice) = cmDefault
         {
          if tChoiceBrowse.Choice = 3 {
            if canSetChoice3(sys_nar.nrec) then SetCurSysNarChoice(tChoiceBrowse.Choice);
            }
            else {
               SetCurSysNarChoice(tChoiceBrowse.Choice);
              }
         }
        RecalcPremia;
      }
end;

    if (IsProtectedRecord)
      {
        Abort;
        Exit;
      }

    case CurField of
      #PrichNesootvFld:
      {
        var c: comp = _qualityCostsHelper.cPrichNesootv(coSys_Nar, Sys_Nar.Nrec);
        if _qualityCostsHelper.PickPrichNesootv(c)
        {
          _qualityCostsHelper.SetPrichNesootv(coSys_Nar, Sys_Nar.Nrec, c);
          set PrichNesootvFld;
          nRecProtect := if(IsPrichNesootvValid, 0, Sys_Nar.Nrec);
        }
      }
      #ShZKFld:
      {
        var c: comp = _qualityCostsHelper.cShZK(coSys_Nar, Sys_Nar.Nrec);
        if _qualityCostsHelper.PickShZK(c)
        {
          _qualityCostsHelper.SetShZK(coSys_Nar, Sys_Nar.Nrec, c);
          set ShZKFld;
          nRecProtect := if(IsPrichNesootvValid, 0, Sys_Nar.Nrec);
        }
      }
      #PrichKartRazrFld:
      {
        var c: comp = _qualityCostsHelper.cPrichKartRazr(coSys_Nar, Sys_Nar.Nrec);
        if _qualityCostsHelper.PickPrichKartRazr(c)
        {
          _qualityCostsHelper.SetPrichKartRazr(coSys_Nar, Sys_Nar.Nrec, c);
          set PrichKartRazrFld;
        }
      }
    end; //case
  }

cmDelOnProtect:
  {
    if (IsProtectedRecord)
      {
        Abort;
        Exit;
      }

    case CurField of
      #PrichNesootvFld:
      {
        _qualityCostsHelper.SetPrichNesootv(coSys_Nar, Sys_Nar.Nrec, 0);
        set PrichNesootvFld;
        nRecProtect := if(IsPrichNesootvValid, 0, Sys_Nar.Nrec);
      }
      #ShZKFld:
      {
        _qualityCostsHelper.SetShZK(coSys_Nar, Sys_Nar.Nrec, 0);
        set ShZKFld;
        nRecProtect := if(IsPrichNesootvValid, 0, Sys_Nar.Nrec);
      }
      #PrichKartRazrFld:
      {
        _qualityCostsHelper.SetPrichKartRazr(coSys_Nar, Sys_Nar.Nrec, 0);
        set PrichKartRazrFld;
      }
    end; //case
  }

cmInsertRecord:
  {
    if (IsProtectedRecord)
      {
        Abort;
        Exit;
      }

    insert current SYS_NAR;
    dSetAttr(16003,SYS_NAR.nrec,'Дата создания наряда',cur_date)
  }

cmUpdateRecord:
  {
    if (IsProtectedRecord)
      {
        Abort;
        Exit;
      }
     SYS_NAR.nmPodr := timetostr(cur_time,'HH:MM:SS');
    update current SYS_NAR;
    RecalcPremia;
  }

cmDeleteRecord:
  {

    var cnt: longint = GetMarkercount(jobSheetMarker);

    if cnt = 0
    {
      if Sys_Nar.Choice <> 906
       {
        Abort;
        Exit;
       }

      if (Message('Удалить наряд?', Confirmation + YesNo) = cmYes)
      {
        delete all PRNARYAD;
        delete current SYS_NAR;
      }
    }
    else
    {
      if Message('Удалить помеченные наряды (' + String(cnt)+ ')?', Confirmation + YesNo) <> cmYes
      {
        abort;
        exit;
      }
      var I: longint;
      I := 0;
      while I < GetMarkerCount(jobSheetMarker) do
      {
        var JobSheet: comp;
        GetMarker(jobSheetMarker, I, JobSheet);
        if getfirst SYS_NAR where ((JobSheet == SYS_NAR.NREC)) = tsOk
        {
          if Sys_Nar.Choice <> 906 then continue;
          delete all PRNARYAD;
          delete current SYS_NAR;
          DeleteMarker(jobSheetMarker, JobSheet);
        }
      }
    }
  }

cmPositionChanged:
  {
    if curtable = tnSYS_NAR
    {
      if (CurWindow = WinEdit and
           (
              sys_nar.choice = 901  //, 'На проверку');
           or sys_nar.choice = 906 // 'Оформляемый');
           )
         )
        {
          if (nRecProtect <> comp(0) AND nRecProtect <> SYS_NAR.NRec)
            {
              if (GetFirst SYS_NAR where ((nRecProtect == SYS_NAR.NRec)) = tsOk)
                {}
              Message('Не все обязательные поля были заполнены! __');
            }

          if (NOT CheckPrNaryad)
            nRecProtect := SYS_NAR.NRec;
          else
            nRecProtect := 0;
        }
      IsProtectedRecord;
      rescanpanel(tnPrNaryad);
    }
  }
end;

end;

HandleEvent
cmPositionChanged:
{
  if curtable = tnSYS_NAR
  {
   if (IsProtectedRecord) {}
    if IsValidAll(tnGP_PrNaryad_Ext)
     then
      {
        disablecommand(cmValue2);
        SetFormat(brwEditAMM)
      }
     else
      {
        enablecommand(cmValue2);
        SetFormat(brwEdit);
      }
    rescanpanel(tnSys_nar);
  }
}
cmInit:
  { ClearFuncCache;
    timelog_init;
    timelog('GP_Nariad->cmInit');
    otchPeriod := dGetTune('UP.DATOTCH');
//    set jobSheetType := jsIndividualVsMPF;
    set jobSheetType := 906;
    set isProt := false;
    var CL: ContextList;
    _Shablon_TrudPotr     :=coGetTune('NPOEM_OWN.ZP.NARYAD.EXPORT.Shablon');
    //Формируем список статусов нарядов

    AddChoice(3  , 'Проверен БТЗ');
    AddChoice(901, 'На проверку');
    AddChoice(902, 'Отклонен');
//    AddChoice(903, 'Будущий период');
    AddChoice(904, 'Ошибка');
    AddChoice(905, 'Проверено Экономистом');
    AddChoice(906, 'Оформляемый');
    AddChoice(907, 'Аннулирован');
/*
Варианты перевода статусов:
1. Если занесен вручную:
     909  - создается
     906 -> 3 Конец
2. Если из АММ пришел
     901 - создается
     901 -> 905
     901 -> 902  тут в АММ что то должны сделать с ним
     905 -> 902  тут в АММ что то должны сделать с ним
     905 -> 3   Конец

*/




    if (not CL.Add(CS, 'IntInit'))
    {
    }
    if (not PrVidInit(25, 1))
    {
      //ExitProc;
      abort;
      exit;
    }

    if (not GetUserTuneParam(myPlansNo))
      exit;

    ProtectedCheckedNaryad := boGetTune('UP.ZAR.JS.PROTECTCHECKEDNARYAD'); // защищены наряды или нет от переформирования
    CharacterClockNumbers  := wGetTune('FormatClockNumber') = 1;
    dimeRounding           := lGetTune('UP.ZAR.RoundNa');  //округление до копеек

    if CharacterClockNumbers
      ClearFieldState(#PRNARYAD.TABN, sfVisible);
    else
      ClearFieldState(#PRNARYAD.STRTABN, sfVisible);

    JobMarkers     := InitMarker('', 8, 100, 100);
    jobSheetMarker := InitMarker('', 8, 50, 50);

    SetupPeriod(integer(coGetTune('UP.TEKBUD')));
    SetupDepartmentFilter;
  }

cmCancel:
  {
    if (NOT IsProtectedRecord)
      UpdateTable;
  }

cmDone:
  {
    DoneMarker(departmentList, '');
    DoneMarker(jobSheetMarker, '');
    DoneMarker(JobMarkers    , '');
    FreeVipInterface(PAF);
    CS       := NullRef;
    DoneVx(25);
    //ExitProc;

  }

cmExprFieldChanged:
  { /*
    case CurField of
      #CheckedDate,
      #CheckedDate2:
      {
        var dd : longint; dd := longint(StrToDate(ExprFieldValue, 'DD/MM/YYYY'));
        SetModified(true);
        set SYS_NAR.LASTTIME := dd;
      }
    end; //case
    */
  }

cmDefault:
  {
    if ((currentPeriod= 2) and (getfirst PRNARYAD where ((SYS_NAR.NREC == PRNARYAD.MNREC)) <> tsOk))
    {
      Message('Архивный наряд без спецификаций, поэтому редактирование запрещено', Information);
      Abort;
      Exit;
    }

    if (NOT IsProtectedRecord)
      UpdateTable;

    if IsValidAll(#SYS_NAR)
    {
      if (GetFirst PRNARYAD <> tsOk)
        {
          SelectPersonalAccount(true);
        }

      RunWindowModal(WinEdit);


      if (NOT IsProtectedRecord)
        UpdateTable;

      RereadRecord(#SYS_NAR);
      abort;
    }
  }

cmAddNewRec:
  {
    PutCommand(cmInsert);
  }

cmEdit:
  {
    PutCommand(cmDefault);
  }
/*
cmQuit:
  {
    if (NOT IsProtectedRecord)
      UpdateTable;

    if IsModalWindow
    {
      CloseInterface(cmCancel);
      PutCommand(cmQuit);
    }
  }

cmMenu:
  {
    if (NOT IsProtectedRecord)
      UpdateTable;

    if IsModalWindow
    {
      CloseInterface(cmCancel);
      PutCommand(cmMenu);
    }
  }
*/

cmNal:
  {
    SetupPeriod(1);

    if (NOT IsProtectedRecord)
      UpdateTitle;

    RereadRecord(#SYS_NAR);
  }

cmPickClass:
  {
    SetupPeriod(0);

    if (NOT IsProtectedRecord)
      UpdateTitle;

    RereadRecord(#SYS_NAR);
  }

cmPickAttr:
  {
    SetupPeriod(2);

    if (NOT IsProtectedRecord)
      UpdateTitle;

    RereadRecord(#SYS_NAR);
  }

cmHotKeys:
  {
    var ComponentName: string; ComponentName := '#__COMPONENT__::';
    PutHotCommand(RunDynMenu(ComponentName + 'GPSys_NarPopup;SEPARATOR;' + ComponentName + 'GPJobSheetListPeriodPopup'));
  }

cmMarkUnmark:
  {
    if (NOT IsProtectedRecord)
      UpdateTable;

    InvertMarker(jobSheetMarker, SYS_NAR.NREC);
    ReDrawPanel(#SYS_NAR);
    RedrawCurrentAndGo (GetCurrentFormat,true);
  }

cmSelectAll:
  {
    if (NOT IsProtectedRecord)
      UpdateTable;

    PushPos(#SYS_NAR);

    _loop SYS_NAR
      InsertMarker(jobSheetMarker, SYS_NAR.NREC);

    PopPos(#SYS_NAR);
    RereadRecord(#SYS_NAR);
  }

cmUnSelectAll:
  {
    ClearMarker(jobSheetMarker);
    RereadRecord(#SYS_NAR);
  }

cmFilterSave:
  {
    if (NOT IsProtectedRecord)
      UpdateTable;

    var Dummy: double;
    if RunInterface(GetPodaln, 11, department, Dummy) = cmDefault
    {
      SetupDepartmentFilter;
    }
  }

cmProtectedInput:
  {
    Message('Поле защищено от редактирования. Возможно, заполнено поле'+
            ' "Проверен" и настройка "Защитить наряды от редактирования" находится в значении "Да"', Warning + OkButton);
    Stop;
  }

cmValue4:
{
        var cnt: longint = GetMarkercount(jobSheetMarker);
       if cnt = 0
          {
            message('Не выбран ни один наряд',error);
            exit
          }
        else
          {
            if Message('Установить статус "проверен БТЗ" для помеченных нарядов?', Confirmation + YesNo) <> cmYes
              {
                abort;
                exit;
              }
            var I: longint; I := 0;
            while I < GetMarkerCount(jobSheetMarker) do
            {
               var JobSheet: comp;
               GetMarker(jobSheetMarker, I, JobSheet);
               if canSetChoice3(JobSheet) then SetCurSysNarChoice(3);

              DeleteMarker(jobSheetMarker, JobSheet);
            }
          }
        ReReadRecord(#SYS_NAR);
}
cmValue1:
  {
    var dd : date; dd := otchPeriod;
    if (RunDialog(GPGetDate, dd) <> cmCancel)
      {
        var cnt: longint = GetMarkercount(jobSheetMarker);

        if cnt = 0
          {
            if (IsValidAll(#SYS_NAR) AND MyCheckDate) and SYS_NAR.choice = 3
              {
                set SYS_NAR.CHECKDATE := longint(dd);
                if (update current SYS_NAR = tsOk) {}
              }
          }
        else
          {
            if Message('Установить дату проверки для помеченных нарядов?', Confirmation + YesNo) <> cmYes
              {
                abort;
                exit;
              }
            var I: longint; I := 0;
            var bBlock : boolean; bBlock := false;
            while I < GetMarkerCount(jobSheetMarker) do
            {
               var JobSheet: comp;
               GetMarker(jobSheetMarker, I, JobSheet);
               if (getfirst SYS_NAR where ((JobSheet == SYS_NAR.NREC)))= tsOk
                {
                 if (NOT MyCheckDate) or SYS_NAR.choice <> 3
                   {
                     bBlock := true;
                     DeleteMarker(jobSheetMarker, JobSheet);
                     continue;
                   }
                 else
                  {
                    set SYS_NAR.CHECKDATE := longint(dd);
                    if (update current SYS_NAR != tsOk)
                      {  }
                  }
                }
              DeleteMarker(jobSheetMarker, JobSheet);
            }

            if (bBlock)
              Message('По некоторым нарядам не проставлена дата проверки, т.к. не все поля заданны!');
          }

        ReReadRecord(#SYS_NAR);
      }
  }
cmValue5:
{
 SetVisibleAllChoice;
 if RunWindowModal(wndChoice) = cmDefault
  {
   set _curChoice =  tChoiceBrowse.Choice ;
    if BoundActive(tbByChoice) then SubBounds(tbByChoice);
    SetupDepartmentFilter;
    AddBounds(tbByChoice);
    if (getfirst sys_nar <> tsOk) {}
  }
}
cmValue6 :
 {
    if BoundActive(tbByChoice) then SubBounds(tbByChoice);
    SetupDepartmentFilter;
 }
cmValue2:
  RunInterface('Attribute', coSYS_NAR, SYS_NAR.nRec, false);
end;   //handleevent
end.


