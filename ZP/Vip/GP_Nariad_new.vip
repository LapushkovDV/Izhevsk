{
 result := FoundMarker(departmentList, SYS_NAR.CEX);
}
procedure AddChoice(wChoice: word; sName: string);{
  insert tChoice set tChoice.Choice := wChoice, tChoice.Name := sName, tChoice.isVisible := true;
}
procedure SetVisibleAllChoice;{
  Update tChoice set tChoice.isVisible := true;
}
Procedure HideChoice(wChoice: word);{
  Update tChoice where tChoice.Choice = wChoice set tChoice.isVisible := false;
}

Procedure SetHiddenAllChoice;{
  Update tChoice set tChoice.isVisible := false;
}
Procedure ShowChoice(wChoice: word);{
  Update tChoice where tChoice.Choice = wChoice set tChoice.isVisible := true;
}

procedure SetCurSysNarChoice(wChoice: word);
{
  if wChoice != Sys_Nar.Choice
  { update current Sys_Nar set Sys_Nar.Choice := wChoice;
    //------- #3895 ----------------
    if Sys_Nar.Choice=3
    {
      update current Sys_Nar set Sys_Nar.CheckDate := cur_date;
      if _Shablon_TrudPotr>0
      { pGP_Naryad2PotrTrud.ExportNaryad(Sys_Nar.Nrec,1,false);
      } //if Sys_Nar.Choice=3
    }
  }
  RescanPanel(tnSys_Nar);
} //procedure SetCurSysNarChoice(wChoice: word);

window wndChoice 'Cтатус' escclose, doaccept, cyan;
  show(,,40,5);
  browse brChoice;
    table tChoiceBrowse;
    fields
      tChoiceBrowse.Name 'Наименование': [10], Protect;
  end;
handleevent
cminit:
{
  If getfirst tChoiceBrowse = tsOK {}
  rescanpanel(tntChoiceBrowse);
}
end;
end; //window wndChoice


procedure RecalcPremia;
var dSum, dPr : double;
{
  timelog('GP_Nariad->RecalcPremia:start');
  dSum  := 0;
  dPr   := 0;
  _try
  {
  sql
   select
      sum(PrNaryad.Summa)
     ,sum(PrNaryad.SUMMPREM)
   from PrNaryad where PrNaryad.mNRec = :(SYS_NAR.NREC)
    into (dSum,dPr)
   ;
  }
  _except else {}

  SYS_NAR.SUMMANAR  := dSum;
  SYS_NAR.SUMMAPREM := dPr;
  SYS_NAR.NMNEM     := SYS_NAR.NMNEM;
  SYS_NAR.nmPodr := timetostr(cur_time,'HH:MM:SS');
  update current SYS_NAR;

  rescanPanel(tnSYS_NAR);
  rereadRecord;

  timelog('GP_Nariad->RecalcPremia:finish');
}

procedure PickDepartment;
{
  var Dummy: double;
  var tempCex: comp = SYS_NAR.CEX;

  if RunInterface('GetPodaln', 5, tempCex, Dummy) = cmDefault
    set SYS_NAR.CEX := tempCex;
}

procedure CalcJobPremium;
{
  if (100 - PRNARYAD.SUMMAPR)<>0
// что здесь не то - не понимаю 100 * (100 - PRNARYAD.SUMMAPR) / 100
   set PRNARYAD.SUMMPREM := OcrugNaRuk(PRNARYAD.SUMMA * PRNARYAD.PROC / 100 * (100 - PRNARYAD.SUMMAPR) / 100, dimeRounding);
  //циклит cmUpdateRecord
// + падает с разными ошибками
//  set PRNARYAD.SUMMPREM := Round(PRNARYAD.SUMMA * PRNARYAD.PROC /  (100 - PRNARYAD.SUMMAPR),2);
}


procedure UpdateTitle;
{
  var TitleStr: string;
  var PeriodStr: string;
  PeriodStr := 'неизвестный';

  TitleStr := 'Перечень индивидуальных нарядов с КТУ';

  case currentPeriod of
    0:  PeriodStr := 'текущий';
    1:  PeriodStr := 'будущий';
    2:  PeriodStr := 'архивный';
  end; //case

  var DepartmentFilterStr: string;
  DepartmentFilterStr := ', ' + CLSF.GetDepartmentFilterStr;

  SetTitle(TitleStr + ' (' + PeriodStr + ' период' + DepartmentfilterStr + ')');
}

procedure SetupPeriod(Period: integer);
{
  currentPeriod := Period;

  case currentPeriod of
    0:
    {
     delete all tChoice;
     set jobSheetType := 906; //jsIndividualVsMPF ;
     AddChoice(3  , 'Проверен БТЗ');
     AddChoice(901, 'На проверку');
     AddChoice(902, 'Отклонен');
//    AddChoice(903, 'Будущий период');
     AddChoice(904, 'Ошибка');
     AddChoice(905, 'Проверено Экономистом');
     AddChoice(906, 'Оформляемый');
//     AddChoice(907, 'Аннулирован');

      DisableCommand(cmPickClass);
      EnableCommand(cmNal);
      EnableCommand(cmPickAttr);
    }
    1:
    {
      set jobSheetType := jsFuturePeriodIndividualVsMPF;
       delete all tChoice;
       AddChoice(jsFuturePeriodIndividualVsMPF,'Будущий период _');
       AddChoice(903, 'Будущий период');

      EnableCommand(cmPickClass);
      DisableCommand(cmNal);
      EnableCommand(cmPickAttr);
    }
    2:
    {
    delete all tChoice;
      set jobSheetType := jsArchivePeriodIndividualVsMPF;
       AddChoice(jsArchivePeriodIndividualVsMPF,'Архивный');

      EnableCommand(cmPickClass);
      EnableCommand(cmNal);
      DisableCommand(cmPickAttr);
    }
  end; //case

  ReReadRecord(#SYS_NAR);
}

function GetDepartmentGroupMembershipValidator: IDepartmentValidator;
{
  Result := NullRef;
}

// настроить фильтр по подразделению
procedure SetupDepartmentFilter;
{
  if (BoundActive(tbAvailableDepartmentsFilter))
    PopBounds(tbAvailableDepartmentsFilter);
  // если список инициализирован
  if departmentList <> 0
    DoneMarker(departmentList, '');

  departmentList := CLSF.LoadCurrentDepartmentList;

  if not IDepartmentFilterStateDetector(CLSF).IsDepartmentFilterSet //фильтр по подразделениям не установлен
    InsertMarker(departmentList, 0); //сделать доступными наряды с нулевой ссылкой на подразделение

  IPAFilterExtOption2(PAF).InitPAFilterMode(GetDepartmentGroupMembershipValidator, otchPeriod, otchPeriod, pafoCommon);
  PushBounds(tbAvailableDepartmentsFilter); //установить фильтр по всем помеченным подразделениям

  UpdateTitle;
  RereadRecord(#SYS_NAR);
  if (getfirst sys_nar <> tsOk) {}
  if (IsProtectedRecord) {}
}

procedure SelectPersonalAccount(MultipleSelection: boolean);
{
  delete all Formarks;

  var  ModeUv: TModeUv;
  ModeUv.Mode  := 0;
  ModeUv.DatUv := otchPeriod;

  PAF.prModeUV := ModeUv;
  IPAFilterExtOption2(PAF).PickPersonalAccount(pafoCommon, otchPeriod,otchPeriod);

  //PAF.ChangePersonalAccountFilter(0);

  //if (RunInterface('Z_LSchet::getpmeu1Rep', comp(0), SYS_NAR.CEX, 1) <> cmDefault)
  //  exit;
  var cnt : word; cnt := 0;
  _LOOP Formarks
    {
      inc(cnt);
      if (cnt > 1)
         break;
    }

  if (cnt = 0)
    exit;

  if (cnt = 1 and IsValidAll(#prnaryad))
    {
      if (GetFirst Formarks = tsOk)
        if (GetFirst LSCHET2 where ((ForMarks.cLschet == LSchet2.nRec)) =tsOk)
          if (LSCHET2.DATPOS < SYS_NAR.DATOK AND (LSCHET2.DATUV > SYS_NAR.DATAN OR LSCHET2.DATUV = ZeroDate))
          {
            set prnaryad.CEXOZ    := lschet2.cex;
            set prnaryad.CPODR    := lschet2.cappoint;//????
            set prnaryad.SISOPL   := lschet2.sisopl;
            set prnaryad.TARIF    := lschet2.tarif;
            set prnaryad.CLSCH    := lschet2.nrec;
            set prnaryad.TPERSON  := lschet2.tperson;
            set prnaryad.STRTABN  := lschet2.strtabn;
            set PRNARYAD.CHASF    := PRNARYAD.NRMTIME;
            update current prnaryad;

          }
      exit;
    }

  _LOOP Formarks
    if (GetFirst LSCHET2 where ((ForMarks.cLschet == LSchet2.nRec)) =tsOk)
      if (LSCHET2.DATPOS < SYS_NAR.DATOK AND (LSCHET2.DATUV > SYS_NAR.DATAN OR LSCHET2.DATUV = ZeroDate))
    {
      ClearBuffer(#PRNARYAD);
      prnaryad.nrec     := GetNextNRec(tnPRNARYAD, 0);
      PRNARYAD.MNREC    := SYS_NAR.NREC;
      PRNARYAD.DATAN    := SYS_NAR.DATAN;
      PRNARYAD.DATOK    := SYS_NAR.DATOK;
      PRNARYAD.MES      := AD_month(SYS_NAR.DATAN);
      PRNARYAD.CLSCH    := ForMarks.cLschet;
      prnaryad.CEXOZ    := lschet2.cex;
      prnaryad.CPODR    := lschet2.cappoint;//????
      prnaryad.SISOPL   := lschet2.sisopl;
      prnaryad.TARIF    := lschet2.tarif;
      prnaryad.CLSCH    := lschet2.nrec;
      prnaryad.TPERSON  := lschet2.tperson;
      prnaryad.STRTABN  := lschet2.strtabn;
      prnaryad.ckaud[6] := prnaryad.nrec;
      CalcJobPremium;
      if (insert current PRNARYAD = tsOk)
        {}
    }

  RecalcPremia;
  ReReadRecord(#SYS_NAR);
  ReReadRecord(#PRNARYAD);
}

//#2642 Проверка на валидность поля Причина несоответствия.
//Возвращает False, если поле Причина несоответствия является обязательным и не заполнено
function IsPrichNesootvValid: boolean;
{
  result := true;
  if _qualityCostsHelper.cPrichNesootv(coSys_Nar, Sys_Nar.Nrec) = 0
    if _qualityCostsHelper.IsRequiredPrichNesootv(_qualityCostsHelper.cShZK(coSys_Nar, Sys_Nar.Nrec))
      result := false;
}
Function nariadHasBadOrderStatusData(nrec: comp) : boolean;
{
    var counter : integer = 0;

    _try {
           sql
           select
             count(*)
           from
             SYS_NAR sn
             left join PRNARYAD n on sn.NREC = n.MNREC
             left join MNPLAN p on n.CKAUD[1] = p.NREC
             left join KATNOTES s on p.CSTATUS = s.NREC
           where sn.NREC = :(nrec) and s.VIDDOC = 1202 and (s.STATUS = 2 or s.STATUS = 5 or s.STATUS = 6) //and p.ENDDATE <> 0
           and (cast(date2str('%YYYY',p.ENDDATE) as integer) < cast(date2str('%YYYY',n.DATOK) as integer)
           or (cast(date2str('%MM',p.ENDDATE) as integer) < n.MES and cast(date2str('%YYYY',p.ENDDATE) as integer) = cast(date2str('%YYYY',n.DATOK) as integer)))
           into (counter);
         }
    _except else {}

  if(counter > 0 )
  {
    result := true;
  }
  else {
    result := false;
  }
}

Function CheckNormChasByZero(_nrec: comp) : boolean;
{
    var counter : integer = 0;

    _try {
           sql
              select
              top 1
               count(*)
              from
              SYS_NAR sn
              join PRNARYAD n on sn.NREC = n.MNREC
              join KLVIDOPL on KLVIDOPL.VIDOPL = n.VIDOPL
              where sn.NREC = :(nrec)
              and KLVIDOPL.VIDOPLP in (1,9,10)
              and n.NRMTIME = 0
           into (counter);
         }
    _except else {}

  if(counter > 0 )
  {
    result := false;
  }
  else {
    result := true;
  }


}

function canSetChoice3(_Sys_nar : comp) : boolean;
{
var  _result : boolean = false;
     if (getfirst SYS_NAR where ((_Sys_nar == SYS_NAR.NREC)) and (Sys_Nar.Choice = 906 or Sys_Nar.Choice = 905 ))= tsOk
       if not nariadHasBadOrderStatusData(SYS_NAR.NREC)
       if CheckNormChasByZero(Sys_nar.nrec)
               {
//               if not IsValidAll(tnGP_PrNaryad_Ext) сказали по ANN нарядам тоже делать
                if( getfirst PRNARYAD where ((SYS_NAR.NREC == PRNARYAD.MNREC))
                                    and  month(otchPeriod) <> month(PRNARYAD.datan)
                  ) <> tsOK
                  {
                    if( getfirst PRNARYAD where ((SYS_NAR.NREC == PRNARYAD.MNREC))
                                         and PrNaryad.CKAUD[1] = 0h
                      ) <> tsOK
                      {
                       if  wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE') = 1
                        or wgettune('NPOEM_OWN.ZP.NARYAD.USERROLE')  = 2 // роль экономист admin
                        //
                       {
                         _result := true;
                         if not bogettune('NPOEM_OWN.ZP.NARYAD.ALLOWCHECKBTZ')
                         {
                           Message('В настройке стоит запрет перевода нарядов в статус "Проверен БТЗ"' +
                               + ''#13'' + 'Возможно идет расчет ЗП или аванса',error);
                           result :=  false;
                         }
                        if isvalidall(tnAV_dateCreate)
                        if AV_dateCreate.vDate <> 0
                         {
                           var _DaysDif : word =  CalcDaysBetweenDates(AV_dateCreate.vDate,cur_date,true);
                           if _DaysDif > 0
                           {
                             If Getfirst Katpodr1 Where ((SYS_NAR.CEX == Katpodr1.NREC)) = tsOK
                             If (getfirst spKau_srokSogl where ((10698 == spKau_srokSogl.KodGrKau))
                                  and spKau_srokSogl.name = SubStr(Katpodr1.Kod,1,3)) = tsOK
                             {
                               var _WordTmp : word = word(spKau_srokSogl.Code);
                              if _WordTmp < _DaysDif and  _WordTmp <> 0
                               {
                                 Message('По наряду просрочен срок возможного согласования в ' + _WordTmp +' дней.',error)  ;
                                 _result := false;
                               }
                             }
                           }
                         }

                       }
                      }
                  }
               }
 result := _result;
}

