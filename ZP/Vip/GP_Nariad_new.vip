Create view
var
  _curChoice : word;
    _SysNarNrec: comp;
  jobSheetType           : word;
  currentPeriod          : integer;
  jobSheetMarker         : TPtr;
  departmentList         : TPtr;
  JobMarkers             : TPtr;
  department             : comp;
  editMode               : boolean;
//  dNormHour              : double;
  personalAccount        : comp;
  CharacterClockNumbers  : boolean;
  ProtectedCheckedNaryad : boolean;
  PAFExtOption           : longint;
  cexozDate1             : date;
  cexozDate2             : date;
  cAttr1                 : comp;
  cAttr2                 : comp;
  dimeRounding           : longint;  //округление до копеек
  isProt                 : boolean;
  otchPeriod             : date;
  nRecProtect            : comp;
  _Shablon_TrudPotr     :comp; //NPOEM_OWN.ZP.NARYAD.EXPORT.Shablon
 //______________________________________________________________
    myCurRepNo : comp;            // консолидация баз данных
    myFilialNo : longint;         // работа с данными филиала
    myPlansNo  : comp;            // текущий план счетов
 //______________________________________________________________
    shpzar:tSchet3;

  (
    SchetDeb, SubSchDeb, NamKauD
  )
as select
  #CalcField_Deb (PRNARYAD)
, if(isValidAll(tnGP_PrNaryad_Ext)  , if(isValidAll(tnAV_Source),AV_Source.vString,'AMM'), if(isValidAll(tnAV_Source),AV_Source.vString,'ERP')) (FieldName = NaryadSource)
, if(isValidAll(tnAV_dateCreate), datetostr(AV_dateCreate.vdate,'DD/MM/YYYY'),'') (FieldName = NaryadDateCreate)
, Doubletostr(PrNaryad.ChasF,'666`666,8888') //Time2StrDef(PrNaryad.ChasF)
    (fieldname=ChasFFld)
,  Doubletostr(PrNaryad.NrmTime,'666`666,8888') //Time2StrDef(PrNaryad.NrmTime)
    (fieldname=NrmTimeFld)
,  Doubletostr(GP_PrNaryad_Ext.NrmTimePZ,'666`666,8888')//Time2StrDef(GP_PrNaryad_Ext.NrmTimePZ)
    (fieldname=NrmTimePZFld)
, if (jobSheetMarker <> 0, FoundMarker(jobSheetMarker, SYS_NAR.NREC), false)
    (fieldname = JobSheetMarked)
, if (JobSheetMarked, 'V', '')
    (fieldname = JobSheetMarkedStr)
/*
, StrToDate(DateToStr(longint(SYS_NAR.LASTTIME), 'DD/MM/YYYY'), 'DD/MM/YYYY')
    (fieldname = CheckedDate)
, StrToDate(DateToStr(longint(SYS_NAR.LASTTIME), 'DD/MM/YYYY'), 'DD/MM/YYYY')
    (fieldname = CheckedDate2)
*/
, if (IsValidAll(tnKatPodr), Trim(LTrim(KatPodr.Kod + ', ' + KatPodr.Name, ',')), '')
    (fieldname = DepartmentStr)
, (SYS_NAR.SUMMANRS * SYS_NAR.RASSAL / 100 - SYS_NAR.SUMMANTM)
    (fieldname = Fot)
, if(IsValidAll(tnPRNARYAD), (if(SYS_NAR.CALCULATED = coJSNo, ' ', '+') + if(SYS_NAR.DISTRIBUTED = coJSNo, ' ', '+')), '')
    (fieldname = StateFlag)
, if (FoundMarker(JobMarkers, PRNARYAD.NREC), 'V', '')
    (fieldname = JobMark)
, GetSurnameWithInitials(PERSONS.FIO)
    (fieldname = WorkerName)
, Doubletostr(PRNARYAD.NRMTIME,'666`666,8888') //Time2StrDef(PRNARYAD.NRMTIME)
    (fieldname = StandardTimeStr)
, String(KLVIDOPL.VIDOPLP)   + ', ' + KLVIDOPL.NVIDOPL
    (fieldname = PaymentKindStr)
, String(KLVIDOPLPR.VIDOPLP) + ', ' + KLVIDOPLPR.NVIDOPL
    (fieldname = PremiumPaymentKindStr)
, SYS_NAR.SUMMANAR + SYS_NAR.SUMMAPREM
    (fieldname = TotalSum)

, SYS_NAR.NREC //*
,  if(IsValidAll(tntChoiceSys_Nar), tChoiceSys_Nar.Name, '')
    (fieldname = ChoiceFld)
,  _qualityCostsHelper.sShZK(coSys_Nar, Sys_Nar.Nrec)
    (fieldname=ShZK)
,  _qualityCostsHelper.sPrichNesootv(coSys_Nar, Sys_Nar.Nrec)
    (fieldname=PrichNesootv)
, datetostr(date(01,PRNARYAD.mes,2019),'MONTH') (fieldname = MonthUshStr)

//, OrdStatus.NAME (fieldname = OrdStatus)
from
  SYS_NAR
, KATPODR
, Katpodr Katpodr1
, KATPODR KATPODRN
, Katpodr KatpodrPrNar
, PRNARYAD
//, PRNARYAD PRNARYAD1
, x$Users
, PERSONS  (ReadOnly)
, KLVIDOPL (ReadOnly)
, KLVIDOPL KLVIDOPLPR 
, CATALOGS
, LSCHET
, LSCHET LSCHET2
, PLANSSCH (ReadOnly)
, tChoice
, tChoice tChoiceSys_Nar
, tChoice tChoiceAllowed
, tChoice tChoiceBrowse
, GP_PrNaryad_Ext
, mnPlan mnPlanAmm
, AttrVal AvError
//Sindetskiy_aa Добавил статус заказа
, mnPlan mnPlanAll
, KATNOTES OrdStatus
, AttrNam AN_Source
, Attrval AV_Source
, AttrNam AN_dateCreate
, Attrval AV_dateCreate
, SpKAu spKau_srokSogl
where
((
    SYS_NAR.NREC          == PRNARYAD.MNREC
AND SYS_NAR.CEX           == KATPODR.NREC
and 16003                 == AvError.wTable
and SYS_NAR.NREC          == AvError.cRec
and 000A0000000002B0h     == AvError.cAttrnam // Описание ошибки
AND PRNARYAD.ATL_LASTUSER == x$Users.ATL_NREC
AND PRNARYAD.TPERSON      == PERSONS.NREC
AND PRNARYAD.VIDOPL       == KLVIDOPL.VIDOPL
AND PRNARYAD.VIDPREM      == KLVIDOPLPR.VIDOPL
AND PRNARYAD.CPODR        == CATALOGS.NREC
AND PRNARYAD.cexoz        == KatpodrPrNar.NREC
AND PRNARYAD.CLSCH        == LSCHET.NREC
AND _cLSchet              == Formarks.Choice
AND myPlansNo             == PLANSSCH.NREC
AND prnaryad.CEXOZ        == KATPODRN.NRec
//
and Sys_Nar.Choice        == tChoiceSys_Nar.Choice
and PrNaryad.Nrec         == GP_PrNaryad_Ext.cPrNaryad
and GP_PrNaryad_Ext.CZAKAZAMM == mnPlanAmm.Nrec
and                      true == tChoiceBrowse.isVisible

and PRNARYAD.CKAUD[1]     == mnPlanAll.NREC
and mnPlanAll.CSTATUS     == OrdStatus.NREC
and 16003                 == AN_Source.wTable
and '.СистемаИсточник'    == AN_Source.name
and AN_Source.wTable      == AV_Source.WTable
and SYS_NAR.NREC          == AV_Source.cRec
and AN_Source.Nrec        == AV_Source.cAttrnam

and 16003                  == AN_dateCreate.wTable
and 'Дата создания наряда' == AN_dateCreate.name
and AN_dateCreate.wTable   == AV_dateCreate.WTable
and SYS_NAR.NREC           == AV_dateCreate.cRec
and AN_dateCreate.Nrec     == AV_dateCreate.cAttrnam


))
bounds ByChoice = _curChoice == SYS_NAR.choice (NoIndex)
bounds AvailableDepartmentsFilter =
      // jobSheetType == SYS_NAR.CHOICE
                Root == Sys_Nar.Nrec
          and (ispodrOK(SYS_NAR.CEX))
          and Sys_Nar.Choice /== tChoiceAllowed.Choice

    //and (FoundMarker(departmentList, SYS_NAR.CEX))
//  ordered by SYS_NAR.NMNEM
bounds BySysNarNrec = _SysNarNrec == Sys_Nar.Nrec
  ordered by TableOrder
;
DataStream dsNariad
(
  table Sys_Nar
  (
    [NMnem]        Sys_Nar.NMnem;
    [DataN]        Sys_Nar.DataN;
    [DatOk]        Sys_Nar.DatOk;
    [CheckDate]    Sys_Nar.CheckDate;
    [Cex]          DepartmentStr;
    [SummaNar]     Sys_Nar.SummaNar;
    [SummaPrem]    Sys_Nar.SummaPrem;
    [TotalSum]     TotalSum;
    [TotalChasF]   TotalChasF(Sys_nar.nrec, Sys_nar.atl_lastTime);
    [Creator]      x$Users.XU$FullName;
    [ShZK]         ShZK;
    [PrichNesootv] PrichNesootv;
    table PrNaryad
    (
      [WorkerName] WorkerName;
      [ProfName]   Catalogs.Name;
      [StrTabN]    PrNaryad.StrTabN;
      [PersRazr]   GP_PrNaryad_Ext.PersRazr;
      [KTY]        round(PrNaryad.KTY * 100,2);
      [TPs]        GP_PrNaryad_Ext.TPs;
      [ZNP]        GP_PrNaryad_Ext.ZNP;
      [DSEName]    GP_PrNaryad_Ext.DSEName;
      [OperName]   GP_PrNaryad_Ext.OperName;
      [KolVo]      PrNaryad.KolVo;
      [KolVoGodn]  GP_PrNaryad_Ext.KolVoGodn;
      [OperRazr]   GP_PrNaryad_Ext.OperRazr;
      [GrOpl]      GP_PrNaryad_Ext.GrOpl;
      [NrmTime]    Doubletostr(PrNaryad.NrmTime,'666`666,8888');
      [NrmTimeDbl] PrNaryad.NrmTime;
      [Rascen]     if(PrNaryad.Summa = 0, 0, PrNaryad.Rascen);
      [NrmTimePZ]  Doubletostr(GP_PrNaryad_Ext.NrmTimePZ,'666`666,8888');
      [NrmTimePZDbl]  GP_PrNaryad_Ext.NrmTimePZ;
      [RascenPZ]   if(PrNaryad.Summa = 0, 0, GP_PrNaryad_Ext.RascenPZ);
      [Summa]      PrNaryad.Summa;
      [Proc]       PrNaryad.Proc;
      [SummPrem]   PrNaryad.SummPrem;
      [VidOplP]    KlVidOpl.VidOplP;
      [ChasF]      Doubletostr(PrNaryad.ChasF,'666`666,8888');
      [ChasFDbl]   PrNaryad.ChasF;
      [Zakaz]      NamKauD ;//MnPlan.Number;
    );
  );
)
end;

Function IsErrorZakaz(_nrec : comp; _Atl_lastTime: time) : boolean; cacheable;
{
  var _isFound : comp = 0h;

  _try
   {
     sql
     select top 1
       PrNaryad.nrec
     from PrNaryad
      join mnPlan   on mnPlan.NREC = PRNARYAD.CKAUD[1]
      join KATNOTES on KATNOTES.NREC = mnPlan.CSTATUS
      where PRNARYAD.MNrec = :(_nrec)
        and STATUS in (2,5,6)
      into (_isFound)
     ;
   }
   _except else {}

   if _isFound <> 0
    then result := true
     else result := false;
}

Function TotalChasF(_nrec: comp; _Atl_lastTime: time): Double; Cacheable;
{
  var _result : double = 0;
  _try
   {
     sql
     select
      Sum(PrNaryadSum.ChasF)
     from PrNaryad PrNaryadSum
      where PrNaryadSum.MNrec = :(_nrec)
     into (_result)
     ;
   }
   _except else {}

   result := _result;
}
Procedure PrintDoc;
{
  if not isValidAll(tnGP_PrNaryad_Ext) then exit;// печать только АММ нарядов будет
  boSettune('UP.ZAR.WT.ENHANCEDTIMEFORMAT',FALSE); // чтобы долями в наряд печатный пошло
  _SysNarNrec := Sys_Nar.Nrec;
  PushPos(tnSys_Nar);
  if not BoundActive(tbBySysNarNrec)
    AddBounds(tbBySysNarNrec);
  RunFReport(dsNariad, '', true);
  SubBounds(tbBySysNarNrec);
  PopPos(tnSys_Nar);
}
