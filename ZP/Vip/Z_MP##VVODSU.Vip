#include GetKau.Vih
#component "Z_MP"
Alter Interface VVODSU;
Overload
  procedure Pick;
end;

//------------
procedure Pick;
{ Case CurField of
  #Path:
  {  set Path := GetFileName('*.xls;*.xlsx','Выбор файла  для импорта');
  //->VVODSU_XLSDirPath
  }
  else
  { Inherited::Pick

  }
  end;
} //procedure Pick;

end.
