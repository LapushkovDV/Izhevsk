sql

/*
select staffstruct.nrec, staffstruct.department, attrval.vcomp, attrnam.name, catalogs.dopstr, em_catpodr.D0011
from  staffstruct inner join catalogs on staffstruct.department = catalogs.nrec
inner join attrval on attrval.vcomp = staffstruct.nrec and attrval.wtable=25018
inner join attrnam On attrnam.nrec=attrval.cattrnam and attrnam.wtable=25018 and attrnam.name='Должность функционального руководителя'
inner join em_catpodr On catalogs.dopstr=em_catpodr.D0001
inner join catalogs catalogsUp On  catalogsUp.dopstr=em_catpodr.D0011
inner join staffstruct staffstructUp On staffstructUp.department=catalogsUP.nrec
*/

insert into attrval(wtable, crec, cattrnam, vcomp, vstring)
select
!count(*)
25018, staffstruct.nrec, attrnam.nrec, staffstructUp.nrec, catalogsUp.name
from staffstruct
inner join catalogs on staffstruct.department = catalogs.nrec
inner join catalogs catalogsmain on catalogsmain.syscode = -11
inner join em_catpodr on catalogs.dopstr = em_catpodr.D0001 and catalogs.mainlink=catalogsmain.nrec
inner join catalogs catalogsUp on catalogsUp.dopstr = em_catpodr.D0011
inner join staffstruct staffstructUp on staffstructUp.department = catalogsUp.nrec and staffstructUp.SEQNMB=1
inner join attrnam on attrnam.wtable = 25018 and attrnam.name = 'Должность функционального руководителя'
left  join attrval attrval1 On attrval1.crec= staffstruct.nrec and attrval1.wtable=25018 and attrval1.cattrnam=attrnam.nrec
where attrval1.nrec is    null
!and catalogs.code='942'
and em_catpodr.D0011>0


!where catalogs.code='942'

