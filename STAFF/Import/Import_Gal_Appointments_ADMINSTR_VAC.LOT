
// перемещения сотрудников
sql
insert into appointments
(Lprizn, Person, CADDNREC2, orderdate, orderNMB, appointdate,DateEnd,dismissdate, DADDDATE1, department
,post, tariff,empcategory, paymodel, workcond, workregime, strtabn
,taxrate, emprate,  staffstr, StatusAPP, rate, WADDWORD1,apptabnmb, cref3)
select
0,
persons.nrec, lschet.nrec, em_person.P0009, em_person.P0012, em_person.P0003, em_person.P0009, 0 ,em_person.P0003-1, staffstruct.department
,staffstruct.post, staffstruct.tariff, staffstruct.empcategory, paymodel,0,staffstruct.WORKREGIME, persons.tabnmb
,Tarstav.tarif, 1, staffstruct.nrec, 3, staffstruct.WORKSTATIONS, 1, persons.tabnmb, em_person.p0001
from em_person  inner join persons On em_person.p0030=persons.DISPROFNMB
     and (em_person.p0007='Админ. отпуск')
inner join katpodr On Katpodr.FIO_GB=em_person.p0016
inner join staffstruct  On em_person.p0031 = Staffstruct.CNEWSPR3
inner join lschet On lschet.schp2=persons.filialno
left join tarstav On Tarstav.nrec= staffstruct.tariff
!where persons.fio='Зайцева Мария Николаевна'
;


sql
update persons set
      persons.appdate = APPOINTMENTS.APPOINTDATE,
       persons.appointCur   = Appointments.nrec,
       persons.department   = Appointments.Department,
       persons.CBASEPROF    = Appointments.Post
!        persons.STRTABN      = em_person.p0026
!select count(*)
from APPOINTMENTS inner join  persons  On APPOINTMENTS.person=persons.nrec  and APPOINTMENTS.StatusAPP=3
inner join
(
select person, max(appointdate) appointdate_max from APPOINTMENTS  group by person
) Ap ON APPOINTMENTS.person=Ap.person and APPOINTMENTS.appointdate=Ap.appointdate_max
inner join em_person On em_person.p0001=appointments.cref3
;



// Заполнение истории APPOINTMENTS

/*
sql
delete from apphist where nrec in
(select apphist.nrec from appointments appointments1 right join apphist On apphist.cappoint=appointments1.nrec
where appointments1.nrec is null)
;
*/


sql
insert into apphist
(cappoint, codoper, drec, DEND, coef1, category,  wstate, docdate, docNMB,  tariff, paymodel, workcond, workregime
,taxrate)
select
appointments.nrec,
case  when (Statusapp=0) then  1
      when (Statusapp=3) then  5
   end,
appointments.appointdate,appointments.DateEnd, appointments.Rate, appointments.empcategory, 1, appointments.orderdate,
appointments.orderNMB,  appointments.tariff, appointments.paymodel, appointments.workcond, appointments.workregime
,appointments.taxrate
from appointments left join  apphist   On apphist.cappoint=appointments.nrec
where apphist.nrec is null
;



