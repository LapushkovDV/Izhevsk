/*
// Группировка одинаковых Staffstruct  //BEGIN

// нумерация staffstruct версия без Appointments, протестировано нужно запускать
!sql update staffstruct set fld1=0, fld2=0;
!sql update appointments set staffstr=rescomp[10];


sql
update staffstruct set  staffstruct.fld1= nrec_count
!select staffstruct.department, staffstruct.post, staffstruct.nrec, nrec_count, staffstruct.DInput
  from staffstruct inner join
  (
        select  staffstruct.nrec nrec , count(*)  nrec_count
        from staffstruct
        inner join staffstruct staffstruct1
                     On staffstruct.post =            staffstruct1.post
                     and staffstruct.department =     staffstruct1.department
                     and staffstruct.TAXRATE      =   staffstruct1.TAXRATE
                     and staffstruct.MINSUMMA     =   staffstruct1.MINSUMMA
                     and staffstruct.MAXSUMMA     =   staffstruct1.MAXSUMMA
                     and staffstruct.WorkRegime   =   staffstruct1.WorkRegime
                     and staffstruct.department<>0 and staffstruct.Post<>0
                     and to_days(datetime(staffstruct.DInput,0))+cos(int64(staffstruct.nrec))>=
                         to_days(datetime(staffstruct1.DInput,0))+cos(int64(staffstruct1.nrec))
!        inner join persons On persons.nrec=staffstruct.person
!        where persons.fio='Воробьёв Пётр Владимирович'
!        where persons.fio='Козлов Леонид Леонидович'
!         where    to_days(datetime(appointments.appointdate,0))+cos(int64(appointments.person))>=to_days(datetime(appointments1.appointdate,0))+cos(int64(appointments1.person))
         group by staffstruct.nrec
   ) staff On staff.nrec=staffstruct.nrec
!   where  nrec_count>1

!order by  staffstruct.department, nrec_count
;




// определение одинаковых групп Staffstruct, простановка  максимальных номеров для таких групп в Staffstruct
sql
update staffstruct set  staffstruct.fld2=maxfld2
!select  staffstruct.fld1, maxfld2, staffstruct.department, staffstruct.Post, staffstruct.nrec
from staffstruct inner join
     (
     select max(staffstruct.fld1) maxfld2
     ,post
     ,department
     ,TAXRATE
     ,MINSUMMA
     ,MAXSUMMA
     ,WorkRegime
     from staffstruct
     where staffstruct.department<>0 and staffstruct.Post<>0
     group by
      staffstruct.post
     ,staffstruct.department
     ,staffstruct.TAXRATE
     ,staffstruct.MINSUMMA
     ,staffstruct.MAXSUMMA
     ,staffstruct.WorkRegime
     ) staff On
     staff.post         =  staffstruct.post
     and staff.department   =  staffstruct.department
     and staff.TAXRATE      =  staffstruct.TAXRATE
     and staff.MINSUMMA     =  staffstruct.MINSUMMA
     and staff.MAXSUMMA     =  staffstruct.MAXSUMMA
     and staff.WorkRegime   =  staffstruct.WorkRegime
     and staffstruct.department<>0 and staffstruct.Post<>0
!order by staffstruct.department, staffstruct.Post,  staffstruct.fld1
;




// Обновление Appointments, сохранение ссылки на старый staffstruct
sql update appointments set RESCOMP[10]=staffstr;




// Обновление Appointments, обновление ссылки на новый staffstruct
sql
update appointments set appointments.staffstr=staffstruct1.nrec
!select staffstruct.fld1, staffstruct.fld2, staffstruct1.fld1, staffstruct.department, staffstruct.Post, staffstruct.nrec, staffstruct1.nrec
from appointments inner join staffstruct On staffstruct.nrec=appointments.staffstr
inner join staffstruct staffstruct1 On
          staffstruct.post          =  staffstruct1.post
      and staffstruct.department    =  staffstruct1.department
      and staffstruct.TAXRATE       =  staffstruct1.TAXRATE
      and staffstruct.MINSUMMA      =  staffstruct1.MINSUMMA
      and staffstruct.MAXSUMMA      =  staffstruct1.MAXSUMMA
      and staffstruct.WorkRegime    =  staffstruct1.WorkRegime
      and staffstruct.department<>0 and staffstruct.Post<>0
      and staffstruct.fld2=staffstruct1.fld1
      and staffstruct.fld2<>staffstruct.fld1
!order by staffstruct.department, staffstruct.Post,  staffstruct.fld1, staffstruct.fld2
;



sql
update staffstruct set staffstruct.WORKSTATIONS=staffstruct.WORKSTATIONS+SumWorkstations
!select  staffstruct.WORKSTATIONS, SumWorkstations, staffstruct.nrec
from staffstruct inner join (
select sum(staffstructdel.WORKSTATIONS) SumWorkstations, staffstruct.nrec nrec
!min(staffstruct.WORKSTATIONS), sum(staffstructdel.WORKSTATIONS)+min(staffstruct.WORKSTATIONS), min(staffstruct.nrec) nrec
from staffstruct inner join appointments On appointments.staffstr=staffstruct.nrec
inner join staffstruct staffstructdel On staffstructdel.nrec=appointments.rescomp[10]
where  staffstruct.fld2=staffstruct.fld1
and staffstruct.nrec<>staffstructdel.nrec
group by staffstruct.nrec
) staff On staffstruct.nrec=staff.nrec
;


sql
update historystr set historystr.HWORKSTATIONS=staffstruct.WORKSTATIONS
from staffstruct inner join historystr On historystr.staffstr=staffstruct.nrec
;


sql
delete from staffstruct where nrec in (
select staffstruct.nrec
from staffstruct left join appointments On appointments.staffstr=staffstruct.nrec
left join appointments appointments1 On appointments1.rescomp[10]=staffstruct.nrec
where appointments.nrec is null
and appointments1.nrec is not null
and staffstruct.fld2<>staffstruct.fld1
)
;



// Группировка одинаковых Staffstruct  //END

*/




