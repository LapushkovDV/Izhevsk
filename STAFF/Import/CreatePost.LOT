create table D_USER.EM_POST "Таблица EM_POST"
  using "EM_POST.dat"
!  component USER
  with table_Code = 31722
  with tableOptions header, journal, corpo
  (
   P0001 : LongInt "ID должности",
   P0002 : String [200] "Наименование",
   P0003 : String [10] "Код Должности",
   P0008 : String [10] "Код для КД",
   P0009 : String [20] "Разряд",
   P0010 : String [20] "Статус"
  )
  with index
  (
   i_P0001 = P0001,
   i_P0002 = P0002,
   i_P0003 = P0003,
   i_P0008 = P0008,
   i_P0009 = P0009,
   i_P0010 = P0010
  );