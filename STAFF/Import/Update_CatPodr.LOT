SQL
update catalogs set catalogs.cParent=Catalogs1.nrec
// Select substring(Catalogs.name,1,30),Catalogs.Code,CataLogs1.name
From Catalogs Catal
inner join Catalogs on Catalogs.MainLink=Catal.Nrec and Catalogs.Name<>'я_Архивные подразделения'
inner join Catalogs Catalogs1 on Catalogs1.MainLink=Catal.Nrec and Catalogs1.Name='я_Архивные подразделения'
Left Outer join Catalogs Catalogs2 on Catalogs2.cParent= Catalogs.Nrec
Left Outer join StaffStruct on StaffStruct.Department = Catalogs.Nrec and CASE WHEN Catalogs.Name='' THEN StaffStruct.DClose ELSE 0 END =0
where Catal.syscode=-11 and (StaffStruct.Nrec is Null) and (Catalogs2.Nrec is Null) and Catalogs.cParent<>Catalogs1.nrec
;



