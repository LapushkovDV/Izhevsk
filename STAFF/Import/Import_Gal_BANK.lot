sql
insert into katbank (cbank, name, remark, addr, mfo1, mfo2, schet2, corg)
select katb.nrec, katb.name, katb.remark, katb.addr, katb.mfo1, katb.mfo2, katb.korschet, katorg.nrec
from katb
inner join katorg on katorg.name = '€ "‚’ 24"'
where katb.name = '‚’ 24 (€)' and katorg.name = '€ "‚’ 24"'
;

