sql
insert into shtraf ( cbankpol, nomlsh, cpol, tperson, clsch, vidud, namepl1, pometka, prper, flag3, strtabn)
select distinct katbank.nrec, em_bank.bn005, katorg.nrec, persons.nrec, lschet.nrec, 141, '« ­®¢ë©  ¢ ­á ¢ ¡ ­ª', '+', 1, '+', lschet.strtabn
from em_bank
inner join katbank on katbank.mfo1 = em_bank.bn007
inner join katorg on katorg.nrec = katbank.corg
inner join persons on persons.disprofnmb = em_bank.bn001
inner join lschet on lschet.tperson = persons.nrec and (lschet.sovm = 1 or lschet.sovm = 0)
where em_bank.bn003 = 1 and em_bank.bn006 = '' and em_bank.bn009 = '€ªâ¨¢­ë©'

union all

select distinct katbank.nrec, em_bank.bn005, katorg.nrec, persons.nrec, lschet.nrec, 141, '« ­®¢ë©  ¢ ­á ¢ ¡ ­ª', '+', 1, '+', lschet.strtabn
from em_bank
inner join katbank on katbank.mfo1 = em_bank.bn007
inner join katorg on katorg.nrec = katbank.corg
inner join persons on persons.disprofnmb = em_bank.bn001
inner join lschet on lschet.tperson = persons.nrec and lschet.schp2 = em_bank.bn008 and (lschet.sovm = 2 or lschet.sovm = 3 or lschet.sovm = 5)
where em_bank.bn003 = 1 and em_bank.bn006 = '' and em_bank.bn009 = '€ªâ¨¢­ë©'
;

