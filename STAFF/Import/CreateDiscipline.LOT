create table D_USER.EM_DISP "Таблица EM_DISP"
  using "EM_DISP.dat"
!  component USER
  with table_Code = 31745
  with tableOptions header, journal, corpo
  (
   ID         : LongInt "ID AWARDS",
   CITEZENID  : LongInt "ID сотрудника",
   EMPLOYEEID : LongInt "ID физическего лица",
   BASICDOC   : String [255] "Номер документа о награждении.",
   EVENTTYPE  : String [255] "Причина Наказания",
   EVENTDATE  : date   "дата наказания",
   COLLECTTYPE  : String [100] "Вид наказания"


  )
  with index
  (
   i_ID          = ID,
   i_CITEZENID   = CITEZENID,
   i_EMPLOYEEID  = EMPLOYEEID,
   i_BASICDOC    = BASICDOC,
   i_EVENTTYPE   = EVENTTYPE,
   i_EVENTDATE   = EVENTDATE,
   i_COLLECTTYPE = COLLECTTYPE
   );