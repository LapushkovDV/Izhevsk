// разовая синхронизация импортированных раннее отпусков без ID
sql
select
!em_vacations.atl_nrec,em_vacations.v0010, em_vacations.v0001, em_vacations.v0009
!,em_vacations.v0003, em_vacations.v0004, em_vacations.v0005, em_vacations.v0006,em_vacations.v0007
em_vacations.v0001,em_vacations.v0005, em_vacations.v0006, em_vacations.v0010, count(*)
from em_vacations
     inner join persons On persons.disprofnmb=em_vacations.v0001
!     inner join em_person On em_person.p0030 = persons.disprofnmb  //and persons.filialno=em_vacations.v0009
     inner join factotpusk On  persons.nrec=factotpusk.person
     inner join klotpusk On klotpusk.kotpus=v0010 and factotpusk.vactype=v0010
     and em_vacations.v0003=factotpusk.WORKYEARBEG
     and em_vacations.v0004=factotpusk.WORKYEAREND
     and em_vacations.v0005=factotpusk.factyearbeg
     and em_vacations.v0006=factotpusk.factyearend
     and em_vacations.v0007=factotpusk.DURATION
!where persons.disprofnmb='62958'
group by  em_vacations.v0001,em_vacations.v0005,em_vacations.v0006, em_vacations.v0010
having count(*)>1
;


