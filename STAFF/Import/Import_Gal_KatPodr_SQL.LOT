// Загрузка папок подразделений  шестого уровня из КИС  в  Галактический  Catalogs

insert into Catalogs  (Name, cparent, MAINLINK, GROUPCODE, SYSCODE, Code, DOPSTR, DATN, DATOK)
select em_catpodr1.D0003, Catalogs1.nrec, CatalogsMain.nrec,  2, 0, em_catpodr1.d0002, em_catpodr1.d0001
,em_catpodr1.D0007 , if( rtrim(em_catpodr1.D0010)='Архивный',Cur_Date,0)
FROM em_catpodr em_catpodr1, em_catpodr em_catpodr2, em_catpodr em_catpodr3, em_catpodr em_catpodr4,
em_catpodr em_catpodr5, em_catpodr em_catpodr6, em_catpodr em_catpodr7,
catalogs catalogs1, catalogs catalogs2,  catalogs catalogsmain
where ((
      '-11' == catalogsmain.syscode
      and em_catpodr1.D0005  ==  em_catpodr2.D0001
      and em_catpodr2.D0005  ==  em_catpodr3.D0001
      and em_catpodr3.D0005  ==  em_catpodr4.D0001
      and em_catpodr4.D0005  ==  em_catpodr5.D0001
      and em_catpodr5.D0005  ==  em_catpodr6.D0001
      and em_catpodr6.D0005  ==  em_catpodr7.D0001
      and em_catpodr2.D0001  ==  catalogs1.DOPSTR (NoIndex)
      and em_catpodr1.D0001  ==  catalogs2.DOPSTR (NoIndex)
))
and isvalidall(tnem_catpodr2)=true
and isvalidall(tnem_catpodr3)=true
and isvalidall(tnem_catpodr4)=true
and isvalidall(tnem_catpodr5)=true
and isvalidall(tnem_catpodr6)=true
