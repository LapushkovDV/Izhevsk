      and em_catpodr2.D0001  ==  catalogs1.DOPSTR (NoIndex)
      and em_catpodr1.D0001  ==  catalogs2.DOPSTR (NoIndex)
))
and isvalidall(tnem_catpodr2)=true
and isvalidall(tnem_catpodr3)=true
and isvalidall(tnem_catpodr4)=false
and isvalidall(tncatalogs1)=true
and isvalidall(tncatalogs2)=false
and  (length(em_catpodr1.D0002)>0 or length(em_catpodr1.D0003)>0)
;


