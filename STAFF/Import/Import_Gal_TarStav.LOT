// требуется запускать только на чистой базе // END



sql
insert into tarstav (codtar, NaiTar, sisopl, razr, tarif, tarmin, tarmax, DATIZM, SFIELD1)
select
cast (atl_nrec as longint)-tarstav_min_row_Num.min_row_num+1,
case  when length(T0004)=0 then  cast(T0003 as string) ||'/' ||cast(T0005 as string)
      when length(T0004)>0 then  T0004
end,
t0003, t0005, t0006, t0007, t0008,
case when  t0019='Активный' then DATE(DATEtime(#date(1, 1, 2016),0))
     when  t0019='Архивный' then DATE(DATEtime(#date(1, 1, 2014),0))
end,
t0001

from em_tarstav cross join
(
select
min(cast (atl_nrec as longint)) min_row_num
from em_tarstav
) tarstav_min_row_Num
left join tarstav On Tarstav.SFIELD1=t0001
where (t0019='Активный' or t0019='Архивный')
and tarstav.nrec is null
;


