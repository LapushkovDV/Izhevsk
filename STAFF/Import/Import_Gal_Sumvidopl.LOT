sql
delete from sumvidop;

sql
insert into sumvidop (vidopl, vidoplp, mesn, yearn, mes, yeark, summa,
                    chasf, koldn, chasgr, koldngr, cex, clsch,
                    tperson, sisopl, strtabn, cappoint, codtar, kateg, cexoz, tarif)

select klvidopl.vidopl, klvidopl.vidopl, sr004, sr005, sr006, sr007, sr008,
sr009, sr010, sr011, sr012, lschet.cex, lschet.nrec,
lschet.tperson, lschet.sisopl, lschet.strtabn,
lschet.cappoint,lschet.codtar, lschet.kateg, lschet.cex, lschet.tarif
from em_sumopl
inner join em_person on em_person.p0001 = em_sumopl.sr013
inner join lschet on lschet.schp2 = em_person.p0001
inner join klvidopl on klvidopl.vidoplp = em_sumopl.sr003
where (lschet.sovm = 2 or lschet.sovm = 3) and klvidopl.vidopl <> 238
;

sql
insert into sumvidop (vidopl, vidoplp, mesn, yearn, mes, yeark, summa,
                    chasf, koldn, chasgr, koldngr, cex, clsch,
                    tperson, sisopl, strtabn, cappoint, codtar, kateg, cexoz, tarif)

select klvidopl.vidopl, klvidopl.vidopl, sr004, sr005, sr006, sr007, sr008,
sr009, sr010, sr011, sr012, katpodr.nrec, lschet.nrec,
lschet.tperson, tarstav.sisopl, lschet.strtabn,
appointments.post, tarstav.codtar, klkatego.kod, katpodr.nrec, staffstruct.taxrate
from em_sumopl
inner join em_person on em_person.p0001 = em_sumopl.sr013  and em_person.p0007 = 'Основное место работы'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidopl on klvidopl.vidoplp = em_sumopl.sr003
inner join appointments on appointments.cref3 = em_sumopl.sr013
inner join katpodr on katpodr.kod = cast(em_sumopl.sr016 as string) and katpodr.isarch = 0
inner join klkatego on klkatego.nrec = appointments.empcategory
inner join tarstav on tarstav.nrec = appointments.tariff
inner join staffstruct on staffstruct.nrec = appointments.staffstr
where lschet.sovm = 0 and klvidopl.vidopl <> 238
;

sql
insert into sumvidop (vidopl, vidoplp, mesn, yearn, mes, yeark, summa,
                    chasf, koldn, chasgr, koldngr, cex, clsch,
                    tperson, sisopl, strtabn, cappoint, codtar, kateg, cexoz, tarif)

select klvidopl.vidopl, klvidopl.vidopl, sr004, sr005, sr006, sr007, sr008,
sr009, sr010, sr011, sr012, katpodr.nrec, lschet.nrec,
lschet.tperson, tarstav.sisopl, lschet.strtabn,
appointments.post, tarstav.codtar, klkatego.kod, katpodr.nrec, staffstruct.taxrate
from em_sumopl
inner join em_person on em_person.p0001 = em_sumopl.sr013  and em_person.p0007 = 'Внешнее совместительство'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidopl on klvidopl.vidoplp = em_sumopl.sr003
inner join appointments on appointments.cref3 = em_sumopl.sr013
inner join katpodr on katpodr.kod = cast(em_sumopl.sr016 as string) and katpodr.isarch = 0
inner join klkatego on klkatego.nrec = appointments.empcategory
inner join tarstav on tarstav.nrec = appointments.tariff
inner join staffstruct on staffstruct.nrec = appointments.staffstr
where lschet.sovm = 1 and klvidopl.vidopl <> 238
;

sql
update sumvidop set sumvidop.yeark = sumvidop.yearn
from sumvidop
where  sumvidop.yeark = 0
;

sql
update sumvidop set sumvidop.mes = sumvidop.mesn
from sumvidop
where  sumvidop.mes = 0
;

