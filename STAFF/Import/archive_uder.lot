sql
delete from sumvidud;

sql
insert into sumvidud (vidud, vidudp, mesn, yearn, mes, yeark, sumud, filialno, tabn)

select klvidud.vidud, klvidud.vidudp, nl004, nl005, nl006, nl007, nl008, nl009, nl001
from em_ndfl
left join em_person on em_person.p0001 = em_ndfl.nl009
inner join lschet on lschet.strtabn = '999999'
inner join klvidud on klvidud.vidudp = em_ndfl.nl003
;

sql
insert into sumvidud (vidud, vidudp, mesn, yearn, sumud, filialno, tabn)

select distinct 220, 999, sr004, sr005, sr015, sr013, sr001
from em_sumopl
inner join em_person on em_person.p0001 = em_sumopl.sr013
inner join lschet on lschet.strtabn = '999999'
inner join klvidopl on klvidopl.vidoplp = em_sumopl.sr003
;

sql
update sumvidud set sumvidud.cex = lschet.cex, sumvidud.clsch = lschet.nrec,
                    sumvidud.tperson = lschet.tperson, sumvidud.strtabn = lschet.strtabn, sumvidud.cappoint = lschet.cappoint,
                    sumvidud.codtar = lschet.codtar, sumvidud.kateg = lschet.kateg, sumvidud.cexoz = lschet.cex
from sumvidud
inner join lschet on lschet.schp2 = sumvidud.filialno
where lschet.sovm = 2 and lschet.sovm = 3
;

sql
update sumvidud set sumvidud.cex = lschet.cex, sumvidud.clsch = lschet.nrec,
                    sumvidud.tperson = lschet.tperson, sumvidud.strtabn = lschet.strtabn, sumvidud.cappoint = lschet.cappoint,
                    sumvidud.codtar = lschet.codtar, sumvidud.kateg = lschet.kateg, sumvidud.cexoz = lschet.cex
from sumvidud
inner join em_person on em_person.p0001 = sumvidud.filialno and em_person.p0007 = 'Основное место работы'
inner join lschet on lschet.tabdop[10] = em_person.p0030
where lschet.sovm = 0
;

sql
update sumvidud set sumvidud.cex = lschet.cex, sumvidud.clsch = lschet.nrec,
                    sumvidud.tperson = lschet.tperson, sumvidud.strtabn = lschet.strtabn, sumvidud.cappoint = lschet.cappoint,
                    sumvidud.codtar = lschet.codtar, sumvidud.kateg = lschet.kateg, sumvidud.cexoz = lschet.cex
from sumvidud
inner join em_person on em_person.p0001 = sumvidud.filialno and em_person.p0007 = 'Внешнее совместительство'
inner join lschet on lschet.tabdop[10] = em_person.p0030
where lschet.sovm = 1
;


sql
update sumvidud set sumvidud.yeark = sumvidud.yearn
from sumvidud
where sumvidud.yeark = 0
;

sql
update sumvidud set sumvidud.mes = sumvidud.mesn
from sumvidud
where sumvidud.mes = 0
;

sql
update sumvidud set sumvidud.yearv = sumvidud.yearn
from sumvidud
where sumvidud.yearv = 0
;

sql
update sumvidud set sumvidud.mesv = sumvidud.mesn
from sumvidud
where sumvidud.mesv = 0
;