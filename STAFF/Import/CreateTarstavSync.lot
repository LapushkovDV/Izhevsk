create table D_USER.TARSTAVSYNC "Таблица синхронизации тарифных ставок"
  using "TARSYNC.dat"
!  component USER
  with table_Code = 31730
  with tableOptions  header, journal, corpo
  (
   ID : longint "ID уровня",
   cTarstav : comp "Ссылка на NewTARSTAV"
  )

  with index
  (
  i_ID =  ID,
  i_cTarstav = cTarstav
  );