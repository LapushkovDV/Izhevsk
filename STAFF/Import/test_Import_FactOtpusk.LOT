sql
select
count(*)
!em_vacations.atl_nrec,
!persons.nrec,  lschet.nrec,
!persons.APPOINTCUR,
!persons.GALDEP, v0010, v0003, v0004, v0005, v0006, v0007 ,
!DATE2STR('%M',v0005 ) as koldngr,
!DATE2STR('%YYYY',v0005 ) as year_vac, DATE2STR('%YYYY',v0005 ) as periodyear, persons.TABNMB
from em_vacations inner join persons ON persons.DISPROFNMB=em_vacations.V0001
inner join em_person On em_person.p0001=em_vacations.v0009
inner join klsovm    On em_person.p0007 = klsovm.nsovm
inner join lschet    On Lschet.tperson=persons.nrec and lschet.sovm=klsovm.sovm //and klsovm.sovm<>0
    and lschet.schp2=cast(em_vacations.v0009 as string)
inner join klotpusk  On klotpusk.kotpus=v0010
left join FactOtpusk FactOtpuskOld On FactOtpuskOld.nrec = em_vacations.atl_nrec
where  FactOtpuskOld.nrec is null
and  length(lschet.schp2)>1
group by em_vacations.atl_nrec
having count(*)>1
;


