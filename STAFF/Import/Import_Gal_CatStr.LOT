//Импорт Katpodr

//копирование поля D0011  в поле D0005 (ID вышестоящего руководителя и вышестоящего подразделения)


!delete all from catalogs where  length(DOPSTR)>3;
!delete all from ExtCatLinks where  11 = ExtCatLinks.ObjType  and 1  = ExtCatLinks.ModType;

!update EM_CatStr where D0005=0 and D0011 <>0 set D0005:=D0011 ;


