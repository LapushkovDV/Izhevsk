// Загрузка таблицы синхронизации между catalogs и KattPodr

insert into ExtCatLinks  (ObjType, ModType, StaffCat, extCat)
select  11, 1, catalogs.nrec, katpodr.nrec

FROM catalogs, katpodr,  catalogs catalogsmain //, ExtCatLinks ExtCatLinks1

where ((
!      11 == ExtCatLinks1.ObjType
!      and 1  == ExtCatLinks1.ModType
!      and katpodr.nrec  == ExtCatLinks1.ExtCat
!      and catalogs.nrec == ExtCatLinks1.STAFFCAT
      '-11' == catalogsmain.syscode
      and 0 == catalogs.LPR
      and catalogsmain.nrec == catalogs.MAINLINK
      and catalogs.DOPSTR == katpodr.FIO_GB (Noindex)

))
!and isvalidall(tnExtCatLinks1)=false
and  length(catalogs.DOPSTR)>3
and isvalidall(tnkatpodr)=true
;

