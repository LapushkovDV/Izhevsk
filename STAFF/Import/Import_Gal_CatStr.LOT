// Загрузка папок подразделений  четвертого уровня из КИС  в  Галактический  Catalogs

insert into Catalogs  (Name, cparent, MAINLINK, GROUPCODE, SYSCODE, Code, DOPSTR, DATN, DATOK)
select em_CatStr1.D0003, Catalogs1.nrec, CatalogsMain.nrec,  2, 0, em_CatStr1.d0002, em_CatStr1.d0001
,em_CatStr1.D0007 , if( rtrim(em_CatStr1.D0010)='Архивный',Cur_Date,0)
FROM em_CatStr em_CatStr1, em_CatStr em_CatStr2, em_CatStr em_CatStr3, em_CatStr em_CatStr4, em_CatStr em_CatStr5,
catalogs catalogs1, catalogs catalogs2,  catalogs catalogsmain
where ((
      '-11' == catalogsmain.syscode
      and em_CatStr1.D0005  ==  em_CatStr2.D0001
      and em_CatStr2.D0005  ==  em_CatStr3.D0001
      and em_CatStr3.D0005  ==  em_CatStr4.D0001
      and em_CatStr4.D0005  ==  em_CatStr5.D0001
      and em_CatStr2.D0001  ==  catalogs1.DOPSTR (NoIndex)
      and em_CatStr1.D0001  ==  catalogs2.DOPSTR (NoIndex)
))
and isvalidall(tnem_CatStr2)=true
and isvalidall(tnem_CatStr3)=true
and isvalidall(tnem_CatStr4)=true
and isvalidall(tnem_CatStr5)=false
and isvalidall(tncatalogs1)=true
and isvalidall(tncatalogs2)=false
and  (length(em_CatStr1.D0002)>0 or length(em_CatStr1.D0003)>0)
;



// Загрузка папок подразделений  пятого уровня из КИС  в  Галактический  Catalogs

insert into Catalogs  (Name, cparent, MAINLINK, GROUPCODE, SYSCODE, Code, DOPSTR, DATN, DATOK)
select em_CatStr1.D0003, Catalogs1.nrec, CatalogsMain.nrec,  2, 0, em_CatStr1.d0002, em_CatStr1.d0001
,em_CatStr1.D0007 , if( rtrim(em_CatStr1.D0010)='Архивный',Cur_Date,0)
FROM em_CatStr em_CatStr1, em_CatStr em_CatStr2, em_CatStr em_CatStr3, em_CatStr em_CatStr4, em_CatStr em_CatStr5, em_CatStr em_CatStr6,
catalogs catalogs1, catalogs catalogs2,  catalogs catalogsmain
where ((
      '-11' == catalogsmain.syscode
      and em_CatStr1.D0005  ==  em_CatStr2.D0001
      and em_CatStr2.D0005  ==  em_CatStr3.D0001
      and em_CatStr3.D0005  ==  em_CatStr4.D0001
      and em_CatStr4.D0005  ==  em_CatStr5.D0001
      and em_CatStr5.D0005  ==  em_CatStr6.D0001
      and em_CatStr2.D0001  ==  catalogs1.DOPSTR (NoIndex)
      and em_CatStr1.D0001  ==  catalogs2.DOPSTR (NoIndex)
))
and isvalidall(tnem_CatStr2)=true
and isvalidall(tnem_CatStr3)=true
and isvalidall(tnem_CatStr4)=true
and isvalidall(tnem_CatStr5)=true
and isvalidall(tnem_CatStr6)=false
and isvalidall(tncatalogs1)=true
and isvalidall(tncatalogs2)=false
and  (length(em_CatStr1.D0002)>0 or length(em_CatStr1.D0003)>0)
;


