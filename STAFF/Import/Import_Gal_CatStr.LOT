!insert into Catalogs  (Name, cparent, MAINLINK, GROUPCODE, SYSCODE, Code, DOPSTR, DATN, DATOK)
sql
select em_catstr1.c0001, em_catstr1.c0003,  em_catstr1.c0002,  em_catstr2.c0003 //, catalogsmain.name
!em_CatStr1.C0003, Catalogs1.nrec, CatalogsMain.nrec,  2, 0, em_CatStr1.C0002, em_CatStr1.C0001
!,em_CatStr1.C0008 , CurDate, 0
FROM

em_CatStr em_CatStr1  left join em_CatStr em_CatStr2
          On  em_CatStr1.C0005  =  em_CatStr2.C0001
!cross join catalogs catalogsmain
!inner join catalogs catalogs1  On '000002'  = catalogs1.code
!                             and 'ЭнергоМаш2' = catalogs1.name
!                              and catalogs1.mainlink=catalogsmain.nrec
!                              and catalogsmain.syscode = '-11'


!left join catalogs catalogs2 ON em_CatStr1.C0001 = catalogs2.DOPSTR
where
em_CatStr2.atl_nrec is null
!and catalogs2.nrec is null
and  (length(em_CatStr1.C0002)>0 or length(em_CatStr1.C0003)>0)
and em_CatStr1.C0010='Активный'
;



