sql
update lschet set lschet.strtabn = persons.strtabn
from lschet
inner join persons on persons.nrec = lschet.tperson
where lschet.sovm = 0 or lschet.sovm = 1
;


sql
update lschet set lschet.strtabn =  numcount
from
(
select distinct persons.fio, lschet.nrec, lschet.strtabn, persons.strtabn + '_' + cast(count(lschet1.nrec) as string) numcount
from lschet
inner join persons on persons.nrec = lschet.tperson
inner join lschet lschet1 on lschet.nrec >=lschet1.nrec  and lschet.tabdop[10] = lschet1.tabdop[10] and lschet1.sovm <> 0
where lschet.sovm = 3
group by persons.fio, lschet.nrec, lschet.strtabn, persons.strtabn
) ls inner join lschet on lschet.nrec=ls.nrec
;


