sql
insert into appldocs(crec, ctipdoc)
select lschet.nrec, lschet1.nrec
from lschet
inner join lschet lschet1 on lschet.tabdop[10] = lschet1.tabdop[10]
where lschet.sovm = 0 and lschet1.sovm = 3
;

sql
update lschet set lschet.char30 = '_'
from lschet
inner join lschet lschet1 on lschet.tabdop[10] = lschet1.tabdop[10]
where lschet.sovm = 0 and lschet1.sovm = 3
;

sql
update lschet set lschet.char4 = '-'
from lschet
inner join lschet lschet1 on lschet.tabdop[10] = lschet1.tabdop[10]
where lschet1.sovm = 0 and lschet.sovm = 3
;

