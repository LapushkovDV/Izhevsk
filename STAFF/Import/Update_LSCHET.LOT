sql
update lschet set lschet.cex = katpodr.nrec
from lschet
inner join appointments on appointments.caddnrec2 = lschet.nrec
inner join catalogs On catalogs.nrec = appointments.department
inner join extcatlinks on extcatlinks.staffcat = catalogs.nrec
inner join katpodr on katpodr.nrec = extcatlinks.extcat
;

sql
update lschet set lschet.cex = katpodr.nrec
from lschet
inner join persons on persons.nrec = lschet.tperson
inner join appointments on appointments.nrec = persons.appointcur
inner join catalogs On catalogs.nrec = appointments.department
inner join extcatlinks on extcatlinks.staffcat = catalogs.nrec
inner join katpodr on katpodr.nrec = extcatlinks.extcat
where (lschet.sovm = 0 and appointments.lprizn = 0) or (lschet.sovm = 1 and appointments.lprizn = 1)
;


