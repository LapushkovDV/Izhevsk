sql
update lschet set lschet.datuv = appointments.dismissdate
from lschet
inner join appointments on appointments.caddnrec2 = lschet.nrec
where lschet.sovm <> 0 and lschet.sovm <> 1 and lschet.datpos = appointments.appointdate and lschet.datuv = appointments.dismissdate
;


