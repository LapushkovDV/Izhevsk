sql
select Em_person.P0002, em_staffstruct.s0001, em_staffstruct.s0021, klrejim.NRejim, em_staffstruct.s0021
from em_staffstruct join em_Person On EM_person.P0031=em_staffstruct.s0001
left join klrejim  On klrejim.rejim=em_staffstruct.s0021
where   klrejim.Nrec is  null
and length(em_staffstruct.s0021)>0
and em_staffstruct.s0021<>0