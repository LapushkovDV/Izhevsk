
// Проверка  на наличие профессий и вставка в Галактическом Catalogs
sql
insert into catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name, Code)
!, dopstr)
select
!count(*)
!distinct
!min(catalogsparent.nrec), min(catalogsmain.nrec), 0, 0, em_post.p0002+' '+replace(p0009,'нет',''), min(em_post.p0003), min(em_post.p0001)
distinct catalogsparent.nrec, catalogsmain.nrec, 0, 0, em_staffstruct.s0014, em_post.p0003
!, em_post.p0001
from  em_staffstruct
     inner join catalogs catalogsMain On catalogsmain.syscode=9004
     inner join catalogs catalogsParent On catalogsparent.syscode=49
     inner join em_post On em_post.p0001=em_staffstruct.s0012
     left join catalogs On Catalogs.name=em_staffstruct.s0014
          and  Catalogsmain.nrec   = catalogs.mainlink
          and  Catalogsparent.nrec   = catalogs.cparent
where catalogs.nrec is null
;


