create table D_USER.EM_VREDNEMP "Доплаты по вредности"
  using "EM_VRMP.dat"
!  component USER
  with table_Code = 31746
  with tableOptions header, journal, corpo
  (

     EMPLOYEEID: LongInt "ID Рабочего места"
   ,CITEZENID : LongInt "ID физ. лица"
   ,JOBTITLE  : string
   ,SUMMA     : double
   ,KOLDN     : longint
  )
  with index
  (
   EM_VREDNEMP001=EMPLOYEEID,
   EM_VREDNEMP002=CITEZENID

  );
