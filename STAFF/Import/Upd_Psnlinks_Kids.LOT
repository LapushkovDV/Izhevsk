//проверка seqnmb
sql
select psnlinks.fromperson, persons.fio, psnlinks.rfio, psnlinks.rborndate, psnlinks.seqnmb
from psnlinks
inner join persons on psnlinks.fromperson = persons.nrec
inner join catalogs on psnlinks.linktype = catalogs.nrec and (catalogs.name = 'сын' or catalogs.name = 'дочь')
!order by psnlinks.nrec
order by persons.fio




