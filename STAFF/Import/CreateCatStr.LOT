create table D_USER.EM_CATSTR "Таблица EM_CATSTR"
  using "EM_CATST.dat"
!  component USER
  with table_Code = 31709
  with tableOptions header, journal, corpo
  (
   C0001 : LongInt "ID уровня",
   C0002 : String [50] "Код подразделения",
   C0003 : String [100] "Наименование подразделения",
   C0004 : String [100] "Длинное наименование",
   C0005 : LongInt   "ID вышестоящего подразделения",
   C0006 : String  [50]    "Код вышестоящего подразделения",
   C0008 : Date     "Дата ввода",
   C0009 : String [100] "Главный каталог",
   C0010 : String [100] "Статус подразделения",
   C0011 : Date "Дата изменения статуса"
  )
  with index
  (
   i_C0001 = C0001,
   i_C0002 = C0002,
   i_C0003 = C0003,
   i_C0004 = C0004,
   i_C0005 = C0005,
   i_C0006 = C0006,
   i_C0008 = C0008,
   i_C0009 = C0009,
   i_C0010 = C0010,
   i_C0011 = C0011
  );
