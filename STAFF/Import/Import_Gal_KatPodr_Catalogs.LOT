//Импорт Katpodr и Catalogs


!sql delete  from katpodr where  length(FIO_GB)>3;
!sql delete  from catalogs where  length(DOPSTR)>3;

// Удаление отвязанных записей из таблицы синхронизации подразделений в кадрах и подразделений в зарплате

sql
delete  from ExtCatLinks where nrec in (
select
!count(*)
ExtCatLinks.nrec
from ExtCatLinks left join katpodr On katpodr.nrec=ExtCatLinks.extcat
left join catalogs On Catalogs.nrec=ExtCatLinks.Staffcat
where  11 = ExtCatLinks.ObjType  and 1  = ExtCatLinks.ModType
and (katpodr.nrec is null or catalogs.nrec is null)
)
;




// Загрузка корневой записи в Katpodr
sql
insert into Katpodr  (kod, Name, Isleaf, CPodr, isarch, dto, FIO_GB)
select distinct '000002', 'ЭнергоМаш', 0, 0, 0, 0, 28282828
where not exists
(select * from katpodr where 'ЭнергоМаш' = katpodr.name and '000002'  = katpodr.kod)
;




// Загрузка подразделений   из КИС  в  Галактический  Katpodr
sql
insert into Katpodr  (kod, Name, Isleaf,  LastDate, dto, FIO_GB, sklad)
select
distinct
 em_catpodr1.D0002,
case
     when length(em_catpodr1.D0003)=0  then 'ID_' + cast(em_catpodr1.D0001 as string)
     when length(em_catpodr1.D0003)<>0 then em_catpodr1.D0003
end,
0,
case
     when em_catpodr1.D0010='Архивный'  then Curdate
     when em_catpodr1.D0010<>'Архивный' then 0
end,
case
     when em_catpodr1.D0010='Архивный'  then Curdate
     when em_catpodr1.D0010<>'Архивный' then 0
end,
em_catpodr1.D0001,
case
     when em_catpodr1.D0009='склад' then Curdate
     when em_catpodr1.D0009<>'склад' then 0
end
from em_catpodr em_catpodr1 left join katpodr katpodr2 ON  em_catpodr1.D0001 = katpodr2.FIO_GB
left join em_person On em_catpodr1.D0001 = em_person.p0016
where   katpodr2.nrec is  null
        and em_person.p0001 is not null
        and  (length(em_catpodr1.D0002)>0 or length(em_catpodr1.D0003)>0)
;



// Загрузка иерархии подразделений  из КИС  в  Галактический  Katpodr
sql
update katpodr set katpodr.cPodr=Katpodrparent.nrec
!select katpodr.name, katpodrparent.name, em_catpodr.d0002
from katpodr inner join em_catpodr On em_catpodr.d0001=katpodr.FIO_GB
             inner join katpodr katpodrparent On em_catpodr.d0005=katpodrparent.FIO_GB
where katpodr.cpodr=0
;





// Загрузка подразделений  из КИС  в  Галактический  catalogs (Структура штатного расписания)
sql
insert into catalogs  (Name,  MAINLINK, GROUPCODE, SYSCODE, Code, DOPSTR, DATN, DATOK)
select
distinct
!em_catpodr1.D0002, em_catpodr1.D0003, 0,
case
     when length(em_catpodr1.D0003)=0  then 'ID_' + cast(em_catpodr1.D0001 as string)
     when length(em_catpodr1.D0003)<>0 then em_catpodr1.D0003
end
,CatalogsMain.nrec,  2, 0, em_catpodr1.d0002, em_catpodr1.d0001
,em_catpodr1.D0007 ,
case
     when em_catpodr1.D0010='Архивный' then Curdate
     when em_catpodr1.D0010<>'Архивный' then 0
end

from em_catpodr em_catpodr1 inner join catalogs catalogsmain On catalogsmain.syscode=-11

left join catalogs catalogs2 ON  em_catpodr1.D0001 = catalogs2.dopstr
left join em_person On em_catpodr1.D0001 = em_person.p0016
where   catalogs2.nrec is  null
        and em_person.p0001 is not null
        and  (length(em_catpodr1.D0002)>0 or length(em_catpodr1.D0003)>0)
;




// Загрузка иерархии подразделений  из КИС  в  Галактический  catalogs
sql
update catalogs set catalogs.cparent=catalogsparent.nrec
!select catalogs.name, catalogsparent.name, em_catpodr.d0002
from catalogs inner join catalogs catalogsmain On catalogsmain.nrec=catalogs.mainlink and  catalogsmain.syscode=-11
                    and catalogs.cparent=0
     inner join em_catpodr On em_catpodr.d0001=catalogs.dopstr
     inner join catalogs catalogsparent On em_catpodr.d0005=catalogsparent.dopstr
;




// Загрузка таблицы синхронизации между catalogs и KatPodr
!sql delete from  ExtCatLinks where  11 = ExtCatLinks.ObjType  and 1  = ExtCatLinks.ModType;

sql
insert into ExtCatLinks  (ObjType, ModType, StaffCat, extCat)
select  11, 1, catalogs.nrec, katpodr.nrec
from em_catpodr inner join catalogs ON  em_catpodr.d0001=catalogs.dopstr
inner join catalogs catalogsmain On catalogsmain.nrec=catalogs.mainlink and  catalogsmain.syscode=-11
inner join  Katpodr ON em_catpodr.D0001 = katpodr.FIO_GB
left join ExtCatLinks  On katpodr.nrec=ExtCatLinks.extcat
          and Catalogs.nrec=ExtCatLinks.Staffcat
          and  11 = ExtCatLinks.ObjType  and 1  = ExtCatLinks.ModType
where  length(catalogs.DOPSTR)>3
and ExtCatLinks.nrec is  null






