create table D_USER.EM_SNILS "Таблица EM_SNILS"
  using "EM_SNILS.dat"
!  component USER
  with table_Code = 31725
  with tableOptions header, journal, corpo
  (
   S0001 : LongInt "ID физического лица",
   S0002 : String [20] "СНИЛС",
   S0003 : LongInt "Код Документа"


  )
  with index
  (
   i_S0001=S0001,
   i_S0002=S0002,
   i_S0003=S0003

   );