sql


insert into Passports  (person,  NMB,  SysCode, DocName , SEQNMB)


select  persons.nrec, Em_INN.I0002, 505, catalogs.nrec, 2

FROM


catalogs catalogsmain inner join catalogs ON        catalogsmain.syscode=-3
                      and catalogs.lpr = 0   and catalogsmain.nrec = catalogs.mainlink
                      and catalogs.name='àçç'
       cross join em_Inn

       inner join persons  On em_Inn.I0001 = persons.DISPROFNMB
      left join Passports Passports1 On    em_Inn.I0001 = Passports1.person
                   and Passports1.sysCode = 505



and Passports1.nrec is NULL
;

