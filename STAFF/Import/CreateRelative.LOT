create table D_USER.EM_RELATIVE "Таблица EM_RELATIVE"
  using "EM_RELA.dat"
!  component USER
  with table_Code = 31723
  with tableOptions header, journal, corpo
  (
   R0001 : LongInt "ID физического лица",
   R0002 : String [60] "Степень родства",
   R0003 : String [60] "ФИО родственника",
   R0004 : Date "Дата рождения родственника",
   R0005 : LongInt "Дополнительное ID"


  )
  with index
  (
   i_R0001=R0001,
   i_R0002=R0002,
   i_R0003=R0003,
   i_R0004=R0004,
   i_R0005=R0005
   );
