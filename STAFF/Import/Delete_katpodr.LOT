sql
delete from katpodr where nrec in
(
select
katpodr.nrec
!count(*)
from katpodr
left join katpodr katpodrParent1 On katpodrParent1.Nrec=katpodr.cpodr
left join katpodr katpodrParent2 On katpodrParent2.Nrec=katpodrparent1.cpodr
left join katpodr katpodrParent3 On katpodrParent3.Nrec=katpodrparent2.cpodr
left join katpodr katpodrParent4 On katpodrParent4.Nrec=katpodrparent3.cpodr
left join katpodr katpodrParent5 On katpodrParent5.Nrec=katpodrparent4.cpodr
left join katpodr katpodrParent6 On katpodrParent6.Nrec=katpodrparent5.cpodr



where
!and length(katpodr.DOPSTR)=0
!and
(
katpodrparent1.name='Энергомаштест2' or
katpodrparent2.name='Энергомаштест2' or
katpodrparent3.name='Энергомаштест2' or
katpodrparent4.name='Энергомаштест2' or
katpodrparent5.name='Энергомаштест2' or
katpodrparent6.name='Энергомаштест2' or
katpodrparent1.name='Энергомаш' or
katpodrparent2.name='Энергомаш' or
katpodrparent3.name='Энергомаш' or
katpodrparent4.name='Энергомаш' or
katpodrparent5.name='Энергомаш' or
katpodrparent6.name='Энергомаш'
)

)
;