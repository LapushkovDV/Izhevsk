sql
delete from sumvidop;

sql
insert into sumvidop (vidopl, vidoplp, mesn, yearn, mes, yeark, summa,
                    chasf, koldn, chasgr, koldngr, clsch, filialno, tabn)
select klvidopl.vidopl, klvidopl.vidoplp, sr004, sr005, sr006, sr007, sr008,
sr009, sr010, sr011, sr012, lschet.nrec, sr013, sr001
from em_sumopl
left join em_person on em_person.p0001 = em_sumopl.sr013
inner join lschet on lschet.strtabn = '999999'
inner join klvidopl on klvidopl.vidoplp = em_sumopl.sr003
where klvidopl.vidopl <> 238
;

sql
update sumvidop set sumvidop.cex = lschet.cex, sumvidop.clsch = lschet.nrec,
                    sumvidop.tperson = lschet.tperson, sumvidop.sisopl = lschet.sisopl, sumvidop.strtabn = lschet.strtabn, sumvidop.cappoint = lschet.cappoint,
                    sumvidop.codtar = lschet.codtar, sumvidop.kateg = lschet.kateg, sumvidop.cexoz = lschet.cex, sumvidop.tarif = lschet.tarif
from sumvidop
inner join lschet on lschet.schp2 = sumvidop.filialno
where lschet.sovm = 2 or lschet.sovm = 3
;

sql
update sumvidop set sumvidop.cex = lschet.cex, sumvidop.clsch = lschet.nrec,
                    sumvidop.tperson = lschet.tperson, sumvidop.sisopl = lschet.sisopl, sumvidop.strtabn = lschet.strtabn, sumvidop.cappoint = lschet.cappoint,
                    sumvidop.codtar = lschet.codtar, sumvidop.kateg = lschet.kateg, sumvidop.cexoz = lschet.cex, sumvidop.tarif = lschet.tarif
from sumvidop
inner join em_person on em_person.p0001 = sumvidop.filialno and em_person.p0007 = 'Основное место работы'
inner join lschet on lschet.tabdop[10] = em_person.p0030
where lschet.sovm = 0
;

sql
update sumvidop set sumvidop.cex = lschet.cex, sumvidop.clsch = lschet.nrec,
                    sumvidop.tperson = lschet.tperson, sumvidop.sisopl = lschet.sisopl, sumvidop.strtabn = lschet.strtabn, sumvidop.cappoint = lschet.cappoint,
                    sumvidop.codtar = lschet.codtar, sumvidop.kateg = lschet.kateg, sumvidop.cexoz = lschet.cex, sumvidop.tarif = lschet.tarif
from sumvidop
inner join em_person on em_person.p0001 = sumvidop.filialno and em_person.p0007 = 'Внешнее совместительство'
inner join lschet on lschet.tabdop[10] = em_person.p0030
where lschet.sovm = 1
;

sql
update sumvidop set sumvidop.yeark = sumvidop.yearn
from sumvidop
where  sumvidop.yeark = 0
;

