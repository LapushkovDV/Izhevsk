
sql
insert into catalogs (name, mainlink, cparent)
select  em_disp.COLLECTTYPE, catalogsmain.nrec, catalogsparent.nrec
from em_disp inner join catalogs catalogsmain On catalogsmain.syscode=58
inner join catalogs catalogsparent ON catalogsparent.syscode=-77
left join catalogs catalogsold On catalogsold.name=em_disp.COLLECTTYPE  and length(em_disp.COLLECTTYPE)>0
left join catalogs catalogsoldmain On catalogsoldmain.nrec=catalogsold.mainlink and catalogsoldmain.syscode=58
left join catalogs catalogsoldparent ON catalogsoldparent.nrec=catalogsold.cparent and catalogsoldparent.syscode=-77
where catalogsold.nrec is  null
;





sql
insert into catalogs (name, mainlink, cparent)
select  distinct em_disp.EVENTTYPE, catalogsmain.nrec, catalogsparent.nrec
from em_disp inner join catalogs catalogsmain On catalogsmain.syscode=58
inner join catalogs catalogsparent ON catalogsparent.syscode=-79
left join catalogs catalogsold On catalogsOld.name=em_disp.EVENTTYPE      and length(em_disp.EVENTTYPE)>0
left join catalogs catalogsoldmain On catalogsoldmain.nrec=catalogsold.mainlink and catalogsoldmain.syscode=58
left join catalogs catalogsoldparent ON catalogsoldparent.nrec=catalogsold.cparent and catalogsoldparent.syscode=-79
where catalogsold.nrec is   null
;






sql delete from PUNISHMENTS;


sql
insert into PUNISHMENTS (cpsn, cptype, docnmb, dat1,  cref2)

select
persons.nrec, catalogs1.nrec, substring(em_disp.BASICDOC,1,20), em_disp.EVENTDATE,  catalogs2.nrec
from em_disp inner join   persons On persons.disprofnmb=em_disp.CITEZENID

left join catalogs catalogs1 On catalogs1.name=em_disp.COLLECTTYPE  and length(em_disp.COLLECTTYPE)>0
left join catalogs catalogs1main On catalogs1main.nrec=catalogs1.mainlink and catalogs1main.syscode=58
left join catalogs catalogs1parent ON catalogs1parent.nrec=catalogs1.cparent and catalogs1parent.syscode=-77


left join catalogs catalogs2 On catalogs2.name=em_disp.EVENTTYPE and length(em_disp.EVENTTYPE)>0
left join catalogs catalogs2main On catalogs2main.nrec=catalogs2.mainlink and catalogs2main.syscode=58
left join catalogs catalogs2parent ON catalogs2parent.nrec=catalogs2.cparent and catalogs2parent.syscode=-79

/*
left join  PUNISHMENTS  PUNISHMENTS1 On  PUNISHMENTS1.cpsn=persons.nrec
left join catalogs catalogs3 On catalogs3.name=em_disp.COLLECTTYPE and length(em_disp.COLLECTTYPE)>0
left join catalogs catalogs3main On catalogs3main.nrec=catalogs3.mainlink and catalogs3main.syscode=58
left join catalogs catalogs3parent ON catalogs3parent.nrec=catalogs3.cparent and catalogs3parent.syscode=-77
     and PUNISHMENTS1.cptype=catalogs3.nrec

where PUNISHMENTS1.nrec is null
*/
;










