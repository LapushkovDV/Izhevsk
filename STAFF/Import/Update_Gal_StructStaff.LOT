
sql
!update historystr set historystr.STAFFSTR=staffstruct.nrec
select staffstruct.dinput, staffstruct.dclose, staffstructdel.dinput, staffstructdel.dclose, staff.seqnmb,staff_count
from staffstruct inner join
(
select Department, Post, Tariff, max(staffstruct.SEQNMB) seqnmb , count(*) staff_count
from staffstruct inner join catalogs On catalogs.nrec = staffstruct.department  //and catalogs.name='Военно- мобилизационное бюро'

group by Department, Post, tariff

) staff on staff.department=staffstruct.department and staff.post=staffstruct.post
and staff.tariff=staffstruct.tariff and staff.seqnmb = staffstruct.seqnmb
inner join staffstruct staffstructDel
      On staffstruct.department=staffstructdel.department and staffstruct.post=staffstructdel.post and staffstruct.nrec <> staffstructDel.nrec
inner join catalogs On catalogs.nrec = staffstruct.department  and catalogs.code='620-4'
inner join historystr On historystr.STAFFSTR=staffstructdel.nrec
;


