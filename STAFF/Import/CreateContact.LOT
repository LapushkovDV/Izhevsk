create table D_USER.EM_CONTACT "Таблица EM_CONTACT"
  using "EM_CONT.dat"
!  component USER
  with table_Code = 31711
  with tableOptions header, journal, corpo
  (
   C0001 : LongInt "ID физического лица",
   C0002 : String [255] "Тип телефона",
   C0003 : String [255] "Номер телефон"


  )
  with index
  (
   i_C0001=C0001,
   i_C0002=C0002,
   i_C0003=C0003

   );