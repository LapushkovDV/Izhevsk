
sql
select distinct p1.p0002
from (
     select p0002, count(*) count1 from em_person where p0011<>0 and (p0007='Основное место работы'
                                                                 or   p0007='Внешнее совместительство'
                                                                 or   p0007='Админ. отпуск')
     group by p0002
     ) p1
     inner join
     (
     select p0002, count(*) count1 from em_person where p0011<>0 and (p0007='Основное место работы'
                                                                 or   p0007='Внешнее совместительство'
                                                                 or   p0007='Админ. отпуск')
     group by p0002, p0011
     ) p2
     On p1.p0002=p2.p0002 and  p1.count1<>p2.count1
to dbf Z:\Import\Source\Persons_with_several_dissdate.xls
;


!sql select distinct p0007 from em_person;