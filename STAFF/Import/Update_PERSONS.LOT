sql
update persons set PERSONS.TESTPERIOD  = em_person.p0027
from persons
inner join em_person on em_person.p0030 = Persons.DISPROFNMB
                   and (PERSONS.TESTPERIOD<>em_person.p0027 and PERSONS.TESTPERIOD=#Date(0,0,0) )
;