sql
update persons set persons.education = catalogs.nrec
from em_person inner join catalogs catalogsVr on catalogsVr.name = em_person.p0014  and catalogsVr.mainLink=0
inner join catalogs  On catalogsVr.cref2  = catalogs.nrec
inner join persons on em_person.p0001 = persons.filialno
where em_person.p0014<>''
;

