sql
update persons set persons.dismotive = catalogs.nrec
from catalogs
inner join em_person on catalogs.name = em_person.p0010
inner join persons on em_person.p0001 = persons.filialno
inner join catalogs catalogsMain On catalogs.MainLink=CatalogsMain.nrec and catalogsmain.syscode=-121
;

!„€‡„…‹…ˆ…
sql
update persons set persons.galdep = katpodr.nrec
from persons
inner join catalogs On catalogs.nrec = persons.department
inner join extcatlinks on extcatlinks.staffcat = catalogs.nrec
inner join katpodr on katpodr.nrec = extcatlinks.extcat
;

