sql

/*
select staffstruct.department, ststructup1.department, ststructup2.department
from staffstruct
left join attrval on staffstruct.nrec = attrval.crec and attrval.wtable = 25018
left join staffstruct ststructup1 on attrval.vcomp = ststructup1.nrec
left join attrval attrvalup1 on ststructup1.nrec = attrvalup1.crec
left join staffstruct ststructup2 on attrvalup1.vcomp = ststructup2.nrec
*/

update em_catpodr set em_catpodr.D0011 = katp.kd
!select katp.D0001, katp.kd, em_catpodr.D0011
from
(
select em_catpodr.D0001, em_catpodr.D0002, em_catDown1.D0002, em_catDown2.D0002, em_catDown3.D0002, em_catpodr.D0011, em_catDown1.D0011, em_catDown2.D0011,  em_catDown3.D0011,
case when length(em_catDown1.D0011)>1 then em_catDown1.D0011 else
case when length(em_catDown2.D0011)>1 then em_catDown2.D0011 else em_catDown3.D0011 end end kd
from em_catpodr
left join em_catpodr em_catDown1 on em_catpodr.D0006 = em_catDown1.D0002 and length(em_catpodr.D0006) >1
left join em_catpodr em_catDown2 on em_catDown1.D0006 = em_catDown2.D0002 and length(em_catDown1.D0006) >1
left join em_catpodr em_catDown3 on em_catDown2.D0006 = em_catDown3.D0002 and length(em_catDown2.D0006) >1
!left join em_catpodr em_catDown4 on em_catDown3.D0006 = em_catDown4.D0002 and length(em_catDown3.D0006) >1
where em_catpodr.D0010 <> 'Архивный'
and em_catpodr.D0011=0
!order by em_catpodr.D0002
) katp  inner join em_catpodr On em_catpodr.d0001=katp.d0001  and em_catpodr.D0011=0
where kd <>0
;


