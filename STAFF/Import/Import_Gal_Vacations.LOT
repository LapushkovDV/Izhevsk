

sql
update em_vacations set  em_vacations.v0010= klotpusk1.KOTPUS
from em_vacations inner join klotpusk klotpusk1 On klotpusk1.notpus=em_vacations.v0008
;


sql update  em_vacations set  em_vacations.v0010= 80 where em_vacations.v0008='Дополнительный отпуск за "Байконур"' ;
sql update  em_vacations set  em_vacations.v0010= 82 where em_vacations.v0008='Дополнительный отпуск мед. работникам';
sql update  em_vacations set  em_vacations.v0010= 83 where em_vacations.v0008='Дополнительный отпуск на 1 сентября (по Кол. договору)' ;
sql update  em_vacations set  em_vacations.v0010= 84 where em_vacations.v0008='Дополнительный отпуск на похороны (по Кол. договору)';
sql update  em_vacations set  em_vacations.v0010= 86 where em_vacations.v0008='Дополнительный отпуск на свадьбу (по Кол. договору)' ;
sql update  em_vacations set  em_vacations.v0010= 87 where em_vacations.v0008='Дополнительный отпуск на свадьбу детей';
sql update  em_vacations set  em_vacations.v0010= 89 where em_vacations.v0008='Дополнительный отпуск станочникам (по Кол. договору)' ;
sql update  em_vacations set  em_vacations.v0010= 1 where  em_vacations.v0008='Ежегодный отпуск' ;
sql update  em_vacations set  em_vacations.v0010= 5 where  em_vacations.v0008='Отпуск  по  беременности  и  родам (отпуск в связи с усыновлением новорожденного ребенка)';
sql update  em_vacations set  em_vacations.v0010= 4 where  em_vacations.v0008='Отпуск без сохранения заработной платы матерям, имеющим детей в возрасте до 3 лет' ;
sql update  em_vacations set  em_vacations.v0010= 21 where em_vacations.v0008='Отпуск без сохранения заработной платы, предоставленный работнику по разрешению работодателя';
sql update  em_vacations set  em_vacations.v0010= 2 where  em_vacations.v0008='Отпуск женщинам, имеющим детей в возрасте до 1,5 лет' ;
sql update  em_vacations set  em_vacations.v0010= 22 where em_vacations.v0008='Учебный отпуск';


// синхронизация отпусков в factotpusk  и в vacations




!sql delete  from factotpusk where nrec in (select nrec from factOtpusk factOtpusk1 inner join em_vacations On em_vacations.atl_nrec=factotpusk1.nrec);




