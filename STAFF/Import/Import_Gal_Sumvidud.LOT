sql
delete from sumvidud;

sql
insert into sumvidud (vidud, vidudp, mesn, yearn, mes, yeark, sumud, cex, clsch,
                 tperson, strtabn, cappoint, codtar, kateg)

select klvidud.vidud, klvidud.vidudp, nl004, nl005, nl006, nl007, nl008, lschet.cex, lschet.nrec,
lschet.tperson, lschet.strtabn,
lschet.cappoint,lschet.codtar, lschet.kateg
from em_ndfl
inner join em_person on em_person.p0001 = em_ndfl.nl009
inner join lschet on lschet.schp2 = em_person.p0001
inner join klvidud on klvidud.vidudp = em_ndfl.nl003
where lschet.sovm = 2 or lschet.sovm = 3
;

sql
insert into sumvidud (vidud, vidudp, mesn, yearn, mes, yeark, sumud, cex, clsch,
                 tperson, strtabn, cappoint, codtar, kateg)

select klvidud.vidud, klvidud.vidudp, nl004, nl005, nl006, nl007, nl008, katpodr.nrec, lschet.nrec,
lschet.tperson, lschet.strtabn,
appointments.post, tarstav.codtar, klkatego.kod
from em_ndfl
inner join em_person on em_person.p0001 = em_ndfl.nl009  and em_person.p0007 = 'Основное место работы'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidud on klvidud.vidudp = em_ndfl.nl003
inner join appointments on appointments.cref3 = em_ndfl.nl009
inner join catalogs On catalogs.nrec = appointments.department
inner join extcatlinks on extcatlinks.staffcat = catalogs.nrec
inner join katpodr on katpodr.nrec = extcatlinks.extcat and katpodr.isarch = 0
inner join klkatego on klkatego.nrec = appointments.empcategory
inner join tarstav on tarstav.nrec = appointments.tariff
where lschet.sovm = 0
;

sql
insert into sumvidud (vidud, vidudp, mesn, yearn, mes, yeark, sumud, cex, clsch,
                 tperson, strtabn, cappoint, codtar, kateg)

select klvidud.vidud, klvidud.vidudp, nl004, nl005, nl006, nl007, nl008, katpodr.nrec, lschet.nrec,
lschet.tperson, lschet.strtabn,
appointments.post, tarstav.codtar, klkatego.kod
from em_ndfl
inner join em_person on em_person.p0001 = em_ndfl.nl009  and em_person.p0007 = 'Внешнее совместительство'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidud on klvidud.vidudp = em_ndfl.nl003
inner join appointments on appointments.cref3 = em_ndfl.nl009
inner join catalogs On catalogs.nrec = appointments.department
inner join extcatlinks on extcatlinks.staffcat = catalogs.nrec
inner join katpodr on katpodr.nrec = extcatlinks.extcat  and katpodr.isarch = 0
inner join klkatego on klkatego.nrec = appointments.empcategory
inner join tarstav on tarstav.nrec = appointments.tariff
where lschet.sovm = 1
;

sql
insert into sumvidud (vidud, vidudp, mesn, yearn, sumud, cex, clsch,
                 tperson, strtabn, cappoint, codtar, kateg)

select distinct 220, 999, sr004, sr005, sr015, lschet.cex, lschet.nrec,
lschet.tperson, lschet.strtabn, lschet.cappoint,lschet.codtar, lschet.kateg
from em_sumopl
inner join em_person on em_person.p0001 = em_sumopl.sr013
inner join lschet on lschet.schp2 = em_person.p0001
inner join klvidopl on klvidopl.vidoplp = em_sumopl.sr003
where lschet.sovm = 2 or lschet.sovm = 3
;

sql
insert into sumvidud (vidud, vidudp, mesn, yearn, sumud, cex, clsch,
                 tperson, strtabn, cappoint, codtar, kateg)

select distinct 220, 999, sr004, sr005, sr015, lschet.cex, lschet.nrec,
lschet.tperson, lschet.strtabn, lschet.cappoint,lschet.codtar, lschet.kateg
from em_sumopl
inner join em_person on em_person.p0001 = em_sumopl.sr013  and em_person.p0007 = 'Основное место работы'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidopl on klvidopl.vidoplp = em_sumopl.sr003
inner join appointments on appointments.cref3 = em_sumopl.sr013
inner join katpodr on katpodr.kod = cast(em_sumopl.sr016 as string) and katpodr.isarch = 0
inner join klkatego on klkatego.nrec = appointments.empcategory
inner join tarstav on tarstav.nrec = appointments.tariff
where lschet.sovm = 0
;

sql
insert into sumvidud (vidud, vidudp, mesn, yearn, sumud, cex, clsch,
                 tperson, strtabn, cappoint, codtar, kateg)

select distinct 220, 999, sr004, sr005, sr015, lschet.cex, lschet.nrec,
lschet.tperson, lschet.strtabn, lschet.cappoint,lschet.codtar, lschet.kateg
from em_sumopl
inner join em_person on em_person.p0001 = em_sumopl.sr013  and em_person.p0007 = 'Внешнее совместительство'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidopl on klvidopl.vidoplp = em_sumopl.sr003
inner join appointments on appointments.cref3 = em_sumopl.sr013
inner join katpodr on katpodr.kod = cast(em_sumopl.sr016 as string) and katpodr.isarch = 0
inner join klkatego on klkatego.nrec = appointments.empcategory
inner join tarstav on tarstav.nrec = appointments.tariff
where lschet.sovm = 1
;

sql
update sumvidud set sumvidud.yeark = sumvidud.yearn
from sumvidud
where sumvidud.yeark = 0
;

sql
update sumvidud set sumvidud.mes = sumvidud.mesn
from sumvidud
where sumvidud.mes = 0
;

sql
update sumvidud set sumvidud.yearv = sumvidud.yearn
from sumvidud
where sumvidud.yearv = 0
;

sql
update sumvidud set sumvidud.mesv = sumvidud.mesn
from sumvidud
where sumvidud.mesv = 0
;
