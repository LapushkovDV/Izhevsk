sql
insert into shtraf (vidud, sumud, paynum, fio, nomlsh, nomcard, proc, udches, udznam, cex, clsch,
                   tperson, strtabn, datansk, datok)

select distinct klvidud.vidud, il004, il006, il0014, il0015, il0016, il0022, il0028,
il0029, lschet.cex, lschet.nrec, lschet.tperson, lschet.strtabn, il0020, il0021
from em_isplist
inner join em_person on em_person.p0001 = em_isplist.il0031
inner join lschet on lschet.schp2 = em_person.p0001
inner join klvidud on klvidud.vidudp = em_isplist.il003
where lschet.sovm = 2 or lschet.sovm = 3
;

sql
insert into shtraf (vidud, sumud, paynum, fio, nomlsh, nomcard, proc, udches, udznam, cex, clsch,
                   tperson, strtabn, datansk, datok)

select distinct klvidud.vidud, il004, il006, il0014, il0015, il0016, il0022, il0028,
