delete all from shtraf;

sql
insert into shtraf (vidud, sumud, proc, cex, clsch,
                tperson, strtabn, datansk, datok )

select distinct klvidud.vidud, sh004, sh005, lschet.cex, lschet.nrec,
lschet.tperson, lschet.strtabn, sh006, sh007
from em_shtraf
inner join em_person on em_person.p0001 = em_shtraf.sh008
inner join lschet on lschet.schp2 = em_person.p0001
inner join klvidud on klvidud.vidudp = em_shtraf.sh003
where lschet.sovm = 2 or lschet.sovm = 3
;

sql
insert into shtraf (vidud, sumud, proc, cex, clsch,
                tperson, strtabn, datansk, datok )

select distinct klvidud.vidud, sh004, sh005, lschet.cex, lschet.nrec,
lschet.tperson, lschet.strtabn, sh006, sh007
from em_shtraf
inner join em_person on em_person.p0001 = em_shtraf.sh008  and em_person.p0007 = 'Основное место работы'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidud on klvidud.vidudp = em_shtraf.sh003
where lschet.sovm = 0
;

sql
insert into shtraf (vidud, sumud, proc, cex, clsch,
                tperson, strtabn, datansk, datok )

select distinct klvidud.vidud, sh004, sh005, lschet.cex, lschet.nrec,
