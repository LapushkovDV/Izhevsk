sql
update lschet set lschet.avplan = em_shtraf.sh004
from em_shtraf
inner join em_person on em_person.p0001 = em_shtraf.sh008
inner join lschet on lschet.schp2 = em_person.p0001
inner join klvidud on klvidud.vidudp = em_shtraf.sh003
where (lschet.sovm = 2 or lschet.sovm = 3) and klvidud.vidudp = 226
;

sql
update lschet set lschet.avplan = em_shtraf.sh004
from em_shtraf
inner join em_person on em_person.p0001 = em_shtraf.sh008  and em_person.p0007 = 'Основное место работы'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidud on klvidud.vidudp = em_shtraf.sh003
where lschet.sovm = 0  and klvidud.vidudp = 226
;

sql
update lschet set lschet.avplan = em_shtraf.sh004
from em_shtraf
inner join em_person on em_person.p0001 = em_shtraf.sh008  and em_person.p0007 = 'Внешнее совместительство'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidud on klvidud.vidudp = em_shtraf.sh003
where lschet.sovm = 1  and klvidud.vidudp = 226
;

sql
update shtraf set shtraf.sumud = 0
from shtraf
where shtraf.vidud = 141
;

sql
update shtraf set shtraf.pometka = 'AR'
from shtraf
where shtraf.datok <= #date(30,09,2017) and shtraf.datok <> 0
;

sql
insert into sys_dog (tblk[1], ckauk[1])
select 15008, shtraf.nrec
from shtraf
where shtraf.pometka = 'AR'
;