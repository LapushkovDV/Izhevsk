!  Загрузка в catalogs видов повышения квалификации

sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name)
select distinct catalogskisparent.nrec, catalogskisparent.nrec, 0, 0, RETR_TYPE
from em_retrainig Ed
inner join catalogs catalogskisParent On  catalogsKisParent.Syscode=703
where length(RETR_TYPE)>0 and length(id)>1
and RETR_TYPE not in
(
select distinct RETR_TYPE education
from
EM_retrainig  Ed inner join catalogs catalogsKis On CatalogsKis.Name= Ed.RETR_TYPE
inner join catalogs catalogskisParent On catalogsKis.cparent=CatalogsKisParent.nrec and catalogsKisParent.Syscode=703

)
;





// Предварительная загрузка в catalogs  видов документов об образовании


sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name)
select distinct catalogsKisMain.nrec, catalogsKisMain.nrec, 0, 0, Ed.doctype
from em_RETRAINIG Ed inner join catalogs catalogskisMain   On catalogsKisMain.Syscode=-5
where length(Ed.doctype)>0 and length(id)>1
and  Ed.DocType not in
(
select distinct ed.doctype education
from
EM_RETRAINIG  Ed inner join catalogs On Catalogs.Name= Ed.doctype
inner   join catalogs catalogsMainLink ON catalogsMainLink.syscode=-5 and catalogsMainlink.nrec = Catalogs.mainlink
)
and length(ed.doctype)>0
;





// Предварительная загрузка в catalogs -  Учебные заведения
sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name)
select distinct catalogsKisMain.nrec, catalogsKisMain.nrec, 0, 0, Ed.Name
from EM_RETRAINIG Ed inner join catalogs catalogskisMain   On catalogsKisMain.Syscode=-24
where    Ed.name not in
(
select distinct Ed.Name
from
EM_RETRAINIG  Ed inner join catalogs On Catalogs.Name= Ed.name
inner   join catalogs catalogsMainLink ON catalogsMainLink.syscode=-24 and catalogsMainlink.nrec = Catalogs.mainlink
)
and length(Ed.name)>0
;




// Предварительная загрузка в catalogs -  Специальность
sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name)
select   distinct catalogs.nrec, catalogs.nrec, 0, 0, JOBTITLE
from EM_RETRAINIG inner join catalogs  On catalogs.Syscode=-32

where jobtitle not  in
(
select distinct JOBTITLE
from
EM_retrainig  Ed inner join catalogs On Catalogs.Name= Ed.JOBTITLE
inner   join catalogs catalogsMainLink ON catalogsMainLink.syscode=-32 and catalogsMainlink.nrec = Catalogs.mainlink
)
and length(em_retrainig.JOBTITLE)>0
;



// Загрузка в Галактический Education

!delete all from education where wtype=3;

sql
insert into  education (WTYPE, person, level, seqnmb, name, SPECIALITY, DIPLOMNMB, DIPLOMDATE, Fromdate, Todate )
select distinct  3,persons.nrec, CatalogsLevel.nrec, CatalogsDiplom.code, CatalogsVuz.nrec, CatalogsSpec.nrec, ed.DOCNUMB,
ed.DOCDATE,
ed.INDATE, ed.OUTDATE
from persons inner join  em_person   On Persons.DISPROFNMB = Em_person.P0030
     inner join em_retrainig Ed ON Ed.CITEZENID=Em_person.P0030
     inner join catalogs CatalogsLevelmain On CatalogsLevelmain.syscode=703
     inner join catalogs CatalogsDiplomMain On CatalogsDiplomMain.syscode=-5
     inner join catalogs CatalogsVuzMain  On CatalogsVuzMain.syscode=-24
     inner join catalogs CatalogsSpecMain  On CatalogsSpecMain.syscode=-32
!     inner join catalogs CatalogsModeMain  On CatalogsModeMain.syscode=-15
     left  join catalogs Catalogslevel On Catalogslevel.name=Ed.RETR_TYPE and CatalogsLevel.mainlink=CatalogsLevelMain.nrec
     left  join catalogs CatalogsDiplom On CatalogsDiplom.name=Ed.doctype and CatalogsDiplom.mainlink=CatalogsDiplomMain.nrec
     left  join catalogs CatalogsVuz On CatalogsVuz.name=Ed.name and CatalogsVuz.mainlink=CatalogsVuzMain.nrec
     left  join catalogs CatalogsSpec On CatalogsSpec.name=Ed.JOBTITLE and CatalogsSpec.mainlink=CatalogsSpecMain.nrec
!     left  join catalogs CatalogsMode On CatalogsMode.name=Ed.E0009 and CatalogsMode.mainlink=CatalogsModeMain.nrec
where (CatalogsLevel.Nrec is not null and CatalogsDiplom.Nrec is not null or CatalogsVuz.Nrec is not null or CatalogsSpec.Nrec is not null)
!and persons.fio='Кисляков Василий Борисович'
;


