
//Удаление таблиц объединения для профессий //BEGIN
sql delete from joihead where typeevent=14978;


sql
delete spjoi where nrec in (
select spjoi.nrec
from spjoi left join joihead On joihead.nrec=spjoi.cjoihead
where joihead.nrec is null
)
;


// Вставка профессий, которые останутся в заголовок

sql
insert into joihead (typeevent, crec,username, status)
select
14978, min(catalogsPost.Nrec), 'aleks.pomerantsev', 0
!catalogsPost.name, min(catalogsPost.Nrec) catalogsPostNrec
from catalogs catalogsPost inner join catalogs catalogsPostMain On CatalogsPostMain.nrec=CatalogsPost.mainlink
inner join catalogs CatalogsPostParent On catalogsPostParent.nrec=catalogsPost.cparent
where catalogsPostParent.syscode=49  and catalogsPostmain.syscode=9004
group by catalogsPost.name
having count(*)>1



// Вставка профессий, которые будут удалены в спецификацию

sql
insert into spjoi (cjoihead, crec, isdel)
select
joihead.nrec, catalogsPost.Nrec, 1
!catalogsPost.name, catalogsPost.Nrec
from joihead inner join catalogs On catalogs.nrec=joihead.crec and joihead.typeevent=14978
inner join catalogs catalogsPost  On catalogsPost.Name=catalogs.name    and catalogsPost.nrec<>joihead.crec
inner join catalogs catalogsPostMain On CatalogsPostMain.nrec=CatalogsPost.mainlink
inner join catalogs CatalogsPostParent On catalogsPostParent.nrec=catalogsPost.cparent
where  catalogsPostParent.syscode=49  and catalogsPostmain.syscode=9004
;
//Удаление таблиц объединения для профессий //END


