create table D_USER.EM_TRPODR "Таблица EM_TRPODR"
  using "EM_TRP.dat"

  with table_Code = 31751
  with tableOptions header, journal, corpo
  (
   A0001 : String [255] "Наименование подразделения",
   A0002 : String [255] "Вид производства",
   A0003 : String [10] "Код подразделения"
  )
  with index
  (
   i_A0001=A0001,
   i_A0002=A0002,
   i_A0003=A0003
  );