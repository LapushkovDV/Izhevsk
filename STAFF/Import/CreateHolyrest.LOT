create table D_USER.EM_HOLYREST "Таблица EM_HOLYREST"
  using "EM_HOLY.dat"
!  component USER
  with table_Code = 31739
  with tableOptions header, journal, corpo
  (
   CITEZENID   : LongInt "ID физического лица",
   DCODE       : String[10] "Код отпуска",
   LATSTNAME   : String[100] "Фамилия",
   NAME        : string[100] "Имя",
   FATHERSHIP  : string[100] "Отечество",
   RESTNUMB    : double  "Остаток дней отпуска"
  )
  with index
  (
   i_CITEZENID  =CITEZENID  ,
   i_DCODE      =DCODE      ,
   i_LATSTNAME  =LATSTNAME  ,
   i_NAME       =NAME       ,
   i_FATHERSHIP =FATHERSHIP ,
   i_RESTNUMB   =RESTNUMB
  )
;
