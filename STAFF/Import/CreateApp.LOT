create table D_USER.EM_App "Таблица EM_APP"
  using "EM_APP.dat"
!  component USER
  with table_Code = 31747
  with tableOptions header, journal, corpo
  (
   Nrec : Comp "Номер Записи",
   AppointDate : Date "Дата назначения",
   statusapp : word "Статус"
  )
  with index
  (
   i_Nrec=Nrec,
   i_AppointDate=AppointDate,
   i_StatusApp=StatusApp
  )
;