/*

!update appointments set appointments.cdopinf = tlast.id
!select top 100  ids, id2 , idd1, id, date1, date2, p1, d1, ps1
!from
!(

select  table1.first_nrec First_nrec1,
table1.Last_nrec,
!table2.first_nrec First_nrec2, table2.Last_nrec Last_Nrec2,
table1.MinDissmissdate  MinDissmissdate1, table1.MaxDissmissdate MaxDissmissdate1
!table2.MinDissmissdate MinDissmissdate2, table2.MaxDissmissdate MaxDissmissdate2
,delta
from
(
        select appmin.nrec_first first_nrec, appmax.nrec_last last_nrec, appmin.pers1 pers1, appmin.dept1 dept1, appmin.post1 post1, MinDissmissdate, fio1
        , MaxDissmissdate, (to_days(datetime(MaxDissmissdate,0))-to_days(datetime(MinDissmissdate,0))) delta
        from
        (
                select appointments.nrec nrec_first, MinDissmissdate, apps1.pers1 pers1, apps1.dept1 dept1, apps1.post1 post1, fio1
                from appointments inner join
                (
                        select appointments.person pers1, appointments.department dept1, appointments.post post1, min(appointments.appointdate) MinDissmissdate, min(persons.fio) fio1
                        from appointments
                        inner join persons On persons.nrec=appointments.person
                        where appointments.statusapp = 3 and appointments.lprizn = 0
                        group by appointments.person, appointments.department, appointments.post
                ) apps1 on appointments.person = apps1.pers1 and appointments.department = apps1.dept1 and appointments.post = apps1.post1
                        and appointments.statusapp = 3 and appointments.lprizn = 0
        ) appmin inner join
        (
                select appointments.nrec nrec_last, apps2.pers2 per2, apps2.dept2 dept2, apps2.post2 post2, MaxDissmissdate, fio2
                from appointments inner join
                (
                        select appointments.person pers2, appointments.department dept2, appointments.post post2, max(appointments.dismissdate) MaxDissmissdate, min(fio) fio2
                        from appointments
                        inner join persons On persons.nrec=appointments.person
                        where appointments.statusapp = 3 and appointments.lprizn = 0
                        group by appointments.person, appointments.department, appointments.post
                ) apps2 on appointments.person = apps2.pers2 and appointments.department = apps2.dept2 and appointments.post = apps2.post2 and appointments.statusapp = 3 and appointments.lprizn = 0
        ) appmax on appmin.pers1 = appmax.per2 and appmin.dept1 = appmax.dept2 and appmin.post1 = appmax.post2
        where fio1='Козлов Леонид Леонидович' and fio2='Козлов Леонид Леонидович'
)table1
order by  table1.Last_nrec, delta



inner join

(
        select min(tmin.nrec_first) idd1, min(tmax.nrec_last) idd2, tmin.per1 p2, tmin.dep1 d2, tmin.pos1 ps2, min(tmax.date2-tmin.date1) deltamin from
        (
                select appointments.nrec nrec_first, date1, apps1.pers1 per1, apps1.dept1 dep1, apps1.post1 post1
                from appointments inner join
                (
                        select appointments.person pers1, appointments.department dept1, appointments.post post1, min(appointments.appointdate) date1
                        from appointments where appointments.statusapp = 3 and appointments.lprizn = 0
                        group by appointments.person, appointments.department, appointments.post
                ) apps1 on appointments.person = apps1.pers1 and appointments.department = apps1.dept1 and appointments.post = apps1.post1 and appointments.statusapp = 3 and appointments.lprizn = 0
        ) tmin inner join
        (
                select appointments.nrec nrec_last, date2, apps2.pers2 per2, apps2.dept2 dep2, apps2.post2 pos2
                from appointments inner join
                (
                        select appointments.person pers2, appointments.department dept2, appointments.post post2, max(appointments.dismissdate) date2
                        from appointments where appointments.statusapp = 3 and appointments.lprizn = 0
                        group by appointments.person, appointments.department, appointments.post
                ) apps2 on appointments.person = apps2.pers2 and appointments.department = apps2.dept2 and appointments.post = apps2.post2 and appointments.statusapp = 3 and appointments.lprizn = 0
        ) tmax on tmin.per1 = tmax.per2 and tmin.dep1 = tmax.dep2 and tmin.pos1 = tmax.pos2
        group by tmin.per1, tmin.dep1, tmin.pos1
) table2 on table1.p1 = table2.p2 and table1.d1 = table2.d2 and table1.ps1 = table2.ps2 and table1.delta = table2.deltamin

) tlast inner join appointments on appointments.nrec = tlast.ids and appointments.dismissdate = tlast.date2
inner join persons On persons.nrec=appointments.person
      and persons.fio='Козлов Леонид Леонидович'
//and appointments.person = tlast.p1 and appointments.department = tlast.d1 and appointments.post = tlast.ps1

;


