/*
// Вставка договоров в те appointments где нет исходных данных (договора берутся из предыдущих appoinrtements)
sql
select
appointments.nrec, appointments.resword[20]
!,min(persons.fio)//,  appointments.resword[20], appointmentsLess.resword[20]
!,min(appointments.resword[20]- appointmentsLess.resword[20]) as minrazn
from appointments left join spallstaff On appointments.rescomp[1]=spallstaff.nrec and spallstaff.Wnocon=5
inner join appointments appointmentsLess On appointmentsLess.resword[20]<appointments.resword[20]
left join spallstaff spallstaffLess On appointments.rescomp[1]=spallstaffLess.nrec and spallstaffLess.Wnocon=5
inner join persons On persons.nrec=appointments.person
where fio='Потаенко Алексей Михайлович'
and appointments.lprizn<>3 and appointmentsLess.lprizn<>3
and appointments.person=appointmentsLess.person
and  spallstaffLess.nrec is not null
and  spallstaff.nrec is null
!group by appointments.nrec, appointments.resword[20] //,  appointments.resword[20]- appointmentsLess.resword[20]
!order by persons.fio, appointments.resword[20], appointmentsLess.resword[20]
!length(appointments.contractnmb) =0 or appointments.contractdate=#date(0,0,0)
;
*/



