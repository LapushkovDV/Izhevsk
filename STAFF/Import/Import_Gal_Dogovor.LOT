/*
// Вставка трудовых договоров, привязанных к сотрудникам

sql
insert into spallstaff
(Wnocon, cbaset, rescomp[1], resdate[1], resdate[3], resdate[4], resstring[1], wchoise)
select
!count(*)
!5,  persons.nrec,  apphist.nrec,  catalogsdog.nrec, em_person.p0036, appointments.appointdate, 0, 0, em_person.p0035, '25062'
distinct 5,  persons.nrec,   catalogsdog.nrec, em_person.p0036, 0, 0, em_person.p0035, '25062'
from em_person inner join appointments On appointments.cref3=em_person.p0001 and appointments.appointdate=em_person.p0003
!      and appointments.statusapp=0
inner join persons On persons.nrec=appointments.person
inner join apphist On apphist.cappoint=appointments.nrec
inner join catalogs catalogsDog On catalogsDog.name='Трудовой'
inner join catalogs catalogsDogMain On catalogsDogMain.nrec=catalogsDog.mainlink and catalogsDogMain.syscode=-133
left join  spallstaff spallstaffold on  spallstaffold.resstring[1]=em_person.p0035 and  spallstaffold.Wnocon=5 and spallstaffold.cbaset=persons.nrec
where (length(p0035)>0 or p0036<>0)
and    spallstaffold.nrec is  null
!and persons.fio='Козлов Николай Петрович'
and fio='Потаенко Алексей Михайлович'
;
*/


/*
// Привязка трудовых договоров к истории назначений по сотрудникам
sql
update apphist set apphist.cspr3=spallstaff.nrec
!select  spallstaff.nrec,  em_person.p0035, appointments.resword[20],spallstaff.resstring[1]
from appointments  inner join em_person On em_person.p0001=appointments.cref3
inner join apphist On apphist.cappoint=appointments.nrec
inner join  spallstaff On spallstaff.resstring[1]=em_person.p0035 and spallstaff.wnocon=5  and spallstaff.cbaset=appointments.person
where (length(p0035)>0 or p0036<>0)
!and em_person.p0002='Козлов Николай Петрович'
and em_person.p0002='Потаенко Алексей Михайлович'
!order by appointments.resword[20]
;
*/


/*
