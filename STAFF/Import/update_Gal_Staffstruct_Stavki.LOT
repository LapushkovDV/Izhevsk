/*
sql
update  staffstruct set   staffstruct.WORKSTATIONS=em_staffstruct.s0019
!select cast(WORKSTATIONS as double), cast(em_staffstruct.s0019 as double)
from staffstruct inner join  em_staffstruct On staffstruct.CNEWSPR3=em_staffstruct.S0001
where em_staffstruct.s0008='660'
and staffstruct.WORKSTATIONS<>s0019
;
*/

/*
sql
update historystr set historystr.HWORKSTATIONS=staffstruct.WORKSTATIONS
!select  historystr.HWORKSTATIONS,staffstruct.WORKSTATIONS, staffstruct.nrec
from staffstruct inner join historystr On historystr.staffstr=staffstruct.nrec
where historystr.HWORKSTATIONS<>staffstruct.WORKSTATIONS
;
*/
