/*
update appointments set DISMISSDATE=Dateend
!select  DISMISSDATE, DATEEND
!from appointments
where
!statusapp=3  and
dateend<>0 and DISMISSDATE<>dateend
and DISMISSDATE=0
;
*/
update appointments set Dateend=0
!select  DISMISSDATE, DATEEND
!from appointments
where
!statusapp=3  and
dateend<>0 and DISMISSDATE=dateend
and DISMISSDATE<>0
;
