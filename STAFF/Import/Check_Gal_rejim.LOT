/*
sql
select
count(*)
!distinct s0021, klrejim.REJIM, klrejim.NREJIM
!, catalogs.name
from staffstruct inner join em_staffstruct On em_staffstruct.s0001=staffstruct.CNEWSPR3
     inner join catalogs On catalogs.nrec=staffstruct.department
     left  join klrejim On staffstruct.workregime=klrejim.nrec
where klrejim.nrec is null
;
*/

sql select count(*) from em_staffstruct where s0021=0;