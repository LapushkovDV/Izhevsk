// Загрузка, до загрузка новых сотрудников
sql
!insert into persons (csovm, disprofnmb, fio, appdate, borndate,
!dependants, disorderdate,    disordernmb,
!inventions,  passnmb,  pensiondate, publications,  sex,
!strtabn ,testperiod,  isemployee,  department, filialno)
select per.*
from (
select
int64(0) csovm,
min(em_person.p0030) p0030, em_person.p0002 p0002, em_person.p0003 p0003, em_person.p0005 p0005, em_person.p0008 p0008, 0 disorderdate, em_person.p0012 p0012,
em_person.p0020 p0020,   em_person.p0021 p0021,    em_person.p0023 p0023,
em_person.p0024 p0024,   em_person.p0025 p0025,    em_person.p0026 p0026, // em_person.p0026,
em_person.p0027 p0027,  'С' isemployee,  catalogs.nrec nrec, em_person.p0001 p0001

from em_person
inner join
(
select
min(em_person2.P0001) p0001min
from em_person em_person2 inner join
(
select  em_person.p0030 p0030,  min(em_person.p0003) datamin
from  em_person
where (em_person.p0007 = 'Основное место работы' )//or em_person.p0007 = 'Внешнее совместительство')
group by   em_person.p0030
) em_person1  On em_person2.p0030=em_person1.p0030  and
em_person2.p0003=em_person1.datamin
group by em_person2.p0030, em_person2.p0003
)  em_person3 On em_person3.p0001min=em_person.p0001
inner join catalogs catalogsmain on catalogsmain.syscode = -11
left join  catalogs on catalogs.dopstr = em_person.p0016  and catalogs.mainlink = catalogsmain.nrec
group   by   p0001,   p0002,   p0003,   p0005,   p0008,
p0011, p0012, p0020, p0021, p0023, p0024,  p0025,
p0026, p0027, p0029,  catalogs.nrec

union

select
int64(1),
min(em_person.p0030), em_person.p0002, em_person.p0003 , em_person.p0005, em_person.p0008, 0, em_person.p0012,
em_person.p0020,   em_person.p0021,    em_person.p0023,
em_person.p0024,   em_person.p0025,    em_person.p0026, //em_person.p0026,
em_person.p0027,  'С',  catalogs.nrec, em_person.p0001
from em_person
inner join
(
select
min(em_person2.P0001) p0001min
from em_person em_person2 inner join
(
select  em_person.p0030 p0030,  min(em_person.p0003) datamin
from  em_person
where (em_person.p0007 = 'Внешнее совместительство')
group by   em_person.p0030
) em_person1  On em_person2.p0030=em_person1.p0030  and
em_person2.p0003=em_person1.datamin
group by em_person2.p0030, em_person2.p0003
)  em_person3 On em_person3.p0001min=em_person.p0001
inner join catalogs catalogsmain on catalogsmain.syscode = -11
left join  catalogs on catalogs.dopstr = em_person.p0016  and catalogs.mainlink = catalogsmain.nrec
group   by   p0001,   p0002,   p0003,   p0005,   p0008,
p0011, p0012, p0020, p0021, p0023, p0024,  p0025,
p0026, p0027, p0029,  catalogs.nrec


union

select
int64(3),
min(em_person.p0030), em_person.p0002, em_person.p0003, em_person.p0005, em_person.p0008, 0, em_person.p0012,
em_person.p0020,   em_person.p0021,    em_person.p0023,
em_person.p0024,   em_person.p0025,    em_person.p0026, //em_person.p0026,
em_person.p0027,  'С',  catalogs.nrec, em_person.p0001
from em_person  inner join klsovm On klsovm.nsovm=em_person.p0007
inner join
(
select p0030 from em_person  p1 group by p0030
having
exists (select p0030, p0007 from em_person where p0030=p1.p0030  and p0007='Внутреннее совместительство')
and not exists (select p0030, p0007 from em_person where p0030=p1.p0030  and p0007='По договору подряда')
and not exists (select p0030, p0007 from em_person where p0030=p1.p0030  and p0007='Основное место работы')
and not exists (select p0030, p0007 from em_person where p0030=p1.p0030  and p0007='Внешнее совместительство')
) P2 On P2.p0030=em_person.p0030
inner join
(
select
max(em_person2.P0001) p0001max
from em_person em_person2 inner join
(
select  em_person.p0030 p0030,  min(em_person.p0003) datamin
from  em_person
group by   em_person.p0030
) em_person1  On em_person2.p0030=em_person1.p0030  and
em_person2.p0003=em_person1.datamin
group by em_person2.p0030, em_person2.p0003
)  em_person3 On em_person3.p0001max=em_person.p0001
inner join catalogs catalogsmain on catalogsmain.syscode = -11
left join  catalogs on catalogs.dopstr = em_person.p0016  and catalogs.mainlink = catalogsmain.nrec
group   by   p0001,   p0002,   p0003,   p0005,   p0008,
p0011, p0012, p0020, p0021, p0023, p0024,  p0025,
p0026, p0027, p0029,  catalogs.nrec

union

select
int64(2),
min(em_person.p0030), em_person.p0002, em_person.p0003, em_person.p0005, em_person.p0008, 0, em_person.p0012,
em_person.p0020,   em_person.p0021,    em_person.p0023,
em_person.p0024,   em_person.p0025,    em_person.p0026, //em_person.p0026,
em_person.p0027,  'С',  catalogs.nrec, em_person.p0001
from em_person  inner join klsovm On klsovm.nsovm=em_person.p0007
inner join
(
select p0030 from em_person  p1 group by p0030
having
not exists (select p0030, p0007 from em_person where p0030=p1.p0030  and p0007='Внутреннее совместительство')
and exists (select p0030, p0007 from em_person where p0030=p1.p0030  and p0007='По договору подряда')
and not exists (select p0030, p0007 from em_person where p0030=p1.p0030  and p0007='Основное место работы')
and not exists (select p0030, p0007 from em_person where p0030=p1.p0030  and p0007='Внешнее совместительство')
) P2 On P2.p0030=em_person.p0030
inner join
(
select
max(em_person2.P0001) p0001max
from em_person em_person2 inner join
(
select  em_person.p0030 p0030,  min(em_person.p0003) datamin
from  em_person
group by   em_person.p0030
) em_person1  On em_person2.p0030=em_person1.p0030  and
em_person2.p0003=em_person1.datamin
group by em_person2.p0030, em_person2.p0003
)  em_person3 On em_person3.p0001max=em_person.p0001
inner join catalogs catalogsmain on catalogsmain.syscode = -11
left join  catalogs on catalogs.dopstr = em_person.p0016  and catalogs.mainlink = catalogsmain.nrec
group   by   p0001,   p0002,   p0003,   p0005,   p0008,
p0011, p0012, p0020, p0021, p0023, p0024,  p0025,
p0026, p0027, p0029,  catalogs.nrec
) per   left join persons persons1 On persons1.disprofnmb=per.p0030
where persons1.nrec is null
;

