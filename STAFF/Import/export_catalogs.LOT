sql

select
distinct catalogs.*
!distinct
!catalogs.nrec, catalogs.groupcode, catalogs.syscode, catalogs.name, catalogs.code, catalogs.ISLEAF, catalogs.DATN
!, catalogs.datok, catalogs.SDOPINF, catalogs.DOPSTR, catalogs.LONGNAME, catalogs.catdata
!, catalogs.mainlink mainnrec, catalogs.cparent parnrec
!catalogsmain.syscode, catalogsparent.syscode, catalogs.name
!select *
from catalogs   inner join
(
select  catalogsmain.nrec nrec0, catalogs1.nrec nrec1, catalogs2.nrec nrec2, catalogs3.nrec nrec3, catalogs4.nrec nrec4, catalogs5.nrec nrec5
from catalogs catalogsmain inner join catalogs catalogs1 On catalogs1.cparent=catalogsmain.nrec
left join catalogs catalogs2 On catalogs1.nrec=catalogs2.cparent
left join catalogs catalogs3 On catalogs2.nrec=catalogs3.cparent
left join catalogs catalogs4 On catalogs3.nrec=catalogs4.cparent
left join catalogs catalogs5 On catalogs4.nrec=catalogs5.cparent
where
(catalogsmain.syscode=-12
or catalogsmain.syscode=2300
or catalogsmain.syscode=100
or catalogsmain.syscode=-17
or catalogsmain.syscode=4001
or catalogsmain.syscode=4005
or catalogsmain.syscode=4003
or catalogsmain.syscode=4002
or catalogsmain.syscode=4004
)
) cat On   cat.nrec0=nrec or cat.nrec1=nrec or  cat.nrec2=nrec or cat.nrec3=nrec or cat.nrec4=nrec or cat.nrec5=nrec
!order by catalogsmain.syscode
to dbf Z:\import\source\catalogsexport.dbf
;