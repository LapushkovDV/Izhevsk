
sql
insert into catalogs (name, mainlink, cparent)
select  distinct em_award.AWARDTYPE, catalogsmain.nrec, catalogsparent.nrec
from em_award inner join catalogs catalogsmain On catalogsmain.syscode=58
inner join catalogs catalogsparent ON catalogsparent.syscode=-76
left join catalogs catalogsold On catalogsOld.name=em_award.AWARDTYPE
left join catalogs catalogsoldmain On catalogsoldmain.nrec=catalogsold.mainlink and catalogsoldmain.syscode=58
left join catalogs catalogsoldparent ON catalogsoldparent.nrec=catalogsold.cparent and catalogsoldparent.syscode=-76
where catalogsold.nrec is null
;




sql
!insert into catalogs (name, mainlink, cparent)
select  distinct em_award.DOCTYPE, catalogsmain.nrec, catalogsparent.nrec
from em_award inner join catalogs catalogsmain On catalogsmain.syscode=-3
inner join catalogs catalogsparent ON catalogsparent.syscode=-3
left join catalogs catalogsold On catalogsOld.name=em_award.DOCTYPE
left join catalogs catalogsoldmain On catalogsoldmain.nrec=catalogsold.mainlink and catalogsoldmain.syscode=-3
left join catalogs catalogsoldparent ON catalogsoldparent.nrec=catalogsold.cparent and catalogsoldparent.syscode=--3
where catalogsold.nrec is  not null
;



sql delete from fortune;

sql
insert into fortune (cpers, cftype, docnmb, docdate, snote, dat1, cref2)

select

persons.nrec, catalogs1.nrec, em_award.DOCNUMB, em_award.STATUSDATE, em_award.AWARDTEXT, em_award.STATUSDATE, catalogs2.nrec
from em_award inner join   persons On persons.disprofnmb=em_award.CITEZENID

left join catalogs catalogs1 On catalogs1.name=em_award.AWARDTYPE  and length(em_award.AWARDTYPE)>0
left join catalogs catalogs1main On catalogs1main.nrec=catalogs1.mainlink and catalogs1main.syscode=58
left join catalogs catalogs1parent ON catalogs1parent.nrec=catalogs1.cparent and catalogs1parent.syscode=-76


left join catalogs catalogs2 On catalogs2.name=em_award.DOCTYPE and length(em_award.DOCTYPE)>0
left join catalogs catalogs2main On catalogs2main.nrec=catalogs2.mainlink and catalogs2main.syscode=-3
left join catalogs catalogs2parent ON catalogs2parent.nrec=catalogs2.cparent and catalogs2parent.syscode=-3



left join  fortune  fortune1 On  fortune1.cpers=persons.nrec
left join catalogs catalogs3 On catalogs3.name=em_award.AWARDTYPE and length(em_award.AWARDTYPE)>0
left join catalogs catalogs3main On catalogs3main.nrec=catalogs3.mainlink and catalogs3main.syscode=-58
left join catalogs catalogs3parent ON catalogs3parent.nrec=catalogs3.cparent and catalogs3parent.syscode=-76
     and fortune1.cftype=catalogs3.nrec

where fortune1.nrec is null
;












