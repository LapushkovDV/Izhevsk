
sql
update lschet set lschet.strtabn =  substring(katpodr.kod,1,3) + lschet.strtabn
from katpodr
inner join lschet on lschet.cex =  katpodr.nrec
where   substring(katpodr.kod,1,3) <> substring(lschet.strtabn,1,3)
;


sql
update persons set persons.strtabn = substring(katpodr.kod,1,3) + persons.strtabn
!select   persons.strtabn, substring(katpodr.kod,1,3) + persons.strtabn
from katpodr
inner join persons on persons.galdep = katpodr.nrec
where substring(persons.strtabn,1,3)<>substring(katpodr.kod,1,3)
;
