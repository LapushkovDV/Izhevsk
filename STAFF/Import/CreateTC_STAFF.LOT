create table D_USER.EM_TC_STAFF "Таблица TC_STAFF(СКУД)"
  using "EM_STAFF.dat"
!  component USER
  with table_Code = 31748
  with tableOptions header, journal, corpo
  (
   ID        :longint "ID"
  , CITEZENID :longint "ID сотрудника"
  , STUFFID   :longint "ИД СКУД"
  , DELETEFLAG:word    "Признак удаления"
  , LASTNAME  :string[40]         "Фио"
  , NAME      :string[40]         "Имя"
  , FATHERSHIP:string[40]         "отчество"
  , DATEBEGIN :date         "Дата приема"
  , DATEDISMIS:date         "Дата увольнения"
  , DCODE     :string[40]         "Код код подразделения"
  , FREEPASS  :string[40]         "FREEPASS"

  )
  with index
  (
    EM_TC_STAFF01 = ID
   ,EM_TC_STAFF02 = CITEZENID
   ,EM_TC_STAFF03 = STUFFID

  );
