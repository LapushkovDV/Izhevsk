
!ВИД РАБОТЫ
sql
!update lschet set lschet.sovm =klsovm.sovm
select  klsovm.sovm, klsovm.nsovm,em_person.p0007,
 em_person.p0002
from lschet
inner join em_person on lschet.schp2 = em_person.p0001
left join klsovm on em_person.p0007 = klsovm.nsovm
where
em_person.p0002='Тимонина Светлана Ивановна'
!group by lschet.schp2, em_person.p0007, klsovm.sovm , lschet.NREC
;


!sql select lschet.schp2 from lschet inner join persons On persons.nrec =lschet.tperson where fio='Тимонина Светлана Ивановна';


