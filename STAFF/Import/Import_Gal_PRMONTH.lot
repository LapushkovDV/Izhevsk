sql
delete from prmonth;


sql
insert into prmonth (dolg, depon, cex, clsch, tperson, strtabn, mesn, yearn)
select db003, db004, lschet.cex, lschet.nrec, lschet.tperson, lschet.strtabn, 10, 2017
from em_debts
inner join em_person on em_person.p0001 = em_debts.db005
inner join lschet on lschet.schp2 = em_person.p0001
where lschet.sovm = 2 or lschet.sovm = 3
;

sql
insert into prmonth (dolg, depon, cex, clsch, tperson, strtabn, mesn, yearn)
select db003, db004, lschet.cex, lschet.nrec, lschet.tperson, lschet.strtabn, 10, 2017
from em_debts
inner join em_person on em_person.p0001 = em_debts.db005  and em_person.p0007 = 'Основное место работы'
inner join lschet on lschet.tabdop[10] = em_person.p0030
!inner join appointments on appointments.cref3 = em_debts.db005
!inner join catalogs On catalogs.nrec = appointments.department
!inner join extcatlinks on extcatlinks.staffcat = catalogs.nrec
!inner join katpodr on katpodr.nrec = extcatlinks.extcat
where lschet.sovm = 0
;

sql
insert into prmonth (dolg, depon, cex, clsch, tperson, strtabn, mesn, yearn)
select db003, db004, lschet.cex, lschet.nrec, lschet.tperson, lschet.strtabn, 10, 2017
from em_debts
inner join em_person on em_person.p0001 = em_debts.db005  and em_person.p0007 = 'Внешнее совместительство'
inner join lschet on lschet.tabdop[10] = em_person.p0030
!inner join appointments on appointments.cref3 = em_debts.db005
!inner join catalogs On catalogs.nrec = appointments.department
!inner join extcatlinks on extcatlinks.staffcat = catalogs.nrec
!inner join katpodr on katpodr.nrec = extcatlinks.extcat
where lschet.sovm = 1
;

