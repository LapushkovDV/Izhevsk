create table D_USER.EM_VID "Таблица EM_VID"
  using "EM_VID.dat"

  with table_Code = 31750
  with tableOptions header, journal, corpo
  (
   A0001 : String [10] "Группа",
   A0002 : LongInt "Вид оплаты",
   A0003 : LongInt "Счет/Субсчет",
   A0004 : LongInt "Код заказа"


  )
  with index
  (
   i_A0001=A0001,
   i_A0002=A0002,
   i_A0003=A0003,
   i_A0004=A0004

  );