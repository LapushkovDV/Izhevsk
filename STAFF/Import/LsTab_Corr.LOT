#define wYear 2018
#define wMesN 3
#define DateBeg #Date(1,1,2018)

SQL
/*
Select LsTab.StrTabn, SubString(Persons.Fio,1,35) FIO
, LsTab.YearN,LsTab.Mesn
, SubString(CAST(Lschet.tarif as String),1,30) Tariff
, A1.AppointDate
, A2.AppointDate
, CASE
   WHEN A1.Nrec is Null
   THEN CASE WHEN A2.Nrec is Null THEN Lschet.tarif
     ELSE A2.TaxRate END
   ELSE A1.TaxRate
  END
, date(from_days(TO_DAYS(
   datetime(LsTab.YearN*256*256+LsTab.Mesn*256+1,0)
   )))
*/
Update LsTab set LsTab.Tarif=CASE
   WHEN A1.Nrec is Null
   THEN CASE WHEN A2.Nrec is Null THEN Lschet.tarif
     ELSE A2.TaxRate END
   ELSE A1.TaxRate
  END
From LsTab
inner join Persons on Persons.Nrec = LsTab.tPerson
inner join Lschet  on Lschet.Nrec  = LsTab.cLschet
left outer join Appointments A1
   on A1.Person= LsTab.tPerson and A1.cAddNrec2 = LsTab.cLschet
   and A1.appointdate in (select  //#date(1,1,2018)
      Max(AA1.AppointDate) From Appointments AA1
   where AA1.Person= LsTab.tPerson and AA1.cAddNrec2 = LsTab.cLschet
   /*
       and AA1.AppointDate<=date(from_days(TO_DAYS(
   datetime(LsTab.YearN*256*256+LsTab.Mesn*256+1,0)
   )))
   */
   and AA1.AppointDate<=#(DateBeg)

   ) //in (select
left outer join Appointments A2
   on A2.Person= LsTab.tPerson and A2.cAddNrec2 = LsTab.cLschet
   and A2.appointdate in (select  //#date(1,1,2018)
      Min(AA2.AppointDate) From Appointments AA2
   where AA2.Person= LsTab.tPerson and AA2.cAddNrec2 = LsTab.cLschet
   /*
       and AA2.AppointDate>date(from_days(TO_DAYS(
   datetime(LsTab.YearN*256*256+LsTab.Mesn*256+1,0)
   )))
   */
   and AA2.AppointDate>=#(DateBeg)
   ) //in (select

where Lstab.tarif=0
 and LsTab.YearN=#(wYear)
 and LsTab.mesn =#(wMesN)
 and (Lschet.DatUv=#Date(0,0,0) or Lschet.DatUv>=#(DateBeg))
 and CASE
   WHEN A1.Nrec is Null
   THEN CASE WHEN A2.Nrec is Null THEN Lschet.tarif
     ELSE A2.TaxRate END
   ELSE A1.TaxRate
  END >0

;
