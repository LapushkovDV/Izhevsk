create table D_USER.EM_STAFFSTRUCT "Таблица EM_STAFFSTRUCT"
  using "EM_STAF.dat"
!  component USER
  with table_Code = 31726
  with tableOptions header, journal, corpo
  (
   S0001 : LongInt "ID штатной единицы",
   S0002 : LongInt "Id уровня оплаты",
   S0003 : String[8] "Доп. информация, классность",
   S0007 : LongInt "ID структурной единицы",
   S0008 : String[50] "Код подразделения",
   S0009 : String[255] "Наименование подразделения",
   S0010 : Date "Дата введения",
   S0011 : Integer "Форма оплаты труда",
   S0012 : LongInt "ID должности",
   S0013 : Integer "Порядковый номер для вывода на печать",
   S0014 : String[255] "Наименование должности",
   S0016 : Integer "Категория",
   S0017 : Double "Оклад, ставка, тариф",
   S0018 : LongInt "Условия труда",
   S0019 : Double "Количество рабочих мест по штату",
   S0020 : LongInt "Код Грейда",
   S0021 : LongInt "ID графика",
   S0022 : Integer "Дней отпуска по вредности",
   S0023 : Integer "Отпуск дополнительный",
   S0024 : String[50] "Статус Должности",
   S0025 : Date "Дата",
   S0026 : Integer "Отпуск за ненормированный рабочий день",
   S0027 : integer "Надбавка за вредность",
   S0028 : String[20] "Статус Структурного подразделения",
   S0029 : LongInt "Id Штатки",
   FIO   : string[100] "FIO в конце - Если пусто то вакантно"

  )
  with index
  (
   i_S0001=S0001,
   i_S0002=S0002,
   i_S0007=S0007,
   i_S0012=S0012,
   i_S0014=S0014,
   i_S0016=S0016,
   i_S0018=S0018,
   i_S0024=S0024,
   i_S0028=S0028,
   i_S0029=S0029,
   i_FIO=FIO
  )
;