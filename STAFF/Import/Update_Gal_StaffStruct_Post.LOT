/*
sql
!update staffstruct set staffstruct.post=catalogs.nrec
select staffstruct.post, catalogs.name, em_staffstruct.s0016, em_staffstruct.s0014
from
(
select staffstruct.nrec nrec, min(length(catalogs.name)) minnamelength, em_staffstruct.s0014
!catalogs.mainlink, catalogs.name, em_staffstruct.s0016, em_staffstruct.s0014
from staffstruct inner join em_staffstruct On em_staffstruct.s0001=staffstruct.cinf3
inner join catalogs On instr(em_staffstruct.s0014,Catalogs.name)>0 and catalogs.code<>'0'
and length(em_staffstruct.s0014)<length(catalogs.name)   and   cast(em_staffstruct.s0016 as string)=catalogs.code
inner join catalogs catalogsMain On catalogsMain.syscode=9004 and catalogs.mainlink=catalogsmain.nrec
where em_staffstruct.s0016<>0
!order by em_staffstruct.s0014
group by staffstruct.nrec, em_staffstruct.s0014
) C1 inner join  staffstruct On staffstruct.nrec=c1.nrec
inner join  em_staffstruct On em_staffstruct.s0001=staffstruct.cinf3
inner join catalogs On instr(em_staffstruct.s0014,Catalogs.name)>0 and catalogs.code<>'0'
and length(catalogs.name)=minnamelength   and   cast(em_staffstruct.s0016 as string)=catalogs.code
;
*/
/*
sql
update staffstruct set staffstruct.post=catalogs.nrec
!select
!count(*)
!top 100
!em_staffstruct.s0016, em_staffstruct.s0014
from
staffstruct inner join  em_staffstruct On em_staffstruct.s0001=staffstruct.cinf3
inner join
(
select max(atl_nrec) nrec from em_staffstruct group by s0001
) S On s.nrec=em_staffstruct.atl_nrec
inner join em_post On em_post.p0001=em_staffstruct.s0012
inner join catalogs catalogsMain On catalogsmain.syscode=9004
inner join catalogs catalogsParent On catalogsparent.syscode=-22
inner join catalogs On em_post.p0002+' '+replace(p0009,'нет','')=catalogs.name
and catalogs.cparent=catalogsparent.nrec
and catalogs.mainlink=catalogsmain.nrec
!where length(em_post.p0002+' '+replace(p0009,'нет',''))>0
;
*/

