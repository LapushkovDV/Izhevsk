/*
sql
update persons set    persons.CBASEPROF    = Appointments.Post
!select persons.CBASEPROF , Appointments.Post
from APPOINTMENTS inner join  persons  On APPOINTMENTS.nrec=persons.appointfirst
where
persons.appointfirst<>0

;


sql
update persons set    persons.CBASEPROF    = Appointments.Post
!select persons.CBASEPROF , Appointments.Post
from APPOINTMENTS inner join  persons  On APPOINTMENTS.nrec=persons.appointcur
where
persons.appointcur<>0

;


sql
update persons set    persons.CBASEPROF    = Appointments.Post
!select persons.CBASEPROF , Appointments.Post
from APPOINTMENTS inner join  persons  On APPOINTMENTS.nrec=persons.appointlast
where
persons.appointlast<>0
;


sql
update planatt set    planatt.cref2    = persons.cbaseprof
!select  planatt.cref2, persons.cbaseprof
from planatt inner join  persons  On planatt.cpers=persons.nrec
;
*/







