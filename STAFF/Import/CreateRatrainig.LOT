create table D_USER.EM_RETRAINIG "Таблица EM_RETRAINIG"
  using "EM_RETR.dat"
!  component USER
  with table_Code = 31736
  with tableOptions header, journal, corpo
  (
   ID           : LongInt "ID аттестации",
   CITEZENID    : LongInt "ID физического лица",
   EMPLOYEEID   : LongInt "ID сотрудника",
   INDATE       : Date "Дата начала",
   OUTDATE      : Date "Дата окончания",
   REASON       : string[10] "Причина переподготовки",
   RETR_TYPE    : String[255] "ТИП курса",
   DOCTYPE      : String[100] "Тип Документа",
   JOBTITLE     : String [255] "Тип аттестации",
   NAME         : String [255] "Название курса",
   DOCNUMB      : String [100] "Номер документа",
   DOCDATE      : Date "Дата составления документа",
   PR_NUMB      : String [50]   "Номер протокола",
   PR_DATE      : Date "Дата протокола"


  )
  with index
  (
   i_ID           =  ID,
   i_CITEZENID    =  CITEZENID,
   i_EMPLOYEEID   =  EMPLOYEEID,
   i_INDATE       =  INDATE,
   i_OUTDATE      =  OUTDATE,
   i_REASON       =  REASON,
   i_RETR_TYPE    =  RETR_TYPE,
   i_DOCTYPE      =  DOCTYPE,
   i_JOBTITLE     =  JOBTITLE,
   i_NAME         =  NAME,
   i_DOCNUMB      =  DOCNUMB,
   i_DOCDATE      =  DOCDATE,
   i_PR_NUMB      =  PR_NUMB,
   i_PR_DATE      =  PR_DATE
   );