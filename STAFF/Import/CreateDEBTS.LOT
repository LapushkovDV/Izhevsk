create table D_USER.EM_DEBTS "Таблица EM_DEBTS"

  using "EM_DEBT.dat"
!  component USER
  with table_Code = 31712
  with tableOptions header, journal, corpo
  (
   DB001 : LongInt "ID физ. лица",
   DB002 : integer  "Вид назначения",
   DB003 : double "Сумма долга за работником",
   DB004 : double "Сумма долга за предприятием",
   DB005 : longint "ID сотрудника"


  )
  with index
  (
   i_DB001=DB001,
   i_DB002=DB002,
   i_DB003=DB003,
   i_DB004=DB004,
   i_DB005=DB005

  );