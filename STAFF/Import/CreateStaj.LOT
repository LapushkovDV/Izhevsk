
create table D_USER.EM_STAJ "Таблица стажей"
  using "EM_STAJ.dat"
!  component USER
  with table_Code = 31740
  with tableOptions header, journal, corpo
  (
   CITEZENID : LongInt "ID физического лица",
   DBEG_WORK : DATE    "Дата начала трудового стажа"
  )
  with index
  (
   EM_STAJ01=CITEZENID+DBEG_WORK
   );
