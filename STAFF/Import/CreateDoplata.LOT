create table D_USER.EM_DOPLATA "Таблица EM_DOPLATA"
       using "EM_DOPL.dat"
!      component user
       with table_code = 31713
       with tableoptions header, journal, corpo
       (

       DP001: longint "ID физ. лица",
       DP002: string[5] "Вид назначения",
       DP003: integer "Код вида оплаты пользователя",
       DP004: double "Сумма Дооплаты",
       DP005: double "Процент Доплаты",
       DP006: date "Дата Начала доплаты",
       DP007: date "Дата окончания доплаты",
       DP008: longint "ID сотрудника",
       DP009: double "Оклад"


       )

with index
     (

        i_DP001 = DP001,
        i_DP002 = DP002,
        i_DP003 = DP003,
        i_DP004 = DP004,
        i_DP005 = DP005,
        i_DP006 = DP006,
        i_DP007 = DP007,
        i_DP008 = DP008,
        i_DP009 = DP009
     );