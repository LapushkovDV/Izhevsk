sql

select persons.fio, persons.strtabn, katpodr.name, katpodr.kod, lschet.datpos, lschet.datuv, lschet.rejim, klrejim.nrejim, klrejim.hours //, grafik.code //, grafik.name
from
lschet inner join persons on lschet.tperson = persons.nrec
inner join katpodr on lschet.cex = katpodr.nrec
inner join klrejim on lschet.rejim = klrejim.REJIM
inner join calendar on calendar.nrec = klrejim.ccalendar
//inner join grafik on grafik.nrec = calendar.nrec
where lschet.sovm = 0 and (lschet.datuv = #date(0,0,0) or lschet.datuv > #date(01,10,2017)) and (lschet.datpos = #date(0,0,0) or lschet.datpos < #date(01,11,2017))
order by persons.fio


select persons.fio, persons.strtabn, katpodr.name, katpodr.kod, lschet.datpos, lschet.datuv, lschet.rejim, klrejim.nrejim, klrejim.hours, grafik.code, grafik.name
from lschet,persons,katpodr,klrejim,grafik
where ((lschet.tperson == persons.nrec
 and lschet.cex == katpodr.nrec
 and  lschet.rejim == klrejim.REJIM
 and  klrejim.ccalendar == grafik.nrec ))
and lschet.sovm = 0 and (lschet.datuv = date(0,0,0) or lschet.datuv > date(01,10,2017)) and (lschet.datpos = date(0,0,0) or lschet.datpos < date(01,11,2017))
order by persons.fio
to dbf a:\1.xls;