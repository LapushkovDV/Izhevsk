delete all from EM_EDUCATION;
import EM_EDUCATION from dbf "Z:\import\Source\EDUCATION.dbf"  arrangeByName fullInfo;

sql update em_education set e0012='Высшее профессиональное' where E0012='Высшее образование';
sql update em_education set e0012='Среднее (полное) общее' where E0012='Среднее (полное) общее образование';
sql update em_education set e0012='Основное общее' where E0012='Основное общее образование';
sql update em_education set e0012='Среднее профессиональное' where E0012='Среднее профессиональное образование';
sql update em_education set e0012='Неполное среднее профессиональное' where E0012='Неполное среднее';
sql update em_education set e0012='Начальное профессиональное' where E0012='Начальное профессиональное образование';

