/*
// с ненормированным рабочим днем
sql
insert into  PERSVACATION (Cpersons, ckotpus, typeotp, summotp, wcountday, dbegexist, dendexist, dvaccoef)
select
persons.nrec, klotpusk.kotpus, klotpusk.TYPEOTP, 0,E0003,  E0004, E0005, 1
!,persons.disprofnmb
!em_extravac.atl_nrec
!count(*)
from em_extravac
!inner join
!(select max(atl_nrec) nrec, min(E0004) E0004Min, max(E0005) E0005Max from em_extravac where E0003>0 group by E0001
!) EM_ext  On Em_ext.nrec=em_extravac.atl_nrec
inner join persons On em_extravac.E0001=persons.DISPROFNMB and E0003>0 and E0004>0
inner join klotpusk On Klotpusk.kotpus=10
left join  PERSVACATION PERSVACATIONold On PERSVACATIONold.Cpersons=persons.nrec  and PERSVACATIONold.ckotpus=Klotpusk.kotpus
where  PERSVACATIONold.nrec is null
!order by  em_extravac.atl_nrec
;
*/



