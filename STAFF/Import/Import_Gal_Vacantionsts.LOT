EM_STAFFSTRUCT1 INNER JOIN EM_STAFFSTRUCT On EM_STAFFSTRUCT.atl_nrec=EM_STAFFSTRUCT1.atl_nrec
     inner join staffstruct On Staffstruct.CNEWSPR3=em_staffstruct.S0001
     inner join klotpusk On Klotpusk.kotpus=14 and s0022 >0
