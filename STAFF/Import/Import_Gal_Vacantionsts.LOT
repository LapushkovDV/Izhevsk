staffstruct.nrec, klotpusk.kotpus, klotpusk.TYPEOTP, em_staffstruct.s0023
,DATE(DATEtime(#date(1, 1, 1900),0)),0,1
from
(select max(EM_STAFFSTRUCT.atl_nrec)atl_nrec from EM_STAFFSTRUCT   group by s0001  )
EM_STAFFSTRUCT1 INNER JOIN EM_STAFFSTRUCT On EM_STAFFSTRUCT.atl_nrec=EM_STAFFSTRUCT1.atl_nrec
     inner join staffstruct On Staffstruct.CNEWSPR3=em_staffstruct.S0001
     inner join klotpusk On Klotpusk.kotpus=12 and s0023 >0
     left join  vacationsts vacationstsold On vacationstsold.Cstaffstruct=staffstruct.nrec and   vacationstsold.ckotpus=Klotpusk.kotpus
where  vacationstsold.nrec is null
union all
select
staffstruct.nrec, klotpusk.kotpus, klotpusk.TYPEOTP, em_staffstruct.s0026
,DATE(DATEtime(#date(1, 1, 1900),0)),0,1
from
(select max(EM_STAFFSTRUCT.atl_nrec)atl_nrec from EM_STAFFSTRUCT  group by s0001  )
EM_STAFFSTRUCT1 INNER JOIN EM_STAFFSTRUCT On EM_STAFFSTRUCT.atl_nrec=EM_STAFFSTRUCT1.atl_nrec
     inner join staffstruct On Staffstruct.CNEWSPR3=em_staffstruct.S0001
     inner join klotpusk On Klotpusk.kotpus=13 and s0026 >0
     left join  vacationsts vacationstsold On vacationstsold.Cstaffstruct=staffstruct.nrec and   vacationstsold.ckotpus=Klotpusk.kotpus
where  vacationstsold.nrec is null
;

!sql delete  from vacationalg;

sql
