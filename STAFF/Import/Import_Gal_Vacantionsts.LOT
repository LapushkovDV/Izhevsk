/*
sql delete  from PERSVACATION;
// плановый основной в сотрудников

sql
insert into  PERSVACATION (Cpersons, ckotpus, typeotp, summotp, wcountday, dbegexist, dendexist, dvaccoef)
select
persons.nrec, klotpusk.kotpus, klotpusk.TYPEOTP, 0, EM_Person.p0033
,persons.APPDATE, 0 ,1
from
(select max(P0003) p0003, p0030 from em_person where p0007='основное место работы' group by p0030) em_person1
inner join em_person On em_person.p0030=em_person1.p0030 and em_person.p0003=em_person1.p0003
      and   p0007='основное место работы'
inner join persons On em_person.p0030=persons.DISPROFNMB
inner join klotpusk On Klotpusk.kotpus=1 and p0033 >0 and p0033 <1000
left join  PERSVACATION PERSVACATIONold On PERSVACATIONold.Cpersons=persons.nrec  and PERSVACATIONold.ckotpus=Klotpusk.kotpus
where  PERSVACATIONold.nrec is  null
!and persons.fio='Куклева Ольга Ивановна'
union all
select
persons.nrec, klotpusk.kotpus, klotpusk.TYPEOTP, 2, EM_Person.p0034
,persons.APPDATE, 0 ,1
from
(select max(P0003) p0003, p0030 from em_person where p0007='основное место работы' group by p0030) em_person1
inner join em_person On em_person.p0030=em_person1.p0030 and em_person.p0003=em_person1.p0003
           and   p0007='основное место работы'
inner join persons On em_person.p0030=persons.DISPROFNMB
inner join klotpusk On Klotpusk.kotpus=12 and p0034 >0 and p0034 <1000
left join  PERSVACATION PERSVACATIONold On PERSVACATIONold.Cpersons=persons.nrec  and PERSVACATIONold.ckotpus=Klotpusk.kotpus
where  PERSVACATIONold.nrec is  null
!and persons.fio='Куклева Ольга Ивановна'
;


sql delete  from PERSVACATIONalg;

sql
insert into  PERSVACATIONAlg (CPERSVACATION, koldn, persent,dvaccoef)
select
PERSVACATION.Nrec, PERSVACATION.wcountday, 1, PERSVACATION.dvaccoef
from PERSVACATION left  join PERSVACATIONalg PERSVACATIONalgOld On PERSVACATIONAlgold.CPERSVACATION=PERSVACATION.nrec
where      PERSVACATIONAlgOld.nrec is null
;
*/


