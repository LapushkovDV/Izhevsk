sql
insert into catalogs (name, mainlink, cparent)
select distinct c0002, catalogscontmain.nrec, catalogscontmain.nrec
from em_contact inner join catalogs catalogscontmain On catalogscontmain.syscode=-14
left join catalogs catalogsCont On CatalogsCont.mainlink=catalogscontmain.nrec and CatalogsCont.cParent=catalogscontmain.nrec
and  catalogscont.name=em_contact.c0002
where catalogscont.nrec is null
;


delete all from COMMUNICATIONS;

sql
insert into COMMUNICATIONS (Person, ComType, ObjType, Addr)
select persons.nrec, CatalogsCont.Nrec, 2, cast(em_contact.c0003 as string[20])
from em_contact inner join persons On persons.DISPROFNMB=em_contact.c0001
     inner join catalogs catalogscontmain On catalogscontmain.syscode=-14
     inner join catalogs catalogsCont On CatalogsCont.mainlink=catalogscontmain.nrec and CatalogsCont.cParent=catalogscontmain.nrec
          and  catalogscont.name=em_contact.c0002
;

