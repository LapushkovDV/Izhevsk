/*
sql
insert into infpsn1 (cpers, str1)
select distinct advises.nrec, replace(klchild4.yearint, '310', '3.10')
from advises
inner join catalogs on catalogs.nrec = advises.person
left join infpsn1 on infpsn1.cpers = advises.nrec
inner join appointments on appointments.post = catalogs.nrec
inner join em_vredn on em_vredn.vr005 = appointments.cref3
inner join em_catalogs on em_catalogs.c0001 = em_vredn.vr003
inner join klchild4 on klchild4.yearint = em_catalogs.c0003
where infpsn1.str1 is null
;
*/
update infpsn1
from infpsn1
where ((infpsn1.cpers == advises.nrec))
set infpsn1.cref2 = 000000000000000Fh
;

!éëéÅõÖ ìëãéÇàü
sql
update advises set advises.recommendation = catalogs2.nrec
from em_vredn
inner join appointments on appointments.cref3 = em_vredn.vr005
inner join catalogs on catalogs.nrec = appointments.post
inner join em_catalogs on em_catalogs.c0001 = em_vredn.vr003
inner join catalogs catalogs1 on catalogs1.nrec = appointments.department
inner join klchild4 on em_catalogs.c0003 = cast(klchild4.yearint as string)
inner join persons on persons.appointcur = appointments.nrec
inner join em_kps on em_kps.kps03 = persons.fio
inner join advises on advises.person = catalogs.nrec
inner join catalogs catalogs2 on catalogs2.code = substring('27-' + cast(em_kps.kps06 as string),1,4) and catalogs2.mainlink = #comp(000000000000033Eh)
;

!äèë
sql
update advises set advises.executor = catalogs2.nrec
from em_vredn
inner join appointments on appointments.cref3 = em_vredn.vr005
inner join catalogs on catalogs.nrec = appointments.post
inner join em_catalogs on em_catalogs.c0001 = em_vredn.vr003
inner join catalogs catalogs1 on catalogs1.nrec = appointments.department
inner join klchild4 on em_catalogs.c0003 = cast(klchild4.yearint as string)
inner join persons on persons.appointcur = appointments.nrec
inner join em_kps on em_kps.kps03 = persons.fio
inner join advises on advises.person = catalogs.nrec
inner join catalogs catalogs2 on catalogs2.code = em_kps.kps08
;

sql
insert into infpsn3 (cpers, cref1, lasttime, lastuser)
select distinct appointments.nrec, advises.nrec, 1, '2'
from em_vredn
inner join appointments on appointments.cref3 = em_vredn.vr005
inner join catalogs on catalogs.nrec = appointments.post
inner join em_catalogs on em_catalogs.c0001 = em_vredn.vr003
inner join catalogs catalogs1 on catalogs1.nrec = appointments.department
inner join advises on  advises.person = appointments.post and appointments.department = advises.sertificate
;

sql
update apphist set apphist.cspr5 = #comp(0000000000000000h), apphist.cspr4 = klotpusk.nrec, apphist.cspr3 = spallstaff.nrec, apphist.cspr2 = advises.nrec
from em_vredn
inner join appointments on appointments.cref3 = em_vredn.vr005
inner join catalogs on catalogs.nrec = appointments.post
inner join em_catalogs on em_catalogs.c0001 = em_vredn.vr003
inner join catalogs catalogs1 on catalogs1.nrec = appointments.department
inner join advises on advises.person = appointments.post and appointments.department = advises.sertificate
inner join apphist on apphist.cappoint = appointments.nrec
inner join persons on persons.appointcur = appointments.nrec
inner join spallstaff on spallstaff.cbaset = persons.nrec
inner join klotpusk on klotpusk.nrec = #comp(0001000000000002h)
;


sql
insert into zarsignal (srcrec, tperson, cex, cexzpl, cpodr, cadvises, clschetzpl, comp3, strtabn, double1, date2, filialno, subsyscode, msgcode, srctable,
                       word1, date1_m, word2, word4, word5, correctivefactor, wagerate)
select distinct persons.nrec, persons.nrec, lschet.cex, lschet.cex, appointments.nrec, advises.nrec, lschet.nrec, lschet.cappoint, lschet.strtabn, lschet.tarif,
                lschet.datpos, 512, 1, 2, 2, 30, 'à', lschet.codtar, 1, 5, 1, 1
from lschet
inner join persons on persons.nrec = lschet.tperson
inner join appointments on appointments.caddnrec2 = lschet.nrec and  lschet.datuv = appointments.dismissdate
inner join advises on advises.person = lschet.cappoint and appointments.department = advises.sertificate
;




