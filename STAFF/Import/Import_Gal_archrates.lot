sql

!insert into archrates (spl1[1], tarif1[1], kof1[1], summa1[1], summa11[1], summa21[1], clsch, tperson, strtabn, year)
select tarstav.sisopl, max(appointments.taxrate), 1, tarstav.sisopl, max(appointments.taxrate), 1, lschet.nrec, lschet.tperson, lschet.strtabn, 2017
from appointments
inner join tarstav on tarstav.nrec = appointments.tariff
inner join lschet on appointments.caddnrec2 = lschet.nrec and (lschet.sovm = 0 or lschet.sovm= 1)  and  lschet.datuv = 0
where appointments.appointdate <= #date(01,01,2017)
group by tarstav.sisopl, lschet.nrec, lschet.tperson, lschet.strtabn
;

!sql
!delete from archrates;
sql
!insert into archrates(spl1[1], spl1[2], spl1[3], spl1[4], spl1[5], spl1[6], spl1[7], spl1[8], spl1[9],
!tarif1[1], tarif1[2], tarif1[3], tarif1[4], tarif1[5], tarif1[6], tarif1[7], tarif1[8], tarif1[9],
!kof1[1], kof1[2], kof1[3], kof1[4], kof1[5], kof1[6], kof1[7], kof1[8], kof1[9],
!summa1[1], summa1[2], summa1[3], summa1[4], summa1[5], summa1[6], summa1[7], summa1[8], summa1[9],
!summa11[1], summa11[2], summa11[3], summa11[4], summa11[5], summa11[6], summa11[7], summa11[8], summa11[9],
!summa21[1], summa21[2], summa21[3], summa21[4], summa21[5], summa21[6], summa21[7], summa21[8], summa21[9],
!lschet.nrec, lschet.tperson, lschet.strtabn
select
!tarstav.sisopl, tarstav.sisopl, tarstav.sisopl, tarstav.sisopl, tarstav.sisopl, tarstav.sisopl, tarstav.sisopl,tarstav.sisopl, tarstav.sisopl,
max(ap1.taxrate), max(ap2.taxrate), max(ap3.taxrate), max(ap4.taxrate), max(ap5.taxrate), max(ap6.taxrate), max(ap7.taxrate), max(ap8.taxrate), max(ap9.taxrate),
1, 1, 1, 1, 1, 1, 1, 1, 1,
!tarstav.sisopl, tarstav.sisopl, tarstav.sisopl, tarstav.sisopl, tarstav.sisopl, tarstav.sisopl, tarstav.sisopl,tarstav.sisopl, tarstav.sisopl,
max(ap1.taxrate), max(ap2.taxrate), max(ap3.taxrate), max(ap4.taxrate), max(ap5.taxrate), max(ap6.taxrate), max(ap7.taxrate), max(ap8.taxrate), max(ap9.taxrate),
1, 1, 1, 1, 1, 1, 1, 1, 1,
lschet.nrec, lschet.tperson, lschet.strtabn, 2017
from appointments
inner join appointments ap1 on ap1.nrec = appointments.nrec and appointments.appointdate <= #date(01,01,2017)
inner join appointments ap2 on ap2.nrec = appointments.nrec and appointments.appointdate <= #date(01,02,2017)
inner join appointments ap3 on ap3.nrec = appointments.nrec and appointments.appointdate <= #date(01,03,2017)
inner join appointments ap4 on ap4.nrec = appointments.nrec and appointments.appointdate <= #date(01,04,2017)
inner join appointments ap5 on ap5.nrec = appointments.nrec and appointments.appointdate <= #date(01,05,2017)
inner join appointments ap6 on ap6.nrec = appointments.nrec and appointments.appointdate <= #date(01,06,2017)
inner join appointments ap7 on ap7.nrec = appointments.nrec and appointments.appointdate <= #date(01,07,2017)
inner join appointments ap8 on ap8.nrec = appointments.nrec and appointments.appointdate <= #date(01,08,2017)
inner join appointments ap9 on ap9.nrec = appointments.nrec and appointments.appointdate <= #date(01,09,2017)
!inner join tarstav on tarstav.nrec = appointments.tariff
inner join lschet on appointments.caddnrec2 = lschet.nrec and (lschet.sovm = 0 or lschet.sovm= 1)  and  lschet.datuv = 0
where lschet.nrec = #comp(000A00000002477Eh)
group by lschet.nrec, lschet.tperson, lschet.strtabn
;

