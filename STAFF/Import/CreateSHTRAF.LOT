create table D_USER.EM_SHTRAF "Таблица EM_SHTRAF"

  using "EM_SHTR.dat"
!  component USER
  with table_Code = 31724
  with tableOptions header, journal, corpo
  (
   SH001 : LongInt "ID физ. лица",
   SH002 : integer  "Вид назначения",
   SH003 : integer "Код вида удержания",
   SH004 : double "Сумма удержания",
   SH005 : double "Процент удержания",
   SH006 : date "Дата начала удержания",
   SH007 : date "Дата окончания удержания",
   SH008 : longint "ID сотрудника"


  )
  with index
  (
   i_SH001=SH001,
   i_SH002=SH002,
   i_SH003=SH003,
   i_SH004=SH004,
   i_SH005=SH005,
   i_SH006=SH006,
   i_SH007=SH007,
   i_SH008=SH008

  );