create table D_USER.EM_APPOINTMENT "Таблица EM_APPOINTMENT"
  using "EM_APPOI.dat"
!  component USER
  with table_Code = 31704
  with tableOptions header, journal, corpo
  (
   A0000 : LongInt "ID физического лица",
   A0001 : LongInt "ID штатной единицы",
   A0002 : Date "Дата назначения на должность",
   A0003 : Date "Дата ухода с должности",
   A0004 : String [60] "Тип работы (основ./совм.)",
   A0005 : String [20] "№ Трудового договора",
   A0006 : Date "Дата трудового договора",
   A0007 : LongInt "Тип перевода",
   A0008 : LongInt "Старое подразделение",
   A0009 : LongInt "Новое подразделение"



  )
  with index
  (
   i_A0000=A0000,
   i_A0001=A0001,
   i_A0002=A0002,
   i_A0003=A0003,
   i_A0004=A0004,
   i_A0005=A0005,
   i_A0006=A0006,
   i_A0007=A0007,
   i_A0008=A0008,
   i_A0009=A0009
  );