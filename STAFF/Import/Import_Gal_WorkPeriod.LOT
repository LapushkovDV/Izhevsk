//---------------------------------
// Создаем PutVacations
//---------------------------------


sql
insert into putvacation (CWORKPERIOD, cperson, WTYPEVAC, WNUM, CKLOTPUSK, CPERSVAC,DBEGBALANCE,DENDBALANCE
  , wProvidWay  , WDAYCOUNT )
select Distinct
    workperiod.nrec as CWORKPERIOD, persons.nrec as cperson
  , 0 as WTYPEVAC,  1 as WNUM, klotpusk.nrec as CKLOTPUSK, Max(PERSVACATION.nrec) as CPERSVAC
 //(date(from_days(TO_DAYS(datetime(DENDEXIST,0)))) - date(from_days(TO_DAYS(datetime(DBEGEXIST,0)))))/365
 ,workperiod.dperbeg, workperiod.dperend
 ,0 as wProvidWay
 ,CAST(Round(sum(0.00000+PERSVACATION.WCOUNTDAY* (
             1.00000+ TO_DAYS(datetime(CASE WHEN (PERSVACATION.DENDEXIST>=workperiod.dperend or COALESCE(PERSVACATION.DENDEXIST,#Date(0,0,0))=#Date(0,0,0))
                                     THEN workperiod.dperend ELSE PERSVACATION.DENDEXIST END,0))
                      -TO_DAYS(datetime(CASE when PERSVACATION.DBEGEXIST<workperiod.dperbeg THEN workperiod.dperbeg else PERSVACATION.DBEGEXIST end,0))
           )
         /
         ( 1.00000+ TO_DAYS(datetime(workperiod.dperend,0))   -TO_DAYS(datetime(workperiod.dperbeg,0)))
       ),0) as WORD) as WDAYCOUNT
// ,Persons.Fio
//, PERSVACATION.WCOUNTDAY
//, TO_DAYS(datetime(CASE WHEN (PERSVACATION.DENDEXIST>=workperiod.dperend or COALESCE(PERSVACATION.DENDEXIST,#Date(0,0,0))=#Date(0,0,0))
//                                     THEN workperiod.dperend ELSE PERSVACATION.DENDEXIST END,0))
//,-TO_DAYS(datetime(CASE when PERSVACATION.DBEGEXIST<workperiod.dperbeg THEN workperiod.dperbeg else PERSVACATION.DBEGEXIST end,0))
//
from PERSVACATION   inner join persons On persons.nrec=PERSVACATION.cpersons #flt_Persons
inner join klotpusk On klotpusk.kotpus=PERSVACATION.ckotpus
inner join workperiod On workperiod.cperson=persons.nrec
  and workperiod.WTYPEPERIOD=0
  and workperiod.dperend > workperiod.dperbeg
  and PERSVACATION.DBEGEXIST<=workperiod.dperend
  and (PERSVACATION.DENDEXIST>=workperiod.dperbeg or COALESCE(PERSVACATION.DENDEXIST,#Date(0,0,0))=#Date(0,0,0))
Left outer join putvacation on
  putvacation.CWORKPERIOD=workperiod.nrec
  and  putvacation.cperson=Persons.Nrec
  and  putvacation.WTYPEVAC=0 and putvacation.WNUM=1
  and  putvacation.CKLOTPUSK  = klotpusk.nrec
  //and putvacation.CPERSVAC = PERSVACATION.nrec
  //and putvacation.WDAYCOUNT = PERSVACATION.WCOUNTDAY
where
//      DATE(DATEtime(#date(09, 10, 2017),0)) >date(datetime(dperbeg,0))
//  and DATE(DATEtime(#date(09, 10, 2017),0)) <date(datetime(dperend,0)) and
   putvacation.Nrec is Null
Group by   workperiod.nrec, persons.nrec, klotpusk.nrec//, PERSVACATION.nrec
          ,workperiod.dperbeg, workperiod.dperend
          //,Persons.Fio
//, PERSVACATION.WCOUNTDAY
//, TO_DAYS(datetime(CASE WHEN (PERSVACATION.DENDEXIST>=workperiod.dperend or COALESCE(PERSVACATION.DENDEXIST,#Date(0,0,0))=#Date(0,0,0))
//                                     THEN workperiod.dperend ELSE PERSVACATION.DENDEXIST END,0))
//,-TO_DAYS(datetime(CASE when PERSVACATION.DBEGEXIST<workperiod.dperbeg THEN workperiod.dperbeg else PERSVACATION.DBEGEXIST end,0))

;

sql
insert into putvacation (CWORKPERIOD, cperson, WTYPEVAC, WNUM, CKLOTPUSK, CPERSVAC,DBEGBALANCE,DENDBALANCE,wProvidWay,cWPRemain, WDAYCOUNT)
select Distinct
   workperiod.nrec,persons.nrec,0,  1,klotpusk.nrec, Max(VACATIONSTS.nrec)
   , workperiod.dperbeg, workperiod.dperend
   ,0
   ,workperiod.nrec
   , Round(0.06+SUM(0.0000+
      VACATIONSTS.WCOUNTDAY*(1.00000+TO_DAYS(
         datetime(CASE WHEN (COALESCE(Appointments.DisMissDate,#Date(0,0,0))>=workperiod.dperend
            or COALESCE(Appointments.DisMissDate,#Date(0,0,0))=#Date(0,0,0))
          THEN workperiod.dperend ELSE Appointments.DisMissDate END,0))
       -TO_DAYS(datetime(CASE when COALESCE(Appointments.AppointDate,#Date(0,0,0))<workperiod.dperbeg THEN workperiod.dperbeg else Appointments.AppointDate end,0))
           )/ ( 1.00000+ TO_DAYS(datetime(workperiod.dperend,0))   -TO_DAYS(datetime(workperiod.dperbeg,0)))
            ),0)

//  ,Appointments.DisMissDate,workperiod.dperend
//  ,Appointments.AppointDate,workperiod.dperbeg
//   ,   Persons.Fio ,klotpusk.NOtpus
from VACATIONSTS   inner join staffstruct On staffstruct.nrec=VACATIONSTS.cstaffstruct
inner join klotpusk On klotpusk.kotpus=ckotpus
inner join appointments On appointments.staffstr=staffstruct.nrec and appointments.Lprizn=0
inner join persons On persons.nrec=appointments.person #flt_Persons
inner join workperiod On workperiod.cperson=persons.nrec
  and workperiod.WTYPEPERIOD=0
  and workperiod.dperend > workperiod.dperbeg
  and VACATIONSTS.DBEGEXIST<=workperiod.dperend
  and (VACATIONSTS.DENDEXIST>=workperiod.dperbeg or COALESCE(VACATIONSTS.DENDEXIST,#Date(0,0,0))=#Date(0,0,0))
//and   DATE(DATEtime(#date(09, 10, 2017),0)) > date(datetime(dperbeg,0)) and DATE(DATEtime(#date(09, 10, 2017),0)) <date(datetime(dperend,0))
  and Appointments.AppointDate<=workperiod.dperend
  and (Appointments.DisMissDate>=workperiod.dperbeg or COALESCE(Appointments.DisMissDate,#Date(0,0,0))=#Date(0,0,0))
Left outer join putvacation on
       putvacation.CWORKPERIOD=workperiod.nrec
  and  putvacation.cperson=Persons.Nrec
  and  putvacation.WTYPEVAC=0 //and putvacation.WNUM=1
  and  putvacation.CKLOTPUSK  = klotpusk.nrec
//  and putvacation.WDAYCOUNT = VACATIONSTS.WCOUNTDAY
where
// ((appointments.APPOINTDATE>=dperbeg and appointments.APPOINTDATE<=workperiod.dperend)
//   or  (appointments.DISMISSDATE>=dperbeg and appointments.DISMISSDATE<=workperiod.dperend)
//   )   and
  putvacation.Nrec is Null
  Group by
   workperiod.nrec,persons.nrec,klotpusk.nrec
   , workperiod.dperbeg, workperiod.dperend
//  ,Appointments.DisMissDate,workperiod.dperend
//  ,Appointments.AppointDate,workperiod.dperbeg

;
//--------------------------------
//пробьем ссылку на PutVacation
SQL
Update Vacations set Vacations.cPutVac=PutVacation.Nrec
From Vacations
inner join FactOtpusk on  FactOtpusk.Nrec=Vacations.cFactOtpusk
inner join KLOTPUSK on KlOtpusk.Nrec  = VACATIONS.VacType #flt_klOtpusk
inner join workperiod on FactOtpusk.cWorkPeriod=WorkPeriod.Nrec
  and workperiod.WTYPEPERIOD=0
//      workperiod.cperson = VACATIONS.person
//  and workperiod.dperbeg =VACATIONS.workyearbeg
//  and workperiod.dperbeg<=VACATIONS.workyearend
inner join putvacation on putvacation.CWORKPERIOD = workperiod.Nrec
                   and  putvacation.CKLOTPUSK = VACATIONS.VacType
                   and Vacations.cPutVac<>PutVacation.Nrec
;


