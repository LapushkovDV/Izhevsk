/*
SQL
update vacations set vacations.Appoint = Appointments1.Nrec
//select vacations.Nrec,VACATIONS.workyearbeg,VACATIONS.Factyearbeg,VACATIONS.Factyearend,Appointments1.Nrec
From  EM_Vacations
inner join appointments on appointments.cref3 = EM_Vacations.V0009
inner join Persons on Persons.Nrec=appointments.person #flt_Persons
inner join Appointments Appointments1 on Appointments1.Person = Persons.Nrec and Appointments1.Lprizn= Appointments.Lprizn
and   Appointments1.AppointDate = (select Max(Appointments2.AppointDate)
     from Appointments Appointments2 where Appointments2.Person = Persons.Nrec
          and Appointments2.Lprizn = Appointments.Lprizn
          and Appointments2.AppointDate<=EM_Vacations.V0004
     )

inner join Vacations on Vacations.Person = appointments.Person
  and VACATIONS.workyearbeg=EM_Vacations.V0003
  and VACATIONS.workyearend=EM_Vacations.V0004
  and VACATIONS.Factyearbeg=EM_Vacations.V0005
  and VACATIONS.Factyearend=EM_Vacations.V0006
  and VACATIONS.Appoint<>appointments1.Nrec
;

SQL
Insert into workperiod (cperson,WTYPEPERIOD, dperbeg, dperend, CAPPOINTMENT)
select Distinct VACATIONS.person, 0, VACATIONS.workyearbeg,VACATIONS.workyearend,VACATIONS.APPOINT
// ,KLOTPUSK.TYPEOTP,KLOTPUSK.NOtpus,VACATIONS.factyearbeg
From VACATIONS
inner join KLOTPUSK on KlOtpusk.Nrec  = VACATIONS.VacType #flt_klOtpusk
inner join Persons on Persons.Nrec=VACATIONS.person #flt_Persons
Left outer join workperiod workperiod1 on workperiod1.cperson = VACATIONS.person
and workperiod1.dperbeg=VACATIONS.workyearbeg
and workperiod1.WTYPEPERIOD=0
//and workperiod1.dperend=VACATIONS.workyearend
where  COALESCE(VACATIONS.workyearbeg,#Date(0,0,0))<>#Date(0,0,0) and workperiod1.Nrec is Null
ORDER BY VACATIONS.workyearbeg;
//-----------------------------------------------
// Добавим рабочие периоды до текущей даты,
//-----------------------------------------------
sql
insert into workperiod (cperson,WTYPEPERIOD, dperbeg, dperend, CAPPOINTMENT)
// берем следующие периоды
 select
    persons.nrec, 0
    //,persons.appdate+(nums-1)*256*256
    ,CASE WHEN COALESCE(S.dperbeg,#Date(0,0,0))=#Date(0,0,0) THEN persons.appdate ELSE S.dperbeg+256*256 END+(nums-1)*256*256
    //,date(from_days(TO_DAYS(datetime(persons.appdate+nums*256*256,0))-1))
   //,date(from_days(TO_DAYS(datetime(COALESCE(S.dperbeg+256*256,persons.appdate)+nums*256*256,0))-1))
   ,date(from_days(TO_DAYS(datetime(
     CASE WHEN COALESCE(S.dperbeg,#Date(0,0,0))=#Date(0,0,0) THEN persons.appdate ELSE S.dperbeg+256*256 END+nums*256*256,0))-1))
   ,persons.appointcur
//---------------
//,S.cPerson,persons.fio, persons.appdate, appdate +nums*256*256, nums,S.dperbeg
from (
select top 100 nums nums from
(
select count(*) nums
from persons inner join persons persons1 ON persons1.nrec<=persons.nrec
where COALESCE(persons.appdate,#Date(0,0,0))<>#Date(0,0,0)
group by persons.nrec
) nums
order by nums
) nums
inner join persons On (2018- CAST(DATE2STR('%yyyy',COALESCE(persons.APPDATE,#date(1,1,2000))) as word))>=nums
Left outer join ( Select workperiod.cPerson as cPerson , Max(workperiod.dperbeg) as dperbeg  from workperiod
        inner join appointments on appointments.nrec = workperiod.cAppointment and appointments.LPrizn=0
        where workperiod.WTYPEPERIOD=0
        group by workperiod.cPerson  ) S on S.cPerson = persons.nrec
//Left outer join workperiod workperiod1 on workperiod1.cperson = persons.nrec
//  and workperiod1.dperbeg>=COALESCE(S.dperbeg+256*256,persons.appdate)
 // and workperiod1.dperbeg<=date(from_days(TO_DAYS(datetime(COALESCE(S.dperbeg,persons.appdate)+nums*256*256,0))-1))
where //workperiod1.Nrec is Null and
 persons.appdate<>0
#flt_Persons
and CASE WHEN COALESCE(S.dperbeg,#Date(0,0,0))=#Date(0,0,0) THEN persons.appdate ELSE S.dperbeg+256*256 END+(nums-1)*256*256<CurDate
order by persons.FIO, COALESCE(S.dperbeg+256*256,persons.appdate)+(nums-1)*256*256
;



//-----------------------------------------------
// сгенерим на соместителей
SQL
insert into workperiod (cperson,WTYPEPERIOD, dperbeg, dperend, CAPPOINTMENT)
// берем следующие периоды
 select Distinct
    persons.nrec, 0
    //,persons.appdate+(nums-1)*256*256
    ,CASE WHEN COALESCE(S.dperbeg,#Date(0,0,0))=#Date(0,0,0) THEN Appointments.AppointDate ELSE S.dperbeg+256*256 END+(nums-1)*256*256
    //,date(from_days(TO_DAYS(datetime(persons.appdate+nums*256*256,0))-1))
   //,date(from_days(TO_DAYS(datetime(COALESCE(S.dperbeg+256*256,persons.appdate)+nums*256*256,0))-1))
   ,date(from_days(TO_DAYS(datetime(
     CASE WHEN COALESCE(S.dperbeg,#Date(0,0,0))=#Date(0,0,0) THEN Appointments.AppointDate ELSE S.dperbeg+256*256 END+nums*256*256,0))-1))
   ,Appointments.Nrec
//---------------
//,S.cPerson,persons.fio, persons.appdate, appdate +nums*256*256, nums,S.dperbeg
from (
select top 100 nums nums from
(
select count(*) nums
from persons inner join persons persons1 ON persons1.nrec<=persons.nrec
where COALESCE(persons.appdate,#Date(0,0,0))<>#Date(0,0,0)
group by persons.nrec
) nums
order by nums
) nums
inner join persons On (2018- CAST(DATE2STR('%yyyy',COALESCE(persons.APPDATE,#date(1,1,2000))) as word))>=nums
inner join Appointments on Appointments.Person = Persons.Nrec and appointments.LPrizn=3
       and Appointments.AppointDate in
        (select max(Appointments2.AppointDate)
              from Appointments Appointments2 where Appointments2.Person = Persons.Nrec and appointments2.LPrizn=3
                and COALESCE(Appointments.DisMissDate,#Date(0,0,0))=#Date(0,0,0)
        )
//по совместителям не по всем есть отпуска
inner join ( Select workperiod.cPerson as cPerson , Max(workperiod.dperbeg) as dperbeg  from workperiod
        inner join appointments on appointments.nrec = workperiod.cAppointment and appointments.LPrizn=3
        where workperiod.WTYPEPERIOD=0
        group by workperiod.cPerson  ) S on S.cPerson = persons.nrec
//Left outer join workperiod workperiod1 on workperiod1.cperson = persons.nrec
//  and workperiod1.dperbeg>=COALESCE(S.dperbeg+256*256,persons.appdate)
 // and workperiod1.dperbeg<=date(from_days(TO_DAYS(datetime(COALESCE(S.dperbeg,persons.appdate)+nums*256*256,0))-1))
where workperiod.WTYPEPERIOD=0 and  workperiod1.Nrec is Null and
 Appointments.AppointDate<>0
#flt_Persons
and CASE WHEN COALESCE(S.dperbeg,#Date(0,0,0))=#Date(0,0,0) THEN Appointments.AppointDate ELSE S.dperbeg+256*256 END +(nums-2)*256*256<CurDate
order by persons.nrec
 ,CASE WHEN COALESCE(S.dperbeg,#Date(0,0,0))=#Date(0,0,0) THEN Appointments.AppointDate ELSE S.dperbeg+256*256 END+(nums-1)*256*256
;


//------------------------------------
// удалим если вдруг есть большие периоды
SQL delete from workperiod where workPeriod.Nrec in
( select workPeriod1.Nrec From workPeriod workPeriod1  inner join Persons on workPeriod1.cPerson = Persons.Nrec
  where workPeriod1.cPerson=workperiod.cperson #flt_Persons and workPeriod1.dperbeg>CurDate+256*256 // на 4 месяца

) ;
*/
