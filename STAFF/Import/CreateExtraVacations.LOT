create table D_USER.EM_EXTRAVAC "Таблица EM_EXTRAVAC"
  using "EM_EXVAC.dat"
!  component USER
  with table_Code = 31741
  with tableOptions header, journal, corpo
  (
   E0001 : LongInt "ID Записи",
   E0002 : string[100] "Статус",
   E0003 : Integer "Календарные дни",
   E0004 : date "Период Предоставления отпуска (начало)",
   E0005 : Date "Период Предоставления отпуска (конец)",
   E0006 : LongInt "ID физического лица"





  )
  with index
  (
   i_E0001=E0001,
   i_E0002=E0002,
   i_E0003=E0003,
   i_E0004=E0004,
   i_E0005=E0005,
   i_E0006=E0006
  );
