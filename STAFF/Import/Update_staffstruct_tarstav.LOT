sql
update staffstruct set  staffstruct.TAXRATE= em_staffstruct.s0017
!select staffstruct.TAXRATE,  em_staffstruct.s0017
from staffstruct inner join em_staffstruct On em_staffstruct.s0001=staffstruct.cinf3
where staffstruct.TAXRATE=0
;



sql
update appointments set  appointments.TARIFF=staffstruct.tariff, appointments.TAXRATE= staffstruct.TAXRATE

!select appointments.tariff, staffstruct.tariff, appointments.TAXRATE, staffstruct.TAXRATE
from staffstruct inner join appointments On appointments.staffstr=staffstruct.nrec
!inner join tarstav On Tarstav.nrec=staffstruct.tariff
;

sql
update apphist set  apphist.TARIFF=staffstruct.tariff, apphist.TAXRATE= staffstruct.TAXRATE

!select appointments.tariff, staffstruct.tariff, appointments.TAXRATE, staffstruct.TAXRATE
from staffstruct inner join appointments On appointments.staffstr=staffstruct.nrec
inner join apphist On apphist.cappoint=appointments.nrec
!inner join tarstav On Tarstav.nrec=staffstruct.tariff
;
