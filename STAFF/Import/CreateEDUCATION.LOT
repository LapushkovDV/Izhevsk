create table D_USER.EM_EDUCATION "Таблица EM_EDUCATION"
  using "EM_EDUC.dat"
!  component USER
  with table_Code = 31714
  with tableOptions header, journal, corpo
  (
   E0000 : LongInt "ID физического лица",
   E0001 : String [60] "Тип документа об образовании",
   E0002 : String [20] "Серия документа",
   E0003 : String [20] "Номер документа",
   E0004 : Date "Дата выдачи",
   E0005 : String [255] "Наимен. образов., науч. учр.",
   E0006 : String [255] "Специальность и квалификация",
   E0007 : Longint "Год поступления",
   E0008 : Longint "Год окончания",
   E0009 : String [50] "Форма обучения",
   E0010 : String [255]    "Специальность",
   E0011 : String  "Ученая степень",
   E0012 : String  "Вид Образования",
   E0013 : String  "Квалификация",
   E0014 : String  "Форма подготовки"



  )
  with index
  (
   i_E0000=E0000,
   i_E0001=E0001,
   i_E0002=E0002,
   i_E0003=E0003,
   i_E0004=E0004,
   i_E0005=E0005,
   i_E0006=E0006,
   i_E0007=E0007,
   i_E0008=E0008,
   i_E0009=E0009,
   i_E0010=E0010,
   i_E0011=E0011,
   i_E0012=E0012,
   i_E0013=E0013,
   i_E0014=E0014


   );