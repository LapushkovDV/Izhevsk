//вставляем в штатное расписание
/*
SQL
//insert into RaiseSts (STAFFSTR,RAISETYPE,DAT1,DAT2 )
Select Distinct
   StaffStruct.Nrec  //STAFFSTR
  ,Catalogs.Nrec     //RAISETYPE
  ,STAFFSTRUCT.DINPUT//DAT1
  ,STAFFSTRUCT.DCLOSE//DAT2
   //--------------
  , Persons.fio
From Persons
inner join    EM_VREDNEMP on EM_VREDNEMP.CITEZENID=Persons.DISPROFNMB
          and EM_VREDNEMP.SUMMA>0
inner join    EM_Person on EM_Person.P0001 = EM_VREDNEMP.EMPLOYEEID
inner join StaffStruct on  StaffStruct.cnewspr3 = EM_Person.P0031
inner join Catalogs CatSys on CatSys.SysCode= -17
inner join Catalogs on Catalogs.lpr=0 and Catalogs.MainLink=CatSys.Nrec and Catalogs.Name='Доплата за вредность'
Left Outer join RaiseSts on RaiseStS.StaffStr=StaffStruct.Nrec and RaiseSTS.RAISETYPE =Catalogs.Nrec
where RaiseSts.Nrec is Null
//to dbf c:\1\RaiseSts.dbf
;

//----------------------------------------
//RaiseAlg
SQL
insert into RaiseAlg (RAISESTST,SUM,RAISECURR,RAISEATTR,YEARS,MONTHS,DAYS,DR1,DR2)
select Distinct
 RaiseSts.Nrec //RAISESTST            //│Доплата по ставке
,EM_VREDNEMP.SUMMA //SUM                  //│Сумма
,0//RAISECURR            //│Валюта оплаты
,CASE WHEN EM_VREDNEMP.SUMMA<30 THEN 2 ELSE 0 END //RAISEATTR            //│Доплата по сумме или в процентах?
,0 //YEARS                //│YEARS
,0 //MONTHS               //│MONTHS
,0 //DAYS                 //│DAYS
,#date(0,0,0)// DR1                  //│Дата с
,#date(0,0,0)// DR2 │Дата по
From Persons
inner join    EM_VREDNEMP on EM_VREDNEMP.CITEZENID=Persons.DISPROFNMB
          and EM_VREDNEMP.SUMMA>0
inner join    EM_Person on EM_Person.P0001 = EM_VREDNEMP.EMPLOYEEID
inner join StaffStruct on  StaffStruct.cnewspr3 = EM_Person.P0031
inner join Catalogs CatSys on CatSys.SysCode= -17
inner join Catalogs on Catalogs.lpr=0 and Catalogs.MainLink=CatSys.Nrec and Catalogs.Name='Доплата за вредность'
inner join RaiseSts on RaiseStS.StaffStr=StaffStruct.Nrec and RaiseSTS.RAISETYPE =Catalogs.Nrec
left outer join RaiseAlg on RaiseAlg.RAISESTST =RaiseSts.Nrec
where RaiseAlg.Nrec is Null ;
*/

//вставляем доплату сотрудникам
SQL
insert into Raise (PERSON,APPOINT,RAISETYPE,ORDERNMB1,ORDERDATE1,FROMDATE,SUM,RAISECURR
     ,RAISEATTR,TODATE,ORDERNMB2,ORDERDATE2,WADDWORD,CSTRAISE)
Select
  Persons.Nrec      //PERSON
 ,Appointments.Nrec //APPOINT              //│Назначение и перемещение
 ,Catalogs.Nrec//RAISETYPE            //│Вид доплаты/надбавки
,''//ORDERNMB1            //│N приказа на доплату
,#date(0,0,0) //ORDERDATE1           //│Дата приказа на доплату
,Appointments.AppointDate //FROMDATE             //│С даты
,EM_VREDNEMP.SUMMA //SUM                  //│Сумма
,0 //RAISECURR            //│Валюта оплаты
,CASE WHEN EM_VREDNEMP.SUMMA<30 THEN 2 ELSE 0 END//RAISEATTR            //│Доплата по сумме или в процентах
,Appointments.DisMissDate //TODATE               //│По дату
,'' //ORDERNMB2            //│N приказа на отмену доплаты
,#date(0,0,0)  //ORDERDATE2           //│Дата приказа на отмену доплаты
,0 //WADDWORD             //│Резерв
,RaiseSts.Nrec //CSTRAISE             //│Доплата по ШР
From Persons
inner join    EM_VREDNEMP on EM_VREDNEMP.CITEZENID=Persons.DISPROFNMB
          and EM_VREDNEMP.SUMMA>0
inner join    EM_Person on EM_Person.P0001 = EM_VREDNEMP.EMPLOYEEID
inner join    Appointments on Appointments.cref3 = EM_Person.P0001
inner join StaffStruct on  StaffStruct.cnewspr3 = EM_Person.P0031
inner join Catalogs CatSys on CatSys.SysCode= -17
inner join Catalogs on Catalogs.lpr=0 and Catalogs.MainLink=CatSys.Nrec and Catalogs.Name='Доплата за вредность'
inner join RaiseSts on RaiseStS.StaffStr=StaffStruct.Nrec and RaiseSTS.RAISETYPE =Catalogs.Nrec
left outer join Raise on Raise.Appoint = Appointments.Nrec and Raise.Person=Persons.Nrec and Raise.RAISETYPE =Catalogs.Nrec
where Raise.Nrec is Null
;

