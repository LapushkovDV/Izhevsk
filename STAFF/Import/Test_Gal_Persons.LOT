
// перемещения сотрудников
sql
select
!count(*)
  case  when (P0007='Основное место работы') then  0
        when (P0007='Внешнее совместительство') then  1
   end,

persons.nrec, lschet.nrec, em_person.P0009, em_person.P0012, em_person.P0003, em_person.P0009, 0 ,em_person.P0003-1, staffstruct.department
,staffstruct.post, staffstruct.tariff, empcategory, paymodel,0,staffstruct.WORKREGIME
,Tarstav.tarif, 1, staffstruct.nrec, 3, 1, 1, persons.tabnmb, em_person.p0001
from em_person  inner join persons On em_person.p0030=persons.DISPROFNMB
     and (em_person.p0007='Основное место работы' or P0007='Внешнее совместительство')
inner join katpodr On Katpodr.FIO_GB=em_person.p0016
inner join staffstruct  On em_person.p0031 = Staffstruct.cInf3
inner join klsovm On em_person.p0007 = klsovm.nsovm   and (klsovm.sovm=0 or klsovm.sovm=1)
inner  join lschet On Lschet.tperson=persons.nrec and (lschet.sovm=0 or lschet.sovm=1)//and lschet.datpos=em_person.p0003// and lschet.cex=katpodr.nrec
left join tarstav On Tarstav.nrec= staffstruct.tariff
where not exists
(select * from persons where persons.FilialNO=em_person.p0001)
and persons.fio='Тимонина Светлана Ивановна'
!and not exists
!(select max(p0003) p0003 from em_person p1 group by p0030 having p1.p0030=em_person.p0030 and max(P1.p0003)=em_person.p0003 and em_person.p0011=0)
!and (em_person.p0011=0)
;
