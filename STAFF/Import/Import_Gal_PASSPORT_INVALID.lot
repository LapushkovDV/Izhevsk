sql
delete from passports
where syscode = 560
;

sql
insert into passports (ser, nmb, givendate, givenby, person, syscode)
select distinct iv002, case when instr(' ®', iv003)>0 then substring(iv003,1,instr(' ®', iv003)) else iv003 end, iv004, iv005, persons.nrec, 560
from em_invalid
inner join persons on persons.disprofnmb = em_invalid.iv001
;

sql
update passports set passports.docname = catalogs.nrec
from catalogs
where passports.syscode=560 and catalogs.syscode=560
;

sql
update passports set passports.givenpodr = cast(int64(catalogs.nrec) as string)
from catalogs
inner join em_invalid on em_invalid.iv006 = catalogs.name
inner join persons on persons.disprofnmb = em_invalid.iv001
inner join catalogs catalogsMain On catalogs.MainLink=CatalogsMain.nrec and catalogsmain.syscode=-20
inner join passports on passports.person = persons.nrec
where passports.syscode=560
;

sql
update persons set persons.invalidgrp = catalogs.nrec
from catalogs
inner join em_invalid on em_invalid.iv006 = catalogs.name
inner join persons on persons.disprofnmb = em_invalid.iv001
inner join catalogs catalogsMain On catalogs.MainLink=CatalogsMain.nrec and catalogsmain.syscode=-20
inner join passports on passports.person = persons.nrec
where passports.syscode=560
;
