sql
insert into catalogs (groupcode, syscode, name, code, ISLEAF, DATN, datok, SDOPINF, DOPSTR, LONGNAME, catdata, mainlink, cparent, CREF3)
select
!distinct
em_catalogsexp1.groupcode, em_catalogsexp1.syscode, em_catalogsexp1.name, em_catalogsexp1.code
,em_catalogsexp1.ISLEAF, em_catalogsexp1.DATN, em_catalogsexp1.datok
,em_catalogsexp1.SDOPINF, em_catalogsexp1.DOPSTR, em_catalogsexp1.LONGNAME, em_catalogsexp1.catdata
!, catalogsmain.nrec, catalogsparent.nrec
,em_catalogsexp.nrec, em_catalogsexp.nrec
,em_catalogsexp1.nrec
!,em_catalogsexpparent.syscode, em_catalogsexpmain.syscode
!,em_catalogsexpparent.name, em_catalogsexpmain.name

from catalogs inner join em_catalogsexp On em_catalogsexp.name=catalogs.name and em_catalogsexp.syscode=catalogs.syscode
              and catalogs.nrec=em_catalogsexp.nrec
inner join em_catalogsexp em_catalogsexp1 On em_catalogsexp1.parnrec=em_catalogsexp.nrec
left join catalogs catalogsnew On catalogsnew.name=em_catalogsexp1.name
     and  catalogsnew.syscode=em_catalogsexp1.syscode and catalogsnew.cref3=em_catalogsexp1.nrec
where catalogsnew.nrec is null
;



sql
!insert into catalogs (groupcode, syscode, name, code, ISLEAF, DATN, datok, SDOPINF, DOPSTR, LONGNAME, catdata, mainlink, cparent, CREF3)
select
!distinct
em_catalogsexp1.groupcode, em_catalogsexp1.syscode, em_catalogsexp1.name, em_catalogsexp1.code
,em_catalogsexp1.ISLEAF, em_catalogsexp1.DATN, em_catalogsexp1.datok
,em_catalogsexp1.SDOPINF, em_catalogsexp1.DOPSTR, em_catalogsexp1.LONGNAME, em_catalogsexp1.catdata
!, catalogsmain.nrec, catalogsparent.nrec
,catalogsmain.nrec, catalogsparent.nrec
,em_catalogsexp1.nrec
!,em_catalogsexpparent.syscode, em_catalogsexpmain.syscode
!,em_catalogsexpparent.name, em_catalogsexpmain.name

from  em_catalogsexp inner join em_catalogsexp em_catalogsexp1 On em_catalogsexp1.parnrec=em_catalogsexp.nrec
inner join catalogs catalogsparent On catalogsparent.cref3=em_catalogsexp1.parnrec
left join catalogs catalogsmain   On catalogsmain.cref3=em_catalogsexp1.mainnrec
left join catalogs catalogsnew On catalogsnew.name=em_catalogsexp1.name
     and  catalogsnew.syscode=em_catalogsexp1.syscode and catalogsnew.cref3=em_catalogsexp1.nrec
where catalogsnew.nrec is null
;



