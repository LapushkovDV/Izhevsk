//Загрузка истории Catalogs для Стуктуры штатного расписания
sql
insert into cathist (CCAT, CODE, CPARENT, Name, NParent, Dat1, WFLD1 )
select catalogs.Nrec, catalogs.code, catalogs.cparent, catalogs.Name, catalogsParent.Name,catalogs.DATn,1
from catalogs inner join catalogs catalogsParent On catalogsParent.Nrec=catalogs.cParent
inner join catalogs catalogsMain On catalogs.mainlink=catalogsMain.Nrec and catalogsmain.syscode=-11
left join cathist cathist1 On cathist1.ccat=catalogs.nrec and cathist1.cparent=catalogs.cparent
where cathist1.nrec is null
;

