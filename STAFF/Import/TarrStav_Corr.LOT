#Define _No_Update_

#IFDEF _UPDATE_
SQL update Appointments set Appointments.TARIFF = TarStav_New.Nrec
From Appointments
inner join TarStav on TarStav.Nrec = Appointments.TARIFF
inner join TarStav TarStav_New on TarStav_New.NAITAR = TarStav.NAITAR and TarStav_New.DatIzm=#date(01,09,2017)
where  TarStav_New.DatIzm<>TarStav.DatIzm and Appointments.AppointDate>=#date(1,9,2017);
#ENDIF

SQL
#IFDEF _UPDATE_
update Appointments set Appointments.TARIFF = TarStav_New.Nrec
#ELSE
select SubString(persons.Fio,1,40), TarStav.DatIzm,SubString(TarStav.NAITAR,1,20),TarStav_New.datizm
#ENDIF
from Persons
inner join Appointments on Appointments.Person = Persons.nrec
 and (Appointments.DisMissDate=#date(0,0,0) or Appointments.DisMissDate>=#date(1,9,2017))
inner join (select max(App.AppointDate) as AppDate,App.lPrizn,App.Person
  From Appointments App group by App.Person, App.Lprizn
) App_Max on App_Max.Person = Persons.Nrec and App_Max.Lprizn = Appointments.Lprizn
  and App_Max.AppDate = Appointments.AppointDate
inner join TarStav on TarStav.Nrec = Appointments.TARIFF
#IFDEF _UPDATE_
inner
#ELSE
left outer
#ENDIF
join  TarStav TarStav_New on TarStav_New.NAITAR = TarStav.NAITAR and TarStav_New.DatIzm=#date(01,09,2017)
where
#IFDEF _UPDATE_
 TarStav_New.DatIzm<>TarStav.DatIzm
#ELSE
    (Appointments.DISMISSDATE=#date(0,0,0) or Appointments.DISMISSDATE>=#date(1,9,2017))
and  TarStav.DatIzm<#date(1,9,2017)
and ((TarStav_New.nrec is Null) or TarStav_New.DatIzm<>TarStav.DatIzm)
#ENDIF
;


SQL
#IFDEF _UPDATE_
Update StaffStruct set StaffStruct.TARIFF = TarStav_New.Nrec
#ELSE
select SubString(CatDep.name,1,40),SubString(CatDep.CODE,1,10), TarStav.DatIzm,SubString(TarStav.NAITAR,1,20),TarStav_New.datizm,StaffStruct.DInput,StaffStruct.Dclose
#ENDIF
from StaffStruct
inner join TarStav on TarStav.Nrec = StaffStruct.TARIFF
inner join Catalogs CatDep on CatDep.nrec = Staffstruct.Department
#IFDEF _UPDATE_
inner
#ELSE
left outer
#ENDIF
join  TarStav TarStav_New on TarStav_New.NAITAR = TarStav.NAITAR and TarStav_New.DatIzm=#date(01,09,2017)
where
#IFDEF _UPDATE_
    (StaffStruct.Dclose=#date(0,0,0) or StaffStruct.Dclose>=#date(1,9,2017))
and TarStav.DatIzm<#date(1,9,2017)
and TarStav_New.DatIzm<>TarStav.DatIzm

#ELSE
    (StaffStruct.Dclose=#date(0,0,0) or StaffStruct.Dclose>#date(1,10,2017))
and TarStav.DatIzm<#date(1,9,2017)
and ((TarStav_New.nrec is Null) or TarStav_New.DatIzm<>TarStav.DatIzm)
#ENDIF
;