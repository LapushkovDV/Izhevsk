create table D_USER.EM_INVALID "Таблица EM_INVALID"

  using "EM_INVA.dat"
!  component USER
  with table_Code = 31716
  with tableOptions header, journal, corpo
  (
   IV001 : LongInt "ID физ. лица",
   IV002 : string [40]  "Серия документа об инвалидности",
   IV003 : string [40] "Номер документа об инвалидности",
   IV004 : date "Дата документа об инвалидности",
   IV005 : string "Кем выдан документ",
   IV006 : string [20] "Группа инвалидности",
   IV007 : longint "ID сотрудника"

  )
  with index
  (
   i_IV001=IV001,
   i_IV002=IV002,
   i_IV003=IV003,
   i_IV004=IV004,
   i_IV005=IV005,
   i_IV006=IV006,
   i_IV007=IV007

  );