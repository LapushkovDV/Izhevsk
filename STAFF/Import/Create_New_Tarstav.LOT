create table D_USER.NewTARSTAV "Таблица NewTARSTAV"
  using "N_TARST.dat"
!  component USER
  with table_Code = 31700
!  with tableOptions  header, journal, corpo
  (
   NREC : Comp "Номер записи",

   ATL_BRANCH : comp "Филиал",
   LASTUSER : String [20] "LASTUSER",
   LASTTIME : time "LASTTIME",
   LASTDATE : date "LASTDATE",

   FILIALNO : LongInt "FILIALNO",
   CODTAR : Word "Код тарифа",
   NAITAR : String [100] "Наим.тарифа(профессия)",
   SISOPL : Word "Код системы оплаты",
   RAZR   : Word "Разряд",
   KOLMIN : decimal [38,15]  "Коэф. перерасчета",
   TARIF : decimal [38,15]  "Тарифная ставка",
   KOLM : decimal [38,15] "Коэф.для мин.гарантир.окл.",
   TARMIN : decimal [38,15]    "Мин.гарантир.оклад",
   RAZRN : word    "Код разряда",
   DATIZM : Date "Дата изменения",
   TARMAX : decimal [38,15] "Максимальный оклад",
   SUMMA1 : decimal [38,15] "Доп. поле 1",
   SUMMA2 : decimal [38,15] "Доп. поле 2",
   SFIELD1 : string "Доп. поле 3",
   LFIELD1 : longint "Доп. поле 4"
  )

  with index
  (
  TARSTAV02 =  NREC(Unique, Surrogate, Journal),
  TARSTAVLM =  ATL_LASTDATE + ATL_LASTTIME,
  TARSTAVLU =  ATL_LASTUSER,
  TARSTAV01 =  SISOPL(Unique) + CODTAR(Unique) + RAZR(Unique) + DATIZM(Unique),
  TARSTAV03 =  DATIZM(Desc) + SISOPL + CODTAR + RAZR
  )
  ;

! alter table ::NEWTARSTAV
!  delete index ( NEWTARSTAVID )
!  delete index ( NEWTARSTAVLM )
!  delete index ( NEWTARSTAVLU )
!  ;
