create table D_USER.EM_CONSCRIPTION "Таблица EM_CONSCRIPTION"
  using "EM_CONSC.dat"
!  component USER
  with table_Code = 31710
  with tableOptions header, journal, corpo
  (
   C0001 : LongInt "ID физического лица",
   C0002 : String [100] "Категория запаса",
   C0003 : String [100] "Звание",
   C0004 : String [100] "Состав (профиль)",
   C0005 : String [100] "Полное кодовое обозначение ВУС",
   C0006 : String [100] "Категория годности к военной службе",
   C0007 : String [255] "Наим. военн. комис. по месту жител.",
   C0008 : String [100] "Общий учет (номер команды, партии)",
   C0009 : String [100] "Специальный учет",
   C0010 : String [100] "Наименование вида воинского учета",
   C0011 : String [100] "Отметка о снятии с учета",
   C0012 : String [100] "Воинская обязанность"


  )
  with index
  (
   i_C0001=C0001,
   i_C0002=C0002,
   i_C0003=C0003,
   i_C0004=C0004,
   i_C0005=C0005,
   i_C0006=C0006,
   i_C0007=C0007,
   i_C0008=C0008,
   i_C0009=C0009,
   i_C0010=C0010,
   i_C0011=C0011,
   i_C0012=C0012

   );