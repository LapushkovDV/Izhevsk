// Обновление категорий работников
/*
sql
update staffstruct set staffstruct.category=tarstav.razr
                        ,staffstruct.empcategory=KlKatego.nrec
!select klkatego.naikat, klkatego.kod, tarstav.razr, staffstruct.category
from
(
select max(atl_nrec) MaxNrec
from em_staffstruct
group by s0001
) S1 inner join em_staffstruct On em_staffstruct.Atl_nrec=S1.MaxNrec
inner join staffstruct On staffstruct.cnewspr3=em_staffstruct.s0001
inner join tarstav On tarstav.nrec=staffstruct.TARIFF
!left join klrejim  On klrejim.rejim=em_staffstruct.s0021
left join KlKatego On KlKatego.Kod=em_staffstruct.s0016
where
klkatego.nrec is not null
!and em_staffstruct.s0024='Активный'  and em_staffstruct.s0028='Активный'
;
*/

/*
sql
update appointments set   appointments.empcategory=staffstruct.empcategory
!select appointments.empcategory, staffstruct.empcategory
from appointments inner join staffstruct On appointments.staffstr=staffstruct.nrec
where appointments.empcategory<>staffstruct.empcategory
;
*/

/*
sql
update apphist set   apphist.cspr4=appointments.empcategory
!select appointments.empcategory, apphist.cspr4
from apphist inner join appointments  On appointments.nrec=apphist.cappoint
where apphist.cspr4<>appointments.empcategory
;
*/


// Обновление режимов работы
/*
sql
update staffstruct set staffstruct.workregime=klrejim.nrec
!select klrejim.rejim, klrejim1.rejim, staffstruct.workregime
from
(
select max(atl_nrec) MaxNrec
from em_staffstruct
group by s0001
) S1 inner join em_staffstruct On em_staffstruct.Atl_nrec=S1.MaxNrec
inner join staffstruct On staffstruct.cnewspr3=em_staffstruct.s0001
left join klrejim  On klrejim.rejim=em_staffstruct.s0021
left join klrejim  klrejim1 On klrejim1.nrec=staffstruct.workregime
where
klrejim.nrec is not null
and klrejim.rejim<>klrejim1.rejim
!and em_staffstruct.s0024='Активный'  and em_staffstruct.s0028='Активный'
;
*/

/*
sql
update  historystr set   historystr.cworkregim=staffstruct.workregime
!select staffstruct.workregime, historystr.cworkregim
from staffstruct inner join historystr On staffstruct.nrec=historystr.staffstr
where  staffstruct.workregime<>historystr.cworkregim
;
*/
/*
sql
update appointments set   appointments.workregime=staffstruct.workregime
!select appointments.workregime, staffstruct.workregime
from appointments inner join staffstruct On appointments.staffstr=staffstruct.nrec
where appointments.workregime<>staffstruct.workregime
;
*/

