!  Загрузка в catalogs видов повышения квалификации

sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name)
select distinct catalogskisparent.nrec, catalogskisparent.nrec, 0, 0, EDTYPE
from em_skillup Ed
inner join catalogs catalogskisParent On  catalogsKisParent.Syscode=702

where length(Edtype)>0 and length(id)>1
and Edtype not in
(
select distinct Edtype education
from
EM_SKILLUP  Ed inner join catalogs catalogsKis On CatalogsKis.Name= Ed.Edtype
inner join catalogs catalogskisParent On catalogsKis.cparent=CatalogsKisParent.nrec and catalogsKisParent.Syscode=702
)
;




// Предварительная загрузка в catalogs  видов документов об образовании


sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name)
select distinct catalogsKisMain.nrec, catalogsKisMain.nrec, 0, 0, doctype
from em_skillup Ed inner join catalogs catalogskisMain   On catalogsKisMain.Syscode=-5
where length(doctype)>0 and length(id)>1
and  DocType not in
(
select distinct doctype education
from
EM_skillup  Ed inner join catalogs On Catalogs.Name= Ed.doctype
inner   join catalogs catalogsMainLink ON catalogsMainLink.syscode=-5 and catalogsMainlink.nrec = Catalogs.mainlink
)
and length(doctype)>0
;





// Предварительная загрузка в catalogs -  Учебные заведения
sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name)
select distinct catalogsKisMain.nrec, catalogsKisMain.nrec, 0, 0, ORGANISAT
from em_skillup Ed inner join catalogs catalogskisMain   On catalogsKisMain.Syscode=-24
where ORGANISAT   not in
(
select distinct ORGANISAT
from
EM_Skillup  Ed inner join catalogs On Catalogs.Name= Ed.ORGANISAT
inner   join catalogs catalogsMainLink ON catalogsMainLink.syscode=-24 and catalogsMainlink.nrec = Catalogs.mainlink
)
and length(ORGANISAT)>0
;


// Предварительная загрузка в catalogs -  Специальность
sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name)
select distinct catalogsKisMain.nrec, catalogsKisMain.nrec, 0, 0, JOBTITLE

from em_skillup Ed inner join catalogs catalogskisMain   On catalogsKisMain.Syscode=-32
where JOBTITLE   not in
(
select distinct JOBTITLE
from
EM_Skillup  Ed inner join catalogs On Catalogs.Name= Ed.JOBTITLE
inner   join catalogs catalogsMainLink ON catalogsMainLink.syscode=-32 and catalogsMainlink.nrec = Catalogs.mainlink
)
and length(JOBTITLE)>0
;






