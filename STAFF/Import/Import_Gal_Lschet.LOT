/*
sql
delete from lschet where lschet.nrec in (select lschet1.nrec from lschet lschet1 inner join em_person on em_person.p0001 = lschet1.schp2);
*/

// Загрузка, до загрузка новых лицевых счетов

sql

insert into lschet (schp2, datpos, datuv, strtabn, tabdop[10], tperson)
select distinct ls.*
from (
select
em_person.p0001 p0001, em_person.p0003 p0003, em_person.p0009 p0009, em_person.p0026 p0026, min(em_person.p0030) p0030, persons.nrec nrec
!,min(em_person.p0002) p0002
from em_person  inner join
(
select
min(em_person2.P0001) p0001min
from em_person em_person2
inner join
(
select  em_person.p0030 p0030,  min(em_person.p0003) datamin
from  em_person
where (em_person.p0007 = 'Основное место работы' or  p0007 = 'Внешнее совместительство')
group by   em_person.p0030
) em_person1  On em_person2.p0030=em_person1.p0030  and
em_person2.p0003=em_person1.datamin
group by em_person2.p0030, em_person2.p0003, em_person2.p0007
)  em_person3 On em_person3.p0001min=em_person.p0001
    and  (em_person.p0007 = 'Основное место работы' or  p0007 = 'Внешнее совместительство')
inner join persons on persons.disprofnmb = em_person.p0030
!where p0002='Тимонина Светлана Ивановна'
group by em_person.p0001, em_person.p0003, em_person.p0009, em_person.p0026, persons.nrec

union

select

em_person.p0001, em_person.p0003, em_person.p0009, em_person.p0026, min(em_person.p0030), persons.nrec
!,min(em_person.p0002) p0002
from em_person
inner join persons on persons.disprofnmb = em_person.p0030
where p0007 = 'Внутреннее совместительство' or p0007 = 'По договору подряда'// or p0007 = 'Договор услуг'// or p0007 = 'Админ. отпуск'
!and p0002='Тимонина Светлана Ивановна'
group by em_person.p0001, em_person.p0003, em_person.p0009, em_person.p0026, persons.nrec
) ls  left join lschet lschet1 On lschet1.schp2=ls.p0001   and lschet1.tabdop[10]=ls.p0030
where lschet1.nrec is null
!order by p0002
;


