
sql
delete from catalogs where catalogs.nrec in
(
select catalogs.nrec from catalogs inner join catalogs catalogsmain On catalogsmain.nrec=catalogs.cparent
       and (catalogsmain.syscode=-126 or        catalogsmain.syscode=-124)
)
;




sql
insert into catalogs  (mainlink, cparent, GROUPCODE, SYSCODE, Name)
select
distinct
catalogsMain.nrec, catalogsMain.nrec, catalogsMain.groupcode, 0, em_attestation.COURSENAME

from em_attestation inner join catalogs catalogsMain On catalogsMain.syscode=-126
left join catalogs catalogschek On catalogschek.name=em_attestation.COURSENAME
!where em_attestation.COURSENAME like '%аттестац%'
and  catalogschek.nrec is null
;


sql delete from  attestation;
sql
insert into attestation (attnmb, attdate, ctype)
select distinct substring(docnumb,1,20), docdate, catalogs.nrec
from em_attestation inner join catalogs On catalogs.name=em_attestation.COURSENAME
inner join catalogs catalogsMain On catalogsmain.nrec=catalogs.mainlink and catalogsmain.syscode=-126
;


sql update  em_attestation set rating='не установлен' where  length(rating)=0; //and em_attestation.COURSENAME like '%аттестац%';


sql
insert into catalogs  (mainlink, cparent, GROUPCODE, SYSCODE, Name)
select
distinct
catalogsMain.nrec, catalogsMain.nrec, catalogsMain.groupcode, 0, replace(em_attestation.rating,'.','')

from em_attestation inner join catalogs catalogsMain On catalogsMain.syscode=-124
left join catalogs catalogschek On catalogschek.name=replace(em_attestation.rating,'.','')
!where em_attestation.COURSENAME like '%аттестац%'
and  catalogschek.nrec is null
;





sql delete from planatt;
sql
insert into planatt (cpers, dat1, cdepart, ckateg, ctype, wcod, cref2, ddop1, cref3)
select
distinct
!persons.fio, em_attestation.COURSENAME,
persons.nrec, em_attestation.eventdate, appointments.department, appointments.EMPCATEGORY, catalogsRat.nrec,
1,  post, attestation.attdate,  attestation.nrec

!,attestation.nrec, catalogsname.name, catalogsrat.name, attestation.attnmb, attestation.attdate, ,appointments.department
from em_attestation inner join catalogs catalogsName On catalogsName.name=em_attestation.COURSENAME
!     and em_attestation.COURSENAME like '%аттестац%'
inner join catalogs catalogsNameMain On catalogsNamemain.nrec=catalogsName.mainlink and catalogsNamemain.syscode=-126
inner join attestation On attestation.ctype=catalogsname.nrec and attestation.attnmb=substring(em_attestation.docnumb,1,20)
           and   attestation.attdate=em_attestation.docdate
inner join catalogs catalogsRat On catalogsRat.name=replace(em_attestation.rating,'.','')
inner join catalogs catalogsRatmain on catalogsRatmain.nrec=catalogsRat.mainlink and catalogsRatmain.syscode=-124
inner join persons on persons.disprofnmb=em_attestation.CITEZENID
left join appointments On
appointments.nrec=persons.APPOINTCUR
!((appointments.orderdate<=attestation.attdate and appointments.DISMISSDATE>=attestation.attdate
!                                               and appointments.person=persons.nrec and attestation.attdate <>0)
!or  (appointments.orderdate<=attestation.attdate and appointments.DISMISSDATE=0 and appointments.person=persons.nrec and attestation.attdate <>0)
!or
! (attestation.attdate =0 and appointments.nrec=persons.APPOINTCUR)
!)
!where   catalogsName.nrec is null
!where persons.fio='Николаев Игорь Иванович'

;

