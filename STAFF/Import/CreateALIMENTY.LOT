   AL001 : LongInt "ID физ. лица",
   AL002 : integer  "Вид назначения",
   AL003 : integer "Код вида удержания",
   AL004 : string [20] "Вид перечисления",
   AL005 : string [20] "Доля",
   AL006 : string [20] "Признак долга",
   AL007 : double "Сумма долга",
   AL008 : string [20] "Номер исполнительного листа",
   AL009 : string [80] "Получатель алиментов",
   AL010 : string [30] "Номер лицевого счета получателя",
   AL011 : string [20] "Номер карты получателя",
   AL012 : string "Наименование банка получателя",
   AL013 : string [20] "БИК банка получателя",
   AL014 : LongInt "ID сотрудника"

  )
  with index
  (
   i_AL001=AL001,
   i_AL002=AL002,
   i_AL003=AL003,
   i_AL004=AL004,
   i_AL005=AL005,
   i_AL006=AL006,
   i_AL007=AL007,
   i_AL008=AL008,
   i_AL009=AL009,
   i_AL010=AL010,
   i_AL011=AL011,
   i_AL012=AL012,
   i_AL013=AL013,
   i_AL014=AL014

  );