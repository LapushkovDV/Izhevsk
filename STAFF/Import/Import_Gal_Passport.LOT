!sql delete  from passports;

sql
!insert into Passports  (person, Ser, NMB, GivenBY, GivenDate, GIVENPODR, ToDate, //Kind,
!SysCode, DocName, SEQNMB )
select  persons.nrec, Em_Passport.P0002, Em_Passport.P0003, Em_Passport.P0004, Em_Passport.P0005, Em_Passport.P0006,
Em_Passport.P0007, 502, catalogs.nrec, 1
!select *
FROM


catalogs catalogsmain inner join catalogs ON        catalogsmain.syscode=-3
                      and catalogs.lpr = 0   and catalogsmain.nrec = catalogs.mainlink
                      and catalogs.name='Паспорт гражданина России'
!       cross join
!(select p0001 P0001, max(p0005) P0005
!from em_passport group by P0001) Em_Passport_G
     inner join em_Passport  On Em_Passport.P0001=Em_Passport_G.P0001
!                             and  Em_Passport.P0005=Em_Passport_G.P0005
       inner join persons  On em_passport.P0001 = persons.DISPROFNMB
      left join Passports Passports1 On    em_passport.p0001 = Passports1.person
                   and Passports1.sysCode = 502



and Passports1.nrec is NULL
;

