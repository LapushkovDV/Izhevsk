!select * from  KLREJIM to dbf "Z:\Import\source\KLREJIMBackup_13_11_17.dbf";

// Вставка заголовков Графиков


sql
insert into KLREJIM (REJIM, NREJIM)
select em_klndr_1.SD002, substring(SD003,1,50)
from attrnam inner join attrval On attrval.cattrnam=attrnam.nrec
             and attrnam.name='ID Режима работы'  and attrnam.wtable=15004
left join em_klndr_1  ON attrval.vstring=em_klndr_1.sd001
             and em_klndr_1.SD002>0
where em_klndr_1.atl_nrec is null
;




sql
insert into attrnam (Wtable, name,ATTRTYPE )
select top 1 15004,'ID Режима работы', 0
from attrnam
where not exists
(select * from attrnam where wtable=15004 and name='ID Режима работы')
;


sql
insert into attrval(wtable, crec, cattrnam, vstring )
select 15004, klrejim.nrec, attrnam.nrec, em_klndr_1.sd001
from klrejim inner join  em_klndr_1 ON em_klndr_1.sd002=klrejim.rejim
inner join attrnam on attrnam.wtable=15004 and attrnam.name='ID Режима работы'
where not exists
(
select *
from klrejim inner join  em_klndr_1 ON em_klndr_1.sd002=klrejim.rejim
inner join attrnam on attrnam.wtable=15004 and attrnam.name='ID Режима работы'
inner join attrval On attrval.cattrnam=attrnam.nrec
)
;




sql
insert into attrnam (Wtable, name,ATTRTYPE )
select top 1 15004,'Полное Наименование  режима работы', 0
from attrnam
where not exists
(select * from attrnam where wtable=15004 and name='Полное Наименование  режима работы')
;



sql
insert into attrval(wtable, crec, cattrnam, vstring )
select 15004, klrejim.nrec, attrnam.nrec, em_klndr_1.sd003
from klrejim inner join  em_klndr_1 ON em_klndr_1.sd002=klrejim.rejim
inner join attrnam on attrnam.wtable=15004 and attrnam.name='Полное Наименование  режима работы'
where not exists
(
select *
from klrejim inner join  em_klndr_1 ON em_klndr_1.sd002=klrejim.rejim
inner join attrnam on attrnam.wtable=15004 and attrnam.name='Полное Наименование  режима работы'
inner join attrval On attrval.cattrnam=attrnam.nrec
)
;

