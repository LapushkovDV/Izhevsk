sql

update staffstruct set staffstruct.tariff = tarstav.nrec
!select distinct staffstruct.nrec, newtarstav.nrec, tarstav16.nrec, tarstav.nrec, newtarstav.datizm, tarstav16.datizm, tarstav.datizm, newtarstav.codtar, tarstav16.codtar, tarstav.codtar, newtarstav.tarmax, tarstav16.tarmax, tarstav.tarmax
from tarstav tarstav16
inner join tarstavsync on tarstavsync.id = tarstav16.sfield1
inner join newtarstav on newtarstav.nrec = tarstavsync.ctarstav
inner join tarstav  on tarstav.nrec = newtarstav.nrec and tarstav16.datizm = #date(01,01,2016)
inner join em_tarstav on em_tarstav.t0001 = tarstav16.sfield1  and em_tarstav.t0019 = 'Активный'
inner join staffstruct on staffstruct.tariff = tarstav16.nrec
where staffstruct.tariff <> tarstav.nrec
;

sql
update appointments set  appointments.TARIFF=staffstruct.tariff

!select appointments.tariff, staffstruct.tariff, appointments.TAXRATE, staffstruct.TAXRATE
from staffstruct inner join appointments On appointments.staffstr=staffstruct.nrec
!inner join tarstav On Tarstav.nrec=staffstruct.tariff
where appointments.TARIFF<>staffstruct.tariff
;

sql
update apphist set  apphist.TARIFF=staffstruct.tariff

!select appointments.tariff, staffstruct.tariff, appointments.TAXRATE, staffstruct.TAXRATE
from staffstruct inner join appointments On appointments.staffstr=staffstruct.nrec
inner join apphist On apphist.cappoint=appointments.nrec
!inner join tarstav On Tarstav.nrec=staffstruct.tariff
where apphist.TARIFF<>staffstruct.tariff
;


sql
update  historystr set   historystr.CTARIFF=staffstruct.tariff
!select staffstruct.workregime, historystr.cworkregim
from staffstruct inner join historystr On staffstruct.nrec=historystr.staffstr
where  staffstruct.tariff<>historystr.CTARIFF
;

