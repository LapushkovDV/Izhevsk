create table D_USER.EM_AWARD "Таблица EM_AWARD"
  using "EM_AWARD.dat"
!  component USER
  with table_Code = 31744
  with tableOptions header, journal, corpo
  (
   ID         : LongInt "ID AWARDS",
   CITEZENID  : LongInt "ID сотрудника",
   EMPLOYEEID : LongInt "ID физическего лица",
   AWARDTYPE  : String [255] "Имя награждения",
   DOCTYPE    : String [255] "Тип документа о награждении",
   DOCNUMB    : String [50] "Номер документа о награждении.",
   DOCDATE    : Date    "Дата документа о награждении",
   AWARDTEXT  : String[255] "Примечание",
   STATUSDATE : Date "Дата изменения статуса"
  )
  with index
  (
   i_ID         =ID         ,
   i_CITEZENID  =CITEZENID  ,
   i_EMPLOYEEID =EMPLOYEEID ,
   i_AWARDTYPE  =AWARDTYPE  ,
   i_DOCTYPE    =DOCTYPE    ,
   i_DOCNUMB    =DOCNUMB    ,
   i_DOCDATE    =DOCDATE    ,
   i_AWARDTEXT  =AWARDTEXT  ,
   i_STATUSDATE =STATUSDATE
   );