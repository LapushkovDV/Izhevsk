//!!!!!!!!!!  Проверить справочник!!!!!!!!!!!!!!!!!!
SQL
//   update Persons set
//        Persons.PensionCause=Catalogs.Nrec
//      , PERSONS.PENSIONDATE= EM_PENSION.PENSIONDATE
select
        Catalogs.Nrec , Catalogs.Name
      ,  EM_PENSION.PENSIONDATE
From Persons
inner join EM_PENSION on em_PENSION.CITEZENID=Persons.DISPROFNMB
inner join catalogs catsys on catsys.syscode = -29
inner join Catalogs on Catalogs.MainLink = CatSys.Nrec
     and case
     when EM_PENSION.PENSTYPE='Пенсия трудовая/ по старости (по возрасту)' THEN 'Трудовая пенсия по старости'
     when EM_PENSION.PENSTYPE='- за выслугу лет' THEN 'Пенсия по выслуге'
     when EM_PENSION.PENSTYPE='- по инвалидности' THEN 'Инвалидность'
     ELSE '' END = Catalogs.Name
;
