//Точенова Лариса РобертовнаОшибка позиционирования на назначение сотрудника!
//---- пробиваем Даты в PutVacation по новым периодам
/*
SQL
Update putvacation set putvacation.DBEGBALANCE=workperiod.DPerbeg ,putvacation.DENDBALANCE=workperiod.DPerEnd
From putvacation
inner join workperiod on  workperiod.nrec=putvacation.CWORKPERIOD
   and workperiod.WTYPEPERIOD=0
inner join Persons on Persons.Nrec =workperiod.cPerson #flt_Persons
   where putvacation.WTYPEVAC=0 and (putvacation.DBEGBALANCE<>workperiod.DPerbeg
          or putvacation.DENDBALANCE<>workperiod.DPerEnd)
;
SQL
Update putvacation set putvacation.DBEGBALANCE=workperiod.DPerbeg ,putvacation.DENDBALANCE=workperiod.DPerEnd
From putvacation
inner join workperiod on  workperiod.nrec=putvacation.cWPRemain
   and workperiod.WTYPEPERIOD=0
inner join Persons on Persons.Nrec =workperiod.cPerson #flt_Persons
   where putvacation.WTYPEVAC=1 and (putvacation.DBEGBALANCE<>workperiod.DPerbeg
          or putvacation.DENDBALANCE<>workperiod.DPerEnd)
;

//--------------------------------------------------
// Сгененерим остаток
//  if GetFirst WorkPeriod where ((  Persons.NRec      == WorkPeriod.cPerson      and
//                                   Appointments.NRec == WorkPeriod.cAppointment and
//                                   cnWP_Work         == WorkPeriod.wTypePeriod  and
//                                   dDisDate         >>= WorkPeriod.dPerBeg      and
*/
SQL delete from putvacation where WTYPEVAC=1 and putvacation.nrec in
( select putvacation2.nrec from putvacation putvacation2
  inner join Persons On Persons.Nrec =putvacation2.cPerson  #flt_Persons
);
//-------------------
SQL
insert into putvacation (CWORKPERIOD, cperson, WTYPEVAC , WNUM, CKLOTPUSK, CPERSVAC,DBEGBALANCE,DENDBALANCE, wProvidWay  ,cWPRemain, WDAYCOUNT  )
select Distinct
  workperiod.nrec as CWORKPERIOD, persons.nrec as cperson , 1 as WTYPEVAC
  ,  1 as WNUM,putvacation.CKLOTPUSK as CKLOTPUSK, #comp(0) as CPERSVAC
 ,workperiod1.dperbeg, workperiod1.dperend
 ,0
 , workperiod1.Nrec
 ,putvacation.WDAYCOUNT-COALESCE(S.Sum,0)
// ,Persons.Fio
from Persons
inner join   workperiod
  On workperiod.cperson=persons.nrec
  and Curdate<=workperiod.dperend
  and Curdate>=workperiod.dperbeg
  and workperiod.WTYPEPERIOD=0
inner join Appointments on Appointments.Nrec = workperiod.cappointment
inner join   workperiod workperiod1  On workperiod1.cperson=persons.nrec
  and workperiod.WTYPEPERIOD=0
  and workperiod1.dperend <workperiod.dperbeg //возьмем все   = date(from_days(TO_DAYS(datetime(workperiod.dperbeg+0*256*256,0))-1))
inner join Appointments Appointments1 on Appointments1.Nrec = workperiod1.cappointment
inner join putvacation on putvacation.CWORKPERIOD = workperiod1.Nrec
inner join KLOTPUSK on KlOtpusk.Nrec  = putvacation.CKLOTPUSK #flt_klOtpusk
Left outer join ( select Vacations.Person as Person, Vacations.VacType as VacType, sum(Vacations.Duration) as Sum
   //,Min(VACATIONS.workyearbeg) as workyearbeg
   //,Min(VACATIONS.workyearend) as workyearend
   ,VACATIONS.workyearbeg,VACATIONS.workyearend
   From Vacations
      inner join KLOTPUSK on KlOtpusk.Nrec  = VACATIONS.VacType #flt_klOtpusk
     group by Vacations.Person, Vacations.VacType,VACATIONS.workyearbeg,VACATIONS.workyearend
   ) S on S.Person =Persons.Nrec
    and s.VacType = putvacation.CKLOTPUSK
    and S.workyearbeg= workperiod1.dperbeg
    //and S.workyearend =workperiod1.dperend
Left outer join putvacation putvacation1 on
  putvacation1.CWORKPERIOD=workperiod.nrec
  and  putvacation1.cperson=Persons.Nrec
  and  putvacation1.WTYPEVAC=1 and putvacation1.WNUM=1
  and putvacation1.CKLOTPUSK  = putvacation.CKLOTPUSK
where
   putvacation1.Nrec is Null      and COALESCE(S.Sum,0)< putvacation.WDAYCOUNT
   #flt_Persons
order by workperiod1.dperend
;

// удалим остатки, если нет остатка по следующему периоду

SQL
Delete from putvacation where putvacation.nrec in (select putvacation.Nrec
//select Persons.FIo,workperiod.dperbeg, workperiod.dperend,workperiod1.dperbeg, workperiod1.dperend,workperiod2.dperbeg, workperiod2.dperend
From putvacation
inner join Persons on Persons.Nrec =putvacation.cPerson #flt_Persons
inner join workperiod on  workperiod.nrec=putvacation.CWORKPERIOD
           and  workPeriod.dperbeg<CurDate-256*2 // не будем трогать свежие периоды
           and  workPeriod.dperend<CurDate
           and workperiod.WTYPEPERIOD=0
inner join Appointments on Appointments.Nrec = workperiod.cappointment
// за который
inner join workperiod workperiod1 on  workperiod1.nrec=putvacation.cWPRemain
     and COALESCE(workperiod1.dPerEnd,#Date(0,0,0))<>#Date(0,0,0)
     and workperiod1.WTYPEPERIOD=0
inner join Appointments Appointments1 on Appointments1.Nrec = workperiod1.cappointment  and Appointments1.Lprizn = Appointments.Lprizn
inner join workperiod workperiod2 on  workperiod2.cPerson=putvacation.cPerson
       and COALESCE(date(from_days(TO_DAYS(datetime(COALESCE(workperiod1.dPerEnd,#Date(0,0,0)),0))+1)
                        )
                  ,#Date(0,0,0))<=workperiod2.dperbeg
       and workperiod2.nrec<>putvacation.CWORKPERIOD // текущий пропускаем - за него еще нет остатков
inner join Appointments Appointments2 on Appointments2.Nrec = workperiod2.cappointment and Appointments2.Lprizn = Appointments.Lprizn
// ищем остатки по следующему периоду
Left Outer join putvacation putvacation2 on workperiod2.nrec=putvacation2.cWPRemain and putvacation2.WTYPEVAC=1
where putvacation.WTYPEVAC=1 and putvacation2.Nrec is Null

)
;

// Удалим совсем старые
SQL Delete from putvacation where putvacation.DENDBALANCE<CurDate-256*256*6 and putvacation.WTYPEVAC=1;




