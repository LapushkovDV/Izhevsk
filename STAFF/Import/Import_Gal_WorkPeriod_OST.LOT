// после расчета сдвига возможно наложение периодов
/*
SQL
//----- delete putvacation where putvacation.Nrec in
update putvacation set putvacation.CWORKPERIOD=workperiod1.Nrec
// select putvacation.Nrec ,SubString(Persons.Fio,1,30),workperiod1.dPerBeg,workperiod1.dPerEnd,workperiod.dPerEnd,workperiod.dPerEnd
// ,workperiod1.WTYPEPERIOD,workperiod.WTYPEPERIOD
From putvacation
inner join workperiod on  workperiod.nrec=putvacation.CWORKPERIOD
inner join Appointments on Appointments.Nrec = workperiod.cappointment
inner join Persons on Persons.Nrec =workperiod.cPerson #flt_Persons
inner join workperiod workperiod1 on  workperiod1.cPerson=workperiod.cPerson
     and workperiod.dPerBeg>workperiod1.dPerBeg and workperiod1.dPerBeg>workperiod.dPerEnd
     and workperiod1.WTYPEPERIOD=0
inner join Appointments Appointments1 on Appointments1.Nrec = workperiod1.cappointment  and Appointments1.Lprizn = Appointments.Lprizn
Left outer join FactOtpusk on FactOtpusk.cWorkPeriod= workperiod.Nrec
where workperiod.WTYPEPERIOD=0 and FactOtpusk.Nrec is Null
;

// после расчета сдвига возможно наложение периодов
SQL
Update FactOtpusk set FactOtpusk.cWorkPeriod=WorkPeriod.Nrec
//   select SubString(Persons.Fio,1,30)  ,workperiod1.dPerBeg
//   ,workperiod1.dPerEnd,workperiod.dPerEnd,workperiod.dPerEnd  ,workperiod1.WTYPEPERIOD,workperiod.WTYPEPERIOD
//   ,FactOtpusk.Nrec //,Klotpusk.NOtpus
//   ,FACTOTPUSK.FACTYEAREND,FactOtpusk.WorkYearBeg, FactOtpusk.WorkYearEnd
From workperiod
inner join Appointments on Appointments.Nrec = workperiod.cappointment
inner join Persons on Persons.Nrec =workperiod.cPerson #flt_Persons
inner join workperiod workperiod1 on  workperiod1.cPerson=workperiod.cPerson
     and workperiod1.dPerBeg>workperiod.dPerBeg and workperiod1.dPerBeg<=workperiod.dPerEnd
     and workperiod1.WTYPEPERIOD=0
inner join Appointments Appointments1 on Appointments1.Nrec = workperiod1.cappointment  and Appointments1.Lprizn = Appointments.Lprizn
Left outer join FactOtpusk on FactOtpusk.cWorkPeriod= workperiod1.Nrec
Left outer join Klotpusk on KlOtpusk.kOtpus =FactOtpusk.VacType
where workperiod.WTYPEPERIOD=0
;


