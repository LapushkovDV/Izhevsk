// нумерация em_person основное место работы
sql
update em_person set  em_person.p0000=p1.nrec_count, em_person.p9999=p2.Max_count
!select em_person.p0030, em_person.p0001, p1.nrec_count, P2.Max_count, em_person.p0003, em_person.p0011, em_person.p0002
from em_person inner join
(
select em_person.atl_nrec, count(*) nrec_count, min(em_person.p0030) fP0030
from em_person inner join em_person em_person1 On em_person.p0003>=em_person1.p0003
     and em_person.p0030=em_person1.p0030
          where em_person.p0007='Основное место работы'
group by em_person.atl_nrec
!having exists (select * from em_person p3 where p3.p0011<>0 and p3.p0030=min(em_person.p0030))
) P1 On P1.atl_nrec=em_person.atl_nrec
inner join
(
select count(*) Max_count, em_person.p0030 P0030
from em_person
     where em_person.p0007='Основное место работы'
group by em_person.p0030
) P2 On P2.P0030=em_person.p0030
!where  p1.nrec_count<P2.Max_count and  em_person.p0011<>0 and (em_person.p0007='Основное место работы' OR em_person.p0007='Внешнее совместительство')
!order by p2.Max_count, em_person.p0002, em_person.p0030,em_person.p0003
;






!sql select P0000, p9999, p0011, p0002, p0003 from em_person where p0002='Козлов Леонид Павлович';

