sql
select em_person.p0030, em_person.p0031, em_person.p0001, em_person.p0002, em_person.p0003, em_person.p0009, em_person.p0016, em_person.p0026, em_person.p0029
,EM_sumopl.sr002, EM_sumopl.sr003, EM_sumopl.sr004, EM_sumopl.sr005, EM_sumopl.sr008
, em_person.p0007
from em_person inner join
(
select p0030, p0007 from em_person  p1 group by p0030, p0007
having exists
(select p0030, p0007 from em_person where p0030=p1.p0030 and p0007=p1.p0007 and p0007='α®Ά¬¥αβ¨β¥«μ')
) P2 On P2.p0030=em_person.p0030
inner join em_sumopl ON em_sumopl.sr001=em_person.p0030
where em_person.p0030=61253

to dbf Z:\import\testperson.xls;

!61308
!61251
