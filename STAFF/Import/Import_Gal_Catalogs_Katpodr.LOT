sql
!insert into Catalogs  (Name, MAINLINK, GROUPCODE, SYSCODE, Code, DOPSTR, DATN, DATOK)
select em_catpodr.D0003,  CatalogsMain.nrec,  2, 0
,em_catpodr1.d0002, em_catpodr1.d0001
,em_catpodr1.D0007
,case when rtrim(em_catpodr1.D0010)='Архивный' then Curdate else 0 end

FROM em_catpodr
inner join catalogs catalogsmain On catalogsmain.syscode=-11
      and catalogsmain.code='000001'
      and catalogsMain.name = 'ЭнергоМашТест'
left join catalogs catalogsOld On CatalogsOld.dopstr=em_catpodr.D0001
;
