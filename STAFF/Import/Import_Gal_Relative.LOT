delete all from PSNLINKS;

sql
insert into PSNLINKS (FromPerson, linkType, RFIO, RBORNDATE)
select persons.nrec, catalogsrel.nrec, em_relative.R0003, em_relative.R0004
from em_relative inner join persons On Persons.DISPROFNMB=em_relative.R0001
inner  join catalogs catalogsRelMain ON catalogsRelMain.syscode=-16
inner  join catalogs catalogsRel On catalogsRel.mainlink=catalogsRelMain.nrec and catalogsRel.name=em_relative.R0002
;