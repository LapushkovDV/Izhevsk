//--------------------------------
// Условия труда
// STAFFSTRUCT.WORKCOND
// HISTORYSTR.CWORKCOND
/*
SQL
select substring(EM_CATALOGS.C0003,1,20),EM_CATALOGS.C0001, substring(catalogs.Name,1,30),substring(catalogs.code,1,30)
From EM_StaffStruct
inner join EM_CATALOGS on  EM_StaffStruct.S0018 = EM_CATALOGS.C0001
inner join catalogs catsys on catsys.syscode=-33
left outer join catalogs on catalogs.lpr =0 and catalogs.mainlink=catsys.nrec
   and (catalogs.code=EM_CATALOGS.C0003 or catalogs.code+'.0'=EM_CATALOGS.C0003)
where catalogs.nrec is null
;*/


sql
update staffstruct set STAFFSTRUCT.WORKCOND=catalogs.nrec
//select substring(catalogs.Name,1,30) , substring(EM_CATALOGS.C0003,1,20),EM_CATALOGS.C0001
//   ,EM_StaffStruct.S0018   ,substring(EM_CATALOGS.C0002,1,20)
From EM_StaffStruct
inner join EM_CATALOGS on  EM_StaffStruct.S0018 = EM_CATALOGS.C0001
inner join StaffStruct on em_staffstruct.s0001=staffstruct.CNEWSPR3
inner join catalogs catsys on catsys.syscode=-33
inner join catalogs on catalogs.lpr =0 and catalogs.mainlink=catsys.nrec
   and (catalogs.code=EM_CATALOGS.C0003 or catalogs.code+'.0'=EM_CATALOGS.C0003)

;

sql update historystr set HISTORYSTR.CWORKCOND=STAFFSTRUCT.WORKCOND
from  historystr inner join staffstruct on staffstruct.nrec = HISTORYSTR.Staffstr
;
