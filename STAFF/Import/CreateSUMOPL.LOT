create table D_USER.EM_SUMOPL "Таблица EM_SUMOPL"
       using "EM_SUMO.dat"
!      component user
       with table_code = 31727
       with tableoptions header, journal, corpo
       (

       SR001: longint "ID физ. лица",
       SR002: integer "Вид назначения",
       SR003: integer "Код вида оплаты пользователя",
       SR004: integer "Месяц начисления",
       SR005: integer "Год начисления",
       SR006: integer "Месяц, за который начислено",
       SR007: integer "Год, за который начислено",
       SR008: double "Сумма начисления",
       SR009: double "Количество дней",
       SR010: double "Количество часов",
       SR011: double "Отработано часов план",
       SR012: double "Отработано дней план",
       SR013: longint "ID Сотрудника",
       SR014: string [15] "Начисление\Удержание",
       SR015: double "Сумма на руки",
       SR016: integer "Код подразделения"

       )

with index
     (

        i_SR001 = SR001,
        i_SR002 = SR002,
        i_SR003 = SR003,
        i_SR004 = SR004,
        i_SR005 = SR005,
        i_SR006 = SR006,
        i_SR007 = SR007,
        i_SR008 = SR008,
        i_SR009 = SR009,
        i_SR010 = SR010,
        i_SR011 = SR011,
        i_SR012 = SR012,
        i_SR013 = SR013,
        i_SR014 = SR014,
        i_SR015 = SR015,
        i_SR016 = SR016

        );