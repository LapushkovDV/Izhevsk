create table D_USER.EM_ATTRVAL "Таблица EM_ATTRVAL"
  using "EM_ATTRV.dat"
  component USER
  with table_Code = 31746
  (
   lastuser : string [20],
   lasttime : time,
   lastdate : date,
   filialno : longint,
   wtable : word,
   crec : comp,
   cattrnam : comp,
   vstring : string,
   vdouble : double,
   vdate : date,
   vtime : time,
   vcomp : comp,
   vlongint : longint,
   vlvar : lvar
   )
with index
(
i_001 = lastuser
  );