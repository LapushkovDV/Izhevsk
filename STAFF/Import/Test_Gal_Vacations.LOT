sql
select fio, disprofnmb, factyearbeg, factyearend, DURATION, vactype
from factotpusk    inner join persons On persons.nrec=factotpusk.person
where factyearbeg> factyearend
!to dbf Z:\import\bad_vacations.xls
!order by fio
;


