!sql
!delete from lstab;
sql
!insert into lstab (strtabn, cex, clschet, mesn, yearn, rejim, Datef, Datee, Chasf, DayF,
!                   DAYS[1], DAYS[2], DAYS[3], DAYS[4], DAYS[5], DAYS[6], DAYS[7], DAYS[8],
!                   DAYS[9], DAYS[10], DAYS[11], DAYS[12], DAYS[13], DAYS[14], DAYS[15],
!                   DAYS[16], DAYS[17], DAYS[18], DAYS[19], DAYS[20], DAYS[21], DAYS[22],
!                   DAYS[23], DAYS[24], DAYS[25], DAYS[26], DAYS[27], DAYS[28], DAYS[29], DAYS[30], DAYS[31])
select distinct appointments.strtabn, katpodr.nrec, appointments.caddnrec2, tb004, tb005, klrejim.rejim, tb008, tb009, tb006, tb007,
case when instr(' ', tb010)>0 then substring(tb010,1,instr(' ', tb010)) else tb010 end,
case when instr(' ', tb011)>0 then substring(tb011,1,instr(' ', tb011)) else tb011 end,
case when instr(' ', tb012)>0 then substring(tb012,1,instr(' ', tb012)) else tb012 end,
case when instr(' ', tb013)>0 then substring(tb013,1,instr(' ', tb013)) else tb013 end,
case when instr(' ', tb014)>0 then substring(tb014,1,instr(' ', tb014)) else tb014 end,
case when instr(' ', tb015)>0 then substring(tb015,1,instr(' ', tb015)) else tb015 end,
case when instr(' ', tb016)>0 then substring(tb016,1,instr(' ', tb016)) else tb016 end,
case when instr(' ', tb017)>0 then substring(tb017,1,instr(' ', tb017)) else tb017 end,
case when instr(' ', tb018)>0 then substring(tb018,1,instr(' ', tb018)) else tb018 end,
case when instr(' ', tb019)>0 then substring(tb019,1,instr(' ', tb019)) else tb019 end,
case when instr(' ', tb020)>0 then substring(tb020,1,instr(' ', tb020)) else tb020 end,
case when instr(' ', tb021)>0 then substring(tb021,1,instr(' ', tb021)) else tb021 end,
case when instr(' ', tb022)>0 then substring(tb022,1,instr(' ', tb022)) else tb022 end,
case when instr(' ', tb023)>0 then substring(tb023,1,instr(' ', tb023)) else tb023 end,
case when instr(' ', tb024)>0 then substring(tb024,1,instr(' ', tb024)) else tb024 end,
case when instr(' ', tb025)>0 then substring(tb025,1,instr(' ', tb025)) else tb025 end,
case when instr(' ', tb026)>0 then substring(tb026,1,instr(' ', tb026)) else tb026 end,
case when instr(' ', tb027)>0 then substring(tb027,1,instr(' ', tb027)) else tb027 end,
case when instr(' ', tb028)>0 then substring(tb028,1,instr(' ', tb028)) else tb028 end,
case when instr(' ', tb029)>0 then substring(tb029,1,instr(' ', tb029)) else tb029 end,
case when instr(' ', tb030)>0 then substring(tb030,1,instr(' ', tb030)) else tb030 end,
case when instr(' ', tb031)>0 then substring(tb031,1,instr(' ', tb031)) else tb031 end,
case when instr(' ', tb032)>0 then substring(tb032,1,instr(' ', tb032)) else tb032 end,
case when instr(' ', tb033)>0 then substring(tb033,1,instr(' ', tb033)) else tb033 end,
case when instr(' ', tb034)>0 then substring(tb034,1,instr(' ', tb034)) else tb034 end,
case when instr(' ', tb035)>0 then substring(tb035,1,instr(' ', tb035)) else tb035 end,
case when instr(' ', tb036)>0 then substring(tb036,1,instr(' ', tb036)) else tb036 end,
case when instr(' ', tb037)>0 then substring(tb037,1,instr(' ', tb037)) else tb037 end,
case when instr(' ', tb038)>0 then substring(tb038,1,instr(' ', tb038)) else tb038 end,
case when instr(' ', tb039)>0 then substring(tb039,1,instr(' ', tb039)) else tb039 end,
case when instr(' ', tb040)>0 then substring(tb040,1,instr(' ', tb040)) else tb040 end
from em_tabel
inner join appointments on appointments.cref3 = em_tabel.tb041
inner join catalogs on catalogs.nrec = appointments.department
inner join extcatlinks on extcatlinks.staffcat = catalogs.nrec
inner join katpodr on katpodr.nrec = extcatlinks.extcat
inner join em_klndr_2 on em_klndr_2.k003 = em_tabel.tb003
inner join klrejim on em_klndr_2.k006 = klrejim.nrec


