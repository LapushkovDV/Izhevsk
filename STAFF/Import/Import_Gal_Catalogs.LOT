// Загрузка в галактический каталог

insert into catalogs  (cparent, GROUPCODE, SYSCODE, Name, Code, DOPSTR)
select catalogs1.nrec, 2, 0, 'Временный для хранения информации из КИС', '028028',0
from catalogs catalogs1, catalogs catalogs2
where ((
-1 == catalogs1.syscode
and  '028028' == catalogs2.Code (NoIndex) and (catalogs2.name='Временный для хранения информации из КИС')
))
and isvalidall(tncatalogs2) = false
;


// Загрузка папок верхнего уровня из КИС  в  Галактический  CatalogsUP

delete all from em_catalogsUp;

insert into em_catalogsUP  (c0001, c0002, c0003)

select em_catalogs.c0004, em_catalogs.c0005, em_catalogs.c0006

from em_catalogs, catalogs catalogs2 , EM_catalogsUP EM_catalogsUP1
where ((
EM_catalogs.c0003 == catalogs2.name (Noindex)
and EM_catalogs.c0006 == EM_catalogsUP1.c0003

))
and length(em_catalogs.c0003) > 0
and isvalidall(tncatalogs2)=false
and isvalidall(tnEM_catalogsUP1)=false
;

// Загрузка папок верхнего уровня из КИС  в  Галактику  (Catalogs)

insert into catalogs  ( cparent, GROUPCODE, SYSCODE, Name, Code, DOPSTR)
select catalogs1.nrec, 2, 0, em_catalogsUP.c0003, em_catalogsUP.c0002, em_catalogsUP.c0001
from catalogs catalogs1, EM_catalogsUP EM_catalogsUP
,catalogs catalogs2
where ((
'028028' == catalogs1.code (Noindex)
and catalogs1.nrec == catalogs2.cparent
and EM_catalogsUP.c0003 == catalogs2.name
))
and isvalidall(tncatalogs2)=false
;


// Загрузка записей нижнего уровня из КИС  в  Галактический  Catalogs

insert into catalogs  (cparent, GROUPCODE, SYSCODE, Name, Code, DOPSTR)
select catalogs2.nrec, 2, 0, em_catalogs1.c0003, em_catalogs1.c0002, em_catalogs1.c0001
from catalogs catalogs1, EM_catalogs EM_catalogs1
,catalogs catalogs2, catalogs catalogs3
where ((
'028028' == catalogs1.code (Noindex)
and catalogs1.nrec == catalogs2.cparent
and catalogs2.name  == EM_catalogs1.c0006
and EM_catalogs1.c0003 == catalogs3.name    (NoIndex)
))
and isvalidall(tncatalogs3)=false
;


sql delete  from cathist;
sql delete  from shr_condition;

sql
insert into cathist  (cCat, cParent, Name, Nparent,Dat1, WFLD1)
select catalogs.Nrec, catalogs.cParent, catalogs.name, catalogsparent.name, curdate,1
from catalogs inner join catalogs catalogsparent On catalogs.cparent=catalogsparent.nrec
     inner join catalogs catalogsmain On CatalogsMain.syscode=-11 and catalogs.mainlink=catalogsmain.nrec
;

sql
insert into shr_condition  (Report)
select CatHist.Nrec
from cathist
;
















