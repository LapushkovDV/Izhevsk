sql

!select staffstruct.nrec, staffstruct.department, attrval.vcomp, attrnam.name, catalogs.dopstr, em_catpodr.D0011
!from  staffstruct inner join catalogs on staffstruct.department = catalogs.nrec
!inner join attrval on attrval.vcomp = staffstruct.nrec and attrval.wtable=25018
!inner join attrnam On attrnam.nrec=attrval.cattrnam and attrnam.wtable=25018 and attrnam.name='Должность функционального руководителя'
!inner join em_catpodr On catalogs.dopstr=em_catpodr.D0001
!inner join catalogs catalogsUp On  catalogsUp.dopstr=em_catpodr.D0011
! inner join staffstruct staffstructUp On staffstructUp.department=catalogsUP.nrec

select * from em_catpodr

