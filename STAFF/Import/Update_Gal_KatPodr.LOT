/*
sql
update katpodr set katpodr.dto=catalogs.datok, katpodr.lastdate=catalogs.datok, katpodr.isarch=1
!select ISARCH, DTO, katpodr.lastDate,  DatOk, katpodr.name, catalogs.name
from ExtCatLinks inner join katpodr On katpodr.nrec=ExtCatLinks.extcat
inner join catalogs On Catalogs.nrec=ExtCatLinks.Staffcat
where  11 = ExtCatLinks.ObjType  and 1  = ExtCatLinks.ModType
and   catalogs.DatOk<>katpodr.DTO
!and katpodr.name<> catalogs.name
;
*/
/*
SQL delete from katpodr where katpodr.nrec in
(select katpodr.nrec //, katpodr.kod
from katpodr
left outer join ExtCatLinks on katpodr.nrec=ExtCatLinks.extcat
 and  11 = ExtCatLinks.ObjType  and 1  = ExtCatLinks.ModType
where katpodr.kod='' and ExtCatLinks.nrec is Null
);*/
