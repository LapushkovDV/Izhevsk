sql

select persons.fio, catalogs.name, psnlinks.rfio, psnlinks.rborndate
from
persons inner join psnlinks
on persons.nrec = psnlinks.fromperson and cast(persons.disdate as longint) = 0
inner join catalogs on psnlinks.linktype = catalogs.nrec and (catalogs.name = 'сын' or catalogs.name = 'дочь')
to dbf "C:\Users\aleksey.kurennykh\Desktop\GalKids.xlsx";