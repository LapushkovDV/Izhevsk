/*
// Заполнение в картотеке сотрудников (Persons) полей -  department CBASEPROF DISDATEPR DISDATE DISORDERDATE appointFirst   appointCur  appointLast
// Для работающих сотрудников
sql

!update persons   set  persons.cbaseprof      =    Appointmentsmax.Post
!                     , persons.disdatepr     =    appointmentsmax.dismissdate
!                     , persons.disdate       =    appointmentsmax.dismissdate
!                     , persons.APPDATE       =    em_person.p0040
!                     , persons.disorderdate  =    appointmentsmax.Dorderdisdate
!                     , persons.appointFirst  =    appointmentsmin.nrec
!                     , persons.appointCur    =    appointmentsmax.nrec
!                     , persons.appointLast   =    0


select
                       Appointmentsmax.Post                       , persons.cbaseprof      PPost
                     , appointmentsmax.dismissdate                , persons.disdate        PDisDate
                     , appointmentsmax.appointdate                , persons.APPDATE        PAppDate
                     , em_person.p0040                            , persons.APPDATE        PAppDate1
                     , appointmentsmax.Dorderdisdate  ADisOrder   , persons.disorderdate   PDisOrder
                     , appointmentsmin.nrec  appointfirst         , persons.appointFirst   PFirst
                     , appointmentsmax.nrec  appointCur           , persons.appointCur     PCur
                     , 0                                          , persons.appointLast    PLast                                                                                                     , persons.appointLast
                     , fio
                     , p0007


from  persons inner join appointments appointmentsMax On persons.nrec=appointmentsMax.person
inner join  em_person   On appointmentsMax.cref3=em_person.p0001
inner join appointments appointmentsMin On persons.nrec=appointmentsMin.person
           and appointmentsmin.resword[20]=1
inner join
      (
      select max(resword[20]) max_count, person from appointments group by person
      ) appmax On appmax.person=appointmentsMax.person and appmax.max_count=appointmentsMax.resword[20]
where appointmentsmax.lprizn=0 and appointmentsmin.lprizn=0
!and p0002='Попова Лариса Алексеевна'
!and p0002='Чикова Людмила Арнольдовна'
and appointmentsmax.dismissdate=0
and  (
              persons.cbaseprof        <>    Appointmentsmax.Post
              or persons.disdatepr     <>    appointmentsmax.dismissdate
              or persons.disdate       <>    appointmentsmax.dismissdate
              or persons.APPDATE       <>    em_person.p0040
              or persons.disorderdate  <>    appointmentsmax.Dorderdisdate
              or persons.appointFirst  <>    appointmentsmin.nrec
              or persons.appointCur    <>    appointmentsmax.nrec
              or persons.appointLast   <>    0
      )
!to dbf Z:\import\Persons_For_Check_Cur_Appoint.xls
;
*/



