/*
//===== Увольняем , если все основные назначения закрыты
SQL
 Select Persons.Fio, Persons.AppDate,Persons.DisDate, S.DisMissDate, CASE WHEN S.DisMissDate=#date(1,1,2100) THEN #Date(0,0,0) ELSE S.DisMissDate END
!Update Persons set Persons.AppointLast=Persons.appointCur,Persons.appointCur=CASE WHEN S.DisMissDate=#date(1,1,2100) THEN 0 ELSE Persons.appointCur END
!,Persons.DisDate=CASE WHEN S.DisMissDate=#date(1,1,2100) THEN #Date(0,0,0) ELSE S.DisMissDate END
From Persons
inner join  (select Appointments.Person as Person
      , Max(CASE WHEN COALESCE(Appointments.DisMissDate,#Date(0,0,0))=#Date(0,0,0) THEN #date(1,1,2100) ELSE Appointments.DisMissDate END
        ) as DisMissDate //MAx
    From Appointments where  Appointments.Lprizn=0
    Group by Appointments.Person
    ) S on S.Person = Persons.Nrec
Where Persons.DisDate<>CASE WHEN S.DisMissDate=#date(1,1,2100) THEN #Date(0,0,0) ELSE S.DisMissDate END
;
