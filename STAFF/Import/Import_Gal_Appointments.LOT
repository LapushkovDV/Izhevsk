//Для сотрудников принятых повторно перевод предыдущих назначений в архив (присвоение полю Lprizn кода 100)
//и обновление поля persons.appointfirst
sql
update appointments  set appointments.lprizn=100

!Select fio, appointmentsarch.APPOINTDATE,  appointmentsFirst.APPOINTDATE    APPOINTDATEFIRSTNEW
from  persons inner join appointments appointmentsMax On persons.nrec=appointmentsMax.person
inner join  em_person   On appointmentsMax.cref3=em_person.p0001
inner join appointments appointmentsMin On persons.nrec=appointmentsMin.person
           and appointmentsmin.resword[20]=1
inner join
      (
      select max(resword[20]) max_count, person from appointments group by person
      ) appmax On appmax.person=appointmentsMax.person and appmax.max_count=appointmentsMax.resword[20]
inner join appointments appointmentsArch On appointmentsArch.person=persons.nrec and appointmentsArch.appointdate<persons.appdate
left join appointments appointmentsFirst On appointmentsFirst.person=persons.nrec and appointmentsFirst.appointdate=persons.appdate
inner join appointments On appointments.nrec=appointmentsarch.nrec
where appointmentsmin.APPOINTDATE<persons.appdate
and appointmentsarch.nrec<>appointmentsfirst.nrec
and appointmentsFirst.nrec is not null
and appointmentsArch.lprizn=0
and appointmentsfirst.lprizn=0
!and appointmentsmax.dismissdate<>0
!and p0002='Паулкин Олег Алексеевич'
!and p0002='Чикова Людмила Арнольдовна'
!order by  fio, appointmentsarch.APPOINTDATE
;
