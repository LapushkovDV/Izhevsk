// Дата приема по основному месту работу
SQL
update Persons set Persons.AppDate=CASE WHEN EM_Person.P0040=#Date(0,0,0) THEN Persons.AppDate else EM_Person.P0040 END
From Persons
inner join Em_Person on Em_Person.P0030 = Persons.DISPROFNMB
 and ( trim(Em_Person.P0007)='Основное место'
  or   trim(Em_Person.P0007)='Основное место работы'
  )
 and Em_Person.P0029='Активный'
 and Persons.AppDate<>EM_Person.P0040
;
// Дата приема по основному месту работу - архив
SQL
update Persons set Persons.AppDate=CASE WHEN EM_Person.P0040=#Date(0,0,0) THEN Persons.AppDate else EM_Person.P0040 END
From Persons
inner join Em_Person on Em_Person.P0030 = Persons.DISPROFNMB
 and ( trim(Em_Person.P0007)='Основное место'
  or   trim(Em_Person.P0007)='Основное место работы'
  )
 and Em_Person.P0029='Архивный'
where Persons.AppDate=#Date(0,0,0)
;
// ставим из минимального назначения - основного
SQL
update Persons set Persons.AppDate=Appointments.Appointdate
From Persons
inner join Appointments on Appointments.Person = Persons.Nrec
    and  Appointments.Lprizn=0
    and  Appointments.Appointdate in (Select Min(App.Appointdate) from  Appointments App
     where App.Person = Persons.Nrec and App.Lprizn=0
     )
where Persons.AppDate=#Date(0,0,0)
;

