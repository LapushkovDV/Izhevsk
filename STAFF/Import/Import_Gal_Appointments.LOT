inner join Persons on Persons.Nrec = Appointments.Person
inner join Em_Person  on Em_Person.P0003 = Appointments.AppointDate //cRef3
  and  Em_Person.P0030 = Persons.DISPROFNMB
  and  Em_Person.P0007 =  CASE when Appointments.LPrizn =0 then 'Основное место работы' else 'Внутреннее совместительство' end
  and (Appointments.DATEEND=Em_Person.P0009 or )
;
// Закроем открытые старые периоды
SQL
// select persons.Fio,Appointments.DisMissDate ,App1.AppointDate, date(from_days(TO_DAYS(datetime(App1.AppointDate+0*256*256,0))-1))
update Appointments set Appointments.DisMissDate=date(from_days(TO_DAYS(datetime(App1.AppointDate+0*256*256,0))-1))
From Persons
inner join Appointments on Appointments.Person = Persons.Nrec
           and COALESCE(Appointments.DisMissDate,#Date(0,0,0))=#Date(0,0,0)
           and Appointments.Lprizn=0
inner join  Appointments App1 on App1.Person = Persons.Nrec
        and App1.Lprizn=0
        and App1.Appointdate > Appointments.Appointdate
        and App1.Appointdate in (select min(App2.Appointdate) from Appointments App2
                where App1.Person = App2.Person and App2.LPrizn=0
                 and App2.Appointdate > Appointments.Appointdate
                )
;
*/


/*
//по совместителям не больше 0.5
//11.10.2017    Чемарова        У сотрудника Косыгин Сергей Генрихович, количество ставок по совместительству =1 (не должно превышать 0,5)
SQL Update appointments set appointments.Rate=0.5,appointments.EmpRate=0.5
From appointments where appointments.lPrizn=3 and (appointments.Rate>0.5  or appointments.EmpRate>0.5) ;
*/

