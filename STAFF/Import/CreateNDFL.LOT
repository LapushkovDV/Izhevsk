create table D_USER.EM_NDFL "Таблица EM_NDFL"

  using "EM_NDFL.dat"
!  component USER
  with table_Code = 31719
  with tableOptions header, journal, corpo
  (
   NL001 : LongInt "ID физ. лица",
   NL002 : integer  "Вид назначения",
   NL003 : integer "Код вида удержания",
   NL004 : integer "Месяц удержания",
   NL005 : integer "Год удержания",
   NL006 : integer "Месяц, за который удержано",
   NL007 : integer "Год, за который удержано",
   NL008 : double "Сумма удержания",
   NL009 : longint "ID сотрудника"


  )
  with index
  (
   i_NL001=NL001,
   i_NL002=NL002,
   i_NL003=NL003,
   i_NL004=NL004,
   i_NL005=NL005,
   i_NL006=NL006,
   i_NL007=NL007,
   i_NL008=NL008,
   i_NL009=NL009

  );