#define Wdt date(01,04,2016)
#DEfine _NO_Export_
#IFDEF _EXPORT_

select katkau.* to dbf c:\1\dbf\katkau.dbf;
select spkau.* to dbf c:\1\dbf\spkau.dbf;
select MinRazr.* where (( #Wdt == MINRAZR.DATIZM )) to dbf c:\1\dbf\MinRazr.dbf;
select TarStav.* where (( #Wdt == TarStav.DATIZM )) to dbf c:\1\dbf\TarStav.dbf;
select GP_TarStavExt.* from GP_TarStavExt   where (( #Wdt == TarStav.DATIZM and  TarStav.NRec==GP_TarStavExt.cTarStav )) to dbf c:\1\GP_TarStavExt;
#ELSE

//Import katkau from dbf c:\1\dbf\katkau.dbf nfsr;
//Import spkau from dbf c:\1\dbf\spkau.dbf nfs;
//Import MinRazr From dbf c:\1\dbf\MinRazr.dbf nfsr;
//Import TarStav from dbf c:\1\dbf\TarStav.dbf nfsr;
//Import GP_TarStavExt from dbf c:\1\GP_TarStavExt nfsr;
select spkau.kodgrkau, Spkau.name
from spkau,katkau where (( spkau.kodgrkau /== katkau.kodgroup
 and (spkau.ATL_ORIGINOFFICE <> katkau.ATL_ORIGINOFFICE)
));
#ENDIF
