create table D_USER.EM_ADDRESS "Таблица EM_ADDRESS"
  using "EM_ADDR.dat"
!  component USER
  with table_Code = 31701
  with tableOptions header, journal, corpo
  (
   A0001 : LongInt "ID физического лица",
   A0002 : String [60] "Тип адреса",
   A0003 : String [255] "Адрес",
   A0004 : String [20] "Код из базы ГНИ для нижнего эл. Иерархии",
   A0005 : String [20] "Номер дома",
   A0006 : String [20] "Номер корпуса\строения",
   A0007 : String [20]"Номер квартиры",
   A0008 : Date   "Дата регистрации"



  )
  with index
  (
   i_A0001=A0001,
   i_A0002=A0002,
   i_A0003=A0003,
   i_A0004=A0004,
   i_A0005=A0005,
   i_A0006=A0006,
   i_A0007=A0007,
   i_A0008=A0008
  );