
create table D_USER.EM_PENSION "Пенсионеры"
  using "PENSION.dat"
!  component USER
  with table_Code = 31743
  with tableOptions header, journal, corpo
  (
     CITEZENID : LongInt "ID физического лица"
    ,LASTNAME    : string[30] "Фамилия"
    ,NAME        : string[30] "Имя"
    ,FATHERSHIP  : string[30] "Отчество"
    ,PENSTYPE    : string "Тип пенсии "
    ,PENSIONDATE : date "Дата выхода на пенсию"
    ,PENSLIST    : string "Пенсионный список"
  )
  with index
  (
   EM_PENSION01=CITEZENID+PENSIONDATE
  );
