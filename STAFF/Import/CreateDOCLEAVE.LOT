
create table D_USER.EM_DOCLEAVE "Невыходы"
  using "EM_DOCLEAVE .dat"
!  component USER
  with table_Code = 31742
  with tableOptions header, journal, corpo
  (
     CITEZENID : LongInt "ID физического лица"
    ,BEGINDATE : Date    "Дата начала"
    ,ENDDATE   : Date    "Дата окончания"
    ,DOCNUMB   : String[50]     "Номер документа"
    ,DOCDATE   : Date    "Дата документа"
    ,LENGTHHOUR: longint          "Продолжительность, часов"
    ,CONTIME    :time          "CONTIME"
    ,DOCNAME    :string        "Наименование документа"
    ,DESCR      : string[10] "Условное обозначение табеля"
    ,DOCTYPEID  : longint "тип документа 15"
    ,LASTNAME    : string[30] "Фамилия"
    ,NAME        : string[30] "Имя"
    ,FATHERSHIP  :  string[30] "Отчество"
    ,WORKCONTRACTID : longint "Контракт"
    ,DCODE          : longint "ID подразделения"
    ,DEPT           : string "подразделение"
    ,JOBTITLE       : string "Должность"
    ,FIOCUT         : string[20] "ФИО"
    ,EXPA           : string
    ,DAYS           : longint "Дни"
    ,BMONTH         : longint "Месяц"
    ,BYEAR          : longint "Год"
    ,WORKUNITTYPEROW: string "Тпи"
  )
  with index
  (
   EM_DOCLEAVE01=CITEZENID+BEGINDATE
  ,EM_DOCLEAVE02=WORKCONTRACTID+BEGINDATE
   );
