create table D_USER.EM_SKILLUP "Таблица EM_SKILLUP"
  using "EM_SKIL.dat"
!  component USER
  with table_Code = 31735
  with tableOptions header, journal, corpo
  (
   ID : LongInt "ID аттестации",
   CITEZENID : LongInt "ID физического лица",
   EMPLOYEEID : LongInt "ID сотрудника",
   INDATE       : Date "Дата начала",
   OUTDATE      : Date "Дата окончания",
   EDTYPE       : String[255] "ТИП курса",
   ORGANISAT : String [255]    "Название организации",
   DOCTYPE      :   String[100] "Тип Документа",
   DOCNUMB      : String [100] "Номер документа",
   DOCDATE      : Date "Дата составления документа",
   REASON       : String [255] "Причина",
   COURSENAME   : String [255] "Название курса",
   JOBTITLE     :   String [255] "Тип аттестации",
   QUAL         : String [100] "Тип учебного заведения",
   PR_NUMB : String [50]   "Номер протокола",
   PR_DATE : Date "Дата протокола"


  )
  with index
  (
   i_ID=ID,
   i_CITEZENID=CITEZENID,
   i_EMPLOYEEID=EMPLOYEEID,
   i_INDATE           =  INDATE,
   i_OUTDATE          =  OUTDATE,
   i_EDTYPE           =  EDTYPE,
   i_ORGANISAT        =  ORGANISAT,
   i_DOCTYPE          =  DOCTYPE,
   i_DOCNUMB          =  DOCNUMB,
   i_DOCDATE          =  DOCDATE,
   i_REASON           =  REASON,
   i_COURSENAME       =  COURSENAME,
   i_JOBTITLE         =  JOBTITLE,
   i_QUAL             =  QUAL,
   i_PR_NUMB    =  PR_NUMB,
   i_PR_DATE    =  PR_DATE
   );