create table D_USER.EM_KPS "Таблица EM_KPS"
  using "EM_KPS.dat"
!  component USER
  with table_Code = 31737
  with tableOptions header, journal, corpo
  (
   kps01 : string [10] "Код подразделения",
   kps02 : string [10]    "Табельный №",
   kps03 : String [100] "ФИО",
   kps04 : date "Дата рождения",
   kps05 : String "Должность",
   kps06 : integer "Список",
   kps07 : integer "Класс",
   kps08 : String [30] "КПС"


  )
  with index
  (
   i_kps01=kps01,
   i_kps02=kps02,
   i_kps03=kps03,
   i_kps04=kps04,
   i_kps05=kps05,
   i_kps06=kps06,
   i_kps07=kps07,
   i_kps08=kps08

   );