// обновление даты открытия должности
/*
sql
update staffstruct set staffstruct.dinput=
case  when staff.appointdate=0 then  DATE(DATEtime(#date(9, 5, 1945),0))
         when staff.appointdate<>0 then appointdate
   end
!select staffstruct.dinput, appointdate
from   staffstruct
inner join
(
select
min(appointdate) appointdate, staffstruct.nrec  nrec
from staffstruct inner join appointments On appointments.STAFFSTR=staffstruct.nrec
where length(staffstruct.cinf3)>0
group by staffstruct.nrec
) staff On staff.nrec=staffstruct.nrec
!where staff.appointdate<>staffstruct.dinput
!where staffstruct.cinf3=631510
;
*/
/*
// обновление даты открытия подразделения
sql
update catalogs set catalogs.datn=
case  when cat.appointdate=0 then  DATE(DATEtime(#date(9, 5, 1945),0))
         when cat.appointdate<>0 then cat.appointdate
   end
!select cat.appointdate, catalogs.datn, DATE(DATEtime(#date(9, 5, 1945),0)), catalogs.datok, catalogs.code
from catalogs inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11  and length(catalogs.dopstr)>0
inner join
(
select
min(appointdate) appointdate, catalogs.nrec  nrec
from staffstruct inner join appointments On appointments.STAFFSTR=staffstruct.nrec
inner join  catalogs On catalogs.nrec=staffstruct.department
inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11

group by catalogs.nrec
) cat On cat.nrec=catalogs.nrec
!where cat.appointdate=0
;
*/

/*
sql
update catalogs set catalogs.datok=0
!select catalogs.datok
from catalogs inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11  and length(catalogs.dopstr)>0
!where catalogs.datok="30/09/2011"
;
*/

/*
// обновление даты закрытия подразделения
sql
update catalogs set catalogs.datOK=cat.DISMISSDATE
!case  when cat.DISMISSDATE=0 then  DATE(DATEtime(#date(1,09 , 2017),0))
!         when cat.DISMISSDATE<>0 then cat.DISMISSDATE
!   end
!select cat.DISMISSDATE
!cat.appointdate, catalogs.datn, DATE(DATEtime(#date(9, 5, 1945),0)), catalogs.datok, catalogs.code
from catalogs inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11  and length(catalogs.dopstr)>0
inner join
(
select
max(DISMISSDATE) DISMISSDATE, catalogs.nrec  nrec
from staffstruct inner join appointments On appointments.STAFFSTR=staffstruct.nrec
inner join  catalogs On catalogs.nrec=staffstruct.department
inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11
and  catalogs.datok=0
group by catalogs.nrec
) cat On cat.nrec=catalogs.nrec
left join
(
select
!max(DISMISSDATE) DISMISSDATE,
catalogs.nrec  nrec
from staffstruct inner join appointments On appointments.STAFFSTR=staffstruct.nrec
inner join  catalogs On catalogs.nrec=staffstruct.department
inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11
and  catalogs.datok=0
where DISMISSDATE=0
!group by catalogs.nrec
) cat1 On cat1.nrec=cat.nrec

where cat1.nrec is null
;
*/

