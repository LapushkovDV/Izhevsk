create table D_USER.EM_ATTESTATION "Таблица EM_ATTESTATION"
  using "EM_ATTES.dat"
!  component USER
  with table_Code = 31734
  with tableOptions header, journal, corpo
  (
   ID : LongInt "ID аттестации",
   CITEZENID : LongInt "ID физического лица",
   EMPLOYEEID : LongInt "ID сотрудника",
   EVENTDATE : Date "Дата встречи",
   DECISION : String [20] "Решение",
   DOCNUMB : String [150] "Номер документа",
   DOCDATE : Date "Дата составления документа",
   REASON : String [20] "Причина",
   OUTDATE : Date "Дата окончания курса",
   RATING : String [50] "Оценка за курс",
   ORGNAME : String [255]    "Название организации",
   COURSENAME : String [255] "Название курса",
   ATTEST_TYPE : String [50] "Тип аттестации",
   TYPENAME : String [50] "Тип учебного заведения",
   HOURS : String [50]   "Продолжительность курса в часах",
   PROTOCOL_NUMB : String [100]   "Номер протокола",
   PROTOCOL_DATE : Date "Дата протокола"


  )
  with index
  (
   i_ID=ID,
   i_CITEZENID=CITEZENID,
   i_EMPLOYEEID=EMPLOYEEID,
   i_EVENTDATE=EVENTDATE,
   i_DECISION=DECISION,
   i_DOCNUMB=DOCNUMB,
   i_DOCDATE=DOCDATE,
   i_REASON=REASON,
   i_OUTDATE=OUTDATE,
   i_RATING=RATING,
   i_ORGNAME=ORGNAME,
   i_COURSENAME=COURSENAME,
   i_ATTEST_TYPE=ATTEST_TYPE,
   i_TYPENAME=TYPENAME,
   i_HOURS=HOURS,
   i_PROTOCOL_NUMB=PROTOCOL_NUMB,
   i_PROTOCOL_DATE=PROTOCOL_DATE
   );