sql
insert addressn (cperson, objtype, SPOSTIND, CSTERR, CSTREET, DREGBEG, SADDRESS1, SADDRESS2, shouse, sflat, SBLOCK)
select
persons.nrec, 55, sterr.SPOSTIND, sterrparent.nrec, sterr.nrec, A0008, sterr.sname, sterr.sname
, a0005, a0007, a0006
from em_address inner join   sterr On   sterr.SGNI_CODE=em_address.a0004
inner join sterr sterrparent On sterrparent.nrec=sterr.cparent
inner join persons On persons.disprofnmb=a0001
left join addressn addressn1 On addressn1.cperson=persons.nrec and addressn1.objtype=55
where  length(em_address.a0004)>0  and a0002='Адрес временной регистрации'
and addressn1.nrec is null
!and fio='Лапушков Дмитрий Владимирович'
!and a0001=171429250
;


