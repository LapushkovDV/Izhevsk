!sql select * from addressn to dbf Z:\Import\Backup\Addressn.dbf;
!sql select * from addressn to dbf Z:\Import\Backup\Addressn.dbf;


sql
delete from em_address where atl_nrec not in (
select max(em_address.atl_nrec) nrec from em_address group by em_address.a0002, em_address.a0001
)
;



sql delete from addressn;


sql
insert addressn (cperson, objtype, SPOSTIND, CSTERR, CSTREET, SADDRESS1, SADDRESS2, shouse, sflat, SBLOCK)
select
persons.nrec, 2, sterr.SPOSTIND, sterrparent.nrec, sterr.nrec, sterr.sname, sterr.sname
, a0005, a0007, a0006
from em_address inner join   sterr On   sterr.SGNI_CODE=em_address.a0004
inner join sterr sterrparent On sterrparent.nrec=sterr.cparent
inner join persons On persons.disprofnmb=a0001
where  length(em_address.a0004)>0  and a0002='Совпадающий фактический/регистрации'
//and fio='Пасечник Ирина Антоновна'
;



sql
insert addressn (cperson, objtype, SPOSTIND, CSTERR, CSTREET, DREGBEG, SADDRESS1, SADDRESS2, shouse, sflat, SBLOCK)
select
persons.nrec, 4, sterr.SPOSTIND, sterrparent.nrec, sterr.nrec, A0008, sterr.sname, sterr.sname
, a0005, a0007, a0006
from em_address inner join   sterr On   sterr.SGNI_CODE=em_address.a0004
inner join sterr sterrparent On sterrparent.nrec=sterr.cparent
inner join persons On persons.disprofnmb=a0001
where  length(em_address.a0004)>0  and a0002='Адрес постоянной регистрации'
!and fio='Лапушков Дмитрий Владимирович'
!and a0001=171429250
;


sql
insert addressn (cperson, objtype, SPOSTIND, CSTERR, CSTREET, DREGBEG, SADDRESS1, SADDRESS2, shouse, sflat, SBLOCK)
select
persons.nrec, 4, sterr.SPOSTIND, sterrparent.nrec, sterr.nrec, A0008, sterr.sname, sterr.sname
, a0005, a0007, a0006
from em_address inner join   sterr On   sterr.SGNI_CODE=em_address.a0004
inner join sterr sterrparent On sterrparent.nrec=sterr.cparent
inner join persons On persons.disprofnmb=a0001
left join addressn addressn1 On addressn1.cperson=persons.nrec and addressn1.objtype=4
where  length(em_address.a0004)>0  and a0002='Совпадающий фактический/регистрации'
and addressn1.nrec is null
!and fio='Лапушков Дмитрий Владимирович'
!and a0001=171429250

;




sql
insert addressn (cperson, objtype,  SADDRESS1, SADDRESS2)
select persons.nrec, 3, em_person.p0004, substring(em_person2.p0004,1,80)
from persons inner join em_person On persons.filialno=em_person.p0001
inner join em_person em_person2 On em_person.p0001=em_person2.p0001
where  length(em_person.p0004)>0
;



sql
!select count(*)
update persons set persons.liveaddr=addressnType2.nrec
from EM_ADDRESS inner join persons On persons.disprofnmb=EM_ADDRESS.a0001
inner join  addressn addressnType2 On addressnType2.cperson=persons.nrec and addressnType2.objtype=2
;

sql
!select count(*)
update persons set persons.passpaddr=addressnType4.nrec
from EM_ADDRESS inner join persons On persons.disprofnmb=EM_ADDRESS.a0001
inner join  addressn addressnType4 On addressnType4.cperson=persons.nrec and addressnType4.objtype=4
;


sql
!select count(*)
update persons set persons.BORNADDR=addressnType3.nrec
from persons inner join  addressn addressnType3 On addressnType3.cperson=persons.nrec and addressnType3.objtype=3
;


