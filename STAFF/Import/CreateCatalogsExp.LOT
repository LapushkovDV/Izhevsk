create table default.EM_CATALOGSExp "Таблица EM_CatalogsExp"

  using "EM_CATEx.dat"
!  component USER
  with table_Code = 31738
  with tableOptions header, journal, corpo
  (
   Nrec              : comp  "Nrec записи",
   GroupCode         : integer "Код группировки",
   SysCode           : integer "Системный код",
   Name              : string "Наименование элемента",
   Code              : String[100] "Код пользователя",
   Isleaf            : Word  "Лист",
   DatN              : Date  "Дата Начала",
   DatOk             : Date  "Дата Окончания",
   SDopInf           : String[100] "Дополнительная информация",
   Dopstr            : String[20]  "Dopstr",
   LongName          : String "Длинное Наименование",
   catdata           : String[20] "Дополнительные данные",
   mainnrec          : comp  "Nrec главного каталога",
   parnrec           : comp "Nrec родительского каталога"
  )
  with index
  (
   i_Nrec          =Nrec,
   i_GroupCode     =GroupCode,
   i_SysCode       =SysCode,
   i_Name          =Name,
   i_Code          =Code,
   i_Isleaf        =Isleaf,
   i_DatN          =DatN,
   i_DatOk         =DatOk,
   i_SDopInf       =SDopInf,
   i_Dopstr        =Dopstr,
   i_LongName      =LongName,
   i_catdata       =catdata,
   i_mainnrec      =mainnrec,
   i_parnrec       =parnrec
   )
   ;