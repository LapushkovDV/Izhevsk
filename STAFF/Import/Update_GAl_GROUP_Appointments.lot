// Обратная разгруппировка назначений   //BEGIN

//Восстановление Промежуточных Appointments
sql
update appointments set appointments.lprizn=0
!Select appointments.nrec
from appointments where appointments.lprizn=1000 and appointments.resword[19]=0
;



//  Восстановление истории назначений на все appointments
sql
update apphist set apphist.CAPPOINT=apphist.CSPR5
!select   apphist.cappoint, apphist.cspr5
from  apphist
;



// восстановление Appointdate по Apphist
sql
update appointments set appointments.appointdate=apphist.drec
, appointments.statusapp=case when apphist.CODOPER=1 then 0 else case
when apphist.CODOPER=5 then 3 else appointments.statusapp end end
!select apphist.DREC, appointments.appointdate
from appointments inner join apphist On apphist.cappoint=appointments.nrec
!where
!apphist.DREC<> appointments.appointdate
!and appointments.resword[19]<>0
;

// Обратная разгруппировка назначений  END
