/*
//Скрытие старых назначений, даттой до последнего приема на работу
sql
!update appointments set appointments.lprizn=100
select lprizn, appointments.APPOINTDATE,persons.APPDATE, appointments.*
from appointments inner join persons On persons.nrec=appointments.person
where appointments.APPOINTDATE<persons.APPDATE
and fio='Деняев Василий Иванович'
;



// Группировка одинаковых Назначений  //BEGIN

// нумерация appointments
sql
!select appointments.nrec, nrec_count, appointdate
update appointments set  appointments.resword[20]= nrec_count

from appointments inner join
(
        select  appointments.nrec nrec , count(*)  nrec_count
        from appointments inner join appointments appointments1
             On to_days(datetime(appointments.appointdate,0))+cos(int64(appointments.nrec))>=to_days(datetime(appointments1.appointdate,0))+cos(int64(appointments1.nrec))
                     and appointments.person = appointments1.person and (appointments.lprizn=0  and appointments1.lprizn=0)
        inner join persons On persons.nrec=appointments.person
!        where persons.fio='Воробьёв Пётр Владимирович'
!        where persons.fio='Козлов Леонид Леонидович'
group by appointments.nrec
) appoint On appoint.nrec=appointments.nrec
//order by  staffstruct.department, nrec_count
;




// определение одинаковых групп appointments, простановка минимальных и максимальных номеров в appointments
!sql update appointments set resword[18]=0, resword[19]=0;


sql
update appointments set  appointments.resword[19]=appointmentsmax.resword[20],  appointments.resword[18]=appointmentsmin.resword[20]
!select
!fio, appointmentsmax.department, appointmentsmin.department, appointmentsmax.post, appointmentsmin.post,
!appointmentsmax.nrec, appointmentsmax.appointdate, appointmentsmin.appointdate
!,appointmentsmax.resword[20], appointmentsmin.resword[20]

from appointments appointmentsmax
     inner join appointments On appointments.nrec=appointmentsmax.nrec
     inner join appointments appointmentsmin   ON  appointmentsmax.person = appointmentsmin.person
           and appointmentsmax.department = appointmentsmin.department
           and appointmentsmax.post = appointmentsmin.post
           and appointmentsmax.lprizn=0  and appointmentsmin.lprizn=0
           and appointmentsmax.statusapp=3  //and appointmentsmin.statusapp=3
!           and appointmentsmax.resword[20]+cos(int64(appointmentsmax.nrec))>=appointmentsmin.resword[20]+cos(int64(appointmentsmin.nrec))
           and appointmentsmax.resword[20]>=appointmentsmin.resword[20]
     inner join persons On persons.nrec=appointmentsmax.person
     left join appointments appointmax_1 On
          appointmentsmax.person = appointmax_1.person
          and appointmentsmax.department = appointmax_1.department
          and appointmentsmax.post = appointmax_1.post
          and appointmax_1.lprizn=0
          and appointmentsmax.resword[20]=appointmax_1.resword[20]-1
     left join appointments appointmin_1 On
          appointmentsmax.person = appointmin_1.person
          and appointmentsmax.department = appointmin_1.department
          and appointmentsmax.post = appointmin_1.post
          and appointmentsmin.resword[20]=appointmin_1.resword[20]+1
          and appointmin_1.lprizn=0
//          and appointmin_1.statusapp=3
     left join appointments appointwr On
          appointmentsmax.person = appointwr.person
          and (appointmentsmax.department <> appointwr.department or appointmentsmax.post <> appointwr.post)
          and appointwr.resword[20]>appointmentsmin.resword[20]
          and appointwr.resword[20]<appointmentsmax.resword[20]
          and appointwr.lprizn=0
//          and appointwr.statusapp=3

where
appointmax_1.nrec is  null and appointmin_1.nrec is  null
and appointwr.nrec is  null




!and fio='Воробьёв Пётр Владимирович'
!and fio='Янкевич Татьяна Сергеевна'
!and (fio='Таймурзина Екатерина Владимировна'  or fio='Козлов Леонид Леонидович')
!and fio='Воробьёв Пётр Владимирович'
!and   appointmentsmin.resword[20]<>0
!order by  appointmentsmax.appointdate
;





// простановка в Apphist нреков из appointments, для того чтобы осталась ссылка на Appointments, которые будут потом удалены
sql
update apphist set CSPR5=CAPPOINT
;




// простановка даты  APPOINTDATE и СТАТУСА (statusapp) из первого по группе Appointments, который будет удален в последний по группе, который останется
sql
update  appointments set appointments.appointdate=appointmentsmin.appointdate
,appointments.statusapp=appointmentsmin.statusapp
!select appointmentsmax.appointdate, appointmentsmin.appointdate,
!appointmentsmax.resword[20], appointmentsmax.resword[19], appointmentsmax.resword[18],
!appointmentsmin.resword[20], appointmentsmin.resword[19], appointmentsmin.resword[18]
from appointments appointmentsMin inner join appointments appointmentsMax
           ON  appointmentsmax.person = appointmentsmin.person
           and appointmentsmax.department = appointmentsmin.department
           and appointmentsmax.post = appointmentsmin.post
           and appointmentsmax.lprizn=0  and appointmentsmin.lprizn=0
           and appointmentsmax.resword[18]=appointmentsmin.resword[20]
inner join appointments On appointments.nrec=appointmentsmax.nrec
inner join persons On persons.nrec=appointmentsmax.person
!where
!(fio='Козлов Леонид Леонидович' or fio='Таймурзина Екатерина Владимировна')
!fio='Янкевич Татьяна Сергеевна'
!fio='Воробьёв Пётр Владимирович'
;



//Скрытие Промежуточных Appointments
sql
update appointments set appointments.lprizn=1000
!Select appointments.nrec
from appointments where appointments.lprizn=0 and appointments.resword[19]=0
;



// Перенос истории назначений на актуальный appointments
sql
update apphist set apphist.cappoint=appointmentsMax.nrec
!select   appointmentsMax.nrec, apphist.nrec

from appointments appointmentsMax
     inner join appointments appointmentsdell On appointmentsdell.resword[20]>=appointmentsMax.resword[18]
           and appointmentsdell.resword[20]<appointmentsMax.resword[19]
           and appointmentsmax.person = appointmentsdell.person
           and appointmentsmax.department = appointmentsdell.department
           and appointmentsmax.post = appointmentsdell.post
           and appointmentsMax.resword[19]<>0
           and appointmentsMax.resword[20]<>0
           and appointmentsdell.resword[19]=0
           and appointmentsdell.resword[20]<>0
           and (appointmentsMax.lprizn=0 or appointmentsMax.lprizn=3)
           and appointmentsDell.lprizn=1000
inner join apphist On apphist.cappoint=appointmentsDell.nrec
inner join persons On persons.nrec=appointmentsmax.person
where appointmentsdell.lprizn=1000
!group by  apphist.nrec, appointmentsdell.nrec
!having count(*)>1
;

// Группировка одинаковых Назначений  //END
*/

