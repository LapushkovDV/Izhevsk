
sql
update persons set persons.csovm=int64(klsovm.sovm)
!select persons.csovm, klsovm.sovm, klsovm.nsovm, em_person.p0007
from persons
inner join em_person On persons.filialno=em_person.p0001
inner join klsovm ON klsovm.nrec=persons.csovm

!where //em_person.p0007='Внутреннее совместительство'
!persons.fio='Авдеев Евгений Александрович'
;

!sql select * from persons where csovm=3