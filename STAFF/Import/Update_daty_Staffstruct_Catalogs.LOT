//  Запускать после импорта или апдейта Catalogs(подразделения), Staffstruct, Appointments
//  В результате установятся правильные даты открытия, закрытия должностей и подразделений в соответствии со статусами штатки и должностей по КИС


!sql delete from appointments where appointments.appointdate<=0 and appointments.dateend=0;

// обновление даты открытия должности по первому назначению на должность
/*
sql
update staffstruct set staffstruct.dinput=
case  when appointments.appointdate=0 then  DATE(DATEtime(#date(9, 5, 1945),0))
         when appointments.appointdate<>0 then appointdate
   end
!select fio, staffstruct.dinput, appointdate,   catalogspost.name, catalogspost.code, catalogs.name, catalogs.code
from   staffstruct
inner join  appointments On appointments.STAFFSTR=staffstruct.nrec and appointments.lprizn<>3 and appointments.resword[20]=1
inner join catalogs On staffstruct.department=catalogs.nrec
inner join catalogs catalogspost On catalogspost.nrec=staffstruct.post
inner join persons On persons.nrec=appointments.person
where length(staffstruct.cinf3)>0
and appointments.appointdate<staffstruct.dinput  // and appointments.appointdate<>0
!where staffstruct.cinf3=631510
;
*/



/*
// обновление даты открытия подразделения  по наименьшой дате  назначения на должность

sql
!update catalogs set catalogs.datn=
!case  when appointments.appointdate=0 then  DATE(DATEtime(#date(9, 5, 1945),0))
!         when appointments.appointdate<>0 then appointments.appointdate
!   end
select appointments.appointdate, catalogs.datn, DATE(DATEtime(#date(9, 5, 1945),0)), catalogs.datok, catalogs.code
from catalogs inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink  and catalogsmain.syscode=-11
and catalogsmain.syscode=-11  and length(catalogs.dopstr)>0
inner join staffstruct On catalogs.nrec=staffstruct.department
inner join appointments On appointments.STAFFSTR=staffstruct.nrec  and appointments.lprizn<>3 and appointments.resword[20]=1
where appointments.appointdate<catalogs.datn
!where cat.appointdate=0
;

*/



/*
// Закрытие  должностей (устанавливаем дату закрытия должности (по последнему закрытому назначению или если пусто по указанной дате))
// по архивным штаткам



sql
!update staffstruct set staffstruct.DCLOSE=COALESCE(staff.DISMISSDATE,s0025, #date(1,9,2017))

select
COALESCE(staff.DISMISSDATE, #date(1,9,2017)),
staff.DISMISSDATE, staffstruct.DCLOSE, em_staffstruct.S0028, em_staffstruct.S0024


from   staffstruct
inner join em_staffstruct On em_staffstruct.s0001=staffstruct.CNEWSPR3
left join
(
select
max(DISMISSDATE) DISMISSDATE, staffstruct.nrec  nrec
from staffstruct inner join appointments On appointments.STAFFSTR=staffstruct.nrec
where length(staffstruct.CNEWSPR3)>0
group by staffstruct.nrec
) staff On staff.nrec=staffstruct.nrec

where
(em_staffstruct.S0028='Архивный')
and  staffstruct.DCLOSE=0
!and em_staffstruct.s0008='222'
!) staff
;
*/


// Закрытие  должностей (устанавливаем дату закрытия должности (по последнему закрытому назначению или если пусто по указанной дате))
// по архивным в КИС должностям

/*
sql
!update staffstruct set staffstruct.DCLOSE=COALESCE(staff.DISMISSDATE,#date(1,9,2017))


select
distinct
cast(COALESCE(staff.DISMISSDATE,#date(1,9,2017)) as date) d1
,staff.DISMISSDATE, staffstruct.DCLOSE, em_staffstruct.S0028, em_staffstruct.S0024
,staffstruct.nrec, staff.fio, em_staffstruct.s0001
from   staffstruct
inner join em_staffstruct On em_staffstruct.s0001=staffstruct.CNEWSPR3
left join
(
select
max(DISMISSDATE) DISMISSDATE, staffstruct.nrec  nrec, min(fio) fio
from staffstruct inner join appointments On appointments.STAFFSTR=staffstruct.nrec
inner join persons On persons.nrec=appointments.person
where length(staffstruct.CNEWSPR3)>0
group by staffstruct.nrec
) staff On staff.nrec=staffstruct.nrec
where
(em_staffstruct.S0028='Активный' and em_staffstruct.S0024='архивный')
and dclose=0
and  staffstruct.DCLOSE=0
!and em_staffstruct.s0008='222'

;
*/




// Открытие  должностй (удаляем дату закрытия должности)по активным  должностям и активным штаткам

/*
sql
update staffstruct set staffstruct.DCLOSE=#date(0,0,0)

!select
! staffstruct.nrec, staffstruct.DCLOSE, em_staffstruct.S0028, em_staffstruct.S0024
from   staffstruct
inner join em_staffstruct On em_staffstruct.s0001=staffstruct.CNEWSPR3
inner join (
select max(atl_nrec) MaxNrec
from em_staffstruct
group by s0001
) S1 On s1.Maxnrec=em_staffstruct.atl_nrec
where
(em_staffstruct.S0028='Активный' and em_staffstruct.S0024='активный')
and staffstruct.DCLOSE<>0  and  staffstruct.DCLOSE<#date(01,11,2017)
!and em_staffstruct.s0008='983-5'
;
*/






/*
// закрытие подразделения (устанавливаем дату закрытия), где нет активных ставок

sql
update catalogs set catalogs.datOK=cat.dclose
!case  when cat.DISMISSDATE=0 then  DATE(DATEtime(#date(1,09 , 2017),0))
!         when cat.DISMISSDATE<>0 then cat.DISMISSDATE
!   end
!select
!distinct  cat.Dclose
!,catalogs.nrec, catalogs.datn, DATE(DATEtime(#date(9, 5, 1945),0)), catalogs.datok, catalogs.code
from catalogs inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11  and length(catalogs.dopstr)>0
inner join
(
select
max(dclose) dclose, catalogs.nrec  nrec
from staffstruct inner join  catalogs On catalogs.nrec=staffstruct.department
inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11
group by catalogs.nrec
) cat On cat.nrec=catalogs.nrec
left join
(
select
catalogs.nrec  nrec
from staffstruct inner join  catalogs On catalogs.nrec=staffstruct.department
inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11
where (dclose=0 or dclose>curdate)
) cat1 On cat1.nrec=cat.nrec
where cat1.nrec is null
and catalogs.datok=0
!and catalogs.code='957'
;
*/

/*
// закрытие подразделения (устанавливаем дату закрытия), где совсем нет  должностей

sql
update catalogs set catalogs.datOK=catalogs.datn
!case  when cat.DISMISSDATE=0 then  DATE(DATEtime(#date(1,09 , 2017),0))
!         when cat.DISMISSDATE<>0 then cat.DISMISSDATE
!   end
!select
!distinct  cat.Dclose
catalogs.nrec, catalogs.dopstr, em_catpodr.d0010, catalogs.datn, DATE(DATEtime(#date(9, 5, 1945),0)), catalogs.datok, catalogs.code
from catalogs inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11  and length(catalogs.dopstr)>0
inner join em_catpodr On em_catpodr.d0001=catalogs.dopstr
left join staffstruct  On catalogs.nrec=staffstruct.department
where staffstruct.nrec is null
and catalogs.datok=0
and em_catpodr.d0010='Архивный'
!and catalogs.code='957'
;
*/






/*
// открытие  подразделения (удаляем дату закрытия), где есть активные ставки
sql
update catalogs set catalogs.datOK=0
!case  when cat.DISMISSDATE=0 then  DATE(DATEtime(#date(1,09 , 2017),0))
!         when cat.DISMISSDATE<>0 then cat.DISMISSDATE
!   end
!select distinct catalogs.datOK, catalogs.nrec
!,catalogs.datn, DATE(DATEtime(#date(9, 5, 1945),0)), catalogs.datok, catalogs.code
from catalogs inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11  and length(catalogs.dopstr)>0
left join
(
select
catalogs.nrec  nrec
from staffstruct inner join  catalogs On catalogs.nrec=staffstruct.department
inner join catalogs catalogsmain On CatalogsMain.Nrec=catalogs.mainlink
and catalogsmain.syscode=-11
!where  catalogs.datok=0
where dclose=0
) cat1 On cat1.nrec=catalogs.nrec
where cat1.nrec is  not null
and    catalogs.datOK<>0
!and catalogs.code='957'
;
*/


