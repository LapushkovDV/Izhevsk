// меняем переключатель на аналитику
SQL
//update GP_KPI_DOC_SP set GP_KPI_DOC_SP.FARRVALUE[5]=CAST(Spkau.nrec as String)
select GP_KPI_DOC_SP.StrTabn,GP_KPI_DOC_SP.FARRVALUE[5] //,spkau.Code, SubString(spkau.name,1,40)
From GP_KPI_DOC_SP
//inner join SPKau on CAST(SpKau.Code As Word) = CAST('0'+GP_KPI_DOC_SP.FARRVALUE[5] As Word) and     10022 = SpKau.KodGrKau
where GP_KPI_DOC_SP.cGP_KPI_RAISE=#comp(281474976710657)
;