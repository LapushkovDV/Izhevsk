sql
update catalogs set catalogs.name=em_staffstruct.s0014
!select catalogs.name,
! (em_post.p0002+' '+replace(p0009,'нет',''))
!em_staffstruct.s0014, em_post.p0002
from em_staffstruct inner join em_post On em_post.p0001=em_staffstruct.s0012
inner join catalogs On catalogs.name=(em_post.p0002+' '+replace(p0009,'нет',''))
inner join catalogs catalogsMain On catalogsmain.syscode=9004
inner join catalogs catalogsParent On catalogsparent.syscode=-22
      and catalogs.cparent=catalogsparent.nrec
      and catalogs.mainlink=catalogsmain.nrec
where  catalogs.name<>em_staffstruct.s0014
;