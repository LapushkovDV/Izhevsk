create table D_USER.EM_VACATIONS "Таблица EM_VACATIONS"
  using "EM_VACAT.dat"
!  component USER
  with table_Code = 31731
  with tableOptions header, journal, corpo
  (
   V0001 : LongInt "ID физического лица",
   V0002 : Integer "Тип отпуска",
   V0003 : date "Период работы (начало)",
   V0004 : Date "Период работы (конец)",
   V0005 : Date "Дата начала отпуска",
   V0006 : Date "Дата конца отпуска",
   V0007 : Integer "Календарные дни",
   V0008 : String [255] "Наименование отпуска",
   V0009 : LongInt "ID сотрудника",
   V0010 : String [10]  "Код Отпуска",
   V0011 : LongInt  "ID Отпуска"




  )
  with index
  (
   i_V0001=V0001,
   i_V0002=V0002,
   i_V0003=V0003,
   i_V0004=V0004,
   i_V0005=V0005,
   i_V0006=V0006,
   i_V0007=V0007,
   i_V0008=V0008,
   i_V0009=V0009,
   i_V0010=V0010,
   i_V0011=V0011

  );
