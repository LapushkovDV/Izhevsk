sql
!delete from catalogs where nrec in (
select
!distinct
catalogs.nrec,  catalogs.name
!katpodr.nrec
!catalogs.nrec
from catalogs    inner join catalogs catalogsMain On catalogsmain.nrec=catalogs.mainlink and catalogsmain.syscode=-11
!left join ExtCatLinks  On Catalogs.nrec=ExtCatLinks.Staffcat
!left join katpodr On katpodr.nrec=ExtCatLinks.extcat
!left join lschet On lschet.cex=katpodr.nrec
left join catalogs catalogsparent On catalogsparent.cparent=catalogs.nrec
left join appointments On appointments.department=catalogs.nrec
     left join staffstruct On staffstruct.department=catalogs.nrec
where
appointments.nrec is null
and
staffstruct.nrec is null
and
catalogsparent.nrec is null
!and
!lschet.nrec is null
!)
;