from staffstruct staffstruct1 inner join em_staffstruct On em_staffstruct.s0001=staffstruct1.cnewspr3
inner join em_tarstav On em_tarstav.t0001=em_staffstruct.s0002
where
(t0007<>staffstruct1.MINSUMMA or t0008<>staffstruct1.MAXSUMMA)

!or taxrate<>t0006
;
*/


/*
// Обновление  в Staffstruct ссылок на тарифные ставки
sql
update staffstruct set staffstruct.tariff=tarstavnew.nrec
!select distinct staffstruct1.nrec
from staffstruct staffstruct1 inner join em_staffstruct On em_staffstruct.s0001=staffstruct1.cnewspr3
inner join tarstav On tarstav.nrec=staffstruct1.tariff
inner join tarstav tarstavNew On tarstavNew.SFIELD1=em_staffstruct.s0002
where
tarstav.SFIELD1<>tarstavNew.SFIELD1

!or taxrate<>t0006
;
*/



