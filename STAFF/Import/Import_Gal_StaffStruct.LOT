/*
// Загрузка штатного расписания
sql
insert into staffstruct
(Department, Post
,TARIFF
,category
,empcategory
,paymodel
,workregime , taxrate, MinSumma, MaxSumma
,WORKSTATIONS,  Dinput, Dclose, cPodr, warch, SINFO1, SINFO2, CNEWSPR3)

select
distinct
catalogsdep.nrec, catalogsPost.nrec
,tarstav.nrec
,tarstav.razr
,KlKatego.Nrec,  tarstav.sisopl
,KLRejim.Nrec
,case when tarstav.tarif=1  then em_staffstruct.s0017 else  tarstav.tarif  end
,tarstav.TARMIN, tarstav.TARMAX
,s0019
, case   when S0010>0 then S0010 else S0025 end
,  case  when S0024   like '%Архивный%' then  S0025   else 0    end
,extcatlinks.extcat
,case  when S0024   like '%Архивный%' then  1   else 0    end
,S0024, 'EMPTY'
,em_staffstruct.S0001
from
(
select max(atl_nrec) MaxNrec
from em_staffstruct
!where s0021>0
!where length(FIO)>3
group by s0001 //, s0024
) S1 inner join em_staffstruct On em_staffstruct.Atl_nrec=S1.MaxNrec // and s0021>0
left join tarstav On Tarstav.SFIELD1=em_staffstruct.s0002  and length(Tarstav.SFIELD1)>0
left join klrejim  On klrejim.rejim=em_staffstruct.s0021
left join KlKatego On KlKatego.Kod=em_staffstruct.s0016
left join catalogs catalogsPostmain On catalogsPostmain.syscode=9004
left join catalogs catalogsPostParent On catalogsPostParent.syscode=49
left join catalogs catalogsPost ON catalogsPost.name=EM_staffstruct.S0014
     and catalogsPostmain.nrec = catalogsPost.mainlink   and      catalogsPostPaarent.nrec = catalogsPost.cParent
left join catalogs catalogsDep ON catalogsDep.dopstr=EM_staffstruct.S0007
left join catalogs catalogsDepmain On catalogsDepmain.syscode=-11 and catalogsDepmain.nrec = catalogsDep.mainlink
left join catalogs catalogsWorkCond ON catalogsWorkCond.dopstr=EM_staffstruct.S0018   and    EM_staffstruct.S0018<>0
left join catalogs catalogsWorkCondmain On catalogsWorkCondmain.syscode=-33 and catalogsWorkCondmain.nrec = catalogsWorkCond.mainlink
left join extcatlinks On extcatlinks.STAFFCAT = catalogsdep.nrec and objtype = 11
left join staffstruct On staffstruct.CNEWSPR3=em_staffstruct.S0001 // and staffstruct.cInf3=em_staffstruct.S0024
left join
(
select max(catalogs.nrec) nrec from  catalogs inner join catalogs catalogsmain On catalogsmain.nrec=catalogs.mainlink
       and catalogsmain.syscode=9004 group by catalogs.name
) cat On cat.nrec=catalogspost.nrec
where
(rtrim(em_staffstruct.s0024)='активный' and rtrim(em_staffstruct.s0028)='активный')
and staffstruct.nrec is  null
;
*/


// Обновление старых записей Staffstruct

sql

/*
update staffstruct
set
Department                  = catalogsdep.nrec
,cPodr                      = extcatlinks.extcat
,Post                       = catalogsPost.nrec
,TARIFF                     = tarstav.nrec
,category                   = tarstav.razr
,empcategory                = KlKatego.Nrec
,paymodel                   = tarstav.sisopl
,workregime                 = KLRejim.Nrec
,taxrate                    = case when tarstav.tarif=1  then em_staffstruct.s0017 else  tarstav.tarif  end
,MinSumma                   = tarstav.TARMIN
,MaxSumma                   = tarstav.TARMAX
*/

select

Department   ,                catalogsdep.nrec
,cPodr       ,                extcatlinks.extcat
,Post        ,                catalogsPost.nrec
,TARIFF      ,                tarstav.nrec
,category    ,                tarstav.razr
,empcategory ,                KlKatego.Nrec
,paymodel    ,                tarstav.sisopl
,workregime  ,                KLRejim.Nrec
,taxrate     ,                case when tarstav.tarif=1  then em_staffstruct.s0017 else  tarstav.tarif  end
,MinSumma    ,                tarstav.TARMIN
,MaxSumma    ,                tarstav.TARMAX

from
(
select max(atl_nrec) MaxNrec
from em_staffstruct
group by s0001
) S1 inner join em_staffstruct On em_staffstruct.Atl_nrec=S1.MaxNrec
inner join staffstruct On staffstruct.CNEWSPR3=em_staffstruct.S0001
left join TARSTAVSYNC On TARSTAVSYNC.ID=em_staffstruct.s0002
left join tarstav On Tarstav.Nrec=TARSTAVSYNC.CTARSTAV
left join klrejim  On klrejim.rejim=em_staffstruct.s0021
left join KlKatego On KlKatego.Kod=em_staffstruct.s0016
left join catalogs catalogsPostmain On catalogsPostmain.syscode=9004
left join catalogs catalogsPostParent On catalogsPostParent.syscode=49
left join catalogs catalogsPost ON catalogsPost.name=EM_staffstruct.S0014
    and catalogsPostmain.nrec = catalogsPost.mainlink   and      catalogsPostParent.nrec = catalogsPost.cParent
left join catalogs catalogsDep ON catalogsDep.dopstr=EM_staffstruct.S0007
left join catalogs catalogsDepmain On catalogsDepmain.syscode=-11 and catalogsDepmain.nrec = catalogsDep.mainlink
left join extcatlinks On extcatlinks.STAFFCAT = catalogsdep.nrec and objtype = 11

left join
(
select max(catalogs.nrec) nrec from  catalogs inner join catalogs catalogsmain On catalogsmain.nrec=catalogs.mainlink
       and catalogsmain.syscode=9004 group by catalogs.name
) cat On cat.nrec=catalogspost.nrec
where
(rtrim(em_staffstruct.s0024)='активный' and rtrim(em_staffstruct.s0028)='активный')
and
(
Department                    <> catalogsdep.nrec
or cPodr                      <> extcatlinks.extcat
or Post                       <> catalogsPost.nrec
or TARIFF                     <> tarstav.nrec
or category                   <> tarstav.razr
or empcategory                <> KlKatego.Nrec
or paymodel                   <> tarstav.sisopl
or workregime                 <> KLRejim.Nrec
!or taxrate                    <> case when tarstav.tarif=1  then em_staffstruct.s0017 else  tarstav.tarif  end
!or MinSumma                   <> tarstav.TARMIN
!or MaxSumma                   <> tarstav.TARMAX
)
to dbf Z:\Import\Check_Update_staffstruct.xls
;



