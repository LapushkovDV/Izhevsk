/*
// Удаление должностей, которые по КИС проектные
sql
!delete from staffstruct where nrec in
!(
select
staffstruct.nrec
!staffstruct.seqnmb, catalogs.code, catalogs.name
from staffstruct inner join em_staffstruct On em_staffstruct.s0001=staffstruct.CNEWSPR3
inner join catalogs On catalogs.nrec=staffstruct.department
left join appointments On appointments.staffstr=staffstruct.nrec and lprizn<>1000
where s0024='Проектный'
!and catalogs.code='905-6'
and appointments.nrec is null
!)
;
*/




