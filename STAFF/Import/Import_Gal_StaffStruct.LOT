/*
// проверка на соответствие тарифных  ставок
sql
select distinct
t0001, t0007, MINSUMMA, tarmin, t0008, MAXSUMMA, tarmax, taxrate, t0006
,tarstav.nrec
from staffstruct inner join em_staffstruct On em_staffstruct.s0001=staffstruct.cnewspr3
!inner join tarstav  On tarstav.nrec=staffstruct.tariff
inner join em_tarstav On em_tarstav.t0001=em_staffstruct.s0002
left join tarstav  On tarstav.SFIELD1=em_staffstruct.s0002
where
!tarstav.SFIELD1 is null
!tarstav.SFIELD1<>em_tarstav.t0001
!or
(t0007<>MINSUMMA or t0008<>MAXSUMMA)
or taxrate<>t0006
!order by  SFIELD1
;
*/


/*
// Обновление тарифных ставок в Staffstruct
sql
