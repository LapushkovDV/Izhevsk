
create table default.EM_CATALOGS "Таблица EM_CATALOGS"

  using "EM_CATAL.dat"
!  component USER
  with table_Code = 31706
  with tableOptions header, journal, corpo
  (
   C0001 : LongInt "ID элемента каталога",
   C0002 : String [100] "Код элемента каталога",
   C0003 : String [255] "Наименование элемента",
   C0004 : LongInt "ID главного каталога",
   C0005 : String [100] "Код главного элемента",
   C0006 : String [255] "Наименование главного элемента",
   C0007 : Comp "Статус Импорта"




  )
  with index
  (
   i_C0001=C0001,
   i_C0002=C0002,
   i_C0003=C0003,
   i_C0004=C0004,
   i_C0005=C0005,
   i_C0006=C0006,
   i_C0007=C0007

  );

