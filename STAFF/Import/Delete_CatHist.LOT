sql
!insert into cathist (CCAT, CPARENT, Name, NParent, Dat1, WFLD1 )
delete from cathist where nrec in
(
select
cathist.nrec
!count(*)
from cathist inner join catalogs On catalogs.nrec=cathist.cCat
left join catalogs catalogsParent1 On catalogsParent1.Nrec=catalogs.cParent
left join catalogs catalogsParent2 On catalogsParent2.Nrec=catalogsparent1.cParent
left join catalogs catalogsParent3 On catalogsParent3.Nrec=catalogsparent2.cParent
left join catalogs catalogsParent4 On catalogsParent4.Nrec=catalogsparent3.cParent
left join catalogs catalogsParent5 On catalogsParent5.Nrec=catalogsparent4.cParent
left join catalogs catalogsParent6 On catalogsParent6.Nrec=catalogsparent5.cParent

inner join catalogs catalogsMain On catalogs.mainlink=catalogsMain.Nrec

where catalogsmain.syscode=-11
!and length(catalogs.DOPSTR)=0
and
(
catalogsparent1.name='Энергомаштест2' or
catalogsparent2.name='Энергомаштест2' or
catalogsparent3.name='Энергомаштест2' or
catalogsparent4.name='Энергомаштест2' or
catalogsparent5.name='Энергомаштест2' or
catalogsparent6.name='Энергомаштест2' or
catalogsparent1.name='Энергомаш' or
catalogsparent2.name='Энергомаш' or
catalogsparent3.name='Энергомаш' or
catalogsparent4.name='Энергомаш' or
catalogsparent5.name='Энергомаш' or
catalogsparent6.name='Энергомаш'

)
)
;