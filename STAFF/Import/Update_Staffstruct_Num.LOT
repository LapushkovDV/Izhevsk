sql
//выполнено в 23:19

!select staffstruct.nrec, nrec_count
update staffstruct set  staffstruct.SEQNMB= nrec_count
//select staff.nrec, staff.nrec_count, cat1.name, staffstruct.taxrate, cast(staffstruct.dclose as longint)
from staffstruct inner join
(
select  staffstruct.nrec nrec , count(*)  nrec_count
!staffstruct.department, staffstruct.nrec, staffstruct1.nrec
!, cast(staffstruct.nrec as longint)-cast(staffstruct1.nrec as longint)

from staffstruct inner join staffstruct staffstruct1 On
 case when cast(staffstruct.dclose as longint) > 1 then
COALESCE(staffstruct.maxsumma, staffstruct.taxrate) + 1000000 + COS(int64(staffstruct.nrec)) else COALESCE(staffstruct.maxsumma, staffstruct.taxrate) + COS(int64(staffstruct.nrec)) end
<= case when cast(staffstruct1.dclose as longint) > 1 then
    COALESCE(staffstruct1.maxsumma, staffstruct1.taxrate) + 1000000 + COS(int64(staffstruct1.nrec)) else COALESCE(staffstruct1.maxsumma, staffstruct1.taxrate) + COS(int64(staffstruct1.nrec)) end
     and staffstruct.department=staffstruct1.department
!     and staffstruct.nrec>=staffstruct1.nrec

inner join catalogs catalogsDep ON catalogsDep.nrec=staffstruct.department //and catalogsDep.code='942'
inner join catalogs catalogsDepmain On  catalogsDepmain.nrec = catalogsDep.mainlink
!          and    catalogsDepmain.code='000001'
group by staffstruct.nrec
) staff On staff.nrec=staffstruct.nrec
inner join catalogs on staffstruct.department = catalogs.nrec
inner join catalogs cat1 on staffstruct.post = cat1.nrec
 //order by  staffstruct.department, nrec_count
;



