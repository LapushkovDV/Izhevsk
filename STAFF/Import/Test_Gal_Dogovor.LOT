sql
!update spallstaff set spallstaff.resstring[1]=nrec_count
select appointments.nrec,  count(*)  nrec_count
from appointments inner join appointments appointments1 On appointments.appointdate >=  appointments1.appointdate
     and  appointments.person =  appointments1.person
     and  appointments.Lprizn =  appointments1.Lprizn
     and  appointments.statusapp =  appointments1.statusapp and appointments1.statusapp=3
inner join spallstaff On appointments.nrec=spallstaff.rescomp[10] and spallstaff.wnocon=6  and length(spallstaff.resstring[1])<>0
group by appointments.nrec
;
