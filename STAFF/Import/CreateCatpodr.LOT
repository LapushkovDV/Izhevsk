create table D_USER.EM_CATPODR "Таблица EM_CATPODR"
  using "EM_CATP.dat"
!  component USER
  with table_Code = 31708
  with tableOptions header, journal, corpo
  (
   D0001 : LongInt "ID уровня",
   D0002 : String [50] "Код подразделения",
   D0003 : String [255] "Наименование подразделения",
   D0004 : String [255] "Длинное наименование",
   D0005 : LongInt   "ID вышестоящего подразделения",
   D0006 : String  [20]    "Код вышестоящего подразделения",
   D0007 : Date     "Дата ввода",
   D0008 : String [255] "Главный каталог",
   D0009 : String [100] "Тип Подразделения",
   D0010 : String [100] "Статус подразделения",
   D0011 : LongInt "ID Руководителя"
  )
  with index
  (
   i_D0001 = D0001,
   i_D0002 = D0002,
   i_D0003 = D0003,
   i_D0004 = D0004,
   i_D0005 = D0005,
   i_D0006 = D0006,
   i_D0007 = D0007,
   i_D0008 = D0008,
   i_D0009 = D0009,
   i_D0010 = D0010,
   i_D0011 = D0011
  );
