// Предварительная загрузка в catalogs -  Форма обучения
sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name, Code)
select distinct catalogs.nrec, catalogs.nrec, 0, 0, E0009, CatalogsKis.Code
from em_education Ed left join catalogs catalogsKis On CatalogsKis.Name= Ed.E0009
     and catalogsKis.mainlink=0 and catalogsKis.BPICK<>0
inner join catalogs On Catalogs.syscode=-15

