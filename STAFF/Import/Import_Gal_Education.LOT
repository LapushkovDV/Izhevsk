!  Загрузка в catalogs видов образования
/*
sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name, Code)
select distinct catalogs.nrec, catalogs.nrec, 0, 0, E0012, CatalogsKis.Code
from em_education Ed
left join catalogs catalogsKis On CatalogsKis.Name= Ed.E0012
        and catalogsKis.mainlink=0 and catalogsKis.BPICK<>0
inner join catalogs On Catalogs.syscode=-9
where E0012 not in
(
select distinct E0012 education
from
EM_Education  Ed inner join catalogs On Catalogs.Name= Ed.E0012
inner   join catalogs catalogsMainLink ON catalogsMainLink.syscode=-9 and catalogsMainlink.nrec = Catalogs.mainlink
)
and length(E0012)>0
;



// Предварительная загрузка в catalogs  видов документов об образовании


sql
insert into  catalogs (cparent, mainlink, GROUPCODE, SYSCODE, Name, Code)
select distinct catalogs.nrec, catalogs.nrec, 0, 0, E0001, CatalogsKis.Code
from em_education Ed left join catalogs catalogsKis On CatalogsKis.Name= Ed.E0001
     and catalogsKis.mainlink=0 and catalogsKis.BPICK<>0
inner join catalogs On Catalogs.syscode=-5

where E0001 not in
(
select distinct E0001 education
from
EM_Education  Ed inner join catalogs On Catalogs.Name= Ed.E0001
inner   join catalogs catalogsMainLink ON catalogsMainLink.syscode=-5 and catalogsMainlink.nrec = Catalogs.mainlink
)
and length(E0001)>0
;


