)
and length(E0009)>0
;



// Загрузка в Галактический Education

delete all from education;

sql
insert into  education (WTYPE, person, level, seqnmb, name, SPECIALITY, QUALIFICATION, mode,  series, DIPLOMNMB, DIPLOMDATE, Fromdate, Todate )
select distinct  1,persons.nrec, CatalogsLevel.nrec, CatalogsDiplom.code, CatalogsVuz.nrec, CatalogsSpec.nrec,
CatalogsKval.nrec, CatalogsMode.Nrec, E0002, E0003,
E0004,
  case  when e0007=0 then  0
         when E0007>0 then 256*256*e0007+256*5+31
   end,
  case  when e0008=0 then  0
         when E0008>0 then 256*256*e0008+256*5+31
   end
from persons inner join  em_person   On Persons.DISPROFNMB = Em_person.P0030
     inner join em_education Ed ON Ed.E0000=Em_person.P0030
     inner join catalogs CatalogsLevelmain On CatalogsLevelmain.syscode=-9
     inner join catalogs CatalogsDiplomMain On CatalogsDiplomMain.syscode=-5
     inner join catalogs CatalogsVuzMain  On CatalogsVuzMain.syscode=-24
     inner join catalogs CatalogsSpecMain  On CatalogsSpecMain.syscode=-32
     inner join catalogs CatalogsKvalMain  On CatalogsKvalMain.syscode=-26
     inner join catalogs CatalogsModeMain  On CatalogsModeMain.syscode=-15
     left  join catalogs Catalogslevel On Catalogslevel.name=Ed.E0012 and CatalogsLevel.mainlink=CatalogsLevelMain.nrec
     left  join catalogs CatalogsDiplom On CatalogsDiplom.name=Ed.E0001 and CatalogsDiplom.mainlink=CatalogsDiplomMain.nrec
     left  join catalogs CatalogsVuz On CatalogsVuz.name=Ed.E0005 and CatalogsVuz.mainlink=CatalogsVuzMain.nrec
     left  join catalogs CatalogsSpec On CatalogsSpec.name=Ed.E0006 and CatalogsSpec.mainlink=CatalogsSpecMain.nrec
     left  join catalogs CatalogsKval On CatalogsKval.name=Ed.E0013 and CatalogsKval.mainlink=CatalogsKvalMain.nrec
     left  join catalogs CatalogsMode On CatalogsMode.name=Ed.E0009 and CatalogsMode.mainlink=CatalogsModeMain.nrec
where (CatalogsLevel.Nrec is not null and CatalogsDiplom.Nrec is not null or CatalogsVuz.Nrec is not null or CatalogsSpec.Nrec is not null or CatalogsKval.Nrec is not null or CatalogsMode.Nrec is not null)
;


// Загрузка  Education в persons
//ED - тут стоит ссылка на Catalogs - Есть операции
//sql update persons set persons.education=education.nrec from persons inner join  education On  education.person=persons.nrec;

sql delete from badge;
sql
insert into badge (person, appoint, badgeyear, badgemonth )
select persons.nrec, catalogs.nrec, 1341, 10
from EM_education inner join persons On persons.disprofnmb=em_education.e0000
inner join catalogs On catalogs.name=em_education.e0011
inner join catalogs catalogsmain on catalogsmain.nrec=catalogs.mainlink and catalogsmain.syscode=1340
*/
SQL Delete
//select Persons.Fio,Education.Nrec
From Education
//inner join Persons on Education.Person = Persons.Nrec
where exists
( Select Edu2.Nrec
  From Education Edu2
  left outer join Catalogs CatSpec2 on CatSpec2.Nrec = Edu2.SPECIALITY
  left outer join Catalogs CatSpec on CatSpec.Nrec = Education.SPECIALITY
  where
    Education.PERSON           =Edu2.PERSON
and Edu2.Nrec>Education.Nrec
and Education.LEVEL        =Edu2.LEVEL
and Education.NAME         =Edu2.NAME
and Education.LEARNADDR    =Edu2.LEARNADDR
and Education.MODE         =Edu2.MODE
and Education.COURSE       =Edu2.COURSE
and Education.FROMDATE     =Edu2.FROMDATE
and Education.TODATE       =Edu2.TODATE
and Education.DIPLOMNMB    =Edu2.DIPLOMNMB
and Education.DIPLOMDATE   =Edu2.DIPLOMDATE
//and Education.SPECIALITY   =Edu2.SPECIALITY
and Upper(CatSpec.Name)          =Upper(CatSpec2.Name)
and Education.QUALIFICATION=Edu2.QUALIFICATION
and Education.SEQNMB       =Edu2.SEQNMB
and Education.CQUALTYPE    =Edu2.CQUALTYPE
and Education.CREASON      =Edu2.CREASON
and Education.SNOTE        =Edu2.SNOTE
and Education.CADDINF1     =Edu2.CADDINF1
and Education.WDOP         =Edu2.WDOP
and Education.IATTR        =Edu2.IATTR
and Education.WTYPE        =Edu2.WTYPE
and Education.PAYSUM       =Edu2.PAYSUM
and Education.CINF1        =Edu2.CINF1
and Education.CINF2        =Edu2.CINF2
and Education.CPLACE       =Edu2.CPLACE
and Education.CCONTDOC     =Edu2.CCONTDOC
and Education.IDOP         =Edu2.IDOP
and Education.DPLAN1       =Edu2.DPLAN1
and Education.DPLAN2       =Edu2.DPLAN2
and Education.WREZ         =Edu2.WREZ
and Education.CREF1        =Edu2.CREF1
and Education.CREF2        =Edu2.CREF2
and Education.WCODE        =Edu2.WCODE
and Education.SERIES       =Edu2.SERIES
and Education.DAT_1        =Edu2.DAT_1
and Education.DAT_2        =Edu2.DAT_2
and Education.NMB1         =Edu2.NMB1
and Education.NMB2         =Edu2.NMB2
and Education.STR1         =Edu2.STR1
and Education.STR2         =Edu2.STR2
and Education.CDIRECT      =Edu2.CDIRECT
)
;

// заполняем длинное наименование в учебных заведениях
SQL update Catalogs   set Catalogs.LongName=Catalogs.Name
From Catalogs Catal
inner join Catalogs on Catalogs.Lpr=0 and Catalogs.MainLink= Catal.Nrec
where Catal.syscode=-24;

// перевешиваем в другую папку в учебных заведениях
SQL
//select SubString(catalogs.name,1,100),SubString(CatParent.Name,1,100)
update catalogs set catalogs.cParent = CatParent.Nrec
From Catalogs Catal
inner join Catalogs on Catalogs.Lpr=0 and Catalogs.MainLink= Catal.Nrec
inner join Catalogs CatParent  on Catalogs.Lpr=0 and CatParent.MainLink= Catal.Nrec
  and CatParent.Name=  case
 when (Catalogs.Name like  '%техникум%')
  or  (Catalogs.Name like  '%ГПТУ%')
  or  (Catalogs.Name like  '%ГПУ%')
  or  (Catalogs.Name like  'училище%')
 or  (Catalogs.Name like  '%Колледж%')  THEN '_ССУЗы (средние специальные учебные заведения)'
 when (Catalogs.Name like  '%Академия%')
             or (Catalogs.Name like  '%институт%')
             or (Catalogs.Name like  '% ин-т%')
             or    (Catalogs.Name like  '%Университет%') then '_ВУЗы (высшие учебные заведения)'
   else 'DDDD' end
where Catal.syscode=-24;
