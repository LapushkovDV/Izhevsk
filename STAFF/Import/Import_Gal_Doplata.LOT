delete all from doplata;

sql
insert into doplata (vidopl, summa, proc, datann, datok, tarif, cex, cexoz, clsch,
tperson, strtabn, cappoint, codtar, kateg, sisopl, rejim)

select distinct klvidopl.vidopl, dp004, dp005, dp006, dp007, dp009, lschet.cex, lschet.cex, lschet.nrec,
lschet.tperson, lschet.strtabn,
lschet.cappoint,lschet.codtar, lschet.kateg, lschet.sisopl, lschet.rejim
from em_doplata
inner join em_person on em_person.p0001 = em_doplata.dp008
inner join lschet on lschet.schp2 = em_person.p0001
inner join klvidopl on klvidopl.vidoplp = em_doplata.dp003
where (lschet.sovm = 2 or lschet.sovm = 3) and klvidopl.vidopl <> 1 and klvidopl.vidopl <> 7 and klvidopl.vidopl <> 6
;

sql
insert into doplata (vidopl, summa, proc, datann, datok, tarif, cex, cexoz, clsch,
                 tperson, strtabn, cappoint, codtar, kateg, sisopl, rejim)

select distinct klvidopl.vidopl, dp004, dp005, dp006, dp007, dp009, lschet.cex, lschet.cex, lschet.nrec,
lschet.tperson, lschet.strtabn,
lschet.cappoint,lschet.codtar, lschet.kateg, lschet.sisopl, lschet.rejim
from em_doplata
inner join em_person on em_person.p0001 = em_doplata.dp008  and em_person.p0007 = 'Основное место работы'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidopl on klvidopl.vidoplp = em_doplata.dp003
where lschet.sovm = 0 and klvidopl.vidopl <> 1 and klvidopl.vidopl <> 7 and klvidopl.vidopl <> 6
;

sql
insert into doplata (vidopl, summa, proc, datann, datok, tarif, cex, cexoz, clsch,
                 tperson, strtabn, cappoint, codtar, kateg, sisopl, rejim)

select distinct klvidopl.vidopl, dp004, dp005, dp006, dp007, dp009, lschet.cex, lschet.cex, lschet.nrec,
lschet.tperson, lschet.strtabn,
lschet.cappoint,lschet.codtar, lschet.kateg, lschet.sisopl, lschet.rejim
from em_doplata
inner join em_person on em_person.p0001 = em_doplata.dp008  and em_person.p0007 = 'Внешнее совместительство'
inner join lschet on lschet.tabdop[10] = em_person.p0030
inner join klvidopl on klvidopl.vidoplp = em_doplata.dp003
where lschet.sovm = 1 and klvidopl.vidopl <> 1 and klvidopl.vidopl <> 7 and klvidopl.vidopl <> 6
;

sql
update doplata set summa = 0
where summa = 1
;

sql
update doplata set doplata.pometka = '-'
from doplata
where doplata.datok <= #date(30,09,2017) and doplata.datok <> 0
;