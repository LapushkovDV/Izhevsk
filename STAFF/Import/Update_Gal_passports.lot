sql
update  passports set passports.GIVENBY=substring(passports.GIVENBY,1,length(passports.GIVENBY)-12)
!select
!substring(GIVENBY,length(GIVENBY)-24,17)
!,substring(GIVENBY,1,length(GIVENBY)-25)
!,GIVENBY, GIVENPODR, instr(GIVENPODR, GIVENBY), substring(GIVENBY,1,instr(GIVENPODR, GIVENBY)-19)

from passports
where substring(passports.GIVENBY,length(passports.GIVENBY)-11,4) ='к.п.'
;
//к.п. 500-171
//код подразделения 500-171
