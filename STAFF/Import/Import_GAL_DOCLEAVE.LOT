//--- целодневные неявки
#IFDEF _FactOtpusk_
/*
SQL
  Insert into FactOtpusk (
     Person
    ,Tabn
    ,StrTabn
    ,Duration
    ,FACTYEARBEG
    ,FACTYEAREND
    ,VACTYPE
    ,cLsch
     )
   select
    Persons.Nrec
   ,Persons.Tabnmb
   ,Persons.StrTabn
   ,EM_DOCLEAVE.DAYS       //  "Дни"
   ,EM_DOCLEAVE.BEGINDATE // "Дата начала"
   ,EM_DOCLEAVE.ENDDATE   //  "Дата окончания"
   ,KlOtpusk.Nrec //VACTYPE
   ,COALESCE(Appointments.cAddNrec2,#comp(0)) // cLsch
 From Persons
 inner join EM_DOCLEAVE on EM_DOCLEAVE.CITEZENID =  Persons.DISPROFNMB
 inner join KlOtpusk  on case
 When EM_DOCLEAVE.DOCNAME='Невыходы на время исполнения государственных или общественных обязанностей согласно законодательству (доноры)' then  61      //целодневная неявка
//Д
 When EM_DOCLEAVE.DOCNAME='Невыходы на время исполнения государственных или общественных обязанностей согласно законодательству (кроме доноров)' then   71
//Г
 When EM_DOCLEAVE.DOCNAME='Отстранение от работы (недопущение к работе) по причинам, предусмотренным законодательством, без начисления заработной платы' then  77
//НБ
 When EM_DOCLEAVE.DOCNAME='Отстранение от работы (недопущение к работе) с оплатой (пособием) в соответствии с законодательством' then 78
//НО
 When EM_DOCLEAVE.DOCNAME='Повышение квалификации с отрывом от работы   Повышение квалификации с отрывом от работы' then        73
//ПК
 When EM_DOCLEAVE.DOCNAME='Продолжительность работы в выходной или нерабочий праздничный день с предоставлением другого дня отдыха.' then 79
//РО
 When EM_DOCLEAVE.DOCNAME='Служебная командировка' then 74
//К
        else 0
        end =  KlOtpusk.KOtpus
 Left outer join FactOtpusk on FactOtpusk.person = Persons.Nrec
         and  FactOtpusk.FACTYEARBEG=EM_DOCLEAVE.BEGINDATE
         and  FactOtpusk.FACTYEAREND=EM_DOCLEAVE.ENDDATE
 Left outer join Appointments on Appointments.Nrec = case when Persons.AppointCur=#comp(0) then Persons.AppointLast else Persons.AppointCur end

 where FactOtpusk.nrec is Null
 ;
*/


/*

//==== отпуск
SQL
Insert into otpusk
 (  Tabn   //              │Табельный номер                  │LongInt
   ,Cex    //              │Цех                              │Comp
   ,KOTPUS //              │Код отпуска                      │Word
   ,DATAN//                │Дата ухода в отпуск              │Date
   ,DATOK//                │Дата окончания                   │Date
   ,KOLDN  //              │Кол. дней отпуска                │Double
   ,KOLDNGR            //  │Месяц ухода в отпуск             │Word
  //,v.nrec (fieldname=SRCREC)//               │Nrec первоисточника в Кадрах     │Comp
  //UCHET       //         │Учитывать при расч. зарпл.       │String
  ,CVACATIONS//           │Ссылка на таблицу отпусков из    │Comp
  ,CFACTOTPUSK//          │Ссылка на Фактический отпуск     │Comp
  ,VacType   //          │Вид отпуска                      │Comp
  ,StrTabn   //          │cтроковый табельный номер        │String
  ,tperson
  ,clsch
  ,choice
  )
select
 f.TABN   //              │Табельный номер                  │LongInt
,f.CEX    //              │Цех                              │Comp
,KlOtpusk.Kotpus  //              │Код отпуска                      │Word
,f.FACTYEARBEG //                │Дата ухода в отпуск              │Date
,f.FACTYEAREND //                │Дата окончания                   │Date
,f.DURATION   //              │Кол. дней отпуска                │Double
,f.KOLDNGR            //  │Месяц ухода в отпуск             │Word
,0 as CVACATIONS//           │Ссылка на таблицу отпусков из    │Comp
,f.nrec//          │Ссылка на Фактический отпуск     │Comp
,f.VACTYPE+0 //          │Вид отпуска                      │Comp
,f.STRTABN   //          │cтроковый табельный номер        │String
,f.person
,f.clsch
,3 as choice
from  factotpusk f
Left Outer join otpusk on f.nrec = otpusk.cfactotpusk
Inner join KlOtpusk on  f.VACTYPE = KlOtpusk.Nrec
           and 4 = KlOtpusk.TypeOtp
where otpusk.nrec is Null
*/
/*
SQL
Update FactOtpusk set FactOtpusk.cLsch=Appointments.cAddNrec2 from FactOtpusk
 inner join Persons      on Persons.Nrec = FactOtpusk.Person
 inner join Appointments on Appointments.Nrec = case when Persons.AppointCur=#comp(0) then Persons.AppointLast else Persons.AppointCur end
               and FactOtpusk.cLsch=0
;
SQL
Update Otpusk set Otpusk.cLsch=Appointments.cAddNrec2 from Otpusk
 inner join Persons      on Persons.Nrec = Otpusk.tPerson
 inner join Appointments on Appointments.Nrec = case when Persons.AppointCur=#comp(0) then Persons.AppointLast else Persons.AppointCur end
               and Otpusk.cLsch=0
;
*/
SQL update otpusk set otpusk.cex=Lschet.cex from otpusk inner join Lschet on Otpusk.cLsch = Lschet.nrec;
#ENDIF