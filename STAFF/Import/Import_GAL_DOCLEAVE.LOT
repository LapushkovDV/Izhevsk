/*
SQL
  Insert into Blisnet (
     tPerson
    ,Tabn
    ,StrTabn
    ,KOLDN
    ,DATAN
    ,DATOK
    ,NONLIST
    ,VIDOPL //   BLISNET.VIDOPL == KLVIDOPL.VIDOPL   and
    ,LISNET // BLISNET.LISNET == KLLISNET.LISNET   and
    ,VIDPOS //BLISNET.VIDPOS == KLVIDPOS.VIDPOS   and
    ,FILIALNO //BLISNET.FILIALNO == KLVIDUD.VIDUD   and
    ,cLsch
     )
  select
    Persons.Nrec
   ,Persons.Tabnmb
   ,Persons.StrTabn
   ,EM_DOCLEAVE.DAYS       //  "Дни"
   ,EM_DOCLEAVE.BEGINDATE // "Дата начала"
   ,EM_DOCLEAVE.ENDDATE   //  "Дата окончания"
   ,subString(EM_DOCLEAVE.DOCNUMB,1,20)//+DATE2STR(' от %dd.%MM.%yyyy',EM_DOCLEAVE.DOCDATE),1,20)            //  "Номер документа"
   ,KlVidPos.VIDOPLOO //VIDOPL
   ,0 //LISNET
   ,KlVidPos.VidPos  //VIDPOS
   ,0 //FILIALNO
   ,COALESCE(Appointments.cAddNrec2,#comp(0)) // cLsch

 From Persons
 inner join EM_DOCLEAVE on EM_DOCLEAVE.CITEZENID =  Persons.DISPROFNMB
 Left outer join Appointments on Appointments.Nrec = case when Persons.AppointCur=#comp(0) then Persons.AppointLast else Persons.AppointCur end
 inner join KlViDPos  on
 case
 When EM_DOCLEAVE.DOCNAME='Временная нетрудоспособность (кроме случаев, предусмотренных кодом "Т") с назначением пособия согласно законодательству' THEN 1
 When EM_DOCLEAVE.DOCNAME='Отпуск  по  беременности  и  родам (отпуск в связи с усыновлением новорожденного ребенка)' THEN 11
        else 0
        end =  KlViDPos.VidPos
//        1 = KlViDPos.VidPos
 Left outer join blisnet on Blisnet.tPerson = Persons.Nrec
         and  blisnet.DataN=EM_DOCLEAVE.BEGINDATE
         and  blisnet.DatOk=EM_DOCLEAVE.ENDDATE

 where blisnet.nrec is Null
 ;
// создаем дополнительны таблицы для больничного
SQL Insert into DISEASE
   (  LASTDATE
     ,PERSON
     ,DISEASEBEG
     ,DISEASEEND
     ,MISSINGDAYS
   )
  select
   EM_DOCLEAVE.DocDate
  ,blisnet.tperson
  ,blisnet.datan //DISEASEBEG
  ,blisnet.datok //DISEASEEND
  ,case when blisnet.koldn <0 then 0 else blisnet.koldn end //MISSINGDAYS
  from blisnet
  inner join Persons on Persons.Nrec = blisnet.tPerson
  inner join EM_DOCLEAVE on EM_DOCLEAVE.CITEZENID =  Persons.DISPROFNMB
          and Blisnet.datan  = EM_DOCLEAVE.BEGINDATE
          and Blisnet.datok  = EM_DOCLEAVE.ENDDATE
  where ( 0 = Blisnet.SRCREC  );
//-----------------------------
SQL update blisnet set blisnet.SRCREC= DISEASE.Nrec
from DISEASE
inner join blisnet on 0 = blisnet.SRCREC
   and Blisnet.tPerson = DISEASE.Person
   and Blisnet.datan   = DISEASE.DISEASEBEG
   and Blisnet.datok   = DISEASE.DISEASEEND
;
//-----------------------------
SQL Insert into ARBL  (CBLISNET) select  blisnet.nrec
from blisnet
Left outer join ARBL on ARBL.CBLISNET= blisnet.nrec
where ARBL.Nrec is Null;
SQL update blisnet  set blisnet.tabn=Persons.Tabnmb    ,blisnet.Strtabn= Persons.StrTabn,blisnet.clsch=Appointments.cAddNrec2
    ,blisnet.cex=COALESCE(Lschet.Cex,blisnet.cex)
From blisnet
inner join Persons on Persons.Nrec = Blisnet.tPerson
Left outer join Lschet on Lschet.Nrec=Appointments.cAddNrec2
inner join Appointments on Appointments.Nrec = case when Persons.AppointCur=#comp(0) then Persons.AppointLast else Persons.AppointCur end
;
SQL Update Blisnet set blisnet.choice=3
From blisnet
inner join DISEASE on  blisnet.SRCREC= DISEASE.Nrec and DISEASE.LASTDATE<#date(1,10,2017)
;
//--- Суммы по месяцам.
SQL
Insert into SUMSCALCPERIOD (cBlisnet,NUMDER)
Select Blisnet.Nrec, 1
From Blisnet
Left outer  join SUMSCALCPERIOD on BLisNet.Nrec    = SumsCalcPeriod.cBlisnet  and  1= SumsCalcPeriod.NUMDER
where SUMSCALCPERIOD.Nrec is Null;
SQL
Insert into SUMSCALCPERIOD (cBlisnet,NUMDER)
Select Blisnet.Nrec, 2
From Blisnet
Left outer  join SUMSCALCPERIOD on BLisNet.Nrec    = SumsCalcPeriod.cBlisnet  and  2= SumsCalcPeriod.NUMDER
where SUMSCALCPERIOD.Nrec is Null;

SQL
Insert into SUMSCALCPERIOD (cBlisnet,NUMDER)
Select Blisnet.Nrec, 3
From Blisnet
Left outer  join SUMSCALCPERIOD on BLisNet.Nrec    = SumsCalcPeriod.cBlisnet  and  3= SumsCalcPeriod.NUMDER
where SUMSCALCPERIOD.Nrec is Null;

SQL
Insert into SUMSCALCPERIOD (cBlisnet,NUMDER)
Select Blisnet.Nrec, 4
From Blisnet
Left outer  join SUMSCALCPERIOD on BLisNet.Nrec    = SumsCalcPeriod.cBlisnet  and  4= SumsCalcPeriod.NUMDER
where SUMSCALCPERIOD.Nrec is Null;
*/



#ENDIF

