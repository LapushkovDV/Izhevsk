sql


insert into Passports  (person,  NMB,  SysCode, DocName , SEQNMB)


select  persons.nrec, Em_SNILS.S0002, 501, catalogs.nrec, 3

FROM


catalogs catalogsmain inner join catalogs ON        catalogsmain.syscode=-3
                      and catalogs.lpr = 0   and catalogsmain.nrec = catalogs.mainlink
                      and catalogs.name='Страховое свидетельство'
       cross join em_SNILS

       inner join persons  On em_SNILS.S0001 = persons.DISPROFNMB
      left join Passports Passports1 On    em_SNILS.S0001 = Passports1.person
                   and Passports1.sysCode = 501



and Passports1.nrec is NULL
;

