// Пока данных  пятого уровня не было
insert into Katpodr  (kod, Name, Isleaf, CPodr, LastDate, dto, FIO_GB, sklad)
select em_catpodr1.D0002, em_catpodr1.D0003, 0, katpodr1.nrec, if(rtrim(em_catpodr1.D0010)='Архивный',Cur_Date, 0), 0
, em_catpodr1.D0001,if(em_catpodr1.D0009='склад',1,0)
FROM em_catpodr em_catpodr1, em_catpodr em_catpodr2, em_catpodr em_catpodr3, em_catpodr em_catpodr4, em_catpodr em_catpodr5,
em_catpodr em_catpodr6, em_catpodr em_catpodr7, katpodr katpodr1, katpodr katpodr2
where ((
      em_catpodr1.D0005  ==  em_catpodr2.D0001
      and em_catpodr2.D0005  ==  em_catpodr3.D0001
      and em_catpodr3.D0005  ==  em_catpodr4.D0001
      and em_catpodr4.D0005  ==  em_catpodr5.D0001
      and em_catpodr5.D0005  ==  em_catpodr6.D0001
      and em_catpodr6.D0005  ==  em_catpodr7.D0001
      and em_catpodr2.D0001 == katpodr1.FIO_GB (NoIndex)
      and em_catpodr1.D0001 == katpodr2.FIO_GB (NoIndex)
))
and isvalidall(tnem_catpodr2)=true
and isvalidall(tnem_catpodr3)=true
and isvalidall(tnem_catpodr4)=true
