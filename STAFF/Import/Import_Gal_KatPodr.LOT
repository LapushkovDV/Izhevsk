and  (length(em_catpodr1.D0002)>0 or length(em_catpodr1.D0003)>0)
;







// Загрузка корневой записи в Catalogs

insert into Catalogs  (Name, cparent, MAINLINK, GROUPCODE, SYSCODE, Code, DOPSTR, DATN)//, DATOK)
select 'ЭнергоМашТест', CatalogsMain.nrec, CatalogsMain.nrec,  2, 0, '000001', 0 //, em_catpodr1.d0001
,Cur_Date //,if(rtrim(em_catpodr1.D0010)='Архивный',Cur_Date)
from catalogs catalogsmain,  catalogs catalogs1
where ((
'-11' == catalogsmain.syscode
and '000001'  == catalogs1.code   (NoIndex)
and 'ЭнергоМашТест' == catalogs1.name (noindex)
))
and isvalidall(tncatalogs1)=false
;




// Загрузка папок подразделений  верхнего уровня из КИС  в  Галактический  Catalogs

insert into Catalogs  (Name, cparent, MAINLINK, GROUPCODE, SYSCODE, Code, DOPSTR, DATN, DATOK)
select em_catpodr1.D0003, Catalogs1.nrec, CatalogsMain.nrec,  2, 0, em_catpodr1.d0002, em_catpodr1.d0001
,em_catpodr1.D0007 , if( rtrim(em_catpodr1.D0010)='Архивный',Cur_Date,0)
FROM em_catpodr em_catpodr1, em_catpodr em_catpodr2, catalogs catalogs1, catalogs catalogs2, catalogs catalogsmain
where ((
      '-11' == catalogsmain.syscode
      and em_catpodr1.D0005  ==  em_catpodr2.D0001
      and '000001'  == catalogs1.code   (NoIndex)
      and 'ЭнергоМашТест' == catalogs1.name (noindex)
      and em_catpodr1.D0001 == catalogs2.DOPSTR (NoIndex)
))
and isvalidall(tnem_catpodr2)=false
and isvalidall(tncatalogs2)=false
and  (length(em_catpodr1.D0002)>0 or length(em_catpodr1.D0003)>0)
;


// Загрузка папок подразделений  второго уровня из КИС  в  Галактический  Catalogs

