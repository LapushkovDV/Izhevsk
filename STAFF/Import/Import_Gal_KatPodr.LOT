// Загрузка папок подразделений  верхнего уровня из КИС  в  Галактический  Katpodr

!insert into Katpodr  (kod, Name, Isleaf, CPodr, LastDate, dto, FIO_GB, sklad)
select em_catpodr1.D0002, em_catpodr1.D0003, 0, katpodr1.nrec, if(rtrim(em_catpodr1.D0010)='Архивный',Cur_Date, 0), 0
, em_catpodr1.D0001,if(em_catpodr1.D0009='склад',1,0)
FROM em_catpodr em_catpodr1, em_catpodr em_catpodr2, katpodr katpodr1, katpodr katpodr2, em_person, em_staffstruct
where ((
      em_catpodr1.D0005  ==  em_catpodr2.D0001
      and 'ЭнергоМаш' == katpodr1.name
      and '000002'    == katpodr1.kod
      and em_catpodr1.D0001 == em_staffstruct.s0007
      and em_catpodr1.D0001 == em_person.p0031
      and em_catpodr1.D0001 == katpodr2.FIO_GB (NoIndex)
))
and isvalidall(tnem_catpodr2)=false
and isvalidall(tnkatpodr2)=false
and isvalidall(tnem_staffstruct)=true
and isvalidall(tnem_person)=true
and  (length(em_catpodr1.D0002)>0 or length(em_catpodr1.D0003)>0)
;


