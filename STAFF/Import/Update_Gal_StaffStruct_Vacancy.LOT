SQL
update appointments set Appointments.Rate=Apphist.coef1,Appointments.EmpRate=Apphist.coef1
From appointments
inner join apphist on  Appointments.Nrec = AppHist.cAppoint
      and Appointments.Rate<>Apphist.coef1
