//  CASE WHEN StaffStruct.DClose=#Date(0,0,0) OR StaffStruct.DClose>#Date(12,10,2017)  THEN #Date(12,10,2017) ELSE StaffStruct.DClose END
#declare WDT
  CASE WHEN StaffStruct.DClose=#Date(0,0,0) OR StaffStruct.DClose>#Date(12,10,2017)  THEN #Date(12,10,2017) ELSE StaffStruct.DClose END
#end


SQL
select
!StaffStruct.WorkStations-S.Sum,StaffStruct.Dclose
!   //,DATETIME2STR('%dd.%MM.%yyyy',#WDT)
!   ,staffstruct.SEQNMB
!
distinct  minfio
    ,staffstruct.SEQNMB
   ,StaffStruct.WorkStations
   ,S.Sum
   ,SubString(Catalogs.code,1,10)
   ,SubString(Catalogs.Name,1,30)
   ,SubString(CatPost.Name,1,30)

!   , maxfio
from StaffStruct
     inner join Appointments on Appointments.StaffStr = StaffStruct.Nrec
            and #WDT>=Appointments.Appointdate
              and (Appointments.DISMISSDATE=#date(0,0,0)
              or Appointments.DisMissDate>=#WDT
              )
     inner join persons ON persons.nrec=appointments.person
Inner join Catalogs CatPost on StaffStruct.Post = CatPost.Nrec
Inner join Catalogs  on StaffStruct.Department = Catalogs.Nrec
Inner join ( Select  Staffstruct.Nrec as Nrec, sum(APPHIST.COEF1) as Sum,count(*) as Count_Vac
      ,min(fio) minfio, max(fio) maxfio
      From StaffStruct
       inner join Appointments on Appointments.StaffStr = StaffStruct.Nrec
            and #WDT>=Appointments.Appointdate
              and (Appointments.DISMISSDATE=#date(0,0,0)
              or Appointments.DisMissDate>=#WDT
              )
       inner join AppHist on  Appointments.Nrec = AppHist.cAppoint
       inner join persons On persons.nrec=appointments.person
       left outer join Vacations On Appointments.Person = Vacations.Person
                              and 2 = Vacations.Status
                              and #WDT >= Vacations.FactYearBeg
                              and #WDT <= Vacations.FactYearEnd
       where Vacations.Nrec is Null
       group by Staffstruct.Nrec
  ) S  on S.Nrec = Staffstruct.Nrec
inner join em_person On em_person.p0001=appointments.cref3
where //StaffStruct.Post = CatPost.Nrec and  StaffStruct.Department = Catalogs.Nrec
!and
StaffStruct.WorkStations-S.Sum <0
and staffstruct.dclose=0
!and em_person.p0007='Внешнее совместительство' and staffstruct.workstations=1
!and StaffStruct.Nrec = #comp(2814749768850492)
!and StaffStruct.Nrec = #comp(2814749768838915)
order by SubString(Catalogs.code,1,10), minfio
!to dbf Z:\Import\Check_Persons_Sovm.xls
;

