!sql select distinct c0011 from  EM_CONSCRIPTION;

!sql  select c0001, count(*)  from EM_CONSCRIPTION group by   C0001 having count(*)>1


// Загрузка в catalogs категорий запаса
sql
insert into catalogs (name, mainlink, cparent)
select distinct c0002, catalogsZapmain.nrec, catalogsZapmain.nrec
from EM_CONSCRIPTION inner join catalogs catalogsZapmain On catalogsZapmain.syscode=-44
left join catalogs catalogsZap On CatalogsZap.mainlink=catalogsZapmain.nrec and CatalogsZap.cParent=catalogsZapmain.nrec
and  catalogsZap.name=EM_CONSCRIPTION.c0002
where catalogsZap.nrec is null and length(EM_CONSCRIPTION.c0002)>0
;



