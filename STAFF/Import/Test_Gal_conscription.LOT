sql update catalogs set catdata =69956 where catalogs.name='ВВУ 01';
sql update catalogs set catdata =14163954 where catalogs.name='ВВУ 02';







//Загрузка Воинского учета в галактическую таблицу  CONSCRIPTION
sql delete  from  CONSCRIPTION;

sql
insert into CONSCRIPTION (person, ConsRel, ACNTKIND, ACNTSTRUC, MILRANK, MILABILITY, VUS, MILCOMISS,
MOBORDERCOM, SPECACC, ACNTCAT)
select
!count(*)

persons.nrec, catalogsOb.nrec, catalogsVSU.nrec, catalogsSost.nrec, catalogsZva.nrec, catalogsGodn.nrec, catalogsVus.nrec, catalogsKom.nrec,
cast(EM_CONSCRIPTION.C0008 as string[20]), catalogsSpec.nrec, catalogsZap.nrec

from EM_CONSCRIPTION  inner join persons On persons.DISPROFNMB=EM_CONSCRIPTION.C0001
inner join catalogs catalogsZapmain On catalogsZapmain.syscode=-44
inner join catalogs catalogsZvamain On catalogsZvamain.syscode=-40
inner join catalogs catalogsSostmain On catalogsSostmain.syscode=-41
inner join catalogs catalogsVusmain On catalogsVusmain.syscode=-78
inner join catalogs catalogsGodnmain On catalogsGodnmain.syscode=-42
inner join catalogs catalogsKommain On catalogsKommain.syscode=-56
inner join catalogs catalogsSpecmain On catalogsSpecmain.syscode=-58
inner join catalogs catalogsVSUmain On catalogsVsumain.syscode=-54
inner join catalogs catalogsObmain On catalogsObmain.syscode=-39

left join catalogs catalogsZap On catalogsZap.mainlink=catalogsZapmain.nrec and catalogsZap.cParent=catalogsZapmain.nrec
and  catalogsZap.name=EM_CONSCRIPTION.c0002

left join catalogs catalogsZVA On catalogsZVA.mainlink=catalogsZVAmain.nrec and catalogsZVA.cParent=catalogsZVAmain.nrec
and  catalogsZVA.name=EM_CONSCRIPTION.c0003

left join catalogs catalogsSost On catalogsSost.mainlink=catalogsSostmain.nrec and catalogsSost.cParent=catalogsSostmain.nrec
and  catalogsSost.name=EM_CONSCRIPTION.c0004

left join catalogs catalogsVus On catalogsVus.mainlink=catalogsVusmain.nrec and catalogsVus.cParent=catalogsVusmain.nrec
and  catalogsVus.name=EM_CONSCRIPTION.c0005

left join catalogs catalogsGodn On catalogsGodn.mainlink=catalogsGodnmain.nrec and catalogsGodn.cParent=catalogsGodnmain.nrec
and  catalogsGodn.name=EM_CONSCRIPTION.c0006

left join catalogs catalogsKom On catalogsKom.mainlink=catalogsKommain.nrec and catalogsKom.cParent=catalogsKommain.nrec
and  catalogsKom.name=EM_CONSCRIPTION.c0007 and length(EM_CONSCRIPTION.c0007)>0

left join catalogs catalogsSpec On catalogsSpec.mainlink=catalogsSpecmain.nrec and catalogsSpec.cParent=catalogsSpecmain.nrec
and  catalogsSpec.name=EM_CONSCRIPTION.c0009

left join catalogs catalogsVsu On catalogsVsu.mainlink=catalogsVsumain.nrec and catalogsVsu.cParent=catalogsVsumain.nrec
and  catalogsVsu.CatData=EM_CONSCRIPTION.c0010

left join catalogs catalogsOb On catalogsOb.mainlink=catalogsObmain.nrec and catalogsOb.cParent=catalogsObmain.nrec
and  catalogsOb.name=EM_CONSCRIPTION.c0012   and   length(EM_CONSCRIPTION.c0012)>1  and length(catalogsOb.name)>1
!where persons.fio='Лошманов Вячеслав Иванович'
;




