create table D_USER.EM_INN "Таблица EM_INN"
  using "EM_INN.dat"
!  component USER
  with table_Code = 31715
  with tableOptions header, journal, corpo
  (
   I0001 : LongInt "ID физического лица",
   I0002 : String [20] "ИНН",
   I0003 : LongInt "Код Документа"


  )
  with index
  (
   i_I0001=I0001,
   i_I0002=I0002,
   i_I0003=I0003

   );