//----- Не запускать SQL delete from GP_SCUD_PERS;
// сначала зайти в УП - СКУД - справочники - картотека сотрудников

SQL Update GP_SCUD_PERS set GP_SCUD_PERS.EXT_KEY=CAST(EM_TC_STAFF.STUFFID as string)
From GP_SCUD_PERS
inner join Persons on Persons.Nrec = GP_SCUD_PERS.cPersons
inner join EM_TC_STAFF on EM_TC_STAFF.CITEZENID = persons.disprofnmb
where GP_SCUD_PERS.wType=0
;
