create table D_USER.EM_APPENDIX "Таблица EM_APPENDIX"
  using "EM_APPEN.dat"
  component USER
  with table_Code = 31703
  with tableOptions header, journal, corpo
  (
   A0001 : LongInt "ID физического лица",
   A0002 : LongInt "Код блока таблиц",
   A0003 : LongInt "Код таблицы",
   A0004 : String [80] "Наименование документа",
   A0005 : LVar "Содержимое документа"




  )
  with index
  (
   i_A0001=A0001,
   i_A0002=A0002,
   i_A0003=A0003,
   i_A0004=A0004
  );