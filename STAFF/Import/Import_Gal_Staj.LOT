!sql delete from servlen;

sql
insert into servlen (person, position, currec, rate, fromdate, todate)
select
persons.nrec, catalogsstaj.nrec, 1, 1,
!em_person.p0039,
persons.appdate, persons.disdate
from persons
inner join catalogs catalogsStaj ON
      catalogsStaj.name='Стаж работы на предприятии'
      or
      catalogsStaj.name='Общий стаж'
      or catalogsStaj.name='Непрерывный стаж для листа нетрудоспособности'
inner join catalogs catalogsStajmain On catalogsStajmain.syscode=-19 and catalogsStajmain.nrec = catalogsStaj.mainlink
inner join em_person On em_person.p0001 = persons.filialno
left join  servlen servlen1 On servlen1.position=catalogsstaj.nrec and  servlen1.person=persons.nrec
where servlen1.nrec is null
;

//-------------------------
// Обновим Стаж работы на предприятии
//-------------------------

sql
update servlen set SERVLEN.FROMDATE=Persons.AppDate
From Servlen
inner join catalogs catalogsStaj ON  (  catalogsStaj.name='Стаж работы на предприятии'
                   or catalogsStaj.name='Общий стаж'
                   or catalogsStaj.name='Непрерывный стаж для листа нетрудоспособности'
                   )
 and servlen.position=catalogsstaj.nrec
inner join persons On persons.nrec = servlen.person
;

sql
update servlen set SERVLEN.FROMDATE=em_staj.DBEG_WORK
From Servlen
inner join catalogs catalogsStaj ON  (  catalogsStaj.name='Общий стаж'
                   or catalogsStaj.name='Непрерывный стаж для листа нетрудоспособности'
)
and servlen.position=catalogsstaj.nrec
inner join persons On persons.nrec = servlen.person
inner join em_staj on em_staj.CITEZENID=Persons.DISPROFNMB and em_staj.DBEG_WORK<>#date(0,0,0)
;
