sql
insert into klndr (rejim, yeark, monthk, daychas[1], daychas[2], daychas[3], daychas[4], daychas[5], daychas[6], daychas[7],
daychas[8], daychas[9], daychas[10], daychas[11], daychas[12], daychas[13], daychas[14], daychas[15], daychas[16], daychas[17],
daychas[18], daychas[19], daychas[20], daychas[21], daychas[22], daychas[23], daychas[24], daychas[25], daychas[26], daychas[27],
daychas[28], daychas[29], daychas[30], daychas[31])
select klrejim.rejim, em_klndr_2.k004, em_klndr_2.k001, em_klndr_2._1, em_klndr_2._2, em_klndr_2._3, em_klndr_2._4, em_klndr_2._5,
em_klndr_2._6, em_klndr_2._7, em_klndr_2._8, em_klndr_2._9, em_klndr_2._10, em_klndr_2._11, em_klndr_2._12, em_klndr_2._13,
em_klndr_2._14, em_klndr_2._15, em_klndr_2._16, em_klndr_2._17, em_klndr_2._18, em_klndr_2._19, em_klndr_2._20, em_klndr_2._21,
em_klndr_2._22, em_klndr_2._23, em_klndr_2._24, em_klndr_2._25, em_klndr_2._26, em_klndr_2._27, em_klndr_2._28, em_klndr_2._29,
em_klndr_2._30, em_klndr_2._31
from em_klndr_2
inner join klrejim on em_klndr_2.k006 = klrejim.rejim
left join klndr on klndr.rejim = klrejim.rejim
where klndr.rejim is null  and em_klndr_2.k004 = 2016
;

