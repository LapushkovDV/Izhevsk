create table D_USER.EM_PASSPORT "Таблица EM_PASSPORT"
  using "EM_PASSP.dat"
!  component USER
  with table_Code = 31720
  with tableOptions header, journal, corpo
  (
   P0001 : LongInt "ID физического лица",
   P0002 : String [20] "Серия",
   P0003 : String [20] "Номер",
   P0004 : String [255] "Кем выдан",
   P0005 : Date "Дата Выдачи",
   P0006 : String [100] "Код Подразделения",
   P0007 : Date "Срок Действия",
   P0008 : LongInt "Код Документа"


  )
  with index
  (
   i_P0001=P0001,
   i_P0002=P0002,
   i_P0003=P0003,
   i_P0004=P0004,
   i_P0005=P0005,
   i_P0006=P0006,
   i_P0007=P0007,
   i_P0008=P0008

   );