sql

select persons.fio, catalogs.code, catalogs.name, catalogs1.name, /*staffstruct.workstations, staffstruct.workers,*/ staffstruct.category, staffstruct.taxrate, staffstruct.minsumma, staffstruct.maxsumma
//, raisealg.sum //надбавка за вредность
from staffstruct
inner join catalogs on staffstruct.department = catalogs.nrec
inner join catalogs catalogs1 on staffstruct.post = catalogs1.nrec
inner join appointments on appointments.staffstr = staffstruct.nrec and staffstruct.warch = 0
inner join persons on appointments.person = persons.nrec
//inner join raisests on staffstruct.nrec = raisests.staffstr
//inner join raisealg on raisealg.raisestst = raisests.nrec
order by persons.fio
to dbf D:\gal.xls
;