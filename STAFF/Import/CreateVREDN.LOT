create table D_USER.EM_VREDN "Таблица EM_VREDN"

  using "EM_VRED.dat"
!  component USER
  with table_Code = 31732
  with tableOptions header, journal, corpo
  (
   VR001 : LongInt "ID физ. лица",
   VR002 : integer  "Вид назначения",
   VR003 : string [40] "Класс условий труда",
   VR004 : string [40] "Подкласс условий труда",
   VR005 : longint "ID сотрудника"


  )
  with index
  (
   i_VR001=VR001,
   i_VR002=VR002,
   i_VR003=VR003,
   i_VR004=VR004,
   i_VR005=VR005

  );