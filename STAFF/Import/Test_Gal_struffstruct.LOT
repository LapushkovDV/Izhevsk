sql
select
!distinct
catalogsdep.nrec, catalogsPost.nrec, tarstav.nrec, tarstav.razr
,KlKatego.Nrec, catalogsWorkCond.nrec, S0011
,KLRejim.Nrec, tarstav.tarif, tarstav.TARMIN, tarstav.TARMAX
,s0019
,  case  when FIO=' ..' then  1
         else 0
   end
, case   when S0010>0 then S0010 else S0025 end
,  case  when S0024   like '%Архивный%' then  DATE(S0025)    else 0    end
,extcatlinks.extcat, em_staffstruct.S0001
!count(*)
!catalogsDep.dopstr, catalogsDep.nrec, catalogsDepmain.nrec, em_staffstruct.atl_nrec
from
(
select max(atl_nrec) MaxNrec
from em_staffstruct
!where s0021>0
!where length(s0021)>0
group by s0001, s0024
) S1 inner join em_staffstruct On em_staffstruct.Atl_nrec=S1.MaxNrec // and s0021>0
left join tarstav On Tarstav.SFIELD1=em_staffstruct.s0002  and length(Tarstav.SFIELD1)>0
left join klrejim  On klrejim.rejim=em_staffstruct.s0021
left join KlKatego On KlKatego.Kod=em_staffstruct.s0016
left join catalogs catalogsPostmain On catalogsPostmain.syscode=9004
left join catalogs catalogsPost ON catalogsPost.name=EM_staffstruct.S0014
     and catalogsPostmain.nrec = catalogsPost.mainlink
left join catalogs catalogsDep ON catalogsDep.dopstr=EM_staffstruct.S0007
left join catalogs catalogsDepmain On catalogsDepmain.syscode=-11 and catalogsDepmain.nrec = catalogsDep.mainlink
left join catalogs catalogsWorkCond ON catalogsWorkCond.dopstr=EM_staffstruct.S0018   and    EM_staffstruct.S0018<>0
left join catalogs catalogsWorkCondmain On catalogsWorkCondmain.syscode=-33 and catalogsWorkCondmain.nrec = catalogsWorkCond.mainlink
left join extcatlinks On extcatlinks.STAFFCAT = catalogsdep.nrec and objtype = 11
!left join staffstruct On staffstruct.cInf3=em_staffstruct.S0001
!where staffstruct.nrec is null
!and catalogsDep.name='Военно- мобилизационное бюро'
where catalogsDep.code ='520'
!and s0014='Инженер-рентгенолог'
