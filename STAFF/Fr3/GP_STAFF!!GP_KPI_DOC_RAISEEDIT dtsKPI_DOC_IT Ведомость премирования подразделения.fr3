text := 'Размер премии за результаты работы подразделения и результаты работы работника, руб';&#13;&#10;  memo14.text := 'Процент снижения';&#13;&#10;  memo15.text := 'Сумма снижения премии, руб';&#13;&#10;//  memo16.text := '';&#13;&#10;  memo17.text := 'Итоговый процент премии';&#13;&#10;&#13;&#10; end;&#13;&#10;&#13;&#10; if  &#60;dtsKPI_DOC_IT.&#34;Podr_kod&#34;&#62; = 969 then begin&#13;&#10; memo82.text :='«Генеральный директор АО «НПО Энергомаш»'&#13;&#10; end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo40OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  boTable2:=true;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PageHeader1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;//  if boTable2 then PageHeader1.Visible:=false&#13;&#10;//              else PageHeader1.Visible:=true;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;begin&#13;&#10;  boTable2:=false;&#13;&#10;end." ShowProgress="False" OnStartReport="OnStartReport" PropData="">
