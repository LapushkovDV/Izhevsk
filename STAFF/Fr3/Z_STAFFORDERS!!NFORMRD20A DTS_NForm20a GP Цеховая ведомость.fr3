<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="E:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40520,5049934607" ReportOptions.Description.Text="" ReportOptions.Name="GP Цеховая ведомость" ReportOptions.LastChange="43829,4239885764" ScriptLanguage="PascalScript" ScriptText.Text="var npp:longint;&#13;&#10;//Функция заменяет ковычки------------------------------------------&#13;&#10;Function ReplaceQuotes(sSVstr:string;kov:string;sOtkr:string;sZakr:string;):string;&#13;&#10; var wOtkr:word;&#13;&#10; sStr:string;&#13;&#10; begin&#13;&#10; wOtkr:=1;&#13;&#10; sStr:=sSVstr;&#13;&#10;  while pos(kov,sStr)&#62;0 do&#13;&#10;   begin&#13;&#10;    if wOtkr=1 then&#13;&#10;     begin&#13;&#10;      Insert(sOtkr,sStr,Pos(kov,sStr));&#13;&#10;      wOtkr:=0;&#13;&#10;     end&#13;&#10;     else&#13;&#10;     begin&#13;&#10;      Insert(sZakr,sStr,Pos(kov,sStr));&#13;&#10;      wOtkr:=1;&#13;&#10;     end;&#13;&#10;     Deletestr(sStr,Pos(kov,sStr),1);&#13;&#10;   end; //  while pos(kov,sStr)&#62;0 do&#13;&#10;   Result:=sStr;&#13;&#10;&#13;&#10; end;&#13;&#10;&#13;&#10;&#13;&#10;procedure Memo55OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Inc(npp);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Memo29OnAfterData(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  TmpText : string;&#13;&#10;begin&#13;&#10;    if &#60;DTS_NForm20a.&#34;PrMemo_Exist&#34;&#62;    then&#13;&#10;    begin&#13;&#10;      TmpText:=BlobToString('DTS_NForm20a','PrMemo_Info',true);&#13;&#10;      TmpText:=ReplaceQuotes(TmpText,'&#34;','«','»');&#13;&#10;      Memo29.Text := TmpText;&#13;&#10;      while ( (Memo29.CalcHeight &#62; Memo29.Height) and (Memo29.Font.Size &#62; 6) ) do&#13;&#10;      begin&#13;&#10;        Memo29.Font.Size := (Memo29.Font.Size - 1);&#13;&#10;      end;&#13;&#10;    end else begin&#13;&#10;      Memo29.Text:=&#60;DTS_NForm20a.&#34;Description&#34;&#62;;&#13;&#10;    end;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  npp:=0;&#13;&#10;end." ShowProgress="False" PropData="">
