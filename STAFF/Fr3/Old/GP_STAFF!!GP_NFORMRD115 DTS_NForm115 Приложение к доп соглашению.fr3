<TfrxReport Version="4.15.4" DotMatrixReport="False" EngineOptions.TempDir="F:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="43089,5423668287" ReportOptions.Description.Text="" ReportOptions.Name="Приложение к доп. соглашению" ReportOptions.LastChange="43145,4201541667" ScriptLanguage="PascalScript" ScriptText.Text="             &#13;&#10;var&#13;&#10;       years: TStringList;&#13;&#10;       sums: array[0..100, 1..12] of double;&#13;&#10;       percents: array[0..100, 1..12] of double;&#13;&#10;       totalCompens: double;                                      &#13;&#10;       yearIndex: integer;&#13;&#10;       prevCurY: extended;&#13;&#10;       isHorizontalShift: boolean;&#13;&#10;       signerPost: string;&#13;&#10;       signerFIO: string;                                                         &#13;&#10;&#13;&#10;function GetYearSum(m: integer): double;&#13;&#10;begin&#13;&#10;  Result := sums[yearIndex, m];                                                                                    &#13;&#10;end;          &#13;&#10;&#13;&#10;function GetYearCompens(m: integer): double;&#13;&#10;begin&#13;&#10;  Result := Round(sums[yearIndex, m] * percents[yearIndex, m] / 100, -2);                                                                                    &#13;&#10;end;          &#13;&#10;    &#13;&#10;procedure DetailData1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  i: integer;                                              &#13;&#10;begin&#13;&#10;  if years.IndexOf(&#60;DopInfo.&#34;Year&#34;&#62;) = -1 then years.Add(&#60;DopInfo.&#34;Year&#34;&#62;);&#13;&#10;  i := years.IndexOf(&#60;DopInfo.&#34;Year&#34;&#62;);&#13;&#10;  sums[i,&#60;DopInfo.&#34;Month&#34;&#62;] := &#60;DopInfo.&#34;Sum&#34;&#62;;                                    &#13;&#10;  percents[i,&#60;DopInfo.&#34;Month&#34;&#62;] := &#60;DopInfo.&#34;percent&#34;&#62;;                                    &#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page1OnManualBuild(Sender: TfrxComponent);&#13;&#10;var  &#13;&#10;  DsContDoc: TfrxDataSet;&#13;&#10;  DsDopInfo: TfrxDataSet;&#13;&#10;  DsFeeSigners: TfrxDataSet;                                                         &#13;&#10;  i,j: integer;                           &#13;&#10;begin&#13;&#10;  DsFeeSigners := MasterDataFeeSigners.DataSet;                                                               &#13;&#10;  DsFeeSigners.First;&#13;&#10;  while not DsFeeSigners.Eof do&#13;&#10;  begin&#13;&#10;    if DsFeeSigners.Value('FeeSignerRole') = 'Утверждающее лицо' then&#13;&#10;    begin&#13;&#10;      signerPost := DsFeeSigners.Value('FeeSignerPosition');                 &#13;&#10;      signerFIO  := DsFeeSigners.Value('FeeSignerFioShort')                         &#13;&#10;    end;              &#13;&#10;    DsFeeSigners.Next;                                                   &#13;&#10;  end;        &#13;&#10;    &#13;&#10;  DsContDoc := MasterData1.DataSet;&#13;&#10;  DsContDoc.First;  &#13;&#10;  while not DsContDoc.Eof do  &#13;&#10;  begin    &#13;&#10;    &#13;&#10;    years.Clear;&#13;&#10;    totalCompens := 0;                      &#13;&#10;    for i:=0 to 99 do                     &#13;&#10;    begin&#13;&#10;      for j := 1 to 12 do                                      &#13;&#10;      begin                  &#13;&#10;        sums[i,j] := 0;&#13;&#10;        percents[i,j] := 0;                                                  &#13;&#10;      end;                          &#13;&#10;    end;&#13;&#10;&#13;&#10;    Engine.ShowBand(Header1);&#13;&#10;    Header1.StartNewPage := True;                                                                                               &#13;&#10;        &#13;&#10;    DsDopInfo := DetailData1.DataSet;&#13;&#10;    DsDopInfo.First;&#13;&#10;    while not DsDopInfo.Eof do&#13;&#10;    begin&#13;&#10;      Engine.ShowBand(DetailData1);                                                             &#13;&#10;      DsDopInfo.Next;                                                   &#13;&#10;    end;&#13;&#10;                                  &#13;&#10;    prevCurY := Engine.CurY;&#13;&#10;    isHorizontalShift := false;                                                                &#13;&#10;&#13;&#10;    for yearIndex := 0 to years.count-1 do&#13;&#10;    begin&#13;&#10;      if isHorizontalShift then begin&#13;&#10;        Engine.CurX := 359;                                                                           &#13;&#10;        Engine.CurY := prevCurY &#13;&#10;      end else begin&#13;&#10;        Engine.CurX := 0;                                                               &#13;&#10;        prevCurY := Engine.CurY;&#13;&#10;      end;                          &#13;&#10;      Engine.ShowBand(MasterData2);&#13;&#10;      for j := 1 to 12 do totalCompens := totalCompens + GetYearCompens(j);                                                                           &#13;&#10;      isHorizontalShift := not isHorizontalShift;                                                                                                   &#13;&#10;    end;&#13;&#10;&#13;&#10;    Engine.CurX := 0;                                          &#13;&#10;    Engine.ShowBand(Footer1);        &#13;&#10;        &#13;&#10;    DsContDoc.Next; &#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  years := TStringList.Create;                                                            &#13;&#10;end." ShowProgress="False" PropData="">
