<TfrxReport Version="4.15.4" DotMatrixReport="False" EngineOptions.TempDir="C:\Users\EDUARD~1.KIR\AppData\Local\Temp\" IniFile="\Software\Fast Report Easy Edit" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="43018,8898010532" ReportOptions.Description.Text="" ReportOptions.Name="Ведомость премирования" ReportOptions.LastChange="43082,4148220833" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;  ColSums   : array of Variant;                                                                     &#13;&#10;  ColCounts : array of Variant;                                                                     &#13;&#10;  ColName   : array of Variant;                                                                     &#13;&#10;    &#13;&#10;  RowSums   : array of Variant;                                                                     &#13;&#10;  RowCounts : array of Variant;&#13;&#10;  RowNull   : array of Variant;                    &#13;&#10;  Delimeter : string;  &#13;&#10;procedure DBCross1OnPrintCell(Memo: TfrxMemoView; RowIndex, ColumnIndex, CellIndex: Integer; RowValues, ColumnValues, Value: Variant);&#13;&#10;var &#13;&#10;  ww_str : string;&#13;&#10;  ww_val : double;&#13;&#10;  dsShap : TFrxDAtaset;&#13;&#10;  need_itog:boolean;                                          &#13;&#10;begin&#13;&#10;    if Length(RowSums) &#60; (RowIndex + 1) then           &#13;&#10;    begin                              &#13;&#10;      SetLength(RowSums  , (RowIndex + 1));                                                                     &#13;&#10;      SetLength(RowCounts, (RowIndex + 1));&#13;&#10;      SetLength(RowNull  , (RowIndex + 1));&#13;&#10;    end;                  &#13;&#10;  &#13;&#10;    if Length(ColSums) &#60; (ColumnIndex + 1) then           &#13;&#10;    begin                              &#13;&#10;      SetLength(ColSums  , (ColumnIndex + 1));                                                                     &#13;&#10;      SetLength(ColCounts, (ColumnIndex + 1));&#13;&#10;    end;                  &#13;&#10;  &#13;&#10;    if Length(ColName) &#60; (ColumnIndex + 1) then&#13;&#10;    begin                &#13;&#10;      SetLength(ColName  , (ColumnIndex + 1));&#13;&#10;    end;                  &#13;&#10;        &#13;&#10;  &#13;&#10;  if DBCross1.IsTotalColumn(ColumnIndex) then&#13;&#10;  begin&#13;&#10;  end&#13;&#10;  else if DBCross1.IsTotalRow(RowIndex) then&#13;&#10;  begin              &#13;&#10;    if ColSums[ColumnIndex] &#62; 0.0000001 then begin                        &#13;&#10;       dsShap:= Report.GetDataSet('tmp_print_shap');&#13;&#10;       need_itog:=false;&#13;&#10;       dsShap.First;&#13;&#10;       while not dsShap.EOF do begin&#13;&#10;         if pos(&#60;tmp_print_shap.&#34;Name_Col&#34;&#62;,Trim(VarToStr(ColumnValues[1]) ))&#62;0 then           &#13;&#10;         begin&#13;&#10;           need_itog:=(&#60;tmp_print_shap.&#34;Option&#34;&#62; and 2)&#62;0;  &#13;&#10;           break;                         &#13;&#10;         end;                   &#13;&#10;         dsShap.Next;                        &#13;&#10;       end;&#13;&#10;       if need_itog then                             &#13;&#10;         Memo.Text := Format('%2.1n', [ColSums[ColumnIndex]]);&#13;&#10;    end;                &#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;      //ww_str:=VarToStr(Value)+',';&#13;&#10;      ww_str:=VarToStr(Value)+Delimeter;&#13;&#10;      if Pos(Delimeter,ww_str)&#62;0 then begin                          &#13;&#10;         try&#13;&#10;          ww_val:=0;                               &#13;&#10;          ww_val:=StrToFloat(Copy(ww_str,1,pos(Delimeter,ww_str)-1));&#13;&#10;         except&#13;&#10;         end;&#13;&#10;         ColSums[ColumnIndex] := ColSums[ColumnIndex] + ww_val;&#13;&#10;         ColCounts[ColumnIndex] := ColCounts[ColumnIndex] + 1;                                      &#13;&#10;                &#13;&#10;     end;              &#13;&#10;  end;                    &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterData2OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SetLength(ColSums  , 0);                                                                     &#13;&#10; &#13;&#10;  SetLength(ColCounts, 0);&#13;&#10;  SetLength(ColName  , 0);                                                                     &#13;&#10;  SetLength(RowSums  , 0);                                                                     &#13;&#10;  SetLength(RowCounts, 0);                                                                     &#13;&#10;  SetLength(RowNull  , 0);                                                                     &#13;&#10;  &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DBCross1Column1OnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DBCross1Column1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DBCross1Column1.Text:=Copy(DBCross1Column1.Text,4,200);                                                      &#13;&#10;end;&#13;&#10;&#13;&#10;procedure DBCross1OnPrintColumnHeader(Memo: TfrxMemoView; HeaderIndexes, HeaderValues, Value: Variant);&#13;&#10;begin&#13;&#10;  if copy(Memo.Text,3,1)=' ' then           &#13;&#10;    Memo.Text:=Copy(Memo.Text,4,200);                      &#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;  Delimeter:='.';&#13;&#10;end.  " ShowProgress="False" PropData="">
