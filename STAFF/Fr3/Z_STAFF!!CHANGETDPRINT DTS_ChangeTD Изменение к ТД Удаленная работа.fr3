<TfrxReport Version="4.15.10" DotMatrixReport="False" EngineOptions.TempDir="A:\out\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" OldStyleProgress="True" PreviewOptions.Buttons="4095" PreviewOptions.Modal="False" PreviewOptions.PagesInCache="20" PreviewOptions.Zoom="1" PrintOptions.Printer="По умолчанию" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="42234,6543816667" ReportOptions.Description.Text="" ReportOptions.Name="Изменение к ТД Удаленная работа" ReportOptions.LastChange="45603,7105723032" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10;   _FIOPodpis : String;&#13;&#10;&#13;&#10;procedure BitBtn1OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if RadioButton1.checked = true then&#13;&#10;     begin&#13;&#10;       memo16.text := 'Начальник управления кадровой политики и развития персонала';&#13;&#10;       memo14.text := 'Рогова М.Я.';&#13;&#10;       _FIOPodpis  := 'в лице Начальника управления кадровой политики и развития персонала Роговой Марины Ярославовны, действующего/ей на основании Доверенности от 04.04.2024 № 155'&#13;&#10;      end;&#13;&#10;&#13;&#10;  if RadioButton2.checked = true then&#13;&#10;     begin&#13;&#10;       memo16.text := 'Заместитель генерального директора по персоналу и социальной политике';&#13;&#10;       memo14.text := 'Назаренко С.Г.';&#13;&#10;       _FIOPodpis  := 'в лице Заместителя генерального директора по персоналу и социальной политике Назаренко Сергея Геннадьевича, действующего/ей на основании Доверенности от 01.03.2024 № 145'&#13;&#10;      end;&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure RadioButton1OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;end." ShowProgress="False" PropData="">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000"/>
  <TfrxReportPage Name="Page2" PaperWidth="210" PaperHeight="297" PaperSize="9" LeftMargin="20" RightMargin="20" TopMargin="20" BottomMargin="15" ColumnWidth="0" ColumnPositions.Text="" HGuides.Text="" VGuides.Text="">
    <TfrxMasterData Name="MasterData1" Height="230,55133" Left="0" Top="41,57483" Width="642,5201" ColumnWidth="0" ColumnGap="0" DataSet="Main_Record" DataSetName="Main_Record" PrintIfDetailEmpty="True" RowCount="0" Stretched="True">
      <TfrxMemoView Name="Memo1" Left="0" Top="0" Width="642,5201" Height="26,45671" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Times New Roman" Font.Style="0" HAlign="haCenter" ParentFont="False" Text="Дополнительное соглашение к Трудовому договору от [&#60;Main_Record.&#34;sContractDate&#34;&#62;]г. № [&#60;Main_Record.&#34;SCONTRACTNMB&#34;&#62;]"/>
      <TfrxMemoView Name="Memo5" Left="0" Top="30,23624" Width="226,7718" Height="22,67718" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Times New Roman" Font.Style="0" ParentFont="False" Text="[MAIN_RECORD.&#34;sADDAGREEMENTDATE&#34;]"/>
      <TfrxMemoView Name="Memo8" Left="370,39394" Top="26,45671" Width="272,12616" Height="22,67718" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Times New Roman" Font.Style="0" HAlign="haRight" ParentFont="False" Text="г. Химки Московской обл."/>
      <TfrxMemoView Name="Memo11" Left="0" Top="64,25201" Width="642,5201" Height="45,35436" ShowHint="False" StretchMode="smActualHeight" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Times New Roman" Font.Style="0" HAlign="haBlock" LineSpacing="6" ParentFont="False" Text="    Акционерное общество &#34;НПО Энергомаш имени академика В.П. Глушко&#34; (АО &#34;НПО Энергомаш&#34;), именуемое в дальнейшем Работодатель, [_FioPodpis], с одной стороны, и [&#60;Main_Record.&#34;SFIO&#34;&#62;], [&#60;AHP_RECORD.&#34;SPOST&#34;&#62;] [&#60;AHP_RECORD.&#34;SDEPARTMENT&#34;&#62;] ([DTS_ChangeTD.&#34;PodrKod&#34;]), именуемый/ая в дальнейшем «Работник», с другой стороны, именуемые в дальнейшем «Стороны», заключили настоящее Дополнительное соглашение к Трудовому договору от [&#60;Main_Record.&#34;sContractDate&#34;&#62;]г. № [&#60;Main_Record.&#34;SCONTRACTNMB&#34;&#62;]  о нижеследующем:"/>
      <TfrxMemoView Name="Memo2" Left="0" Top="109,60637" Width="642,5201" Height="60,47248" ShowHint="False" StretchMode="smActualHeight" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Times New Roman" Font.Style="0" HAlign="haBlock" LineSpacing="6" ParentFont="False" Text="    Стороны договорились:&#13;&#10;     1. Изложить пункт 1.2 Трудового договора в следующей редакции:&#13;&#10;    1.2. Работник выполняет свою трудовую функцию вне места нахождения Работодателя, его филиала, представительства, иного обособленного структурного подразделения (включая расположенные в другой местности), вне стационарного рабочего места, территории или объекта, прямо или косвенно находящихся под контролем Работодателя (на территории РФ). Для выполнения данной трудовой функции и для осуществления взаимодействия между Работодателем и Дистанционным работником по вопросам, связанным с ее выполнением, Стороны используют информационно-телекоммуникационные сети общего пользования, в том числе сети &#34;Интернет&#34;. Работодатель обязуется обеспечить Дистанционному работнику необходимые условия труда, предусмотренные трудовым законодательством. Место дистанционной работы Работник выбирает самостоятельно.&#13;&#10;    2. Изложить пункт 1.7. Трудового договора в следующей редакции:"/>
      <TfrxMemoView Name="Memo3" Left="0" Top="173,85838" Width="170,07885" Height="22,67718" ShowHint="False" StretchMode="smActualHeight" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Times New Roman" Font.Style="0" HAlign="haBlock" LineSpacing="6" ParentFont="False" Text="    1.7  Характер работы "/>
      <TfrxMemoView Name="Memo4" Left="170,07885" Top="170,07885" Width="472,44125" Height="22,67718" ShowHint="False" StretchMode="smActualHeight" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Times New Roman" Font.Style="0" Frame.Typ="8" Frame.BottomLine.Width="2" HAlign="haCenter" LineSpacing="6" ParentFont="False" Text="[AHP_RECORD.&#34;SJOBNATURE&#34;]"/>
      <TfrxMemoView Name="Memo6" Left="0" Top="192,75603" Width="642,5201" Height="18,89765" ShowHint="False" StretchMode="smMaxHeight" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Times New Roman" Font.Style="0" HAlign="haBlock" LineSpacing="6" ParentFont="False" Text="   3. Изложить пункт 3.2.1. Трудового договора в следующей редакции:&#13;&#10; 3.2.1. Добросовестно исполнять трудовую функцию, соответствующую занимаемой должности. Соблюдать сроки выполнения порученной работы, представлять Работодателю отчет о проделанной работе в сроки, согласованные с руководителем структурного подразделения [&#60;AHP_RECORD.&#34;SDEPARTMENT&#34;&#62;] ([DTS_ChangeTD.&#34;PodrKod&#34;]).&#13;&#10; 4. Дополнить раздел 3.2. Трудового договора пунктами 3.2.16 и 3.2.17. следующего содержания:&#13;&#10; 3.2.16. Не допускать при выполнении трудовых обязанностей конфликта своих личных имущественных интересов и интересов Работодателя. Технические средства, информация и иное имущество Работодателя используются Работником исключительно в интересах Работодателя в соответствии с локальными нормативными актами, действующими у Работодателя. &#13;&#10; 3.2.17. Не допускать/не производить при работе на корпоративном автоматизированном рабочем месте (АРМ) обработку (систематизацию, хранение, предоставление, распространение) информации о своей частной жизни, в том числе, составляющей личную или семейную тайну.&#13;&#10; 5. Дополнить раздел 4.1. Трудового договора пунктом 4.1.7 следующего содержания:&#13;&#10; 4.1.7. В целях защиты конфиденциальной информации от несанкционированного доступа и (или) распространения и мониторинга работы на корпоративном АРМ Работника Работодатель оставляет за собой право контролировать выполнение пунктов 3.2.16 и 3.2.17 настоящего трудового договора, в том числе с использованием программно-аппаратных средств мониторинга (DLP-система InfoWatch (Data Leak Prevention, система защиты от утечек конфиденциальной информации).&#13;&#10; 6. Настоящее Дополнительное соглашение действует с [&#60;AHP_RECORD.&#34;SDATEFROM&#34;&#62;] по [&#60;AHP_RECORD.&#34;SDATETO&#34;&#62;] и является неотъемлемой частью Трудового договора от [&#60;Main_Record.&#34;sContractDate&#34;&#62;]г. № [&#60;Main_Record.&#34;SCONTRACTNMB&#34;&#62;].&#13;&#10; 7. Настоящее дополнительное соглашение может быть прекращено до истечения срока его действия в случае принятия соответствующего решения Работодателем.&#13;&#10; 8. Остальные условия трудового договора от [&#60;Main_Record.&#34;sContractDate&#34;&#62;]г. № [&#60;Main_Record.&#34;SCONTRACTNMB&#34;&#62;], в том числе касающиеся заработной платы и трудовых функций Работника, остаются без изменений.&#13;&#10; 9. Настоящее Дополнительное соглашение составлено и подписано в двух экземплярах, имеющих равную юридическую силу, один из которых хранится у Работодателя, другой передается Работнику."/>
    </TfrxMasterData>
    <TfrxChild Name="Child4HelpAppHist" Height="34,01577" Left="0" Top="294,80334" Visible="False" Width="642,5201" Stretched="True">
      <TfrxMemoView Name="Memo28" Left="0" Top="0" Width="642,5201" Height="34,01577" ShowHint="False" StretchMode="smActualHeight" Font.Charset="1" Font.Color="0" Font.Height="-16" Font.Name="Times New Roman" Font.Style="0" ParentFont="False" Text="Изменение назначения:&#13;&#10;ФИО сотрудника - [AHP_RECORD.&#34;SFIO&#34;]; ФИО сотрудника в соответствии с настройкой UP.STAFF.IfoSA - [AHP_RECORD.&#34;SFIOBYTUNE&#34;]; ФИО сотрудника в дательном падеже - [AHP_RECORD.&#34;SFIO_DP&#34;]; ФИО сотрудника в дательном падеже - [AHP_RECORD.&#34;SFIO_VP&#34;];&#13;&#10;Есть доступ к 1 разделу картотеки - [AHP_RECORD.&#34;BPRINTPERSINFO&#34;]; Серия паспорта - [AHP_RECORD.&#34;SPASSPORTSER&#34;]; Номер паспорта - [AHP_RECORD.&#34;SPASSPORTNMB&#34;]; Паспорт выдан когда - [AHP_RECORD.&#34;SPASSPORTGIVENDATE&#34;]; Паспорт выдан кем - [AHP_RECORD.&#34;SPASSPORTGIVENBY&#34;]; Адрес проживания - [AHP_RECORD.&#34;SLIVADRESS&#34;];&#13;&#10;Подразделение сотрудника - [AHP_RECORD.&#34;SDEPARTMENT&#34;]; Должность сотрудника - [AHP_RECORD.&#34;SPOST&#34;]; Табельный номер - [AHP_RECORD.&#34;STABNMB&#34;];&#13;&#10;&#13;&#10;Номер документа записи истории - [&#60;AHP_RECORD.&#34;SDOCNMB&#34;&#62;]; Дата документа записи истории - [&#60;AHP_RECORD.&#34;SDOCDATE&#34;&#62;]; Номер дополнительного соглашения - [&#60;AHP_RECORD.&#34;SADDAGREEMENTNMB&#34;&#62;]; Дата дополнительног соглашения - [&#60;AHP_RECORD.&#34;SADDAGREEMENTDATE&#34;&#62;]; Номер контракта - [&#60;AHP_RECORD.&#34;SCONTRACTNMB&#34;&#62;]; Дата контракта - [&#60;AHP_RECORD.&#34;SCONTRACTDATE&#34;&#62;];  &#13;&#10;&#13;&#10;Код операции - [&#60;AHP_RECORD.&#34;WCODOPER&#34;&#62;]; Системное наименовние операции - [AHP_RECORD.&#34;SDEFAULTOPERNAME&#34;]; Признак записи о создании назначения - [AHP_RECORD.&#34;BISNEWAPPOINT&#34;]; Признак наличия привязанного к назначению лицевого счета - [AHP_RECORD.&#34;BBINDLS&#34;]; Дата начала действия записи истории - [&#60;AHP_RECORD.&#34;SDATEFROM&#34;&#62;]; Дата окончания действия записи истории - [&#60;AHP_RECORD.&#34;SDATETO&#34;&#62;]; &#13;&#10;&#13;&#10;Код системы оплаты - [&#60;AHP_RECORD.&#34;WSISOPL&#34;&#62;]; Система оплаты - [&#60;AHP_RECORD.&#34;SSISOPL&#34;&#62;]; Сумма оклада - [&#60;AHP_RECORD.&#34;DOKLAD&#34;&#62;]; Валюта оклада - [&#60;AHP_RECORD.&#34;SCURRENCY&#34;&#62;]; &#13;&#10;Разряд - [&#60;AHP_RECORD.&#34;SRAZR&#34;&#62;]; Количество ставок  - [&#60;AHP_RECORD.&#34;DRATE&#34;&#62;]; Квалификационная категория - [&#60;AHP_RECORD.&#34;LQUALCATEGORY&#34;&#62;]; &#13;&#10;Режим работы - [&#60;AHP_RECORD.&#34;SWORKREGIME&#34;&#62;]; Дней по режиму - [&#60;AHP_RECORD.&#34;IDAYS&#34;&#62;]; Часов по режиму - [&#60;AHP_RECORD.&#34;IHOURS&#34;&#62;]; Минут по режиму - [&#60;AHP_RECORD.&#34;IMINUTES&#34;&#62;]; Интервал режима (1 - день, 2 - неделя) - [AHP_RECORD.&#34;IINTERVAL&#34;]; Характер работы - [&#60;AHP_RECORD.&#34;SJOBNATURE&#34;&#62;]; Условия труда - [&#60;AHP_RECORD.&#34;SWORKCOND&#34;&#62;];  Особые условия труда на рабочем месте - [&#60;AHP_RECORD.&#34;SOSOBUSL&#34;&#62;];  &#13;&#10;&#13;&#10;Галочка оплаты - [&#60;AHP_RECORD.&#34;BPICKOPLATA&#34;&#62;];  Галочка режима работы - [&#60;AHP_RECORD.&#34;BPICKWORKREGIME&#34;&#62;];  Галочка категории - [&#60;AHP_RECORD.&#34;BPICKQUALCATEGORY&#34;&#62;];  Галочка характера работы - [&#60;AHP_RECORD.&#34;BPICKJOBNATURE&#34;&#62;]; Галочка условий труда - [&#60;AHP_RECORD.&#34;BPICKWORKCOND&#34;&#62;]; Галочка особых условий труда на рабочем месте - [&#60;AHP_RECORD.&#34;BPICKOSOBUSL&#34;&#62;];  Галочка категории - [&#60;AHP_RECORD.&#34;BPICKEMPCATEGORY&#34;&#62;];"/>
    </TfrxChild>
