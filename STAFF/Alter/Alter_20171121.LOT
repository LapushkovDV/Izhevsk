

#include DicTypes.def           // Словарные типы данных.

Create table GP.GP_KatsoprExtSklad  "Ссылки на ЦУ и аналитики"
  With table_Code = 31575
  With replace
  With TableOptions Branched
  (
    NRec     : comp "Номер записи",
    wdoc     : word "Код документа",
    cRec     : ref(Katsopr) "Ссылка на запись таблицы",
    cobj     : comp "Ссылка на объект ЦУ",
    ckau1    : comp "Ссылка на цех-потребитель",
    ckau2    : comp "Ссылка на Шифр заказа"
  )
  With index
  (
    Katsopr_Ext_sklad01 = NRec(Unique, Surrogate, Journal),
    Katsopr_Ext_sklad02 = cRec+wdoc
   );
