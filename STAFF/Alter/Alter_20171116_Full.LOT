#DEFINE STAGE03
//**************************************
#IFDEF STAGE01
select GP_SCUD_Saldo.* from GP_SCUD_Saldo to dbf  c:\1\GP_SCUD_Saldo.DBf;
#ENDIF
// VIP
//**************************************
#IFDEF STAGE02
drop table GP_SCUD_Saldo;
#ENDIF
//**************************************
#IFDEF STAGE03
 #include DicTypes.def           // Словарные типы данных.
  Create table GP.GP_SCUD_Saldo "Сальдо часов"
  With table_Code = 31568
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cGP_SCUD_PERS  : ref(GP_SCUD_PERS)   "Сотрудники СКУД"
   , cPersons       : ref(Persons)        "Картотека персонала"
   , YearN          : word "Год сальдо"
   , MesN           : word "Месяц сальдо"
   , CH_Over_Ost    : TSumma "Сверхурочные, остаток на начало"
   , CH_Over_Cur    : TSumma "Сверхурочные, тек.месяц"
   , CH_Over_Opl    : TSumma "Сверхурочные, оплачено"
   , CH_Over2_Ost   : TSumma "Переработка, остаток на начало"
   , CH_Over2_Cur   : TSumma "Переработка, тек.мес"
   , CH_Over2_Opl   : TSumma "Переработка, оплачено"
   , CH_Holiday_Ost : TSumma "Выходные, остаток на начало"
   , CH_Holiday_Cur : TSumma "Выходные, тек.мес"
   , CH_Holiday_Opl : TSumma "Выходные, оплачено"
   //---------------------------
   , CH_Graf_ALL    : TSumma "рабочих часов,план"
   , CH_Fact_ALL    : TSumma "рабочих часов,факт"
   , CH_Diff_ALL    : TSumma "рабочих часов,план"
    ,sMisConduct    : string[200]// нарушения
   //---------------------------
   , CH_OverWork   : array [1..31] of TSumma "сверхурочные,часы"
   , CH_OverWork2  : array [1..31] of TSumma "переработка,часы"
   , CH_Holiday    : array [1..31] of TSumma "выходные,часы"
   , CH_MisConDuct : array [1..31] of TSumma "нарушения,часы"
   , CH_GrafCh     : array [1..31] of TSumma "рабочих часов,план"
   , CH_FactCh     : array [1..31] of TSumma "рабочих часов,факт"
   //-----------------------
   , TMB : array [1..31] of time "Время начала рабочего дня"
   , TME : array [1..31] of time "Время окончания рабочего дня"
   //-----------------------
   , Rejim_Day  : array [1..31] of word "Режим по дням"
   , Days       : array [1..31] of string[50] "обозначения дня"
  )
  With index
  (
     GP_SCUD_Saldo01 = NRec(Unique, Surrogate, Journal)
    ,GP_SCUD_Saldo02 = cGP_SCUD_PERS+YearN+MesN(Unique)
    ,GP_SCUD_Saldo03 = cPersons+YearN+MesN
    ,GP_SCUD_Saldo04 = YearN+MesN
  );
  import GP_SCUD_Saldo from dbf c:\1\GP_SCUD_Saldo.Dbf nfs;

  Create table GP.GP_SCUD_MisCon_D "СКУД,Нарушения по дням"
  With table_Code = 31571
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cMisConDuct    : ref(GP_SCUD_MisConDuct) "ссылка на справочник нарушений"
   , wMisConDuct    : word "тип нарушений"
   , cGP_SCUD_PERS  : ref(GP_SCUD_PERS) ""
   , MesN           : word
   , YearN          : word
   , DT_Ev          : date
   , TM_Ev          : time
   , tDiff          : time // длительность нарушения
  )
  With index
  (
    GP_SCUD_MisCon_D01 = NRec(Unique, Surrogate, Journal)
   ,GP_SCUD_MisCon_D02 = cGP_SCUD_PERS + DT_Ev + TM_Ev
   ,GP_SCUD_MisCon_D03 = cGP_SCUD_PERS + YearN+ MesN +DT_Ev + TM_Ev
  );

#ENDIF
