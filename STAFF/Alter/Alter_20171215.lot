
Create table GP.GP_UserReportAccess "Права доступа к отчетам пользователя"
  With table_Code = 31514
  With replace
  With TableOptions Branched
  (
    NRec       : comp "Номер записи",
    RepVipName : string "Имя отчета",
    cUser      : ref(X$USERS) "Пользователь",
    cGroup     : ref(Groups) "Группа пользователей",
    IsAllow    : boolean "Доступ разрешен"
  )
  With index
  (
    UserReportAccess01 = NRec(Unique, Surrogate, Journal),
    UserReportAccess02 = RepVipName + cUser + cGroup
  );
