//компилятор интерфейсов
#include DicTypes.def           // Словарные типы данных.
Create table GP.GP_RPD120 "РПД 120 Погашение подотчетных сумм"
With table_Code = 31656
With replace
With TableOptions Branched
(
  Nrec       : Comp           "Номер записи"
 ,cContDoc   : ref(ContDoc)   "Ссылка на содержание приказа"
 ,cPlPor     : ref(PlPor)     "Ссылка на авансовый отчет"
 ,VidUd      : word           "Вид удержания системный"
 ,dUd        : date           "Дата удержания"
 ,Summa      : decimal(31,15) "Сумма"
)
With index
(
  GP_RPD12001 = NRec (Unique, Surrogate, Journal)
 ,GP_RPD12002 = cContDoc
 ,GP_RPD12003 = cPlPor
);
