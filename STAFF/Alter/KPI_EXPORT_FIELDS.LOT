SQL select Distinct //X$FILES.XF$Name
  'import '+X$FILES.XF$Name
 + ' from dbf c:\1\dbf\'+X$FILES.XF$Name+'.dbf nfs;' //+X$Fields.XE$Name
From X$FILES
/*
inner join X$Fields on X$Fields.XE$FILECODE = X$FILES.XF$CODE
and (X$Fields.XE$Name='PERSON' OR X$Fields.XE$Name='CPERSON' OR X$Fields.XE$Name='TPERSON'
 OR X$Fields.XE$Name='CPERSONS'
 OR X$Fields.XE$Name='CEXECUTOR' OR X$Fields.XE$Name='CCREATOR'
 )
*/
WHERE SubString(X$FILES.XF$Name,1,3)='GP_'
to txt c:\1\GP_Import.Txt
 ;
