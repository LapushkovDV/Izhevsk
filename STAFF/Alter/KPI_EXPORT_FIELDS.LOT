select Gp_KPI_FOND.* to dbf c:\1\dbf\Gp_KPI_FOND.dbf;
select GP_KPI_NORMPERCENT.*  to dbf c:\1\dbf\GP_KPI_NORMPERCENT.dbf;
select GP_KPI_ALG.*  to dbf c:\1\dbf\GP_KPI_ALG.dbf;
select GP_KPI_ALG_SPEC.*  to dbf c:\1\dbf\GP_KPI_ALG_SPEC.dbf;
//------------------------
select GP_STATUS.* to dbf c:\1\dbf\GP_STATUS.dbf;
select GP_USERROLES.*  to dbf c:\1\dbf\GP_USERROLES.dbf;
select GP_STATUSROLES.*  to dbf c:\1\dbf\GP_STATUSROLES.dbf;
