

#include DicTypes.def           // Словарные типы данных.

Create table GP.GP_KlRejimYear "Расширение режимов работ по годам"
  With table_Code = 31893
  With replace
  With TableOptions Branched
  (
     NRec       : comp "Номер записи"
    ,cKlRejim   : ref(KlRejim) "Режим работы"
    ,Year       : word "Год"
    ,CheckDate  : date "Дата приема графика"
  )
  With index
  (
    KlRejimYear01 = NRec(Unique, Surrogate, Journal),
    KlRejimYear02 = cKlRejim + Year
  );
