#DEFINE STAGE03
//**************************************
#IFDEF STAGE01
select * from GP_SCUD_Doc_SP to dbf  c:\1\GP_SCUD_Doc_SP.DBf;
#ENDIF
// VIP
//**************************************
#IFDEF STAGE02
drop table GP_SCUD_Doc_SP;
#ENDIF
//**************************************
#IFDEF STAGE03
 #include DicTypes.def           // Словарные типы данных.
  Create table GP.GP_SCUD_Doc_SP "Документы СКУД - Спецификация"
  With table_Code = 31559
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cGP_SCUD_Doc   : Ref(GP_SCUD_Doc )   "Документы СКУД"
   , cGP_SCUD_Pers  : Ref(GP_SCUD_Pers)  "Люди  СКУД"
   , cUser          : ref(x$users) "Зарегистрировал"
   , cReason        : ref(GP_SCUD_Reason) "Причины"
   , Description    : String      "Описание"
   , EventDate      : date "Дата события"
   , EventTmB       : time "Время события с"
   , EventTmE       : time "Время события по"
   , EventDateF     : date "Факт Дата события"
   , EventTmBF      : time "Факт Время события с"
   , EventTmEF      : time "Факт Время события по"
   , cGP_SCUD_Doc_SP: comp   "Спец."
  )
  With index
  (
    GP_SCUD_DOCSP01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_DOCSP02 = cGP_SCUD_Pers+EventDate,
    GP_SCUD_DOCSP03 = cGP_SCUD_Doc+cGP_SCUD_Doc_Sp+EventDate,
    GP_SCUD_DocSP04 = EventDate+EventTmB
  );


  import GP_SCUD_Doc_SP from dbf c:\1\GP_SCUD_Doc_SP.Dbf nfs;
#ENDIF
