//drop table GP_SCUD_Controler;
#include DicTypes.def           // Словарные типы данных.

  Create table GP.GP_SCUD_MisConDuct "Типы нарушений дисциплины"
  With table_Code = 31561
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , Code           : string[20] "Код"
   , Name           : string[100] "Наименование"
   , Ext_Key        : string[30]  "Внешний ключ"
   , wType          : word "Тип"
   , Description    : String      "Описание"
   , CONTENTS       : LVar
  )
  With index
  (
    GP_SCUD_MisConDuct01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_MisConDuct02 = Code,
    GP_SCUD_MisConDuct03 = Name,
    GP_SCUD_MisConDuct04 = wType
  );

  Create table GP.GP_SCUD_Controler "Устройства рег.входа выхода"
  With table_Code = 31562
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , Code           : string[20] "Код"
   , Name           : string[100] "Наименование"
   , Ext_Key        : string[30]  "Внешний ключ"
   , wType          : word "Тип"
   , Description    : String      "Описание"
   , Address        : string      "Место установки"
   , IP_Address     : string      "Адрес в сети"
   , CONTENTS       : LVar
  )
  With index
  (
    GP_SCUD_Controler01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Controler02 = Code,
    GP_SCUD_Controler03 = Name,
    GP_SCUD_Controler04 = wType
  );
