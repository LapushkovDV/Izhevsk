//компилятор интерфейсов
#include DicTypes.def           // Словарные типы данных.
//---------------------------------------------------------
//--- 20181005 Универсальный отчет  -----------------------

Create table GP.GP_Rep_Variant "Отчет,Вариант отчета"
  With table_Code = 31657
  With replace
  With TableOptions Branched
(
  Nrec       : Comp           "Номер записи"
 ,Descr      :   string[21]   "Дескриптор"
 ,Desgr      :   string[21]   "Группа дескрипторов"
 ,Name       :   string[100]  "Наименование отчета"
 ,Year_var   :   word         "Год варианта отчета"
 ,DBEG       :   Date         "Начало периода"
 ,DEnd       :   Date         "Окончание периода"
 ,Module     :   string       "Запуск из след.модулей"
)
With index
(
  GP_Rep_Variant01 = NRec (Unique, Surrogate, Journal)
 ,GP_Rep_Variant02 = descr+name
 ,GP_Rep_Variant03 = desgr+name
 ,GP_Rep_Variant04 = name

);


Create Table GP.GP_Rep_List "Отчет,Настройки страниц варианта"
  With Table_CODE = 31658
  With replace
  With TableOptions Branched
(   Nrec           : Comp                 "Номер записи"
  , cGP_Rep_Variant: REF(GP_Rep_Variant)  "ссылка на вариант"
  , Template       : string[255]          "наименование щаблона"
  , List           : string[55]           "Наименование листа шаблона"
  , List_Full      : string[255]          "Полное наименование  листа шаблона"
  , cNode          : comp                 "родитель- 0 шаблон, иначе лист"
)
with index
( GP_Rep_List00 = NRec (Unique, Surrogate, Journal)
 ,GP_Rep_List01 = cGP_Rep_Variant+cNode+List
);

Create Table GP.GP_Rep_Row "Отчет, Настройки строк варианта"
  With Table_CODE = 31659
  With replace
  With TableOptions Branched
(   Nrec           :  Comp           "Номер записи"
  , cGP_Rep_VARIANT:  Ref(GP_Rep_VARIANT)       "ссылка на вариант"
  , cGP_Rep_List   :  Ref(GP_Rep_List)          "ссылка на лист"
  , cNode          :  comp                      "ссылка на родителя"
  , sortkey        :  string[200]               "ключ для сортировки"
  , npp            :  string[20]                "порядковый номер"
  , name           :  string[200]               "наименование строки"
  , row            :  longint                   "номер строки в шаблоне"
  , ColEx_CODE     :  longint                   "выделять код в столбец"
  , type_razv      :  word                      "тип разворачивания,0 - нет"
  , tp_option      :  word                      "опции, 1 формировать детальные данные"
)
with index
(   GP_Rep_Row01 = NRec (Unique, Surrogate, Journal)
  , GP_Rep_Row02 = cGP_Rep_VARIANT+cGP_Rep_List+cNode+row+name
  , GP_Rep_Row03 = cGP_Rep_VARIANT+cGP_Rep_List+cNode+sortkey
);

Create Table GP.GP_REP_ALG "Отчет, Алгоритмы"
  With Table_CODE = 31660
  With replace
  With TableOptions Branched
(   Nrec           : Comp                "Номер записи"
  , TP             : Word      "Тип 0 DSQL,1 Б.Сальдо,2-Об/ы,3-Проводки"
  , Name           : String    "Наименование"
  , Description    : String    "Описание"
  , cPlansSch      : Ref(PlansSCh) "Ссылка на план счетов"
  //--------------------
  // Для фильтров по дебету
  ,SCHETO     :tSchet3 "Дебет: Счет"
  ,SUBOSSCH   :tSubSch "Дебет: СубСчет"
  ,KODSPO     :comp    "Дебет: Подразделение"
  ,Tblos      :tTabKau "Дебет: Тип аналитики"
  ,kauos      :tGetKau "Дебет: Значение аналитики"
  //--------------------
  // Для фильтров по кредиту
  ,SCHETK     :tSchet3 "Кредит: Счет"
  ,SUBSCHK    :tSubSch "Кредит: СубСчет"
  ,KODSPK     :comp    "Кредит: Подразделение"
  ,Tblks      :tTabKau "Кредит: Тип аналитики"
  ,kauks      :tGetKau "Кредит: Значение аналитики"
  //----------------------
  , wFLD_BUH  :word    "Маска полей для вывода информации"
  //------------------------- Группировки
  , GR_KOD    :string  "коды группировок"
  , GR_NAME   :string  "наименование группировок"
  , GR_FIELD  :string  "Номера столбцов запроса"
  //-------------------------
  , Period_TP      : word          "0-период отчета,1 след.,2 год,3 формула"
  , Period_FB      : string         "Формула для даты начала периода"
  , Period_FE      : string         "Формула для даты окончания периода"
  //-------------------------
  , DOP_FLD_F         : Array [1..10] of string "Дополнительные поля для запроса"
  , DOP_FLD_T         : Array [1..10] of string "условия для подцепки доптаблиц"
  //-----------------------------
  , CAddFld        : tNRec_x10   "Параметры типа comp"
  , WAddFld        : Word_x10    "параметры типа word"

  //-------------------------
  , mDSQL          :  LVar                "Для хранения DSQL запроса."

)
with index
(  GP_REP_ALG00 = NRec (Unique, Surrogate, Journal)
  ,GP_REP_ALG01 = NAME
  ,GP_REP_ALG02 = TP+NAME
);

Create Table GP.GP_REP_ALG_F "Отчет, Алгоритмы - поля"
  With Table_CODE = 31661
  With replace
  With TableOptions Branched
(  Nrec           : Comp                "Номер записи"
  ,cGP_REP_ALG    : Ref(GP_REP_ALG)   "Ссылка на алгоритм"
  ,NPP            : Word              "Порядковый номер"
  ,Name           : String            "Наименование"
  ,Description    : String    "Описание"
  ,fType          : Word              "Тип поля по умолчанию"
  ,wType          : word              "0 по умолч.,1 табл.,2 аналитика"
  ,wTable         : Word              "Код таблицы"
  ,wKau           : Word              "Код Аналитики"
  ,ATTR_NAME      : string            "Наименование ВА"
  ,FLD_NAME       : string            "Формула для поля"
  ,wGR            : word              "Признак группировки"
  ,wAGR           : word              "При группировке выч. кол-во или сумму"
  ,cGP_REP_ALG_F  : Ref(GP_REP_ALG)   "Ссылка на алгоритм расчета"
)
with index
(  GP_REP_ALG_F00 = NRec (Unique, Surrogate, Journal)
  ,GP_REP_ALG_F01 = cGP_REP_ALG+NPP

);

Create Table GP.GP_REP_ROW_ALG "Отчет, Связь строк с алгоритмами"
  With Table_CODE = 31663
  With replace
  With TableOptions Branched
(    Nrec           :  Comp                "Номер записи"
   , cGP_REP_VARIANT:  Ref(GP_REP_VARIANT) "ссылка на вариант"
   , cGP_REP_List   :  Ref(GP_REP_List)    "ссылка на лист"
   , cGP_REP_Row    :  Ref(GP_REP_Row )    "ссылка на строку 0 заголовок"
   , cGP_REP_ALG    :  Ref(GP_REP_ALG)     "Ссылка на алгоритм"
   , NPP            :  Word                "Порядковый номер"
)
with index
(   GP_REP_ROW_ALG00 = NRec (Unique, Surrogate, Journal)
  , GP_REP_ROW_ALG01 = cGP_REP_VARIANT+cGP_REP_List+cGP_REP_Row+NPP
  , GP_REP_ROW_ALG02 = cGP_REP_ALG+cGP_REP_VARIANT+cGP_REP_List+cGP_REP_Row
);

Create Table GP.GP_REP_Col "Отчет, Настройки столбцов"
  With Table_CODE = 31664
  With replace
  With TableOptions Branched
(   Nrec           :  Comp                "Номер записи"
  , cGP_REP_VARIANT:  Ref(GP_REP_VARIANT) "ссылка на вариант"
  , cGP_REP_List   :  Ref(GP_REP_List)    "ссылка на лист"
  , cGP_REP_Row    :  Ref(GP_REP_Row )    "ссылка на строку 0 заголовок"
  , cNode          :  comp                "ссылка на родителя"
  , sortkey        :  string[200]         "ключ для сортировки"
  , npp            :  string[20]          "порядковый номер"
  , name           :  string[200]         "наименование строки"
  , row            :  longint             "номер строки шапки/данных в шаблоне"
  , col            :  longint             "номер столбца в шаблоне 200 максимально"
  , ColEx          :  longint             "номер фактическиЙ"
  , TP_RASH        :  Word                "0-vip алг.,1 ПАТ формула, 2 DSQL"
  , FORMULA        :  String              "ПАТ формула либо название vip интерфейса"
  , cGP_REP_ALG    :  Ref(GP_REP_ALG)     "ссылка на cGP_REP_ALG"
  , mDSQL          :  LVar                "Для хранения DSQL запроса."
)
with index
(   GP_REP_Col00 = NRec (Unique, Surrogate, Journal)
  , GP_REP_Col01 = cGP_REP_VARIANT+cGP_REP_List+cGP_REP_Row+cNode+row+col+name
  , GP_REP_Col02 = cGP_REP_VARIANT+cGP_REP_List+cGP_REP_Row+row+col
);


Create Table GP.GP_REP_Col_ALG "Отчет, Связь столбцов с полями алгоритма"
  With Table_CODE = 31665
  With replace
  With TableOptions Branched
(   Nrec           :  Comp                "Номер записи"
  , cGP_REP_VARIANT:  Ref(GP_REP_VARIANT) "ссылка на вариант"
  , cGP_REP_List   :  Ref(GP_REP_List )    "ссылка на лист"
  , cGP_REP_Row    :  Ref(GP_REP_Row  )    "ссылка на строку 0 заголовок"
  , cNode          :  comp                "ссылка на родителя"
  , cGP_REP_COL    :  Ref(GP_REP_Col  )    "ссылка на колонку"
  , cGP_REP_ALG    :  Ref(GP_REP_ALG  )     "ссылка на алгоритм"
  , cGP_REP_ALG_F  :  Ref(GP_REP_ALG_F)   "ссылка на поле алгоритма"
  , NPP            :  word                "порядковый номер"
)
with index
(   GP_REP_Col_ALG00 = NRec (Unique, Surrogate, Journal)
  , GP_REP_Col_ALG01 = cGP_REP_VARIANT+cGP_REP_List+cGP_REP_Row+cNode+cGP_REP_COL+cGP_REP_ALG
  , GP_REP_Col_ALG02 = cGP_REP_ALG
  , GP_REP_Col_ALG03 = cGP_REP_ALG_F
);

Create Table GP.GP_REP_SOOTV "Отчет, Таблица соотв. для импорта"
  With Table_CODE = 31666
  With replace
  With TableOptions Branched
(   Nrec           :  Comp                "Номер записи"
  , wList     :  word                     "Тип"
  , OUT_NREC  :  comp                     "Входящий nrec"
  , OUT_CODE  :  string[50]               "Входящий код"
  , OUT_NAME  :  string[150]              "Входящее наименование"
  , IN_NREC   :  comp                     "Запись в базе nrec"
  , IN_CODE   :  string[50]               "Запись в базе код"
  , IN_NAME   :  string[150]              "Запись в базе наименование"
)
with index
( GP_REP_SOOTV00 = NRec (Unique, Surrogate, Journal)
, GP_REP_SOOTV01 = wList+OUT_NREC+OUT_CODE+OUT_NAME
, GP_REP_SOOTV02 = wList+OUT_CODE+OUT_NAME
, GP_REP_SOOTV03 = wList+IN_CODE+IN_NAME
, GP_REP_SOOTV04 = wList+OUT_NAME+OUT_CODE
, GP_REP_SOOTV05 = wList+IN_NAME+IN_CODE
, GP_REP_SOOTV06 = wList+IN_NREC+IN_CODE+IN_NAME
);


Create Table GP.GP_REP_Calc "Отчет, вариант сохранения"
  With Table_CODE = 31671
  With replace
  With TableOptions Branched
(  Nrec            : Comp         "Номер записи"
  ,cGP_REP_VARIANT : Ref(GP_REP_VARIANT)         "ссылка на вариант"
  ,DTB             : date         "Дата начала периода"
  ,DTE             : date         "Дата окончания периода"
  ,OWNER           : string[50]   "Создатель"
  ,cUser           : Ref(X$Users) "ссылка на пользователя"
  ,descr           : string[21]   "Дескриптор"
  ,desgr           : string[21]   "Группа дескрипторов"
  ,DT_CREATE       : date         "Дата создания"
  ,TM_CREATE       : time         "Время создания"
  ,name            : string[200]  "Наименование"
  ,cGP_REP_ALG     : REF(GP_REP_ALG)  "ссылка на GP_REP_ALG"
)
with index
( GP_Rep_Calc01 = NRec (Unique, Surrogate, Journal)
 ,GP_REP_Calc02 = cGP_REP_VARIANT+DT_CREATE+TM_CREATE+name
);

Create Table GP.GP_REP_Calc_SP "Отчет, Расчетные данные"
  With Table_CODE = 31672
  With replace
  With TableOptions Branched
(   Nrec            : Comp                "Номер записи"
  , cGP_REP_VARIANT : Ref(GP_REP_VARIANT) "ссылка на вариант"
  , cGP_REP_List    : Ref(GP_REP_List   ) "ссылка на лист"
  , cGP_REP_Row     : Ref(GP_REP_Row    ) "ссылка на строку"
  , cGP_REP_Calc    : Ref(GP_REP_Calc   ) "ссылка на расчет"
  , VDouble        :  double              "кол-во"
  , VString        :  string[100]         "строка"
  , pa             :  word                "0 - итоги, 1 развертка"
  , Name           :  string[200]         "Наименование - пусто=Итого"
)
with index
( GP_Rep_Calc_SP00 = NRec (Unique, Surrogate, Journal)
, GP_REP_Calc_SP01 = cGP_REP_VARIANT+cGP_REP_List+cGP_REP_Calc+Pa+cGP_REP_Row+name(Unique)
, GP_REP_Calc_SP02 = cGP_REP_LIST
, GP_REP_Calc_SP03 = cGP_REP_Calc+name
);

Create Table GP.GP_REP_Calc_SPCOL "Отчет, Расчетные данные по столбцам"
  With Table_CODE = 31673
  With replace
  With TableOptions Branched
(   Nrec              : Comp                "Номер записи"
  , cGP_REP_VARIANT   : Ref(GP_REP_VARIANT) "ссылка на вариант"
  , cGP_REP_List      : Ref(GP_REP_List   ) "ссылка на лист"
  , cGP_REP_Row       : Ref(GP_REP_Row    ) "ссылка на строку"
  , cGP_REP_Col       : Ref(GP_REP_Col    ) "ссылка на столбец"
  , cGP_REP_Calc      : Ref(GP_REP_Calc   ) "ссылка на расчет"
  , cGP_REP_Calc_SP   : Ref(GP_REP_Calc_SP) "ссылка на расчет"
  , VDouble           : double              "кол-во"
  , VString           : string[100]         "строка"
)
with index
(   GP_Rep_Calc_SP_COL00 = NRec (Unique, Surrogate, Journal)
  , GP_REP_Calc_SP_COL01 = cGP_REP_VARIANT+cGP_REP_List+cGP_REP_Row+cGP_REP_Calc+cGP_REP_Col
  , GP_REP_Calc_SP_COL02 = cGP_REP_Calc
  , GP_REP_Calc_SP_COL03 = cGP_REP_LIST
  , GP_REP_Calc_SP_COL04 = cGP_REP_Calc_SP+cGP_REP_Col
);


Create Table GP.GP_REP_Calc_DETAIL "Отчет, Расчетные данные, детализация"
  With Table_CODE = 31674
  With replace
  With TableOptions Branched
(   Nrec            : Comp                "Номер записи"
  , cGP_REP_VARIANT : Ref(GP_REP_VARIANT) "ссылка на вариант"
  , cGP_REP_List    : Ref(GP_REP_List   ) "ссылка на лист"
  , cGP_REP_Row     : Ref(GP_REP_Row    ) "ссылка на строку"
  , cGP_REP_Calc    : Ref(GP_REP_Calc   ) "ссылка на расчет"
  , cGP_REP_Calc_SP : Ref(GP_REP_Calc_SP) "ссылка на строку с расчетами"
  , VDouble         : double              "кол-во"
  , Name            : string[200]         "Наименование"
)
with index
( GP_Rep_CalcD00 = NRec (Unique, Surrogate, Journal)
, GP_REP_CalcD01 = cGP_REP_VARIANT+cGP_REP_Row+cGP_REP_Calc_SP+name(Unique)
, GP_REP_CalcD02 = cGP_REP_Calc+name
, GP_REP_CalcD03 = cGP_REP_LIST
, GP_REP_CalcD04 = cGP_REP_Calc_SP+name
, GP_REP_CalcD05 = cGP_REP_VARIANT+cGP_REP_Row+cGP_REP_Calc+name
);


Create Table GP.GP_REP_Calc_DETCOL "Отчет, Расч.данные, детали по столбцам"
  With Table_CODE = 31675
  With replace
  With TableOptions Branched
(   Nrec                : Comp                    "Номер записи"
  , cGP_REP_VARIANT     : Ref(GP_REP_VARIANT    ) "ссылка на вариант"
  , cGP_REP_List        : Ref(GP_REP_List       ) "ссылка на лист"
  , cGP_REP_Row         : Ref(GP_REP_Row        ) "ссылка на строку"
  , cGP_REP_Col         : Ref(GP_REP_Col        ) "ссылка на столбец"
  , cGP_REP_Calc        : Ref(GP_REP_Calc       ) "ссылка на расчет"
  , cGP_REP_Calc_Detail : Ref(GP_REP_Calc_Detail) "ссылка на строку с расчетами"
  , VDouble             : double                  "кол-во"
  , VString             : String                  "строка"
)
with index
( GP_Rep_CalcDC00 = NRec (Unique, Surrogate, Journal)
, GP_REP_CalcDC01 = cGP_REP_VARIANT+cGP_REP_Row+cGP_REP_Col+cGP_REP_Calc_Detail
, GP_REP_CalcDC02 = cGP_REP_Calc
, GP_REP_CalcDC03 = cGP_REP_LIST
, GP_REP_CalcDC04 = cGP_REP_Calc_DETAIL+cGP_REP_Col
);




Create Table GP.GP_REP_PICKREP "Отчет, Выбор"
  With Table_CODE = 31676
  With replace
  With TableOptions Branched
(   Nrec       :  Comp       "Номер записи"
  , wList      :  word       "Тип"
  , nm_Table   :  string[30] "Таблица"
  , cNastr     :  comp       "Ссылка на настройку"
  , Crec       :  comp       "Входящий код"
  , sVal       :  String[50] "Код"
)
with index
( GP_Rep_PICKREP00  = NRec (Unique, Surrogate, Journal)
, GP_REP_PICKREP01  = nm_table+cNastr+wList+crec
, GP_REP_PICKREP02  = wList+crec
);


