
Create table EM_SMS "Рассылка СМС"
With table_Code = 31622
with Replace
with tableoptions Branched
(
     Nrec          : comp         "Идентификатор"
   , NumberSend    : longint      "Номер рассылки"
   , Phone         : String       "Номер телефона куда СМС"
   , Status        : word         "0-подг,1-готово,2-отправлено,3-ошибка"
   , DateIN        : Date         "Дата поставноки в очередь СМС"
   , TimeIn        : time         "Время постановки в очередь СМС"
   , DateSend      : Date         "Дата отправки СМС"
   , TimeSend      : time         "Время отправки СМС"
   , Description   : String       "Описание"
   , cPersons      : ref(Persons) "Ссылка на сотрудника"
   , SMS_TEXT      : LVAR         "Текст СМС"
)
With index
(
   i_nrec = NRec(Unique, Surrogate, Journal)
 , i_ind1 = NumberSend
 , i_ind2 = cPersons + DateIN + TimeIn
)
;

