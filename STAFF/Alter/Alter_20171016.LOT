#include DicTypes.def           // Словарные типы данных.
Create table GP.GP_WorkingConditions "Доп. поля справочника Условия труда"
  With table_Code = 31516
  With replace
  With TableOptions Branched
  (
    NRec               : comp "Номер записи",
    cCat               : ref(Catalogs) "Ссылка на запись справочника",
    cPayForHarmWork    : ref(Catalogs) "Доплата за вредные условия труда",
    PayForHarmWorkProc : tProc "Процент доплаты за вредные условия труда",
    cVacForHarmWork    : ref(KlOtpusk) "Доп. отпуск за вредные условия труда",
    cWorkRegime        : ref(KlRejim) "Режим работы"
  )
  With index
  (
    WorkingConditions01 = NRec(Unique, Surrogate, Journal),
    WorkingConditions02 = cCat
  );

