#include DicTypes.def           // Словарные типы данных.

Create table GP.GP_PlannedReceipts "Плановые поступления"
  With table_Code = 31576
  With replace
  With TableOptions Branched
  (
    NRec            : comp "Номер записи",
    Status          : word "Статус",
    TypeSrc         : word "Тип документа источника потребности",
    cSrcDoc         : ref(MnPlan) "Документ источник потребности",
    cSrcDocPos      : ref(SpMnPlan) "Позиция документа источника потребности",
    TypeItem        : word "Тип потребности",
    cSrcItem        : comp "ТМЦ/Услуга из источника потребности",
    RequiredDate    : date "Дата отпуска требуемая",
    PlannedDate     : date "Дата поступления план",
    NeedAmount      : tSumma "Количество потребности",
    cDepInitiator   : ref(KatPodr) "Подразделение-инициатор",
    cOrderCode      : ref(MnPlan) "Шифр заказа",
    ProductNumber   : string "Номер изделия",
    DSE             : string "Номенклатурная позиция (ДСЕ)",
    cConsNeedDoc    : ref(MnPlan) "Консолидированная потребность (КП)",
    cConsNeedDocPos : ref(SpMnPlan) "Позиция консолидированной потребности",
    cConsNeedItem   : comp "ТМЦ/Услуга из консолидир. потребности",
    ConsNeedLastDate: date "Дата последнего изменения статуса в КП",
    ConsNeedAmount  : tSumma "Количество КП",
    cWorkPlanDoc    : ref(MnPlan) "Рабочий план исполнителя (РП)",
    cWorkPlanDocPos : ref(SpMnPlan) "Позиция рабочего плана",
    cWorkPlanItem   : comp "ТМЦ/Услуга из позиции рабочего плана",
    WorkPlanLastDate: date "Дата последнего изменения статуса в РП",
    WorkPlanAmount  : tSumma "Количество РП",
    cLotDoc         : ref(MnPlan) "Рабочий план исполнителя (РП)",
    cLotDocPos      : ref(SpMnPlan) "Позиция рабочего плана",
    cLotItem        : comp "ТМЦ/Услуга из позиции рабочего плана",
    LotLastDate     : date "Дата последнего изменения статуса в РП",
    LotAmount       : tSumma "Количество РП",
    cContract       : ref(Dogovor) "Договор",
    cCalPlan        : ref(CalPlan) "Пункт календарного плана договора",
    cContractItem   : comp "ТМЦ/Услуга из договора",
    ContractLastDate: date "Дата послед. измен-я статуса в договоре",
    ContractAmount  : tSumma "Количество из договора",
    cInvoice        : ref(KatSopr) "Приходная накладная",
    cInvoicePos     : ref(SpSopr) "Позиция приходной накладной",
    cInvoiceItem    : comp "ТМЦ/Услуга из приходной накладной",
    InvoiceLastDate : date "Дата послед. измен-я статуса накладной",
    InvoiceAmount   : tSumma "Количество из приходной накладной",
    cWriteOffDoc    : ref(KatSopr) "Документ на Отпуск/Списание",
    cWriteOffPos    : ref(SpSopr) "Позиция документа на Отпуск/Списание",
    cWriteOffItem   : comp "ТМЦ/Услуга из док-а на Отпуск/Списание",
    WriteOffLastDate: date "Дата послед. измен-я статуса документа",
    WriteOffAmount  : tSumma "Количество на Отпуск/Списание",
    ClosedDate      : date "Дата установки статуса Закрыто"
  )
  With index
  (
    PlannedReceipts01 = NRec(Unique, Surrogate, Journal),
    PlannedReceipts02 = Status + RequiredDate,
    PlannedReceipts03 = Status + PlannedDate,
    PlannedReceipts04 = TypeItem + cSrcItem,
    PlannedReceipts05 = cSrcDoc + cSrcDocPos + RequiredDate,
    PlannedReceipts06 = cConsNeedDoc + cConsNeedDocPos + RequiredDate,
    PlannedReceipts07 = cWorkPlanDoc + cWorkPlanDocPos + RequiredDate,
    PlannedReceipts08 = cLotDoc + cLotDocPos + RequiredDate,
    PlannedReceipts09 = cContract + cCalPlan + RequiredDate,
    PlannedReceipts10 = cInvoice + cInvoicePos + RequiredDate,
    PlannedReceipts11 = cWriteOffDoc + cWriteOffPos + RequiredDate
  );
