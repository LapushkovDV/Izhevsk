SQL select Distinct //X$FILES.XF$Name
  'SQL DELETE FROM '+X$FILES.XF$Name+';'
From X$FILES
inner join X$Fields on X$Fields.XE$FILECODE = X$FILES.XF$CODE
and (X$Fields.XE$Name='PERSON' OR X$Fields.XE$Name='CPERSON' OR X$Fields.XE$Name='TPERSON'
 OR X$Fields.XE$Name='CPERSONS'
 OR X$Fields.XE$Name='CLSCH' OR X$Fields.XE$Name='CLSCHET' OR X$Fields.XE$Name='CLSTTAB'
 OR X$Fields.XE$Name='TABN' OR X$Fields.XE$Name='STRTABN' OR X$Fields.XE$Name='TABNMB'
 or X$Fields.XE$Name='CWORKPERIOD'
 )
and X$FILES.XF$Name<>'CURLS'
 ;
