#include DicTypes.def           // Словарные типы данных.
#DEFINE STAGE03
#IFDEF STAGE01
select GP_PrCal.*     to dbf c:\1\dbf\GP_PrCal.dbf;
select GP_TimeNorms.* to dbf c:\1\dbf\GP_TimeNorms.dbf;
#ENDIF
// VIP
#IFDEF STAGE02
drop table GP_PrCal;
drop table GP_TimeNorms;
#ENDIF
#IFDEF STAGE03
Create table GP.GP_PrCal "Производственные календари"
  With table_Code = 31896
  With replace
  With TableOptions Branched
  (
     NRec          : Comp "Номер записи"
    ,Code          : String[20] "Код"
    ,Name          : String[50] "Наименование"
    ,WeekLength    : Word "Продолжительность рабочей недели"
  )
  With index
  (
    GP_PrCal01 = NRec(Unique, Surrogate, Journal),
    GP_PrCal02 = Code + Name
  );

Create table GP.GP_TimeNorms "Среднемесячные нормы рабочего времени"
  With table_Code = 31895
  With replace
  With TableOptions Branched
  (
     NRec          : Comp "Номер записи"
    ,Year          : Word "Год"
    ,cGP_PrCal     : ref(GP_PrCal) "Производственный календарь"
    ,Hours         : Double "Количество часов"
  )
  With index
  (
    GP_TimeNorms01 = NRec(Unique, Surrogate, Journal),
    GP_TimeNorms02 = Year+cGP_PrCal
  );

import GP_PrCal     from dbf  c:\1\dbf\GP_PrCal.dbf nfsr;
import GP_TimeNorms from dbf  c:\1\dbf\GP_TimeNorms.dbf nfsr;

#ENDIF