select comp(Persons.disprofnmb) (fieldname=CEXECUTOR)
  ,comp(catalogs.dopstr)+100000 (fieldname=CPODRCHIEF)
  ,comp(EM_STAFFSTRUCT.S0012) (fieldname=CPOSTCHIEF)
  ,catpost.name
  ,string(staffstruct.cnewspr3-8000000000000000h)  (fieldname=CSTAFFSTR)
  ,GP_KPI_CHIEF.*
FROM GP_KPI_CHIEF
  ,Persons , Catalogs, Catalogs CatPost
  ,Staffstruct, EM_STAFFSTRUCT
  where (( GP_KPI_CHIEF.CEXECUTOR == Persons.Nrec
  and GP_KPI_CHIEF.CPODRCHIEF == catalogs.nrec
  and GP_KPI_CHIEF.CPOSTCHIEF == catpost.nrec
  and GP_KPI_CHIEF.CSTAFFSTR  == Staffstruct.nrec
  and staffstruct.cnewspr3-8000000000000000h  == em_staffstruct.S0001
  ))
 //to dbf c:\1\dbf\GP_KPI_CHIEF.dbf
   ;

select
     comp(catalogs.dopstr)+100000 (fieldname=CPODR)
//,  comp(EM_STAFFSTRUCT.S0012)+100000  (fieldname=CPOST)
,  GP_KPI_PLAN.*
FROM GP_KPI_PLAN
 , Persons
 , Catalogs
 , Catalogs CatPost
 //, Staffstruct
where
((   GP_KPI_PLAN.CCHIEFKPI == Persons.nrec
and  GP_KPI_PLAN.CSTAFFSTR == Staffstruct.nrec
and  GP_KPI_PLAN.CPODR == catalogs.nrec
and  GP_KPI_PLAN.CPOST == catpost.nrec
//and  GP_KPI_PLAN.CPODR == staffstruct.department
//and  GP_KPI_PLAN.CPOST == staffstruct.post and ( staffstruct.dclose=Zerodate)
//and staffstruct.cnewspr3  == em_staffstruct.S0001

))
to dbf c:\1\dbf\GP_KPI_PLAN.dbf
;
