//компилятор интерфейсов
#include DicTypes.def           // Словарные типы данных.

  Create table GP.GP_PersAv "Персональный аванс"
  With table_Code = 31800
  With replace
  With TableOptions Branched
  (
    NRec       : comp    "Номер записи"
  , FIO        : string  "ФИО"
  , TabN       : string  "Табельный номер"
  , cKatPodr   : comp    "ссылка на подразделение сотрудника"
  , DatProvTab : date    "Дата проведения"
  , Datpos     : date    "Дата поступления"
  , DatUv      : date
  , priznAlim  : string
  , procAlim   : double
  , sistOpl    : string
  , Perech     : String
  , AvPlan     : double
  , AvRasch    : double
  , AvFact     : double
  , Otrab      : double
  , OtrabNO    : double
  , OtrabNN    : double
  , OtrabNO_R  : string
  , OtrabNN_R  : string
  , OtrabV     : double
  , PlanCh     : double
  , razr       : word
  , tarsetka   : word
  , Dolzhn     : string
  , Cex        : comp
  )
with index 
(
  GP_PersAv01 = TabN
, GP_PersAv02 = FIO
);

  Create table GP.GP_NeyavAV "Неяв. аванс"
  With table_Code = 31801
  With replace
  With TableOptions Branched
  (
    Kod     : string
  , Priznak : integer
  )
with index 
(
   GP_NeyavAV01 = Priznak
);

