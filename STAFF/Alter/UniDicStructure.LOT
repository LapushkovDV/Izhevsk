Create table EM.EM_UniDic "Универсальный справочник"
with table_Code = 31616
with replace
with tableoptions Branched
(
   NREC          :comp                     "Идентификатор",
   cPARENT       :comp                     "Ссылка на родительский документ",
   wTYPE         :word                     "Тип документа",
   sNAME         :string                   "Наименование документа",
   addComp       :array[1..10] of comp     "Дополнительное поле comp",
   addDate       :array[1..10] of date     "Дополнительное поле date",
   addDouble     :array[1..10] of double   "Дополнительное поле double",
   addWord       :array[1..10] of word     "Дополнительное поле word",
   addLongint    :array[1..10] of longint  "Дополнительное поле longint",
   addString     :array[1..10] of string   "Дополнительное поле string"
)
with index
(
   i_NREC = NREC(Unique, Surrogate, Journal),
   i_cPARENT = cPARENT,
   i_wTYPE = wTYPE
)
;