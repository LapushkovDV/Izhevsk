#DEFINE STAGE03
//**************************************
#IFDEF STAGE01
select GP_SCUD_Pers.* from GP_SCUD_Pers to dbf  c:\1\GP_SCUD_Pers.DBf;
#ENDIF
// VIP
//**************************************
#IFDEF STAGE02
drop table GP_SCUD_Pers;
#ENDIF
//**************************************
#IFDEF STAGE03
 #include DicTypes.def           // Словарные типы данных.
  Create table GP.GP_SCUD_Pers "Список лиц СКУД"
  With table_Code = 31557
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , Code           : string[20] "Код"
   , Fio            : string[100] "Фио"
   , wType          : word "0 - собственные, 1 - сторонние "
   , cPersons       : ref(Persons) "Сотрудник"
   , cKatPodr       : ref(KatPodr) "Подразделение"
   , cKatOrg        : ref(KatOrg)  "Организация"
   , Passp_NMB      : string[30]   "Номер паспорта"
   , Passp_GivenDate: date         "Дата паспорта"
   , Passp_GivenBy  : string       "Паспорт выдан"
   , Passp_Podr     : string[30]   "Паспорт, код подразделения"
   , cTypeDoc       : ref(Catalogs) "Тип документа"
   , Propusk_NMB    : string[30]    "Пропуск, номер"
   , Propusk_From   : Date          "Пропуск, действует с"
   , Propusk_To     : Date          "Пропуск, действует по"
   , Propusk_TB     : word          "Техника безопасности"
   , Propusk_Lock   : word          "Блокировка пропуска"
   , cKlRejim       : Ref(KlRejim)  "Режим"
   , cGP_SCUD_Kateg : Ref(GP_SCUD_Kateg) "Категории сотрудников"
   , Ext_Key        : string(100)  "Внешний ключ"
   , CGP_SCUD_GRUP  : Ref(GP_SCUD_GRUP) "Группа сотрудников"
   , LPhoto         : LVar "Фотография"

  )
  With index
  (
    GP_SCUD_Pers01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Pers02 = Fio,
    GP_SCUD_Pers03 = wType+Fio,
    GP_SCUD_Pers04 = cKatPodr+Fio,
    GP_SCUD_Pers05 = cKatOrg+Fio,
    GP_SCUD_Pers06 = Propusk_NMB,
    GP_SCUD_Pers07 = Ext_Key ,
    GP_SCUD_Pers08 = cPersons+wType
  );
  import GP_SCUD_Pers from dbf c:\1\GP_SCUD_Pers.Dbf nfs;


#ENDIF
