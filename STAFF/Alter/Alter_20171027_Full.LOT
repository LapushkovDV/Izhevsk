#DEFINE STAGE03
//**************************************
#IFDEF STAGE01
select * from GP_SCUD_Events to dbf  c:\1\GP_SCUD_Events.DBf;
#ENDIF
// VIP
//**************************************
#IFDEF STAGE02
drop table GP_SCUD_Events;
#ENDIF
//**************************************
#IFDEF STAGE03
 #include DicTypes.def           // Словарные типы данных.
  Create table GP.GP_SCUD_AREAS "Копия таблицы AREAS_TREE"
  With table_Code = 31564
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
    ,ID_AREAS_TREE  : longint "ID_AREAS_TREE"
    ,N_LEFT         : longint "N_LEFT"
    ,N_RIGHT        : longint "N_RIGHT"
    ,N_LEVEL        : longint  "N_LEVEL"
    ,INNER_NAME     : String[100] "INNER_NAME"
    ,DISPLAY_NAME   : String[100] "DISPLAY_NAME"
    ,VISIBLE        : longint "VISIBLE"
    ,SCHEME_COORDS  : string "SCHEME_COORDS"
    ,SCHEME_ID      : longint     "SCHEME_ID"
    ,SCHEME_BRUSH_STYLE : longint  "SCHEME_BRUSH_STYLE"
    ,SCHEME_COLOR       : longint "SCHEME_COLOR"
    ,SCHEME_BRUSH_COLOR : longint "SCHEME_BRUSH_COLOR"
    //----- Дополнительные признаки
    ,wType :word "0 - Выход,1 Вход"
    ,Need_UCHET:word  "1- учитывать для контроля"
  )
  With index
  (
    GP_SCUD_AREAS01 = NRec(Unique, Surrogate, Journal)
   ,GP_SCUD_AREAS02 = ID_AREAS_TREE
  );
  //---------------------------
  Create table GP.GP_SCUD_Events "Регистрация событий в СКУД"
  With table_Code = 31565
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , NPP            : longint  "Порядковый Номер"
   , StrTabn        : String[50]  "Порядковый Номер"
   , Name           : string[100] "Сотрудник посетитель"
   , cGP_SCUD_Pers  : Ref(GP_SCUD_Pers) "Ссылка на справочник людей"
   , EnterDate      : date "Дата входа"
   , EnterTime      : time "Fhtvd выхода"
   , Card           : string[30]"Карта"
   , cKatPodr       : Ref(KatPodr) "Подразделение"
   , wEvents_Type   : word  "Тип события"
   , wResource      : word  "Тип ресурса устройства"
   , cStatus        : Ref(Gp_Status) "Статус"
   , cControler     : ref(GP_SCUD_Controler) "Контролер"
   , cArea          : ref(GP_SCUD_AREAS)  "Ареал"
  )
  With index
  (
    GP_SCUD_Events01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Events02 = NPP,
    GP_SCUD_Events03 = cGP_SCUD_Pers+NPP,
    GP_SCUD_Events04 = cGP_SCUD_Pers+EnterDate+EnterTime,
    GP_SCUD_Events05 = EnterDate+EnterTime
  );

  import GP_SCUD_Events from dbf c:\1\GP_SCUD_Events.Dbf nfs;
#ENDIF
