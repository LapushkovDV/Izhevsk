#DEFINE STAGE01
//**************************************
#IFDEF STAGE01
select * from GP_SCUD_Doc to dbf  c:\1\GP_SCUD_Doc.DBf;
#ENDIF
// VIP
//**************************************
#IFDEF STAGE02
drop table GP_SCUD_Doc;
#ENDIF
//**************************************
#IFDEF STAGE03
 #include DicTypes.def           // Словарные типы данных.
  Create table GP.GP_SCUD_Doc "Документы СКУД"
  With table_Code = 31558
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , DocNmb         : string[20] "Номер"
   , DocDate        : date "Дата"
   , cKatPodr       : ref(KatPodr) "Подразделение"
   , cKatOrg        : ref(KatOrg)  "Организация"
   , cStatus        : ref(GP_Status) "Статус"
   , cExecutor      : ref(Persons) "Исполнитель"
   , dStatus        : DateTime "Дата время установки статуса"
   , dInput         : DateTime "Дата время регистрации"
   , cUser          : ref(x$users) "Зарегистрировал"
   , wType          : word "Тип документа"
   , wTypeReg       : word "Тип регистрации"
   , cDocType       : ref(Catalogs) "Ссылка на тип документа"
   , cReason        : ref(GP_SCUD_Reason) "Причины"
   , Description    : String      "Описание"
   , EventDate      : date "Дата события"
   , EventTmB       : time "Время события с"
   , EventTmE       : time "Время события по"
  )
  With index
  (
    GP_SCUD_DOC01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_DOC02 = DocDate,
    GP_SCUD_DOC03 = wType+DocDate+DocNMB,
    GP_SCUD_Doc04 = cKatPodr+DocDate+DocNMB,
    GP_SCUD_Doc05 = cKatOrg+DocDate+DocNMB,
    GP_SCUD_Doc06 = cStatus+DocDate+DocNMB
  );

  import GP_SCUD_Doc from dbf c:\1\GP_SCUD_Doc.Dbf nfs;
#ENDIF
