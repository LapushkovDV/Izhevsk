alter table GP_SCUD_Events
add  (
  wSystem : word "Система"
  )
add index (
 GP_SCUD_Events08 = wSystem + SNPP,
 GP_SCUD_Events09 = cGP_SCUD_Pers+ wSystem + SNPP
 )
;
alter table GP_SCUD_Ev_all
add (
  wSystem : word "Система"
)
add index (
 GP_SCUD_EV_ALL06 = wSystem + SNPP,
 GP_SCUD_EV_ALL07 = cGP_SCUD_Pers+ wSystem + SNPP
 )
;
                                     
