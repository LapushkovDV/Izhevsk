#DEFINE STAGE01
//**************************************
#IFDEF STAGE01
select GP_SCUD_Doc_SP.*,GP_SCUD_Doc.wtype from GP_SCUD_Doc_SP,GP_SCUD_Doc
where (( GP_SCUD_Doc_SP.cGP_SCUD_Doc == GP_SCUD_Doc.Nrec ))
 to dbf  c:\1\GP_SCUD_Doc_SP.DBf;
#ENDIF
// VIP
//**************************************
#IFDEF STAGE02
drop table GP_SCUD_Doc_SP;
#ENDIF
//**************************************
#IFDEF STAGE03
 #include DicTypes.def           // Словарные типы данных.
  Create table GP.GP_SCUD_Doc_SP "Документы СКУД - Спецификация"
  With table_Code = 31559
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cGP_SCUD_Doc   : Ref(GP_SCUD_Doc )   "Документы СКУД"
   , cGP_SCUD_Pers  : Ref(GP_SCUD_Pers)  "Люди  СКУД"
   , cUser          : ref(x$users) "Зарегистрировал"
   , cReason        : ref(GP_SCUD_Reason) "Причины"
   , Description    : String      "Описание"
   , EventDate      : date "Дата события"
   , EventTmB       : time "Время события с"
   , EventTmE       : time "Время события по"
   , EventDateF     : date "Факт Дата события"
   , EventTmBF      : time "Факт Время события с"
   , EventTmEF      : time "Факт Время события по"
   , cGP_SCUD_Doc_SP: comp "Спец."
   , wType          : word " =GP_SCUD_Doc.wType"
  )
  With index
  (
    GP_SCUD_DOCSP01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_DOCSP02 = cGP_SCUD_Pers+EventDate,
    GP_SCUD_DOCSP03 = cGP_SCUD_Doc+cGP_SCUD_Doc_Sp+EventDate,
    GP_SCUD_DocSP04 = EventDate+EventTmB,
    GP_SCUD_DOCSP05 = cGP_SCUD_Pers+wType+EventDate
  );

  import GP_SCUD_Doc_SP from dbf c:\1\GP_SCUD_Doc_SP.Dbf nfs;

  //---------------------------
  Create table GP.GP_SCUD_Ev_All "Все события в СКУД"
  With table_Code = 31570
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , NPP            : longint  "Порядковый Номер"
   , sNPP           : string[50]  "Порядковый Номер"
   , StrTabn        : String[50]  "Порядковый Номер"
   , Name           : string[100] "Сотрудник посетитель"
   , cGP_SCUD_Pers  : Ref(GP_SCUD_Pers) "Ссылка на справочник людей"
   , EnterDate      : date "Дата входа"
   , EnterTime      : time "Fhtvd выхода"
   , Card           : string[30]"Карта"
   , cKatPodr       : Ref(KatPodr) "Подразделение"
   , wEvents_Type   : word  "Тип события"
   , wResource      : word  "Тип ресурса устройства"
   , cStatus        : Ref(Gp_Status) "Статус"
   , cControler     : ref(GP_SCUD_Controler) "Контролер"
   , cArea          : ref(GP_SCUD_AREAS)  "Ареал"
  )
  With index
  (
    GP_SCUD_Ev_All01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Ev_All02 = NPP,
    GP_SCUD_Ev_All03 = cGP_SCUD_Pers+NPP,
    GP_SCUD_Ev_All04 = cGP_SCUD_Pers+EnterDate+EnterTime,
    GP_SCUD_Ev_All05 = EnterDate+EnterTime
  );

#ENDIF
