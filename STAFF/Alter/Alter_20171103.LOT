//drop table GP_SCUD_Saldo;
 #include DicTypes.def           // Словарные типы данных.
  //---------------------------



  Create table GP.GP_SCUD_Saldo "Сальдо часов"
  With table_Code = 31568
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cGP_SCUD_PERS  : ref(GP_SCUD_PERS)   "Сотрудники СКУД"
   , cPersons       : ref(Persons)        "Картотека персонала"
   , YearN          : word "Год сальдо"
   , MesN           : word "Месяц сальдо"
   , CH_Over_Ost    : TSumma "Сверхурочные, остаток на начало"
   , CH_Over_Cur    : TSumma "Сверхурочные, тек.месяц"
   , CH_Over_Opl    : TSumma "Сверхурочные, оплачено"
   , CH_Over2_Ost   : TSumma "Переработка, остаток на начало"
   , CH_Over2_Cur   : TSumma "Переработка, тек.мес"
   , CH_Over2_Opl   : TSumma "Переработка, оплачено"
   , CH_Holiday_Ost : TSumma "Выходные, остаток на начало"
   , CH_Holiday_Cur : TSumma "Выходные, тек.мес"
   , CH_Holiday_Opl : TSumma "Выходные, оплачено"
  )
  With index
  (
     GP_SCUD_Saldo01 = NRec(Unique, Surrogate, Journal)
    ,GP_SCUD_Saldo02 = cGP_SCUD_PERS+YearN+MesN(Unique)
    ,GP_SCUD_Saldo03 = cPersons+YearN+MesN
    ,GP_SCUD_Saldo04 = YearN+MesN
  );
