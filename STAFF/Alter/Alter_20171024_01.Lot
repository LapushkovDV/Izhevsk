#include DicTypes.def           // Словарные типы данных.

 Create table GP.GP_SCUD_Events "Регистрация событий в СКУД"
  With table_Code = 31564
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , NPP            : longint  "Порядковый Номер"
   , StrTabn        : String[50]  "Порядковый Номер"
   , Name           : string[100] "Сотрудник посетитель"
   , cGP_SCUD_Pers  : Ref(GP_SCUD_Pers) "Ссылка на справочник людей"
   , EnterDate      : date "Дата входа"
   , EnterTime      : time "Fhtvd выхода"
   , Card           : string[30]"Карта"
   , cKatPodr       : Ref(KatPodr) "Подразделение"
   , wEvents_Type   : word  "Тип события"
   , wResource      : word  "Тип ресурса устройства"
   , cStatus        : Ref(Gp_Status) "Статус"
   , cControler     : ref(GP_SCUD_Controler) "Контролер"
  )
  With index
  (
    GP_SCUD_Events01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Events02 = NPP,
    GP_SCUD_Events03 = cGP_SCUD_Pers+NPP,
    GP_SCUD_Events04 = cGP_SCUD_Pers+EnterDate+EnterTime,
    GP_SCUD_Events05 = EnterDate+EnterTime
  );

/*
alter table GP_SCUD_Events
add index
(   GP_SCUD_Events05 = EnterDate+EnterTime
);*/
