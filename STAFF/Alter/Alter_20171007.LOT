/*
alter table GP_SCUD_Podr
add index (
    GP_SCUD_Podr07 = cNode+Name,
    GP_SCUD_Podr08 = cNode+Code
);
alter table GP_SCUD_Pers
delete index
( GP_SCUD_Podr06 = Ext_Key
);
alter table GP_SCUD_Pers
add index (
    GP_SCUD_Pers07 = Ext_Key ,
    GP_SCUD_Pers08 = cPersons+wType
);
*/
#include DicTypes.def           // Словарные типы данных.
  Create table GP.GP_KPI_Pers_Raise "Персональный набор премий"
  With table_Code = 31548
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cDoplata       : ref(Catalogs) "Тип премии"
   , cPersons       : ref(Persons)  "Сотрудник"
   , cAppoint       : ref(Appointments)  "Вакансия"
   , FromDate       : date "C даты"
   , ToDate         : date "по дату"
   , Procent        : tSumma "Процент"
   , cTitleDoc      : Ref(TitleDoc) "Приказ"
   , cContDoc       : Ref(ContDoc)  "содержимое приказа"
  )
  With index
  (
    GP_Pers_Raise01 = NRec(Unique, Surrogate, Journal),
    GP_Pers_Raise02 = cPersons+FromDate,
    GP_Pers_Raise03 = cAppoint+FromDate,
    GP_Pers_Raise04 = cContDoc+cPersons+cDoplata+FromDate,
    GP_Pers_Raise05 = FromDate
  );

//========================================
//СКУД
//========================================
  Create table GP.GP_SCUD_Kateg "Категории сотрудников"
  With table_Code = 31549
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , Code           : string[20] "Код"
   , Name           : string[100] "Наименование"
   , wType          : word "Тип"
  )
  With index
  (
    GP_SCUD_Kateg01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Kateg02 = Code,
    GP_SCUD_Kateg03 = Name,
    GP_SCUD_Kateg04 = wType
  );
  Create table GP.GP_SCUD_Grup "Группы сотрудников"
  With table_Code = 31550
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , Code           : string[20] "Код"
   , Name           : string[100] "Наименование"
   , wType          : word "Тип"
  )
  With index
  (
    GP_SCUD_Grup01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Grup02 = Code,
    GP_SCUD_Grup03 = Name,
    GP_SCUD_Grup04 = wType

  );

  Create table GP.GP_External_LINK "Связи со внешними таблицами"
  With table_Code = 31552
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , IN_Table       : string[50] "Внутренняя таблицы+суффикс"
   , IN_Key         : string[50] "Внутренний ключ"
   , OUT_System     : string[50] "Внешняя система"
   , OUT_Table      : string[50] "Внешняя таблицы+суффикс"
   , OUT_Key        : string[50] "Внешний ключ"
   , OUT_Optiob     : word  "1 - удаление"
  )
  With index
  (
    GP_GP_LINK01 = NRec(Unique, Surrogate, Journal),
    GP_GP_LINK02 = IN_Table+IN_Key+OUT_System+OUT_Table+OUT_Key,
    GP_GP_LINK03 = OUT_System+OUT_Table+OUT_Key+IN_Table+IN_Key
  );

  Create table GP.GP_External "Внешние таблицы"
  With table_Code = 31553
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , IN_Table       : string[50] "Внутренняя таблицы+суффикс"
   , IN_Key         : string[50] "Внутренний ключ"
   , IN_Key_Link    : string[50] "Внутренний ключ для стыковки"
   , OUT_System     : string[50] "Внешняя система"
   , OUT_Table      : string[50] "Внешняя таблицы+суффикс"
   , OUT_Key        : string[200] "Внешний ключ"
   , OUT_Key_Link   : string[200] "Внешний ключ для стыковки "
  )
  With index
  (
    GP_GP_External01 = NRec(Unique, Surrogate, Journal),
    GP_GP_External02 = IN_Table+IN_Key+OUT_System+OUT_Table+OUT_Key,
    GP_GP_External03 = OUT_System+OUT_Table+OUT_Key+IN_Table+IN_Key

  );

  Create table GP.GP_External_Fields "Внешние таблицы - поля"
  With table_Code = 31554
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cGP_External   : Ref(GP_External) "Таблицы"
   , IN_Fields      : string[50] "Внутреннее поле"
   , IN_Type        : word "Внутреннее поле, Тип 1- формула"
   , OUT_Fields     : string[200] "Внешнее поле"
   , Out_Type       : word "Внешнее поле, Тип 1- формула"
   , Key            : word "Использовать при стыковке"
   , In_ExPresion   : string "функция преобразования - наружу "
   , Out_ExPresion  : string "функция преобразования - наружу "
  )
  With index
  (
    GP_GP_External01 = NRec(Unique, Surrogate, Journal),
    GP_GP_External02 = cGP_External+IN_Fields,
    GP_GP_External03 = cGP_External+Out_Fields,
    GP_GP_External04 = cGP_External+Key+IN_Fields,
    GP_GP_External05 = cGP_External+Key+Out_Fields

  );

  Create table GP.GP_SCUD_Podr "Подразделения СКУД"
  With table_Code = 31555
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , Code           : string[20] "Код"
   , Name           : string     "Наименование"
   , wType          : word "0 - собственные, 1 - сторонние "
   , cKatPodr       : ref(KatPodr) "Подразделение"
   , cKatOrg        : ref(KatOrg)  "Организация"
   , Ext_Key        : string(100)  "Внешний ключ"
   , Ext_Key_UP     : string(100)  "Внешний ключ - вышестоящее"
   , cNode          : ref(GP_SCUD_Podr)
  )
  With index
  (
    GP_SCUD_Podr01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Podr02 = Name,
    GP_SCUD_Podr03 = wType+Name,
    GP_SCUD_Podr04 = cKatPodr+Name,
    GP_SCUD_Podr05 = cKatOrg+Name,
    GP_SCUD_Podr06 = Ext_Key ,
    GP_SCUD_Podr07 = cNode+Name,
    GP_SCUD_Podr08 = cNode+Code

  );

  Create table GP.GP_SCUD_Reason "Причины"
  With table_Code = 31556
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , Code           : string[20] "Код"
   , Name           : string[100] "Наименование"
   , wType          : word "Тип"
  )
  With index
  (
    GP_SCUD_Reason01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Reason02 = Code,
    GP_SCUD_Reason03 = Name,
    GP_SCUD_Reason04 = wType
  );

  Create table GP.GP_SCUD_Pers "Список лиц СКУД"
  With table_Code = 31557
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , Code           : string[20] "Код"
   , Fio            : string[100] "Фио"
   , wType          : word "0 - собственные, 1 - сторонние "
   , cPersons       : ref(Persons) "Сотрудник"
   , cKatPodr       : ref(KatPodr) "Подразделение"
   , cKatOrg        : ref(KatOrg)  "Организация"
   , Passp_NMB      : string[30]   "Номер паспорта"
   , Passp_GivenDate: date         "Дата паспорта"
   , Passp_GivenBy  : string       "Паспорт выдан"
   , Passp_Podr     : string[30]   "Паспорт, код подразделения"
   , cTypeDoc       : ref(Catalogs) "Тип документа"
   , Propusk_NMB    : string[30]    "Пропуск, номер"
   , Propusk_From   : Date          "Пропуск, действует с"
   , Propusk_To     : Date          "Пропуск, действует по"
   , Propusk_TB     : word          "Техника безопасности"
   , cKlRejim       : Ref(KlRejim)  "Режим"
   , cGP_SCUD_Kateg : Ref(GP_SCUD_Kateg) "Категории сотрудников"
   , Ext_Key        : string(100)  "Внешний ключ"
   , LPhoto         : LVar "Фотография"
  )
  With index
  (
    GP_SCUD_Pers01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Pers02 = Fio,
    GP_SCUD_Pers03 = wType+Fio,
    GP_SCUD_Pers04 = cKatPodr+Fio,
    GP_SCUD_Pers05 = cKatOrg+Fio,
    GP_SCUD_Pers06 = Propusk_NMB,
    GP_SCUD_Pers07 = Ext_Key ,
    GP_SCUD_Pers08 = cPersons+wType
  );
  Create table GP.GP_SCUD_Doc "Документы СКУД"
  With table_Code = 31558
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , DocNmb         : string[20] "Номер"
   , DocDate        : string[20] "Дата"
   , cKatPodr       : ref(KatPodr) "Подразделение"
   , cKatOrg        : ref(KatOrg)  "Организация"
   , cStatus        : ref(GP_Status) "Статус"
   , cExecutor      : ref(Persons) "Исполнитель"
   , dStatus        : DateTime "Дата время установки статуса"
   , dInput         : DateTime "Дата время регистрации"
   , cUser          : ref(x$users) "Зарегистрировал"
   , wType          : word "Тип документа"
   , wTypeReg       : word "Тип регистрации"
   , cDocType       : ref(Catalogs) "Ссылка на тип документа"
   , cReason        : ref(GP_SCUD_Reason) "Причины"
   , Description    : String      "Описание"
   , EventDate      : date "Дата события"
   , EventTmB       : time "Время события с"
   , EventTmE       : time "Время события по"
  )
  With index
  (
    GP_SCUD_DOC01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_DOC02 = DocDate,
    GP_SCUD_DOC03 = wType+DocDate+DocNMB,
    GP_SCUD_Doc04 = cKatPodr+DocDate+DocNMB,
    GP_SCUD_Doc05 = cKatOrg+DocDate+DocNMB,
    GP_SCUD_Doc06 = cStatus+DocDate+DocNMB
  );
  Create table GP.GP_SCUD_Doc_SP "Документы СКУД - Спецификация"
  With table_Code = 31559
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cGP_SCUD_Doc   : Ref(GP_SCUD_Doc)   "Документы СКУД"
   , cGP_SCUD_Pers  : Ref(GP_SCUD_Pers)  "Люди  СКУД"
   , cUser          : ref(x$users) "Зарегистрировал"
   , cReason        : ref(GP_SCUD_Reason) "Причины"
   , Description    : String      "Описание"
   , EventDate      : date "Дата события"
   , EventTmB       : time "Время события с"
   , EventTmE       : time "Время события по"
   , EventDateF     : date "Факт Дата события"
   , EventTmBF      : time "Факт Время события с"
   , EventTmEF      : time "Факт Время события по"
  )
  With index
  (
    GP_SCUD_DOCSP01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_DOCSP02 = cGP_SCUD_Pers+EventDate,
    GP_SCUD_DOCSP03 = cGP_SCUD_Doc+EventDate,
    GP_SCUD_DocSP04 = EventDate
  );


  Create table GP.GP_SCUD_Pers_Hist "Список лиц СКУД - история"
  With table_Code = 31560
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cGP_SCUD_Pers  : ref(GP_SCUD_Pers)  "Список лиц СКУД"
   , Fio            : string[100] "Фио"
   , wType          : word "0 - собственные, 1 - сторонние "
   , cKatPodr       : ref(KatPodr) "Подразделение"
   , cKatOrg        : ref(KatOrg)  "Организация"
   , DTIZM          : Date "Дата изменения"
   , cDocument      : Ref(GP_SCUD_Doc) "Документ"
   , Propusk_NMB    : string[30]    "Пропуск, номер"
   , Propusk_From   : Date          "Пропуск, действует с"
   , Propusk_To     : Date          "Пропуск, действует по"
   , Propusk_TB     : word          "Техника безопасности"
   , cKlRejim       : Ref(KlRejim)  "Режим"
  )
  With index
  (
    GP_SCUD_Pers_Hist01 = NRec(Unique, Surrogate, Journal),
    GP_SCUD_Pers_Hist02 = cGP_SCUD_Pers+Fio,
    GP_SCUD_Pers_Hist03 = cDocument+Fio,
    GP_SCUD_Pers_Hist04 = cKatPodr+Fio,
    GP_SCUD_Pers_Hist05 = cKatOrg+Fio,
    GP_SCUD_Pers_Hist06 = Propusk_NMB
  );
