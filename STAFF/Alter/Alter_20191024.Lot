
  //-------------------------------------------
Create table EM.EM_DeclesionObj "Склонения объектов"
With table_Code = 31617
With replace
With TableOptions Branched
(
  NRec       : comp "Номер записи"
, Type       : word "Тип записи (номер таблицы)"
, cRec       : comp "Запись исходная"
, DeclFull   : array[1..6] of string "Имя 1-имен,2-родит. и т.д."
, DeclShort  : array[1..6] of string "Имя Иниц. 1-имен,2-родит. и т.д."
, Gender     : String    "Пол"
)
With index
(
Decl01 = NRec(Unique, Surrogate, Journal),
Decl02 = Type + cRec
);
