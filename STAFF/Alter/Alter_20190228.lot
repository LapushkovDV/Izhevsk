//компилятор интерфейсов
#dEFINE ETAP03
#ifdef ETAP01
SELECT GP_PrNaryad_Ext.* TO DBF C:\1\DBF\GP_PrNaryad_Ext.DBF;
#ENDIF
#ifdef ETAP02
DROP TABLE GP_PrNaryad_Ext;
#ENDIF
#ifdef ETAP03
#include DicTypes.def           // Словарные типы данных.
Create table GP.GP_PrNaryad_Ext "Наряды. Дополнительная информация"
With table_Code = 31890
With replace
With TableOptions Branched
(
  Nrec       : Comp           "Номер записи"
 ,Descr      : String         "Дескриптор"
 ,cZakazAMM  : comp           "Наряд, пришедшмий из АММ"
 ,cPrNaryad  : ref(PrNaryad)  "Наряд"
 ,PersRazr   : Word           "Разряд рабочего"
 ,TPs        : String         "Номер ТПс"
 ,ZNP        : String         "Номер ЗНП"
 ,DSEName    : String         "Наименование ДСЕ"
 ,OperName   : String         "Наименование операции"
 ,OperRazr   : Word           "Разряд работы"
 ,GrOpl      : Word           "Группа оплаты"
 ,KolVoGodn  : Decimal(31,15) "Количество годных"
 ,NrmTimePZ  : Decimal(31,15) "Подг.-закл. время"
 ,RascenPZ   : Decimal(31,15) "Подг.-закл. время - расценка"
)
With index
(
  GP_PrNaryad_Ext01 = NRec (Unique, Surrogate, Journal)
 ,GP_PrNaryad_Ext02 = cPrNaryad
);
      DD
IMPORT  GP_PrNaryad_Ext FROM DBF C:\1\DBF\GP_PrNaryad_Ext.DBF NFS;

#ENDIF