#include DicTypes.def           // Словарные типы данных.

Create table GP.GP_SpKauPeriod "История изменения ставки дефлятора"
  With table_Code = 31593
  With replace
  With TableOptions Branched
  (
    NRec        : comp "Номер записи",
    cSpKau      : Ref(SpKau) "Ссылка на аналитику",
    dBeg        : date "Дата начала периода",
    dEnd        : date "Дата окончания периода",
    Value       : double "Ставка"
  )
  With index
  (
    GP_SpKauPeriod01 = NRec(Unique, Surrogate, Journal),
    GP_SpKauPeriod02 =cSpKau + dBeg + dEnd
  );
