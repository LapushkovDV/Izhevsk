//DEFINE _EXPORT_
#DEFINE _IMPORT_
#IFDEF _IMPORT_
import Spkau from dbf c:\1\spkau_10025.dbf nfs;
import Spkau from dbf c:\1\spkau_10025Up.dbf nfs;
#ENDIF
#IFDEF _EXPORT_
select
   NREC                 //│Номер записи
  ,ATTR                // │Атрибуты
 ,CNODE                //│Ссылка на вышестоящий уровень
 ,CODE                 //│Код объекта аналитического учет
 ,LEVELCODE            //│Код внутри группы, уровня
 ,NAME                 //│Наименование КАУ
 ,NPP                  //│Порядковый номер
 ,10025 (Fieldname=KODGRKAU)           //  │Код группы КАУ
 ,VDATA                //│Значение
 ,ISARCH              // │Признак архивности
 From Spkau where (( 10020 == kodgrkau )) to dbf c:\1\spkau_10025.dbf;
select spkau.* from spkau where (( 10025 << kodgrkau )) to dbf c:\1\spkau_10025Up.dbf;
#ENDIF