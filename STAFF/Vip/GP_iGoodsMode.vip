/*************************************************************************************************\
* Наименование: Утилита корректировки рабочих периодов в отпусках, утвержденных приказом          *
* Контур/Модуль: Кадры                                                                            *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3375         |12/09/18|Кучин Д.Л.             |НПО Энергомаш                      *
\*************************************************************************************************/

#include PAFilter.vih
#include WorkPeriods.vih

#component "Z_Staff"

#doc
Корректировка РП в отпусках по приказам
#end
Interface iGoodsMode 'Корректировка РП'
          (, ) EscClose, cyan;
  Show at (1, 1, 200, 35);

var   vWorkPeriod: WorkPeriods;            // Рабочие периоды

Create view

 var
   cChangePut
  ,cFiltrPers
  ,cChangeFact      : comp;

  ZeroDate:date;

as select
  Persons.*,
  FactOtpusk.*,
  WorkPeriod.*,
  Vacations.*,
  Otpusk.*,
  PutVacation.*,
  PutVacCon.*,
  Appointments.*,
  KlOtpusk.*

  , if ( cFiltrPers <> comp(0), Filtr_Persons.FIO, 'фильтр не установлен' )
  (fieldname = fSotrFiltr)

from
  Persons,
  Persons Filtr_Persons,
  FactOtpusk,
  WorkPeriod,
  WorkPeriod Change_WorkPeriod,
  Vacations,
  Otpusk,
  PutVacation,
  PutVacation Change_PutVacation,
  Appointments,
  KlOtpusk,
  KlOtpusk  Vacations_KlOtpusk,
  KlOtpusk  Otpusk_KlOtpusk,
  KlOtpusk  PutVac_KlOtpusk,
  KlOtpusk  Change_KlOtpusk
,  PutVacCon

where
  ((
     Vacations.Person == Persons.nRec and
     Vacations.cFactOtpusk == FactOtpusk.nRec and
     Vacations.nREc == Otpusk.cVacations and
     FactOtpusk.cWorkPeriod == WorkPeriod.nRec and
     Vacations.cPutVac == PutVacation.nRec and
     FactOtpusk.cContDoc == ContDoc.nREc and
     ContDoc.cPart == PartDoc.nRec and
     PartDoc.cDoc == TitleDoc.nREc and
     persons.appointcur == Appointments.nRec

   and FactOtpusk.VacType   == KlOtpusk.KOtpus
   and Vacations.VacType   == Vacations_KlOtpusk.nRec
   and Otpusk.Kotpus   == Otpusk_KlOtpusk.KOtpus
   and PutVacation.cKlOtpusk == PutVac_KlOtpusk.nRec

   and coContDoc == PutVacCon.wTable
   and ContDoc.nRec == PutVacCon.cTable
   and Vacations.cPutVac == PutVacCon.cPutVacation

   and cChangeFact == Change_WorkPeriod.nRec
   and cChangePut == Change_PutVacation.nRec
   and Change_PutVacation.cKlOtpusk == Change_KlOtpusk.nRec
   and cFiltrPers == Filtr_Persons.nRec
  ))

  bounds ByPers as cFiltrPers == Vacations.Person
  ;

  browse brEd (,, sci1Esc);
  show at (, , , 26) ;
    table Vacations;
    fields
      Persons.FIO 'Сотрудник'('',,): [11], protect;

      [fTypeNazn] case(Appointments.lPrizn;0:'О',3:'С',100:'УО',31:'УС';'?') 'Тип назначения' ('',, ): [2], protect;

      [fTabNmb] if((Appointments.lPrizn=0),GetStrTabN(Persons.TabNmb, Persons.StrTabN),GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN))
      'Табельный номер' ('',, ): [10], protect;

      [fWP]WorkPeriod.dPerBeg + ' - ' + WorkPeriod.dPerEnd 'Рабочий период' ('',, ): [20], protect;
      KlOtpusk.NOtpus 'Пакет отпусков', 'Наименование' ('',, ): [15], protect;
      FactOtpusk.FactYearBeg 'Пакет отпусков', 'дата начала' ('',, ): [8], protect;
      FactOtpusk.FactYearEnd 'Пакет отпусков', 'дата окончания' ('',, ): [8], protect;

      Vacations_KlOtpusk.NOtpus ' Кадры.','Отпуск.','Наименование' ('',, ): [15], protect;
      Vacations.FactYearBeg ' Кадры.','Отпуск.','Дата начала' ('',, ): [8], protect;
      Vacations.FactYearEnd ' Кадры.','Отпуск.','Дата окончания' ('',, ): [8], protect;
      Vacations.Duration ' Кадры.','Отпуск.','Продолжительность' ('',, ): [8], protect;

      Otpusk_KlOtpusk.NOtpus 'Зарплата.', 'Отпуск.', 'Наименование' ('',, ): [15], protect;
      Otpusk.dataN 'Зарплата.', 'Отпуск.', 'Дата начала' ('',, ): [8], protect;
      Otpusk.datOk 'Зарплата.', 'Отпуск.', 'Дата окончания' ('',, ): [8], protect;
      Otpusk.KOLDN 'Зарплата.', 'Отпуск.', 'Продолжительность' ('',, ): [8], protect;

      PutVac_KlOtpusk.NOtpus 'Полагающийся', 'Наименование' ('',, ): [8], protect;
      TitleDoc.DocNmb 'Приказ','Номер' ('',, ): [10], skip;
      TitleDoc.DocDate 'Приказ','Дата' ('',, ): [8], skip;
      TitleDoc.DocText 'Приказ','Краткое содержание' ('',, ): [20], skip;

  end; // browse

screen scrNew;
  show (, 27, , );
  fields
    fSotrFiltr             ('',,sci13Esc), Protect, PickButton;
    [fChange_WorkPeriod] Change_WorkPeriod.dPerBeg + ' - ' + Change_WorkPeriod.dPerEnd ('',,sci13Esc), Protect, PickButton;
    Change_KlOtpusk.Notpus ('',,sci13Esc), Protect, PickButton;

  buttons
    cmOk,default,, '', ,;

<<
  Фильтр по сотруднику:       .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  `Новый рабочий период`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Новый полагающийся отпуск` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <.    Изменить    .>
>>

end; // screen

HandleEvent

cmOk:
{
  if (cChangeFact = comp(0) or
      cChangePut = comp(0))
  {
    message('Не выбран новый рабочий период или новый полагающийся отпуск! Изменения не вступят в силу.');
    abort;
    exit;
  }

  if ( GetFirst ContDoc = tsOk )
  {
      if ( GetFirst PutVacCon = tsOk )
      {
        PutVacCon.cPutVacation := cChangePut;
        update current PutVacCon;

        ContDoc.cWorkPeriod    := cChangeFact;
        update current ContDoc;

        FactOtpusk.cWorkPeriod := cChangeFact;
        update current FactOtpusk;

        Vacations.cPutVac := cChangePut;
        Vacations.cWorkPeriod := cChangeFact;
        Vacations.VacType := Change_KlOtpusk.nRec;
        update current Vacations;

        message('Изменения вступили в силу.');
        abort;
        exit;
      }
  }

  message('Что-то пошло не так...');
}

cmDelOnProtect:
  case CurField of

    #fSotrFiltr:
    {
        set cFiltrPers := comp(0);
        PopBounds(tbByPers);
        RereadRecord(#Vacations);
    }

  end;

cmPick:
{
  case CurField of

    #fSotrFiltr:
    {
      var ParentSav: comp;
      if (RunInterface('PrikPsn', 0, comp(0), ParentSav) = cmDefault)
      {
        set cFiltrPers := ParentSav;
        PushBounds(tbByPers);
        RereadRecord(#Vacations);
      }
    }

    #fChange_WorkPeriod:
    {
      var WPMarker: TPtr = InitMarker('WorkPeriods_WPMarkers', 8, 200, 10);
      ClearMarker(WPMarker);
      if (FactOtpusk.cWorkPeriod <> comp(0))
        InsertMarker(WPMarker, FactOtpusk.cWorkPeriod);

      DoneMarker(WPMarker, 'WorkPeriods_WPMarkers');

      if ( RunInterface('WorkPeriods', comp(0)
                                     , Persons.nRec
                                     , Appointments.nRec
                                     , word(2)
                                     // дату начала пакета отпусков нужно исключить из расчета т.к. уже в отпуске
                                     , Sub_Day(FactOtpusk.FactYearBeg, 1)) <> cmCancel )
      {
        WPMarker := InitMarker('WorkPeriods_WPMarkers', 8, 200, 10);
        var cTmp: comp;
        if (GetMarker(WPMarker, 0, cTmp))
        {
          set cChangeFact := cTmp;
        }

        DoneMarker(WPMarker, 'WorkPeriods_WPMarkers');
      }
    }

    #Change_KlOtpusk.Notpus:
    {
      var cTmp: comp;
       cTmp := vWorkPeriod.GetVacationForWP_WithPosition(cChangeFact, comp(0), FactOtpusk.FactYearBeg);
      if (cTmp <> comp(0))
      {
        set cChangePut := cTmp;
        if ( GetFirst Change_PutVacation = tsOk )
        {
           if ( GetFirst Change_KlOtpusk = tsOk )
           {
           }
        }
      }
    }

  end;
}

end; // HandleEvent

End.
