#include ExtAttr.vih

#component "Z_StaffOrders"
alter interface NFormRD20a;
overload
  DataStream DTS_NForm20a;
end;

#include ExtAttr.var

Create view MakeReport1View
from
  MnPlan,MnPlan MnPlanPart
where((
  oExtAttr.coGetAttr(coPartDoc,PartDoc.Nrec,'Заказ')==MnPlanPart.NRec and
  oExtAttr.coGetAttr(coContDoc,ContDoc.Nrec,'Заказ')==MnPlan.NRec
));

Function CalcSumma:double;
{
  result:=0;

  _loop ContDoc
    if (Fortune.wAttr1=0)
      result+=Fortune.DocSum;
}

DataStream DTS_NForm20a
(
  [DateDoc] iStrFunc.UnVisibleDate(TitleDoc.DocDate, 'DD.MM.YYYY');
  [Itogo] CalcSumma;

  Table inherited::ContDoc
  (
    [DepCode] IDepartIer.GetCodeOnDate(Appointments.Department,
                if (Fortune.Dat1 <> ZeroDate, Fortune.Dat1, Cur_Date));
    [MnPlanNumber] if(IsValidAll(tnMnPlan),MnPlan.Number,MnPlanPart.Number);
  );
)
end;

end.
