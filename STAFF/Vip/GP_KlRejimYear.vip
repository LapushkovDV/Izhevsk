#include GP_KlRejimYear.vih
interface GP_KlRejimYear;

create view ltKlRejimYear
from
  GP_KlRejimYear;

function DelRec(cKlRejim:comp):boolean;
{
  result:=delete GP_KlRejimYear where((cKlRejim==GP_KlRejimYear.cKlRejim))=tsok;
}

end.

//Для поддержания ссылочной целостности
handler with replace GP_KlRejimYearDelete on trigger KlRejim before Delete [99]
action
{
  var buf : record as table KlRejim;
  GetTableBuffer(buf);

  var oKlRejimYear:GP_KlRejimYear;
  result:=oKlRejimYear.DelRec(buf.NRec);
}
