#component "Z_StaffOrders"

VipInterface RPD_300(RPD_1) licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base.SetRelation(Value: comp);
  procedure IRPD_Base3.PrintFromPD;
  function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
end;

interface RPD_300;
var StrPasName_GP:string;
create view
bounds ByNRecOrder = nRecOrder == ContDoc.cPart and Integer(1) == ContDoc.SeqNmb;

