  Appointments.wAddWord1 ('По штатному расписанию/вне штатного расписания',, sciStaffTypical1Esc):
            [list ' ', 'по ШР', 'вне ШР' ], skip, nostatic;
  ContractStr: protect, pickbutton;
  fullNamePodr ('Подразделение'): protect;
  KlKatego.NaiKat ('Категория');
  Appointments.Foundation ('Основание назначения',, sciStaffTypical1Esc): [40];
  StrPasName_GP: Skip;
  PasName ('Место прописки'): protect;
Buttons
  cmValue4,,, 'Документы';
  cmValue6,,, 'Сведения об образовании';
  cmValue1,,, 'Сведения о стажах';
  cmViewAdvance1,,, 'Просмотр примечания к приказу';
<<
 Зачислить с      .@@@@@@@@@@ `по`.@@@@@@@@@@
 Характер назн-я  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@
 Договор          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Структ.подразд.  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Категория        .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Основание        .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
.@@@@@@@@@@@@@@@  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <.    Документы     .> <.    Образование   .> <. Сведения о стажах.> <.   Примечание     .>
>>
end;

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  inherited::EnableDisable;

  ToggleFieldSelectable(#ContDoc.wDopAttr,false);
  ToggleFieldSelectable(#Appointments.wAddWord1,false);
  if (not BoundActive(tbByNRecOrder)) {  //89345
    ResetBounds(tnContDoc);
    AddBounds(tbByNRecOrder);
  }
}

procedure SetRelation(Value: comp);
{
  if (not BoundActive(tbByNRecOrder)) {
    ResetBounds(tnContDoc);
    AddBounds(tbByNRecOrder);
  }

  inherited::SetRelation(Value);
}

function ChildCheckOneOrder(cNrec : comp = 0): boolean;
var IsNoCategory:boolean;
{
  IsNoCategory:=false;
  if (IsValidAll(tnAppointments)) {
    Appointments.Post:=1;

    IsNoCategory:=Appointments.EmpCategory=0;
    if (IsNoCategory)
      Appointments.EmpCategory:=1;

    update current Appointments;
  }

  result:=inherited::ChildCheckOneOrder(cNrec);

  if (IsValidAll(tnAppointments)) {
    Appointments.Post:=0;

    if (IsNoCategory)
      Appointments.EmpCategory:=0;

    update current Appointments;
  }
}

//******************************************************************************
// Печать индивидуального приказа вызванная из события cmPrintDoc
//******************************************************************************
procedure PrintFromPD;
{
  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,1,ContDoc.NRec,ContDoc.Person,Appointments.NRec);
}

TableEvent table ContDoc;
cmSetDefault:{
  if (not BoundActive(tbByNRecOrder)) {
    abort;
    exit;
  }

  case inherited :: handleEvent (cmSetDefault) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
cmInsertRecord:{
  case inherited :: handleEvent (cmInsertRecord) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (PartDoc.TypeOper<>ContDoc.TypeOper and IsValidAll(tnContDoc)) {
    ContDoc.TypeOper:=PartDoc.TypeOper;
    update current ContDoc;
  }
}
end;

TableEvent table Appointments;
cmSetDefault:{
  case inherited :: handleEvent (cmSetDefault) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  Appointments.wAddWord1 := 2;//вне ШР
}
end;

HandleEvent
cmOnVipLoad:{
  case inherited :: handleEvent (cmOnVipLoad) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
  StrPasName_GP:= 'Место прописки';

  SetFormat(FirstScr_300);
  SetEnumList(FirstScr_300, #ContDoc.wDopAttr, arGroup, arGroupVal);

  SetFormat(scrDoc_300);
}
cmPick:{
  case CurField of
    fnfullNamePodr:{
      ParentSav := Appointments.Department;
      if (RunInterface('GP_PickCatForPhysicalPerson', -11, ParentSav) = cmDefault) {
        if not CheckPodrInFiltr(ParentSav)
          Message('Установленный фильтр не позволяет выбирать данное подразделение.', Information);
        else {
          Set Appointments.Department := ParentSav;
          set ContDoc.cDopRef := Appointments.Department;
          update current ContDoc;
        }
      }
      exit;
    }
  end;

  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
cmHotKeys:{
  if ( not UpdateTable )
    exit;

  var menuID: longint;
  menuID := LoadMenu('RPD_PR300');

  prFillMenu(menuID);

  PutHotCommand(RunLoadMenu(menuID));
}
cmValue17:{//Печать доп. соглашения (Word)
  if (not UpDateTable) exit;

  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,0,ContDoc.NRec,ContDoc.Person,Appointments.NRec);
}
end;

end.

RPD_PR300 menu
{
  - 'Исполняется', cmImp, 'Перевод приказа в состояние "исполняется". Лицевой счет не создается!', hcNoContext, 'Alt+I', kbAltI;
  -----------;
  - 'Печать индивидуальной формы приказа', cmPrintDoc
      , 'Индивидуальный отчет приказа по сотруднику'
        , hcStaffReceptionMenu, 'Ctrl+P', kbCtrlP,,,,, bmpPrint;
  - 'Печать договора (Word)', cmValue17, 'Печать договора (Word)', , , ,,,,, bmpPrint;
  -----------;
  - 'Внешняя классификация', cmPickClass, 'Внешняя классификация'
       ,hcGkatalM1ExtClass,'Alt+C', kbAltC, sci1Esc,,,, bmpClassifierSO;
  - 'Внешние атрибуты', cmPickAttr,
      'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr
        ,'Alt+A', kbAltA, sci1Esc,,,, bmpAttributeSO;
  -----------;
  - 'Утвердить приказ по одному сотруднику', cmIerarchy,
       'Утвердить приказ по одному сотруднику', hcNoContext, 'Ctrl+U', kbCtrlU,,,,, bmpConfirm16;
  - 'Утвердить приказ', cmLegend,
       'Утвердить приказ', hcNoContext, 'Alt+U', kbAltU,,,,, bmpConfirmGroup16;
  - 'Проверка приказа', cmCheckRPD,
       'Проверка приказа', hcNoContext, 'Ctrl+M', kbCtrlM,,,,, bmpCheck16;
  = 'Информация об утверждении', 'Информация об утверждении', hcNoContext;
  {
    - 'Общая информация', cmValue23,
         'Общая информация', hcNoContext, '',,,,,;
    - 'Пролонгированный приказ', cmExp,
         'Пролонгированный приказ', hcNoContext, 'Alt+O', kbAltO;
  }
}
