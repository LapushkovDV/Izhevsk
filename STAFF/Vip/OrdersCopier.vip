/*************************************************************************************************\
* Наименование: Интерфейс по созданию групповых приказов                                          *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1208         |09/11/17|Кузьмин П.Ю.             |НПО Энергомаш                    *
* Доработка   |#2018         |07/03/18|Кузьмин П.Ю.             |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_StaffOrders"
alter interface OrdersCopier;
overload
  Procedure CheckTypeOfRpd(wKind: word; dRabDate: date);
end;
create view
from  AllMemo gpAllMemoWorkType
     ,AllMemo gpAllMemoWorkTypeNew
;

procedure GP_Copy4Agreement60(cAppHist:comp);
var cContrCur: comp;
{
  if NOAA.NeedFormAddAgreementPers(ContDocNew.TypeOper)
    if getfirst PartDoc4Agreement where ((ContDocNew.cPart == PartDoc4Agreement.nRec)) = tsOk
      if getfirst TitleDoc4Agreement where ((PartDoc4Agreement.cDoc == TitleDoc4Agreement.nRec)) = tsOk
      {
        cContrCur := WWC.GetContractOnDate(ContDocNew.Person, TitleDoc4Agreement.DocDate, ContDocNew.cStr);

        NOAA.CreateAgreement(cContrCur, TitleDoc4Agreement.DocDate, coAppHist, cAppHist);
      }
}

Procedure GP_Copy_60(wKind: word);
{
  var cC: comp;
  var LocalDate: date=ZeroDate;

  if (GetFirst FastFirstRow AppHist where((ContDocRab.nRec == AppHist.cContDoc)) = tsOk)
    LocalDate := AppHist.dRec;

  // создаем ContDoc стандартно для всех копирований
  cC := CreateNewContDoc(wKind, LocalDate);

  if (cC <> 0) {
    ClearBuffer(tnAppHistNew);
    AppHistNew.Buffer := AppHist.Buffer;
    AppHistNew.nRec := GetNextNrec(#AppHistNew, 0);
    AppHistNew.cContDoc := cC;
    AppHistNew.cAppoint := ContDocNew.cStr;
    if (insert current AppHistNew  = tsOk) {
      ContDocNew.LastDate := ContDocRab.LastDate;
      ContDocNew.SBottom := ContDocRab.SBottom;
      if (update current ContDocNew <> tsOk) {};

      GP_Copy4Agreement60(AppHistNew.NRec);
    }
  }
}
Procedure GP_Copy_190(wKind: word);
{
  var cC: comp;
  var LocalDate: date;
  if GetFirst FastFirstRow SalScale // теперь содержимое приказа
      where ((0 == SalScale.wTblCode
              and ContDocRab.Nrec == SalScale.cUnit)) = tsOk
    LocalDate := SalScale.LastDate
  else
    LocalDate := date(0, 0, 0);
  // создаем ContDoc стандартно для всех копирований
  cC := CreateNewContDoc(wKind, LocalDate);
  // если пролезло создание, будем формировать требуемые записи по дням
  if cC <> 0
    _loop SalScale
        where ((0 == SalScale.wTblCode
                and ContDocRab.Nrec == SalScale.cUnit))
    {
      ClearBuffer(tnSalScaleNew);
      SalScaleNew.Buffer := SalScale.Buffer;
      SalScaleNew.cUnit := cC;
      SalScaleNew.Nrec := GetNextNrec(#SalScale, 0);

      if Insert Current SalScaleNew = tsOk
      {
       If getfirst gpAllMemoWorkType where ((coSalScale    == gpAllMemoWorkType.wTable and
                                             SalScale.Nrec == gpAllMemoWorkType.cRec and
                                             0             == gpAllMemoWorkType.Npp
                                           )) = tsOK
        {
          gpAllMemoWorkTypeNew.Buffer := gpAllMemoWorkType.Buffer;
          gpAllMemoWorkTypeNew.cRec   := SalScaleNew.nrec;
          gpAllMemoWorkTypeNew.Nrec   := GetNextNrec(#gpAllMemoWorkTypeNew, 0);
         if insert current gpAllMemoWorkTypeNew = tsOK {
             var memoTmpFileName: string = 'DeleteMeNOW_Please.txt';
              deleteFile(memoTmpFileName);
              ExportMemoToFile(gpAllMemoWorkType.Mem, memoTmpFileName, false);
              ImportFileToMemo(gpAllMemoWorkTypeNew.Mem, memoTmpFileName, false);
              update current gpAllMemoWorkTypeNew;
         }
        }

      };
    } // _loop SalScale
} //Procedure Copy_90(wKind: word);

Procedure CheckTypeOfRpd(wKind: word; dRabDate: date);
{
  case ContDocRab.TypeOper of
    60  : GP_Copy_60(wKind);  // Заявки на работу в выходной день
    190 : GP_Copy_190(wKind); // Изменение режима работы
    209 : Copy_9(wKind);      // Назначение стипендии студентам

    else
      inherited::CheckTypeOfRpd(wKind, dRabDate);
  end;
}

end.
