#include TuneSpec.vih

VipInterface PostTune_GP_Staff implements ObjPostTuneComponent licensed (FREE);

// Обработчик точки расширения epPostTuneComponentGetVipName
#HandlerPointExtPostTuneGetVipName(GP_Staff,100)

#doc
Пост-обработка настроек компоненты <link Component GP_Staff>GP_Staff</link>.
#end
Interface PostTune_GP_Staff;


//Для поиска/создания РПД
create view vRPD
var
  _wRPD: word;
as select
  TypePr.Nrec
from
  TypePr
 ,Shifts
where ((
  _wRPD == TypePr.CodOper
));


//Ищет РПД по коду, при отсутствии создает.
//Возвращает nrec найденного/созданного РПД
function GetRPD(wRPD            : word;
                sName           : string;
                wRPDGroup       : word;
                bSeparateNumbers: boolean;
                GroupNumber     : Integer
               ): comp;
{
  vRPD._wRPD := wRPD;
  if vRPD.getfirst TypePr != tsOk
  {
    var cRPDGroup: comp;
    cRPDGroup := if(wRPDGroup = 0, 0,
      GetRPD(wRPDGroup, 'Группа ' + GroupNumber, 0, bSeparateNumbers, GroupNumber));

    vRPD.ClearBuffer(vRPD.tnTypePr);
    vRPD.TypePr.CodOper := wRPD;
    vRPD.TypePr.NOper   := sName;
    vRPD.TypePr.cTDop   := cRPDGroup;
    vRPD.insert current TypePr;

    vRPD.ClearBuffer(vRPD.tnShifts);
    vRPD.Shifts.SysCode   := wRPD;
    vRPD.Shifts.SeqNmb    := if(bSeparateNumbers, 1, 0);
    vRPD.Shifts.CycleCode := GroupNumber;
    vRPD.insert current Shifts;
  }
  result := vRPD.TypePr.Nrec;
}


Public Function PostUpdateComponent (TR : TuneFuncObj; TuneCode : string; TuneObj: LongInt; TuneUser : comp) : boolean;
{ #__UNUSED__(TR,TuneObj,TuneUser)
  result := true;

  case TuneCode of
    'UP.STAFF.PRIKAZ_PERS.RPD_120.VIDUD': GetRPD(120, 'Погашение подотчетных сумм', 10003, true, 3);
  else
    result := false;
  end;
}

end.
