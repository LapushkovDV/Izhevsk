/*************************************************************************************************\
* Наименование:  Списочная численность в разрезе вида производства                                *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3158          |27/07/18 |Ермолов К.Р.             |НПО Энергомаш                  *
\*************************************************************************************************/

#include userreport.vih

interface gp_spischisvidpr 'Параметры отчета' gray
Show at (,,25,5);

table struct tChis
(
vidpr: string,
kol: integer
)
with index
(
i1 = vidpr (unique)
)
;

create view

var
excelpath: string;
counter, sum: longint;
datachis: date;

as select vidpr, kol from tchis;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  datachis, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    На дату:.@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  datachis:= cur_date;
}

cmGo:
{
  delete all from tChis;

  sql
  select attrval.vstring, count(appointments.strtabn)
  from appointments
  inner join persons on persons.nrec = appointments.person
  inner join staffstruct on staffstruct.nrec = appointments.staffstr
  left join catalogs on catalogs.nrec = staffstruct.department
  inner join attrval on attrval.crec = catalogs.nrec
  inner join attrnam on attrnam.nrec = attrval.cattrnam
  where appointments.lprizn = 0 and attrnam.name = 'Вид производства'
  and appointments.appointdate <= :(datachis) and (appointments.dismissdate = 0 or appointments.dismissdate > :(datachis))
  group by attrval.vstring
  into tChis
  ;

  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);
  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_spischisvidpr.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  xlsetcellstringvalue('СПИСОЧНАЯ ЧИСЛЕННОСТЬ НА ' + datachis, 1, 1, 1, 1);

  counter:= 2;
  sum:= 0;

  _loop tChis
  {
    counter++;
    xlsetcellstringvalue(tChis.vidpr, counter, 1, counter, 1);
    xlsetcellnumbervalue(tChis.kol, counter, 2, counter, 2);
    sum:= sum + tChis.kol;
  }

  counter++;
  xlsetfontstyle(1, counter, 1, counter, 2);
  xlAlignCells(-4152, counter, 1, counter, 1);
  xlsetcellstringvalue('Всего', counter, 1, counter, 1);
  xlsetcellnumbervalue(sum, counter, 2, counter, 2);

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 2);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_spischisvidpr Implements IUserReport;
Interface UserReport_spischisvidpr;

Procedure Run;
Begin
  runinterface(gp_spischisvidpr);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Списочная численность в разрезе вида производства';
End;

Function GetGroupName (Level : Word) : String;
Begin
#__UNUSED__(Level)
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
