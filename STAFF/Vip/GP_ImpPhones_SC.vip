#doc
GP_ImpPhones_SC
Интерфейс для загрузки телефонных номеров из Excel
#end

VipInterface GP_ImpPhones_SC Licensed(free);

Interface GP_ImpPhones_SC 'Загрузка телефонных номеров из Excel', EscClose;
Show at (0,0,61,7);

Table Struct tPhones
(
    lastname    : string
  , firstname   : string
  , middlename  : string
  , fio         : string
  , stabn       : string
  , phones      : string
  , cPers       : comp
)
with index
(
    i01 = stabn
  , i02 = cPers
);

Table struct tTelNumber
(
  tel : string
)
with index
(
  i01 = tel
);

Create View rView
var
  rowNo, colNo : longint;
  filename  : string;
  _log      : string;
  sTmp      : string;
As
select
  1
from
   tPhones
  ,Communications
  ,Persons
;


Function MakeFio(_s1, _s2, _s3 : string) : string;
{
  result := Trim(_s1) + ' ' + Trim(_s2) + ' ' + Trim(_s3);
}

Function UpdStrTabn(_s : string) : string;
{
  result := '';
  case Length(_s) of
    1 : { result := '00000' + _s; }
    2 : { result := '0000' + _s; }
    3 : { result := '000' + _s; }
    4 : { result := '00' + _s; }
    5 : { result := '0' + _s; }
    6 : { result := '' + _s; }
    else {result := '';}
  end;
  result := result;
}

Function GetPersByTabN(_s : string) : comp;
{
  result := 0h;
  if (getFirst FastFirstRow Persons where ((_s == Persons.StrTabN (noindex))) = tsOk) then
  {
    result := Persons.nRec;
  }
  result := result;
}

Function GetPersByFio(_s : string) : comp;
{
  result := 0h;
  if (getFirst FastFirstRow Persons where ((_s == Persons.Fio (noindex))) = tsOk) then
  {
    result := Persons.nRec;
  }
  result := result;
}


Window wHumansList 'Люди', EscClose;

Browse brHumansList;
Table tPhones;
Fields
  tPhones.stabn          'stabn'  ('stabn',,sci1378Esc) : [15], Protect, NoPickButton;
  tPhones.fio            'fio'    ('fio',,sci1378Esc)   : [15], Protect, NoPickButton;
  tPhones.Phones         'Phones' ('Phones',,sci1378Esc): [15], Protect, NoPickButton;
  tPhones.cPers          'cPers'  ('cPers',,sci1378Esc) : [15], Protect, NoPickButton;
end;

end;

Screen scr1 'Загрузка телефонных номеров из Excel' (,,sci13Esc);
show at (1,1,60,6);
fields
  filename : Protect, PickButton;
buttons
  cmOk        ,[doubleline];
  cmCancel    ,[doubleline];
  cmValue666  ,[doubleline];
<<

  Файл:      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <. Импортировать .>                   <.    Отмена     .>

                                        <.     Люди      .>

>>
end;

HandleEvent
cmInit:
{
  filename := 'C:\NII\НИИМаш рабочие телефоны.XLSX';
  _log := 'ImpPhones.log';
}
cmPick:
{
  case CurField of
  #filename:
  {
    var ww_str : string = GetFileName('*.xlsx', 'Выберите файл с данными:');
    if (ww_str <> '') then
    {
      set filename:= ww_str;
    }
  }
  end;
}
CmOk:
{
  StartNewVisual(vtNumericVisual, vfTimer, 'Импорт номеров телефонов', 1);

  xlCreateExcelWithTemplate(filename, false);
  if (xlIsExcelValid)
    xlSetActiveWorkBookByName('1');

  rowNo := 1;
  do
  {
    colNo := 1;
    rowNo++;
    NextVisual;


    xlgetcellvalue(rowNo, colNo, sTmp);

    if (sTmp = '') then
    {
      Break;
    }
    else
    {
      ClearBuffer(#tPhones);

      xlgetcellvalue(rowNo, colNo, sTmp);
      tPhones.lastname := sTmp;

      colNo++;

      xlgetcellvalue(rowNo, colNo, sTmp);
      tPhones.firstname := sTmp;

      colNo++;

      xlgetcellvalue(rowNo, colNo, sTmp);
      tPhones.middlename := sTmp;

      tPhones.fio := MakeFio(tPhones.lastname, tPhones.firstname, tPhones.middlename);

      colNo++;

      xlgetcellvalue(rowNo, colNo, sTmp);
      tPhones.stabn := UpdStrTabn(sTmp);


      tPhones.cpers := if(GetPersByTabN(tPhones.stabn) = 0h, GetPersByFio(tPhones.fio), GetPersByTabN(tPhones.stabn));


      colNo++;

      xlgetcellvalue(rowNo, colNo, sTmp);
      tPhones.phones := sTmp;


      Insert Current tPhones;
    }
  }
  while 1 = 1
  xlkillExcel;

  _loop tPhones
  {
    if getfirst Communications where ((     tPhones.cpers  == Communications.Person (noindex)
                                        and tPhones.phones == Communications.Addr   (noindex) )) <> tsOK
    {
      ClearBuffer(#Communications);

      Communications.Nrec     := GetNextNrec(tnCommunications, 0);
      Communications.ObjType  := 2;
      Communications.Person   := tPhones.cpers;
      Communications.ComType  := 000A00000003B742h;
      Communications.SeqNmb   := 1;
      Communications.Addr     := tPhones.phones;

      // Parse

      insert current Communications;
    }
  }
  StopVisual('Импорт завершен');
}
cmValue666:
{
  RunWindow(wHumansList);
}
end;


End.
