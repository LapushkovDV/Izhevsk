#include GP_RepLaborContract.vih

#component "Z_StaffOrders"
#doc
Интерфейс приказа "Почасовые отклонения"
<p>#171
#end

//*******************************
alter interface RPD_91;
//*******************************
overload
  procedure IRPD_Base3.PrintFromPD;
  Procedure IRPD_Base.EnableDisable;
  function IRPD_Base.ChildCheckOneOrder(cNrec: comp = 0): boolean;
end;

//*******************************
ExtendFormats scrDet91, scrDet912;
//*******************************
var
  pVA_SalScale_TMB :comp; // Время начала отклонения
  pVA_SalScale_TME :comp; // Время окончания отклонения
create view
as select
  tGetAttrID(coSalScale,SalScale.Nrec,pVA_SalScale_TMB ) (FieldName=SalScale_TMB , FieldTitle='Время начала отклонения' )
, tGetAttrID(coSalScale,SalScale.Nrec,pVA_SalScale_TME ) (FieldName=SalScale_TME , FieldTitle='Время окончания отклонения' )
;

//*******************************
browse scrDet91 (,hcStaffWinPr, sci178Esc);  //Почасовые отклонения
show at (, 5,,18);
table SalScale;
Fields
 SalScale_TMB 'Время,нач.' ('Время начала отклонения',,) :[6], NoProtect , NoDel;
 SalScale_TME 'Время, оконч.' ('Время окончания отклонения',,) :[6], NoProtect , NoDel;
end;



//*******************************
screen scrDet912 (, hcStaffWinPr, sci1ESc);
show at (,19,,) Fixed_Y;
table ContDoc;
fields
  ContDoc.SBottom ('Основание', ), noprotect;
<<


 `Основание`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;



//******************************************************************************
// Функция проверки корректности заполнения приказа
//******************************************************************************
//берем целиков ..
function ChildCheckOneOrder(cNrec : comp = 0): boolean;
{
  result := true;

  if getfirst SalScale <> tsOk
  {
    SetErrorOrder('Приказ не заполнен!');
    result := false;
    exit;
  }

  if SalScale.LastDate > Date_to
  {
    SetErrorOrder('Дата окончания действия отклонения меньше даты начала!');
    result := false;
  }

  if SalScale.LastDate = ZeroDate
  {
    SetErrorOrder('Не указан период отклонения!');
    result := false;
  }


  if bogettune('NPOEM_OWN.EM_UUK.NEED_HOURS_IN_RPD91') // для НИИМАШ: необязательно часы указывать
  if SalScale.fSum0 + SalScale.fMin + SalScale.fMax < 0.0001
  {
    SetErrorOrder('Продолжительность табельного отклонения должна быть заполнена!');
    result := false;
  }

  if (Persons.DisDate <> Date(0,0,0)) and (SalScale.LastDate > Persons.DisDate) and (not IsRPD99Mode(8))
  {
    SetErrorOrder('Начало табельного отклонения (' + DateToStr(SalScale.LastDate, 'DD/MM/YYYY') +
          ') больше' + chr(13)+ chr(3) + 'даты увольнения ( ' + DateToStr(Persons.DisDate,'DD/MM/YYYY') + ' )!');
    result := false;
  }

  if (Persons.AppDate > SalScale.LastDate)
  {
    SetErrorOrder('Начало табельного отклонения (' + DateToStr(SalScale.LastDate, 'DD/MM/YYYY') +
          ') меньше' + chr(13)+ chr(3) + 'даты приема ( ' + DateToStr(Persons.AppDate,'DD/MM/YYYY') + ' )!');
    result := false;
  }

  _loop SalScale
  {
    if not isValid(tnInfPsn1) and IsUOForLeave // нет ссылки на РПД-90 И условное обозначение - отгул за работу в выходной или праздничный
    {
      var tmpStrMess: string = 'Не заполнена ссылка на РПД-90 (приказ о работе в выходные и праздничные)';
      case tuneNeedControlRPD_90Link of
        1: // "предупреждать при утверждении приказа, если не заполнена ссылка на РПД-90"
        {
          SetErrorOrder(tmpStrMess, Warning);
        }
        2: // "запрещать утверждать приказ, если не заполнена ссылка на РПД-90"
        {
          result := false;
          SetErrorOrder(tmpStrMess);
        }
      end;
    }
  }
}
//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{ if fnFieldsOpen
  { ClearFieldOption(#SalScale_TMB, ofProtected);
    ClearFieldOption(#SalScale_TME, ofProtected);
  }
  else
  { SetFieldOption(#SalScale_TMB, ofProtected);
    SetFieldOption(#SalScale_TME, ofProtected);
  }
  inherited::EnableDisable;

} //Procedure EnableDisable;

//индивидуальная печать вызванная из события cmPrintDoc
procedure PrintFromPD;
{
  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,1,ContDoc.NRec,ContDoc.Person,ContDoc.ObjNRec);
}

//****************************************
TableEvent table SalScale;
//****************************************
  cmExprFieldChanged:
  {
    inherited::handleevent(cmExprFieldChanged);
    case CurField of
    #SalScale_TMB:
      tSetAttrID(coSalScale,SalScale.Nrec,pVA_SalScale_TMB,StrToTime(ExprFieldValue,'HH:MM') );
    #SalScale_TME:
      tSetAttrID(coSalScale,SalScale.Nrec,pVA_SalScale_TME,StrToTime(ExprFieldValue,'HH:MM') );

    end;
  }
end;//TableEvent table SalScale

//****************************************
HandleEvent
cmOnVipLoad:
{ pVA_SalScale_TMB :=ExtAttr_Create(coSalScale,'Время начала отклонения'   , cgAttrType_Time);
  pVA_SalScale_TME :=ExtAttr_Create(coSalScale,'Время окончания отклонения', cgAttrType_Time);
  if  inherited :: handleEvent (cmOnVipLoad)=heAbort then Abort;
}
end;
end.
