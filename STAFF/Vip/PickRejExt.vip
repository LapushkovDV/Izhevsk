/*************************************************************************************************\
* Наименование: Интерфейс выбора режима работы (расширенная версия)                               *
* Контур/Модуль: Кадры                                                                            *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1150         |20/10/17|Кузьмин П.Ю.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include ExtClass.vih

#component "Z_Calendar"
alter interface PickRejExt;
show(10,5,160,25);
OverloadFormats rrr;

#include ExtClass.var
var wClassCodeDurationWork:word;

create view rejimView
var
 wYear:word;
from
  Grafik TempalateGrafik,
  GP_KlRejim,GP_PrCal,
  Klndr Klndr2// уже есть в логической таблице 06.03.2018
where((
  KlRejim.cCalendar == TempalateGrafik.NRec and
  KlRejim.NRec == GP_KlRejim.cKlRejim  and
  GP_KlRejim.cGP_PrCal == GP_PrCal.NRec and
  KlRejim.Rejim == Klndr2.Rejim and wYear == Klndr2.Yeark
));

browse rrr;
show(1,1,,);
table KLREJIM;
fields
  {font={color=if(not IsValidAll(tnKlndr2),ColorGray,0)}};
  KlRejim.Rejim 'Код' ('Код режима работы',hcrejim,scpickan):[3],protect,noautosize;
  KlRejim.NRejim 'Наименование ' ('Режим работы',hcrejim,scpickan):[25],protect;
  TempalateGrafik.Name 'Режим работы' (,hcrejim,scpickan):[25],protect,nodel;
  oExtClass.GetSegName(wClassCodeDurationWork,KlRejim.NRec)
    'Продолжительность','рабочего времени' (,hcrejim,scpickan):[25],protect;
  GP_PrCal.Name 'Производственный','календарь' (,hcrejim,scpickan):[25],protect,nodel;
  rejim_Days 'Кол-во','дней'('Продолжительность, дней') :[6], skip,noautosize;
  KlRejim.Hours 'Кол-во','часов'('Продолжительность, часов') :[6], skip,noautosize;
  KlRejim.Minutes 'Кол-во','минут'('Продолжительность, минут') :[6], skip,noautosize;
  NInterval 'Интервал' ('Интервал (день, неделя)',, sci13EnEsc) :[8], skip,noautosize;
end;

HandleEvent
cmInit:{
  wYear:=Year(Cur_Date);
  wClassCodeDurationWork:=oExtClass.CreateClass(coKlRejim,'Продолжительность рабочего времени',1);
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
end;

end.
