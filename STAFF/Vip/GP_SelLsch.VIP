#component "GP_Staff"
Interface GP_GetAllLschet 'Лицевые счета сотрудников'
          (, hcZar_VyborLScheta) DoAccept, EscClose, cyan;
  Show at (,,,);

Create view  AllLschetPersons
 var
   curLSchet : comp;

as select
  LSchet.nrec

from
  LSchet,
  Persons,
  KATPODR,
  Catalogs
where
  ((          root   == LSchet.tPerson and
      LSchet.tPerson == Persons.Nrec   and
          LSchet.Cex == KATPODR.Nrec   and
     LSchet.cAppoint == Catalogs.Nrec
  ))
;

Parameters curLSchet;


panel pAllLschetPersons
table LSchet;
 browse brAllLschetPersons (,, sci1Esc);
   fields
    LSchet.TabN     'Таб.номер'      ('Табельный номер работника',,):[9],protect;
    Lschet.StrTabn  'Таб.номер'      ('Табельный номер работника',,):[9],protect;
    Persons.Fio     'ФИО'      ('ФИО работника',,):[9],protect;
    KATPODR.kod     'Подразделение код'  ('Подразделение код',,):[20],protect;
    KATPODR.NAME    'Подразделение'  ('Подразделение',,):[20],protect;
    Catalogs.Name   'Должность'  ('Должность',,):[20],skip;
    LSchet.DATSSUDA ' Дата ', 'назначения' ('Дата назначения на должность',,):[10], skip;
    LSchet.datuv    ' Дата ', 'закрытия'   ('Дата закрытия л/с',,):[10], skip;
 end; //brAllLschetPersons;

HandleEvent

cmDefault :
{
    curLSchet:= LSchet.Nrec;
    CloseInterface(cmDefault);
}

end; //HandleEvent panel ss

end; //panel

HandleEvent

cmInit:
{
    if (getfirst LSchet where ((curLSchet == LSchet.Nrec)) <> tsOk){};

  if (wGetTune('FormatClockNumber') = 0)
      ClearFieldState(#Lschet.StrTabn, sfVisible);
    else
      ClearFieldState(#Lschet.Tabn, sfVisible);
  ReScanPanel(#Lschet);
}
 end; // HandleEvent
 End.
