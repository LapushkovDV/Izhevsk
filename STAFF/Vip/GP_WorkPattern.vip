#component "Z_Calendar"
#doc
Интерфейс просмотра и редактирования шаблонов рабочего дня
#end

interface GP_WorkPattern 'Просмотр шаблонов'
   ('',hcNastr_Grafik,sci14EnEsc) doaccept, escClose, cyan;

var IsWorkPatternExtMod,IsSpWorkExtMod:boolean;

// show at (5,2,48,18);
Create view WorkPatternView
var  prrec : comp;
as select
 WorkPattern.*, SpWork.*
from
 WorkPattern,
 SpWork,
 GP_WorkPatternExt,GP_SpWorkExt,
 WorkPattern PreHolidayPattern,
 SpWork GP_SpWork,
 synonym SpWork SpWorkS
where ((WorkPattern.Nrec == SpWork.cWorkPattern and
        WorkPattern.NRec==GP_WorkPatternExt.cWorkPattern and
        GP_WorkPatternExt.cPreHolidayPattern==PreHolidayPattern.NRec and
        SpWork.NRec==GP_SpWorkExt.cSpWork
      ))
order by WORKPATTERN.CODE;

parameters prrec;

Function GetWorkTime:time;
var WorkMin:word;
{
  WorkMin:=word(SpWork.DayChas*60+SpWork.DayMin+SpWork.NightChas*60+SpWork.NightMin);
  result:=time(WorkMin div 60,WorkMin mod 60,0,0);
}

Function CheckWorkTime:boolean;
var DayMin,DurationMin:longint;
{
  DayMin:=longint(SpWork.DayChas*60+SpWork.DayMin+SpWork.NightChas*60+SpWork.NightMin+SpWork.RazrChas*60+SpWork.RazrMin);
  DurationMin:=longint(To_Sec100(Sub_Time(SpWork.tEnd,SpWork.tStart))/6000);
  result:=DayMin=DurationMin;
}

window wWorkPattern 'Редактирование cправочника шаблонов рабочих дней' ('',,sci178Esc);
panel PWorkPatternWnd;
table WorkPattern;
browse BrWorkPatternWnd;
show at (,,,11);
 Fields
  Code  'Код' ('Код шаблона'):[5], noprotect;
  NameP 'Наименование шаблона' ('Наименование шаблона'):[20], noprotect;
  KolSmen   'Кол-во','смен'  ('Количество смен'):[6], noprotect;
  tStartDay 'Время','начала' ('Время начала смены'):[5,'HH:MM'], noprotect;
  tEndDay   'Время','окончания' ('Время окончания смены'):[5,'HH:MM'], noprotect;
  //BEvening   'Начало','вечерних' ('Время начала вечерних часов'):[5,'HH:MM'], noprotect;
  //EEvening   'Окончание','вечерних' ('Время завершения вечерних часов'):[5,'HH:MM'], noprotect;
  //BNight     'Начало','ночных' ('Время начала ночных часов'):[5,'HH:MM'], noprotect;
  //ENight     'Окончание','ночных' ('Время завершения ночных часов'):[5,'HH:MM'], noprotect;

  GP_WorkPatternExt.StartBreak1 'Начало','перерыва 1' ('Время начала перерыва 1'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  GP_WorkPatternExt.EndBreak1 'Окончание','перерыва 1' ('Время окончания перерыва 1'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  GP_WorkPatternExt.StartBreak2 'Начало','перерыва 2' ('Время начала перерыва 2'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  GP_WorkPatternExt.EndBreak2 'Окончание','перерыва 2' ('Время окончания перерыва 2'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  GP_WorkPatternExt.StartShift2 'Начало','смены 2' ('Время начала смены 2'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  GP_WorkPatternExt.EndShift2 'Окончание','смены 2' ('Время окончания смены 2'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  PreHolidayPattern.NameP 'Шаблон предпраздничного дня' ('Шаблон предпраздничного дня',,sci1378Esc):
    [30],Protect,PickButton;
  WorkPattern.BNight 'Начало','ночных' ('Время начала ночных часов'):
    [11,'HH:MM'], NoProtect,NoAutoSize;
  WorkPattern.ENight 'Окончание','ночных' ('Время завершения ночных часов'):
    [11,'HH:MM'], NoProtect,NoAutoSize;
end; //browse

HandleEvent

cmSetDefault   :
{
  ClearBuffer(#WorkPattern);
  SelectField(#WorkPattern.Code);

  WorkPattern.NRec:=GetNextNRec(tnWorkPattern,0);
  WorkPattern.BNight:=time(22,0,0,0);
  WorkPattern.ENight:=time(6,0,0,0);

  ClearBuffer(tnGP_WorkPatternExt);
  GP_WorkPatternExt.cWorkPattern:=WorkPattern.NRec;
}

cmCheckRecord  :
{
  WorkPattern.LastTime := Cur_Time;
  WorkPattern.LastDate := Cur_Date;
  WorkPattern.LastUser := UserName;
}

cmInsertRecord:{

  insert current WorkPattern;

  if (IsWorkPatternExtMod) {
    IsWorkPatternExtMod:=false;
    if (IsValidAll(tnWorkPattern))
      insert current GP_WorkPatternExt;
  }
}

cmDeleterecord :
{
  if (isprotected(#WorkPattern))
  {
    Message(chr(3)+'Запись корректируется другим пользователем',okButton);
    stop;
  }
  else
   if message('Удалить текущую запись?',yesno) = yes
   {
    delete safe SpWork;
    delete current WorkPattern;
   }
}

cmUpdateRecord:{

  update current WorkPattern;

  if (IsWorkPatternExtMod) {
    IsWorkPatternExtMod:=false;
    if (IsValidAll(tnGP_WorkPatternExt))
      update current GP_WorkPatternExt
    else if (WorkPattern.NRec<>0) {
      GP_WorkPatternExt.cWorkPattern:=WorkPattern.NRec;
      insert current GP_WorkPatternExt;
    }
  }
}

cmPick:{

  case CurField of
    #PreHolidayPattern.NameP:{
      var cRec:comp;
      cRec := GP_WorkPatternExt.cPreHolidayPattern;
      if (RunInterface('GP_WorkPattern', cRec) = cmDefault) {
        SetModified(true);
        IsWorkPatternExtMod:=true;
        set GP_WorkPatternExt.cPreHolidayPattern:=cRec;
      }
    }
  end;
}

cmDelOnProtect:{

  case CurField of
    #PreHolidayPattern.NameP:{
      if (GP_WorkPatternExt.cPreHolidayPattern<>0) {
        SetModified(true);
        IsWorkPatternExtMod:=true;
        set GP_WorkPatternExt.cPreHolidayPattern:=0;
      }
    }
  end;
}

cmCheckField:{
  case CurField of
    #GP_WorkPatternExt.StartBreak1,#GP_WorkPatternExt.EndBreak1,
    #GP_WorkPatternExt.StartBreak2,#GP_WorkPatternExt.EndBreak2,
    #GP_WorkPatternExt.StartShift2,#GP_WorkPatternExt.EndShift2:{
      SetModified(true);
      IsWorkPatternExtMod:=true;
    }
  end;
}


end; //handlevent browse
end; // panel

panel PSpWorkWnd;
table SpWork;
browse BrSpWorkWnd;
show at (,12,,);
 Fields
  NomerSm    'Номер','смены' ('Номер смены'):[5], noprotect;
  NameSmen   'Наименование',' смены ' ('Наименование смены'):[12], noprotect;
  tStart     'Время','начала' ('Время начала смены'):[5,'HH:MM'], noprotect;
  SpWork.tEnd 'Время','оконч.' ('Время окончания смены'):[5,'HH:MM'], noprotect;
  DayChas    'Дневн','Часы' ('Часы дневной смены'):[5], noprotect;
  DayMin     'Дневн','Мин.' ('Минуты дневной смены'):[5], noprotect;
  //EvnChas    'Вечер','Часы' ('Часы вечерней смены'):[5], noprotect;
 // EvnMin     'Вечер','Мин.' ('Минуты вечерней смены'):[5], noprotect;
  NightChas  'Ночн','Часы'  ('Часы ночной смены'):[5], noprotect;
  NightMin   'Ночн','Мин.'  ('Минуты ночной смены'):[5], noprotect;
  RazrChas   'Разр.','Часы' ('Разрыв смены часов'):[5], noprotect;
  RazrMin    'Разр.','Мин.' ('Разрыв смены минут'):[5], noprotect;
   GP_SpWorkExt.StartBreak1 'Начало','перерыва 1' ('Время начала перерыва 1'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  GP_SpWorkExt.EndBreak1 'Окончание','перерыва 1' ('Время окончания перерыва 1'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  GP_SpWorkExt.StartBreak2 'Начало','перерыва 2' ('Время начала перерыва 2'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  GP_SpWorkExt.EndBreak2 'Окончание','перерыва 2' ('Время окончания перерыва 2'):
    [11,'HH:MM'],NoProtect,NoAutoSize;
  GetWorkTime() 'Рабочее','время':[11,'HH:MM'],Protect,NoAutoSize,
     {Font={backcolor=if(CheckWorkTime(),0,ColorSysRed);color=if(CheckWorkTime(),0,ColorSysYellow)}};
end; //browse
HandleEvent

cmSetDefault   :
{
  ClearBuffer(#SpWork);
  SelectField(#SpWork.NomerSm);
  SpWork.cWorkPattern := WorkPattern.Nrec;

   var NightMinutes,DayMinutes:longint;
  var SpWorkCount:longint=0;
  _loop GP_SpWork where((WorkPattern.NRec==GP_SpWork.cWorkPattern)) SpWorkCount++;

  SpWork.NRec:=GetNextNRec(tnSpWork,0);

  if (SpWorkCount=0 or
      GP_WorkPatternExt.StartShift2=ZeroTime or GP_WorkPatternExt.EndShift2=ZeroTime) {
    SpWork.tStart:=WorkPattern.tStartDay;
    SpWork.tEnd:=WorkPattern.tEndDay;

    //Расчет часов
    DayMinutes:=0;
    NightMinutes:=0;
    if ((not (WorkPattern.tEndDay<WorkPattern.ENight) and
         WorkPattern.tStartDay>WorkPattern.ENight and
         WorkPattern.tEndDay<WorkPattern.BNight) //Вариант 1, день, день
       or (WorkPattern.BNight=ZeroTime and WorkPattern.ENight=ZeroTime)) {//или нет ночных
      DayMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.tEndDay,WorkPattern.tStartDay))/6000);
    }
    else if (not (WorkPattern.tEndDay<WorkPattern.ENight) and
             WorkPattern.tStartDay>WorkPattern.ENight and
             not (WorkPattern.tEndDay<WorkPattern.BNight) and
             WorkPattern.tStartDay<WorkPattern.BNight and
             WorkPattern.tEndDay>WorkPattern.BNight) {//Вариант 2, день, ночь
      DayMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.BNight,WorkPattern.tStartDay))/6000);
      NightMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.tEndDay,WorkPattern.BNight))/6000);
    }
    else if (not (WorkPattern.tEndDay<WorkPattern.ENight) and
             not (WorkPattern.tStartDay>WorkPattern.ENight) and
             WorkPattern.tEndDay<WorkPattern.BNight) {//Вариант 3, ночь, день
      DayMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.tEndDay,WorkPattern.ENight))/6000);
      NightMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.ENight,WorkPattern.tStartDay))/6000);
    }
    else if (not (WorkPattern.tEndDay<WorkPattern.ENight) and
             not (WorkPattern.tStartDay>WorkPattern.ENight) and
             not (WorkPattern.tEndDay<WorkPattern.BNight)) {//Вариант 4, ночь, ночь
      DayMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.BNight,WorkPattern.ENight))/6000);
      NightMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.ENight,WorkPattern.tStartDay))/6000);
      NightMinutes+=longint(To_Sec100(Sub_Time(WorkPattern.tEndDay,WorkPattern.BNight))/6000);
    }
    else if (WorkPattern.tEndDay<WorkPattern.ENight and
             not (WorkPattern.tStartDay>WorkPattern.ENight) and
             WorkPattern.tEndDay<WorkPattern.BNight) {//Вариант 5, ночь, ночь
      NightMinutes:=longint(To_Sec100(WorkPattern.tEndDay)/6000);
    }
    else if (not (WorkPattern.tEndDay<WorkPattern.ENight) and
             WorkPattern.tStartDay>WorkPattern.ENight and
             not (WorkPattern.tEndDay<WorkPattern.BNight) and
             not (WorkPattern.tStartDay<WorkPattern.BNight)) {//Вариант 6, ночь, ночь
      NightMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.tEndDay,WorkPattern.tStartDay))/6000);
    }

    var NightBreakMinutes,DayBreakMinutes:longint;
    NightBreakMinutes:=0;
    DayBreakMinutes:=0;
    if ((GP_WorkPatternExt.StartBreak1>WorkPattern.ENight and
         GP_WorkPatternExt.EndBreak1<WorkPattern.BNight) //Вариант 1, день, день
        or (WorkPattern.BNight=ZeroTime and WorkPattern.ENight=ZeroTime)) {//или нет ночных
      DayBreakMinutes:=longint(To_Sec100(Sub_Time(GP_WorkPatternExt.EndBreak1,GP_WorkPatternExt.StartBreak1))/6000);
    }
    else if (GP_WorkPatternExt.StartBreak1>WorkPattern.ENight and
             not (GP_WorkPatternExt.EndBreak1<WorkPattern.BNight) and
             not (GP_WorkPatternExt.StartBreak1>WorkPattern.BNight)) {//Вариант 2, день, ночь
      DayBreakMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.BNight,GP_WorkPatternExt.StartBreak1))/6000);
      NightBreakMinutes:=longint(To_Sec100(Sub_Time(GP_WorkPatternExt.EndBreak1,WorkPattern.BNight))/6000);
    }
    else if (not (GP_WorkPatternExt.EndBreak1<WorkPattern.ENight) and
             not (GP_WorkPatternExt.StartBreak1>WorkPattern.ENight)) {//Вариант 3, ночь, день
      DayBreakMinutes:=longint(To_Sec100(Sub_Time(GP_WorkPatternExt.EndBreak1,WorkPattern.ENight))/6000);
      NightBreakMinutes:=longint(To_Sec100(Sub_Time(WorkPattern.ENight,GP_WorkPatternExt.StartBreak1))/6000);
    }
    else if (GP_WorkPatternExt.EndBreak1<WorkPattern.ENight and
             GP_WorkPatternExt.EndBreak1>GP_WorkPatternExt.StartBreak1) {//Вариант 5, ночь, ночь
      NightBreakMinutes:=longint(To_Sec100(Sub_Time(GP_WorkPatternExt.EndBreak1,GP_WorkPatternExt.StartBreak1))/6000);
    }
    else if (GP_WorkPatternExt.StartBreak1>WorkPattern.BNight and
             GP_WorkPatternExt.EndBreak1>GP_WorkPatternExt.StartBreak1) {//Вариант 6, ночь, ночь
      NightBreakMinutes:=longint(To_Sec100(Sub_Time(GP_WorkPatternExt.EndBreak1,GP_WorkPatternExt.StartBreak1))/6000);
    }

    DayMinutes-=DayBreakMinutes;
    NightMinutes-=NightBreakMinutes;

    SpWork.DayChas:=DayMinutes div 60;
    SpWork.DayMin:=DayMinutes mod 60;
    SpWork.NightChas:=NightMinutes div 60;
    SpWork.NightMin:=NightMinutes mod 60;

    SpWork.RazrChas:=(DayBreakMinutes+NightBreakMinutes) div 60;
    SpWork.RazrMin:=(DayBreakMinutes+NightBreakMinutes) mod 60;

    ClearBuffer(tnGP_SpWorkExt);
    GP_SpWorkExt.cSpWork:=SpWork.NRec;
    GP_SpWorkExt.StartBreak1:=GP_WorkPatternExt.StartBreak1;
    GP_SpWorkExt.EndBreak1:=GP_WorkPatternExt.EndBreak1;
    GP_SpWorkExt.StartBreak2:=GP_WorkPatternExt.StartBreak2;
    GP_SpWorkExt.EndBreak2:=GP_WorkPatternExt.EndBreak2;
    IsSpWorkExtMod:=true;
  } else {//Смена 2
    SpWork.tStart:=GP_WorkPatternExt.StartShift2;
    SpWork.tEnd:=GP_WorkPatternExt.EndShift2;

    //Расчет часов
    NightMinutes:=0;
    if (SpWork.tStart>WorkPattern.BNight or
        SpWork.tEnd<WorkPattern.ENight) {
      if (SpWork.tStart>WorkPattern.BNight)
        NightMinutes+=longint(To_Sec100(Sub_Time(Time(24,0,0,0),SpWork.tStart))/6000);
      if (SpWork.tEnd<WorkPattern.ENight)
        NightMinutes+=longint(To_Sec100(SpWork.tEnd)/6000);
    }

    SpWork.NightChas:=NightMinutes div 60;
    SpWork.NightMin:=NightMinutes mod 60;
  }
}

cmCheckRecord  :
{
  SpWork.LastTime := Cur_Time;
  SpWork.LastDate := Cur_Date;
  SpWork.LastUser := UserName;
}

cmCheckField :
{
  case Curfield of
    #SpWork.DayMin:
      if (SpWork.DayMin > 59) or (SpWork.DayMin < 0)
      {
        Message('Количество дневных минут работы должно быть в пределах часа.', Information);
        set SpWork.DayMin := double(OldFieldValue);
        abort;
      }
    #SpWork.EvnMin:
      if (SpWork.EvnMin > 59) or (SpWork.EvnMin < 0)
      {
        Message('Количество вечерних минут работы должно быть в пределах часа.', Information);
        set SpWork.EvnMin := double(OldFieldValue);
        abort;
      }
    #SpWork.NightMin:
      if (SpWork.NightMin > 59) or (SpWork.NightMin < 0)
      {
        Message('Количество ночных минут работы должно быть в пределах часа.', Information);
        set SpWork.NightMin := double(OldFieldValue);
        abort;
      }
    #SpWork.RazrMin:
      if (SpWork.RazrMin > 59) or (SpWork.RazrMin < 0)
      {
        Message('Количество минут разрыва работы должно быть в пределах часа.', Information);
        set SpWork.RazrMin := double(OldFieldValue);
        abort;
      }
     #tStart:
        if tStart> time(24, 0, 0,0)
          {
          message('Время начала не может быть больше 24 часов', Error);
          set tStart:= time(0, 0, 0, 0);
          abort;
          }
     #SpWork.tEnd:
      if SpWork.tEnd> time(24, 0, 0,0)
        {
        message('Время окончания не может быть больше 24 часов', Error);
        set SpWork.tEnd:= time(24, 0, 0, 0);
        abort;
        }
  end;

  case CurField of
    #GP_SpWorkExt.StartBreak1,#GP_SpWorkExt.EndBreak1,
    #GP_SpWorkExt.StartBreak2,#GP_SpWorkExt.EndBreak2:{
      SetModified(true);
      IsSpWorkExtMod:=true;
    }
  end;
}


cmInsertRecord:{

  insert current SpWork;

  if (IsSpWorkExtMod) {
    IsSpWorkExtMod:=false;
    if (IsValidAll(tnSpWork))
      insert current GP_SpWorkExt;
  }
}

cmDeleterecord :
  if (isprotected(#SpWork))
  {
    Message(chr(3)+'Запись корректируется другим пользователем',okButton);
    stop;
  }
  else
    delete current SpWork;


cmUpdateRecord:{

  update current SpWork;

  if (IsSpWorkExtMod) {
    IsSpWorkExtMod:=false;
    if (IsValidAll(tnGP_SpWorkExt))
      update current GP_SpWorkExt
    else if (SpWork.NRec<>0) {
      GP_SpWorkExt.cSpWork:=SpWork.NRec;
      insert current GP_SpWorkExt;
    }
  }
}

end; //handlevent browse
end; // panel
HandleEvent
cmInit :  {};
end; //HandleEvent
end; // window

panel PWorkPattern;
browse BrWorkPattern;
show at (,,,11);
table WorkPattern;
 Fields
  Code  'Код' ('Код календаря'):[5], protect;
  NameP 'Наименование шаблона' ('Наименование шаблона'):[20], protect;
  KolSmen   'Кол-во','смен'  ('Количество смен'):[6], protect;
  tStartDay 'Время','начала' ('Время начала рабочего дня'):[5,'HH:MM'], protect;
  tEndDay   'Время','оконч.' ('Время окончания рабочего дня'):[5,'HH:MM'], protect;

  GP_WorkPatternExt.StartBreak1 'Начало','перерыва 1' ('Время начала перерыва 1'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  GP_WorkPatternExt.EndBreak1 'Окончание','перерыва 1' ('Время окончания перерыва 1'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  GP_WorkPatternExt.StartBreak2 'Начало','перерыва 2' ('Время начала перерыва 2'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  GP_WorkPatternExt.EndBreak2 'Окончание','перерыва 2' ('Время окончания перерыва 2'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  GP_WorkPatternExt.StartShift2 'Начало','смены 2' ('Время начала смены 2'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  GP_WorkPatternExt.EndShift2 'Окончание','смены 2' ('Время окончания смены 2'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  PreHolidayPattern.NameP 'Шаблон предпраздничного дня' ('Шаблон предпраздничного дня'):
    [30],Protect,NoDel;
end; //browse

browse BrSpWork;
show at (,12,,);
table SpWork;
 Fields
  NomerSm    'Номер','смены' ('Номер смены'):[5], protect;
  NameSmen   'Наименование',' смены ' ('Наименование смены'):[12], protect;
  tStart     'Время','начала' ('Время начала смены'):[5,'HH:MM'], protect;
  SpWork.tEnd 'Время','оконч.' ('Время окончания смены'):[5,'HH:MM'], protect;
  DayChas    'Дневн','Часы' ('Часы дневной смены'):[5], protect;
  DayMin     'Дневн','Мин.' ('Минуты дневной смены'):[5], protect;
 // EvnChas    'Вечер','Часы' ('Часы вечерней смены'):[5], protect;
  //EvnMin     'Вечер','Мин.' ('Минуты вечерней смены'):[5], protect;
  NightChas  'Ночн','Часы'  ('Часы ночной смены'):[5], protect;
  NightMin   'Ночн','Мин.'  ('Минуты ночной смены'):[5], protect;
  RazrChas   'Разр.','Часы' ('Разрыв смены часов'):[5],  protect;
  RazrMin    'Разр.','Мин.' ('Разрыв смены минут'):[5],  protect;
   GP_SpWorkExt.StartBreak1 'Начало','перерыва 1' ('Время начала перерыва 1'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  GP_SpWorkExt.EndBreak1 'Окончание','перерыва 1' ('Время окончания перерыва 1'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  GP_SpWorkExt.StartBreak2 'Начало','перерыва 2' ('Время начала перерыва 2'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  GP_SpWorkExt.EndBreak2 'Окончание','перерыва 2' ('Время окончания перерыва 2'):
    [11,'HH:MM'],Protect,NoDel,NoAutoSize;
  GetWorkTime() 'Рабочее','время':[11,'HH:MM'],Protect,NoAutoSize;
end; //browse
HandleEvent

cmPositionChanged:
    case curfield of
     #Code, #NameP, #KolSmen, #tStartDay, #tEndDay:
       LockCurrent(#WorkPattern);
     else    LockCurrent(#SpWork);
    end; // case
end; //handlevent browse
end; // panel
HandleEvent
cmInit   :
 {
  if getfirst WorkPattern <> 0
   if message(''#3'В классификаторе нет записей. Ввести?', yesno) = yes
   {
     PutCommand(cmInsert);
     PutCommand(cmEdit);
   }
   else abort;
  if (getfirst WorkPattern where ((prrec == WorkPattern.NRec)) <> tsOk) {};

  SelectField(#WorkPattern.NameP);
 };

cmProtectedInput :
 {
   Message(chr(3)+'Запись корректируется другим пользователем',okButton);
   Stop;
 }

cmEdit    : RunWindow(wWorkPattern);

cmAlt1    :
{
 var recpar : comp;
 recpar := 0;
 RunInterface('SpWorkSel', WorkPattern.Nrec, recpar);
 if recpar <> 0 then
  if getfirst SpWorkS where (( recpar == SpWorkS.Nrec)) = tsOk
    message('Выбрали номер смены '+string(SpWorkS.NomerSm));
}

cmDefault :
{
 prrec := WorkPattern.Nrec;
 CloseInterface(cmDefault);
}

end; //handlevent
end.
