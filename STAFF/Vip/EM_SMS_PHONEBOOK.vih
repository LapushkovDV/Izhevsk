#ifndef __EM_SMS_PhoneBook__
#define __EM_SMS_PhoneBook__

#component "EM"
#doc
Работа с мобльными телефонами и СМС
#end
const
 coMask_MobilePhone = '+7([0~9][0~9][0~9])[0~9][0~9][0~9]-[0~9][0~9][0~9][0~9]';
end;
vipinterface SMS_PhoneBook;
Public:
//-------------------------------------
#doc
Работа с телефнным справочником - именно отсюда на сайт уходит все
#end
 Procedure WorkWithPhoneBook(_pShowMobile : boolean);
#doc
Работа с мобильными телефонами
#end
 Procedure WorkWithMobilePhones;
//-------------------------------------
#doc
Выбор сотрудников для рассылки СМС - видны все телефоны
если _pMarkerName пустой, от сгенерим внутри
#end
Function SelectPersonsWithPhones(var _pMarkerName : string) : boolean;
end;
