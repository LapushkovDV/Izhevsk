#include Query.vih
#include GetKau.vih
#include Marker.vih

#component 'GP_Staff'

#doc
Настройки МТО

Эргономично пытаемся сделать администрирование настроек

#end
const
 coTune_CanApproveAbsent = 'NPOEM_OWN.SCUD.CANAPPROVEABSENTMORETHEN2475'; // Не разрешать утверждать заявления на отсутствие в случае, если в месяце уже взято часов более
 coTune_CanApproveRPD190 = 'NPOEM_OWN.SCUD.CANINSERTRPD190AFTERWEDNESDAY'; //  Создание РПД190 после 16-00 среды
 coTune_CanApproveAbsentNPP = 1;  // номер в массиве
 coTune_CanApproveRPD190NPP = 2; // номер в массиве

 coFilial_EM = 10;
end;

Interface EM_ViewChangeTunesSTAFF 'Настройки, СКУД' ;

table struct tTunesBUPers
(
   FIO           : string
  ,cPers         : comp
  ,APPDATE       : date
  ,DISDATE       : date
  ,Loginname     : string
  ,PodrKOd       : string
  ,cxUsers       : comp
  ,TuneName      : Array[1..2] of String
  ,TuneValDouble : Array[1..2] of double
)
with index
(
   Ind1 = FIO
 , Ind2 = cPers
 , ind3 = cxUsers
)
;
create view
#include GetKau.var
  pMarker: IMarker(marker) new;
   _setAbsent : byte ;
// , _setRPD190  : byte;
   _Absent   : double;
//   _RPD190 : word;

from
   TTUNESBUPERS
 , TTUNESBUPERS TTUNESBUPERS_del
 , x$users
 , KatPOdr
 , Persons
;

function  getnamepodr(_cPodr : comp) : string; cacheable;
{
  result := '';
 if getfirst fastfirstrow katpodr where ((_cPodr == katpodr.nrec)) = tsOK
  then result := katpodr.kod + ', ' + katpodr.name;
}
/*
function  GetNamePers(_Main: comp) : string; cacheable ;
{
  result := '';
 if getfirst fastfirstrow persons where ((_Main == persons.nrec)) = tsOK
  then  result := persons.fio;

}
*/

procedure FilltTuneValues;
{
  delete all TTUNESBUPERS_del;
  StartNewVisual(vtRotateVisual, vfTimer,'Актуализация остатков по счетам МЦ', 0);


  _loop x$users Where ((coFilial_EM == x$users.XU$USEROFFICE))
   {
    SetVisualHeader('Просмотр настроек пользователей'+
      +''#13'' +x$users.xu$loginname)   ;

       clearbuffer(tnTTUNESBUPERS_del);
         TTUNESBUPERS_del.FIO         := x$users.XU$FULLNAME;
          var _cPers : comp = CoGetTuneEx('USER.PERSON',x$users.XU$USEROFFICE,x$users.atl_nrec);
           if getfirst fastfirstrow  Persons where ((_cPers == Persons.nrec))  = tsOK
            {
             TTUNESBUPERS_del.FIO         := persons.Fio;
             TTUNESBUPERS_del.APPDATE     := persons.APPDATE;
             TTUNESBUPERS_del.DISDATE     := persons.DISDATE;
             TTUNESBUPERS_del.PodrKOd     := getnamepodr(persons.galdep)
            }
          TTUNESBUPERS_del.cPers       := _cPers;
          TTUNESBUPERS_del.cxUsers     := x$users.atl_nrec;
          TTUNESBUPERS_del.Loginname   := x$users.xu$loginname;
          TTUNESBUPERS_del.TuneValDouble[coTune_CanApproveAbsentNPP]  := doGetTuneEx(coTune_CanApproveAbsent,x$users.XU$USEROFFICE,x$users.atl_nrec);
//          TTUNESBUPERS_del.TuneValDouble[coTune_CanApproveRPD190NPP]  := wGetTuneEx(coTune_CanApproveRPDf190 ,x$users.XU$USEROFFICE,x$users.atl_nrec);
         insert current TTUNESBUPERS_del;

   }
  StopVisual;
  cfsSetProp('c_BRPERS_TTUNESBUPERS.TuneValDouble[1]_Ф1' ,'Title'   , 'Ограничение на заявления на отсутствие, ч');
  cfsSetProp('c_BRPERS_TTUNESBUPERS.TuneValDouble[1]_Ф1' ,'HelpLine', 'Ограничение на заявления на отсутствие, ч');

  cfsSetProp('c_BRPERS_TTUNESBUPERS.TuneValDouble[2]_Ф2' ,'Title'   , 'Утверждать РПД190 после 16-00 среды');
  cfsSetProp('c_BRPERS_TTUNESBUPERS.TuneValDouble[2]_Ф2' ,'HelpLine', 'Утверждать РПД190 после 16-00 среды');
  rescanPanel(tnTTUNESBUPERS);
}

browse brPERS (,,sci1Esc);
Show At (,,,) ;
Table TTUNESBUPERS ;
 recMarker=pMarker{TTUNESBUPERS.cxUsers}; // по умолчанию nrec юзается...
Fields
 TTUNESBUPERS.Loginname  'Loginname'       ('Loginname')       : [ 5], Protect,  noPickButton;
 TTUNESBUPERS.FIO        'ФИО'             ('Фио')             : [ 7], Protect,  noPickButton;
 TTUNESBUPERS.PodrKOd    'Подразделение'   ('Подразделение')   : [ 7], Protect,  noPickButton;
 TTUNESBUPERS.APPDATE    'Дата приема'     ('Дата приема')     : [ 7], Protect,  noPickButton;
 TTUNESBUPERS.DISDATE    'Дата увольнения' ('Дата увольнения') : [ 7], Protect,  noPickButton;
// TTUNESBUPERS.isChanged  'Код МОЛ'             ('Код МОЛ')                                      : [ 7], NoProtect, NoAutoSize, noPickButton;
 TTUNESBUPERS.TuneValDouble[coTune_CanApproveAbsentNPP] 'Ф1' ('Ф1')  :[10.2,'\2p[|-]366`666`666`666`666.88'],Protect,  noPickButton;
// TTUNESBUPERS.TuneValDouble[coTune_BUHDATECLOSEPERIODNPP]  'Ф2' ('Ф2') : [ 7],Protect,  noPickButton;
end;

Procedure SetVisibleFieldsInWindow;
{
  cfsSetProp('i_SCRSETTUNES_ABSENT','Visible',(_setAbsent = 1)) ;
//  cfsSetProp('i_SCRSETTUNES_DATEOPER','Visible',(_setOper = 1));
}

procedure MySetTunes;
{

  var MyMarkerDocs :longint= InitMarker('', 8, 100, 10);
  ClearMarker(MyMarkerDocs);
  pMarker.ExportTo(MyMarkerDocs);
  var lKol : longint = getmarkercount(MyMarkerDocs);
  if lKol <1
  {
    Message('Пометьте хотя бы одну запись',error);
    stop; abort; exit;
  }

  var lIdx : longint = 0;
  StartNewVisual(vtIndicatorVisual,vfTimer + vfConfirm+vfBreak,'Установка настроек',lKol);
//  var _Sum : double = 0;
   while lIdx < lKol
    {
     if not nextVisual then
      {
       break
      };
      var _crec : comp = 0h;
      GetMarker(MyMarkerDocs, lIdx, _crec);

      if _setAbsent  = 1 then doSetTuneEx(coTune_CanApproveAbsent, coFilial_EM, _crec, _Absent);
//      if _setBU    = 1 then dSetTuneEx(coTune_BUHDATECLOSEPERIOD , coFilial_EM, _crec, _dateBU);

      lIdx++;
    }
  stopvisual;
  DoneMarker(MyMarkerDocs,'');
  FilltTuneValues
}
Window winSetTunes 'Установить настройки';
show at(,, 60,5);
Screen scrSetTunes  (,, sci1Esc);
noTableNavigation;
fields
 _setAbsent  : NoProtect;
 _Absent :['\2p[|-]366`666`666`666`666.88'], NoProtect;
buttons
 cmOk, Default,, 'Ввод - принять выбор',, sci1Esc;
 cmCancel;
<< 'Установить настройки '
    [.] - ограничение на заявления на отсутвтие: ` .@@@@@@@


   <.Установить.>      <. Отмена .>
>>
end;
Windowevent winSetTunes;
cmInit:
{
 SetVisibleFieldsInWindow;
 _setAbsent := 0;
 _Absent   := TTUNESBUPERS.TuneValDouble[coTune_CanApproveAbsentNPP];

}
cmOK:
{
 if ( _setAbsent =  0)
     {
      Message('Не выбрано какую астройку устанавливать',error);
      stop; abort; exit;
     }
  if ( _setAbsent = 1 and _setAbsent = 0)

     {
      Message('Нельзя устанавливать нулевые данные',error);
      stop; abort; exit;
     }
  var _cxUsers : comp = TTUNESBUPERS.cxUsers;
  MySetTunes;
 if getfirst TTUNESBUPERS where ((_cxUsers == TTUNESBUPERS.cxUsers)) = tsOK
  {
  }
  closewindow(winSetTunes);
}
end;
end;

handleevent
cmInit:
{
 FilltTuneValues;
}
//cmAddNewRec:   PutCommand(cmInsert);
cmCheckField:
{
  SetVisibleFieldsInWindow;
}

cmValue1:
{
 if pMarker.Count < 1 then
  {
    Message('Пометьте хотя бы одну запись',error);
    stop; abort; exit;
  }
  runwindowModal(winSetTunes);
}
cmHotKeys:
{
 PutHotCommand(RunMenu('EM_mnuEM_ViewChangeTunesSTAFF'));
}
cmValue20:   // Переместить/извлечь в архив
{
   FilltTuneValues;
}
cmDelOnProtect:
{
}
end;
end.
EM_mnuEM_ViewChangeTunesSTAFF Menu
{
- 'Установить значения по выделенным позициям',cmValue1,'', ,'',,sci1Esc;
---------;
- 'Обновить данные',cmValue20,'FilltTuneValues', ,'',,sci1Esc;
}
