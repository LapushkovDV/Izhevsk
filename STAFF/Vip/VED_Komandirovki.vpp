DataStream VED_Komandirovki_DTS
(
  //данные <нулевого> уровня - общие переменные отчета, заголовок и т. п.
  [Date_Rep]  Cur_Date;
  [User_Name] UserName;
  //Данные логической таблицы.
  //Вложенность таблиц определяется логической таблицей интерфейса,
  //и задает структуру FR-отчета (MasterData, DetailData)
  dataset DS_Komandirovka
  (
    table tKomandirovka
     (
      [NoDoc        ]   tKomandirovka.NoDoc         ;
      [statusPrikaza]   tKomandirovka.statusPrikaza ;
      [dDoc         ]   tKomandirovka.dDoc          ;
      [target       ]   target                      ;
      [Primechanie  ]   Primechanie                 ;
      [DSTART       ]   tKomandirovka.DSTART        ;
      [dEnd         ]   tKomandirovka.dEnd          ;
      [Zakaz        ]   tKomandirovka.Zakaz         ;
      [DatePribyt   ]   tKomandirovka.DatePribyt    ;
      [DateVibyt    ]   tKomandirovka.DateVibyt     ;
      [fio          ]   tKomandirovka.fio           ;
      [podrKod      ]   tKomandirovka.podrKod;
      [PostName     ]   tKomandirovka.PostName;
      [Strana       ]   tKomandirovka.Strana        ;
      [Gorod        ]   tKomandirovka.Gorod         ;
      [mesto        ]   tKomandirovka.mesto         ;
      [MobPhone     ]   tKomandirovka.MobPhone      ;
      [Hotel        ]   tKomandirovka.Hotel         ;
      [HotelNum     ]   tKomandirovka.HotelNum      ;
      [VisaNomer    ]   tKomandirovka.VisaNomer     ;
      [VisabegDate  ]   if(tKomandirovka.VisabegDate <> date(0,0,0),dateToStr(tKomandirovka.VisabegDate,'DD/MM/YYYY'),'')   ;
      [VisaEnddate  ]   if(tKomandirovka.VisaEnddate <> date(0,0,0),dateToStr(tKomandirovka.VisaEnddate,'DD/MM/YYYY'),'')   ;
      [FOTO]            Appendix.Contents;
     );
  );
  //GroupMC
)
HandleEvent DataSet DS_Komandirovka
cmPreProcess:
{
  if getfirst tKomandirovka <> tsOK then Abortprocess;
 StartNewVisual(vtRotateVisual,vfTimer+vfBreak+vfConfirm, 'Печать отчета', 0);

}
cmOnProcess:
{
  if getnext tKomandirovka <> tsOK
    then breakprocess
    else ContinueDataset;
 if (not NextVisual) then BreakProcess;
 SetVisualHeader('Печать отчета'
          + ''#13'' + tKomandirovka.Fio);

}
cmPostProcess:
{
  StopVisual('', 0);
}
end;
end; //dataStream
