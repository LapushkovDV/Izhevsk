#include GP_SpWorkExt.vih
interface GP_SpWorkExt;

create view ltSpWorkExt
from
  GP_SpWorkExt;

function DelRec(cSpWork:comp):boolean;
{
  result:=delete GP_SpWorkExt where((cSpWork==GP_SpWorkExt.cSpWork))=tsok;
}

HandleEvent
cmInit:abort;
end;

end.

//Для поддержания ссылочной целостности
handler with replace GP_SpWorkExtDelete on trigger SpWork before Delete [99]
action
{
  var buf : record as table SpWork;
  GetTableBuffer(buf);

  var oSpWorkExt:GP_SpWorkExt;
  result:=oSpWorkExt.DelRec(buf.NRec);
}
