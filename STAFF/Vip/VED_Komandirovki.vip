const
 coZagranPassportSysCode = 503 ; // Загранпаспорт гражданина РФ
end;

#doc
EM::VED_Docs_Zagran
Просмотр командировок сотрудников с аналитикой
#end
const
 coAttrVisa_Visadays   = 'Количество дней';
 coAttrVisa_VisaNumber = 'Номер';
end;
//************************************************************
Interface VED_Komandirovki 'ВЭД. Интерфейс просмотра командировок сотрудников с аналитиками' (,,sci17EnEsc), EscClose;
//************************************************************
Show At (,,120,30)
//----------------------------------------
table struct tKomandirovka
(
    PersNrec       : comp
  , PrikazNrec     : comp
  , NoDoc          : string
  , statusPrikaza  : string
  , dDoc           : date
  , target         : string
  , Primechanie    : string
  , yearDoc        : string
  , DSTART         : date
  , dEnd           : date
  , Zakaz          : string
  , DatePribyt     : date
  , DateVibyt      : date
  , fio            : string
  , podrKod        : string
  , PostName       : string
  , Strana         : string
  , Gorod          : string
  , mesto          : string
  , MobPhone       : string
  , HotelNum       : string
  , Hotel          : string
  , VisabegDate    : date
  , VisaEnddate    : date
  , VisaNomer      : string
)
with index
(
 ind0 =  PersNrec
)
;
Create View
 var _date : date;
 select tKomandirovka.PersNrec
 from tKomandirovka
 , Appendix
where ((       1        == Appendix.ObjBlock
        and  tKomandirovka.PersNrec  == Appendix.Person
        and       200   == Appendix.ObjType
      ))
;

Screen scrKomandirovka
show at (,,,1);
fields
 _date : noprotect;
<<
  Минимальная дата просмотра командировок .@@@@@@@@@@@@
>>
end;
#include VED_Komandirovki.vpp
Browse brKomandirovka 'Ведение загран. документов' (,,sci1Esc)
show at (,2,110,);
Table tKomandirovka
 FIELDS
   NoDoc          'Номер','приказа' ('Номер приказа на командировку')   : [3] ,Protect,NoDel;
//   statusPrikaza  'Статус','приказа' ('Статус приказа на командировку')   : [4] ,Protect,NoDel;
   dDoc           'Дата приказа' ('Дата приказа на командировку')   : [3] ,Protect,NoDel;
   DSTART         'Дата начала','командировки' ('Дата начала командировки')   : [3] ,Protect,NoDel;
   dEnd           'Дата окончания','командировки' ('Дата окончания командировки')   : [3] ,Protect,NoDel;
   Zakaz          'номер заказа','командировки' ('Номер заказа командировки')   : [4] ,Protect,NoDel;
   DatePribyt     'Дата прибытия','на место' ('Дата прибытия на место')   : [3] ,Protect,NoDel;
   DateVibyt      'Дата выбытия','с места' ('Дата выбытия с места')   : [3] ,Protect,NoDel;
   fio            'ФИО','сотрудника' ('ФИО сотрудника')   : [6] ,Protect,NoDel;
   podrKod        'Подразделение' ('Подразделение работника')   : [3] ,Protect,NoDel;
   PostName       'Должность' ('должность работника')   : [3] ,Protect,NoDel;
   Strana         'Страна','командировки' ('Страна командировки')   : [5] ,Protect,NoDel;
   Gorod          'Город','командировки' ('город командировки')   : [5] ,Protect,NoDel;
   mesto          'Место назначения','командировки' ('Место назначения командировки')   : [6] ,Protect,NoDel;
   MobPhone       'Мобильный телефон' ('Мобильный телефон в командировке')   : [4] ,Protect,NoDel;
   Hotel          'Отель' ('Название отеля в командировке')   : [7] ,Protect,NoDel;
   HotelNum       'Номер отеля' ('Номер отеля в командировке')   : [4] ,Protect,NoDel;
   VisaNomer      'Виза номер' ('номер визы, которая попадает в период командировки в эту страну')   : [4] ,Protect,NoDel;
   VisabegDate    'Виза','начало' ('Дата начала действия визы, которая попадает в период командировки в эту страну')   : [3] ,Protect,NoDel;
   VisaEnddate    'Виза','окончание' ('Дата окончания действия визы, которая попадает в период командировки в эту страну')   : [3] ,Protect,NoDel;
end;//Browse

Text Appendix.Contents: PanelLast;
  show at (111,2,, 8);

procedure FilltKomandirovka;
{
  _try
   {
        sql
          select
            Pers.nrec as PersNrec
          , PrSrc.nrec as PrikazNrec
          , PrSrc.NODOC as NoDoc
          , StatusPrik.name as statusPrikaza
          , PrSrc.DDOC as dDoc
          , case when PrSrc.wAttr = 0 then PrSrc.name    else PrSp.name    end as target
          , case when PrSrc.wAttr = 0 then PrSrc.Osnov   else PrSp.Osnov   end as Primechanie
          , case when PrSrc.wAttr = 0 then PrSrc.YEARDOC else PrSp.YEARDOC end as yearDoc
          , case when PrSrc.wAttr = 0 then PrSrc.DSTART  else PrSp.DSTART  end as DSTART
          , case when PrSrc.wAttr = 0 then PrSrc.DEND    else PrSp.DEND    end as dEnd
          , Zakaz.number as Zakaz
          , AvdatPribyt.vDate as DatePribyt
          , AvdatVibyt.vDate  as DateVibyt
          , pers.fio as fio
          , kp.code as podrKod
          , post.name as PostName
          , KATSTATE.NAME as Strana
          , KatCity.name as Gorod
          , case when PrSrc.wAttr = 0 then PrSrc.MESTO else PrSp.MESTO end as mesto
          , AvMobPhone.vString as MobPhone
          , AvHotelNum.vString as HotelNum
          , AvHotel.vString as Hotel
          , Visa.BEGDATE as VisabegDate
          , Visa.ENDDATE as VisaEnddate
          , Visa.nomer as VisaNomer

          from Prikaz prSrc
          join spPrikaz on SpPrikaz.cPrikaz = PrSrc.nrec and SpPrikaz.tipdoc = 1
          left join prikaz prSp on PrSp.cSpPrikaz = spPrikaz.nrec and PrSp.TIPDOC = 2
          join Persons pers on pers.nrec = SpPrikaz.CPERSONS
          left join Catalogs KP on kp.nrec = pers.Department
          left join appointments app on app.nrec = Pers.appointCur
          left join catalogs post on post.nrec = app.post
          left join katnotes StatusPrik on StatusPrik.nrec = PrSrc.CSTATUS
          left join attrnam ANZakaz on ANZakaz.wtable = 9309 and ANZakaz.name = '.Шифр заказа'
          left join attrVal AvZakaz on AvZakaz.wtable = ANZakaz.wtable and AvZakaz.cattrnam = ANZakaz.nrec and AvZakaz.crec = spPrikaz.nrec
          left join MnPlan Zakaz on zakaz.nrec = AvZakaz.vComp
          left join attrnam ANdatVibyt on ANdatVibyt.wtable = 9308 and ANdatVibyt.name = 'Дата выбытия'
          left join attrVal AvdatVibyt on AvdatVibyt.wtable = ANdatVibyt.wtable and AvdatVibyt.cattrnam = ANdatVibyt.nrec and AvdatVibyt.crec = case when PrSrc.wAttr = 0 then PrSrc.nrec else PrSp.nrec end
          left join attrnam ANdatPribyt on ANdatPribyt.wtable = 9308 and ANdatPribyt.name = 'Дата прибытия'
          left join attrVal AvdatPribyt on AvdatPribyt.wtable = ANdatPribyt.wtable and AvdatPribyt.cattrnam = ANdatPribyt.nrec and AvdatPribyt.crec = case when PrSrc.wAttr = 0 then PrSrc.nrec else PrSp.nrec end
          left join KATSTATE on KATSTATE.Nrec = case when PrSrc.wAttr = 0 then PrSrc.cState else PrSp.cState end
          left join KATcity on KatCity.Nrec = case when PrSrc.wAttr = 0 then PrSrc.ccity else PrSp.CCITY end
          left join attrnam ANMobPhone on ANMobPhone.wtable = 9309 and ANMobPhone.name = 'Мобильный телефон'
          left join attrVal AvMobPhone on AvMobPhone.wtable = ANMobPhone.wtable and AvMobPhone.cattrnam = ANMobPhone.nrec and AvMobPhone.crec = spPrikaz.nrec
          left join attrnam ANHotelNum on ANHotelNum.wtable = 9309 and ANHotelNum.name = 'Номер отеля'
          left join attrVal AvHotelNum on AvHotelNum.wtable = ANHotelNum.wtable and AvHotelNum.cattrnam = ANHotelNum.nrec and AvHotelNum.crec = spPrikaz.nrec
          left join attrnam ANHotel on ANHotel.wtable = 9309 and ANHotel.name = 'Отель'
          left join attrVal AvHotel on AvHotel.wtable = ANHotel.wtable and AvHotel.cattrnam = ANHotel.nrec and AvHotel.crec = spPrikaz.nrec

          left join (select Passports.PERSON as cperson, VisaDrv.CSTATE as cState, VisaDrv.BEGDATE, VisaDrv.ENDDATE , avVisaNomer.vString as Nomer
                      from Passports
                        join VisaDrv on VisaDrv.CPASSPORTS = Passports.NREC
                        left join AttrNam anVisaNomer on anVisaNomer.name = 'Номер' and anVisaNomer.wtable = 12040
                        left join AttrVal avVisaNomer on avVisaNomer.wtable = anVisaNomer.wtable and avVisaNomer.cattrnam = anVisaNomer.nrec and avVisaNomer.crec = visadrv.nrec
                     where Passports.syscode = :(coZagranPassportSysCode)  // Загранпаспорт гражданина РФ
                        //and VisaDrv.BEGDATE between
                        //and VisaDrv.ENDDATE
                    ) visa  on visa.cperson = pers.nrec
                        and Visa.BEGDATE <= case when PrSrc.wAttr = 0 then PrSrc.DSTART  else PrSp.DSTART end
                        and Visa.ENDDATE >= case when PrSrc.wAttr = 0 then PrSrc.DEND    else PrSp.DEND   end
                        and Visa.cState   = case when PrSrc.wAttr = 0 then PrSrc.cState else PrSp.cState end

          where PrSrc.TIPDOC = 1 and PrSrc.CSPPRIKAZ = #comp(0h)
          and case when PrSrc.wAttr = 0 then PrSrc.DSTART  else PrSp.DSTART end >= :(_date) //#date(01,01,2019)
          into tKomandirovka;
   }
  _except
   else {}
  _finally{}
  if getfirst tKomandirovka = tsOK {}
  rereadrecord;
}
//------------------------------
//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
HandleEvent
    //-----------------------------
    cmInit:
    {
      set _date := date(01,01,year(cur_date));
      FilltKomandirovka;
      ReScanPanel(#tKomandirovka);
    }
    cmCheckField:
    {
      case curfield of
       #_date: {set _date := _date; FilltKomandirovka;}
      end;
    }
    cmHotKeys:
    {
        ProcessCommand(RunMenu('EM_VED_ZAGRAN_KOMANDIROVKI_HotKey'));
    }
    cmPrintDoc:
    {
      PushPos(#tKomandirovka);
      RunFReport(VED_Komandirovki_DTS, '', False); // false - выполнение, true - дизайнер
      poppos(#tKomandirovka);
      rereadrecord;
    }

end;
end.

EM_VED_ZAGRAN_KOMANDIROVKI_HotKey Menu
{
// - 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
 - 'Печать', cmPrintDoc,'Печать',,'Ctrl+P',kbCtrlP,sci1Esc;
}
