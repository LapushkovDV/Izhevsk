#component "Z_STAFF"
//******************************************************************************
Alter Interface iMedStaffList;
//******************************************************************************
OverLoad
  Datastream dsDangerStaffList;
End;
create view
from
 Catalogs CatalogsMed
;
Datastream dsDangerStaffList
(
  Table inherited::mtDangerStaffList
  (
    [DepatmentCode] if(getfirst persons where ((    '‘' == persons.isemployee
                                                  and 0 == persons.TABNMB
                           and mtDangerStaffList.sTabN  == persons.strtabn)) = tsOK, if(getfirst CatalogsMed where ((persons.Department ==  CatalogsMed.nrec)) = tsOK,CatalogsMed.code,''), '');

    [strtabn]       persons.strtabn;
  );
)
end;
END.
