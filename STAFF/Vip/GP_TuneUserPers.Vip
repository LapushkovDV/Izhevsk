#doc
Заполнение настройки "User.Pers"
<p>2018/03/16 Заполнение настройки "User.Person"
#end
Interface GP_TuneUserPers 'Заполнение настройки "User.Pers"';
create view
var
  sFio:string;
  pPers_Curr:comp;
  pPersons  :comp;
as select X$users.Atl_Nrec
From X$users,Persons
, Persons Pers_Curr
where
((
     'С'  == Persons.IsEmployee
and  sFio == Persons.Fio
and  pPers_Curr == Pers_Curr.Nrec
));

Procedure FormDoc;
var LObj:longint;
{ LObj:=0;
  //USER.PERS -> USER.PERSON
  _Loop x$users
  { NextVisual;
    lObj:=UserOfficeFilial(x$users.atl_nrec);
    sFio:=sGetTuneEx('USER.Fio',LObj,x$users.Atl_nrec);
    if sFio='' then continue;
    pPers_Curr:=coGetTuneEx('USER.PERSON',LObj,x$users.Atl_nrec);
    if pPers_Curr>0
    { if getfirst Pers_Curr=tsok
      { if Pers_Curr.Fio=sFio
          continue;
      }
    }
    if getfirst Persons=tsok
    { pPersons:=Persons.Nrec;
      if getNext Persons=tsok
      { pPersons:=0 ;
        continue;
      }
      coSetTuneEx('USER.PERSON',LObj,x$users.Atl_nrec,pPersons,sFio);
    }
  } //_Loop x$users
} //Procedure FormDoc;

HandleEvent
cmInit:
{ timelog_init;
  StartNewVisual(vtIndicatorVisual, vfTimer ,
          'Установка настройки User.Pers', RecordsInTable(#x$users));
  FormDoc;
  StopVisual('',0);
  CloseInterface(cmDone);
  abort;
  exit;
}
end;
end.
