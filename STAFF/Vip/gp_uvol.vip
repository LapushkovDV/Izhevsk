/*************************************************************************************************\
* Наименование:  Отчет по уволенным сотрудникам                                                   *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2524          |06/06/18 |Ермолов К.Р.            |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih
#include runstaj.vih
#include adrfunc.vih

interface gp_uvol 'Параметры отчета' gray
Show at (,,43,5);

table struct _tabl
(
p0: comp,
p1: string,
p2: word,
p3: string,
p4: string,
p5: string,
p6: string,
p7: date,
p8: date,
p9: decimal(31,15),
p10: string,
p11: double,
p12: date,
p13: string,
p14: string,
p15: integer,
p16: integer,
p17: integer,
p18: string,
p19: string,
p20: string,
p21: string,
p22: date,
p23: string,
p24: word,
p25: string,
p26: string,
p27: string,
p28: string,
p29: string,
p30: string,
p31: string,
p32: string,
ok3code : string,
phone: string,
dop3: string ,
uchstep: string
)
with index
(
i1 = p5
)
;

create view gp_uvol

var
_runstaj: RunStaj;
_addrfunc: AddressFunc;
_god, _mes, _day, _ugod, _umes, _uday, staj, ustaj, vozr: double;
counter, countpp, countermatrix: longint;
addr, excelpath, uchstep: string;
data1, data2: date;

select servlen.nrec from servlen, _tabl, persons, addressn, badge, catalogs, synonym catalogs cat1
where (('Стаж работы на предприятии' == cat1.name(noindex)));

screen scr ('Параметры отчета',,sci13Esc);
  fields
  data1, noprotect;
  data2, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    В период с:.@@@@@@@@@@  по:.@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  data1:= cur_date;
  data2:= cur_date;
}

cmGo:
{
StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

delete all from _tabl;

sql
select distinct
p.nrec,
  klsovm.nsovm as Nazn
, KlKat.kod as kategoria
, P.SEX as Sex
, AppKatPodr.Code as PodrKod
, p.fio as fio
, snils.nomer as snils
, P.APPDATE as appdate
, p.bornDate as BornDate
, App.TaxRate as Oklad
, '' as nachislenia
, round( cast((case when CDoc.wAttrDoc2 = 0 then App.dOrderDisDate else CDoc.dat1 end  - p.bornDate) as decimal )/(256*256),2) as Vozrast
, app.dismissdate as DisDate
, '' as do3xLet
, '' as stajNaUvolen // SLen.YearsB  + SLen.MonthsB/12 + SLen.DaysB/360
, 1 as LetNeprerivn
, 1 as MesNeprerivn
, 1 as DayNeprerivn
, '' as TekuchestFKA
, coalesce(ReasonDis.name, '') as ReasonDissmiss
, CDoc.SBOTTOM as RealReasonDissmiss
, TDOC.DOCNMB as PrikazNumber
, TDOC.DOCDATE as Prikazdate
, Doljnost.name as doljnost
, case when APP.cCat2 = #comp(0) then APP.CATEGORY else APP.cCat2 end as kval
, (select top 1 PsnSpAllStaff.ResString[1] as NoDog
                 from SpAllStaff PsnSpAllStaff
              left join Catalogs VidDog on VidDog.nrec = PsnSpAllStaff.ResComp[1]
            where PsnSpAllStaff.wNoCon = 5 and PsnSpAllStaff.cBaseT = p.nrec
  )as NoDog
, date2str(upper('%DD.%MM.%YYYY'),( select top 1 PsnSpAllStaff.ResDate[1]
                 from SpAllStaff PsnSpAllStaff
              left join Catalogs VidDog on VidDog.nrec = PsnSpAllStaff.ResComp[1]
            where PsnSpAllStaff.wNoCon = 5 and PsnSpAllStaff.cBaseT = p.nrec
            ) )as DateDog
, (select top 1 EduCat.Name
           from Education edu
            join catalogs EduCat on EduCat.nrec = edu.level
           where Edu.Person = p.nrec

           ) as vidObraz
, date2str(upper('%DD.%MM.%YYYY'),(select top 1 Edu.ToDate
           from Education edu
           where Edu.Person = p.nrec
            )) as DateObrazov
, addressn.saddress1 as fullAdress
, cat1.code
, cat1.name
, app.strtabn
, ok3.s
, comm.addr
, dop3.name
, uchstep.name
from persons p
join ContDoc CDoc on CDoc.PERSON = p.nrec
join Appointments app on CDoc.CSTR = app.nrec
left join communications comm on comm.person=p.nrec and comm.comtype=#comp(000A000000039960h)
left join lschet on lschet.nrec = app.caddnrec2
left join klsovm on klsovm.sovm = lschet.sovm
left join KlKatego KlKat on KlKat.nrec = App.EmpCategory
left join Catalogs AppKatPodr on AppKatPodr.nrec = app.Department
join PartDoc PDoc on CDoc.CPART = pdoc.nrec
join TitleDoc TDoc on PDoc.CDOC = tdoc.nrec
left join staffstruct shr on shr.nrec=app.staffstr
left join catalogs dop3 on dop3.nrec=shr.cinf3
left join badge bd10 on 10=bd10.badgemonth and p.nrec=bd10.person
left join badge bd2 on 2=bd2.badgemonth and p.nrec=bd2.person
left join catalogs uchstep on uchstep.nrec=coalesce(bd10.appoint,bd2.appoint)
left join (select Pasp.Nmb as nomer , Pasp.Person as cPersons
               from Passports Pasp
                  join catalogs cat on (Pasp.DocName = cat.nrec)
                  where cat.code = '102'
           ) snils on (p.nrec = snils.cPersons)

left join (select sLen.Person as person, sLen.Fromdate as fromdate, sLen.ToDate as ToDate ,sLen.rate as rate, cast(SLen.YearsB as double)as YearsB, cast(SLen.MonthsB as double) as MonthsB , cast(SLen.DaysB as double) as DaysB
                     from ServLen sLen
              join Catalogs SLPositionCat on  SLPositionCat.Nrec  = sLen.Position
              where SLen.CurRec = 1 and
              SLPositionCat.name = 'Стаж работы на предприятии'
          ) sLen on sLen.Person = p.nrec
left join catalogs ReasonDis on ReasonDis.nrec = app.CDISDASIS
left join Catalogs Doljnost on Doljnost.nrec = App.Post
left join addressn on addressn.nrec = p.liveaddr
left join catalogs cat1 on cat1.nrec = app.cdisreason
outer apply (
                select top 1
                  catok3.code as s
                from spallstaff spok3
                inner join catalogs catok3 on spok3.cbaset = catok3.nrec
                where spok3.clinkt = app.staffstr
                      and spok3.wnocon = 25018
                      and spok3.wchoise = 9876
) ok3
where
p.isEmployee in ('С', 'У') and
CDoc.TYPEOPER = 8
and PDoc.TYPEOPER = 8
and TDOC.WSTATUS = 1

and  app.dismissdate between :(data1) and :(data2)
into _tabl;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_uvol.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  xlsetcellstringvalue('УВОЛЕННЫЕ СОТРУДНИКИ НА ПЕРИОД С ' + data1 + ' ПО ' + data2, 1, 1, 1, 1);

    counter:= 3;
    countpp:= 0;
    countermatrix:= 0;

    xlCreateMatrix(100, 35);

  _loop _tabl
  {
    countpp++;
    countermatrix++;
    _loop persons where ((_tabl.p0 == persons.nrec))
    {
      vozr:= (year(_tabl.p12)-year( persons.borndate)) + (month(_tabl.p12) - month( persons.borndate))/12 + (day(_tabl.p12) - day( persons.borndate))/365;

      _loop servlen where ((persons.nrec == servlen.person and cat1.nrec == servlen.position (noindex) and 1 == servlen.currec (noindex) ))
      {

          _ugod:= _runstaj.NGetStajYears(persons.nrec, servlen.position, _tabl.p12);
          _umes:= _runstaj.NGetStajMonths(persons.nrec, servlen.position, _tabl.p12);
          _uday:= _runstaj.NGetStajDays(persons.nrec, servlen.position, _tabl.p12);
          ustaj:= _ugod + (_umes/12) + (_uday/365);

          _god:= _runstaj.NGetStajYears(persons.nrec, servlen.position, cur_date);
          _mes:= _runstaj.NGetStajMonths(persons.nrec, servlen.position, cur_date);
          _day:= _runstaj.NGetStajDays(persons.nrec, servlen.position, cur_date);
          staj:= _god + (_mes/12) + (_day/365);
      }

      _loop addressn where ((persons.liveaddr == addressn.nrec))
      {
        addr:= _addrfunc.GetFullAddressInd(addressn.nrec);
      }

      _loop badge where ((persons.nrec == badge.person))
      {
        _loop catalogs where ((badge.appoint == catalogs.nrec))
        {
          uchstep:= catalogs.name;
        }
      }
    }

    xlStWriteToMatrix(countermatrix, 1, countpp);
    xlStWriteToMatrix(countermatrix, 2, _tabl.p32);
    xlStWriteToMatrix(countermatrix, 3, _tabl.p5);
    xlStWriteToMatrix(countermatrix, 4, _tabl.phone);
    xlStWriteToMatrix(countermatrix, 5, _tabl.p1);
    xlDoWriteToMatrix(countermatrix, 6, _tabl.p2);
    xlStWriteToMatrix(countermatrix, 7, _tabl.p3);
    xlStWriteToMatrix(countermatrix, 8, _tabl.p4);
    xlStWriteToMatrix(countermatrix, 9, _tabl.p6);
    xlDtWriteToMatrix(countermatrix, 10, _tabl.p7);
    xlDtWriteToMatrix(countermatrix, 11, _tabl.p8);
    xlDoWriteToMatrix(countermatrix, 12, _tabl.p9);
    xlStWriteToMatrix(countermatrix, 13, _tabl.p10);
    xlStWriteToMatrix(countermatrix, 14, vozr);
    xlDtWriteToMatrix(countermatrix, 15, _tabl.p12);
    if _ugod < 3 then xlStWriteToMatrix(countermatrix, 16, 'До 3 лет') else xlStWriteToMatrix(countermatrix, 16, '');
    xlStWriteToMatrix(countermatrix, 17, ustaj);
    xlStWriteToMatrix(countermatrix, 18, staj);
    xlStWriteToMatrix(countermatrix, 19, _tabl.p18);
    xlStWriteToMatrix(countermatrix, 20, _tabl.p19);
    xlStWriteToMatrix(countermatrix, 21, _tabl.p20);
    xlStWriteToMatrix(countermatrix, 22, _tabl.p21);
    xlDtWriteToMatrix(countermatrix, 23, _tabl.p22);
    xlStWriteToMatrix(countermatrix, 24, _tabl.p23);
    xlDoWriteToMatrix(countermatrix, 25, _tabl.p24);
    xlStWriteToMatrix(countermatrix, 26, _tabl.p25);
    xlStWriteToMatrix(countermatrix, 27, _tabl.p26);
    xlStWriteToMatrix(countermatrix, 28, _tabl.p27);
    xlStWriteToMatrix(countermatrix, 29, _tabl.p28);
    xlStWriteToMatrix(countermatrix, 30, char(39)+ _tabl.uchstep);
    xlStWriteToMatrix(countermatrix, 31, addr);
    xlStWriteToMatrix(countermatrix, 32, _tabl.p30);
    xlStWriteToMatrix(countermatrix, 33, _tabl.p31);
    xlStWriteToMatrix(countermatrix, 34, _tabl.ok3code);
    xlStWriteToMatrix(countermatrix, 35,char(39)+ _tabl.dop3);

    if countermatrix = 100
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }

    uchstep:= '';
    addr:= '';
    _ugod:= 0;
    _umes:= 0;
    _uday:= 0;
    ustaj:= 0;
    _god:= 0;
    _mes:= 0;
    _day:= 0;
    staj:= 0;
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  xlFreeMatrix;

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter - 1, 35);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_uvol Implements IUserReport;
Interface UserReport_uvol;

Procedure Run;
Begin
  runinterface(gp_uvol);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Отчет по уволенным сотрудникам';
End;

Function GetGroupName (Level : Word) : String;
Begin
#__UNUSED__(Level)
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
#__UNUSED__(Ind)
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
