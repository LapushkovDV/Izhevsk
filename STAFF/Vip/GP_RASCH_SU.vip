\*************************************************************************************************/
#include userreport.vih

Interface GP_Rasch_SU 'Отчет по расчету количества часов при суммированном учете рабочего времени за квартал' doaccept, escclose;
  Show At (,,48,5);

table struct zr_tabel
(
   nrec            : comp
 , nrecLstab       : comp
 , clsch           : comp
 , strtabn         : string
 , fio             : string
 , kateg           : longint
 , CODTAR          : word
 , RAZR            : word
 , SISOPL          : word
 , tarif           : double
 , cappoint        : comp
 , tperson         : comp
 , cexoz           : comp
 , KodCex          : string
 , sex             : string
 , rejim           : longint
 , paramRejim      : longint
 , datan           : date
 , datok           : date
 , chasf           : double
 , chasfPrazdn     : double
 , chasfV          : double
 , koldn           : double
 , PlanDn          : double
 , PlanCh          : double
 , PlanChPK        : double
 , ChasfUN         : double
 , ChasfPredPrazdn : double
 , cschetd         : string
 , shpz            : string
 , PriznakPovt     : word
 , NrecMove        : comp
 , SrSpisChisl     : double
 , KoldnSrSp       : double
 , KoldnSrSpIskl   : double
 , priznak         : longint
)
with index (
 tb01 = strtabn + datan + datok
,tb02 = Nrec(Surrogate, Unique)
,tb03 = strtabn + chasf
,tb04 = strtabn + koldn
,tb05 = paramRejim + strtabn + nrec
,tb06 = Rejim + strtabn + nrec
,tb07 = tperson + datan + datok
,tb08 = strtabn + datok
,tb09 = datan
,tb10 = clsch + datan + datok
,tb13 = clsch + chasf
,tb14 = clsch + koldn
,tb18 = clsch + datok
,tb19 = cexoz
);


table struct zr_perexod
(
nrec:comp,
nrecPerexod:comp,
clsch:comp,
strtabn:longint,
kateg:longint,
CODTAR:word,
RAZR:word,
SISOPL:word,
tarif:double,
cappoint:comp,
cexoz:comp,
sex:string,
rejim:longint,
paramRejim:longint,
datan:date,
datok:date,
cschetd:string,
shpz:string
)
with index (tp03=strtabn,tp04=clsch,tp01=nrecPerexod,tp02=Nrec(Surrogate, Unique));


table struct zr_rejim
(
rejim:longint,
param:double,
priznak:longint
)
with index (rj01=rejim);

table struct LschetPovt
(
nrec:comp,
strtabn:longint,
datpos:date,
datuv:date,
priznak:word,
NrecMove:comp
)
with index (Lv01=nrec+priznak+NrecMove);

table struct KodNey 
(
kod:double,
name:string,
tip:integer,
vid:integer
)
with index (KN01=name+kod,kn02=tip+vid,k03=name+vid,k04=kod);

table Struct PodrZR
(
Kod:string,
Name:string,
Nrec:comp,
Prizn:double,
cPodrOZ:comp
)
with index (Pd01=Nrec,Pd05=kod,PD02=Prizn+kod,Pd03=Prizn+Name,Pd04=cPodrOZ);

table Struct PodrZR_OZ
(
Kod:string,
tip:integer,
Name:string,
Nrec:comp
)
with index (Pd01=Nrec,Pd05=kod,Pd03=Name,pd02=tip+kod);

var
NrecLschet : comp;
  Kolonka:double;
  i:integer;
  Counter,strtabnOtlad:longint;
  DatNach,DatOkon:date;
  God,MesEnd,MesBeg:longint;
  ipOtlad:integer;
  VremOkon,datum1,datum2:date;
  KodPodrazd_Option, KodPodrazd:string;
  UmNorm:double;
  ExcelPath:string;


create view 
as select PodrZr.*
from
     PodrZR
   , PodrZR_OZ
   , zr_tabel,zr_tabel zr_tabel1
   , zr_perexod,zr_perexod zr_perexod1
   //, kodney

   , zr_rejim,lschetPovt
   , KLREJIM
   , Lschet
where ((
      lschet.nrec      == movelsc.clschet
  and God    ==lstab.yearn
  and mesEnd >>=lstab.mesn
  and mesBeg <<=lstab.mesn(noindex)
  and zr_tabel.clsch       == perexod.clsch
  and zr_perexod.cexoz     == katpodr.nrec
  and year(zr_tabel.datan) == klndr.yeark
  and month(zr_tabel.datan)== klndr.monthk
  and 1                    == klndr.rejim
  and lschet.tperson       == persons.nrec
)); //


const
!    stPlanned = 0;
  stPlanned         = -1;//балансный
  stActual          = 1;
  hkWorking         = 1;
  cfDisregardPeriod = 64;
//  NrecLschet        = 268768777; // 278366796 была Куклева, сделали Васильева;
end;

#include zr_tabel_form_SU.vpp

Screen scrParams (,,sci1EnEsc);
Fields
!strtabnOtlad:noprotect;
DatNach:noprotect;
DatOkon:noprotect;
Buttons
  cmOk       ,,,'Начать' ,,sci1Esc;
  cmCancel   ,,,'Выйти    ' ,,sci1Esc;
<< 'Отчет по расчету количества часов при суммированном учете рабочего времени за квартал'
!Табельный номер           .@@@@
Дата начала расчета       .@@@@@@@@@@
Дата окончания расчета    .@@@@@@@@@@

   <.  Сформировать   .>     <.  Выйти   .>
>>
end;



HandleEvent
CmInit:
{

  NrecLschet := cogettune('NPOEM_OWN.TABEL.ETALONLSCHET');

  if getfirst lschet where ((NrecLschet == Lschet.nrec)) <> tsOK
   {
     Message('Не найден лицевой счет с nrec="'+string(NrecLschet,0,0)+'" расчет будет некорректным'
     +''#13''+ 'проверьте настройку ' + gettunename('NPOEM_OWN.TABEL.ETALONLSCHET')
     +''#13''+ 'Работа прекращена' ,error);

     stop;abort;exit;
   }
 if LSCHET.datuv <> 0
  {
     Message('Лицевой счет "'+Lschet.StrTabn+ '" уволен, расчет будет некорректным'
     +''#13''+ 'проверьте настройку ' + gettunename('NPOEM_OWN.TABEL.ETALONLSCHET')
     +''#13''+ 'Работа прекращена' ,error);
     stop;abort;exit;
  }
    InitWorkingTable;
}
cmOk:
{


God:=year(DatNach);
MesBeg:=month(DatNach);
MesEnd:=month(DatOkon);
ZR_tabel_form_SU;

StartNewVisual(vtNumericVisual,vfTimer+vfBreak,'Формирование отчета',1);

  ExcelPath:= TranslatePath('%ClientStartPath%');

  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_summ_sverhUr.xlsx',true);
  if (xlIsExcelValid)   xlSetActiveSheet(1);//активный лист


xlsetcellStringValue(DatNach+' по '+DatOkon,2,7,2,7);

Counter:=5;

_loop Zr_tabel
 {
  nextvisual;
  xlsetcellStringValue(zr_tabel.KodCex,Counter,1,Counter,1);
  xlsetcellStringValue(zr_tabel.strtabn,Counter,2,Counter,2);
  xlsetcellStringValue(zr_tabel.fio,Counter,3,Counter,3);
  xlsetcellDateValue(zr_tabel.datan,Counter,4,Counter,4);
  xlsetcellDateValue(zr_tabel.datok,Counter,5,Counter,5);
  xlsetcellNumberValue(zr_tabel.chasf,Counter,6,Counter,6);
  xlsetcellNumberValue(zr_tabel.chasfUN,Counter,7,Counter,7);
  xlsetcellNumberValue(zr_tabel.chasfPredPrazdn,Counter,8,Counter,8);
  xlsetcellNumberValue(zr_tabel.planChPK,Counter,9,Counter,9);
  xlsetcellNumberValue(zr_tabel.chasfPrazdn,Counter,10,Counter,10);
  xlsetcellNumberValue(zr_tabel.chasf+zr_tabel.chasfUN+zr_tabel.chasfPredPrazdn-zr_tabel.planChPK-zr_tabel.chasfPrazdn,Counter,11,Counter,11);
  xlsetcellStringValue(if(zr_tabel.sisopl=20,'Сдельная','Оклад'),Counter,12,Counter,12);
  Counter++;
 }

xlKillExcel;
StopVisual('',0);
closeinterface(-1);

}
end;
end.


VipInterface UserReport_Rasch_SU Implements IUserReport;
Interface UserReport_Rasch_SU;

Procedure Run;
Begin
  runinterface(gp_Rasch_SU);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Расчет сверхурочных при суммированном учете за квартал';
End;

Function GetGroupName (Level : Word) : String;
Begin
GetGroupName := '';
   Case Level of
    1 : GetGroupName := 'Отчеты по табелям';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.

