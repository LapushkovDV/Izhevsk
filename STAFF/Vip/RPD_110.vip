#component "Z_StaffOrders"

#include ExtAttr.vih
#include MoneyRound.vih
#include RPD.vih

#doc
  Интерфейс приказа "Компенсация стоимости медицинских услуг детской поликлиники"
#end

VipInterface RPD_110(RPD_Base_Raise)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base.MyDel;
  function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
end;

Interface RPD_110 '' escclose;

view as
select GP_RaiseHistExt110.Nrec
from GP_RaiseHistExt110, psnlinks children, catalogs rodstvo
where ((
  RaiseHist.nrec            == GP_RaiseHistExt110.cRaiseH and
  GP_RaiseHistExt110.cChild == Children.nrec and
  Children.LinkType         == Rodstvo.nrec
));

#include ExtAttr.var

// Выполняет утверждение текущего приказа
function ChildConfirmOneOrder(cNrec : comp = 0): boolean;
var Marker_Tmp:longint;
    ii:longint;
    _pnrec:comp;
{
  Marker_Tmp  :=InitMarker('', 8, 50, 10, True);
  ClearMarker(Marker_Tmp);
  if cNrec <> 0
  { if GetFirst ContDoc where ((cNrec == ContDoc.NRec))=tsok {};
    cNrec:=0;
  }
  _loop fullcache RaiseHist
  { //-----------------
    // Уберем вообще доплату #227.#14
    //-----------------
    InsertMarker(Marker_Tmp,RaiseHist.Nrec);
    update current RaiseHist set RaiseHist.cContDoc:=0;
  } //_loop fullcache RaiseHist
  //---------------------------------------
  result := inherited::ChildConfirmOneOrder(cNrec);
  //---------------------------------------------
  //#227.#14
  for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
  { if GetMarker(Marker_Tmp,ii,_pNrec)
    { if getfirst RaiseHist where (( _pNrec == RaiseHist.Nrec ))=tsok
      { update current RaiseHist set RaiseHist.cContDoc:=ContDoc.Nrec;
        if getfirst Raise=tsok
        { update current Raise set
                Raise.Person     := Persons.nRec
              , Raise.OrderNmb2  := TitleDoc.DocNmb
              , Raise.OrderDate2 := TitleDoc.DocDate
              , Raise.Appoint    := 0
              ;
          iHRaise.Pers_InsToRHist(Raise.Nrec,
                              Raise.FromDate,
                              Raise.ToDate,
                              word(10),
                              Raise.OrderDate2,
                              Raise.OrderNmb2,
                              ContDoc.Nrec);
        } //if getfirst Raise=tsok
      } //if getfirst RaiseHist where (( _pNrec == RaiseHist.Nrec ))=tsok
    } //if GetMarker(Marker_Tmp,ii,_pNrec)
  }//for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)

} //function ChildConfirmOneOrder(cNrec : comp = 0): boolean;

//******************************************************************************
// Окно содержимого приказа на назначение персональных надбавок
//******************************************************************************
Browse brwRaise110 'Назначение доплаты' (,, sci178Esc);
  show at (, 9,,12);
  table RaiseHist;
  Fields
    RaiseCat.Name     'Вид доплаты/надбавки', ('Вид доплаты/надбавки.', hcStaffRaiseType, sci1378Esc):[20], protect;
end;   //  brwRaise

screen scrRaise101Ext110 'Назначение доплаты (расширение)' (,, sci178Esc);
  show at (, 13,,17);
  table RaiseHist;
  Fields
    GP_RaiseHistExt110.NumDog    ('Номер договора'): [20], noprotect;
    GP_RaiseHistExt110.DateDog   ('Дата заключения договора'): [10,'DD/MM/YYYY'], noprotect;
    GP_RaiseHistExt110.NameUsl   ('Наименование услуги'): [4], noprotect, centered;
    GP_RaiseHistExt110.FullCost  ('Плата за месяц'): [10.2], noprotect;
    GP_RaiseHistExt110.UdCost    ('Стоимость для работника (к удержанию)'): [10.2], noprotect;
    GP_RaiseHistExt110.SumPred   ('Размер частичной оплаты предприятием'): [5], protect;
    children.RFIO                ('Ребенок'):protect, pickbutton;
    rodstvo.name                 ('Родство'):skip;
    oExtAttr.sGetAttr(25005, children.nrec, 'Полис ОМС ребенка (члена семьи)')            ('Полис ОМС'): [4], protect, centered;
    oExtAttr.sGetAttr(25005, children.nrec, 'Адрес временного места пребывания ребенка (члена семьи)'): protect;
    oExtAttr.sGetAttr(25005, children.nrec, 'Постоянное место проживания родственника'): protect;
    oExtAttr.sGetAttr(25005, children.nrec, 'Адрес школы (дет.сад) ребенка'): protect;

<<
 `Номер договора` .@@@@@@@@@@@@@@@@@@@@ `Дата заключения договора`.@@@@@@@@@@  `Наименование услуги`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Полная стоимость услуги` .@@@@@@@@@@@ `Стоимость для работника` .@@@@@@@@@@  `Размер оплаты предпр.`.@@@@@@@@@@
 `Ребенок` .@@@@@@@@@@@@@@@@@@@@@@@@@@@ `Родство` .@@@@@@ `Полис ОМС`  .@@@@@@@@@@@@@@@@@@@@
 `Адрес временного пребывания` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Постоянное место жительства` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Адрес школы, детского сада`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>

end;   //  brwRaise

//******************************************************************************
// Процедура удаления своих записей, привязанных у удаляемому приказу
//******************************************************************************
Procedure MyDel;
{
  _loop RaiseHist
  {
    delete all from GP_RAISEHISTEXT110 where ((RaiseHist.Nrec == GP_RaiseHistExt110.cRaiseH));
  }
  inherited::MyDel;
}

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  var sTitle:string;
  inherited::EnableDisable;

  cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
  cfsGetProp('WHATISINORDER',cfpTitle, sTitle);
  cfsSetProp('WHATISINORDER',cfpTitle, replace(sTitle,'Приказ','Список'));
  cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер списка');
  cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата списка');

  if fnFieldsOpen // не утвержден
  {
    SetHelpAndStatusContext(brwRaise110, -1, sci178Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt110.NumDog, true);
    ToggleFieldSelectable(#GP_RaiseHistExt110.DateDog, true);
    ToggleFieldSelectable(#GP_RaiseHistExt110.NameUsl, true);
    ToggleFieldSelectable(#GP_RaiseHistExt110.FullCost, true);
    ToggleFieldSelectable(#GP_RaiseHistExt110.UdCost, true);
    ToggleFieldSelectable(#GP_RaiseHistExt110.SumPred, true);
    ToggleFieldSelectable(#Children.RFIO, true);
  }
  else //утвержден
  {
    SetHelpAndStatusContext(brwRaise110, -1, sci1Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt110.NumDog, false);
    ToggleFieldSelectable(#GP_RaiseHistExt110.DateDog, false);
    ToggleFieldSelectable(#GP_RaiseHistExt110.NameUsl, false);
    ToggleFieldSelectable(#GP_RaiseHistExt110.FullCost, false);
    ToggleFieldSelectable(#GP_RaiseHistExt110.UdCost, false);
    ToggleFieldSelectable(#GP_RaiseHistExt110.SumPred, false);
    ToggleFieldSelectable(#Children.RFIO, false);
  }
}

TableEvent table RaiseHist;
  cmSetDefault:
  {
    //message('Докомпилировали обработчик');
    inherited::HandleEvent(cmSetDefault);
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD110');
    RaiseHist.dRec := TitleDoc.DocDate;
    RaiseHist.dDat2 := TitleDoc.DocDate;
    if (ParentSav <> 0)
    {
      RaiseHist.cRaiseType := ParentSav;
      RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
      Raise.RaiseAttr := RaiseHist.iHAttr;
      Raise.RaiseType := ParentSav;
    }
    RaiseHist.Nrec := GetNextNrec(tnRaiseHist, 0);
    clearbuffer(#GP_RaiseHistExt110);
    GP_RaiseHistExt110.Nrec := GetNextNrec(tnGP_RaiseHistExt110, 0);
    GP_RaiseHistExt110.cRaiseH := RaiseHist.Nrec;
    GP_RaiseHistExt110.DateDog := TitleDoc.DocDate;
    SetModified(true);
  }
  cmInsertRecord:
  {
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      GP_RaiseHistExt110.cRaiseH := RaiseHist.nrec;
      insert current GP_RaiseHistExt110;
    }
  }
  cmUpdateRecord:
  {
    if inherited::handleevent(cmUpdateRecord) = heOk
    {
      if isValidAll(#GP_RaiseHistExt110)
        update current GP_RaiseHistExt110;
    }
  }
  cmDeleteRecord:
  {
    if isValidAll(#GP_RaiseHistExt110)
      delete current GP_RaiseHistExt110;
    inherited::handleevent(cmDeleteRecord);
  }
end;

TableEvent table ContDoc;
  cmInsertRecord:
  {
    //При добавлении нового сотрудника в приказ вызываем выбор вида доплаты/надбавки
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      if SelectFormat(brwRaise110)
      {
        SelectField(#RaiseCat.Name);
        PutCommand(cmPick);
      }
    }
  }
end;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent

    cmCheckField:
    {
      case CurField of
        #GP_RaiseHistExt110.NumDog,
        #GP_RaiseHistExt110.DateDog,
        #GP_RaiseHistExt110.NameUsl:
        {
          SetModified(true);
        }
        #GP_RaiseHistExt110.FullCost:
        {
          set GP_RAISEHISTEXT110.SUMPRED := GP_RAISEHISTEXT110.FULLCOST - GP_RAISEHISTEXT110.UDCOST;
        }
        #GP_RaiseHistExt110.UdCost:
        {
          set GP_RAISEHISTEXT110.SUMPRED := GP_RAISEHISTEXT110.FULLCOST - GP_RAISEHISTEXT110.UDCOST;
        }
      end;
      inherited::HandleEvent(cmCheckField);
    }
    cmMulSelDO:
    {
      if UpdateTable
        UpdNeedField(CurField);
    }
    cmPick:
    {
      case CurField of
        #RaiseCat.Name:
        {
          ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD110');

          var wPickResult: word = cmCancel;
          if GetFirst FastFirstRow Catalogs where ((ParentSav == Catalogs.cParent)) = tsOk
            wPickResult := RunInterface(Z_STAFFCAT::PickCatalog2, 0, ParentSav, 0, 0);
          else
            wPickResult := RunInterface(GP_STAFF::GP_PickCatalogWithOneRec, -17, ParentSav);

          if (wPickResult = cmDefault)
          {
            //PreviousType := RaiseHist.cRaiseType; // взвести флаг того, что поменяли наименование
            set RaiseHist.cRaiseType := ParentSav;
            set RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
            set Raise.RaiseAttr := RaiseHist.iHAttr;
            set Raise.RaiseType := ParentSav;
            ReReadRecord(tnCatalogs);
          }

          exit;
        } //RaiseCat.Name
      end;
      inherited::HandleEvent();
      case CurField of
        #Children.RFIO:
        {
          if RunInterface('iGetChild', Persons.nrec, GP_RaiseHistExt110.cChild) = cmDefault
            SetModified(true);
        }
        #persons.fio:
        {
          if isvalidall(#Persons)
          {
            //Запрещаем пользователю выбирать умерших сотрудников
            if (Persons.ddop1 != 0)
            {
              message('Запрещено выбирать сотрудников с заполненным полем "Дата смерти"', error);
              PutCommand(cmDelOnProtect);
            }
            else
            {
              //Если пользователь выбрал корректного сотрудника и это новая позиция -
              //сразу вызываем вставку этой записи, чтобы далее вызвать добавление вида доплаты/надбавки
              if(isNew) UpdateTable();
              SelectFieldInFormat(brwRaise110, #RaiseCat.Name);
            }
          }
        }
      end; //case
    }
    cmOnVipUnload:{
      inherited::Handleevent(cmOnVipUnload);
      cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
      cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер приказа');
      cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата приказа');

    }
  end;

End.
