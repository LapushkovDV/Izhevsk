#component "Z_StaffOrders"
alter interface RPD_30;
overload
  Procedure IRPD_Base.EnableDisable;
  function fnPosOnLS: boolean;
  function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
end;

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  inherited::EnableDisable;

  cfsSetProp('T_SCRDET30_Сумма(процент)',cfpTitle,'Сумма');
  ToggleFieldSelectable(fnCurrNameFort,false);
}

//******************************************************************************
//  Процедура утверждения приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{
  var iVidOpl:word=0;
  if GetFirst FortRaiseCat = tsOk
  {
    iVidOpl:=longint(SubStr(FortRaiseCat.CatData, 1, 5));

  }
  timelog('RPD_30->ChildConfirmOneOrder: iVidOpl='+string(iVidOpl));
  if (GetFirst KlVidOpl where((iVidOpl == KlVidOpl.VidOpl)) = tsOK)
    timelog('RPD_30->ChildConfirmOneOrder: KlVidOpl.VidOpl='+string(iVidOpl));
  Result:=Inherited::ChildConfirmOneOrder(cNrec);
} //function ChildConfirmOneOrder(cNrec : comp = 0): boolean;
function fnPosOnLS: boolean;
{
  result:=false;

  if (abs(Fortune.DocSum)<0.01 or KlVidOpl.VidOpl<>145) exit;

  result:=inherited::fnPosOnLS;
}
//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent

    cmOnVipLoad:
    {   Timelog_init;
        timelog('RPD_30->cmOnVipLoad');
        if inherited::handleEvent(cmOnVipLoad) = heAbort
          abort;

    }
  end;
end.
