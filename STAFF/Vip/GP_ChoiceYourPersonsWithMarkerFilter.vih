#ifndef __GP_ChoiceYourPersonsWithMarkerFilter_VIH__
#define __GP_ChoiceYourPersonsWithMarkerFilter_VIH__

#include ChoiseYourPersons.vih

#component "Z_STAFF"
#doc
<breaf>Реализация класса GP_ObjChoiceYourPersonsWithMarkerFilter "Выбор сотрудников с произвольным фильтром"</breaf>
Функционал на основе стандартного ChoiseYourPersons. На tmppersons накладывается ограничение из маркера FilterMarker.
Перед запуском Choice FilterMarker должен быть заполнен nrec'ами отображаемых сотрудников.
#end
ObjInterface GP_ObjChoiceYourPersonsWithMarkerFilter(IChoiseYourPersons);
  property FilterMarker: TPtr read;
end;

VipInterface GP_ChoiceYourPersonsWithMarkerFilter(ChoiseYourPersons) Implements GP_ObjChoiceYourPersonsWithMarkerFilter;

#endif
