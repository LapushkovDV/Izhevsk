#include GP_DepartIer.vih
#include DepartmentsLimiter.vih
#include GP_StructHierarchy.vih

#component "Z_Staff"

interface GP_StructHierarchy;

var
  _departIer: GP_DepartIer;

create view
from
  CatPodrDeptIer gp_CatPodrDeptIerTop (CatPodrByCode),
  CatPodrDeptIer gp_CatPodrDeptIerChld (CatPodrByCode)
where ((
  0                          == gp_CatPodrDeptIerTop.cParent and
  gp_CatPodrDeptIerTop.cPodr == gp_CatPodrDeptIerChld.cParent
));

function IStructHierarchyExt.SH_CreateHierarchyExt(_DateHierarchy: date;
                               _SearchMArker: TPtr;
                               _ItogPrizn: boolean;
                               SortType: word // #docl Тип сортировки: здесь не используется. сортировка по коду
                              ): integer;
{
#__UNUSED__(_DateHierarchy,_SearchMArker,_ItogPrizn,SortType)
  var vUserAcs: UserDepartmentsIterator; //для проверки доступа пользователя к подразделению

  _departIer.CreateDeptIerTabl(_DateHierarchy, 1); // Создаем таблицу с иерархией

  delete all SHierarchyTable; // Чистим таблицу

  var isPodrFilterSet: boolean = GetMarkerCount(_SearchMArker) > 0;
  var i: integer = 0; //индекс создаваемого элемента иерархии
  var nrecParent: comp = 0; //для хранения нрека созданного родительского элемента иерархии
  var sortKeyParent: string = ''; //для хранения sortKey родительского элемента иерархии
  var isExistChldActual: boolean = false; //признак, что хотя бы один подчиненный элемент является активным

  //цикл по отделам (верхний уровень)
  _loop gp_CatPodrDeptIerTop
  {
    ClearBuffer(#SHierarchyTable);
    nrecParent := GetNextNrec(#SHierarchyTable, 0);
    SHierarchyTable.Nrec        := nrecParent;
    SHierarchyTable.Name        := '(' + gp_CatPodrDeptIerTop.Code + ') ' + gp_CatPodrDeptIerTop.Name;
    SHierarchyTable.Code        := gp_CatPodrDeptIerTop.Code;
    SHierarchyTable.cPodr       := gp_CatPodrDeptIerTop.cPodr;
    SHierarchyTable.cPodrParent := gp_CatPodrDeptIerTop.cParent;
    SHierarchyTable.levelIer    := 1;
    SHierarchyTable.tempStr     := LPad(string(i++), 4);
    sortKeyParent := SHierarchyTable.tempStr;
    SHierarchyTable.sortKey     := sortKeyParent;

    if not isPodrFilterSet
      SHierarchyTable.actual := true
    else if FoundMarker(_SearchMArker, gp_CatPodrDeptIerTop.cPodr)
      if vUserAcs.Exists(gp_CatPodrDeptIerTop.cPodr)
        SHierarchyTable.actual := true;

    insert current SHierarchyTable;

    //цикл по подчиненным подотделам
    isExistChldActual := false;
    _loop gp_CatPodrDeptIerChld
    {
      ClearBuffer(#SHierarchyTable);
      SHierarchyTable.Nrec        := GetNextNrec(#SHierarchyTable, 0);
      SHierarchyTable.Name        := '   (' + gp_CatPodrDeptIerChld.Code + ') ' + gp_CatPodrDeptIerChld.Name;
      SHierarchyTable.Code        := gp_CatPodrDeptIerChld.Code;
      SHierarchyTable.cPodr       := gp_CatPodrDeptIerChld.cPodr;
      SHierarchyTable.cPodrParent := gp_CatPodrDeptIerChld.cParent;
      SHierarchyTable.levelIer    := 2;
      SHierarchyTable.tempStr     := LPad(string(i++), 4);
      SHierarchyTable.sortKey     := sortKeyParent + SHierarchyTable.tempStr;

      if not isPodrFilterSet
        SHierarchyTable.actual := true
      else if FoundMarker(_SearchMArker, gp_CatPodrDeptIerChld.cPodr)
        if vUserAcs.Exists(gp_CatPodrDeptIerChld.cPodr)
          SHierarchyTable.actual := true;

      isExistChldActual |= SHierarchyTable.actual;
      insert current SHierarchyTable;
    }

    //если существуют подчиненные активные отделы, а родительский отдел неактивен,
    //делаем его активным
    if isExistChldActual
      if getfirst SHierarchyTable where ((nrecParent == SHierarchyTable.Nrec)) = tsOk
        if not SHierarchyTable.actual
          update current SHierarchyTable set SHierarchyTable.actual := true;
  }
  result := i;
}

end.
