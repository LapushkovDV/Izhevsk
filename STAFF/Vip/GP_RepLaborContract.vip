  StaffStruct,AdvFeatures,
  Attestation,
  KatKod,NormDateSFO,NormGroupSFO,GroupSFO,KatEd,
  Appendix,Conscription,
  Appointments NewAppoint,
  Experience,KlVal,
  Education,Notes,
  Vacations,SalScale,UOWrkTabel,
  FactOtpusk,WorkPeriod,
  PsnLinks,Sys_Uder,
  PutVacCon,PutVacation,
  OtpOtz,AllVacCon,
  PrMemo,AttrVal,
  DelRaise
  , synonym ContDoc  SourceContDoc
  , synonym PartDoc  SourcePartDoc
  , synonym TitleDoc SourceTitleDoc
  , InfPsn1
  , synonym SalScale WWSalScale
  , Catalogs CatalogsPassName
  , Catalogs CatPodr


  ;

window WinRepParam 'Параметры печати' Gray;
show(20,10,80,17);

screen ScRepParam(,,sci1Esc);
fields
  CurTemplInd('Шаблон отчета',,sci13Esc):[list ''],protect;
  sSigners('Подписант',,sci13Esc):protect,pickbutton;
buttons
  cmOK,,,'Запуск',,;
  cmCancel,,,'Выход',,;
<<
 `Шаблон отчета`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Подписант`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. ~С~формировать .>                         <. ~З~акрыть .>
>>
end;

function CheckInPutVars:boolean;
{
  result:=false;

  if (not ExistFile(ArTemplate[CurTemplInd])) {
    message('Не найден шаблон отчета "'+ArTemplate[CurTemplInd]+'".',error);
    exit;
  }

  result:=true;
}

function FindTempl:boolean;
var sRootDir,sTempl:string;
    ArTempl:array[0..0] of string;
    i,DefTempl:integer;
{
  result:=false;

  sRootDir:=StartPathName+'XLS_ЭМ\Staff\';

  sRootDir+='РПД_'+string(wCurTypeOper);
  if (CurTypeRep=0) sRootDir+='\Договор' else sRootDir+='\Приказ';
  if (not VerifyPathName(sRootDir,true)) {
    message('Не найдена папка для шаблона отчета "'+sRootDir+'"!',error);
    exit;
  }

  sTempl:=GetFirstFile(sRootDir,'*.dotm');

  i:=0;
  DefTempl:=0;
  setlimit(ArTempl,0);
  setlimit(ArTemplate,0);
  do {
    while(sTempl<>strDataIsEmpty and SubStr(BuhXml_ExtractFileName(sTempl),1,2)='~$')
      sTempl:=GetNextFile;
    if (sTempl=strDataIsEmpty) break;

    ArTemplate[i]:=sTempl;
    ArTempl[i]:=BuhXml_ExtractFileName(sTempl);
    if (pos('по умолчанию',LoCase(ArTempl[i]))<>0) DefTempl:=i;

    i++;
    sTempl:=GetNextFile;
  }
  while(sTempl<>strDataIsEmpty and Count(ArTempl)<100);

  if (i=0) {
    message('Не найдено ни одного шаблона отчета в папке "'+sRootDir+'"!',error);
    exit;
  }

  SetEnumList(ScRepParam,fnCurTemplInd,ArTempl);
  CurTemplInd:=DefTempl;

  result:=true;
}

HandleEvent
cmInit:{
  if (not FindTempl) {
    abort;
    exit;
  }

  iFeeSigners.InitFeeSigners(cgReport_KASSFRO);
  sSigners:='';
  ReadMyDsk(sSigners,#__InterfaceName__+'sSigners',true);
  if (sSigners='')
    sSigners:=sGetTune('UP.Staff.SignatoryAuthority');
  if (not iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigners))
    sSigners:='';
}
cmDone:{
  SaveMyDsk(sSigners,#__InterfaceName__+'sSigners');
}
cmOK:{
  //Проверка параметров
  if (not CheckInPutVars) exit;

  CloseWindowEx(CurWindow,cmDefault);
}
end;
end;//WinRepParam

procedure InsVar(VarName:string;VarVal:string=' ';AddVal:boolean=false);
{
//  LogStrToFile('#InsVar.txt',VarName + ' ' + VarVal);

   if (VarVal='') VarVal:=' ';//Если передать пустую строку, то переменная удаляется
   if (AddVal and Trim(VarVal)='') exit;

   WordVar:=WordVariables.Item(VarName);
   if (WordVar=NullRef)
     WordVariables.Add(VarName,VarVal)
   else {
     if (AddVal)
       MSWord.Run('AddToVar',VarName,VarVal)
     else
       WordVar.Value:=VarVal;
   }

   NextVisual;
}

function DateToString(dVal:date):string;
{
  result:=if(dVal=ZeroDate,'',DateToStr(dVal,'DD.MM.YYYY'));
}

procedure InsVarD(VarName:string;VarVal:date);
{
  InsVar(VarName,DateToString(VarVal));
}

function DateToStrInWords(dVal:date):string;
{
  result:=if(dVal=ZeroDate,'',DateToStr(dVal,'"DD" mon YYYY г.'))
}

procedure InsVarDW(VarName:string;VarVal:date);
{
  InsVar(VarName,DateToStrInWords(VarVal));
}

function DoubleToStringWithBracket(Val:double):string;
var i,p:byte;
    sTmp:string;
{
  result:=Trim(DoubleToString(0,Val));

  p:=0;
  for(i:=Length(result)-2;i>0;i--) {
    sTmp:=LoCase(SubStr(result,i,3));
    if (sTmp='коп') p:=i
    else if (sTmp='руб') {
      p:=i;
      break;
    }
  }

  if (p<>0)
    result:='('+SubStr(result,1,p-2)+')'+SubStr(result,p-1,255);
}

function NumberToStr(Val:double):string;
{
  result:='';

  if (Trunc(Val)<>0)
    result+=DoubleToStr(Val,'4');

  if (Val-Trunc(Val)>0)
    result+=DoubleToStr(Val,'5');

  if (result<>'')
    result:=Trim(UpCase(result[1])+SubStr(result,2,255));
}

function GetShortFIO(FIO:string):string;
{
  result:=SubStr(iStrFunc.Get_FirstName(FIO),1,1)+'. '+
          SubStr(iStrFunc.GetPatronymic(FIO),1,1)+'. '+
          iStrFunc.Get_LastName(FIO);
}

function GetShortFIOLast(FIO:string):string;
{
  result:='';
  if (iStrFunc.GetFioIn(FIO))
    result:=FIO;
}

function GetShortIO(FIO:string):string;
{
  result:=iStrFunc.Get_FirstName(FIO)+' '+iStrFunc.GetPatronymic(FIO);
}

function GetDepNameAndCodeByTabN(TabN:string):string;
var cRec:comp;
{
  result:='';
  if (getfirst fastfirstrow Persons2
      where(('С'==Persons2.IsEmployee and 0==Persons2.TabNmb and TabN==Persons2.StrTabn))<>tsok) exit;
  if (Persons2.AppointCur<>0) cRec:=Persons2.AppointCur else cRec:=Persons2.AppointLast;
  if (getfirst fastfirstrow NewAppoint where((cRec==NewAppoint.NRec))<>tsok) exit;

  result:=iCatFunc.GetCatalogsName(NewAppoint.Department)+' ('+iCatFunc.GetCatalogsCode(NewAppoint.Department)+')';
}

procedure FindDescendants(mCat:longint;cCat:comp);
{
  _loop Catalogs where((cCat==Catalogs.cParent)) {
    InsertMarker(mCat,Catalogs.NRec);
    PushPos(tnCatalogs);
    FindDescendants(mCat,Catalogs.NRec);
    PopPos(tnCatalogs);
  }//_loop Catalogs
}

function GetAdvFeatures(cStaffStr:comp;CatName:string):tArVal;
var Rez:tArVal;
    cCat:comp;
    mCat:longint;
{
  setlimit(Rez,0);
  result:=Rez;

  cCat:=iCatFunc.GetCatalogsNRec(83);
  if (getfirst fastfirstrow Catalogs
      where((0==Catalogs.lPr and cCat==Catalogs.MainLink and CatName==Catalogs.Name))<>tsok) exit;

  mCat:=InitMarker('',8,0,1);
  FindDescendants(mCat,Catalogs.NRec);
  _loop AdvFeatures where((2==AdvFeatures.ObjType and cStaffStr==AdvFeatures.ObjNrec))
    if (FoundMarker(mCat,AdvFeatures.Position)) {
      if (Rez[1]<>'') Rez[1]+=', ';
      if (AdvFeatures.ValType = 6)
        Rez[1]+=iCatFunc.GetCatalogsName(Comp(AdvFeatures.ValString))
      else
        Rez[1]+=AdvFeatures.ValString;

      if (Rez[2]<>'') Rez[2]+=', ';
      Rez[2]+=iCatFunc.GetCatalogsName(AdvFeatures.Position);
    }
  DoneMarker(mCat,'');

  result:=Rez;
}

// Возвращает строковое представление срока службы - единственная форма, подходящая для "До износа"
Function GetSrokStr(exSrok: Word): String;
{
  GetSrokStr := '';

  case (exSrok) of
  //------------
    0: GetSrokStr := 'разовая';
  //------------
    rvMaxWord: GetSrokStr := 'до износа';
  //------------
  else
    GetSrokStr := String(exSrok)+' мес.';
  //------------
  end;
}

function GetCatalogsNameDeclension(cCat:comp;Pp:byte;IsPost:boolean=false):string;
var nCat:string;
    iSpace:byte;
{
  // поищем нужный атрибут с указанным падежом
  result := Trim(SPFG.GetNeedString(true, Pp, cCat, ''));
  if (result<>'') exit;

  nCat:=Trim(iCatFunc.GetCatalogsName(cCat));

  if (IsPost) {
    iSpace:=Pos(' ',nCat);
    if (iSpace<>0)
      result := Trim(iOdecl.FIODeclension(0, SubStr(nCat,1,iSpace-1), Pp)) + ' ' + SubStr(nCat,iSpace+1,255);
  }

  if (result='')
    result := Trim(iOdecl.FIODeclension(0, nCat, Pp));

  if (result=nCat) //Если ничего не помогло...
    result := iGP_ODecl.My_Sclonenie(nCat,Pp);
}

function GetPostName(cPost:comp):string;
{
  if ( boGetTune('UP.STAFF.USE_LONGNAME_ANK') )//Выводить длинное наименование должности в анкетной форме
    result:=iCatFunc.GetCatalogsLongName(cPost)
  else
    result:=iCatFunc.GetCatalogsName(cPost);
}

function PodrNrecCat(cpodr:comp):comp;
{
  result:=0h;

  if getfirst CatPodr where (( cpodr==CatPodr.nrec )) = tsok
  {
    if Length(CatPodr.Code)=3 then result:=CatPodr.nrec;
    else result:=PodrNrecCat(CatPodr.cparent);
  };
}
function PodrNameCat(cpodr:comp):string;
{
  result:='';

  if getfirst CatPodr where (( cpodr==CatPodr.nrec )) = tsok
  {
    if Length(CatPodr.Code)=3 then result:=CatPodr.name;
    else result:=PodrNameCat(CatPodr.cparent);
  };
}

function GetYearsOfMortgageRefund(Sum:double):word;
{
  if (Sum<500000)
    result:=5
  else if (Sum<1000000)
    result:=7
  else if (Sum<=2000000)
    result:=10
  else
    result:=0;
}

function GetWorkPeriodByVacations: string;
{
  result := '';
  if (Getfirst fastfirstrow PutVacation where((Vacations.cPutVac==PutVacation.NRec)) = tsOK )
  {
    if PutVacation.wTypeVac = 1 //если это остаток - берем период, за который остаток
    {
      if (Getfirst fastfirstrow WorkPeriod where((PutVacation.cWPRemain==WorkPeriod.NRec)) = tsOK )
        result :=DateToString(WorkPeriod.dPerBeg) + ' - ' + DateToString(WorkPeriod.dPerEnd);
    }
    else //если это обычная запись - берем ссылку на период
    {
      if (Getfirst fastfirstrow WorkPeriod where((PutVacation.cWorkPeriod==WorkPeriod.NRec)) = tsOK )
        result :=DateToString(WorkPeriod.dPerBeg) + ' - ' + DateToString(WorkPeriod.dPerEnd);
    }
  }
}

function GetWorkPeriodByFactOtpusk: string;
{
  result := '';
  if (Getfirst fastfirstrow Vacations where((FactOtpusk.NRec==Vacations.cFactOtpusk)) = tsOK )
    result := GetWorkPeriodByVacations;

  if result = ''
    if (getfirst fastfirstrow WorkPeriod where((FactOtpusk.cWorkPeriod == WorkPeriod.NRec))=tsok)
      result := DateToString(WorkPeriod.dPerBeg) + ' - ' + DateToString(WorkPeriod.dPerEnd);
}

#Declare InsMemo(Tbl,Fld,VarName)
  if (IsMemoText(tn#(Tbl))) {
    var hMemo:longint;
    hMemo:=CreateFileHandle('');
    if (File_OpenMemo(#Tbl.#Fld,hMemo)) {
      var MemoStr:string='';
      while(not File_EOF(hMemo)) {
        File_ReadLn(MemoStr,hMemo);
        if (not bFirst) MemoStr:=' '+MemoStr;
        InsVar(#VarName,MemoStr,not bFirst);
        bFirst:=false;
      }
      File_Close(hMemo);
    }
    DeleteFileHandle(hMemo);
  }
#end

procedure Run(TypeOper,TypeRep:integer;cContDoc,cPerson,cAppointment:comp);
var wClassCodeDurationWork:word;
    ArVal:tArVal;
    DateVal,TitleDocDate:date;
    tmpDouble:double;
    bFirst:boolean;
    cRec,cAgreement:comp;
    cAttrReasonOfRecall,cAttrRejimNote:comp;
{
  if timelog_Status>2 timelog('Входящие параметры: cPerson = '+string(cPerson,0,0)+' cAppointment = '+string(cAppointment,0,0));
  wNIIMash:=wGetTune('UP.NIIMASHGAL.NIIMASH');
  if DeleteFile('#InsVar.txt') {}
  if DeleteFile('#sOtpStr.txt') {}

  if (TypeOper=0) exit;
  if (TypeOper=1) {// Приказ о приеме на работу

   if cPerson =comp(0) and cAppointment<>comp(0){
          cPerson := if(getfirst Appointments where ((cAppointment == Appointments.nrec)) = tsOk,
                         Appointments.PERSON, 0);
          if timelog_Status>2 timelog('Заполняем пустые поля 1: cPerson = '+string(cPerson,0,0)+' cAppointment = '+string(cAppointment,0,0));
       }
       if cPerson <>comp(0) and cAppointment=comp(0){
          cAppointment := if(getfirst Appointments where ((cPerson == Appointments.Person)) = tsOk,
                         Appointments.Nrec, 0);
          if timelog_Status>2 timelog('Заполняем пустые поля 2: cPerson = '+string(cPerson,0,0)+' cAppointment = '+string(cAppointment,0,0));
       }

    if (getfirst fastfirstrow ContDoc where (( TypeOper==ContDoc.TypeOper and
                                               cPerson==ContDoc.Person and
                                               cAppointment==ContDoc.ObjNrec
                                            )) <>tsok) {
      //Если приказ не найден - возвращаем информацию из первого назначения сотрудника
       if cPerson =comp(0) and cAppointment<>comp(0){
          cPerson := if(getfirst Appointments where ((cAppointment == Appointments.nrec)) = tsOk,
                         Appointments.PERSON, 0);
          if timelog_Status>2 timelog('Не нашли приказ 1: cPerson = '+string(cPerson,0,0)+' cAppointment = '+string(cAppointment,0,0));
       }
       if cPerson <>comp(0) and cAppointment=comp(0){
          cAppointment := if(getfirst Appointments where ((cPerson == Appointments.Person)) = tsOk,
                         Appointments.Nrec, 0);
          if timelog_Status>2 timelog('Не нашли приказ 2 cPerson = '+string(cPerson,0,0)+' cAppointment = '+string(cAppointment,0,0));
       }
      /*cAppointment := if(getfirst Appointments where ((cPerson == Appointments.Person)) = tsOk,
                         Appointments.Nrec, 0);*/
    }
  } else if (TypeOper=3 or //Приказ на Временное замещение без освобождения от своих обязанностей (РПД-3)
             TypeOper=4 or //Приказ на совмещение \ внутреннее совместительство (РПД-4)
             TypeOper=5 or //Приказ на перемещение (РПД-5)
             TypeOper=70) {//Приказ на Временное замещение с освобождением от своих обязанностей (РПД-70)
    if (getfirst fastfirstrow ContDocOld where((cContDoc==ContDocOld.NRec))<>tsok) {
      message('Не найдена запись таблицы ContDoc с NRec='+string(cContDoc,0,0),error);
      exit;
    }
    if (getfirst fastfirstrow ContDoc
        where((
          ContDocOld.cPart == ContDoc.cPart
          and ContDocOld.TypeOper == ContDoc.TypeOper
          and ContDocOld.Person == ContDoc.Person
          and Integer(1) << ContDoc.SeqNmb
          and ContDocOld.wRec == ContDoc.wRec(noIndex)
    ))<>tsok) {
      message('Не найдена запись таблицы ContDoc связанная с новым назначением (SeqNmb>1)',error);
      exit;
    }
    cAppointment:=ContDoc.cStr;
  } else if (TypeOper=8) {//Приказ "Увольнение сотрудника"
    if (getfirst fastfirstrow ContDoc
    where((
      TypeOper==ContDoc.TypeOper and cPerson==ContDoc.Person and
      cAppointment==ContDoc.cStr(NoIndex) and integer(1)==ContDoc.SeqNmb(NoIndex)
    ))<>tsok) {
      message('Не найдена запись таблицы ContDoc с TypeOper='+string(TypeOper)+
              ', Person='+string(cPerson,0,0)+' и cStr='+string(cAppointment,0,0),error);
      exit;
    }
  } else {//Прочие приказы
    if (getfirst fastfirstrow ContDoc where((cContDoc==ContDoc.NRec))<>tsok) {
      message('Не найдена запись таблицы ContDoc с NRec='+string(cContDoc,0,0),error);
      exit;
    }
  }

  if TypeOper<>ContDoc.TypeOper and not (TypeOper=1 and cContDoc=0)
    TypeOper:=ContDoc.TypeOper;

  if (cPerson=0)
    cPerson:=ContDoc.Person;
  if (getfirst fastfirstrow Persons where((cPerson==Persons.NRec))<>tsok) {
    message('Не найдена запись таблицы Persons с NRec='+string(cPerson,0,0),error);
    exit;
  }

  if (cAppointment=0)
    cAppointment:=ContDoc.cStr;
  if (getfirst fastfirstrow Appointments where((cAppointment==Appointments.NRec))<>tsok) {
    message('Не найдена запись таблицы Appointments с NRec='+string(cAppointment,0,0),error);
    exit;
  }

  CurTypeRep:=TypeRep;
  wCurTypeOper := TypeOper;
  if (RunWindowModal(WinRepParam)<>cmDefault) exit;

  StartNewVisual(vtRotateVisual, vfTimer+vfBreak+vfConfirm,if(TypeRep=0,'Печать трудового договора...','Печать приказа...'), 0);

  _try {
    WordDoc:=MSWord.Documents.Add(ArTemplate[CurTemplInd]);
    WordVariables:=WordDoc.Variables;

    wClassCodeDurationWork:=oExtClass.CreateClass(coKlRejim,'Продолжительность рабочего времени',1);
    cAttrReasonOfRecall:=oExtAttr.AttrID(coContDoc,'Причина отзыва из отпуска');
    cAttrRejimNote:=oExtAttr.AttrID(coKlRejim,'Описание режима работы');

    cAgreement:=0;
    if (TypeOper=50 or TypeOper=60 or TypeOper=61 or TypeOper=62 or TypeOper=65) {
      if (getfirst fastfirstrow AppHist where((ContDoc.Nrec==AppHist.cContDoc))=tsok)
        cAgreement:=NOAA.GetFirstAgreementByLink(coAppHist, AppHist.NRec);
    } else if (TypeOper=3 or TypeOper=4 or TypeOper=5 or TypeOper=70) {
      cAgreement:=NOAA.GetFirstAgreementByLink(coContDoc, ContDocOld.NRec);
    } else {
      cAgreement:=NOAA.GetFirstAgreementByLink(coContDoc, ContDoc.NRec);
    }

    if (Appointments.ResComp[1]=0)
      cRec:=NOAA.GetContractByAgreement(cAgreement)
    else
      cRec:=Appointments.ResComp[1];

    InsVar('Номер договора',iWWC.GetContractNmb(cRec));
    InsVarD('Дата договора',iWWC.GetContractDate(cRec));
    InsVarDW('Дата договора, прописью',iWWC.GetContractDate(cRec));
    InsVarD('Дата окончания договора',iWWC.GetContractEnd(cRec));
    InsVarDW('Дата окончания договора, прописью',iWWC.GetContractEnd(cRec));

