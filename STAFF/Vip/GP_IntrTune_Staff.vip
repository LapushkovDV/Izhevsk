#include TuneSpec.vih
#include FeeSigners.vih
#include GetKau.vih
#include GP_StatusAccessEdit.vih  //типы документов НПО Энергомаш
#include GP_STATUS.vih //выбор статусов для документов НПО Энергомаш

//--------------------------------
VipInterface GP_IntrTune_Staff implements ObjIntrTuneComponent licensed (FREE);
//--------------------------------

// Обработчик точки расширения epIntrTuneComponent
// Должен вернуть FALSE если обработка проводилась. TRUE - если не проводилась.
handler with replace GP_IntrTune_Staff on extensionPoint epIntrTuneComponent (TR: objTuneIntr; TVal: TTuneVal; Inter: string)
action
{
   var ifc : GP_IntrTune_Staff;
   result := not ifc.TuneIntrComponent (TR, TVal, Inter);
}

Interface GP_IntrTune_Staff;
Create view
var
  wc_nrec:comp;
  wTypeDoc:word;
  Markers:tPtr;
as select catalogs.nrec
from catalogs
,KATLINK
,GP_STATUS
,GP_TYPEDOCS
,KatOrgDescr
,AttrNam
,x$Users
, Persons
, Lschet
where ((
    wc_nrec == Catalogs.Nrec
and wc_nrec == KATLINK.Nrec
and wc_nrec == GP_Status.Nrec
and wTypeDoc == GP_TYPEDOCS.wType
and wc_nrec == KatOrgDescr.Nrec
and wc_nrec == AttrNam.Nrec
and wc_nrec == x$users.Atl_nrec
))
;

#include FeeSigners.var
#include GetKau.var

// Убрать домен из имени пользователя
Function UserRemoveDomen(ww:string): string;
{ Result:='';
  if  pos('\',ww)>0
    Result:=substr(ww,pos('\',ww)+1,200)
  else
    Result:=ww;
} //Function UserRemoveDomen(ww:string): string;


// получить имя пользователя по ID
Function GetUserName(ww_cUser:comp):string;
{ if ww_cUser=0
  { Result:='';
    Exit;
  }
  Result:=UserName();
  if UserID()<>ww_cUser
  { if getfirst x$users where (( ww_cUser == x$users.Atl_Nrec ))=0
    {  Result:=UserRemoveDomen(x$users.xu$LoginName);
    }
  }
} //Function GetUserName(ww_cUser:comp):string;

// Обязательно должна вернуть False если обработка не производилась, иначе true
Public Function TuneIntrComponent (TR: objTuneIntr; TVal: TTuneVal; Inter: string) : boolean;
{
  Var PrOk : boolean;  PrOk := False;

  TuneIntrComponent := true; // Чтобы в каждом case не писать это

  case UpCase(Inter) of
    //#219 Группа контрагентов для автосоздания организации
    'GP_KATORGGROUP':
    { var ParentSav: comp;
      ParentSav := TVal.compVal;
      if ( RunInterface(GetKatOrgDescr, word(0), false, ParentSav) = cmDefault )
      {
        if (getfirst KatOrgDescr where ((ParentSav == KatOrgDescr.Nrec)) = tsOk)
        {
          TVal.compVal := ParentSav;
          TVal.strVal  := KatOrgDescr.Name;
          PrOk:=true;
          Result := True;
        }
      }
    }
    //#211
    'CHOOSEDOPLATA':{
      var ParentSav :comp;

      if (RunInterface(PickCatalog2, integer(-17), ParentSav, 0) = cmDefault)
      {
        TVal.CompVal := ParentSav;
        if (GetFirst Catalogs where ((ParentSav /== Catalogs.nrec)) = tsOk)
          TVal.StrVal  := Catalogs.name;
        TVal.CUser   := UserId();
        PrOk:=true;
        TuneIntrComponent := true;
      }
    }
    'GP_CAT_DEPT':{
      var ParentSav :comp;

      if (RunInterface(PickCatalog2, integer(-11), ParentSav, 0) = cmDefault)
      {
        TVal.CompVal := ParentSav;
        if (GetFirst Catalogs where ((ParentSav /== Catalogs.nrec)) = tsOk)
          TVal.StrVal  := Catalogs.name;
        TVal.CUser   := UserId();
        PrOk:=true;
        TuneIntrComponent := true;
      }
    }

    //#195
    'SENIOREXECUTIVE':
    { var ParentSav :comp;
      if (RunInterface(PickCatalog2, integer(-375), ParentSav, 0) = cmDefault)
      {
        TVal.CompVal := ParentSav;
        if (GetFirst Catalogs where ((ParentSav /== Catalogs.nrec)) = tsOk)
          TVal.StrVal  := Catalogs.name;
        TVal.CUser   := UserId();
        TR.UpdateTuneVal(TVal);
        TuneIntrComponent := true;
      }
    }
    //#1971
    'RAISE_CLASS':
    { var ParentSav :comp;
      if (RunInterface(PickCatalog2, integer(-17), ParentSav, 0) = cmDefault)
      {
        TVal.CompVal := ParentSav;
        if (GetFirst Catalogs where ((ParentSav /== Catalogs.nrec)) = tsOk)
          TVal.StrVal  := Catalogs.name;
        TVal.CUser   := UserId();
        PrOk:=true;
        TuneIntrComponent := true;
      }
    }
  'GETCOLOUR':
  {
    var returnColorVal : longint;
    var returnColorName : string;
    returnColorVal  :=TVal.LongVal;
    returnColorName :=TVal.strVal ;
    if (RunInterface('GP_STAFF::GP_PickColour', returnColorVal, returnColorName) = cmDefault)
    {
      TVal.LongVal := returnColorVal;
      TVal.strVal  := returnColorName;
      PrOk:=true;
      TuneIntrComponent  := true;
    }
  }
  //'NPOEM_OWN.SCUD.ZAbsent_STATUS_M', 'Статус "утвержден" в заявлении на отсутствие'
  'SCUD_ZABSENT_STATUS_M':
  { wTypeDoc:=0;
    var _cCurTypeDoc:comp=0;
    case UpCase(Inter) of
    'SCUD_ZABSENT_STATUS_M' : wTypeDoc:=GP_iSC_statement_on_absence;
    end;
    if wTypeDoc>0
    if getfirst GP_TYPEDOCS=tsok
    { _cCurTypeDoc:=GP_TYPEDOCS.Nrec;
      wc_nrec:=TVal.CompVal;
      if (RunInterface('GP_COMMON::GP_STATUSPICKANDEDIT',_cCurTypeDoc,cgiPick,wc_nrec,0) = cmDefault)
      {
        TVal.CompVal := wc_nrec;
        if getfirst GP_Status=tsok
         TVal.strVal  := GP_Status.Name;
        PrOk:=true;
        TuneIntrComponent  := true;
      }
    }
    else
    { message('Ошибка определения типа для '+UpCase(Inter));
    }
  }
  //Множественный выбор аналитики. Записывает выбор в KatLink.
  //Анализирует имя интерфейса. Код аналитики = KAU***, KatLink.wTable = TBL****, KatLink.Code = Code***
  'GP_KATLINK_SYS_KAU13_TBL11301_CODE1':
  {
    var i: longint = 0;
    var s1: string = '';
    var s: string = UpCase(Inter) + '_';

    var sOwnName: string = if(pos('_SYS', s) > 0, '', GetUserName(TVal.cUser));

    s1 := SubStr(s, Pos('_KAU', s) + 4, 255);
    var wKau: word = Word(SubStr(s1, 1, pos('_', s1) - 1));

    s1 := SubStr(s, Pos('_TBL', s) + 4, 255);
    var wTbl: word = Word(SubStr(s1, 1, pos('_', s1) - 1));

    s1 := SubStr(s, Pos('_CODE', s) + 5, 255);
    var wCode: word = Word(SubStr(s1, 1, pos('_', s1) - 1));

    Markers := InitMarker('', 8, 50, 10, true);
    ClearMarker(Markers);
    _loop KatLink where ((sOwnName  == KatLink.OwnName and wTbl == KatLink.CodeTable and wCode == KatLink.Code))
      InsertMarker(Markers, KatLink.cRec);
    DoneMarker(Markers, iGetKau.GetMarkerName(wKau));

    If (iGetKau.GetCodeKau(cgiPickMult+cgiNotClear, wKau, Comp(0)) <> 0)
    {
      Markers := InitMarker(iGetKau.GetMarkerName(wKau), 8, 50, 10);
      s := '';
      delete KatLink where ((sOwnName == KatLink.OwnName and wTbl == KatLink.CodeTable and wCode == KatLink.Code));
      TVal.CompVal := 0;
      var c: comp = 0;
      for(i := 0; GetMarker(Markers, i, c); i++)
      {
        insert into KatLink set
          KatLink.CodeTable := wTbl
         ,KatLink.OwnName   := sOwnName
         ,KatLink.cRec      := c
         ,KatLink.Name      := ShowKau(wKau, c)
         ,KatLink.Code      := wCode
         ,KatLink.cUser     := TVal.cUser;
        s += if(i > 0, ', ', '') + if(GetAnyKau(cgAkSimple, wKau, c), GivenAnName(cgAnCode), '???');
        if (i = 0) TVal.CompVal := c;
      }
      TVal.strVal := s;
      PrOk := true;
      DoneMarker(Markers, '');
    }
  }
  //Выбор наименования внешнего атрибута для таблицы.
  //Код таблицы берется из имени интерфейса.
  'GP_ATTRNAM_9015':
  {
    var wTbl: word = Word(SubStr(UpCase(Inter), 12, 10));
    if RunInterface(C_ExtClass::PickAttrNam, wc_nrec, wTbl, 0) = cmDefault
      if getfirst AttrNam = tsOk
      {
        TVal.CompVal := AttrNam.Nrec;
        TVal.StrVal  := AttrNam.Name;
        PrOk := true;
      }
  }
  'NPOEM_OWNTABELETALONLSCHET':
   {
    var _cLschet : comp = 0h;
    if runinterface(GP_Staff::GP_GetAllLschet,_cLschet) = cmDefault
     {
      if getfirst Lschet where ((_cLschet == lschet.nrec)) = tsOK
      if getfirst Persons where ((lschet.TPERSON == persons.nrec)) = tsOK
      {
       TVal.CompVal := lschet.nrec;
       TVal.strVal  := persons.fio;
       PrOk:=true;
       TuneIntrComponent  := true;
      }
     }
   }
  'NPOEM_OWNRAISEMANAGERMOTIVATION':
   {
    var _cLschet : comp = 0h;
    if runinterface(GP_Staff::GP_GetAllLschet,_cLschet) = cmDefault
     {
      if getfirst Lschet where ((_cLschet == lschet.nrec)) = tsOK
      if getfirst Persons where ((lschet.TPERSON == persons.nrec)) = tsOK
      {
       TVal.CompVal := persons.nrec;
       TVal.strVal  := persons.fio;
       PrOk:=true;
       TuneIntrComponent  := true;
      }
     }
   }

   'EM_CAT_TRDOGTYPE':{
      var ParentSav :comp;

      if (RunInterface(PickCatalog2, integer(-133), ParentSav, 0) = cmDefault) then
      {
        TVal.CompVal := ParentSav;
        if (getFirst FastFirstRow Catalogs where ((ParentSav /== Catalogs.nRec)) = tsOk) then
        {
          TVal.StrVal := Catalogs.Name;
        }
        TVal.CUser := UserId();
        PrOk := true;
        TuneIntrComponent := true;
      }
    }

    'EM_CAT_JOBNATURE':{
      var ParentSav :comp;

      if (RunInterface(PickCatalog2, integer(-12), ParentSav, 0) = cmDefault) then
      {
        TVal.CompVal := ParentSav;
        if (getFirst FastFirstRow Catalogs where ((ParentSav /== Catalogs.nRec)) = tsOk) then
        {
          TVal.StrVal := Catalogs.Name;
        }
        TVal.CUser := UserId();
        PrOk := true;
        TuneIntrComponent := true;
      }
    }

    'EM_CAT_KINDAPP':{
      var ParentSav :comp;

      if (RunInterface(PickCatalog2, integer(-123), ParentSav, 0) = cmDefault) then
      {
        TVal.CompVal := ParentSav;
        if (getFirst FastFirstRow Catalogs where ((ParentSav /== Catalogs.nRec)) = tsOk) then
        {
          TVal.StrVal := Catalogs.Name;
        }
        TVal.CUser := UserId();
        PrOk := true;
        TuneIntrComponent := true;
      }
    }
  else
    TuneIntrComponent := false;  // Если не зашли в обработку, то обязательно установим в false
  end;  // case

  if (PrOk)
    TR.UpdateTuneVal(TVal);
}     // TuneIntrComponent
end. // интерфейс
