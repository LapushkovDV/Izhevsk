* Наименование: Интерфейс приказа РПД-111 ДМС. Перечень полисов                                   *
* Контур/Модуль: Кадры                                                                            *
* Примечание: 30.11.17 Для отражения отмены действия полиса в данное РПД добавлен функционал      *
*             РПД-10 (DelRaise на отдельной вкладке). При утверждении приказа регистрируются      *
*             снятия доплат "ДМС" при наличии DelRaise.                                           *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#231          |19/06/17|Шагубаков М.Р.           |НПО Энергомаш                    *
* Разработка  |#1329         |30/11/17|Евдокимов М.А.           |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_StaffOrders"
#include MoneyRound.vih
#include RPD.vih

#doc
  Интерфейс приказа "ДМС. Перечень полисов"
#end


VipInterface RPD_111(RPD_Base_Raise)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
  function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
  procedure IRPD_Base.MyDel;
end;

//****************************************
Interface RPD_111 '' escclose;
//****************************************

view as
select GP_RaiseHistExt111.Nrec
from GP_RaiseHistExt111,
     Catalogs VarStrah,
     DelRaise,
     Catalogs DelRaiseCat
where
((
  RaiseHist.nrec               == GP_RaiseHistExt111.cRaiseH and
  GP_RaiseHistExt111.cVarStrah == VarStrah.nrec and
  cgDelRaiseRPD10              == DelRaise.wTypeInfo and
  ContDoc.nRec                 == DelRaise.cOrderCont1 and
  DelRaise.cRaiseType          == DelRaiseCat.Nrec
));

//******************************************************************************
//#region Вспомогательные методы

//Устанавливает доступность полей приказа для редактирования
procedure SetFieldsSelectable(value: boolean);
{
  ToggleFieldSelectable(#GP_RaiseHistExt111.PolisDMS, value);
  ToggleFieldSelectable(#VarStrah.Name, value);
  ToggleFieldSelectable(#GP_RaiseHistExt111.DateBeg, value);
  ToggleFieldSelectable(#GP_RaiseHistExt111.DateEnd, value);
  ToggleFieldSelectable(#DelRaiseCat.Name, value);
  ToggleFieldSelectable(#DelRaise.dRaiseAbort, value);
}

//Возвращает текст сообщения пользователю с детализацией о невалидности записи RaiseHist
function GetNotValidRaiseHistUserInfo: string;
{
  var EmptyRequiredFields: string = ''; //незаполненные обязательные поля

  if RaiseHist.dRec = 0
    EmptyRequiredFields += 'С даты';

  if RaiseHist.dDat2 = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'По дату';

  if GP_RaiseHistExt111.PolisDMS = ''
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'Номер полиса ДМС';

  if GP_RaiseHistExt111.cVarStrah = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'Программа страхования';

  result := if(EmptyRequiredFields = '', '',
               ''#3'Не заполнены обязательные поля: '#13 + EmptyRequiredFields);
}

//Проверяет на валидность данные в записи RaiseHist
//Возвращает true, если запись валидна
function RaiseHistIsValid: boolean;
{
  result := RaiseHist.dRec > 0 and
            RaiseHist.dDat2 > 0 and
            GP_RaiseHistExt111.PolisDMS != '' and
            GP_RaiseHistExt111.cVarStrah != 0;
}

//Заполняет маркер m нреками доступных для выбора надбавок по сотруднику personsNrec на дату d
//Raise ищет в утвержденных РПД-111 по сотруднику и в надбавках к назначениям сотрудников с видом
//надбавки из настройки (или подчиненными видами)
procedure FillMarkerWithAllowedRaisesForPick(personsNrec: comp; d: date; var m: tPtr);
{
  if m = 0
    m := InitMarker('', 8, 10, 10, true);

  var raiseTypeNrec: comp;
  raiseTypeNrec := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD111');

  var raiseNrec: comp = 0;

  sql_loop
  select distinct Raise.Nrec
  from ContDoc
  join PartDoc
       on PartDoc.Nrec = ContDoc.cPart
  join TitleDoc
       on TitleDoc.Nrec = PartDoc.cDoc and
          TitleDoc.wStatus = 1
  join RaiseHist
       on RaiseHist.cContDoc = ContDoc.Nrec
  join Raise
       on Raise.Nrec = RaiseHist.cRaise and
          Raise.FromDate <= :(d) and ( Raise.ToDate = 0 or Raise.ToDate >= :(d) )
  where ContDoc.Person = :(personsNrec) and
        ContDoc.TypeOper = 111
  union
  select Raise.Nrec
  from Raise
  join Catalogs catRaiseType
       on catRaiseType.Nrec = Raise.RaiseType and
          ( catRaiseType.Nrec    = :(raiseTypeNrec) or
            catRaiseType.cParent = :(raiseTypeNrec) )
  where Raise.Person = :(personsNrec) and
        Raise.FromDate <= :(d) and
        ( Raise.ToDate = 0 or Raise.ToDate >= :(d) )
  into (raiseNrec)
  {
    InsertMarker(m, raiseNrec);
  }
}

//Запускает интерфейс выбора удаляемого полиса, записывает в DelRaise
procedure PickDelRaise;
{
  var d: date;
  d := TitleDoc.DocDate;

  var allowedRaisesMarker: tPtr;
  allowedRaisesMarker := InitMarker('', 8, 10, 10, true);
  FillMarkerWithAllowedRaisesForPick(Persons.Nrec, TitleDoc.DocDate, allowedRaisesMarker);

  var raiseNrec: comp = 0;

  if (runinterface(GP_Staff::GP_GetRaise, Persons.Nrec, d, raiseNrec, 0,
                   TitleDoc.nRec, allowedRaisesMarker) = cmDefault)
    if getfirst Raise where ((raiseNrec == Raise.nRec)) = tsOk
    {
      //скопировал из RPD_10 CopyRaiseToDelRaise
      set DelRaise.iRaseAttr     := Raise.RaiseAttr;
      set DelRaise.cRaiseType    := Raise.RaiseType;
      set DelRaise.cCurrency     := Raise.RaiseCurr;
      set DelRaise.cAppointments := Raise.Appoint;
      set DelRaise.cRaiseSTS     := Raise.cStRaise;
      set DelRaise.dSum1         := Raise.Sum;
      set DelRaise.dFromDate     := Raise.FromDate;
      set DelRaise.dToDate       := Raise.ToDate;
      set DelRaise.wPrizn2       := Raise.wPriz2;
      set DelRaise.dRaiseAbort   := Raise.dRAbort;
      set DelRaise.dDopDate      := Raise.dDop1;
      set DelRaise.sOrderNmb2    := Raise.OrderNmb2;
      set DelRaise.dOrderDate2   := Raise.OrderDate2;
      set DelRaise.wPrizn        := Raise.wPrizn;
      set DelRaise.cCat1         := Raise.cCat1;
      set DelRaise.cOrderCont2   := Raise.cRDop;
      set DelRaise.cSource       := Raise.nRec;
      set DelRaise.wTypeInfo     := cgDelRaiseRPD10;
      set DelRaise.cOrderCont1   := ContDoc.nRec;
      set DelRaise.cRef1         := Persons.nRec;
      set DelRaise.cRef2         := TitleDoc.nRec;

      if (DelRaise.nRec = 0)
        insert current DelRaise;
      else
        update current DelRaise;
    }
}

//Актуализирует данные в Raise по DelRaise (скопировал из RPD_10)
procedure CopyAllDelRaiseToRaise;
{
  _loop DelRaise
  {
    if getfirst Raise where ((DelRaise.cSource == Raise.nRec)) = tsOK
    {
      set Raise.RaiseAttr  := DelRaise.iRaseAttr;
      set Raise.FromDate   := DelRaise.dFromDate;
      set Raise.ToDate     := DelRaise.dToDate;
      set Raise.wPriz2     := DelRaise.wPrizn2;
      set Raise.dRAbort    := DelRaise.dRaiseAbort;
      set Raise.dDop1      := DelRaise.dDopDate;
      set Raise.OrderNmb2  := DelRaise.sOrderNmb2;
      set Raise.OrderDate2 := DelRaise.dOrderDate2;
      set Raise.wPrizn     := DelRaise.wPrizn;
      set Raise.cCat1      := DelRaise.cCat1;
      set Raise.cRDopEnd   := DelRaise.cOrderCont1;
      set Raise.rSum3      := DelRaise.dSum3;

      update current Raise;
    }
  }
}

