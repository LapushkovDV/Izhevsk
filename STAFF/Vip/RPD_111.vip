Procedure ReReadCurAndSubTable;
{ ReScanPanel(#Contdoc);
  ReScanPanel(#DelRaise);
  ReScanPanel(#RaiseHist);
} //Procedure ReReadCurAndSubTable;

//******************************************************************************
//#region Перекрытые методы

// Процедура удаления своих записей, привязанных у удаляемому приказу
Procedure MyDel;
{
  _loop RaiseHist
  {
    delete all from GP_RAISEHISTEXT111 where ((RaiseHist.Nrec == GP_RaiseHistExt111.cRaiseH));
  }
  delete DelRaise where ((
     cgDelRaiseRPD10    == DelRaise.wTypeInfo and
     ContDoc.nRec       == DelRaise.cOrderCont1
  ));
  inherited::MyDel;
}

//-------------------------------------------------
// Процедура открытия\закрытия полей для редактирования
//-------------------------------------------------
Procedure EnableDisable;
{
  var sTitle:string;
  inherited::EnableDisable;

  cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
  cfsGetProp('WHATISINORDER',cfpTitle, sTitle);
  cfsSetProp('WHATISINORDER',cfpTitle, replace(sTitle,'Приказ','Список'));
  cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер списка');
  cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата списка');
  //-----------------------------
  cfsSetCurrentContainer(cfsGetCurrentContainerSelf);
  //-----------------------------
  if fnFieldsOpen // не утвержден
  {
    SetHelpAndStatusContext(brwRaise111, -1, sci178Esc, 'StaffWinPr');
    SetHelpAndStatusContext(brwRaise10, -1, sci178Esc, 'StaffWinPr');
  }
  else //утвержден
  {
    SetHelpAndStatusContext(brwRaise111, -1, sci1Esc, 'StaffWinPr');
    SetHelpAndStatusContext(brwRaise10, -1, sci1Esc, 'StaffWinPr');
  }
  SetFieldsSelectable(fnFieldsOpen);
  ReReadCurAndSubTable;
} //Procedure EnableDisable;

// Выполняет утверждение текущего приказа
function ChildConfirmOneOrder(cNrec : comp = 0): boolean;
var Marker_Tmp:longint;
    ii:longint;
    _pnrec:comp;
{
  Marker_Tmp  :=InitMarker('', 8, 50, 10, True);
  ClearMarker(Marker_Tmp);
  if cNrec <> 0
  { if GetFirst ContDoc where ((cNrec == ContDoc.NRec))=tsok {};
    cNrec:=0;
  }
  _loop fullcache RaiseHist
  {
    //-----------------
    // Уберем вообще доплату
    //-----------------
    InsertMarker(Marker_Tmp,RaiseHist.Nrec);
    update current RaiseHist set RaiseHist.cContDoc:=0;
  } //_loop fullcache RaiseHist
  //---------------------------------------------
  //result := inherited::ChildConfirmOneOrder(cNrec);
  RESULT:=TRUE;
  //---------------------------------------------
  //#232.#19
  /*
  с таким способом генерится запись в корзину и удаляется
  SRR.DelRaiseMsg(Raise.NRec, Raise.Person, Raise.Appoint);
  _Loop RaiseHist
  { _loop fullcache Raise
      update current Raise set Raise.Appoint    := 0;
  }
  */
  CopyAllDelRaiseToRaise;

  for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
  { if GetMarker(Marker_Tmp,ii,_pNrec)
    { if getfirst RaiseHist where (( _pNrec == RaiseHist.Nrec ))=tsok
      {  update current RaiseHist set RaiseHist.cContDoc:=ContDoc.Nrec;
         if getfirst Raise=tsok
         {  update current Raise set
             Raise.OrderNmb1 := TitleDoc.DocNmb,
             Raise.OrderDate1 := TitleDoc.DocDate,
             Raise.Person:=ContDoc.Person
             ;
            // проапдейтить, а вдруг что-то изменилось
            iHRaise.UpdNeedRHist(Raise.Nrec, 0, Raise.OrderDate1, Raise.OrderNmb1);

         }
      }
    }
  }//for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
  DoneMarker(Marker_Tmp,'');
  _loop fullcache Raise where ((ContDoc.Nrec == Raise.cRDopEnd))
  {
    Raise.ToDate     := Raise.dRAbort;
    Raise.Person     := Persons.nRec;
    Raise.OrderNmb2  := TitleDoc.DocNmb;
    Raise.OrderDate2 := TitleDoc.DocDate;
    Raise.Appoint    := 0;
    if ( update current Raise = tsOK )
      iHRaise.Pers_InsToRHist(Raise.Nrec,
                              Raise.FromDate,
                              Raise.ToDate,
                              word(10),
                              Raise.OrderDate2,
                              Raise.OrderNmb2,
                              ContDoc.Nrec);
  } //_loop fullcache Raise where ((ContDoc.Nrec == Raise.cRDopEnd))
} //function ChildConfirmOneOrder(cNrec : comp = 0): boolean;

//Выполняет проверку текущего приказа
function ChildCheckOneOrder(cNrec : comp = 0): boolean;
{
  //Проверки доплат для полисов ДМС не нужны
  result := true;
  if cNrec <> 0
  { if GetFirst ContDoc where ((cNrec == ContDoc.NRec))=tsok {};
    cNrec:=0;
  }
  var _COl:longint=0;
  var _DocNMB:string='';
  var _DocDate:Date=ZeroDate;
  var _NRAZD:word;
  _loop fullcache RaiseHist
  { if getfirst GP_RaiseHistExt111<>tsok then continue;
    if GP_RaiseHistExt111.PolisDMS='' then continue;

    SQL Select Count(GP_RaiseHistExt111.PolisDMS)
      ,Max(TitleDoc.DOCNMB)
      ,Max(TitleDoc.DOCDate)
      ,Max(PartDoc.NRAZD)
    FROM GP_RaiseHistExt111
    inner join RaiseHist on RaiseHist.Nrec= GP_RaiseHistExt111.cRaiseH
    inner join ContDoc on ContDoc.Nrec = RaiseHist.cContDoc
    inner join PartDoc on PartDoc.Nrec = ContDoc.cPart
    inner join TitleDoc on TitleDoc.Nrec = PartDoc.cDoc
    left outer join DelRaise on//будем искать не отмененные доплаты по всем приказам
                    // DelRaise.cOrderCont1 = :(ContDoc.Nrec)
                    DelRaise.cOrderCont1> RaiseHist.cContDoc
                and DelRaise.wTypeInfo =1 //cgDelRaiseRPD10
                and DelRaise.cSource = RaiseHist.cRaise

    where GP_RaiseHistExt111.PolisDMS=:(GP_RaiseHistExt111.PolisDMS)
      and GP_RaiseHistExt111.Nrec<>:(GP_RaiseHistExt111.Nrec)
      and (DelRaise.Nrec is Null)
    into (_COl,_DocNMB,_DocDate,_NRAZD)
    ;
    if _col>0
    { Result:=false;
      SetErrorOrder('Полис '+GP_RaiseHistExt111.PolisDMS+' уже есть в приказе '+_DocNMB
        +DateToStr(_DocDate,' от DD.MM.YYYY ')+', раздел '+_NRAZD);
    }
  } //_loop fullcache RaiseHist
} //function ChildCheckOneOrder(cNrec : comp = 0): boolean;

//#endregion Перекрытые функции
//******************************************************************************

TableEvent table RaiseHist;
  cmSetDefault:
  {
    inherited::HandleEvent(cmSetDefault);
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD111');
    if (ParentSav <> 0)
    {
      RaiseHist.cRaiseType := ParentSav;
      RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
      Raise.RaiseAttr := RaiseHist.iHAttr;
      Raise.RaiseType := ParentSav;
    }
    RaiseHist.Nrec := GetNextNrec(tnRaiseHist, 0);
    clearbuffer(#GP_RaiseHistExt111);
    GP_RaiseHistExt111.Nrec := GetNextNrec(tnGP_RaiseHistExt111, 0);
    GP_RaiseHistExt111.cRaiseH := RaiseHist.Nrec;
    SetModified(true);
  }
  cmInsertRecord:
  {
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      GP_RaiseHistExt111.cRaiseH := RaiseHist.nrec;
      GP_RaiseHistExt111.cPerson := RaiseHist.cPsn;
      insert current GP_RaiseHistExt111;
    }
  }
  cmUpdateRecord:
  {
    if inherited::handleevent(cmUpdateRecord) = heOk
    {
      if isValidAll(#GP_RaiseHistExt111)
      {
        GP_RaiseHistExt111.cRaiseH := RaiseHist.nrec;
        GP_RaiseHistExt111.cPerson := RaiseHist.cPsn;
        update current GP_RaiseHistExt111;
      }
    }
  }
  cmDeleteRecord:
  {
    if isValidAll(#GP_RaiseHistExt111)
      delete current GP_RaiseHistExt111;
    inherited::handleevent(cmDeleteRecord);
  }
  cmCheckRecord:
  { if TitleDoc.wStatus<>1
    { if not RaiseHistIsValid
      {
        Message(GetNotValidRaiseHistUserInfo, Error);
        Abort;
      }
      inherited::handleevent(cmCheckRecord);
    }
  }
end; //TableEvent RaiseHist

TableEvent table ContDoc;
  cmInsertRecord:
  {
    //При добавлении нового сотрудника в приказ вызываем выбор вида доплаты/надбавки
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      if SelectFormat(brwRaise111)
      {
        SelectField(#RaiseCat.Name);
        PutCommand(cmPick);
      }
    }
  }
end; //TableEvent ContDoc

TableEvent table DelRaise;
  cmSetDefault:
  {
    ClearBuffer(tnDelRaise);
    DelRaise.cOrderCont1 := ContDoc.nRec;
    DelRaise.cRef1       := Persons.nRec;
    DelRaise.wTypeInfo   := cgDelRaiseRPD10;
    DelRaise.cRef2       := TitleDoc.nRec;
    DelRaise.nRec        := comp(0);
  }
  cmUpdateRecord:
  {
    if Update Current DelRaise = tsOk
      Update Current ContDoc;
  }
  cmDeleteRecord:
  {
    if (Message(chr(3) + 'Удалить ' + DelRaiseCat.Name + ' ?', YesNo) = Yes)
    {
      Delete current DelRaise;
      ReReadRecord(tnDelRaise);
    }
  }
end; //TableEvent DelRaise

HandleEvent

  cmCheckField:
  {
    case CurField of
      #GP_RaiseHistExt111.PolisDMS,
      #VarStrah.name,
      #GP_RaiseHistExt111.DateBeg,
      #GP_RaiseHistExt111.DateEnd,
      #GP_RaiseHistExt111.SummaVoz:
      {
        SetModified(true);
      }
      #RaiseHist.dRec:
      {
        Set GP_RaiseHistExt111.DateBeg := RaiseHist.dRec;
      }
      #RaiseHist.dDat2:
      {
        Set GP_RaiseHistExt111.DateEnd := RaiseHist.dDat2;
      }
    end;
    inherited::handleevent(cmCheckField);
  }

  cmPick:
  {
    case CurField of
      #RaiseCat.Name:
      {
        ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD111');

        var wPickResult: word = cmCancel;
        if GetFirst FastFirstRow Catalogs where ((ParentSav == Catalogs.cParent)) = tsOk
          wPickResult := RunInterface(Z_STAFFCAT::PickCatalog2, 0, ParentSav, 0, 0);
        else
          wPickResult := RunInterface(GP_STAFF::GP_PickCatalogWithOneRec, -17, ParentSav);

        if (wPickResult = cmDefault)
        {
          //PreviousType := RaiseHist.cRaiseType; // взвести флаг того, что поменяли наименование
          set RaiseHist.cRaiseType := ParentSav;
          set RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
          set Raise.RaiseAttr := RaiseHist.iHAttr;
          set Raise.RaiseType := ParentSav;
          ReReadRecord(tnCatalogs);
        }

        exit;
      }
      #DelRaiseCat.Name:
      {
        PickDelRaise;
        exit;
      }
    end;
    inherited::HandleEvent(cmPick);
    case CurField of
      #VarStrah.Name:
      {
        if RunInterface(Z_StaffCat::PickCatalog2, 4006, GP_RaiseHistExt111.cVarStrah, 0) = cmDefault
          SetModified(True);
        ReReadRecord(tnCatalogs);
      }
      #persons.fio:
      {
        if isvalidall(#Persons)
        {
          //Запрещаем пользователю выбирать умерших сотрудников
          if (Persons.ddop1 != 0)
          {
            message('Запрещено выбирать сотрудников с заполненным полем "Дата смерти"', error);
            PutCommand(cmDelOnProtect);
          }
          else
          {
            //Если пользователь выбрал корректного сотрудника и это новая позиция -
            //сразу вызываем вставку этой записи, чтобы далее вызвать добавление вида доплаты/надбавки
            if(isNew) UpdateTable();
            SelectFieldInFormat(brwRaise111, #RaiseCat.Name);
          }
        }
      }
    end;
  }

  cmMulSelDO:
  {
    if UpdateTable
      UpdNeedField(CurField);
  }

  cmCalc:
  {
    update current ContDoc set TypeOper = 9;
    inherited::Handleevent(cmCalc);
    update ContDoc where ((PartDoc.nrec == contdoc.cPart)) set TypeOper = 111;
    _loop Contdoc where ((PartDoc.nrec == contdoc.cPart))
      NOAA.DeleteAgreementLinks(coContDoc, ContDoc.nrec)
  }

  cmHotKeys:
  {
    //Если приказ не утвержден
    if (TitleDoc.wStatus = 0 or (boUsePartOrders and TitleDoc.wStatus = 3
      and (ContDoc.wYearPr = 0 or ContDoc.wYearPr = 3))) // не утвержден
    {
      var LocalMenu:longint;
      //Добавим пункт меню для импорта реестра гостиничных услуг

      LocalMenu := LoadMenu('Rpd_MenuCopy');
      AddMenuItem(LocalMenu, 'Импорт новых полисов ДМС', cmValue31);
      AddMenuItem(LocalMenu, 'Импорт новых полисов ДМС (формат с изменениями)', cmValue32);
      PutHotCommand(RunLoadMenu(LocalMenu));
    }
  }

  cmValue31:
  {
    OnIdle(0);
    if isValidAll(#contDoc)
    { message('В РПД уже есть записи, Импорт запрещен!' );
      exit;
    }
    else
    { RunInterface('GP_Staff::GP_RPD111_Import', PartDoc.nrec);
      ReReadRecord;
    }
  }

  cmValue32:
  {
    OnIdle(0);
    if isValidAll(#contDoc)
    { message('В РПД уже есть записи, Импорт запрещен!' );
      exit;
    }
    else
    { RunInterface('GP_Staff::GP_RPD111_Import_v2', PartDoc.nrec, '');
      ReReadRecord;
    }
  }

  cmOnVipload:
  { timelog_init;
    inherited::Handleevent(cmOnVipload);
  }
  cmOnVipUnload:
  {
    inherited::Handleevent(cmOnVipUnload);
    cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
    cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер приказа');
    cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата приказа');
  }

end; //handleevent

End.
