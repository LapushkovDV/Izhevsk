#ifndef __GP_Staff_Func__
#define __GP_Staff_Func__

#component "GP_STAFF"
//-------------------------------------
#doc
Кадровские функции
<p>1. Поиск и создание организации.
Запрос на синхронизацию ВА в PErsons и KatOrg
SQL Insert into AttrVal (wTable,cRec,cAttrnam,vComp,vString)
Select
      1418
    ,AV_Pers.vComp,AN_Org.Nrec
    ,Persons.nrec,Persons.Fio
From Persons
Inner join AttrNam AN_Pers on AN_Pers.wTable=25001
                      and AN_Pers.Name='Физическое лицо (контрагент)'
Inner join AttrNam AN_Org on AN_Org.wTable=1418
                      and AN_Org.Name='.Сотрудник (ссылка на карточку)'
Inner join AttrVal AV_Pers On AV_Pers.wTable=25001
                          and AV_Pers.cAttrNam=AN_Pers.Nrec
                          and AV_Pers.cRec = Persons.Nrec
                          and AV_Pers.vComp<>#Comp(0)
Left join AttrVal AV_Org On AV_Org.wTable=1418
                          and AV_Org.cAttrNam=AN_Org.Nrec
                          and AV_Org.cRec = AV_Pers.vComp

where AV_Org.Nrec is Null;

#end
//-------------------------------------

vipinterface GP_Staff_Func
  Licensed(free);
Public:
//------------------------------------------------------------------------------
constructor Init;

#doc
   Получить последнюю ошибку
#end
Function GetLastError:string;

//--------------------------------
#doc
   Поиск организации по ссылке на сотрудника, фио и дате рождения
#end
Function FindOrgByPers(
   _pPersons:comp
  ;_sFio  :string
  ;_dBornDate:Date
) : comp;

//=====================================
#doc
 установить связь между картотекой сотрудников и организацией
#end
Procedure SetRef2Org(_pKatOrg:comp;_pPersons:comp);

//--------------------------------
#doc
   Создание организации по ссылке на сотрудника
#end
Function CheckKatOrgByPers(
   _pPersons:comp
  ;_need_create :boolean
  ;_boMes       :boolean=True
) : comp;

//--------------------------------
#doc
   Обновление данных по организации
   При отсутствии связи - обязательное условие - полное совпадение ФИО.
#end
Function UpdateOrgFromPersons(_PKatOrg:comp):boolean;

//--------------------------------
#doc
 Проинициализировать мемо поле
#end
function InitMem(_wtable :word ; _cRec: Comp): Boolean;
//---------------------------------------
#doc
закрыть мемополе
#end
procedure DoneMemo(_wtable:word=0;need_upd:boolean=false);
//---------------------------------------
#doc
открыть, прочитать,закрыть мемополе
#end

function GetAllStringFromMemo(_wtable :word ; _cRec: Comp;var S: String): Boolean;

#doc
 InitMemo(coPrMemo, PrMemo.nrec);
 var _s:string;
 do
 { if  not GetOneStringFromMemo(_s) then break
 } while True
 DoneMemo;
#end
function GetOneStringFromMemo(var S: String): Boolean;

end;
#end //GP_KPI_TypeVedEdit
