/*************************************************************************************************\
* Наименование:  Информация по штатному расписанию                                                *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3326          |30/08/18 |Ермолов К.Р.             |НПО Энергомаш                  *
\*************************************************************************************************/

#include userreport.vih
#include staffstruct.vih
#include GP_ManualNotes.vih

interface gp_shtatrasp 'Параметры отчета' gray
Show at (,,26,5);

table struct tab1
(
ssnrec: comp,
dinput: date,
dclose: date,
podrkod: string,
podrname: string,
otdelkod: string,
otdelname: string,
post: string,
razr: word,
kateg: word,
usl: string,
oklad: decimal(31,15),
okladmin: decimal(31,15),
okladmax: decimal(31,15),
workstations: double,
fio: string,
strtabn: string,
kindapp: string,
zamname: string
)
with index
(
i1 = otdelkod
)
;

create view

var
excelpath, sZamName: string;
counter, countermatrix: longint;
data: date;
cSsNrec: comp;
StaffFunc: StaffStruct;
MN: GP_ObjManualNotes(GP_ManualNotes) New;

as select tab1.otdelkod
from
     tab1
   , staffstruct
   , catalogs
   , klkatego
   , synonym tab1 synTab1
   , extcatlinks
   , katpodr
   , synonym katpodr k1
   , appointments
   , persons
   , MN

where ((
      25018 == MN.wTbl
      and Staffstruct.nrec == MN.cRec
))
;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  data, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    На дату:.@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  data:= cur_date;
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from tab1;

  sql
  select staffstruct.nrec, staffstruct.dinput, staffstruct.dclose, katpodr1.kod, katpodr1.name, katpodr.kod, katpodr.name, c1.name, staffstruct.category, klkatego.kod,
  c2.code, staffstruct.taxrate, staffstruct.minsumma, staffstruct.maxsumma, staffstruct.workstations/10*10, persons.fio, persons.strtabn, c3.name, ''
  from staffstruct
  inner join extcatlinks on extcatlinks.staffcat = staffstruct.department
  inner join katpodr on katpodr.nrec = extcatlinks.extcat
  inner join katpodr katpodr1 on  katpodr1.kod = case when katpodr1.kod <> katpodr.kod then substring(katpodr.kod,1,3) end or (katpodr1.nrec = katpodr.nrec and katpodr1.kod = substring(katpodr.kod,1,3))
  left join catalogs c1 on c1.nrec = staffstruct.post
  left join catalogs c2 on c2.nrec = staffstruct.workcond
  left join klkatego on klkatego.nrec = staffstruct.empcategory
  left join appointments on appointments.staffstr = staffstruct.nrec
  inner join persons on persons.appointcur = appointments.nrec
  join catalogs on catalogs.name = 'В связи с временным отсутствием основного работника'
  left join catalogs c3 on c3.nrec = appointments.kindapp and (c3.cparent = catalogs.nrec or c3.nrec = catalogs.nrec)
  where staffstruct.dinput <= :(data) and (staffstruct.dclose > :(data) or staffstruct.dclose = 0) and katpodr.kod is not null
  group by staffstruct.nrec, staffstruct.dinput, staffstruct.dclose, katpodr1.kod, katpodr1.name, katpodr.kod, katpodr.name, c1.name, staffstruct.category, klkatego.kod,
  c2.code, staffstruct.taxrate, staffstruct.minsumma, staffstruct.maxsumma, staffstruct.workstations, persons.fio, persons.strtabn, c3.name
  into tab1
  ;

  _loop tab1
  {
    if tab1.kindapp <> ''
    {
      cSsNrec:= tab1.ssnrec;

      if getfirst synTab1 where ((tab1.strtabn == synTab1.strtabn(noindex) and '' == synTab1.kindapp(noindex))) = tsok
      delete current synTab1;

      _loop synTab1 where ((cSsNrec == synTab1.ssnrec(noindex) and '' == synTab1.kindapp(noindex)))
      {
        sZamName:= synTab1.fio;

        delete current synTab1;
      }

      update current tab1 set tab1.zamname:= sZamName;
    }
    else if StaffFunc.GetWorkersStaff(tab1.ssNrec, data) > 0 then delete current tab1;
  }

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_shtatrasp.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  counter:= 3;
  countermatrix:= 0;

  xlsetcellstringvalue('ИНФОРМАЦИЯ ПО ШТАТНОМУ РАСПИСАНИЮ НА ' + data, 1, 1, 1, 1);

  xlCreateMatrix(1000, 19);

  _loop tab1
  {
    countermatrix++;

    xlDtWriteToMatrix(countermatrix, 1, tab1.dinput);
    xlDtWriteToMatrix(countermatrix, 2, tab1.dclose);
    xlStWriteToMatrix(countermatrix, 3, tab1.podrkod);
    xlStWriteToMatrix(countermatrix, 4, tab1.podrname);
    xlStWriteToMatrix(countermatrix, 5, tab1.otdelkod);
    xlStWriteToMatrix(countermatrix, 6, tab1.otdelname);
    xlStWriteToMatrix(countermatrix, 7, tab1.post);
    xlStWriteToMatrix(countermatrix, 8, tab1.razr);
    xlStWriteToMatrix(countermatrix, 9, tab1.kateg);
    xlStWriteToMatrix(countermatrix, 10, tab1.usl);
    xlDoWriteToMatrix(countermatrix, 11, tab1.oklad);
    xlDoWriteToMatrix(countermatrix, 12, tab1.okladmin);
    xlDoWriteToMatrix(countermatrix, 13, tab1.okladmax);
    xlDoWriteToMatrix(countermatrix, 14, tab1.workstations);
    xlStWriteToMatrix(countermatrix, 15, tab1.fio);
    xlStWriteToMatrix(countermatrix, 16, tab1.strtabn);
    xlStWriteToMatrix(countermatrix, 17, tab1.kindapp);
    xlStWriteToMatrix(countermatrix, 18, tab1.zamname);

    if getfirst MN where ((tab1.ssnrec == MN.cRec(noindex))) = tsok
    {
      xlStWriteToMatrix(countermatrix, 19, MN.NoteStr);
    }

    if countermatrix = 1000
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  countermatrix:= 0;
  xlClearMatrix;

  _loop staffstruct where staffstruct.dinput <= data and (staffstruct.dclose > data or staffstruct.dclose = 0) and staffstruct.department <> comp(0)
  {
    if StaffFunc.GetWorkersStaff(staffstruct.nrec, data) > 0
    {
      if getfirst tab1 where ((staffstruct.nrec == tab1.ssnrec(noindex))) <> tsok
      {
        countermatrix++;
        xlDtWriteToMatrix(countermatrix, 1, staffstruct.dinput);
        xlDtWriteToMatrix(countermatrix, 2, staffstruct.dclose);
        xlStWriteToMatrix(countermatrix, 8, staffstruct.category);
        xlDoWriteToMatrix(countermatrix, 11, staffstruct.taxrate);
        xlDoWriteToMatrix(countermatrix, 12, staffstruct.minsumma);
        xlDoWriteToMatrix(countermatrix, 13, staffstruct.maxsumma);
        xlDoWriteToMatrix(countermatrix, 14, staffstruct.workstations/10*10);
        xlStWriteToMatrix(countermatrix, 16, 'ВАКАНСИЯ');

        _loop appointments where ((staffstruct.nrec == appointments.staffstr))
        {
          if getfirst persons where ((appointments.nrec == persons.appointcur(noindex))) = tsok then xlStWriteToMatrix(countermatrix, 16, 'ВРЕМЕННО СВОБОДНО');
        }

        if getfirst extcatlinks where ((staffstruct.department == extcatlinks.staffcat(noindex))) = tsok
        {
          if getfirst katpodr where ((extcatlinks.extcat == katpodr.nrec)) = tsok
          {
            xlStWriteToMatrix(countermatrix, 5, katpodr.kod);
            xlStWriteToMatrix(countermatrix, 6, katpodr.name);

            _loop k1 where substr(katpodr.kod, 1, 3) = k1.kod or (k1.nrec = katpodr.nrec and k1.kod = substr(katpodr.kod,1,3))
            {
              xlStWriteToMatrix(countermatrix, 3, k1.kod);
              xlStWriteToMatrix(countermatrix, 4, k1.name);
            }
          }
        }

        if getfirst catalogs where ((staffstruct.post == catalogs.nrec)) = tsok
        {
          xlStWriteToMatrix(countermatrix, 7, catalogs.name);
        }

        if getfirst catalogs where ((staffstruct.workcond == catalogs.nrec)) = tsok
        {
          xlStWriteToMatrix(countermatrix, 10, catalogs.code);
        }

        if getfirst klkatego where ((staffstruct.empcategory == klkatego.nrec)) = tsok
        {
          xlStWriteToMatrix(countermatrix, 9, klkatego.kod);
        }

        if getfirst MN where ((Staffstruct.nrec == MN.cRec(noindex))) = tsok
        {
          xlStWriteToMatrix(countermatrix, 19, MN.NoteStr);
        }
      }
    }

    if countermatrix = 1000
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  countermatrix:= 0;
  xlFreeMatrix;

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter - 1, 19);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_shtatrasp Implements IUserReport;
Interface UserReport_shtatrasp;

Procedure Run;
Begin
  runinterface(gp_shtatrasp);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Информация по штатному расписанию';
End;

Function GetGroupName (Level : Word) : String;
Begin
#__UNUSED__(Level)
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
