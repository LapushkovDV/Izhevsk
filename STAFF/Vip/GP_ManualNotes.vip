#include GP_ManualNotes.vih
interface GP_ManualNotes;

var CurTbl:word;
    CurRec:comp;

create view ltManualNotes
as select GP_ManualNotes.Nrec
from
  GP_ManualNotes;

window WinEdit 'Ручные примечания' Blue, EscClose;
show(10,10,160,25);

browse brManualNotes (,,sci178Esc);
table GP_ManualNotes;
fields
  GP_ManualNotes.NoteNumber '№':[2],Skip,Centered,NoAutoSize;
  GP_ManualNotes.ATL_LASTDATE 'Дата модификации':[10],Skip,Centered,Protect,NoAutoSize;
  GP_ManualNotes.Note 'Примечание' :[100],NoProtect;
end;

HandleEvent
cmInit:{
  ReReadRecord(tnGP_ManualNotes);
}
cmDone:{
  if (not UpdateTable) {
    abort;
    exit;
  }

  if (getfirst GP_ManualNotes = tsok) {};
}
cmDelete:{
  if (message('Удалить запись?',yesno+Warning+mfSwapButtons)<>cmYes) stop;
}
end;
end;//WinEdit

create view ltLocal
as select GP_ManualNotes.nrec
from
  GP_ManualNotes
where
((   CurTbl==GP_ManualNotes.wTbl
 and CurRec==GP_ManualNotes.cRec
));

function GetNextNoteNumber:longint;
{
  if (ltLocal.getlast GP_ManualNotes = tsok)
    result:=ltLocal.GP_ManualNotes.NoteNumber+1
  else
    result:=1;
}

TableEvent Table GP_ManualNotes;
cmSetDefault:{
  GP_ManualNotes.wTbl:=CurTbl;
  GP_ManualNotes.cRec:=CurRec;
  GP_ManualNotes.NoteNumber:=GetNextNoteNumber;
}
cmInsertRecord:{
  if (GP_ManualNotes.wTbl=0 or GP_ManualNotes.cRec=0) {
    if (CurTbl=0 or CurRec=0) exit;

    GP_ManualNotes.wTbl:=CurTbl;
    GP_ManualNotes.cRec:=CurRec;
    GP_ManualNotes.NoteNumber:=GetNextNoteNumber;
  }

  insert current GP_ManualNotes;
}
cmUpdateRecord:{
  update current GP_ManualNotes;
}
cmDeleteRecord:{
  delete current GP_ManualNotes;
}
end;

function DelRec(wTbl:word;cRec:comp):boolean;
{
  result:=delete GP_ManualNotes where((wTbl==GP_ManualNotes.wTbl and cRec==GP_ManualNotes.cRec))=tsok;
}

function AddRec(wTbl:word;cRec:comp;Note:string):boolean;
{
  result:=false;

  if (wTbl=0 or cRec=0 or Note='') exit;

  CurTbl:=wTbl;
  CurRec:=cRec;

  ClearBuffer(tnGP_ManualNotes);
  GP_ManualNotes.wTbl:=CurTbl;
  GP_ManualNotes.cRec:=CurRec;
  GP_ManualNotes.Note:=Note;
  GP_ManualNotes.NoteNumber:=GetNextNoteNumber;
  result:=insert current GP_ManualNotes = tsok;
}

function UpdateFirstRec(wTbl:word;cRec:comp;Note:string):boolean;
{
  result:=false;

  if (wTbl=0 or cRec=0 or Note='') exit;

  CurTbl:=wTbl;
  CurRec:=cRec;

  if (ltLocal.getfirst GP_ManualNotes <> tsok)
    result:=AddRec(wTbl,cRec,Note)
  else {
    ltLocal.GP_ManualNotes.Note:=Note;
    result:=ltLocal.update current GP_ManualNotes = tsok;
  }
}

function Pick(wTbl:word;cRec:comp):boolean;
{
  result:=false;

  if (wTbl=0 or cRec=0) exit;

  CurTbl:=wTbl;
  CurRec:=cRec;

  RunWindowModal(WinEdit);

  result:=true;
}

property wTbl:word absolute GP_ManualNotes.wTbl read;

property cRec:comp absolute GP_ManualNotes.cRec read;

property NoteNumber:longint absolute GP_ManualNotes.NoteNumber read;

property NoteStr:string absolute GP_ManualNotes.Note read;

index iByTblRec auto;

end.

//Для поддержания ссылочной целостности
handler with replace GP_ManualNotesDelPersons on trigger Persons before Delete [99]
action
{
  var buf : record as table Persons;
  GetTableBuffer(buf);

  var oManualNotes:GP_ManualNotes;
  result:=oManualNotes.DelRec(coPersons,buf.NRec);
}

handler with replace GP_ManualNotesDelStaffStruct on trigger StaffStruct before Delete [99]
action
{
  var buf : record as table StaffStruct;
  GetTableBuffer(buf);

  var oManualNotes:GP_ManualNotes;
  result:=oManualNotes.DelRec(coStaffStruct,buf.NRec);
}
