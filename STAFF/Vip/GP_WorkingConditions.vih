#ifndef __GP_WorkingConditions_VIH__
#define __GP_WorkingConditions_VIH__

#component "GP_Staff"

ObjInterface GP_ObjWorkingConditions;
  function DelRec(cCat:comp):boolean;

  function PickPayForHarmWork:boolean;
  function DelPayForHarmWork:boolean;
  function PickVacForHarmWork:boolean;
  function DelVacForHarmWork:boolean;
  function PickWorkRegime:boolean;
  function DelWorkRegime:boolean;

  property cCat:comp read;
  property PayForHarmWork:string read;
  property cPayForHarmWork:comp read;
  property PayForHarmWorkProc:double read write;
  property VacForHarmWork:string read;
  property cVacForHarmWork:comp read;
  property VacationDays:double read write;
  property WorkRegime:string read;
  property cWorkRegime:comp read;

  index iByCat = cCat;

  event function GetCurCatalogs(var cCat:comp):boolean;
end;

VipInterface GP_WorkingConditions Implements GP_ObjWorkingConditions;

#endif
