/*************************************************************************************************\
* Наименование:  Информация о сотрудниках работающих на текущую дату                              *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#3271          |20/08/18 |Ермолов К.Р.             |НПО Энергомаш                  *
* Разработка  |#58655         |14/09/23 |kurennykh                |НПО Энергомаш                  *
* Разработка  |#62568         |24/11/23 |kurennykh                |НПО Энергомаш                  *
\*************************************************************************************************/

#include userreport.vih
#include runstaj.vih
#include AdrFunc.vih
#include GP_StajFunc.vih


interface gp_sotrudniki 'Параметры отчета' gray
Show at (,,26,5);
#include GP_StajFunc.var
table struct tab1
(
persnrec: comp,
appointnrec: comp,
staffstr: comp,
postnrec: comp,
stajnrec: comp,
tabnum: string,
fio: string,
podr: string,
podrname: string,
otdel: string,
otdelname: string,
post: string,
pol: string,
addrlive: comp,
addrpasp: comp,
kateg: word,
sovm: string,
borndate: date,
dognmb: string,
dogdate: date,
appdate: date,
dateend: date,
ispsrok: date,
paspser: string,
paspnmb: string,
paspvyd: string,
paspodr: string,
paspdate: date,
invaliddate: date,
obr: string,
//dismissdate : date,
disdate : date,
snils : string,
email : string,
Phone : string,
FirstAppDate : date,
CountStavok : double,
StajStrah : comp,
StrahStajFromDate : date,
INN : string,
workond : string,
prof : string,
podr_zgd : string,
ok3code  : string,
rejim    : string,
dop3     : string,
uchstep     : string
)
with index
(
i1 = tabnum + persNrec
)
;

table struct tZGD
(
pNrec: comp,
zgd: string
)
with index
(
i1 = pNrec
)
;

create view

var
excelpath, zgd: string;
counter, countermatrix: longint;
vozr: integer;
data: date;
god, mes, wDay, staj: double;
_runstaj: RunStaj;
AdrFunc: AddressFunc;

as select tab1.tabnum from tab1, tZGD;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  data, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    На дату:.@@@@@@@@@@

    <.Сформировать!.>

    >>
end;

handleevent

cmInit:
{
  data:= cur_date;
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from tab1;
  delete all from tZGD;

  sql
  select distinct
        persons.nrec
      , coalesce(apptmp.nrec, appointments.nrec)
      , coalesce(apptmp.staffstr, appointments.staffstr)
      , c1.nrec
      , servlen.position
      , persons.strtabn
      , persons.fio
      , katpodr1.kod
      , katpodr1.name
      , katpodr.kod
      , katpodr.name
      , c1.name
      , persons.sex
      , a1.nrec
      , addressn.nrec
      , klkatego.kod
      , klsovm.nsovm
      , persons.borndate
      , spallstaff.resstring[1]
      , spallstaff.resdate[1]
      , persons.appdate
      , coalesce(apptmp.dateend, appointments.dateend)
      , persons.testperiod
      , passports.ser
      , passports.nmb
      , passports.givenby
      , passports.GIVENPODR
      , passports.givendate
      , cast(max(p1.givendate) as date)
      , c2.name
      , persons.disdate
      , snils.nmb as snils
      , email.email
      , MobilePhone.Phone
      , FirstAppoint.appDate
      , coalesce(apptmp.RATE, APPOINTMENTS.RATE)
      , StajStrah.position
      , StajStrah.FromDate
      , INN.nmb as INN
      , catwk.name as workond
      , lschet.PROFS
      , EM_GET_ZGD_PODR(katpodr.nrec)
      , ok3.s
      , cast(klrejim.rejim as string)
      , dop3.name
      , uchstep.name
  from persons
  inner join appointments on appointments.person = persons.nrec and appointments.appointdate <= :(data) and (appointments.dismissdate >= :(data) or appointments.dismissdate = 0) and (appointments.lprizn = 0 or appointments.lprizn = 100)
  left join appointments apptmp on apptmp.person = persons.nrec and apptmp.appointdate <= :(data) and (apptmp.dismissdate >= :(data) or apptmp.dismissdate = 0) and (apptmp.dateend >= :(data) or apptmp.dateend = 0) and apptmp.lprizn = 70
  left join staffstruct shr on shr.nrec=coalesce(apptmp.staffstr, appointments.staffstr)
  left join catalogs dop3 on dop3.nrec=shr.cinf3
  left join badge bd10 on 10=bd10.badgemonth and persons.nrec=bd10.person //степень кандидата
  left join badge bd2 on 2=bd2.badgemonth and persons.nrec=bd2.person // степень доктора
  left join catalogs uchstep on uchstep.nrec=coalesce(bd10.appoint,bd2.appoint)
  inner join extcatlinks on extcatlinks.staffcat = coalesce(apptmp.department, appointments.department)
  inner join katpodr on katpodr.nrec = extcatlinks.extcat
  inner join katpodr katpodr1 on  katpodr1.kod = case when katpodr1.kod <> katpodr.kod then substring(katpodr.kod,1,3) end or (katpodr1.nrec = katpodr.nrec and katpodr1.kod = substring(katpodr.kod,1,3))
  left join catalogs c1 on c1.nrec = coalesce(apptmp.post, appointments.post)
  left join klkatego on klkatego.nrec = coalesce(apptmp.empcategory, appointments.empcategory)
  left join klsovm on klsovm.sovm = persons.csovm
  left join passports on passports.nrec = persons.passprus and passports.syscode = 502
  left join passports p1 on p1.person = persons.nrec and p1.syscode = 560 and p1.FILIALNO = 0
  left join passports snils on snils.person = persons.nrec and snils.syscode = 501 and snils.FILIALNO = 0
  left join passports inn on inn.person = persons.nrec and inn.syscode = 505 and inn.FILIALNO = 0
  left join addressn on addressn.nrec = persons.passpaddr
  left join addressn a1 on a1.nrec = persons.liveaddr
  left join COMMUNICATIONS email ON email.OBJTYPE = 3 AND email.PERSON = persons.nrec AND email.COMTYPE = :(000A00000003995Dh)
  left join sterr on sterr.nrec = addressn.csterr
  left join sterr s1 on s1.nrec = a1.csterr
  left join catalogs c2 on c2.nrec = persons.education
  join catalogs on catalogs.name = 'Стаж работы на предприятии'
  left join servlen on servlen.person = persons.nrec and servlen.position = catalogs.nrec and servlen.currec = 1

  left join klrejim on klrejim.nrec = coalesce(apptmp.WORKREGIME, appointments.WORKREGIME)

  join catalogs CatStajStrah  on CatStajStrah.name = 'Страховой стаж'
  left join servlen StajStrah on StajStrah.person  = persons.nrec and StajStrah.position = CatStajStrah.nrec and StajStrah.currec = 1 and StajStrah.ToDate = 0

  left join spallstaff on spallstaff.nrec = case when coalesce(apptmp.rescomp[1], appointments.rescomp[1])=0 then appointments.rescomp[1] else coalesce(apptmp.rescomp[1], appointments.rescomp[1]) end  //coalesce(apptmp.rescomp[1], appointments.rescomp[1])

  left join catalogs catwk on coalesce(apptmp.workcond, appointments.workcond) = catwk.nrec
  left join lschet on lschet.TPERSON  = persons.nrec and (LSCHET.DATUV = 0 or LSCHET.DATUV >= :(data))  and  LSCHET.sovm <> 3

  outer apply (
                SELECT top 1
                  com.addr as phone
                from COMMUNICATIONS com JOIN Catalogs phone ON com.COMTYPE = Phone.nrec
                WHERE com.OBJTYPE = 2
                      AND phone.name = 'Мобильный телефон'
                      AND com.person = persons.nrec
  ) MobilePhone

  outer apply (
                SELECT
                  min(AppointDate) appDate
                from appointments AppDiss
                where AppDiss.PERSON = persons.nrec
                      and AppDiss.lPrizn in(100,0)
  ) FirstAppoint

  outer apply (
                select top 1
                  catok3.code as s
                from spallstaff spok3
                inner join catalogs catok3 on spok3.cbaset = catok3.nrec
                where spok3.clinkt = coalesce(apptmp.staffstr, appointments.staffstr)
                      and spok3.wnocon = 25018
                      and spok3.wchoise = 9876
  ) ok3

  where     persons.strtabn <> ''
        and persons.isemployee in ('С', 'У')
        and katpodr.name not in('_Профком', '_Студенты', '_Физические лица', 'Ветераны')
        and substring(katpodr.kod,1,3) <> '972'
  group by persons.nrec
      , coalesce(apptmp.nrec, appointments.nrec)
      , coalesce(apptmp.staffstr, appointments.staffstr)
      , c1.nrec
      , servlen.position
      , persons.strtabn
      , persons.fio
      , katpodr1.kod
      , katpodr1.name
      , katpodr.kod
      , katpodr.name
      , c1.name
      , persons.sex
      , a1.nrec
      , addressn.nrec
      , klkatego.kod
      , klsovm.nsovm
      , persons.borndate
      , spallstaff.resstring[1]
      , spallstaff.resdate[1]
      , persons.appdate
      , coalesce(apptmp.dateend, appointments.dateend)
      , persons.testperiod
      , passports.ser
      , passports.nmb
      , passports.givenby
      , passports.GIVENPODR
      , passports.givendate
      , c2.name
      , persons.disdate
      , snils.nmb
      , email.email
      , MobilePhone.Phone
      , FirstAppoint.appDate
      , coalesce(apptmp.RATE, APPOINTMENTS.RATE)
      , StajStrah.position
      , StajStrah.FromDate
      , INN.nmb
      , catwk.name
      , lschet.PROFS
      , EM_GET_ZGD_PODR(katpodr.nrec)
      , ok3.s
      , cast(klrejim.rejim as string)
      , dop3.name
      , uchstep.name
  into tab1
  ;

  sql
  select distinct
	  persons.nrec
  , pers1.fio
  from persons
  inner join appointments on appointments.person = persons.nrec and appointments.appointdate <= :(data) and (appointments.dismissdate >= :(data) or appointments.dismissdate = 0) and (appointments.lprizn = 0 or appointments.lprizn = 100)
  left join appointments apptmp on apptmp.person = persons.nrec and apptmp.appointdate <= :(data) and (apptmp.dismissdate >= :(data) or apptmp.dismissdate = 0) and (apptmp.dateend >= :(data) or apptmp.dateend = 0) and apptmp.lprizn = 70
  inner join extcatlinks on extcatlinks.staffcat = coalesce(apptmp.department, appointments.department)
  inner join katpodr on katpodr.nrec = extcatlinks.extcat
  left join attrnam on attrnam.wtable = 25018 and attrnam.name = 'Должность функционального руководителя'
  left join attrval on attrval.cattrnam = attrnam.nrec and attrval.crec = coalesce(apptmp.staffstr, appointments.staffstr)
  left join appointments app1 on app1.staffstr = attrval.vcomp and attrval.vcomp <> 0
  inner join persons pers1 on pers1.appointcur = app1.nrec
  where persons.strtabn <> ''
		and persons.isemployee in ('С', 'У')
		and katpodr.name not in('_Профком', '_Студенты', '_Физические лица', 'Ветераны')
  group by persons.nrec, pers1.fio
  into tZGD;

 stopvisual;
 StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Выгрузка в EXCEL', recordsintable(tntab1));
  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_sotrudniki.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  counter:= 3;
  countermatrix:= 0;

  xlsetcellstringvalue('ИНФОРМАЦИЯ О СОТРУДНИКАХ РАБОТАЮЩИХ НА ' + data, 1, 1, 1, 1);

  xlCreateMatrix(1000, 45);

  _loop tab1
  {
    nextvisual;
    setvisualheader('Выгрузка в EXCEL'+
                     +''#13'' + tab1.fio);
    countermatrix++;
    god:= _runstaj.NGetStajYears(tab1.persnrec, tab1.stajnrec, data);
    mes:= _runstaj.NGetStajMonths(tab1.persnrec, tab1.stajnrec, data);
    wday:= _runstaj.NGetStajDays(tab1.persnrec, tab1.stajnrec, data);
    staj:= god + (mes/12) + (wDay/365);
    vozr:= integer(substr(string((year(cur_date)-year(tab1.borndate)) + (month(cur_date) - month(tab1.borndate))/12 + (day(cur_date) - day(tab1.borndate))/365), 1, 2));
    var vozrdbl : double = (year(cur_date)-year(tab1.borndate)) + (month(cur_date) - month(tab1.borndate))/12 + (day(cur_date) - day(tab1.borndate))/365;


    var godStrah : double = 0;
    var mesStrah : double = 0;
    var wdayStrah: double = 0;
    godStrah:= _runstaj.NGetStajYears(tab1.persnrec, tab1.StajStrah, data);
    mesStrah:= _runstaj.NGetStajMonths(tab1.persnrec, tab1.StajStrah, data);
    wdayStrah:= _runstaj.NGetStajDays(tab1.persnrec, tab1.StajStrah, data);



    xlStWriteToMatrix(countermatrix, 1, char(39)+tab1.tabnum);
    xlStWriteToMatrix(countermatrix, 2, char(39)+tab1.fio);
    xlStWriteToMatrix(countermatrix, 3, char(39)+tab1.podr);
    xlStWriteToMatrix(countermatrix, 4, char(39)+tab1.podrname);
    xlStWriteToMatrix(countermatrix, 5, char(39)+tab1.otdel);
    xlStWriteToMatrix(countermatrix, 6, char(39)+tab1.otdelname);
    xlStWriteToMatrix(countermatrix, 7, char(39)+tab1.post);

    if (getFirst FastFirstRow tZGD where ((tab1.persnrec == tZGD.pNrec)) = tsOk) then
    {
      xlStWriteToMatrix(countermatrix, 8, char(39)+tZGD.zgd);
    }
    xlStWriteToMatrix(countermatrix, 9, char(39)+tab1.podr_zgd);
    xlStWriteToMatrix(countermatrix, 10, char(39)+tab1.pol);
    xlStWriteToMatrix(countermatrix, 11, char(39)+AdrFunc.GetFullAddressInd(tab1.addrlive));
    xlStWriteToMatrix(countermatrix, 12, char(39)+AdrFunc.GetFullAddressInd(tab1.addrpasp));
    xlDoWriteToMatrix(countermatrix, 13, tab1.kateg);
    xlDoWriteToMatrix(countermatrix, 14, staj);
    xlStWriteToMatrix(countermatrix, 15, char(39)+tab1.sovm);
    xlDtWriteToMatrix(countermatrix, 16, tab1.borndate);
    xlDoWriteToMatrix(countermatrix, 17, vozrdbl);
    xlStWriteToMatrix(countermatrix, 18, char(39)+tab1.dognmb);
    xlDtWriteToMatrix(countermatrix, 19, tab1.dogdate);
    xlDtWriteToMatrix(countermatrix, 20, tab1.appdate);
    xlDtWriteToMatrix(countermatrix, 21, tab1.dateend);
    xlDtWriteToMatrix(countermatrix, 22, tab1.ispsrok);
    xlStWriteToMatrix(countermatrix, 23, char(39)+tab1.paspser);
    xlStWriteToMatrix(countermatrix, 24, char(39)+tab1.paspnmb);
    xlDtWriteToMatrix(countermatrix, 25, tab1.paspdate);
    xlStWriteToMatrix(countermatrix, 26, char(39)+tab1.paspvyd);
    xlStWriteToMatrix(countermatrix, 27, char(39)+tab1.paspodr);
    xlDtWriteToMatrix(countermatrix, 28, tab1.invaliddate);
    xlStWriteToMatrix(countermatrix, 29, char(39)+tab1.obr);
    xlDtWriteToMatrix(countermatrix, 30, tab1.disdate);
    xlStWriteToMatrix(countermatrix, 31, char(39)+tab1.snils );
    xlStWriteToMatrix(countermatrix, 32, char(39)+tab1.email );
    xlStWriteToMatrix(countermatrix, 33, char(39)+tab1.Phone );
    xlDtWriteToMatrix(countermatrix, 34, tab1.FirstAppDate );
    xlStWriteToMatrix(countermatrix, 35, char(39)+tab1.CountStavok );
    xlDoWriteToMatrix(countermatrix, 36, godStrah);
    xlDoWriteToMatrix(countermatrix, 37, mesStrah);
    xlDoWriteToMatrix(countermatrix, 38, wdayStrah);
    xlStWriteToMatrix(countermatrix, 39, chr(39)+tab1.INN);
    xlStWriteToMatrix(countermatrix, 40, char(39)+tab1.workond);
    xlStWriteToMatrix(countermatrix, 41, char(39)+tab1.prof);
    xlStWriteToMatrix(countermatrix, 42, char(39)+tab1.ok3code);
    xlStWriteToMatrix(countermatrix, 43, char(39)+tab1.rejim);
    xlStWriteToMatrix(countermatrix, 44, char(39)+tab1.dop3);
    xlStWriteToMatrix(countermatrix, 45, char(39)+tab1.uchstep);
//    xlDoWriteToMatrix(countermatrix, 37, tab1.StrahStajFromDate);



    if countermatrix = 1000
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  xlFreeMatrix;

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter - 1, 45);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_sotrudniki Implements IUserReport;
Interface UserReport_sotrudniki;

Procedure Run;
Begin
  runinterface(gp_sotrudniki);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Информация о сотрудниках';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
