  tmpPersons.sPrizn       'Тип', 'назначения'             ('Тип назначения'): [11], protect;
#end

overloadFormats brwPsn_markByNrec;
overloadFormats brwPsn_markByApp;
overloadFormats brwPsn_singleChoice;

browse brwPsn_markByNrec;
  table tmpPersons;
  recMarker = PMarkerByNrec {tmpPersons.Nrec};
Fields
  #fieldsBrowse
end;

browse brwPsn_markByApp;
  table tmpPersons;
  recMarker = PMarkerByApp {tmpPersons.App};
Fields
  #fieldsBrowse
end;

browse brwPsn_singleChoice;
  table tmpPersons;
Fields
  #fieldsBrowse
end;

