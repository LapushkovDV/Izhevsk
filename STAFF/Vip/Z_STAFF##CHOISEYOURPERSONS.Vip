#declare insTmpP
  insert visual into tmpPersons
    select
      Persons.NRec,
      Persons.FIO,
      Persons.TabNmb,
      Persons.StrTabN,
      Persons.Department,
      Persons.BornDate,
      Persons.DisDate,
      comp(0)
      , word(0)
      , 'основное'
      , Persons.AppDate//date(0, 0, 0)
      , date(0, 0, 0)
      , Persons.DisDate//date(0, 0, 0)
      , comp(0)
      , ''
    From
      Persons
#end

//------------------------------------------------------------------------------
// Процедура установки заголовка окна
//------------------------------------------------------------------------------
procedure prSetCurTitle;
var
  liMCount: longint;
  sMarkCount: string;
{
  liMCount := GetMarkerCount(Markers);
  sMarkCount := '';
  if liMCount > 0 then
    sMarkCount := '. Выбранно сотрудников: '+ liMCount;
  SetTitle(strTitle + strTitleAdd + sMarkCount);
}

//******************************************************************************
// Наполнение временной таблицы, в зависимости от параметра cPar2
// _GP_ забираем целиком
//******************************************************************************
Procedure FillTmpTable;
{
  timelog('ChoiseYourPersons->FillTmpTable:cPar2='+string(cPar2));
  case cPar2 of
    0: // вставка целиком физических лиц
    {
      #insTmpP;
    }
    1: // текущие
    {
      #insTmpP
        where (('С' == Persons.IsEmployee));
    }
    2: // архивные
    {
      #insTmpP
        where (('У' == Persons.IsEmployee));
    }
    3: // работающие
    { var _DT:date=cur_Date();
#IFDEF _GP_
      #insTmpP
        where (('С' == Persons.IsEmployee
              and date(0, 0, 0) == Persons.DisDate));
  timelog('ChoiseYourPersons->FillTmpTable:отобрали 1='+string(RecordsInTable(#tmpPersons)));
      #insTmpP
        where (('С' == Persons.IsEmployee
              and _DT<<= Persons.DisDate));
  timelog('ChoiseYourPersons->FillTmpTable:отобрали 2='+string(RecordsInTable(#tmpPersons)));
#else
      #insTmpP
        where (('С' == Persons.IsEmployee
              and date(0, 0, 0) == Persons.DisDate));
#ENDIF
    }
    4: // уволенные
    {
      #insTmpP
        where ((date(0, 0, 0) << Persons.DisDate));
    }
    5: // работающие
    {
      #insTmpP
        where (('Ю' == Persons.IsEmployee));
    }
    6: // картотека - т.е. уволенные и архивные!
    {
      // текущие
      #insTmpP
        where (('С' == Persons.IsEmployee));
      //архивные
      #insTmpP
        where (('У' == Persons.IsEmployee));
    }
  end; //case
}

//Наполнение таблицы данными по фильтру
Procedure FillByFiltr;
{
  timelog('ChoiseYourPersons->FillByFiltr:cPar2='+string(cPar2));
  case cPar2 of
  3: //// работающие
  {}
  else
  { Inherited:: FillByFiltr ;
    Exit;
  }
  end;
  var i : word;
  var ddd : date;
  var wCountMarker : longInt;
    wCountMarker := GetMarkerCount(DeptMarker);

  StartNewVisual(vtNumericVisual, vfTimer + vfBreak, 'Формирование временной таблицы', 1);
  var _dt:date=Cur_Date();
  case cPar2 of
    3: // работающие
    {
        if bFillByDates
        {
          ddd := date2;
          if  wCountMarker <> 0
          {
            for (i := 0; i < wCountMarker; i++ )  // работающие + назначения по маркеру
            {
              if GetMarker(DeptMarker, i, ItemTable)
                if IsTuneLock // есть разграничение прав доступа
                  if not VuserAcs.Exists(ItemTable)
                    Continue;
              if bFillByApp
              {
                _Loop Appointments where ((ItemTable == Appointments.Department))
                  if (Appointments.LPrizn  = word(0) or Appointments.LPrizn  = word(3))    //основное, совмещение
                  {
                    _Loop Persons where (( Appointments.Person /== Persons.nRec (NoIndex)
                                                       and 'С' == Persons.IsEmployee
                                              and date(0, 0, 0) == Persons.DisDate
                                              ))
                    {
                      ClearBuffer(#tmpPersons);
                      tmpPersons.Nrec        := Persons.NRec;
                      tmpPersons.FIO         := Persons.FIO;
                      tmpPersons.TabN        := Appointments.AppTabNmb;
                      tmpPersons.StrTabN     := Appointments.StrTabn;
                      tmpPersons.sDept       := AppCat.Name;
                      tmpPersons.BornDate    := Persons.BornDate;
                      tmpPersons.DisDate     := Persons.DisDate;
                      tmpPersons.App         := Appointments.Nrec;
                      tmpPersons.lPrizn      := Appointments.lPrizn;
                      tmpPersons.sPrizn      := fnlPrizn(Appointments.lPrizn, Persons.cSovm, klSovm.NSovm);
                      tmpPersons.AppointDate := Appointments.AppointDate;
                      tmpPersons.DateEnd     := Appointments.DateEnd;
                      tmpPersons.DisMissDate := Appointments.DismissDate;
                      insert current tmpPersons;
                    }
                    _Loop Persons where (( Appointments.Person /== Persons.nRec (NoIndex)
                                                      and 'С' == Persons.IsEmployee
                                            and ddd <<= Persons.DisDate))
                    {
                      ClearBuffer(#tmpPersons);
                      tmpPersons.Nrec        := Persons.NRec;
                      tmpPersons.FIO         := Persons.FIO;
                      tmpPersons.TabN        := Appointments.AppTabNmb;
                      tmpPersons.StrTabN     := Appointments.StrTabn;
                      tmpPersons.sDept       := AppCat.Name;
                      tmpPersons.BornDate    := Persons.BornDate;
                      tmpPersons.DisDate     := Persons.DisDate;
                      tmpPersons.App         := Appointments.Nrec;
                      tmpPersons.lPrizn      := Appointments.lPrizn;
                      tmpPersons.sPrizn      := fnlPrizn(Appointments.lPrizn, Persons.cSovm, klSovm.NSovm);
                      tmpPersons.AppointDate := Appointments.AppointDate;
                      tmpPersons.DateEnd     := Appointments.DateEnd;
                      tmpPersons.DisMissDate := Appointments.DismissDate;
                      insert current tmpPersons;
                    }
                  }
              }
              else
              {
                _Loop Persons  where (( 'С' == Persons.IsEmployee
                        and date(0, 0, 0) == Persons.DisDate and ItemTable == Persons.Department))
                {
                  ClearBuffer(#tmpPersons);
                  tmpPersons.Nrec        := Persons.NRec;
                  tmpPersons.FIO         := Persons.FIO;
                  tmpPersons.TabN        := Persons.TabNmb;
                  tmpPersons.StrTabN     := Persons.StrTabn;
                  tmpPersons.sDept       := PersCat.Name;
                  tmpPersons.BornDate    := Persons.BornDate;
                  tmpPersons.DisDate     := Persons.DisDate;
                  tmpPersons.App         := Comp(0);
                  tmpPersons.lPrizn      := word(0);
                  tmpPersons.sPrizn      := fnlPrizn(0, Persons.cSovm, klSovm.NSovm);
                  tmpPersons.AppointDate := Persons.AppDate;
                  tmpPersons.DateEnd     := date(0, 0, 0);
                  tmpPersons.DisMissDate := Persons.DisDate;
                  insert current tmpPersons;
                }
                _Loop Persons  where (( 'С' == Persons.IsEmployee
                        and ItemTable == Persons.Department and ddd <<= Persons.DisDate))
                {
                  ClearBuffer(#tmpPersons);
                  tmpPersons.Nrec        := Persons.NRec;
                  tmpPersons.FIO         := Persons.FIO;
                  tmpPersons.TabN        := Persons.TabNmb;
                  tmpPersons.StrTabN     := Persons.StrTabn;
                  tmpPersons.sDept       := PersCat.Name;
                  tmpPersons.BornDate    := Persons.BornDate;
                  tmpPersons.DisDate     := Persons.DisDate;
                  tmpPersons.App         := Comp(0);
                  tmpPersons.lPrizn      := word(0);
                  tmpPersons.sPrizn      := fnlPrizn(0, Persons.cSovm, klSovm.NSovm);
                  tmpPersons.AppointDate := Persons.AppDate;
                  tmpPersons.DateEnd     := date(0, 0, 0);
                  tmpPersons.DisMissDate := Persons.DisDate;
                  insert current tmpPersons;
                }
              }
            }
          }
          else  // wCountMarker = 0
          {
            if bFillByApp //фильтр работающие + назначения
            {
              _Loop Persons  where (( 'С' == Persons.IsEmployee
                        and date(0, 0, 0) == Persons.DisDate))

               _Loop Appointments  where (( Persons.nRec /== Appointments.Person))
               {
                  if (Appointments.LPrizn  != word(0) and Appointments.LPrizn  != word(3))    //основное, совмещение
                    Continue;
                if IsTuneLock // есть разграничение прав доступа
                  if not VuserAcs.Exists(Appointments.Department)
                    Continue;
                ClearBuffer(#tmpPersons);
                tmpPersons.Nrec        := Persons.NRec;
                tmpPersons.FIO         := Persons.FIO;
                tmpPersons.TabN        := Appointments.AppTabNmb;
                tmpPersons.StrTabN     := Appointments.StrTabn;
                tmpPersons.sDept       := AppCat.Name;
                tmpPersons.BornDate    := Persons.BornDate;
                tmpPersons.DisDate     := Persons.DisDate;
                tmpPersons.App         := Appointments.Nrec;
                tmpPersons.lPrizn      := Appointments.lPrizn;
                tmpPersons.sPrizn      := fnlPrizn(Appointments.lPrizn, Persons.cSovm, klSovm.NSovm);
                tmpPersons.AppointDate := Appointments.AppointDate;
                tmpPersons.DateEnd     := Appointments.DateEnd;
                tmpPersons.DisMissDate := Appointments.DismissDate;
                insert current tmpPersons;
              }

              _Loop Persons  where (( 'С' == Persons.IsEmployee
                        and ddd <<= Persons.DisDate))

               _Loop Appointments  where (( Persons.nRec /== Appointments.Person))
               {
                  if (Appointments.LPrizn  != word(0) and Appointments.LPrizn  != word(3))    //основное, совмещение
                    Continue;
                if IsTuneLock // есть разграничение прав доступа
                  if not VuserAcs.Exists(Appointments.Department)
                    Continue;
                ClearBuffer(#tmpPersons);
                tmpPersons.Nrec        := Persons.NRec;
                tmpPersons.FIO         := Persons.FIO;
                tmpPersons.TabN        := Appointments.AppTabNmb;
                tmpPersons.StrTabN     := Appointments.StrTabn;
                tmpPersons.sDept       := AppCat.Name;
                tmpPersons.BornDate    := Persons.BornDate;
                tmpPersons.DisDate     := Persons.DisDate;
                tmpPersons.App         := Appointments.Nrec;
                tmpPersons.lPrizn      := Appointments.lPrizn;
                tmpPersons.sPrizn      := fnlPrizn(Appointments.lPrizn, Persons.cSovm, klSovm.NSovm);
                tmpPersons.AppointDate := Appointments.AppointDate;
                tmpPersons.DateEnd     := Appointments.DateEnd;
                tmpPersons.DisMissDate := Appointments.DismissDate;
                insert current tmpPersons;
              }
            }
            else    // работающие
            {
              _Loop Persons  where (( 'С' == Persons.IsEmployee
                        and date(0, 0, 0) == Persons.DisDate))
              {
                if IsTuneLock // есть разграничение прав доступа
                  if not VuserAcs.Exists(Persons.Department)
                    Continue;
                ClearBuffer(#tmpPersons);
                tmpPersons.Nrec        := Persons.NRec;
                tmpPersons.FIO         := Persons.FIO;
                tmpPersons.TabN        := Persons.TabNmb;
                tmpPersons.StrTabN     := Persons.StrTabn;
                tmpPersons.sDept       := PersCat.Name;
                tmpPersons.BornDate    := Persons.BornDate;
                tmpPersons.DisDate     := Persons.DisDate;
                tmpPersons.App         := Comp(0);
                tmpPersons.lPrizn      := word(0);
                tmpPersons.sPrizn      := fnlPrizn(0, Persons.cSovm, klSovm.NSovm);
                tmpPersons.AppointDate := Persons.AppDate;
                tmpPersons.DateEnd     := date(0, 0, 0);
                tmpPersons.DisMissDate := Persons.DisDate;
                insert current tmpPersons;
              }
              _Loop Persons  where (( 'С' == Persons.IsEmployee
                        and ddd <<= Persons.DisDate))
              {
                if IsTuneLock // есть разграничение прав доступа
                  if not VuserAcs.Exists(Persons.Department)
                    Continue;
                ClearBuffer(#tmpPersons);
                tmpPersons.Nrec        := Persons.NRec;
                tmpPersons.FIO         := Persons.FIO;
                tmpPersons.TabN        := Persons.TabNmb;
                tmpPersons.StrTabN     := Persons.StrTabn;
                tmpPersons.sDept       := PersCat.Name;
                tmpPersons.BornDate    := Persons.BornDate;
                tmpPersons.DisDate     := Persons.DisDate;
                tmpPersons.App         := Comp(0);
                tmpPersons.lPrizn      := word(0);
                tmpPersons.sPrizn      := fnlPrizn(0, Persons.cSovm, klSovm.NSovm);
                tmpPersons.AppointDate := Persons.AppDate;
                tmpPersons.DateEnd     := date(0, 0, 0);
                tmpPersons.DisMissDate := Persons.DisDate;
                insert current tmpPersons;
              }
            }
          }
          if (bFillByDates) //сотрудники + по датам  если включен фильтр по подразделению
            PushConditionForLeave(tcDatesForApp, tntmpPersons);
        }
        else
        {
          if  wCountMarker <> 0
          {
            for (i := 0; i < wCountMarker; i++ )  // работающие + назначения по маркеру
            {
              if GetMarker(DeptMarker, i, ItemTable)
                if IsTuneLock // есть разграничение прав доступа
                  if not VuserAcs.Exists(ItemTable)
                    Continue;
              if bFillByApp
              {
                _Loop Appointments where ((ItemTable == Appointments.Department))
                  if (Appointments.LPrizn  = word(0) or Appointments.LPrizn  = word(3))    //основное, совмещение
                    _Loop Persons where (( Appointments.Person /== Persons.nRec (NoIndex)
                                                      and 'С' == Persons.IsEmployee
#IFDEF _GP_
                   and (ZeroDate= Persons.DisDate or _DT<=Persons.DisDate)
                  ))
#ELSE
                                            and date(0, 0, 0) == Persons.DisDate))
#ENDIF
                    {
                      ClearBuffer(#tmpPersons);
                      tmpPersons.Nrec        := Persons.NRec;
                      tmpPersons.FIO         := Persons.FIO;
                      tmpPersons.TabN        := Appointments.AppTabNmb;
                      tmpPersons.StrTabN     := Appointments.StrTabn;
                      tmpPersons.sDept       := AppCat.Name;
                      tmpPersons.BornDate    := Persons.BornDate;
                      tmpPersons.DisDate     := Persons.DisDate;
                      tmpPersons.App         := Appointments.Nrec;
                      tmpPersons.lPrizn      := Appointments.lPrizn;
                      tmpPersons.sPrizn      := fnlPrizn(Appointments.lPrizn, Persons.cSovm, klSovm.NSovm);
                      tmpPersons.AppointDate := Appointments.AppointDate;
                      tmpPersons.DateEnd     := Appointments.DateEnd;
                      tmpPersons.DisMissDate := Appointments.DismissDate;
                      insert current tmpPersons;
                    }
              }
              else
              {
                _Loop Persons  where (( 'С' == Persons.IsEmployee
#IFDEF _GP_
                   and ItemTable == Persons.Department
                   and (ZeroDate= Persons.DisDate or _DT<=Persons.DisDate)
                  ))
#ELSE
                        and date(0, 0, 0) == Persons.DisDate and ItemTable == Persons.Department))
#ENDIF
                {
                  ClearBuffer(#tmpPersons);
                  tmpPersons.Nrec        := Persons.NRec;
                  tmpPersons.FIO         := Persons.FIO;
                  tmpPersons.TabN        := Persons.TabNmb;
                  tmpPersons.StrTabN     := Persons.StrTabn;
                  tmpPersons.sDept       := PersCat.Name;
                  tmpPersons.BornDate    := Persons.BornDate;
                  tmpPersons.DisDate     := Persons.DisDate;
                  tmpPersons.App         := Comp(0);
                  tmpPersons.lPrizn      := word(0);
                  tmpPersons.sPrizn      := fnlPrizn(0, Persons.cSovm, klSovm.NSovm);
                  tmpPersons.AppointDate := Persons.AppDate;
                  tmpPersons.DateEnd     := date(0, 0, 0);
                  tmpPersons.DisMissDate := Persons.DisDate;
                  insert current tmpPersons;
                }
              }
          }
        }
        else  // wCountMarker = 0
        {
          if bFillByApp //фильтр работающие + назначения
          {
            _Loop Persons  where (( 'С' == Persons.IsEmployee
#IFDEF _GP_
                   and (ZeroDate= Persons.DisDate or _DT<=Persons.DisDate)
                  ))
#ELSE
                      and date(0, 0, 0) == Persons.DisDate ))
#ENDIF

             _Loop Appointments  where (( Persons.nRec /== Appointments.Person))
             {
                if (Appointments.LPrizn  != word(0) and Appointments.LPrizn  != word(3))    //основное, совмещение
                  Continue;
              if IsTuneLock // есть разграничение прав доступа
                if not VuserAcs.Exists(Appointments.Department)
                  Continue;
              ClearBuffer(#tmpPersons);
              tmpPersons.Nrec        := Persons.NRec;
              tmpPersons.FIO         := Persons.FIO;
              tmpPersons.TabN        := Appointments.AppTabNmb;
              tmpPersons.StrTabN     := Appointments.StrTabn;
              tmpPersons.sDept       := AppCat.Name;
              tmpPersons.BornDate    := Persons.BornDate;
              tmpPersons.DisDate     := Persons.DisDate;
              tmpPersons.App         := Appointments.Nrec;
              tmpPersons.lPrizn      := Appointments.lPrizn;
              tmpPersons.sPrizn      := fnlPrizn(Appointments.lPrizn, Persons.cSovm, klSovm.NSovm);
              tmpPersons.AppointDate := Appointments.AppointDate;
              tmpPersons.DateEnd     := Appointments.DateEnd;
              tmpPersons.DisMissDate := Appointments.DismissDate;
              insert current tmpPersons;
            }
          }
          else    // работающие
            _Loop Persons  where (( 'С' == Persons.IsEmployee
#IFDEF _GP_
                   and (ZeroDate= Persons.DisDate or _DT<=Persons.DisDate)
                  ))
#ELSE
                      and date(0, 0, 0) == Persons.DisDate ))
#ENDIF
            {
              if IsTuneLock // есть разграничение прав доступа
                if not VuserAcs.Exists(Persons.Department)
                  Continue;
              ClearBuffer(#tmpPersons);
              tmpPersons.Nrec        := Persons.NRec;
              tmpPersons.FIO         := Persons.FIO;
              tmpPersons.TabN        := Persons.TabNmb;
              tmpPersons.StrTabN     := Persons.StrTabn;
              tmpPersons.sDept       := PersCat.Name;
              tmpPersons.BornDate    := Persons.BornDate;
              tmpPersons.DisDate     := Persons.DisDate;
              tmpPersons.App         := Comp(0);
              tmpPersons.lPrizn      := word(0);
              tmpPersons.sPrizn      := fnlPrizn(0, Persons.cSovm, klSovm.NSovm);
              tmpPersons.AppointDate := Persons.AppDate;
              tmpPersons.DateEnd     := date(0, 0, 0);
              tmpPersons.DisMissDate := Persons.DisDate;
              insert current tmpPersons;
            }
        }
      if (bFillByDates) //сотрудники + по датам  если включен фильтр по подразделению
        PushConditionForLeave(tcDatesForApp, tntmpPersons);
    }
    }
  end; //case

  StopVisual('', 0);

}//Procedure FillByFiltr;

HandleEvent
cmValue21:{//Отбор сотрудников
  var AutoMark:GP_AutoMarkPersons;
  if (AutoMark.Run(Markers)) {
    if (GetMarkerCount(Markers)=0) {
      if (ConditionActiveInLeave(tcByAutoMarkPersons,tnTmpPersons))
        PopConditionForLeave(tcByAutoMarkPersons,tnTmpPersons);
    } else {
      if (AutoMarkFilter=0)
        AutoMarkFilter:=InitMarker('',8,0,1);
      CopyMarker(AutoMarkFilter,Markers);
      if (not ConditionActiveInLeave(tcByAutoMarkPersons,tnTmpPersons))
        PushConditionForLeave(tcByAutoMarkPersons,tnTmpPersons);
    }
    ReReadRecord(tntmpPersons);

    prSetCurTitle;
  }
}
cmInit:{
  timelog_init;
  timelog('ChoiseYourPersons->cmInit');
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
cmOnVipUnload:{
  timelog_init;
  timelog('ChoiseYourPersons->cmOnVipUnload');
  case inherited :: handleEvent (cmOnVipUnload) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (AutoMarkFilter<>0)
    DoneMarker(AutoMarkFilter,'');
}
end;

end.

//Добавление пункта меню
handler with replace GP_MenuDynamic_AddItems_ChoiseYourPersons on ExtensionPoint GP_MenuDynamic_AddItems
action
{
  result:=true;
  timelog('GP_MenuDynamic_AddItems_ChoiseYourPersons');

  var MenuID:longint=0;
  _try {
    MenuID:=LoadMenuEx('Z_Staff::LocalFltMenuChoiseYourPersons',false,true);

    AddMenuItem(MenuID,'separator',1);
    AddMenuItemEx(MenuID,'Отбор сотрудников',
                         'Отбор сотрудников','',cmValue21,0);

    if (not StoreMenuHowDynamics(MenuID,'Z_Staff::LocalFltMenuChoiseYourPersons'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню для интерфейса "Выбор сотрудников"'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }
  timelog('GP_MenuDynamic_AddItems_ChoiseYourPersons finish');
}

//Удаление пункта меню
handler with replace GP_MenuDynamic_DelItems_ChoiseYourPersons on ExtensionPoint GP_MenuDynamic_DelItems
action
{
  result:=true;

  DeleteMenuHowDynamics('Z_Staff::LocalFltMenuChoiseYourPersons');
}
