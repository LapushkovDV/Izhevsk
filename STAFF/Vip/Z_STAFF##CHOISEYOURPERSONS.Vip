#include GP_MenuDynamic.vih
#include GP_AutoMarkPersons.vih

#component "Z_Staff"
alter interface ChoiseYourPersons;
OverLoad
  Procedure FillTmpTable;
  Procedure FillByFiltr;
end;

var AutoMarkFilter:TPtr;

Create view Psn
condition ByAutoMarkPersons=FoundMarker(AutoMarkFilter,TmpPersons.Nrec);

#declare fieldsBrowse
  tmpPersons.TabN         'Таб. номер'                    ('Табельный номер'): [10], protect;
