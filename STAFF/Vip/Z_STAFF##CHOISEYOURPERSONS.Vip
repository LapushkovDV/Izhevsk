  sSovm                   'Таб. совм.'                    ('Табельный номер совмещения'): [10], protect;
  tmpPersons.FIO          'Фамилия, имя, отчество'        ('Фамилия, имя, отчество'): [40], protect;
  tmpPersons.BornDate     'Дата', 'рождения'              ('Дата рождения'): [10], protect;
  //Catalogs.Code           'Код подр.' ('Подразделение (рекомендуемое или текущее)'): [10] , skip;
  //Catalogs.Name           'Подразделение'                 ('Подразделение (рекомендуемое или текущее)'): [20] , skip;
  tmpPersons.sDept        'Подразделение' ('Подразделение (рекомендуемое или текущее)'): [20] , skip;
  tmpPersons.DisDate      'Дата', 'увольнения'            ('Дата увольнения'): [10], protect;
