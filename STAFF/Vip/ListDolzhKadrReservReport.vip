/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*                "Список должностей в разрезе групп кадрового резерва"                            *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Управление персоналом->Отчеты->Отчеты пользователя->                             *
*                   Папка <Отчеты по кадровому резерву>  ->                                       *
*                   Список должностей в разрезе групп кадрового резерва.                          *
*                                                                                                 *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#187          |24/08/17|Носов В.В.               |НПО Энергомаш                    *
\*************************************************************************************************/
#include UserReport.vih
#include xlReport.vih
#include DeptIer.vih // получить всякие свойства по записи таблицы Catalogs
#include odecl.vih           // Функции склонения ФИО
#include History.vih

procedure DisableLoadMonthlyScheduleMessages; external 'G_Zarpl.dll';
procedure EnableLoadMonthlyScheduleMessages; external 'G_Zarpl.dll';

Interface iListDolzhKadrReservReport 'Список должностей в разрезе групп кадрового резерва'  escclose, cyan, doaccept;
  Show at (, , 60, 8);
//*****************************************************************************
#include History.var
//*****************************************************************************
table struct tmpDolzhKadrReserv
(
  NRec        : comp
, sDolzh      : string
, sName       : string
, svalue      : string
)
with index
(
  tmpDolzhKadrReserv01 = NRec (Surrogate, Unique)
)
;

//******************************************************************************

Create view
var
  listCompt       : string;

  EnhancedTimeFormat : boolean;

  wShowFirstPage 
, wCountry           : word;

  sNumDoc
, dDateDoc
, ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;

  dBeg
, dEnd               : date;

  cTitleDoc
, ContDocNrec        : comp; 

  ComptMarker
, i
, i1
, ComptgrMarker: longint;
  ParentSav
, cPost: comp;
as select
 *
from 
  COMPETENCEPOST
 ,catalogs
 ,catalogs selectcomp
 ,catalogs catcomp
 ,catalogs catcompgr
 ,tmpDolzhKadrReserv
;


//*****************************************************************************
var IDepartIer : DepartIer; // иерархия подразделений
var iOdecl     : declension;// Переменная типа интерфейс declension
//*****************************************************************************

Procedure InitTable;
{

    _LOOP COMPETENCEPOST  where ((     COMPETENCEPOST.CPOST/==catalogs.nrec   and COMPETENCEPOST.CNAME/==catcomp.nrec and  catcomp.CPARENT == catcompgr.nrec ))
                   and catalogs.syscode=0
                   and( (SearchMarker(ComptMarker , catcomp.nrec,i1)=TRUE and  GetMarkerCount(ComptMarker )>0) or
                      (SearchMarker(ComptMarker , catcomp.nrec ,i1)<>TRUE and  GetMarkerCount(ComptMarker )=0) )

        {
              ClearBuffer(#tmpDolzhKadrReserv);
              set
              tmpDolzhKadrReserv.sDolzh      :=  catalogs.name  ;
              tmpDolzhKadrReserv.sName       :=  catcompgr.name ;
              tmpDolzhKadrReserv.svalue      :=  catcomp.name;

              if (insert current tmpDolzhKadrReserv = tsOk)
                {}
        }

}
//******************************************************************************

Procedure PrintLine;
{
   var npp : longint; npp := 0;

   _LOOP tmpDolzhKadrReserv
     if (Not NextVisual)
     {
       break; 
     }
     else   
     { 
       inc(npp);
       var isIns : boolean; isIns := false;
       pXL.ClearTblBuffer;

       pXL.SetTblStringFldValue('sCompt'     , tmpDolzhKadrReserv.sName);
       pXL.SetTblStringFldValue('sValue'     , tmpDolzhKadrReserv.svalue);
       pXL.SetTblStringFldValue('sDolzh'     , tmpDolzhKadrReserv.sDolzh );

       pXL.InsTblRow;                     
     }
}

//*****************************************************************************

Procedure PrintRepost;
{
  ID := 'ListDolzhKadrReserv';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpDolzhKadrReserv));

  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('listCompt'           , listCompt);

  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('tmpDolzhKadrReserv');
  pXL.CreateTblFld('sCompt');
  pXL.CreateTblFld('sValue');
  pXL.CreateTblFld('sDolzh');

  PrintLine;
  
  pXL.PublishTbl('tmpDolzhKadrReserv');
  
  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);
}

HandleEvent

cmInit: 
  {
   listCompt:='';
   if (RunInterface(PickCatalog2,word(100),ParentSav, Comp(100))=cmDefault)
    {
      ComptMarker:= InitMarker('CatalogsMarker', 8, 100, 10 );
      ComptgrMarker:= InitMarker('', 8, 100, 10 );
      for ( i:= 0;i<  GetMarkerCount(ComptMarker); i++)
        {
         GetMarker(ComptMarker, i, cPost);
         if getfirst  selectcomp where (( cPost == selectcomp.nrec ))= tsOk{
         }
         if selectcomp.syscode=0 then  insertmarker(ComptgrMarker,selectcomp.cparent)
         else    deletemarker(ComptMarker,cPost);

        }
       for ( i:= 0;i<  GetMarkerCount(ComptgrMarker); i++)
        {
        GetMarker(ComptgrMarker, i, cPost);
        if getfirst   Catalogs where (( cPost ==catalogs.nrec))= tsOk
         if listCompt='' then    listCompt :=  catalogs.name else listCompt := listCompt+' \ '+ catalogs.name;// catalogs.name;
         deletemarker(ComptMarker,catalogs.nrec);
        }

      }

    DoneMarker(ComptgrMarker, '');// Маркер для полей
    listCompt:='Список должностей в разрезе компетенций "('+listCompt+')"';

    InitTable;
    PrintRepost;
  }

end;
end.


vipinterface UserReport_iListDolzhKadrReservReport implements IUserReport licensed(free);

interface UserReport_iListDolzhKadrReservReport;

create view
  var
    Dummy: Byte;
;

procedure Run;
begin
  RunInterface('iListDolzhKadrReservReport');
end;

function GetReportName: String;
begin
  GetReportName := 'Список должностей в разрезе групп кадрового резерва';
end;

function GetGroupName(Level: Word): String;
begin
#__UNUSED__(Level)
  GetGroupName := 'Отчеты по кадровому резерву';
end;

function GetPriority: Integer;
begin
  GetPriority := 0;
end;

function VisibleInModule(Ind: Byte): String;
begin
#__UNUSED__(Ind)
  VisibleInModule := 'StaffMainMenu';
end;

end.
