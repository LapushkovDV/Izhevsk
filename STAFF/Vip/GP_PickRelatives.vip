#component "GP_Staff"

#doc
Выбор родственника сотрудника
#end

Interface GP_PickRelatives 'Выбор родственника сотрудника' (,,sci178Ins) Cyan,DoAccept;
show at (,,60,10);
table struct tCodeFilters (
  Code: string[100]
) with index (
  i01 = Code (unique)
);

Var
  cPers: comp;
  cChild: comp;
  sCodeFilters: string;

Parameters
cPers, cChild, sCodeFilters;

Create view as select PSNLinks.RFio
from PSNLinks, catalogs, tCodeFilters tcf, tCodeFilters
where ((
  cPers             == PSNLinks.fromperson and
  PSNLInks.linktype == catalogs.nrec and
  catalogs.code     == tcf.Code
))
condition byCodeFilters = isValidAll(tnTcf);

Browse B1;
table PSNLinks ;
Fields
    PSNLinks.RFIO 'ФИО' : [25], Protect, NoDel;
    PSNLinks.RBornDate 'Дата рождения' :[12], Protect, NoDel;
    catalogs.name 'Родство' :[15], Protect, NoDel;
end;
  HandleEvent
    cmDefault:
    {
       cChild := PSNLinks.nrec;
    };
    cmInit:
    {
      if trim(sCodeFilters) != ''
      {
        sCodeFilters := trim(sCodeFilters) + ',';
        while pos(',', sCodeFilters) > 0
        {
          insert tCodeFilters set Code := trim(SubStr(sCodeFilters, 1, pos(',', sCodeFilters) - 1));
          sCodeFilters := trim(SubStr(sCodeFilters, pos(',', sCodeFilters) + 1, 255));
        }
        PushCondition(tcByCodeFilters);
      }
    }
  End; //HandleEvent
end.
