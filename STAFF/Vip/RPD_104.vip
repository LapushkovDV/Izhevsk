end;

Interface RPD_104 '' escclose;

Var
  viCYPersonsWithMarkerFilter: GP_ObjChoiceYourPersonsWithMarkerFilter(GP_ChoiceYourPersonsWithMarkerFilter);
  _setZarSignal: GP_SetPrVidOplRK;  //формирование записей в рабочей корзине

view as
select GP_RaiseHistExt104.*
         from GP_RaiseHistExt104
//не используется         , Persons Persons104
where
  ((RaiseHist.nrec == GP_RaiseHistExt104.cRaiseH
//and GP_RaiseHistExt104.cPerson == Persons104.nrec
//and RaiseHist.cRaise == Raise.nrec
//and Raise.RaiseType  == RaiseCat.nrec
));
//******************************************************************************
// Окно содержимого приказа на назначение персональных надбавок
//******************************************************************************
Browse brwRaise104 'Назначение доплаты' (,, sci178Esc);
  show at (, 9,,12);
  table RaiseHist;
    Fields
  RaiseCat.Name     'Вид доплаты/надбавки', ('Вид доплаты/надбавки.', hcStaffRaiseType, sci1378Esc):[20], protect;
  RaiseHist.rHSum   'Сумма/процент доплаты/надбавки', ('Сумма/процент доплаты/надбавки', hcStaffRaiseSum): [13.3], noprotect,
    {Font = {BackColor = if (RaiseHist.rHSum <= 0, ColorNeed, 0)}};
  'Нац.валюта'      'Валюта', ('Валюта оплаты.', hcStaffRaiseCurr, sci1378Esc):[10] , protect;
  RaiseHist.dRec    'С даты', ('Дата, с которой установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered,
    {Font = {BackColor = if (RaiseHist.dRec = 0, ColorNeed, 0)}};
  RaiseHist.dDat2   'По дату', ('Дата, по которую установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered,
    {Font = {BackColor = if (RaiseHist.dDat2 = 0, ColorNeed, 0)}};
end;   //  brwRaise

screen scrRaise101Ext104 'Назначение доплаты (расширение)' (,, sci178Esc);
  show at (, 13,,17);
  table GP_RaiseHistExt104;
  Fields
    GP_RaiseHistExt104.dZayav    ('Дата подачи заявления'): [10,'DD/MM/YYYY'], noprotect;
    GP_RaiseHistExt104.FIOPers   ('ФИО умершего'): [50], noprotect, PickButton;
    GP_RaiseHistExt104.BORNPers  ('Дата рождения умершего'): [10,'DD/MM/YYYY'], noprotect;
//    GP_RaiseHistExt104.DatePay   ('Дата выплаты'): [10,'DD/MM/YYYY'], noprotect;
//    GP_RaiseHistExt104.SummPay   ('Сумма выплаты'): [10.2], noprotect;

<<
 `Дата подачи заявления`  .@@@@@@@@@@ `ФИО умершего`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Дата рождения умершего` .@@@@@@@@@@
>>

end;   //  brwRaise

//******************************************************************************
// Процедура удаления своих записей, привязанных у удаляемому приказу
//******************************************************************************
Procedure MyDel;
{
  _loop RaiseHist
  {
    if TitleDoc.wStatus=1
    { var _params: TGP_SetPrVidOplRK_Params;
      _params.cPers   := persons.nrec;
      _params.cApp    := appointments.nrec;
      _params.wTable  := 116;
      _params.cRec    := RaiseHist.Nrec;
      if isValidAll(tnRaiseCat)
        _params.wVidOpl := word(RaiseCat.CatData);
      _params.dBeg    := RaiseHist.dRec;
      _params.dEnd    := RaiseHist.dDat2;
      _params.dSum    := RaiseHist.RhSum;
      _params.wChoice := 99; //доплата в буд. периоде
      _params.cContDoc:= contdoc.nrec;
      _setZarSignal.DelRR(_params);
    }
    delete all from GP_RAISEHISTEXT104 where ((RaiseHist.Nrec == GP_RaiseHistExt104.cRaiseH));
  }
  if TitleDoc.wStatus=1
  { SRR.DelRaiseMsg(Raise.NRec, Raise.Person, Raise.Appoint);
  }
  inherited::MyDel;
}

//******************************************************************************
//  Процедура утверждения приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{
  _loop RaiseHist
  {
    var _params: TGP_SetPrVidOplRK_Params;
    _params.cPers   := persons.nrec;
    _params.cApp    := appointments.nrec;
    _params.wTable  := 116;
    _params.cRec    := RaiseHist.Nrec;
    if isValidAll(tnRaiseCat)
      _params.wVidOpl := word(RaiseCat.CatData);
    _params.dBeg    := RaiseHist.dRec;
    _params.dEnd    := RaiseHist.dDat2;
    _params.dSum    := RaiseHist.RhSum;
    _params.wChoice := 99; //доплата в буд. периоде
    _params.cContDoc:= contdoc.nrec;
    _setZarSignal.SetRR(_params);
  }

  result := inherited::ChildConfirmOneOrder(cNrec);

  _loop RaiseHist
    if getfirst Raise = tsOk
      update current Raise set Raise.Appoint := 0;

  SRR.DelRaiseMsg(Raise.NRec, Raise.Person, Raise.Appoint);
}

//******************************************************************************
// Печать приказа
//******************************************************************************

procedure PrintRPD(typePrint: TPtr; fcEnter: word);
{ #__UNUSED__(typePrint)
  case typePrint of
    0: RunInterface('Z_STAFFORDERS::NFormRD09a', TitleDoc.Nrec, PartDoc.TypeOper);
  end;
}

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  var sTitle:string;
  inherited::EnableDisable;

  cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
  cfsGetProp('WHATISINORDER',cfpTitle, sTitle);
  cfsSetProp('WHATISINORDER',cfpTitle, replace(sTitle,'Приказ','Список'));
  cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер списка');
  cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата списка');

  if (GP_RaiseHistExt104.cPerson <> 0)
  {
    ToggleFieldProtected(#GP_RaiseHistExt104.FIOPers, true);
    ToggleFieldProtected(#GP_RaiseHistExt104.BornPers, true);
  }
  if fnFieldsOpen // не утвержден
  {
    SetHelpAndStatusContext(brwRaise104, -1, sci178Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt104.dZayav, true);
//    ToggleFieldSelectable(#Persons104.FIO, true);
  }
  else //утвержден
  {
    SetHelpAndStatusContext(brwRaise104, -1, sci1Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt104.dZayav, false);
//    ToggleFieldSelectable(#Persons104.FIO, false);
  }
}

//Проверяет на валидность данные в записи RaiseHist
function RaiseHistIsValid(buf: type$RaiseHist): boolean;
{
  result := buf.rHSum > 0 and buf.dRec > 0 and buf.dDat2 > 0;
}

//Возвращает текст сообщения пользователю с детализацией о невалидности записи RaiseHist
function GetNotValidRaiseHistUserInfo(buf: type$RaiseHist): string;
{
  var EmptyRequiredFields: string = ''; //незаполненные обязательные поля

  if buf.rHSum <= 0
    EmptyRequiredFields := 'Сумма/процент доплаты/надбавки';

  if buf.dRec = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'С даты';

  if buf.dDat2 = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'По дату';

  result := if(EmptyRequiredFields = '', '',
               ''#3'Не заполнены обязательные поля: '#13 + EmptyRequiredFields);
}

TableEvent table RaiseHist;
  cmSetDefault:
  {
    //message('Докомпилировали обработчик');
    inherited::HandleEvent(cmSetDefault);
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD104');
    if (ParentSav <> 0)
    {
      RaiseHist.cRaiseType := ParentSav;
      RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
      Raise.RaiseAttr := RaiseHist.iHAttr;
      Raise.RaiseType := ParentSav;
    }
  }
  cmCheckRecord:
  {
    if inherited::HandleEvent(cmCheckRecord) = heOk
    {
      var buf: type$RaiseHist;
      buf := RaiseHist.buffer;
      if not RaiseHistIsValid(buf) {
        Message(GetNotValidRaiseHistUserInfo(buf), error);
        Abort;
      }
    }
  }
  cmInsertRecord:
  {
    if inherited::HandleEvent(cmInsertRecord) = heOk
    {
      ToggleFieldProtected(#GP_RaiseHistExt104.FIOPers, false);
      ToggleFieldProtected(#GP_RaiseHistExt104.BornPers, false);
    }
  }
  cmPositionChanged:
  {
    if inherited::HandleEvent(cmPositionChanged) = heOk
    {
      var isProtected: boolean;
      isProtected := false;
      if isValidAll(#GP_RaiseHistExt104)
        if GetFirst FastFirstRow Persons where (( GP_RaiseHistExt104.cPerson == Persons.Nrec )) = tsOk
          isProtected := true;

      ToggleFieldProtected(#GP_RaiseHistExt104.FIOPers, isProtected);
      ToggleFieldProtected(#GP_RaiseHistExt104.BornPers, isProtected);
    }
  }
end;

TableEvent table GP_RaiseHistExt104;
  cmSetDefault:
  {
    //message('cmSetDefault GP_RaiseHistExt104');
    GP_RaiseHistExt104.cRaiseH := RaiseHist.nrec;
    //message('установили нрек для расширения '+RaiseHist.nrec);
  }
  cmInsertRecord:
  {
    //inherited::HandleEvent(cmInsertRecord);
    //message('cmInsertRecord GP_RaiseHistExt104');
    GP_RaiseHistExt104.cRaiseH := RaiseHist.nrec;
    insert current GP_RaiseHistExt104;
  }
  cmUpdateRecord:
  {
    //message('cmUpdateRecord GP_RaiseHistExt104');
    GP_RaiseHistExt104.cRaiseH := RaiseHist.nrec;
    update current GP_RaiseHistExt104;
  }
  cmDeleteRecord:
  {
    //message('cmUpdateRecord GP_RaiseHistExt104');
    delete current GP_RaiseHistExt104;
  }
end;

TableEvent table ContDoc;
  cmInsertRecord:
  {
    //При добавлении нового сотрудника в приказ вызываем выбор вида доплаты/надбавки
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      if SelectFormat(brwRaise104)
      {
        SelectField(#RaiseCat.Name);
        PutCommand(cmPick);
      }
    }
  }
end;


sql query queryPersonsForMatAids =
  select nrec
  from persons
  where ddop1 between :d1 and :d2
    and nrec not in (
          select distinct persons.nrec
          from contdoc
          join partdoc on partdoc.nrec = contdoc.cpart
          join titledoc on titledoc.nrec = partdoc.cdoc and titledoc.wstatus = 1
          join raisehist on raisehist.ccontdoc = contdoc.nrec
          join GP_RaiseHistExt104 on GP_RaiseHistExt104.craiseh = raisehist.nrec
          join persons on persons.nrec = GP_RaiseHistExt104.cperson
          where contdoc.typeoper = 104
        )
;

procedure FillMarkerWithPersonsForMatAids(lMarker: TPtr);
{
  var rs: IResultSet;
  rs := queryManager.createQuery(queryPersonsForMatAids)
                    .setParam('d1', sub_months(titledoc.docdate, 12))
                    .setParam('d2', titledoc.docdate)
                    .getResultSet;
  if rs.getFirst = tsOk do
  {
    InsertMarker(lMarker, comp(rs.row.ValAt(1)));
  } while rs.getNext = tsOk;
}

//******************************************************************************
// Печать приказа
//******************************************************************************

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent

    cmMulSelDO:
    {
      if UpdateTable
        UpdNeedField(CurField);
    }
    cmPick:
    {

      case CurField of
        #RaiseCat.Name:
        {

          //ParentSav := RaiseHist.cRaiseType;
          ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD104');

          var wPickResult: word = cmCancel;
          if GetFirst FastFirstRow Catalogs where ((ParentSav == Catalogs.cParent)) = tsOk
            wPickResult := RunInterface(Z_STAFFCAT::PickCatalog2, 0, ParentSav, 0, 0);
          else
            wPickResult := RunInterface(GP_STAFF::GP_PickCatalogWithOneRec, -17, ParentSav);

          if (wPickResult = cmDefault)
          {
            //PreviousType := RaiseHist.cRaiseType; // взвести флаг того, что поменяли наименование
            set RaiseHist.cRaiseType := ParentSav;
            set RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
            set Raise.RaiseAttr := RaiseHist.iHAttr;
            set Raise.RaiseType := ParentSav;
            ReReadRecord(tnCatalogs);
          }

          exit;
        } //RaiseCat.Name
      end;

      inherited::HandleEvent(cmPick);

      case CurField of
        #GP_RaiseHistExt104.FIOPers:{
          var wK:word = 0;
          var cChoice:comp = 0;

          ClearMarker(viCYPersonsWithMarkerFilter.FilterMarker);
          FillMarkerWithPersonsForMatAids(viCYPersonsWithMarkerFilter.FilterMarker);

          //Выбираем из уволенных сотрудников
          //if (RunInterface(Z_Staff::PrikPsn, byte(0), 0, GP_RaiseHistExt104.cPerson) <> cmDefault)
          if not viCYPersonsWithMarkerFilter.Choice(0, 4, vfCanSelect, wK, cChoice, 0)
          {
            Abort;
            Exit;
          } else {
            set GP_RaiseHistExt104.cPerson := viCYPersons.GetPsnByKindChoice(wK, cChoice);
            if (getfirst Persons where ((GP_RaiseHistExt104.cPerson == nrec)) = tsOk)
            {
              ToggleFieldProtected(#GP_RaiseHistExt104.FIOPers, true);
              ToggleFieldProtected(#GP_RaiseHistExt104.BornPers, true);
              set GP_RaiseHistExt104.FIOPers  := Persons.FIO;
              set GP_RaiseHistExt104.BornPers := Persons.BornDate;
            }
          }
          UpdateTableWithInserted();
          ReReadRecord;
        };
        #persons.fio:
        {

          if isvalidall(#Persons)
          {
            //Запрещаем пользователю выбирать умерших сотрудников
            if (Persons.ddop1 != 0)
            {
              message('Запрещено выбирать сотрудников с заполненным полем "Дата смерти"', error);
              PutCommand(cmDelOnProtect);
            }
            else
            {
              //Если пользователь выбрал корректного сотрудника и это новая позиция -
              //сразу вызываем вставку этой записи, чтобы далее вызвать добавление вида доплаты/надбавки
              if(isNew) UpdateTable();
              SelectFieldInFormat(brwRaise104, #RaiseCat.Name);
            }

          }
        }
      end;
    };
    cmCalc:
    {
      update current ContDoc set TypeOper = 9;
      inherited::Handleevent(cmCalc);
      update ContDoc where ((PartDoc.nrec == contdoc.cPart)) set TypeOper = 104;
      _loop Contdoc where ((PartDoc.nrec == contdoc.cPart))
        NOAA.DeleteAgreementLinks(coContDoc, ContDoc.nrec)
    }
    cmDelOnProtect:
    {
      case CurField of
        #GP_RaiseHistExt104.FIOPers:
        {
          if (message('В поле заполнена ссылка на сотрудника. Вы хотите ввести данные вручную?', YesNo)) = cmYes
          {
            ToggleFieldProtected(#GP_RaiseHistExt104.FIOPers, false);
            ToggleFieldProtected(#GP_RaiseHistExt104.BornPers, false);
            set GP_RaiseHistExt104.cPerson  := 0;
            set GP_RaiseHistExt104.FIOPers  := '';
            set GP_RaiseHistExt104.BornPers := from_days(0);
            UpdateTable;
          }
        }
      end;
    }
    cmOnVipUnload:{
      inherited::Handleevent(cmOnVipUnload);
      cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
      cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер приказа');
      cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата приказа');

    }
  end;

End.
