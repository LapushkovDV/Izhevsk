#include GP_KlndrExt.vih
interface GP_KlndrExt;

create view ltKlndrExt
from
  GP_KlndrExt;

function DelRec(Rejim:word;YearK,MonthK:integer):boolean;
{
  result:=delete GP_KlndrExt
          where((Rejim==GP_KlndrExt.Rejim and YearK==GP_KlndrExt.YearK and MonthK==GP_KlndrExt.MonthK))=tsok;
}

HandleEvent
cmInit:abort;
end;

end.

//Для поддержания ссылочной целостности
handler with replace GP_KlndrExtDelete on trigger Klndr before Delete [99]
action
{
  var buf : record as table Klndr;
  GetTableBuffer(buf);

  var oKlndrExt:GP_KlndrExt;
  result:=oKlndrExt.DelRec(buf.Rejim,buf.YearK,buf.MonthK);
}
