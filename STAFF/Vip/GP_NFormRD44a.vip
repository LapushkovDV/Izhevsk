#component "Z_StaffOrders"
#include FeeSigners.vih
Alter interface NFormRD44a;

var
  sPodr : string;
  sPodrZam : string;
   sSigners:string;
   sPostRuk:string;
   sFIORuk:string;
   iFeeSigners : FeeSigners;


create view vPodr
as select *
from catalogs CatPodr
;

overload
  DataStream DTS_RPD44a;
  procedure PrintRPD44a;
end;

DataStream DTS_RPD44a
(
    [sPodr]         sPodr;
    [sPodrZam]      sPodrZam;
    [sPostRuk]      sPostRuk;
    [sFIORuk]       sFIORuk;
)
end;

function PodrNameCat(cpodr:comp):string;
{
  result:='';

  if vPodr.getfirst CatPodr where (( cpodr==CatPodr.nrec )) = tsok
  {
    if Length(vPodr.CatPodr.Code)=3 then result:=vPodr.CatPodr.name;
    else result:=PodrNameCat(vPodr.CatPodr.cparent);
  };
}

procedure PrintRPD44a;
{

    sSigners:='';
     RunInterface('GetFeeSigners', cgReport_KASSFRO, sSigners);
    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);
    if (sSigners<>'')
    if (not iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigners))
    sSigners:='';
    if (sSigners<>'')
    if (not iFeeSigners.RestrictFeeByRole(2,'Direct'))
    sSigners:='';

    sPostRuk :=iFeeSigners.GetSignerPosition(1);
    sFIORuk :=iFeeSigners.GetSignerFIO(1);

    sPodr := PodrNameCat(Appointments.Department);
    sPodrZam := PodrNameCat(NewAppoint.Department);

    inherited::PrintRPD44a;
} // PrintRPD44

//컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴

end.
