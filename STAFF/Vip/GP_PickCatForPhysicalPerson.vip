#include CatFunc.vih

interface GP_PickCatForPhysicalPerson '' Cyan, DoAccept;
Show at (,, 83, 25);

var iEntryPoint: integer;
    cCurPos: comp;
    iCatFunc: CatalogsFunctions;

table struct CatForPhysicalPerson = Catalogs;

create view
from
  CatForPhysicalPerson
order by CatForPhysicalPerson.Name;

parameters iEntryPoint, cCurPos;

browse brCat (, , sci1EnEsc);
table CatForPhysicalPerson;
fields
  CatForPhysicalPerson.Name  'Наименование' ('Наименование'): [50], Protect;
  CatForPhysicalPerson.Code  'Код' ('Код'): [20], Protect;
  if (CatForPhysicalPerson.SysCode <> 0, 'С', '') 'C':[1], Skip;
end;

HandleEvent
cmInit:{
  SetWindowTitle(wnMainWindow, iCatFunc.GetCatalogsNameSys(iEntryPoint));

  var cRootNode:comp;
  cRootNode:=iCatFunc.GetCatalogsNRec(iEntryPoint);

  sql
    select *
    from
      Catalogs
      inner join AttrNam on (:(coCatalogs) = AttrNam.wTable and 'Вид производства' = AttrNam.Name)
      inner join SpKau on ('ФизЛица' = SpKau.Code and AttrNam.rObject = SpKau.KodGrKau)
      inner join AttrVal on (:(coCatalogs) = AttrVal.wTable and AttrNam.NRec = AttrVal.cAttrNam
                             and Catalogs.NRec = AttrVal.cRec and SpKau.NRec = AttrVal.vComp)
    where
      0 = Catalogs.lPr and :(cRootNode) = Catalogs.MainLink
    into CatForPhysicalPerson;

  if (cCurPos<>0)
    if (getfirst CatForPhysicalPerson where((cCurPos==CatForPhysicalPerson.NRec))=tsok) {}
}
cmDefault:{
  cCurPos := CatForPhysicalPerson.NRec;
}
end;
end.
