#include GP_TarStavExt.vih
interface GP_TarStavExt;

create view ltTarStavExt
from
  GP_TarStavExt;

function DelRec(cTarStav:comp):boolean;
{
  result:=delete GP_TarStavExt where((cTarStav==GP_TarStavExt.cTarStav))=tsok;
}

end.

//Для поддержания ссылочной целостности
handler with replace GP_TarStavExtDelete on trigger TarStav before Delete [99]
action
{
  var buf : record as table TarStav;
  GetTableBuffer(buf);

  var oTarStavkExt:GP_TarStavExt;
  result:=oTarStavkExt.DelRec(buf.NRec);
}
