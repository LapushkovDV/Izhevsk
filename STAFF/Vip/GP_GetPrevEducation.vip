* Наименование: Разработка пользовательского РПД №236                                             *
*               "Перенос сроков или прекращение обучения студентов-целевиков"                     *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1747         |30/01/18|Кузьмин П.Ю.             |НПО Энергомаш                    *
\*************************************************************************************************/

#doc
Разработка пользовательского РПД №236                                             *
"Перенос сроков или прекращение обучения студентов-целевиков"                     *
<p>Контур/Модуль: Управление персоналом                                                            *
#end
Interface GP_GetPrevEducation 'Выбор приказа о направлении на обучение' DoAccept, EscClose, Cyan;

Var TypeOper: word;
    TypeOper2: word;
    cPerson: comp;
    cEducation: comp;

Table Struct EducOrders
(
    cCont: comp // ссылка на приказ
  , cEduc: comp // ссылка на обучение
  , fromDate: date // дата начала обучения
  , DocDate:date
  , DocNmb:string
)
with index
(
  i1 = fromDate,
  i2 = cEduc
);

Create View
as select  EducOrders.*
From
   EducOrders
  , Education
  , Catalogs EduNameCat
  , Catalogs EduLevelCat
  , Catalogs EduSpecialityCat
  , Catalogs TopicEductCat
Where((
      EducOrders.cCont == Education.cContDoc
  and Education.Name == EduNameCat.NRec
  and Education.Level == EduLevelCat.Nrec
  and Education.Speciality == EduSpecialityCat.NRec
  and Education.cAddInf1 == TopicEductCat.NRec
))
;

Parameters
  TypeOper
#doc
  основной тип для поиска приказов на обучение - 136 например
#end
, cPerson
#doc
  ссылка на картотеку сотрудника
#end
, cEducation
#doc
 возвращаемый, ссылка на запись об образовании
#end
, TypeOper2
#doc
  Дополнительный тип для поиска приказов на обучение - 136 например
#end
;

Browse brEd ( '',, sci1Esc);
Table EducOrders;
 Fields
  EducOrders.DocDate 'Дата','Приказа'
    ('Дата приказа о направлении на обучение'): [10], Protect;
  EducOrders.DocNmb 'Номер','Приказа'
    ('Номер приказа о направлении на обучение'): [8], Protect;
  EduLevelCat.Name 'Вид','образования'
    ('Вид образования'): [12], Protect,NoDel;
  EduNameCat.Name 'Учебное','заведение'
    ('Учебное заведение'): [12], Protect,NoDel;
  TopicEductCat.Name 'Тема','обучения'
    ('Тема обучения'): [12], Protect,NoDel;
  EduSpecialityCat.Name 'Специальность'
    ('Специальность'): [12], Protect,NoDel;
  Education.FromDate 'Дата','начала'
    ('Дата начала обучения'): [10], Protect,NoDel;
  Education.ToDate 'Дата','окончания'
    ('Дата окончания обучения'): [10], Protect,NoDel;
End; //browse

Procedure LoadEducOrders;
{
  delete all EducOrders;

  sql
    select
      ContDoc.nRec
      , Education.nRec
      , Education.FromDate
      , TitleDoc.DocDate
      , TitleDoc.DocNmb
    from
      ContDoc
      inner join Education on (ContDoc.Nrec = Education.cContDoc and 0 < Education.Person)
      inner join PartDoc on (ContDoc.cPart = PartDoc.NRec)
      inner join TitleDoc on (PartDoc.cDoc = TitleDoc.NRec and TitleDoc.wStatus <> 0)
    where
      ContDoc.Person = :(cPerson)
      and (
            (ContDoc.TypeOper  = :(TypeOper))
         or (:(TypeOper2)>0 and  ContDoc.TypeOper = :(TypeOper2)  )
       )
    into EducOrders;
}

HandleEvent
cmInit:{
  LoadEducOrders;

  If GetFirst EducOrders <> tsOk
  {
    Message ('Приказов о направлении на обучение не обнаружено!', Warning);
    Abort;
    exit;
  }

  If cEducation <> 0
    If GetFirst EducOrders Where ((cEducation == EducOrders.cEduc)) = tsOk {};
}
cmDefault:{
  cEducation := Education.NRec;
  CloseInterface(cmDefault);
}
End;
end.
