#include AttrTablePick.vih
#include GP_File_hRef.Vih
#include GP_ManualNotes.vih
#include GP_KPI_RaiseProc.Vih

#component "Z_StaffSHR"
#doc
<b>Штатное расписание</b>
<p>#1993 - просмотр процентов премий
#end
alter interface StaffStruct;
overload
  function IStafStruPrivate.InitEmbedded: boolean;
  procedure IStafStruPrivate.SetRelation(_cDep: comp);
  procedure ShowIzmSE;
end;
OverloadFormats brwStaffStruct;
ExtendFormats scrStaffStruct, brwVacancy;

var cAttrBossPost:comp;
    cAttrBossRaise:comp;
    cAttrVidRabot: comp;
    cAttrBalanSch: comp;
    cAttrCategorGK: comp;
    oAttrTablePick:AttrTablePick;
    Prevnrec2:comp;
    refAttrTablePick : AttrTablePick;
    iExAttr : iExtAttr;
    ManualNotesStaffStr:GP_ObjManualNotes(GP_ManualNotes) New;
    ManualNotesPers:GP_ObjManualNotes(GP_ManualNotes) New;
Function getLastManualNotes(_CurTbl : word;_CurRec : comp) : string; forward;
Create view VStaffStruct
// совсем тормозит
as select ManualNotesStaffStr.NoteStr, ManualNotesPers.NoteStr
 ,getLastManualNotes(coStaffStruct,TableForStaffStru.cStaffStru) (Fieldname = LastManualNotes)
 ,refAttrTablePick.sGetValue(coStaffStruct, iExAttr.AttrID(coStaffStruct, 'Профессия исполнителя'), StaffStruct.nRec)
    ( Fieldname = PostIsp )
from
  ManualNotesStaffStr,ManualNotesPers, Persons PersonsOutSide
  ,GP_ManualNotes
where((
                     coStaffStruct == ManualNotesStaffStr.wTbl
  and TableForStaffStru.cStaffStru == ManualNotesStaffStr.cRec
//  and                      999999 >>= ManualNotesStaffStr.NoteNumber
                    and  coPersons == ManualNotesPers.wTbl
           and TmpEmployee.NRecPsn == ManualNotesPers.cRec
          AND TmpEmployee.NRecPsn  == PersonsOutSide.NRec
))
//order by ManualNotesStaffStr.ATL_LASTDATE
;

Function getLastManualNotes(_CurTbl : word;_CurRec : comp) : string;
{
 result := '';
 if getlast fastfirstrow GP_ManualNotes where((   _CurTbl == GP_ManualNotes.wTbl
                                               and _CurRec == GP_ManualNotes.cRec
                                                    and 0 <<= GP_ManualNotes.NoteNumber
                                              )) = tsOK
  { result := GP_ManualNotes.Note }
}

procedure ShowIzmSE;
{
  inherited::ShowIzmSE;
  SetFieldAndLabelVisible(#fWorkStations, true);
  SetFieldAndLabelVisible(#fWorkers, true);
}

#include GP_File_hRef.Vpp
Browse brwStaffStruct 'Рабочие места' (,);
Table TableForStaffStru;
Fields
  { Font = { Color = if (HidePost, ColorGray, if (FoundMarker(Markers, StaffStruct.Nrec), ColorMark, ColorSysBlack))}};
  //MarkerStr 'V' ('Пометка'): [1], skip;
  fSeqNmb  '№', 'п/п' ('N п/п', ): [5], protect;
  SSEmpCategoryCat.Kod 'Код', 'категории' ('Код категории'): [10], skip;
  fPostCat       'Должность' ('Должность по штатному расписанию',, scStaffStructPick): [30], skip;
  fWorkStations  'Штат.', 'ед-ц' ('Количество штатных единиц'): [8.3], skip;
  fWorkers       'Вакансий' ('Количество вакантных рабочих мест'): [8.3], skip,
    { Font= { BackColor = if(fWorkers < 0, ColorError, 0) } };
  StaffStruct.TaxRate 'Оклад', '(тариф)': [10.3], skip;
  SSWorkCondCat.Code  'Код класса', 'усл. труда' : [10], skip;
  fInput  'Дата', 'создания', 'ставки' ('Дата введения'): [10], skip;
  fClose  'Дата', 'закрытия', 'ставки' ('Дата закрытия'): [10], skip;
//  ManualNotesStaffStr.NoteStr 'Примечание ручное' (,,scStaffStructPick):[20],Protect,PickButton;
  LastManualNotes 'Примечание ручное' (,,scStaffStructPick):[20],Protect,PickButton;
End;

Screen scrStaffStruct;
Table TableForStaffStru;
fields
  PostIsp ('Профессия исполнителя',,scStaffStructPick):protect,
    {Font={BackColor=if(PostIsp='',ColorNeed,0)}};
  [BossPost] sGetAttrID(coStaffStruct,StaffStruct.NRec,cAttrBossPost)
    ('Должность функционального руководителя',,scStaffStructPick):protect,
    {Font={BackColor=if(BossPost='',ColorNeed,0)}};
  [BossRaise] sGetAttrID(coStaffStruct,StaffStruct.NRec,cAttrBossRaise)
    ('Должность руководителя для формирования премии',,scStaffStructPick):protect,
    ;
  [VidRabot] sGetAttrID(coStaffStruct,StaffStruct.NRec,cAttrVidRabot)
    ('Вид работ, выполняемых данной позицией',,scStaffStructPick):protect,
    ;
  [BalanSch] sGetAttrID(coStaffStruct,StaffStruct.NRec,cAttrBalanSch)
    ('Балансовый счет присвоенный к должности',,):Noprotect,
    ;
  [CategorGK] sGetAttrID(coStaffStruct,StaffStruct.NRec,cAttrCategorGK)
    ('Категория по методике категорирования ГК',,scStaffStructPick):protect,
    ;

Buttons
 //---- #1993
  cmRaise    ,,, 'Просмотр премий', hcAllBOk, scGalDial;
  cmValue68  ,,, 'Просмотр должностных инструкций', hcAllBOk, scGalDial;

<<










`Профессия исполнителя`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@










 Должность функционального руководителя.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@




 Премию отнести на должность .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ <.Премии.>
       Вид выполняемых работ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 <.Должностные инструкции.>

 Балансовый счет .@@@@@@@@  Категория ГК .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

>>
end;
//*****************************************************************************

Procedure SetOutside;
{
  _LOOP TmpEmployee
    if (InStr('внеш', TmpEmployee.apptype) = 0)
      if (GetFirst PersonsOutSide = tsOk and  word(PersonsOutSide.CSOVM) = 1)
        {
          set TmpEmployee.apptype := TmpEmployee.apptype + if (Trim(TmpEmployee.apptype) = '', 'внеш', ' + внеш');
          if (update current TmpEmployee = tsOk)
            {}  
        }
}

//*****************************************************************************

Browse brwVacancy 'Сотрудники' (,, scStaffStructPers);
Table TmpEmployee;
Fields
  ManualNotesPers.NoteStr 'Примечание ручное' (,,sci13Esc):[20],Protect,PickButton;
end;

Procedure SetAndClearField;
{
  if wGetTune('UP.FakelGAL.Fakel') = 1
  {
    ShowLabel4Field(#PostIsp);
    SetFieldState(#PostIsp     , sfVisible);
  }
  else //
  {
    ClearFieldState(#PostIsp,sfVisible);
    Hidelabel4Field(#PostIsp);        
  }
}

TableEvent Table TableForStaffStru;
cmExprFieldChanged:
{
   inherited::handleevent(cmExprFieldChanged);
   case CurField of
   #BalanSch:
    {
     if (bogettune('NPOEM_OWN.EM_UUK.EDIT_BALANS_KATGK'))
      sSetAttrID (coStaffStruct,  StaffStruct.NRec, cAttrBalanSch, ExprFieldValue);
     else{
      message('Вам запрещено редактировать поля Балансовый счет, Категория ГК!');
      exit;
      }
    }
    end;
}

cmCheckRecord:{
  case inherited :: handleEvent (cmCheckRecord) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (coGetAttrID(coStaffStruct,StaffStruct.NRec,cAttrBossPost)=0)
  and bogettune('NPOEM_OWN.EM_UUK.NEED_DOLJNOST_RUKOVODITELYA') {
    Message('Не указана должность функционального руководителя.', error);
    SelectFormat(scrStaffStruct);
    SelectField(fnBossPost);
    abort;
    exit;
  }
  if (not IsValidAll(tnSSDopAttrCat))
  and bogettune('NPOEM_OWN.EM_UUK.NEED_DOPHARAKTERISTIKA') {
    Message('Не указана дополнительная характеристика.', error);
    SelectFormat(scrStaffStruct);
    SelectField(#SSDopAttrCat.Name);
    abort;
    exit;
  }
}
cmPick:{
  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnPostIsp,fnBossPost,fnBossRaise,fnVidRabot,fnCategorGK,#ManualNotesStaffStr.NoteStr, #LastManualNotes:{
      if (IsNew) {
        SetModified(true);
        if (not UpdateTable) exit;
      }
    }
  end;

  case CurField of
    fnPostIsp:{
      refAttrTablePick.PickValue(coStaffStruct, iExAttr.AttrID(coStaffStruct, 'Профессия исполнителя'), StaffStruct.nRec);
      RereadRecord;
    }
    fnBossPost:{
      if (oAttrTablePick.PickValue(coStaffStruct, cAttrBossPost, StaffStruct.NRec)) {
        set BossPost;
        //проверим настройку и скопируем внешние атрибуты
        if boGetTune('UP.Staff.AttrCopy_SHR')//Синхронизировать внешние атрибуты в ШР с историей ШР
          if (GetLast LastHistoryStr where (( IFHS.GetLastRec(StaffStruct.Nrec) == LastHistoryStr.NRec )) = tsOk)
            iAttrCopy.UpdateArrt(StaffStruct.Nrec, LastHistoryStr.Nrec, CoStaffStruct, CoHistoryStr);
      }
    }
    fnBossRaise:{
      if (oAttrTablePick.PickValue(coStaffStruct, cAttrBossRaise, StaffStruct.NRec)) {
        set BossRaise;
        //проверим настройку и скопируем внешние атрибуты
        if boGetTune('UP.Staff.AttrCopy_SHR')//Синхронизировать внешние атрибуты в ШР с историей ШР
          if (GetLast LastHistoryStr where (( IFHS.GetLastRec(StaffStruct.Nrec) == LastHistoryStr.NRec )) = tsOk)
            iAttrCopy.UpdateArrt(StaffStruct.Nrec, LastHistoryStr.Nrec, CoStaffStruct, CoHistoryStr);
      }
    }
    fnVidRabot:{
      if (oAttrTablePick.PickValue(coStaffStruct, cAttrVidRabot, StaffStruct.NRec)) {
        set VidRabot;
        //проверим настройку и скопируем внешние атрибуты
        if boGetTune('UP.Staff.AttrCopy_SHR')//Синхронизировать внешние атрибуты в ШР с историей ШР
          if (GetLast LastHistoryStr where (( IFHS.GetLastRec(StaffStruct.Nrec) == LastHistoryStr.NRec )) = tsOk)
            iAttrCopy.UpdateArrt(StaffStruct.Nrec, LastHistoryStr.Nrec, CoStaffStruct, CoHistoryStr);
      }
    }

        fnCategorGK:{
    if (bogettune('NPOEM_OWN.EM_UUK.EDIT_BALANS_KATGK')){
      if (oAttrTablePick.PickValue(coStaffStruct, cAttrCategorGK, StaffStruct.NRec))
        set CategorGK;
        }
    else{
      message('Вам запрещено редактировать поля Балансовый счет, Категория ГК!');
      exit;
      }
    }


    #ManualNotesStaffStr.NoteStr, #LastManualNotes:{
      if (ManualNotesStaffStr.Pick(coStaffStruct,TableForStaffStru.cStaffStru))
        set ManualNotesStaffStr.NoteStr;
    }
  end;
}
cmDelOnProtect:{
  case CurField of
    fnPostIsp:{
      iExAttr.DeleteValue(coStaffStruct, StaffStruct.Nrec, 'Профессия исполнителя');
      RedrawPanel(#STAFFSTRUCT);
    }
    fnBossPost:{
      if (ExtAttr_DeleteValueID(coStaffStruct,StaffStruct.NRec,cAttrBossPost)=tsok) {
        set BossPost;
        //проверим настройку и скопируем внешние атрибуты
        if boGetTune('UP.Staff.AttrCopy_SHR')//Синхронизировать внешние атрибуты в ШР с историей ШР
          if (GetLast LastHistoryStr where (( IFHS.GetLastRec(StaffStruct.Nrec) == LastHistoryStr.NRec )) = tsOk)
            iAttrCopy.UpdateArrt(StaffStruct.Nrec, LastHistoryStr.Nrec, CoStaffStruct, CoHistoryStr);
      }
    }
    fnBossRaise:{
      if (ExtAttr_DeleteValueID(coStaffStruct,StaffStruct.NRec,cAttrBossRaise)=tsok) {
        set BossRaise;
        //проверим настройку и скопируем внешние атрибуты
        if boGetTune('UP.Staff.AttrCopy_SHR')//Синхронизировать внешние атрибуты в ШР с историей ШР
          if (GetLast LastHistoryStr where (( IFHS.GetLastRec(StaffStruct.Nrec) == LastHistoryStr.NRec )) = tsOk)
            iAttrCopy.UpdateArrt(StaffStruct.Nrec, LastHistoryStr.Nrec, CoStaffStruct, CoHistoryStr);
      }
     }
    fnVidRabot:{
      if (ExtAttr_DeleteValueID(coStaffStruct,StaffStruct.NRec,cAttrVidRabot)=tsok) {
        set VidRabot;
        //проверим настройку и скопируем внешние атрибуты
        if boGetTune('UP.Staff.AttrCopy_SHR')//Синхронизировать внешние атрибуты в ШР с историей ШР
          if (GetLast LastHistoryStr where (( IFHS.GetLastRec(StaffStruct.Nrec) == LastHistoryStr.NRec )) = tsOk)
            iAttrCopy.UpdateArrt(StaffStruct.Nrec, LastHistoryStr.Nrec, CoStaffStruct, CoHistoryStr);
      }
    }
    fnCategorGK:{
    if (bogettune('NPOEM_OWN.EM_UUK.EDIT_BALANS_KATGK')){
      if (ExtAttr_DeleteValueID(coStaffStruct,StaffStruct.NRec,cAttrCategorGK)=tsok)
        set CategorGK;
      }
    else{
      message('Вам запрещено редактировать поля Балансовый счет, Категория ГК!');
      exit;
      }
    }
  end;

  case inherited :: handleEvent (cmDelOnProtect) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
//------------------- #1993
cmRaise:
{ var _wType:word=wGetTune('NPOEM_OWN.RAISE.PROC_STAFF');
  if _wType=0
  { Message('У вас нет прав на просмотр информации по премия!');
    exit;
  }
  UpdateTable;
  RunInterface('GP_KPI_RaiseProc',if(_wType=1,cgiNotEdit,0),StaffStruct.Nrec,0,0 );

}
    cmValue68:
      {
           pGP_File_hRef.InitParam(
           //if(not CanEditTbl,cgiNotEdit,0)   //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
           0             // Если документ только на чтение следует вызвать cgiNotEdit
          ,25018 //_wTable    : word; указать код таблицы документа системы
          ,StaffStruct.Nrec //_cRec      : comp=0;   // указать поле в таблице
          ,1 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
          ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
          ,'Должн. инструкции: ' + FPOSTNAME
           );
       }


cmPositionChanged:
  {
    var isNeedRecalc : boolean; isNeedRecalc := cStaffStructNRecExInTmp <> StaffStruct.NRec;

    case inherited :: handleEvent (cmPositionChanged) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;

    if (isNeedRecalc)
    {
      SetOutside();

      SetAndClearField;
      RedrawPanel(#STAFFSTRUCT);
    }
  }

end;

TableEvent Table TmpEmployee;
cmPick:{
  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    #ManualNotesPers.NoteStr:{
      if (ManualNotesPers.Pick(coPersons,TmpEmployee.NRecPsn))
        set ManualNotesPers.NoteStr;
    }
  end;
}
end;

function InitEmbedded: boolean;
{
  result:=inherited :: InitEmbedded;
  if (not result) exit;

  cAttrBossPost:=ExtAttr_CreateComp  (coStaffStruct,'Должность функционального руководителя',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
  cAttrBossRaise:=ExtAttr_CreateComp  (coStaffStruct,'Должность руководителя для премии',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
  cAttrVidRabot:=ExtAttr_CreateComp  (coStaffStruct,'Вид работ',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);

  cAttrBalanSch:=ExtAttr_Create     (coStaffStruct,'Балансовый счет присвоенный к должности',0);

  cAttrCategorGK:=ExtAttr_CreateComp  (coStaffStruct,'Категория по методике категорирования ГК',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);


  cfsSetExtProp('i_SCRSTAFFSTRUCT_SSDOPATTRCAT.NAME',cfpFontBackColor,if(IsValidAll(tnSSDopAttrCat),0,ColorNeed));

  SetColumnTitle(brwVacancy,#TmpEmployee.Note,'Прим. из приказа');
}

procedure SetRelation(_cDep: comp);
{
  var isNeedRecalc : boolean; isNeedRecalc := (cStaffStructNRecExInTmp = 0);

  inherited :: SetRelation(_cDep);

  if isNeedRecalc
  {
    SetOutside();
    SetAndClearField;
  }

  ReReadRecord(#CompetenceStaffStr);
}


HandleEvent

cmChangeTabbedSheetFormat:
  {
    case inherited :: handleEvent (cmChangeTabbedSheetFormat) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;

    SetOutside();
    SetAndClearField;

  }

end;

end.
