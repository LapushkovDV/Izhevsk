end; // screen scrDet236

Procedure SetFieldsVisible;
{
  if (ContDoc.wDopAttr = 0)
    SetFieldAndLabelVisible(#Education.FromDate, true);
  else
    SetFieldAndLabelVisible(#Education.FromDate, false);
}

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  inherited::EnableDisable;

  RPD_Base::EnableDisable;//Для fAgreement

  SetFieldsVisible;
  ToggleFieldSelectable(#ContDoc.wDopAttr,fnFieldsOpen);
}

function GetPanel4Agreement: LongInt;
{
  result := #Education;
}

//******************************************************************************
// Печать индивидуального приказа вызванная из события cmPrintDoc
//******************************************************************************
procedure PrintFromPD;
{
  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,1,ContDoc.NRec,ContDoc.Person,Appointments.NRec);
}

//******************************************************************************
//  Процедура утверждения приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{
  result := inherited::ChildConfirmOneOrder(cNrec);
  if (not result) exit;


  if (ContDoc.wDopAttr=1)
  {//Расторжение договора
    // #1747.4
    //Дополнительно, при выборе варианта оформления - <Расторжение договора> -
    //необходимо заполнить дату увольнения сотрудника-студента, но только если он находится в подразделении <_Студенты>
    if iCatFunc.GetCatalogsCode(ContDoc.cDopRef)='_Студенты'
    { Appointments.DismissDate := Education.ToDate;
      result:=update current Appointments = tsok;
      if (not result) {
        message('Ошибка при утверждении позиции приказа',error);
        exit;
      }

      Persons.DisDate := Education.ToDate;
      Persons.DisOrderNmb  := TitleDoc.DocNmb;
      Persons.DisOrderDate := TitleDoc.DocDate;
      Persons.AppointLast := Persons.AppointCur;
      Persons.AppointCur := comp(0);
      result:=update current Persons = tsok;
      if (not result) {
        message('Ошибка при утверждении позиции приказа',error);
        exit;
      }
    } //if iCatFunc.GetCatalogsCode(ContDoc.cDopRef)='_Студенты'
  } //if (ContDoc.wDopAttr=1)
} //function ChildConfirmOneOrder(cNrec : comp = 0): boolean;


//******************************************
// События Education
//******************************************
TableEvent table Education;
cmCheckField:{
  case inherited :: handleEvent (cmCheckField) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    #ContDoc.wDopAttr: // к сожалению редактируется поле в чужой главной таблице
    {
      if Update Current ContDoc <> tsOk {}
      SetFieldsVisible;
    }
  end; //case
}
end;

HandleEvent
cmOnVipLoad:{
  case inherited :: handleEvent (cmOnVipLoad) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  SetFormat(scrDet236);
}
cmPick:{
  case CurField of
    #PrSource:{
      If GetFirst Persons <> tsOk
        Message('Необходимо выбрать сотрудника');
      else
      {
        ParentSav := ContDoc.ObjNrec;

        If RunInterface('GP_GetPrevEducation',136,Persons.NRec,ParentSav,236) = cmDefault {
          set ContDoc.ObjNrec := ParentSav;
          //Таблица не корневая. Сразу обновляем
          If ( Update Current ContDoc <> tsOk ) {};
          //Если запись уже существует то нужно удалить
          If GetFirst Education = tsOk
             if Delete Current Education <> tsOk {};

          //Дублируем запись об обучении
          Education.buffer := tEducation(OldEducation.buffer);
          Education.nrec := 0;
          Education.Person := 0;
          Education.cContDoc := ContDoc.nrec;
          if Insert Current Education <> tsOk {};

          ReReadRecord(tnEducation);
        }
      }
    }
    #fAgreement:{
      case RPD_Base :: handleEvent (cmPick) of
        heAbort:{abort;exit;}
        heStop:{stop;exit;}
      end;
    }
    #Persons.FIO:{
      var cPodr: comp;
      cPodr := ContDoc.cDopRef;

      var DummyMarker: TPtr;
      DummyMarker := InitMarker('', 8, 1, 1);
      ReReadRecord(tnTitleDoc); // поскольку могла поменяться дата

      if (RunInterface('PrikAllPsn', TitleDoc.DocDate, cPodr, longInt(0), DummyMarker, vfCanSelect) = cmdefault)
      {
        if GetMarker(DummyMarker, 0, ParentSav)
         	set ContDoc.Person := ParentSav;

        if not FO.FoundMarkerPodr(Persons.Department)
        {
          set ContDoc.Person := 0;
          Message('Установленный фильтр не позволяет выбирать данное подразделение.', Information);
        }
        else
        {
          set ContDoc.cDopRef := Persons.Department;

          if day(Persons.DisDate) = 0
            set ContDoc.cStr := Persons.AppointCur
          else
            set ContDoc.cStr := Persons.AppointLast;
        }
      }
      DoneMarker(DummyMarker, '');
    }
    else {
      case inherited :: handleEvent (cmPick) of
        heAbort:{abort;exit;}
        heStop:{stop;exit;}
      end;
    }
  end;
}
cmDelOnProtect:{
  case CurField of
    #fAgreement:{
      case RPD_Base :: handleEvent (cmDelOnProtect) of
        heAbort:{abort;exit;}
        heStop:{stop;exit;}
      end;
    }
    else {
      case inherited :: handleEvent (cmDelOnProtect) of
        heAbort:{abort;exit;}
        heStop:{stop;exit;}
      end;
    }
  end;
}
cmHotKeys:{
  var menuID: longint;
  menuID := LoadMenu('RPD_Menu');

  prFillMenu(menuID);

  if (NOAA.GetFirstAgreementByLink(GetCo4Agreement(), GetNRec4Agreement()) <> 0)
    AddMenuItem(menuID, 'Печать доп. соглашения (Word)', cmValue17);

  PutHotCommand(RunLoadMenu(menuID));
}
cmValue17:{//Печать доп. соглашения (Word)
  if (not UpDateTable) exit;

  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,0,ContDoc.NRec,ContDoc.Person,Appointments.NRec);
}
end;

end.
