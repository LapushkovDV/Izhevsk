#include RPD.vih

#include GP_RepLaborContract.vih

#component "Z_StaffOrders"

VipInterface RPD_236(RPD_36) licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  function IRPD_Base.ChildConfirmOneOrder(cNRec: Comp = 0): Boolean;
  function IRPD_Base2.GetPanel4Agreement: LongInt;
  procedure IRPD_Base3.PrintFromPD;
end;

interface RPD_236;

screen scrDet236 (,hcStaffWinPr, scStaffMyPnl);  //Обучение
show at (, 5,,);
table Education;
Bevel e1 { 1, 4, 1, 4, bsRaised, bsHorizontal };
  fields
   PrSource ('Приказ о заключении договора',, scStaffMyPnlPick):protect, PickButton,
          { FONT = { BackColor = If ( isValid ( tnEducation ),0, ColorNeed ) } };
   ContDoc.wDopAttr ('Вариант оформления',,sci13Esc):[list 'Перенос сроков обучения','Расторжение договора'],protect;
   Education.FromDate ('Дата поступления', hcStaffEduFromDate): Noprotect;
   Education.ToDate ('Дата окончания', hcStaffEduToDate): Noprotect;

   OldEducation.FromDate ('Дата поступления', hcStaffEduFromDate): skip;
   OldEducation.ToDate ('Дата окончания', hcStaffEduToDate): skip;
   EduLevelCat.Name ('Вид образования',
        hcStaffPersonsEducation, scStaffMyPnlPick): skip;
   EduNameCat.Name ('Наименование учебного заведения',
        hcStaffEduName, scStaffMyPnlPick): skip;
   EduSpecialityCat.Name ('Специальность',
        hcStaffEduSpeciality, scStaffMyPnlPick): skip;
   EduReasonCat.Name  ('Основание для обучения',, scStaffMyPnlPick): skip;
   fAgreement ('Доп. соглашение'): protect, pickbutton;
   ContDoc.SBottom ('Основание для приказа', hcStaffWinPr), noprotect;
  buttons
     cmViewAdvance1,,,'Просмотр примечания к приказу', hcStaffWinPr;

<<
