/*************************************************************************************************\
* Наименование:  Отчет по принятым сотрудникам                                                    *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2526          |06/06/18 |Ермолов К.Р.            |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih
#include adrFunc.vih

interface gp_priem 'Параметры отчета' gray
Show at (,,43,5);

table struct _tabl
(
p0: comp,
p1: word,
p2: string,
p3: string,
p4: string,
p5: word,
p6: string,
p7: string,
p8: date,
p9: string,
p10: string,
p11: string,
p12: string,
p13: date,
p14: string,
p15: string,
p16: string,
p17: string,
p18: date,
KindApp : string,
prikaz : string,
prikazdata : date,
SrokDate : date,
pStaffStruct : comp,
pPost : comp,
pPersons : comp,
ok3code  : string,
dop3  : string,
uchstep  : string
)
with index
(
i1 = p6
)
;

create view gp_priem

var
_ad: addressFunc;
counter, countpp, countermatrix: longint;
excelpath, addr, zgd, prikaz, nomerpers: string;
data1, data2, prikazdata: date;
_pStaffStruct, _pPost, _pPersons: comp;

select persons.nrec from _tabl, persons, addressn
//, appointments
, COMMUNICATIONS  ;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  data1, noprotect;
  data2, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    В период с:.@@@@@@@@@@  по:.@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  data1:= cur_date;
  data2:= cur_date;
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from _tabl;

  /*sql
  select distinct p.nrec,
    cast(P.cSovm as word) as KodZanyatosti
  , P.SEX as Sex
  , AppKatPodr.Code as PodrKod
  , AppKatPodr.Name as PodrName
  , KlKat.kod as kategoria
  , p.STRTABN as STRTABN
  , p.fio as fio
  //, snils.nomer as snils
  , P.APPDATE as appdate
  , Doljnost.name as doljnost
  , Pasp.Ser as PaspSeriya
  , Pasp.NMB as PaspNomer
  , Pasp.GivenBy as PaspVidanKem
  , Pasp.GivenDate as PaspVidandata
  , '' as Adress
  , '' as ZGD
  ,  ( select top 1 case when Pasp.TODATE <> 0 then date2str(upper('%DD.%MM.%yyyy'),Pasp.TODATE) else 'бессрочно' end
                 from Passports Pasp
                    join catalogs cat on (Pasp.DocName = cat.nrec)
                    where cat.code = '300'
                    and Pasp.Person = p.nrec
     ) as invalidToDate


  , case when CDOC.DAT1 <> #date(0,0,0) then date2str(upper('%DD.%MM.%yyyy'),CDOC.DAT1) else '' end as IspytSrokDo,
  p.disdate
  ,KINDAPP.name
  from persons p
  join ContDoc CDoc on CDoc.PERSON = p.nrec
  join Appointments app on CDoc.CSTR = app.nrec
  left join catalogs KINDAPP on app.KINDAPP = KINDAPP.nrec
  left join KlKatego KlKat on KlKat.nrec = App.EmpCategory
  left join Catalogs AppKatPodr on AppKatPodr.nrec = app.Department
  join PartDoc PDoc on CDoc.CPART = pdoc.nrec
  join TitleDoc TDoc on PDoc.CDOC = tdoc.nrec
  left join Passports Pasp on Pasp.nrec = P.PasspRus
  left join Catalogs Doljnost on Doljnost.nrec = App.Post


  where
  p.isEmployee = 'С' and
  CDoc.TYPEOPER = 1
  and PDoc.TYPEOPER = 1
  and TDOC.WSTATUS = 1
  and  CDOC.DPRIK between :(data1) and :(data2) */

  sql
  select distinct persons.nrec, klsovm.sovm, persons.sex, catalogs.code,
  catalogs.name, klkatego.kod, persons.strtabn, persons.fio, persons.appdate,
  c1.name, passports.ser, passports.nmb, passports.givenby, passports.givendate,
  '' as Adress, '' as ZGD, ( select top 1 case when passports.TODATE <> 0 then date2str(upper('%DD.%MM.%yyyy'),Passports.TODATE) else 'бессрочно' end
                             from Passports
                             join catalogs cat on (Passports.DocName = cat.nrec)
                             //left join COMMUNICATIONS on COMMUNICATIONS.PERSON = persons.Nrec
                             where cat.code = '300'
                             and Passports.Person = persons.nrec
                             ) as invalidToDate,
  date2str(upper('%DD.%MM.%yyyy'),persons.testperiod), persons.disdate, c2.name,
  appointments.ordernmb, appointments.orderdate, APPOINTMENTS.DATEEND,
  appointments.staffstr, appointments.post, appointments.person, ok3.s, dop3.name,uchstep.name
  from persons
  left join klsovm on klsovm.sovm = persons.csovm
  left join appointments on appointments.nrec = persons.appointfirst
  left join catalogs on catalogs.nrec = appointments.department
  left join klkatego on klkatego.nrec = appointments.empcategory
  left join catalogs c1 on c1.nrec = appointments.post
  left join passports on passports.nrec = persons.passprus
  left join catalogs c2 on c2.nrec = appointments.kindapp
  left join staffstruct shr on shr.nrec=appointments.staffstr
  left join catalogs dop3 on dop3.nrec=shr.cinf3
  left join badge bd10 on 10=bd10.badgemonth and persons.nrec=bd10.person
  left join badge bd2 on 2=bd2.badgemonth and persons.nrec=bd2.person
  left join catalogs uchstep on uchstep.nrec=coalesce(bd10.appoint,bd2.appoint)
  outer apply (
                select top 1
                  catok3.code as s
                from spallstaff spok3
                inner join catalogs catok3 on spok3.cbaset = catok3.nrec
                where spok3.clinkt = appointments.staffstr
                      and spok3.wnocon = 25018
                      and spok3.wchoise = 9876
  ) ok3
  where persons.appdate between :(data1) and :(data2) and persons.isemployee = 'С'
  and catalogs.name <> '_Профком' and catalogs.name <> '_Студенты' and catalogs.name <> '_Физические лица' and catalogs.name <> 'Ветераны'
  //and JOIN COMMUNICATIONS ON persons.NREC = COMMUNICATIONS.PERSON

  UNION

  select distinct persons.nrec, klsovm.sovm, persons.sex, catalogs.code,
  catalogs.name, klkatego.kod, persons.strtabn, persons.fio, contdoc.dprik,
  c1.name, passports.ser, passports.nmb, passports.givenby, passports.givendate,
  '' as Adress, '' as ZGD, ( select top 1 case when passports.TODATE <> 0 then date2str(upper('%DD.%MM.%yyyy'),Passports.TODATE) else 'бессрочно' end
                             from Passports
                             join catalogs cat on (Passports.DocName = cat.nrec)
                             //left join COMMUNICATIONS on COMMUNICATIONS.PERSON = persons.Nrec
                             where cat.code = '300'
                             and Passports.Person = persons.nrec
                             ) as invalidToDate,
  date2str(upper('%DD.%MM.%yyyy'),persons.testperiod), persons.disdate, c2.name,
  appointments.ordernmb, appointments.orderdate, APPOINTMENTS.DATEEND,
  appointments.staffstr, appointments.post, appointments.person, ok3.s, dop3.name,uchstep.name
  from partdoc
  left join contdoc on partdoc.nrec = contdoc.cpart
  left join appointments on contdoc.cstr = appointments.nrec
  left join persons on appointments.person = persons.nrec
  left join klsovm on persons.csovm = klsovm.sovm
  left join catalogs on appointments.department = catalogs.nrec
  left join klkatego on appointments.empcategory = klkatego.nrec
  left join catalogs c1 on appointments.post = c1.nrec
  left join passports on persons.passprus = passports.nrec
  left join catalogs c2 on appointments.kindapp = c2.nrec
  left join catalogs dop3 on dop3.nrec=appointments.cref3
  left join badge bd10 on 10=bd10.badgemonth and persons.nrec=bd10.person
  left join badge bd2 on 2=bd2.badgemonth and persons.nrec=bd2.person
  left join catalogs uchstep on uchstep.nrec=coalesce(bd10.appoint,bd2.appoint)
  outer apply (
                select top 1
                  catok3.code as s
                from spallstaff spok3
                inner join catalogs catok3 on spok3.cbaset = catok3.nrec
                where spok3.clinkt = appointments.staffstr
                      and spok3.wnocon = 25018
                      and spok3.wchoise = 9876
  ) ok3
  where partdoc.typeoper = 1 and contdoc.dprik between :(data1) and :(data2) and persons.isemployee = 'С'
  and catalogs.name <> '_Профком' and catalogs.name <> '_Студенты' and catalogs.name <> '_Физические лица' and catalogs.name <> 'Ветераны'

  into _tabl;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_priem.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  xlsetcellstringvalue('ПРИНЯТЫЕ СОТРУДНИКИ НА ПЕРИОД С ' + data1 + ' ПО ' + data2, 1, 1, 1, 1);

  counter:= 3;
  countpp:= 0;
  countermatrix:= 0;
  addr:= '';
  zgd:= '';
  //nomerpers:='0';

  xlCreateMatrix(100, 29);

  _loop _tabl
  {
    nomerpers:='0';
    var _bornDate : date;
    var _SrokDate : date = 0;
    _bornDate := date(0,0,0) ;
    _loop persons where ((_tabl.p0 == persons.nrec ))
    {
      _loop addressn where ((persons.passpaddr == addressn.nrec))
      {
        addr:= _ad.GetFullAddressInd(addressn.nrec);
      }
      //_loop appointments where ((persons.appointfirst == appointments.nrec))
      //{
        //_pStaffStruct:= appointments.staffstr;
        //_pPost:= appointments.post;
        //_pPersons:= appointments.person;
        //zgd:= Get_Func_Boss(_tabl.pStaffStruct, _tabl.pPost, _tabl.pPersons, ZeroDate);
        //prikaz:= appointments.ordernmb;
        //prikazdata:= appointments.orderdate;
        //_SrokDate := APPOINTMENTS.DATEEND;
      //}
      _loop COMMUNICATIONS where ((_tabl.p0 == COMMUNICATIONS.Person and comp(000A000000039960h) /== COMMUNICATIONS.Comtype ))
      {

        nomerpers:= COMMUNICATIONS.Addr ;
        if nomerpers = '0' then nomerpers:='Нет номера';
      }




     _bornDate := Persons.BornDate

    }

    zgd:= Get_Func_Boss(_tabl.pStaffStruct, _tabl.pPost, _tabl.pPersons, ZeroDate);

    countpp++;
    countermatrix++;
    xlDoWriteToMatrix(countermatrix, 1, countpp);
    xlStWriteToMatrix(countermatrix, 2, _tabl.p7);
    xlStWriteToMatrix(countermatrix, 3, _tabl.p6);
    xlDoWriteToMatrix(countermatrix, 4, _tabl.p1);
    xlStWriteToMatrix(countermatrix, 5, _tabl.p2);
    xlStWriteToMatrix(countermatrix, 6, _tabl.p3);
    xlStWriteToMatrix(countermatrix, 7, _tabl.p4);
    xlDoWriteToMatrix(countermatrix, 8, _tabl.p5);
    xlStWriteToMatrix(countermatrix, 9, _tabl.prikaz);
    xlDtWriteToMatrix(countermatrix, 10, _tabl.prikazdata);
    xlDtWriteToMatrix(countermatrix, 11, _tabl.p8);    //дата принятия на работу
    xlStWriteToMatrix(countermatrix, 12, _tabl.p9);
    xlStWriteToMatrix(countermatrix, 13, _tabl.p10);
    xlStWriteToMatrix(countermatrix, 14, _tabl.p11);
    xlStWriteToMatrix(countermatrix, 15, _tabl.p12);
    xlDtWriteToMatrix(countermatrix, 16, _tabl.p13);
    xlStWriteToMatrix(countermatrix, 17, addr);
    xlStWriteToMatrix(countermatrix, 18, zgd);
    xlStWriteToMatrix(countermatrix, 19, _tabl.p16);
    xlStWriteToMatrix(countermatrix, 20, _tabl.p17);
    if _tabl.p18 <> 0 and _tabl.p18 <= cur_date
    then xlStWriteToMatrix(countermatrix, 21, '+')
    else xlStWriteToMatrix(countermatrix, 21, '');
    if _bornDate <> date(0,0,0)
     {
      xlStWriteToMatrix(countermatrix, 22, chr(39) + datetostr(_bornDate,'DD.MM.YYYY'));
      xlStWriteToMatrix(countermatrix, 23, Months_Between(_bornDate,Cur_date) div 12);
     }
    xlStWriteToMatrix(countermatrix, 24, _tabl.kindapp);
    xlStWriteToMatrix(countermatrix, 25, datetostr(_tabl.SrokDate,'DD/MM/YYYY'));
    xlStWriteToMatrix(countermatrix, 26, nomerpers );                  //if (nomerpers not null, nomerpers, 'Нет номера' )
    xlStWriteToMatrix(countermatrix, 27, _tabl.ok3code );
    xlStWriteToMatrix(countermatrix, 28,char(39)+ _tabl.dop3 );
    xlStWriteToMatrix(countermatrix, 29,char(39)+ _tabl.uchstep );
    addr:= '';
    prikaz:= '';
    _pStaffStruct:= 0;
    _pPost:= 0;
    _pPersons:= 0;
    zgd:= '';
    //nomerpers:='0';

    if countermatrix = 100
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  xlFreeMatrix;

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter - 1, 29);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_priem Implements IUserReport;
Interface UserReport_priem;

Procedure Run;
Begin
  runinterface(gp_priem);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Отчет по принятым сотрудникам';
End;

Function GetGroupName (Level : Word) : String;
Begin
#__UNUSED__(Level)
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
