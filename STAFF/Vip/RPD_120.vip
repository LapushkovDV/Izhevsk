//#region Реализация методов объектного интерфейса

procedure IRPD_Base.EnableDisable;
{
  var sTitle: string = '';
  inherited::EnableDisable;

  cfsSetCurrentContainer('Z_STAFFORDERS::GP_ORDERSLISTRPD120');
  cfsGetProp('WHATISINORDER',cfpTitle, sTitle);
  cfsSetProp('WHATISINORDER',cfpTitle, replace(sTitle,'Приказ','Список'));
  cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер списка');
  cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата списка');

  if fnFieldsOpen // не утвержден
  {
    SetHelpAndStatusContext(brPsn   , -1, sci1378Esc, 'StaffWinPr');
    SetHelpAndStatusContext(brRPD120, -1, sci1378Esc, 'StaffWinPr');
  }
  else
  {
    SetHelpAndStatusContext(brPsn   , -1, sci1Esc, 'StaffWinPr');
    SetHelpAndStatusContext(brRPD120, -1, sci1Esc, 'StaffWinPr');
  }
  ToggleFieldSelectable(#GP_RPD120.Summa, fnFieldsOpen);
  ToggleFieldSelectable(#GP_RPD120.dUd  , fnFieldsOpen);
  SetEnableCommand(cmValue1, fnFieldsOpen);
  SetEnableCommand(cmValue2, fnFieldsOpen);
}


// Процедура удаления своих записей, привязанных у удаляемому приказу
Procedure IRPD_Base.MyDel;
{
  if funIsOrderConfirm
  {
    var bCreateDelZarSignal: boolean = false;
    _loop GP_RPD120
    {
      bCreateDelZarSignal := false;

      if getfirst ZarSignal = tsOk
      {
        if (ZarSignal.FilialNo and 1) = 1
          bCreateDelZarSignal := true
        else
          delete current ZarSignal;
      }
      else
        bCreateDelZarSignal := true;

      if bCreateDelZarSignal
      {
        var _params: TGP_SetPrVidOplRK_Params;
        _params.cPers   := persons.nrec;
        _params.cApp    := appointments.nrec;
        _params.wTable  := 116;
        _params.cRec    := GP_RPD120.Nrec;
        _params.wVidUd  := GP_RPD120.VidUd;
        _params.dBeg    := GP_RPD120.dUd;
        _params.dEnd    := GP_RPD120.dUd;
        _params.dSum    := GP_RPD120.Summa;
        _params.wChoice := 1;
        _params.cContDoc:= ContDoc.Nrec;
        _params.nMnem   := GetNMnem(_params.wVidUd);
        _setZarSignal.DelRR(_params);
      }

    } //_loop GP_RPD120
  }

  delete all GP_RPD120;
  inherited::MyDel;
}


function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{
  var _params: TGP_SetPrVidOplRK_Params;
  _loop GP_RPD120
  {
    _params.cPers   := Persons.nrec;
    _params.cApp    := Appointments.nrec;
    _params.wTable  := 116;
    _params.cRec    := GP_RPD120.Nrec;
    _params.wVidUd  := GP_RPD120.VidUd;
    _params.dBeg    := GP_RPD120.dUd;
    _params.dEnd    := GP_RPD120.dUd;
    _params.wChoice := 1;
    _params.cContDoc:= ContDoc.nrec;
    _params.nMnem   := GetNMnem(_params.wVidUd);
    _params.dSum    := GP_RPD120.Summa;
    if _params.dSum != 0
      _setZarSignal.SetRR(_params);
  }
  result := inherited::ChildConfirmOneOrder(cNrec);
}


procedure IRPD_Base3.PrintRPD(typePrint: TPtr; fcEnter: word);
{
  fcEnter := fcEnter;
  if typePrint = 0 PrintRPD120;
}

//#endregion Реализация методов объектного интерфейса


//#region Обработчики событий

tableevent table ContDoc;
  cmSetDefault:
  {
    SetNewContDocBuffer;
  }
end; //tableevent table ContDoc


tableevent table GP_RPD120;

  cmUpdateRecord: { update current GP_RPD120; RescanPanel(tnContDoc); }
  cmInsertRecord: { insert current GP_RPD120; RescanPanel(tnContDoc); }
  cmDeleteRecord: { delete current GP_RPD120; RescanPanel(tnContDoc); }
  cmSetDefault:
  {
    ClearBuffer(tnGP_RPD120);
    GP_RPD120.cContDoc := ContDoc.Nrec;
    GP_RPD120.VidUd    := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_120.VIDUD');
    GP_RPD120.dUd      := dGetTune('UP.DATOTCH');
  }
  cmCheckField:
  {
    case curfield of
      #GP_RPD120.Summa: { UpdateTable; RescanPanel(tnContDoc); }
    end;
  }
end; //tableevent table GP_RPD120;


handleevent
  cmPick:
  {
    case curfield of
      #Persons.FIO:
      {
        var cPodr: comp = ContDoc.cDopRef;
        var DummyMarker: TPtr = InitMarker('', 8, 1, 1);

        ReReadRecord(tnTitleDoc);
        if RunInterface('PrikAllPsn', TitleDoc.DocDate, cPodr, Longint(0), DummyMarker, vfCanSelect) = cmDefault
        {
          var c: comp = 0;
          if GetMarker(DummyMarker, 0, c)
           	set ContDoc.Person := c;

          if not FO.FoundMarkerPodr(Persons.Department)
          {
            set ContDoc.Person := 0;
            Message('Установленный фильтр не позволяет выбирать данное подразделение.', Information);
          }
          else
          {
            set ContDoc.cDopRef := Persons.Department;
            set ContDoc.cStr := if(Persons.DisDate = 0, Persons.AppointCur, Persons.AppointLast);
          }
        }
        DoneMarker(DummyMarker, '');
      } //#Persons.FIO:
      #fullNamePodr:
      {
        var c: comp = ContDoc.cDopRef;
        if RunInterface('PickCatalog2', Integer(-11), c, Comp(0)) = cmDefault
        {
          if not FO.FoundMarkerPodr(c)
            Message('Установленный фильтр не позволяет выбирать данное подразделение.', Information);
          else
          {
            if (ContDoc.Person <> 0) and (ContDoc.cDopRef <> 0) and (ContDoc.cDopRef <> c)
              Message('Нельзя изменить подразделение у выбранного сотрудника!');
            else
              set ContDoc.cDopRef := c;
            SelectField(#Persons.FIO);
          }
        }
      } //#fullNamePodr:
      #KlVidUd.NVidUd:
      {
        if GP_RPD120.VidUd = coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_120.VIDUD')
          set GP_RPD120.VidUd := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_120.VIDUDVAL')
        else
          set GP_RPD120.VidUd := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_120.VIDUD');
      }
      #AOFld:
      {
        var c: comp = GP_RPD120.cPlPor;
        if RunInterface(F_PLPOR::G_PlPor, cgiPick, cgTip_DocDefs, 0, 0, ContDoc.Person, 0, c) = cmDefault
        {
          var cPlPorOld: comp   = GP_RPD120.cPlPor;
          set GP_RPD120.cPlPor := c;
          if getfirst PlPor = tsOk
          {
            if PlPor.cPersons != ContDoc.Person
            {
              Message('Запрещен выбор авансового отчета по сотруднику, отличному от сотрудника в приказе', error);
              set GP_RPD120.cPlPor := cPlPorOld;
              exit;
            }
            if getfirst GP_RPD120_Chck = tsOk
            {
              Message('Запрещено выбирать один и тот же платежный документ по сотруднику дважды', error);
              set GP_RPD120.cPlPor := cPlPorOld;
              exit;
            }
            set GP_RPD120.VidUd  := GetVidUdByPlPor(c);
            if PlPor.TiDkGal = cgDoc_0009
            {
              var d: double = GetSaldoByAO(c);
              if d != GP_RPD120.Summa
                if Message('Установить в поле "Сумма" сумму остатка по авансовому отчету (' +
                           DoubleToStr(d, '[|-]3666`666`666`666`666.88') + ')?', YesNo) = cmYes
                  set GP_RPD120.Summa := d;
            }
          }
        }
      }
    end;
  }
  cmEdit:
  {
    case curfield of
      #AOFld:
      {
        if IsValid(tnPlpor)
        {
          PutCommand(cmEdit);
          RunInterface(F_PLPOR::PlPor, PlPor.TiDkGal, PlPor.TiDk, Plpor.Nrec);
        }
      }
    end;
  }
  cmHotKeys:
  {
    var menuID: longint = LoadMenu('RPD120_Menu');
    PutHotCommand(RunLoadMenu(menuID));
  }
  cmValue1:
  {
    if RunWindowModal(wParams) = cmDefault
      FillDoc(0);
    RereadRecord(tnContDoc);
  }
  cmValue2:
  {
    if RunWindowModal(wParams) = cmDefault
      FillDoc(1);
    RereadRecord(tnContDoc);
  }
  cmOnVipLoad:
  {
    case inherited::handleevent(cmOnVipLoad) of
      heAbort: Abort;
      heStop: Stop;
    end;
    _dEnd := dGetTune('UP.DATOTCH');
    _dEnd := Date(Last_Day(_dEnd), Month(_dEnd), Year(_dEnd));
    _dBeg := Date(1, Month(_dEnd), Year(_dEnd));
  }
  cmPrintDoc: PrintRPD120;
end;

//#endregion Обработчики событий

end.


