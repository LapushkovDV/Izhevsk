  show(,,30, 6);

  screen scParams;
    fields
      _dBeg: NoProtect;
      _dEnd: NoProtect;
    buttons
      cmOk, default;
      cmCancel;
<<

 Период анализа авансовых отчетов
`с`.@@@@@@@@@@`по`.@@@@@@@@@@

    <.Продолжить.> <.Отмена.>
>>
  end;

  handleevent
    cmOk: PutCommand(cmDefault);
  end;

end; //window wParams


browse brPsn  (, hcStaffWinPr, sci1378Esc);
show at (,,,10) fixed_y;
table ContDoc;
  fields
    fullNamePodr    'Подразделение' ('Подразделение', hcStaffWinPr, )       : [25], protect;
    Persons.FIO     'ФИО'           ('Фамилия имя отчество', hcStaffWinPr, ): [28], protect,
      {Font = {BackColor = if(not IsValid(#Persons), ColorNeed, 0)}};
    Persons.StrTabN 'Табельный №'   ('Табельный номер', hcStaffWinPr)       : [12], skip;
    CatPost.Name    'Должность'     ('Должность', hcStaffWinPr)             : [15], skip;
    Sum120          'Сумма'         ('Сумма', hcStaffWinPr)                 : [,'\2p[|-]3666`666`666`666.88'], Skip;
end; //browse brPsn


browse brRPD120 (,,sci1378Esc);
  show(,11,,);
  table GP_RPD120;
  fields
    KlVidUd.NVidUd  'Вид удержания'                       : [30], protect;
    GP_RPD120.dUd   'Дата удержания'                      : [10], noprotect;
    AOFld           'Основание для выплаты'               : [30], protect, editbutton;
    GP_RPD120.Summa 'Сумма' ('Сумма погашения',,sci178Esc): [,'\2p[|-]3666`666`666`666.88'], noprotect;
end;

