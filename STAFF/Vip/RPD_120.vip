#include G_PLPOR.vih
#include RPD.vih
#include GP_SetPrVidOplRK.vih
#include Query.vih

#component "Z_StaffOrders"

VipInterface RPD_120(RPD_Base) licensed(free);
  public:
    procedure IRPD_Base.EnableDisable;
    procedure IRPD_Base.MyDel;
    function  IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
    procedure IRPD_Base3.PrintRPD(typePrint: TPtr; fcEnter: word);
end;

interface RPD_120;

var
  _setZarSignal : GP_SetPrVidOplRK;  //формирование записей в рабочей корзине
  _qSaldoByPlPor: IQuery; //Запрос, возвращающий сумму остатка по АО
  _dBeg         : date;
  _dEnd         : date;

create view
var
  _cPlPorStZatr: comp;
as select
  IDepartIer.GetFulDepName(ContDoc.cDopRef)
    (FieldName = fullNamePodr),
  ShowKau(cgKau_PlPor, GP_RPD120.cPlPor)
    (FieldName=AOFld),
  tSum120.Summa
    (FieldName=Sum120)
from
  Appointments
 ,Catalogs CatPost
 ,GP_RPD120
 ,GP_RPD120 GP_RPD120_Chck
 ,KlVidUd
 ,PlPor
 ,ZarSignal
 ,KatLink
 ,(select Sum(t.Summa)(fieldname=Summa)
   from GP_RPD120 t
   where (( ContDoc.Nrec == t.cContDoc))
  ) tSum120
where ((
      ContDoc.cStr      == Appointments.Nrec

  and Appointments.Post == CatPost.Nrec

  and ContDoc.Nrec      == GP_RPD120.cContDoc

  and GP_RPD120.VidUd   == KlVidUd.VidUd

  and GP_RPD120.cPlPor  == PlPor.Nrec

  and ContDoc.Nrec          == GP_RPD120_Chck.cContDoc
  and (GP_RPD120_Chck.cPlPor = GP_RPD120.cPlPor
  and  GP_RPD120_Chck.Nrec  <> GP_RPD120.Nrec)

  and 1                 == ZarSignal.SubSysCode
  and 116               == ZarSignal.SrcTable
  and GP_RPD120.Nrec    == ZarSignal.SrcRec
  and (ZarSignal.Comp4   = ContDoc.Nrec)

  and comp(0)           == KatLink.cUser
  and coStZatr          == KatLink.CodeTable
  and word(1)           == KatLink.Code
  and (KatLink.cRec      = _cPlPorStZatr)
));


create view vKlVidUd
var
  _wVidUd: word;
from klvidud
where ((
  _wVidUd == klvidud.vidud
))
;


//#region Вспомогательные функции

// Возвращает наименование ведомости удержаний по коду вида удержаний
function GetNMnem(wVidUd: word): string;
{
  var s1, s2: string='';
  s2 := ' (пр. №' + TitleDoc.DocNmb + ')';
  vKlVidUd._wVidUd := wVidUd;
  if vKlVidUd.getfirst klvidud = tsOk
    s1 := vKlVidUd.klvidud.nvidud;
  else
    s1 := 'Межрасчетное удержание';
  result := substr(s1, 1, 39 - length(s2)) + s2;
}


//Устанавливает поля по умолчанию для новой записи ContDoc
procedure SetNewContDocBuffer;
{
  ClearBuffer(tnContDoc);
  ContDoc.cPart    := PartDoc.Nrec;
  ContDoc.ObjType  := 1;    // to table Persons
  ContDoc.NumPart  := 1;
  ContDoc.SeqNmb   := 1;
  ContDoc.TypeOper := PartDoc.TypeOper;
  ContDoc.wRec     := 1;
  ContDoc.NumPart  := Integer(PartDoc.NRazd);
  ContDoc.Nrec     := GetNextnRec(tnContDoc, 0);
  if GetLast ContDocNmb where ((PartDoc.Nrec     == ContDocNmb.cPart    and
                                PartDoc.TYPEOPER == ContDocNmb.TypeOper and
                                1                == ContDocNmb.SeqNmb)) = tsOk
    ContDoc.wRec   := ContDocNmb.wRec + 1
  else
    ContDoc.wRec   := 1;
}


function GetVidUdByPlPor(cPlPorNrec: comp): word;
{
  _cPlPorStZatr := coGetAttr(coPlPor, cPlPorNrec, sGetTune('UP.STAFF.PRIKAZ_PERS.RPD_120.AttrStZatr'));
  if getfirst KatLink = tsOk
    result := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_120.VIDUDVAL');
  else
    result := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_120.VIDUD');
}


//#region sql query qSaldo
sql query qSaldo =
select
  PlPor.Nrec as cPlPor,
  LSchet.tPerson as cPerson,
  sum(Summa) as Summa
from
 (select
    PlPor.Nrec,
    RashDoc.SumV2 * case when RashDoc.PrOst = 1 or RashDoc.Kol = 0 then 1 else RashDoc.Kol end as Summa
  from
    PlPor
  join RashDoc on
    RashDoc.TipDoc = PlPor.TiDkGal and
    RashDoc.cSoprDoc = PlPor.Nrec
  where
    PlPor.TiDkGal = 9 and
    PlPor.DatOb between :dBeg and :dEnd

  union all

  select
    PlPor.Nrec,
    case when DocPodot.TipDoc = 99
         then DocPodot.Summa
         else PlPor1.SumPlat
    end * case when DocPodot.TipDoc = 99 then 1 else -1 end as Summa
  from
    PlPor
  join DocPodot on
    DocPodot.TipDoc in (9, 99, 10) and
    DocPodot.cPrDoc = PlPor.Nrec
  left join PlPor PlPor1
    on PlPor1.Nrec = DocPodot.cVtDoc
  where
    PlPor.TiDkGal = 9 and
    PlPor.DatOb between :dBeg and :dEnd
 ) t
join PlPor on
  PlPor.Nrec = t.Nrec
join LSchet on
  LSchet.Nrec = PlPor.cLSchet
group by
  PlPor.Nrec,
  LSchet.tPerson;
//#endregion sql query qSaldo

procedure FillDoc(wMode: word);
{
  PushPos(tnContDoc);
  if not BoundActive(tbByPersRec)
    AddBounds(tbByPersRec);

  var rs: IResultSet = queryManager.createQuery(qSaldo)
                                   .setParam('dBeg', _dBeg)
                                   .setParam('dEnd', _dEnd)
                                   .getResultSet;
  if rs.getFirst = tsOk do {

    var d: double = rs.row.Val('Summa');
    if (d = 0) or (wMode = 0 and d < 0) or (wMode = 1 and d > 0)
      Continue;

    cCPRec := rs.row.Val('cPerson');
    if getfirst ContDoc != tsOk
    {
      SetNewContDocBuffer;
      ContDoc.Person := cCPRec;
      if getfirst Persons = tsOk
      {
        ContDoc.cDopRef := Persons.Department;
        ContDoc.cStr := if(Persons.DisDate = 0, Persons.AppointCur, Persons.AppointLast);
      }
      insert current ContDoc;
    }

    var c: comp = rs.row.Val('cPlPor');
    if getfirst GP_RPD120 where ((ContDoc.Nrec == GP_RPD120.cContDoc and
                                  (GP_RPD120.cPlPor = c) )) != tsOk
    {
      ClearBuffer(tnGP_RPD120);
      GP_RPD120.cContDoc := ContDoc.Nrec;
      GP_RPD120.VidUd    := GetVidUdByPlPor(c);
      GP_RPD120.dUd      := dGetTune('UP.DATOTCH');
      GP_RPD120.cPlPor   := c;
      GP_RPD120.Summa    := -d;
      insert current GP_RPD120;
    }
    else
    {
      GP_RPD120.Summa    := d;
      update current GP_RPD120;
    }
  } while rs.getNext = tsOk;

  SubBounds(tbByPersRec);
  PopPos(tnContDoc);
  RescanPanel(tnContDoc);
}


//#region sql query qSaldoByPlPor
sql query qSaldoByPlPor =
  select
    sum(Summa) as Summa
  from
    ( select
        RashDoc.SumV2 * case when RashDoc.PrOst = 1 or RashDoc.Kol = 0 then 1 else RashDoc.Kol end as Summa
      from
        PlPor
      join RashDoc on
        RashDoc.TipDoc = PlPor.TiDkGal and
        RashDoc.cSoprDoc = PlPor.Nrec
      where
        PlPor.Nrec = :cPlPor

      union all

      select
        case when DocPodot.TipDoc = 99
             then DocPodot.Summa
             else PlPor1.SumPlat
        end * case when DocPodot.TipDoc = 99 then 1 else -1 end as Summa
      from
        PlPor
      join DocPodot on
        DocPodot.TipDoc in (9, 99, 10) and
        DocPodot.cPrDoc = PlPor.Nrec
      left join PlPor PlPor1
        on PlPor1.Nrec = DocPodot.cVtDoc
      where
        PlPor.Nrec = :cPlPor
    ) t
;
//#endregion

function GetSaldoByAO(cPlPorNrec: comp): double;
{
  if _qSaldoByPlPor = NullRef
    _qSaldoByPlPor := queryManager.createQuery(qSaldoByPlPor);
  result := _qSaldoByPlPor.setParam('cPlPor', cPlPorNrec).getResultValue;
}

procedure PrintRPD120;
{
  var m: TPtr = InitMarker('', 8, 30, 10, true);
  PushPos(tnContDoc);
  _loop ContDoc
    InsertMarker(m, ContDoc.Nrec);
  if GetMarkerCount(m) = 0
    Message('Отсутствуют данные для отчета', Warning);
  else
    RunInterface(GP_Staff::GP_RPD120_Report, m);
  PopPos(tnContDoc);
  DoneMarker(m, '');
}

//#endregion Вспомогательные функции


