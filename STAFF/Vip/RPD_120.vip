{
  - 'Печать', cmPrintDoc, 'Печать', hcStaffReceptionMenu, 'Ctrl+P', kbCtrlP,,,,, bmpPrint;
  - 'Возврат подотчетных сумм', cmValue1;
  - 'Удержание подотчетных сумм', cmValue2;
  -----------;
  - 'Внешняя классификация', cmPickClass, 'Внешняя классификация'
      ,hcGkatalM1ExtClass,'Alt+C', kbAltC, sci1Esc,,,, bmpClassifierSO;
  - 'Внешние атрибуты', cmPickAttr, 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr
      ,'Alt+A', kbAltA, sci1Esc,,,, bmpAttributeSO;
  -----------;
  - 'Проверка списка', cmCheckRPD,
       'Проверка списка', hcNoContext, 'Ctrl+M', kbCtrlM,,,,, bmpCheck16;
}
