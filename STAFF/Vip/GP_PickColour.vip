#doc
  Интерфейс выбора цвета
#end

VipInterface GP_PickColour licensed (FREE)
parameters (
 returnColorVal : word;
 returnColorName : string
 );
//==========================================================================
Interface GP_PickColour 'Выбор цвета' EscClose;

const
#include fldcolor.inc
end;

var pickedColourList, returnColorVal : word;
var returnColorName : string;

table struct tmpPickedColour
(
  colourName : string,
  colour : word
);

create view v
as select *
from tmpPickedColour;

Parameters
  returnColorVal,   //значение цвета
  returnColorName   //название цвета
;

Screen scrPickColour 'Выбор цвета';
show (,,,5);
fields
  pickedColourList : [List 0 'нет',
                             'Aqua',
                             'Lime',
                             'Green',
                             'Olive',
                             'Navy',
                             'Purple',
                             'Teal',
                             'Gray',
                             'Silver',
                             'Red',
                             'Yellow',
                             'Blue',
                             'Fuchsia'] , protect;
Buttons
  cmOk,default,,'Выбрать цвет', , ;
  cmCancel,,,'Выход', , ;
<<

 `Выберите цвет`  .@@@@@@@@@@@@@@@

  <. ~В~ыбрать .>   <. ~О~тмена .>

>>
end;

browse brwPickColour;
show at (,6,,);
noresort;
table tmpPickedColour;
Fields
  {Font = {BackColor = tmpPickedColour.colour}};
  tmpPickedColour.colourName 'Выбранный цвет' : protect;
end;

HandleEvent

cmCheckField :
{
  case curfield of
  #pickedColourList :
  {
    case pickedColourList of
      0: {
        returnColorVal := 0;
        returnColorName := 'нет';
      }
      1: {
        returnColorVal := ColorSysAqua;
        returnColorName := 'Aqua';
      }
      2: {
        returnColorVal := ColorSysLime;
        returnColorName := 'Lime';
      }
      3: {
        returnColorVal := ColorSysGreen;
        returnColorName := 'Green';
      }
      4: {
        returnColorVal := ColorSysOlive;
        returnColorName := 'Olive';
      }
      5: {
        returnColorVal := ColorSysNavy;
        returnColorName := 'Navy';
      }
      6: {
        returnColorVal := ColorSysPurple;
        returnColorName := 'Purple';
      }
      7: {
        returnColorVal := ColorSysTeal;
        returnColorName := 'Teal';
      }
      8: {
        returnColorVal := ColorSysGray;
        returnColorName := 'Gray';
      }
      9: {
        returnColorVal := ColorSysSilver;
        returnColorName := 'Silver';
      }
      10: {
        returnColorVal := ColorSysRed;
        returnColorName := 'Red';
      }
      11: {
        returnColorVal := ColorSysYellow;
        returnColorName := 'Yellow';
      }
      12: {
        returnColorVal := ColorSysBlue;
        returnColorName := 'Blue';
      }
      13: {
        returnColorVal := ColorSysFuchsia;
        returnColorName := 'Fuchsia';
      }
    end;
    tmpPickedColour.colour := returnColorVal;
    //tmpPickedColour.colourName := returnColorName;
    update current tmpPickedColour;
    ReReadRecord(tntmpPickedColour);
  }
  end;
}
cmInit :
{
  delete all tmpPickedColour;
  ClearBuffer(tntmpPickedColour);
  tmpPickedColour.colour := 0;
  insert current tmpPickedColour;
}
cmDone :
{
}

cmOk :
{
  CloseInterface(cmDefault);
  //ReScanPanel(#journalBody);
}

cmCancel :
{
  CloseInterface(cmDefault);
}
end; //HandleEvent
end.
