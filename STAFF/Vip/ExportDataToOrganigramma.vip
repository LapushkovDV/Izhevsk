#include CatFunc.vih                  // Интерфейс работы с каталогом
#include StaffStruct.vih              // Штатное расписание

#include GP_xlMatrixUtil.vih

#component "Z_StaffReports"
//Экспорт данных ШР для органиграммы
alter interface ExportDataToOrganigramma;
ExtendFormats srcSettings;

var iCatFunc : CatalogsFunctions;
    iStaffStr : StaffStruct;
    xlMatrixUtil:GP_xlMatrixUtil new;
    cAttrBossPost:comp;

create view
from
  Appointments BossApp,
  Persons BossPers
bounds ByBoss = coGetAttrID(coStaffStruct,StaffStruct.NRec,cAttrBossPost) == BossApp.StaffStr
                and BossApp.Person == BossPers.Nrec;

screen srcSettings ;
buttons
  cmToExcel,,,,, sci1Esc;
<<
                         <.Выгрузить в Excel.>
>>
end; // screen srcSettings

procedure PrintHeader;
var nom,Numcol:longint;
{
  nom:=1;
  Numcol:=1;

  xlSetCellStringValue('ID',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(25, nom, Numcol, nom, Numcol); //ширина ячейки

  Numcol++;
  xlSetCellStringValue('ФИО',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(50, nom, Numcol, nom, Numcol); //ширина ячейки

  Numcol++;
  xlSetCellStringValue('Дата приема',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(12, nom, Numcol, nom, Numcol); //ширина ячейки

  Numcol++;
  xlSetCellStringValue('BossID',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(25, nom, Numcol, nom, Numcol); //ширина ячейки

  Numcol++;
  xlSetCellStringValue('ФИО Руководителя',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(50, nom, Numcol, nom, Numcol); //ширина ячейки

  Numcol++;
  xlSetCellStringValue('Подразделение',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(50, nom, Numcol, nom, Numcol); //ширина ячейки

  Numcol++;
  xlSetCellStringValue('Должность',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(30, nom, Numcol, nom, Numcol); //ширина ячейки

  Numcol++;
  xlSetCellStringValue('№ п/п',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(7, nom, Numcol, nom, Numcol); //ширина ячейки

  Numcol++;
  xlSetCellStringValue('Ставок',nom , Numcol, nom, Numcol);
  xlSetColumnWidth(5, nom, Numcol, nom, Numcol); //ширина ячейки

  xlSetFontStyle(xlBold, nom , 1, nom, Numcol);
  xlSetFontSize(14, nom , 1, nom, Numcol);
  xlFrameCells(xlBorderL+xlBorderR+xlBorderT+xlBorderB+xlInsideH+xlInsideV,xlThin,xlContinuous,0,
               nom,1,nom,Numcol);
}

function PrintOneRow:boolean;
var Numcol:longint;
{
  result:=xlMatrixUtil.AddRow;
  if (not result) exit;

  Numcol:=1;
  xlMatrixUtil.StWrite(Numcol,'App_'+String(Appointments.NRec,0,0));

  if (IsValidAll(tnPersons)) {
    Numcol++;
    xlMatrixUtil.StWrite(Numcol,Persons.StrTabn+' '+Persons.FIO);
    Numcol++;
    xlMatrixUtil.StWrite(Numcol,DateToStr(Persons.AppDate, 'DD.MM.YYYY'));
  }
  else
    Numcol+=2;

  if (IsValidAll(tnBossPers)) {
    Numcol++;
    xlMatrixUtil.StWrite(Numcol,'App_'+String(BossApp.NRec,0,0));
    Numcol++;
    xlMatrixUtil.StWrite(Numcol,BossPers.StrTabn+' '+BossPers.FIO);
  }
  else
    Numcol+=2;

  Numcol++;
  xlMatrixUtil.StWrite(Numcol,tmpCatalogs.Name);

  Numcol++;
  if (IsValidAll(tnPostCat))
    xlMatrixUtil.StWrite(Numcol,PostCat.Name);

  Numcol++;
  xlMatrixUtil.DoWrite(Numcol,StaffStruct.SeqNmb);

  Numcol++;
  xlMatrixUtil.DoWrite(Numcol,Appointments.Rate);
}

function PrintOneRowForVacancy(Rate:double):boolean;
var Numcol:longint;
{
  result:=xlMatrixUtil.AddRow;
  if (not result) exit;

  Numcol:=1;
  xlMatrixUtil.StWrite(Numcol,'Vac_'+String(xlMatrixUtil.ExcelRow)+'_'+String(StaffStruct.NRec,0,0));

  Numcol++;
  xlMatrixUtil.StWrite(Numcol,'ВАКАНСИЯ');

  Numcol++;

  if (IsValidAll(tnBossPers)) {
    Numcol++;
    xlMatrixUtil.StWrite(Numcol,'App_'+String(BossApp.NRec,0,0));
    Numcol++;
    xlMatrixUtil.StWrite(Numcol,BossPers.StrTabn+' '+BossPers.FIO);
  }
  else
    Numcol+=2;

  Numcol++;
  xlMatrixUtil.StWrite(Numcol,tmpCatalogs.Name);

  Numcol++;
  if (IsValidAll(tnPostCat))
    xlMatrixUtil.StWrite(Numcol,PostCat.Name);

  Numcol++;
  xlMatrixUtil.DoWrite(Numcol,StaffStruct.SeqNmb);

  Numcol++;
  xlMatrixUtil.DoWrite(Numcol,Rate);
}

HandleEvent
cmToExcel:{
  if ( getfirst Catalogs = tsOK )
    SelectRecord(Catalogs.Nrec);

  if (not xlCreateExcel('Орг структура должностей',true)) {
    message('Ошибка открытия Excel.',error);
    exit;
  }

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Выбор подразделений', RecordsInTable(#tmpCatalogs));

  PrintHeader;

  xlMatrixUtil.ExcelFirstRow:=2;
  xlMatrixUtil.ExcelFirstCol:=1;
  xlMatrixUtil.MatrixColCount:=9;

  var lPsnCount, lDepCount: longint;

  lPsnCount := viComF.GetPsnCount;
  lDepCount := viComF.GetDeptCount;

  cAttrBossPost:=ExtAttr_ID(coStaffStruct,'Должность функционального руководителя');
  AddBounds(tbByBoss);
  _loop tmpCatalogs {
    if (not NextVisual) Break;

    if ( lDepCount > 0 )
      if ( not FoundMarker(viComF.GetDepartmentsMarker, tmpCatalogs.Nrec) )
        continue;

    if ( not viDepLim.Exists(tmpCatalogs.Nrec) )
      continue;

    if (fltNoClosed = 1)         // Если установлен фильтр "Не отображать закрытые подразделения" (1), то
    {
      if (tmpCatalogs.DateCreation > fltCloseDt)  // если у подразделения дата образования больше фильтра
        continue
      else
       if ( (tmpCatalogs.DateDestruction <> ZeroDate) and // если у подразделения установлена дата закрытия
            (tmpCatalogs.DateDestruction <  fltCloseDt) ) // и эта дата меньше даты фильтра
        continue;
    }

 //   if fltNoDolg = 0 // Если установлен фильтр "Не отображать должности" (1), то не отображаем
      _loop StaffStruct
      {
        _loop Appointments
        {
          if ( Appointments.DismissDate <> Date(0,0,0) )
            continue;

          if ( lPsnCount > 0 )
              if ( not FoundMarker(viComF.GetPersonsMarker, Persons.Nrec) )
                continue;

          if (not PrintOneRow) break;
        } // _loop Appointments

        var Workers:double=0;
        Workers:=iStaffStr.GetWorkersStaff(StaffStruct.NRec, if(fltCloseDt<>ZeroDate,fltCloseDt,Cur_Date)); //вакансии
        if (Workers>0) {
          var i:longint;
          if Trunc(Workers) > 0
            for (i:= 1; i <= Trunc(Workers); i++)
              if (not PrintOneRowForVacancy(1)) break;

          if (Workers - Trunc(Workers)) > 0
            PrintOneRowForVacancy(Workers - Trunc(Workers));
        }
      } // _loop StaffStruct
  }//_loop tmpCatalogs
  SubBounds(tbByBoss);

  viComF.StoreAllParams;
  delete all tmpCatalogs;

  xlMatrixUtil.WriteMatrix;
  xlWrapText(2, 1, xlMatrixUtil.ExcelRow, 10);//перенос по словам
  xlAlignCellsEx(xlLeft,xlCenter, 2, 1, xlMatrixUtil.ExcelRow, 10); //текст в ячейке по центру
  xlKillExcel;

  StopVisual;
}
end;

end.
