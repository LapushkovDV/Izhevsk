/* Заполнение через связанный сервер
insert into V$GP_SCUD_AREAS (F$ID_AREAS_TREE, F$N_LEFT, F$N_RIGHT, F$N_LEVEL
    , F$INNER_NAME, F$DISPLAY_NAME, F$VISIBLE, F$SCHEME_COORDS, F$SCHEME_ID
  	,F$SCHEME_BRUSH_STYLE, F$SCHEME_COLOR, F$SCHEME_BRUSH_COLOR)
SELECT AREAS_TREE.* FROM OPENQUERY([SCUD], '
select ID_AREAS_TREE, N_LEFT, N_RIGHT, N_LEVEL
  , INNER_NAME, DISPLAY_NAME, VISIBLE, SCHEME_COORDS, SCHEME_ID
  , SCHEME_BRUSH_STYLE, SCHEME_COLOR, SCHEME_BRUSH_COLOR
          from AREAS_TREE
') AREAS_TREE
Left outer join V$GP_SCUD_AREAS on V$GP_SCUD_AREAS.F$ID_AREAS_TREE=AREAS_TREE.ID_AREAS_TREE
where V$GP_SCUD_AREAS.F$NREC is Null
*/
#include marker.vih // описание объекта и объявление интерфейса
                    // marker c реализацией по умолчанию
#include GP_Protector.Vih
#include GP_UserAccessService.vih
#include GP_StatusAccessEdit.vih

#include GP_SCUD_AreasEdit.Vih
#doc
 Наименование: СКУД Ареалы  - содержит информацию о пунктах контроля                             *
#end
Interface GP_SCUD_AreasEdit 'СКУД Ареалы' , EscClose;
Show At (,,70,20) ;
var
  cRec    :Comp   ; // ссылка на группу
  pMarker:IMarker(Marker) new;
  Marker:longint;
Create View
as select GP_SCUD_Areas.Nrec
From
  GP_SCUD_Areas
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;

//*************************************************8
QuickChoice qcByCode
{
  AcceptField = GP_SCUD_Areas.Nrec;
  ViewField = GP_SCUD_Areas.INNER_NAME;
  ViewField = GP_SCUD_Areas.DISPLAY_NAME;
  // только текстовый поля!
  SearchField = GP_SCUD_Areas.INNER_NAME;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Areas.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_Areas.Nrec;
  ViewField = GP_SCUD_Areas.DISPLAY_NAME;
  ViewField = GP_SCUD_Areas.INNER_NAME;
  // только текстовый поля!
  SearchField = GP_SCUD_Areas.DISPLAY_NAME;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Areas.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName



//-----------------------------------------
// Получить наименование
//-----------------------------------------
Function GetAreaName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Areas where
          (( _pNrec == GP_SCUD_Areas.nrec ))<>tsok exit;
  Result:=GP_SCUD_Areas.DISPLAY_NAME;
} //Function GetAreaName(_pNrec:comp)   :string; cacheable;

//-----------------------------------------
// Получить код
//-----------------------------------------
Function GetAreaCode(_pNrec:comp)   :string;cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Areas where
          (( _pNrec == GP_SCUD_Areas.nrec ))<>tsok exit;
  Result:=GP_SCUD_Areas.INNER_NAME;
} //Function GetAreaCode(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить тип
//-----------------------------------------
Function GetAreaType(_pNrec:comp)   :word;cacheable;
{ GetAreaType:=0;
  if getfirst fastfirstrow GP_SCUD_Areas where
          (( _pNrec == GP_SCUD_Areas.nrec ))<>tsok exit;
  Result:=GP_SCUD_Areas.wType;

} //Function GetAreaType(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetAreaTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  0: Result:='Выход';
  2: Result:='Вход';
  end;
} //Function GetAreaTypeName(_wType:word)   :string;cacheable;



//---------------------------------------------
// Тип документа
//---------------------------------------------
Function GetTypeDoc:word;
{ Result:=GP_iSC_Areas;//1013; //
}

//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{     inherited ::LoadInterface(_boVisibleRun);
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { LoadProtector;
        DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_AreasdEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;

      //===========================
      if (not UserAccessService.IsAdmin)
      { if wIntMode=0
        { //message('Вы не обладаете ролью Администратор.'#13'Редактирование запрещено.');
        }
        wIntMode:=wIntMode or cgiNotEdit
      }
      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
} //Procedure LoadInterface(_wRunType:word);


Browse brArea '' (,,sci1Esc) ;
Table GP_SCUD_Areas ;
recMarker=pMarker;
Fields
  GP_SCUD_Areas.INNER_NAME     'INNER_NAME'  :[20],Protect,NoDel;
  GP_SCUD_Areas.DISPLAY_NAME   'Наименование':[20],Protect,NoDel;
  GP_SCUD_Areas.VISIBLE        'VISIBLE'      :[20],Protect,NoDel;
  GP_SCUD_Areas.SCHEME_COORDS  'SCHEME_COORDS':[20],Protect,NoDel;
  GP_SCUD_Areas.ID_AREAS_TREE  'GP_SCUD_Areas':[20],Protect,NoDel;
  GP_SCUD_Areas.wType       'Тип' :[10], [List
     0 'выход'
    ,1 'вход'
    ],Protect;
  GP_SCUD_Areas.Need_UCHET 'Учет' :[10], [List
     0 'нет'
    ,1 'да'
    ],Protect;

end;//Browse brGroupPers



//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Areas ;
cmSetDefault:
{ ClearBuffer(#GP_SCUD_Areas);
}
cmInsertRecord:
{ Insert Current GP_SCUD_Areas;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Areas;
}
cmDeleteRecord:
{ delete Current GP_SCUD_Areas;
}
end; //GP_SCUD_Areas


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if wIntMode=0
      {
      } //if wIntMode=0
      if cRec>0
      { if getfirst GP_SCUD_Areas where (( cRec == GP_SCUD_Areas.nrec ))=tsok {}
      }
      // блокируем вставку и удаление
      // навсегда блокируем! замечание 7 от 22.11.2017
      DisableCommand(cmInsert);
      DisableCommand(cmEdit);
      DisableCommand(cmAddNewRec);
      DisableCommand(cmInsertRecord);
      DisableCommand(cmSetDefault);
      DisableCommand(cmDelete);
      DisableCommand(cmDeleteRecord);

      ReScanPanel(#GP_SCUD_Areas);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Areas.Nrec;
        }
        CloseInterface(cmDefault)
      }
    }
  end;
end.
