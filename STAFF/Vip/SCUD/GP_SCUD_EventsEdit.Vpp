  {  Result:=pGP_SCUD_Saldo.CH_Holiday[_Day];
  }


//----------------------------------------------------------------------------
Procedure Fill_TSC_Event_Day(var pTSC_Event_Day:TSC_Event_Day);
{
   pTSC_Event_Day.Nrec:=GP_SCUD_Events.Nrec;
 //текущее событие
   pTSC_Event_Day.DT_Ev  :=GP_SCUD_Events.EnterDate;
   pTSC_Event_Day.TM_Ev  :=GP_SCUD_Events.EnterTime;
   pTSC_Event_Day.Type_Ev:=GP_SCUD_Events.wResource;
 //предыдущее событие
   if getlast GP_SCUD_Events_Prev=tsok
   { pTSC_Event_Day.DT_Ev_P  :=GP_SCUD_Events_Prev.EnterDate;
     pTSC_Event_Day.TM_Ev_P  :=GP_SCUD_Events_Prev.EnterTime;
     pTSC_Event_Day.Type_Ev_P:=GP_SCUD_Events_Prev.wResource;
   }
   else
   { pTSC_Event_Day.DT_Ev_P  :=ZeroDate;
     pTSC_Event_Day.TM_Ev_P  :=ZeroTime;
     pTSC_Event_Day.Type_Ev_P:=2;
   }
 //следующее событие
   if getfirst GP_SCUD_Events_Next=tsok
   { pTSC_Event_Day.DT_Ev_N  :=GP_SCUD_Events_Next.EnterDate;
     pTSC_Event_Day.TM_Ev_N  :=GP_SCUD_Events_Next.EnterTime;
     pTSC_Event_Day.Type_Ev_N:=GP_SCUD_Events_Next.wResource;
   }
   else
   { pTSC_Event_Day.DT_Ev_N  :=ZeroDate;
     pTSC_Event_Day.TM_Ev_N  :=ZeroTime;
     pTSC_Event_Day.Type_Ev_N:=2;
   }
  //нарушение
   pTSC_Event_Day.MisConDuct:=GP_SCUD_MisConDuct.Name;
   pTSC_Event_Day.Status:=Gp_Status.Name;
}//Procedure Fill_TSC_Event_Day(var pTSC_Event_Day:TSC_Event_Day);
//----------------------------------------------------------------------------
#doc
     Получить первое событие
#end
Function GetFirstEvents(var pTSC_Event_Day:TSC_Event_Day):boolean;
{ Result:=Getfirst GP_SCUD_Events=tsok;
  if not Result then exit;
  Fill_TSC_Event_Day(pTSC_Event_Day);
} //Function GetFirstEvents(pTSC_Event_Day:TSC_Event_Day):boolean;
//----------------------------------------------------------------------------
#doc
     Получить следующее событие
#end
Function GetNextEvents(var pTSC_Event_Day:TSC_Event_Day):boolean;
{ Result:=GetNext GP_SCUD_Events=tsok;
  if not Result then exit;
   Fill_TSC_Event_Day(pTSC_Event_Day);
} //Function GetNextEvents(pTSC_Event_Day:TSC_Event_Day):boolean;

