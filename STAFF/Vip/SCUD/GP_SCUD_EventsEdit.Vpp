       ClearFieldOption(#DTE,ofProtected );
       ClearFieldOption(#TMB,ofProtected );
       ClearFieldOption(#TME,ofProtected );
     }
  } //procedure SetEditMode(Value: boolean);


  //-----------------------------------------
  // найти Persons.Nrec
  //-----------------------------------------
  Function GetPersons(_pScud_Persons:comp):comp;cacheable;
  { Result:=0;
    set vGP_SCUD_Pers.pGP_SCUD_Pers:=_pScud_Persons;
    vGP_SCUD_Pers._Loop GP_SCUD_Pers
    { Result:=vGP_SCUD_Pers.GP_SCUD_Pers.cPersons;
      break;
    }
  } //Fucntion GetPersons(_pScud_Persons:comp):comp;cacheable;

  //-----------------------------------------
  // найти режим
  //-----------------------------------------
  Function FindRejim(_pScud_Persons:comp;_DT:date ):word;cacheable;
  { Result:=0;

    if _DT=ZeroDate then Exit;
    var isAllok:boolean=false;
    //странно, но как то работало
    //vTabel.pPersons:=_pScud_Persons;
    set vTabel.pPersons:=GetPersons(_pScud_Persons);
    vTabel.wMonth:=Month(_DT);
    vTabel.wYear :=Year(_DT);
    //vTabel.dRas  :=dRas;
    vTabel.dtEvent:=_DT;
#IFDEF GP_SCUD_EventsEdit_DEBUG
    if TimeLog_Status>0 timelog('FindRejim '+string(_pScud_Persons,0,0)+', _DT='+string(_DT)
           +', vTabel.wMonth='+string(vTabel.wMonth)
           +', Year='+string(vTabel.wYear));
#ENDIF
    if vTabel.Getfirst Lschet<>tsok exit;
#IFDEF GP_SCUD_EventsEdit_DEBUG
  //  if TimeLog_Status>0 timelog('FindRejim 01 '+string(vTabel.Lschet.Nrec,0,0));
#ENDIF
    Result:=1;
    if vTabel.Getfirst Lstab<>tsok exit;
    Result:=2;
#IFDEF GP_SCUD_EventsEdit_DEBUG
    if TimeLog_Status>0 timelog('FindRejim Finish Result='+string(Result));
#ENDIF
  } //Function FindRejim(_pScud_Events:comp;_DT:date ):boolean;cacheable;

  //-----------------------------------------
  // найти режим
  //-----------------------------------------
  Function GetRejimDay(_pScud_Persons:comp; _DT:date):word;cacheable;
  var wFindRejim:word;
  { Result:=0;
    if _pScud_Persons=0 then exit;
    var _wNrec:comp=0;
    //_wNrec:=GP_SCUD_PERS.Nrec;
    //if _wNrec<>_pScud_Persons
    //{ if getfirst GP_SCUD_PERS where (( _pScud_Persons == GP_SCUD_PERS.Nrec))=tsok {}
    //}
    wFindRejim:=FindRejim(_pScud_Persons,_DT);
    if wFindRejim=0 exit; // ничего не нашли
    // надо повторить установку
    vTabel.pPersons:=GetPersons(_pScud_Persons);
    vTabel.wMonth:=Month(_DT);
    vTabel.wYear :=Year(_DT);
    //vTabel.dRas  :=dRas;
    vTabel.dtEvent:=_DT;
    vTabel.DtBeg  :=date(1,vTabel.wMonth,vTabel.wYear);
    vTabel.DtEnd  :=date(Last_day(vTabel.DtBeg),vTabel.wMonth,vTabel.wYear);
    // почему то пока месяц не закрыт в табель встает режим из лицевого счета
    //, хотя отображение правильное
    //'Z_WT::ZLSTAB.WORKINGTABLEWINDOW.WORKINGTABLESCREEN.OPERATINGMODESTR'
    //  if((SelectedChange = 0) or (SelectedRangeFirstDay = 0), LSTAB.REJIM, PA_OperatingModeOnDay(SelectedRangeFirstDay))
    //  (fieldname = OperatingMode),
    //    and OperatingMode     == KLREJIM.REJIM
    // SelectedChange <>0
    if vTabel.DtBeg>DatOtch
    { //KLREJIM_ZARSIGNAL.NREJIM
      if vTabel.Getlast ZarSignal=tsok
      { Result:=vTabel.ZARSIGNAL.WORD4;
        exit;
      }
      // нет в корзине  - поищем переход
      vTabel.DtBeg:=DatOtch;
    } //if vTabel.DtBeg>DatOtch

    if vTabel.GetLast Perexod=tsok
    { Result:= vTabel.Perexod.Rejim
    }
    else
    if wFindRejim>1
    { Result:=vTabel.LsTab.Rejim
    }
    else
    { Result:=vTabel.Lschet.Rejim;
    }
#IFDEF GP_SCUD_EventsEdit_DEBUG
    if TimeLog_Status>0 timelog('GetRejimDay '+string(Result));
#ENDIF
  }//Function GetRejimDay(_pScud_Persons:nrec; _DT:date):word;cacheable;

  // function GetEndWorkDayAgile(_pScud_Events:comp): time;
  // {
  //   Result := time(0,0,0,0);
  //   if getfirst tAgileCache where ((_pScud_Events == tAgileCache.cEvent)) <> tsOk
  //   {
  //      CalcDayAgile(_pScud_Events);
  //     if getfirst tAgileCache where ((_pScud_Events == tAgileCache.cEvent)) <> tsOk
  //       exit;
  //   }
  //   Result := tAgileCache.PlanEndWorkDay;
  // }
  //--------------------------
  // получить скорректированное окончание рабочего дня
  //--------------------------
  Function GetEndWorkDay(wDay:word):time;
  { 
    // if IsAgileRejim(GP_KlndrExt.Rejim)
    // {

    // }
    // else
    {
      Result:=vTabel.GP_KlndrExt.EndWorkDay[wDay];
      if Result=ZeroTime
      { if vTabel.GP_KlndrExt.StartWorkDay[wDay]=ZeroTime
        then exit;
        //иначе это 24 часа
        Result:=Time(24,0,0,0);
      }
    }
    if vTabel.RecordExists Contdoc=tsok
    if vTabel.Getfirst fastfirstrow Contdoc=tsok
    { if vTabel.Contdoc.wDop=0
        if vTabel.GetFirst InfPsn1=tsok
        { var _fDiff:double;
          _fDiff:=double(vTabel.KLNDR.DAYCHAS[wDay]) + vTabel.KLNDR.DAYMIN[wDay] / 60
            - vTabel.InfPsn1.Sum1;
          if _fDiff>0
            Result:=Sub_Time(Result,GetTimeFromDouble(_fDiff));
        }
    }
  } //Function EndWorkDay:time;

  Function GetEndShift2(wDay:word):time;
  { Result:=vTabel.GP_KlndrExt.EndShift2[wDay];
    if Result=ZeroTime
    { if vTabel.GP_KlndrExt.StartShift2[wDay]=ZeroTime
      then exit;
      //иначе это 24 часа
      Result:=Time(24,0,0,0);
    }
  } //Function GetEndShift2(wDay:word):time;

  //получить скорректированное окончание первого перерыва
  Function GetEndBreak1(D:word):time;
  { #__UNUSED__(D)
    Result:=vTabel.GP_KlndrExt.EndBreak1[D];
    if Result=ZeroTime then Exit;
    if vTabel.RecordExists Contdoc91=tsok
    vTabel._Loop fullcache Contdoc91
    { if vTabel.RecordExists SalScale=tsok
      vTabel._Loop SalScale
      { if vTabel.SALSCALE.LASTDATE>vTabel.dtEvent then continue;
        var _DT:date=Add_Day(vTabel.SalScale.Lastdate, vTabel.SalScale.FilialNo);
        if //HourAbsenseFunc.GetDateTo( =Date_to
           _DT<vTabel.dtEvent then continue;
        if vTabel.Getfirst UO_91=tsok
        { if vTabel.UO_91.NUM='КР'
          //, Time2StrDef(SalScale.fSum0) (fieldname = fHoursAll)
            Result:=Add_Time(Result,GetTimeFromDouble(vTabel.SalScale.fSum0));
        }
      } //vTabel._Loop SalScale
    } //vTabel._Loop fullcache Contdoc91


  } //Function GetEndBreak1 GetEndWorkDay1(D:word):time;


    //получить скорректированное окончание первого перерыва
  Function GetRestDayOfHoliday(D:word):time;
  { #__UNUSED__(D)
    Result:=ZeroTime;
    if vTabel.RecordExists Contdoc91=tsok
    vTabel._Loop fullcache Contdoc91
    { if vTabel.RecordExists SalScale=tsok
      vTabel._Loop SalScale
      { if vTabel.SALSCALE.LASTDATE>vTabel.dtEvent then continue;
        var _DT:date=Add_Day(vTabel.SalScale.Lastdate, vTabel.SalScale.FilialNo);
        if //HourAbsenseFunc.GetDateTo( = Date_to
           _DT<vTabel.dtEvent then continue;
        if vTabel.Getfirst UO_91=tsok
        { if vTabel.UO_91.NUM='ОТГ'
          //, Time2StrDef(SalScale.fSum0) (fieldname = fHoursAll)
            Result:=GetTimeFromDouble(vTabel.SalScale.fSum0);
        }
      } //vTabel._Loop SalScale
    } //vTabel._Loop fullcache Contdoc91
  } //Function GetEndBreak1 GetEndWorkDay1(D:word):time;


  //----------------------------------------
  // найти начало и окончание  рабочего дня
  //----------------------------------------
  Function GetDayPeriod(_pScud_Persons:comp; _DT:date
       ;var _StartTime:time
       ;var _EndTime:time):word;
  { _StartTime:=ZeroTime;
    _EndTime  :=ZeroTime;
    if _DT=ZeroDate exit;
    vTabel.wRejim:=GetRejimDay(_pScud_Persons, _DT);
    Result:=vTabel.wRejim;
    if Result=0 exit;
    if vTabel.getfirst GP_KlndrExt<>tsok exit;
    var wDay:word;
    wDay:=Day(_DT);
    _StartTime:=vTabel.GP_KlndrExt.StartWorkDay[wDay];
    _EndTime  :=GetEndWorkDay(wDay);//vTabel.GP_KlndrExt.EndWorkDay[wDay];
  } //Function GetDayPeriod(_pScud_Persons:comp; _DT:date

  //------------------------------------------------
  // заявления на отсутствие
  //------------------------------------------------
  Procedure Fill_Tmp_Data(pScud_Pers:comp;_DTB:date;_DTE:date);
  var _TMB,_TME,_Plan_Time:time;
      _wType:word;
      _Dt:date;
      _cNrec:comp;
  { if timelog_status>0
    { timelog('Fill_Tmp_Data->START');
    }

    if true //not isValidall(#tmp_period)
    { _TMB:=_TME:=ZeroTime;
      _Dt:=ZeroDate;
      _wType:=0;
      if iGP_SCUD_StateMentOnAbsent.GetFirstPeriodWithOutMisConDuct(pScud_Pers,_DTB,_DTE
         ,_DT,_TMB,_TME,_Plan_Time, _wType, _cNrec)
      { do {
         insert into tmp_period set
            tmp_period.cGP_SCUD_PERS:=pScud_Pers
          , tmp_period.EventDate    :=_DT
          , tmp_period.EventTmB     :=_TmB //    : time "Время события с"
          , tmp_period.EventTmE     :=_TmE //     : time "Время события по"
          , tmp_period.PlanTime     :=_Plan_Time
          , tmp_period.wType        :=_wType
          , tmp_period.cStatement   :=_cNrec
         ;
        } while iGP_SCUD_StateMentOnAbsent.GetnextPeriodWithOutMisConDuct(_Dt,_TMB,_TME,_Plan_Time, _wType,_cNrec)
      }
      else
      { insert into tmp_period set tmp_period.cGP_SCUD_PERS:=pScud_Pers;
      }
    }
    //--- Добавим приказы на простой - как будто есть личное заявление
    set vTabel.pPersons:=GP_SCUD_Pers.cPersons;
    if vTabel.RecordExists Contdoc91=tsok
    vTabel._Loop fullcache Contdoc91
    { if timelog_status>0
      { timelog('Fill_Tmp_Data->Contdoc91.Nrec='+string(vTabel.Contdoc91.Nrec,0,0));
      }
      if vTabel.RecordExists SalScale=tsok
      vTabel._Loop SalScale
      { //Дата с
        if vTabel.SALSCALE.LASTDATE>_DTE then continue;
        //Дата по
        _DT:=Add_Day(vTabel.SalScale.Lastdate, vTabel.SalScale.FilialNo);
        if timelog_status>0
        { timelog('Fill_Tmp_Data->SALSCALE.LASTDATE='+DateToStr(vTabel.SALSCALE.LASTDATE,'DD/MM/YYYY')
            +', DTO='+DateToStr(_DT,'DD/MM/YYYY'));
        }

        if //HourAbsenseFunc.GetDateTo( = Date_to
           _DT<_DTB then continue;
        if _DT<vTabel.SALSCALE.LASTDATE then continue;
        if vTabel.Getfirst UO_91<>tsok then continue;
        if vTabel.UO_91.NUM<>'РП'  then continue;
          //, Time2StrDef(SalScale.fSum0) (fieldname = fHoursAll)
        if timelog_status>0
        { timelog('Fill_Tmp_Data-> Даты прошли');
        }
        _TMB:=tGetAttrID(coSalScale,vTabel.SalScale.Nrec,pVA_SalScale_TMB );
        _TME:=tGetAttrID(coSalScale,vTabel.SalScale.Nrec,pVA_SalScale_TME );
        if timelog_status>0
        { timelog('Fill_Tmp_Data-> _TMB='+TimeToStr(_TMB,'HH:MM')+' _TME='+TimeToStr(_TME,'HH:MM'));
        }
        if _TME<_TMB then continue;
        while _DT>=vTabel.SALSCALE.LASTDATE
        { if timelog_status>0
          { timelog('Fill_Tmp_Data-> Добавили период');
          }

          insert into tmp_period set
             tmp_period.cGP_SCUD_PERS:=pScud_Pers
           , tmp_period.EventDate    :=_DT
           , tmp_period.EventTmB     :=_TmB //    : time "Время события с"
           , tmp_period.EventTmE     :=_TmE //     : time "Время события по"
           , tmp_period.PlanTime     :=ZeroTime
           , tmp_period.wType        :=1
           , tmp_period.cStatement   :=0
          ;
          _DT:=Sub_Day(_DT,1);
        } //while _DT>vTabel.SALSCALE.LASTDATE
      } //vTabel._Loop SalScale
    } //vTabel._Loop fullcache Contdoc91
    if timelog_status>0
    { timelog('Fill_Tmp_Data->FINISH');
    }

  } //Procedure Fill_Tmp_Data;



  //------------------------------------------------
  // приказы
  //------------------------------------------------
  Procedure Fill_Tmp_Data_Order(pScud_Pers:comp;_DTB:date;_DTE:date);
  var _TMB,_TME:time;
      _wType:word;
      _Dt:date;
      _need_calc:word;
      _wOpl     :word;
      ii:word;
  { if true //not isValidall(#tmp_period_Order)
    { _TMB:=_TME:=ZeroTime;
      _Dt:=ZeroDate;
      _need_calc:=0;
      For(ii:=1;ii<=2 ;ii++)
      { case ii of
        1: _wType:=GP_iSC_OrderOver   ;
        2: _wType:=GP_iSC_OrderHoliday;
        3: _wType:=1091;
        else continue;
        end;
        _wOpl:=0;
        if pGP_SCUD_Order.GetFirstPeriodWithOutMisConDuct(
         pScud_Pers,_DTB,_DTE  //pScud_Pers:comp;//DT_B:date;DT_E:date;
        ,_DT,_TMB,_TME,_need_calc,_wOpl//    var _DT:date; var TM_B:time; var TM_E:time; var _need_calc:word;
        , False,0,_wType//    boVisual:boolean=false;All_Stat:word=0;_wTypeDoc:word=0
        )
        { do {
          //if timelog_Status>2 timelog(' Fill_Tmp_Data_Order ii='+string(ii)+' _DT '+DateToStr(_DT,'DD.MM.YYYY')+', '+string(_wType) );
          insert into tmp_period_Order set
            tmp_period_Order.cGP_SCUD_PERS:=pScud_Pers
          , tmp_period_Order.EventDate    :=_DT
          , tmp_period_Order.EventTmB     :=_TmB //    : time "Время события с"
          , tmp_period_Order.EventTmE     :=_TmE //     : time "Время события по"
          , tmp_period_Order.wType        :=_wType
          , tmp_period_Order.diff         :=GetDoubleFromTime(if(_TmE>_TmB, Sub_Time(_TmE,_TmB),ZeroTime))
          , tmp_period_Order.wOpl         :=_wOpl
          ;

         } while pGP_SCUD_Order.GetnextPeriodWithOutMisConDuct(_Dt,_TMB,_TME,_need_calc,_wOpl )
       } //if iGP_SCUD_Order.GetFirstPeriodWithOutMisConDuct(
     } //For(_wType:=GP_iSC_OrderOver;_wType<=GP_iSC_OrderHoliday ;_wType++)
    } //if not isValidall(#tmp_period)
  } //Procedure Fill_Tmp_Data_Order;

  function GetPlanTimeAgile(_pScud_Events:comp): time;
  {
    Result := time(0,0,0,0);
    if getfirst tAgileCache where ((_pScud_Events == tAgileCache.cEvent)) <> tsOk
    {
       CalcDayAgile(_pScud_Events);
      if getfirst tAgileCache where ((_pScud_Events == tAgileCache.cEvent)) <> tsOk
        exit;
    }
    Result := tAgileCache.PlanTime;
  }

  //----------------------------
  //получить плановое время
  //----------------------------
  Function GetPlanTime(_pScud_Events:comp;_DT:date ):time;cacheable;
  var wDay:word;
      TimePlan:time;
  { //GetRejimDay(GP_SCUD_Events.cGP_SCUD_Pers,GP_SCUD_Events.EnterDate);
    Result:=ZeroTime;
    if _pScud_Events=0
    { Exit;
    }
#IFDEF GP_SCUD_EventsEdit_DEBUG
    if TimeLog_Status>0 timelog('GetPlanTime '+string(_pScud_Events,0,0)+', '+ GP_SCUD_EVENTS.NAME+', _DT='+string(_DT));
#ENDIF
    vTabel.wRejim:=GetRejimDay(GP_SCUD_Events.cGP_SCUD_Pers,_DT);
    TimePlan:=GP_SCUD_Events.EnterTime;
    vTabel.pPersons:=GetPersons(GP_SCUD_Events.cGP_SCUD_Pers);
    vTabel.wMonth:=Month(_DT);
    vTabel.wYear :=Year(_DT);
    if vTabel.wRejim=0 then exit;

#IFDEF GP_SCUD_EventsEdit_DEBUG
    //if TimeLog_Status>0 timelog('GetPlanTime '+GP_SCUD_Pers.Fio+', wRejim='+string(vTabel.wRejim));
#ENDIF
    if vTabel.getfirst GP_KlndrExt<>tsok exit;
    if vTabel.getfirst Klndr<>tsok {};
#IFDEF GP_SCUD_EventsEdit_DEBUG
    //if TimeLog_Status>0 timelog('GetPlanTime GP_KlndrExt.Rejim='+string(vTabel.GP_KlndrExt.Rejim));
#ENDIF
    wDay:=Day(_DT);
    if wDay=0 then exit;
    if IsAgileRejim(GP_SCUD_Events.cGP_SCUD_Pers, GP_SCUD_Events.EnterDate)
    {
      Result := GetPlanTimeAgile(_pScud_Events);
      exit;
    }
    //вход
    if GP_SCUD_Events.wResource=1
    { //обед 2
      if GP_SCUD_Events.EnterTime>=vTabel.GP_KlndrExt.StartBreak2[wDay] and vTabel.GP_KlndrExt.StartBreak2[wDay]<>ZeroTime
      { 
        TimePlan:=vTabel.GP_KlndrExt.EndBreak2[wDay];
      }
      else if GP_SCUD_Events.EnterTime>=vTabel.GP_KlndrExt.StartBreak1[wDay] and vTabel.GP_KlndrExt.StartBreak1[wDay]<>ZeroTime and GP_SCUD_Events.EnterTime<GetEndWorkDay(wDay)//vTabel.GP_KlndrExt.EndWorkDay[wDay]
      { 
        TimePlan:=GetEndBreak1(wDay);//vTabel.GP_KlndrExt.EndBreak1[wDay];
      }
      else if GP_SCUD_Events.EnterTime>GetEndWorkDay(wDay)//vTabel.GP_KlndrExt.EndWorkDay[wDay]
      { 
        if vTabel.GP_KlndrExt.StartShift2[wDay]<>ZeroTime
        { 
          TimePlan:=vTabel.StartShift2[wDay];
        }
        else
        { 
          TimePlan:=GetEndWorkDay(wDay);//vTabel.GP_KlndrExt.EndWorkDay[wDay]);
        }
      }
      else
      { 
        TimePlan:=vTabel.GP_KlndrExt.StartWorkDay[wDay];
      }
    }//if GP_SCUD_Events.wResource=1
    //выход
    else
    { TimePlan:=GetEndWorkDay(wDay);// vTabel.GP_KlndrExt.EndWorkDay[wDay];

      if GP_SCUD_Events.EnterTime>vTabel.GP_KlndrExt.StartShift2[wDay]
      and vTabel.GP_KlndrExt.StartShift2[wDay]<>ZeroTime
        TimePlan:=GetEndShift2(wDay)//vTabel.GP_KlndrExt.EndShift2[wDay]
      else
      //ушел в обед 2
      if  GP_SCUD_Events.EnterTime<vTabel.GP_KlndrExt.EndBreak2[wDay]
      and GP_SCUD_Events.EnterTime>GetEndBreak1(wDay)//vTabel.GP_KlndrExt.EndBreak1[wDay]
        TimePlan:=vTabel.GP_KlndrExt.StartBreak2[wDay]
      else
      //ушел в обед 1
      if GP_SCUD_Events.EnterTime<GetEndBreak1(wDay)//vTabel.GP_KlndrExt.EndBreak1[wDay]
        TimePlan:=vTabel.GP_KlndrExt.StartBreak1[wDay];
    } //else if GP_SCUD_Events.wResource=1
    //**********************************************888
    //Здесь также добавить заявления
    //**********************************************888

    Result:=TimePlan;

  } //Function GetPlanTime(_pScud_Events:nrec; ):time;cacheable;

  //------------------------------
  // Определить тип нарушения
  // _tp - 1 из расчета сальдо
  //------------------------------
  Function GetMisConDuct(_pScud_Events:comp;_Plan_time:time;_DT:date;_tp:word=0 ):word;cacheable;
  var wDay:word;
      _Time_Diff:time;
      _wKateg:word;
  { Result:=0;
    if _pScud_Events=0 then exit;
    if IsAgileRejim(GP_SCUD_Events.cGP_SCUD_Pers, GP_SCUD_Events.EnterDate)
    {
      if getfirst tAgileCache where ((_pScud_Events == tAgileCache.cEvent)) <> tsOk
      {
        CalcDayAgile(_pScud_Events);
        if getfirst tAgileCache where ((_pScud_Events == tAgileCache.cEvent)) <> tsOk
          exit;
      }
      Result := tAgileCache.wMisConduct;
      exit;
    }

    //if _tp=1 Glob_DiffTime:=ZeroTime;
    _wKateg:=GetKategType(GP_SCUD_Pers.cGp_Scud_Kateg);
    Calc_Date:=_DT;
    if getlast GP_SCUD_Pers_Hist=tsok
      if GP_SCUD_Pers_Hist.cGp_Scud_Kateg>0
        _wKateg:=GetKategType(GP_SCUD_Pers_Hist.cGp_Scud_Kateg);
    if _wKateg=0 _wKateg:=5;
#IFDEF GP_SCUD_EventsEdit_DEBUG_MIS
    if timelog_Status>0
      timelog('GetMisConDuct _Plan_time='+TimeToStr(_Plan_time,'HH:MM')
                 +', _DT='+DateToStr(_DT,'DD/MM/YYYY')
                 +', _tp='+string(_tp)
                 +', wKateg='+string(_wKateg)
                 +', тип='+string(GP_SCUD_Events.wResource)
                 +', время='+TimeToStr(GP_SCUD_Events.EnterTime,'HH:MM')
                 );
#ENDIF
    if _wKateg<>3 and _wKateg<>5
    {
#IFDEF GP_SCUD_EventsEdit_DEBUG_MIS
      if timelog_Status>0
       timelog('GetMisConDuct категория '+string(_wKateg)+' не обрабатывается');
#ENDIF
      exit;
    }
    //GetPlanTime(GP_SCUD_Events.Nrec,GP_SCUD_Events.EnterDate);
    // Здесь также проверим исключения и заявления на отсутствие
    wDay:=day(_DT);
    if wDay=0 Exit;
    if vTabel.isvalidAll(vTabel.tnKlndr)
    { if (double(vTabel.KLNDR.DAYCHAS[wDay]) + vTabel.KLNDR.DAYMIN[wDay] / 60)=0
      {
#IFDEF GP_SCUD_EventsEdit_DEBUG_MIS
        if timelog_Status>0
         timelog('GetMisConDuct выходной ');
#ENDIF
        exit; // не может быть нарушения в выходной день!
      }
    }
    if not vTabel.isvalidAll(vTabel.tnGP_KlndrExt)
    {
#IFDEF GP_SCUD_EventsEdit_DEBUG_MIS
      if timelog_Status>0
        timelog('GetMisConDuct не нашли расширения графика');
#ENDIF
      exit;
    }
    //if vTabel.getfirst GP_KlndrExt<>tsok exit;
    //2018.11.14 если нет периодов работы, то нельзя понять - это нарушение или нет
    if vTabel.GP_KlndrExt.StartWorkDay[wDay]=ZeroTime
      if vTabel.GP_KlndrExt.EndWorkDay[wDay]=ZeroTime
        if vTabel.GP_KlndrExt.StartShift2[wDay]=ZeroTime
          if vTabel.GP_KlndrExt.EndShift2[wDay]=ZeroTime
            exit;

    if _Plan_Time=ZeroTime
    { Result:=5;// 'Отсутствие в середине дня'
      if getfirst GP_SCUD_Events_next=tsok
      { if Sub_time(GP_SCUD_Events_next.EnterTime,GP_SCUD_Events.EnterTime)<time(0,15,0,0)
        // Суммарное отсутствие в течение дня более 15 минут (исключая время пунктов 1-4)
         if _Tp=0  Result:=0 // но здесь пока так.
         //else   Glob_DiffTime := Sub_time(GP_SCUD_Events_next.EnterTime,GP_SCUD_Events.EnterTime);
      }
    }
    else
    if GP_SCUD_Events.wResource=1 //Вход
    {
#IFDEF GP_SCUD_EventsEdit_DEBUG_MIS
      if timelog_Status>0
        timelog('GetMisConDuct вход');
#ENDIF
      var _start_time:time;
      _start_time:=_Plan_time;
      if tNPOEM_OWN_SCUD_DELAY_ALLOW<>ZeroTime
      { _start_time:=Add_time(_start_time,tNPOEM_OWN_SCUD_DELAY_ALLOW);
        if timelog_Status>0
          timelog('_Plan_time 2 ='+TimeToStr(_start_time,'HH:MM:SS:SSS'));
      }
      if _start_time<GP_SCUD_Events.EnterTime
      { var _Prev_Event:time=ZeroTime;
        if getlast GP_SCUD_Events_Prev=tsok
        { if GP_SCUD_Events_Prev.EnterDate=GP_SCUD_Events.EnterDate
            _Prev_Event:=GP_SCUD_Events_Prev.EnterTime;
        }
        if _Plan_time=vTabel.GP_KlndrExt.StartWorkDay[wDay]
        //2018.05.22 если еще не выходил за день, то это опоздание
        or (_Prev_Event=ZeroTime
             //
             and (  GP_SCUD_Events.EnterTime>vTabel.GP_KlndrExt.StartWorkDay[wDay]
               and  GP_SCUD_Events.EnterTime<GetEndWorkDay(wDay)
                 )
           )
        {
#IFDEF GP_SCUD_EventsEdit_DEBUG_MIS
          if timelog_Status>0   timelog('_Plan_time='+string(vTabel.GP_KlndrExt.StartWorkDay[wDay])+' день=' +string(wDay) );
#ENDIF
          if _Prev_Event<>ZeroTime
          and (_Prev_Event>=vTabel.GP_KlndrExt.StartWorkDay[wDay]
          or (_wKateg<>5 and
            _Prev_Event>=Sub_time(vTabel.GP_KlndrExt.StartWorkDay[wDay],time(2,0,0,0))
            )
          )
          { if Sub_Time(GP_SCUD_Events.EnterTime,_Prev_Event)<Time(0,15,0,0)
            and _tp=0 // если из сальдо , то нужно посчитать
            { Result:=0
            }
            else
            { Result:=5
            }
          } //if _Prev_Event<>ZeroTime
          else
          { if True //GP_SCUD_Events.EnterTime>=_Start_time
            { Result:=1;//    ,1 'Опоздание на работу'

              _Time_Diff:=iGP_SCUD_ExClusionPeriod.GetPeriodWithOutExClusion(
              _DT,_Plan_Time,GP_SCUD_Events.EnterTime,GP_SCUD_Events.cGP_SCUD_PERS);

              /*
              var _TME:time=GetEndBreak1(wDay) ;

              if  GP_SCUD_Events.EnterTime>=_TME
              and vTabel.GP_KlndrExt.StartBreak1[wDay]<>ZeroTime
              and GP_SCUD_Events.EnterTime<GetEndWorkDay(wDay)
              { _Time_Diff:=Add_Time(_Time_Diff,Sub_Time(vTabel.GP_KlndrExt.StartBreak1[wDay],vTabel.GP_KlndrExt.StartWorkDay[wDay]));
              }
              */
#IFDEF GP_SCUD_EventsEdit_DEBUG_MIS
             if timelog_Status>0
               timelog(' Result=1, период без искл.'+TimeToStr(_Time_Diff,'HH:MM'));
#ENDIF
              //если вызвали из расчета сальдо, то поставим 11 , чтобы потом приравнять начало работы
              if _Time_Diff=ZeroTime Result:=if(_Tp=0,0,11);
              //else Glob_DiffTime := _Time_Diff;
            } //if GP_SCUD_Events.EnterTime<Add_time(vTabel.GP_KlndrExt.StartWorkDay[wDay],tNPOEM_OWN_SCUD_DELAY_ALLOW)
          } //else if _Prev_Event<>ZeroTime
        }  //if _Plan_time=vTabel.GP_KlndrExt.StartWorkDay[wDay]
        else
        if _Plan_time=vTabel.GP_KlndrExt.EndBreak2[wDay]
        or _Plan_time=GetEndBreak1(wDay)//vTabel.GP_KlndrExt.EndBreak1[wDay]
        { //var _Next_Event:time=ZeroTime;
          //if getfirst GP_SCUD_Events_next=tsok
          //   _Next_Event:=GP_SCUD_Events_next.EnterTime;
          Result:=3; // 'Поздний приход с обеда'
          //Glob_DiffTime := iGP_SCUD_ExClusionPeriod.GetPeriodWithOutExClusion(
          //  _DT,_Plan_Time,GP_SCUD_Events.EnterTime,GP_SCUD_Events.cGP_SCUD_PERS);
          if _Prev_Event<>ZeroTime
          and _Prev_Event>=Add_time(_Plan_time,tNPOEM_OWN_SCUD_DELAY_ALLOW)
          { if Sub_Time(GP_SCUD_Events.EnterTime,_Prev_Event)<=Time(0,15,0,0)
            and _Tp=0
            { Result:=0
            }
            else
            { Result:=5
            }
          }
        } //if _Plan_time=vTabel.GP_KlndrExt.EndBreak2[wDay]
      } //if _Plan_time<GP_SCUD_Events.EnterTime
    } //if GP_SCUD_Events.wResource=1
    else //выход
    { var _Prev_Event:time=ZeroTime;
      if getlast GP_SCUD_Events_Prev=tsok
      { if GP_SCUD_Events_Prev.EnterDate=GP_SCUD_Events.EnterDate
          _Prev_Event:=GP_SCUD_Events_Prev.EnterTime;
      }
      if GP_SCUD_Events.EnterTime<_Plan_time
      { var _Next_Event:time=ZeroTime;
        if getfirst GP_SCUD_Events_next=tsok
          if GP_SCUD_Events_next.EnterDate=GP_SCUD_Events.EnterDate
            _Next_Event:=GP_SCUD_Events_next.EnterTime;
        if (_Plan_time=vTabel.GP_KlndrExt.StartBreak1[wDay]
            and _Prev_Event=Zerotime //он еще со вчера не вышел.
           )
        or ( _Plan_time=vTabel.GP_KlndrExt.StartBreak2[wDay]
           )
        and GP_SCUD_Events.EnterTime<_Plan_time
        { Result:=2; // 'Ранний уход на обед'
          if _Next_Event<>ZeroTime
            and (( _Next_Event<=vTabel.GP_KlndrExt.StartBreak2[wDay] and _Plan_time=vTabel.GP_KlndrExt.StartBreak2[wDay])
              or ( _Next_Event<=vTabel.GP_KlndrExt.StartBreak1[wDay] and _Plan_time=vTabel.GP_KlndrExt.StartBreak1[wDay])
             )
          { if Sub_Time(_Next_Event, GP_SCUD_Events.EnterTime)<Time(0,15,0,0)
            or (_Plan_time=vTabel.GP_KlndrExt.StartBreak1[wDay]
                and _Next_Event<vTabel.GP_KlndrExt.StartWorkDay[wDay])
            or (_Plan_time=vTabel.GP_KlndrExt.StartBreak2[wDay]
                and _Next_Event<vTabel.GP_KlndrExt.StartShift2[wDay])
            and _Tp=0
            { Result:=0
            }
            else
            { Result:=5
            }
          }
        }
        else
        if _Plan_time=GetEndWorkDay(wDay) //vTabel.GP_KlndrExt.EndWorkDay[wDay]
        { //проверяем только если ушел в течении рабочего дня. по письму от 28.05.2018
          if GP_SCUD_Events.EnterTime>vTabel.GP_KlndrExt.StartWorkDay[wDay]
          {
            //Ушел с работы ранее чем за 1 минуту до окончания работы по графику.
            //Если ушел с работы менее чем за 15 минут до конца рабочего дня,
            //вернулся менее чем через 1 час после окончания работы по графику и продолжил работать, то не считается нарушением.

            Result:=4;// 'Ранний уход с работы'
            //27/10/2017
            IF Sub_time(_Plan_time,GP_SCUD_Events.EnterTime)<=Time(0,15,0,0)
            { if _Next_Event<>ZeroTime //getfirst GP_SCUD_Events_next=tsok
              {
                if _Next_Event<_Plan_time
                { //20180219 Result:=0;
                  Result:=if(_Tp=0,0,5); // Вернулся обратно - нарушение середины дня
                }
                else
                { if Sub_Time(_Next_Event,_Plan_time)<=Time(1,0,0,0)
                  //20180219 Result:=0;
                    Result:=if(_Tp=0,0,5);
                }
              }
            } //IF Sub_time(_Plan_time,GP_SCUD_Events.EnterTime)<Time(0,15,0,0)
            else
            { if _Next_Event<>ZeroTime
              { // полностью все отсутствия здесь не поймать, проверим просто на 15 минут
                if Sub_Time(_Next_Event,GP_SCUD_Events.EnterTime)<Time(0,15,0,0)
                and _Tp=0
                { Result:=0
                }
                else
                if _Next_Event<=Plan_time
                { Result:=5
                }
              }
            } //IF Sub_time(_Plan_time,GP_SCUD_Events.EnterTime)<Time(0,15,0,0)
            //if Result=4 Glob_DiffTime := Sub_time(_Plan_time,GP_SCUD_Events.EnterTime);
          } //if GP_SCUD_Events.EnterTime>vTabel.GP_KlndrExt.StartWorkDay[wDay]
        }  //if _Plan_time=vTabel.GP_KlndrExt.EndWorkDay[wDay]
      }   //if GP_SCUD_Events.EnterTime<_Plan_time
    } //else if GP_SCUD_Events.wResource=1

    //3)        Свободный проход в рабочее время по графику (служба безопасности, электрики).
    // Не попадают в отчет по нарушениям во время работы, но опоздание и ранний уход регистрируются
    if _wKateg=3
    { if _tp=1 // из расчета за месяц - обнулим там
      { //if Result<>1 and Result<>4 and Result<>5 Result:=0;
      }
      else
      { if Result<>1 and Result<>4 Result:=0;
      }

    }
  }//Function GetMisConDuct(_pScud_Events:nrec;_Plan_time):word;Forward;


  //-------------------------------------------------
  // проверить, что день не рабочий
  //-------------------------------------------------
  Function CheckDaysNotWorkCH(_s:string):boolean;cacheable;
  { Result:=False;
    if _s='Б'  // Больничный, кроме "Т"
    //or _s='В'  // Выходной это не исключение!!!!
    or _s='Г'  // Гособязанности
    or _s='ГО' // Гособязанности без оплаты
    or _s='Д'  // Доноры
    or _s='ДБ' // Ежегодный дополнительный отпуск без сох-ния з/п
    or _s='ДО' // Отпуск за свой счет
    or _s='К'  // Командировка
    or _s='КД' // Доп. отпуск по КД
    or _s='КК' // Комерческая командировка
    or _s='КП' // Командировка из прибыли
    or _s='НБ' // Отстранение от работы без з/п
    or _s='НВ' // Доп. выходные без з/п
    or _s='НН' // Неявки по невыясненным причинам
    or _s='НР' // Нарушение режима
    or _s='ОВ' // Дополнительные выходные дни (оплачиваемые)
    or _s='ОД' // Ежегодный дополнительный оплачиваемый отпуск
    or _s='ОЖ' // Отпуск по уходу за ребенком до 3-х лет
    or _s='ОТ' // Ежегодный основной оплачиваемый отпуск
    or _s='ОТГ'// ОТГУЛ
    or _s='ПВ' // Вынужденный прогул
    or _s='ПК' // Повышение квалификации с отрывом от работы
    or _s='ПМ' // Пов-ие кваф-ии с отрывом от работы в другой мес-ти
    or _s='Р'  // Отпуск по беременности и родам
    or _s='РП' // Время Простоя по вине работодателя
    or _s='Т'  // Больничный без оплаты
    or _s='У'  // Доп. отпуск в связи с обучением с сохран с/з
    or _s='УВ' // Сокр. продол-ть раб.врем. для без отрыв от произв
    or _s='УД' // Доп. отпуск, в связи с обучением без сох
    { Result:=True;
    }
  } //Function CheckDaysNotWorkCH(_s:string):boolean;cacheable;

  //-------------------------------------------------
  // проверить, что день не рабочий
  //-------------------------------------------------
  Function CheckDaysNotWork(ii:word):boolean;
  {   Result:=CheckDaysNotWorkCH(pGP_SCUD_Saldo.Days[ii]);

  } //Function CheckDaysNotWork(ii:word):boolean;

  //-------------------------------------------------
  // инициализировать зарплату
  //-------------------------------------------------
  Procedure Init_Zar;
  {  if boLoadZar exit;
     boLoadZar:=true;
     if not IntInit exit;
     if not InitWorkingTable
     {  ExitProc;
        Exit;
     }
     Timelog('Init_Zar');
  } //Procedure Init_Zar;


  //----------------------------------------------------------------------------
  #doc
    Заполнить информацию о графике работы
  #end
  function Fill_Graff_info(_cScud_Pers:comp //GP_SCUD_PERS.Nrec
    ;_wYearRas,_wMonthRas:word //Год , месяц расчета
    ;_wTypeFill:word=1//из CalcAll
    ;_DayCalc:word=0// День заполнения
     ) :boolean;
  var ii:word;
      iibeg:word;
      iiend:word;
      _DATUV :date;
      dayUV:word;
  {
    if _DayCalc>0 and _DayCalc<32
    { iibeg:=_DayCalc;
      iiend:=_DayCalc;
    }
    else
    { iibeg:=1;
      iiend:=31;
    }
    dayUV:=31;
    _DATUV:=ZeroDate;
    ClearAdvRecord(pGRAFF_WorkPeriod);
    if _cScud_Pers<>GP_SCUD_Pers.cPersons
    { if getfirst GP_SCUD_Pers where (( _cScud_Pers == GP_SCUD_Pers.Nrec ))<>tsok then exit;
    }
    if GP_SCUD_Pers.cPersons=0 then exit;
    Timelog(' Fill_Graff_info:_cScud_Pers='+string(_cScud_Pers,0,0)//GP_SCUD_PERS.Nrec
           +', _wYearRas='+string(_wYearRas)+', _wMonthRas='+string(_wMonthRas));
    set vTabel.pPersons:=GP_SCUD_Pers.cPersons;
    set vTabel.wMonth:=_wMonthRas;
    set vTabel.wYear :=_wYearRas;
    //-----------------------------
    // Здесь нужно уйти, иначе хватается чужой табель
    //-----------------------------
    if vTabel.GetFirst Lschet<>tsok
    { timelog(' Нет лиц.счета!! '+GP_SCUD_Pers.Fio );
      exit;
    }
    var boTable:boolean=false;
    boTable:=vTabel.GetFirst LsTab=tsok;
    var boTableK:boolean=false;
    _DATUV:=vTabel.Lschet.DatUv;
    if _DATUV<>ZeroDate
    { if month(_DATUV) =_wMonthRas and year(_DATUV)=_wYearRas
         dayUV:=Day(_DATUV)
      else
      if _DATUV<date(1,_wMonthRas,_wYearRas)
        dayUV:=0;
    }
    if boTable
    { boTableK:=vTabel.Getlast GP_TIMETABLE=tsok;

    }
    if not boTable
    { if _DATUV=ZeroDate or _DATUV>=date(1,_wMonthRas,_wYearRas)
      { Init_Zar;
        //Возникло необработанное исключение  GP_STAFF::GP_ObjFormT12
        Timelog('Нет табеля! ');
        //Loadworkingtable(vTabel.Lschet.nrec,_wMonthRas,_wYearRas);
        //vTabel.ClearBuffer(vTabel.tnLsTab);
        //vTabel.tnLsTab.YearN _wYearRas
        var _WTR:integer=ReFormWorkingTable(vTabel.Lschet.nrec,_wMonthRas,_wYearRas);
        Timelog(' ReFormWorkingTable='+String(_WTR));
        //-------------------------------------------------------------------------
        //Проводим переформирование табеля
        ReReadRecord(vTabel.tnLsTab);
        boTable:=vTabel.getfirst LsTab=tsok;
        if boTable
        { Timelog('Создали LsTab.nrec =  '+string(vTabel.LsTab.nrec))
        }
      }
      else
      { Timelog('Уволен - табель не создаем ');
      }
    }
    else
    { Timelog(' LsTab.nrec =  '+string(vTabel.LsTab.nrec));
    }
    timelog(' dayUV='+string(dayUV));
    Result:=boTable;
    //------------------------------------
    For(ii:=iibeg;ii<=iiend;ii++)
    { Calc_Date:=date(ii,_wMonthRas,_wYearRas);
      if _wTypeFill=1
      {
        if boTable
        { if false // boTableK - теперь они называются исходные
          { if vTabel.GP_TimeTable.DMark[ii]='Я'
             pGP_SCUD_Saldo.Days[ii]:=GetTimeStrFromDouble(vTabel.GP_TimeTable.DHours[ii]);
            else
             pGP_SCUD_Saldo.Days[ii]:=vTabel.GP_TimeTable.DMark[ii];
          }
          else
          { if ii<=dayUV
              pGP_SCUD_Saldo.Days[ii]:=vTabel.LsTab.Days[ii]
            else
              pGP_SCUD_Saldo.Days[ii]:='';
          }
        } //if boTable
        else
        { pGP_SCUD_Saldo.Days[ii]:=''
        } //else if boTable
      } //if _wTypeFill=1
      if ii<=dayUV
        set vTabel.wRejim:=GetRejimDay(_cScud_Pers,Calc_Date)
      else
        set vTabel.wRejim:=0;
      vTabel.wMonth:=Month(Calc_Date);
      vTabel.wYear :=Year(Calc_Date);

#IFDEF GP_SCUD_EventsEdit_DEBUG
      if TimeLog_Status>0 timelog('Fill_Graff_info Fill_Graff_info='+string(ii)+', wRejim='+string(vTabel.wRejim)+',boTable='+string(boTable));
#ENDIF
      if _wTypeFill=1
      {
        pGP_SCUD_Saldo.Rejim_Day[ii]:=vTabel.wRejim;

        if vTabel.getfirst klndr=tsok
        and ii<=dayUV
        { pGP_SCUD_Saldo.CH_GrafCh[ii]:= double(vTabel.KLNDR.DAYCHAS[ii]) + vTabel.KLNDR.DAYMIN[ii] / 60;
#IFDEF GP_SCUD_EventsEdit_DEBUG
          if TimeLog_Status>0 timelog('Fill_Graff_info Calc_GrafCh[ii]='+string(pGP_SCUD_Saldo.CH_GrafCh[ii]));
#ENDIF
        }
#IFDEF GP_SCUD_EventsEdit_DEBUG
        else
        { if TimeLog_Status>0 timelog('Fill_Graff_info не нашли klndr');
          pGP_SCUD_Saldo.CH_GrafCh[ii]:=0;
        }
#ENDIF
      }
      //------------
      if ii<=dayUV
      and vTabel.getfirst GP_KlndrExt=tsok
      {
#IFDEF GP_SCUD_EventsEdit_DEBUG
      if TimeLog_Status>0 timelog('Fill_Graff_info GP_KlndrExt.StartWorkDay[ii]='+string(vTabel.GP_KlndrExt.StartWorkDay[ii]));
#ENDIF
        pGRAFF_WorkPeriod.StartWorkDay [ii] := vTabel.GP_KlndrExt.StartWorkDay[ii]; //"Начало рабочего дня",
        pGRAFF_WorkPeriod.EndWorkDay   [ii] := GetEndWorkDay(ii);// vTabel.GP_KlndrExt.EndWorkDay  [ii]; //"Окончание рабочего дня",
        pGRAFF_WorkPeriod.StartWorkDayR[ii] := vTabel.GP_KlndrExt.StartWorkDay[ii]; //"Начало рабочего дня",
        pGRAFF_WorkPeriod.EndWorkDayR  [ii] := GetEndWorkDay(ii);//vTabel.GP_KlndrExt.EndWorkDay  [ii]; //"Окончание рабочего дня",
        pGRAFF_WorkPeriod.StartShift2  [ii] := vTabel.GP_KlndrExt.StartShift2 [ii]; // "Начало смены 2",
        pGRAFF_WorkPeriod.EndShift2    [ii] := GetEndShift2(ii);//vTabel.GP_KlndrExt.EndShift2   [ii]; // "Окончание смены 2",
        pGRAFF_WorkPeriod.StartBreak1  [ii] := vTabel.GP_KlndrExt.StartBreak1 [ii]; // "Начало перерыва 1",
        pGRAFF_WorkPeriod.EndBreak1    [ii] := GetEndBreak1(ii);//vTabel.GP_KlndrExt.EndBreak1   [ii]; // "Окончание перерыва 1",
        pGRAFF_WorkPeriod.StartBreak2  [ii] := vTabel.GP_KlndrExt.StartBreak2 [ii]; // "Начало перерыва 2",
        pGRAFF_WorkPeriod.EndBreak2    [ii] := vTabel.GP_KlndrExt.EndBreak2   [ii]; // "Окончание перерыва 2",
        pGRAFF_WorkPeriod.RestDayOfHoliday[ii]:=GetRestDayOfHoliday(ii); ////Отгул за работу в выходной день по 91 приказу (уточнение с уо= "ОТГ")
      }
      else
      {
        pGRAFF_WorkPeriod.StartWorkDay [ii] := ZeroTime;
        pGRAFF_WorkPeriod.EndWorkDay   [ii] := ZeroTime;
        pGRAFF_WorkPeriod.StartWorkDayR[ii] := ZeroTime;
        pGRAFF_WorkPeriod.EndWorkDayR  [ii] := ZeroTime;
        pGRAFF_WorkPeriod.StartShift2  [ii] := ZeroTime;
        pGRAFF_WorkPeriod.EndShift2    [ii] := ZeroTime;
        pGRAFF_WorkPeriod.StartBreak1  [ii] := ZeroTime;
        pGRAFF_WorkPeriod.EndBreak1    [ii] := ZeroTime;
        pGRAFF_WorkPeriod.StartBreak2  [ii] := ZeroTime;
        pGRAFF_WorkPeriod.EndBreak2    [ii] := ZeroTime;
        pGRAFF_WorkPeriod.RestDayOfHoliday[ii]:=ZeroTime;
      }
      //?????
      //открытый вопрос - нужно ли уменьшать время по графику, если есть 92 и 91 приказ.
      if pGRAFF_WorkPeriod.EndWorkDay[ii]<vTabel.GP_KlndrExt.EndWorkDay[ii]
      { pGP_SCUD_Saldo.CH_GrafCh[ii]:=pGP_SCUD_Saldo.CH_GrafCh[ii]
         -GetDoubleFromTime(Sub_time(vTabel.GP_KlndrExt.EndWorkDay[ii],pGRAFF_WorkPeriod.EndWorkDay[ii]))
      }
      if pGRAFF_WorkPeriod.EndBreak1[ii]>vTabel.GP_KlndrExt.EndBreak1[ii]
      { pGP_SCUD_Saldo.CH_GrafCh[ii]:=pGP_SCUD_Saldo.CH_GrafCh[ii]
         -GetDoubleFromTime(Sub_time(pGRAFF_WorkPeriod.EndBreak1[ii],vTabel.GP_KlndrExt.EndBreak1[ii]))
      }

      pGP_SCUD_Saldo.CH_Graf_All  := pGP_SCUD_Saldo.CH_Graf_ALL + pGP_SCUD_Saldo.CH_GrafCh[ii];

      if _wTypeFill=1
      if ii<=dayUV
      {
        //-------------------------------
        //есть первая смена
        if pGRAFF_WorkPeriod.StartWorkDay[ii] < pGRAFF_WorkPeriod.EndWorkDay[ii]
        { if pGRAFF_WorkPeriod.StartWorkDay[ii]<pGRAFF_WorkPeriod.StartBreak1[ii]
          { insert tmp_period_work  set
              tmp_period_work.cGP_SCUD_PERS:=pGP_SCUD_Pers
            , tmp_period_work.EventDate    :=Calc_Date
            , tmp_period_work.EventTmB     :=pGRAFF_WorkPeriod.StartWorkDay[ii] //    : time "Время события с"
            , tmp_period_work.EventTmE     :=pGRAFF_WorkPeriod.StartBreak1[ii] //     : time "Время события по"
            , tmp_period_work.wType        :=101
            ;
            //проверим, что второй перерыв в первой смене
            if  pGRAFF_WorkPeriod.EndBreak1[ii]<pGRAFF_WorkPeriod.StartBreak2[ii]
            and pGRAFF_WorkPeriod.StartBreak2[ii]<pGRAFF_WorkPeriod.EndWorkDay[ii]
            and pGRAFF_WorkPeriod.EndBreak2[ii]>ZeroTime
            { insert tmp_period_work  set
               tmp_period_work.cGP_SCUD_PERS:=pGP_SCUD_Pers
             , tmp_period_work.EventDate    :=Calc_Date
             , tmp_period_work.EventTmB     :=pGRAFF_WorkPeriod.EndBreak1[ii] //    : time "Время события с"
             , tmp_period_work.EventTmE     :=pGRAFF_WorkPeriod.StartBreak2[ii] //     : time "Время события по"
             , tmp_period_work.wType        :=104
             ;

              insert tmp_period_work  set
               tmp_period_work.cGP_SCUD_PERS:=pGP_SCUD_Pers
             , tmp_period_work.EventDate    :=Calc_Date
             , tmp_period_work.EventTmB     :=pGRAFF_WorkPeriod.EndBreak2[ii] //    : time "Время события с"
             , tmp_period_work.EventTmE     :=pGRAFF_WorkPeriod.EndWorkDay[ii] //     : time "Время события по"
             , tmp_period_work.wType        :=105
             ;

            }
            // есть только один перерыв
            else
            { insert tmp_period_work  set
               tmp_period_work.cGP_SCUD_PERS:=pGP_SCUD_Pers
             , tmp_period_work.EventDate    :=Calc_Date
             , tmp_period_work.EventTmB     :=pGRAFF_WorkPeriod.EndBreak1[ii] //    : time "Время события с"
             , tmp_period_work.EventTmE     :=pGRAFF_WorkPeriod.EndWorkDay[ii] //     : time "Время события по"
             , tmp_period_work.wType        :=105
             ;
            }
          } //if pGRAFF_WorkPeriod.StartWorkDay[ii]<pGRAFF_WorkPeriod.StartBreak1[ii]
          // нет перерывов
          else
          { insert tmp_period_work  set
              tmp_period_work.cGP_SCUD_PERS:=pGP_SCUD_Pers
            , tmp_period_work.EventDate    :=Calc_Date
            , tmp_period_work.EventTmB     :=pGRAFF_WorkPeriod.StartWorkDay[ii] //    : time "Время события с"
            , tmp_period_work.EventTmE     :=pGRAFF_WorkPeriod.EndWorkDay[ii] //     : time "Время события по"
            , tmp_period_work.wType        :=103
            ;

          }
        } //if pGRAFF_WorkPeriod.StartWorkDay[ii] < pGRAFF_WorkPeriod.EndWorkDay[ii]

        //-----------------------------
        //2 смена - второй перерыв может быть к ней
        if pGRAFF_WorkPeriod.StartShift2[ii] < pGRAFF_WorkPeriod.EndShift2[ii]
        { if  pGRAFF_WorkPeriod.StartShift2[ii]<pGRAFF_WorkPeriod.StartBreak2[ii]
          and pGRAFF_WorkPeriod.StartBreak2[ii]<pGRAFF_WorkPeriod.EndShift2[ii]
          and pGRAFF_WorkPeriod.EndBreak2[ii]>pGRAFF_WorkPeriod.StartBreak2[ii]
          { insert tmp_period_work  set
              tmp_period_work.cGP_SCUD_PERS:=pGP_SCUD_Pers
            , tmp_period_work.EventDate    :=Calc_Date
            , tmp_period_work.EventTmB     :=pGRAFF_WorkPeriod.StartShift2[ii] //    : time "Время события с"
            , tmp_period_work.EventTmE     :=pGRAFF_WorkPeriod.StartBreak2[ii] //     : time "Время события по"
            , tmp_period_work.wType        :=106
            ;
            insert tmp_period_work  set
              tmp_period_work.cGP_SCUD_PERS:=pGP_SCUD_Pers
            , tmp_period_work.EventDate    :=Calc_Date
            , tmp_period_work.EventTmB     :=pGRAFF_WorkPeriod.EndBreak2[ii] //    : time "Время события с"
            , tmp_period_work.EventTmE     :=pGRAFF_WorkPeriod.EndShift2[ii] //     : time "Время события по"
            , tmp_period_work.wType        :=107
            ;
          }
          // нет перерывов
          else
          { insert tmp_period_work  set
              tmp_period_work.cGP_SCUD_PERS:=pGP_SCUD_Pers
            , tmp_period_work.EventDate    :=Calc_Date
            , tmp_period_work.EventTmB     :=pGRAFF_WorkPeriod.StartShift2[ii] //    : time "Время события с"
            , tmp_period_work.EventTmE     :=pGRAFF_WorkPeriod.EndShift2[ii] //     : time "Время события по"
            , tmp_period_work.wType        :=108
            ;
          }
        } //if pGRAFF_WorkPeriod.StartShift2[ii] < pGRAFF_WorkPeriod.EndShift2[ii]


      }//if _wTypeFill=1
    } //For(ii:=1;ii<=31;ii++)

  } //Fill_Graff_info


  //----------------------------------------------------------------------------
  #doc
     Рассчитать все дни по человеку
     _wTypeRas=0 - считается, что все время проведено по приказам - по умолчанию
     _wTypeRas=1 - c учетом утвержденных приказов
     _wTypeRas=2 - c таблицы сальдо - проект
     _wTypeRas=3 - c таблицы сальдо - проект + заполнение плана
     _wTypeRas=4 - c таблицы сальдо - проект + заполнение плана - за день
  #end
  Function CalcAll(_cScud_Pers:comp //GP_SCUD_PERS.Nrec
    ;_wYearRas,_wMonthRas:word //Год , месяц расчета
    ;_wTypeRas:word=0
    ;_boReCalc:boolean=true // true - с перерасчетом
    ;_DayCalc:word =0//при расчете для приказов указать день
    ) :boolean;
  var ii:word;
      iibeg:word;
      iiend:word;
      diff_time:time;
      time_b,time_e:time;
      _wKateg:word;
      _Cur_Date:date;
      _Propusk_DTB:date;
      _Propusk_DTE:date;
  { pGP_SCUD_Pers:=_cScud_Pers;
    // Сюда нальем обязательные режимы
    Result:=False;
    delete all tmp_period_work;
    delete Tmp_Scud_MisConDuct where ((
           _cScud_Pers == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
      and  _wYearRas   == Tmp_Scud_MisConDuct.YearN
      and  _wMonthRas  == Tmp_Scud_MisConDuct.MesN
    ));
    delete all tmp_period_Order;
    _wKateg:=GetKategType(GP_SCUD_Pers.cGp_Scud_Kateg);

    _Cur_Date:=Cur_Date; //все, что в эту дату или позже, не может быть нарушением.
    //-- еще не известно пришел или нет
    if Cur_Time<time(9,0,0,0)
    { _Cur_Date:=Sub_Day(_Cur_Date,1);

    }
    wYearRas:=_wYearRas;
    wMonthRas:=_wMonthRas;
    Calc_Rejim:=True;
    DTB_A:=date(1,_wMonthRas,_wYearRas);
    DTE_A:=date(Last_Day(DTB_A),_wMonthRas,_wYearRas);
    //------------------------------------------
    // с 01/08/2019 все что больше часа - переработка
    var OVER2_Type_TM:time=time(1,0,0,0);// начиная с какого времени учитывать переработку
    // с 01/06/2018 все что больше получаса - переработка
    if DTB_A<Date(01,08,2019)
      OVER2_Type_TM:=time(0,30,0,0);
    // ранее 01/06/2018 - 15 минут
    if DTB_A<Date(01,06,2018)
      OVER2_Type_TM:=time(0,15,0,0);

    var _wTypeRas_In:word=_wTypeRas;
    var _CH_Fact_Before:array[1..31] of double;

    //------------------------------------------
    ClearAdvRecord(pGP_SCUD_S_D);
    //------------------------------------------
    if  _wTypeRas=4
    { if  _DayCalc<=Last_Day(DTB_A) and _DayCalc>0
      { DTB_A:=date(_DayCalc,_wMonthRas,_wYearRas);
        DTE_A:=date(_DayCalc,_wMonthRas,_wYearRas);
      }
      else
      { _wTypeRas:=2;
        _DayCalc:=0;
      }
    } //if  _wTypeRas=4
    DTB:=DTB_A;
    DTE:=DTE_A;
    TMB_A:=time( 0,0,0,0);
    TME_A:=time(24,0,0,0);
    TMB:=TMB_A;
    TME:=TME_A;
    if not BoundActive(tbbyGP_SCUD_PersM)
    { Pushbounds(tbbyGP_SCUD_PersM);
      Pushbounds(tbByPers);
    }
    Timelog('GP_SCUD_EVENTSEDIT->CalcAll->cScud_Pers='+string(_cScud_Pers,0,0));
    if getfirst GP_SCUD_Pers<>tsok exit;
#IFDEF GP_SCUD_EventsEdit_DEBUG
    if TimeLog_Status>0
    { timelog('CalcAll cScud_Pers='+string(_cScud_Pers,0,0)+', _wYearRas='+string(_wYearRas)+',_wMonthRas= '+string(wMonthRas)
             +', _wTypeRas='+string(_wTypeRas)+' ,_boReCalc='+string(_boReCalc) );
      timelog('CalcAll FIO ='+GP_SCUD_Pers.Fio+','+DateToStr(DTB_A,'DD/MM/YYYY')+','+DateToStr(DTE_A,'DD/MM/YYYY'));
    }
#ENDIF
    if ((_wTypeRas=2 or _wTypeRas=3 ) and (not _boReCalc))
    or _wTypeRas=4 // Для этого типа берем всегда
    { if iGP_SCUD_SaldoEdit.GetSaldoBuf(pGP_SCUD_Pers,_wYearRas,_wMonthRas,false,pGP_SCUD_Saldo,false)
      { insert into Tmp_Scud_MisConDuct
        (  cGP_SCUD_PERS,Yearn,MesN
          ,DT_Ev,TM_Ev,wMisConDuct,tDiff
          ,cMisConDuct
        )
        select
           _cScud_Pers,_wYearRas,_wMonthRas
          ,GP_SCUD_MisCon_D.DT_Ev
          ,GP_SCUD_MisCon_D.TM_Ev
          ,GP_SCUD_MisCon_D.wMisConDuct
          ,GP_SCUD_MisCon_D.tDiff
          ,GP_SCUD_MisCon_D.cMisConDuct
        from GP_SCUD_MisCon_D
        where ((
             _cScud_Pers == GP_SCUD_MisCon_D.cGP_SCUD_PERS
        and  _wYearRas   == GP_SCUD_MisCon_D.YearN
        and  _wMonthRas  == GP_SCUD_MisCon_D.MesN
        ));
        Result:=true;
        if _wTypeRas=3
        { pGP_SCUD_Saldo.CH_Graf_All  := 0;
          Fill_Graff_info(_cScud_Pers,_wYearRas,_wMonthRas);

        }
        if _wTypeRas<>4 Exit;// Для 4 типа продолжим
      }
    } //if _wTypeRas=2

    //----------
    if _wTypeRas=4
    { iibeg:=_DayCalc;
      iiend:=_DayCalc;
      pGP_SCUD_Saldo.CH_Graf_All    := pGP_SCUD_Saldo.CH_Graf_ALL   - pGP_SCUD_Saldo.CH_GrafCh   [_DayCalc];
      pGP_SCUD_Saldo.CH_Fact_All    := pGP_SCUD_Saldo.CH_Fact_All   - pGP_SCUD_Saldo.CH_FactCh   [_DayCalc];
      PGP_SCUD_Saldo.CH_Over_Cur    := PGP_SCUD_Saldo.CH_Over_Cur   - pGP_SCUD_Saldo.CH_Overwork [_DayCalc];
      PGP_SCUD_Saldo.CH_Over2_Cur   := PGP_SCUD_Saldo.CH_Over2_Cur  - pGP_SCUD_Saldo.CH_Overwork2[_DayCalc];
      PGP_SCUD_Saldo.CH_Holiday_Cur := PGP_SCUD_Saldo.CH_Holiday_Cur- (pGP_SCUD_Saldo.CH_Holiday  [_DayCalc]+10000);
      PGP_SCUD_Saldo.CH_Holiday_Opl := PGP_SCUD_Saldo.CH_Holiday_Opl- (pGP_SCUD_Saldo.CH_Holiday  [_DayCalc]+10000);
      pGP_SCUD_Saldo.Days         [_DayCalc]:='';
      pGP_SCUD_Saldo.CH_MisConDuct[_DayCalc]:=0;
      pGP_SCUD_Saldo.CH_GrafCh    [_DayCalc]:=0;
      pGP_SCUD_Saldo.CH_FactCh    [_DayCalc]:=0;
      pGP_SCUD_Saldo.CH_Overwork  [_DayCalc]:=0;
      pGP_SCUD_Saldo.CH_Overwork2 [_DayCalc]:=0;
      pGP_SCUD_Saldo.CH_Holiday   [_DayCalc]:=0;
      _CH_Fact_Before[_DayCalc] :=0;
      //GP_STAFF::GP_SCUD_SALDOCALCDAY,2018,1,9,2814749767120407
    }
    else
    { iibeg:=1;
      iiend:=31;
      ClearAdvRecord(pGP_SCUD_Saldo) ;
      iGP_SCUD_SaldoEdit.GetSaldo(pGP_SCUD_Pers,_wYearRas,_wMonthRas,true
         ,pGP_SCUD_Saldo.CH_Over_Ost,pGP_SCUD_Saldo.CH_Over2_Ost
         ,pGP_SCUD_Saldo.CH_Holiday_Ost
         ,pGP_SCUD_Saldo.CH_Over_Opl
         ,pGP_SCUD_Saldo.CH_Over2_Opl
         ,pGP_SCUD_Saldo.CH_Holiday_Opl
         );
      for(ii:=1;ii<=31;ii++)
      { _CH_Fact_Before[II]:=0;
      }
      pGP_SCUD_Saldo.CH_Holiday_Opl:=0;
    }
    //----------
    pGP_SCUD_Saldo.CGP_SCUD_PERS:=pGP_SCUD_Pers;
    pGP_SCUD_Saldo.CPERSONS     :=GP_SCUD_Pers.cPErsons;
    pGP_SCUD_Saldo.MesN         :=wMonth;
    pGP_SCUD_Saldo.YearN        :=wYear;


    Fill_Tmp_Data(_cScud_Pers,DTB,DTE);
    if _wTypeRas>0
    { Fill_Tmp_Data_Order(_cScud_Pers,DTB,DTE);

    }
    if _wMonthRas=1 pGP_SCUD_SALDO.CH_Over_Ost:=0;

    //-------------------------------------
    //-- Рассчитаем  сколько отнять из переработки по заявлениям.
    //Из переработки за день вычитаем план!!!! По утвержденному заявлению.
    //18 от 22.11.2017
    _Loop tmp_period where (( pGP_SCUD_Pers == tmp_period.cGP_SCUD_PERS ))
    { ii:=Day(tmp_period.EventDate);
      if ii=0 then continue;
      if tmp_period.wType=1 continue; // поручение руководителя тоже работа
      if tmp_period.wType=2 continue; // поручение руководителя тоже работа
      if tmp_period.EventtmE<=tmp_period.EventtmB continue;
      pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_Overwork2[ii]
         //-GetDoubleFromTime(Sub_time(tmp_period.EventtmE,tmp_period.EventtmB));
         -GetDoubleFromTime(tmp_period.PlanTime);
      //поскольку при отнимании могут быть перекрытия заявлений, то время для отнимания   может превысить график.
      if pGP_SCUD_Saldo.CH_Overwork2[ii]<-pGP_SCUD_Saldo.CH_GrafCh[ii]
      {  pGP_SCUD_Saldo.CH_Overwork2[ii]:=-(pGP_SCUD_Saldo.CH_GrafCh[ii]+0.01);
      }
    } //_Loop tmp_period where (( pGP_SCUD_Pers == tmp_period.cGP_SCUD_PERS ))
    //-- Рассчитаем  сколько отнять из переработки по заявлениям.
    //-------------------------------------

    //-------------------------------
    //--- Заполним информацию о графиках работы
    var boTable:boolean;
    boTable:=Fill_Graff_info(_cScud_Pers,_wYearRas,_wMonthRas,1,if(_wTypeRas=4,_DayCalc,0));
    //--- Заполним информацию о графиках работы
    //-------------------------------
    var _dmEvExist:Array[1..31] of word;//Для контроля наличия выхода
    For(ii:=iibeg;ii<=iiend;ii++)
    { pGP_SCUD_Saldo.TMB[ii]:=Time(24,0,0,0);
      _dmEvExist[ii]:=0;
    }
#IFDEF GP_SCUD_EventsEdit_DEBUG
//    if TimeLog_Status>0 timelog('CalcAll Calc_Graf_T ='+TimeToStr(Calc_Graf_T,'HH:MM')+','+string(Calc_Graf_d));

//    vM.puttabletodbf(#tmp_period_work,'tmp_period_work_'+String(_cScud_Pers,0) + DateToStr(Calc_Date,'_YYYYMMDD' +'.dbf',0);
 //   Puttabletodbf(#tmp_period_work,'tmp_period_work_'+String(_cScud_Pers,0) + '.dbf',0);

#ENDIF

    //------------------
    // куда то нужно подевать время перерывов
    _wKateg:=GetKategType(GP_SCUD_Pers.cGp_Scud_Kateg);
    Calc_Date:=ZeroDate;
    var _boNotWorkDay:boolean;
    var time_b2:time=ZeroTime;
    var agileDay: date = ZeroDate;
    _Loop GP_SCUD_Events
    { ii:=Day(GP_SCUD_Events.EnterDate);
      if GP_SCUD_Events.cStatus=pStatus_DM[4] // отменен
        continue;
      if IsAgileRejim(GP_SCUD_Events.cGP_SCUD_Pers, GP_SCUD_Events.EnterDate)
      {
        if getfirst tAgileCache where ((GP_SCUD_Events.NRec == tAgileCache.cEvent)) <> tsOk
        {
          CalcDayAgile(GP_SCUD_Events.NRec);
          if getfirst tAgileCache where ((GP_SCUD_Events.NRec == tAgileCache.cEvent)) <> tsOk
            continue;
        }
        if getfirst tAgileCacheDay where ((GP_SCUD_Events.cGP_SCUD_Pers == tAgileCacheDay.cScudPers and GP_SCUD_Events.EnterDate == tAgileCacheDay.eventDate)) <> tsOk
          continue;
        if GP_SCUD_Events.EnterDate <> agileDay
        {
          pGRAFF_WorkPeriod.StartWorkDayR[ii] := tAgileCacheDay.PlanStartWork; //"Начало рабочего дня",
          pGRAFF_WorkPeriod.EndWorkDayR  [ii] := tAgileCacheDay.PlanEndWork; //"Окончание рабочего дня",
          
          pGP_SCUD_Saldo.CH_FactCh[ii]:=GetDoubleFromTime(Sub_Time(Add_Time(tAgileCacheDay.workTime, tAgileCacheDay.dinnerTime), tAgileCacheDay.planDinnerTime));
          pGP_SCUD_Saldo.TMB[ii]:=tAgileCacheDay.StartWork;
          pGP_SCUD_Saldo.TME[ii]:=tAgileCacheDay.EndWork;
          if tAgileCacheDay.absenseTime > time(0, 15, 0, 0)
            pGP_SCUD_Saldo.CH_MisConDuct[ii]:=GetDoubleFromTime(tAgileCacheDay.absenseTime);
          if Add_Time(tAgileCacheDay.workTime, tAgileCacheDay.dinnerTime) > Add_Time(tAgileCacheDay.planWorkTime, OVER2_Type_TM)
            pGP_SCUD_Saldo.CH_Overwork2[ii] := GetDoubleFromTime(Sub_Time(Add_Time(tAgileCacheDay.workTime, tAgileCacheDay.dinnerTime), tAgileCacheDay.planWorkTime));
          _dmEvExist[ii]:=1;
          delete tmp_period_work where ((GP_SCUD_Events.cGP_SCUD_Pers == tmp_period_work.cGP_SCUD_PERS and GP_SCUD_Events.EnterDate == tmp_period_work.EventDate));
        }
        agileDay := GP_SCUD_Events.EnterDate;
        
        if TimeLog_Status>0 
          timelog(' tAgileCache: ' + GP_SCUD_Events.EnterDate + ', ' + GP_SCUD_Events.EnterTime + ', ' + tAgileCache.wMisConDuct + ', ' + tAgileCache.absenseTime);
        if tAgileCache.wMisConDuct <> 0 and tAgileCache.absenseTime > ZeroTime
        {
          var cZay: comp = 0;
          if getfirst GP_SCUD_DOC_SP_A = tsok
            cZay := GP_SCUD_DOC_SP_A.cGP_SCUD_DOC;
          insert into Tmp_Scud_MisConDuct set
                  Tmp_Scud_MisConDuct.cMisConDuct:= cZay
                , Tmp_Scud_MisConDuct.wMisConDuct:= tAgileCache.wMisConDuct
                , Tmp_Scud_MisConDuct.cGP_SCUD_PERS:=GP_SCUD_Events.cGP_SCUD_Pers
                , Tmp_Scud_MisConDuct.MesN  :=_wMonthRas
                , Tmp_Scud_MisConDuct.YearN :=_wYearRas
                , Tmp_Scud_MisConDuct.DT_Ev :=GP_SCUD_Events.EnterDate
                , Tmp_Scud_MisConDuct.TM_Ev :=GP_SCUD_Events.Entertime
                , Tmp_Scud_MisConDuct.tDiff := tAgileCache.absenseTime
                ;
          
          var absCode: string = if(cZay = 0, '/Н', '/ЗО');
          if pos(absCode, pGP_SCUD_S_D.Calc_Days2[ii]) = 0
            pGP_SCUD_S_D.Calc_Days2[ii] += absCode;
          
          ClearBuffer(tntmp_period_work);
          tmp_period_work.cGP_SCUD_PERS := GP_SCUD_Events.cGP_SCUD_Pers;
          tmp_period_work.EventDate := GP_SCUD_Events.EnterDate;
          tmp_period_work.EventTmB := if(GP_SCUD_Events.wResource = 0, GP_SCUD_Events.EnterTime, Sub_Time(GP_SCUD_Events.EnterTime, tAgileCache.absenseTime));
          tmp_period_work.EventTmE := if(GP_SCUD_Events.wResource = 1, GP_SCUD_Events.EnterTime, Add_Time(GP_SCUD_Events.EnterTime, tAgileCache.absenseTime));
          // tmp_period_work.PlanTime
          tmp_period_work.wType := if(GP_SCUD_Events.EnterTime <= time(12, 0, 0, 0), 101, 105);
          insert current tmp_period_work;
          if TimeLog_Status>0 
            timelog(' tmp_period_work: ' + tmp_period_work.EventDate
            +', Начало: '+TimeToStr(tmp_period_work.EventTmB,'HH:MM')
            +', Окончание: '+TimeToStr(tmp_period_work.EventTmE,'HH:MM')
            +', тип: '+tmp_period_work.wType
            );
        }
        continue;
      }
      time_e:=ZeroTime;
      time_b:=ZeroTime;
      time_b2:=ZeroTime;

      //--------------------------------
      _boNotWorkDay:=CheckDaysNotWork(ii);
#IFDEF GP_SCUD_EventsEdit_DEBUG
        if TimeLog_Status>0 timelog(' Событие за день '+string(ii)
           +', время '+TimeToStr(GP_SCUD_Events.EnterTime,'HH:MM')
           +', тип '+if(GP_SCUD_Events.wResource=1,'Вход','Выход')
           +', Days[ii]='+pGP_SCUD_Saldo.Days[ii]+', _boNotWorkDay='+string(_boNotWorkDay)
           );
#endif
      //--------------------------------

      if Calc_Date<>GP_SCUD_Events.EnterDate
      { Calc_Date:=GP_SCUD_Events.EnterDate;
        if getlast GP_SCUD_Pers_Hist=tsok
          if GP_SCUD_Pers_Hist.cGp_Scud_Kateg>0
          _wKateg:=GetKategType(GP_SCUD_Pers_Hist.cGp_Scud_Kateg);
      }
      if _wKateg=0 _wKateg:=5;
      diff_Time:=GetPlanTime(GP_SCUD_Events.nrec,GP_SCUD_Events.EnterDate);
      var _wMisConDuct:word=0;
      if pGP_SCUD_Saldo.CH_GrafCh   [ii]>0 // только если есть часы по графику - тогда нарушение
      and (not _boNotWorkDay) // и это не больничный
      {
        if _wKateg=3 // расширим день
        { if GP_SCUD_Events.EnterTime<pGRAFF_WorkPeriod.StartWorkDayR[ii]
            pGRAFF_WorkPeriod.StartWorkDayR[ii] := GP_SCUD_Events.EnterTime; //"Начало рабочего дня",
          if GP_SCUD_Events.EnterTime>pGRAFF_WorkPeriod.EndWorkDayR[ii]
            pGRAFF_WorkPeriod.EndWorkDayR  [ii] := GP_SCUD_Events.EnterTime; //"Окончание рабочего дня",
        }
        _wMisConDuct:=GetMisConDuct(GP_SCUD_Events.nrec,diff_Time,GP_SCUD_Events.EnterDate,1);
#IFDEF GP_SCUD_EventsEdit_DEBUG
        if TimeLog_Status>0 timelog(' diff_Time='+string(diff_Time,0,2)+', _wMisConDuct='+string(_wMisConDuct));
#endif
        if _wKateg=3
        { //для 3 группы(свободный проход) все отсутствие в середине дня плюсуем в факт
          //Ранний уход на обед, Поздний приход с обеда, Отсутствие в середине дня.
          if _wMisConDuct=2 or _wMisConDuct=3 or _wMisConDuct=5
          { // иначе двоим
            if (GP_SCUD_EVENTS.WRESOURCE=1 and (_wMisConDuct=3))
            or (GP_SCUD_EVENTS.WRESOURCE=0 and (_wMisConDuct=2 or _wMisConDuct=5))
            { diff_Time:=GetDiffTime(GP_SCUD_Events.Nrec,diff_Time);
              #IFDEF GP_SCUD_EventsEdit_DEBUG
               if TimeLog_Status>0 timelog(' Добавляем  diff_Time='+string(diff_Time,0,2)+', _wMisConDuct='+string(_wMisConDuct));
              #endif
              pGP_SCUD_Saldo.CH_FactCh[ii]:=pGP_SCUD_Saldo.CH_FactCh[ii]+Hour(Diff_Time)+Minute(Diff_Time)/60;
            }
            _wMisConDuct:=0;
          }
        } //if _wKateg=3
        //------------------------------
        //Проверим случаи, когда нарушение это не нарушение
        //есть заявление с типом 1 или 2
        if GetColorEvents(GP_SCUD_Events.nrec)=ColorSysGreen
          if GP_SCUD_Reason_A.wType<3
          _wMisConDuct:=0;
        //есть приказ 91 на отгул или 71 на дополнительный день отпуска
        if  pGRAFF_WorkPeriod.RestDayOfHoliday[ii]<>ZeroTime //есть отгул
        or  pGP_SCUD_Saldo.Days[ii]='НВ'
          _wMisConDuct:=0;
        //---------------------------
        var _pGP_SCUD_DOC_A:comp=0;
        if  _wMisConDuct>0
        and _wMisConDuct<11 //11 опоздание на работу, но с наличием исключения
        and (_wMisConDuct<>5 or GP_SCUD_EVENTS.WRESOURCE=1) //20181128 было 0 - выход, а теперь нарушения показывается только на входе
        { diff_Time:=GetDiffTime(GP_SCUD_Events.Nrec,diff_Time);
          /*
          Переносим в GetDiffTime
          if _wMisConDuct=1 //опоздание на работу
          { //добавим время до обеда , если пришел только после обеда
            if  GP_SCUD_Events.Entertime>pGRAFF_WorkPeriod.EndBreak1[ii]
            and GP_SCUD_Events.Entertime<pGRAFF_WorkPeriod.EndWorkDay[ii]
            and pGRAFF_WorkPeriod.StartBreak1[ii]>pGRAFF_WorkPeriod.StartWorkDay[ii]
              diff_Time:=Add_Time(diff_Time
                    ,Sub_Time(pGRAFF_WorkPeriod.StartBreak1[ii],pGRAFF_WorkPeriod.StartWorkDay[ii]));

          }
          */
          if timelog_status>0
          { timelog('Нарушение '+String(_wMisConDuct)+', diff_Time='+TimeToStr(diff_Time,'HH:MM:SS') );

          }
          if _wMisConDuct=5//отсутствие в середине дня , а не 4
          { //Diff_Time:=Sub_time(GP_SCUD_Events_Next.EnterTime,GP_SCUD_Events_Next.EnterTime);
            pGP_SCUD_Saldo.CH_MisConDuct[ii]:=pGP_SCUD_Saldo.CH_MisConDuct[ii]
              +GetDoubleFromTime(diff_Time);
            timelog('Нарушение середины дня '+String(pGP_SCUD_Saldo.CH_MisConDuct[ii],0,2) );
          }
          //----------------
          if _wMisConDuct<>5 or diff_Time>time(0,15,0,0)
          { var _sabs:string='/Н';
            //if isValidAll(tnGP_SCUD_DOC_SP_A)
            if getfirst GP_SCUD_DOC_SP_A=tsok
            { _pGP_SCUD_DOC_A:=GP_SCUD_DOC_SP_A.cGP_SCUD_DOC;
              _sabs:='/ЗО'
            }
            if pos(_sabs,pGP_SCUD_S_D.Calc_Days2[ii])=0
            { pGP_SCUD_S_D.Calc_Days2[ii]:=pGP_SCUD_S_D.Calc_Days2[ii]+_sabs;
            }
          }
          if diff_Time<>ZeroTime // Если 0 то зачем вставлять
          insert into Tmp_Scud_MisConDuct set
                  Tmp_Scud_MisConDuct.cMisConDuct:= _pGP_SCUD_DOC_A //iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeNrec(_wMisConDuct)
                , Tmp_Scud_MisConDuct.wMisConDuct:= _wMisConDuct
                , Tmp_Scud_MisConDuct.cGP_SCUD_PERS:=_cScud_Pers
                , Tmp_Scud_MisConDuct.MesN  :=_wMonthRas
                , Tmp_Scud_MisConDuct.YearN :=_wYearRas
                , Tmp_Scud_MisConDuct.DT_Ev :=GP_SCUD_Events.EnterDate
                , Tmp_Scud_MisConDuct.TM_Ev :=GP_SCUD_Events.Entertime
                , Tmp_Scud_MisConDuct.tDiff := diff_Time//Glob_DiffTime
                ;
#IFDEF GP_SCUD_Head_View_DEBUG
#define _outLog(_TX)  if TimeLog_Status>0 timelog(' #_TX = ' + #_TX);

 if TimeLog_Status>0 timelog(' _wMisConDuct='+_wMisConDuct+'------ '  +GP_SCUD_Pers.Fio + ' -- ' + Calc_Date );
#_outLog (_cScud_Pers)


if TimeLog_Status>0 timelog('текущее событие, DT_Ev=' + DateToStr( GP_SCUD_Events.EnterDate,'=DD.MM.YYYY  ') +
'TM_Ev' + timeToStr( GP_SCUD_Events.EnterTime,'=HH:MM.SS  ') +
'Type_Ev= '+ GP_SCUD_Events.wResource );
#ENDIF
           } //if _wMisConDuct>0
        } //if Calc_GrafCh   [ii]>0

        if GP_SCUD_Events.wResource=1 // Вход
        { time_b:=GP_SCUD_Events.Entertime;
          time_e:=time(24,0,0,0);
          if getfirst GP_SCUD_Events_Next=tsok
          { if True //GP_SCUD_Events_Next.wResource=0 // Вход - не будем проверять. если событие ошибочное, много получается
            { time_e:=GP_SCUD_Events_Next.Entertime ;
              // если вышел на следующий день, значит считаем конец дня
              if GP_SCUD_Events_Next.EnterDate>GP_SCUD_Events.EnterDate
               time_e:=time(24,0,0,0);
#IFDEF GP_SCUD_EventsEdit_DEBUG
              if TimeLog_Status>0 timelog(' -- нашли событие выхода  time_e='+string(time_e)+', time_b='+string(time_b)
              +','+string(GP_SCUD_Events_Next.Entertime));
#ENDIF
            }
          } //if getfirst GP_SCUD_Events_Next=tsok
          else // если нет события выхода
          { if pGRAFF_WorkPeriod.EndWorkDay[ii]<>ZeroTime
            { time_e:=pGRAFF_WorkPeriod.EndWorkDay[ii];
            }
            if pGRAFF_WorkPeriod.EndShift2[ii]<>ZeroTime
            { if pGRAFF_WorkPeriod.EndShift2[ii]<pGRAFF_WorkPeriod.EndWorkDay[ii]
              { if time_b<=pGRAFF_WorkPeriod.EndShift2[ii]
                  time_e:=pGRAFF_WorkPeriod.EndShift2[ii];
              }
              else
              { if time_b>=pGRAFF_WorkPeriod.EndWorkDay[ii]
                 time_e:=pGRAFF_WorkPeriod.EndShift2[ii];
              }
            }
          } //else if getfirst GP_SCUD_Events_Next=tsok
          if time_e=ZeroTime
          { if time_b<pGRAFF_WorkPeriod.StartBreak1[ii]
              time_e:=pGRAFF_WorkPeriod.StartBreak1[ii]
            else
            if time_b<pGRAFF_WorkPeriod.StartBreak2[ii]
              time_e:=pGRAFF_WorkPeriod.StartBreak2[ii]
            else
              time_e:=pGRAFF_WorkPeriod.EndWorkDay[ii];

          }

#IFDEF GP_SCUD_EventsEdit_DEBUG
        if TimeLog_Status>0 timelog(' -- нашли период '+string(ii)+' time_e='+string(time_e)+', time_b='+string(time_b)+', _wMisConDuct='+string(_wMisConDuct));
        if TimeLog_Status>0 timelog(' '+string(pGRAFF_WorkPeriod.EndShift2[ii])+' '+string(pGRAFF_WorkPeriod.StartWorkDay[ii])+' '+string(pGRAFF_WorkPeriod.EndBreak2[ii]));
        if TimeLog_Status>0 timelog(' 1 '+string(pGRAFF_WorkPeriod.StartWorkDay[ii])
               +' 2 '+string(pGRAFF_WorkPeriod.EndWorkDay  [ii])
               +' 3 '+string(pGRAFF_WorkPeriod.StartShift2 [ii])
               +' 4 '+string(pGRAFF_WorkPeriod.EndShift2   [ii])
               +' 5 '+string(pGRAFF_WorkPeriod.StartBreak1 [ii])
               +' 6 '+string(pGRAFF_WorkPeriod.EndBreak1   [ii])
               +' 7 '+string(pGRAFF_WorkPeriod.StartBreak2 [ii])
               +' 8 '+string(pGRAFF_WorkPeriod.EndBreak2   [ii])
         );
#ENDIF

          // попробуем определить смену
          if //time_b<pGRAFF_WorkPeriod.EndShift2   [ii]
              time_b<=pGRAFF_WorkPeriod.StartShift2 [ii]
          and ( pGRAFF_WorkPeriod.EndWorkDay[ii]<time_b
            or pGRAFF_WorkPeriod.EndShift2[ii]<pGRAFF_WorkPeriod.StartWorkDay[ii]
              )
          { //if time_b<pGRAFF_WorkPeriod.StartShift2 [ii]
            //  time_b:=pGRAFF_WorkPeriod.StartShift2 [ii]
          }
          else
          if time_b<pGRAFF_WorkPeriod.StartWorkDay[ii]
          { // надо ловить все   time_b:=pGRAFF_WorkPeriod.StartWorkDay[ii]
          }
          // пробуем вычленить обеды
          // если вернулся во время обеда считаем, что вернулся в окончание обеда
          else if time_b< pGRAFF_WorkPeriod.EndBreak2   [ii]
              and time_b> Sub_time(pGRAFF_WorkPeriod.StartBreak2 [ii],Time(0,0,0,0))
          { time_b:=pGRAFF_WorkPeriod.EndBreak2   [ii];
          }
          // если вернулся во время обеда считаем, что вернулся в окончание обеда
          else if time_b< pGRAFF_WorkPeriod.EndBreak1   [ii]
              and time_b> Sub_time(pGRAFF_WorkPeriod.StartBreak1 [ii],Time(0,0,0,0))
          { time_b:=pGRAFF_WorkPeriod.EndBreak1   [ii];
          }
          //--------- если нет нарушения, но пришел позже начала - поставим начало работы в начало смены
          //   значит есть исключение периодов
          else if   _wMisConDuct=11 //11 опоздание на работу, но с наличием исключения
               and (_wKateg=3 or _wKateg=5)
               and time_b<pGRAFF_WorkPeriod.StartBreak1 [ii]
               and time_b>pGRAFF_WorkPeriod.StartWorkDay[ii]
          { time_b2:=pGRAFF_WorkPeriod.StartWorkDay[ii]
          }
          // определим выход
          if  time_e<=pGRAFF_WorkPeriod.EndBreak2  [ii]
          and time_e>pGRAFF_WorkPeriod.StartBreak2[ii]
          { time_e:=pGRAFF_WorkPeriod.StartBreak2[ii];

          }
          else
          if  time_e<pGRAFF_WorkPeriod.EndBreak1  [ii]
          and time_e>pGRAFF_WorkPeriod.StartBreak1[ii]
          { time_e:=pGRAFF_WorkPeriod.StartBreak1[ii];

          }

       } // } //if GP_SCUD_Events_Next.wResource=1 // Выход
       //выходы ловим только  если вход был в предыдущий день
       else
       {
#IFDEF GP_SCUD_EventsEdit_DEBUG
         if TimeLog_Status>0 timelog('else if GP_SCUD_Events_Next.wResource=1');
#ENDIF
         if getlast GP_SCUD_Events_Prev=0
         { if GP_SCUD_Events_Prev.enterDate<GP_SCUD_Events.enterDate
           { time_b:=time(0,0,0,0);
             time_e:=GP_SCUD_Events.EnterTime;
           } else continue;
         }
         else continue;
       } //else if GP_SCUD_Events_Next.wResource=1 // Выход
#IFDEF GP_SCUD_EventsEdit_DEBUG
        if TimeLog_Status>0 timelog(' 002 time_e='+string(time_e)+', time_b='+string(time_b));
#ENDIF
       //------------------------
       if pGP_SCUD_Saldo.TMB[ii]>time_b pGP_SCUD_Saldo.TMB[ii]:=time_b;
       if pGP_SCUD_Saldo.TME[ii]<time_e pGP_SCUD_Saldo.TME[ii]:=time_e;
       //опоздал, но есть исключение периодов или нет контроля
       if _wMisConDuct=11 and time_b2<>zeroTime
       { time_b:=time_b2;
       }
       _dmEvExist[ii]:=1;

       //------------------------
       if time_e=ZeroTime continue;
       // итого за время нахождения
       diff_time:=Sub_Time(time_e,time_b);
       if _boNotWorkDay
       //and _DayCalc<>ii // если идет расчет по приказу нельзя пропускать
       { continue;//если это больничный или отпуск, дальше не считаем
       }
#IFDEF GP_SCUD_EventsEdit_DEBUG
       if TimeLog_Status>0 timelog(' diff_time =  '+TimeToStr(diff_time,'HH:MM:SS:SSS')
          +', '+GetDoubleFromTime(diff_time));
#ENDIF
        //если вышел и вернулся во время обеда
        if time_b>time_e continue;

       _Loop fullcache tmp_period_work where ((
              pGP_SCUD_Pers == tmp_period_work.cGP_SCUD_PERS
         and  GP_SCUD_Events.EnterDate == tmp_period_work.EventDate
         and  time_b      <<= tmp_period_work.EventTmE(noindex)
         and  time_e      >>= tmp_period_work.EventTmB(noindex)
        ))
       {
#IFDEF GP_SCUD_EventsEdit_DEBUG
         if TimeLog_Status>0 timelog(' Проверяем периоды =  '
            +TimeToStr(tmp_period_work.EventTmB,'HH:MM:SS:SSS')
            +TimeToStr(tmp_period_work.EventTmE,' - HH:MM:SS:SSS')
           );
#ENDIF

         //рабочий период полностью в диапазоне
         if  tmp_period_work.EventTmB>=time_b
         and tmp_period_work.EventTmE<=time_e
         { delete current tmp_period_work;
#IFDEF GP_SCUD_EventsEdit_DEBUG
         if TimeLog_Status>0 timelog(' 0001 ');
#ENDIF
           continue;
         }
         if tmp_period_work.EventTmB<time_b
         { if tmp_period_work.EventTmE>=time_e
           { tmp_period_work_d.buffer:=tmp_period_work.buffer;
             tmp_period_work_d.EventTmB:=time_e;
             insert current tmp_period_work_d;

             update current tmp_period_work set tmp_period_work.EventTmE:=time_b;
#IFDEF GP_SCUD_EventsEdit_DEBUG
             if TimeLog_Status>0 timelog(' 0002 ');
#ENDIF
             continue;
           }
           else
           // Здесь нужно разрезать на две части
           { tmp_period_work_d.buffer:=tmp_period_work.buffer;
             tmp_period_work_d.EventTmB:=time_e;
             insert current tmp_period_work_d;
             tmp_period_work.EventTmE:=time_b;
             update current tmp_period_work;
#IFDEF GP_SCUD_EventsEdit_DEBUG
             if TimeLog_Status>0 timelog(' 0003 ');
#ENDIF
             continue;
           }
         } //if tmp_period_work.EventTmB<time_b
         else
         { if tmp_period_work.EventTmE>time_e
           { // иначе режет
             tmp_period_work_d.buffer:=tmp_period_work.buffer;
             tmp_period_work_d.EventTmB:=time_e;
             insert current tmp_period_work_d;

             update current tmp_period_work set tmp_period_work.EventTmE:=time_e;
#IFDEF GP_SCUD_EventsEdit_DEBUG
             if TimeLog_Status>0 timelog(' 0004 ');
#ENDIF
             continue;
           }
         }
       } //_Loop fullcache tmp_period_work where ((
       // вычленим обеды если таковые имеются
       if  time_b<pGRAFF_WorkPeriod.StartBreak2[ii]
       and time_e>pGRAFF_WorkPeriod.StartBreak2[ii]
       { diff_time:=Sub_Time(diff_time,sub_time(if(time_e>pGRAFF_WorkPeriod.EndBreak2[ii],pGRAFF_WorkPeriod.EndBreak2[ii],time_e),pGRAFF_WorkPeriod.StartBreak2[ii]))

       }
       else
       if  time_b<pGRAFF_WorkPeriod.StartBreak1[ii]
       and time_e>pGRAFF_WorkPeriod.StartBreak1[ii]
       { diff_time:=Sub_Time(diff_time,sub_time(if(time_e>pGRAFF_WorkPeriod.EndBreak1[ii],pGRAFF_WorkPeriod.EndBreak1[ii],time_e),pGRAFF_WorkPeriod.StartBreak1[ii]))
       }

#IFDEF GP_SCUD_EventsEdit_DEBUG
       if TimeLog_Status>0 timelog(' diff_time2 =  '+TimeToStr(diff_time,'HH:MM:SS:SSS')+', '+GetDoubleFromTime(diff_time)
          +', time_b='+TimeToStr(time_b,'HH:MM:SS:SSS')
          +', time_e='+TimeToStr(time_e,'HH:MM:SS:SSS')
           );
#ENDIF

      //} //if GP_SCUD_Events.wResource=1
      pGP_SCUD_Saldo.CH_FactCh[ii]:=pGP_SCUD_Saldo.CH_FactCh[ii]+GetDoubleFromTime(diff_time);


      //if NPOEM_OWN_SCUD_OVER2_Type=1 Переработку копим здесь
      var _ch:double=0;
      _ch:=0;
      _ch:=Double(pGP_SCUD_Saldo.Days[ii]);
      if pGP_SCUD_Saldo.CH_GrafCh   [ii]>0
      and ( GP_SCUD_Events.wEvents_Type=2 //[List 0 '-','РВ','П','СВ']
         or _ch>0
         )
      if NPOEM_OWN_SCUD_OVER2_Type=1 // Переработку "ДО" копим здесь
      if GP_SCUD_Events.wResource=1 // Вход
      or time_b=ZeroTime //Есть Только выход со 2 смены
      { //1.Если пришел до смены ранее чем за 15 минут,
        //  то все время включается в переработку, т.е. смена с 08:00.
        //  При приходе в 07:20 в переработку попадет 0,67 часа .
        //2.Если пришел до смены менее чем за 15 минут,
        //  то все время НЕ включается в переработку, т.е. смена с 08:00.
        //  При приходе в 07:47 переработка будет 0.
        if (time_b<pGRAFF_WorkPeriod.StartWorkDay[ii])
        and (  (time_b>pGRAFF_WorkPeriod.EndShift2[ii]  and pGRAFF_WorkPeriod.EndShift2[ii]<pGRAFF_WorkPeriod.StartWorkDay[ii] ) //
            or (pGRAFF_WorkPeriod.StartShift2[ii]>pGRAFF_WorkPeriod.EndWorkDay[ii])
            )
        { var _time_e:time=ZeroTime;
          _time_e:=time_e;
          if _time_e>pGRAFF_WorkPeriod.StartWorkDay[ii]
            _time_e:=pGRAFF_WorkPeriod.StartWorkDay[ii];
          if _time_e>time_b
          { var _t_diff:double=GetDoubleFromTime(Sub_Time(_time_e,time_b));
            _CH_Fact_Before[ii]+=_t_diff;
            if _time_e>Add_time(time_b,OVER2_Type_TM) //time(0,15,0,0))
              pGP_SCUD_Saldo.CH_Overwork2[ii]+=_t_diff;
          }
        } //if time_b<pGRAFF_WorkPeriod.StartWorkDay[ii]
        else //вторая смена
        if (time_b<pGRAFF_WorkPeriod.StartShift2[ii]
        and time_b>pGRAFF_WorkPeriod.EndWorkDay[ii]
        and Add_Time(time_b,time(2,0,0,0))>pGRAFF_WorkPeriod.StartShift2[ii]
        )
        { var _time_e:time=ZeroTime;
          _time_e:=time_e;
          if _time_e>pGRAFF_WorkPeriod.StartWorkDay[ii]
            _time_e:=pGRAFF_WorkPeriod.StartWorkDay[ii];
          if _time_e>time_b
          { var _t_diff:double=GetDoubleFromTime(Sub_Time(_time_e,time_b));
            _CH_Fact_Before[ii]+=_t_diff;
            if _time_e>Add_time(time_b,OVER2_Type_TM) //time(0,15,0,0))
             pGP_SCUD_Saldo.CH_Overwork2[ii]+=_t_diff;
          }
        } //if time_b<pGRAFF_WorkPeriod.StartWorkDay[ii]
        //3.Если уходит после окончания смены более чем через 15 минут,
        //  то все время включается в переработку, т.е. смена заканчивается в 17:00. При уходе в 17:45 0,75 часа попадает в переработку.
        //4.При уходе после окончания смены мене чем через 15 минут,
        //  то все время НЕ включается в переработку, т.е. смена заканчивается в 17:00.
        //  При уходе в 17:14 в переработку пойдет 0.
        // Лучше сравнивать с Plan_time !
        if  time_e>pGRAFF_WorkPeriod.EndWorkDay[ii]
        and ( pGRAFF_WorkPeriod.StartShift2[ii]<pGRAFF_WorkPeriod.EndWorkDay[ii]
           or (pGRAFF_WorkPeriod.StartShift2[ii]<>ZeroTime
            and time_e<sub_time(pGRAFF_WorkPeriod.StartShift2[ii],time(1,0,0,0))
             )
           )
        { var _time_b:time=ZeroTime;
          _time_b:=time_b;
          if _time_b<pGRAFF_WorkPeriod.EndWorkDay[ii]
            _time_b:=pGRAFF_WorkPeriod.EndWorkDay[ii];
          if time_e>_time_b
          { if time_e>Add_time(_time_b,OVER2_Type_TM) //time(0,15,0,0))
                 pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_Overwork2[ii]+GetDoubleFromTime(Sub_Time(time_e,_time_b));
          }
        } //if time_b<pGRAFF_WorkPeriod.StartWorkDay[ii]
        else // Здесь нужно обработать 2 смену
        {

        }
        if timelog_status>0
        { timelog('Переработка = '+string(pGP_SCUD_Saldo.CH_Overwork2[ii],0,2));
        }
      } //if NPOEM_OWN_SCUD_OVER2_Type=1 // Переработку "ДО" копим здесь
#IFDEF GP_SCUD_EventsEdit_DEBUG
      if TimeLog_Status>0 timelog(' Calc_FactCh[ii] =  '+string(pGP_SCUD_Saldo.CH_FactCh[ii],0,3));

#ENDIF
    } //_Loop GP_SCUD_Events
    //--------------
    ////проверим заявления на остатки периодов
    _Loop fullcache tmp_period_work where ((
         pGP_SCUD_Pers == tmp_period_work.cGP_SCUD_PERS
         ))
    {
      if TimeLog_Status>0 timelog(' Остатки периодов =  '
            +DateToStr(tmp_period_work.EventDate,'DD/MM/YYYY')
            +TimeToStr(tmp_period_work.EventTmB,' HH:MM:SS:SSS')
            +TimeToStr(tmp_period_work.EventTmE,' - HH:MM:SS:SSS')
         );
      if tmp_period_work.EventTmE<tmp_period_work.EventTmB continue;
      var _tmb:time=tmp_period_work.EventTmb;
      var _tme:time=tmp_period_work.EventTme;
      //--------------------------------------
      //проверим на наличие периодов исключения
      var _Time_Diff:Time;
      _Time_Diff:=iGP_SCUD_ExClusionPeriod.GetPeriodWithOutExClusion(
           tmp_period_work.EventDate,_tmb,_tme,GP_SCUD_Events.cGP_SCUD_PERS);
      if TimeLog_Status>0
      { timelog('Ищем исключения - время после _Time_Diff='+timetoStr(_Time_Diff,'HH:MM:SS'));
      }
      /*
      Поскольку умудряются ввести три приказа на исключения за день, пересекающиеся меж собой
      то придется пробегать все
      if _Time_Diff=ZeroTime //период  попал под исключение
      { //добавим время как личное заявление
        if TimeLog_Status>0 timelog(' есть исключение  ' );
        insert into tmp_period set
             tmp_period.cGP_SCUD_PERS :=pGP_SCUD_Pers
            ,tmp_period.EventDate:=tmp_period_work.EventDate
            ,tmp_period.EventtmB      :=_tmb
            ,tmp_period.EventtmE      :=_tme
            ,tmp_period.wType :=102 //а вот тут вопрос - надо учитывать в отработанное время или нет
         ;
      }
      */
      ReReadRecord(#tmp_ExClusPeriod);
      _Loop tmp_ExClusPeriod
      { if TimeLog_Status>0 timelog(' есть исключение  '
          +TimeToStr(tmp_ExClusPeriod.EventTmB,'HH:MM:SS - ')
          +TimeToStr(tmp_ExClusPeriod.EventTmE,'HH:MM:SS')
          );
        insert into tmp_period set
             tmp_period.cGP_SCUD_PERS :=pGP_SCUD_Pers
            ,tmp_period.EventDate     :=tmp_period_work.EventDate
            ,tmp_period.EventtmB      :=tmp_ExClusPeriod.EventTmB
            ,tmp_period.EventtmE      :=tmp_ExClusPeriod.EventTmE
            ,tmp_period.wType :=102 //а вот тут вопрос - надо учитывать в отработанное время или нет
         ;
      }
      //-----------------------------------
      //Л.Д 10.11 - проверить наличие заявления
      //if getfirst

      _Loop fullcache tmp_period where ((
            pGP_SCUD_Pers == tmp_period.cGP_SCUD_PERS
       and tmp_period_work.EventDate ==tmp_period.EventDate
       and _tmb<<= tmp_period.EventtmE(noindex)
       and _tme>>= tmp_period.EventtmB(noindex)
       // только личное заявление или поручение руководителя
       and (tmp_period.wType=1 or tmp_period.wType=2 or tmp_period.wType=102)
      )) //=tsok
      { ii:=day(tmp_period_work.EventDate);
        // поручение руководителя - надо добавить часы
        time_b:=if(_tmb<tmp_period.EventtmB,tmp_period.EventtmB,_tmb);
        time_e:=if(_tme>tmp_period.EventtmE,tmp_period.EventtmE,_tme);
        if TimeLog_Status>0
        { timelog('ищем периоды в заяв. для '+DateToStr(tmp_period_work.EventDate,'DD/MM/YYYY')
                                +TimeToStr(_Tmb,', HH:MM-')
                                +TimeToStr(_TmE,'HH:MM')
                 );
          timelog('нашли периоды в заяв. для '+DateToStr(tmp_period.EventDate,'DD/MM/YYYY')
                                +TimeToStr(tmp_period.EventTmb,', HH:MM-')
                                +TimeToStr(tmp_period.EventTmE,'HH:MM')
                 );
        }
        //------------------------------------
        //Вопрос - а надо ли добавлять часы
        //-----------------------------------
        if tmp_period.wType=1 or tmp_period.wType=2 or tmp_period.wType=102
        { diff_time:=Sub_Time(time_e,time_b);
          if tmp_period.wType<>102
          { pGP_SCUD_Saldo.CH_FactCh[ii]:=pGP_SCUD_Saldo.CH_FactCh[ii]+Hour(diff_time)+Minute(diff_time)/60;
          }
          else
          { pGP_SCUD_S_D.CH_FactCh_Excl[ii]:=pGP_SCUD_S_D.CH_FactCh_Excl[ii]+Hour(diff_time)+Minute(diff_time)/60;

          }
          if TimeLog_Status>0
          { timelog(' добавили к факту '+TimeToStr(diff_time,'HH:MM:SS')
              +', итого '+string(pGP_SCUD_Saldo.CH_FactCh[ii],0,2)
              +', искл. '+string(pGP_SCUD_S_D.CH_FactCh_Excl[ii],0,2)
              )

          }
          //если есть вдруг в нарушениях - уберем
          var _boExist_M:boolean=false;
          _Loop fullcache Tmp_Scud_MisConDuct where
          (( _cScud_Pers  == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
          and tmp_period.EventDate == Tmp_Scud_MisConDuct.DT_EV
          and time_b<<=Tmp_Scud_MisConDuct.TM_Ev(noindex)
          and time_e>>=Tmp_Scud_MisConDuct.TM_Ev(noindex)
          // and (  Tmp_Scud_MisConDuct.wMisConDuct = 4
          ))
          { _boExist_M:=true;
            if TimeLog_Status>0
            { timelog(' есть нарушение на период '+TimeToStr(Tmp_Scud_MisConDuct.tDiff,'HH:MM:SS:SSS')
                  +', искл.' +TimeToStr(diff_time,'HH:MM:SS:SSS')
                  +', тип '+string(Tmp_Scud_MisConDuct.wMisConDuct)
                );
            }
            if Tmp_Scud_MisConDuct.tDiff<=diff_time //Add_time(diff_time,time(0,0,30,0))
            { //----
              //pGP_SCUD_Saldo.CH_MisConDuct[ii]:=Sub_Time(pGP_SCUD_Saldo.CH_MisConDuct[ii],Tmp_Scud_MisConDuct.tDiff);
              if TimeLog_Status>0
              { timelog(' удаляем нарушение');
              }
              delete current Tmp_Scud_MisConDuct;

            }
          }
          // надо убрать пометку дня если были нарушения в этот день
          if _boExist_M
          { if getfirst Tmp_Scud_MisConDuct where
            (( _cScud_Pers  == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
            and tmp_period.EventDate == Tmp_Scud_MisConDuct.DT_EV
            ))<>tsok
            { if  pos('/Н',pGP_SCUD_S_D.Calc_Days2[ii])>0
              { pGP_SCUD_S_D.Calc_Days2[ii]:=Replace(pGP_SCUD_S_D.Calc_Days2[ii],'/Н','');
                if TimeLog_Status>0
                { timelog(' убрали пометку');
                }
              }
            } //if getfirst Tmp_Scud_MisConDuct where
            else
            { if TimeLog_Status>0
              { timelog(' еще остались нарушения '
                 +', разница='+TimeToStr(Tmp_Scud_MisConDuct.tDiff,'HH:MM:SS:SSS')
                 +', время='+TimeToStr(Tmp_Scud_MisConDuct.TM_Ev,'HH:MM:SS:SSS')
                 +', тип '+string(Tmp_Scud_MisConDuct.wMisConDuct)
                );
              }

            } //else getfirst Tmp_Scud_MisConDuct where
          } //if _boExist_M
        } //if tmp_period.wType=1 or tmp_period.wType=2

        //если полностью лежит в исключении - удаляем
        if  tmp_period_work.EventTmb>=tmp_period.EventtmB
        and tmp_period_work.EventTmE<=tmp_period.EventtmE
        { if delete current tmp_period_work=tsok {};
          continue;
        }
        // Здесь еще можно исключить периоды
        if  tmp_period_work.EventTmb<tmp_period.EventtmB
        and tmp_period_work.EventTmE<tmp_period.EventtmE
        { tmp_period_work.EventTmE:=tmp_period.EventtmB;
          if update current tmp_period_work=tsok {};
        }
        else
        if  tmp_period_work.EventTmb>tmp_period.EventtmB
        and tmp_period_work.EventTmE>tmp_period.EventtmE
        { tmp_period_work.EventTmB:=tmp_period.EventtmE;
          if update current tmp_period_work=tsok {};
        }
        // Режем на куски
        else
        { tmp_period_work_d.buffer:=tmp_period_work.buffer;
          tmp_period_work_d.EventTmB:=tmp_period.EventtmE;
          if insert current tmp_period_work_d=tsok {};
          tmp_period_work.EventTmE:=tmp_period.EventtmB;
          if update current tmp_period_work=tsok {};
        }
      } //if getfirst tmp_period where ((
    } //_Loop fullcache tmp_period_work where ((
    //----------------------------------------------
    // рассчитаем сверхурочные и выходные
    //----------------------------------------------
    _wKateg:=GetKategType(GP_SCUD_Pers.cGp_Scud_Kateg);
    _Propusk_DTB:=GP_SCUD_Pers.PROPUSK_FROM;
    _Propusk_DTE:=GP_SCUD_Pers.PROPUSK_TO;
    //pGP_SCUD_Saldo.CH_Holiday_Opl:=0;


    //================================================
    // Финальный расчет
    For(ii:=iibeg;ii<=iiend;ii++)
    { // Сначала проверим на выходной
      Calc_Date:=date(ii,_wMonthRas,_wYearRas);
      //------------------------- если не было событий - обнулим
      if _dmEvExist[ii]=0  pGP_SCUD_Saldo.TMB[ii]:=Time(0,0,0,0);
      if Timelog_Status>0
      { Timelog('День '+string(ii)+', _dmEvExist[ii]='+string(_dmEvExist[ii])
          +', pGP_SCUD_Saldo.TMB[ii]='+TimeToStr(pGP_SCUD_Saldo.TMB[ii],'HH:MM')
          +', pGP_SCUD_Saldo.TMB[ii]='+TimeToStr(pGP_SCUD_Saldo.TME[ii],'HH:MM')
          +', Calc_Days2[ii]='+pGP_SCUD_S_D.Calc_Days2[ii]
          )

      }
      //-------------------------
      if getlast GP_SCUD_Pers_Hist=tsok
      {
#IFDEF GP_SCUD_EventsEdit_DEBUG
         if TimeLog_Status>0 timelog(' Нашли историю '+String(GP_SCUD_Pers_Hist.DtIzm)+','+string(GP_SCUD_Pers_Hist.PROPUSK_FROM) );
#endif
         if GP_SCUD_Pers_Hist.cGp_Scud_Kateg>0
          _wKateg:=GetKategType(GP_SCUD_Pers_Hist.cGp_Scud_Kateg);
         //if GP_SCUD_Pers_Hist.PROPUSK_FROM>_Propusk_DTB
         _Propusk_DTB:=GP_SCUD_Pers_Hist.PROPUSK_FROM;
         //if GP_SCUD_Pers_Hist.PROPUSK_TO<_Propusk_TO
         //or _Propusk_TO=ZeroDate
         _Propusk_DTE:=GP_SCUD_Pers_Hist.PROPUSK_TO;
      } //if getlast GP_SCUD_Pers_Hist=tsok
      // если нет пропуска, то входил по служебной записке
      if (_Propusk_DTB>=Calc_Date or _Propusk_DTB=ZeroDate)
      and pGP_SCUD_Saldo.CH_FactCh[ii]=0
      and pGP_SCUD_Saldo.CH_GrafCh[ii]>0
      { _wKateg:=10;
      }
      if _wKateg=0
      { _wKateg:=5;
      }
      //>>>>>>>>>>>>>>>> если в этот день нет периодов, то график считается неопределенным и нужно посмотреть заявления
      if pGP_SCUD_Saldo.CH_GrafCh[ii]>0
      {if pGRAFF_WorkPeriod.StartWorkDay[ii]=ZeroTime
       {if pGRAFF_WorkPeriod.EndWorkDay[ii]=ZeroTime
        {if pGRAFF_WorkPeriod.StartShift2[ii]=ZeroTime
         {if pGRAFF_WorkPeriod.EndShift2[ii]=ZeroTime
          { _Loop fullcache tmp_period where ((
              pGP_SCUD_Pers == tmp_period.cGP_SCUD_PERS
               and Calc_Date ==tmp_period.EventDate
              // только личное заявление или поручение руководителя
               and (tmp_period.wType=1 or tmp_period.wType=2 or tmp_period.wType=102)
            )) //=tsok
            { if TimeLog_Status>0
              { timelog('ищем периоды в заяв. за день '+String(ii)  );
                timelog('нашли периоды в заяв. для '+DateToStr(tmp_period.EventDate,'DD/MM/YYYY')
                               +TimeToStr(tmp_period.EventTmb,', HH:MM-')
                               +TimeToStr(tmp_period.EventTmE,'HH:MM')
               );
              }
              //------------------------------------
              //Вопрос - а надо ли добавлять часы
              //-----------------------------------
              if tmp_period.wType=1 or tmp_period.wType=2 or tmp_period.wType=102
              { diff_time:=Sub_Time(tmp_period.EventTmb,tmp_period.EventTmE);
                if tmp_period.wType<>102
                { pGP_SCUD_Saldo.CH_FactCh[ii]:=pGP_SCUD_Saldo.CH_FactCh[ii]+Hour(diff_time)+Minute(diff_time)/60;
                }
                else
                { pGP_SCUD_S_D.CH_FactCh_Excl[ii]:=pGP_SCUD_S_D.CH_FactCh_Excl[ii]+Hour(diff_time)+Minute(diff_time)/60;
                }
                if TimeLog_Status>0
                { timelog(' добавили к факту '+TimeToStr(diff_time,'HH:MM')
                    +', итого '+string(pGP_SCUD_Saldo.CH_FactCh[ii],0,2)
                    +', искл. '+string(pGP_SCUD_S_D.CH_FactCh_Excl[ii],0,2)
                    );
                }
              }
            }//_Loop fullcache tmp_period where ((
          }//if pGRAFF_WorkPeriod.EndShift2[ii]=ZeroTime
         }//if pGRAFF_WorkPeriod.StartShift2[ii]=ZeroTime
        }//if pGRAFF_WorkPeriod.EndWorkDay[ii]=ZeroTime
       } //if pGRAFF_WorkPeriod.StartWorkDay[ii]=ZeroTime
      } //if pGP_SCUD_Saldo.CH_GrafCh[ii]>0
      //<<<<<<<<<<<- если в этот день нет периодов, то график считается неопределенным и нужно посмотреть заявления

#IFDEF GP_SCUD_EventsEdit_DEBUG
      if TimeLog_Status>0 timelog('Расчет '+string(ii)+', Ф='+string(pGP_SCUD_Saldo.CH_FactCh[ii],0,2)
                +',П='+string(pGP_SCUD_Saldo.CH_GrafCh[ii],0,2)
                +',кат.='+string(_wKateg)
                +',отсут.в середине дня.='+string(pGP_SCUD_Saldo.CH_MisConDuct[ii])
                +',пропуск с '+string(_Propusk_DTB)
                +',Переработка '+string(pGP_SCUD_Saldo.CH_OverWork2[ii],0,2)
                );
#ENDIF
      //==============================
      var _CH:double=0;
      _CH:=Double(pGP_SCUD_Saldo.Days[ii]);
      //==============================
      //проверим нарушение отсутствия в середине дня
      // если выходил в сумме меньше, чем на 15 минут, грохнем
      if pGP_SCUD_Saldo.CH_MisConDuct[ii]>0
      { if pGP_SCUD_Saldo.CH_MisConDuct[ii]<=0.25
        { pGP_SCUD_Saldo.CH_FactCh[ii]:=pGP_SCUD_Saldo.CH_FactCh[ii]+pGP_SCUD_Saldo.CH_MisConDuct[ii];
          pGP_SCUD_Saldo.CH_MisConDuct[ii]:=0;
          delete Tmp_Scud_MisConDuct_F where ((
              _cScud_Pers == Tmp_Scud_MisConDuct_F.cGP_Scud_Pers
           and  _wYearRas   == Tmp_Scud_MisConDuct_F.YearN
           and  _wMonthRas  == Tmp_Scud_MisConDuct_F.MesN
           and  Calc_Date   == Tmp_Scud_MisConDuct_F.DT_Ev
           and  5           == Tmp_Scud_MisConDuct_F.wMisConDuct(noindex)
            )) ;
          // если  выходил, но в сумме меньше 15 минут, то желтым
          if  pos('/Н',pGP_SCUD_S_D.Calc_Days2[ii])=0
          and pos('/Н',pGP_SCUD_S_D.Calc_Days2[ii])=0
          { pGP_SCUD_S_D.Calc_Days2[ii]:=pGP_SCUD_S_D.Calc_Days2[ii]+'/НС';
          }
        }
        else
        { if  pos('/Н',pGP_SCUD_S_D.Calc_Days2[ii])=0
          //and pos('/ЗО',pGP_SCUD_S_D.Calc_Days2[ii])=0
          { if timelog_status>0
            { timelog(' ставим пометку нарушения по середине дня ');

            }
            pGP_SCUD_S_D.Calc_Days2[ii]:=pGP_SCUD_S_D.Calc_Days2[ii]+'/Н';
          }
        }
      }//if pGP_SCUD_Saldo.CH_MisConDuct[ii]>0
      if (pGP_SCUD_Saldo.CH_MisConDuct[ii]>0.25 //15 минут суммарно в течении
      or (pGP_SCUD_Saldo.CH_GrafCh[ii]-0.25>(pGP_SCUD_Saldo.CH_FactCh[ii]+pGP_SCUD_S_D.CH_FactCh_Excl[ii])) // можно и не считать
      ) and _wKateg=5
      and Calc_Date<_Cur_Date
      and (  pGP_SCUD_Saldo.CH_FactCh[ii]<>0 // невыходы потом поймаем.
          or pGP_SCUD_S_D.CH_FactCh_Excl[ii]<>0
          )
      //возможно нужно отнять из всех нарушений - вдруг не полностью
      and pGRAFF_WorkPeriod.RestDayOfHoliday[ii]=ZeroTime //не было отгулов
      and (not CheckDaysNotWork(ii)) //день рабочий
      { var _ch1:double=0;
        var _ch5:double=0;
        var _ch6:double=0;
        _ch1:=pGP_SCUD_Saldo.CH_GrafCh[ii] - (pGP_SCUD_Saldo.CH_FactCh[ii]+pGP_SCUD_S_D.CH_FactCh_Excl[ii]);
        // если были ранние уходы на обед или с работы можно их отнять
        _Loop Tmp_Scud_MisConDuct where
          (( _cScud_Pers  == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
          and Calc_Date == Tmp_Scud_MisConDuct.DT_EV
          // and (  Tmp_Scud_MisConDuct.wMisConDuct = 4
          //     or Tmp_Scud_MisConDuct.wMisConDuct = 2
          //     )
          ))
        {  if Tmp_Scud_MisConDuct.wMisConDuct=5 // учтем предыдущие выходы в середине дня
            _ch5:=_ch5+GetDoubleFromTime(Tmp_Scud_MisConDuct.tDiff)
           else
           { _ch :=_ch -GetDoubleFromTime(Tmp_Scud_MisConDuct.tDiff);
             //график -  прочие нарушения = нарушения середины дня
             _ch1:=_ch1 -GetDoubleFromTime(Tmp_Scud_MisConDuct.tDiff);
           }

        }
        //4:33 /НН/П0.55
        if _Ch1>0 //or _ch5>time(0,15,0,0)
        { var _sAbs:string='/НН';
          var _cStatement:comp=0;
          _Loop tmp_period where ((
            pGP_SCUD_Pers == tmp_period.cGP_SCUD_PERS
           and Calc_Date ==tmp_period.EventDate
           and (tmp_period.wType=3)
          ))
          { _cStatement:=tmp_period.cStatement;
            _ch6:=_ch6+GetDoubleFromTime(tmp_period.PlanTime);
          }
          if _ch6>=_Ch1
          { _sAbs:='/ЗО';
            if pos('/Н',pGP_SCUD_S_D.Calc_Days2[ii])>0
            { pGP_SCUD_S_D.Calc_Days2[ii]:=Replace(pGP_SCUD_S_D.Calc_Days2[ii],'/Н','')
            }
            if pos(_sAbs,pGP_SCUD_S_D.Calc_Days2[ii])=0
              pGP_SCUD_S_D.Calc_Days2[ii]:=pGP_SCUD_S_D.Calc_Days2[ii]+_sAbs;
          }
          else
          { if  pos('/Н',pGP_SCUD_S_D.Calc_Days2[ii])=0
            and pos(_sAbs,pGP_SCUD_S_D.Calc_Days2[ii])=0
            { //Calc_Days2[ii]:=pGP_SCUD_S_D.Calc_Days2[ii]+'/НС';
              pGP_SCUD_S_D.Calc_Days2[ii]:=pGP_SCUD_S_D.Calc_Days2[ii]+_sAbs;
            }
          }
          //если остались не учтенные часы, кинем их в нарушение
          if  _Ch1-_Ch5>0 //рабочие часы - ( выходы в середине дня + прочие нарушения)
          insert into Tmp_Scud_MisConDuct set
                  Tmp_Scud_MisConDuct.cMisConDuct:= _cStatement //iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeNrec(_wMisConDuct)
                , Tmp_Scud_MisConDuct.wMisConDuct:= 5 // Отсутствие в середине дня.
                , Tmp_Scud_MisConDuct.cGP_SCUD_PERS:=_cScud_Pers
                , Tmp_Scud_MisConDuct.MesN  :=_wMonthRas
                , Tmp_Scud_MisConDuct.YearN :=_wYearRas
                , Tmp_Scud_MisConDuct.DT_Ev :=date(ii,wMonthRas,wYearRas)
                , Tmp_Scud_MisConDuct.TM_Ev :=ZeroTime
                , Tmp_Scud_MisConDuct.tDiff :=GetTimeFromDouble(_ch1-_ch5) // нужно уточнить...
                ;
        } //if _Ch>0
      }  //if (Calc_MisConDuct[ii]>0.25 //15 минут суммарно в течении
      // если были исключения
      else
      { //Удалим нарушения середины дня?


        // если нет периодов - заменим на З - были заявления
        if Getfirst  tmp_period_work where ((
             pGP_SCUD_Pers == tmp_period_work.cGP_SCUD_PERS
         and Calc_Date     == tmp_period_work.EventDate
         ))<>tsok
        { pGP_SCUD_S_D.Calc_Days2[ii]:=Replace(pGP_SCUD_S_D.Calc_Days2[ii],'/Н','/ЗО');

        }
      }
      //--------------------------------
      // проверим прочие нарушения - остались ли
      if getfirst Tmp_Scud_MisConDuct where
         (( _cScud_Pers  == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
            and Calc_Date == Tmp_Scud_MisConDuct.DT_EV
          ))<>tsok
      { var _iPos:word= pos('/Н',pGP_SCUD_S_D.Calc_Days2[ii]);
        if _iPos>0
        if substr(pGP_SCUD_S_D.Calc_Days2[ii],_iPos,10)='/Н'
        { pGP_SCUD_S_D.Calc_Days2[ii]:=Replace(pGP_SCUD_S_D.Calc_Days2[ii],'/Н','');
          if TimeLog_Status>0
          { timelog(' убрали пометку при проверке по дням');
          }
        }
      } //if getfirst Tmp_Scud_MisConDuct where


      //-------------
      // Выходные по 71 приказу
      if pGP_SCUD_Saldo.Days[ii]='НВ'
      { pGP_SCUD_Saldo.CH_Holiday_Opl:=pGP_SCUD_Saldo.CH_Holiday_Opl+10000;//pGP_SCUD_Saldo.CH_GrafCh[ii];
      }
      else
      if pGRAFF_WorkPeriod.RestDayOfHoliday[ii]<>ZeroTime
      { pGP_SCUD_Saldo.CH_Holiday_Opl:=pGP_SCUD_Saldo.CH_Holiday_Opl+10000;//pGP_SCUD_Saldo.CH_GrafCh[ii];
      }
      //-------------
      // Выходные
      if pGP_SCUD_Saldo.CH_GrafCh[ii]=0
      {
        case NPOEM_OWN_SCUD_Vactions_Control of
        //В табель падает макс. 6 часов в день
        //Нельзя сразу привлекать на 2 выходных (если за 2 дня подряд больше 6 часов, то в переработку идет время)
        //Все что больше 6 часов работы в день идет в переработку
        0:
        { if pGP_SCUD_Saldo.CH_FactCh[ii]>6
          { pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_Overwork2[ii]+(pGP_SCUD_Saldo.CH_FactCh[ii])-6;
            pGP_SCUD_Saldo.CH_Holiday [ii]:=6;
          }
          else
          { pGP_SCUD_Saldo.CH_Holiday [ii]:=pGP_SCUD_Saldo.CH_Holiday [ii]+pGP_SCUD_Saldo.CH_FactCh[ii];
          }
          // проверим предыдущий день
          if ii>1
          { if pGP_SCUD_Saldo.CH_Holiday [ii-1]+pGP_SCUD_Saldo.CH_Holiday [ii]>6
            { pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_Overwork2[ii]
                      +pGP_SCUD_Saldo.CH_Holiday [ii]+pGP_SCUD_Saldo.CH_Holiday [ii-1]-6;
              pGP_SCUD_Saldo.CH_Holiday [ii]:=6-pGP_SCUD_Saldo.CH_Holiday [ii-1];
            }
          }
        } //0 case NPOEM_OWN_SCUD_Vactions_Control of
        //1.Если отработал 4 часа, то ставим 4 часа. Если 4 часа 20 минут, то ставим 4 часа.
        //если 4 часа 40минут, то ставим  4 часа 10 минут. Т.е. вычитаем 30 минут из работы,
        //но если более 4 часов (типа обед у него)
        //2.Снимаем ограничение в 6 часов при работе в выходной день, ставим как есть (с учетом 1 пункта)
        1:
        { if pGP_SCUD_Saldo.CH_FactCh[ii]>4.5
          { pGP_SCUD_Saldo.CH_Holiday [ii]:=pGP_SCUD_Saldo.CH_FactCh[ii]-0.5;
          }
          else
          if pGP_SCUD_Saldo.CH_FactCh[ii]<=4.5 and pGP_SCUD_Saldo.CH_FactCh[ii]>=4
          { pGP_SCUD_Saldo.CH_Holiday [ii]:=4;
          }
          else
          { pGP_SCUD_Saldo.CH_Holiday [ii]:=pGP_SCUD_Saldo.CH_FactCh[ii];
          }
        } //1 case NPOEM_OWN_SCUD_Vactions_Control of
        end;//case NPOEM_OWN_SCUD_Vactions_Control of

//20210304 lapushkov_dv
        if pGP_SCUD_Saldo.CH_Holiday [ii] = 0 // если по СКУД нет проходов, но есть приказ, то возьмем из приказа часы
        {
         if TimeLog_Status>0  Timelog('  в выходные нет событий -> поищем в приказе утвержденном');
           var   _dateVacation : date = date(ii,pGP_SCUD_Saldo.Mesn,pGP_SCUD_Saldo.YEARN);
           var _cPersonVacation : comp = GetPersons(pGP_SCUD_Saldo.CGP_SCUD_PERS) ;
           var _ChasFromPrikaz : double = 0;
           // по идее можно переделать так: на месяц сразу всех выбирать... но в продакшне этого не должно быть - авсе по скуд должны работаьт
          _Try
           {
             sql
              select
               SalScale.FSUM0
              from Titledoc
              join partdoc on partdoc.CDOC = titledoc.nrec and partdoc.TYPEOPER = 90
              join Contdoc on Contdoc.cpart = partdoc.nrec and Contdoc.PERSON = :(_cPersonVacation)
              join SalScale on SalScale.FILIALNO = 1 and SalScale.CUNIT = contdoc.nrec and SalScale.LASTDATE = :(_dateVacation)
              where titledoc.WSTATUS = 1
             into (_ChasFromPrikaz)
             ;
           }
            _Except
            else{}
           _Finally{}
           if TimeLog_Status>0  Timelog('  в выходные нет событий -> в приказе утвержденном нашли часов ' + _ChasFromPrikaz);
         pGP_SCUD_Saldo.CH_Holiday[ii] := _ChasFromPrikaz;
        }
//20210304 lapushkov_dv end

        if TimeLog_Status>0 timelog('Выходные '+string(ii)+', Ф='+string(pGP_SCUD_Saldo.CH_FactCh[ii],0,2)
                      +', В='+string(pGP_SCUD_Saldo.CH_Holiday [ii],0,2))  ;

        if _wTypeRas>0 and (ii<>_DayCalc)
        { var _all_ch:double=0;
          _Loop tmp_period_Order where ((
             GP_SCUD_Pers.Nrec     == tmp_period_order.cGP_Scud_Pers
           and Calc_Date           == tmp_period_order.EventDate
           and GP_iSC_OrderHoliday == tmp_period_order.wType
          ))
          { _all_ch:=_all_ch+tmp_period_order.diff;
            /*
            РВ соберем ниже вместе с часами
            if pGP_SCUD_Saldo.CH_Holiday [ii]>0
            if tmp_period_order.wOpl<>1 then
            { pGP_SCUD_Saldo.CH_Holiday_Opl:=pGP_SCUD_Saldo.CH_Holiday_Opl
                      //+tmp_period_order.diff
                      + 10000;
            }
            */
          }
          if _all_ch<pGP_SCUD_Saldo.CH_Holiday [ii]
          { if pGP_SCUD_Saldo.CH_Holiday [ii]-_all_ch>0.01
            { //Нахождение на работе во время выходных, отпусков, больничных, донорских, командировок не считается переработкой,
              //pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_Overwork2[ii]+pGP_SCUD_Saldo.CH_Holiday [ii]-_all_ch;
            }
            pGP_SCUD_Saldo.CH_Holiday [ii]:=_all_ch;
          }
        if TimeLog_Status>0 timelog('Выходные 2 '+string(ii)+', Ф='+string(pGP_SCUD_Saldo.CH_FactCh[ii],0,2)
                      +', В='+string(pGP_SCUD_Saldo.CH_Holiday [ii],0,2))
        } //if _wTypeRas=1
      } //if Calc_GrafCh[ii]=0
      else  // лови сверхурочные
      { //только для 5 категории
        if ((_wKateg<>5 and _wKateg<>3 and _wKateg<>6)
        or Calc_Date>_Cur_Date //на текущую дату нет событий
        ) and _CH>0
        { pGP_SCUD_Saldo.CH_FactCh[ii]:=pGP_SCUD_Saldo.CH_GrafCh[ii];
        }
        if TimeLog_Status>0 timelog('Расчет 2 '+string(ii)+', Ф='+string(pGP_SCUD_Saldo.CH_FactCh[ii],0,2)
                +',П='+string(pGP_SCUD_Saldo.CH_GrafCh[ii],0,2)
                +',кат.='+string(_wKateg)
                +','+DateToStr(_Cur_Date,'DD/MM/YYYY') );
        // просто чтобы иметь возможность прервать
        do {
          if pGP_SCUD_Saldo.CH_FactCh[ii]-0.25<=pGP_SCUD_Saldo.CH_GrafCh[ii]
          and pGP_SCUD_Saldo.CH_FactCh[ii]>=pGP_SCUD_Saldo.CH_GrafCh[ii]
          { //Это присутствие на работе вне графика, исключая обед, более 15 минут. Нахождение на работе во время

            pGP_SCUD_Saldo.CH_FactCh[ii]:=pGP_SCUD_Saldo.CH_GrafCh[ii];
            break;
          }
          //Если человек отработал более 4 часов по факту,
          //то сверхурочные работы - только первые 4 часы, остальное учитывается как переработка,
          if pGP_SCUD_Saldo.CH_FactCh[ii]>pGP_SCUD_Saldo.CH_GrafCh[ii]
          { //20180822 нужно учитывать только переработку после
            var _ch_over:double=pGP_SCUD_Saldo.CH_FactCh[ii]-(pGP_SCUD_Saldo.CH_GrafCh[ii]+_CH_Fact_Before[ii]);
            if _ch_over<0 _ch_over:=0;
            if _ch_over>4
            { pGP_SCUD_Saldo.CH_Overwork [ii]:=4;
              if NPOEM_OWN_SCUD_OVER2_Type=0
                pGP_SCUD_Saldo.CH_Overwork2[ii]:=(_ch_over)-4;
            }
            else
            { pGP_SCUD_Saldo.CH_Overwork[ii]:=_ch_over;
            }
            if TimeLog_Status>0
            { timelog('СВ 001='+string(pGP_SCUD_Saldo.CH_Overwork [ii],0,2));
            }


            if _wTypeRas>0
            { var _all_ch:double=0;
              _Loop tmp_period_Order where ((
               GP_SCUD_Pers.Nrec     == tmp_period_order.cGP_Scud_Pers
               and Calc_Date         == tmp_period_order.EventDate
               and GP_iSC_OrderOver  == tmp_period_order.wType
              ))
              { _all_ch:=_all_ch+tmp_period_order.diff;
                if TimeLog_Status>0
                { timelog('СВ ORDER='+string(_all_ch,0,2));
                }

              }
              if (ii<>_DayCalc) or (_wTypeRas=4)
              { if _all_ch<pGP_SCUD_Saldo.CH_Overwork [ii]
                { if NPOEM_OWN_SCUD_OVER2_Type=0
                  if pGP_SCUD_Saldo.CH_Overwork [ii]-_all_ch>0.01
                  { pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_Overwork2[ii]
                     +pGP_SCUD_Saldo.CH_Overwork [ii]-_all_ch;
                  }
                  if NPOEM_OWN_SCUD_OVER2_Type=1
                    pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_Overwork2[ii]-_all_ch;
                  pGP_SCUD_Saldo.CH_Overwork [ii]:=_all_ch;
                }
              }
              else
              { pGP_SCUD_Saldo.CH_Overwork [ii]:=pGP_SCUD_Saldo.CH_Overwork [ii]-_all_ch;
                if pGP_SCUD_Saldo.CH_Overwork [ii]<0
                  pGP_SCUD_Saldo.CH_Overwork [ii]:=0;
              }
            } //if _wTypeRas=1
            // если оформляют приказ задним числом после утвержденного
            if pGP_SCUD_Saldo.CH_Overwork[ii]>0 and ii>1
            // если вдруг есть утвержденный приказ после даты расчета текущего
            // то не будем тут уменьшать сверхурочку, а возьмем из приказа
            { if (pGP_SCUD_Saldo.CH_Overwork [ii-1]+pGP_SCUD_Saldo.CH_Overwork [ii])>4
              { if _DayCalc=0 or ii<>_DayCalc+1 or _wTypeRas=4
                { case NPOEM_OWN_SCUD_OVER2_Type of
                  0:
                  { pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_Overwork2[ii]
                        +pGP_SCUD_Saldo.CH_Overwork [ii]+pGP_SCUD_Saldo.CH_Overwork [ii-1]-4;
                  }
                  end;
                  pGP_SCUD_Saldo.CH_Overwork [ii]:=4-pGP_SCUD_Saldo.CH_Overwork [ii-1];
                }
                else if _DayCalc<>0 and ii=_DayCalc+1
                { case NPOEM_OWN_SCUD_OVER2_Type of
                  0:
                  {  pGP_SCUD_Saldo.CH_Overwork2[ii-1]:=pGP_SCUD_Saldo.CH_Overwork2[ii-1]
                        +pGP_SCUD_Saldo.CH_Overwork [ii]+pGP_SCUD_Saldo.CH_Overwork [ii-1]-4;
                  }
                  end;
                  pGP_SCUD_Saldo.CH_Overwork [ii-1]:=4-pGP_SCUD_Saldo.CH_Overwork [ii];
                }
              }
              if TimeLog_Status>0
              { timelog('СВ 002='+string(pGP_SCUD_Saldo.CH_Overwork [ii],0,2));
              }
            } //if pGP_SCUD_Saldo.CH_Overwork[ii]>0 and ii>1

            if TimeLog_Status>0
            { timelog('СВ final='+string(pGP_SCUD_Saldo.CH_Overwork [ii],0,2)
                      +','+string(pGP_SCUD_Saldo.CH_Overwork2 [ii],0,2));
            }
          } //if Calc_FactCh[ii]>Calc_GrafCh[ii]
        } while false;
      } //else if Calc_GrafCh[ii]=0
#IFDEF GP_SCUD_EventsEdit_DEBUG
      if TimeLog_Status>0 timelog(' ii='+string(ii)+' Days[ii]='+pGP_SCUD_Saldo.Days[ii]+','+string(pGP_SCUD_Saldo.CH_FactCH[ii]));
#ENDIF
      if _CH>0
      or   ( pGP_SCUD_Saldo.Days[ii]='К'
         and pGP_SCUD_Saldo.CH_GrafCh[ii]>0
         and pGP_SCUD_Saldo.CH_FactCH[ii]>0
         ) // Заменим на факт
      { // если это рабочий день по графику, а факт насчитали больше, чем график + переработка
        if pGP_SCUD_Saldo.CH_GrafCh[ii]>0
        { if pGP_SCUD_Saldo.CH_FactCh[ii]> pGP_SCUD_Saldo.CH_GrafCh[ii]+pGP_SCUD_Saldo.CH_Holiday [ii]
                                       +pGP_SCUD_Saldo.CH_OverWork [ii]
                                       +pGP_SCUD_Saldo.CH_OverWork2[ii]
          { pGP_SCUD_Saldo.CH_FactCh[ii]:=pGP_SCUD_Saldo.CH_GrafCh[ii]+pGP_SCUD_Saldo.CH_Holiday [ii]
                                       +pGP_SCUD_Saldo.CH_OverWork [ii]
                                       +pGP_SCUD_Saldo.CH_OverWork2[ii];
          }
        } //if pGP_SCUD_Saldo.CH_GrafCh[ii]>0
        if pGP_SCUD_Saldo.CH_FactCH[ii]>0
        { if _CH>0
            pGP_SCUD_Saldo.Days[ii]:=GetTimeStrFromDouble(pGP_SCUD_Saldo.CH_FactCH[ii])
          else
            pGP_SCUD_Saldo.Days[ii]:=pGP_SCUD_Saldo.Days[ii]+','+GetTimeStrFromDouble(pGP_SCUD_Saldo.CH_FactCH[ii])
        }
        else
        { if _wKateg=5
          or _wKateg=6
          or _wKateg=3// нет ни одного прохода - нарушение!
          if pGRAFF_WorkPeriod.RestDayOfHoliday[ii]=ZeroTime //нет "ОТГ" по 91 приказу
          if  pGP_SCUD_Saldo.CH_GrafCH[ii]>0  // только если по графику положено
          and pGP_SCUD_Saldo.Days[ii]<>'НН' //если внесли в табель, то не будем делать нарушение
          if pGP_SCUD_S_D.CH_FactCh_Excl[ii]>=pGP_SCUD_Saldo.CH_GrafCH[ii]
          { pGP_SCUD_Saldo.Days[ii]:='0:00';//+'('+pGP_SCUD_Saldo.Days[ii]+')';
          }
          else
          { pGP_SCUD_Saldo.Days[ii]:='/Н';
            var _cStatement:comp=0;
            var _ch_progul:double=0;
            _Loop tmp_period where ((
             pGP_SCUD_Pers == tmp_period.cGP_SCUD_PERS
             and Calc_Date ==tmp_period.EventDate
             and (tmp_period.wType=3)
              ))
            { _cStatement:=tmp_period.cStatement;
              _ch_progul:=_ch_progul+GetDoubleFromTime(tmp_period.PlanTime);
            }
            if _ch_progul>=pGP_SCUD_Saldo.CH_GrafCH[ii]
            { pGP_SCUD_Saldo.Days[ii]:='ЗО';
            }
            else _cStatement:=0;

            insert into Tmp_Scud_MisConDuct set
                  Tmp_Scud_MisConDuct.cMisConDuct:= _cStatement //iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeNrec(_wMisConDuct)
                , Tmp_Scud_MisConDuct.wMisConDuct:= 6 // Прогул
                , Tmp_Scud_MisConDuct.cGP_SCUD_PERS:=_cScud_Pers
                , Tmp_Scud_MisConDuct.MesN  :=_wMonthRas
                , Tmp_Scud_MisConDuct.YearN :=_wYearRas
                , Tmp_Scud_MisConDuct.DT_Ev :=date(ii,wMonthRas,wYearRas)
                , Tmp_Scud_MisConDuct.TM_Ev :=pGRAFF_WorkPeriod.StartWorkDay[ii]
                , Tmp_Scud_MisConDuct.tDiff :=GetTimeFromDouble(pGP_SCUD_Saldo.CH_GrafCh[ii]);
                ;
          } //if pGP_SCUD_Saldo.CH_GrafCH[ii]>0
        } //else if pGP_SCUD_Saldo.CH_FactCH[ii]<>0
#IFDEF GP_SCUD_Head_View_DEBUG_2
 if TimeLog_Status>0 timelog('---------------6- '  +GP_SCUD_Pers.Fio + ' -- ' + Calc_Date );
#_outLog (_cScud_Pers)
#ENDIF
      } //if _CH>0
      else
      { pGP_SCUD_S_D.Calc_Days2[ii]:='';
      }
      if pGP_SCUD_S_D.Calc_Days2[ii]<>''
      { if pGP_SCUD_S_D.Calc_Days2[ii]='/Н' and pGP_SCUD_Saldo.Days[ii]='НН'  pGP_SCUD_Saldo.Days[ii]:='НН'
        else  pGP_SCUD_Saldo.Days[ii]:=pGP_SCUD_Saldo.Days[ii]+' '+pGP_SCUD_S_D.Calc_Days2[ii]
      }
      if pGP_SCUD_Saldo.CH_Overwork [ii]>0
      { pGP_SCUD_Saldo.CH_Over_Cur:=pGP_SCUD_Saldo.CH_Over_Cur+pGP_SCUD_Saldo.CH_Overwork [ii];
        if pGP_SCUD_SALDO.CH_Over_Ost+pGP_SCUD_Saldo.CH_Over_Cur>120
        { var _delta:double=pGP_SCUD_SALDO.CH_Over_Ost+pGP_SCUD_Saldo.CH_Over_Cur-120;
          if _delta>pGP_SCUD_Saldo.CH_Overwork  [ii]
            _delta:=pGP_SCUD_Saldo.CH_Overwork  [ii];
          pGP_SCUD_Saldo.CH_Overwork [ii]:=pGP_SCUD_Saldo.CH_Overwork  [ii]-_delta;
          pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_Overwork2 [ii]+_delta;
          pGP_SCUD_Saldo.CH_Over_Cur:=pGP_SCUD_Saldo.CH_Over_Cur-_delta;
        }
        pGP_SCUD_Saldo.Days[ii]:=pGP_SCUD_Saldo.Days[ii]+'/СВ '+string(pGP_SCUD_Saldo.CH_Overwork [ii],0,2);
      }
      //------------------------------------------
      // нужно поймать отрицательные итоги по переработке
      // Если с учетом заявления переработки меньше 0, то убираем
      if pGP_SCUD_Saldo.CH_Overwork2[ii]<0
      //20180911 - если отработал меньше графика то переработки быть не может
      or (pGP_SCUD_Saldo.CH_FactCh[ii]<pGP_SCUD_Saldo.CH_GrafCh[ii] )
        pGP_SCUD_Saldo.CH_Overwork2[ii]:=0;
      //-------------------------------------
      // если превышение меньше 15 минут - то 0.
      if pGP_SCUD_Saldo.CH_Overwork2[ii] <=0.25//15 минут
      //and pGP_SCUD_Saldo.Days[ii]<>'ОЖ' and pGP_SCUD_Saldo.Days[ii]<>'ОТ' and pGP_SCUD_Saldo.Days[ii]<>'Б'
      //and pGP_SCUD_Saldo.Days[ii]<>'К'
      { pGP_SCUD_Saldo.CH_Overwork2[ii]:=0;
      }
      else
      { // Переработки не должно быть больше факта - графика. Заявления идут в факт.
        if pGP_SCUD_Saldo.CH_Overwork2[ii]>(pGP_SCUD_Saldo.CH_FactCh[ii]-pGP_SCUD_Saldo.CH_GrafCH[ii])
          if pGP_SCUD_Saldo.CH_FactCh[ii]-pGP_SCUD_Saldo.CH_GrafCH[ii]>0
            pGP_SCUD_Saldo.CH_Overwork2[ii]:=pGP_SCUD_Saldo.CH_FactCh[ii]-pGP_SCUD_Saldo.CH_GrafCH[ii];
      }
      pGP_SCUD_Saldo.CH_Over2_Cur:=pGP_SCUD_Saldo.CH_Over2_Cur+pGP_SCUD_Saldo.CH_Overwork2 [ii];
      if pGP_SCUD_Saldo.CH_OverWork2 [ii]>0
      { pGP_SCUD_Saldo.Days[ii]:=pGP_SCUD_Saldo.Days[ii]+'/П'+string(pGP_SCUD_Saldo.CH_Overwork2 [ii],0,2);
      }
      //--------------------------



      if pGP_SCUD_Saldo.CH_Holiday [ii]>0
      {
        pGP_SCUD_Saldo.CH_Holiday_Cur:=pGP_SCUD_Saldo.CH_Holiday_Cur+pGP_SCUD_Saldo.CH_Holiday [ii]+10000;
        if timelog_Status>0
        { timelog('Учли выходные ii='+String(ii)+',pGP_SCUD_Saldo.CH_Holiday_Cur='+string(pGP_SCUD_Saldo.CH_Holiday_Cur,0,2));

        }
        //было pGP_SCUD_Saldo.CH_Holiday_Opl:=pGP_SCUD_Saldo.CH_Holiday_Opl+pGP_SCUD_Saldo.CH_Holiday [ii]
        if getfirst tmp_period_Order where ((
             GP_SCUD_Pers.Nrec     == tmp_period_order.cGP_Scud_Pers
           and Calc_Date           == tmp_period_order.EventDate
           and GP_iSC_OrderHoliday == tmp_period_order.wType
          ))=tsok
        { pGP_SCUD_Saldo.Days[ii]:=pGP_SCUD_Saldo.Days[ii]+'/'+if(tmp_period_order.wOpl=1,'РО','РВ')
             +' '+string(pGP_SCUD_Saldo.CH_Holiday [ii],0,2);
          if tmp_period_order.wOpl<>1 //РВ
          { pGP_SCUD_Saldo.CH_Holiday_Opl:=pGP_SCUD_Saldo.CH_Holiday_Opl+pGP_SCUD_Saldo.CH_Holiday [ii]+10000;
            if timelog_Status>0
            { timelog('Учли РВ в использовании ii='+String(ii)+',pGP_SCUD_Saldo.CH_Holiday_Opl='+string(pGP_SCUD_Saldo.CH_Holiday_Opl,0,2));
            }
          }
        }
      } //if pGP_SCUD_Saldo.CH_Holiday [ii]>0
      var _su:double;
      pGP_SCUD_Saldo.CH_Fact_All:=pGP_SCUD_Saldo.CH_Fact_ALL+pGP_SCUD_Saldo.CH_FactCh[ii];
      if _wKateg=10 // без пропуска
       if pGP_SCUD_Saldo.CH_FactCh[ii]>0
         pGP_SCUD_Saldo.Days[ii]:=pGP_SCUD_Saldo.Days[ii]+'/бп'
    } //For(ii:=1;ii<=31;ii++)
    pGP_SCUD_Saldo.sMisConduct:='';
    For(ii:=iibeg;ii<=iiend;ii++)
    { if pos('НН',pGP_SCUD_Saldo.Days[ii])>0 or pos('/Н',pGP_SCUD_Saldo.Days[ii])>0
        pGP_SCUD_Saldo.sMisConduct:=pGP_SCUD_Saldo.sMisConduct+string(ii)+';';
    }
    PGP_SCUD_Saldo.CH_Over_Cur    := Round(PGP_SCUD_Saldo.CH_Over_Cur,2);
    PGP_SCUD_Saldo.CH_Over2_Cur   := Round(PGP_SCUD_Saldo.CH_Over2_Cur,2);
    PGP_SCUD_Saldo.CH_Holiday_Cur := Round(PGP_SCUD_Saldo.CH_Holiday_Cur,2);


    //------------------------------------
    // формируем сальдо за месяц - всегда
    //-----------------------------------
    if UP_ZAR_WT_PROTECTUPTODATE<=date(1,_wMonthRas,_wYearRas)  and (_DayCalc=0 or  _wTypeRas=4)
    //if (_wYearRas>YearRas or _wMonthRas>=MonthRas) _wYearRas>=YearRas
    { var buf:Type$GP_SCUD_SALDO ;
      if iGP_SCUD_SaldoEdit.GetSaldoBuf(pGP_SCUD_Pers,_wYearRas,_wMonthRas,false,buf)
      {  var _pNrec:comp=buf.Nrec;
         /*
         if _wMonthRas<>1
         buf.CH_Over_Ost    :=pGP_SCUD_SALDO.CH_Over_Ost;// "Сверхурочные, остаток на начало"
         buf.CH_Over_Cur    :=pGP_SCUD_Saldo.CH_Over_Cur;// "Сверхурочные, тек.месяц"
         //buf.CH_Over_Opl    :=;// "Сверхурочные, оплачено"
         buf.CH_Over2_Ost   :=pGP_SCUD_SALDO.CH_Over2_Ost;// "Переработка, остаток на начало"
         buf.CH_Over2_Cur   :=pGP_SCUD_Saldo.CH_Over2_Cur;// "Переработка, тек.мес"
         //buf.CH_Over2_Opl   :=;// "Переработка, оплачено"
         buf.CH_Holiday_Ost :=pGP_SCUD_SALDO.CH_Holiday_Ost;// "Выходные, остаток на начало"
         buf.CH_Holiday_Cur :=pGP_SCUD_Saldo.CH_Holiday_Cur;// "Выходные, тек.мес"
         //buf.CH_Holiday_Opl :=;// "Выходные, оплачено"
         */

         PGP_SCUD_Saldo.CH_Over_Opl    := buf.CH_Over_Opl;
         PGP_SCUD_Saldo.CH_Over2_Opl   := buf.CH_Over2_Opl;
         //-----------------------
         //PGP_SCUD_Saldo.CH_Holiday_Opl := buf.CH_Holiday_Opl;
         ii:=iGP_SCUD_SaldoEdit.GetDaysFromSum(PGP_SCUD_Saldo.CH_Holiday_Opl);
         if ii>0
         { if timelog_status>0 // корректируем остаток на работу в выходной в часах
           { timelog('Пересчет учтенных отгулов за работу в выходной PGP_SCUD_Saldo.CH_Holiday_Opl='
             + string(PGP_SCUD_Saldo.CH_Holiday_Opl,0,2)+',ii='+string(ii)
             );

           }
           var _ostd:longint=iGP_SCUD_SaldoEdit.GetDaysFromSum(pGP_SCUD_Saldo.CH_Holiday_Cur+pGP_SCUD_SALDO.CH_Holiday_Ost);
           var _osth:double =iGP_SCUD_SaldoEdit.GetHourFromSum(pGP_SCUD_Saldo.CH_Holiday_Cur+pGP_SCUD_SALDO.CH_Holiday_Ost);
           if _ostd>0
           { PGP_SCUD_Saldo.CH_Holiday_Opl:=ii*10000+Round(ii*_osth/_ostd,4);
           }
           timelog('После пересчета PGP_SCUD_Saldo.CH_Holiday_Opl='
             + string(PGP_SCUD_Saldo.CH_Holiday_Opl,0,2)+',_ostd='+string(_ostd)+', _osth='+string(_osth,0,4)
             );
         }
         buf:=PGP_SCUD_Saldo;
         buf.Nrec:=_pNrec;
         iGP_SCUD_SaldoEdit.SetSaldoBuf(buf);
         if Timelog_Status>0 timelog('saldo._Over='+string(buf.CH_Over_Ost,0,2)+', _Over2='+string(buf.CH_Over2_Ost,0,2)+', _Holiday='+string(buf.CH_Holiday_Ost,0,2));

      }
      // сначала удалим
      ReReadRecord(#Tmp_Scud_MisConDuct_F);
      _Loop fullcache  GP_SCUD_MisCon_D where ((
           _cScud_Pers == GP_SCUD_MisCon_D.cGP_SCUD_PERS
      and  _wYearRas   == GP_SCUD_MisCon_D.YearN
      and  _wMonthRas  == GP_SCUD_MisCon_D.MesN
      ))
      { if _wTypeRas=4
        { if day(GP_SCUD_MisCon_D.DT_Ev)<>_DayCalc continue;
        }
        if GP_SCUD_MisCon_D.DT_Ev=ZeroDate
        or GP_SCUD_MisCon_D.wMisConDuct=0
        or GP_SCUD_MisCon_D.tDiff<time(0,0,0,30)
        { //фиг знает откуда появляется - может в табеле?
          if delete current GP_SCUD_MisCon_D<>tsok {};

        }
        else
        if getfirst Tmp_Scud_MisConDuct_F where ((
              GP_SCUD_MisCon_D.cGP_SCUD_PERS/== Tmp_Scud_MisConDuct_F.cGP_Scud_Pers
         and  GP_SCUD_MisCon_D.YearN        /== Tmp_Scud_MisConDuct_F.YearN
         and  GP_SCUD_MisCon_D.MesN         /== Tmp_Scud_MisConDuct_F.MesN
         and  GP_SCUD_MisCon_D.DT_Ev        /== Tmp_Scud_MisConDuct_F.DT_Ev
         and  GP_SCUD_MisCon_D.TM_Ev        /== Tmp_Scud_MisConDuct_F.TM_Ev
         and  GP_SCUD_MisCon_D.wMisConDuct  /== Tmp_Scud_MisConDuct_F.wMisConDuct(noindex)
        ))<>tsok

        {  if delete current GP_SCUD_MisCon_D<>tsok {};
        }
      }
      _Loop Tmp_Scud_MisConDuct where ((
           _cScud_Pers == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
      and  _wYearRas   == Tmp_Scud_MisConDuct.YearN
      and  _wMonthRas  == Tmp_Scud_MisConDuct.MesN
      ))
      { if Tmp_Scud_MisConDuct.tDiff<time(0,0,0,30) continue;
        if getfirst GP_SCUD_MisCon_D<>tsok
        { insert into GP_SCUD_MisCon_D set
            GP_SCUD_MisCon_D.cGP_SCUD_PERS  := Tmp_Scud_MisConDuct.cGP_Scud_Pers
           ,GP_SCUD_MisCon_D.YearN          := Tmp_Scud_MisConDuct.YearN
           ,GP_SCUD_MisCon_D.MesN           := Tmp_Scud_MisConDuct.MesN
           ,GP_SCUD_MisCon_D.DT_Ev          := Tmp_Scud_MisConDuct.DT_Ev
           ,GP_SCUD_MisCon_D.TM_Ev          := Tmp_Scud_MisConDuct.TM_Ev
           ,GP_SCUD_MisCon_D.wMisConDuct    := Tmp_Scud_MisConDuct.wMisConDuct
           ,GP_SCUD_MisCon_D.cMisConDuct    := Tmp_Scud_MisConDuct.cMisConDuct
           ,GP_SCUD_MisCon_D.tDiff          := Tmp_Scud_MisConDuct.tDiff
          ;
        }
        else
        { if GP_SCUD_MisCon_D.tDiff<>Tmp_Scud_MisConDuct.tDiff
          or GP_SCUD_MisCon_D.cMisConDuct <> Tmp_Scud_MisConDuct.cMisConDuct
          { update current GP_SCUD_MisCon_D set
             GP_SCUD_MisCon_D.tDiff        := Tmp_Scud_MisConDuct.tDiff
            ,GP_SCUD_MisCon_D.cMisConDuct  := Tmp_Scud_MisConDuct.cMisConDuct
             ;
          }
        } //else if getfirst GP_SCUD_MisCon_D<>tsok
      } //_Loop Tmp_Scud_MisConDuct where ((
    } //if _YearRas>=YearRas
    Result:=true;
  } //Function CalcAll(_cScud_Pers:comp; wYearRas,wMonthRas:word) :boolean;

