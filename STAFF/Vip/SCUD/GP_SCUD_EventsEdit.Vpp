 //-----------------------------------------
 //
 //-----------------------------------------
  Procedure PositionChanged;
  {  SetEditMode(CanEdittbl);
  }

  //------------------------------------
  // сохранить параметры
  //------------------------------------
  Procedure SaveParam;
  { if (boVisibleRun)
    {
      SaveMyDsk(wFilter  ,GetInterfaceName+'_wFilter');
      SaveMyDsk(DTB      ,GetInterfaceName+'_DTB');
      SaveMyDsk(DTE      ,GetInterfaceName+'_DTE');
      SaveMyDsk(wType_Flt,GetInterfaceName+'_wType_Flt');
    }
    //-----------------------
    DoneMarker(Marker_GP_SCUD_Pers_A, '' );
    DoneMarker(Marker_KatPodr_A, '' );
    DoneMarker(Marker_KatOrg_A , '' );
    //-----------------------
    DoneMarker(Marker_GP_SCUD_Pers,if(not boVisibleRun,'', GetInterfaceName+'_GP_SCUD_Pers') );
    DoneMarker(Marker_KatOrg ,if(not boVisibleRun,'', GetInterfaceName+'_KatOrg' ) );
    DoneMarker(Marker_KatPodr,if(not boVisibleRun,'', GetInterfaceName+'_KatPodr') );
  } //Procedure SaveParam;

  //----------------------------------------------------------------------------
  #doc
     Преобразование time в double
  #end
  Function GetDoubleFromTime(w:time):double;
  { // Result:=Hour(w)+Round(Minute(w)/60,2);
    Result:=iGP_SCUD_Function.GetDoubleFromTime(w);
  }
  //------------------------------------
  // Время из числа
  //------------------------------------
  Function GetTimeFromDouble(w:double):time;
  { //            HH              MM
    //Result:=Time(word(trunc(w,0)), word((w-trunc(w,0))*60) ,0,0 );
    Result:=iGP_SCUD_Function.GetTimeFromDouble(w);
  } //Function GetTimeFromDouble(w:double):time;

