  //------------------------------------
  // восстановить параметры
  //------------------------------------
  Procedure ReadParam;
  { if (boVisibleRun)
    {
      if not ReadMyDsk(wFilter,GetInterfaceName+'_wFilter',false) wFilter:=0;
      //if not ReadMyDsk(DTB    ,GetInterfaceName+'_DTB'    ,false)
      DTB:=Sub_Months(Cur_Date,2);
      DTB:=date(1,Month(DTB),Year(DTB));
      //if not ReadMyDsk(DTE    ,GetInterfaceName+'_DTE'    ,false)
      DTE:=Cur_Date;
      DTB_A:=DTB;
      DTE_A:=DTE;
      TMB:=0;
      TME:=time(24,0,0,0);
      TMB_A:=TMB;
      TME_A:=TMe;
      if not ReadMyDsk(wType_Flt,GetInterfaceName+'_wType_Flt',false) wType_Flt:=0;
    }
    Marker_GP_SCUD_Pers  :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_GP_SCUD_Pers') , 8, 50, 10, True);
    Marker_KatOrg   :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatOrg' ) , 8, 50, 10, True);
    Marker_KatPodr  :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatPodr') , 8, 50, 10, True);

    Marker_GP_SCUD_Pers_A  :=InitMarker('' , 8, 50, 10, True);
    Marker_KatOrg_A   :=InitMarker('' , 8, 50, 10, True);
    Marker_KatPodr_A  :=InitMarker('' , 8, 50, 10, True);

  } //  Procedure ReadParam;

  //--------------------------------------
  // получить должность по ссылке на сотрудника
  //--------------------------------------
  Function GetPostByPers(_pPersons:comp):string;cacheable;
  { Result:='';
    vPersons.pPersons:=_pPersons;
    vPersons._Loop Persons
      vPersons._Loop Appointments
        vPersons._Loop CatPost
          Result:=vPersons.CatPost.Name;
  } //Function GetPostByPers(_pPersons:comp):string;cacheable;

  //--------------------------------------
  //Найти ЗГД
  //_wType
  // 0 - код + наименование
  // 1 - код
  // 2 - наименование
  // 3 - katpodr.nrec
  //--------------------------------------
  Function FindZGD(_PKatPodr:comp; Flag_ZGD:boolean=false; _wType:word=0) :string;cacheable;
  var
   _pCatalogs:comp;
   _pnrec :comp;
  { Result:='';
    if _PKatPodr=0 then Exit;
    set vKatpodr.pKatPodr:=_PKatPodr;
    if vKatpodr.getfirst Katpodr<>tsok exit;
    _pCatalogs:=GetCatalogsByKatPodr(_PKatPodr);
    _pnrec:=coGetAttr(coCatalogs,_pCatalogs,'Верхний уровень иерархии');
    if vKatPodr.KatPodr.cPodr<>0 and _pNrec=0
    { Result:=FindZGD(vKatPodr.KatPodr.cPodr,Flag_ZGD,_wType);
    }
    else
    { case _wType of
      2:   Result:=GetKatPodr_Boss_Fio(vKatPodr.KatPodr.Nrec);
      else Result:=vKatPodr.KatPodr.Kod+','+vKatPodr.KatPodr.Name;
      end;
    }
  } //Function FindZGD(_pDep:comp) :string;cacheable;

  //---------------------------------------------
  // получить тип категории
  //---------------------------------------------
  Function GetKategType( _pGp_Scud_Kateg:comp):word; cacheable;
  { Result:=5; // все нарушения регистрируются
    if _pGp_Scud_Kateg=0 then exit;
    vSpr.pKateg:=_pGp_Scud_Kateg;
    if vSpr.Getfirst Gp_Scud_Kateg<>tsok then exit;
    Result:=vSpr.Gp_Scud_Kateg.wType;
  }

  //---------------------------------------------
  // Получить цвет события
  //---------------------------------------------
  Function GetColorEvents(ww_nrec:comp):longint;cacheable;
  { Result:=ColorSysBlack; 
    if ww_nrec=0 //not isValidAll(#GP_SCUD_Events)
    { Result:=ColorSysGray;
      Exit;
    }
    if GP_SCUD_Events.cStatus=pStatus_DM[4]
    { Result:=ColorSpringSemester;// ColorSysGray;
      exit;
    }
    if getfirst GP_SCUD_Events_Next=tsok
    { if GP_SCUD_Events_Next.wResource=GP_SCUD_Events.wResource
      { Result:=ColorErrorRec;
      }
    }
    if getlast GP_SCUD_Events_Prev=tsok
    { if GP_SCUD_Events_Prev.wResource=GP_SCUD_Events.wResource
      { Result:=ColorErrorRec;
      }
    }
    if wMisConDuct_V>0
    { Result:=ColorSysRed;
    }
    //нужно отобразить все равно
      // Есть заявление на отсутствие
      if isValidAll(#GP_SCUD_DOC_SP_A)
      { Result:=ColorSysPurple;
        if isValidAll(#GP_SCUD_DOC_A)
        { if GP_SCUD_DOC_A.cStatus=NPOEM_OWN_SCUD_ZAbsent_STATUS_M
             Result:=ColorSysGreen;
          else
          if GP_SCUD_DOC_A.cStatus<>iGP_SCUD_StateMentOnAbsent.GetStatus_Default
             Result:=ColorSysBlue;
        }
      }
  } //Function GetColorEvents:longint;

  function IsAgileRejim(cScudPers: comp; checkDate: date): boolean; cacheable;
  var _wKateg: word;
  {
    #__UNUSED__(cScudPers)//По идее, уже спозиционирован, передаем для кэширования
    _wKateg := GetKategType(GP_SCUD_Pers.cGp_Scud_Kateg);
    Calc_Date := checkDate;
    if getlast GP_SCUD_Pers_Hist = tsok
      if GP_SCUD_Pers_Hist.cGp_Scud_Kateg > 0
        _wKateg:=GetKategType(GP_SCUD_Pers_Hist.cGp_Scud_Kateg);
    if _wKateg=0 _wKateg:=5;

    Result := _wKateg = 6;
  }

  Procedure Fill_Tmp_Data(pScud_Pers:comp;_DTB:date;_DTE:date);forward;
  
  var pVA_WorkDayStart1: comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Начало рабочего дня с', cgAttrType_Time);
  var pVA_WorkDayStart2: comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Начало рабочего дня по', cgAttrType_Time);
  var pVA_DinnerStart1 : comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Начало обеда с', cgAttrType_Time);
  var pVA_DinnerStart2 : comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Начало обеда по', cgAttrType_Time);
  var pVA_DinnerTime   : comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Длительность обеда', cgAttrType_Time);
 
  function CalcDayAgile(_pScud_Events:comp): boolean;
  var cPers, cPrevExit, cKateg: comp;
      eventDate: date;
      endWorkTime, startWorkTime, workTime, absenseTime, dinnerTime, prevEnterTime, prevExitTime, curInterval: time;
      planStart1, planStart2, planDinner1, planDinner2, planWorkTime, planDinnerTime, maxAbsense: time;
  {
    Result := false;

    if getfirst GP_SCUD_Events_Free where ((_pScud_Events == GP_SCUD_Events_Free.NRec)) <> tsOK
      exit;
    planStart1 := planStart2 := planDinner1 := planDinner2 := planDinnerTime := ZeroTime;
    ///////
    cKateg := GP_SCUD_Pers.cGp_Scud_Kateg;
    Calc_Date := GP_SCUD_Events_Free.EnterDate;
    if getlast GP_SCUD_Pers_Hist = tsok
      if GP_SCUD_Pers_Hist.cGp_Scud_Kateg <> 0
        cKateg := GP_SCUD_Pers_Hist.cGp_Scud_Kateg;
    TimeLog('Категория на ' + Calc_Date + ': ' + cKateg);

    if cKateg <> 0
    {
      planStart1     := tGetAttrID(coGP_SCUD_Kateg, cKateg, pVA_WorkDayStart1);
      planStart2     := tGetAttrID(coGP_SCUD_Kateg, cKateg, pVA_WorkDayStart2);
      planDinner1    := tGetAttrID(coGP_SCUD_Kateg, cKateg, pVA_DinnerStart1);
      planDinner2    := tGetAttrID(coGP_SCUD_Kateg, cKateg, pVA_DinnerStart2);
      planDinnerTime := tGetAttrID(coGP_SCUD_Kateg, cKateg, pVA_DinnerTime);
    }
    TimeLog('Время обеда из атрибута: ' + planDinnerTime);
    ///////
    if planStart1     = ZeroTime planStart1     := time(6, 30, 0, 0);
    if planStart2     = ZeroTime planStart2     := time(10, 0, 0, 0);
    if planDinner1    = ZeroTime planDinner1    := time(12, 0, 0, 0);
    if planDinner2    = ZeroTime planDinner2    := time(14, 0, 0, 0);
    if planDinnerTime = ZeroTime planDinnerTime := time(1, 0, 0, 0);
    var d: byte = day(GP_SCUD_Events_Free.EnterDate);
    planWorkTime := Add_time(time(vTabel.KLNDR.DAYCHAS[D], vTabel.KLNDR.DAYMIN[D], 0, 0), planDinnerTime);//time(9, 0, 0, 0);
    maxAbsense := time(0, 15, 0, 0);
    TimeLog('Время обеда итоговое: ' + planDinnerTime);
    ///////
    if vTabel.KLNDR.DAYCHAS[D] = 0 and vTabel.KLNDR.DAYMIN[D] = 0
    {
      planStart1 := time(0, 0, 0, 0);
      planStart2 := time(24, 0, 0, 0);
      planDinner1 := time(24, 0, 0, 0);
      planDinner2 := time(24, 0, 0, 0);
      planDinnerTime := time(0, 0, 0, 0);
      maxAbsense := time(24, 0, 0, 0);
    }

    cPers := GP_SCUD_Events_Free.cGP_SCUD_Pers;
    eventDate := GP_SCUD_Events_Free.EnterDate;
    ///////
    if getfirst tmp_period where ((cPers == tmp_period.cGP_SCUD_PERS and eventDate == tmp_period.EventDate)) <> tsOk
      Fill_Tmp_Data(cPers, eventDate, eventDate);
    _loop tmp_period where ((cPers == tmp_period.cGP_SCUD_PERS and eventDate == tmp_period.EventDate))
    {
      if TimeLog_Status>0 
        timelog('Minus period '+string(cPers,0,0)+', DT='+string(eventDate)+', time='+tmp_period.PlanTime);
      if planWorkTime > tmp_period.PlanTime
        planWorkTime := Sub_Time(planWorkTime, tmp_period.PlanTime);
      else
        planWorkTime := ZeroTime;
    }
    timelog('planWorkTime '+string(cPers,0,0)+', DT='+string(eventDate)+', planWorkTime='+planWorkTime);
    ///////
    endWorkTime := startWorkTime := workTime := absenseTime := dinnerTime := prevEnterTime := prevExitTime := ZeroTime;
    cPrevExit := 0;
    _loop GP_SCUD_Events_Free where ((cPers == GP_SCUD_Events_Free.cGP_SCUD_Pers and eventDate == GP_SCUD_Events_Free.EnterDate)) ordered by GP_SCUD_Events_Free.EnterTime
    {
      if getfirst tAgileCache where ((GP_SCUD_Events_Free.NRec == tAgileCache.cEvent)) <> tsOk
      {
        ClearBuffer(tntAgileCache);
        tAgileCache.cEvent := GP_SCUD_Events_Free.NRec;
        tAgileCache.DiffColor := ColorSysBlack;
        if GP_SCUD_Events_Free.wResource = 1
        {//Вход
          if GP_SCUD_Events_Free.EnterTime < planDinner1
            tAgileCache.PlanTime := planStart2;
          else if endWorkTime <> ZeroTime
            tAgileCache.PlanTime := endWorkTime;
          else
            tAgileCache.PlanTime := planDinner2;
          if GP_SCUD_Events_Free.EnterTime > Add_Time(tAgileCache.PlanTime, tNPOEM_OWN_SCUD_DELAY_ALLOW) and tAgileCache.PlanTime <= planDinner2
            tAgileCache.DiffColor := ColorSysRed;
        }
        else
        {//Выход
          if GP_SCUD_Events_Free.EnterTime < planDinner2
            tAgileCache.PlanTime := planDinner1;
          else if endWorkTime <> ZeroTime
            tAgileCache.PlanTime := endWorkTime;
          else
            tAgileCache.PlanTime := Add_Time(prevEnterTime, Sub_Time(planWorkTime, Add_Time(workTime, dinnerTime)));
          if GP_SCUD_Events_Free.EnterTime < tAgileCache.PlanTime and GP_SCUD_Events_Free.EnterTime > planStart1
            tAgileCache.DiffColor := ColorSysRed;
        }
        //MisConduct:
        //+1 - 'Опоздание на работу'
        //+2 - 'Ранний уход на обед'
        //+3 - 'Поздний приход с обеда'
        //+4 - 'Ранний уход с работы'
        //5 - 'Отсутствие в середине дня'
        insert current tAgileCache;
      }
      if GP_SCUD_Events_Free.wResource = 1
      {//Вход
        if GP_SCUD_Events_Free.EnterTime <= planStart1 or startWorkTime = ZeroTime // Первый
        {
          startWorkTime := if(GP_SCUD_Events_Free.EnterTime > planStart1, GP_SCUD_Events_Free.EnterTime, planStart1);
          prevEnterTime := startWorkTime;
          if startWorkTime > planStart2
          {
            tAgileCache.absenseTime := Sub_Time(GP_SCUD_Events_Free.EnterTime, planStart2);
            tAgileCache.wMisConduct := 1;
            update current tAgileCache;
          }
        }
        else
        {
          if planStart1 <= GP_SCUD_Events_Free.EnterTime and GP_SCUD_Events_Free.EnterTime <= planDinner1
          { // До начала обеда
            tAgileCache.absenseTime := Sub_Time(GP_SCUD_Events_Free.EnterTime, prevExitTime);
            absenseTime := Add_Time(absenseTime, tAgileCache.absenseTime);
            if absenseTime > maxAbsense and tAgileCache.wMisConduct = 0
              tAgileCache.wMisConduct := 5;
            update current tAgileCache;
          }
          else if planDinner1 <= GP_SCUD_Events_Free.EnterTime and GP_SCUD_Events_Free.EnterTime <= planDinner2
          { // В обед
            if prevExitTime < planDinner1
            {
              if getfirst tAgileCache2 where ((cPrevExit == tAgileCache2.cEvent)) = tsOK
              {
                tAgileCache2.absenseTime := Sub_time(planDinner1, prevExitTime);
                tAgileCache2.wMisConduct := 2;
                update current tAgileCache2;
              }
              absenseTime := Add_Time(absenseTime, tAgileCache2.absenseTime);
              prevExitTime := planDinner1;
            }
            curInterval := Sub_Time(GP_SCUD_Events_Free.EnterTime, prevExitTime);
            if Add_Time(dinnerTime, curInterval) > planDinnerTime
            {
              tAgileCache.absenseTime := Sub_Time(Add_Time(dinnerTime, curInterval), planDinnerTime);
              absenseTime := Add_Time(absenseTime, tAgileCache.absenseTime);
              dinnerTime := planDinnerTime;
              tAgileCache.wMisConduct := 3;
              update current tAgileCache;
            }
            else
              dinnerTime := Add_Time(dinnerTime, curInterval);
          }
          else
          {//После обеда
            if prevExitTime < planDinner2
            {
              if prevExitTime < planDinner1
              {
                if getfirst tAgileCache2 where ((cPrevExit == tAgileCache2.cEvent)) = tsOK
                {
                  tAgileCache2.absenseTime := Sub_time(planDinner1, prevExitTime);
                  tAgileCache2.wMisConduct := 2;
                  update current tAgileCache2;
                  absenseTime := Add_Time(absenseTime, tAgileCache2.absenseTime);
                }
                prevExitTime := planDinner1;
              }
              curInterval := Sub_Time(planDinner2, prevExitTime);
              if Add_Time(dinnerTime, curInterval) > planDinnerTime
              {
                prevExitTime := Add_Time(prevExitTime, Sub_Time(planDinnerTime, dinnerTime));
                dinnerTime := planDinnerTime;
              }
              else
              {
                dinnerTime := Add_Time(dinnerTime, curInterval);
                prevExitTime := planDinner2;
              }
              tAgileCache.wMisConduct := 3;
              update current tAgileCache;
            }
            if Add_Time(workTime, dinnerTime) < planWorkTime
            {
              tAgileCache.absenseTime := Sub_Time(GP_SCUD_Events_Free.EnterTime, prevExitTime);
              absenseTime := Add_Time(absenseTime, tAgileCache.absenseTime);
              if absenseTime > maxAbsense and tAgileCache.wMisConduct = 0
                tAgileCache.wMisConduct := 5;
              update current tAgileCache;
            }
          }
          prevEnterTime := GP_SCUD_Events_Free.EnterTime;
        }
      }//Вход
      else
      {//Выход
        if GP_SCUD_Events_Free.EnterTime < planStart1
        {
          prevExitTime := planStart1;
        }
        else
        {
          workTime := Add_Time(workTime, Sub_Time(GP_SCUD_Events_Free.EnterTime, prevEnterTime));
          if endWorkTime = ZeroTime and Add_Time(workTime, dinnerTime) >= planWorkTime
            endWorkTime := Sub_Time(GP_SCUD_Events_Free.EnterTime, Sub_Time(Add_Time(workTime, dinnerTime), planWorkTime));
          prevExitTime := GP_SCUD_Events_Free.EnterTime;
        }
        cPrevExit := tAgileCache.cEvent;
      }//Выход
    }//_loop
    if Add_Time(workTime, dinnerTime) < planWorkTime and GP_SCUD_Events_Free.wResource = 0 //если последнее событие - вход, значит на ночь остался, вряд ли недоработал
    {
      tAgileCache.wMisConduct := 4;
      tAgileCache.absenseTime := Sub_Time(planWorkTime, Add_Time(workTime, dinnerTime));
      update current tAgileCache;
    }
    if getfirst tAgileCacheDay where ((cPers == tAgileCacheDay.cScudPers and eventDate == tAgileCacheDay.eventDate)) <> tsOK
    {
      ClearBuffer(tntAgileCacheDay);
      tAgileCacheDay.cScudPers     := cPers;
      tAgileCacheDay.eventDate     := eventDate;
      tAgileCacheDay.startWork     := startWorkTime;
      tAgileCacheDay.endWork       := if(GP_SCUD_Events_Free.wResource = 0, GP_SCUD_Events_Free.EnterTime, time(24, 0, 0, 0));
      tAgileCacheDay.workTime      := workTime;
      tAgileCacheDay.dinnerTime    := dinnerTime;
      tAgileCacheDay.absenseTime   := absenseTime;
      tAgileCacheDay.PlanStartWork := if(startWorkTime < planStart2, startWorkTime, planStart2);
      tAgileCacheDay.PlanEndWork   := endWorkTime;
      tAgileCacheDay.PlanWorkTime  := planWorkTime;
      tAgileCacheDay.PlanDinnerTime:= planDinnerTime;
      insert current tAgileCacheDay;
    }
    Result := true;
  }

  //---------------------------------------------
  // Получить разницы
  //---------------------------------------------
  Function GetDiffTime(ww_nrec:comp; _Plan_time:time):time;cacheable;
  var _Time :time;
  { #__UNUSED__(ww_nrec,_Plan_time)
    Result:=ZeroTime;
    _Time:=_Plan_Time;
    if GP_SCUD_Events.wResource=0 // Выход
    { // ищем следующее
      if getfirst GP_SCUD_Events_Next=tsok
      { if GP_SCUD_Events_Next.EnterDate=GP_SCUD_Events.EnterDate
        { if GP_SCUD_Events_Next.EnterTime<Plan_Time
             _Time:=GP_SCUD_Events_Next.EnterTime
        }
      }
    } //if GP_SCUD_Events.wResource=0 // Выход
    else
    { if getlast GP_SCUD_Events_Prev=tsok
      { if GP_SCUD_Events_Prev.EnterDate=GP_SCUD_Events.EnterDate
        { if GP_SCUD_Events_Prev.EnterTime>Plan_Time
            _Time:=GP_SCUD_Events_Prev.EnterTime
        }
      }
      else
      { var _wDay:word=Day(GP_SCUD_Events.EnterDate);
        if _wDay>0
        { //Добавим время до обеда если это первый вход
          if _Plan_Time>=vTabel.GP_KlndrExt.EndBreak1[_wDay]
          if _Plan_Time<=vTabel.GP_KlndrExt.EndWorkDay[_wDay]
          if GP_SCUD_Events.Entertime>vTabel.GP_KlndrExt.EndBreak1[_wDay]
          if GP_SCUD_Events.Entertime<vTabel.GP_KlndrExt.EndWorkDay[_wDay]
          if vTabel.GP_KlndrExt.StartBreak1[_wDay]>vTabel.GP_KlndrExt.StartWorkDay[_wDay]
          //    diff_Time:=Add_Time(diff_Time
          //          ,Sub_Time(pGRAFF_WorkPeriod.StartBreak1[ii],pGRAFF_WorkPeriod.StartWorkDay[ii]));

          { Result:=Add_Time(Sub_Time(GP_SCUD_Events.EnterTime,_Time),
                             Sub_Time(vTabel.GP_KlndrExt.StartBreak1[_wDay],vTabel.GP_KlndrExt.StartWorkDay[_wDay])
                  );
            exit;
          }
        }

      }
    } //else if GP_SCUD_Events.wResource=0 // Выход
    Result:=  IF(_Time=ZeroTime,ZeroTime,If(_Time<=GP_SCUD_Events.EnterTime
          ,Sub_Time(GP_SCUD_Events.EnterTime,_Time)
          ,Sub_Time(_Time,GP_SCUD_Events.EnterTime)
       ))
  } //Function GetDiffTime(ww_nrec:comp; ww_Plan_time):time;cacheable;

  //---------------------------------------------
  // Получить цвет разницы
  //---------------------------------------------
  function GetColorDiffEventsAgile(_pScud_Events:comp): longint;
  {
    Result := ColorSysBlack;
    if getfirst tAgileCache where ((_pScud_Events == tAgileCache.cEvent)) <> tsOk
    {
      CalcDayAgile(_pScud_Events);
      if getfirst tAgileCache where ((_pScud_Events == tAgileCache.cEvent)) <> tsOk
        exit;
    }
    Result := tAgileCache.DiffColor;
  }

  Function GetColorDiffEvents(ww_nrec:comp):longint;cacheable;
  { Result:=ColorSysBlack;
    ww_nrec:=ww_nrec;
    if GP_SCUD_Events.EnterDate=ZeroDate exit;
    if GP_SCUD_Events.cStatus=pStatus_DM[4]
    { Result:=ColorSpringSemester;// ColorSysGray;
      exit;
    }
    if IsAgileRejim(GP_SCUD_Events.cGP_SCUD_Pers, GP_SCUD_Events.EnterDate)
    {
      Result := GetColorDiffEventsAgile(ww_nrec);
      exit;
    }

    if(GP_SCUD_Events.wResource=1 and Plan_Time<GP_SCUD_Events.EnterTime)
    { if Plan_Time=vTabel.GP_KlndrExt.StartWorkDay[Day(GP_SCUD_Events.EnterDate)]
      { if Add_time(Plan_Time,tNPOEM_OWN_SCUD_DELAY_ALLOW)>=GP_SCUD_Events.EnterTime
          exit;
      }
      else
      if Plan_Time=GetEndBreak1(Day(GP_SCUD_Events.EnterDate))
      { if Add_time(Plan_Time,tNPOEM_OWN_SCUD_DELAY_ALLOW)>=GP_SCUD_Events.EnterTime
          exit;
      }
      else
      if Plan_Time=vTabel.GP_KlndrExt.StartShift2[Day(GP_SCUD_Events.EnterDate)]
      { if Add_time(Plan_Time,tNPOEM_OWN_SCUD_DELAY_ALLOW)>=GP_SCUD_Events.EnterTime
          exit;
      }
      else
      if Plan_Time=vTabel.GP_KlndrExt.EndBreak2[Day(GP_SCUD_Events.EnterDate)]
      { if Add_time(Plan_Time,tNPOEM_OWN_SCUD_DELAY_ALLOW)>=GP_SCUD_Events.EnterTime
          exit;
      }
      Result:=ColorSysRed
    }
    else
       if(GP_SCUD_Events.wResource=0 and Plan_Time>GP_SCUD_Events.EnterTime)
         Result:=ColorSysRed;
  } //Function GetColorDiffEvents(ww_nrec:comp):longint;cacheable;

  // пока не используем
  Function GetBackColorDay(ww_str:string):longint;
  { Result:=0;
    if pos('/Н',ww_str)>0
    or pos('НН',ww_str)>0
    { Result:=ColorSysRed;
    }
    else
    if pos('/П',ww_str)>0
    { Result:=ColorSysLime;
    }
  } //Function GetBackColorDay(ww_num):longint;



  //---------------------------------------------
  // Получить время следующего события
  //---------------------------------------------
  Function GetNextEventsTime(ww_nrec:comp):string;cacheable;
  { Result:=ZeroTime;
    ww_nrec:=ww_nrec;
    if getfirst GP_SCUD_Events_Next=tsok
    { Result:=TimeToStr(GP_SCUD_Events_Next.EnterTime,'HH:MM');
      if GP_SCUD_Events_Next.EnterDate<>GP_SCUD_Events.EnterDate
       if GP_SCUD_Events_Next.EnterDate<>GP_SCUD_Events.EnterDate
        Result:=Result+DateToStr(GP_SCUD_Events_Next.EnterDate,' DD.MM');
    }
  } //GetNextEventsTime(ww_nrec:comp):string;cacheable;


  //------------------------------------
  // декларация сложного фильтра
  //------------------------------------
  function isFilterAnCorrect(ww_nrec:comp): boolean; cacheable;
  { Result:=true;
    if isPodrShare
    { if GP_SCUD_Events.cKatPodr<>0
       if not EnablePodr(GP_SCUD_Events.cKatPodr)
        { Result:=false;
          Exit;
        }
    }
    if IsBitCTW(wFilter,1)
    { if Count_KatPodr>1
      { If not FoundMarker(Marker_KatPodr_A,GP_SCUD_Events.cKatPodr)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,2)
    { if Count_GP_SCUD_Pers>1
      { If not FoundMarker(Marker_GP_SCUD_Pers_A,GP_SCUD_Events.cGP_SCUD_Pers)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,3)
    { if Pos(UpCase(sFio_Flt),UpCase(GP_SCUD_Pers.Fio) )=0
      { Result:=false;
        Exit;
      }
    }
    if IsBitCTW(wFilter,4)
    { if Pos(UpCase(sPropusk_Flt),UpCase(GP_SCUD_Pers.Propusk_NMB) )=0
      { Result:=false;
        Exit;
      }
    }
    if IsBitCTW(wFilter,5)
    { if GetColorEvents(ww_nrec)=ColorSysRed
      { Result:=false;
        Exit;
      }
    }
    /*
    if IsBitCTW(wFilter,4)
    { if Count_KatOrg>1
      { If not FoundMarker(Marker_KatOrg_A,GP_SCUD_Events.cKatOrg)
        { Result:=false;
          Exit;
        }
      }
    }
    */
  }//function isFilterAnCorrect(ww_nrec:comp): boolean;

    //-------------------------------------------
  // скопировать фильтры в данные для отборв
  //-------------------------------------------
  Procedure CopyToA;
  { CopyMarker(Marker_GP_SCUD_Pers_A ,Marker_GP_SCUD_Pers);
    CopyMarker(Marker_KatOrg_A  ,Marker_KatOrg );
    CopyMarker(Marker_KatPodr_A ,Marker_KatPodr);
    sFio_Flt_A      :=sFio_Flt      ;
    sPropusk_Flt_A  :=sPropusk_Flt  ;
    wType_Flt_A     :=wType_Flt     ;
    DTB_A:=DTB;
    DTE_A:=DTE;
    TMB_A:=TMB;
    TME_A:=TME;

  } //Procedure CopyToA;


  //-------------------------------------------
  // восстановить данные для задания фильтрации
  // из данных для отбора
  //-------------------------------------------
  Procedure RestFromA;
  { CopyMarker(Marker_GP_SCUD_Pers ,Marker_GP_SCUD_Pers_A);
    CopyMarker(Marker_KatOrg  ,Marker_KatOrg_A );
    CopyMarker(Marker_KatPodr ,Marker_KatPodr_A);
    sFio_Flt      :=sFio_Flt_A      ;
    sPropusk_Flt  :=sPropusk_Flt_A  ;
    wType_Flt     :=wType_Flt_A     ;
    DTB:=DTB_A;
    DTE:=DTE_A;
    TMB:=TMB_A;
    TME:=TME_A;
  } //Procedure RestFromA;

  //-------------------------------------------
  #doc
    Установить ограничения
  #end
  Function SetFilterBounds(_IsArch:word) : boolean;
  var wNeed_Bounds :word;
  { Result:=false;
    _IsArch:=_IsArch;
    isFilterRun:=True;
    wNeed_Bounds:=0;

    //-----------------------
    wCount_Filter:=0;
    sTitle_Filter:='';
    //-----------------------
    CopyToA;
    //-----------------------
    ClearFuncCache; // очистим кэш функций
    var need_FilterAn:boolean=false;
    if IsBitCTW(wFilter,1)
    {  Count_KatPodr:=GetMarkerCount(Marker_KatPodr);
       GetMarker(Marker_KatPodr,0,pKatPodr);

       if Count_KatPodr=1
       { //AddBounds(tbByKatPodr);
         BitOnW(wNeed_Bounds,1);
       }
       else need_FilterAn:=true;
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по подразделению';
    }
    if IsBitCTW(wFilter,2)
    {  Count_GP_SCUD_Pers:=GetMarkerCount(Marker_GP_SCUD_Pers);
       GetMarker(Marker_GP_SCUD_Pers,0,pGP_SCUD_Pers);
       if Count_GP_SCUD_Pers=1
       {
         //AddBounds(tbByGP_SCUD_Pers);
         BitOnW(wNeed_Bounds,2);
       }
       else need_FilterAn:=true;
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по сотруднику';
    }
    if IsBitCTW(wFilter,3) or IsBitCTW(wFilter,4) or IsBitCTW(wFilter,4)
    {  need_FilterAn:=true;
      if IsBitCTW(wFilter,3)
      { wCount_Filter++;
        if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по части фио';
      }
      if IsBitCTW(wFilter,4)
      { wCount_Filter++;
        if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'номер карты';
      }
      if IsBitCTW(wFilter,5)
      { wCount_Filter++;
        if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'ошибки пары';
      }
    } //if IsBitCTW(wFilter,4) or IsBitCTW(wFilter,5) or IsBitCTW(wFilter,6)
    /*
    if IsBitCTW(wFilter,2)
    {  Count_KatOrg:=GetMarkerCount(Marker_KatOrg);
       GetMarker(Marker_KatOrg,0,pKatOrg);

       if Count_KatOrg=1
       { //AddBounds(tbByKatOrg);
         BitOnL(wNeed_Bounds,4)

       }
       else need_FilterAn:=true;
    }
    */

    if isPodrShare
    { need_FilterAn:=true;
    }

    //-------------------------
    if isBitCtW(wNeed_Bounds,1)
    { if not BoundActive(tbByKatPodr) AddBounds(tbByKatPodr);
    }
    else
    { if BoundActive(tbByKatPodr) SubBounds(tbByKatPodr);
    }
    //-------------------------
    if isBitCtW(wNeed_Bounds,2)
    { if not BoundActive(tbByGP_SCUD_Pers) AddBounds(tbByGP_SCUD_Pers);
    }
    else
    { if BoundActive(tbByGP_SCUD_Pers) SubBounds(tbByGP_SCUD_Pers);
    }
    // использование сложного фильтра
    if need_FilterAn
    { if not ConditionActiveInLeave(tcFilterAn, #GP_SCUD_Events)
      PushConditionForLeave(tcFilterAn, #GP_SCUD_Events);
    }
    else
    if ConditionActiveInLeave(tcFilterAn, #GP_SCUD_Events)
    { PopConditionForLeave(tcFilterAn, #GP_SCUD_Events);
    }
    if wCount_Filter>3 sTitle_Filter:=sTitle_Filter+' и еще '+string(wCount_Filter-3)+' фильтров';
    MySetTitle;

    //------------------------
    ReReadRecord(#GP_SCUD_Events);
    Result:=true;
    isFilterRun:=False;

  } //Function SetFilterBounds : boolean;

  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_Katpodr
    { #mrkfiltr_(Katpodr_Flt,Katpodr,Nrec,wc_nrec,Katpodr_Flt.Kod+','+Katpodr_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_Katorg
    { #mrkfiltr_(KatOrg_Flt,KatOrg,Nrec,wc_nrec,KatOrg_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_GP_SCUD_Pers
    { #mrkfiltr_(GP_SCUD_Pers_Flt,GP_SCUD_Pers,Nrec,wc_nrec,GP_SCUD_Pers_Flt.Fio)
    }
    ReScanPanel(#KatPodr_Flt);
  } //Procedure SetFilterNM(_Field:longint)

