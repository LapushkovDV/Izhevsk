//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
var ii:word;
    _Status:string;
    ww_mes:string;
{  inherited ::LoadInterface(_boVisibleRun);
   DisableCommand(cmDelete);
   Calc_Rejim:=false;
   ww_mes:='';
   ReadParam;
   boLoadZar:=false;
   DatOtch      := dGetTune('UP.DATOTCH');
   DatOtch_Next :=Add_Months(DatOtch,1);
   NPOEM_OWN_SCUD_Pers_Other :=boGetTune('NPOEM_OWN.SCUD.Pers_Other');//'Отображать сторонних лиц
   for(ii:=1;ii<=4;ii++)
   { case ii of
     01: _Status:='СКУД';
     02: _Status:='СКУД, корректировка';
     03: _Status:='Добавлен вручную';
     04: _Status:='Исключено из учета';
     end;
     pStatus_DM[ii]:=Status.GetByName(_Status);
     if pStatus_DM[ii]=0
     { ww_mes:=ww_mes+chr(13)+string(ii)+','+_Status
     }
   }
   if ww_mes<>'' and wIntMode=0
   { message('Нет статусов к событиям '+ww_mes);
   }
   //---------------------------------
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci1Esc;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_EventsEditdEdit_P';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else
      // pMarker.Disable:=true;
      { //DataProtector.ProtectedStatusCtx := sci1Esc;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_EventsEditdEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }

      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
   UP_ZAR_WT_PROTECTUPTODATE:=dGetTune('UP.ZAR.WT.PROTECTUPTODATE');//Управление персоналом \ Табельный учет \ Формирование \ Окончание диапазона защиты табелей от обновления
   if UP_ZAR_WT_PROTECTUPTODATE=ZeroDate UP_ZAR_WT_PROTECTUPTODATE:=dGetTune('NPOEM_OWN.SCUD.SALDO_LOCK');
   NPOEM_OWN_SCUD_Vactions_Control:=wGetTune('NPOEM_OWN.SCUD.Vactions_Control');// Настройки НПО Энергомаш \ СКУД \Способ ограничения работы в выходной день "

   NPOEM_OWN_SCUD_DELAY_ALLOW     :=wGetTune('NPOEM_OWN.SCUD.DELAY_ALLOW');//', 'Считать опозданием при входе позже времени начала графика, секунд
   tNPOEM_OWN_SCUD_DELAY_ALLOW    :=ZeroTime;
   //000103  26/01 вход 8:01
   if NPOEM_OWN_SCUD_DELAY_ALLOW>0
     tNPOEM_OWN_SCUD_DELAY_ALLOW:=Time(NPOEM_OWN_SCUD_DELAY_ALLOW div 3600,(NPOEM_OWN_SCUD_DELAY_ALLOW div 60) mod 60,NPOEM_OWN_SCUD_DELAY_ALLOW mod 60,0);
   Timelog('GP_SCUD_EventsEdit->LoadInterface:tNPOEM_OWN_SCUD_DELAY_ALLOW='+timeToStr(tNPOEM_OWN_SCUD_DELAY_ALLOW,'HH::MM:SS:SSS'));
   NPOEM_OWN_SCUD_OVER2_Type      :=wGetTune('NPOEM_OWN.SCUD.OVER2_Type');//', 'Способ расчета переработки
   NPOEM_OWN_SCUD_ZAbsent_STATUS_M:=coGetTune('NPOEM_OWN.SCUD.ZAbsent_STATUS_M');//'Статус "утвержден" в заявлении на отсутствие'
   //--------------------
   sUserName:=vSpr_base.sUserName_base;
   //--------------------
   pVA_SalScale_TMB :=ExtAttr_Create(coSalScale,'Время начала отклонения'   , cgAttrType_Time);
   pVA_SalScale_TME :=ExtAttr_Create(coSalScale,'Время окончания отклонения', cgAttrType_Time);
   //--------------------


   isFilterRun:=false;

  mtClear(tntAgileCache, mfNormal);
  mtClear(tntAgileCacheDay, mfNormal);
} //Procedure LoadInterface(_wRunType:word);

Function GetExtData(_DataType, wDay:word ):double;  //Дополнительные данные из расчетных массивов
{
  Case _DataType of
    1: GetExtData := pGP_SCUD_Saldo.CH_OverWork[wDay]  ;//:array [1..31] of double; // сверхурочные
    2: GetExtData := pGP_SCUD_Saldo.CH_OverWork2[wDay] ;//:array [1..31] of double; // переработка
    3: GetExtData := pGP_SCUD_Saldo.CH_Holiday[wDay]   ;//:array [1..31] of double; // выходные
    4: GetExtData := pGP_SCUD_Saldo.CH_MisConDuct[wDay];//:array [1..31] of double; // выходные
    5: GetExtData := pGP_SCUD_Saldo.CH_GrafCh[wDay]    ;//:array [1..31] of double; // рабочих часов
    6: GetExtData := GetDoubleFromTime(pGRAFF_WorkPeriod.StartWorkDay[wDay]);
    7: GetExtData := GetDoubleFromTime(pGRAFF_WorkPeriod.EndWorkDay  [wDay]);
    8: GetExtData := GetDoubleFromTime(pGRAFF_WorkPeriod.StartShift2 [wDay]);
    9: GetExtData := GetDoubleFromTime(pGRAFF_WorkPeriod.EndShift2   [wDay]);
   10: GetExtData := GetDoubleFromTime(pGRAFF_WorkPeriod.StartBreak1 [wDay]);
   11: GetExtData := GetDoubleFromTime(pGRAFF_WorkPeriod.EndBreak1   [wDay]);
   12: GetExtData := GetDoubleFromTime(pGRAFF_WorkPeriod.StartBreak2 [wDay]);
   13: GetExtData := GetDoubleFromTime(pGRAFF_WorkPeriod.EndBreak2   [wDay]);
  end;

  if timelog_status>0
  { timelog(' GetExtData '+String(_DataType)+','+string(wDay)
     +', Result='+string(Result)+','+string(pGRAFF_WorkPeriod.StartWorkDay[wDay]) )

  }
}// Function GetExtData(_DataType, wDay:word ):double;  //Дополнительные данные из расчетных массивов

//-------------------------
// получить наименование смены
//-------------------------
Function GetRejim(wDay:word; _Shift:word=0 ):string;  //Режим работы по графику Строка
{ Result:='';
  if wDay=0 then exit;
  if   pGRAFF_WorkPeriod.StartWorkDay[wDay]=ZeroTime
  and  pGRAFF_WorkPeriod.EndWorkDay  [wDay]=ZeroTime
  and  pGRAFF_WorkPeriod.StartShift2 [wDay]=ZeroTime
  and  pGRAFF_WorkPeriod.EndShift2   [wDay]=ZeroTime
  { Result:='Выходной';
    exit;
  }

  if _Shift<2
  { Result:= Result + TimeToStr(pGRAFF_WorkPeriod.StartWorkDay[wDay],'c HH:MM') + TimeToStr(pGRAFF_WorkPeriod.EndWorkDay[wDay],' до HH:MM') ;
  }
  if pGRAFF_WorkPeriod.StartShift2[wDay] <> ZeroTime
  { if _Shift<2
    { Result := '1я смена: ' + Result+', ';
    }
    if _Shift=0 or _Shift=2
      Result := Result + '2я смена: '
         + TimeToStr(pGRAFF_WorkPeriod.StartShift2[wDay],'c HH:MM')  + TimeToStr(pGRAFF_WorkPeriod.EndShift2[wDay],' до HH:MM') ;
  } //Function GetRejim(wDay:word; _Shift:word=0 ):string;  //Режим работы по графику Строка
  

  if pGRAFF_WorkPeriod.StartBreak2[wDay] <> ZeroTime
  {
   if _Shift<2
     Result := Result + ', Первый Обед: ' + TimeToStr(pGRAFF_WorkPeriod.StartBreak1[wDay],'c HH:MM')  + TimeToStr(pGRAFF_WorkPeriod.EndBreak1[wDay],' до HH:MM') ;
   if _Shift=0 or _Shift=2
     Result := Result + ', Второй Обед: ' + TimeToStr(pGRAFF_WorkPeriod.StartBreak2[wDay],'c HH:MM')  + TimeToStr(pGRAFF_WorkPeriod.EndBreak2[wDay],' до HH:MM') ;

  }
  else
    Result := Result + ', Обед: ' + TimeToStr(pGRAFF_WorkPeriod.StartBreak1[wDay],'c HH:MM')  + TimeToStr(pGRAFF_WorkPeriod.EndBreak1[wDay],' до HH:MM') ;


/*
  _Loop tmp_period_work where ((
             pGP_SCUD_Pers == tmp_period_work.cGP_SCUD_PERS
            and _pDate     == tmp_period_work.EventDate
         ))
  {
    if _sRejim <> '' then _sRejim := _sRejim + ' и ';
    _sRejim := _sRejim + TimeToStr(tmp_period_work.EVENTTMB,'c HH:MM') + TimeToStr(tmp_period_work.EVENTTME,' до HH:MM') ;
  }
  */
} //Function GetRejim(wDay:word ):string;  //Режим работы по графику Строка

//------------------------------------------------
// формирование приказа на работу в выходной день
//------------------------------------------------
Function MakeOrder(_wType:word) :boolean;
var ch:double;
    _wMes:string;
{ Result:=false;
  delete all tmp_scud_order_new;// Для новых приказов
  StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Подготовка фильтров для отчета',0);
  oGP_Log.Init('SCUD_ORDER.log', true, true, true);
  if TimeLog_Status>0 timelog('GP_SCUD_EventsEdit>MakeOrder after log');
    ch:=0;
    case _wType of
    0: // сверхурочные
    {}
    1: // выходные
    {}
    2: // переработка
    {}
    end;
    //if ch=0 continue;
    _wMes:=GP_SCUD_PERS.Fio+' '+string(ch);
    clearbuffer(#tmp_scud_order_new);
    tmp_scud_order_new.Podr_Code:=Katpodr.Kod;
    tmp_scud_order_new.PodrName :=Katpodr.Name;
    tmp_scud_order_new.cPodr    :=GP_SCUD_PERS.cKatPodr;
    tmp_scud_order_new.cGP_SCUD_PERS:=GP_SCUD_PERS.Nrec;
    tmp_scud_order_new.Fio       :=GP_SCUD_PERS.Fio;
    tmp_scud_order_new.EventDate :=GP_SCUD_Events.EnterDate;
    tmp_scud_order_new.EventTMB  :=GP_SCUD_Events.EnterTime;
    //tmp_scud_order_new.EventTME  :=add_time(tmp_scud_order_new.EventTMB,iGP_SCUD_EventsEdit_Cacl.GetTimeFromDouble(ch));
    //tmp_scud_order_new.Diff      :=ch;
    case _wType of
    0: tmp_scud_order_new.wType:=GP_iSC_OrderOver    ;
    1: tmp_scud_order_new.wType:=GP_iSC_OrderHoliday ;
    2: tmp_scud_order_new.wType:=GP_iSC_OrderOver2   ;
    end;
    insert current tmp_scud_order_new;
  StopVisual('',0);
  pGP_SCUD_Order.MakeOrder;
  oGP_Log.Done(true);
  if TimeLog_Status>0 timelog('GP_SCUD_EventsEdit>MakeOrder finish');

  Result:=true;
} //Function MakeOrder(_wType:word);


//----------------------------------------------------------------------------
#doc
 Вызывать после CalcAll
 Если была вторая смена найти за день _wDay
 _tShift1End   - время выхода с первой смены
 _tShift2Start - время входа на вторую смену
 _Graf2        - продолжительность второй смены
#end
Function FindMidleExit(_wDay:word;var _tShift1End:time; var _tShift2Start:time; var _Graf2:Time):Boolean;
{ Result:=false;
  _tShift1End:=_tShift2Start:=_Graf2:=ZeroTime;
  if  pGRAFF_WorkPeriod.StartShift2 [_wDay]=ZeroTime then Exit;
  _Graf2:=Sub_time(pGRAFF_WorkPeriod.EndShift2 [_wDay],pGRAFF_WorkPeriod.StartShift2 [_wDay]);
  var _wDT:date=Date(_wDay,month(DTB_A), year(DTB_A)) ;
  // найдем последний выход до начала второй смены
  if getlast GP_SCUD_Events_Prev where  (( pGP_SCUD_Pers == GP_SCUD_Events_Prev.cGP_SCUD_Pers
    and _wDT == GP_SCUD_Events_Prev.EnterDate
    and pGRAFF_WorkPeriod.StartShift2 [_wDay] >>GP_SCUD_Events_Prev.EnterTime(noindex)
    and 0 == GP_SCUD_Events_Prev.wResource(noindex) //выход
    ))=tsok
  { _tShift1End:=GP_SCUD_Events_Prev.EnterTime;
  }
  // найдем первый вход после выхода с первой смены
  if getfirst GP_SCUD_Events_Prev where  (( pGP_SCUD_Pers == GP_SCUD_Events_Prev.cGP_SCUD_Pers
    and _wDT == GP_SCUD_Events_Prev.EnterDate
    and _tShift1End << GP_SCUD_Events_Prev.EnterTime(noindex)
    and 1 == GP_SCUD_Events_Prev.wResource(noindex) //выход
    ))=tsok
  { _tShift2Start:=GP_SCUD_Events_Prev.EnterTime;
  }
  Result:=_tShift2Start<>ZeroTime;
} //Function FindMidleExit(_wDay:word;var _tShift1End; var _tShift2Start :time;var _Graf2:Time)Boolean;
