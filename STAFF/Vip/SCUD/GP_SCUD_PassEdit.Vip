  Show at (,,80);
Table GP_SCUD_Pers
Fields
  GP_SCUD_Pers.Fio          :NoProtect,NoPickButton,NoDel;
  GP_SCUD_Pers.Code         :NoProtect,NoPickButton,NoDel;
  KatPodr.Name             ('Подразделение',,sci178Esc): Protect,NoDel;
  [sType] GetPersTypeName(GP_SCUD_Pers.wType) ('Тип') :[30],Protect;
  KatOrg.Name              ('Организация',,sci178Esc): Protect,NoDel;
  [Kateg] iGP_SCUD_KATEGEdit.GetKategName(GP_SCUD_Pers.CGP_SCUD_KATEG) ('Категории сотрудников',,sci178Esc): Protect,PickButton ;
  [Grup]  iGP_SCUD_GrupEdit.GetGrupName (GP_SCUD_Pers.CGP_SCUD_GRUP) ('Группа сотрудников',,sci178Esc): Protect,PickButton ;
  [LbPropusk] 'Пропуск'    :Protect,Skip,{Font= {Bold=true}};
  GP_SCUD_Pers.PROPUSK_NMB          ('Пропуск, номер'):NoProtect,NoDel;
  GP_SCUD_Pers.PROPUSK_FROM         ('Пропуск, действует с'):NoProtect,NoDel;
  [Propus_Lock] if(GP_SCUD_Pers.PROPUSK_Lock=0,'нет','да') :Protect,NoDel
   ,{Font={Color=if(GP_SCUD_Pers.PROPUSK_Lock=0,ColorSysBlack,ColorSysRed)}};
  GP_SCUD_Pers.PROPUSK_TO           ('Пропуск, действует по'):NoProtect,NoDel;
  KLREJIM.NRejim                    ('Режим',,sci1378Esc) : Protect,Pickbutton;
  [sExt_Key] if(GP_SCUD_Pers.EXT_KEY<>'','Да','')   ('Внешний ключ') : Protect,NoPickbutton,NoDel;
  [TB] if((GP_SCUD_Pers.PROPUSK_TB and 1)>0,'Да','')  ('Техника безопасности'):Protect,NoDel;

<<
 `ФИО`           .@@@@@@@@@@@@@@@@@@@@@@@@@@ `Таб.Номер/код` .@@@@@@@@@@@@@
 `Подразделение` .@@@@@@@@@@@@@@@@@@@@@@@@@@ `Тип`           .@@@@@@@@@@@@@
 `Организация`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Категория`     .@@@@@@@@@@@@@@@@@@@@@@@@@@ `Группа`        .@@@@@@@@@@@@@
 .@@@@@@@@@@@@@@ `Номер` .@@@@@@@@@@@@@@@@@@ `Выдан`         .@@@@@@@@@@@@@
                 `Заблокирован`    .@@@@@@@@ `Действует до ` .@@@@@@@@@@@@@
 `Режим работы`  .@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Экспортирован в СКУД`  .@@@@@@            `Техника безопасности`  .@@@@@@
>>
