Procedure PositionChanged;
{ SetEditMode(CanEdittbl);
  var _wnrec:comp;
  _wnrec:=0;
  _wnrec:=GP_SCUD_Pers.Nrec;

  iGP_SCUD_EventsEdit.InitParam(
       cgiNotEdit
      ,0,_wnrec
      ,0,0
      ,date(0,0,0)
      ,date(0,0,0)
      ,false);
}
//-----------------------------------------
//   Проинициализровать данные
//-----------------------------------------
Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _cNrec     : comp;  // ссылка на "Ведомость"
  _cPersons  : comp;   // выбранная запись
  _cKatpodr  : comp;   // выбранная запись
  _cKatOrg   : longint; // включить определенные форматы
  _DTB       : Date; //период просмотра
  _DTE       : Date; //период просмотра
  _NoVisual  : boolean=false //не перерисовывать экраны
  ) : boolean;
{ Result:=False;
  Result:=True;
} //Function InitParam(


//---------------------------------------------
// Тип документа
//---------------------------------------------
Function GetTypeDoc:word;
{ Result:=GP_iSC_Pass_Employees;//1007; //
}

//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{  inherited ::LoadInterface(_boVisibleRun);
   ReadParam;
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_PassEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;

      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
   isFilterRun:=false;
} //Procedure LoadInterface(_wRunType:word);


//---------------------------------------------
// получить наименование
//---------------------------------------------
Function GetPodrOrgName(_pNrec:comp):string;
{ Result:='';
  if GP_SCUD_Pers.wType=0
  { if isValid(#KatPodr)
      Result:=Katpodr.Kod+','+Katpodr.name;
  }
  else
  { if isValid(#KatOrg)
      Result:=KatOrg.name;
  }
} //Function GetPodrOrgName(_pNrec:comp):string;



