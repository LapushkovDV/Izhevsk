//------------------------------------
// декларация сложного фильтра
//------------------------------------
function isFilterAnCorrect(ww_nrec:comp): boolean; forward;
//------------------------------------
#include GetKau.var
#include GP_SCUD_GrupEdit.Var
#include GP_SCUD_KategEdit.Var
//--------------------------------------------
var
//-------------------
  iGP_SCUD_EventsEdit :GP_SCUD_EventsEdit New;
  viCYPersons         : ChoiseYourPersons;
  iCatFunc            : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  pMarker:IMarker(Marker) new;
//-----------------------------------------

  cRec    :Comp   ; // ссылка на группу
  Marker:longint;
  //-- пометка подразделения
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
    wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;

   #mrkfld_(KatPodr)
   #mrkfld_(KatOrg)
   #mrkfld_(Persons)


   sPassPorts_Flt,sPassPorts_Flt_A : string;
   sFio_Flt      ,sFio_Flt_A       : string;
   sPropusk_Flt  ,sPropusk_Flt_A   : string;
   wType_Flt     ,wType_Flt_A      : word;
   DTB,DTE:date;
//----------------------------------------
Create View
var
   pPersons :comp;
   pKatPodr :comp;
   pKatOrg  :comp;

as select GP_SCUD_Pers.Nrec
From
  GP_SCUD_Pers(GP_SCUD_PERS02)
, GP_SCUD_Pers_Hist(GP_SCUD_Pers_Hist08)
, Persons
, KatOrg
, Katpodr
, KLREJIM
, KatPodr KatPodr_Hist
, TYPEPR
//------- фильтры
 , KatPodr    KatPodr_Flt
 , KatOrg     KatOrg_Flt
 , Persons    Persons_Flt

where ((
    GP_SCUD_Pers.cPersons == Persons.Nrec
and GP_SCUD_Pers.cKatPodr == Katpodr.Nrec
and GP_SCUD_Pers.cKatOrg  == KatOrg.Nrec
and GP_SCUD_Pers.CKLREJIM == KLREJIM.NRec
and GP_SCUD_Pers.Nrec     == GP_SCUD_Pers_Hist.cGP_SCUD_Pers
and 1001                  == GP_SCUD_Pers_Hist.wType(Noindex)
and GP_SCUD_Pers_Hist.cKatPodr == KatPodr_Hist.Nrec
and GP_SCUD_Pers_Hist.wType    == TYPEPR.CodOper //тип приказа
//------- фильтры
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == KatOrg_Flt.Nrec
and wc_nrec == Persons_Flt.Nrec

))
Bounds byPersons pPersons == GP_SCUD_Pers.cPersons(noindex) ordered by TableOrder
Bounds byKatOrg  pKatOrg  == GP_SCUD_Pers.cKatOrg (noindex) ordered by TableOrder
Bounds byKatPodr pKatPodr == GP_SCUD_Pers.cKatPodr(noindex) ordered by TableOrder
Bounds byType    wType_Flt== GP_SCUD_Pers.wType   (noindex) ordered by TableOrder
condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_Pers.Nrec))
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;
//*************************************************8
create view vSpr
var
  pPersons:comp;
  pAppoint:comp;
  pContDoc:comp;
as select Persons.Nrec
From Persons,Passports,ContDoc,PartDoc
where ((
     pPersons == Persons.Nrec
and  Persons.PasspRus == Passports.nrec
and  pAppoint      == Appointments.Nrec
and  pContDoc      == ContDoc.nrec
and  ContDoc.cPart == PartDoc.Nrec
));
//*************************************************8
QuickChoice qcByCode
{
  AcceptField = GP_SCUD_Pers.Nrec;
  ViewField = GP_SCUD_Pers.Code;
  ViewField = GP_SCUD_Pers.Fio;
  // только текстовый поля!
  SearchField = GP_SCUD_Pers.Code;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Pers.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_Pers.Nrec;
  ViewField = GP_SCUD_Pers.Fio;
  ViewField = GP_SCUD_Pers.Code;
  // только текстовый поля!
  SearchField = GP_SCUD_Pers.Fio;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Pers.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName

//******************************************************************************
// Функции
//******************************************************************************
  //------------------------------------
  // сохранить параметры
  //------------------------------------
  Procedure SaveParam;
  { if (boVisibleRun)
    {
      SaveMyDsk(wFilter  ,GetInterfaceName+'_wFilter');
      SaveMyDsk(DTB      ,GetInterfaceName+'_DTB');
      SaveMyDsk(DTE      ,GetInterfaceName+'_DTE');
      SaveMyDsk(wType_Flt,GetInterfaceName+'_wType_Flt');
    }
    //-----------------------
    DoneMarker(Marker_Persons_A, '' );
    DoneMarker(Marker_KatPodr_A, '' );
    DoneMarker(Marker_KatOrg_A , '' );
    //-----------------------
    DoneMarker(Marker_Persons,if(not boVisibleRun,'', GetInterfaceName+'_Persons') );
    DoneMarker(Marker_KatOrg ,if(not boVisibleRun,'', GetInterfaceName+'_KatOrg' ) );
    DoneMarker(Marker_KatPodr,if(not boVisibleRun,'', GetInterfaceName+'_KatPodr') );
  } //Procedure SaveParam;

  //------------------------------------
  // восстановить параметры
  //------------------------------------
  Procedure ReadParam;
  { if (boVisibleRun)
    {
      if not ReadMyDsk(wFilter,GetInterfaceName+'_wFilter',false) wFilter:=0;
      if not ReadMyDsk(DTB    ,GetInterfaceName+'_DTB'    ,false) DTB:=ZeroDate;
      if not ReadMyDsk(DTE    ,GetInterfaceName+'_DTE'    ,false) DTE:=ZeroDate;
      if not ReadMyDsk(wType_Flt,GetInterfaceName+'_wType_Flt',false) wType_Flt:=0;
    }
    Marker_Persons  :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_Persons') , 8, 50, 10, True);
    Marker_KatOrg   :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatOrg' ) , 8, 50, 10, True);
    Marker_KatPodr  :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatPodr') , 8, 50, 10, True);

    Marker_Persons_A  :=InitMarker('' , 8, 50, 10, True);
    Marker_KatOrg_A   :=InitMarker('' , 8, 50, 10, True);
    Marker_KatPodr_A  :=InitMarker('' , 8, 50, 10, True);

  } //  Procedure ReadParam;


  //------------------------------------
  // декларация сложного фильтра
  //------------------------------------
  function isFilterAnCorrect(ww_nrec:comp): boolean; cacheable;
  { Result:=true;
    if isPodrShare
    { if GP_SCUD_Pers.wType=0
       if not EnablePodr(GP_SCUD_Pers.cKatPodr)
        { Result:=false;
          Exit;
        }
    }
    if IsBitCTW(wFilter,1)
    { if Count_KatPodr>1
      { If not FoundMarker(Marker_KatPodr_A,GP_SCUD_Pers.cKatPodr)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,2)
    { if Count_KatOrg>1
      { If not FoundMarker(Marker_KatOrg_A,GP_SCUD_Pers.cKatOrg)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,3)
    { if Count_Persons>1
      { If not FoundMarker(Marker_Persons_A,GP_SCUD_Pers.cPersons)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,4)
    { if Pos(UpCase(sFio_Flt),UpCase(GP_SCUD_Pers.Fio) )=0
      { Result:=false;
        Exit;
      }
    }
    if IsBitCTW(wFilter,5)
    { if Pos(UpCase(sPropusk_Flt),UpCase(GP_SCUD_Pers.Propusk_NMB) )=0
      { Result:=false;
        Exit;
      }
    }

  }//function isFilterAnCorrect(ww_nrec:comp): boolean;

    //-------------------------------------------
  // скопировать фильтры в данные для отборв
  //-------------------------------------------
  Procedure CopyToA;
  { CopyMarker(Marker_Persons_A ,Marker_Persons);
    CopyMarker(Marker_KatOrg_A  ,Marker_KatOrg );
    CopyMarker(Marker_KatPodr_A ,Marker_KatPodr);
    sFio_Flt_A      :=sFio_Flt      ;
    sPropusk_Flt_A  :=sPropusk_Flt  ;
    wType_Flt_A     :=wType_Flt     ;

  } //Procedure CopyToA;

  //-------------------------------------------
  // восстановить данные для задания фильтрации
  // из данных для отбора
  //-------------------------------------------
  Procedure RestFromA;
  { CopyMarker(Marker_Persons ,Marker_Persons_A);
    CopyMarker(Marker_KatOrg  ,Marker_KatOrg_A );
    CopyMarker(Marker_KatPodr ,Marker_KatPodr_A);
    sFio_Flt      :=sFio_Flt_A      ;
    sPropusk_Flt  :=sPropusk_Flt_A  ;
    wType_Flt     :=wType_Flt_A     ;
  } //Procedure RestFromA;

  //-------------------------------------------
  #doc
    Установить ограничения
  #end
  Function SetFilterBounds(_IsArch:word) : boolean;
  { Result:=false;
    isFilterRun:=True;
    if ConditionActiveInLeave(tcFilterAn, #GP_SCUD_Pers)
    { PopConditionForLeave(tcFilterAn, #GP_SCUD_Pers);
    }
    If BoundActive(tbByPersons) SubBounds(tbByPersons);
    If BoundActive(tbByKatPodr) SubBounds(tbByKatPodr);
    If BoundActive(tbByKatOrg ) SubBounds(tbByKatOrg );
    If BoundActive(tbByType   ) SubBounds(tbByType   );
    //-----------------------
    CopyToA;
    //-----------------------
    ClearFuncCache; // очистим кэш функций
    var need_FilterAn:boolean=false;
    if IsBitCTW(wFilter,1)
    {  Count_KatPodr:=GetMarkerCount(Marker_KatPodr);
       GetMarker(Marker_KatPodr,0,pKatPodr);

       if Count_KatPodr=1
       { AddBounds(tbByKatPodr);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,2)
    {  Count_KatOrg:=GetMarkerCount(Marker_KatOrg);
       GetMarker(Marker_KatOrg,0,pKatOrg);

       if Count_KatOrg=1
       { AddBounds(tbByKatOrg);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,3)
    {  Count_Persons:=GetMarkerCount(Marker_Persons);
       GetMarker(Marker_Persons,0,pPersons);
       if Count_Persons=1
       {
         AddBounds(tbByPersons);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,4) or IsBitCTW(wFilter,5)
      need_FilterAn:=true;
    if IsBitCTW(wFilter,4)
    { AddBounds(tbByType);

    }
    if isPodrShare need_FilterAn:=true;

    // использование сложного фильтра
    if need_FilterAn
    { PushConditionForLeave(tcFilterAn, #GP_SCUD_Pers);
    }
    ReReadRecord(#GP_SCUD_Pers);
    Result:=true;
    isFilterRun:=False;

  } //Function SetFilterBounds : boolean;

  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_Katpodr
    { #mrkfiltr_(Katpodr_Flt,Katpodr,Nrec,wc_nrec,Katpodr_Flt.Kod+','+Katpodr_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_Katorg
    { #mrkfiltr_(KatOrg_Flt,KatOrg,Nrec,wc_nrec,KatOrg_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_Persons
    { #mrkfiltr_(Persons_Flt,Persons,Nrec,wc_nrec,Persons_Flt.Fio)
    }
    ReScanPanel(#KatPodr_Flt);
  } //Procedure SetFilterNM(_Field:longint)



//-----------------------------------------
// Получить наименование
//-----------------------------------------
Function GetPersName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Pers where
          (( _pNrec == GP_SCUD_Pers.nrec ))<>tsok exit;
  Result:=GP_SCUD_Pers.Fio;
} //Function GetPersName(_pNrec:comp)   :string; cacheable;

//-----------------------------------------
// Получить код
//-----------------------------------------
Function GetPersCode(_pNrec:comp)   :string;cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Pers where
          (( _pNrec == GP_SCUD_Pers.nrec ))<>tsok exit;
  Result:=GP_SCUD_Pers.Code;
} //Function GetPersCode(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить тип
//-----------------------------------------
Function GetPersType(_pNrec:comp)   :word;cacheable;
{ GetPersType:=0;
  if getfirst fastfirstrow GP_SCUD_Pers where
          (( _pNrec == GP_SCUD_Pers.nrec ))<>tsok exit;
  Result:=GP_SCUD_Pers.wType;

} //Function GetPersType(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetPersTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  0: Result:='сотрудники предприятия ';
  1: Result:='внешние подрядчики';
  2: Result:='прочие';
  end;
} //Function GetPersTypeName(_wType:word)   :string;cacheable;

//-----------------------------------------
// Получить наименование типа изменения данных
//-----------------------------------------
Function GetTypeHistName(_wType:string) :string;
{ Result:='';
  case _wType of
  0: Result:='Создание записи';
  1..1000:
  { Result:='Кадры,приказ ';
    if getfirst TYPEPR=tsok
     Result:=Result+TYPEPR.NOPER

  }
  1001:
  { Result:='СКУД';

  }
  end;
} //Function GetTypeHistName(_wType:string) :string;


Function GetKatPodrByName(ww_str:string):comp;
{ //'Подрядчики'
  Result:=0;
  if getfirst katpodr_flt where ((ww_str == katpodr_flt.name  ))=tsok
  { Result:=katpodr_flt.nrec;
  }
} //Function GetKatPodrByName(ww_str:string):comp;

