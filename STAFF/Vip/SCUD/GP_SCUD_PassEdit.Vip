  GetPodrOrgName(GP_SCUD_Pers.Nrec) 'Подразделение/Организация' :[30],Protect,NoDel;
  GP_SCUD_Pers.PROPUSK_NMB     'Пропуск'       ('Пропуск, номер'):Protect,NoDel;
  GP_SCUD_Pers.PROPUSK_FROM    'Выдан'         ('Пропуск, действует с'):Protect,NoDel;
