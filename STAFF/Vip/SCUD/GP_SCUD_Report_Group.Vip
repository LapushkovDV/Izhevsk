#include GP_SCUD_Report_Group.Vih

#doc
СКУД Настройка группировок отчетов
#end

Interface GP_SCUD_Report_Group 'Список группировок отчета' DoAccept, EscClose;
Show at (,,,);
#include GP_SCUD_Report.Inc
//_MacroGroupVarScud_
#declare InsCaseGr (wi)
 wKod :=#(wi);
 sName:=GetLevelName(#(wi));

#end
!-------------------------------------------------------------------------------
Table Struct tbl_name_gr "Группировки"
(
  npp  : word   "npp",
  kod  : word   "kod",
  name : string "name"
)
With Index
(
  ind01 = npp,
  ind03 = kod(Unique),
  ind02 = name(Unique)
);
!-------------------------------------------------------------------------------

Create view
var
 IndexNo       :Longint;
 GrRepZarMarker:Longint;
 GrRepZarCount :Longint;
 NameGroup     :String;
 KodGroup      :String;
 nppTmp        :Word;
 kodTmp        :Word;
// для работы с Excel

as select tbl_name_Gr.*
from tbl_name_Gr
    ,tbl_name_Gr tbl_LLL
    ,tbl_name_Gr tbl_RRR
where
((  0 == tbl_LLL.npp
AND 0 << tbl_RRR.npp
))
;

Parameters
  NameGroup,
  KodGroup;

//=======================================
//Сохраним параметры
//=======================================
Procedure SaveParam;
{
} //Procedure SaveParam

//=======================================
//Чтение параметров
//=======================================
//=======================================
//Чтение параметров
//=======================================
Procedure ReadParam;
var wkl   :Boolean;
    iii   :Word;
    wKod  :Word;
    sName :String;
    arrLen:Word;
{
  wkl:=False;

  arrLen:=cg_s_Len_a_gr; //!!!

//  message(NameGroup);
//  message(KodGroup);

  delete all tbl_name_Gr;

  //Заполним левую панель
  for(iii:=1;iii<=word(arrLen);iii:=iii+1)
  {
    #InsCaseGr(iii)
    if(wKod<>0 AND sName<>'')
    { clearbuffer(#tbl_name_Gr);
       tbl_name_Gr.npp :=0;
       tbl_name_Gr.kod :=wKod;
       tbl_name_Gr.name:=sName;
      insert current tbl_name_Gr;
    } //if
  } //for

  //Заполним правую панель
  if(KodGroup<>'')
  {
    MySetGroupMasScud(KodGroup);
    nppTmp:=0;
    for(iii:=1;iii<=word(arrLen);iii:=iii+1)
    {
      #InsCaseGr(a_GroupRepScud[iii])
      if(wKod<>0 AND sName<>'')
      { if GetFirst tbl_name_Gr Where (( wKod == tbl_name_Gr.kod )) = tsOk
        { nppTmp:=nppTmp+1;
           tbl_name_Gr.npp :=nppTmp;
          Update current tbl_name_Gr;
        } //if GetFirst
      } //if
    } //if
  } //if

  ReReadRecord(#tbl_name_Gr);
  ReReadRecord(#tbl_LLL);
  ReReadRecord(#tbl_RRR);
  ReDrawPanel(#tbl_LLL);
  ReDrawPanel(#tbl_RRR);
} //Procedure ReadParam

//*******************************************************************************
Panel pnLeft;
  Table tbl_LLL;
Browse brLeftPanel (,,sci1Esc);
  Show  at (,,34, 18) ;
Fields
//  tbl_LLL.npp   'npp' (,,) : [2], Protect;
//  tbl_LLL.kod   'kod' (,,) : [2], Protect;
  tbl_LLL.Name  'Доступные элементы','группировки' (,,) : [35], Protect;
end;
//HandleEvent
//cmPositionChanged : {}
//end; //HandleEvent
end; //Panel pnLeft
//*******************************************************************************
Panel pnRight;
  Table tbl_RRR;
Browse brRightPanel (,, sci14Esc);
  Show  at (58,, 91, 18) ;
Fields
//  tbl_RRR.npp   'npp' (,,) : [2], Protect;
//  tbl_RRR.kod   'kod' (,,) : [2], Protect;
  tbl_RRR.Name  'Выбранные уровни','группировки' (,,) : [35], Protect;
end;
//HandleEvent
//cmPositionChanged : {}
//cmCheckField : {}
//cmDelOnProtect : {}
//cmUpdateRecord : {}
//end; //HandleEvent
end; //Panel pnRight
//*******************************************************************************
panel pnButtons0;
  Table tbl_LLL;
Screen scrMoveButtonsH1 (,,sci1EnEsc);
  Show at (35,, 57, 8);
buttons
  cmMoveOne  ,,, 'Добавить в группировку',,;
  cmMoveAll  ,,, 'Добавить все в группировку',,;
<<


<. Добавить элемент >.>


<.  Добавить все >>  .>
>>
end; // screen scrMoveButtonsH
Screen scrMoveButtonsH2 (,,sci1EnEsc);
  Show at (35, 9, 57, 18);
buttons
  cmReMoveOne,,, 'Удалить из группировки',,;
  cmReMoveAll,,, 'Удалить все из группировки',,;
<<


<.< Удалить элемент  .>


<.  << Удалить все   .>
>>
end; // screen scrMoveButtonsH
//*******************************************************************************
Screen scrMoveButtonsV (,, sci1EnEsc);
  Show at (92,,, 18);
Buttons
  cmMoveUp   ,,, 'Переместить вверх элемент группировки',,;
  cmMoveDown ,,, 'Переместить вниз элемент группировки',,;
<<

<. Выше .>

<. Ниже .>
>>
end; // screen scrMoveButtonsV
//*******************************************************************************
Screen scrOkCancel (,, sci1EnEsc);
  Show at (, 19,, );
Fields
  NameGroup ('Наименование группировки') : Protect;
Buttons
  cmValue2, Default,, 'Сохранить изменения',,;
  cmValue3,,,         'Отменить все сделанные изменения',,;
<<
  Наименование группировки
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@            <. Сохранить .>  <. Отмена .>

>>
end; // screen scrMoveButtonsV
//HandleEvent
//cmCheckField : {}
//end;
end; //panel pnButtons0;

HandleEvent

cmMoveOne  :
{
//message('Добавить в группировку');

if GetFirst tbl_name_Gr Where (( 0 == tbl_name_Gr.npp )) = tsOk
{
nppTmp:=0;
if GetLast tbl_RRR = tsOk Then nppTmp:=tbl_RRR.npp;
nppTmp:=nppTmp+1;
update current tbl_LLL set tbl_LLL.npp:=nppTmp;
ReReadRecord(#tbl_name_Gr);
ReReadRecord(#tbl_LLL);
ReReadRecord(#tbl_RRR);
nppTmp:=0;
_loop tbl_RRR
{ nppTmp:=nppTmp+1;
  update current tbl_RRR set tbl_RRR.npp:=nppTmp;
}
if GetFirst tbl_LLL = tsOk {}
if GetFirst tbl_RRR = tsOk {}
} //if
ReReadRecord(#tbl_name_Gr);
ReReadRecord(#tbl_LLL);
ReReadRecord(#tbl_RRR);
ReDrawPanel(#tbl_LLL);
ReDrawPanel(#tbl_RRR);
} //cmMoveOne

cmMoveAll :
{
//message('Добавить все в группировку');
if GetFirst tbl_name_gr Where (( 0 == tbl_name_gr.npp )) = tsOk
{
nppTmp:=0;
_loop tbl_LLL
{ nppTmp:=nppTmp+1;
  update current tbl_LLL set tbl_LLL.npp:=nppTmp;
}
if GetFirst tbl_LLL = tsOk {}
if GetFirst tbl_RRR = tsOk {}
} //if
ReReadRecord(#tbl_name_gr);
ReReadRecord(#tbl_LLL);
ReReadRecord(#tbl_RRR);
ReDrawPanel(#tbl_LLL);
ReDrawPanel(#tbl_RRR);
} //cmMoveAll

cmReMoveOne :
{
//message('Удалить из группировки');
if GetFirst tbl_name_gr Where (( 0 << tbl_name_gr.npp )) = tsOk
{
update current tbl_RRR set tbl_RRR.npp:=0;
ReReadRecord(#tbl_name_gr);
ReReadRecord(#tbl_LLL);
ReReadRecord(#tbl_RRR);
nppTmp:=0;
_loop tbl_RRR
{ nppTmp:=nppTmp+1;
  update current tbl_RRR set tbl_RRR.npp:=nppTmp;
}
if GetFirst tbl_LLL = tsOk {}
if GetFirst tbl_RRR = tsOk {}
} //if
ReReadRecord(#tbl_name_gr);
ReReadRecord(#tbl_LLL);
ReReadRecord(#tbl_RRR);
ReDrawPanel(#tbl_LLL);
ReDrawPanel(#tbl_RRR);
} //cmReMoveOne

cmReMoveAll :
{
//message('Удалить все из группировки');
if GetFirst tbl_name_gr Where (( 0 << tbl_name_gr.npp )) = tsOk
{
update tbl_RRR set tbl_RRR.npp:=0;
} //if
ReReadRecord(#tbl_name_gr);
ReReadRecord(#tbl_LLL);
ReReadRecord(#tbl_RRR);
ReDrawPanel(#tbl_LLL);
ReDrawPanel(#tbl_RRR);
} //cmReMoveAll

cmMoveUp :
{
//message('Up');
if GetFirst tbl_name_gr Where (( 0 << tbl_name_gr.npp )) = tsOk
{
if(tbl_name_gr.kod<>tbl_RRR.kod)
{
kodTmp:=tbl_RRR.kod;
if GetPrev tbl_RRR = tsOk
{  update current tbl_RRR set tbl_RRR.npp:=tbl_RRR.npp+1;
   if GetFirst tbl_RRR Where (( kodTmp == tbl_RRR.kod )) = tsOk
   { update current tbl_RRR set tbl_RRR.npp:=tbl_RRR.npp-1;
   }
}
} //if
} //if
ReReadRecord(#tbl_name_gr);
ReReadRecord(#tbl_LLL);
ReReadRecord(#tbl_RRR);
ReDrawPanel(#tbl_LLL);
ReDrawPanel(#tbl_RRR);
} //cmMoveUp

cmMoveDown :
{
//message('Down');
if GetLast tbl_name_gr Where (( 0 << tbl_name_gr.npp )) = tsOk
{
if(tbl_name_gr.kod<>tbl_RRR.kod)
{
kodTmp:=tbl_RRR.kod;
if GetNext tbl_RRR = tsOk
{  update current tbl_RRR set tbl_RRR.npp:=tbl_RRR.npp-1;
   if GetFirst tbl_RRR Where (( kodTmp == tbl_RRR.kod )) = tsOk
   { update current tbl_RRR set tbl_RRR.npp:=tbl_RRR.npp+1;
   }
}
} //if
} //if
ReReadRecord(#tbl_name_gr);
ReReadRecord(#tbl_LLL);
ReReadRecord(#tbl_RRR);
ReDrawPanel(#tbl_LLL);
ReDrawPanel(#tbl_RRR);
} //cmMoveDown

cmValue2 :
{
//message('Сохранить изменения');
NameGroup:='';
KodGroup:='';
_loop tbl_RRR
{ NameGroup:=NameGroup+if(NameGroup='','','/')+tbl_RRR.Name;
  KodGroup:=KodGroup+if(KodGroup='','','/')+String(tbl_RRR.Kod);
}
ReDrawPanel(#tbl_LLL);
ReDrawPanel(#tbl_RRR);
CloseInterface(cmDone);
} //cmValue2

cmValue3 :
{
CloseInterface(cmDone);
} //cmValue3

cmInit :
{
ReadParam;
} //cmInit

cmDone :
{
SaveParam;
} //cmDone

end; //HandleEvent

end.
