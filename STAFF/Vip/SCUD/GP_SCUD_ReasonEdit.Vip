#include marker.vih // описание объекта и объявление интерфейса
                    // marker c реализацией по умолчанию
#include GP_Protector.Vih
#include GP_UserAccessService.vih
#include GP_StatusAccessEdit.vih
#include GP_PickRoles.Vih

#include GP_SCUD_ReasonEdit.Vih
#doc
СКУД Причины выхода
#end
Interface GP_SCUD_ReasonEdit 'СКУД Причины выхода' , EscClose;
Show At (,,70,20);
var
  cRec    :Comp   ; // ссылка на группу
  pMarker:IMarker(Marker) new;
  Marker:longint;
//настройки
  NPOEM_OWN_SCUD_ZAbsent_REASON_Protect:boolean;//'Включить разграничение по причинам выхода на заявления', ftboolean,0,'','');

Create View
var
  pGP_ROLES_Fnd:comp;
as select GP_SCUD_Reason.Nrec
From
  GP_SCUD_Reason
, tScud_Reason
, KauReff
, KauReff KauReff_FND
, GP_ROLES
where ((
     coGP_SCUD_Reason    == KauReff.COTABLE
 and GP_SCUD_Reason.Nrec == KauReff.CREC
 and coGP_ROLES          == KauReff.wKau
 //-------------------------
 and coGP_SCUD_Reason    == KauReff_FND.COTABLE
 and GP_SCUD_Reason.Nrec == KauReff_FND.CREC
 and coGP_ROLES          == KauReff_FND.wKau
 and pGP_ROLES_Fnd       == KauReff_FND.cKau
 and ( KauReff.Nrec <>KauReff_FND.Nrec)
 //-------------------------
 and KauReff.cKau == GP_ROLES.Nrec
))
bounds bytScud_Reason GP_SCUD_Reason.Nrec /==tScud_Reason.cGP_Scud_Reason

;//Create View


Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;

//*************************************************8
QuickChoice qcByCode
{
  AcceptField = GP_SCUD_Reason.Nrec;
  ViewField = GP_SCUD_Reason.Code;
  ViewField = GP_SCUD_Reason.Name;
  // только текстовый поля!
  SearchField = GP_SCUD_Reason.Code;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Reason.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_Reason.Nrec;
  ViewField = GP_SCUD_Reason.Name;
  ViewField = GP_SCUD_Reason.Code;
  // только текстовый поля!
  SearchField = GP_SCUD_Reason.Name;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Reason.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName



//-----------------------------------------
// Получить наименование
//-----------------------------------------
Function GetReasonName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Reason where
          (( _pNrec == GP_SCUD_Reason.nrec ))<>tsok exit;
  Result:=GP_SCUD_Reason.Name;
} //Function GetReasonName(_pNrec:comp)   :string; cacheable;

//-----------------------------------------
// Получить код
//-----------------------------------------
Function GetReasonCode(_pNrec:comp)   :string;cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Reason where
          (( _pNrec == GP_SCUD_Reason.nrec ))<>tsok exit;
  Result:=GP_SCUD_Reason.Code;
} //Function GetReasonCode(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить тип
//-----------------------------------------
Function GetReasonType(_pNrec:comp)   :word;cacheable;
{ GetReasonType:=0;
  if getfirst fastfirstrow GP_SCUD_Reason where
          (( _pNrec == GP_SCUD_Reason.nrec ))<>tsok exit;
  Result:=GP_SCUD_Reason.wType;

} //Function GetReasonType(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetReasonTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  1: Result:='Личное заявление';
  2: Result:='Поручение руководителя';
  3: Result:='Нарушение дисциплины';
  4: Result:='Гособязанность';
  5: Result:='Прочее';
  end;
} //Function GetReasonTypeName(_wType:word)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetReasonTypeNrec(_wType:word)   :comp;cacheable;
{ Result:=0;
  if getfirst fastfirstrow GP_SCUD_Reason where
          (( _wType == GP_SCUD_Reason.wType ))<>tsok exit;
  Result:=GP_SCUD_Reason.Nrec;
} //Function GetReasonTypeName(_wType:word)   :string;cacheable;

//-----------------------------------------
// Вставить первоначальные значения
//-----------------------------------------
Procedure Ins_GP_SCUD_Reason(_Num:word);
{ ClearBuffer(#GP_SCUD_Reason);
  GP_SCUD_Reason.Code:=LpadCh(string(_Num),'0',3);
  GP_SCUD_Reason.Name:=GetReasonTypeName(_Num);
  GP_SCUD_Reason.wType:=_Num;
  Insert Current GP_SCUD_Reason;
} //Procedure Ins_GP_SCUD_Reason(_Num:word);


//---------------------------------------------
// Тип документа
//---------------------------------------------
Function GetTypeDoc:word;
{ Result:=GP_iSC_Reasons_for_withdrawal;//1005; //
}

Procedure Fill_tScud_Reason;
var _pUserID:comp;
{ delete all tScud_Reason;
  if not NPOEM_OWN_SCUD_ZAbsent_REASON_Protect
  { SQL select
       GP_Scud_Reason.Nrec as cGP_Scud_Reason
      ,GP_Scud_Reason.Name as Name
    From GP_Scud_Reason
    into tScud_Reason;
  }
  else
  { _pUserID:=UserID();
    SQL select Distinct
       GP_Scud_Reason.Nrec as cGP_Scud_Reason
      ,GP_Scud_Reason.Name as Name
    From GP_Scud_Reason
    left outer join KauReff on
            KauReff.wKau    = 31526 //coGP_ROLES
       and  KauReff.COTABLE = 31556//coGP_SCUD_Reason
       and  KauReff.CREC    = GP_SCUD_Reason.Nrec
    left outer join GP_ROLES on
            GP_ROLES.Nrec = KauReff.cKau
    left outer join GP_USERROLES on
            GP_USERROLES.cRole = GP_ROLES.Nrec
        and GP_USERROLES.cUser = :(_pUserId)
    where COALESCE(GP_ROLES.Nrec,#Comp(0)) = #Comp(0)
    or    COALESCE(GP_USERROLES.Nrec,#Comp(0))<> #Comp(0)
    into tScud_Reason;
  }
  insert into tScud_Reason set tScud_Reason.cGP_Scud_Reason:=0;
  timelog('GP_SCUD_ReasonEdit->Fill_tScud_Reason: отобрано '+string(REcordsInTable(#tScud_Reason)));
}//Fill_tScud_Reason

Procedure Ins_KauReffRole(_pGP_ROLES_Fnd:comp);
{ timelog('GP_SCUD_ReasonEdit->Ins_KauReffRole:_pGP_ROLES_Fnd='+string(_pGP_ROLES_Fnd,0,0));
  set pGP_ROLES_Fnd:=_pGP_ROLES_Fnd;
  if Getfirst KauReff_Fnd=tsok then exit;
  timelog('GP_SCUD_ReasonEdit->Ins_KauReffRole:Вставка записи'+string(_pGP_ROLES_Fnd,0,0));
  ClearBuffer(#KauReff);
  KauReff.COTABLE:=coGP_SCUD_Reason;
  KauReff.CREC   :=GP_SCUD_Reason.Nrec;
  KauReff.wKau   :=coGP_ROLES;
  KauReff.cKau   :=_pGP_ROLES_Fnd;
  if insert current KauReff=tsok {};
} //Procedure Ins_KauReffRole;

//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{     //'Включить разграничение по причинам выхода на заявления', ftboolean,0,'','');
      NPOEM_OWN_SCUD_ZAbsent_REASON_Protect:=boGetTune('NPOEM_OWN.SCUD.ZAbsent_REASON_Protect');
      Fill_tScud_Reason;
      inherited ::LoadInterface(_boVisibleRun);
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_ReasondEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;

      //===========================
      if (not UserAccessService.IsAdmin)
      { if wIntMode=0
        { //message('Вы не обладаете ролью Администратор.'#13'Редактирование запрещено.');
        }
        wIntMode:=wIntMode or cgiNotEdit
      }
      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
} //Procedure LoadInterface(_wRunType:word);


//************************************
Browse brReason '' (,,sci178Esc) ;
Show At (,,,15);
Table GP_SCUD_Reason;
recMarker=pMarker;
Fields
  GP_SCUD_Reason.Code        'Код' :[20],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Reason.Name        'Наименование' :[40],NoProtect,NoPickButton,NoDel;
  //GP_SCUD_Reason.Description 'Описание'     :[40],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Reason.wType       'Тип' :[30], [List
     0 '-'
    ,1 'Личное заявление'
    ,2 'Поручение руководителя'
    ,3 'Опоздание'
    ,4 'Гособязанность'
    ,5 'Прочее'
    ],Protect;

end;//Browse brGroupPers

//************************************
Browse brRole '' (,,sci178Esc);
Show At (,16,,);
Table KauReff;
Fields
  GP_ROLES.Name 'Наименования ролей , имеющих доступ к причине' ('Оставьте пустым для доступа всем',,sci178Esc) : Protect;
end;//Browse brRole '' (,,sci178Esc);





//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table KauReff;
cmSetDefault :exit;
cmInsertRecord:exit;
cmInsert:
{ var _cRole:comp=0;
  var Marker_Tmp:TPtr=InitMarker('',8,0,1);
  var ii:longint;

  var _cCurRoleGroup :comp= UserAccessService.RoleGroup;
  if RunInterface(GP_COMMON::GP_PICKROLES,_cCurRoleGroup ,Marker_Tmp)<>cmCancel
  { timelog('GP_SCUD_ReasonEdit->KauReff:cmInsert');

    for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
    { timelog('GP_SCUD_ReasonEdit->KauReff:cmInsert ii:= '+string(ii)) ;

      if getMarker(Marker_Tmp,ii,_cRole)
        Ins_KauReffRole(_cRole );
    }
  }
  DoneMarker(Marker_Tmp,'');
  abort;

}
cmDeleteRecord:
{ if message('Удалить привязку к роли?',YesNo)=cmYes
    delete current KauReff;
}
end;


TableEvent table GP_SCUD_Reason;
cmSetDefault:
{ ClearBuffer(#GP_SCUD_Reason);
}
cmInsertRecord:
{ var _wnrec:comp;
  _wnrec:=GetNextNrec(#GP_SCUD_Reason,0);
  insert into tScud_Reason set tScud_Reason.cGP_Scud_Reason:=_wnrec;
  GP_SCUD_Reason.Nrec:=_wnrec;
  Insert Current GP_SCUD_Reason;

}
cmUpdateRecord:
{ Update Current GP_SCUD_Reason;
}
cmDeleteRecord:
{ delete Current GP_SCUD_Reason;
}
end; //GP_SCUD_Reason


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      //-----------------------
      PushBounds(tbbytScud_Reason);
      //-----------------------
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if wIntMode=0
      { if getfirst GP_SCUD_Reason<>tsok
        { Ins_GP_SCUD_Reason(1);
          Ins_GP_SCUD_Reason(2);
          Ins_GP_SCUD_Reason(3);
        }
        cfsSetProp('brReason', 'RectB_Y', 15);
        cfsSetProp('brRole', 'Visible', true);
      } //if wIntMode=0
      else
      { cfsSetProp('brRole', 'Visible', False);
        cfsSetProp('brReason', 'RectB_Y', 20);
      }
      if cRec>0
      { if getfirst GP_SCUD_Reason where (( cRec == GP_SCUD_Reason.nrec ))=tsok {}
      }
      ReScanPanel(#GP_SCUD_Reason);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Reason.Nrec;
        }
        CloseInterface(cmDefault)
      }
    }
  end;
end.
