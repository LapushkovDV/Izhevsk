Interface GP_SCUD_KategEdit 'СКУД Категории сотрудников' , EscClose;
Show At (,,120,20) ;
var
  cRec    :Comp   ; // ссылка на группу
  pMarker:IMarker(Marker) new;
  Marker:longint;
Create View
as select GP_SCUD_Kateg.Nrec
From
  GP_SCUD_Kateg
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;

