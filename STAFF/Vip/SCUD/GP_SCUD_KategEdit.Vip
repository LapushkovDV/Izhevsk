QuickChoice qcByCode
{
  AcceptField = GP_SCUD_Kateg.Nrec;
  ViewField = GP_SCUD_Kateg.Code;
  ViewField = GP_SCUD_Kateg.Name;
  // только текстовый поля!
  SearchField = GP_SCUD_Kateg.Code;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Kateg.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_Kateg.Nrec;
  ViewField = GP_SCUD_Kateg.Name;
  ViewField = GP_SCUD_Kateg.Code;
  // только текстовый поля!
  SearchField = GP_SCUD_Kateg.Name;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Kateg.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName

var pVA_WorkDayStart1: comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Начало рабочего дня с' , cgAttrType_Time);
var pVA_WorkDayStart2: comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Начало рабочего дня по', cgAttrType_Time);
var pVA_DinnerStart1:  comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Начало обеда с'        , cgAttrType_Time);
var pVA_DinnerStart2:  comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Начало обеда по'       , cgAttrType_Time);
var pVA_DinnerTime:    comp = ExtAttr_Create(coGP_SCUD_Kateg, 'Длительность обеда'    , cgAttrType_Time);

//-----------------------------------------
// Получить наименование
//-----------------------------------------
Function GetKategName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Kateg where
          (( _pNrec == GP_SCUD_Kateg.nrec ))<>tsok exit;
  Result:=GP_SCUD_Kateg.Name;
} //Function GetKategName(_pNrec:comp)   :string; cacheable;

//-----------------------------------------
// Получить код
//-----------------------------------------
Function GetKategCode(_pNrec:comp)   :string;cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Kateg where
          (( _pNrec == GP_SCUD_Kateg.nrec ))<>tsok exit;
  Result:=GP_SCUD_Kateg.Code;
} //Function GetKategCode(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить тип
//-----------------------------------------
Function GetKategType(_pNrec:comp)   :word;cacheable;
{ GetKategType:=0;
  if getfirst fastfirstrow GP_SCUD_Kateg where
          (( _pNrec == GP_SCUD_Kateg.nrec ))<>tsok exit;
  Result:=GP_SCUD_Kateg.wType;

} //Function GetKategType(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetKategTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  1: Result:='Круглосуточный доступ без обязательной регистрации в СКУД';
  2: Result:='круглосуточный доступ с обязательной регистрацией';
  3: Result:='свободный проход в рабочее время по графику';
  4: Result:='работающие за периметром' ;
  5: Result:='прочие сотрудники (обязательная регистрация в СКУД)';
  6: Result:='гибкий график';
  end;
} //Function GetKategTypeName(_wType:word)   :string;cacheable;

Function GetKategTypeNrec(_wType:word) :comp;
{ Result:=0;
  if getfirst fastfirstrow GP_SCUD_Kateg where
          (( _wType == GP_SCUD_Kateg.wType ))<>tsok exit;
  Result:=GP_SCUD_Kateg.Nrec;

} //  Function GetKategTypeNrec(_wType:word) :comp;


//-----------------------------------------
// Вставить первоначальные значения
//-----------------------------------------
Procedure Ins_GP_SCUD_Kateg(_Num:word);
{ ClearBuffer(#GP_SCUD_Kateg);
  GP_SCUD_Kateg.Code:=LpadCh(string(_Num),'0',3);
  GP_SCUD_Kateg.Name:=GetKategTypeName(_Num);
  GP_SCUD_Kateg.wType:=_Num;
  Insert Current GP_SCUD_Kateg;
} //Procedure Ins_GP_SCUD_Kateg(_Num:word);


//---------------------------------------------
// Тип документа
//---------------------------------------------
Function GetTypeDoc:word;
{ Result:=GP_iSC_Category_of_Employees;//1001; //
}

//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{     inherited ::LoadInterface(_boVisibleRun);
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_Scud_KategdEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;


      if (not UserAccessService.IsAdmin)
      { if wIntMode=0
        { //message('Вы не обладаете ролью Администратор.'#13'Редактирование запрещено.');
        }
        wIntMode:=wIntMode or cgiNotEdit
      }
      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
} //Procedure LoadInterface(_wRunType:word);

function ShowAttrTime(wTable, cRec, attrId: comp): string;
var tm: time;
{
  tm := tGetAttrID(wTable, cRec, attrId);
  Result := if(tm = ZeroTime, '', tm);
}

Browse brGroupPers '' (,,sci178Esc);
Table GP_SCUD_Kateg ;
recMarker=pMarker;
Fields
  GP_SCUD_Kateg.Code        'Код' :[20],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Kateg.Name        'Наименование' :[40],NoProtect,NoPickButton,NoDel;
  //GP_SCUD_Kateg.Description 'Описание'     :[40],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Kateg.wType       'Тип' :[30], [List
     0 '-'
    ,1 'Круглосуточный доступ без обязательной регистрации в СКУД'
    ,2 'круглосуточный доступ с обязательной регистрацией'
    ,3 'свободный проход в рабочее время по графику'
    ,4 'работающие за периметром'
    ,5 'прочие сотрудники (обязательная регистрация в СКУД)'
    ,6 'гибкий график'
    ],Protect;
  [WorkDayStart1] ShowAttrTime(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_WorkDayStart1) 'Рабочий день с'    :[10], noprotect, noPickButton, {inputmask = if(GP_SCUD_Kateg.wType = 6, '99\:99', '')};
  [WorkDayStart2] ShowAttrTime(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_WorkDayStart2) 'Рабочий день по'   :[10], noprotect, noPickButton, {inputmask = if(GP_SCUD_Kateg.wType = 6, '99\:99', '')};
  [DinnerStart1]  ShowAttrTime(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_DinnerStart1)  'Обед с'            :[10], noprotect, noPickButton, {inputmask = if(GP_SCUD_Kateg.wType = 6, '99\:99', '')};
  [DinnerStart2]  ShowAttrTime(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_DinnerStart2)  'Обед по'           :[10], noprotect, noPickButton, {inputmask = if(GP_SCUD_Kateg.wType = 6, '99\:99', '')};
  [DinnerTime]    ShowAttrTime(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_DinnerTime)    'Длительность обеда':[10], noprotect, noPickButton, {inputmask = if(GP_SCUD_Kateg.wType = 6, '99\:99', '')};
end;//Browse brGroupPers



//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Kateg ;
cmSetDefault:
{ ClearBuffer(#GP_SCUD_Kateg);
}
cmInsertRecord:
{ Insert Current GP_SCUD_Kateg;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Kateg;
}
cmDeleteRecord:
{ delete Current GP_SCUD_Kateg;
}
end; //GP_SCUD_Kateg


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if wIntMode=0
      { if getfirst GP_SCUD_Kateg<>tsok
        { Ins_GP_SCUD_Kateg(1);
          Ins_GP_SCUD_Kateg(2);
          Ins_GP_SCUD_Kateg(3);
          Ins_GP_SCUD_Kateg(4);
          Ins_GP_SCUD_Kateg(5);
        }
        if getfirst GP_SCUD_Kateg where ((6 == GP_SCUD_Kateg.wType)) <> tsOk
          Ins_GP_SCUD_Kateg(6);

      }
      if cRec>0
      { if getfirst GP_SCUD_Kateg where (( cRec == GP_SCUD_Kateg.nrec ))=tsok {}
      }
      ReScanPanel(#GP_SCUD_Kateg);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_KATEG.Nrec;
        }
        CloseInterface(cmDefault)
      }
    }
    cmExprFieldChanged:
    {
      if GP_SCUD_Kateg.wType <> 6
        exit;
      var tm: time = StrToTime(ExprFieldValue, 'HH:MM');
      case CurField of
        #WorkDayStart1: tSetAttrID(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_WorkDayStart1, tm);
        #WorkDayStart2: tSetAttrID(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_WorkDayStart2, tm);
        #DinnerStart1:  tSetAttrID(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_DinnerStart1 , tm);
        #DinnerStart2:  tSetAttrID(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_DinnerStart2 , tm);
        #DinnerTime:    tSetAttrID(coGP_SCUD_Kateg, GP_SCUD_Kateg.NRec, pVA_DinnerTime   , tm);
      end;
    }
  end;
end.
