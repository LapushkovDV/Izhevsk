#include GP_SCUD_ControlerEdit.Vih
#doc
СКУД Список  устройств
#end
Interface GP_SCUD_ControlerEdit 'СКУД Список  устройств' (,,sci1Esc) , EscClose;
Show At (,,70,20);
var
  cRec    :Comp   ; // ссылка на группу
  pMarker:IMarker(Marker) new;
  Marker:longint;
Create View
as select GP_SCUD_Controler.Nrec
From
  GP_SCUD_Controler
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;



//*************************************************8
QuickChoice qcByCode
{
  AcceptField = GP_SCUD_Controler.Nrec;
  ViewField = GP_SCUD_Controler.Code;
  ViewField = GP_SCUD_Controler.Name;
  // только текстовый поля!
  SearchField = GP_SCUD_Controler.Code;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Controler.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_Controler.Nrec;
  ViewField = GP_SCUD_Controler.Name;
  ViewField = GP_SCUD_Controler.Code;
  // только текстовый поля!
  SearchField = GP_SCUD_Controler.Name;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Controler.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName



//-----------------------------------------
// Получить наименование
//-----------------------------------------
Function GetControlerName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Controler where
          (( _pNrec == GP_SCUD_Controler.nrec ))<>tsok exit;
  Result:=GP_SCUD_Controler.Name;
} //Function GetControlerName(_pNrec:comp)   :string; cacheable;

//-----------------------------------------
// Получить код
//-----------------------------------------
Function GetControlerCode(_pNrec:comp)   :string;cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Controler where
          (( _pNrec == GP_SCUD_Controler.nrec ))<>tsok exit;
  Result:=GP_SCUD_Controler.Code;
} //Function GetControlerCode(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить тип
//-----------------------------------------
Function GetControlerType(_pNrec:comp)   :word;cacheable;
{ GetControlerType:=0;
  if getfirst fastfirstrow GP_SCUD_Controler where
          (( _pNrec == GP_SCUD_Controler.nrec ))<>tsok exit;
  Result:=GP_SCUD_Controler.wType;

} //Function GetControlerType(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetControlerTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  0: Result:='Учитывать';
  1: Result:='Не Учитывать';
  end;
} //Function GetControlerTypeName(_wType:word)   :string;cacheable;


//-----------------------------------------
// Вставить первоначальные значения
//-----------------------------------------
Procedure Ins_GP_SCUD_Controler(_Num:word);
{ ClearBuffer(#GP_SCUD_Controler);
  GP_SCUD_Controler.Code:=LpadCh(string(_Num),'0',3);
  GP_SCUD_Controler.Name:=GetControlerTypeName(_Num);
  GP_SCUD_Controler.wType:=_Num;
  Insert Current GP_SCUD_Controler;
} //Procedure Ins_GP_SCUD_Controler(_Num:word);

//---------------------------------------------
// Тип документа
//---------------------------------------------
Function GetTypeDoc:word;
{ Result:=GP_iSC_list_of_devices;//1008; //
}


//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{     inherited ::LoadInterface(_boVisibleRun);
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { LoadProtector;
        DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_ControlerdEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;

      //===========================

      if (not UserAccessService.IsAdmin)
      { if wIntMode=0
        { //message('Вы не обладаете ролью Администратор.'#13'Редактирование запрещено.');
        }
        wIntMode:=wIntMode or cgiNotEdit
      }
      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
} //Procedure LoadInterface(_wRunType:word);



Browse brMain '' (,,sci1Esc);
Show at (,,,15);
Table GP_SCUD_Controler;
recMarker=pMarker;
Fields
  GP_SCUD_Controler.Code        'Код' :[20],Protect,NoPickButton,NoDel;
  GP_SCUD_Controler.Name        'Наименование' :[40],Protect,NoPickButton,NoDel;
  GP_SCUD_Controler.Description 'Описание'     :[40],Protect,NoPickButton,NoDel;
  GP_SCUD_Controler.Address     'Место установки'    :[40],Protect,NoPickButton,NoDel;
  GP_SCUD_Controler.IP_Address  'Адрес в сети'       :[40],Protect,NoPickButton,NoDel;
  GP_SCUD_Controler.wType       'Тип' :[30], [List
      0 'Учитывать'
     ,1 'НЕ Учитывать'
    ],Protect;
  GP_SCUD_Controler.EXT_KEY  'ID СКУД' :[10],Protect,NoDel;
end;//Browse brMain
text GP_SCUD_Controler.CONTENTS 'Информация' :NoProtect;// (,,Sci1Esc);
Show at (,16,,);


//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Controler;
cmSetDefault:
{ ClearBuffer(#GP_SCUD_Controler);
}
cmInsertRecord:
{ Insert Current GP_SCUD_Controler;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Controler;
}
cmDeleteRecord:
{ delete Current GP_SCUD_Controler;
}
end; //GP_SCUD_Controler


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if wIntMode=0
      { wIntMode:=cgiNotEdit; // навсегда блокируем! замечание 7 от 22.11.2017
      } //if wIntMode=0
      if cRec>0
      { if getfirst GP_SCUD_Controler where (( cRec == GP_SCUD_Controler.nrec ))=tsok {}
      }
      ReScanPanel(#GP_SCUD_Controler);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Controler.Nrec;
        }
        CloseInterface(cmDefault)
      }
    }
  end;
end.
