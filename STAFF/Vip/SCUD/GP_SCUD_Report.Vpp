//------------------------------------------
// получить наименование отчета
//------------------------------------------
Function GetReportName :string;
{ case  wTipRep of
  00: result:= 'По событиям';
  01: result:= 'За месяц';
  02: result:= 'Только итоги';
  03: result:= 'Не-выявленные неявки';
  04: result:= 'Потери рабочего времени';
  05: result:= 'Сверхурочные';
  06: result:= 'Работа в выходные';
  07: result:= 'Нарушения';
  08: result:= 'Нарушения с детализацией';
  09: result:= 'Заявления на отсутствие';
  10: result:= 'Заявления с графиком';
  11: result:= 'Парные события';
  end;
} //Function GetReportName :string;

//------------------------------------------
// Фон ячейки
//------------------------------------------
Function GetBackColorDay(ww_num:word;ww_str:string=''):longint;
{ Result:=0;
  if ww_num>0 ww_str:=tmp_Report_sp_v.dms[3+ww_num];
  if pos('/Н',ww_str)>0
  or pos('НН',ww_str)>0
  { Result:=ColorSysRed;
  }
  else
  if pos('/П',ww_str)>0
  { Result:=ColorSysLime;
  }
  else
  if pos('/CВ',ww_str)>0
  { Result:=ColorSysSilver ;
  }
  else
  if pos('/РВ',ww_str)>0
  { Result:=ColorSysFuchsia ;
  }
}

Function GetColorDaysXL(ww_str:string):longint;
var ww_color:longint;
{ Result:=0FFFFFFh;
  ww_Color:=GetBackColorDay(0,ww_str);
  if ww_Color=0 then exit;
  case ww_color of
  ColorSysRed    : Result:=00000FFh;
  ColorSysLime   : Result:=0CCFFCCh;
  ColorSysSilver : Result:=0DDDDDDh;
  ColorSysFuchsia: Result:=0FFAAFFh;
  end;

}

//-------------------------------------------
// #197 от 28.11.2017
// 2.	Заполнить колонку D <Наименование должности руководителя функционального
// направления деятельности, в чьем подчинении находится структурное подразделение>.
// Выводить туда наименование вышестоящего подразделения уровня ЗГД,
// либо <Генеральный директор> для подразделений, у которых нет вложенных подразделений,
// и которые подчинены Генеральному директору, например для подразделений 940:
//-------------------------------------------
Create view vPodr
var
 pPodr:comp;
as select Katpodr.Kod,KatPodr.Name
from katpodr where (( pPodr == Katpodr.Nrec ));
//------------------------------------
Function FindZGD(_pPodr:comp; Flag_ZGD:boolean=false) :string;cacheable;
{ Result:='';
  vPodr.pPodr:=_pPodr;
  if vPodr.getfirst KatPodr=tsok
  { if Flag_ZGD
    { Result:=vPodr.KatPodr.Kod;
      Exit;
    }
    if vPodr.KatPodr.cPodr=0 exit;
    Result:=FindZGD(vPodr.KatPodr.cPodr,pos('-',vPodr.KatPodr.Kod)=0);
  }
} //Function FindZGD(_pDep:comp) :string;cacheable;

//=======================================
// Найти ФИО ЗГД
//=======================================
Function GetFioZGD(_pPersFrom:comp):string;cacheable;
{ Result:='';
  var _pPost,_pPersons :comp=0;
  Get_Func_Boss_By_Pers(_pPersFrom,_pPost,_pPersons,DTend);
  if _pPersons>0
  { vSpr.pPersons:=_pPersons;
    if vSpr.Getfirst Persons=tsok
     Result:=MyGetInitial(vSpr.Persons.Fio,True);
  }
} //Function GetFioZGD(_pPersFrom:comp):string;cacheable;

//=======================================
//Скрываем колонки в XLS
//=======================================
Function HideShowColumnXLS(hideColumn:longint; _width:word=0):boolean;
{
  Result:=xlSetColumnWidth(_width, 1,hideColumn, 1,hideColumn);
}

//=======================================
//Печать фильтра конец
//=======================================
Procedure PrnFilterXLS_end;
{
  if Not(boPrnFilter) Then Exit;

  if (wFilter)>0
  {
  wexrow:=wexrow+1;
  wexcol:=1;
  xlMergeCells(wexrow,wexcol, wexrow,maxColCount); //Объединяем ячейки
!  MyPutExcel('',10,0,-1,-1);
  }
} //Procedure PrnFilterXLS_end

//=======================================
//Печать фильтра
//=======================================
Procedure PrnFilterXLS;
var wFontSize:Word;
    lBackColor:Longint;
{
  if Not(boPrnFilter) Then Exit;

  wFontSize:=12;
  lBackColor:=0DDDDDDh; //Бледно серый

  if (wFilter)>0
  {
  wexrow:=wexrow+1;
  wexcol:=1;
  xlSetBackColor(lBackColor, wexrow,wexcol, wexrow,maxColCount); 
  xlSetFontSize(wFontSize, wexrow,wexcol, wexrow,maxColCount); //Размер
  xlMergeCells(wexrow,wexcol, wexrow,maxColCount); //Объединяем ячейки
  xlSetFontStyle(xlbold, wexrow,wexcol, wexrow,maxColCount); //Bold
  xlAlignCells(xlLeft, wexrow,wexcol, wexrow,maxColCount);
  MyPutExcel('ФИЛЬТРЫ: ' ,10,0,-1,-1);
  }

  if (boDepartmentFilter)
  {
  wexrow:=wexrow+1;
  wexcol:=1;
  xlSetBackColor(lBackColor, wexrow,wexcol, wexrow,maxColCount); 
  xlSetFontSize(wFontSize, wexrow,wexcol, wexrow,maxColCount); //Размер
  xlMergeCells(wexrow,wexcol, wexrow,maxColCount); //Объединяем ячейки
  xlAlignCells(xlLeft, wexrow,wexcol, wexrow,maxColCount);
  MyPutExcel('Подразделения : '+'' ,10,0,-1,-1);
  }
} //Procedure PrnFilterXLS_end

