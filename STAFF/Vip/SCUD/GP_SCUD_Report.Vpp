    Result:=vSpr.Gp_Status.Name;

} //Function GetStatusDoc(_pGp_Status:comp) :string;cacheable;


//=======================================
//Получить ссылку на GP_TypeDocs
//=======================================
Function GetTypeDocNrecByType(_wTypeDocs:word):comp;cacheable;
{ Result:=0;
  vSpr.wTypeDocs:=_wTypeDocs;
  if vSpr.getfirst GP_TypeDocs=tsok
     Result:=vSpr.GP_TypeDocs.Nrec
} //Function GetTypeDocNrecByType(_wTypeDocs:word):comp;cacheable
//=======================================
//Подобъем итоги по каждому уровню группировки
//=======================================
Procedure CalcItogShap;
var pParent : comp;
    iii : Word;
{
  ReSetBounds(#tmp_report_gr);
  ReSetBounds(#tmp_report_sp);

  _loop tmp_report_sp
  {
    pParent := tmp_report_sp.cRec;
MyLogWrite(false,'>stroka 0>'+'cRec='+String(tmp_report_sp.cRec,0,0));
    //Поднимаемся вверх
    if GetFirst tmp_report_gr Where (( pParent == tmp_report_gr.nrec )) = tsOk
    { do
      {  for(iii:=1;iii<=100;iii++) //!!!!!!
         { tmp_report_gr.dmd[iii] += tmp_report_sp.dmd[iii];
         }
         tmp_report_gr.NumRec++; //Кол-во
         Update current tmp_report_gr;
         pParent := tmp_report_gr.cRec;
MyLogWrite(false,'>shap>'+tmp_report_gr.sortname+'|nRec='+String(tmp_report_gr.nRec,0,0)+'|cRec='+String(tmp_report_gr.cRec,0,0));
      } while GetFirst tmp_report_gr Where (( pParent == tmp_report_gr.nrec )) = tsOk;
    }
MyLogWrite(false,'>stroka 1>'+'cRec='+String(tmp_report_sp.cRec,0,0));
  } //_loop tmp_report_sp

  SetBounds(#tmp_report_gr);
  SetBounds(#tmp_report_sp);
}

//=======================================
// Проверить колонку
//=======================================
Function CheckColumn(iCol:Word) : Boolean;
{
  CheckColumn:=False;
  case iCol of
   1  : if(wOutColumn  AND 1       )>0 then CheckColumn:=True; //№ п/п                       
   2  : if(wOutColumn  AND 2       )>0 then CheckColumn:=True; //Учетный номер                    
   3  : if(wOutColumn  AND 4       )>0 then CheckColumn:=True; //ФИО
  end;
}


//--------------- получить нарушения
Function GetMisConDuct:string;
//11-Отсутствие в середине дня.;
//11,18-Отсутствие в середине дня.;
//18-Прогул;
//11,19-Отсутствие в середине дня.;
//11,18,19-Отсутствие в середине дня.;
//18-Прогул;
//11-Отсутствие в середине дня.;
//11,18-Отсутствие в середине дня.;
//18,19-Прогул;
//11,19-Отсутствие "

var ww_Str,ww_Str1:string;
{ Result:='';
  ReReadRecord(#Tmp_Scud_MisConDuct_S);
  _loop Tmp_Scud_MisConDuct_S
  { if Tmp_Scud_MisConDuct_s.wMisConDuct=0 then continue;
    ww_Str:='-'+iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeName(Tmp_Scud_MisConDuct_s.wMisConDuct);
    ww_Str1:=String(Day(Tmp_Scud_MisConDuct_S.DT_EV))+ww_str;
    if pos(ww_Str,Result)=0
    { Result:=Result+if(Result<>'',';'+chr(10),'')+ww_Str1;
    }
    else
    { Result:=Replace(Result,ww_str,','+ww_str1);
    }
  } //_loop Tmp_Scud_MisConDuct_S
} //Function GetMisConDuct:string;

//=======================================
// Сформируем итоги
//=======================================
Procedure InsItog;
var
  sTmp,sTmp1,sTmp2:String;
  //sPodrName,sPodrKod:String;

  sPhotoPath:String;
  _diff_time:time;
  //_time_obed_B:time;
  //_time_obed_E:time;
{ #__UNUSED__(sTmp,sTmp1,sTmp2)
  if logfilekl  MyLogWrite(false,' InsItog 001');
  var ww_Str:string='';
//##################################################################################################
#_MacroGroupInitScud_

  if logfilekl  MyLogWrite(false,' InsItog 002');

//##################################################################################################
  //Для сортировки
  case wTipRep of
   100 : sTmp1:=LPad(GP_SCUD_PERS.Code,20)+Pad(GP_SCUD_PERS.Fio,50); //Таб.№
   0: sTmp1:=Pad(GP_SCUD_PERS.Fio,50)+LPad(GP_SCUD_PERS.Code,20)+DateToStr(DT_Event,'YYYY/MM');
   3,4,5,6://3 'Не выявленные неявки',  4 'Потери рабочего времени',5 'Сверхурочные', 6 'Выходные'
   { sTmp1:=Pad(GP_SCUD_PERS.Fio,50)+LPad(GP_SCUD_PERS.Code,20)+Pad(sKOD_ABS,10)+DateToStr(DT_Event,'YYYY/MM')
     +Pad(sPodr,10)+Pad(sPost,100); //ФИО
   }
   7,8:
   { sTmp1:=Pad(GP_SCUD_PERS.Fio,40)+LPad(GP_SCUD_PERS.Code,20)+LPad(sMisConDuct,50); //ФИО
   }
   9,10: sTmp1:=Pad(GP_SCUD_PERS.Fio,50)+LPad(GP_SCUD_PERS.Code,20)+DateToStr(DT_Event,'YYYY/MM');
   11:
   { sTmp1:=Pad(GP_SCUD_PERS.Fio,50)+LPad(GP_SCUD_PERS.Code,20)
           +DateToStr(vEvents.GP_SCUD_Events.EnterDate,'YYYYMMDD')
           +TimeToStr(vEvents.GP_SCUD_Events.EnterTime,'HH:MM')

   }
   else  sTmp1:=Pad(GP_SCUD_PERS.Fio,40)+LPad(GP_SCUD_PERS.Code,20); //ФИО
  end;
  if logfilekl  MyLogWrite(false,' InsItog '+sTmp1);

  sPhotoPath:='';
  /*
  if CheckColumn(4) //Фото
  { if GetFirst Appendix = tsOk
    {
       sPhotoPath:=GetPathParameter('Files', 'TmpFilesDirectory', 0)+U_reportent.UNS+'.bmp';
       if fileexist(sPhotoPath) Then deletefile(sPhotoPath);
       ExportMemoToFile(Appendix.CONTENTS, sPhotoPath, false);
    }
  } //if
  */

//##################################################################################################
#_MacroSortShapScud_
//##################################################################################################
   if logfilekl MyLogWrite(false,string(tmp_report_gr.cRec)+','+tmp_report_gr.SortName);
   case wTipRep of
   0: //по событиям
   {  ClearBuffer(#tmp_report_sp);
      tmp_report_sp.cRec:=tmp_report_gr.nrec;
      tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
      tmp_report_sp.dms[02]:=GP_SCUD_Pers.CODE;//Учетный номер
      tmp_report_sp.dms[03]:=GP_SCUD_Pers.FIO; //ФИО
      tmp_report_sp.dms[04]:=DateToStr(pTSC_Event_Day.DT_EV,'DD.MM');
      tmp_report_sp.cPers:=GP_SCUD_Pers.Nrec;
      _diff_time:=ZeroTime;

      if pTSC_Event_Day.Type_Ev=0
      { if pTSC_Event_Day.DT_EV_P<pTSC_Event_Day.DT_EV
        { tmp_report_sp.dms[05]:='00:00';
          tmp_report_sp.dms[06]:=TimeToStr(pTSC_Event_Day.TM_EV,'HH:MM');
          _diff_time:=pTSC_Event_Day.TM_EV;
        }
        else
        {//continue;
        }
      }
      else
      { tmp_report_sp.dms[05]:=TimeToStr(pTSC_Event_Day.TM_EV,'HH:MM');
        if pTSC_Event_Day.DT_EV_N>pTSC_Event_Day.DT_EV
          pTSC_Event_Day.TM_EV_N:=time(24,0,0,0);
        tmp_report_sp.dms[05]:=TimeToStr(pTSC_Event_Day.TM_EV,'HH:MM');
        tmp_report_sp.dms[06]:=TimeToStr(pTSC_Event_Day.TM_EV_N,'HH:MM');
        _diff_time:=Sub_Time(pTSC_Event_Day.TM_EV_N,pTSC_Event_Day.TM_EV);
      }
      //tmp_report_sp.dms[07]:=TimeToStr(_diff_time,'HH:MM');
      tmp_report_sp.dmd[07]:=Hour(_diff_time)+Round(Minute(_diff_time)/60,2);
      tmp_report_sp.dms[08]:=pTSC_Event_Day.MisConDuct;
      tmp_report_sp.dms[09]:=pTSC_Event_Day.Status;
      tmp_report_sp.dms[10]:=if(pTSC_Event_Day.Type_Ev=1,'Вход','Выход');
      if pTSC_Event_Day.DT_EV_P<>ZeroDate
        tmp_Report_sp.dms[11]:=if(pTSC_Event_Day.DT_EV_P<>ZeroDate,DateToStr(pTSC_Event_Day.DT_EV_P,'DD/MM'),'-');
       tmp_report_sp.dms[12]:=string(Klrejim_App.REJIM)+', '+klrejim_App.nrejim;
       tmp_report_sp.cRecord:=pTSC_Event_Day.Nrec;
       Insert current tmp_report_sp;

   }
   1:
   { ClearBuffer(#tmp_report_sp);
     tmp_report_sp.cRec:=tmp_report_gr.nrec;
     tmp_report_sp.cPers:=GP_SCUD_Pers.Nrec;
     tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
     tmp_report_sp.tabn:=GP_SCUD_Pers.CODE;//Учетный номер
     tmp_report_sp.fio:=GP_SCUD_Pers.FIO; //ФИО
     tmp_Report_sp.Period :=DateToStr(DT_Event,'MM/YYYY');
     tmp_report_sp.dms[01]:=tmp_Report_sp.Period;
     tmp_report_sp.dms[02]:=GP_SCUD_Pers.CODE;//Учетный номер
     tmp_report_sp.dms[03]:=GP_SCUD_Pers.FIO; //ФИО
     for(ii:=1;ii<=31;ii++)
     { tmp_report_sp.dms[3+ii]:=iGP_SCUD_EventsEdit.GetCalc_Days(ii);
     }
     tmp_report_sp.dmd[35]:=iGP_SCUD_EventsEdit.GetCalc_CH_Graf;  //часы по графику - время
     tmp_report_sp.dmd[36]:=iGP_SCUD_EventsEdit.GetCalc_CH_Fact;  //часы по плану   - время
     tmp_report_sp.dmd[37]:=tmp_report_sp.dmd[36]-tmp_report_sp.dmd[35];  //часы отклонение - число
     tmp_report_sp.dmd[38]:=iGP_SCUD_EventsEdit.GetCalc_CH_Over;  //часы по плану   - сверхурочные
     tmp_report_sp.dmd[39]:=iGP_SCUD_EventsEdit.GetCalc_CH_Over2;  //часы по плану   - сверхурочные
     tmp_report_sp.dmd[40]:=iGP_SCUD_EventsEdit.GetCalc_CH_Holiday;  //часы по плану   - сверхурочные
     tmp_report_sp.dms[41]:=if(boMisConDuct_exist,'есть','нет');
     tmp_report_sp.dmd[41]:=if(boMisConDuct_exist,1,0);
     if boMisConDuct_exist
     { tmp_report_sp.dms[42]:=GetMisConDuct;
     }
     tmp_report_sp.dms[43]:=string(Klrejim_App.rejim)+', '+klrejim_App.nrejim;
     Insert current tmp_report_sp;
   }
   2:
   { var _NeedIns:boolean;_NeedIns:=false;
     if GetFirst tmp_report_sp Where (( tmp_report_gr.nrec == tmp_report_sp.cRec     AND
                                      sTmp1             == tmp_report_sp.sortname
                                  )) <> tsOk
     { _NeedIns:=true;
       ClearBuffer(#tmp_report_sp);
       tmp_report_sp.cRec:=tmp_report_gr.nrec;
       tmp_report_sp.cPers:=GP_SCUD_Pers.Nrec;
       tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
       tmp_report_sp.tabn:=GP_SCUD_Pers.CODE;//Учетный номер
       tmp_report_sp.fio :=GP_SCUD_Pers.FIO; //ФИО
       tmp_report_sp.dms[02]:=GP_SCUD_Pers.CODE;//Учетный номер
       tmp_report_sp.dms[03]:=GP_SCUD_Pers.FIO; //ФИО
     }
     tmp_report_sp.dmd[04]:=tmp_report_sp.dmd[04]+iGP_SCUD_EventsEdit.GetCalc_CH_Graf;  //часы по графику - время
     tmp_report_sp.dmd[05]:=tmp_report_sp.dmd[05]+iGP_SCUD_EventsEdit.GetCalc_CH_Fact;  //часы по плану   - время
     tmp_report_sp.dmd[06]:=tmp_report_sp.dmd[06]+tmp_report_sp.dmd[5]-tmp_report_sp.dmd[4];  //часы отклонение - число
     tmp_report_sp.dmd[07]:=tmp_report_sp.dmd[07]+iGP_SCUD_EventsEdit.GetCalc_CH_Over;  //часы по плану   - сверхурочные
     tmp_report_sp.dmd[08]:=tmp_report_sp.dmd[08]+iGP_SCUD_EventsEdit.GetCalc_CH_Over2;  //часы по плану   - сверхурочные
     tmp_report_sp.dmd[09]:=tmp_report_sp.dmd[09]+iGP_SCUD_EventsEdit.GetCalc_CH_Holiday;  //часы по плану   - сверхурочные
     tmp_report_sp.dms[10]:=if(boMisConDuct_exist or tmp_report_sp.dms[10]='есть','есть','нет');
     tmp_report_sp.dmd[10]:=if(boMisConDuct_exist or tmp_report_sp.dmd[10]>0,1,0);
     tmp_report_sp.dms[11]:=string(Klrejim_App.REJIM)+', '+klrejim_App.nrejim;

     if _NeedIns
     {  Insert current tmp_report_sp;
     }
     else
     { update current tmp_report_sp;
     }
   }
   3,4,5,6://3 'Не выявленные неявки',  4 'Потери рабочего времени',5 'Сверхурочные', 6 'Выходные'
   { var _NeedIns:boolean=false;
     if logfilekl MyLogWrite(false,'3,4,5,6:');

     if GetFirst tmp_report_sp Where (( tmp_report_gr.nrec == tmp_report_sp.cRec     AND
                                      sTmp1             == tmp_report_sp.sortname
                                  )) <> tsOk
     { _NeedIns:=true;
       if logfilekl MyLogWrite(false,'_NeedIns '+string(tmp_report_gr.nrec));
       ClearBuffer(#tmp_report_sp);
       tmp_report_sp.cRec:=tmp_report_gr.nrec;
       tmp_report_sp.cPers:=GP_SCUD_Pers.Nrec;
       tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
       tmp_report_sp.tabn:=GP_SCUD_Pers.CODE;//Учетный номер
       tmp_report_sp.fio :=GP_SCUD_Pers.FIO; //ФИО
       tmp_Report_sp.dms[02] :=sKategory; //   'код','категории'
       tmp_Report_sp.dms[03]:=FindZGD(GP_SCUD_Pers.cKatPodr); //'подчиненность'
       tmp_Report_sp.dms[04]:=sPodr; //'Подраз','деление':[10],Protect;
       tmp_Report_sp.dms[05]:=GP_SCUD_Pers.CODE;//'Таб','номер'     :[10],Protect;
       tmp_Report_sp.dms[06]:=GP_SCUD_Pers.FIO;  //'Фио'             :[20],Protect;
       tmp_Report_sp.dms[07] :=sPost;;//'Должность'       :[20],Protect;
       tmp_Report_sp.dms[08]:=sKod_abs; //'Код'             :[20],Protect;
       tmp_Report_sp.dmd[09]:=iGP_SCUD_EventsEdit.GetCalc_CH_Fact; //'Отработанное','время'   :#(Fld_itog)
       tmp_Report_sp.dmd[12]:=Month(DT_Event); //'Месяц'            :[6],Protect;
       tmp_Report_sp.dmd[13]:=Year(DT_Event); //'Год'              :[6],Protect;
       tmp_Report_sp.dms[14] :=klsovm.nsovm; //'Тип','Занятости'  :#(Fld_itog)
     }

     tmp_Report_sp.dmd[10]:=tmp_Report_sp.dmd[10]+1; //'Дней','по коду'   :[10],Protect;
     tmp_Report_sp.dmd[11]:=tmp_Report_sp.dmd[11]+chas_f; //'Время','по коду'  :#(Fld_itog)
     tmp_report_sp.dms[15]:=string(Klrejim_App.REJIM)+', '+klrejim_App.nrejim;
     if _NeedIns
     {
        Insert current tmp_report_sp;
        if logfilekl MyLogWrite(false,'Insert '+string(tmp_report_sp.cRec));
     }
     else
     { update current tmp_report_sp;
       if logfilekl MyLogWrite(false,'update'+string(tmp_report_sp.cRec));
     }
   } // 6 'Выходные'
   7: // 'Нарушения'
   { var _NeedIns:boolean=false;
     if logfilekl MyLogWrite(false,'3,4,5,6:');

     if GetFirst tmp_report_sp Where (( tmp_report_gr.nrec == tmp_report_sp.cRec     AND
                                      sTmp1             == tmp_report_sp.sortname
                                  )) <> tsOk
     { _NeedIns:=true;
       ClearBuffer(#tmp_report_sp);
       tmp_report_sp.cRec:=tmp_report_gr.nrec;
       tmp_report_sp.cPers:=GP_SCUD_Pers.Nrec;
       tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
       tmp_report_sp.tabn:=GP_SCUD_Pers.CODE;//Учетный номер
       tmp_report_sp.fio :=GP_SCUD_Pers.FIO; //ФИО
       tmp_Report_sp.dms[02] :=sKategory; //   'код','категории'
       tmp_Report_sp.dms[03]:=FindZGD(GP_SCUD_Pers.cKatPodr); //'подчиненность'
       tmp_Report_sp.dms[04]:=sPodr; //'Подраз','деление':[10],Protect;
       tmp_Report_sp.dms[05]:=GP_SCUD_Pers.CODE;//'Таб','номер'     :[10],Protect;
       tmp_Report_sp.dms[06]:=GP_SCUD_Pers.FIO;  //'Фио'             :[20],Protect;
       tmp_Report_sp.dms[07] :=sPost;;//'Должность'       :[20],Protect;
     }
     //Часы, кол-во, Дни через запятую.
     tmp_Report_sp.dms[08] := sMisConDuct;
     tmp_Report_sp.dmd[09] := tmp_Report_sp.dmd[09]+iGP_SCUD_Function.GetDoubleFromTime(GP_SCUD_MISCON_D.TDIFF);
     tmp_Report_sp.dmd[10] := tmp_Report_sp.dmd[10]+1;
     tmp_Report_sp.dms[11] := tmp_Report_sp.dms[11]+if(Length(tmp_Report_sp.dms[11])=0,'',',')+string(Day(GP_SCUD_MISCON_D.DT_EV));
     if getfirst GP_SCUD_DOC_A_M=tsok
     if GP_STATUS_A_M.Name='утвержден'
     { tmp_Report_sp.dms[11] := tmp_Report_sp.dms[11]+'з';
       tmp_Report_sp.dms[13] :=tmp_Report_sp.dms[13]+GP_SCUD_DOC_A_M.DocNMB+';'; //заявление
     }
     tmp_report_sp.dms[12] := string(Klrejim_App.rejim)+', '+klrejim_App.nrejim;
     if _NeedIns
     {  Insert current tmp_report_sp;
        if logfilekl MyLogWrite(false,'Insert '+string(tmp_report_sp.cRec));
     }
     else
     { update current tmp_report_sp;
       if logfilekl MyLogWrite(false,'update'+string(tmp_report_sp.cRec));
     }
   }
   8:
   {   tmp_report_sp.cRec:=tmp_report_gr.nrec;
       tmp_report_sp.cPers:=GP_SCUD_Pers.Nrec;
       tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
       tmp_report_sp.tabn:=GP_SCUD_Pers.CODE;//Учетный номер
       tmp_report_sp.fio :=GP_SCUD_Pers.FIO; //ФИО
       tmp_Report_sp.dms[02] :=sKategory; //   'код','категории'
       tmp_Report_sp.dms[03]:=FindZGD(GP_SCUD_Pers.cKatPodr); //'подчиненность'
       tmp_Report_sp.dms[04]:=sPodr; //'Подраз','деление':[10],Protect;
       tmp_Report_sp.dms[05]:=GP_SCUD_Pers.CODE;//'Таб','номер'     :[10],Protect;
       tmp_Report_sp.dms[06]:=GP_SCUD_Pers.FIO;  //'Фио'             :[20],Protect;
       tmp_Report_sp.dms[07] :=sPost;;//'Должность'       :[20],Protect;
       tmp_Report_sp.dms[08] := sMisConDuct;
       tmp_Report_sp.dmd[09] := iGP_SCUD_Function.GetDoubleFromTime(GP_SCUD_MISCON_D.TDIFF);
       tmp_Report_sp.dms[10] := string(Day(GP_SCUD_MISCON_D.DT_EV));
       tmp_Report_sp.dmd[10] := 1; // чтобы посчитать кол-во
       if getfirst GP_SCUD_DOC_A_M=tsok
       { tmp_Report_sp.dms[11] := DateToStr(GP_SCUD_DOC_A_M.DocDate,'DD/MM/YYYY'); //заявление
         if getfirst GP_STATUS_A_M=tsok
         tmp_Report_sp.dms[12] := GP_STATUS_A_M.Name; //статус
       }
       tmp_Report_sp.dms[13] := string(Klrejim_App.rejim)+', '+klrejim_App.nrejim;
       insert current tmp_Report_sp;
   }
   9: //Заявление об отсутствии
   {   ClearBuffer(#tmp_report_sp);
       tmp_report_sp.cRec:=tmp_report_gr.nrec;
       tmp_report_sp.cPers:=GP_SCUD_Pers.Nrec;
       tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
       tmp_report_sp.tabn:=GP_SCUD_Pers.CODE;//Учетный номер
       tmp_report_sp.fio :=GP_SCUD_Pers.FIO; //ФИО
       tmp_Report_sp.dms[02] :=sKategory; //   'код','категории'
       tmp_Report_sp.dms[03]:=FindZGD(GP_SCUD_Pers.cKatPodr); //'подчиненность'
       tmp_Report_sp.dms[04]:=sPodr; //'Подраз','деление':[10],Protect;
       tmp_Report_sp.dms[05]:=GP_SCUD_Pers.CODE;//'Таб','номер'     :[10],Protect;
       tmp_Report_sp.dms[06]:=GP_SCUD_Pers.FIO;  //'Фио'             :[20],Protect;
       tmp_Report_sp.dms[07] :=sPost;;//'Должность'       :[20],Protect;
       //-------------------------------
       tmp_Report_sp.dms[08] :=pGP_SCUD_ReasonEdit.GetReasonName(
           //if(vDoc_SP.GP_SCUD_DOC_SP.cReason=0,vDoc_SP.GP_SCUD_DOC.cReason,vDoc_SP.GP_SCUD_DOC_SP.cReason ));  // 'Тип','Заявления'
           vDoc_SP.GP_SCUD_DOC.cReason);  // 'Тип','Заявления'
       tmp_Report_sp.dms[09] :=vDoc_SP.GP_SCUD_DOC.Description; // 'Основание'
       tmp_Report_sp.dms[10] :=vDoc_SP.GP_SCUD_DOC.DocNmb; // 'Номер'
       tmp_Report_sp.dms[11] :=DateToStr(vDoc_SP.GP_SCUD_DOC.DocDate,'DD.MM.YYYY');//'Дата документа'
       tmp_Report_sp.dms[12] :=vDoc_SP.GP_Status.Name;
       tmp_Report_sp.dms[13] :=DateToStr(vDoc_SP.GP_SCUD_DOC.DocDate,'DD.MM.YYYY'); //'Дата'
       tmp_Report_sp.dms[14] :=TimeToStr(vDoc_SP.GP_SCUD_DOC_SP.EventTMB,'HH:MM'); //'Время','начала'
       tmp_Report_sp.dms[15] :=TimeToStr(vDoc_SP.GP_SCUD_DOC_SP.EventTME,'HH:MM'); //'Время','окончания'
       _diff_time:=Sub_Time(vDoc_SP.GP_SCUD_Doc_Sp.EventTmE,vDoc_SP.GP_SCUD_Doc_Sp.EventTmB);
       tmp_Report_sp.dmd[16] :=Round(iGP_SCUD_Function.GetDoubleFromTime(_diff_time),4); // 'План','часы'
       tmp_Report_sp.dms[16] :=TimeToStr(_diff_time,'HH:MM:SS');
       _diff_time:=pGP_SCUD_A.Calc_Fact(vDoc_SP.GP_SCUD_Doc_Sp.Nrec);
       tmp_Report_sp.dmd[17] :=Round(iGP_SCUD_Function.GetDoubleFromTime(_diff_time),4);  //'Факт','часы'
       tmp_Report_sp.dms[17] :=TimeToStr(_diff_time,'HH:MM:SS');
       tmp_Report_sp.dms[18] :=string(Klrejim_App.rejim)+', '+klrejim_App.nrejim; //'Режим'
       tmp_Report_sp.dms[19] :=GetStatusDoc(vDoc_SP.GP_SCUD_Doc.cStatus);//статус
       insert current tmp_Report_sp;
   } //9
   10: //Заявление об отсутствии
   { //GP_SCUD_DOC_SP.EventDate->vDoc_SP.GP_SCUD_DOC.DocDate
     //DT_Event
     //if timelog_status>2 timelog(' Rep 10 Ins DT_Event='+DateToStr('DD/MM/YYYY'));
     if DT_Event<>ZeroDate
     { if DT_SCAN_E>DtEnd   DT_SCAN_E:=DtEnd;
       if Calc_pPers <>GP_SCUD_PERS.Nrec
       or Calc_wMonth<>month(DT_Event)
       or Calc_wYear <>year (DT_Event)
       { Calc_pPers :=GP_SCUD_PERS.Nrec;
         Calc_wMonth:=month(DT_Event);
         Calc_wYear :=year (DT_Event);
         iGP_SCUD_EventsEdit.CalcAll(Calc_pPers,Calc_wYear,Calc_wmonth,3,false,0);
       }

       ClearBuffer(#tmp_Report_sp);
       tmp_report_sp.cRec:=tmp_report_gr.nrec;
       tmp_report_sp.cPers:=GP_SCUD_Pers.Nrec;
       tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
       tmp_report_sp.tabn:=GP_SCUD_Pers.CODE;//Учетный номер
       tmp_report_sp.fio :=GP_SCUD_Pers.FIO; //ФИО
       tmp_Report_sp.cRecord :=tmp_Report.cDoc ;
       tmp_Report_sp.dms[02]:= GetFioZGD(GP_SCUD_Pers.cPersons);//ЗГД
       tmp_Report_sp.dms[03]:= GP_SCUD_Pers.FIO;// 'Ф.И.О.','Сотрудника'
       tmp_Report_sp.dms[04]:=KatPodr.Kod; //'Подр.'
       tmp_Report_sp.dms[05]:=KatPodr.Name;// 'Название','подразделения'
       //GP_SCUD_DOC_SP.EventDate->GP_SCUD_DOC.DocDate
       tmp_Report_sp.dms[06]:=TimeToStr(iGP_SCUD_EventsEdit.GetTimeFromDouble(
                    iGP_SCUD_EventsEdit.GetExtData(6,day(DT_Event))),'HH:MM');// 'Начало','рабочего дня'
       tmp_Report_sp.dms[07]:=TimeToStr(iGP_SCUD_EventsEdit.GetTimeFromDouble(iGP_SCUD_EventsEdit.GetExtData(10,day(DT_Event))),'HH:MM')
                     +' - '+TimeToStr(iGP_SCUD_EventsEdit.GetTimeFromDouble(iGP_SCUD_EventsEdit.GetExtData(11,day(DT_Event))),'HH:MM');// 'Обеденный','перерыв'
       tmp_Report_sp.dms[08]:=TimeToStr(iGP_SCUD_EventsEdit.GetTimeFromDouble(iGP_SCUD_EventsEdit.GetExtData(7,day(DT_Event))),'HH:MM');// 'Окончание','рабочего дня'
       tmp_Report_sp.dms[09]:=TimeToStr(vDoc_SP.GP_SCUD_DOC_SP.EventTMB,'HH:MM');// 'Время','выхода'
       tmp_Report_sp.dms[10]:=TimeToStr(vDoc_SP.GP_SCUD_DOC_SP.EventTME,'HH:MM');// 'Время','возврата'
       //_diff_time:=Sub_Time(vDoc_SP.GP_SCUD_Doc_Sp.EventTmE,vDoc_SP.GP_SCUD_Doc_Sp.EventTmB);
       //_diff_time:=pGP_SCUD_A.Calc_Fact(vDoc_SP.GP_SCUD_Doc_Sp.Nrec);  //'Факт','часы'
       _diff_time:=pGP_SCUD_A.GetPlanTime(vDoc_SP.GP_SCUD_Doc_SP.cGP_SCUD_Pers
              ,vDoc_SP.GP_SCUD_Doc.DocDate
              ,vDoc_SP.GP_SCUD_Doc_SP.EventTmB
              ,vDoc_SP.GP_SCUD_Doc_SP.EventTmE );
       tmp_Report_sp.dms[11]:=TimeToStr(_diff_time,'HH:MM');// 'Время','отсутствия'
       tmp_Report_sp.dmd[11]:=iGP_SCUD_EventsEdit.GetDoubleFromTime(_diff_time);
       tmp_Report_sp.dmd[12]:=Hour(_diff_time)*60+Minute(_diff_time);// 'Минуты'
       tmp_Report_sp.dms[13]:=pGP_SCUD_ReasonEdit.GetReasonName(vDoc_SP.GP_SCUD_Doc.cReason);
       if vDoc_SP.GP_SCUD_Doc.Description<>''
       { tmp_Report_sp.dms[13]:=tmp_Report_sp.dms[13] +'('+ vDoc_SP.GP_SCUD_Doc.Description
          +if(vDoc_SP.GP_SCUD_Doc_SP.Description<>'',', '+vDoc_SP.GP_SCUD_Doc_SP.Description,'')
           +' )' ;// 'Причина','выхода'
       }
       tmp_Report_sp.dms[14]:=DateToStr(DT_Event,'DD.MM.YYYY');//'Дата заявления','на отсутствие'
       _diff_time:=pGP_SCUD_A.Calc_Fact(vDoc_SP.GP_SCUD_Doc_Sp.Nrec);  //'Факт','часы'
       tmp_Report_sp.dms[15]:=TimeToStr(_diff_time,'HH:MM');// 'Время','отсутствия'
       tmp_Report_sp.dmd[15]:=iGP_SCUD_EventsEdit.GetDoubleFromTime(_diff_time);
       tmp_Report_sp.dms[16]:=GetStatusDoc(vDoc_SP.GP_SCUD_Doc.cStatus);//статус
       tmp_Report_sp.dms[17]:=sPost;//должность
       insert current tmp_Report_sp;
     } //if DT_Event<>ZeroDate
   } //10
   11:
   {   ClearBuffer(#tmp_Report_sp);
       tmp_report_sp.cRec:=tmp_report_gr.nrec;
       tmp_report_sp.cPers:=GP_SCUD_Pers.Nrec;
       tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
       tmp_report_sp.tabn:=GP_SCUD_Pers.CODE;//Учетный номер
       tmp_report_sp.fio :=GP_SCUD_Pers.FIO; //ФИО
       tmp_Report_sp.cRecord :=tmp_Report.cDoc ;
       tmp_Report_sp.cRecord2:=tmp_Report.cDoc2;
       tmp_Report_sp.dms[02] := GP_SCUD_Pers.CODE; // 'Таб.номер'
       tmp_Report_sp.dms[03] := GP_SCUD_Pers.FIO;  // 'Фио'
       tmp_Report_sp.dms[04] := DateToStr(vEvents.GP_SCUD_Events.EnterDate,'DD.MM.YYYY'); //'Дата','события'
       tmp_Report_sp.dms[05] := TimeToStr(vEvents.GP_SCUD_Events.EnterTime,'HH:MM'); //'Время','события'
       tmp_Report_sp.dms[06] := if(vEvents.GP_SCUD_Events.wResource=0,'Выход','Выход');
       if vEvents.Getfirst GP_Status=tsok
         tmp_Report_sp.dms[07] :=vEvents.GP_Status.Name;  //'Статус'
       vEvents.pGP_SCUD_Events:=tmp_Report.cDoc2;
       if vEvents.Getfirst GP_SCUD_Events=tsok
       { tmp_Report_sp.dms[08] := DateToStr(vEvents.GP_SCUD_Events.EnterDate,'DD.MM.YYYY'); //'Дата Пред.соб.'
         tmp_Report_sp.dms[09] := TimeToStr(vEvents.GP_SCUD_Events.EnterTime,'HH:MM'); //'Время Пред.события'
         if vEvents.Getfirst GP_Status=tsok
           tmp_Report_sp.dms[10] :=vEvents.GP_Status.Name;  // 'Статус Пред.события'
       }
       insert current tmp_Report_sp;

   } //11
   else
   { ClearBuffer(#tmp_report_sp);
     tmp_report_sp.cRec:=tmp_report_gr.nrec;
     tmp_report_sp.sortname:=sTmp1; //Для сортировки!!!
     //============================
     tmp_report_sp.dms[02]:=GP_SCUD_Pers.CODE;//Учетный номер
     tmp_report_sp.dms[03]:=GP_SCUD_Pers.FIO; //ФИО
     //if CheckColumn(04) then tmp_report_sp.dms[04]:=sPhotoPath;   //Фото
     tmp_report_sp.dms[07]:=Persons.sex;   //Пол
     tmp_report_sp.dms[08]:=String(Klrejim_App.Rejim)+', '+klrejim_App.nrejim;
     Insert current tmp_report_sp;
   }
   end;
//##################################################################################################
} //Procedure InsItog

