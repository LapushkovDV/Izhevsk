tree trMain11 '' (,,sci14EnEscTree);//sci14EscExTree_InsLevel)
Show at (,,,15);
Table tmp_Report_gr_v;
Fields
  tmp_Report_gr_v.LevName 'Наименование уровня' :[30],Protect,NoPickButton,NoDel;
