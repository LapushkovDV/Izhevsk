  tmp_Report_gr_v.LevTitle 'Наименование уровня' :[20],Protect,NoPickButton,NoDel;
  tmp_Report_gr_v.dmd[11] 'Время','отсутствия(ч)'   :#(Fld_itog)
  tmp_Report_gr_v.dmd[12] 'Время','отсутствия(м)'   :#(Fld_itog)
  tmp_Report_gr_v.dmd[15] 'Время(факт)','отсутствия(ч)'   :#(Fld_itog)
end;
Browse brMain10 (,,sci14Esc);
Show at (,16,,);
Table tmp_Report_sp_v;
Fields
  tmp_Report_sp_v.dms[02] 'Функциональный','Руководитель' :[25],Protect;
  tmp_Report_sp_v.dms[03] 'Ф.И.О.','Сотрудника' :[25],Protect;
  tmp_Report_sp_v.dms[04] 'Подр.'  :[5],Protect;
  tmp_Report_sp_v.dms[05] 'Название','подразделения' :[25],Protect;
  tmp_Report_sp_v.dms[06] 'Начало','рабочего дня'    :[10],Protect;
  tmp_Report_sp_v.dms[07] 'Обеденный','перерыв'      :[10],Protect;
  tmp_Report_sp_v.dms[08] 'Окончание','рабочего дня' :[10],Protect;
  tmp_Report_sp_v.dms[09] 'Время','выхода'           :[10],Protect;
  tmp_Report_sp_v.dms[10] 'Время','возврата'         :[10],Protect;
  tmp_Report_sp_v.dms[11] 'Время','отсутствия'       :[10],Protect;
  tmp_Report_sp_v.dmd[12] 'Минуты'                   :[10],Protect;
  tmp_Report_sp_v.dms[13] 'Причина','выхода'         :[10],Protect;
  tmp_Report_sp_v.dms[14] 'Дата заявления','на отсутствие':[10],Protect;
  tmp_Report_sp_v.dms[15] 'Факт.Время','отсутствия'       :[10],Protect;
