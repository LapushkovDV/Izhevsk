//=======================================
//
//=======================================
Function GetTypeFldByReport(_wTipRep:word;_Column:word;var _Razr:word; _boSpec:boolean=false):word;
{ Result:=0;
  _Razr:=2;
  case _wTipRep of
  0,11:
  { case _Column of
    7 : Result:=1;
    end;
  }
  1:
  { case _Column of
    35..40: Result:=1;
    end;
  }
  2:
  { case _Column of
    4..9: Result:=1;
    end;
  }
  3,4,5,6://3 'Не выявленные неявки',  4 'Потери рабочего времени',5 'Сверхурочные', 6 'Выходные'
  {
    case _Column of
    9..11: Result:=1;
    12..13:
    { Result:=1;_Razr:=0;
    }
    end;
  }
  7,8:
  { case _Column of
    9: Result:=1;
    10:
    { Result:=1;_Razr:=0;
    }
    end;

  }
  9:
  { case _Column of
    16,17: Result:=if(_boSpec,0,1);
    end;

  }
  10:
  { case _Column of
    11,15: { Result:=2;_Razr:=4;}//время
    12: Result:=1;
    end;
  }
  end;
} //Function GetTypeFldByReport(_Column:word):word;



//=======================================
//
//=======================================
Function CreateDBF:Boolean;
var
  iii:word;
{
  CreateDBF := False;
  npp_DBF := 0;
  deletefile(nmDBFfile);
  lDBFHandle := DBFOpen(nmDBFfile, stCreate);
  if (lDBFHandle=0)
  {
    fLog.Write('Ошибка! Не могу создать файл '+nmDBFfile);
    err_kol++;
    exit;
  }
  for(iii:=1;iii<=maxColCount;iii++)
  { var _Razr:word=0;
    var _wType_fld:word=GetTypeFldByReport(wTipRep,iii,_Razr);
    if _wType_fld=0
    { DBFAddField(lDBFHandle, 'Fld'+LpadCh(string(iii),'0',2), DbChar, 255, 0); //№ п/п        DBFAddField(lDBFHandle, 'Fld66', DbChar, 255, 0)
    }
    else
    { DBFAddField(lDBFHandle, 'Fld'+LpadCh(string(iii),'0',2), DbNum, 16, _Razr); //№ п/п        DBFAddField(lDBFHandle, 'Fld66', DbChar, 255, 0)
    }
  }
  CreateDBF:=True;
}

//=======================================
//
//=======================================
Function PutValueDBF:Boolean;
var
  iii:word;
  _wRazr:word;
{
  PutValueDBF := False;
  if (lDBFHandle=0) then exit;
  DBFClearBuffer(lDBFHandle);
  _wRazr:=0;
  for(iii:=1;iii<=maxColCount;iii++)
  { var _wType_fld:word=GetTypeFldByReport(wTipRep,iii,_wRazr);
    if _wType_fld=0
    then DBFPutFieldValue(lDBFHandle,  'Fld'+LpadCh(string(iii),'0',2), tmp_report_sp.dms[iii]);
    else DBFPutFieldValue(lDBFHandle,  'Fld'+LpadCh(string(iii),'0',2), string(tmp_report_sp.dmd[iii],16,_wRazr));
  }
  if DBFInsertRecord(lDBFHandle)<>0
  {
    fLog.Write('Ошибка! Не могу добавить запись в файл '+nmDBFfile);
    err_kol++;
    exit;
  }
  npp_DBF := npp_DBF + 1;
  PutValueDBF:=True;
}



//=======================================
//Печать Шапки
//=======================================
Function PrnShap:Boolean;
var sTmp : String;
    iii : Word;
{
  for(iii:=1;iii<=wexrow;iii++)
  {
    xlMergeCells(iii,1,iii,maxColCount);
  }

  //Шапка
  sTmp:=if(dtBeg=dtEnd, DateToStr(dtEnd,' на DD.MM.YYYY'), DateToStr(dtBeg,' за период с DD.MM.YYYY')+DateToStr(dtEnd,' по DD.MM.YYYY'));
  xlSetCellStringValue(UserDeskRep.REPOPI+sTmp ,1,1,1,1);

  sTmp:='';
       if (wDateFilter AND 1)>0 then sTmp:='поступления';
  else if (wDateFilter AND 2)>0 then sTmp:='выбытия';
  else if (wDateFilter AND 4)>0 then sTmp:='переводы';
  else if (wDateFilter AND 8)>0 then sTmp:='поступления';
  xlSetCellStringValue(sTmp ,2,1,2,1);

  //Шапка таблицы
  wexrow:=wexrow+1;
  wexcol:=1;
  xlWrapText(wexrow, 1, wexrow, maxColCount);
  xlAlignCellsEx(xlCenter, xlCenter, wexrow, 1, wexrow, maxColCount);
  xlSetFontStyle(xlBold, wexrow, 1, wexrow, maxColCount);
  case wTipRep of
  0:
  { MyPutExcel(if(Not CheckColumn(01), '', trim('№ п/п                                       ')) ,10,0,-1,-1);
    //MyPutExcel(if(Not CheckColumn(02), '', trim('Учетный номер                               ')) ,10,0,-1,-1);
    HideShowColumnXLS(1,5);
    MyPutExcel('Таб.номер' ,10,0,-1,-1);
    HideShowColumnXLS(2,5);
    MyPutExcel('Фио'  ,10,0,-1,-1);
    HideShowColumnXLS(3,15);
    MyPutExcel('Дата входа' ,10,0,-1,-1);
    HideShowColumnXLS(4,11);
    MyPutExcel('Время входа' ,10,0,-1,-1);
    HideShowColumnXLS(5,8);
    MyPutExcel('Время выхода' ,10,0,-1,-1);
    HideShowColumnXLS(6,8);
    MyPutExcel('Продолжительность' ,10,0,-1,-1);
    HideShowColumnXLS(7,8);
    MyPutExcel('Нарушение' ,10,0,-1,-1);
    HideShowColumnXLS(8,20);
    MyPutExcel('Тип записи' ,10,0,-1,-1);
    HideShowColumnXLS(9,15);
    MyPutExcel('Режим' ,10,0,-1,-1);
    HideShowColumnXLS(10,15);

  }
  1:
  {
    MyPutExcel(if(Not CheckColumn(01), '', trim('Период                                       ')) ,10,0,-1,-1);
    //MyPutExcel(if(Not CheckColumn(02), '', trim('Учетный номер                               ')) ,10,0,-1,-1);
    HideShowColumnXLS(1,5);
    MyPutExcel('Таб.номер' ,10,0,-1,-1);
    HideShowColumnXLS(2,5);
    MyPutExcel('Фио'  ,10,0,-1,-1);
    HideShowColumnXLS(3,25);
    for(iii:=1;iii<=31;iii++)
    {
      MyPutExcel(string(iii)  ,10,0,-1,-1);
      HideShowColumnXLS(3+iii,7);
    }
    MyPutExcel('График'  ,10,0,-1,-1);
    HideShowColumnXLS(35,12);
    MyPutExcel('Факт'    ,10,0,-1,-1);
    HideShowColumnXLS(36,12);
    MyPutExcel('Откл-ие' ,10,0,-1,-1);
    HideShowColumnXLS(37,12);
    MyPutExcel('Св.-ные' ,10,0,-1,-1);
    HideShowColumnXLS(38,12);
    MyPutExcel('Пере-ка' ,10,0,-1,-1);
    HideShowColumnXLS(39,12);
    MyPutExcel('Выходные' ,10,0,-1,-1);
    HideShowColumnXLS(40,12);
    MyPutExcel('Нарушения' ,10,0,-1,-1);
    HideShowColumnXLS(41,9);
    MyPutExcel('Типы Нарушений' ,10,0,-1,-1);
    HideShowColumnXLS(42,60);
    MyPutExcel('Режим' ,10,0,-1,-1);
    HideShowColumnXLS(43,15);
  }  //1
  2:
  {
    MyPutExcel(if(Not CheckColumn(01), '', trim('№ п/п                                       ')) ,10,0,-1,-1);
    //MyPutExcel(if(Not CheckColumn(02), '', trim('Учетный номер                               ')) ,10,0,-1,-1);
    HideShowColumnXLS(1,5);
    MyPutExcel('Таб.номер' ,10,0,-1,-1);
    HideShowColumnXLS(2,5);
    MyPutExcel('Фио'  ,10,0,-1,-1);
    HideShowColumnXLS(3,25);
    MyPutExcel('График'  ,10,0,-1,-1);
    HideShowColumnXLS(wexcol-1,12);
    MyPutExcel('Факт'    ,10,0,-1,-1);
    HideShowColumnXLS(wexcol-1,12);
    MyPutExcel('Откл-ие' ,10,0,-1,-1);
    HideShowColumnXLS(wexcol-1,12);
    MyPutExcel('Св.-ные' ,10,0,-1,-1);
