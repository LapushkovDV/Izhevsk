//--------------------------
//
//--------------------------
Procedure PrintItog(ww_str:string);
var iii:word;
    _wType_fld:word;
    _Razr:word;
{
  xlSetBackColor(GetColorLevel(tmp_report_gr.LevCode), wexrow, 1, wexrow, maxColCount);
!     xlSetRowHeight(25, wexrow,1, wexrow,1);
  xlSetFontStyle(xlbold, wexrow, 1, wexrow, maxColCount); //Bold
  MyPutExcel(ww_str+if(tmp_report_gr.NumRec>0,', количество - '+String(tmp_report_gr.NumRec),''),10,0,-1,-1);
  case wTipRep of
  0:
  { xlMergeCells(wexrow,1, wexrow,maxColCount); //Объединяем ячейки
    xlAlignCells(xlLeft, wexrow, 1, wexrow, maxColCount);
  }
  1:
  { xlMergeCells(wexrow,1, wexrow,34); //Объединяем ячейки
    xlAlignCells(xlLeft, wexrow, 1, wexrow, 34);
    wexcol:=35;
    for(iii:=35;iii<=maxColCount;iii++)
    { _wType_fld:=GetTypeFldByReport(wTipRep,iii,_Razr);
      MyPutExcelNumber(tmp_Report_gr.dmd[iii]/if(_wType_fld=2,24,1),3,10,0,-1,-1); //
    }
  }
  2:
  { xlMergeCells(wexrow,1, wexrow,3); //Объединяем ячейки
    xlAlignCells(xlLeft, wexrow, 1, wexrow, 3);
    wexcol:=4;
    for(iii:=4;iii<=maxColCount;iii++)
    { var _wType_fld:word=GetTypeFldByReport(wTipRep,iii,_Razr);
      MyPutExcelNumber(tmp_Report_gr.dmd[iii]/if(_wType_fld=2,24,1),3,10,0,-1,-1); //
    }
  }
  3,4,5,6://3 'Не выявленные неявки',  4 'Потери рабочего времени',5 'Сверхурочные', 6 'Выходные'
  { xlMergeCells(wexrow,1, wexrow,9); //Объединяем ячейки
    wexcol:=10;
    for(iii:=10;iii<=11;iii++)
    { _wType_fld:=GetTypeFldByReport(wTipRep,iii,_Razr);
      MyPutExcelNumber(tmp_Report_gr.dmd[iii]/if(_wType_fld=2,24,1),3,10,0,-1,-1); //
    }
  } //3 'Не выявленные неявки',  4 'Потери рабочего времени',5 'Сверхурочные', 6 'Выходные'
  7,8:
  { xlMergeCells(wexrow,1, wexrow,8); //Объединяем ячейки
    wexcol:=9;
    for(iii:=9;iii<=10;iii++)
    { _wType_fld:=GetTypeFldByReport(wTipRep,iii,_Razr);
      MyPutExcelNumber(tmp_Report_gr.dmd[iii]/if(_wType_fld=2,24,1),3,10,0,-1,-1); //
    }

  }
  9:
  { xlMergeCells(wexrow,1, wexrow,14); //Объединяем ячейки
    wexcol:=15;
    for(iii:=15;iii<=16;iii++)
      MyPutExcelNumber(tmp_Report_gr.dmd[iii],3,10,0,-1,-1); //
  }
  10:
  { xlMergeCells(wexrow,1, wexrow,10); //Объединяем ячейки
    wexcol:=11;
    for(iii:=11;iii<=11;iii++)
    { //MyPutExcelNumber(Round(tmp_Report_gr.dmd[iii],3),3,10,0,-1,-1); //
      MyPutExcel(chr(39)+iGP_SCUD_Function.GetTimeStrFromDouble(tmp_Report_gr.dmd[iii]),10,0,-1,-1); //
    }
    wexcol:=15;
    //MyPutExcelNumber(Round(tmp_Report_gr.dmd[15],3),3,10,0,-1,-1); //
    MyPutExcel(chr(39)+iGP_SCUD_Function.GetTimeStrFromDouble(tmp_Report_gr.dmd[iii]),10,0,-1,-1); //

  }
  11:
  { xlMergeCells(wexrow,1, wexrow,maxColCount); //Объединяем ячейки
    xlAlignCells(xlLeft, wexrow, 1, wexrow, maxColCount);
  }
  else
  { xlMergeCells(wexrow,1, wexrow,maxColCount); //Объединяем ячейки
    xlAlignCells(xlLeft, wexrow, 1, wexrow, maxColCount);
  }
  end;
} //Procedure PrintItog;

Function Report_XLS00_rec(pParent:Comp; boPrn:Boolean):Boolean;
var wrec:comp;
    iii:word;
    sSort_tbl:String;
    //sTmp:String;
    //dtTmp:Date;
    wPr:Integer;
    _wType_fld:word;
    _Razr:word;
    npp_obj:Longint; //№ по порядку
{
  Report_XLS00_rec:=True;

  if GetFirst tmp_report_gr where (( pParent == tmp_report_gr.cRec )) <> tsOk 
  { Report_XLS00_rec:=False;
    if (boPrn) Then exit; //Если уже печатал, то выходим
  }

  do {
   if Not(Report_XLS00_rec) Then wrec:=pParent;
   else wrec:=tmp_report_gr.NREC;
//-------------------------------------------------------------------
   nextvisual;
   sSort_tbl:=GetGroupNameLevelScud(tmp_report_gr.LevCode,tmp_report_gr.LevName);
  wPr:=if(tmp_report_gr.pr<=0, 1, tmp_report_gr.pr);
   if (tmp_report_gr.sortname<>'Всего') AND (Report_XLS00_rec)
   and (not IsBitCTW(wPrnOption,1)
    or (getfirst tmp_report_gr_SP=tsok)
    )
   {
MyLogWrite(false,'>shap>'+String(tmp_report_gr.pr)+'|'+tmp_report_gr.sortname);
     wexrow:=wexrow+1;
     wexcol:=1;
     xlSetBackColor(GetColorLevel(tmp_report_gr.LevCode), wexrow, 1, wexrow, maxColCount);
!     xlSetRowHeight(25, wexrow,1, wexrow,1);
     xlMergeCells(wexrow,1, wexrow,maxColCount); //Объединяем ячейки
     xlSetFontStyle(xlBold, wexrow, 1, wexrow, maxColCount);
     xlAlignCells(xlLeft, wexrow, 1, wexrow, maxColCount);
     MyPutExcel(Pad('',wPr)+sSort_tbl ,10,0,-1,-1); //2
   } //if
//-------------------------------------------------------------------
   npp_obj:=0;
   boPrn:=False;
   if not IsBitCTW(wPrnOption,1)
   _loop tmp_report_sp Where (( wrec == tmp_report_sp.cRec ))
   {
     nextvisual;

MyLogWrite(false,'>>stroka>'+tmp_report_sp.sortname);
     boPrn:=True;
     npp_obj:=npp_obj+1;
     if(boDBF) 
      PutValueDBF;

     
    if(wTipRep<>2)
    {
#declare _SetBackColorDoc_(id)
     if CheckColumn(#id) then {
                                sTmp:=SubStr(trim(tmp_report_sp.dms[#id]),1,10);
                                if (sTmp<>'')
                                { dtTmp := StrToDate(sTmp, 'DD.MM.YYYY');
                                  if (dtTmp<=dtEnd AND dtTmp<>Date(0,0,0))
                                  xlSetBackColor(00000FFh, wexrow, #id, wexrow, #id); //просрочен документ?
                                }
                              }
#end
   } //if(wTipRep<>2)
     wexrow:=wexrow+1;
     wexcol:=1;
     case wTipRep of
     0 :
     { MyPutExcel(String(npp_obj)         ,10,0,-1,-1); //№ п/п
       //MyPutExcel(tmp_report_sp.dms[02] ,10,0,-1,-1); //Учетный номер
       MyPutExcel(tmp_Report_sp.dms[2],10,0,-1,-1); // 'Таб.номер' :[20],Protect;
       MyPutExcel(tmp_Report_sp.dms[3],10,0,-1,-1); // 'Фио' :[20],Protect;
       MyPutExcel(chr(39)+tmp_Report_sp.dms[4],10,0,-1,-1); // 'Дата','входа':[6],Protect;
       MyPutExcel(chr(39)+tmp_Report_sp.dms[5],10,0,-1,-1); // 'Время','входа':[6],Protect;
       MyPutExcel(chr(39)+tmp_Report_sp.dms[6],10,0,-1,-1); // 'Время','выхода':[6],Protect;
       MyPutExcelNumber(tmp_Report_sp.dmd[7],2,10,0,-1,-1); // 'Продол-','жительность':[6],Protect;
       MyPutExcel(tmp_Report_sp.dms[8],10,0,-1,-1); // 'Нарушение':[30],Protect;
       MyPutExcel(tmp_Report_sp.dms[9],10,0,-1,-1); // 'Тип записи':[30],Protect;

       //MyPutExcel(tmp_report_sp.dms[04] ,10,0,-1,-1); //Фото
       // если вдруг захоти мемо печатать
       if tmp_report_sp.dms[65]<>''
         update tmp_memprint where (( tmp_report_sp.Nrec == tmp_memprint.ctmp_report_sp )) set tmp_memprint.row:=wexrow;
     
     }
     1,2:
     { if wTipRep=1
       { MyPutExcel(tmp_Report_sp.Period  ,10,0,-1,-1); //№ п/п

       }
       else
       { MyPutExcel(String(npp_obj)         ,10,0,-1,-1); //№ п/п
       }
       for(iii:=2;iii<=maxColCount;iii++)
       { _wType_fld:=GetTypeFldByReport(wTipRep,iii,_Razr);
         if wTipRep=1
         { case iii of
           4..34:
           { var ww_color:longint=GetColorDaysXL(tmp_Report_sp.dms[iii]);
             if ww_color<>0FFFFFFh
               xlSetBackColor(GetColorDaysXL(tmp_Report_sp.dms[iii]), wexrow, wexcol, wexrow, wexcol);
           }
           end;
         }

         case _wType_fld of
         1: MyPutExcelNumber(tmp_Report_sp.dmd[iii],3,10,0,-1,-1); // число
         2: MyPutExcelNumber(tmp_Report_sp.dmd[iii]/24,6,10,0,-1,-1); //время
         else  MyPutExcel(chr(39)+tmp_Report_sp.dms[iii],10,0,-1,-1); //
         end;
       }
     }
     3..20://3 'Не выявленные неявки',  4 'Потери рабочего времени',5 'Сверхурочные', 6 'Выходные'
     {
       MyPutExcel(String(npp_obj)         ,10,0,-1,-1); //№ п/п
       for(iii:=2;iii<=maxColCount;iii++)
       { _wType_fld:=GetTypeFldByReport(wTipRep,iii,_Razr,True);
         case _wType_fld of
         1: MyPutExcelNumber(tmp_Report_sp.dmd[iii],_Razr,10,0,-1,-1); //
         2: MyPutExcelNumber(tmp_Report_sp.dmd[iii]/24,6,10,0,-1,-1); //
         else MyPutExcel(chr(39)+tmp_Report_sp.dms[iii],10,0,-1,-1); //
         end;
       }
     } //3 'Не выявленные неявки',  4 'Потери рабочего времени',5 'Сверхурочные', 6 'Выходные'
     end;
   } //_loop tmp_report_sp

   if Not(Report_XLS00_rec) Then Exit;

   Report_XLS00_rec(tmp_report_gr.nrec,boPrn);

   if GetFirst tmp_report_gr where (( wrec == tmp_report_gr.nrec )) <> tsOk Then Exit;

//-------------------------------------------------------------------
   if (tmp_report_gr.sortname<>'Всего') AND (Report_XLS00_rec)
   {
     MyLogWrite(false,'>>>shap itog>'+String(tmp_report_gr.pr)+'|'+tmp_report_gr.sortname);
     wexrow:=wexrow+1;
     wexcol:=1;
     wPr:=if(tmp_report_gr.pr<=0, 1, tmp_report_gr.pr);
     sSort_tbl:=GetGroupNameLevelScud(tmp_report_gr.LevCode,tmp_report_gr.LevName);
     PrintItog(Pad('',wPr)+if(IsBitCTW(wPrnOption,1) or (getfirst tmp_report_gr_SP=tsok),'Итого по ','')+sSort_tbl);
   } //if
//-------------------------------------------------------------------

  } while GetNext tmp_report_gr where (( pParent == tmp_report_gr.cRec )) = tsOk;

} //Function Report_XLS00_rec

