//=======================================
// печать данных 00
//=======================================
Function Report_XLS00(cRec_tbl :Comp):Boolean;
var werr:word;
    sSort_tbl:String;
    //sTmp :String;
    wPr:Integer;
{
  Report_XLS00:=false;
#DEFINE _XLSMATRIX_
//===================================================================
!  matrixkl:=False;
  werr:=ExcelInit(nmtemplate,true);

MyLogWrite(false,'');
MyLogWrite(false,'Report_XLS00 beg ------'+TimeToStr(Cur_Time,'HH.MM.SS.SSS ')+nmtemplate);

//  xlSetActiveSheet(1); //Установить лист 1
  case wTipRep of
  00: maxColCount:=10; //Последняя колонка
  01: maxColCount:=43; //Последняя колонка
  02: maxColCount:=11; //Последняя колонка
  03,4,5,6://3 'Не выявленные неявки',  4 'Потери рабочего времени',5 'Сверхурочные', 6 'Выходные'
    maxColCount:=14;
  07: maxColCount:=14;
  08: maxColCount:=13;
  09: maxColCount:=19;
  10: maxColCount:=17;
  11: maxColCount:=10;
  end;


  HeaderStrCount:=5; // для последующего вывода сетки
  wexrow:=HeaderStrCount;

//IFDEF _XLSMATRIX_
  MyXlCreaMatrix(1000, maxColCount);
  matrixkl:=true;
  matrixsdvig:=wexrow;
//ENDIF
//===================================================================
  PrnFilterXLS;
  PrnFilterXLS_end;
//-------------------------------------------------------------------
  //Шапка
  if GetFirst tmp_report_gr Where (( cRec_tbl == tmp_report_gr.nrec )) = tsOk
  {
   PrnShap;
   if (tmp_report_gr.sortname<>'Всего') AND (boCut)
   {
MyLogWrite(false,'>shap>'+String(tmp_report_gr.pr)+'|'+tmp_report_gr.sortname);
     wexrow:=wexrow+1;
     wexcol:=2;
     wPr:=if(tmp_report_gr.pr<=0, 1, tmp_report_gr.pr);
     xlSetBackColor(GetColorLevel(tmp_report_gr.LevCode), wexrow, 1, wexrow, maxColCount);
!     xlSetRowHeight(25, wexrow,1, wexrow,1);
     xlMergeCells(wexrow,2, wexrow,maxColCount); //Объединяем ячейки
     xlSetFontStyle(xlBold, wexrow, 1, wexrow, maxColCount);
!     xlAlignCells(xlLeft, wexrow, 1, wexrow, maxColCount);
     xlAlignCells(xlCenter, wexrow, 1, wexrow, maxColCount);
     sSort_tbl:=GetGroupNameLevelScud(tmp_report_gr.LevCode,tmp_report_gr.LevName);
     MyPutExcel(sSort_tbl ,10,0,-1,-1); //2
   } //if
  }

  //Раскрутка дерева
  Report_XLS00_rec(cRec_tbl,False);

  //Всего
  if GetFirst tmp_report_gr Where (( cRec_tbl == tmp_report_gr.nrec )) = tsOk
  {
      wexrow:=wexrow+1;
      wexcol:=1;
      PrintItog('Всего по отчету - ');
  }
//---------------------- 
//IFDEF _XLSMATRIX_
  MyxlWriteMatrix(wexrow);
  xlFreeMatrix;
  matrixkl:=False;
//ENDIF
  MyxlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, HeaderStrCount+1 ,1,wexrow,maxColCount); //Обрамление
  xlWrapText(HeaderStrCount, 1, wexrow, maxColCount);

  MyHideColumn; //Скрываем колонки

//===================================================================
  xlGetActiveWorkBookName(wcurbook);
  xlSetActiveWorkBookByName(wcurbook);
MyLogWrite(false,'Сформирован как '+wcurbook);
/*
  xlSaveWorkBookByName(wcurbook);
  sTmp:=MyOutputFilesDirectory+'KD-26'+if(boCut AND Trim(tmp_report_gr.sortname)<>'','_'+Trim(tmp_report_gr.sortname),'');
  xlGetActiveWorkBookName(wcurbook);
  MyXlSaveAsWorkBookByName(wcurbook, sTmp);
MyLogWrite(false,'Сохранили как '+sTmp +'/'+wcurbook);
*/

  MyXlRunMacro;

  XlKillExcel;

MyLogWrite(false,'Report_XLS00 end ------'+TimeToStr(Cur_Time,'HH.MM.SS.SSS'));
//===================================================================
#UNDEF _XLSMATRIX_
  Report_XLS00:=True;
} //Function Report_XLS00

//=======================================
// Главная печать
//=======================================
Function PrintRep :boolean;
var cRec_tbl:comp;
{
  PrintRep:=False;
  XlKillExcel;

  cRec_tbl:=0;
  if GetFirst tmp_report_grMAIN where (( cRec_tbl == tmp_report_grMAIN.cRec )) = tsOk
  {
    if(boDBF)
     CreateDBF;

    cRec_tbl:=tmp_report_grMAIN.nrec;
    if GetFirst tmp_report_grMAIN where (( cRec_tbl == tmp_report_grMAIN.cRec )) = tsOk
    {      cRec_tbl:=tmp_report_grMAIN.cRec;
    } else cRec_tbl:=0;

    if Not(boCut) Then cRec_tbl:=0; //'Формировать файлы по 1-му уровню группировки'

    if GetFirst tmp_report_grMAIN where (( cRec_tbl == tmp_report_grMAIN.cRec )) = tsOk
     do {
//message(tmp_report_grMAIN.cRec+'/'+tmp_report_grMAIN.sortname);
        PrintRep:=Report_XLS00(tmp_report_grMAIN.nrec);
     } while GetNext tmp_report_grMAIN where (( cRec_tbl == tmp_report_grMAIN.cRec )) = tsOk;
    if(boDBF) 
     if(lDBFHandle<>0) then DBFClose(lDBFHandle);

  } else message('Нет данных!');

  if CheckColumn(4) Then deletefile(GetPathParameter('Files', 'TmpFilesDirectory', 0)+'*.bmp'); //Удалим фото *.bmp !!!

} //Function PrintRep


