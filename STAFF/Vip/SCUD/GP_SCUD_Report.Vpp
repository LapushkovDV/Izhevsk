//------------------------------------------------
#undef Fld_View
#undef Fld_Itog

//--------------------------------------
HandleEvent
cmInit:
{ ReReadRecord(tntmp_report_sp_v);
  SetWindowTitle(wnViewReport,GetReportName);
}
cmPrintDoc:
{
  MyLogWrite(false,'--- Print beg ---'+TimeToStr(Cur_Time,'HH.MM.SS.SSS'));
  if runWindowModal(wnPrnParam)<>cmDefault
  { Exit;

  }
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfconfirm, ''#3'Печать данных', RecordsInTable(#tmp_report_gr)+RecordsInTable(#tmp_report_sp));
  PrintRep;
  StopVisual('',0);
  Message('Отчет выведен в Excel');
  MyLogWrite(false,'--- Print end ---'+TimeToStr(Cur_Time,'HH.MM.SS.SSS'));

}
cmDefault:
{ if CurField<>#tmp_Report_gr_v.LevName
  { PutCommand(cmEdit);
  }
}
cmEdit:
{ if not isFilterRun
  { isFilterRun:=true;
    PutCommand(cmValue40);
  }
}
cmValue40:
{ timelog(' Window wnViewReport cmValue40');
  RunMyEdit;
  isFilterRun:=False

}

end;
end;//Window wnViewReport

//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table tmp_Report_gr_v ;
cmTreeTop         :
{ pNode := 0;
}
cmTreeUp          :
{ pNode := tmp_Report_gr_v.cRec;
}
cmTreeDown        :
{ pNode := tmp_Report_gr_v.Nrec;
}
cmTreeNodeType    :
{ //onSetPosition(U_XML_TABLE.Nrec);
  if (TreeIsTerminal(fCurrMainFormat))
  if getfirst tmp_report_gr_v_Sub<>tsok
   TreeSetNodeType(fCurrMainFormat, ntfText);
}
cmTreeNeedOwner:
{ TreeJumpToRecord(fCurrMainFormat, tmp_Report_gr_v.cRec);
}
cmTreeInsLevel:
{ //message('1111')
  //TreeJumpToRecordEx(trTable, #U_XML_TABLE, U_XML_TABLE.Nrec)
}

end;//TableEvent table tmp_Report_gr_v


//------------------------------------------
// вызов окна редактирования
//------------------------------------------
Function RunMyEdit:boolean;
{ timelog('GP_SCUD_REPORT:RunMyEdit '+string(tmp_Report_gr_v.wTable));
  Result:=false;
  case CurTable of
  tntmp_Report_gr_v:
  { case tmp_Report_gr_v.wTable of
    cg_s_code_Department  ://'Подразделение';
    {
      iGP_SCUD_EventsEdit.InitParam(cgiMultiEdit,0,0,tmp_Report_gr_v.cRecord,0,DtBeg,DtEnd);
      Result:=true;

    }
    cg_s_code_Org         ://'Организация';
    {}
    cg_s_code_Pers        ://'Сотрудник';
    { //Запретим
      //RunInterface(GP_Scud_PersEdit,cgiNotEdit+cgiMultiEdit,tmp_Report_gr_v.cRecord,0,0 );
      //Result:=true;
    }
    cg_s_code_Date        ://'Дата';
    {}
    cg_s_code_Year        ://'Год';
    {}
    cg_s_code_quarter     ://'квартал';
    {}
    cg_s_code_month       ://'Месяц';
    {}
    cg_s_code_day         ://'День';
    {}
    cg_s_code_Post        ://'Должность';
    {}
    cg_s_code_Rejim       ://'Режим';
    {

    }
    cg_s_code_Type        ://'сотрудники/организации';
    {}
    cg_s_code_Grup        ://'СКУД Группы сотрудников ';
    {}
    cg_s_code_SEX         ://'Пол';
    {}
    cg_s_code_Kateg       ://'СКУД Категории сотрудников';
    {}
    cg_s_code_MisConDuct  ://'нарушения дисциплины';
    {}
    cg_s_code_MisConDuctEx://'наличие нарушений';
    {}
    cg_s_code_OverWork    ://'наличие переработки';
    {}
    end;

  }
  #tmp_Report_sp_v:
  { Case wTipRep of
    0:
    { //iGP_SCUD_EventsEdit.InitPa
      iGP_SCUD_EventsEdit.InitParam(cgiMultiEdit,tmp_Report_sp_v.cRecord,tmp_Report_sp_v.cPers,0,0,DtBeg,DtEnd);
      Result:=true;
    }
    11:
    { case CurField of
      #tmp_Report_sp_v.dms[08] // 'Дата','Пред.соб.'
     ,#tmp_Report_sp_v.dms[09] //'Время','Пред.события'
     ,#tmp_Report_sp_v.dms[10] //'Статус','Пред.события'
     :
     { iGP_SCUD_EventsEdit.InitParam(cgiMultiEdit,tmp_Report_sp_v.cRecord2,tmp_Report_sp_v.cPers,0,0,DtBeg,DtEnd);
       Result:=true;

     }
     else
     { iGP_SCUD_EventsEdit.InitParam(cgiMultiEdit,tmp_Report_sp_v.cRecord,tmp_Report_sp_v.cPers,0,0,DtBeg,DtEnd);
       Result:=true;

     }
     end;

    }
    else
    { iGP_SCUD_EventsEdit.InitParam(cgiNotEdit,0,tmp_Report_sp_v.cPers,0,0,DtBeg,DtEnd);
      RunWindowModal(wnEvents);
      Result:=true;
    }
    end;
  }
  end;
  if not Result
  { Message('Для этого разреза действий не предусмотрено')
  }

} //Function RunMyEdit:boolean;
