#include GP_EmailRun.Vih
#include GP_SCUD_Email.Vih
#include GP_StatusAccessEdit.vih
#include GP_SCUD_ExClusionPeriod.Vih
#include GP_SCUD_StateMentOnAbsent.Vih
#include GP_SCUD_Order.Vih


#doc
СКУД Рассылка сообщений на EMail
#end
//=====================================================
Interface GP_SCUD_Email 'Рассылка на Email', EscClose;
//=====================================================
Show at (,,100,24);

#include GP_EmailRun.Var
#include GP_SCUD_ExClusionPeriod.Var
#include GP_SCUD_StateMentOnAbsent.Var
#include GP_SCUD_Order.Var
var
  _Auto :word;
  _pDoc  :comp;
  email_addr_from:string;
  Logfilenm:string;
  num_row:word;
  _Date:date;
  _Time:time;
  NPOEM_OWN_SCUD_EMAIL_TYPE:word;
  NPOEM_OWN_SCUD_EMAIL_TEST:string;
///--- список документов
Table Struct tmp_Doc
( wTable:word
 ,cRec  :comp
 ,DocNMB:string[50]
 ,DocDate:date
 ,wType :word
 ,cStatus:comp
 ,cPersons:comp
 ,cKatPodr:comp
) with index
( tmp_Doc02 = wTable+cREc
 ,tmp_Doc03 = wType+DocDate+DocNMB
);

//--- список получателей по документу

Table Struct tmp_Doc_sp
( wTable:word
 ,cRec  :comp
 ,wType :word
 ,DocNMB:string[50]
 ,DocDate:date
 ,cPersons:comp
 ,Fio :string[100]
 ,Email:string[100]
)
with index
(  tmp_Doc_sp01 =wTable+cRec+Fio
  ,tmp_Doc_sp02 =cPersons+wTable+wType+DocNMB
  ,tmp_Doc_sp03 =cPersons+wTable+wType+cRec
);

Table Struct tmp_Doc_pers
( cPersons:comp
 ,Fio :string[100]
 ,Email:string[100]
 ,Email2:string[100]

)
with index
( tmp_Doc_pers01 =Fio
 ,tmp_Doc_pers02 =cPersons
);

//-------------------------------------
create view
var
 pPersons:comp;

as select GP_SCUD_DOC.Nrec
from GP_SCUD_DOC
  ,tmp_Doc(tmp_Doc03)
  ,tmp_Doc tmp_Doc_p
  ,tmp_Doc_sp
  ,tmp_Doc_sp tmp_Doc_sp_p(tmp_Doc_sp02)
  ,tmp_Doc_pers(tmp_Doc_pers01)
  ,tmp_Doc_pers tmp_Doc_pers_d
  ,GP_Status
  ,GP_Status GP_Status_P
  ,GP_TypeDocs
  ,GP_TypeDocs GP_TypeDocs_P
where (( _pDoc== GP_SCUD_DOC.Nrec
and  tmp_Doc.wTable == tmp_Doc_sp.wTable
and  tmp_Doc.cRec   == tmp_Doc_sp.cRec
and  tmp_Doc_sp.cPersons == tmp_Doc_pers_d.cPersons
and  tmp_Doc.cStatus == GP_Status.Nrec
and  tmp_Doc.wType   == GP_TypeDocs.wType
//----------------------------------------
and tmp_Doc_pers.cPersons == tmp_Doc_sp_p.cPersons
and tmp_Doc_sp_p.wTable   == tmp_Doc_p.wTable
and tmp_Doc_sp_p.cRec     == tmp_Doc_p.cRec
and tmp_Doc_P.cStatus     == GP_Status_P.Nrec
and tmp_Doc_p.wType       == GP_TypeDocs_P.wType
//-----------
and pPersons == Persons.nrec
and Persons.nrec == COMMUNICATIONS.Person
and 3 == COMMUNICATIONS.OBJTYPE
 ));
Parameters  
 _Auto
#doc
  1- автоматический запуск
#end 
,_pDoc
#doc
 ссылка на документ
#end
, email_addr_from

;
//===============================================================
#doc
 Окно с паузой. Во избежания вылета галактики при автозапуске нужно сделать паузу
 Падает NowRun
#end
window wnPause 'Паузв';
 show at (,,10,5);
 screen scrMain;
 <<
    Пауза
 >>
 end;
End; 

Procedure MyLog(w:string);
{ if Logfilenm=''
  { logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0)+
      '\SCUD_SEND_'+DateToStr(Cur_Date,'YYYY_MM_DD')+TimeToStr(Cur_Time,'HHMM')+'.log';
    MyLog('Рассылка информации о документах СКУД');
  }
  LogStrtofile(logfilenm,w);
}


//===============================================================
//
//===============================================================
Procedure Write_Mess(w:string);
{ num_row++;
  pGP_EmailRun.Write_Text(num_row,w);
}

//===============================================================
//
//===============================================================
Function SendEmail:boolean;
var _wType:longint;
{ Result:=False;
  if NPOEM_OWN_SCUD_EMAIL_TYPE=10
  { if _Auto=0
    { message('Рассылка запрещена!');
    }
    exit;
  }
  _Loop tmp_Doc_pers
  { if tmp_Doc_pers.Email='' and tmp_Doc_pers.Email2=''
    { MyLog('У сотрудника "'+tmp_Doc_pers.Fio+'" на заведены EMail' )

    }
    _wType:=-999;
    num_row:=0;
    Write_Mess('Вам необходимо утвердить следующие документы');
    _Loop tmp_Doc_sp_p
    { if getfirst tmp_Doc_p<>tsok continue;
      if tmp_Doc_p.wType<>_wType
      { Write_Mess('');
        Write_Mess('<b>'+GP_TypeDocs_P.Name+'</b>');
        _wType:=tmp_Doc_p.wType;
      }
      Write_Mess(tmp_Doc_p.DocNMB+DateToStr(tmp_Doc_p.DocDate, ' от DD/MM/YYYY'));
    }
    if not pGP_EmailRun.EmailSend
      ( NPOEM_OWN_SCUD_EMAIL_TYPE //: word ;
       ,if(NPOEM_OWN_SCUD_EMAIL_TEST='',tmp_Doc_pers.Email,NPOEM_OWN_SCUD_EMAIL_TEST) // _email_addr :string ;
       ,'Отчет о документах в СКУД на '+DateToStr(_Date,'YYYY.MM.DD')+TimeToStr(_Time,' HH:MM')// _email_subject :string ;
       ,'' //_email_text :string ;
       ,'' //_email_attach1 :string ;
       ,'' //_email_attach2 :string ;
       ,'' //_email_attach3 :string ;
       ,'' //_email_attach2 :string ;
       ,'' //_email_attach3 :string ;
       ,if(NPOEM_OWN_SCUD_EMAIL_TEST='',tmp_Doc_pers.Email2,'') //_email_addr_copy :string='';
       ,email_addr_from //_email_addr_from :string=''
     )
     { MyLog('Ошибка при отправке сообщения для '+tmp_Doc_pers.Fio+','+pGP_EmailRun.GetLastError );

     }
  } //_Loop tmp_Doc_pers
  Result:=true;
} //Function SendEmail:boolean;


Procedure InsertDocSp(_PPersons:comp);
{ set pPersons:=_PPersons;
  if getfirst Persons<>tsok exit;
  if getfirst tmp_doc_sp where ((
        tmp_doc.wTable ==tmp_doc_sp.wTable
    and tmp_doc.cRec   ==tmp_doc_sp.cRec
    and tmp_doc.wType  ==tmp_doc_sp.wType
    and _PPersons   == tmp_doc_sp.cPersons
  ))=tsok
  { Exit;
  }
  insert into tmp_doc_sp set
     tmp_doc_sp.wTable :=tmp_doc.wTable
    ,tmp_doc_sp.cRec   :=tmp_doc.cRec
    ,tmp_doc_sp.wType  :=tmp_doc.wType
    ,tmp_doc_sp.DocNMB :=tmp_doc.DocNMB
    ,tmp_doc_sp.DocDate:=tmp_doc.DocDate
    ,tmp_doc_sp.cPersons:=_PPersons
    ,tmp_doc_sp.Fio :=Persons.Fio
    ;
  if getfirst tmp_doc_pers where (( _PPersons == tmp_doc_pers.cPersons ))<>tsok
  { insert into tmp_doc_pers set tmp_doc_pers.cPersons:=_pPersons
            ,tmp_doc_pers.Fio:=Persons.Fio;
    _Loop COMMUNICATIONS
    { if COMMUNICATIONS.EMAIL='' continue;
      if tmp_doc_pers.Email=''
      { tmp_doc_pers.Email:=COMMUNICATIONS.EMAIL;
      }
      else
      { tmp_doc_pers.Email2:=COMMUNICATIONS.EMAIL;
        break;
      }
    } //_Loop COMMUNICATIONS
  } //if getfirst tmp_doc_pers where (( _PPersons == tmp_doc_pers.cPersons ))<>tsok
} //Procedure InsertDocSp(_PPersons:comp);

//===============================================================
//
//===============================================================
Function FormDoc:boolean;
var ii:word;
    _wTypeDoc:word;
    _pPersons:comp;
{ Result:=false;
  _Date:=Cur_Date;
  _Time:=Cur_time;

  ResetBounds(#tmp_Doc_sp);
  delete all tmp_Doc_sp;
  SetBounds(#tmp_Doc_sp);
  delete all tmp_Doc_pers;
  delete all tmp_Doc;
  For(ii:=1;ii<=6;ii++)
  { if not NextVisual then exit;
    case ii of
    01: _wTypeDoc:=GP_iSC_statement_on_absence;//1010;Заявление на отсутствие
    02: _wTypeDoc:=GP_iSC_exception_of_periods;//1011;Исключение периодов из нарушений';
    //03: _wTypeDoc:=GP_iSC_OrderOver           ;//1014;Приказ на сверхурочные
    //04: _wTypeDoc:=GP_iSC_OrderOver2          ;//1015;Приказ на оплату переработки
    //05: _wTypeDoc:=GP_iSC_OrderHoliday        ;//1016;Приказ на работу в выходной день
    else continue;
    end;

    case ii of
    1..5 :
    { var _wTable:word=coGP_SCUD_Doc;
       SQL select Distinct
          :(_wTable) as wTable //:word
          ,GP_SCUD_Doc.Nrec as cRec // :comp
          ,GP_SCUD_Doc.DocNMB as DocNMB //:string[50]
          ,GP_SCUD_Doc.DocDate as DocDate//:dat
          ,:(_wTypeDoc) as wType// :word
          ,GP_SCUD_Doc.cStatus as cStatus //:comp
          ,GP_SCUD_Doc.cExecutor as cPersons
          ,GP_SCUD_Doc.cKatPodr as cKatPodr
       From GP_SCUD_Doc
       Left Outer join GP_Status on GP_Status.Nrec = GP_SCUD_Doc.cStatus
       where (( GP_Status.Nrec is Null )
        or GP_Status.Name='оформляемый'
        or GP_Status.Name='согласован'
        )
       into tmp_Doc;
    }
    end;
  }
  //--------------------------------------
  // найдем кто может подписывать
  _Loop fullcache tmp_Doc
  { if not NextVisual then exit;
    case tmp_Doc.wType of
    GP_iSC_statement_on_absence://1010;Заявление на отсутствие
    { if not pGP_SCUD_A.SetDocPosition(tmp_Doc.wType,tmp_Doc.cRec,0)
      { MyLog('Ошибка поиска документа '+tmp_Doc.DocNMB+', тип '+string(tmp_Doc.wType));
        delete current tmp_Doc;
        continue;
      }
      ii:=0;
      do {
        ii++;
        _pPersons:=pGP_SCUD_A.GetPodpisPers(ii,tmp_Doc.cKatPodr,tmp_Doc.cRec);
        if _pPersons=0 break;
        InsertDocSp(_pPersons);
      } while _pPersons>0 and ii<10
    }
    GP_iSC_exception_of_periods://1011;Исключение периодов из нарушений';
    { if not pGP_GP_SCUD_ExPer.SetDocPosition(tmp_Doc.wType,tmp_Doc.cRec,0)
      { MyLog('Ошибка поиска документа '+tmp_Doc.DocNMB+', тип '+string(tmp_Doc.wType));
        delete current tmp_Doc;
        continue;
      }
      ii:=0;
      do {
        ii++;
        _pPersons:=pGP_GP_SCUD_ExPer.GetPodpisPers(ii);
        if _pPersons=0 break;
        InsertDocSp(_pPersons);
      } while _pPersons>0 and ii<10
    }
     GP_iSC_OrderOver          //1014;Приказ на сверхурочные
    ,GP_iSC_OrderOver2         //1015;Приказ на оплату переработки
    ,GP_iSC_OrderHoliday      ://1016;Приказ на работу в выходной день
    { if not pGP_SCUD_Order.SetDocPosition(tmp_Doc.wType,tmp_Doc.cRec,0)
      { MyLog('Ошибка поиска документа '+tmp_Doc.DocNMB+', тип '+string(tmp_Doc.wType));
        delete current tmp_Doc;
        continue;
      }
      ii:=0;
      do {
        ii++;
        _pPersons:=pGP_SCUD_Order.GetPodpisPers(ii);
        if _pPersons=0 break;
        InsertDocSp(_pPersons);
      } while _pPersons>0 and ii<10
    }
    end;
  } //_Loop tmp_Doc
  Result:=true;
  ReReadRecord(#tmp_Doc );
  ReReadRecord(#tmp_Doc_p);
  ReReadRecord(#tmp_Doc_sp);
  ReReadRecord(#tmp_Doc_sp_p);
  ReReadRecord(#tmp_Doc_pers);
  ReReadRecord(#tmp_Doc_pers_d);

} //Function FormDoc:boolean;

Screen scrDocs;
Show at (,,,2);
Fields
  email_addr_from:NoProtect;
  NPOEM_OWN_SCUD_EMAIL_TEST:NoProtect;
Buttons
  cmOk    ,,, 'Выполнить рассылку', hcAllBOk, scGalDial;

<<
  <. Выполнить рассылку .>  C адреса .@@@@@@@@@@@@@@@@@ Тестовый адрес .@@@@@@@@@@@@
>>
end;

Tabbedsheet top tsDoc;
Show at (,3,,);
//------------------------------------
FormatsGroup fgDocs 'Документы';
Browse brDocs (,,sci1Esc);
Show at (,,,10);
Table tmp_doc;
Fields
  Gp_TypeDocs.Name 'Тип документа' :[25],Protect,NoDel,NoAutoSize;
  tmp_doc.DocNMB 'Номер' :[11],Protect,NoDel,NoAutoSize;
  tmp_doc.DocDate 'Дата'  :[11],Protect,NoDel,NoAutoSize;
  GP_Status.Name  'Статус':[15],Protect,NoDel,NoAutoSize;
end;
Browse brDocsSp (,,sci1Esc);
Show at (,11,,);
Table tmp_doc_sp;
Fields
 tmp_doc_sp.Fio 'ФИО' :[25],Protect,NoDel,NoAutoSize;
 tmp_doc_pers_d.Email 'Email' :[25],Protect,NoDel,NoAutoSize;
 tmp_doc_pers_d.Email2 'Email' :[25],Protect,NoDel,NoAutoSize;
end;//Browse brDocsSp;
end;//FormatsGroup fgDocs
//------------------------------------
FormatsGroup fgPers 'Сотрудники';
Browse brPers (,,sci1Esc);
Show at (,,,10);
Table tmp_doc_pers;
Fields
 tmp_doc_pers.Fio 'ФИО' :[25],Protect,NoDel,NoAutoSize;
 tmp_doc_pers.Email 'Email' :[25],Protect,NoDel,NoAutoSize;
 tmp_doc_pers.Email2 'Email' :[25],Protect,NoDel,NoAutoSize;
end;//Browse brDocsSp;
Browse brDocsSpP (,,sci1Esc);
Show at (,11,,);
Table tmp_doc_sp_P;
Fields
  Gp_TypeDocs_P.Name 'Тип документа' :[15],Protect,NoDel,NoAutoSize;
  tmp_doc_P.DocNMB 'Номер' :[11],Protect,NoDel,NoAutoSize;
  tmp_doc_P.DocDate 'Дата'  :[11],Protect,NoDel,NoAutoSize;
  GP_Status_P.Name  'Статус':[11],Protect,NoDel,NoAutoSize;
end;//Browse brDocsSp;
end;//FormatsGroup fgDocs
//------------------------------------
end;//Tabbedsheet top tsDoc;


HandleEvent
cmInit:
{ StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Сбор информации',0);
  FormDoc;
  StopVisual('',0);
  NPOEM_OWN_SCUD_EMAIL_TYPE:=wGetTune('NPOEM_OWN.SCUD.EMAIL_TYPE');
  NPOEM_OWN_SCUD_EMAIL_TEST:=sGetTune('NPOEM_OWN.SCUD.EMAIL_TEST');

  if VisualizationActive   StopVisual('',0);
  if _Auto=1
  { SendEmail;
    if VisualizationActive   StopVisual('',0);
    RunWindow(wnPause);
    StartTimer(cmValue2,2,False);
  }  
}
cmOk:
{ SendEmail;
  ProcessText(LogFileNm,vfNewTitle+vfToErase+vfMacroSize,'Протокол отправки Email');
}
cmValue2:
{ StopTimer(cmValue2);
  closeinterface(cmDone) ;
}
end;
 
end.
