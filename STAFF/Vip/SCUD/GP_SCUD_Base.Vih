#ifndef __GP_SCUD_BASE__
#define __GP_SCUD_BASE__

#component "GP_STAFF"
#doc
СКУД Базовый интерфейс
#end
//-------------------------------------
ObjInterface oGP_SCUD_BASE;

  //-------------------------------------
  #doc
   Защитить данные
  #end
  Procedure SetEditMode(Value: boolean);

  #doc
   Запретить команды
  #end
  Procedure EnableDisableInsert(_Enable:boolean);

  //-------------------------------------
  #doc
   Установить позицию
  #end
  Function SetDocPosition(_wTypeDoc:word;_cDoc:comp;_cDocSp:comp):boolean;
  //-------------------------------------
  #doc
   Получить статус
  #end
  Function GetStatusDoc:comp;

  //-------------------------------------
  #doc
  установить параметры полей
  #end
  Function SetDocFieldsState: boolean;

  //-------------------------------------
  #doc
   Получить тип документа
  #end
  Function GetTypeDoc:word;

  //-------------------------------------
  #doc
    Получить поле со статусом
  #end
  Function GetFieldStatus:longint;

  //-------------------------------------
  #doc
  Загрузчик интерфейса
  #end
  Procedure LoadInterface(_boVisibleRun:boolean);

  //-------------------------------------
  #doc
  выполнить проверку перед изменением статуса
  #end
  Function Check_Status_Change_Before(_pStatus:comp):boolean;
  //-------------------------------------
  #doc
  выполнить проверку после изменения статуса
  #end
  Function Check_Status_Change_After(_pStatus:comp;_pStatusTo:comp):boolean;

  //----------------------------------------------------------------------------
  #doc
     Событие перечитать интерфейс контейнер
  #end
  Event Procedure Event_ReReadContainer;
  //----------------------------------------------------------------------------
  #doc
     Событие сохранить интерфейс контейнер
  #end
  Event Procedure Event_UpdateContainer(var _isAllOk : boolean);

end;



vipinterface GP_SCUD_Base Implements oGP_SCUD_BASE #Licensed_Free;
#end //GP_SCUD_ControlerEdit
