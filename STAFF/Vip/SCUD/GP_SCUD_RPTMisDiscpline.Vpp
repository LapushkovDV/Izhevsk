// (Issue #177) Отчет СКУД 4 Отчет Дисциплина Труда
function GetShortFIOLast(_FIO:string):string;
{
  result:='';
  if (iStrFunc.GetFioIn(_FIO))
    result:=_FIO;
} //function GetShortFIOLast(FIO:string):string;


const
  c1OverWork     =1;// сверхурочные
  c2OverWork2    =2;// переработка
  c3Holiday      =3;// выходные
  c4MisConDuct   =4;// выходные
  c5GrafCh       =5;// рабочих часов
end;
//------------------------------------
// Получить значение всех полей по сотруднику
//------------------------------------
var FirstCalc:boolean;

Function MyGet_Func_Boss_By_Pers(_Pers:comp):string;cacheable;
{ var _pPost, _pPersons:comp=0;
  Result:=Get_Func_Boss_By_Pers(_Pers, _pPost, _pPersons);
}

Procedure CalcPers(_cScud_Pers:comp;_DateCalc:Date);
var _pPost, _pPersons:comp;
{
  var _Day:word=0;
  if (cPerCalc <>_cScud_Pers) or (_DateCalc < DateCalcB) or (DateCalcE < _DateCalc)
  {

    timelog('Расчет для '+mtMain.Fio+', Дата '+DateToStr(_DateCalc,'DD/MM/YYYY') );
    // почему-то после первого расчета CalcAll,  GetCalc_CH_Over выдаёт 0. Потом работает нормально.
    // Надо разбираться
    //if FirstCalc iGP_SCUD_EventsEdit_Cacl.CalcAll(_cScud_Pers,Year(DateCalc), Month(DateCalc));
    FirstCalc := false;

    iGP_SCUD_EventsEdit_Cacl.CalcAll(_cScud_Pers,Year(_DateCalc), Month(_DateCalc)
        ,if(NPOEM_OWN_HEAD_V_VID=2,3,NPOEM_OWN_HEAD_V_VID)//0 при расчета считаются , что на все сверхурочные есть приказ
                      //1 учитываются только проведенные приказы, если задан _DayCalc - то это вызов из приказа, и за этот день не учитываются
       ,false // true - с перерасчетом
      ,0 //DayCalc:word =0//при расчете для приказов указать день
    );
    //ReReadRecord(#tMisConDuct);
    ReReadRecord(#Tmp_Scud_MisConDuct);
    ReReadRecord(#tMisConDuct);
    cPerCalc := _cScud_Pers;
    DateCalc := _DateCalc;
    DateCalcB := Date(                 1, Month(DateCalc), Year(DateCalc));
    DateCalcE := Date(Last_Day(DateCalc), Month(DateCalc), Year(DateCalc));

        var wMonthRas, wYearRas: word;
        wMonthRas := Month(DateCalc);
        wYearRas := Year(DateCalc);

        //не очень понятно зачем
        if IsBitOn(wFilter,4) //только нарушители
        {
          delete mtMain_tmp where (( mtMain.cGP_SCUD_Pers == mtMain_tmp.cGP_SCUD_Pers  )) and mtMain_tmp.x6 > 0;
          _Loop tMisConDuct where ((mtMain.cGP_SCUD_Pers == tMisConDuct.cGP_SCUD_PERS
                                            and  wMonthRas == tMisConDuct.MesN
                                            and  wYearRas  == tMisConDuct.YearN
                                         and 6 == tMisConDuct.wMisConDuct(noindex)
                           ))
          {
            if getfirst mtMain_tmp = tsOk // нужен буфер с comp;
            mtMain_tmp.EventDate := tMisConDuct.DT_Ev;
            mtMain_tmp.t1h := 0;
            mtMain_tmp.t2h := 0;
            mtMain_tmp.t3h := 0;
            mtMain_tmp.t4h := 0;
            mtMain_tmp.t5h := 0;
            mtMain_tmp.x6  := 1;
            insert current mtMain_tmp; // при повторном расчете будет задвоение. Удалим всё x6 перед циклом
         }
        }
        Var diff_t: double;
        _Loop mtMain_tmp
        {
           mtMain_tmp.t1h := 0;  // Опоздать за день можно один раз, это на случай группировки за неделю/мес/год
           mtMain_tmp.t2h := 0;
           mtMain_tmp.t3h := 0;
           mtMain_tmp.t4h := 0;
           mtMain_tmp.t5h := 0;
            _Loop tMisConDuct
            if tMisConDuct.wMisConDuct > 0
            {
              diff_t := iGP_SCUD_EventsEdit_Cacl.GetDoubleFromTime(tMisConDuct.tDiff); // ? как его считать ???

              if timelog_status>0
              if diff_t > 0.001
              {  timelog( '---' + mtMain.Fio + '  wMisConDuct=' + tMisConDuct.wMisConDuct + '  tMisConDuct.tDiff='+ TimeToStr(tMisConDuct.tDiff,'HH:MM:SS')+ '   diff_t = ' + string(diff_t,20,5));
              }


                Case tMisConDuct.wMisConDuct of
                1: mtMain_tmp.t1h := mtMain_tmp.t1h + diff_t; // Опоздание на работу
                2: mtMain_tmp.t2h := mtMain_tmp.t2h + diff_t; // Ранний уход на обед
                3: mtMain_tmp.t3h := mtMain_tmp.t3h + diff_t; // Поздний приход с обеда
                4: mtMain_tmp.t4h := mtMain_tmp.t4h + diff_t; // Ранний уход с работы
                5: mtMain_tmp.t5h := mtMain_tmp.t5h + diff_t; // Отсутствие в середине дня
                6: mtMain_tmp.x6 := 1;             // Прогул
                end; // Case Tmp_Scud_MisConDuct.wMisConDuct of
                if tMisConDuct.cMisConDuct>0
                { mtMain_tmp.ZAbsent:=mtMain_tmp.ZAbsent+if(mtMain_tmp.ZAbsent='','','; ')
                    +GetZAbsentName(tMisConDuct.cMisConDuct);
                }

            } //_Loop tMisConDuct
          mtMain_tmp.Sum := mtMain_tmp.t1h + mtMain_tmp.t2h +
                            mtMain_tmp.t3h + mtMain_tmp.t4h + mtMain_tmp.t5h;
          _Day:=Day(mtMain_tmp.EventDate);
          mtMain_tmp.TMB:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(6,_Day));
          mtMain_tmp.TME:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(7,_Day));
          mtMain_tmp.Break1B:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(10,_Day));
          mtMain_tmp.Break1E:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(11,_Day));
          mtMain_tmp.Break2B:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(12,_Day));
          mtMain_tmp.Break2E:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(13,_Day));
          _pPost:=_pPersons:=0;
          mtMain_tmp.BossFio   := MyGet_Func_Boss_By_Pers(mtMain_tmp.cPersons);
          //mtMain_tmp.cBossPers := _pPersons;
          UpDate current mtMain_tmp;

        } //_Loop mtMain_tmp
  } //if (cPerCalc <>_cScud_Pers) or (_DateCalc < DateCalcB) or (DateCalcE < _DateCalc)
} //Function CalcPers(_cScud_Pers:comp;_DateCalc:Date);


Procedure SborData;
var chet:longint;
{ chet:=0;
  delete all mtMain_free;
  DTB_L := DTB; DTE_L := DTE;
  //====== DSQL =======
  SQLLog_TP := 1 ;
  CreateTempVib;
  ClearQuery(vliSQLCommand);

  //-----------------------------
  
  if IsBitOn(wFilter,2) //Подразделения
    InsTempVibByMarker(02,Marker_KatPodr );// Подразделения
  if IsBitOn(wFilter,3) //Сотрудники
    InsTempVibByMarker(03,Marker_Persons );// Сотрудники
  if not IsBitOn(wFilter,4) //только нарушители
  {
    PrepareSQLQuery('select  DISTINCT ');
    PrepareSQLQuery('    (SELECT top 1 nRec from GP_SCUD_MISCON_D Ev where Ev.cGP_SCUD_Pers = GP_SCUD_PERS.Nrec');
    PrepareSQLQuery('      and Ev.DT_EV = GP_SCUD_MISCON_D.DT_EV');
    PrepareSQLQuery('      ORDER BY cGP_SCUD_Pers,DT_EV,TM_EV)  as nRec      ');
    PrepareSQLQuery('  ,GP_SCUD_PERS.Nrec as cGP_SCUD_PERS                           ');
    PrepareSQLQuery('  ,GP_SCUD_MISCON_D.DT_EV as EventDate                        ');
    PrepareSQLQuery('  ,GP_SCUD_PERS.cPersons as cPersons                            ');
    PrepareSQLQuery('  ,GP_SCUD_PERS.cKatPodr as cKatPodr                            ');
    PrepareSQLQuery('  ,GP_SCUD_PERS.fio as FIO                                      ');
    PrepareSQLQuery('  ,KatPodr.Kod + GP_SCUD_PERS.fio as SortFld                    ');
    PrepareSQLQuery('From GP_SCUD_PERS                                               ');
    PrepareSQLQuery(' inner join KatPodr on Gp_SCUD_PERS.cKatPodr = KatPodr.Nrec     ');
    PrepareSQLQuery(' inner join GP_SCUD_MISCON_D on GP_SCUD_MISCON_D.CGP_SCUD_PERS =GP_SCUD_PERS.Nrec');   // чтоб с 'Where' не морочится, условия по дате ограничит GP_SCUD_Events, а он через inner join сработает на весь запрос
    if DTB > ZeroDate
      PrepareSQLQuery(' and GP_SCUD_MISCON_D.DT_EV>=#Date('+DateToStr(DTB,'DD,MM,YYYY')+') ');
    if DTE > ZeroDate
    PrepareSQLQuery(' and GP_SCUD_MISCON_D.DT_EV<=#Date('+DateToStr(DTE,'DD,MM,YYYY')+') ');
    if IsBitOn(wFilter,5) //без уволенных
    { PrepareSQLQuery(' inner join Persons on Persons.Nrec = Gp_SCUD_PERS.cPersons ');
      PrepareSQLQuery('   and Persons.DisDate<#Date(1,1,1900)');
    }
    if false // не заполнено поле GP_SCUD_PERS.CGP_SCUD_Kateg
    PrepareSQLQuery(' inner join GP_SCUD_KATEG  on GP_SCUD_PERS.CGP_SCUD_Kateg = GP_SCUD_KATEG.nRec and GP_SCUD_KATEG.WTYPE > 1');
    if IsBitOn(wFilter,2) //Подразделения
    PrepareSQLQuery(' inner join tempvib VibKatPodr on VibKatPodr.wlist=2 and VibKatPodr.crec = GP_SCUD_PERS.cKatPodr');
    if IsBitOn(wFilter,3) //Сотрудники
    PrepareSQLQuery(' inner join tempvib VibSCUD_Pers on VibSCUD_Pers.wlist=3 and VibSCUD_Pers.crec = GP_SCUD_PERS.cPersons');
    PrepareSQLQuery(' where GP_SCUD_PERS.Nrec>#Comp(0)');
    if not NPOEM_OWN_SCUD_Pers_Other
    { PrepareSQLQuery(' and GP_SCUD_PERS.wType=0');
    }

  }
  else
  {
    PrepareSQLQuery('select  DISTINCT ');
    PrepareSQLQuery('    (SELECT top 1 nRec from GP_SCUD_Events Ev where Ev.cGP_SCUD_Pers = GP_SCUD_PERS.Nrec');
    PrepareSQLQuery('      and Ev.EnterDate = GP_SCUD_Events.EnterDate');
    PrepareSQLQuery('      ORDER BY cGP_SCUD_Pers,EnterDate,EnterTime)  as nRec      ');
    PrepareSQLQuery('  ,GP_SCUD_PERS.Nrec as cGP_SCUD_PERS                           ');
    PrepareSQLQuery('  ,GP_SCUD_Events.EnterDate as EventDate                        ');
    PrepareSQLQuery('  ,GP_SCUD_PERS.cPersons as cPersons                            ');
    PrepareSQLQuery('  ,GP_SCUD_PERS.cKatPodr as cKatPodr                            ');
    PrepareSQLQuery('  ,GP_SCUD_PERS.fio as FIO                                      ');
    PrepareSQLQuery('  ,KatPodr.Kod + GP_SCUD_PERS.fio as SortFld                    ');
    PrepareSQLQuery('From GP_SCUD_PERS                                               ');
    PrepareSQLQuery(' inner join KatPodr on Gp_SCUD_PERS.cKatPodr = KatPodr.Nrec     ');
    PrepareSQLQuery(' inner join GP_SCUD_Events on GP_SCUD_Events.cGp_SCUD_PERS = Gp_SCUD_PERS.Nrec');   // чтоб с 'Where' не морочится, условия по дате ограничит GP_SCUD_Events, а он через inner join сработает на весь запрос

    if DTB > ZeroDate
    PrepareSQLQuery(' and GP_SCUD_Events.EnterDate>=#Date('+DateToStr(DTB,'DD,MM,YYYY')+') ');
    if DTE > ZeroDate
    PrepareSQLQuery(' and GP_SCUD_Events.EnterDate<=#Date('+DateToStr(DTE,'DD,MM,YYYY')+') ');

    if false // не заполнено поле GP_SCUD_PERS.CGP_SCUD_Kateg
    PrepareSQLQuery(' inner join GP_SCUD_KATEG  on GP_SCUD_PERS.CGP_SCUD_Kateg = GP_SCUD_KATEG.nRec and GP_SCUD_KATEG.WTYPE > 1');
    if IsBitOn(wFilter,5) //без уволенных
    { PrepareSQLQuery(' inner join Persons on Persons.Nrec = Gp_SCUD_PERS.cPersons ');
      PrepareSQLQuery('   and Persons.DisDate<#Date(1,1,1900)');
    }
    if IsBitOn(wFilter,2) //Подразделения
    PrepareSQLQuery(' inner join tempvib VibKatPodr on VibKatPodr.wlist=2 and VibKatPodr.crec = GP_SCUD_PERS.cKatPodr');
    if IsBitOn(wFilter,3) //Сотрудники
    PrepareSQLQuery(' inner join tempvib VibSCUD_Pers on VibSCUD_Pers.wlist=3 and VibSCUD_Pers.crec = GP_SCUD_PERS.cPersons');
    PrepareSQLQuery(' where GP_SCUD_PERS.Nrec>#Comp(0)');
    if not NPOEM_OWN_SCUD_Pers_Other
    { PrepareSQLQuery(' and GP_SCUD_PERS.wType=0');
    }
    if not IsBitOn(wFilter,4) //только нарушители
    { PrepareSQLQuery(' and GP_SCUD_PERS.Nrec in ( Select GP_SCUD_MISCON_D.CGP_SCUD_PERS');
      PrepareSQLQuery('From GP_SCUD_MISCON_D where GP_SCUD_MISCON_D.CGP_SCUD_PERS =GP_SCUD_PERS.Nrec');
      if DTB > ZeroDate
        PrepareSQLQuery(' and GP_SCUD_MISCON_D.DT_EV>=#Date('+DateToStr(DTB,'DD,MM,YYYY')+') ');
      if DTE > ZeroDate
        PrepareSQLQuery(' and GP_SCUD_MISCON_D.DT_EV<=#Date('+DateToStr(DTE,'DD,MM,YYYY')+') ');
      PrepareSQLQuery(' )');
    } //if not IsBitOn(wFilter,4)
  }//if not IsBitOn(wFilter,4) //только нарушители

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfconfirm,''#3'Загрузка данных',LongInt(RecordsInTable(#mtMain)/100));
 //=== RUN DSQL
  stmt := sqlAllocStmt;

          var _IdTable:longint;
              _IdTable:=#mtMain;
  ExecDSQLex2(_IdTable,1);
  RereadRecord(#mtMain);
  if getfirst mtMain = tsOk{}

  StopVisual('',0);
} //Procedure SborData

//=======================================
//Печать отчета в excel
//=======================================
var
    xl_Res : boolean;
    xl_Ymax: longint;
    xl_X0  : longint;
    xl_Y0  : longint;
    xl_Yi  : longint;
    xl_Y   : longint;
    xl_X   : longint;

// Для слежения за окончанием вывода группы
var gr_Key:array[1..5] of string; //comp
    gr_Pos:array[1..5] of longint;
    gr_Out:array[1..5] of string;
#Declare _ToExcel(_Y,_Str)
  xl_Res := xlSetCellStringValue(#_Str, xl_X, xl_Y0+#_Y, xl_X, xl_Y0+#_Y);
#end;
#Declare _GrToExcel(_Id)
  xl_Res := xlSetCellStringValue(gr_Out[#_Id], gr_Pos[#_Id], xl_Y0+#_Id, gr_Pos[#_Id], xl_Y0+#_Id);
#end;

procedure OutGroup(_Id: word);
{   xl_Res := xlSetCellStringValue(gr_Out[_Id], gr_Pos[_Id], xl_Y0+_Id, gr_Pos[_Id], xl_Y0+_Id);
} //procedure OutGroup(_Id: word);


procedure SeeGroups(boEnd: boolean);
  {

  if (gr_Key[1] <> mtMain.BossFio) //mtMain.cBossPers
  or boEnd
  {
    OutGroup(1);

    if (gr_Pos[1] < (xl_X-1))
    {
      xlMergeCells(gr_Pos[1], 1,  xl_X-1, 1); // Подр.
    }

     gr_Pos[1] := xl_X;
     gr_Key[1] := mtMain.BossFio;//cBossPers
     gr_Out[1] := mtMain.BossFio;
  }


  if (gr_Key[2] <> string(mtMain.cKatPodr)) or boEnd
  {
    OutGroup(2);

    if (gr_Pos[2] < (xl_X-1))
    {
      xlMergeCells(gr_Pos[2], 2,  xl_X-1, 2); // Подр.
    }

    gr_Pos[2] := xl_X;
    gr_Key[2] := string(mtMain.cKatPodr);
    gr_Out[2] := ''''+KatPodr.Kod;      // Подр.
  }

  if (gr_Key[3] <> string(mtMain.cGP_SCUD_Pers)) or boEnd
  {
    OutGroup(3);
    OutGroup(4);
//    _GrToExcel(3) // , gr_Out[3])
 //   _GrToExcel(4) // , gr_Out[4])


    if (gr_Pos[3] < (xl_X-1))
    {
      xlMergeCells(gr_Pos[3], 3,  xl_X-1, 3); // ФИО
      xlMergeCells(gr_Pos[3], 4,  xl_X-1, 4); // Должность
      xlMergeCells(gr_Pos[3],15,  xl_X-1,15); // Количество нарушений
    }
    xlSetCellStringValue(string(kol_nar), gr_Pos[3], 15, gr_Pos[3], 15);// Количество нарушений
    kol_nar:=0;
    gr_Pos[3] := xl_X;
    gr_Key[3] := string(mtMain.cGP_SCUD_Pers);
    gr_Out[3] := GetShortFIOLast(mtMain.Fio); // GP_SCUD_Pers.Fio; // ФИО

    gr_Pos[4] := xl_X;
    gr_Out[4] := GetPostPers(mtMain.cPersons);    // Должность
  }

 } //procedure SeeGroups(boEnd: boolean);


//-----------------------------------
// Печать вариант 00
//-----------------------------------
Procedure PrintDoc;
  var sXLTFileName:string;
      sDate: string;
{//Печать отчета

  sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + 'GP_SCUD_RPTMisDiscpline.xltx';


  if (not ExistFile(sXLTFileName))
  { message('Не найден шаблон отчета "'+sXLTFileName+'"',error);
    exit;
  }

  if (not xlCreateNewExcelWithTemplate(sXLTFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sXLTFileName+'".',error);
    exit;
  }

  if getfirst mtMain = tsOk {}   // ordered by Index ForExcel = tsOk {}
  xlDisplayAlerts(false);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Вывод отчета в Excel ...', LongInt(RecordsInTable(#mtMain)/100));

  xl_Y0 := 0;
  xl_X0 := 4;

  xl_X := xl_X0+1;
  xl_Res := true;

// xlAlignCellsEx(xlCenter,xlCenter,xl_X,2,xl_X,9);

 gr_Pos[1] := xl_X;
 gr_Pos[2] := xl_X;
 gr_Pos[3] := xl_X;
 gr_Pos[4] := xl_X;

 gr_Key[1] := mtMain.BossFio;//cBossPers
 gr_Out[1] := mtMain.BossFio;

 gr_Key[2] := string(mtMain.cKatPodr);
 gr_Out[2] := ''''+KatPodr.Kod;      // Подр.

 gr_Key[3] := string(mtMain.cGP_SCUD_Pers);
 gr_Out[3] := GetShortFIOLast(mtMain.Fio); // ФИО
 gr_Out[4] := GetPostPers(mtMain.cPersons);    // Должность
 kol_nar:=0;
_Loop mtMain
{
  SeeGroups(False);
  sDate := DateToStr( mtMain.EventDate, '''DD.MM.YYYY');
  #_ToExcel( 5, sDate )

  if mtMain.TMB > zeroTime
  {sDate := TimeToStr(mtMain.TMB,'HH:MM');  #_ToExcel( 6, sDate )
  }
  if mtMain.TME > zeroTime
  {sDate := TimeToStr(mtMain.TME,'HH:MM');  #_ToExcel( 7, sDate )
  }
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t1h);   #_ToExcel( 8, sDate )
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t4h);   #_ToExcel( 9, sDate )
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t2h);   #_ToExcel(10, sDate )
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t3h);   #_ToExcel(11, sDate )
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t5h);   #_ToExcel(12, sDate )
  sDate := mtMain.x6 ;   #_ToExcel( 13, sDate )
  sDate := mtMain.zAbsent ;   #_ToExcel( 14, sDate )
  kol_nar+=if(mtMain.t1h>0,1,0)
          +if(mtMain.t4h>0,1,0)
          +if(mtMain.t2h>0,1,0)
          +if(mtMain.t3h>0,1,0)
          +if(mtMain.t5h>0,1,0)
          +mtMain.x6;
  xl_X++;

  if xl_X mod 100=0
  { if not nextvisual then break;
  }

}
  SeeGroups(true);
  xl_X := xl_X-1;
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, xl_X0+1, 1, xl_X, 15);
  xlWrapText(xl_X0+1, 1, xl_X, 15);

  xlKillExcel;

  StopVisual;

} //Procedure PrintDoc;


//-----------------------------------
// Печать вариант 01
//-----------------------------------
Procedure PrintDoc01;
  var sXLTFileName:string;
      sDate: string;
{//Печать отчета

  sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + 'GP_SCUD_RPTMisDiscpline01.xlsx';


  if (not ExistFile(sXLTFileName))
  { message('Не найден шаблон отчета "'+sXLTFileName+'"',error);
    exit;
  }

  if (not xlCreateNewExcelWithTemplate(sXLTFileName,true))
  { message('Ошибка создания нового файла в Excel"'+sXLTFileName+'".',error);
    exit;
  }

  if getfirst mtMain = tsOk {}   // ordered by Index ForExcel = tsOk {}
  xlDisplayAlerts(false);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Вывод отчета в Excel ...', LongInt(RecordsInTable(#mtMain)/100));
  xl_X:=1;sDate := 'Функциональный руководитель';  #_ToExcel( 20, sDate )

  xl_Y0 := 0;
  xl_X0 := 1;

  xl_X := xl_X0+1;
  xl_Res := true;

// xlAlignCellsEx(xlCenter,xlCenter,xl_X,2,xl_X,9);



 _Loop mtMain
 {
  //01 Дата
  sDate := DateToStr( mtMain.EventDate, '''DD.MM.YYYY');  #_ToExcel( 1, sDate )
  //02 Подр.
  sDate := KatPodr.Kod;  #_ToExcel( 2, sDate )
  //03 ФИО
  sDate:=GetShortFIOLast(mtMain.Fio);
  #_ToExcel( 3,sDate)
  //04 Должность
  sDate:=GetPostPers(mtMain.cPersons);
  #_ToExcel( 4,sDate)
  //05 Время начала работы
  sDate := TimeToStr(mtMain.TMB,'HH:MM');  #_ToExcel( 5, sDate )
  //06 Обеденный перерыв
  if mtMain.Break1B<>ZeroTime or  mtMain.Break2B<>ZeroTime
  { sDate := TimeToStr(mtMain.Break1B,'HH:MM -')+TimeToStr(mtMain.Break1E,'HH:MM');
    #_ToExcel( 6, sDate )
  }
  //07 Время окончания работы
  sDate := TimeToStr(mtMain.TME,'HH:MM');  #_ToExcel( 7, sDate )
  //08 Опоздание
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t1h);   #_ToExcel( 8, sDate )
  //09 Уход раньше
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t4h);   #_ToExcel( 9, sDate )
  //10 Уход раньше на обед
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t2h);   #_ToExcel(10, sDate )
  //11 Опоздание с обеда
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t3h);   #_ToExcel(11, sDate )
  //12 Другие выходы
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t5h);   #_ToExcel(12, sDate )
  //13 Сумма за день
  sDate := iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble
          (mtMain.t1h+mtMain.t2h+mtMain.t3h+mtMain.t4h+mtMain.t5h);
  #_ToExcel(13, sDate )
  //14 Опоздание (час)
  sDate := string(mtMain.t1h,0,2);   #_ToExcel( 14, sDate )
  //15 Ранний уход (час)
  sDate := string(mtMain.t4h,0,2);   #_ToExcel( 15, sDate )
  //16 Ранний уход на обед (час)
  sDate := string(mtMain.t2h,0,2);   #_ToExcel( 16, sDate )
  //17 Опоздание с обеда (час)
  sDate := string(mtMain.t3h,0,2);   #_ToExcel( 17, sDate )
  //18 Другие выходы (час)
  sDate := string(mtMain.t5h,0,2);   #_ToExcel( 18, sDate )
  //19 Прогул
  sDate := string(mtMain.x6,0,0);   #_ToExcel( 19, sDate )
  //20 ЗГД.
  sDate := MyGetInitial(mtMain.BossFio,true);  #_ToExcel( 20, sDate )
  //21 Контрольная карта
  sDate := mtMain.zAbsent ;   #_ToExcel( 21, sDate )
  kol_nar:=if(mtMain.t1h>0,1,0)
          +if(mtMain.t4h>0,1,0)
          +if(mtMain.t2h>0,1,0)
          +if(mtMain.t3h>0,1,0)
          +if(mtMain.t5h>0,1,0)
          +mtMain.x6;
  sDate := string(kol_nar) ;   #_ToExcel( 22, sDate )


  xl_X++;

  if xl_X mod 100=0
  { if not nextvisual then break;
  }

 }
  xl_X := xl_X-1;
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, xl_X0+1, 1, xl_X, 22);
  xlWrapText(xl_X0+1, 1, xl_X, 22);

  xlKillExcel;

  StopVisual;

} //Procedure PrintDoc01;
