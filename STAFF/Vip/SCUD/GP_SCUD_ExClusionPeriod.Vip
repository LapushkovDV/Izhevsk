//************************************************************
Interface GP_SCUD_ExClusionPeriod 'Исключение периодов из нарушений' (,,sci17EnEsc), EscClose;
//************************************************************
Show At (,,120,30);
//----------------------------------------
// Forward
//----------------------------------------
//------------------------------------
// декларация сложного фильтра
//------------------------------------
function isFilterAnCorrect(ww_nrec:comp): boolean; forward;
//-------------------

//-------------------
var
//-------------------
  cRec    :Comp   ; // ссылка на группу
  pMarker:IMarker(Marker) new;
  Marker:longint;
  ZP_ExClusionPeriod :date;//текущий период в модуле заработная плата
//--- настройки
  NPOEM_OWN_SCUD_DOC_InsINClosePeriod:boolean;//Разрешить ввод документов в закрытом периоде

//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
    wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;

   #mrkfld_(KatPodr)

   DTB,DTE :date;
   pFlt_Katpodr:comp ;
   pFlt_GP_SCUD_Pers :comp;
   wType_Reg,wType_Reg_A    :word;

Create View
var
  pGP_SCUD_Doc_F:comp;
  pGP_SCUD_Doc_SP_F:comp;
as select GP_SCUD_Doc.Nrec
From
   GP_SCUD_Doc
  ,GP_Status,GP_SCUD_Pers
  ,GP_SCUD_Doc_SP
  ,GP_SCUD_Doc_SP GP_SCUD_Doc_SP_Excl
  ,Persons Executor
  ,x$users(readonly)
  ,GP_SCUD_Doc    GP_SCUD_Doc_F
  ,GP_SCUD_Doc_SP GP_SCUD_Doc_SP_F
//-------------------------------------
, KatPodr KatPodr_Flt
, tmp_ExClusPeriod(tmp_ExClusPeriod01)
where
((  GP_iSC_exception_of_Periods  == GP_SCUD_Doc.wType //1011
and GP_SCUD_Doc.cStatus          == GP_Status.Nrec
and GP_SCUD_Doc.cKatPodr         == KatPodr.Nrec
and GP_SCUD_Doc.cExecutor        == Executor.Nrec
and GP_SCUD_Doc.Nrec             == GP_SCUD_Doc_SP.cGP_SCUD_Doc
and GP_SCUD_Doc.cUser            == x$users.Atl_nrec

and 0                            == GP_SCUD_Doc_SP.cGP_SCUD_Doc_SP
//and GP_SCUD_Doc_SP.cGP_SCUD_Pers == GP_SCUD_Pers.Nrec
and wc_nrec                      == KatPodr_Flt.Nrec
and GP_SCUD_Doc_SP.Nrec          == GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc_Sp
and GP_SCUD_Doc_SP.cGP_SCUD_Doc  == GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc
and GP_SCUD_Doc_SP_Excl.cGP_SCUD_PERS == GP_SCUD_PERS.Nrec
//--- для копирования документа
and pGP_SCUD_Doc_F     == GP_SCUD_Doc_F.Nrec
and pGP_SCUD_Doc_SP_F  == GP_SCUD_Doc_SP_F.Nrec

))
Bounds byKatpodr   pFlt_KatPodr    == GP_SCUD_Doc.cKatPodr(noindex) ordered by TableOrder
Bounds byPeriodBeg DTB   <<= GP_SCUD_Doc.DocDate(noindex) ordered by TableOrder
Bounds byPeriodEnd DTE   >>= GP_SCUD_Doc.DocDate(noindex) ordered by TableOrder
Bounds byUserID    pUserId == GP_SCUD_Doc.cUser(noindex)  ordered by TableOrder

condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_DOC.Nrec))

;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;

//******************************************************************************
// Функции
//******************************************************************************
  //-----------------------------------------------------
  // Поиск следующего номера документа
  //-----------------------------------------------------
  function GetNextDocNumber(InYear:word):string;
  var _DTBeg,_DTEnd:_datetime;
      _wTypeDoc:word;
  { _DTBeg:=_DateTime(1,1,InYear,0,0,0,0);
    _DTEnd:=_DateTime(31,12,InYear,23,59,0,0);
    _wTypeDoc:=GetTypeDoc;
    result:='';
    sql
      select max(GP_SCUD_Doc.DOCNMB)
      from GP_SCUD_Doc
    where(:(_DTBeg)<=GP_SCUD_Doc.DInput and :(_DTEnd)>=GP_SCUD_Doc.DInput
      and GP_SCUD_Doc.wType=:(_wTypeDoc))
    into (result);

    if (Trim(result)='')
      result:='000001'
    else
      result:=NextNumStr(result);
  } //function GetNextDocNumber(InYear:word):string;

  //============================================
  // сразу и вернем период, который не исключен из нарушения.
  // если есть исключение, то result=true, если  нет - false
  //============================================
  Function  GetPeriodWithOutExClusion(DT_B:date
           ;TM_B:time;TM_E:time;pGP_SCUD_PERS:comp ) :time;
  var pStat_Default:comp;
  { if TM_E<TM_B
    { Result:=time(0,0,0,0);
      Exit;
    }
    Result:= Sub_Time(TM_E,TM_B);
    pStat_Default:=pStatus_GetDefault;
    _Try
    { delete all tmp_ExClusPeriod;
      sql
      select
            GP_SCUD_Doc_SP.EventDate //     : date "Дата события"
          , GP_SCUD_Doc_SP.EventTmB  //    : time "Время события с"
          , GP_SCUD_Doc_SP.EventTmE  //     : time "Время события по"

      from GP_SCUD_Doc_SP
      Inner join GP_SCUD_Doc on GP_SCUD_Doc.Nrec = GP_SCUD_Doc_SP.cGP_SCUD_Doc
                and GP_SCUD_Doc.wType=1011 //GP_iSC_exception_of_Periods
                and GP_SCUD_Doc.cStatus<>:(pStat_Default)
      Left Outer join GP_SCUD_Doc_SP GP_SCUD_Doc_SP_Excl
        on GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc_SP = GP_SCUD_Doc_SP.Nrec
          and GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc = GP_SCUD_Doc_SP.cGP_SCUD_Doc
          and GP_SCUD_Doc_SP_Excl.cGP_SCUD_PERS = :(pGP_SCUD_PERS)
      where
        (    :(DT_B)=GP_SCUD_Doc_SP.EventDate
         and :(TM_B)<=GP_SCUD_Doc_SP.EventTmE
         and :(TM_E)>=GP_SCUD_Doc_SP.EventTmB
         and GP_SCUD_Doc_SP.cGP_SCUD_Doc_SP=#Comp(0)
        )
        and GP_SCUD_Doc_SP_Excl.Nrec is Null
       into tmp_ExClusPeriod;
       // будем убирать периоды из вычисленого
       var _TM_B, _TM_E, _TM:time;
       _Loop tmp_ExClusPeriod
       { _TM_B:=if(tmp_ExClusPeriod.EventTmB<TM_B,TM_B,tmp_ExClusPeriod.EventTmB);
         _TM_E:=if(tmp_ExClusPeriod.EventTmE>TM_E,TM_E,tmp_ExClusPeriod.EventTmE);
         if _TM_E<=_TM_B continue;
         _TM:=Sub_Time(_TM_E,_TM_B);
         if _TM>Result
         { Result:=ZeroTime;
           break;
         }
         else
         Result:=Sub_Time(Result,_TM);
       } //_Loop tmp_ExClusPeriod
    }
    _Except
    else
    {
    }
    _Finally
    {

    }

  } //Function  GetExClusionPeriod(DT_B:date; DT_E:date ;var TM_B:time;var TM_E:time ) :boolean;

  //------------------------------------
  // сохранить параметры
  //------------------------------------
  Procedure SaveParam;
  { if (boVisibleRun)
    {
      SaveMyDsk(wFilter  ,GetInterfaceName+'_wFilter');
      SaveMyDsk(DTB      ,GetInterfaceName+'_DTB');
      SaveMyDsk(DTE      ,GetInterfaceName+'_DTE');
      SaveMyDsk(wType_Reg,GetInterfaceName+'_wType_Reg');
    }
    //-----------------------
    DoneMarker(Marker_KatPodr_A     , '' );
    //-----------------------
    DoneMarker(Marker_KatPodr     ,if(not boVisibleRun,'', GetInterfaceName+'_KatPodr') );
  } //Procedure SaveParam;

  //------------------------------------
  // восстановить параметры
  //------------------------------------
  Procedure ReadParam;
  { if (boVisibleRun)
    {
      if not ReadMyDsk(wFilter,GetInterfaceName+'_wFilter',false) wFilter:=0;
      if not ReadMyDsk(DTB    ,GetInterfaceName+'_DTB'    ,false) DTB:=ZeroDate;
      if not ReadMyDsk(DTE    ,GetInterfaceName+'_DTE'    ,false) DTE:=ZeroDate;
      if not ReadMyDsk(wType_Reg,GetInterfaceName+'_wType_Reg',false) wType_Reg:=0;
    }
    Marker_KatPodr      :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatPodr'     ) , 8, 50, 10, True);

    Marker_KatPodr_A     :=InitMarker('' , 8, 50, 10, True);

  } //  Procedure ReadParam;

  //------------------------------------
  // декларация сложного фильтра
  //------------------------------------
  function isFilterAnCorrect(ww_nrec:comp): boolean; cacheable;
  { #__UNUSED__(ww_nrec)
    Result:=true;
    if isPodrShare
    {  if not EnablePodr(GP_SCUD_Doc.cKatPodr)
        { Result:=false;
          Exit;
        }
    }
    if IsBitCTW(wFilter,2)
    { if Count_KatPodr>1
      { If not FoundMarker(Marker_KatPodr_A,GP_SCUD_Pers.cKatPodr)
        { Result:=false;
          Exit;
        }
      }
    }

  }//function isFilterAnCorrect(ww_nrec:comp): boolean;

    //-------------------------------------------
  // скопировать фильтры в данные для отборв
  //-------------------------------------------
  Procedure CopyToA;
  { CopyMarker(Marker_KatPodr_A ,Marker_KatPodr);
    wType_Reg_A     :=wType_Reg     ;

  } //Procedure CopyToA;

  //-------------------------------------------
  // восстановить данные для задания фильтрации
  // из данных для отбора
  //-------------------------------------------
  Procedure RestFromA;
  { CopyMarker(Marker_KatPodr ,Marker_KatPodr_A);
    wType_Reg     :=wType_Reg_A     ;
  } //Procedure RestFromA;

  //-------------------------------------------
  #doc
    Установить ограничения
  #end
  Function SetFilterBounds(_IsArch:word) : boolean;
  { #__UNUSED__(_IsArch)
    Result:=false;
    isFilterRun:=True;
    if ConditionActiveInLeave(tcFilterAn, #GP_SCUD_Doc)
    { PopConditionForLeave(tcFilterAn, #GP_SCUD_Doc);
    }
    If BoundActive(tbByKatPodr     ) SubBounds(tbByKatPodr);
    If BoundActive(tbByPeriodBeg   ) SubBounds(tbByPeriodBeg  );
    If BoundActive(tbByPeriodEnd   ) SubBounds(tbByPeriodEnd  );
    //-----------------------
    CopyToA;
    //-----------------------
    ClearFuncCache; // очистим кэш функций
    var need_FilterAn:boolean=false;
    if IsBitCTW(wFilter,1)
    { if DTB<>ZeroDate   AddBounds(tbByPeriodBeg  );
      if DTE<>ZeroDate   AddBounds(tbByPeriodBeg  );
    }
    if IsBitCTW(wFilter,2)
    {  GetMarker(Marker_KatPodr,0,pFlt_KatPodr);

       if Count_KatPodr=1
       { AddBounds(tbByKatPodr);
       }
       else need_FilterAn:=true;
    }

    if isPodrShare need_FilterAn:=true;

    // использование сложного фильтра
    if need_FilterAn
    { PushConditionForLeave(tcFilterAn, #GP_SCUD_Doc);
    }
    ReReadRecord(#GP_SCUD_Doc);
    Result:=true;
    isFilterRun:=False;

  } //Function SetFilterBounds : boolean;


  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_Katpodr
    { #mrkfiltr_(Katpodr_Flt,Katpodr,Nrec,wc_nrec,Katpodr_Flt.Kod+','+Katpodr_Flt.Name)
    }
    ReScanPanel(#KatPodr_Flt);
  } //Procedure SetFilterNM(_Field:longint)




