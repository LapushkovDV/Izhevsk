  Function SetDocFieldsState: boolean;
  { Result:=Inherited::SetDocFieldsState;
    if (StatusChange.CanChangeStatus(GP_SCUD_DOC.cStatus))
    { cfsSetProp('c_BRDOC_GP_STATUS.NAME_Статус','ButtonType',inPickButton); //WINCOMM.INC
      cfsSetProp('i_ScrEdit_GP_STATUS.NAME','ButtonType',inPickButton);
    }

  } //Function SetDocFieldsState: boolean;


//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Doc;
cmSetDefault:
{ ClearBuffer(#GP_SCUD_Doc);
  GP_SCUD_Doc.dInput:=_CurDateTime;
  GP_SCUD_Doc.wType :=wTypeDoc;
  set GP_SCUD_Doc.DocDate:=Cur_Date;
  GP_SCUD_Doc.DocNMB  :=GetNextDocNumber(year(Cur_Date));
  GP_SCUD_Doc.cExecutor:=UserAccessService.UserPersonsNRec;
  set GP_SCUD_Doc.cStatus := pStatus_GetDefault;
  SetEditMode(true);
  PutCommand(cmEdit);
}
cmInsertRecord:
{ Insert Current GP_SCUD_Doc;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Doc;
}
cmDeleteRecord:
{ if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { message('Удаление доступно только в оформляемом статусе')
  }
  else
  { if message('Удалить документ '+GP_SCUD_Doc.DocNmb, YesNo)=cmYes
    {  delete GP_SCUD_Doc_Sp where (( GP_SCUD_Doc.Nrec == GP_SCUD_Doc_Sp.cGP_SCUD_Doc )) ;
       delete Current GP_SCUD_Doc;
    }
  }
}
cmCheckField:
{ case CurField of
  #GP_SCUD_Doc.DocDate:
  { if not NPOEM_OWN_SCUD_DOC_InsINClosePeriod
    { if GP_SCUD_Doc.DocDate<ZP_ExClusionPeriod
      { message('Вам запрещено вводить документы'
         +chr(13)+'в закрытом периоде'
         +chr(13)+'(ранее '+DateToStr(ZP_ExClusionPeriod,'DD.MM.YYYY')+')'
        );
        set GP_SCUD_Doc.DocDate:=ZP_ExClusionPeriod;
      } //if GP_SCUD_Doc.DocDate<ZP_ExClusionPeriod
    } //if not NPOEM_OWN_SCUD_DOC_InsINClosePeriod
    PushPos(#GP_SCUD_Doc_Sp);
    _Loop fullCache GP_SCUD_Doc_Sp
      update current GP_SCUD_Doc_Sp set GP_SCUD_Doc_Sp.EventDate:=GP_SCUD_Doc.DocDate;
    PopPos(#GP_SCUD_Doc_Sp);
    ReScanPanel(#GP_SCUD_Doc_Sp);
  }
  end;
}
cmPositionChanged:
{ PositionChanged;
}
end; //GP_SCUD_Doc

//------------------------------
TableEvent table GP_SCUD_Doc_SP;
//------------------------------
cmSetDefault:
{ ClearBuffer(#GP_SCUD_Doc_SP);
  GP_SCUD_Doc_SP.cGP_SCUD_Doc:=GP_SCUD_Doc.nrec;
  GP_SCUD_Doc_SP.Nrec:=GetNextNrec(#GP_SCUD_Doc_SP,0);
  GP_SCUD_Doc_SP.wType:=GP_SCUD_Doc.wType;
  GP_SCUD_Doc_Sp.EventDate:=GP_SCUD_Doc.DocDate;

}
cmInsertRecord:
{ Insert Current GP_SCUD_Doc_SP;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Doc_SP;
}
cmDeleteRecord:
{ if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { message('Удаление доступно только в оформляемом статусе')
  }
  else
  { if message('Удалить строку из документа '+GP_SCUD_Doc.DocNmb, YesNo)=cmYes
    { delete GP_SCUD_Doc_Sp_Excl where ((
          GP_SCUD_Doc_SP.Nrec  == GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc
      and GP_SCUD_Doc_SP.cGP_SCUD_Doc   == GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc
      ));
      delete Current GP_SCUD_Doc_Sp ;
    }
  }
}
cmPositionChanged:
{ PositionChanged_SP;
}
end; //GP_SCUD_Doc_SP

//GP_SCUD_Doc_SP_Excl.
//------------------------------
TableEvent table GP_SCUD_Doc_SP_Excl ;
//------------------------------
cmSetDefault:
{ ClearBuffer(#GP_SCUD_Doc_SP_Excl);
  GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc:=GP_SCUD_Doc.nrec;
  GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc_Sp:=GP_SCUD_Doc_SP.Nrec

}
cmInsertRecord:
{ Insert Current GP_SCUD_Doc_SP_Excl;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Doc_SP_Excl;
}
cmDeleteRecord:
{ if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { message('Удаление доступно только в оформляемом статусе')
  }
  else
  { if message('Удалить исключение из документа '+GP_SCUD_Doc.DocNmb, YesNo)=cmYes
    {  delete Current GP_SCUD_Doc_Sp_Excl ;
    }
  }
}
cmPositionChanged:
{ //PositionChanged_SP;
}
end; //GP_SCUD_Doc_SP_Rxcl

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);

      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if cRec=0
      { if Marker<>0
        { GetMarker(Marker,0,cRec)
        }
      }
      //--------------------------
      SetFilterNm(0);
      SetFilterBounds(0);
      //--------------------------
      if UserAccessService.OnlyUserDoc(GetTypeDoc)
      { AddBounds(tbByUserID);
      }
      if cRec>0
      { if getfirst GP_SCUD_Doc where (( cRec == GP_SCUD_Doc.nrec ))=tsok {}
      }
      //-------------------------

      ReScanPanel(#GP_SCUD_Doc);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Doc.Nrec;
        }
        CloseInterface(cmDefault)
      }
      else
      { PutCommand(cmEdit);

      }
    }
    //-----------------------------
    cmEdit:
    { case GetCurrentFormat of
      brDoc: RunWindowModal(wnEdit);
      end;
    }
    //-----------------------------
    cmPick:
    { case curField of
      //-----------------------------
      #GP_Status.Name:
      { if (StatusChange.PickStatus(GP_SCUD_DOC.cStatus))
         {
            pTmp:=ChangeStatus(GP_SCUD_DOC.NRec,StatusChange.StatusChangeLog);
            if PTmp<>0
            { set GP_SCUD_DOC.cStatus:=StatusChange.StatusChangeLog.cStatusTo;
              update current GP_SCUD_DOC;
              SetDocFieldsState;
          }
        }
      }
      //-----------------------------
      #GP_SCUD_Pers.Fio:
      { Marker_Tmp :=InitMarker(''  , 8, 200, 10);

        pTmp:=GP_SCUD_DOC_SP_Excl.cGP_SCUD_Pers;
        if RunInterFace(GP_SCUD_PersVib,cgiPickMult,pTmp,Marker_Tmp,GP_SCUD_DOC.cKatPodr,0)<>cmCancel
        { //set GP_SCUD_DOC_SP_Excl.cGP_SCUD_Pers:=pTmp;
          //PositionChanged_SP;
          var ii:longint;
          var _nrec:comp;
          for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
          { if not GetMarker(Marker_Tmp,ii,_nrec) continue;
            if ii=0
            { set GP_SCUD_DOC_SP_Excl.cGP_SCUD_PERS:=_nrec;
              SetModified(true);
              //update current GP_SCUD_DOC_SP;
              UpdateTable;// ломает базу;
            }
            else
            { ClearBuffer(#GP_SCUD_DOC_SP_Excl);
              GP_SCUD_DOC_SP_Excl.cGP_SCUD_Doc   :=GP_SCUD_Doc.Nrec;
              GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc_Sp:=GP_SCUD_Doc_SP.Nrec;
              GP_SCUD_DOC_SP_Excl.cGP_SCUD_PERS  :=_nrec;
              insert current GP_SCUD_DOC_SP_Excl;
            }
          }//for(ii:=0;ii<GetMarkerCount(Marker_Tmp),ii++)
          ReScanPanel(#GP_SCUD_DOC_SP_Excl);
        } //if RunInterFace(GP_SCUD_PersVib,cgiPickMult,pTmp,Marker_T
        DoneMarker(Marker_Tmp,'');
      } //#GP_SCUD_Pers.Fio:
      //-----------------------------
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,2);
        }
      }
      end;
      ReScanPanel(#GP_SCUD_PERS);
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,1);
        SetFilterNm(#Filtr_KatPodr);
      }
      end;
    }

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Doc: RunInterface('ExClassifier', coGP_SCUD_Doc, GP_SCUD_Doc.nRec);
      end;
    }
    //-------------------------- фильтр
    cmFilterSave:
    { UpdateTable;
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(0);
      }
      else RestFromA
    }
    //-------------------------- Дублирование документа
    cmValue1:
    { if not UserAccessService.CanIns(wTypeDoc)
      { Message('У вас нет прав на создание документа!');
        Exit;
      }
      if Message('Сделать дубликат документа '+GP_SCUD_Doc.DocNMB+'?',YesNo)<>cmYes
      { Exit;
      }
      StartNewVisual(vtNumericVisual,vfTimer ,'Дублирование документа',0);
      do {
        pGP_SCUD_Doc_F:=GP_SCUD_Doc.Nrec;
        if Getfirst GP_SCUD_Doc_F<>tsok
        { Message('Ошибка при копировании документа 001');
          break;
        }
        //---- создаем копию шапки
        var _pGP_SCUD_Doc_F:comp=GetNextNrec(#GP_SCUD_Doc_F,0);
        GP_SCUD_Doc_F.Nrec   :=_pGP_SCUD_Doc_F;
        GP_SCUD_Doc_F.DocDate:=Cur_Date;
        GP_SCUD_Doc_F.dInput:=_CurDateTime;
        GP_SCUD_Doc_F.wType :=wTypeDoc;
        GP_SCUD_Doc_F.DocNMB  :=GetNextDocNumber(year(Cur_Date));
        GP_SCUD_Doc_F.cExecutor:=UserAccessService.UserPersonsNRec;
        GP_SCUD_Doc_F.cStatus := pStatus_GetDefault;
        if Insert Current GP_SCUD_Doc_F<>tsok
        { Message('Ошибка при копировании документа 002');
          break;
        }
        set pGP_SCUD_Doc_F:=_pGP_SCUD_Doc_F;
        ExtAttrClass_CopyAll(coGP_SCUD_Doc,GP_SCUD_Doc.Nrec,pGP_SCUD_Doc_F);

        //---- копируем спецификацию
        var isAllOk:boolean=true;
        var _pGP_SCUD_Doc_SP_F:comp=0;
        _Loop fullcache GP_SCUD_DOC_SP
        { if not NextVisual then break;
          pGP_SCUD_Doc_SP_F:=GP_SCUD_DOC_SP.Nrec;
          if GetFirst GP_SCUD_Doc_SP_F<>tsok break;

          _pGP_SCUD_Doc_SP_F           :=GetNextNrec(#GP_SCUD_Doc_SP_F,0);
          GP_SCUD_Doc_Sp_F.EventDate   :=GP_SCUD_Doc_F.DocDate;
          GP_SCUD_Doc_Sp_F.Nrec        :=_pGP_SCUD_Doc_SP_F;
          GP_SCUD_Doc_SP_F.cGP_SCUD_Doc:=pGP_SCUD_Doc_F;
          if Insert Current GP_SCUD_Doc_SP_F<>tsok
          { Message('Ошибка при копировании документа 002');
            break;

          }
          set pGP_SCUD_Doc_SP_F:=_pGP_SCUD_Doc_SP_F;
          _Loop fullcache GP_SCUD_DOC_SP_Excl
          { if not NextVisual then
            { isAllOk:=false;
              break;
            }
            GP_SCUD_DOC_SP_Excl.Nrec:=0;
            GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc   :=_pGP_SCUD_Doc_F;
            GP_SCUD_Doc_SP_Excl.cGP_SCUD_Doc_Sp:=_pGP_SCUD_Doc_SP_F;
            if Insert Current GP_SCUD_Doc_SP_Excl=tsok {}

          } //_Loop fullcache GP_SCUD_DOC_SP_Excl
          if not IsAllOk break;
        } //_Loop fullcache GP_SCUD_DOC_SP
      } while False;
      StopVisual('',0);
      if getfirst GP_SCUD_DOC where (( pGP_SCUD_Doc_F == GP_SCUD_Doc.Nrec ))=tsok {}
      PositionChanged;
      ReScanPanel(#GP_SCUD_DOC);
      ReScanPanel(#GP_SCUD_DOC_SP);
      ReScanPanel(#GP_SCUD_DOC_SP_Excl);
      PutCommand(cmEdit);
    } //cmValue1
    //-------------------------- внешние аттрибуты
    cmPickAttr:
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Doc: RunInterface('Attribute', coGP_SCUD_Doc, GP_SCUD_Doc.nRec);
      end;
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #GP_SCUD_Doc:
      { ProcessCommand(RunMenu('GP_SCUD_DocEdit_Excl_Main_HotKey'));
      }
      end;
    }
  end;

end.

GP_SCUD_DocEdit_Excl_Main_HotKey Menu
{
- 'Фильтр на данные'       , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Дублирование документа' , cmValue1 , 'Фильтр на данные', hcProc_NagrKaf, '',, scMenuCtx;
//- 'Внешняя классификация', cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
//- 'Внешние атрибуты'     , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}
