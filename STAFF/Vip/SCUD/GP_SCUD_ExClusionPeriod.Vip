  } //--------------------------------------

  //-------------------------------------
  #doc
   Установить позицию
  #end
  Function SetDocPosition(_wTypeDoc:word;_cDoc:comp;_cDocSp:comp):boolean;
  { #__UNUSED__(_wTypeDoc,_cDoc,_cDocSp)
    Result:=false;
    if _wTypeDoc=0 _wTypeDoc:=GetTypeDoc;
    if getfirst GP_SCUD_Doc where (( _cDoc == GP_SCUD_Doc.Nrec )) <>tsok then exit;
    if _cDocSp>0
    { if getfirst GP_SCUD_Doc_SP where (( _cDocSP == GP_SCUD_Doc_SP.Nrec )) <>tsok then exit;
    }
    Result:=true;
  } //Function SetDocPosition(_wTypeDoc:word;_cDoc:comp;_cDocSp:comp):boolean;

  //-------------------------------------
  #doc
   Найти подписанта, выполнять с 1,2 и т.д до тех пор пока не вернет 0
  #end
  Function GetPodpisPers(_num:word):comp;
  { Result:=0;
    Case _num of
    1: Result:=GP_SCUD_DOC.cExecutor;
    end;
  }


