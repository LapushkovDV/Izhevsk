Procedure PositionChanged;
{
  var _wnrec:comp;
  _wnrec:=0;
  _wnrec:=mtGroup.cGP_SCUD_Pers;
  var _DT:date=ZeroDate;
  var _TmB,_TmE,_PlanTime:time=ZeroTime;
  var _wType:word=0;
  var _cNrec:comp=0;
  _TmE := Time(24,0,0,0);

   iGP_SCUD_StateMentOnAbsent.GetFirstPeriodWithOutMisConDuct(_wnrec,mtGroup.dFirst,mtGroup.dLast
          ,_DT,_TMB,_TME,_PlanTime,_wType,_cNrec,true);

// LogStrTofile('StateMentOnAbsent.log', 'GetFirstPeriodWithOutMisConDuct _wnrec=' + _wnrec +'  dFirst='+mtGroup.dFirst+'  mtGroup.dLast='+mtGroup.dLast+'  >> '+
//          '  _DT='+_DT+' _TMB=' +_TMB +' _TME=' + _TME + ' _wType='+_wType );

//   iGP_SCUD_EventsEdit.InitParam(cgiNotEdit,0,mtGroup.cGP_SCUD_Pers,0,0,mtGroup.dFirst,mtGroup.dFirst);
} //Procedure PositionChanged

