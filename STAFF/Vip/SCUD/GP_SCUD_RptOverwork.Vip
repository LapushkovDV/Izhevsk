//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { timelog_init;
      //---------------------------
      excel_Null_Need:=true;
      //---------------------------
      NPOEM_OWN_HEAD_V_VID:=wGetTune('NPOEM_OWN.HEAD_V_VID');//В интерфейсе руководителя отображать
      NPOEM_OWN_SCUD_Pers_Other :=boGetTune('NPOEM_OWN.SCUD.Pers_Other');//'Отображать сторонних лиц
      LoadParam;
      CopyToA;
      if RunWindowModal(wnFilter)<>cmDefault
      { CloseInterface(cmDone);
        exit;
      }
      SborData;
      SetFilterNM(0);
      if getfirst mtGroup = tsOk {}
//      If BoundActive(tbByPersons) or BoundActive(tbByKatPodr)
      CalcAll; // Пересчитать ВСЁ
//      else
      ReScanPanel(#mtGroup);
    }
    //-----------------------------
    cmDone:
    { SaveParam;
    }
    //-----------------------------
    cmDefault:
    {
    }
    //----------------------
    cmPick:
    { case curField of
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,2);
        }
      }
      //------------------------------
      #Filtr_Persons:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Persons);


        StoreMarker(Marker_Persons,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Persons,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_Persons,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_Persons);
          BitOnW(wFilter,3);
        }
      }
      end; //case curField of
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatPodr);
      }
      //------------------------------
      #Filtr_Persons:
      { ClearMarker(Marker_Persons);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_Persons);
      }
      end;
    }
    //--------------------------
    cmPickClass:// внешние классификаторы
    {
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      CopyToA;
      if RunWindowModal(wnFilter)=cmDefault
      {
//        if (DTB <> DTB_L) or (DTE <> DTE_L)
        SborData;
        CalcAll;

      }
      else RestFromA
    }
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #mtGroup:
      { ProcessCommand(RunMenu('GP_SCUD_RptOverwork_Main_HotKey'));
      }
      end;
    }
    cmPrintDoc:
    { if RunWindowModal(wnParamPrint)=cmDefault
      { case wTypeRep of
        0:PrintDoc;
        1:PrintDoc01;
        2:PrintDoc02;
        end;
      }
    }
    cmValue1: // Пересчитать по сотруднику
    {
      var chet:longint;
      var CurPers: comp;

       CurPers := mtMain.cGP_SCUD_Pers;
       chet := 0;
       delete all mtMain_Add;
       PushPos(#mtGroup);
       _Loop mtGroup where (( CurPers ==  mtGroup.cGP_SCUD_Pers ))
         if CurPers = mtMain.cGP_SCUD_Pers chet++;
       delete mtMain where (( 1 == mtMain.PA and CurPers == mtMain.cGP_SCUD_Pers )) ;

       StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfconfirm,''#3'Рачет',chet);
       cPerCalc :=0; // пересчитать принудительно

             _Loop mtGroup where (( CurPers ==  mtGroup.cGP_SCUD_Pers )) ordered by index ForCalc2
             {
                if CurPers = mtMain.cGP_SCUD_Pers
                CalcByPers(1,mtGroup.cGP_SCUD_Pers, mtGroup.dFirst);

                if not nextvisual then break;
             }

       PopPos(#mtGroup);

       RescanPanel(#mtGroup);
       RescanPanel(#mtMain);
       StopVisual('',0);

    }

    cmValue2: // Пересчитать ВСЁ
    {
      CalcAll;
    }

cmCheckField:
{
 case curField of
  #DTB: if DTB> DTE set DTE := DTB;
  #DTE: if DTB> DTE set DTB := DTE;
 end;
}
cmValue3: // ТЕСТ
{

}

  end;
// cmPRGVersion : message('Трасляция на #__TOOLVERSION__ от #__DATETIME__');

end.

GP_SCUD_RptOverwork_Main_HotKey Menu
{
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
// -----------;
- '~П~ечать',cmPrintDoc,'Вывод в Excel отчета Дисциплина труда',hcNoContext,'Ctrl+P',kbCtrlP,sci1Esc,,,, bmpPrint;
- 'Пересчитать по сотруднику', cmValue1   , 'Обновить', hcProc_NagrKaf, ,, scMenuCtx;
- 'Пересчитать ВСЁ', cmValue2   , 'Обновить', hcProc_NagrKaf, ,, scMenuCtx;
// -----------;
//- 'ТЕСТ ТЕСТ ТЕСТ ', cmValue3   , 'UpDate mtGroup_free set ТЕСТ ТЕСТ ТЕСТ ', hcProc_NagrKaf, ,, scMenuCtx;
}
