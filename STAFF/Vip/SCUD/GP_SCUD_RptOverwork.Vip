//------------------------------------
Table Struct mtGroup (
    nRec: comp, // nRec первого события в течении дня 
    cGP_SCUD_Pers: comp,
    FIO          : string[50],
    cPersons     : comp,
    cKatPodr     : comp,
    dFirst   : date,
    dLast    : date,
    wYear   : word,
    wMonth  : word,
    tOverWork   : time "Сверхурочные",
    tOverWork2  : time "Переработка",
    tHoliday    : time "Выходные",
    tStateMents : time "Выходные",
    tStateMentsR: time "Поручение руководителя",
    tGrafCh     : time "Рабочих часов (час)",
    tFact      : time "Рабочих часов (час)",
    OverWork   : double "Сверхурочные (час)",
    OverWork2  : double "Переработка (час)",
    Holiday    : double "Выходные (час)",
    StateMents : double "Заявлений (час)",
    StateMentsR: double "Поручение руководителя (час)",
    GrafCh     : double "Рабочих часов по графику (час)",
    Fact       : double "Рабочих часов факт(час)",
    ItogOver   : double "Чистая Переработка (час)",
    tItogOver  : time "Чистая Переработка",
    tItogOverM : time "Использовано сверх переработанного(ч:м)",
    SortFld: string
) with index (
    nRec = nRec (AutoInc, Unique), // nRec, // dFirst = + SortFld
    ForOut = SortFld + cGP_SCUD_Pers + wYear+ wMonth,
    ForCalc= cGP_SCUD_Pers + dFirst,
    ForCalc2 = CGP_SCUD_PERS+WYEAR+WMONTH,
    ForBounds1 = cKatPodr + SortFld + wYear+ wMonth,
    ForBounds2 = cPersons + wYear+ wMonth,
    ForBounds3 = cKatPodr + cPersons+ wYear+ wMonth
);

Table Struct mtGroupAll = mtGroup;

Table Struct mtMain (
    cGP_SCUD_Pers: comp,
    FIO          : string[50],
    EventDate    : date,
    wYear   : word,
    wMonth  : word,
    Rejim      : string "режим работы",
    t1: time "Первый вход",
    t2: time "последний выход",
    tOverWork   : time "Сверхурочные",
    tOverWork2  : time "Переработка",
    tHoliday    : time "Выходные",
    tStateMents : time "Заявлений",
    tStateMentsR: time "Поручение руководителя",
    tMisConDuct : time "Нарушений (час)",
    tGrafCh     : time "Рабочих часов (час)",
    OverWork   : double "Сверхурочные (час)",
    OverWork2  : double "Переработка (час)",
    Holiday    : double "Выходные (час)",
    MisConDuct : double "Нарушений (час)",
    StateMents : double "Заявлений(час)",
    StateMentsR: double "Поручение руководителя (час)",
    GrafCh     : double "Рабочих часов (час)",
    PA :word //1 - Дополнительная запись
) with index (
    mtMain01= cGP_SCUD_Pers + wYear+ wMonth + EventDate //ForCalc
  , mtMain02 = PA +cGP_SCUD_Pers
);

Table struct mtMain_Add =mtMain;

Create View vM
Var
   DTB,  DTE  :date;
   DTB_A,DTE_A:date;
   DTB_L,DTE_L:date;  // период за который загружены данные

as select mtGroup.Nrec
From
  mtGroup (ForOut)
 ,mtGroupAll(ForOut)
 ,mtMain
 ,mtMain mtMain_tmp
 ,mtMain_Add
 ,mtGroup mtGroup_tmp
 ,mtGroup mtGroup_free
 ,mtMain mtMain_free
 ,GP_SCUD_Pers
 ,GP_SCUD_Podr

//-------------------------------------
, KatPodr KatPodr_Flt
, Persons
, Persons Persons_Flt
, ZAR_USER
where
((  

    mtGroup.cGP_SCUD_Pers == GP_SCUD_Pers.nRec
and         GP_SCUD_Pers.cKatPodr == KatPodr.nRec
and         GP_SCUD_Pers.cKatPodr == GP_SCUD_Podr.cKatPodr

and       mtGroup.cPersons == Persons.nrec
and       mtGroup.cPersons == Appointments.Person
and       0 == Appointments.LPrizn
and       DTE >>=Appointments.AppointDate
and       ( DTB <= Appointments.DismissDate or  Appointments.DismissDate=ZeroDate)
and   Appointments.Post == Catalogs.NRec

and mtGroup.cGP_SCUD_Pers == mtMain.cGP_SCUD_Pers
and mtGroup.wYear  == mtMain.wYear
and mtGroup.wMonth == mtMain.wMonth
      /*  and   DTB <<= mtMain.EventDate
        and   DTE >>= mtMain.EventDate       */

and
   mtGroup.cGP_SCUD_Pers == mtGroup_tmp.cGP_SCUD_Pers
and     Year(DateCalcB)  == mtGroup_tmp.wYear
and    Month(DateCalcB)  == mtGroup_tmp.wMonth
and
   mtGroup.cGP_SCUD_Pers == mtMain_tmp.cGP_SCUD_Pers
and     Year(DateCalcB)  == mtMain_tmp.wYear
and    Month(DateCalcB)  == mtMain_tmp.wMonth
//        and   DateCalcB <<= mtMain_tmp.EventDate
//        and   DateCalcE >>= mtMain_tmp.EventDate

and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == Persons_Flt.Nrec

and  sUserName == ZAR_USER.OwnName

and root == mtGroup_free.nrec
and root == mtMain_free.cGP_SCUD_Pers


))
Bounds byPersons pFlt_Persons == mtGroup.cPersons (noindex) ordered by TableOrder
/*
Bounds byKatpodr pFlt_KatPodr == mtGroup.cKatPodr ordered by mtGroup.cKatPodr, mtGroup.SortFld, mtGroup.wYear, mtGroup.wMonth
Bounds byPeriodBeg DTB  <<= mtGroup.dFirst(noindex) ordered by TableOrder
Bounds byPeriodEnd DTE  >>= mtGroup.dFirst(noindex) ordered by TableOrder
*/
Order bySortFld by mtGroup.SortFld
/*
condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(mtGroup.Nrec))
*/
;

