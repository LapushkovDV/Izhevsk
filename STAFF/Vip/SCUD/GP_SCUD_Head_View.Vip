//******************************************************************************
// Функции
//******************************************************************************
  //------------------------------------
  // Задать даты просмотра
  //------------------------------------
  Procedure InitPeriod;
  { wMaxDay:=Last_Day(Date(1,wMonthRas,wYearRas));
    DTB_Period:=date(1,wMonthRas,wYearRas);;
    if wDays=0
    { DTB:=date(1,wMonthRas,wYearRas);
      DTE:=date(Last_Day(DTB),wMonthRas,wYearRas);
    }
    else
    { if wDays>wMaxDay
      { set wDays:=wMaxDay;
      }
      DTB:=date(wDays,wMonthRas,wYearRas);
      DTE:=date(wDays,wMonthRas,wYearRas);

    }
  } //Procedure InitPeriod;

  //------------------------------------
  // сохранить параметры
  //------------------------------------
  Procedure SaveParam;
  { if (boVisibleRun)
    {
      SaveMyDsk(wFilter        ,GetInterfaceName+'_wFilter'        );
      SaveMyDsk(DTB            ,GetInterfaceName+'_DTB'            );
      SaveMyDsk(DTE            ,GetInterfaceName+'_DTE'            );
      SaveMyDsk(wType_Flt      ,GetInterfaceName+'_wType_Flt'      );
      SaveMyDsk(wWork_Flt      ,GetInterfaceName+'_wWork_Flt'      );
      SaveMyDsk(wOver_Flt      ,GetInterfaceName+'_wOver_Flt'      );
      SaveMyDsk(wOver2_Flt     ,GetInterfaceName+'_wOver2_Flt'     );
      SaveMyDsk(wHoliday_Flt   ,GetInterfaceName+'_wHoliday_Flt'   );
      SaveMyDsk(wMisConduct_Flt,GetInterfaceName+'_wMisConduct_Flt');
      //---- приказ
      SaveMyDsk(wOrder_Type,GetInterfaceName+'_wOrder_Type');
      SaveMyDsk(wOrder_Form,GetInterfaceName+'_wOrder_Form');
      SaveMyDsk(wOrder_DayB,GetInterfaceName+'_wOrder_DayB');
      SaveMyDsk(wOrder_DayE,GetInterfaceName+'_wOrder_DayE');

      SaveMyDsk(sPassPorts_Flt,GetInterfaceName+'_sPassPorts_Flt');
      SaveMyDsk(sFio_Flt      ,GetInterfaceName+'_sFio_Flt');
      SaveMyDsk(sPropusk_Flt  ,GetInterfaceName+'_sPropusk_Flt');

    } //if (boVisibleRun)
    //-----------------------
    DoneMarker(Marker_Persons_A, '' );
    DoneMarker(Marker_KatPodr_A, '' );
    DoneMarker(Marker_KatOrg_A , '' );
    //-----------------------
    DoneMarker(Marker_Persons,if(not boVisibleRun,'', GetInterfaceName+'_Persons') );
    DoneMarker(Marker_KatOrg ,if(not boVisibleRun,'', GetInterfaceName+'_KatOrg' ) );
    DoneMarker(Marker_KatPodr,if(not boVisibleRun,'', GetInterfaceName+'_KatPodr') );
  } //Procedure SaveParam;

    //-------------------------------------
  #doc
   Защитить данные
  #end
  Procedure SetEditMode(Value: boolean);
  { Inherited::SetEditMode(Value);
    if not Value // открыть поля с фильтром в шапке
    {  cfsSetProp('i_SCRSCUDPERS_wYearRas'    ,'Protect',False);
       cfsSetProp('i_SCRSCUDPERS_wDays'       ,'Protect',False);
       cfsSetProp('i_SCRSCUDPERS_sPropusk_Flt','Protect',False);
       cfsSetProp('i_SCRSCUDPERS_sFio_Flt'    ,'Protect',False);
       //------------ List ----
       cfsSetProp('i_SCRSCUDPERS_wMonthRas', cfpStatusCtx,sci13Esc);
       //cfsSetProp('i_SCRSCUDPERS_wMonthRas', cfpDefaultPickButton,false);
       //SetFieldOption (#wMonthRas,ofSelectable);
       cfsSetProp('i_SCRSCUDPERS_wMonthRas', cfpHistoryID, true);


       cfsSetProp('i_SCRSCUDPERS_wWork_Flt', cfpStatusCtx,sci13Esc);
       SetFieldOption (#wWork_Flt,ofSelectable);
       cfsSetProp('i_SCRSCUDPERS_wWork_Flt', cfpHistoryID, true);
       //cfsSetProp('i_SCRSCUDPERS_wWork_Flt', cfpButtonType,inWithHistory);


       cfsSetProp('i_SCRSCUDPERS_wType_Flt', cfpStatusCtx,sci13Esc);
       SetFieldOption (#wType_Flt,ofSelectable);
       cfsSetProp('i_SCRSCUDPERS_wType_Flt', cfpHistoryID, true);
       //cfsSetProp('i_SCRSCUDPERS_wType_Flt', cfpButtonType,inWithHistory);


       // с выбором
       cfsSetProp('i_SCRSCUDPERS_filtr_KatPodr',cfpButtonType,inPickButton);
       cfsSetProp('i_SCRSCUDPERS_filtr_KatPodr',cfpStatusCtx,sci13Esc);

       cfsSetProp('i_SCRSCUDPERS_filtr_Persons',cfpButtonType,inPickButton);
       cfsSetProp('i_SCRSCUDPERS_filtr_Persons','StatusStx',sci13Esc);

       cfsSetProp('i_SCRSCUDPERS_filtr_KatOrg' ,cfpButtonType,inPickButton);
       cfsSetProp('i_SCRSCUDPERS_filtr_KatOrg',cfpStatusCtx,sci13Esc);
       ReScanPanel(#Katpodr_Flt);
    }
  } //Procedure SetEditMode(Value: boolean);

  //------------------------------------
  // восстановить параметры
  //------------------------------------
  Procedure ReadParam;
  { if (boVisibleRun)
    {
      if not ReadMyDsk(wFilter        ,GetInterfaceName+'_wFilter'        ,false) wFilter        :=0;
      if not ReadMyDsk(DTB            ,GetInterfaceName+'_DTB'            ,false) DTB            :=ZeroDate;
      if not ReadMyDsk(DTE            ,GetInterfaceName+'_DTE'            ,false) DTE            :=ZeroDate;
      if not ReadMyDsk(wType_Flt      ,GetInterfaceName+'_wType_Flt'      ,false) wType_Flt      :=10;
      if not ReadMyDsk(wWork_Flt      ,GetInterfaceName+'_wWork_Flt'      ,false)
      { wWork_Flt      :=1;
      }
      if not ReadMyDsk(wOver_Flt      ,GetInterfaceName+'_wOver_Flt'      ,false) wOver_Flt      :=0;
      if not ReadMyDsk(wOver2_Flt     ,GetInterfaceName+'_wOver2_Flt'     ,false) wOver2_Flt     :=0;
      if not ReadMyDsk(wHoliday_Flt   ,GetInterfaceName+'_wHoliday_Flt'   ,false) wHoliday_Flt   :=0;
      if not ReadMyDsk(wMisConduct_Flt,GetInterfaceName+'_wMisConduct_Flt',false) wMisConduct_Flt:=0;
      //---- строчные фильтры
      if not ReadMyDsk(sPassPorts_Flt,GetInterfaceName+'_sPassPorts_Flt'  ,false) sPassPorts_Flt:='';
      if not ReadMyDsk(sFio_Flt      ,GetInterfaceName+'_sFio_Flt'        ,false) sFio_Flt      :='';
      if not ReadMyDsk(sPropusk_Flt  ,GetInterfaceName+'_sPropusk_Flt'    ,false) sPropusk_Flt  :='';

      //---- приказ
      if not ReadMyDsk(wOrder_Type,GetInterfaceName+'_wOrder_Type',false) wOrder_Type:=0;
      if not ReadMyDsk(wOrder_Form,GetInterfaceName+'_wOrder_Form',false) wOrder_Form:=0;
      if not ReadMyDsk(wOrder_DayB,GetInterfaceName+'_wOrder_DayB',false) wOrder_DayB:=1;
      if not ReadMyDsk(wOrder_DayE,GetInterfaceName+'_wOrder_DayE',false) wOrder_DayE:=31;

    }
    if wWork_Flt=1
    { BitOnW(wFilter,7);
    }
    wYearRas :=YearRas;
    wMonthRas:=MonthRas;
    InitPeriod;
    Marker_Persons  :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_Persons') , 8, 50, 10, True);
    Marker_KatOrg   :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatOrg' ) , 8, 50, 10, True);
    Marker_KatPodr  :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatPodr') , 8, 50, 10, True);

    Marker_Persons_A  :=InitMarker('' , 8, 50, 10, True);
    Marker_KatOrg_A   :=InitMarker('' , 8, 50, 10, True);
    Marker_KatPodr_A  :=InitMarker('' , 8, 50, 10, True);

  } //  Procedure ReadParam;


  //------------------------------------
  // декларация сложного фильтра
  //------------------------------------
  function isFilterAnCorrect(ww_nrec:comp): boolean; cacheable;
  { Result:=true;
    #__UNUSED__(ww_nrec)
#IFDEF  _GP_SCUD_Head_FLT_DEBUG
    timelog(' isFilterAnCorrect '+GP_SCUD_PERS.FIO);
#ENDIF
    if isPodrShare
    { if GP_SCUD_Pers.wType=0
       if not EnablePodr(GP_SCUD_Pers.cKatPodr)
        { Result:=false;
          Exit;
        }
    }
    if IsBitCTW(wFilter,1)
    { if Count_KatPodr>1
      { If not FoundMarker(Marker_KatPodr_A,GP_SCUD_Pers.cKatPodr)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,2)
    { if Count_KatOrg>1
      { If not FoundMarker(Marker_KatOrg_A,GP_SCUD_Pers.cKatOrg)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,3)
    { if Count_Persons>1
      { //If not FoundMarker(Marker_Persons_A,GP_SCUD_Pers.cPersons)
        If not FoundMarker(Marker_Persons_A,GP_SCUD_Pers.Nrec)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,4)
    if length(sFio_Flt)<>0
    { if Pos(UpCase(sFio_Flt),UpCase(GP_SCUD_Pers.Fio) )=0
      { Result:=false;
        Exit;
      }
    }
    if IsBitCTW(wFilter,5)
    if length(sPropusk_Flt)<>0
    { if Pos(UpCase(sPropusk_Flt),UpCase(GP_SCUD_Pers.Propusk_NMB) )=0
      { Result:=false;
        Exit;
      }
    }
    if IsBitCTW(wFilter,7)
    { if wWork_flt_A=1
      if GP_Scud_Pers.WType=0
      { if Persons.Disdate<>ZeroDate
          if Persons.Disdate<DTB_Period
          { Result:=false;
            Exit;
          }
      }
    }
    //------------------------
    // Фильтры по GP_SCID_SALDO
    //------------------------
    if IsBitCTW(wFilter,8) or IsBitCTW(wFilter,9)
    or IsBitCTW(wFilter,10) or IsBitCTW(wFilter,11)
    { //CalcAll(0,ww_nrec);
      if getfirst GP_Scud_Saldo<>tsok
      { Exit
      }

    }
    if IsBitCTW(wFilter,8)
    { if wOver_flt=0
      { if GP_Scud_Saldo.CH_Over_Cur=0// сверхурочные
        { Result:=false; Exit;}
      }
      else
      { if GP_Scud_Saldo.CH_Over_Cur<>0// сверхурочные
        { Result:=false; Exit;}
      }
    }
    if IsBitCTW(wFilter,9) //переработка
    { if wOver2_flt=0
      { if GP_Scud_Saldo.CH_Over2_Cur=0
        { Result:=false; Exit;}
      }
      else
      { if GP_Scud_Saldo.CH_Over2_Cur<>0
        { Result:=false; Exit;}
      }
    }
    if IsBitCTW(wFilter,10) //выходные
    { if wHoliday_flt=0
      { if GP_Scud_Saldo.ch_Holiday_Cur=0
        { Result:=false; Exit;}
      }
      else
      { if GP_Scud_Saldo.ch_Holiday_Cur<>0
        { Result:=false; Exit;}
      }
    }
    if IsBitCTW(wFilter,11) //нарушения
    { var _str:string='';
      _str:=GP_Scud_Saldo.sMisConduct;
#IFDEF  _GP_SCUD_Head_FLT_DEBUG
    timelog(' isFilterAnCorrect IsBitCTW(wFilter,11) '+_str);
#ENDIF

      if wMisConduct_flt_A=0
      { if length(_str)=0
        { Result:=false; Exit;}
      }
      else
      { if length(_str)<>0
        { Result:=false; Exit;}
      }
    }
  }//function isFilterAnCorrect(ww_nrec:comp): boolean;

    //-------------------------------------------
  // скопировать фильтры в данные для отборв
  //-------------------------------------------
  Procedure CopyToA;
  { CopyMarker(Marker_Persons_A ,Marker_Persons);
    CopyMarker(Marker_KatOrg_A  ,Marker_KatOrg );
    CopyMarker(Marker_KatPodr_A ,Marker_KatPodr);
    sFio_Flt_A       :=sFio_Flt       ;
    sPropusk_Flt_A   :=sPropusk_Flt   ;
    wType_Flt_A      :=wType_Flt      ;
    wWork_Flt_A      :=wWork_Flt      ;
    wOver_Flt_A      :=wOver2_Flt     ;
    wOver2_Flt_A     :=wOver2_Flt     ;
    wHoliday_Flt_A   :=wHoliday_Flt   ;
    wMisConduct_Flt_A:=wMisConduct_Flt;

  } //Procedure CopyToA;

  //-------------------------------------------
  // восстановить данные для задания фильтрации
  // из данных для отбора
  //-------------------------------------------
  Procedure RestFromA;
  { CopyMarker(Marker_Persons ,Marker_Persons_A);
    CopyMarker(Marker_KatOrg  ,Marker_KatOrg_A );
    CopyMarker(Marker_KatPodr ,Marker_KatPodr_A);
    sFio_Flt       :=sFio_Flt_A       ;
    sPropusk_Flt   :=sPropusk_Flt_A   ;
    wType_Flt      :=wType_Flt_A      ;
    wWork_Flt      :=wWork_Flt_A      ;
    wOver_Flt      :=wOver2_Flt_A     ;
    wOver2_Flt     :=wOver2_Flt_A     ;
    wHoliday_Flt   :=wHoliday_Flt_A   ;
    wMisConduct_Flt:=wMisConduct_Flt_A;

  } //Procedure RestFromA;

  //-------------------------------------------
  #doc
    Установить ограничения
  #end
  Function SetFilterBounds(_IsArch:word) : boolean;
  { #__UNUSED__(_IsArch)
    Result:=false;
    _IsArch:=0;
    isFilterRun:=True;
    if ConditionActiveInLeave(tcFilterAn, #GP_SCUD_Pers)
    { PopConditionForLeave(tcFilterAn, #GP_SCUD_Pers);
    }
    NextVisual;
    If BoundActive(tbByPersons) SubBounds(tbByPersons);
    If BoundActive(tbByKatPodr) SubBounds(tbByKatPodr);
    If BoundActive(tbByKatOrg ) SubBounds(tbByKatOrg );
    If BoundActive(tbByType   ) SubBounds(tbByType   );
    //-----------------------
    CopyToA;
    //-----------------------
    ClearFuncCache; // очистим кэш функций
    var need_FilterAn:boolean=false;
    NextVisual;
    if IsBitCTW(wFilter,1)
    {  Count_KatPodr:=GetMarkerCount(Marker_KatPodr);
       GetMarker(Marker_KatPodr,0,pKatPodr);

       if Count_KatPodr=1
       { AddBounds(tbByKatPodr);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,2)
    {  Count_KatOrg:=GetMarkerCount(Marker_KatOrg);
       GetMarker(Marker_KatOrg,0,pKatOrg);

       if Count_KatOrg=1
       { AddBounds(tbByKatOrg);
       }
       else need_FilterAn:=true;
    }
    if IsBitCTW(wFilter,3)
    {  Count_Persons:=GetMarkerCount(Marker_Persons);
       GetMarker(Marker_Persons,0,pPersons);
       if Count_Persons=1
       {
         AddBounds(tbByPersons);
       }
       else need_FilterAn:=true;
    }
    if not NPOEM_OWN_SCUD_Pers_Other
    { BitOnW(wFilter,6) ;
      wType_Flt:=0;
    }

    if IsBitCTW(wFilter,6)
    { if wType_Flt<>10
        AddBounds(tbByType);
    }
    NextVisual;
    if (IsBitCTW(wFilter, 4) and sFio_Flt<>'')
    or (IsBitCTW(wFilter, 5) and sPropusk_Flt<>'')
    or (IsBitCTW(wFilter, 7) and wWork_Flt<>0)
    or (IsBitCTW(wFilter, 8))//сверхурочные
    or (IsBitCTW(wFilter, 9))//переработка
    or (IsBitCTW(wFilter,10))//выходные
    or (IsBitCTW(wFilter,11))//нарушения
      need_FilterAn:=true;

    if isPodrShare need_FilterAn:=true;
    NextVisual;

    // использование сложного фильтра
    if need_FilterAn
    { PushConditionForLeave(tcFilterAn, #GP_SCUD_Pers);
    }
    NextVisual;
    ReReadRecord(#GP_SCUD_Pers);
    Result:=true;
    isFilterRun:=False;

  } //Function SetFilterBounds : boolean;

  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_Katpodr
    { #mrkfiltr_(Katpodr_Flt,Katpodr,Nrec,wc_nrec,Katpodr_Flt.Kod+','+Katpodr_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_Katorg
    { #mrkfiltr_(KatOrg_Flt,KatOrg,Nrec,wc_nrec,KatOrg_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_Persons
    { #mrkfiltr_(GP_SCUD_PERS_Flt,Persons,Nrec,wc_nrec,GP_SCUD_PERS_Flt.Fio)
    }
    ReScanPanel(#KatPodr_Flt);
  } //Procedure SetFilterNM(_Field:longint)



