      : NoProtect,{Font={Color=if(IsBitCTW(wFilter,5),ColorSysBlack,ColorSysRed)}};
 //-------------------------------
  Filtr_Katpodr  ('Красный - фильтр отключен, нужно включить по Alt+B или изменить значение'): PickButton,Protect
    ,{Font={Color=if(IsBitCTW(wFilter,1) or Filtr_KatPodr='не задано',ColorSysBlack,ColorSysRed)}};
  Filtr_Persons  ('Красный - фильтр отключен, нужно включить по Alt+B или изменить значение'): PickButton,Protect
    ,{Font={Color=if(IsBitCTW(wFilter,3) or Filtr_Persons='не задано',ColorSysBlack,ColorSysRed)}};
