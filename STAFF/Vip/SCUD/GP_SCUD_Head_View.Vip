   #GP_SCUD_SALDO.Days[31]:Result:=31;
   end;
} //Function GetDayByField(_Field:longint);

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { StartNewVisual(vtNumericVisual, vfTimer + vfBreak + vfconfirm,''#3'Загрузка данных',0);

      LoadInterFace(true);
      NextVisual;
      if cRec>0
      { if getfirst GP_SCUD_Pers where (( cRec == GP_SCUD_Pers.nrec ))=tsok {}
      }
      SetFilterNm(0);
      iNextVisual(''#3'Загрузка данных 1') ;
      SetFilterBounds(0);
      iNextVisual(''#3'Загрузка данных 2') ;
      NextVisual;
      ReScanPanel(#GP_SCUD_Pers);
      BindEvent(onEvent_ReReadContainer, iGP_SCUD_StateMentOnAbsent.Event_ReReadContainer);
      iNextVisual(''#3'Загрузка данных 3') ;
      BindEvent(onEvent_ReReadContainer, pGP_SCUD_Order.Event_ReReadContainer);
      iNextVisual(''#3'Загрузка данных 4') ;
      StopVisual('',0);
      boWinEdit:=true;// чтобы открыть OpenSearch
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }

    //-----------------------------
    cmDone:
    {
      UnLoadInterFace(true);
      SaveParam;
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        {
        }
        else
        { set cRec:=GP_SCUD_Pers.Nrec;
        }
        CloseInterface(cmDefault)
      }
      else Putcommand(cmEdit);
    }
    cmEdit:
    {  case GetCurrentFormat of
       brScudPers: RunWindow(wnEditPers);
       /*
       brOrder  :
       { if not isvalidAll(#GP_scud_Doc_Sp_O)
         { message('Нет приказов по сотруднику');
           Exit;
         }
         pGP_SCUD_Order.InitParam(cgiMultiEdit,GP_scud_Doc_Sp_O.Nrec
          ,GP_scud_Doc_Sp_O.cGP_Scud_Doc,0,0,DTB,DTE);
         onEvent_ReReadContainer;
       }
       */
       end;
    }
    cmCheckField:
    { case curField of
      #wFilter:
      { if not isBitCtW(wFilter,7) wWork_Flt:=0;
        if not isBitCtW(wFilter,6) wType_Flt:=10;
      }
      #wYearRas,#wMonthRas,#wDays :
      { if wYearRas<2017
        { message('Истории событий до 2017 нет!');
          wYearRas :=2017;
        }
        else
        { if wYearRas>year(Cur_Date)
          { message('Год '+string(wYearRas)+' еще не наступил!' );
            wYearRas:=year(Cur_Date);
          }
        }
        InitPeriod;
        Clear_GP_Scud_Saldo;
        ReReadRecord(#GP_SCUD_Pers);
        PositionChanged;
      }
      #sPropusk_Flt: if sPropusk_Flt<>''  BitOnW(wFilter,5) else BitOffW(wFilter,5);
      #wType_Flt   : if wType_Flt<>10     BitOnW(wFilter,6) else BitOffW(wFilter,6);
      #sFio_Flt    : if sFio_Flt<>''      BitOnW(wFilter,4) else BitOffW(wFilter,6);
      #wWork_Flt   : if wWork_Flt<>0      BitOnW(wFilter,7) else BitOffW(wFilter,7);
      end;
      SetFilterImmediately;
    }
    //----------------------
    cmPick:
    { if (QuickChoiceName <> '')  QuickChoiceName := 'qcByName';
      var _need_filter:boolean=false;
      case CurField of
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,1);
          _need_filter:=true;
        }
      }
      //------------------------------
      #Filtr_KatOrg:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_KatOrg);
        StoreMarker(Marker_KatOrg,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_KatOrg,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_KatOrg,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_KatOrg);
          BitOnW(wFilter,2);
          _need_filter:=true;
        }
      }
      //------------------------------
      #Filtr_Persons:
      { /*
        KauMarkerName := iGetKau.GetMarkerName(cgKau_Persons);
        StoreMarker(Marker_Persons,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Persons,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_Persons,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_Persons);
          BitOnW(wFilter,3);
          _need_filter:=true;
        }
        */
        var ww_filter:word=0;
        if (QuickChoiceName <> '')
        { ClearMarker(Marker_Persons);
        }
        if isBitCTW(wFilter,1)
        { StoreMarker(Marker_Katpodr,'GP_SCUD_PERSEDIT_KatPodr');
          BitOnW(ww_filter,1);
        }
        if isBitCTW(wFilter,2)
        { StoreMarker(Marker_KatOrg,'GP_SCUD_PERSEDIT_KatOrg');
          BitOnW(ww_filter,2);
        }
        if ww_filter<>0
        { SaveMyDsk(ww_Filter  ,'GP_SCUD_PERSEDIT_wFilter');
        }
        if RunInterface(GP_SCUD_PersVib,cgiPickMult,0,Marker_Persons,0,0)<>cmCancel
        { SetFilterNm(#Filtr_Persons);
          BitOnW(wFilter,3);
          _need_filter:=true;
        }
      }
      end;
      if   _need_filter
      { SetFilterImmediately;
        ReScanPanel(#GP_SCUD_PERS);
      }
      if IsProtect
      { case  CurField of
        #wMonthRas, #wWork_Flt, #wType_Flt:
        {
        }
        else
        { Abort;
          Exit;
        }
        end;
      }
      case CurField of
      #KatPodr.Name:
      { pTmp:= GP_SCUD_Pers.cKatPodr;
        If (iGetKau.GetCodeKau(cgiPick,cgKau_KatPodr,pTmp) <> 0)
        { set GP_SCUD_Pers.cKatPodr:=pTmp;
        }
      }
      #KatOrg.Name:
      { pTmp:= GP_SCUD_Pers.cKatOrg;
        If (iGetKau.GetCodeKau(cgiPick,cgKau_KatOrg,pTmp) <> 0)
        { set GP_SCUD_Pers.cKatOrg:=pTmp;
        }
      }
      end;
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,1);
        SetFilterNm(#Filtr_KatPodr);
      }
      //------------------------------
      #Filtr_KatOrg:
      { ClearMarker(Marker_KatOrg);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatOrg);
      }
      //------------------------------
      #Filtr_Persons:
      { ClearMarker(Marker_Persons);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_Persons);
      }
      end;
      SetFilterImmediately;
    }

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Pers: RunInterface('ExClassifier', coGP_SCUD_Pers, GP_SCUD_Pers.nRec);
      end;
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      if RunWindowModal(wnFilter)=cmDefault
      { StartNewVisual(vtNumericVisual, vfTimer + vfBreak + vfconfirm,''#3'Загрузка данных',0);
        SetFilterBounds(0);
        StopVisual('',0);
      }
      else RestFromA
    }
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Pers: RunInterface('Attribute', coGP_SCUD_Pers, GP_SCUD_Pers.nRec);
      end;
    }
    //--------------------------
    cmValue1: // обновить
    { Clear_GP_Scud_Saldo;

    }
    cmValue2: // формирование приказов
    { UpdateTable;
      if RunWindowModal(wnFormOrder)=cmDefault
      { MakeOrder;
      }
    }
    cmValue3:  // рассчитать сальдо
    { if not UserAccessService.CanEdit(pStatus_GetDefault)
      { Message('У вас нет прав для запуска расчета сальдо');
        exit;

      }
      Calc_Saldo;
    }
    cmValue4: // Сформировать заявление
    { var _Calc_Date:date;
      _Calc_Date:=Cur_Date;
      if wDays>0 _Calc_Date:=date(wDays,wMonthRas,wYearRas );
      var _TMB,_TME,_TM:time=ZeroTime;
      var _wDay:word=GetDayByField(CurField);
      //--------------------
      Case GetCurrentFormat of
      brMisConDuct:
      { _Calc_Date:=GP_SCUD_MISCON_D.DT_Ev;
        iGP_SCUD_EventsEdit_Calc.Fill_Graff_info(GP_SCUD_PERS.Nrec,wYearRas,wMonthRas,0,day(_Calc_Date));
        _TMB:=iGP_SCUD_EventsEdit_Calc.GetTimeFromDouble(iGP_SCUD_EventsEdit_Calc.GetExtData(6,Day(_Calc_Date)));
        _TME:=iGP_SCUD_EventsEdit_Calc.GetTimeFromDouble(iGP_SCUD_EventsEdit_Calc.GetExtData(7,Day(_Calc_Date)));

        if GP_SCUD_MISCON_D.TM_Ev<>ZeroTime
        { _TMB:=GP_SCUD_MISCON_D.TM_Ev;

        }
        case GP_SCUD_MISCON_D.wMisConDuct of
        1: //Опоздание на работу
        { //начало смены 2
          _TM:=iGP_SCUD_EventsEdit_Calc.GetTimeFromDouble(iGP_SCUD_EventsEdit_Calc.GetExtData(8,Day(_Calc_Date)));
          if _Tm<>ZeroDate
          and _TMB>_TM
          {    _TMB:=_TM;
          }
          else
          { _TMB:=iGP_SCUD_EventsEdit_Calc.GetTimeFromDouble(iGP_SCUD_EventsEdit_Calc.GetExtData(6,Day(_Calc_Date)));
          }
        }
        3: //Поздний приход с обеда
        { // окончание периода 2
          _TM:=iGP_SCUD_EventsEdit_Calc.GetTimeFromDouble(iGP_SCUD_EventsEdit_Calc.GetExtData(13,Day(_Calc_Date)));
          if _Tm<>ZeroDate
          and _TMB>_TM
          { _TMB:=_TM;
          }
          else
          { //окончание периода 1
            _TMB:=iGP_SCUD_EventsEdit_Calc.GetTimeFromDouble(iGP_SCUD_EventsEdit_Calc.GetExtData(11,Day(_Calc_Date)));
          }
        }
        end;
        if GP_SCUD_MISCON_D.wMisConDuct<>6 and GP_SCUD_MISCON_D.wMisConDuct<>5
          _TME:=Add_Time(_TmB,GP_SCUD_MISCON_D.tDiff);
      }
      else
      { if _wDay>0
        { _Calc_Date:=date(_wDay,wMonthRas,wYearRas );
        }
        iGP_SCUD_EventsEdit_Calc.Fill_Graff_info(GP_SCUD_PERS.Nrec,wYearRas,wMonthRas,0,day(_Calc_Date));
        _TMB:=iGP_SCUD_EventsEdit_Calc.GetTimeFromDouble(iGP_SCUD_EventsEdit_Calc.GetExtData(6,Day(_Calc_Date)));
        _TME:=iGP_SCUD_EventsEdit_Calc.GetTimeFromDouble(iGP_SCUD_EventsEdit_Calc.GetExtData(7,Day(_Calc_Date)));

      }
      end;
        if message('Сформировать заявление для '
        +chr(13)+GP_SCUD_PERS.Fio+'?'
        +chr(13)+' будет сформировано на '+DateToStr(_Calc_Date,'DD.MM.YYYY')  ,YesNo ) <>cmYes
         exit;

      //---------- Само формирование
      iGP_SCUD_StateMentOnAbsent.MakeDoc(GP_SCUD_Pers.Nrec
                     ,0
                     ,_Calc_Date
                     ,_TMB
                     ,TimeToStr(_TME,'HH:MM')
                     ,ZeroTime
                     ,0
                     ,0);
      //---------- Само формирование
      onEvent_ReReadContainer;
    } //cmValue4:
    cmValue31://'назад'
    { wMonthRas:=wMonthRas-1;
      if wMonthRas=0
      { wYearRas:=wYearRas-1;
        wMonthRas:=12;
      }
      set wMonthRas:=wMonthRas;
      set wYearRas :=wYearRas;
      InitPeriod;
      Clear_GP_Scud_Saldo;
      ReReadRecord(#GP_SCUD_Pers);
      PositionChanged;
      //SetFilterImmediately;
    }
    cmValue32:// 'вперед'
    { wMonthRas:=wMonthRas+1;
      if wMonthRas=13
      { wYearRas:=wYearRas+1;
        wMonthRas:=1;
      }
      set wMonthRas:=wMonthRas;
      set wYearRas :=wYearRas;

      InitPeriod;
      Clear_GP_Scud_Saldo;
      ReReadRecord(#GP_SCUD_Pers);
      PositionChanged;
      //SetFilterImmediately;

    }

    cmPrintDoc:
    { Marker_Tmp  :=InitMarker('', 8, 50, 10, True);
      UpdateTable;
      StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Подготовка фильтров для отчета',0);
      if pMarker.Count>0
      { PushPos(#GP_SCUD_Pers);
        SubBounds(tbRmGP_SCUD_Pers1);
        AddBounds(tbRmGP_SCUD_Pers2);
        _Loop pMarker
        { if not NextVisual break;
          InsertMarker(Marker_Tmp,pMarker.pNRec )
        }
        SubBounds(tbRmGP_SCUD_Pers2);
        AddBounds(tbRmGP_SCUD_Pers1);
        PopPos(#GP_SCUD_Pers);

      }
      else
      { if message('Напечатать только текущую запись?'
          +chr(13)+'если нет, то все по установленному фильтру(долго)',YesNo)=cmYes
        { InsertMarker(Marker_Tmp,GP_SCUD_Pers.Nrec )
        }
        else
        { PushPos(#GP_SCUD_Pers);
          _Loop GP_SCUD_Pers
          { if not NextVisual break;
            InsertMarker(Marker_Tmp,GP_SCUD_Pers.NRec )
          }
          PopPos(#GP_SCUD_Pers);

        }
      } //if pMarker.Count>0
      ReScanPanel(#GP_SCUD_Pers);
      StopVisual('',0);
      RunInterface(GP_SCUD_REPORT,GetTypeDoc,1,Marker_KatPodr,0,DTB,DTE,Marker_Tmp);
      DoneMarker(Marker_Tmp,'');
    }

    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #GP_SCUD_Pers,#GP_SCUD_MISCON_D:
      { ProcessCommand(RunMenu('GP_SCUD_HeadEdit_Main_HotKey'));
      }
      end;
    }
  end;
end.

GP_SCUD_HeadEdit_Main_HotKey Menu
{
- 'Фильтр на данные'      , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Обновить'              , cmValue1   , 'Обновить', hcProc_NagrKaf, ,, scMenuCtx;
- 'Печать'                , cmPrintDoc, 'Формирование отчета по текущей настройке',, 'Ctrl+P', kbCtrlP, sci1Esc;
-----------;
- 'Сформировать заявление', cmValue4   , 'Сформировать заявление', hcProc_NagrKaf, ,, scMenuCtx;
//- 'Сформировать приказ'   , cmValue2   , 'Сформировать приказ', hcProc_NagrKaf, ,, scMenuCtx;
-----------;
- 'Пересчитать сальдо'    , cmValue3  , 'Перерасчет сальдо по всем отобранным', hcGkatalM1ExtClass, , , sci1Esc;
-----------;
- 'Внешняя классификация' , cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
- 'Внешние атрибуты'      , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;
-----------;

}
