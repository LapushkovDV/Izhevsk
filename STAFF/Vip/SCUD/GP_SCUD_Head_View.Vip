//----------------------------------------
Create View
var
   pPersons :comp;
   pKatPodr :comp;
   pKatOrg  :comp;
   wRejim   :word;
as select GP_SCUD_Pers.Nrec,GP_Scud_Saldo.sMisConduct,GP_SCUD_MISCON_D.*
From
  GP_SCUD_Pers(GP_SCUD_PERS02)
//, GP_SCUD_Pers_Hist
/*
, GP_SCUD_DOC_SP GP_SCUD_DOC_SP_O //приказы
, GP_SCUD_DOC    GP_SCUD_DOC_O    //приказы
, GP_TypeDocs    GP_TypeDocs_O
, GP_Status      GP_Status_O
*/
, Persons
, KatOrg
, Katpodr
, KLREJIM
//, KatPodr KatPodr_Hist
//, TYPEPR
, GP_Scud_Saldo
, GP_SCUD_MISCON_D
, GP_SCUD_Pers_Hist(GP_SCUD_PERS_HIST08)
, tmp_scud_order_new(tmp_scud_order_new01)// Для новых приказов
, tmp_Legend(tmp_legend01)
, UOWRKTABEL
//------- фильтры
 , KatPodr    KatPodr_Flt
 , KatOrg     KatOrg_Flt
 , GP_SCUD_PERS    GP_SCUD_PERS_Flt

where ((
    GP_SCUD_Pers.cPersons == Persons.Nrec
//--- свльдо
and GP_SCUD_Pers.Nrec     == GP_SCUD_SALDO.CGP_SCUD_PERS
and wYearRas              == GP_SCUD_SALDO.Yearn
and wMonthRas             == GP_SCUD_SALDO.Mesn

and GP_SCUD_Pers.cKatPodr == Katpodr.Nrec
and GP_SCUD_Pers.cKatOrg  == KatOrg.Nrec
and GP_SCUD_Pers.CKLREJIM == KLREJIM.NRec
and GP_SCUD_Pers.Nrec == GP_SCUD_Pers_Hist.cGP_SCUD_Pers
and DTE              >>= GP_SCUD_Pers_Hist.DTIZM

//and GP_SCUD_Pers.Nrec     == GP_SCUD_Pers_Hist.cGP_SCUD_Pers
//and GP_SCUD_Pers_Hist.cKatPodr == KatPodr_Hist.Nrec
//and GP_SCUD_Pers_Hist.wType    == TYPEPR.CodOper //тип приказа
//-------------
//and GP_SCUD_Pers.Nrec == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
//and wYearRas          == Tmp_Scud_MisConDuct.YearN
//and wMonthRas         == Tmp_Scud_MisConDuct.MesN
and GP_SCUD_Pers.Nrec == GP_SCUD_MISCON_D.cGP_SCUD_PERS
and wYearRas          == GP_SCUD_MISCON_D.YearN
and wMonthRas         == GP_SCUD_MISCON_D.MesN
and GP_SCUD_MisCon_D.cMisConDuct == GP_SCUD_DOC.Nrec
//------- фильтры
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == KatOrg_Flt.Nrec
and wc_nrec == GP_SCUD_PERS_Flt.Nrec

))
//Bounds byPersons  pPersons == GP_SCUD_Pers.cPersons(noindex) ordered by TableOrder
Bounds byPersons  pPersons == GP_SCUD_Pers.Nrec    (noindex) ordered by TableOrder
Bounds byKatOrg   pKatOrg  == GP_SCUD_Pers.cKatOrg (noindex) ordered by TableOrder
Bounds byKatPodr  pKatPodr == GP_SCUD_Pers.cKatPodr(noindex) ordered by TableOrder
Bounds byType     wType_Flt== GP_SCUD_Pers.wType   (noindex) ordered by TableOrder

condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_Pers.Nrec))
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;
