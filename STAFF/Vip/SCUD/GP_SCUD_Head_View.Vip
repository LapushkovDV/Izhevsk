    ,{Font={Color=if(IsBitCTW(wFilter,2) or Filtr_KatOrg='не задано',ColorSysBlack,ColorSysRed)}};
  sFio_Flt       ('Красный - фильтр отключен, нужно включить по Alt+B или изменить значение'): NoProtect
  ,{Font={Color=if(IsBitCTW(wFilter,4),ColorSysBlack,ColorSysRed)}};
