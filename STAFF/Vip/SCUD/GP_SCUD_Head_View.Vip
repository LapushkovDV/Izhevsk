Window wnFilter 'Установите фильтры'  Cyan, EscClose;
  Show at (,,50,14);
Screen scrFilter 'Фильтры' ('Фильтры',,sci13Esc);
Table KatPodr_Flt;
Fields
  wFilter :NoProtect;
  Filtr_Katpodr  : PickButton,Protect; //1
  Filtr_KatOrg   : PickButton,Protect; //2
  Filtr_Persons  : PickButton,Protect; //3
  sFio_Flt       : NoProtect; //4
  sPropusk_Flt   : NoProtect; //5
  wType_Flt      : [List
     10 'не задано'
    ,0 'сотрудники предприятия '
    ,1 'внешние подрядчики'
    ,2 'прочие' ], Protect;  //6
  wWork_Flt      : [List 0 'Не задано',1 'да'],Protect; //7
  wOver_Flt      : [List 0 'да',1 'нет'],Protect; //8
  wOver2_Flt     : [List 0 'да',1 'нет'],Protect; //9
  wHoliday_Flt   : [List 0 'да',1 'нет'],Protect; //10
  wMisConduct_Flt: [List 0 'да',1 'нет'],Protect; //11
Buttons
  cmOk    ,,, 'продолжить выполнение', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;
<<
  `Фильтр по`
 [.] подразделению` .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] организации`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] Сотруднику`    .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] по части фио`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] номер пропуска`.@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] тип записи`    .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] работающие`    .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] Сверхурочные`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] Переработка`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] Выходные`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [.] Нарушения`     .@@@@@@@@@@@@@@@@@@@@@@@@@@@
 <. Продолжить .>  <.   Отмена   .>
>>
end; //Screen scrFilter (,,sci13Esс);
