Window wnEditPers 'Редактирование'  Cyan, EscClose;
  Show at (,,100,25);
Screen scrEditPers 'Основные параметры' ('Основные параметры',,sci178Esc);
  Show at (,,77);
Table GP_SCUD_Pers;
Fields
  GP_SCUD_Pers.Fio          :Protect,NoPickButton,NoDel,QuickChoice;
  GP_SCUD_Pers.Code         :Protect,NoPickButton,NoDel,QuickChoice;
  KatPodr.Name             ('Подразделение',,sci1378Esc): Protect,NoDel,QuickChoice;
  [sType] GetPersTypeName(GP_SCUD_Pers.wType) ('Тип') :[30],noDel,Protect;
  KatOrg.Name              ('Организация',,sci1378Esc): Protect,NoDel,QuickChoice;
  [Kateg] GetKategPers(GP_SCUD_Pers.Nrec)  ('Категории сотрудников',,sci1378Esc): Protect,noDel,PickButton,QuickChoice ;
  [Grup]  iGP_SCUD_GrupEdit.GetGrupName (GP_SCUD_Pers.CGP_SCUD_GRUP) ('Группа сотрудников',,sci1378Esc): Protect,noDel,PickButton,QuickChoice ;
  [LbPropusk] 'Пропуск'    :Protect,Skip,{Font= {Bold=true}};
  GP_SCUD_Pers.PROPUSK_NMB          ('Пропуск, номер'):Protect,NoDel;
  GP_SCUD_Pers.PROPUSK_FROM         ('Пропуск, действует с'):Protect,NoDel;
  GP_SCUD_Pers.PROPUSK_TO           ('Пропуск, действует по'):Protect,NoDel;
  KLREJIM.NRejim                    ('Режим',,sci1378Esc) : Protect,noDel,Pickbutton,QuickChoice;
  [sExt_Key] if(GP_SCUD_Pers.EXT_KEY<>'','Да','')   ('Внешний ключ') : Protect,NoPickbutton,NoDel;
  [TB] if((GP_SCUD_Pers.PROPUSK_TB and 1)>0,'Да','')  ('Техника безопасности'):Protect,NoDel;

<<
 `ФИО`           .@@@@@@@@@@@@@@@@@@@@@@@@@@ `Таб.Номер/код` .@@@@@@@@@@@@@
 `Подразделение` .@@@@@@@@@@@@@@@@@@@@@@@@@@ `Тип`           .@@@@@@@@@@@@@
 `Организация`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Категория`     .@@@@@@@@@@@@@@@@@@@@@@@@@@ `Группа`        .@@@@@@@@@@@@@
 .@@@@@@@@@@@@@@ `Номер` .@@@@@@@@@@@@@@@@@@ `Выдан`         .@@@@@@@@@@@@@
                                             `Действует до ` .@@@@@@@@@@@@@
