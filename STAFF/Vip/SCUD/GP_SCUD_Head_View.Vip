Function GetDayByField(_Field:longint):word;
{  Result:=0;
   case _Field of
   #GP_SCUD_SALDO.Days[01]:Result:=01;
   #GP_SCUD_SALDO.Days[02]:Result:=02;
   #GP_SCUD_SALDO.Days[03]:Result:=03;
   #GP_SCUD_SALDO.Days[04]:Result:=04;
   #GP_SCUD_SALDO.Days[05]:Result:=05;
   #GP_SCUD_SALDO.Days[06]:Result:=06;
   #GP_SCUD_SALDO.Days[07]:Result:=07;
   #GP_SCUD_SALDO.Days[08]:Result:=08;
   #GP_SCUD_SALDO.Days[09]:Result:=09;
   #GP_SCUD_SALDO.Days[10]:Result:=10;
   #GP_SCUD_SALDO.Days[11]:Result:=11;
   #GP_SCUD_SALDO.Days[12]:Result:=12;
   #GP_SCUD_SALDO.Days[13]:Result:=13;
   #GP_SCUD_SALDO.Days[14]:Result:=14;
   #GP_SCUD_SALDO.Days[15]:Result:=15;
   #GP_SCUD_SALDO.Days[16]:Result:=16;
   #GP_SCUD_SALDO.Days[17]:Result:=17;
   #GP_SCUD_SALDO.Days[18]:Result:=18;
   #GP_SCUD_SALDO.Days[19]:Result:=19;
   #GP_SCUD_SALDO.Days[20]:Result:=20;
   #GP_SCUD_SALDO.Days[21]:Result:=21;
   #GP_SCUD_SALDO.Days[22]:Result:=22;
   #GP_SCUD_SALDO.Days[23]:Result:=23;
   #GP_SCUD_SALDO.Days[24]:Result:=24;
   #GP_SCUD_SALDO.Days[25]:Result:=25;
   #GP_SCUD_SALDO.Days[26]:Result:=26;
   #GP_SCUD_SALDO.Days[27]:Result:=27;
   #GP_SCUD_SALDO.Days[28]:Result:=28;
