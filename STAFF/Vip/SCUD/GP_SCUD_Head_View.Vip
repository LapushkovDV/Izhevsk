Procedure Clear_GP_Scud_Saldo;
{ ReReadRecord(#GP_SCUD_Pers);
  ReReadRecord(#GP_Scud_Saldo);
  ReReadRecord(#GP_SCUD_MISCON_D);

} //Function Clear_GP_Scud_Saldo:boolean;


//------------------------------------
// Получить значение всех полей
//------------------------------------
Procedure CalcAll(_wType:word;_cScud_Pers:comp);
var
   need_ins:boolean;
   _pNrec:comp;
{ need_ins:=true;
  _pNrec:=0;
  _pNrec:=GP_SCUD_Pers.Nrec;
  if _pNrec=0 then exit;
  _pNrec:=0;
  if isValidall(#GP_Scud_Saldo)
  { if _wType=0 exit;
  }
#IFDEF GP_SCUD_Head_View_DEBUG
  timelog('GP_SCUD_Head_View->CalcAll:'+GP_SCUD_Pers.FIO+', _pNrec='+string(_pNrec,0,0));
#ENDIF
  iGP_SCUD_EventsEdit_Calc.CalcAll(_cScud_Pers,wYearRas,wMonthRas,NPOEM_OWN_HEAD_V_VID,false);
#IFDEF GP_SCUD_Head_View_DEBUG
  timelog('GP_SCUD_Head_View->CalcAll:need_ins='+string(need_ins)+', _pNrec='+string(_pNrec,0,0));
#ENDIF
  ReReadREcord(#GP_Scud_Saldo );
  ReReadREcord(#GP_SCUD_MISCON_D );
} //Function CalcAll(_wType:word;_cScud_Pers:comp;_wDays:word):boolean;

//===============================================
// Перечитать запись при изменении в связанных окнах
//===============================================
Procedure onEvent_ReReadContainer;
{ timelog(' onEvent_ReReadContainer');
  if boVisibleRun
  { ClearFuncCache;
    CalcAll(1,GP_Scud_Pers.Nrec);
    PositionChanged;
    ReReadRecord(#GP_Scud_Pers);
  }
} //Procedure onEvent_ReReadContainer;

Function GetMis(_pScud_Pers:comp):string;
{ Result:='';
  CalcAll(0,_pScud_Pers);
  Result:=GP_Scud_Saldo.sMisConduct; //
} //Function GetMis(_pScud_Pers:comp):string;


Function GetFldVal(_pScud_Pers:comp; _wDay:word):string;
{ Result:='';
  CalcAll(0,_pScud_Pers);
  Result:=GP_Scud_Saldo.Days[_wDay];
} //Function GetFldVal(_pScud_Pers:comp; _wDay:word):string;

Function GetHour(_wType:word;_pScud_Pers:comp):string;
{ Result:=ZeroTime;
  CalcAll(0,_pScud_Pers);
  case _wType of
  1: Result:=String(GP_Scud_Saldo.CH_Graf_All,0,2);
  2: Result:=String(GP_Scud_Saldo.ch_Fact_ALL,0,2);
  3: Result:=String(GP_Scud_Saldo.ch_Diff_All,0,2);
  4: Result:=String(GP_Scud_Saldo.ch_Over_Cur,0,2);
  5: Result:=String(GP_Scud_Saldo.ch_Over2_Cur,0,2);
  6: Result:=String(iGP_Scud_SaldoEdit.GetHourFromSum(GP_Scud_Saldo.ch_Holiday_Cur),0,2);
  end;
} //Function CalcHour(_wType:word;_cScud_Pers:comp;_wDays:word):time;

//-----------------------------------
//
//-----------------------------------
Function Calc_Saldo:boolean;
{ Result:=false;
  UpdateTable;
  StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Ждите, идет пересчет сальдо',0);
  PushPos(#GP_SCUD_Pers);
  ClearFuncCache;
  _Loop fullcache GP_SCUD_Pers
  { if not NextVisual then break;
    if not iGP_SCUD_EventsEdit_Calc.CalcAll(GP_SCUD_Pers.Nrec,wYearRas,wMonthRas //Год , месяц расчета
    ,1//0 при расчета считаются , что на все сверхурочные есть приказ
                      //1 учитываются только проведенные приказы, если задан _DayCalc - то это вызов из приказа, и за этот день не учитываются
    ,true // true - с перерасчетом
    ,0 //DayCalc:word =0//при расчете для приказов указать день
    )
    { message('Ошибка расчета для '+GP_SCUD_PERS.Fio);
      break;
    }
    CalcAll(1,GP_Scud_Pers.Nrec);
  } //_Loop fullcache GP_Saldo_Pers
  PopPos(#GP_SCUD_Pers);
  PositionChanged;
  ReReadRecord(#GP_Scud_Pers);
  ReReadRecord(#GP_Scud_Saldo);
  ReReadRecord(#GP_SCUD_MISCON_D);
  StopVisual('',0);
  Result:=true;
} //Function Calc_Saldo:boolean;



//------------------------------------------
// Фон ячейки
//------------------------------------------
Function GetBackColorDay(ww_num:word):longint;
{ Result:=0;
  var ww_str:string='';
  if ww_num=100
  { ww_str:=tmp_Legend.Days;
  }
  else
  {ww_str:=GP_Scud_Saldo.Days[ww_num];//GetFldVal(GP_SCUD_Pers.Nrec,ww_num);
  }
  // выходы в середине дня менее чем на 15 минут
  if pos('/НС',ww_str)>0
  //// без пропуска
  or pos('/бп',ww_str)>0
  { Result:=ColorSysYellow;
  }
  else
  //нарушение
  if pos('/ЗО',ww_str)>0
  { Result:=18;
  }
  else
  if pos('/Н',ww_str)>0
  or pos('НН',ww_str)>0 //возможно нужно переместить в другой цвет
  { Result:=ColorSysRed;
  }
  else
  //переработка
  if pos('/П',ww_str)>0
  { Result:=ColorSysLime;
  }
  else
  //сверхурочные
  if pos('/CВ',ww_str)>0
  { Result:=ColorSysSilver ;
  }
  else
  //работа в выходной
  if pos('/РВ',ww_str)>0
  or pos('/РО',ww_str)>0
  { Result:=ColorSysFuchsia ;
  }
} //Function GetBackColorDay(ww_num:word):longint;

//-----------------------------------------
// Формирование легенды
//-----------------------------------------
Procedure MakeLegend;
var _wPa:word;
{ _wPa:=0;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='8:15'
                   , tmp_legend.prim:='Рабочий день - часы , минуты'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='10:45/П2.5'
                   , tmp_legend.prim:='Рабочий день с переработкой на 2 с половиной часа(в долях часа)'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='10:45/СВ2.5'
                   , tmp_legend.prim:='Рабочий день со сверхурочными на 2 с половиной часа(в долях часа)'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='4:30/РВ4.5'
                   , tmp_legend.prim:='Работа в выходной день за оплату на 4 с половиной часа(в долях часа)'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='4:30/РО4.5'
                   , tmp_legend.prim:='Работа в выходной день за отгул на 4 с половиной часа(в долях часа)'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='НН'
                   , tmp_legend.prim:='Не выявленная неявка'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='ЗО'
                   , tmp_legend.prim:='неявка с заявлением'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='/ЗО'
                   , tmp_legend.prim:='нарушение с заявлением'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='/НС'
                   , tmp_legend.prim:='выходы в середине дня менее чем на 15 минут'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='/Н'
                   , tmp_legend.prim:='Нарушение'
                   ;
  _wPa++;
  Insert into tmp_legend set
                     tmp_legend.Pa:=_wpa
                   , tmp_legend.Days:='/бп'
                   , tmp_legend.prim:='Нет пропуска, отработанное время считается по табелю';
                   ;
  if getfirst tmp_legend=tsok {}
  ReScanPanel(#tmp_legend);
} //Procedure MakeLegend;

//-------------------------------
// Получить наименование категории
