Procedure PositionChanged;
{ SetEditMode(CanEdittbl);
  var _wnrec:comp;
  _wnrec:=0;
  _wnrec:=GP_SCUD_Pers.Nrec;
  var _DT:date=ZeroDate;
  var _TmB,_TmE,_Plan_Time:time=ZeroTime;
  var _wType:word=0;
  var _wOpl:word=0;
  var _cNrec:comp=0;
  // будем видеть все документы
  iGP_SCUD_StateMentOnAbsent.GetFirstPeriodWithOutMisConDuct(_wnrec,DTB,DTE
          ,_DT,_TMB,_TME,_Plan_Time,_wType,_cNrec,true,1);
  pGP_SCUD_Order.GetFirstPeriodWithOutMisConDuct(_wnrec,DTB,DTE
          ,_DT,_TMB,_TME
          ,_wType //; var _need_calc:word
          ,_wOpl
          ,True //    ;boVisual:boolean=false
          ,1 //   ;All_Stat:word=0
          ,GP_iSC_OrderOver//    ;_wTypeDoc:word=0
          ,GP_iSC_OrderHoliday //    ;_wTypeDoc2:word=0
          ,1091 // на почасовые отклонения
          );

  iGP_SCUD_EventsEdit.InitParam(
       if(CanEditTbl(),0,cgiNotEdit)
      ,0,_wnrec
      ,0,0
      ,DTB
      ,DTE
      ,false);
  //CalcAll(1,_wnrec); - попробуем без перерасчета
  CalcAll(0,_wnrec);
  if boVisibleRun
  { //ReReadRecord(#GP_SCUD_MISCON_D);
    //ReReadRecord(#GP_SCUD_DOC_SP_O);
    //ReReadRecord(#GP_SCUD_Saldo);
  }
} //Procedure PositionChanged;
