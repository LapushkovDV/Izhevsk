Function GetKategPers(_pGP_SCUD_Pers:comp):string;cacheable;
{ #__UNUSED__(_pGP_SCUD_Pers)
  var _pKateg:comp=GP_SCUD_Pers.CGP_SCUD_KATEG;
  if getlast GP_SCUD_Pers_Hist=tsok
    _pKateg:=GP_SCUD_Pers_Hist.CGP_SCUD_KATEG;
  Result:=iGP_SCUD_KATEGEdit.GetKategName(_pKateg);
}

