{ if GetCurrentFormat=scrScudPers
  { StartNewVisual(vtNumericVisual, vfTimer+vfThread ,''#3'Загрузка данных',0);
    SetFilterBounds(0);
    StopVisual('',0);
  }
} //Procedure SetFilterImmediately;

