//-----------------------------------------
// Формирование приказа
//-----------------------------------------
Function MakeOrder_SP:boolean;
var ii:word;
    ch:double;
    _Dt:date;
    _TimeB,_TimeE:time;
    _wMes:string;
{ result:=false;
  iGP_SCUD_EventsEdit_Calc.CalcAll(GP_SCUD_PERS.Nrec,wYearRas,wMonthRas);

  for(ii:=wOrder_DayB;ii<=wOrder_DayE;ii++)
  {
    ch:=0;
    case wOrder_Type of
    0: ch:=iGP_SCUD_EventsEdit_Calc.GetCalc_CH_Over_Day(ii);
    1: ch:=iGP_SCUD_EventsEdit_Calc.GetCalc_CH_Holiday_Day(ii);
    2: ch:=iGP_SCUD_EventsEdit_Calc.GetCalc_CH_Over2_Day(ii);
    end;
    if ch=0 continue;
    _wMes:=GP_SCUD_PERS.Fio+' '+string(ch,0,2);
    _Dt:=date(ii,wMonthRas,wYearRas);
    clearbuffer(#tmp_scud_order_new);
    tmp_scud_order_new.Podr_Code:=Katpodr.Kod;
    tmp_scud_order_new.PodrName :=Katpodr.Name;
    tmp_scud_order_new.cPodr    :=GP_SCUD_PERS.cKatPodr;
    tmp_scud_order_new.cGP_SCUD_PERS:=GP_SCUD_PERS.Nrec;
    tmp_scud_order_new.Fio       :=GP_SCUD_PERS.Fio;
    tmp_scud_order_new.EventDate :=_Dt;
    tmp_scud_order_new.EventTMB  :=time(9,0,0,0);
    case wOrder_Type of
    0,2:
    { _TimeB:=_TimeE:=ZeroTime;
      if iGP_SCUD_EventsEdit_Calc.GetDayPeriod(GP_SCUD_PERS.Nrec,_Dt,_TimeB,_TimeE)>0
         tmp_scud_order_new.EventTMB:=_TimeB;
    }
    end;
    tmp_scud_order_new.EventTME  :=add_time(tmp_scud_order_new.EventTMB,iGP_SCUD_EventsEdit_Calc.GetTimeFromDouble(ch));
    tmp_scud_order_new.Diff      :=ch;
    case wOrder_Type of
    0: tmp_scud_order_new.wType:=GP_iSC_OrderOver    ;
    1: tmp_scud_order_new.wType:=GP_iSC_OrderHoliday ;
    2: tmp_scud_order_new.wType:=GP_iSC_OrderOver2   ;
    end;
    insert current tmp_scud_order_new;
    result:=true;
  } //for(ii:=wOrder_DayB;ii<=wOrder_DayE;ii++)
} //Function MakeOrder_SP:boolean;

//-----------------------------------------
// Формирование приказа
//-----------------------------------------
Function MakeOrder:boolean;
var _wMes:string;
{ Result:=false;
  timelog('GP_SCUD_Head_View->MakeOrder');
  message('Не реализовано!');
  Exit;
  var isAllOk:boolean=false;
  /*
  wOrder_Type  :NoProtect;
  wOrder_Form  :NoProtect;
  wOrder_DayB  :NoProtect;
  wOrder_DayE  :NoProtect;
  */
  delete all tmp_scud_order_new;// Для новых приказов
  StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Подготовка фильтров для отчета',0);
  oGP_Log.Init('SCUD_ORDER.log', true, true, true);
  timelog('GP_SCUD_Head_View->MakeOrder after log');
  case wOrder_Form of
  0: // 1
  { if  MakeOrder_SP isAllOk:=true;
  }
  else
  {   PushPos(#GP_SCUD_Pers);
      if pMarker.Count>0
      { PushPos(#GP_SCUD_Pers);
        SubBounds(tbRmGP_SCUD_Pers1);
        AddBounds(tbRmGP_SCUD_Pers2);
        _Loop pMarker
        { if not NextVisual
          { isAllOk:=false;
             break;
          }
          if  MakeOrder_SP isAllOk:=true;
        }
        SubBounds(tbRmGP_SCUD_Pers2);
        AddBounds(tbRmGP_SCUD_Pers1);
      }
      else
      {  _Loop GP_SCUD_Pers
         { if not NextVisual
           { isAllOk:=false;
             break;
           }
           if  MakeOrder_SP isAllOk:=true;
         }
      } //if pMarker.Count>0
      PopPos(#GP_SCUD_Pers);
      RescanPanel(#GP_SCUD_Pers);
      PositionChanged;
  }
  end;
  ReScanPanel(#GP_SCUD_Pers);

  StopVisual('',0);
  if isAllOk
  { pGP_SCUD_Order.MakeOrder;
  }
  else
  { _wMes:='Нет данных для формирования приказов';
    oGP_Log.Write(_wMes);
  }

  oGP_Log.Done(true);
  timelog('GP_SCUD_Head_View->MakeOrder finish');
  Result:=true;
} //Function MakeOrder:boolean;



