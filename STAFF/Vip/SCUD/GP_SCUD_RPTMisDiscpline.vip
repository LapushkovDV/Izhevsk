//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { timelog_init;
      //Статус "отклонен" в заявлении на отсутствие'
      NPOEM_OWN_SCUD_ZAbsent_STATUS_C  :=coGetTune('NPOEM_OWN.SCUD.ZAbsent_STATUS_C'  );
      //Аналитика для ведения причин отклонения заявления на отсутствие
      NPOEM_OWN_SCUD_ZAbsent_Refusal:=wGetTune('NPOEM_OWN.SCUD.ZAbsent_Refusal');
      if NPOEM_OWN_SCUD_ZAbsent_Refusal>0
      { cAttr_SCUD_DOC_Refusal  :=ExtAttr_CreateComp(coGP_SCUD_DOC,'Причина отклонения заявления на отсутствие',
                                     cgAttrType_Comp,0,NPOEM_OWN_SCUD_ZAbsent_Refusal);
      }
      else
      { cAttr_SCUD_DOC_Refusal:=0;
      }
      NPOEM_OWN_SCUD_Pers_Other :=boGetTune('NPOEM_OWN.SCUD.Pers_Other');//'Отображать сторонних лиц
      NPOEM_OWN_HEAD_V_VID:=wGetTune('NPOEM_OWN.HEAD_V_VID');//В интерфейсе руководителя отображать
      if IsBitCTW(15,3)=false
      { message( 'Некорректная версия ресурса с обектом'#13+
                 'InterFace GP_Static_Function '#13+
                 'Ошибка доступа к функциям системы.'#13#13+
                 'Обратитесь к администратору',Error );
        CloseInterface(cmCancel);
      }
      LoadParam;
      SetFilterNM(0);
      if RunWindowModal(wnFilter)=cmDefault
      {
        SborData;
        SetFilterBounds(0);
        CalcAll;
        ReScanPanel(#mtMain);

      }
      else
      { CloseInterface(cmDone);
        exit;
      }
    }
    //-----------------------------
    cmDone:
    { SaveParam;
    }
    //-----------------------------
    cmDefault:
    {
    }
    //----------------------
    cmPick:
    { case curField of
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,2);
        }
      }
      //------------------------------
      #Filtr_Persons:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Persons);


        StoreMarker(Marker_Persons,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Persons,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_Persons,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_Persons);
          BitOnW(wFilter,3);
        }
      }
      end; //case curField of
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatPodr);
      }
      //------------------------------
      #Filtr_Persons:
      { ClearMarker(Marker_Persons);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_Persons);
      }
      end;
    }
    //--------------------------
    cmPickClass:// внешние классификаторы
    {
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      CopyToA;
      if RunWindowModal(wnFilter)=cmDefault
      {
        SborData;
        SetFilterBounds(0);
//        If BoundActive(tbByPersons) or BoundActive(tbByKatPodr)
        CalcAll;
        ReScanPanel(#mtMain);

      }
      else RestFromA
    }
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #mtMAIN:
      { ProcessCommand(RunMenu('GP_SCUD_RPTMisDiscpline_Main_HotKey'));
      }
      end;
    }
    cmPrintDoc:
    { if RunWindowModal(wnParamPrint)=cmDefault
      { PushPos(#mtMain);
        case wTypeRep of
        0:PrintDoc;
        1:PrintDoc01;
        end;
        PopPos(#mtMain);
        PositionChanged;
      }
    }
    cmCheckField:
    {
     case curField of
      #DTB: if DTB> DTE set DTE := DTB;
      #DTE: if DTB> DTE set DTB := DTE;
     end;
    }
//    cmValue1: // Рассчитать по сотруднику
    cmEdit:
    {
       var chet:longint =0;
       var CurPers: comp;
       CurPers := mtMain.cGP_SCUD_Pers;
       PushPos(#mtMain);

        StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfconfirm,''#3'Рачет',RecordsInTable(#mtMain));
          _Loop mtMain
          {

             if CurPers = mtMain.cGP_SCUD_Pers
             { cPerCalc := 0; // пересчитать принудительно
               CalcPers(mtMain.cGP_SCUD_Pers, mtMain.EventDate);
             }


             if not nextvisual then break;
          }
        StopVisual('',0);
       PopPos(#mtMain);
       ReReadRecord(#mtMain);


    }

    cmValue2: CalcAll;// Рассчитать по всем

    cmValue5:
    {
    }
  end;
// cmPRGVersion : message('Трасляция на #__TOOLVERSION__ от #__DATETIME__');

end.


GP_SCUD_RPTMisDiscpline_Main_HotKey Menu
{
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
// -----------;
- 'Рассчитать по сотруднику'   , cmEdit   , 'Рассчитать по сотруднику', hcProc_NagrKaf, ,, scMenuCtx;
- 'Рассчитать ВСЁ'             , cmValue2   , 'Рассчитать ВСЁ', hcProc_NagrKaf, ,, scMenuCtx;
 -----------;
- '~П~ечать',cmPrintDoc,'Вывод в Excel отчета Дисциплина труда',hcNoContext,'Ctrl+P',kbCtrlP,sci1Esc,,,, bmpPrint;
//- 'Выгрузить в DBF TEST'             , cmValue5   , 'TEST Обновить', hcProc_NagrKaf, ,, scMenuCtx;
//- 'Внешняя классификация', cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
//- 'Внешние атрибуты'     , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;
}
