Table Struct mtMain (
    nRec: comp, // nRec первого события в течении дня
    BossFio: string[50],
    cBossPers: comp,
    cGP_SCUD_Pers: comp,
    EventDate    : date,
    cPersons     : comp,
    cKatPodr     : comp,
    FIO:string[100],
    TMB : time,
    TME : time,
    Break1B : time,
    Break1E : time,
    Break2B : time,
    Break2E : time,
    t1h : double  "Опоздание на работу",         //"Опоздание (час)",
    t2h : double  "Ранний уход на обед",         //"Уход раньше (час)",
    t3h : double  "Поздний приход с обеда",      //"Опоздание с обеда (час)",
    t4h : double  "Ранний уход с работы",        //"Другие выходы (час)",
    t5h : double  "Отсутствие в середине дня",   //"Сумма за день (час)",
    x6  : word    "Прогул", // куда его девать? даты - записи в таблице не будет. нужно создавать или нет?
    Sum : double  "Сумма за день",
    SortFld: string "Сортировка",
    ZAbsent: string "Контрольная карта"

) with index (
    nRec = nRec, // EventDate = + SortFld
/*    ForOut = SortFld + cPersons + EventDate,
    ForSort1 = cPersons + EventDate,
    ForSort2 = cKatPodr + SortFld + cPersons + EventDate,     */
    ForCalc  = cGP_SCUD_Pers + EventDate,
    ForExcel = BossFio+ cBossPers + SortFld + cPersons + EventDate
);

Create View vM
as select mtMain.Nrec
From
  Katpodr
 //, GP_SCUD_Doc, GP_Status
 // ,GP_SCUD_Pers
 //,GP_SCUD_Doc_SP
 //,GP_SCUD_Podr
 ,mtMain (ForExcel)
 ,mtMain mtMain_tmp (ForCalc)
 ,mtMain mtMain_free

//-------------------------------------
, KatPodr KatPodr_Flt
, Persons Persons_Flt
, ZAR_USER
, Tmp_Scud_MisConDuct
, Tmp_Scud_MisConDuct tMisConDuct
where
((  

     mtMain.cKatPodr == KatPodr.Nrec


//-----------------------------
and  mtMain.cGP_SCUD_Pers == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
and  mtMain.EventDate == Tmp_Scud_MisConDuct.DT_Ev
//and  wMonthRas == Tmp_Scud_MisConDuct.MesN
//and  wYearRas  == Tmp_Scud_MisConDuct.YearN
//-----------------------------

and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == Persons_Flt.Nrec

and  sUserName == ZAR_USER.OwnName

and   cPerCalc == mtMain_tmp.cGP_SCUD_Pers
and   DateCalcB <<= mtMain_tmp.EventDate
and   DateCalcE >>= mtMain_tmp.EventDate

and  mtMain_tmp.cGP_SCUD_Pers == tMisConDuct.cGP_SCUD_PERS
and  mtMain_tmp.EventDate     == tMisConDuct.DT_Ev

and root == mtMain_free.cGP_SCUD_Pers

))
;
//=================================================
Create View vGP_Scud_Doc
var
 pGP_Scud_Doc:comp;
as select GP_Status.name
From
   GP_Scud_Doc
  ,GP_Status
  ,GP_SCUD_REASON
where ((
    pGP_Scud_Doc == GP_Scud_Doc.Nrec
and GP_Scud_Doc.cStatus == GP_Status.Nrec
and GP_Scud_Doc.cReason == GP_SCUD_REASON.Nrec
));//Create view vGP_Scud_Doc

//=================================================
Create View vApp
var
  pPersons :comp;
  dDTB,dDTE:date;
as select Catalogs.Name
From Appointments,Catalogs
where
   ((
    pPersons == Appointments.Person
and        0 == Appointments.LPrizn
and       dDTE >>=Appointments.AppointDate
and       ( dDTB <= Appointments.DismissDate or  Appointments.DismissDate=ZeroDate)
and  Appointments.Post == Catalogs.NRec
));

//******************************************************************************
// Функции
//******************************************************************************

// Непонятно почему, но у меня IsBitCTW всегда выдаёт false
function IsBitOn (field: word; n: word): boolean;
{  IsBitOn := (((field shr (n-1)) and word(1)) > 0);
}
//== Функции для DSQL
#include Sql_Func.Vpp
#include excel_fun.vpp


  //------------------------------------
  // Наименование интерфейса
  //------------------------------------
  Function GetInterfaceName:string;
  { Result:=#(__InterfaceName__);
  }
  //------------------------------------
  // сохранить параметры
  //------------------------------------
  Procedure SaveParam;
  {
    SaveMyDsk(wFilter  ,GetInterfaceName+'_wFilter');
    SaveMyDsk(DTB      ,GetInterfaceName+'_DTB');
    SaveMyDsk(DTE      ,GetInterfaceName+'_DTE');
    SaveMyDsk(wTypeRep ,GetInterfaceName+'_wTypeRep');
    //-----------------------
    DoneMarker(Marker_Persons_A, '' );
    DoneMarker(Marker_KatPodr_A, '' );
    //-----------------------

    DoneMarker(Marker_Persons,GetInterfaceName+'_Persons');
    DoneMarker(Marker_KatPodr,GetInterfaceName+'_KatPodr');
  } //Procedure SaveParam;


//------------------------------------
// Получить наименование контрольной карты/заявления на отсутствие
//------------------------------------
Function GetZAbsentName(_pGP_Scud_Doc:comp):string;
var ww_str:string;
{ Result:='';
  vGP_Scud_Doc.pGP_Scud_Doc:=_pGP_Scud_Doc;
  if vGP_Scud_Doc.GetFirst GP_Scud_Doc<>tsok then exit;
  Result:=vGP_Scud_Doc.GP_Scud_Doc.DocNmb;
  if vGP_Scud_Doc.GetFirst GP_Status=tsok
    Result:=Result+', '+ vGP_Scud_Doc.GP_Status.Name;
  if vGP_Scud_Doc.GetFirst GP_SCUD_REASON=tsok
    Result:=Result+', '+ vGP_Scud_Doc.GP_SCUD_REASON.Name;
  if cAttr_SCUD_DOC_Refusal>0
  if vGP_Scud_Doc.GP_Scud_Doc.cStatus=NPOEM_OWN_SCUD_ZAbsent_STATUS_C
  { ww_str:=sGetAttrID(coGP_SCUD_Doc,vGP_Scud_Doc.GP_SCUD_Doc.Nrec,cAttr_SCUD_Doc_Refusal);
    if Length(ww_str)<>0
      Result:=Result+', '+ww_Str;
  }
} //Function GetZAbsentName(_pGP_Scud_Doc:comp):string;

//------------------------------------
// Доступность подразделения по зарплатным правам.
//------------------------------------
Function EnablePodr(_cPodr:comp) :boolean; cacheable;
{ Result:=DA.IsAvailable(_cPodr);
} //Function AVaiblePodr(_cPodr:comp) :comp; cacheable;

Function GetPodrShare :boolean;
{ Result:= ZAR_USER.PODRSHARE = '+'
}//Function PodrShare :boolean;


//------------------------------------
// декларация сложного фильтра
//------------------------------------
function isFilterAnCorrect(ww_nrec:comp): boolean; cacheable;
{ #__UNUSED__(ww_nrec)
  Result:=true;
  if isPodrShare
  {  if not EnablePodr(mtMain.cKatPodr)
      { Result:=false;
        Exit;
      }
  }
  if IsBitOn(wFilter,2)
  { if Count_KatPodr>1
    { If not FoundMarker(Marker_KatPodr_A,mtMain.cKatPodr)
      { Result:=false;
        Exit;
      }
    }
  }
  //-------------------------------------
  // Должен быть последним!
  //-------------------------------------
  if IsBitOn(wFilter,3)
  { if Count_Persons>1
     If not FoundMarker(Marker_Persons_A,mtMain.cPersons)
    { Result:=false;
      Exit;
    }
  }
  RecCnt++;
}//function isFilterAnCorrect(ww_nrec:comp): boolean;

//-------------------------------------------
// скопировать фильтры в данные для отборв
//-------------------------------------------
Procedure CopyToA;
{ CopyMarker(Marker_Persons_A ,Marker_Persons);
  CopyMarker(Marker_KatPodr_A ,Marker_KatPodr);
  wFilter_A   :=wFilter   ;
  filtr_Persons_A  :=filtr_Persons  ;
  filtr_KatPodr_A  :=filtr_KatPodr  ;
  DTB_A:=DTB;
  DTE_A:=DTE;

} //Procedure CopyToA;

//-------------------------------------------
// восстановить данные для задания фильтрации
// из данных для отбора
//-------------------------------------------
Procedure RestFromA;
{ CopyMarker(Marker_Persons ,Marker_Persons_A);
  CopyMarker(Marker_KatPodr ,Marker_KatPodr_A);
  wFilter       :=wFilter_A       ;
  filtr_Persons      :=filtr_Persons_A      ;
  filtr_KatPodr      :=filtr_KatPodr_A      ;
  DTB:=DTB_A;
  DTE:=DTE_A;

} //Procedure RestFromA;

//-------------------------------------------
Function SetFilterBounds(_IsArch:word) : boolean;
{ #__UNUSED__(_IsArch)
  Result:=false;
} //Function SetFilterBounds : boolean;

Function GetPostPers(_cPers : comp) : string; cacheable;
{ #__UNUSED__(_cPers)
  var res : string; res := '';

  if (_cPers <> comp(0))
  { vApp.pPersons:=_cPers;
    if (vApp.GetLast Appointments = tsOk)
        if (vApp.GetFirst Catalogs  = tsOk)
          res := vApp.Catalogs.Name;
  }
  result := res;
}

#include GP_SCUD_RPTMisDiscpline.Vpp

//---------------------------------------
// Установка наименований фильтров
//---------------------------------------
Procedure SetFilterNM(_Field:longint=0);
{ if _Field=0 or _Field=#Filtr_Katpodr
  { #mrkfiltr_(Katpodr_Flt,Katpodr,Nrec,wc_nrec,Katpodr_Flt.Kod+','+Katpodr_Flt.Name)
  }
  if _Field=0 or _Field=#Filtr_Persons
  { #mrkfiltr_(Persons_Flt,Persons,Nrec,wc_nrec,Persons_Flt.Fio)
  }

  ReScanPanel(#KatPodr_Flt);
} //Procedure SetFilterNM(_Field:longint)




Procedure LoadParam;
{
  FirstCalc := true;
  wIntMode := cgiNotEdit or cgiPickMult;
  sUserName :=UserName();
  if getfirst Zar_user=tsok {}
  isPodrShare:=GetPodrShare;

  DateCalc := ZeroDate;
  cPerCalc := comp(0);

      Marker_KatPodr   :=InitMarker(GetInterfaceName+'_KatPodr', 8, 50, 10, True);
      Marker_Persons   :=InitMarker(GetInterfaceName+'_Persons' , 8, 50, 10, True);

      Marker_KatPodr_A :=InitMarker('' , 8, 50, 10, True);
      Marker_Persons_A :=InitMarker('' , 8, 50, 10, True);

      if (wIntMode and cgiPickMult)=cgiPickMult
      { //DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'SCUD_LaborDiscipline';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;

  DTE := DATE(10,10,2017);// Cur_Date ;
  DTB := Add_Day(DTE,-3) ;

  if not ReadMyDsk(DTE,GetInterfaceName+'_DTE',false) DTE:=Cur_Date;
  if not ReadMyDsk(DTB,GetInterfaceName+'_DTB',false) DTB:=Add_Day(DTE,-3) ;
  if not ReadMyDsk(wFilter,GetInterfaceName+'_wFilter',false) wFilter:=1;
  if not ReadMyDsk(wTypeRep,GetInterfaceName+'_wTypeRep',false) wTypeRep:=1;
} //Procedure LoadParam;
//------------------------------------------------------
// Изменение позиции
//------------------------------------------------------
Procedure PositionChanged;
{
  var _wnrec:comp;
  _wnrec:=0;
  _wnrec:=mtMAIN.cGP_SCUD_Pers;
  var _DT:date=ZeroDate;
  var _TmB,_TmE,_PlanTime:time=ZeroTime;
  var _wType:word=0;
  var _cNrec:comp=0;
   iGP_SCUD_StateMentOnAbsent.GetFirstPeriodWithOutMisConDuct(_wnrec,mtMain.EventDate,mtMain.EventDate
          ,_DT,_TMB,_TME,_PlanTime,_wType,_cNrec,true);

   iGP_SCUD_EventsEdit.InitParam(cgiNotEdit,0,mtMAIN.cGP_SCUD_Pers,0,0,mtMain.EventDate,mtMain.EventDate);
//  ReScanPanel(#GP_SCUD_DOC_SP);
} //Procedure PositionChanged

procedure CalcAll;
{
   var chet:longint =0;
   //PushPos(#mtMain);
   vApp.dDTB:=DTB;
   vApp.dDTE:=DTE;
  /*  If not ( BoundActive(tbByPersons)     or
             BoundActive(tbByKatPodr)     or
             BoundActive(tbByPeriodBeg)   or
             BoundActive(tbByPeriodEnd)   or
             ConditionActiveInLeave(tcFilterAn, #mtMain) )
     chet := RecordsInTable(#mtMain)
    else    */
//    _Loop mtMain chet++;
    chet := RecordsInTable(#mtMain) ;
    timelog('GP_SCUD_RPTMisDiscpline chet='+string(chet));
    StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfconfirm,''#3'Расчет',chet);
    cPerCalc := 0; // по первой записи пересчитать принудительно
     ReReadRecord(#mtMain);
     ReReadRecord(#mtMain_tmp);
      _Loop fullcache mtMain ordered by index ForCalc
      {
        //if (chet mod 2) = 0
        if not nextvisual then break;
        CalcPers(mtMain.cGP_SCUD_Pers, mtMain.EventDate);
      }
     ReReadRecord(#mtMain);

      if not IsBitCTW(wFilter,4)
      { delete mtMain where
                 mtMain.t1h=0 and mtMain.t2h=0 and mtMain.t3h=0
            and  mtMain.t4h=0 and mtMain.t5h=0 and mtMain.x6=0
            and  mtMain.Sum=0;
       timelog('GP_SCUD_RPTMisDiscpline без нарушений='+string(RecordsInTable(#mtMain)));
      }
    StopVisual('',0);
   //PopPos(#mtMain);
   if getfirst mtMain=tsok {}
   ReReadRecord(#mtMain);

    //if RecordsInTable(#Tmp_Scud_MisConDuct) >0
    //vM.PutTableToDBF (#Tmp_Scud_MisConDuct,'tMisConDuct.DBF',0);

}

