  iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t1h) 'Опоздание','на работу(час:м)'       :[10],Protect;
  iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t2h) 'Ранний уход','на обед(час:м)'       :[10],Protect;
  iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t3h) 'Поздний приход','с обеда(час:м)'    :[10],Protect;
  iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t4h) 'Ранний уход','с работы(час:м)'      :[10],Protect;
  //iGP_SCUD_EventsEdit_Cacl.GetTimeStrFromDouble(mtMain.t5h) 'Отсутствие в','середине дня(час:м)' :[10],Protect;

  mtMain.t1h  'Опоздание','на работу(час)'       :[10,2],Protect;
  mtMain.t2h  'Ранний уход','на обед(час)'       :[10,2],Protect;
  mtMain.t3h  'Поздний приход','с обеда(час)'    :[10,2],Protect;
  mtMain.t4h  'Ранний уход','с работы(час)'      :[10,2],Protect; // 'Другие выходы (час)'
  mtMain.t5h  'Отсутствие в','середине дня(час)' :[10,2],Protect;
  mtMain.Sum  'Сумма за день (час)'     :[20,2],Protect;
  mtMain.x6   'Прогул'  :[6],Protect;
