//=====================================
// фильтры и другие параметры
  wFilter       :Longint; //Фильтры
  wFilter2      :Longint; //Фильтры
  wDateFilter   :Longint; //Фильтр по дате
  boPrnFilter   :Boolean;
  NameGroupScud :String; //Группировка
  KodGroupScud  :String; //Группировка
  wSort         :word; //Сортировка
  maxColCount   :Longint; //Кол-во колонок в шаблоне
  nmtemplatemacros:String; //Макрос для XLS
  boCut :Boolean;
  boDBF :Boolean;

  wSex :word; //Пол М/Ж
  chas_f:double;// Для подденных отчетов - часы за день
  wOutColumn:Longint; //Поля для вывода
  wOutColumn2:Longint; //Поля для вывода 2
  wOutColumn3:Longint; //Поля для вывода 3
  //------------------------
  wPrnOption:word; // выводить  спецификацию
  chet :longint; //Счетчик
  wpr :char; // фильтр по картотеке //'С', 'У'
  //=========================
  err_kol :longint; // кол-во ошибок
  //=========================
  wOption    :Longint; //Опции 1
  wOption2   :Longint; //Опции 2
  fCurrMainFormat:longint;
  //=========================
  boDepartmentFilter:boolean;
  boSave2UserDeskRep:boolean;
  //=========================
  Marker_Count :longint;
  wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
  KauMarkerName:string;
  Marker_Tmp :longint;


  #mrkfld_(GP_SCUD_Pers) //Сотрудники
  #mrkfld_(KatPodr)// Подразделения
  #mrkfld_(KatOrg)// Организации
  #mrkfld_(GP_SCUD_GRUP)// группы сотр-ков
  #mrkfld_(GP_SCUD_Kateg)// категория
  #mrkfld_(GP_SCUD_Events)    // события
  #mrkfld_(GP_SCUD_MisConDuct)// виды нарушений
  #mrkfld_(GP_SCUD_Reason)    // причины выхода
  #mrkfld_(ZStatus)    // статусы заявлений

  wTypeRec   :word;// тип записи СКУД
  wOverWork  :word;// сверхурочные
  wOverWork2 :word;// Переработка
  wHoliday   :word;// Выходные
  wMisConDuct:word;// По нарушениям

  boGP_SCUD_Pers  :boolean;//Сотрудники
  boKatPodr       :boolean;// Подразделения
  boKatOrg        :boolean;// Организации
  boGP_SCUD_GRUP  :boolean;// группы сотр-ков
  boGP_SCUD_Kateg :boolean;// категория
  boGP_SCUD_Events:boolean;// события
  boTypeRec       :boolean;// тип записи СКУД
  boOverWork      :boolean;// сверхурочные
  boOverWork_exist : boolean;
  boOverWork2     :boolean;// Переработка
  boOverWork2_exist : boolean;
  boHoliday       :boolean;// Выходные
  boHoliday_exist :boolean;
  boMisConDuct    :boolean;// По нарушениям
  boMisConDuct_exist : boolean;
  boMisConDuct_Flt:boolean;
  boReason_Flt    :boolean;
  boZStatus_Flt   :boolean; //статусы заявлений
//=======
Create view 
//=======
var
  sRepName : String;
  pUserDeskRep : Comp;
  dtBeg,dtEnd :Date; //Дата
  wTipRep :word; //Тип отчета
  pNode    :comp;//Для дерева
  wMonthRas:word;
  wYearRas :word;
as Select
   Persons.Nrec
  ,Appointments.Nrec
  ,AppHist.Nrec
  ,KlKatego.Nrec
  ,tmp_report_gr.*
  ,tmp_report_sp.*
  ,tmp_report.*
From
   Persons
  ,Appointments
  ,AppHist
  ,KlKatego
  ,GP_SCUD_PERS
  //,Pick

  //Настройки отчета
  ,UserDeskRep
  ,Zar_User(ReadOnly)
  //,PickRep
  , KatPodr
  , KatORg
  , Klrejim
  , Klrejim Klrejim_App
  , GP_SCUD_Grup
  , GP_SCUD_Kateg
  , Tmp_Scud_MisConDuct
  , Tmp_Scud_MisConDuct  Tmp_Scud_MisConDuct_S
  // нарушения
  //, GP_SCUD_DOC_SP GP_SCUD_DOC_SP_A_M // для нарушений
  , GP_SCUD_DOC    GP_SCUD_DOC_A_M
  , GP_STATUS      GP_STATUS_A_M
  //==============Вывод
  ,tmp_report(tmp_report01)
  ,tmp_report_gr
  ,tmp_report_gr tmp_report_grMAIN
  ,tmp_report_gr tmp_report_gr_SP
  ,tmp_report_sp
  ,tmp_report_gr tmp_report_gr_v
  ,tmp_report_gr tmp_report_gr_v_Sub
  ,tmp_report_sp tmp_report_sp_v
 //=======================
  ,tmp_memprint

 // , Catalogs CatGrajd
  //---- фильтры
  ,GP_SCUD_Pers   GP_SCUD_Pers_Flt  // Сотрудники
  ,KatPodr        KatPodr_Flt       // Подразделения
  ,KatOrg         KatOrg_Flt        // Организации
  ,GP_SCUD_GRUP   GP_SCUD_GRUP_Flt  // группы сотр-ков
  ,GP_SCUD_Kateg  GP_SCUD_Kateg_Flt // категория
  ,GP_SCUD_Events GP_SCUD_Events_Flt// события
  ,GP_SCUD_MisConDuct GP_SCUD_MisConDuct_Flt//виды нарушения
  ,GP_SCUD_Reason GP_SCUD_Reason_Flt        // причины выхода
  ,GP_Status      GP_Status_Flt   //статусы
Where
((
     tmp_report.nrec == GP_SCUD_PERS.Nrec
and  GP_SCUD_PERS.cPersons == Persons.Nrec
and  word(Persons.cSovm)   == KlSovm.Sovm
and  GP_SCUD_PERS.cKatPodr == KatPodr.nrec
and  GP_SCUD_PERS.cKatOrg  == KatOrg.nrec
and  GP_SCUD_PERS.cKlRejim == KlRejim.nrec
and  GP_SCUD_PERS.cGP_SCUD_GRUP  == GP_SCUD_GRUP.Nrec
and  GP_SCUD_PERS.cGP_SCUD_Kateg == GP_SCUD_Kateg.Nrec
//----------------
and  GP_SCUD_PERS.Nrec == GP_SCUD_MISCON_D.cGP_SCUD_PERS
and  dtBeg <<= GP_SCUD_MISCON_D.DT_EV
and  dtEnd >>= GP_SCUD_MISCON_D.DT_EV
//Заявление на отсутствие
/*
and GP_SCUD_MISCON_D.cGP_SCUD_PERS == GP_SCUD_DOC_SP_A_M.cGP_SCUD_Pers
and GP_iSC_statement_on_absence  == GP_SCUD_DOC_SP_A_M.wType(Noindex)
and GP_SCUD_MISCON_D.DT_EV       == GP_SCUD_DOC_SP_A_M.EventDate
and (  GP_SCUD_MISCON_D.TM_EV>= GP_SCUD_DOC_SP_A_M.EventTMB // будет ловить все.
   and GP_SCUD_MISCON_D.TM_EV<= GP_SCUD_DOC_SP_A_M.EventTME
   // здесь еще на попадание бы
   )
  and GP_SCUD_DOC_SP_A_M.cGP_SCUD_DOC == GP_SCUD_DOC_A_M.Nrec
*/
and GP_SCUD_MISCON_D.cMisConDuct == GP_SCUD_DOC_A_M.Nrec
and GP_SCUD_DOC_A_M.cStatus         == GP_STATUS_A_M.Nrec
//-----------------------------
and sUserName  == Zar_User.OwnName
//-----------------------------
and  GP_SCUD_PERS.Nrec == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
and  wMonthRas == Tmp_Scud_MisConDuct.MesN
and  wYearRas  == Tmp_Scud_MisConDuct.YearN
//-----------------------------
and  GP_SCUD_PERS.Nrec == Tmp_Scud_MisConDuct_S.cGP_SCUD_PERS
and  wMonthRas == Tmp_Scud_MisConDuct_S.MesN
and  wYearRas  == Tmp_Scud_MisConDuct_S.YearN

//назначения текущее и предыдущее
and Persons.Nrec == Appointments.Person
and 0            == Appointments.LPrizn
and DT_SCAN_E   >>= Appointments.AppointDate
and Appointments.EmpCategory == KlKatego.nrec
and Appointments.WorkRegime  == Klrejim_App.Nrec
//История назначения
and Appointments.NREC == AppHist.CAPPOINT
and DT_SCAN_E            >>= AppHist.DREC
//--------------- события
and tmp_report.nrec == GP_SCUD_Events.cGP_SCUD_PERS
and dtBeg <<= GP_SCUD_Events.EnterDate
and dtEnd >>= GP_SCUD_Events.EnterDate

and tmp_report_gr.nrec == tmp_report_gr_SP.nrec
//--------------- для визуализации
and pNode == tmp_report_gr_v.cRec
and tmp_report_gr_v.Nrec == tmp_report_sp_v.cRec
and tmp_report_gr_v.Nrec == tmp_report_gr_v_Sub.cRec
//--------   Настройки отчета
and pUserDeskRep     == UserDeskRep.Nrec
and UserDeskRep.nRec == PickRep.cUserDeskRep
//------------------------------------
//  фильтры
and wc_nrec == GP_SCUD_Pers_Flt.Nrec      // Сотрудники
and wc_nrec == KatPodr_Flt.Nrec           // Подразделения
and wc_nrec == KatOrg_Flt.Nrec            // Организации
and wc_nrec == GP_SCUD_GRUP_Flt.Nrec      // группы сотр-ков
and wc_nrec == GP_SCUD_Kateg_Flt.Nrec     // категория
and wc_nrec == GP_SCUD_Events_Flt.Nrec    // события
and wc_nrec == GP_SCUD_MisConDuct_Flt.Nrec// виды нарушения
and wc_nrec == GP_SCUD_Reason_Flt.Nrec    // причины выхода
and wc_nrec == GP_Status.Nrec             // статусы

))
/*
bounds ByAppDate   = dtEnd >>= U_Student.AppDate 

bounds ByAppDate2  = dtBeg <<= U_Student.AppDate and
                     dtEnd >>= U_Student.AppDate 

bounds ByDisDate   = dtBeg <<= U_Student.DisDate and
                     dtEnd >>= U_Student.DisDate 
*/                     
;
//--------------------------------------------
// спецификация документа
create view vDoc_SP
var pDoc_SP:comp;
From GP_SCUD_DOC_SP, GP_SCUD_DOC,GP_Status
where
((   pDoc_SP == GP_SCUD_DOC_SP.Nrec
 and GP_SCUD_DOC_SP.cGP_SCUD_DOC == GP_SCUD_DOC.Nrec
 and GP_SCUD_DOC.cStatus         == GP_Status.Nrec
));


//--------------------------------------------
//====================================
// события
create view vEvents
var
  pGP_SCUD_Events:comp;
from GP_SCUD_Events, GP_Status
where ((
     pGP_SCUD_Events == GP_SCUD_Events.Nrec
and  GP_SCUD_Events.cStatus == GP_Status.Nrec
));

//====================================
Create view vSpr
var
 pPersons  :comp;
 pGp_Status:comp;
 wTypeDocs :word;
From
  Persons
 ,Gp_Status
 ,GP_TypeDocs
where ((
    pPersons  == Persons.Nrec
and pGp_Status == Gp_Status.Nrec
and wTypeDocs  == GP_TypeDocs.wType
)); //Create view vSpr


