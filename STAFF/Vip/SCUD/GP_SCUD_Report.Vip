Procedure MySetFormat;
{
  logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0)
                               +'!GP_SCUD_REP.log';
  if fileexist(logfilenm) deletefile(logfilenm);
  
  //nmtemplate:='Sсud_Report.xltm';
  nmtemplate:='Scud_Report'+LpadCh(string(wTipRep),'0',2)+'.xlsm';
  //Sсud_Report10.xlsm
  //Scud_Report10.xlsm

  nmtemplatemacros:='Sсud.bas';

  //iUpdRepSrvCli.UpdateFileSrvCliShort(nmtemplate, nmtemplate);
  //iUpdRepSrvCli.UpdateFileSrvCliShort(nmtemplatemacros, nmtemplatemacros);

  ReScanPanel(#Zar_user);
} //Procedure MySetFormat

//Все фильтры в False
Procedure ClearFilters;
{

}


Procedure MySetFilter;
{
  ClearFilters(); //Все фильтры в False
    //
  // группировки
  MySetGroupMasScud(KodGroupScud);

  if (wTipRep=100)
  {  dtBeg:=dtEnd;
     ClearFieldOption(#dtBeg, ofSelectable);
  }
  else
  {  SetFieldOption(#dtBeg, ofSelectable);
  }

  #mrkfiltr_(Katpodr_Flt       ,Katpodr        ,Nrec,wc_nrec,Katpodr_Flt.Kod+','+Katpodr_Flt.Name      );
  #mrkfiltr_(KatOrg_Flt        ,KatOrg         ,Nrec,wc_nrec,KatOrg_Flt.Name       );
  #mrkfiltr_(GP_SCUD_Pers_Flt  ,GP_SCUD_Pers   ,Nrec,wc_nrec,GP_SCUD_Pers_Flt.Fio      );
  #mrkfiltr_(GP_SCUD_GRUP_Flt  ,GP_SCUD_GRUP   ,Nrec,wc_nrec,GP_SCUD_GRUP_Flt.Name     );
  #mrkfiltr_(GP_SCUD_Kateg_Flt ,GP_SCUD_Kateg  ,Nrec,wc_nrec,GP_SCUD_Kateg_Flt.Name);
  #mrkfiltr_(GP_SCUD_Events_Flt,GP_SCUD_Events ,Nrec,wc_nrec,GP_SCUD_EVents_Flt.STRTABN+DateToStr(GP_SCUD_EVents_Flt.EnterDate,' DD/MM'));
  #mrkfiltr_(GP_SCUD_MisConDuct_Flt ,GP_SCUD_MisConDuct ,Nrec,wc_nrec,GP_SCUD_MisConDuct_Flt.Name);
  #mrkfiltr_(GP_SCUD_Reason_Flt ,GP_SCUD_Reason,Nrec,wc_nrec,GP_SCUD_Reason_Flt.Name);
  #mrkfiltr_(GP_Status_Flt      ,ZStatus       ,Nrec,wc_nrec,GP_Status_Flt.Name);

  ReScanPanel(#zar_user);
} //Procedure MySetFilter

Procedure RestoreOldInValue(_CurField : Longint; _OldVal : String);
{
  case (_CurField) of
    #dtBeg                    : dtBeg                   := StrToDate(_OldVal, 'DD/MM/YYYY');
    #dtEnd                    : dtEnd                   := StrToDate(_OldVal, 'DD/MM/YYYY');
    #wFilter                  : wFilter                 := longint(_OldVal);
    #wFilter2                 : wFilter2                := longint(_OldVal);
    #wOutColumn               : wOutColumn              := longint(_OldVal);
    #wOutColumn2              : wOutColumn2             := longint(_OldVal);
    #wDateFilter              : wDateFilter             := longint(_OldVal);
    #wOption                  : wOption                 := longint(_OldVal);
    #wOption2                 : wOption2                := longint(_OldVal);
    #dir_dbf                  : dir_dbf                 := _OldVal;

    #logfilekl                : logfilekl               := if(UpCase(_OldVal)='TRUE', True, False);
    #wTipRep                  : wTipRep                 := longint(_OldVal);
    #boCut                    : boCut                   := if(UpCase(_OldVal)='TRUE', True, False);
    #boDBF                    : boDBF                   := if(UpCase(_OldVal)='TRUE', True, False);
    #boPrnFilter              : boPrnFilter             := if(UpCase(_OldVal)='TRUE', True, False);
  end;
}

Procedure Init;
{
  sRepName := 'GP_SCUD_REP';
  sUserName:=UserName();
  ////Аналитика для ведения причин отклонения заявления на отсутствие
  NPOEM_OWN_SCUD_ZAbsent_Refusal:=wGetTune('NPOEM_OWN.SCUD.ZAbsent_Refusal');
  if NPOEM_OWN_SCUD_ZAbsent_Refusal>0
  { cAttr_SCUD_DOC_Refusal  :=ExtAttr_CreateComp(coGP_SCUD_DOC,'Причина отклонения заявления на отсутствие',
                                     cgAttrType_Comp,0,NPOEM_OWN_SCUD_ZAbsent_Refusal);
  }
  else
  { cAttr_SCUD_DOC_Refusal:=0;
  }
  NPOEM_OWN_SCUD_Pers_Other :=boGetTune('NPOEM_OWN.SCUD.Pers_Other');//'Отображать сторонних лиц

  ReadParam;
  if wInterface_Type>0// тип интерфейса = GP_TypeDocs.wType
  { wTipRep:=wTipRep_IN; // тип интерфейса по умолчанию
    wFilter:=0;
    if MarkerIn_Podr<>0  // маркер входной по подразделениям
    if GetMarkerCount(MarkerIn_Podr)>0
    { ClearMarker(Marker_Katpodr);
      CopyMarker(Marker_Katpodr,MarkerIn_Podr);
      BitOnL(wFilter,2)
    }
    if MarkerIn_Events<>0 // маркер по событиям
    if GetMarkerCount(MarkerIn_Events)>0
    { ClearMarker(Marker_GP_SCUD_Events);
      CopyMarker(Marker_GP_SCUD_Events,MarkerIn_Events);
      BitOnL(wFilter,11)
    }
    if MarkerIn_Pers<>0 // маркер по событиям
    if GetMarkerCount(MarkerIn_Pers)>0
    { ClearMarker(Marker_GP_SCUD_Pers);
      CopyMarker(Marker_GP_SCUD_Pers,MarkerIn_Pers);
      BitOnL(wFilter,1)
    }
    IF DTB_IN<>ZeroDate
      DTBeg:=DTB_IN; // период отчета
    IF DTE_IN<>ZeroDate
      DTEnd:=DTE_IN; // период отчета

  }
  MySetFormat;
  MySetFilter;
}

Procedure Done;
{
  SaveParam;
}

HandleEvent
cmPick :
{
  case curfield of
  #UserDeskRep.REPOPI :
  {
    SaveParam;
    RunInterface('GP_GetUserDeskRep', pUserDeskRep, sRepName, 0, '');
    ReadParam;
    MySetFilter;
    exit;
  }
  end;
  if boSave2UserDeskRep ////
  if Not(GetUserDeskRep.CheckUserDeskRep(true,true))
  { exit;
  }

  case curfield of
  #nmtemplate : 
  { 
  }
   //=================================

  #NameGroupScud :
  { RunInterface('GP_SCUD_REPORT_Group',NameGroupScud,KodGroupScud);
    MySetFilter;
  }
  #dir_dbf:
  { var ww_str:string;
     ww_str:=GetDirName('Выберите папку для выгрузки DBF');
     if ww_str<>''
     { 
       dir_dbf:=ww_str;
       if substr(dir_dbf,length(dir_dbf),1)<>'\' dir_dbf:=dir_dbf+'\';
       nmDBFfile:=dir_dbf+'Stud.dbf';
     }
     
   
  }
  #Filtr_GP_SCUD_PERS  ://'Сотрудник'
  { if RunInterface(GP_SCUD_PERSVib,cgiPickMult,0,Marker_GP_SCUD_PERS,0,0)<>cmCancel
    MySetFilter;
  }
  #Filtr_KatPodr       ://'Подразделения'
  { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
    {
    }
    MySetFilter;
  }
  #Filtr_KatOrg        ://'Организации'
  { KauMarkerName := iGetKau.GetMarkerName(cgKau_KatOrg);
    StoreMarker(Marker_KatOrg,KauMarkerName);
    If (iGetKau.GetCodeKau(cgiPickMult,cgKau_KatOrg,Comp(0)) <> 0)
    { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
      CopyMarker(Marker_KatOrg,Marker_Tmp);
      DoneMarker(Marker_Tmp,'');
    }
    MySetFilter;
  }
  #Filtr_GP_SCUD_GRUP  ://'группы сотр-ков'
  { if RunInterface(GP_SCUD_GRUPEDIT,cgiPickMult,0,Marker_GP_SCUD_PERS)<>cmCancel
    MySetFilter;
  }
  #Filtr_GP_SCUD_Kateg ://'категория'
  { if RunInterface(GP_SCUD_KATEGEDIT,cgiPickMult,0,Marker_GP_SCUD_PERS)<>cmCancel
    MySetFilter;
  }
  #Filtr_GP_SCUD_Events  ://'события'
  { if RunInterface(GP_SCUD_EventsEDIT,cgiPickMult,0,Marker_GP_SCUD_Events)<>cmCancel
    MySetFilter;
  }
  #Filtr_GP_SCUD_MisConDuct:// виды нарушений
  { if RunInterface(GP_SCUD_MisConDuctEDIT,cgiPickMult,0,Marker_GP_SCUD_MisConDuct)<>cmCancel
    MySetFilter;
  }
  #Filtr_GP_SCUD_Reason    :// причины выхода
  { if RunInterface(GP_SCUD_ReasonEDIT,cgiPickMult,0,Marker_GP_SCUD_Reason)<>cmCancel
    MySetFilter;
  }
  #Filtr_ZStatus    :// причины выхода
  { var _cTypeDoc:comp=GetTypeDocNrecByType(GP_iSC_statement_on_absence);//,1010)
    var _cTmp:comp=0;
    GetMarker(Marker_ZStatus,0,_cTmp);
    if RunInterface(GP_Common::GP_StatusPickAndEdit,_cTypeDoc,cgiPickMult,_cTmp,Marker_ZStatus)<>cmCancel
      MySetFilter;
  }

  end;
//  MySetFilter;
}
cmDelOnProtect :
{

  if boSave2UserDeskRep ////
  if Not(GetUserDeskRep.CheckUserDeskRep(true,true))
  { exit;
  }
 
  case curfield of 

  #NameGroupScud :
  { NameGroupScud:='';
    KodGroupScud:='';
    MySetFilter;
  }
  #Filtr_GP_SCUD_PERS  ://'Сотрудник'
  { ClearMarker(Marker_GP_SCUD_PERS);
    MySetFilter;
  }
  #Filtr_KatPodr       ://'Подразделения'
  { ClearMarker(Marker_KatPodr);
    MySetFilter;
  }
  #Filtr_KatOrg        ://'Организации'
  { ClearMarker(Marker_KatOrg);
    MySetFilter;
  }
  #Filtr_GP_SCUD_GRUP  ://'группы сотр-ков'
  { ClearMarker(Marker_GP_SCUD_GRUP);
    MySetFilter;
  }
  #Filtr_GP_SCUD_Kateg ://'категория'
  { ClearMarker(Marker_GP_SCUD_Kateg);
    MySetFilter;
  }
  #Filtr_GP_SCUD_Events  ://'события'
  { ClearMarker(Marker_GP_SCUD_Events);
    MySetFilter;
  }
  #Filtr_GP_SCUD_MisConDuct:// виды нарушений
  { ClearMarker(Marker_GP_SCUD_MisConDuct);
    MySetFilter;
  }
  #Filtr_GP_SCUD_Reason    :// причины выхода
  { ClearMarker(Marker_GP_SCUD_Reason);
    MySetFilter;
  }
  end;
}

cmCheckField :
{ 

  if boSave2UserDeskRep ////
  if Not(GetUserDeskRep.CheckUserDeskRep(true,true))
  { RestoreOldInValue(CurField, OldFieldValue);
    MySetFilter;
    exit;
  }

 case curfield of
  #dtBeg :
  { 
    if(dtBeg>dtEnd) then dtEnd:=Date(Last_Day(dtBeg),month(dtBeg),year(dtBeg));
  }
  #dtEnd :
  { 
    if(dtBeg>dtEnd) then dtBeg:=Date(1,month(dtEnd),year(dtEnd));
  }
  #wDateFilter : 
  { 
         if (wDateFilter AND 1)>0 then wDateFilter:=1; //поступления
    else if (wDateFilter AND 2)>0 then wDateFilter:=2; //выбытия
    else if (wDateFilter AND 4)>0 then wDateFilter:=4; //перевода
    else if (wDateFilter AND 8)>0 then wDateFilter:=8; //поступления и последнее назначение
    else wDateFilter:=0;

    if (wDateFilter=0)
    {      dtBeg:=dtEnd;
           ClearFieldOption(#dtBeg, ofSelectable);
    } else SetFieldOption(#dtBeg, ofSelectable);

    ReScanPanel(#Zar_user);
  }
  #dir_dbf:
  { if substr(dir_dbf,length(dir_dbf),1)<>'\' dir_dbf:=dir_dbf+'\';
    nmDBFfile:=dir_dbf+'Scud.dbf';
  }
 end;
 MySetFilter;
}
cmInit : 
{
  Init;
}
cmDone :
{
  Done;
}
cmOk :
{
  MySetFilter;
  if not FormDoc then message('Ошибки при формировании');
  if (logfilekl) Then message('Смотри лог файл '+logfilenm);
}
end; //HandleEvent

end.
