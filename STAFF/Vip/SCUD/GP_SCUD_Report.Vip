  dtEnd               ('По')                        :noprotect;
  logfilekl     :noprotect;
  wTipRep            :[list 0 'По событиям'
                       ,01 'За месяц'
                       ,02 'Только итоги'
                       ,03 'Не-выявленные неявки'
                       ,04 'Потери рабочего времени'
                       ,05 'Сверхурочные'
                       ,06 'Выходные'
                       ,07 'Нарушения'
                       ,08 'Нарушения с детализацией'
                       ,09 'Заявление об отсутствии'
                       ,10 'Заявление с графиком'
                       ,11 'Парные события'
                       ], protect;
  nmtemplate('Шаблон')                               :protect,skip;
