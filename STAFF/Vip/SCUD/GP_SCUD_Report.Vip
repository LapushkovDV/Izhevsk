Parameters
   wInterface_Type
#doc
    тип интерфейса = GP_TypeDocs.wType
#end
 , wTipRep_IN
#doc
   тип отчета
#end
 , MarkerIn_Podr
#doc
   маркер входной по подразделениям
#end
 , MarkerIn_Events
#doc
   маркер по событиям
#end
  , DTB_IN
#doc
   период отчета
#end
  , DTE_IN
#doc
   период отчета
#end
 , MarkerIn_Pers
#doc
   маркер по сотрудникам
#end
;

form fLog('errr.out','errr') with novisual;
//== Функции для DSQL
#DEFINE SQL_PODR_Zar
#include Sql_Func.Vpp
#UNDEF SQL_PODR_Zar
//#include FuncUserDeskRep.Vpp
#include excel_fun.vpp
//#include kadryfiltr.vpp
//#include Func_all.Vpp

#include GP_SCUD_Report.vpp


Procedure ReadParam;
{
  Set pUserDeskRep := GetUserDeskRep.ReadUserDeskRep(pUserDeskRep,sRepName);

  //Фильтры
  Marker_GP_SCUD_Pers  := InitMarker('SCUD_REP_GP_SCUD_Pers'  , 8, 200, 10);//Сотрудники
  Marker_KatPodr       := InitMarker('SCUD_REP_KatPodr'       , 8, 200, 10);// Подразделения
  Marker_KatOrg        := InitMarker('SCUD_REP_KatOrg'        , 8, 200, 10);// Организации
  Marker_GP_SCUD_GRUP  := InitMarker('SCUD_REP_GP_SCUD_GRUP'  , 8, 200, 10);// группы сотр-ков
  Marker_GP_SCUD_Kateg := InitMarker('SCUD_REP_GP_SCUD_Kateg' , 8, 200, 10);// категория
  Marker_GP_SCUD_Events:= InitMarker('SCUD_REP_GP_SCUD_Events', 8, 200, 10);// события
  Marker_GP_SCUD_MisConDuct:=InitMarker('SCUD_REP_GP_SCUD_MisConDuct', 8, 200, 10);// виды нарушений
  Marker_GP_SCUD_Reason    :=InitMarker('SCUD_REP_GP_SCUD_Reason'    , 8, 200, 10);// причины выхода
  Marker_ZStatus           :=InitMarker('SCUD_REP_ZStatus'           , 8, 200, 10);// статусы

  if boSave2UserDeskRep //
  if (pUserDeskRep<>0)
  {
!    logfilekl         := False;
!    wpoint            := ',';
    dtBeg             := UserDeskRep.RESDATE[1];   if(dtBeg=Date(0,0,0)) then dtBeg:=cur_Date;
    dtEnd             := UserDeskRep.RESDATE[2];   if(dtEnd=Date(0,0,0)) then dtEnd:=cur_Date;
    NameGroupScud     := UserDeskRep.RESNAME[2];
    KodGroupScud      := UserDeskRep.RESNAME[3];
    dir_dbf           := UserDeskRep.RESNAME[6];  if dir_dbf='' dir_dbf:='c:\1\';
    nmDBFfile:=dir_dbf+'Scud.dbf';

    wFilter           := UserDeskRep.RESLNGINT[1];
    wOutColumn        := UserDeskRep.RESLNGINT[2]; if(wOutColumn=0) then wOutColumn:=15;
    wOutColumn2       := UserDeskRep.RESLNGINT[3];
    wDateFilter       := UserDeskRep.RESLNGINT[4];
    wOption           := UserDeskRep.RESLNGINT[5];
    wOption2          := UserDeskRep.RESLNGINT[6];
    wFilter2          := UserDeskRep.RESLNGINT[7];
    wOutColumn3       := UserDeskRep.RESLNGINT[8];

    wTipRep           := UserDeskRep.RESWORD[2];

    boCut             :=IsBit(UserDeskRep.RESWORD[1], 1);
    boPrnFilter       :=IsBit(UserDeskRep.RESWORD[1], 2);
    boDBF             :=IsBit(UserDeskRep.RESWORD[1], 3);
    //Фильтры
    wOverWork  := UserDeskRep.RESWORD[3];// сверхурочные
    wOverWork2 := UserDeskRep.RESWORD[4];// Переработка
    wHoliday   := UserDeskRep.RESWORD[5];// Выходные
    wMisConDuct:= UserDeskRep.RESWORD[6];// По нарушениям
    wSex       := UserDeskRep.RESWORD[7];//
    wTypeRec   := UserDeskRep.RESWORD[8];
    GetUserDeskRep.PickRepToMarker(Marker_GP_SCUD_PERS      , 1, '');
    GetUserDeskRep.PickRepToMarker(Marker_KatPodr           , 2, '');// Подразделения
    GetUserDeskRep.PickRepToMarker(Marker_KatOrg            , 3, '');// Организации
    GetUserDeskRep.PickRepToMarker(Marker_GP_SCUD_GRUP      , 4, '');// группы сотр-ков
    GetUserDeskRep.PickRepToMarker(Marker_GP_SCUD_Kateg     , 5, '');// категория
    GetUserDeskRep.PickRepToMarker(Marker_GP_SCUD_Events    , 6, '');// события
    GetUserDeskRep.PickRepToMarker(Marker_GP_SCUD_MisConDuct, 7, '');// виды нарушений
    GetUserDeskRep.PickRepToMarker(Marker_GP_SCUD_Reason    , 8, '');// причины выхода
    GetUserDeskRep.PickRepToMarker(Marker_ZStatus           , 9, '');// статусы

  }
  
  //---------
  if not boSave2UserDeskRep//
  { if not ReadMyDsk(dtBeg         ,'GP_SCUD_REP_dtBeg',false) then dtBeg:=cur_Date;
    if not ReadMyDsk(dtEnd         ,'GP_SCUD_REP_dtEnd',false) then dtEnd:=cur_Date;
    if not ReadMyDsk(NameGroupScud ,'GP_SCUD_REP_NameGroupScud',false) then  NameGroupScud:='';
    if not ReadMyDsk(KodGroupScud  ,'GP_SCUD_REP_KodGroupScud',false) then    KodGroupScud:='';

    if not ReadMyDsk(dir_dbf      ,'GP_SCUD_REP_dir_dbf',false) dir_dbf:='c:\1\';
    nmDBFfile:=dir_dbf+'Scud.dbf';

    if not ReadMyDsk(wFilter        ,'GP_SCUD_REP_wFilter',false) wFilter:=0;
    if not ReadMyDsk(wOutColumn     ,'GP_SCUD_REP_wOutColumn',false) then wOutColumn:=15;
    if not ReadMyDsk(wOutColumn2    ,'GP_SCUD_REP_wOutColumn2',false) then wOutColumn2:=0;
    if not ReadMyDsk(wDateFilter    ,'GP_SCUD_REP_wDateFilter',false) then wDateFilter:=0;
    if not ReadMyDsk(wOption        ,'GP_SCUD_REP_wOption',false) then wOption:=0;
    if not ReadMyDsk(wOption2       ,'GP_SCUD_REP_wOption2',false) then wOption2:=0;
    if not ReadMyDsk(wFilter2       ,'GP_SCUD_REP_wFilter2',false) then  wFilter2:=0;
    if not ReadMyDsk(wOutColumn3    ,'GP_SCUD_REP_wOutColumn3',false) then wOutColumn3:=0;

    if not ReadMyDsk(wTipRep        ,'GP_SCUD_REP_wTipRep',false) then wTipRep:=0;
    if not ReadMyDsk(boCut          ,'GP_SCUD_REP_boCut',false) then boCut:=false;
    if not ReadMyDsk(boPrnFilter    ,'GP_SCUD_REP_boPrnFilter',false) then boPrnFilter:=false;
    if not ReadMyDsk(boDBF          ,'GP_SCUD_REP_boDBF',false) then boDBF:=false;
    //------------------------
    if not ReadMyDsk(wOverWork  ,'GP_SCUD_REP_wOverWork'  ,false) then wOverWork  :=0;// сверхурочные
    if not ReadMyDsk(wOverWork2 ,'GP_SCUD_REP_wOverWork2' ,false) then wOverWork2 :=0;// Переработка
    if not ReadMyDsk(wHoliday   ,'GP_SCUD_REP_wHoliday'   ,false) then wHoliday   :=0;// Выходные
    if not ReadMyDsk(wMisConDuct,'GP_SCUD_REP_wMisConDuct',false) then wMisConDuct:=0;// По нарушениям
    if not ReadMyDsk(wSex       ,'GP_SCUD_REP_wSex'       ,false) then wSex       :=0;
    if not ReadMyDsk(wTypeRec   ,'GP_SCUD_REP_wTypeRec'   ,false) then wTypeRec   :=0;

  } //if not boSave2UserDeskRep//

}

Procedure SaveParam;
{
  if boSave2UserDeskRep //
  { GetUserDeskRep.SaveUserDeskRep;

    if GetFirst UserDeskRep Where (( pUserDeskRep == UserDeskRep.Nrec )) = tsOk 
     AND GetUserDeskRep.CheckUserDeskRep(boSave2UserDeskRep//
                                      ,false
                                      )
    {
      UserDeskRep.RESDATE[1]   := dtBeg;
      UserDeskRep.RESDATE[2]   := dtEnd;
      UserDeskRep.RESNAME[02]   := NameGroupScud;
      UserDeskRep.RESNAME[03]   := KodGroupScud;
      UserDeskRep.RESNAME[06]   := dir_dbf;

      UserDeskRep.RESLNGINT[1] := wFilter;
      UserDeskRep.RESLNGINT[2] := wOutColumn;
      UserDeskRep.RESLNGINT[3] := wOutColumn2;
      UserDeskRep.RESLNGINT[4] := wDateFilter;
      UserDeskRep.RESLNGINT[5] := wOption;
      UserDeskRep.RESLNGINT[6] := wOption2;
      UserDeskRep.RESLNGINT[7] := wFilter2;
      UserDeskRep.RESLNGINT[8] := wOutColumn3;
      UserDeskRep.RESWORD[2]   := wTipRep;
      if(boCut          ) then BitOnW(UserDeskRep.RESWORD[1], 1) else BitOffW(UserDeskRep.RESWORD[1], 1);
      if(boPrnFilter    ) then BitOnW(UserDeskRep.RESWORD[1], 2) else BitOffW(UserDeskRep.RESWORD[1], 2);
      if(boDBF          ) then BitOnW(UserDeskRep.RESWORD[1], 3) else BitOffW(UserDeskRep.RESWORD[1], 3);
      UserDeskRep.RESWORD[3]   :=wOverWork  ;// сверхурочные
      UserDeskRep.RESWORD[4]   :=wOverWork2 ;// Переработка
      UserDeskRep.RESWORD[5]   :=wHoliday   ;// Выходные
      UserDeskRep.RESWORD[6]   :=wMisConDuct;// По нарушениям
      UserDeskRep.RESWORD[7]   :=wSex;
      UserDeskRep.RESWORD[8]   :=wTypeRec   ;


      Update current UserDeskRep;

      //Фильтры
      //GetUserDeskRep.MarkerToPickRep(PersMarker          , 1, '');
    GetUserDeskRep.MarkerToPickRep(Marker_GP_SCUD_PERS      , 1, '');
    GetUserDeskRep.MarkerToPickRep(Marker_KatPodr           , 2, '');// Подразделения
    GetUserDeskRep.MarkerToPickRep(Marker_KatOrg            , 3, '');// Организации
    GetUserDeskRep.MarkerToPickRep(Marker_GP_SCUD_GRUP      , 4, '');// группы сотр-ков
    GetUserDeskRep.MarkerToPickRep(Marker_GP_SCUD_Kateg     , 5, '');// категория
    GetUserDeskRep.MarkerToPickRep(Marker_GP_SCUD_Events    , 6, '');// события
    GetUserDeskRep.MarkerToPickRep(Marker_GP_SCUD_MisConDuct, 7, '');// виды нарушений
    GetUserDeskRep.MarkerToPickRep(Marker_GP_SCUD_Reason    , 8, '');// причины выхода
    GetUserDeskRep.MarkerToPickRep(Marker_ZStatus           , 9, '');// статусы

    } //if GetFirst UserDeskRep Where (( pUserDeskRep == UserDeskRep.Nrec )) = tsOk 
  }//boSave2UserDeskRep
  if not boSave2UserDeskRep//
  { SaveMyDsk(dtBeg         ,'GP_SCUD_REP_dtBeg');
    SaveMyDsk(dtEnd         ,'GP_SCUD_REP_dtEnd');
    SaveMyDsk(NameGroupScud ,'GP_SCUD_REP_NameGroupScud');
    SaveMyDsk(KodGroupScud  ,'GP_SCUD_REP_KodGroupScud');

    SaveMyDsk(dir_dbf      ,'GP_SCUD_REP_dir_dbf');

    SaveMyDsk(wFilter        ,'GP_SCUD_REP_wFilter');
    SaveMyDsk(wOutColumn     ,'GP_SCUD_REP_wOutColumn');
    SaveMyDsk(wOutColumn2    ,'GP_SCUD_REP_wOutColumn2');
    SaveMyDsk(wDateFilter    ,'GP_SCUD_REP_wDateFilter');
    SaveMyDsk(wOption        ,'GP_SCUD_REP_wOption');
    SaveMyDsk(wOption2       ,'GP_SCUD_REP_wOption2');
    SaveMyDsk(wFilter2       ,'GP_SCUD_REP_wFilter2');
    SaveMyDsk(wOutColumn3    ,'GP_SCUD_REP_wOutColumn3');

    SaveMyDsk(wTipRep        ,'GP_SCUD_REP_wTipRep');
    SaveMyDsk(wSex           ,'GP_SCUD_REP_wSex');
    SaveMyDsk(boCut             ,'GP_SCUD_REP_boCut');
    SaveMyDsk(boPrnFilter       ,'GP_SCUD_REP_boPrnFilter');
    SaveMyDsk(boDBF             ,'GP_SCUD_REP_boDBF');
    //------------------------
    SaveMyDsk(wOverWork  ,'GP_SCUD_REP_wOverWork'  );// сверхурочные
    SaveMyDsk(wOverWork2 ,'GP_SCUD_REP_wOverWork2' );// Переработка
    SaveMyDsk(wHoliday   ,'GP_SCUD_REP_wHoliday'   );// Выходные
    SaveMyDsk(wMisConDuct,'GP_SCUD_REP_wMisConDuct');// По нарушениям
    SaveMyDsk(wSex       ,'GP_SCUD_REP_wSex'       );
    SaveMyDsk(wTypeRec   ,'GP_SCUD_REP_wTypeRec'   );

  } //if not boSave2UserDeskRep//

  //Фильтры
  //DoneMarker(PersMarker          ,'STUD_PersMarker');
  DoneMarker(Marker_GP_SCUD_Pers  ,'SCUD_REP_GP_SCUD_Pers'  );//Сотрудники
  DoneMarker(Marker_KatPodr       ,'SCUD_REP_KatPodr'       );// Подразделения
  DoneMarker(Marker_KatOrg        ,'SCUD_REP_KatOrg'        );// Организации
  DoneMarker(Marker_GP_SCUD_GRUP  ,'SCUD_REP_GP_SCUD_GRUP'  );// группы сотр-ков
  DoneMarker(Marker_GP_SCUD_Kateg ,'SCUD_REP_GP_SCUD_Kateg' );// категория
  DoneMarker(Marker_GP_SCUD_Events,'SCUD_REP_GP_SCUD_Events');// события
  DoneMarker(Marker_GP_SCUD_MisConDuct,'SCUD_REP_GP_SCUD_MisConDuct');// виды нарушений
  DoneMarker(Marker_GP_SCUD_Reason    ,'SCUD_REP_GP_SCUD_Reason');// причины выхода
  DoneMarker(Marker_ZStatus       ,'SCUD_REP_ZStatus');// статусы заявлений
  //===========

}
