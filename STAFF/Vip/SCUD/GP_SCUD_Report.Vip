    Filtr_ZStatus    ('фильтр для отчетов по заявлениям'      ,,sci13Esc):protect,pickbutton;
  wOverWork  :[List 0 'нет','есть'],Protect;// сверхурочные
  wOverWork2 :[List 0 'нет','есть'],Protect;// Переработка
  wHoliday   :[List 0 'нет','есть'],Protect;// Выходные
