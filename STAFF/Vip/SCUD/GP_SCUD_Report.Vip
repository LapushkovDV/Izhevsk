//-----------------------------------------------------
// Для поиска вышестоящего подразделения
//-----------------------------------------------------
Function GetKatPodrUp(_PKatPodr:comp):comp; cacheable;
{ Result:=_PKatPodr;
  if Result=0 then exit;
  set wc_nrec:=_PKatPodr;
  if getfirst KatPodr_Flt<>tsok exit;
  if pos('-',KatPodr_flt.kod)>0
  { Result:=GetKatPodrUp(KatPodr_flt.cPodr);
  }
} //Function GetKatPodrUp(_PKatPodr:comp):comp


//========================================================
Function MyCheckFilterPersons : Boolean;
//========================================================
var //boExist : Boolean;
    iii:word;
    ww_str:string;
{
  MyCheckFilterPersons := False;
  if boOverWork
  { if wOverWork=0
    { if iGP_SCUD_EventsEdit.GetCalc_CH_Over>0  exit;
    }
    else
    { if iGP_SCUD_EventsEdit.GetCalc_CH_Over=0  exit;
    }
  };// сверхурочные
  if boOverWork2
  { if wOverWork2=0
    { if iGP_SCUD_EventsEdit.GetCalc_CH_Over2>0  exit;
    }
    else
    { if iGP_SCUD_EventsEdit.GetCalc_CH_Over2=0  exit;
    }
  };// Переработка
  if boHoliday
  { if wHoliday=0
    { if iGP_SCUD_EventsEdit.GetCalc_CH_Holiday>0  exit;
    }
    else
    { if iGP_SCUD_EventsEdit.GetCalc_CH_Holiday=0  exit;
    }
  };// Выходные
  case wTipRep of
  7,8:
  { boMisConDuct_exist:=true;
    if getfirst GP_SCUD_DOC_A_M=tsok
      if GP_STATUS_A_M.Name='утвержден'
          boMisConDuct_exist:=false;
    if boMisConDuct
    { if wMisConDuct=0 if boMisConDuct_exist exit;
      if wMisConDuct=1 if not boMisConDuct_exist exit;
    }

  }
  else
  { if true //надо всегда boMisConDuct or boMisConDuct_Gr
    { boMisConDuct_exist:=false;
      For(iii:=1;iii<=31;iii++)
      { ww_str:=iGP_SCUD_EventsEdit.GetCalc_Days(iii);
        if      pos('НН',ww_str)>0 boMisConDuct_exist:=True;
        else if pos('/Н',ww_str)>0 boMisConDuct_exist:=True;
        if boMisConDuct_exist break;
      } //For(iii:=1;iii<=31;iii++)
      if boMisConDuct
      { if wMisConDuct=0 if boMisConDuct_exist exit;
        if wMisConDuct=1 if not boMisConDuct_exist exit;
      }
    };// По нарушениям
  }
  end;
  Result:=true;
} //Function MyCheckFilterPersons : Boolean;


Procedure InsItog_Day ;
var ii:word;
    _dt:date;
    day_B,Day_E:word;
    d:double;
    _wMonth,_Year:word;
{ day_B:=1;
  Day_E:=Day(DT_Scan_E);
  if  month(DT_Scan_E) = month(DtBeg)
  and year(DT_Scan_E) = year(DtBeg)
  { day_B:=Day(DtBeg);
  }
  _wMonth:=Month(DT_Scan_E);
  _Year  :=Year (DT_Scan_E);
  sKategory      :='';
  sPost          :='';
  sPodr          :='';
  if getlast Appointments=tsok
  { if isValidAll(#KlKatego)
      sKategory :=klkatego.kod; //   'код','категории'
    sPost     :=iCatFunc.GetCatalogsName(Appointments.Post);//'Должность'       :[20],Protect;
    sPodr     :=iCatFunc.GetCatalogsName(Appointments.Department);
  }
  if logfilekl  MyLogWrite(false,'InsItog_Day DT_Scan_E='+DateToStr(DT_Scan_E,'DD/MM/YYYY')
     +', day_B='+string(day_B)+', day_E='+string(day_E));
  // обратно , чтобы меньше рыскать по назначениям
  For(ii:=Day_E;ii>=Day_B;ii--)
  { _Dt:=date(ii,_wMonth,_Year);
    if logfilekl  MyLogWrite(false,'День '+string(ii));
    DT_Event:=_Dt;
    if _Dt<Appointments.AppointDate
    { DT_Scan_E:=_Dt;
      if getlast Appointments=tsok
      { if isValidAll(#KlKatego)
          sKategory :=klkatego.kod; //   'код','категории'
        sPost     :=iCatFunc.GetCatalogsName(Appointments.Post);//'Должность'       :[20],Protect;
        sPodr     :=iCatFunc.GetCatalogsCode(Appointments.Department);
      }
    }
    sKod_abs:=iGP_SCUD_EventsEdit.GetCalc_Days(ii);
    if pos('/',sKod_abs)>0
      sKod_abs:=trim(SubStr(sKod_abs,1,pos('/',sKod_abs)-1));

    case wTipRep of
    3:// 'Не выявленные неявки'
    { sKod_abs:=iGP_SCUD_EventsEdit.GetCalc_Days(ii);
      if pos('НН',sKod_abs)=0 then continue;
      sKod_abs:='НН';
      chas_f:=iGP_SCUD_EventsEdit.GetCalc_CH_Graf_Day(ii)-iGP_SCUD_EventsEdit.GetCalc_CH_Fact_Day(ii);
    }
    4:// 'Потери рабочего времени'
    { d:=0; d:=double(sKod_abs);
      if d>0 continue;
      if sKod_abs='В' continue;
      chas_f:=iGP_SCUD_EventsEdit.GetCalc_CH_Graf_Day(ii);
    }
    5:// 'Сверхурочные'
    { chas_f:=iGP_SCUD_EventsEdit.GetCalc_CH_Over_Day(ii);
      if chas_f=0 then continue;
      sKod_abs:='СВ';
    }
    6:// 'Выходные'
    { chas_f:=iGP_SCUD_EventsEdit.GetCalc_CH_Holiday_Day(ii);
      if chas_f=0 then continue;
      sKod_abs:='РВ';
    }
    end;
    if logfilekl  MyLogWrite(false,'часы  '+string(chas_f));
    InsItog;
  } //For(ii:=day_B;ii<=Day_E;ii++)
} //Procedure InsItog_Day ;

Procedure GetDataPers_Day;
var _wMisConDuct:word;
    isAllOk:boolean;
{    var _dt:date;
     _dt:=DTBeg ;
     MyLogWrite(false,'GetDataPers_Day');
     do
     { boOverWork_exist:=false;
       boOverWork2_exist:=false;
       DT_SCAN_E:=date(Last_Day(_Dt),month(_Dt),year(_Dt));
       if DT_SCAN_E>DtEnd   DT_SCAN_E:=DtEnd;
       if Calc_pPers <>GP_SCUD_PERS.Nrec
       or Calc_wMonth<>month(_DT)
       or Calc_wYear <>year(_DT)
       { Calc_pPers :=GP_SCUD_PERS.Nrec;
         Calc_wMonth:=month(_DT);
         Calc_wYear :=year(_DT);
         iGP_SCUD_EventsEdit.CalcAll(Calc_pPers,Calc_wYear,Calc_wMonth,2,false,0);
       }
       if iGP_SCUD_EventsEdit.GetCalc_CH_Over>0
          boOverWork_exist:=true;
       if iGP_SCUD_EventsEdit.GetCalc_CH_Over2>0
          boOverWork2_exist:=true;
       if iGP_SCUD_EventsEdit.GetCalc_CH_Holiday>0
          boHoliday_exist:=true;
       if not MyCheckFilterPersons continue;
       DT_Event:=date(1,month(_DT),year(_DT));
       wMonthRas:=Month(DT_Event);
       wYearRas :=Year(DT_Event);
       sMisConDuct:='';
       _wMisConDuct:=0;
       if boMisConDuct_Gr and boMisConDuct_exist
       { ReReadRecord(#Tmp_Scud_MisConDuct);
         isAllOk:=false;
         _loop Tmp_Scud_MisConDuct where
         ((     GP_SCUD_PERS.Nrec == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
           and  wMonthRas == Tmp_Scud_MisConDuct.MesN
           and  wYearRas  == Tmp_Scud_MisConDuct.YearN
           and  DT_Event  == Tmp_Scud_MisConDuct.DT_Ev
         ))
         { if Tmp_Scud_MisConDuct.wMisConDuct=0 then continue;
           if boMisConDuct_Flt
           { if not FoundMarker(Marker_GP_Scud_MisConDuct,iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeNrec(Tmp_Scud_MisConDuct.wMisConDuct))
                    then continue;
           }
           if IsBitCTW(_wMisConDuct,Tmp_Scud_MisConDuct.wMisConDuct) then continue;
           BitOnW(_wMisConDuct,Tmp_Scud_MisConDuct.wMisConDuct);
           sMisConDuct:=iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeName(Tmp_Scud_MisConDuct.wMisConDuct);
           InsItog_Day;
           isAllOk:=true;
         }
         if (not boMisConDuct_Flt) and (not isAllOk) InsItog_Day;

       }
       else
       { InsItog_day;
       }
       _dt:=add_months(_dt,1);
     } while _Dt<DtEnd

} //Procedure GetDataPers_Day;

Procedure GetDataPers_Mes;
var _wMisConDuct:word;
{    var _dt:date;
     _dt:=DTBeg ;
     do
     {
       DT_SCAN_E:=date(Last_Day(_Dt),month(_Dt),year(_Dt));
       if DT_SCAN_E>DtEnd   DT_SCAN_E:=DtEnd;
       boOverWork_exist:=false;
       boOverWork2_exist:=false;
       if DT_SCAN_E>DtEnd   DT_SCAN_E:=DtEnd;
       if Calc_pPers <>GP_SCUD_PERS.Nrec
       or Calc_wMonth<>month(_DT)
       or Calc_wYear <>year(_DT)
       { Calc_pPers :=GP_SCUD_PERS.Nrec;
         Calc_wMonth:=month(_DT);
         Calc_wYear :=year(_DT);
         iGP_SCUD_EventsEdit.CalcAll(Calc_pPers,Calc_wYear,Calc_wMonth,3,false,0);
       }
       if iGP_SCUD_EventsEdit.GetCalc_CH_Over>0
          boOverWork_exist:=true;
       if iGP_SCUD_EventsEdit.GetCalc_CH_Over2>0
          boOverWork2_exist:=true;
       if iGP_SCUD_EventsEdit.GetCalc_CH_Holiday>0
          boHoliday_exist:=true;
       if not MyCheckFilterPersons continue;
       DT_Event:=date(1,month(_DT),year(_DT));
       wMonthRas:=Month(DT_Event);
       wYearRas :=Year(DT_Event);
       sMisConDuct:='';
       _wMisConDuct:=0;
       if boMisConDuct_Gr and boMisConDuct_exist
       { ReReadRecord(#Tmp_Scud_MisConDuct);
         if getfirst Tmp_Scud_MisConDuct=tsok
         { _loop Tmp_Scud_MisConDuct
           { if Tmp_Scud_MisConDuct.wMisConDuct=0 then continue;
             if boMisConDuct_Flt
             { if not FoundMarker(Marker_GP_Scud_MisConDuct,iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeNrec(Tmp_Scud_MisConDuct.wMisConDuct))
                    then continue;
             }
             if IsBitCTW(_wMisConDuct,Tmp_Scud_MisConDuct.wMisConDuct) then continue;
             BitOnW(_wMisConDuct,Tmp_Scud_MisConDuct.wMisConDuct);
             sMisConDuct:=iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeName(Tmp_Scud_MisConDuct.wMisConDuct);
             InsItog;
           }
         }
         else InsItog;

       }
       else
       { InsItog;
       }
       _dt:=add_months(_dt,1);
     } while _Dt<DtEnd

} //Procedure GetDataPers_Mes;


Procedure GetDataPers;
{
// уволенные до этой даты нам не нужны
   MyLogWrite(false,'-------------------------------');
   MyLogWrite(false,GP_SCUD_PERS.FIO);
   DT_SCAN_E:=DtEnd;
   if getlast Appointments=tsok {};
   if getfirst Klrejim_App=tsok {};
   case wTipRep of
   0: //по событиям
   { iGP_SCUD_EventsEdit.InitParam(cgiNotEdit,0,GP_SCUD_PERS.Nrec,0,0,DtBeg,DtEnd);
     if iGp_Scud_EventsEdit.GetFirstEvents(pTSC_Event_Day)
     do {
      if boGP_SCUD_Events
        if not FoundMarker(Marker_GP_SCUD_Events,pTSC_Event_Day.Nrec) continue;
      if pTSC_Event_Day.Type_Ev=0 //выход
      { //если было пред.событие для выхода за тот же день , не обрабатываем
        if pTSC_Event_Day.DT_EV_P=pTSC_Event_Day.DT_EV continue;
      }
      DT_Event:=pTSC_Event_Day.DT_EV;

      boMisConDuct_exist:=length(pTSC_Event_Day.MisConDuct)<>0;

      //if not MyCheckFilterPersons then continue;
      if boMisConDuct
      { if wMisConDuct=0 if boMisConDuct_exist continue;
        if wMisConDuct=1 if not boMisConDuct_exist continue;
      }
      if boTypeRec  // тип записи СКУД
      { case wTypeRec of
        0: if pTSC_Event_Day.Status<>'СКУД' continue;
        1: if pTSC_Event_Day.Status<>'СКУД, корректировка' continue;
        2: if pTSC_Event_Day.Status<>'Добавлен вручную' continue;
        3: if pTSC_Event_Day.Status<>'Исключено из учета' continue;
        end;

      }
      InsItog;
     } while iGp_Scud_EventsEdit.GetNextEvents(pTSC_Event_Day);
   }

   01: //помесячный
   { GetDataPers_Mes;
   }
   02: //Итоги
   { GetDataPers_Mes;
   }
   03:// 'Не выявленные неявки'
   { GetDataPers_Day;
   }
   04:// 'Потери рабочего времени'
   { GetDataPers_Day;
   }
   05:// 'Сверхурочные'
   { GetDataPers_Day;
   }
   06:// 'Выходные'
   { GetDataPers_Day;
   }
   07,08:// 'Нарушения'
   { DT_SCAN_E:=DtEnd;
     if getlast Appointments=tsok
     { if isValidAll(#KlKatego)
        sKategory :=klkatego.kod; //   'код','категории'
       sPost     :=iCatFunc.GetCatalogsName(Appointments.Post);//'Должность'       :[20],Protect;
       sPodr     :=iCatFunc.GetCatalogsName(Appointments.Department);
     }
     _Loop fullcache GP_SCUD_MISCON_D
     {
       if boMisConDuct_Flt
       { if not FoundMarker(Marker_GP_Scud_MisConDuct,iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeNrec(GP_SCUD_MISCON_D.wMisConDuct))
             then continue;
       }

       DT_Event:=GP_SCUD_MISCON_D.DT_EV;

       boMisConDuct_exist:=true;
       if not MyCheckFilterPersons then continue;
       sMisConDuct:=iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeName(GP_SCUD_MISCON_D.wMisConDuct);
       MyLogWrite(false,'Нарушение  '+sMisConDuct);
       InsItog;
     }
   }
   09,10: // Заявления
   { vDoc_SP.pDoc_SP:=tmp_report.cDoc;
     if vDoc_SP.Getfirst GP_SCUD_DOC_SP=tsok
       if vDoc_SP.Getfirst GP_SCUD_DOC=tsok
         if pGP_SCUD_A.SetDocPosition(0,vDoc_Sp.GP_SCUD_DOC.Nrec,vDoc_Sp.GP_SCUD_DOC_SP.Nrec)
         { DT_Event:=vDoc_SP.GP_SCUD_DOC.DocDate; //
           if timelog_status>2 timelog(' Rep 10 DT_Event='+DateToStr(DT_Event,'DD/MM/YYYY')+' '+GP_SCUD_PERS.Fio);
           DT_SCAN_E:=DT_Event;
           if vDoc_SP.Getfirst GP_Status=tsok {}
           wc_nrec:=vDoc_SP.GP_SCUD_DOC.cKatPodr;
           if getfirst Katpodr_Flt=tsok
           sPodr:=Katpodr_Flt.Kod;
           if getlast Appointments=tsok
           { if isValidAll(#KlKatego)
              sKategory :=klkatego.kod; //   'код','категории'
             sPost     :=iCatFunc.GetCatalogsName(Appointments.Post);//'Должность'       :[20],Protect;
           }

           InsItog;
         }
   }
   11:
   {
     vEvents.pGP_Scud_Events := tmp_report.cDoc;
     if vEvents.getfirst GP_Scud_Events=tsok
     { DT_Event:=vEvents.GP_Scud_Events.EnterDate;
       DT_SCAN_E:=vEvents.GP_Scud_Events.EnterDate;
       if getlast Appointments=tsok
       { if isValidAll(#KlKatego)
          sKategory :=klkatego.kod; //   'код','категории'
         sPost     :=iCatFunc.GetCatalogsName(Appointments.Post);//'Должность'       :[20],Protect;
         sPodr     :=iCatFunc.GetCatalogsName(Appointments.Department);
       }
       InsItog; // все добавим там
     }
   }
   end;
} //Procedure GetDataPers

// собираем данные
Function SborData :boolean;
{ SborData:=false;
  chet:=0;
  //----------------------
  DT_SCAN_E:=DtEnd;
  //----------------------

  //----------------
  // DSQL
  //-- Что бы быстрее шло наполнение времянки
  ReSetBounds(#GP_SCUD_PERS);

  delete all tmp_report;
  CreateTempVib;
  ClearQuery(vliSQLCommand);
  //===========================
  var b_Appointments :boolean;
  b_Appointments:=False;
  
  if boGP_SCUD_Pers   InsTempVibByMarker(01,Marker_GP_SCUD_Pers  );//Сотрудники
  if boKatPodr        InsTempVibByMarker(02,Marker_KatPodr       );// Подразделения
  if boKatOrg         InsTempVibByMarker(03,Marker_KatOrg        );// Организации
  if boGP_SCUD_GRUP   InsTempVibByMarker(04,Marker_GP_SCUD_GRUP  );// группы сотр-ков
  if boGP_SCUD_Kateg  InsTempVibByMarker(05,Marker_GP_SCUD_Kateg );// категория
  if boGP_SCUD_Events InsTempVibByMarker(06,Marker_GP_SCUD_Events);// события
  if boMisConDuct_Flt InsTempVibByMarker(07,Marker_GP_SCUD_MisConDuct);// Вид нарушения
  if boReason_Flt     InsTempVibByMarker(08,Marker_GP_SCUD_Reason);// Вид выхода
  if boZStatus_Flt    InsTempVibByMarker(09,Marker_ZStatus)       ;// статусы заявлений
  //по правам на подразделения в ЗП
  InsTempVibForZarPodrShare(1000);
  //==================сам запрос ===================
  PrepareSQLQuery('select DISTINCT ');
  PrepareSQLQuery('     GP_SCUD_PERS.Nrec as NREC');
  PrepareSQLQuery('    ,GP_SCUD_PERS.fio as fio');
  case wTipRep of
  9,10:
  {   PrepareSQLQuery('    ,GP_SCUD_DOC_SP.Nrec as cDoc');
      PrepareSQLQuery('    ,GP_SCUD_DOC_SP.cGP_SCUD_DOC as cDoc2');
  }
  11:
  {   PrepareSQLQuery('    ,GP_SCUD_Events.Nrec as cDoc');
      PrepareSQLQuery('    ,EV_PREV_REC.Nrec as cDoc2');
  }
  else
  {  PrepareSQLQuery('    ,#comp(0) as cDoc');
     PrepareSQLQuery('    ,#comp(0) as cDoc2');
  }
  end;
  PrepareSQLQuery(' From GP_SCUD_PERS');
  if boGP_SCUD_Pers //Сотрудники
    PrepareSQLQuery(' inner join tempvib VibSCUD_Pers on VibSCUD_Pers.wlist=1 and VibSCUD_Pers.crec = GP_SCUD_PERS.Nrec ');
  if boKatPodr
    PrepareSQLQuery(' inner join tempvib VibKatPodr on VibKatPodr.wlist=2 and VibKatPodr.crec = GP_SCUD_PERS.cKatPodr ');
  //по правам на подразделения в ЗП - InsTempVibForZarPodrShare(1000);
  if GetPodrShare
    PrepareSQLQuery(' inner join tempvib VibPodr_R on VibPodr_R.wlist=1000 and VibPodr_R.crec = GP_SCUD_PERS.cKatPodr ');
  //--------------------
  if boKatOrg
    PrepareSQLQuery(' inner join tempvib VibKatOrg on VibKatOrg.wlist=3 and VibKatOrg.crec = GP_SCUD_PERS.cKatOrg ');
  if boGP_SCUD_GRUP
    PrepareSQLQuery(' inner join tempvib VibSCUD_GRUP on VibSCUD_GRUP.wlist=4 and VibSCUD_GRUP.crec = GP_SCUD_PERS.CGP_SCUD_GRUP ');
  if boGP_SCUD_Kateg
    PrepareSQLQuery(' inner join tempvib VibSCUD_Kateg on VibSCUD_Kateg.wlist=5 and VibSCUD_Kateg.crec = GP_SCUD_PERS.CGP_SCUD_Kateg');
  if wTipRep=0  or boTypeRec or boGP_SCUD_Events
  or wTipRep=11 // Непарные события
  { PrepareSQLQuery('inner join GP_SCUD_Events on GP_SCUD_Events.cGp_SCUD_PERS = Gp_SCUD_PERS.Nrec');
    PrepareSQLQuery(' and GP_SCUD_Events.EnterDate>=#Date('+DateToStr(dtBeg,'DD,MM,YYYY')+') ');
    PrepareSQLQuery(' and GP_SCUD_Events.EnterDate<=#Date('+DateToStr(dtEnd,'DD,MM,YYYY')+') ');
    PrepareSQLQuery('inner join GP_Status on GP_STATUS.Nrec = GP_SCUD_Events.cStatus');
    if boTypeRec  // тип записи СКУД
    { case wTypeRec of
      0: PrepareSQLQuery(' and GP_Status.name=''СКУД'' ');
      1: PrepareSQLQuery(' and GP_Status.name=''СКУД, корректировка'' ');
      2: PrepareSQLQuery(' and GP_Status.name=''Добавлен вручную'' ');
      3: PrepareSQLQuery(' and GP_Status.name=''Исключено из учета'' ');
      end;
    }
    else
    { PrepareSQLQuery(' and GP_Status.name<>''Исключено из учета'' ');
    }
    if wTipRep=11
    { PrepareSQLQuery(' inner join GP_SCUD_Events Ev_PREV_Rec on Ev_PREV_Rec.cGP_SCUD_PERS = GP_SCUD_Events.cGP_SCUD_PERS');
      PrepareSQLQuery(' and Ev_PREV_Rec.EnterDate<=GP_SCUD_Events.EnterDate');
      PrepareSQLQuery(' and Ev_PREV_Rec.EnterDate>=#Date('+DateToStr(Sub_Months(dtBeg,1),'DD,MM,YYYY')+')');
      PrepareSQLQuery(' and Ev_PREV_Rec.wResource = GP_SCUD_Events.wResource');
      PrepareSQLQuery(' and (Ev_PREV_Rec.EnterDate<GP_SCUD_Events.EnterDate or Ev_PREV_Rec.EnterTime<GP_SCUD_Events.EnterTime)');
      PrepareSQLQuery(' and EV_PREV_REC.sNPP<>''''');
      PrepareSQLQuery(' and LPAD(EV_PREV_REC.sNPP,15) in (select Max(LPAD(GP_SCUD_Events_D.sNPP, 15)) as sNPP From GP_SCUD_Events GP_SCUD_Events_D');
      PrepareSQLQuery('       where   GP_SCUD_Events_D.cGP_SCUD_PERS = GP_SCUD_Events.cGP_SCUD_PERS');
      PrepareSQLQuery('      and GP_SCUD_Events_D.EnterDate<=GP_SCUD_Events.EnterDate');
      PrepareSQLQuery('      and GP_SCUD_Events_D.EnterDate>=#Date('+DateToStr(Sub_Months(dtBeg,1),'DD,MM,YYYY')+ +')');
      PrepareSQLQuery('      and (GP_SCUD_Events_D.EnterDate<GP_SCUD_Events.EnterDate or GP_SCUD_Events_D.EnterTime<GP_SCUD_Events.EnterTime)');
      PrepareSQLQuery('      and GP_SCUD_Events_D.wSystem = GP_SCUD_Events.wSystem');
      PrepareSQLQuery('      )');
    }
    if boGP_SCUD_Events
      PrepareSQLQuery(' inner join tempvib VibSCUD_Events on VibSCUD_Events.wlist=6 and VibSCUD_Events.crec = GP_SCUD_Events.Nrec');
  } //if wTipRep=0  or boTypeRec or boGP_SCUD_Events
  if wTipRep=7 or wTipRep=8 //нарушения
  { PrepareSQLQuery('inner join GP_SCUD_MISCON_D on GP_SCUD_MISCON_D.cGp_SCUD_PERS = Gp_SCUD_PERS.Nrec');
    PrepareSQLQuery(' and GP_SCUD_MISCON_D.DT_EV>=#Date('+DateToStr(dtBeg,'DD,MM,YYYY')+') ');
    PrepareSQLQuery(' and GP_SCUD_MISCON_D.DT_EV<=#Date('+DateToStr(dtEnd,'DD,MM,YYYY')+') ');
  }
  if wTipRep=9 or wTipRep=10 //Заявление
  { PrepareSQLQuery('inner join GP_SCUD_DOC_SP on GP_SCUD_DOC_SP.cGp_SCUD_PERS = Gp_SCUD_PERS.Nrec');
    PrepareSQLQuery(' and GP_SCUD_DOC_SP.wType='+string(GP_iSC_statement_on_absence));
    PrepareSQLQuery('inner join GP_SCUD_DOC on GP_SCUD_DOC.Nrec = GP_SCUD_DOC_SP.cGP_SCUD_DOC');
    PrepareSQLQuery(' and GP_SCUD_DOC.DocDate>=#Date('+DateToStr(dtBeg,'DD,MM,YYYY')+') ');
    PrepareSQLQuery(' and GP_SCUD_DOC.DocDate<=#Date('+DateToStr(dtEnd,'DD,MM,YYYY')+') ');
    if boReason_Flt
    { PrepareSQLQuery(' inner join tempvib VibReason on VibReason.wlist=8 and VibReason.crec = GP_SCUD_DOC.CREASON');
    }
    if boZStatus_Flt
    { PrepareSQLQuery(' inner join tempvib VibZStatus on VibZStatus.wlist=9 and VibZStatus.crec = GP_SCUD_DOC.CSTATUS');
    }
  }  //if wTipRep=9 or wTipRep=10
  PrepareSQLQuery(' where GP_SCUD_PERS.Nrec<>#Comp(0)');
  if not NPOEM_OWN_SCUD_Pers_Other
  { PrepareSQLQuery(' and GP_SCUD_PERS.wType=0');
  }
  if boOverWork  {};// сверхурочные
  if boOverWork2 {};// Переработка
  if boHoliday   {};// Выходные
  if boMisConDuct{};// По нарушениям

  //=== RUN DSQL
  stmt := sqlAllocStmt;
  ExecDSQLex(tntmp_report);
  SetBounds(#GP_SCUD_PERS);
  //===== end DSQL
  Calc_pPers :=0;
  Calc_wMonth:=0;
  Calc_wYear :=0;

    StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfconfirm,''#3'Сбор данных',LongInt(RecordsInTable(#tmp_report)));
  _LOOP tmp_report
  { _loop GP_SCUD_PERS
    {
      //inc(chet);
      //if chet mod 100=0
      if not nextvisual then exit;
      GetDataPers; //!!!
    }
  }

  SborData:=true;
} //Function SborData

//Главное формирование
Function FormDoc :boolean;
{ err_kol:=0;
  if DTBeg=ZeroDate or DTEnd=ZeroDate
  { message('Не заполнен период формирования!');
    Exit;
  }
  MyLogWrite(true,'=========START========='+TimeToStr(Cur_Time,'HH.MM.SS.SSS'));

  //--------------------------------
  boGP_SCUD_Pers  :=IsBitCtw(wFilter,01);//Сотрудники
  boKatPodr       :=IsBitCtw(wFilter,02);// Подразделения
  boKatOrg        :=IsBitCtw(wFilter,03);// Организации
  boGP_SCUD_GRUP  :=IsBitCtw(wFilter,04);// группы сотр-ков
  boGP_SCUD_Kateg :=IsBitCtw(wFilter,05);// категория
  boTypeRec       :=IsBitCtw(wFilter,06);// тип записи СКУД
  boOverWork      :=IsBitCtw(wFilter,07);// сверхурочные
  boOverWork2     :=IsBitCtw(wFilter,08);// Переработка
  boHoliday       :=IsBitCtw(wFilter,09);// Выходные
  boMisConDuct    :=IsBitCtw(wFilter,10);// По нарушениям
  boGP_SCUD_Events:=IsBitCtw(wFilter,11);// По событиям
  //--------------------------------
  boMisConDuct_Flt:=IsBitCtw(wFilter2,01);// Вид нарушения
  boReason_Flt    :=IsBitCtw(wFilter2,02);// Вид выхода
  boZStatus_Flt   :=IsBitCtw(wFilter2,03);// статусы заявлений

  //---------------------------------
  MTRetrieve(#tmp_report,mfFilters + mfClear);
  MTRetrieve(#tmp_report_gr,mfFilters + mfClear);
  MTRetrieve(#tmp_report_sp,mfFilters + mfClear);
  MTRetrieve(#tmp_memprint,mfFilters + mfClear);
  ReSetBounds(#tmp_report);
  ReSetBounds(#tmp_report_gr);
  ReSetBounds(#tmp_report_sp);
  delete all tmp_report_gr;
  delete all tmp_report_sp;
  delete all tmp_memprint;
  SetBounds(#tmp_report);
  SetBounds(#tmp_report_gr);
  SetBounds(#tmp_report_sp);

MyLogWrite(false,'--- FormDoc beg ---'+TimeToStr(Cur_Time,'HH.MM.SS.SSS')+', '+string(wTipRep));
  FormDoc:=SborData;
  CalcItogShap; //Подобъем итоги
  StopVisual('',0);
  if not FormDoc Then exit;
MyLogWrite(false,'--- FormDoc end ---'+TimeToStr(Cur_Time,'HH.MM.SS.SSS'));
  //--- Здесь установим просмотр
  case wTipRep of
  0:
  { SetFormat(brMain00);
    SetFormat(TrMain00);
    fCurrMainFormat:=TrMain00;
  }
  1:
  { SetFormat(brMain01);
    SetFormat(TrMain01);
    fCurrMainFormat:=TrMain01;
  }
  2:
  { SetFormat(brMain02);
    SetFormat(TrMain02);
    fCurrMainFormat:=TrMain02;
  }
  3,4,5,6://3 'Не выявленные неявки',  4 'Потери рабочего времени',5 'Сверхурочные', 6 'Выходные'
  { SetFormat(brMain03);
    SetFormat(TrMain03);
    fCurrMainFormat:=TrMain03;
  }
  7: //'Нарушения'
  { SetFormat(brMain07);
    SetFormat(TrMain07);
    fCurrMainFormat:=TrMain07;
  }
  8: //'Нарушения по дням '
  { SetFormat(brMain08);
    SetFormat(TrMain08);
    fCurrMainFormat:=TrMain08;
  }
  9: //'Заявления на отсутствие '
  { SetFormat(brMain09);
    SetFormat(TrMain09);
    fCurrMainFormat:=TrMain09;
  }
  10: //'Заявления с графиком'
  { SetFormat(brMain10);
    SetFormat(TrMain10);
    fCurrMainFormat:=TrMain10;
  }
  11: //'Парные события'
  { SetFormat(brMain11);
    SetFormat(TrMain11);
    fCurrMainFormat:=TrMain11;
  }
  end;
  ReReadRecord(#tmp_report_gr_v);
  TreeJumpToRecord(fCurrMainFormat,0);
  ReScanPanel(#tmp_report_gr_v);
  RunWindowModal(wnViewReport);
MyLogWrite(false,'=========END========='+TimeToStr(Cur_Time,'HH.MM.SS.SSS'));
  /*
  if (Not fLog.error) and err_kol>0
  { fLog.showFile('Протокол');
  } else fLog.abortForm;
  */
} //Function FormDoc

