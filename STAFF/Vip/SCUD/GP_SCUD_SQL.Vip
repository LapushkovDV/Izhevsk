#include GP_SCUD_SQL.Vih
Interface GP_SCUD_SQL 'Запустить макросы на сервере'
var vliSQLStmt:longint;
var vliErrorCode:longint;
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
Function GetAllFromSCUD: Word;
//------------------------------------------------------------------------------
{
   StartNewVisual(vtRotateVisual, vfTimer, 'Ждите, идет загрузка данных с сервера', 1);
   vliSQLStmt:=0;
   vliSQLStmt := sqlAllocStmt;
   NextVisual;
   //dlog('LoadData 02')
   SqlBindParam(vliSQLStmt, 1, UserId() );
   //dlog('LoadData 03')

   //dlog('LoadData 04')
   vliErrorCode := sqlExecStmt(vliSQLStmt, 'GetAllFromSCUD(?)');
   NextVisual;

   if ( vliSQLStmt <> 0)
    sqlFreeStmt(vliSQLStmt);

   NextVisual;
   StopVisual('',0);

  Result := vliErrorCode;
} // procedure LoadDats


//------------------------------------------------------------------------------
Function SendAllToSCUD: Word;
//------------------------------------------------------------------------------
{
   StartNewVisual(vtRotateVisual, vfTimer, 'Ждите, идет загрузка данных с сервера', 1);
   vliSQLStmt:=0;
   vliSQLStmt := sqlAllocStmt;
   NextVisual;
   //dlog('LoadData 02')
   SqlBindParam(vliSQLStmt, 1, UserId() );
   //dlog('LoadData 03')

   //dlog('LoadData 04')
   vliErrorCode := sqlExecStmt(vliSQLStmt, 'SendAllToSCUD(?)');
   NextVisual;

   if ( vliSQLStmt <> 0)
    sqlFreeStmt(vliSQLStmt);

   NextVisual;
   StopVisual('',0);

  Result := vliErrorCode;
} // procedure SendDats

//------------------------------------------------------------------------------
Function SendPersToScud(_cScud_Pers:comp): Word;
//------------------------------------------------------------------------------
{
   StartNewVisual(vtRotateVisual, vfTimer, 'Ждите, идет загрузка данных с сервера', 1);
   vliSQLStmt :=0;
   vliSQLStmt := sqlAllocStmt;
   NextVisual;
   //dlog('LoadData 02')
   SqlBindParam(vliSQLStmt, 1, UserId() );
   SqlBindParam(vliSQLStmt, 2, _cScud_Pers );
   //dlog('LoadData 03')

   //dlog('LoadData 04')
   vliErrorCode := sqlExecStmt(vliSQLStmt, 'SendPersToScud(?,?)');
   NextVisual;

   if ( vliSQLStmt <> 0)
    sqlFreeStmt(vliSQLStmt);

   NextVisual;
   StopVisual('',0);

  Result := vliErrorCode;
} // procedure SendPersToServer



end.
