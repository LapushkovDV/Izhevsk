HandleEvent
cmInit:
{
   if CanEditTbl
  { if getlast GP_SCUD_Pers_Hist=tsok and GP_SCUD_Pers.wType = 0
    { if   GP_SCUD_Pers_Hist.cKatPodr       <> GP_SCUD_Pers.cKatPodr// "Подразделение"
        or GP_SCUD_Pers_Hist.cKlRejim       <> GP_SCUD_Pers.cKlRejim//  "Режим"
        or GP_SCUD_Pers_Hist.cGP_SCUD_Kateg <> GP_SCUD_Pers.cGP_SCUD_Kateg//) "Категории сотрудников"
        or GP_SCUD_Pers_Hist.CGP_SCUD_GRUP  <> GP_SCUD_Pers.CGP_SCUD_GRUP// "Группа сотрудников"
      { if message('Данные в последней записи истории не совпадают с карточкой'
          +chr(13)+'(Подразделение, режим, категория или группа)'
          +chr(13)+'Исправить карточку?',YesNo)=cmYes
        { update current GP_SCUD_Pers set
            GP_SCUD_Pers.cKatPodr       := GP_SCUD_Pers_Hist.cKatPodr// "Подразделен
           ,GP_SCUD_Pers.cKlRejim       := GP_SCUD_Pers_Hist.cKlRejim//  "Режим"
           ,GP_SCUD_Pers.cGP_SCUD_Kateg := GP_SCUD_Pers_Hist.cGP_SCUD_Kateg//) "Кате
           ,GP_SCUD_Pers.CGP_SCUD_GRUP  := GP_SCUD_Pers_Hist.CGP_SCUD_GRUP
           ;
        }
      }
    } //if getlast GP_SCUD_Pers_Hist=tsok
  }

  if (GP_SCUD_Pers.wType = 1)//Внешние подрядчики
  {
    SetFieldState(#extMailLabel, sfVisible);
    SetFieldState(#extMail, sfVisible);
    SetFieldState(#extPhoneLabel, sfVisible);
    SetFieldState(#extPhone, sfVisible);
    SetFieldState(#extVacBegLabel, sfVisible);
    SetFieldState(#extVacBeg, sfVisible);
    SetFieldState(#extVacEndLabel, sfVisible);
    SetFieldState(#extVacEnd, sfVisible);
    SetFieldState(#extBDateLabel, sfVisible);
    SetFieldState(#extBDate, sfVisible);
  } else {
    ClearFieldState(#extMailLabel, sfVisible);
    ClearFieldState(#extMail, sfVisible);
    ClearFieldState(#extPhoneLabel, sfVisible);
    ClearFieldState(#extPhone, sfVisible);
    ClearFieldState(#extVacBegLabel, sfVisible);
    ClearFieldState(#extVacBeg, sfVisible);
    ClearFieldState(#extVacEndLabel, sfVisible);
    ClearFieldState(#extVacEnd, sfVisible);
    ClearFieldState(#extBDateLabel, sfVisible);
    ClearFieldState(#extBDate, sfVisible);
    #extBDate
  }


  //CanEditTbl
} //cmInit
end;
end;//wnEditPers


