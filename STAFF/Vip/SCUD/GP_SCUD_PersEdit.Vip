Function GetPersName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Pers where
          (( _pNrec == GP_SCUD_Pers.nrec ))<>tsok exit;
  Result:=GP_SCUD_Pers.Fio;
} //Function GetPersName(_pNrec:comp)   :string; cacheable;

//-----------------------------------------
// Получить код
//-----------------------------------------
Function GetPersCode(_pNrec:comp)   :string;cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Pers where
          (( _pNrec == GP_SCUD_Pers.nrec ))<>tsok exit;
  Result:=GP_SCUD_Pers.Code;
} //Function GetPersCode(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить тип
//-----------------------------------------
Function GetPersType(_pNrec:comp)   :word;cacheable;
{ GetPersType:=0;
  if getfirst fastfirstrow GP_SCUD_Pers where
          (( _pNrec == GP_SCUD_Pers.nrec ))<>tsok exit;
  Result:=GP_SCUD_Pers.wType;

} //Function GetPersType(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetPersTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  0: Result:='сотрудники предприятия ';
  1: Result:='внешние подрядчики';
  2: Result:='прочие';
  end;
} //Function GetPersTypeName(_wType:word)   :string;cacheable;

//-----------------------------------------
// Получить наименование типа изменения данных
//-----------------------------------------
Function GetTypeHistName(_wType:word) :string; cacheable;
{ Result:='';
  case _wType of
  0: Result:='Создание записи';
  1..1000:
  { Result:='Кадры,приказ ';
    if getfirst TYPEPR=tsok
     Result:=Result+TYPEPR.NOPER

  }
  1001:  Result:='СКУД';
  1002:  Result:='Изменение';
  end;
} //Function GetTypeHistName(_wType:string) :string;

//-----------------------------------------
// Вставить значения в историю
//-----------------------------------------
Function Ins_GP_SCUD_Pers_SP(_wType_Hist:word;_cTitleDoc:comp=0;_cContDoc:comp=0;_Dt:date=ZeroDate) :boolean;
{
  var isNeedIns:boolean=false;
  if _Dt=ZeroDate then _Dt:=Cur_Date;
  isNeedIns:=getfirst GP_SCUD_Pers_Hist where
        ((GP_SCUD_Pers.Nrec == GP_SCUD_Pers_Hist.cGP_SCUD_Pers

       and _Dt == GP_SCUD_Pers_Hist.DTIZM(noindex)
       and _wType_Hist == GP_SCUD_Pers_Hist.wType(noindex)
       ))<>tsok;
  do
  {
    if not isNeedIns
    { if GP_SCUD_Pers_Hist.Fio            <> GP_SCUD_Pers.Fio// "Фио"
      or GP_SCUD_Pers_Hist.wType          <> _wType_Hist//"0 - собственные, 1 - сторонние "
      or GP_SCUD_Pers_Hist.cKatPodr       <> GP_SCUD_Pers.cKatPodr// "Подразделение"
      or GP_SCUD_Pers_Hist.cKatOrg        <> GP_SCUD_Pers.cKatOrg//  "Организация"
      //or GP_SCUD_Pers_Hist.cDocument      <> GP_SCUD_Pers.cDocument// "Документ"
      or GP_SCUD_Pers_Hist.Propusk_NMB    <> GP_SCUD_Pers.Propusk_NMB//    "Пропуск, номер"
      or GP_SCUD_Pers_Hist.Propusk_From   <> GP_SCUD_Pers.Propusk_From//       "Пропуск, действует с"
      or GP_SCUD_Pers_Hist.Propusk_To     <> GP_SCUD_Pers.Propusk_To//   "Пропуск, действует по"
      or GP_SCUD_Pers_Hist.Propusk_TB     <> GP_SCUD_Pers.Propusk_TB//   "Техника безопасности"
      or GP_SCUD_Pers_Hist.cKlRejim       <> GP_SCUD_Pers.cKlRejim//  "Режим"
      or GP_SCUD_Pers_Hist.cGP_SCUD_Kateg <> GP_SCUD_Pers.cGP_SCUD_Kateg//) "Категории сотрудников"
      or GP_SCUD_Pers_Hist.CGP_SCUD_GRUP  <> GP_SCUD_Pers.CGP_SCUD_GRUP// "Группа сотрудников"
      {} else break; //все совпало - прервем
    }
    if isNeedIns ClearBuffer(#GP_SCUD_Pers_Hist);

    GP_SCUD_Pers_Hist.Fio            := GP_SCUD_Pers.Fio;// "Фио"
    GP_SCUD_Pers_Hist.wType          := _wType_Hist;//"0 создание, 1- 1000 - приказы, 1001 Скуд"
    GP_SCUD_Pers_Hist.cKatPodr       := GP_SCUD_Pers.cKatPodr;// "Подразделение"
    GP_SCUD_Pers_Hist.cKatOrg        := GP_SCUD_Pers.cKatOrg;//  "Организация"
    GP_SCUD_Pers_Hist.cKlRejim       := GP_SCUD_Pers.cKlRejim;//  "Режим"
    GP_SCUD_Pers_Hist.DTIZM          := _Dt; //"Дата изменения"
    //GP_SCUD_Pers_Hist.cDocument      := GP_SCUD_Pers.cDocument;// "Документ"
    GP_SCUD_Pers_Hist.Propusk_NMB    := GP_SCUD_Pers.Propusk_NMB;//    "Пропуск, номер"
    GP_SCUD_Pers_Hist.Propusk_From   := GP_SCUD_Pers.Propusk_From;//       "Пропуск, действует с"
    GP_SCUD_Pers_Hist.Propusk_To     := GP_SCUD_Pers.Propusk_To;//   "Пропуск, действует по"
    GP_SCUD_Pers_Hist.Propusk_TB     := GP_SCUD_Pers.Propusk_TB;//   "Техника безопасности"
    GP_SCUD_Pers_Hist.cGP_SCUD_Kateg := GP_SCUD_Pers.cGP_SCUD_Kateg;//) "Категории сотрудников"
    GP_SCUD_Pers_Hist.CGP_SCUD_GRUP  := GP_SCUD_Pers.CGP_SCUD_GRUP;// "Группа сотрудников"
    if _cTitleDoc<>0
    { GP_SCUD_Pers_Hist.cTitleDoc:=_cTitleDoc;
      GP_SCUD_Pers_Hist.cContdoc :=_cContdoc;
      vSpr.pContDoc:=_cContdoc;
      // Закрываем пропуск
    }
    if isNeedIns
     insert current GP_SCUD_Pers_Hist
    else
     update current GP_SCUD_Pers_Hist;
  } while false;
  result:=true;
} //Function Ins_GP_SCUD_Pers_SP(_wType_Hist:word) :boolean;

//-----------------------------------------
// Вставить первоначальные значения
//-----------------------------------------
Function Ins_GP_SCUD_Pers(_wType:word;_wType_Hist:word; _cPers:comp;_cApp:comp;_cTitleDoc:comp=0;_cContDoc:comp=0) :boolean;
var isAllOk:boolean;
    isChange:boolean;
    ii:longint;
{ Result:=true;
  //if _Wtype<>0 EXit;//только сотрудников!
  var isNeedIns:boolean=false;
  isChange:=false;
  if Getfirst GP_SCUD_Pers where ((
       0 == GP_SCUD_Pers.wType(noindex)
   and  _cPers == GP_SCUD_Pers.cPersons ))<>tsok
  { isNeedIns:=True;
    ClearBuffer(#GP_SCUD_Pers);
    isChange:=true
  }

  if _wType=0
  { vSpr.pPersons:=_cPers;
    if vSpr.Getfirst Persons <>tsok then exit;
    // Если уволен и нет в скуде,то и не надо
    timelog('GP_SCUD_PersEdit->Ins_GP_SCUD_Pers:Persons.Fio='+vSpr.Persons.Fio+', isNeedIns='+string(isNeedIns));
    if vSpr.Persons.DisDate<>ZeroDate
    if vSpr.Persons.DisDate<sub_months(Cur_Date,2)
    { if isNeedIns=True //
      { ReReadRecord(#GP_SCUD_Pers);
        Exit
      }
    }
    if not  isChange
    { if GP_SCUD_Pers.Code    <>vSpr.Persons.StrTabn
      or GP_SCUD_Pers.Fio     <>vSpr.Persons.Fio
      or GP_SCUD_Pers.cKatPodr<>vSpr.Persons.GalDep
      or GP_SCUD_Pers.CGP_SCUD_KATEG=0
      or GP_SCUD_Pers.CGP_SCUD_GRUP=0
        isChange:=true

    }
    GP_SCUD_Pers.cPersons:=_cPers;
    GP_SCUD_Pers.Code:=vSpr.Persons.StrTabn;
    GP_SCUD_Pers.Fio :=vSpr.Persons.Fio;
    GP_SCUD_Pers.wType:=0;
    if  vSpr.Persons.DisDate<GP_SCUD_Pers.Propusk_To
    and vSpr.Persons.DisDate>ZeroDate
    { isChange:=true;
      GP_SCUD_Pers.Propusk_To:=vSpr.Persons.DisDate;
    }
    if vSpr.getfirst Passports=tsok
    { if GP_SCUD_Pers.Passp_NMB      <>trim(vSpr.Passports.SER+' '+vSpr.Passports.NMB)//│Паспорт серия +Паспорт номер
      or GP_SCUD_Pers.Passp_GivenBy  <>vSpr.Passports.GIVENBY   //│Паспорт: кем выдан
      or GP_SCUD_Pers.Passp_GivenDate<>vSpr.Passports.GIVENDATE //│Паспорт: дата выдачи
      or GP_SCUD_Pers.Passp_Podr     <>vSpr.Passports.GIVENPODR //│Паспорт: код подразделе
      //GP_SCUD_Pers. :=vSpr.Pessports.TODATE    //│Паспорт: срок действия
      or GP_SCUD_Pers.cTypeDoc       <>vSpr.Passports.DOCNAME
        isChange:=true;

      GP_SCUD_Pers.Passp_NMB      :=trim(vSpr.Passports.SER+' '+vSpr.Passports.NMB);//│Паспорт серия +Паспорт номер
      GP_SCUD_Pers.Passp_GivenBy  :=vSpr.Passports.GIVENBY   ;//│Паспорт: кем выдан
      GP_SCUD_Pers.Passp_GivenDate:=vSpr.Passports.GIVENDATE ;//│Паспорт: дата выдачи
      GP_SCUD_Pers.Passp_Podr     :=vSpr.Passports.GIVENPODR ;//│Паспорт: код подразделе
      //GP_SCUD_Pers. :=vSpr.Pessports.TODATE    //│Паспорт: срок действия
      GP_SCUD_Pers.cTypeDoc       :=vSpr.Passports.DOCNAME;

      //CREFGIVENBY │Ссылка на справочник: Кем выдан
    }
    //GP_SCUD_Pers.cKatPodr:=Persons.GalDep;
    GP_SCUD_Pers.cKatPodr:=GetKatPodrByCatalogs(Persons.Department);

    // ставим 5 категорию
    if GP_SCUD_Pers.CGP_SCUD_KATEG=0
      GP_SCUD_Pers.CGP_SCUD_KATEG:=iGP_SCUD_KategEdit.GetKategTypeNrec(5);
    // группу 1 - сотрудники
    if GP_SCUD_Pers.CGP_SCUD_GRUP=0
       GP_SCUD_Pers.CGP_SCUD_GRUP:=iGP_SCUD_GrupEdit.GetGrupTypeNrec(1);
  }
  //заполним информацию о режиме
  if _wType=0
  if _cApp>0
  { vSpr.pAppoint:=_cApp;
    if vSpr.GetFirst Appointments=tsok
    { if GP_SCUD_Pers.cKlRejim<>vSpr.Appointments.WorkRegime
        isChange:=true;
      GP_SCUD_Pers.cKlRejim:=vSpr.Appointments.WorkRegime;
    }
  } // if _wType=0
  timelog('GP_SCUD_PersEdit->Ins_GP_SCUD_Pers:Persons.Fio='+vSpr.Persons.Fio+', isChange='+string(isChange));

  if isNeedIns
  { Result:=Insert Current GP_SCUD_Pers=tsok;
  }
  else
  { if isChange
      Result:=Update Current GP_SCUD_Pers=tsok;

  }
  isAllOk:=true;
  var _Prefix:string= GetMemoPrefix(tnGP_SCUD_Pers);
  if _Prefix='TXT' or _Prefix=''
  if Getfirst Appendix=tsok
  { var _tmp_File:string;
    _tmp_File:=GetStringParameter('Files','OutputFilesDirectory',0)+'!temp.jpg';
    var _Prefix:string=GetMemoPrefix(tnAppendix);
    if _Prefix<>'' and _Prefix<>'TXT'
    { if fileExist(_tmp_File) deletefile(_tmp_File);
      if not fileExist(_tmp_File)
      { _Try
        { if _Prefix='AZM'
          { isAllOk:=false;
            var _Count:longint=GetPartMemoCount(Appendix.CONTENTS);
            for (ii := 0; ii < _Count; ii++)
            { /*
               N := GetPartMemoName(NOTES, P)
               S := GetPartMemoSize(NOTES, P)
               K := GetPartMemoComment(NOTES, P)
              */
              _Prefix:=GetPartMemoPrefix(Appendix.CONTENTS, ii);
              isAllOk:=ExportPartMemoToFile(Appendix.CONTENTS, ii, _tmp_File, false);
              break; // пока только 1.
            }
          } //if _Prefix='AZM'
          else
          { isAllOk:=ExportMemoToFile(Appendix.CONTENTS, _tmp_File, false);
          }
          if isAllOk
          { SetMemoPrefix(tnGP_SCUD_Pers,_Prefix);
            if ImportFileToMemo(GP_SCUD_Pers.LPHOTO, _tmp_File, false)
            { Update current GP_SCUD_Pers;
            }
          }
        }
        _except
        else
        {

        }
        _Finally
        { if fileExist(_tmp_File) deletefile(_tmp_File);
        }
      } //if not fileExist(_tmp_File)
    } //if _Prefix<>'' and _Prefix<>'TXT'
  } //if Getfirst Appendix=tsok

  //---------------------------
  if isChange Ins_GP_SCUD_Pers_SP(_wType_Hist,_cTitleDoc,_cContDoc);


} //Procedure Ins_GP_SCUD_Pers(_Num:word);

//-----------------------------------------
//   синхронизация справочника сотрудников
//-----------------------------------------
Procedure SyncAllPers;
{ ResetBounds(#Persons);
  timelog('GP_SCUD_PersEdit->SyncAllPers:START');
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm,
          'Создание справочника сотрудников СКУД', RecordsInTable(#Persons));
  _Loop fullcache Persons
  { if not NextVisual then break;
    timelog('GP_SCUD_PersEdit->SyncAllPers:Persons.FIO='+Persons.FIO+', ISEMPLOYEE='+Persons.ISEMPLOYEE);
    if Persons.ISEMPLOYEE<>'С' and Persons.ISEMPLOYEE<>'У' continue;
    Ins_GP_SCUD_Pers(0,0,Persons.Nrec,Persons.AppointCur)
  } //_Loop Persons
  SetBounds(#Persons);
  ReScanPanel(#GP_SCUD_Pers);
  StopVisual('',0);
  timelog('GP_SCUD_PersEdit->SyncAllPers:FINISH');
} //Procedure SyncAllPers;

#doc
    Создание/изменение буфера записи
#end
  Function MakeBufferPers(_pPersons:comp //ссылка на карточку
                         ;_pAppointments:comp   //дата изменения
                         ;_pTitleDoc:comp//ссылка на приказ
                         ;_pContDoc:comp
                         ;_TypeOper:word=0
                         ):boolean;
{ Result:=Ins_GP_SCUD_Pers(0,_TypeOper,_PPersons,_pAppointments,_pTitleDoc,_pContDoc);
} //Function MakeBufferPers

  Function DeleteBufferPers(_pPersons:comp //ссылка на карточку
                         ;_pAppointments:comp   //дата изменения
                         ;_pTitleDoc:comp//ссылка на приказ
                         ;_pContDoc:comp
                         ;_TypeOper:word=0
                         ):boolean;
  { #__UNUSED__(_pPersons,_pAppointments,_pTitleDoc,_pContDoc,_TypeOper)
    Result:=False;

    if _pPersons=0 then Exit;
    if _pContDoc=0 then Exit;
    if getfirst GP_Scud_Pers where (( _pPersons == GP_Scud_Pers.cPersons ))<>tsok then Exit;
    //нет приказа - не удаляем
    if getfirst GP_SCUD_Pers_Hist where
       ((GP_SCUD_Pers.Nrec == GP_SCUD_Pers_Hist.cGP_SCUD_Pers
       and _TypeOper   == GP_SCUD_Pers_Hist.wType(noindex)
       and _pTitleDoc  == GP_SCUD_Pers_Hist.cTitleDoc(noindex)
       and _pContdoc   == GP_SCUD_Pers_Hist.cContdoc(noindex)
       ))<>tsok then Exit;
    delete current GP_SCUD_Pers_Hist;
    if getLast GP_SCUD_Pers_Hist where (( GP_SCUD_Pers.Nrec == GP_SCUD_Pers_Hist.cGP_SCUD_Pers ))
      ordered by index GP_SCUD_PERS_HIST08 <>tsok then exit;
    GP_SCUD_Pers.Fio            := GP_SCUD_Pers_Hist.Fio;// "Фио"
    GP_SCUD_Pers.cKatPodr       := GP_SCUD_Pers_Hist.cKatPodr;// "Подразделение"
    GP_SCUD_Pers.cKlRejim       := GP_SCUD_Pers_Hist.cKlRejim;//  "Режим"
    update current GP_SCUD_Pers;
    Result:=True;
  } //DeleteBufferPers


