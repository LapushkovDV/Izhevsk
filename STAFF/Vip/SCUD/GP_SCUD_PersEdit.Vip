/*
создание роли администратора
SQL insert into GP_UserRoles (cRoleGroup,cUser,cRole)
  select
   GP_ROLEGROUPS.Nrec
  ,#COMP(2814749767106651)          //cUser:=UserId,
  ,GP_Roles.Nrec
From GP_ROLEGROUPS
inner join GP_Roles on GP_Roles.CROLEGROUP = GP_ROLEGROUPS.Nrec and GP_Roles.IsAdmin=GP_Roles.IsAdmin
where ('СКУД' = GP_ROLEGROUPS.NAME)
*/
/*
--- исправление первой записи
SQL update GP_SCUD_PERS_HIST Set GP_SCUD_PERS_HIST.DTIZM=Persons.AppDate,GP_SCUD_PERS_HIST.wType=1
FROm GP_SCUD_PERS_HIST inner join GP_SCUD_PERS on GP_SCUD_PERS.Nrec = GP_SCUD_PERS_Hist.cGP_SCUD_PERS
inner join Persons on Persons.Nrec =GP_SCUD_PERS.cPersons
where GP_SCUD_PERS_HIST.wType=0;
*/
#doc
Список людей в СКУД
История
1-999 - РПД
1001  - Пропуска из СКУД
1002  - Ручное изменение
#end
const
 coCommunMobilePhone = 000A000000039960h ;// мобильный телефон
 coAccesHistType  = 113; // константа для UNIDIC, тут историю храним доступа для 1 карточки
end;
//Интерфейс GP_Staff::SCUD_PersEdit не найден
Interface GP_SCUD_PersEdit 'Список людей в СКУД' , EscClose;
Show At (,,120,25);
//------------------------------------
// декларация сложного фильтра
//------------------------------------
function isFilterAnCorrect(ww_nrec:comp): boolean; forward;
//------------------------------------
#include GetKau.var
#include GP_SCUD_GrupEdit.Var
#include GP_SCUD_KategEdit.Var
//--------------------------------------------
var
//-------------------
  iGP_SCUD_EventsEdit :GP_SCUD_EventsEdit New;
  viCYPersons         : ChoiseYourPersons;
  iCatFunc            : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  pMarker:IMarker(Marker) new;
//-----------------------------------------
  NPOEM_OWN_SCUD_Pers_Other :boolean;//'Отображать сторонних лиц
//-----------------------------------------

  cRec    :Comp   ; // ссылка на группу
  Marker:longint;
  //-- пометка подразделения
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter, wFilter_A:word;
   Marker_Count :longint;
    wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;

   #mrkfld_(KatPodr)
   #mrkfld_(KatOrg)
   #mrkfld_(Persons)
   #mrkfld_(Kateg)


   sPassPorts_Flt,sPassPorts_Flt_A : string;
   sFio_Flt      ,sFio_Flt_A       : string;
   sPropusk_Flt  ,sPropusk_Flt_A   : string;
   wType_Flt     ,wType_Flt_A      : word;
   DTB,DTE:date;
   dDATOTCH   :date;// Дата начала расчетного периода в зарплате
   dDUvBeg,dDUvBeg_A :date;// 'Уволен после'
   dDUvEnd,dDUvEnd_A :date;// 'Уволен до'
   dDPRBeg,dDPRBeg_A :date;// 'Пропуск после'
   dDPREnd,dDPREnd_A :date;// 'Пропуск до'
//----------------------------------------
  iAdrFunc   : AddressFunc;           // Переменная типа интерфейс AddressFunc

  DataProtectorCard
  ,DataProtectorCardTel     :IGP_Protector2;//защита полей карточки от модификации
  boDataProtectorCard     :boolean = false; // признак загрузки DataProtector


Create View
var
   pPersons :comp;
   pKatPodr :comp;
   pKatOrg  :comp;
   pGP_SCUD_KATEG   :comp;
as select GP_SCUD_Pers.Nrec,GP_SCUD_Pers.cGP_SCUD_KATEG,
   if(isValidAll(tnAv_ALCO),if(Av_ALCO.vDouble = 1 , '+',''),'') (Fieldname = IsAlko)
 , if(isValidAll(tnAv_ALCO),Av_ALCO.vDouble  ,0) (Fieldname = IsAlkoDouble)
// , iAdrFunc.GetFullAddressInd(Persons.BornAddr ) (Fieldname =BornName); // адрес рождения
 , iAdrFunc.GetFullAddressInd(Persons.LiveAddr) (Fieldname = LivName ) // адрес проживания
// , iAdrFunc.GetFullAddressInd(Persons.PasspAddr ) (Fieldname =PasName ); // Адрес регистрации

From
  GP_SCUD_Pers(GP_SCUD_PERS02)
, GP_SCUD_Pers_Hist(GP_SCUD_Pers_Hist08) // cGP_SCUD_Pers+Fio+DTIZM+wType,GP_SCUD_Pers_Hist02
, Persons
, KatOrg
, Katpodr
, KLREJIM
, KatPodr KatPodr_Hist
, KatOrg  KatOrg_Hist
, TYPEPR
, Appendix
, GP_SCUD_KATEG
, Appointments
, Catalogs CatPost
//------- фильтры
 , KatPodr    KatPodr_Flt
 , KatOrg     KatOrg_Flt
 , Persons    Persons_Flt
 , GP_SCUD_KATEG GP_SCUD_KATEG_Flt
 , AttrNam AN_Alco
 , AttrVal AV_Alco
 //sindetskiy_aa
 ,Communications          // Телефоны
// ,em_unidic accessHistory

where ((
    GP_SCUD_Pers.cPersons == Persons.Nrec
and GP_SCUD_Pers.cKatPodr == Katpodr.Nrec
and GP_SCUD_Pers.cKatOrg  == KatOrg.Nrec
and GP_SCUD_Pers.CKLREJIM == KLREJIM.NRec
and GP_SCUD_Pers.CGP_SCUD_KATEG == GP_SCUD_KATEG.Nrec
and GP_SCUD_Pers.Nrec     == GP_SCUD_Pers_Hist.cGP_SCUD_Pers
and GP_SCUD_Pers_Hist.cKatPodr == KatPodr_Hist.Nrec
and GP_SCUD_Pers_Hist.cKatOrg  == KatOrg_Hist.Nrec
and GP_SCUD_Pers_Hist.wType    == TYPEPR.CodOper //тип приказа
and 31557 == AN_Alco.wTable
and 'Продуваться на алкорамке' == AN_Alco.name
and AN_Alco.wTable == Av_ALCO.wTable
and GP_SCUD_Pers.Nrec == Av_ALCO.cRec
and AN_Alco.Nrec == Av_ALCO.cattrNam


//---------------- Данные из картотеки сотрудников
and if(Persons.AppointCur=0,Persons.AppointLast,Persons.AppointCur) == Appointments.Nrec
and Appointments.Post == CatPost.Nrec
//---------------- Фотография
and 1               == Appendix.ObjBlock
and Persons.Nrec    == Appendix.Person
and    200          == Appendix.ObjType
//------- фильтры
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == KatOrg_Flt.Nrec
and wc_nrec == Persons_Flt.Nrec
and wc_nrec == GP_SCUD_KATEG_Flt.Nrec

//sindetskiy
and    Persons.nrec        == Communications.Person // Телефоны
and coCommunMobilePhone == Communications.ComType // мобильный телефон
//and               coAccesHistType  == accessHistory.wtype (noindex) //Таблица истории
//and GP_SCUD_Pers.nrec == accessHistory.addcomp[1] (noindex)
))
Bounds BySCUD_Kateg pGP_SCUD_KATEG == GP_SCUD_Pers.cGP_SCUD_KATEG(noindex) ordered by TableOrder
Bounds byPersons pPersons == GP_SCUD_Pers.cPersons(noindex) ordered by TableOrder
Bounds byKatOrg  pKatOrg  == GP_SCUD_Pers.cKatOrg (noindex) ordered by TableOrder
Bounds byKatPodr pKatPodr == GP_SCUD_Pers.cKatPodr(noindex) ordered by TableOrder
Bounds byType    wType_Flt== GP_SCUD_Pers.wType   (noindex) ordered by TableOrder
Bounds byDPRBeg  dDPRBeg_A <<=GP_SCUD_Pers.Propusk_To(NoIndex)  ordered by TableOrder
Bounds byDPREND  dDPREnd_A >>=GP_SCUD_Pers.Propusk_To(NoIndex)
             and ZeroDate  << GP_SCUD_Pers.Propusk_To(NoIndex)  ordered by TableOrder

condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_Pers.Nrec))
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
, pKatPodr
#doc
 фильтр по подразделению
#end
;
//*************************************************8
create view vSpr
var
  pPersons:comp;
  pAppoint:comp;
  pContDoc:comp;
as select Persons.Nrec
From Persons,Passports,ContDoc,PartDoc
where ((
     pPersons == Persons.Nrec
and  Persons.PasspRus == Passports.nrec
and  pAppoint      == Appointments.Nrec
and  pContDoc      == ContDoc.nrec
and  ContDoc.cPart == PartDoc.Nrec
));
