QuickChoice qcByCode
{
  AcceptField = GP_SCUD_Pers.Nrec;
  ViewField = GP_SCUD_Pers.Code;
  ViewField = GP_SCUD_Pers.Fio;
  // только текстовый поля!
  SearchField = GP_SCUD_Pers.Code;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Pers.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_Pers.Nrec;
  ViewField = GP_SCUD_Pers.Fio;
  ViewField = GP_SCUD_Pers.Code;
  // только текстовый поля!
  SearchField = GP_SCUD_Pers.Fio;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Pers.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName

