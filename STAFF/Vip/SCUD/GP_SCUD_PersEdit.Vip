//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { timelog_init;
      LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      dDATOTCH:=dGetTune('UP.DATOTCH');
      SetFilterBounds(0);
      SetFilterNm;
      if cRec=0
      { if Marker<>0
        { GetMarker(Marker,0,cRec)
        }
      }
      if cRec>0
      { if getfirst GP_SCUD_Pers where (( cRec == GP_SCUD_Pers.nrec ))=tsok {}
      }
      if pr_CurUserAdmin
      { if RecordsInTable(#GP_SCUD_Pers)=0
          SyncAllPers
      }
      ReScanPanel(#GP_SCUD_Pers);
      if (wIntMode and cgiMultiEdit)>0
      { RunWindowModal(wnEditPers);
        CloseInterface(cmDone);
        exit;

      }
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }

    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
/* lapus
      if DataProtectorCard<>NullRef
      { FreeVipInterface(DataProtectorCard);
      }
*/
      SaveParam;
    }
    //-----------------------------
    cmOnVipUnLoad:
    {
     UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Pers.Nrec;
        }
        CloseInterface(cmDefault)
      }
      else Putcommand(cmEdit);
    }
    cmEdit:
    {
      if GetCurrentFormat=brScudPers
         RunWindow(wnEditPers);
       else
       if GetCurrentFormat=brPersHist
         RunWindow(wnEditPersHist);

    }
    cmExprFieldChanged :
    {
      case CurField of
      #IsAlkoDouble:
       {
        doSetAttr(31557,GP_SCUD_Pers.nrec,'Продуваться на алкорамке', ExprFieldValue)
       }
      #extBDate:
      {
        if(StrToDate(ExprFieldValue, 'DD/MM/YYYY') <> ZeroDate){
          dSetAttr(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.Дата рождения', StrToDate(ExprFieldValue, 'DD/MM/YYYY'))
        }else{
          ExtAttr_DeleteValue(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.Дата рождения');
        }
      }
      #extVacBeg:
      {
        if(StrToDate(ExprFieldValue, 'DD/MM/YYYY') <> ZeroDate){
          dSetAttr(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.Отпуск. Начало', StrToDate(ExprFieldValue, 'DD/MM/YYYY'))
        }else{
          ExtAttr_DeleteValue(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.Отпуск. Начало');
        }
      }
      #extVacEnd:
      {
        if(StrToDate(ExprFieldValue, 'DD/MM/YYYY') <> ZeroDate){
          dSetAttr(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.Отпуск. Окончание', StrToDate(ExprFieldValue, 'DD/MM/YYYY'))
        }else{
          ExtAttr_DeleteValue(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.Отпуск. Окончание');
        }
      }
      end;
      rereadrecord(#GP_SCUD_Pers);
    }
    cmCheckField:
    { case CurField of
      #GP_SCUD_Pers.wType:
      { if GP_SCUD_Pers.wType=1
        { if GP_SCUD_Pers.cPersons<>0
          { Message('Запись связана с картотекой!'
              +chr(13)+'Изменение типа записи запрещено!');
            set GP_SCUD_Pers.wType:=0;
          }
        }
      }
      #extMail:
      { var ww_str:string = GetViewerData();
        if(ww_str <> ''){
          sSetAttr(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.E-mail', ww_str)
        }else{
          ExtAttr_DeleteValue(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.E-mail');
        }
      }
      #extPhone:
      {
        var ww_str:string = GetViewerData();
        if(ww_str <> ''){
          sSetAttr(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.Телефон', ww_str)
        }else{
          ExtAttr_DeleteValue(coGP_SCUD_PERS, GP_SCUD_Pers.nrec, 'Подрядчик.Телефон');
        }
      }
      end;
    }
    //----------------------
    cmPick:
    { if IsProtect
      { Abort;
        Exit;
      }
      case CurField of
      #KatPodr.Name:
      { if GP_SCUD_Pers.wType=1
        {
          set GP_SCUD_Pers.cKatPodr := 000A00000002954Dh; // Внешние подрядчики
          //message('Запись связана с организацией, изменение запрещено' ) ;
          //exit;
        }
        else
        {
          pTmp:= GP_SCUD_Pers.cKatPodr;
          If (iGetKau.GetCodeKau(cgiPick,cgKau_KatPodr,pTmp) <> 0)
          { set GP_SCUD_Pers.cKatPodr:=pTmp;
         }
        }
      }
      #KatOrg.Name:
      { if GP_SCUD_Pers.wType=0
        { message('Запись связана с картотекой сотрудников, изменение запрещено' ) ;
          exit;
        }
        pTmp:= GP_SCUD_Pers.cKatOrg;
        If (iGetKau.GetCodeKau(cgiPick,cgKau_KatOrg,pTmp) <> 0)
        { if GP_SCUD_Pers.cKatpodr=0
          { set GP_SCUD_Pers.cKatPodr:=GetKatPodrByName('Подрядчики');
          }
          set GP_SCUD_Pers.cKatOrg:=pTmp;
        } //If (iGetKau.GetCodeKau(cgiPick,cgKau_KatOrg,pTmp) <> 0)
      } //#KatOrg.Name:
      #Kateg:
      { pTmp:=GP_SCUD_Pers.CGP_SCUD_KATEG;
        if RunInterface(GP_SCUD_KATEGEdit,cgiPick,pTmp,0)<>cmCancel
        { set GP_SCUD_Pers.CGP_SCUD_KATEG:=pTmp
        }
      }
      #Grup:
      { pTmp:=GP_SCUD_Pers.CGP_SCUD_GRUP;
        if RunInterface(GP_SCUD_GRUPEdit,cgiPick,pTmp,0)<>cmCancel
        { set GP_SCUD_Pers.CGP_SCUD_GRUP:=pTmp
        }
      }
      #Kateg_hist:
      { pTmp:=GP_SCUD_Pers_Hist.CGP_SCUD_KATEG;
        if RunInterface(GP_SCUD_KATEGEdit,cgiPick,pTmp,0)<>cmCancel
        { set GP_SCUD_Pers_Hist.CGP_SCUD_KATEG:=pTmp
        }
      }
      #Grup_hist:
      { pTmp:=GP_SCUD_Pers_Hist.CGP_SCUD_GRUP;
        if RunInterface(GP_SCUD_GRUPEdit,cgiPick,pTmp,0)<>cmCancel
        { set GP_SCUD_Pers_Hist.CGP_SCUD_GRUP:=pTmp
        }
      }
      #KLREJIM.NRejim: //'Режим'
      { var wTmp:word;
        wTmp := KLREJIM.Rejim;
        if ( RunInterface('PickRej', wTmp) <> cmCancel )
        if ( getfirst KLREJIM where (( wTmp == KLREJIM.Rejim)) = tsOk )
        { pTmp:= KLREJIM.Nrec;
          set GP_SCUD_Pers.cKlRejim:=KLREJIM.Nrec;
        }
      }
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,1);
        }
      }
      //------------------------------
      #Filtr_KatOrg:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_KatOrg);
        StoreMarker(Marker_KatOrg,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_KatOrg,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_KatOrg,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_KatOrg);
          BitOnW(wFilter,2);
        }
      }
      //------------------------------
      #Filtr_Persons:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Persons);
        StoreMarker(Marker_Persons,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Persons,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_Persons,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_Persons);
          BitOnW(wFilter,3);
        }
      }
      #Filtr_Kateg:
      { pTmp:=GP_SCUD_Pers.CGP_SCUD_KATEG;
        if RunInterface(GP_SCUD_KATEGEdit,cgiPickMult,pTmp,Marker_Kateg)<>cmCancel
        { SetFilterNm(#Filtr_Kateg);
          BitOnW(wFilter,10);
        }
      }
      end;
      ReScanPanel(#GP_SCUD_PERS);
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,1);
        SetFilterNm(#Filtr_KatPodr);
      }
      //------------------------------
      #Filtr_KatOrg:
      { ClearMarker(Marker_KatOrg);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatOrg);
      }
      //------------------------------
      #Filtr_Persons:
      { ClearMarker(Marker_Persons);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_Persons);
      }
      #Filtr_Kateg:
      { ClearMarker(Marker_Kateg);
        SetFilterNm(#Filtr_Kateg);
        BitOffW(wFilter,10);
      }
      end;
    }

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Pers: RunInterface('ExClassifier', coGP_SCUD_Pers, GP_SCUD_Pers.nRec);
      end;
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(0);
      }
      else RestFromA
    }
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Pers: RunInterface('Attribute', coGP_SCUD_Pers, GP_SCUD_Pers.nRec);
      end;
    }
    cmValue1:
    { if not UserAccessService.CanEdit(pStatus_GetDefault)
      { Message('У вас нет прав для запуска расчета сальдо');
        exit;

      }
      SyncAllPers
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #GP_SCUD_Pers:
      { //ProcessCommand(RunMenu('GP_SCUD_PersEdit_Main_HotKey'));
        PutCommand(RunMenu('GP_SCUD_PersEdit_Main_HotKey'));
      }
      end;
    }
  end;
end.

GP_SCUD_PersEdit_Main_HotKey Menu
{
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Синхронизация с картотекой сотрудников'    , cmValue1   , 'Обновить', hcProc_NagrKaf, ,, scMenuCtx;
-------------------;
- 'Внешняя классификация', cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
- 'Внешние атрибуты'     , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}
