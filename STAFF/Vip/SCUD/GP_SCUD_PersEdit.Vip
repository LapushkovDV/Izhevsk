//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------

procedure SetEditMode(Value: boolean);
{
  LoadProtectorCard;

  inherited::SetEditMode(Value);

  if bogettune('NPOEM_OWN.SCUD.CanEditFirstKartocha')
  {
   DataProtectorCard.SetProtected(False);
   DataProtectorCardTel.SetProtected(False);
  }
  else{
    DataProtectorCard.SetProtected(True);
    DataProtectorCardTel.SetProtected(True);
  }
}

Procedure LoadInterface(_boVisibleRun:boolean);
{  inherited ::LoadInterface(_boVisibleRun);
   isFilterRun:=false;
   ReadParam;
   NPOEM_OWN_SCUD_Pers_Other :=boGetTune('NPOEM_OWN.SCUD.Pers_Other');//'Отображать сторонних лиц
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_PersdEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;
      ReadParam;
      if pKatPodr>0
      { wFilter:=0;
        ClearMarker(Marker_KatPodr);
        InsertMarker(Marker_KatPodr,pKatPodr);
        BitOnW(wFilter,1)
      }
      if wIntMode <> 0
      {
        SetEditMode(false);
      }
      else
      {
        SetEditMode(True)
      }
} //Procedure LoadInterface(_wRunType:word);



//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Pers;

cmSetDefault:
{ if isFilterRun Exit;
  if not CanEdittbl then Exit;
  ClearBuffer(#GP_SCUD_Pers);
  GP_SCUD_Pers.wType:=1;
  set GP_SCUD_Pers.cKatPodr:=GetKatPodrByName('Подрядчики');
  SelectField(#katorg.name);
  SetEditMode(true);
  PutCommand(cmEdit);

}
cmInsertRecord:
{ if not CanEdittbl
  { Message('Добавление записи запрещено');
    Exit;
  }
  Insert Current GP_SCUD_Pers;
  Ins_GP_SCUD_Pers_SP(1002);
}
cmUpdateRecord:
{ if not CanEdittbl
  { Message('Изменение записи запрещено');
    Exit;
  }
  Update Current GP_SCUD_Pers;
  Ins_GP_SCUD_Pers_SP(1002);
}
cmDeleteRecord:
{ message('Удаление запрещено!');
  exit;
  //delete GP_SCUD_Pers_Hist where ((  GP_SCUD_Pers.Nrec     == GP_SCUD_Pers_Hist.cGP_SCUD_Pers));
  //delete Current GP_SCUD_Pers;
}
cmPositionChanged:
{ PositionChanged;
}
end; //GP_SCUD_Pers

TableEvent table GP_SCUD_Pers_Hist;
cmSetDefault:
{ exit;
}
cmInsert:
{ Ins_GP_SCUD_Pers_SP(1002);
  PutCommand(cmEdit);
  abort;
}
cmInsertRecord:
{
if not CanEdittbl
  { Message('Добавление записи запрещено');
    Exit;
  }
  Insert Current GP_SCUD_Pers_Hist;

}
cmUpdateRecord:
{ Update Current GP_SCUD_Pers_Hist;
}
cmDeleteRecord:
{ message('Удаление запрещено!');
  exit;
  //delete Current GP_SCUD_Pers_hist;
}
end; //GP_SCUD_Pers_hist


TableEvent table Communications;
 cmSetDefault: {
   ClearBuffer(tnCommunications);
//   Communications.comtype = coCommunMobilePhone;
 }
 cmInsertRecord:{
   Insert Current Communications;
 }
 cmUpdateRecord:{
   Update Current Communications;
 }
 cmDeleteRecord:{
   Delete Current Communications;
 }
end;

