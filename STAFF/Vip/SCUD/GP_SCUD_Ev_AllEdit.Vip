#include GP_SCUD_KategEdit.Var
//--------------------------------------------
var
  cRec    :Comp   ; // ссылка на группу
  pMarker:IMarker(Marker) new;
  Marker:longint;
  iCatFunc            : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  //---- статусы
  pStatus_DM: Array [1..4] of comp;
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
    wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;

   #mrkfld_(KatPodr)
   #mrkfld_(KatOrg)
   #mrkfld_(GP_SCUD_Pers)


   sFio_Flt      ,sFio_Flt_A       : string;
   sPropusk_Flt  ,sPropusk_Flt_A   : string;
   wType_Flt     ,wType_Flt_A      : word;
//----------------------------------------
Create View
var
   pGP_SCUD_Pers :comp;
   pGP_SCUD_Pers_Prev:comp;
   pKatOrg :comp;
   pKatPodr :comp;
   DTB,DTE,DTB_A,DTE_A:date;
   TMB,TME,TMB_A,TME_A:time;

as select GP_SCUD_Ev_All.Nrec
,if(isValid(tnGP_SCUD_EVENTS),'*','-') (Fieldname=EV_EXIST,FieldTitle='Есть в основных событиях')
From
  GP_SCUD_Ev_All
, GP_SCUD_Events
, GP_SCUD_Pers
, KatOrg
, Katpodr
//------- фильтры
 , KatPodr    KatPodr_Flt
 , KatOrg     KatOrg_Flt
 , GP_SCUD_Pers    GP_SCUD_Pers_Flt

where ((
      DTB_A <<= GP_SCUD_Ev_All.EnterDate
and   DTE_A >>= GP_SCUD_Ev_All.EnterDate
and ((DTB_A < GP_SCUD_Ev_All.EnterDate
      or  TMB_A<= GP_SCUD_Ev_All.EnterTime)
     and (DTE_A > GP_SCUD_Ev_All.EnterDate
          or  TME_A>= GP_SCUD_Ev_All.EnterTime or TME_A=ZeroTime)
   )
and GP_SCUD_Ev_All.cGP_SCUD_Pers == GP_SCUD_Pers.Nrec
and GP_SCUD_Pers.cGp_Scud_Kateg == Gp_Scud_Kateg.Nrec
and GP_SCUD_Ev_All.cKatPodr == Katpodr.Nrec
and GP_SCUD_Ev_All.cArea == GP_SCUD_AREAS.Nrec // копия таблицы из скуда
//and GP_SCUD_Ev_All.cKatOrg  == KatOrg.Nrec
and GP_SCUD_Ev_All.cStatus  == GP_Status.Nrec
and GP_SCUD_Ev_All.cControler  == GP_SCUD_Controler.Nrec
//and GP_SCUD_Ev_All.SNPP == GP_SCUD_Events.SNPP
and GP_SCUD_Ev_All.cGP_SCUD_Pers == GP_SCUD_Events.cGP_SCUD_Pers
and GP_SCUD_Ev_All.wSystem == GP_SCUD_Events.wSystem
and GP_SCUD_Ev_All.SNPP == GP_SCUD_Events.SNPP
))
Bounds byGP_SCUD_Pers  pGP_SCUD_Pers == GP_SCUD_Ev_All.cGP_SCUD_Pers(noindex) ordered by TableOrder
//Bounds byGP_SCUD_PersM pGP_SCUD_Pers == GP_SCUD_PERS.Nrec

//Bounds byKatOrg  pKatOrg  == GP_SCUD_Ev_All.cKatOrg (noindex) ordered by TableOrder
Bounds byKatPodr pKatPodr == GP_SCUD_Ev_All.cKatPodr(noindex) ordered by TableOrder
//Bounds byType    wType_Flt== GP_SCUD_Ev_All.wType   (noindex) ordered by TableOrder
Bounds ByPers pGP_SCUD_Pers == GP_SCUD_Ev_All.cGP_SCUD_Pers
    and  DTB_A <<= GP_SCUD_Ev_All.EnterDate
and   DTE_A >>= GP_SCUD_Ev_All.EnterDate
and ((DTB_A < GP_SCUD_Ev_All.EnterDate
      or  TMB_A<= GP_SCUD_Ev_All.EnterTime)
     and (DTE_A > GP_SCUD_Ev_All.EnterDate
          or  TME_A>= GP_SCUD_Ev_All.EnterTime or TME_A=ZeroTime)
   )

condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_Ev_All.Nrec))
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;


