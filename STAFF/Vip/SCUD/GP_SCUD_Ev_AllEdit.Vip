//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
var ii:word;
    _Status:string;
    ww_mes:string;
{  inherited ::LoadInterface(_boVisibleRun);
   DisableCommand(cmDelete);
   ww_mes:='';
   ReadParam;
   for(ii:=1;ii<=4;ii++)
   { case ii of
     01: _Status:='СКУД';
     02: _Status:='СКУД, корректировка';
     03: _Status:='Добавлен вручную';
     04: _Status:='Исключено из учета';
     end;
     pStatus_DM[ii]:=Status.GetByName(_Status);
     if pStatus_DM[ii]=0
     { ww_mes:=ww_mes+chr(13)+string(ii)+','+_Status
     }
   }
   if ww_mes<>'' and wIntMode=0
   { message('Нет статусов к событиям '+ww_mes);
   }
   //---------------------------------
      if boVisibleRun
      { if True //(wIntMode and cgiPickMult)=cgiPickMult
        { DataProtector.ProtectedStatusCtx := sci1EscIns;
          pMarker.AutoSave := True;
          pMarker.LoadAuto := True;
          pMarker.StoreName := 'GP_SCUD_Ev_AllEditdEdit';
          pMarker.Caption   := (' Отмечено [%d] ');
        }
      }
      else  pMarker.Disable:=true;

      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
   isFilterRun:=false;
} //Procedure LoadInterface(_wRunType:word);

//------------------------------------
// скопировать в основные события
//------------------------------------
Procedure CopyEvents2OSN;
{
      if not pr_CurUserAdmin
      { message('Режим доступен только Администратору базы');
        exit;
      }
      if getfirst GP_SCUD_EVENTS=tsok
      { message('Событие уже есть в "основных"');
        exit;
      }
      if  message('Скопировать Событие  в "основных"',YesNo)<>cmYes
      {  exit;
      }
      Clearbuffer(#GP_SCUD_EVENTS);
      GP_SCUD_EVENTS.NPP           :=GP_SCUD_EV_ALL.NPP          ;//Порядковый Номер
      GP_SCUD_EVENTS.STRTABN       :=GP_SCUD_EV_ALL.STRTABN      ;//Порядковый Номер
      GP_SCUD_EVENTS.NAME          :=GP_SCUD_EV_ALL.NAME         ;//Сотрудник посетитель
      GP_SCUD_EVENTS.CGP_SCUD_PERS :=GP_SCUD_EV_ALL.CGP_SCUD_PERS;//Ссылка на справочник людей
      GP_SCUD_EVENTS.ENTERDATE     :=GP_SCUD_EV_ALL.ENTERDATE    ;//Дата входа
      GP_SCUD_EVENTS.ENTERTIME     :=GP_SCUD_EV_ALL.ENTERTIME    ;//Fhtvd выхода
      GP_SCUD_EVENTS.CARD          :=GP_SCUD_EV_ALL.CARD         ;//Карта
      GP_SCUD_EVENTS.CKATPODR      :=GP_SCUD_EV_ALL.CKATPODR     ;//Подразделение
      GP_SCUD_EVENTS.WEVENTS_TYPE  :=0;//GP_SCUD_EV_ALL.WEVENTS_TYPE ;//Тип события
      GP_SCUD_EVENTS.WRESOURCE     :=GP_SCUD_EV_ALL.WRESOURCE    ;//Тип ресурса устройства
      GP_SCUD_EVENTS.CSTATUS       :=GP_SCUD_EV_ALL.CSTATUS      ;//Статус
      GP_SCUD_EVENTS.CCONTROLER    :=GP_SCUD_EV_ALL.CCONTROLER   ;//Контролер
      GP_SCUD_EVENTS.CAREA         :=GP_SCUD_EV_ALL.CAREA        ;//Ареал
      GP_SCUD_EVENTS.SNPP          :=GP_SCUD_EV_ALL.SNPP         ;//Порядковый Номер
      GP_SCUD_EVENTS.wSystem       :=GP_SCUD_EV_ALL.wSystem      ;//Порядковый Номер
      insert current GP_SCUD_EVENTS;
} //Procedure CopyEvents2OSN;


