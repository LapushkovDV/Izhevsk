 //-----------------------------------------
//   Проинициализровать данные
//-----------------------------------------
Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _cNrec     : comp;  // ссылка на "Ведомость"
  _cGP_SCUD_Pers  : comp;   // выбранная запись
  _cKatpodr  : comp;   // выбранная запись
  _cKatOrg   : longint; // включить определенные форматы
  _DTB       : Date; //период просмотра
  _DTE       : Date; //период просмотра
  _NoVisual  : boolean=false //не перерисовывать экраны
  ) : boolean;
{ #__UNUSED__(_wIntMode,_cNrec,_cGP_SCUD_Pers,_cKatpodr,_cKatOrg,_DTB,_DTE,_NoVisual)
  Result:=False;
  isFilterRun:=true;
  if _DTB<>ZeroDate
  { DTB:=_DTB;
  }
  if _DTE<>ZeroDate
  { DTE:=_DTE;
  }
  set wIntMode:=_wIntMode;
  if DTB=ZeroDate DTB:=Date(1,1,year(cur_date)-1);
  if DTE=ZeroDate DTE:=Date(31,12,year(cur_date));
  TME:=Time(24,0,0,0);
  TMB:=Time(0,0,0,0);
  DTB_A:=DTB;
  DTE_A:=DTE;
  TME_A:=TME;
  TMB_A:=TMB;
  timelog('GP_SCUD_Ev_AllEdit->InitParam:_cGP_SCUD_Pers='+string(_cGP_SCUD_Pers,0,0));
  if _cGP_SCUD_Pers<>0
  { pGP_SCUD_Pers_Prev:=pGP_SCUD_Pers;
    set pGP_SCUD_Pers:=_cGP_SCUD_Pers;
    if not BoundActive(tbByPers) PushBounds(tbByPers);
    ReReadRecord(#GP_SCUD_Ev_All) ;
    if pGP_SCUD_Pers_Prev<>pGP_SCUD_Pers
    { if getlast GP_SCUD_Ev_All<>tsok {}

    }
  }
  else
  if _cNrec>0
  { if getfirst GP_SCUD_Ev_All where (( _cNrec == GP_SCUD_Ev_All.Nrec)) <>tsok
    { Exit; }
    PositionChanged;
  }
  else
  if _cKatOrg<>0
  {

  }
  else
  if _cKatpodr<>0
  { set pKatPodr:=_cKatPodr;
    if not BoundActive(tbByKatPodr) PushBounds(tbByKatPodr);

  }
  PositionChanged;
  isFilterRun:=false;
  if (_wIntMode and cgiMultiEdit)>0
  { if _Cnrec>0
      RunWindowModal(wnEditEvents)
    else
      RunWindowModal(wnEventsPers)
  }

  Result:=True;
} //Function InitParam(



//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Ev_All ;
cmSetDefault:
{ Exit;
}
cmInsert:
{ exit;
  Abort;
  if (wIntMode and cgiNotEdit)>0 exit;
  if isFilterRun exit;
  Abort;
}
cmInsertRecord:
{ RereadRecord(#GP_SCUD_Ev_All);
  exit;
}
cmUpdateRecord:
{ RereadRecord(#GP_SCUD_Ev_All);
  exit;
}
cmDeleteRecord:
{ Exit;
  abort;
}
cmPositionChanged:
{ PositionChanged;
}
end; //GP_SCUD_Ev_AllEdit


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      SetFilterBounds(0);
      if cRec>0
      { if getfirst GP_SCUD_Ev_All where (( cRec == GP_SCUD_Ev_All.nrec ))=tsok {}
      }

      ReScanPanel(#GP_SCUD_Ev_All);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }

    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
      SaveParam;
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
      SaveParam;
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Ev_All.Nrec;
        }
        CloseInterface(cmDefault)
      }
      else Putcommand(cmEdit);
    }
    //----------------------
    cmEdit:
    {  if GetCurrentFormat=brScudEvents
       or GetCurrentFormat=brEventsPers
       or GetCurrentFormat=brEventsPers01
         RunWindow(wnEditEvents);
    }
    cmCheckField:
    { case CurField of
      #DTB,#DTE,#TMB,#TME:
      { if GetCurrentFormat<>scrFilter
        { CopyToA;
          ReReadRecord(#GP_SCUD_Ev_All);
        }
      }
      end;
    }
    //----------------------
    cmPick:
    { if IsProtect
      { Abort;
        Exit;
      }
      case CurField of
      //------------------------------
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,1);
        }
      }
      //------------------------------
      #Filtr_KatOrg:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_KatOrg);
        StoreMarker(Marker_KatOrg,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_KatOrg,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_KatOrg,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_KatOrg);
          BitOnW(wFilter,2);
        }
      }
      //------------------------------
      #Filtr_GP_SCUD_Pers:
      { if RunInterFace(GP_SCUD_PersVib,cgiPickMult,pTmp,Marker_GP_SCUD_PERS)<>cmCancel
        { SetFilterNm(#Filtr_GP_SCUD_PERS);
          BitOnW(wFilter,2);
        }

      }
      end;
      ReScanPanel(#GP_SCUD_Ev_All);
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,1);
        SetFilterNm(#Filtr_KatPodr);
      }
      //------------------------------
      #Filtr_KatOrg:
      { ClearMarker(Marker_KatOrg);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatOrg);
      }
      //------------------------------
      #Filtr_GP_SCUD_Pers:
      { ClearMarker(Marker_GP_SCUD_Pers);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_GP_SCUD_Pers);
      }
      end;
    }

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Ev_All: RunInterface('ExClassifier', coGP_SCUD_Ev_All, GP_SCUD_Ev_All.nRec);
      end;
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(0);
      }
      else RestFromA
    }
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Ev_All: RunInterface('Attribute', coGP_SCUD_Ev_All, GP_SCUD_Ev_All.nRec);
      end;
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #GP_SCUD_Ev_All:
      { PutHotCommand(RunMenu('GP_SCUD_Ev_AllEdit_Main_HotKey'));
      }
      end;
    }
    cmValue1:
    { CopyEvents2OSN;
    }
  end;
end.

GP_SCUD_Ev_AllEdit_Main_HotKey Menu
{
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Внешняя классификация', cmPickClass , 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
- 'Внешние атрибуты'     , cmPickAttr  , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;
- 'Скопировать в основные события'     , cmValue1  , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}
GP_SCUD_Ev_AllEdit_Main_HotKey_E Menu
{
- 'Скопировать в основные события'     , cmValue1  , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;
}
