#declare wnEventsPers  (wn_name)
Window wn#(wn_name) (,,sci1Esc);
Screen scr#(wn_name) ;
Show at (,,,2);
Table GP_SCUD_Ev_All;
Fields
  DTB : NoProtect;
  TMB : NoProtect;
  DTE : NoProtect;
  TME : NoProtect;
<<
 Период c.@@@@@@@@@@.@@@@@ по.@@@@@@@@@@.@@@@@
>>
