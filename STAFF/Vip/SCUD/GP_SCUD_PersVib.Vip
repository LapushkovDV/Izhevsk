Function GetTypeDoc:word;
{ Result:=GP_iSC_list_Of_Employees;//1003; //
}

//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{  inherited ::LoadInterface(_boVisibleRun);
   ReadParam;
   NPOEM_OWN_SCUD_Pers_Other :=boGetTune('NPOEM_OWN.SCUD.Pers_Other');//'Отображать сторонних лиц

      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_PersdEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;
      ReadParam;
      if Marker_Podr>0
      { wFilter:=0;
        ClearMarker(Marker_KatPodr);
        CopyMarker(Marker_KatPodr,Marker_Podr);
        if GetMarkerCount(Marker_Podr)>0
           BitOnW(wFilter,1)
      }
      else
      if pKatPodr>0
      { wFilter:=0;
        ClearMarker(Marker_KatPodr);
        InsertMarker(Marker_KatPodr,pKatPodr);
        BitOnW(wFilter,1);
      }
      BitOnW(wFilter,11);
      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
   isFilterRun:=false;
} //Procedure LoadInterface(_wRunType:word);


//---------------------------------------------
// получить наименование
//---------------------------------------------
Function GetPodrOrgName(_pNrec:comp):string;
{ #__UNUSED__(_pNrec)
  Result:='';
  if GP_SCUD_Pers.wType=0
  { if isValid(#KatPodr)
      Result:=Katpodr.Kod+','+Katpodr.name;
  }
  else
  { if isValid(#KatOrg)
      Result:=KatOrg.name;
  }
} //Function GetPodrOrgName(_pNrec:comp):string;



//========================================================
// Визуальная часть
//========================================================
Window wnFilter 'Установите фильтры'  Cyan, EscClose;
  Show at (,,51,15);
Screen scrFilter 'Фильтры' ('Фильтры',,sci13Esc);
Table KatPodr_Flt;
Fields
  wFilter :NoProtect;
  Filtr_Katpodr  : PickButton,Protect;
  Filtr_KatOrg   : PickButton,Protect;
  Filtr_Persons  : PickButton,Protect;
  sFio_Flt       : NoProtect;
  sPassports_Flt : NoProtect;
  sPropusk_Flt   : NoProtect;
  wType_Flt      : [List
     0 'сотрудники предприятия '
    ,1 'внешние подрядчики'
    ,2 'прочие' ], Protect;
  dDUvBeg ('Уволен после') : NoProtect;
  dDUvEnd ('Уволен до') : NoProtect;
  dDPRBeg ('Срок действия пропуска после') : NoProtect;
  dDPREnd ('Срок действия пропуска  до') : NoProtect;
  Filtr_Kateg    : PickButton,Protect;
  dDATOTCH :NoProtect;
Buttons
  cmOk    ,,, 'продолжить выполнение', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;
<<
  `Фильтр по`
  [.] подразделению` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] организации`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] Сотруднику`    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] по части фио`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] номер паспорта`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] номер пропуска`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] тип записи`    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] дате увольнения ` c.@@@@@@@@@@ по.@@@@@@@@@@
  [.] пропуску действ.` c.@@@@@@@@@@ по.@@@@@@@@@@
  [.] категории     `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] работающие`    на дату .@@@@@@@@@@@@@@@@@@@@

 <. Продолжить .>  <.   Отмена   .>
>>
end; //Screen scrFilter (,,sci13Esс);
HandleEvent
cmInit:
{ isProtect2:=isProtect;
  if isProtect
  { SetEditMode(True)
  }

}
cmDone:
{ if isProtect2
    SetEditMode(false);
}
cmOk:
{ CloseWindowEx(wnFilter,cmDefault)

}
end;// HandleEvent
end; //Windows wnFilter 'Установите фильтры' , Cyan, EscClose;
//**********************************************************************

//**********************************************************************
Browse brScudPers '' (,,sci1Esc) ;
Table GP_SCUD_Pers ;
recMarker=pMarker;
Fields
  GP_SCUD_Pers.Code        'Код/Таб.№' :[20],Protect,NoPickButton,NoDel;
  GP_SCUD_Pers.Fio         'ФИО' :[40],Protect,NoPickButton,NoDel;
  //GP_SCUD_Pers.Description 'Описание'     :[40],NoProtect,NoPickButton,NoDel;
  [sType] GetPersTypeName(GP_SCUD_Pers.wType) ('Тип') :[30],Protect;
  GetPodrOrgName(GP_SCUD_Pers.Nrec) 'Подразделение/Организация' :[30],Protect,NoDel;
end;//Browse brScudPers


//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Pers;
cmSetDefault:
{ exit;
}
cmInsertRecord:
{ exit;
}
cmUpdateRecord:
{ exit;
}
cmDeleteRecord:
{ message('Удаление запрещено!');
  exit;
  //delete GP_SCUD_Pers_Hist where ((  GP_SCUD_Pers.Nrec     == GP_SCUD_Pers_Hist.cGP_SCUD_Pers));
  //delete Current GP_SCUD_Pers;
}
cmPositionChanged:
{
}
end; //GP_SCUD_Pers


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      dDATOTCH:=dGetTune('UP.DATOTCH');
      SetFilterBounds(0);
      SetFilterNm;
      if cRec=0
      { if Marker<>0
        { GetMarker(Marker,0,cRec)
        }
      }
      if cRec>0
      { if getfirst GP_SCUD_Pers where (( cRec == GP_SCUD_Pers.nrec ))=tsok {}
      }
      ReScanPanel(#GP_SCUD_Pers);
      if (wIntMode and cgiMultiEdit)>0
      { //RunWindowModal(wnEditPers);
        CloseInterface(cmDone);
        exit;

      }
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }

    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
      SaveParam;
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Pers.Nrec;
        }
        CloseInterface(cmDefault)
      }
      else Putcommand(cmEdit);
    }
    cmCheckField:
    { case CurField of
      #GP_SCUD_Pers.wType:
      { if GP_SCUD_Pers.wType=1
        { if GP_SCUD_Pers.cPersons<>0
          { Message('Запись связана с картотекой!'
              +chr(13)+'Изменение типа записи запрещено!');
            set GP_SCUD_Pers.wType:=0;
          }
        }
      }
      end;

    }
    //----------------------
    cmPick:
    { if IsProtect
      { Abort;
        Exit;
      }
      case CurField of
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,1);
        }
      }
      //------------------------------
      #Filtr_KatOrg:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_KatOrg);
        StoreMarker(Marker_KatOrg,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_KatOrg,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_KatOrg,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_KatOrg);
          BitOnW(wFilter,2);
        }
      }
      //------------------------------
      #Filtr_Persons:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Persons);
        StoreMarker(Marker_Persons,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Persons,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_Persons,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_Persons);
          BitOnW(wFilter,3);
        }
      }
      #Filtr_Kateg:
      { pTmp:=GP_SCUD_Pers.CGP_SCUD_KATEG;
        if RunInterface(GP_SCUD_KATEGEdit,cgiPickMult,pTmp,Marker_Kateg)<>cmCancel
        { SetFilterNm(#Filtr_Kateg);
          BitOnW(wFilter,10);
        }
      }
      end;
      ReScanPanel(#GP_SCUD_PERS);
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,1);
        SetFilterNm(#Filtr_KatPodr);
      }
      //------------------------------
      #Filtr_KatOrg:
      { ClearMarker(Marker_KatOrg);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatOrg);
      }
      //------------------------------
      #Filtr_Persons:
      { ClearMarker(Marker_Persons);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_Persons);
      }
      #Filtr_Kateg:
      { ClearMarker(Marker_Kateg);
        SetFilterNm(#Filtr_Kateg);
        BitOffW(wFilter,10);
      }
      end;
    }

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Pers: RunInterface('ExClassifier', coGP_SCUD_Pers, GP_SCUD_Pers.nRec);
      end;
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(0);
      }
      else RestFromA
    }
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Pers: RunInterface('Attribute', coGP_SCUD_Pers, GP_SCUD_Pers.nRec);
      end;
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #GP_SCUD_Pers:
      { ProcessCommand(RunMenu('GP_SCUD_PersEdit_S_Main_HotKey'));
      }
      end;
    }
  end;
end.

GP_SCUD_PersEdit_S_Main_HotKey Menu
{
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
-------------------;
- 'Внешняя классификация', cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
- 'Внешние атрибуты'     , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}
