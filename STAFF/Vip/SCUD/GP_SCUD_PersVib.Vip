Interface GP_SCUD_PersVib 'Список людей в СКУД' , EscClose;
Show At (,,120,25);
//------------------------------------
// декларация сложного фильтра
//------------------------------------
function isFilterAnCorrect(ww_nrec:comp): boolean; forward;
//------------------------------------
#include GetKau.var
#include GP_SCUD_GrupEdit.Var
#include GP_SCUD_KategEdit.Var
//--------------------------------------------
var
//-------------------
  iGP_SCUD_EventsEdit :GP_SCUD_EventsEdit New;
  viCYPersons         : ChoiseYourPersons;
  iCatFunc            : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  pMarker:IMarker(Marker) new;
//-----------------------------------------
  NPOEM_OWN_SCUD_Pers_Other :boolean;//'Отображать сторонних лиц
//-----------------------------------------

  cRec    :Comp   ; // ссылка на группу
  Marker:longint;
  Marker_Podr:longint;
  //-- пометка подразделения
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
    wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;

   #mrkfld_(KatPodr)
   #mrkfld_(KatOrg)
   #mrkfld_(Persons)
   #mrkfld_(Kateg)


   sPassPorts_Flt,sPassPorts_Flt_A : string;
   sFio_Flt      ,sFio_Flt_A       : string;
   sPropusk_Flt  ,sPropusk_Flt_A   : string;
   wType_Flt     ,wType_Flt_A      : word;
   DTB,DTE:date;
   dDATOTCH   :date;// Дата начала расчетного периода в зарплате
   dDUvBeg,dDUvBeg_A :date;// 'Уволен после'
   dDUvEnd,dDUvEnd_A :date;// 'Уволен до'
   dDPRBeg,dDPRBeg_A :date;// 'Пропуск после'
   dDPREnd,dDPREnd_A :date;// 'Пропуск до'

//----------------------------------------
Create View
var
   pPersons :comp;
   pKatPodr :comp;
   pKatOrg  :comp;
   pGP_SCUD_KATEG   :comp;
as select GP_SCUD_Pers.Nrec,GP_SCUD_Pers.cGP_SCUD_KATEG
From
  GP_SCUD_Pers(GP_SCUD_PERS02)
, GP_SCUD_Pers_Hist(GP_SCUD_Pers_Hist08) // cGP_SCUD_Pers+Fio+DTIZM+wType,GP_SCUD_Pers_Hist02
, Persons
, KatOrg
, Katpodr
, KLREJIM
, GP_SCUD_KATEG
//------- фильтры
 , KatPodr    KatPodr_Flt
 , KatOrg     KatOrg_Flt
 , Persons    Persons_Flt
 , GP_SCUD_KATEG GP_SCUD_KATEG_Flt

where ((
    GP_SCUD_Pers.cPersons == Persons.Nrec
and GP_SCUD_Pers.cKatPodr == Katpodr.Nrec
and GP_SCUD_Pers.cKatOrg  == KatOrg.Nrec
and GP_SCUD_Pers.CKLREJIM == KLREJIM.NRec
and GP_SCUD_Pers.CGP_SCUD_KATEG == GP_SCUD_KATEG.Nrec
and GP_SCUD_Pers.Nrec     == GP_SCUD_Pers_Hist.cGP_SCUD_Pers
//------- фильтры
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == KatOrg_Flt.Nrec
and wc_nrec == Persons_Flt.Nrec
and wc_nrec == GP_SCUD_KATEG_Flt.Nrec

))
Bounds BySCUD_Kateg pGP_SCUD_KATEG == GP_SCUD_Pers.cGP_SCUD_KATEG(noindex) ordered by TableOrder
Bounds byPersons pPersons == GP_SCUD_Pers.cPersons(noindex) ordered by TableOrder
Bounds byKatOrg  pKatOrg  == GP_SCUD_Pers.cKatOrg (noindex) ordered by TableOrder
Bounds byKatPodr pKatPodr == GP_SCUD_Pers.cKatPodr(noindex) ordered by TableOrder
Bounds byType    wType_Flt== GP_SCUD_Pers.wType   (noindex) ordered by TableOrder
Bounds byDPRBeg  dDPRBeg_A <<=GP_SCUD_Pers.Propusk_To(NoIndex)  ordered by TableOrder
Bounds byDPREND  dDPREnd_A >>=GP_SCUD_Pers.Propusk_To(NoIndex)
             and ZeroDate  << GP_SCUD_Pers.Propusk_To(NoIndex)  ordered by TableOrder

condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_Pers.Nrec))
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
, pKatPodr
#doc
 фильтр по подразделению
#end
,Marker_Podr
#doc
 маркер фильтра по подразделению
#end
;
//*************************************************8
QuickChoice qcByCode
{
  AcceptField = GP_SCUD_Pers.Nrec;
  ViewField = GP_SCUD_Pers.Code;
  ViewField = GP_SCUD_Pers.Fio;
  // только текстовый поля!
  SearchField = GP_SCUD_Pers.Code;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Pers.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_Pers.Nrec;
  ViewField = GP_SCUD_Pers.Fio;
  ViewField = GP_SCUD_Pers.Code;
  // только текстовый поля!
  SearchField = GP_SCUD_Pers.Fio;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Pers.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName

//******************************************************************************
// Функции
//******************************************************************************
  //------------------------------------
  // сохранить параметры
  //------------------------------------
  Procedure SaveParam;
  { if (boVisibleRun)
    {
      SaveMyDsk(wFilter  ,GetInterfaceName+'_wFilter');
      SaveMyDsk(DTB      ,GetInterfaceName+'_DTB');
      SaveMyDsk(DTE      ,GetInterfaceName+'_DTE');
      SaveMyDsk(dDUvBeg  ,GetInterfaceName+'_dDUvBeg');
      SaveMyDsk(dDUvEnd  ,GetInterfaceName+'_dDUvEnd');
      SaveMyDsk(dDPRBeg  ,GetInterfaceName+'_dDPRBeg');
      SaveMyDsk(dDPREnd  ,GetInterfaceName+'_dDPREnd');
      SaveMyDsk(wType_Flt,GetInterfaceName+'_wType_Flt');
    }
    //-----------------------
    DoneMarker(Marker_Persons_A, '' );
    DoneMarker(Marker_KatPodr_A, '' );
    DoneMarker(Marker_KatOrg_A , '' );
    DoneMarker(Marker_Kateg_A  , '' );
    //-----------------------
    DoneMarker(Marker_Persons,if(not boVisibleRun,'', GetInterfaceName+'_Persons') );
    DoneMarker(Marker_KatOrg ,if(not boVisibleRun,'', GetInterfaceName+'_KatOrg' ) );
    DoneMarker(Marker_KatPodr,if(not boVisibleRun,'', GetInterfaceName+'_KatPodr') );
    DoneMarker(Marker_Kateg  ,if(not boVisibleRun,'', GetInterfaceName+'_Kateg'  ) );
  } //Procedure SaveParam;

  //------------------------------------
  // восстановить параметры
  //------------------------------------
  Procedure ReadParam;
  { if (boVisibleRun)
    {
      if not ReadMyDsk(wFilter  ,GetInterfaceName+'_wFilter',false) wFilter:=0;
      if not ReadMyDsk(DTB      ,GetInterfaceName+'_DTB'    ,false) DTB:=ZeroDate;
      if not ReadMyDsk(DTE      ,GetInterfaceName+'_DTE'    ,false) DTE:=ZeroDate;
      if not ReadMyDsk(dDUvBeg  ,GetInterfaceName+'_dDUvBeg',false) dDUvBeg:=ZeroDate;
      if not ReadMyDsk(dDUvEnd  ,GetInterfaceName+'_dDUvEnd',false) dDUvEnd:=ZeroDate;
      if not ReadMyDsk(dDPRBeg  ,GetInterfaceName+'_dDPRBeg',false) dDPRBeg:=ZeroDate;
      if not ReadMyDsk(dDPREnd  ,GetInterfaceName+'_dDPREnd',false) dDPREnd:=ZeroDate;
      if not ReadMyDsk(wType_Flt,GetInterfaceName+'_wType_Flt',false) wType_Flt:=0;
    }
    Marker_Persons  :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_Persons') , 8, 50, 10, True);
    Marker_KatOrg   :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatOrg' ) , 8, 50, 10, True);
    Marker_KatPodr  :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatPodr') , 8, 50, 10, True);
    Marker_Kateg    :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_Kateg'  ) , 8, 50, 10, True);

    Marker_Persons_A  :=InitMarker('' , 8, 50, 10, True);
    Marker_KatOrg_A   :=InitMarker('' , 8, 50, 10, True);
    Marker_KatPodr_A  :=InitMarker('' , 8, 50, 10, True);
    Marker_Kateg_A    :=InitMarker('' , 8, 50, 10, True);

  } //  Procedure ReadParam;


  //------------------------------------
  // декларация сложного фильтра
  //------------------------------------
  function isFilterAnCorrect(ww_nrec:comp): boolean; cacheable;
  { #__UNUSED__(ww_nrec)
    Result:=true;
    if isPodrShare
    { if GP_SCUD_Pers.wType=0
       if not EnablePodr(GP_SCUD_Pers.cKatPodr)
        { Result:=false; Exit;
        }
    }
    if IsBitCTW(wFilter,1)
    { if Count_KatPodr>1
      { If not FoundMarker(Marker_KatPodr_A,GP_SCUD_Pers.cKatPodr)
        { Result:=false; Exit;
        }
      }
    }
    if IsBitCTW(wFilter,2)
    { if Count_KatOrg>1
      { If not FoundMarker(Marker_KatOrg_A,GP_SCUD_Pers.cKatOrg)
        { Result:=false; Exit;
        }
      }
    }
    if IsBitCTW(wFilter,3)
    { if Count_Persons>1
      { If not FoundMarker(Marker_Persons_A,GP_SCUD_Pers.cPersons)
        { Result:=false; Exit;
        }
      }
    }
    if IsBitCTW(wFilter,4)
    { if Pos(UpCase(sFio_Flt),UpCase(GP_SCUD_Pers.Fio) )=0
      { Result:=false;  Exit;
      }
    }
    if IsBitCTW(wFilter,5)
    { if Pos(UpCase(sPassports_Flt),UpCase(GP_SCUD_Pers.Passp_NMB) )=0
      { Result:=false; Exit;
      }
    }
    if IsBitCTW(wFilter,6)
    { if Pos(UpCase(sPropusk_Flt),UpCase(GP_SCUD_Pers.Propusk_NMB) )=0
      { Result:=false; Exit;
      }
    }
    if IsBitCTW(wFilter,8)
    { if GP_SCUD_Pers.wType<>0
      { Result:=False;  exit;
      }
      if not isValidAll(#Persons)
      { Result:=False; exit;
      }
      if dDUvBeg<>ZeroDate
      { //if Persons.DisDate<>ZeroDate
        if Persons.DisDate<dDUvBeg
        { Result:=false; Exit;
        }
      }
      if dDUvEnd<>ZeroDate
      { if Persons.DisDate>dDUvEnd
        or Persons.DisDate=ZeroDate
        { Result:=false; Exit;
        }
      }
    } //if IsBitCTW(wFilter,8)
    if IsBitCTW(wFilter,10)
    { if Count_Kateg>0
      { If not FoundMarker(Marker_Kateg_A,GP_SCUD_Pers.cGP_SCUD_KAteg)
        { Result:=false; Exit;
        }
      }
    }
    if IsBitCTW(wFilter,11)
    { if dDATOTCH<>ZeroDate
      { if not isValidAll(#Persons)
        { Result:=False; exit;
        }
        if Persons.DisDate<>ZeroDate
        if Persons.DisDate<dDATOTCH
        { Result:=False; exit;
        }
      }
    } //if IsBitCTW(wFilter,11)

  }//function isFilterAnCorrect(ww_nrec:comp): boolean;

    //-------------------------------------------
  // скопировать фильтры в данные для отборв
  //-------------------------------------------
  Procedure CopyToA;
  { CopyMarker(Marker_Persons_A ,Marker_Persons);
    CopyMarker(Marker_KatOrg_A  ,Marker_KatOrg );
    CopyMarker(Marker_KatPodr_A ,Marker_KatPodr);
    CopyMarker(Marker_Kateg_A   ,Marker_Kateg  );
    sPassPorts_Flt_A:=sPassPorts_Flt;
    sFio_Flt_A      :=sFio_Flt      ;
    sPropusk_Flt_A  :=sPropusk_Flt  ;
    wType_Flt_A     :=wType_Flt     ;
    dDUvBeg_A       :=dDUvBeg;
    dDUvEnd_A       :=dDUvEnd;
    dDPRBeg_A       :=dDPRBeg;
    dDPREnd_A       :=dDPREnd;
  } //Procedure CopyToA;

  //-------------------------------------------
  // восстановить данные для задания фильтрации
  // из данных для отбора
  //-------------------------------------------
  Procedure RestFromA;
  { CopyMarker(Marker_Persons ,Marker_Persons_A);
    CopyMarker(Marker_KatOrg  ,Marker_KatOrg_A );
    CopyMarker(Marker_KatPodr ,Marker_KatPodr_A);
    CopyMarker(Marker_Kateg   ,Marker_Kateg_A  );

    sPassPorts_Flt:=sPassPorts_Flt_A;
    sFio_Flt      :=sFio_Flt_A      ;
    sPropusk_Flt  :=sPropusk_Flt_A  ;
    wType_Flt     :=wType_Flt_A     ;
    dDUvBeg       :=dDUvBeg_A;
    dDUvEnd       :=dDUvEnd_A;
    dDPRBeg       :=dDPRBeg_A;
    dDPREnd       :=dDPREnd_A;
  } //Procedure RestFromA;

  //-------------------------------------------
  #doc
    Установить ограничения
  #end
  Function SetFilterBounds(_IsArch:word) : boolean;
  { #__UNUSED__(_IsArch)
    Result:=false;
    isFilterRun:=True;
    if ConditionActiveInLeave(tcFilterAn, #GP_SCUD_Pers)
    { PopConditionForLeave(tcFilterAn, #GP_SCUD_Pers);
    }
    If BoundActive(tbbyDPRBeg ) SubBounds(tbbyDPRBeg);
    If BoundActive(tbbyDPREnd ) SubBounds(tbbyDPREnd);
    If BoundActive(tbByPersons) SubBounds(tbByPersons);
    If BoundActive(tbByKatPodr) SubBounds(tbByKatPodr);
    If BoundActive(tbByKatOrg ) SubBounds(tbByKatOrg );
    If BoundActive(tbByType   ) SubBounds(tbByType   );
    If BoundActive(tbBySCUD_Kateg  ) SubBounds(tbBySCUD_Kateg  );
    //-----------------------
    wCount_Filter:=0;
    sTitle_Filter:='';
    //-----------------------
    CopyToA;
    //-----------------------
    ClearFuncCache; // очистим кэш функций
    var need_FilterAn:boolean=false;
    if IsBitCTW(wFilter,1)
    {  Count_KatPodr:=GetMarkerCount(Marker_KatPodr);
       GetMarker(Marker_KatPodr,0,pKatPodr);

       if Count_KatPodr=1
       { AddBounds(tbByKatPodr);
       }
       else need_FilterAn:=true;
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по подразделению';
    }
    if IsBitCTW(wFilter,2)
    {  Count_KatOrg:=GetMarkerCount(Marker_KatOrg);
       GetMarker(Marker_KatOrg,0,pKatOrg);

       if Count_KatOrg=1
       { AddBounds(tbByKatOrg);
       }
       else need_FilterAn:=true;
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по организации';
    }
    if IsBitCTW(wFilter,3)
    {  Count_Persons:=GetMarkerCount(Marker_Persons);
       GetMarker(Marker_Persons,0,pPersons);
       if Count_Persons=1
       {
         AddBounds(tbByPersons);
       }
       else need_FilterAn:=true;
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по сотруднику';
    }
    if IsBitCTW(wFilter,4) or IsBitCTW(wFilter,5) or IsBitCTW(wFilter,6)
    {  need_FilterAn:=true;
       if IsBitCTW(wFilter,4)
       { wCount_Filter++;
         if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по части фио';
       }
       if IsBitCTW(wFilter,5)
       { wCount_Filter++;
         if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'номер паспорта';
       }
       if IsBitCTW(wFilter,6)
       { wCount_Filter++;
         if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'номер пропуска';
       }
    }
    if not NPOEM_OWN_SCUD_Pers_Other
    { BitOnW(wFilter,7);
      wType_Flt:=0;
    }

    if IsBitCTW(wFilter,7)
    { AddBounds(tbByType);
      wCount_Filter++;
      if NPOEM_OWN_SCUD_Pers_Other
      if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'тип записи';

    }
    if IsBitCtW(wFilter,8)
    { if dDUvBeg<>ZeroDate
      or dDUvEnd<>ZeroDate
        need_FilterAn:=true;
      wCount_Filter++;
      if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'дата увольнения';
    }
    if IsBitCtW(wFilter,9)
    { if dDPRBeg<>ZeroDate AddBounds(tbbyDPRBeg);
      if dDPREnd<>ZeroDate AddBounds(tbbyDPREnd);
      wCount_Filter++;
      if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'срок действ.пропуска';
    }

    if IsBitCTW(wFilter,10)
    {  Count_Kateg:=GetMarkerCount(Marker_Kateg);
       pGP_SCUD_KATEG:=0;

       GetMarker(Marker_Kateg,0,pGP_SCUD_KATEG);
       if False // не пашет почему то Count_Kateg=1
       { AddBounds(tbBySCUD_Kateg);
         timelog('GP_SCUD_PERS->SetFilterBounds:pGP_SCUD_KATEG='+string(pGP_SCUD_KATEG,0,0) );
       }
       else
       { need_FilterAn:=true;
       }
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по категории';
    }
    if IsBitCtW(wFilter,11)
    { need_FilterAn:=true;
      wCount_Filter++;
      if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+' работающие';
    }

    if isPodrShare need_FilterAn:=true;

    // использование сложного фильтра
    if need_FilterAn
    { PushConditionForLeave(tcFilterAn, #GP_SCUD_Pers);
    }
    ReReadRecord(#GP_SCUD_Pers);
    Result:=true;
    isFilterRun:=False;
    if wCount_Filter>3 sTitle_Filter:=sTitle_Filter+' и еще '+string(wCount_Filter-3)+' фильтров';
    MySetTitle;
    timelog('GP_SCUD_PERS->SetFilterBounds:=need_FilterAn='+string(need_FilterAn) );

  } //Function SetFilterBounds : boolean;

  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_Katpodr
    { #mrkfiltr_(Katpodr_Flt,Katpodr,Nrec,wc_nrec,Katpodr_Flt.Kod+','+Katpodr_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_Katorg
    { #mrkfiltr_(KatOrg_Flt,KatOrg,Nrec,wc_nrec,KatOrg_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_Persons
    { #mrkfiltr_(Persons_Flt,Persons,Nrec,wc_nrec,Persons_Flt.Fio)
    }
    if _Field=0 or _Field=#Filtr_Kateg
    { #mrkfiltr_(GP_SCUD_KATEG_Flt,Kateg,Nrec,wc_nrec,GP_SCUD_KATEG_Flt.Name)
    }
    ReScanPanel(#KatPodr_Flt);
  } //Procedure SetFilterNM(_Field:longint)




//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetPersTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  0: Result:='сотрудники предприятия ';
  1: Result:='внешние подрядчики';
  2: Result:='прочие';
  end;
} //Function GetPersTypeName(_wType:word)   :string;cacheable;

//-----------------------------------------
//   Проинициализровать данные
//-----------------------------------------
Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _cNrec     : comp;  // ссылка на "Ведомость"
  _cPersons  : comp;   // выбранная запись
  _cKatpodr  : comp;   // выбранная запись
  _cKatOrg   : longint; // включить определенные форматы
  _DTB       : Date; //период просмотра
  _DTE       : Date; //период просмотра
  _NoVisual  : boolean=false //не перерисовывать экраны
  ) : boolean;
{ #__UNUSED__(_wIntMode,_cNrec,_cPersons,_cKatpodr,_cKatOrg,_DTB,_DTE,_NoVisual)
  Result:=False;
  Result:=True;
} //Function InitParam(


