// (Issue #177) Отчет СКУД 4 Отчет Дисциплина Труда
function GetShortFIOLast(FIO:string):string;
{
  result:='';
  if (iStrFunc.GetFioIn(FIO))
    result:=FIO;
} //function GetShortFIOLast(FIO:string):string;



const
  c1OverWork     =1;// сверхурочные
  c2OverWork2    =2;// переработка
  c3Holiday      =3;// выходные
  c4MisConDuct   =4;// выходные
  c5GrafCh       =5;// рабочих часов
end;
//------------------------------------
// Получить значение всех полей по сотруднику
//------------------------------------
var FirstCalc:boolean;

Function MyGet_Func_Boss_By_Pers(_Pers:comp):string;cacheable;
{ var _pPost, _pPersons:comp=0;
  Result:=Get_Func_Boss_By_Pers(_Pers, _pPost, _pPersons);
}

Procedure CalcPers(_cScud_Pers:comp;_DateCalc:Date);
var _pPost, _pPersons:comp;
{
  var _Day:word=0;
  if (cPerCalc <>_cScud_Pers) or (_DateCalc < DateCalcB) or (DateCalcE < _DateCalc)
  {

    timelog('Расчет для '+mtMain.Fio+', Дата '+DateToStr(_DateCalc,'DD/MM/YYYY') );
    // почему-то после первого расчета CalcAll,  GetCalc_CH_Over выдаёт 0. Потом работает нормально.
    // Надо разбираться
    //if FirstCalc iGP_SCUD_EventsEdit_Cacl.CalcAll(_cScud_Pers,Year(DateCalc), Month(DateCalc));
    FirstCalc := false;

    iGP_SCUD_EventsEdit_Cacl.CalcAll(_cScud_Pers,Year(_DateCalc), Month(_DateCalc)
        ,if(NPOEM_OWN_HEAD_V_VID=2,3,NPOEM_OWN_HEAD_V_VID)//0 при расчета считаются , что на все сверхурочные есть приказ
                      //1 учитываются только проведенные приказы, если задан _DayCalc - то это вызов из приказа, и за этот день не учитываются
       ,false // true - с перерасчетом
      ,0 //DayCalc:word =0//при расчете для приказов указать день
    );
    //ReReadRecord(#tMisConDuct);
    ReReadRecord(#Tmp_Scud_MisConDuct);
    ReReadRecord(#tMisConDuct);
    cPerCalc := _cScud_Pers;
    DateCalc := _DateCalc;
    DateCalcB := Date(                 1, Month(DateCalc), Year(DateCalc));
    DateCalcE := Date(Last_Day(DateCalc), Month(DateCalc), Year(DateCalc));

        var wMonthRas, wYearRas: word;
        wMonthRas := Month(DateCalc);
        wYearRas := Year(DateCalc);

        //не очень понятно зачем
        if true //IsBitOn(wFilter,4) //только нарушители
        {
          //delete mtMain_tmp where (( mtMain.cGP_SCUD_Pers == mtMain_tmp.cGP_SCUD_Pers  )) and mtMain_tmp.x6 > 0;
          _Loop tMisConDuct where ((mtMain.cGP_SCUD_Pers == tMisConDuct.cGP_SCUD_PERS
                                            and  wMonthRas == tMisConDuct.MesN
                                            and  wYearRas  == tMisConDuct.YearN
                                         and 6 == tMisConDuct.wMisConDuct(noindex)
                           ))
          {
            if getfirst mtMain_tmp = tsOk // нужен буфер с comp;
            mtMain_tmp.EventDate := tMisConDuct.DT_Ev;
            mtMain_tmp.t1h := 0;
            mtMain_tmp.t2h := 0;
            mtMain_tmp.t3h := 0;
            mtMain_tmp.t4h := 0;
            mtMain_tmp.t5h := 0;
            mtMain_tmp.x6  := 1;
            insert current mtMain_tmp; // при повторном расчете будет задвоение. Удалим всё x6 перед циклом
         }
        }
        Var diff_t: double;
        _Loop mtMain_tmp
        {
          mtMain_tmp.t1h := 0;  // Опоздать за день можно один раз, это на случай группировки за неделю/мес/год
          mtMain_tmp.t2h := 0;
          mtMain_tmp.t3h := 0;
          mtMain_tmp.t4h := 0;
          mtMain_tmp.t5h := 0;
          _Day:=Day(mtMain_tmp.EventDate);
          mtMain_tmp.TMB:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(6,_Day));
          mtMain_tmp.TME:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(7,_Day));
          mtMain_tmp.Break1B:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(10,_Day));
          mtMain_tmp.Break1E:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(11,_Day));
          mtMain_tmp.Break2B:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(12,_Day));
          mtMain_tmp.Break2E:=iGP_SCUD_EventsEdit_Cacl.GetTimeFromdouble(iGP_SCUD_EventsEdit_Cacl.GetExtData(13,_Day));
          mtMain_tmp.tAll   :=iGP_SCUD_EventsEdit_Cacl.GetCalc_CH_Fact_Day(_Day);
          // другое
          // свое
          // рассчитать
          //mtMain_tmp.tAllS  :=iGP_SCUD_EventsEdit_Cacl.GetCalc_CH_Fact_Day(_Day);
          var _timeS:double=0;
          var _timeB:time=ZeroTime; // вход = выход в базе с ареала Завод
          var _timeE:time=ZeroTime; // выход = вход в базе на ареал Завод
          // могут быть проблемы когда человек более суток на территории подразделения
          _Loop tmp_ev_all where ((
                   mtMain_tmp.CGP_SCUD_PERS == tmp_ev_all.CGP_SCUD_PERS
               and mtMain_tmp.EventDate == tmp_ev_all.ENTERDATE
                ))
          ordered by index tmp_ev_all01
          { if tmp_ev_all.wResource=1
            { if tmp_ev_all.ENTERTIME> _timeB
              { //Здесь еще можно применить на сколько он раньше вошел. ниже отконтролируем что не больше общего времени

                // Вне обеда
                if mtMain_tmp.Break1B>=tmp_ev_all.ENTERTIME
                or (mtMain_tmp.Break1E<>ZeRoTime and mtMain_tmp.Break1E<=_timeB)
                { _timeS+=iGP_SCUD_EventsEdit_Cacl.GetDoubleFromTime(Sub_time(tmp_ev_all.ENTERTIME,_timeB));
                }
                else
                // вошел утра, вышел в обед или позже
                if   _timeB<=mtMain_tmp.Break1B
                and tmp_ev_all.ENTERTIME>=mtMain_tmp.Break1B
                { _timeS+=iGP_SCUD_EventsEdit_Cacl.GetDoubleFromTime(Sub_time(mtMain_tmp.Break1B,_timeB));
                  if tmp_ev_all.ENTERTIME>=mtMain_tmp.Break1E
                  { _timeS+=iGP_SCUD_EventsEdit_Cacl.GetDoubleFromTime(Sub_time(tmp_ev_all.ENTERTIME,mtMain_tmp.Break1E));
                  }
                }
                else
                // вошел в обед
                if   _timeB>mtMain_tmp.Break1B and _timeE<mtMain_tmp.Break1E
                and tmp_ev_all.ENTERTIME>=mtMain_tmp.Break1E
                { _timeS+=iGP_SCUD_EventsEdit_Cacl.GetDoubleFromTime(Sub_time(tmp_ev_all.ENTERTIME,mtMain_tmp.Break1E));
                }

              }
              _timeE:=tmp_ev_all.ENTERTIME;// надо зафиксировать что вышел
            }
            else
            { _timeB:=tmp_ev_all.ENTERTIME;
              _timeE:=ZeroTime;
            }
          } //_Loop tmp_ev_all
          if _timeE=ZeroTime and _timeB<>ZeroTime // есть вход, но нет выхода
          { _timeS+=iGP_SCUD_EventsEdit_Cacl.GetDoubleFromTime(Sub_time(time(24,0,0,0),_timeB));
          }
          mtMain_tmp.tAllS:=_timeS;
          if mtMain_tmp.tAllS>mtMain_tmp.tAll
            mtMain_tmp.tAllS:=mtMain_tmp.tAll;
          //----------------------------
          mtMain_tmp.tAllO:=mtMain_tmp.tAll-mtMain_tmp.tAllS;

          mtMain_tmp.tIn   :=iGP_SCUD_EventsEdit_Cacl.GetCalc_TMB_Day(_Day);  //"Время входа (на территорию завода)"
          mtMain_tmp.tOutBr:=mtMain_tmp.Break1B; //"Время выхода (с территории завода) - обед"
          mtMain_tmp.tInBr :=mtMain_tmp.Break1E; // Время входа с обеда (на территорию завода)
          mtMain_tmp.tOut  :=iGP_SCUD_EventsEdit_Cacl.GetCalc_TME_Day(_Day); // Время выхода (с территории завода)
          _Loop tMisConDuct
          if tMisConDuct.wMisConDuct > 0
          {
            diff_t := iGP_SCUD_EventsEdit_Cacl.GetDoubleFromTime(tMisConDuct.tDiff); // ? как его считать ???

            if timelog_status>0
            if diff_t > 0.001
            {  timelog( '---' + mtMain.Fio + '  wMisConDuct=' + tMisConDuct.wMisConDuct + '  tMisConDuct.tDiff='+ TimeToStr(tMisConDuct.tDiff,'HH:MM:SS')+ '   diff_t = ' + string(diff_t,20,5));
            }


              Case tMisConDuct.wMisConDuct of
              1: mtMain_tmp.t1h := mtMain_tmp.t1h + diff_t; // Опоздание на работу
              2:
              { mtMain_tmp.t2h := mtMain_tmp.t2h + diff_t; // Ранний уход на обед
                if tMisConDuct.TM_Ev<>ZeroTime mtMain_tmp.tOutBr:=tMisConDuct.TM_Ev;
              }
              3:
              { mtMain_tmp.t3h := mtMain_tmp.t3h + diff_t; // Поздний приход с обеда
                if tMisConDuct.TM_Ev<>ZeroTime mtMain_tmp.tInBr:=tMisConDuct.TM_Ev;
              }
              4: mtMain_tmp.t4h := mtMain_tmp.t4h + diff_t; // Ранний уход с работы
              5: mtMain_tmp.t5h := mtMain_tmp.t5h + diff_t; // Отсутствие в середине дня
              6: mtMain_tmp.x6 := 1;             // Прогул
              end; // Case Tmp_Scud_MisConDuct.wMisConDuct of
              if tMisConDuct.cMisConDuct>0
              { mtMain_tmp.ZAbsent:=mtMain_tmp.ZAbsent+if(mtMain_tmp.ZAbsent='','','; ')
                  +GetZAbsentName(tMisConDuct.cMisConDuct);
              }

          } //_Loop tMisConDuct
          mtMain_tmp.Sum := mtMain_tmp.t1h + mtMain_tmp.t2h +
                            mtMain_tmp.t3h + mtMain_tmp.t4h + mtMain_tmp.t5h;
          mtMain_tmp.tDis:=iGP_SCUD_EventsEdit_Cacl.GetCalc_CH_Graf_Day(_day)
                          -iGP_SCUD_EventsEdit_Cacl.GetCalc_CH_Fact_Day(_day)
                           ;
          if mtMain_tmp.tDis<0 mtMain_tmp.tDis:=0;
          _pPost:=_pPersons:=0;
          mtMain_tmp.BossFio   := MyGet_Func_Boss_By_Pers(mtMain_tmp.cPersons);
          //mtMain_tmp.cBossPers := _pPersons;
          mtMain_tmp.tOver := iGP_SCUD_EventsEdit_Cacl.GetExtData(2,_Day);
          UpDate current mtMain_tmp;



        } //_Loop mtMain_tmp
        var _DT:date=ZeroDate;
        var _TmB,_TmE,_PlanTime:time=ZeroTime;
        var _wType:word=0;
        var _cNrec:comp=0;
        if iGP_SCUD_StateMentOnAbsent_Calc.GetFirstPeriodWithOutMisConDuct(cPerCalc,DateCalcB,DateCalcE,
                         _DT,_TMB,_TME,_PlanTime
                         ,_wType //_need_calc
                         ,_cNrec
                         ,true)
        {
           do
           { if getfirst mtMain_tmp where (( mtMain.cGP_SCUD_Pers == mtMain_tmp.cGP_SCUD_Pers
               and _DT == mtMain_tmp.EventDate ))<>tsok
             { mtMain_tmp.buffer:=mtMain.buffer;
               mtMain_tmp.EventDate:=_DT;
               mtMain_tmp.t1h := 0;
               mtMain_tmp.t2h := 0;
               mtMain_tmp.t3h := 0;
               mtMain_tmp.t4h := 0;
               mtMain_tmp.t5h := 0;
               mtMain_tmp.x6  := if(_wType=3,1,0);//1
               mtMain_tmp.BossFio   := MyGet_Func_Boss_By_Pers(mtMain_tmp.cPersons);
               insert current mtMain_tmp;
             }
             case _wType of
             0,1: mtMain_tmp.tZAbsent := mtMain_tmp.tZAbsent + iGP_SCUD_EventsEdit_Cacl.GetDoubleFromTime(_PlanTime);//Sub_Time(_TME,_TMB));
             2  : mtMain_tmp.tZAbsentRuk:= mtMain_tmp.tZAbsentRuk+ iGP_SCUD_EventsEdit_Cacl.GetDoubleFromTime(_PlanTime);//Sub_Time(_TME,_TMB));
             end;
             if Timelog_Status>0
             {   Timelog('Заявления от '+DateToStr(_DT,'DD.MM.YYYY')+', время='+TimeToStr(_TmB,'HH:MM')
                 );
             }
             if _cNrec>0
             { vGP_Scud_Doc.pGP_Scud_Doc:=_cNrec;
               if vGP_Scud_Doc.getfirst GP_Scud_Doc=tsok
               case _wType of
               0,1: mtMain_tmp.ZAbsent   := mtMain_tmp.ZAbsent   +' '+ vGP_Scud_Doc.GP_Scud_Doc.DocNmb;
               2  : mtMain_tmp.ZAbsentRuk:= mtMain_tmp.ZAbsentRuk+' '+vGP_Scud_Doc.GP_Scud_Doc.DocNmb;
              end;
             }
             update current mtMain_tmp;
             _PlanTime:=ZeroTime;
           } while iGP_SCUD_StateMentOnAbsent_Calc.GetNextPeriodWithOutMisConDuct(_DT,_TMB,_TME,_PlanTime,_wType,_cNrec)
        } //if iGP_SCUD_StateMentOnAbsent_Calc.GetFirstPeriodWithOutMisConDuct(cPerCalc,DateCalcB,DateCalcE,
  } //if (cPerCalc <>_cScud_Pers) or (_DateCalc < DateCalcB) or (DateCalcE < _DateCalc)
} //Function CalcPers(_cScud_Pers:comp;_DateCalc:Date);


Procedure SborData;
var chet:longint;
{ chet:=0;
  delete all mtMain_free;
  DTB_L := DTB; DTE_L := DTE;
  //====== DSQL =======
  SQLLog_TP := 1 ;
  CreateTempVib;
  ClearQuery(vliSQLCommand);
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfconfirm,''#3'Загрузка данных',10);

  //-----------------------------
  
  if IsBitOn(wFilter,2) //Подразделения
    InsTempVibByMarker(02,Marker_KatPodr );// Подразделения
  if IsBitOn(wFilter,3) //Сотрудники
    InsTempVibByMarker(03,Marker_Persons );// Сотрудники
  PrepareSQLQuery('select  DISTINCT ');
  PrepareSQLQuery('    (SELECT top 1 nRec from GP_SCUD_Events Ev where Ev.cGP_SCUD_Pers = GP_SCUD_PERS.Nrec');
  PrepareSQLQuery('      and Ev.EnterDate = GP_SCUD_Events.EnterDate');
  PrepareSQLQuery('      ORDER BY cGP_SCUD_Pers,EnterDate,EnterTime)  as nRec      ');
  PrepareSQLQuery('  ,GP_SCUD_PERS.Nrec as cGP_SCUD_PERS                           ');
  PrepareSQLQuery('  ,GP_SCUD_Events.EnterDate as EventDate                        ');
  PrepareSQLQuery('  ,GP_SCUD_PERS.cPersons as cPersons                            ');
  PrepareSQLQuery('  ,GP_SCUD_PERS.cKatPodr as cKatPodr                            ');
  PrepareSQLQuery('  ,KatPodr.Name  as sKatPodr                                    ');
  PrepareSQLQuery('  ,KatPodr.Kod   as sKatPodr_Kod                                ');
  PrepareSQLQuery('  ,GP_SCUD_PERS.fio as FIO                                      ');
  PrepareSQLQuery('  ,COALESCE(CatPost.Name,'''') as sPost              ');
  PrepareSQLQuery('  ,KatPodr.Kod + GP_SCUD_PERS.fio as SortFld                    ');
  PrepareSQLQuery('From GP_SCUD_PERS                                               ');
  PrepareSQLQuery(' inner join KatPodr on Gp_SCUD_PERS.cKatPodr = KatPodr.Nrec     ');
  PrepareSQLQuery(' inner join GP_SCUD_Events on GP_SCUD_Events.cGp_SCUD_PERS = Gp_SCUD_PERS.Nrec');   // чтоб с 'Where' не морочится, условия по дате ограничит GP_SCUD_Events, а он через inner join сработает на весь запрос

  if DTB > ZeroDate
  PrepareSQLQuery(' and GP_SCUD_Events.EnterDate>=#Date('+DateToStr(DTB,'DD,MM,YYYY')+') ');
  if DTE > ZeroDate
  PrepareSQLQuery(' and GP_SCUD_Events.EnterDate<=#Date('+DateToStr(DTE,'DD,MM,YYYY')+') ');

  if false // не заполнено поле GP_SCUD_PERS.CGP_SCUD_Kateg
    PrepareSQLQuery(' inner join GP_SCUD_KATEG  on GP_SCUD_PERS.CGP_SCUD_Kateg = GP_SCUD_KATEG.nRec and GP_SCUD_KATEG.WTYPE > 1');
  PrepareSQLQuery(' inner join Persons on Persons.Nrec = Gp_SCUD_PERS.cPersons ');
  if IsBitOn(wFilter,5) //без уволенных
  {  PrepareSQLQuery('   and Persons.DisDate<#Date(1,1,1900)');
  }
  if IsBitOn(wFilter,2) //Подразделения
  PrepareSQLQuery(' inner join tempvib VibKatPodr on VibKatPodr.wlist=2 and VibKatPodr.crec = GP_SCUD_PERS.cKatPodr');
  if IsBitOn(wFilter,3) //Сотрудники
  PrepareSQLQuery(' inner join tempvib VibSCUD_Pers on VibSCUD_Pers.wlist=3 and VibSCUD_Pers.crec = GP_SCUD_PERS.cPersons');
  //---------------------
  PrepareSQLQuery(' left Outer join Appointments on Appointments.Nrec = CASE WHEN Persons.AppointCur=#Comp(0) THEN  Persons.AppointLast ELSE Persons.AppointCur END');
  PrepareSQLQuery(' left Outer join Catalogs CatPost on CatPost.Nrec = Appointments.Post');
  //----------------------
  PrepareSQLQuery(' where GP_SCUD_PERS.Nrec>#Comp(0)');
  if not NPOEM_OWN_SCUD_Pers_Other
  { PrepareSQLQuery(' and GP_SCUD_PERS.wType=0');
  }
  if IsBitOn(wFilter,4) //только нарушители
  { PrepareSQLQuery(' and GP_SCUD_PERS.Nrec in ( Select GP_SCUD_MISCON_D.CGP_SCUD_PERS');
    PrepareSQLQuery('From GP_SCUD_MISCON_D where GP_SCUD_MISCON_D.CGP_SCUD_PERS =GP_SCUD_PERS.Nrec');
    if DTB > ZeroDate
      PrepareSQLQuery(' and GP_SCUD_MISCON_D.DT_EV>=#Date('+DateToStr(DTB,'DD,MM,YYYY')+') ');
    if DTE > ZeroDate
      PrepareSQLQuery(' and GP_SCUD_MISCON_D.DT_EV<=#Date('+DateToStr(DTE,'DD,MM,YYYY')+') ');
    PrepareSQLQuery(' )');
  } //if not IsBitOn(wFilter,4)

 //=== RUN DSQL
  var _IdTable:longint;
  _IdTable:=#mtMain;
  stmt:=0;
  stmt := sqlAllocStmt;

  ExecDSQLex2(_IdTable,1);
  RereadRecord(#mtMain);
  ClearQuery(vliSQLCommand);

  if getfirst mtMain = tsOk{}
  if not NextVisual then exit;
  //----------------------
  //отберем все события
  PrepareSQLQuery('  select EV.ENTERDATE, EV.ENTERTIME');
  PrepareSQLQuery(', EV.wResource '); //0 - 0 'Выход','Вход'
  PrepareSQLQuery(', EV.CGP_SCUD_PERS');
  //PrepareSQLQuery(' , Substring(GP_SCUD_PERS.Fio,1,25)');
  PrepareSQLQuery(' , GP_SCUD_CONTROLER.NAME');
  PrepareSQLQuery('From GP_Scud_EV_All EV');
  PrepareSQLQuery('inner join GP_SCUD_CONTROLER on GP_SCUD_CONTROLER.Nrec = EV.cControler');
  PrepareSQLQuery('left outer join GP_SCUD_Events on GP_SCUD_Events.cGP_SCUD_Pers =  EV.cGP_SCUD_Pers');
  PrepareSQLQuery('    and  GP_SCUD_Events.NPP = EV.NPP');
// переделаем не на код подразделения, а на внешний атрибут =- названию ареала-ла ла ла  PrepareSQLQuery('inner join KatPodr on KatPodr.kod = Substring(GP_SCUD_CONTROLER.NAME,1,3)');
  PrepareSQLQuery('  join GP_SCUD_PERS on GP_SCUD_PERS.Nrec = EV.CGP_SCUD_PERS   ');
  PrepareSQLQuery('  JOIN katpodr on katpodr.nrec = GP_SCUD_PERS.CKATPODR        ');  // криво это конечно: надо учитывать историю перемещение по заводу
  PrepareSQLQuery('      inner join AttrNam on AttrNam.wtable = 1413             ');
  PrepareSQLQuery('                    and AttrNam.name =''Ареал доступа СКУД''  ');
  PrepareSQLQuery('      inner join AttrVal on AttrVal.cAttrnam = Attrnam.nrec   ');
  PrepareSQLQuery('                          and attrval.wtable = Attrnam.wtable ');
  PrepareSQLQuery('                            and attrval.crec = katpodr.nrec   ');  // а так.. пока как костыль пойдет


  if IsBitOn(wFilter,5) //без уволенных
  {
    PrepareSQLQuery('join Persons on Persons.nrec =  EV.cGP_SCUD_Pers'); // исправляю ошибку
    PrepareSQLQuery('           and Persons.DisDate<#Date(1,1,1900)'); // - это ошибка была..
  }
  if IsBitOn(wFilter,2) //Подразделения
  PrepareSQLQuery(' inner join tempvib VibKatPodr on VibKatPodr.wlist=2 and VibKatPodr.crec = GP_SCUD_PERS.cKatPodr');
  if IsBitOn(wFilter,3) //Сотрудники
  PrepareSQLQuery(' inner join tempvib VibSCUD_Pers on VibSCUD_Pers.wlist=3 and VibSCUD_Pers.crec = GP_SCUD_PERS.cPersons');
  //-------------------------
  PrepareSQLQuery('where Ev.wEvents_Type=1');
  PrepareSQLQuery(' and instr(attrval.vstring,GP_SCUD_CONTROLER.NAME) <> 0');
  if DTB > ZeroDate
    PrepareSQLQuery(' and EV.EnterDate>=#Date('+DateToStr(DTB,'DD,MM,YYYY')+') ');
  if DTE > ZeroDate
    PrepareSQLQuery(' and EV.EnterDate<=#Date('+DateToStr(DTE,'DD,MM,YYYY')+') ');

  //and EV.cControler = #comp(281474976710881)');
  PrepareSQLQuery('and ( GP_SCUD_Events.Nrec is Null)');
  PrepareSQLQuery('order by EV.CGP_SCUD_PERS,EV.ENTERDATE, EV.ENTERTIME');
  //-----------------------
  stmt:=0;
  stmt := sqlAllocStmt;
  _IdTable:=#tmp_ev_all;
  ExecDSQLex2(_IdTable,1);
  RereadRecord(#tmp_ev_all);
  ClearQuery(vliSQLCommand);
  stmt:=0;
  //-----------------------
  StopVisual('',0);
} //Procedure SborData



//-----------------------------------
// Печать вариант 00
//-----------------------------------
Procedure PrintDoc;
var werr:longint;
{ //Печать отчета

  werr:=ExcelInit('GP_SCUD_RptFactWork.xlsx',true);
  MyLogWrite(true,'START');


  xlDisplayAlerts(false);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Вывод отчета в Excel ...', LongInt(RecordsInTable(#mtMain)/100));
  HeaderStrCount:=2; // для последующего вывода сетки
  MaxColCount:=23 ;
  wexrow:=HeaderStrCount;
  MyXlCreaMatrix(100, MaxColCount+4);
  matrixkl:=true;
  matrixsdvig:=wexrow;

  _Loop mtMain
  { if not NextVisual
    { break;
    }
    wexrow++;
    wexcol:=1;
    MyPutExcel(chr(39)+DateToStr(mtMain.EventDate,'DD.MM.YYYY') ,10,0,-1,-1); //01 'Дата'  ('Дата регистрации'): [12] ,Protect;
    MyPutExcel(mtMain.sKatPodr  ,10,0,-1,-1); //02   'Подразделение' :[20],Protect;
    MyPutExcel(mtMain.sKatPodr_Kod,10,0,-1,-1); //03 'Код ' :[10],Protect;
    MyPutExcel(mtMain.Fio,10,0,-1,-1); //04 'Ф.И.О.','сотрудника'       : [30],Protect;
  //-------------------------------
    MyPutExcel(mtMain.sPost,10,0,-1,-1); //05  'Должность'   :[30],Protect; //GetPostPers(mtMain.cPersons)
    MyPutExcel(TimeToStr(mtMain.TMB    ,'HH:MM'),10,0,-1,-1); //06 'Начало','рабочего времени' ('Начало рабочего времени') :[10],Protect;
    MyPutExcel(TimeToStr(mtMain.Break1B,'HH:MM -')+TimeToStr(mtMain.Break1E,'HH:MM'),10,0,-1,-1); //07 'Обед с'  :[10],Protect;
    MyPutExcel(TimeToStr(mtMain.TME    ,'HH:MM'),10,0,-1,-1); //08 'Начало','рабочего времени' ('Начало рабочего времени') :[10],Protect;

    MyPutExcel(TimeToStr(mtMain.tIn   ,'HH:MM') ,10,0,-1,-1); //09 'Вход'             ('Время входа (на территорию завода)') :[10],Protect;
    MyPutExcel(TimeToStr(mtMain.tOutBr,'HH:MM') ,10,0,-1,-1); //10 'Выход','на Обед'  ('Время выхода (с территории завода) - обед') :[10],Protect;
    MyPutExcel(TimeToStr(mtMain.tInBr ,'HH:MM') ,10,0,-1,-1); //11 'Вход ','с обеда'  ('Время входа с обеда (на территорию завода)') :[10],Protect;
    MyPutExcel(TimeToStr(mtMain.tOut  ,'HH:MM') ,10,0,-1,-1); //12 'Время','выхода'   ('(с территории завода)')
    MyPutExcelNumber(mtMain.t1h  /24,5,10,0,-1,-1); //13 'Опоздание','на работу(час)'       :[10,2],Protect;
    MyPutExcelNumber(mtMain.t2h  /24,5,10,0,-1,-1); //14 'Ранний уход','на обед(час)'       :[10,2],Protect;
    MyPutExcelNumber(mtMain.t3h  /24,5,10,0,-1,-1); //15 'Поздний приход','с обеда(час)'    :[10,2],Protect;
    MyPutExcelNumber(mtMain.t4h  /24,5,10,0,-1,-1); //16 'Ранний уход','с работы(час)'      :[10,2],Protect; // 'Другие выходы (час)'
    //MyPutExcelNumber(mtMain.t5h  /24,5,10,0,-1,-1); //17 'Отсутствие в','середине дня(час)' :[10,2],Protect;
    //MyPutExcelNumber(mtMain.Sum  'Сумма за день (час)'     :[20,2],Protect;
    //MyPutExcelNumber(mtMain.x6   'Прогул'  :[6],Protect;

    MyPutExcelNumber(mtMain.tAll  /24,5,10,0,-1,-1); //17 'Всего'              ('Общее время нахождения на заводе') :[10],Protect;
    MyPutExcelNumber(mtMain.tAllS /24,5,10,0,-1,-1); //18 'На рабочем месте'   ('Общее время нахождения на территории своего подразделения') :[10],Protect;
    MyPutExcelNumber(mtMain.tAllO /24,5,10,0,-1,-1); //19 'Вне рабочего места' ('Общее время нахождения на территории другого подразделения') :[10],Protect;
    //MyPutExcel(mtMain.ZAbsent ,10,0,-1,-1); //  'Контрольная','карта' : [25],Protect,NoDel;
    MyPutExcelNumber(mtMain.tZAbsent/24,5,10,0,-1,-1); //20    'Контрольная','карта, Время') :[10],Protect;
    //MyPutExcel(mtMain.ZAbsentRuk  ,10,0,-1,-1); //'Контрольная','карта Рук.') :[10],Protect;
    MyPutExcelNumber(mtMain.tZAbsentRuk/24,5,10,0,-1,-1); //21 'Контрольная','карта Рук., Время') :[10],Protect;
    MyPutExcelNumber(mtMain.tDis  /24,5,10,0,-1,-1); //22 'Потери'             ('Возможные потери рабочего времени') :[10],Protect;

    MyPutExcelNumber(mtMain.tOver /24,5,10,0,-1,-1); //23 'Переработка'        ('Переработка'
    MyPutExcel(mtMain.BossFio,10,0,-1,-1); // 'Функц.Руководитель' :[15],Protect,NoDel;

  }
  MyxlWriteMatrix(wexrow);
  xlFreeMatrix;
  matrixkl:=False;
  xlWrapText(HeaderStrCount, 1, wexrow, MaxColCount);
  MyxlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, HeaderStrCount+1 ,1,wexrow,MaxColCount); //Обрамление

  myXlEnd;


  StopVisual;

} //Procedure PrintDoc;
