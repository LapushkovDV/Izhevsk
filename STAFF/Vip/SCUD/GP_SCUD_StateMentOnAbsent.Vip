//******************************************************************************
// Функции
//******************************************************************************
  //-----------------------------------------------------
  // Поиск следующего номера документа
  //-----------------------------------------------------
  function GetNextDocNumber(InYear:word):string;
  var _DTBeg,_DTEnd:_datetime;
      _wTypeDoc:word;
  { _DTBeg:=_DateTime(1,1,InYear,0,0,0,0);
    _DTEnd:=_DateTime(31,12,InYear,23,59,0,0);
    _wTypeDoc:=GetTypeDoc;
    result:='';
    sql
      select max(GP_SCUD_Doc.DOCNMB)
      from GP_SCUD_Doc
    where(:(_DTBeg)<=GP_SCUD_Doc.DocDate and :(_DTEnd)>=GP_SCUD_Doc.DInput
      and GP_SCUD_Doc.wType=:(_wTypeDoc))
    into (result);

    if (Trim(result)='')
      result:='000001'
    else
      result:=NextNumStr(result);
  } //function GetNextDocNumber(InYear:word):string;


  //============================================
  // Получить статус по умолчанию
  //============================================
  Function GetStatus_Default:comp;
  { Result:=pStatus_GetDefault;
  } //Function GetStatus_Default:comp;

  //============================================
  // Получить наименование документа
  //============================================
  Function GetDocumentName:string;
  { Result:='№'+GP_SCUD_Doc.DocNMb+DateToStr(GP_SCUD_Doc.DocDate,' от DD.MM.YYYY');
  } //Function GetDocumentName:string;

  //============================================
  // сразу и вернем период, который не исключен из нарушения.
  // если есть исключение, то result=true, если  нет - false
  //============================================
  Function  GetFirstPeriodWithOutMisConDuct(_pScud_Pers:comp; DT_B:date;DT_E:date
          ;var _DT:date;var TM_B:time; var TM_E:time;var Plan_Time:time; var _need_calc:word
          ;var _cNrec:comp
          ;boVisual:boolean=false;All_Stat:word=0) :boolean;
   var
      pStat_Default:comp;
      pStat_ConFirm:comp;
  { Result:=false;
    delete all tmp_period;
    _cNrec:=0;
    pStat_Default:=pStatus_GetDefault;
    pStat_ConFirm:=NPOEM_OWN_SCUD_ZAbsent_STATUS_M;
// GetFirstPeriodWithOutMisConDuct вызываю в GP_SCUD_RptOverwork.Vip в  Procedure PositionChanged;
// logstrtofile('Stat_Default.log','pStat_Default = ' + pStat_Default + '  DT_B=' + DT_B + '  DT_E' + DT_E + '  _pScud_Pers=' + _pScud_Pers);
// выдал
// pStat_Default = 2814749767106630  DT_B=01/10/2017  DT_E31/10/2017  _pScud_Pers=2814749767116320
   if TimeLog_Status>0
     Timelog('GP_SCUD_StateMentOnAbsent->GetFirstPeriodWithOutMisConDuct=' + string(pStat_Default)
       + ',DT_B=' + DateToStr(DT_B,'DD/MM/YYYY') + ',DT_E=' + DateToStr(DT_E,'DD/MM/YYYY') + ',_pScud_Pers=' + string(_pScud_Pers,0,0));
    _Try
    { delete all tmp_period;
      sql
      select
           // GP_SCUD_Doc_SP.EventDate           as EventDate // : date "Дата события"
            GP_SCUD_Doc.DocDate                as EventDate // : date "Дата события"
          , GP_SCUD_Doc_SP.EventTmB            as EventTmB  // : time "Время события с"
          , GP_SCUD_Doc_SP.EventTmE            as EventTmE  //  : time "Время события по"
          , COALESCE(GP_SCUD_Reason.wType,0)   as wType
          , COALESCE(GP_SCUD_Reason.Name,'')   as NameType
          , GP_SCUD_Doc_SP.cGP_Scud_Pers       as cGP_Scud_Pers
          , SubString(GP_SCUD_Doc.DocNmb,1,30) as DocNmb
          , GP_SCUD_Doc.DocDate                as DocDate
          , GP_SCUD_Doc_SP.Description         as Description
          , GP_SCUD_Doc_SP.Nrec                as cGp_SCUD_DOC_SP
          , GP_SCUD_Doc.Nrec                   as cGp_SCUD_DOC
          , COALESCE(GP_Status.Name,'')        as Status
          , CASe WHEN GP_SCUD_Doc.cStatus=:(pStat_Default) THEN 0
                 WHEN GP_SCUD_Doc.cStatus=:(pStat_ConFirm) THEN 2
                 ELSE 1 END as STAT_DEF
      from GP_SCUD_Doc_SP
      Inner join GP_SCUD_Doc on GP_SCUD_Doc.Nrec = GP_SCUD_Doc_SP.cGP_SCUD_Doc
                and GP_SCUD_Doc.wType=1010 //GP_iSC_statement_on_absence;//1010
                //and (GP_SCUD_Doc.cStatus<>:(pStat_Default) or :(All_Stat)=1)
                and (GP_SCUD_Doc.cStatus=:(pStat_ConFirm) or :(All_Stat)=1)

                and :(DT_B)<=GP_SCUD_Doc.DocDate
                and :(DT_E)>=GP_SCUD_Doc.DocDate
      Left outer join GP_Status on GP_Status.Nrec = GP_SCUD_Doc.cStatus
      Left Outer join GP_SCUD_Reason on
          GP_SCUD_Reason.Nrec = GP_SCUD_Doc.cReason
          /* CASE WHEN GP_SCUD_Doc_SP.cReason  <>#Comp(0)
                                     THEN GP_SCUD_Doc_SP.cReason
                                     ELSE GP_SCUD_Doc.cReason END*/

      where
        ( // z  :(DT_B)<=GP_SCUD_Doc_SP.EventDate
          // and :(DT_E)>=GP_SCUD_Doc_SP.EventDate
          :(_pScud_Pers)=GP_SCUD_Doc_SP.cGP_Scud_Pers
        )
      and (COALESCE(GP_Status.Name,'')<>'отклонен' or :(All_Stat)=1)
      into tmp_period;
    }
    _Except
    else
    { Timelog('GP_SCUD_StateMentOnAbsent->_Except:'+ExploreException);
    }
    _Finally
    {

    }
    if TimeLog_Status>0
      TimeLog(' отобрали '+string(RecordsInTable(#tmp_period)));
    if Getfirst tmp_period<>tsok exit;

    if bovisual
    { boVisibleRun:=true;
      LoadProtector;
      ReReadRecord(#tmp_period);
      ReScanPanel(#tmp_period);
    }
    _Dt := tmp_period.EventDate;
    Tm_B:= tmp_period.EventTmB; //  : time "Время события с"
    Tm_E:= tmp_period.EventTmE; //  : time "Время события по"
    Plan_Time:=GetPlanTime(_pScud_Pers,tmp_period.EventDate,Tm_B,Tm_E);
    _need_calc:= tmp_period.wType   ; // 0,1 - личные невыходы,2 - служебные, 3 - ГОСОБЯЗАНОСТИ
                                  // СЧИТАЕМ ТОЛЬКО 2!
    _cNrec:=tmp_period.cGp_SCUD_DOC;
    Result:=true;
  } //Function  GetPeriodWithOutMisConDuct(DT_B:date;TM_B:time;TM_E:time; var _need_calc:word ) :time;

  Function  GetNextPeriodWithOutMisConDuct(var _DT:date;var TM_B:time; var TM_E:time; var Plan_Time:time; var _need_calc:word; var _cNrec:comp ) :boolean;
  { Result:=false;
    if GetNext tmp_period<>tsok exit;
    _Dt := tmp_period.EventDate;
    Tm_B:= tmp_period.EventTmB; //  : time "Время события с"
    Tm_E:= tmp_period.EventTmE; //  : time "Время события по"
    Plan_Time:=GetPlanTime(tmp_period.cGP_Scud_Pers,tmp_period.EventDate,Tm_B,Tm_E);
    _need_calc:= tmp_period.wType   ; // 0,1 - личные невыходы,2 - служебные, 3 - ГОСОБЯЗАНОСТИ
    _cNrec:=tmp_period.cGp_SCUD_DOC;
    Result:=true;
  } //Function  GetNextPeriodWithOutMisConDuct(DT_B:var TM_B; var TM_E:time; var _need_calc:word ) :boolean;

  //------------------------------------
  // сохранить параметры
  //------------------------------------
  Procedure SaveParam;
  { if (boVisibleRun)
    {
      SaveMyDsk(wFilter  ,GetInterfaceName+'_wFilter');
      SaveMyDsk(DTB      ,GetInterfaceName+'_DTB');
      SaveMyDsk(DTE      ,GetInterfaceName+'_DTE');
      SaveMyDsk(wType_Reg,GetInterfaceName+'_wType_Reg');
      SaveMyDsk(sFlt_Description,GetInterfaceName+'_Description');
    }
    //-----------------------
    DoneMarker(Marker_GP_SCUD_Pers_A  , '' );
    DoneMarker(Marker_KatPodr_A       , '' );
    DoneMarker(Marker_GP_SCUD_Reason_A, '' );
    DoneMarker(Marker_GP_Status_A     , '' );
    //-----------------------
    DoneMarker(Marker_GP_SCUD_Pers  ,if(not boVisibleRun,'', GetInterfaceName+'_GP_SCUD_Pers'  ) );
    DoneMarker(Marker_KatPodr       ,if(not boVisibleRun,'', GetInterfaceName+'_KatPodr'       ) );
    DoneMarker(Marker_GP_SCUD_Reason,if(not boVisibleRun,'', GetInterfaceName+'_GP_SCUD_Reason') );
    DoneMarker(Marker_GP_Status     ,if(not boVisibleRun,'', GetInterfaceName+'_GP_Status'     ) );
  } //Procedure SaveParam;

  //------------------------------------
  // восстановить параметры
  //------------------------------------
  Procedure ReadParam;
  { if (boVisibleRun)
    {
      if not ReadMyDsk(wFilter,GetInterfaceName+'_wFilter',false) wFilter:=0;
      if not ReadMyDsk(DTB    ,GetInterfaceName+'_DTB'    ,false) DTB:=ZeroDate;
      if not ReadMyDsk(DTE    ,GetInterfaceName+'_DTE'    ,false) DTE:=ZeroDate;
      if not ReadMyDsk(wType_Reg,GetInterfaceName+'_wType_Reg',false) wType_Reg:=0;
      if not ReadMyDsk(sFlt_Description,GetInterfaceName+'_Description',false) sFlt_Description:='';
    }
    //--------------------------
    Marker_GP_SCUD_Pers    :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_GP_SCUD_Pers') , 8, 50, 10, True);
    Marker_KatPodr         :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_KatPodr'     ) , 8, 50, 10, True);
    Marker_GP_SCUD_Reason  :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_GP_SCUD_Pers') , 8, 50, 10, True);
    Marker_GP_Status       :=InitMarker(if(not boVisibleRun,'',GetInterfaceName+'_GP_Status'   ) , 8, 50, 10, True);
    //--------------------------
    Marker_GP_SCUD_Pers_A  :=InitMarker('' , 8, 50, 10, True);
    Marker_KatPodr_A       :=InitMarker('' , 8, 50, 10, True);
    Marker_GP_SCUD_Reason_A:=InitMarker('' , 8, 50, 10, True);
    Marker_GP_Status_A     :=InitMarker('' , 8, 50, 10, True);

  } //  Procedure ReadParam;

  //------------------------------------
  // декларация сложного фильтра
  //------------------------------------
  function isFilterAnCorrect(ww_nrec:comp): boolean; cacheable;
  { Result:=true;
    if ww_nrec=0 Exit;
    if FoundMarker(Marker_New,ww_nrec) then Exit;
    if isPodrShare
    {  if GP_SCUD_Doc.cKatPodr>0
       { if not EnablePodr(GP_SCUD_Doc.cKatPodr)
         { Result:=false;
           Exit;
         }
       }
       else
       { if GP_SCUD_Doc.cUser<>pUserID
         { Result:=false;
           Exit;
         }
       }
    }
    if IsBitCTW(wFilter,2)
    { if Count_KatPodr>1
      { If not FoundMarker(Marker_KatPodr,GP_SCUD_Doc.cKatPodr)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,4)
    { if Count_GP_SCUD_REason>1
      { If not FoundMarker(Marker_GP_SCUD_REason,GP_SCUD_Doc.cReason)
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,5)
    { if sFlt_Description<>''
      { if pos( upcase(sFlt_Description),upcase(GP_SCUD_Doc.Description))=0
        { Result:=false;
          Exit;
        }
      }
    }
    if IsBitCTW(wFilter,6)
    { if Count_GP_Status>1
      { If not FoundMarker(Marker_GP_Status,GP_SCUD_Doc.cStatus)
        { Result:=false;
          Exit;
        }
      }
    }
  }//function isFilterAnCorrect(ww_nrec:comp): boolean;

  //-------------------------------------------
  // скопировать фильтры в данные для отборв
  //-------------------------------------------
  Procedure CopyToA;
  { CopyMarker(Marker_GP_SCUD_Pers_A   ,Marker_GP_SCUD_Pers  );
    CopyMarker(Marker_GP_SCUD_Reason_A ,Marker_GP_SCUD_Reason);
    CopyMarker(Marker_GP_Status_A      ,Marker_GP_Status     );
    CopyMarker(Marker_KatPodr_A        ,Marker_KatPodr);
    wType_Reg_A     :=wType_Reg     ;
    sFlt_Description_A:=sFlt_Description;
    DTB_A:=DTB;
    DTE_A:=DTE;
    wFilter_A:=wFilter;
  } //Procedure CopyToA;


  //-------------------------------------------
  // восстановить данные для задания фильтрации
  // из данных для отбора
  //-------------------------------------------
  Procedure RestFromA;
  { CopyMarker(Marker_GP_SCUD_Pers   ,Marker_GP_SCUD_Pers_A  );
    CopyMarker(Marker_GP_SCUD_Reason ,Marker_GP_SCUD_Reason_A);
    CopyMarker(Marker_GP_Status      ,Marker_GP_Status_A     );
    CopyMarker(Marker_KatPodr        ,Marker_KatPodr_A);
    wType_Reg     :=wType_Reg_A     ;
    sFlt_Description:=sFlt_Description_A;
    DTB    :=DTB_A;
    DTE    :=DTE_A;
    set wFilter:=wFilter_A;
  } //Procedure RestFromA;

  //-------------------------------------------
  #doc
    Установить ограничения
  #end
  Function SetFilterBounds(_IsArch:word) : boolean;
  { Result:=false;
    isFilterRun:=True;
    if ConditionActiveInLeave(tcFilterAn, #GP_SCUD_Doc)
    { PopConditionForLeave(tcFilterAn, #GP_SCUD_Doc);
    }
    If BoundActive(tbByGP_SCUD_Reason) SubBounds(tbByGP_SCUD_Reason);
    If BoundActive(tbByGP_STatus     ) SubBounds(tbByGP_Status     );
    If BoundActive(tbByKatPodr       ) SubBounds(tbByKatPodr);
    If BoundActive(tbByPeriodBeg     ) SubBounds(tbByPeriodBeg  );
    If BoundActive(tbByPeriodEnd     ) SubBounds(tbByPeriodEnd  );
    If BoundActive(tbByFilter        ) SubBounds(tbByFilter);
    //-----------------------
    wCount_Filter:=0;
    sTitle_Filter:='';
    //-----------------------
    ClearMarker(Marker_New);
    mtClear(tntFilteredRecs, mfNormal);
    ReInitTable(tnGP_SCUD_Doc, mfNormal);
    //-----------------------------
    var need_FilterAn:boolean=false;
    if IsBitCTW(wFilter,1)
    { if DTB<>ZeroDate   AddBounds(tbByPeriodBeg  );
      if DTE<>ZeroDate   AddBounds(tbByPeriodEnd  );
      wCount_Filter++;
      if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по дате документа';
    }
    if IsBitCTW(wFilter,2)
    {  Count_KatPodr:=GetMarkerCount(Marker_Katpodr);
       GetMarker(Marker_KatPodr,0,pFlt_KatPodr);
       if Count_KatPodr=1
       { AddBounds(tbByKatPodr);
       }
       else need_FilterAn:=true;
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по подразделению';
    }

    if IsBitCTW(wFilter,3)
    {  
      Count_GP_SCUD_Pers:=GetMarkerCount(Marker_GP_SCUD_Pers);
      var iQBuilder: GP_QueryBuilder;
      var qry: longint;
      sqlFreeStr(qry);
      sqlAddStr(qry, 'select GP_SCUD_Doc.NRec from GP_SCUD_Doc inner join GP_SCUD_Doc_SP on GP_SCUD_Doc.NRec = GP_SCUD_Doc_SP.cGP_SCUD_Doc where ');
      sqlAddStr(qry, iQBuilder.MakeCriteriaFromMarker('GP_SCUD_Doc_SP.cGP_SCUD_Pers', Marker_GP_SCUD_Pers));
      sqlSelectIntoByName(qry, tntFilteredRecs);
      AddBounds(tbByFilter);
      ReInitTable(tnGP_SCUD_Doc, fmMemory + fmWriteThru + mfFilters);
      MTRetrieve(tnGP_SCUD_Doc, mfClear + mfFilters);
      wCount_Filter++;
      if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по сотруднику';
    }
    if IsBitCTW(wFilter,4)
    {  Count_GP_SCUD_Reason:=GetMarkerCount(Marker_GP_SCUD_Reason);
       GetMarker(Marker_GP_SCUD_Reason,0,pFlt_GP_SCUD_Reason);
       if Count_GP_SCUD_Reason=1
       {
         AddBounds(tbByGP_SCUD_Reason);
       }
       else need_FilterAn:=true;
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по цели выхода';
    }
    if IsBitCTW(wFilter,5)
    { need_FilterAn:=true;
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по основанию';
    }
    if IsBitCTW(wFilter,6)
    {  Count_GP_Status:=GetMarkerCount(Marker_GP_Status);
       GetMarker(Marker_GP_Status,0,pFlt_GP_Status);
       if Count_GP_Status=1
       {
         AddBounds(tbByGP_Status);
       }
       else need_FilterAn:=true;
       wCount_Filter++;
       if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по статусу';
    }
    if isPodrShare
    { need_FilterAn:=true;
      wCount_Filter++;
      if wCount_Filter<4 sTitle_Filter:=sTitle_Filter+if(length(sTitle_Filter)>0,',','')+'по правам доступа на подразделению';

    }
    if wCount_Filter>3 sTitle_Filter:=sTitle_Filter+' и еще '+string(wCount_Filter-3)+' фильтров';
    MySetTitle;

    //----------------------
    // использование сложного фильтра
    //----------------------
    ClearFuncCache; // очистим кэш функций
    if need_FilterAn
    { PushConditionForLeave(tcFilterAn, #GP_SCUD_Doc);
    }
    //----------------------
    ReReadRecord(#GP_SCUD_Doc);
    if getlast GP_SCUD_Doc<>tsok
    { //сначала вернемся к последнему, потом сбросим совсем
      timelog('GP_SCUD_StateMentOnAbsent->SetFilterBounds нет записей проход='+string(_IsArch));
      case  _IsArch of
      0:
      { if wfilter<>0
        { message('Данных по условиям фильтра не обнаружено');
          RestFromA;
          SetFilterBounds(1);
        }
      }
      1:{
        if wfilter<>0
        { set wfilter:=wfilter_A:=0;
          SetFilterBounds(2);
        }
      }
      end;
    }
    else
    { //сохраняем фильтр
      CopyToA;
    }
    ReScanPanel(#GP_SCUD_Doc);

    Result:=true;
    isFilterRun:=False;

  } //Function SetFilterBounds : boolean;

  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_Katpodr
    { #mrkfiltr_(Katpodr_Flt,Katpodr,Nrec,wc_nrec,Katpodr_Flt.Kod+','+Katpodr_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_GP_SCUD_Pers
    { #mrkfiltr_(GP_SCUD_Pers_Flt,GP_SCUD_Pers,Nrec,wc_nrec,GP_SCUD_Pers_Flt.Fio)
    }
    if _Field=0 or _Field=#Filtr_GP_SCUD_Reason
    { #mrkfiltr_(GP_SCUD_Reason_Flt,GP_SCUD_Reason,Nrec,wc_nrec,GP_SCUD_Reason_Flt.Name)
    }
    if _Field=0 or _Field=#Filtr_GP_Status
    { #mrkfiltr_(GP_Status_Flt,GP_Status,Nrec,wc_nrec,GP_Status_Flt.Name)
    }
    ReScanPanel(#KatPodr_Flt);
  } //Procedure SetFilterNM(_Field:longint)



