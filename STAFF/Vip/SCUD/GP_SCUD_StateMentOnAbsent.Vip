//-------------------------------------
//получить следующего подписанта
//-------------------------------------
function GetNextPodpisant(_status:string;_pDoc:comp) : comp; cacheable;
{ #__UNUSED__(_status,_pDoc)
  var _pPersons:comp=0;
  var _pPersFrom:comp=0;
  var _pPost:comp=0;
  var isAllOk:boolean=true;
  Result:=GetRukPodr(GP_SCUD_DOC.cKatPodr);
  if GetReasonType<>2 // поручение
  { //по протоколу от 12.02.2018, пп  временно убираем
    //В заявлениях на отсутствие за прошлый период убрать настройку <Согласование
    //Заместителем директора> (сделать строчку не активной, но с возможностью восстановления настройки при необходимости).
    if False
    if GP_SCUD_Doc.DocDate<=GP_SCUD_Doc.DInput
    { //if GP_Status.Name='исполняемый'  or GP_Status.Name='согласован'
      //or GP_Status.Name='утвержден'
        if Result>0
        { _pPersFrom:=Result;
        }
        else
        { PushPos(#GP_SCUD_Doc_SP) ;
          if getfirst GP_SCUD_Doc_SP<>tsok
          { isAllOk:=false;
          }
          else
          if getfirst GP_SCUD_Pers<>tsok {isAllOk:=false}
          else _pPersFrom:=GP_SCUD_Pers.cPersons;
          PopPos(#GP_SCUD_Doc_SP);
        }
        if not isAllok exit;
        Get_Func_Boss_By_Pers(_pPersFrom,_pPost,_pPersons);
        if _pPersons<>0
              Result:=_pPersons;
    } //if GP_SCUD_Doc.DocDate>=Date(GP_SCUD_Doc.DInput)
  } //if GetReasonType<>2 // поручение
} //function GetNextPodpisant(_status:string;_pDoc:comp) : comp; cacheable;

