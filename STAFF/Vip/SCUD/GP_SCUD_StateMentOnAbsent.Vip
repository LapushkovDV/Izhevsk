//------------------------------
 HandleEvent
  cmOpenSearch:
  { abort;
  }
  cmDoGetNext:
  { abort;
  }
  cmDoGetPrev:
  { abort;
  }
  cmInit:
  {   //--- если вдруг пришли снаружи
      wTypeDoc:=GetTypeDoc;
      //--
      Timelog('GP_SCUD_StateMentOnAbsent->wnEdit-cmInit:wTypeDoc='+string(wTypeDoc));
      if UserAccessService.OnlyUserDoc(wTypeDoc)
      { if GP_SCUD_DOC.cUser<>pUserId
        { Message('У вас нет прав на просмотр этого документа!');
          abort;
        }
      }
      boWinEdit:=true;
      //ReScanPanel(#GP_SCUD_Doc);
      //ReReadRecord(#GP_SCUD_Doc);
  }
  cmPrintDoc : PrintDoc;
  cmDone:
  { if Not MyCheckRecord abort;
    boWinEdit:=false;
  }
  cmValue33:
  { if GP_SCUD_DOC.cStatus<>pStatus_GetDefault
    { Message('Изменение документа возможно'+chr(13)+'только в оформляемом статусе!');
      exit;
    }
    if message('Заполнить по всей спецификации заявления'
      +chr(13) + 'период заявления временем начала'
      +chr(13) +' и окончания работы из графика?'
        , YesNo )<>cmYes Exit;
    UpdateTable;
    StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Заполнение периодов',0);
    PushPos(#GP_SCUD_DOC_SP);
    // возможно правильней и не блокировать
    boPositionChange_Lock:=true;
    _Loop fullcache GP_SCUD_DOC_SP
    { if not nextvisual then break;
      if GP_SCUD_DOC_SP.cGP_SCUD_Pers=0 then continue;
      //iGP_SCUD_EventsEdit.Fill_Graff_info(GP_SCUD_DOC_SP.cGP_SCUD_Pers,year(GP_SCUD_DOC.DocDate),month(GP_SCUD_DOC.DocDate),0);
      iGP_SCUD_EventsEdit.Fill_Graff_info(GP_SCUD_DOC_SP.cGP_SCUD_Pers,year(GP_SCUD_DOC.DocDate),month(GP_SCUD_DOC.DocDate)
        ,0 //_wTypeFill
        ,Day(GP_SCUD_DOC.DocDate) //_DayCalc
        );
      GP_SCUD_Doc_Sp.EventTmB:=iGP_SCUD_EventsEdit.GetTimeFromDouble(iGP_SCUD_EventsEdit.GetExtData(6,Day(GP_SCUD_DOC.DocDate)));
      GP_SCUD_Doc_Sp.EventTmE:=iGP_SCUD_EventsEdit.GetTimeFromDouble(iGP_SCUD_EventsEdit.GetExtData(7,Day(GP_SCUD_DOC.DocDate)));
      update current GP_SCUD_Doc_Sp;
    } //_Loop GP_SCUD_DOC_SP
    boPositionChange_Lock:=false;
    PopPos(#GP_SCUD_DOC_SP);
    PositionChanged_SP;
    ReScanPanel(#GP_SCUD_DOC_SP);
    StopVisual('',0);
  }
  end;
end;//Window wnEdit

