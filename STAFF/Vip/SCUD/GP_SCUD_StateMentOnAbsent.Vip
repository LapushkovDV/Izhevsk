//------------------------------------
// декларация сложного фильтра
//------------------------------------
function isFilterAnCorrect(ww_nrec:comp): boolean; forward;
Function getHoursInDocAbsentForPersInCurrentMonth(_cGP_Scud_Pers : comp;_cCurDoc : comp; _DOCDATE : date;_wType : word) : double; forward;
//-------------------
table struct tAbsentsInCurMonth
(
     DocDate  : date
    ,EventTmB : time
    ,EventTmE : time
)
with index
(
 ind1 = DocDate
)
;
Table Struct tmp_period
(   EventDate:date //   : date "Дата события"
  , EventTmB :time //  : time "Время события с"
  , EventTmE :time //  : time "Время события по"
  , wType    :word //  0 - личные невыходы,1 - служебные
  , NameType :String //  0 - личные невыходы,1 - служебные
  , cGP_Scud_Pers:comp
  , DocNumber:string[30]
  , DocDate:date
  , Description:string
  , cGp_SCUD_DOC_SP :comp
  , cGp_SCUD_DOC    :comp
  , Status  :string
  , STAT_DEF:word
)
with index
( tmp_period01 = EventDate + EventTmB
);
//--------------------------
Table Struct tmp_Reason
( cSpKau:comp
 ,wType :word
 ,sReason:string[150]
 ,sCode  :string[50]
)
with index
( tmp_Reason01 = wType+sReason
);

//-----------------
// Для множественного задания подписантов
table struct tmp_podp
( Nrec:comp
 ,NPP :word
 ,Name:string
 ,Fio :string
)
with index
(  tmp_podp01 = NPP + Name
  ,tmp_podp02 = Nrec
);

table struct tFilteredRecs (NRec: comp) (i1 = NRec);

//-------------------------------
#include GP_SCUD_Function.Var
#include GetKau.Var
//-------------------------------
var
//-------------------
  iGP_SCUD_EventsEdit :GP_SCUD_Ev_IN New;
  iGP_SCUD_ReasonEdit :GP_SCUD_ReasonEdit;
  iGP_SCUD_SaldoEdit  :GP_SCUD_SaldoEdit;


  oGP_Log : GP_Log;
  iCatFunc  : CatalogsFunctions;     // Переменная типа интерфейс CatalogsFunctions

//-------------------
  cRec    :Comp   ; // ссылка на группу
  pMarker :IMarker(Marker) new;
  Marker:longint;
  //------------------------
  email_num_row:longint;

  //-------------------------------
  cAttr_SCUD_RUK:comp;// ВА на вакансию руководителя к подразделению
  cAttr_SCUD_ZGD:comp;// ВА на вакансию ЗГД к подразделению
  cAttr_SCUD_ISP:comp;// исполнитель по умолчанию
  cAttr_SCUD_DOC_RUK :comp;// ВА на вакансию руководителя к документу
  cAttr_SCUD_DOC_RUKP:comp;// ВА на сотрудника рукаводителя к документу
  cAttr_SCUD_DOC_ZGD :comp;// ВА на вакансию ЗГД к документу
  cAttr_SCUD_DOC_ZGDP:comp;// ВА на сотрудника ЗГД к документу
  cAttr_SCUD_DOC_Refusal :comp;// ВА "Причина отклонения заявления на отсутствие" к документу
  cAttr_SCUD_DOCSP_IN    :comp;// ВА "Использовано сальдо" к спецификации документа
  //-----------------------------
  ZP_Period :date;//текущий период в модуле заработная плата
  boExternal :boolean; // при вызове снаружи блокируем вставку
//--- настройки
  NPOEM_OWN_SCUD_OVER2_SROC :word; // 'Кол-во месяцев учета переработки', ftword,36,'','');
  NPOEM_OWN_SCUD_OVER2_SROC_D:date;// 'Дата, до которой не учитывать переработку ', ftdate,'','','');
  NPOEM_OWN_SCUD_CAN_CHANGE_STATUS:word;//Разрешать изменение статуса в любых документах
  NPOEM_OWN_HEAD_V_VID:word;//В интерфейсе руководителя отображать
  NPOEM_OWN_SCUD_ZAbsent_Over2:word;// 'Отображать сальдо по переработке в заявлении на отсутствие
  NPOEM_OWN_SCUD_ZAbsent_REASON :word;//Аналитика для ведения причин заявления на отсутствие
  NPOEM_OWN_SCUD_ZAbsent_Refusal:word;//Аналитика для ведения причин отклонения заявления на отсутствие
  NPOEM_OWN_SCUD_DOC_InsINClosePeriod:boolean;//Разрешить ввод документов в закрытом периоде
  NPOEM_OWN_SCUD_OVER2_IN_APPL       :boolean;//Разрешить ввод сальдо на дату учета переработки в заявлениях
  NPOEM_OWN_SCUD_ZAbsent_PRINT_IN_DEF:boolean;//Разрешить печать заявлений на отсутствие в оформляемом статусе
  NPOEM_OWN_SCUD_ZAbsent_STATUS_M    :comp;//'Статус "утвержден" в заявлении на отсутствие'
  NPOEM_OWN_SCUD_ZAbsent_STATUS_C    :comp;//'Статус "отклонен" в заявлении на отсутствие'
  NPOEM_OWN_SCUD_ZAbsent_STATUS_C_E  :boolean;//'Отправлять Email при установке статуса "отклонен" в заявлении на отсутствие
  NPOEM_OWN_EMAIL_TYPE:word;//Тип отправки EMAIL
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter,wFilter_A:word;
   Marker_Count :longint;
    wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   Marker_Tmp  :longint;
   Marker_Podr :longint;
//-----------------------------------------
   #mrkfld_(KatPodr)
   #mrkfld_(GP_SCUD_Pers)
   #mrkfld_(GP_SCUD_Reason)
   #mrkfld_(GP_Status)
//-----------------------------------------

   DTB,DTE :date;
   DTB_A,DTE_A :date;
   pFlt_Katpodr        :comp;
   pFlt_GP_SCUD_Reason :comp;
   pFlt_GP_Status      :comp;
   sFlt_Description,sFlt_Description_A:string;
   wType_Reg,wType_Reg_A    :word;
//----- Для поиска остатков
   DT_OST:date; //срок учета переработки
   DT_OST_SROC_Month : word;
   DT_OST_SROC_Year  : word;
   UserPersNrec:comp;// Persons.Nrec текущего пользователя
Create View
var
  pGP_SCUD_Doc:comp;
as select GP_SCUD_Doc.Nrec
  , GP_SCUD_Saldo.CH_OVER2_OST(Fieldname=OVER2_OST,FieldTitle='Остаток по переработке')
  , Executor.GalDep
  , Executor.Fio
  , Executor.Nrec
  ,if(GP_SCUD_Doc.cReason=0,'-'
    ,iGP_SCUD_ReasonEdit.GetReasonTypeName(GP_SCUD_Reason.wType)) (Fieldname=Reason_Type, FieldTitle='Причина не выхода')
// ,GetPodpisPers(1) (FieldName=cPodp1)
// ,GetPodpisPers(2) (FieldName=cPodp2)
  , sGetAttrID(coGP_SCUD_Doc,GP_SCUD_Doc.Nrec,cAttr_SCUD_Doc_Refusal) (FieldName=Refusal,FieldTitle='Причина отказа')
  , getHoursInDocAbsentForPersInCurrentMonth(GP_Scud_Pers.nrec,GP_SCUD_DOC.nrec,GP_SCUD_DOC.DOCDATE,1) (FieldName=HRS_MON_PERSONAL,FieldTitle='Количество часов за месяц по личным заявлениям')
  , getHoursInDocAbsentForPersInCurrentMonth(GP_Scud_Pers.nrec,GP_SCUD_DOC.nrec,GP_SCUD_DOC.DOCDATE,2) (FieldName=HRS_MON_MANAGER ,FieldTitle='Количество часов за месяц по поручениям руководителя')

From
  GP_SCUD_Doc, GP_Status,GP_SCUD_Pers,GP_SCUD_Doc_SP
, tmp_period(tmp_period01)
, GP_SCUD_Reason
, tScud_Reason //права на типы выходов
, tmp_Reason
//, GP_SCUD_Reason GP_SCUD_Reason_SP
, Persons Executor
, x$users(readonly)
, GP_SCUD_Events    (GP_SCUD_EVENTS04)
, GP_SCUD_Saldo //- будем работать с объектом, но для отображения нужно
, GP_SCUD_Days // Распределение переработки по дням
, AttrVal AttrVal_Podp1
, tmp_podp(tmp_podp01)
//-------- для поиска, кто утвердил
//, GP_StatusChangeLog(STATUSCHANGELOG02)
, X$users Commit
//-------------------------------------
, KatPodr KatPodr_Flt
, KatPodr KatPodrCheck
, GP_SCUD_Pers GP_SCUD_PersCheck
, Persons PersonsCheck
, GP_SCUD_Pers GP_SCUD_Pers_Flt
, GP_SCUD_Reason GP_SCUD_Reason_Flt
, GP_SCUD_Reason GP_SCUD_ReasonCheck
, GP_Status      GP_Status_Flt
, tAbsentsInCurMonth
, tFilteredRecs
//--------------------

where
((  GP_iSC_statement_on_absence == GP_SCUD_Doc.wType
//and GP_SCUD_Doc.cReason /== tScud_Reason.cGP_Scud_Reason//права на заявления  по типам.
and GP_SCUD_Doc.cStatus   == GP_Status.Nrec
and GP_SCUD_Doc.cKatPodr  == KatPodr.Nrec
and GP_SCUD_Doc.cReason   == GP_SCUD_Reason.Nrec
and GP_SCUD_Reason.wType  == tmp_Reason.wType
and GP_SCUD_Doc.cExecutor == Executor.Nrec
and GP_SCUD_Doc.cUser     == x$users.Atl_nrec
and GP_SCUD_Doc.Nrec == GP_SCUD_Doc_SP.cGP_SCUD_Doc
and GP_SCUD_Doc_SP.cGP_SCUD_Pers ==  GP_SCUD_Pers.Nrec
//-- Для контроля необходимости заполнения поручения в спецификации
and NPOEM_OWN_SCUD_ZAbsent_REASON == SpKau.KodGrKau
and GP_SCUD_DOC.DESCRIPTION  == SpKau.Name
//--------------------------
and coKatPodr              == AttrVal_Podp1.wTable
and cAttr_SCUD_RUK         == AttrVal_Podp1.cAttrNam
and GP_SCUD_Doc.cKatPodr   == AttrVal_Podp1.cRec

//and GP_SCUD_Doc_SP.cReason == GP_SCUD_Reason_SP.Nrec
//-------------------------
and GP_SCUD_Doc_SP.cGP_SCUD_Pers == GP_SCUD_SALDO.cGP_SCUD_Pers
and DT_OST_SROC_Year             == GP_SCUD_SALDO.YearN
and DT_OST_SROC_Month            == GP_SCUD_SALDO.MesN
//-------------------------
//-------- для поиска, кто утвердил
//and coGP_SCUD_Doc       ==  GP_StatusChangeLog.wTbl
//and GP_SCUD_Doc.Nrec    == GP_StatusChangeLog.cDoc
and GP_SCUD_Doc.CSTATUS == GP_StatusChangeLog.CSTATUSTO(noindex)
and GP_StatusChangeLog.CUSER    == Commit.Atl_nrec
//------------- события
and GP_SCUD_Doc_SP.cGP_SCUD_Pers  == GP_SCUD_Events.cGP_SCUD_Pers//(noindex)
and GP_SCUD_Doc.DocDate           == GP_SCUD_Events.EnterDate
and GP_SCUD_Doc_SP.EventTMB       <<=GP_SCUD_Events.EnterTime
and GP_SCUD_Doc_SP.EventTME       >>=GP_SCUD_Events.EnterTime
//----------------------
and GP_SCUD_Doc_SP.Nrec == GP_SCUD_Days.cGP_SCUD_Doc_SP
and 1                   == GP_SCUD_Days.wType
and 2                   == GP_SCUD_Days.wVid
//-------------------------
//-----------------------
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == GP_SCUD_Pers_Flt.Nrec
and wc_nrec == GP_SCUD_Reason_Flt.Nrec
and wc_nrec == GP_Status_Flt.Nrec
))
Bounds byKatpodr        pFlt_KatPodr    == GP_SCUD_Doc.cKatPodr(noindex) ordered by TableOrder
Bounds byPeriodBeg      DTB   <<= GP_SCUD_Doc.DocDate(noindex) ordered by TableOrder
Bounds byPeriodEnd      DTE   >>= GP_SCUD_Doc.DocDate(noindex) ordered by TableOrder
Bounds byGP_SCUD_Reason pFlt_GP_SCUD_Reason == GP_SCUD_Doc.cReason(Noindex)
Bounds byGP_Status      pFlt_GP_Status      == GP_SCUD_Doc.cStatus(Noindex)
Bounds byUserID         pUserId == GP_SCUD_Doc.cUser(noindex)  ordered by TableOrder
Bounds byNrec           pGP_SCUD_Doc == GP_SCUD_Doc.Nrec(noindex) ordered by TableOrder
Bounds byReasonRights   GP_SCUD_Doc.cReason /== tScud_Reason.cGP_Scud_Reason//права на заявления  по типам.
Bounds byFilter         GP_SCUD_Doc.NRec /== tFilteredRecs.NRec
condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_DOC.Nrec))

;
Create view vPodp
var
  cPodp1,cPodp2:comp;
as select Persons_Podp1.Fio,Persons_Podp2.Fio
from
  Persons Persons_Podp1
, Persons Persons_Podp2
where ((
    cPodp1 == Persons_Podp1.Nrec
and cPodp2 == Persons_Podp2.Nrec
));

//---------------------------
//
//---------------------------
Create view vApp
var
  pPersons:comp;
  DBeg :date;
as select Appointments.Nrec
From Appointments
where ((
    pPersons == Appointments.Person
and 0        == Appointments.LPrizn
and DBeg     >>=Appointments.AppointDate
 )); //Create view vApp

Create view vAppVrem
var
  pPersons:comp;
  DBeg :date;
as select Appointments.Nrec
From Appointments
where ((
    pPersons == Appointments.Person
and 70       == Appointments.LPrizn
and (
      DBeg     >=  Appointments.AppointDate
      and
      DBeg     <=  Appointments.DateEnd
    )
)); //Create view vAppVrem

//-----------------------------------------------
Create view vRejim
var
  wRejim:word;// GetRejimDay
  wYear, wMonth : word;
as select  GP_KlndrExt.Rejim
From GP_KlndrExt
where
((
  wRejim    == GP_KlndrExt.Rejim
and wYear   == GP_KlndrExt.YearK
and wMonth  == GP_KlndrExt.MonthK
)); //Create view vRejim

create view vSpr
var pSpKau:comp;
as select SpKau.Name
, SPKAU.LEVELCODE //есть  * - нужно заполнить в спецификации поручение
From SpKau
where ((
  pSpKau == SpKau.Nrec
));

