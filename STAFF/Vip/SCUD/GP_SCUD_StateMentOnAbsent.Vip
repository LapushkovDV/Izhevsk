  #doc
   Установить позицию
  #end
  Function SetDocPosition(_wTypeDoc:word;_cDoc:comp;_cDocSp:comp):boolean;
  { Result:=false;
    if _wTypeDoc=0 _wTypeDoc:=GetTypeDoc;
    if getfirst GP_SCUD_Doc where (( _cDoc == GP_SCUD_Doc.Nrec )) <>tsok then exit;
    if _cDocSp>0
    { if getfirst GP_SCUD_Doc_SP where (( _cDocSP == GP_SCUD_Doc_SP.Nrec )) <>tsok then exit;
    }
    Result:=true;
  } //Function SetDocPosition(_wTypeDoc:word;_cDoc:comp;_cDocSp:comp):boolean;

  //-------------------------------------
  #doc
    Найти сотрудника на ставке на дату заявления
  #end
  Function PersNrecByStaff(_pStaffStruct:comp) :comp;
  { Result:=0;
    var _DDate:date=GP_SCUD_DOC.DocDate;//
    if _DDate=ZeroDate then _DDate:=Cur_Date();
    _Try
    {
      sql
      select Appointments.Person
      from StaffStruct
      Inner join Appointments on Appointments.StaffStr = :(_pStaffStruct)
           and ( (     Appointments.lPrizn<>2
                   and ( Appointments.DisMissDate=#Date(0,0,0)
                      or Appointments.DisMissDate>:(_DDate)
                       )
                 )
                 or
                 (     Appointments.lPrizn=2
                   and ( Appointments.DateEnd=#Date(0,0,0)
                      or Appointments.DateEnd>:(_DDate)
                       )
                 )

             )
           and Appointments.AppointDate<=:(_DDate)
      //надо вывести там, где нет заместительства
      left outer join Appointments Appointments_Zam on Appointments_Zam.StaffStr = :(_pStaffStruct)
            and Appointments_Zam.lPrizn=2 and Appointments_Zam.Nrec<>Appointments.Nrec
            and Appointments_Zam.Person<>#comp(0)
           and  ( Appointments_Zam.DateEnd=#Date(0,0,0)
               or Appointments_Zam.DateEnd>:(_DDate)
                 )
           and Appointments_Zam.AppointDate<=:(_DDate)
      where ( StaffStruct.Nrec =:(_pStaffStruct))  and (Appointments_Zam.Nrec is Null)
          and coalesce(Appointments.Person, #comp(0h)) <> #comp(0h)

      into (Result);

    }
    // иначе сообщения ничего
    _Except
    else
    {
    }
  } //Function PersNrecByStaff(_pStaffStruct:comp) :comp;

  //-------------------------------------
  #doc
   Найти подписанта, выполнять с 1,2 и т.д до тех пор пока не вернет 0
  #end
  Function GetPodpisPersZam(_num:word;_cPodr:comp;_pDoc:comp;_boReload:boolean=false):comp;// нельзя cacheable;
  { Result:=0;
    var _pAttrNam :comp=0;
    var _pAttrNamD:comp=0;
    var _pAttrNamP:comp=0;
    var _sStaffStruct:string='';
    var _pStaffStruct:comp  =0;
    var _pPersons:comp=0;
    if timelog_status>0 timelog('GetPodpisPersZam:_pDoc='+string(_pDoc,0,0)+', _num='+string(_num));
    if (not _boReload) and _pDoc>0
    { case _num of
      1:
      { Result:=coGetAttrID(coGP_SCUD_DOC,_pDoc,cAttr_SCUD_DOC_RUKP);
        _pStaffStruct:=coGetAttrID(coGP_SCUD_DOC,_pDoc,cAttr_SCUD_DOC_RUK);
      }
      2:
      { Result:=coGetAttrID(coGP_SCUD_DOC,_pDoc,cAttr_SCUD_DOC_ZGDP);
        _pStaffStruct:=coGetAttrID(coGP_SCUD_DOC,_pDoc,cAttr_SCUD_DOC_ZGD);
      }
      end;
      if timelog_status>0
      { timelog('GetPodpisPersZam:_pStaffStruct='+string(_pStaffStruct,0,0)+' , Result='+String(Result,0,0));
      }
      if Result<>0 then Exit;
    } //if (not _boReload) and _pDoc>0
    // определим атрибуты
    Case  _num of
    1:
    { _pAttrNam :=cAttr_SCUD_RUK;
      _pAttrNamD:=cAttr_SCUD_Doc_RUK;
      _pAttrNamP:=cAttr_SCUD_Doc_RUKP;
    }
    2:
    { _pAttrNam :=cAttr_SCUD_ZGD;
      _pAttrNamD:=cAttr_SCUD_Doc_ZGD;
      _pAttrNamP:=cAttr_SCUD_Doc_ZGDP;
    }
    end;
    if timelog_status>0
      timelog('GetPodpisPersZam:_pAttrNamP='+string(_pAttrNamP,0,0));

    if _pStaffStruct=0
    { _pStaffStruct:=coGetAttrID(coKatPodr,_cPodr,_pAttrNam);
      if _pStaffStruct>0 and _pDoc>0
      { _sStaffStruct:=sGetAttrID (coKatPodr,_cPodr,_pAttrNam);
        coSetAttrID(coGP_SCUD_DOC,_pDoc,_pAttrNamD,_pStaffStruct,_sStaffStruct);
      }
    } //if _pStaffStruct=0
    //------------------
    // не нашли - определим из полей
    if _pStaffStruct=0
    { Case  _num of
      1:
      { _pPersons:=GetRukPodr(_cPodr);
        // Здесь как то нужно  сохранить
        if _pPersons>0 and _pDoc>0
        {
        }
      }
      //----------------------
      2:
      {

      }
      end;
    } //if _pStaffStruct=0
    else
    { _pPersons:=PersNrecByStaff(_pStaffStruct);
    } //else if _pStaffStruct=0
    Result:=_pPersons;
    if _pPersons>0
    { if timelog_status>0
      { timelog('GetPodpisPersZam:_pAttrNamP='+string(_pAttrNamP,0,0)+', _pPersons='+string(_pPersons));
      }
      coSetAttrID(coGP_SCUD_DOC,_pDoc,_pAttrNamP,_pPersons,#ShowKau(cgKau_Persons,_pPersons));
    }
  }//Function GetPodpisPersZam(_num:word):comp;

  //-------------------------------------
  #doc
   Найти подписанта, выполнять с 1,2 и т.д до тех пор пока не вернет 0
  #end
  Function GetPodpisPers(_num:word;_cPodr:comp;_pDoc:comp):comp;cacheable;
  {
    Result:=GetPodpisPersZam(_num,_cPodr,_pDoc,false);
    if Result<>0 then exit;
    Case _num of
    1: Result:=GetRukPodr(_cPodr);
    2:
    { Result:=GetNextPodpisant(GP_Status.Name,GP_SCUD_DOC.nrec);
      if Result=GetRukPodr(GP_SCUD_DOC.cKatpodr)
       Result:=0;
    }
    end; //Case _num of
    if Timelog_Status>0
    { timelog('GP_SCUD_StateMentOnAbsent->GetPodpisPers:_num='+string(_num)+', Result='+string(Result,0,0));
    }
  } //Function GetPodpisPers(_num:word):comp;

  Function GetPodpisPersS(_num:word;_cPodr:comp;_pDoc:comp):string;cacheable;
  { Result:='';
    var _pPersons:comp=GetPodpisPers(_num,_cPodr,_pDoc);
    if _pPersons>0
      Result:=MyGetInitial(ShowKau(cgKau_Persons,_pPersons),True);
  } //Function GetPodpisPers(_num:word):comp;


  Procedure SetPodpisantByDef;
  var ii:word;
  { if GP_SCUD_DOC.cKatpodr=0 then Exit;
    for(ii:=1;ii<=2;ii++)
    { GetPodpisPersZam(ii,GP_SCUD_DOC.cKatPodr,GP_SCUD_DOC.Nrec,true);
    }//for(ii:=1;ii<=2;ii++)
  } //Procedure SetAttrByDef;

//---------------------------
// Заполнить таблицу с подписями
//---------------------------
Procedure Fill_Tmp_podp;
var _wNpp:word;
    _cRec:comp;
{ delete all from tmp_podp;
  if Gp_Scud_Doc.cKatpodr=0 then exit;
  _cRec:=coGetAttrID(coKatPodr,KatPodr.NRec,cAttr_SCUD_RUK);
  insert into tmp_podp  set
     tmp_podp.Nrec:= _cRec
    ,tmp_podp.Name:= sGetAttrID(coKatPodr,KatPodr.NRec,cAttr_SCUD_RUK)
    ,tmp_podp.NPP:=1
    ,tmp_podp.Fio:=#ShowKau(cgKau_Persons,PersNrecByStaff(_cRec))
    ;
  _wNpp:=1;
  if getfirst AttrVal_Podp1<>tsok then exit;
  var hfile : longint;
  var sTmp  : string;
  hfile := CreateFileHandle('');
  if not File_OpenMemo(AttrVal_Podp1.VLVAR,hfile)
  { File_Close(hfile);
    exit;
  }
  File_Seek(hfile,0);
  while not File_Eof(hfile)
  { _wNpp++;
    File_ReadLn(sTmp,hfile);
    tmp_Podp.Nrec:=comp(substr(sTmp,1,pos(';',sTmp)-1));
    tmp_Podp.Name:=substr(sTmp,pos(';',sTmp)+1,200);
    tmp_Podp.NPP :=_wNpp;
    tmp_podp.Fio:=#ShowKau(cgKau_Persons,PersNrecByStaff(tmp_Podp.Nrec));
    insert current tmp_Podp;
  }
  File_Close(hfile);
} //Procedure Fill_Tmp_podp;


  //---------------------
  // Проверим возможность смены статуса или удаления
  //---------------------
  Function Can_Change_Status:boolean;
  { Result:=true;
    _Loop GP_SCUD_Days where
    ((   GP_SCUD_Doc.Nrec == GP_SCUD_Days.cGP_SCUD_Doc
      and 1               == GP_SCUD_Days.wType
      and 2               == GP_SCUD_Days.wVid
      and DT_OST          >> GP_SCUD_Days.EventDate
    ))
    { Result:=false;
      break;
    } //_Loop GP_SCUD_Doc
  } //Function Can_Chnge_Status:boolean;

  Function Calc_Saldo(_nrec:comp; _boAlways:boolean=false) : double; Cacheable;
  { Result:=0;
    timelog('GP_SCUD_StateMentOnAbsent->Calc_Saldo:'+string(_nrec,0,0) );
    if not _boAlways
      if NPOEM_OWN_SCUD_ZAbsent_Over2=0 then exit;
    var _PeriodBegin:date=GP_SCUD_Doc.DocDate;//GP_SCUD_DOC_SP.EventDate;
    var buf:Type$GP_SCUD_SALDO ;
    var _wMes :word;
    var _wYear:word;

    _wMes:=month(_PeriodBegin);
    _wYear:=year(_PeriodBegin);
    var _DtBeg:date;
    _DtBeg:=date(1,month(_PeriodBegin),year(_PeriodBegin));
    _DtBeg:=Sub_Months(_DtBeg,NPOEM_OWN_SCUD_OVER2_SROC);
    var _chas :double=0;
    if DT_OST>_DtBeg
    { _DtBeg:=DT_OST;
    }
    // здесь будет записано сколько часов уже есть
    do
    { timelog('GP_SCUD_StateMentOnAbsent->Calc_Saldo:wYear='+string(_wYear)+', wMes='+string(_wMes));
      if iGP_SCUD_SaldoEdit.GetSaldoBuf(GP_SCUD_DOC_SP.cGP_SCUD_Pers,_wYear,_wMes,false,buf)
      { 
        _chas := _chas 
               + if(_DtBeg = date(1,_wMes,_wYear), buf.CH_Over2_Ost,0)
               + buf.CH_Over2_Cur
               - buf.CH_Over2_Opl; //уже израсходовано
        //break; Будем пересчитывать
      }//if iGP_SCUD_SaldoEdit.GetSaldoBuf(pGP_SCUD_Pers,wYear,wMes,false,buf)
      else
      { break;
      }
      timelog('GP_SCUD_StateMentOnAbsent->Calc_Saldo:_chas='+string(_chas,0,2));

      _wMes:=_wMes-1;
      if _wMes=0
      { _wMes:=12;
        _wYear:=_wYear-1;
      }
    } 
    while _DtBeg <= date(1,_wMes,_wYear);
    Result:=_chas;
  } //Function Calc_Saldo(_nrec:comp) : time;

  //===============================================================
  // Записать текст сообщения
  //===============================================================
Function getHoursInDocAbsentForPersInCurrentMonth(_cGP_Scud_Pers : comp;_cCurDoc : comp; _DOCDATE : date;_wType : word) : double;
{
  // _wType  - 1 - личное 2 - руководителя
  var _result : double = 0;

  var _datebegMonth : date = date(01,month(_DOCDATE),year(_DOCDATE));
  var _dateEndMonth : date  = date(last_day(_DOCDATE),month(_DOCDATE),year(_DOCDATE));

  if   // GP_SCUD_REASON.WTYPE = 1 // личное заявление
     GP_SCUD_Doc.wType = 1010 // заявления на отсутствие
    and _DOCDATE >= date(01,08,2019) // только с августа работает
  {
     delete all tAbsentsInCurMonth;
    _try
      {
         sql
          select
             GP_SCUD_Doc.DocDate
            ,GP_SCUD_Doc_Sp.EventTmB
            ,GP_SCUD_Doc_Sp.EventTmE
          from GP_SCUD_Doc
          join GP_Status on GP_Status.Nrec   = GP_SCUD_Doc.cStatus
          join GP_SCUD_Reason on GP_SCUD_Reason.Nrec = GP_SCUD_Doc.cReason
                             and GP_SCUD_Reason.wType  = :(_wType)
          join GP_SCUD_Doc_SP on GP_SCUD_Doc_SP.cGP_SCUD_Doc = GP_SCUD_Doc.Nrec

          where   GP_SCUD_Doc.wType = 1010 //GP_iSC_statement_on_absence
              and GP_SCUD_Doc_SP.cGP_SCUD_Pers = :(_cGP_Scud_Pers) //#comp(2814749767120407)
              and GP_SCUD_Doc.DocDate >= :(_datebegMonth)
              and GP_SCUD_Doc.DocDate <= :(_dateEndMonth)
              and GP_SCUD_Doc.nrec <> :(_cCurDoc)
              and GP_Status.name not in ('черновик','отклонен')
          into tAbsentsInCurMonth
              ;
      }
     _except else {}

    _loop tAbsentsInCurMonth
     {
      _result := _result + iGP_SCUD_Function.GetDoubleFromTime(GetPlanTime(_cGP_Scud_Pers,tAbsentsInCurMonth.DocDate,tAbsentsInCurMonth.EventTmB,tAbsentsInCurMonth.EventTmE));
     }
  }
  result := _result;
}
Procedure Write_Mess(w:string);
  { email_num_row++;
    //Email_Write_Text(email_num_row,w);
  } //Procedure Write_Mess(w:string);

  //-------------------------------------
  #doc
  выполнить проверку перед изменением статуса
  Личное заявление на отсутствие. то система проверяет сколько часов переработок
  у сотрудника уже имеется и не дает создавать заявление,
  если это количество отрицательное (было взято ранее в счет будущих периодов и не отработано).
  Используемые часы переработок учитываются по принципу LIFO
  (сначала используем последние), необходим функционал <аннулирования> часов прошлых периодов.
  #end
  Function oGP_SCUD_Base.Check_Status_Change_Before(_pStatus:comp):boolean;
  var _PeriodBegin:date;
      _Day    :word;
      _chas   :double;
      _chas1  :double;
      ww_Str:string;
  { Result:=true;
    Timelog('GP_SCUD_StateMentOnAbsent->Check_Status_Change_Before,_pStatus= '+string(_pStatus,0,0) );
    if not Can_Change_Status
    { Message('По документу есть распределение за закрытые периоды');
      Result:=false;
      exit;
    }
    if _pStatus<>Status.GetDefault exit;

    _PeriodBegin:=GP_Scud_Doc.DocDate;
    var isAllOk:boolean=true;
    if Length(GP_SCUD_DOC.DESCRIPTION)<4
    { oGP_Log.Write(GetDocumentName+' Не заполнено основание');
      isAllOk:=False;

    }
    if GP_SCUD_DOC.cReason=0
    { oGP_Log.Write(GetDocumentName+' Не заполнена цель выхода');
      isAllOk:=False;

    }

    Result:=isAllOk;
    Timelog('GP_SCUD_StateMentOnAbsent->Check_Status_Change_Before:Result 01='+string(Result) );
    if GetReasonType<>1 exit; // личное заявление
    ClearFuncCache;

    StartNewVisual(vtNumericVisual,vfTimer ,'Проверка данных',0);
    PushPos(#GP_SCUD_DOC_SP);

    _Loop GP_SCUD_DOC_SP
    { NextVisual;
      PositionChanged_SP;
      _Day:=day(_PeriodBegin);
      /*
      if GP_SCUD_Doc_Sp.cReason=0
      { ww_str:=GetDocumentName+' Не заполнена цель выхода в спецификации';
        oGP_Log.Write(ww_Str);
        timelog(ww_str);
        isAllOk:=false;

      } */
      if FALSE //будем брать только с документа GP_SCUD_Doc_SP.EventDate<GP_SCUD_Doc.DocDate
      { ww_str:=GetDocumentName+' '+GP_Scud_Pers.Fio+' Дата события не может быть меньше даты приказа';
        oGP_Log.Write(ww_str);
        timelog(ww_str);
        isAllOk:=false;
      }
      if GP_SCUD_Doc_Sp.EventTmB=GP_SCUD_Doc_Sp.EventTmE// 'Время','начала'
      { ww_str:=GetDocumentName+' '+GP_Scud_Pers.Fio+' Не проставлено плановое время';
        oGP_Log.Write(ww_Str);
        timelog(ww_str);
        isAllOk:=false;
      }

      if GP_SCUD_Doc_Sp.EventTmB>GP_SCUD_Doc_Sp.EventTmE// 'Время','начала'
      { ww_str:=GetDocumentName+' '+GP_Scud_Pers.Fio+' время начала не может быть больше даты окончания';
        oGP_Log.Write(ww_str);
        timelog(ww_str);
        isAllOk:=false;
      }
      var _absentHoursInCurMon : double = getHoursInDocAbsentForPersInCurrentMonth(GP_Scud_Pers.nrec,GP_SCUD_DOC.nrec,GP_SCUD_DOC.DOCDATE,1);
      var _hoursInCurDoc       : double = iGP_SCUD_Function.GetDoubleFromTime(GetPlanTime(GP_SCUD_Doc_Sp.cGp_SCUD_PERS,GP_SCUD_Doc.DocDate,GP_SCUD_Doc_Sp.EventTmB,GP_SCUD_Doc_Sp.EventTmE) );

      var _MaxKolHours : double = doGetTune('NPOEM_OWN.SCUD.CANAPPROVEABSENTMORETHEN2475');

      if   GP_SCUD_REASON.WTYPE = 1 // личное заявление
       and GP_SCUD_Doc.wType = 1010 // заявления на отсутствие
       and (_absentHoursInCurMon + _hoursInCurDoc> _MaxKolHours)// 'Время','начала'
       {
         ww_str:=GetDocumentName+' '+GP_Scud_Pers.Fio+': в текущем месяце взято уже '+_absentHoursInCurMon+'ч, и в текущем документе '+_hoursInCurDoc+' (что в сумме более максимально разрешенного '+_MaxKolHours+'ч) ';
         oGP_Log.Write(ww_Str);
         timelog(ww_str);
         isAllOk:=false;
       }

      var _wMes :word;
      var _wYear:word;

      _wMes:=month(_PeriodBegin);
      _wYear:=year(_PeriodBegin);
      var _DtBeg:date;
      _DtBeg:=date(1,month(_PeriodBegin),year(_PeriodBegin));
      _DtBeg:=Sub_Months(_DtBeg,NPOEM_OWN_SCUD_OVER2_SROC);
      if DT_OST>_DtBeg
      { _DtBeg:=DT_OST;
      }
      // здесь будет записано сколько часов уже есть
      iGP_SCUD_EventsEdit.CalcAll(GP_SCUD_DOC_SP.cGP_SCUD_PERS
           ,_wYear,_wMes,2);
      _chas :=Calc_Saldo(GP_SCUD_Doc_Sp.Nrec,True);
      _chas1:=iGP_SCUD_Function.GetDoubleFromTime(GetPlanTime(GP_SCUD_Doc_Sp.cGp_SCUD_PERS,GP_SCUD_Doc.DocDate,GP_SCUD_Doc_Sp.EventTmB,GP_SCUD_Doc_Sp.EventTmE) );
      timelog('Before  остаток='+String(_chas)+', к погашению '+string(_chas1));
      if _Chas1>_chas
      { ww_Str:=GetDocumentName+' Для "'+GP_SCUD_PERS.Fio+'" не хватает переработок на '+string(_chas1-_chas,0,2)+' ч.';
        oGP_Log.Write(ww_Str);
        timelog('Before '+ww_str);
        if _chas<-0.01//не чистый 0
        { isAllOk:=false;
          ww_Str:=' есть не отработанная переработка '+string(_chas,0,2)+' ч. , утверждение запрещено';
          oGP_Log.Write(ww_str);
          timelog('Before '+ww_str);

        }
      } //if _Chas1>0
    } //_Loop GP_SCUD_DOC_SP

    PopPos(#GP_SCUD_DOC_SP);

    //ReScanPanel(#GP_SCUD_DOC_SP);
    //PositionChanged_SP;
    StopVisual('',0);

    Result:=isAllOk;
    Timelog('GP_SCUD_StateMentOnAbsent->Check_Status_Change_Before:Result 02='+string(Result) );
  } //Function oGP_SCUD_Base.Check_Status_Change_Before(_pStatus:comp):boolean;

  //-------------------------------------
  #doc
  выполнить проверку после изменения статуса
  #end
  Function oGP_SCUD_Base.Check_Status_Change_After(_pStatus:comp;_pStatusTo:comp):boolean;
  var _PeriodBegin:date;
      ii:word;
      _Day:word;
      _chas:double;
      _chas1:double;
      _koef:double;
      _Over:tSumma;
      _Over2:tSumma; _Holiday:tSumma;
      _Over_Opl:tSumma;_Over2_Opl:tSumma;_Holiday_Opl:tSumma;
      ww_str:string;
  { Result:=true;
    var buf:Type$GP_SCUD_SALDO ;
    if Timelog_Status>2
      Timelog('GP_SCUD_StateMentOnAbsent->Check_Status_Change_After 01='+string(_pStatus,0,0)+','+String(Status.GetDefault,0,0) );
    //Надо всегда делать пересчет
    //if  _pStatus<>Status.GetDefault and _pStatusto<>Status.GetDefault
    //and _pStatus<>NPOEM_OWN_SCUD_ZAbsent_STATUS_M
    //and _pStatusTo<>NPOEM_OWN_SCUD_ZAbsent_STATUS_M
    //   exit;
    //Exit;
    // _koef:=if(_pStatus<>Status.GetDefault,-1,1);

    _koef:=0;
    if  (_pStatus  = Status.GetDefault or  _pStatus  = NPOEM_OWN_SCUD_ZAbsent_STATUS_C)
    and (_pStatusTo<>Status.GetDefault and _pStatusto<>NPOEM_OWN_SCUD_ZAbsent_STATUS_C)
      _koef:=1
    else
    if  (_pStatusTo= Status.GetDefault or  _pStatusTo= NPOEM_OWN_SCUD_ZAbsent_STATUS_C)
    and (_pStatus  <>Status.GetDefault and _pStatus  <>NPOEM_OWN_SCUD_ZAbsent_STATUS_C)
      _koef:=-1;
    var isAllOk:boolean=true;
    _PeriodBegin:=GP_Scud_Doc.DocDate;
    //------------------------
    ClearFuncCache;
    //------------------------
    // Иначе пересчет сальдо не сработает
    set GP_SCUD_DOC.cStatus:=_pStatusTo;
    update current GP_SCUD_DOC;
    //------------------------
    if Timelog_Status>2
    { Timelog('GP_SCUD_StateMentOnAbsent->Check_Status_Change_After 02 ПЕРЕРАСЧЕТ _koef='+string(_koef) );
      Timelog('GP_SCUD_StateMentOnAbsent->Check_Status_Change_After _pStatusTo='+string(_pStatusTo,0,0)+', _pStatus='+string(_pStatus,0,0) );
    }
    StartNewVisual(vtNumericVisual,vfTimer ,'Проверка данных',0);
    PushPos(#GP_SCUD_DOC_SP);
    var _wMes :word;
    var _wYear:word;
    ClearFuncCache;
    _Loop GP_SCUD_DOC_SP
    { NextVisual;
      // при переводе из оформляемого или в оформляемый проверим остатки
      //if _pStatus=Status.GetDefault      or _pStatusto=Status.GetDefault
      //  Запишем в ВА если используем сальдо
      var _Use_Saldo:tSumma=0;

      if _koef<>0
      if GP_SCUD_Reason.wType=1
      { if _koef<0 // убираем поденное сальдо
        { delete GP_SCUD_Days where (( GP_SCUD_Doc_SP.Nrec == GP_SCUD_Days.cGP_SCUD_Doc_SP
              and 1                   == GP_SCUD_Days.wType
              and 2                   == GP_SCUD_Days.wVid
           ));

        }
        PositionChanged_SP;
        _Day:=day(_PeriodBegin);
        //_chas :=Calc_Saldo(GP_SCUD_Doc_Sp.Nrec);

        _wMes:=month(_PeriodBegin);
        _wYear:=year(_PeriodBegin);
        _chas1:= iGP_SCUD_Function.GetDoubleFromTime(GetPlanTime(GP_SCUD_Doc_Sp.cGp_SCUD_PERS,GP_SCUD_Doc.DocDate
           ,GP_SCUD_Doc_Sp.EventTmB,GP_SCUD_Doc_Sp.EventTmE));
        do
        { timelog(' After _Mes= '+string(_wMes)+', _wYear='+string(_wyear) + ' >= ' + DT_Ost +' Ищем сальдо');

          if iGP_SCUD_SaldoEdit.GetSaldoBuf(GP_SCUD_DOC_SP.cGP_SCUD_Pers,_wYear,_wMes,false,buf)
          { if TimeLog_Status>0
            { timelog(' After _Over2_ost='+String(buf.CH_Over2_Ost,0,2)
                     +',_Over2_Cur='+string(buf.CH_Over2_Cur,0,2)
                     +',_Over2_Opl='+string(buf.CH_OVER2_OPL,0,2)
                     );
            }
            _chas:= if(DT_OST = date(1,_wMes,_wYear), buf.CH_Over2_Ost, 0)
                  + buf.CH_Over2_Cur
                  - buf.CH_Over2_Opl; //уже израсходовано

            if _koef>0
            { if _chas<>0
              { timelog(' After _Mes= '+string(_wMes)+', _wYear='+string(_wyear)
                  +', остаток='+string(_chas,0,2)+', погасить='+string(_chas1,0,2)+', _koef='+String(_Koef) );
                //обнулим сальдо
                //buf.CH_Over2_Opl:=buf.CH_Over2_Opl+_chas1*_koef;
                //iGP_SCUD_SaldoEdit.SetSaldoBuf(buf);
                // к распределению
                var _Rasp :double=if(_Chas>=_chas1,_chas1,_Chas);
                //- распределено
                var _Rasp1:double=0;
                var _chas_use:double=0;
                timelog(' к распределению '+string(_Rasp,0,2));
                for(ii:=31;ii>=1;ii--) // LIFO
                { if buf.CH_OVERWORK2[ii]=0 then continue;
                  var _Calc_date:date=date(ii,_wMes,_wYear);
                  _chas_use:=0;
                  _Loop GP_SCUD_Days where (( GP_SCUD_DOC_SP.cGP_SCUD_PERS == GP_SCUD_Days.cGP_SCUD_PERS
                     and 1 == GP_SCUD_Days.wType
                     and 2 == GP_SCUD_Days.wVid
                     and _Calc_date == GP_SCUD_Days.EventDate
                     ))
                  { _chas_use:=_chas_use+GP_SCUD_Days.chasf
                  } //_Loop GP_SCUD_Days
                  if _chas_use>=buf.CH_OVERWORK2[ii] continue;
                  _chas_use:=buf.CH_OVERWORK2[ii]-_chas_use;
                  timelog(' День '+string(ii)+'  к распределению '+string(_chas_use,0,2));
                  insert into GP_SCUD_Days set
                     GP_SCUD_Days.cGP_SCUD_Doc   :=GP_SCUD_DOC_SP.cGP_SCUD_Doc //  "ссылка на документ"
                    ,GP_SCUD_Days.cGP_SCUD_Doc_SP:=GP_SCUD_Doc_SP.Nrec//  "ссылка на спец. документа"
                    ,GP_SCUD_Days.cGP_SCUD_PERS  :=GP_SCUD_Doc_SP.cGP_SCUD_PERS// "ссылка на сотрудника"
                    ,GP_SCUD_Days.wType          :=1 // "Тип 0 - отраб., 1 использ. "
                    ,GP_SCUD_Days.wVid           :=2 // "1 - св.,2 перер. ,3 - выход."
                    ,GP_SCUD_Days.EventDate      :=_Calc_Date//  "Дата события"
                    ,GP_SCUD_Days.chasf          :=if(_chas_use>_Rasp,_Rasp,_chas_use) //  "Кол-во часов"
                    ,GP_SCUD_Days.Ost            :=if(_chas_use>_Rasp,_chas_use-_Rasp,0)//   "Остаток"
                    ;
                  _Rasp :=_Rasp -GP_SCUD_Days.chasf;
                  _Rasp1:=_Rasp1+GP_SCUD_Days.chasf;
                  if _Rasp<=0 then break;
                } //for(ii:=1;ii<=31;ii++)
                // Надо запускать пересчет переработки!
                timelog('Распределили '+String(_Rasp1,0,2)+', расхождение _Rasp1 '+string(_Rasp,0,2));

                //----------------
                // что то не так c использованием, просуммируем -
                // запомним сколько итого в _chas_use
                // Больше может быть, меньше нет.
                /*  НЕ БУДЕМ , а то ломаем старое сальдо
                _chas_use:=0;
                if _Rasp>0
                { //----------
                  // в месяц начало расчета сальдо Добавим разницу
                  if  DT_OST_SROC_Month =_wMes
                  and DT_OST_SROC_Year  =_wYear
                  { insert into GP_SCUD_Days set
                     GP_SCUD_Days.cGP_SCUD_Doc   :=GP_SCUD_DOC_SP.cGP_SCUD_Doc //  "ссылка на документ"
                    ,GP_SCUD_Days.cGP_SCUD_Doc_SP:=GP_SCUD_Doc_SP.Nrec//  "ссылка на спец. документа"
                    ,GP_SCUD_Days.cGP_SCUD_PERS  :=GP_SCUD_Doc_SP.cGP_SCUD_PERS// "ссылка на сотрудника"
                    ,GP_SCUD_Days.wType          :=1 // "Тип 0 - отраб., 1 использ. "
                    ,GP_SCUD_Days.wVid           :=2 // "1 - св.,2 перер. ,3 - выход."
                    ,GP_SCUD_Days.EventDate      :=date(1,DT_OST_SROC_Month,DT_OST_SROC_Year)//  "Дата события"
                    ,GP_SCUD_Days.chasf          :=_Rasp //  "Кол-во часов"
                    ,GP_SCUD_Days.Ost            :=-999//   "Остаток"
                    ;
                    // Будем считать что все распределено
                    _Rasp1:=if(_Chas>=_chas1,_chas1,_Chas);

                  }
                  var _dtb:date=date(1,_wMes,_wYear);
                  var _dte:date=date(Last_Day(_Dtb),_wMes,_wYear);
                  SQL select sum(GP_SCUD_Days.chasf)
                  From GP_SCUD_Days
                  where  GP_SCUD_Days.EventDate>=:(_dtb)
                    and  GP_SCUD_Days.EventDate<=:(_dte)
                    and  GP_SCUD_Days.cGP_SCUD_PERS=:(GP_SCUD_Doc_SP.cGP_SCUD_PERS)
                  into (_chas_use)
                  ;
                  timelog('Распределили '+String(_Rasp1,0,2)+', по GP_SCUD_Days-'+string(_chas_use))
                }
                */
                //---------------------------------
                // скорректированное использование
                var _boNeedUpd:boolean=false;
                if _chas>=_chas1 //есть остатки
                { buf.CH_Over2_Opl:=buf.CH_Over2_Opl+_chas1*_koef;
                  _chas1:=0;
                  _boNeedUpd:=true;
                }
                else
                if _chas>0
                {
                  buf.CH_Over2_Opl:=buf.CH_Over2_Opl+_chas*_koef;
                  _chas1:=_chas1-_Chas;
                  _boNeedUpd:=true;
                }
                if _boNeedUpd
                { iGP_SCUD_SaldoEdit.SetSaldoBuf(buf);
                  _Use_Saldo+=_chas*_koef;
                }

                timelog(' After _Mes= '+string(_wMes)+', _wYear='+string(_wyear)
                  +', осталось погасить='+string(_chas1,0,2) );
                if _chas1=0 break;

              } //if _chas<>0
            } //if _koef>0
            else
            { if buf.CH_Over2_Opl>_chas1
              { buf.CH_Over2_Opl:=buf.CH_Over2_Opl-_chas1;
                iGP_SCUD_SaldoEdit.SetSaldoBuf(buf);
                _chas1:=0;
                break;
              } //if buf.CH_Over2_Opl>_chas1
              else
              { _chas1:=_chas1-buf.CH_Over2_Opl;
                buf.CH_Over2_Opl:=0;
                iGP_SCUD_SaldoEdit.SetSaldoBuf(buf);
              } //else if buf.CH_Over2_Opl>_chas1
            } //else if _koef>0
          }//if iGP_SCUD_SaldoEdit.GetSaldoBuf(pGP_SCUD_Pers,wYear,wMes,false,buf)
          else
          { break;
          }
          _wMes:=_wMes-1;
          if _wMes=0
          { _wMes:=12;
            _wYear:=_wYear-1;
          }
        } while _chas1>0 and DT_OST <= date(1,_wMes,_wYear);
        //----------------------
        doSetAttrID(coGP_SCUD_DOC_SP,GP_SCUD_DOC_SP.Nrec, cAttr_SCUD_DOCSP_IN,_Use_Saldo);
        //--------------------
        // есть не распределенный остаток
        if _Chas1>0 and _koef>0
        { isAllOk:=false;
          ww_str:='Для "'+GP_SCUD_PERS.Fio+'" не хватает переработок на '+string(_chas1,0,2)+' ч.';
          oGP_Log.Write(ww_str);
          timelog(ww_Str);
          //Запишем остаток в текущий месяц
          if iGP_SCUD_SaldoEdit.GetSaldoBuf(GP_SCUD_DOC_SP.cGP_SCUD_Pers,year(_PeriodBegin),month(_PeriodBegin),false,buf)
          { buf.CH_Over2_Opl:=buf.CH_Over2_Opl+_Chas1;
            iGP_SCUD_SaldoEdit.SetSaldoBuf(buf);
          }
        } //if _Chas1>0 and _koef>0
        //А теперь нужно пересчитать сальдо наоборот
        do
        { // читаем с остатками из предыдущего месяца и пишем обратно
          _wMes++;
          if _wMes>12
          { _wMes:=1;
            _wYear++;
          }
          if date(1,_wMes,_wYear)>_PeriodBegin break;
          timelog(' After _Mes= '+string(_wMes)+', _wYear='+string(_wyear) +' Пересчитываем входящее сальдо');
          _Over:=_Over2:=_Holiday:=0;
          _Over_Opl:=_Over2_Opl:=_Holiday_Opl:=0;
          if not iGP_SCUD_SaldoEdit.GetSaldo(GP_SCUD_DOC_SP.cGP_SCUD_Pers,_wYear,_wMes,true
           ,_Over,_Over2,_Holiday
          ,_Over_Opl,_Over2_Opl,_Holiday_Opl
          ,false) then continue;
          if not iGP_SCUD_SaldoEdit.GetSaldoBuf(GP_SCUD_DOC_SP.cGP_SCUD_Pers,_wYear,_wMes,false,buf) continue;
          buf.CH_Over2_Ost:=_Over2;
          iGP_SCUD_SaldoEdit.SetSaldoBuf(buf);

        } while date(1,_wMes,_wYear)<=_PeriodBegin
      } //if GP_SCUD_Reason.wType=1
      //утвердили - нужно пересчитать
      if _pStatus=NPOEM_OWN_SCUD_ZAbsent_STATUS_M
      or _pStatusTo=NPOEM_OWN_SCUD_ZAbsent_STATUS_M
      if NPOEM_OWN_HEAD_V_VID>1 // использовать остатки
      {
        if not iGP_SCUD_EventsEdit.CalcAll(GP_SCUD_DOC_SP.cGP_SCUD_PERS,Year(_PeriodBegin),month(_PeriodBegin) //Год , месяц расчета
        ,1//0 при расчета считаются , что на все сверхурочные есть приказ
                      //1 учитываются только проведенные приказы, если задан _DayCalc - то это вызов из приказа, и за этот день не учитываются
        ,true // true - с перерасчетом
        ,0 //DayCalc:word =0//при расчете для приказов указать день
        )
        { oGP_Log.Write('ошибка расчета сальдо для '+GP_SCUD_Pers.Fio);
        }
      } //if NPOEM_OWN_HEAD_V_VID>1
    } //_Loop GP_SCUD_DOC_SP
    //------------------------------------------------
    //проверим, нужно ли и можно ли отправить email исполнителю
    if _pStatusTo= NPOEM_OWN_SCUD_ZAbsent_STATUS_C
    { if NPOEM_OWN_SCUD_ZAbsent_STATUS_C_E
      {
        /*
        var _email:string= '' ; //Email_GetEmailByPers(GP_SCUD_Doc.cExecutor);
        if _email<>''
        { email_num_row:=0;
          Write_Mess('Добрый день, '+Executor.Fio);
          Write_Mess('<p>Заявление на отсутствие  № <b>'+GP_SCUD_Doc.DOCNMB
               +DateToStr(GP_SCUD_Doc.DocDate,'</b> от <b>DD.MM.YYYY</b>'));
          Write_Mess('отменено');
          Write_Mess('<p>Содержимое заявления:');
          _Loop GP_SCUD_DOC_SP
          { Write_Mess('<p>'+GP_SCUD_PERS.Fio);
          }
          Email_Send
           ( NPOEM_OWN_EMAIL_TYPE// : word ;
            ,_email // _email_addr :string ;
            ,'СКУД.Отмена заявления на отсутствие: № '+GP_SCUD_Doc.DOCNMB
            +DateToStr(GP_SCUD_Doc.DocDate,' от DD.MM.YYYY')// _email_subject :string ;
            ,'' //_email_text :string ;
            ,'' //_email_attach1 :string ;
            ,'' //_email_attach2 :string ;
            ,'' //_email_attach3 :string ;
            ,'' //_email_attach4 :string ;
            ,'"INTERFACE GP_Staff::GP_SCUD_StateMentOnAbsent('+string(0)+','+string(GP_SCUD_Doc.Nrec,0,0)+',0)"' //_email_attach5 :string ;
            ,'' //_email_addr_copy :string='';
            ,'' //_email_addr_from :string=''
           );

        } //if _email<>''
        */
      } //if NPOEM_OWN_SCUD_ZAbsent_STATUS_C_E
    } //if _pStatusTo= NPOEM_OWN_SCUD_ZAbsent_STATUS_C
    ClearFuncCache;
    PopPos(#GP_SCUD_DOC_SP);
    /*
    перенес в выбор статусы
    ReScanPanel(#GP_SCUD_DOC_SP);
    PositionChanged_SP;
    ReReadRecord;
    */
    StopVisual('',0);

  } //Function oGP_SCUD_Base.Check_Status_Change_After(_pStatus:comp):boolean;


  //--------------------------------
  // Получить должность работника
  //--------------------------------
  Function GetPost(_pPersons:comp; _DT:date):string;cacheable;
  { Result:='';
    if _pPersons=0 exit;
    vAppVrem.pPersons:=_pPersons;
    vAppVrem.DBeg:=_Dt;
    vApp.pPersons:=_pPersons;
    vApp.DBeg:=_Dt;
    if vAppVrem.getlast Appointments=tsok
      Result:= iCatFunc.GetCatalogsName(vAppVrem.Appointments.Post);
    else
    {
      if vApp.getlast Appointments=tsok
        Result:=iCatFunc.GetCatalogsName(vApp.Appointments.Post)
    }
  } //Function GetPost(_pPersons:comp; _DT:date):string;


  //----------------------------------------
  // Получить плановое время отсутствия
  //------------------------------------
  Function GetPlanTime(_pGp_SCUD_PERS:comp;_DT:date; _TMB:time; _TME:time) : time;// Cacheable;
  var _diff_time :time;
      _diff_time1:time;
      wDay:word;
  { //[Absent] Sub_Time(GP_SCUD_Doc_Sp.EventTmE,GP_SCUD_Doc_Sp.EventTmB)  'Продолжительность','с учетом присутствия' :[20],Protect,NoDel;
    Result:=ZeroTime;
    if _TME<_TMB exit;
    _diff_time:=Sub_Time(_TME,_TMB);
    vRejim.wRejim:=iGP_SCUD_EventsEdit.GetRejimDay(_pGP_SCUD_Pers,_DT);
    vRejim.wMonth:=month(_DT);
    vRejim.wYear :=Year (_DT);
    wDay :=Day(_DT);
    //if vRejim.getfirst GP_KlndrExt=tsok
    vRejim._Loop GP_KlndrExt
    { if  vRejim.GP_KlndrExt.StartBreak1[wDay]>=_TMB
      and vRejim.GP_KlndrExt.EndBreak1[wDay]  <=_TME
      { _diff_time1:=Sub_Time(vRejim.GP_KlndrExt.EndBreak1[wDay],vRejim.GP_KlndrExt.StartBreak1[wDay]);
        if _diff_time1<_diff_time
          _diff_time:=Sub_Time(_diff_time,_diff_time1);
      }
      if  vRejim.GP_KlndrExt.StartBreak2[wDay]>=_TMB
      and vRejim.GP_KlndrExt.EndBreak2[wDay]  <=_TME
      { _diff_time1:=Sub_Time(vRejim.GP_KlndrExt.EndBreak2[wDay],vRejim.GP_KlndrExt.StartBreak2[wDay]);
        if _diff_time1<_diff_time
          _diff_time:=Sub_Time(_diff_time,_diff_time1);
      }
    } //if vRejim.getfirst GP_KlndrExt=tsok
    Result:=_diff_time;
  } //Function GetPlanTime(_pGp_SCUD_PERS:comp;_DT:date; _TMB:time; _TME:time) : time;


  //---------------------------------------------
  // Расчет факта
  //---------------------------------------------
  Function Calc_Fact(_nrec:comp) : time; Cacheable;
  { #__UNUSED__(_nrec)
    Result:=0;
    var _TM_Event_Prev: time=ZeroTime;
    var _tdiff:time=ZeroTime;

    var _wResource:integer=-1;
    //учтем обеды
    _Loop GP_SCUD_EVENTS
    { if timelog_status>0
        timelog(' факт '+string(GP_SCUD_Events.wResource)+' ,'+TimeToStr(GP_SCUD_Events.EnterTime,'HH:MM') );
      if GP_SCUD_Events.wResource=0 // Выход
      { // ничего не считаем, нужно ловить вход
      }
      else
      { if _wResource=-1
        { //_diff:=_diff+iGP_SCUD_Function.GetDoubleFromTime(Sub_time(GP_SCUD_Events.EnterTime,GP_SCUD_DOC_SP.EventTMB));
          _tDiff:=Add_Time(_tDiff,GetPlanTime(GP_SCUD_DOC_SP.cGP_SCUD_PERS,GP_SCUD_DOC.DocDate,GP_SCUD_DOC_SP.EventTMB,GP_SCUD_Events.EnterTime));
        }
        else
        { //_diff:=_diff+iGP_SCUD_Function.GetDoubleFromTime(Sub_time(GP_SCUD_Events.EnterTime,_TM_Event_Prev));
          _tDiff:=Add_Time(_tDiff,GetPlanTime(GP_SCUD_DOC_SP.cGP_SCUD_PERS,GP_SCUD_DOC.DocDate,_TM_Event_Prev,GP_SCUD_Events.EnterTime));
        }
      }
      _wResource    :=GP_SCUD_Events.wResource;
      _TM_Event_Prev:=GP_SCUD_Events.EnterTime;
    } //_Loop GP_SCUD_EVENTS
    if _wResource=0
    { //_diff:=_diff+iGP_SCUD_Function.GetDoubleFromTime(Sub_time(GP_SCUD_DOC_SP.EventTME,_TM_Event_Prev));
      _tDiff:=Add_Time(_tDiff,GetPlanTime(GP_SCUD_DOC_SP.cGP_SCUD_PERS,GP_SCUD_DOC.DocDate,_TM_Event_Prev,GP_SCUD_DOC_SP.EventTME));
    }
    ELSE //если не было проходов, считаем что весь период прогулял
    if _wResource=-1
    { //_diff:=_diff+iGP_SCUD_Function.GetDoubleFromTime(Sub_time(GP_SCUD_DOC_SP.EventTME,GP_SCUD_DOC_SP.EventTMb));
      _tDiff:=Add_Time(_tDiff,GetPlanTime(GP_SCUD_DOC_SP.cGP_SCUD_PERS,GP_SCUD_DOC.DocDate,GP_SCUD_DOC_SP.EventTMb,GP_SCUD_DOC_SP.EventTME));
    }
    Result:=_tDiff;//iGP_SCUD_Function.GetTimeFromDouble(_diff);
  } //Function Calc_Fact(_nrec:comp) : time;

  //--------------------------------------
  //
  //--------------------------------------
  Function GetDaysOver2:string;
  { Result:='';
    /*
    if getfirst GP_SCUD_Days=tsok
    { GetDaysOver2:='+'
    }
    else
    */
    if True
    { //if GP_SCUD_Doc.cStatus <> NPOEM_OWN_SCUD_ZAbsent_STATUS_M //= pStatus_Getdefault
      if GP_SCUD_Doc.cStatus = pStatus_Getdefault
      { if Calc_Saldo(GP_SCUD_Doc_Sp.Nrec)>
          iGP_SCUD_EventsEdit.GetDoubleFromTime(
           GetPlanTime(GP_SCUD_Doc_SP.cGP_SCUD_Pers,GP_SCUD_Doc.DocDate,GP_SCUD_Doc_SP.EventTmB,GP_SCUD_Doc_SP.EventTmE ))
        { Result:='+' ;
        }
      }
      else
      { var _fUse:double;
        _fUse:=doGetAttrID(coGP_SCUD_DOC_SP,GP_SCUD_DOC_SP.Nrec, cAttr_SCUD_DOCSP_IN);
        if  _fUse=1
        and GP_SCUD_DOC.DocDate<Date(1,11,2018)
        { Result:='+';
        }
        else
        { if _fUse>=
           iGP_SCUD_EventsEdit.GetDoubleFromTime(
           GetPlanTime(GP_SCUD_Doc_SP.cGP_SCUD_Pers,GP_SCUD_Doc.DocDate,GP_SCUD_Doc_SP.EventTmB,GP_SCUD_Doc_SP.EventTmE ))
          Result:='+' ;
        }
      }
    }
  } //Function GetDaysOver2:string;


  //--------------------------------------
  //проверить запись на корректность
  //--------------------------------------
  function MyCheckRecord:boolean;
  { Result:=true;
    if not IsProtect
    if Length(GP_SCUD_Doc.Description)<3
    { Message('Не заполнено "Описание"!');
      Result:=false;
      exit;
    }
  } //function MyCheckRecord:boolean;


//****************************** DataStream ************************************
DataStream dts_One
//****************************** DataStream ************************************
( Table GP_SCUD_DOC_SP
  (  //Заместителю генерального директора
     //по персоналу и социальной политике
     [ZGD_Pess]      'Назаренко Сергею Геннадьевичу';// 20240312 'Алферовой Елене Владимировне';
     [Pers_Post]     GetPost(GP_SCUD_Pers.cPersons, GP_SCUD_Doc.DocDate  );
     [Pers_Fio]      GP_Scud_Pers.Fio;
     [Pers_Fio2]     My_Sclonenie(GP_Scud_Pers.Fio,22,GP_Scud_Pers.cPersons);
     [Event_DT]      GP_SCUD_Doc.DocDate;
     [Event_DT_DD]   DateToStr(GP_SCUD_Doc.DocDate,'DD');
     [Event_DT_MM]   DateToStr(GP_SCUD_Doc.DocDate,'mon');
     [Event_DT_YYYY] DateToStr(GP_SCUD_Doc.DocDate,'YYYY');
     [Event_DT_YY]   DateToStr(GP_SCUD_Doc.DocDate,'YY');
     [Event_TMB]     GP_SCUD_Doc_SP.EventTmB ;
     [Event_TME]     GP_SCUD_Doc_SP.EventTmE ;
     [Doc_Date]      GP_SCUD_Doc.DocDate ;//Дата регистрации
     [Podr_kod]      KatPodr.Kod         ;//'Код подразделения'
     [Doc_NMB]       GP_SCUD_Doc.DocNMB  ;//'Номер'
     [Status]        GP_Status.Name      ;//'статус документа '
     [Reson]         GP_SCUD_Reason.Name ;//'Цель выхода'
     [Pr_Saldo]      GetDaysOver2        ;
     [Description]   if(GP_SCUD_Doc_SP.Description<>'',GP_SCUD_Doc_SP.Description, GP_SCUD_Doc.Description);//  'Описание'
     [wTypeReg]      GP_SCUD_Doc.wTypeReg;//'Тип регистрации'
     [dInput]        GP_SCUD_Doc.dInput  ;//'Дата создания'
     [UseSaldo]      doGetAttrID(coGP_SCUD_DOC_SP,GP_SCUD_DOC_SP.Nrec, cAttr_SCUD_DOCSP_IN);
     [Executor_Fio]  Executor.Fio        ;//'Исполнитель'
     [Executor_Post] if(IsValidAll(#Executor),GetPost(Executor.Nrec, GP_SCUD_Doc.DocDate  ),'');
     [Poppis_1_Fio]  GetPodpisPersS(1,GP_SCUD_DOC.cKatPodr,GP_SCUD_DOC.Nrec);// vPodp.Persons_Podp1.Fio   ;//'Подписант 1'
     [Poppis_2_Fio]  GetPodpisPersS(2,GP_SCUD_DOC.cKatPodr,GP_SCUD_DOC.Nrec);//vPodp.Persons_Podp2.Fio   ;//'Подписант 2'
     [Poppis_1_Post] if(vPodp.cPodp1<>0,GetPost(vPodp.cPodp1, GP_SCUD_Doc.DocDate  ),'');
     [Poppis_2_Post] if(vPodp.cPodp2<>0,GetPost(vPodp.cPodp2, GP_SCUD_Doc.DocDate  ),'');

  );
)
