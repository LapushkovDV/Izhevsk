{
//  StartNewVisual (vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета', 1);
}
cmPostProcess:
{
//  StopVisual ('', 0);
}
end; // HandleEvent DataStream dtsU_RepStatis
end;// end DataStream


  Function PrintDoc:boolean;
  { Result:=true;
    if not NPOEM_OWN_SCUD_ZAbsent_PRINT_IN_DEF
    { if GP_SCUD_DOC.cStatus=pStatus_GetDefault //Status.GetDefault
      { Message('Запрещено печать заявление в оформляемом статусе!');
        Exit;
      }
    }
    SetPodpisOnChange;
    // без это перестало выводить
    IF vPodp.GETFIRST Persons_Podp2=TSOK {}
    timelog('PrintDoc vPodp.cPodp1='+string(vPodp.cPodp1,0,0)+', vPodp.cPodp2='+string(vPodp.cPodp2,0,0));
    timelog('PrintDoc vPodp.Persons_Podp2.Fio='+vPodp.Persons_Podp2.Fio);
    RunFReportByGroup(dts_One,'DOCS');
  } //Function PrintDoc:boolean;

  //--------------------------------------------------------
  //----- Проверить на необходимость заполнения Поручения
  Function CheckNeed_Sp_Description :boolean;
  { Result:=false;
    if GP_SCUD_Doc.cReason=0 then exit;
    if Length(GP_SCUD_Doc_SP.Description)>3 then Exit;
    if Length(GP_SCUD_Doc.Description)<4 then Exit;
    if getfirst SpKau<>tsok then Exit;
    if pos('*',SPKAU.LEVELCODE)>0
      Result:=True;
  } //Function CheckNeed_Sp_Description :boolean;
