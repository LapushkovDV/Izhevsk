HandleEvent

cmDefault:
{ PutCommand(cmEdit);
}
cmEdit:
{ PutCommand(cmValue31);
}
cmValue31:
{ 
  pGP_SCUD_Doc :=tmp_period.cGP_SCUD_DOC;
  //mAddBounds(tbbyNrec)
  if not BoundActive(tbbyNrec) PushBounds(tbbyNrec);
  if getfirst GP_SCUD_DOC // where (( tmp_period.cGP_SCUD_DOC == GP_SCUD_DOC.Nrec ))
                  <>tsok
  { message('Ошибка поиска документа!');
    exit;
  }
  if getfirst GP_SCUD_Doc_SP where (( tmp_period.cGP_SCUD_DOC_SP == GP_SCUD_DOC_SP.Nrec ))<>tsok
  { if getfirst GP_SCUD_Doc_SP=tsok {}
  }
  PositionChanged;
  RunWindowModal(wnEdit);

}
end;
