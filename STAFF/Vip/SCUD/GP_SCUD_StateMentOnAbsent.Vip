//------------------------------

  //-------------------------------------
  #doc
  установить параметры полей
  #end
  Function SetDocFieldsState: boolean;
  var _boCanChange:boolean;
  { Result:=Inherited::SetDocFieldsState;
    _boCanChange:=StatusChange.CanChangeStatus(GP_SCUD_DOC.cStatus);
    if timelog_status>2
    { timelog(GetInterfaceName+'->SetDocFieldsState:GP_Status.Name='+GP_Status.Name+',_boCanChange='+string(_boCanChange));
    }
    if _boCanChange
    { cfsSetProp('c_BRDOC_GP_STATUS.NAME_Статус','ButtonType',inPickButton); //WINCOMM.INC
      cfsSetProp('i_ScrEdit_GP_STATUS.NAME','ButtonType',inPickButton);
      if GP_SCUD_DOC.cStatus=NPOEM_OWN_SCUD_ZAbsent_STATUS_C
        cfsSetProp('i_ScrEdit_REFUSAL','ButtonType',inPickButton);
    }

  } //Function SetDocFieldsState: boolean;


  //-------------------------------------
  Procedure MakeBufferGP_SCUD_Doc;
  { ClearBuffer(#GP_SCUD_Doc);
    GP_SCUD_Doc.Nrec:=GetNextNrec(#GP_SCUD_Doc,0) ;
    InsertMarker(Marker_New,GP_SCUD_Doc.Nrec);
    insert tFilteredRecs set tFilteredRecs.NRec := GP_SCUD_Doc.NRec;
    GP_SCUD_Doc.dInput:=_CurDateTime;
    GP_SCUD_Doc.wType :=wTypeDoc;
    GP_SCUD_Doc.DocNMB  :=GetNextDocNumber(year(Cur_Date));
    GP_SCUD_Doc.cExecutor:=UserPersNRec; //UserAccessService.UserPersonsNRec;
    GP_SCUD_Doc.cUser   :=UserId();
    GP_SCUD_Doc.DocDate:=Cur_date;
    //день в день - надо утверждать ЗГД
    GP_SCUD_Doc.wTypeReg:=1;
    //день в день - надо утверждать ЗГД
    if IsBitCTW(wFilter,1)
    { if DTB<>ZeroDate and GP_SCUD_Doc.DocDate<DTB
         GP_SCUD_Doc.DocDate:=DTB;
      if DTE<>ZeroDate and GP_SCUD_Doc.DocDate>DTE
         GP_SCUD_Doc.DocDate:=DTE;

    }
    if IsBitCTW(wFilter,2)
    {  GP_SCUD_Doc.cKAtPodr:=pFlt_KatPodr;
    }
    if IsBitCTW(wFilter,4)
    {  GP_SCUD_Doc.cReason:=pFlt_GP_SCUD_Reason;
    }
    if GP_SCUD_Doc.cKatPodr=0 or (not EnablePodr(GP_SCUD_Doc.cKatPodr))
    { if isValidAll(#Executor)
        if EnablePodr(Executor.GalDep)
        { set GP_SCUD_Doc.cKatPodr:=Executor.GalDep;
          if getfirst KatPodr=tsok
          { if pos('-',Katpodr.Kod)>0 and KatPodr.cPodr>0
            { if EnablePodr(KatPodr.cPodr)
              { var _ptmp:comp=KatPodr.cPodr;
                set GP_SCUD_Doc.cKatPodr:=_ptmp;
              }
            }
          } //if getfirst KatPodr=tsok
        } //if EnablePodr(Executor.GalDep)
    }  //if GP_SCUD_Doc.cKatPodr=0 or (not EnablePodr(GP_SCUD_Doc.cKatPodr))
    set GP_SCUD_Doc.cStatus := pStatus_GetDefault;
  } //Procedure MakeBufferGP_SCUD_Doc;

    //-------------------------------------
  #doc
    Установить режим отображения
  #end
  Procedure SetVisibleRun(_boVisibleRun:boolean);
  { if boVisibleRun=_boVisibleRun exit;
    SetEditMode(true);
    isProtect:=CanEditTbl;
    boVisibleRun:=_boVisibleRun;
    SetEditMode(CanEditTbl);
  }


  //-------------------------------------
  #doc
    Сформировать заявление
  #end
  Function MakeDoc(  _pGP_SCUD_Pers :comp//.Nrec
                    ;_pGP_SCUD_Events:comp
                    ;_EnterDate:date
                    ;_EnterTime:time
                    ;_Next_Event:string
                    ;_Plan      :time=ZeroTime
                    ;_cReason   :comp=0
                    ;_pGP_SCUD_DOC_SP:comp=0
                    ;_sDescription:string=''
                    ):boolean;
  { #__UNUSED__(_pGP_SCUD_Pers,_pGP_SCUD_Events,_EnterDate,_EnterTime,_Next_Event,_Plan,_cReason,_pGP_SCUD_DOC_SP,_sDescription)
    Result:=false;
    timelog('GP_SCUD_StateMentOnAbsent->MakeDoc:_pGP_SCUD_Pers='+string(_pGP_SCUD_Pers,0,0));
    if not  (UserAccessService.CanIns(wTypeDoc))
    { message('У вас нет прав на создание заявлений');
      exit;
    }
    if _pGP_SCUD_DOC_SP>0
    {
      if pStatus_GetDefault<>GP_SCUD_Doc.cStatus
      { Message('Документ не в оформляемом статусе');
        exit;
      }
      if _EnterDate<>GP_SCUD_Doc.DocDate
      { message('Дата заявления не соотв.'
            +chr(13)+GP_Scud_Doc.DocDate );
        exit;
      }
      if getfirst GP_SCUD_Doc_SP where (( _pGP_SCUD_DOC_SP == GP_SCUD_Doc_SP.Nrec ))<>0
       _pGP_SCUD_DOC_SP:=0
    }
    if _pGP_SCUD_DOC_SP=0
    { MakeBufferGP_SCUD_Doc;
      GP_SCUD_Doc.DocDate:=_EnterDate;
      GP_SCUD_Doc.DocNMB  :=GetNextDocNumber(year(GP_SCUD_Doc.DocDate));
      GP_SCUD_Doc.cReason :=_cReason;
      GP_SCUD_Doc.cUser   :=UserId();
      if _sDescription<>''
        GP_SCUD_Doc.Description:=_sDescription;
      //-------------------
      if GP_SCUD_Doc.DocDate<=GP_SCUD_Doc.Dinput
      { GP_SCUD_Doc.wTypeReg:=1;
      }
      else
      { GP_SCUD_Doc.wTypeReg:=0;
      }
      if GP_SCUD_Doc.cReason=0
      { GP_SCUD_Doc.cReason:=iGP_SCUD_ReasonEdit.GetReasonTypeNrec(1);

      }
      insert current GP_SCUD_Doc;
      if getfirst GP_SCUD_Pers where (( _pGP_SCUD_Pers == GP_SCUD_Pers.nrec))=tsok
      { GP_SCUD_Doc.cKatPodr:=GP_SCUD_Pers.cKatPodr;
        update current GP_SCUD_Doc;
      }
      timelog('GP_SCUD_StateMentOnAbsent->MakeDoc:002');
      ClearBuffer(#GP_SCUD_Doc_SP);
      GP_SCUD_Doc_SP.cGP_SCUD_Doc:=GP_SCUD_Doc.Nrec;
      GP_SCUD_Doc_SP.wType       :=GP_SCUD_Doc.wType;
    }
    GP_SCUD_Doc_SP.EventDate   :=_EnterDate;
    GP_SCUD_Doc_SP.cGP_SCUD_Pers:=_pGP_SCUD_Pers;
    GP_SCUD_Doc_SP.EventTmb    := _EnterTime;
    GP_SCUD_Doc_SP.EventTmbF   := _EnterTime;
    if length(_Next_Event)=5
    { GP_SCUD_Doc_SP.EventTmE    := StrToTime(Substr(_Next_Event,1,5),'HH:MM');
      GP_SCUD_Doc_SP.EventTmEF   := GP_SCUD_Doc_SP.EventTmE;
    }
    if _Plan<>ZeroTime
    { if _Plan>_EnterTime
      { if _Plan<GP_SCUD_Doc_SP.EventTmE
        { GP_SCUD_Doc_SP.EventTmE    := _Plan;
          GP_SCUD_Doc_SP.EventTmEF   := _Plan;
        }
      }
      else
      { GP_SCUD_Doc_SP.EventTmE    := _EnterTime;
        GP_SCUD_Doc_SP.EventTmEF   := _EnterTime;
        GP_SCUD_Doc_SP.EventTmB    := _Plan;
        GP_SCUD_Doc_SP.EventTmBF   := _Plan;
      }
    }
    GP_SCUD_Doc_SP.cReason:=GP_SCUD_Doc.cReason;
    if _pGP_SCUD_DOC_SP=0
    { pGP_SCUD_Doc := GP_SCUD_Doc.Nrec;
      Insert current GP_SCUD_Doc_SP;
      //mAddBounds(tbbyNrec)
      if not BoundActive(tbbyNrec) PushBounds(tbbyNrec);

      SetVisibleRun(true);
      PositionChanged_SP;
      boExternal:=True;

      RunWindowModal(wnEdit);
    }
    else
    { update current GP_SCUD_Doc_SP;
      GP_SCUD_Doc.DocDate:=_EnterDate;
      update current GP_SCUD_Doc;

    }
    Result:=true;
    timelog('GP_SCUD_StateMentOnAbsent->MakeDoc:003');

    timelog('GP_SCUD_StateMentOnAbsent->MakeDoc:004');
  } //Function MakeDoc


  //-------------------------------------
  #doc
    Редактировать документ
  #end
  Function EditDoc (_pGP_SCUD_Doc:comp) :boolean;
  { Result:=false;
    if getfirst GP_SCUD_Doc where (( _pGP_SCUD_Doc == GP_SCUD_Doc.Nrec ))<>tsok exit;
    pGP_SCUD_Doc :=_pGP_SCUD_Doc;
    //mAddBounds(tbbyNrec)
    if not BoundActive(tbbyNrec) PushBounds(tbbyNrec);

    SetVisibleRun(true);
    PositionChanged;
    if getfirst GP_SCUD_Doc_SP=tsok {}
    PositionChanged_SP;
    boExternal:=True;
    RunWindowModal(wnEdit);
    Result:=true;
  } //Function EditDoc (_pGP_SCUD_Doc:comp) :boolean;

  //----------------------------------------------------
  // Выбор статуса
  //----------------------------------------------------
  Function MyPickStatus(_Packet:word=0
              ;_Status_Prev:comp=0
              ;_Status_New :comp=0
              ;_sStatus_new:string=''
              ):boolean;
  var _pDoc:comp;
      _sStatus_Prev:string;
      StatusChangeLog:type$GP_StatusChangeLog;
      _sErr:string;
  { _sStatus_Prev:='';
    Result:=false;
    isFilterRun:=true;
    ClearAdvRecord(StatusChangeLog);
    Timelog('GP_SCUD_StateMentOnAbsent->MyPickStatus:_Packet='+string(_Packet));
    if _Packet=0
    { _Status_Prev:=GP_SCUD_DOC.cStatus;
      _sStatus_Prev:=GP_Status.Name;
      oGP_Log.Init('SCUD_Absent.log', true, true, true);

    }
    if _Packet=1
    { if GP_SCUD_Doc.cStatus<>_Status_Prev
      { oGP_Log.Write(GetDocumentName+' статус не совпадает, пропущен');
        exit;
      }
    }
    //----------------------------------
    // выполним проверку пред изменением статуса
    if _Status_Prev=pStatus_GetDefault
    { PushPos(#Gp_Scud_Doc_Sp);
      _Loop Gp_Scud_Doc_Sp
      { if CheckNeed_Sp_Description
        { _sErr:=GetDocumentName+' для основания "'
              +GP_SCUD_Doc.Description+'"'
              +chr(13)+' обязательно заполнение "поручения" в спецификации , пропущен';
          if _Packet=0
            message(_sErr)
          else
            oGP_Log.Write(_sErr);
          exit;
        } //if CheckNeed_Sp_Description
      } //_Loop Gp_Scud_Doc_Sp
      PopPos(#Gp_Scud_Doc_Sp);
    } //if _Status_Prev=pStatus_GetDefault


    //----------------------------------
    //----------------------------------
    if NPOEM_OWN_SCUD_CAN_CHANGE_STATUS=1
    { Timelog('GP_SCUD_StateMentOnAbsent->NPOEM_OWN_SCUD_CAN_CHANGE_STATUS=1');

      if _Packet=0
      { if (StatusChange.PickStatus(GP_SCUD_DOC.cStatus))
        { pTmp:=ChangeStatus(GP_SCUD_DOC.NRec,StatusChange.StatusChangeLog);
          if PTmp<>0
          { set GP_SCUD_DOC.cStatus:=StatusChange.StatusChangeLog.cStatusTo;
            update current GP_SCUD_DOC;
            SetEditMode(CanEditTbl);
            Result:=true;
          }
          Event_ReReadContainer;
        }
      }
      else
      { StatusChange.StatusChangeLog.cStatusTo:=_Status_New;
        pTmp:=ChangeStatus(GP_SCUD_DOC.NRec,StatusChange.StatusChangeLog);
        if PTmp<>0
        { set GP_SCUD_DOC.cStatus:=StatusChange.StatusChangeLog.cStatusTo;
          update current GP_SCUD_DOC;
          oGP_Log.Write('Изменили статус в '+GetDocumentName);
        }
      }
    } //if NPOEM_OWN_SCUD_CAN_CHANGE_STATUS=1
    else
    { StatusChangeLog.cStatusFrom:=GP_SCUD_DOC.cStatus;
      Timelog('GP_SCUD_StateMentOnAbsent->NPOEM_OWN_SCUD_CAN_CHANGE_STATUS=0, cStatusFrom='
        +string(StatusChangeLog.cStatusFrom,0,0));
      Case GP_Status.name of
      'оформляемый':
      { var _Podpis1:comp=GetPodpisPers(1,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec);
        var _Podpis2:comp=GetPodpisPers(2,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec);
        if _Podpis2=0 _Podpis2:=_Podpis1;
        if  _Podpis2<>UserPersNrec//UserAccessService.UserPersonsNRec
        { if(_Podpis2=_Podpis1)
          { _Podpis2:=GetPodpisPersZam(1,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec);
            _Podpis1:=_Podpis2;
          }
          else
          { _Podpis2:=GetPodpisPersZam(2,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec);
          }
          if  _Podpis2<>UserPersNrec//UserAccessService.UserPersonsNRec
          {
            if _Packet=0
            { message('У вас нет прав на смену статуса');
            }
            else
            { oGP_Log.Write('У вас нет прав на смену статуса '+GetDocumentName);
            }
            Exit;
          }
        }
        if _Podpis2=_Podpis1
        { StatusChangeLog.cStatusTo :=Status.GetByName('утвержден');
        }
        else
        { StatusChangeLog.cStatusTo :=Status.GetByName('согласован');
        }
        Timelog('GP_SCUD_StateMentOnAbsent->NPOEM_OWN_SCUD_CAN_CHANGE_STATUS=0, cStatusTo='
         +string(StatusChangeLog.cStatusTo,0,0));

        pTmp:=ChangeStatus(GP_SCUD_DOC.NRec,StatusChangeLog);
        if PTmp<>0
        { set GP_SCUD_DOC.cStatus:=StatusChangeLog.cStatusTo;
          update current GP_SCUD_DOC;
          if _Packet=1 oGP_Log.Write('Изменили статус в '+GetDocumentName);
          else SetEditMode(CanEditTbl);
          Result:=true;
        }
      }
      'согласован':
      { var _Podpis1:comp=GetPodpisPers(1,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec);

        if _Podpis1<>UserPersNrec//UserAccessService.UserPersonsNRec
        { _Podpis1:=GetPodpisPersZam(1,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec);
          if _Podpis1<>UserPersNrec//UserAccessService.UserPersonsNRec
          { if _Packet=0
            {  message('У вас нет прав на смену статуса');
            }
            else
            { oGP_Log.Write('У вас нет прав на смену статуса '+GetDocumentName);
            }
            Exit;
          }
        }
        Timelog('GP_SCUD_StateMentOnAbsent->NPOEM_OWN_SCUD_CAN_CHANGE_STATUS=0, cStatusTo='
         +string(StatusChangeLog.cStatusTo,0,0));
        StatusChangeLog.cStatusTo :=Status.GetByName('утвержден');
        pTmp:=ChangeStatus(GP_SCUD_DOC.NRec,StatusChangeLog);
        if PTmp<>0
        { set GP_SCUD_DOC.cStatus:=StatusChangeLog.cStatusTo;
          update current GP_SCUD_DOC;
          if _Packet=1 oGP_Log.Write('Изменили статус в '+GetDocumentName);
          else SetEditMode(CanEditTbl);
          Result:=true;
        }
      }
      else
      { if _Packet=0
        { if (StatusChange.PickStatus(GP_SCUD_DOC.cStatus))
          {
            pTmp:=ChangeStatus(GP_SCUD_DOC.NRec,StatusChange.StatusChangeLog);
            if PTmp<>0
            { set GP_SCUD_DOC.cStatus:=StatusChange.StatusChangeLog.cStatusTo;
              update current GP_SCUD_DOC;
              SetEditMode(CanEditTbl);
              Result:=true;
            }
          }
        }
        else
        { StatusChange.StatusChangeLog.cStatusTo:=_Status_New;
          pTmp:=ChangeStatus(GP_SCUD_DOC.NRec,StatusChange.StatusChangeLog);
          if PTmp<>0
          { set GP_SCUD_DOC.cStatus:=StatusChange.StatusChangeLog.cStatusTo;
            update current GP_SCUD_DOC;
            oGP_Log.Write('Изменили статус в '+GetDocumentName);
            Result:=true;
          }
        }
      }
      end;
      Event_ReReadContainer;
    }//else if NPOEM_OWN_SCUD_CAN_CHANGE_STATUS=1
    Timelog('GP_SCUD_StateMentOnAbsent->MyPickStatus:_Packet='+string(_Packet)+', Result='+string(Result));
    if Result
    if _Packet=0
    if GetCurrentFormat=brDoc
    { if pMarker.Count>0
      { if message('Установить статус для'
           +chr(13)+'всех отмеченных документов'+string(pMarker.Count)+'?',YesNo)<>cmYes
        { exit;
        }
        _Status_New  :=GP_SCUD_DOC.cStatus;
        _sStatus_new :=GP_Status.Name;
        _pDoc:=GP_SCUD_DOC.Nrec;
        StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm,
          'Изменение статуса', pMarker.Count);

        oGP_Log.Write('Изменяем статус "'+_sStatus_Prev+'" на "'+Gp_Status.Name+'"');
        PushPos(#GP_SCUD_Doc);
        SubBounds(tbRmGP_SCUD_Doc1);
        AddBounds(tbRmGP_SCUD_Doc2);
        timelog('Пакетное изменение статуса ');
        _Loop pMarker
        { if not NextVisual then break;
          if pMarker.pNRec=_pDoc continue;
          if getfirst GP_SCUD_Doc where (( pMarker.pNRec == GP_SCUD_Doc.Nrec))<>tsok continue;
          timelog('Пакетное изменение статуса  GP_SCUD_Doc.DocNMB='+GP_SCUD_Doc.DocNMB);
          MyPickStatus(1,_Status_Prev, _Status_New,_sStatus_new);
          timelog('Пакетное изменение статуса  GP_SCUD_Doc.DocNMB='+GP_SCUD_Doc.DocNMB);
        } //_Loop pMarker
        StopVisual('',0);
        SubBounds(tbRmGP_SCUD_Doc2);
        AddBounds(tbRmGP_SCUD_Doc1);
        PopPos(#GP_SCUD_Doc);
        ReScanPanel(#GP_SCUD_Doc);

      } //if pMarker.Count>0
    }//if GetCurrentFormat=brDoc
    if _Packet=0 oGP_Log.Done(true);
    isFilterRun:=false;
  }// MyPickStatus

Function GetPodrByScudPers(_cScudPers: comp) : comp;
{
 result := 0h;

 If getfirst GP_SCUD_PersCheck where ((_cScudPers == GP_SCUD_PersCheck.nrec )) <> tsOK
  then exit;

 If getfirst PersonsCheck where ((GP_SCUD_PersCheck.cPersons == PersonsCheck.nrec )) <> tsOK
  then exit;

 result := PersonsCheck.GalDep
}

Function CheckPodrAndReason(_cPodr, _cReason : comp) : boolean;
{
//  message(_cPodr  + ' ' +  _cReason);
  result := true;
  if Getfirst KatPodrCheck where ((_cPodr == KatPodrCheck.nrec)) <> tsOK
   then exit;

  if Getfirst GP_SCUD_ReasonCheck where ((_cReason == GP_SCUD_ReasonCheck.nrec)) <> tsOK
   then exit;

/* 20190918 Васильев сказал все вернуть в зад
    case substr(KatPodrCheck.Kod,1,3) of
     '222' : // '236'
       {
        if (upcase(GP_SCUD_ReasonCheck.name) = upcase('Личное заявление') or upcase(GP_SCUD_ReasonCheck.name) = upcase('Поручение руководителя'))
        {
         Message('Запрещено формировать личные заявления и поручения руководителя по подразделению ' + substr(KatPodrCheck.Kod,1,3),Error) ;
         result := false;
        }
       }
     '610' :
       {
        if upcase(GP_SCUD_ReasonCheck.name) = upcase('Личное заявление')
         {
          Message('Запрещено формировать личные заявления по подразделению ' + substr(KatPodrCheck.Kod,1,3),Error) ;
          result := false;
         }
       }
     end;
*/
}
  //---------------------------------------------
  // Загрузчик интерфейса
  //---------------------------------------------
  Procedure LoadInterface(_boVisibleRun:boolean);
  {   //чтобы сразу проинициализровать объект и заполнить таблицу с правами на типы событий
      iGP_SCUD_ReasonEdit.GetTypeDoc;
      PushBounds(tbByReasonRights);
      ////Аналитика для ведения причин отклонения заявления на отсутствие
      NPOEM_OWN_SCUD_ZAbsent_Refusal:=wGetTune('NPOEM_OWN.SCUD.ZAbsent_Refusal');
      if NPOEM_OWN_SCUD_ZAbsent_Refusal>0
      { cAttr_SCUD_DOC_Refusal  :=ExtAttr_CreateComp(coGP_SCUD_DOC,'Причина отклонения заявления на отсутствие',
                                         cgAttrType_Comp,0,NPOEM_OWN_SCUD_ZAbsent_Refusal);
      }
      else
      { cAttr_SCUD_DOC_Refusal:=0;
      }
      //----- Аналитика для ведения причин заявления на отсутствие
      NPOEM_OWN_SCUD_ZAbsent_REASON:=wGetTune('NPOEM_OWN.SCUD.ZAbsent_REASON');
      if NPOEM_OWN_SCUD_ZAbsent_REASON>0
      { ResetBounds(#tmp_reason);
        delete all tmp_reason;
        _Try
        { SQL
          select
             SpKau.Nrec as cSpKau
            ,Cast(SpKau_Up.Code as word) as wType
            ,SpKau.Name as sReason
            ,SpKau.Code as sCode
          from SpKau
          inner join SpKau SpKau_Up on SpKau_Up.Nrec = SpKau.cNode
               and SpKau_Up.KodGrKau =:(NPOEM_OWN_SCUD_ZAbsent_REASON)
          where SpKau.KodGrKau =:(NPOEM_OWN_SCUD_ZAbsent_REASON) and SpKau.cNode<>#Comp(0)
          into tmp_reason;
          SetBounds(#tmp_reason);
          ReReadRecord(#tmp_reason);
        }
        _Except
        else
        {

        }
      } // if NPOEM_OWN_SCUD_ZAbsent_REASON>0
      MySetFieldOption(NPOEM_OWN_SCUD_ZAbsent_REASON>0);
      //------------------------
      boExternal:=False;
      //------------------------
      inherited ::LoadInterface(_boVisibleRun);
      //------------------------
      if true //(wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci17Esc;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'StateMentOnAbsent';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;
      ReadParam;
      //===========================
      cAttr_SCUD_RUK    :=ExtAttr_CreateComp(coKatpodr,'СКУД. Должность сотрудника c правом подписи за руководителя',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
      cAttr_SCUD_ZGD    :=ExtAttr_CreateComp(coKatpodr,'СКУД. Должность сотрудника с правом подписи за функц.руководителя',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
      cAttr_SCUD_ISP:=ExtAttr_CreateComp  (coKatpodr,'СКУД. Должность исполнителя по умолчанию',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
      cAttr_SCUD_DOC_RUK:=ExtAttr_CreateComp(coGP_SCUD_DOC,'СКУД. Должность сотрудника c правом подписи за руководителя',
                                              cgAttrType_Comp,cgKatKau_System,coStaffStruct);
      cAttr_SCUD_DOC_RUKP:=ExtAttr_CreateComp(coGP_SCUD_DOC,'СКУД. Сотрудник c правом подписи за руководителя',
                                             cgAttrType_Comp, word(0),cgKau_Persons);
      cAttr_SCUD_DOC_ZGD :=ExtAttr_CreateComp(coGP_SCUD_DOC,'СКУД. Должность сотрудника с правом подписи за функц.руководителя',
                                              cgAttrType_Comp,cgKatKau_System,coStaffStruct);
      cAttr_SCUD_DOC_ZGDP:=ExtAttr_CreateComp(coGP_SCUD_DOC,'СКУД. Сотрудник c правом подписи за функц.руководителя',
                                              cgAttrType_Comp, word(0),cgKau_Persons);
      cAttr_SCUD_DOCSP_IN:=ExtAttr_Create(coGP_SCUD_DOC_SP,'Использовано сальдо', cgAttrType_dbl);
      //===========================
      UserPersNrec:=UserAccessService.UserPersonsNRec(true); //без сообщениий
      //===========================
      //if (not UserAccessService.IsAdmin)
      if False // Здесь добавить проверку на возможность редактирования
      { if wIntMode=0
        { //message('Вы не обладаете ролью Администратор.'#13'Редактирование запрещено.');
        }
        wIntMode:=wIntMode or cgiNotEdit
      }
      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
      //срок учета переработки
      NPOEM_OWN_SCUD_OVER2_SROC        := wGetTune('NPOEM_OWN.SCUD.OVER2_SROC'        );//Кол-во месяцев учета переработки', ftword,36,'','');
      NPOEM_OWN_SCUD_OVER2_SROC_D      := dGetTune('NPOEM_OWN.SCUD.OVER2_SROC_D'      );//Дата, до которой не учитывать переработку ', ftdate,'','','');
      NPOEM_OWN_SCUD_CAN_CHANGE_STATUS := wGetTune('NPOEM_OWN.SCUD.CAN_CHANGE_STATUS' );//Разрешать изменение статуса в любых документах
      NPOEM_OWN_HEAD_V_VID             := wGetTune('NPOEM_OWN.HEAD_V_VID'             );//В интерфейсе руководителя отображать
      NPOEM_OWN_SCUD_ZAbsent_Over2     := wGetTune('NPOEM_OWN.SCUD.ZAbsent_Over2'     );//Отображать сальдо по переработке в заявлении на отсутствие
      NPOEM_OWN_SCUD_ZAbsent_STATUS_M  :=coGetTune('NPOEM_OWN.SCUD.ZAbsent_STATUS_M'  );//Статус "утвержден" в заявлении на отсутствие'
      NPOEM_OWN_SCUD_ZAbsent_STATUS_C  :=coGetTune('NPOEM_OWN.SCUD.ZAbsent_STATUS_C'  );//Статус "отклонен" в заявлении на отсутствие'
      NPOEM_OWN_SCUD_ZAbsent_STATUS_C_E:=boGetTune('NPOEM_OWN.SCUD.ZAbsent_STATUS_C_E');//Отправлять Email при установке статуса "отклонен" в заявлении на отсутствие
      NPOEM_OWN_EMAIL_TYPE             := wGetTune('NPOEM_OWN.EMAIL_TYPE');//Тип отправки EMAIL

      if NPOEM_OWN_SCUD_ZAbsent_Over2=0
      { ClearFieldState(#Saldo,sfVisible);
      }
      else
      { SetFieldState(#Saldo,sfVisible);
      }
      DT_OST:=Sub_months(date(1,MonthRas,YearRas),NPOEM_OWN_SCUD_OVER2_SROC);
      if  NPOEM_OWN_SCUD_OVER2_SROC_D<>ZeroDate
        if NPOEM_OWN_SCUD_OVER2_SROC_D>DT_OST
          DT_OST:=NPOEM_OWN_SCUD_OVER2_SROC_D;
      DT_OST_SROC_Month :=month(DT_OST);
      DT_OST_SROC_Year  :=Year (DT_OST);

      BindEvent(onEvent_ReReadContainer, iGP_SCUD_EventsEdit.Event_ReReadContainer);
      NPOEM_OWN_SCUD_DOC_InsINClosePeriod:=boGetTune('NPOEM_OWN.SCUD.DOC_InsINClosePeriod');//Разрешить ввод документов в закрытом периоде
      NPOEM_OWN_SCUD_OVER2_IN_APPL:=boGetTune('NPOEM_OWN.SCUD.OVER2_IN_APPL');//Разрешить ввод сальдо на дату учета переработки в заявлениях
      ToggleFieldVisible(#OVER2_OST,NPOEM_OWN_SCUD_OVER2_IN_APPL);
      ZP_Period:=date(1,MonthRas,YearRas);
      NPOEM_OWN_SCUD_ZAbsent_PRINT_IN_DEF:=boGetTune('NPOEM_OWN.SCUD.ZAbsent_PRINT_IN_DEF');//Разрешить печать заявлений на отсутствие в оформляемом статусе

  } //Procedure LoadInterface(_wRunType:word);


//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Doc ;
cmSetDefault:
{ //if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  //{ exit;
  //}
  if isFilterRun
  { //isFilterRun:=false;
    exit; // - может нужно все таки выходить при этом флаге.

  }
  if boExternal
  { Exit;
  }
  timeLog('GP_SCUD_StateMentOnAbsent->GP_SCUD_Doc:cmSetDefault');
  MakeBufferGP_SCUD_Doc;
  Insert current GP_SCUD_Doc;
  timeLog('GP_SCUD_StateMentOnAbsent->GP_SCUD_Doc:cmSetDefault '+string(GP_SCUD_Doc.Nrec,0,0));
  SetNew(false);
  SetEditMode(CanEditTbl());
  PutCommand(cmEdit)
}
cmCheckRecord:
{ if boWinEdit
    if Not MyCheckRecord abort;
}
cmDoGetNext:
{ //if boWinEdit
  //  if Not MyCheckRecord abort;
}
cmDoGetPrev:
{ //if boWinEdit
  //  if Not MyCheckRecord abort;
}
cmCheckField:
{ Case Curfield of
  #GP_SCUD_Doc.DocDate:
  { if IsValidAll(#GP_SCUD_Doc_SP)
    { Message('при наличии спецификации запрещено изменять дату заявления');
      set GP_SCUD_Doc.DocDate:=StrToDate(Replace(OldFieldValue,'.','/'),'DD/MM/YYYY');
      exit;
    }
    if not NPOEM_OWN_SCUD_DOC_InsINClosePeriod
    { if GP_SCUD_Doc.DocDate<ZP_Period
      { message('Вам запрещено вводить документы'
         +chr(13)+'в закрытом периоде'
         +chr(13)+'(ранее '+DateToStr(ZP_Period,'DD.MM.YYYY')+')'
        );
        set GP_SCUD_Doc.DocDate:=ZP_Period;
      } //if GP_SCUD_Doc.DocDate<ZP_Period
    } //if not NPOEM_OWN_SCUD_DOC_InsINClosePeriod
    PushPos(#GP_SCUD_Doc_SP);
    _Loop fullcache GP_SCUD_Doc_SP
    { update current GP_SCUD_Doc_SP set GP_SCUD_Doc_SP.EventDate   :=GP_SCUD_Doc.DocDate;

    }
    PopPos(#GP_SCUD_Doc_SP);
    //Просят день в день if GP_SCUD_Doc.DocDate<GP_SCUD_Doc.Dinput
    if GP_SCUD_Doc.DocDate<=GP_SCUD_Doc.Dinput
    { set GP_SCUD_Doc.wTypeReg:=1;
    }
    else
    { set GP_SCUD_Doc.wTypeReg:=0;
    }
    ClearFuncCache;
    Set vPodp.cPodp1:=GetPodpisPers(1,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec); // (FieldName=cPodp1)
    Set vPodp.cPodp2:=GetPodpisPers(2,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec);// (FieldName=cPodp2)
  }
  end;

}
cmInsertRecord:
{ Insert Current GP_SCUD_Doc;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Doc;
}
cmDeleteRecord:
{ if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { message('Удаление доступно только в оформляемом статусе')
  }
  else
  { if message('Удалить документ '+GP_SCUD_Doc.DocNmb+'?', YesNo)=cmYes
    {  if not Can_Change_Status
       { message(  'По документу есть распределение'
          +chr(13)+'переработки за закрытый период!');
         exit;
       }
       delete GP_SCUD_Doc_Sp where (( GP_SCUD_Doc.Nrec == GP_SCUD_Doc_Sp.cGP_SCUD_Doc )) ;
       delete GP_SCUD_Days where (( GP_SCUD_Doc.Nrec == GP_SCUD_Days.cGP_SCUD_Doc ));
       delete Current GP_SCUD_Doc;
       if boExternal
       { CloseWindowEx(wnEdit,cmDone);
       }
    }
  }
}

cmPositionChanged:
{ PositionChanged;
}
end; //GP_SCUD_Doc

//------------------------------
TableEvent table GP_SCUD_Doc_SP;
//------------------------------
cmSetDefault:
{ if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { exit;
  }
  if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { message('Нельзя добавлять сотрудников не в "оформляемый" документ');
    exit;
  }
  if GP_SCUD_Doc.cKatPodr=0
  { message('Сначала заполните подразделение!');
    exit;
  }
  ClearBuffer(#GP_SCUD_Doc_SP);
  GP_SCUD_Doc_SP.cGP_SCUD_Doc:=GP_SCUD_Doc.Nrec;
  GP_SCUD_Doc_SP.wType       :=GP_SCUD_Doc.wType;
  GP_SCUD_Doc_Sp.cReason     :=GP_SCUD_Doc.cReason;
  GP_SCUD_Doc_SP.EventDate   :=GP_SCUD_Doc.DocDate;
  SelectField(#GP_SCUD_Pers.Fio);
  PutCommand(cmPick);
}
cmInsertRecord:
{ Insert Current GP_SCUD_Doc_SP;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Doc_SP;
}
cmDeleteRecord:
{ if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { message('Удаление доступно только в оформляемом статусе')
  }
  else
  { if message('Удалить строку из документа '+GP_SCUD_Doc.DocNmb, YesNo)=cmYes
    { if not Can_Change_Status
       { message(  'По документу есть распределение'
          +chr(13)+'переработки за закрытый период!');
         exit;
       }
      delete GP_SCUD_Days where (( GP_SCUD_Doc_SP.Nrec == GP_SCUD_Days.cGP_SCUD_Doc_SP ));
      delete Current GP_SCUD_Doc_Sp ;
    }
  }
}
//----------------------
cmExprFieldChanged :
{ case CurField of
  #OVER2_OST:
  { var _val:double;
    _val:=double(ExprFieldValue);
    if GP_SCUD_Doc_SP.cGP_SCUD_Pers>0
    { if not IsValidAll(#GP_SCUD_SALDO)
      { clearbuffer(#GP_SCUD_SALDO);
        GP_SCUD_SALDO.cGP_SCUD_PERS:=GP_SCUD_Doc_SP.cGP_SCUD_Pers;
        GP_SCUD_SALDO.MesN  :=DT_OST_SROC_Month;
        GP_SCUD_SALDO.YearN :=DT_OST_SROC_Year;
        GP_SCUD_Saldo.CH_OVER2_OST:=_Val;
        insert current GP_SCUD_SALDO;
      } //if not isvaliall(#GP_SCUD_SALDO)
      else
      { GP_SCUD_Saldo.CH_OVER2_OST:=_Val;
        update current GP_SCUD_SALDO;
      }
      ClearFuncCache;
    } //if GP_SCUD_Doc_SP.cGP_SCUD_Pers>0
    else
    { message('Сначала укажите работника!');
    }
    ReScanPanel(#GP_SCUD_Doc_SP);
  } //#OVER2_OST:
  end;
} //cmExprFieldChanged :
cmCheckField:
{ case CurField of
  #GP_SCUD_Doc_SP.EventDate:
  { if GP_SCUD_Doc_SP.EventDate<GP_SCUD_Doc.DocDate
    { Message('Дата события не может быть меньше даты приказа');
      set GP_SCUD_Doc_SP.EventDate:=GP_SCUD_Doc.DocDate;
    }

  }
  #GP_SCUD_Doc_Sp.EventTmB:// 'Время','с ' ('Начало периода отсутствия')
  { if GP_SCUD_Doc_Sp.EventTmB>time(23,59,59,0)
    { message('В сутках 24 часа!');
      set GP_SCUD_Doc_Sp.EventTmB:=time(23,59,59,0);
    }
    if GP_SCUD_Doc_Sp.EventTmB>GP_SCUD_Doc_Sp.EventTmE
    { message('Время начала не может быть больше даты окончания!');
      set GP_SCUD_Doc_Sp.EventTmE:=GP_SCUD_Doc_Sp.EventTmB;
    }
  }
  #GP_SCUD_Doc_Sp.EventTmE:// 'Время','по' ('Окончание периода отсутствия')
  { if GP_SCUD_Doc_Sp.EventTmE>time(23,59,59,0)
    { message('В сутках 24 часа!');
      set GP_SCUD_Doc_Sp.EventTmE:=time(23,59,59,0);
    }
    if GP_SCUD_Doc_Sp.EventTmB>GP_SCUD_Doc_Sp.EventTmE
    { message('Время начала не может быть больше даты окончания!');
      set GP_SCUD_Doc_Sp.EventTmB:=GP_SCUD_Doc_Sp.EventTmE;
    }
  }
  end;
}
cmPositionChanged:
{ PositionChanged_SP;
}
end; //GP_SCUD_Doc_SP


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { isFilterRun:=true;
      LoadInterFace(true);

      ClearFuncCache;
      if Marker<>0
      { pMarker.ImportFrom(Marker);
        if cRec=0
        { GetMarker(Marker,0,cRec);
        }
      }
      else
        pMarker.ImportFromName(pMarker.StoreName);
      //--------------------------
      SetFilterNm(0);
      SetFilterBounds(0);
      //--------------------------
      if UserAccessService.OnlyUserDoc(wTypeDoc)
      { AddBounds(tbByUserID);
      }

      if cRec=0
      { if not ReadMyDsk(cRec,'GP_SCUD_StateMentOnAbsent_cRec',false ) cRec:=0;
      }
      //--------------------------
      if cRec>0
      { if getfirst GP_SCUD_Doc where (( cRec == GP_SCUD_Doc.nrec ))=tsok {}
      }

      //-------------------------
      isFilterRun:=false;

      ReScanPanel(#GP_SCUD_Doc);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { SaveMyDsk(GP_SCUD_DOC.Nrec,'GP_SCUD_StateMentOnAbsent_cRec' );
      SaveParam;
      UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Doc.Nrec;
        }
        CloseInterface(cmDefault)
      }
      else
      { PutCommand(cmEdit);
      }
    }
    cmEdit:
    { case GetCurrentFormat of
      brDoc: RunWindowModal(wnEdit);
      end;
    }
    cmPick:
    { case curField of
      #GP_Status.Name:
      {

      }
      else
      { //пока уберем
        //if GetCurrentFormat=brDoc or GetCurrentFormat=brDocSp exit;
      }
      end;
      case curField of
      #GP_Status.Name:
      { //сохраним признак внешнего запуска
        var _boExternal:boolean=boExternal;
        //установим признак внешнего запуска, чтобы заблокировать добавление
        boExternal:=true;
        //---- выбор статуса
        MyPickStatus;
        //---- выбор статуса
        boExternal:=_boExternal;
        //------ обновим панель
        ReScanPanel(#GP_SCUD_DOC_SP);
        PositionChanged_SP;
        ReReadRecord;

      }
      #Podp_01E,#Persons_Podp1.Fio:
      { if RunWindowModal(wGetPodp)=cmDefault
        { coSetAttrID(coGP_SCUD_DOC,GP_SCUD_DOC.Nrec,cAttr_SCUD_DOC_RUK,tmp_podp.nrec,tmp_podp.name);
          coSetAttrID(coGP_SCUD_DOC,GP_SCUD_DOC.Nrec,cAttr_SCUD_DOC_RUKP,comp(0),'');
          ClearFuncCache;
          SetPodpisOnChange;
          ReScanPanel(#GP_SCUD_DOC);
        }
      }
      #KatPodr.Name,#KatPodr.Kod:
      {
        var _cPodr : comp = GP_SCUD_DOC.cKatPodr;
        if RunInterface('GetPodaLN',2, _cPodr, 1)=cmDefault
        if CheckPodrAndReason(_cPodr, if(isvalidall(tnGP_SCUD_Reason),GP_SCUD_Reason.nrec,0))
            { set GP_SCUD_DOC.cKatPodr:=_cPodr;
              SetPodpisantByDef;
              ClearFuncCache;
              Set vPodp.cPodp1:=GetPodpisPersZam(1,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec,true); // (FieldName=cPodp1)
              Set vPodp.cPodp2:=GetPodpisPersZam(2,GP_SCUD_DOC.cKAtPodr,GP_SCUD_DOC.Nrec,true);// (FieldName=cPodp2)
              pTmp:=coGetAttrID(coKatPodr,KatPodr.NRec,cAttr_SCUD_ISP);
              if pTmp<>0
              { set GP_SCUD_DOC.cExecutor:=PersNrecByStaff(pTmp);
              }
              if GP_SCUD_DOC.cExecutor=0
              { var _pPost:comp=0;
                var _pPersons:comp=0;
                if GetKatPodr_Boss(GP_SCUD_DOC.cKatPodr,_pPost,_pPersons)<>''
                { set GP_SCUD_Doc.cExecutor:=_pPersons;
                }
              }
            }
      } //#KatPodr.Name,#KatPodr.Kod:
      #Executor.Fio:  // исполнитель
      { pTmp:=GP_SCUD_Doc.cExecutor;
        if iGetKau.GetCodeKau(cgiPick,cgKau_Persons,pTmp)<>0
        { set GP_SCUD_Doc.cExecutor:=pTmp;
        }
      }
      #GP_SCUD_DOC.DESCRIPTION:
      { if NPOEM_OWN_SCUD_ZAbsent_REASON>0
        { pTmp:=0;
          if getfirst tmp_reason<>tsok
          { if iGetKau.GetCodeKau(cgiPick,NPOEM_OWN_SCUD_ZAbsent_REASON,pTmp)<>0
            { vSpr.pSpKau:=pTmp;
              if vSpr.getfirst SpKau=tsok
              set GP_SCUD_DOC.DESCRIPTION:=vSpr.SpKau.Name;
            }
          }
          else
          { if RunWindowModal(wnGetReason)=cmDefault
            { set GP_SCUD_DOC.DESCRIPTION:=tmp_reason.sReason;
            }
          } //if getfirst tmp_reason<>tsok
        } //if NPOEM_OWN_SCUD_ZAbsent_REASON>0
      } //#GP_SCUD_DOC.DESCRIPTION:
      #Refusal://    ('Причина отказа в утверждении заявления',,sci138Esc)  ,Protect,PickButton;
      { if NPOEM_OWN_SCUD_ZAbsent_Refusal=0
        { message('На задана аналитика для ведения "причин отказа"');
          exit;
        }
        pTmp:=coGetAttrID(coGP_SCUD_Doc,GP_SCUD_Doc.Nrec,cAttr_SCUD_Doc_Refusal);
        if iGetKau.GetCodeKau(cgiPick,NPOEM_OWN_SCUD_ZAbsent_Refusal,pTmp)<>0
        { coSetAttrID(coGP_SCUD_Doc,GP_SCUD_Doc.Nrec,cAttr_SCUD_Doc_Refusal
                       ,ptmp, ShowKau(NPOEM_OWN_SCUD_ZAbsent_Refusal,ptmp));
          ReScanPanel(#GP_SCUD_Doc);
        }
      }
      #sFlt_DESCRIPTION:
      { if NPOEM_OWN_SCUD_ZAbsent_REASON>0
        { pTmp:=0;
          if iGetKau.GetCodeKau(cgiPick,NPOEM_OWN_SCUD_ZAbsent_REASON,pTmp)<>0
          { vSpr.pSpKau:=pTmp;
            if vSpr.getfirst SpKau=tsok
              set sFlt_DESCRIPTION:=vSpr.SpKau.Name;
          }
        }
      }
      #GP_SCUD_Pers.Fio:
      { if GP_SCUD_DOC.cStatus<>pStatus_GetDefault
        { Message('Изменение ФИО '#13'возможно только в статусе "черновик"' );
          exit;
        }

        Marker_Tmp :=InitMarker(''  , 8, 200, 10);
        Marker_Podr:=InitMarker(''  , 8, 200, 10);
        FillMarker_PodrByIE(Marker_Podr,GP_SCUD_DOC.cKatPodr);
        var cTmpKatPodr : comp = GP_SCUD_DOC.cKatPodr; // чтобы не слетало подразделение(221)
        //if RunInterface(GP_SCUD_PersEdit,cgiPickMult,GP_SCUD_DOC_SP.cGP_SCUD_PERS,Marker_Tmp,GP_SCUD_DOC.cKatPodr)<>cmCancel
        if RunInterface(GP_SCUD_PersVib,cgiPickMult,GP_SCUD_DOC_SP.cGP_SCUD_PERS,Marker_Tmp,GP_SCUD_DOC.cKatPodr,Marker_Podr)<>cmCancel
        { var ii:longint;
          var _nrec:comp;
          boPositionChange_Lock:=true;
          for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
          { if not GetMarker(Marker_Tmp,ii,_nrec) continue;
            if not CheckPodrAndReason(GetPodrByScudPers(_nrec), GP_SCUD_Doc.cReason) then continue;

            if ii=0
            { set GP_SCUD_DOC_SP.cGP_SCUD_PERS:=_nrec;
              set GP_SCUD_DOC.cKatPodr := cTmpKatPodr;
              SetModified(true);
              //update current GP_SCUD_DOC_SP;
              UpdateTable;// ломает базу;
            }
            else
            { ClearBuffer(#GP_SCUD_Doc_SP);
              GP_SCUD_Doc_SP.cGP_SCUD_Doc :=GP_SCUD_Doc.Nrec;
              GP_SCUD_Doc_SP.wType        :=GP_SCUD_Doc.wType;
              GP_SCUD_Doc_Sp.cReason      :=GP_SCUD_Doc.cReason;
              GP_SCUD_Doc_SP.EventDate    :=GP_SCUD_Doc.DocDate;
              GP_SCUD_DOC_SP.cGP_SCUD_PERS:=_nrec;
              insert current GP_SCUD_DOC_SP;
            }
          }//for(ii:=0;ii<GetMarkerCount(Marker_Tmp),ii++)
          boPositionChange_Lock:=false;
          PositionChanged_SP;
          ReScanPanel(#GP_SCUD_DOC_SP);
        }
        DoneMarker(Marker_Tmp,'');
      }
      #GP_SCUD_Reason.Name:
      { if GP_SCUD_DOC.cStatus<>pStatus_GetDefault
        { Message('Изменение типа заявления '#13'возможно только в статусе "черновик"' );
        }
        else
        {
          var _creason : comp = GP_SCUD_DOC.cReason;
          if RunInterface(GP_SCUD_ReasonEdit,cgiPick,_creason,0)<>cmCancel
          {
           if CheckPodrAndReason(IF(ISvALIDALL(TNKatPodr),KatPodr.NREC,0H), _creason)
           { set GP_SCUD_DOC.cReason:=_creason;
             SetEditMode(CanEditTbl);
             ClearFuncCache;
           }
          }
        }
      }
      /*
      #GP_SCUD_Reason_SP.Name:
      { if RunInterface(GP_SCUD_ReasonEdit,cgiPick,GP_SCUD_DOC_SP.cReason,0)<>cmCancel
        { set GP_SCUD_DOC_SP.cReason:=GP_SCUD_DOC_SP.cReason;
        }
      }
      */
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,2);
        }
      }
      #Filtr_GP_SCUD_Pers:
      { if GetMarkerCount(Marker_Katpodr)>0
        { StoreMarker(Marker_Katpodr,'GP_SCUD_PersEdit_KatPodr');
        }
        if RunInterface(GP_SCUD_PersVib,cgiPickMult,0,Marker_GP_SCUD_Pers,0)<>cmCancel
        { SetFilterNm(#Filtr_GP_SCUD_Pers);
            BitOnW(wFilter,3);
        }
      }
      #Filtr_GP_SCUD_Reason:
      { if RunInterface(GP_SCUD_ReasonEdit,cgiPickMult,0,Marker_GP_SCUD_Reason)<>cmCancel
        { SetFilterNm(#Filtr_GP_SCUD_Reason);
          BitOnW(wFilter,4);
        }
      }
      #Filtr_GP_Status:
      { var _cTypeDoc:comp=Gp_TypeDocs_Find.Nrec;
        if RunInterface(GP_Common::GP_StatusPickAndEdit,_cTypeDoc,cgiPickMult,pflt_GP_Status,Marker_GP_Status)<>cmCancel
        { SetFilterNm(#Filtr_GP_Status);
          BitOnW(wFilter,6);
        }

      }
      end;
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      #Refusal://    ('Причина отказа в утверждении заявления',,sci138Esc)  ,Protect,PickButton;
      { coSetAttrID(coGP_SCUD_Doc,GP_SCUD_Doc.Nrec,cAttr_SCUD_Doc_Refusal ,0, '');
        ReScanPanel(#GP_SCUD_Doc);
      }
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatPodr);
      }
      #Filtr_GP_SCUD_Pers:
      { ClearMarker(Marker_GP_SCUD_Pers);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_GP_SCUD_Pers);
      }
      #Filtr_GP_SCUD_Reason:
      { ClearMarker(Marker_GP_SCUD_Reason);
        BitOffW(wFilter,4);
        SetFilterNm(#Filtr_GP_SCUD_Reason);
      }
      #Filtr_GP_Status:
      { ClearMarker(Marker_GP_Status);
        BitOffW(wFilter,6);
        SetFilterNm(#Filtr_GP_Status);
      }
      else abort;
      end;
    }

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Doc: RunInterface('ExClassifier', coGP_SCUD_Doc, GP_SCUD_Doc.nRec);
      end;
      ClearFuncCache;
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(0);
      }
      else RestFromA
    }
    //--------------------------
    cmPrintDoc : PrintDoc;
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Doc: RunInterface('Attribute', coGP_SCUD_Doc, GP_SCUD_Doc.nRec);
      end;
      ClearFuncCache;
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #GP_SCUD_Doc:
      { if pr_CurUserAdmin
        { ProcessCommand(RunMenu('GP_SCUD_DocEdit_Main_HotKey_Adm'));
        }
        else
        { ProcessCommand(RunMenu('GP_SCUD_DocEdit_Main_HotKey'));
        }
      }
      end;
    }
  end;

end.

GP_SCUD_DocEdit_Main_HotKey Menu
{
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
//- 'Внешняя классификация', cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
//- 'Внешние атрибуты'     , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}

GP_SCUD_DocEdit_Main_HotKey_Adm Menu
{
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Внешняя классификация', cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
- 'Внешние атрибуты'     , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}

/*

// в Support SQL запись выдаёт, а в окне фейса строка не появляется

      sql
      select            GP_SCUD_Doc.cStatus,
            GP_SCUD_Doc_SP.EventDate //     : date "Дата события"
          , GP_SCUD_Doc_SP.EventTmB  //    : time "Время события с"
          , GP_SCUD_Doc_SP.EventTmE  //     : time "Время события по"
          , COALESCE(GP_SCUD_Reason.wType,0) as wType
          , GP_SCUD_Doc_SP.cGP_Scud_Pers
          , GP_SCUD_Doc.DocNmb
          , GP_SCUD_Doc.DocDate
          , GP_SCUD_Doc_SP.Description
          , GP_SCUD_Doc_SP.Nrec as cGp_SCUD_DOC_SP
      from GP_SCUD_Doc_SP
      Inner join GP_SCUD_Doc on GP_SCUD_Doc.Nrec = GP_SCUD_Doc_SP.cGP_SCUD_Doc
                and GP_SCUD_Doc.wType=1010 //GP_iSC_statement_on_absence;//1010
                and GP_SCUD_Doc.cStatus<>#comp(2814749767106630)
      Left Outer join GP_SCUD_Reason on
          GP_SCUD_Reason.Nrec = CASE WHEN GP_SCUD_Doc_SP.cReason  <>#Comp(0)
                                     THEN GP_SCUD_Doc_SP.cReason
                                     ELSE GP_SCUD_Doc.cReason END
      where
        (   #date(01,10,2017)<=GP_SCUD_Doc_SP.EventDate
         and
        #Date(31,10,2017)>=GP_SCUD_Doc_SP.EventDate
         and
          #comp(2814749767116320)=GP_SCUD_Doc_SP.cGP_Scud_Pers
        )
;

*/
