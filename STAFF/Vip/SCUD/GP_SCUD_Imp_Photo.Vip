VipInterface GP_SCUD_Imp_Photo Licensed(free);
#doc
загрузка фотографий citizenid_fio.jpg
#end
Interface GP_SCUD_Imp_Photo 'Импорт фотографий' , EscClose;
var nm_dir:string;
Create view as select Persons.Nrec
from Persons, Appendix, GP_SCUD_Pers;

Procedure FormDoc;
var sDir : String;
    sFilePhoto : String;
    sExtPhoto : String;
    nppstr:longint;
    sID:string;
    sFio:string;
{
  sExtPhoto:='jpg';
  sDir:=nm_dir+'\*.'+sExtPhoto;
  sFilePhoto:='';
  nppstr:=0;
  if FindFirstFileCli(sDir,sFilePhoto) //Возвращает имя файла с путем!!!
  {
  do {
    nextvisual;
    nppstr++;

    if not fileexist(sFilePhoto)
    {
      continue;
    }

    sID:=Replace(Replace(sFilePhoto,nm_dir+'\',''),'.'+sExtPhoto,''); //Только имя файла без расширения
    sfio:=Substr(sID,pos('_',sID)+1,200); //
    sID:=Substr(sID,1,pos('_',sID)-1);
    if getfirst Persons where (( comp(sID) == Persons.Nrec )) <>tsok then continue;
    //Фото
    if Getfirst Appendix Where  ((  1 == Appendix.ObjBlock
                              and Persons.Nrec == Appendix.Person
                              and 200 == Appendix.ObjType )) <>tsOk
    {
      Clearbuffer(tnAppendix);
      Appendix.ObjBlock:= 1;
      Appendix.Person  := Persons.Nrec;
      Appendix.ObjType := 200;
      Appendix.ABSTRACT:= 'Фотография';
      SetMemoPrefix(tnAppendix,UpCase(sExtPhoto));
      if (Insert current Appendix = tsOk)
      {
        if ImportFileToMemo(Appendix.CONTENTS, sFilePhoto, false)
        {
          //MyLogWriteSlk('Загрузили фото '+sFilePhoto+' Таб.№'+wtn,'Appendix',Appendix.Nrec,cgLog_Insert)
          Update current Appendix;
          //deletefile(sPhotoPath);
        }
        else
        {
          if Delete current Appendix = tsOk {}
          //MyLogWriteSlk('Ошибка! Не загрузили фото '+sFilePhoto+' в мемо поле.','Appendix',Appendix.Nrec,cgLog_Error);
       }
      }
    }
    if getfirst GP_SCUD_Pers where (( Persons.nrec == GP_SCUD_Pers.cPersons )) =tsok
    { //GP_SCUD_Pers.LPHOTO
      SetMemoPrefix(tnGP_SCUD_Pers,UpCase(sExtPhoto));
      if ImportFileToMemo(GP_SCUD_Pers.LPHOTO, sFilePhoto, false)
      {   Update current GP_SCUD_Pers;
      }
    }
  }
  while FindNextFileCli(sFilePhoto); //Возвращает имя файла с путем!!!
  }
  else
  {  message('Не нашли фотографий');
  }
  DoneFileFinderCli; // уничтожаем объект поиска файлов
} //Procedure FormDoc;

Screen scrParam;
Fields
  nm_dir:NoProtect, PickButton;
Buttons
  cmOk    ,,, 'Установить фильтр', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;

<<
Выберите каталог  c фотографиями CitizenID_Fio.Jpg
   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 <. Продолжить .>  <.   Отмена   .>
>>
end;


HandleEvent
  cmInit:
  { nm_dir:='';
    if not ReadMyDsk(nm_dir,'GP_SCUD_Imp_Photo_nm_dir',False)
      nm_dir:='d:\Galaxy\RedMine\_Photo' ;
    timelog_init;
  }
  cmOk:
  { SaveMyDsk(nm_dir,'GP_SCUD_Imp_Photo_nm_dir');

    StartNewVisual(vtNumericVisual, vfTimer, 'Ждите, идет импорт данных', 0);
    FormDoc;
    StopVisual('',0);
  }
  cmPick:
  { case CurField of
    #nm_Dir:
    { var ww_str:string=GetDirName('Выберите каталог  c фотографиями ');
      if ww_str<>'' set nm_dir:=ww_str;
    }
    end;
  }
  end;

end.


