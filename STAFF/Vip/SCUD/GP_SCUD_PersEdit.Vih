#ifndef __GP_SCUD_PersEdit__
#define __GP_SCUD_PersEdit__
#include GP_SCUD_Base.Vih

#component "GP_STAFF"
#doc
Список людей в СКУД
#end

vipinterface GP_SCUD_PersEdit(GP_SCUD_BASE) Parameters
   (wIntMode:word
    ;cRec:comp
    ;Marker:longint
    ;pKatpodr:comp=0
    )
  Licensed(free);
Public:
  Function  oGP_SCUD_Base.GetTypeDoc:word;
  Procedure oGP_SCUD_Base.LoadInterface(_boVisibleRun:boolean);
  Procedure oGP_SCUD_Base.SetEditMode(Value: boolean);

  Procedure oGP_SCUD_Base.EnableDisableInsert(_Enable:boolean);

  Function GetPersName(_pNrec:comp)   :string;
  Function GetPersCode(_pNrec:comp)   :string;
  Function GetPersType(_pNrec:comp)   :word;
  Function GetPersTypeName(_wType:word) :string;
  #doc
    Создание/изменение буфера записи
  #end
  Function MakeBufferPers(_pPersons:comp //ссылка на карточку
                         ;_pAppointments:comp   //дата изменения
                         ;_pTitleDoc:comp//ссылка на приказ
                         ;_pContDoc:comp
                         ;_TypeOper:word=0
                         ):boolean;
  Function DeleteBufferPers(_pPersons:comp //ссылка на карточку
                         ;_pAppointments:comp   //дата изменения
                         ;_pTitleDoc:comp//ссылка на приказ
                         ;_pContDoc:comp
                         ;_TypeOper:word=0
                         ):boolean;
  Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _cNrec     : comp;  // ссылка на "Ведомость"
  _cPersons  : comp;   // выбранная запись
  _cKatpodr  : comp;   // выбранная запись
  _cKatOrg   : longint; // включить определенные форматы
  _DTB       : Date; //период просмотра
  _DTE       : Date; //период просмотра
  _NoVisual  : boolean=false //не перерисовывать экраны
  ) : boolean;
  Procedure SyncAllPers();

end;
// сокращенная версия
vipinterface GP_SCUD_PersVib(GP_SCUD_BASE) Parameters
   (wIntMode:word
    ;cRec:comp
    ;Marker:longint
    ;pKatpodr:comp=0
    ;Marker_Podr:longint=0
    )
  Licensed(free);
Public:
  Function  oGP_SCUD_Base.GetTypeDoc:word;
  Procedure oGP_SCUD_Base.LoadInterface(_boVisibleRun:boolean);
end;

#end //GP_SCUD_PersEdit
