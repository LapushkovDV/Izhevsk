#include CatFunc.Vih
#include GetKau.Vih
#include GP_StatusAccessEdit.vih
//---------------------------------
#include GP_Protector.Vih
#include GP_UserAccessService.vih
#include GP_SCUD_KategEdit.Vih
#include GP_SCUD_GrupEdit.Vih
#include GP_SCUD_EventsEdit.Vih

#include GP_SCUD_SaldoCalc.Vih
#doc
Сальдо часов в СКУД
#end
//Интерфейс GP_Staff::SCUD_PassEdit не найден
Interface GP_SCUD_SaldoCalc 'Сальдо часов' , EscClose;
//--------------------------------------------
var
//-------------------
  iGP_SCUD_EventsEdit :GP_SCUD_EventsEdit New;
//------------------------------
  wMesRas  ,wYearRas  :word;
  wMesRas_P,wYearRas_P:word;
  PeriodCount:word;
  //Включить детальный лог при ежедневном расчете сальдо
  NPOEM_OWN_SCUD_CALC_SALDO_DETAIL_LOG:boolean;
//----------------------------------------
  logfilenm:string;
Create View
var
  DT_Calc:date;
  DTB, DTE :date;
as select GP_SCUD_PERS.Nrec
From
  GP_SCUD_PERS
, GP_SCUD_PERS GP_SCUD_PERS_TT
, GP_SCUD_PERS GP_SCUD_PERS_B
, Lschet
, GP_TimeTable
, DISEASE
where ((
  Root == GP_SCUD_PERS.Fio
//Дата окончания пропуска не правильно заполнена
//and (GP_SCUD_PERS.Propusk_To=ZeroDate or GP_SCUD_PERS.Propusk_To>DT_Calc)
and GP_SCUD_PERS.cPersons == Persons.Nrec

and wMesRas_P  == GP_TimeTable.MonthN
and wYearRas_P == GP_TimeTable.YearN
and GP_TimeTable.cLSchet == Lschet.Nrec
and Lschet.tPerson == GP_SCUD_PERS_TT.cPersons
and DTB <<=DISEASE.LASTDATE(noindex)
and DTE >>=DISEASE.LASTDATE(noindex)
And DISEASE.Nrec /== BLISNET.SRCREC //(noindex)
and DTB>>BLISNET.DataN(Noindex)
and BLISNET.TPERSON == GP_SCUD_PERS_B.cPersons
))
;
Parameters
  wYearRas
#doc
#end
, wMesRas
;


//===============================================================
#doc
 Окно с паузой. Во избежания вылета галактики при автозапуске нужно сделать паузу
 Падает NowRun
#end
window wnPause 'Паузв';
 show at (,,10,5);
 screen scrMain;
 <<
    Пауза
 >>
 end;
End;

Procedure MyLog(w:string);
{ if Logfilenm=''
  { logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0)+
      '\SCUD_CALC_SALDO_'+DateToStr(Cur_Date,'YYYY_MM_DD')+TimeToStr(Cur_Time,'HHMM')+'.log';
    if fileExist(logfilenm) DeleteFile(logfilenm);
    MyLog('=== Расчет сальдо === ');
  }
  LogStrtofile(logfilenm,w);
}


//-----------------------------------
//
//-----------------------------------
Function Calc_Saldo:boolean;
var IsAllOk:boolean;
{ Result:=false;
  //UpdateTable;
  MyLog('Расчет сальдо за '+string(wMEsRas)+'/'+string(wYearRas));

  StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak + vfConfirm,'Ждите, идет пересчет сальдо'
     +chr(13)+'за '+string(wMesRas)+' мес. '+string(wYearRas)+' год'
    ,RecordsInTable(#GP_SCUD_PERS));
  // _Loop fullcache GP_SCUD_Saldo where (( wYearRas == GP_SCUD_Saldo.YearN
  //     and wMesRas == GP_SCUD_Saldo.MesN ))
  DT_Calc:=Date(1,wMesRas,wYearRas);
  var _DT_Calc1:date=Sub_Months(DT_Calc,3);
  IsAllOk:=true;
  _Loop fullcache GP_SCUD_PERS
  { if not NextVisual then
    { IsAllOk:=false;
      break;
    }
    if not isvalidall(#Persons) then continue;
    if Persons.DisDate<>ZeroDate
    { if Persons.DisDate<_DT_Calc1 then continue;

    }
    if NPOEM_OWN_SCUD_CALC_SALDO_DETAIL_LOG
    { MyLog('  Расчет для '+GP_SCUD_PERS.FIO);
    }
    if not iGP_SCUD_EventsEdit.CalcAll(GP_SCUD_PERS.Nrec,wYearRas,wMesRas //Год , месяц расчета
    ,1//0 при расчета считаются , что на все свкрхурочные есть приказ
                      //1 учитываются только проведенные приказы, если задан _DayCalc - то это вызов из приказа, и за этот день не учитываются
    ,true // true - с перерасчетом
    ,0 //DayCalc:word =0//при расчете для приказов указать день
    )
    { MyLog('Error iGP_SCUD_EventsEdit.CalcAll GP_SCUD_PERS.Nrec='+string(GP_SCUD_PERS.Nrec,0,0) );
      break;
    }
  } //_Loop fullcache GP_Saldo_Pers
  StopVisual('',0);
  if not IsAllOk then Exit;
  //---------------------------------------
  // Рассчитаем по корректировочным табелям
  //---------------------------------------
  var ii:longint=0;
  if PeriodCount=1
  { //---------------------------------------
    _Loop fullcache GP_TimeTable ii++;
    //---------------------------------------

    StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak + vfConfirm,'Ждите, идет пересчет сальдо по корр.табелям прошлого месяца',II);
    _Loop GP_TimeTable
    { if not NextVisual then
      { IsAllOk:=false;
        break;
      }
      if getfirst Lschet<>tsok continue;
      if getfirst GP_SCUD_PERS_TT<>tsok continue;
      iGP_SCUD_EventsEdit.CalcAll(GP_SCUD_PERS_TT.Nrec
               ,GP_TimeTable.YearN
               ,GP_TimeTable.MonthN
               ,2 //1
               ,true
               ,0
               );

    }//_Loop GP_TimeTable
    StopVisual('',0);
    if not IsAllOk then Exit;

    //---------------------------------------
    // Рассчитаем по больничным
    //---------------------------------------
    ii:=0;
    //---------------------------------------
    _Loop fullcache DISEASE ii++;
    //---------------------------------------
    StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak + vfConfirm,'Ждите, идет пересчет сальдо по больничным прошлого месяца',II);
    _Loop DISEASE
    { if not NextVisual then
      { IsAllOk:=false;
        break;
      }
      if getfirst GP_SCUD_PERS_B<>tsok continue;
      iGP_SCUD_EventsEdit.CalcAll(GP_SCUD_PERS_B.Nrec
               ,year(Blisnet.DataN)
               ,month(Blisnet.DataN)
               ,2 //1
               ,true
               ,0
               );
      if Blisnet.DataN<date(1,wMesRas_P,wYearRas_P)
      { iGP_SCUD_EventsEdit.CalcAll(GP_SCUD_PERS_B.Nrec
               ,wYearRas_P
               ,wMesRas_P
               ,2 //1
               ,true
               ,0
               );
      }
    }//_Loop BLISNET
    StopVisual('',0);
    if not IsAllOk then Exit;
  }//if PeriodCount=1
  Result:=true;
  MyLog('Расчет сальдо за '+string(wMEsRas)+'/'+string(wYearRas)+' завершен');

} //Function Calc_Saldo:boolean;





//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { PeriodCount:=1;
      //Включить детальный лог при ежедневном расчете сальдо
      NPOEM_OWN_SCUD_CALC_SALDO_DETAIL_LOG:=boGetTune('NPOEM_OWN.SCUD.CALC_SALDO_DETAIL_LOG');

      if wYearRas=0
      { wYearRas:=year (Cur_Date);
        wMesRas :=month(Cur_Date);
        //до числа 5 текущего месяца делать два шага пересчета: предыдущий месяц и текущий
        if Day(Cur_Date)<=5
        { PeriodCount:=2;
          wMesRas:=wMesRas-1;
          if wMesRas=0
          { wMesRas:=12;
            wYearRas:=wYearRas-1;
          }
        } //if Day(Cur_Date)<=5
      } //if wYearRas=0
      var ii:word;
      For(ii:=1;ii<=PeriodCount;ii++)
      {

        DTB:=Date(1,wMesRas,wYearRas);
        DTE:=Date(Last_Day(DTB),wMesRas,wYearRas);
        wYearRas_P:=wYearRas;
        wMesRas_P:=wMesRas-1;
        if wMesRas_P=0
        { wMesRas_P:=12;
          wYearRas_P:=wYearRas_P-1;
        }
        //PutCommand(cmValue1);
        Calc_Saldo;
        wMesRas:=wMesRas+1;
        if wMesRas=13
        { wMesRas:=1;
          wYearRas:=wYearRas+1;
        }
      } //For(ii:=1;ii<=PeriodCount;ii++)
      RunWindow(wnPause);
      StartTimer(cmValue2,2,False);
    }
    cmValue1:
    {  Calc_Saldo;
    }
    cmValue2:
    { StopTimer(cmValue2);
      closeinterface(cmDone) ;
    }
  end;
end.
