#include GP_GetPodalN.Vih


VipInterface GP_SCUD_mng_Podr_Areal Licensed(free);
#doc
Ведение справочника соответствия подразделений и ареалов
#end

Const
 coEMSpKauPodrAreal = 10249;
end;
Interface GP_SCUD_mng_Podr_Areal 'Ведение справочника соответствия подразделений и ареалов' , EscClose;
var nm_dir:string;

Create view as select
  Podr.nrec
, Area.nrec
From
   katpodr Podr
 , GP_SCUD_AREAS Area
 , GP_SCUD_AREAS AreaSelect
 , SpKau SpKauPodrArea
 , Kaureff KaurefPodr
 , Kaureff KaurefArea
 , Kaureff
 where (( coEMSpKauPodrAreal == SpKauPodrArea.kodgrkau
// Podr
                 and coSpKau == KaurefPodr.coTable
  and     SpKauPodrArea.nrec == KaurefPodr.crec
  and          cgKau_KatPodr == KaurefPodr.wKau //2
  and       KaurefPodr.cKau  == podr.Nrec
// Stat
                 and coSpKau == KaurefArea.coTable
  and     SpKauPodrArea.nrec == KaurefArea.crec
  and            word(31564) == KaurefArea.wKau
  and        KaurefArea.cKau == Area.Nrec
 ))
 ;
Window winGetArea 'Выбор ареала СКУД', DoAccept;
Browse brwinGetArea (,,sci178Esc);
 table AreaSelect;
 fields
  AreaSelect.Display_Name 'Ареал'('Ареал'):[9], Protect, PickButton;
end; // brSpKauEmailLottery
end;

Window winSpKauPodrArea 'Сопоставление подразделений - ареалов СКУД'
Browse brSpKauPodrArea (,,sci178Esc) ;
 table SpKauPodrArea;
 fields
  Podr.name  'Подразделение'('Подразделение'):[10], Protect, PickButton;
  Podr.kod  'Подразделение код'('Подразделение'):[3], Protect, PickButton;
  Area.Display_Name 'Ареал'('Ареал'):[9], Protect, PickButton;
end; // brSpKauEmailLottery
Tableevent table SpKauPodrArea;
cmUpdateRecord:
{
 SpKauPodrArea.name := Podr.kod+'|'+Area.Display_Name;
 Update Current SpKauPodrArea;
 ReScanPanel(#SpKauPodrArea);
}
cmInsertRecord:
 {
//   message('INSERT');
   SpKauPodrArea.kodgrkau := coEMSpKauPodrAreal;
   Insert current SpKauPodrArea;
 }
cmPick:
{
//  message('coEMSpKauEmaillottery='+coEMSpKauEmaillottery);
 if isnew then insert current  SpKauPodrArea ;
  case curfield of
   #Podr.kod,#Podr.name  :{var _cKau : comp = KaurefPodr.cKau;
                 if RunInterface('GP_ZP::GP_GETPODALN',2, _cKau, 1, 0)=cmDefault {
                 if not isvalid(tnKaurefPodr) then {
                    clearbuffer(tnKaurefPodr);
                    KaurefPodr.coTable  := coSpKau;
                    KaurefPodr.crec     := SpKauPodrArea.nrec;
                    KaurefPodr.wKau     := cgKau_KatPodr;
                   insert current KaurefPodr;
                  }
                  set KaurefPodr.cKau := _cKau;
                  update current KaurefPodr;
                 }
               }
   #Area.Display_name :{if RunWindowModal(winGetArea) = cmDefault{
                   if not isvalid(tnKaurefArea) then {
                      clearbuffer(tnKaurefArea);
                      KaurefArea.coTable  := coSpKau;
                      KaurefArea.crec     := SpKauPodrArea.nrec;
                      KaurefArea.wKau     := word(31564);
                     insert current KaurefArea;
                    }
                   set KaurefArea.cKau := AreaSelect.nrec;
                   update current KaurefArea;
                  }
               }
   end;
    SpKauPodrArea.name := Podr.kod+'|'+Area.Display_Name;
   Update Current SpKauPodrArea;
   Rereadrecord;
}
CmDeleteRecord:
{
  delete Kaureff where ((coSpKau == Kaureff.coTable and SpKauPodrArea.nrec == Kaureff.crec));
  delete current SpKauPodrArea;
}
end;
end;
handleevent
cminit:
{
  RunWindowModal(winSpKauPodrArea);
 closeinterface(-1)  // костыль.. а что делать, само решение костыльное, наверняка попросят еще исключения добавить персонально по людям....
}
end;
end.
