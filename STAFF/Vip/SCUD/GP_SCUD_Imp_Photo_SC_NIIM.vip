#doc
Интерфейс загрузки фото пользователей НИИМАШ.
Наименование фото в формате "Иванов Иван Иванович 01-01-2022.jpg"
#end

Interface GP_SCUD_Imp_Photo_SC_NIIM 'Интерфейс загрузки фото пользователей НИИМАШ', EscClose;
Show at (0,0,56,8);


const
  sPhotoExt : string = '.jpg';
end;

var
  nm_dir : string;

Table Struct tmpPersons
(
  Nrec : comp,
  CustomField : string
)
with index
(
  indx0 = CustomField
);

Create View as
Select
     Pers.Nrec
From
    Persons Pers
  , GP_SCUD_Pers
  , tmpPersons
  , Appendix
Where ((
      Pers.Nrec == GP_SCUD_Pers.cPersons
  and 'С' == Pers.isEmployee (noindex)
));


Procedure LoadPhotos();
begin

  var
      sPhotoFile,
      sDir        : string;

  sPhotoFile := '';
  sDir := nm_dir + '\*' + sPhotoExt;


  delete all tmpPersons;
  _loop Pers
  {
    set tmpPersons.Nrec := Pers.Nrec;
    set tmpPersons.CustomField := Pers.FIO + ' ' + Replace(Pers.BornDate, '/', '-');

    insert current tmpPersons;
  }


  if (FindFirstFileCli(sDir, sPhotoFile) = true)
  {
    do
    {
      NextVisual();


      //Обработка имени файла - оставляем только имя
      var sPhotoFileName : string;

      sPhotoFileName := Replace(sPhotoFile, nm_dir+'\', '');
      sPhotoFileName := Replace(sPhotoFileName, sPhotoExt, '');

      if (getfirst tmpPersons where ((sPhotoFileName == tmpPersons.CustomField))) <> tsok then continue;

      if (getfirst Pers where ((tmpPersons.Nrec == Pers.Nrec))) <> tsok then continue;

      //message(Pers.FIO);
      //message(GP_SCUD_Pers.FIO);


      //Загрузка фото
      if Getfirst Appendix Where  ((  1 == Appendix.ObjBlock
                                and Pers.Nrec == Appendix.Person
                                and 200 == Appendix.ObjType )) <>tsOk
      {
        Clearbuffer(tnAppendix);
        Appendix.ObjBlock:= 1;
        Appendix.Person  := Pers.Nrec;
        Appendix.ObjType := 200;
        Appendix.ABSTRACT:= 'Фотография';
        SetMemoPrefix(tnAppendix,UpCase(sPhotoExt));
        if (Insert current Appendix = tsOk)
        {
          if ImportFileToMemo(Appendix.CONTENTS, sPhotoFile, false)
          {
            Update current Appendix;
          }
          else
          {
            if Delete current Appendix = tsOk {}
          }
        }
      }
      else
      //if wReWrite =1
      {
        ClearMemoField(Appendix.CONTENTS);
        SetMemoPrefix(tnAppendix,UpCase(sPhotoExt));
        if ImportFileToMemo(Appendix.CONTENTS, sPhotoFile, false)
        {
          Update current Appendix;
        }
      }

      //GP_SCUD_Pers.LPHOTO
      ClearMemoField(GP_SCUD_Pers.LPHOTO);
      SetMemoPrefix(tnGP_SCUD_Pers,UpCase(sPhotoExt));
      if ImportFileToMemo(GP_SCUD_Pers.LPHOTO, sPhotoFile, false)
      {
        Update current GP_SCUD_Pers;
      }

    }
    while (FindNextFileCli(sPhotoFile) = true);
  }

end;


Window wHumansList 'Список сотрудников', EscClose;

Browse brHumansList;
Table tmpPersons;
Fields
  tmpPersons.Nrec          'Nrec' ('Nrec',,sci1378Esc) : [15], Protect, NoPickButton;
  tmpPersons.CustomField   'КастомПоле' ('КастомПоле',,sci1378Esc) : [15], Protect, NoPickButton;
end;

end;

Screen scrOne;
Show at (1,1,55,7);
Fields
  nm_dir : noProtect, PickButton;
Buttons
  cmOk      ,,, 'Начать загрузку' ,, ;
  cmCancel  ,,, 'Выход'           ,, ;
  cmValue777,,, 'Посмотреть'      ,, ;
<<

      Путь к фото:
      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@


      <.  Поехали!  .>          <.  Отмена  .>
      <.   Челики   .>
>>
end;

HandleEvent
cmInit:
{
  nm_dir := 'C:\NII\Фото НИИмаш 448 чел';
}
cmPick:
{
  case CurField of
  #nm_dir:
  {
    var str : string = '';
    str := GetDirName('Выберите папку с фото');
    if (str != '')
      nm_dir := str;
    ReReadRecord();
  }
  end;
}
cmOk:
{
  StartNewVisual(vtNumericVisual, vfTimer, 'Импорт фото...', 0);

  LoadPhotos();

  StopVisual();
}
cmValue777:
{
  RunWindow(wHumansList);
}
end;


End.
