#include marker.vih // описание объекта и объявление интерфейса
                    // marker c реализацией по умолчанию
#include GP_Protector.Vih
#include GP_UserAccessService.vih
#include GP_StatusAccessEdit.vih

#include GP_SCUD_Function.Vih
#doc
СКУД Функции
#end
Interface GP_SCUD_Function 'СКУД Функцмм' , EscClose;
  //----------------------------------------------------------------------------
  #doc
     Преобразование time в double
  #end
  Function GetDoubleFromTime(w:time):double;
  { Result:=Hour(w)+Minute(w)/60+Second(w)/3600;

  }
  //------------------------------------
  // Время из числа
  //------------------------------------
  Function GetTimeFromDouble(w:double):time;
  { //            HH              MM
    //Result:=Time(word(trunc(w,0)), word((w-trunc(w,0))*60) ,0,0 );
    Result:=ZeroTime;
    if w<=0 exit;
    var hh:word=word(trunc(w,0));
    var mm:word=word((w-hh)*60);
    //if hh>90 then exit;
    if mm>=60
    { hh++;
      mm:=mm-60;
    }
    Result:=Time(hh, mm ,0,0 );

  } //Function GetTimeFromDouble(w:double):time;

  //------------------------------------
  //Преобразование double в строку с минутами
  //------------------------------------
  Function GetTimeStrFromDouble(w:double):string;
  { Result:=string(longint(trunc(w,0)));
    if w<0 w:=-w;
    var _wMin:word;
    _wMin:=word((w-trunc(w,0))*60);
    if _wMin>=60
    { Result:=string(Round(w,0),0,0);
    }
    else
    if _wMin>0 //0.01
    { Result:=Result+':'+LpadCh(String(_wMin),'0',2);
    }
  } //Function GetTimeStrFromDouble(w:double):string;
end.
