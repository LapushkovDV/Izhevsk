#ifndef __GP_SCUD_EventsEdit_Vih__
#define __GP_SCUD_EventsEdit_Vih__

//------------------------------------------------------------------------------
#include GP_SCUD_BASE.Vih
#component "GP_Staff"
//------------------------------------------------------------------------------
//Type TGP_SCUD_SALDO = type$GP_SCUD_SALDO;
Type TGP_SCUD_SALDO = record as table GP_SCUD_SALDO;
//------------------------------------------------------------------------------
// Дополнительная структура для расчета сальдо/поденной информации
Type TGP_SCUD_S_D = record
   Calc_Days2     :array [1..31] of string; // дни по событию
   CH_FactCh_Excl :array [1..31] of double; // часы по исключениям
end;


//------------------------------------------------------------------------------
Type TGRAFF_WorkPeriod = record
  // из графика
  StartWorkDay : array[1..31] of time  ;// "Начало рабочего дня",
  EndWorkDay   : array[1..31] of time  ;// "Окончание рабочего дня",
  StartShift2  : array[1..31] of time  ;// "Начало смены 2",
  EndShift2    : array[1..31] of time  ;// "Окончание смены 2",
  StartBreak1  : array[1..31] of time  ;// "Начало перерыва 1",
  EndBreak1    : array[1..31] of time  ;// "Окончание перерыва 1",
  StartBreak2  : array[1..31] of time  ;// "Начало перерыва 2",
  EndBreak2    : array[1..31] of time  ;// "Окончание перерыва 2",
  StartWorkDayR: array[1..31] of time  ;// "Начало рабочего дня",
  EndWorkDayR  : array[1..31] of time  ;// "Окончание рабочего дня",
  RestDayOfHoliday: array[1..31] of time;//Отгул за работу в выходной день по 91 приказу (уточнение с уо= "ОТГ")

end;
//------------------------------------------------------------------------------
type TSC_Event_Day =record
 //текущее событие
   DT_Ev  : date;
   TM_Ev  : time;
   Type_Ev: word;
 //предыдущее событие
   DT_Ev_P  : date;
   TM_Ev_P  : time;
   Type_Ev_P: word;
 //следующее событие
   DT_Ev_N  : date;
   TM_Ev_N  : time;
   Type_Ev_N: word;
  //нарушение
   MisConDuct:string;
   Status    :string;
   //---
   Nrec      :comp;
end;//TSC_Event_Day

#doc
 Временная для нарушений
#end
Table Struct Tmp_Scud_MisConDuct
(  cMisConDuct: comp
 , wMisConDuct: word
 , cGP_SCUD_PERS:comp
 , MesN  :word
 , YearN :word
 , DT_Ev  : date
 , TM_Ev  : time
 ,  tDiff : time // длительность нарушения
)
with index
( Tmp_MisConDuct01 = cGP_SCUD_PERS + DT_Ev + TM_Ev
 ,Tmp_MisConDuct02 = cGP_SCUD_PERS + YearN+ MesN +DT_Ev + TM_Ev
);

//------------------------------------------------------------------------------
#doc
Скуд - события
#end

//------------------------------------------------------------------------------
VipInterface GP_SCUD_EventsEdit(GP_SCUD_Base) //, oU_XLT_Report
#Licensed_Free
Parameters (
  wIntMode  : word;   // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  cRec      : comp;   // ссылка на "Учебный план"
  Marker    : longint    // выбранная запись
);
Public:
  Constructor Init;
  Destructor  Done;
  Function  oGP_SCUD_Base.GetTypeDoc:word;
  Function  oGP_SCUD_Base.GetStatusDoc:Comp;
  Procedure oGP_SCUD_Base.LoadInterface(_boVisibleRun:boolean);
  Procedure oGP_SCUD_Base.SetEditMode(Value: boolean);
  Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _cNrec     : comp;  // ссылка на "Ведомость"
  _cGP_SCUD_Pers  : comp;   // выбранная запись
  _cKatpodr  : comp;   // выбранная запись
  _cKatOrg   : longint; // включить определенные форматы
  _DTB       : Date; //период просмотра
  _DTE       : Date; //период просмотра
  _NoVisual  : boolean=false; //не перерисовывать экраны
  _pGP_SCUD_DOC_SP_O:comp=0
  ) : boolean;
  //----------------------------------------------------------------------------
  #doc
     Найти режим
  #end
  Function GetRejimDay(_pScud_Persons:comp; _DT:date):word;
  //----------------------------------------
  #doc
   найти начало и окончание  рабочего дня
  #end
  Function GetDayPeriod(_pScud_Persons:comp; _DT:date
       ;var _StartTime:time
       ;var _EndTime  :time):word;

  //----------------------------------------------------------------------------
  #doc
     Получить первое событие
  #end
  Function GetFirstEvents(var pTSC_Event_Day:TSC_Event_Day):boolean;

  //----------------------------------------------------------------------------
  #doc
     Получить следующее событие
  #end
  Function GetNextEvents(var pTSC_Event_Day:TSC_Event_Day):boolean;

  //--------------------------------------
  #doc
  Найти ЗГД
  <p>_wType
  <p> 0 - код + наименование katpodr.kod +','+katpodr.name
  <p> 1 - код katpodr.kod
  <p> 2 - наименование katpodr.name
  <p> 3 - katpodr.nrec
  #end
  Function FindZGD(_PKatPodr:comp; Flag_ZGD:boolean=false; _wType:word=0) :string;

  //----------------------------------------------------------------------------
  // этот блок предназначен для получения информации из CalcAll
  //----------------------------------------------------------------------------
  #doc
     Рассчитать все дни по человек
     _wTypeRas=0 - считается, что все время проведено по приказам - по умолчанию
     _wTypeRas=1 - c учетом утвержденных приказов
     _wTypeRas=2 - c таблицы сальдо - проект
     _wTypeRas=3 - c таблицы сальдо - проект + заполнение плана
     _wTypeRas=4 - c таблицы сальдо - проект + заполнение плана - за день
  #end
  Function CalcAll(_cScud_Pers:comp //GP_SCUD_PERS.Nrec
    ;_wYearRas,_wMonthRas:word //Год , месяц расчета
    ;_wTypeRas:word=0 //0 при расчета считаются , что на все свкрхурочные есть приказ
                      //1 учитываются только проведенные приказы, если задан _DayCalc - то это вызов из приказа, и за этот день не учитываются
    ;_boReCalc:boolean=true // true - с перерасчетом
    ;_DayCalc:word=0 //при расчете для приказов указать день
    ) :boolean;

  //----------------------------------------------------------------------------
  #doc
    Заполнить информацию о графике работы
  #end
  function Fill_Graff_info(_cScud_Pers:comp //GP_SCUD_PERS.Nrec
    ;_wYearRas,_wMonthRas:word //Год , месяц расчета
    ;_wTypeFill:word=1//из CalcAll
    ;_DayCalc:word=0// День заполнения
     ) :boolean;

  //----------------------------------------------------------------------------
  #doc
     получить все рассчитанное
  #end
  Function GetCalc_Buffer    :TGP_SCUD_Saldo;

  //----------------------------------------------------------------------------
  #doc
     получить рабочие периоды
  #end
  Function GetCalc_WorkPeriod:TGRAFF_WorkPeriod;

  //----------------------------------------------------------------------------
  #doc
     получить сумму дня
  #end
  Function GetCalc_Days(wDay:word) :string;

  //----------------------------------------------------------------------------
  #doc
     получить часы по графику
  #end
  Function GetCalc_CH_Graf:double;
  Function GetCalc_CH_Graf_Day(_day:word):double;  //часы по факту - время
  //----------------------------------------------------------------------------
  #doc
     часы по факту - время
  #end
  Function GetCalc_CH_Fact:double;  //часы по факту - время
  Function GetCalc_CH_Fact_Day(_day:word):double;  //часы по факту - время
  //----------------------------------------------------------------------------
  #doc
     режим работы в день
  #end
  Function GetCalc_Rejim_Day(_Day:word):double;  //часы по факту - сверхурочные

  //----------------------------------------------------------------------------
  #doc
     время начала рабочего дня
  #end
  Function GetCalc_TMB_Day(_Day:word):time;  //часы по факту - сверхурочные
  //----------------------------------------------------------------------------
  #doc
     время окончания рабочего дня
  #end
  Function GetCalc_TME_Day(_Day:word):time;  //часы по факту - сверхурочные

  //----------------------------------------------------------------------------
  #doc
     часы по факту - сверхурочные
  #end
  Function GetCalc_CH_Over:double;  //часы по факту - сверхурочные
  Function GetCalc_CH_OverY:double;  //часы по факту - сверхурочные
  Function GetCalc_CH_Over_Day(_Day:word):double;  //часы по факту - сверхурочные
  //----------------------------------------------------------------------------
  #doc
     часы по факту - переработка
  #end
  Function GetCalc_CH_Over2:double;  //часы по факту - переработка
  Function GetCalc_CH_Over2Y:double;  //часы по факту - переработка
  Function GetCalc_CH_Over2_Day(_Day:word):double;  //часы по факту - переработка
  //----------------------------------------------------------------------------
  #doc
     часы по факту - выходные
  #end
  Function GetCalc_CH_Holiday:double;  //часы по факту - выходные
  Function GetCalc_CH_HolidayY:double;  //часы по факту - выходные
  Function GetCalc_CH_Holiday_Day(_Day:word):double;  //часы по факту - выходные
  //----------------------------------------------------------------------------
  #doc
     Дополнительные данные из расчетных массивов
  #end
  Function GetExtData(_DataType, wDay:word ):double;  //Дополнительные данные из расчетных массивов
  //----------------------------------------------------------------------------
  #doc
     Режим работы по графику Строка 
  #end
  Function GetRejim(wDay:word; _Shift:word=0 ):string;  //Режим работы по графику Строка
  //----------------------------------------------------------------------------
  #doc
     Преобразование time в double
  #end
  Function GetDoubleFromTime(w:time):double;
  //----------------------------------------------------------------------------
  #doc
     Преобразование double в time
  #end
  Function GetTimeFromDouble(w:double):time;
  //----------------------------------------------------------------------------
  #doc
     Преобразование double в строку с минутами
  #end
  Function GetTimeStrFromDouble(w:double):string;

  //----------------------------------------------------------------------------
  #doc
     Вызывать после CalcAll
     Если была вторая смена найти за день _wDay
     _tShift1End   - время выхода с первой смены
     _tShift2Start - время входа на вторую смену
     _Graf2        - продолжительность второй смены
  #end
  Function FindMidleExit(_wDay:word; var _tShift1End:time; var _tShift2Start:time; var _Graf2:Time):Boolean;
End;

//-------------------------------
#component "GP_Staff"

VipInterface GP_SCUD_Ev_IN(GP_SCUD_EventsEdit)
#Licensed_Free
;
//-------------------------------

#endif//__GP_SCUD_EventsEdit_Vih__
