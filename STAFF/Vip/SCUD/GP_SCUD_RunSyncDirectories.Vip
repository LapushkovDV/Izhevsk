#include 'GP_SCUD_PersEdit.Vih'

#doc
  Запуск синхронизации справочников сотрудников - основного и СКУД
#end

Interface GP_SCUD_RunSyncDirectories 'Синхронизация справочников сотрудников - основного и СКУД', EscClose;

const
  cmValue666 = 666;
end;

var
  iGP_SCUD_PersEdit : GP_SCUD_PersEdit;

Screen scOne;
<<
>>
End;

HandleEvent
cmInit:
{
  PutHotCommand(cmValue666);
}
cmValue666:
{
  iGP_SCUD_PersEdit.SyncAllPers();
  LogStrToFile('\out\GP_SCUD_RunSyncDirectories.log', DateToStr(cur_date,'YYYY-MM-DD') + ' ' + TimeToStr(cur_time,'HH:MM:SS') + ' ' + 'Синхронизация справочников сотрудников(основного и СКУД) выполнена.');
  CloseInterface(cmDone);
}
End;

End.
