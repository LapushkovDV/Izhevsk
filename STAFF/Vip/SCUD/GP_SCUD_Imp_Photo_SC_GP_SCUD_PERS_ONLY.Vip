VipInterface GP_SCUD_Imp_Photo_SC_GP_SCUD_PERS_ONLY Licensed(free)
            Parameters(wAuto:word;  nm_dir:string; wReWrite:word);
#doc
Загрузка фотографий citizenid_fio.jpg - только таблица GP_SCUD_PERS(внешние подрядчики)
#end
Interface GP_SCUD_Imp_Photo_SC_GP_SCUD_PERS_ONLY 'Импорт фотографий' , EscClose;
var
  wAuto:word;
  nm_dir:string;
  wReWrite:word;
Create view as select GP_SCUD_Pers.Nrec
from
  GP_SCUD_Pers
;
Parameters  wAuto,nm_dir,wReWrite;

File f_in;

Procedure FormDoc;
var sDir : String;
    sFilePhoto : String;
    sExtPhoto : String;
    nppstr:longint;
    sID:string;
{
  sExtPhoto:='jpg';
  sDir:=nm_dir+'\*.'+sExtPhoto;
  sFilePhoto:='';
  nppstr:=0;
  if FindFirstFileCli(sDir,sFilePhoto) //Возвращает имя файла с путем!!!
  {
    do
    {
      nextvisual;
      nppstr++;

      if not fileexist(sFilePhoto)
      {
        continue;
      }
      //----------------------
      var ww_size:longint;
      f_in.OpenFile(sFilePhoto,stOpenRead);
      ww_size:=f_in.GetSiZe;
      f_in.close;
      if ww_size<1000 then continue;
      //---------------------
      sID:=Replace(Locase(Replace(sFilePhoto,nm_dir+'\','')),'.'+sExtPhoto,''); //Только имя файла без расширения
      timelog('SID='+sID);
      if getfirst GP_SCUD_Pers where (( sID == GP_SCUD_Pers.Ext_KEY )) <>tsok then continue;
      timelog('  импорт');

      //GP_SCUD_Pers.LPHOTO
      ClearMemoField(GP_SCUD_Pers.LPHOTO);
      SetMemoPrefix(tnGP_SCUD_Pers,UpCase(sExtPhoto));
      if ImportFileToMemo(GP_SCUD_Pers.LPHOTO, sFilePhoto, false)
      {
        Update current GP_SCUD_Pers;
      }
    }
    while FindNextFileCli(sFilePhoto); //Возвращает имя файла с путем!!!
  }
  else
  {
    if wAuto=0
    message('Не нашли фотографий');
  }
  DoneFileFinderCli; // уничтожаем объект поиска файлов
} //Procedure FormDoc;

//===============================================================
#doc
 Окно с паузой. Во избежания вылета галактики при автозапуске нужно сделать паузу
 Падает NowRun
#end
window wnPause 'Пауза'; show at (,,10,5);
 screen scrMain;
 <<
    Пауза
 >>
 end;
End;

Screen scrParam;
Fields
  nm_dir   :NoProtect, PickButton;
  wReWrite :NoProtect;
Buttons
  cmOk    ,,, 'Установить фильтр', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;

<<
Выберите каталог  c фотографиями CitizenID_Fio.Jpg
   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 [:] Не проверять наличие`
 <. Продолжить .>  <.   Отмена   .>
>>
end;


HandleEvent
  cmInit:
  {
    timelog_init;
    if wAuto=1
    {
      PutCommand(cmOk);
      RunWindow(wnPause);
      StartTimer(cmValue2,2,False);
    }
    else
    {
      nm_dir:='';
      if not ReadMyDsk(nm_dir,'GP_SCUD_Imp_Photo_nm_dir',False)
        nm_dir:='d:\Galaxy\RedMine\_Photo' ;
    }
  }
  cmValue2:
  {
    StopTimer(cmValue2);
    closeinterface(cmDone) ;
  }
  cmOk:
  {
    SaveMyDsk(nm_dir,'GP_SCUD_Imp_Photo_nm_dir');

    StartNewVisual(vtNumericVisual, vfTimer, 'Ждите, идет импорт данных', 0);
    FormDoc;
    StopVisual('',0);
  }
  cmPick:
  {
    case CurField of
    #nm_Dir:
    {
      var ww_str:string=GetDirName('Выберите каталог  c фотографиями ');
      if ww_str<>'' set nm_dir:=ww_str;
    }
    end;
  }
  end;

end.
