//******************************************************************************
// HandleEvent таблиц
//******************************************************************************


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
HandleEvent
cmInit:
{ LoadInterFace(true)
}
cmOnVipLoad:
{ LoadInterFace(False)
}
cmDone:
{ UnLoadInterFace(true)
}
cmOnVipUnLoad:
{ UnLoadInterFace(False)
}
cmOpenSearch :
{ isOpenSearch:= true;
  if boWinEdit
  { ProcessCommand(cmPick);
  }
  isOpenSearch:= false;
}
end;
end.
