#ifndef __GP_SCUD_Order__
#define __GP_SCUD_Order__
#include GP_SCUD_Base.Vih

#component "GP_STAFF"
Table Struct tmp_scud_order_new
( Podr_Code :string[30]
 ,PodrName  :string[200]
 ,cPodr:comp
 ,cGP_SCUD_PERS :comp
 ,Fio :string[50]
 ,EventDate :date
 ,EventTMB  :time
 ,EventTME  :time
 ,Diff      :double
 ,wType     :word
)
with index
( tmp_scud_order_new01 = Podr_Code + Fio+EventDate+EventTMB
)
;

#doc
СКУД Заявление на отсутствие
#end

vipinterface GP_SCUD_Order(GP_SCUD_BASE) Parameters
   (wIntMode:word
    ;wTypeDoc_Main:word
    ;cRec:comp
    ;Marker:longint
    )
  Licensed(free);
Public:
  Constructor Init;
  Constructor InitType(_wTypeDoc:word);
  Destructor  Done;

  Function  oGP_SCUD_Base.GetStatusDoc:Comp;
  Function  oGP_SCUD_Base.GetTypeDoc:word;
  Procedure oGP_SCUD_Base.LoadInterface(_boVisibleRun:boolean);
  //-------------------------------------
  #doc
  выполнить проверку перед изменением статуса
  #end
  Function oGP_SCUD_Base.Check_Status_Change_Before(_pStatus:comp):boolean;
  //-------------------------------------
  #doc
  выполнить проверку после изменения статуса
  #end
  Function oGP_SCUD_Base.Check_Status_Change_After(_pStatus:comp;_pStatusTo:comp):boolean;

  //-------------------------------------
  #doc
  установить параметры полей
  #end
  Function oGP_SCUD_Base.SetDocFieldsState: boolean;

  //============================================
  // сразу и вернем период, который не исключен из нарушения.
  // если есть исключение, то result=true, если  нет - false
  // также будем обновлять окно при необходимости
  //============================================
  Function  GetFirstPeriodWithOutMisConDuct(_pScud_Pers:comp; DT_B:date;DT_E:date;
            var _DT:date; var TM_B:time; var TM_E:time
              ;var _need_calc:word
              ;var _wOpl     :word
              ;boVisual:boolean=false
              ;All_Stat:word=0
              ;_wTypeDoc:word=0
              ;_wTypeDoc2:word=0
              ;_wTypeDoc3:word=0
              ) :boolean;
  Function  GetNextPeriodWithOutMisConDuct(var _DT:date;var TM_B:time; var TM_E:time
    ;var _need_calc:word
    ;var _wOpl     :word
  ) :boolean;
  //-------------------------------------
  #doc
   Установить позицию
  #end
  Function oGP_SCUD_Base.SetDocPosition(_wTypeDoc:word;_cDoc:comp;_cDocSp:comp):boolean;
  //-------------------------------------
  #doc
   Найти подписанта, выполнять с 1,2 и т.д до тех пор пока не вернет 0
  #end
  Function GetPodpisPers(_num:word):comp;
  //-------------------------------------
  #doc
  спозиционироваться на объект
  #end
  Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _cGP_SCUD_DOC_SP : comp;  // ссылка на "Ведомость"
  _cGP_SCUD_DOC : comp;   // выбранная запись
  _cKatpodr  : comp;   // выбранная запись
  _cKatOrg   : longint; // включить определенные форматы
  _DTB       : Date; //период просмотра
  _DTE       : Date; //период просмотра
  _NoVisual  : boolean=false //не перерисовывать экраны
  ) : boolean;

  //-------------------------------------
  #doc
  Формирование приказа, для начала набиваем таблицу tmp_scud_order_new
  #end
  Function MakeOrder:boolean;
end;
#end //GP_SCUD_Order
