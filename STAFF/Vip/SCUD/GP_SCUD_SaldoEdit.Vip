Function GetPersTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  0: Result:='сотрудники предприятия ';
  1: Result:='внешние подрядчики';
  2: Result:='прочие';
  end;
} //Function GetPersTypeName(_wType:word)   :string;cacheable;




Function GetKatPodrByName(ww_str:string):comp;
{ //'Подрядчики'
  Result:=0;
  if getfirst katpodr_flt where ((ww_str == katpodr_flt.name  ))=tsok
  { Result:=katpodr_flt.nrec;
  }
} //Function GetKatPodrByName(ww_str:string):comp;

