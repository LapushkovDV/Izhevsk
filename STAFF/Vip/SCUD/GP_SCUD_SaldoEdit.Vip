//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{  inherited ::LoadInterface(_boVisibleRun);
   ReadParam;
   NPOEM_OWN_SCUD_Pers_Other :=boGetTune('NPOEM_OWN.SCUD.Pers_Other');//'Отображать сторонних лиц
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { LoadProtector;
        DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_SaldoEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;

      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
   isFilterRun:=false;
  NPOEM_OWN_SCUD_SALDO_LOCK :=dGetTune('NPOEM_OWN.SCUD.SALDO_LOCK');//Дата блокировки перерасчета начального сальдо
} //Procedure LoadInterface(_wRunType:word);


//---------------------------------------------
// получить наименование
//---------------------------------------------
Function GetPodrOrgName(_pNrec:comp):string;
{ #__UNUSED__(_pNrec)
  Result:='';
  if GP_SCUD_Pers.wType=0
  { if isValid(#KatPodr)
      Result:=Katpodr.Kod+','+Katpodr.name;
  }
  else
  { if isValid(#KatOrg)
      Result:=KatOrg.name;
  }
} //Function GetPodrOrgName(_pNrec:comp):string;


Function GetDaysFromSum(w:double):longint;
{ Result:=longint(w) div 10000;
}
Function GetHourFromSum(w:double):double;
{ Result:=w-GetDaysFromSum(w)*10000;

}

//---------------------------
// Получить сальдо на конец месяца
//---------------------------
Function GetSaldo(_cGP_SCUD_Pers:comp; _YearN:word; _MesN:word;_PrevMes:boolean;
  var _Over:tSumma;var _Over2:tSumma;var _Holiday:tSumma
  ;var _Over_Opl:tSumma;var _Over2_Opl:tSumma;var _Holiday_Opl:tSumma
  ;_boIns:boolean=true):boolean;
{ Result:=false;
  _Over:=_Over2:=_Holiday:=0;
  _Over_Opl:=_Over2_Opl:=_Holiday_Opl:=0;
  if NPOEM_OWN_SCUD_SALDO_LOCK<>ZeroDate
  { if _PrevMes
    { if date(1,_MesN,_YearN)<=NPOEM_OWN_SCUD_SALDO_LOCK
        _PrevMes:=false;
    }
  } //if NPOEM_OWN_SCUD_SALDO_LOCK<>ZeroDate

  if _PrevMes
  { _MesN:=_MesN-1;
    if _MesN=0
    { _MesN:=12;
      _YearN:=_YearN-1
    }
  } //if _PrevMes

  if timelog_status>0
  { timelog('GP_SCUD_SALDOEDIT->GetSaldo:YearN='+string(_YearN)+', MesN='+string(_MesN)+', PrevMes='+string(_PrevMes));
  }
  if vOst.pGP_SCUD_Pers<>_cGP_SCUD_Pers
  or vOst.wYearN       <>_YearN
  or vOst.wMesN        <>_MesN
  { vOst.pGP_SCUD_Pers:=_cGP_SCUD_Pers;
    vOst.wYearN       :=_YearN;
    vOst.wMesN        :=_MesN;
  }
  if vOst.getfirst GP_SCUD_SALDO <>tsok
  { if not _boIns exit;
    // Не нашли
    if timelog_status>0
    { timelog('GP_SCUD_SALDOEDIT->GetSaldo:Не нашли');
    }
    //найдем сальдо за предыдущий месяц
    GetSaldo(_cGP_SCUD_Pers,_YearN,_MesN,True
    ,_Over,_Over2,_Holiday
    ,_Over_Opl,_Over2_Opl,_Holiday_Opl
    ,false);
    vOst.wYearN       :=_YearN;
    vOst.wMesN        :=_MesN;
    vOst.pGP_SCUD_Pers:=_cGP_SCUD_Pers;
    if vOst.getfirst GP_SCUD_Pers <>tsok  exit;
    if vOst.GP_SCUD_Pers.wType<>0 then exit;
    if vOst.getfirst Persons<>tsok exit;
    if year(vOst.Persons.AppDate)>_YearN then exit;
    if year(vOst.Persons.AppDate)=_YearN and Month(vOst.Persons.AppDate)>_MesN then exit;
    vOst.ClearBuffer(vOst.tnGP_SCUD_SALDO);
    vOst.GP_SCUD_SALDO.cGP_SCUD_Pers:=_cGP_SCUD_Pers;
    vOst.GP_SCUD_SALDO.YearN :=_YearN;
    vOst.GP_SCUD_SALDO.MesN :=_MesN;
    vOst.GP_SCUD_SALDO.cPersons:=vOst.GP_SCUD_Pers.cPersons;
    vOst.GP_SCUD_Saldo.CH_Over_Ost   :=_Over    ;
    vOst.GP_SCUD_Saldo.CH_Over2_Ost  :=_Over2   ;
    vOst.GP_SCUD_Saldo.CH_Holiday_Ost:=_Holiday ;
    Result:=vOst.insert current GP_SCUD_SALDO=tsok;
    if not Result exit;
  }
  else Result:=true;
  if _PrevMes
  { _Over   := vOst.GP_SCUD_Saldo.CH_Over_Ost   +vOst.GP_SCUD_Saldo.CH_Over_Cur
              -vOst.GP_SCUD_Saldo.CH_Over_Opl;
    _Over2  := vOst.GP_SCUD_Saldo.CH_Over2_Ost  +vOst.GP_SCUD_Saldo.CH_Over2_Cur
              -vOst.GP_SCUD_Saldo.CH_Over2_Opl;
    _Holiday:= vOst.GP_SCUD_Saldo.CH_Holiday_Ost+vOst.GP_SCUD_Saldo.CH_Holiday_Cur
              -vOst.GP_SCUD_Saldo.CH_Holiday_Opl;
  }
  else
  { _Over   := vOst.GP_SCUD_Saldo.CH_Over_Ost;
    _Over2  := vOst.GP_SCUD_Saldo.CH_Over2_Ost;
    _Holiday:= vOst.GP_SCUD_Saldo.CH_Holiday_Ost;
    _Over_Opl   := vOst.GP_SCUD_Saldo.CH_Over_Opl;
    _Over2_Opl  := vOst.GP_SCUD_Saldo.CH_Over2_Opl;
    _Holiday_Opl:= vOst.GP_SCUD_Saldo.CH_Holiday_Opl;
  }
  timelog('_Over ='+string(_Over,0,2)
         +', _Over2='+string(_Over2,0,2)
         +', _Holiday='+string(_Holiday,0,2)
         +', _Over2_Cur='+string(vOst.GP_SCUD_Saldo.CH_Over2_Cur,0,2)
         +', _Over2_Opl='+string(vOst.GP_SCUD_Saldo.CH_Over2_Opl,0,2)
         +', Result:='+string(Result)
       );
} //Function GetSaldo(_cGP_SCUD_Pers:comp; _YearN:word; _MesN:word;_PrevMes:boolean

Function GetSaldoBuf(_cGP_SCUD_Pers:comp; _YearN:word; _MesN:word;_PrevMes:boolean;
                var  buf:Type$GP_SCUD_SALDO; _boIns:boolean=true):boolean;
var
  _Over:tSumma;_Over2:tSumma; _Holiday:tSumma;
  _Over_Opl:tSumma;_Over2_Opl:tSumma;_Holiday_Opl:tSumma;
{ _Over:=_Over2:=_Holiday:=0;
  _Over_Opl:=_Over2_Opl:=_Holiday_Opl:=0;
  Result:=GetSaldo(_cGP_SCUD_Pers,_YearN,_MesN,_PrevMes
  ,_Over,_Over2,_Holiday
  ,_Over_Opl,_Over2_Opl,_Holiday_Opl
  ,_boIns);
  ClearAdvRecord(buf);
  if Result Buf:=Type$GP_SCUD_SALDO(vOst.GP_SCUD_SALDO.Buffer);

}
Function SetSaldoBuf(buf:Type$GP_SCUD_SALDO):boolean;
{ vOst.GP_SCUD_SALDO.Buffer:=buf;
  timelog('SetSaldoBuf');
  Result:=vOst.update current GP_SCUD_SALDO=tsok;

}

//-----------------------------------
//
//-----------------------------------
Function Calc_Saldo:boolean;
var
  _wYearRas ,_wMesRas:word;
  _wYearRasE,_wMesRasE:word;
  _DEND,_DEND1  :date;
  isAllOk:boolean;
{ Result:=false;
  UpdateTable;
  StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Ждите, идет пересчет сальдо',0);
  PushPos(#GP_SCUD_Saldo);
  _wYearRasE:=Year(Cur_Date);
  _wMesRasE :=month(Cur_Date);
  _DEND:=Date(1,_wMesRasE,_wYearRasE);
  //_Loop fullcache GP_SCUD_Saldo where (( wYearRas == GP_SCUD_Saldo.YearN
  //    and wMesRas == GP_SCUD_Saldo.MesN ))
  isAllOk:=true;
  _Loop fullcache GP_SCUD_Pers
  { if not iNextVisual('Расчет '+GP_SCUD_Pers.Fio) then break;
    _DEND1:=_DEND;
    if getlast GP_SCUD_Saldo=tsok
    { _DEND1:=Date(1,GP_SCUD_Saldo.MesN,GP_SCUD_Saldo.YearN);
      if _DEND1<_DEND _DEND1:=_DEND;
    }
    _wYearRas :=wYearRas;
    _wMesRas  :=wMesRas;
    do {

      if not iGP_SCUD_EventsEdit.CalcAll(GP_SCUD_PERS.Nrec,_wYearRas,_wMesRas //Год , месяц расчета
      ,1    //0 при расчета считаются , что на все сверхурочные есть приказ
            //1 учитываются только проведенные приказы, если задан _DayCalc - то это вызов из приказа, и за этот день не учитываются
      ,true // true - с перерасчетом
      ,0 //DayCalc:word =0//при расчете для приказов указать день
      )
      { message('Ошибка расчета для '+GP_SCUD_PERS.Fio);
        break;
      }
      _wMesRas++;
      if _wMesRas>12
      { _wMesRas:=1;
        _wYearRas++;
      }
      if not NextVisual
      { isAllOk:=false;
        break;
      }
      //следующий месяц  - просто обновим сальдо  - не, пусть все пересчитывает
      //if date(1,_wMesRas,_wYearRas ) >_DEND   {      }
    } while date(1,_wMesRas,_wYearRas ) <=_DEND1;
    if not isAllOk break;
  } //_Loop fullcache GP_Saldo_Pers
  PopPos(#GP_SCUD_Saldo);
  ReScanPanel(#GP_SCUD_Saldo);
  StopVisual('',0);
  Result:=true;
} //Function Calc_Saldo:boolean;

//========================================================
// Визуальная часть
//========================================================
Window wnGetPeriod 'Задайте параметры пересчета сальдо'  Cyan, EscClose;
  Show at (,,55,15);
Screen scrGetPeriod 'Фильтры' ('Фильтры',,sci13Esc);
Table KatPodr_Flt;
Fields
  wMesRas  :#(Month_List)
  wYearRas :noprotect,spinButton [1, 2017, 2200];
Buttons
  cmValue31, [singleline],,, 'назад', hcAllBOk, scGalDial;
  cmValue32, [singleline],,, 'вперед', hcAllBOk, scGalDial;
  cmOk    ,,, 'продолжить выполнение', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;
<<
 Пересчитать с
 .@@@@@@@@@@ `Месяца`  .@@@@@@@@@ `Года`
           <.<.><.>.>

 <. Продолжить .>  <.   Отмена   .>
>>
end; //Screen scrFilter (,,sci13Esс);
HandleEvent
cmInit:
{ isProtect2:=isProtect;
  if isProtect
  { SetEditMode(True)
  }
  wMesRas  :=MonthRas;
  wYearRas :=YearRas;
}
cmValue31://'назад'
{ wMesRas:=wMesRas-1;
  if wMesRas=0
  { wYearRas:=wYearRas-1;
    wMesRas:=12;
  }
  set wMesRas:=wMesRas;
  set wYearRas :=wYearRas;
}
cmValue32:// 'вперед'
{ wMesRas:=wMesRas+1;
  if wMesRas=13
  { wYearRas:=wYearRas+1;
    wMesRas:=1;
  }
  set wMesRas:=wMesRas;
  set wYearRas :=wYearRas;
}

cmDone:
{ if isProtect2
    SetEditMode(false);
}
cmOk:
{ if wMesRas=0 or wYearRas=0
  { Message('Не задан период для расчета');
    exit;
  }
  if wYearRas>YearRas+1
  { Message('Год не может быть больше расчетного+1');
    Exit;
  }
  if wYearRas<YearRas-2
  { Message('Год не может быть меньше расчетного-2');
    Exit;
  }
  var ww_dt:date;
  ww_dt:=dGetTune('NPOEM_OWN.SCUD.SALDO_LOCK');
  if ww_dt=ZeroDate ww_dt:=dGetTune('UP.DATOTCH');
  //if not (wYearRas>YearRas or (wYearRas>=YearRas and wMesRas>=MonthRas))
  if ww_dt>date(1,wMesRas,wYearRas)
  { message('Нельзя пересчитывать за закрытые периоды!'
     +chr(13)+'Минимальный период:'+DateToStr(ww_dt,'month YYYY')
    );
    exit;
  }
  CloseWindowEx(wnGetPeriod,cmDefault)
}
end;// HandleEvent
end; //Windows wnFilter 'Установите фильтры' , Cyan, EscClose;
