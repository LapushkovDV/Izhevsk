  [Grup]  iGP_SCUD_GrupEdit.GetGrupName (GP_SCUD_Pers.CGP_SCUD_GRUP) ('Группа сотрудников',,sci178Esc): Protect,PickButton ;
  KLREJIM.NRejim                    ('Режим',,sci1378Esc) : Protect,Pickbutton;
  GP_SCUD_Saldo.YearN          ('Год сальдо'  ):[5],Noprotect,noDel;
  GP_SCUD_Saldo.MesN           ('Месяц сальдо'):[5],Noprotect,noDel;
  GP_SCUD_Saldo.CH_Over_Ost    ('Сверхурочные остаток на начало'):[6.2],noprotect,noDel;
  GP_SCUD_Saldo.CH_Over_Cur    ('Сверхурочные тек.месяц'):[6.2],protect,noDel;
  GP_SCUD_Saldo.CH_Over_Opl    ('Сверхурочные, использовано'):[6.2],protect,noDel;
  [Over_End] GP_SCUD_Saldo.CH_Over_Ost+GP_SCUD_Saldo.CH_Over_Cur
          -GP_SCUD_Saldo.CH_Over_Opl :[10.2], Protect;
  GP_SCUD_Saldo.CH_Over2_Ost   ('Переработка остаток на начало'):[6.2],noprotect,noDel;
  GP_SCUD_Saldo.CH_Over2_Cur   ('Переработка тек.мес'):[6.2],protect,noDel;
  GP_SCUD_Saldo.CH_Over2_Opl   ('Переработка оплачено'):[6.2],protect,noDel;
  [Over2_End] GP_SCUD_Saldo.CH_Over2_Ost+GP_SCUD_Saldo.CH_Over2_Cur
          -GP_SCUD_Saldo.CH_Over2_Opl :[10.2], Protect;
  Holiday_Ost_Days ('Выходные остаток на начало'):[6],noprotect,noDel;
  Holiday_Cur_Days ('Выходные тек.мес'):[6],protect,noDel;
  Holiday_Opl_Days ('Выходные оплачено'):[6],protect,noDel;
  Holiday_OstE_Days :[10], Protect;

  Holiday_Ost_Hour ('Выходные остаток на начало'):[6.2],noprotect,noDel;
  Holiday_Cur_Hour ('Выходные тек.мес'):[6.2],protect,noDel;
  Holiday_Opl_Hour ('Выходные оплачено'):[6.2],protect,noDel;
  Holiday_OstE_Hour :[10.2], Protect;


<<
 `ФИО`           .@@@@@@@@@@@@@@@@@@@@@@@@@@ `Таб.Номер/код` .@@@@@@@@@@@@@
 `Подразделение` .@@@@@@@@@@@@@@@@@@@@@@@@@@ `Тип`           .@@@@@@@@@@@@@
 `Организация`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
