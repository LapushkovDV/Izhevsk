Function GetPersName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Pers where
          (( _pNrec == GP_SCUD_Pers.nrec ))<>tsok exit;
  Result:=GP_SCUD_Pers.Fio;
} //Function GetPersName(_pNrec:comp)   :string; cacheable;

