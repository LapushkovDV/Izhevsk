//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Pers;
cmSetDefault:
{ //ClearBuffer(#GP_SCUD_Pers);
  exit;
  abort;
}
cmInsertRecord:
{ exit;

  Insert Current GP_SCUD_Pers;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Pers;
}
cmDeleteRecord:
{ message('Удаление запрещено!');
  //delete Current GP_SCUD_Pers;
  exit;

}
cmPositionChanged:
{ PositionChanged;
}
end; //GP_SCUD_Pers

//GP_SCUD_Saldo.wType
TableEvent table GP_SCUD_Saldo;
cmSetDefault:
{

  ClearBuffer(#GP_SCUD_Saldo);
  GP_SCUD_Saldo.cGP_SCUD_Pers:=GP_SCUD_Pers.Nrec;
  GP_SCUD_Saldo.cPersons:=GP_SCUD_Pers.cPersons;
  var _wMes, _wYear :word;
  _wYear :=YearRas;
  _wMes  :=MonthRas;
  do {
    timelog('GP_SCUD_SALDOEDIT->GP_SCUD_Saldo->cmSetDefault _wYear='+string(_wYear)+','+string(_wMes));
    if vOst.pGP_SCUD_Pers<>GP_SCUD_Pers.Nrec
    or vOst.wYearN       <>_wYear
    or vOst.wMesN        <>_wMes
    { vOst.pGP_SCUD_Pers:=GP_SCUD_Pers.Nrec;
      vOst.wYearN       :=_wYear;
      set vOst.wMesN    :=_wMes;
    }
    if vOst.getlast GP_SCUD_Saldo<>tsok
    { GP_SCUD_Saldo.YearN:=_wYear;
      GP_SCUD_Saldo.MesN :=_wMes;
      timelog('GP_SCUD_SALDOEDIT->GP_SCUD_Saldo->cmSetDefault не нашли ');
      break;
    }
    else
    { _wMes:=_wMes+1 ;
      if _wMes>12
      { _wMes:=1;
        _wYear:=_wYear+1;
      }
    }
  } while True;
  var _Over_Opl,_Over2_Opl,_Holiday_Opl:tSumma;
  _Over_Opl:=_Over2_Opl:=_Holiday_Opl:=0;

  GetSaldo(GP_SCUD_Saldo.cGP_SCUD_Pers,GP_SCUD_Saldo.YearN,GP_SCUD_Saldo.MesN,true
     ,GP_SCUD_Saldo.CH_Over_Ost,GP_SCUD_Saldo.CH_Over2_Ost
     ,GP_SCUD_Saldo.CH_Holiday_Ost
     ,_Over_Opl,_Over2_Opl,_Holiday_Opl
     );
}
cmExprFieldChanged:
{ case CurField of
  #Holiday_Ost_Days: set GP_SCUD_Saldo.CH_Holiday_Ost:=longint(ExprFieldValue)*10000+Holiday_Ost_Hour;
  #Holiday_Ost_Hour: set GP_SCUD_Saldo.CH_Holiday_Ost:=longint(Holiday_Ost_Days)*10000+double(ExprFieldValue);
  end;
}
cmCheckRecord:
{

}
cmInsertRecord:
{ Insert Current GP_SCUD_Saldo;
}
cmUpdateRecord:
{
  Update Current GP_SCUD_Saldo;
}
cmDeleteRecord:
{ //удалять нельзя
  message('Удаление запрещено!');
  //delete Current GP_SCUD_Saldo;
}
cmPositionChanged:
{ //PositionChanged;
}
end; //GP_SCUD_Pers

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if cRec>0
      { if getfirst GP_SCUD_Pers where (( cRec == GP_SCUD_Pers.nrec ))=tsok {}
      }
      ReadParam;
      //Отображать в сальдо часы по работе в выходной
      var _bo_hol_ch:boolean=boGetTune('NPOEM_OWN.SCUD.Saldo_HOL_CH');
      ToggleFieldVisible(#Holiday_Ost_Hour,_bo_hol_ch);
      ToggleFieldVisible(#Holiday_Cur_Hour,_bo_hol_ch);
      ToggleFieldVisible(#Holiday_Opl_Hour,_bo_hol_ch);
      ToggleFieldVisible(#Holiday_OstE_Hour,_bo_hol_ch);
      //-------------------
      SetFilterNm(0);
      SetFilterBounds(0);
      ReScanPanel(#GP_SCUD_Pers);

    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }

    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
      SaveParam;
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Pers.Nrec;
        }
        CloseInterface(cmDefault)
      }
      else Putcommand(cmEdit);
    }
    cmEdit:
    {  if GetCurrentFormat=brScudPers
       or GetCurrentFormat=brPersSaldo
         RunWindow(wnEditPers);
    }
    cmValue1:
    { if not UserAccessService.CanEdit(pStatus_GetDefault)
      { Message('У вас нет прав для запуска расчета сальдо');
        exit;
      }

      if RunWindowModal(wnGetPeriod)=cmDefault
      { Calc_Saldo;
      }
    }
    //----------------------
    cmPick:
    { if IsProtect
      { Abort;
        Exit;
      }
      case CurField of
      #KatPodr.Name:
      { if GP_SCUD_Pers.wType=1
        { message('Запись связана с организацией, изменение запрещено' ) ;
          exit;
        }

        pTmp:= GP_SCUD_Pers.cKatPodr;
        If (iGetKau.GetCodeKau(cgiPick,cgKau_KatPodr,pTmp) <> 0)
        { set GP_SCUD_Pers.cKatPodr:=pTmp;
        }
      }
      #KatOrg.Name:
      { if GP_SCUD_Pers.wType=0
        { message('Запись связана с картотекой сотрудников, изменение запрещено' ) ;
          exit;
        }
        pTmp:= GP_SCUD_Pers.cKatOrg;
        If (iGetKau.GetCodeKau(cgiPick,cgKau_KatOrg,pTmp) <> 0)
        { if GP_SCUD_Pers.cKatpodr=0
          { set GP_SCUD_Pers.cKatPodr:=GetKatPodrByName('Подрядчики');
          }
          set GP_SCUD_Pers.cKatOrg:=pTmp;
        } //If (iGetKau.GetCodeKau(cgiPick,cgKau_KatOrg,pTmp) <> 0)
      } //#KatOrg.Name:
      #Kateg:
      { pTmp:=GP_SCUD_Pers.CGP_SCUD_KATEG;
        if RunInterface(GP_SCUD_KATEGEdit,cgiPick,pTmp,0)<>cmCancel
        { set GP_SCUD_Pers.CGP_SCUD_KATEG:=pTmp
        }
      }
      #Grup:
      { pTmp:=GP_SCUD_Pers.CGP_SCUD_GRUP;
        if RunInterface(GP_SCUD_GRUPEdit,cgiPick,pTmp,0)<>cmCancel
        { set GP_SCUD_Pers.CGP_SCUD_GRUP:=pTmp
        }
      }
      #KLREJIM.NRejim: //'Режим'
      { var wTmp:word;
        wTmp := KLREJIM.Rejim;
        if ( RunInterface('PickRej', wTmp) <> cmCancel )
        if ( getfirst KLREJIM where (( wTmp == KLREJIM.Rejim)) = tsOk )
        { pTmp:= KLREJIM.Nrec;
          set GP_SCUD_Pers.cKlRejim:=KLREJIM.Nrec;
        }
      }
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,1);
        }
      }
      //------------------------------
      #Filtr_KatOrg:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_KatOrg);
        StoreMarker(Marker_KatOrg,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_KatOrg,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_KatOrg,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_KatOrg);
          BitOnW(wFilter,2);
        }
      }
      //------------------------------
      #Filtr_Persons:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_Persons);
        StoreMarker(Marker_Persons,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_Persons,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_Persons,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_Persons);
          BitOnW(wFilter,3);
        }
      }
      end;
      ReScanPanel(#GP_SCUD_PERS);
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,1);
        SetFilterNm(#Filtr_KatPodr);
      }
      //------------------------------
      #Filtr_KatOrg:
      { ClearMarker(Marker_KatOrg);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatOrg);
      }
      //------------------------------
      #Filtr_Persons:
      { ClearMarker(Marker_Persons);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_Persons);
      }
      end;
    }

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Pers: RunInterface('ExClassifier', coGP_SCUD_Pers, GP_SCUD_Pers.nRec);
      end;
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(0);
      }
      else RestFromA
    }
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Pers: RunInterface('Attribute', coGP_SCUD_Pers, GP_SCUD_Pers.nRec);
      end;
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #GP_SCUD_Pers:
      { ProcessCommand(RunMenu('GP_SCUD_SaldoEdit_Main_HotKey'));
      }
      end;
    }
  end;
end.

GP_SCUD_SaldoEdit_Main_HotKey Menu
{
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Внешняя классификация', cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
- 'Внешние атрибуты'     , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;
- 'Пересчитать сальдо'   , cmValue1  , '', hcGkatalM1ExtClass, , , sci1Esc;

}
