Show At (,,120,25);
//------------------------------------
// декларация сложного фильтра
//------------------------------------
function isFilterAnCorrect(ww_nrec:comp): boolean; forward;
//------------------------------------
#include GetKau.var
#include GP_SCUD_GrupEdit.Var
#include GP_SCUD_KategEdit.Var
//--------------------------------------------
var
//-------------------
  iGP_SCUD_EventsEdit      :GP_SCUD_EventsEdit New;
  viCYPersons         : ChoiseYourPersons;
  iCatFunc            : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  pMarker:IMarker(Marker) new;
//----------- для перерасчета сальдо
  wMesRas,wYearRas:word;
//------------ настройка
  NPOEM_OWN_SCUD_SALDO_LOCK :date;//Дата блокировки перерасчета начального сальдо
  NPOEM_OWN_SCUD_Pers_Other :boolean;//'Отображать сторонних лиц

//-----------------------------------------

  cRec    :Comp   ; // ссылка на группу
  Marker:longint;
  //-- пометка подразделения
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
    wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;

   #mrkfld_(KatPodr)
   #mrkfld_(KatOrg)
   #mrkfld_(Persons)


   sPassPorts_Flt,sPassPorts_Flt_A : string;
   sFio_Flt      ,sFio_Flt_A       : string;
   sPropusk_Flt  ,sPropusk_Flt_A   : string;
   wType_Flt     ,wType_Flt_A      : word;
   DTB,DTE:date;
//----------------------------------------
Create View
var
   pPersons :comp;
   pKatPodr :comp;
   pKatOrg  :comp;
   pGP_SCUD_Pers:comp;
as select GP_SCUD_Pers.Nrec
, GetDaysFromSum(GP_SCUD_Saldo.CH_Holiday_Opl) (FieldName=Holiday_Opl_Days)
, GetHourFromSum(GP_SCUD_Saldo.CH_Holiday_Opl) (FieldName=Holiday_Opl_Hour)
, GetDaysFromSum(GP_SCUD_Saldo.CH_Holiday_Ost) (FieldName=Holiday_Ost_Days)
, GetHourFromSum(GP_SCUD_Saldo.CH_Holiday_Ost) (FieldName=Holiday_Ost_Hour)
, GetDaysFromSum(GP_SCUD_Saldo.CH_Holiday_Cur) (FieldName=Holiday_Cur_Days)
, GetHourFromSum(GP_SCUD_Saldo.CH_Holiday_Cur) (FieldName=Holiday_Cur_Hour)
, GetDaysFromSum(GP_SCUD_Saldo.CH_Holiday_Ost+GP_SCUD_Saldo.CH_Holiday_Cur-GP_SCUD_Saldo.CH_Holiday_Opl) (FieldName=Holiday_OstE_Days)
, GetHourFromSum(GP_SCUD_Saldo.CH_Holiday_Ost+GP_SCUD_Saldo.CH_Holiday_Cur-GP_SCUD_Saldo.CH_Holiday_Opl) (FieldName=Holiday_OstE_Hour)

From
  GP_SCUD_Pers(GP_SCUD_PERS02)
//, GP_SCUD_Pers GP_SCUD_Pers_F
, GP_SCUD_Saldo(GP_SCUD_Saldo02)
//, GP_SCUD_Saldo GP_SCUD_Saldo_F(GP_SCUD_Saldo02)
, Persons
//, Persons Persons_F
, KatOrg
, Katpodr
, KLREJIM
//------- фильтры
 , KatPodr    KatPodr_Flt
 , KatOrg     KatOrg_Flt
 , Persons    Persons_Flt

where ((
    GP_SCUD_Pers.cPersons == Persons.Nrec
and GP_SCUD_Pers.cKatPodr == Katpodr.Nrec
and GP_SCUD_Pers.cKatOrg  == KatOrg.Nrec
and GP_SCUD_Pers.CKLREJIM == KLREJIM.NRec
and GP_SCUD_Pers.Nrec     == GP_SCUD_Saldo.cGP_SCUD_Pers
//and GP_SCUD_Pers.Nrec     == GP_SCUD_Saldo_F.cGP_SCUD_Pers
//------- фильтры
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == KatOrg_Flt.Nrec
and wc_nrec == Persons_Flt.Nrec

))
Bounds byPersons pPersons == GP_SCUD_Pers.cPersons(noindex) ordered by TableOrder
Bounds byKatOrg  pKatOrg  == GP_SCUD_Pers.cKatOrg (noindex) ordered by TableOrder
Bounds byKatPodr pKatPodr == GP_SCUD_Pers.cKatPodr(noindex) ordered by TableOrder
Bounds byType    wType_Flt== GP_SCUD_Pers.wType   (noindex) ordered by TableOrder
condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_Pers.Nrec))
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;

create view vOst
var
  pGP_SCUD_SALDO:comp;
  pGP_SCUD_Pers :comp;
  wMesN , wYearN:word;
as select GP_SCUD_SALDO.*
From GP_SCUD_SALDO, GP_SCUD_Pers, Persons
where ((
     pGP_SCUD_Pers == GP_SCUD_SALDO.cGP_SCUD_Pers
  and wYearN       == GP_SCUD_SALDO.YearN
  and wMesN        == GP_SCUD_SALDO.MesN
  and pGP_SCUD_Pers == GP_SCUD_Pers.Nrec
  and GP_SCUD_Pers.cPersons == Persons.Nrec

 ));


