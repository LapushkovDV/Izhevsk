#end
;

File FMemo;


//*************************************************8
QuickChoice qcByCode
{
  AcceptField = GP_SCUD_MisConDuct.Nrec;
  ViewField = GP_SCUD_MisConDuct.Code;
  ViewField = GP_SCUD_MisConDuct.Name;
  // только текстовый поля!
  SearchField = GP_SCUD_MisConDuct.Code;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_MisConDuct.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_MisConDuct.Nrec;
  ViewField = GP_SCUD_MisConDuct.Name;
  ViewField = GP_SCUD_MisConDuct.Code;
  // только текстовый поля!
  SearchField = GP_SCUD_MisConDuct.Name;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_MisConDuct.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName



//-----------------------------------------
// Получить наименование
//-----------------------------------------
Function GetMisConDuctName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_MisConDuct where
          (( _pNrec == GP_SCUD_MisConDuct.nrec ))<>tsok exit;
  Result:=GP_SCUD_MisConDuct.Name;
} //Function GetMisConDuctName(_pNrec:comp)   :string; cacheable;

//-----------------------------------------
// Получить код
//-----------------------------------------
Function GetMisConDuctCode(_pNrec:comp)   :string;cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_MisConDuct where
          (( _pNrec == GP_SCUD_MisConDuct.nrec ))<>tsok exit;
  Result:=GP_SCUD_MisConDuct.Code;
} //Function GetMisConDuctCode(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить тип
//-----------------------------------------
Function GetMisConDuctType(_pNrec:comp)   :word;cacheable;
{ GetMisConDuctType:=0;
  if getfirst fastfirstrow GP_SCUD_MisConDuct where
          (( _pNrec == GP_SCUD_MisConDuct.nrec ))<>tsok exit;
  Result:=GP_SCUD_MisConDuct.wType;

} //Function GetMisConDuctType(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetMisConDuctTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  1: Result:='Опоздание на работу';
  2: Result:='Ранний уход на обед';
  3: Result:='Поздний приход с обеда';
  4: Result:='Ранний уход с работы';
  5: Result:='Отсутствие в середине дня.';
  6: Result:='Прогул';
  end;
} //Function GetMisConDuctTypeName(_wType:word)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetMisConDuctTypeNrec(_wType:word)   :comp;cacheable;
{ Result:=0;
  if getfirst fastfirstrow GP_SCUD_MisConDuct where
          (( _wType == GP_SCUD_MisConDuct.wType ))<>tsok exit;
  Result:=GP_SCUD_MisConDuct.Nrec;
} //Function GetMisConDuctTypeName(_wType:word)   :string;cacheable;

//-----------------------------------------
// Вставить первоначальные значения
//-----------------------------------------
Procedure Ins_GP_SCUD_MisConDuct(_Num:word);
{ ClearBuffer(#GP_SCUD_MisConDuct);
  GP_SCUD_MisConDuct.Code:=LpadCh(string(_Num),'0',3);
  GP_SCUD_MisConDuct.Name:=GetMisConDuctTypeName(_Num);
  GP_SCUD_MisConDuct.wType:=_Num;
  if not FMemo.OpenMemo(GP_SCUD_MisConDuct.CONTENTS) then Exit;
  FMemo.Seek(0);
  FMemo.Truncate;

  case _Num of
  1://Опоздание на работу.
  { GP_SCUD_MisConDuct.Description:='Первый вход по времени позднее 1 минуты после начала работы по графику. Вход считается первым, если предшествующий ему выход был более чем за час до начала работы по графику.';
    FMemo.WriteLn('Первый вход по времени позднее 1 минуты');
    FMemo.WriteLn('после начала работы по графику.');
    FMemo.WriteLn('Вход считается первым, если предшествующий');
    FMemo.WriteLn('ему выход был более чем за час');
    FMemo.WriteLn('до начала работы по графику.');
  }
  2://Ранний уход на обед
  { GP_SCUD_MisConDuct.Description:='Ушел ранее 1 минуту до начала обеда.';
    FMemo.WriteLn('Ушел ранее 1 минуту до начала обеда.');
  }
  3://Поздний приход с обеда
  { GP_SCUD_MisConDuct.Description:='Пришел с обеда более чем на 1 минуты позже окончания обеда';
    FMemo.WriteLn('Пришел с обеда более чем');
    FMemo.WriteLn('на 1 минуты позже окончания обеда');
  }
  4://Ранний уход с работы
  { GP_SCUD_MisConDuct.Description:='Ушел с работы ранее чем за 1 минуту до окончания работы по графику. Если ушел с работы менее чем за 15 минут до конца рабочего дня, вернулся менее чем через 1 час'
         +'после окончания работы по графику и продолжил работать, то не считается нарушением.';
    FMemo.WriteLn('Ушел с работы ранее чем за 1 минуту');
    FMemo.WriteLn('до окончания работы по графику.');
    FMemo.WriteLn('Если ушел с работы менее чем за 15 минут до конца');
    FMemo.WriteLn('рабочего дня, вернулся менее чем через 1 час');
    FMemo.WriteLn('после окончания работы по графику и продолжил работать,');
    FMemo.WriteLn('то не считается нарушением.');
  }
  5://Отсутствие в середине дня.
  { GP_SCUD_MisConDuct.Description:='Суммарное отсутствие в течение дня более 15 минут (исключая время пунктов 1-4)';
    FMemo.WriteLn('Суммарное отсутствие в течение дня более');
    FMemo.WriteLn('15 минут (исключая время пунктов 1-4)');
  }
  6://Не выясненное отсутствие
  { GP_SCUD_MisConDuct.Description:='Не выясненное отсутствие';
    FMemo.WriteLn('Нет проходов в рабочий день - Прогул');
  }
  end;
  FMemo.Close;
  Insert Current GP_SCUD_MisConDuct;
} //Procedure Ins_GP_SCUD_MisConDuct(_Num:word);

//---------------------------------------------
// Тип документа
//---------------------------------------------
Function GetTypeDoc:word;
{ Result:=GP_iSC_Types_of_misconduct;//1004; //
}

//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{     inherited ::LoadInterface(_boVisibleRun);
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_MisConDuctdEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;

      //===========================
      if (not UserAccessService.IsAdmin)
      { if wIntMode=0
        { //message('Вы не обладаете ролью Администратор.'#13'Редактирование запрещено.');
        }
        wIntMode:=wIntMode or cgiNotEdit
      }
      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
} //Procedure LoadInterface(_wRunType:word);



Browse brGroupPers '' (,,sci178Esc) ;
Show at (,,,15);
Table GP_SCUD_MisConDuct;
recMarker=pMarker;
Fields
  GP_SCUD_MisConDuct.Code        'Код' :[20],NoProtect,NoPickButton,NoDel;
  GP_SCUD_MisConDuct.Name        'Наименование' :[40],NoProtect,NoPickButton,NoDel;
  //GP_SCUD_MisConDuct.Description 'Описание'     :[40],NoProtect,NoPickButton,NoDel;
  GP_SCUD_MisConDuct.wType       'Тип' :[30], [List
     0 '-'
    ,1 'Опоздание на работу'
    ,2 'Ранний уход на обед'
    ,3 'Поздний приход с обеда'
    ,4 'Ранний уход с работы'
    ,5 'Отсутствие в середине дня'
    ,6 'Прогул'
    ],Protect;

end;//Browse brGroupPers
text GP_SCUD_MisConDuct.CONTENTS 'Информация' :NoProtect;// (,,Sci1Esc);
Show at (,16,,);


//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_MisConDuct;
cmSetDefault:
{ ClearBuffer(#GP_SCUD_MisConDuct);
}
cmInsertRecord:
{ Insert Current GP_SCUD_MisConDuct;
}
cmUpdateRecord:
{ Update Current GP_SCUD_MisConDuct;
}
cmDeleteRecord:
{ delete Current GP_SCUD_MisConDuct;
}
end; //GP_SCUD_MisConDuct


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if wIntMode=0
      { if getfirst GP_SCUD_MisConDuct<>tsok
        { Ins_GP_SCUD_MisConDuct(1);
          Ins_GP_SCUD_MisConDuct(2);
          Ins_GP_SCUD_MisConDuct(3);
          Ins_GP_SCUD_MisConDuct(4);
          Ins_GP_SCUD_MisConDuct(5);
          Ins_GP_SCUD_MisConDuct(6);
        }
      } //if wIntMode=0
      if cRec>0
      { if getfirst GP_SCUD_MisConDuct where (( cRec == GP_SCUD_MisConDuct.nrec ))=tsok {}
      }
      ReScanPanel(#GP_SCUD_MisConDuct);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_MisConDuct.Nrec;
        }
        CloseInterface(cmDefault)
      }
    }
  end;
end.
