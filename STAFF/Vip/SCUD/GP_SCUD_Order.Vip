Function GetRukPodr(_pPodr:comp) :comp; cacheable;
{ Result:=0;
  var _pPost:comp=0;
  var _pPersons:comp=0;
  if GetKatPodr_Boss(_pPodr,_pPost,_pPersons)<>''
    Result:=_pPersons;
}

  //-------------------------------------
  #doc
   Установить позицию
  #end
  Function SetDocPosition(_wTypeDoc:word;_cDoc:comp;_cDocSp:comp):boolean;
  { Result:=false;
    if _wTypeDoc=0 _wTypeDoc:=GetTypeDoc;
    if getfirst GP_SCUD_Doc where (( _cDoc == GP_SCUD_Doc.Nrec )) <>tsok then exit;
    if _cDocSp>0
    { if getfirst GP_SCUD_Doc_SP where (( _cDocSP == GP_SCUD_Doc_SP.Nrec )) <>tsok then exit;
    }
    Result:=true;
  } //Function SetDocPosition(_wTypeDoc:word;_cDoc:comp;_cDocSp:comp):boolean;

  //-------------------------------------
  #doc
   Найти подписанта, выполнять с 1,2 и т.д до тех пор пока не вернет 0
  #end
  Function GetPodpisPers(_num:word):comp;
  { Result:=0 ;
    Case _num of
    1: Result:=GetRukPodr(GP_SCUD_DOC.cKatpodr);
    end;
  }


  //-------------------------------------
  #doc
   получить тип приказа
  #end
  Function GetOrderTypeDoc(_wType:word):string;cacheable;
  { Result:='На сверхурочные';
    if _wType=90 or _wType=GP_iSC_OrderHoliday
    { Result:='на работу в выходной день';
    }
  } //Function GetOrderTypeDoc(_wType:word);string;cacheable;


