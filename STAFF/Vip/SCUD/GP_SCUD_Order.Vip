  //-------------------------------------
  #doc
  установить параметры полей
  #end
  Function SetDocFieldsState: boolean;
  { Result:=Inherited::SetDocFieldsState;
    if (StatusChange.CanChangeStatus(GP_SCUD_DOC.cStatus))
    { cfsSetProp('c_BRDOC_GP_STATUS.NAME_Статус','ButtonType',inPickButton); //WINCOMM.INC
      cfsSetProp('i_ScrEdit_GP_STATUS.NAME','ButtonType',inPickButton);
    }

  } //Function SetDocFieldsState: boolean;

  //-------------------------------------
  #doc
  спозиционироваться на объект
  #end
  Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _cGP_SCUD_DOC_SP : comp;  // ссылка на "Ведомость"
  _cGP_SCUD_DOC : comp;   // выбранная запись
  _cKatpodr  : comp;   // выбранная запись
  _cKatOrg   : longint; // включить определенные форматы
  _DTB       : Date; //период просмотра
  _DTE       : Date; //период просмотра
  _NoVisual  : boolean=false //не перерисовывать экраны
  ) : boolean;
  { #__UNUSED__(_wIntMode,_cGP_SCUD_DOC_SP,_cGP_SCUD_DOC,_cKatpodr,_cKatOrg,_DTB,_DTE,_NoVisual)
    Result:=false;
    isFilterRun:=true;
    wIntMode:=_wIntMode;
    if DTB=ZeroDate DTB:=Date(1,1,year(cur_date)-1);
    if DTE=ZeroDate DTE:=Date(31,12,year(cur_date));
    DTB_A:=DTB;
    DTE_A:=DTE;

    if _cGP_SCUD_DOC>0
    if getfirst GP_SCUD_DOC where (( _cGP_SCUD_DOC == GP_SCUD_DOC.nrec )) <>tsok
    { exit;
    }
    wTypeDoc_Main:=GP_SCUD_DOC.wType;
    if _cGP_SCUD_DOC_SP>0
    if getfirst GP_SCUD_DOC_SP where (( _cGP_SCUD_DOC_SP == GP_SCUD_DOC_SP.nrec )) <>tsok
    { if getfirst GP_SCUD_DOC_SP=tsok {}
    }
    PositionChanged;
  isFilterRun:=false;
  if (_wIntMode and cgiMultiEdit)>0
  { RunWindowModal(wnEdit)
  }

  Result:=True;



  } //Function InitParam(


//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Doc ;
cmSetDefault:
{ if isFilterRun Exit;
  ClearBuffer(#GP_SCUD_Doc);
  GP_SCUD_Doc.Nrec:=GetNextNrec(#GP_SCUD_Doc,0) ;
  GP_SCUD_Doc.dInput:=_CurDateTime;
  GP_SCUD_Doc.wType :=wTypeDoc;
  GP_SCUD_Doc.DocNMB  :=GetNextDocNumber(year(Cur_Date));
  GP_SCUD_Doc.cExecutor:=UserAccessService.UserPersonsNRec;
  GP_SCUD_Doc.cUser:=UserID();
  set GP_SCUD_Doc.DocDate:=Cur_Date;
  set GP_SCUD_Doc.cStatus := pStatus_GetDefault;
  SetEditMode(true);
  PutCommand(cmEdit)
}
cmInsertRecord:
{ Insert Current GP_SCUD_Doc;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Doc;
}
cmCheckField:
{ case CurField of
  #GP_SCUD_Doc.DocDate:
  { PushPos(#GP_SCUD_Doc_Sp);
    _Loop fullCache GP_SCUD_Doc_Sp
      update current GP_SCUD_Doc_Sp set GP_SCUD_Doc_Sp.EventDate:=GP_SCUD_Doc.DocDate;
    PopPos(#GP_SCUD_Doc_Sp);
    ReScanPanel(#GP_SCUD_Doc_Sp);
  }
  end;
}

cmDeleteRecord:
{ if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { message('Удаление доступно только в оформляемом статусе')
  }
  else
  { if message('Удалить документ '+GP_SCUD_Doc.DocNmb, YesNo)=cmYes
    {  delete GP_SCUD_Doc_Sp where (( GP_SCUD_Doc.Nrec == GP_SCUD_Doc_Sp.cGP_SCUD_Doc )) ;
       delete Current GP_SCUD_Doc;
    }
  }
}
cmPositionChanged:
{ PositionChanged;
}
end; //GP_SCUD_Doc

//------------------------------
TableEvent table GP_SCUD_Doc_SP ;
//------------------------------
cmSetDefault:
{ if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { exit;
  }
  ClearBuffer(#GP_SCUD_Doc_SP);
  GP_SCUD_Doc_SP.cGP_SCUD_Doc:=GP_SCUD_Doc.Nrec;
  GP_SCUD_Doc_SP.wType       :=GP_SCUD_Doc.wType;
  //----------------------------------
  GP_SCUD_Doc_SP.EVENTDATE :=GP_SCUD_Doc.EVENTDATE;
  GP_SCUD_Doc_SP.EVENTTMB  :=GP_SCUD_Doc.EVENTTMB ;
  set GP_SCUD_Doc_SP.EVENTTME:= GP_SCUD_Doc.EVENTTME  ;

}
cmInsertRecord:
{ Insert Current GP_SCUD_Doc_SP;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Doc_SP;
}
cmDeleteRecord:
{ if GP_SCUD_Doc.cStatus<>pStatus_GetDefault
  { message('Удаление доступно только в оформляемом статусе')
  }
  else
  { if message('Удалить строку из документа '+GP_SCUD_Doc.DocNmb, YesNo)=cmYes
    {  delete Current GP_SCUD_Doc_Sp ;
    }
  }
}
cmPositionChanged:
{ PositionChanged_SP;
}
end; //GP_SCUD_Doc_SP


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if cRec=0
      { if Marker<>0
        { GetMarker(Marker,0,cRec)
        }
      }
      //--------------------------
      SetFilterBounds(0);
      //--------------------------
      if UserAccessService.OnlyUserDoc(GetTypeDoc)
      { AddBounds(tbByUserID);
      }
      //--------------------------
      if cRec>0
      { if getfirst GP_SCUD_Doc where (( cRec == GP_SCUD_Doc.nrec ))=tsok {}
      }
      //-------------------------

      ReScanPanel(#GP_SCUD_Doc);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Doc.Nrec;
        }
        CloseInterface(cmDefault)
      }
      else
      { PutCommand(cmEdit);
      }
    }
    cmEdit:
    { case GetCurrentFormat of
      brDoc: RunWindowModal(wnEdit);
      end;
    }
    cmCheckField:
    { case curField of
      #GP_SCUD_Doc.DocDate:
      { if GP_SCUD_Doc.DocDate<GP_SCUD_Doc.Dinput
        { set GP_SCUD_Doc.wTypeReg:=1;
        }
        else
        { set GP_SCUD_Doc.wTypeReg:=1;
        }
      }
      end;
    }
    cmPick:
    { case curField of
      #GP_Status.Name:
      { if (StatusChange.PickStatus(GP_SCUD_DOC.cStatus))
         {
            pTmp:=ChangeStatus(GP_SCUD_DOC.NRec,StatusChange.StatusChangeLog);
            if PTmp<>0
            { set GP_SCUD_DOC.cStatus:=StatusChange.StatusChangeLog.cStatusTo;
              update current GP_SCUD_DOC;
              SetEditMode(CanEditTbl);
          }
        }
      }
      #KatPodr.Name,#KatPodr.Kod:
      { if RunInterface('GetPodaLN',2, GP_SCUD_DOC.cKatPodr, 1)=cmDefault
        { set GP_SCUD_DOC.cKatPodr:=GP_SCUD_DOC.cKatPodr;
        }


      }
      #GP_SCUD_Pers.Fio:
      { if RunInterface(GP_SCUD_PersVib,cgiPick,GP_SCUD_DOC_SP.cGP_SCUD_PERS,0,GP_SCUD_DOC.cKatPodr,0)<>cancel
        { set GP_SCUD_DOC_SP.cGP_SCUD_PERS:=GP_SCUD_DOC_SP.cGP_SCUD_PERS;
        }
      }
      #GP_SCUD_Reason.Name:
      { if RunInterface(GP_SCUD_ReasonEdit,cgiPick,GP_SCUD_DOC.cReason,0)<>cmCancel
        { set GP_SCUD_DOC.cReason:=GP_SCUD_DOC.cReason;
        }
      }
      #GP_SCUD_Reason_SP.Name:
      { if RunInterface(GP_SCUD_ReasonEdit,cgiPick,GP_SCUD_DOC_SP.cReason,0)<>cmCancel
        { set GP_SCUD_DOC_SP.cReason:=GP_SCUD_DOC_SP.cReason;
        }
      }
      #Filtr_Katpodr:
      { if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,2);
        }
      }
      #Filtr_GP_SCUD_Pers:
      { if GetMarkerCount(Marker_Katpodr)>0
        { StoreMarker(Marker_Katpodr,'GP_SCUD_PersEdit_KatPodr');
          if RunInterface(GP_SCUD_PersVib,cgiPickMult,0,Marker_GP_SCUD_Pers,0,0)<>cmCancel
          { SetFilterNm(#Filtr_GP_SCUD_Pers);
            BitOnW(wFilter,3);
          }

        }

      }
      end;
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatPodr);
      }
      #Filtr_GP_SCUD_Pers:
      { ClearMarker(Marker_GP_SCUD_Pers);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_GP_SCUD_Pers);
      }
      end;
    }

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Doc: RunInterface('ExClassifier', coGP_SCUD_Doc, GP_SCUD_Doc.nRec);
      end;
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(0);
      }
      else RestFromA
    }
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Doc: RunInterface('Attribute', coGP_SCUD_Doc, GP_SCUD_Doc.nRec);
      end;
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #GP_SCUD_Doc:
      { ProcessCommand(RunMenu('GP_SCUD_DocEdit_Main_HotKey'));
      }
      end;
    }
  end;

end.

GP_SCUD_DocEdit_Main_HotKey Menu
{
- 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
//- 'Внешняя классификация', cmPickClass, 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
//- 'Внешние атрибуты'     , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}
