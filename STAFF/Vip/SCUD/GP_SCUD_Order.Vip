function isFilterAnCorrect(ww_nrec:comp): boolean; forward;
//-------------------
Table Struct tmp_period
(   EventDate:date //   : date "Дата события"
  , EventTmB :time //  : time "Время события с"
  , EventTmE :time //  : time "Время события по"
  , Diff     :double//
  , wType    :word //  0 - личные невыходы,1 - служебные
  , cGP_Scud_Pers:comp
  , DocNumber:string[30]
  , DocDate:date
  , Description:string
  , cGp_SCUD_DOC_SP :comp
  , cGp_SCUD_DOC    :comp
  , Status  :string
  , STAT_DEF:word
  , cPersons :comp
  , wOpl      :word //тип работы:1 за отгул,
)
with index
( tmp_period01 = EventDate + EventTmB
);
//include GP_Log.var
var oGP_Log :GP_Log;
#include GP_SCUD_Function.Var
//-------------------
var
//-------------------
  CS: IContextSession; // для захвата прикладного контекста табеля
  vWTRef:      WorkingTableReformer;   // Переформирование табеля
//-------------------

  iGP_SCUD_EventsEdit :GP_SCUD_EventsEdit New;
  iGP_SCUD_ReasonEdit :GP_SCUD_ReasonEdit;
//-------------------
  cRec    :Comp   ; // ссылка на группу
  wTypeDoc_Main:word ;

  pMarker:IMarker(Marker) new;
  Marker:longint;
  boLoadZar:boolean;//признак загрузки функций по работе с табелем
  //------------------------
  pVA_SalScale_TMB :comp; // Время начала отклонения
  pVA_SalScale_TME :comp; // Время окончания отклонения

//--- настройки
  NPOEM_OWN_HEAD_V_VID:word;//В интерфейсе руководителя отображать
  NPOEM_OWN_SCUD_CAN_CHANGE_STATUS:word;//Разрешать изменение статуса в любых документах
  NPOEM_OWN_SCUD_Order_Variant:word;//'Использовать приказы'
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
    wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;

   #mrkfld_(KatPodr)
   #mrkfld_(GP_SCUD_Pers)

   DTB,DTE :date;
   DTB_A,DTE_A :date;
   pFlt_Katpodr:comp ;
   pFlt_GP_SCUD_Pers :comp;
   wType_Reg,wType_Reg_A    :word;

Create View
var
  pStatus:comp;
as select GP_SCUD_Doc.Nrec
From
  GP_SCUD_Doc
, GP_Status
, GP_Status GP_Status_F
, GP_SCUD_Pers,GP_SCUD_Doc_SP
, tmp_period(tmp_period01)
, x$users(readonly)
//--- Для проверки приказов
, GP_SCUD_DOC    GP_SCUD_DOC_Next
, GP_SCUD_DOC_SP GP_SCUD_DOC_SP_Next
//----- справочники
, GP_SCUD_Reason
, GP_SCUD_Reason GP_SCUD_Reason_SP
, Persons Executor
, tmp_scud_order_new(tmp_scud_order_new01)// Для новых приказов
//-------------------------------------
, KatPodr KatPodr_Flt
, GP_SCUD_Pers GP_SCUD_Pers_Flt
, GP_SCUD_Doc_SP GP_SCUD_Doc_SP_flt

where
((  wTypeDoc_main == GP_SCUD_Doc.wType
and GP_SCUD_Doc.cStatus   == GP_Status.Nrec
and GP_SCUD_Doc.cKatPodr  == KatPodr.Nrec
and GP_SCUD_Doc.cReason   == GP_SCUD_Reason.Nrec
and GP_SCUD_Doc.Nrec      == GP_SCUD_Doc_SP.cGP_SCUD_Doc
and GP_SCUD_Doc.cExecutor == Executor.Nrec
and GP_SCUD_Doc.cUser     == x$users.Atl_nrec
and GP_SCUD_Doc_SP.cReason== GP_SCUD_Reason_SP.Nrec
and GP_SCUD_Doc_SP.cGP_SCUD_Pers ==  GP_SCUD_Pers.Nrec
//------------------
and GP_SCUD_Doc.Nrec             == GP_SCUD_Doc_SP_flt.cGP_SCUD_Doc
//---------------------------------
and GP_SCUD_DOC_SP.cGP_SCUD_Pers ==  GP_SCUD_DOC_SP_Next.cGP_SCUD_Pers
and GP_SCUD_DOC_SP.wType         ==  GP_SCUD_DOC_SP_Next.wType
and GP_SCUD_DOC_SP.EventDate    <<=  GP_SCUD_DOC_SP_Next.EventDate
and (GP_SCUD_DOC_SP.Nrec <> GP_SCUD_DOC_SP_Next.Nrec )
and GP_SCUD_Doc_SP_Next.cGP_SCUD_Doc == GP_SCUD_Doc_Next.Nrec
//---------------------------------
and pStatus == GP_Status_F.Nrec
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == GP_SCUD_Pers_Flt.Nrec

))
Bounds byKatpodr   pFlt_KatPodr    == GP_SCUD_Doc.cKatPodr(noindex) ordered by TableOrder
Bounds byPeriodBeg DTB_A   <<= GP_SCUD_Doc.DocDate(noindex) ordered by TableOrder
Bounds byPeriodEnd DTE_A   >>= GP_SCUD_Doc.DocDate(noindex) ordered by TableOrder
Bounds byGP_SCUD_Pers pFlt_GP_SCUD_Pers == GP_SCUD_Doc_SP_flt.cGP_SCUD_Pers(Noindex)
Bounds byUserID    pUserId == GP_SCUD_Doc.cUser(noindex)  ordered by TableOrder

condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_DOC.Nrec))

;
//-----------------------------
create view vLsTab
var
 wMes :word;
 wYear:word;
 pPersons :comp;
 DT_Change:date;
from
  Appointments
 ,LsTab
 ,LsTabMsk
 ,Variance
where ((
    pPersons == Appointments.Person
and 0 == Appointments.LPrizn
and DT_Change >>=Appointments.AppointDate
and Appointments.cAddNrec2 == LsTab.cLschet
and wMes  == LsTab.MesN
and wYear == LsTab.YearN
and LsTab.Nrec == LsTabMsk.cLsTab
and LsTab.Nrec == Variance.cLsTab
));
