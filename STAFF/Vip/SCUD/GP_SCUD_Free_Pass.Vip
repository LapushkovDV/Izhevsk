#include GP_SCUD_KategEdit.Vih
//------------------------------
VipInterface GP_SCUD_Free_Pass Licensed(free);
//------------------------------
#doc
СКУД Свободный проход Импорт из КИС
#end
Interface GP_SCUD_Free_Pass 'Импорт свободного прохода',EscClose;
//----------------------------------

var
  #include GP_SCUD_KategEdit.Var
  nm_file:string;
  logfilenm:string;
  logfilekl:boolean;
//----------------------------------
Create view
as select GP_SCUD_PERS.Nrec
From GP_SCUD_PERS, Persons, KatPodr
where ((
  GP_SCUD_PERS.cKatPodr == KatPodr.Nrec
))
;
//------------------------------------------------
#include Excel_Imp.Vpp
//------------------------------------------------

Function FormDoc:boolean;
{ Result:=False;
  logfilekl:=False;
  if FileExist(logfilenm) DeleteFile(logfilenm);
  if not FileExist(nm_file)
  { message('Не нашли файл '
     +chr(13)+nm_file );
    Exit;
  }
  //------------------------------
  logfilekl:=true;
  //------------------------------
  var isAllOk:boolean=true;
  //====================================
  v_Imp.num_col:=60;// иначе первые 50
  Timelog('GP_SCUD_Free_Pass->ReadDataFromExcel:Start');
  XlKillExcel;
  if not ReadDataFromExcel(0,nm_file,'Select hr_v_active_employee_mai',False,true)
  { message('Ошибка импорта из'+chr(13)+nm_file);
      exit ;
  }
  Timelog('GP_SCUD_Free_Pass->ReadDataFromExcel:Finish');
  //====================================
  var wexrow_:longint;
  wexrow_:=0;
  var wkl_err:boolean;
  wkl_err:=false;
  Timelog('GP_SCUD_Free_Pass->Import:Start');
  XlKillExcel;
  logfilekl:=true;
  v_imp._loop tmp_excel
  { if not nextvisual then
    { isAllOk:=false;
        break;
    }
    wexrow_++ ;
    if wexrow_=1
    { continue;
    }
    var _sFio:string;
    _sFio:=trim(v_imp.tmp_excel.dmcell[3]+' '+v_imp.tmp_excel.dmcell[4]+' '+v_imp.tmp_excel.dmcell[5]);
    var _sID:string=v_imp.tmp_excel.dmcell[2];
    var _sPodr:string=v_imp.tmp_excel.dmcell[6];
    _sID:=v_imp.tmp_excel.dmcell[3];
    if Getfirst Persons where (( comp(_sID) == Persons.Nrec )) =tsok
    { if getfirst GP_SCUD_Pers where (( Persons.Nrec == GP_SCUD_Pers.cPersons ))=tsok
      { MyLog('Ошибка поиска сотрудника в СКУД по ID, ID='+_sId+','+_sFio )
      }
    }
    else
    { isAllOk:=false;
      _Loop GP_SCUD_PERS where (( _sFio == GP_SCUD_PERS.Fio and 0 == GP_SCUD_PERS.wType ))
      { if getfirst katpodr=tsok
        { if substr(Katpodr.kod,1,3)=substr(_sPodr,1,3)
          { isAllOk:=true;
            break;
          }

        }
      }
      if not isAllOk
      { MyLog('Ошибка поиска сотрудника в СКУД по ФИО, ID='+_sId+','+_sFio );
        continue;
      }

    }
    // ставим 3 категорию
    update current GP_SCUD_Pers set GP_SCUD_Pers.CGP_SCUD_KATEG:=iGP_SCUD_KategEdit.GetKategTypeNrec(3);
    MyLog('Установили категорию '+GP_SCUD_Pers.Fio);
  } //v_imp._loop tmp_excel
  Timelog('GP_SCUD_Free_Pass->Import:Finish');
  ClearFuncCache;
  Result:=true;
} //FomdDoc




Screen scrParam;
Fields
  nm_file:NoProtect, PickButton;
  logfilenm:Protect;
Buttons
  cmOk    ,,, 'Установить фильтр', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;

<<

  Файл   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  Лог    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 <. Продолжить .>  <.   Отмена   .>
>>
end;


HandleEvent
  cmInit:
  { nm_file:='';
    if not ReadMyDsk(nm_file,'GP_SCUD_Free_Pass_nm_file',False)
      nm_file:='d:\Galaxy\RedMine\_GP\СКУД\Import\Свободный проход на 15.12.2017.xlsx' ;
    logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0)
                               +'!TimeLog.log';
    timelog_init;

    if FileExist(logfilenm) DeleteFile(logfilenm);
  }
  cmOk:
  { SaveMyDsk(nm_file,'GP_SCUD_Free_Pass_nm_file');

    StartNewVisual(vtNumericVisual, vfTimer, 'Ждите, идет сбор данных', 0);
    FormDoc;
    StopVisual('',0);
    ProcessText(LogFileNm,vfNewTitle+vfToErase+vfMacroSize,'Протокол ммпорта');
  }
  cmCheckField:
  { case curField of
    #nm_file:
    { if not FileExist(nm_file) message('Файл не найден!');

    }
    end;
  }
  cmPick:
  { case CurField of
    #nm_file:
    { var ww_str:string=GetFileName('*.xlsx','Выберите файл c данными о свободном проходе из КИС');
      if ww_str<>'' set nm_file:=ww_str;
    }
    end;
  }
  end;

end.
