Interface GP_SCUD_PodrEdit 'Подразделения СКУД' , EscClose;
Show At (,,70,20) ;
//----------------------------------
Procedure SetTreeMode(ww_isTree:boolean);forward;
Function SyncAllPodr:boolean;forward;
//----------------------------------
#include GetKau.Var
var
  cRec    :Comp   ; // ссылка на группу
  pMarker:IMarker(Marker) new;
  Marker:longint;//выходной маркер
  pGP_SCUD_Podr_Cur:comp;//служебная , хранит текущую позицию
  isTree:boolean;//признак древовидного просмотра
Create View
var
 pNode:comp;
as select GP_SCUD_Podr.Nrec
From
  GP_SCUD_Podr
, KatOrg
, Katpodr
, GP_SCUD_Podr GP_SCUD_Podr_UP
, GP_SCUD_Podr GP_SCUD_Podr_SUB
, GP_SCUD_Podr GP_SCUD_Podr_Ins
, KatPodr Katpodr_Ins
where
((  pNode == GP_SCUD_Podr.cNode
and GP_SCUD_Podr.cNode == GP_SCUD_Podr_UP.Nrec
and GP_SCUD_Podr.Nrec  == GP_SCUD_Podr_Sub.cNode
and GP_SCUD_Podr.cKatPodr == Katpodr.Nrec
and GP_SCUD_Podr.cKatOrg  == KatOrg.Nrec
));
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;

