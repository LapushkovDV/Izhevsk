  // только текстовый поля!
  SearchField = GP_SCUD_Podr.Code;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Podr.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_Podr.Nrec;
  ViewField = GP_SCUD_Podr.Name;
  ViewField = GP_SCUD_Podr.Code;
  // только текстовый поля!
  SearchField = GP_SCUD_Podr.Name;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Podr.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName



//-----------------------------------------
// Получить наименование
//-----------------------------------------
Function GetPodrName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Podr where
          (( _pNrec == GP_SCUD_Podr.nrec ))<>tsok exit;
  Result:=GP_SCUD_Podr.Name;
} //Function GetPodrName(_pNrec:comp)   :string; cacheable;

//-----------------------------------------
// Получить код
//-----------------------------------------
Function GetPodrCode(_pNrec:comp)   :string;cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Podr where
          (( _pNrec == GP_SCUD_Podr.nrec ))<>tsok exit;
  Result:=GP_SCUD_Podr.Code;
} //Function GetPodrCode(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить тип
//-----------------------------------------
Function GetPodrType(_pNrec:comp)   :word;cacheable;
{ GetPodrType:=0;
  if getfirst fastfirstrow GP_SCUD_Podr where
          (( _pNrec == GP_SCUD_Podr.nrec ))<>tsok exit;
  Result:=GP_SCUD_Podr.wType;

} //Function GetPodrType(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetPodrTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  0: Result:='подразделения';
  1: Result:='внешние подрядчики';
  end;
} //Function GetPodrTypeName(_wType:word)   :string;cacheable;

//-----------------------------------------
// Вставить первоначальные значения
//-----------------------------------------
Procedure Ins_GP_SCUD_Podr(_wType:word;_cPodr:comp;_cPodrUp:comp);
{ var _cNode:comp=0;
  if _wType<=1 //всегда cPodrUP - подразделение куда
  { if _wType=1 and _cPodrUp=0
    { if getfirst GP_SCUD_Podr_Ins where
        (( 'Подрядчики' == GP_SCUD_Podr_Ins.Name ))<>tsok
      { clearbuffer(#GP_SCUD_Podr_Ins);
        GP_SCUD_Podr_Ins.Name:='Подрядчики';
        insert current GP_SCUD_Podr_Ins;
      }
      _cNode:=GP_SCUD_Podr_Ins.Nrec
    }
    else
    { if _cPodrUp<>0
      { if Getfirst GP_SCUD_Podr_Ins where (( _cPodrUp == GP_SCUD_Podr_Ins.cKatPodr ))<>tsok
        { if getfirst katpodr_ins where (( _cPodrUp == katpodr_Ins.Nrec ))<>tsok then exit;
          Ins_GP_SCUD_Podr(_wType,Katpodr_ins.nrec,Katpodr_ins.cpodr);
        }
        if Getfirst GP_SCUD_Podr_Ins where (( _cPodrUp == GP_SCUD_Podr_Ins.cKatPodr ))<>tsok then exit;
        _cNode:=GP_SCUD_Podr_Ins.Nrec
      }
    }
  } //if _wType=0
  var boNeedIns:boolean=false;
  if _wType=0
  { if getfirst katpodr_ins where (( _cPodr == katpodr_Ins.Nrec ))<>tsok then exit;
    if Getfirst GP_SCUD_Podr_Ins where
      ((   0 == GP_SCUD_Podr_Ins.wType(noindex)
       and _cPodr == GP_SCUD_Podr_Ins.cKatPodr
        ))<>tsok
      boNeedIns:=true;
  }
  else
  { if getfirst katOrg where (( _cPodr == katorg.Nrec ))<>tsok
    then exit;
    if Getfirst GP_SCUD_Podr_Ins where
      ((   1 == GP_SCUD_Podr_Ins.wType(noindex)
       and _cPodr == GP_SCUD_Podr_Ins.cKatOrg
        ))=tsok
      boNeedIns:=false;
  }
  if boNeedIns
  { ClearBuffer(#GP_SCUD_Podr_Ins);
  }
    if _wType=0
    { GP_SCUD_Podr_Ins.Code:=Katpodr_Ins.Kod;
      GP_SCUD_Podr_Ins.Name:=Katpodr_Ins.Name;
      GP_SCUD_Podr_Ins.cKatpodr:=_cPodr;
    }
    else
    { GP_SCUD_Podr_Ins.Code:='орг.';
      GP_SCUD_Podr_Ins.Name:=KatOrg.Name;
      GP_SCUD_Podr_Ins.cKatOrg:=_cPodr;
    }
    GP_SCUD_Podr_Ins.cNode:=_CNode;
    GP_SCUD_Podr_Ins.wType:=_wType;
  if boNeedIns
  { Insert Current GP_SCUD_Podr_Ins;
  }
  else
  { update Current GP_SCUD_Podr_Ins;
  }
} //Procedure Ins_GP_SCUD_Podr(_Num:word);

Function SyncAllPodr:boolean;
{ ResetBounds(#KatPodr);
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm,
          'Создание справочника подразделений СКУД', RecordsInTable(#Katpodr));
  _Loop Katpodr
  { if not NextVisual then break;
    Ins_GP_SCUD_Podr(0,Katpodr.Nrec,Katpodr.cPodr );

  } //_Loop Katpodr
  StopVisual('',0);
  SetBounds(#KatPodr);
  Result:=true;
}//Function SyncAllPodr:boolean;



//---------------------------------------------
// Тип документа
//---------------------------------------------
Function GetTypeDoc:word;
{ Result:=GP_iSC_DepartMents_SCUD;//1006; //
}

//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{     inherited ::LoadInterface(_boVisibleRun);
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_PodrdEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;

      //===========================

      if (not UserAccessService.IsAdmin)
      { if wIntMode=0
        { //message('Вы не обладаете ролью Администратор.'#13'Редактирование запрещено.');
        }
        wIntMode:=wIntMode or cgiNotEdit
      }
      else
      { if RecordsInTable(#GP_SCUD_Podr)=0
          SyncAllPodr;

      }
      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
} //Procedure LoadInterface(_wRunType:word);


//---------------------------------------------
// получить наименование
//---------------------------------------------
Function GetPodrOrgName(_pNrec:comp):string;
{ #__UNUSED__(_pNrec)
  if GP_SCUD_Podr.wType=0
  { if isValid(#KatPodr)
      Result:=Katpodr.Kod+','+Katpodr.name;
  }
  else
  { if isValid(#KatOrg)
      Result:=KatOrg.name;
  }
} //Function GetPodrOrgName(_pNrec:comp):string;

Procedure onSetPositionTable(_PNrec:comp);
{ pGP_SCUD_Podr_Cur:=_PNrec;

} //Procedure onSetPositionTable(_PNrec:comp);

//******************************************************
//  Форматы
//******************************************************
tree trMain '' (,,sci1378EscExTree_InsLevel) ;
Table GP_SCUD_Podr;
recMarker=pMarker;
Fields
  GP_SCUD_Podr.Name        'Наименование' :[40],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Podr.Code        'Код' :[20],NoProtect,NoPickButton,NoDel;
  //GP_SCUD_Podr.Description 'Описание'     :[40],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Podr.wType       'Тип' :[10], [List
     0 'подразделения'
    ,1 'внеш.подрядчики'
    ],Protect;
  [PodrOrgName] GetPodrOrgName(GP_SCUD_Podr.Nrec) 'Связанный справочник' :Protect,PickButton;
  GP_SCUD_Podr_Up.Name 'Вышестоящий уровень';
end;//Browse brGroupPers


Browse brMain '' (,,sci178Esc);
Table GP_SCUD_Podr;
recMarker=pMarker;
Fields
  GP_SCUD_Podr.Name        'Наименование' :[40],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Podr.Code        'Код' :[20],NoProtect,NoPickButton,NoDel;
  //GP_SCUD_Podr.Description 'Описание'     :[40],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Podr.wType       'Тип' :[10], [List
     0 'подразделения'
    ,1 'внеш.подрядчики'
    ],Protect;
  PodrOrgName 'Связанный справочник' :Protect,PickButton;
  GP_SCUD_Podr_Up.Name 'Вышестоящий уровень';
end;//Browse brGroupPers

//-----------------------------
Procedure SetTreeMode(ww_isTree:boolean);
var ww_nrec:comp;
{ if ww_isTree<>isTree
  { isTree:=ww_isTree;
    //SaveMyDsk(isTree, 'isTree_' + GetIName)
    if isTree
    {
      ww_nrec:=GP_SCUD_Podr.Nrec;
      PushBounds(#GP_SCUD_Podr);
      SetFormat(trMain);
      ReScanPanel(#GP_SCUD_Podr);
      TreeJumpToRecord(trMain, 0);
      if ww_nrec>0
        TreeJumpToRecord(trMain, ww_nrec);
    }
    else
    { ResetBounds(#GP_SCUD_Podr);
      SetFormat(brMain);
      ReScanPanel(#GP_SCUD_Podr);
    }
  }
  else
  { if isTree ReScanPanel(#GP_SCUD_Podr);
    else      ReScanPanel(#GP_SCUD_Podr);
  }
} //Procedure SetTreeMode(ww_isTree:boolean);



//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Podr ;
cmTreeTop         :
{ pNode := 0;
}
cmTreeUp          :
{ pNode := GP_SCUD_Podr.cNode;
}
cmTreeDown        :
{ pNode := GP_SCUD_Podr.Nrec;
}
cmTreeNodeType    :
{ //onSetPosition(U_XML_TABLE.Nrec);

  if ( Not IsValidAll(#GP_SCUD_Podr_Sub) )
                      TreeSetNodeType(trMain, ntfText);
}
cmTreeNeedOwner:
{ TreeJumpToRecord(trMain, GP_SCUD_Podr.cNode);
}
cmTreeInsLevel:
{ //message('1111')
  //TreeJumpToRecordEx(trTable, #U_XML_TABLE, U_XML_TABLE.Nrec)
}

cmSetDefault:
{
  var c1:comp=0;
  if isTree
  { c1:=pNode; //cNodeTable;
    if pGP_SCUD_Podr_Cur<>0 //isvalid(#U_XML_TABLE)
    { case RunMenu('GP_SCUD_PODR_ChooseLevel') of
      cmValue1 : {
       //  message('cmValue1 '+string(c1)+'/'+string(cNodeTable))
      };
      cmValue2 :
      { c1 :=pGP_SCUD_Podr_Cur;
      }
      else exit;
      end;
    }
  }
  clearbuffer(#GP_SCUD_Podr);
  GP_SCUD_Podr.wType:=1;
  GP_SCUD_Podr.cNode:=c1;
  insert current GP_SCUD_Podr;
  //message('cmSetDefault List  '+string(c1)+'/'+string(cNodeTable)+'/'+string(U_XML_TABLE.cNode) )
  SetNew(False);
  if isTree
  { TreeJumpToRecordEx(trMain, #GP_SCUD_Podr, GP_SCUD_Podr.Nrec)
  }
  onSetPositionTable(GP_SCUD_Podr.Nrec);
  ReScanPanel(#GP_SCUD_Podr)
}
cmInsertRecord:
{ insert current GP_SCUD_Podr;
  //message('2222')
  if isTree
  { TreeJumpToRecordEx(trMain,#GP_SCUD_Podr, GP_SCUD_Podr.Nrec);
  }
  onSetPositionTable(GP_SCUD_Podr.Nrec);
}
cmUpdateRecord:
{ update current GP_SCUD_Podr;
  onSetPositionTable(GP_SCUD_Podr.Nrec);
}
cmDeleteRecord:
{ if getfirst GP_SCUD_Podr_Sub=tsok
  { message('Есть подчиненные записи');
    exit;
  }
  //здесь еще добавить проверки
  delete Current GP_SCUD_Podr;
}
cmIdle:
{ //onSetPosition(U_XML_TABLE.Nrec);
}
cmPositionChanged:
{ onSetPositionTable(GP_SCUD_Podr.Nrec);
}
end; //GP_SCUD_Podr



//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if wIntMode=0
      {
      } //if wIntMode=0
      if cRec=0
      { if Marker<>0
        { GetMarker(Marker,0,cRec)
        }
      }
      if cRec>0
      { if getfirst GP_SCUD_Podr where (( cRec == GP_SCUD_Podr.nrec ))=tsok {}
      }
      isTree:=false;
      SetTreeMode(not isTree);
      ReScanPanel(#GP_SCUD_Podr);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Podr.Nrec;
        }
        CloseInterface(cmDefault)
      }
    }
    cmPick:
    { if isProtect
      { exit;
      }
      Case curField of
      #PodrOrgName:// 'Связанный справочник' :Protect,PickButton;
      { case GP_SCUD_Podr.wType of
        0:
        { pTmp:=GP_SCUD_Podr.cKatPodr;
          if iGetKau.GetCodeKau(cgiPick,cgKAu_KatPodr,pTmp)<>0
            set GP_SCUD_Podr.cKatPodr:=pTmp;

        }
        1:
        { pTmp:=GP_SCUD_Podr.cKatOrg;
          if iGetKau.GetCodeKau(cgiPick,cgKAu_KatOrg,pTmp)<>0
          {  set GP_SCUD_Podr.cKatorg:=pTmp;
             if getfirst katorg=tsok
             {  set GP_SCUD_Podr.Name:=KatOrg.name;
                set GP_SCUD_Podr.Code:=KatOrg.Shortname;
             }
          }
        }
        end;

      }
      #GP_SCUD_Podr_Up.Name:// 'Вышестоящий уровень';
      { pTmp:=GP_SCUD_Podr.cNode;
        if RunInterface(GP_SCUD_PodrEdit,cgiPick,pTmp,0)<>cmCancel
        { set GP_SCUD_Podr.cNode:=pTmp;
          SetModified(true);
          UpdateTable;
          if isTree
          { isTree:=not isTree;
            SetTreeMode(not isTree);
          }
        }

      }

      end;
      ReScanPanel(#GP_SCUD_Podr);
    }
    cmAccording://Alt+S - изменение вида интерфейса
    {
      SetTreeMode(not isTree)
    }
    cmValue1: //Обновить каталог подразделений СКУД
    { if message('Обновить связи с каталогом подразделений?',YesNo)=cmYes
        SyncAllPodr;
    }
    //------------------------------------------------------------------------------
    // Событие вызывает локальное меню
    //------------------------------------------------------------------------------
    cmHotKeys:
    {
      if UserAccessService.IsAdmin
        PutHotCommand(RunMenu('GP_SCUD_PODR_Main_Adm'));
      else
        PutHotCommand(RunMenu('GP_SCUD_PODR_Main'));
    }
    //------------------------------------------------------------------------------
    // Событие возникает при нажатии Ctrl+M
    //------------------------------------------------------------------------------
    cmManagerId:
    {

    }
  end;
end.

//============================
// Меню добавления в дерево
//============================
GP_SCUD_PODR_ChooseLevel Menu
{
  - 'Добавить на текущий уровень', cmValue1;
  - 'Добавить на уровень ниже'   , cmValue2;
}


GP_SCUD_PODR_Main Menu
{
 - 'Представление "дерево <-> линейный список"' , cmAccording    , 'Представление в виде дерева/линейного списка с учетом иерархии',,'Alt+S',kbAltS,scMenuCtx;
}
GP_SCUD_PODR_Main_Adm Menu
{
 - 'Синхронизация каталога подразделений со подразделениями СКУД ' , cmValue1    , 'Обновить каталог подразделений СКУД';
 - 'Представление "дерево <-> линейный список"' , cmAccording    , 'Представление в виде дерева/линейного списка с учетом иерархии',,'Alt+S',kbAltS,scMenuCtx;
}
