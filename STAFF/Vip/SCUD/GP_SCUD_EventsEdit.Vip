Window wnEditEvents 'Редактирование записи';
show at (,,75,17);
Tabbedsheet top tsEvent;
Screen ScrEditEvents 'Событие' ;
Table GP_SCUD_Events ;
Fields
   [EV_NPP] if(GP_SCUD_Events.sNPP<>'',GP_SCUD_Events.sNPP,string(GP_SCUD_Events.NPP))     ('Порядковый Номер',,):Protect,NoDel;
   GP_SCUD_Events.StrTabn   : PickButton,Protect,NoDel;
   GP_SCUD_Pers.Fio         : PickButton,Protect,NoDel;
   GP_SCUD_Events.EnterDate : NoProtect,NoDel;
   GP_SCUD_Events.EnterTime : ['HH:MM:SS'], NoProtect,NoDel;
   GP_SCUD_Events.Card      : Protect,NoDel;
   Plan_Time                : Protect,NoDel;
   Plan_Diff                : ['HH:MM:SS'], Protect,NoDel, {Font={Color=GetColorDiffEvents(GP_SCUD_Events.Nrec) }};
   Next_Event               : Protect,NoDel;
   GP_SCUD_MisConDuct.Name  : Protect,NoDel;
   [Podr] KatPodr.Kod+' '+Katpodr.name   (,,):Protect,NoDel;
   GP_SCUD_Events.wEvents_Type    : [List 0 '-','РВ','П','СВ'],Protect,NoDel;
   GP_SCUD_Events.wResource       : [List 0 'Выход','Вход'],Protect;
   GP_Status.Name                 : PickButton,NoDel;
   GP_SCUD_Controler.Name         : PickButton, Protect,NoDel;
   GP_SCUD_AREAS.DISPLAY_NAME     : Protect,NoPickButton,NoDel;
   GP_SCUD_DOC_A.DocNMB           : Protect, NoDel,NoPickButton;
   GP_SCUD_DOC_A.DocDate          : Protect, NoDel,NoPickButton;
   GP_Status_A.Name               : Protect, NoDel,NoPickButton;
   GP_SCUD_Reason_A.Name          : Protect, NoDel,NoPickButton;
Buttons
   cmValue31,,, 'Сформировать заявление', hcAllBOk, scGalDial;
   cmValue32,,, 'Все События в СКУД', hcAllBOk, scGalDial;
//   cmValue33,,, 'Приказ на работу в выходной день', hcAllBOk, scGalDial;
//  <.Приказ на работу в вых.день.>

//<.Сформировать приказ.>   cmValue32,,, 'Сформировать приказ', hcAllBOk, scGalDial;
<<
 п/п  .@@@@@@@@@@@ Таб.№  .@@@@@@@@@@@ Фио  .@@@@@@@@@@@@@@@@@@@@@@@
 Дата .@@@@@@@@@@ Время  .@@@@@@@@     Карта.@@@@@@@@@@@@@@@@@@@@@@@
 План .@@@@@@@@@@ Разница.@@@@@@@@ Следующее.@@@@@@@@@@@@@@@@@@@@@@@
 Нарушение     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Подразделение .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Событие .@@@@@@@@@@@@@@@ Ресурс устройства .@@@@@@@@@@@@@@@@@@@@@@@
 Статус  .@@@@@@@@@@@@@@@ Устройство        .@@@@@@@@@@@@@@@@@@@@@@@
 Ареал   .@@@@@@@@@@ Заявление .@@@@@@@@@ от.@@@@@@@@@@ .@@@@@@@@@@@
                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  <.Сформировать заявление.>  <.Все События в СКУД.>

>>
end;//Scrren ScrEditEvents
Screen ScrEditRejim 'Режим';
Table GP_SCUD_Events;
Fields
  vTabel.wRejim :Protect,NoDel;
  vTabel.KlRejim.NRejim:Protect,NoDel;
  Graf_Time    :[11,'HH:MM'],Protect,NoDel;
  StartWorkDay :[11,'HH:MM'],Protect,NoDel;
  EndWorkDay   :[11,'HH:MM'],Protect,NoDel;
  StartBreak1  :[11,'HH:MM'],Protect,NoDel;
  EndBreak1    :[11,'HH:MM'],Protect,NoDel;
  StartBreak2  :[11,'HH:MM'],Protect,NoDel;
  EndBreak2    :[11,'HH:MM'],Protect,NoDel;
  StartShift2  :[11,'HH:MM'],Protect,NoDel;
  EndShift2    :[11,'HH:MM'],Protect,NoDel;
//  WorkPatternStr 'Шаблон рабочего дня':[20],Protect,PickButton;

<<
  `Режим`   .@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Часы по графику`   .@@@@@@@@@@

  `Начало раб. дня`   .@@@@@@@@@@  `Окончание раб. дня`   .@@@@@@@@@@

  `Начало перерыва`   .@@@@@@@@@@  `Окончание перерыва`   .@@@@@@@@@@
  `Начало перерыва 2` .@@@@@@@@@@  `Окончание перерыва 2` .@@@@@@@@@@

  `Начало смены 2`    .@@@@@@@@@@  `Окончание смены 2`    .@@@@@@@@@@
>>
end;
end;//Tabbedsheet top tsEvent;

HandleEvent
cmInit:
{
  SetEditMode(CanEditTbl);
  StartWorkDay:=ZeroTime;
  EndWorkDay  :=ZeroTime;
  StartBreak1 :=ZeroTime;
  EndBreak1   :=ZeroTime;
  StartBreak2 :=ZeroTime;
  EndBreak2   :=ZeroTime;
  StartShift2 :=ZeroTime;
  EndShift2   :=ZeroTime;
  if GP_SCUD_Events.EnterDate<>ZeroDate
  { var D:word=0;
    vTabel.pPersons:=GP_SCUD_Pers.cPersons;
    if vTabel.GetFirst Lschet=tsok {}
    vTabel.wMonth:=Month(GP_SCUD_Events.EnterDate);
    vTabel.wYear :=Year (GP_SCUD_Events.EnterDate);
    var boTable:boolean=false;
    boTable:=vTabel.GetFirst LsTab=tsok;

    set vTabel.wRejim:=GetRejimDay(GP_SCUD_Pers.Nrec,GP_SCUD_Events.EnterDate);
    vTabel.wMonth:=Month(Calc_Date);
    vTabel.wYear :=Year(Calc_Date);
    D:=Day(GP_SCUD_Events.EnterDate);
    if D>0
    { if vTabel.getfirst GP_KlndrExt=tsok
      { StartWorkDay:=vTabel.GP_KlndrExt.StartWorkDay[D];
        EndWorkDay  :=GetEndWorkDay(D);//vTabel.GP_KlndrExt.EndWorkDay[D];
        StartBreak1 :=vTabel.GP_KlndrExt.StartBreak1[D];
        EndBreak1   :=GetEndBreak1(D);//vTabel.GP_KlndrExt.EndBreak1[D];
        StartBreak2 :=vTabel.GP_KlndrExt.StartBreak2[D];
        EndBreak2   :=vTabel.GP_KlndrExt.EndBreak2[D];
        StartShift2 :=vTabel.GP_KlndrExt.StartShift2[D];
        EndShift2   :=GetEndShift2(D);//vTabel.GP_KlndrExt.EndShift2[D];
      } //if vTabel.getfirst GP_KlndrExt=tsok
      if vTabel.getfirst Klndr=tsok
      { Graf_Time   :=GetTimeFromDouble(double(vTabel.KLNDR.DAYCHAS[D]) + vTabel.KLNDR.DAYMIN[D] / 60);
        if EndWorkDay<GetEndWorkDay(D) //vTabel.GP_KlndrExt.EndWorkDay[D]
        { Graf_Time:=Sub_Time(Graf_Time,Sub_time(GetEndWorkDay(D),EndWorkDay))
        }
        if EndBreak1>vTabel.GP_KlndrExt.EndBreak1[D]
        { Graf_Time:=Sub_Time(Graf_Time,Sub_time(EndBreak1,vTabel.GP_KlndrExt.EndBreak1[D]))
        }
      } //if vTabel.getfirst Klndr=tsok
    } //if D>0
    if vTabel.getfirst KlRejim=tsok {}
  } //if GP_SCUD_Events.EnterDate<>ZeroDate
  if getfirst GP_SCUD_DOC_SP_A=tsok
  { cfsSetProp('b_SCREDITEVENTS_Сформировать_заявление',cfpTitle,'Просмотр заявления')
  }
  else
  { cfsSetProp('b_SCREDITEVENTS_Сформировать_заявление',cfpTitle,'Сформировать заявление');
  }
} //cmInit
cmValue31:
{ if GetColorDiffEvents(GP_SCUD_Events.Nrec)<>ColorSysRed
  or Graf_Time=ZeroTime
  { message('Нет нарушений');
    Exit;
  }

  if getfirst GP_SCUD_DOC_SP_A=tsok
  { /*if message('Заявление уже есть'
      +chr(13)+' открыть?',YesNo)=cmYes
    { iGP_SCUD_StateMentOnAbsent.EditDoc(GP_SCUD_DOC_SP_A.cGP_SCUD_DOC)

    }*/
    if pGP_SCUD_DOC_SP_O=GP_SCUD_DOC_SP_A.Nrec
    { message('Вы и так просматриваете это заявление');
    }
    else
    { iGP_SCUD_StateMentOnAbsent.EditDoc(GP_SCUD_DOC_SP_A.cGP_SCUD_DOC);
    }
    ClearFuncCache;
    ReReadREcord(#GP_SCUD_Events);
    Exit;
  }
  if TimeLog_Status>0 timelog('GP_SCUD_EventsEdit->MakeDoc:cmValue31');
  var _TMB,_TME:time;
  if Plan_Time<GP_SCUD_Events.EnterDate
  { _TMB:=GP_SCUD_Events.EnterTime;
    _TME:=Plan_Time;
    if length(Next_Event)=5//только время не следующее
      if Plan_Time>Next_Event
        _TME:=StrToTime(Next_Event,'HH:MM');
  }
  else
  { _TME:=GP_SCUD_Events.EnterTime;
    _TMB:=Plan_Time;
  }
  var _sDescription:string='';
  if isValid(#GP_SCUD_MisConDuct)
   _sDescription:=GP_SCUD_MisConDuct.Name;
  iGP_SCUD_StateMentOnAbsent.MakeDoc(GP_SCUD_Pers.Nrec
                     ,GP_SCUD_Events.Nrec
                     ,GP_SCUD_Events.EnterDate
                     ,_TMB
                     ,TimeToStr(_TME,'HH:MM')
                     ,Plan_Time
                     ,0
                     ,pGP_SCUD_DOC_SP_O
                     ,_sDescription
                     );

  ClearFuncCache;
  ReReadRecord(#GP_SCUD_DOC_SP_A);
  ReReadRecord(#GP_SCUD_Events);
  if pGP_SCUD_DOC_SP_O>0
  { Event_ReReadContainer;
    CloseWindow(wnEditEvents);
  }
}
cmValue32: //Все События в СКУД
{ //message('Не реализовано');
  iGP_SCUD_EV_AllEdit.InitParam(cgiMultiEdit,0,GP_SCUD_Events.cGP_SCUD_PERS,0,0,DTB,DTE,false);
}
cmValue33:
{  if GetDoubleFromtime(Graf_Time)=0
   { message('День не является выходным');
     Exit;
   }
   MakeOrder(1);
}
end;//HandleEvent
end;//Window wnEdit


