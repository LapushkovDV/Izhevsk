/*************************************************************************************************\
* Наименование: Скуд - события                                                                    *
* Контур/Модуль: Кадры                                                                            *
* Примечание: GP_SCUD_Events.wResource = REG_EVENTS.type_Pass - 1 вход, 0 выход                   *
* Сделаем по GP_SCUD_AREAS.wType=1 -вход, 0 - выход + Need_UCHET                                  *
* при импорте жестко вшит - завод=вход, не контролируемая Сделаем по GP_SCUD_AREAS.wType=1 -вход, *
*0 - выход + Need_UCHET                                                                           *
* Учет часов по 92 и 91 приказу (№1941)                                                           *
* 1. Часы по графику считать как часы из 92 приказа - часы на кормление из 91.                    *
* 2. Время окончания смены  отражать как                                                          *
*   План по графику - (часы по графику - часы из 92)                                              *
* 3. Время окончания обеда = время по графику + часы на кормление по 91.                          *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#175          |20/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#1574         |05/01/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#1941         |05/01/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Доработка   |#89424        |22/01/25|Андреев С.И.             |СКУД, Гибкий график              *
\*************************************************************************************************/
// убрать NO для отладки
#DEFINE GP_SCUD_EventsEdit_DEBUG
#DEFINE GP_SCUD_EventsEdit_DEBUG_MIS
/*
удаление дубликатов
SQL delete from GP_SCUD_EVENTS where GP_SCUD_EVENTS.Nrec in
(  select GP_SCUD_EVENTS.Nrec From GP_SCUD_EVENTS
inner join GP_SCUD_EVENTS GP_SCUD_EVENTS_D on GP_SCUD_EVENTS_D.NPP = GP_SCUD_EVENTS.NPP and GP_SCUD_EVENTS_D.Nrec > GP_SCUD_EVENTS.NRec
and GP_SCUD_EVENTS_D.wsystem = GP_SCUD_EVENTS.wsystem
);
SQL delete from GP_SCUD_EV_ALL where GP_SCUD_EV_ALL.Nrec in
(  select GP_SCUD_EV_ALL.Nrec From GP_SCUD_EV_ALL
inner join GP_SCUD_EV_ALL GP_SCUD_EVENTS_D on GP_SCUD_EVENTS_D.NPP = GP_SCUD_EV_ALL.NPP and GP_SCUD_EVENTS_D.Nrec > GP_SCUD_EV_ALL.NRec
and GP_SCUD_EVENTS_D.wsystem = GP_SCUD_EVENTS.wsystem
);

отбор в скуде
//--------
 select  min(re.time_ev) as time_ev --время выхода
       , min(dpt.display_name) dcode
       , min(re.id_reg)
       , min(ip.ip_addr) , min(ip.id_configs_tree_ip) ,min(ip.configs_tree_id),  min(re.type_pass), min(re.inner_number_ev)
    ,re.date_ev,re.areas_id ,re_o2.time_ev--,re_o2.areas_id, re_o4.time_ev,re_o4.areas_id
    ,st.last_name,st.first_name name, st.middle_name fathership, st.id_staff

 from REG_EVENTS re
    inner join staff st on st.id_staff = re.staff_id
    inner join AREAS_TREE ar
           on (ar.ID_AREAS_TREE = re.AREAS_ID)
    left outer join STAFF_REF sr on sr.staff_id        = st.id_staff
    left outer join SUBDIV_REF dpt on dpt.id_ref = sr.subdiv_id
    left outer join CONFIGS_TREE ct on ct.id_configs_tree = re.configs_tree_id_controller
    left outer join CONFIGS_TREE_IP ip on ip.configs_tree_id=ct.id_configs_tree
    left outer join  REG_EVENTS re_o2
    on re_o2.staff_id = re.staff_id and re_o2.type_pass=1
       and (re_o2.areas_id=1 or re_o2.areas_id=125937)
       and (re_o2.areas_id<>re.areas_id)
       and re_o2.date_ev=re.date_ev and re_o2.time_ev<re.time_ev
  where ( re.date_ev='10.10.2017'
         or re.date_ev='20.02.2017'
         )
        and re.type_pass=1
       and (re.areas_id =125937)
       and (5098 =re.staff_id
       or 5897 =re.staff_id
       or  st.last_name='РўРчР>РчР?РєР?Р?'
       )
       and ((re_o2.id_reg is null) or
       re_o2.time_ev=
     ( select max(case when re_o1.time_ev is null
       then '0:00' else re_o1.time_ev end ) as time_ev
          from REG_EVENTS re_o1
          where   re_o1.type_pass=1
          and (re_o1.areas_id=1 or re_o1.areas_id=125937)
          and re_o1.staff_id = re.staff_id
          and (re_o1.areas_id<>re.areas_id)
          and re_o1.date_ev=re.date_ev and re_o1.time_ev<re.time_ev
          group by re_o1.staff_id,re_o1.date_ev,re_o1.areas_id
          )
      )
 group by   re.date_ev,re.areas_id ,re_o2.time_ev--,re_o2.areas_id, re_o4.time_ev,re_o4.areas_id
    ,st.last_name ,st.first_name, st.middle_name, st.id_staff

  -- //----------------------- выходы
   union
 select distinct  max(re.time_ev)
       , max(dpt.display_name) dcode
       , max(re.id_reg)
       , max(ip.ip_addr)
       , max(ip.id_configs_tree_ip)
       , min(ip.configs_tree_id)
       , min(re.type_pass), min(re.inner_number_ev)
    ,re.date_ev,re.areas_id ,re_o2.time_ev--,re_o2.areas_id, re_o4.time_ev,re_o4.areas_id
    ,st.last_name,st.first_name name, st.middle_name fathership, st.id_staff

  from REG_EVENTS re
    inner join staff st on st.id_staff = re.staff_id
    inner join AREAS_TREE ar
           on (ar.ID_AREAS_TREE = re.AREAS_ID)
    left outer join STAFF_REF sr on sr.staff_id        = st.id_staff
    left outer join SUBDIV_REF dpt on dpt.id_ref = sr.subdiv_id
    left outer join CONFIGS_TREE ct on ct.id_configs_tree = re.configs_tree_id_controller
    left outer join CONFIGS_TREE_IP ip on ip.configs_tree_id=ct.id_configs_tree
    left outer join  REG_EVENTS re_o2
    on re_o2.staff_id = re.staff_id and re_o2.type_pass=1
       and (re_o2.areas_id=125937)
       and (re_o2.areas_id<>re.areas_id)
       and re_o2.date_ev=re.date_ev and re_o2.time_ev>re.time_ev

  where (re.date_ev='10.10.2017'-- '20.02.2017'  --and re.time_ev>'8:00'
         or re.date_ev='20.02.2017'
         or re.date_ev>CURRENT_DATE-30
         )
        and re.type_pass=1
       and (re.areas_id =1)
       and (5098 =re.staff_id
       or 5897 =re.staff_id
       or  st.last_name='РўРчР>РчР?РєР?Р?'
       )

    and ((re_o2.id_reg is null) or
       re_o2.time_ev =
       ( select min(re_o1.time_ev) as time_ev
          from REG_EVENTS re_o1
          where   re_o1.type_pass=1
          and (re_o1.areas_id=1 or re_o1.areas_id=125937)
          and re_o1.staff_id = re.staff_id
          and (re_o1.areas_id<>re.areas_id)
          and re_o1.date_ev=re.date_ev and re_o1.time_ev>re.time_ev
          group by re_o1.staff_id,re_o1.date_ev,re_o1.areas_id
          )
      )
   group by   re.date_ev,re.areas_id ,re_o2.time_ev
          ,st.last_name,st.first_name , st.middle_name, st.id_staff
*/
