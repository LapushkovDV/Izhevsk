  TME : NoProtect;
<<
 Период c.@@@@@@@@@@.@@@@@ по.@@@@@@@@@@.@@@@@
>>
end;//Screen scrDatFilter ;
Browse br#(wn_name) '' (,,sci147Esc) ;
Show at (,3,,);
Table GP_SCUD_Events;
recMarker=pMarker;
Fields
   {Font ={Color=GetColorEvents(GP_SCUD_Events.Nrec)}};
   GP_SCUD_Events.EnterDate    'Дата' (,,sci147Esc) :[12], Protect, NoAutoSize;
   GP_SCUD_Events.EnterTime    'Время' (,,sci147Esc):[6] ,Protect, NoAutoSize;
   GP_SCUD_Events.wEvents_Type   'Тип' : [List 0 '-','РВ','П','СВ'],Protect,NoDel, NoAutoSize;
   GP_SCUD_Events.wResource      'Ресурс','устройства' :[5],[List 0 'Выход','Вход'],Protect, NoAutoSize,NoPickButton,Skip,NoDel;
   Plan_Time  'План'  :[5],Protect, NoAutoSize;
   //GP_SCUD_MisConDuct.Name
   Plan_Diff  'Разница' :[10],Protect,CustomSorting, NoAutoSize, {Font={Color=GetColorDiffEvents(GP_SCUD_Events.Nrec) }};
   sMisConDuct 'Нарушение' :[15],Protect,CustomSorting, NoAutoSize;
   Next_Event              'Следующее' :[10],Protect,CustomSorting;
   GP_SCUD_Events.wEvents_Type   'Тип' : [List 0 '-','РВ','П','СВ'],Protect,NoDel,Skip;
   GP_Status.Name                'Статус','события' : [7], Protect, NoDel,NoPickButton;
   GP_Status_A.Name              'Статус','док-нта' : [7], Protect, NoDel,NoPickButton;

 end;//Browse brScudPers
 HandleEvent
 cmDefault:
 { PutCommand(cmValue41);
 }
 cmInsert:
 { MyInsertEvents;
   PutCommand(cmEdit);
   Abort;
 }
 cmHotKeys:
 { var _wCommnand:word;
   _wCommnand:=RunMenu('GP_SCUD_EventsEditEdit_Main_HotKey_Wn');
   // если нажать мимо, закрывает интерфейс
   case _wCommnand of
   0,cmDone,cmCancel:
   {
   }
   else PutCommand(_wCommnand);
   end;
 }
 cmPrintDoc: PrintRep;
 cmEdit:
 { PutCommand(cmValue41);
 }
 cmValue41:
 { RunWindowModal(wnEditEvents);
 }
 end;
end;//Window wnEventsPers
#END
// Для двойного использования в окнах документов надо два экземпляра
#wnEventsPers(EventsPers)
#wnEventsPers(EventsPers01)
//**********************************************************************
Screen scrDatFilter ;
Show at (,,,2);
Table GP_SCUD_Events;
Fields
  DTB : NoProtect;
  TMB : NoProtect;
  DTE : NoProtect;
  TME : NoProtect;
<<
 Период событий c  .@@@@@@@@@@.@@@@@@ по .@@@@@@@@@@.@@@@@@
>>
end;//Screen scrDatFilter ;
Browse brScudEvents '' (,,sci17Esc);
Show at (,3,,);
Table GP_SCUD_Events;
recMarker=pMarker;
Fields
   {Font ={Color=GetColorEvents(GP_SCUD_Events.Nrec)}};
   //GP_SCUD_Events.NPP
   EV_NPP      'п/п' ('Порядковый Номер',,):[10],Protect,NoDel;
   GP_SCUD_Events.StrTabn  'Таб.№' :[10],NoPickButton,Protect;
   GP_SCUD_Pers.Fio         'Сотрудник/Посетитель' :[20], NoPickButton,Protect;
   GP_SCUD_Events.wResource    'Ресурс','устройства' :[5],[List 0 'Выход','Вход'],Protect,Skip;
   GP_SCUD_Events.EnterDate    'Дата' :[12],Protect,NoDel;
   GP_SCUD_Events.EnterTime    'Время':[6] ,Protect,NoDel;
   Plan_Time  'План'    :[5],Protect, NoAutoSize;
   Plan_Diff  'Разница' :[5],Protect, NoAutoSize, {Font={Color=GetColorDiffEvents(GP_SCUD_Events.Nrec) }};
   GP_SCUD_Events.Card         'Карта':[12],Protect,NoDel;
   Podr  'Подразделение' (,,):[15],Protect,NoDel;
   GP_SCUD_Events.wEvents_Type   'Тип' : [List 0 '-','РВ','П','СВ'],Protect,NoDel,Skip;
   GP_Status.Name                'Статус' : [7], NoPickButton;
   GP_SCUD_Controler.Name        'Контролер' : [10], NoPickButton, Protect,NoDel;
   Next_Event/*GetNextEventsTime(GP_SCUD_Events.Nrec)*/ 'Следующее' :[10],Protect,CustomSorting;
   GP_SCUD_AREAS.DISPLAY_NAME 'Ареал' :[15],Protect,NoPickButton;
   GP_Status_A.Name              'Статус','док-та' : [7], Protect, NoDel,NoPickButton;
 end;//Browse brScudPers


 //-----------------------------------------
//   Проинициализровать данные
//-----------------------------------------
Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _cNrec     : comp;  // ссылка на "Ведомость"
  _cGP_SCUD_Pers  : comp;   // выбранная запись
  _cKatpodr  : comp;   // выбранная запись
  _cKatOrg   : longint; // включить определенные форматы
  _DTB       : Date; //период просмотра
  _DTE       : Date; //период просмотра
  _NoVisual  : boolean=false; //не перерисовывать экраны
  _pGP_SCUD_DOC_SP_O:comp=0//для вызова из заявления
  ) : boolean;
{ Result:=False;
  isFilterRun:=true;
  if _DTB<>ZeroDate
  { DTB:=_DTB;
  }
  if _DTE<>ZeroDate
  { DTE:=_DTE;
  }
  set wIntMode:=_wIntMode;
  if DTB=ZeroDate DTB:=Date(1,1,year(cur_date)-1);
  if DTE=ZeroDate DTE:=Date(31,12,year(cur_date));
  pGP_SCUD_DOC_SP_O:=_pGP_SCUD_DOC_SP_O;
  TME:=Time(24,0,0,0);
  TMB:=Time(0,0,0,0);
  DTB_A:=DTB;
  DTE_A:=DTE;
  TME_A:=TME;
  TMB_A:=TMB;
  if TimeLog_Status>0
   timelog('GP_SCUD_EventsEdit->InitParam:_cGP_SCUD_Pers='+string(_cGP_SCUD_Pers,0,0)
            +',_DTB='+DatetoStr(_DTB,'DD/MM/YYYY - ')+', DTE='+DatetoStr(_DTE,'DD/MM/YYYY')   );
  if _cGP_SCUD_Pers<>0
  { pGP_SCUD_Pers_Prev:=pGP_SCUD_Pers;
    set pGP_SCUD_Pers:=_cGP_SCUD_Pers;
    if not BoundActive(tbByPers) PushBounds(tbByPers);
    ReReadRecord(#GP_SCUD_Events) ;
    if pGP_SCUD_Pers_Prev<>pGP_SCUD_Pers
    { if getlast GP_SCUD_EVENTS<>tsok {}
    }
  }
  //else
  if _cNrec>0
  { if getfirst GP_SCUD_Events where (( _cNrec == GP_SCUD_Events.Nrec)) <>tsok
    { Exit; }
    PositionChanged;
  }
  else
  if _cKatOrg<>0
  {

  }
  else
  if _cKatpodr<>0
  { set pKatPodr:=_cKatPodr;
    if not BoundActive(tbByKatPodr) PushBounds(tbByKatPodr);

  }
  if _NoVisual {}
  PositionChanged;
  isFilterRun:=false;
  if TimeLog_Status>0
    timelog('GP_SCUD_EventsEdit->InitParam:final');
  if (_wIntMode and cgiMultiEdit)>0
  { if _Cnrec>0
      RunWindowModal(wnEditEvents)
    else
      RunWindowModal(wnEventsPers)
  }

  Result:=True;
} //Function InitParam(



//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Events ;
cmSetDefault:
{ Exit;
}
cmInsert:
{ MyInsertEvents;
  PutCommand(cmEdit);
  Abort;
}
cmInsertRecord:
{ if GP_SCUD_Events.cStatus=0
  { GP_SCUD_Events.cStatus:=pStatus_DM[03];
  }
  Insert Current GP_SCUD_Events;
}
cmUpdateRecord:
{ if GP_SCUD_Events.cStatus=pStatus_DM[01]
    GP_SCUD_Events.cStatus:=pStatus_DM[03];
  Update Current GP_SCUD_Events;
}
cmDeleteRecord:
{ if message('Удаление события запрещено, аннулировать?',YesNo)=cmYes
  { set GP_SCUD_Events.cStatus:=pStatus_DM[04];
    update current GP_SCUD_Events;

  }
  //delete Current GP_SCUD_EventsEdit;
  Exit;
}
cmPositionChanged:
{ PositionChanged;
}
end; //GP_SCUD_EventsEdit


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      SetFilterBounds(0);
      if cRec>0
      { if getfirst GP_SCUD_Events where (( cRec == GP_SCUD_Events.nrec ))=tsok {}
      }

      ReScanPanel(#GP_SCUD_Events);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }

    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
      SaveParam;
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
      SaveParam;
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Events.Nrec;
        }
        CloseInterface(cmDefault)
      }
      else Putcommand(cmEdit);
    }
    //----------------------
    cmEdit:
    {  if GetCurrentFormat=brScudEvents
       or GetCurrentFormat=brEventsPers
       or GetCurrentFormat=brEventsPers01
         RunWindow(wnEditEvents);
    }
    //----------------------
    cmCheckField:
    { case CurField of
      #DTB,#DTE,#TMB,#TME:
      { if GetCurrentFormat<>scrFilter
        { CopyToA;
          MTRetrieve(#tmp_period,mfFilters + mfClear);//+mfClearFilters
          ReReadRecord(#GP_SCUD_Events);
        }
      }
      else
      { if CurTable=#GP_SCUD_Events
        { if GP_SCUD_Events.cStatus=0
          { set GP_SCUD_Events.cStatus:=pStatus_DM[3]
          }
          else
          if GP_SCUD_Events.cStatus=pStatus_DM[1]
          { set GP_SCUD_Events.cStatus:=pStatus_DM[2]
          }
        }

      }
      end;
    }
    //----------------------
    cmPick:
    { if IsProtect
      { if CurField<>#GP_Status.Name
        { Abort;
          Exit;
        }
      }
      case CurField of
      #GP_Status.Name:
      { if (StatusChange.PickStatus(GP_SCUD_Events.cStatus))
         {
            pTmp:=ChangeStatus(GP_SCUD_Events.NRec,StatusChange.StatusChangeLog);
            if PTmp<>0
            { set GP_SCUD_Events.cStatus:=StatusChange.StatusChangeLog.cStatusTo;
              update current GP_SCUD_Events;
              ClearFuncCache;
              SetEditMode(CanEditTbl);
            }
         }
      }
      //------------------------------
      #KatPodr.Name:
      { pTmp:= GP_SCUD_Events.cKatPodr;
        If (iGetKau.GetCodeKau(cgiPick,cgKau_KatPodr,pTmp) <> 0)
        { set GP_SCUD_Events.cKatPodr:=pTmp;
        }
      }
      //------------------------------
      #GP_SCUD_Pers.Fio:
      { if GP_SCUD_Events_Next.cStatus<>pStatus_DM[03]
        { message('Изменение доступно только для вручную добавленных записей ')
        }
        else
        { pTmp:=GP_SCUD_Events.cGP_SCUD_Pers;
          if RunInterface(GP_SCUD_PersVib,cgiPick,pTmp,0)<>cmCancel
          { set GP_SCUD_Events.cGP_SCUD_Pers:=pTmp;
            if getfirst GP_SCUD_Pers=tsok
            { set GP_SCUD_Events.cKatPodr:=GP_SCUD_Pers.cKatPodr;
              set GP_SCUD_Events.StrTabn:=GP_SCUD_Pers.Code;
            }
          }
        } //if GP_SCUD_Events_Next.cStatus<>pStatus_DM[03]
      } //#GP_SCUD_Pers.Fio:
      /*
      //------------------------------
      #KatOrg.Name:
      { pTmp:= GP_SCUD_Events.cKatOrg;
        If (iGetKau.GetCodeKau(cgiPick,cgKau_KatOrg,pTmp) <> 0)
        { set GP_SCUD_Events.cKatOrg:=pTmp;
        }
      }*/
      //------------------------------
      #Filtr_Katpodr:
      { //_PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;
        //CopyMarker(_PodrMArkerPointer,Marker_KatPodr);
        if RunInterface('GetPodaLN',12, Marker_KatPodr, 1)=cmDefault
        { //_PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;
          //CopyMarker(Marker_KatPodr,_PodrMArkerPointer);
          SetFilterNm(#Filtr_Katpodr);
          BitOnW(wFilter,1);
        }
      }
      //------------------------------
      #Filtr_KatOrg:
      { KauMarkerName := iGetKau.GetMarkerName(cgKau_KatOrg);
        StoreMarker(Marker_KatOrg,KauMarkerName);
        If (iGetKau.GetCodeKau(cgiPickMult,cgKau_KatOrg,Comp(0)) <> 0)
        { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
          CopyMarker(Marker_KatOrg,Marker_Tmp);
          DoneMarker(Marker_Tmp,'');
          SetFilterNm(#Filtr_KatOrg);
          BitOnW(wFilter,2);
        }
      }
      //------------------------------
      #Filtr_GP_SCUD_Pers:
      { if RunInterFace(GP_SCUD_PersVib,cgiPickMult,pTmp,Marker_GP_SCUD_PERS)<>cmCancel
        { SetFilterNm(#Filtr_GP_SCUD_PERS);
          BitOnW(wFilter,2);
        }

      }
      end;
      ReScanPanel(#GP_SCUD_Events);
    } //cmPick
    //----------------------
    cmDelOnProtect:
    { Case Curfield of
      //------------------------------
      #Filtr_KatPodr:
      { ClearMarker(Marker_KatPodr);
        BitOffW(wFilter,1);
        SetFilterNm(#Filtr_KatPodr);
      }
      //------------------------------
      #Filtr_KatOrg:
      { ClearMarker(Marker_KatOrg);
        BitOffW(wFilter,2);
        SetFilterNm(#Filtr_KatOrg);
      }
      //------------------------------
      #Filtr_GP_SCUD_Pers:
      { ClearMarker(Marker_GP_SCUD_Pers);
        BitOffW(wFilter,3);
        SetFilterNm(#Filtr_GP_SCUD_Pers);
      }
      end;
    }
    cmPrintDoc: PrintRep;
    cmValue20:
    { Marker_Tmp  :=InitMarker('', 8, 50, 10, True);
      UpdateTable;
      StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Подготовка фильтров для отчета',0);
      if pMarker.Count>0
      { PushPos(#GP_SCUD_Events);
        SubBounds(tbRmGP_SCUD_Events1);
        AddBounds(tbRmGP_SCUD_Events2);
        _Loop pMarker
        { if not NextVisual break;
          InsertMarker(Marker_Tmp,pMarker.pNRec )
        }
        SubBounds(tbRmGP_SCUD_Events2);
        AddBounds(tbRmGP_SCUD_Events1);
        PopPos(#GP_SCUD_Events);

      }
      else
      { if message('Напечатать только текущую запись?'
          +chr(13)+'если нет, то все по установленному фильтру(долго)',YesNo)=cmYes
        { InsertMarker(Marker_Tmp,GP_SCUD_Events.Nrec )
        }
        else
        { PushPos(#GP_SCUD_Events);
          _Loop GP_SCUD_Events
          { if not NextVisual break;
            InsertMarker(Marker_Tmp,GP_SCUD_Events.NRec )
          }
          PopPos(#GP_SCUD_Events);

        }
      } //if pMarker.Count>0
      ReScanPanel(#GP_SCUD_Events);
      StopVisual('',0);
      RunInterface(GP_SCUD_REPORT,GetTypeDoc,0,Marker_KatPodr,Marker_Tmp,DTB,DTE,0);
      DoneMarker(Marker_Tmp,'');
    }

    //--------------------------
    cmPickClass:// внешние классификаторы
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Events: RunInterface('ExClassifier', coGP_SCUD_Events, GP_SCUD_Events.nRec);
      end;
    }
    //--------------------------
    cmFilterSave:
    { UpdateTable;
      if RunWindowModal(wnFilter)=cmDefault
      { SetFilterBounds(0);
      }
      else RestFromA
    }
    //--------------------------
    cmPickAttr:// внешние аттрибуты
    {
      if UpdateTable
      case CurTable of
      #GP_SCUD_Events: RunInterface('Attribute', coGP_SCUD_Events, GP_SCUD_Events.nRec);
      end;
    }
    //--------------------------
    cmHotKeys:
    {
      case CurTable of
      #GP_SCUD_Events:
      { ProcessCommand(RunMenu('GP_SCUD_EventsEditEdit_Main_HotKey'));
      }
      end;
    }
  end;
end.

GP_SCUD_EventsEditEdit_Main_HotKey Menu
{
- 'Фильтр на данные'       , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Печать реестра событий' , cmPrintDoc  , 'Печать', hcProc_NagrKaf, 'Ctrl+P'  ,kbCtrlP, scMenuCtx;
- 'Отчеты по СКУДУ '       , cmValue20   , 'Печать', hcProc_NagrKaf, 'Alt+P'   ,kbAltP , scMenuCtx;
- 'Внешняя классификация'  , cmPickClass , 'Внешняя классификация', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
- 'Внешние атрибуты'       , cmPickAttr  , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}

GP_SCUD_EventsEditEdit_Main_HotKey_Wn Menu
{
- 'Печать реестра событий' , cmPrintDoc  , 'Печать', hcProc_NagrKaf, 'Ctrl+P'  ,kbCtrlP, scMenuCtx;
//- 'Отчеты по СКУДУ '       , cmValue20   , 'Печать', hcProc_NagrKaf, 'Alt+P'   ,kbAltP , scMenuCtx;

}
