function isFilterAnCorrect(ww_nrec:comp): boolean;forward;
Function GetPlanTime(_pScud_Events:comp;_DT:date ):time;forward;
Function GetMisConDuct(_pScud_Events:comp;_Plan_time:time;_DT:date;_tp:word=0):word;Forward;
Function GetNextEventsTime(ww_nrec:comp):string;Forward;
Function GetDiffTime(ww_nrec:comp; _Plan_time:time):time;Forward;
Function GetEndBreak1(D:word):time;Forward;
//----------------------------------------
Table Struct tmp_period
(   EventDate:date  "Дата события"
  , EventTmB :time  "Время события с"
  , EventTmE :time  "Время события по"
  , PlanTime :time  "Плановое время"
  , wType    :word  "1-личные невыходы,2-служебные,3-прочие"
  , cGP_SCUD_PERS:comp
  , cStatement :comp //ссылка на заявление
)
with index
( tmp_period01 = cGP_SCUD_PERS+ EventDate + EventTmB
);

//--- для регистрации событий по приказу
Table Struct tmp_period_Order
(   EventDate:date //   : date "Дата события"
  , EventTmB :time //  : time "Время события с"
  , EventTmE :time //  : time "Время события по"
  , cGP_SCUD_PERS:comp
  , wType    :word //  GP_iSC_OrderOver               = 1014;//Приказ на сверхурочные
                   //  GP_iSC_OrderOver2              = 1015;//Приказ на оплату переработки
                   //  GP_iSC_OrderHoliday            = 1016;//Приказ на работу в выходной день
  , diff:double
  , wOpl:word  //1 - за отгул, иначе за оплату
)
with index
( tmp_period01 = cGP_SCUD_PERS+ wType + EventDate + EventTmB
);

//----------------------------------------
// Рабочие периоды
Table Struct tmp_period_work =tmp_period;

//------- Для отчетов
Table struct tmp_Rep_Vib
(  cGP_Scud_Pers :comp
  ,cLschet:comp
  ,cPersons:comp
  ,Fio     :string[100]
)
with index
( tmp_Rep_Vib01 = cGP_Scud_Pers
 ,tmp_Rep_Vib02 = cLschet
);

Table Struct tmp_Rep_Ev
(  FIO:string[50] "Сотрудник (Посетитель)"
  ,cGP_Scud_Pers:comp
  ,EnterDate:date "Дата"
  ,PlanTime:time "Начало/окончание рабочего дня"
  ,EnterTime:time "Время"
  ,Podr_Kod:string[20] "Подразделение"
  ,Post :string[100]
  ,Event_Type:string[150]  "Событие"
  ,wResource :word "Ресурс устройства"
  ,Areal:string[100] "Помещение"
  ,Zauv:string[100]  "Наличие контрольной карты"
  ,ColorEV  :longint
  ,Diff     :time
  ,MisConDuct:string[50]
)
With index
( tmp_Rep_Ev01 =Fio+cGP_Scud_Pers+EnterDate+EnterTime
);

table struct tAgileCache (cEvent: comp, PlanTime: time, DiffColor: longint, wMisConduct: word, absenseTime: time) (i1 = cEvent(unique));
table struct tAgileCacheDay (cScudPers: comp, eventDate: date, startWork: time, endWork: time, workTime: time, dinnerTime: time, absenseTime: time, planStartWork: time, planEndWork: time, planWorkTime: time, planDinnerTime: time) (i1 = cScudPers + eventDate);

