var
  cRec    :Comp   ; // ссылка на группу
  oGP_Log : GP_LOG;
  pMarker:IMarker(Marker) new;
  Marker:longint;
  iCatFunc            : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  //-----------------------------------
  iGP_SCUD_ExClusionPeriod  :GP_SCUD_ExClusionPeriod; // Проверить периоды
  iGP_SCUD_StateMentOnAbsent:GP_SCUD_StateMentOnAbsent;//
  iGP_SCUD_SaldoEdit :GP_SCUD_SaldoEdit;
  iGP_SCUD_EV_AllEdit:GP_SCUD_EV_AllEdit; //посмотреть все события скуд
  iQBuilder:GP_QueryBuilder new;
  pStatus_DM: Array [1..4] of comp;
   //'01','СКУД');
   //'02','СКУД, корректировка');
   //'03','Добавлен вручную',True);
   //'04','Исключено из учета');
  //--------------------------------------------------
  //-- ДЛЯ РАСЧЕТОВ
  wYearRas,wMonthRas :word;
  Calc_Rejim:boolean;
  //------------------------------
  pGP_SCUD_SALDO    :TGP_SCUD_SALDO;//для обмена всей информацией и сохранения в сальдо
  // из графика         //---- статусы
  pGRAFF_WorkPeriod :TGRAFF_WorkPeriod;//период работ
  pGP_SCUD_DOC_SP_O:comp; // ссылка на входящий приказа
  //------------------------
  pGP_SCUD_S_D: TGP_SCUD_S_D ;// дополнительные массивы

  //------------------------
  Calc_Date     :date;// День расчета
  //----------- остатки
  //Ost_Over:tSumma;Ost_Over2:tSumma; Ost_Holiday:tSumma; - все в pGP_SCUD_Saldo.
  boLoadZar:boolean;//признак загрузки функций по работе с табелем
  //-- ДЛЯ РАСЧЕТОВ
  //--------------------------------------------------
  #include Excel_Var.Vpp
  //--------------------------------------------------
  // -- VA
  pVA_SalScale_TMB :comp; // Время начала отклонения
  pVA_SalScale_TME :comp; // Время окончания отклонения

  //-- Настройки
  UP_ZAR_WT_PROTECTUPTODATE:date;//Управление персоналом \ Табельный учет \ Формирование \ Окончание диапазона защиты табелей от обновления
  NPOEM_OWN_SCUD_Vactions_Control:word;// Настройки НПО Энергомаш \ СКУД \Способ ограничения работы в выходной день "
  NPOEM_OWN_SCUD_DELAY_ALLOW     :word;//', 'Считать опозданием при входе позже времени начала графика, секунд
  tNPOEM_OWN_SCUD_DELAY_ALLOW    :time;
  NPOEM_OWN_SCUD_OVER2_Type      :word;//', 'Способ расчета переработки
  NPOEM_OWN_SCUD_ZAbsent_STATUS_M:comp;//'Статус "утвержден" в заявлении на отсутствие'
  NPOEM_OWN_SCUD_Pers_Other      :boolean;//'Отображать сторонних лиц
  DatOtch      : date; // dGetTune('UP.DATOTCH');
  DatOtch_Next : date; // Add_Month(DatOtch,1);
  //-- Настройки
  //--------------------------------------------------

  // для информации по режиму
  StartWorkDay,EndWorkDay,
  StartBreak1,EndBreak1,
  StartBreak2,EndBreak2,
  StartShift2,EndShift2:time;
  Graf_Time  :time;
  //-- пометка подразделения
//-----------------------------------------
// Фильтры
//-----------------------------------------
   wFilter:word;
   Marker_Count :longint;
    wc_nrec : comp;//  - var_name, тип должен совпадать с типом маркера
   KauMarkerName:string;
   Marker_Tmp :longint;

   #mrkfld_(KatPodr)
   #mrkfld_(KatOrg)
   #mrkfld_(GP_SCUD_Pers)


   sFio_Flt      ,sFio_Flt_A       : string;
   sPropusk_Flt  ,sPropusk_Flt_A   : string;
   wType_Flt     ,wType_Flt_A      : word;
//----------------------------------------
Create View
var
   pGP_SCUD_Pers :comp;
   pGP_SCUD_Pers_Prev:comp;
   pKatOrg :comp;
   pKatPodr :comp;
   DTB,DTE,DTB_A,DTE_A:date;
   TMB,TME,TMB_A,TME_A:time;

as select GP_SCUD_Events.Nrec
,  if(Calc_Rejim,wYearRas ,year (GP_SCUD_Events.EnterDate)) (FieldName=wYear)
,  if(Calc_Rejim,wMonthRas,month(GP_SCUD_Events.EnterDate)) (FieldName=wMonth)
//вроде не нужно,  if(Calc_Rejim,Calc_Date,GP_SCUD_Events.EnterDate)        (FieldName=dRas)
//,  GetRejimDay(GP_SCUD_Events.cGP_SCUD_Pers
//     ,GP_SCUD_Events.EnterDate) (FieldName=wRejim)

, GetPlanTime(GP_SCUD_Events.Nrec,GP_SCUD_Events.EnterDate) (FieldName=Plan_Time)
, GetMisConDuct(GP_SCUD_Events.Nrec,Plan_Time,GP_SCUD_Events.EnterDate) (FieldName=wMisConDuct_V)
, iGP_SCUD_MisConDuctEdit.GetMisConDuctTypeName(wMisConDuct_V) (FieldName=sMisConDuct)
, GetNextEventsTime(GP_SCUD_Events.Nrec) (Fieldname=Next_Event)
/*
, IF(Plan_Time=ZeroTime,ZeroTime,If(Plan_Time<=GP_SCUD_Events.EnterTime
     ,Sub_Time(GP_SCUD_Events.EnterTime,Plan_Time)
     ,Sub_Time(Plan_Time,GP_SCUD_Events.EnterTime)
     ))   (FieldName=Plan_Diff)
*/
, GetDiffTime(GP_SCUD_Events.Nrec,Plan_Time) (FieldName=Plan_Diff)
From
  GP_SCUD_Events
, GP_SCUD_Events GP_SCUD_Events_Next
, GP_SCUD_Events GP_SCUD_Events_Prev
, GP_SCUD_Events GP_SCUD_Events_Free
//--------- Заявление на отсутствие
, GP_SCUD_DOC_SP GP_SCUD_DOC_SP_A
, GP_SCUD_DOC    GP_SCUD_DOC_A
, GP_Status      GP_Status_A
, GP_SCUD_Reason GP_SCUD_Reason_A
//------------------------
, GP_SCUD_Pers
, GP_SCUD_Pers_Hist(GP_SCUD_PERS_HIST08)
//-----------------------
, KatOrg
, Katpodr
, GP_SCUD_MisConDuct
, GP_SCUD_MisCon_D
, tmp_period
, tmp_period_work
, tmp_period_work tmp_period_work_d
, tmp_period_Order

//-------- для хранения нарушений при расчете
, Tmp_Scud_MisConDuct
, Tmp_Scud_MisConDuct Tmp_Scud_MisConDuct_F
//--------- исключения периодов
, tmp_ExClusPeriod
//------- для формирования приказов
, tmp_scud_order_new
//-------- для отчетов
, tmp_Rep_Ev(tmp_Rep_Ev01)
, tmp_Rep_Vib
//------- фильтры
 , KatPodr    KatPodr_Flt
 , KatOrg     KatOrg_Flt
 , GP_SCUD_Pers    GP_SCUD_Pers_Flt
 , tAgileCache, tAgileCache tAgileCache2
 , tAgileCacheDay
where ((
      DTB_A <<= GP_SCUD_Events.EnterDate
and   DTE_A >>= GP_SCUD_Events.EnterDate
and ((DTB_A < GP_SCUD_Events.EnterDate
      or  TMB_A<= GP_SCUD_Events.EnterTime)
     and (DTE_A > GP_SCUD_Events.EnterDate
          or  TME_A>= GP_SCUD_Events.EnterTime or TME_A=ZeroTime)
   )
and GP_SCUD_Events.cGP_SCUD_Pers /== GP_SCUD_Pers.Nrec
and GP_SCUD_Pers.Nrec  == tmp_period.cGP_Scud_Pers
and GP_SCUD_Pers.Nrec  == tmp_period_order.cGP_Scud_Pers
//----------------------- нарушения
and  GP_SCUD_Pers.Nrec  == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
and  GP_SCUD_Pers.Nrec  == Tmp_Scud_MisConDuct_F.cGP_SCUD_PERS
and  Tmp_Scud_MisConDuct.cGP_SCUD_PERS  == GP_SCUD_MisCon_D.cGP_Scud_Pers
and  Tmp_Scud_MisConDuct.YearN          == GP_SCUD_MisCon_D.YearN
and  Tmp_Scud_MisConDuct.MesN           == GP_SCUD_MisCon_D.MesN
and  Tmp_Scud_MisConDuct.DT_Ev          == GP_SCUD_MisCon_D.DT_Ev
and  Tmp_Scud_MisConDuct.TM_Ev          == GP_SCUD_MisCon_D.TM_Ev
and  Tmp_Scud_MisConDuct.wMisConDuct    == GP_SCUD_MisCon_D.wMisConDuct(noindex)


and GP_SCUD_Pers.cGp_Scud_Kateg == Gp_Scud_Kateg.Nrec
and GP_SCUD_Events.cKatPodr == Katpodr.Nrec
and GP_SCUD_Events.cArea == GP_SCUD_AREAS.Nrec // копия таблицы из скуда
//and GP_SCUD_Events.cKatOrg  == KatOrg.Nrec
and GP_SCUD_Events.cStatus  == GP_Status.Nrec
and GP_SCUD_Events.cControler  == GP_SCUD_Controler.Nrec
//and GP_SCUD_Events.cGP_SCUD_Pers == GP_SCUD_Pers_Hist.cGP_SCUD_Pers
and GP_SCUD_Pers.Nrec == GP_SCUD_Pers_Hist.cGP_SCUD_Pers
//and GP_SCUD_Pers.Fio == GP_SCUD_Pers_Hist.Fio // надо индекс добавить
and Calc_Date   >>= GP_SCUD_Pers_Hist.DTIZM
//Заявление на отсутствие
and GP_SCUD_Events.cGP_SCUD_Pers == GP_SCUD_DOC_SP_A.cGP_SCUD_Pers
and GP_iSC_statement_on_absence  == GP_SCUD_DOC_SP_A.wType(Noindex)
and GP_SCUD_Events.EnterDate     == GP_SCUD_DOC_SP_A.EventDate
and (  GP_SCUD_Events.EnterTime>= GP_SCUD_DOC_SP_A.EventTMB // будет ловить все.
   and Sub_Time(GP_SCUD_Events.EnterTime,time(0,1,0,0))<= GP_SCUD_DOC_SP_A.EventTME
   )
and GP_SCUD_DOC_SP_A.cGP_SCUD_DOC == GP_SCUD_DOC_A.Nrec
and GP_SCUD_DOC_A.cStatus == GP_Status_A.nrec
and GP_SCUD_DOC_A.cReason == GP_SCUD_Reason_A.Nrec
// следующая запись
and GP_SCUD_Events.cGP_SCUD_Pers == GP_SCUD_Events_Next.cGP_SCUD_Pers
and GP_SCUD_Events.EnterDate <<= GP_SCUD_Events_Next.EnterDate
and Add_Day(GP_SCUD_Events.EnterDate,1)>>=GP_SCUD_Events_Next.EnterDate
and ( (GP_SCUD_Events.EnterDate < GP_SCUD_Events_Next.EnterDate
     or GP_SCUD_Events.EnterTime<GP_SCUD_Events_Next.EnterTime
     ) and GP_SCUD_Events_Next.cStatus<>pStatus_DM[04]
  )
// предыдущая запись
and GP_SCUD_Events.cGP_SCUD_Pers == GP_SCUD_Events_Prev.cGP_SCUD_Pers
and GP_SCUD_Events.EnterDate >>= GP_SCUD_Events_Prev.EnterDate
and Sub_Day(GP_SCUD_Events.EnterDate,1)<<=GP_SCUD_Events_Prev.EnterDate
and ( (GP_SCUD_Events.EnterDate > GP_SCUD_Events_Prev.EnterDate
     or GP_SCUD_Events.EnterTime>GP_SCUD_Events_Prev.EnterTime
     ) and GP_SCUD_Events_Prev.cStatus<>pStatus_DM[04]
  )
//Для подсчета плана часов
//нарушения
and wMisConDuct_V == GP_SCUD_MisConDuct.wType
//------- фильтры
and wc_nrec == KatPodr_Flt.Nrec
and wc_nrec == KatOrg_Flt.Nrec
and wc_nrec == GP_SCUD_Pers_Flt.Nrec

))
Bounds byGP_SCUD_Pers  pGP_SCUD_Pers == GP_SCUD_Events.cGP_SCUD_Pers(noindex) ordered by TableOrder
Bounds byGP_SCUD_PersM pGP_SCUD_Pers == GP_SCUD_PERS.Nrec

//Bounds byKatOrg  pKatOrg  == GP_SCUD_Events.cKatOrg (noindex) ordered by TableOrder
Bounds byKatPodr pKatPodr == GP_SCUD_Events.cKatPodr(noindex) ordered by TableOrder
//Bounds byType    wType_Flt== GP_SCUD_Events.wType   (noindex) ordered by TableOrder
Bounds ByPers pGP_SCUD_Pers == GP_SCUD_Events.cGP_SCUD_Pers//(noindex)
    and  DTB_A <<= GP_SCUD_Events.EnterDate
and   DTE_A >>= GP_SCUD_Events.EnterDate
and ((DTB_A < GP_SCUD_Events.EnterDate
      or  TMB_A<= GP_SCUD_Events.EnterTime)
     and (DTE_A > GP_SCUD_Events.EnterDate
          or  TME_A>= GP_SCUD_Events.EnterTime or TME_A=ZeroTime)
   )

condition FilterAn = // использование сложного фильтра
  (isFilterAnCorrect(GP_SCUD_Events.Nrec))
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;

//***********************************************
create view vSpr
var
  pKateg :comp;
as select Gp_Scud_Kateg.wType
From Gp_Scud_Kateg
where
(( pKateg==Gp_Scud_Kateg.Nrec
));

//***********************************************
create view vKatPodr
var pKatPodr:comp;
as select KatPodr.Name
From KatPodr
where ((
  pKatPodr == KatPodr.Nrec
));
//***********************************************
create view vPersons
var
  pPersons:comp ;
as select
  Persons.Nrec
from
   Persons, Appointments
  ,Catalogs CatPost
where
((  pPersons == Persons.Nrec
and if(Persons.AppointCur=0,Persons.AppointLast,Persons.AppointCur) == Appointments.Nrec
and Appointments.Post == CatPost.Nrec

))
;//create view vPers

create view vGP_SCUD_Pers
var
  pGP_SCUD_Pers:comp;
From
  GP_SCUD_Pers
where
(( pGP_SCUD_Pers == GP_SCUD_Pers.Nrec
));

//***********************************************
//-------------------------------------
//---- Для поиска по табелю
//-------------------------------------
create view vTabel
var pPersons:comp;
    wRejim  :word;
    wYear   :integer;
    wMonth  :integer;
    dtEvent :date;
    DtBeg   :date;
    DtEnd   :date;
//    dRas    :date;
as select Klndr.nrec,GP_KlndrExt.nrec
From
//-- табель
  KLNDR
, GP_KlndrExt
, Lschet
, LsTab
, Perexod
, KlRejim
, GP_TIMETABLE (GP_TIMETABLE02)
// 92 РПД - работа во время отпуска
// ContDoc.WDop=1 - смена режима, 0 - сокращение дня.
, ContDoc
, InfPsn1//..cPers cRef2
// 91 РПД - Время кормления ребенка
, ContDoc ContDoc91
, UOWrkTabel UO_91


where
((
   pPersons == Lschet.tPerson
and (3 <> Lschet.Sovm //// не будем смотреть по совместителям
   and (Lschet.DatUV=ZeroDate or Lschet.DatUV>=Date(1,wMonth,wYear))
//пока не будем - а вдруг повторный прием на тот же ЛС
//  and (Lschet.DatPos<Add_month(Date(1,wMonth,wYear),1))
   ) // не будем смотреть по совместителям
// табель
and Lschet.Nrec == LsTab.cLschet
and wYear  == LsTab.YearN
and wMonth == LsTab.MesN
// корректировочный табель
and Lschet.Nrec == GP_TIMETABLE.cLschet
and wYear  == GP_TIMETABLE.YearN
and wMonth == GP_TIMETABLE.MonthN
//---------------------
and wRejim  == KLNDR.Rejim
and wYear   == Klndr.YearK
and wMonth  == Klndr.MonthK
//---------------------
and wRejim  == GP_KlndrExt.Rejim
and wYear   == GP_KlndrExt.YearK
and wMonth  == GP_KlndrExt.MonthK
//----------------------
and wRejim  == KlRejim.Rejim

//---- переходы
and Lschet.Nrec == Perexod.CLSCH
and dtEvent>>=Perexod.DatIzm
and (  (Perexod.Flags2 and 16)>0 //pchRejim=16 - 5 бит,а 1000b=8 - 4 бит,
  and  ( Perexod.DATOK=ZeroDate
        or Perexod.DATOK>=dtEvent//dRas//GP_SCUD_Events.EnterDate
       )
   and (
     //   (month(Perexod.DatIzm)=wMonth
     //and year(Perexod.DatIzm)=wYear
        (DtBeg<=Perexod.DatIzm
     and DtEnd>=Perexod.DatIzm
        )
        //если вдруг временный начался в прошлом месяце
        or
        (month(Perexod.DatOk)=wMonth
     and year(Perexod.DatOk)=wYear
        )
     )
  )
//--- Корзина следующего периода с изменением периода
and Lschet.Nrec == ZarSignal.CLSCHETZPL
and 'И'         == ZARSIGNAL.WORD4_M(noindex)
and DtBeg  <<= ZARSIGNAL.DATE1(noindex)
and dtEvent>>= ZARSIGNAL.DATE1(noindex)
//--- 92 РПД -----------------------
and pPersons == ContDoc.PERSON
and 92       == ContDoc.TypeOper
and dtEvent  >>=ContDoc.Dat1(Noindex)
and dtEvent  <<=ContDoc.Dat2(Noindex)
//ContDoc.wDop=0
and ContDoc.nRec == infPsn1.cPers
and comp(skkRPD92) == InfPsn1.cRef2
//--- 91 РПД ----------------------
and pPersons == ContDoc91.PERSON
and 91       == ContDoc91.TypeOper
and 0              == SalScale.wTblCode
and ContDoc91.NRec == SalScale.cUnit
and comp(SalScale.LastUser) == UO_91.Nrec

//  and ContDoc.cNew1 == KlRejim.NRec
));



//***********************************************
//---------------------------
Procedure MyInsertEvents;
{  //if (wIntMode and cgiNotEdit)>0 exit;
  //if isFilterRun exit;
  timelog('GP_EventsEdit->cmInsert:pStatus_DM[03]='+string(pStatus_DM[03],0,0));
  ClearBuffer(#GP_SCUD_Events);
  GP_SCUD_Events.cStatus:=pStatus_DM[03];

  if BoundActive(tbbyKatPodr)
    GP_SCUD_Events.cKatPodr:=pKatPodr;
  GP_SCUD_Events.EnterDate:=Cur_date;
  if GP_SCUD_Events.EnterDate<DTB_A and DTB_A<>ZeroDate
    GP_SCUD_Events.EnterDate:=DTB_A;
  if GP_SCUD_Events.EnterDate>DTE_A and DTE_A<>ZeroDate
    GP_SCUD_Events.EnterDate:=DTE_A;
  GP_SCUD_EVENTS.WRESOURCE:=1;
  if DTB_A=DTE_A
  if getlast GP_SCUD_Events_Prev=tsok
  { if GP_SCUD_Events_Prev.EnterDate=GP_SCUD_Events.EnterDate
    { GP_SCUD_EVENTS.WRESOURCE:=1-GP_SCUD_EVENTS_Prev.WRESOURCE

    }

  }

  if BoundActive(tbbyGP_SCUD_Pers)
  or BoundActive(tbbyGP_SCUD_PersM)
  or BoundActive(tbByPers)
  or IsBitCtW(wFilter,2)
  { set GP_SCUD_Events.cGP_SCUD_Pers:=pGP_SCUD_Pers ;
    if getfirst GP_SCUD_Pers=tsok
      GP_SCUD_EVENTS.STRTABN:=GP_SCUD_Pers.Code;
  }
  else
  { set GP_SCUD_Events.cGP_SCUD_Pers:=0;
  }
  set GP_SCUD_Events.EnterTime:=Cur_time;

  insert current GP_SCUD_Events;
  SetNew(false);
}

