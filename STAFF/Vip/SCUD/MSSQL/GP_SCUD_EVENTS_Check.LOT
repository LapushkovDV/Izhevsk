#IFDEF _SELE_
SQL
select
GP_SCUD_EV_ALL.SNPP,GP_SCUD_EV_ALL.NPP
,GP_SCUD_EV_ALL.ENTERDATE,GP_SCUD_EV_ALL.ENTERTIME
,SubString(GP_SCUD_PERS.FIO,1,40)
//  SubString(GP_SCUD_PERS.FIO,1,40),Max(GP_SCUD_EV_ALL.wEvents_Type)
FROM GP_SCUD_EV_ALL
inner join GP_SCUD_AREAS on GP_SCUD_AREAS.Nrec  = GP_SCUD_EV_ALL.CAREA
 and (
   GP_SCUD_AREAS.ID_AREAS_TREE=1 //Неконтролируемая территория
or GP_SCUD_AREAS.ID_AREAS_TREE=125937 //Завод
or GP_SCUD_AREAS.ID_AREAS_TREE=1318780 //Отдел кадров
)
inner join GP_SCUD_Controler on GP_SCUD_Controler.Nrec = GP_SCUD_EV_ALL.cControler
           and GP_SCUD_Controler.wType<>1
inner join GP_SCUD_PERS on GP_SCUD_PERS.Nrec = GP_SCUD_EV_ALL.cGP_SCUD_PERS
Left outer join GP_SCUD_EVENTS on GP_SCUD_EVENTS.NPP=GP_SCUD_EV_ALL.NPP
where GP_SCUD_EV_ALL.SNPP<>'' and GP_SCUD_EV_ALL.WEVENTS_TYPE=1
and GP_SCUD_EVENTS.Nrec is NULL
//group by SubString(GP_SCUD_PERS.FIO,1,40)
order by SubString(GP_SCUD_PERS.FIO,1,40)
;
#ELSE
SQL
insert into GP_SCUD_EVENTS (
 NPP
,SNPP
,STRTABN
,NAME
,CGP_SCUD_PERS
,ENTERDATE
,ENTERTIME
,CARD
,CKATPODR
,WEVENTS_TYPE
,WRESOURCE
,CSTATUS
,CCONTROLER
,CAREA
)
select
 GP_SCUD_EV_ALL.NPP
,GP_SCUD_EV_ALL.SNPP
,GP_SCUD_EV_ALL.STRTABN
,GP_SCUD_EV_ALL.NAME
,GP_SCUD_EV_ALL.CGP_SCUD_PERS
,GP_SCUD_EV_ALL.ENTERDATE
,GP_SCUD_EV_ALL.ENTERTIME
,GP_SCUD_EV_ALL.CARD
,GP_SCUD_EV_ALL.CKATPODR
,GP_SCUD_EV_ALL.WEVENTS_TYPE
,GP_SCUD_EV_ALL.WRESOURCE
,GP_SCUD_EV_ALL.CSTATUS
,GP_SCUD_EV_ALL.CCONTROLER
,GP_SCUD_EV_ALL.CAREA

FROM GP_SCUD_EV_ALL
inner join GP_SCUD_AREAS on GP_SCUD_AREAS.Nrec  = GP_SCUD_EV_ALL.CAREA
 and (
   GP_SCUD_AREAS.ID_AREAS_TREE=1 //Неконтролируемая территория
or GP_SCUD_AREAS.ID_AREAS_TREE=125937 //Завод
or GP_SCUD_AREAS.ID_AREAS_TREE=1318780 //Отдел кадров
)
inner join GP_SCUD_Controler on GP_SCUD_Controler.Nrec = GP_SCUD_EV_ALL.cControler
           and GP_SCUD_Controler.wType<>1
inner join GP_SCUD_PERS on GP_SCUD_PERS.Nrec = GP_SCUD_EV_ALL.cGP_SCUD_PERS
Left outer join GP_SCUD_EVENTS on GP_SCUD_EVENTS.NPP=GP_SCUD_EV_ALL.NPP
where GP_SCUD_EV_ALL.SNPP<>'' and GP_SCUD_EV_ALL.WEVENTS_TYPE=1
and GP_SCUD_EVENTS.Nrec is NULL
//group by SubString(GP_SCUD_PERS.FIO,1,40)
order by SubString(GP_SCUD_PERS.FIO,1,40)
;

  #ENDIF