//--------------------------------------------
// пробиваем не используемые контролеры
//--------------------------------------------
// при импорте идет тип
SQL update GP_SCUD_Controler set GP_SCUD_Controler.wType=0 where wType>1 ;
//пробъем не учитываемые
SQL
update GP_SCUD_Controler set GP_SCUD_Controler.wType=1
//  select GP_SCUD_Controler.Name
from GP_SCUD_Controler
where (SubString(GP_SCUD_Controler.Name,1,2)='КБ'
or GP_SCUD_Controler.IP_ADDRESS='10.18.1.152'
or GP_SCUD_Controler.IP_ADDRESS='10.18.1.139'
or GP_SCUD_Controler.IP_ADDRESS='10.18.1.153'
or GP_SCUD_Controler.IP_ADDRESS='10.18.1.103'
or GP_SCUD_Controler.IP_ADDRESS='10.18.1.107'
or GP_SCUD_Controler.IP_ADDRESS='10.18.1.109'
or GP_SCUD_Controler.IP_ADDRESS='10.18.1.125'
or GP_SCUD_Controler.IP_ADDRESS='10.18.1.103'
)
and GP_SCUD_Controler.wType<>1
;
