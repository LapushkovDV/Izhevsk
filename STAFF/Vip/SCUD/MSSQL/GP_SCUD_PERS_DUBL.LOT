SQL select count(*) C,Max(GP_SCUD_PERS.Fio),GP_SCUD_PERS.Ext_KEY
From GP_SCUD_PERS
group by GP_SCUD_PERS.Ext_KEY
Having count(*) >1
;
*/
/*
SQL select GP_SCUD_PERS.Fio,PROPUSK_TO,cPersons,Persons.Fio from GP_SCUD_PERS
inner join Persons on Persons.Nrec = GP_SCUD_PERS.cPersons
  where EXT_KEY='1869242';
SQL select GP_SCUD_PERS.Fio,PROPUSK_TO,cPersons,Persons.Fio from GP_SCUD_PERS
left outer join Persons on Persons.Nrec = GP_SCUD_PERS.cPersons
  where EXT_KEY='1972492';
*/
/*
delete GP_SCUD_PERS where (( 000A0000000000C1h == cPersons ));
update GP_SCUD_PERS where (( 2814749767120580 == Nrec )) set  Ext_Key='1848181';//Захаров Владимир Владимирович
update GP_SCUD_PERS where (( 2814749767120740 == Nrec )) set  Ext_Key='1869246',PROPUSK_NMB:='518362';//Петров Андрей Александрович
update GP_SCUD_PERS where (( 2814749767119539 == Nrec )) set  Ext_Key='1503627',PROPUSK_NMB:='9648284';//Тарасов Алексей Александрович
update GP_SCUD_PERS where (( 2814749767118592 == Nrec )) set  Ext_Key='1869242_',PROPUSK_NMB:='9642931_';//Иванова Мария Николаевна
*/
