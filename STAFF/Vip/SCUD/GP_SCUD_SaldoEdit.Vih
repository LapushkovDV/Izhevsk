#ifndef __GP_SCUD_SaldoEdit__
#define __GP_SCUD_SaldoEdit__
#include GP_SCUD_Base.Vih

#component "GP_STAFF"
#doc
Сальдо часов в СКУД
#end

vipinterface GP_SCUD_SaldoEdit(GP_SCUD_BASE) Parameters
   (wIntMode:word
    ;cRec:comp
    ;Marker:longint
    )
  Licensed(free);
Public:
  Function  oGP_SCUD_Base.GetTypeDoc:word;
  Procedure oGP_SCUD_Base.LoadInterface(_boVisibleRun:boolean);


  Function InitParam(
  _wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
  _cNrec     : comp;  // ссылка на "Ведомость"
  _cPersons  : comp;   // выбранная запись
  _cKatpodr  : comp;   // выбранная запись
  _cKatOrg   : longint; // включить определенные форматы
  _DTB       : Date; //период просмотра
  _DTE       : Date; //период просмотра
  _NoVisual  : boolean=false //не перерисовывать экраны
  ) : boolean;

//---------------------------
// Получить сальдо на конец месяца
//---------------------------
Function GetSaldo(_cGP_SCUD_Pers:comp; _YearN:word; _MesN:word;_PrevMes:boolean;
  var _Over:tSumma;var _Over2:tSumma;var _Holiday:tSumma
  ;var _Over_Opl:tSumma;var _Over2_Opl:tSumma;var _Holiday_Opl:tSumma
  ;_boIns:boolean=true):boolean;
Function GetSaldoBuf(_cGP_SCUD_Pers:comp; _YearN:word; _MesN:word;_PrevMes:boolean;
                 var buf:Type$GP_SCUD_SALDO;_boIns:boolean=true):boolean;
Function SetSaldoBuf(buf:Type$GP_SCUD_SALDO):boolean;

Function GetDaysFromSum(w:double):longint;
Function GetHourFromSum(w:double):double;

end;
#end //GP_SCUD_SaldoEdit
