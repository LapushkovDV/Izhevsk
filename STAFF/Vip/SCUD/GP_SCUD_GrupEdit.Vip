#include marker.vih // описание объекта и объявление интерфейса
                    // marker c реализацией по умолчанию
#include GP_Protector.Vih
#include GP_UserAccessService.vih
#include GP_StatusAccessEdit.vih

#include GP_SCUD_GrupEdit.Vih
#doc
СКУД Группы сотрудников
#end
Interface GP_SCUD_GrupEdit 'СКУД Группы сотрудников' , EscClose;
Show At (,,70,20) ;
var
  cRec    :Comp   ; // ссылка на группу
  pMarker:IMarker(Marker) new;
  Marker:longint;
Create View
as select GP_SCUD_Grup.Nrec
From
  GP_SCUD_Grup
;
Parameters
  wIntMode
#doc
#end
,  cRec
#doc
 возвращаемый параметр
#end
,  Marker
#doc
 маркер пометки
#end
;

//*************************************************8
QuickChoice qcByCode
{
  AcceptField = GP_SCUD_Grup.Nrec;
  ViewField = GP_SCUD_Grup.Code;
  ViewField = GP_SCUD_Grup.Name;
  // только текстовый поля!
  SearchField = GP_SCUD_Grup.Code;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Grup.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
} //QuickChoice qcByCode
QuickChoice qcByName
{
  AcceptField = GP_SCUD_Grup.Nrec;
  ViewField = GP_SCUD_Grup.Name;
  ViewField = GP_SCUD_Grup.Code;
  // только текстовый поля!
  SearchField = GP_SCUD_Grup.Name;
  OnOpen : {
  }
  OnClose : {
    cRec := GP_SCUD_Grup.Nrec;
    if Marker<>0
    { InsertMarker(Marker,crec);
    }
  }
}//QuickChoice qcByName



//-----------------------------------------
// Получить наименование
//-----------------------------------------
Function GetGrupName(_pNrec:comp)   :string; cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Grup where
          (( _pNrec == GP_SCUD_Grup.nrec ))<>tsok exit;
  Result:=GP_SCUD_Grup.Name;
} //Function GetGrupName(_pNrec:comp)   :string; cacheable;

//-----------------------------------------
// Получить код
//-----------------------------------------
Function GetGrupCode(_pNrec:comp)   :string;cacheable;
{ Result:='';
  if getfirst fastfirstrow GP_SCUD_Grup where
          (( _pNrec == GP_SCUD_Grup.nrec ))<>tsok exit;
  Result:=GP_SCUD_Grup.Code;
} //Function GetGrupCode(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить тип
//-----------------------------------------
Function GetGrupType(_pNrec:comp)   :word;cacheable;
{ GetGrupType:=0;
  if getfirst fastfirstrow GP_SCUD_Grup where
          (( _pNrec == GP_SCUD_Grup.nrec ))<>tsok exit;
  Result:=GP_SCUD_Grup.wType;

} //Function GetGrupType(_pNrec:comp)   :string;cacheable;

//-----------------------------------------
// Получить наименования типа по коду
//-----------------------------------------
Function GetGrupTypeName(_wType:word)   :string;cacheable;
{ Result:='';
  case _wType of
  1: Result:='сотрудники предприятия ';
  2: Result:='внешние подрядчики';
  3: Result:='прочие';
  end;
} //Function GetGrupTypeName(_wType:word)   :string;cacheable;

//-----------------------------------------
// Получить Nrec группы по коду
//-----------------------------------------
Function GetGrupTypeNrec(_wType:word) :comp;
{ Result:=0;
  if getfirst fastfirstrow GP_SCUD_Grup where
          (( _wType == GP_SCUD_Grup.wType ))<>tsok exit;
  Result:=GP_SCUD_Grup.Nrec;

} //  Function GetKategTypeNrec(_wType:word) :comp;




//-----------------------------------------
// Вставить первоначальные значения
//-----------------------------------------
Procedure Ins_GP_SCUD_Grup(_Num:word);
{ ClearBuffer(#GP_SCUD_Grup);
  GP_SCUD_Grup.Code:=LpadCh(string(_Num),'0',3);
  GP_SCUD_Grup.Name:=GetGrupTypeName(_Num);
  GP_SCUD_Grup.wType:=_Num;
  Insert Current GP_SCUD_Grup;
} //Procedure Ins_GP_SCUD_Grup(_Num:word);


//---------------------------------------------
// Тип документа
//---------------------------------------------
Function GetTypeDoc:word;
{ Result:=GP_iSC_Group_Employees;//1002; //
}

//---------------------------------------------
// Загрузчик интерфейса
//---------------------------------------------
Procedure LoadInterface(_boVisibleRun:boolean);
{     inherited ::LoadInterface(_boVisibleRun);
      if (wIntMode and cgiPickMult)=cgiPickMult
      and boVisibleRun
      { DataProtector.ProtectedStatusCtx := sci1EscIns;
        pMarker.AutoSave := True;
        pMarker.LoadAuto := True;
        pMarker.StoreName := 'GP_SCUD_GrupdEdit';
        pMarker.Caption   := (' Отмечено [%d] ');
      }
      else  pMarker.Disable:=true;

      //===========================
      if (not UserAccessService.IsAdmin)
      { if wIntMode=0
        { //message('Вы не обладаете ролью Администратор.'#13'Редактирование запрещено.');
        }
        wIntMode:=wIntMode or cgiNotEdit
      }
      if wIntMode<>0
      { SetEditMode(false)
      }
      else
      { SetEditMode(True)
      }
} //Procedure LoadInterface(_wRunType:word);



Browse brGroupPers '' (,,sci178Esc);
Table GP_SCUD_Grup ;
recMarker=pMarker;
Fields
  GP_SCUD_Grup.Code        'Код' :[20],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Grup.Name        'Наименование' :[40],NoProtect,NoPickButton,NoDel;
  //GP_SCUD_Grup.Description 'Описание'     :[40],NoProtect,NoPickButton,NoDel;
  GP_SCUD_Grup.wType       'Тип' :[30], [List
     0 '-'
    ,1 'сотрудники предприятия'
    ,2 'внешние подрядчики'
    ,3 'прочие'
    ],Protect;

end;//Browse brGroupPers



//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table GP_SCUD_Grup ;
cmSetDefault:
{ ClearBuffer(#GP_SCUD_Grup);
}
cmInsertRecord:
{ Insert Current GP_SCUD_Grup;
}
cmUpdateRecord:
{ Update Current GP_SCUD_Grup;
}
cmDeleteRecord:
{ delete Current GP_SCUD_Grup;
}
end; //GP_SCUD_Grup


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    //-----------------------------
    cmInit:
    { LoadInterFace(true);
      if Marker<>0
        pMarker.ImportFrom(Marker)
      else
        pMarker.ImportFromName(pMarker.StoreName);
      if wIntMode=0
      { if getfirst GP_SCUD_Grup<>tsok
        { Ins_GP_SCUD_Grup(1);
          Ins_GP_SCUD_Grup(2);
          Ins_GP_SCUD_Grup(3);
        }
      } //if wIntMode=0
      if cRec>0
      { if getfirst GP_SCUD_Grup where (( cRec == GP_SCUD_Grup.nrec ))=tsok {}
      }
      ReScanPanel(#GP_SCUD_Grup);
    }
    //-----------------------------
    cmOnVipLoad:
    { LoadInterFace(false);
    }
    //-----------------------------
    cmDone:
    { UnLoadInterFace(true);
    }
    //-----------------------------
    cmOnVipUnLoad:
    { UnLoadInterFace(false);
    }
    //-----------------------------
    cmDefault:
    { if (wIntMode and cgiPick)>0
      {
        if (wIntMode and cgiPickMult)=cgiPickMult
        { if PMarker.Count=0
          { pMarker.Mark;
          }
          if Marker<>0
            pMarker.ExportTo(Marker);
          else
            pMarker.ExportToName(pMarker.StoreName);
        }
        else
        { set cRec:=GP_SCUD_Grup.Nrec;
        }
        CloseInterface(cmDefault)
      }
    }
  end;
end.
