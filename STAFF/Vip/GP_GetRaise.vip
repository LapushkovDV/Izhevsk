#component "GP_Staff"

#include GP_GetRaise.vih
interface GP_GetRaise;

var
  _raiseFilterMarker: TPtr;

create view
bounds byRaiseFilterMarker = root == TR.Nrec and (FoundMarker(_raiseFilterMarker, TR.Nrec))
;

parameters _raiseFilterMarker;

handleevent

  cmInit:
  {
    if inherited::handleevent(cmInit) = heAbort
      Abort;
    if _raiseFilterMarker != 0 and not BoundActive(tbByRaiseFilterMarker)
      AddBounds(tbByRaiseFilterMarker);
  }

end;

end.
