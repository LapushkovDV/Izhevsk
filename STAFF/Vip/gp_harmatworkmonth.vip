#include userreport.vih
#include AppointKps.vih
#include AppFuncs.vih // Функции работы с назначениями
#include CatFunc.vih  // Функции работы с каталогом
#include DateInterim.vih
#Include GP_WorkTable.Vih

interface gp_harmatworkmonth 'Параметры отчета' gray
Show at (,,43,5);

var AKPS: AppointKps;
    VAppFuncs: AppointmentsFunctions;
    ICatFunc: CatalogsFunctions;
    DateInterim: IDateInterimFunctions;
    _sDepartment:string;
    mDept: LongInt;
    dTabl: date;

Table Struct Sotr (
    NRec       : comp,
    Tabn       : string,
    Fio        : string,
    lsnrec     : comp,
    cPodr      : comp,
    appnrec    : comp,
    Podr_code  : string,
    Podr_name  : string,
    Post       : string,
    kps        : array [1..12] of string
)
    with index (
      ind0 = NRec
);

create view gp_harmatworkmonth

var
data_beg: date;
data_end: date;
counter: longint;
ExcelPath: string;

select *
from sotr
,appointments
where ((
      sotr.appnrec   == appointments.nrec
      ))
;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  data_beg, noprotect;
  data_end, noprotect;
   _sDepartment, protect, pickbutton;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    Период          .@@@@@@@@@@    .@@@@@@@@@@
    Подразделение   .@@@@@@@@@@@@@@@@@@@@@@@@@

    <.Сформировать.>

    >>
end;

procedure UpdateFiltersState;
{
  var SelCnt: LongInt;
  var cTemp: Comp;
  _sDepartment := '';
  SelCnt := GetMarkerCount(mDept);
  if SelCnt > 0 then
    if (SelCnt = 1) and GetMarker(mDept, 0, cTemp) then
      _sDepartment := ICatFunc.GetCatalogsName(cTemp);
    else
      _sDepartment := 'Выбрано подразделений: ' + String(SelCnt);
  ReReadRecord;
}

procedure FillSotr;
var hStr:longint;
    strdate:string;
{
  StartNewVisual( vtRotateVisual, vfTimer, 'Отбор сотрудников...', 0);

  strdate:=day(data_beg)+','+month(data_beg) +','+year(data_beg);

  delete all Sotr;


  hStr:=0;
  sqlAddStr(hStr,'select Persons.NRec             as nrec                    ');
  sqlAddStr(hStr,'     , Persons.StrTabn          as tabn                    ');
  sqlAddStr(hStr,'     , Persons.FIO              as fio                     ');
  sqlAddStr(hStr,'     , LSCHET.nrec              as lsnrec                  ');
  sqlAddStr(hStr,'     , cat.nrec                 as cPodr                   ');

  sqlAddStr(hStr,'from Persons                                                    ');
  sqlAddStr(hStr,'join lschet on lschet.tperson = persons.nrec and 0=lschet.sovm  ');
  sqlAddStr(hStr,'left join APPOINTMENTS app ON Persons.appointcur = app.nrec           ');
  sqlAddStr(hStr,'left join CATALOGS cat ON app.DEPARTMENT = cat.NREC              ');

  sqlAddStr(hStr,'where (Persons.disdate=0 or Persons.disdate>=#date('+strdate+')) ');
  sqlAddStr(hStr,'  and (lschet.datuv=0 or lschet.datuv>=#date('+strdate+')) ');


  if (sqlSelectIntoByName(hStr,tnSotr)<>tsok)
    message('Ошибка выполнения DSQL запроса при отборе сотрудников.',error);
  sqlFreeStr(hStr);


    _loop Sotr
  {
  if (_sDepartment <> '')
      if not FoundMarker(mDept, Sotr.cPodr) then delete current Sotr;
  }

    _loop Sotr
  {
    Set Sotr.appnrec := VAppFuncs.GetAppNRec_OnDate(sotr.NRec, cur_date);
    Update Current Sotr;

      _loop appointments
     {
       Set Sotr.podr_code :=ICatFunc.GetCatalogsCode(appointments.department);
       Set Sotr.podr_name :=ICatFunc.GetCatalogsName(appointments.department);
       Set Sotr.post      :=VAppFuncs.GetAppPost(appointments.nrec);
       Update Current Sotr;
     }
    var i:longint;
    for(i:= month(data_beg); i<=month(data_end); i:=i+1)
    {
       //message('for');
      //dTabl:=DateInterim.GetDateByMonth(date(1,i,year(data_beg)), i, 2);
      // message(dTabl);
      ResetWorkingTable;
     // message('ResetWorkingTable');
      if LoadWorkingTable(sotr.lsnrec, i, year(data_beg))=0
      {
        // message('LoadWorkingTable');
         kps[i]:=Akps.GetKpsSTR(WT_GetInsalubrity(Last_Day(data_beg))) ;
         //message('WT_GetInsalubrity');
         Update Current Sotr;
      }



    }
  }
 /* _loop Sotr
  {
     Set Sotr.appnrec := VAppFuncs.GetAppNRec_OnDate(sotr.NRec, data_sel);
     Update Current Sotr;

     _loop appointments
     {
       Set Sotr.shrnrec   :=appointments.staffstr;
       Set Sotr.podr_code :=ICatFunc.GetCatalogsCode(appointments.department);
       Set Sotr.podr_name :=ICatFunc.GetCatalogsName(appointments.department);
       Set Sotr.post      :=VAppFuncs.GetAppPost(appointments.nrec);
       Set Sotr.appus     :=VAppFuncs.GetWorkCondAppHist(appointments.nrec, data_sel);
       Update Current Sotr;
     }

     Set Sotr.lsUsl  :=Akps.GetKpsSTR(sotr.lscexdop);
     Set Sotr.appUsl :=AKps.GetKpsSTR(AKps.GetMainKPS(Sotr.appnrec));
     Update Current Sotr;

     _loop InfPsn3
     {
       Set Sotr.shrUsl :=Akps.GetKpsSTR(InfPsn3.cref1);
       Update Current Sotr;
     }

     _loop doplata where (( sotr.lsnrec == doplata.clsch
                        and 62 == doplata.vidopl
                        and (data_sel >= doplata.datann and (data_sel <= doplata.datok or 0=doplata.datok))
                          ))
     {
       set Sotr.lsdopl:=doplata.proc;
       Update Current Sotr;
     }

     _loop raise where ((    sotr.nrec==raise.person
                         and sotr.appnrec==raise.appoint
                         and comp(0001000000000574h)==raise.raisetype
                         and (data_sel>=raise.FROMDATE
                         and (data_sel<=raise.TODATE or 0=raise.TODATE)) ))
     {
       set Sotr.appdopl:=raise.sum;
       Update Current Sotr;
     }

      _loop raisests where ((    sotr.shrnrec==raisests.staffstr
                         and comp(0001000000000574h)==raisests.raisetype
                         and (data_sel>=raisests.DRBEG
                         and (data_sel<=raisests.DREND or 0=raisests.DREND)) ))
     {
       _loop raisealg
       {
         set Sotr.shrdopl:=raisealg.sum;
         Update Current Sotr;
       }
     }

  }   */

  StopVisual;

}

handleevent

cmInit:
{
   InitWorkingTable;
  data_beg:= data_end:= cur_date;
}

cmPick:
{
   case CurField of
    #_sDepartment:
      {
        DoneMarker(mDept, 'CatalogsMarker');
        RunInterface('Z_STAFFCAT::PickCatalog2', -11, 0, 100, 0);
        mDept := InitMarker('CatalogsMarker', 8, 30, 10);
        UpdateFiltersState;
      }
  end;
}

cmGo:
{

  if (data_end < data_beg)
  {
   message('Конечная дата меньше начальной!',error);
   stop; abort; exit;
  }
  if ((year(data_end)-year(data_beg))<>0)
  {
   message('Даты должны быть в пределах одного года!',error);
   stop; abort; exit;
  }


  FillSotr;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_harmatworkmonth.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  counter:= 3;

  _loop Sotr
  {
    counter++;
    xlsetcellstringvalue(Sotr.Tabn, counter, 1, counter, 1);
    xlsetcellstringvalue(Sotr.FIO , counter, 2, counter, 2);
    xlsetcellstringvalue(Sotr.podr_code, counter, 3, counter, 3);
    xlsetcellstringvalue(Sotr.podr_name, counter, 4, counter, 4);
    xlsetcellstringvalue(Sotr.post, counter, 5, counter, 5);
    xlsetcellstringvalue(Sotr.kps[1], counter, 6, counter, 6);
    xlsetcellstringvalue(Sotr.kps[2], counter, 7, counter, 7);
    xlsetcellstringvalue(Sotr.kps[3], counter, 8, counter, 8);
    xlsetcellstringvalue(Sotr.kps[4], counter, 9, counter, 9);
    xlsetcellstringvalue(Sotr.kps[5], counter, 10, counter, 10);
    xlsetcellstringvalue(Sotr.kps[6], counter, 11, counter, 11);
    xlsetcellstringvalue(Sotr.kps[7], counter, 12, counter, 12);
    xlsetcellstringvalue(Sotr.kps[8], counter, 13, counter, 13);
    xlsetcellstringvalue(Sotr.kps[9], counter, 14, counter, 14);
    xlsetcellstringvalue(Sotr.kps[10], counter, 15, counter, 15);
    xlsetcellstringvalue(Sotr.kps[11], counter, 16, counter, 16);
    xlsetcellstringvalue(Sotr.kps[12], counter, 17, counter, 17);
  }

  xlframecells(1+2+4+8+16+32, 2, 1, 1, 5, 1, counter, 17);
  xlframecells(2, 3, 1, 1, 4, 6, counter, 6);
  //xlframecells(2, 3, 1, 1, 4, 9, counter, 9);
  xlframecells(2, 3, 1, 1, 4, 17, counter, 17);

  StopVisual('',0);
  xlkillExcel;

}

end;
end.

VipInterface UserReport_harmatworkmonth Implements IUserReport;
Interface UserReport_harmatworkmonth;

Procedure Run;
Begin
  runinterface(gp_harmatworkmonth);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Условие труда на рабочем месте/КПС (помесячно)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по вредным условиям труда';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
