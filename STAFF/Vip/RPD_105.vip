#component "Z_StaffOrders"
#include MoneyRound.vih
#include RPD.vih

#doc
  Интерфейс приказа "Премии и ценные подарки"
#end


VipInterface RPD_105(RPD_Base_Raise)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base3.PrintRPD(typePrint: TPtr; fcEnter: word);
  procedure IRPD_Base.MyDel;
end;

Interface RPD_105 '' escclose;


view as
select *
         from GP_RaiseHistExt105
where
  ((RaiseHist.nrec == GP_RaiseHistExt105.cRaiseH
//and RaiseHist.cRaise == Raise.nrec
//and Raise.RaiseType  == RaiseCat.nrec
));
//******************************************************************************
// Окно содержимого приказа на назначение персональных надбавок
//******************************************************************************
Browse brwRaise105 'Назначение доплаты' (,, sci178Esc);
  show at (, 9,,17);
  table RaiseHist;
    Fields
  RaiseCat.Name     'Вид доплаты/надбавки', ('Вид доплаты/надбавки.', hcStaffRaiseType, sci1378Esc):[20], protect;
  RaiseHist.rHSum   'Сумма/процент доплаты/надбавки', ('Сумма/процент доплаты/надбавки', hcStaffRaiseSum): [13.3], noprotect,
    {Font = {BackColor = if (RaiseHist.rHSum <= 0, ColorNeed, 0)}};
  'Нац.валюта'      'Валюта', ('Валюта оплаты.', hcStaffRaiseCurr, sci1378Esc):[10] , protect;
  RaiseHist.dRec    'С даты', ('Дата, с которой установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered,
    {Font = {BackColor = if (RaiseHist.dRec = 0, ColorNeed, 0)}};
  RaiseHist.dDat2   'По дату', ('Дата, по которую установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered,
    {Font = {BackColor = if (RaiseHist.dDat2 = 0, ColorNeed, 0)}};
end;   //  brwRaise



//******************************************************************************
// Процедура удаления своих записей, привязанных у удаляемому приказу
//******************************************************************************
Procedure MyDel;
{
  _loop RaiseHist
  {
    delete all from GP_RAISEHISTEXT105 where ((RaiseHist.Nrec == GP_RaiseHistExt105.cRaiseH));
  }
  inherited::MyDel;
}



//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  var sTitle:string;
  inherited::EnableDisable;

  cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
  cfsGetProp('WHATISINORDER',cfpTitle, sTitle);
  cfsSetProp('WHATISINORDER',cfpTitle, replace(sTitle,'Приказ','Список'));
  cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер списка');
  cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата списка');
  if fnFieldsOpen // не утвержден
  {
    SetHelpAndStatusContext(brwRaise105, -1, sci178Esc, 'StaffWinPr');
  }
  else //утвержден
  {
    SetHelpAndStatusContext(brwRaise105, -1, sci1Esc, 'StaffWinPr');
  }
}

//******************************************************************************
// Печать приказа
//******************************************************************************

procedure PrintRPD(typePrint: TPtr; fcEnter: word);
{
  case typePrint of
    0:
    {
      RunInterface('GP_Staff::GP_NFormRD105', TitleDoc.Nrec, PartDoc.TypeOper);
    }
  end;
}

//Проверяет на валидность данные в записи RaiseHist
function RaiseHistIsValid(buf: type$RaiseHist): boolean;
{
  result := buf.rHSum > 0 and buf.dRec > 0 and buf.dDat2 > 0;
}

//Возвращает текст сообщения пользователю с детализацией о невалидности записи RaiseHist
function GetNotValidRaiseHistUserInfo(buf: type$RaiseHist): string;
{
  var EmptyRequiredFields: string = ''; //незаполненные обязательные поля

  if buf.rHSum <= 0
    EmptyRequiredFields := 'Сумма/процент доплаты/надбавки';

  if buf.dRec = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'С даты';

  if buf.dDat2 = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'По дату';

  result := if(EmptyRequiredFields = '', '',
               ''#3'Не заполнены обязательные поля: '#13 + EmptyRequiredFields);
}

TableEvent table RaiseHist;
  cmSetDefault:
  {
    //message('Докомпилировали обработчик');
    inherited::HandleEvent(cmSetDefault);
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD105');
    if (ParentSav <> 0)
    {
      RaiseHist.cRaiseType := ParentSav;
      RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
      Raise.RaiseAttr := RaiseHist.iHAttr;
      Raise.RaiseType := ParentSav;
    }
  }
  cmCheckRecord:
  {
    if inherited::HandleEvent(cmCheckRecord) = heOk
    {
      var buf: type$RaiseHist;
      buf := RaiseHist.buffer;
      if not RaiseHistIsValid(buf) {
        Message(GetNotValidRaiseHistUserInfo(buf), error);
        Abort;
      }
    }
  }
end;

TableEvent table GP_RaiseHistExt105;
  cmSetDefault:
  {
    //message('cmSetDefault GP_RaiseHistExt105');
    GP_RaiseHistExt105.cRaiseH := RaiseHist.nrec;
    //message('установили нрек для расширения '+RaiseHist.nrec);
  }
  cmInsertRecord:
  {
    //inherited::HandleEvent(cmInsertRecord);
    //message('cmInsertRecord GP_RaiseHistExt105');
    GP_RaiseHistExt105.cRaiseH := RaiseHist.nrec;
    insert current GP_RaiseHistExt105;
  }
  cmUpdateRecord:
  {
    //message('cmUpdateRecord GP_RaiseHistExt105');
    GP_RaiseHistExt105.cRaiseH := RaiseHist.nrec;
    update current GP_RaiseHistExt105;
  }
  cmDeleteRecord:
  {
    //message('cmUpdateRecord GP_RaiseHistExt105');
    delete current GP_RaiseHistExt105;
  }
end;

TableEvent table ContDoc;
  cmInsertRecord:
  {
    //При добавлении нового сотрудника в приказ вызываем выбор вида доплаты/надбавки
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      if SelectFormat(brwRaise105)
      {
        SelectField(#RaiseCat.Name);
        PutCommand(cmPick);
      }
    }
  }
end;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    cmPick:
    {

      case CurField of
        #RaiseCat.Name:
        {

          //ParentSav := RaiseHist.cRaiseType;
          ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD105');

          var wPickResult: word = cmCancel;
          if GetFirst FastFirstRow Catalogs where ((ParentSav == Catalogs.cParent)) = tsOk
            wPickResult := RunInterface(Z_STAFFCAT::PickCatalog2, 0, ParentSav, 0, 0);
          else
            wPickResult := RunInterface(GP_STAFF::GP_PickCatalogWithOneRec, -17, ParentSav);

          if (wPickResult = cmDefault)
          {
            //PreviousType := RaiseHist.cRaiseType; // взвести флаг того, что поменяли наименование
            set RaiseHist.cRaiseType := ParentSav;
            set RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
            set Raise.RaiseAttr := RaiseHist.iHAttr;
            set Raise.RaiseType := ParentSav;
            ReReadRecord(tnCatalogs);
          }

          exit;
        } //RaiseCat.Name
      end;

      inherited::HandleEvent(cmPick);

      case CurField of
        #persons.fio:
        {
          if isvalidall(#Persons)
          {
            //Запрещаем пользователю выбирать умерших сотрудников
            if (Persons.ddop1 != 0)
            {
              message('Запрещено выбирать сотрудников с заполненным полем "Дата смерти"', error);
              PutCommand(cmDelOnProtect);
            }
            else
            {
              //Если пользователь выбрал корректного сотрудника и это новая позиция -
              //сразу вызываем вставку этой записи, чтобы далее вызвать добавление вида доплаты/надбавки
              if(isNew) UpdateTable();
              SelectFieldInFormat(brwRaise105, #RaiseCat.Name);
            }
          }
        }
      end;

    }
    cmMulSelDO:
    {
      if UpdateTable
        UpdNeedField(CurField);
    }
    cmCalc:
    {
      update current ContDoc set TypeOper = 9;
      inherited::Handleevent(cmCalc);
      update ContDoc where ((PartDoc.nrec == contdoc.cPart)) set TypeOper = 105;
      _loop Contdoc where ((PartDoc.nrec == contdoc.cPart))
        NOAA.DeleteAgreementLinks(coContDoc, ContDoc.nrec)
    }
    cmDelOnProtect:
    {
      inherited::handleevent(cmDelOnProtect);
      if curfield = #persons.fio
      {
        set contdoc.person := 0;
      }
    }
    cmOnVipUnload:{
      inherited::Handleevent(cmOnVipUnload);
      cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
      cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер приказа');
      cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата приказа');

    }
  end;

End.
