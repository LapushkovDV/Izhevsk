table Struct AttTempListAdd (
  NRec: Comp,
  cAttTempList: Comp,
  PredsedatelFullFIO: String[50],
  ZamPredFullFIO: String[50],
  SecretarFullFIO: String[50],
  PredsedatelFIO: String[50],
  ZamPredFIO: String[50],
  SecretarFIO: String[50],
  NasPunkt: String[50],
  PredAtt: String[150],
  Fortunes: String,
  Punishments: String,
  UchStepen: String,
  Prisutsvovali: String,
  Invited: String,
  DopEducation: String,
  SokrFIO: String[50],
  EmplEducFull: String,
  CompanyName: String,
  Result: String,
  Recommendations: String,
  DeptFull: String,
  AppDate: Date
)
with index
(
  AttNpp = NRec(Surrogate),
  AttCAtt = cAttTempList
);

// Список подразделений
table Struct SDeps (
  cDep: tNRec,      // Ссылка на подразделение
  Code: String[50], // Код подразделения
  Name: String      // Название подразделения
)
with index
(
  SDeps01 = cDep,
  SDeps02 = Code
);

// Список работников с группировкой по подразделениям
table Struct SDepPersons (
  cDep: tNRec,              // Ссылка на подразделение
  cPerson: tNRec,           // Ссылка на Persons
  FIO: String[50],          // Ф.И.О.
  BirthDate: Date,          // Дата рождения
  Education: String,        // Сведения об образовании, наличие ученной степени
  Position: String,         // Должность на момент проведения аттестации
  EmplDate: Date,           // Дата приема на работу
  FirmStaj: String[50],     // Трудовой стаж на предприятии
  PositionStaj: String[50], // Стаж в занимаемой должности
  Promotions: String,       // Поощрения
  Sanctions: String         // Дисциплинарные взыскания
)
with index
(
  SDepPersons01 = cDep + cPerson,
  SDepPersons02 = cDep + FIO
);

function GetUserCreatorFIO: string; forward;

create view
  as select
    GetUserCreatorFIO() (FieldName = UserCreatorFIO)
  from
    AttTempListAdd,
    synonym PlanAtt PlanAttPred,
    synonym Catalogs Catalogs2,
    synonym Catalogs EduLevelP,
    synonym x$users UserCreator,
    Fortune,
    Punishments,
    Oldorg,
    Badge,
    SDeps (SDeps02),
    SDepPersons (SDepPersons02)
  where ((
        AttTempList.NRec     == AttTempListAdd.cAttTempList
    and SDeps.cDep           == SDepPersons.cDep
    and EduLevel.cParent     == EduLevelP.NRec
    and Attestation.LastUser == UserCreator.Atl_Nrec
  ));

datastream AttSream
(
  table inherited::AttTempList
  (
    [PredsFIO]          AttTempListAdd.PredsedatelFIO;
    [ZamPredFIO]        AttTempListAdd.ZamPredFIO;
    [SecretarFIO]       AttTempListAdd.SecretarFIO;
    [PredsFullFIO]      AttTempListAdd.PredsedatelFullFIO;
    [ZamPredFullFIO]    AttTempListAdd.ZamPredFIO;
    [SecretarFullFIO]   AttTempListAdd.SecretarFullFIO;
    [PredAttDate]       AttTempListAdd.PredAtt;
    [PredAttResult]     AttTempListAdd.PredAtt;
    [Fortunes]          AttTempListAdd.Fortunes;
    [Punishments]       AttTempListAdd.Punishments;
    [UchStepen]         AttTempListAdd.UchStepen;
    [Prisutsvovali]     AttTempListAdd.Prisutsvovali;
    [Invited]           AttTempListAdd.Invited;
    [DopEducation]      AttTempListAdd.DopEducation;
    [SokrFIO]           AttTempListAdd.SokrFIO;
    [EmplEducFull]      AttTempListAdd.EmplEducFull;
    [CompanyName]       AttTempListAdd.CompanyName;
    [Result]            AttTempListAdd.Result;
    [Recommendations]   AttTempListAdd.Recommendations;
    [EmplDeptFull]      AttTempListAdd.DeptFull;
  );
  
  table SDeps
  (
    [DepCode] SDeps.Code; // Код подразделения
    [DepName] SDeps.Name; // Название подразделения
    table SDepPersons (
      [FIO] SDepPersons.FIO; // Ф.И.О.
      [BirthDate] SDepPersons.BirthDate; // Дата рождения
      [Education] SDepPersons.Education; // Сведения об образовании, наличие ученной степени
      [Position] SDepPersons.Position; // Должность на момент проведения аттестации
      [EmplDate] SDepPersons.EmplDate; // Дата приема на работу
      [FirmStaj] SDepPersons.FirmStaj; // Трудовой стаж на предприятии
      [PositionStaj] SDepPersons.PositionStaj; // Стаж в занимаемой должности
      [Promotions] SDepPersons.Promotions; // Поощрения
      [Sanctions] SDepPersons.Sanctions; // Дисциплинарные взыскания
    );
  );
)
end;

  browse StaffAttCtrl_1 ('',, sci1478Esc);
    table Attestation;
  fields
    UserCreatorFIO 'Создатель': [20], protect;
  end;

  browse StaffAttCtrl_2 ('',, sci14InsPM);
    table PlanAtt;
    recMarker = pMarker {PlanAtt.NRec};
  fields
    /*{ Font = { Color = if(TMPMarkerStr = '', 0, ColorMark) }};
    TMPMarkerStr 'V' ('"V" - поле помечено'): [1], protect; */
    PlanAtt.Dat1 'Дата аттестации': [12], protect;
    Persons.FIO  'Сотрудник': [20], protect;
    GetStrTabN(Persons.TabNmb, Persons.StrTabn) 'Табельный номер':[10], protect;
    ResType.Name 'Результат аттестации':[20],protect;
    RecCat.Name  'Рекомендации комиссии': [20], protect;
    SubStr(PlanDept.Code, 1, 3)  'Код план.', 'подр.': [10], protect;
    PlanDept.Name 'Планируемое', 'подразделение': [20], protect;
    PlanPost.Name 'Планируемая', 'должность': [20], protect;
  end;

  function GetUserCreatorFIO: string;
  begin
    result := '';
    if IsValidAll(tnUserCreator) then
    begin
      var S: String = sGetTuneEx('USER.FIO', UserCreator.xu$UserOffice, UserCreator.Atl_Nrec);
      result := if(S = '', if(UserCreator.xu$FullName = '', UserCreator.xu$LoginName + ' (учетная запись пользователя)',
        UserCreator.xu$FullName), S);
    end;
  end;

  // Поощрения
  function GetFortunes: String;
  begin
    result := '';
    _loop Fortune where ((
          PersonsMark.NRec == Fortune.cPers
      and Fortune.cFType   == Catalogs.NRec
      // and fortune.cRef1    == Catalogs2.NRec
    )) ordered dat1
    begin
      if (Fortune.Dat1 != ZeroDate) and (Fortune.Dat1 < Add_Months(PlanAtt.Dat1, -12)) then
        continue;
      result := if(result != '', result + ', ', '') + Catalogs.Name;
      if Fortune.Dat1 != ZeroDate then
        result += ' ' + DateToStr(Fortune.Dat1, 'DD.MM.YYYY');
    end;
    if result = '' then
      result := 'Нет поощрений';
  end;

  // Взыскания
  function GetPunishments: String;
  begin
    result := '';
    _loop Punishments where ((
          PersonsMark.NRec   == Punishments.cPsn
      and Punishments.cptype == Catalogs.NRec
      and Punishments.cRef2  == Catalogs2.NRec
    )) ordered Dat1
    begin
      if From_Days(Punishments.LastUser) < PlanAtt.Dat1 and Punishments.LastUser > 0 then
        continue;
      if (Punishments.dat1 != ZeroDate) and (Punishments.dat1 < Add_Months(PlanAtt.Dat1, -12)) then
        continue;
      result := if(result != '', result + ', ', '') + Catalogs.Name;
      if IsValid(tnCatalogs2) then
        result += ' за ' + oGP_SF.LoCaseFirstChar(Catalogs2.name);
      if Punishments.LastDate != ZeroDate then
        result += ' ' + DateToStr(Punishments.LastDate, 'DD.MM.YYYY');
    end;
    if result = '' then
      result := 'Нет взысканий';
  end;

  // Ученное звание
  function GetUchStepen: String;
  begin
    result := '';
    if getFirst OldOrg where ((7 == OldOrg.WObj and PersonsMark.NRec == OldOrg.cParent)) = tsOk then
    begin
      if getFirst Badge where ((
            PersonsMark.NRec == Badge.Person
        and 10               == Badge.BadgeMonth
        and Badge.Appoint    == Catalogs.NRec
      )) = tsOk then
        result := Catalogs.Name + ' ' + OldOrg.Code;
    end else
      if getFirst OldOrg where ((4 == OldOrg.WObj and PersonsMark.NRec == OldOrg.cParent)) = tsOk then
      begin
        if getFirst Badge where ((
              PersonsMark.NRec == Badge.Person
          and 3                == Badge.BadgeMonth
          and Badge.Appoint    == Catalogs.NRec
        )) = tsOk then
          result := Catalogs.name + ' ' + OldOrg.Code;
      end else
        if getFirst OldOrg where ((3 == OldOrg.WObj and PersonsMark.NRec == OldOrg.cParent)) = tsOk then
        begin
          if getFirst Badge where ((
                PersonsMark.NRec == Badge.Person
            and 2                == Badge.BadgeMonth
            and Badge.appoint    == Catalogs.NRec
          )) = tsOk then
            result := Catalogs.name + ' ' + OldOrg.Code;
        end else
          result := 'не имеет ученых степеней';
  end;

  // Дополнительное образование
  function GetDopDopEducation: String;
  begin
    result := '';
    _loop Education
    begin
      if iEducFunc.GetEducType(EduLevel.NRec) != 1 or Education.wDop = 1 then
        continue;

      if Education.ToDate > PlanAttMark.Dat1 then
        continue;

      if result = '' then
        result := iCatFunc.GetCatalogsName(Education.Name) + ', ' + Year(Education.ToDate) + ' г.'
      else
        result := result + '; ' + iCatFunc.GetCatalogsName(Education.Name) + ', ' + Year(Education.ToDate) + ' г.';
    end;
  end;

  // Преобразовывает строк стажа "# лет # месяцев # дней" в "# лет # месяцев"
  function StajWithoutDays(S: String): String;
  var
    I, P: Byte;
  begin
    result := '';
    for(I := 1; I <= 4; I++)
    begin
      P := InStr(' ', S);
      if P = 0 then
        exit;
      result += if(result = '', '', ' ') + SubStr(S, 1, P - 1);
      S := SubStr(S, P + 1, Length(S) - P);
    end;
  end;

  // Добавляет данные в таблицы SDeps и SDepPersons
  procedure InsertInSDeps;
  begin
    if getFirst SDeps where ((AppointmentsMark.Department == SDeps.cDep)) != tsOk then
    begin
      // ClearBuffer(#SDeps); // Вызывать нет нужды, все поля присваиваются
      SDeps.cDep := AppointmentsMark.Department;
      SDeps.Code := iCatFunc.GetCatalogsCode(AppointmentsMark.Department);
      SDeps.Name := iCatFunc.GetCatalogsName(AppointmentsMark.Department);
      if insert current SDeps != tsOk then
        Message('Ошибка: Не удалось добавить запись в таблицу SDeps');
    end;
    // ClearBuffer(#SDepPersons); // Вызывать нет нужды, все поля присваиваются
    // Ссылка на подразделение
    SDepPersons.cDep := AppointmentsMark.Department;
    // Ссылка на Persons
    SDepPersons.cPerson := PlanAttMark.cPers;
    // Ф.И.О.
    SDepPersons.FIO := PersonsMark.FIO;
    // Дата рождения
    SDepPersons.BirthDate := PersonsMark.BornDate;
    // Сведения об образовании, наличие ученной степени
    SDepPersons.Education := AttTempListAdd.EmplEducFull;
    // Должность на момент проведения аттестации
    SDepPersons.Position := iCatFunc.GetCatalogsName(AppointmentsMark.Post);
    // Дата приема на работу
    SDepPersons.EmplDate := PersonsMark.AppDate;
    // Трудовой стаж на предприятии
    SDepPersons.FirmStaj := StajWithoutDays(AttTempList.CompanySen);
    // Стаж в занимаемой должности
    SDepPersons.PositionStaj := StajWithoutDays(oGP_StajFunc.CalcAppStaj(PersonsMark.NRec, PlanAttMark.Dat1, 0, 0, 0, ZeroDate));
    // Поощрения
    SDepPersons.Promotions := AttTempListAdd.Fortunes;
    // Дисциплинарные взыскания
    SDepPersons.Sanctions := AttTempListAdd.Punishments;
    if insert current SDepPersons != tsOk then
      Message('Ошибка: Не удалось добавить запись в таблицу SDepPersons');
  end;

  procedure InsertInTableAttTempList;   // Заполнение потока в таблице AttTempListAdd
  begin
    inherited::InsertInTableAttTempList;

    AttTempList.BornDate := Replace(AttTempList.BornDate, '/', '.');
    update current AttTempList;
    // Если предыдущей аттестации нет - поле должно быть пустым

    // Дозаполним ФИО председателя и секретаря
    ClearBuffer(#AttTempListAdd);
    AttTempListAdd.cAttTempList := AttTempList.NRec;
    AttTempListAdd.CompanyName := oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', Cur_Date());
    AttTempListAdd.EmplEducFull := AttTempList.Educ;
    if AttTempList.Educ2 != '' then
      AttTempListAdd.EmplEducFull := AttTempListAdd.EmplEducFull + ' ' + AttTempList.Educ2;
    if AttTempList.Educ3 != '' then
      AttTempListAdd.EmplEducFull := AttTempListAdd.EmplEducFull + ' ' + AttTempList.Educ3;

    AttTempListAdd.SokrFIO := oGP_SF.ShortFIO(AttTempList.FIO, 2);

    AttTempListAdd.NasPunkt:= 'г.Химки';

    // найдем предыдущую аттестацию для этого человека
    _loop PlanAttPred where ((
          PersonsMark.NRec  /== PlanAttPred.cpers
      and PlanAttPred.cType /== Catalogs.NRec
    )) ordered by Dat1
    begin
      if PlanAttPred.Dat1 < AttTempList.AttDate then
        // if Year(PlatAttPred.Dat1) != 0 then
        AttTempListAdd.PredAtt := DateToStr(PlanAttPred.Dat1, 'DD.MM.YYYY') + ', ' + Catalogs.Name;
    end;
    AttTempListAdd.Fortunes := GetFortunes;
    AttTempListAdd.Punishments := GetPunishments;
    AttTempListAdd.UchStepen := GetUchStepen;
    AttTempListAdd.EmplEducFull := if(Trim(AttTempListAdd.EmplEducFull) != '', AttTempListAdd.EmplEducFull + ', ', '') +
     AttTempListAdd.UchStepen;

    if oGP_Signers.getFirst('PredCom') then // Роль "Председатель комиссии"
    begin
      AttTempListAdd.PredsedatelFIO := oGP_Signers.GetFIO(1, 2);
      AttTempListAdd.PredsedatelFullFIO := oGP_Signers.GetFIO(1);
    end;

    if oGP_Signers.getFirst('ZamPredCom') then // Роль "Зам.председателя комиссии"
    begin
      AttTempListAdd.ZamPredFIO := oGP_Signers.GetFIO(1, 2);
      AttTempListAdd.ZamPredFullFIO := oGP_Signers.GetFIO(1);
    end;

    if oGP_Signers.getFirst('Sekretar') then // Роль "Секретарь"
    begin
      AttTempListAdd.SecretarFIO := oGP_Signers.GetFIO(1, 2);
      AttTempListAdd.SecretarFullFIO := oGP_Signers.GetFIO(1);
    end;

    // Присутствовали
    if oGP_Signers.GetFirst('ChlenCom') then // Роль "Член комиссии"
      do begin
        AttTempListAdd.Prisutsvovali += if(Trim(AttTempListAdd.Prisutsvovali) != '', ', ', '') + oGP_Signers.GetFIO(1, 1);
      end while oGP_Signers.GetNext;

    // Приглашенные
    if oGP_Signers.GetFirst('Otvetstv') then // Роль "Ответственный"
      do begin
        AttTempListAdd.Invited += if(Trim(AttTempListAdd.Invited) != '', ', ', '') + oGP_Signers.GetFIO(1, 1);
      end while oGP_Signers.GetNext;

    AttTempListAdd.DopEducation := GetDopDopEducation;
    // Результат
    AttTempListAdd.Result := iCatFunc.GetCatalogsName(PlanAttMark.cKateg);
    // Рекомендации
    AttTempListAdd.Recommendations := iCatFunc.GetCatalogsName(PlanAttMark.cType);
    // Название подразделения с соблюдением иерархии снизу вверх, через пробел + код подразделения в круглых скобках
    AttTempListAdd.DeptFull := oGP_DepFunc.GetFullDepName(AppointmentsMark.Department,DF_ADD_CODE);

    // Дата приема на работу из карточки сотрудника
    AttTempListAdd.AppDate := PersonsMark.AppDate;
    
    insert current AttTempListAdd;

    InsertInSDeps;
  end;

  form FrmP ('GP_AttProtocol.out','GP_AttProtocol');
  form FrmL ('GP_AttList.out','GP_AttList');

  // Возвращает true, если текущее образование высшее профессиональное
  function IsHighLevelEduc: Boolean;
  begin
    result := false;
    if EduLevel.SysCode = -98 then
      result := true
    else
      if IsValid(tnEduLevelP) then
        if EduLevelP.SysCode = -98 then
          result := true
  end;

  procedure OutEduc;
  begin
    var HighLevelCnt: Byte = 0;
    _loop Education
    begin
      if iEducFunc.GetEducType(EduLevel.NRec) <> 1 then
        continue;
      if Education.ToDate > PlanAttMark.Dat1 then
        continue;
      if IsHighLevelEduc then
      begin
        HighLevelCnt++;
        if HighLevelCnt > 1 then
          continue;
      end;

      FrmL.PutEventByID(feDoLoop, fcEduc);
      FrmL.Write(EduLevel.SysCode); // ELevelCode
      FrmL.Write(EduLevel.Name); // ELevel
      FrmL.Write(iCatFunc.GetCatalogsName(Education.Name)); // EName
      FrmL.Write(iCatFunc.GetCatalogsName(Education.Speciality)); // ESpeciality
      FrmL.Write(iCatFunc.GetCatalogsName(Education.cAddInf1)); // ETopic
      FrmL.Write(Education.FromDate); // EFromDate
/* тут не надо
      var dEducationEnd: date = Education.ToDate;
      if ( locase(trim(EduLevel.Name)) = 'аспирантура' )
        if ( Education.DiplomDate < PlanAttMark.Dat1 )
          dEducationEnd := 0;
      FrmL.Write(dEducationEnd); // EToDate
*/
      FrmL.Write(Education.ToDate); // EToDate
    end;
    // Если есть учённая степень
    if Trim(AttTempListAdd.UchStepen) != '' then
    begin
      // Выводим ее в том же цикле, в последней строке, в поле EName
      FrmL.PutEventByID(feDoLoop, fcEduc);
      FrmL.SkipFormat(2); // ELevelCode, ELevel
      FrmL.Write(Trim(AttTempListAdd.UchStepen)); // EName
      FrmL.SkipFormat(4); // ESpeciality, ETopic, EFromDate, EToDate
    end;
  end;

  procedure OutEducAdd;
  begin
    var HighLevelCnt: Byte = 0;
    _loop Education
    begin
      if Education.ToDate > PlanAttMark.Dat1 then
        continue;
      var NeedOut: Boolean = false;
      case EduLevel.SysCode of
        -102, -103, 703, 1437: // Профессиональная переподготовка
          NeedOut := true;
      end;
      if IsHighLevelEduc then
      begin
        HighLevelCnt++;
        if HighLevelCnt > 1 then
          NeedOut := true;
      end;
      if not NeedOut then
        continue;
      FrmL.PutEventByID(feDoLoop, fcEducAdd);
      FrmL.Write(EduLevel.SysCode); // EALevelCode
      FrmL.Write(EduLevel.Name); // EALevel
      FrmL.Write(iCatFunc.GetCatalogsName(Education.Name)); // EAName
      FrmL.Write(iCatFunc.GetCatalogsName(Education.Speciality)); // EASpeciality
      FrmL.Write(iCatFunc.GetCatalogsName(Education.cAddInf1)); // EATopic
      FrmL.Write(Education.FromDate); // EAFromDate
/* тут уже не надо
      var dEducationEnd: date = Education.ToDate;
      if ( locase(trim(EduLevel.Name)) = 'аспирантура' )
//        if ( Education.DiplomDate < PlanAttMark.Dat1 )
        if ( ( dEducationEnd > Cur_Date ) or ( dEducationEnd = 0 ) )
          dEducationEnd := 0;
      FrmL.Write(dEducationEnd); // EToDate
*/
      FrmL.Write(Education.ToDate); // EAToDate
    end;
  end;

function sClearZeroInStaj(_sStajStr: string): string;
{
  result := if(pos('0 лет ', _sStajStr) = 1, Replace(_sStajStr, '0 лет ', ''), _sStajStr);
  result := Replace(result, ' 0 дней', '');//0 лет // 0 дней
}
  
  procedure GenRTFAttList;
  var
    IsAborted: Boolean;
  begin
    IsAborted := false;

    if GetMarkerCount(PersonMarker) = 0 then
    begin
      InsertMarker(PersonMarker, PlanAtt.NRec);
      ReDrawCurrentAndGo(StaffAttCtrl_2, true);
    end;
    CreateTablAttTempList1;

    var cTypeStaj: comp = iCatFunc.GetCatalogsNRec(1456); // страховой стаж по уточнению к ТЗ

    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчётной формы...', 1);
    _try
      begin
        FrmL.Write(TypeOfAtt.Name); // TypeOfAtt
        FrmL.Write(oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', Cur_Date())); // CompanyName
        FrmL.Write(Attestation.AttDate); // AttDate
        FrmL.Write(Attestation.AttNmb); // AttNmb
        _loop AttTempList ordered by AttTempList.FIO
        begin
          NextVisual;
          FrmL.PutEventByID(feDoLoop, fcEmployees);
          FrmL.Write(AttTempList.FIO); // EmplFIO
          FrmL.Write(AttTempList.BornDate); // EmplBornDate
          FrmL.Write(AttTempList.Speciality); // EmplSpeciality
          FrmL.Write(oGP_SF.GetPersPost(PlanAttMark.cPers, 1, AttTempList.AttDate)); // EmplPos
          FrmL.Write(AttTempList.PosDateBeg); // EmplPosDate
          FrmL.Write(AttTempListAdd.AppDate); // EmplPsnAppDate
          //FrmL.Write(AttTempList.TotalSen); // EmplTotalSen
          FrmL.Write(sClearZeroInStaj(iRunStaj.NRunStrStajBoln(AttTempList.PsnNRec, cTypeStaj, AttTempList.AttDate))); // EmplTotalSen
          //FrmL.Write(AttTempList.CompanySen); // EmplCompanySen
          FrmL.Write(sClearZeroInStaj(oGP_StajFunc.CalcAppStaj(AttTempList.PsnNRec, AttTempList.AttDate, 0, 0, 0, 0))); // EmplCompanySen
          FrmL.Write(AttTempListAdd.Fortunes); // Fortunes
          FrmL.Write(AttTempListAdd.Punishments); // Punishments
          FrmL.Write(AttTempListAdd.PredAtt); // PredAttResult
          FrmL.Write(AttTempList.AttDate); // EmplAttDate
          FrmL.Write(AttTempList.Recom1); // Recom1
          FrmL.Write(AttTempList.Recom2); // Recom2
          FrmL.Write(AttTempList.Rezalt); // Rezalt
          FrmL.Write(AttTempListAdd.PredsedatelFullFIO); // PredsFullFIO
          FrmL.Write(AttTempListAdd.PredsedatelFIO); // PredsFIO
          FrmL.Write(AttTempListAdd.ZamPredFullFIO); // ZamPredFullFIO
          FrmL.Write(AttTempListAdd.ZamPredFIO); // ZamPredFIO
          FrmL.Write(AttTempListAdd.SecretarFullFIO); // SecretarFullFIO
          FrmL.Write(AttTempListAdd.SecretarFIO); // SecretarFIO
          FrmL.Write(AttTempListAdd.Prisutsvovali); // Prisutsvovali
          OutEduc;
          OutEducAdd;
        end;
      end
    _except
      on ExUserBreak:
        begin
          IsAborted := true;
        end;
    StopVisual('', 0);

    if not IsAborted and not FrmL.Error then
      FrmL.ShowFile();
  end;

  procedure GenRTFAttProtocol;
  var
    IsAborted: Boolean;
  begin
    IsAborted := false;

    CreateTablAttTempList;

    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчётной формы...', 1);
    _try
      begin
        FrmP.Write(TypeOfAtt.Name); // TypeOfAtt
        FrmP.Write(oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', Cur_Date()));
        FrmP.Write(Attestation.AttDate); // AttDate
        FrmP.Write(Attestation.AttNmb); // AttNmb
        FrmP.Write(AttTempListAdd.PredsedatelFullFIO); // PredsFullFIO
        FrmP.Write(AttTempListAdd.ZamPredFullFIO); // ZamPredFullFIO
        FrmP.Write(AttTempListAdd.SecretarFullFIO); // SecretarFullFIO
        FrmP.Write(AttTempListAdd.Prisutsvovali); // Prisutsvovali
        FrmP.Write(AttTempListAdd.Invited); // Invited
        _loop AttTempList ordered by AttTempList.FIO
        begin
          NextVisual;
          FrmP.PutEventByID(feDoLoop, fcPEmployees);
          FrmP.Write(AttTempList.FIO); // EmplFIO
          FrmP.Write(AttTempList.Position); // EmplPos
          FrmP.Write(AttTempListAdd.DeptFull); // EmplDeptFull
          FrmP.Write(AttTempListAdd.Recommendations); // Recommendations
          FrmP.Write(AttTempListAdd.Result); // Result
        end;
      end
    _except
      on ExUserBreak:
        begin
          IsAborted := true;
        end;
    StopVisual('', 0);

    if not IsAborted and not FrmP.Error then
      FrmP.ShowFile();
  end;

  handleEvent
    cmPrintDoc:
      // Выбираем группу подписантов
      if oGP_Signers.Init(cgReport_KASSFRO, 'AttOrder', true, Attestation.AttDate) then
      begin
        ResetBounds(#AttTempListAdd);
        ResetBounds(#SDeps);
        ResetBounds(#SDepPersons);
        delete all from AttTempListAdd;
        delete all from SDeps;
        delete all from SDepPersons;
        SetBounds(#AttTempListAdd);
        SetBounds(#SDeps);
        SetBounds(#SDepPersons);
        if CurTable = #PlanAtt then
          GenRTFAttList
        else
          inherited::handleEvent(cmPrintDoc);
      end;
    cmValue30:
      // Выбираем группу подписантов
      if oGP_Signers.Init(cgReport_KASSFRO, 'AttOrder', true, Attestation.AttDate) then
      begin
        ResetBounds(#AttTempListAdd);
        ResetBounds(#SDeps);
        ResetBounds(#SDepPersons);
        delete all from AttTempListAdd;
        delete all from SDeps;
        delete all from SDepPersons;
        SetBounds(#AttTempListAdd);
        SetBounds(#SDeps);
        SetBounds(#SDepPersons);
        GenRTFAttProtocol;
      end;
    cmHotKeys:
      if CurTable = #Attestation then
      begin
        var menuID: LongInt;
        menuID := LoadMenu('ReOrderPlan');
        AddMenuItem(menuID, 'Печать отчета в формате RTF', cmValue30);
        PutHotCommand(RunLoadMenu(menuID));
      end else
        inherited::handleEvent(cmHotKeys);
    cmInsert:
      begin
        // Полная копия обработчика cmInsert из родительского интерфейса
        // Добавлено заполнение поля Attestation.LastUser
        var NRec_Ins: Comp;
        ClearBuffer(#Attestation);
        Attestation.LastUser := UserId;
        Attestation.AttDAte := Cur_Date;
        if insert current Attestation = tsOK then
        begin
          NRec_Ins := Attestation.NRec;
          RunInterFace('AttEditOrderList', NRec_Ins);
        end;
        ReReadRecord(#Attestation);
        ReReadRecord(#PlanAtt);
        abort;
     end;
  end;

end.
