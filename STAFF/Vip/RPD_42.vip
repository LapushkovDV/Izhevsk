#include GP_RepLaborContract.vih

#component "Z_StaffOrders"
#doc
Перенос отпуска(РПД-42)
<p>#1808 контроль по дате увольнения и поля "назначен по"
#end
alter interface RPD_42;
overload
  function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
end;

function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
{ Result:=Inherited::ChildCheckOneOrder(cNrec);
  if Result
  { if Persons.DisDate<>ZeroDate
    { if Persons.DisDate<=PLANYEAREND//CONTDOC.DPRIK
      { message('Сотрудник '+Persons.Fio
         +chr(13)+'Уволен '+DateToStr(Persons.DisDate,'DD/MM/YYYY')
         +chr(13)+'что меньше даты окончания отпуска'
         +chr(13)+DateToStr(PLANYEAREND,'DD/MM/YYYY')
        )
      }
    } //if Persons.DisDate<>ZeroDate
    if APPOINTMENTS.DATEEND<>ZeroDate
    { if APPOINTMENTS.DATEEND<=PLANYEAREND //CONTDOC.DPRIK
      { message('Сотрудник '+Persons.Fio
         +chr(13)+'Назначен по '+DateToStr(Persons.DisDate,'DD/MM/YYYY')
         +chr(13)+'что меньше даты окончания отпуска'
         +chr(13)+DateToStr(PLANYEAREND,'DD/MM/YYYY') //CONTDOC.DPRIK
        )
      }
    } //if Persons.DisDate<>ZeroDate
  } //if Result
} //function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;


end.
