#component "Z_Staff"
Alter Interface WorkFunctionsEditer;

Create View vWorkFunctionsEditer
As
select
  CatalogsP.Code (FieldName = CatPodrKod)
from
Catalogs CatalogsP
where
((
    StaffStruct.Department == CatalogsP.nRec
));

overloadFormats brStaffStr;

browse brStaffStr 'Ставки' (,, sci1Esc);
  show at (, 15, 90, 22);
  table StaffStruct;
fields
  {curRowFont = {bold = true}};
  sDept 'Подразделения' ('Структурные единицы штатного расписания'): [40], protect, nopickbutton;
  CatPodrKod 'Код подразделения' ('Код подразделения'): [25], protect, nopickbutton;
  StaffStruct.SeqNmb '№', 'п/п' ('№ п/п'): [5], protect, nopickbutton, noAutoSize;
  StaffStruct.sNameSt 'Наименование', 'штатной единицы' ('Наименование штатной единицы'): [25], protect, nopickbutton;
  StaffStruct.dInput 'Дата', 'введения' ('Дата введения'): [10], protect, nopickbutton, noAutoSize;
  StaffStruct.dClose 'Дата', 'закрытия' ('Дата начала действия'): [10], protect, nopickbutton, noAutoSize;
end;

end.
