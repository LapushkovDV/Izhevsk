#include RPD.vih
#include PAFilter.vih

#component "Z_StaffOrders"

vipinterface RPD_131(RPD_31);
public:
  function IRPD_Base.ChildConfirmOneOrder(cNrec: comp = 0): boolean;
  function IRPD_Base.ChildCheckOneOrder(cNrec: comp = 0): boolean;
  Procedure IRPD_Base.EnableDisable;
end;

interface RPD_131;

var
  PAF: TraditionalPersonalAccountFilter;

create view
from klOtpusk gpKlOtpusk, LSchet gpLSchet, ForMarks gpForMarks, Catalogs gpCatalogsSys, Catalogs gpCatalogs
where ((
  root               == gpKlOtpusk.Nrec    and
  (gpKlOtpusk.nOtpus  = 'Прогул')          and
  cKlOtpusk          == gpForMarks.Choice  and
  1                  == gpForMarks.cPodr
));

extendformats scrDet31;

screen scrDet31 (,hcStaffWinPr, scStaffMyPnl);
  show at (, 5,,);
  table Punishments;
  fields
    ContDoc.Dat2 ('Дата совершения - по', hcStaffWinPr): noprotect;
<<


                                                        `Дата по` .@@@@@@@@@@
>>
end;

function IRPD_Base.ChildConfirmOneOrder(cNrec: comp = 0): boolean;
{
  result := false;

  if not inherited::ChildConfirmOneOrder(cNrec)
    exit;

  if getfirst gpLSchet where (( Persons.Nrec == gpLSchet.TPerson and
                                (gpLSchet.Sovm = 0 and gpLSchet.DatPos <= TitleDoc.DocDate and (gpLSchet.DatUv = 0 or gpLSchet.DatUv >= TitleDoc.DocDate) )
                             )) != tsOk
  {
    if getfirst gpLSchet where (( Persons.Nrec    == gpLSchet.TPerson )) != tsOk
    {
      SetErrorOrder('Не определен лицевой счет по сотруднику');
      exit;
    }
  }

  PAF.InitFilter(false,false);
  if not PAF.SelectPersonalAccount(gpLSchet.Nrec)
  {
    SetErrorOrder('Ошибка при выполнении PAF.SelectPersonalAccount(' + string(gpLSchet.Nrec,0,0) + ')');
    exit;
  }

  if getfirst gpKlOtpusk != tsOk
  {
    SetErrorOrder('Не найден вид отпуска "Прогул"');
    exit;
  }

  delete all gpForMarks;
  insert gpForMarks set gpForMarks.Choice := cKlOtpusk,
                        gpForMarks.cPodr  := 1,
                        gpForMarks.Field1 := 0, //приоритет
                        gpForMarks.Field2 := gpKlOtpusk.kOtpus,
                        gpForMarks.Summa  := CalcDaysBetweenDates(Punishments.LastDate, ContDoc.Dat2, false);

  RunInterface('DoVOtpusk', 2, //DataType,
                            Punishments.LastDate, //DataN,
                            ContDoc.Dat2, //DataOk,
                            gpKlOtpusk.kOtpus, //KodOtpusk,
                            Month(Punishments.LastDate), //MesUxoda,
                            Year(Punishments.LastDate), //YeaUxoda,
                            0, //prvidUdv, word(coGetTune('UP.ZAR.Otp.Vidud'))
                            0, //prVidUdb, word(coGetTune('UP.ZAR.Otp.Vidudb'))
                            2, //SumNaRuk,
                            0, //wMatPom,
                            0); //cNrecO

  result := true;
}

Procedure IRPD_Base.EnableDisable;
{
  inherited::EnableDisable;
  if fnFieldsOpen // не утвержден
  {
    SetFieldOption(#ContDoc.Dat2, ofSelectable);
  }
  else
  {
    ClearFieldOption(#ContDoc.Dat2, ofSelectable);
  }
}

function IRPD_Base.ChildCheckOneOrder(cNrec: comp = 0): boolean;
{
  result := inherited::ChildCheckOneOrder(cNrec);
  if ContDoc.Dat2 = 0
  {
    SetErrorOrder('Не задана дата окончания прогула');
    result := false;
  } else if ContDoc.Dat2 < Punishments.LastDate
  {
    SetErrorOrder('Дата окончания прогула меньше даты начала прогула');
    result := false;
  }
}

tableevent table Punishments;
cmSetDefault:
{
  inherited::handleevent(cmSetDefault);
  if getfirst gpCatalogsSys where ((integer(-79) == gpCatalogsSys.SysCode)) = tsOk
    if getfirst gpCatalogs where ((gpCatalogsSys.Nrec == gpCatalogs.cParent and 'Прогул' == gpCatalogs.Name )) = tsOk
      Punishments.cRef2 := gpCatalogs.Nrec;
}
end;



end.
