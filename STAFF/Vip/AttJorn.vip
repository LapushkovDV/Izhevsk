#include FeeSigners.vih
#include GP_UserFilterKlKatego.vih
#include GP_UserFilterCatalogs.vih
#include GP_UserFilterStoreDSK.vih

#component "Z_StaffReports"
//Список сотрудников, подлежащих аттестации
alter interface AttJorn;
//show(,,125,30);

/*
Table Struct JRegPodr (
    NRec          : comp,        // NRec  ЇЁбЁ
    cPodr         : comp,
    Podr          : string[50],
    kodPodr       : string[20],
    Kol           : integer
)
    with index (
      JRP01 = NRec(Surrogate),
      JRP02 = kodPodr
);
*/
var
    nppFIO : integer;

Table Struct JRegList (
    NRec          : comp,        // NRec  ЇЁбЁ
    npp           : integer,
    FIO           : string[100],
    TabNum        : string[10],
    kodPodr       : string[20],
    Podr          : string[50],
    cPodr         : comp,
    Dolj          : string[50],
    AttDate       : date,
    NumOrd        : string[10],
    TypeAtt       : string,
    AttResult     : string[100],
    AttRecom      : string,
    PlanPodr      : string[50],
    PlanDolj      : string[30]
)
    with index (
      JRL01 = NRec(Surrogate),
      JRL02 = kodPodr + FIO + AttDate
);


create view as select * from
JRegList (JRL02),
Attestation
where ((PlanAtt.cref3 == attestation.nrec))
;

 //where ((AttTempList.nrec == AttTempListAdd.cAttTempList));

#include FeeSigners.var


  datastream JRegAtt
  (
    [DateN] DateN;
    [DateK] DateOk;
    Table JRegList
    (
      [npp]         JRegList.npp;
      [FIO]         JRegList.FIO;
      [TabNum]      JRegList.TabNum;
      [kodPodr]     JRegList.kodPodr;
      [Podr]        JRegList.Podr;
      [Dolj]        JRegList.Dolj;
      [AttDate]     JRegList.AttDate;
      [NumOrd]      JRegList.NumOrd;
      [TypeAtt]     JRegList.TypeAtt;
      [AttResult]   JRegList.AttResult;
      [AttRecom]    JRegList.AttRecom;
      [PlanPodr]    JRegList.PlanPodr;
      [PlanDolj]    JRegList.PlanDolj;
    );
  )
  end;

function GetFIOSpec(FIO:string):string;
{
  result:=SubStr(iStrFunc.Get_FirstName(FIO),1,1)+'. '+
          SubStr(iStrFunc.GetPatronymic(FIO),1,1)+'. '+
          iStrFunc.Get_LastName(FIO);
}


handleevent
  cmStaffAllDep:
  {
    var dCheckDate: date;
    if (VidOtch = 0)
    {
      VInter.ClearTableWithAppoint;

      // если фильтр пустой, заполним его
      if ( VInter.GetDeptCount = 0 and
           VInter.GetPostCount = 0 )
      {
        VInter.SelectAllPost;
        ReDrawPanel(#Catalogs);
      }
      _loop Persons
      {
        _loop PlanAtt
        {
          dCheckDate := VInter.GetDateForCheckAppoint(PlanAtt.Dat1, DateOk);
          ClearBuffer(#JRegList);
          JRegList.FIO := Persons.FIO;
          JRegList.TabNum := GetStrTabN(Persons.TabNmb, Persons.StrTabN);
          if ( not VInter.FindAndCheckAppoint(Persons.NRec, dCheckDate, Persons.Department, 0, _AppointCur) )
            continue;

          if ( GetFirst Appointments where (( _AppointCur == Appointments.NRec )) <> tsOk )
          {
            JRegList.Podr := IDepartIer.GetDepNameHist(Persons.Department, Cur_Date);
            JRegList.kodPodr := IDepartIer.GetCodeOnDate(Persons.Department, Cur_Date);
          }
          else
          {
            JRegList.Podr := IDepartIer.GetDepNameHist(Appointments.Department, dCheckDate);
            JRegList.kodPodr := IDepartIer.GetCodeOnDate(Appointments.Department, dCheckDate);
            JRegList.Dolj := iCatFunc.GetCatalogsName(Appointments.Post);
          }

          if (IsValid(#regimeChanges))
          {
            JRegList.NumOrd := RegimeChanges.OrderNmb;
          }

          JRegList.AttDate := PlanAtt.Dat1;
          JRegList.TypeAtt := iCatFunc.GetCatalogsName(Attestation.cType);
          JRegList.AttResult  := iCatFunc.GetCatalogsName(PlanAtt.cType);
          JRegList.AttRecom   := iCatFunc.GetCatalogsName(PlanAtt.cKateg);
          JRegList.PlanPodr   := iCatFunc.GetCatalogsName(PlanAtt.cDepart);
          JRegList.PlanDolj   := iCatFunc.GetCatalogsName(PlanAtt.cRef2);


          insert current JRegList;

        }
      }
      nppFIO := 1;
      _loop JRegList //ordered by KodPodr, FIO, AttDate
      {
        JRegList.npp := nppFIO++;
        update current JRegList;
      }


      RunFReport(JRegAtt, '', true);
    } else
    {
      inherited::handleevent(cmStaffAllDep);
    }
  }
end;

end.
