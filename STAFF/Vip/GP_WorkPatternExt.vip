#include GP_WorkPatternExt.vih
interface GP_WorkPatternExt;

create view ltWorkPatternExt
from
  GP_WorkPatternExt;

function DelRec(cWorkPattern:comp):boolean;
{
  result:=delete GP_WorkPatternExt where((cWorkPattern==GP_WorkPatternExt.cWorkPattern))=tsok;
}

HandleEvent
cmInit:abort;
end;

end.

//Для поддержания ссылочной целостности
handler with replace GP_WorkPatternExtDelete on trigger WorkPattern before Delete [99]
action
{
  var buf : record as table WorkPattern;
  GetTableBuffer(buf);

  var oWorkPatternExt:GP_WorkPatternExt;
  result:=oWorkPatternExt.DelRec(buf.NRec);
}
