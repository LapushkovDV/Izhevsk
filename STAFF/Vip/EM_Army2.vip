#include userreport.vih
#include adrFunc.vih
#include CatFunc.vih

Interface EM_Army2 'Параметры печати писем' gray
Show at (,,55,5);

Create View t1

var
  ICatFunc  : CatalogsFunctions;
  _sVoenkom : string;
  mVoenk    : LongInt = InitMarker('CatalogsMarker', 8, 30, 10);
  _wType    : word = 56;
  _descr    : string = sGetTune('User.Descr');
as
select 1 from EM_UniDic UniDic, Catalogs;

screen scr ('Параметры отчета',,sci13Esc);
Fields
  _sVoenkom, Protect, PickButton;

Buttons
  cmGo, ,, 'Продолжить' ,,;
<<

    По военкомату .@@@@@@@@@@@@@@@@@@@@@@@@@@@@

                                 <.Продолжить.>

>>
end;

Procedure UpdateFiltersState(); //by Ermolov K.
{
  var SelCnt: LongInt;
  var cTemp: Comp;
  _sVoenkom := '';
  SelCnt := GetMarkerCount(mVoenk);
  if SelCnt > 0 then
    if (SelCnt = 1) and GetMarker(mVoenk, 0, cTemp) then
      _sVoenkom := ICatFunc.GetCatalogsName(cTemp);
    else
      _sVoenkom := 'Выбрано военкоматов: ' + String(SelCnt);
  ReReadRecord;
}

Procedure InsPicked();
{
  var _i    : word = 0;
  var _cRec : comp = 0h;

  while 1 = 1
  {
    GetMarker(mVoenk, _i, _cRec);

    if (getFirst FastFirstRow Catalogs where ((_cRec == Catalogs.nRec)) = tsOk) then
    {
      if (Catalogs.MainLink = 000A0000000396EEh) then
      {
        ClearBuffer(#UniDic);
          UniDic.nRec          := 0h;
          UniDic.wType         := _wType;
          UniDic.AddString[1]  := _descr;
          UniDic.sName         := 'Voenkom';
          UniDic.AddComp[1]    := Catalogs.nRec;
          UniDic.AddString[2]  := Catalogs.Name;
          UniDic.AddString[3]  := Catalogs.LongName;
        Insert Current UniDic;
      }
    }
    _i++;
    if _i >= GetMarkerCount(mVoenk) then break;
  }
}

Procedure DelPicked(_w : word);
{

  Delete From UniDic where ((      _w           == UniDic.wType
                                  and _descr    == UniDic.AddString[1] (noIndex)
                                  and 'Voenkom' == UniDic.sName        (noIndex)
                              ));
}

HandleEvent
cmInit:
{
  DelPicked(_wType);
  mVoenk := InitMarker('CatalogsMarker', 8, 30, 10);
  ClearMarker(mVoenk);
  DoneMarker(mVoenk, 'CatalogsMarker');
}

cmPick:
{
  case CurField of
    #_sVoenkom:
      {
        ClearMarker(mVoenk);
        DelPicked(_wType);
        RunInterface('Z_STAFFCAT::PickCatalog2', -56, 0, 100, 0);
        mVoenk := InitMarker('CatalogsMarker', 8, 30, 10);
        UpdateFiltersState;
        InsPicked();
        DoneMarker(mVoenk, 'CatalogsMarker');
      }
  end;
}

cmDelOnProtect:
{
  case CurField of
    #_sVoenkom:
    {
      ClearMarker(mVoenk);
      UpdateFiltersState;
      DelPicked(_wType);
    }
  end;
}

cmGo:
{
  PutCommand(cmClose);
}

end;
End.
