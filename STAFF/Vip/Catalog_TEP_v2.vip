Show At (71,35,,65);

Table Spec712;

Fields
  Kau712.Code             '№ п/п'              ('№ п/п'             ,,sci178)  : [5] , Protect, noPickButton;
  Kau712.Name             'Показатели работ'   ('Показатели работ'  ,,sci1378) : [40], Protect, noPickButton;
  KatEd712.Abbr           'Единицы измерения'  ('Единицы измерения' ,,sci1378) : [5] , Protect, PickButton;
  Spec712.AddDouble[1]    'ТЭП План'           ('ТЭП План'          ,,sci1378) : [10 , '\2p[|-]36`666`666`666`666`666.88'], noProtect, noPickButton;
  Spec712.AddDouble[2]    'ТЭП Факт'           ('ТЭП Факт'          ,,sci1378) : [10 , '\2p[|-]36`666`666`666`666`666.88'], noProtect, noPickButton;
End; //brTepSpec2

TableEvent Table Head713;
cmSetDefault:
{
  AsSetDefault713;
}

cmDeleteRecord:
{
  if (boGetTune(_sCodeTune) = true) then
  {
    if (message('Удалить текущую запись?', YesNo) = cmYes) then
    {
      StartNewVisual(vtRotateVisual, vfTimer, 'Удаление записи', 0);
      Delete Spec713 where ((Head713.nRec == Spec713.cHead));
      Delete Current Head713;
      StopVisual;
    }
    else
      Abort;
  }
  else
  {
    Message('Вы не имеете права удалять записи ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
}
End; //TableEvent Head713

TableEvent Table Head712;
cmSetDefault:
{
  AsSetDefault712;
}

cmDeleteRecord:
{
  if (boGetTune(_sCodeTune) = true) then
  {
    if (message('Удалить текущую запись?', YesNo) = cmYes) then
    {
      StartNewVisual(vtRotateVisual, vfTimer, 'Удаление записи', 0);
      Delete Spec712 where ((Head712.nRec == Spec712.cHead));
      Delete Current Head712;
      StopVisual;
    }
    else
      Abort;
  }
  else
  {
    Message('Вы не имеете права удалять записи ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
}
End; //TableEvent Head712

HandleEvent
cmPick:
{
  if (boGetTune(_sCodeTune) = true) then
  {
    case CurField of
      #Podr713.Kod :
      {
        var _cRec : comp = 0h;
        if (iGetKau.GetCodeKau(cgiPick, cgKau_KatPodr, _cRec) <> 0 ) then
        {
          if (getFirst KatPodr1 where ((_cRec == KatPodr1.nRec)) = tsOk) then
          {
            if (Length(KatPodr1.Kod) > 3) then
            {
              Message('Допускается выбирать только "трехзначные" подразделения'#13 +
                       'Выбранное подразделение будет заменено на ' + SubStr(KatPodr1.Kod, 1, 3), Warning);
              var _s : string = SubStr(KatPodr1.Kod, 1, 3);
              if (getFirst KatPodr1 where ((_s == KatPodr1.Kod)) = tsOk) then
              {
                Set Head713.cPodr := KatPodr1.nRec;
                Update Current Head713;
              }
            }
            Set Head713.cPodr := KatPodr1.nRec;
            Update Current Head713;
          }
        }
      }
      #Podr712.Kod :
      {
        var _cRec : comp = 0h;
        if (iGetKau.GetCodeKau(cgiPick, cgKau_KatPodr, _cRec) <> 0 ) then
        {
          if (getFirst KatPodr1 where ((_cRec == KatPodr1.nRec)) = tsOk) then
          {
            if (Length(KatPodr1.Kod) > 3) then
            {
              Message('Допускается выбирать только "трехзначные" подразделения'#13 +
                       'Выбранное подразделение будет заменено на ' + SubStr(KatPodr1.Kod, 1, 3), Warning);
              var _s : string = SubStr(KatPodr1.Kod, 1, 3);
              if (getFirst KatPodr1 where ((_s == KatPodr1.Kod)) = tsOk) then
              {
                Set Head712.cPodr := KatPodr1.nRec;
                Update Current Head712;
              }
            }
            Set Head712.cPodr := KatPodr1.nRec;
            Update Current Head712;
          }
        }
      }

      /*#Period713.Name :
      {
        var _cRec : comp = 0h;
        if (iGetKau.GetCodeKau(cgiPick, cgKau_FpPeriod, _cRec) <> 0 ) then
        {
          Set Head713.AddComp[1] := _cRec;
          Set Head713.AddWord[1] := Month(Period713.dBeg);
          Set Head713.AddWord[2] := Year(Period713.dBeg);
          Set Head713.AddDate[1] := Period713.dBeg;
          Set Head713.AddDate[2] := Period713.dEnd;
          Update Current Head713;
        }
      }*/
      #Period712.Name :
      {
        var _cRec : comp = 0h;
        if (iGetKau.GetCodeKau(cgiPick, cgKau_FpPeriod, _cRec) <> 0 ) then
        {
          Set Head712.AddComp[1] := _cRec;
          Set Head712.AddWord[1] := Month(Period712.dBeg);
          Set Head712.AddWord[2] := Year(Period712.dBeg);
          Set Head712.AddDate[1] := Period712.dBeg;
          Set Head712.AddDate[2] := Period712.dEnd;
          Update Current Head712;
        }
      }

      #KatEd713.Abbr :
      {
        var _cRec : comp = 0h;
        if (RunInterface('L_MCU::GETEDIZM', _cRec) = cmDefault) then
        {
          Set Spec713.AddComp[2] := _cRec;
          Update Current Spec713;
        }
      }
      #KatEd712.Abbr :
      {
        var _cRec : comp = 0h;
        if (RunInterface('L_MCU::GETEDIZM', _cRec) = cmDefault) then
        {
          Set Spec712.AddComp[2] := _cRec;
          Update Current Spec712;
        }
      }
    end;
  }
  else
  {
    Message('Вы не имеете права редактировать ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
  ReReadRecord;
}

cmCheckField:
{
  if (boGetTune(_sCodeTune) = true) then
  {
    case CurField of
      #Head713.DocNumb:
      {
        Update Current Head713;
      }
      #Head712.DocNumb:
      {
        Update Current Head712;
      }

      #Spec713.AddDouble[1], #Spec713.AddDouble[2]:
      {
        Update Current Spec713;
      }
      #Spec712.AddDouble[1], #Spec712.AddDouble[2]:
      {
        Update Current Spec712;
      }
      #Head713.AddDate[1] :
      {
        if (Head713.AddDate[2] < Head713.AddDate[1])
        {
          Message('Дата начала не может быть больше даты окончания');
          Abort; Exit;
        }
        Update Current Head713;
      }
      #Head713.AddDate[2] :
      {
        if (Head713.AddDate[2] < Head713.AddDate[1])
        {
          Message('Дата начала не может быть больше даты окончания');
          Abort; Exit;
        }
        Update Current Head713;
      }
    end;

    case CurTable of
      #Spec713:
      {
        PushPos(#Spec713);
        RecalcSum(Head713.nRec);
        PopPos(#Spec713);
      }
    end;

    ReReadRecord;
  }
  else
  {
    Message('Вы не имеете права редактировать ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
}
End; //HandleEvent
End.
