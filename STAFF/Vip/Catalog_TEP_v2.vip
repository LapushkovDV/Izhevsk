  KatEd713.Abbr           'Единицы измерения'  ('Единицы измерения' ,,sci1378) : [5] , Protect, PickButton;
  Spec713.AddDouble[1]    'ТЭП План'           ('ТЭП План'          ,,sci1378) : [10 , '\2p[|-]36`666`666`666`666`666.88'], noProtect, noPickButton;
  Spec713.AddDouble[2]    'ТЭП Факт'           ('ТЭП Факт'          ,,sci1378) : [10 , '\2p[|-]36`666`666`666`666`666.88'], noProtect, noPickButton;
