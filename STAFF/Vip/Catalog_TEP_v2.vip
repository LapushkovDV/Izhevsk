  Head713.DocNumb    'Номер документа' ('Номер документа',,) : [10], noProtect, noPickButton;
  Podr713.Kod        'Подразделение'   ('Подразделение',,)   : [30],   Protect,   PickButton;
  //Period713.Name  'Период'          ('Период',,)          : [30],   Protect,   PickButton;
  Head713.AddDate[1] 'Дата с ' ('Дата с ',,) : [15], noProtect;
  Head713.AddDate[2] 'Дата по' ('Дата по',,) : [15], noProtect;
