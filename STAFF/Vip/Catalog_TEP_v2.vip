#doc
Каталог ТЭП для отчетов по заказу Петра Борисовича
#end

#include Query.vih
#include GetKau.Vih
#include Marker.Vih

Interface Catalog_TEP 'Каталог ТЭП';
Show(,,150,66);

Const
  wKodGrKau1 = 10733;
  wKodGrKau2 = 10734;
End;

#include GetKau.Var

Create View
Var
  _sCodeTune     : string = 'NPOEM_OWN.KAT.TEP.ACCESS';
As
Select
  1
From
  SpKau          Kau713
, EM_UNIDOC_HEAD Head713
, EM_UNIDOC_SPEC Spec713
, KatEd          Kated713
, KatPodr        Podr713
//, FpPeriod       Period713

, SpKau          Kau712
, EM_UNIDOC_HEAD Head712
, EM_UNIDOC_SPEC Spec712
, KatEd          Kated712
, KatPodr        Podr712
, FpPeriod       Period712

, KatPodr KatPodr1

, EM_UNIDOC_SPEC SpUniDoc1
Where
((
        wKodGrKau1         == Kau713.KodGrKau (noIndex)
    and 713                == Head713.wType
    and Head713.cPodr      == Podr713.nRec
    //and Head713.AddComp[1] == Period713.nRec
    and Head713.nRec       == Spec713.cHead
    and Spec713.AddComp[1] == Kau713.nRec
    and Spec713.AddComp[2] == Kated713.nRec

    and wKodGrKau2         == Kau712.KodGrKau (noIndex)
    and 712                == Head712.wType
    and Head712.cPodr      == Podr712.nRec
    and Head712.AddComp[1] == Period712.nRec
    and Head712.nRec       == Spec712.cHead
    and Spec712.AddComp[1] == Kau712.nRec
    and Spec712.AddComp[2] == Kated712.nRec
))
;

Procedure RecalcSum(_c : comp);
{
  var _sp, _sf : double;
  var _i : word;
  _Loop Spec713 where ((_c == Spec713.cHead))
  {
    if (Spec713.AddComp[3] = 0h) then
    {
      _sp := 0.0;
      _sf := 0.0;
      _i  := 0;
      _Loop SpUniDoc1 where ((_c == SpUniDoc1.cHead and Spec713.AddComp[1] == SpUniDoc1.AddComp[3] (noIndex)))
      {
        _sp := _sp + SpUniDoc1.AddDouble[1];
        _sf := _sf + SpUniDoc1.AddDouble[2];
        _i ++;
      }
      if (_i > 0) then
      {
        Set Spec713.AddDouble[1] := _sp;
        Set Spec713.AddDouble[2] := _sf;
        Update Current Spec713;
      }
    }
  }
}

Procedure AsSetDefault713;
{
  if (boGetTune(_sCodeTune) = true) then
  {
    StartNewVisual(vtRotateVisual, vfTimer, 'Формирование спецификации', 0);
    ClearBuffer(#Head713);
      Head713.nRec     := 0h;
      Head713.wType    := 713;
      Head713.DocNumb  := '';
    Insert Current Head713;
    SetNew(false);

    _Loop Kau713 where ((wKodGrKau1 == Kau713.KodGrKau)) ordered by Kau713.LevelCode
    {
      ClearBuffer(#Spec713);
        Spec713.nRec        := 0h;
        Spec713.cHead       := Head713.nRec;
        Spec713.AddComp[1]  := Kau713.nRec;
        Spec713.AddComp[3]  := Kau713.cNode;
        Spec713.AddWord[10] := Head713.wType;
        if (getLast SpUniDoc1 where ((      Kau713.nRec   == SpUniDoc1.AddComp[1] (noIndex)
                                        and Head713.wType == SpUniDoc1.AddWord[10] (noIndex)
                                    )) = tsOk) then
        {
          Spec713.AddComp[2] := SpUniDoc1.AddComp[2];
        }
      Insert Current Spec713;
      SetNew(false);
    }
    StopVisual;
  }
  else
  {
    Message('Вы не имеете права редактировать ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
}

Procedure AsSetDefault712;
{
  if (boGetTune(_sCodeTune) = true) then
  {
    StartNewVisual(vtRotateVisual, vfTimer, 'Формирование спецификации', 0);
    ClearBuffer(#Head712);
      Head712.nRec     := 0h;
      Head712.wType    := 712;
      Head712.DocNumb  := '';
    Insert Current Head712;
    SetNew(false);

    _Loop Kau712 where ((wKodGrKau2 == Kau712.KodGrKau)) ordered by Kau712.LevelCode
    {
      ClearBuffer(#Spec712);
        Spec712.nRec        := 0h;
        Spec712.cHead       := Head712.nRec;
        Spec712.AddComp[1]  := Kau712.nRec;
        Spec712.AddComp[3]  := Kau712.cNode;
        Spec712.AddWord[10] := Head712.wType;
        if (getLast SpUniDoc1 where ((      Kau712.nRec   == SpUniDoc1.AddComp[1] (noIndex)
                                        and Head712.wType == SpUniDoc1.AddWord[10] (noIndex)
                                    )) = tsOk) then
        {
          Spec712.AddComp[2] := SpUniDoc1.AddComp[2];
        }
      Insert Current Spec712;
      SetNew(false);
    }
    StopVisual;
  }
  else
  {
    Message('Вы не имеете права редактировать ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
}


