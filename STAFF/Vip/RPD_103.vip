#component "Z_StaffOrders"
#include MoneyRound.vih
#include RPD.vih

#doc
  Интерфейс приказа "Компенсация стоимости гостиничных услуг"
#end


VipInterface RPD_103(RPD_Base_Payment)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base3.PrintRPD(typePrint: TPtr; fcEnter: word);
end;

Interface RPD_103 '' escclose;

//******************************************************************************
// Окно содержимого приказа на назначение персональных надбавок
//******************************************************************************
screen scrDet103 (,hcStaffWinPr, sci178Esc);  //Награждение/поощрение, премирование
show at (, 5,,);
table Fortune;
  fields
    FortRaiseCat.Name ('Вид выплаты',,
                        sci1378Esc),  protect;
    FortForRaiseCat.Name ('Основание для выплаты',, sci1378Esc),  protect;
    Fortune.DocSum ('Сумма/процент', ) : [11.2], noprotect;
    CurrNameFort ('Валюта или проценты.',, sci1378Esc) ,Protect;
    Fortune.Dat1 ('Дата выплаты',, sci1378Esc):
                  [10,'DD/MM/YYYY'], noprotect;
    Fortune.FilialNo ('Выплатить в модуле "ЗП" в межпериод', ), noprotect;
    Fortune.SNote ('Примечание ', ), noprotect;
    ContDoc.SBottom ('Основание', ), noprotect;
    WorkDay: skip;
    WorkHour: skip;
    FortuneDocName.Name: skip;
  buttons
    cmViewAdvance1,,, 'Просмотр примечания к приказу', hcStaffWinPr;
    cmValue21,,, 'Дополнительные условия по приказу';

<<
 Наименование         .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Основание для выплаты.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Сумма(процент)       .@@@@@@@@@@@@ .@@@@@@@@@@@@@
 Дата                 .@@@@@@@@@@@@ [.] Выплата в межпериод`
 Примечание
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Основание
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 .@@@ .@@@ .@@@
              <. Примечание .>            <. Доп. условия .>
>>
end; // screen scrDet35

//******************************************************************************
// Печать приказа
//******************************************************************************

  procedure PrintRPD(typePrint: TPtr; fcEnter: word);
  { #__UNUSED__(typePrint, fcEnter)
    var RaiseStr: array[0..8] of string;
    var Kol: integer; //для подсчета количества итераций
    case typePrint of
      0:
      {
        RunInterface('GP_NFormRD103', TitleDoc.Nrec, PartDoc.TypeOper);
      }
    end;
  }


//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  SetFieldAndLabelVisible(#WorkDay, false);
  SetFieldAndLabelVisible(#WorkHour, false);
  SetFieldAndLabelVisible(#WorkHour, false);
  SetFieldAndLabelVisible(#FortuneDocName.Name, false);
  if fnFieldsOpen
  {
    SetFieldOption(#FortRaiseCat.Name, ofSelectable);
    SetFieldOption(#FortForRaiseCat.Name, ofSelectable);
    SetFieldOption(#Fortune.DocSum, ofSelectable);
    SetFieldOption(#CurrNameFort, ofSelectable);
    SetFieldOption(#Fortune.Dat1, ofSelectable);
    SetFieldOption(#Fortune.SNote, ofSelectable);
    SetFieldOption(#ContDoc.SBottom, ofSelectable);
    SetFieldOption(#Fortune.FilialNo, ofSelectable);
    SetFieldOption(#ContDoc.wAttrDoc2, ofSelectable);
    SetHelpAndStatusContext(brPsn, -1, sci1378Esc, 'StaffWinPr');
    EnableCommand(cmValue45);
  }
  else //утвержден
  {
    ClearFieldOption(#FortRaiseCat.Name, ofSelectable);
    ClearFieldOption(#FortForRaiseCat.Name, ofSelectable);
    ClearFieldOption(#Fortune.DocSum, ofSelectable);
    ClearFieldOption(#CurrNameFort, ofSelectable);
    ClearFieldOption(#Fortune.Dat1, ofSelectable);
    ClearFieldOption(#Fortune.SNote, ofSelectable);
    ClearFieldOption(#ContDoc.SBottom, ofSelectable);
    ClearFieldOption(#Fortune.FilialNo, ofSelectable);
    ClearFieldOption(#ContDoc.wAttrDoc2, ofSelectable);
    DisableCommand(cmValue45);
    /* необходимо для случая, когда спозиционированы на утвержденной позиции частично утвержденного группового
    приказа */
    if  (boUsePartOrders and TitleDoc.wStatus = 3)
      SetHelpAndStatusContext(brPsn, -1, sci178Esc, 'StaffWinPr');
    else
      SetHelpAndStatusContext(brPsn, -1, sci18Esc, 'StaffWinPr');
  }
}

TableEvent table Fortune;
  cmSetDefault:
  {
    //message('Докомпилировали обработчик');
    inherited::HandleEvent(cmSetDefault);
    Fortune.wChoice := 20;
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD103');
    if (ParentSav <> 0)
    {
      set Fortune.cfType := ParentSav;
      set Fortune.wAttr1 := CheckTypeRaise(ParentSav);
    }
  }
end;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    cmOnVipLoad:
    {
      if inherited::handleEvent(cmOnVipLoad) = heAbort
        abort;
      lFlag4Signal := 4;
      iFortRaiseSysCode := -17;
      iFortForRaiseSysCode := -144;
    }

    cmMulSelDO:
    {
      if UpdateTable
        UpdNeedField(CurField);
    }
    cmCalc:
    {
      update current ContDoc set TypeOper = 20;
      inherited::Handleevent(cmCalc);
//      Message(PartDoc.nrec);
      update ContDoc where ((PartDoc.nrec == contdoc.cPart)) set TypeOper = 103;
      _loop Contdoc where ((PartDoc.nrec == contdoc.cPart))
        NOAA.DeleteAgreementLinks(coContDoc, ContDoc.nrec)
    }
    cmHotKeys:
    {
      var menuID: longint;
      menuID := LoadMenu('RPD_MenuCopy');

      prFillMenu(menuID);

      PutHotCommand(RunLoadMenu(menuID));
    }



  end;

End.
