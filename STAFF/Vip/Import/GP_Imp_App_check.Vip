VipInterface GP_Imp_App_check Licensed(free);
Interface GP_Imp_App_check 'Проверка назначений';

//----------------------------------
table struct tmp_jour
(  CitezenID:comp// CitezenID
  ,Fio :string[60]
  ,BornDate:date
  ,APPID  :longint
  ,STAFFID:longint
  ,DEPTID :longint
  ,POSTID :longint
  ,sSovm  :string
  ,FLD :string[100]
  ,PRIM:string
)
with index
( tmp_jour01 = Fio + BornDate
);
var
#include excel_var.vpp


create view
as select Persons.Nrec
From Persons(PERSBYFIO)
 , Appointments(APNTBYDATE), AppHist (APPHISTBYDREC)
 , Appointments Appointments_N(APNTBYDATE)
 , tmp_jour(tmp_jour01)
where ((
    'С' <<=Persons.ISEMPLOYEE
and 'У' >>=Persons.ISEMPLOYEE
and Persons.Nrec == Appointments.Person
and 4>> Appointments.LPrizn
and Appointments.Nrec == AppHist.cAppoint
and Persons.Nrec == Appointments_N.Person
and Appointments.LPrizn == Appointments_N.LPrizn
and Appointments.AppointDate << Appointments_N.AppointDate

)) ;

#include excel_Fun.vpp


Procedure Ins_Jour(
   _FLD :string
  ;_PRIM:string
);
{
  tmp_jour.CitezenID:=Persons.Nrec;// CitezenID
  tmp_jour.Fio      :=Persons.Fio;
  tmp_jour.BornDate :=Persons.BornDate;
  tmp_jour.APPID    :=Appointments.Nrec;
  tmp_jour.STAFFID  :=Appointments.StaffStr;
  tmp_jour.DEPTID   :=Appointments.Department;
  tmp_jour.POSTID   :=Appointments.Post;
  tmp_jour.sSovm    :=if(Appointments.Lprizn=3,'Совместительство','Основное');
  tmp_jour.FLD      :=_Fld ;
  tmp_jour.PRIM     :=_Prim;
  insert current tmp_jour;
} //Procedure Ins_Jour

Procedure FormDoc;
{ delete all tmp_jour;
  _Loop fullcache Persons
  { if not nextvisual then break;
    var _First:boolean=true;
    _loop Appointments
    { if _First
      { if Appointments.Lprizn=0
        and Appointments.AppointDate>=Persons.AppDate
        { if Persons.AppointFirst<>Appointments.Nrec
          { update current Persons set Persons.AppointFirst:=Appointments.Nrec;
            Ins_Jour('обновили первое назначение',DateToStr(Appointments.AppointDate,'DD/MM/YYYY'));

          }
          _First:=false;
        }
      }
      if getfirst Appointments_N=tsok
      { if Appointments.DisMissDate=ZeroDate
        or Appointments.DisMissDate>Appointments_N.AppointDate
        { Ins_Jour('обновили дату ухода',DateToStr(appointments.DISMISSDATE,'DD/MM/YYYY')+DateToStr(Sub_Day(Appointments_N.AppointDate,1),'->DD/MM/YYYY'));
          update current Appointments
             set Appointments.DisMissDate:=Sub_Day(Appointments_N.AppointDate,1);

        }
      }
      var _first_hist:boolean=true;
      var _CodOper:word=1;
      _Loop fullcache AppHist
      { if _first_hist
        { if Appointments.Nrec = Persons.AppointFirst
          { _CodOper:=1;
          }
          else
          //Для совместителей будет всегда прием в первой записи.
          { _CodOper:=if(Appointments.lPrizn=3,4,5);
          }
          _first_hist:=false
        }
        else
        { _CodOper:=46; //изменение условий.
        }
        if AppHist.CodOper<>_CodOper
        { update current AppHist set AppHist.CodOper:=_CodOper;
        }
      } //_Loop fullcahce AppHist
    } //_loop Appointments
  } //_Loop Persons
  iNextVisual('Вывод протокола');

  ExcelInit('GP_IMP_JOUR.Xlsx',true);
  wexrow:=1;;
  HeaderStrCount:=wexrow;
  MyXlCreaMatrix(1000, 12);
  matrixkl:=true;
  MyPutExcel('CitezenID',10,0,-1,-1);// CitezenID
  MyPutExcel('Fio'      ,10,0,-1,-1);
  MyPutExcel('BornDate' ,10,0,-1,-1);
  MyPutExcel('APPID'    ,10,0,-1,-1);
  MyPutExcel('STAFFID'  ,10,0,-1,-1);
  MyPutExcel('DEPTID'   ,10,0,-1,-1);
  MyPutExcel('POSTID'   ,10,0,-1,-1);
  MyPutExcel('sSovm'    ,10,0,-1,-1);
  MyPutExcel('FLD'      ,10,0,-1,-1);
  MyPutExcel('PRIM'     ,10,0,-1,-1);
  _Loop tmp_jour
  { //---------------------
    wexrow++;
    wexcol:=1;
    timelog('Журнал '+tmp_jour.Fio);
    if not nextvisual then break;

    MyPutExcel(tmp_jour.CitezenID,10,0,-1,-1);// CitezenID
    MyPutExcel(tmp_jour.Fio      ,10,0,-1,-1);
    MyPutExcel(tmp_jour.BornDate ,10,0,-1,-1);
    MyPutExcel(tmp_jour.APPID    ,10,0,-1,-1);
    MyPutExcel(tmp_jour.STAFFID  ,10,0,-1,-1);
    MyPutExcel(tmp_jour.DEPTID   ,10,0,-1,-1);
    MyPutExcel(tmp_jour.POSTID   ,10,0,-1,-1);
    MyPutExcel(tmp_jour.sSovm    ,10,0,-1,-1);
    MyPutExcel(tmp_jour.FLD      ,10,0,-1,-1);
    MyPutExcel(tmp_jour.PRIM     ,10,0,-1,-1);
  }
  MyxlWriteMatrix(wexrow);
  xlFreeMatrix;
  matrixkl:=false;
  MyxlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, HeaderStrCount+1 ,1,wexrow,9); //Обрамление

  MyXLEnd;

} //Procedure FormDoc;


Screen scrParam;
Table Persons;
Buttons
  cmOk    ,,, 'Установить фильтр', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;

<<
 Проверка назначений

 <. Продолжить .>  <.   Отмена   .>
>>
end;
HandleEvent
cmInit:
{ Timelog_Init;
}
cmOk:
{
    StartNewVisual(vtIndicatorVisual, vfTimer, 'Ждите, идет сбор данных', RecordsInTable(#Persons)*2);
    FormDoc;
    StopVisual('',0);
}
end;
end.
