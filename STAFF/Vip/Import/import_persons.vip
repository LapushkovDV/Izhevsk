_loop persons where (('С'==persons.isemployee)) ordered by persons.fio
{
nextvisual;
persons.tabnmb:=persons.strtabn;
persons.strtabn:=Counter;
update current persons;
Counter++;
}

_loop persons where (('У'==persons.isemployee)) ordered by persons.fio
{
nextvisual;
persons.tabnmb:=persons.strtabn;
persons.strtabn:=Counter;
update current persons;
Counter++;
}


_loop lschet
{
nextvisual;
lschet.tabn:=double(lschet.strtabn);
	if getfirst persons where ((lschet.tperson==persons.nrec))=tsok
	{
		if lschet.sovm=0
		{
		lschet.strtabn:=persons.strtabn;
		}
		else
		{
		lschet.strtabn:=persons.strtabn+'_1';
		}
	}
update current lschet;
}
*/
StopVisual('',0);


}

end;
end.




.form import_persons
.nameinlist 'import_persons'
.ard
.begin
runinterface(import_persons);
end.
.endform