Interface import_persons   escclose;


 
create view jView

var
Counter : longint;
ExcelPath:string;

NrecPers:longint;
DataPostS:string;
DataUvS:string;
DataBornS:string;
Famil:string;
SexS:string;
Status:string;
VidRab:string;
TabNom:string;
NrecNazn:longint;

Nrec_NPO_K:comp;
Nrec_NPO_Z:comp;

from  persons, lschet;



HandleEvent

CmInit:
{

Nrec_NPO_Z:=2814749767106566;
Nrec_NPO_K:=2814749767342785;




ExcelPath:='d:\Source20112017\';
    StartNewVisual(vtNumericVisual,vfTimer,'Идёт импорт', 1);

    xlCreateExcelWithTemplate(ExcelPath+'person.xlsx',true)
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');


Counter:=2;

do
{
nextvisual;
xlgetcellvalue(Counter, 2,NrecNazn   );
xlgetcellvalue(Counter, 31,NrecPers   );
xlgetcellvalue(Counter, 41,DataPostS   );
xlgetcellvalue(Counter, 10,DataUvS    );
xlgetcellvalue(Counter, 6,DataBornS   );
xlgetcellvalue(Counter, 3,Famil    );
xlgetcellvalue(Counter, 26,SexS    );
xlgetcellvalue(Counter, 30,Status    );
xlgetcellvalue(Counter, 8,VidRab    );
xlgetcellvalue(Counter, 27,TabNom    );

if NrecPers=0
{
break;
}

	if(Status='Активный') 
	{
		if (VidRab='Основное место' or VidRab='Админ. отпуск')
		{
			if getfirst persons where ((NrecPers==persons.nrec))<>tsok
			{
			clearbuffer(#persons);
			persons.nrec:=NrecPers;
			persons.fio:=Famil;
			persons.Sex:=SexS;
			persons.strtabn:=tabnom;
			persons.ISEMPLOYEE:='С';
			persons.department:=Nrec_NPO_K;
			persons.galdep:=Nrec_NPO_Z;
			persons.appdate:=date(substr(DataPostS,1,2),substr(DataPostS,4,2),substr(DataPostS,7,4));
			persons.disdate:=date(substr(DataUvS,1,2),substr(DataUvS,4,2),substr(DataUvS,7,4));
			persons.borndate:=date(substr(DataBornS,1,2),substr(DataBornS,4,2),substr(DataBornS,7,4));
			persons.gr:=2814749767347881;
			insert current persons;

			clearbuffer(#LSCHET);
		        lschet.nrec:=NrecNazn;
			LSCHET.strtabn:=persons.strtabn;
			LSCHET.CEX:=persons.galdep;
			lschet.datpos:=persons.appdate;
			lschet.sovm:=0;
			LSCHET.DATN13:=persons.appdate;
			LSCHET.DATNVIS:=persons.appdate;
			LSCHET.TPERSON:=persons.nrec;
			LSCHET.LGSSUDA:=1;
			LSCHET.CHAR9:=9;
			LSCHET.SUMMA34:=1;
			insert current LSCHET;
			xlsetcellStringValue('Лицевой счет вставлен',Counter,43,Counter,43);				


			xlsetcellStringValue('Вставлено',Counter,42,Counter,42);
			}
			else
			{
			xlsetcellStringValue('Уже есть',Counter,42,Counter,42);
			}
		}
		else
		{
		xlsetcellStringValue('Совместитель',Counter,42,Counter,42);		
		}
	}



	NrecPers:=0;
Counter:=Counter+1;

}
while counter<100000

StopVisual('',0);
    StartNewVisual(vtNumericVisual,vfTimer,'Идёт импорт. второй этап', 1);

Counter:=2;

	do
	{
	nextvisual;
	xlgetcellvalue(Counter, 2,NrecNazn   );
	xlgetcellvalue(Counter, 31,NrecPers   );
	xlgetcellvalue(Counter, 41,DataPostS   );
	xlgetcellvalue(Counter, 10,DataUvS    );
	xlgetcellvalue(Counter, 6,DataBornS   );
	xlgetcellvalue(Counter, 3,Famil    );
	xlgetcellvalue(Counter, 26,SexS    );
	xlgetcellvalue(Counter, 30,Status    );
	xlgetcellvalue(Counter, 8,VidRab    );
	xlgetcellvalue(Counter, 27,TabNom    );

	if NrecPers=0
	{
	break;
	}

	
	if(Status='Активный') 
	{

		if(VidRab='Совместитель')
		{
	        	if getfirst persons where ((NrecPers==persons.nrec))=tsok
	        	{
				if getfirst lschet where ((NrecNazn==lschet.nrec))<>tsok
				{
				clearbuffer(#LSCHET);
			        lschet.nrec:=NrecNazn;
				LSCHET.strtabn:=TabNom;
				LSCHET.CEX:=persons.galdep;
				lschet.datpos:=date(substr(DataPostS,1,2),substr(DataPostS,4,2),substr(DataPostS,7,4));
				lschet.sovm:=1;
				LSCHET.DATN13:=lschet.datpos;
				LSCHET.DATNVIS:=lschet.datpos;
				LSCHET.TPERSON:=persons.nrec;
				LSCHET.LGSSUDA:=1;
				LSCHET.CHAR9:=9;
				LSCHET.SUMMA34:=1;
				//insert current LSCHET;
				}
			xlsetcellStringValue('Лицевой счет совместителя вставлен',Counter,43,Counter,43);				
	        	}
			else
			{
			clearbuffer(#persons);
			persons.nrec:=NrecPers;
			persons.fio:=Famil;
			persons.Sex:=SexS;
			persons.strtabn:=tabnom;
			persons.ISEMPLOYEE:='С';
			persons.department:=Nrec_NPO_K;
			persons.galdep:=Nrec_NPO_Z;
			persons.appdate:=date(substr(DataPostS,1,2),substr(DataPostS,4,2),substr(DataPostS,7,4));
			persons.disdate:=date(substr(DataUvS,1,2),substr(DataUvS,4,2),substr(DataUvS,7,4));
			persons.borndate:=date(substr(DataBornS,1,2),substr(DataBornS,4,2),substr(DataBornS,7,4));
			persons.gr:=2814749767347881;
			insert current persons;

			clearbuffer(#LSCHET);
		        lschet.nrec:=NrecNazn;
			LSCHET.strtabn:=persons.strtabn;
			LSCHET.CEX:=persons.galdep;
			lschet.datpos:=persons.appdate;
			lschet.sovm:=1;
			LSCHET.DATN13:=persons.appdate;
			LSCHET.DATNVIS:=persons.appdate;
			LSCHET.TPERSON:=persons.nrec;
			LSCHET.LGSSUDA:=1;
			LSCHET.CHAR9:=9;
			LSCHET.SUMMA34:=1;
			insert current LSCHET;
			xlsetcellStringValue('Внешний совместитель?',Counter,43,Counter,43);				


			}
		}
	Counter:=Counter+1;
	continue;
	}

	if(Status='Проектный') 
	{
	xlsetcellStringValue('Проектный',Counter,42,Counter,42);		
	Counter:=Counter+1;
	continue;
	}


	if(Status='Архивный') 
	{

		if getfirst persons where ((NrecPers==persons.nrec))=tsok
		{
			if(persons.ISEMPLOYEE='С')
			{
			xlsetcellStringValue('Есть активный',Counter,42,Counter,42);		
			}
			else
			{
				if(date(substr(DataUvS,1,2),substr(DataUvS,4,2),substr(DataUvS,7,4))>persons.disdate)
				{
				persons.disdate:=date(substr(DataUvS,1,2),substr(DataUvS,4,2),substr(DataUvS,7,4));
				//update current persons;

					if getfirst lschet where ((persons.nrec==lschet.tperson))=tsok
					{
					lschet.datuv:=persons.disdate;
					lschet.nrec:=NrecNazn;
				//	update current lschet;
					}

				xlsetcellStringValue('Архив. Дата больше',Counter,42,Counter,42);
				}
				else
				{
				xlsetcellStringValue('Архив. Дата меньше',Counter,42,Counter,42);				
				}
			}
		}
		else
		{
			clearbuffer(#persons);
			persons.nrec:=NrecPers;
			persons.fio:=Famil;
			persons.Sex:=SexS;
			persons.strtabn:=tabnom;
			persons.ISEMPLOYEE:='У';
			persons.department:=Nrec_NPO_K;
			persons.galdep:=Nrec_NPO_Z;
			persons.appdate:=date(substr(DataPostS,1,2),substr(DataPostS,4,2),substr(DataPostS,7,4));
			persons.disdate:=date(substr(DataUvS,1,2),substr(DataUvS,4,2),substr(DataUvS,7,4));
			persons.borndate:=date(substr(DataBornS,1,2),substr(DataBornS,4,2),substr(DataBornS,7,4));
			persons.gr:=2814749767347881;
			insert current persons;
			xlsetcellStringValue('Вставлено в Архив',Counter,42,Counter,42);

			clearbuffer(#LSCHET);
		        lschet.nrec:=NrecNazn;
			LSCHET.strtabn:=persons.strtabn;
			LSCHET.CEX:=persons.galdep;
			lschet.datpos:=persons.appdate;
			lschet.sovm:=0;
			LSCHET.DATN13:=persons.appdate;
			LSCHET.DATNVIS:=persons.appdate;
			lschet.datuv:=persons.disdate;
			LSCHET.TPERSON:=persons.nrec;
			LSCHET.LGSSUDA:=1;
			LSCHET.CHAR9:=9;
			LSCHET.SUMMA34:=1;
			insert current LSCHET;
			xlsetcellStringValue('Лицевой счет вставлен',Counter,43,Counter,43);				
		}
		


	Counter:=Counter+1;
	continue;
	}






	Counter:=Counter+1;
	
	NrecPers:=0;
	}
	while counter<100000





StopVisual('',0);
xlkillExcel;



    StartNewVisual(vtNumericVisual,vfTimer,'Перенумерация табельных номеров', 1);
/*
