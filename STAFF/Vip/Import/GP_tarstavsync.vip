VipInterface GP_TarStavSync  Licensed(free);

Interface GP_TarStavSync;

create view vEm_tarstav
var t1: comp;

   select *
   from em_tarstav, Newtarstav, synonym Newtarstav   Tarstav1, tarstavsync

 bounds  BnNewTarStav =
 em_tarstav.t0001 == tarstavsync.id
 and tarstavsync.cTarstav == tarstav1.nrec
 and root  == NewTarstav.nrec

 condition CnActive = em_tarstav.t0019 = 'активный'

 condition CnArchive = em_tarstav.t0019 = 'архивный'
 ;

screen scr ('Главное окно',,sci178EnEscInsPM);
  show at (,,,1)
 buttons
    cmPick, ,, 'Добавить ссылку' ,,;
    cmActive, ,, 'Активные записи';
    cmArchive, ,, 'Архивные записи';
    cmAll, ,, 'Все записи';
    cmDelete, ,, 'Удалить ссылку';
    <<
    <.Добавить ссылку.>   <.Активные записи.>   <.Архивные записи.>   <.Все записи.>  <.Удалить ссылку.>
    >>

end;


browse bEm_tarstav ('Tarstav' ,,sci178EnEscInsPM);
  show at (1,2,,)
  Table em_tarstav;
    fields
    T0001 'ID уровня' :[4], protect;
    T0002 'Наименование тарифной сетки' :[4], protect;
    T0003 'Система оплаты' :[4], protect;
    T0004 'Тарифная сетка' :[4], protect;
    T0005 'Разряд' :[4], protect;
    T0006 'Тариф (оклад)' :[4], protect;
    T0007 'Минимальный тариф (оклад)' :[4], protect;
    T0008 'Максимальный тариф (оклад)' :[4], protect;
    T0009 'ID грейда' :[4], protect;
    T0010 'Код грейда' :[4], protect;
    T0011 'Наименование грейда' :[4], protect;
    T0012 'Группа 1-3' :[4], protect;
    T0013 'Наименование профессии' :[4], protect;
    T0014 'Применимость цехов' :[4], protect;
    T0015 'Вид профессии' :[4], protect;
    T0016 'Рабочий день' :[4], protect;
    T0017 'Группа 1-5' :[4], protect;
    T0018 'Тип производства' :[4], protect;
    T0019 'Статус' :[4], protect;
    tarstav1.codtar 'Код тарифа' :[4], protect;
    tarstav1.naitar 'Наименование тарифа' :[4], protect;
    tarstav1.sisopl 'Система оплаты' :[4], protect;
    tarstav1.razr 'Разряд' :[4], protect;
    tarstav1.kolmin 'Коэф. перерасчета' :[4], protect;
    tarstav1.tarif 'Тарифная ставка' :[4], protect;
    tarstav1.kolm 'Коэф.для мин.гарантир.окл.' :[4], protect;
    tarstav1.tarmin 'Мин.гарантир.оклад' :[4], protect;
    tarstav1.razrn 'Код разряда' :[4], protect;
    tarstav1.datizm 'Дата изменения' :[4], protect;
    tarstav1.tarmax 'Максимальный оклад' :[4], protect;
end;

Window winnewtarstav ('Список из галактики' ,,sci178EnEscInsPM)  DoAccept, EscClose, Cyan;
  Show at (,,60,20);
browse bnewtarstav ('GalNewtarstav' ,,sci178EnEscInsPM);
  show at (1,2,,)
  Table   newtarstav;
    fields
    newtarstav.codtar 'Код тарифа' :[4], protect;
    newtarstav.naitar 'Наименование тарифа' :[4], protect;
    newtarstav.sisopl 'Система оплаты' :[4], protect;
    newtarstav.razr 'Разряд' :[4], protect;
    newtarstav.kolmin 'Коэф. перерасчета' :[4], protect;
    newtarstav.tarif 'Тарифная ставка' :[4], protect;
    newtarstav.kolm 'Коэф.для мин.гарантир.окл.' :[4], protect;
    newtarstav.tarmin 'Мин.гарантир.оклад' :[4], protect;
    newtarstav.razrn 'Код разряда' :[4], protect;
    newtarstav.datizm 'Дата изменения' :[4], protect;
    newtarstav.tarmax 'Максимальный оклад' :[4], protect;
end;



end;

handleevent
    cmInit:
  {
    pushbounds(tbBnNewTarStav);
  }

  cmPick:
  {

   RunWindow(winnewtarstav);
  }

  cmActive:
  {
    popcondition(tcCnArchive);
    pushcondition(tcCnActive);
    rereadrecord() ;
  }

  cmArchive:
  {
   popcondition(tcCnActive);
   pushcondition(tcCnArchive);
   rereadrecord() ;
  }

  cmAll:
  {
   popcondition(tcCnArchive);
   popcondition(tcCnActive);
   rereadrecord() ;
  }

  cmDelete:
  {
    delete current tarstavsync;
  }
end;

windowevent winnewTarStav;

    cmDefault:
    {
      if tarstavsync.id <>0
      {
     update current tarstavsync   set   tarstavsync.id =em_tarstav.t0001, tarstavsync.cTarstav = newTarStav.nrec;
      }
      else
      {
      set   tarstavsync.id:=em_tarstav.t0001;
      set   tarstavsync.cTarstav:= newTarStav.nrec;
      if (insert  current  tarstavsync= tsOk) {};
      }
    }

end;



end.
