Interface import_app_fromperson   escclose;


 
create view jView

var
Counter : longint;
ExcelPath:string;

NrecPodr:longint;
KodPodr:string;
NamePodr:string;
PriznakPodr:string;
NrecVSPodr:longint;
cPodrNrec:comp;
RaiseNrec:longint;
Nrec_NPO_Z:comp;
Nrec_NPO_K:comp;
idApp:longint;
idKis:longint;
DataNachS,DataOkonS:string;
NumberDogS:string;
DatDogS:date;
kolvo:double;
StatusNazn, Vidnazn:string;
NrecSHr:longint;


as select * 
from  appointments, apphist,SPALLSTAFF, raise, raisehist;







HandleEvent

CmInit:
{

RaiseNrec:=100000;//для уникальности нреков
Nrec_NPO_Z:=2814749767106566;
Nrec_NPO_K:=2814749767342785;

ExcelPath:='d:\Source20112017\';
    StartNewVisual(vtNumericVisual,vfTimer,'Идёт импорт', 1);

    xlCreateExcelWithTemplate(ExcelPath+'Appointment_fromperson.xlsx',true)
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');


Counter:=2;

do
{
nextvisual;
xlgetcellvalue(Counter, 1,IdApp   );
xlgetcellvalue(Counter, 2,IdKIS   );
xlgetcellvalue(Counter, 3,NrecSHR   );
xlgetcellvalue(Counter, 4,DataNachS   );
xlgetcellvalue(Counter, 5,DataOkonS   );

xlgetcellvalue(Counter, 7,NumberDogS   );
xlgetcellvalue(Counter, 8,DatDogS   );

xlgetcellvalue(Counter,20,kolvo);
xlgetcellvalue(Counter, 6,StatusNazn );
xlgetcellvalue(Counter, 10,VidNazn );

                          

if IdApp=0
{
break;
}

kolvo:=1;

	if getfirst persons where ((IdKIs==persons.nrec))<>tsok
	{
	xlsetcellStringValue('Не найдена ФЛ по нреку!',Counter,14,Counter,14);
	Counter++;
	continue;
	}

	if getfirst appointments where ((IdApp==appointments.nrec))=tsok
	{
	xlsetcellStringValue('Дубль!',Counter,14,Counter,14);
	Counter++;
	continue;
	}

	if getfirst staffstruct where ((NrecSHR==staffstruct.nrec))<>tsok
	{
	xlsetcellStringValue('Не найдена позиция штатного расписания!',Counter,14,Counter,14);
	Counter++;
	continue;
	}	

	if StatusNazn=''
	{
	xlsetcellStringValue('Пустой вид назначения! Определен как основной',Counter,15,Counter,15);
	}	


	if date(substr(DataNachS,1,2),substr(DataNachS,4,2),substr(DataNachS,7,4))>date(substr(DataOkonS,1,2),substr(DataOkonS,4,2),substr(DataOkonS,7,4))
	{
	xlsetcellStringValue('Неправильные даты назначений!',Counter,14,Counter,14);
	Counter++;
	continue;
	}	


	clearbuffer(#appointments);
	appointments.nrec:=IdApp;
	appointments.PERSON:=persons.nrec;
	appointments.APPOINTDATE:=date(substr(DataNachS,1,2),substr(DataNachS,4,2),substr(DataNachS,7,4));
	appointments.DISMISSDATE:=date(substr(DataOkonS,1,2),substr(DataOkonS,4,2),substr(DataOkonS,7,4));
	appointments.DEPARTMENT:=staffstruct.department;
	appointments.POST:=staffstruct.post;
	appointments.EMPCATEGORY:=staffstruct.empcategory;
	appointments.PAYMODEL:=staffstruct.paymodel;
	appointments.TAXRATE:=staffstruct.TAXRATE;
	appointments.TARIFF:=staffstruct.tariff;
	appointments.CATEGORY:=staffstruct.CATEGORY;
	appointments.EMPRATE:=Kolvo;
	appointments.STAFFSTR:=staffstruct.nrec;
	appointments.RATE:=kolvo;
        appointments.WADDWORD1:=1;
	appointments.WORKCOND:=staffstruct.WORKCOND;
	appointments.WORKREGIME:=staffstruct.workregime;


	if statusNazn='Совм.'
	{
		if getfirst lschet where ((persons.nrec==lschet.tperson and 1==lschet.sovm(noindex)))=tsok
		{
		appointments.CADDNREC2:=lschet.nrec;
		appointments.APPTABNMB:=lschet.strtabn;
		appointments.STRTABN:=lschet.strtabn;
		appointments.lprizn:=3;
		}
	}
	else
	{
		if getfirst lschet where ((persons.nrec==lschet.tperson and 0==lschet.sovm(noindex)))=tsok
		{
		appointments.CADDNREC2:=lschet.nrec;
		appointments.APPTABNMB:=lschet.strtabn;
		appointments.STRTABN:=lschet.strtabn;
		}
	}
	insert current appointments;
	
	if appointments.lprizn=0
	{
	persons.appointcur:=appointments.nrec;
	persons.department:=appointments.department;
	
		if getfirst EXTCATLINKS where ((11==OBJTYPE and persons.department==EXTCATLINKS.STAFFCAT))=tsok
		{
		persons.galdep:=EXTCATLINKS.EXTCAT;
		}
	update current persons;

	}


	clearbuffer(#APPHIST);
	APPHIST.CAPPOINT:=appointments.nrec;
	APPHIST.CODOPER:=1;
	APPHIST.DREC:=appointments.appointdate;
	APPHIST.WSTATE:=1;
	APPHIST.PAYMODEL:=30;
	APPHIST.TARIFF:=appointments.tariff;
	APPHIST.CATEGORY:=appointments.category;
	APPHIST.TAXRATE:=appointments.taxrate;
	APPHIST.COEF1:=1;
	apphist.WORKCOND:=appointments.WORKCOND;
	apphist.WORKREGIME:=appointments.workregime;
	insert current APPHIST;


	_loop raisests where ((staffstruct.nrec==raisests.STAFFSTR))
	{
	clearbuffer(#raise);
	raise.PERSON:=persons.nrec;
	raise.APPOINT:=appointments.nrec;
	raise.RAISETYPE:=raisests.RAISETYPE;
	raise.FROMDATE:=date(01,09,2017);
	raise.SUM:=raisests.rsum;
	raise.RAISEATTR:=raisests.rattr;
	raise.CSTRAISE:=staffstruct.nrec;
	raise.CREF2:=raisests.nrec;
	insert current raise;

	clearbuffer(#RAISEHIST);
	RAISEHIST.CPSN:=persons.nrec;
	RAISEHIST.CRAISE:=raise.nrec;
	RAISEHIST.WTYPEOPER:=9;
	RAISEHIST.DREC:=raise.FROMDATE;
	RAISEHIST.RHSUM:=raise.sum;
	RAISEHIST.IHATTR:=raise.RAISEATTR;
	RAISEHIST.CRAISETYPE:=raise.RAISETYPE;
	RAISEHIST.CSTRAISE:=raise.CSTRAISE;
	insert current RAISEHIST;
	}

	clearbuffer(#SPALLSTAFF);
	SPALLSTAFF.RESCOMP[1]:=000A000000039921h;//предположительно нрек трудового договора
	SPALLSTAFF.wnokon:=5;
	SPALLSTAFF.RESSTRING[1]:=NumberDogS;
	SPALLSTAFF.CBASET:=persons.nrec;
	SPALLSTAFF.RESCOMP[2]:=apphist.nrec;//проверить
	insert current SPALLSTAFF;

	appointments.CDOG:=SPALLSTAFF.RESCOMP[1];
	appointments.RESCOMP[1]:=SPALLSTAFF.nrec;
	update current appointments;

	apphist.CSPR3:=SPALLSTAFF.nrec;
	apphist.CSPR5:=SPALLSTAFF.RESCOMP[1];
	apphist.CSPR4:=000A000000000002h;//проверить
	update current apphist;


Counter++;








}
while Counter<100000


StopVisual('',0);
xlkillExcel;


}








end;
end.




.form import_app_fromperson
.nameinlist 'import_app_fromperson'
.ard
.begin
runinterface(import_app_fromperson);
end.
.endform


