Interface import_shr   escclose;


 
create view jView

var
Counter : longint;
ExcelPath:string;


NrecSHR:longint;   
NrecSetki:longint;
NrecPodr:longint;
NrecPodrV:longint;
NamePodr:string;
IdDolzhn:longint;
NameDolzhn:string;
KodKateg:longint;
Oklad:double;
UslTruda:string;
kolvo:double;
OtpVredn :double;
DopOtpKolDog:double;
Status1:string;
ProcVredn:double;
Status2:string;
Main_dolzhn:comp;
cparentDolzhn:comp;
RaiseNrec:longint;//для уникальности нреков ШР
RaiseNrecD:double;//для уникальности нреков должн
Nrec_NPO_Z:comp;
Nrec_NPO_K:comp;
Main_podr:comp;



from  staffstruct, klfilter,RAISEALG,RAISESTS,HISTORYSTR,catalogs,VACATIONSTS,VACATIONALG,STR_RHIST;



HandleEvent

CmInit:
{

RaiseNrec:=100000;//для уникальности нреков ШР
RaiseNrecD:=1000000;//для уникальности нреков должн
Nrec_NPO_Z:=2814749767106566;
Nrec_NPO_K:=2814749767342785;
Main_dolzhn:=2814749767342543;
cparentDolzhn:=2814749767342548;
main_podr:=2814749767342636;



ExcelPath:='d:\Source20112017\';
    StartNewVisual(vtNumericVisual,vfTimer,'Идёт импорт', 1);

    xlCreateExcelWithTemplate(ExcelPath+'STAFFSTRUCT_CIS1.xlsx',true)
    if (xlIsExcelValid) xlSetActiveWorkBookByName('1');


Counter:=2;

do
{
nextvisual;
xlgetcellvalue(Counter, 2,NrecSHR   );
xlgetcellvalue(Counter, 3,NrecSetki   );
xlgetcellvalue(Counter, 5,NrecPodr    );
xlgetcellvalue(Counter, 7,NamePodr   );
xlgetcellvalue(Counter, 9,IdDolzhn    );
xlgetcellvalue(Counter, 11,NameDolzhn    );
xlgetcellvalue(Counter, 12,KodKateg    );
xlgetcellvalue(Counter, 13,Oklad  );
xlgetcellvalue(Counter, 14,UslTruda   );
xlgetcellvalue(Counter,15,kolvo);
xlgetcellvalue(Counter, 16,OtpVredn );
xlgetcellvalue(Counter, 17,DopOtpKolDog );
xlgetcellvalue(Counter, 18,Status1 );
xlgetcellvalue(Counter, 21,ProcVredn );
xlgetcellvalue(Counter, 23,Status2 );

                          

if NrecSHR=0
{
break;
}

if (Status1<>'Активный' or Status2<>'Активный')
{
xlsetcellStringValue('Позиция не активная, не загружаем!!',Counter,26,Counter,26);
Counter:=Counter+1;
continue;
}

if NamePodr=''
{
	if getfirst catalogs where (((RaiseNrec+NrecPodr)==catalogs.nrec))<>tsok
	{
	xlsetcellStringValue('Не найдено подразделение по нреку!! Позиция не загружается',Counter,26,Counter,26);		
	Counter:=Counter+1;
	continue;
	}
	else
	{
	NrecPodrV:=catalogs.nrec;
	}
}
else
{
	if getfirst catalogs where ((0==catalogs.lpr and 000A000000039A2Ch==catalogs.mainlink and substr(NamePodr,1,instr(' ',NamePodr)-1)==catalogs.code))<>tsok
	{
	xlsetcellStringValue('Не найдено подразделение по нреку!! Позиция не загружается',Counter,26,Counter,26);		
	Counter:=Counter+1;
	continue;
	}
	else
	{
	NrecPodrV:=Catalogs.nrec;
	}

}


	clearbuffer(#staffstruct);
	staffstruct.nrec:=NrecSHR;
	staffstruct.DEPARTMENT:=NrecPodrV;

		if getfirst catalogs where ((0==catalogs.lpr and main_dolzhn==catalogs.mainlink and NameDolzhn==catalogs.name))<>tsok
		{
		clearbuffer(#catalogs);
		Catalogs.nrec:=RaiseNrecD+IdDolzhn;
		Catalogs.CPARENT:=cparentdolzhn;
		Catalogs.GROUPCODE:=2;
		Catalogs.name:=NameDolzhn;
		Catalogs.MAINLINK:=main_dolzhn;
		insert current catalogs;
		}
	staffstruct.POST:=catalogs.nrec;

		if getfirst KLkatego where ((KodKateg==Klkatego.kod))=tsok
		{
		staffstruct.EMPCATEGORY:=klkatego.nrec;
		}


		if getfirst TarstavSync where ((NrecSetki==tarstavsync.id))=tsok
		{
			if getfirst tarstav where ((tarstavsync.ctarstav==tarstav.nrec))=tsok
			{
			staffstruct.TARIFF:=tarstav.nrec;
			staffstruct.CATEGORY:=tarstav.razr;
//			staffstruct.CATEGORY:=Razr; // затем брать из файла
			staffstruct.MINSUMMA:=TARSTAV.TARMIN;
			staffstruct.MAXSUMMA:=TARSTAV.TARMAX;
			}
			else
			{
              		xlsetcellStringValue('Не найдено соответствие сетки!!! ',Counter,27,Counter,27);
			}
		}
		else
		{
		xlsetcellStringValue('Не найдена ID сетки. Вставил запись',Counter,27,Counter,27);
		clearbuffer(#TarstavSync);
		TarstavSync.ID:=NrecSetki;
		insert current TarstavSync;
		
		}
		




	staffstruct.TAXRATE:=Oklad;
	staffstruct.WORKSTATIONS:=kolvo;
	staffstruct.DINPUT:=date(01,09,2017);//вопрос все таки по дате и их согласованию
	staffstruct.cpodr:=NrecSHR;//link to klfilter
	if oklad>1000 or oklad=0
	{
	staffstruct.paymodel:=30;
	}
	else
	{
	staffstruct.paymodel:=20;
	}

	if UslTruda<>''
	{
		if getfirst catalogs where ((0==lpr and 000A000000039A30h==catalogs.mainlink and UslTruda==catalogs.code))=tsok
		{
		staffstruct.WORKCOND:=catalogs.nrec;
		}

	}


	insert current staffstruct;

	clearbuffer(#Klfilter);
	klfilter.nrec:=NrecSHR;
	insert current klfilter;

	clearbuffer(#HISTORYSTR);
	HISTORYSTR.STAFFSTR:=staffstruct.nrec;
	HISTORYSTR.WSTATE:=1;
	HISTORYSTR.WFLD:=1;
	HISTORYSTR.cspr2:=staffstruct.empcategory;
	HISTORYSTR.WCODOPER:=20;
	HISTORYSTR.DHIST:=staffstruct.dinput;
	HISTORYSTR.HTAXRATE:=staffstruct.taxrate;
	HISTORYSTR.HWORKSTATIONS:=staffstruct.WORKSTATIONS;
	HISTORYSTR.wpaymodel:=staffstruct.paymodel;


	HISTORYSTR.cTARIFF:=staffstruct.tariff;
	HISTORYSTR.wcategory:=staffstruct.category;

	HISTORYSTR.hMinTaxrate:=staffstruct.MINSUMMA;
	HISTORYSTR.hMaxTaxrate:=staffstruct.MAXSUMMA;
	HISTORYSTR.CWORKCOND:=staffstruct.WORKCOND;


	insert current HISTORYSTR;

	if otpVredn>0
	{
	clearbuffer(#VACATIONSTS);
	VACATIONSTS.CSTAFFSTRUCT:=staffstruct.nrec;
	VACATIONSTS.CKOTPUS:=14;//kod vredn
	VACATIONSTS.TYPEOTP:=1;//prochie
	VACATIONSTS.WCOUNTDAY:=otpVredn;
	VACATIONSTS.DVACCOEF:=1;
	insert current VACATIONSTS;
	clearbuffer(#VACATIONALG);
	VACATIONALG.CVACATIONSTS:=VACATIONSTS.nrec;
	VACATIONALG.DVACCOEF:=1;
	insert current VACATIONALG;
	}


	if DopOtpKolDog>0
	{
       	clearbuffer(#VACATIONSTS);
	VACATIONSTS.CSTAFFSTRUCT:=staffstruct.nrec;
	VACATIONSTS.CKOTPUS:=10;//kod nenorm
	VACATIONSTS.TYPEOTP:=1;//prochie
	VACATIONSTS.WCOUNTDAY:=otpVredn;
	VACATIONSTS.DVACCOEF:=1;
	insert current VACATIONSTS;
	clearbuffer(#VACATIONALG);
	VACATIONALG.CVACATIONSTS:=VACATIONSTS.nrec;
	VACATIONALG.DVACCOEF:=1;
	insert current VACATIONALG;
	}

	clearbuffer(#VACATIONSTS);
	VACATIONSTS.CSTAFFSTRUCT:=staffstruct.nrec;
	VACATIONSTS.CKOTPUS:=1;//kod osn
	VACATIONSTS.TYPEOTP:=0;//osn
	VACATIONSTS.WCOUNTDAY:=28;//medikov rukami
	VACATIONSTS.DVACCOEF:=1;
	insert current VACATIONSTS;
	clearbuffer(#VACATIONALG);
	VACATIONALG.CVACATIONSTS:=VACATIONSTS.nrec;
	VACATIONALG.DVACCOEF:=1;
	VACATIONALG.koldn:=28;	
	insert current VACATIONALG;

	if (procVredn>0)
	{
	clearbuffer(#RAISESTS);
	RAISESTS.STAFFSTR:=staffstruct.nrec;
	RAISESTS.RAISETYPE:=281474976712052;//doplata za vrednost new
	RAISESTS.DAT1:=staffstruct.dinput;
	//raisests.RSUM:=procVredn;
	insert current RAISESTS;

	clearbuffer(#RAISEALG);
	RAISEALG.SUM:=procVredn;
	RAISEALG.RAISEATTR:=2;
	RAISEALG.RAISESTST:=RAISESTS.nrec;
	insert current RAISEALG;

	clearbuffer(#STR_RHIST);
	STR_RHIST.CRAISESTS:=RAISESTS.nrec;
	//STR_RHIST.CSTAFFSTR:=staffstruct.nrec;
	STR_RHIST.WRTYPEOPER:=30;
	STR_RHIST.DREC:=staffstruct.dinput;
	STR_RHIST.RHSUM:=procVredn;
	STR_RHIST.WHATTR:=2;
	//STR_RHIST.CRSTRTYPE:=RAISESTS.RAISETYPE;
	insert current STR_RHIST;
	}




nextvisual;
Counter:=Counter+1;
NrecPodr:=0
}
while counter<100000
StopVisual('',0);

xlkillExcel;

    StartNewVisual(vtNumericVisual,vfTimer,'Перенумерация позиций', 1);

_loop catalogs where ((0==catalogs.lpr and Main_podr==catalogs.mainlink)) 
{

	Counter:=1;
	_loop staffstruct where ((catalogs.nrec==staffstruct.department))
	{
		nextvisual;
	        staffstruct.SEQNMB:=Counter;
		update current staffstruct;
		Counter:=Counter+1;
	}

}




StopVisual('',0);


}








end;
end.




.form import_shr
.nameinlist 'import_shr'
.ard
.begin
runinterface(import_shr);
end.
.endform