/*
  Проект        : ГАЛАКТИКА
  Система       : Управление персоналом
  Назначение    : Объектный интерфейс работы с удержаниями при работе с РК (рабочей корзиной)
*/
#ifndef _SetUderRK_INCLUDED_
#define _SetUderRK_INCLUDED_

#ifdef ComponentVersion
#component "GP_Staff"
#end

type TGP_SetUderRK_Params = record
  cPers   : comp;   //Сотрудник
  cApp    : comp;   //Назначение
  wTable  : word;   //код таблицы источника
  cRec    : comp;   //нрек записи источника
  wVidUd  : word;   //системный код вида удержания
  dBeg    : date;   //дата начала удержания
  dEnd    : date;   //дата окончания удержания
  wSumType: word;   //вид суммы: 0-НДЕ, 1-валюта, 2-процент
  dSum    : double; //сумма удержания
  cVal    : comp;   //нрек валюты
  cContDoc: comp;   //нрек приказа
end;

#doc
Объектный интерфейс работы с удержаниями при связи с рабочей корзиной
#end
objinterface GP_ISetUderRK;

#doc
Сформировать сообщение в РК о постоянном удержании
_params - параметры записи
MsgCode - добавление (212) или удаление (213) постоянного удержания
#end
Function MsgRR(_params: TGP_SetUderRK_Params; _MsgCode: integer = 212): comp;

#doc
Закрыть по сотруднику постоянное удержание
_params - параметры записи
#end
Function CloseSU(_params: TGP_SetUderRK_Params): comp;

#doc
Открыть по сотруднику постоянное удержание
_params - параметры записи
#end
Function OpenSU(_params: TGP_SetUderRK_Params): comp;

#doc
 Удаление записей корзины
 _SrcTable - Код таблицы источника (32)
 _SrcRec   - Nrec записи источника
 _MsgCode  - Код сообщения
 _Flag     - 1 - все грохать
             2 - только неутвержденные
             3 - только утвержденные
             5 - только по конкретному приказу
 возвращаемые коды:
 0 - невзрачный признак. Либо групповое удаление, либо не было удаленных сигналов
 1 - удален обработанный сигнал
 2 - удален необработанный сигнал
 100 - удаление было неудачно
 (когда удалялось несколько, то будем возвращать признак утв., если такой был хоть один,
 а неутв. только, если все неутвержденные)
#end
Function DelSU(_SrcTable: word; _SrcRec: comp; _MsgCode: integer; _Flag: comp; _cContDoc: comp = 0): word;

end;

vipinterface GP_SetUderRK implements GP_ISetUderRK
  Licensed (free)
;

#end
