#include WorkWithContract.vih
#include NumberOfAddAgreement.vih // работа с доп. соглашениями
#include Func_AppHist.vih // объект для получения состояния назначения на указанную дату
#include BasketFuncs.vih // функции для удаления записей из РК
#include MsgToZarSignal.vih // объект для создания записи в РК
#include TsFuncs.vih // объект для работы с тарифными ставками

