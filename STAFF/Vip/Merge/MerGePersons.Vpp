
function DopInfoUpdate(k:integer):boolean;
{ DopInfoUpdate:=false;
   if(DOPINFO.CFLD[k]=SpJoi.cRec)
   { DOPINFO.CFLD[k]:=JoiHead.cRec;
     DopInfoUpdate:=true;
   }
} // function DopInfoUpdate

Function CheckPersons : boolean;
{
  CheckPersons := False;
  If (GetFirst Persons where (( JoiHead.cRec == Persons.nRec)) <> tsOk)
    CheckPersons := True;
}


Function MergingPersons : boolean;
{
  Var PrOk : word;
  bBreak    := False;
  MergingPersons  := False;
  _nMsgFrm  := 0;          // Общее число ошибок
  ErrorJoi  := 0;
  ErrorSp   := 0;
  Count_vis := 0;

  If (GetFirst JoiHead Where ((word(cgPersons) == JoiHead.TypeEvent AND
                          UserName() == JoiHead.UserName )) = tsOk )
  do {
    case JoiHead.Status of
      Word(0) : If wParamObCatal = Word(1) continue;
      Word(1) : {};
      Word(3) :  Continue;
      Word(4) : IF wParamObCatal <> Word(0) continue;
    end;


//Нет корпо обмена!
    IF JoiHead.prCorpo = byte(1)
      IF CheckPersons() = True
        {
        Message (chr(3)+'Одно из объединений, присланное по Corpo обмену'+chr(13)+
                 chr(3)+'будет отложено, поскольку не существует записи,'+chr(13)+
                 chr(3)+'в которую необходимо производить объединение !');
        continue;
        }

    If (GetFirst SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and (word(3)<>SpJoi.Status))) = tsOk)
      do {
          Count_vis := Count_vis+100;
          
          // NeedZarRun
      }
       While (GetNext SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and (word(3)<>SpJoi.Status))) = tsOk);
    }
     while (GetNext JoiHead where ((word(cgPersons) == JoiHead.TypeEvent AND UserName() == JoiHead.UserName )) = tsOk );
if (Count_vis<>0)
  {
  IF (Message(''#3'Если Вы не сохранили данные, еще раз рекомендуем это сделать.'+
        ''#13#13#3'Запустить объединение каталогов ?'#13,YesNo+mfSwapButtons) = cmNo)
    EXIT;
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm,''#13#13#13#3'',count_vis);
  }
  else
  {
  Message (chr(3)+'Нет заданий на объединение'+chr(13));
  wParamObCatal := 0;
  Exit;
  }
// **************************************** Работа *********************************************************
  If (GetFirst JoiHead Where ((word(cgPersons) == JoiHead.TypeEvent and UserName() == JoiHead.UserName )) = tsOk )
  do {
      JoiHead.Status := word(1);  // Статус Начато
      Update Current JoiHead;

     If (GetFirst SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and (word(3)<>SpJoi.Status))) = tsOk) do
     {
        SpJoi.Status := word(1); // Статус Начато
        Update current SpJoi;

   if Not(NextVisual) ObBreak;

