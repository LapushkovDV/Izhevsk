    SpJoi.Status := word(3); // Статус Начато

    update current SpJoi;
   }While (GetNext SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and (word(3)<>SpJoi.Status))) = tsOk);
  JoiHead.Status := word (3); // Все окай!!!
  update current JoiHead;
 }
  while (GetNext JoiHead where ((word(cgPersons) == JoiHead.TypeEvent and UserName() == JoiHead.UserName )) = tsOk );
// ****************************************End Работа *********************************************************
  StopVisual('',0);
// т.к. уровень берется с Persons

  MergingPersons:=true;
