#include filial_macro.vpp// макросы для обработки филиальности

Interface GP_AttrNam_Merge 'Объединение внешних атрибутов' ;
create view vAttrNam_Merge
#INCLUDE obed.var //объявление переменных
  tmpComp      : Comp;
  i            : integer;
  tempNrec     : comp;        // Временная для nRec
  ErrorJoi     : longint;     // Временная для определения ошибок объединения
  ErrorSp      : longint;     // Временная для определения ошибок объединения
  prSp         : boolean;
  count_vis    : longint;
  lCycle1      : word;        // переменная для циклов
  bSystem      : boolean;     // проверка на системность
  bBreak       : boolean;     // Прерывание объединения
  bCorpo       : boolean;     // Признак Corpo
  CountRecOrdInProcess :integer; //количество записей для визуализации vtDownVisual
  wParamObCatal : word;     // Параметр запуска объединения:
                              // 0 - все  (новые и завершенные с ошибками),
                              // 1 - только незавершенные, 2 - только без ошибок

 FilterObtAttrNam:word;
  (sObName,
   sObcode,
   sOb1Name,
   sOb1code,
  strJoiStatus,
  strSpJoiStatus,
  cSpJoiDel,
  strJoiCorpo)

as select   
  if(not(isValid(tnJobTitle)) and JoiHead.cRec <> comp(0),'Удаленная запись',JobTitle.Name),
  if(not(isValid(tnJobTitle)) and JoiHead.cRec <> comp(0),'Удаленная запись',JobTitle.wTable),
  if(not(isValid(tnJobTitle1)) and SpJoi.cRec <> comp(0),SpJoi.Name,JobTitle1.Name),
  if(not(isValid(tnJobTitle1)) and SpJoi.cRec <> comp(0),'???',JobTitle1.wTable),
  if(JoiHead.Status = byte(1),'Начато',
             if(JoiHead.Status = byte(2),'Прервано',
                if(JoiHead.Status = byte(3),'Завершено',
                  if(JoiHead.Status = byte(4),'Заверш. с ошиб.','')))),

  if(SpJoi.Status = byte(1),'Начато',
             if(SpJoi.Status = byte(2),'Прервано',
                if(SpJoi.Status = byte(3),'Завершено',
                  if(SpJoi.Status = byte(4),'Заверш. с ошиб.','')))),
  if(SpJoi.IsDel = byte(1),'+',''),
  if(JoiHead.prCorpo <> byte(0),string(JoiHead.prCorpo),'')

//----------------------------------------------------------------------------------
  #InternalFieldsForShowFilial

from 
  JoiHead,
  SpJoi,
//  EvJoiHead,
  AttrNam , AttrNam AttrNam1 ,
//  X$REGISTERTABLES,
synonym AttrNam JobTitle,
synonym JoiHead  tmpJoiHead,
synonym SpJoi    tmpSpJoi,
//synonym EvJoiHead EvJoiHead1,
synonym Attrnam    JobTitle1,
synonym AttrNam    JobTitleTmp
  , AttrVal, AttrVal AttrVal1
  , x$files
  #TableForFilial
where ((
       m_wCgObedValue == JoiHead.TypeEvent    // Матценности
   and JoiHead.cRec   == JobTitle.nRec           // Объединение - матценности
   and JoiHead.nRec   == SpJoi.cJoiHead       // Объединение - спецификация
   and SpJoi.cRec     == JobTitle1.nRec          // Спецификация - матценности
   and JobTitle1.nrec == AttrVal1.cAttrnam
   and JobTitle1.wTable == AttrVal.wTable
   and AttrVal1.crec == AttrVal.crec
   and JobTitle.nrec == AttrVal.cAttrnam
   // Для генерации
   and AttrNam.wtable == AttrNam1.wtable 
   and AttrNam.Name == Attrnam1.name
   and AttrNam.ATTRTYPE == AttrNam1.ATTRTYPE(noindex)
   and AttrNam.Nrec << AttrNam1.NREC(noindex)   
   and JoiHead.ISKAU[6] == x$files.XF$CODE
   #WhereForFilial
)) 
Bounds OnlyUser =     m_wCgObedValue == JoiHead.TypeEvent
                  and UserName()     == JoiHead.UserName
;

File MemoFile;
File FileProtocol;

Procedure ObBreak;  // Прерывание объединения
{
Var count_out : longint;

count_out := VisualCount ();
Message(chr(3)+'Для прекращения объединения придется'+chr(13)+
        chr(3)+'подождать до окончания замены на'+chr(13)+
        chr(3)+'"' +trim (JobTitleTmp.Name)+'"',Information + OkButton);

ReStartVisual(''#3'Идет замещение на'#13#3''+'"'+ trim(JobTitleTmp.Name)+'"' +
              ''#13#3'',Count_vis);
NNextVisual (count_out);

bBreak := True;
}

form ErrObAll ('ErrObMc.OUT','ErrObAll') with NoVisual;
FORM frmObedAll('obedMC.out','obedAll') with novisual;
#include GP_ErrObAll.vpp    // Пакет ошибок

//#include Cor_Kau.vpp   // KAU
#include GP_printrelat.vpp // отчет замен
//#Include MacOb.vpp //макросы для таблиц несодержащих кау
//филиальные функции
#include GP_filial_func.vpp
//процедуры и функции обрабатывающие приход реплики с объединеннями  из другого офиса
//#include ObFCorpo.vpp

Function FindExistAttrNam (NewMc : comp) : boolean;  // Проверка не участвует ли уже
{
Var strMc : string[80];  // Временная для получения имени
Var strMc1 : string[80]; // Временная для получения имени

FindExistAttrNam := False;

IF (GetFirst tmpJoiHead where
  (( word(m_wCgObedValue) == tmpJoiHead.TypeEvent )) = tsOk)
  do {
    IF tmpJoiHead.cRec = NewMc
      {
      IF ( GetFirst JobTitleTmp where ((NewMc == JobTitleTmp.nrec)) = tsOk ) {};
      strMc := trim (JobTitleTmp.Name);
      FindExistAttrNam := True;
      Message (chr(3)+'Запись '+'"'+strMc+'"'+chr(13)+chr(3)+
                      'уже выбрана как результирующая');
      Exit;
      }

    IF (GetFirst tmpSpJoi where ((tmpJoiHead.nRec == tmpSpJoi.cJoiHead and
                                            NewMc == tmpSpJoi.cRec)) = tsOk)
      {
      IF ( GetFirst JobTitleTmp where ((NewMc == JobTitleTmp.nrec)) = tsOk ) {};
      strMc := trim (JobTitleTmp.Name);
      IF ( GetFirst JobTitleTmp where ((tmpJoiHead.cRec == JobTitleTmp.nrec)) = tsOk ) {};
      strMc1 := trim (JobTitleTmp.Name);
      FindExistAttrNam := True;
      Message (chr(3)+'Запись '+'"'+strMc+'"'+chr(13)+
               chr(3)+'уже выбрана для объединения в'+chr(13)+chr(3)+'"'+strMc1+'"');
      Exit;
      }
    } WHILE (GetNext tmpJoiHead where ((word(m_wCgObedValue) == tmpJoiHead.TypeEvent)) = tsOk);
}

Procedure FinishStage (stage : word);
{
IF _nMsgFrm = ErrorSp       // Если этап завершен без ошибок для одной об. МЦ
  {
  SpJoi.Step := word(stage);
  Update current SpJoi;
  }
}

Function CheckMc : boolean;
{
  CheckMc := False;
  If(GetFirst JobTitleTmp where (( JoiHead.cRec == JobTitleTmp.nRec)) <> tsOk)
  CheckMc := True;
}

Function CheckAllRelation : boolean;
{
    CheckAllRelation := True
}
//============================
// инициализация
//============================
Function Merge_AttrNam_Init(ww_type:word):boolean;
//============================================
{ Merge_AttrNam_Init:=True;
  Var forDsk : boolean;
  Var bufDsk : string;
  if ww_type=0
  { if (ReadMyDsk (bufDsk,'FilterObtAttrNam',forDsk) = true)  FilterObtAttrNam := word(bufDsk);
    if (FilterObtAttrNam=1) PushBounds (tbOnlyUser);
  }
  else
  { FilterObtAttrNam:=1;
    PushBounds (tbOnlyUser);
  }

} //Function Merge_AttrNam_Init(ww_type:word):boolean;


//============================
// создать объединение
// ww_syscode - тип справочника
// w_in - что
// w_out  - куда
//============================
Function Merge_AttrNam_Ins(ww_syscode:longint; w_in:comp;w_out:comp) :boolean;
//============================================
{  Merge_AttrNam_Ins:=False;

   IF true //not(FindExistAttrNam(tempNrec))
   {
      clearBuffer (#JoiHead);
      JoiHead.TypeEvent := m_wCgObedValue;
      JoiHead.ISKAU[6]   :=ww_syscode;
      JoiHead.cRec := w_out;
      JoiHead.Status := word(0);
      JoiHead.UserName := UserName();
      JoiHead.dDate := Cur_Date;
      insert current JoiHead;
      //Exit;
    }
   ClearBuffer (#SpJoi);
   SpJoi.cJoiHead := JoiHead.nRec;
   SpJoi.cRec := w_in;
   SpJoi.Status := Word(0);
   SpJoi.IsDel := word(1);
   Insert current SpJoi;
   Merge_AttrNam_Ins:=True;
   ReReadRecord(#JoiHead);
   ReDrawPanel(#JoiHead);

} //Function Merge_AttrNam_Ins(ww_syscode:longint; w_in:comp;w_out:comp) :boolean;


//============================================
Function MakeMerge : boolean;
//============================================
var ww_first :boolean;
{ MakeMerge:=True;
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm,''#13#13#13#3'',recordsintable(#AttrNam));
    _Loop AttrNam //ordered by AttrNam.Nrec(DESC)
    {  ww_first:=true;
       if not NextVisual then break;
       _loop AttrNam1 where (( 
               AttrNam.wtable   == AttrNam1.wtable 
           and AttrNam.Name     == Attrnam1.name
           and AttrNam.ATTRTYPE == AttrNam1.ATTRTYPE(noindex)
           and AttrNam.Robject  == AttrNam1.Robject(noindex)
           and (AttrNam.Nrec > AttrNam1.NREC )
           ))
       {  if ww_first
            if FindExistAttrNam(AttrNam.NREC) break;
          ww_first:=false;
          if FindExistAttrNam(AttrNam1.NREC) continue;
          Merge_AttrNam_Ins(AttrNam.wtable,AttrNam1.NREC,AttrNam.NREC)
       }   
    } //_Loop AttrNam order by AttrNam.Nrec
    StopVisual('',0)
} //Function MakeMerge : boolean;   



//============================================
Function MergeAttrNam:boolean;
//============================================
{ _nMsgFrm  := 0;          // Общее число ошибок
  ErrorJoi  := 0;
  ErrorSp   := 0;
  Count_vis := 0;
  MergeAttrNam:=True;
  If (GetFirst JoiHead Where ((word(m_wCgObedValue) == tmpJoiHead.TypeEvent AND
                          UserName() == JoiHead.UserName(noindex) )) = tsOk )
   do {
     Count_vis:=Count_vis+1;

  } while (GetNext JoiHead Where ((word(m_wCgObedValue) == tmpJoiHead.TypeEvent AND
                          UserName() == JoiHead.UserName(noindex) )) = tsOk )
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm,''#13#13#13#3'',Count_vis);
  
  If (GetFirst JoiHead Where ((word(m_wCgObedValue) == tmpJoiHead.TypeEvent AND
                          UserName() == JoiHead.UserName(noindex) )) = tsOk )
   do {
    if not NextVisual then break;
    case JoiHead.Status of
      Word(0) : If wParamObCatal = Word(1) continue;
      Word(1) : {};
      Word(3) :  Continue;
      Word(4) : IF wParamObCatal <> Word(0) continue;
    end;
    if JoiHead.cRec=0 then continue;
    If Not nextVisual then break;
    _Loop fullcache SpJoi
    { _Loop fullcache AttrVal1
      { if getfirst AttrVal=0
        { if AttrVal.vString<>'' or  AttrVal.vComp<>0 or AttrVal.VDOUBLE<>0
          { delete current AttrVal1;
          }
          else
          { delete current AttrVal;
            update current AttrVal1 set AttrVal1.cAttrNam:=JoiHead.cRec;
          }
        }
        else
          update current AttrVal1 set AttrVal1.cAttrNam:=JoiHead.cRec;
      }
      update current SpJoi set SpJoi.Status:= 3;// Все окай!!!
      
    } //_Loop SpJoi
    JoiHead.Status := word(3); // Все окай!!!
    update current JoiHead;
  } while (GetNext JoiHead Where ((word(m_wCgObedValue) == tmpJoiHead.TypeEvent AND
                          UserName() == JoiHead.UserName(noindex) )) = tsOk )
  StopVisual('',0)
}

