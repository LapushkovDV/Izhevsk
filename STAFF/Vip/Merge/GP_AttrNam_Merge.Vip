handleevent
cmValue1:
{ MakeMerge;
}
cmCheckField:
{
 case CurField of
  #FilterObtAttrNam :
  {
  if (FilterObtAttrNam=0)
     if (BoundActive(tbOnlyUser))
      PopBounds (tbOnlyUser);
  if (FilterObtAttrNam=1)
    if (not(BoundActive(tbOnlyUser)))
      PushBounds (tbOnlyUser);
  if (GetFirst JoiHead = tsOk) {};
  ReReadRecord(#JoiHead);
  RescanPanel (#JoiHead);
  RescanPanel (#SpJoi);
  SelectPanel (#JoiHead);
  SaveMyDsk (string(FilterObtAttrNam),'FilterObtAttrNam');
  }

end; // case
}

cmInit:
{ 
  if (NOT pr_CurUserAdmin )
  {  Message('Вв должны быть администратором БД') ;
     closeinterface(cmDone) ;
     abort;
  }
  bSystem:=true ;
  m_wCgObedValue:=200;
  IF (GetFirst tmpJoiHead where (( word(m_wCgObedValue) == tmpJoiHead.TypeEvent and
      UserName() == tmpJoiHead.UserName(noindex) and (Word(1)=tmpJoiHead.Status))) = tsOk )
  {
    wParamObCatal := Word(1);
    IF (Message(chr(3)+'Обнаружено незавершенное объединение '+chr(13)+
                chr(3)+'рекомендуется немедленно продолжить это объединение.'+chr(13)+
        chr(13)+chr(3)+'Запустить незавершенное объединение ?',yesno) = cmYes)
      PutCommand(cmObed);
    ELSE
      CloseInterface (cmCancel);
  }
}

cmInsert:  Abort;

cmDefault: Abort;

cmHotKeys :
  PutHotCommAnd(RunMenu('ObedProff_HotKeys_Print'));

cmPrintDoc :
{
  if (frmObedAll.error)
  {
    frmObedAll.AbortForm;
    message(''#3'Ошибка при формировании протокола соответствия.' +
            ''#13#3'Возможно, формы ObedAll нет в ресурсе.',CancelButton);
    Exit;
  }
  else    #PrintRelation(JobTitle1,JobTitle,Name,'Внешние атрибуты ')
}

cmObed :
{
  IF wParamObCatal <> 1
  {
    IF (GetFirst tmpJoiHead where (( word(m_wCgObedValue) == tmpJoiHead.TypeEvent AND
                                    UserName() == tmpJoiHead.UserName)) = tsOk)
      do
      {
        IF (GetFirst tmpSpJoi where
                ((tmpJoiHead.nRec == tmpSpJoi.cJoiHead)) <> tsOk)
        {
          IF (GetFirst JobTitleTmp where (( tmpJoiHead.cRec == JobTitleTmp.nrec)) = tsOk ) {};
          Message (chr(3)+'Для результата объединения'+chr(13)+
                   chr(3)+'"'+trim(JobTitleTmp.Name)+'"'+chr(13)+
                   chr(3)+'не выбраны данные, которые необходимо объединять',CancelButton);
          EXIT;
        }
      } WHILE (GetNext tmpJoiHead where ((word(m_wCgObedValue) == tmpJoiHead.TypeEvent AND
                                          UserName() == tmpJoiHead.UserName)) = tsOk);
    IF (GetFirst tmpJoiHead where (( word(m_wCgObedValue) == tmpJoiHead.TypeEvent and
                                     UserName() == tmpJoiHead.UserName and
                                     (Word(4)=tmpJoiHead.Status) )) = tsOk )

      IF (Message(''#3'Хотите повторять объединение для' +
                  ''#13#3'завершенных с ошибками данных ?'#13,YesNo) = cmNo)
        wParamObCatal := 2;
  }
  if (CheckAllRelation)
  {
    MergeAttrNam;
  }
  ReReadRecord(#JoiHead);
  ReReadRecord(#SpJoi);
}
end;
end.  // Interface

ObedProff_HotKeys_Print Menu
{
- 'Печать',cmPrintDoc,'Печать соотвествия объединения',, 'Ctrl+P', kbCtrlP, scMenuCtx;
}
