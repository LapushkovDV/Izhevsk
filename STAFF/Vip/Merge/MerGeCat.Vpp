
function DopInfoUpdate(k:integer):boolean;
{ DopInfoUpdate:=false;
   if(DOPINFO.CFLD[k]=SpJoi.cRec)
   { DOPINFO.CFLD[k]:=JoiHead.cRec;
     DopInfoUpdate:=true;
   }
} // function DopInfoUpdate

Function CheckCatalogs : boolean;
{
  CheckCatalogs := False;
  If (GetFirst Catalogs where (( JoiHead.cRec == catalogs.nRec)) <> tsOk)
    CheckCatalogs := True;
}


Function MergingCatalogs : boolean;
{
  Var PrOk : word;
  bBreak    := False;
  MergingCatalogs  := False;
  _nMsgFrm  := 0;          // Общее число ошибок
  ErrorJoi  := 0;
  ErrorSp   := 0;
  Count_vis := 0;

  If (GetFirst JoiHead Where ((word(cgCatalogS+15000) == JoiHead.TypeEvent AND
                          UserName() == JoiHead.UserName )) = tsOk )
  do {
    case JoiHead.Status of
      Word(0) : If wParamObCatal = Word(1) continue;
      Word(1) : {};
      Word(3) :  Continue;
      Word(4) : IF wParamObCatal <> Word(0) continue;
    end;


//Нет корпо обмена!
    IF JoiHead.prCorpo = byte(1)
      IF CheckCatalogs() = True
        {
        Message (chr(3)+'Одно из объединений, присланное по Corpo обмену'+chr(13)+
                 chr(3)+'будет отложено, поскольку не существует записи,'+chr(13)+
                 chr(3)+'в которую необходимо производить объединение !');
        continue;
        }

    If (GetFirst SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and (word(3)<>SpJoi.Status))) = tsOk)
      do {
          if(cgProff=cgCatalogS) Count_vis := Count_vis+28;//26 для первого;
          if(cgFormEducation=cgCatalogS) Count_vis := Count_vis+2;
          if(cgLevelEducation=cgCatalogS) Count_vis := Count_vis+2;

          if(cgRelative=cgCatalogS) Count_vis := Count_vis+1;
          if(cgNatureOfWork=cgCatalogS) Count_vis := Count_vis+2;
          if(cgDocuments=cgCatalogS) Count_vis := Count_vis+1;
          if(-11=cgCatalogS) Count_vis := Count_vis+80;
          if(-123=cgCatalogS) Count_vis := Count_vis+1;
          if(-33=cgCatalogS) Count_vis := Count_vis+5;
          if(-4=cgCatalogS) Count_vis := Count_vis+1;
          if(-133=cgCatalogS) Count_vis := Count_vis+2;
          if(-17=cgCatalogS) Count_vis := Count_vis+6;
          if(-19=cgCatalogS) Count_vis := Count_vis+2;
          if(-121=cgCatalogS) Count_vis := Count_vis+3;
          if(-375=cgCatalogS) Count_vis := Count_vis+2;
          if(2060=cgCatalogS) Count_vis := Count_vis+1;// нет ничего
          if(-14=cgCatalogS) Count_vis := Count_vis+1;
          if(-301=cgCatalogS) Count_vis := Count_vis+1;
          if(-21=cgCatalogS) Count_vis := Count_vis+1;
          if(-175=cgCatalogS) Count_vis := Count_vis+2;
          if(-210=cgCatalogS) Count_vis := Count_vis+1;
          if(-20=cgCatalogS) Count_vis := Count_vis+2;
          if(-132=cgCatalogS) Count_vis := Count_vis+2;
          if(-27=cgCatalogS) Count_vis := Count_vis+2;
          if(-147=cgCatalogS) Count_vis := Count_vis+1;
          if(1445=cgCatalogS) Count_vis := Count_vis+1;
          if(-125=cgCatalogS) Count_vis := Count_vis+1;
          if(-31=cgCatalogS) Count_vis := Count_vis+1;
          if(-131=cgCatalogS) Count_vis := Count_vis+1;
          if(-199=cgCatalogS) Count_vis := Count_vis+2;
          if(-179=cgCatalogS) Count_vis := Count_vis+2;
          if(-36=cgCatalogS) Count_vis := Count_vis+2;
          if(-176=cgCatalogS) Count_vis := Count_vis+2;
          if(-144=cgCatalogS) Count_vis := Count_vis+1;
          if( -29=cgCatalogS) Count_vis := Count_vis+1;
          if(-178=cgCatalogS) Count_vis := Count_vis+3;
          if(1396=cgCatalogS) Count_vis := Count_vis+1;
          if(-180=cgCatalogS) Count_vis := Count_vis+1;
          if(-198=cgCatalogS) Count_vis := Count_vis+1;
          if(-181=cgCatalogS) Count_vis := Count_vis+2;
          if(-400=cgCatalogS) Count_vis := Count_vis+1;
          if( -25=cgCatalogS) Count_vis := Count_vis+1;
          if(1450=cgCatalogS) Count_vis := Count_vis+1;
          if(1446=cgCatalogS) Count_vis := Count_vis+1;
          if(-126=cgCatalogS) Count_vis := Count_vis+1;
          if(-127=cgCatalogS) Count_vis := Count_vis+1;
          if(-402=cgCatalogS) Count_vis := Count_vis+1;
          if(-124=cgCatalogS) Count_vis := Count_vis+2;
          if(2300=cgCatalogS) Count_vis := Count_vis+1;
          if( -30=cgCatalogS) Count_vis := Count_vis+1;
          if(1460=cgCatalogS) Count_vis := Count_vis+1;
          if(1447=cgCatalogS) Count_vis := Count_vis+1;
          if( -23=cgCatalogS) Count_vis := Count_vis+2;
          if(-401=cgCatalogS) Count_vis := Count_vis+1;
          if(-200=cgCatalogS) Count_vis := Count_vis+2;
          if(-120=cgCatalogS) Count_vis := Count_vis+1;
          if( -28=cgCatalogS) Count_vis := Count_vis+2;
          if(-122=cgCatalogS) Count_vis := Count_vis+1;
          //== U_*
          if(-32=cgCatalogS) Count_vis := Count_vis+12;
          
          // NeedZarRun
      }
       While (GetNext SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and (word(3)<>SpJoi.Status))) = tsOk);
    }
     while (GetNext JoiHead where ((word(cgCatalogS+15000) == JoiHead.TypeEvent AND UserName() == JoiHead.UserName )) = tsOk );
if (Count_vis<>0)
  {
  IF (Message(''#3'Если Вы не сохранили данные, еще раз рекомендуем это сделать.'+
        ''#13#13#3'Запустить объединение каталогов ?'#13,YesNo+mfSwapButtons) = cmNo)
    EXIT;
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm,''#13#13#13#3'',count_vis);
  }
  else
  {
  Message (chr(3)+'Нет заданий на объединение'+chr(13));
  wParamObCatal := 0;
  Exit;
  }
// **************************************** Работа *********************************************************
  If (GetFirst JoiHead Where ((word(cgCatalogS+15000) == JoiHead.TypeEvent and UserName() == JoiHead.UserName )) = tsOk )
  do {
      JoiHead.Status := word(1);  // Статус Начато
      Update Current JoiHead;

     If (GetFirst SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and (word(3)<>SpJoi.Status))) = tsOk) do
     {
        SpJoi.Status := word(1); // Статус Начато
        Update current SpJoi;

//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
//               Структурные единицы штатного расписания
//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
if(-11= cgCatalogS)  
{  
   if Not(NextVisual) ObBreak;
   StartNewVisual(vtRotateVisual,vfTimer,'Обработка EXTCATLINKS ',RecordsIntable(tnExtCatlinks));
   if getfirst extcatlinks_main=0
   { external _loop extcatlinks
     { if Not(NextVisual) ObBreak;
       update Persons where ((extcatlinks.extcat == Persons.GalDep(noindex) )) set Persons.GalDep:=extcatlinks_main.extcat
   
     }
   }  
   else
   { external _loop extcatlinks
     { if Not(NextVisual) ObBreak;
       update current extcatlinks set extcatlinks.extcat:=extcatlinks_main.extcat;
     }
   }
   StopVisual('',0);
   if Not(NextVisual) ObBreak;
   #UpdateTableOneFieldWithIndex(Appointments , Department , 'Appointments')
   #UpdateTableOneFieldWithOutIndex(Appointments , PrivPension , 'Appointments')
   #UpdateTableOneFieldWithOutIndex(ARHPEREX,CPODR,'ARHPEREX')
   #UpdateTableOneFieldWithOutIndex(ARHPEREX,CPODRP,'ARHPEREX')
   #UpdateTableOneFieldWithOutIndex(Persons , Department , 'Persons')
   #UpdateTableOneFieldWithIndex(StaffStruct , Department , 'StaffStruct')
   

   SpJoi.Status:= 3;// Все окай!!!
}
