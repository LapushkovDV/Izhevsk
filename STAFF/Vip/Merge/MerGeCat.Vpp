   #UpdateTableOneFieldWithOutIndex(SUMVIDOP,  CAPPOINT    ,'SUMVIDOP'   )
   #UpdateTableOneFieldWithOutIndex(NACHISL,   CAPPOINT    ,'NACHISL'    )
   #UpdateTableOneFieldWithOutIndex(PEREVOD,   CAPPOINT    ,'PEREVOD'    )
   #UpdateTableOneFieldWithOutIndex(ARHPEREX,  CAPPOINT    ,'ARHPEREX'   )
   #UpdateTableOneFieldWithOutIndex(PEREVODTEK,CAPPOINT    ,'PEREVODTEK' )
   #UpdateTableOneFieldWithOutIndex(NORMTMR,   CPROFESSION ,'NORMTMR'    )
   #UpdateTableOneFieldWithOutIndex(RASOPER,   CPROFESSION ,'RASOPER'    )
   #UpdateTableOneFieldWithOutIndex(NENACH,    CAPPOINT    ,'NENACH'     )
   #UpdateTableOneFieldWithOutIndex(LSTAB,     CAPPOINT    ,'LSTAB'      )
   #UpdateTableOneFieldWithOutIndex(PRIORAPP,  CAPPOINT    ,'PRIORAPP'   )
   #UpdateTableOneFieldWithOutIndex(ZAROPER,   CAPPOINT    ,'ZAROPER'    )
   #UpdateTableOneFieldWithOutIndex(NALPERS,   CAPPOINT    ,'NALPERS'    )
   #UpdateTableOneFieldWithOutIndex(COPYSOP,   CAPPOINT    ,'COPYSOP'    )
   #UpdateTableOneFieldWithOutIndex(COPYNENA,  CAPPOINT    ,'COPYNENA'   )
   #UpdateTableOneFieldWithOutIndex(COPYPER,   CAPPOINT    ,'COPYPER'    )
   #UpdateTableOneFieldWithOutIndex(ZARSIGNAL, COMP3       ,'COMP3'      )
//~~~~~~~~~~~~~~ D_STAFF ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   #UpdateTableOneFieldWithOutIndex(APPOINTMENTS, POST     ,'APPOINTMENTS')
   #UpdateTableOneFieldWithOutIndex(STAFFSTRUCT,  POST     ,'STAFFSTRUCT')
   #UpdateTableOneFieldWithOutIndex(PLANEDUC,     CPOST    ,'PLANEDUC')
   #UpdateTableOneFieldWithOutIndex(PLANATT,      CREF2    ,'PLANATT')

      #UpdateTableOneFieldWithIndex(FUTUREPOST,   CPOst    ,'FUTUREPOST')
      #UpdateTableOneFieldWithIndex(ADVISES,      PERSON   ,'ADVISES')
// - Persons
   if Not(NextVisual) ObBreak;
   StartNewVisual(vtRotateVisual,vfTimer,'Обработка таблицы '+'Persons',RecordsIntable(tnPersons));
      if (Getfirst Persons=tsOk){}
      do{
       if((SpJoi.cRec = Persons.CADDPROF) Or (SpJoi.cRec = Persons.CBASEPROF))
         {
           if(SpJoi.cRec = Persons.CADDPROF) Persons.CADDPROF := JoiHead.cRec;
           if(SpJoi.cRec = Persons.CBASEPROF) Persons.CBASEPROF:= JoiHead.cRec;
           update Current Persons;
         }
     } While (GetNext Persons =tsOk)
     StopVisual('',0);
     SpJoi.Status:= 3;// Все окай!!!
}

