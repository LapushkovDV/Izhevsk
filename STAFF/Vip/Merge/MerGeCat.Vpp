//                        cgDocuments
//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
  if(cgDocuments=cgCatalogS)
   { if(getfirst CatalogS where ((JoiHead.cRec == CatalogS.Nrec))=tsOk)
     { if Not(NextVisual) ObBreak;
      StartNewVisual(vtRotateVisual,vfTimer,'Обработка таблицы PASSPORTS',RecordsIntable(tnPASSPORTS));
       update PASSPORTS where ((SpJoi.cRec == PASSPORTS.DocName(noindex)))
          set PASSPORTS.DocName := CatalogS.Nrec, PASSPORTS.SYSCODE:=CatalogS.SYSCODE;
     StopVisual('',0);
     SpJoi.Status:= 3;// Все окай!!!
    }
   }

//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
//    DOPINFO в любом случае! хотя и медленно могет работать
//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
    StartNewVisual(vtRotateVisual,vfTimer,'Обработка таблицы DOPINFO',RecordsIntable(tnDOPINFO));
    _loop fullcache DOPINFO where (
        DOPINFO.CFLD[1]=SpJoi.cRec
     or DOPINFO.CFLD[2]=SpJoi.cRec 
     or DOPINFO.CFLD[3]=SpJoi.cRec 
     or DOPINFO.CFLD[4]=SpJoi.cRec 
     or DOPINFO.CFLD[5]=SpJoi.cRec 
     )
    {
      if(DopInfoUpdate(1) Or
         DopInfoUpdate(2) Or
         DopInfoUpdate(3) Or
         DopInfoUpdate(4) Or
         DopInfoUpdate(5))
       update current DOPINFO;
    } //_loop fuulcache DOPINFO
    StopVisual('',0);
//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
//        перевесим веть если есть
//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
    update catalogs where (( 0 == lpr and SpJoi.cRec == catalogs.CPARENT )) set  catalogs.CPARENT:=JoiHead.cRec;

//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~

    update current SpJoi;
   }While (GetNext SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and (word(3)<>SpJoi.Status))) = tsOk);
  JoiHead.Status := word(3); // Все окай!!!
  update current JoiHead;
 }
  while (GetNext JoiHead where ((word(cgCatalogS+15000) == JoiHead.TypeEvent and UserName() == JoiHead.UserName )) = tsOk );
// ****************************************End Работа *********************************************************
  StopVisual('',0);
// т.к. уровень берется с Persons

  if(cgLevelEducation=cgCatalogS) Message(chr(3)+'Рекомендуется выполнить функцию:'+ chr(13) +
                                          chr(3)+'"Операции" - "Корректировка данных об уровнях образования"'
                                          ,Information + OKButton);

  if(cgRelative      =cgCatalogS) Message(chr(3)+'Рекомендуется выполнить функцию:'+ chr(13) +
                                          chr(3)+'"Операции" - "Проверка и корректировка данных об иждивенцах"'
                                          ,Information + OKButton);

  MergingCatalogs:=true;
}



