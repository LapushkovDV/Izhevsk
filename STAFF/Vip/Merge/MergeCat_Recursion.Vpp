//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
//           Катимся до конца или пока не встретим саму себя!
//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
function Recursion(ParentNrec:Comp):boolean;
{
 var SaveNrec:Comp;
 Recursion:=True;
 if(GetFirst CatalogS Where (( ParentNrec == CatalogS.CParent))=tsOk)
 do
 {
   SaveNrec:=CatalogS.Nrec;
   if(CatalogS.Nrec = JoiHead.cRec ) //
    {
     Recursion:=false;
     exit;
    }
   Recursion:=Recursion(SaveNrec);
   if(Not Recursion) exit;
   GetFirst CatalogS Where (( SaveNrec == CatalogS.Nrec));
 }
 while(GetNext CatalogS Where (( ParentNrec == CatalogS.CParent))=tsOk)
}
