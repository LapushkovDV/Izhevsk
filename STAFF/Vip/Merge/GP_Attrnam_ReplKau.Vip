//========================================================================
Interface GP_Attrnam_ReplKau 'Внешние атрибуты, замена аналитик', EscClose;
//========================================================================
create view vAttrnam_ReplKau
var
  w_kau:word;
  w_ReplKau:comp;
  DT :date;
  w_logfilename:string;
as select Attrnam.Nrec
from AttrNam,REplKau
, KatSopr,PlPOr, SchFact, SpSopr
, synonym KatKau KatKauOld
, synonym KatKau KatKauNew

where (( 5 == AttrNam.AttrType
and w_kau == AttrNam.robject(noindex)
and AttrNam.Nrec == AttrVal.cAttrNam
and AttrVal.crec ==KatSopr.Nrec
and AttrVal.crec ==PlPor.Nrec
and AttrVal.crec ==SchFact.Nrec
and AttrVal.crec ==SpSopr.Nrec
and w_ReplKau == ReplKau.Nrec
and ReplKau.wKauOld  == KatKauOld.KodGroup
and ReplKau.wKauNew  == KatKauNew.KodGroup

and w_ReplKau == SReplKau.cReplKau
and AttrVal.vComp == SREPLKAU.CKAUOLD
));


//=====================================================================
Procedure SaveParam;
//=====================================================================
{ SaveMyDsk(DT,'AttrNam_RKau_DT');              ;
  SaveMyDsk(w_ReplKau,'AttrNam_RKau_w_ReplKau')
}

//=====================================================================
Procedure ReadParam;
//=====================================================================
{ if not ReadMyDsk(DT,'AttrNam_RKau_DT',true) DT:=date(1,1,year(cur_date));
  if not ReadMyDsk(w_ReplKau,'AttrNam_RKau_w_ReplKau',true) w_ReplKau:=0;
}





//==============
// формирование данных
//==============
Function FormDoc:boolean;
var i:longint;
    ww_kl:boolean;
{ FormDoc:=false;
  if not isvalid(#Replkau)
  {  message('Не задан шаблон соотв. аналитик');
    exit;
  }
  if ReplKau.wKauOld=0 or ReplKau.wKauNew=0
  {
  }

  w_kau:=Replkau.wKauOld;
  _loop fullcache AttrNam
  { if not nextvisual then exit;
    displ('Исправили ВА '+string(AttrNam.wTable)+' '+AttrNam.Name);
    
    update current AttrNam set AttrNam.robject:=ReplKau.wKauNew;
  } //_loop fullcache AttrNam


  w_kau:=Replkau.wKauNew;
  _loop fullcache AttrNam
  { if not inextvisual('Идет замена атрибута '+string(AttrNam.wTable)+' '+AttrNam.name) then exit;
    displ('Смена значений '+string(AttrNam.wTable)+' '+AttrNam.Name+Timetostr(cur_time,' HH:MM:SS:SSS') );
    _loop fullcache AttrVal
    { if not nextvisual then exit;
      //displ(string(AttrVal.nrec)) 
      if getfirst SReplKau<>0 then continue;
      //displ('----') 
      case attrnam.wtable of
      coKatSopr:
      { if getfirst fastfirstrow KatSopr=0
           if KatSopr.DSopr<DT then continue;
      }
      coPlPor:
      { if getfirst fastfirstrow PlPor=0
           if PlPor.DatVip<DT then continue;
      }
      coSchFact:
      { if getfirst fastfirstrow SchFact=0
           if SchFact.DFACT<DT then continue;
      }
      coSpSopr:
      { if getfirst fastfirstrow SpSopr=0
           if SpSopr.DSopr<DT then continue;
      }
      end;
      update current Attrval set 
        AttrVal.vComp:=if(SReplKau.CKAUNEW<>0,SReplKau.CKAUNEW,ReplKau.CKAUOTHER);
    } //_loop fullcache AttrVal 
  } //_loop fullcache AttrNam
  ShowErrors;
  
  FormDoc:=true;
} //Function FormDoc:boolean;



//=============================
//===== окно ввода параметров
//=============================
panel PnMain
tabbedsheet top tabsMain;
 screen scrmain 'Параметры' ;
 table  ReplKau;
fields
 [w_ReplKau_Name] KatKauOld.Name+'->'+KatKauNew.Name : protect, pickbutton;
 DT :noprotect;
 buttons
        cmOk,,,'Печать отчёта', hcStaffRepBuild, scStaffForButton;
        cmCancel,,,'Отмена', hcStaffRepBuild, scStaffForButton;
<<
  Шаблон замены аналитик 
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  Дата до которой не менять аналитику в документах
  .@@@@@@@@@@@@
  
    <. Запуск .>                   <.    Отмена    .>

>>
  end; // screen scrMain
  screen scr_txo 'Информация';  
 table  ReplKau;
  <<
    Предназначен для замены аналитики во внещних атрибутах
    на онснование шаблона замены анлитик из 
    объединения счетов.
    
  >> 
  end;
end; // tabbedsheet top tabsMain;
end; //panel PnMain



//=============================
HandleEvent
cmInit:
{ ReadParam;
  if getfirst KatKauOld=0 {}
  if getfirst KatKauNew=0 {}
  if getfirst Replkau=0 {}
  Rescanpanel(#ReplKau);

}
cmPick:
{ case curfield of 
  #w_ReplKau_Name,#ReplKau.Name:
  { var ww_nrec:comp;
    RunInterFace(C_JOIN::ReplaceKau,0,0,ww_nrec);
    if ReadMyDsk(ww_nrec,'ReplKau_Nrec',true) set w_ReplKau:=ww_nrec;
    if getfirst Replkau=0 {}
    if getfirst KatKauOld=0 {}
    if getfirst KatKauNew=0 {}
    
  }
  end;
  Rescanpanel(#ReplKau);

} 
cmOk:
{ SaveParam;
  StartNewVisual(vtNumericVisual,vfTimer+vfBreak,'Отбор данных...', vfTimer+vfBreak);
  //========================
  w_logfilename:='!ReplKau.log';
  OpenLogFile(w_logfilename) ;
  FormDoc ;
  UnLockLogFile;
  ShowErrors;
  CloseLogFile;
  //========================
  if VisualizationActive
      StopVisual('',0);
}
cmDone:
{ SaveParam;
}
end;
end.
