#doc
Выбор записей в картотеке сотрудников для объединения
#end

Interface MergePersonsVib 'Выбор записи картотеки сотрудников' Cyan, DoAccept;
Create view
var
  pPersons :comp;
as select  Persons.Fio
From Persons
;
Parameters pPersons;

Browse brPers ('',,sci1Esc);
Fields
  Persons.Fio 'Фио' :[25],Protect,NoDel;
  Persons.StrTabn 'Строч.табельный' :[25],Protect,NoDel;
  Persons.Nrec 'ID' :[25],Protect,NoDel;
  Persons.IsEmployee 'Тип' :[5],Protect,NoDel;
  Persons.AppDate 'Дата приема' :[12],Protect,NoDel;
  Persons.DisDate 'Дата увольнения' :[12],Protect,NoDel;
end; //brPers

HandleEvent
cmSetDefault: Exit;
cmDeleteRecord: Exit;
cmInsertRecord: Exit;
cmInit:
{ if pPersons>0
  { if getfirst Persons where (( pPersons ==Persons.Nrec )) =tsok {}

  }
  ReScanPanel(#Persons);
}
cmDefault  :
{ pPersons:=Persons.Nrec;

}
end;
end.
