Function FindExistCatalogS (NewMc : comp) : boolean;  // Проверка не участвует ли уже
{
Var strMc : string[80];  // Временная для получения имени
Var strMc1 : string[80]; // Временная для получения имени

FindExistCatalogS := False;

IF (GetFirst tmpJoiHead where
  (( word(cgCatalogS+15000) == tmpJoiHead.TypeEvent )) = tsOk)
  do {
    IF tmpJoiHead.cRec = NewMc
      {
      IF ( GetFirst JobTitleTmp where ((NewMc == JobTitleTmp.nrec)) = tsOk ) {};
      strMc := trim (JobTitleTmp.Name);
      FindExistCatalogS := True;
      Message (chr(3)+'Запись '+'"'+strMc+'"'+chr(13)+chr(3)+
                      'уже выбрана как результирующая');
      Exit;
      }

    IF (GetFirst tmpSpJoi where ((tmpJoiHead.nRec == tmpSpJoi.cJoiHead and
                                            NewMc == tmpSpJoi.cRec)) = tsOk)
      {
      IF ( GetFirst JobTitleTmp where ((NewMc == JobTitleTmp.nrec)) = tsOk ) {};
      strMc := trim (JobTitleTmp.Name);
      IF ( GetFirst JobTitleTmp where ((tmpJoiHead.cRec == JobTitleTmp.nrec)) = tsOk ) {};
      strMc1 := trim (JobTitleTmp.Name);
      FindExistCatalogS := True;
      Message (chr(3)+'Запись '+'"'+strMc+'"'+chr(13)+
               chr(3)+'уже выбрана для объединения в'+chr(13)+chr(3)+'"'+strMc1+'"');
      Exit;
      }
    } WHILE (GetNext tmpJoiHead where ((word(cgCatalogS+15000) == tmpJoiHead.TypeEvent)) = tsOk);
}


Procedure FinishStage (stage : word);
{
IF _nMsgFrm = ErrorSp       // Если этап завершен без ошибок для одной об. МЦ
  {
   SpJoi.Step := word(stage);
   Update current SpJoi;
  }
}

Function CheckMc : boolean;
{
  CheckMc := False;
  If(GetFirst JobTitleTmp where (( JoiHead.cRec == JobTitleTmp.nRec)) <> tsOk)
  CheckMc := True;
}

Function CheckAllRelation : boolean;
{
    CheckAllRelation := True
}
//============================
// инициализация
//============================
Function Merge_Catal_Init(ww_type:word):boolean;
{ Merge_Catal_Init:=True;
  NeedZarRun := 3;

  //Малоли...
  cParentRecord:=if(GetFirst SpJobCatalog where((cgCatalogS == SpJobCatalog.SysCode ))=tsOk,SpJobCatalog.Nrec,0);


  ClearFieldOption(#NeedZarRun, ofSelectable); // Для буд. - всегда изменять данные в ЗП

//Перед работой отчищаем маркер, т.к. лезут записи из других каталогов!
  CatalogsMarker:= InitMarker('CatalogsMarker', 8, 100, 10 );
  ClearMarker(CatalogsMarker);
  DoneMarker(CatalogsMarker,'CatalogsMarker');

  Var forDsk : boolean;
  Var bufDsk : string;
  if ww_type=0
  { if (ReadMyDsk (bufDsk,'FilterObCatalogS',forDsk) = true)  FilterObCatalogS := word(bufDsk);
    if (FilterObCatalogS=1) PushBounds (tbOnlyUser);
  }
  else
  { FilterObCatalogS:=1;
    PushBounds (tbOnlyUser);
  }
  wParamObCatal := 0;
  //bCorpo := InCorpo(cgCatalogS,coJobTitle);
  bCorpo := InCorpo(cgCatalogS);

  IF bCorpo
  {
    DelOutCOrpo(cgCatalogS);
    CorpoForUser(cgCatalogS);
  }

}
#include MergeCat.vpp
//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
//           Катимся до конца или пока не встретим саму себя!
//.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~.~
function Recursion(ParentNrec:Comp):boolean;
{
 var SaveNrec:Comp;
 Recursion:=True;
 if(GetFirst CatalogS Where (( ParentNrec == CatalogS.CParent))=tsOk)
 do
 {
   SaveNrec:=CatalogS.Nrec;
   if(CatalogS.Nrec = JoiHead.cRec ) //
    {
     Recursion:=false;
     exit;
    }
   Recursion:=Recursion(SaveNrec);
   if(Not Recursion) exit;
   GetFirst CatalogS Where (( SaveNrec == CatalogS.Nrec));
 }
 while(GetNext CatalogS Where (( ParentNrec == CatalogS.CParent))=tsOk)
}



//============================
// создать объединение
// ww_syscode - тип справочника
// w_in - что
// w_out  - куда
//============================
Function Merge_Catal_Ins(ww_syscode:longint; w_in:comp;w_out:comp) :boolean;
{  Merge_Catal_Ins:=False;

   IF true //not(FindExistCatalogS(tempNrec))
   {
      clearBuffer (#JoiHead);
      JoiHead.TypeEvent := word(ww_syscode);
      JoiHead.cRec := w_out;
      JoiHead.Status := word(0);
      JoiHead.UserName := UserName();
      JoiHead.dDate := Cur_Date;
      insert current JoiHead;
      //Exit;
    }
   ClearBuffer (#SpJoi);
   SpJoi.cJoiHead := JoiHead.nRec;
   SpJoi.cRec := w_in;
   SpJoi.Status := Word(0);
   SpJoi.IsDel := word(1);
   Insert current SpJoi;
   Merge_Catal_Ins:=True;
   ReReadRecord(#JoiHead);
   ReDrawPanel(#JoiHead);

}
//============================
// стартовать объединение
//============================
Function Merge_Catal_Start(ww_syscode:longint ) :boolean;
{ cgCatalogS:=ww_syscode;
  Merge_Catal_Start:=False;
  Merge_Catal_Init(1);
  wParamObCatal:=2; // только без ошибок
  if (CheckAllRelation)
  {
    Merge_Catal_Start:=MergingCatalogs;
  }

}


Panel pJoi
show at (,,,6);
Table JoiHead;
browse McJoi;
fields
  sObName   'Наим. (результат объединения)','─────────────────────────────────'('',,sci1378Esc): [33], protect;
  SObCode   'код': [10], protect;
  strJoiStatus 'Статус','───────────────'('',,sci1Esc) : [15], Protect;
  JoiHead.UserName 'Пользователь','────────────'('',,sci1Esc) : [12], Protect;
  strJoiCorpo '№ офиса','───────'('',,sci1Esc) : [7], Protect;
end;

handleevent

cmPick :
{
  IF JoiHead.UserName <> UserName() and JoiHead.cRec <> comp(0)
    {
    Message (chr(3)+'Этим объединением занимается другой пользователь !');
    Exit;
    }
  case CurField of #sObName :
    IF JoiHead.Status = 0
      {
      IF (RunInterface('z_staffcat::PickCatalog2',Integer(cgCatalogS),tempNrec,0) <> cmCancel)
            {
             IF not(FindExistCatalogS(tempNrec))
             {
              if (delete current JoiHead) <> tsOk {};
              clearBuffer (#JoiHead);
              JoiHead.TypeEvent := word(cgCatalogS+15000);
              JoiHead.cRec := tempNrec;
              JoiHead.Status := word(0);
              JoiHead.UserName := UserName();
              JoiHead.dDate := Cur_Date;
              insert current JoiHead;
              ReReadRecord(#JoiHead);
              ReDrawPanel(#JoiHead);
             }
            }
      }
  end;
}

cmInsert :
  case CurField of #sObName :
      IF (RunInterface('z_staffcat::PickCatalog2',Integer(cgCatalogS),tempNrec,0) <> cmCancel)
            {
             IF not(FindExistCatalogS(tempNrec))
             {
             clearBuffer (#JoiHead);
             JoiHead.TypeEvent := word(cgCatalogS+15000);
             JoiHead.cRec := tempNrec;
             JoiHead.Status := word(0);
             JoiHead.UserName := UserName();
             JoiHead.dDate := Cur_Date;
             insert current JoiHead;
             ReReadRecord(#JoiHead);
             ReDrawPanel(#JoiHead);
             }
            }
  end;

cmDeleteRecord :
{
  IF JoiHead.UserName <> UserName()
    {
    Message (chr(3)+'Этим объединением занимается другой пользователь !');
    Exit;
    }
  IF (Message(chr(3)+'Удалить запись ?'#13,yesno+mfSwapButtons ) = cmYes)
    {
    IF JoiHead.Status = word(3) or JoiHead.Status = word(4)
      {
      If (GetFirst SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and byte(1) == SpJoi.isDel and byte(4) == SpJoi.Status )) = tsOk)
        IF (Message(chr(3)+'Удалять из каталога, объединение'+chr(13)+
                    chr(3)+'которых завершено с ошибками ?'+
                    chr(13),yesno+mfSwapButtons) = cmYes)
          update SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and
            byte(1) == SpJoi.isDel and byte(4) == SpJoi.Status)) set Status := 3;

      if (GetFirst SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and
           byte(1) == SpJoi.isDel and byte(3) == SpJoi.Status)) = tsOk)
        {
        do {
//.~.~.~ Перед удалением обязательно перепривяжем подчиненные к ресультату
             //cParentRecord:=if(GetFirst SpJobCatalog
        update SpJobCatalog where (( SpJoi.cRec == SpJobCatalog.CParent)) set SpJobCatalog.CParent:=JoiHead.cRec;
//.~.~.~
             delete JobTitleTmp   where (( SpJoi.cRec == JobTitleTmp.nrec));

          } while (GetNext SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and
                   byte(1) == SpJoi.isDel and byte(3) == SpJoi.Status)) = tsOk);
        Message(''#3'Удаление из каталога произведено.',Information + OkButton);
        }
      }
    Delete SpJoi Where ((JoiHead.nRec == SpJoi.cJoiHead));
//.~.~.~ И проверим на корректность результат объединения
             //cParentRecord:=if(GetFirst SpJobCatalog
        if(GetFirst SpJobCatalog where (( JoiHead.cRec == SpJobCatalog.Nrec))=tsOk)
        { // А на всякий случай результат объединеия привязываем к корневому каталогу!
          //
            if(Not Recursion(JoiHead.cRec))// Проверяем все рекурсией!
            {
             SpJobCatalog.CParent:=cParentRecord;
             update current SpJobCatalog;
            }
        }
//.~.~.~
    Delete current JoiHead;
    }
  }
end; // hanldeevent
end; // panel pJoi


//=========================
Procedure RunVibSpJoi;
//=========================
{  tmpComp:=0;
   if cgCatalogS=-11 // Для подразделений в режиме единичного выбора
   { if (RunInterface(z_staffcat::PickCatalog2,Integer(cgCatalogS),tmpComp, 0) = cmDefault)
	           if(GetFirst SpJobCatalog where((tmpComp == SpJobCatalog.Nrec))=tsOk)
           {
              bSystem:=true;
              if(SpJobCatalog.SysCode<>0)
              if(Message('Запись '+SpJobCatalog.Name+' системная!'+chr(13)+'Объеденить?',YesNo+Information)=No)
              {  bSystem:=false;}
              IF (not(FindExistCatalogS(tmpComp)) And bSystem)
              {  //Message(SpJobCatalog.Name+'  '+SpJobCatalog.SysCode);
                 ClearBuffer (#SpJoi);
                 SpJoi.cJoiHead := JoiHead.nRec;
                 SpJoi.cRec := tmpComp;
                 SpJoi.Status := Word(0);
                 SpJoi.IsDel := word(1);
                 Insert current SpJoi;
              } //IF (not(FindExistCatalogS(tmpComp)) And bSystem)
           } //if(GetFirst SpJobCatalog where((tmpComp == SpJobCatalog.Nrec))=tsOk)


   }
   else
   if (RunInterface(z_staffcat::PickCatalog2,Integer(cgCatalogS),tmpComp, Comp(100)) = cmDefault)
   {  CatalogsMarker:= InitMarker('CatalogsMarker', 8, 100, 10 );
      CountMarker:=GetMarkerCount(CatalogsMarker);
      For(i:=0; i<CountMarker; i:=i+1)
      { if(GetMarker(CatalogsMarker, i, tmpComp))
        {//т.к. нельзя объединять системные
           if(GetFirst SpJobCatalog where((tmpComp == SpJobCatalog.Nrec))=tsOk)
           {
              bSystem:=true;
              if(SpJobCatalog.SysCode<>0)
              if(Message('Запись '+SpJobCatalog.Name+' системная!'+chr(13)+'Объеденить?',YesNo+Information)=No)
              {  bSystem:=false;}
              IF (not(FindExistCatalogS(tmpComp)) And bSystem)
              {  //Message(SpJobCatalog.Name+'  '+SpJobCatalog.SysCode);
                 ClearBuffer (#SpJoi);
                 SpJoi.cJoiHead := JoiHead.nRec;
                 SpJoi.cRec := tmpComp;
                 SpJoi.Status := Word(0);
                 SpJoi.IsDel := word(1);
                 Insert current SpJoi;
              } //IF (not(FindExistCatalogS(tmpComp)) And bSystem)
           } //if(GetFirst SpJobCatalog where((tmpComp == SpJobCatalog.Nrec))=tsOk)
        } //if(GetMarker(CatalogsMarker, i, tmpComp))        
     } //For(i:=0; i<CountMarker; i:=i+1)
     ClearMarker(CatalogsMarker);
     DoneMarker(CatalogsMarker,'CatalogsMarker');
   }//if (RunInterface(z_staffcat::PickCatalog2,Integer(cgCatalogS),tmpComp, Comp(100)) = cmDefault)

} //Procedure RunVibSpJoi;

//=============================================
panel pSpJoi
//=============================================
show at (,7,,17);
Table SpJoi;
browse McSpJoi;
fields
  sOb1Name   'Наим., подлежащих объединению','─────────────────────────────────'    ('',,sci1378Esc): [33], protect;
  SOb1Code :[10], protect;
  strSpJoiStatus 'Статус','───────────────'      ('',,sci1Esc) : [15], Protect;
  cSpJoiDel 'Удалять','───────'     ('Изменяется при нажатии на <F3>',,sci13Esc): [7], protect;
end;
handleevent
cmPick :
{
  IF JoiHead.UserName <> UserName()
    {
    Message (chr(3)+'Этим объединением занимается другой пользователь !');
    Exit;
    }

 case CurField of
  #sOb1Name :
   IF JoiHead.Status = 0
     {    RunVibSpJoi;
          ReReadRecord(#SpJoi);
          ReDrawPanel(#SpJoi);
     }
  #cSpJoiDel :
    if (SpJoi.cRec <> comp(0))
      {
      If (SpJoi.IsDel = word(1))
        SpJoi.IsDel := word(0);
      Else
        SpJoi.IsDel := word(1);
      Update current SpJoi;
      RedrawPanel (#SpJoi);
      }
 end;
}

cmInsert:
{
  IF JoiHead.UserName <> UserName()
    {
    Message (chr(3)+'Этим объединением занимается другой пользователь !');
    Exit;
    }

     IF JoiHead.Status = 0
     {
       RunVibSpJoi;
       ReReadRecord(#SpJoi);
       ReDrawPanel(#SpJoi);
     }
 }

cmDeleteRecord :
{
  IF JoiHead.UserName <> UserName()
    {
      Message (chr(3)+'Этим объединением занимается другой пользователь !');  Exit;
    }

 IF JoiHead.Status = 0
   IF (Message(chr(3)+'Удалить запись ?'#13,yesno+mfSwapButtons ) = cmYes)
   {  if cgCatalogS=-11 // СЕ ШР
        delete all extcatlinks;
      Delete current SpJoi;
   }
}

end; // handleevent
end; // panel pSpJoi
// Экран с кнопками
