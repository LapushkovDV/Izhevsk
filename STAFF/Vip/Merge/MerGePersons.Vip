function Recursion(ParentNrec:Comp):boolean;
{ #__UNUSED__(ParentNrec)
  Result:=false;
  exit;
}



//============================
// создать объединение
// ww_syscode - тип справочника
// w_in - что
// w_out  - куда
//============================
Function Merge_Persons_Ins( w_in:comp;w_out:comp) :boolean;
{  Result:=False;

   IF true //not(FindExistPersons(tempNrec))
   {
      clearBuffer (#JoiHead);
      JoiHead.TypeEvent := coPersons;
      JoiHead.cRec := w_out;
      JoiHead.Status := word(0);
      JoiHead.UserName := UserName();
      JoiHead.dDate := Cur_Date;
      insert current JoiHead;
      //Exit;
    }
   ClearBuffer (#SpJoi);
   SpJoi.cJoiHead := JoiHead.nRec;
   SpJoi.cRec := w_in;
   SpJoi.Status := Word(0);
   SpJoi.IsDel := word(1);
   Insert current SpJoi;
   Result:=True;
   ReReadRecord(#JoiHead);
   ReDrawPanel(#JoiHead);

}
//============================
// стартовать объединение
//============================
Function Merge_Persons_Start :boolean;
{ Result:=False;
  Merge_Catal_Init(1);
  wParamObCatal:=2; // только без ошибок
  if (CheckAllRelation)
  {
    Result:=MergingPersons;
  }

}


Panel pJoi
show at (,,,6);
Table JoiHead;
browse McJoi;
fields
  sObName   'Наим. (результат объединения)','─────────────────────────────────'('',,sci1378Esc): [33], protect;
  SObCode   'код': [10], protect;
  strJoiStatus 'Статус','───────────────'('',,sci1Esc) : [15], Protect;
  JoiHead.UserName 'Пользователь','────────────'('',,sci1Esc) : [12], Protect;
  strJoiCorpo '№ офиса','───────'('',,sci1Esc) : [7], Protect;
  JoiHead.cRec 'ID' :[20],Protect,NoDel;
end;

handleevent

cmPick :
{
  IF JoiHead.UserName <> UserName() and JoiHead.cRec <> comp(0)
    {
    Message (chr(3)+'Этим объединением занимается другой пользователь !');
    Exit;
    }
  case CurField of #sObName :
    IF JoiHead.Status = 0
      {  tempnrec:=JoiHead.cRec;
         if (RunInterface(MergePersonsVib,tempNrec) = cmDefault)
            {
             IF not(FindExistPersons(tempNrec))
             {
              if (delete current JoiHead) <> tsOk {};
              clearBuffer (#JoiHead);
              JoiHead.TypeEvent := word(cgPersons);
              JoiHead.cRec := tempNrec;
              JoiHead.Status := word(0);
              JoiHead.UserName := UserName();
              JoiHead.dDate := Cur_Date;
              insert current JoiHead;
              ReReadRecord(#JoiHead);
              ReDrawPanel(#JoiHead);
             }
            }
      }
  end;
}

cmInsert :
  case CurField of #sObName :
      IF (RunInterface('MergePersonsVib',tempNrec) <> cmCancel)
            {
             IF not(FindExistPersons(tempNrec))
             {
             clearBuffer (#JoiHead);
             JoiHead.TypeEvent := word(cgPersons);
             JoiHead.cRec := tempNrec;
             JoiHead.Status := word(0);
             JoiHead.UserName := UserName();
             JoiHead.dDate := Cur_Date;
             insert current JoiHead;
             ReReadRecord(#JoiHead);
             ReDrawPanel(#JoiHead);
             }
            }
  end;

cmDeleteRecord :
{
  IF JoiHead.UserName <> UserName()
    {
    Message (chr(3)+'Этим объединением занимается другой пользователь !');
    Exit;
    }
  IF (Message(chr(3)+'Удалить запись ?'#13,yesno+mfSwapButtons ) = cmYes)
    {
    IF JoiHead.Status = word(3) or JoiHead.Status = word(4)
      {
      If (GetFirst SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and byte(1) == SpJoi.isDel and byte(4) == SpJoi.Status )) = tsOk)
        IF (Message(chr(3)+'Удалять из каталога, объединение'+chr(13)+
                    chr(3)+'которых завершено с ошибками ?'+
                    chr(13),yesno+mfSwapButtons) = cmYes)
          update SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and
            byte(1) == SpJoi.isDel and byte(4) == SpJoi.Status)) set Status := 3;

      if (GetFirst SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and
           byte(1) == SpJoi.isDel and byte(3) == SpJoi.Status)) = tsOk)
        {
        do {
             delete JobTitleTmp   where (( SpJoi.cRec == JobTitleTmp.nrec));

          } while (GetNext SpJoi where ((JoiHead.nRec == SpJoi.cJoiHead and
                   byte(1) == SpJoi.isDel and byte(3) == SpJoi.Status)) = tsOk);
        Message(''#3'Удаление из каталога произведено.',Information + OkButton);
        }
      }
    Delete SpJoi Where ((JoiHead.nRec == SpJoi.cJoiHead));
//.~.~.~ И проверим на корректность результат объединения
//.~.~.~
    Delete current JoiHead;
    }
  }
end; // hanldeevent
end; // panel pJoi


//=========================
Procedure RunVibSpJoi;
//=========================
{  tmpComp:=SpJoi.cRec;
   if (RunInterface(MergePersonsVib,tmpComp) = cmDefault)
	 if(GetFirst SpJobPersons where((tmpComp == SpJobPersons.Nrec))=tsOk)
   { IF (not(FindExistPersons(tmpComp)))
     {  //Message(SpJobPersons.Name+'  '+SpJobPersons.SysCode);
                 ClearBuffer (#SpJoi);
                 SpJoi.cJoiHead := JoiHead.nRec;
                 SpJoi.cRec := tmpComp;
                 SpJoi.Status := Word(0);
                 SpJoi.IsDel := word(1);
                 Insert current SpJoi;
      } //IF (not(FindExistPersons(tmpComp)) And bSystem)
   } //if(GetFirst SpJobPersons where((tmpComp == SpJobPersons.Nrec))=tsOk)


} //Procedure RunVibSpJoi;

//=============================================
panel pSpJoi
//=============================================
show at (,7,,17);
Table SpJoi;
browse McSpJoi;
fields
  sOb1Name   'Наим., подлежащих объединению','─────────────────────────────────'    ('',,sci1378Esc): [33], protect;
  SOb1Code :[10], protect;
  strSpJoiStatus 'Статус','───────────────'      ('',,sci1Esc) : [15], Protect;
  cSpJoiDel 'Удалять','───────'     ('Изменяется при нажатии на <F3>',,sci13Esc): [7], protect;
end;
handleevent
cmPick :
{
  IF JoiHead.UserName <> UserName()
    {
    Message (chr(3)+'Этим объединением занимается другой пользователь !');
    Exit;
    }

 case CurField of
  #sOb1Name :
   IF JoiHead.Status = 0
     {    RunVibSpJoi;
          ReReadRecord(#SpJoi);
          ReDrawPanel(#SpJoi);
     }
  #cSpJoiDel :
    if (SpJoi.cRec <> comp(0))
      {
      If (SpJoi.IsDel = word(1))
        SpJoi.IsDel := word(0);
      Else
        SpJoi.IsDel := word(1);
      Update current SpJoi;
      RedrawPanel (#SpJoi);
      }
 end;
}

cmInsert:
{
  IF JoiHead.UserName <> UserName()
    {
    Message (chr(3)+'Этим объединением занимается другой пользователь !');
    Exit;
    }

     IF JoiHead.Status = 0
     {
       RunVibSpJoi;
       ReReadRecord(#SpJoi);
       ReDrawPanel(#SpJoi);
     }
 }

cmDeleteRecord :
{
  IF JoiHead.UserName <> UserName()
    {
      Message (chr(3)+'Этим объединением занимается другой пользователь !');  Exit;
    }

 IF JoiHead.Status = 0
   IF (Message(chr(3)+'Удалить запись ?'#13,yesno+mfSwapButtons ) = cmYes)
   {
      Delete current SpJoi;
   }
}

end; // handleevent
end; // panel pSpJoi
// Экран с кнопками
screen ButtonsList;
  show at (,18,,24);
  Fields
    FilterObPersons ('Изменяется при нажатии на <Пробел>',,sci1Esc) :, noprotect;
    NeedZarRun : noprotect;
Buttons
  cmObed,Default,,,,sci1Esc;
  cmCancel,,,,,sci1Esc;
<<
  Показывать объединения         Включить в обработку таблицы модуля Заработная плата:
  (.) всех пользователей`        [.] таблицы с архивной информацией`
  (.) только свои       `        [.] таблицы с текущей информацией`
                      <.~О~бъединить .>         <. О~т~мена .>
>>
end; // screen

handleevent

cmCheckField:
{
 case CurField of
  #FilterObPersons :
  {
  if (FilterObPersons=0)
     if (BoundActive(tbOnlyUser))
      PopBounds (tbOnlyUser);
  if (FilterObPersons=1)
    if (not(BoundActive(tbOnlyUser)))
      PushBounds (tbOnlyUser);
  if (GetFirst JoiHead = tsOk) {};
  ReReadRecord(#JoiHead);
  RescanPanel (#JoiHead);
  RescanPanel (#SpJoi);
  SelectPanel (#JoiHead);
  SaveMyDsk (string(FilterObPersons),'FilterObPersons');
  }

end; // case
}

cmInit:
{
  Timelog('MergeCat ->cmInit');
  Merge_Catal_Init(0);
  SetTitle('Объединение Persons ');
  IF (GetFirst tmpJoiHead where (( word(cgPersons) == tmpJoiHead.TypeEvent and
      UserName() == tmpJoiHead.UserName and (Word(1)=tmpJoiHead.Status))) = tsOk )
  {
    wParamObCatal := Word(1);
    IF (Message(chr(3)+'Обнаружено незавершенное объединение '+chr(13)+
                chr(3)+'рекомендуется немедленно продолжить это объединение.'+chr(13)+
        chr(13)+chr(3)+'Запустить незавершенное объединение ?',yesno) = cmYes)
      PutCommand(cmObed);
    ELSE
      CloseInterface (cmCancel);
  }
}

cmInsert:  Abort;

cmDefault: Abort;

cmHotKeys :
  PutHotCommAnd(RunMenu('ObedProff_HotKeys_Print'));

cmPrintDoc :
{
  if (frmObedAll.error)
  {
    frmObedAll.AbortForm;
    message(''#3'Ошибка при формировании протокола соответствия.' +
            ''#13#3'Возможно, формы ObedAll нет в ресурсе.',CancelButton);
    Exit;
  }
  else    #PrintRelation(JobTitle1,JobTitle,Fio,' Сотрудников')
}

cmObed :
{
  IF wParamObCatal <> 1
  {
    IF (GetFirst tmpJoiHead where (( word(cgPersons) == tmpJoiHead.TypeEvent AND
                                    UserName() == tmpJoiHead.UserName)) = tsOk)
      do
      {
        IF (GetFirst tmpSpJoi where
                ((tmpJoiHead.nRec == tmpSpJoi.cJoiHead)) <> tsOk)
        {
          IF (GetFirst JobTitleTmp where (( tmpJoiHead.cRec == JobTitleTmp.nrec)) = tsOk ) {};
          Message (chr(3)+'Для результата объединения'+chr(13)+
                   chr(3)+'"'+trim(JobTitleTmp.Fio)+'"'+chr(13)+
                   chr(3)+'не выбраны данные, которые необходимо объединять',CancelButton);
          EXIT;
        }
      } WHILE (GetNext tmpJoiHead where ((word(cgPersons) == tmpJoiHead.TypeEvent AND
                                          UserName() == tmpJoiHead.UserName)) = tsOk);
    IF (GetFirst tmpJoiHead where (( word(cgPersons) == tmpJoiHead.TypeEvent and
                                     UserName() == tmpJoiHead.UserName and
                                     (Word(4)=tmpJoiHead.Status) )) = tsOk )

      IF (Message(''#3'Хотите повторять объединение для' +
                  ''#13#3'завершенных с ошибками данных ?'#13,YesNo) = cmNo)
        wParamObCatal := 2;
  }
  if (CheckAllRelation)
  {
    MergingPersons;
  }
  ReReadRecord(#JoiHead);
  ReReadRecord(#SpJoi);
}
end;
end.  // Interface

ObedProff_HotKeys_Print Menu
{
- 'Печать',cmPrintDoc,'Печать соответствия объединения',, 'Ctrl+P', kbCtrlP, scMenuCtx;
}
