var
  cParentRecord: Comp;
  NeedZarRun   : word;        //нужна для проверки какие птички стоят для использования зарплатных таблиц
  ErrorJoi     : longint;     // Временная для определения ошибок объединения
  ErrorSp      : longint;     // Временная для определения ошибок объединения
  prSp         : boolean;
  count_vis    : longint;
  tmpComp      : Comp;
  i            : integer;
  tempNrec     : comp;        // Временная для nRec
  lCycle1      : word;        // переменная для циклов
  bSystem      : boolean;     // проверка на системность
  bBreak       : boolean;     // Прерывание объединения
  wParamObCatal : word;     // Параметр запуска объединения:
                              // 0 - все  (новые и завершенные с ошибками),
                              // 1 - только незавершенные, 2 - только без ошибок
  bCorpo       : boolean;     // Признак Corpo
  CountRecOrdInProcess :integer; //количество записей для визуализации vtDownVisual
  FilterObPersons   : word;
  (sObName,
   sObcode,
   sOb1Name,
   sOb1code,
  strJoiStatus,
  strSpJoiStatus,
  cSpJoiDel,
  strJoiCorpo)
As select
  if(not(isValid(tnJobTitle)) and JoiHead.cRec <> comp(0),'Удаленная запись',JobTitle.Fio),
  if(not(isValid(tnJobTitle)) and JoiHead.cRec <> comp(0),'Удаленная запись',JobTitle.StrTabn),
  if(not(isValid(tnJobTitle1)) and SpJoi.cRec <> comp(0),SpJoi.Name,JobTitle1.Fio),
  if(not(isValid(tnJobTitle1)) and SpJoi.cRec <> comp(0),'???',JobTitle1.StrTabn),
  if(JoiHead.Status = byte(1),'Начато',
             if(JoiHead.Status = byte(2),'Прервано',
                if(JoiHead.Status = byte(3),'Завершено',
                  if(JoiHead.Status = byte(4),'Заверш. с ошиб.','')))),

  if(SpJoi.Status = byte(1),'Начато',
             if(SpJoi.Status = byte(2),'Прервано',
                if(SpJoi.Status = byte(3),'Завершено',
                  if(SpJoi.Status = byte(4),'Заверш. с ошиб.','')))),
  if(SpJoi.IsDel = byte(1),'+',''),
  if(JoiHead.prCorpo <> byte(0),string(JoiHead.prCorpo),'')
#InternalFieldsForShowFilial
  
From
  JoiHead,
  SpJoi,
  EvJoiHead,
  Persons ,
//  X$REGISTERTABLES,
synonym Persons JobTitle,
synonym JoiHead  tmpJoiHead,
synonym SpJoi    tmpSpJoi,
synonym EvJoiHead EvJoiHead1,
synonym Persons    JobTitle1,
synonym Persons    JobTitleTmp,
//synonym Persons JobTitleTEMP,
synonym Persons SpJobPersons // Для проверки системности

//***************  Для RecordsInTable ***************
//D_ZARPL
,ADDINF,APPENDIX,ATTESTATION,BADGE,CASEPSN,CLAIMANT
,COMMUNICATIONS,CONSCRIPTION,CONTDOC,COPYNENA,COPYPER,COPYSOP,COPYSUD,DETPLANOTPUSK
,DISEASE,DOCPODOTCHET,DOPINFO,EDUCATION,EXPERIENCE,FACTOTPUSK,FEATURES,FORMARKS
,FORTUNE,FUTUREPOST,HEALTHDR,HIRE,INFPSN2,LANG,LSTAB
,MILRANKS,MOVELSC,NACHISL,NENACH,NOTES,NPF,OTPOTZ,OTPUSK,PENSTAJ
,PEREVOD,PEREVODTEK,PERSTEST,PERSVACATION,PLANATT,PLANEDUC,PLANOTPUSK
,PSNFORSEND,PSNLINKS,PUNISHMENTS,RAISE,REGIMECHANGES,REPLIST,SALSCALE
,SERTCAT,SERVLEN,STORNTAB,SUMVIDOP,SUMVIDUD,UDER,VACANCY,VISADRV

#IFDEF _SPB_
#ENDIF
// филиал
#TableForFilial

Where
((
      word(cgPersons) == JoiHead.TypeEvent    // Профессии
  and JoiHead.cRec == JobTitle.nRec          // Объединение - Persons
  and JoiHead.nRec == SpJoi.cJoiHead         // Объединение - Persons
  and SpJoi.cRec   == JobTitle1.nRec              // Спецификация Persons

  
#WhereForFilial
))
Bounds OnlyUser =
      word(cgPersons) == JoiHead.TypeEvent and UserName() == JoiHead.UserName
;



File MemoFile;
File FileProtocol;

Procedure ObBreak;  // Прерывание объединения
{
Var count_out : longint;

count_out := VisualCount ();
Message(chr(3)+'Для прекращения объединения придется'+chr(13)+
        chr(3)+'подождать до окончания замены на'+chr(13)+
        chr(3)+'"' +trim (JobTitleTmp.Fio)+'"',Information + OkButton);

ReStartVisual(''#3'Идет замещение на'#13#3''+'"'+ trim(JobTitleTmp.Fio)+'"' +
              ''#13#3'',Count_vis);
NNextVisual (count_out);

bBreak := True;
}

form ErrObAll ('ErrObMc.OUT','ErrObAll') with NoVisual;
FORM frmObedAll('obedMC.out','obedAll') with novisual;
#include GP_ErrObAll.vpp    // Пакет ошибок ErrObAll.vpp

