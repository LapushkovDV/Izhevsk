cmValue18:// 'Логистика-Накладная';
{
  var wf0, wf1,wf2,wf3,wf4 :string ; 
  wf0:='' ;wf1:='' ; wf2:='' ;wf3:='' ; wf4:='' ;
  Add_index_usl('' , 'word(201)' , 'KATSOPR','VIDSOPR', wf0 , wf1 );
  Add_field(wf1,'NSOPR','')  ;
  Add_field(wf1,'DSOPR','')  ;
  Add_field(wf1,'DOPR','')  ;
  Add_field(wf1,'VIDSOPR','')  ;
  Add_field(wf1,'DESCR','')  ;
  Add_field(wf1,'DESGR','')  ;
  
  Add_index_usl('' , 'date(1,1,2007)' , 'KATSOPR','DSOPR', wf0 , wf1 );
  Add_index_usl('' , 'date(1,1,2007)' , 'KATSOPR','DSOPR', wf0 , wf1 );
  Add_index_usl('KATSOPR' , 'CORG' , 'KATORG','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','организация') ; wf2:='' ;
  
  Add_index_usl('KATSOPR' , 'NREC' , 'SPSOPR','CSOPR', wf1 , wf2 );
  Add_field(wf2,'NPP','') ;
  Add_field(wf2,'PRMC','') ;
  Add_index_usl('SPSOPR', 'CMCUSL' , 'KATMC','NREC', wf2 , wf3 );
  Add_field(wf3,'NAME','МЦ') ; wf3:='' ;
  
  Add_index_usl('SPSOPR', 'CMCUSL' , 'KATUSL','NREC', wf2 , wf3 );
  Add_field(wf3,'NAME','Услуга') ; wf3:='' ;
  
  Add_index_usl('KATSOPR' , 'CDOGOVOR' , 'DOGOVOR','NREC', wf1 , wf3 );
  Add_field(wf3,'NODOC','Договор') ; 
  Add_field(wf3,'DDOC','Договор') ; 
  
  ReScanAll ;
} //cmValue18:// 'Логистика-Накладная';
cmValue19:// 'Логистика-До';
{

  var wf0, wf1,wf2,wf3,wf4 :string ; 
  wf0:='' ;wf1:='' ; wf2:='' ;wf3:='' ; wf4:='' ;
  Add_index_usl('' , 'word(201)' , 'BASEDOC','VIDDOC', wf0 , wf1 );
  Add_index_usl('' , 'date(1,1,2007)' , 'BASEDOC','DDOC', wf0 , wf1 );
  Add_field(wf1,'NODOC','') ; 
  Add_field(wf1,'DDOC','') ; 
  Add_index_usl('BASEDOC' , 'CORG' , 'KATORG','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','организация') ; wf2:='' ;

  Add_index_usl('BASEDOC' , 'CDOGOVOR' , 'DOGOVOR','NREC', wf1 , wf2 );
  Add_field(wf3,'NODOC','Договор') ; 
  Add_field(wf3,'DDOC','Договор') ; wf2:='' ;
  Add_index_usl('BASEDOC' , 'NREC' , 'STEPDOC','CBASEDOC', wf1 , wf2 );
  Add_index_usl('STEPDOC' , 'NREC' , 'SPSTEP','CSTEPDOC', wf2 , wf3 );
  Add_field(wf3,'PRMC','') ;
  Add_index_usl('STEPDOC', 'CMCUSL' , 'KATMC','NREC', wf3 , wf4 );
  Add_field(wf3,'NAME','МЦ') ; wf4:='' ;
  Add_index_usl('STEPDOC', 'CMCUSL' , 'KATUSL','NREC', wf3 , wf4 );
  Add_field(wf3,'NAME','Услуга') ; wf4:='' ;

  ReScanAll ;
} //cmValue19:// 'Логистика-До';
cmValue20:// 'Бухконтур-Обороты';
{
  var wf0, wf1,wf2,wf3,wf4 :string ; 
  wf0:='' ;wf1:='' ; wf2:='' ;wf3:='' ; wf4:='' ;
  Add_index_usl('' ,chr(39)+'526'+chr(39) , 'OBOROT','SCHETO', wf0 , wf1 );
  Add_index_usl('' ,'date(1,1,2007)' , 'OBOROT','DATOB', wf0 , wf1 );
  Add_index_usl('' ,'date(1,1,2007)' , 'OBOROT','DATOB', wf0 , wf1 );
  Add_field(wf1,'DDOC','') ; 
