/*==========================================
предназначен для генерации Sql запросов
===============================*/


type myIndexFlt = record
   priznak : word ; // признак необходимости обработки
   kol_field: word ; // не больше 20
   Field_ID: array [1..20] of word ;
end;


//===================================
// Сам фейс
//===================================
VipInterface GenSqlZarpr licensed (FREE) Parameters(wfile_in:string);
VipInterface MYGETINDEX licensed (FREE) Parameters( wfile_id :word ; windex_id :word ;wmyIndexFlt: myIndexFlt ) ;
/* Параметры
wfile_id - инидефикатор файла - обязателен
windex_id - номер выбранного индекса - возвращается
wmyIndexFlt - wmyIndexFlt.kol_field=0 фильтр не накладывается
иначе пытаемся подобрать индекс
*/
VipInterface MYGETFILEID licensed (FREE) Parameters( wfile_id :word ;type_vib:word ) ;
VipInterface MYGETFIELD licensed (FREE) Parameters( wfile_id :word ;type_vib:word ; wfield_id :word ) ;

VipInterface FieldVibByRelate  licensed (FREE) Parameters( wfile_id :word ; wfield_id :word;wfile_idfor :word ; wfield_idfor :word ) ;


//===================================
Interface GenSqlZarpr 'Генерация Sql запроса' ;
//===================================
table struct tmp_field
( pa:word ,
  file_id :word ,
  filef :string[30] ,
  field_id:word ,
  fieldf :string[100],
  number : word ,
  name : string[100] ,
  len :word ,
  prim :string ,
  strval :string[250]
  
)
with index
(  tmp_field01 = pa+ number
  ,tmp_field02 = pa+file_id+field_id

) ;
table Struct tmp_from
( nrec :comp ,
  number : word ,
  pa:word ,
  file_id :word ,
  name :string[30] ,
  index_id :word ,
  name2 :string[30] ,
  prim :string[200] 
)
with index
(  tmp_from01 = nrec (autoinc,unique)
  ,tmp_from02 = pa+number
  ,tmp_from03 = pa+name2
  ,tmp_from04 = pa+name
  ,tmp_from05 = pa+file_id+name2
) ;
table struct tmp_index // основная 
( pa: word ,
  tp_left :word ,

  file_left :word ,
  file_leftf :string[30] ,
  field_left:word ,
  val_left :string[200],

  file_right:word ,
  file_rightf:string[30] ,
  field_right:word ,
  val_right :string[200] ,
  attrib :word , // noindex,length и так далее
  len :word , // длина условия
  tp_right :word ,
  cond :word ,
  prim :string[200],
  number : word
   
)
with index
(  tmp_index01 = pa+number 
  ,tmp_index02 = pa+file_leftf+field_left
  ,tmp_index03 = pa+file_rightf+field_right
  ,tmp_index04 = pa+file_leftf+number
  ,tmp_index05 = pa+file_rightf+number
  
) ;
table struct tmp_noindex // не индексные условия
( pa: word ,
  tp_left :word ,
  file_left :word ,
  file_leftf :string[30] ,
  field_left:word ,
  val_left :string[200],
  file_right:word ,
  file_rightf:string[30] ,
  field_right:word ,
  val_right :string[200],
  tp_right :word ,
  cond :word ,
  cond_scep :word ,  // условие сцепки с послед.выражениями
  Vir_left :string[20],
  Vir_right :string[20],
  prim :string[200],
  number : word

)
with index
( tmp_noindex01 = pa+number 

) ;
table struct tmp_order // задание сортировки
( pa:word,
  file_id :word ,
  filef :string[40] ,
  field_id :word ,
  fieldf :string[40] ,
  
  number : word 
) 
with index
( tmp_order01 = pa+number 

) ;
table struct tmp_comm // дополнительные команды, выгрузка в дбф, запуск внешнего приложения и т.п.
( pa :word ,
  tp :word ,
  number : word ,
  comm : string ,
  param :string 
) 
with index
( tmp_comm01 = pa+number 

) ;
var
  wmyIndexFlt: myIndexFlt ;
create view vGenSqlZarpr
var 
   wfile_in:string ;
   wkolrecs :longint ;
   nmfile :string ;
   wpa :word ;
   wnum :word ;
   kl_vib : boolean ;
   wfile_id: word ;
   wfield_id : word ;
   wfile_name :string ;
   wfield_name :string ;
   wfile_sql :string ;
   Markers :longint ;
   my_curtable:longint ;
   my_curtablename:string ;
as select x$files.XF$NAME
from 
 tmp_field(tmp_field01),tmp_from(tmp_from02)
,tmp_index(tmp_index01)
,tmp_noindex(tmp_noindex01)
,tmp_order(tmp_order01),tmp_comm(tmp_comm01)
,tmp_field tmp_field1,tmp_from tmp_from1(tmp_from02)
,tmp_index tmp_index1,tmp_noindex tmp_noindex1
,tmp_order tmp_order1, tmp_comm tmp_comm1

,x$files ,x$files x$files_from
,x$files x$files_indleft  ,x$files x$files_indright
,x$files x$files_noindleft,x$files x$files_noindright
,x$files x$files_order    , x$files x$files_field

,X$FIELDS 
,X$FIELDS X$FIELDS_indleft  ,X$FIELDS X$FIELDS_indright
,X$FIELDS X$FIELDS_noindleft,X$FIELDS X$FIELDS_noindright
,X$FIELDS X$FIELDS_order    ,X$FIELDS X$FIELDS_field

,X$INDEXES ,X$INDEXES X$INDEXES_from

where
(( 
// поля
  wpa == tmp_field.pa 
and tmp_field.file_id == x$files_field.XF$CODE
and x$files_field.XF$CODE == X$FIELDS_field.XE$FILECODE
and tmp_field.field_id == X$FIELDS_field.XE$CODE
// from
and wpa == tmp_from.pa
and tmp_from.file_id == x$files_from.XF$CODE
and x$files_from.XF$CODE == X$INDEXES_from.XI$FILECODE
and tmp_from.index_id == X$INDEXES_from.XI$NUMBER
and 0 == X$INDEXES_from.XI$PART
// условие индексного фильтра
and wpa == tmp_index.pa
and tmp_index.file_left == x$files_indleft.XF$CODE
and x$files_indleft.XF$CODE == X$FIELDS_indleft.XE$FILECODE
and tmp_index.field_left== X$FIELDS_indleft.XE$CODE

and tmp_index.file_right == x$files_indright.XF$CODE
and x$files_indright.XF$CODE == X$FIELDS_indright.XE$FILECODE
and tmp_index.field_right== X$FIELDS_indright.XE$CODE

// условие неиндексного фильтра


and wpa == tmp_noindex.pa
and tmp_noindex.file_left == x$files_noindleft.XF$CODE
and x$files_noindleft.XF$CODE == X$FIELDS_noindleft.XE$FILECODE
and tmp_noindex.field_left== X$FIELDS_noindleft.XE$CODE

and tmp_noindex.file_right == x$files_noindright.XF$CODE
and x$files_noindright.XF$CODE == X$FIELDS_noindright.XE$FILECODE
and tmp_noindex.field_right== X$FIELDS_noindright.XE$CODE

and wpa == tmp_order.pa
and tmp_order.file_id == x$files_order.XF$CODE
and x$files_order.XF$CODE == X$FIELDS_order.XE$FILECODE
and tmp_order.field_id == X$FIELDS_order.XE$CODE


and wpa == tmp_comm.pa

)) ;
Parameters wfile_in;
file f ;

Procedure MySetInfo ;
{ case my_curtable of 
  #tmp_field  : my_curtablename:='FIELD' ;
  #tmp_from    : my_curtablename:='FROM' ;
  #tmp_index   : my_curtablename:='INDEx';
  #tmp_noindex : my_curtablename:='NOIND';
  #tmp_order   : my_curtablename:='ORDER' ;
  #tmp_comm    : my_curtablename:='COMM' ;
  else my_curtablename:='' ;
  end ;
  rescanpanel(tnx$files);
}

window wnVibFrom 'Выбрать таблицу',cyan ;
browse brVibFrom 'From';
table tmp_from ;
fields
 tmp_from.number 'Номер' (' порядковый номер') : protect ;
 tmp_from.name 'Наименование'  ('Наименование',,) : [20],protect;
 tmp_from.name2 'синоним' : [10],protect ;
 X$INDEXES_from.XI$NAME 'Индекс' :[10],protect ;

 if(isvalid(tnx$files_from),x$files_from.XF$NAME+'/'+
   x$files_from.XF$TITLE,'') 'Комментарий' :[50],protect ;
 tmp_from.prim 'примечание' :[50],protect ; 
end ; // brVibFrom
HandleEvent
cmDefault :
{ kl_vib:=true ;
  Closewindow(wnVibFrom) 
}
end; //HandleEvent
end ; //wnVibFrom

// выбор из Fields
window wnVibField 'Выбрать поле',cyan ;
browse brVibField 'Field';
table tmp_Field ;
fields
 tmp_field.number 'Номер' ( 'Fields Порядковый номер') : protect ;
 tmp_field.strval 'Наименование' ('Fields Выражение для поля') : [20],protect ;
 tmp_field.filef 'Таблица' ( 'Fields Наименование таблицы') : [10],protect ;
 if(isvalid(#x$files_field),x$files_field.XF$NAME+'/'+x$files_field.XF$TITLE+'.'+
   X$FIELDS_field.XE$TITLE,'') 'Комментарий' :[50],protect ;
 tmp_field.name 'Наимен.' ('Fields Представление в выгрузке')  :[10],protect ; 
 tmp_field.len 'Длина' ('Fields Размер поля') :[10],protect ; 
 tmp_field.prim 'примечание' :[50],protect ; 
end ; // brVibField
HandleEvent
cmDefault :
{ kl_vib:=true ;
  Closewindow(wnVibField) 
}
end; //HandleEvent
end ; //wnVibField

Procedure  ReScanAll ;
{ rescanpanel(#tmp_from) ;
  rescanpanel(#tmp_field) ;
  rescanpanel(#tmp_comm) ;
  rescanpanel(#tmp_index) ;
  rescanpanel(#tmp_noindex) ;
  rescanpanel(#tmp_order) ;
}
//===============================
// устновить условие для индексного условия
//===============================
Function GetVir(w :word ) :string ;
{ case w of
  0 : GetVir:='==' ;
  1 : GetVir:='<<=';
  2 : GetVir:='>>=';
  3 : GetVir:='/==';
  4 : GetVir:='<<' ;
  5 : GetVir:='>>' ;
  else GetVir:='==';
  end ;
}
//===============================
Function SetVir(w :string ) :word ;
{ w:=trim(w) ;
  case w of
  '=='  : SetVir:=0 ;
  '<<=' : SetVir:=1 ;
  '>>=' : SetVir:=2 ;
  '/==' : SetVir:=3 ;
  '<<'  : SetVir:=4 ;
  '>>'  : SetVir:=5 ;
  else    SetVir:=0 ;
  end ;
}
//===============================
// устновить условие для неиндексного условия
//===============================
Function GetVir1(w :word ) :string ;
{ case w of  
  1: GetVir1:='=' ;
  2: GetVir1:='<=' ;
  3: GetVir1:='>=' ;
  4: GetVir1:='<>' ;
  5: GetVir1:='<'  ;
  6: GetVir1:='>'  ;
  else GetVir1:='' ;
  end ;
}
//===============================
Function SetVir1(w :string ) :word ;
{ case w of
  '=' : SetVir1:=0 ;
  '<=': SetVir1:=1 ;
  '>=': SetVir1:=2 ;
  '<>': SetVir1:=3 ;
  '<' : SetVir1:=4 ;
  '>' : SetVir1:=5 ;
  else  SetVir1:=6 ;
  end ;

}
//===============================
// вставка во From wkl=true - вставить безусловно
//===============================
Function InsRecord_To_Form(wfileid:word ; wkl :boolean ) : boolean ;
var k :word ;
{ InsRecord_To_Form:=false;
  if wkl or  (getfirst tmp_from where (( wpa ==tmp_from.pa and
     wfileid == tmp_from.file_id))<>0)
  { if getfirst X$Files where ((wfileid == X$Files.XF$Code ))=0
    { //message('!!!')
      if getlast tmp_from1 where (( wpa==tmp_from1.pa )) ordered by index tmp_from02=0 
        wnum :=tmp_from1.number 
      else 
        wnum :=0 ;
      clearbuffer(#tmp_from) ;
      tmp_from.pa:=wpa ;
      tmp_from.number:=wnum+1 ;
      tmp_from.index_id := 65000 ;
      tmp_from.file_id:=wfileid ;
      tmp_from.name :=X$Files.XF$Name ;
      tmp_from.name2 :=X$Files.XF$Name ;
      insert current tmp_from ;
      if wkl
      { k:=0 ;
        while (getfirst tmp_from1 where (( wpa == tmp_from1.pa
          and tmp_from.file_id ==tmp_from1.file_id 
          and tmp_from.name2==tmp_from1.name2
          and tmp_from.number>>tmp_from1.number(noindex)
          ))=0 )
        { k:=k+1 ;
          if k>1000 then break ;
           update current tmp_from set tmp_from.name2:=tmp_from.name+string(k) ;
        }  
      }
    } //if getfirst X$Files where ((wfile_id == X$Files.XF$Code ))=0
  }  //if getfirst tmp_from where (( wpa ==tmp_from.pa and
  wfile_name:=tmp_from.name2;
  wfile_id:=tmp_from.file_id;
  InsRecord_To_Form:=true ;
  rescanpanel(#tmp_from) ;
} //

//=========================================
// очистить все
//=========================================

Procedure Sql_clear ;
{ delete tmp_field where (( wpa ==tmp_field.pa )) ;
  delete tmp_from where (( wpa == tmp_from.pa  )) ;
  delete tmp_index where (( wpa == tmp_index.pa )) ;
  delete tmp_noindex where (( wpa == tmp_noindex.pa  )) ;
  delete tmp_order where (( wpa == tmp_order.pa )) ;
  delete tmp_comm where (( wpa == tmp_comm.pa )) ;

}

//=========================
Function GetFileIdByName(w:string):word;
{ GetFileIdByName:=0 ;
  w:=trim(upcase(w));
  if w='' then exit ;
  if getfirst x$files where (( w ==X$Files.XF$Name ))=0
  { GetFileIdByName:=X$Files.XF$Code ;
  }
  wfile_name:=X$Files.XF$Name;
  wfile_id  :=X$Files.XF$Code;

}
//=========================
Function GetFileIdByName2(w:string):word;
{ GetFileIdByName2:=0 ;
  if getfirst tmp_from where ((wpa==tmp_from.pa and w == tmp_from.name2 ))=0
  { GetFileIdByName(tmp_from.name) ;
    GetFileIdByName2:=tmp_from.file_id ;
  }
}
//=========================
Function GetFieldIdByName(wf:string;wi:string):word;
var wfile :word ;
{ GetFieldIdByName:=0 ;
  wf:=upcase(wf) ;   wi:=upcase(wi) ;
  if wi=''
  { if pos('.',wf)=0 then exit ;
    wi:=substr(wf,pos('.',wf)+1,30) ;
    wf:=substr(wf,1,pos('.',wf)-1) ;    
  }
  wfile:=GetFileIdByName2(wf) ;
  if wfile=0 then   wfile:=GetFileIdByName(wf) ;
  if wfile=0 then exit ;
  if getfirst x$fields where ((wfile == X$FIELDS.XE$FILECODE
     and wi == X$FIELDS.XE$Name ))=0
    GetFieldIdByName:=X$FIELDS.XE$CODE ;   
    
}
//=========================
Function GetIndexIdByName(wf:string;wi:string):word;
var wfile :word ;
{ GetIndexIdByName:=65000 ;
  wf:=upcase(wf) ;   wi:=upcase(wi) ;
  if wi=''
  { if pos('.',wf)=0 then exit ;
    wi:=substr(wf,pos('.',wf)+1,30) ;
    wf:=substr(wf,1,pos('.',wf)-1) ;    
  }
  wfile:=GetFileIdByName(wf) ;
  if wfile=0 then exit ;
  if getfirst X$INDEXES where ((wfile == X$INDEXES.XI$FILECODE
     and wi == X$INDEXES.XI$Name ))=0
    GetIndexIdByName:=X$INDEXES.XI$NUMBER ;   
  
}
//===============================
// добавить запись в tmp_index
//==============================
Function Add_index_usl(wfile_l:string;wfield_l:string ;wfile_r:string;wfield_r:string ; var wfilef_l :string ; var wfilef_r :string ):boolean ;
var 
  wfile_id1 ,wfile_id2 : word ;
  wfilenm1 ,wfilenm2 :string ;
{ wfilenm1:='' ; wfilenm2:='' ; wfile_id1:=0 ;wfile_id2 :=0 ;
  wfile_l:=upcase(wfile_l) ;wfile_r:=upcase(wfile_r) ;
  if getlast tmp_index1 where (( wpa==tmp_index1.pa )) ordered by index tmp_index01=0 
   wnum :=tmp_index1.number 
  else 
    wnum :=0 ;
  clearbuffer(#tmp_index);
  wnum:=wnum+1 ;
  tmp_index.pa:=wpa ;
  tmp_index.number:=wnum ;
// слева  
  if wfile_l<>''
  { if getfirst x$files where (( wfile_l ==X$Files.XF$Name ))=0
    { wfile_id1:=X$Files.XF$Code ;
      if wfilef_l=''
      { InsRecord_To_Form(wfile_id1,true);
        wfilef_l:=wfile_name ;
      }
      else
      { wfile_id1:=GetFileIdByName2(wfilef_l) ; 
      }
      
    }  
    tmp_index.file_leftf := wfilef_l ;
    tmp_index.file_left  := wfile_id1;
    tmp_index.field_left   := GetFieldIdByName(wfilef_l,wfield_l);
    tmp_index.val_left:=wfilef_l+'.'+wfield_l ;  

  }
  else 
    tmp_index.val_left:=wfield_l ;  
// справа
  if wfile_r<>''
  { if getfirst x$files where (( wfile_r ==X$Files.XF$Name ))=0
    { wfile_id2:=X$Files.XF$Code ;
      if wfilef_r=''
      { InsRecord_To_Form(wfile_id2,true);
        wfilef_r:=wfile_name ;
      }
      else
      { wfile_id2:=GetFileIdByName2(wfilef_r) ; 
      }
      
    }  
    tmp_index.file_rightf := wfilef_r ;
    tmp_index.file_right  := wfile_id2 ;
    tmp_index.field_right   := GetFieldIdByName(wfilef_r,wfield_r) ;
    tmp_index.val_right:=wfilef_r+'.'+wfield_r ;  

  }
  else 
    tmp_index.val_right:=wfield_r ;  
  insert current tmp_index ;
  Add_index_usl:=true ;
} //Add_index_usl

//========================
// добавить поле 1 имя таблицы,2 - поля
//========================
procedure Add_Field(wf_nm :string ; wfld_name : string ; wfld_prim :string ) ;
{ if getlast tmp_field1 where (( wpa==tmp_field1.pa )) ordered by index tmp_field01=0 
    wnum :=tmp_field1.number 
  else 
    wnum :=0 ;
  clearbuffer(#tmp_field) ; 
  tmp_field.pa:=wpa ; tmp_field.number:=wnum+1 ;
  tmp_field.filef := wf_nm ;
  tmp_field.file_id  := GetFileIdByName2(wf_nm) ;
  tmp_field.field_id   := GetFieldIdByName(wf_nm,wfld_name);
  tmp_field.fieldf:=wf_nm+'.'+wfld_name ;
  tmp_field.strval:=tmp_field.fieldf ;
  tmp_field.prim:=wfld_prim ;
  insert current tmp_field ;
}

//=========================
// добавить комментарий
//=========================
Procedure Add_Comm(wtpSec:string ;w :string) ;
{ case wtpSec of
  'SELECT' : { if isvalid(#tmp_field) update current tmp_field set tmp_field.prim:=w ; }
  'FROM' : { if isvalid(#tmp_from) update current tmp_from set tmp_from.prim:=w ; }
  'WHERE' : { if isvalid(#tmp_noindex) update current tmp_noindex set tmp_noindex.prim:=w ; }
  'WHEREIND' : { if isvalid(#tmp_noindex) update current tmp_index set tmp_index.prim:=w ; }
  else insert into tmp_comm set tmp_comm.pa:=wpa ,tmp_comm.tp:=2,tmp_comm.param:=w ;
  end ;
}

Procedure Ins_Fields(w:string) ;
{ if pos('//',w)>0
  { w:=substr(w,1,pos('//',w)-1) ;
  }
  w:=trim(w);
  wnum:=wnum+1 ;
  
  if substr(w,length(w),1)=',' then w:=substr(w,1,length(w)-1);
  w:=trim(w);
  if w='' then exit ;
  insert into tmp_field
    set tmp_field.pa:=wpa,tmp_field.number:=wnum,tmp_field.strval:=w ;
//set tmp_field.filef := wfile_name
//set tmp_field.file_id  := wfile_id
//set tmp_field.field_id   := wfield_id
      
}
//==============================
Procedure Ins_From(w:string) ;
var w1,w2 :string ;
{ w:=trim(w) ;
  wnum:=wnum+1 ;
  if substr(w,length(w),1)=',' then w:=substr(w,1,length(w)-1);
  w:=trim(w);
  if w='' then exit ;
  w1:='' ; w2:='' ;
  if pos('(',w)>0
  { w2:=substr(w,pos('(',w)+1,30);
    w :=trim(substr(w,1,pos('(',w)-1));
    if pos(')',w2)>0
    { w2:=trim(substr(w2,1,pos(')',w2)-1));
    }
  }  
  if pos(' ',w)>0  
  { w1:=trim(substr(w,1,pos(' ',w)+1));
    w :=trim(substr(w,1,pos(' ',w)-1));
  }
  if w1='' then w1:=w ;
  insert into tmp_from
    set tmp_from.pa:=wpa,tmp_from.number:=wnum
    ,tmp_from.name:=w ,tmp_from.name2:=w1
    ,tmp_from.file_id:=GetFileIdByName(w)
    ,tmp_from.index_id:=GetIndexIdByName(w,w2)
     ;
}
//==============================
Procedure Ins_Where(w:string) ;
var w1,w2 :string ;
    k:word ;
{ w:=trim(w) ;
  wnum:=wnum+1 ;
  if substr(w,length(w),1)=',' then w:=substr(w,1,length(w)-1);
  w:=trim(w);
  if w='' then exit ;
  w1:='' ;
  for(k:=0;k<=10;k:=k+1)
  { w2:=GetVir1(k);
    if w2='' then continue ;
    if pos(w2,w)>0 then
    { w1:=trim(substr(w,1,pos(w2,w)-1)) ; w:=trim(substr(w,pos(w2,w)+length(w2),200)) ;
     insert into tmp_noindex   set
       tmp_noindex.val_left:=w1 
      ,tmp_noindex.number:=wnum
      ,tmp_noindex.pa :=wpa 
      ,tmp_noindex.val_right:=w
      ,tmp_noindex.tp_left :=k      ;
      break ;
      
    }
  } //for(k:=0;k<=10;k:=k+1) 
} //Procedure Ins_Where(w:string) ;
//==============================
Procedure Ins_WhereInd(w:string) ;
var w1,w2 :string ;
    k:word ;
{ w:=trim(w);
  wnum:=wnum+1 ;
  if substr(w,length(w),1)=',' then w:=substr(w,1,length(w)-1);
  w:=trim(w);
  if w='' then exit ;
  w1:='' ;
  for(k:=0;k<=10;k:=k+1)
  { w2:=GetVir(k);
    if w2='' then continue ;
    if pos(w2,w)>0 then
    { w1:=trim(substr(w,1,pos(w2,w)-1)) ; w:=trim(substr(w,pos(w2,w)+length(w2),200));
      if substr(w1,1,4) = 'AND ' then    w1:=substr(w1,5,200);
     insert into tmp_index set
       tmp_index.val_left:=w1 
      ,tmp_index.number:=wnum
      ,tmp_index.pa :=wpa 
      ,tmp_index.val_right:=w
      ,tmp_index.tp_left :=k      ;
      break ;
      
    }
  } //for(k:=0;k<=10;k:=k+1) 
} //Procedure Ins_WhereInd(w:string) ;
Procedure Ins_ORDER(w:string) ;
{ w:=trim(w);
  wnum:=wnum+1 ;
  if substr(w,length(w),1)=',' then w:=substr(w,1,length(w)-1);
  w:=trim(w);
  if w='' then exit ;
  insert into tmp_order set
       tmp_order.pa :=wpa 
      ,tmp_order.fieldf:=w 
      ,tmp_order.number:=wnum ;
  
}
Procedure Ins_Part(tp_sec:string ;wstr3 :string ) ;
{ if trim(tp_sec)='' then exit ;

  case tp_sec of 
  'SELECT' : INS_FIELDS(wstr3) ;
  'FROM'   : INS_FROM(wstr3) ;
  'WHEREIND' : INS_WHEREIND(wstr3) ;
  'WHERE' : INS_WHERE(wstr3) ;
  'ORDER' : INS_ORDER(wstr3) ;
  end ;
}  


//=============================
// проверить запрос после закачки
//=============================
Procedure Chk_SqlZapr ;
{ external _loop tmp_field 
  { tmp_field.field_id:=GetFieldIdByName(tmp_field.strval,'') ;
    if tmp_field.field_id>0
    { tmp_field.file_id:=X$Files.XF$Code;
      tmp_field.filef  := X$Files.XF$Name;
      tmp_field.fieldf:=X$Files.XF$Name+'.'+X$Fields.XE$Name ;
    
    }
    update current tmp_field ;
  } //external _loop tmp_fields 
  external _loop tmp_index
  {
     tmp_index.field_left:=GetFieldIdByName(tmp_index.val_left,'') ;
     if tmp_index.field_left>0
     { tmp_index.file_leftf := wfile_name;
       tmp_index.file_left  := wfile_id;
     }
     tmp_index.field_right:=GetFieldIdByName(tmp_index.val_right,'') ;
     if tmp_index.field_right>0
     { tmp_index.file_rightf := wfile_name; //X$Files.XF$Name
       tmp_index.file_right  := wfile_id; //X$Files.XF$Code
     }  
     update current tmp_index   ;
  } //tmp_index
  external _loop tmp_noindex
  {  
     tmp_noindex.field_left:=GetFieldIdByName(tmp_noindex.val_left,'') ;
     if tmp_noindex.field_left>0
     { tmp_noindex.file_leftf := wfile_name;
       tmp_noindex.file_left  := wfile_id;
     }
     tmp_noindex.field_right:=GetFieldIdByName(tmp_noindex.val_right,'') ;
     if tmp_noindex.field_right>0
     { tmp_noindex.file_rightf := wfile_name; //X$Files.XF$Name
       tmp_noindex.file_right  := wfile_id; //X$Files.XF$Code
     }  
     update current tmp_noindex  ;
  } //tmp_noindex
  external _loop tmp_order
  {
     tmp_order.field_id:=GetFieldIdByName(tmp_order.fieldf,'') ;
     if tmp_order.field_id>0
     { tmp_order.filef := wfile_name; //X$Files.XF$Name
       tmp_order.file_id  := wfile_id; //X$Files.XF$Code
     }  
     update current tmp_order    ;
  } //tmp_noindex
  ReScanAll ; // обновим все панели
} //Procedure Chk_SqlZapr ;

//========================
// загрузить файл
//========================
Function ReadSqlZapr(wwfile_in:string) :boolean ;
var wstr,wstr1,wstr2,wstr3 :string ;
    tp_sec :string='' ;  
    i,k: word ;
    com_beg:boolean ; // признак что начался комментарий /*
{ ReadSqlZapr:=false ;
  if wwfile_in<>''
    wfile_sql:=wwfile_in ;
  else  
    wfile_sql:=GetFileName('*.lot','Выбирите lot файл с одним запросом') ;
  if wfile_sql=''
  { message('Файл не выбран!!');
    exit ; 
  }
  if not fileExist(wfile_sql)
  { message('Нет файла '+wfile_sql);
    exit ;
  }
  k:=0 ;
  if not f.OpenFile(wfile_sql, stOpenRead)
  { message('ошибка создания файла '+wfile_sql );
    exit ;
  };
  StartNewVisual( vtNumericVisual, vfTimer+vfBreak,
  ''#3'Идет запись в  '+wfile_sql, 1);
  Sql_clear ;
  f.Seek(0);
  wstr:='' ; wstr1:='' ;
  com_beg:=false ;
  while not f.eof
  { if not nextvisual then
    { message('Процесс прерван') ;
      break ;
    }
    f.readln(wstr) ;
    wstr1:=wstr1+' '+wstr ;
    if com_beg
    { if pos('*/',wstr1)>0
      { ADD_COMM(tp_sec,substr(wstr1,pos('*/',wstr1)-1,200)) ;
        com_beg:=false ;
        wstr1:=substr(wstr1,pos('*/',wstr1)+1,200);
        
      }
      else
      { ADD_COMM(tp_sec,wstr1) ;
        continue ;
      }
    }
    wstr2:=upcase(wstr1) ;
    wstr3:='' ;
    for(i:=1;i<=length(wstr2);i:=i+1)
    { wstr3:=wstr3+substr(wstr2,i,1);
      if pos(' SELECT ',wstr3)>0 then 
      { Ins_Part(tp_sec,substr(wstr3,1,pos(' SELECT ',wstr3)-1) ) ; 
        tp_sec:='SELECT'; wstr3:=' ' ;  wnum:=0 ; 
      }
      if pos(' FROM ',wstr3)>0 then 
      { Ins_Part(tp_sec,substr(wstr3,1,pos(' FROM ',wstr3)-1) ) ; 
        tp_sec:='FROM' ;wstr3:=' ' ;wnum:=0 ; }
      if pos(' WHERE ',wstr3)>0 then 
      { Ins_Part(tp_sec,substr(wstr3,1,pos(' WHERE ',wstr3)-1) ) ; 
        tp_sec:='WHERE' ;wstr3:=' ' ;wnum:=0 ; }
      if pos(' ORDER ',wstr3)>0 then 
      { Ins_Part(tp_sec,substr(wstr3,1,pos(' ORDER ',wstr3)-1) ) ; 
        tp_sec:='ORDER' ;wstr3:=' ' ;wnum:=0 ;}
      if pos('//',wstr3)>0 then 
      { Ins_Part(tp_sec,substr(wstr3,1,pos('//',wstr3)-1) ) ; 
        ADD_COMM(tp_sec,substr(wstr1,i+1,200)) ;
        wstr3:='' ;
        break ;
      }
      if pos('/*',wstr3)>0
      { com_beg:=true ;
        Ins_Part(tp_sec,substr(wstr3,1,pos('/*',wstr3)-1) ) ; 
        ADD_COMM(tp_sec,substr(wstr1,i+1,200)) ;
        wstr3:='' ;
        break ;
      }
      if tp_sec='WHERE' and pos('((',wstr3)>0
      { tp_sec:='WHEREIND' ; wstr3:='' ;wnum:=0 ;
      }
      if tp_sec='WHEREIND' and pos('))',wstr3)>0
      { tp_sec:='WHERE' ; wstr3:=' ' ;wnum:=0 ;
      }
      if wstr3='' or wstr3=' ' then continue ;
      if substr(wstr2,i,1)=','
      { Ins_Part(tp_sec,wstr3 ); 
        wstr3:=' '
      }  //if pos(',')>0
    } //for(i:=1;i<=length(wstr2);i:=i+1)   
    wstr1:=wstr3 ;
  } //while not f.eof
  Stopvisual('',0) ;  
  f.Close ;
  Chk_SqlZapr ;
  ReadSqlZapr:=true ;
}


//========================
// сохранить файл
//========================
Function SaveSqlZapr(wwfile_in:string) :boolean ;
var wkl_first :boolean ;
    wdop_str :string ;
{ SaveSqlZapr :=false ;
  if wwfile_in<>''
    wfile_sql:=wwfile_in ;
  else  
    wfile_sql:=GetFileName('*.lot','Выберите имя нового файла') ;
  if wfile_sql='' then exit ;
  if pos('.',wfile_sql)=0 wfile_sql:=wfile_sql+'.lot';
  if fileExist(wfile_sql)
  { if message('файл '+wfile_sql+' уже существует. Переписать?',YesNo)<>cmYes
    { exit ;
    }
    deletefile(wfile_sql) ;
  }
  if not f.OpenFile(wfile_sql, stCreate)
  { message('ошибка создания файла '+wfile_sql );
    exit ;
  };
  StartNewVisual( vtNumericVisual, vfTimer+vfBreak,
  ''#3'Идет запись в  '+wfile_sql, 1);
  f.writeln('select') ;
  wkl_first:=true ;
//== Fields
  if getfirst tmp_field=0
  { _loop tmp_field
    { if wkl_first
      { wdop_str:='   ';
        wkl_first:=false ; 
      } else wdop_str:='  ,';
      wdop_str:=wdop_str+tmp_field.strval;
      if tmp_field.name<>'' or tmp_field.len>0
      { wdop_str:=wdop_str+' (';
        if tmp_field.name<>''
        {  wdop_str:=wdop_str+'fieldname='+tmp_field.name;
        }
        if tmp_field.len>0
        {  wdop_str:=wdop_str+if(tmp_field.name<>'',',','')+' length='+string(tmp_field.len);
        }
        wdop_str:=wdop_str+' )'  ;
      } //if tmp_field.name<>'' or tmp_field.len>0
      if tmp_field.prim<>''
      { wdop_str:=wdop_str+' //'+tmp_field.prim;
      } //if tmp_field.prim<>''
      else
       if trim(tmp_field.fieldf)=trim(tmp_field.strval)
         wdop_str:=wdop_str+' // "'+x$files_field.XF$TITLE+'"."'+X$FIELDS_field.XE$TITLE+'"' ;
      f.writeln(wdop_str) ;
    } //_loop tmp_field
  }  //if getfirst tmp_field=0
  else
    f.writeln('*'); 
//=== FROM    
  if (getfirst tmp_from=0)
  { f.writeln('FROM');
    wkl_first:=true ;
    _loop tmp_from
    { if wkl_first
      { wdop_str:='   ';
        wkl_first:=false ; 
      } else wdop_str:='  ,';
      wdop_str:=wdop_str+tmp_from.name;
      if tmp_from.name<>tmp_from.name2
      { wdop_str:=wdop_str+' '+tmp_from.name2;
      }//if tmp_from.name<>tmp_from.name2
      if isvalid(tnX$INDEXES_from)
      { wdop_str:=wdop_str+'('+X$INDEXES_from.XI$NAME+')';
      } //if isvalid(tnX$INDEXES_from)
      if tmp_from.prim<>''
        wdop_str:=wdop_str+' // '+tmp_from.prim ;
      wdop_str:=wdop_str+' // '+x$files_from.XF$TITLE ;
      f.writeln(wdop_str); 
    } //_loop tmp_from
  } // if getfirst tmp_from
//== WHERE (( ))
  if (getfirst tmp_index=0)  or (getfirst tmp_noindex=0)
  { f.writeln('where'); 
  } 
  if (getfirst tmp_index=0)
  { f.writeln('(('); 
    wkl_first:=true ;
    _loop tmp_index
    { if wkl_first
      { wdop_str:='     ';
        wkl_first:=false ; 
      } else wdop_str:='  and ';
      wdop_str:=wdop_str+pad(tmp_index.val_left,20)+' '+GetVir(tmp_index.tp_left)+' '+tmp_index.val_right
          +if(tmp_index.attrib=1,' (noindex)', if(tmp_index.attrib=2,' '+chr(40)+'length='+string(tmp_index.len)+chr(40), 
            if(tmp_index.attrib=3,' '+chr(40)+'noindex,length='+string(tmp_index.len)+')',''))) //)
          +' // '
          + if(isvalid(tnX$FIELDS_indleft),X$FIELDS_indleft.XE$TITLE+' == ','')
          + if(isvalid(tnX$FIELDS_indright),X$FIELDS_indright.XE$TITLE,'')
          ;
      f.writeln(wdop_str) ;
    } //_loop tmp_index
    if (getfirst tmp_noindex=0) 
      f.writeln('))'+' and ') 
    else  
      f.writeln('))') ;
  } //if (getfirst tmp_index=0)
//== WHERE  noindex
  wdop_str:=' ' ;
  if (getfirst tmp_noindex=0)
  { wkl_first:=true ;
    _loop tmp_noindex
    { if wkl_first
      { wdop_str:='     ';
        wkl_first:=false ; 
      } 
      wdop_str:=wdop_str+trim(tmp_noindex.Vir_left)
          +pad(tmp_noindex.val_left,20)
          +GetVir1(tmp_noindex.tp_left)+trim(tmp_noindex.val_right)
          + trim(tmp_noindex.Vir_right) 
          + ' // '
//          + if(isvalid(tnX$FIELDS_noindleft),X$FIELDS_noindleft.XE$TITLE+'=>','')
//          + if(isvalid(tnX$FIELDS_indright),X$FIELDS_noindright.XE$TITLE,'')
          
          ;
      //wdop_str:='DDD'
      f.writeln(wdop_str); 
     
      case tmp_noindex.cond_scep of 
      0 : wdop_str:='  and ' ;
      1 : wdop_str:='  or ' ;
      2 : wdop_str:='  xor ' ;
      else wdop_str:=' ' ;
      end ;
    } //_loop tmp_index
  }  //if (getfirst tmp_noindex=0)
// order    
  wdop_str:=' ' ;
  if (getfirst tmp_order=0)
  { wkl_first:=true ;
    f.writeln('order by') ;
  
    _loop tmp_order
    { if wkl_first
      { wdop_str:='   ' ;
        wkl_first:=false ; 
      } else wdop_str:='  ,';
      wdop_str:=wdop_str+tmp_order.fieldf+'// '+X$FIELDS_order.XE$TITLE ;
      f.writeln(wdop_str)  ;
    }  //_loop tmp_order
  } //if (getfirst tmp_order=0)
  if (getfirst tmp_comm=0)
  { wkl_first:=true ;
    wdop_str:='';
    _loop tmp_comm
    { if tmp_comm.tp=0 
      { if wdop_str<>'' 
        { message('В dbf только одна строка!!!');
        }
        else
        { wdop_str:=' to dbf '+tmp_comm.param ;
          f.writeln(wdop_str); 
        }
      }   
      if tmp_comm.tp=2
      { f.writeln(tmp_comm.param) ;
      } 
    }  //_loop tmp_comm
  } //if (getfirst tmp_comm=0)


  f.writeln(';'); 
  Stopvisual('',0) ;  
  f.Close ;
  message('Файл сохранен в '+wfile_sql) ; 
  //+vfRunModal
  ProcessText(wfile_sql,vfNewTitle+vfEscable+vfMacroSize,'Запрос '+wfile_sql);
  
  SaveSqlZapr :=true ;
}
//=============================== 
// выбрать таблицу из секции from
//=============================== 
Function GetTbl_Code(var wtbl : string  ) : word ;
{ kl_vib:=false ;
  pushpos(#tmp_from) ;
  GetTbl_code:=0 ;
  if getfirst tmp_from where (( wpa == tmp_from.pa and wtbl == tmp_from.name2 )) <>0
     if getfirst tmp_from where (( wpa == tmp_from.pa ))<>0 
  { message('Нет выбранных таблиц в секции From!!!') ;
    poppos(#tmp_from) ;
    exit ; 
  }
  runwindowmodal(wnVibFrom) ;
  if kl_vib
  { wtbl:=tmp_from.name2;
    if getfirst tmp_from1 where (( wpa == tmp_from1.pa and wtbl == tmp_from1.name2 ))=0 {} ;
    wfile_name:=tmp_from1.name2;
    wfile_id:=tmp_from1.file_id;
    GetTbl_code:=wfile_id ;
    wtbl:=wfile_name ;
  }
}  //Function GetTbl_Code( wtbl : string  ) : word ;

Function GetTblFrom( wtbl : string ; wwfield :word ) : boolean ;
var wcommand:longint ;
    i,wfieldid:word ;
{ kl_vib:=false ;
  GetTblFrom:=false ;
  wcommand:=runmenu('mnGenSqlZaprField');
  case wcommand of
  cmValue1 ://'Из таблицы в From';
  { pushpos(#tmp_from) ;
    if getfirst tmp_from where (( wpa == tmp_from.pa and wtbl == tmp_from.name2 )) <>0
      if getfirst tmp_from where (( wpa == tmp_from.pa ))<>0 
    { message('Нет выбранных таблиц в секции From!!!') ;

      poppos(#tmp_from) ;
      exit ; 
    }
    runwindowmodal(wnVibFrom) ;
    if kl_vib
    { wtbl:=tmp_from.name2;
      GetTblFrom:=getfirst tmp_from1 where (( wpa == tmp_from1.pa and wtbl == tmp_from1.name2 ))=0 ;
      wfile_name:=tmp_from1.name2;
      wfile_id:=tmp_from1.file_id;
      wfield_id:=wwfield ;
      wfield_name:='' ;
//      if runinterface('PICKFIELD',tmp_from1.file_id,wfield_id)=0
      case curtable of
      #tmp_field:
      { if runinterface('MYGETFIELD',tmp_from1.file_id,1,wfield_id)=0
        { 
        }
        Markers := InitMarker('MYGETFIELD', 8, 100, 100);
        pushpos(#tmp_field);
        for(i:=0;i<GetMarkerCount(Markers);i:=i+1)
        { GetMarker(Markers, i, wfieldid);
          if getfirst X$fields where (( wfile_id == X$FIELDS.XE$FILECODE and wfieldid == X$FIELDS.XE$CODE ))=0
          { if i=0 then { wfield_name:=X$FIELDS.xe$name ;wfield_id:=wfieldid ; }
            if i>0
            { Add_field(wfile_name,X$FIELDS.xe$name,'')  ;
            }
          }  
        } //for(i:=0;i<GetMarkerCount(Markers);i:=i+1)
        poppos(#tmp_field);
        Donemarker(Markers, 'MYGETFILEID');
      }  
      else
      { if runinterface('MYGETFIELD',tmp_from1.file_id,0,wfield_id)=0 {}
        if getfirst X$fields where (( wfile_id == X$FIELDS.XE$FILECODE and wfield_id == X$FIELDS.XE$CODE ))=0
        { wfield_name:=X$FIELDS.xe$name ;
        }    
        
      }
      end ;
    } //if kl_vib
    poppos(#tmp_from) ;
  } //cmValue1 :
  cmValue2: //'Из поля в Fields'
  { pushpos(#tmp_field) ;
    runwindowmodal(wnVibField) ;
    if kl_vib
    { wfile_id:=0 ; wfile_name:='' ; wfield_id:=0 ;
      if tmp_field.fieldf=tmp_field.strval
      { wfile_id:=tmp_field.file_id ;
        wfile_name:=tmp_field.filef ;
        wfield_name:=substr(tmp_field.fieldf,pos('.',tmp_field.fieldf)+1,100) ;
      }
      else
      { wfield_name:=tmp_field.strval ;
      }
      GetTblFrom:=True ;
    } //if kl_vib
  
    poppos(#tmp_field) ;
  }
  cmValue3: //'Из произвольной таблицы'
  { if runinterface(MyGetFileID,wfile_id,0)=cmDefault
    { message('Код таблицы '+string(wfile_id));
      InsRecord_To_Form(wfile_id,false) ;
      wfield_id:=wwfield ;
      wfield_name:='' ;
//      if runinterface('PICKFIELD',tmp_from1.file_id,wfield_id)=0      {       }
      if runinterface('MYGETFIELD',tmp_from1.file_id,0,wfield_id)=0 {}
      if getfirst X$fields where (( wfile_id == X$FIELDS.XE$FILECODE and wfield_id == X$FIELDS.XE$CODE ))=0
      { wfield_name:=X$FIELDS.xe$name ;
      }    
      GetTblFrom:=True ;
    } //if runinterface(MyGetFileID,wfile_id)=cmDefault
  } //cmValue3: //'Из произвольной таблицы'
  cmValue4: //'Из таблицы ссылочной целостности'
  { case curtable of
    #tmp_index,#tmp_noindex:
    { wfield_id:=0 ;
      case curfield of
      #tmp_index.file_leftf,#tmp_index.val_left :
      { if RunInterface('FieldVibByRelate',wfile_id,wfield_id,tmp_index.file_right,tmp_index.field_right)<>cmDefault then exit ;
      }
      #tmp_index.file_rightf,#tmp_index.val_right :
      { if RunInterface('FieldVibByRelate',wfile_id,wfield_id,tmp_index.file_left,tmp_index.field_left)<>cmDefault then exit ;        
      }
      #tmp_noindex.file_leftf,#tmp_noindex.val_left :
      { if RunInterface('FieldVibByRelate',wfile_id,wfield_id,tmp_noindex.file_right,tmp_noindex.field_right)<>cmDefault then exit ;
      }
      #tmp_noindex.file_rightf,#tmp_noindex.val_right :
      { if RunInterface('FieldVibByRelate',wfile_id,wfield_id,tmp_noindex.file_left,tmp_noindex.field_left)<>cmDefault then exit ;        
      }
      end ;
      if wfile_id>0
      { case curfield of 
        #tmp_index.file_rightf,#tmp_index.val_right,#tmp_noindex.file_rightf,#tmp_noindex.val_right :
          InsRecord_To_Form(wfile_id,true) // для полей справа будем добавлять синоним
        else 
          InsRecord_To_Form(wfile_id,false)
        end ;  
      }
      if wfield_id>0
      { if getfirst X$fields where (( wfile_id == X$FIELDS.XE$FILECODE and wfield_id == X$FIELDS.XE$CODE ))=0
        { wfield_name:=X$FIELDS.xe$name ;
        }    
        GetTblFrom:=True ;
      }  
    } //#tmp_index,#tmp_noindex:
    else
    { message('Для этой секции это не доступно')
    }
    end;
  }
  cmValue5: //'Подобрать по индексу'
  { case curtable of
    #tmp_index:
    { pushpos(#tmp_from) ;
      if getfirst tmp_from where (( wpa == tmp_from.pa and wtbl == tmp_from.name2 )) <>0
        if getfirst tmp_from where (( wpa == tmp_from.pa ))<>0 
      { message('Нет выбранных таблиц в секции From!!!') ;

        poppos(#tmp_from) ;
        exit ; 
      }
      runwindowmodal(wnVibFrom) ;
      if kl_vib // дальше нужно прописывать
      {    
        wfile_name:=tmp_from.name2;
        wfile_id:=tmp_from.file_id;
        wfield_id:=wwfield ;
        wmyIndexFlt.kol_field:=0 ;
        poppos(#tmp_from) ;
        _loop tmp_index1 where (( wpa == tmp_index1.pa
         and wfile_name==tmp_index1.file_rightf
         )) ordered by index tmp_index05 
        { wmyIndexFlt.kol_field:=wmyIndexFlt.kol_field+1 ;
          if wmyIndexFlt.kol_field>20
          { message('Число элементов по индексу превышает 20!!');
            exit ;
          }
          wmyIndexFlt.field_id[wmyIndexFlt.kol_field]:= tmp_index1.field_right ;
        }  
        wwfield:=0 ;
        if RunInterface(MyGetIndex,wfile_id,wwfield,wmyIndexFlt)=cmDefault
        { if getfirst X$INDEXES where ((
             wfile_id == X$INDEXES.XI$FILECODE
            and wwfield == X$INDEXES.XI$NUMBER
            and wmyIndexFlt.kol_field==X$INDEXES.XI$PART ))=0
          { wfield_id:= X$INDEXES.XI$FIELDCODE ;
            if getfirst X$fields where (( wfile_id == X$FIELDS.XE$FILECODE 
                                    and wfield_id == X$FIELDS.XE$CODE ))=0
            { wfield_name:=X$FIELDS.xe$name ;
            }    
            GetTblFrom:=True ;
          } 
          else message('Части индекса исчерпаны!!') 
        } //if RunInterface(MyGetIndex,wfile_id,wwfield,wmyIndexFlt)=cmDefault
      } //if kl_vib // дальше нужно прописывать
    }  //#tmp_index:
    else
    { message('Для этой секции это не доступно');
    }
    end;
  } //cmValue5: //'Подобрать по индексу'
  end ;  

} //GetTblFrom


//================
panel pnbut show at (,,13,) ;
screen scrbut 'Кнопки' ;
table x$files ;
fields 
  wpa : [list 0 'Вариант 0','Вариант 1','Вариант 2','Вариант 3','Вариант 4'
    ,'Вариант 5','Вариант 6','Вариант 7','Вариант 8','Вариант 9','Вариант 10'],protect ;
  my_curtablename :  ,protect ; 
buttons
  cmValue2,,,'сохранить',hcconsocnal,sci1Esc;
  cmValue1 ,,,'Загрузить';

  cmMyUp ,,,'Вверх'; 
  cmMyDone ,,,'Вниз'; 
<< 
<.Сохранить.> 

<.Загрузить.>

Вариант
.@@@@@@@@@@@

<.Вверх.>

<.Вниз .>

Текущая таблица
.@@@@@@@@@@@@

`Fields``From`
`Index` `Noindex`
`Order` `Comm`

Copyright
2007 by 
Kirillov E.

>>
end ; //scrbut
end ;

