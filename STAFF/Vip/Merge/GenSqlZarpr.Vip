panel pntmp_order ;
table tmp_order ;
HandleEvent
cmSetDefault : {
 if getlast tmp_order1 where (( wpa==tmp_order1.pa )) ordered by index tmp_order01=0 
  wnum :=tmp_order1.number 
 else 
  wnum :=0 ;
 clearbuffer(#tmp_order) ; tmp_order.pa:=wpa ;
 set tmp_order.number:=wnum+1 ;
}
cmPick :
{ UpdateTable ;
  MakeValid(#tmp_order) ;

  case curfield of
  #tmp_order.filef,#tmp_order.fieldf :
  { if GetTblFrom(tmp_order.filef, tmp_order.field_id)
    { set tmp_order.filef := wfile_name;
      set tmp_order.file_id  := wfile_id;
      set tmp_order.field_id   := wfield_id;
      set tmp_order.fieldf:=wfile_name+'.'+wfield_name ;
    }
  
  } //
  end;
}
cmInsertRecord : insert current tmp_order ;
cmDeleteRecord : delete current tmp_order ;
cmUpdateRecord : update current tmp_order ;
end;
end; //pntmp_order

panel pntmp_index ;
