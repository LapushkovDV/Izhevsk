panel pntmp_from ;
table tmp_from ;
HandleEvent
cmInsert:
{ if recordsintable(#tmp_from1)>0 and message('Сделать синоним?',YesNo)=cmYes
  { InsRecord_To_Form(tmp_from.file_id,true);
    setnew(false) ;
    abort ;
  }
}
cmSetDefault : {
   if getlast tmp_from1 where (( wpa==tmp_from1.pa )) ordered by index tmp_from02=0 
    wnum :=tmp_from1.number 
   else 
    wnum :=0 ;
   clearbuffer(#tmp_from) ;
   set tmp_from.pa:=wpa ;
   set tmp_from.number:=wnum+1 ;
   set tmp_from.index_id:=65000 ;//0
   putcommand(cmPick) ;
} //cmSetDefault :
cmPick :
{ UpdateTable ;
  MakeValid(#tmp_from) ;
  case curfield of
  #tmp_from.name :
  { if runinterface(MyGetFileID,wfile_id,0)=cmDefault
    { message('Код таблицы '+string(wfile_id));
      if getfirst X$Files where ((wfile_id == X$Files.XF$Code ))=0
      { //message('!!!')
        tmp_from.file_id:=wfile_id ;
        tmp_from.name :=X$Files.XF$Name;
        tmp_from.name2 :=X$Files.XF$Name ;
      }
    } 
  }
  #X$INDEXES_from.XI$NAME:
  { wfield_id :=tmp_from.index_id ;
    wmyIndexFlt.kol_field:=0 ;
    if RunInterface(MyGetIndex,tmp_from.file_id,wfield_id,wmyIndexFlt)=cmDefault
    { tmp_from.index_id:=wfield_id ;
    }
  }
  end ;  
  update current tmp_from ;
  rescanpanel(#tmp_from) ;
}//cmPick :
cmInsertRecord : insert current tmp_from ;
cmDeleteRecord : delete current tmp_from ;
cmUpdateRecord : update current tmp_from ;
end;
end; //pntmp_index

panel pntmp_field ;
table tmp_field ;
HandleEvent
cmSetDefault : {
 if getlast tmp_field1 where (( wpa==tmp_field1.pa )) ordered by index tmp_field01=0 
  wnum :=tmp_field1.number 
 else 
  wnum :=0 ;

 clearbuffer(#tmp_field) ; tmp_field.pa:=wpa ;
 set tmp_field.number:=wnum+1 ;

}
cmPick :
{ UpdateTable ;
  MakeValid(#tmp_field) ;

  case curfield of
  #TMP_FIELD.STRVAL, #tmp_field.filef,#tmp_field.fieldf :
  { if GetTblFrom(tmp_field.filef, tmp_field.field_id)
    { set tmp_field.filef := wfile_name ;
      set tmp_field.file_id  := wfile_id ;
      set tmp_field.field_id   := wfield_id;
      set tmp_field.fieldf:=wfile_name+'.'+wfield_name ;
      if trim(tmp_field.strval)='' 
        set tmp_field.strval:=wfile_name+'.'+wfield_name ;
      else
      if message('Заменить выражение',OkCancel)=cmOk 
        set tmp_field.strval:=wfile_name+'.'+wfield_name ;
      else
        set tmp_field.strval:=tmp_field.strval+'+'+wfile_name+'.'+wfield_name ;
    }
  
  } //
  end;
  rescanpanel(#tmp_field) ;
}
cmInsertRecord : insert current tmp_field ;
cmDeleteRecord : delete current tmp_field ;
cmUpdateRecord : update current tmp_field ;
end;
end; //pntmp_field

panel pntmp_comm ;
table tmp_comm ;
HandleEvent
cmSetDefault : {
 if getlast tmp_comm1 where (( wpa==tmp_comm1.pa )) ordered by index tmp_comm01=0 
  wnum :=tmp_comm1.number 
 else 
  wnum :=0 ;

 clearbuffer(#tmp_comm) ; tmp_comm.pa:=wpa ;
 tmp_comm.number:=wnum+1 ;

}
cmInsertRecord : insert current tmp_comm ;
cmDeleteRecord : delete current tmp_comm ;
cmUpdateRecord : update current tmp_comm ;
end;
end; //pntmp_field




HandleEvent
cmIdle:
{ my_curtable:=curtable ; // curtable ;
  MySetInfo ;
}
//cmCheckField :
//{ my_curtable:=curtable ; // curtable ;
//  MySetInfo ;
//}
cmSetCurTable:
{ my_curtable:=target ; // curtable ;
  MySetInfo ;
}
cmMyUp:{
  UpdateTable ;
  ReScanAll ;  
}
cmMyDone:{
  UpdateTable ;
  ReScanAll ;  
}
cminit : 
{ if wfile_in<>''
  { if ReadSqlZapr(wfile_in)
      SetTitle('Редактируем запрос '+wfile_in) ;
  }
}
cmValue1 :
{ ReadSqlZapr('') ;
}
cmValue2 :
{ SaveSqlZapr('') ;
  wfile_in:='' ;
}
cmDone: {
 if wfile_in<>''
 {  SaveSqlZapr(wfile_in) ;
 }
}
cmHotkeys :
{ var wcom :longint ;
  wcom:= RunMenu('mnGenSqlZapr') ;
  case wcom of
  cmValue1 : PutCommand(wcom) ;
  cmValue2 : PutCommand(wcom) ;
  cmValue3 : PutCommand(wcom) ;
  cmValue4 : PutCommand(wcom) ;
  cmValue5 : PutCommand(wcom) ;
  cmValue6 : PutCommand(wcom) ;
  cmValue7 : PutCommand(wcom) ;
  cmValue8 : PutCommand(wcom) ;
  cmValue9 : PutCommand(wcom) ;
  cmValue10: PutCommand(wcom) ;
  cmValue11: PutCommand(wcom) ;
  cmValue12: PutCommand(wcom) ;
  cmValue13: PutCommand(wcom) ;
  cmValue14: PutCommand(wcom) ;
  cmValue15: PutCommand(wcom) ;
  cmValue16: PutCommand(wcom) ;
  cmValue17: PutCommand(wcom) ;
  cmValue18: PutCommand(wcom) ;
  cmValue19: PutCommand(wcom) ;
  cmValue20: PutCommand(wcom) ;
  end ;
  ReScanAll ;  
}
cmValue11:// 'Внешние атрибуты'
{ 
/*
 and word(coSpSopr) ==  AttrNam.wTable
 and wnmattr        ==  AttrNam.name
 and word(coSpSopr) ==  AttrVal.wTable
 and SpSopr.nrec     ==  AttrVal.cRec
 and AttrNam.NRec   ==  AttrVal.cAttrNam 

*/
  var wf0, wf1,wf2,wf3,wf4 :string ; 
  var wf_id : word ;
  wf0:='' ;wf1:='' ; wf2:='' ;wf3:='' ; wf4:='' ;
  wf_id:=GetTbl_Code(wf4) ;
  
// Add_index_usl(wfile_l:string;wfield_l:string ;wfile_r:string;wfield_r:string ; var wfilef_l :string ; var wfilef_r :string ):boolean ;
  Add_index_usl('' , 'word'+'(co'+tmp_from.name+ ')' , 'ATTRNAM','WTABLE', wf0 , wf1 );
  Add_index_usl('',chr(39)+' '+chr(39) , 'ATTRNAM','NAME', wf0 , wf1 );
  Add_index_usl('ATTRNAM', 'WTABLE' , 'ATTRVAL','WTABLE', wf1 , wf2 ) ;
  Add_index_usl(wf4, 'NREC' , 'ATTRVAL','CREC', wf4 , wf2 );
  Add_index_usl('ATTRNAM', 'NREC' , 'ATTRVAL','CATTRNAM', wf1 , wf2 );
  Add_field(wf2,'VSTRING', '') ;;
  ReScanAll ;

        
}//cmValue11:// 'Внешние атрибуты'
cmValue12://'Внешний классификатор'
{
/*
,exclassseg.name
from katos(KATOS13)
where ((
    15 == katos.tidk and 1 == katos.isleaf
and 3000 == EXCLASSNAME.wtable
and 'e?n л?' ==EXCLASSNAME.name
and EXCLASSNAME.classcode == exclassval.classcode
and 3000 == exclassval.wtable
and katos.nrec ==exclassval.crec
and exclassval.cclassseg == exclassseg.nrec 
*/
  var wf0, wf1,wf2,wf3,wf4 :string ; 
  var wf_id : word ;
  wf0:='' ;wf1:='' ; wf2:='' ;wf3:='' ; wf4:='' ;
  wf_id:=GetTbl_Code(wf4) ;
  
// Add_index_usl(wfile_l:string;wfield_l:string ;wfile_r:string;wfield_r:string ; var wfilef_l :string ; var wfilef_r :string ):boolean ;;
  Add_index_usl('' , 'word'+'(co'+tmp_from.name+ ')' , 'EXCLASSNAME','WTABLE', wf0 , wf1 );
  Add_index_usl('',chr(39)+' '+chr(39) , 'EXCLASSNAME','NAME', wf0 , wf1 );
  Add_index_usl('EXCLASSNAME', 'CLASSCODE' , 'EXCLASSVAL','CLASSCODE', wf1 , wf2 );
  Add_index_usl('EXCLASSNAME', 'WTABLE' , 'EXCLASSVAL','WTABLE', wf1 , wf2 );
  wf0:=wf4 ;
  Add_index_usl(wf4, 'NREC' , 'EXCLASSVAL','WTABLE', wf0 , wf2 );
  Add_index_usl('EXCLASSVAL', 'CCLASSSEG' , 'EXCLASSSEG','NREC', wf2 , wf3 );
  Add_field(wf3,'NAME','') ;
  ReScanAll ;
}//cmValue12://'Внешний классификатор'
// = 'Кадры'
cmValue10:// 'Структурные единицы->Подразделения';
{
/*
   epStaffDepartment 
                          11== ExtCatLinks.ObjType and
//                          moStaff  
                          1         == ExtCatLinks.ModType and
                          cTmp              == ExtCatLinks.StaffCat
                                            )) = tsOk)
      cDepNrec := vpers.ExtCatLinks.ExtCat;
*/
  var wf0, wf1,wf2 :string ; 
  wf0:='' ;wf1:='' ; wf2:='' ;
  Add_index_usl('' , '11' , 'EXTCATLINKS','OBJTYPE', wf0 , wf1 );
  Add_index_usl('' , '1' , 'EXTCATLINKS','MODTYPE', wf0 , wf1 ) ;
  Add_index_usl('' , '??????????' , 'EXTCATLINKS','STAFFCAT', wf0 , wf1 );
  Add_index_usl('EXTCATLINKS' , 'EXTCAT' , 'KATPODR','NREC', wf1 ,wf2 ) ;
  Add_field(wf2,'NAME','') ;
  
  ReScanAll ;
}//cmValue10:// 'Структурные единицы->Подразделения';
cmValue13:// 'Кадры-Картотека';
{
  var wf0, wf1,wf2,wf3,wf4 :string ; 
  wf0:='' ;wf1:='' ; wf2:='' ;wf3:='' ; wf4:='' ;
  Add_index_usl('' , chr(39)+'С'+chr(39) , 'PERSONS','ISEMPLOYEE', wf0 , wf1 );
  Add_field(wf1,'TABNMB','Табельный') ;
  Add_field(wf1,'FIO','') ;
  Add_field(wf1,'BORNDATE','') ;
  Add_field(wf1,'SEX','') ;
  Add_field(wf1,'APPDATE','') ;
  Add_field(wf1,'DISDATE','') ;
  Add_field(wf1,'CSOVM','') ;
  Add_index_usl('PERSONS' , 'GALDEP' , 'KATPODR','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','подразделение katpodr') ; wf2:='' ;
  Add_index_usl('PERSONS' , 'DEPARTMENT' , 'CATALOGS','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','структурные единицы штатного расписания') ; wf2:='' ;
  // категория плат
  Add_index_usl('PERSONS' , 'CADDNREC2' , 'CATALOGS','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','категория плат') ; wf2:='' ;
  update current tmp_field set tmp_field.prim:='категория плат';
  // группа инвалидности
  Add_index_usl('PERSONS' , 'INVALIDGRP' , 'CATALOGS','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','группа инвалидности') ; wf2:='' ;
  // характер работы
  Add_index_usl('PERSONS' , 'JOBNATURE' , 'CATALOGS','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','характер работы') ; wf2:='' ;
  //  национальность 
  Add_index_usl('PERSONS' , 'NATIONALITY' , 'CATALOGS','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','национальность') ; wf2:='' ;
  //  семейное положение 
  Add_index_usl('PERSONS' , 'FAMILYSTATE' , 'CATALOGS','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','семейное положение') ; wf2:='' ;
  //  образование
  Add_index_usl('PERSONS' , 'EDUCATION' , 'CATALOGS','NREC', wf1 , wf2 );
  Add_field(wf2,'NAME','образование') ; wf2:='' ;
  
  
  ReScanAll ;
}//cmValue13:// 'Кадры-Картотека';
cmValue14:// 'Кадры-Штатное';
{
  var wf0, wf1,wf2,wf3,wf4 :string ; 
  wf0:='' ;wf1:='' ; wf2:='' ;wf3:='' ; wf4:='' ;
  ReScanAll ;
}//cmValue14:// 'Кадры-Штатное';
cmValue15:// 'Кадры-Адресса';
{
