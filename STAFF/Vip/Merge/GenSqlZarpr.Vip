//===========
Interface MyGetIndex 'Выберите индекс' cyan, DoAccept ;
Function ChkIndFlt: boolean ; forward ;
var wmyIndexFlt: myIndexFlt ;
create view vMyGetIndex
var 
 wfile_id :word  ;
 windex_id :word ;
 Markers,IndexMark :longint ;
 wkl :boolean ;
as select 
X$INDEXES.XI$NUMBER,
if(SearchMarker(Markers,X$INDEXES.XI$NUMBER,IndexMark),'V','') (fieldname=picked) 
from X$INDEXES(INDEXBYFILEBYNUMBERB),X$FIELDS,X$FILES
where
((
 wfile_id == X$FILES.XF$CODE
and wfile_id == X$INDEXES.XI$FILECODE
//and windex_id == X$INDEXES.XI$NUMBER
and wfile_id == X$FIELDS.XE$FILECODE
and X$INDEXES.XI$FIELDCODE == X$fields.XE$Code
)) 
condition byFlt = Picked='V'
;
Parameters wfile_id,windex_id,wmyIndexFlt ;

Function ChkIndFlt: boolean ; 
{ ChkIndFlt:=SearchMarker(Markers,X$INDEXES.XI$NUMBER,IndexMark);
  logstrtofile('!test.log','X$INDEXES.XI$NUMBER '+if(ChkIndFlt,' !!!!',''));
}
browse brMain ;
table X$INDEXES ;
fields
//picked : [1],protect ;
X$INDEXES.XI$NUMBER 'Номер' : [10],protect ;
X$INDEXES.XI$NAME  'Наименование' :[30],protect ;
X$INDEXES.XI$PART  'Часть' : [10],protect ;
X$FIELDS.xe$name 'Поле'    : [10],protect ;
X$FIELDS.XE$TITLE 'Заголовок' : [20],protect ;
end ;
HandleEvent
cmInit:
{ if wfile_id=0 
  { message('Не задана таблица!!!');
    abort ; exit ;
  }
  if getfirst x$files<>0
  { message('Таблица с кодом '+string(wfile_id)+' не найдена') ;
  }
  Markers := InitMarker('', 8, 100, 100);
  if fileexist('!test.log') deletefile('!test.log');
  IndexMark:=0 ;
  if wmyIndexFlt.kol_field>0
  { wkl:=true ;
    //logstrtofile('!test.log','wmyIndexFlt.kol_field='+string(wmyIndexFlt.kol_field) )
    _loop X$INDEXES
    { if X$INDEXES.XI$PART=0
      { wkl:=true ;
      }
/*      
      logstrtofile('!test.log','X$INDEXES.XI$NUMBER='+string(X$INDEXES.XI$NUMBER)
         +',X$INDEXES.XI$PART='+string(X$INDEXES.XI$PART)      
         +',X$INDEXES.XI$FIELDCODE='+string(X$INDEXES.XI$PART)      )
*/         
      if wkl         
      { // проверим часть
        if wmyIndexFlt.kol_field>X$INDEXES.XI$PART
        { //logstrtofile('!test.log','wmyIndexFlt.field_id[X$INDEXES.XI$PART+1]='+string(wmyIndexFlt.field_id[X$INDEXES.XI$PART+1])) ;
          if X$INDEXES.XI$FIELDCODE<>wmyIndexFlt.field_id[X$INDEXES.XI$PART+1]
           wkl:=false ;
        }
        else
        if wmyIndexFlt.kol_field=X$INDEXES.XI$PART
        { logstrtofile('!test.log','URA');
          InsertMarker(Markers, X$INDEXES.XI$NUMBER);
        }
      } //if wkl 
  
    } //_loop X$INDEXES
    PushCondition(tcbyFlt);
    if getfirst X$INDEXES<>0 then 
    { message('Индексы исчерпаны!!!') ;
      closeinterface(cmDone) ;
      exit ;
    }  
  }//if wmyIndexFlt.kol_field>0
  SetTitle('Выберите индекс к таблице '+x$files.xf$name) ;
  if windex_id>0
  { if getfirst X$INDEXES where  
     (( wfile_id == X$INDEXES.XI$FILECODE
      and windex_id == X$INDEXES.XI$NUMBER
     ))=0 {}
  }
  rescanpanel(#X$INDEXES) ;
} //cmInit:
cmDefault :
{ windex_id:=X$INDEXES.XI$NUMBER ;

}
cmDone :
{  Donemarker(Markers, '');

}
end ;
end. //Interface MyGetIndex 'Выберите индекс' cyan, DoAccept ;


Interface FieldVibByRelate 'Выберите поле ссылочной целостности' cyan, DoAccept ;
create view vFieldVibByRelate
var 
  wfile_id :word ; 
  wfield_id :word;
  wfile_idfor :word ; 
  wfield_idfor :word ;
as select
X$relate.XP$FFILECODE
from X$relate
,X$FILES,X$INDEXES,X$fields
,X$FILES X$FILES1,X$INDEXES X$INDEXES1,X$fields X$fields1
where ((
  wfile_idfor == X$relate.XP$FFILECODE
and wfile_idfor == X$FILES.XF$CODE
and wfile_idfor == X$INDEXES.XI$FILECODE
and X$relate.XP$FINDEXCODE /== X$INDEXES.XI$NUMBER
and 0 == X$INDEXES.XI$PART
and X$INDEXES.XI$FILECODE == X$FIELDS.XE$FILECODE
and X$INDEXES.XI$FIELDCODE == X$fields.XE$Code
and X$relate.XP$PFILECODE == X$FILES1.XF$CODE
and X$relate.XP$PFILECODE == X$INDEXES1.XI$FILECODE
and X$relate.XP$PINDEXCODE == X$INDEXES1.XI$NUMBER
and 0 == X$INDEXES1.XI$PART
and X$INDEXES1.XI$FILECODE == X$FIELDS1.XE$FILECODE
and X$INDEXES1.XI$FIELDCODE == X$fields1.XE$Code

)) 
condition by_field = wfield_idfor = X$INDEXES.XI$FIELDCODE
;
Parameters wfile_id,wfield_id,wfile_idfor,wfield_idfor ;
browse brMain ;
table X$INDEXES ;
fields
X$INDEXES.XI$NUMBER 'Номер' : [10],protect ;
X$INDEXES.XI$NAME  'Индекс' :[30],protect ;
X$INDEXES.XI$PART  'Часть' : [10],protect ;
X$FIELDS.xe$name 'Поле'    : [10],protect ;
X$FIELDS.XE$TITLE 'Заголовок' : [20],protect ;
X$FILES1.XF$CODE 'Файл' :[6],protect ;
X$FILES1.XF$Name 'Файл ссыл.цел.' :[20],protect ;
X$FIELDS1.xe$name 'Поле'    : [10],protect ;
X$FIELDS1.XE$TITLE 'Заголовок ссыл.цел.' : [20],protect ;
X$INDEXES1.XI$NAME  'Индекс ссыл.цел.' :[30],protect ;

end ;
HandleEvent
cmInit:
{ if wfile_id=0 
  { message('Не задана таблица!!!');
    abort ; exit ;
  }
  if getfirst x$files<>0
  { message('Таблица с кодом '+string(wfile_idfor)+' не найдена') ;
  }
  SetTitle('Выберите ссылочную связку к таблице '+x$files.xf$name) ;
  if wfield_idfor>0
  { pushcondition(tcby_field);
    SetTitle('Выберите ссылочную связку к таблице '+x$files.xf$name+',код поля '+string(wfield_idfor)) ;
  }
  if getfirst X$relate<>0
  { message('нет ссылочной целостности'+chr(13)+
      'для '+x$files.xf$name+',код поля '+string(wfield_idfor)) ;
    closeinterface(cmDone) ;
    abort ; exit ;  
  }
}
cmDefault :
{ wfield_id:=X$INDEXES1.XI$FIELDCODE ;
  wfile_id:=X$relate.XP$PFILECODE ;
}
end ;
end. //Interface FieldVibByRelate 'Выберите поле ссылочной целостности' cyan, DoAccept ;


//== Выбор таблицы
Interface MYGETFILEID 'Выберите файл' cyan, DoAccept ;
create view vMYGETFILEID 
var
 wfile_id :word;
 wkl :boolean ;  
 Markers,IndexMark :longint ;
 type_vib:word ;
as select 
  X$files.* ,
if(SearchMarker(Markers,X$FILES.XF$CODE,IndexMark),'V','') (fieldname=picked) 
  
from  X$files ;
Parameters wfile_id , type_vib  ;


browse brMain ;
table X$files ;
fields
X$FILES.XF$CODE 'Файл' :[6],protect ;
X$FILES.XF$Name 'Файл ссыл.цел.' :[20],protect ;
X$FILEs.XF$LOC 'Положение'    : [10],protect ;
X$FILEs.XF$LOC2 'Положение2'    : [10],protect ;
X$FILES.XF$TITLE 'Заголовок' : [20],protect ;

end ;
browse brMainPick ('Множественная пометка Таблиц',,sci178InsPM);
table X$files ;
fields
picked : [1],protect ;
X$FILES.XF$CODE 'Файл' :[6],protect ;
X$FILES.XF$Name 'Файл ссыл.цел.' :[20],protect ;
X$FILEs.XF$LOC 'Положение'    : [10],protect ;
X$FILEs.XF$LOC2 'Положение2'    : [10],protect ;
X$FILES.XF$TITLE 'Заголовок' : [20],protect ;

end ;
HandleEvent
cmMarkUnMark :
{ if  SearchMarker(Markers,X$FILES.XF$CODE,IndexMark)
  then DeleteMarker(Markers,X$FILES.XF$CODE)
  else InsertMarker(Markers, X$FILES.XF$CODE);
  rescanpanel(#X$FILES) ;
}
cmSelectAll :
{ pushpos(#X$FILES) ;
  _loop X$FILES
  { InsertMarker(Markers, X$FILES.XF$CODE);
  }
  poppos(#X$FILES) ; 
  rescanpanel(#X$FILES) ;
}
cmUnSelectAll :
{ ClearMarker( Markers);
  rescanpanel(#X$FILES) ;
}
cmInit:
{ if wfile_id=0
  { if not readmydsk(wfile_id,'MYGETFILEID',wkl ) then wfile_id:=0 ;
  }
  Markers := InitMarker('MYGETFILEID', 8, 100, 100);
  ClearMarker( Markers) ;
  if type_vib=1
   SetFormat(brMainPick) ;
  
}  
cmDone:
{  Donemarker(Markers, 'MYGETFILEID');
}
cmDefault :
{ 
  wfile_id:=X$files.XF$CODE ;
  Savemydsk(wfile_id,'MYGETFILEID') ;
  if GetMarkerCount(Markers)=0
  {  InsertMarker(Markers, X$FILES.XF$CODE);
  }
}
end ;
end. //Interface MYGETFILEID 'Выберите файл' cyan, DoAccept ;


//== Выбор поля таблицы
Interface MYGETFIELD 'Выберите поле' cyan, DoAccept ;
create view vMYGETFIELD 
var
 wfile_id,wfield_id :word;
 wkl :boolean ;  
 Markers,IndexMark :longint ;
 type_vib:word ;
as select 
  X$files.* ,
if(SearchMarker(Markers,X$FIELDS.XE$CODE,IndexMark),'V','') (fieldname=picked) 
  
from  X$files,X$Fields 
where ((
   wfile_id ==X$files.XF$CODE
 and wfile_id == X$FIELDS.XE$FILECODE
)) 
;
Parameters wfile_id , type_vib , wfield_id ;


browse brMain ;
table X$FIELDS ;
fields
X$FIELDS.xe$name 'Поле'    : [10],protect ;
X$FIELDS.XE$TITLE 'Заголовок' : [20],protect ;

end ;
browse brMainPick('Множественная пометка Полей',,sci178InsPM); ;
table X$FIELDS ;
fields
picked : [1],protect ;
X$FIELDS.xe$name 'Поле'    : [10],protect ;
X$FIELDS.XE$TITLE 'Заголовок' : [20],protect ;

end ;
HandleEvent
cmMarkUnMark:
{ if (SearchMarker(Markers,X$FIELDS.XE$CODE,IndexMark))
  then DeleteMarker(Markers,X$FIELDS.XE$CODE)
  else InsertMarker(Markers, X$FIELDS.XE$CODE);
  rescanpanel(#X$FIELDS) ;
}
cmSelectAll :
{ pushpos(#X$FIELDS) ;
  _loop X$FIELDS
  { InsertMarker(Markers, X$FIELDS.XE$CODE);
  }
  poppos(#X$FIELDS) ; 
  rescanpanel(#X$FIELDS) ;
}
cmUnSelectAll :
{ ClearMarker( Markers);
  rescanpanel(#X$FIELDS) ;
}
cmInit:
{ if wfile_id=0
  { if not readmydsk(wfield_id,'MYGETFIELD',wkl ) then wfile_id:=0 ;
  }
  if getfirst x$files<>0 
  { message('Нет таблицы с кодом '+string(wfile_id));
    closeinterface(cmDone) ; abort ; exit ;
  }
  SetTitle('Выбор полей к таблице '+X$FILES.XF$Name+'/'+X$FILES.XF$TITLE) ;
  Markers := InitMarker('MYGETFIELD', 8, 100, 100);
  ClearMarker( Markers);
  if type_vib=1
   SetFormat(brMainPick) ;
  
}  
cmDone:
{  Donemarker(Markers, 'MYGETFIELD');
}
cmDefault :
{ 
  wfield_id:=X$fields.XE$CODE ;
  Savemydsk(wfile_id,'MYGETFIELD') ;
  if GetMarkerCount(Markers)=0
  {  InsertMarker(Markers, X$FIELDS.XE$CODE);
  }
}
end ;
end. //Interface MYGETFIELD 'Выберите поле' cyan, DoAccept ;


