// Галактика 8.10
// Создание/модификация настроек для Fakel -
// Зарплата Управлением персоналом
//******************************************************************************
#define ComponentVersion

#include CreateTune.vih

//------------------------------------------------------------------------------
Handler with replace Niimash_DateModifyTune on ExtensionPoint
  epDateModifyTuneEx (TS : ObjStartCreateTuneEx) [201]
Action
{
   TS.SetLastDateModTuneComp('Niimash', 20, 06, 2023);
   result := true;
}
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
Handler with replace Niimash_CreateTune on extensionPoint
  epCreateTuneComponent (TR: ObjCreateTuneEx) [201]
Action
{
  Result := true;
  TR.SetComponent('Niimash');     // установить имя компонента

  // для случаев изменения типа настройки и конвертации ее предыдущего значения
  var CanUpdateValue: boolean;

  TR.SetNextNumberTune(40000); // а вдруг не тронут?!
//------------------------------------------------------------------------------
//******************************************************************************
  TR.SetParent('Tune');
  TR.AddPartA('Niimash','Настройки Ниимаш','');
//******************************************************************************
  TR.SetParent('Niimash');
//------------------------------------------------------------------------------
//******************************************************************************
  TR.AddPartA('Niimash.GALCOMMON', 'Общие настройки системы', '');
  TR.SetParent('Niimash.GALCOMMON');

  TR.AddTuneU('UP.NiimashGAL.Niimash', 'Показывать поля для Ниимаш', ftList, '0', '', '0');
   TR.AddList(0, 'Нет');
   TR.AddList(1, 'Да');

}
