tree WorkingTableBrowse (,hcWT_TABEL,sci1478EscInsC8CC);
  show at (,,,19);
  QSearchPosChanged;
  table SWRKTABLE;
  fields
/*     {Font={Color=if(LSTAB_MarkerStr <> '', ColorMark, 0)}};
      LSTab_MarkerStr: [1], skip, noAutoSize;
      SWrkTable.TabN 'Таб.№' ('Табельный номер'): [10], protect, noAutoSize;
      SWrkTable.StrTabN 'Таб.№' ('Табельный номер'): [10], protect, noAutoSize;
      Persons.FIO 'Работник' ('Работник'): [30], protect, noAutoSize, noDel;
      TableDepartment.KOD  'Код подр.' ('Код подразделения отнесения затрат', hcperexod): [7], protect;
      TableDepartment.Name 'Подразделение' ('Подразделение отнесения затрат', hcperexod): [20], protect;
      TabHasCopy 'Корр.' ('Признак корректировки табеля'): [6], protect, noAutoSize, centered;
      LSTab.LastDate 'Проверен'('Дата последней проверки табеля'): [10], protect, noAutoSize, centered, noDel;
*/
    TableDepartment.KOD  'Код подр.' ('Код подразделения отнесения затрат', hcperexod): [7], protect;
    OPERATINGMODESTR 'Режим' ('Режим', hcperexod): [7], protect;
!    TabHasCopy 'Корр.' ('Признак корректировки табеля'): [6], protect, noAutoSize, centered;
!      LSTab.LastDate 'Проверен'('Дата последней проверки табеля'): [10], protect, noAutoSize, centered, noDel;

