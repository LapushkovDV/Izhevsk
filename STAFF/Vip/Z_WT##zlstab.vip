  //--------------------------
  create view vScud
  var
    pPersons:comp;
    wYearRas, wMonthRas:word;
  as select GP_SCUD_Pers.Nrec
  From GP_SCUD_Pers, Tmp_Scud_MisConDuct
  where ((
        pPersons == GP_SCUD_Pers.cPersons
    and GP_SCUD_Pers.Nrec == Tmp_Scud_MisConDuct.cGP_SCUD_PERS
    and wYearRas          == Tmp_Scud_MisConDuct.YearN
    and wMonthRas         == Tmp_Scud_MisConDuct.MesN
  ))  ;


  //-------------------------------------------------------
//  overloadFormats WorkingTableBrowse, PersonalTableBrowse;
  extendFormats WorkingTableBrowse, PersonalTableBrowse;
  //-------------------------------------------------------

function IsKorr : boolean;
var i : byte;
    ChasfDay : double;
    dDate, dDatePer : date;
{
  Result := false;

  dDate := date(1,LSTab.MesN, LSTab.YearN);
  dDatePer := date(1, month(dGetTune('UP.DATOTCH')), year(dGetTune('UP.DATOTCH')));

  if (dDatePer <= dDate)//если табель не за прошедший отчетный период - не выводим признак корректировки
    exit;

  if not IsValidAll(tnGP_TimeTable)
    exit;

  _loop GP_TimeTable
	{
    i := Day(gp_TimeTable.DBeg);
		do
    {
      if lstab.DAYCHF[i]>100
        ChasfDay:=0;
      else
        ChasfDay:=lstab.daychf[i];

			if (ChasfDay<>gp_timeTable.DHOURS[i]) or
         (LoCase(trim(lstab.DAYS[i])) <> LoCase(trim(gp_timeTable.dMark[i])) and
          (LoCase(trim(gp_timeTable.dMark[i])) = 'нн' or LoCase(trim(lstab.DAYS[i])) = 'б'))
			{
        Result := true;
        exit;
			}
			i++;
		}
		while (i<day(gp_TimeTable.DEnd)+1)
	}

}

