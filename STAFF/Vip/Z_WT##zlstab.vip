/*************************************************************************************************\
* Наименование:  Ведение заказов/проектов - Распределение ФОТ работников по заказам               *
* Контур/Модуль: Заработная плата                                                                 *
* Примечание:    Доработка табеля учета рабочего времени                                          *
*                Контейнер для данных табеля учета рабочего времени                               *
* #178 При задании даты закрытия/обработки табеля необходимо проверять наличие необработанных     *
*      нарушений в СКУД. При наличии таковых запрещать устанавливать дату                         *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#767          |10/09/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#1138         |06/11/17|Тищенко Р.Н.             |НПО Энергомаш                    *
* Разработка  |#1236         |10/11/17|Тищенко Р.Н.             |НПО Энергомаш                    *
* Разработка  |#178          |03/12/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#3574         |31/10/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#87938        |16/01/25|Семичев П.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
//'Z_WT::ZLSTAB.WORKINGTABLEWINDOW.WTCONTAINEREMBEDDED.Z_WT##WTCONTAINER.PAGE4.Z_WT::WTHANDCORRECTIONMASK.HANDCORRECTIONBROWSE.MASKWORKINGHOURSSTR'
//VII. Доработка табеля учета рабочего времени
/*
SD-87938
Изменение логики сохранения исходных табелей - теперь табель сохраняется при проставлении поля "Дата проверки"
Если месяц табеля больше или равен месяцу из настройки с текущим периодом - происходит сохранение, в противном
случае - копия табеля не перезатирается.
Данная доработка потребовалась, так как между проверкой табеля и созданием копии по старой технологии (через
пункт меню "Просмотр исходного табеля") могло пройти некоторое время, за которое бухгалтерия успевала провести
несколько приказов по изменению табеля, по этим приказам не формировались корректировочные начисления.
  Изменение принципа отображение признака корректировки в табеле. Раньше признак отображался, если была
сохраненная копия, теперь такая копия есть всегда. Признак появляется если в сохраненной копии и рабочем табеле
есть расхождение в отработанных часах или если буквенное обозначение графика изменилось с "НН" на "Б"

Upd_18.02.2025 Теперь признак "Корр" ставится не только при изменении с "НН" на "Б" а и просто если было "НН",
а стало что-то другое. Пока так, но чувствую будут еще изменения...
Upd_21.03.2025 Добавление к проставлению признака корректировки - если было что-то, а стало "Б" - тоже ставим "корр"
*/

#doc
 Доработка табеля учета рабочего времени
#end
#include GetKau.Vih
#include GP_FormT12.vih

#component "Z_WT"

function LikeATableTime(var s: string): boolean; external 'G_WORKTABLE.DLL';

