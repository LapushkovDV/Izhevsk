  var
    DayInfoBrVisible: Boolean = true;

  procedure SwitchDayInfoBr(_Visible: Boolean);
  {
    if (DayInfoBrVisible = _Visible)
      exit;
    ToggleFieldVisible(#DaysBr, _Visible);
    ToggleFieldVisible(#HoursBr, _Visible);
    ToggleFieldVisible(#DayInfoBr1, _Visible);
    ToggleFieldVisible(#DayInfoBr2, _Visible);
    ToggleFieldVisible(#DayInfoBr3, _Visible);
    ToggleFieldVisible(#DayInfoBr4, _Visible);
    ToggleFieldVisible(#DayInfoBr5, _Visible);
    ToggleFieldVisible(#DayInfoBr6, _Visible);
    ToggleFieldVisible(#DayInfoBr7, _Visible);
    ToggleFieldVisible(#DayInfoBr8, _Visible);
    ToggleFieldVisible(#DayInfoBr9, _Visible);
    ToggleFieldVisible(#DayInfoBr10, _Visible);
    ToggleFieldVisible(#DayInfoBr11, _Visible);
    ToggleFieldVisible(#DayInfoBr12, _Visible);
    ToggleFieldVisible(#DayInfoBr13, _Visible);
    ToggleFieldVisible(#DayInfoBr14, _Visible);
    ToggleFieldVisible(#DayInfoBr15, _Visible);
    ToggleFieldVisible(#DayInfoBr16, _Visible);
    ToggleFieldVisible(#DayInfoBr17, _Visible);
    ToggleFieldVisible(#DayInfoBr18, _Visible);
    ToggleFieldVisible(#DayInfoBr19, _Visible);
    ToggleFieldVisible(#DayInfoBr20, _Visible);
    ToggleFieldVisible(#DayInfoBr21, _Visible);
    ToggleFieldVisible(#DayInfoBr22, _Visible);
    ToggleFieldVisible(#DayInfoBr23, _Visible);
    ToggleFieldVisible(#DayInfoBr24, _Visible);
    ToggleFieldVisible(#DayInfoBr25, _Visible);
    ToggleFieldVisible(#DayInfoBr26, _Visible);
    ToggleFieldVisible(#DayInfoBr27, _Visible);
    ToggleFieldVisible(#DayInfoBr28, _Visible);
