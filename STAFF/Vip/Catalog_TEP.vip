/*************************************************************************************************\
* Наименование: Каталог коэффициентов использования материалов (для возвратных отходов)           *
* Контур/Модуль: ALL                                                                              *
* Вид работы  |Номер           |Дата    |Исполнитель              |Проект                         *
*  -----------------------------------------------------------------------------------------------*
* Разработка  |# NaN           |28/03/22|kurennykh                |НПО Энергомаш                  *
\*************************************************************************************************/

#doc
Каталог ТЭП для отчетов по заказу Петра Борисовича
#end

#include Query.vih
#include GetKau.Vih
#include Marker.Vih

Interface Catalog_TEP 'Каталог ТЭП';
Show(,,150,25);

Const
  wKodGrKau = 10732;
End;

#include GetKau.Var

Create View
Var
  _sCodeTune     : string = 'NPOEM_OWN.KAT.TEP.ACCESS';
As
Select
  KatPodr.Kod + ', ' + KatPodr.Name (FieldName = _sPodr)
From
  SpKau
, SpKau SpKau1
, EM_UNIDOC_HEAD UniDoc
, EM_UNIDOC_SPEC SpUniDoc
, KatEd
, KatPodr
, KatPodr KatPodr1
, FpPeriod
, EM_UNIDOC_SPEC SpUniDoc1
Where
((
        wKodGrKau == SpKau.KodGrKau (noIndex)
    and 711 == UniDoc.wType
    and UniDoc.cPodr == KatPodr.nRec
    and UniDoc.AddComp[1] == FpPeriod.nRec
    and UniDoc.nRec == SpUniDoc.cHead
    and SpUniDoc.AddComp[1] == SpKau.nRec
    and SpUniDoc.AddComp[2] == KatEd.nRec
))
;

Procedure RecalcSum(_c : comp);
{
  var _sp, _sf : double;
  var _i : word;
  _Loop SpUniDoc where ((_c == SpUniDoc.cHead))
  {
    if (SpUniDoc.AddComp[3] = 0h) then
    {
      _sp := 0.0;
      _sf := 0.0;
      _i  := 0;
      _Loop SpUniDoc1 where ((_c == SpUniDoc1.cHead and SpUniDoc.AddComp[1] == SpUniDoc1.AddComp[3] (noIndex)))
      {
        _sp := _sp + SpUniDoc1.AddDouble[1];
        _sf := _sf + SpUniDoc1.AddDouble[2];
        _i ++;
      }
      if (_i > 0) then
      {
        Set SpUniDoc.AddDouble[1] := _sp;
        Set SpUniDoc.AddDouble[2] := _sf;
        Update Current SpUniDoc;
      }
    }
  }
}

Procedure AsSetDefault;
{
  if (boGetTune(_sCodeTune) = true) then
  {
    StartNewVisual(vtRotateVisual, vfTimer, 'Формирование спецификации', 0);
    ClearBuffer(#UniDoc);
      UniDoc.nRec     := 0h;
      UniDoc.wType    := 711;
      UniDoc.DocNumb  := '';
    Insert Current UniDoc;
    SetNew(false);

    _Loop SpKau where ((wKodGrKau == SpKau.KodGrKau)) ordered by SpKau.LevelCode
    {
      ClearBuffer(#SpUniDoc);
        SpUniDoc.nRec        := 0h;
        SpUniDoc.AddComp[1]  := SpKau.nRec;
        SpUniDoc.AddComp[3]  := SpKau.cNode;
        SpUniDoc.AddWord[10] := UniDoc.wType;
        if (getLast SpUniDoc1 where ((SpKau.nRec == SpUniDoc1.AddComp[1] (noIndex) and UniDoc.wType == SpUniDoc1.AddWord[10] (noIndex))) = tsOk) then
        {
          SpUniDoc.AddComp[2] := SpUniDoc1.AddComp[2];
        }
      Insert Current SpUniDoc;
      SetNew(false);
    }
    StopVisual;
  }
  else
  {
    Message('Вы не имеете права редактировать ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
}


Screen scTepHead 'Технико-экономические показатели (шапка)' (,,sci1Esc);
Show at (,,70,1);
<<
    Список ТЭП
>>
End; //scTepHead

Browse brTepHead 'Технико-экономические показатели (шапка)' (,,Sci1378Esc);
Show At (,2,70,);

Table UniDoc;

Fields
  UniDoc.DocNumb 'Номер документа' ('Номер документа',,) : [10], noProtect, noPickButton;
  KatPodr.Kod    'Подразделение'   ('Подразделение',,)   : [30],   Protect,   PickButton;
  FpPeriod.Name  'Период'          ('Период',,)          : [30],   Protect,   PickButton;
End; //brTepHead

Screen scTepSpec 'Технико-экономические показатели (спецификация)' (,,sci1Esc);
Show at (71,,,1);
<<
    Спецификация ТЭП
>>
End; //scTepSpec

Browse brTepSpec 'Технико-экономические показатели (спецификация)' (,,Sci13Esc);
Show At (71,2,,);

Table SpUniDoc;

Fields
  SpKau.Code             '№ п/п'              ('№ п/п'             ,,sci178)  : [5] , Protect, noPickButton;
  SpKau.Name             'Показатели работ'   ('Показатели работ'  ,,sci1378) : [40], Protect, noPickButton;
  KatEd.Abbr             'Единицы измерения'  ('Единицы измерения' ,,sci1378) : [5] , Protect, PickButton;
  SpUniDoc.AddDouble[1]  'ТЭП План'           ('ТЭП План'          ,,sci1378) : [10 , '\2p[|-]36`666`666`666`666`666.88'], noProtect, noPickButton;
  SpUniDoc.AddDouble[2]  'ТЭП Факт'           ('ТЭП Факт'          ,,sci1378) : [10 , '\2p[|-]36`666`666`666`666`666.88'], noProtect, noPickButton;
End; //brTepSpec

TableEvent Table UniDoc;
cmSetDefault:
{
  AsSetDefault;
}

cmDeleteRecord:
{
  if (boGetTune(_sCodeTune) = true) then
  {
    if (message('Удалить текущую запись?', YesNo) = cmYes) then
    {
      StartNewVisual(vtRotateVisual, vfTimer, 'Удаление записи', 0);
      Delete SpUniDoc where ((UniDoc.nRec == SpUniDoc.cHead));
      Delete Current UniDoc;
      StopVisual;
    }
    else
      Abort;
  }
  else
  {
    Message('Вы не имеете права удалять записи ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
}
End; //TableEvent UniDoc

HandleEvent
cmPick:
{
  if (boGetTune(_sCodeTune) = true) then
  {
    case CurField of
      #KatPodr.Kod :
      {
        var _cRec : comp = 0h;
        if (iGetKau.GetCodeKau(cgiPick, cgKau_KatPodr, _cRec) <> 0 ) then
        {
          if (getFirst KatPodr1 where ((_cRec == KatPodr1.nRec)) = tsOk) then
          {
            if (Length(KatPodr1.Kod) > 3) then
            {
              Message('Допускается выбирать только "трехзначные" подразделения'#13 +
                       'Выбранное подразделение будет заменено на ' + SubStr(KatPodr1.Kod, 1, 3), Warning);
              var _s : string = SubStr(KatPodr1.Kod, 1, 3);
              if (getFirst KatPodr1 where ((_s == KatPodr1.Kod)) = tsOk) then
              {
                Set UniDoc.cPodr := KatPodr1.nRec;
                Update Current UniDoc;
              }
            }
            Set UniDoc.cPodr := KatPodr1.nRec;
            Update Current UniDoc;
          }
        }
      }

      #FpPeriod.Name :
      {
        var _cRec : comp = 0h;
        if (iGetKau.GetCodeKau(cgiPick, cgKau_FpPeriod, _cRec) <> 0 ) then
        {
          Set UniDoc.AddComp[1] := _cRec;
          Set UniDoc.AddWord[1] := Month(FpPeriod.dBeg);
          Set UniDoc.AddWord[2] := Year(FpPeriod.dBeg);
          Set UniDoc.AddDate[1] := FpPeriod.dBeg;
          Set UniDoc.AddDate[2] := FpPeriod.dEnd;
          Update Current UniDoc;
        }
      }

      #KatEd.Abbr :
      {
        var _cRec : comp = 0h;
        if (RunInterface('L_MCU::GETEDIZM', _cRec) = cmDefault) then
        {
          Set SpUniDoc.AddComp[2] := _cRec;
          Update Current SpUniDoc;
        }
      }
    end;
  }
  else
  {
    Message('Вы не имеете права редактировать ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
  ReReadRecord;
}

cmCheckField:
{
  if (boGetTune(_sCodeTune) = true) then
  {
    case CurField of
      #UniDoc.DocNumb:
      {
        Update Current UniDoc;
      }

      #SpUniDoc.AddDouble[1], #SpUniDoc.AddDouble[2]:
      {
        Update Current SpUniDoc;
      }
    end;
    ReReadRecord;
    PushPos(#SpUniDoc);
    RecalcSum(UniDoc.nRec);
    PopPos(#SpUniDoc);
  }
  else
  {
    Message('Вы не имеете права редактировать ТЭП '#13 +
             GetTuneName(_sCodeTune), Error);
    Abort;
  }
}
End; //HandleEvent
End.
