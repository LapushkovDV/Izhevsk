#include Query.vih


VipInterface Rep_Lottery Licensed(free);

Interface Rep_Lottery 'Отчет по акциям', EscClose;
Show at (,,50,5);

Table Struct tRep
(
    sFio    : string
  , sTabN   : string
  , sPost   : string
  , sKat    : string
  , sPodr   : string
  , datUv   : date
  , dKol    : word
)
With Index
(
    i01 = sFio
  , i02 = sTabN + sPodr
);

Table Struct tRepSpis
(
    sTabN   : string
  , sPodr   : string
  , dKol    : word
)
With Index
(
    i01 = sTabN + sPodr
);


Table Struct tRepYear
(
    wYear   : word
  , wQuart  : word
  , sPodr   : string
  , sTabN   : string
  , dKol    : word
)
With Index
(
    i01 = sTabN + sPodr
);

Create View rView

var
  RowNo    : longint;
  ColNo    : longint;

  _repType : word;
  _year    : word;

  _log     : string;
  _sM      : string;

As
select
  1
from
  tRep
, tRepSpis
, tRepYear
;


Screen scr1 'Отчет по акциям качества' (,,sci13Esc);
Show at (,,,);
Fields
  _repType      noProtect, NoFrame;
  _year         noProtect, noPickButton;
Buttons
  cmCancel,,, 'Отмена'      ,,sci1Esc;
  cmOk    ,,, 'Сформировать',,sci1Esc;
<<
 `Вариант отчета`  (.) упрощенный`
                   (.) расширенный за` .@@@@ `год`

 <. Отмена .>   <. Сформировать .>
>>
end;

Procedure MyLog(_str: string);
{
  Exit;
  LogStrToFile(_log,_str);
}

Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  MyLog('sql: ' + add_query_str);
}

Procedure aStrM(s : string);
{
   LogStrToFile(_sM, Oem2Ansi(s));
}

Procedure SubRepLotteryEasy();
{
  _sM := TranslatePath('%Temp%\' + String(UserId) + '.log');

  if (FileExist(_sM)) then
  {
    DeleteFile(_sM);
  }

  aStrM('  Sub LotteryHead()                               ');
  aStrM('   Range("A5").Select                            ');
  aStrM('   ActiveWindow.FreezePanes = True               ');
  aStrM('   Range("A4:F4").Select                         ');
  aStrM('   Selection.AutoFilter                          ');
  aStrM('  End Sub                                        ');

  xlImportModule(_sM);
  xlRunMacro('LotteryHead');

  if (FileExist(_sM)) then
  {
    DeleteFile(_sM);
  }
}

Procedure SubRepLotteryHard();
{
  _sM := TranslatePath('%Temp%\' + String(UserId) + '.log');

  if (FileExist(_sM)) then
  {
    DeleteFile(_sM);
  }

  aStrM('  Sub LotteryHead()                              ');
  aStrM('   Rows("5:5").Select                            ');
  aStrM('   Range("I5").Activate                          ');
  aStrM('   Selection.AutoFilter                          ');
  aStrM('   Range("A6").Select                            ');
  aStrM('   ActiveWindow.FreezePanes = True               ');
  aStrM('  End Sub                                        ');

  xlImportModule(_sM);
  xlRunMacro('LotteryHead');

  if (FileExist(_sM)) then
  {
    DeleteFile(_sM);
  }
}

Function MakeData_Easy() : longint;
{
  result := 0;

  Delete All tRep;

  var qStr : longInt = 0;

  sqlFreeStr(qStr);

  StartNewVisual(vtRotateVisual, vfTimer, 'Подсчет акций у сотрудников'#13 +
                                          'Дата : ' + DateToStr(Cur_Date(),'DD/MM/YYYY'), 0);

  MysqlAddStr(qStr, '    SELECT    kolakc.fio                                                               as sFio                           ');
  MysqlAddStr(qStr, '            , kolakc.tabn                                                              as sTabN                          ');
  MysqlAddStr(qStr, '            , cat.name                                                                 as sPost                          ');
  MysqlAddStr(qStr, '            , kp.kod                                                                   as sPodr                          ');
  MysqlAddStr(qStr, '            , catkat.name                                                              as sKat                           ');
  MysqlAddStr(qStr, '            , p.disdate                                                                as datUv                          ');
  //MysqlAddStr(qStr, '            , sum(case when (ak.SIGN = ''0'') then kolakc.kol else -1.0 * kolakc.kol end) as dKol                        ');
  MysqlAddStr(qStr, '            , count(*)                                                                 as dKol                           ');
  MysqlAddStr(qStr, '    FROM EM_LOT_AKCII ak                                                                                                 ');
  MysqlAddStr(qStr, '         left join EM_VEDNACH_SP_POINTS vsp on ak.CVEDSPPOINT = vsp.NREC                                                 ');
  MysqlAddStr(qStr, '         left join EM_VEDNACH_SPEC vs on vsp.CVEDNACH_SP = vs.nrec                                                       ');
  MysqlAddStr(qStr, '         left join persons p on vs.CPERSON = p.nrec                                                                      ');
  MysqlAddStr(qStr, '         left join katpodr kp ON p.galdep = kp.nrec                                                                      ');
  MysqlAddStr(qStr, '         left join( SELECT count(p.fio)      as kol                                                                      ');
  MysqlAddStr(qStr, '                               , p.NREC      as pnrec                                                                    ');
  MysqlAddStr(qStr, '                               , p.FIO       as fio                                                                      ');
  MysqlAddStr(qStr, '                               , p.strtabn   as tabn                                                                     ');
  MysqlAddStr(qStr, '                    FROM EM_LOT_AKCII ak                                                                                 ');
  MysqlAddStr(qStr, '                         left join EM_VEDNACH_SP_POINTS vsp on ak.CVEDSPPOINT = vsp.NREC                                 ');
  MysqlAddStr(qStr, '                         left join EM_VEDNACH_SPEC  vs on vsp.CVEDNACH_SP = vs.nrec                                      ');
  MysqlAddStr(qStr, '                         left join persons p on  vs.CPERSON = p.nrec                                                     ');
  MysqlAddStr(qStr, '                         GROUP by p.NREC, p.FIO, p.strtabn ) kolakc ON p.NREC = kolakc.pnrec                             ');
  MysqlAddStr(qStr, '          left join ATTRVAL av on 25001 = av.wtable AND av.cattrnam = #comp(000A0000000000FBh) and  p.nrec = av.CREC     ');
  MysqlAddStr(qStr, '          left join APPOINTMENTS app ON p.appointcur = app.nrec                                                          ');
  MysqlAddStr(qStr, '          left join CATALOGS cat ON app.POST = cat.NREC                                                                  ');
  MysqlAddStr(qStr, '          left join catalogs catkat on app.cref3 = catkat.nrec                                                           ');
  MysqlAddStr(qStr, '    WHERE av.VSTRING IS NOT NULL                                                                                         ');
  MysqlAddStr(qStr, '      AND av.VSTRING <> ''''                                                                                             ');
  MysqlAddStr(qStr, '      AND ak.SIGN = ''0''                                                                                                ');
  MysqlAddStr(qStr, '    GROUP BY kolakc.fio, kolakc.tabn, cat.name, kp.kod, catkat.name, p.disdate                                           ');

  var objQuery :  iQuery;
      objQuery := queryManager.createQuery(qStr);

  if (objQuery.Execute.ErrorCode <> tsOk) then
  {
    Message('Ошибка выполнения запроса MakeData ' + objQuery.ErrorCode, Error);
  }
  else
  {
    sqlCopyInto(objQuery, tntRep, true);
    result := RecordsInTable(tntRep);
  }

  sqlFreeStr(qStr);

  SetVisualHeader('Compton!');

  StopVisual;

  result := result;
}

Function MakeData_Hard() : longint;
{
  result := MakeData_Easy();

  Delete All tRepSpis;
  Delete All tRepYear;

  var qStr : longInt = 0;

  sqlFreeStr(qStr);

  StartNewVisual(vtRotateVisual, vfTimer, 'Подсчет списанных акций у сотрудников'#13 +
                                          'Дата : ' + DateToStr(Cur_Date(),'DD/MM/YYYY'), 0);

  MysqlAddStr(qStr, '    SELECT    kolakc.tabn                                                              as sTabN                          ');
  MysqlAddStr(qStr, '            , kp.kod                                                                   as sPodr                          ');
  MysqlAddStr(qStr, '            , count(*)                                                                 as dKol                           ');
  MysqlAddStr(qStr, '    FROM EM_LOT_AKCII ak                                                                                                 ');
  MysqlAddStr(qStr, '         left join EM_VEDNACH_SP_POINTS vsp on ak.CVEDSPPOINT = vsp.NREC                                                 ');
  MysqlAddStr(qStr, '         left join EM_VEDNACH_SPEC vs on vsp.CVEDNACH_SP = vs.nrec                                                       ');
  MysqlAddStr(qStr, '         left join persons p on vs.CPERSON = p.nrec                                                                      ');
  MysqlAddStr(qStr, '         left join katpodr kp ON p.galdep = kp.nrec                                                                      ');
  MysqlAddStr(qStr, '         left join( SELECT count(p.fio)      as kol                                                                      ');
  MysqlAddStr(qStr, '                               , p.NREC      as pnrec                                                                    ');
  MysqlAddStr(qStr, '                               , p.FIO       as fio                                                                      ');
  MysqlAddStr(qStr, '                               , p.strtabn   as tabn                                                                     ');
  MysqlAddStr(qStr, '                    FROM EM_LOT_AKCII ak                                                                                 ');
  MysqlAddStr(qStr, '                         left join EM_VEDNACH_SP_POINTS vsp on ak.CVEDSPPOINT = vsp.NREC                                 ');
  MysqlAddStr(qStr, '                         left join EM_VEDNACH_SPEC  vs on vsp.CVEDNACH_SP = vs.nrec                                      ');
  MysqlAddStr(qStr, '                         left join persons p on  vs.CPERSON = p.nrec                                                     ');
  MysqlAddStr(qStr, '                         GROUP by p.NREC, p.FIO, p.strtabn ) kolakc ON p.NREC = kolakc.pnrec                             ');
  MysqlAddStr(qStr, '          left join ATTRVAL av on 25001 = av.wtable AND av.cattrnam = #comp(000A0000000000FBh) and  p.nrec = av.CREC     ');
  MysqlAddStr(qStr, '          left join APPOINTMENTS app ON p.appointcur = app.nrec                                                          ');
  MysqlAddStr(qStr, '    WHERE av.VSTRING IS NOT NULL                                                                                         ');
  MysqlAddStr(qStr, '      AND av.VSTRING <> ''''                                                                                             ');
  MysqlAddStr(qStr, '      AND ak.SIGN <> ''0''                                                                                               ');
  MysqlAddStr(qStr, '    GROUP BY kolakc.tabn, kp.kod                                                                                         ');

  var objQuery :  iQuery;
      objQuery := queryManager.createQuery(qStr);

  if (objQuery.Execute.ErrorCode <> tsOk) then
  {
    Message('Ошибка выполнения запроса MakeData_Hard 1 ' + objQuery.ErrorCode, Error);
  }
  else
  {
    sqlCopyInto(objQuery, tntRepSpis, true);
    result := result + RecordsInTable(tntRepSpis);
  }

  qStr := 0;
  sqlFreeStr(qStr);

  SetVisualHeader('Обработка баллов текущего периода');

  MysqlAddStr(qStr, '    select                                                                                             ');
  MysqlAddStr(qStr, '      EM_VEDNACH_BALLOV.WYEAR        as wYear                                                          ');
  MysqlAddStr(qStr, '    , EM_VEDNACH_BALLOV.WQUARTER     as wQuart                                                         ');
  MysqlAddStr(qStr, '    , katpodr.kod                    as sPodr                                                          ');
  MysqlAddStr(qStr, '    , persons.strtabn                as sTabN                                                          ');
  MysqlAddStr(qStr, '    , count(*)                       as dKol                                                           ');
  MysqlAddStr(qStr, '    from EM_VEDNACH_BALLOV                                                                             ');
  MysqlAddStr(qStr, '    inner join EM_VEDNACH_SPEC on EM_VEDNACH_SPEC.CVEDNACH = EM_VEDNACH_BALLOV.nrec                    ');
  MysqlAddStr(qStr, '    inner join EM_VEDNACH_SP_POINTS on EM_VEDNACH_SPEC.nrec = EM_VEDNACH_SP_POINTS.CVEDNACH_SP         ');
  MysqlAddStr(qStr, '    inner join persons on EM_VEDNACH_SPEC.cperson = persons.nrec                                       ');
  MysqlAddStr(qStr, '    inner join katpodr ON persons.galdep = katpodr.nrec                                                ');
  MysqlAddStr(qStr, '    where EM_VEDNACH_BALLOV.WYEAR = ' + string(_year) + '                                              ');
  MysqlAddStr(qStr, '    group by                                                                                           ');
  MysqlAddStr(qStr, '      EM_VEDNACH_BALLOV.WYEAR                                                                          ');
  MysqlAddStr(qStr, '    , EM_VEDNACH_BALLOV.WQUARTER                                                                       ');
  MysqlAddStr(qStr, '    , katpodr.kod                                                                                      ');
  MysqlAddStr(qStr, '    , persons.strtabn                                                                                  ');

  objQuery := queryManager.createQuery(qStr);

  if (objQuery.Execute.ErrorCode <> tsOk) then
  {
    Message('Ошибка выполнения запроса MakeData_Hard 2 ' + objQuery.ErrorCode, Error);
  }
  else
  {
    sqlCopyInto(objQuery, tntRepYear, true);
    result := result + RecordsInTable(tntRepYear);
  }

  sqlFreeStr(qStr);

  SetVisualHeader('Compton!');

  StopVisual;

  result := result;
}

#declare RepHeadTxt(sTxt)
    xlSetCellStringValue(chr(39) + #sTxt, RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;
#end

#declare RepHeadTxtM(sTxt)
    xlSetCellStringValue(chr(39) + #sTxt, RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo + 1, ColNo);
    ColNo++;
#end

Procedure PrintData_Easy();
{
  var _k : longint = 0;
  _k := MakeData_Easy();

  if (_k = 0) then
  {
    Message('По указанным параметрам не были найдены данные');
    Exit;
  }
  else
  {
    if (not xlCreateExcel('RepLottery' + DateToStr(Cur_Date(), '_YYYYMMDD') + TimeToStr(Cur_Time(), '_HHMMSS') + '.xlsx', true)) then
    {
      Message('Ошибка создания нового файла Excel', Error);
      Exit;
    }
    else
    {
      StartNewVisual(vtNumericVisual, vfTimer, 'Выгрузка отчета в Excel', 0);

      RowNo := 1;
      ColNo := 1;

      var i : longint = 0;
      var dSumT : double  = 0.0;

      if (xlIsExcelValid) then
      {
        xlSetActiveWorkBookByName('1');
      }

      xlSetCellStringValue('АО "НПО Энергомаш им. ак. В.П. Глушко"', RowNo, ColNo, RowNo, ColNo);
      xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
      xlMergeCells(RowNo, ColNo, RowNo, ColNo + 6);
      xlAlignCellsEx(xlLeft, xlCenter, RowNo, ColNo, RowNo, ColNo + 6);
      RowNo++;

      xlSetCellStringValue('Реестр акций качества на ' + DateToStr(Cur_Date(), 'DD.MM.YYYY'), RowNo, ColNo, RowNo, ColNo);
      xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
      xlMergeCells(RowNo, ColNo, RowNo, ColNo + 6);
      xlAlignCellsEx(xlLeft, xlCenter, RowNo, ColNo, RowNo, ColNo + 6);
      RowNo := RowNo + 2;

      #RepHeadTxt('Подразделение №')
      #RepHeadTxt('Табельный номер')
      #RepHeadTxt('ФИО')
      #RepHeadTxt('Должность')
      #RepHeadTxt('Категория')
      #RepHeadTxt('Акции всего')

      var firstRow  : longint = RowNo + 1;

      RowNo := 0;

      xlCreateMatrix(RecordsInTable(tntRep), 6);

      _Loop tRep ordered by sFio
      {
        ColNo := 0;
        i++;

        xlStWriteToMatrix(++RowNo, ++ColNo, chr(39) + tRep.sPodr);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sTabN);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sFio );
        if ((tRep.datUv <> ZeroDate) and (tRep.datUv < Cur_Date())) then
        {
          xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + 'Уволен ' + DateToStr(tRep.datUv, 'DD.MM.YYYY'));
        }
        else
        {
          xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sPost);
        }
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sKat );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tRep.dKol );

        SetVisualHeader('Напечатано'#13 +
                         i + ' / ' + _k);

      }

      XLWRITEMATRIXTOEXCEL(firstRow, 1);
      XLFREEMATRIX;

      xlSetNumberFormat('### ### ### ##0' + xlGetDecimalSeparator + ' 00', firstRow, 6, firstRow + RowNo - 1, 6);
      xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, firstRow - 1, 1, firstRow + RowNo - 1, 6);
      xlAutoFit(1, 1, firstRow + RowNo - 1, 6);

      SubRepLotteryEasy();

      xlKillExcel;
      StopVisual;
    }
  }
}

Procedure PrintData_Hard();
{
  var _k : longint = 0;
  _k := MakeData_Hard();

  if (_k = 0) then
  {
    Message('По указанным параметрам не были найдены данные');
    Exit;
  }
  else
  {
    if (not xlCreateExcel('RepLottery' + DateToStr(Cur_Date(), '_YYYYMMDD') + TimeToStr(Cur_Time(), '_HHMMSS') + '.xlsx', true)) then
    {
      Message('Ошибка создания нового файла Excel', Error);
      Exit;
    }
    else
    {
      StartNewVisual(vtNumericVisual, vfTimer, 'Выгрузка отчета в Excel', 0);

      RowNo := 1;
      ColNo := 1;

      var i : longint = 0;
      var dSumT : double  = 0.0;

      if (xlIsExcelValid) then
      {
        xlSetActiveWorkBookByName('1');
      }

      xlSetCellStringValue('АО "НПО Энергомаш им. ак. В.П. Глушко"', RowNo, ColNo, RowNo, ColNo);
      xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
      xlMergeCells(RowNo, ColNo, RowNo, ColNo + 6);
      xlAlignCellsEx(xlLeft, xlCenter, RowNo, ColNo, RowNo, ColNo + 6);
      RowNo++;

      xlSetCellStringValue('Реестр акций качества на ' + DateToStr(Cur_Date(), 'DD.MM.YYYY'), RowNo, ColNo, RowNo, ColNo);
      xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
      xlMergeCells(RowNo, ColNo, RowNo, ColNo + 6);
      xlAlignCellsEx(xlLeft, xlCenter, RowNo, ColNo, RowNo, ColNo + 6);
      RowNo := RowNo + 2;

      #RepHeadTxtM('Подразделение №')
      #RepHeadTxtM('Табельный номер')
      #RepHeadTxtM('ФИО')
      #RepHeadTxtM('Должность')
      #RepHeadTxtM('Категория')
      #RepHeadTxtM('Акции всего')
      #RepHeadTxtM('Акции до текущего года')
      #RepHeadTxtM('Списано по результатам розыгрыша')
      #RepHeadTxt('Акции за текущий (' + _year + ') год')
      ColNo--;
      xlMergeCells(RowNo, ColNo, RowNo, ColNo + 4);
      RowNo++;

      #RepHeadTxt('Всего')
      #RepHeadTxt('1 квартал')
      #RepHeadTxt('2 квартал')
      #RepHeadTxt('3 квартал')
      #RepHeadTxt('4 квартал')

      var firstRow  : longint = RowNo + 1;

      RowNo := 0;

      xlCreateMatrix(_k, 13);

      _Loop tRep ordered by sFio
      {
        ColNo := 0;
        i++;

        xlStWriteToMatrix(++RowNo, ++ColNo, chr(39) + tRep.sPodr);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sTabN);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sFio );
        if ((tRep.datUv <> ZeroDate) and (tRep.datUv < Cur_Date())) then
        {
          xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + 'Уволен ' + DateToStr(tRep.datUv, 'DD.MM.YYYY'));
        }
        else
        {
          xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sPost);
        }
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sKat );
        xlDoWriteToMatrix(  RowNo, ++ColNo,           tRep.dKol );

        ColNo++; //вычисляемое поле
        ColNo++;

        if (getFirst FastFirstRow tRepSpis where ((tRep.sPodr == tRepSpis.sPodr and tRep.sTabN == tRepSpis.sTabN)) = tsOk) then
        {
          xlDoWriteToMatrix(  RowNo, ColNo,           tRepSpis.dKol );
        }

        ColNo++; //вычисляемое поле

        _Loop tRepYear where ((tRep.sPodr == tRepYear.sPodr and tRep.sTabN == tRepYear.sTabN))
        {
          case tRepYear.wQuart of
            1 : {
              xlDoWriteToMatrix(  RowNo, ColNo + 1,           tRepYear.dKol );
            }
            2 : {
              xlDoWriteToMatrix(  RowNo, ColNo + 2,           tRepYear.dKol );
            }
            3 : {
              xlDoWriteToMatrix(  RowNo, ColNo + 3,           tRepYear.dKol );
            }
            4 : {
              xlDoWriteToMatrix(  RowNo, ColNo + 4,           tRepYear.dKol );
            }
          end;
        }

        SetVisualHeader('Напечатано'#13 +
                         i + ' / ' + _k);

      }

      XLWRITEMATRIXTOEXCEL(firstRow, 1);
      XLFREEMATRIX;

      xlSetCellFormula('=СУММ(RC[1]:RC[4])', 6, 9, firstRow + RowNo - 1, 9);
      xlSetCellFormula('=RC[-1]-RC[2]', 6, 7, firstRow + RowNo - 1, 7);

      xlSetNumberFormat('### ### ### ##0' + xlGetDecimalSeparator + ' 00', firstRow, 6, firstRow + RowNo - 1, 13);
      xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, firstRow - 2, 1, firstRow + RowNo - 1, 13);
      xlAutoFit(1, 1, firstRow + RowNo - 1, 13);

      SubRepLotteryHard();

      xlKillExcel;
      StopVisual;
    }
  }
}

HandleEvent
cmInit:
{
  _year := Year(Cur_Date());
  cfsSetProp('i_SCR1_YEAR', 'Skip', true);
}

cmCheckField:
{
  case CurField of
    #_repType : {
      if (_repType = 0) then {
        cfsSetProp('i_SCR1_YEAR', 'Skip', true);
      }
      else {
        cfsSetProp('i_SCR1_YEAR', 'Skip', false);
      }
    }
  end;
}

cmOk:
{
  if (_log = '') then
    _log := 'Rep_Lottery' + DateToStr(cur_date,'_YYYYMMDD') + TimeToStr(cur_time,'_HHMMSS') + '.log';
  if (_repType = 0) then
  {
    PrintData_Easy();
  }
  else
  {
    PrintData_Hard();
  }

}
End;

End.
