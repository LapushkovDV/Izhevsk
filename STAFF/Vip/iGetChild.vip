Interface iGetChild 'Выбор ребенка сотрудника' (,,sci1EnEsc) Cyan,DoAccept;
show at (,,60,10);

Var
  cPers: comp;
  cChild: comp;

Parameters cPers, cChild;

Create view as
from
  PSNLinks, catalogs
where ((cPers == PSNLinks.fromperson and PSNLInks.linktype == catalogs.nrec )) and catalogs.code = 'ДЕТИ';

Browse B1;
table PSNLinks ;
Fields
    RFIO 'Ребенок' :[40], Protect;
    catalogs.name 'Родство' :[20], Protect;
end;

  HandleEvent
    cmDefault:
    {
       cChild := PSNLinks.nrec;
    };
  End; //HandleEvent
end.
