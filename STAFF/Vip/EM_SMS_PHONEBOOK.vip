#include Query.vih

#doc
EM::PhoneBook
Ведение телефонного справочника
#end

#component "EM"
#include EM_SMS_PHONEBOOK.vih
//************************************************************
Interface SMS_PhoneBook 'Телефонный справочник' (,,sci17EnEsc), EscClose;
//************************************************************
Show At (,,120,30);
//----------------------------------------

Table Struct tPhoneBook
(
     cPers              : comp
   , Fio                : String
   , StrTabn            : String
   , Department         : String
   , Unit               : String
   , Post               : String
   , WorkPhone          : String
   , WorkPhonename      : String
   , WorkPhoneComm      : comp
   , PriemnayaPhone     : String
   , PriemnayaPhonename : String
   , PriemnayaPhoneComm : comp
   , WorkTownPhone      : String
   , WorkTownPhonename  : String
   , WorkTownPhoneComm  : comp
   , MobilePhone        : String
   , MobilePhoneName    : String
   , MobilePhoneComm    : comp
   , MobilePhone2       : String
)
with index
(
  Ind1 = cPers
 ,Ind2 = Fio
)
;

Create View
var
_curRec : comp;
_MainLinkPhones : comp;
 pMarker:IMarker(Marker) new;
as select
 tPhoneBook.cPers
From
    tPhoneBook
  , tPhoneBook tPhoneBookDeleteall
  , COMMUNICATIONS
  , catalogs
;

Function getMainLinkPhones: comp;
{
  result := 0h;
 if getfirst fastfirstrow catalogs where ((-14 == catalogs.syscode)) = tsOK then  result := catalogs.nrec;
}
Function getNrecPhoneByName(_phonename : string) : comp; cacheable;
{
  result := 0h;
  if(getfirst catalogs where ((_MainLinkPhones == catalogs.MainLink (noindex) ))
            and upCase(catalogs.name) = upCase(_phonename)
    ) = tsOK then result := catalogs.nrec;
}
Procedure UpdateCOMMUNICATIONS(_cPers : comp; _Phone,_PhoneName : string; _CommNrec : comp);
{
  if getNrecPhoneByName(_PhoneName) =0h
   {
     Message('не найдено наименование типа телефона "'+_PhoneName +'"', error)
   }
   else
   {
/*
   if(getfirst FastFirstRow COMMUNICATIONS where ((_cPers == COMMUNICATIONS.person
                                                  and   2 == COMMUNICATIONS.OBJTYPE
                       and getNrecPhoneByName(_PhoneName) == COMMUNICATIONS.COMTYPE (noindex) ))
        ) <> tsOK
        {
         if _Phone <> ''
          Insert COMMUNICATIONS
           set  COMMUNICATIONS.person  := _cPers
              , COMMUNICATIONS.OBJTYPE := 2
              , COMMUNICATIONS.COMTYPE := getNrecPhoneByName(_PhoneName)
              , COMMUNICATIONS.addr    := _Phone
              ;
        }
        else
         {
           if _Phone <> ''
            then Update current COMMUNICATIONS set  COMMUNICATIONS.addr := _Phone
            else delete current COMMUNICATIONS;
         }
*/


      if(getfirst FastFirstRow COMMUNICATIONS where ((_CommNrec == COMMUNICATIONS.nrec))
        ) <> tsOK
        {
         if _Phone <> ''
          Insert COMMUNICATIONS
           set  COMMUNICATIONS.person  := _cPers
              , COMMUNICATIONS.OBJTYPE := 2
              , COMMUNICATIONS.COMTYPE := getNrecPhoneByName(_PhoneName)
              , COMMUNICATIONS.addr    := _Phone
              ;
        }
        else
         {
           if _Phone <> ''
            then Update current COMMUNICATIONS set  COMMUNICATIONS.addr := _Phone
            else delete current COMMUNICATIONS;
         }
   }
}
Procedure myLog(_STR : string);
{
  if UpCase(username) = upcase('lapushkov_dv')
   {
     LogStrtofile('_PhoneBookQuery.log',DateToStr(cur_date,'YYYY-MM-DD')+'_'+timetostr(Cur_time,'HH:MM:SS')+': '+_STR);
   }
}
procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  MyLog(add_query_str);
}

Procedure LoadtPhoneBook;
{
  if Isvalid(tntPhoneBook)
  {
    UpdateCOMMUNICATIONS(tPhoneBook.cPers, tPhoneBook.WorkPhone     , tPhoneBook.WorkPhonename, tPhoneBook.WorkPhoneComm);
    UpdateCOMMUNICATIONS(tPhoneBook.cPers, tPhoneBook.PriemnayaPhone, tPhoneBook.PriemnayaPhonename, tPhoneBook.PriemnayaPhoneComm);
    UpdateCOMMUNICATIONS(tPhoneBook.cPers, tPhoneBook.WorkTownPhone , tPhoneBook.WorkTownPhonename, tPhoneBook.WorkTownPhoneComm);
    if matchesmask(tPhoneBook.MobilePhone,coMask_MobilePhone)
       then UpdateCOMMUNICATIONS(tPhoneBook.cPers, tPhoneBook.MobilePhone   , tPhoneBook.MobilePhonename, tPhoneBook.MobilePhoneComm);
  }
  Delete all tPhoneBookDeleteall;
   var hstr : longint = 0;
MysqlAddStr(hstr, '    select                                ');
MysqlAddStr(hstr, '           Pers.Nrec as cPers             ');
MysqlAddStr(hstr, '         , Pers.FIO as Fio                ');
MysqlAddStr(hstr, '         , Pers.StrTabn as StrTabn        ');
MysqlAddStr(hstr, '         , case when length(KP.code) = 3 then KP.code else KpParent.code end as Department');
MysqlAddStr(hstr, '         , case when length(KP.code) = 3 then '''' else KP.code end as Unit                 ');
MysqlAddStr(hstr, '         , post.Name as Post                                                              ');
MysqlAddStr(hstr, '         , WorkPhone.Phone          as WorkPhone                                          ');
MysqlAddStr(hstr, '         , '''+coWorkPhonename+'''          as WorkPhonename                              ');
MysqlAddStr(hstr, '         , WorkPhone.nrec          as WorkPhoneComm                                          ');
MysqlAddStr(hstr, '         , PriemnayaPhone.Phone     as PriemnayaPhone                                     ');
MysqlAddStr(hstr, '         , '''+coPriemnayaPhonename+'''     as PriemnayaPhonename                         ');
MysqlAddStr(hstr, '         , PriemnayaPhone.nrec     as PriemnayaPhoneComm                                     ');
MysqlAddStr(hstr, '         , WorkTownPhone.Phone      as WorkTownPhone                                      ');
MysqlAddStr(hstr, '         , '''+coWorkTownPhonename+'''      as WorkTownPhonename                          ');
MysqlAddStr(hstr, '         , WorkTownPhone.nrec      as WorkTownPhoneComm                                      ');
MysqlAddStr(hstr, '         , MobilePhone.Phone         as MobilePhone                                       ');
MysqlAddStr(hstr, '         , '''+coMobilePhone+'''          as MobilePhoneName                              ');
MysqlAddStr(hstr, '         , MobilePhone.nrec         as MobilePhoneComm                                       ');
MysqlAddStr(hstr, '         , MobilePhone.Phone         as MobilePhone2                                      ');
MysqlAddStr(hstr, '     from  PERSONS pers                                                                   ');
MysqlAddStr(hstr, '        left join Catalogs KP       on pers.Department = kp.nrec                          ');
MysqlAddStr(hstr, '        left join Catalogs KPParent on KPParent.nrec = kp.cparent                         ');
MysqlAddStr(hstr, '        left join appointments app  on (Pers.appointCur = app.nrec)                       ');
MysqlAddStr(hstr, '        left join Catalogs Post     on app.post = post.nrec                               ');
MysqlAddStr(hstr, '        left Join (     select coalesce(com.addr,'''') as Phone, com.person as cPers, phone.name as phonename,com.nrec ');
MysqlAddStr(hstr, '                          from  COMMUNICATIONS com                                                         ');
MysqlAddStr(hstr, '                                left join Catalogs phone on( com.COMTYPE = Phone.nrec)                     ');
MysqlAddStr(hstr, '                         where com.OBJTYPE = 2                                                             ');
MysqlAddStr(hstr, '                      and   phone.name = '''+coWorkPhonename+'''                                              ');
MysqlAddStr(hstr, '                  ) as WorkPhone on WorkPhone.cPers = pers.nrec                                            ');
MysqlAddStr(hstr, '        left Join (     select coalesce(com.addr,'''') as Phone, com.person as cPers, phone.name as phonename, com.nrec');
MysqlAddStr(hstr, '                          from  COMMUNICATIONS com                                                         ');
MysqlAddStr(hstr, '                                left join Catalogs phone on( com.COMTYPE = Phone.nrec)                     ');
MysqlAddStr(hstr, '                         where com.OBJTYPE = 2                                                             ');
MysqlAddStr(hstr, '                      and   phone.name = '''+coPriemnayaPhonename +'''                                     ');
MysqlAddStr(hstr, '                  ) as PriemnayaPhone on PriemnayaPhone.cPers = pers.nrec                                  ');
MysqlAddStr(hstr, '        left Join (     select coalesce(com.addr,'''') as Phone, com.person as cPers, phone.name as phonename, com.nrec');
MysqlAddStr(hstr, '                          from  COMMUNICATIONS com                                                         ');
MysqlAddStr(hstr, '                                left join Catalogs phone on( com.COMTYPE = Phone.nrec)                     ');
MysqlAddStr(hstr, '                         where com.OBJTYPE = 2                                                             ');
MysqlAddStr(hstr, '                      and  phone.name = '''+coWorkTownPhonename+'''                                         ');
MysqlAddStr(hstr, '                  ) as WorkTownPhone on WorkTownPhone.cPers = pers.nrec                                    ');
MysqlAddStr(hstr, '        left Join (     select coalesce(com.addr,'''') as Phone, com.person as cPers, phone.name as phonename, com.nrec');
MysqlAddStr(hstr, '                          from  COMMUNICATIONS com                                                         ');
MysqlAddStr(hstr, '                                left join Catalogs phone on( com.COMTYPE = Phone.nrec)                     ');
MysqlAddStr(hstr, '                         where com.OBJTYPE = 2                                                             ');
MysqlAddStr(hstr, '                      and   phone.name = '''+coMobilePhone+'''                                              ');
MysqlAddStr(hstr, '                  ) as MobilePhone on MobilePhone.cPers = pers.nrec                                         ');
MysqlAddStr(hstr, '  where pers.isEmployee = ''С''                                                                             ');
MysqlAddStr(hstr, '  and ( pers.disDate = 0 or pers.disdate >= #date('+datetostr(Cur_date,'DD,MM,YYYY') +'))                    ');
MysqlAddStr(hstr, '  and coalesce(KP.code,'''') <> ''''                                                                        ');

    var objQuery: iQuery;
      objQuery := queryManager.createQuery(hstr);
   delete all tPhoneBookDeleteall;
    if objQuery.execute.errorCode != tsOk
     then {MyLog('Ошибка выполнения запроса '+ objQuery.errorCode);
           exit;
          }
        else
        {sqlCopyInto(objQuery, tntPhoneBookDeleteall, true);
        }

   _loop tPhoneBookDeleteall
    {
     if not matchesmask(tPhoneBookDeleteall.MobilePhone,coMask_MobilePhone)
      then update current tPhoneBookDeleteall set tPhoneBookDeleteall.MobilePhone  := ''
      else update current tPhoneBookDeleteall set tPhoneBookDeleteall.MobilePhone2 := 'OK';
    }
   if getfirst tPhoneBook where ((_curRec == tPhoneBook.cPers)) = tsOK {}
ReScanPanel(#tPhoneBook);
}


Window winSelectPersons 'Выбор сотрудников с мобильными телефонами', DoAccept;
show at (,,,15);
Browse brSelectPersons 'Выберите сотрудников' (,,sci1Esc);
//show at (,,,15);
Table tPhoneBook;
recMarker=pMarker;
 FIELDS
  tPhoneBook.StrTabn             'Табельный' ('Табельный номер сотрудника')                     : [3] ,Protect,NoDel;
  tPhoneBook.Fio                 'ФИО' ('ФИО')                     : [10] ,Protect,NoDel;
  tPhoneBook.Department          'Подразделение' ('Подразделение') : [3] ,Protect,NoDel;
  tPhoneBook.Unit                'Отдел' ('Отдел')                 : [4] ,Protect,NoDel;
  tPhoneBook.Post                'Должность' ('Должность')         : [6] ,Protect,NoDel;
//  tPhoneBook.WorkPhone           'Рабочий телефон' ('Рабочий внутренний телефон') : [8] ,Protect;
//  tPhoneBook.PriemnayaPhone      'Приемная телефон' ('Приемная телефон')          : [8] ,Protect;
//  tPhoneBook.WorkTownPhone       'Рабочий городской телефон' ('Рабочий городской телефон') : [8] ,Protect;
  tPhoneBook.MobilePhone         'Мобильный телефон'  ('Мобильный телефон если по маске') : [8] , Protect;
  tPhoneBook.MobilePhone2        'Мобильный телефон','Текущее состояние' ('Мобильный телефон - как сейчас введено в БД') : [8], Protect
                                                 , { Font = { BackColor = if(tPhoneBook.MobilePhone2 <> 'OK', ColorError, 0) }};
//  matchesmask(tPhoneBook.MobilePhone,'+7([0~9][0~9][0~9])[0~9][0~9][0~9]-[0~9][0~9][0~9][0~9]')
end;//Browse
handleevent
cminit:
{
  pMarker.UnselectAll;
}
end;
end;

Window winPhoneBook;
show at (,,,15);
Browse brPhoneBook 'Телефонный справочник' (,,sci1Esc);
//show at (,,,15);
Table tPhoneBook;
 FIELDS
  tPhoneBook.StrTabn             'Табельный' ('Табельный номер сотрудника')                     : [3] ,Protect,NoDel;
  tPhoneBook.Fio                 'ФИО' ('ФИО')                     : [10] ,Protect,NoDel;
  tPhoneBook.Department          'Подразделение' ('Подразделение') : [3] ,Protect,NoDel;
  tPhoneBook.Unit                'Отдел' ('Отдел')                 : [4] ,Protect,NoDel;
  tPhoneBook.Post                'Должность' ('Должность')         : [6] ,Protect,NoDel;
  tPhoneBook.WorkPhone           'Рабочий телефон' ('Рабочий внутренний телефон') : [4] ,NoProtect;
  tPhoneBook.PriemnayaPhone      'Приемная телефон' ('Приемная телефон')          : [4] ,NoProtect;
  tPhoneBook.WorkTownPhone       'Рабочий городской телефон' ('Рабочий городской телефон') : [8] ,NoProtect;
  tPhoneBook.MobilePhone         'Мобильный телефон','Маска' ('Мобильный телефон') : [8] ,{ inputmask = '"+7"(999)999"-"9999' }, NoProtect;
  tPhoneBook.MobilePhone2        'Мобильный телефон','Текущее состояние' ('Мобильный телефон - как сейчас введено в БД') : [8], Protect
                                                 , { Font = { BackColor = if(tPhoneBook.MobilePhone2 <> 'OK', ColorError, 0) }};
end;//Browse
end;
//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table tPhoneBook;
cmCheckField:
{
  UpdateTable;
}
cmUpdateRecord:
{
  _curRec := tPhoneBook.cPers;
  Update Current tPhoneBook;
  LoadtPhoneBook;
}
cmPositionChanged:
{
 UpdateTable;
}
end; //GP_SCUD_Doc

//------------------------------
Procedure WorkWithPhoneBook(_pShowMobile : boolean);
{
  _MainLinkPhones := getMainLinkPhones;
  if _MainLinkPhones = 0h then
  {
   Message('Нет справочника "Виды коммуникаций"', error);
   stop; abort; exit;
  }
  _curRec := 0h;
  LoadtPhoneBook;
  SetFieldState(#tPhoneBook.WorkPhone     , sfVisible);
  SetFieldState(#tPhoneBook.PriemnayaPhone, sfVisible);
  SetFieldState(#tPhoneBook.WorkTownPhone , sfVisible);
  if _pShowMobile
   then
    {
      SetFieldState(#tPhoneBook.MobilePhone, sfVisible);
      SetFieldState(#tPhoneBook.MobilePhone2, sfVisible);
    }
   else
    {
      ClearFieldState(#tPhoneBook.MobilePhone,sfVisible);
      ClearFieldState(#tPhoneBook.MobilePhone2,sfVisible);
    }

  RunWindow(winPhoneBook);
}

Procedure WorkWithMobilePhones;
{
  _MainLinkPhones := getMainLinkPhones;
  if _MainLinkPhones = 0h then
  {
   Message('Нет справочника "Виды коммуникаций"', error);
   stop; abort; exit;
  }
  _curRec := 0h;
  LoadtPhoneBook;
    ClearFieldState(#tPhoneBook.WorkPhone     , sfVisible);
    ClearFieldState(#tPhoneBook.PriemnayaPhone, sfVisible);
    ClearFieldState(#tPhoneBook.WorkTownPhone , sfVisible);
      SetFieldState(#tPhoneBook.MobilePhone   , sfVisible);
      SetFieldState(#tPhoneBook.MobilePhone2  , sfVisible);

  RunWindow(winPhoneBook);
}

Function SelectPersonsWithPhones(var _pMarkerName : string) : boolean;;
{
  _MainLinkPhones := getMainLinkPhones;
  if _MainLinkPhones = 0h then
  {
   Message('Нет справочника "Виды коммуникаций"', error);
   stop; abort; exit;
  }
  _curRec := 0h;
  LoadtPhoneBook;
  SetFieldState(#tPhoneBook.MobilePhone, sfVisible);
  result := false;
  if RunWindowModal(winSelectPersons) <> cmCancel
   {
     if _pMarkerName = '' then _pMarkerName := '_SMS_PhoneBook_' + UserName();
     var _tmpMarker : longint = InitMarker(_pMarkerName, 8, 50, 10);
     DoneMarker(_tmpMarker,_pMarkerName);
     pMarker.ExportToName(_pMarkerName);
     Result := true;
   }
}
//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
HandleEvent
end;
end.


Interface PhoneBook;
create view
var
 iSMS_PhoneBook : SMS_PhoneBook new;
;
handleevent
cminit:
{
 iSMS_PhoneBook.WorkWithPhoneBook(false);
 stop;abort;exit;
}
end;
end.

Interface MobilePhones;
create view
var
 iSMS_PhoneBook : SMS_PhoneBook new;
;
handleevent
cminit:
{
 iSMS_PhoneBook.WorkWithMobilePhones;
 stop;abort;exit;
}
end;
end.
