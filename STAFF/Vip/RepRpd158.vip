/*************************************************************************************************\
  Наименование:  Отчет по кадровым перестановкам
  Контур/Модуль: Staff
  Вид работы  |Номер           |Дата    |Исполнитель              |Проект
  -----------------------------------------------------------------------------------------------
  Разработка  |#NaN            |23/04/24|kurennykh                |НПО Энергомаш
\************************************************************************************************/

#include Query.vih
#include GetKau.vih
#include GetKau.var

VipInterface RepRpd158 Licensed(free) Parameters (wTypeReport: word; _wTypeRun: word);

Interface RepRpd158 'Отчет по кадровым перестановкам' EscClose;
Show At(,,65,9);

Table Struct tRep
(
    dDoc          : date
  , sDoc          : string
  , sFioOld       : string
  , sPostOld      : string
  , sPodrKodOld   : string
  , sPodrNameOld  : string
  , sFioNew       : string
  , sPostNew      : string
  , sPodrKodNew   : string
  , sPodrNameNew  : string
  , cPostNew      : comp
  , cPostOld      : comp
  , cPodrNew      : comp
  , cPodrOld      : comp

)
With Index
(
    i01 = sDoc
);

Create View

var
  _log      : string = '';
  _FileName : string = 'Кадровые перестановки';
  sCodeTune : string = 'NPOEM_OWN.REPORTS.REP158915.ACCESS';
  _dBeg     : date;
  _dEnd     : date;
  _wTypeRun : word;
  mPost, mDept : LongInt;
  wTypeReport : word;
As

select
  1
from
  tRep
, Em_UniDoc_Head UniDoc
, Em_UniDic UniDic
, Catalogs
, Em_UniDoc_Head UniDocEmail
, Em_UniDic UniDicEmail
, Persons Pers
, Communications
where
((
        158         == UniDoc.wType
    and 158         == UniDic.wType
    and UniDoc.nRec == UniDic.cParent (noIndex)

    and 159         == UniDocEmail.wType
    and 159         == UniDicEmail.wType
    and UniDocEmail.nRec == UniDicEmail.cParent (noIndex)
))
;
Parameters
  wTypeReport, // 0 - интерактивный режим, 1 - авто ежемесячный, 2 - авто ежедневный
  _wTypeRun;   // фильтр ON/OFF

Procedure MyLog(_str: string);
{
  if _log = '' then _log := 'RepRpd158' + DateToStr(cur_date,'_YYYYMMDD') + timetostr(cur_time,'_HHMMSS') + '.log';
  LogStrToFile(_log, _str);
}

Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  MyLog('sql: ' + add_query_str);
}

Function MakeData1() : LongInt;
{
  var qStr : longint = 0;

  StartNewVisual(vtRotateVisual, vfTimer, 'Обработка приказов по персоналу', 0);
  sqlFreeStr(qStr);

  MysqlAddStr(qStr, '    select																																					                                                                          ');
  MysqlAddStr(qStr, '        td.docdate                                                                                                              as dDoc                      ');
  MysqlAddStr(qStr, '      , ''Приказ (прием)'' +  td.docnmb                                                                                         as sDoc                      ');
  MysqlAddStr(qStr, '      , ''''                                                                                                                    as sFioOld                   ');
  MysqlAddStr(qStr, '      , ''''                                                                                                                    as sPostOld                  ');
  MysqlAddStr(qStr, '      , ''''                                                                                                                    as sPodrKodOld               ');
  MysqlAddStr(qStr, '      , ''''                                                                                                                    as sPodrNameOld              ');
  MysqlAddStr(qStr, '      , persons.fio                                                                                                             as sFioNew                   ');
  MysqlAddStr(qStr, '      , catpost.name                                                                                                            as sPostNew                  ');
  MysqlAddStr(qStr, '      , CatDep.code                                                                                                             as sPodrKodNew               ');
  MysqlAddStr(qStr, '      , case when length(CatDep.Code) = 3 then CatDep.NAME                                                                                                   ');
  MysqlAddStr(qStr, '             else CatDep.NAME + '' / '' + (select NAME from CATALOGS where CATALOGS.NREC = CatDep.CPARENT)                                                   ');
  MysqlAddStr(qStr, '        end                                                                                                                     as sPodrNameNew              ');
  MysqlAddStr(qStr, '      , catpost.nrec                                                                                                            as cPostNew                  ');
  MysqlAddStr(qStr, '      , #comp(0h)                                                                                                               as cPostOld                  ');
  MysqlAddStr(qStr, '      , CatDep.nrec                                                                                                             as cPodrNew                  ');
  MysqlAddStr(qStr, '      , #comp(0h)                                                                                                               as cPodrOld                  ');
  MysqlAddStr(qStr, '                                                                                                                                                             ');
  MysqlAddStr(qStr, '    from titledoc td                                                                                                                                         ');
  MysqlAddStr(qStr, '      join partdoc pd on pd.CDOC=td.nrec                                                                                                                     ');
  MysqlAddStr(qStr, '      join contdoc cd on cd.CPART=pd.nrec                                                                                                                    ');
  MysqlAddStr(qStr, '      join persons on cd.person=persons.nrec                                                                                                                 ');
  MysqlAddStr(qStr, '      join Catalogs CatDep on CatDep.Nrec = cd.cDopRef                                                                                                       ');
  MysqlAddStr(qStr, '      left join appointments app1 on cd.nrec = app1.ccont                                                                                                    ');
  MysqlAddStr(qStr, '      left join appointments app2 on persons.appointcur = app2.nrec                                                                                          ');
  MysqlAddStr(qStr, '      join appointments app on coalesce(app1.nrec, app2.nrec) = app.nrec                                                                                     ');
  MysqlAddStr(qStr, '      join catalogs catpost on app.post = catpost.nrec                                                                                                       ');
  MysqlAddStr(qStr, '      where     cd.typeoper = 1                                                                                                                              ');
  MysqlAddStr(qStr, '            and td.docdate between #date(' + Day(_dBeg) + ', ' + Month(_dBeg) + ', ' + Year(_dBeg) + ')                                                      ');
  MysqlAddStr(qStr, '                               and #date(' + Day(_dEnd) + ', ' + Month(_dEnd) + ', ' + Year(_dEnd) + ')                                                      ');
  MysqlAddStr(qStr, '                                                                                                                                                             ');
  MysqlAddStr(qStr, '      union all                                                                                                                                              ');
  MysqlAddStr(qStr, '                                                                                                                                                             ');
  MysqlAddStr(qStr, '      select                                                                                                                                                 ');
  MysqlAddStr(qStr, '        td.docdate                                                                                                              as dDoc                      ');
  MysqlAddStr(qStr, '      , ''Приказ (увольнение)'' +  td.docnmb                                                                                    as sDoc                      ');
  MysqlAddStr(qStr, '      , persons.fio                                                                                                             as sFioOld                   ');
  MysqlAddStr(qStr, '      , catpost.name                                                                                                            as sPostOld                  ');
  MysqlAddStr(qStr, '      , CatDep.code                                                                                                             as sPodrKodOld               ');
  MysqlAddStr(qStr, '      , case when length(CatDep.Code) = 3 then CatDep.NAME                                                                                                   ');
  MysqlAddStr(qStr, '             else  CatDep.NAME + '' / '' + (select NAME from CATALOGS where CATALOGS.NREC = CatDep.CPARENT)                                                  ');
  MysqlAddStr(qStr, '        end                                                                                                                     as sPodrNameOld              ');
  MysqlAddStr(qStr, '      , ''''                                                                                                                    as sFioNew                   ');
  MysqlAddStr(qStr, '      , ''''                                                                                                                    as sPostNew                  ');
  MysqlAddStr(qStr, '      , ''''                                                                                                                    as sPodrKodNew               ');
  MysqlAddStr(qStr, '      , ''''                                                                                                                    as sPodrNameNew              ');
  MysqlAddStr(qStr, '      , #comp(0h)                                                                                                               as cPostNew                  ');
  MysqlAddStr(qStr, '      , catpost.nrec                                                                                                            as cPostOld                  ');
  MysqlAddStr(qStr, '      , #comp(0h)                                                                                                               as cPodrNew                  ');
  MysqlAddStr(qStr, '      , CatDep.nrec                                                                                                             as cPodrOld                  ');
  MysqlAddStr(qStr, '                                                                                                                                                             ');
  MysqlAddStr(qStr, '      from titledoc td                                                                                                                                       ');
  MysqlAddStr(qStr, '      join partdoc pd on pd.CDOC=td.nrec                                                                                                                     ');
  MysqlAddStr(qStr, '      join contdoc cd on cd.CPART=pd.nrec                                                                                                                    ');
  MysqlAddStr(qStr, '      join persons on cd.person=persons.nrec                                                                                                                 ');
  MysqlAddStr(qStr, '      join Catalogs CatDep on CatDep.Nrec = cd.cDopRef                                                                                                       ');
  MysqlAddStr(qStr, '      join appointments app on persons.appointlast = app.nrec                                                                                                ');
  MysqlAddStr(qStr, '      join catalogs catpost on app.post = catpost.nrec                                                                                                       ');
  MysqlAddStr(qStr, '      where     cd.typeoper = 8                                                                                                                              ');
  MysqlAddStr(qStr, '            and td.docdate between #date(' + Day(_dBeg) + ', ' + Month(_dBeg) + ', ' + Year(_dBeg) + ')                                                      ');
  MysqlAddStr(qStr, '                               and #date(' + Day(_dEnd) + ', ' + Month(_dEnd) + ', ' + Year(_dEnd) + ')                                                      ');
  MysqlAddStr(qStr, '                                                                                                                                                             ');
  MysqlAddStr(qStr, '      union all                                                                                                                                              ');
  MysqlAddStr(qStr, '                                                                                                                                                             ');
  MysqlAddStr(qStr, '      select                                                                                                                                                 ');
  MysqlAddStr(qStr, '        td.docdate                                                                                                              as dDoc                      ');
  MysqlAddStr(qStr, '      , ''Приказ '' + case when AN.DATEEND = 0 then ''(постоянный перевод) ''                                                                                ');
  MysqlAddStr(qStr, '                           else ''(временный перевод) ''                                                                                                     ');
  MysqlAddStr(qStr, '                      end + td.docnmb                                                                                           as sDoc                      ');
  MysqlAddStr(qStr, '      , A.Fio                                                                                                                   as sFioOld                   ');
  MysqlAddStr(qStr, '      , PostPrev.name                                                                                                           as sPostOld                  ');
  MysqlAddStr(qStr, '      , DepPrev.Code                                                                                                            as sPodrKodOld               ');
  MysqlAddStr(qStr, '      , case when length(DepPrev.Code) = 3 then DepPrev.NAME                                                                                                 ');
  MysqlAddStr(qStr, '             else  DepPrev.NAME + '' / '' + (select NAME from CATALOGS where CATALOGS.NREC = DEPPREV.CPARENT)                                                ');
  MysqlAddStr(qStr, '        end                                                                                                                     as sPodrNameOld              ');
  MysqlAddStr(qStr, '      , A.Fio                                                                                                                   as sFioNew                   ');
  MysqlAddStr(qStr, '      , PostNext.name                                                                                                           as sPostNew                  ');
  MysqlAddStr(qStr, '      , DepNext.code                                                                                                            as sPodrKodNew               ');
  MysqlAddStr(qStr, '      , case when length(DepNext.Code) = 3 then DepNext.NAME                                                                                                 ');
  MysqlAddStr(qStr, '             else DepNext.NAME + '' / '' + (select NAME from CATALOGS where CATALOGS.NREC = DepNext.CPARENT)                                                 ');
  MysqlAddStr(qStr, '        end                                                                                                                     as sPodrNameNew              ');
  MysqlAddStr(qStr, '      , PostNext.nrec                                                                                                           as cPostNew                  ');
  MysqlAddStr(qStr, '      , PostPrev.nrec                                                                                                           as cPostOld                  ');
  MysqlAddStr(qStr, '      , DepNext.nrec                                                                                                            as cPodrNew                  ');
  MysqlAddStr(qStr, '      , DepPrev.nrec                                                                                                            as cPodrOld                  ');
  MysqlAddStr(qStr, '      from (                                                                                                                                                 ');
  MysqlAddStr(qStr, '                select                                                                                                                                       ');
  MysqlAddStr(qStr, '                  A.NREC                                                                          as nrec                                                    ');
  MysqlAddStr(qStr, '                , A.PERSON                                                                        as person                                                  ');
  MysqlAddStr(qStr, '                , P.FIO                                                                           as fio                                                     ');
  MysqlAddStr(qStr, '                , A.STRTABN                                                                       as Tabn                                                    ');
  MysqlAddStr(qStr, '                , A.APPOINTDATE                                                                   as APPOINTDATE                                             ');
  MysqlAddStr(qStr, '                , A.DISMISSDATE                                                                   as DISMISSDATE                                             ');
  MysqlAddStr(qStr, '                , A.Department                                                                    as Department                                              ');
  MysqlAddStr(qStr, '                , A.TaxRate                                                                       as taxRate                                                 ');
  MysqlAddStr(qStr, '                , A.Post                                                                          as Post                                                    ');
  MysqlAddStr(qStr, '                , A.KindApp                                                                       as KindApp                                                 ');
  MysqlAddStr(qStr, '                , ( select Max(SA.NREC)                                                                                                                      ');
  MysqlAddStr(qStr, '                    from APPOINTMENTS SA                                                                                                                     ');
  MysqlAddStr(qStr, '                    where SA.PERSON = A.PERSON                                                                                                               ');
  MysqlAddStr(qStr, '                          and sa.lprizn = A.LPRIZN                                                                                                           ');
  MysqlAddStr(qStr, '                          and SA.APPOINTDATE = (( select min(APPOINTDATE)                                                                                    ');
  MysqlAddStr(qStr, '                                                  from APPOINTMENTS SSA                                                                                      ');
  MysqlAddStr(qStr, '                                                  where SSA.PERSON = A.PERSON                                                                                ');
  MysqlAddStr(qStr, '                                                        and ssa.lprizn = A.LPRIZN                                                                            ');
  MysqlAddStr(qStr, '                                                        and SSA.APPOINTDATE > A.APPOINTDATE                                                                  ');
  MysqlAddStr(qStr, '                                                  group by SSA.PERSON))                                                                                      ');
  MysqlAddStr(qStr, '                  )                                                                               as NEXTAPPOINTREC                                          ');
  MysqlAddStr(qStr, '                from APPOINTMENTS A                                                                                                                          ');
  MysqlAddStr(qStr, '                join  PERSONS P on A.PERSON = p.nrec                                                                                                         ');
  MysqlAddStr(qStr, '                where A.LPRIZN = 0                                                                                                                           ');
  MysqlAddStr(qStr, '      ) A                                                                                                                                                    ');
  MysqlAddStr(qStr, '      join APPOINTMENTS AN   on A.NEXTAPPOINTREC = AN.NREC                                                                                                   ');
  MysqlAddStr(qStr, '      join Catalogs DepPrev  on A.Department = DepPrev.nrec                                                                                                  ');
  MysqlAddStr(qStr, '      join Catalogs DepNext  on AN.Department = DepNext.nrec                                                                                                 ');
  MysqlAddStr(qStr, '      join Catalogs PostPrev on A.post = PostPrev.nrec                                                                                                       ');
  MysqlAddStr(qStr, '      join Catalogs PostNext on AN.post = PostNext.nrec                                                                                                      ');
  MysqlAddStr(qStr, '      join contdoc on an.ccont = contdoc.nrec                                                                                                                ');
  MysqlAddStr(qStr, '      join partdoc on contdoc.CPART = partdoc.nrec                                                                                                           ');
  MysqlAddStr(qStr, '      join titledoc td on partdoc.CDOC = td.nrec                                                                                                             ');
  MysqlAddStr(qStr, '                                                                                                                                                             ');
  MysqlAddStr(qStr, '      where       td.docdate between #date(' + Day(_dBeg) + ', ' + Month(_dBeg) + ', ' + Year(_dBeg) + ')                                                    ');
  MysqlAddStr(qStr, '                                 and #date(' + Day(_dEnd) + ', ' + Month(_dEnd) + ', ' + Year(_dEnd) + ')                                                    ');
  MysqlAddStr(qStr, '              and (                                                                                                                                          ');
  MysqlAddStr(qStr, '                        A.Department <> AN.Department                                                                                                        ');
  MysqlAddStr(qStr, '                     or A.Post <> AN.Post                                                                                                                    ');
  MysqlAddStr(qStr, '                     or A.KindApp <> AN.KindApp                                                                                                              ');
  MysqlAddStr(qStr, '              )                                                                                                                                              ');
  MysqlAddStr(qStr, '              and contdoc.typeoper = 5                                                                                                                       ');

  var objQuery : iQuery;
      objQuery := queryManager.createQuery(qStr);

  if (objQuery.execute.errorCode != tsOk) then
  {
    Message('Ошибка формирования (MakeData1) ' + objQuery.errorCode, Error);
    result := 0;
  }
  else
  {
    sqlCopyInto(objQuery, tntRep, true);

    if (_wTypeRun = 1) then
    {
      if (getFirst FastFirstRow UniDoc where ((158 == UniDoc.wType)) = tsOk) then
      {
        _Loop tRep
        {
          if (getFirst FastFirstRow UniDoc where ((158 == UniDoc.wType and tRep.cPostNew == UniDoc.AddComp[1] (noIndex))) <> tsOk) then
          {
            if (getFirst FastFirstRow UniDoc where ((158 == UniDoc.wType and tRep.cPostOld == UniDoc.AddComp[1] (noIndex))) <> tsOk) then
            {
              Delete Current tRep;
            }
          }
        }

        _Loop tRep
        {
          MyLog(tRep.sPodrKodNew + ' | ' + tRep.sPostNew + ' | ');
          if (getFirst FastFirstRow UniDoc where ((158 == UniDoc.wType and tRep.cPostNew == UniDoc.AddComp[1] (noIndex))) = tsOk) then
          {
            if (getFirst FastFirstRow UniDic where ((158 == UniDic.wType and UniDoc.nRec == UniDic.cParent (noIndex))) = tsOk) then
            {
              _Loop UniDic where ((158 == UniDic.wType and UniDoc.nRec == UniDic.cParent (noIndex)))
              {
                if (UniDic.AddComp[1] = tRep.cPodrNew) then
                {
                  Continue;
                }
              }
            }
            else
              Continue;
          }
          if (getFirst FastFirstRow UniDoc where ((158 == UniDoc.wType and tRep.cPostOld == UniDoc.AddComp[1] (noIndex))) = tsOk) then
          {
            if (getFirst FastFirstRow UniDic where ((158 == UniDic.wType and UniDoc.nRec == UniDic.cParent (noIndex))) = tsOk) then
            {
              _Loop UniDic where ((158 == UniDic.wType and UniDoc.nRec == UniDic.cParent (noIndex)))
              {
                if (UniDic.AddComp[1] = tRep.cPodrOld) then
                {
                  Continue;
                }
              }
            }
            else
              Continue;
          }
          Delete Current tRep;
        }
      }
    }

    result := RecordsInTable(tntRep);
  }

  sqlFreeStr(qStr);
  StopVisual;
}

Procedure LoadToXlsx1(j : LongInt);
{
  var OutputFilesDirectory: string = GetStringParameter('Files','OutputFilesDirectory',0);
  var outputReportFilePath: string = OutputFilesDirectory + _FileName + DateToStr(cur_date,'_YYYYMMDD')+'.XLSX';
  if fileexist(outputReportFilePath) deletefile(outputReportFilePath);
  if (not xlCreateExcel(outputReportFilePath, true)) then
  {
    Message('Ошибка создания нового файла Excel" ' + _FileName + '"', Error);
    Exit;
  }
  else
  {
    StartNewVisual(vtNumericVisual, vfTimer, 'Выгрузка отчета в Excel', 0);
    var RowNo : longint = 1;
    var ColNo : longint = 1;
    var j, i : longint = 0;
    var dIn, dOut, dDt, dKt : double = 0.0;


    if (xlIsExcelValid) then
    {
      xlSetActiveWorkBookByName(outputReportFilePath);
    }

    xlSetCellStringValue('АО "НПО Энергомаш им. ак. В.П. Глушко"', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlItalic, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo, ColNo + 9);
    xlAlignCellsEx(xlRight, xlCenter, RowNo, ColNo, RowNo, ColNo + 9);

    RowNo++;
    RowNo++;

    xlSetCellStringValue('Отчет по кадровым перестановкам за период с ' + DateToStr(_dBeg, 'DD.MM.YYYY') + ' по ' + DateToStr(_dEnd, 'DD.MM.YYYY'), RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo, ColNo + 9);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo + 9);

    RowNo++;
    RowNo++;

    ColNo := 1;
    RowNo++;

    xlSetCellStringValue('Дата изменения', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo + 1, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Основание изменения', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo + 1, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Было', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo, ColNo + 3);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    RowNo++;

    xlSetCellStringValue('ФИО', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Должность', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Индекс подразделения', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Наименование подразделения', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;
    RowNo--;

    xlSetCellStringValue('Стало', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlMergeCells(RowNo, ColNo, RowNo, ColNo + 3);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    RowNo++;

    xlSetCellStringValue('ФИО', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Должность', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Индекс подразделения', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);
    ColNo++;

    xlSetCellStringValue('Наименование подразделения', RowNo, ColNo, RowNo, ColNo);
    xlSetFontStyle(xlBold, RowNo, ColNo, RowNo, ColNo);
    xlAlignCellsEx(xlCenter, xlCenter, RowNo, ColNo, RowNo, ColNo);

    i := 0;
    j := RecordsInTable(#tRep);

    RowNo++;

    var firstRow : longint = RowNo;

    xlCreateMatrix(j, 10);
    RowNo := 0;

    _Loop tRep
    {
      ColNo := 0;

      xlDtWriteToMatrix(++RowNo, ++ColNo,           tRep.dDoc                         );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sDoc                         );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sFioOld                      );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sPostOld                     );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sPodrKodOld                  );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sPodrNameOld                 );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sFioNew                      );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sPostNew                     );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sPodrKodNew                  );
      xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + tRep.sPodrNameNew                 );
      i++;

      SetVisualHeader('Напечатано'#13 +
                       i + ' / ' + j);
    }

    XLWRITEMATRIXTOEXCEL(firstRow, 1);
    XLFREEMATRIX;

    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, 6, 1, firstRow + RowNo - 1, ColNo);
    xlAutoFit(1, 1, firstRow + RowNo - 1, ColNo);

    if (wTypeReport <> 0) xlSetAppVisibleMode(false);
    xlSaveWorkBookByName(outputReportFilePath);
    xlCloseWorkBook(outputReportFilePath);
    xlKillExcel;
    StopVisual;
  }

}

Procedure MakeRep1();
{
  Delete All tRep;

  var _k : LongInt = 0;

  _k := MakeData1();

  if (_k = 0) then
  {
    if (wTypeReport = 0) Message('Нет данных для построения отчета');
    Exit;
  }

  LoadToXlsx1(_k);
}

Procedure AsSetDefaultDoc;
{
  if (boGetTune(sCodeTune) = true) then
  {
    ClearBuffer(#UniDoc);
      UniDoc.nRec := 0h;
      UniDoc.wType := 158;
      UniDoc.wParentTable := 158;
    Insert Current UniDoc;
    SetNew(false);
  }
  else
  {
    Message('Вы не имеете права редактировать настройки отчета '#13 +
             GetTuneName(sCodeTune), Error);
    Abort;
  }
}

Procedure AsSetDefaultDic;
{
  ClearBuffer(#UniDic);
    UniDic.nRec := 0h;
    UniDic.wType := 158;
    UniDic.cParent := UniDoc.nRec;
  Insert Current UniDic;
  SetNew(false);
}

Window winPodr 'Выбор подразделений' EscClose, Cyan;
Browse brPodr 'Настройка подразделений' (,,Sci178Esc);
Show At (,,,);

Table UniDic;

Fields
  UniDic.AddString[1]     'Код'                     ('Код'          ,,sci178) : Protect, PickButton;
  UniDic.AddString[2]     'Подразделение'           ('Подразделение',,sci178) : Protect, PickButton;
End; //brPodr

TableEvent Table UniDic;
cmSetDefault:
{
  AsSetDefaultDic;
}

cmDeleteRecord:
{
  if (message('Удалить текущую запись?', YesNo) = cmYes) then
  {
    Delete Current UniDic;
  }
  else Abort;
}
End; //TableEvent UniDic

HandleEvent
cmInit:
{
  //?AsSetDefaultDic;
}
cmPick:
{
  var _cRec : comp;
  var _i : word;
  var SelCnt : word;

  case CurField of
    #UniDic.AddString[1], #UniDic.AddString[2] :
    {
      DoneMarker(mDept, 'CatalogsMarker');
      RunInterface('Z_STAFFCAT::PickCatalog2', -11, _cRec, 100);
      mDept := InitMarker('CatalogsMarker', 8, 30, 10);

      SelCnt := GetMarkerCount(mDept);

      if (SelCnt = 1) then
      {
        if (getFirst FastFirstRow Catalogs where ((_cRec == Catalogs.nRec)) = tsOk) then
        {
          UniDic.AddComp[1]   := Catalogs.nRec;
          UniDic.AddString[1] := Catalogs.Code;
          UniDic.AddString[2] := Catalogs.Name;
          Update Current UniDic;
        }
      }
      else
      {
        _i := 0;
        while getmarker(mDept, _i, _cRec)
        {
          AsSetDefaultDic;
          if (getFirst FastFirstRow Catalogs where ((_cRec == Catalogs.nRec)) = tsOk) then
          {
            UniDic.AddComp[1]   := Catalogs.nRec;
            UniDic.AddString[1] := Catalogs.Code;
            UniDic.AddString[2] := Catalogs.Name;
            Update Current UniDic;
          }

          _i++;
        }
      }

      ClearMarker(mDept);
      DoneMarker(mDept, 'CatalogsMarker');
      Delete UniDic where ((158 == UniDic.wType and 0h == UniDic.AddComp[1] (noIndex)));

      if (SelCnt > 0) then
      {
        UniDoc.AddString[2] := 'Установлен фильтр по подразделениям';
        Update Current UniDoc;
      }
    }
  end;
  ReReadRecord;
}
End;

End; //winPodr

Window winEmailList;
  show at (,,71,11);

  browse brEmailList;
    show at (,,70,10);
    Table UniDocEmail;
    Fields
    UniDocEmail.AddString[1]     'ФИО кому'       ('ФИО кому'     ,,sci178) : [30],   Protect, noPickButton;
    UniDocEmail.AddString[2]     'Email'          ('Email'        ,,sci178) : [30], noProtect, noPickButton;
    UniDocEmail.AddWord[1]       'Тип рассылки'   ('Тип рассылки' ,,sci178) : [15], [LIST 0 'Никогда', 1 'Ежемесячно', 2 'Ежедневно'], Protect, noPickButton;
  end;

  HandleEvent
  end;

  TableEvent table UniDocEmail;
    cmSetDefault:
    {
      var cPers: comp = 0h;
      If (iGetKau.GetCodeKau(cgiPick+cgiNotEdit, cgKau_Persons, cPers) <> 0)
      {
        if getfirst fastfirstrow Pers where (( cPers == Pers.nRec )) = tsOK
        {
          var emailAddr: string = '';
          if getfirst fastfirstrow Communications where (( cPers == Communications.Person and 000A00000003995Dh == Communications.comType)) = tsOK
          {
            emailAddr := Communications.Email;
          }
          clearbuffer(#UniDocEmail);
          UniDocEmail.nrec := 0h;
          UniDocEmail.AddComp[1]    := Pers.nRec;
          UniDocEmail.AddString[1]  := Pers.FIO;
          UniDocEmail.AddString[2]  := emailAddr;
          insert current UniDocEmail;
          rereadrecord;
        }
      }
    }
    cmDeleteRecord:
    {
      if (isValidAll(#UniDicEmail)) delete current UniDicEmail;
      if (isValidAll(#UniDocEmail)) delete current UniDocEmail;
      rereadrecord;
    }
    cmUpdateRecord:
    {
      if (isValidAll(#UniDicEmail)) update current UniDicEmail;
      if (isValidAll(#UniDocEmail)) update current UniDocEmail;
      rereadrecord;
    }
  end;

end;

Window winNastr 'Настройка фильтров и рассылки' EscClose, Cyan;
Show At(,,,);

Screen scNastr (,,sci1Esc);
Show at (,,,5);
Buttons
cmEmailAddress ,,, '',, sci1Esc;
<<
  Фильтры для формирования рассылки и отчета

  <. Список адресатов .>

>>
End; //scNastr

Browse brNastr 'Настройка' (,,Sci178Esc);
Show At (,6,,);

Table UniDoc;

Fields
  UniDoc.AddString[1]     'Должность'           ('Должность'    ,,sci178) : [30], Protect, PickButton;
  UniDoc.AddString[2]     'Подразделения'       ('Подразделения',,sci178) : [30], Protect, PickButton;
End; //brNastr

TableEvent Table UniDoc;
cmSetDefault:
{
  AsSetDefaultDoc;
}

cmDeleteRecord:
{
  if (boGetTune(sCodeTune) = true) then
  {
    if (message('Удалить текущую запись?', YesNo) = cmYes) then
    {
      Delete UniDic where ((158 == UniDic.wType and UniDoc.nRec == UniDic.cParent (noIndex)));
      Delete Current UniDoc;
    }
    else Abort;
  }
  else
  {
    Message('Вы не имеете права редактировать настройки '#13 +
             GetTuneName(sCodeTune), Error);
    Abort;
  }
}
End; //TableEvent UniDoc

HandleEvent
cmInit:
{
  //?AsSetDefaultDoc;
}
cmPick:
{
  if (boGetTune(sCodeTune) = true) then
  {
    case CurField of
      #UniDoc.AddString[1] :
      {
        var _cRec : comp;
        var _i : word;
        var SelCnt : word;

        DoneMarker(mPost, 'CatalogsMarker');
        RunInterface('Z_STAFFCAT::PickCatalog2', 49, _cRec, 100);
        mPost := InitMarker('CatalogsMarker', 8, 30, 10);

        SelCnt := GetMarkerCount(mPost);

        if (SelCnt = 1) then
        {
          if (getFirst FastFirstRow Catalogs where ((_cRec == Catalogs.nRec)) = tsOk) then
          {
            UniDoc.AddComp[1]   := Catalogs.nRec;
            UniDoc.AddString[1] := Catalogs.Name;
            Update Current UniDoc;
          }
        }
        else
        {
          _i := 0;
          while getmarker(mPost, _i, _cRec)
          {
            AsSetDefaultDoc;
            if (getFirst FastFirstRow Catalogs where ((_cRec == Catalogs.nRec)) = tsOk) then
            {
              UniDoc.AddComp[1]   := Catalogs.nRec;
              UniDoc.AddString[1] := Catalogs.Name;
              Update Current UniDoc;
            }

            _i++;
          }
        }

        ClearMarker(mPost);
        DoneMarker(mPost, 'CatalogsMarker');
        Delete UniDoc where ((158 == UniDoc.wType and 0h == UniDoc.AddComp[1] (noIndex)));
      }
      #UniDoc.AddString[2] :
      {
        RunWindowModal(winPodr);
      }
    end;
  }
  else
  {
    Message('Вы не имеете права редактировать настройки '#13 +
             GetTuneName(sCodeTune), Error);
    Abort;
  }
  ReReadRecord;
}
cmDelOnProtect:
{
  case CurField of
    #UniDoc.AddString[2]:
    {
      Delete UniDic where ((158 == UniDic.wType and UniDoc.nRec == UniDic.cParent (noIndex)));
      set UniDoc.AddString[2] := '';
      Update Current UniDoc;
    }
  end;
  ReReadRecord;
}
cmEmailAddress:
{
  RunWindowModal(winEmailList);
}
End;

End;

Screen scr1 'Проверка материалов' (,,sci13Esc);
Show At(,,,);

Fields
  _dBeg       ('Период с' ,)              : noProtect;
  _dEnd       ('Период по',)              : noProtect;
  _wTypeRun   ('Применять фильтр')        : noProtect;
Buttons
  cmOk    ,,,'Сформировать',,sci1Esc;
  cmValue1,,,'Настройки'   ,,sci1Esc;
  cmCancel,,,'Отмена'      ,,sci1Esc;
<<

 Период   формирования   с .@@@@@@@@@@ по .@@@@@@@@@@

 [:] Применять фильтр по должностям`

 <. Сформировать отчет .> <. Настройки .> <. Отмена .>

>>
End; //scr1

HandleEvent
cmInit:
{
  ReadMyDsk(_dBeg, 'Staff_Rep_dBeg', false);
  ReadMyDsk(_dEnd, 'Staff_Rep_dEnd', false);
  if (wTypeReport = 1)
  {
    _dBeg := Date(01, Month(Add_Months(Cur_Date, -1)), year(Add_Months(Cur_Date, -1)));
    _dEnd := Date(last_day(Add_Months(Cur_Date, -1)), Month(Add_Months(Cur_Date, -1)), year(Add_Months(Cur_Date, -1)));
    PutCommand(cmOk);
  }
  if (wTypeReport = 2)
  {
    _dBeg := Add_Day(Cur_Date, -1);
    _dEnd := Cur_Date;
    PutCommand(cmOk);
  }
}

cmValue1:
{
  RunWindowModal(winNastr);
}

cmOk:
{
  if (_dBeg = date(0, 0, 0)) then
  {
    Message('Не указана дата начала', Error);
    Exit;
  }
  if (_dEnd = date(0, 0, 0)) then
  {
    Message('Не указана дата окончания', Error);
    Exit;
  }
  if (_dBeg > _dEnd) then
  {
    Message('Дата начала не может быть больше даты окончания', Error);
    Exit;
  }
  if (wTypeReport = 0)
  {
    SaveMyDsk(_dBeg, 'Staff_Rep_dBeg');
    SaveMyDsk(_dEnd, 'Staff_Rep_dEnd');
  }

  MakeRep1();

  if (wTypeReport <> 0)
  {
    closeInterface(cmDone);
  }
}
end;
end.

#include UserReport.vih

VipInterface UserReport_RepRpd158 Implements IUserReport Licensed(free);
Interface UserReport_RepRpd158;

Procedure Run;
Begin
  runinterface(RepRpd158, 0, 0);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Отчет по кадровым перестановкам (915)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := '';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;

End.
