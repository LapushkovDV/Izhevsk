#component "Z_STAFF"
//******************************************************************************
Alter Interface ProfAtt;
//******************************************************************************
OverLoad
  Datastream DTS_ProfAttr_Medosmotr;
End;
create view
from
 Catalogs CatalogsMetelev
;
Datastream DTS_ProfAttr_Medosmotr
(
  Table inherited::tpPrintData
  (
    [FactorCode] if(getfirst CatalogsMetelev where ((tpPrintData.FactorNRec == CatalogsMetelev.nrec)) = tsOK,CatalogsMetelev.code,'');
  );
)
end;
END.
