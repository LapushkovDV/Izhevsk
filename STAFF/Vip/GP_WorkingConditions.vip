#include PickCat.vih

#include GP_WorkingConditions.vih
interface GP_WorkingConditions;

create view ltWorkingConditions
from
  GP_WorkingConditions,
  Catalogs CatPay,
  KlOtpusk
where((
  GP_WorkingConditions.cPayForHarmWork == CatPay.NRec and
  GP_WorkingConditions.cVacForHarmWork == KlOtpusk.NRec and
  GP_WorkingConditions.cWorkRegime == KlRejim.NRec
));

function DelRec(cCat:comp):boolean;
{
  result:=delete GP_WorkingConditions where((cCat==GP_WorkingConditions.cCat))=tsok;
}

function SaveCurRec:boolean;
var cRec:comp;
{
  if (IsValidAll(tnGP_WorkingConditions))
    result:=update current GP_WorkingConditions = tsok
  else if (GetCurCatalogs(cRec)) {
    if (cRec=0) exit;

    GP_WorkingConditions.cCat:=cRec;
    result:=insert current GP_WorkingConditions = tsok;
  }
}

procedure VerifyRec;
{
  if (not Verify(GP_WorkingConditions.NRec))
    ClearBuffer(tnGP_WorkingConditions);
}

function PickPayForHarmWork:boolean;
var cRec:comp;
{
  result:=false;

  cRec:=GP_WorkingConditions.cPayForHarmWork;
  if (RunInterface(PickCatalog2,-17,cRec,0)<>cmDefault) exit;

  VerifyRec;
  if (cRec=GP_WorkingConditions.cPayForHarmWork) exit;

  GP_WorkingConditions.cPayForHarmWork:=cRec;
  result:=SaveCurRec;
}

function DelPayForHarmWork:boolean;
{
  result:=false;
  VerifyRec;
  if (GP_WorkingConditions.cPayForHarmWork=0) exit;

  GP_WorkingConditions.cPayForHarmWork:=0;
  result:=SaveCurRec;
}

function PickVacForHarmWork:boolean;
var cRec:comp;
    wTmp:word;
{
  result:=false;

  wTmp:=KlOtpusk.KOtpus;
  if (RunInterface(PickOtp, wTmp, 10, 0, true)<>cmDefault) exit;

  if (getfirst fastfirstrow KlOtpusk where((wTmp==KlOtpusk.KOtpus))<>tsok) exit;
  cRec:=KlOtpusk.NRec;

  VerifyRec;
  if (cRec=GP_WorkingConditions.cVacForHarmWork) exit;

  GP_WorkingConditions.cVacForHarmWork:=cRec;
  result:=SaveCurRec;
}

function DelVacForHarmWork:boolean;
{
  result:=false;
  VerifyRec;
  if (GP_WorkingConditions.cVacForHarmWork=0) exit;

  GP_WorkingConditions.cVacForHarmWork:=0;
  result:=SaveCurRec;
}

function PickWorkRegime:boolean;
var cRec:comp;
    wTmp:word;
{
  result:=false;

  wTmp:=KLRejim.Rejim;
  if (RunInterface(PickRejExt, wTmp, 0, 0)<>cmDefault) exit;

  if (getfirst fastfirstrow KLRejim where((wTmp==KLRejim.Rejim))<>tsok) exit;
  cRec:=KLRejim.NRec;

  VerifyRec;
  if (cRec=GP_WorkingConditions.cWorkRegime) exit;

  GP_WorkingConditions.cWorkRegime:=cRec;
  result:=SaveCurRec;
}

function DelWorkRegime:boolean;
{
  result:=false;
  VerifyRec;
  if (GP_WorkingConditions.cWorkRegime=0) exit;

  GP_WorkingConditions.cWorkRegime:=0;
  result:=SaveCurRec;
}

property cCat:comp absolute GP_WorkingConditions.cCat read;

function GetPayForHarmWork:string;
{
  result:='';
  if (Verify(CatPay.Name)) result:=CatPay.Name;
}
property PayForHarmWork:string read GetPayForHarmWork;
property cPayForHarmWork:comp absolute GP_WorkingConditions.cPayForHarmWork read;

procedure SetPayForHarmWorkProc(Val:double);
{
  VerifyRec;
  if (GP_WorkingConditions.PayForHarmWorkProc=Val) exit;

  GP_WorkingConditions.PayForHarmWorkProc:=Val;
  SaveCurRec;
}
property PayForHarmWorkProc:double read GP_WorkingConditions.PayForHarmWorkProc write SetPayForHarmWorkProc(result);

function GetVacForHarmWork:string;
{
  result:='';
  if (Verify(KlOtpusk.NOTPUS)) result:=KlOtpusk.NOTPUS;
}
property VacForHarmWork:string read GetVacForHarmWork;
property cVacForHarmWork:comp absolute GP_WorkingConditions.cVacForHarmWork read;

procedure SetVacationDays(Val:double);
{
  VerifyRec;
  if (GP_WorkingConditions.VacationDays=Val) exit;

  GP_WorkingConditions.VacationDays:=Val;
  SaveCurRec;
}
property VacationDays:double read GP_WorkingConditions.VacationDays write SetVacationDays(result);

function GetWorkRegime:string;
{
  result:='';
  if (Verify(KlRejim.NREJIM)) result:=KlRejim.NREJIM;
}
property WorkRegime:string read GetWorkRegime;
property cWorkRegime:comp absolute GP_WorkingConditions.cWorkRegime read;

index iByCat auto;

end.

//Для поддержания ссылочной целостности
handler with replace GP_WorkingConditionsDelCatalogs on trigger Catalogs before Delete [99]
action
{
  var buf : record as table Catalogs;
  GetTableBuffer(buf);

  var oWorkingConditions:GP_WorkingConditions;
  result:=oWorkingConditions.DelRec(buf.NRec);
}
