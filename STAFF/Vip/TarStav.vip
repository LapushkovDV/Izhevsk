#include CatFunc.vih           // Функции работы с Catalogs
#include Pickcat.vih

#include GP_MenuDynamic.vih
#include GP_KPI_GroupPersEdit.Vih
#include GP_TarStavExport.vih
#include GP_TarStavImport.vih

#component "Z_TarStav"
alter interface TarStav;
overload
  procedure ReReadTarstavBounds;
end;
ExtendTabbedSheets wEdit;

var iCatFunc:CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
    IsTarStavExtMod:boolean;

Create view tarstavtar
from
  GP_TarStavExt, GP_KPI_GroupPers
where((
     TarStav.NRec==GP_TarStavExt.cTarStav
and  GP_TarStavExt.cGP_KPI_GroupPers == GP_KPI_GroupPers.Nrec
));

//-----------------------------------------------
Create view vSpr
var
 pDoplata:comp;
 pGP_KPI_GroupPers:comp;
as select Catalogs.Nrec
From
  Catalogs,GP_KPI_RAISE,GP_KPI_NormPercent
where ((
    pDoplata == Catalogs.Nrec
and pDoplata == GP_KPI_RAISE.cDoplata
and Cur_Date >>=GP_KPI_RAISE.DBegin
  and (GP_KPI_Raise.DEnd>=Cur_Date or GP_KPI_Raise.DEnd=ZeroDate
      )
and GP_KPI_Raise.Nrec == GP_KPI_NormPercent.cGP_KPI_Raise
and pGP_KPI_GroupPers == GP_KPI_NormPercent.cGroupPers(noindex)
));
function GP_PickCat(var cCatRec:comp;iEntryPoint:integer):boolean;
var cRec:comp;
{
  result:=false;

  cRec := cCatRec;
  if (RunInterface('PickCatalog2',iEntryPoint,cRec,0) = cmDefault) {
    if (cCatRec<>cRec) {
      SetModified(true);
      IsTarStavExtMod:=true;
      cCatRec:=cRec;
      result:=true;
    }
  }
}

Function GetProcDoplata(_pDoplata:comp):double;
{ Result:=0;
  vSpr.pdoplata:=_pDoplata;
  if vSpr.getfirst Catalogs=tsok
  { Result:=Double(vSpr.Catalogs.LastUser);
  }
  if GP_TarStavExt.cGP_KPI_GroupPers>0
  { vSpr.pGP_KPI_GroupPers:=GP_TarStavExt.cGP_KPI_GroupPers;
    if vSpr.GetFirst GP_KPI_Raise=tsok
      if vSpr.GetFirst GP_KPI_NormPercent=tsok
       Result:=vSpr.GP_KPI_NormPercent.Percent
  }

} //Function GetProcDoplata(_pDoplata:comp):double;

function GP_PickBonusType(var cCatRec:comp):boolean;
{
  result:=GP_PickCat(cCatRec,-17);
}

function GP_PickProfStatus(var cCatRec:comp):boolean;
{
  result:=GP_PickCat(cCatRec,-176);
}

function GP_DelCat(var cCatRec:comp):boolean;
{
  result:=false;

  if (cCatRec<>0) {
    SetModified(true);
    IsTarStavExtMod:=true;
    cCatRec:=0;
    result:=true;
  }
}

window wEdit 'Редактирование тарифных ставок' ('', hcStaffCatTariff, sci178Esc);
TabbedSheet bottom  TarStavSheets;
screen scTarStav_GP 'Тарифные ставки' ('', , sci178Esc);
table TarStav;
bevel b1{0,5,150,8,bsLowered,bsHorizontal};
bevel b2{0,8,150,15,bsLowered,bsHorizontal};
bevel b3{0,15,150,20,bsLowered,bsHorizontal};
fields
  KlSisOpl.NaSisOpl (,, sci1378Esc): Protect;
  TarStav.CodTar:NoProtect;
  TarStav.Razr:noProtect;
  TarStav.FilialNo (,, sci1378Esc): [list 'Фиксированные мин./макс. оклады',
                                        'Мин.оклад (N разряда) = Окладу (N-1 разряда)',
                                        'Макс.оклад (N разряда) = Окладу (N+1 разряда)'], Protect;
  TarStav.NaiTar:NoProtect;
  TarStav.Summa1: [16.3, '\3p[|-]36`666`666`666`666.888'], noProtect;
  TarStav.Tarif: [16.3, '\3p[|-]36`666`666`666`666.888'], noProtect;
  TarStav.KolMin ('Коэффициент от ставки первого разряда',,): [12.5], noProtect;

  GP_KPI_GroupPers.Name :Protect,PickButton;
  TarStav.TarMin ('Минимальный гарантированный оклад'):[16.3, '\3p[|-]36`666`666`666`666.888'], noProtect;
  TarStav.KolM ('Коэффициент для минимального гарантированного оклада',,):[10.5], noProtect;

  TarStav.TarMax ('Максимальный гарантированный оклад'):[16.3, '\3p[|-]36`666`666`666`666.888'], noProtect;

  GP_TarStavExt.NameT3:NoProtect;
  GP_TarStavExt.GropuT3:NoProtect;
  GP_TarStavExt.SchemeName:NoProtect;

  GP_TarStavExt.MonthlyBonus[1]:[10.2],NoProtect;
  [MonthlyBonusType1] iCatFunc.GetCatalogsName(GP_TarStavExt.cMonthlyBonusType[1]) (,,sci1378Esc):Protect, PickButton;
  GP_TarStavExt.MonthlyBonus[2]:[10.2],NoProtect;
  [MonthlyBonusType2] iCatFunc.GetCatalogsName(GP_TarStavExt.cMonthlyBonusType[2]) (,,sci1378Esc):Protect, PickButton;
  GP_TarStavExt.MonthlyBonus[3]:[10.2],NoProtect;
  [MonthlyBonusType3] iCatFunc.GetCatalogsName(GP_TarStavExt.cMonthlyBonusType[3]) (,,sci1378Esc):Protect, PickButton;
  GP_TarStavExt.QuarterlyBonus:[10.2],NoProtect;
  [QuarterlyBonusType] iCatFunc.GetCatalogsName(GP_TarStavExt.cQuarterlyBonusType) (,,sci1378Esc):Protect, PickButton;
  GP_TarStavExt.AnnualBonus:[10.2],NoProtect;
  [AnnualBonusType] iCatFunc.GetCatalogsName(GP_TarStavExt.cAnnualBonusType) (,,sci1378Esc):Protect, PickButton;

  GP_TarStavExt.PersonalBonus[1]:[10.2],NoProtect;
  [ProfStatus1] iCatFunc.GetCatalogsName(GP_TarStavExt.cProfStatus[1]) (,,sci1378Esc):Protect, PickButton;
  GP_TarStavExt.PersonalBonus[2]:[10.2],NoProtect;
  [ProfStatus2] iCatFunc.GetCatalogsName(GP_TarStavExt.cProfStatus[2]) (,,sci1378Esc):Protect, PickButton;
  GP_TarStavExt.PersonalBonus[3]:[10.2],NoProtect;
  [ProfStatus3] iCatFunc.GetCatalogsName(GP_TarStavExt.cProfStatus[3]) (,,sci1378Esc):Protect, PickButton;
  GP_TarStavExt.PersonalBonus[4]:[10.2],NoProtect;
  [ProfStatus4] iCatFunc.GetCatalogsName(GP_TarStavExt.cProfStatus[4]) (,,sci1378Esc):Protect, PickButton;
  GP_TarStavExt.PersonalBonus[5]:[10.2],NoProtect;
  [ProfStatus5] iCatFunc.GetCatalogsName(GP_TarStavExt.cProfStatus[5]) (,,sci1378Esc):Protect, PickButton;
<<
 `Система оплаты`     .@@@@@@@@@@@@@@ `Тарифная сетка`.@@@@@@ `Разряд категория`.@@@ `Алгоритм расчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Наименование тарифа`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Месячная тарифная ставка`.@@@@@@@@@@@@ `Тариф (оклад)`               .@@@@@@@@@@@@ `Коэффициент`         .@@@@@@@@@@@@
 `Группа персонала`.@@@@@@@@@@@@@@@@@@@@ `Мин.гарантир. оклад (тариф)` .@@@@@@@@@@@@ `Мин.гаран-тир.коэфф.`.@@@@@@@@@@@@
                                         `Макс.гарантир. оклад (тариф)`.@@@@@@@@@@@@

 `Наименование тарифа для Т-3`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ `Группировка для Т-3`.@@@@@@@@@@@@@@@@@@@
 `Наименование схемы`         .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Целевой размер месячной премии 1` .@@@@@@@@@ `Вид оплаты месячной премии 1` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Целевой размер месячной премии 2` .@@@@@@@@@ `Вид оплаты месячной премии 2` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Целевой размер месячной премии 3` .@@@@@@@@@ `Вид оплаты месячной премии 3` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Целевой размер квартальной премии`.@@@@@@@@@ `Вид оплаты квартальной премии`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Целевой размер годовой премии`    .@@@@@@@@@ `Вид оплаты годовой премии`    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Персональная надбавка 1`.@@@@@@@@@ `Профессиональный статус 1`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Персональная надбавка 2`.@@@@@@@@@ `Профессиональный статус 2`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Персональная надбавка 3`.@@@@@@@@@ `Профессиональный статус 3`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Персональная надбавка 4`.@@@@@@@@@ `Профессиональный статус 4`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Персональная надбавка 5`.@@@@@@@@@ `Профессиональный статус 5`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;
tabsOrder scTarStav_GP,brTarStav,brTarStav2,brTarStavD,brTarStavD2;
end;

HandleEvent
cmInit:{
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  SetFormat(scTarStav_GP);
  SetTabbedSheetVisible(brTarStav, false);
  SetTabbedSheetVisible(brTarStav2, false);
}
end;
end;

TableEvent table TarStav;
cmSetDefault:{
  case inherited :: handleEvent (cmSetDefault) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  TarStav.NRec:=GetNextNRec(tnTarStav,1);

  ClearBuffer(tnGP_TarStavExt);
  GP_TarStavExt.cTarStav:=TarStav.NRec;
}
cmPick:{
  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    #GP_KPI_GroupPers.Name,#GP_KPI_GroupPers.Code:
    {
        var cTmp: comp;
        cTmp:=GP_TarStavExt.cGP_KPI_GroupPers;
        if RunInterface('GP_KPI_GroupPersEdit', cgiPick, cTmp)<>cmCancel //
        { set GP_TarStavExt.cGP_KPI_GroupPers:=cTmp;
          IsTarStavExtMod:=true;
          SetModified(true);
          UpdateTable;
        }
    }

    #MonthlyBonusType1:{
      if (GP_PickBonusType(GP_TarStavExt.cMonthlyBonusType[1]))
      { if GP_TARSTAVEXT.MONTHLYBONUS[1]=0
        { set GP_TARSTAVEXT.MONTHLYBONUS[1]:=GetProcDoplata(GP_TarStavExt.cMonthlyBonusType[1])
        }
        set MonthlyBonusType1;
      }
    }
    #MonthlyBonusType2:{
      if (GP_PickBonusType(GP_TarStavExt.cMonthlyBonusType[2]))
      { if GP_TARSTAVEXT.MONTHLYBONUS[2]=0
        { set GP_TARSTAVEXT.MONTHLYBONUS[2]:=GetProcDoplata(GP_TarStavExt.cMonthlyBonusType[2])
        }
        set MonthlyBonusType2;
      }
    }
    #MonthlyBonusType3:{
      if (GP_PickBonusType(GP_TarStavExt.cMonthlyBonusType[3]))
      { if GP_TARSTAVEXT.MONTHLYBONUS[3]=0
        { set GP_TARSTAVEXT.MONTHLYBONUS[3]:=GetProcDoplata(GP_TarStavExt.cMonthlyBonusType[3])
        }
        set MonthlyBonusType3;
      }
    }
    #QuarterlyBonusType:{
      if (GP_PickBonusType(GP_TarStavExt.cQuarterlyBonusType))
      { if GP_TarStavExt.QUARTERLYBONUS=0
        { set GP_TarStavExt.QUARTERLYBONUS:=GetProcDoplata(GP_TarStavExt.cQuarterlyBonusType);
        }
        set QuarterlyBonusType;
      }
    }
    #AnnualBonusType:{
      if (GP_PickBonusType(GP_TarStavExt.cAnnualBonusType))
      { if GP_TarStavExt.AnnualBonus=0
        { set GP_TarStavExt.AnnualBonus:=GetProcDoplata(GP_TarStavExt.cAnnualBonusType);
        }
        set AnnualBonusType;
      }
    }
    #ProfStatus1:{
      if (GP_PickProfStatus(GP_TarStavExt.cProfStatus[1]))
        set ProfStatus1;
    }
    #ProfStatus2:{
      if (GP_PickProfStatus(GP_TarStavExt.cProfStatus[2]))
        set ProfStatus2;
    }
    #ProfStatus3:{
      if (GP_PickProfStatus(GP_TarStavExt.cProfStatus[3]))
        set ProfStatus3;
    }
    #ProfStatus4:{
      if (GP_PickProfStatus(GP_TarStavExt.cProfStatus[4]))
        set ProfStatus4;
    }
    #ProfStatus5:{
      if (GP_PickProfStatus(GP_TarStavExt.cProfStatus[5]))
        set ProfStatus5;
    }
  end;
}
cmCheckField:{
  case inherited :: handleEvent (cmCheckField) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    #GP_TarStavExt.NameT3,#GP_TarStavExt.GropuT3,#GP_TarStavExt.SchemeName,
    #GP_TarStavExt.MonthlyBonus[1],#GP_TarStavExt.MonthlyBonus[2],#GP_TarStavExt.MonthlyBonus[3],
    #GP_TarStavExt.QuarterlyBonus,#GP_TarStavExt.AnnualBonus,
    #GP_TarStavExt.PersonalBonus[1],#GP_TarStavExt.PersonalBonus[2],#GP_TarStavExt.PersonalBonus[3],
    #GP_TarStavExt.PersonalBonus[4],#GP_TarStavExt.PersonalBonus[5]:{
      SetModified(true);
      IsTarStavExtMod:=true;
    }
  end;
}
cmInsertRecord:{
  case inherited :: handleEvent (cmInsertRecord) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (IsTarStavExtMod) {
    IsTarStavExtMod:=false;
    if (IsValidAll(tnTarStav))
      insert current GP_TarStavExt;
  }
}
cmUpdateRecord:{
  if (IsTarStavExtMod) {
    IsTarStavExtMod:=false;
    if (IsValidAll(tnGP_TarStavExt))
      update current GP_TarStavExt
    else if (TarStav.NRec<>0) {
      GP_TarStavExt.cTarStav:=TarStav.NRec;
      insert current GP_TarStavExt;
    }
  }

  case inherited :: handleEvent (cmUpdateRecord) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
end;

procedure ReReadTarstavBounds;
{
  if (EditMode=1 and CurFormatInArea(brTarStav) = scTarStav_GP) {
    PushBounds(tbTSBound1);
    ReReadRecord(tnTarStav);
  }
  else
    inherited::ReReadTarstavBounds;
}

HandleEvent
cmDelOnProtect:{
  case CurField of
    #MonthlyBonusType1:{
      if (GP_DelCat(GP_TarStavExt.cMonthlyBonusType[1]))
        set MonthlyBonusType1;
    }
    #MonthlyBonusType2:{
      if (GP_DelCat(GP_TarStavExt.cMonthlyBonusType[2]))
        set MonthlyBonusType2;
    }
    #MonthlyBonusType3:{
      if (GP_DelCat(GP_TarStavExt.cMonthlyBonusType[3]))
        set MonthlyBonusType3;
    }
    #QuarterlyBonusType:{
      if (GP_DelCat(GP_TarStavExt.cQuarterlyBonusType))
        set QuarterlyBonusType;
    }
    #AnnualBonusType:{
      if (GP_DelCat(GP_TarStavExt.cAnnualBonusType))
        set AnnualBonusType;
    }
    #ProfStatus1:{
      if (GP_DelCat(GP_TarStavExt.cProfStatus[1]))
        set ProfStatus1;
    }
    #ProfStatus2:{
      if (GP_DelCat(GP_TarStavExt.cProfStatus[2]))
        set ProfStatus2;
    }
    #ProfStatus3:{
      if (GP_DelCat(GP_TarStavExt.cProfStatus[3]))
        set ProfStatus3;
    }
    #ProfStatus4:{
      if (GP_DelCat(GP_TarStavExt.cProfStatus[4]))
        set ProfStatus4;
    }
    #ProfStatus5:{
      if (GP_DelCat(GP_TarStavExt.cProfStatus[5]))
        set ProfStatus5;
    }
    else {
      case inherited :: handleEvent (cmDelOnProtect) of
        heAbort:{abort;exit;}
        heStop:{stop;exit;}
      end;
    }
  end;
}
cmValue10:{//Экспорт в Excel
  var oExport:GP_TarStavExport;
  oExport.Run(MinRazr.DatIzm);
}
cmValue11:{//Импорт из Excel
  var oImport:GP_TarStavImport;
  oImport.Run(MinRazr.DatIzm);
}

cmPrintDoc:
{
  if (isValid(#TarStav))
    RunInterface(TarStavReport, TarStav.DatIzm);
}

end;
end.

//Добавление пунктов меню для Экспорта/Импорта
handler with replace GP_MenuDynamic_AddItems_TarStav on ExtensionPoint GP_MenuDynamic_AddItems
action
{
  result:=true;
  timelog('GP_MenuDynamic_AddItems_TarStav');
  var MenuID:longint=0;
  _try {
    MenuID:=LoadMenuEx('Z_TarStav::TStav_HotKeys2',false,true);

    AddMenuItem(MenuID,'separator',1);
    AddMenuItemEx(MenuID,'Экспорт в Excel','Экспорт в Excel','',cmValue10,0);
    AddMenuItemEx(MenuID,'Импорт из Excel','Импорт из Excel','',cmValue11,0);

    if (not StoreMenuHowDynamics(MenuID,'Z_TarStav::TStav_HotKeys2'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню для интерфейса "Тарифные ставки"'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }
  timelog('GP_MenuDynamic_AddItems_TarStav finish');
}

//Удаление пунктов меню для Экспорта/Импорта
handler with replace GP_MenuDynamic_DelItems_TarStav on ExtensionPoint GP_MenuDynamic_DelItems
action
{
  result:=true;

  DeleteMenuHowDynamics('Z_TarStav::TStav_HotKeys2');
}
