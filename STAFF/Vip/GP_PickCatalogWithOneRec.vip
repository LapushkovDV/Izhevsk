#include CatFunc.vih

interface GP_PickCatalogWithOneRec '' Cyan, DoAccept;
Show at (,, 83, 25);

Var
  iCatFunc: CatalogsFunctions;

Create view
Var
  iEntryPoint: integer;
  cCurPos: Comp;
As select
  if (IsValid(tnCatalogs),
      if (Catalogs.SysCode <> 0, 'С', ''), '')
      (FieldName = SysRecord)
From
  Catalogs
Where ((
  cCurPos == Catalogs.nrec
));

Parameters iEntryPoint, cCurPos;

browse brCat (, hcStaffViewCatalogs, sci1EnEsc);
  Table Catalogs;
Fields
  Catalogs.Name  'Наименование' ('Наименование'): [50], Protect;
  Catalogs.Code  'Код' ('Код'): [20], Protect;
  SysRecord      'C':[1], Skip;
end;

HandleEvent // Interface

cmInit:
{
  SetWindowTitle(wnMainWindow, iCatFunc.GetCatalogsNameSys(iEntryPoint));
}

cmDefault:
{
  cCurPos := Catalogs.Nrec;
}

End;


end.
