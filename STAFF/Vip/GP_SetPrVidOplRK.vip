#include MainLschetForPersons.vih

#component "GP_STAFF"

#include GP_SetPrVidOplRK.vih
interface GP_SetPrVidOplRK;

var
  MLFP: MainLschetForPersons;   // ссылка на главный л\с

create view
as select *
from ZarSignal, Persons, LSchet, Appointments, ContDoc, PartDoc, TitleDoc;

function InsZarSignal(_params: TGP_SetPrVidOplRK_Params): comp;
{
  ZarSignal.NRec       := 0;
  ZarSignal.SubSysCode := 1;
  ZarSignal.SrcTable   := _params.wTable;
  ZarSignal.SrcRec     := _params.cRec;
  ZarSignal.Double1    := _params.dSum;
  ZarSignal.Word1      := _params.wSumType;
  ZarSignal.Word3      := _params.wVidOpl;
  ZarSignal.Word4      := _params.wVidUd;
  ZarSignal.Word5      := _params.wChoice;
  ZarSignal.Date1      := _params.dBeg;
  ZarSignal.Date2      := _params.dEnd;
  ZarSignal.Comp2      := _params.cVal;
  ZarSignal.Comp4      := _params.cContDoc;
  ZarSignal.String4    := _params.nMnem;

  if getfirst fastfirstrow contdoc where ((_params.cContDoc == contdoc.nrec)) = tsOk
    if getfirst fastfirstrow partdoc where ((contdoc.cpart == partdoc.nrec)) = tsOk
      if getfirst fastfirstrow titledoc where ((partdoc.cdoc == titledoc.nrec)) = tsOk
      {
        ZarSignal.Date10     := titledoc.DocDate;
        ZarSignal.String2    := titledoc.DocNmb;
      }

  ZarSignal.FstDate    := Cur_Date;
  ZarSignal.FstTime    := Cur_Time;
  ZarSignal.LstDate    := Cur_Date;
  ZarSignal.LstTime    := Cur_Time;

  var lschetNrec: comp = 0;

  if GetFirst FastFirstRow Persons  where ((_params.cPers == Persons.Nrec)) = tsOK
  {
    ZarSignal.tPerson  := Persons.Nrec;
    ZarSignal.TABN     := Persons.TabNmb;
    ZarSignal.LastUser := Persons.StrTabN;
    ZarSignal.CEX      := Persons.GalDep;
    ZarSignal.StrTabn  := Persons.StrTabN;

    if getfirst FastFirstRow Appointments where ((_params.cApp == Appointments.Nrec)) = tsOk
    {
      if (Persons.AppointCur <> Appointments.Nrec)// не основное назначение
        lschetNrec := Appointments.cAddNrec2;
    }

    if lschetNrec = 0
      MLFP.GetMainLschet(Persons.nRec, lschetNrec);

    if getfirst fastfirstrow LSchet where ((lschetNrec == Lschet.Nrec)) = tsOk
    {
      ZarSignal.TABNZPL    := LSchet.TabN;
      ZarSignal.CEXZPL     := LSchet.CEX;
      ZarSignal.cLschetZPL := Lschet.nRec;
      ZarSignal.StrTABN    := LSchet.StrTABN;
      ZarSignal.TABN       := LSchet.TabN;
    }

  }

  if (insert current ZarSignal <> tsOK)
  {
    Message('Сообщение о корректировке данных утеряно!', Error);
    result := 0;
  }
  else
    result := ZarSignal.Nrec;
}

Function SetRR (_params: TGP_SetPrVidOplRK_Params): comp;
{
  ClearBuffer(tnZarSignal);
  if _params.wChoice = 1
    ZarSignal.MsgCode := 214
  else
    ZarSignal.MsgCode := 114;
  result := InsZarSignal(_params);
}

Function DelRR (_params: TGP_SetPrVidOplRK_Params): comp;
{
  ClearBuffer(tnZarSignal);
  if _params.wChoice = 1
    ZarSignal.MsgCode := 215
  else
    ZarSignal.MsgCode := 115;
  result := InsZarSignal(_params);
}

end.
