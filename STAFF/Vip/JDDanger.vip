#component 'EM'
#doc
EM::JDDanger
Штатное расписание с вредностью
#end

#include MedExamFuncs.vih

interface JDDanger 'Штатное расписание с вредными условиями труда', EscClose, Cyan;
// \\tsclient\d\GAL_DEV\Projects\JDDanger\res\JDDanger.res

function CountFiles(nrec: comp) : integer; forward;
function CountDelFiles(nrec: comp) : integer; forward;

const
  cStaffStructTn :word = 25018;
  sSoutCardAttrName :string = '№ Карты СОУТ';
end;

Create view
as
select
   podr.CODE              (fieldname = DCode)
  ,podr.NAME              (fieldname = DName)
  ,post.NAME              (fieldname = PName)
  ,CountFiles(ss.nrec)    (fieldname = CountFiles)
  ,CountDelFiles(ss.nrec) (fieldname = CountDelFiles)
  ,categ.KOD              (fieldname = Category)
  ,if(isValidAll(tnAttrv),attrv.vString,'') (Fieldname = soutCardNum)
  ,workcondCat.code       (Fieldname = CodeClassUslT)
from
   CATALOGS podr
   ,CATALOGS podrML
   ,STAFFSTRUCT ss
   ,CATALOGS post
   ,KLKATEGO categ
   ,SPALLSTAFF dange
   //,CATALOGS dgname

   ,ATTRNAM  attrn
   ,ATTRVAL  attrv

   ,CATALOGS workcondCat
where
  ((            -11 == podrML.syscode
    and podrML.NREC == podr.MAINLINK (noindex)
    and podr.NREC == ss.DEPARTMENT
    and ss.POST == post.NREC
    and ss.EMPCATEGORY == categ.NREC

    and 24 == dange.WNOCON
    and ss.NREC == dange.CBASET //(noindex)
    //and dange.CLINKT == dgname.NREC
    and cStaffStructTn == attrn.wtable
    and attrn.nrec == attrv.cattrnam
    and attrn.wtable == attrv.wtable
    and ss.nrec == attrv.crec
    and sSoutCardAttrName == attrn.name

    and ss.workcond == workcondCat.nrec
    //and 0 == podr.datok (noindex)
  ))
condition ByDatOk (podr.datok >= cur_date  or  podr.datok = 0)
   //and podr.CODE = '968-1'
;

#include GP_File_hRef.Vpp

function CountFiles(nrec: comp) : integer;
{
  var _result : integer = 0;
  _try {
    sql select count(*) from GP_FILE_HREF f1 where f1.crec = :(nrec) and f1.WTABLE = 25018 and f1.isarch = 0 and f1.tipDoc = 10 into (_result);
  }
  _except else {}
  result := _result;
}

function CountDelFiles(nrec: comp) : integer;
{
  var _result : integer = 0;
  _try {
    sql select count(*) from GP_FILE_HREF f1 where f1.crec = :(nrec) and f1.WTABLE = 25018 and f1.isarch = 2 and f1.tipDoc = 10 into (_result);
  }
  _except else {}
  result := _result;
}

function NodeType: string;
{
  //NodeType := if(CountFiles(ss.nrec) = 0, 'EM::bmpRedFlag', '');  /*C_ExpImp::bmpAttention*/
  NodeType := if(CountFiles(ss.nrec) = 0 /*and Category >= 5*/, 'EM::bmpRedFlag', '');
}


var iMedEF    : iMedExamFuncs new;
//window wnOne
//  show at (10,30,50,60);
Browse brDepts 'Подразделения' (,,sci1Esc);
show at (,,20,22);
Table podr;
 FIELDS
  DCode 'Код'      ('Код подразделения')      : [10] ,Protect,NoDel;
  DName 'Название' ('Название подразделения') : [10] ,Protect,NoDel;
  podr.DATN 'Дата ввода' ('Дата ввода подразделения') : [10] ,Protect,NoDel;
  podr.DATOK 'Дата закрытия' ('Дата закрытия подразделения') : [10] ,Protect,NoDel;
end;

Function GetColorbyDclose(_dclose: date): word;
{
  result := ColorSysBlack;
  if _dclose != 0 {
    result := ColorSysGray;
  }
}

Browse brPosts 'Должности' (,,sci1Esc);
show at (21,,,12);
Table ss;
 FIELDS
  [flpic] NodeType()  '< ! >'              ('')     : [4],  centered, image;
  PName               'Должность'     ('Должность') : [10], protect, NoDel, {Font={Color=GetColorbyDclose(ss.dclose)}};
  Category            'Категория'     ('Категория') : [5], protect, NoDel, {Font={Color=GetColorbyDclose(ss.dclose)}};
  ss.dinput           'Введена'                     : [5],  centered, protect, nopickbutton, {Font={Color=GetColorbyDclose(ss.dclose)}};
  ss.dclose           'Закрыта'                     : [5],  centered, protect, nopickbutton, {Font={Color=GetColorbyDclose(ss.dclose)}};
  CountFiles          'Файлов'                      : [3],  centered, protect, nopickbutton;
  CountDelFiles       'Удалено файлов'              : [3],  centered, protect, nopickbutton;
  soutCardNum         '№ Карты СОУТ' ('№ Карты СОУТ') : [6],  centered, noprotect, nopickbutton;
  CodeClassUslT       'Код класса условий труда' ('Код класса условий труда') : [6],  centered, protect, nopickbutton;
end;

Embedded brDangerWork 'Вредные факторы и работы' interface iMedEF;       //iMedEF
show at (21,13,,);
end;

TableEvent
  Table ss;
cmPositionChanged:
{
  iMedEF.SetPosition(ss.NRec, 24);
}

end;

handleevent

  cmInit: {
    LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' , wnMainWindow, -1, 1);
    Pushcondition(tcByDatOk);
   }

  cmValue68: {
    if isvalid(tnSS)
    {
      pGP_File_hRef.InitParam(0 ,coStaffStruct, ss.Nrec, 1, true, 'Прикрепляемые документы: ' + DCode + ' (' + PName + ')', 10);
      RescanPanel(tnSS);
    }
  }
  cmHotKeys:
    {
        ProcessCommand(RunMenu('EM_JobScheduleDanger_HotKey'));
    }
cmFilterSave: {
  if conditionActive(tcByDatOk) {PopCondition(tcByDatOk);
  }
  else { Pushcondition(tcByDatOk);
  }
  if getnext podr = tsOk {}
  if getprev podr = tsOk {}
  //rescanpanel(tnPodr);
  rereadRecord(tnPodr);
}
/*cmValue2: {
 if conditionActive(tcByDclose) {
   PopCondition(tcByDclose);
 }
 else {
   Pushcondition(tcByDclose);
 }
 if getnext ss = tsOk {}
 if getprev ss = tsOk {}
 //rescanpanel(tnPodr);
 rereadRecord(tnSS);
}*/

    cmExprFieldChanged: {
      case CurField of
        #soutCardNum: {
          sSetAttr(cStaffStructTn,ss.nrec, sSoutCardAttrName, ExprFieldValue);
        }
      end;
      rereadrecord(#ss);
    }

end;
//            end;
//end;
end.

