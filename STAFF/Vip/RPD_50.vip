#include InfoFromHistoryStr.vih  // объект для работы с историей ШР
#include Func_AppHist.vih        // объект для получения состояния назначения на указанную дату

#include GP_RepLaborContract.vih

#component "Z_StaffOrders"
alter interface RPD_50;
overload
  procedure prFillMenu(_menuID: longint);
  Procedure IRPD_Base.EnableDisable;
  function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
  procedure IRPD_Base_AppChange.FillHistFromApp;
end;

var IFHS: InfoFromHistoryStr;

create view
from
  HistoryStr,
#IFNDEF _2018_10_19_
  Catalogs WorkCondCat,
#ENDIF //IFNDEF _2018_10_19_
  AppHist PrevAppHist,
  KlSisOpl CurApp_KlSisOpl,
  KlVal CurApp_KlVal,
  Catalogs CurApp_WorkCondCat
where((
#IFNDEF _2018_10_19_
  AppHist.WorkCond == WorkCondCat.NRec and
#ENDIF //IFNDEF _2018_10_19_
  ContDoc.cRef1 == PrevAppHist.NRec and
  if(ContDoc.cRef1=0,Appointments.PayModel,PrevAppHist.PayModel) == CurApp_KlSisOpl.SisOpl and
  if(ContDoc.cRef1=0,Appointments.WorkCond,PrevAppHist.WorkCond) == CurApp_WorkCondCat.NRec and
  if(ContDoc.cRef1=0,Appointments.PayCurrency,PrevAppHist.PayCurrency) == CurApp_KlVal.NRec
));
#IFDEF NEW_20180313
#ELSE
overloadFormats scrDet50;
screen scrDet50 (,hcStaffWinPr, scStaff1Esc);   //изменение оклада
table AppHist;
bevel CurApp {3,7,82,12,bsRaised, bsFrame};
  fields
    AppHist.dRec ('С даты', hcStaffWinPr, sci13Esc): [10,'DD/MM/YYYY'], noprotect;
    AppHist.dEnd ('По дату', hcStaffWinPr, sci13Esc): [10,'DD/MM/YYYY'], noprotect;
    KlSisOpl.NaSisOpl ('Система оплаты труда. ',
             hcStaffAppPayModel, sci13Esc):  protect;
    AppHist.TaxRate ('Оклад, ставка, тариф',
             hcStaffAppTaxRate): [11.3], noprotect;
    KlVal.SimvolV ('Валюта', hcNoContext, sci13Esc): protect;
    scdLastUser04 ('Корректирующий коэффициент', hcStaffAppTaxRate): [10.3], noprotect;
    TarStav.Naitar: Skip;
    AppHist.Category: Skip;
    AppHist.coef1 ('Количество занимаемых ставок'): [5.3], noprotect;
    FullIf ('Источники финансирования',, sci13Esc): protect;
#IFDEF _2018_10_19_
#ELSE
    WorkCondCat.Name:skip;
#ENDIF
    CurApp_KlSisOpl.NaSisOpl:skip,{font={Italic=true;Color=ColorSysBlack}};
    if(ContDoc.cRef1=0,Appointments.TaxRate,PrevAppHist.TaxRate):[11.3],skip,{font={Italic=true;Color=ColorSysBlack}};
    CurApp_KlVal.SimvolV:skip,{font={Italic=true;Color=ColorSysBlack}};
    CurApp_WorkCondCat.Name:skip,{font={Italic=true;Color=ColorSysBlack}};

    fAgreement ('Доп. соглашение к трудовому договору'): protect, pickbutton;
    ContDoc.SBottom ('Основание', hcStaffWinPr), noprotect;
  buttons
    cmValue4, [singleline, icon bmpCheckOn];
    cmValue12,[singleline],,,'Составляющие корректирующего коэффициента', hcStaff_complexKK;
    cmViewAdvance1,,, 'Просмотр примечания к приказу', hcStaffWinPr;
<<

     C даты           .@@@@@@@@@@@ по дату .@@@@@@@@@@@
<..> Система оплаты   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
     Тар.ставка/оклад .@@@@@@@@@@@@@@@.@@@@@@@@@@@@@@@@ Корр.коэф..@@@@@@@<.>>.>
     Тариф            .@@@@@@@@@@@@@@@     Разряд.@@@@@
     Количество ставок.@@@@@ `ИФ`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
#IFDEF _2018_10_19_
#ELSE
     Условия          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
#ENDIF
     Данные из ЛК
     Система оплаты   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
     Тар.ставка/оклад .@@@@@@@@@@@@@@@.@@@@@@@@@@@@@@@@
     Условия          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

    `Доп. соглашение `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
     Основание
     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                                <. Примечание .>
>>
end; // screen scrDet50
#ENDIF
procedure FillHistFromApp;
{
  inherited::FillHistFromApp;

  if (not IsValidAll(tnAppHist)) exit;
  if (not IsValidAll(tnAppointments)) exit;
  if (Appointments.StaffStr=0) exit;

  if (getfirst HistoryStr where((IFHS.GetHistoryStrNRec(Appointments.StaffStr,AppHist.DRec) == HistoryStr.NRec)) <> tsOk) exit;

  AppHist.Tariff := HistoryStr.cTariff;
  AppHist.PayModel := HistoryStr.wPayModel;
  AppHist.TaxRate := HistoryStr.HTaxRate;
  AppHist.PayCurrency := HistoryStr.cCurrency;
  AppHist.Category := HistoryStr.wCategory;

  AppHist.WorkCond := HistoryStr.cWorkCond;
  if (AppHist.WorkCond<>Appointments.WorkCond)
    AppHist.cInf1:=iAH.InfGetMarked(AppHist.cInf1, AH_WorkCond);

/*  AppHist.WorkRegime := HistoryStr.cWorkRegim;
  if (AppHist.WorkRegime<>Appointments.WorkRegime)
    AppHist.cInf1:=iAH.InfGetMarked(AppHist.cInf1, AH_WorkRegime); */

  update current AppHist;
  ReReadRecord(tnAppHist);
}

//******************************************************************************
//  Процедура утверждения приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function ChildConfirmOneOrder(cNrec : comp = 0): boolean;
var cPrevAppHist:comp;
{
  cPrevAppHist := iAH.GetLastAppHistNRecOnDate(Appointments.NRec, ZeroDate);

  result := Inherited::ChildConfirmOneOrder(cNrec);
  if (not result) exit;

  ContDoc.cRef1 := cPrevAppHist;
  update current ContDoc;
}

//******************************************************************************
// можно вынести в RPD_BASE, но тогда начинают идти 6 предупреждений на base_Payment
// да и EnableDisable в 8 перехвачена
//******************************************************************************
Create view vNotes
var
  nRecTable:comp;
  wChoice  :word;
From Notes
where ((
      wChoice     == Notes.choice
  and nRecTable   == Notes.Owner
));

File FMemo;

Function MyCheckNotes(_wChoice:word):boolean;
{ Result:=false;
  vNotes.nRecTable:=ContDoc.Nrec;
  vNotes.wChoice  :=_wChoice;
  Result:=vNotes.Getfirst Notes=tsok;
  if not Result exit;
  if FMemo.OpenMemo(vNotes.Notes.NOTE)
  { Result:=FMemo.GetSize()<>0;
    FMemo.Close;
  }
}

//******************************************************************************
// Установить надписи на кнопках
//******************************************************************************
Procedure MySetButtonTitle(_nm_screen:string='');
{ //'Z_STAFFORDERS::NOTESFORCONTDOC.Memo_NOTES.NOTE'
  var ww_str:string;
  if _nm_screen='' _nm_screen:='b_SCRDET#(Num)';
  //cmViewAdvance1
  ww_str:=if(MyCheckNotes(3002),'Примечан.+','Примечание');
  cfsSetProp(_nm_screen+'_Примечание',cfpTitle,ww_str);
  //--
  ww_str:=if(MyCheckNotes(3005),'Доп.условия+','Доп. условия');
  cfsSetProp(_nm_screen+'_Доп._условия',cfpTitle,ww_str);
  ReScanPanel(#PERSONS);
} //Procedure MySetButtonTitle;

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure IRPD_Base.EnableDisable;
{ MySetButtonTitle('b_SCRDET#(Num)');
  Inherited::EnableDisable
}

//включение стандартных пунктов контекстного меню приказа
procedure prFillMenu(_menuID: longint);
{
  inherited::prFillMenu(_menuID);

  if (NOAA.GetFirstAgreementByLink(GetCo4Agreement(), GetNRec4Agreement()) <> 0)
    AddMenuItem(_menuID, 'Печать доп. соглашения (Word)', cmValue17);
}

HandleEvent
cmOnVipLoad:
{ timelog_init;
  timelog('RPD_50->cmOnVipLoad'); //489
  if  inherited :: handleEvent (cmOnVipLoad)=heAbort then Abort;

}
cmValue17:{//Печать доп. соглашения (Word)
  if (not UpDateTable) exit;

  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,0,ContDoc.NRec,ContDoc.Person,0);
}
cmViewAdvance1: //просмотр примечания к приказу
{ if  inherited :: handleEvent (cmViewAdvance1)=heAbort then Abort;
  MySetButtonTitle;
}
cmValue21: //доп. условия
{ if  inherited :: handleEvent (cmValue21)=heAbort then Abort;
  MySetButtonTitle;
  // почему то сразу не обновляется
  EnableDisable;
}
end;
end.
