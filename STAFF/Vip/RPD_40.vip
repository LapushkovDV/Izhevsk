#include AttrTablePick.vih

#component "Z_StaffOrders"
#doc
РПД № 40 Интерфейс приказа "отзыв"
#end
alter interface RPD_40;
overload
  Procedure IRPD_Base.EnableDisable;
end;
ExtendFormats scrDet40;

var IsShiftAllObj:boolean=false;
    cAttrReasonOfRecall:comp;
    oAttrTablePick:AttrTablePick;

screen scrDet40 (,hcStaffWinPr, sciStaffTypical178Esc);
table ContDoc;
fields
  [ReasonOfRecall] oAttrTablePick.sGetValue(coContDoc,cAttrReasonOfRecall,ContDoc.NRec)
    ('Причина отзыва из отпуска',,sci13Esc):Protect,PickButton;
<<









 `Причина отзыва из отпуска`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

function ShiftAllObj(scr,ObjFrom:string;DeltaCount:word=1):boolean;
var aList: array [1..1] of string;
    i, n, rc: longInt;
    y,yFrom,Delta:integer;
{
  result:=false;

  SetLimit(aList, 0);
  rc := cfsEnumObjects(scr, aList, false);
  if (rc <> cfOK) exit;

  rc := cfsGetProp(ObjFrom,cfpOrigin_Y,yFrom);
  if (rc <> cfOK) exit;

  rc := cfsGetProp(ObjFrom,cfpSize_Y,Delta);
  if (rc <> cfOK) exit;
  Delta+=6;
  Delta*=DeltaCount;

  n := Count(aList);
  for (i := 1; i <= n; i++) {
    if (UpCase(aList[i])='I_SCRDET40_REASONOFRECALL' or
        UpCase(aList[i])='L_SCRDET40_ПРИЧИНА_ОТЗЫВА_ИЗ_ОТПУСКА') continue;

    rc := cfsGetProp(aList[i],cfpOrigin_Y,y);
    if (rc=cfOK)
      if (y>yFrom)
        cfsSetProp(aList[i],cfpOrigin_Y,y+Delta);
  }

  result:=true;
}

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  inherited::EnableDisable;

  ToggleFieldSelectable(fnReasonOfRecall,fnFieldsOpen);
}

HandleEvent
cmOnVipLoad:{
  case inherited :: handleEvent (cmOnVipLoad) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  cAttrReasonOfRecall:=ExtAttr_ID(coContDoc,'Причина отзыва из отпуска');
}
cmIdle:{
  case inherited :: handleEvent (cmIdle) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (not IsShiftAllObj)
    IsShiftAllObj:=ShiftAllObj('scrDet40','i_SCRDET40_CONTDOC.SBOTTOM',2);
}
cmPick:{
  if funIsOrderConfirm
  {
    Message('Приказ утвержден. Изменение данных не возможно!', Error);
    abort;
    exit;
  }

  case CurField of
    #fNOtpus: //забираем полностью
    {
      var cTmpVac: comp;
      if ( not IsValid(#Persons) )
      {
        Message('Не выбран сотрудник.', Warning);
        abort;
        exit;
      }

      var bPackage : boolean;
      bPackage := false;
      //GP       cTmpVac := iFactOpt.funGetVacationByAppType(Persons.nRec, OtpOtz.cOtpusk, bPackage, ContDoc.cStr);
      cTmpVac := iFactOpt.funGetVacationByAppType(Persons.nRec, OtpOtz.cOtpusk, bPackage, 0);

      if cTmpVac <> 0
      {
        set OtpOtz.DataN := ZeroDate;
        set OtpOtz.DatOk := ZeroDate;

        // если был выбран пакет отпусков
        if bPackage
        {
          set ContDoc.cNew1 := cTmpVac;

          if GetFirst AllVacFactOtpusk = tsOk
          {
            set OtpOtz.DataN := AllVacFactOtpusk.FactYearBeg;
            set OtpOtz.DatOk := AllVacFactOtpusk.FactYearEnd;
          }
        }
        else
          // если был выбран отпуск
          if GetFirst Otpusk where (( cTmpVac == Otpusk.nRec and
                                      Persons.nRec == Otpusk.tPerson (noindex))) = tsOk
          {
            set ContDoc.cNew1 := Otpusk.cFactOtpusk;
            set OtpOtz.DataN   := Otpusk.DataN;
            set OtpOtz.DatOk   := Otpusk.DatOk;
          }

        set ContDoc.wAttrDoc3 := if(bPackage, 1, 0);
        set OtpOtz.cOtpusk := ContDoc.cNew1;
        set OtpOtz.FilialNo := coFactOtpusk;

        SetModified(true);
        UpdateTable;

        FillAllVacCon(cTmpVac);
        CalcOtzByDates;
      }
    }
    fnReasonOfRecall:{
      if (oAttrTablePick.PickValue(coContDoc,cAttrReasonOfRecall,ContDoc.NRec))
        set ReasonOfRecall;
    }
    else {
      case inherited :: handleEvent (cmPick) of
        heAbort:{abort;exit;}
        heStop:{stop;exit;}
      end;
    }
  end;
}
cmDelOnProtect:{
  case inherited :: handleEvent (cmDelOnProtect) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnReasonOfRecall:
      if (ExtAttr_DeleteValueID(coContDoc,ContDoc.NRec,cAttrReasonOfRecall)=tsok)
        set ReasonOfRecall;
  end;
}
end;

end.
