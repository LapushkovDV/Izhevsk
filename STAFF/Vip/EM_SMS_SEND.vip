Show At(,5,50,);
table tSMSByNumbers;
fields
 tSMSByNumbers.NumberSend 'Номер','рассылки' ('Номер рассылки') : [2] ,Protect;
 x$users.xu$loginname     'Автор','рассылки' ('Автор рассылки') : [4] ,Protect;
 tSMSByNumbers.DateIN     'Дата','рассылки' ('Дата рассылки') : [4] ,Protect;
 tSMSByNumbers.TimeIn     'Время','рассылки' ('Время рассылки') : [4] ,Protect;
 tSMSByNumbers.Description 'Описание','рассылки' ('Описание рассылки') : [16] ,Protect;
end;
text EM_SMS.SMS_TEXT 'Отосланная СМС' : Protect;
   Show At(51,,,6);

Screen ScrtbEM_SMS('Списки совершенных рассылок',,sci1Esc);
Show At(51,7,,7);
<<
                       Список сотрудников рассылки
>>
end;

Browse brbEM_SMS (,,sci1Esc);
Show At(51,8,,);
table EM_SMS;
Fields
 Persons.FIO          'Cотрудник' ('Сорудник-получатель СМС'): [16] ,Protect;
 EM_SMS.Phone         'Мобильный телефон' ('Мобильный телефон') : [8] , Protect;
 GetStatName(EM_SMS.Status) 'Статус' ('СТатус СМС') : [5] , Protect;
 EM_SMS.DateIN        'Дата','постановки'  ('Дата поставновки в очередь СМС') : [4] , Protect;
 EM_SMS.TimeIn        'Время','постановки' ('Время постановки в очередь СМС'): [4] ,Protect;
 EM_SMS.DateSend      'Дата','отправки' ('Дата отправки СМС'): [4] ,Protect;
 EM_SMS.TimeSend      'Время','отправки' ('время отправки СМС'): [4] ,Protect;
end;

Procedure GetPhonesToPers(_cPers : comp);
{
  delete all tmpPhonesToPers;
  _try
   {
    sql
     select
      com.addr as MobilePhone
     from  PERSONS pers
      join COMMUNICATIONS com on com.Person = pers.nrec
      join Catalogs phone     on com.COMTYPE = Phone.nrec
     where pers.nrec = :(_cPers)
       and com.OBJTYPE = 2
       and phone.name = 'Мобильный телефон'
    into tmpPhonesToPers
    ;
   }
   _except else {}
}
function get_NUMBERSEND: longint;
{
  result := 0;
  _try
   {
      sql
      select max(NumberSend)
      from  EM_SMS
      into (result)
    ;
   }
   _except else {}
  result := result +1;
}
Function GetCountSMS: word;
{
result := 0;
   var _sms_file : longint = CreateFileHandle('');
   var _str : string = '';
   var _Len : longint = 0;
   If File_OpenMemo(EM_SMS_template.SMS_TEXT,_sms_file)
   {
      File_Seek(_sms_file,0);
      while not(File_EOF(_sms_file))
      {
        File_Readln(_str, _sms_file);
        _Len := _Len + Length(_str);
      } //while not(File_EOF(ww_hfile))
    File_Close(_sms_file);
   }
  result:= _Len div 67 + if(_Len mod 67>0,1,0)
}
Window winCreateRassylkaSMS 'Создание новой рассылки';
