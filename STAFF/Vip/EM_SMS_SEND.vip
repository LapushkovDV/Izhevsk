#doc
EM::SMS_SEND
Рассылка по СМС
#end

#component "EM"
#include EM_SMS_PHONEBOOK.vih
//************************************************************
Interface SMS_SEND 'Рассылка СМС' (,,sci17EnEsc), EscClose;
//************************************************************
Show At (,,120,40);
//----------------------------------------
table struct tmpEM_SMS
(
   cPersons : comp
 , Phone    : string

)
with index
(
 ind0 = cPersons
)
;
table struct tmpPhonesToPers
(
 MobilePhone : string
)
with index
(
 ind0 = MobilePhone
)
;
table struct tSMSByNumbers
(
     NumberSend   : longint
   , DateIN       : Date
   , TimeIn       : time
   , Description  : WideString
)
with index
(
 ind0 = NumberSend
)
;
Create View
var
  iSMS_PhoneBook : SMS_PhoneBook;
   _Description
/*  ,_SMS_TEXT1
  ,_SMS_TEXT2
  ,_SMS_TEXT3
  ,_SMS_TEXT4
  ,_SMS_TEXT5
  ,_SMS_TEXT6
  ,_SMS_TEXT7
  ,_SMS_TEXT8
  ,_SMS_TEXT9
  ,_SMS_TEXT10
  ,_SMS_TEXT11
  ,_SMS_TEXT12
  ,_SMS_TEXT13
  ,_SMS_TEXT14
  ,_SMS_TEXT15
  ,_SMS_TEXT16
  ,_SMS_TEXT17
  ,_SMS_TEXT18
  */  : string;
select
 tSMSByNumbers.NumberSend
From
  EM_SMS
, tSMSByNumbers
, Persons
, tmpEM_SMS
, Persons tmpPersons
, tmpPhonesToPers
, EM_SMS EM_SMS_template
, Catalogs KP
, appointments app
, Catalogs Post
, x$users
Where ((
 tSMSByNumbers.NumberSend == EM_SMS.NumberSend
      and EM_SMS.cPersons == Persons.nrec
      and EM_SMS.atl_owner == x$users.atl_nrec
 and tmpEM_SMS.cPersons == tmpPersons.nrec

and  tmpPersons.Department == kp.nrec
 and tmpPersons.appointCur == app.nrec
       and        app.post == post.nrec


 and            USERID == EM_SMS_template.cPersons
 and    String(USERID) == EM_SMS_template.Phone (Noindex)
 and 'EM_SMS_TEMPLATE' == EM_SMS_template.DESCRIPTION (Noindex)
))

;
//------------------------------
//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
Function GetStatName(_Status: word) : string;
{
  result := '???';
 Case _Status of
  0 : result := 'Подготовлено'
  1 : result := 'Готово к отсылке'
  2 : result := 'Отослано'
  3 : result := 'Ошибка'
 end;
}
Procedure FillSMSByNumbers;
{ Delete all tSMSByNumbers;
  _try
   {
     Sql
      select Distinct
       NumberSend
     , DateIN
     , TimeIn
     , Description
//     , SMS_TEXT
     from  EM_SMS  where Description <> 'EM_SMS_TEMPLATE'
     into  tSMSByNumbers
     ;
   }
   _except else
   {}
  if getlast tSMSByNumbers = tsOK {}
  rescanPanel(tntSMSByNumbers);
}
Function PartOfSMS(_SMS_TEXT : widestring; _Part : byte) : string;
{
 Result := SubStr(_SMS_TEXT,(_Part-1)*90+1,90);
}
