Browse brbEM_SMSCreate (,,sci178Esc);
Show At(51,,,);
table tmpEM_SMS;
Fields
 tmpPersons.FIO  'Cотрудник' ('Сорудник-получатель СМС'): [8] ,Protect;
 KP.code         'Подразделение' ('Код подразделения') : [2] , Protect;
 post.Name       'Должность' ('Долэность сотрудника') : [8] , Protect;
 tmpEM_SMS.Phone 'Мобильный телефон' ('Мобильный телефон') : [5] , Protect;
 end;
Handleevent
cmDelete:
{
 Update Current EM_SMS_template;
   case curtable of
    #tmpEM_SMS: Delete current tmpEM_SMS
   end;
 rescanPanel(tntmpEM_SMS);
}
CmCheckField:
{
// message('CmCheckField');
 Update Current EM_SMS_template;
 rescanPanel(tntmpEM_SMS);
}
cmInsert:
 {
   Update Current EM_SMS_template;
   var _pMarkerName : string = '';
   case curtable of
    #tmpEM_SMS:
         if iSMS_PhoneBook.SelectPersonsWithPhones(_pMarkerName)
         {
            var _tmpMarker : longint = InitMarker(_pMarkerName, 8, 50, 10);
            var _kol: longint =  GetMarkerCount(_tmpMarker);
            var i : longint = 0;
            StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Просмотр номеров сотрудников', 1);
            var _isErrorNumber : boolean = false;
            while i < _kol
            {
              var cPersNRec : comp = 0h;
              GetMarker(_tmpMarker, i, cPersNRec);
              if getfirst tmpEM_SMS where ((cPersNRec == tmpEM_SMS.CPERSONS )) <> tsOK
              {
                  GetPhonesToPers(cPersNRec);
                  _loop tmpPhonesToPers
                   {
                    if matchesmask(tmpPhonesToPers.MobilePhone,coMask_MobilePhone) AND tmpPhonesToPers.MobilePhone <> ''
                    {
                      insert tmpEM_SMS set
                         tmpEM_SMS.CPERSONS := cPersNRec
                        ,tmpEM_SMS.PHONE    := tmpPhonesToPers.MobilePhone
                        ;
                    }
                    else
                    {
                     _isErrorNumber := true;
                    }
                   }
              }
                  i++;
            }
            StopVisual;
           if _isErrorNumber
            {
              Message('Не все выбранные сотрудники добавлены: '
                + ''#13'' + 'Есть пустые или некорректные номера',error);
            }
           DoneMarker(_tmpMarker,_pMarkerName);
         };
       end;
     If getfirst tmpEM_SMS = tsOK {};
    rescanPanel(tntmpEM_SMS);
 }
 cmValue1:
 {
   Update Current EM_SMS_template;
   If Trim(_Description) = ''
   {
     message('Описание пустое',error);
     stop; abort; exit;
   }
   Var _GetCountSMS : word = GetCountSMS();
   if _GetCountSMS = 0
   {
    message('СМС пустая',error);
    stop; abort; exit;
   }

   If getfirst tmpEM_SMS <> tsOK
   {
     message('Выберите сотрудников',error);
     stop; abort; exit;
   }
  if message('Каждому сотруднику будет отослано "' + _GetCountSMS +'" СМС'
   + ''#13'' + 'Продолжить?', YesNo) = cmYes then
   {
      StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Просмотр номеров сотрудников', 1);
       var _DATEIN : date = cur_date;
       var _TIMEIN : time = cur_time;
       var _NUMBERSEND : longint = get_NUMBERSEND;

       _loop tmpEM_SMS
        {
         Insert EM_SMS set
             EM_SMS.PHONE       := tmpEM_SMS.PHONE
           , EM_SMS.CPERSONS    := tmpEM_SMS.CPERSONS
           , EM_SMS.NUMBERSEND  := _NUMBERSEND
           , EM_SMS.STATUS      := 1
           , EM_SMS.DATEIN      := _DATEIN
           , EM_SMS.TIMEIN      := _TIMEIN
           , EM_SMS.DESCRIPTION := _Description
           , EM_SMS.SMS_TEXT    := EM_SMS_template.SMS_TEXT
         ;
        }
      StopVisual;
      FillSMSByNumbers;
      CloseWindow(winCreateRassylkaSMS);
   }
 }
end;

end;
HandleEvent
    //-----------------------------
cmInit:
{
  CfsSetProp('Memo_EM_SMS.SMS_TEXT','Protect',true);
  FillSMSByNumbers;
}
cmOk:
{
  if getfirst  EM_SMS_template <> tsOK
   {
    insert EM_SMS_template set
       EM_SMS_template.cPersons    := USERID
     , EM_SMS_template.Phone       := String(USERID)
     , EM_SMS_template.DESCRIPTION :=  'EM_SMS_TEMPLATE'
    ;
   }
  if getfirst  EM_SMS_template = tsOK
   {
    delete all tmpEM_SMS;
    _Description := '';
    ClearMemoField(EM_SMS_template.SMS_TEXT);
    RunWindowModal(winCreateRassylkaSMS)
   }
   else
    {
      message('Не удалось создать системный шаблон',error);
    }
  RescanPanel(tntSMSByNumbers);
  RescanPanel(tnEM_SMS);
}


//-----------------------------
end;
end.
