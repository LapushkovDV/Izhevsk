/*************************************************************************************************\
* Наименование:  Движение персонала (с вредными условиями труда)                                  *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2243          |13/02/18 |Ермолов К.Р.            |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih

interface gp_shtat 'Параметры отчета' gray
Show at (,,43,5);

create view gp_shtat

var
datas, datapo: date;
counter: longint;
ExcelPath: string;

select persons.*, appointments.*, appointmentsPrev.*, advises.*, infpsn1.*, infpsn3.*, catalogs.*, katpodr.*, apphist.*, apphistPrev.*
from persons, appointments, synonym appointments appointmentsPrev, advises, infpsn1, infpsn3, catalogs, katpodr, apphist, synonym apphist apphistPrev;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  datas, noprotect;
  datapo, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    В период с:.@@@@@@@@@@  по:.@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  datas:= cur_date;
  datapo:= cur_date;
}

cmGo:
{
  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_shtat.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  counter:= 2;

  xlsetcellstringvalue('ПРИНЯТЫЕ C ' + datas + ' ПО ' + datapo, 1, 1, 1, 1);

  _loop persons where (( 'С' == persons.isemployee
    and datas <<= persons.appdate
    and datapo >>= persons.appdate
    and  persons.galdep /== katpodr.nrec
    and (katpodr.name <> '_Студенты' and katpodr.name <> '_Физические лица' and katpodr.name <> 'Ветераны')
    ))
  {
    counter++;
    xlsetcellnumbervalue(counter - 2, counter, 1, counter, 1);
    xlsetcellstringvalue(persons.fio, counter, 4, counter, 4);
    xlsetcellstringvalue(persons.borndate, counter, 5, counter, 5);
    xlsetcellstringvalue(persons.appdate, counter, 8, counter, 8);

    _loop appointments where ((persons.appointfirst == appointments.nrec))
    {
      xlsetcellstringvalue(appointments.strtabn, counter, 2, counter, 2);

      _loop apphist where ((appointments.nrec == apphist.cappoint)) and 1 = apphist.codoper and 1 = apphist.wstate
      {
        xlsetcellnumbervalue(apphist.taxrate, counter, 7, counter, 7);
      }

      _loop catalogs where ((appointments.department == catalogs.nrec))
      {
        xlsetcellstringvalue(catalogs.code, counter, 3, counter, 3);
      }

      _loop catalogs where ((appointments.post == catalogs.nrec))
      {
        xlsetcellstringvalue(catalogs.name, counter, 6, counter, 6);
      }
    }
  }

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 8);

  xlsetactivesheet(2);

  xlsetcellstringvalue('УВОЛЕННЫЕ C ' + datas + ' ПО ' + datapo, 1, 1, 1, 1);

  counter:= 2;

  _loop persons where ((  'С' == persons.isemployee
   and datas <<= persons.disdate (noindex)
   and datapo >>= persons.disdate(noindex)
   and persons.galdep == katpodr.nrec
   and (katpodr.name <> '_Студенты' and katpodr.name <> '_Физические лица' and katpodr.name <> 'Ветераны')
    ))
  {
    counter++;
    xlsetcellnumbervalue(counter - 2, counter, 1, counter, 1);
    xlsetcellstringvalue(persons.fio, counter, 4, counter, 4);
    xlsetcellstringvalue(persons.borndate, counter, 5, counter, 5);
    xlsetcellstringvalue(persons.disdate, counter, 8, counter, 8);

    _loop appointments where ((persons.appointlast == appointments.nrec))
    {
      xlsetcellstringvalue(appointments.strtabn, counter, 2, counter, 2);
      xlsetcellnumbervalue(appointments.taxrate, counter, 7, counter, 7);

      _loop catalogs where ((appointments.department == catalogs.nrec))
      {
        xlsetcellstringvalue(catalogs.code, counter, 3, counter, 3);
      }

      _loop catalogs where ((appointments.post == catalogs.nrec))
      {
        xlsetcellstringvalue(catalogs.name, counter, 6, counter, 6);
      }
    }
  }

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 8);

  xlsetactivesheet(3);

  xlsetcellstringvalue('ПЕРЕВЕДЕННЫЕ С ' + datas + ' ПО ' + datapo, 1, 1, 1, 1);

  counter:= 2;

  _loop persons where persons.disdate = 0 and persons.appointlast = 0 and 'С' = persons.isemployee
  {
    _loop appointments where ((persons.nrec == appointments.person and persons.galdep == katpodr.nrec)) and katpodr.name <> '_Студенты' and katpodr.name <> '_Физические лица' and katpodr.name <> 'Ветераны' and datas <= appointments.appointdate and datapo >= appointments.appointdate and appointments.dateend = 0 and appointments.nrec <> persons.appointfirst and appointments.lprizn = 0
    {
      counter++;
      xlsetcellnumbervalue(counter - 2, counter, 1, counter, 1);
      xlsetcellstringvalue(persons.fio, counter, 3, counter, 3);
      xlsetcellstringvalue(persons.borndate, counter, 4, counter, 4);
      xlsetcellstringvalue(appointments.appointdate, counter, 9, counter, 9);

      _loop apphist where ((appointments.nrec == apphist.cappoint)) and 5 = apphist.codoper and 1 = apphist.wstate
      {
        xlsetcellnumbervalue(apphist.taxrate, counter, 12, counter, 12);
      }

      _loop catalogs where ((appointments.department == catalogs.nrec))
      {
        xlsetcellstringvalue(catalogs.code, counter, 10, counter, 10);
      }

      _loop catalogs where ((appointments.post == catalogs.nrec))
      {
        xlsetcellstringvalue(catalogs.name, counter, 11, counter, 11);
      }



      _loop appointmentsPrev where ((appointments.person == appointmentsPrev.person)) and to_days(appointments.appointdate) - 1 = to_days(appointmentsPrev.dismissdate)
      {
        xlsetcellstringvalue(appointmentsPrev.strtabn, counter, 2, counter, 2);
        xlsetcellstringvalue(appointmentsPrev.dismissdate, counter, 5, counter, 5);
        xlsetcellnumbervalue(appointmentsPrev.taxrate, counter, 8, counter, 8);

        _loop catalogs where ((appointmentsPrev.department == catalogs.nrec))
        {
          xlsetcellstringvalue(catalogs.code, counter, 6, counter, 6);
        }

        _loop catalogs where ((appointmentsPrev.post == catalogs.nrec))
        {
          xlsetcellstringvalue(catalogs.name, counter, 7, counter, 7);
        }
      }
    }
  }

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 12);

  xlsetactivesheet(4);

  xlsetcellstringvalue('ИЗМЕНЕНИЕ ОКЛАДА С ' + datas + ' ПО ' + datapo, 1, 1, 1, 1);

  counter:= 2;

  _loop persons where persons.disdate = 0 and persons.appointlast = 0 and 'С' = persons.isemployee
  {
    _loop appointments where ((persons.nrec == appointments.person and persons.galdep == katpodr.nrec)) and katpodr.name <> '_Студенты' and katpodr.name <> '_Физические лица' and katpodr.name <> 'Ветераны'
    {
      _loop apphist where ((appointments.nrec == apphist.cappoint)) and 50 = apphist.codoper and datas <= apphist.drec and datapo >= apphist.drec and 1 = apphist.wstate
      {
        counter++;
        xlsetcellnumbervalue(counter - 2, counter, 1, counter, 1);
        xlsetcellstringvalue(appointments.strtabn, counter, 2, counter, 2);

        _loop catalogs where ((appointments.department == catalogs.nrec))
        {
          xlsetcellstringvalue(catalogs.code, counter, 3, counter, 3);
        }

        xlsetcellstringvalue(persons.fio, counter, 4, counter, 4);
        xlsetcellstringvalue(persons.borndate, counter, 5, counter, 5);

        _loop catalogs where ((appointments.post == catalogs.nrec))
        {
          xlsetcellstringvalue(catalogs.name, counter, 6, counter, 6);
        }

        xlsetcellstringvalue(apphist.drec, counter, 8, counter, 8);
        xlsetcellnumbervalue(apphist.taxrate, counter, 9, counter, 9);

        _loop apphistPrev where ((apphist.cappoint == apphistPrev.cappoint)) and apphist.drec > apphistPrev.drec and 1 = apphistPrev.wstate
        {
          if getlast apphistPrev = tsok
          {
            xlsetcellnumbervalue(apphistPrev.taxrate, counter, 7, counter, 7);
          }
        }
      }
    }
  }

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 9);

  xlsetactivesheet(1);

  xlsetsheetname(1, 'Принятые');
  xlsetsheetname(2, 'Уволенные');
  xlsetsheetname(3, 'Переведенные');
  xlsetsheetname(4, 'Изменение оклада');

StopVisual('',0);
xlkillExcel;

}

end;
end.

VipInterface UserReport_shtat Implements IUserReport;
Interface UserReport_shtat;

Procedure Run;
Begin
  runinterface(gp_shtat);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Изменения окладов сотрудников';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по вредным условиям труда';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
