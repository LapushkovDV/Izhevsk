#include RPD.vih

#include GP_RepLaborContract.vih

#component "Z_StaffOrders"

VipInterface RPD_209(RPD_Base_Raise)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base3.PrintFromPD;
  procedure IRPD_Base3.PrintRPD(typePrint: TPtr; fcEnter: word);
end;

interface RPD_209;

var IsPickFIO:boolean;

create view
from
  Catalogs RaiseCatDef209;

Browse brwRaise209 'Назначение доплат' (,, sci178Esc);
show at (, 9,,17);
table RaiseHist;
Fields
  RaiseCat.Name     'Вид доплаты/надбавки', ('Вид доплаты/надбавки.', hcStaffRaiseType, sci1378Esc):[20], protect;
  RaiseHist.rHSum   'Сумма/процент доплаты/надбавки', ('Сумма/процент доплаты/надбавки', hcStaffRaiseSum): [13.3], noprotect;
  CurrName          'Валюта', ('Валюта оплаты.', hcStaffRaiseCurr, sci1378Esc):[10] , protect;
  RaiseHist.dRec    'С даты', ('Дата, с которой установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered;
  RaiseHist.dDat2   'По дату', ('Дата, по которую установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered;
end;

procedure PickRaiseCatDef;
var cRec:comp;
{
  IsPickFIO:=false;

  cRec:=coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD209');//209. Назначение стипендии студентам
  if (recordexists RaiseCatDef209 where((cRec==RaiseCatDef209.cParent))=tsok) {//в настройке указана папка
    ParentSav := cRec;
    SaveMyDsk(RaiseHist.cRaiseType, 'PickCatalog2_DopTblCurPos');
    if (RunInterface(PickCatalog2, integer(-17), ParentSav, 7) = cmDefault)
    {
      //PreviousType := RaiseHist.cRaiseType; // взвести флаг того, что поменяли наименование
      set RaiseHist.cRaiseType := ParentSav;
      set RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
      set Raise.RaiseAttr := RaiseHist.iHAttr;
      set Raise.RaiseType := ParentSav;
      SetModified(true);
      UpDateTable;
      ReReadRecord(tnRaiseHist);
    }
  } else {
    set RaiseHist.cRaiseType := cRec;
    set RaiseHist.iHAttr := CheckTypeRaise(cRec);
    set Raise.RaiseAttr := RaiseHist.iHAttr;
    set Raise.RaiseType := cRec;
    SetModified(true);
    UpDateTable;
    ReReadRecord(tnRaiseHist);
  }
} //procedure PickRaiseCatDef;



//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  inherited::EnableDisable;

  if fnFieldsOpen // не утвержден
    SetHelpAndStatusContext(brwRaise209, -1, sci178Esc, 'StaffWinPr');
  else //утвержден
    SetHelpAndStatusContext(brwRaise209, -1, sci1Esc, 'StaffWinPr');

  ToggleFieldVisible(#ContDoc.wAttrDoc2,false);
  ToggleFieldVisible(#Catalogs.Name,false);
}

//******************************************************************************
// Печать индивидуального приказа вызванная из события cmPrintDoc
//******************************************************************************
procedure PrintFromPD;
{
  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,1,ContDoc.NRec,ContDoc.Person,Appointments.NRec);
}

procedure PrintRPD(typePrint: TPtr; fcEnter: word);
{
  if (typePrint=0)
    RunInterface('GP_NFormRD209', PartDoc.NRec);
  else
    inherited::PrintRPD(typePrint,fcEnter);
}

TableEvent table RaiseHist;
cmSetDefault:{
  case inherited :: handleEvent (cmSetDefault) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (IsPickFIO)
    PutCommand(cmValue32);
}
end;

HandleEvent
cmValue32:{
  PickRaiseCatDef;
}
cmPick:{
  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    #Persons.FIO:{
      if (ContDoc.Person=0) exit;
      if (IsValidAll(tnRaiseHist)) exit;

      var cRec:comp;
      cRec:=coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD209');//209. Назначение стипендии студентам
      if (cRec=0) exit;
      if (getfirst fastfirstrow RaiseCatDef209 where((cRec==RaiseCatDef209.NRec))<>tsok) exit;

      IsPickFIO:=true;
      if (SelectFormat(brwRaise209))
        PutCommand(cmSetDefault);
    }
  end;
}
cmMulSelDO:{//Наследовать поле
  if UpdateTable
    UpdNeedField(CurField);
}
end;

end.
