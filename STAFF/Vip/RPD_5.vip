#include GP_RepLaborContract.vih
#include GP_SCUD_PersEdit.Vih

#component "Z_StaffOrders"

#doc
  Интерфейс приказа "Прием на работу"
  Доработки системы для учета в СКУД
#end

alter interface RPD_5;
overload
  procedure prFillMenu(_menuID: longint);
  function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
  Procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base.MyDel;
end;
//******************************************************************************
var
  iGP_SCUD_PersEdit:GP_SCUD_PersEdit;//для работы с картотекой в СКУД
Create View
as select
//#3314
  if(IsValid(#KlRejimPrev),(KlRejimPrev.NRejim +
           if(KlRejimPrev.Hours=0,'',' (' + string(KlRejimPrev.Hours) + ' ?.)')),
        '-')      (fieldname = fRejimStrPrev)
from KlRejim KlRejimPrev
where ((
  Appointments.WorkRegime == KlRejimPrev.Nrec//#3314
 ));

//******************************************************************************
//  Процедура удаления
//******************************************************************************
procedure IRPD_Base.MyDel;
{ if TitleDoc.wStatus=1
    iGP_SCUD_PersEdit.DeleteBufferPers(Persons.Nrec,ContDoc.ObjNrec,TitleDoc.Nrec,Contdoc.Nrec,PartDoc.TypeOper);
  inherited::MyDel;
} //procedure IRPD_Base.MyDel;

//******************************************************************************
//  Процедура утверждения индивидуального приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{ Result:=Inherited::ChildConfirmOneOrder(cNrec);
  if Result
  { iGP_SCUD_PersEdit.MakeBufferPers(Persons.Nrec,ContDoc.ObjNrec,TitleDoc.Nrec,Contdoc.Nrec,PartDoc.TypeOper)
  }
} //function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;

//включение стандартных пунктов контекстного меню приказа
procedure prFillMenu(_menuID: longint);
{
  inherited::prFillMenu(_menuID);

  if (NOAA.GetFirstAgreementByLink(GetCo4Agreement(), GetNRec4Agreement()) <> 0)
    AddMenuItem(_menuID, 'Печать доп. соглашения (Word)', cmValue17);
}

//******************************************************************************
// можно вынести в RPD_BASE, но тогда начинают идти 6 предупреждений на base_Payment
// да и EnableDisable в 8 перехвачена
//******************************************************************************
Create view vNotes
var
  nRecTable:comp;
  wChoice  :word;
From Notes
where ((
      wChoice     == Notes.choice
  and nRecTable   == Notes.Owner
));

File FMemo;

ExtendFormats scrDet5;
//******************************************************************************

screen scrDet5 (,hcStaffprikazt5, sciStaffTypical1Esc);
show at (, 5,,);
table NewAppoint;
  fields
    fRejimStrPrev ('Режим труда и продолжительность рабочего дня (недели), ч',
             hcStaffprikazt5):  protect,nodel,noPickbutton; //#3314
<<







                                    Предыдущий режим.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

