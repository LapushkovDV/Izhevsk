#component "Z_STAFF"

Alter interface RecWin12

Create view
as select
  *
from
  Catalogs CatalogsVuz
Where
((
    CompetencePers.ResComp[1] == CatalogsVuz.NRec
))
;

#include GP_File_hRef.Vpp
HandleEvent

cmPick:
  {
    if (CurField = #CATALOGSVUZ.NAME)
      if (RunInterface(PickCatalog2, -24, CompetencePers.ResComp[1], 0) = cmDefault)
        set CompetencePers.ResComp[1] := CompetencePers.ResComp[1];

    case inherited :: handleEvent (cmPick) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;
  }

cmDelOnProtect:
  {
    if (CurField = #CATALOGSVUZ.NAME)
      set CompetencePers.ResComp[1] := comp(0);

    case inherited :: handleEvent (cmPick) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;
  }

cmStaffSeeDopInfo:
{
  putcommand(cmValue68);
}
cmValue68:
{ pGP_File_hRef.InitParam(
   if(false,cgiNotEdit,0)   //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
                // Если документ только на чтение следует вызвать cgiNotEdit
  ,coPersons //_wTable    : word; указать код таблицы документа системы
  ,tmpPersons.Nrec //_cRec      : comp=0;   // указать поле в таблице
  ,1 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
  ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
    ,'Файлы по сотруднику ' + Persons.fio
   );
}
end;
end.


object 'Z_STAFF::RECWIN12' : InterfaceWindow {
  EmbName = 'Z_STAFF::RECEPTIONMAIN->';
  object TRCOMPETENCE : TreeBrowser {
    object 'Field: CATALOGSVUZ.NAME' : TreeColumn {
      Original = False;
      Visible = True;
      Hidden = False;
      Protect = True;
      Skip = False;
      UpCase = False;
      Password = False;
      NoValidCheck = True;
      PickButton = True;
      StatusCtx = 0;
      Title = 'Уч.заведение';
      HelpLine = 'Учебное заведение';
      FieldName = 'Field: CATALOGSVUZ.NAME';
      DefaultValue = '';
      Strings = ( // Список строк
      )
      StringsNull = 0;
      Index = 34;
      DefaultWidth = 21;
      TextAlign = 0;
      ButtonType = 0;
      DefaultPickButton = True;
      SpinInc = 0.0;
      SpinMin = 0.0;
      SpinMax = 0.0;
      NoAutoSize = False;
      EnumValues = ( // Список целых
      )
      PassiveFormat = '';
      Points = 0;
      MaxLen = 20;
      PrecisionVarName = '';
      HistoryID = 0;
      EditButton = False;
    } // Field: KATPODRPARENTFARM.NAME : Column
  } // TRCOMPETENCE : TreeBrowser
} // Z_STAFF::RECWIN12 : InterfaceWindow
