#include FeeSigners.vih
#include Query.vih
#include NumberOfAddAgreement.vih
#include CatFunc.vih
#include PsnFuncs.vih
#include AdrFunc.vih

#component "GP_Staff"

interface GP_NFormRD115;

var
  _feeSigners          : FeeSigners;
  _queryContDoc114     : IQuery;
  _numberOfAddAgreement: NumberOfAddAgreement new;
  _catalogsFunctions   : CatalogsFunctions;
  _personsFunctions    : PersonsFunctions;
  _addressFunc         : AddressFunc;

  _titleDocNrec   : comp;
  _typeOper       : word;
  _selPicksNrec   : comp;
  _curDataSetIndex: longint;    //счетчик для вывода dataset'а

create view
as select TitleDoc.Nrec
from TitleDoc, PartDoc, ContDoc, Persons, Appointments, Raise,
     DopTables, DopInfo, SelPicks, Persons SelPicksPersons
where ((
  _titleDocNrec  == TitleDoc.Nrec and
  _typeOper      == PartDoc.TypeOper and
  _titleDocNrec  == PartDoc.cDoc and
  PartDoc.Nrec   == ContDoc.cPart and
  ContDoc.Person == Persons.Nrec and
  ContDoc.cStr   == Appointments.Nrec and
  ContDoc.Nrec   == Raise.cRDop and
  1              == DopTables.StaffObj and //Доптаблица Проценты по ипотеке к возмещению
  1              == DopTables.NmbTbl and
  ContDoc.Person == DopInfo.cPerson and
  DopTables.Nrec == DopInfo.cDopTbl and
  _selPicksNrec  == SelPicks.Nrec and
  SelPicks.cRec  == SelPicksPersons.Nrec
))
;

parameters _titleDocNrec, _typeOper;

//#region query queryContDoc114
sql query queryContDoc114 =
select ContDoc.Nrec
from ContDoc ContDoc
join PartDoc PartDoc on PartDoc.Nrec = ContDoc.cPart
join TitleDoc TitleDoc on TitleDoc.Nrec = PartDoc.cDoc and TitleDoc.wStatus = 1
join Raise Raise on Raise.cRDop = ContDoc.Nrec and
                    Raise.FromDate <= :OnDate and
                   (Raise.ToDate   >= :OnDate or Raise.ToDate = #date(0,0,0))
where ContDoc.Person = :PersonNrec and ContDoc.TypeOper = 114
order by Raise.FromDate Desc;
//#endregion

function GetAgreementString: string;
{
  result := '';

  if _queryContDoc114 = nullref
    _queryContDoc114 := queryManager.createQuery(queryContDoc114);

  var rs: IResultSet;
  rs := _queryContDoc114.setParam('PersonNrec', Persons.Nrec)
                        .setParam('OnDate', TitleDoc.DocDate)
                        .getResultSet;
  if rs.getFirst = tsOk
  {
    var contdoc114Nrec: comp;
    contdoc114Nrec := rs.row.valAt(1);

    var agreementNrec: comp;
    agreementNrec := _numberOfAddAgreement.GetFirstAgreementByLink(coContDoc, contdoc114Nrec);

    result := _numberOfAddAgreement.GetAgreementString(agreementNrec);
  }
}

function GetSignerShortFio: string;
{
  result := '';
  _selPicksNrec := _feeSigners.GetSignerNrec;
  if getfirst SelPicks = tsOK
  {
    if getfirst SelPicksPersons = tsOk
      result := MyGetInitial(_personsFunctions.GetFIO(SelPicksPersons.Nrec),False)
    else
    {
      var s: string;
      s := _feeSigners.GetSignerFIO(1);
      /*
      case wGetTune('UP.STAFF.IFOSA') of
        1: s := GetSurnameWithInitials(s);
        2:
        {
          s := GetSurnameWithInitials(s);
          s := substr(s, pos(' ', s+' ') + 1, 255) + ' ' + substr(s, 1, pos(' ', s+' ') - 1);
        }
        3:
        {
          s := GetSurnameWithInitials(s);
          s := substr(s, pos(' ', s+' ') + 1, 255) + substr(s, 1, pos(' ', s+' ') - 1);
        }
      end;
      */

      result := MyGetInitial(s,False);
    }
  }
}

DataStream DTS_NForm115
(
  [NoDoc]        TitleDoc.DocNmb;
  [DDoc]         DateToStr(TitleDoc.DocDate,'DD.MM.YYYY');
  [RepOnDate]    TitleDoc.DocDate;
  [RepOnDay]     DateToStr(TitleDoc.DocDate,'DD');
  [RepOnMonth]   DateToStr(TitleDoc.DocDate,'month');
  [RepOnYear]    DateToStr(TitleDoc.DocDate,'YYYY');
  [RespReport]   sGetTune('User.FIO');

  dataset FeeSigners
  (
    [FeeSignerFio]        _feeSigners.GetSignerFIO(1);
    [FeeSignerFioShort]   GetSignerShortFio;
    [FeeSignerPosition]   _feeSigners.GetSignerPosition(1);
    [FeeSignerRole]       _feeSigners.GetSignerRole;
    [FeeSignerTabn]       _feeSigners.GetSignerTabn;
    [FeeSignerNumber]     _feeSigners.GetSignerNumber;
  );

  /*TypeData :
    1:  код документа
    2:  наименование документа
    3:  серия документа
    4:  номер документа
    5:  дата выдачи
    6:  кем выдан
   */
  table ContDoc
  (
    [TabNmb]    if(IsValid(#Persons), Persons.StrTabN, '');
    [FIO]       if(IsValid(#Persons), Persons.FIO, '');
    [FIOShort]  if(IsValid(#Persons), _personsFunctions.GetFIO(Persons.Nrec), '');
    [PasspSer]  if(IsValid(#Persons), _personsFunctions.GetDocPersons(Persons.Nrec, 3), '');
    [PasspNom]  if(IsValid(#Persons), _personsFunctions.GetDocPersons(Persons.Nrec, 4), '');
    [PasspDv]   if(IsValid(#Persons), Replace(String(_personsFunctions.GetDocPersons(Persons.Nrec, 5)), '/', '.'), '');
    [PasspV]    if(IsValid(#Persons), _personsFunctions.GetDocPersons(Persons.Nrec, 6), '');
    [PasspAddr] if(IsValid(#Persons), _addressFunc.GetFullAddressInd(Persons.PasspAddr), '');
    [LiveAddr]  if(IsValid(#Persons), _addressFunc.GetFullAddressInd(Persons.LiveAddr), '');
    [MobPhone]  if(IsValid(#Persons), _personsFunctions.GetCommunicationPer(Persons.Nrec, 3), '');
    [DepName]   if(IsValid(#Appointments), _catalogsFunctions.GetCatalogsName(Appointments.Department), '');
    [DepCode]   if(IsValid(#Appointments), _catalogsFunctions.GetCatalogsCode(Appointments.Department), '');
    [PostName]  if(IsValid(#Appointments), _catalogsFunctions.GetCatalogsName(Appointments.Post), '');
    [Agreement] GetAgreementString;
  );

  table Raise
  (
    [FromDate]      Raise.FromDate;
    [ToDate]        Raise.ToDate;
    [RaiseTypeName] _catalogsFunctions.GetCatalogsName(Raise.RaiseType);
    [Sum]           Raise.Sum;
    [RaiseAttr]     Raise.RaiseAttr;
  );

  table DopInfo
  (
    [Year]          DopInfo.fFldSum[1];
    [Month]         DopInfo.fFldSum[2];
    [Sum]           DopInfo.fFldSum[3];
    [Percent]       DopInfo.fFldSum[4];
  );
)

handleevent dataset FeeSigners
  cmPreProcess:
  {
    _curDataSetIndex := 0;
  }
  cmOnProcess:
  {
    if _curDataSetIndex = 0
    {
      if _feeSigners.GetSignerFirst ContinueDataset;
    }
    else
    {
      if _feeSigners.GetSignerNext ContinueDataset;
    }
    _curDataSetIndex++;
  }
end;// handleevent dataset FeeSigners

end;  //DataStream DTS_NForm115

function PrepareFeeSigners: boolean;
{
  _feeSigners.InitFeeSigners(cgReport_KASSFRO);
  result := _feeSigners.RunMainWindow(1);
}

function PrepareData: boolean;
{
  result := false;
  if getfirst TitleDoc != tsOk exit;
  if getfirst PartDoc != tsOk exit;
  if getfirst DopTables != tsOk exit;
  result := true;
}

HandleEvent
cmInit:
  {
    if PrepareFeeSigners
      if PrepareData
        RunFReport(DTS_NForm115, '', False);
    CloseInterface(cmDefault);
  }       // cmInit
end;      // HandleEvent

end.
