function bSetRepParam : boolean;  
{
  result := false;
  if RunWindowModal(WinRKParamEx)=cmDefault
    result := true;
}//function bSetRepParam
Function GetReportName: String;
{
  GetReportName := '#(GPNam) (ЭМ)';
}
function GetPriority : Integer;
{
  GetPriority := 10;
}
procedure initRKStatRepParam;
{
  initRK;
}
function dRepOnDateParam : date;
{
  dRepOnDateParam := dRep;
}
//--------------------------------------------------------
handleevent
  cmInit:
  {
    isStayAloneAll := true;
    PrintRepPage(true);
  }
  cmPick:
  {
    case CurField of
      #sPodr1:
        if (RunInterface('PICKCATALOGEX', -11, 0, Comp(100), mPodr1) = cmDefault)
          set sPodr1 := sSetPodrName(mPodr1);
      #sRekComm1:
        if (RunInterface('PICKCATALOGEX', -125, 0, Comp(100), mRekComm1) = cmDefault)
          {set sRekComm1 := sSetAnyRez(mRekComm1); isCheckCrossRecomm(mRekComm1, 1);}
      #sRekComm2:
        if (RunInterface('PICKCATALOGEX', -125, 0, Comp(100), mRekComm2) = cmDefault)
          {set sRekComm2 := sSetAnyRez(mRekComm2); isCheckCrossRecomm(mRekComm2, 2);}
      #sRekComm3:
        if (RunInterface('PICKCATALOGEX', -125, 0, Comp(100), mRekComm3) = cmDefault)
          {set sRekComm3 := sSetAnyRez(mRekComm3); isCheckCrossRecomm(mRekComm3, 3);}
      #sRekComm4:
        if (RunInterface('PICKCATALOGEX', -125, 0, Comp(100), mRekComm4) = cmDefault)
          {set sRekComm4 := sSetAnyRez(mRekComm4); isCheckCrossRecomm(mRekComm4, 4);}
      #sRekComm5:
        if (RunInterface('PICKCATALOGEX', -125, 0, Comp(100), mRekComm5) = cmDefault)
          {set sRekComm5 := sSetAnyRez(mRekComm5); isCheckCrossRecomm(mRekComm5, 5);}
      #sVidAtt1:
        if (RunInterface('PICKCATALOGEX', -126, 0, Comp(100), mVidAtt1) = cmDefault)
          set sVidAtt1 := sSetAnyRez(mVidAtt1);
      #sRezAtt1:
        if (RunInterface('PICKCATALOGEX', -124, 0, Comp(100), mRezAtt1) = cmDefault)
          set sRezAtt1 := sSetAnyRez(mRezAtt1);
      #sToExistFile:
      {
        set sToExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
      #sFromExistFile:
      {
        set sFromExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sPodr1:      {ClearMarker(mPodr1);    set sPodr1    := sSetPodrName(mPodr1);}
      #sRekComm1:   {ClearMarker(mRekComm1); set sRekComm1 := sSetAnyRez(mRekComm1);}
      #sRekComm2:   {ClearMarker(mRekComm2); set sRekComm2 := sSetAnyRez(mRekComm2);}
      #sRekComm3:   {ClearMarker(mRekComm3); set sRekComm3 := sSetAnyRez(mRekComm3);}
      #sRekComm4:   {ClearMarker(mRekComm4); set sRekComm4 := sSetAnyRez(mRekComm4);}
      #sRekComm5:   {ClearMarker(mRekComm5); set sRekComm5 := sSetAnyRez(mRekComm5);}
      #sVidAtt1 :   {ClearMarker(mVidAtt1 ); set sVidAtt1  := sSetAnyRez(mVidAtt1 );}
      #sRezAtt1 :   {ClearMarker(mRezAtt1 ); set sRezAtt1  := sSetAnyRez(mRezAtt1 );}
      #sToExistFile:{set sToExistFile:='';}
      #sFromExistFile:{set sFromExistFile:='';}
    end;
  }
  cmCheckField:
  {
    case CurField of
      #wToExistFile:
      {
        if wToExistFile = 1 
          ToggleFieldVisible(#sToExistFile,true )
        else
          ToggleFieldVisible(#sToExistFile,false);
      }
      #wFromExistFile:
      {
        if wFromExistFile = 1 
          ToggleFieldVisible(#sFromExistFile,true )
        else
          ToggleFieldVisible(#sFromExistFile,false);
      }
    end;
  }
end;


End.
