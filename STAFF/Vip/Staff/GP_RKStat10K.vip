function OpenNewRKS : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExistRKS : boolean;
{
  result := false;
  if xlOpenExcel(true)
  {
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlOpenWorkBook(sToExistFile)
      result := true;
  }
}

function SetParamRK : boolean;
{
  result := false;
  if RunWindowModal(WinRKParam)=cmDefault
    result := true;
}
/*
table struct ttSpecRK
(
  cPsn    : comp
, sTbNmb  : string
, sFIO    : string
, dRating : date
, sCompet : string
, dbWeight : double
, dbRating : double
, sExpert : string
, sRecom : string
, sFormTrn : string
, sInst : string
, sProvider : string
)
with index
(
  ttSpecRK01 = wRowRep + sFIO
);
*/
procedure PrintRash;
{
  var lLine : longint;
  var lRB, lRE, lCB, lCE : longint = 1;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Печать расшифровки.', 0);
  lRB := lRE := 2;
  lCB := 1;
  lLine:=0;
  xlMergeCells(1,1,1,4);
  xlSetCellStringValue('Расшифровка листа 10-к. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
  if isvalid(#ttSpecRK)
  {
    lCE := 0;
    lCE++; xlSetCellStringValue('№пп',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Табельный №',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Тип данных',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата оценки',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Наименование компетенции',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Удельный вес',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Оценка',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Эксперт',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Рекомендации',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Форма обучения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Учебное заведение',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Поставщики образовательных услуг',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Результат аттестации',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Номер документа'+chr(10)+'(аттестации)',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата документа'+chr(10)+'(аттестации)',lRE,lCE,lRE,lCE);
    lRE++;
    _loop ttSpecRK ordered index ttSpecRK01
    {
/*
, sTbNmb  : string
, sFIO    : string
, dRating : date
, sCompet : string
, dbWeight : double
, dbRating : double
, sExpert  : string
, sRecom   : string
, sFormTrn : string
, sInst     : string
, sProvider : string
*/
      if (not NextVisual) break;
      lCE := 0;
      lCE++; xlSetCellStringValue(++lLine               ,lRE,lCE,lRE,lCE);
      lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttSpecRK.sTbNmb       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sFIO         ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sType        ,lRE,lCE,lRE,lCE);
      lCE++; if ( ttSpecRK.dRating<>0 )    xlSetCellDateValue(ttSpecRK.dRating   ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sCompet      ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.dbWeight     ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.dbRating     ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sExpert      ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sRecom       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sFormTrn     ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sInst        ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sProvider    ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sRezAtt      ,lRE,lCE,lRE,lCE);
      lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttSpecRK.sNomDocAtt   ,lRE,lCE,lRE,lCE);
      lCE++; if ( ttSpecRK.dDatDocAtt<>0 ) xlSetCellDateValue(ttSpecRK.dDatDocAtt,lRE,lCE,lRE,lCE);
      lRE++;
    }
  }
  lRE--;
  xlWrapText(lRB,lCB,lRB,lCE);
  xlAutoFit(lRB+1,lCB,lRE,lCE);
  xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
  StopVisual;
}

procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  initRK;

  if isStayAlone
    if SetParamRK
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);

  if isDoRep
  {
    MakeRK;
    if isDataRK
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNewRKS  ;}
        if wToExistFile = 1 {isOkFile := OpenExistRKS;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        PrintRK;

        if (wPrintRash = 1) and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='10-к' break;
          }
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 10-К'); 
          xlSetActiveSheet(i);
          PrintRash;
        }

        xlSetActiveSheetByName('10-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }
    else if isStayAlone message('Нет данных для отчета.');
  }
  SaveRK;
  ClearRK;
  closeinterface(cmDefault);
}
