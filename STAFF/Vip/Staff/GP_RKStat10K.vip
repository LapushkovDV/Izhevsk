#include GP_RKStat.vih
#include CatFunc.vih
#include StrFunc.vih
#include APPFUNCS.VIH
#include TotalOrganizationAttributes.vih
#include GP_UDR_RKStat.vih

#define GPInt GP_RKStat_List10K // #(GPInt)
#define GPNam 10-К "Сведения об оценке персонала" ЭМ // #(GPNam)

VipInterface #(GPInt) Implements IGP_RKStat;
Interface #(GPInt);

const
#include Excel.inc;
end;
#include TotalOrganizationAttributes.var

table struct ttStatRK
(
  wRow  : word
, dbVal : array [1..2] of double
)
with index
(
  ttStatRK01 = wRow
);

table struct ttSpecRK
(
  cPsn        : comp
, sTbNmb      : string
, sFIO        : string
, dRating     : date
, sCompet     : string
, dbWeight    : double
, dbRating    : double
, sExpert     : string
, sRecom      : string
, sFormTrn    : string
, sInst       : string
, sProvider   : string
, sType       : string
, sRezAtt     : string
, sNomDocAtt  : string
, dDatDocAtt  : date
, cAttestation: comp
)
with index
(
  ttSpecRK01 = sFIO + dRating
, ttSpecRK02 = cPsn + cAttestation
);

table struct ttOtherResult
(
  sOtherName : string
)
with index
(
  ttOtherResult01 = sOtherName
);

var
  dRep          : date;
  iCatFunc      : CatalogsFunctions;
  iAppFuncs     : AppointmentsFunctions;
  iUDR          : GP_UDR_RKStat;
  sFullName     : string;
  sPodr1        : string;
  mPodr1        : TPtr;
  sRekComm1
, sRekComm2
, sRekComm3
, sRekComm4
, sRekComm5     : string;
  mRekComm1
, mRekComm2
, mRekComm3
, mRekComm4
, mRekComm5     : TPtr;
  sRezAtt1      : string;
  mRezAtt1      : TPtr;
  sVidAtt1      : string;
  mVidAtt1      : TPtr;
  isFilterPodr  : boolean;
  wPrintRash    : word;
  wToExistFile  : word;
  sToExistFile  : string;
  cUprComp,
  cCorpComp,
  cProfComp     : comp;
//  cRekCommCat   : comp;
  isStayAloneAll: boolean = false;
  wFromExistFile  : word;
  sFromExistFile  : string;


create view
var
  dBeg
 ,dEnd     : date;
from
  ttStatRK
, ttSpecRK
, ttOtherResult
, HistCompetence
, Expert
, CompetencePers
, PlanAtt
, Attestation
, Appointments
, Persons
, Catalogs
, ExClassVal
, ExClassSeg
where
((
                         dBeg<<= HistCompetence.dBeg (noindex) and (HistCompetence.dBeg <= dEnd)
and       HistCompetence.nRec == Expert.cSourceRec
and HistCompetence.cSourceRec == CompetencePers.nRec
and                      dBeg<<= PlanAtt.Dat1 and (PlanAtt.Dat1 <= dEnd)
))
;

procedure InitGroupComp;
{
  if (getfirst Catalogs where trim(Catalogs.Name) = 'Управленческие компетенции'  ) = tsOk
    cUprComp  := Catalogs.nRec;
  if (getfirst Catalogs where trim(Catalogs.Name) = 'Корпоративные компетенции'   ) = tsOk
    cCorpComp := Catalogs.nRec;
  if (getfirst Catalogs where trim(Catalogs.Name) = 'Профессиональные компетенции') = tsOk
    cProfComp := Catalogs.nRec;
//  if ( getfirst Catalogs where((integer(-125) == Catalogs.SysCode)) = tsOk )
//    cRekCommCat := Catalogs.nRec;
  if cUprComp = 0 or cCorpComp = 0 or cProfComp = 0 message('Не проинициализировались каталоги компетенций');
  
}

function wWhatRowComp(cRecComp : comp) : word;
{
  result := 0;
  if getfirst Catalogs where ((cRecComp == Catalogs.nRec)) = tsOk
  {
    if Catalogs.cParent = cUprComp or Catalogs.cParent = cCorpComp 
      result := 3
    else
    if Catalogs.cParent = cProfComp
      result := 6;
  }
}
//iCatFunc.GetCatalogsName(PlanAtt.cKateg);
function wWhatRowAtt(_cRecComp : comp) : word;
{
  var sCodeAtt : string;
//  var wResult : word;
  result := 0;

  if FoundMarker(mRekComm1, _cRecComp)
    result := 9;
  if FoundMarker(mRekComm2, _cRecComp)
    result := 11;
  if FoundMarker(mRekComm3, _cRecComp)
    result := 13;
  if FoundMarker(mRekComm4, _cRecComp)
    result := 15;
  if FoundMarker(mRekComm5, _cRecComp)
    result := 17;
  if ( result = 0 )
    if ( _cRecComp <> 0 )
      result := 19;
//message(result+' '+iCatFunc.GetCatalogsName(_cRecComp));
/*
  sCodeAtt := iCatFunc.GetCatalogsCode(cRecComp);
  case sCodeAtt of
    '110': wResult :=  9;
    '120': wResult := 11;
    '130': wResult := 13;
    '140': wResult := 15;
    '150': wResult := 17;
  else     wResult := 19;
  end;
*/

  if result = 19
  {
    sCodeAtt := iCatFunc.GetCatalogsName(_cRecComp);
    if ( trim(sCodeAtt) <> '' )
      if ( getfirst ttOtherResult where ((sCodeAtt == ttOtherResult.sOtherName)) <> tsOk )
      {
        ClearBuffer(#ttOtherResult);
        ttOtherResult.sOtherName := sCodeAtt;
        insert current ttOtherResult;
      }
  }
}

function wWhatRowResource(cRecAny : comp) : word;
{
  result := 0;
  if getfirst ExClassVal where((cRecAny == ExClassVal.cRec and word(31) == ExClassVal.ClassCode)) = tsOk
    if getfirst ExClassSeg where((ExClassVal.cClassSeg == ExClassSeg.nRec)) = tsOk
      case ExClassSeg.Value of
      'ССП' : result := 25;
      'ОТР' : result := 27;
      'ВПРФ',
      'ВП'  : result := 29;
      end;
}

function sSetPodrName(mSetPdr: TPtr): string;
{
  if (getMarkerCount(mSetPdr) = 0)
  {
    result := 'Все подразделения';
    exit;
  }
  else
    if (getMarkerCount(mSetPdr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько подразделений (' + string(getMarkerCount(mSetPdr)) + ')';
}
function sSetAnyRez(_mAny: TPtr): string;
{
  if (getMarkerCount(_mAny) = 0)
  {
    result := 'Не выбраны значения';
    exit;
  }
  else
    if ( getMarkerCount(_mAny) = 1 )
    {
      var cTmp: comp;
      GetMarker(_mAny, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько значений (' + string(getMarkerCount(_mAny)) + ')';
}

function isCheckCrossRecomm(_mAny: TPtr; wRecomm: word): boolean;
{
  var mTemp  : tPtr = InitMarker('', 8, 1000, 100);
  var cRecomm: comp;
  var ii     : integer;
  var sRecomm: array[1..5] of string[50];
  sRecomm[1] := 'к назначению на должность'; //sRecomm[wRecomm]
  sRecomm[2] := 'к зачислению в кадровый резерв';        
  sRecomm[3] := 'к поощрению';                           
  sRecomm[4] := 'к прохождению дополнительного обучения';
  sRecomm[5] := 'к увольнению с занимаемой должности';   

  
  result := false;
  
  if ( wRecomm <> 1 ) AddMarker(mTemp, mRekComm1);
  if ( wRecomm <> 2 ) AddMarker(mTemp, mRekComm2);
  if ( wRecomm <> 3 ) AddMarker(mTemp, mRekComm3);
  if ( wRecomm <> 4 ) AddMarker(mTemp, mRekComm4);
  if ( wRecomm <> 5 ) AddMarker(mTemp, mRekComm5);
  
  for (ii:= 0; ii < GetMarkerCount(_mAny); ii++)
  {
    GetMarker(_mAny, ii, cRecomm);
    if FoundMarker(mTemp, cRecomm)
    {
      message('В строке: '+sRecomm[wRecomm]+''#3+Chr(13)+'Рекомендация: '+iCatFunc.GetCatalogsName(cRecomm)+''#3+Chr(13)+' уже выбрана в другом параметре!'#3, Error);
      result := true;
    }
  }

  DoneMarker(mTemp, '');
}

function isDeptNot4Report(cPsn : comp; dAny : date) : boolean;
{
  result := false;
  if isFilterPodr
    if GetFirst Appointments where ((iAppFuncs.GetAppNrec_OnDate(cPsn, dAny) == Appointments.NRec)) = tsOk
      if (not FoundMarker(mPodr1,Appointments.Department))
        result := true;
}

function OpenFromRKS : boolean;
{
  result := false;
  xlOpenExcel(true);
  xlDisplayAlerts(false);
  if xlOpenWorkBook(sFromExistFile)
    result := true;
}
function CloseFromRKS : boolean;
{
  result := false;
  if xlCloseWorkBookByName(sFromExistFile)
//  if xlKillExcel
    result := true;
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
  xlDisplayAlerts(true);
  if isStayAloneAll
    xlKillExcel;
}

procedure LocateSetRow(wRowT : word; isCur : boolean);
{
  if wRowT = 0 exit;
  ClearBuffer(#ttStatRK);
  if getfirst ttStatRK where ((wRowT==ttStatRK.wRow))<>tsOk
  {
    ttStatRK.wRow := wRowT;
    insert current ttStatRK;
  }
  if isCur
    ttStatRK.dbVal[1] += 1
  else
    ttStatRK.dbVal[2] += 1;
  update current ttStatRK;
}
procedure LocateSetRowPost(wRowT : word; dbValT : double);
{
  ClearBuffer(#ttStatRK);
  ttStatRK.wRow     := wRowT;
  ttStatRK.dbVal[1] := dbValT;
  insert current ttStatRK;
}

function LocateReturnRow(wRowT : word; var dbValT1,dbValT2 : double) : boolean;
{
  result := false;
  if wRowT = 0 exit;
  if getfirst ttStatRK where ((wRowT==ttStatRK.wRow))=tsOk
  {result :=  true; dbValT1 := ttStatRK.dbVal[1]; dbValT2 := ttStatRK.dbVal[2];}
}

function isCurSet(dAny : date) : boolean;
{
  if dAny >= date( 1, 1,Year(dRep)) and dAny <= dRep
    result := true
  else
    result := false;
}

procedure SetRowSpec(cPsnT : comp; wModeT : word);
{
  ClearBuffer(#ttSpecRK);
  if getfirst Persons where((cPsnT == Persons.nRec)) = tsOk
  {
    ttSpecRK.cPsn   := cPsnT;
    ttSpecRK.sTbNmb := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
    ttSpecRK.sFIO   := Persons.FIO;
  }
  if wModeT = 1 //компетенции
  {
    ttSpecRK.dRating := HistCompetence.dBeg;
    if getfirst Catalogs where ((CompetencePers.cName == Catalogs.nRec)) = tsOk
      ttSpecRK.sCompet := iCatFunc.GetCatalogsName(Catalogs.cParent);
    ttSpecRK.sRecom    := iCatFunc.GetCatalogsName(CompetencePers.cName);
    ttSpecRK.dbRating  := Expert.doRating;
    if isvalid(#Expert)
    {
      ttSpecRK.dbWeight := Expert.wWeight;
      
      if getfirst Persons where((Expert.cPers == Persons.nRec)) = tsOk
        ttSpecRK.sExpert := Persons.FIO;
    }
    ttSpecRK.sInst := iCatFunc.GetCatalogsName(CompetencePers.ResComp[1]);
    if getfirst ExClassVal where((CompetencePers.ResComp[1] == ExClassVal.cRec and word(31) == ExClassVal.ClassCode)) = tsOk
    if getfirst ExClassSeg where((ExClassVal.cClassSeg == ExClassSeg.nRec)) = tsOk
    {
      ttSpecRK.sProvider := ExClassSeg.Name;
    }
    ttSpecRK.sType := 'Компетенции';
  }
  if wModeT = 2 //аттестации
  {
    if getfirst Attestation where ((PlanAtt.cRef3 == Attestation.nRec)) = tsOk
    {
      ttSpecRK.sCompet := iCatFunc.GetCatalogsName(Attestation.cType);
      ttSpecRK.cAttestation := Attestation.nRec;
    }
    ttSpecRK.dRating := PlanAtt.Dat1;
    ttSpecRK.sRecom  := iCatFunc.GetCatalogsName(PlanAtt.cKateg);//iCatFunc.GetCatalogsName(PlanAtt.cKateg);
    ttSpecRK.sType   := 'Аттестация';
    ttSpecRK.sRezAtt   := iCatFunc.GetCatalogsName(PlanAtt.cType);//iCatFunc.GetCatalogsName(Attestation.RESULT);
    ttSpecRK.sNomDocAtt:= Attestation.ATTNMB;
    ttSpecRK.dDatDocAtt:= Attestation.ATTDATE;
  }
  insert current ttSpecRK;
}

function isAttFilterOk(_cRez, _cAtt: comp): boolean; //PlanAtt.cType, PlanAtt.cRef3
{
  result := false;
  if ( getfirst Attestation where ((_cAtt == Attestation.nRec)) = tsOk )
    if ( FoundMarker(mRezAtt1, _cRez) and FoundMarker(mVidAtt1, Attestation.cType) )
      result := true;
}

function isPsnFirstAtt(_cPsn, _cAtt: comp): boolean;
{
  if ( getfirst ttSpecRK where ((_cPsn == ttSpecRK.cPsn and _cAtt == ttSpecRK.cAttestation)) <> tsOk)
    result := true
  else
    result := false;
}

procedure InitPrevResults;
{
  if OpenFromRKS
  {
    if xlSetActiveSheetByName('10-к')
    { //xlGetCellValue
      var dbFrom: double;
      dbFrom := 0;
      if xlGetCellValue( 7, 4, dbFrom)
      {
        ClearBuffer(#ttStatRK);
        if ( getfirst ttStatRK where ((3 == ttStatRK.wRow)) <> tsOk )
        {
          ttStatRK.wRow := 3;
          insert current ttStatRK;
        }
        ttStatRK.dbVal[2] := dbFrom;
        update current ttStatRK;
      }
      dbFrom := 0;
      if xlGetCellValue(10, 4, dbFrom)
      {
        ClearBuffer(#ttStatRK);
        if ( getfirst ttStatRK where ((6 == ttStatRK.wRow)) <> tsOk )
        {
          ttStatRK.wRow := 6;
          insert current ttStatRK;
        }
        ttStatRK.dbVal[2] := dbFrom;
        update current ttStatRK;
      }
    }
    if CloseFromRKS {}
  }
}

procedure MakeRK;
{
  var dbValT  : array [1..2] of double;
  var wRowT : word;
  var isPrintRash: boolean = ( wPrintRash = 1 );

  isFilterPodr := ( GetMarkerCount(mPodr1) > 0 );
  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Формируются данные для Листа 10-к.', 0);
//  if (GetMarkerCount(mPodr1) > 0) isFilterPodr:=true else isFilterPodr:=false;
  set dBeg := date(1,1,Year(dRep)-1);
  set dEnd := dRep;
  InitGroupComp;
/*
                         dBeg<<= HistCompetence.dBeg (noindex) and (HistCompetence.dBeg <= dEnd)
and       HistCompetence.nRec == Expert.cSourceRec
and HistCompetence.cSourceRec == ConpetencePers.nRec
function isDeptNot4Report(cPsn : comp; dAny : date) : boolean;
function wWhatRowComp(cRecComp : comp) : word;
function isCurSet(dAny : date) : boolean;
function LocateReturnRow(wRowT : word; var dbValT1,dbValT2 : double) : boolean;
procedure LocateSetRow(wRowT : word; isCur : boolean);
function wWhatRowAtt(cRecComp : comp) : word;

*/
  if isvalid(#HistCompetence)
  _loop HistCompetence
  {
    if ( wFromExistFile = 1 )
      if not isCurSet(HistCompetence.dBeg)
        continue;
    if (not NextVisual) break;
    if isDeptNot4Report(HistCompetence.cPers, HistCompetence.dBeg) continue;
    if isvalid(#CompetencePers)
    {
      wRowT := wWhatRowComp(CompetencePers.cName);
      if wRowT <> 0
      {
        LocateSetRow(wRowT,isCurSet(HistCompetence.dBeg));
        LocateSetRow(wWhatRowResource(CompetencePers.ResComp[1]),isCurSet(HistCompetence.dBeg));
        if ( isPrintRash ) SetRowSpec(HistCompetence.cPers, 1);
      }
    }
  }
  if isvalid(#PlanAtt)
  _loop PlanAtt
  {
    if ( wFromExistFile = 1 )
      if not isCurSet(PlanAtt.Dat1)
        continue;
    if (not NextVisual) break;
    if isDeptNot4Report(PlanAtt.cPers, PlanAtt.Dat1) continue;
    var wRowAtt: word = wWhatRowAtt(PlanAtt.cKateg);
    if isAttFilterOk(PlanAtt.cType, PlanAtt.cRef3) //PlanAtt.cType, PlanAtt.cRef3
    {
      if isPsnFirstAtt(PlanAtt.cPers, PlanAtt.cRef3)
      {
        LocateSetRow(6, isCurSet(PlanAtt.Dat1));
        if ( wRowAtt <> 0 )
          LocateSetRow(wRowAtt, isCurSet(PlanAtt.Dat1));
      }
      if ( isPrintRash ) SetRowSpec(PlanAtt.cPers, 2);
    }
  }
  if ( wFromExistFile = 1 )
  {
    InitPrevResults;
  }
  if isvalid(#ttStatRK)
  {
    if LocateReturnRow(3, dbValT[1],dbValT[2])
      LocateSetRowPost(5,if(dbValT[2]<>0,dbValT[1]/dbValT[2],0));
    if LocateReturnRow(6, dbValT[1],dbValT[2])
      LocateSetRowPost(8,if(dbValT[2]<>0,dbValT[1]/dbValT[2],0));
  }
  StopVisual;
}

function isDataRK : boolean;
{
  if isvalid(#ttStatRK)
    result := true
  else
    result := false;
}

procedure PrintRK;
{
  var dbValT  : array [1..2] of double;
  var i : integer;

  if isDataRK
  if xlSetActiveSheetByName('10-к')
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Выгружаю данные для Листа 10-к в Excel.', 0);
    TOA.Bind(0);
    xlSetCellStringValue(Trim(TOA1.GetNaming.GetFullName()),2,3,2,3);
//    xlSetCellStringValue(DateToStr(dRep,'DD.MM.YYYY'),3,3,3,3); // в представленном заказчиком файле такая дата красная.
    xlSetCellDateValue(dRep,3,3,3,3);
    for(i:=3;i<=31;i++)
    {
      if (not NextVisual) break;
      if LocateReturnRow(i, dbValT[1], dbValT[2])
      {
        xlSetCellNumberValue(dbValT[1],4+i,4,4+i,4); 
      }
    }
    if isvalid(#ttOtherResult)
    _loop ttOtherResult
      xlAddCellStringValue(ttOtherResult.sOtherName+chr(10),36,4);

    StopVisual;
  }
}

procedure SaveRK;
{
  iUDR.SaveMarker('RKS10_mPodr1'   , mPodr1   );
  iUDR.SaveMarker('RKS10_mRekComm1', mRekComm1);
  iUDR.SaveMarker('RKS10_mRekComm2', mRekComm2);
  iUDR.SaveMarker('RKS10_mRekComm3', mRekComm3);
  iUDR.SaveMarker('RKS10_mRekComm4', mRekComm4);
  iUDR.SaveMarker('RKS10_mRekComm5', mRekComm5);
  iUDR.SaveMarker('RKS10_mVidAtt1' , mVidAtt1 );
  iUDR.SaveMarker('RKS10_mRezAtt1' , mRezAtt1 );
  DoneMarker(mPodr1   , '');
  DoneMarker(mRekComm1, '');
  DoneMarker(mRekComm2, '');
  DoneMarker(mRekComm3, '');
  DoneMarker(mRekComm4, '');
  DoneMarker(mRekComm5, '');
  DoneMarker(mVidAtt1 , '');
  DoneMarker(mRezAtt1 , '');

  iUDR.SaveDate  ('RKS10_dRep'        , dRep        );
  iUDR.SaveWord  ('RKS10_wToExistFile', wToExistFile);
  iUDR.SaveString('RKS10_sToExistFile', sToExistFile);
  iUDR.SaveWord  ('RKS10_wPrintRash'  , wPrintRash  );
  iUDR.SaveWord  ('RKS10_wFromExistFile', wFromExistFile);
  iUDR.SaveString('RKS10_sFromExistFile', sFromExistFile);
}
procedure ClearRK;
{
  delete all from ttStatRK;
}
procedure initRK;
{
  set dRep := iUDR.ReadDate('RKS10_dRep');
  if dRep = 0
    set dRep := To_Date(31,12,Year(Cur_Date));
  
  set wPrintRash   := iUDR.ReadWord  ('RKS10_wPrintRash'  );
  set sToExistFile := iUDR.ReadString('RKS10_sToExistFile');
  set wToExistFile := iUDR.ReadWord  ('RKS10_wToExistFile');
  if wToExistFile = 1 
    ToggleFieldVisible(#sToExistFile,true )
  else
    ToggleFieldVisible(#sToExistFile,false);
 
  set sFromExistFile := iUDR.ReadString('RKS10_sFromExistFile');
  set wFromExistFile := iUDR.ReadWord  ('RKS10_wFromExistFile');
  if wFromExistFile = 1 
    ToggleFieldVisible(#sFromExistFile,true )
  else
    ToggleFieldVisible(#sFromExistFile,false);
  
  mPodr1    := iUDR.ReadMarker('RKS10_mPodr1'   ); set sPodr1    := sSetPodrName(mPodr1);
  mRekComm1 := iUDR.ReadMarker('RKS10_mRekComm1'); set sRekComm1 := sSetAnyRez(mRekComm1); isCheckCrossRecomm(mRekComm1, 1);
  mRekComm2 := iUDR.ReadMarker('RKS10_mRekComm2'); set sRekComm2 := sSetAnyRez(mRekComm2); isCheckCrossRecomm(mRekComm2, 2);
  mRekComm3 := iUDR.ReadMarker('RKS10_mRekComm3'); set sRekComm3 := sSetAnyRez(mRekComm3); isCheckCrossRecomm(mRekComm3, 3);
  mRekComm4 := iUDR.ReadMarker('RKS10_mRekComm4'); set sRekComm4 := sSetAnyRez(mRekComm4); isCheckCrossRecomm(mRekComm4, 4);
  mRekComm5 := iUDR.ReadMarker('RKS10_mRekComm5'); set sRekComm5 := sSetAnyRez(mRekComm5); isCheckCrossRecomm(mRekComm5, 5);
  mVidAtt1  := iUDR.ReadMarker('RKS10_mVidAtt1' ); set sVidAtt1  := sSetAnyRez(mVidAtt1 );
  mRezAtt1  := iUDR.ReadMarker('RKS10_mRezAtt1' ); set sRezAtt1  := sSetAnyRez(mRezAtt1 );
}

function isCheckRepParam(isStayAlone : boolean) : boolean;
{
  result := false;
  if dRep = 0
  {if isStayAlone message('Не задана дата!'); exit;}
  if ( Day(dRep) <> 31 and Month(dRep) <> 12 )
  {
    if isStayAlone
      if ( message('Дата формирования отчета отличается от регламентной!'#3+chr(13)+'Продолжить?'#3, Information+yesNo) <> cmYes )
        exit;
  }
//  {if isStayAlone message('Некорректно задана дата!'+chr(13)+'Дата формирования отчета - 31 декабря.'); exit;}
  if wToExistFile = 1
    if not ExistFile(sToExistFile)
    {if isStayAlone message('Ошибка открытия файла!'); exit;}
  if ( wFromExistFile = 1 )
    if not ExistFile(sFromExistFile)
    {if isStayAlone message('Ошибка открытия входного файла!'); exit;}
  if ( ( GetMarkerCount(mRekComm1) = 0 )
    or ( GetMarkerCount(mRekComm2) = 0 )
    or ( GetMarkerCount(mRekComm3) = 0 )
    or ( GetMarkerCount(mRekComm4) = 0 )
    or ( GetMarkerCount(mRekComm5) = 0 )
    or ( GetMarkerCount(mRezAtt1 ) = 0 )
    or ( GetMarkerCount(mVidAtt1 ) = 0 ) )
  {if isStayAlone message('Не задан один из обязательных параметров!', Error); exit;}
  if (  isCheckCrossRecomm(mRekComm1, 1)
     or isCheckCrossRecomm(mRekComm2, 2)
     or isCheckCrossRecomm(mRekComm3, 3)
     or isCheckCrossRecomm(mRekComm4, 4)
     or isCheckCrossRecomm(mRekComm5, 5) )
  {if isStayAlone message('Пересечение рекоммендаций заданных в параметрах!', Error); exit;}
  result := true;
}
