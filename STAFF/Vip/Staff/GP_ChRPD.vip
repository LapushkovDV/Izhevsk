// Существующий объект CheckRPD.vih не оптимизирован по быстродействию для больших объёмов данных

#include GP_ChRPD.vih

Interface GP_ChRPD;

Create view
var
  cRecContDoc    : comp;
  isUsePartOrders: boolean;
from
 TitleDoc
,PartDoc
,ContDoc
where
((
    cRecContDoc   == ContDoc.nRec
and ContDoc.cPart == PartDoc.NRec
and PartDoc.cDoc  == TitleDoc.NRec
));

//приказ по ссылке утвержден или отсутствует
public function isConfirmed(cRecCD: comp): boolean;
{
  result := false;

  set cRecContDoc := cRecCD;

  if isvalid(#ContDoc)
    if isvalid(#PartDoc)
      if isvalid(#TitleDoc)
        if (TitleDoc.wStatus = word(1)) or (isUsePartOrders and (ContDoc.wYearPr = 1) or (ContDoc.wYearPr = 2))
          result := true;
}

handleevent

cmOnVipLoad:
{
  isUsePartOrders := boGetTune('UP.STAFF.USE_PART_ORDERS');
}

end;

end.
