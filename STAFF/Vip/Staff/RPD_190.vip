#include RPD.vih
#include ShowEmbMemo.vih

#component "Z_StaffOrders"

#doc
РПД 190 - заявка на работу в выходные и праздничные. При утверждении приказа никаких изменений в БД
не выполняется. В точке расширения GP_epConfirmOrder_RPD190 реализована установка статуса 2 в утвержденном
приказе.
#end
vipinterface RPD_190(RPD_90);
public:
  function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
  function IRPDCopy.CopyOneOrder(_cCont, _cContDest, _cPartDest: comp): comp;
  Procedure IRPD_Base.EnableDisable;
  Procedure IRPD_Base.MyDel;
end;

interface RPD_190;

ExtendFormats ScrDet90;

function GetWorkType: string; forward;

overloadformats ScrDet90;

var
  _showEmbMemo: ShowEmbMemo;

create view
select
  GetWorkType() (fieldname=GP_WorkType)
from
  AllMemo gpAllMemoWorkType
where ((
  coSalScale    == gpAllMemoWorkType.wTable and
  SalScale.Nrec == gpAllMemoWorkType.cRec and
  0             == gpAllMemoWorkType.Npp
))
;

create view vCopyMemoWorkType
var
  _newContDocNrec: comp;
  _salScaleLastDate: date;
  _salScaleFilialNo: comp;
  _salScaleLastUser: string;
  _salScaleFSum0: double;
select NewSalScale.Nrec
from SalScale NewSalScale, AllMemo
where ((
  0                    == NewSalScale.wTblCode and
  _newContDocNrec      == NewSalScale.cUnit and
  (NewSalScale.LastDate = _salScaleLastDate and
   NewSalScale.FilialNo = _salScaleFilialNo and
   NewSalScale.LastUser = _salScaleLastUser and
   NewSalScale.fSum0    = _salScalefSum0)   and
  coSalScale           == AllMemo.wTable    and
  NewSalScale.Nrec     == AllMemo.cRec      and
  0                    == AllMemo.Npp
));


File gp_file;

browse scrDet90 (,hcStaffWinPr, sci178Esc);  //работы в праздничные
show at (,7,,);
  table SalScale;
  Fields
    SalScale.LastDate  'Дата',
         ('Дата.', , sci1378Esc): [12,'DD/MM/YYYY'], noprotect, noautosize,
         {Font = {BackColor = if(not IsValid(#SalScale) or SalScale.LastDate = ZeroDate, ColorNeed, 0)}};
    SalScale.filialNo
      'Способ', 'оплаты'
        ('Платить ли сотруднику что-либо или он работает за отгул',, sci1378Esc):
          [list 10 ' ', 1 'за отгул', 0 'за оплату'], [12], protect, noautosize,
         {Font = {BackColor = if(not IsValid(#SalScale) or SalScale.filialNo = 10, ColorNeed, 0)}};
    UO_9X_field 'УО', ('Условное обозначение',,sci1378Esc): [20], protect, pickButton,
         {Font = {BackColor = if(not IsValid(#SalScale) or SalScale.LastUser = 0, ColorNeed, 0)}};
    fHoursAll 'Количество', 'часов', ('Количество часов'): [7], noprotect,
         {Font = {BackColor = if(not IsValid(#SalScale) or SalScale.fSum0 < 0.0001, ColorNeed, 0)}};
    fHoursEvening 'Количество', 'вечерних', ('Количество вечерних'): [7], noprotect;
    fHoursNight 'Количество', 'ночных', ('Количество ночных'): [7], noprotect;
    GP_WorkType 'Вид работы': [10], protect, pickbutton;
  end;

/*
browse ScrDet90 (,hcStaffWinPr, sci178Esc);
show at (,7,,);
  table SalScale;
  Fields
    GP_WorkType 'Вид работы': [10], protect, pickbutton;
end;
*/

//Возвращает первую строку мемо-поля вида работы к дню
function GetWorkType: string;
{
  result := '';
  if IsValidAll(#gpAllMemoWorkType)
    if gp_file.OpenMemo(gpAllMemoWorkType.Mem)
    {
      gp_file.Readln(result);
      gp_file.Close;
    }
}

Procedure IRPD_Base.EnableDisable;
{
  inherited::EnableDisable;
  //Скрываем элементы скрина с основанием
  SetFormatEnabled(ScrFoundation, false);
  var a: array[0..0] of longint;
  cfsEnumObjects('scrFoundation', a, false);
  var i: longint;
  for(i := 0; i < Count(a); i++)
    cfsSetProp(a[i], cfpHidden, True);
}

Procedure IRPD_Base.MyDel;
{
  _loop SalScale
    delete all gpAllMemoWorkType;
  inherited::MyDel;
}

function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{
  cNrec := cNrec;
  result := true;
}

function IRPDCopy.CopyOneOrder(_cCont, _cContDest, _cPartDest: comp): comp;
{
  result := inherited::CopyOneOrder(_cCont, _cContDest, _cPartDest);
  if result != 0
  {
    //Копируем виды работ к дням
    var memoTmpFileName: string = CreateTmpFileName;
    _loop SalScale
    {
      vCopyMemoWorkType._newContDocNrec   := result;
      vCopyMemoWorkType._salScaleLastDate := SalScale.LastDate;
      vCopyMemoWorkType._salScaleFilialNo := SalScale.FilialNo;
      vCopyMemoWorkType._salScaleLastUser := SalScale.LastUser;
      vCopyMemoWorkType._salScalefSum0    := SalScale.fSum0;
      if vCopyMemoWorkType.getFirst NewSalScale = tsOk
        _loop gpAllMemoWorkType
          if vCopyMemoWorkType.getfirst AllMemo != tsOk
          {
            vCopyMemoWorkType.ClearBuffer(vCopyMemoWorkType.tnAllMemo);
            vCopyMemoWorkType.AllMemo.wTable := coSalScale;
            vCopyMemoWorkType.AllMemo.cRec   := vCopyMemoWorkType.NewSalScale.Nrec;
            if vCopyMemoWorkType.insert current AllMemo = tsOk
            {
              ExportMemoToFile(gpAllMemoWorkType.Mem, memoTmpFileName, false);
              ImportFileToMemo(vCopyMemoWorkType.AllMemo.Mem, memoTmpFileName, false);
              vCopyMemoWorkType.update current AllMemo;
            }
          }
    }
    DeleteFile(memoTmpFileName);
  }
}

tableevent table SalScale;
  cmCheckField:
  {
    if inherited::handleevent(cmCheckField) = heAbort
      Abort;
    else if CurField = #SalScale.LastDate //Если изменилась дата - обновляем текст приказа
    {
      if SALSCALE.LASTDATE < cur_date
       then {
           set SALSCALE.LASTDATE := cur_date;
           message('Запрещено ставить дату в прошлое ',error);
           stop; abort; exit;
         }
      UpdateTable;
      //ContainerOfOrders подписан на OnIdle.
      //Там вызывается InsideReScan, на которое в свою очередь подписан OrdersList.
      //В обработчике InsideReScan OrdersList обновляется текст приказа
      OnIdle(ContDoc.nRec);
    }
  }
  cmDeleteRecord:
  {
    var c: comp = SalScale.Nrec;
    if inherited::handleevent(cmDeleteRecord) = heAbort
      Abort
    else
      delete all gpAllMemoWorkType where ((coSalScale == gpAllMemoWorkType.wTable and
                                           c          == gpAllMemoWorkType.cRec and
                                           0          == gpAllMemoWorkType.Npp));
  }
  cmCheckRecord:
  {
    if inherited::handleevent(cmCheckRecord) = heAbort
      Abort;
    else
      if _rpd90Helper.GetPersonsWorkMinOnDate(Persons.Nrec, SalScale.LastDate) > 0
      {
        Message(SalScale.LastDate + ' не является выходным днем для сотрудника', Error);
        Abort;
      }
  }
end;

handleevent
  cmPick:
  {
    //Обрабатываем редактирование/просмотр мемо с видом работ к дню
    if CurField = #GP_WorkType
    {
      SetModified(True);
      UpdateTable;
      _showEmbMemo.SetMemoParams(coSalScale, SalScale.Nrec, not fnFieldsOpen);
      if fnFieldsOpen
        _showEmbMemo.ShowEditMemoWin
      else
        _showEmbMemo.ShowViewMemoWin;
      ReReadRecord(#SalScale);
    }
    else
      case inherited::handleevent(cmPick) of
        heAbort: Abort;
        heStop: Stop;
      end;
  }
  cmDelOnProtect:
  {
    //Обрабатываем очистку мемо с видом работ к дню
    if CurField = #GP_WorkType
    {
      if IsValidAll(#gpAllMemoWorkType)
        delete current gpAllMemoWorkType;
      ReReadRecord(#SalScale);
    }
    else
      case inherited::handleevent(cmDelOnProtect) of
        heAbort: Abort;
        heStop: Stop;
      end;
  }
end;

end.

#include DeclarePointsOrders.vih
#include Query.vih
//Утверждение приказа. Если утверждаемый приказ - это заявка на работу в вых. дни,
//он должен переводиться в статус 2, а не 1.
handler with replace GP_epConfirmOrder_RPD190 on ExtensionPoint epConfirmOrder (NrecTitleDoc: Comp)
Action
{
  //Получаем количество РПД утверждаемого приказа
  var rpdCount: word =
  queryManager.createQuery('select count(*) from PartDoc where cDoc = :NrecTitleDoc')
              .setParam('NrecTitleDoc', NrecTitleDoc)
              .getResultValue;
  //Получаем количество РПД190 утверждаемого приказа
  var rpd190Count: word =
  queryManager.createQuery('select count(*) from PartDoc where cDoc = :NrecTitleDoc and TypeOper = 190')
              .setParam('NrecTitleDoc', NrecTitleDoc)
              .getResultValue;
  //Если все РПД утверждаемого приказа = 190 - меняем статус приказа на 2 (Исполняется)
  if rpdCount > 0 and rpdCount = rpd190Count
  {
    queryManager.createQuery('update TitleDoc set wStatus = 2 where TitleDoc.Nrec = :NrecTitleDoc')
                .setParam('NrecTitleDoc', NrecTitleDoc)
                .Execute;
  }

  Result := true;
}
