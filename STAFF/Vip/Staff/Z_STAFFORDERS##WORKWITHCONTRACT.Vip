#component "Z_STAFFORDERS"
Alter Interface WORKWITHCONTRACT
Function ChkNeed(_pPsnSpAllStaff:comp):boolean;forward ;


Create View  WorkWithContract
var
  dDT:date;
as select Appointments_Vib.Nrec
From
//  , SpAllStaff PsnSpAllStaff
  Appointments Appointments_Vib
 , SpAllStaff PsnSpAllStaff_Vib
where
((
//  cgAllStaffContract == BrwSpAllStaff.wNoCon
//  and cgAllStaffContract == PsnSpAllStaff.wNoCon
//  and cPerson_gl == PsnSpAllStaff.cBaseT
    PsnSpAllStaff.cBaseT == Appointments_Vib.Person
and PsnSpAllStaff.Nrec   == appointments_Vib.RESCOMP[1](noindex)
    //покажем только актуальные контракты на текущую дату
    // Для этого проверим наличие назначений
    // И ЕСЛИ ОНИ ЕСТЬ, НО закрытые, то отберем
//and PsnSpAllStaff.Nrec   /== PsnSpAllStaff_Vib.Nrec
 AND ( ChkNeed(PsnSpAllStaff_Vib.Nrec) )
));

//покажем только актуальные контракты на текущую дату
Function ChkNeed(_pPsnSpAllStaff:comp):boolean;
{ Result:=True;
  if not isValidAll(#appointments_Vib) exit;
  if not
  (
      (Appointments_Vib.lPrizn=2 and Appointments_Vib.DateEnd>=dDt )
   or (Appointments_Vib.lPrizn<>2 and (Appointments_Vib.DisMissDate=ZeroDate or Appointments_Vib.DisMissDate>=dDT )
      )
  )
  { Result:=False;

  }
} //Function ChkNeed(_pPsnSpAllStaff:comp):boolean;

HandleEvent
cmOnVipLoad:
{ dDT:=Cur_Date();
  case Inherited::HandleEvent(cmOnVipLoad) of
  heAbort :  Abort;
  heStop  :  Exit;
  end;

}
end;
end.
