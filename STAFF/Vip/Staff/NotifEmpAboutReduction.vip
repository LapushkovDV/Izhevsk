//*****************************************************************************
Function GetPodpisFIO(sFio : string) : string; forward;
//******************************************************************************  
table struct tmpSigners
(
  kod   : word
, FIO   : string
, Dol   : string
)
with index
(
  tmpSignersO1 = kod
);

table struct tmpRedunction
(
  dol      : string
, podr     : string
, FIO      : string
, FIOFull  : string
, FIOShort : string
, sNote    : string
, TabNum   : string 
, sex      : word
);


//******************************************************************************
var
  sFeeSigners
, SoglsFIO
, SoglsDol
, SoglsFIOIni
, Sogls2FIO
, Sogls2Dol
, Sogls2FIOIni
, PodpisFIO
, PodpisDol
, PodpisFIOIni
, Podpis2FIO
, Podpis2Dol
, Podpis2FIOIni
, UtvFIO
, UtvDol
, UtvFIOIni
, sNote
, sPodr
, sPerson        : string;

  hPersonsMarker
, DeptMarkerCat
, DeptMarker     : tptr;

//******************************************************************************  
create view
var 
  PersNRec
, cPodrFlt   : comp;

  dateReduction  : date;

as select
  'iNotifEmpAboutReduction'
    (FieldName = NameInterface)  

, CatalogsDep.Nrec
from
  Persons
, PickBuh 
, tmpSigners
, tmpRedunction
, Appointments
, StaffStruct
, Catalogs CatalogsDep
, Catalogs CatalogsPost
;

//******************************************************************************
create view vSpr
var
 pSpKau: comp;
as select Spkau.Name
From Spkau
where ((
  pSpKau == SpKau.nrec
)); //create view vSpr

//******************************************************************************
var iCatFunc   : CatalogsFunctions;    // Переменная типа интерфейс CatalogsFunctions
//******************************************************************************

var counter : word;

datastream NotifEmpAboutReductionStream
(
  [CFH     ]      CommonFormHeader;
  [DateReduction] dateReduction  ;
  [SoglsFIO]      GetPodpisFIO(SoglsFIO)  ;
  [SoglsDol]      SoglsDol       ;
  [SoglsFIOIni]   SoglsFIOIni    ;
  [Sogls2FIO]     GetPodpisFIO(Sogls2FIO) ;
  [Sogls2Dol]     Sogls2Dol      ;
  [Sogls2FIOIni]  Sogls2FIOIni   ;
  [PodpisFIO]     GetPodpisFIO(PodpisFIO) ;
  [PodpisDol]     PodpisDol      ;
  [PodpisFIOIni]  PodpisFIOIni   ;
  [Podpis2FIO]    GetPodpisFIO(Podpis2FIO);
  [Podpis2Dol]    Podpis2Dol     ;
  [Podpis2FIOIni] Podpis2FIOIni  ;
  [UtvFIO]        GetPodpisFIO(UtvFIO)    ;
  [UtvDol]        UtvDol         ;
  [UtvFIOIni]     UtvFIOIni      ;
  [OrgName]       oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', dateReduction);

   table tmpRedunction
   (
    [Dol]      tmpRedunction.dol;     
    [Podr]     tmpRedunction.podr;    
    [FIO]      tmpRedunction.FIO;     
    [FIOFull]  tmpRedunction.FIOFull;
    [FIOShort] tmpRedunction.FIOShort;
    [Osnovanie] tmpRedunction.sNote; 
    [MyPodpis]  GetPodpisFIO(tmpRedunction.FIO);     
    [TabNum]    tmpRedunction.TabNum;
    [SEX]       tmpRedunction.sex;
   );
)
end;
//*****************************************************************************
Function GetPodpisFIO(sFio : string) : string;
{
  if (trim(sFIO) = '')
    {
      result := '';
      exit;
    }

  var sSurname    : string; sSurname    := '';
  var sName       : string; sName       := '';
  var sFatherName : string; sFatherName := '';
  var nn : word; nn := 0;
  var tmpFIO : string; tmpFIO := sFio;
  do 
    {
      nn := InStr(' ', tmpFIO);
      if (nn = 0)
        nn := InStr('.', tmpFIO); 

      var ss : string; ss := SubStr(tmpFIO, 1, nn-1);
      if (trim(sSurName) = '')
        sSurName := Trim(ss);
      else  if (trim(sName) = '')
        sName := Trim(ss);
      else  if (trim(sFatherName) = '')
        sFatherName := Trim(ss); 

      tmpFIO := Trim(SubStr(tmpFIO, nn+1, 250));
    }
  while (nn > 0)

  result := SubStr(sName, 0, 1) + '. ' + SubStr(sFatherName, 0, 1) + '. ' + sSurName;
}
//******************************************************************************

Function GetPodrNameFilter : string;
{
  DeptMarker    := InitMarker(NameInterface + '_sPodr', 8, 200, 10);

  var nRecMark : comp; nRecMark := comp(0);                                                         
  case GetMarkerCount(DeptMarker) of
    0: result := 'не установлен';
    1: 
      {
        GetMarker(DeptMarker, 0, nRecMark);
        result := iCatFunc.GetCatalogsName(nRecMark);
      }
    else
      result := 'Несколько подразделений (' + string(GetMarkerCount(DeptMarker)) + ')';
  end;
  
  DoneMarker(DeptMarker, NameInterface + '_sPodr');
}

//******************************************************************************


Function GetPersNameFilter : string;
{
  hPersonsMarker := InitMarker(NameInterface + '_persons', 8, 200, 10);

  var nRecMark : comp; nRecMark := comp(0);

  case GetMarkerCount(hPersonsMarker) of
    0: result := 'не установлен';
    1: 
      {
        GetMarker(hPersonsMarker, 0, nRecMark);
        if (GetFirst Persons where ((nRecMark == Persons.NRec)) = tsOk)
          result := Persons.Fio;
      }
    else
      result := 'Несколько сотрудников (' + string(GetMarkerCount(hPersonsMarker)) + ')';
  end;
  
  DoneMarker(hPersonsMarker, NameInterface + '_persons');
}

//******************************************************************************

Screen scrWin;
Fields

   dateReduction    ('Дата предстоящего сокращения', , sci13Esc)  : NoProtect;
!   sPodr            ('Подразделения'               , , sci13Esc)  : Protect;
   sPerson          ('Сотрудники'                  , , sci13Esc)  : Protect;
   sFeeSigners      ('Подписанты'                  , , sci13Esc)  : Protect;
   sNote            ('Основание сокращения'        , , sci1Esc)  : NoProtect;
Buttons
   cmOk    , Default, , 'Продолжить';
   cmCancel,        , , 'Отменить';
<<

  `Дата предстоящего сокращения `        .@@@@@@@@@@@@
!  `Подразделения`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Сотрудники   `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Подписанты   `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Основание сокращения`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     <. Продолжить .>         <.  Отменить  .>
>>
end;

Procedure Signres;
{
  var tmpSoglsFIO : string; tmpSoglsFIO := '';
  var tmpSoglsDol : string; tmpSoglsDol := '';

  delete all tmpSigners;

  if (iFeeSigners.FeeSignersIsValid)
  {
    var wFeeSignersNum, wFeeSignersCount : word;
    wFeeSignersCount := iFeeSigners.GetFeeSignersCount;

    if (iFeeSigners.GetSignerFirst)
    {
      For (wFeeSignersNum := 1; wFeeSignersNum <= wFeeSignersCount; wFeeSignersNum++)
      {
         tmpSoglsFIO := if (trim(SoglsFIO) = '', iFeeSigners.GetSignerFIO(7)     , SoglsFIO);     
         tmpSoglsDol := if (trim(SoglsDol) = '', iFeeSigners.GetSignerPosition(1), SoglsDol);

         if (iFeeSigners.GetSignerRole = 'Согласовано (шапка)')
         {
           SoglsFIO  := iFeeSigners.GetSignerFIO(7);
           SoglsDol  := iFeeSigners.GetSignerPosition(1);
         }
         else if (iFeeSigners.GetSignerRole = 'Утверждающее лицо')
         {
           UtvFIO  := iFeeSigners.GetSignerFIO(7);
           UtvDol  := iFeeSigners.GetSignerPosition(1);
         }
         else if (iFeeSigners.GetSignerRole = 'Проверяющее лицо')
         {  
           ClearBuffer(#tmpSigners);
           tmpSigners.kod := iFeeSigners.GetSignerNumber;
           tmpSigners.Fio := iFeeSigners.GetSignerFIO(7);
           tmpSigners.Dol := iFeeSigners.GetSignerPosition(1);
           if (insert current tmpSigners = tsOk)
             {}
         }
         else if (iFeeSigners.GetSignerRole = 'Согласовано (подножие)')
         {
           Sogls2FIO  := iFeeSigners.GetSignerFIO(7);
           Sogls2Dol  := iFeeSigners.GetSignerPosition(1);
         }

        if (not iFeeSigners.GetSignerNext)
          break;
      }
    }
  }

  _LOOP tmpSigners ordered by tmpSigners.Kod
  {
    if (PodpisFIO = '')
    {
      PodpisFIO  := tmpSigners.Fio;
      PodpisDol  := tmpSigners.Dol;
    }
    else if (Podpis2FIO = '')
    {
      Podpis2FIO := tmpSigners.Fio;
      Podpis2Dol := tmpSigners.Dol;
    }
  } 

  SoglsFIO      := if (trim(SoglsFIO  )    = '', tmpSoglsFIO, SoglsFIO  );
  SoglsDol      := if (trim(SoglsDol  )    = '', tmpSoglsDol, SoglsDol  );
  Sogls2FIO     := if (trim(Sogls2FIO )    = '', tmpSoglsFIO, Sogls2FIO );
  Sogls2Dol     := if (trim(Sogls2Dol )    = '', tmpSoglsDol, Sogls2Dol );
  PodpisFIO     := if (trim(PodpisFIO )    = '', tmpSoglsFIO, PodpisFIO );
  PodpisDol     := if (trim(PodpisDol )    = '', tmpSoglsDol, PodpisDol );
  Podpis2FIO    := if (trim(Podpis2FIO)    = '', tmpSoglsFIO, Podpis2FIO);
  Podpis2Dol    := if (trim(Podpis2Dol)    = '', tmpSoglsDol, Podpis2Dol);
  UtvFIO        := if (trim(UtvFIO    )    = '', tmpSoglsFIO, UtvFIO    );
  UtvDol        := if (trim(UtvDol    )    = '', tmpSoglsDol, UtvDol    );
}
//******************************************************************************
HandleEvent
cmPick:
  case CurField of
    #sPodr:
      {
        DeptMarker    := InitMarker(NameInterface + '_sPodr', 8, 200, 10);
        DeptMarkerCat := InitMarker('', 8, 200, 10);
        CopyMarker(DeptMarkerCat, DeptMarker);
        DoneMarker(DeptMarkerCat, 'CatalogsMarker');

        if (RunInterface(Z_StaffCat::PickCatalog2, integer(-11), 0, comp(100)) = cmDefault)
          {
            DeptMarkerCat := InitMarker('CatalogsMarker', 8, 50, 10);
            CopyMarker(DeptMarker, DeptMarkerCat);
            DoneMarker(DeptMarkerCat, '');
          }

        DoneMarker(DeptMarker, NameInterface + '_sPodr');

        set sPodr := GetPodrNameFilter;
      }
    #sPerson:
      {
        hPersonsMarker := InitMarker(NameInterface + '_persons', 8, 200, 10);
        if (iGetKau.GetCodeKau(cgiMulti + cgiNotClear, cgKau_Persons, PersNRec) > 0)
          {
            ClearMarker(hPersonsMarker);
            _loop PickBuh where ((cgKau_Persons == PickBuh.KodTable))
            {
              InsertMarker(hPersonsMarker, PickBuh.PickRec);
              set PersNRec := PersNRec;
            }
          }
        DoneMarker(hPersonsMarker, NameInterface + '_persons');

        set sPerson := GetPersNameFilter;
      }
    #sFeeSigners:
      {
        iFeeSigners.RunWindowFeeSigners(1);
        set sFeeSigners := iFeeSigners.GetFeeSignersName;
      }

  end;

cmDelOnProtect:
  case CurField of
    #sPodr:
      {
        DeptMarker := InitMarker(NameInterface + '_sPodr', 8, 200, 10);
        ClearMarker(DeptMarker);
        set sPodr := 'не установлен';
        DoneMarker(DeptMarker, NameInterface + '_sPodr');
      }
    #sFeeSigners :
      {
        Set sFeeSigners := '';
        SaveMyDsk(sFeeSigners, 'iEMTabWorkTime_sFeeSigners');
      }

  end;
end;

//*****************************************************************************
// проверить - нужен ли этот уровень
Function GetPrintNeed(_pNrec:comp):boolean; cacheable;
{ #__UNUSED__(_pNrec)
  Result:=true;
  vSpr.pSpkau:=coGetAttr(coCatalogs,CatalogsDep.Nrec,'Не выводить при печати');
  if vSpr.pSpKau=0 then exit;
  vSpr._loop Spkau
  { if vSpr.SpKau.Name='Да'
      Result:=False;
  }
} //Function GetPrintNeed(_pNrec:comp):boolean; cacheable;

//*****************************************************************************
Function GetFullPodr(pPodr : comp) : string;
{
  var res   : string; res   := '';
  var sCode : string; sCode := '';
  while (GetFirst CatalogsDep where ((pPodr == CatalogsDep.NRec)) = tsOk)
    {
      if (CatalogsDep.MainLink <> comp(0) AND CatalogsDep.MainLink <> CatalogsDep.cParent) 
        {
           if (CatalogsDep.bPick = 0)
           //and sGetAttr(coCatalogs,CatalogsDep.Nrec,'Не выводить при печати')<>'Да'
           and GetPrintNeed(CatalogsDep.Nrec)
             {
               sCode := CatalogsDep.Code;
               res := CatalogsDep.Name + ' ' + /*' (' +  SubStr(CatalogsDep.Code, 1, 3) + ') ' +*/  GetFullPodr(CatalogsDep.cParent);
             }
        }
      else 
        break;
  
      pPodr := CatalogsDep.cParent;
    }
  result := res;// + ' (' +  SubStr(sCode, 1, 3) + ') ';
}
//******************************************************************************
Procedure CreateTmpTable;
{
  _loop PickBuh where ((cgKau_Persons == PickBuh.KodTable))
    if (GetFirst Persons where ((PickBuh.PickRec == Persons.NRec)) = tsOk)
      {
        ClearBuffer(#tmpRedunction);
        tmpRedunction.FIO      := Persons.FIO;
        tmpRedunction.TabNum   := GetStrTabN(Persons.TabNmb, Persons.StrTabN);
        //tmpRedunction.FIOFull  :=
        var n : word; n := InStr(' ', Persons.FIO);
        tmpRedunction.FIOShort := SubStr(Persons.FIO, n + 1, Length(Persons.FIO) - n);
        tmpRedunction.sex      := if(Persons.sex = 'М', 0, 1);
/*
        if (GetFirst Appointments where ((Persons.NRec == Appointments.Person        
                                      AND (dateReduction  >= Appointments.AppointDate 
                                       AND (dateReduction  <= Appointments.DismissDate or
                                                  Appointments.DismissDate = ZeroDate)
                                         ) )) = tsOk)
*/
        if (GetFirst Appointments where ((Persons.NRec == Appointments.Person
                                      AND (dateReduction  >= Appointments.AppointDate
                                       AND (dateReduction  <= Appointments.DismissDate or
                                                  Appointments.DismissDate = ZeroDate)
                                         and Appointments.lPrizn = 0
                                         )
                                          )) = tsOk)

         if (GetFirst StaffStruct where ((Appointments.StaffStr == StaffStruct.NRec)) = tsOk)
           {
             tmpRedunction.podr := GetFullPodr(StaffStruct.Department);

             if (GetFirst CatalogsDep where ((StaffStruct.Department == CatalogsDep.NRec)) = tsOk)
               {
                 tmpRedunction.podr     += ' (' +  SubStr(CatalogsDep.Code, 1, 3) + ')';
               }
             if (GetFirst CatalogsPost where ((StaffStruct.Post == CatalogsPost.NRec)) = tsOk)
               {
                 tmpRedunction.dol      := CatalogsPost.Name;
               }
           } 
        tmpRedunction.sNote := sNote;
        if (insert current tmpRedunction = tsOk)
          {}
      }
}
//******************************************************************************
HandleEvent

cmInit: 
  {
    if (NOT ReadMyDSK(dateReduction, NameInterface + '_dateReduction', FALSE))
      set dateReduction := ZeroDate;

    if (NOT ReadMyDSK(sNote, NameInterface + '_sNote', FALSE))
      set sNote := '';

    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);

    if (NOT ReadMyDsk(sFeeSigners, NameInterface + '_sFeeSigners', True))
      set sFeeSigners := '';

    if (sFeeSigners <> '')
      iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sFeeSigners);
  }

cmOk:
  {
    SaveMyDsk(sFeeSigners   , NameInterface + '_sFeeSigners');
    saveMyDsk(dateReduction , NameInterface + '_dateReduction');
    saveMyDsk(sNote         , NameInterface + '_sNote');
    PutCommand(cmDefault);
  }

cmDefault:
  {
    Signres;
    CreateTmpTable;

    if (RecordsInTable(#tmpRedunction) = 0)
      {
        Message('Отсутствуют данные!');
        CloseInterface(cmDefault);

      }
    else
      {
        RunFReport(NotifEmpAboutReductionStream, '', false);
        CloseInterface(cmDefault);
      }
  }

end;
end.

