/*************************************************************************************************\
* Наименование: Корректировочные табели                                                           *
* Контур/Модуль: Заработная плата                                                                 *
* Пункт меню: Документы / Лицевые счета / Смежные данные / Табели учета рабочего времени          *
* Примечание:                                                                                     *
* Интерфейс вызывается пунктом контекстного меню "Корректировочные табели".                       *
*                                                                                                 *
* Вид работы  |Номер задачи  |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1138         |06/11/17|Тищенко Р.Н.             |НПО Энергомаш                    *
* Разработка  |#175          |06/11/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#87938        |16/01/25|Семичев П.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
/*
SD-87938
Изменение логики сохранения исходных табелей - из данного интерфейса допускается создание копии табеля
только если нет уже сохраненной копии, заполнена дата проверки  и табель относится к прошедшим месяцам
Удаление копии табеля допускается только если табель не находится в закрытом периоде
*/
#define GPInt GP_TblCopies // #(GPInt)
#define GPNam Исходные табели // #(GPNam)

#include GP_SCUD_EventsEdit.Vih
#include Marker.vih
#include GP_Log.vih // Объектный интерфейс для вывода протокола
#include GP_FormT12.vih
#include GP_FormT12Gen.vih
#include GP_StrFunc.vih
#include FeeSigners.Vih // Функции работы с подписантами
#doc
<p>Корректировочные табели
<p>Заработная плата
<p>Документы / Лицевые счета / Смежные данные / Табели учета рабочего времени
<p>Интерфейс вызывается пунктом контекстного меню "Корректировочные табели".
<p>#175 - При создании корректировочных табелей будем запускать пересчет сальдо
#end
Interface GP_TblCopies cyan;
  show at (,, 120, 20);

  const
    SG_CONST_REP = cgReport_KASSFRO; // код группы отчётов для выбора подписантов
    SG_TAG_REP = 'FormT12'; // код группы отчётов для выбора подписантов
    MAX_ABSENCE_COUNT = 14; // Максимально кол-во неявок
    MAX_ORDER_COUNT = 14; // Максимально кол-во заказов
  end;

  // Данные по дням
  table struct SDays
  (
    DayNum: Byte,        // Номер дня
    DayDate: Date,       // Дата дня
    Mark: String[5],     // Дни: пометки обычные
    Hours: Double,       // Дни: отработано часов
    MarkAdd: String[20], // Дни: тип
    HoursAdd: Double     // Дни: часов по ночным, сверхурочным и т.д.
  )
  with index
  (
    SDays01 = DayNum
  );

  table struct  SOrders
  (
    Code: Word,          // Вид оплаты: код
    Acc: String[20],     // Вид оплаты: счет
    Hours: Double        // Вид оплаты: часы
  );

  table struct  SAbsences
  (
    Code: String[5],     // Неявки: код
    Days: Double,        // Неявки: дни
    Hours: Double        // Неявки: часы
  );

  create view
    var
      pcLSchet: Comp;
      pMonth: Byte;
      pYear: Word;
      pSignerGrp: String;
      pSettings: Word; // Дополнительные параметры
      ddDate, ddDatePer : Date;
    as select GP_TimeTable.*
    from
      GP_TimeTable (GP_TimeTable02),
      synonym Catalogs CatPosition,
      SDays (SDays01),
      SOrders,
      SAbsences
    where ((
          pcLSchet               == LSchet.NRec
      and pcLSchet               == GP_TimeTable.cLSchet
      and pYear                  == GP_TimeTable.YearN
      and pMonth                 == GP_TimeTable.MonthN
      and LSchet.tPerson         == Persons.NRec
      and GP_TimeTable.Cex       == KatPodr.NRec
      and GP_TimeTable.cPosition == CatPosition.NRec
      and pcLSchet               == LStab.cLschet
      and pYear                  == LStab.YearN
      and pMonth                 == LStab.MesN
    ));

  parameters
    pcLSchet,
    pMonth,
    pYear;

  var
    DWName: array[1..7] of String[2];
    pMarker: IMarker(Marker) new;

  #include GP_FormT12.var
  #include GP_FormT12Gen.var
  #include GP_Log.var
  #include GP_StrFunc.var
  #include FeeSigners.var

  procedure UpdateTitle;
  begin
    SetTitle('#(GPNam) за ' + DateToStr(To_Date(1, pMonth, pYear), 'month YYYY') + 
     ' (таб. № ' + GetStrTabN(LSchet.TabN, LSchet.StrTabN) + ' ' + GetSurnameWithInitials(Persons.FIO) + ')');
  end;

  window winPrintParam 'Параметры печати' DoAccept, EscClose, Gray;
    show at (,, 74, 8);

    screen scrParam ('',, sci1EnEsc);
    fields
      pSignerGrp ('Группа подписантов',, sci13EnEsc): protect;
      pSettings ('Дополнительные параметры отчета',, sci1Esc): NoProtect;
    buttons
      cmOk, default,, 'Ввод - принять выбор',,sci1Esc;
      cmCancel,,, 'Отмена',,sci1Esc;
    <<

`Группа подписантов  `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 Дополнительные параметры
  [.] выводить Лист 1`

                        <.  ~O~K  .> <.О~т~мена.>
    >>
    end;

    handleEvent
      cmOk:
        PutCommand(cmDefault);
      cmPick:
        case CurField of
          #pSignerGrp:
            begin
              if iFeeSigners.RunMainWindow(1) then
                set pSignerGrp := iFeeSigners.GetFeeSignersName;
            end;
        end;
    end;
  end;

  function LoadRecordForShow: Boolean;
  var
    DaysCnt, I: Byte;
  begin
    result := false;
    // Данные по дням
    if delete all from SDays != tsOk then
    begin
      Message('Ошибка: Не удалось очистить таблицу SDays');
      exit;
    end;
    DaysCnt := Last_Day(To_Date(1, GP_TimeTable.MonthN, GP_TimeTable.YearN));
    for (I := 1; I <= DaysCnt; I++)
    begin
      ClearBuffer(#SDays);
      SDays.DayNum := I;
      SDays.DayDate := To_Date(I, GP_TimeTable.MonthN, GP_TimeTable.YearN);
      if SDays.DayDate >= GP_TimeTable.DBeg and SDays.DayDate <= GP_TimeTable.DEnd then
      begin
        SDays.Mark := GP_TimeTable.DMark[I];
        SDays.Hours := GP_TimeTable.DHours[I];
        SDays.MarkAdd := GP_TimeTable.DMarkAdd[I];
        SDays.HoursAdd := GP_TimeTable.DHoursAdd[I];
      end else
        SDays.Mark := 'X';
      if insert current SDays != tsOk then
      begin
        Message('Ошибка: Не удалось вставить запись в таблицу SDays');
        exit;
      end;
    end;
    if getFirst SDays = tsOk then
    begin
    end;
    // Виды и направления затрат
    if delete all from SOrders != tsOk then
    begin
      Message('Ошибка: Не удалось очистить таблицу SOrders');
      exit;
    end;
    for (I := 1; I <= MAX_ORDER_COUNT; I++)
    begin
      if GP_TimeTable.OAcc[I] = '' then
        break;
      ClearBuffer(#SOrders);
      SOrders.Code := GP_TimeTable.OCode[I];
      SOrders.Acc := GP_TimeTable.OAcc[I];
      SOrders.Hours := GP_TimeTable.OHours[I];
      if insert current SOrders != tsOk then
      begin
        Message('Ошибка: Не удалось вставить запись в таблицу SOrders');
        exit;
      end;
    end;
    if getFirst SOrders = tsOk then
    begin
    end;
    // Неявки по причинам
    if delete all from SAbsences != tsOk then
    begin
      Message('Ошибка: Не удалось очистить таблицу SAbsences');
      exit;
    end;
    for (I := 1; I <= MAX_ABSENCE_COUNT; I++)
    begin
      if GP_TimeTable.ACode[I] = '' then
        break;
      ClearBuffer(#SAbsences);
      SAbsences.Code := GP_TimeTable.ACode[I];
      SAbsences.Days := GP_TimeTable.ADays[I];
      SAbsences.Hours := GP_TimeTable.AHours[I];
      if insert current SAbsences != tsOk then
      begin
        Message('Ошибка: Не удалось вставить запись в таблицу SAbsences');
        exit;
      end;
    end;
    if getFirst SAbsences = tsOk then
    begin
    end;
    result := true;
  end;

  // Определяет цвет, которым нужно выводить день недели
  function DWColor(_DayDate: Date): Integer;
  var
    _DayOfWeek: Byte;
  begin
    _DayOfWeek := Day_Of_Week(_DayDate);
    if _DayOfWeek = 6 or _DayOfWeek = 7 then
      result := ColorSysRed
    else
      result := 0;
  end;

  // Определяет цвет, которым нужно выводить день недели
  function MarkColor(_DayDate: Date): Integer;
  begin
    if _DayDate >= GP_TimeTable.DBeg and _DayDate <= GP_TimeTable.DEnd then
      result := 0
    else
      result := ColorSysRed;
  end;

  // инициализация параметров отчета
  procedure InitParam;
  begin
    if not ReadMyDsk(pSignerGrp, 'FeeSigners_' + To_Char(SG_CONST_REP) + '_' + SG_TAG_REP, true) then
      pSignerGrp := '';
    if not ReadMyDsk(pSettings, '#(GPInt)_pSettings', false) then
      pSettings := 0;
    UpdateTitle;
  end;

  // сохранение параметров отчета
  procedure SaveParam;
  begin
    SaveMyDsk(pSignerGrp, 'FeeSigners_' + To_Char(SG_CONST_REP) + '_' + SG_TAG_REP);
    SaveMyDsk(pSettings, '#(GPInt)_pSettings');
  end;

  browse brGP_TimeTable (,, sci178Esc);
    table GP_TimeTable;
    RecMarker = pMarker;
    fields
      // GP_TimeTable.TabN #3'Таб.№' ('Табельный номер'): [10], protect, noAutoSize;
      // GP_TimeTable.StrTabN 'Таб.№' ('Табельный номер'): [10], protect, noAutoSize;
      // Persons.FIO 'Работник' ('Работник'): [30], protect, noAutoSize, noDel;
      GP_TimeTable.DForm 'Дата', 'создания' ('Дата создания копии'): [12], protect, noAutoSize;
      GP_TimeTable.DBeg 'С' ('Период табеля с'): [12], protect, noAutoSize;
      GP_TimeTable.DEnd 'По' ('Период табеля по'): [12], protect, noAutoSize;
      KatPodr.Name 'Подразделение' ('Подразделение отнесения затрат'): [20], protect;
      CatPosition.Name 'Должность' ('Должность'): [20], protect;
  end;

  // Формирование отчетной формы табеля по выбранным записям
  procedure GenerateDoc;
  begin
    oGP_Log.Init('FormT12.log', true, true, true);
    oGP_Log.SetVerboseMode(true); // Показывать подробный лог ***

    // Если не выбрано ни одной записи, пометим текущую
    if pMarker.Count = 0 then
    begin
      pMarker.Mark;
      RedrawPanel(tnGP_TimeTable);
    end;

    // Проходим по всем помеченным записями
    PushPos(#GP_TimeTable);
    SubBounds(tbRMGP_TimeTable1);
    AddBounds(tbRMGP_TimeTable2);

    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Анализ данных...'#13, 0);
    // На всякий случай выполним очистку таблицы TmpFormT12
    oGP_FormT12.Clear;
    _loop pMarker
    begin
      if not NextVisual then
        break;
      // oGP_Log.Info('Таб.№ ' + GP_TimeTable.StrTabN + ' ' + To_Char(GP_TimeTable.DBeg) + ' ' + CatPosition.Name); // ***
      oGP_FormT12.LoadCopy(GP_TimeTable.NRec);
    end;
    StopVisual('', 0);

    AddBounds(tbRMGP_TimeTable1);
    SubBounds(tbRMGP_TimeTable2);
    PopPos(#GP_TimeTable);

    // Формируем форму
    var pDBeg: Date = To_Date(1, pMonth, pYear);
    var pDEnd: Date = To_Date(Last_Day(pDBeg), pMonth, pYear);
    if oGP_FormT12Gen.Init(pDBeg, pDEnd, '', pSettings) then
      oGP_FormT12Gen.OutTmpFormT12;
    oGP_FormT12Gen.Done;

    // Очистим таблицу TmpFormT12
    oGP_FormT12.Clear;

    oGP_Log.Done(true);
  end;

  function IsAllowedToDoCopy(IsUserRun: boolean): Boolean;
  begin
    result := false;

    if not IsValid(tnLSTab)
      exit;

    // Запрещено создавать корр.табель за текущий месяц и будущие. За любой из прошлых месяцев разрешено.
    var D: Date = Cur_Date;
    D := To_Date(1, Month(D), Year(D));
    if To_Date(1, pMonth, pYear) >= D
    {
/*      if IsUserRun
        Message('Корректировочный табель можно создать только за прошлые месяцы')
      else
        Message('По таб.№ ' + GetStrTabN(LSchet.TabN, LSchet.StrTabN) + ' нет корректировочных табелей'#13 +
         'за ' + DateToStr(To_Date(1, pMonth, pYear), 'month YYYY') + ' года'); */
      exit;
    }

    if LSTab.LastDate = ZeroDate
    {
//        Message('Можно создать корректировочный табель только по табелю, у которого заполнено поле "Дата проверки"');
      exit;
    }
    result := true;
  end;

  function MakeCopy: Boolean;
  begin
    result := false;
    if oGP_FormT12.CreateCopy(Cur_Date, pcLSchet, pMonth, pYear, true, false)
    {
      RescanPanel(#GP_TimeTable);
      result := true;
    }
  end;

  window winShow 'Просмотр табеля' DoAccept, EscClose, Gray;
    show at (,, 104, 30);

    browse brSDays (,, sci178Esc);
      show at (,, 32,);
      table SDays;
      fields
        SDays.DayNum 'Д' ('Номер дня'): [3], protect, noAutoSize, centered;
        DWName[Day_Of_Week(SDays.DayDate)] 'ДН' ('День недели'): [3], protect, noAutoSize, centered,
         { Font = { Color = DWColor(SDays.DayDate)}};
        SDays.Mark 'Об.' ('Обозначение дня'): [5], protect, noAutoSize, centered,
         { Font = { Color = MarkColor(SDays.DayDate)}};
        if(Abs(SDays.Hours) >= 0.001, oGP_SF.TimeDToH(SDays.Hours), '') 'Отр.' ('Кол-во отработанных часов'): [5], protect, centered; 
        SDays.MarkAdd 'Об.2' ('Дополнительное обозначение дня'): [5], protect, noAutoSize, centered;
        if(Abs(SDays.HoursAdd) >= 0.001, oGP_SF.TimeDToH(SDays.HoursAdd), '') 'Вр.' ('Кол-во часов для дополнительного обозначения'): [5], protect, centered;
    end;

    screen scShowInfo ('',, sci1EnEsc);
      show at (33,,, 5);
      table GP_TimeTable;
    fields
      GetStrTabN(LSchet.TabN, LSchet.StrTabN): skip;
      Persons.FIO: skip;
      KatPodr.Name: skip;
      CatPosition.Name: skip;
      GP_TimeTable.DForm: skip;
      GP_TimeTable.DBeg: skip;
      GP_TimeTable.DEnd: skip;
      GP_TimeTable.Kateg: skip, left;
    <<
`Таб №`.@@@@@@@@@`Фамилия И.О.`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Подразделение`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Должность`       .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Дата создания`   .@@@@@@@@@   `С`.@@@@@@@@@`по`.@@@@@@@@@
`Код категории`   .@@@@
    >>
    end;

    screen scSOrders ('',, sci1EnEsc);
      show at (33, 6, 58, 7);
      table GP_TimeTable;
    <<
   Виды и направления затрат
    >>
    end;

    browse brSOrders (,, sci178Esc);
      show at (33, 8, 58,);
      table SOrders;
      fields
        SOrders.Code  'Код в/о' ('Виды и направления затрат: код'): [8], protect, noAutoSize, centered;
        SOrders.Acc   'Корр.счет' ('Виды и направления затрат: корр.счет'): [10], protect, centered;
        SOrders.Hours 'Часы' ('Виды и направления затрат: часы'): [5.2], protect, noAutoSize, centered;
    end;

    screen scSAbsences ('',, sci1EnEsc);
      show at (59, 6, 71, 7);
      table GP_TimeTable;
    <<
  Неявки по
  причинам
    >>
    end;

    browse brSAbsences (,, sci178Esc);
      show at (59, 8, 71,);
      table SAbsences;
      fields
        SAbsences.Code 'Код' ('Неявки по причинам: код'): [5], protect, noAutoSize, centered;
        SAbsences.Days 'Дни' ('Неявки по причинам: дни'): [5.2], protect, centered;
    end;

    screen scTotals ('',, sci1EnEsc);
      show at (72, 6,, 7);
      table GP_TimeTable;
    <<
  Итоги
    >>
    end;

    screen scTotalsVal ('',, sci1EnEsc);
      show at (72, 8,,);
      table GP_TimeTable;
      fields
        GP_TimeTable.Day1P: [4.1], skip, left; // отработано дней за 1-ю половину месяца
        GP_TimeTable.Chas1P: [6.2], skip, left; // отработано часов за 1-ю половину месяца
        (GP_TimeTable.Day1P + GP_TimeTable.Day2P): [4.1], skip, left; // отработано дней за 2-ю половину месяца
        (GP_TimeTable.Chas1P + GP_TimeTable.Chas2P): [6.2], skip, left; // отработано часов за 2-ю половину месяца
        GP_TimeTable.TN: [6.2], skip, left; // Ночные
        GP_TimeTable.TS: [6.2], skip, left; // Сверхурочные
        GP_TimeTable.TRBDays: skip, left; // Работа в выходные: дней
        GP_TimeTable.TRBHours: [6.2], skip, left; // Работа в выходные: часов
        GP_TimeTable.TRODays: [4.1], skip, left; // Работа в выходные в счет отпуска: дней
        GP_TimeTable.TROHours: [6.2], skip, left; // Работа в выходные в счет отпуска: дней
        GP_TimeTable.TV: skip, left; // Кол-во выходных и праздничных дней
    <<
 Отработано за I половину месяца:
 `Дней:`.@@@@  `Часов:`.@@@@@@
 Отработано за месяц:
 `Дней:`.@@@@  `Часов:`.@@@@@@
 Ночные
               `Часов:`.@@@@@@
 Сверхурочные
               `Часов:`.@@@@@@
 Работа в выходные
 `Дней:`.@@@@  `Часов:`.@@@@@@
 Работа в выходные в счет отпуска
 `Дней:`.@@@@  `Часов:`.@@@@@@

 Выходные и праздники
 `Дней:`.@@@@
    >>
    end;


    handleEvent
      cmInit:
        if not LoadRecordForShow then
          abort;
      cmPrintDoc:
        if IsValidAll(tnGP_TimeTable) then
          if RunWindowModal(winPrintParam) = cmDefault then
          begin
            SaveParam;
            GenerateDoc;
          end;
    end;

  end;

  handleEvent
    cmInit:
    {
      ddDate := date(1, pMonth, pYear);
      ddDatePer := date(1, month(dGetTune('UP.DATOTCH')), year(dGetTune('UP.DATOTCH')));
      if not IsValidAll(tnGP_TimeTable)
      {
        if IsAllowedToDoCopy(false)
        {
          if Message('По таб.№ ' + GetStrTabN(LSchet.TabN, LSchet.StrTabN) + ' сохраненной копии табеля'#13 +
             'за ' + DateToStr(To_Date(1, pMonth, pYear), 'month YYYY') + ' нет. Создать?', YesNo) = cmYes
          {
            if not MakeCopy
              abort;
          }
          else
            abort;
        }
        else
          abort;
      }

      iFeeSigners.InitFeeSigners(SG_CONST_REP);
      InitParam;
      DWName[1] := 'Пн';
      DWName[2] := 'Вт';
      DWName[3] := 'Ср';
      DWName[4] := 'Чт';
      DWName[5] := 'Пт';
      DWName[6] := 'Сб';
      DWName[7] := 'Вс';
    }
    cmInsert:
    {
//      if IsAllowedToDoCopy(true)
//      {
        var NeedMakeCopy: Boolean = true;
        if IsValidAll(tnGP_TimeTable)
        {
          if (ddDatePer > ddDate)//если табель за прошедший отчетный период - запрет удаления
          {
            NeedMakeCopy := false;
            Message('Табель находится в закрытом периоде, операции с копиями табеля запрещены.');
          }
          else
            NeedMakeCopy := (Message('Перезаписать сохраненную копию табеля по таб.№ ' + GetStrTabN(LSchet.TabN, LSchet.StrTabN) + ''#13 +
              'за ' + DateToStr(To_Date(1, pMonth, pYear), 'month YYYY') + 'года?', YesNo) = cmYes);
        }
        if NeedMakeCopy
          if MakeCopy
            RereadRecord(#GP_TimeTable);
        abort;
//      }
//      else
//        abort;
    }
    cmDeleterecord:
    {

      if (ddDatePer > ddDate)//если табель за прошедший отчетный период - запрет удаления
      {
        Message('Табель находится в закрытом периоде, операции с копиями табеля запрещены.');
        abort;
        exit;
      }

      if Message('Удалить текущую запись?', YesNo) = cmYes then
        delete current GP_TimeTable;
    }
    cmPrintDoc:
      if IsValidAll(tnGP_TimeTable) then
        if RunWindowModal(winPrintParam) = cmDefault then
        begin
          SaveParam;
          GenerateDoc;
        end;
    cmHotKeys:
      PutHotCommand(RunMenu('mnuGP_TblCopies'));
    cmDefault:
      RunWindowModal(winShow);
  end;

end.

mnuGP_TblCopies Menu
{
- 'Просмотр', cmDefault, 'Просмотр текущей записи';
- 'Печать', cmPrintDoc, 'Сформировать форму табеля по выбранным записям';
- 'Создать', cmInsert, 'Создать копию табеля';
- 'Удалить', cmDelete, 'Удалить копию табеля';
}
