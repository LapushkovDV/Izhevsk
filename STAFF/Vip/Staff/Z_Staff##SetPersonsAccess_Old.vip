/*************************************************************************************************\
* Наименование: Расширение интерфейса редактирования ограничений на работу с распорядительными    *
*               действиями                                                                        *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание: см. GP_PartDocAccessController                                                      *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#NaN          |17/04/24|kurennykh                |НПО Энергомаш                    *
\*************************************************************************************************/

#include GP_PartDocAccessController.vih

#component "Z_STAFF"
#doc
Контур/Модуль: Управление персоналом
<p>Расширение интерфейса редактирования ограничений на работу с распорядительными
действиями
<p>#2098 (longint(ServStav.cServ) and 32)<>0 - Запрет утверждения
#end
//**********************************************
alter interface SetPersonsAccess_Old;
//**********************************************
Overload
procedure SetEditMode(Value: boolean);
end; //Overload
//**********************************************
Create View
//**********************************************
var
  pUser:comp;
  CurWord02:word; //#2098
From
  TypePr(TypePrByCod),
  ServStav ServStav_Fnd
where ((
       30000 >> TypePr.CodOper (NoIndex)
  and TypePr.CodOper == ServStav_fnd.wTblCode
  and pUser      == ServStav_Fnd.cUnit
  and longint(1) == ServStav_Fnd.FilialNo(NoIndex)
));
;
//*********************************
overloadformats scUsers1;
//*******************************
screen scUsers1;
show at (,18,,) fixed_Y;
  table tmp_User;
  fields
   CurWord   ('Маска ограничения доступа'): noprotect;
   CurWord02 ('Маска ограничения доступа'): noprotect;
<<
 Разрешить: [.] РПД доступно`                    [.] Запрет утверждения`
            [.] только по группе дескрипторов`
            [.] только свои`
            [.] доступны скрытые`
            [.] отсылать сообщение на почту`
>>
end; // screen scUsers

function WordBitIsSet(WordBit: word): boolean;
{
  result := (CurWord and WordBit) = WordBit;
}

//------------------------------------------------------------------------------
// обработчик изменения режима интерфейса
//------------------------------------------------------------------------------
procedure SetEditMode(Value: boolean);
{   Inherited::SetEditMode(Value);
    cfsSetProp('cb_SCUSERS_CURWORD02', cfpSkip, not EditMode);
    cfsSetProp('cb_SCUSERS1_CURWORD02', cfpSkip, not EditMode);
    ReScanPanel(#ServStav);
} //procedure SetEditMode(Value: boolean);

Procedure SetServStav_cServ;
{ set ServStav.cServ := comp(CurWord + (CurWord02 shl 5) );
}

Procedure GetServStav_cServ;
{ CurWord   := longint(ServStav.cServ)        and (1+2+4+8+16);
  CurWord02 :=(longint(ServStav.cServ) shr 5) and (1+2+4+8+16);
}

panel pCatIer;
  table ServStav;

  handleevent
    cmPositionChanged:
    { //CurWord:= word(ServStav.cServ);
      GetServStav_cServ;
      ReReadRecord(#ServStav);
    }
    cmSetDefault:
    {
      ClearBuffer(#ServStav);
      set CurWord  := 0;
      set CurWord02:= 0;
    }

    cmCheckField:
    {
      case CurField of
        #CurWord,#CurWord02:
        {
          if WordBitIsSet(GP_BIT_RPD_ENABLED_ONLY_DESCR) and (not WordBitIsSet(GP_BIT_RPD_ENABLED_ONLY_DESGR))
            CurWord += word(GP_BIT_RPD_ENABLED_ONLY_DESGR);

          if (not WordBitIsSet(GP_BIT_RPD_ENABLED)) and
             (WordBitIsSet(GP_BIT_RPD_ENABLED_ONLY_DESCR) or
              WordBitIsSet(GP_BIT_RPD_ENABLED_ONLY_DESGR))
            CurWord += GP_BIT_RPD_ENABLED;
          SetServStav_cServ;
        }
        else
          inherited::handleevent(cmCheckField);
      end; //case
    }


  end; //handleevent

end; //panel

//------------------------------------
// события интерфейса
//------------------------------------
handleevent
  cmPick:
    {
      if EditMode
      {  case CurField of
          #X$USERS.xu$loginname:
          {
            var UserNRec: comp;
            UserNRec := 0;

            if (RunInterface(GetUserTn, 0, UserNRec) = cmDefault)
            { set pUser:=UserNRec;
              if getfirst ServStav_fnd =tsok
              { message('Права выбранному пользователю уже назначены!')
              }
              else
              { if (getfirst fastfirstrow All_X$USERS
                  where ((UserNRec == All_X$USERS.ATL_NREC)) = tsOk)
                set ServStav.cUnit:= All_X$USERS.ATL_NREC;
              }
            }
          }
        else
        { case inherited :: handleEvent (cmPick) of
            heAbort:{abort;exit;}
            heStop:{stop;exit;}
          end;
        }
        end; //case
      } else exit;
    }
end;
end.
