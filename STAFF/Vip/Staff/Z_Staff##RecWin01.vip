#include GetKau.Vih
#component "Z_STAFF"
#doc
 Первое окно картотеки - Общие сведения
 #219 Добавлена возможность связи с организацией
#end

Alter Interface RECWIN01;

overload
  procedure Idle;
end;
#include GetKau.Var

var pVA_Persons_KatOrg :comp;//'Физическое лицо (контрагент)'; #219

//*************************************************************************************************
//#region Визуальные элементы


//******************************************************************************
ExtendFormats scrPers1;
screen scrPers1;
  show at (,,82,19);
  table tmpPersons;
  bevel a {0, 12, 82, 12, bsRaised, bsHorizontal};
Fields
  [KatOrg_Link] sGetAttrID(coPersons,Persons.Nrec,pVA_Persons_KatOrg)
      ('Связь с организацией ',,scStaffReceptionT2CDPick) : Protect,NoDel,PickButton;
<<   'Персональные данные сотрудника'













                                Связан с организ. .@@@@@@@@@@@@@@@@@@@@@@@@@@





>>

end; //screen scrPers1;


//#region Визуальные элементы
//*************************************************************************************************

//*************************************************************************************************
//#region Вспомогательные процедуры и функции

// дополнительная инициализация объекта
Procedure GP_LoadInterface;
{ pVA_Persons_KatOrg:=ExtAttr_ID(coPersons,VA_Persons_KatOrg);
}//Procedure GP_LoadInterface;

//Проверяет поле fieldId на доступность для редактирования
function FieldIsEditable(fieldId: longint): boolean; Cacheable;
{
  case fieldId of
    #KatOrg_Link    : result := not boGetTune('UP.STAFF.RECEPTION.RECWIN01.GP_DISABLEKATORG');
    #PersKatpodrFull: result := not boGetTune('UP.STAFF.RECEPTION.RECWIN01.DISABLEDEPARTMENTS');
    else result := false;
  end;
}

// Установка запрета на поля
Function DisableFields(_wtp:word): boolean; Cacheable;
{ #__UNUSED__(_wtp)
  if not FieldIsEditable(#PersKatpodrFull)
    ClearFieldOption(#PersKatPodrFull, ofSelectable);
  if not FieldIsEditable(#KatOrg_Link)
    ClearFieldOption(#KatOrg_Link, ofSelectable);
  Result:=true;
} //Function DisableFields(_wtp:word): boolean; Cacheable;

//#endregion Вспомогательные процедуры и функции
//*************************************************************************************************


//*************************************************************************************************
//#region Перекрытые методы

//Обработчик события cmIdle
procedure Idle;
{
  inherited::Idle;
  //Стандартный обработчик установил доступность поля Подразделение
  //дописываем дополнительный запрет в зависимости от настройки
  DisableFields(1);
} //procedure Idle;

//#endregion Перекрытые методы
//*************************************************************************************************

#include GP_File_hRef.Vpp

handleevent
cmInit:
{ GP_LoadInterface;
  inherited::handleevent(cmInit);
// LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' , -1  , -1, 1);
}
cmStaffSeeDopInfo:
{
  putcommand(cmValue68);
}
cmValue68:
{ pGP_File_hRef.InitParam(
   if(false,cgiNotEdit,0)   //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
                // Если документ только на чтение следует вызвать cgiNotEdit
  ,coPersons //_wTable    : word; указать код таблицы документа системы
  ,tmpPersons.Nrec //_cRec      : comp=0;   // указать поле в таблице
  ,1 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
  ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
  ,'Файлы по сотруднику ' + Persons.fio
   );
}

cmOnVipLoad:
{ GP_LoadInterface;
  inherited::handleevent(cmOnVipLoad);
}

cmPick:
{
  case curfield of
    #KatOrg_Link:
    { if not FieldIsEditable(#KatOrg_Link)
      {
        message(''#3'Установлен запрет на редактирование поля "Связь с организацией"'#13#13'' +
                ''#3'Настройки Галактики / Управление персоналом / Управление и учет кадров / Картотека / '#13'' +
                ''#3'Запрещать изменение связи с организацией в карточке сотрудника на вкладке "Общие сведения"', error);
        Abort;
      }
      else
      { var _crec:comp=coGetAttrID(coPersons,Persons.Nrec,pVA_Persons_KatOrg);
        If (iGetKau.GetCodeKau(cgiPick,cgKau_KatOrg,_crec) <> 0)
        { coSetAttrID(coPersons,Persons.Nrec,pVA_Persons_KatOrg,_crec,ShowKau(cgKau_KatOrg,_crec));
          ReScanPanel(#TMPPERSONS);
          ReScanPanel(#PERSONS);
        }
      }

    }
    #PersKatpodrFull:
    {
      //Проверка на доступность поля "Подразделение" на редактирование
      if not FieldIsEditable(#PersKatpodrFull)
      {
        message(''#3'Установлен запрет на редактирование поля "Подразделение"'#13#13'' +
                ''#3'Настройки Галактики / Управление персоналом / Управление и учет кадров / Картотека / '#13'' +
                ''#3'Запрещать изменение подразделения в карточке сотрудника на вкладке "Общие сведения"', error);
        Abort;
      }
      else
        inherited::handleevent(cmPick);
    }
    else
      inherited::handleevent(cmPick);
  end;
}
end;

end.
