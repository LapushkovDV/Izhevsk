#IFNDEF __GP_FORMT12GEN_VIH__
#DEFINE __GP_FORMT12GEN_VIH__

#component "GP_Staff"

objInterface GP_ObjFormT12Gen;

  // Инициализирует форму
  // Параметры:
  //  _pDBeg - дата начала отчетного периода
  //  _pDEnd - дата окончания отчетного периода
  // Возвращает true, если операция завершилась успешно
  function Init(_pDBeg: Date; _pDEnd: Date; _DepFilter: String; _Settings: Word): Boolean;

  // Выводит в форму все записи из временной таблицы TmpFormT12
  procedure OutTmpFormT12;

  // Завершает формирование формы и показывает сформированную форму
  procedure Done;
end;

vipInterface GP_FormT12Gen Implements GP_ObjFormT12Gen;
#endif
