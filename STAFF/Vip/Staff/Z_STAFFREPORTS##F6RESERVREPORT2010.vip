/*************************************************************************************************\
* Наименование:  Разработка печатной формы                                                        *
*                      Анализ обеспеченности на период мобилизации и военное время трудовыми      *
*                      ресурсами (руководителями, специалистами, квалифицированными рабочими и    *
*                      служащими) из числа ГПЗ"                                                   *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Управление персоналом -> Отчеты -> Отчеты пользователя -> Ведение картотеки ->   *
*                    Анализ обеспеченности на период мобилизации и военное время трудовыми        *
*                    ресурсами (руководителями, специалистами, квалифицированными рабочими и      *
*                    служащими) из числа ГПЗ                                                      *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#398          |12/08/17|Валента А.В.             |НПО Энергомаш                    *
* Разработка  |#263          |12/08/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
#include FeeSigners.Vih
#include AttrTablePick.vih
#component "Z_StaffReports"
#doc
Управление персоналом -> отчеты  ->  Статистические отчеты
->  Забронированные военнообязанные  ->  ЭМ. Отчет по забронированным военнообязанным.
<p>#398
<p>Анализ обеспеченности на период мобилизации и военное время трудовыми
ресурсами (руководителями, специалистами, квалифицированными рабочими и    *
служащими) из числа ГПЗ"                                                   *
<p>#263
<p>Отчет по ВУС форма №6.
#end
alter interface F6ReservReport2010
OverLoad
procedure CreateColArreyData(PersNRec : comp; numRow : word; isTotalCalc : boolean);
end;

#include FeeSigners.var
var  refAttrTablePick : AttrTablePick;
var iExAttr : iExtAttr;

var
  sFeeSigners
, sUtve
, sUtve2
, sUtveDol     : string;
//-----------------------------------
ExtendFormats F6ReservReport;
OverLoadFormats scrBYC_Filter;
//-----------------------------------
var
  dm_Procent01:double;
  dm_Procent02:double;
  dm_Procent03:double;
  dm_Procent04:double;

create view vSpr
as select klkatego.nrec
from klkatego;

//─────────────────────────────────────────────────────────────────────────
procedure CreateColArreyData(PersNRec : comp; numRow : word; isTotalCalc : boolean);
{  // Создание столбца данных по известной строке numRow
  var FullYear : word;
  var i        : word;
  var j        : word;

  if (GetFirst Conscription where ((PersNRec == Conscription.Person)) = tsOK)
  {
    if (iCatFunc.GetSysCodeIer(Conscription.ConsRel) = 732)   // Призывники
    {
      dAllData[(numRow-1) * 16 + 15] := dAllData[(numRow-1) * 16 + 15] + 1;
    }

    if (iCatFunc.GetSysCodeIer(Conscription.ConsRel) = 730)   // Военнообязанные
    {
#IFDEF _GP_
      if (iCatFunc.GetSysCodeIer(Conscription.AcntStruc) = 722)   // Офицеры и генералы
#ELSE
      if (iCatFunc.GetSysCodeIer(Conscription.AcntCat) = 722)   // Офицеры и генералы
#ENDIF
      {
        if (iCatFunc.GetSysCodeIer(Conscription.SpecAcc) = 711)   // Бронь
        {
          dAllData[(numRow-1) * 16 + 8] := dAllData[(numRow-1) * 16 + 8] + 1;
        }

        dAllData[(numRow-1) * 16 + 3] := dAllData[(numRow-1) * 16 + 3] + 1;
      }

#IFDEF _GP_
      if (iCatFunc.GetSysCodeIer(Conscription.AcntStruc) = 721 or   // Прапорщики, мичманы, сержанты и старшины
          iCatFunc.GetSysCodeIer(Conscription.AcntStruc) = 720  )   // Ефрейторы, солдаты и матросы
#ELSE
      if (iCatFunc.GetSysCodeIer(Conscription.AcntCat) = 721 or   // Прапорщики, мичманы, сержанты и старшины
          iCatFunc.GetSysCodeIer(Conscription.AcntCat) = 720  )   // Ефрейторы, солдаты и матросы
#endif
      {
        if (iCatFunc.GetSysCodeIer(Conscription.SpecAcc) = 711)   // Бронь
        {
          FullYear := iStrFunc.GetCountYears(Persons.BornDate, Cur_Date);

          if (FullYear <= 30)
          {
            dAllData[(numRow-1) * 16 + 9] := dAllData[(numRow-1) * 16 + 9] + 1;
          }

          if (FullYear >= 31 and FullYear <= 35)
          {
            dAllData[(numRow-1) * 16 + 10] := dAllData[(numRow-1) * 16 + 10] + 1;
          }

          if (FullYear >= 36 and FullYear <= 40)
          {
            dAllData[(numRow-1) * 16 + 11] := dAllData[(numRow-1) * 16 + 11] + 1;
          }

          if (FullYear >= 41 and FullYear <= 45)
          {
            dAllData[(numRow-1) * 16 + 12] := dAllData[(numRow-1) * 16 + 12] + 1;
          }

          if (FullYear >= 46 and FullYear <= 50)
          {
            dAllData[(numRow-1) * 16 + 13] := dAllData[(numRow-1) * 16 + 13] + 1;
          }
        }

#IFDEF _GP_
        if (iCatFunc.GetSysCodeIer(Conscription.AcntStruc) = 721)   // Прапорщики, мичманы, сержанты и старшины
#ELSE
        if (iCatFunc.GetSysCodeIer(Conscription.AcntCat) = 721) // Прапорщики, мичманы, сержанты и старшины
#endif
        {
          dAllData[(numRow-1) * 16 + 4] := dAllData[(numRow-1) * 16 + 4] + 1;
          if (iCatFunc.GetSysCodeIer(Conscription.MilAbility) = 2192) //
            dAllData[(numRow-1) * 16 + 6] := dAllData[(numRow-1) * 16 + 6] + 1;
        }

#IFDEF _GP_
        if (iCatFunc.GetSysCodeIer(Conscription.AcntStruc) = 720)   // Ефрейторы, солдаты и матросы
#ELSE
        if (iCatFunc.GetSysCodeIer(Conscription.AcntCat) = 720) // Ефрейторы, солдаты и матросы
#endif
        {
          dAllData[(numRow-1) * 16 + 5] := dAllData[(numRow-1) * 16 + 5] + 1;
          if (iCatFunc.GetSysCodeIer(Conscription.MilAbility) = 2192) //
            dAllData[(numRow-1) * 16 + 6] := dAllData[(numRow-1) * 16 + 6] + 1;
        }
      }

      if (Conscription.MobOrder = 'Д')   // Военнообязанные, не забронировано, не имеющие моб предписаний
      {
        dAllData[(numRow-1) * 16 + 14] := dAllData[(numRow-1) * 16 + 14] + 1;
      }
      else
      {
        if (iCatFunc.GetSysCodeIer(Conscription.SpecAcc) <> 711)
        {
          dAllData[(numRow-1) * 16 + 16] := dAllData[(numRow-1) * 16 + 16] + 1;
        }
      }
    }
  }

  if (isTotalCalc = true) // Учет общего количества сотрудников
  {
    dAllData[(numRow-1) * 16 + 1] := dAllData[(numRow-1) * 16 + 1] + 1;
  }
}

//─────────────────────────────────────────────────────────────────────────

screen scrBYC_Filter;
  show at (,,,7) ;
fields
  sBYC_Filter ('Фильтр по наименованию военного комиссариата', hcstaffInfoAnalytic_form6, sci13Esc): protect;

  KatMark_Fld1 ('Выбранные категории "Руководители" ', hcstaffInfoAnalytic_form6,sci13Esc): Protect, PickButton;
  dm_Procent01 ('% для расчета "Потребность на"') :NoProtect;
  KatMark_Fld2 ('Выбранные категории "Специалисты" ',  hcstaffInfoAnalytic_form6,sci13Esc): Protect, PickButton;
  dm_Procent02 ('% для расчета "Потребность на"') :NoProtect;
  KatMark_Fld3 ('Выбранные категории "Служащие" ',     hcstaffInfoAnalytic_form6,sci13Esc): Protect, PickButton;
  dm_Procent03 ('% для расчета "Потребность на"') :NoProtect;
  KatMark_Fld4 ('Выбранные категории "Рабочие" ',      hcstaffInfoAnalytic_form6,sci13Esc): Protect, PickButton;
  dm_Procent04 ('% для расчета "Потребность на"') :NoProtect;
<<
  Фильтр
   `Наименование военного комиссариата`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  Соответствие категорий:`Руководители`.@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@ %
                         `Специалисты` .@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@ %
                         `Служащие`    .@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@ %
                         `Рабочие`     .@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@ %
>>
end; // screen scrBYC_Filter

//-----------------------------------
screen F6ReservReport;
//-----------------------------------
Fields
   sFeeSigners ('Группа подписантов (F3 - выбор)' , , sci13Esc) : Protect;
<<
    `Подписанты`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

>>
end;

HandleEvent
//---------------------------
cmInit:
  {
    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);

    if (NOT ReadMyDsk(sFeeSigners, 'F6ReservReport2010_sFeeSigners', True))
      set sFeeSigners := '';

    if (sFeeSigners <> '')
      iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sFeeSigners);
    var ii:word;
    if (NOT ReadMyDsk(dm_Procent01, 'F6ReservReport2010_Procent1', True)) dm_Procent01:=80;
    if (NOT ReadMyDsk(dm_Procent02, 'F6ReservReport2010_Procent2', True)) dm_Procent02:=80;
    if (NOT ReadMyDsk(dm_Procent03, 'F6ReservReport2010_Procent3', True)) dm_Procent03:=80;
    if (NOT ReadMyDsk(dm_Procent04, 'F6ReservReport2010_Procent4', True)) dm_Procent04:=80;

    inherited :: handleEvent (cmInit);
    // Заполним отборы по категориям по умолчанию
    if  KMarkStr[1]='не установлено'
    and KMarkStr[2]='не установлено'
    and KMarkStr[3]='не установлено'
    and KMarkStr[4]='не установлено'
    { var ii:word=0;
      vSpr._Loop Klkatego
      {
        if wGetTune('UP.FakelGAL.Fakel') = 1
        {
          case refAttrTablePick.sGetValue(coKlKatego, iExAttr.AttrID(coKlKatego, 'Укрупненная категория'), vSpr.KlKatego.nRec) of
          'Руководители': ii:=1;//Руководители
          'Специалисты' : ii:=2;//Специалисты
          'Служащие'    : ii:=3;//Служащие
          'Рабочие'     : ii:=4;//Рабочие
            else ii:=0;
          end;
          if ii>0
           InsertMarker(KMarkers[ii],vSpr.KlKatego.nrec);
        }
        else
        {
          case vSpr.KlKatego.kod of
          5: ii:=1;//Руководители
          6: ii:=2;//Специалисты
          7: ii:=3;//Служащие
          8: ii:=0;//Ветераны
          else ii:=4;
          end;
          if ii>0
           InsertMarker(KMarkers[ii],vSpr.KlKatego.nrec);
        }
      } //vSpr._Loop Klkatego
      for(ii:=1;ii<=4;ii++)
          FillKategoryMarker(ii,false);

    } //and KMarkStr[4]='не установлено'
  } //cmInit

//---------------------------
cmPick:
  case CurField of
    #sFeeSigners:
      {
        iFeeSigners.RunWindowFeeSigners(1);
        set sFeeSigners := iFeeSigners.GetFeeSignersName;
      }
  else
    inherited :: handleEvent (cmPick);
  end;

//---------------------------
cmDelOnProtect:
  case CurField of
    #sFeeSigners :
      {
        Set sFeeSigners := '';
        SaveMyDsk(sFeeSigners, 'F6ReservReport2010_sFeeSigners');
      }
  else
    inherited :: handleEvent (cmDelOnProtect);
  end;
cmCheckField:
{ case curfield of

  else
    inherited :: handleEvent (cmDelOnProtect);
  end;


}
//---------------------------
cmOk:
  {
    var ii:word;
    SaveMyDsk(dm_Procent01, 'F6ReservReport2010_Procent1');
    SaveMyDsk(dm_Procent02, 'F6ReservReport2010_Procent2');
    SaveMyDsk(dm_Procent03, 'F6ReservReport2010_Procent3');
    SaveMyDsk(dm_Procent04, 'F6ReservReport2010_Procent4');

    if (iFeeSigners.FeeSignersIsValid)
      {
        var wFeeSignersNum, wFeeSignersCount : word;
        wFeeSignersCount := iFeeSigners.GetFeeSignersCount;

        if (iFeeSigners.GetSignerFirst)
        {
          For (wFeeSignersNum := 1; wFeeSignersNum <= wFeeSignersCount; wFeeSignersNum++)
          {
             if (iFeeSigners.GetSignerRole = 'Утверждающее лицо')
             {
               sUtve     := iFeeSigners.GetSignerFIO(7);
               sUtve2    := iFeeSigners.GetSignerFIOEx(13, False);
               sUtveDol  := iFeeSigners.GetSignerPosition(1);
               break;
             }

            if (not iFeeSigners.GetSignerNext)
              break;
          }
        }
      }//if (iFeeSigners.FeeSignersIsValid)

    SaveMyDsk(sUtve      , 'F6ReservReport2010_sUtve');
    SaveMyDsk(sUtve2     , 'F6ReservReport2010_sUtve2');
    SaveMyDsk(sUtveDol   , 'F6ReservReport2010_sUtveDol');
    // сохраним дату отбора SaveMyDsk (dDateFiltr, 'CommonFiltr_dDateFiltr');
    //'Z_STAFFREPORTS::F6RESERVREPORT2010.COMFILTREMBEDDED.Z_STAFF::COMMONFILTR.SELECTRECORD.DDATEFILTR'
    VInter.StoreAllParams;
//ПОПАДАЮТ Conscription.ConsRel->syscode = 730)   // Военнообязанные
//if (iCatFunc.GetSysCodeIer(Conscription.SpecAcc) = 711) -> Бронь Специальный учет.
//-------------- Пребывающих в запасе
//в том числе   поиск идет по "Категория воинского запаса".
//офицеров
//->if(iCatFunc.GetSysCodeIer(Conscription.AcntCat) = 722) - Офицеры и генералы
//прапорщиков, мичманов, сержантов, старшин, солдат и матросов
//->if(iCatFunc.GetSysCodeIer(Conscription.AcntCat) = 721) - Прапорщики, мичманы, сержанты и старшины
//->if(iCatFunc.GetSysCodeIer(Conscription.AcntCat) = 720) - Ефрейторы, солдаты и матросы
//----------  Забронировано  - аналогично Пребывающих в запасе
//в том числе
//офицеров
//прапорщиков, мичманов, сержантов, старшин, солдат и матросов

    inherited :: handleEvent (cmOk);
  }

end;
end.
