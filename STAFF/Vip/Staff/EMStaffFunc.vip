#include EMStaffFunc.vih

Interface EMStaffFunc '';
//******************************************************************************
var
 UP_STAFF_COMMONRULES_ConfirmNullTaxRate:boolean;
Create view
var
  pContDoc:comp ;
as select 
  ContDoc.Nrec
from
  ContDoc
, Appointments
, Catalogs
, SpAllStaff
, AppHist
, catalogs catPodr
Where
((  pContDoc == ContDoc.Nrec
and ContDoc.ObjNrec         == Appointments.Nrec
AND Appointments.ResComp[1] == SpAllStaff.NRec
AND ContDoc.Nrec            == AppHist.cContDoc
AND Appointments.department == catPOdr.nrec
))
;

//*****************************************************************************

function Check(cRec : comp) : boolean;
{ set pContdoc:=cRec;
  if (GetFirst ContDoc=tsok) // where (( cRec == ContDoc.NRec )) = tsOk)
    if (ContDoc.TypeOper = 1)
      {
        if (word(ContDoc.cNew2) = 2) // По договору подряда  
          {
            if (Appointments.wAddWord1 <> 2)
              {
                Message('Для вида договора "По договору подряда" значение поля "по штатному расписанию/внештатного расписания" может быть только значение "вне ШР!');
                result := false;
                Exit;
              }

            if (GetFirst SpAllStaff <> tsOk)
              {
                Message('Необходимо заполнить договор!');
                result := false;
                Exit;
              }
            if (GetFirst Catalogs where ((SpAllStaff.ResComp[1]   == Catalogs.NRec)) = tsOk)
              {
                if (UpCase(Catalogs.Name) <> UpCase('Гражданско-правовой'))
                  {
                    Message('Для вида договора "По договору подряда" вид договора должен быть "Гражданско-правовой"!');
                    result := false;
                    Exit;
                  }  
              }
            else
              {
                Message('Не задан вид договора!');
                result := false;
                Exit;
              }  
          } //if (word(ContDoc.cNew2) = 2)
        else
          {

            if UPCASE(catPOdr.name) <> UPCASE('ВЕТЕРАНЫ') // ветеранам вне ШР не проверяем ничего
            {
            if (Appointments.wAddWord1 <> 1)
              {
                Message('Значение поля "по штатному расписанию/внештатного расписания" может быть только значение "по ШР!');
                result := false;
                Exit;
              }
            if (GetFirst SpAllStaff <> tsOk)
              {
                Message('Необходимо заполнить договор!');
                result := false;
                Exit;
              }
            if (GetFirst Catalogs where ((SpAllStaff.ResComp[1]   == Catalogs.NRec)) = tsOk)
              {
                if (UpCase(Catalogs.Name) = UpCase('Гражданско-правовой'))
                  {
                    Message('Вид договора НЕ должен быть "Гражданско-правовой"!');
                    result := false;
                    Exit;
                  }  
              }
            else
              {
                Message('Не задан вид договора!');
                result := false;
                Exit;
              }
            }
          } //elseif (word(ContDoc.cNew2) = 2)
    
        if (word(ContDoc.cNew2) <> 2)
          { UP_STAFF_COMMONRULES_ConfirmNullTaxRate:=boGetTune('UP.STAFF.COMMONRULES.ConfirmNullTaxRate');
            if not UP_STAFF_COMMONRULES_ConfirmNullTaxRate
            { if (GetFirst AppHist <> tsOk)
                {
                  Message('Не задан оклад!');
                  result := false;
                  Exit;
                }
              else
              if (AppHist.TaxRate = 0)
                {
                  Message('Не задан оклад!');
                  result := false;
                  Exit;
                }
            } //if not UP_STAFF_COMMONRULES_ConfirmNullTaxRate
          }  //if (word(ContDoc.cNew2) <> 2)
      } //if (ContDoc.TypeOper = 1)

  result := true;
}

//*****************************************************************************
end.
