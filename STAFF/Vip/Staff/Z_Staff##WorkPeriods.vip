HandleEvent
cmOnVipLoad:
{  
  inherited :: HandleEvent (cmOnVipLoad);
//message('Kosty2');
//===============================================================================

  var ww_field:longint;
  var ww_fieldname:string;
  var lErr:longint;

  if wGetTune('UP.Fakel.OTPUSKPOLE') = 1
  {

    ww_fieldname := 'PUTVACATION.RESDOUBLE[1]';
  
    lErr:=cfsCreateObject ('Column','BRPUTVACATIONWITHEDIT',ww_fieldname,FALSE,ww_field); 
  
    cfsSetProp(ww_fieldname,'Index',integer(4));
    cfsSetProp(ww_fieldname,'Protect',False);
    cfsSetProp(ww_fieldname,'Title','Использованные');
    cfsSetProp(ww_fieldname,'Skip',False);
    cfsSetProp(ww_fieldname,'HelpLine','Использованные отпуска');
    cfsSetProp(ww_fieldname,'DefaultWidth',integer(10));
    cfsSetProp(ww_fieldname,'StatusCtx',sci178Esc)

  }

}
cmHotKeys:
{
  if (not bOnlyReadAccess)
  {
    if ( WorkPeriod.wStatus = word(1) )
      DisableCommand(cmRecalcAllSums);
    else
      EnableCommand(cmRecalcAllSums);
  }

  case CurTable of
    // меню только для левой части (рабочие периоды)
    #WorkPeriod:
    {
      // если доступа на редактирование - нет, то cmValue1 уже закрыт
  if bOnlyReadAccess
    exit;

  if (IsValid(#WorkPeriod)) or (wPeriodTypeGl = cnWP_Accounting)
  {
    EnableCommand(cmValue1);
    EnableCommand(cmInsert);
  }
  else
  {
    DisableCommand(cmValue1);
    DisableCommand(cmInsert);
  }

      if wPeriodTypeGl = cnWP_Work
      {
        var liMenue1: LongInt;
        if ( IsValid(#WP_Appoint) )
        {
          if (funCheckSecRecep(WP_Appoint.lPrizn, WorkPeriod.ResWord[2]))
            liMenue1 := LoadMenu('WorkPeriodMenu');
          else
            liMenue1 := LoadMenu('mnuWorkPeriodMenuPovt');
        }
        else
        {
          liMenue1 := LoadMenu('mnuWorkPeriodMenuPovt');
          if ( IsValid(#WorkPeriod) )
          {
            AddMenuItem(liMenue1, 'separator', 666);
            AddMenuItem(liMenue1, 'Синхронизировать учетные периоды с основными назначениями', cmValue10);
          }
        }

        if ( funcIsCrossWPFind(WorkPeriod.nRec) )
        {
          var liMenue2: LongInt;

          liMenue2 := LoadMenu('WorkPeriodCrossMenu');
          ConcatMenu(liMenue1, liMenue2);
        }

    if wGetTune('UP.Fakel.OTPUSKPOLE') = 1
    {
      AddMenuItem(liMenue1, 'separator', 666);
      AddMenuItem(liMenue1, 'Удаление пологающегося по периоду отпуска (Fakel)',cmValue24);
    }

        PutHotCommand(RunLoadMenu(liMenue1));
//        PutHotCommand(RunMenu('WorkPeriodMenu'));
      }
      else
        PutHotCommand(RunMenu('AccountingPeriodMenu'));
    }

    #mt_BalanceVac
  , #PutVacation:
    {
      if wPeriodTypeGl = cnWP_Work
      {
        var liMenue1: LongInt;

        if (funCheckSecRecep(WP_Appoint.lPrizn, WorkPeriod.ResWord[2]))
          liMenue1 := LoadMenu('mnuPutVacations');
        else
          liMenue1 := LoadMenu('mnuPutVacationsPovt');

        if ( PutVacation.wProvidWay = word(2) )
        {
          var liMenue2: LongInt;

          liMenue2 := LoadMenu('mnuPutVacationsCalcHarm');
          ConcatMenu(liMenue1, liMenue2);
        }

        if ( IsValid(tnWorkPeriodOst) ) and ( WorkPeriodOst.wTypePeriod = cnWP_FuturePVac )
        {
          var liMenue2: LongInt;

          liMenue2 := LoadMenu('mnuPutVacationsFutureOst');
          ConcatMenu(liMenue1, liMenue2);
        }

    if wGetTune('UP.Fakel.OTPUSKPOLE') = 1
    {
      AddMenuItem(liMenue1, 'separator', 666);
      AddMenuItem(liMenue1, 'Удаление пологающегося по периоду отпуска (Fakel)',cmValue24);
    }

        PutHotCommand(RunLoadMenu(liMenue1));

      }
      else
        PutHotCommand(RunMenu('mnuPutVacationsAcc'));
    }

    #WP_Shift:   // сдвиг рабочих периодов
    {
      if iMsgPr.fnExistLinkedMessages(coWorkPeriod, WP_Shift.NRec) //если существует протокол
        PutHotCommand(RunMenu('mnuWPShift'));
    }
  end;

}

cmValue24:
{// UpdateTable;
    delete current PUTVACATION;
    Rereadrecord;
      stop;
}

cmPickAttr:
{
  if (IsNew)
    if (not IsModified)
      {
        Message('Переход невозможен, так как не заполнен документ', OkButton);
        Exit;
      }

  if (UpdateTable)
    if (WorkPeriod.nRec <> 0)
       {
         RunInterface('Attribute', coWorkPeriod, WorkPeriod.nRec, false);
       }
}

end;

end.

WorkPeriodMenu Menu
{
  - 'Внешние атрибуты'                    , cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc,,,,bmpAttribute;
  - 'Добавить рабочий период', cmValue1, '', , 'F7', kbF7;
  - 'Удалить рабочий период',  cmDelete, '', , 'F8', kbF8;
  - 'Заполнить рабочие периоды', cmNal, '', , 'Alt+F', kbAltF;
----------;
  - 'Сформировать полагающиеся отпуска', cmRecalcAllSums, '', , 'Alt+G', kbAltG;
  - 'Разрешить/запретить формировать полагающиеся отпуска', cmValue9;
----------;
  - 'Изменить дату окончания рабочего периода', cmValue7;
  - 'Объединить рабочие периоды', cmValue4;
  - 'Разделить рабочий период', cmValue11;
  - 'Пересчитать сдвиги рабочего периода', cmStaffDoc2Doc, '', , 'Alt+D', kbAltD;
  - 'Синхронизировать рабочие периоды с основными назначениями', cmValue10;
----------;
  - 'Скрыть/показать столбцы', cmValue5;
  - 'Фильтр по датам рабочих периодов', cmFilterSave, 'Установка фильтра по датам',, 'Alt+B', kbAltB;
}
