/*************************************************************************************************\
* Наименование:  Доработка интерфейса "Редактирование группы подписантов"                         *
* Контур/Модуль: Кадры                                                                            *
* Примечание:    Управление персоналом > Документы > Командировки >                               *
*                Режим редактирования приказа на командировку > Контекстное меню ПЕЧАТЬ >         *
*                Приказ на командировку > выбор в поле "Подписанты"                               *
*                Интерфейс FeeSigners Добавлен функционал по созданию копии                       *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1122         |30/10/17|Потапов А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

#component "F_Common"

//***************************************
Alter Interface FeeSigners;
//***************************************

var lMenuID : longInt;

create view
var
  pSelection:comp;
as select Sign2Copy.Nrec
from
  Selection Sign2Copy
, SelPicks  SpSign2Copy
, AttrVal   AttrSign2Copy
where ((
    pSelection      == Sign2Copy.nRec
and 9406            == AttrSign2Copy.wTable
and Sign2Copy.nRec  == AttrSign2Copy.cRec
and Sign2Copy.nRec  == SpSign2Copy.cSelection
))
;

procedure CopySign;
{
  var isAnyBad : boolean = false;
  BeginConcurrentTransaction(0);
  set pSelection:=tmpSelection.NrecSelection;
  //where((tmpSelection.NrecSelection == Sign2Copy.nRec))
  if getfirst Sign2Copy  = tsOk
  {
    Var max : word = 0;
    _Loop SelectionFree
      if (SelectionFree.AllPkd > max)
        max := SelectionFree.AllPkd;

    Sign2Copy.nRec   := GetNextnRec(#Sign2Copy,0);
    Sign2Copy.Name   += ' (копия)';
    Sign2Copy.AllPkd := max + 1;
    _try
      if (insert current Sign2Copy) <> tsOk
        isAnyBad := true;
    if not isAnyBad
    {
      _loop AttrSign2Copy //where((9406 == AttrSign2Copy.wTable and tmpSelection.NrecSelection == AttrSign2Copy.cRec))
      {
        AttrSign2Copy.nRec := GetNextnRec(#AttrSign2Copy,0);
        AttrSign2Copy.cRec := Sign2Copy.nRec;
        _try
          if (insert current AttrSign2Copy) <> tsOk
            isAnyBad := true;
      }
      _loop SpSign2Copy //where((tmpSelection.NrecSelection == SpSign2Copy.cSelection))
      {
        SpSign2Copy.nRec := GetNextnRec(#SpSign2Copy,0);
        SpSign2Copy.cSelection := Sign2Copy.nRec;
        _try
          if (insert current SpSign2Copy) <> tsOk
            isAnyBad := true;
      }
    }

    if isAnyBad
    {
      AbortTransaction;
      message('В процессе копирования произошла ошибка!'#13+'Изменения сохранены не будут.'#13+'Повторите попытку еще раз.',Error);
    }
    else
    {
      EndTransaction;
      tmpSelectionInit;
      if IsValid(#tmpSelection)
        tmpSelectionSubInit(tmpSelection.NrecSelection)
      else
        tmpSelectionSubInit(0);
      RereadRecord(#tmpSelection);
      RereadRecord(#tmpSelectionSub);
      // позиционируемся на копию
      if GetFirst tmpSelection where((Sign2Copy.nRec == tmpSelection.NrecSelection)) <> tsOk {};
      message('Копирование прошло успешно!',Information);
    }
  }
} //procedure CopySign;


//=================================
OverLoadFormats trSelSelPicks;
//=================================
//************************************************************************************************************
Window wiFeeSelection 'Выбор группы подписантов' (, hcCommong_Signers, sci147EnEsc) EscClose, Cyan;
//  Show at (, , 100, 25);
Panel pSelSelPicks;
   Show at (, 11, ,);
tree 2 trSelSelPicks (,,sci14EscTree);
  Table tmpSelectionSub;
Fields
#IFDEF _GP_
// - это дерево  browseOrder '№','сорт.' ('порядковый номер с учетом сортировки'):[2];
#ENDIF
  tmpSelectionSub.PickNum      '№'#13'п/п'('№ п/п'):                              [3], Protect;
  tmpSelectionSub.TabNmb       'Таб.'#13'номер' ('Табельный номер сотрудника',,): [5], Protect;
  tmpSelectionSub.Name         'Сотрудник' ('ФИО сотрудника',,):                 [25], Protect;
  tmpSelectionSub.sDolg        'Должность' ('Должность сотрудника',,):           [19], Protect;
  tmpSelectionSub.sRole        'Роль'      ('Роль',,):                           [19], Protect;
  tmpSelectionSub.DoverChar    'Д' ('Выводить доверенность после ФИО',,):         [3], Protect;
  tmpSelectionSub.Primechanie  'Примечание' ('Примечание для подписанта',,):     [10], Protect;
end;
end; // Panel pSelSelPicks
end;//Window wiFeeSelection
//**********************************************************
Window wiEditSelection 'Редактирование группы подписантов' (,hcCommong_Signers,) EscClose;


HandleEvent
  cmHotKeys:
  {
    lMenuID := LoadMenuEx('F_Common::mFeeSigners',false,true);
    AddMenuItem  (lMenuID,'separator',1);
    AddMenuItemEx(lMenuID,'Копировать группу подписантов','Копировать группу подписантов','',cmValue7,0);
    PutHotCommand(RunLoadMenu(lMenuID));
  }
  cmValue7:
  {
    CopySign;
  }
end;
end;//Window wiEditSelection
end.
