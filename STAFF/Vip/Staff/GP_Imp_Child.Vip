#include GP_Status.vih
#include CatFunc.Vih

VipInterface GP_IMP_CHILD Licensed(free);
#doc
импорт в БД Загрузка детей
файла z:\Import\#Obmen\Дети\RELATIVE_ADD.xlsx
#end
Interface GP_IMP_CHILD 'Загрузка детей' , EscClose;
//---------------------------------------
//----------------------------------
var
  nm_file      :string;
  logfilenm    :string;
  logfilekl    :boolean;
  VA_VID_PROIZV:comp;
  cat_main_M11 :comp;
  cat_main_M3  :comp;
  pDocSvid     :comp;//Свидетельство о рождении
  iCatFunc     :CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
//----------------------------------
Create view
var
  Podr_kod:string;
  sFio :string;

as select Catalogs.Nrec
From  Catalogs, Persons, Sys_Uder
where ((
     Persons.Nrec == PsnLinks.FromPerson
and  sFio         == PsnLinks.RFio(noindex)
and  PsnLinks.Nrec == Sys_Uder.cex
and  string(2) == Sys_Uder.NMNEM
//and     Sys_Uder.cHozOper == Catalogs.Nrec

));
//------------------------------------
Create view vSpKau
var
  pSpKau:comp;
as select SpKau.name
From SpKau
where ((
   pSpKau == Spkau.nrec
)); //Create view vSpKau


#include Excel_Imp.Vpp


#include ShowKau.Vpp
//------------------------------------------------
// Получить значение аналитики
//------------------------------------------------
Function GetAnaliticName(_KodGroup:word;_cKau:comp):string; Cacheable;
{ Result:='';
  if _KodGroup>10000
  { vSpkau.pSpKau:=_cKau;
    if vSpKau.getfirst spkau=tsok
      Result:=vSpKau.Spkau.name;
  }
  else
  { Result:=#ShowKau(_KodGroup,_cKau);
  }
} //Function GetAnaliticName(_KodGroup:word;_cKau:comp):string; Cacheable;

//------------------------------------------------
// Получить значение аналитики
//------------------------------------------------
Function GetAnaliticNrec(_KodGroup:word;_sKau:string):comp; Cacheable;
{ Result:=0;
  if _KodGroup>10000
  {
    if vSpKau.getfirst spkau where (( _KodGroup == spKau.KodGrKau and _sKau== SpKau.code)) =tsok
      Result:=vSpKau.Spkau.nrec;
  }
  else
  { Result:=0;
  }
} //Function GetAnaliticName(_KodGroup:word;_cKau:comp):string; Cacheable;




Function FormDoc:boolean;
var
  cPolisOMS
, cAddrTemp
, cAddrBase
, cAddrSch
, cTel
//, cBornSvid
//, cCatChild
  : comp;
  ww_str:string;
{ Result:=False;
  logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0);
  if not FileExist(nm_file)
  { message('Не нашли файл '
     +chr(13)+nm_file );
    Exit;
  }
  cat_main_M11:=0;
  if getfirst Catalogs where (( -11 == Catalogs.syscode ))=tsok
  { var _nrec:comp=catalogs.nrec;
    cat_main_M11:=_nrec;
  }
  if cat_main_M11=0
  { Message('Не нашли точку входа для -11 каталога(СЕШР)' );
    Exit;
  }
  cat_main_M3:=0;
  if getfirst Catalogs where (( -3 == Catalogs.syscode ))=tsok
  { var _nrec:comp=catalogs.nrec;
    cat_main_M3:=_nrec;
  }
  if cat_main_M3=0
  { Message('Не нашли точку входа для -3 каталога(Документы)' );
    Exit;
  }
  pDocSvid:=0;
  if getfirst Catalogs where ((
        cat_main_M3 == Catalogs.MainLink
    and 0 == Catalogs.Lpr
    and 'Свидетельство о рождении' == Catalogs.Name
     )) =tsok
    pDocSvid:=Catalogs.Nrec ;
  VA_VID_PROIZV:=ExtAttr_ID(coCatalogs,'Вид производства');

  //------------------------------
  logfilekl:=true;
  //------------------------------
  var isAllOk:boolean=true;
  //====================================
  v_Imp.num_col:=60;// иначе первые 50
  Timelog('GP_KPI_DOC_Vid_Proizv_Imp->ReadDataFromExcel:Start');
  XlKillExcel;
  if not ReadDataFromExcel(0,nm_file,'Лист1',False,true)
  { message('Ошибка импорта из'+chr(13)+nm_file);
      exit ;
  }

  Timelog('GP_KPI_DOC_Vid_Proizv_Imp->ReadDataFromExcel:Finish');
  //====================================
  cPolisOMS := ExtAttr_Id(coPsnLinks,'Полис ОМС ребенка (члена семьи)');
  if cPolisOMS = 0
      cPolisOMS := ExtAttr_Create(coPsnLinks,'Полис ОМС ребенка (члена семьи)', cgAttrType_Str);

  //Полис ОМС ребенка (члена семьи)
  cPolisOMS := ExtAttr_Id(coPsnLinks,'Полис ОМС ребенка (члена семьи)');
  if cPolisOMS = 0
      cPolisOMS := ExtAttr_Create(coPsnLinks,'Полис ОМС ребенка (члена семьи)', cgAttrType_Str);

  //Адрес временного места пребывания ребенка (члена семьи)
  cAddrTemp := ExtAttr_ID(coPsnLinks,'Адрес временного места пребывания ребенка (члена семьи)');
  if cAddrTemp = 0
      cAddrTemp := ExtAttr_Create(coPsnLinks,'Адрес временного места пребывания ребенка (члена семьи)', cgAttrType_Str);

  //Постоянное место проживания родственника
  cAddrBase := ExtAttr_Id(coPsnLinks,'Постоянное место проживания родственника');
  if cAddrBase = 0
      cAddrBase := ExtAttr_Create(coPsnLinks,'Постоянное место проживания родственника', cgAttrType_Str);


  //Адрес школы (дет.сад) ребенка
  cAddrSch := ExtAttr_Id(coPsnLinks,'Адрес школы (дет.сад) ребенка');
  if cAddrSch = 0
      cAddrSch := ExtAttr_Create(coPsnLinks,'Адрес школы (дет.сад) ребенка', cgAttrType_Str);

  //Телефон
  cTel := ExtAttr_Id(coPsnLinks,'Контактный телефон родственника');
  if cTel = 0
      cTel := ExtAttr_Create(coPsnLinks,'Контактный телефон родственника', cgAttrType_Str);

  var wexrow_:longint;
  wexrow_:=0;
  var wkl_err:boolean;
  wkl_err:=false;
  Timelog('GP_KPI_DOC_Vid_Proizv_Imp->Import:Start');
  XlKillExcel;
  v_imp._loop tmp_excel
  { if not nextvisual then
    { isAllOk:=false;
        break;
    }
    wexrow_++ ;
    if wexrow_=1
    { continue;
    }
    var _sID:string=v_imp.tmp_excel.dmcell[4];
    if getfirst persons where (( comp(_sID) == Persons.Nrec )) <>tsok
    { continue;
    }
    sFio:=v_imp.tmp_excel.dmcell[5];
    var _sDoc:string=v_imp.tmp_excel.dmcell[8];
    if getfirst PsnLinks<>tsok continue;
    if pDocSvid<>0 and _sDoc<>''
    { if getfirst Sys_Uder<>tsok
      { clearbuffer(#Sys_Uder);
        Sys_Uder.cHozOper:=pDocSvid;
//  Sys_Uder.DATAN #3'Действите-',#3'лен с'  ('Действителен с',,sci1378Esc) : [11,'DD/MM/YYYY'], noProtect;
//  Sys_Uder.DATOK #3'Действите-', #3'лен по' ('Действителен по',,sci1378Esc) : [11,'DD/MM/YYYY'], noProtect;
//  Sys_Uder.LastUser #3'Серия, номер', #3'документа' ('Серия, номер документа (через пробел)',,sci178Esc) : [20], noProtect;
//  Sys_Uder.LastDate #3'Дата', #3'выдачи' ('Дата выдачи',,sci1378Esc) : [11,'DD/MM/YYYY'], noProtect;
//  Sys_Uder.NMpodr + Sys_Uder.Param + Sys_Uder.Csubschk + Sys_Uder.CSCHETK
//  issued #3'Кем выдан' ('Кем выдан',,sci178Esc) : [100], noProtect;
        Sys_Uder.NMNEM:='2';
        Sys_Uder.LastUser:=_sDoc;

        insert current Sys_Uder;
      } //if getfirst Sys_Uder<>tsok

    } //if pDocSvid<>0
    if v_imp.tmp_excel.dmcell[10]<>''
    { ww_str:=v_imp.tmp_excel.dmcell[10];
      if Length(ww_str)=11
      { if pos(' ',ww_str)=0
        if pos('-',ww_str)=0
        //9-999-999-99-99       1                      4                      7                      9                      11
        ww_str:=substr(ww_str,1,1)+'-'+substr(ww_str,2,3)+'-'+substr(ww_str,5,3)+'-'+substr(ww_str,8,2)+'-'+substr(ww_str,10,2)
      }
      sSetAttrID(coPsnLinks,PsnLinks.Nrec,cTel,ww_str);

    }
  } //v_imp._loop tmp_excel
  Timelog('GP_KPI_DOC_Vid_Proizv_Imp->Import:Finish');
  ReScanPanel(#Catalogs);
  Result:=true;
} //FomdDoc





Screen scrParam;
Table Catalogs;
Fields
  nm_file:NoProtect, PickButton;
Buttons
  cmOk    ,,, 'Установить фильтр', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;

<<
  Файл   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 <. Продолжить .>  <.   Отмена   .>
>>
end;


HandleEvent
  cmInit:
  { nm_file:='';
    if not ReadMyDsk(nm_file,'GP_KPI_DOC_Vid_Proizv_Imp_nm_file',False)
      nm_file:='z:\Import\#Obmen\Дети\RELATIVE_ADD.xlsx' ;
    logfilenm:=GetStringParameter('Files','OutputFilesDirectory',0)
                               +'!TimeLog.log';
    timelog_init;
  }
  cmDone:
  {

  }
  cmOk:
  { SaveMyDsk(nm_file,'GP_KPI_DOC_Vid_Proizv_Imp_nm_file');

    StartNewVisual(vtNumericVisual, vfTimer, 'Ждите, идет сбор данных', 0);
    FormDoc;
    StopVisual('',0);
  }
  cmCheckField:
  { case curField of
    #nm_file:
    { if not FileExist(nm_file) message('Файл не найден!');

    }
    end;
  }
  cmPick:
  { case CurField of
    #nm_file:
    { var ww_str:string=GetFileName('*.xlsx','Выберите файл процентами премий из КИС');
      if ww_str<>'' set nm_file:=ww_str;
    }
    end;
  }
  end;

end.
