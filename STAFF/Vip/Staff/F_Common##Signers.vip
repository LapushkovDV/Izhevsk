#component "F_Common"

alter interface iSigners;

Window  wSignersEdit 'Редактирование справочника подписантов (ЭМ)' EscClose;
HandleEvent
cminit:
{
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
  var wW : word = 90;
  cfsSetCurrentContainer('F_COMMON::ISIGNERS');
  cfsSetProp('WSIGNERSEDIT'       ,cfpRectB_X,wW--);
  cfsSetProp('SCEDITPERSONS'      ,cfpRectB_X,wW);
  cfsSetProp('SCEDITPERSPOD'      ,cfpRectB_X,wW);
  cfsSetProp('SCPERSPODFIO'       ,cfpRectB_X,wW);
  cfsSetProp('SCPERSPODPOSITION'  ,cfpRectB_X,wW);
  cfsSetProp('SCSIGNERINFO'       ,cfpRectB_X,wW);
}
end;
end;
end.
