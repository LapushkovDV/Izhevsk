
#include ExtAttr.vih
#include ExtAttr.var

#component "Z_Staff"

alter interface TelWin;

CReate view histwin
 as select *
from em_unidoc_head euh
;


ExtendFormats brwCommunic_Phone,brwCommunic_Email;

panel panCommunications;
  table Communications;
//ExtendTabbedSheets TabsPanel;
browse brwCommunic_Phone;
    Fields
    [datvvod0] dGetAttr(25004,Communications.NRec,'Дата ввода') 'Действ. с' ('Действует с') : [10];
  end;
browse brwCommunic_Email;
    Fields
    [datvvod1] dGetAttr(25004,Communications.NRec,'Дата ввода') 'Действ. с' ('Действует с') : [10];
  end;

TableEvent table Communications;
cmCheckField:
{
  var sstat:string;
  var cnrec:comp;
  case CurField of
    #Communications.Addr:
    {
      if wGetTune('UP.FakelGAL.Fakel') = 1
       {

        cnrec:=Communications.nrec;
        sstat:=Communications.Addr;
        histwin.insert euh set euh.wtype:=word(778),
                               euh.wparenttable:=word(25004),
                               euh.cparentdoc:=cnrec,
                               euh.adddate[1]:=cur_date,
                               euh.addstring[1]:=sstat;
        dsetAttr(25004,Communications.NRec,'Дата ввода', cur_date);
       }

    }
    #Communications.EMail:
    {
      if wGetTune('UP.FakelGAL.Fakel') = 1
       {

        cnrec:=Communications.nrec;
        sstat:=Communications.EMail;
        histwin.insert euh set euh.wtype:=word(778),
                               euh.wparenttable:=word(25004),
                               euh.cparentdoc:=cnrec,
                               euh.adddate[1]:=cur_date,
                               euh.addstring[1]:=sstat;
        dsetAttr(25004,Communications.NRec,'Дата ввода', cur_date);
       }

    }
  end;
  case inherited :: handleEvent (cmCheckField) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
}
end;
end;// panCommunications
HandleEvent//interface
cmInit:
{
   if (wGetTune('UP.FAKELGAL.FAKEL') = 0) then
  {
    cfsSetExtProp('c_BRWCOMMUNIC_PHONE_DATVVOD0_Действ._с', 'Visible', false);
    cfsSetExtProp('c_BRWCOMMUNIC_EMAIL_DATVVOD1_Действ._с', 'Visible', false);
  }
  case inherited :: handleEvent (cmInit) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
}
cmExprFieldChanged:
{
  case inherited :: handleEvent (cmExprFieldChanged) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
  var d0,d1:date;
  case CurField of
    #datvvod0:
    {
      d0:=StrToDate(ExprFieldValue,'DD/MM/YYYY');
      dsetAttr(25004,Communications.NRec,'Дата ввода', d0);
    }
    #datvvod1:
    {
      d1:=StrToDate(ExprFieldValue,'DD/MM/YYYY');
      dsetAttr(25004,Communications.NRec,'Дата ввода', d1);
    }
  end;
}
cmValue7:
{
  RunInterface('HistTelWin',Communications.nrec);
}
cmHotKeys :
{
  var MenuName: string;
  MenuName := 'Z_Staff::TMail_HotKeys;';
   if wGetTune('UP.FakelGAL.Fakel') = 1
   {
     MenuName := MenuName + 'Z_Staff::histtm_HotKeys;';
   }
  PutHotCommand(RunDynMenu(MenuName));

}
end;//interface

end.

histtm_HotKeys Menu
{
  - 'История', cmValue7, 'История изменения данных',,,,sci1Esc;
  ----------;
}
