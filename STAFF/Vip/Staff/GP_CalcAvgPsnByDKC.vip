table struct ttStat
(
  sPodrN   : string
, sPodrC   : string
, cPodr    : comp
, cKatPodr : comp
, dbVal0   : array[1..9] of double
, dbVal1   : array[1..9] of double
, dbVal2   : array[1..9] of double
, dbVal3   : array[1..9] of double
)
with index
(
  ttStat01 = cPodr   
, ttStat02 = cKatPodr
, ttStat03 = sPodrC
);


var
  dBeg, dEnd    : date;
  wPeriodMonth
 ,wPeriodYear   : word;  
  iCatFunc      : CatalogsFunctions;
//  i3GD          : GP_3GD;
  iOut          : GP_XlOutExt;
  VInterf       : PickCatalog2;// Интерфейс работы с каталогами
  sFullName     : string;
  sKatWorker1
 ,sKatWorker2
 ,sKatWorker3
 ,sKatWorker4
 ,sKatWorker5
 ,sKatWorker6
 ,sKatWorker7   : string;
  sPodr1
 /*,sPodr2*/        : string;
  mKatWorker1
 ,mKatWorker2
 ,mKatWorker3
 ,mKatWorker4
 ,mKatWorker5
 ,mKatWorker6
 ,mKatWorker7   : TPtr;
  mPodr1     
 /*,mPodr2*/        : TPtr;
  lRB, lHS,
  lCB, lCE,
  lSB, lSE,
  lBB, lBE,
  lDB, lDE      : longint;
  dbNIKRate     
 ,dbNIKPsn      : double;
  iKolPodr      : integer;

create view
var
  cPodrV : comp;
  cAppNr : comp;
from
  ttStat
, KlKatego
, ExtCatLinks
, Statis
//для списочной численности т.к. в Statis только для основного места работы - пересчитываем самостоятельно
//из Statis берем только ССЧ - там считается корректно.
,LSchet       alllsc
,staffstruct  allsts
,appointments allapp
,LSTab        alllst
,KlKatego     allktg
//,KlFilter
,PrVidOpl
where
((
                    11 == ExtCatLinks.ObjType
and             cPodrV == ExtCatLinks.StaffCat
and ExtCatLinks.ExtCat == Statis.Cex
and        wPeriodYear == Statis.YearN
and       wPeriodMonth == Statis.MesN
//для списочной численности и НОКР
and   cPodrV           == allsts.Department and ((dBeg<= allsts.dClose or allsts.dClose=0) and dEnd>=allsts.dInput)
and   allsts.nRec      == allapp.StaffStr and ((dBeg<=allapp.DismissDate or allapp.DismissDate=0) and dEnd>=allapp.AppointDate)
and   allapp.cAddnRec2 == alllsc.nRec
and allsts.EmpCategory == allktg.nRec
and   allapp.cAddnRec2 == alllst.cLSchet
and        wPeriodYear == alllst.YearN
and       wPeriodMonth == alllst.MesN and (alllst.Cex = ExtCatLinks.ExtCat and alllst.cAppoint = allsts.Post)
//and       allsts.cPodr == KlFilter.NRec
and   allapp.cAddnRec2 == PrVidOpl.cLSch and (Year(PrVidOpl.DataN)=wPeriodYear and month(PrVidOpl.DataN)=wPeriodMonth and PrVidOpl.CSCHETD='20')
))
;
//++++++++++++++++++++++++++++++++++++++++++++++++
