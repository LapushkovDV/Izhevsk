function sSetKatName(mSetKat: TPtr; wKat : word): string;
{
  if (wKat = 0) and (getMarkerCount(mSetKat) = 0)
  {
    result := 'Не выбраны категории';
    exit;
  }
  else
    if (getMarkerCount(mSetKat) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetKat, 0, cTmp);
      if GetFirst KlKatego where (( cTmp == KlKatego.NRec )) = tsOk
        result := KlKatego.NaiKat;
      else
        result := '';
    }
    else
    {
      if (getMarkerCount(mSetKat) > 1)
      { result := 'Несколько категорий (' + string(getMarkerCount(mSetKat)) + ')';}
      else
        if GetFirst KlKatego where (( wKat == KlKatego.Kod )) = tsOk
        {
          case wKat of
          1: {InsertMarker(mKatWorker1, KlKatego.NRec);}
          2: {InsertMarker(mKatWorker2, KlKatego.NRec);}
          3: {InsertMarker(mKatWorker3, KlKatego.NRec);}
          4: {InsertMarker(mKatWorker4, KlKatego.NRec);}
          5: {InsertMarker(mKatWorker5, KlKatego.NRec);}
          6: {InsertMarker(mKatWorker6, KlKatego.NRec);}
          7: {InsertMarker(mKatWorker7, KlKatego.NRec);}
          end;
          result := KlKatego.NaiKat;
        }
    }
}
function wWhatColRep(wKateg : word) : word;
{
  var cRecKlKatego : comp=comp(0);

  if getfirst KlKatego where((wKateg == KlKatego.Kod)) = tsOk
    cRecKlKatego := KlKatego.nRec;
  if cRecKlKatego <> comp(0)
  {
    if FoundMarker(mKatWorker1, cRecKlKatego)
    {result := 1}
      else
    if FoundMarker(mKatWorker2, cRecKlKatego)
    {result := 2}
      else
    if FoundMarker(mKatWorker3, cRecKlKatego)
    {result := 3}
      else
    if FoundMarker(mKatWorker4, cRecKlKatego)
    {result := 4}
      else
    if FoundMarker(mKatWorker5, cRecKlKatego)
    {result := 5}
      else
    if FoundMarker(mKatWorker6, cRecKlKatego)
    {result := 6}
      else
    if FoundMarker(mKatWorker7, cRecKlKatego)
    {result := 7}
  }
  else
  {result := 0}
}

procedure SetStatFieldValue(wRow, wCol : word; dbSetVal : double);
{
  if wCol <> 0
  case wRow of
  0: {ttStat.dbVal0[wCol]+=dbSetVal;}
  1: {ttStat.dbVal1[wCol]+=dbSetVal;}
  2: {ttStat.dbVal2[wCol]+=dbSetVal;}
  3: {ttStat.dbVal3[wCol]+=dbSetVal;}
  end;
}

procedure SetNIOKRFieldValue(wRow : word; dbSetVal8, dbSetVal9 : double);
{
  case wRow of
  0: {ttStat.dbVal0[8]+=dbSetVal8 ;ttStat.dbVal0[9]+=dbSetVal9;}
  1: {ttStat.dbVal1[8]+=dbSetVal8 ;ttStat.dbVal1[9]+=dbSetVal9;}
  2: {ttStat.dbVal2[8]+=dbSetVal8 ;ttStat.dbVal2[9]+=dbSetVal9;}
  3: {ttStat.dbVal3[8]+=dbSetVal8 ;ttStat.dbVal3[9]+=dbSetVal9;}
  end;
}

function sSetPodrName(mSetPdr: TPtr): string;
{
  if (getMarkerCount(mSetPdr) = 0)
  {
    result := 'Все подразделения';
    if VInterf.ClearCatalogs1
      if (VInterf.SelectRecord(iCatFunc.GetCatalogsNRec(-11)))
        VInterf.PushAllCatalogsToMarker(mSetPdr,Integer(-11));
    exit;
  }
  else
    if (getMarkerCount(mSetPdr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько подразделений (' + string(getMarkerCount(mSetPdr)) + ')';
}

procedure MakeStatData;
{
  var kol, i, j : integer;
  var cPodrT    : comp;
  var db8, db9  : double;
  var isRaspred : boolean;
//  var sSchet    : string;
  
  iNextVisual('Идет сбор данных.');
//  i3GD.Init3GD;


  kol := GetMarkerCount(mPodr1);
  i   := 0;
  while i < kol
  {
    GetMarker(mPodr1, i++, cPodrT);
    set cPodrV := cPodrT;
/*
    isNIOKR:=false;
    if i3GD.bFindCurZGDPodr(cPodrT)
      if i3GD.sTypeCurZGDPodr = '2'
        isNIOKR:=true;
*/  
    if isvalid(#ExtCatLinks)
    _loop ExtCatLinks
      if isvalid(#Statis)
      _loop Statis
      {
        if Statis.Sovm < 3 and Statis.Kateg <> 0
        {
          if (not NextVisual) break;
          ClearBuffer(#ttStat);
          if getfirst ttStat where ((cPodrV == ttStat.cPodr)) <> tsOk
          {
            ttStat.sPodrN   := iCatFunc.GetCatalogsName(cPodrV);
            ttStat.sPodrC   := iCatFunc.GetCatalogsCode(cPodrV);
            ttStat.cPodr    := cPodrV;
            ttStat.cKatPodr := Statis.Cex;
            insert current ttStat;
          }
          SetStatFieldValue(Statis.Sovm+1, wWhatColRep(Statis.Kateg), Statis.SredKol);
          update current ttStat;
        }//if Statis.Sovm < 3 and Statis.Kateg <> 0
      }//_loop Statis
    //тут рассчитываем списочную
    if isvalid(#allsts)
    _loop allsts
    {
      if getfirst ttStat where ((cPodrV == ttStat.cPodr)) = tsOk
      {
        if isvalid(#allapp)
        _loop allapp
        {
          if (not NextVisual) break;
          if isvalid(#alllsc)
//          if isvalid(#KlFilter)
            if alllsc.Sovm < 3 and allapp.lPrizn=0 and allapp.Rate<>0
            {
              SetStatFieldValue(0, wWhatColRep(allktg.Kod), if(alllsc.Sovm < 1,1,0));
/*
              if isNIOKR //(FoundMarker(mPodr2, ttStat.cPodr))
              {
*/              
              if isvalid(#alllsc)
              {
                isRaspred := false;
                if isvalid(#PrVidOpl)
                {
                  isRaspred := true;
                  _loop PrVidOpl
                  {
                    if alllsc.Sovm < 1
                      SetNIOKRFieldValue(0,PrVidOpl.ChasF,0);
                    SetNIOKRFieldValue(alllsc.Sovm+1,PrVidOpl.ChasF,0);
                  }
                }
                if isvalid(#alllst)
                {
                  _loop alllst
                  {
                    if alllst.Kateg <> 0
                    {
                      db8:=db9:=0;

                      for(j:=1;j<=31;j++) db9 += alllst.DayChF[j];
                      
                      if not isRaspred
                        if alllst.cSchetD = '20'
                          for(j:=1;j<=31;j++) db8 += alllst.DayChF[j];
                      
                      if alllsc.Sovm < 1
                        SetNIOKRFieldValue(0,db8,db9);
                      SetNIOKRFieldValue(alllsc.Sovm+1,db8,db9);
                    }
                  }
                }
              }
/*
              }
              else
              {
                if alllsc.Sovm < 1
                  SetNIOKRFieldValue(0,if(KlFilter.cSchetD='20',1,0),if(KlFilter.cSchetD='20',0,1));
                SetNIOKRFieldValue(alllsc.Sovm+1,if(KlFilter.cSchetD='20',1,0),1);
              }
*/
            }//if alllsc.Sovm < 3 and allapp.lPrizn=0 and allapp.Rate<>0
        }//_loop allapp
        update current ttStat;
      }//if getfirst ttStat
    }//_loop allsts
  }//while i < kol
}

#define repT       2,    1,    2,    1
#define FrmH0    lRB,  lCE,  lRB,  lCE
#define FrmH1    lRB+1,lCE,  lRB+1,lCE
#define FrmH2    lRB+2,lCE,  lRB+2,lCE
#define FrmH3    lRB+3,lCE,  lRB+3,lCE
#define FrmCl    lDE,  lSE,  lDE,  lSE
#define AllTab   lRB,  lCB,  lDE,  lCE
#define AllHd    lRB,  lCB,lDB-1,  lCE
#define AllIt    lDB,  lCB,  lDB,  lCE

#declare PrintCells(NoRow)
//++++++++++++++++++++++++++++++++++++++++++++++++
    iOut.StringValC(ttStat.sPodrN+'('+ttStat.sPodrC+')',         #FrmCl); lSE++;
    dbNIKRate := dbNIKPsn := 0;
    for(j:=1;j<=7;j++)
    {
      dbNIKPsn += ttStat.dbVal#NoRow[j];
      iOut.DoubleVal(ttStat.dbVal#NoRow[j],     #FrmCl); lSE++;
    }
    dbNIKRate := if(ttStat.dbVal#NoRow[9]=0,0,ttStat.dbVal#NoRow[8]/ttStat.dbVal#NoRow[9]);
    iOut.DoubleVal(dbNIKRate*dbNIKPsn,     #FrmCl); lSE++;
    iOut.DoubleVal((1-dbNIKRate)*dbNIKPsn, #FrmCl); lSE++;
    lDE++;
//++++++++++++++++++++++++++++++++++++++++++++++++
#end



procedure PrintReport;
{
  iNextVisual('Выгружаю данные в Excel.');

  lRB  := 4;
  lHS  := 4;
  lDB  := lDE := lRB + lHS;
  lCB  := lCE := 1;
  iKolPodr := 0;

  iOut.StringValL('#(GPNam) за '+datetostr(to_date(1,wPeriodMonth,wPeriodYear),'month YYYY')+' года',#repT);
  xlSetFontSize(12,#repT); xlSetFontStyle(xlBold,#repT);

/*01*/iOut.Header2Row('п/п', #FrmH0);
/*01*/iOut.Header2Row('', #FrmH2); lCE++;
/*02*/iOut.Header2Row('', #FrmH0);
/*02*/iOut.Header2Row('Наименование структуры', #FrmH2); lCE++;
/*03*/iOut.Header1Row('1', #FrmH0);
/*03*/iOut.Header2Row('Наименование подразделения', #FrmH2); lCE++;
/*04*/iOut.Header1Row('2', #FrmH0);
/*04*/iOut.Header1Row('Основные рабочие основного производства', #FrmH2);
/*04*/iOut.Header1Row('1', #FrmH3); lCE++;
/*05*/iOut.Header1Row('3', #FrmH0);
/*05*/iOut.Header1Row('Вспомогатель-ные рабочие основного производства', #FrmH2);
/*05*/iOut.Header1Row('2', #FrmH3); lCE++;
/*06*/iOut.Header1Row('4', #FrmH0);
/*06*/iOut.Header1Row('Основные рабочие вспомогатель-ного производства', #FrmH2);
/*06*/iOut.Header1Row('3', #FrmH3); lCE++;
/*07*/iOut.Header1Row('5', #FrmH0);
/*07*/iOut.Header1Row('Вспомогатель-ные рабочие вспомогатель-ного производства', #FrmH2);
/*07*/iOut.Header1Row('4', #FrmH3); lCE++;
/*08*/iOut.Header1Row('6', #FrmH0);
/*08*/iOut.Header1Row('Руководители', #FrmH2);
/*08*/iOut.Header1Row('5', #FrmH3); lCE++;
/*09*/iOut.Header1Row('7', #FrmH0);
/*09*/iOut.Header1Row('Специалисты', #FrmH2);
/*09*/iOut.Header1Row('6', #FrmH3); lCE++;
/*10*/iOut.Header1Row('8', #FrmH0);
/*10*/iOut.Header1Row('Служащие', #FrmH2);
/*10*/iOut.Header1Row('7', #FrmH3); lCE++;
/*11*/iOut.Header1Row('11', #FrmH0);
/*11*/iOut.Header1Row('Персонал занятый тематичес-кими работами', #FrmH2);
/*11*/iOut.Header1Row('8', #FrmH3); lCE++;
/*12*/iOut.Header1Row('12', #FrmH0);
/*12*/iOut.Header1Row('Персонал занятый в накладных расходах', #FrmH2);
/*12*/iOut.Header1Row('9', #FrmH3);


  lSB := 1;
  var j : integer;
  if isvalid(#ttStat)
  _loop ttStat ordered index ttStat03
  {
    if (not NextVisual) break;
    lSE := 1;
    iKolPodr++;
    iOut.CodeVal('1',     #FrmCl); lSE++;
    iOut.StringValL('Списочная численность',     #FrmCl); lSE++;
    xlMergeCells(lDE,lSE,lDE+4,lSE);
    #PrintCells(0)
    lSE := 1;
    iOut.CodeVal('2',     #FrmCl); lSE++;
    iOut.StringValL('Средняя численность в т.ч.',     #FrmCl); lSE++;
    lDE++;
    lSE := 1;
    iOut.CodeVal('2.1',     #FrmCl); lSE++;
    iOut.StringValL('Среднесписочная численность',     #FrmCl); lSE++;
    #PrintCells(1)
    lSE := 1;
    iOut.CodeVal('2.2',     #FrmCl); lSE++;
    iOut.StringValL('Средняя численность внешних совместителей',     #FrmCl); lSE++;
    #PrintCells(2)
    lSE := 1;
    iOut.CodeVal('2.3',     #FrmCl); lSE++;
    iOut.StringValL('Средняя численность персонала работающего по договору ГПХ',     #FrmCl); lSE++;
    #PrintCells(3)
  }
  lDE--;
  iKolPodr--;
  xlSetColumnWidth(5,lRB,1,lDE,1);
  xlSetColumnWidth(40,lRB,2,lDE,2);
  xlSetColumnWidth(18,lRB,3,lDE,3);
  xlSetColumnWidth(13,lRB,4,lDE,12);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, #AllTab);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlThick,0,0, #AllTab);
  var k,bk,ek : integer;
  bk := 8; ek := 12;
  for(k:=1;k<=iKolPodr;k++)
  {
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlThick,0,0, bk, 1, bk+4, lCE);
    bk += 5;
  }
  xlWrapText(#AllTab);
}

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

procedure run;
{
  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);
  MakeStatData;
  if isvalid(#ttStat)
  {
    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xls';

    xlCreateExcel(sFullName, TRUE);
    xlAddSheet;
    xlSetActiveSheet(1);
    xlSetSheetName(1,'Отчет');
    PrintReport;
    xlFreeze(8,1);
    xlKillExcel;
  }
  else
  {
    message('Нет данных для отчета.');
  }
  StopVisual;
}

#declare CloseGpInterface
  DoneMarker(mKatWorker1,'#(GPInt)_mKat1_'  + UserName());
  DoneMarker(mKatWorker2,'#(GPInt)_mKat2_'  + UserName());
  DoneMarker(mKatWorker3,'#(GPInt)_mKat3_'  + UserName());
  DoneMarker(mKatWorker4,'#(GPInt)_mKat4_'  + UserName());
  DoneMarker(mKatWorker5,'#(GPInt)_mKat5_'  + UserName());
  DoneMarker(mKatWorker6,'#(GPInt)_mKat6_'  + UserName());
  DoneMarker(mKatWorker7,'#(GPInt)_mKat7_'  + UserName());
  DoneMarker(mPodr1,     '#(GPInt)_mPodr1_' + UserName());
//  DoneMarker(mPodr2,     '#(GPInt)_mPodr2_' + UserName());
  SaveMyDsk(wPeriodMonth, '#(GPInt)_wPeriodMonth');
  SaveMyDsk(wPeriodYear , '#(GPInt)_wPeriodYear' );
  closeinterface(cmDefault);
#end

handleevent
  cmInit:
  {
    if (not (ReadMyDsk(wPeriodMonth, '#(GPInt)_wPeriodMonth', false)))
      set wPeriodMonth := Month(Cur_Date);
    if (not (ReadMyDsk(wPeriodYear, '#(GPInt)_wPeriodYear', false)))
      set wPeriodYear := Year(Cur_Date);
    dBeg := date(1,wPeriodMonth,wPeriodYear);
    dEnd := Sub_Day(Add_Months(dBeg,1),1);
    mKatWorker1 := initMarker('#(GPInt)_mKat1_'  + UserName(), 8, 1000, 100);
    mKatWorker2 := initMarker('#(GPInt)_mKat2_'  + UserName(), 8, 1000, 100);
    mKatWorker3 := initMarker('#(GPInt)_mKat3_'  + UserName(), 8, 1000, 100);
    mKatWorker4 := initMarker('#(GPInt)_mKat4_'  + UserName(), 8, 1000, 100);
    mKatWorker5 := initMarker('#(GPInt)_mKat5_'  + UserName(), 8, 1000, 100);
    mKatWorker6 := initMarker('#(GPInt)_mKat6_'  + UserName(), 8, 1000, 100);
    mKatWorker7 := initMarker('#(GPInt)_mKat7_'  + UserName(), 8, 1000, 100);
    mPodr1      := initMarker('#(GPInt)_mPodr1_' + UserName(), 8, 1000, 100);
//    mPodr2      := initMarker('#(GPInt)_mPodr2_' + UserName(), 8, 1000, 100);
    set sKatWorker1 := sSetKatName (mKatWorker1,1);
    set sKatWorker2 := sSetKatName (mKatWorker2,2);
    set sKatWorker3 := sSetKatName (mKatWorker3,3);
    set sKatWorker4 := sSetKatName (mKatWorker4,4);
    set sKatWorker5 := sSetKatName (mKatWorker5,5);
    set sKatWorker6 := sSetKatName (mKatWorker6,6);
    set sKatWorker7 := sSetKatName (mKatWorker7,7);
    set sPodr1      := sSetPodrName(mPodr1);
//    set sPodr2      := sSetPodrName(mPodr2);
  }
  cmPick:
  {
    case CurField of
      #sKatWorker1:
        if (RunInterface('PICKKAT1', 0, mKatWorker1, vfMultipleSelection) = cmDefault)
          set sKatWorker1 := sSetKatName(mKatWorker1,1);
      #sKatWorker2:
        if (RunInterface('PICKKAT1', 0, mKatWorker2, vfMultipleSelection) = cmDefault)
          set sKatWorker2 := sSetKatName(mKatWorker2,2);
      #sKatWorker3:
        if (RunInterface('PICKKAT1', 0, mKatWorker3, vfMultipleSelection) = cmDefault)
          set sKatWorker3 := sSetKatName(mKatWorker3,3);
      #sKatWorker4:
        if (RunInterface('PICKKAT1', 0, mKatWorker4, vfMultipleSelection) = cmDefault)
          set sKatWorker4 := sSetKatName(mKatWorker4,4);
      #sKatWorker5:
        if (RunInterface('PICKKAT1', 0, mKatWorker5, vfMultipleSelection) = cmDefault)
          set sKatWorker5 := sSetKatName(mKatWorker5,5);
      #sKatWorker6:
        if (RunInterface('PICKKAT1', 0, mKatWorker6, vfMultipleSelection) = cmDefault)
          set sKatWorker6 := sSetKatName(mKatWorker6,6);
      #sKatWorker7:
        if (RunInterface('PICKKAT1', 0, mKatWorker7, vfMultipleSelection) = cmDefault)
          set sKatWorker7 := sSetKatName(mKatWorker7,7);
      #sPodr1:
        if (RunInterface('PICKCATALOGEX', -11, 0, Comp(100), mPodr1) = cmDefault)
          set sPodr1 := sSetPodrName(mPodr1);
//      #sPodr2:
//        if (RunInterface('PICKCATALOGEX', -11, 0, Comp(100), mPodr2) = cmDefault)
//          set sPodr2 := sSetPodrName(mPodr2);
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sKatWorker1: {ClearMarker(mKatWorker1); set sKatWorker1 := sSetKatName (mKatWorker1,0);}
      #sKatWorker2: {ClearMarker(mKatWorker2); set sKatWorker2 := sSetKatName (mKatWorker2,0);}
      #sKatWorker3: {ClearMarker(mKatWorker3); set sKatWorker3 := sSetKatName (mKatWorker3,0);}
      #sKatWorker4: {ClearMarker(mKatWorker4); set sKatWorker4 := sSetKatName (mKatWorker4,0);}
      #sKatWorker5: {ClearMarker(mKatWorker5); set sKatWorker5 := sSetKatName (mKatWorker5,0);}
      #sKatWorker6: {ClearMarker(mKatWorker6); set sKatWorker6 := sSetKatName (mKatWorker6,0);}
      #sKatWorker7: {ClearMarker(mKatWorker7); set sKatWorker7 := sSetKatName (mKatWorker7,0);}
      #sPodr1:      {ClearMarker(mPodr1);      set sPodr1      := sSetPodrName(mPodr1);}
//      #sPodr2:      {ClearMarker(mPodr2);      set sPodr2      := sSetPodrName(mPodr2);}
    end;
  }
  cmOk:
  {
    if (wPeriodYear = 0)
    {
      message('Задан некорректный период!');
    }
    else
    {
      if  GetMarkerCount(mKatWorker1) = 0
      and GetMarkerCount(mKatWorker2) = 0
      and GetMarkerCount(mKatWorker3) = 0
      and GetMarkerCount(mKatWorker4) = 0 
      and GetMarkerCount(mKatWorker5) = 0 
      and GetMarkerCount(mKatWorker6) = 0 
      and GetMarkerCount(mKatWorker7) = 0 
      {message('Установите хотя бы одну из категорий!');}
      else
      {
        Run;
        #CloseGpInterface
      }
/*
      {
        if GetMarkerCount(sPodr1     ) = 0 
//        or GetMarkerCount(sPodr2     ) = 0 
        {message('Не заданы подразделения!');}
        else
        {
          Run;
          #CloseGpInterface
        }
      }
*/
    }
  }
  cmCancel:
  {
    #CloseGpInterface
  }
end;
end.

VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;

Procedure Run;
Begin
  runinterface(#(GPInt));
End;

Function GetReportName: String;
Begin
  GetReportName := '#(GPNam) (ЭМ)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Ведение картотеки сотрудников';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;

End.
