HandleEvent
  cmOK:
  {
    if not isCheckRepParam(true)
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
  cmValue1:
  {
    ClearMarker(mKatType1);
    InitGK;
    set sKatType1 := sSetConstruct(mKatType1);
  }
end;
end;//Win1KParam
//++++++++++++++++++++++++++++++++++++++++++++++++

function OpenNewRKS : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExistRKS : boolean;
{
  result := false;
  xlOpenExcel(true);
  if xlOpenWorkBook(sToExistFile)
    result := true;
}

function SetParam3k : boolean;
{
  result := false;
  if RunWindowModal(Win3KParam)=cmDefault
    result := true;
}

procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  init3K;

  if isStayAlone
    if SetParam3k
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);

//  if not isStayAlone
//    initDis13; //инициализация внешнего атрибута для причин увольнений

  if isDoRep
  {
    Make3K;
    PostProcess3K;
    if isData3K
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNewRKS  /*OpenNew1K  */;}
        if wToExistFile = 1 {isOkFile := OpenExistRKS/*OpenExist1K*/;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        Print3K;

        if (wPrintRash = 1) and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='3-к' break;
          }
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 3-К'); 
          xlSetActiveSheet(i);
          PrintRash3k;
//          iRKPRash.RKRash1(mPersRash1k,'3-К',dRep);
        }

        xlSetActiveSheetByName('3-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }
    else if isStayAlone message('Нет данных для отчета.');
  }
  Save3K;
  Clear3K;
  closeinterface(cmDefault);
}
