(
  wType   : word
, cPrik   : comp
, dSens   : date
, cPSN    : comp
, sFIO    : string
, cDept   : comp
, cPost   : comp
, cKat    : comp
, cReason : comp
, is29    : boolean
, wDaysPS : word
, sDop3   : string
)
with index
(
  mtRash3k00 = wType
, mtRash3k03 = sFIO
)
;

var
  dRep          : date;
  iCatFunc      : CatalogsFunctions;
  iRunStaj      : Runstaj;
  iChRPD        : GP_ChRPD;
  iStaffStr     : StaffStruct;
  iUDR          : GP_UDR_RKStat;
//  iRKPRash      : GP_RKPrintRash;
//  ExtAttr       : iExtAttr;
  sFullName     : string;
  sKatWorker1
 ,sKatWorker2
 ,sKatWorker3
 ,sKatWorker4   : string;
  sPodr1        : string;
  mKatWorker1
 ,mKatWorker2
 ,mKatWorker3
 ,mKatWorker4   : TPtr;
  mPodr1        : TPtr;
  mKatType1     : TPtr;   // Фильтр для отбора конструкторов
  sKatType1     : string; //
  mPersRash1k   : TPtr;
//   cAttr13       : comp;
  wPrintRash    : word;
  wToExistFile: word;
  sToExistFile: string;
  wMonthToCalc: word;
  dbSumToCalc:  double;
  dbVyruchCur
, dbVyruchPrev
, dbVyruchOwnCur
, dbVyruchOwnPrev: double;
  dbSZPSpets
, dbSZPSluzh : double;
  wMonthsRep: word = 1;
  isStayAloneAll: boolean = false;
  wFromExistFile  : word;
  sFromExistFile  : string;

create view
var
  dRepV    : date;
  dRepVB   : date;
  dBeg,
  dEnd     : date;
  wLKIt    : word;
  wYearS,
  wMonthS  : word;
  cKindApp : comp;
  __cPsn:    comp; 
  __YearV:   integer;
  __MesV:    word;
from
  ttStat3K
, StaffStruct
//, HistoryStr
, Appointments
, LSchet     
, Persons
, KlKatego
, Statis
, KlKatego KlKatStat
, ExtCatLinks
, Catalogs
, Appointments Interns
, LSchet LSInt
, LSTab LSTInt
, contdoc contdoc1
, GP_SPCONTDOC201
, contdoc contdoc201
, Appointments AppApp
, StaffStruct AppStruct
, contdoc AppDoc
, LSchet LSApp    
, Persons PersApp
, AppHist
, Appointments DisApp
, StaffStruct DisStruct
, contdoc DisDoc
, contdoc DisDocCheck
, LSchet LSDis    
, Persons PersDis
, SumVidOp
, ExtCatLinks ECL2Opl
, LSchet LSVidOp    
, KlKatego KlKatLS
, KlVidOpl
, mtVidOplFZP
, mtVidOplFZP mtVidOplFZP_I
, Appointments StajApp
, Catalogs CatDepCheck
, Catalogs CatPostCheck
, Catalogs CatGK
//-rash
, mtRash3k
, Persons PsnRs
, PartDoc  PDcRS
, TitleDoc TiDcRs
, Catalogs DeptRs
, Catalogs PostRs
, Catalogs ReasRs
, KlKatego KlKtRs
where
((
//---Списочная на дату и сопутствующие блоки данных
    StaffStruct.nRec == Appointments.StaffStr
and ( ( dRepV <= Appointments.DismissDate or Appointments.DismissDate = 0 ) and dRepV >= Appointments.AppointDate )
and Appointments.cAddnRec2 == LSchet.nRec
and Appointments.Person == Persons.nRec
and StaffStruct.Department == CatDepCheck.nRec
and StaffStruct.Post == CatPostCheck.nRec
and StaffStruct.nRec == HistoryStr.StaffStr
and            dRepV>>= HistoryStr.dHist
and Appointments.nrec == DisDocCheck.cStr and (DisDocCheck.TypeOper = integer(8))
//---ССЧ
and integer(11)==ExtCatLinks.ObjType
and ExtCatLinks.ExtCat== Statis.Cex
and wYearS            == Statis.YearN
and wMonthS           == Statis.MesN
and Statis.Kateg      == KlKatStat.Kod
//and word(0)           ==Statis.Sovm
//---Стажеры
//and dBeg <<= Interns.AppointDate and (Interns.AppointDate <= dEnd and Interns.KindApp = cKindApp)
and dEnd >>= Interns.AppointDate and (Interns.DateEnd >= dBeg and Interns.KindApp = cKindApp)
and Interns.nrec == contdoc1.CSTR
and Interns.cAddnRec2 == LSInt.nRec
/*
and LSInt.nRec == LSTInt.cLSchet
and ( (year(Interns.AppointDate) <= LSTInt.YearN) and (year(Interns.DateEnd) >= LSTInt.YearN ) )
*/
//---Практиканты
//and dBeg <<= GP_SPCONTDOC201.DATEFROM and (GP_SPCONTDOC201.DATEFROM/*GP_SPCONTDOC201.DATETO*/ < dEnd)
and dEnd >>= GP_SPCONTDOC201.DATEFROM and (GP_SPCONTDOC201.DATETO > dBeg)
and GP_SPCONTDOC201.CCONTDOC == contdoc201.nrec
//---Приемы на работу
and dBeg<<= AppApp.AppointDate and (dEnd >= AppApp.AppointDate)
and AppApp.StaffStr == AppStruct.nRec
//and AppApp.Person == AppDoc.Person
and AppApp.nRec == AppDoc.cStr and (AppDoc.TypeOper = integer(1))
and AppApp.cAddnRec2 == LSApp.nRec
and AppApp.Person == PersApp.nRec
and AppApp.NRec == AppHist.cAppoint and ( AppHist.CodOper = 1 )
//---Увольнения----
and dBeg<<= DisApp.DismissDate (noindex) and (dEnd >= DisApp.DismissDate)
and DisApp.person    == PersDis.nrec
and DisApp.nrec      == DisDoc.cStr and (DisDoc.TypeOper = integer(8))
and DisApp.caddnrec2 == LSDis.nrec
and DisApp.StaffStr  == DisStruct.nRec
//---Альтернативный стаж----
and __cPsn == StajApp.Person
//---ФЗП--------------------
and __YearV         == SumVidOp.YearN
and __MesV          == SumVidOp.MesN
and SumVidOp.VidOpl == mtVidOplFZP.lVidOpl
and integer(11)     == ECL2Opl.ObjType
and integer(1)      == ECL2Opl.ModType
and SumVidOp.Cex    == ECL2Opl.ExtCat
and SumVidOp.cLSch  == LSVidOp.nRec
and LSVidOp.Kateg   == KlKatLS.Kod
//---rash---
and mtRash3k.cPSN    == PsnRs.nRec
and mtRash3k.cPrik   == PDcRS.nRec
and PDcRS.cDoc       == TiDcRs.nRec
and mtRash3k.cDept   == DeptRs.nRec
and mtRash3k.cPost   == PostRs.nRec
and mtRash3k.cKat    == KlKtRs.nRec
and mtRash3k.cReason == ReasRs.nRec
))
;

#ifdef RKSTATDEBUG
  File LogFile;
#endif

function InitVidOpl: boolean;
{
  result := false;
  var cEA_KlVidOpl_905: comp = ExtAttr_ID(coKlVidopl, '905 Фонд заработной платы (ОВР)');//Фонд ЗП
  if ( cEA_KlVidOpl_905 = comp(0) )
    exit;
  _loop KlVidopl
    if ( coGetAttrID(coKlVidopl, KlVidopl.Nrec, cEA_KlVidOpl_905) <> comp(0) )
      insert mtVidOplFZP_I set mtVidOplFZP_I.lVidOpl := KlVidopl.VidOpl;
  if isValid(#mtVidOplFZP_I)
    result := true;
}

procedure InitGK;
{
  var cML: comp = 0;
  if ( GetMarkerCount(mKatType1) <> 0 )
    exit;

  if ( getfirst CatGK where((-22 == CatGK.SysCode)) = tsOk )
    cML := CatGK.MainLink;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Заполняю классификатор Главных конструкторов', 0);
  _loop CatGK where((0 == CatGK.LPr and cML == CatGK.MainLink))
  {
    if (not NextVisual) break;
    if ( CatGK.cParent = comp(000A0000000399D1h) ) continue;
    if ( ( pos('главный конструктор', locase(CatGK.Name)) <> 0 )
    or   ( pos('заместитель главного конструктора', locase(CatGK.Name)) <> 0 ) )
      InsertMarker(mKatType1, CatGK.nRec);
  }
  StopVisual;
}
