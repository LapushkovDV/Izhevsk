window Win3KParam 'Параметры формирования. Лист 3-К.' Gray;
  show at (,,95,29);
Screen s1(,,sci1Esc);
  fields
    dRep   ('Дата формирования'): {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    sPodr1 ('Выбранные подразделения',hcStaffAppDepartment,sci13Esc): {Font = {BackColor = if(sPodr1 = 'Не выбраны подразделения', ColorNeed, 0)}},Protect, PickButton ;
    sKatWorker1 ('Руководители',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker1 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatWorker2 ('Специалисты' ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker2 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatWorker3 ('Служащие'    ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker3 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatWorker4 ('Рабочие'     ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker4 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType1   ('Конструкторы',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker4 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    dbVyruchCur     ('Выручки отчетный период',,   ): [21.2] {Font = {BackColor = if(dbVyruchCur = 0, ColorNeed, 0)}}, noprotect;
    dbVyruchPrev    ('Выручки предыдущий период',, ): [21.2] {Font = {BackColor = if(dbVyruchCur = 0, ColorNeed, 0)}}, noprotect;
    dbVyruchOwnCur  ('Выручки от собственных работ отчетный период',,   ): [21.2] {Font = {BackColor = if(dbVyruchCur = 0, ColorNeed, 0)}}, noprotect;
    dbVyruchOwnPrev ('Выручки от собственных работ предыдущий период',, ): [21.2] {Font = {BackColor = if(dbVyruchCur = 0, ColorNeed, 0)}}, noprotect;
    dbSZPSpets ('Среднемесячная ЗП Специалисты',,   ): [21.2] {Font = {BackColor = if(dbVyruchCur = 0, ColorNeed, 0)}}, noprotect;
    dbSZPSluzh ('Среднемесячная ЗП Служащие',, ): [21.2] {Font = {BackColor = if(dbVyruchCur = 0, ColorNeed, 0)}}, noprotect;
    wPrintRash  ('Печать расшифровки'), noprotect;
    wToExistFile('Добавить в существующий файл'), noprotect;
    sToExistFile('Добавить в существующий файл',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sToExistFile = '', ColorNeed, 0)}},protect;
    wFromExistFile('Считать данные за прошлый период из файла'), noprotect;
    sFromExistFile('Считать данные за прошлый период из файла',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sFromExistFile = '', ColorNeed, 0)}},protect;
  buttons
    cmOk,,,'Запуск',,;
    cmValue1,,,'Конструкторы по умолчанию',,;
    cmCancel,,,'Выход',,;
