wAgeUpTo = 29;
wStajUpTo = 3;
// sAttr13 = 'Учитывается при расчете 3-К';
sDisReason1 = 'п.1 ст.77 ТК';
sDisReason2 = 'п.3 ст.77 ТК';
sDisReasonNew1 = 'п.1 ст.77 ТК';
//sDisReasonNew2 = 'п.1 ст.81 ТК';
sDisReasonNew2 = 'п.1 ст.81 ТК';
