function sSetKatName(mSetKat: TPtr): string;
{
  if (getMarkerCount(mSetKat) = 0)
  {
    result := 'Не выбраны категории';
    exit;
  }
  else
    if (getMarkerCount(mSetKat) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetKat, 0, cTmp);
      if GetFirst KlKatego where (( cTmp == KlKatego.NRec )) = tsOk
        result := KlKatego.NaiKat;
      else
        result := '';
    }
    else
      result := 'Несколько категорий (' + string(getMarkerCount(mSetKat)) + ')';
}

function sSetPodrName(mSetPdr: TPtr): string;
{
  if (getMarkerCount(mSetPdr) = 0)
  {
    result := 'Все подразделения';
    exit;
  }
  else
    if (getMarkerCount(mSetPdr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько подразделений (' + string(getMarkerCount(mSetPdr)) + ')';
}
function sSetConstruct(mSetConstr: TPtr): string;
{
  if (getMarkerCount(mSetConstr) = 0)
  {
    result := 'Не выбраны должности';
    exit;
  }
  else
    if (getMarkerCount(mSetConstr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetConstr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько должностей (' + string(getMarkerCount(mSetConstr)) + ')';
}

function isAgeUpTo(dBorn, dOnDate : date) : boolean;
{
  if ( (Year(Sub_Date(dOnDate, dBorn))-1) <= wAgeUpTo )
    result := true
  else
    result := false;
}
function isStajUpTo(_cPsn : comp; _dOnDate : date) : boolean;
{
  var dBegSt, dEndSt: date = 0; // дата начала и конца работы по назначению
  var lDays:          longint = 0;       // количество дней стажа
  var wStaj:          word = iRunStaj.GetStajYears(_cPsn, 89, _dOnDate);

  if ( wStaj = 0 )
  {
    set __cPsn := _cPsn;
    _loop StajApp
    {
      //просматриваем все основные назначения по человеку 
      if ( StajApp.AppointDate > _dOnDate or ( StajApp.LPrizn <> 0 and StajApp.LPrizn <> 100 ) )
        continue;
      
      dBegSt := StajApp.AppointDate;
      if ( StajApp.DismissDate <= _dOnDate and StajApp.DismissDate <> 0 )
        dEndSt := StajApp.DismissDate
      else
        dEndSt := _dOnDate;
      //вычисляем дни назначения по методике РФ
      lDays += longint(((Year (dEndSt) - Year (dBegSt)) * 360 +
                        (Month(dEndSt) - Month(dBegSt)) *  30 +
                        (Day  (dEndSt) - Day  (dBegSt)))) + 1;
    }
    wStaj := DivI(lDays, 360);
  }
  if ( wStaj <= wStajUpTo )
    result := true
  else
    result := false;
}

function isConstruct(cConstr : comp) : boolean; cacheable;//AppStruct.cInf3
{
  if FoundMarker(mKatType1, cConstr)
    result := true
  else
    result := false;
}

function isDisReasonIn(cDisReason : comp) : boolean;  cacheable;//disapp.cdisreason
{
  result := true;
/*
  result := false;
*/
  var sDisReasonDoc : string = trim(iCatFunc.GetCatalogsCode(cDisReason));
  case sDisReasonDoc of
  sDisReasonNew1, 
  sDisReasonNew2, 
  sDisReasonNew3:
    result := false;
  end;
/*
  if ( (sDisReasonDoc = sDisReason1) or (sDisReasonDoc = sDisReason2) )
    result := true;
*/
}

function wWhatKat(cKateg : comp) : word; cacheable;
{
  result := 0;
  if ( cKateg <> comp(0) )
  {
    if FoundMarker(mKatWorker1, cKateg)
    {result := 1}
    else
      if FoundMarker(mKatWorker2, cKateg)
      {result := 2}
      else
        if FoundMarker(mKatWorker3, cKateg)
        {result := 3}
        else
          if FoundMarker(mKatWorker4, cKateg)
          {result := 4}
  }
}

function OpenFromRKS : boolean;
{
  result := false;
  xlOpenExcel(true);
  xlDisplayAlerts(false);
  if xlOpenWorkBook(sFromExistFile)
    result := true;
}
function CloseFromRKS : boolean;
{
  result := false;
  if xlCloseWorkBookByName(sFromExistFile)
//  if xlKillExcel
    result := true;
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
  xlDisplayAlerts(true);
  if isStayAloneAll
    xlKillExcel;
}

procedure SetRowData(lRowT : longint; dbCur, dbPrev : double);
{
  clearbuffer(#ttStat3K);
  if ( getfirst ttStat3K where ((lRowT==ttStat3K.lRow)) <> tsOk )
  {
    ttStat3K.lRow := lRowT;
    insert current ttStat3K;
  }
  ttStat3K.dbVal[1] += dbCur;
  ttStat3K.dbVal[2] += dbPrev;
  update current ttStat3K;
}

procedure SetRowDataZP(_lRowT : longint; _dbCur, _dbPrev : double; _dbKolCur, _dbKolPrev : double);
{
  clearbuffer(#ttStat3K);
  if ( getfirst ttStat3K where ((_lRowT==ttStat3K.lRow)) <> tsOk )
  {
    ttStat3K.lRow := _lRowT;
    insert current ttStat3K;
  }
  ttStat3K.dbVal[1] += _dbCur;
  ttStat3K.dbVal[2] += _dbPrev;
  ttStat3K.dbKol[1] += _dbKolCur;
  ttStat3K.dbKol[2] += _dbKolPrev;
  update current ttStat3K;
}

procedure UpdRowData(lRowT : longint; dbCur, dbPrev : double);
{
  clearbuffer(#ttStat3K);
  if ( getfirst ttStat3K where ((lRowT==ttStat3K.lRow)) <> tsOk )
  {
    ttStat3K.lRow := lRowT;
    insert current ttStat3K;
  }
  ttStat3K.dbVal[1] := dbCur;
  ttStat3K.dbVal[2] := dbPrev;
  update current ttStat3K;
}

procedure UpdRowDataZP(_lRowT : longint; _dbCur, _dbPrev : double; _dbKolCur, _dbKolPrev : double);
{
  clearbuffer(#ttStat3K);
  if ( getfirst ttStat3K where ((_lRowT==ttStat3K.lRow)) <> tsOk )
  {
    ttStat3K.lRow := _lRowT;
    insert current ttStat3K;
  }
  ttStat3K.dbVal[1] := _dbCur;
  ttStat3K.dbVal[2] := _dbPrev;
  ttStat3K.dbKol[1] := _dbKolCur;
  ttStat3K.dbKol[2] := _dbKolPrev;
  update current ttStat3K;
}

function isLocateRowZP_Return(_lRowT : longint; var _dbCur, _dbPrev : double; var _dbKolCur, _dbKolPrev : double) : boolean;
{
  if ( getfirst ttStat3K where ((_lRowT==ttStat3K.lRow)) = tsOk )
  {
    _dbCur :=ttStat3K.dbVal[1];
    _dbPrev:=ttStat3K.dbVal[2];
    _dbKolCur :=ttStat3K.dbKol[1];
    _dbKolPrev:=ttStat3K.dbKol[2];
    result:=true;
  }
  else
  {
    _dbCur := _dbPrev := _dbKolCur := _dbKolPrev := 0;
    result:=false;
  }
}

procedure InitPrevResults;
{
  var dbFrom: double = 0.00;
  if OpenFromRKS
  {
    if xlSetActiveSheetByName('3-к')
    { //xlGetCellValue
      if xlGetCellValue( (4+ 2), 4, dbFrom)
        SetRowData( 2, 0, dbFrom);
      if xlGetCellValue( (4+ 4), 4, dbFrom)
        SetRowData( 4, 0, dbFrom);
      if xlGetCellValue( (4+18), 4, dbFrom)
        SetRowData(18, 0, dbFrom);
      if xlGetCellValue( (4+20), 4, dbFrom)
        SetRowData(20, 0, dbFrom);
      if xlGetCellValue( (4+23), 4, dbFrom)
        SetRowData(23, 0, dbFrom);
      if xlGetCellValue( (4+26), 4, dbFrom)
        SetRowData(26, 0, dbFrom);
      if xlGetCellValue( (4+28), 4, dbFrom)
        SetRowData(28, 0, dbFrom);
      if xlGetCellValue( (4+64), 4, dbFrom)
        SetRowData(64, 0, dbFrom);
      if xlGetCellValue( (4+66), 4, dbFrom)
        SetRowData(66, 0, dbFrom);
      if xlGetCellValue( (4+68), 4, dbFrom)
        SetRowData(68, 0, dbFrom);
      if xlGetCellValue( (4+70), 4, dbFrom)
        SetRowData(70, 0, dbFrom);
      if xlGetCellValue( (4+72), 4, dbFrom)
        SetRowData(72, 0, dbFrom);
    }
    if xlSetActiveSheetByName('1-к')
    {
      if xlGetCellValue( 45, 24, dbFrom)
        SetRowData( 5, dbFrom, 0);
      if xlGetCellValue( 46, 24, dbFrom)
        SetRowData( 6, dbFrom, 0);
      if xlGetCellValue( 47, 24, dbFrom)
        SetRowData( 7, dbFrom, 0);
      if xlGetCellValue( 48, 24, dbFrom)
        SetRowData( 8, dbFrom, 0);
      if xlGetCellValue( 44,  6, dbFrom)
        SetRowData( 9, dbFrom, 0);
    }
    if xlSetActiveSheetByName('2-к')
    {
      if xlGetCellValue( 44,  6, dbFrom)
        SetRowData(10, dbFrom, 0);
      if xlGetCellValue( 44,  9, dbFrom)
        SetRowData(10, dbFrom, 0);
    }
    if CloseFromRKS {}
  }
}

procedure Make3K;
{
  var isFilterPodr : boolean = false;
  var wKatEmpl : word = 0;
  var cAppDept : comp = comp(0);
  var isFreeDate: boolean = if (( day(dRep) = 31 ) and ( month(dRep) = 12 ), false, true);
  wMonthsRep := months_between(date( 1, 1, Year(dRep)), dRep) + 1;
#ifdef RKSTATDEBUG
LogFile.OpenFile(GetStringParameter('Files','TmpFilesDirectory', 0)+'RKSTAT_3k.log',stCreate);
//LogFile.WriteLN('Version = '+sVerResource);
#endif

  delete all from ttStat3K;

  if ( wMonthsRep = 0 ) //теоретически не должно но на всякий случай проверим
    exit;               //т.к. будем на эту переменную делить для среднего

  if ( not InitVidOpl )
    message('Нет привязки видов оплат к Фонду заработной платы!'+Chr(13)
           +'Данные по средней зарплате не будут сформированы.', Error);

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Формируются данные для Листа 3-к.', 0);
  
  if ( wFromExistFile = 1 )
    InitPrevResults;
  
  if ( GetMarkerCount(mPodr1) > 0 )
    isFilterPodr:=true;
//Предыдущий период списочная-----------------------------------
  if isFreeDate
  {
    dRepV := To_Date(1, month(dRep), Year(dRep)-1); 
    dRepV := To_Date(last_day(dRepV), month(dRepV), Year(dRepV)); //на случай високосного года
  }
  else
    dRepV := To_Date(31, 12, Year(dRep)-1); 

  dRepVB:= To_Date( 1, 1,Year(dRep)-1); 
  
  iNextVisual('Формируется списочная численность на '+DatetoStr(dRepV,'DD.MM.YYYY')+' для Листа 3-к.');
  if ( wFromExistFile = 0 )
  if isvalid(#StaffStruct)
  _loop StaffStruct
  {
/*
    if ( StaffStruct.dInput >= dRepV or ( StaffStruct.dClose <= dRepVB and StaffStruct.dClose <> 0 ) )
      continue;
*/
    if not isvalid(#CatDepCheck)
      continue;
    if not isvalid(#CatPostCheck)
      continue;
    if isFilterPodr
      if (not FoundMarker(mPodr1,StaffStruct.Department))
        continue;

    if ( StaffStruct.dInput >= dRepV )
      continue;
    if ( StaffStruct.dClose <> 0 )
      if ( StaffStruct.dClose <= dRepVB )
        continue;
    
    if isvalid(#Appointments)
    _loop Appointments
    {
      if (not NextVisual) break;
      if ( Appointments.DismissDate = dRepV )
        if isvalid(#DisDocCheck)
          if iChRPD.isConfirmed(DisDocCheck.nRec)
            continue;
      if isvalid(#LSchet)
      if isvalid(#Persons)
      if LSchet.Sovm <> 1 and LSchet.Sovm <> 2 and ( Appointments.lPrizn=0 or Appointments.lPrizn=100) and Appointments.Rate<>0
      {
        SetRowData(2, 0, 1);
        wKatEmpl := wWhatKat(StaffStruct.EmpCategory);
        if wKatEmpl <> 0
          SetRowData(4+wKatEmpl, 1, 0);
        if isAgeUpTo(Persons.BornDate,dRepV)
          SetRowData( 9, 1, 0);
        if isStajUpTo(Persons.nRec,dRepV)
          SetRowData(10, 1, 0);
        if Persons.Sex = 'Ж'
          SetRowData(28, 0, 1)
        else
          SetRowData(26, 0, 1);
      }
    }
  }
//Текущий период списочная-----------------------------------
  dRepV := dRep; 
  dRepVB:= To_Date( 1, 1,Year(dRep)); 
  iNextVisual('Формируется списочная численность на '+DatetoStr(dRepV,'DD.MM.YYYY')+' для Листа 3-к.');
  if isvalid(#StaffStruct)
  _loop StaffStruct
  {
    if isFilterPodr
      if (not FoundMarker(mPodr1,StaffStruct.Department))
        continue;
    
    if not isvalid(#CatDepCheck)
      continue;
//    if not isvalid(#CatPostCheck)
//      continue;

    if ( StaffStruct.dInput >= dRepV )
      continue;
    if ( StaffStruct.dClose <> 0 )
      if ( StaffStruct.dClose <= dRepVB )
        continue;

    if isvalid(#Appointments)
    _loop Appointments
    {
      if (not NextVisual) break;
      if ( Appointments.DismissDate = dRepV )
        if isvalid(#DisDocCheck)
          if iChRPD.isConfirmed(DisDocCheck.nRec)
            continue;
      if isvalid(#LSchet)
      if isvalid(#Persons)
      if LSchet.Sovm <> 1 and LSchet.Sovm <> 2 and ( Appointments.lPrizn=0 or Appointments.lPrizn=100) and Appointments.Rate<>0
      {
        SetRowData(2, 1, 0);
//        SetRowData(78, 0, 1);
        if Persons.Sex = 'Ж'
          SetRowData(28, 1, 0)
        else
          SetRowData(26, 1, 0);
        if isConstruct(StaffStruct.Post/*StaffStruct.cInf3*/)
        {
          SetRowData(79, 1, 0);
          SetRowData(79, 0, Year(Sub_Date(dRepV, Persons.BornDate))-1);
        }
      }
    }
/*
    if ( StaffStruct.Workers > 0 )
      SetRowData(78, iStaffStr.GetWorkersStaff(StaffStruct.nRec, dRepV), 0);
*/
//    SetRowData(78, round(iStaffStr.GetWorkersStaff(StaffStruct.nRec, dRepV),0), 0);

/*
    if isvalid(#HistoryStr)
    _loop HistoryStr
      if ( (HistoryStr.wCodOper=20) or (HistoryStr.wCodOper=22) )
        SetRowData(78, round(HistoryStr.HWORKERS,0), 0);
*/
//        SetRowData(78, round(HistoryStr.HWORKSTATIONS,0), 0);
  }
//Вакансии-----------------------------------
  iNextVisual('Формируются вакансии '+DatetoStr(dRep,'DD.MM.YYYY')+' для Листа 3-к.');
  if isvalid(#StaffStruct)
  _loop StaffStruct
  {
    if (not NextVisual) break;
    if isFilterPodr
      if (not FoundMarker(mPodr1,StaffStruct.Department))
        continue;
    
//    if not isvalid(#CatDepCheck)
//      continue;
    
    if ( StaffStruct.dInput <= dRep and (StaffStruct.dClose = 0 or dRep <= StaffStruct.dClose) )
      SetRowData(78, iStaffStr.GetWorkersStaff(StaffStruct.nRec, dRep), 0);
  }
//Предыдущий период среднесписочная-----------------------------------
  if isFreeDate
  {
    dRepV := To_Date(1, month(dRep), Year(dRep)-1); 
    dRepV := To_Date(last_day(dRepV), month(dRepV), Year(dRepV)); //на случай високосного года
  }
  else
    dRepV := To_Date(31, 12, Year(dRep)-1); 

  iNextVisual('Формируется среднесписочная численность за '+Year(dRepV)+'г. для Листа 3-к.');
  wYearS := Year(dRepV);
  if ( wFromExistFile = 0 )
  if isvalid(#ExtCatLinks) 
  _loop ExtCatLinks
  {
    if isFilterPodr
    if (not FoundMarker(mPodr1,ExtCatLinks.StaffCat)) continue;
    for(wMonthS:=1;wMonthS<=wMonthsRep;wMonthS++)
      if isvalid(#Statis)
        _loop Statis
        {
          if (not NextVisual) break;

          if Statis.Sovm = 0
//          if Statis.Sovm <= 2
            SetRowData(  4, 0, Statis.SREDKOL);
          if Statis.Sovm <= 2
          {
            SetRowData( 18, 0, Statis.SREDKOL);
            SetRowDataZP(64, 0, 0, 0, Statis.SREDKOL);
            if isValid(#KlKatStat) 
              SetRowDataZP(64+(wWhatKat(KlKatStat.nRec)*2), 0, 0, 0, Statis.SREDKOL); // KlKatStat
          }
        }
  }
//Текущий период среднесписочная-----------------------------------
  dRepV := dRep; 
  iNextVisual('Формируется среднесписочная численность за '+Year(dRepV)+'г. для Листа 3-к.');
  wYearS := Year(dRepV);
  if isvalid(#ExtCatLinks) 
  _loop ExtCatLinks
  {
    if isFilterPodr
    if (not FoundMarker(mPodr1,ExtCatLinks.StaffCat)) continue;
    for(wMonthS:=1;wMonthS<=wMonthsRep;wMonthS++)
      if isvalid(#Statis)
        _loop Statis
        {
          if (not NextVisual) break;

          if Statis.Sovm = 0
            SetRowData( 4, Statis.SREDKOL, 0);
          if Statis.Sovm <= 2
          {
            SetRowData( 18, Statis.SREDKOL, 0);
            SetRowDataZP(64, 0, 0, Statis.SREDKOL, 0);
            if isValid(#KlKatStat) 
              SetRowDataZP(64+(wWhatKat(KlKatStat.nRec)*2), 0, 0, Statis.SREDKOL, 0); // KlKatStat
          }
        }
  }
//Стажировки-----------------------------------
  iNextVisual('Формируются данные по стажировкам для Листа 3-к.');
  cKindApp := comp(0);
  if getfirst Catalogs where ((integer(-123)==Catalogs.SysCode)) = tsOk
  {
    cKindApp := Catalogs.nRec;
    if getfirst Catalogs where ((  integer(0)  == catalogs.lpr
                               and cKindApp    == catalogs.MainLink
                               and 'Стажировка'== catalogs.Name
                               )) = tsOk
    {
      cKindApp := Catalogs.nRec;
    }
  }
//Текущий период стажировки-----------------------------------
/*
and Interns.cAddnRec2 == LSInt.nRec
and LSInt.nRec == LSTInt.cLSchet
and year(Interns.AppointDate) <<= LSTInt.YearN 
and (LSTInt.YearN <= year(Interns.DateEnd))
*/
  dRepV := dRep; 
  iNextVisual('Формируются данные по стажировкам за '+Year(dRepV)+'г. для Листа 3-к.');
  dBeg := date(1,1,Year(dRepV));
  dEnd := dRepV;
  var wDaysInt: word = 0;
  var dDateBegMonth, dDateEndMonth: date;
  var isNextMonth: boolean;
  if isvalid(#Interns)
  _loop Interns
    if iChRPD.isConfirmed(contdoc1.nRec)
      if Interns.ResComp[3]<>comp(0)
      {
        SetRowData(20, 1, 0);
        dDateBegMonth := to_date(1, Month(Interns.AppointDate), Year(Interns.AppointDate));
//        dDateEndMonth := (1, Month(Interns.DateEnd), Year(Interns.DateEnd));
//        dDateEndMonth := (Last_Day(dDateEndMonth), Month(dDateEndMonth), Year(dDateEndMonth));
        dDateEndMonth := to_date(Last_Day(Interns.DateEnd), Month(Interns.DateEnd), Year(Interns.DateEnd));
        wDaysInt := 0;
        if isvalid(#LSInt)
        do
        {
          if ( getfirst LSTInt where((  LSInt.nRec == LSTInt.cLSchet
                                    and year(dDateBegMonth) == LSTInt.YearN
                                    and month(dDateBegMonth) == LSTInt.MesN
                                     )) = tsOk )
          {
            do
            {
//              message(dDateBegMonth+' '+LSTInt.YearN+' '+LSTInt.MesN);
              if ( ( dDateBegMonth >= Interns.AppointDate ) and ( dDateBegMonth <= Interns.DateEnd ) )
                if ( LSTInt.DAYCHF[day(dDateBegMonth)] > 0 and LSTInt.DAYCHF[day(dDateBegMonth)] < 253)
                  wDaysInt++;
              dDateBegMonth := Add_Day(dDateBegMonth, 1);
            } while day(dDateBegMonth) <> 1;
          }
          else dDateBegMonth := add_day(dDateEndMonth, 1);
        } while ( dDateBegMonth <= dDateEndMonth )
//        SetRowData(22, CalcDaysBetweenDates(Interns.AppointDate, Interns.DateEnd,false), 1);
        SetRowData(22, wDaysInt, 1);
//        message(wDaysInt+' = '+dDateBegMonth+'-'+dDateEndMonth+'<=>'+Interns.AppointDate+'-'+Interns.DateEnd);
        //here rash beg
        clearbuffer(#mtRash3k);
        mtRash3k.wType := 4;
        mtRash3k.cPrik := contdoc1.cPart;
        mtRash3k.dSens := Interns.DateEnd;
        mtRash3k.cPsn    := contdoc1.PERSON;
        //mtRash3k.cDept := DisApp.Department;
        //mtRash3k.cPost := DisApp.Post;
        //mtRash3k.cKat  := DisApp.EmpCategory;
        //mtRash3k.cReason := DisApp.cDisReason;
        //mtRash3k.is29  := isAgeUpTo(PersDis.nRec, DisApp.DismissDate);
        mtRash3k.wDaysPS := wDaysInt;
        insert current mtRash3k;
        //here rash end
        if (not NextVisual) break;
      }
        
//Предыдущий  период стажировки-----------------------------------
  if isFreeDate
  {
    dRepV := To_Date(1, month(dRep), Year(dRep)-1); 
    dRepV := To_Date(last_day(dRepV), month(dRepV), Year(dRepV)); //на случай високосного года
  }
  else
    dRepV := To_Date(31, 12, Year(dRep)-1); 

  iNextVisual('Формируются данные по стажировкам за '+Year(dRepV)+'г. для Листа 3-к.');
  dBeg := date(1,1,Year(dRepV));
  dEnd := dRepV;
  if ( wFromExistFile = 0 )
  if isvalid(#Interns)
  _loop Interns
    if iChRPD.isConfirmed(contdoc1.nRec)
    if Interns.ResComp[3]<>comp(0)
      {SetRowData(20, 0, 1);if (not NextVisual) break;}
//Практика Текущий период -----------------------------------
  dRepV := dRep; 
  iNextVisual('Формируются данные по практикантам за '+Year(dRepV)+'г. для Листа 3-к.');
  dBeg := date(1,1,Year(dRepV));
  dEnd := dRepV;
  if isvalid(#GP_SPCONTDOC201)
  _loop GP_SPCONTDOC201
    if iChRPD.isConfirmed(contdoc201.nRec)
      {
        //SetRowData(23, 1, 0);
        SetRowData(25, CalcDaysBetweenDates(GP_SPCONTDOC201.DATEFROM,GP_SPCONTDOC201.DATETO,true), 1);
        //here rash beg
        clearbuffer(#mtRash3k);
        if ( getfirst mtRash3k where ((GP_SPCONTDOC201.FIO == mtRash3k.sFIO)) <> tsOk )
        {
          SetRowData(23, 1, 0);
          mtRash3k.wType := 3;
          mtRash3k.cPrik := contdoc201.cPart;
          //mtRash3k.dSens := DisApp.AppointDate;
          mtRash3k.sFIO  := GP_SPCONTDOC201.FIO;
  //        mtRash3k.cPsn  := contdoc201.Person;
          //mtRash3k.cDept := DisApp.Department;
          //mtRash3k.cPost := DisApp.Post;
          //mtRash3k.cKat  := DisApp.EmpCategory;
          //mtRash3k.cReason := DisApp.cDisReason;
          //mtRash3k.is29  := isAgeUpTo(PersDis.nRec, DisApp.DismissDate);
          mtRash3k.wDaysPS := CalcDaysBetweenDates(GP_SPCONTDOC201.DATEFROM, GP_SPCONTDOC201.DATETO, true);
          insert current mtRash3k;
        }
        else
        {
          mtRash3k.wDaysPS += CalcDaysBetweenDates(GP_SPCONTDOC201.DATEFROM, GP_SPCONTDOC201.DATETO, true);
          update current mtRash3k;
        }
        //here rash end
        if (not NextVisual) break;
      }
//Практика Предыдущий период -----------------------------------
  if isFreeDate
  {
    dRepV := To_Date(1, month(dRep), Year(dRep)-1); 
    dRepV := To_Date(last_day(dRepV), month(dRepV), Year(dRepV)); //на случай високосного года
  }
  else
    dRepV := To_Date(31, 12, Year(dRep)-1); 

  iNextVisual('Формируются данные по практикантам за '+Year(dRepV)+'г. для Листа 3-к.');
  dBeg := date(1,1,Year(dRepV));
  dEnd := dRepV;
  if ( wFromExistFile = 0 )
  if isvalid(#GP_SPCONTDOC201)
  _loop GP_SPCONTDOC201
    if iChRPD.isConfirmed(contdoc201.nRec)
      {SetRowData(23, 0, 1);if (not NextVisual) break;}
//приемы на работу --------------------------------------------
  dRepV := dRep; 
  iNextVisual('Формируются данные по приемам на работу за '+Year(dRepV)+'г. для Листа 3-к.');
  dBeg := date(1,1,Year(dRepV));
  dEnd := dRepV;
  if isvalid(#AppApp)
  _loop AppApp
  {
    if (not NextVisual) break;
    if isvalid(#AppStruct) cAppDept := AppStruct.DEPARTMENT else cAppDept := comp(0);
    if isFilterPodr
    if (not FoundMarker(mPodr1,cAppDept)) continue;
//    if isvalid(#AppDoc)
//    if iChRPD.isConfirmed(AppDoc.nRec)
    if not isvalid(#AppHist)
      continue;
    if isvalid(#AppDoc)
      if not iChRPD.isConfirmed(AppDoc.nRec)
        continue;
    if isvalid(#LSApp)
    if ( LSApp.Sovm <> 1 and LSApp.Sovm <> 2 and ( AppApp.lPrizn=0 or AppApp.lPrizn=100 ) and AppApp.Rate<>0 )
    {

      SetRowData(30, 1, 0);
      wKatEmpl := wWhatKat(AppStruct.EmpCategory);
      if wKatEmpl <> 0
        SetRowData(30+wKatEmpl, 1, 0);
      if isvalid(#PersApp)
      if isAgeUpTo(PersApp.BornDate, AppApp.AppointDate/*dRepV*/) //Считаем возраст на дату приема
        SetRowData(35, 1, 0);
      //here rash beg
      clearbuffer(#mtRash3k);
      mtRash3k.wType := 1;
      mtRash3k.cPrik := AppDoc.cPart;
      mtRash3k.dSens := AppApp.AppointDate;
      mtRash3k.cPsn  := AppApp.Person;
      mtRash3k.cDept := AppApp.Department;
      mtRash3k.cPost := AppApp.Post;
      mtRash3k.cKat  := AppApp.EmpCategory;
      //mtRash3k.cReason := AppApp.cDisReason;
      mtRash3k.is29  := isAgeUpTo(PersApp.BornDate, AppApp.AppointDate);

      if getfirst AppStruct  = tsok
      {
        mtRash3k.sDop3:=iCatFunc.GetCatalogsName(AppStruct.cinf3);
      };

      insert current mtRash3k;
      //here rash end
    }
  }
//Увольнения ------------------------------------------
/*
and dBeg<<= DisApp.DismissDate (noindex) and (dEnd >= DisApp.DismissDate)
and DisApp.person    == PersDis.nrec
and DisApp.nrec      == DisDoc.cStr and (DisDoc.TypeOper = integer(8))
and DisApp.caddnrec2 == LSDis.nrec
and DisApp.StaffStr == DisStruct.nRec
*/
  dRepV := dRep; 
  iNextVisual('Формируются данные по увольнениям за '+Year(dRepV)+'г. для Листа 3-к.');
  dBeg := date(1,1,Year(dRepV));
  dEnd := dRepV;
  if isvalid(#DisApp)
  _loop DisApp
  {
    if (not NextVisual) break;
    if isvalid(#DisStruct) cAppDept := DisStruct.DEPARTMENT else cAppDept := comp(0);
    if isFilterPodr
    if (not FoundMarker(mPodr1,cAppDept)) continue;
    if isvalid(#DisDoc)
    if iChRPD.isConfirmed(DisDoc.nRec)
    if isvalid(#LSDis)
    if ( LSDis.Sovm <> 1 and LSDis.Sovm <> 2 and ( DisApp.lPrizn = 0 or DisApp.lPrizn = 100 ) and DisApp.Rate <> 0 )
    {
      SetRowData(50, 1, 0);
      wKatEmpl := wWhatKat(DisStruct.EmpCategory);
      if wKatEmpl <> 0
        SetRowData(50+(wKatEmpl*2), 1, 0);
      if isvalid(#PersDis)
      if isAgeUpTo(PersDis.BornDate,/*DisApp.DismissDate*/dRepV) //Считаем возраст на дату увольнения
        SetRowData(60, 1, 0);
      if isStajUpTo(PersDis.nRec,DisApp.DismissDate)  //Считаем стаж на дату увольнения
        SetRowData(62, 1, 0);
      if isDisReasonIn(DisApp.cDisReason)
      {
        SetRowData(36, 1, 0);
        if wKatEmpl <> 0
          SetRowData(36+(wKatEmpl*2), 1, 0);
        if isvalid(#PersDis)
        if isAgeUpTo(PersDis.BornDate,DisApp.DismissDate/*dRepV*/) //Считаем возраст на дату увольнения
          SetRowData(46, 1, 0);
        if isStajUpTo(PersDis.nRec,DisApp.DismissDate)  //Считаем стаж на дату увольнения
          SetRowData(48, 1, 0);
      }
      //here rash beg
      clearbuffer(#mtRash3k);
      mtRash3k.wType := 2;
      mtRash3k.cPrik := DisDoc.cPart;
      mtRash3k.dSens := DisApp.DismissDate;
      mtRash3k.cPsn  := DisApp.Person;
      mtRash3k.cDept := DisApp.Department;
      mtRash3k.cPost := DisApp.Post;
      mtRash3k.cKat  := DisApp.EmpCategory;
      mtRash3k.cReason := DisApp.cDisReason;
      mtRash3k.is29  := isAgeUpTo(PersDis.nRec, DisApp.DismissDate);

      if getfirst DisStruct  = tsok
      {
        mtRash3k.sDop3:=iCatFunc.GetCatalogsName(DisStruct.cinf3);
      };

      insert current mtRash3k;
      //here rash end
#ifdef RKSTATDEBUG
LogFile.WriteLN(PersDis.STRTABN+'='+PersDis.FIO+' уволен '+PersDis.BornDate);
#endif
    }
  }
//Продолжаем тут  
  var dbCurT, dbPervT, dbKolCurT, dbKolPervT : double;
//Предыдущий период ФЗП-----------------------------------
  set __YearV  := Year(dRep)-1;
  wMonthToCalc := 0;
//   dbSumToCalc  := 0.0;
  iNextVisual('Формируется ФЗП за '+__YearV+'г. для Листа 3-к.');
  if ( wFromExistFile = 0 )
  for(__MesV:=1; __MesV<=wMonthsRep; __MesV++)
  {
    if isValid(#SumVidOp)
    {
      wMonthToCalc++;
      _loop SumVidOp
      {
        if not isValid(#mtVidOplFZP)
          continue;
        if isFilterPodr
          if isValid(#ECL2Opl)
            if (not FoundMarker(mPodr1, ECL2Opl.StaffCat))
              continue;
        SetRowDataZP( 64, 0, SumVidOp.Summa, 0, 0);
        if isValid(#LSVidOp)
          if isValid(#KlKatLS)
             SetRowDataZP(64+(wWhatKat(KlKatLS.nRec)*2), 0, SumVidOp.Summa, 0, 0); // KlKatStat
        if ( not NextVisual ) break;
      }
    }
  }
  if ( wFromExistFile = 0 )
  if ( wMonthToCalc <> 0 )
  {
    if isLocateRowZP_Return( 64, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
      UpdRowDataZP( 64, dbCurT, if(dbKolPervT<>0, (dbPervT/wMonthToCalc)/(dbKolPervT/wMonthsRep),0), dbKolCurT, dbKolPervT);
    if isLocateRowZP_Return( 66, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
      UpdRowDataZP( 66, dbCurT, if(dbKolPervT<>0, (dbPervT/wMonthToCalc)/(dbKolPervT/wMonthsRep),0), dbKolCurT, dbKolPervT);
    if isLocateRowZP_Return( 68, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
      UpdRowDataZP( 68, dbCurT, if(dbKolPervT<>0, (dbPervT/wMonthToCalc)/(dbKolPervT/wMonthsRep),0), dbKolCurT, dbKolPervT);
    if isLocateRowZP_Return( 70, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
      UpdRowDataZP( 70, dbCurT, if(dbKolPervT<>0, (dbPervT/wMonthToCalc)/(dbKolPervT/wMonthsRep),0), dbKolCurT, dbKolPervT);
    if isLocateRowZP_Return( 72, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
      UpdRowDataZP( 72, dbCurT, if(dbKolPervT<>0, (dbPervT/wMonthToCalc)/(dbKolPervT/wMonthsRep),0), dbKolCurT, dbKolPervT);
  }
//Текущий период ФЗП-----------------------------------
  set __YearV  := Year(dRep);
  wMonthToCalc := 0;
//   dbSumToCalc  := 0.0;
  iNextVisual('Формируется ФЗП за '+__YearV+'г. для Листа 3-к.');
  if ( dbSZPSpets = 0 and dbSZPSluzh = 0 )
  {
    for(__MesV:=1; __MesV<=wMonthsRep; __MesV++)
    {
      if isValid(#SumVidOp)
      {
        wMonthToCalc++;
        _loop SumVidOp
        {
          if not isValid(#mtVidOplFZP)
            continue;
          if isFilterPodr
            if isValid(#ECL2Opl)
              if (not FoundMarker(mPodr1, ECL2Opl.StaffCat))
                continue;
          SetRowDataZP( 64, SumVidOp.Summa, 0, 0, 0);
          if isValid(#LSVidOp)
            if isValid(#KlKatLS)
               SetRowDataZP(64+(wWhatKat(KlKatLS.nRec)*2), SumVidOp.Summa, 0, 0, 0); // KlKatStat
          if ( not NextVisual ) break;
        }
      }
    }
    if ( wMonthToCalc <> 0 )
    {
      if isLocateRowZP_Return( 64, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
        UpdRowDataZP( 64, if(dbKolCurT<>0, (dbCurT/wMonthToCalc)/(dbKolCurT/wMonthsRep), 0), dbPervT, dbKolCurT, dbKolPervT);
      if isLocateRowZP_Return( 66, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
        UpdRowDataZP( 66, if(dbKolCurT<>0, (dbCurT/wMonthToCalc)/(dbKolCurT/wMonthsRep), 0), dbPervT, dbKolCurT, dbKolPervT);
      if isLocateRowZP_Return( 68, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
        UpdRowDataZP( 68, if(dbKolCurT<>0, (dbCurT/wMonthToCalc)/(dbKolCurT/wMonthsRep), 0), dbPervT, dbKolCurT, dbKolPervT);
      if isLocateRowZP_Return( 70, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
        UpdRowDataZP( 70, if(dbKolCurT<>0, (dbCurT/wMonthToCalc)/(dbKolCurT/wMonthsRep), 0), dbPervT, dbKolCurT, dbKolPervT);
      if isLocateRowZP_Return( 72, dbCurT, dbPervT, dbKolCurT, dbKolPervT)
        UpdRowDataZP( 72, if(dbKolCurT<>0, (dbCurT/wMonthToCalc)/(dbKolCurT/wMonthsRep), 0), dbPervT, dbKolCurT, dbKolPervT);
    }
  }
// LSVidOp
// -------------------------
  StopVisual;
#ifdef RKSTATDEBUG
LogFile.Close;
#endif
}

function isLocateRow_Return(lRowT : longint; var dbCur, dbPrev : double) : boolean;
{
  if getfirst ttStat3K where ((lRowT==ttStat3K.lRow))=tsOk
  {dbCur :=ttStat3K.dbVal[1];dbPrev:=ttStat3K.dbVal[2];result:=true;}
  else
  {dbCur := dbPrev:=0;result:=false;}
}


procedure PostProcess3K;
{
  var dbCur, dbPrev : double;

  if isLocateRow_Return( 2,dbCur, dbPrev)
    SetRowData( 3, if(dbPrev<>0,dbCur/dbPrev,0), 0);
  if isLocateRow_Return( 4,dbCur, dbPrev)
  {
    if ( wFromExistFile = 0 )
    {
      UpdRowData(  4, dbCur/wMonthsRep, dbPrev/wMonthsRep); //if(wFromExistFile = 0, wMonthsRep, 1)
      UpdRowData( 11, if((dbPrev)<>0,dbCur/dbPrev,0), 0);
    }
    else
    {
      UpdRowData(  4, dbCur/wMonthsRep, dbPrev); //if(wFromExistFile = 0, wMonthsRep, 1)
      UpdRowData( 11, if((dbPrev)<>0, (dbCur/wMonthsRep)/dbPrev, 0), 0);
    }
  }
  if isLocateRow_Return( 18, dbCur, dbPrev)
  {
    if ( wFromExistFile = 0 )
    {
      UpdRowData( 18, dbCur/wMonthsRep, 0);
      SetRowData( 19, if(dbPrev<>0,dbCur/dbPrev, 0), 0);
    }
    else
    {
      UpdRowData( 18, dbCur/wMonthsRep, 0);
      SetRowData( 19, if(dbPrev<>0, (dbCur/wMonthsRep)/dbPrev, 0), 0);
    }
  }
  
  if isLocateRow_Return(20,dbCur, dbPrev)
    SetRowData(21, if(dbPrev<>0,dbCur/dbPrev,0), 0);
  
  if isLocateRow_Return(22,dbCur, dbPrev)
    UpdRowData(22, if(dbPrev<>0,dbCur/dbPrev,0), 0);
  
  if isLocateRow_Return(23,dbCur, dbPrev)
    SetRowData(24, if(dbPrev<>0,dbCur/dbPrev,0), 0);
  
  if isLocateRow_Return(25,dbCur, dbPrev)
    UpdRowData(25, if(dbPrev<>0,dbCur/dbPrev,0), 0);
  
  if isLocateRow_Return(26,dbCur, dbPrev)
    UpdRowData(27, if(dbPrev<>0,dbCur/dbPrev,0), 0);
  if isLocateRow_Return(28,dbCur, dbPrev)
    UpdRowData(29, if(dbPrev<>0,dbCur/dbPrev,0), 0);

  if isLocateRow_Return(64, dbCur, dbPrev)
    UpdRowData(65, if(dbPrev<>0, dbCur/dbPrev, 0), 0);
  if isLocateRow_Return(66,dbCur, dbPrev)
    UpdRowData(67, if(dbPrev<>0, dbCur/dbPrev, 0), 0);
  if isLocateRow_Return(68, dbCur, dbPrev)
    UpdRowData(69, if(dbPrev<>0, dbCur/dbPrev, 0), 0);
  if isLocateRow_Return(70, dbCur, dbPrev)
    UpdRowData(71, if(dbPrev<>0, dbCur/dbPrev, 0), 0);
  if isLocateRow_Return(72, dbCur, dbPrev)
    UpdRowData(73, if(dbPrev<>0, dbCur/dbPrev, 0), 0);

//  if isLocateRow_Return(78, dbCur, dbPrev)
//    message('78='+dbCur);
//    UpdRowData(78, dbCur-dbPrev, 0);
  
  if isLocateRow_Return(79, dbCur, dbPrev)
    SetRowData(80, if(dbCur<>0, dbPrev/dbCur, 0), 0);
//  var dbSrSpCur, dbSrSpPrev: double = 0.0;
  if isLocateRow_Return(4, dbCur, dbPrev)
  {
    if ( dbCur<>0 )
    {
      UpdRowData(74, dbVyruchCur/dbCur, 0);
      UpdRowData(76, dbVyruchOwnCur/dbCur, 0);
//       message('dbPrev='+To_Char(dbPrev));
      if ( dbVyruchOwnPrev <> 0 and dbPrev <> 0 )
      {
        UpdRowData(75, (dbVyruchCur/dbCur)/(dbVyruchPrev/dbPrev), 0);
        UpdRowData(77, (dbVyruchOwnCur/dbCur)/(dbVyruchOwnPrev/dbPrev), 0);
      }
    }
  }
  if isLocateRow_Return(68, dbCur, dbPrev)
    UpdRowData(68, dbSZPSpets, dbPrev);
  if isLocateRow_Return(70, dbCur, dbPrev)
    UpdRowData(70, dbSZPSluzh, dbPrev);
  //dbSZPSpets
  //dbSZPSluzh
}

function isData3K : boolean;
{
  if isvalid(#ttStat3K)
    result := true
  else
    result := false;
}


procedure Print3K;
{
  var dbCur, dbPrev : double;
  var i : word;
  
  if isData3K
  if xlSetActiveSheetByName('3-к')
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Выгружаю данные для Листа 3-к в Excel.', 0);
    TOA.Bind(0);
    xlSetCellStringValue(Trim(TOA1.GetNaming.GetFullName()),2,4,2,4);
    xlSetCellStringValue(DateToStr(dRep,'DD.MM.YYYY'),3,4,3,4);
    for(i:=2;i<=80;i++)
    {
      if (not NextVisual) break;
      if ( i < 64 or i > 73 )
        if isLocateRow_Return(i,dbCur, dbPrev)
          xlSetCellNumberValue(dbCur,4+i,4,4+i,4);
    }
    
    xlSetCellFormula('='+chr(39)+'7-к'+chr(39)+'!K43', 68, 4, 68, 4);//='7-к'!K44
    xlSetCellFormula('='+chr(39)+'7-к'+chr(39)+'!K44', 70, 4, 70, 4);
    xlSetCellNumberValue(dbSZPSpets, 72, 4, 72, 4);
    xlSetCellNumberValue(dbSZPSluzh, 74, 4, 74, 4);
    xlSetCellFormula('='+chr(39)+'7-к'+chr(39)+'!K46', 76, 4, 76, 4);
    if isLocateRow_Return(64, dbCur, dbPrev)
      if ( dbPrev <> 0 )
        xlSetCellFormula('=D68/'+DoubleToStr(dbPrev, '6666666666,88'), 69, 4, 69, 4);
    if isLocateRow_Return(66, dbCur, dbPrev)
      if ( dbPrev <> 0 )
        xlSetCellFormula('=D70/'+DoubleToStr(dbPrev, '6666666666,88'), 71, 4, 71, 4);
    if isLocateRow_Return(68, dbCur, dbPrev)
      if ( dbPrev <> 0 )
        xlSetCellFormula('=D72/'+DoubleToStr(dbPrev, '6666666666,88'), 73, 4, 73, 4);
    if isLocateRow_Return(70, dbCur, dbPrev)
      if ( dbPrev <> 0 )
        xlSetCellFormula('=D74/'+DoubleToStr(dbPrev, '6666666666,88'), 75, 4, 75, 4);
    if isLocateRow_Return(72, dbCur, dbPrev)
      if ( dbPrev <> 0 )
        xlSetCellFormula('=D76/'+DoubleToStr(dbPrev, '6666666666,88'), 77, 4, 77, 4);

    StopVisual;
  }
}

procedure PrintRash3k;
{
  if isvalid(#mtRash3k)
  {
    var lRecCount: longint = recordsintable(#mtRash3k);
    var lLine : longint = 0;
    var lRB, lRE, lCB, lCE : longint = 1;
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Выгружаю расшифровку для Листа 3-к в Excel.', 0);
    lRB := lRE := 2;
    xlMergeCells(1,1,1,4);
    xlSetCellStringValue('Расшифровка листа 3-к. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
    lCE := 0;
    var lBeginError, lBegin : longint = 0;
    lCE++; xlSetCellStringValue('№ п/п',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Тип приказа',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Номер приказа',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата приказа',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата пр./ув.',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Подразделение',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Профессия/должность',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Категория',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('До'+chr(10)+'29'+chr(10)+'лет',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дней'+chr(10)+'стажировки'+chr(10)+'практики',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Причина увольнения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Доп.характеричтика',lRE,lCE,lRE,lCE);
    lRE++;
    
    if (not xlCreateMatrix(lRecCount, lCE))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    #define FrmCl lRE, lCE
    lRE := 1;
    var sType: array[1..4] of string[10];
    sType[1]:='Прием'; sType[2]:='Увольнение'; sType[3]:='Практика'; sType[4]:='Стажировка';
    _loop mtRash3k ordered index mtRash3k00
    {
      if (not NextVisual) break;
      lCE := 0;
      ++lCE; xlStWriteToMatrix(#FrmCl, ++lLine);       
      ++lCE; xlStWriteToMatrix(#FrmCl, sType[mtRash3k.wType]);
      ++lCE; if isvalid(#PDcRS)
               if isvalid(#TiDcRs)
                 xlStWriteToMatrix(#FrmCl, TiDcRs.DOCNMB);
      ++lCE; if isvalid(#PDcRS)
               if isvalid(#TiDcRs)
                 xlDtWriteToMatrix(#FrmCl, TiDcRs.DOCDATE);
      ++lCE; xlDtWriteToMatrix(#FrmCl, mtRash3k.dSens);
      if ( mtRash3k.wType = 3 )
      {
        ++lCE; xlStWriteToMatrix(#FrmCl, mtRash3k.sFIO);
      }
      else
      {
        ++lCE; if isvalid(#PsnRs) xlStWriteToMatrix(#FrmCl, PsnRs.FIO);
      }
      ++lCE; if isvalid(#DeptRs) xlStWriteToMatrix(#FrmCl, DeptRs.Code);
      ++lCE; if isvalid(#PostRs) xlStWriteToMatrix(#FrmCl, PostRs.Name);
      ++lCE; if isvalid(#KlKtRs) xlStWriteToMatrix(#FrmCl, KlKtRs.NAIKAT);
      ++lCE; if ( mtRash3k.is29 ) xlStWriteToMatrix(#FrmCl, '+');
      ++lCE; if ( mtRash3k.wDaysPS <> 0 ) xlStWriteToMatrix(#FrmCl, mtRash3k.wDaysPS);
      ++lCE; if isvalid(#ReasRs) xlStWriteToMatrix(#FrmCl, ReasRs.Name);
      ++lCE;  xlStWriteToMatrix(#FrmCl, chr(39)+mtRash3k.sdop3);  //доп.характеристика
      lRE++;
    }
    lRE++;
    xlSetNumberFormat('@', lRB+1,  7, lRE,  7);
    if (not xlWriteMatrixToExcel(3,1))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;
    xlWrapText(lRB,lCB,lRB,lCE);
    xlAutoFit(lRB,lCB,lRE,lCE);
    xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
    StopVisual;
  }
  
}

procedure Save3K;
{
  iUDR.SaveMarker('RKS3_mKatWorker1', mKatWorker1);
  iUDR.SaveMarker('RKS3_mKatWorker2', mKatWorker2);
  iUDR.SaveMarker('RKS3_mKatWorker3', mKatWorker3);
  iUDR.SaveMarker('RKS3_mKatWorker4', mKatWorker4);
  iUDR.SaveMarker('RKS3_mKatType1'  , mKatType1  );
  iUDR.SaveMarker('RKS3_mPodr1'     , mPodr1     );

  DoneMarker(mKatWorker1, '');
  DoneMarker(mKatWorker2, '');
  DoneMarker(mKatWorker3, '');
  DoneMarker(mKatWorker4, '');
  DoneMarker(mKatType1  , '');
  DoneMarker(mPodr1     , '');
  DoneMarker(mPersRash1k, '');

  iUDR.SaveDate  ('RKS3_dRep'        , dRep        );
  iUDR.SaveWord  ('RKS3_wToExistFile', wToExistFile);
  iUDR.SaveString('RKS3_sToExistFile', sToExistFile);
  iUDR.SaveWord  ('RKS3_wPrintRash'  , wPrintRash  );

  iUDR.SaveDouble('RKS3_dbVyruchCur'    , dbVyruchCur    );
  iUDR.SaveDouble('RKS3_dbVyruchPrev'   , dbVyruchPrev   );
  iUDR.SaveDouble('RKS3_dbVyruchOwnCur' , dbVyruchOwnCur );
  iUDR.SaveDouble('RKS3_dbVyruchOwnPrev', dbVyruchOwnPrev);
  iUDR.SaveDouble('RKS3_dbSZPSpets', dbSZPSpets);
  iUDR.SaveDouble('RKS3_dbSZPSluzh', dbSZPSluzh);

  iUDR.SaveWord  ('RKS3_wFromExistFile', wFromExistFile);
  iUDR.SaveString('RKS3_sFromExistFile', sFromExistFile);
}
procedure Clear3K;
{
  delete all from ttStat3K;
}
procedure init3K;
{
  set dRep := iUDR.ReadDate('RKS3_dRep');
  if dRep = 0
    set dRep := To_Date(31,12,Year(Cur_Date));
  
  set wPrintRash   := iUDR.ReadWord  ('RKS3_wPrintRash'  );
  set sToExistFile := iUDR.ReadString('RKS3_sToExistFile');
  set wToExistFile := iUDR.ReadWord  ('RKS3_wToExistFile');
  if wToExistFile = 1 
    ToggleFieldVisible(#sToExistFile,true )
  else
    ToggleFieldVisible(#sToExistFile,false);

  set sFromExistFile := iUDR.ReadString('RKS3_sFromExistFile');
  set wFromExistFile := iUDR.ReadWord  ('RKS3_wFromExistFile');
  if wFromExistFile = 1 
    ToggleFieldVisible(#sFromExistFile,true )
  else
    ToggleFieldVisible(#sFromExistFile,false);

  mKatWorker1 := iUDR.ReadMarker('RKS3_mKatWorker1');
  mKatWorker2 := iUDR.ReadMarker('RKS3_mKatWorker2');
  mKatWorker3 := iUDR.ReadMarker('RKS3_mKatWorker3');
  mKatWorker4 := iUDR.ReadMarker('RKS3_mKatWorker4');
  mKatType1   := iUDR.ReadMarker('RKS3_mKatType1'  );
  mPersRash1k := initMarker('', 8, 1000, 100, true);

  set sKatWorker1 := sSetKatName(mKatWorker1);
  set sKatWorker2 := sSetKatName(mKatWorker2);
  set sKatWorker3 := sSetKatName(mKatWorker3);
  set sKatWorker4 := sSetKatName(mKatWorker4);
  set sKatType1   := sSetConstruct(mKatType1);
 
  mPodr1     := iUDR.ReadMarker('RKS3_mPodr1');
  set sPodr1 := sSetPodrName(mPodr1);

  dbVyruchCur     := iUDR.ReadDouble('RKS3_dbVyruchCur'    );
  dbVyruchPrev    := iUDR.ReadDouble('RKS3_dbVyruchPrev'   );
  dbVyruchOwnCur  := iUDR.ReadDouble('RKS3_dbVyruchOwnCur' );
  dbVyruchOwnPrev := iUDR.ReadDouble('RKS3_dbVyruchOwnPrev');
  dbSZPSpets := iUDR.ReadDouble('RKS3_dbSZPSpets' );
  dbSZPSluzh := iUDR.ReadDouble('RKS3_dbSZPSluzh');
}

function isCheckRepParam(isStayAlone : boolean) : boolean;
{
  result := false;
  if dRep = 0
  {if isStayAlone message('Не задана дата!'); exit;}
  if GetMarkerCount(mKatWorker1) = 0
  or GetMarkerCount(mKatWorker2) = 0
  or GetMarkerCount(mKatWorker3) = 0
  or GetMarkerCount(mKatWorker4) = 0 
  {if isStayAlone message('Не установлена одна из категорий!'); exit;}
//  if GetMarkerCount(mPodr1) = 0
//  {if isStayAlone message('Не заданы подразделения!'); exit;}
  if GetMarkerCount(mKatType1) = 0
  {if isStayAlone message('Не заданы должности главных конструкторов!'); exit;}
  if wToExistFile = 1
    if not ExistFile(sToExistFile)
    {if isStayAlone message('Ошибка открытия файла!'); exit;}
  if ( wFromExistFile = 1 )
    if not ExistFile(sFromExistFile)
    {if isStayAlone message('Ошибка открытия входного файла!'); exit;}
  result := true;
}
