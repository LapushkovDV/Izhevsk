#component "Z_StaffCat"

alter interface CatHist;
var pVA_VID_PROIZV_H:comp;

  create view
    as select
       sGetAttrID(coCatHist,CatHist.Nrec,pVA_VID_PROIZV_H) (FieldName=sVID_PROIZV)
    where ((
          CatHist.NRec         == SHR_Condition.Report
      and SHR_Condition.Reserv == StrCont.NRec
      and StrCont.cPart        == StrPart.Nrec
      and StrPart.cDoc         == StrTitle.nRec
    ));

  overloadFormats brwCatHist;

  browse brwCatHist (,,sci1378Esc);
    table CatHistOrder;
  fields
    CatHistOrder.Npp '№ п/п' ('Порядковый номер записи'): [6], protect, noAutoSize;
    CatHist.dat1     'Дата' ('Дата изменения'): [12,'DD/MM/YYYY'], noProtect, noAutoSize;
    StrTitle.DocNmb  '№ приказа' ('№ приказа'): [12], protect, noAutoSize;
    StrTitle.DocDate 'Дата приказа' ('Дата приказа'): [14], protect, noAutoSize;
    CatStrPr.NOper   'Операция' ('Наименование операции',, sci1378Esc): [15], protect, pickButton;
    CatHist.Name     'Наименование' ('Наименование элемента ШР',, sci178Esc): [25], noProtect;
    CatHist.NParent  'Наименование вышестоящего' ('Наименование вышестоящего элемента ШР',, sci1378Esc): [25], protect, pickButton;
    sVID_PROIZV      'Вид производства'   ('ВА "Вид производства"',,sci13Esc) :[25], protect,PickButton;
    SHR_Condition.FldCondition 'Длинное наименование элемента' ('Длинное наименование элемента ШР',, sci178Esc): [20], noProtect;
  end;

  handleEvent
    cmInit:
    { pVA_VID_PROIZV_H:=ExtAttr_ID(coCatHist,'Вид производства');
      if  inherited :: handleEvent (cmInit)=heAbort then Abort;
    }
    cmDefault:
      if IsValid(tnStrTitle) then
      begin
        RunInterface('SHROrdersList', StrTitle.NRec);
        abort;
      end;
  end;
end.
