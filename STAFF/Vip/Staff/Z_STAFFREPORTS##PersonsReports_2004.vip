#component "Z_STAFFREPORTS"

#include GP_FormT2.vih

#errorLevel 0
alter interface PersonsReports_2004;

  var oGP_FormT2: GP_FormT2;

  overLoad
    procedure Report_T2_136;
    procedure Report_T2GS_136;
  end;

  procedure Report_T2_136;
  var
    VidForm: Word;
  begin
    VidForm := 0;
    if numReport != 7 then
      // Считываем значение параметра "форма отчета"
      if not ReadMyDSK(VidForm, 'vidOtch_T2_2004', true) then
        VidForm := 0;
    if VidForm = 0 then
    begin
      // При запуске формы Т-2 с формой отчёта текст предлагаем выбрать назначение
      if oGP_FormT2.ChooseApp(Persons.NRec, DateRep, false) != 0 then
        inherited::Report_T2_136;
    end else
      inherited::Report_T2_136;
  end;

  procedure Report_T2GS_136;
  var
    VidForm: Word;
  begin
    // Считываем значение параметра "форма отчета"
    if not ReadMyDSK(VidForm, 'vidOtch_T2_2004', true) then
      VidForm := 0;
    if VidForm = 0 then
    begin
      // При запуске формы T-2 (ВУР) с формой отчёта текст используем первое найденное на дату отчёта назначение
      if oGP_FormT2.ChooseApp(Persons.NRec, DateRep, true) != 0 then
        inherited::Report_T2GS_136;
    end else
      inherited::Report_T2GS_136;
  end;

end.
#errorLevel reset
