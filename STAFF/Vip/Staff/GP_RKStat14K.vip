#define GPInt GP_RKStat_List14K // #(GPInt)
#define GPNam 14-К "Отчет о ходе реализации государственного плана подготовки кадров со средним профессиональным и высшим образованием организаций оборонно-промышленного комплекса по образовательным программам СПО и ВО" // #(GPNam)

VipInterface #(GPInt) Implements IGP_RKStat;
Interface #(GPInt);

const
#include Excel.inc;
sGroupOUV   = '_ВУЗы (высшие учебные заведения)';
sGroupOUS   = '_ССУЗы (средние специальные учебные заведения)';
sDogovor    = 'Учебный (целевики)';
sDocCEdu    = 'Договор на целевое обучение';
sDissEdu    = 'Дата отчисления из обр.учреждения';
sAspirant   = '24';
sDissReason = 'п.1 ст.83 ТК';
end;
#include ExtAttr.var
#include TotalOrganizationAttributes.var

table struct ttStatRK
(
  sNameOU : string
, sCodeSpc: string[100]
, dbVal : array [1..18] of double
)
with index
(
  ttStatRK01 = sNameOU + sCodeSpc
);
table struct tt14SpecRK
(
  sCodeSpc: string[100]
, iRow    : integer
)
with index
(
  tt14SpecRK01 = sCodeSpc
);
table struct tt14OURK
(
  sOU  : string
)
with index
(
  tt14OURK01 = sOU
);

/*
table struct ttPsnFlags
(
  cPsn : comp
, isFl : array [1..18] of boolean
)
with index
(
  ttPsnFlags00 = cPsn
);
*/
table struct ttPsnFlags
(
  cPsn : comp
, sFIO : string[60]
, dBorn: date
, isFl : array [1..18] of boolean
)
with index
(
  ttPsnFlags00 = cPsn
, ttPsnFlags01 = sFIO + dBorn
);

table struct ttSpecRK
(
  cPsn      : comp
, cInst     : comp
, cSpec     : comp
, sTypePsn  : string[1]
, sFIO      : string
, dBorn     : date
, dAppoint  : date
, dDismiss  : date
, sDissRea  : string
, sVidEdu   : string
, dBegEdu   : date
, dEndEdu   : date
, sInst     : string
, sLevelInst: string
, sSpecName : string
, sSpecCode : string
, sDeptCode : string
, sPost     : string
, sEduDegr  : string
, dEduDegr  : date
, sDogEduC  : string
, sDogEduU  : string
, fStaj     : double     
, sColunms  : string
)
with index
(
  ttSpecRK00 = cInst + cSpec + cPsn
, ttSpecRK01 = sInst + sSpecCode + sFIO
, ttSpecRK02 = cInst + cSpec + sFIO + dBorn
);


var
  dRep          : date;
  dBeg          : date;
  iCatFunc      : CatalogsFunctions;
  iEClFunc      : iExtClass;
  iStrFunc      : StringFunctions;
  iAppFuncs     : AppointmentsFunctions;
  iRunStaj      : Runstaj;
  ExtAttr       : iExtAttr;
  iChRPD        : GP_ChRPD;
  iUDR          : GP_UDR_RKStat;
  sFullName     : string;
  sPodr1        : string;
  mPodr1        : TPtr;
  isFilterPodr  : boolean;
  wPrintRash    : word;
  wToExistFile  : word;
  sToExistFile  : string;
  cRecTopOUV    : comp;
  cRecTopOUS    : comp;
  cRecDogovor   : comp;
  cDocCEdu      : comp;
  cDissEdu      : comp;
  cDissReason   : comp;
  cDocCEduPsn   : comp;
  _cRecPsn      : comp;
  //-----------------------
  dEduBeg, dEduEnd: date = 0; //костыль из-за РПД236
  cEduAlt: comp = 0;          //костыль из-за РПД236
  wCourse: word = 0;          //костыль из-за РПД236
  _cAppO : comp = 0;          //костыль по приему на работу не приказом а переводос с временного назначения на постоянное


create view
as select *
from
  ttStatRK
, ttSpecRK
, tt14SpecRK
, tt14OURK
, ttPsnFlags
, Education

, ContDoc  CDoc136
, PartDoc  PDoc136
, TitleDoc TDoc136
, Appointments App136
, SpAllStaff Dog136
//-------------
, ContDoc   CDoc236
, Education Educ236
, ContDoc   CDoc236_0
, Education Educ236_0
//---------
, Education EduBUp
, ContDoc   CDocBUp
/*
, PartDoc  PDoc236
, TitleDoc TDoc236
, Appointments App236
*/
//-------------
, ContDoc CDoc8
, Appointments App8
, ContDoc CDoc1
, Appointments App1
, Appointments AppO
, AppHist
, OldOrg OldOrgD 
, Badge
, Badge BadgeN
, Persons
// для разных запросов
//, Catalogs CatAny
//, Education EduAny
, Dogovor DogEdu
, KatVidD VidDogEdu
// для фильтра по подразделениям
, Appointments AppStaff
, StaffStruct  StaffApp
where
((
    Education.cContDoc == CDoc136.nRec and ( CDoc136.TypeOper = 136 )
and      CDoc136.cPart == PDoc136.nRec
and       PDoc136.cDoc == TDoc136.nRec
and _cRecPsn           == Persons.nRec
and CDoc136.cStr       == App136.nRec // and (App136.ContractDate >= dBeg and App136.ContractDate <= dRep and App136.cDog = cRecDogovor)
and App136.ResComp[1]  == Dog136.nRec
//-----------
and            236 == CDoc236.TypeOper
and CDoc136.Person == CDoc236.Person
and Education.nRec == CDoc236.ObjnRec and ( CDoc236.wDopAttr = 1 )
and   CDoc236.nRec == Educ236.cContDoc
and            236 == CDoc236_0.TypeOper
and CDoc136.Person == CDoc236_0.Person
and Education.nRec == CDoc236_0.ObjnRec and ( CDoc236_0.wDopAttr = 0 )
and CDoc236_0.nRec == Educ236_0.cContDoc
/*
and      CDoc236.cPart == PDoc236.nRec
and       PDoc236.cDoc == TDoc236.nRec
*/
//----------
and _cRecPsn == EduBUp.Person// and ( EduBUp.ToDate >= dBeg and EduBUp.ToDate <= dRep )
and EduBUp.cContDoc == CDocBUp.nRec and ( ( CDocBUp.TypeOper = 136 or CDocBUp.TypeOper = 236 ) and CDocBUp.wDopAttr = 0 )
//-----------
and word(3)            == OldOrgD.wObj
and _cRecPsn           == OldOrgD.cParent
and _cRecPsn           == Badge.Person
and Education.Name     == Badge.Appoint
and integer(-24)       == Badge.BadgeYear
and integer(11)        == Badge.BadgeMonth
and _cRecPsn           == BadgeN.Person
and integer(2)         == BadgeN.BadgeMonth
and _cRecPsn           == CDoc8.Person
and integer(8)         == CDoc8.TypeOper // and (CDoc8.wYearPR = 1 or CDoc8.wYearPR = 2)
and CDoc8.cStr         == App8.nRec and ( App8.DismissDate >= dBeg and App8.DismissDate <= dRep )
/*
and Education.Person   == CDoc1.Person
and integer(1)         == CDoc1.TypeOper // and (CDoc1.wYearPR = 1 or CDoc1.wYearPR = 2)
and CDoc1.cStr         == App1.nRec and (App1.AppointDate >= dBeg and App1.AppointDate <= dRep and App1.lPrizn = 0 and App1.DateEnd = 0)
*/
and _cRecPsn  == App1.Person 
and dEduEnd   << App1.AppointDate and ( App1.AppointDate <= dRep )
and App1.nRec == AppHist.cAppoint and ( AppHist.CodOper = 1 or AppHist.CodOper = 5 )
and App1.nRec == CDoc1.cStr and (CDoc1.TypeOper = 1)
and _cAppO    == AppO.nRec 
/*
and _cRecPsn  == App1.Person 
and dBeg     <<= App1.AppointDate and ( App1.AppointDate <= dRep )
and App1.nRec == AppHist.cAppoint and ( AppHist.CodOper = 1 )
and App1.nRec == CDoc1.cStr and (CDoc1.TypeOper = 1)
*/



//---------
and cDocCEduPsn     == DogEdu.nRec
and DogEdu.cVidDog  == VidDogEdu.nRec
))
;

function sSetPodrName(mSetPdr: TPtr): string;
{
  if (getMarkerCount(mSetPdr) = 0)
  {
    result := 'Все подразделения';
    exit;
  }
  else
    if (getMarkerCount(mSetPdr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько подразделений (' + string(getMarkerCount(mSetPdr)) + ')';
}

function isPsnFirstFlag(/*cPsnT : comp; */iCol : integer) : boolean;
{
  result := true;
  if ( getfirst ttPsnFlags where((Persons.FIO == ttPsnFlags.sFIO and Persons.BornDate == ttPsnFlags.dBorn)) <> tsOk )
  {
    clearbuffer(#ttPsnFlags);
    ttPsnFlags.sFIO  := Persons.FIO;
    ttPsnFlags.dBorn := Persons.BornDate;
    ttPsnFlags.isFl[iCol] := false;
    insert current ttPsnFlags;
  }
  if ttPsnFlags.isFl[iCol] = true
    result := false
  else
    update current ttPsnFlags set ttPsnFlags.isFl[iCol] := true;
}

function isDept4ReportOnDate(cRecAny : comp; dAny : date) : boolean;
{
  if isFilterPodr
  {
    result := false;
    if ( GetFirst AppStaff where((iAppFuncs.GetAppNrec_OnDate(cRecAny, dAny) == AppStaff.NRec)) = tsOk )
      if ( getfirst StaffApp where((AppStaff.StaffStr == StaffApp.nRec)) = tsOk )
      {
        if FoundMarker(mPodr1, StaffApp.Department)
          result := true;
      }
      else
      {
        if FoundMarker(mPodr1, AppStaff.Department)
          result := true;
      }
  }
  else
    result := true;
}

function wWhatStajFinishEdu(cPsnT : comp) : word;
{
  var wStajPsn : word;
  
  wStajPsn := iRunStaj.GetStajYears(cPsnT, 89, dRep);
  if wStajPsn < 1
    result := 14
  else
    if wStajPsn < 4
      result := 15
    else
      result := 16;
}
function wWhatStajDismissCur(cPsnT : comp) : word;
{
  var wStajPsn : word;
  
  wStajPsn := iRunStaj.GetStajYears(cPsnT, 89, dRep);
  if wStajPsn < 1
    result := 17
  else
    if wStajPsn < 3
      result := 18
    else
      result := 0;
}

procedure SetRowSpec(wMode : word);
{
  if isvalid(#Persons)
  {//    ttSpecRK00 = cInst + cSpec + cPsn
/*
, ttSpecRK02 = cInst + cSpec + sFIO + dBorn
  if ( getfirst ttPsnFlags where((Persons.FIO == ttPsnFlags.sFIO and Persons.BornDate == ttPsnFlags.dBorn)) <> tsOk )
*/

/*
    if getfirst ttSpecRK where((  Education.Name       == ttSpecRK.cInst 
                              and Education.Speciality == ttSpecRK.cSpec 
                              and Persons.nRec         == ttSpecRK.cPsn)) <> tsOk
*/
    if getfirst ttSpecRK where
    ((  Education.Name       == ttSpecRK.cInst 
    and Education.Speciality == ttSpecRK.cSpec
    and Persons.FIO          == ttSpecRK.sFIO
    and Persons.BornDate     == ttSpecRK.dBorn)) <> tsOk
    {//if getfirst ttSpecRK
      ClearBuffer(#ttSpecRK);
      ttSpecRK.cPsn      := Persons.nRec;
      ttSpecRK.cInst     := Education.Name;
      ttSpecRK.cSpec     := Education.Speciality;
      ttSpecRK.sFIO      := Persons.FIO;
      ttSpecRK.dBorn     := Persons.BornDate;
      ttSpecRK.sTypePsn  := Persons.isEmployee;
      ttSpecRK.sVidEdu   := iCatFunc.GetCatalogsName(Education.Level);
      ttSpecRK.dBegEdu   := dEduBeg;
      ttSpecRK.dEndEdu   := dEduEnd;
      ttSpecRK.dAppoint  := Persons.AppDate;
      ttSpecRK.dDismiss  := Persons.DisDate;
      ttSpecRK.sInst     := iCatFunc.GetCatalogsLongName(Education.Name); //GetCatalogsName
/*
      if getfirst CatAny where ((Education.Name == CatAny.nRec)) = tsOk
      {
        ttSpecRK.sInst     := CatAny.Name;
        ttSpecRK.sLevelInst:= iCatFunc.GetCatalogsName(CatAny.cParent);
      }
*/
      ttSpecRK.sSpecName := iCatFunc.GetCatalogsName(Education.Speciality);
      ttSpecRK.sSpecCode := iCatFunc.GetCatalogsCode(Education.Speciality);
      if GetFirst AppStaff where((iAppFuncs.GetAppNrec_OnDate(Persons.nRec, dRep) == AppStaff.NRec)) = tsOk
        if getfirst StaffApp where((AppStaff.StaffStr == StaffApp.nRec)) = tsOk
        {
          ttSpecRK.sDeptCode := iCatFunc.GetCatalogsCode(StaffApp.Department);
          if ( trim(ttSpecRK.sDeptCode) = '' )
            ttSpecRK.sDeptCode:= iCatFunc.GetCatalogsName(StaffApp.Department);
          ttSpecRK.sPost     := iCatFunc.GetCatalogsName(StaffApp.Post);
        }
      if ( trim(ttSpecRK.sDeptCode) = '' )
      {
        ttSpecRK.sDeptCode := iCatFunc.GetCatalogsCode(Persons.Department);
        if ( trim(ttSpecRK.sDeptCode) = '' )
          ttSpecRK.sDeptCode:= iCatFunc.GetCatalogsName(Persons.Department);
      }
      ttSpecRK.fStaj := iRunStaj.GetStajYears (Persons.nRec, 89, dRep)
                      +(iRunStaj.GetStajMonths(Persons.nRec, 89, dRep)/12)
                      +(iRunStaj.GetStajDays  (Persons.nRec, 89, dRep)/365);
      insert current ttSpecRK;
    }//if getfirst ttSpecRK
    
    if wMode = 11 or wMode = 17 or wMode = 18
    {
      ttSpecRK.dDismiss  := App8.DismissDate;
//      ttSpecRK.sDissRea  := iCatFunc.GetCatalogsName(App8.cDisReason);
      ttSpecRK.sDissRea  := iCatFunc.GetCatalogsCode(App8.cDisReason);
    }
    if wMode = 12
    {
//      ttSpecRK.dAppoint  := App1.AppointDate;
      //тоже костыль по бруданов мм
      if ( Persons.NRec = comp(000A0000000007E1h) )
        ttSpecRK.dAppoint := date(9, 10, 2018);
    }
    if isvalid(#DogEdu) 
      if isvalid(#VidDogEdu)
        ttSpecRK.sDogEduC  := VidDogEdu.Name + ' №'  + DogEdu.NoDoc + ' от ' + DateToStr(DogEdu.dDoc,'DD.MM.YYYY');
    if wMode = 1 //or wMode = 2 or wMode = 13
    {
//      message(TDoc136.DocNmb);
      var sTCont: string = '';
      if isvalid(#App136)
        sTCont := iCatFunc.GetCatalogsName(App136.cDog);
      ttSpecRK.sDogEduU := sTCont+' №'+TDoc136.DocNmb+' от '+TDoc136.DocDate;
//        iCatFunc.GetCatalogsName(App136.cDog)
//       +' №'+TDoc136.DocNmb
//       +' от '+TDoc136.DocDate
//       +' на период с '+DateToStr(Dog136.ResDate[2],'DD.MM.YYYY')
//       +' по '+DateToStr(Dog136.ResDate[3],'DD.MM.YYYY')
//       +' на сумму '+Education.PaySum
//       ;
/*
      if isvalid(#Dog136)
      {
        ttSpecRK.sDogEduU := 
          iCatFunc.GetCatalogsName(App136.cDog)
         +' №'+Dog136.ResString[1]
         +' от '+DateToStr(Dog136.ResDate[1],'DD.MM.YYYY')
         +' на период с '+DateToStr(Dog136.ResDate[2],'DD.MM.YYYY')
         +' по '+DateToStr(Dog136.ResDate[3],'DD.MM.YYYY')
         +' на сумму '+Education.PaySum;
      }
*/
    }
    if wMode = 10
    {
      ttSpecRK.dEduDegr  := StrToDate(OldOrgD.Code,'DD/MM/YY');
      if isvalid(#BadgeN)
        ttSpecRK.sEduDegr  := iCatFunc.GetCatalogsName(BadgeN.Appoint);
    }
    ttSpecRK.sColunms += ' '+to_char(wMode+4);
    update current ttSpecRK;
  }
}

procedure LocateSetRow(sNameOUT : string; sCodeSpcT: string[100]; iColT : integer; dbVal : double);
{
  if ( iColT <> 13 )
    if not isPsnFirstFlag(iColT)
      exit;

  ClearBuffer(#ttStatRK);
  
  if ( getfirst ttStatRK where ((sNameOUT==ttStatRK.sNameOU and sCodeSpcT==ttStatRK.sCodeSpc)) <> tsOk )
  {
    ttStatRK.sNameOU  := sNameOUT;
    ttStatRK.sCodeSpc := sCodeSpcT;
    insert current ttStatRK;
  }
  ttStatRK.dbVal[iColT] += dbVal;
  update current ttStatRK;
  if wPrintRash = 1
    SetRowSpec(iColT);
}

function isCEdu(_cRecAny: comp) : boolean;
{
  result := false;
  if ( iEClFunc.GetSegName(33, _cRecAny) = 'Целевое обучение')
    result := true;
}

function isArmy(_cRecAny: comp): boolean; cacheable;
{
  result := false;
  if ( pos('призыв', locase(iCatFunc.GetCatalogsName(_cRecAny))) <> 0 )
    result := true;
}

procedure MakeRK;
{
  var isDocCEdu : boolean;
  var isDissEdu : boolean;
  var  dDissEdu : date;
  var    dRep30 : date;
  var    dKanid : date;
  var  iYearEdu : integer;
  var      iCol : integer;

  if ( wToExistFile = 1 )
    if ( message('Очистить страницу отчета от предыдущих данных?', yesNo+Confirmation) <> cmYes )
      exit;

  if (GetMarkerCount(mPodr1) > 0) isFilterPodr:=true else isFilterPodr:=false;
  set dBeg := date(1,11,Year(dRep)-1);
/*
  cRecTopOUV := cRecTopOUS := iCatFunc.GetCatalogsNRec(-24);
  if getfirst CatAny where((cRecTopOUV == CatAny.cParent and sGroupOUV == CatAny.Name)) = tsOk
    set cRecTopOUV:= CatAny.nRec;
  else
  {
    message('Не найден каталог "'+sGroupOUV+'"!',Error);
    exit;
  }
  if getfirst CatAny where((cRecTopOUS == CatAny.cParent and sGroupOUS == CatAny.Name)) = tsOk
    set cRecTopOUS:= CatAny.nRec;
  else
  {
    message('Не найден каталог "'+sGroupOUS+'"!',Error);
    exit;
  }
*/
/*
  cRecDogovor := iCatFunc.GetCatalogsNRec(-133);
  if getfirst CatAny where((cRecDogovor == CatAny.cParent and sDogovor == CatAny.Name)) = tsOk
    set cRecDogovor:= CatAny.nRec;
  else
  {
    message('Не найден вид договора "'+sDogovor+'"!',Error);
    exit;
  }
*/
/*
  cDocCEdu := ExtAttr.AttrId(coEducation,sDocCEdu);
  if cDocCEdu = 0
  {
    message('Не найден внешний атрибут "'+sDocCEdu+'"!',Error);
    exit;
  }
*/
  set cDissEdu := ExtAttr.AttrId(coEducation, sDissEdu);
  if cDissEdu = 0
  {
    message('Не найден внешний атрибут "'+sDissEdu+'"!',Error);
    exit;
  }
/*
  cDissReason := iCatFunc.GetCatalogsNRec(-121);
  if getfirst CatAny where((cDissReason == CatAny.cParent and sDissReason == CatAny.Code)) = tsOk
    set cDissReason:= CatAny.nRec;
  else
  {
    message('Не найдена причина увольнения с кодом "'+sDissReason+'"!',Error);
    exit;
  }
*/

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Формируются данные для Листа 14-к.', 0);

  set dRep30 := To_Date(30, 9, year(dRep));

  if isvalid(#Education)
    _loop Education
    {
      set _cRecPsn := 0;
      if ( Education.Person <> 0 )
        set _cRecPsn := Education.Person
      else 
        if isvalid(#CDoc136)
          set _cRecPsn := CDoc136.Person;
      
      if not isvalid(#persons)
        continue;
/*
      if getfirst CatAny where((Education.Name == CatAny.nRec)) = tsOk
      {
        if CatAny.cParent <> cRecTopOUV and CatAny.cParent <> cRecTopOUS
          continue;
      } else continue;
*/
      if (not NextVisual) break;
/*
      isDocCEdu := false;
      if ExtAttr.ValueExistsId(coEducation,Education.nRec,cDocCEdu)
        set cDocCEduPsn := ExtAttr.coGetAttrID(coEducation,Education.nRec,cDocCEdu);
      if cDocCEduPsn <> comp(0)
        isDocCEdu := true;
*/
      dEduBeg := Education.FromDate;
      dEduEnd := Education.ToDate;
      wCourse := Education.Course;
      cEduAlt := Education.nRec;

      dDissEdu := 0;
      
      if isValid(#CDoc136)
      {
        if isValid(#CDoc236)
          if iChRPD.isConfirmed(CDoc236.nRec)
            if isValid(#Educ236)
            {
              dDissEdu := CDoc236.DREZERVE;
/*
              dDissEdu := Educ236.ToDate; //DREZERVE
              if not iStrFunc.isHitPeriod(dBeg, dRep30, dDissEdu)
                if iStrFunc.isHitPeriod(dBeg, dRep30, CDoc236.DREZERVE)
                  dDissEdu := CDoc236.DREZERVE;
*/
            }
        if isValid(#CDoc236_0)
          if iChRPD.isConfirmed(CDoc236_0.nRec)
            if isValid(#Educ236_0)
            {
              dEduBeg := Educ236_0.FromDate;
              dEduEnd := Educ236_0.ToDate;
              wCourse := Educ236_0.Course;
              cEduAlt := Educ236_0.nRec;
            }
      }
/*
      if ( dDissEdu = 0 )
        if ExtAttr.ValueExistsId(coEducation, Education.nRec, cDissEdu)
          dDissEdu := ExtAttr.dGetAttrID(coEducation, Education.nRec, cDissEdu);
*/
      if ( dDissEdu = 0 )
        if ExtAttr.ValueExistsId(coEducation, Education.nRec, cDissEdu)
          dDissEdu := ExtAttr.dGetAttrID(coEducation, cEduAlt, cDissEdu);

      if not isDept4ReportOnDate(_cRecPsn, dRep) 
        continue;
      
      var sOUName: string = iCatFunc.GetCatalogsLongName(Education.Name);//GetCatalogsName
      var sSpcCod: string = iCatFunc.GetCatalogsCode(Education.Speciality);
      var dPrik136: date = 0;
      
      isDocCEdu := false;
      var isDocUEdu: boolean = false;
      
      var isIncludeEdu: boolean = true;
      
      if isvalid(#CDoc136)
      {
        if isvalid(#PDoc136)
          if isvalid(#TDoc136)
          {
            isDocCEdu := true;
            dPrik136  := TDoc136.DocDate;
            if iStrFunc.isHitPeriod(dBeg, dRep, dPrik136)
            {
              LocateSetRow(sOUName, sSpcCod, 1, 1);
              if iChRPD.isConfirmed(CDoc136.nRec)
              {
                LocateSetRow(sOUName, sSpcCod, 2, 1);
                isDocUEdu := true;
              }
              else
                isIncludeEdu := false;
            }
          }
      }
//      _loop CDoc136
/*
        if iChRPD.isConfirmed(CDoc136.nRec)
        if isvalid(#App136)
        {
          LocateSetRow(sOUName, sSpcCod, 1, 1);
          
          if isDocCEdu
            if Education.FromDate >= dBeg and Education.FromDate <= dRep
              LocateSetRow(iCatFunc.GetCatalogsName(Education.Name),iCatFunc.GetCatalogsCode(Education.Speciality),2,1);
          if Education.FromDate >= dBeg and Education.FromDate <= dRep
            _loop EduAny where((dBeg<<= EduAny.ToDate (noindex) and (EduAny.ToDate <= dRep)))
              if ExtAttr.ValueExistsId(coEducation,EduAny.nRec,cDocCEdu)
                if ExtAttr.coGetAttrID(coEducation,EduAny.nRec,cDocCEdu) <> comp(0)
                  if isPsnFirstFlag(Education.Person,13)
                    LocateSetRow(iCatFunc.GetCatalogsName(Education.Name),iCatFunc.GetCatalogsCode(Education.Speciality),13,1);
        } //if isvalid(#CDoc136) if isvalid(#App136)
*/
      var isDocXEdu: boolean = false;
      
      if isDocCEdu or isCEdu(Education.nRec) or isCEdu(cEduAlt) //isCEdu проверяем 2 раза что бы ничего не потерять
      {
        if ( dDissEdu = 0 )
        {
          if isDocUEdu
          {
            if isValid(#EduBUp)
              _loop EduBUp
              {
                if ( EduBUp.nRec <> cEduAlt )
                  if iStrFunc.isHitPeriod(dBeg, dRep, EduBUp.ToDate)
                  {
                    if isCEdu(EduBUp.nRec)
                      LocateSetRow(sOUName, sSpcCod, 13, 1)
                    else
                      if isValid(#CDocBUp)
                        if iChRPD.isConfirmed(CDocBUp.nRec)
                          LocateSetRow(sOUName, sSpcCod, 13, 1);
                  }
              }
          }

          if  ( /*Education.FromDate*/ dEduBeg < dBeg )// and Education.FromDate > 0 )
          and ( /*Education.ToDate*/   dEduEnd > dRep )//and Education.ToDate   > 0 )
          {
            if ( /*Education.Course*/ wCourse > 1 and wCourse < 7 )
              LocateSetRow(sOUName, sSpcCod, 1+wCourse, 1);
/*
            iYearEdu := year(Sub_Date(dRep30, Education.FromDate)) + 1;
            if iYearEdu > 2 and iYearEdu < 8
              LocateSetRow(iCatFunc.GetCatalogsName(Education.Name),iCatFunc.GetCatalogsCode(Education.Speciality),iYearEdu,1);
*/
          }//if Education.FromDate < dBeg
          if ( dEduEnd < dBeg and dEduEnd > 0 )
          {
            if isPsnFirstFlag(/*Education.Person,*/ 14) //iCol := wWhatStajFinishEdu(Education.Person);
              LocateSetRow(sOUName, sSpcCod, wWhatStajFinishEdu(_cRecPsn), 1);
            if isPsnFirstFlag(/*Education.Person,*/ 17)
              if isvalid(#CDoc8)
                _loop CDoc8
                  if iChRPD.isConfirmed(CDoc8.nRec)
                    if isvalid(#App8)
                    {
                      iCol := wWhatStajDismissCur(_cRecPsn);
                      if ( iCol <> 0 )
                        LocateSetRow(sOUName, sSpcCod, iCol, 1);
                    }
          }//if Education.ToDate < dBeg
        }
        else
//          if iStrFunc.isCrossPeriod(dBeg, dRep, dEduBeg, dEduEnd)
          if ( dEduBeg < dRep and dEduEnd > dBeg )
            if iStrFunc.isHitPeriod(dBeg, dRep30, dDissEdu)
              LocateSetRow(sOUName, sSpcCod, 8, 1);
        if isIncludeEdu
        if ( iStrFunc.isHitPeriod(dBeg, dRep, dEduEnd) and dDissEdu = 0 )
        {
          LocateSetRow(sOUName, sSpcCod, 9, 1);
          
          if isvalid(#CDoc8)
            _loop CDoc8
              if iChRPD.isConfirmed(CDoc8.nRec)
                if isvalid(#App8)
                  if ( dEduEnd < App8.DismissDate and isArmy(App8.cDisReason) )
                    LocateSetRow(sOUName, sSpcCod, 11, 1);
//                  if ( Education.ToDate < App8.DismissDate and App8.cDisReason = cDissReason )
          
          //20181205
          var isDone16: boolean = false;
          //костыль по бруданов мм
          //в базе физически 2 человека
          //нужное образование у одного а дата приема на работу у другого
          //что бы не замедлять расчет ненужными проверками для других сотрудников
          //делаем просто костыль
          if ( Persons.NRec = comp(000A0000000007E1h) )
            //проверяем дату приема на работу на вхождение что бы в другом периоде не попадал
            if ( date(9, 10, 2018) <= dRep )
            {
              LocateSetRow(sOUName, sSpcCod, 12, 1);
              isDone16 := true;
            }
          if isvalid(#App1)
          _loop App1
          {
            if not isDone16
              if isvalid(#CDoc1)
                if iChRPD.isConfirmed(CDoc1.nRec)
                  if iAppFuncs.GetCharacterAppHist(App1.NRec, App1.AppointDate) = 'Постоянно'
                  {
                    LocateSetRow(sOUName, sSpcCod, 12, 1);
                    isDone16 := true;
                  }
            if not isDone16
              if ( ( App1.KindApp = 0 ) or ( iCatFunc.GetCatalogsName(App1.KindApp) = 'На неопределенный срок' ) )
                if isvalid(#AppHist)
                  if ( iCatFunc.GetCatalogsName(AppHist.cRez2) = 'Постоянно' )
                  {
                    if ( AppHist.CodOper = 1 ) 
                    {
                      LocateSetRow(sOUName, sSpcCod, 12, 1);
                      isDone16 := true;
                    }
                    else
                    {
                      set _cAppO := iAppFuncs.GetAppNrec_OnDate(_cRecPsn, Sub_Day(App1.AppointDate, 1));
                      if isValid(#AppO)
                        if ( ( AppO.KindApp <> 0 ) and ( iCatFunc.GetCatalogsName(AppO.KindApp) <> 'На неопределенный срок' ) )
                        {
                          LocateSetRow(sOUName, sSpcCod, 12, 1);
                          isDone16 := true;
                        }
                    }
                  }
          }
/*
          if isvalid(#App1)
            if isvalid(#AppHist)
              if ( iCatFunc.GetCatalogsName(Persons.JobNature) = 'Постоянно' )
                if ( ( not isvalid(#CDoc1) ) or ( iChRPD.isConfirmed(CDoc1.nRec) ) )
                  LocateSetRow(sOUName, sSpcCod, 12, 1);
*/
/*
          if isvalid(#CDoc1)
          {
            _loop CDoc1
              if iChRPD.isConfirmed(CDoc1.nRec)
                if isvalid(#App1)
                  if ( Education.ToDate < App1.AppointDate )
                    LocateSetRow(sOUName, sSpcCod, 12, 1);
          }
*/
        }
        if iCatFunc.GetCatalogsCode(Education.Level) = sAspirant
          if isvalid(#Badge)
            if isvalid(#OldOrgD)
              _loop OldOrgD
              {
                dKanid := StrToDate(OldOrgD.Code,'DD/MM/YY');
                if iStrFunc.isHitPeriod(dBeg, dRep, dKanid)// (dKanid >= dBeg and dKanid <= dRep)// and (Education.ToDate >= dBeg and Education.ToDate <= dRep)
                  LocateSetRow(sOUName, sSpcCod, 10, 1);
              }
      }//if isDocCEdu
    }
    StopVisual;
}

function isDataRK : boolean;
{
  if isvalid(#ttStatRK)
    result := true
  else
    result := false;
}

procedure FillSpc;
{
  var sCodeSpcT : string[100] = '';
  var i : integer = 2;
  if xlSetActiveSheetByName('УЗиНП')
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Синхронизирую список специальностей для Листа 14-к.', 0);
    do
    {
      if (not NextVisual) break;
      xlGetCellValue(i,3,sCodeSpcT);
      if trim(sCodeSpcT) <> ''
      {
        clearbuffer(#tt14SpecRK);
        tt14SpecRK.sCodeSpc := trim(sCodeSpcT);
        tt14SpecRK.iRow := i;
        insert current tt14SpecRK;
      }
      i++;
    } while trim(sCodeSpcT) <> '';
    StopVisual;
  }
}
procedure FillOU;
{
  var sOUT : string = '';
  var i : integer = 2;
  if xlSetActiveSheetByName('Перечни')
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Синхронизирую список ОУ для Листа 14-к.', 0);
    do
    {
      if (not NextVisual) break;
      xlGetCellValue(i, 1, sOUT);
      if ( trim(sOUT) <> '' )
      {
        clearbuffer(#tt14OURK);
        tt14OURK.sOU := trim(sOUT);
        insert current tt14OURK;
      }
      i++;
    } while ( trim(sOUT) <> '' );
    i := 2;
    do
    {
      if (not NextVisual) break;
      xlGetCellValue(i, 3, sOUT);
      if ( trim(sOUT) <> '' )
      {
        clearbuffer(#tt14OURK);
        tt14OURK.sOU := trim(sOUT);
        insert current tt14OURK;
      }
      i++;
    } while ( trim(sOUT) <> '' );
    StopVisual;
  }
}

procedure SetCodeSpcCell(iRowT : integer);
{
  if getfirst tt14SpecRK where((ttStatRK.sCodeSpc == tt14SpecRK.sCodeSpc)) = tsOk
  {
    if xlSetActiveSheetByName('УЗиНП')
      xlCopyToBuff(tt14SpecRK.iRow,3,tt14SpecRK.iRow,3);
    if xlSetActiveSheetByName('14-к')
      xlPasteAllFromBuff(iRowT,3,iRowT,3);
  }
}


procedure PrintRK;
{
  var i : integer;
  var iRow : integer = 7;

  if isDataRK
  {
    FillSpc;
    FillOU;
    if xlSetActiveSheetByName('14-к')
    {
      // Зачистка от предыдущих данных
      if ( wToExistFile = 1 )
        if xlCreateMatrix(500,500)
          if xlWriteMatrixToExcel(1,1) {}
      StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Выгружаю данные для Листа 14-к в Excel.', 0);
      TOA.Bind(0);
      xlSetCellStringValue(Trim(TOA1.GetNaming.GetFullName()),2,3,2,3);
////    xlSetCellStringValue(DateToStr(dRep,'DD.MM.YYYY'),3,3,3,3); // в представленном заказчиком файле такая дата красная.
      xlSetCellDateValue(dRep,3,3,3,3);
      _loop ttStatRK  ordered index ttStatRK01
      {
        if (not NextVisual) break;
        xlSetCellStringValue(ttStatRK.sNameOU, iRow,2,iRow,2); 
        SetCodeSpcCell(iRow);
        for(i:=1;i<=18;i++)
          xlSetCellNumberValue(ttStatRK.dbVal[i],iRow,4+i,iRow,4+i); 
        iRow++;
      }
  
      StopVisual;
    }
  }
}

procedure SaveRK;
{
  iUDR.SaveMarker('RKS14_mPodr1', mPodr1);
  iUDR.SaveDate  ('RKS14_dRep', dRep);
  iUDR.SaveWord  ('RKS14_wToExistFile', wToExistFile);
  iUDR.SaveString('RKS14_sToExistFile', sToExistFile);
  iUDR.SaveWord  ('RKS14_wPrintRash', wPrintRash);
  DoneMarker(mPodr1, '');
}
procedure ClearRK;
{
  delete all from ttStatRK;
}
procedure initRK;
{
  set dRep := iUDR.ReadDate('RKS14_dRep');
  if dRep = 0
    set dRep := To_Date(31,10,Year(Cur_Date));

  set wToExistFile := iUDR.ReadWord('RKS14_wToExistFile');
  if wToExistFile = 1 
    ToggleFieldVisible(#sToExistFile,true )
  else
    ToggleFieldVisible(#sToExistFile,false);

  set sToExistFile := iUDR.ReadString('RKS14_sToExistFile');

  set wPrintRash := iUDR.ReadWord('RKS14_wPrintRash');

  mPodr1      := iUDR.ReadMarker('RKS14_mPodr1');
  set sPodr1      := sSetPodrName(mPodr1);
}

function isCheckRepParam(isStayAlone : boolean) : boolean;
{
  result := false;
  if dRep = 0
  {if isStayAlone message('Не задана дата!'); exit;}
  if Day(dRep) <> 30 and Month(dRep) <> 10
  {
    if isStayAlone 
      if ( message('Некорректно задана дата!'+chr(13)+'Дата формирования отчета - 30 октября.'+chr(13)+'Продолжить?', Information+yesNo ) <> cmYes )
        exit;
  }
  if wToExistFile = 1
  if not ExistFile(sToExistFile)
  {if isStayAlone message('Ошибка открытия файла!'); exit;}
  result := true;
}
//++++++++++++++++++++++++++++++++++++++++++++++++
window WinRKParamEx 'Параметры формирования. Лист 14-к.' Gray;
  show at (,,95,11);
Screen sEx(,,sci1Esc);
  fields
    dRep   ('Дата формирования'): {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    sPodr1 ('Выбранные подразделения',hcStaffAppDepartment,sci13Esc): {Font = {BackColor = if(sPodr1 = 'Не выбраны подразделения', ColorNeed, 0)}},Protect, PickButton ;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
<< 'Параметры отчета'

 `Дата формирования       `.@@@@@@@@@@@
 `Подразделения для отчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   <. ~С~охранить .>                                                        <. ~З~акрыть .>
>>
end;
HandleEvent
  cmOK:
  {
    SaveRK;
    initRK;
    if not isCheckRepParam(true)
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
  cmCancel:
  {
    SaveRK;
    CloseWindowEx(CurWindow,cmCancel);
  }
end;
end;//WinRKParamEx
//++++++++++++++++++++++++++++++++++++++++++++++++
//++++++++++++++++++++++++++++++++++++++++++++++++
window WinRKParam 'Параметры формирования. Лист 14-к.' Gray;
  show at (,,95,11);
Screen s1(,,sci1Esc);
  fields
    dRep   ('Дата формирования'): {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    sPodr1 ('Выбранные подразделения',hcStaffAppDepartment,sci13Esc): {Font = {BackColor = if(sPodr1 = 'Не выбраны подразделения', ColorNeed, 0)}},Protect, PickButton ;
    wPrintRash  ('Печать расшифровки'), noprotect;
    wToExistFile('Добавить в существующий файл'), noprotect;
    sToExistFile('Добавить в существующий файл',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sToExistFile = '', ColorNeed, 0)}},protect;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
<< 'Параметры отчета'

 `Дата формирования       `.@@@@@@@@@@@
 `Подразделения для отчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   [.] Печать расшифровки`

   [.] Добавить в существующий файл          `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   <. ~С~формировать .>                                                     <. ~З~акрыть .>
>>
end;

HandleEvent
  cmOK:
  {
    if not isCheckRepParam(true)
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
end;
end;//WinRKParam
//++++++++++++++++++++++++++++++++++++++++++++++++

function OpenNewRKS : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExistRKS : boolean;
{
  result := false;
  if xlOpenExcel(true)
  {
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlOpenWorkBook(sToExistFile)
      result := true;
  }
}

function SetParamRK : boolean;
{
  result := false;
  if RunWindowModal(WinRKParam)=cmDefault
    result := true;
}

function isCodeSpcCell(_sCodeSpc: string): boolean; cacheable;
{
  result := false;
  if ( getfirst tt14SpecRK where((_sCodeSpc == tt14SpecRK.sCodeSpc)) = tsOk )
    result := true;
}
function isOUCell(_sOU: string): boolean; cacheable;
{
  result := false;
  if ( getfirst tt14OURK where((_sOU == tt14OURK.sOU)) = tsOk )
    result := true;
}

procedure PrintRash;
{
  var lLine : longint;
  var lRB, lRE, lCB, lCE : longint = 1;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Печать расшифровки.', 0);
  lRB := lRE := 2;
  lCB := 1;
  lLine:=0;
  xlMergeCells(1,1,1,4);
  xlSetCellStringValue('Расшифровка листа 14-к. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
  if isvalid(#ttSpecRK)
  {
    lCE := 0;
    //'+chr(10)+'
    lCE++; xlSetCellStringValue('№пп',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Тип'+chr(10)+'карточки',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'приема'+chr(10)+'на работу',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'увольнения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Причина'+chr(10)+'увольнения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Вид'+chr(10)+'образования',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'поступления',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'окончания',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Наименование учебного заведения',lRE,lCE,lRE,lCE);
//    lCE++; xlSetCellStringValue('Уровень'+chr(10)+'учебного'+chr(10)+'заведения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Наименование специальности по диплому',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Код'+chr(10)+'специальности'+chr(10)+'по диплому',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Подразделение'+chr(10)+'код',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Должность',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Ученая степень',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'присвоения',lRE,lCE,lRE,lCE);
//    lCE++; xlSetCellStringValue('Договор с ОУ',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Ученический целевой договор',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Стаж'+chr(10)+'работы'+chr(10)+'на предприятии',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Столбцы',lRE,lCE,lRE,lCE);
    lRE++;
    _loop ttSpecRK ordered index ttSpecRK01
    {
      if (not NextVisual) break;
      lCE := 0;//datetostr(dRep,'DD.MM.YYYY')
      lCE++; xlSetCellStringValue(++lLine                                       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sFIO                                 ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sTypePsn                             ,lRE,lCE,lRE,lCE);
      lCE++; if ( ttSpecRK.dAppoint <> 0 ) xlSetCellDateValue(ttSpecRK.dAppoint ,lRE,lCE,lRE,lCE);
      lCE++; if ( ttSpecRK.dDismiss <> 0 ) xlSetCellDateValue(ttSpecRK.dDismiss ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sDissRea                             ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sVidEdu                              ,lRE,lCE,lRE,lCE);
      lCE++; if ( ttSpecRK.dBegEdu <> 0 )  xlSetCellDateValue(ttSpecRK.dBegEdu  ,lRE,lCE,lRE,lCE);
      lCE++; if ( ttSpecRK.dEndEdu <> 0 )  xlSetCellDateValue(ttSpecRK.dEndEdu  ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sInst                                ,lRE,lCE,lRE,lCE);
             if ( not isOUCell(ttSpecRK.sInst) )
               xlSetFontColor(-16776961,lRE,lCE,lRE,lCE);
//      lCE++; xlSetCellStringValue(ttSpecRK.sLevelInst                           ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sSpecName                            ,lRE,lCE,lRE,lCE);
             if ( not isCodeSpcCell(ttSpecRK.sSpecCode) )
               xlSetFontColor(-16776961,lRE,lCE,lRE,lCE);
      lCE++; xlSetNumberFormat('@'                                              ,lRE,lCE,lRE,lCE);
             xlSetCellStringValue(ttSpecRK.sSpecCode                            ,lRE,lCE,lRE,lCE);
             if ( not isCodeSpcCell(ttSpecRK.sSpecCode) )
               xlSetFontColor(-16776961,lRE,lCE,lRE,lCE);
      lCE++; xlSetNumberFormat('@'                                              ,lRE,lCE,lRE,lCE);
             xlSetCellStringValue(ttSpecRK.sDeptCode                            ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sPost                                ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sEduDegr                             ,lRE,lCE,lRE,lCE);
      lCE++; if ( ttSpecRK.dEduDegr <> 0 ) xlSetCellDateValue(ttSpecRK.dEduDegr ,lRE,lCE,lRE,lCE);
//      lCE++; xlSetCellStringValue(ttSpecRK.sDogEduC                             ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttSpecRK.sDogEduU                             ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(round(ttSpecRK.fStaj,2)                       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetNumberFormat('@'                                               ,lRE,lCE,lRE,lCE);
             xlSetCellStringValue(ttSpecRK.sColunms                              ,lRE,lCE,lRE,lCE);
      lRE++;
    }
  }
  lRE--;
//  xlWrapText(lRB,lCB,lRB,lCE);
  xlAutoFit(lRB,lCB,lRE,lCE);
  xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
  StopVisual;
}

procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  initRK;

  if isStayAlone
    if SetParamRK
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);

  if isDoRep
  {
    MakeRK;
    if isDataRK
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNewRKS  ;}
        if wToExistFile = 1 {isOkFile := OpenExistRKS;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        PrintRK;

        if (wPrintRash = 1) and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='14-к' break;
          }
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 14-к'); 
          xlSetActiveSheet(i);
          PrintRash;
        }

        xlSetActiveSheetByName('14-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }
    else if isStayAlone message('Нет данных для отчета.');
    if VisualizationActive
      StopVisual;
  }
  SaveRK;
  ClearRK;
  closeinterface(cmDefault);
}
//++++++++++++++++++++++++++++++++++++++++++++++++
//--------------------------------------------------------
function bSetRepParam : boolean;  
{
  result := false;
  if RunWindowModal(WinRKParamEx)=cmDefault
    result := true;
}//function bSetRepParam
Function GetReportName: String;
{
  GetReportName := '#(GPNam) (ЭМ)';
}
function GetPriority : Integer;
{
  GetPriority := 14;
}
procedure initRKStatRepParam;
{
  initRK;
}
function dRepOnDateParam : date;
{
  dRepOnDateParam := dRep;
}
//--------------------------------------------------------
handleevent
  cmInit:
  {
    PrintRepPage(true);
  }
  cmPick:
  {
    case CurField of
      #sPodr1:
        if (RunInterface('PICKCATALOGEX', -11, 0, Comp(100), mPodr1) = cmDefault)
          set sPodr1 := sSetPodrName(mPodr1);
      #sToExistFile:
      {
        set sToExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sPodr1:      {ClearMarker(mPodr1);      set sPodr1      := sSetPodrName(mPodr1);}
      #sToExistFile:{set sToExistFile:='';}
    end;
  }
  cmCheckField:
  {
    case CurField of
      #wToExistFile:
      {
        if wToExistFile = 1 
          ToggleFieldVisible(#sToExistFile,true )
        else
          ToggleFieldVisible(#sToExistFile,false);
      }
    end;
  }
end;


End.
