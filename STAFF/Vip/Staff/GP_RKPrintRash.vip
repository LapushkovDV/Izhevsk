/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*                Лист 1-К "Сведения о списочной численности работников в разрезе                  *
*                категорий и возрастных групп персонала" (ЭМ)"                                    *
*                печать расшифровки отчета                                                        *
* Контур/Модуль: Кадры                                                                            *
* Примечание:    Отчеты пользователя                                                              *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#361          |26/07/17|Потапов А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include RunStaj.vih
#include CatFunc.vih
#include StrFunc.vih
#include GP_RKPrintRash.vih
#include ExtAttr.vih

interface GP_RKPrintRash; 

table struct ttRKRash // for sort
(
  sFio : string
, sTabn: string
, sBorn: string
, sAge : string
, wAge : word
, sApp : string
, dApp : date
, sStaj: string
, sCPdr: string
, sNPdr: string
, sPost: string
, sKat : string
, sTKat: string
, sViPr: string
, sSovm: string
, dDiss: date
, isErr: boolean
, fAge : double
, fStaj: double
)
with index
(
//  ttRKRash01 = sTKat + sKat + sFio
  ttRKRash01 = isErr + sFio
)
;

const
#include Excel.inc;
end;

var
  iCatFunc : CatalogsFunctions;
  iRunStaj : Runstaj;
  iStrFunc : StringFunctions;
  cAppV    : comp;
#include ExtAttr.var

create view
var
  __cAppV: comp;
  __cKAU : comp;
from
  appointments
, persons
, staffstruct
, KlKatego
, ttRKRash (ttRKRash01)
, LSchet
, SPKAU
where
((
    __cAppV                 == appointments.nrec
and appointments.StaffStr   == staffstruct.nrec
and staffstruct.empcategory == klkatego.nrec 
and appointments.person     == persons.nrec
and appointments.cAddnRec2  == LSchet.nRec
and LSchet.SOVM             == KLSOVM.SOVM
and __cKAU == SPKAU.nRec
))
;

procedure RKRash1(mRash : TPtr; mRashErr : TPtr; sHead : string; dRep : date);
{
  var kol, i, lLine : longint;
  var lRB, lRE, lCB, lCE : longint = 1;
  var sAgeT: string;
  var dAge : date;
  var wDays, wMonths, wYears : word;


  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Печать расшифровки.', 0);
  kol := GetMarkerCount(mRash);
  i   := lLine := 0;
  lRB := lRE := 2;
  lCB := 1;
  xlMergeCells(1,1,1,4);
  xlSetCellStringValue('Расшифровка листа '+sHead+'. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
  while i < kol
  {
    GetMarker(mRash, i++, cAppV);
    set __cAppV := cAppV; //for mssql only. directly from GetMarker don`t work

    if isvalid(#appointments)
    if isvalid(#staffstruct)
    if isvalid(#klkatego)
    if isvalid(#persons)
    if isvalid(#LSchet)
    {
      if (not NextVisual) break;
      clearbuffer(#ttRKRash);
      ttRKRash.sFio  := Persons.FIO;
      ttRKRash.sTabn := GetStrTabN(Persons.TabNmb, Persons.StrTabN);
      ttRKRash.sBorn := datetostr(Persons.BornDate,'DD.MM.YYYY');
      //--------------------------
      wMonths := Months_Between(dRep, Persons.BornDate);
      dAge    := add_months(Persons.BornDate, wMonths);
      if (dAge > dRep)
      {
        wMonths--;
        dAge  := sub_months(dAge, 1);
      }
      wYears  := DivI(wMonths, 12);
      wMonths := wMonths mod 12;
      wDays   := To_Days(Sub_Date(dRep, dAge));
      sAgeT   := if(wYears  <> 0, string(wYears )+' '+iStrFunc.DeclYMD(wYears,  ymdYears) +' ', '')
                +if(wMonths <> 0, string(wMonths)+' '+iStrFunc.DeclYMD(wMonths, ymdMonths)+' ', '') 
                +if(wDays   <> 0, string(wDays  )+' '+iStrFunc.DeclYMD(wDays,   ymdDays)      , '') ;
      //-------------------------
      ttRKRash.fAge  := wYears + (wMonths/12) + (wDays/365); 
      ttRKRash.fStaj := iRunStaj.GetStajYears (Persons.nRec, 89, dRep)
                      +(iRunStaj.GetStajMonths(Persons.nRec, 89, dRep)/12)
                      +(iRunStaj.GetStajDays  (Persons.nRec, 89, dRep)/365);
      //-------------------------
      ttRKRash.sAge  := sAgeT;
      ttRKRash.wAge  := wYears;
      ttRKRash.sApp  := datetostr(Persons.AppDate,'DD.MM.YYYY');
      ttRKRash.dApp  := Persons.AppDate;
      ttRKRash.sStaj := iRunStaj.RunStrStaj(Persons.nRec, 89, dRep);
      ttRKRash.sCPdr := iCatFunc.GetCatalogsCode(StaffStruct.Department);
      ttRKRash.sNPdr := iCatFunc.GetCatalogsName(StaffStruct.Department);
      ttRKRash.sPost := iCatFunc.GetCatalogsName(StaffStruct.Post);
      ttRKRash.sKat  := KlKatego.NaiKat;
      ttRKRash.sTKat := iCatFunc.GetCatalogsName(StaffStruct.cInf3);
      if ( trim(ttRKRash.sTKat) = '' )
        ttRKRash.sTKat := iCatFunc.GetCatalogsName(Appointments.cRef3);
      ttRKRash.isErr := false;
      set __cKAU := oExtAttr.coGetAttr(coCatalogs, StaffStruct.Department, 'Вид производства');
      if isvalid(#SPKAU)
        ttRKRash.sViPr := SPKAU.Code;
//        ttRKRash.sViPr := to_char(oExtAttr.coGetAttr(coStaffStruct, StaffStruct.nRec, 'Вид производства'));
      ttRKRash.dDiss := Persons.DISDATE;
      if isvalid(#KLSOVM)
        ttRKRash.sSovm := KLSOVM.NSOVM;
      insert current ttRKRash;
    }
  }
  kol := GetMarkerCount(mRashErr);
  i := 0;
  while i < kol
  {
    GetMarker(mRashErr, i++, cAppV);
    set __cAppV := cAppV; //for mssql only. directly from GetMarker don`t work

    if isvalid(#appointments)
    if isvalid(#staffstruct)
    if isvalid(#klkatego)
    if isvalid(#persons)
    if isvalid(#LSchet)
    {
      if (not NextVisual) break;
      clearbuffer(#ttRKRash);
      ttRKRash.sFio  := Persons.FIO;
      ttRKRash.sTabn := GetStrTabN(Persons.TabNmb, Persons.StrTabN);
      ttRKRash.sBorn := datetostr(Persons.BornDate,'DD.MM.YYYY');
      //--------------------------
      wMonths := Months_Between(dRep, Persons.BornDate);
      dAge    := add_months(Persons.BornDate, wMonths);
      if (dAge > dRep)
      {
        wMonths--;
        dAge  := sub_months(dAge, 1);
      }
      wYears  := DivI(wMonths, 12);
      wMonths := wMonths mod 12;
      wDays   := To_Days(Sub_Date(dRep, dAge));
      sAgeT   := if(wYears  <> 0, string(wYears )+' '+iStrFunc.DeclYMD(wYears,  ymdYears) +' ', '')
                +if(wMonths <> 0, string(wMonths)+' '+iStrFunc.DeclYMD(wMonths, ymdMonths)+' ', '') 
                +if(wDays   <> 0, string(wDays  )+' '+iStrFunc.DeclYMD(wDays,   ymdDays)      , '') ;
      //-------------------------
      ttRKRash.fAge  := wYears + (wMonths/12) + (wDays/365); 
      ttRKRash.fStaj := iRunStaj.GetStajYears (Persons.nRec, 89, dRep)
                      +(iRunStaj.GetStajMonths(Persons.nRec, 89, dRep)/12)
                      +(iRunStaj.GetStajDays  (Persons.nRec, 89, dRep)/365);
      //-------------------------
      ttRKRash.sAge  := sAgeT;
      ttRKRash.wAge  := wYears;
      ttRKRash.sApp  := datetostr(Persons.AppDate,'DD.MM.YYYY');
      ttRKRash.dApp  := Persons.AppDate;
      ttRKRash.sStaj := iRunStaj.RunStrStaj(Persons.nRec, 89, dRep);
      ttRKRash.sCPdr := iCatFunc.GetCatalogsCode(StaffStruct.Department);
      ttRKRash.sNPdr := iCatFunc.GetCatalogsName(StaffStruct.Department);
      ttRKRash.sPost := iCatFunc.GetCatalogsName(StaffStruct.Post);
      ttRKRash.sKat  := KlKatego.NaiKat;
      ttRKRash.sTKat := iCatFunc.GetCatalogsName(StaffStruct.cInf3);
      if ( trim(ttRKRash.sTKat) = '' )
        ttRKRash.sTKat := iCatFunc.GetCatalogsName(Appointments.cRef3);
      ttRKRash.isErr := true;
      set __cKAU := oExtAttr.coGetAttr(coCatalogs, StaffStruct.Department, 'Вид производства');
      if isvalid(#SPKAU)
        ttRKRash.sViPr := SPKAU.Code;
      ttRKRash.dDiss := Persons.DISDATE;
      if isvalid(#KLSOVM)
        ttRKRash.sSovm := KLSOVM.NSOVM;
      insert current ttRKRash;
    }
  }
  if isvalid(#ttRKRash)
  {
    lCE := 0;
    var lBeginError, lBegin : longint = 0;
    lCE++; xlSetCellStringValue('№ п/п',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Вид работы',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Таб. №',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата рождения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Возраст',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Полных'+chr(10)+'лет',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Возраст'+chr(10)+'в десятичных'+chr(10)+'дробях',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата трудо-устр.',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'увольнения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Стаж',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Стаж'+chr(10)+'в десятичных'+chr(10)+'дробях',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Код',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('№ подраз'+chr(10)+'деления',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Подразделение',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Профессия/должность',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Категория',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Доп.характеристика',lRE,lCE,lRE,lCE);
//    lRE++;
    lBegin := ++lRE;
    var lRecRep: longint = 0;
    _loop ttRKRash
      lRecRep++;
    if (not xlCreateMatrix(lRecRep, lCE))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    #define FrmCl lRE, ++lCE
    lRE := 1;
    _loop ttRKRash ordered index ttRKRash01
    {
      if (not NextVisual) break;
      lCE := 0;
      xlStWriteToMatrix(#FrmCl, ++lLine);// lCE++; xlSetCellStringValue(++lLine       ,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sSovm);//lCE++; xlSetCellStringValue(ttRKRash.sSovm,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sTabn);//lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttRKRash.sTabn,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sFio); //lCE++; xlSetCellStringValue(ttRKRash.sFio ,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sBorn);//lCE++; xlSetCellStringValue(ttRKRash.sBorn,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sAge); //lCE++; xlSetCellStringValue(ttRKRash.sAge ,lRE,lCE,lRE,lCE);
      xlDoWriteToMatrix(#FrmCl, ttRKRash.wAge); //lCE++; xlSetCellStringValue(ttRKRash.wAge ,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, trunc(ttRKRash.fAge, 2)); //lCE++; xlSetCellStringValue(ttRKRash.wAge ,lRE,lCE,lRE,lCE);
//    lCE++; xlSetCellStringValue(ttRKRash.sApp ,lRE,lCE,lRE,lCE);
      if ( ttRKRash.dApp <> 0 )
        xlDtWriteToMatrix(#FrmCl, ttRKRash.dApp)  //xlSetCellDateValue(ttRKRash.dApp  ,lRE,lCE,lRE,lCE);
      else
        ++lCE;
      if ( ttRKRash.dDiss <> 0 )
        xlDtWriteToMatrix(#FrmCl, ttRKRash.dDiss)//;//xlSetCellDateValue(ttRKRash.dDiss ,lRE,lCE,lRE,lCE);
      else
        ++lCE;
      xlStWriteToMatrix(#FrmCl, ttRKRash.sStaj);//lCE++; xlSetCellStringValue(ttRKRash.sStaj,lRE,lCE,lRE,lCE);
      xlDoWriteToMatrix(#FrmCl, trunc(ttRKRash.fStaj, 2));//lCE++; xlSetCellStringValue(ttRKRash.sStaj,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sViPr);//lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttRKRash.sViPr,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sCPdr);//lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttRKRash.sCPdr,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sNPdr);//lCE++; xlSetCellStringValue(ttRKRash.sNPdr,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sPost);//lCE++; xlSetCellStringValue(ttRKRash.sPost,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sKat); //lCE++; xlSetCellStringValue(ttRKRash.sKat ,lRE,lCE,lRE,lCE);
      xlStWriteToMatrix(#FrmCl, ttRKRash.sTKat);//lCE++; xlSetCellStringValue(ttRKRash.sTKat,lRE,lCE,lRE,lCE);
      if ttRKRash.isErr
        if ( lBeginError = 0 )
          lBeginError := lRE + 2;
/*
      if (ttRKRash.isErr)
        xlSetFontColor(-16776961, lRE,1,lRE,lCE);
*/
      lRE++;
    }
    lRE := lBegin + (lRE-2);
    xlSetNumberFormat('@', lBegin,  3, lRE,  3);
    xlSetNumberFormat('# ##0,00;-# ##0,00;-', lBegin,  8, lRE,  8);
    xlSetNumberFormat('# ##0,00;-# ##0,00;-', lBegin, 12, lRE, 12);
    xlSetNumberFormat('@', lBegin, 13, lRE, 14);
    if ( lBeginError <> 0 )
      xlSetFontColor(-16776961, lBeginError, 1, lRE, lCE);
    if (not xlWriteMatrixToExcel(lBegin,1))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;
/*
    xlSetCellStringValue('lBeginError='+lBeginError+' lBegin='+lBegin, lRE+2, 1, lRE+2, 1);
    xlSetCellStringValue('mRash='+GetMarkerCount(mRash), lRE+3, 1, lRE+3, 1);
    xlSetCellStringValue('mRashErr='+GetMarkerCount(mRashErr), lRE+4, 1, lRE+4, 1);
    xlSetCellStringValue('Версия 20180621 1740', lRE+5, 1, lRE+5, 1);
*/
  }
  xlWrapText(lRB,lCB,lRB,lCE);
  xlAutoFit(lRB,lCB,lRE,lCE);
  xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
  StopVisual;
}
end.