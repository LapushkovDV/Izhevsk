/*************************************************************************************************\
* Наименование: Интерфейс редактирования РПД 35 "Направление на обучение"                         *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Документы / Все приказы по персоналу                                                *
* Примечание:                                                                                     *
* Добавлены поля "Дата аттестации", "Время аттестации", "Преподаватель", "График занятий"         *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#173          |22/06/17|Тищенко Р.Н.             |НПО Энергомаш                    *
* Разработка  |#334          |18/03/18|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#2099         |18/03/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/

/*
В форме используются подписанты со следующими ролями:

1. Роль "Ответственный":
организовать обучение ...

2. Роль "Проверяющее лицо":
Контроль за исполнением возложить на ...

3. Роль "Утверждающее лицо":
Подпись под приказом ...
*/
#component "Z_STAFFORDERS"

#include ChoiseYourPersons.vih
#include GP_RepLaborContract.vih
#include CatFunc.vih
#doc
Направление на обучение
<p>#334 в РПД 35 и РПД 135 необходимо добавить колонку с выбором вида назначения по работнику (аналогично как в РПД-5).
<p>#2099 При выборе работника контролировать наличие совмещений
#end

alter interface RPD_35 (fix 'Добавление доп.полей в РПД 35');

  overload
    procedure IRPD_Base.EnableDisable;
    function GetFirstLschet(c: comp): boolean;
  end;

  create view
    from
       synonym Persons LeadPersons
      ,synonym ContDoc ContDocC
      ,synonym Catalogs EduModeCat
      ,synonym Catalogs EduQualTypeCat
      ,synonym Education EducationC
      ,synonym Appointments  Appointments_Sovm

    where ((
          Education.cInf2  == LeadPersons.NRec
      and Education.Mode   == EduModeCat.NRec
      and Education.cQualType == EduQualTypeCat.Nrec
      and nRecOrder == ContDocC.cPart
      and ContDocC.NRec == EducationC.cContDoc
      and ContDoc.Person == Appointments_Sovm.Person
      and 3 == Appointments_Sovm.LPrizn
    ))
  ;
  //--------------------------------
  OverLoadFormats brPsn;
  overloadFormats scrDet35;
  //--------------------------------

  var
    viCYPersons: ChoiseYourPersons;
    viCatFunc: CatalogsFunctions;


  browse brPsn  (, hcStaffWinPr, sci1378Esc);
  show at (,,,4) fixed_y;
  table ContDoc;
    fields
      ContDoc.wAttrDoc2 'Вид назначения'('Основное назначение или совмещение',, sci178Esc):
      [list 'основное назначение', 'совмещение'], [15], noautosize, protect;
      fullNamePodr  'Подразделение'
            ('Подразделение', hcStaffWinPr, ): [25], protect;
      Persons.FIO       'ФИО'
            ('Фамилия имя отчество', hcStaffWinPr, ): [28], protect;
      [Sovm] IF(IsValidall(#Appointments_Sovm),'V','') 'С' ('Признак наличия совмещения',,sci178Esc):[1],Protect,NoDel;
      [sTabNmb] if (Appointments.lPrizn = 0, GetStrTabn(Persons.TabNmb,Persons.StrTabn), GetStrTabn(Appointments.AppTabNmb, Appointments.StrTabN))
                          'Табельный №' ('Табельный номер'): [12], skip;
      Catalogs.Name    'Должность'
            ('Должность (из основного назначения или совмещения - для увольнения совместителей)' , hcStaffWinPr) :[15], skip;
      PersOrderState          'Исполнение'  ('Исполнение', hcStaffWinPr): [12], skip,
        { font = {Color = if ( isValid(#ContDoc) and (TitleDoc.wStatus <> 1) and (ContDoc.wYearPr = 0 or ContDoc.wYearPr = 3) and isValid(#AllMemo), ColorSysRed, 0)} };
  end;

  screen scrDet35 (, hcStaffWinPr, scStaffMyPnl);
    table Education;
    fields
      LeadPersons.FIO ('Преподаватель / наставник',, scStaffMyPnlPick): protect;
      EduLevelCat.Name ('Вид образования', hcStaffPersonsEducation, scStaffMyPnlPick): protect;
      EduModeCat.Name ('Форма обучения', hcStaffEduName, scStaffMyPnlPick): protect;
      EduNameCat.Name ('Наименование учебного заведения', hcStaffEduName, scStaffMyPnlPick): protect;
      TopicEductCat.Name ('Тема обучения',, scStaffMyPnlPick): protect;
      EduSpecialityCat.Name ('Специальность', hcStaffEduSpeciality, scStaffMyPnlPick): protect;
      Education.PaySum ('Сумма обучения'): [10.3];
      UOWrkTabel.Num ('Условное обозначение',, scStaffMyPnlPick): protect;
      Education.FromDate ('Дата поступления', hcStaffEduFromDate): noProtect;
      Education.ToDate ('Дата окончания', hcStaffEduToDate): noProtect;
      Education.LastDate ('Дата квалификационного экзамена'): noProtect;
      Education.LastTime ('Время квалификационного экзамена'): noProtect;
      Education.Nmb2 ('Количество часов'): noProtect;
      EduReasonCat.Name ('Основание для обучения',, scStaffMyPnlPick): protect;
      ContDoc.SBottom ('Основание для приказа', hcStaffWinPr), noProtect;
    buttons
      cmViewAdvance1,,, 'Просмотр примечания к приказу', hcStaffWinPr;
    <<
`Преподаватель`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Вид образования`         .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Форма обучения`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Учебное заведение`       .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Тема обучения`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Специальность`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Стоимость`               .@@@@@@@@@@@    `Условное обозначение`.@@@@@@@@@@@
`Дата начала`             .@@@@@@@@@@@    `Дата окончания`      .@@@@@@@@@@@
`Дата экзамена`           .@@@@@@@@@@@    `Время экзамена`      .@@@@@@@@@@@
`Кол-во часов`            .@@@@@@@@@@@
`Основание для обучения`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`График занятий`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                              <. Примечание .>
    >>
  end;

  //******************************************************************************
  // Стать на основной лицевой счет
  //******************************************************************************
  function GetFirstLschet(c: comp): boolean;
  { Result:=false;
    var cLschet: comp = 0;
    if ContDoc.wAttrDoc2=0
    { if not MLFP.GetMainLschet(c, cLschet) exit
    }
    else
    { cLschet:=Appointments.cAddNrec2;
    }
    if GetFirst FastFirstRow Lschet where ((cLschet == Lschet.nRec)) = tsOk
      result := true;
  } //function GetFirstLschet(c: comp): boolean;


  // *****************************************************************************
  // процедура пика для поля "вид назначения"
  // *****************************************************************************
  Procedure ChangeTypeApp;
  {
    if ContDoc.Person <> 0
    {
      var cRef: comp;
      var iEntry: word;

      cRef := 0;

      iEntry := if(ContDoc.wAttrDoc2=1, 3, 0);

      if ( RunInterface(GetApp, Persons.Nrec, cRef, iEntry, TitleDoc.DocDate) = cmDefault )
      {
        set ContDoc.cStr := cRef;
        if ( getfirst fastfirstrow Appointments = tsOK )
        {
           set ContDoc.cDopRef := Appointments.department;

        }
      } // if ( RunInterface(GetApp, ...
      else
        set ContDoc.wAttrDoc2 := word(OldFieldValue);
    }
  } //ChangeTypeApp;

  function PickPerson(var _cPerson: tNRec): Boolean;
  var
    wK: Word;
  begin
    wK := 0;
    if viCYPersons.Choice(0, 1, vfCanSelect, wK, _cPerson, 0) then
    begin
      _cPerson := viCYPersons.GetPsnByKindChoice(wK, _cPerson);
      result := true;
    end else
      result := false;
  end;

  procedure EnableDisable;
  begin
    inherited::EnableDisable;
    ToggleFieldSelectable(#ContDoc.wAttrDoc2,fnFieldsOpen);

    // Если приказ не утвержден
    if fnFieldsOpen then
    begin
      SetFieldOption(#LeadPersons.FIO, ofSelectable);
      SetFieldOption(#Education.LastDate, ofSelectable);
      SetFieldOption(#Education.LastTime, ofSelectable);
      SetFieldOption(#Education.Nmb2, ofSelectable);
      SetFieldOption(#EduModeCat.Name, ofSelectable);
    end else
    begin
      ClearFieldOption(#LeadPersons.FIO, ofSelectable);
      ClearFieldOption(#Education.LastDate, ofSelectable);
      ClearFieldOption(#Education.LastTime, ofSelectable);
      ClearFieldOption(#Education.Nmb2, ofSelectable);
      ClearFieldOption(#EduModeCat.Name, ofSelectable);
    end;
  end;

  // Копирует данные из текущей записи всем работникам в приказе
  procedure CopyToAll;
  var
    NeedInsert: Boolean;
  begin
    UpdateTable;
    ReReadRecord(#ContDocC);
    ReReadRecord(#EducationC);
    _loop ContDocC //where ((nRecOrder == ContDocC.cPart))
    begin
      if ContDoc.NRec <> ContDocC.NRec then
      begin

        NeedInsert := getFirst EducationC <>tsok; // where ((ContDocC.NRec == EducationC.cContDoc)) != tsOk;
        timelog('CopyToAll ContDoc.NRec='+string(ContDoc.NRec)+', NeedInsert='+string(NeedInsert));
        if NeedInsert then
        begin
          ClearBuffer(#EducationC);
          EducationC.cContDoc := ContDocC.NRec;
        end;
        if EducationC.cInf1 = 0 then
          EducationC.cInf1 := Education.cInf1;
        if EducationC.cInf2 = 0 then
          EducationC.cInf2 := Education.cInf2;
        if EducationC.Name = 0 then
          EducationC.Name := Education.Name;
        if EducationC.FromDate = ZeroDate then
          EducationC.FromDate := Education.FromDate;
        if EducationC.ToDate = ZeroDate then
          EducationC.ToDate := Education.ToDate;
        if EducationC.Level = 0 then
          EducationC.Level := Education.Level;
        if EducationC.Mode = 0 then
          EducationC.Mode := Education.Mode;
        if EducationC.Speciality = 0 then
          EducationC.Speciality := Education.Speciality;
        if EducationC.cAddInf1 = 0 then
          EducationC.cAddInf1 := Education.cAddInf1;
        if EducationC.cInf1 = 0 then
          EducationC.cInf1 := Education.cInf1;
        if EducationC.PaySum = 0 then
          EducationC.PaySum := Education.PaySum;
        if EducationC.cReason = 0 then
          EducationC.cReason := Education.cReason;
        if EducationC.LastDate = ZeroDate then
          EducationC.LastDate := Education.LastDate;
        if EducationC.LastTime = ZeroTime then
          EducationC.LastTime := Education.LastTime;
        IF EDUCATIONC.NMB2=0
           EDUCATIONC.NMB2:=EDUCATION.NMB2;
        if NeedInsert then
        {
          if insert current EducationC <> tsOk then
            Message('Ошибка: не удалось вставить запись в таблицу Education');
        }
        else
        { if update current EducationC <> tsOk then
            Message('Ошибка: не удалось обновить запись в таблице Education');
        }
        if ContDocC.SBottom = '' then
          ContDocC.SBottom := ContDoc.SBottom;
        if update current ContDocC != tsOk then
          Message('Ошибка: не удалось обновить запись в таблице ContDoc');
      end;
    end;
    RescanPanel(#ContDoc);
    Message('Данные скопированы всем работникам в приказе');
  end;

//******************************************************************************
// События таблицы ContDoc.
//******************************************************************************
TableEvent Table ContDoc;
  cmCheckField:
  {
    case CurField of
      // -----------
      #ContDoc.wAttrDoc2:
      {  ChangeTypeApp;
      }
     else
     { case inherited :: handleEvent (cmCheckField) of
       heAbort:{abort;exit;}
       heStop:{stop;exit;}
       end;
     }
    end;
  }//cmCheckField:
  end; //TableEvent Table ContDoc

  handleEvent
    cmOnVipLoad:
    { timelog_init;
      case inherited :: handleEvent (cmOnVipLoad) of
       heAbort:{abort;exit;}
       heStop:{stop;exit;}
      end;

    }
    cmPick:
    {
        case CurField of
          #LeadPersons.FIO:
            begin
              var _cPerson: tNRec = Education.cInf2;
              if PickPerson(_cPerson) then
                set Education.cInf2 := _cPerson;
            end;
          #EduModeCat.Name:
            begin
              var _Mode: tNRec = Education.Mode;
              if RunInterface('PickCatalog2', -15, _Mode, 0, 0) = cmDefault then
                set Education.Mode := _Mode;
            end;
          #EduQualTypeCat.Name:
          {
            var _cQualType: tNRec = Education.cQualType;
            var _rslt: word = 0;
            if viCatFunc.isParenSysCode(702, EduLevelCat.Nrec)
              _rslt := RunInterface('PickCatalog2', 704, _cQualType, 0, 0);
            else if viCatFunc.isParenSysCode(703, EduLevelCat.Nrec)
              _rslt := RunInterface('PickCatalog2', 705, _cQualType, 0, 0);
            else if viCatFunc.isParenSysCode(708, EduLevelCat.Nrec)
              _rslt := RunInterface('PickCatalog2', -9, _cQualType, 0, 0);

            if _rslt = cmDefault
              set Education.cQualType := _cQualType;
          }
        end;
        if inherited::HandleEvent(cmPick)=heAbort abort;
        case CurField of
        #Persons.FIO:
        { if ContDoc.Person>0 //#2099
          if isValidAll(#Appointments_Sovm)
          { Message('У работника есть внутреннее совмещение!');
          }
        }
        end;
    } //cmPick:
    cmDelOnProtect:
      case CurField of
        #LeadPersons.FIO:
          set Education.cInf2 := 0;
        #EduModeCat.Name:
          set Education.Mode := 0;
      else
        inherited::HandleEvent(cmDelOnProtect);
      end;
    cmHotKeys:
      begin
        var menuID: LongInt;
        menuID := LoadMenu('RPD_Menu');

        prFillMenu(menuID);

        if (NOAA.GetFirstAgreementByLink(GetCo4Agreement(), GetNRec4Agreement()) <> 0)
          AddMenuItem(menuID, 'Печать доп. соглашения (Word)', cmValue17);

        AddMenuItem(menuID,'separator',1);
        AddMenuItemEx2(menuID, 'Запомнить текущие данные', 'Запомнить данные', hcNoContext, cmSaveDoc, kbCtrlF2, 'Ctrl+F2');
        AddMenuItemEx2(menuID, 'Создать новые данные как копию запомненных', 'Создать новые данные как копию запомненных', hcNoContext, cmRestoreDoc, kbCtrlF3, 'Ctrl+F3');
        AddMenuItemEx2(menuID, 'Скопировать всем', 'Скопировать данные всем работникам в приказе', hcNoContext, cmValue10, kbNoKey, '');

        PutHotCommand(RunLoadMenu(menuID));
      end;
    cmValue10:
      CopyToAll;
    cmPrintDoc:
      if UpdateTable then
        RunInterface('GP_NFormRD35', TitleDoc.NRec, ContDoc.Person, ContDoc.NRec, PartDoc.TypeOper);
    cmValue17:{//Печать доп. соглашения (Word)
      if (not UpDateTable) exit;

      var Rep:GP_RepLaborContract;
      Rep.Run(ContDoc.TypeOper,0,ContDoc.NRec,ContDoc.Person,0);
    }
  end;

end.
