#component "Z_StaffOrders"

#include RPD.vih
#include WorkWithContract.vih
#include GP_RepLaborContract.vih

vipInterface RPD_109(RPD_100)
  licensed(free);

interface RPD_109 escClose;

// overloadFormats scrDet100;

  handleEvent
     cmHotKeys:
      begin
        var menuID: LongInt;
        menuID := LoadMenu('RPD_Menu');

        prFillMenu(menuID);

        AddMenuItem(menuID, 'Печать договора (Word)', cmValue17);
        AddMenuItem(menuID,'separator',1);
//        AddMenuItemEx2(menuID, 'Запомнить текущие данные', 'Запомнить данные', hcNoContext, cmSaveDoc, kbCtrlF2, 'Ctrl+F2');
//        AddMenuItemEx2(menuID, 'Создать новые данные как копию запомненных', 'Создать новые данные как копию запомненных', hcNoContext, cmRestoreDoc, kbCtrlF3, 'Ctrl+F3');
//        AddMenuItemEx2(menuID, 'Скопировать всем', 'Скопировать данные всем работникам в приказе', hcNoContext, cmValue10, kbNoKey, '');

        PutHotCommand(RunLoadMenu(menuID));

      end;
    cmValue17: // Печать договора (Word)
      if UpDateTable then
      begin
        var Rep: GP_RepLaborContract;
        Rep.Run(ContDoc.TypeOper, 0, ContDoc.NRec, ContDoc.Person, 0);
      end;
   end;

end.
