#component "Z_STAFF"
#doc
УП - Операции - Изменение тарифов/окладов - Обновление тарифов/окладов в штатном расписании.
<p>3633 В поле <Пересчет производить> добавить режим <на основе оклада из ШР>
При выборе режима <на основе оклада из ШР>, применять правила пересчета ко всем ставкам ШР, действующим на момент пересчета (поле Дата обновления тарифа), независимо от других условий (оклад не соответствует тарифной сетке; нет ссылки на тарифную сетку; новый оклад не укладывается в вилку окладов).
Добавить параметр: Менять ссылку на тарифную сетку: Да/Нет
При установленном параметре <ДА>, менять ссылку на тарифную сетку (Дата обновления тарифа), по номеру тарифной сетки и номеру разряда.
В результате работы функции, все действующие ставки ШР должны быть пересчитаны, в соответствии с заданными правилами пересчета:
Действующий Тариф/оклад * коэффициент, округленный по заданным правилам.
#end

//***********************************************
Alter Interface ST_TARIF;
//***********************************************


var
 GP_TarStav_Ch:word;

//***********************************************
ExtendTabbedSheets st_tarif;
OverLoadFormats myFltr;

//***********************************************
panel myFltr;
  table SertCat;

TabbedSheet Top tsTarStav;
  show at (,,,17);
screen myFltr 'Основные параметры';
fields
  ChangeData  ('Выполнять функцию на дату',, scenterz): noprotect;
  wOper       ('Режим функции обновления',, scenterz) : noprotect;
  docDateSt   ('Дата приказа',, scenterz)             : [11], noprotect;
  docNmbSt    ('Номер приказа',, scenterz)            : [11], noprotect;
  sTypeCalc   (,, scenterz)                           : ,skip;
  wTypeCalc   ('Увеличение проводить',, scenterz):
               [List 'на основе тарифных сеток',
                     'на основе оклада'
#IFDEF _GP_
            ,'на основе оклада из ШР'
#ENDIF
                     ], left;
#IFDEF _GP_
  GP_TarStav_Ch ('Установить тарифную сетку на дату обновления') :NoProtect;
#endif
  aaa1        (,, scenterz)                               : ,skip;
  ZVal_2      ('Коэффициент пересчета окладов',, scenterz): [11.3],noprotect;
  aaa2        (,, scenterz)                               : ,skip;
  ROkl        ('Округление окладов',, scenterz)           : [11.3], noprotect;
  NsysROkl//  'значение настройки'
     (,, scenterz)          : ,skip;
  sysROkl     (,, scenterz)                               : [11.3],skip;
  aaa3        (,, scenterz)                               : ,skip;
  Zval_1      ('Коэффициент пересчета тарифов',, scenterz): [11.3],noprotect;
  aaa4        (,, scenterz)                               : ,skip;
  RTar        ('Округление тарифов',, scenterz)           : [11.3], noprotect;
  NsysRTar //    'значение настройки'
     (,, scenterz)          : ,skip;
  sysRTar     (,, scenterz)                               : [11.3],skip;
  NROundUp  // 'Округление в большую сторону'
       (,, scenterz): ,skip;
  bRoundUp    ('Округление тарифов/окладов в большую сторону',, scenterz) : [list false 'нет', true 'да'];
  NsysRndUp // 'значение настройки'
        (,, scenterz)          : ,skip;
  MSysRndUp// if(sysRoundUp,'да','нет')
       (,, scenterz)    : right, skip;
  fCheckPersons ('Запустить сервисную функцию "Обновление тарифов/окладов в картотеке" с теми же параметрами',, sci13Esc): noprotect;
  NDocNmb     (,, scenterz)                               : ,skip;
  DocNmb      ('Номер приказа',, scenterz)                : [11], noprotect;
  NDocDate    (,, scenterz)                               : ,skip;
  DocDate     ('Дата приказа',, scenterz)                 : [11], noprotect;

<<

  Режим работы                       `Дата обновления тарифа`.@@@@@@@@@@@
    (.)  Контроль тарифов `          `Дата приказа по ШР`    .@@@@@@@@@@@
    (.)  Пересчет тарифов `          `Номер приказа по ШР`   .@@@@@@@@@@@

  .@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
      [.] Установить тарифную сетку на дату обновления`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@    .@@@@@@@@@@@@@@@ .@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@    .@@@@@@@@@@@@@@@ .@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@@@    .@@@@@@@@@@@@@@@ .@@@@@@@@@

   [.] Обновление тарифов/окладов в картотеке`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@    .@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@    .@@@@@@@@@@@@
>>
end;
end; //  TabbedSheet tsTarStav;
end;  //panel

//********************************************
// события интерфейса
//********************************************
Handleevent
//----------------------
cmInit:
{ timelog_init;
  if not ReadMyDsk(GP_TarStav_Ch,     'st_GP_TarStav_Ch',false) GP_TarStav_Ch:=0;
  case Inherited::HandleEvent(cmInit) of
  heAbort :  Abort;
  heStop  :  Exit;
  end;

}
cmOk:
{ //пересчет здесь
  //RunInterface(ST_TARIFFUNC, wOper, bUseKoeff, wTypeCor, wTypeCalc, wMinMax);
  SaveMyDsk(GP_TarStav_Ch,     'st_GP_TarStav_Ch');
  case Inherited::HandleEvent(cmOk) of
  heAbort :  Abort;
  heStop  :  Exit;
  end;

}
end;
end.
