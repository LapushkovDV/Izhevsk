/*************************************************************************************************\
* Наименование:  Создание справки с места работы (по месту требования)                            *
* Контур/Модуль: Управление персоналом                                                            *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1124         |27/09/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include odecl.vih           // Функции склонения ФИО
//#include PostInPaternal.vih
#include GP_DepFunc.vih

interface iCertificatePlaceRequest 'Cправка с места работы (по месту требования)' EscClose;

//*****************************************************************************
create view
var
  cPerson   : comp;

  sFirstPodpis
, sFirstPodpisDol  : string;
as select
  13
    (FieldName = wType)
, 'Em_Report_' + string(wType)
    (FieldName = nameNastr)
, *
from
  Persons
, Catalogs     CatalogsDep
//, Appointments AppointmentsF
, Appointments AppointmentsC
, Catalogs     CatalogsPost
, KatOrg
, Appointments
where
((
    cPerson                  == Persons.NRec
AND Persons.Department       == CatalogsDep.NRec
AND Persons.AppointCur       == AppointmentsC.NRec
AND AppointmentsC.Post       == CatalogsPost.NRec
AND coGetTune('MyOrg')       == KatOrg.NRec

AND Persons.Nrec             == Appointments.Person
AND 0                        == Appointments.lPrizn
AND ZeroDate                <<= Appointments.AppointDate
))

;

Parameters
  cPerson
;
//#include PostInPaternal.var
//*****************************************************************************
var iOdecl     : declension; // Переменная типа интерфейс declension
var oGP_DepFunc   : GP_DepFunc;
//*****************************************************************************

Form frmReport('iCertificatePlaceRequest.out', 'iEM_CertificatePlaceRequest') with novisual;
//*****************************************************************************
Procedure PrintReport;
{
  frmReport.Write(CommonFormHeader);
  frmReport.Write(sGetTune('MyOrg'));

  if (GetFirst KatOrg = tsOk)
    {
      frmReport.Write(KatOrg.Addr);
      frmReport.Write(KatOrg.Tel);
    }
  else
    frmReport.SkipFormat(2);

  frmReport.Write(DateToStr(Cur_Date, 'DD.MM.YYYY'));

  frmReport.Write(iOdecl.FIODeclension(Persons.NRec, Persons.FIO, 3));
  frmReport.Write(if (Persons.Sex= 'М', 'он', 'она'));
  frmReport.Write(DateToStr(Persons.BornDate, 'DD.MM.YYYY'));

  if (GetFirst AppointmentsC = tsOk)
  {
    if (GetFirst CatalogsPost = tsOk)
      frmReport.Write(Locase(SubStr(CatalogsPost.Name, 1, 1)) + SubStr(CatalogsPost.Name, 2, 255));
    else
      frmReport.SkipFormat(1);

    frmReport.Write(oGP_DepFunc.GetFullDepName(AppointmentsC.Department, 0, 1, '/'));
  }
  else
    frmReport.SkipFormat(2);

  if (GetFirst Appointments = tsOk)
    {

      frmReport.Write(DateToStr(Appointments.AppointDate, 'DD.MM.YYYY'));
      frmReport.Write(DateToStr(Appointments.OrderDate, 'DD.MM.YYYY'));
      frmReport.Write(Appointments.OrderNmb);

    }
  else
    frmReport.SkipFormat(3);

  frmReport.Write(sFirstPodpis);
  frmReport.Write(sFirstPodpisDol);

  if (NOT frmReport.error)
    frmReport.showFile('Cправка с места работы (по месту требования)');
  else
    frmReport.abortForm;
}
//*****************************************************************************
//*****************************************************************************
HandleEvent

cmInit:
  {
     if (GetFirst Persons = tsOk)
       {
         RunInterface(iEMGetNastrPodp, wType);

         if (NOT ReadMyDsk(sFirstPodpis     , nameNastr + '_sFirstPodpis', true))
           sFirstPodpis := '';

         if (NOT ReadMyDsk(sFirstPodpisDol  , nameNastr + '_sFirstPodpisDol', true))
           sFirstPodpisDol := '';

         PrintReport;
       }
     else
       {
         Message('Печать только из карточки сотрудника');
       }
     Abort;
  }

end;
end.

#include UsersRep.Vih

VipInterface RunUsersRep_Certificate      implements IRunUsersRep licensed (free);


interface RunUsersRep_Certificate;

  // Запустить пользовательский интерфейс
  procedure RunUserReport(IntNrec : comp);
    {
    var tempComp : comp;
    tempComp := IntNrec;
    RunInterface(iCertificatePlaceRequest, IntNrec);
    }

  // Наименование интерфейса
  function GetDescription: string;
  { GetDescription:='Cправка с места работы (по месту требования)';
  }

end.
