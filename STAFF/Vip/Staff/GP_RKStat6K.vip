function OpenNewRKS : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExistRKS : boolean;
{
  result := false;
  if xlOpenExcel(true)
  {
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlOpenWorkBook(sToExistFile)
      result := true;
  }
}

function SetParam6k : boolean;
{
  result := false;
  if RunWindowModal(Win6KParam)=cmDefault
    result := true;
}
procedure PrintRash;
{
  var lLine : longint;
  var lRB, lRE, lCB, lCE : longint = 1;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Печать расшифровки.', 0);
  lRB := lRE := 2;
  lCB := 1;
  lLine:=0;
  xlMergeCells(1,1,1,4);
  xlSetCellStringValue('Расшифровка листа 6-к. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
  if isvalid(#ttStat6K)
  {
    lCE := 0;
    lCE++; xlSetCellStringValue('№пп',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Табельный №',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата рождения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Возраст',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата трудоустройства',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата назначения на должность',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Стаж работы в текущей должности',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Номер подразделения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Подразделение',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Должность',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Образование',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Категория',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Доп.характеристика',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Номер телефона',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Номер факса',lRE,lCE,lRE,lCE);
    lRE++;
    _loop ttStat6K ordered index ttStat6K02
    {
      if (not NextVisual) break;
      lCE := 0;
      lCE++; xlSetCellStringValue(++lLine             ,lRE,lCE,lRE,lCE);
      lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttStat6K.sTbNmb     ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sFIO       ,lRE,lCE,lRE,lCE);
//       lCE++; xlSetCellStringValue(if(ttStat6K.dBorn<>0,datetostr(ttStat6K.dBorn,'DD.MM.YYYY'),''),lRE,lCE,lRE,lCE);
      lCE++; xlSetCellDateValue(ttStat6K.dBorn,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sAge       ,lRE,lCE,lRE,lCE);
/*
      lCE++; xlSetCellStringValue(if(ttStat6K.dAppF<>0,datetostr(ttStat6K.dAppF,'DD.MM.YYYY'),''),lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(if(ttStat6K.dApp <>0,datetostr(ttStat6K.dApp ,'DD.MM.YYYY'),''),lRE,lCE,lRE,lCE);
*/
      lCE++; xlSetCellDateValue(ttStat6K.dAppF,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellDateValue(ttStat6K.dApp ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sStaj      ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sPodrC     ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sPodrN     ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sPost      ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sEduN+', '+
                                  ttStat6K.sEduD+', '+
                                  ttStat6K.sEduS+', '+
                                  ttStat6K.sEduK                         ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sKat       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sAddCh     ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sPhon      ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttStat6K.sFax       ,lRE,lCE,lRE,lCE);
      lRE++;
    }
  }
  lRE--;
  xlWrapText(lRB,lCB,lRB,lCE);
  xlAutoFit(lRB+1,lCB,lRE,lCE);
  xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
  StopVisual;
}

procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  init6K;

  if isStayAlone
    if SetParam6k
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);

  if isDoRep
  {
    Make6K;
    if isData6K
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNewRKS  ;}
        if wToExistFile = 1 {isOkFile := OpenExistRKS;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        Print6K;

        if (wPrintRash = 1) and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='6-к' break;
          }
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 6-К'); 
          xlSetActiveSheet(i);
          PrintRash;
        }

        xlSetActiveSheetByName('6-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }
    else if isStayAlone message('Нет данных для отчета.');
  }
  Save6K;
  Clear6K;
  closeinterface(cmDefault);
}
//++++++++++++++++++++++++++++++++++++++++++++++++
//--------------------------------------------------------
function bSetRepParam : boolean;  
{
  result := false;
  if RunWindowModal(Win6KParamEx)=cmDefault
    result := true;
}//function bSetRepParam
Function GetReportName: String;
{
  GetReportName := '#(GPNam) (ЭМ)';
}
function GetPriority : Integer;
{
  GetPriority := 6;
}
procedure initRKStatRepParam;
{
  init6K;
}
function dRepOnDateParam : date;
{
  dRepOnDateParam := dRep;
}
//--------------------------------------------------------
handleevent
  cmInit:
  {
    PrintRepPage(true);
  }
  cmPick:
  {
    case CurField of
      #sPodr1:
        if (RunInterface('PICKCATALOGEX', -11, 0, Comp(100), mPodr1) = cmDefault)
          set sPodr1 := sSetPodrName(mPodr1);
      #sToExistFile:
      {
        set sToExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sPodr1:      {ClearMarker(mPodr1);      set sPodr1      := sSetPodrName(mPodr1);}
      #sToExistFile:{set sToExistFile:='';}
    end;
  }
  cmCheckField:
  {
    case CurField of
      #wToExistFile:
      {
        if wToExistFile = 1 
          ToggleFieldVisible(#sToExistFile,true )
        else
          ToggleFieldVisible(#sToExistFile,false);
      }
    end;
  }
end;


End.
