/*************************************************************************************************\
* Наименование:  Доработка отчетной формы "Отчет по изменениям ШР"                                *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Управление персоналом -> Штатное расписание -> Приказы по штатному расписанию    *
*                         -> Реестр приказов по штатному расписанию                               *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#200          |03/05/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include LReports.VIH
#include CatFunc.vih

vipinterface LReports_ChangeStaffSturct implements ILReports
licensed(free);

interface LReports_ChangeStaffSturct;
   

create view
var 
   typeRaise1      : string;
   typeRaise2      : string;
   typeRaise3      : string;
   Markers1        : TPtr;
   Markers2        : TPtr;
   Markers3        : TPtr;
   DeptMarker      : TPtr;
   nRecRasesStS    : comp;          // NRec входа в каталог доплат
   dBeginPeriod    : date;
   dEndPeriod      : date;
   wTypeRDP        : word;
   wFiltersEM      : word;
   DeptFilter_T3EM : string;
   FltDeptEM       : Comp ;  // если единичный выбор, то что выбрано
   DeptCountEM     : LongInt ;  // кол-во в маркере
as select
 * 
from
  Catalogs FltCatalogsEM
where 
((
   FltDeptEM       ==   FltCatalogsEM.NRec

))

;
//*****************************************************************************
var iCatFunc   : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
//*****************************************************************************

Window WinPeriod 'Выбор периода формирования' (,,) escclose, cyan, doAccept;
  show at ( , , 80, 16);
screen StaffStructReports;
fields
   dBeginPeriod    ('Начало периода'                    , , sci13Esc) : ['DD/MM/YYYY'], NoProtect;
   dEndPeriod      ('Окончание периода'                 , , sci13Esc) : ['DD/MM/YYYY'], NoProtect;
   wFiltersEM      ('Фильтры на проверяемых сотрудников', , sci13Esc) : NoProtect ;
   DeptFilter_T3EM ('Выбранные подразделения'           , , sci13Esc) : Protect;
   wTypeRDP        (''                                  , , sci13Esc) : NoProtect;
   typeRaise1      ('Надбавки'                          , , sci13Esc) : NoProtect;
   typeRaise2      ('Надбавки'                          , , sci13Esc) : NoProtect;
   typeRaise3      ('Надбавки'                          , , sci13Esc) : NoProtect;

Buttons
  cmOk    , Default, , 'Формировать', ,;
  cmCancel,        , , 'Отмена'     , ,;
<<

     `Период с` .@@@@@@@@@@@@@@ `до` .@@@@@@@@@@@@@@

  [.]  подразделениям`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  (.) Все                      `
  (.) Введенные штатные единицы`
  (.) Закрытые штатные единицы `

  Надбавки
     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

        <. Сформировать .>     <.    Отмена    .>
>>
end;
//*****************************************************************************
procedure PodrFilter;
{
  var MarkersEM : TPtr; MarkersEM := InitMarker('CatalogsMarker', 8, 200, 10) ;
  DeptCountEM := GetMarkerCount(MarkersEM) ;
  GetMarker(MarkersEM, 0, FltDeptEM) ;
  set FltDeptEM;
  DoneMarker(MarkersEM, 'CatalogsMarker') ;

  if (DeptCountEM > 0)
    set wFiltersEM := wFiltersEM or Word(1);

}

//*****************************************************************************

procedure CopyMarkers(fromMarker : TPtr ; toMarker : TPtr) ;
// Копирует данные из маркера fromMarker в маркер toMarker
var
i        : LongInt ;
Item     : Comp ;
MrkCount : LongInt ;
{
  ClearMarker(toMarker) ;
  MrkCount := GetMarkerCount(fromMarker) - 1 ;
  for (i := 0; i <= MrkCount; i := i + 1)
    if (GetMarker(fromMarker, i, Item))
      InsertMarker(toMarker, Item) ;
} // procedure CopyMarkers

//*****************************************************************************

function SetSelectRaise : string;
{ // Функция формирования строки с количеством выбраных доплат
  SetSelectRaise := iCatFunc.GetCatalogsName(nRecRasesStS);
}

//*****************************************************************************
HandleEvent
cmInit: 
  {
    if (NOT ReadMyDsk(dBeginPeriod, 'T3_2004_From_Order_dBeginPeriod', True))
      set dBeginPeriod := ZeroDate;

    if (NOT ReadMyDsk(dEndPeriod, 'T3_2004_From_Order_dEndPeriod', True))
      set dEndPeriod := ZeroDate;

    if (ReadMyDsk(typeRaise1, 'Order_StaffStStypeRaise1', false)) {}
    if (ReadMyDsk(typeRaise2, 'Order_StaffStStypeRaise2', false)) {}
    if (ReadMyDsk(typeRaise3, 'Order_StaffStStypeRaise3', false)) {}

    if (NOT ReadMyDsk(wTypeRDP, 'T3_2004_From_Order_wTypeRDP', true))
      set wTypeRDP := 0;

    if (NOT ReadMyDsk(wFiltersEM, 'T3_2004_From_Order_wFiltersEM', true))
      set wFiltersEM := 0;

    if (NOT ReadMyDsk(DeptFilter_T3EM, 'StaffStSDeptFilter_T3EM', true)) 
      set DeptFilter_T3EM := 'не установлен';

    PodrFilter;
  }
  
cmOk:
  {
    SaveMyDsk(dBeginPeriod   , 'T3_2004_From_Order_dBeginPeriod');
    SaveMyDsk(dEndPeriod     , 'T3_2004_From_Order_dEndPeriod');
    SaveMyDsk(wFiltersEM     , 'T3_2004_From_Order_wFiltersEM');
    SaveMyDsk(wTypeRDP       , 'T3_2004_From_Order_wTypeRDP');
    SaveMyDsk(DeptFilter_T3EM, 'StaffStSDeptFilter_T3EM'); 

    PutCommand(cmDefault);
  }

cmDone:
  {
    SaveMyDsk(typeRaise1, 'Order_StaffStStypeRaise1') ;
    SaveMyDsk(typeRaise2, 'Order_StaffStStypeRaise2') ;
    SaveMyDsk(typeRaise3, 'Order_StaffStStypeRaise3') ;
  }

cmPick:
{
  case CurField of
    #typeRaise1:
    {
      Markers1 := InitMarker('Order_CatalogsMarker1', 8, 200, 10);
      nRecRasesStS := 0;
      DeptMarker := InitMarker('CatalogsMarker', 8, 200, 10);
      CopyMarkers(Markers1, DeptMarker);
      DoneMarker(DeptMarker, 'CatalogsMarker');
      RunInterface(PickCatalog2, -17, nRecRasesStS, 100);
      DeptMarker := InitMarker('CatalogsMarker', 8, 200, 10);
      CopyMarkers(DeptMarker, Markers1) ;
      DoneMarker(DeptMarker, '');

      if(GetMarkerCount(Markers1) > 1)
      {
        Set typeRaise1 := 'По нескольким доплатам';
      }
      else
      {
        GetMarker(Markers1, 0, nRecRasesStS) ;
        Set typeRaise1 := SetSelectRaise;
      }
      DoneMarker(Markers1, 'Order_CatalogsMarker1');
    }

    #typeRaise2:
    {
      Markers2 := InitMarker('Order_CatalogsMarker2', 8, 200, 10);
      nRecRasesStS := 0;
      DeptMarker := InitMarker('CatalogsMarker', 8, 200, 10);
      CopyMarkers(Markers2, DeptMarker);
      DoneMarker(DeptMarker, 'CatalogsMarker');
      RunInterface(PickCatalog2, -17, nRecRasesStS, 100);
      DeptMarker := InitMarker('CatalogsMarker', 8, 200, 10);
      CopyMarkers(DeptMarker, Markers2) ;
      DoneMarker(DeptMarker, '');

      if(GetMarkerCount(Markers2) > 1)
        {
        Set typeRaise2 := 'По нескольким доплатам';
        }
      else
        {
        GetMarker(Markers2, 0, nRecRasesStS) ;
        Set typeRaise2 := SetSelectRaise;
        }
      DoneMarker(Markers2, 'Order_CatalogsMarker2');
    }

    #typeRaise3:
    {
      Markers3 := InitMarker('Order_CatalogsMarker3', 8, 200, 10);
      nRecRasesStS := 0;
      DeptMarker := InitMarker('CatalogsMarker', 8, 200, 10);
      CopyMarkers(Markers3, DeptMarker);
      DoneMarker(DeptMarker, 'CatalogsMarker');
      RunInterface(PickCatalog2, -17, nRecRasesStS, 100);
      DeptMarker := InitMarker('CatalogsMarker', 8, 200, 10);
      CopyMarkers(DeptMarker, Markers3) ;
      DoneMarker(DeptMarker, '');

      if(GetMarkerCount(Markers3) > 1)
        {
          Set typeRaise3 := 'По нескольким доплатам';
        }
      else
        {
          GetMarker(Markers3, 0, nRecRasesStS);
          Set typeRaise3 := SetSelectRaise;
        }
      DoneMarker(Markers3, 'Order_CatalogsMarker3');
    }
    #DeptFilter_T3EM :
    {
      var tmpComp : Comp ;
      var bMarkerUpdated : Boolean ;
      var bDateChanged : Boolean ;

      tmpComp := FltDeptEM ;
      if (not ReadMyDsk(bMarkerUpdated, 'PickCatalogs2_bMarkerUpdated', bDateChanged))
        bMarkerUpdated := True
      else
        {
          // обнуляем значение
          bDateChanged := False ;
          SaveMyDsk(bMarkerUpdated, 'PickCatalogs2_bMarkerUpdated') ;
        }

      var mEM : TPtr ; mEM := InitMarker('CatalogsMarkerT3EM', 8, 200, 10);
      var DM  : TPtr ; DM  := InitMarker('CatalogsMarker', 8, 200, 10);

      CopyMarkers(mEM, DeptMarker);
      DoneMarker(DM, 'CatalogsMarker');
      RunInterface(PickCatalog2, Integer(-11), tmpComp, Comp(100)) ;
      DM := InitMarker('CatalogsMarker', 8, 200, 10);
      CopyMarkers(DM, mEM) ;
      DoneMarker(DM, '');
      DeptCountEM := GetMarkerCount(mEM) ;
      if (DeptCountEM <> 0)
      {             
        set wFiltersEM := wFiltersEM or Word(1);
        if (DeptCountEM = 1)
          {
          GetMarker(mEM, 0, tmpComp) ;
          set DeptFilter_T3EM := iCatFunc.GetCatalogsName(tmpComp);
          }
        else
          set DeptFilter_T3EM := 'множественный выбор: '+String(DeptCountEM);
      }
      else
      {
        set wFiltersEM;
        set DeptFilter_T3EM := 'не установлен';
      }

      DoneMarker(mEM, 'CatalogsMarkerT3EM') ;
    }  

  end; //case
}

cmDelOnProtect:
  {
    case CurField of
     #DeptFilter_T3EM :
      {
        var mEM : TPtr ; mEM := InitMarker('CatalogsMarkerT3EM', 8, 200, 10);
        ClearMarker(mEM);
        DoneMarker(mEM, 'CatalogsMarkerT3EM');
        set wFiltersEM := 0;
        set DeptFilter_T3EM := 'не установлен';

      }
    end;
  }

end;
end;


  // Запустить пользовательский интерфейс
  procedure RunLReports;
  {
    if (RunWindowModal(WinPeriod) = cmDefault)
      {
        RunInterface(iChangeStaffSturct);
      } 
  }

  // Наименование интерфейса
  function GetDescription: string;
  {
    GetDescription:='Отчет по изменениям ШР ЭМ';
  }

end.
