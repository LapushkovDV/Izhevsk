#ifndef __GP_3GD_vih__
#define __GP_3GD_vih__

#component "GP_Staff"

objInterface GP_3GD_Obj;

//Инициализация классификатора "Вышестоящий руководитель"
//Должна быть предварительно вызвана один раз
//Разместить в cmInit:
procedure Init3GD;

//Установить текущим подразделение являющееся вышестоящим по ЗГД для cStart
//Возвращает true если нашлось такое, иначе false
function bFindCurZGDPodr(cStart : comp) : boolean;
//Возвращает первую цифру кода по ЗГД для текущего подразделения
function sTypeCurZGDPodr : string;

function sNameCurZGDPodr : string;
function sCodeCurZGDPodr : string;

//Возвращает аббревиатуру по ЗГД для текущего подразделения
function sAbbrCurZGDPodr : string;

//Возвращает код вышестоящего подразделения для подразделения cStart
//Функция производит обход всей цепочки от нижестоящего к вышестоящему
//начиная с подразделения cStart
//Первое подразделение в цепочке у которого обнаружится привязанный классификатор 3ГД
//и есть - вышестоящее для cStart
function sCode3GD(cStart : comp) : string;

end;

vipInterface GP_3GD Implements GP_3GD_Obj;
#endif
