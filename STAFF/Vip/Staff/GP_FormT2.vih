#IFNDEF __GP_FORMT2_VIH__
#DEFINE __GP_FORMT2_VIH__

#component "GP_Staff"

objInterface GP_ObjFormT2;

  // Инициализирует расчет
  // Ссылку на назначение для инициализации считывает из DSK
  // Параметры:
  //  _Date - дата, на которую формируется отчёт
  //  _UseAppFilter - использовать фильтр по выбранному назначению
  // Возвращает true, если операция завершилась успешно
  // Инициализирует расчет
  public function Init(_pDate: Date; _UseAppFilter: Boolean = false): Boolean;

  // Выводит окно выбора назначения
  //  _cPerson - ссылка на карточку сотрудника
  //  _Date - дата, на которую формируется отчёт
  //  _UseFirst - если true используется первое найденное назначение
  // Возвращает ссылка на выбранную запись в таблице Appointments
  public function ChooseApp(_cPerson: Comp; _pDate: Date; _UseFirst: Boolean = false): Comp;

  // Возвращает доп.информацию по сотруднкику
  //  _Code - код типа информации.
  // Возвращает ссылка на выбранную запись в таблице Appointments
  public function GetInfo(_Code: String): String;

  // Загружает данные по первому назначению
  //  _CompactMode - если true, выводятся только записи, в которых изменилось подразделение или должность
  // Возвращает true, если операция завершилась успешно
  public function AppGetFirst(_CompactMode: Boolean = true): boolean;

  // Загружает данные по следующему назначению
  // Возвращает true, если операция завершилась успешно
  public function AppGetNext: boolean;

  // Загружает данные по первому отпуску
  // Возвращает true, если операция завершилась успешно
  public function OtpGetFirst: boolean;

  // Загружает данные по следующему отпуску
  // Возвращает true, если операция завершилась успешно
  public function OtpGetNext: boolean;

  // Загружает данные по первой награде
  // Возвращает true, если операция завершилась успешно
  public function AwardGetFirst: boolean;

  // Загружает данные по следующей
  // Возвращает true, если операция завершилась успешно
  public function AwardGetNext: boolean;

  // Возращает информацию о снятии с воинского учета
  function DecommisInfo: String;

  /*
  // Эти функции сейчас не используются, но, может пригодятся в будущем - пока не удаляю

  // Ищет запись в Persons по таб.№
  // Параметры:
  //  _TabN - табельный номер
  // Возвращает Persons.NRec или 0, если не найдено
  function LocatePerson(_TabN: String; _pDate: Date): Comp;

  // Ищет в назначениях первую действующую на указанную дату запись
  // Параметры:
  //  _AppDate - табельный номер
  // Возвращает Appointments.NRec или 0, если не найдено
  function LocateApp(_pDate: Date): Comp;

  // Заполняет таблицу назначений
  // Параметры:
  //  _UseAppFilter - использовать фильтр по выбранному назначению
  // В параметр нужно передавать true, если была выполнена инициализация методом Init
  // и false, если нужное назначение было найдено функциями LocatePerson и LocateApp
  procedure FillSApp(_UseAppFilter: Boolean = false);
  */

end;

vipInterface GP_FormT2 Implements GP_ObjFormT2;
#endif
