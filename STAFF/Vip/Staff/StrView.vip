/*************************************************************************************************\
* Наименование: Доработка стандартного интерфейса "Просмотр штатного расписания"                  *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Штатное расписание / Просмотр штатного расписания                                   *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1140         |10/10/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_StaffSHR"

alter interface StrView;

  create view
    as select
      iStStr.GetWorkersStaff(StaffStruct.NRec, DFiltr) (FieldName = VacCnt);

  overloadFormats PostCat;

  browse PostCat(, hcStaffStruct_View, scStaffForButton);
    Show at (, 12,, 20);
    table StaffStruct;
  fields
    StaffStruct.SeqNmb '№ п/п'                ('N п/п'): [5], skip;
#ifdef _2020_09_30_
    OnePostCat.Name 'Должность (m)'        ('Должность по штатному расписанию'): [30];
#else
    PostCat.Name       'Должность (m)'        ('Должность по штатному расписанию'): [30];
#end
    StaffStruct.dInput 'Дата введения'        ('Дата введения'): [10], skip, centered;
    StaffStruct.dClose 'Дата закрытия'        ('Дата закрытия'): [10], skip, centered;
    AllHWorkStations   'Кол-во', 'единиц'   ('Количество штатных единиц'): [8.3], skip;
    VacCnt             'Кол-во', 'вакансий' ('Количество вакансий'): [8.3], skip;
  end;

  procedure ResetFilter(KeepPos: Boolean);
  var
    SaveRec: tNRec;
    SaveRecFound: Boolean;
    SaveStaffStructRec: tNRec;
    SaveStaffStructFound: Boolean;
  begin
    if KeepPos then
    begin
      // Запоминаем запись, на которой стоял курсор
      SaveRec := TmpCatalogs.NRec;
      SaveStaffStructRec := StaffStruct.NRec;
    end;
    InitTmp;
    SaveRecFound := false;
    if KeepPos then
    begin
      // Пытаемся спозиционироваться на запись, на которой стоял курсор
      if getFirst TmpCatalogs where ((SaveRec == TmpCatalogs.NRec)) = tsOk then
      begin
        SaveRecFound := true;
        cCurPos := TmpCatalogs.NRec;
        TreeJumpToRecord(trCat, cCurPos);
        ReScanPanel(#TmpCatalogs);
      end;
    end;
    if not SaveRecFound then
    begin
      // Позиционируемся на корневую запись
      if GetFirst Catalogs2 where ((RootNode == Catalogs2.cParent)) = tsOk then
      begin
      end;
      TreeJumpToRecord(trCat, Catalogs2.NRec);
      TreeGetFirst(trCat);
      ReReadRecord;
    end;
    // Устанавливаем фильтр по выбранным профессиям
    if DeptCount > 0 then
      SetFilterAn;
    else
      ReSetFilterAn;
    if KeepPos and SaveRecFound then
    begin
      // Пытаемся восстановить позицию в браузере с должностями
      SaveStaffStructFound := false;
      _loop StaffStruct
      begin
        if StaffStruct.NRec = SaveStaffStructRec then
        begin
          SaveStaffStructFound := true;
          break;
        end;
      end;
      if not SaveStaffStructFound then
        if getFirst StaffStruct = tsOk then
        begin
        end;
      ReScanPanel(#StaffStruct);
    end;
  end;

  tableEvent table TmpCatalogs;
    cmCheckField:
      begin
        if CurField = #DFiltr then
          ResetFilter(true)
        else
          inherited::handleEvent(cmCheckField);
      end;
  end;

  handleEvent
    cmInit:
      begin
        inherited::handleEvent(cmInit);
        // При запуске интерфейса всегда должно показываться ШР на текущую дату
        DFiltr := Cur_Date;
        ResetFilter(false);
      end;
  end;

end.
