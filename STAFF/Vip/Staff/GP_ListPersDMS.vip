* Наименование:  Разработка отчетной формы                                                        *
*                "Список сотрудников с доступными вариантами ДМС (ЭМ)"                            *
* Контур/Модуль: Кадры                                                                            *
* Примечание:    Отчеты пользователя                                                              *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#238          |27/06/17|Потапов А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include UserReport.vih
#include CatFunc.vih
#include GP_XlOutExt.vih

#define GPInt GP_ListPersDMS // #(GPInt)
#define GPNam Список сотрудников в разрезе характеристик ставок // #(GPNam)

Interface #(GPInt) '#(GPNam) (ЭМ)' EscClose, Gray;
  show (,,55,7);

const
#include Excel.inc;
end;

table struct ttResStr // данные для отчета
(
  cPerson   : comp
, sPerson   : string    //03
, sCodeDept : string    //01
, cCodeDept : comp
, sNamePost : string    //02
, cNamePost : comp
, sCharName : string    //04
, cCharName : comp
, wCharName : word
, sCharVal  : string    //05
)
with index
(
  ttResStr01 = cPerson + cCodeDept + cNamePost + cCharName + wCharName
, ttResStr02 = sCodeDept + sNamePost + sPerson + sCharName
);

var
  dRep          : date;
  bPostChar     : boolean;
  cPostChar     : comp;
  sPostChar     : string;
  mPostChar     : TPtr;
  iCatFunc      : CatalogsFunctions; // каталоги
  iOut          : GP_XlOutExt;
  sFullName     : string;
  lRB, lRE,
  lCB, lCE,
  lSB, lSE,
  lDB, lDE,
  lRow          : longint;

create view
from
  StaffStruct
, AdvFeatures
, Appointments
, Persons
, ttResStr
where
((
                   dRep >>= StaffStruct.dInput and (StaffStruct.dClose = 0 or StaffStruct.dClose > dRep)
and              word(2) == AdvFeatures.ObjType
and     StaffStruct.nRec == AdvFeatures.ObjnRec
and     StaffStruct.nRec == Appointments.StaffStr
and  Appointments.Person == Persons.nRec
))
;

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

procedure Run;
{
  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);

  if isvalid(#StaffStruct)
  _loop StaffStruct
  {
    if isvalid(#Appointments)
    if isvalid(#Persons)
    if isvalid(#AdvFeatures)
    _loop AdvFeatures
    {
      if (not NextVisual) break;
      if foundmarker(mPostChar,AdvFeatures.Position)
      {
        clearbuffer(#ttResStr);
        ttResStr.cPerson      := Persons.nRec;
        ttResStr.sPerson      := Persons.FIO;
        ttResStr.sCodeDept    := iCatFunc.GetCatalogsCode(StaffStruct.Department);
        ttResStr.cCodeDept    := StaffStruct.Department;
        ttResStr.sNamePost    := iCatFunc.GetCatalogsName(StaffStruct.Post);
        ttResStr.cNamePost    := StaffStruct.Post;
        ttResStr.sCharName    := iCatFunc.GetCatalogsName(AdvFeatures.Position);//ttPostChar.sName;ttPostChar.sName;
        ttResStr.cCharName    := AdvFeatures.Position;//ttPostChar.cRec;
        ttResStr.wCharName    := AdvFeatures.ValType;
        if AdvFeatures.VALTYPE = 6
          ttResStr.sCharVal   := iCatFunc.GetCatalogsName(Comp(Trim(AdvFeatures.ValString)))
        else
          ttResStr.sCharVal   := AdvFeatures.ValString;
        insert current ttResStr;
      }
    }
  }
  if isvalid(#ttResStr)
  {
    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xlsx';

    xlCreateExcel(sFullName, TRUE);
    lRB  := 4;
    lRow := 1;
    lDB  := lDE := lRB + 1;
    lCB  := 1;
    lCE  := 1;
    
    //заголовок
    #define repT 2,2,2,2
    iOut.StringValL('#(GPNam) на '+DateToStr(dRep,'DD.MM.YYYY'),#repT);
    xlSetFontSize(14,#repT);
    xlSetFontStyle(xlBold,#repT);
    
    // шапочка
    #define FrmHd lRB,lCE,lRB,lCE
    iOut.StringValC('Подразделение',                     #FrmHd); lCE++; /*01*/
    iOut.StringValC('Должность',                         #FrmHd); lCE++; /*02*/
    iOut.StringValC('Сотрудник',                         #FrmHd); lCE++; /*03*/
    iOut.StringValC('Наименование характеристики ставки',#FrmHd); lCE++; /*04*/
    iOut.StringValC('Значение характеристики ставки',    #FrmHd); lCE++; /*05*/

    //строки отчета
    #define FrmCl lDE,lSE,lDE,lSE
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;

      lSB := lSE := 1;
      iOut.CodeVal   (ttResStr.sCodeDept, #FrmCl); lSE++; /*01*/
      iOut.StringValL(ttResStr.sNamePost, #FrmCl); lSE++; /*02*/
      iOut.StringValL(ttResStr.sPerson,   #FrmCl); lSE++; /*03*/
      iOut.StringValL(ttResStr.sCharName, #FrmCl); lSE++; /*04*/
      iOut.StringValL(ttResStr.sCharVal,  #FrmCl); lSE++; /*05*/
      lDE++;
      lRow++;
    }


    lSE := 1;
    #define FrmBl lDB,lSE,lDE,lSE

    xlSetColumnWidth(15,#FrmBl); lSE++;/*01*/
    xlSetColumnWidth(30,#FrmBl); lSE++;/*02*/
    xlSetColumnWidth(30,#FrmBl); lSE++;/*03*/
    xlSetColumnWidth(30,#FrmBl); lSE++;/*04*/
    xlSetColumnWidth(30,#FrmBl); lSE++;/*05*/

    xlSetFontSize(11,lRB,lCB,lDE,lCE); xlSetFontStyle(xlBold,lRB,lCB,lRB,lCE); xlSetFontStyle(xlBold,lDE,1,lDE,lCE);
    xlWrapText(lRB,lCB,lDE,lCE);
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0,lRB,lCB,lDE-1,lCE-1);
    #define OtvIsp lDE+2,2,lDE+2,2
    iOut.StringValL('Ответственный исполнитель: '+sGetTune('User.FIO'),#OtvIsp);
    xlSetFontSize(11,#OtvIsp); xlSetFontStyle(xlBold,#OtvIsp);
    iOut.TitleEachPage(lRB,lDB-1,'#(GPInt)');
    xlFreeze(lDB,1);
    xlKillExcel;
  }
  else
  {
    message('Нет данных для формирования отчета!');
  }
  StopVisual;
}

Screen s1(,,sci1Esc);
  show at (,,,);
  fields
    dRep      ('Отчетная дата',,):
              {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    sPostChar ('Характеристика ставки',, scStaffKatPodrRefsPick):
               {Font = {BackColor = if(sPostChar = 'Не выбраны характеристики ставки', ColorNeed, 0)}}, protect;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
  << 'Параметры отчета'
   Отчетная дата .@@@@@@@@@@

  Характеристика .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     <. ~С~формировать .>                 <. ~З~акрыть .>
  >>
end;

//заполнение содержимого поля фильтра
function sSetPostChar(mSetChar: TPtr): string;
{
  if (getMarkerCount(mSetChar) = 0)
  {
    result := 'Не выбраны характеристики ставки';
    exit;
  }
  else
    if (getMarkerCount(mSetChar) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetChar, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько характеристик ставки (' + string(getMarkerCount(mSetChar)) + ')';
}

handleevent
  cmInit:
  {
    delete all from ttResStr;
    if (not (ReadMyDsk(dRep, '#(GPInt)_dRep', false)))
      dRep := Cur_Date;

    mPostChar    := InitMarker('#(GPInt)_PostChar_' + UserName(), 8, 50, 10);
    set sPostChar := sSetPostChar(mPostChar);    
  }
  cmPick:
  {
    case CurField of
    #sPostChar:
    {
      if (RunInterface('PICKCATALOGEX', 83, 0, Comp(100), mPostChar) = cmDefault)
        set sPostChar := sSetPostChar(mPostChar);
    }
    end;
  }
  cmDelOnProtect:
  {
    case CurField of
    #sPostChar:
    {
      ClearMarker(mPostChar);
      set sPostChar := sSetPostChar(mPostChar);
    }
    end;
  }
  cmOk:
  {
    if dRep = 0
    {
      message('Не задана дата!');
    }
    else
    {
      if (getMarkerCount(mPostChar) = 0)
      {message('Не задана характеристика ставки!');}
      else
      {
        Run;
        DoneMarker(mPostChar, '#(GPInt)_PostChar_' + UserName());
        SaveMyDsk (dRep,      '#(GPInt)_dRep');
        delete all from ttResStr;
        closeinterface(cmDefault);
      }
    }
  }
  cmCancel:
  {
    DoneMarker(mPostChar,'#(GPInt)_PostChar_' + UserName());
    SaveMyDsk (dRep,     '#(GPInt)_dRep');
    delete all from ttResStr;
    closeinterface(cmDefault);
  }
end;
end.



VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;

Procedure Run;
Begin
  runinterface(#(GPInt));
End;
Function GetReportName: String;
Begin
  GetReportName := '#(GPNam) (ЭМ)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Компенсации и льготы';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;

End.
