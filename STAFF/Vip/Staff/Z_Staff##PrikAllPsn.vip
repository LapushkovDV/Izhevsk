/*************************************************************************************************\
* Наименование: Добавление кода подразделения в выбор сотрудников по приказам                     *
*             : Добавление даты рождения                                                          *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Документы / Все приказы по персоналу                                                *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1488         |19/12/17|Тищенко Р.Н.             |НПО Энергомаш                    *
* Разработка  |#765          |27/03/18|Потапов А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_Staff"

alter interface PrikAllPsn;

  create view AllPsnChoise
    from
      synonym Catalogs CatDep
     ,synonym Persons PsnBorn
    where ((
        tmpPersons.cDept == CatDep.NRec
    and tmpPersons.Nrec  == PsnBorn.nRec
    ));

/* делаем не перекрытие, а расширение, мы же не галактика 0_-
  overloadFormats brwPsn;

  browse brwPsn (,hcStaffSelectPsn, sci1EnEscInsPM);
    table TmpPersons;
  fields
    { Font = { Color = if ( Picked12 <> '', ColorMark, 0 )}};
    Picked12 'V' ('"V" - поле помечено',,): [1], skip;
    TmpPersons.TabN 'Таб. номер' ('Табельный номер '): [10], protect;
    TmpPersons.StrTabN 'Таб. номер' ('Табельный номер '): [10], protect;
    sSovm 'Таб. совм.' ('Табельный номер совмещения'): [10], protect;
    TmpPersons.FIO 'Фамилия, имя, отчество' ('Фамилия Имя Отчество'): [40], protect;
    CatDep.Code 'Код', 'подразд.' ('Подразделение'): [10], skip;
    DeptName 'Подразделение' ('Подразделение'): [20], skip;
    TmpPersons.AppDate 'Дата', 'приема' ('Дата приема сотрудника'): [12], protect, noAutoSize;
    TmpPersons.DisDate 'Дата', 'увольнения' ('Дата увольнения сотрудника'): [12], protect, noAutoSize;
    PsnBorn.BornDate 'Дата', 'рождения': [12], protect, noAutoSize;
  end;
*/
  ExtendFormats brwPsn;

  browse brwPsn (,hcStaffSelectPsn, sci1EnEscInsPM);
    table TmpPersons;
  fields
    CatDep.Code 'Код', 'подразд.' ('Подразделение'): [10], skip;
    PsnBorn.BornDate 'Дата', 'рождения': [12], protect, noAutoSize;
  end;

end.
