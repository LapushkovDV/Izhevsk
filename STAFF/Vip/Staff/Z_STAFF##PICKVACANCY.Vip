#include GP_ManualNotes.vih

#doc
 Кадры - Выбор вакансий (в приказах например)
#end
#component "Z_STAFF"
Alter Interface PICKVACANCY;
overload
    procedure InitTmp;
end;

OverLoadFormats BRWSTAFFSTRUCT;

var oManualNotes:GP_ObjManualNotes(GP_ManualNotes) New;

Create view PickVacancy
as select oManualNotes.NoteStr
from
  oManualNotes
where((
  coStaffStruct==oManualNotes.wTbl and tmpCurrStafStr.NRec==oManualNotes.cRec
))
condition ForDate2 as  Parent  = StaffStruct.Department  and
                      (dCurrent <  StaffStruct.dClose      or
                   Date(0,0,0)   = StaffStruct.dClose);
;


procedure InitTmp;
var
  kolNew : double;
{
  ReSetBounds(#StaffStruct);
  PushCondition(tcForDate2);

  _loop StaffStruct
  {
    ClearBuffer(#tmpCurrStafStr);
    tmpCurrStafStr.Nrec := StaffStruct.Nrec;
    tmpCurrStafStr.SeqNmb := StaffStruct.SeqNmb;
    tmpCurrStafStr.NamePost := SSPostCat.Name;
    tmpCurrStafStr.CodePost := SSPostCat.Code;
    tmpCurrStafStr.Kateg := SSEmpCategoryCat.NaiKat;
    tmpCurrStafStr.KategoryZL := iCatFunc.GetCatalogsCode(SSPostCat.cRef3);
    if (insert current tmpCurrStafStr <> tsOk){};

    if (GetLast HistoryStr where ((IFHS.GetHistoryStrNRec(StaffStruct.Nrec,dCurrent) == HistoryStr.NRec)) = tsOk)
    {
      ClearBuffer(#tForHist);
      tForHist.mStr         := HistoryStr.StaffStr;
      tForHist.mWorkCond    := HistoryStr.cWorkCond;
      tForHist.mWorkRegime  := HistoryStr.cWorkRegim;
      tForHist.mPayCurrency := HistoryStr.cCurrency;
      tForHist.mPayModel    := HistoryStr.wPayModel;
      tForHist.mTariff      := HistoryStr.cTariff;
      tForHist.mMinTaxRate  := HistoryStr.HMinTaxRate;
      tForHist.mMaxTaxRate  := HistoryStr.HMaxTaxRate;
      tForHist.mTaxRate     := HistoryStr.HTaxRate;
      tForHist.mWorkStations:= HistoryStr.HWorkStations;
      tForHist.dUpCoeff     := Double(HistoryStr.LastUser);

      kolNew := 0;
      _loop Appointments
      {
        case Appointments.lPrizn of
          2, 21, 31, 71, 70, 100: continue;
        end;

        if (Appointments.Person = 0)
          kolNew += Appointments.Rate;
      }

      tForHist.mWorkers    := HistoryStr.HWorkStations - iSHR.GetRateOnDate(StaffStruct.Nrec, dCurrent);
      tForHist.WholeWorker := tForHist.mWorkers - kolNew;
      if (insert current tForHist <> tsOk)  {};

    }
    else
    {
      ClearBuffer(#tForHist);
      tForHist.mStr          := HistoryStr.StaffStr;
      tForHist.mWorkCond     := StaffStruct.WorkCond;
      tForHist.mWorkRegime   := StaffStruct.WorkRegime;
      tForHist.mPayCurrency  := StaffStruct.PayCurrency;
      tForHist.mPayModel     := StaffStruct.PayModel;
      tForHist.mTariff       := StaffStruct.Tariff;
      tForHist.dUpCoeff      := Double(StaffStruct.LastUser);
      tForHist.mTaxRate      := StaffStruct.TaxRate;
      tForHist.mMinTaxRate   := StaffStruct.MinSumma;
      tForHist.mMaxTaxRate   := StaffStruct.MaxSumma;

      tForHist.mWorkStations := StaffStruct.WorkStations;
      tForHist.mWorkers      := StaffStruct.WorkStations - iSHR.GetRateOnDate(StaffStruct.Nrec, dCurrent);
      tForHist.WholeWorker   := tForHist.mWorkers;//
      if (insert current tForHist <> tsOk)  {};
    }
  }
  PopCondition(tcForDate2);
  SetBounds(#StaffStruct);
} // procedure InitTmp

browse brwStaffStruct (,, scStaffVacancy);
  show at (,11,,19);
  table tmpCurrStafStr;
fields
  tmpCurrStafStr.SeqNmb   '№ п/п'
    ('Порядковый номер по штатному расписанию.',) : [5], Protect;
  tmpCurrStafStr.NamePost 'Должность'
    ('Наименование должности.',) : [35], Protect;
  tmpCurrStafStr.CodePost 'Код'
    ('Код должности.',) : [10], Protect;
  tmpCurrStafStr.KategoryZL 'Код','категории','ЗЛ' ('Код категории застрахованного лица'): [10], Protect;
  tmpCurrStafStr.Kateg 'Категория'
    ('Категория должности',) : [10], Protect;
//-----------------
  tForHist.mTaxRate 'Оклад','/ЧТС' :[10,'\2p[|-]366`666`666`666`666.88'],Protect;
//-----------------
  tForHist.mWorkStations  'Штат.ед-ц'
    ('Количество штатных единиц.') : [8.3], Skip;
  tForHist.mWorkers     'Вакансий'
    ('Количество вакантных рабочих мест.') : [8.3], Skip, { font = { BackColor = GetCurPlanBackColor() Color = GetCurPlanFontColor()} };
  tForHist.WholeWorker 'Плановые', 'вакансии'
    ('Количество вакантных рабочих мест, включая неутвержденные приказы.') : [8.3], Skip, { font = { BackColor = GetCurPlanBackColor() Color = GetCurPlanFontColor()} };
  StaffStruct.dInput 'Дата', 'введения'
    ('Дата введения', hcStaffStructdInput): [10,'DD/MM/YYYY'], skip, Centered;
  StaffStruct.dClose 'Дата', 'закрытия'
    ('Дата закрытия', hcStaffStructdClose): [10,'DD/MM/YYYY'], skip, Centered;
  oManualNotes.NoteStr 'Примечание ручное' ('Примечание ручное',,):[20],Protect,NoDel;
end;

end.
