/*************************************************************************************************\
* Наименование:  Множественный выбор нескольких значений внешнего классификатора                  *
* Контур/Модуль:                                                                                  *
* Примечание:    Интерфейс множественного выбора значений указанного внешнего классификатора      *
*                Возвращает маркер с НРЕКами выбранных позиций (EXCLASSSEG.nrec)                  *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#             |21/08/17|Потапов А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

/*
Интерфейс множественного выбора значений указанного внешнего классификатора
Возвращает маркер с КОДАМИ выбранных позиций (EXCLASSSEG.nrec)            
Только линейное представление классификатора. 

Параметры:
wClassCode     - код классификатора (EXCLASSSEG.CLASSCODE,EXCLASSNAME.CLASSCODE)
mClassSelected - возвращаемый маркер
wMode          - режим работы
  0 - тихо заполняет маркер всеми значениями классификатора (указанного)
  1 - запускает окно выбора
---------------------------------
В предыдущей версии в маркер возвращалось EXCLASSSEG.VALUE
Причина изменения - некорректная работа под MS-SQL
EXCLASSSEG.VALUE записывалось в маркер случайным образом
Какой-то платформозависимый баг
---------------------------------
*/

Interface GP_GetSomeClass 'Множественный выбор нескольких значений внешнего классификатора' EscClose, Cyan;

var
  mClassSelected : tPtr;
  wMode : word;

create view
var 
  wClassCode : word;
as select
  if (IsValid(tnEXCLASSSEG),
   (if(FoundMarker(mClassSelected, EXCLASSSEG.nrec),'√','')),
   ' ')
   (FieldName = isClassSelected),
  *
from
  EXCLASSSEG (EXCLASSSEG04)
, EXCLASSNAME
where
((
    wClassCode == EXCLASSSEG.CLASSCODE
and wClassCode == EXCLASSNAME.CLASSCODE
))
;

parameters wClassCode, mClassSelected, wMode;

!-------------------------------------------------------------------------------
Browse brGP_EXCLASSSEG ('Выбор значения', , sci1Esc);
Table EXCLASSSEG;
Fields
  { Font = { Color = if((isClassSelected = '√'), ColorMark, 0) }};

  isClassSelected  '' ('',, sci1EnIns): [3], Protect, Centered, NoAutoSize;

  EXCLASSSEG.VALUE 'Код'
                   ('Код',, sci1EnIns): [8],
                   Protect, Centered, NoAutoSize;
  EXCLASSSEG.NAME  'Значение'
                   ('Значение',, sci1EnIns): [22],
                   Protect;
end;
!-------------------------------------------------------------------------------
HandleEvent
  cmInit:
  {
    if wMode = 0
    {
      ClearMarker(mClassSelected);
      _loop EXCLASSSEG
      {
        InsertMarker(mClassSelected, EXCLASSSEG.nrec);
      }
      CloseInterface(cmDefault);
    }
    if isvalid(tnEXCLASSNAME)
      SetWindowTitle(wnMainWindow,'Выберите значения классификатора: '+EXCLASSNAME.NAME);
    if getfirst EXCLASSSEG = tsOk {}
  }
  cmSelAll:
  {
    ClearMarker(mClassSelected);
    _loop EXCLASSSEG
    {
      InsertMarker(mClassSelected, EXCLASSSEG.nrec);
    }
    ReReadRecord(#EXCLASSSEG);
  }
  cmUnSelAll:
  {
    ClearMarker(mClassSelected);
    ReReadRecord(#EXCLASSSEG);
  }    
  cmDoMarkUnMark:
  {
    if (FoundMarker(mClassSelected, EXCLASSSEG.nrec) = false)
      InsertMarker(mClassSelected, EXCLASSSEG.nrec)
    else
      DeleteMarker(mClassSelected, EXCLASSSEG.nrec);
    if getnext EXCLASSSEG = tsOk {}
    ReReadRecord(#EXCLASSSEG);
  }
  cmDefault :
  {
    if GetMarkerCount(mClassSelected) =0
      InsertMarker(mClassSelected, EXCLASSSEG.nrec);
    CloseInterface(cmDefault);
  }
  cmCancel:
  {
    CloseInterface(cmCancel);
  }
end;
end.
