/*************************************************************************************************\
* Наименование: Триггер перед записью PartDoc                                                     *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание: В поле cRef2 сохраняется nrec пользователя ее создавшего                            *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#000          |07/11/17|Евдокимов М.А.           |НПО Энергомаш                    *
\*************************************************************************************************/

handler with replace GP_PartDocBeforeInsert on trigger PartDoc before Insert [99]
action
{
  var buf : record as table PartDoc;
  GetTableBuffer(buf);
  buf.cRef2 := UserId;
  result := SetTableBuffer(buf) = tsOk;
}
