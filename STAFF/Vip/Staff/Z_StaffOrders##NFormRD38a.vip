#include oDecl.vih

#component "Z_StaffOrders"

alter interface NFormRD38a;

overload
  DataStream DTS_NFormRD38a;
  procedure FillTablePlanOtpusk;
end;

var
  _decl: declension;

create view
from
  tpNFormRD38a gp_tpNFormRD38a
 ,tpNFormRD38a gp_tpNFormRD38a1
 ,tpNFormRD38a gp_tpNFormRD38a2
 ,WorkPCon GP_WorkPCon1
 ,WorkPeriod GP_WorkPeriod1
 ,WorkPCon GP_WorkPCon2
 ,WorkPeriod GP_WorkPeriod2
 ,WorkPCon GP_WorkPCon3
 ,WorkPeriod GP_WorkPeriod3
 ,WorkPCon GP_WorkPCon4
 ,WorkPeriod GP_WorkPeriod4
where ((
      1 == gp_tpNFormRD38a1.wChoice
  and 2 == gp_tpNFormRD38a2.wChoice
  and gp_tpNFormRD38a1.cDep     == gp_tpNFormRD38a2.cDep
  and (gp_tpNFormRD38a1.cFIO     = gp_tpNFormRD38a2.cFIO
  and  gp_tpNFormRD38a1.cPost    = gp_tpNFormRD38a2.cPost
  and  gp_tpNFormRD38a1.NOtpus   = gp_tpNFormRD38a2.NOtpus
  and  gp_tpNFormRD38a1.dBegin   = gp_tpNFormRD38a2.dBegin
  and  gp_tpNFormRD38a1.dEnd     = gp_tpNFormRD38a2.dEnd
  and  gp_tpNFormRD38a1.wDur     = gp_tpNFormRD38a2.wDur
  and gp_tpNFormRD38a1.dRpBegin  = gp_tpNFormRD38a2.dRpBegin
  and gp_tpNFormRD38a1.dRpEnd    = gp_tpNFormRD38a2.dRpEnd)

  and coPlanOtpusk              == GP_WorkPCon1.wTable
  and PlanOtpusk1.Nrec          == GP_WorkPCon1.cTable
  and GP_WorkPCon1.cWorkPeriod  == GP_WorkPeriod1.NRec

  and coPlanOtpusk              == GP_WorkPCon2.wTable
  and PlanOtpusk2.Nrec          == GP_WorkPCon2.cTable
  and GP_WorkPCon2.cWorkPeriod  == GP_WorkPeriod2.NRec

  and coPlanOtpusk              == GP_WorkPCon3.wTable
  and PlanOtpusk.Nrec           == GP_WorkPCon3.cTable
  and GP_WorkPCon3.cWorkPeriod  == GP_WorkPeriod3.NRec

  and coSpAllStaff              == GP_WorkPCon4.wTable
  and SpAllStaff2.Nrec          == GP_WorkPCon4.cTable
  and GP_WorkPCon4.cWorkPeriod  == GP_WorkPeriod4.NRec
));

create view vCat
var
  _cCat: comp;
as select Catalogs.Nrec
from
  Catalogs
where ((
  _cCat == Catalogs.Nrec
));

function sGetDepName_RP(cDep: comp): string;
{
  result := sGetAttr(coCatalogs, cDep, 'Родительный падеж');
  if trim(result) = ''
  {
    vCat._cCat := cDep;
    if vCat.getfirst Catalogs = tsOk
      result := vCat.Catalogs.Name;
  }
}

function sGetPostName_RP(cPost: comp): string;
{
  result := sGetAttr(coCatalogs, cPost, 'Родительный падеж');
  if trim(result) = ''
  {
    vCat._cCat := cPost;
    if vCat.getfirst Catalogs = tsOk
      result := vCat.Catalogs.Name;
  }
}

function sGetDepCode(cDep: comp): string;
{
  result := '';
  vCat._cCat := cDep;
  if vCat.getfirst Catalogs = tsOk
    result := vCat.Catalogs.Code;
}

DataStream DTS_NFormRD38a
(
  table inherited::tpNFormRD38aFIOList
  (
    [GP_FIO_RP] _decl.FIODeclension(tpNFormRD38aFIOList.cFIO, tpNFormRD38aFIOList.sFIO, 2);
    [GP_POST_RP] sGetPostName_RP(tpNFormRD38aFIOList.cPost);
  );
  table inherited::tpNFormRD38aDep
  (
    [GP_DepName_RP] sGetDepName_RP(tpNFormRD38aDep.cDep);
    [GP_DepCode]    sGetDepCode(tpNFormRD38aDep.cDep);
  );
)
end; //DataStream DTS_NFormRD38a

//ЗАЧЕМ ???????????????????
procedure GP_FillTablePlanOtpusk;
{
  _loop ContDoc
  {
    if funIsOrderConfirm
    {
//procedure AddRecIO(_wChoice: word; _NOtpus: string; _dBegin: date; _dEnd: date; _wDur: double;
//                   _dRpBegin: date; _dRpEnd: date);

      _loop SpAllStaff1
        _loop PlanOtpusk1
          AddRecIO(1,
#IFDEF _2019_02_13_
                   0,//_wDet
#ENDIF
                   KlOtpusk1.NOtpus,
                   PlanOtpusk1.PlanYearBeg,
                   PlanOtpusk1.PlanYearEnd,
                   PlanOtpusk1.Duration,
                   GP_WorkPeriod1.dPerBeg,
                   GP_WorkPeriod1.dPerEnd
                   );

      _loop SpAllStaff2
        _loop PlanOtpusk2
          AddRecIO(2,
#IFDEF _2019_02_13_
                   0,//_wDet
#ENDIF
                   KlOtpusk2.NOtpus,
                   PlanOtpusk2.PlanYearBeg,
                   PlanOtpusk2.PlanYearEnd,
                   PlanOtpusk2.Duration,
                   GP_WorkPeriod2.dPerBeg,
                   GP_WorkPeriod2.dPerEnd
                   );
    }
    else
    {
      _loop PlanOtpusk
        AddRecIO(1,
                 KlOtpusk.NOtpus,
#IFDEF _2019_02_13_
                   0, //_wDet
#ENDIF
                 PlanOtpusk.PlanYearBeg,
                 PlanOtpusk.PlanYearEnd,
                 PlanOtpusk.Duration,
                 GP_WorkPeriod3.dPerBeg,
                 GP_WorkPeriod3.dPerEnd
                 );

      _loop SpAllStaff2
        AddRecIO(2,
#IFDEF _2019_02_13_
                   0, //_wDet
#ENDIF
                 KlOtpuskNew.NOtpus,
                 SpAllStaff2.dDate,
                 SpAllStaff2.ResDate[2],
                 SpAllStaff2.ResDecimal[1],
                 GP_WorkPeriod4.dPerBeg,
                 GP_WorkPeriod4.dPerEnd
                 );
    }
  }

  ReReadrecord(#tpNFormRD38aChoice1);
  ReReadrecord(#tpNFormRD38aChoice2);
}

procedure FillTablePlanOtpusk;
{
  //inherited::FillTablePlanOtpusk;

  //if RecordsInTable(tntpNFormRD38a) = 0
  GP_FillTablePlanOtpusk;

  //Удаление из временной таблицы строк плана по которым не было изменений
  _loop gp_tpNFormRD38a1
    if getfirst gp_tpNFormRD38a2 = tsOk
    {
      update current gp_tpNFormRD38a2 set gp_tpNFormRD38a2.wChoice := word(-9);
      update current gp_tpNFormRD38a1 set gp_tpNFormRD38a1.wChoice := word(-9);
    }
  delete all gp_tpNFormRD38a where ((word(-9) == gp_tpNFormRD38a.wChoice));
}

end.
