)
end;
//*****************************************************************************
Function GetVidD: string;
{
  GetVidD := TOA.GetJuridicalInfo.GetVidD;

  if (GetFirst FastFirstRow AttrNam where (( word(CoKatOrg)                            == AttrNam.WTable and
                                             'Вид деятельности для льготных профессий' == AttrNam.Name   )) = tsOk)
    if (GetFirst AttrVal where (( word(CoKatOrg)     == AttrVal.WTable    and
                                  coGetTune('MyOrg') == AttrVal.CRec      and
                                  AttrNam.NRec       == AttrVal.CAttrNam  )) = tsOk)
      GetVidD := AttrVal.vString;
}

Function GetTypeOrg: string;
{
  GetTypeOrg := TOA.GetJuridicalInfo.GetFormSobs;
  if (GetFirst FastFirstRow AttrNam where (( word(CoKatOrg)                          == AttrNam.WTable and
                                            'Тип организации для льготных профессий' == AttrNam.Name   )) = tsOk)
    if (GetFirst AttrVal where (( word(CoKatOrg)     == AttrVal.WTable   and
                                  coGetTune('MyOrg') == AttrVal.CRec     and
                                  AttrNam.NRec       == AttrVal.CAttrNam )) = tsOk)
      GetTypeOrg := AttrVal.vString;
}
//*****************************************************************************
// выбрасывание неподходящих символов из строки
Function No_Char(st: string): string;
{
  var Rez: string;      Rez := '';
  var sh: word;         sh := 1;

  For (sh := 1;
       sh <= Length(st);
       sh := sh + 1)
    case SubStr(st, sh, 1) of
      '0'..'9', 'a'..'z', 'A'..'Z','а'..'я','А'..'Я',' ',
      '''', '_', '`', '~', '!', '@', '#', '$', '%', '^', '&', '(', ')', '{', '}'
      ,'.',',','*','/','+','-','=':
        Rez := Rez + SubStr(st, sh, 1);
    end;

  No_Char := Rez;
}

procedure FillDopTarifAndKlass(wType :word; cSource, cUsl : comp; var sDopTar, sKlass :string);
{
  sDopTar := sKlass := '';

  if ( iCatFunc.isParenSysCode(1518, cUsl) ) or
     ( iCatFunc.isParenSysCode(1519, cUsl) )
  {
    sDopTar := 'ДТ';

    case wType of
      1 : sKlass := EA.sGetAttr(coPenStaj, cSource, 'sKlassPost');
      2 : if ( GetFirst InfPsn1 where (( cSource      == InfPsn1.cPers           and
                                         skkKlassPost == InfPsn1.cRef2 (NoIndex) )) = tsOk)
            sKlass := InfPsn1.str1;
    end;

    if (GetFirst KlChild4 where (( longint(100*double(sKlass)) == KlChild4.YearInt (NoIndex) )) <> tsOk)
    {
      sKlass := '';
      exit;
    }

    if ( KlChild4.VidOpl = 0 )
      sDopTar := '';

    case KlChild4.YearInt of
      310, 320, 330, 340 : sKlass := 'В' + SubStr(sKlass,1,3);
      400                : sKlass := 'О' + SubStr(sKlass,1,1);
    end;
  }
}
//*****************************************************************************
file mFile;
//*****************************************************************************
//   выводим данные в форму.
//*****************************************************************************
procedure ReportForm;
var
  k, iCount : longint;
  cApp      : comp;
  dStajEnd  : date;
{
  iCount :=  VInter.GetPsnCount;

  if (iCount = 0)
  {
    VInter.SelectAllPsn;
    iCount :=  VInter.GetPsnCount;
  }

// --------------------------------
// подготовка вывод в форму
// --------------------------------
 /* StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak, 'Подготовка данных ', iCount); */
// --------------------------------
// подготовка данных
// --------------------------------

  delete all mt_PodrList;
  delete all mt_PostList;
  delete all mt_PersList;

  liMarkerVred := InitMarker('', 8, 200, 10);

  for (k := 0; k < iCount; k++)
  {
    var Item: Comp ;
    if (GetMarker(VInter.GetPersonsMarker, k, Item))
    {
       if  getfirst fastfirstrow Persons where (( Item == Persons.NRec )) = tsok
       {
          ClearMarker(liMarkerVred);

          _loop PenStaj where (( Persons.NRec        ==  PenStaj.Person   and
                                 Param_FP19.dDataDOC >>= PenStaj.FromDate ))
          {
            // если все поля пустые, пропускаем запись стажа:
            // Терр. условия, Район. коэф-т, Особ. условия, Основания стажа, Основания для выслуги, КПС
            if ( PenStaj.cTerr = 0) and ( PenStaj.cUsl = 0)  and ( PenStaj.cOsn = 0) and
               ( PenStaj.cVisl = 0) and ( PenStaj.cVred = 0) and ( PenStaj.rZarKoof = 0)
              continue;

            dStajEnd := if(Day(PenStaj.ToDate)<>0, PenStaj.ToDate, Param_FP19.dDataDOC);

            // проверка на пересечение
            if ( not iStrFunc.isCrossPeriod(PenStaj.FromDate, dStajEnd, Param_FP19.dPersonBeginDate, Param_FP19.dPersonEndDate) )
              continue;

            // определим назначение на дату начала записи стажа
            // из стажа ссылку брать нельзя, т.к. при формировании по табелю она пустая,
            // вероятно в дальнейшем эта ссылка никогда не будет заполняться
            // сперва поищем врем. перевод содержащий дату начала стажа, если его не найдет определим осн. назначение на дату
            cApp := iAppFuncs.GetAllAppNRec_IncludeDate(PenStaj.Person, PenStaj.FromDate, 70);

            if ( cApp = 0 )
              cApp := iAppFuncs.GetAppNrec_OnDate(PenStaj.Person, PenStaj.FromDate);

            if GetFirst FastFirstRow MainAppoint where ((           cApp   == MainAppoint.NRec    and
                                                          PenStaj.Person   == MainAppoint.Person (NoIndex) )) = tsok
            {

              if GetFirst FastFirstRow StaffStruct where (( MainAppoint.StaffStr == StaffStruct.NRec )) = tsok
              {
                // построим карту изменения вредности по ставке, если ее еще нет
                if GetFirst mt_PostPeriodVred where (( StaffStruct.NRec == mt_PostPeriodVred.cStaffStr )) <> tsOk
                {
                  var cTmpAdv  : comp;
                  var dTmpHist : date;

                  cTmpAdv  := comp(0);
                  dTmpHist := date(0,0,0);

                  _loop HistoryStr where (( StaffStruct.NRec == HistoryStr.StaffStr )) ordered by HistoryStr.dHist
                  {
                    if ( cTmpAdv <> HistoryStr.cRez2 )
                    {
                      if ( Day(dTmpHist) <> 0 )
                        update current mt_PostPeriodVred set mt_PostPeriodVred.dEndVred := Sub_Day(HistoryStr.dHist, 1);

                      insert mt_PostPeriodVred set mt_PostPeriodVred.NRec      := GetNextNRec(#mt_PostPeriodVred,0),
                                                   mt_PostPeriodVred.cStaffStr := HistoryStr.StaffStr,
                                                   mt_PostPeriodVred.cAdvises  := HistoryStr.cRez2,
                                                   mt_PostPeriodVred.dBegVred  := HistoryStr.dHist,
                                                   mt_PostPeriodVred.dLastAtt  := HistoryStr.dFld;

                      dTmpHist := HistoryStr.dHist;
                      cTmpAdv  := HistoryStr.cRez2;
                    }
                    else
                      if ( Day(dTmpHist) <> 0 )
                      {
                        dTmpHist := HistoryStr.dHist;

                        if ( mt_PostPeriodVred.dLastAtt < HistoryStr.dFld )
                          update current mt_PostPeriodVred set mt_PostPeriodVred.dLastAtt := HistoryStr.dFld;
                      }
                  }

                  // удалим периоды с пустой ссылкой на вредность
                  delete all mt_PostPeriodVred where (( StaffStruct.NRec == mt_PostPeriodVred.cStaffStr and
                                                        comp(0)          == mt_PostPeriodVred.cAdvises  ));
                }

                // если период стажа (пусть он и вредный) не пересекается ни с одним периодом вредности ставки,
                // пропускаем такой стаж
                if GetFirst mt_PostPeriodVred where (( StaffStruct.NRec == mt_PostPeriodVred.cStaffStr and
                                                       ( iStrFunc.isCrossPeriod( PenStaj.FromDate,
                                                                                 dStajEnd,
                                                                                 mt_PostPeriodVred.dBegVred,
                                                                                 mt_PostPeriodVred.dEndVred) ) )) <> tsOk
                  continue;

                _loop mt_PostPeriodVred where (( StaffStruct.NRec == mt_PostPeriodVred.cStaffStr ))
                  if ( iStrFunc.isCrossPeriod( PenStaj.FromDate,           dStajEnd,
                                               mt_PostPeriodVred.dBegVred, mt_PostPeriodVred.dEndVred) )
                  {
                    // заполняем позиции
                    if GetFirst mt_PostList where (( StaffStruct.NRec == mt_PostList.cStaffStr and
                                                     mt_PostPeriodVred.dBegVred == mt_PostList.dInput and
                                                     mt_PostPeriodVred.dEndVred == mt_PostList.dClose )) <> tsOk
                    {
                      ClearBuffer(#mt_PostList);

                      mt_PostList.cStaffStr   := StaffStruct.NRec;
                      mt_PostList.PostNRec    := StaffStruct.Post;
                      mt_PostList.PostName    := iCatFunc.GetCatalogsName(StaffStruct.Post);
                      mt_PostList.PostNameSpr := iCatFunc.GetCatalogsName(StaffStruct.Post);
                      mt_PostList.cDeptNRec   := StaffStruct.Department;
                      mt_PostList.dInput      := mt_PostPeriodVred.dBegVred;
                      mt_PostList.dClose      := mt_PostPeriodVred.dEndVred;
                      mt_PostList.dLastAtt    := mt_PostPeriodVred.dLastAtt;
                      mt_PostList.KolStStr    := StaffStruct.WorkStations;
                      mt_PostList.KolFact     := 1;
                      mt_PostList.WC_Name     := iCatFunc.GetCatalogsName(StaffStruct.WorkCond);

                      if GetFirst Advises where (( mt_PostPeriodVred.cAdvises == Advises.NRec )) = tsOk
                      {
                        mt_PostList.OU_Code     := iCatFunc.GetCatalogsCode(Advises.Recommendation);
                        mt_PostList.OU_Name     := iCatFunc.GetCatalogsName(Advises.Recommendation);
                        mt_PostList.KPS_Code    := iCatFunc.GetCatalogsCode(Advises.Executor);
                        mt_PostList.KPS_Name    := iCatFunc.GetCatalogsName(Advises.Executor);

                        FillDopTarifAndKlass(word(2), Advises.NRec, Advises.Recommendation, mt_PostList.DopTariff, mt_PostList.Class_WC);

                        // Для кода 27-2 в сочетании с позицией списка 23307000-17541: страхователи за данных работников не обязаны начислять и уплачивать дополнительный тариф.
                        if ( mt_PostList.OU_Code = '27-2' ) and ( mt_PostList.KPS_Code = '23307000-17541' )
                          mt_PostList.DopTariff := '';
                      }
                      
                      if (GetFirst Catalogs where ((mt_PostList.cDeptNRec == Catalogs.NRec)) = tsOk)
                        if (GetFirst Catalogs2 where ((Catalogs.cParent == Catalogs2.NRec)) = tsOk)
                          { 
                            mt_PostList.cVidPr := Catalogs2.NRec;
                            mt_PostList.sVidPr := Catalogs2.Name;
                          }

                      if (GetFirst Catalogs where ((StaffStruct.WorkCond == Catalogs.NRec)) = tsOk)
                        {
                          mt_PostList.sСodeExemption := Catalogs.Code;
                          mt_PostList.sNameExemption := Catalogs.Name;
                        }   


                      var TblCurrent  : longint; TblCurrent  := 19;
                      var NRecCurrent : comp;    NRecCurrent := StaffStruct.Post;
                                                          
                      if (GetFirst AdvFeatures where ((2                == AdvFeatures.ObjType
                                                  AND  StaffStruct.NRec == AdvFeatures.ObjNrec)) = tsOk)
                        {
                          TblCurrent  := 21;
                          NRecCurrent := AdvFeatures.Nrec;
                        }

                      if (GetFirst Appendix where ((2                 == Appendix.ObjBlock
                                                AND StaffStruct.NRec  == Appendix.Person  
                                                AND TblCurrent        == Appendix.ObjType
                                                AND NRecCurrent       == Appendix.ObjNrec)) = tsOk)
                        {
                          _try
                            {
                              var ss : string; ss := '';
                              mFile.OpenMemo(Appendix.Contents);
                              while ( not mFile.EOF) do
                              {
                                var ReadStr : string; ReadStr := '';
                                mFile.ReadLn(ReadStr);
                                ss := ss + ReadStr;
                              }
                              mt_PostList2.Descr := ss;
                            }
                            _except
                              on ExFile         :{}
                              on ExFileNotFound :{}
                            _finally
                              mFile.Close;
                        } 

                      insert current mt_PostList;

                      InsertMarker(liMarkerVred, mt_PostPeriodVred.NRec);
                    }
                    else
                      if ( not FoundMarker(liMarkerVred, mt_PostPeriodVred.NRec) )
                      {
                        update current mt_PostList set mt_PostList.KolFact := mt_PostList.KolFact + 1;

                        InsertMarker(liMarkerVred, mt_PostPeriodVred.NRec);
                      }
                  }
                // заполняем подразделение, если еще не заполняли такого
                if GetFirst mt_PodrList where (( StaffStruct.Department == mt_PodrList.cDeptNRec )) <> tsOk
                {
                  ClearBuffer(#mt_PodrList);

                  mt_PodrList.cDeptNRec := StaffStruct.Department;
                  mt_PodrList.sDeptName := iCatFunc.GetCatalogsName(mt_PodrList.cDeptNRec);
                  mt_PodrList.sDeptCod  := iCatFunc.GetCatalogsCode(mt_PodrList.cDeptNRec);
                  mt_PodrList.cPodrNRec := GalDepartmentNrec(mt_PodrList.cDeptNRec);
                  if (GetFirst DepFunc = tsOk)
                    mt_PodrList.VidD := DepFunc.NmFunc;
                  else 
                    {
                      TOA.Bind(KatPodr.NRec); // связываем TOA с собственной организацией
                      mt_PodrList.VidD := Trim(GetVidD());
                    }   
                  insert current mt_PodrList;
                }

                // заполняем поименный список
                ClearBuffer(#mt_PersList);

                mt_PersList.PersNRec  := Persons.NRec;
                mt_PersList.sPersFIO  := Persons.FIO;
                mt_PersList.BornDate  := Persons.BornDate;
                mt_PersList.cStaffStr := StaffStruct.NRec;
                mt_PersList.cDeptNRec := StaffStruct.Department;

                //mt_PersList.sTabNmb   := GetStrTabn(Persons.TabNmb, Persons.StrTabN);
                //mt_PersList.BaseProf  := iCatFunc.GetCatalogsName(Persons.cBaseProf);

                if ( GetFirst FastFirstRow StrahPassports = tsOk )
                  mt_PersList.sStrahNmb := StrahPassports.Nmb;

                mt_PersList.cAppoint    := MainAppoint.NRec;
                mt_PersList.dAppDate    := PenStaj.FromDate;
                mt_PersList.dDisDate    := if(Day(PenStaj.ToDate)<>0, PenStaj.ToDate, Param_FP19.dDataDOC);
                mt_PersList.dPensDate   := Persons.PensionDate;
                mt_PersList.cPost       := StaffStruct.Post;
                mt_PersList.PostName    := iCatFunc.GetCatalogsName(StaffStruct.Post);
                mt_PersList.ProfName    := iCatFunc.GetCatalogsName(StaffStruct.Post);

                mt_PersList.OU_Code     := iCatFunc.GetCatalogsCode(PenStaj.cUsl);
                mt_PersList.OU_Name     := iCatFunc.GetCatalogsName(PenStaj.cUsl);
                mt_PersList.KPS_Code    := iCatFunc.GetCatalogsCode(PenStaj.cVred);
                mt_PersList.KPS_Name    := iCatFunc.GetCatalogsName(PenStaj.cVred);

                mt_PersList.sOsn        := iCatFunc.GetCatalogsName(PenStaj.cOsn);
                mt_PersList.sMon        := string(PenStaj.wMon);
                mt_PersList.sDays       := string(PenStaj.wDays);
                mt_PersList.sHours      := string(PenStaj.wHours);
                mt_PersList.sMinutes    := string(PenStaj.wMinutes);

                mt_PersList.LiveAddr    := iAdrFunc.GetFullAddressInd(Persons.LiveAddr);

                // заполнение доп. тарифа и класса условий труда
                FillDopTarifAndKlass(word(1), PenStaj.NRec, PenStaj.cUsl, mt_PersList.DopTariff, mt_PersList.Class_WC);
                // Для кода 27-2 в сочетании с позицией списка 23307000-17541: страхователи за данных работников не обязаны начислять и уплачивать дополнительный тариф.
                if ( mt_PersList.OU_Code = '27-2' ) and ( mt_PersList.KPS_Code = '23307000-17541' )
                  mt_PersList.DopTariff := '';

                insert current mt_PersList;
              }

            }

          }

       }
      // if not NextVisual break;
    }

  }
  //StopVisual('', 0);
  DoneMarker(liMarkerVred, '');

  if GetFirst FastFirstRow mt_PodrList <> tsOk
  {
    Message('Нет данных для формирования отчета!', Information);
    madeReport := true;
    exit;
  }

  TOA.Bind(0); // связываем TOA с собственной организацией

  RunFReport(FavourProfStream, '', true);
  madeReport := true;
} //procedure ReportForm;

HandleEvent

cmInit:
  {
    ReportForm;
  } //cmInit:

end;
end.
