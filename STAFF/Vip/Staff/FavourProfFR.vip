//*****************************************************************************
table struct mt_PodrList
(
  cDeptNRec : comp      // ссылка на СЕ ШР
, sDeptName : string    // наименование СЕ ШР
, sDeptCod  : string    // код СЕ ШР
, cPodrNRec : comp      // ссылка на подразделение KatPodr
, VidD      : string
)
with index
(
  mt_PodrList01 = cPodrNRec + sDeptName
, mt_PodrList02 = cDeptNRec
);
//*****************************************************************************
table struct mt_PostList
(
  cStaffStr   : comp
, PostName    : string
, PostNameSpr : string
, PostNRec    : comp
, cDeptNRec   : comp
, dInput      : date
, dClose      : date
, KolStStr    : double    // Количество по ШР
, KolFact     : double    // Фактическое количество
, WC_Name     : string    // Условия труда из ставки
, OU_Code     : string    // Код Особые условия
, OU_Name     : string    // Наименования Особые условия
, KPS_Code    : string    // Код КПС
, KPS_Name    : string    // Наименование КПС
, DopTariff   : string    // Дополнительный тариф
, Class_WC    : string    // Класс условий труда
, dLastAtt    : date      // Дата последней аттестации/оценки
, cVidPr      : comp
, sVidPr      : string
, sСodeExemption : string
, sNameExemption : string
, Descr       : string
)
with index
(
  mt_PostList01 = cDeptNRec + PostName + dInput + dClose
, mt_PostList02 = cStaffStr + dInput   + dClose
);
//*****************************************************************************
table struct mt_PersList
(
  PersNRec  : comp
, sPersFIO  : string
//, sTabNmb   : string
, cStaffStr : comp
, cDeptNRec : comp
, sStrahNmb : string
, cAppoint  : comp
, dAppDate  : date
, dDisDate  : date
, dPensDate : date
, cPost     : comp
, PostName  : string
, ProfName  : string
//, BaseProf  : string
, OU_Code   : string    // Код Особые условия
, OU_Name   : string    // Наименования Особые условия
, KPS_Code  : string    // Код КПС
, KPS_Name  : string    // Наименование КПС
, DopTariff : string    // Дополнительный тариф
, Class_WC  : string    // Класс условий труда
, sOsn      : string
, sMon      : string
, sDays     : string
, sHours    : string
, sMinutes  : string
, BornDate  : date
, LiveAddr  : string
)
with index
(
  mt_PersList01 = cDeptNRec + cPost + sPersFIO + PersNRec + dAppDate
);
//*****************************************************************************
table struct mt_PostPeriodVred
(
  NRec      : comp
, cStaffStr : comp
, dBegVred  : date
, dEndVred  : date
, cAdvises  : comp
, dLastAtt  : date
)
with index
(
  mt_PostPeriodVred01 = NRec(Unique),
  mt_PostPeriodVred02 = cStaffStr + cAdvises
);
//*****************************************************************************
var VInter     : CommonFiltr;
var iStrFunc   : StringFunctions;
var iPsnFuncs  : PersonsFunctions;       // для работы с таблицей Pesons
var iAppFuncs  : AppointmentsFunctions;
var EA         : iExtAttr;               // Интерфейс внешних атрибутов
var iAdrFunc   : AddressFunc;            // Переменная типа интерфейс AddressFunc
var Param_FP19 : FavourProf_Menu;

create view
var
  sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol
, sPodpis1Npp
, sPodpis2Npp            : string;

  Level         : word;
  _SearchMarker : LongInt;
  iCatFunc      : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  MadeReport    : boolean;
  IndexNoOt     : LongInt;
  RecordCount   : longint;

  liMarkerVred  : TPtr;

as select
  *
from
  Persons
, Passports StrahPassports
, Appointments MainAppoint
, Catalogs
, Catalogs  Catalogs2
, Catalogs  MainPostCat
, StaffStruct
, HistoryStr
, ExtCatLinks
, AttrNam
, AttrVal
, DepFunc
, PenStaj
, KatPodr
, KlChild4
, InfPsn1
, Advises
, ADVFEATURES
, APPENDIX 
, mt_PostPeriodVred
, mt_PodrList
, mt_PostList
, mt_PersList
, mt_PodrList  mt_PodrList2
, mt_PostList  mt_PostList2
, mt_PersList  mt_PersList2
, KatOrg
where 
((
   coGetTune('MyOrg')       == KatOrg.NRec
AND Persons.nrec            == StrahPassports.Person //
AND Integer(501)            == StrahPassports.SysCode
AND MainAppoint.Post        == MainPostCat.Nrec

AND mt_PodrList.cPodrNRec   == KatPodr.NRec
AND KatPodr.cFunc           == DepFunc.cFunc
AND mt_PodrList2.cDeptNRec  == mt_PostList2.cDeptNRec
AND mt_PodrList2.cDeptNRec  == mt_PersList2.cDeptNRec 
AND mt_PostList2.PostNRec   == mt_PersList2.cPost
))
;

parameters
  Param_FP19;

