VipInterface #(GPInt) Implements IGP_RKStat;
Interface #(GPInt);

const
#include Excel.inc;
end;
#include TotalOrganizationAttributes.var

table struct ttStatRK
(
  wRow  : word
, dbVal : array [1..2] of double
)
with index
(
  ttStatRK01 = wRow
);

table struct mtStatRKUniq
(
  cPsn  : comp
, wRow  : word
, isCurS: boolean
)
with index
(
  mtStatRKUniq00 = cPsn + wRow + isCurS
);

table struct ttSpecRK
(
  cPsn    : comp
, sTbNmb  : string
, sFIO    : string
, sEmplKat: string
, sModeEdu: string
, sInst : string
, sProvider : string
, sProgram : string
, sSpecCode: string
, sSpecName: string
, dFinish : date
, sReason : string
, sViObr  : string 
, sRows   : string
, wYear : word
, cOU   : comp
, cTema : comp
, liChas: longint
, dbPaySum: double
)
with index
(
  ttSpecRK00 = cPsn + wYear + cOU + cTema
, ttSpecRK01 = dFinish + sFIO
);

table struct mtEduCounter
(
  cPsn  : comp
, isCur : boolean
, cOU   : comp
, cTema : comp
)
with index
(
  mtEduCounter01 = cPsn + isCur + cOU + cTema
);

var
  dRep          : date;
  iCatFunc      : CatalogsFunctions;
  iAppFuncs     : AppointmentsFunctions;
  iExClFnc      : iExtClass;
  iChRPD        : GP_ChRPD;
  iUDR          : GP_UDR_RKStat;
  sFullName     : string;
  sPodr1        : string;
  mPodr1        : TPtr;
  sEdu1         : string;
  mEdu1         : TPtr;
  isFilterPodr  : boolean;
  wPrintRash    : word;
  wToExistFile  : word;
  sToExistFile  : string;
  wFromExistFile  : word;
  sFromExistFile  : string;
  cRecTopEduC   : comp;
  isStayAloneAll: boolean = false;
  sRowsPsn      : string;

#ifdef RKSTATDEBUG
  File LogFile;
#endif


create view
var
  dBeg
 ,dEnd   : date;
  __cApp : comp;
from
  ttStatRK
, ttSpecRK
, mtEduCounter
, mtStatRKUniq
, Education
, Appointments
, Persons
, Catalogs
, Catalogs CatReason
, Catalogs CatLevel
, ExClassVal
, ExClassSeg
, KlKatego
, ContDoc
//, StaffStruct
where
((
    dBeg<<= Education.ToDate (noindex) and (Education.ToDate <= dEnd)
and Education.Person == Persons.nRec
and Education.cContDoc == ContDoc.nRec
//-----------
and __cApp == Appointments.nRec
and Appointments.EmpCategory == KlKatego.nRec
))
;

function sSetPodrName(mSetPdr: TPtr): string;
{
  if (getMarkerCount(mSetPdr) = 0)
  {
    result := 'Все подразделения';
    exit;
  }
  else
    if (getMarkerCount(mSetPdr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько подразделений (' + string(getMarkerCount(mSetPdr)) + ')';
}

function sSetEduName(_mSetEdu: TPtr): string;
{
  if (getMarkerCount(_mSetEdu) = 0)
  {
    result := 'Не выбрано';
    exit;
  }
  else
    if (getMarkerCount(_mSetEdu) = 1)
    {
      var cTmp: comp = 0;
      GetMarker(_mSetEdu, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько видов (' + string(getMarkerCount(_mSetEdu)) + ')';
}

