procedure LocateSetRow(wRowT : word; isCur : boolean);
{
  if wRowT = 0 exit;
  //проверка на вхождение только один раз в одну строку
  if ( getfirst mtStatRKUniq where((  Persons.nRec == mtStatRKUniq.cPsn 
                                  and wRowT        == mtStatRKUniq.wRow 
                                  and isCur        == mtStatRKUniq.isCurS)) <> tsOk )
  {
    ClearBuffer(#mtStatRKUniq);
    mtStatRKUniq.cPsn   := Persons.nRec;
    mtStatRKUniq.wRow   := wRowT;
    mtStatRKUniq.isCurS := isCur;
    insert current mtStatRKUniq;
  }
  else
    exit;
  ClearBuffer(#ttStatRK);
  if getfirst ttStatRK where ((wRowT==ttStatRK.wRow))<>tsOk
  {
    ttStatRK.wRow := wRowT;
    insert current ttStatRK;
  }
  if isCur
    ttStatRK.dbVal[1] += 1
  else
    ttStatRK.dbVal[2] += 1;
  update current ttStatRK;
  sRowsPsn += to_char(wRowT)+', ';
}

procedure LocateSetRowVal(wRowT : word; dbVal: double; isCur : boolean);
{
  if wRowT = 0 exit;
  
  //проверка на вхождение только один раз в одну строку
  if ( getfirst mtStatRKUniq where((  Persons.nRec == mtStatRKUniq.cPsn 
                                  and wRowT        == mtStatRKUniq.wRow 
                                  and isCur        == mtStatRKUniq.isCurS)) <> tsOk )
  {
    ClearBuffer(#mtStatRKUniq);
    mtStatRKUniq.cPsn   := Persons.nRec;
    mtStatRKUniq.wRow   := wRowT;
    mtStatRKUniq.isCurS := isCur;
    insert current mtStatRKUniq;
  }
  else
    exit;
  //еще костыль по кривым данным
  if ( trim(sRowsPsn) = '14,')
    exit;

  ClearBuffer(#ttStatRK);
  if ( getfirst ttStatRK where ((wRowT==ttStatRK.wRow)) <> tsOk )
  {
    ttStatRK.wRow := wRowT;
    insert current ttStatRK;
  }
  if isCur
    ttStatRK.dbVal[1] += dbVal
  else
    ttStatRK.dbVal[2] += dbVal;
  update current ttStatRK;
}
procedure LocateSetRowPost(wRowT : word; dbValT : double);
{
  ClearBuffer(#ttStatRK);
  if ( getfirst ttStatRK where ((wRowT==ttStatRK.wRow)) <> tsOk )
  {
    ttStatRK.wRow := wRowT;
    insert current ttStatRK;
  }
  ttStatRK.dbVal[1] := dbValT;
  update current ttStatRK;
}
procedure LocateSetRowPrev(wRowT : word; dbValT : double);
{
  if wRowT = 0 exit;
  ClearBuffer(#ttStatRK);
  if getfirst ttStatRK where ((wRowT==ttStatRK.wRow))<>tsOk
  {
    ttStatRK.wRow := wRowT;
    insert current ttStatRK;
  }
  ttStatRK.dbVal[2] := dbValT;
  update current ttStatRK;
}

function LocateReturnRow(wRowT : word; var dbValT1,dbValT2 : double) : boolean;
{
  result := false;
  if wRowT = 0 exit;
  if getfirst ttStatRK where ((wRowT==ttStatRK.wRow))=tsOk
  {result :=  true; dbValT1 := ttStatRK.dbVal[1]; dbValT2 := ttStatRK.dbVal[2];}
}

function isCurSet(dAny : date) : boolean;
{
  if dAny >= date( 1, 1,Year(dRep)) and dAny <= dRep
    result := true
  else
    result := false;
}

function isMultiEduPsn(_cPsn: comp; _isCurPeriod: boolean; _cOU, _cTema: comp): boolean;
{
  var iCounterEdu: integer = 0;
  result := false;
  if ( getfirst mtEduCounter where((  _cPsn        == mtEduCounter.cPsn 
                                  and _isCurPeriod == mtEduCounter.isCur
                                  and _cOU         == mtEduCounter.cOU  
                                  and _cTema       == mtEduCounter.cTema
                                  )) <> tsOk )
  {
    ClearBuffer(#mtEduCounter);
    mtEduCounter.cPsn  := _cPsn;
    mtEduCounter.isCur := _isCurPeriod;
    mtEduCounter.cOU   := _cOU;  
    mtEduCounter.cTema := _cTema;
    insert current mtEduCounter;
  }

  _loop mtEduCounter where ((_cPsn == mtEduCounter.cPsn and _isCurPeriod == mtEduCounter.isCur))
    iCounterEdu++;

  // если 1 - то образование 1 - не подходит для 14й строки
  // если 2 - то добавляем к 14й строке
  // если больше 2х - то уже вывели в 14ю когда было 2 и уже не надо
  if ( iCounterEdu = 2 )
    result := true;
}

procedure SetRowSpec;//(cRecAny : comp);
{
  if ( wPrintRash = 0 )
    exit;

  ClearBuffer(#ttSpecRK);
  
  if ( getfirst ttSpecRK where ((  Persons.nRec           == ttSpecRK.cPsn
                               and Year(Education.ToDate) == ttSpecRK.wYear
                               and Education.Name         == ttSpecRK.cOU
                               and Education.cAddInf1     == ttSpecRK.cTema
                               )) <> tsOk )
  {
    ttSpecRK.cPsn   := Persons.nRec;
    ttSpecRK.sTbNmb := if(Persons.StrTabN = '', Persons.TabNmb, Persons.StrTabN);
    ttSpecRK.sFIO   := Persons.FIO;
    if isvalid(#KlKatego)
      ttSpecRK.sEmplKat := KlKatego.NaiKat;
    ttSpecRK.sModeEdu := iCatFunc.GetCatalogsName(Education.Mode);
    ttSpecRK.sInst := iCatFunc.GetCatalogsName(Education.Name);
    ttSpecRK.cOU   := Education.Name;
    ttSpecRK.cTema := Education.cAddInf1;
    ttSpecRK.liChas:= Education.Nmb2;
    //еще один костыль
    if ( trim(sRowsPsn) <> '14, 17,')
      ttSpecRK.dbPaySum:= Education.PaySum;
    ttSpecRK.wYear := Year(Education.ToDate);
    if getfirst ExClassVal where((Education.Name == ExClassVal.cRec and word(31) == ExClassVal.ClassCode)) = tsOk
      if getfirst ExClassSeg where((ExClassVal.cClassSeg == ExClassSeg.nRec)) = tsOk
        ttSpecRK.sProvider := ExClassSeg.Name;
    if Education.cQualType <> 0
      ttSpecRK.sProgram := iCatFunc.GetCatalogsName(Education.cQualType)
    else
      ttSpecRK.sProgram := 'Базовое';
    ttSpecRK.sSpecCode := iCatFunc.GetCatalogsCode(Education.Speciality);
    ttSpecRK.sSpecName := iCatFunc.GetCatalogsName(Education.Speciality);   
    ttSpecRK.dFinish := Education.ToDate;
    ttSpecRK.sReason := iCatFunc.GetCatalogsName(Education.cReason);
    ttSpecRK.sViObr  := iCatFunc.GetCatalogsName(Education.Level);
    ttSpecRK.sRows   := sRowsPsn;
    insert current ttSpecRK;
  }
  else
  {
    ttSpecRK.sRows    += sRowsPsn;
    // дальше пошли костыли по кривым приказам
    if ( ttSpecRK.dbPaySum = 0.00 )
      ttSpecRK.dbPaySum := Education.PaySum;
    if ( pos('14,', sRowsPsn) = 0 )
      if ( pos('17,', sRowsPsn) <> 0 )
        if ( Education.PaySum <> 0.00 )
          ttSpecRK.dbPaySum := Education.PaySum;
    if ( ttSpecRK.liChas = 0 )
      ttSpecRK.liChas   := Education.Nmb2;
    if ( pos('17,', sRowsPsn) <> 0 )
      if ( trim(iCatFunc.GetCatalogsName(Education.cReason)) <> '')
        ttSpecRK.sReason := iCatFunc.GetCatalogsName(Education.cReason);
    update current ttSpecRK;
  }
}

function OpenFromRKS : boolean;
{
  result := false;
  xlOpenExcel(true);
  xlDisplayAlerts(false);
  if xlOpenWorkBook(sFromExistFile)
    result := true;
}
function CloseFromRKS : boolean;
{
  result := false;
  if xlCloseWorkBookByName(sFromExistFile)
//  if xlKillExcel
    result := true;
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
  xlDisplayAlerts(true);
  if isStayAloneAll
    xlKillExcel;
}

procedure MakeRK;
{
  var dbValT       : array [1..2] of double;
  var wRowT        : word;
  var wRowKat      : word;
  var wRowProgramm : word;
  var cRecSST      : comp;
  var i            : integer;
  var isCurSetT    : boolean;

#ifdef RKSTATDEBUG
LogFile.OpenFile(/*GetStringParameter('Files','TmpFilesDirectory', 0)+*/'RKSTAT_11k.log',stCreate);
//LogFile.WriteLN('Version = '+sVerResource);
#endif

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Формируются данные для Листа 11-к.', 0);
  if (GetMarkerCount(mPodr1) > 0) isFilterPodr:=true else isFilterPodr:=false;
  set dBeg := date(1,1,Year(dRep)-1);
  set dEnd := dRep;
  cRecTopEduC := iCatFunc.GetCatalogsNRec(-9);

  if isvalid(#Education)
  _loop Education
  {
    if isvalid(#ContDoc)
    {
      if ( ContDoc.TypeOper <> 35 and  ContDoc.TypeOper <> 135)
        continue;
    }
    else
      continue;
    if ( not iChRPD.isConfirmed(ContDoc.nRec) )
      continue;

    isCurSetT := isCurSet(Education.ToDate);
    if ( wFromExistFile = 1 )
      if not isCurSetT
        continue;

    if not FoundMarker(mEdu1, Education.Level)
      continue;

    if (not NextVisual) break;
    if ( not IsValid(#Persons) ) continue;
    if ( Persons.IsEmployee <> 'С' and Persons.IsEmployee <> 'У' ) continue;
    if ( Education.Mode = comp(0) ) continue;
    if ( not isSetCurApp(Education.Person, Education.ToDate) ) continue;
//    cRecSST := cWhatStEdShRs(Education.Person, Education.ToDate);
    if isDeptNot4Report/*(cRecSST)*/ continue;
    sRowsPsn := '';
    wRowKat  := wWhatRowKat/*(cRecSST)*/;
    LocateSetRow(3,isCurSetT);    
    LocateSetRow(wRowKat+6,isCurSetT);    
//    if getfirst ttSpecRK where((Education.Person == ttSpecRK.cPsn)) = tsOk
    //еще для костыля
    var isMultiEduPsnFlag: boolean = isMultiEduPsn(Education.Person, isCurSetT, Education.Name, Education.cAddInf1);
    if isMultiEduPsnFlag
      LocateSetRow(14, isCurSetT);    
//    wRowProgramm := 999;
    wRowProgramm := wWhatRowProgramm(Education.Level, Education.CREASON);
    if ( wRowProgramm <> 0 ) //and ( not isMultiEduPsnFlag ) )
    {
      LocateSetRow(wRowProgramm, isCurSetT);    
      if not isMultiEduPsnFlag
        if ( Education.PaySum <> 0.00)
          LocateSetRowVal(wRowProgramm+1, Education.PaySum, isCurSetT);
    }
    LocateSetRow(wWhatRowForma(Education.Mode),isCurSetT);    
    LocateSetRow(wWhatRowProvider(Education.Name), isCurSetT);    
    if ( wRowProgramm = 21 )
      LocateSetRow(wRowKat+59, isCurSetT);    
    LocateSetRow(wWhatRowLongProgramm,isCurSetT);    

//#ifdef RKSTATDEBUG
//if ( wWhatRowProvider = 46 ) 
//  LogFile.WriteLN('Persons.FIO='+Persons.FIO+' wWhatRowProvider='+wWhatRowProvider+' wWhatRowForma='+wWhatRowForma+' wRowProgramm='+wRowProgramm);
//#endif

    SetRowSpec;//(cRecSST); //должна быть последней строкой в  цикле.
  }
  if ( wFromExistFile = 1 ) //считываем за прошлый год если из файла
  {
    if OpenFromRKS
    {
      if xlSetActiveSheetByName('11-к')
      { //xlGetCellValue
        var dbFrom: double = 0;
        
        if xlGetCellValue( 7, 4, dbFrom)
          LocateSetRowPrev( 3, dbFrom);
        
        for(i:=10; i<=18; i+=2)
        {
          dbFrom := 0;
          if xlGetCellValue( i, 4, dbFrom)
            LocateSetRowPrev( i-4, dbFrom);
        }
        for(i:=21; i<=37; i+=4)
        {
          dbFrom := 0;
          if xlGetCellValue( i, 4, dbFrom)
            LocateSetRowPrev( i-4, dbFrom);
        }
        for(i:=41; i<=59; i+=3)
        {
          dbFrom := 0;
          if xlGetCellValue( i, 4, dbFrom)
            LocateSetRowPrev( i-4, dbFrom);
        }
        for(i:=63; i<=81; i+=2)
        {
          dbFrom := 0;
          if xlGetCellValue( i, 4, dbFrom)
            LocateSetRowPrev( i-4, dbFrom);
        }
      }
      if CloseFromRKS {}
    }
  }
  
  //вычисляем коэффициенты к прошлому году
  if isvalid(#ttStatRK)
  {
    var dbRas: array[1..2] of double;

/*
    dbRas[1] := dbRas[2] := 0;
    if LocateReturnRow( 3, dbValT[1], dbValT[2]) {dbRas[1] := dbValT[1]; dbRas[2] := dbValT[2];}
    if LocateReturnRow(17, dbValT[1], dbValT[2]) {dbRas[1] -= dbValT[1]; dbRas[2] -= dbValT[2];}
    if LocateReturnRow(25, dbValT[1], dbValT[2]) {dbRas[1] -= dbValT[1]; dbRas[2] -= dbValT[2];}
    if LocateReturnRow(29, dbValT[1], dbValT[2]) {dbRas[1] -= dbValT[1]; dbRas[2] -= dbValT[2];}
    if LocateReturnRow(33, dbValT[1], dbValT[2]) {dbRas[1] -= dbValT[1]; dbRas[2] -= dbValT[2];}
    LocateSetRowVal(21, dbRas[1], true); LocateSetRowVal(21, dbRas[2], false); 
*/

    dbRas[1] := dbRas[2] := 0;
    dbValT[1] := dbValT[2] := 0;
    if LocateReturnRow( 3, dbValT[1], dbValT[2]) {dbRas[1] := dbValT[1]; dbRas[2] := dbValT[2];}
    dbValT[1] := dbValT[2] := 0;
    if LocateReturnRow(46, dbValT[1], dbValT[2]) {dbRas[1] -= dbValT[1]; dbRas[2] -= dbValT[2];}
    dbValT[1] := dbValT[2] := 0;
    if LocateReturnRow(49, dbValT[1], dbValT[2]) {dbRas[1] -= dbValT[1]; dbRas[2] -= dbValT[2];}
    dbValT[1] := dbValT[2] := 0;
    if LocateReturnRow(55, dbValT[1], dbValT[2]) {dbRas[1] -= dbValT[1]; dbRas[2] -= dbValT[2];}
    LocateSetRowVal(52, dbRas[1], true); LocateSetRowVal(52, dbRas[2], false); 

    dbValT[1] := dbValT[2] := 0;
    if LocateReturnRow(3, dbValT[1],dbValT[2])
      LocateSetRowPost(5,if(dbValT[2]<>0,dbValT[1]/dbValT[2],0));
    for(i:=6;i<=12;i+=2)
    {
      dbValT[1] := dbValT[2] := 0;
      if (not NextVisual) break;
      if LocateReturnRow(i, dbValT[1], dbValT[2])
        LocateSetRowPost(i+1,if(dbValT[2]<>0,dbValT[1]/dbValT[2],0));
    }
    dbValT[1] := dbValT[2] := 0;
    if LocateReturnRow(14, dbValT[1],dbValT[2])
      LocateSetRowPost(16,if(dbValT[2]<>0,dbValT[1]/dbValT[2],0));
    
    var dbKol: double = 0;
    for(i:=17;i<=33;i+=4)
    {
      dbValT[1] := dbValT[2] := 0;
      if (not NextVisual) break;
      if LocateReturnRow(i, dbValT[1], dbValT[2])
        LocateSetRowPost(i+2,if(dbValT[2]<>0,dbValT[1]/dbValT[2],0));
      if ( dbValT[1] <> 0 )
      {
        dbKol := dbValT[1];
        dbValT[1] := dbValT[2] := 0;
        if LocateReturnRow(i+1, dbValT[1], dbValT[2])
          LocateSetRowPost(i+1, (dbValT[1]/dbKol));
      }
    }
    for(i:=37;i<=43;i+=3)
    {
      dbValT[1] := dbValT[2] := 0;
      if (not NextVisual) break;
      if LocateReturnRow(i, dbValT[1], dbValT[2])
        LocateSetRowPost(i+2,if(dbValT[2]<>0,dbValT[1]/dbValT[2],0));
    }
    for(i:=46;i<=55;i+=3)
    {
      dbValT[1] := dbValT[2] := 0;
      if (not NextVisual) break;
      if LocateReturnRow(i, dbValT[1], dbValT[2])
        LocateSetRowPost(i+2,if(dbValT[2]<>0,dbValT[1]/dbValT[2],0));
    }
    for(i:=59;i<=77;i+=2)
    {
      dbValT[1] := dbValT[2] := 0;
      if (not NextVisual) break;
      if LocateReturnRow(i, dbValT[1], dbValT[2])
        LocateSetRowPost(i+1,if(dbValT[2]<>0,dbValT[1]/dbValT[2],0));
    }
  }
  StopVisual;
#ifdef RKSTATDEBUG
LogFile.Close;
#endif
}

function isDataRK : boolean;
{
  if isvalid(#ttStatRK)
    result := true
  else
    result := false;
}

procedure PrintRK;
{
  var dbValT  : array [1..2] of double;
  var i : integer;

  if isDataRK
  if xlSetActiveSheetByName('11-к')
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Выгружаю данные для Листа 11-к в Excel.', 0);
    TOA.Bind(0);
    xlSetCellStringValue(Trim(TOA1.GetNaming.GetFullName()),2,3,2,3);
//    xlSetCellStringValue(DateToStr(dRep,'DD.MM.YYYY'),3,3,3,3); // в представленном заказчиком файле такая дата красная.
    xlSetCellDateValue(dRep,3,3,3,3);
    for(i:=3;i<=79;i++)
    {
      if (not NextVisual) break;
      if LocateReturnRow(i, dbValT[1], dbValT[2])
      {
        xlSetCellNumberValue(dbValT[1],4+i,4,4+i,4); 
      }
    }

    StopVisual;
  }
}

procedure SaveRK;
{
  iUDR.SaveMarker('RKS11_mPodr1', mPodr1);
  iUDR.SaveMarker('RKS11_mEdu1' , mEdu1 );
//  DoneMarker(mPodr1, '');
//  DoneMarker(mEdu1 , '');

  iUDR.SaveDate  ('RKS11_dRep'        , dRep        );
  iUDR.SaveWord  ('RKS11_wToExistFile', wToExistFile);
  iUDR.SaveString('RKS11_sToExistFile', sToExistFile);
  iUDR.SaveWord  ('RKS11_wPrintRash'  , wPrintRash  );
  iUDR.SaveWord  ('RKS11_wFromExistFile', wFromExistFile);
  iUDR.SaveString('RKS11_sFromExistFile', sFromExistFile);
}
procedure ClearRK;
{
  delete all from ttStatRK;
}
procedure initRK;
{
  set dRep := iUDR.ReadDate('RKS11_dRep');
  if dRep = 0
    set dRep := To_Date(31,12,Year(Cur_Date));

  set wPrintRash   := iUDR.ReadWord  ('RKS11_wPrintRash'  );
  set sToExistFile := iUDR.ReadString('RKS11_sToExistFile');
  set wToExistFile := iUDR.ReadWord  ('RKS11_wToExistFile');
  set sFromExistFile := iUDR.ReadString('RKS11_sFromExistFile');
  set wFromExistFile := iUDR.ReadWord  ('RKS11_wFromExistFile');
  if wToExistFile = 1 
    ToggleFieldVisible(#sToExistFile,true )
  else
    ToggleFieldVisible(#sToExistFile,false);
  if wFromExistFile = 1 
    ToggleFieldVisible(#sFromExistFile,true )
  else
    ToggleFieldVisible(#sFromExistFile,false);
    
  if (not (ReadMyDsk(wPrintRash, 'RKS11_wPrintRash', false)))
    set wPrintRash := 1;
 
  mPodr1     := iUDR.ReadMarker('RKS11_mPodr1');
  set sPodr1 := sSetPodrName(mPodr1);
  mEdu1      := iUDR.ReadMarker('RKS11_mEdu1');
  set sEdu1  := sSetEduName(mEdu1);
}

function isCheckRepParam(isStayAlone : boolean) : boolean;
{
  result := false;
  if ( dRep = 0 )
    {if isStayAlone message('Не задана дата!'); exit;}
  if ( Day(dRep) <> 31 and Month(dRep) <> 12 )
  {
    if isStayAlone
      if ( message('Дата формирования отчета отличается от регламентной!'#3+chr(13)+'Продолжить?'#3, Information+yesNo) <> cmYes )
        exit;
  }
//    {if isStayAlone message('Некорректно задана дата!'+chr(13)+'Дата формирования отчета - 31 декабря.'); exit;}
  if ( wToExistFile = 1 )
    if not ExistFile(sToExistFile)
      {if isStayAlone message('Ошибка открытия файла!'); exit;}
  if ( wFromExistFile = 1 )
    if not ExistFile(sFromExistFile)
      {if isStayAlone message('Ошибка открытия входного файла!'); exit;}
  if ( getMarkerCount(mEdu1) = 0 )
    {if isStayAlone message('Не заданы виды образования!', Error); exit;}
  result := true;
}
