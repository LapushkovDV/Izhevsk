{
  result := false;
  set __cApp := iAppFuncs.GetAppNrec_OnDate(cRecAny, To_Date(31,12,Year(dAny)));
  if isvalid(#Appointments) 
    result := true;
/*
  if GetFirst Appointments where((iAppFuncs.GetAppNrec_OnDate(cRecAny, To_Date(31,12,Year(dAny))) == Appointments.NRec)) = tsOk
      result := Appointments.nRec;
*/
}

function wWhatRowKat/*(cRecAny : comp)*/ : word;
{
  result := 999;
/*
  if getfirst StaffStruct where((cRecAny == StaffStruct.nRec)) = tsOk
  if getfirst KlKatego where((StaffStruct.EmpCategory == KlKatego.nRec)) = tsOk
*/
  if isvalid(#KlKatego)
  {
    case KlKatego.Kod of
    5    : result := 0;
    6    : result := 2;
    1..4 : result := 4;
    7    : result := 6;
    end;
  }
  
}

function isDeptNot4Report/*(cRecAny : comp)*/ : boolean;
{
  result := false;
  if isFilterPodr
//  if getfirst StaffStruct where((cRecAny == StaffStruct.nRec)) = tsOk
    if (not FoundMarker(mPodr1,Appointments.Department))
      result := true;
}

function wWhatRowProgramm(_cRecAny1, _cRecAny2: comp) : word; cacheable;//wWhatRowProgramm(Education.Level, Education.CREASON)
{
  var wResult : word = 0;
  result := 0;

  if ( _cRecAny2 <> comp(0) )
  {
    var sNameReason: string = Trim(iExClFnc.GetSegName(31, _cRecAny2));
    if ( sNameReason <> '')
      case sNameReason of
      'обязательное обучение (для оснований повышения квалификации)' : wResult := 17;
      end;
    if ( wResult = 0 )
      if ( getfirst CatReason where((_cRecAny2 == CatReason.nRec)) = tsOk )
      {
        sNameReason := Trim(iExClFnc.GetSegName(31, CatReason.cParent));
        if ( sNameReason <> '')
          case sNameReason of
          'обязательное обучение (для оснований повышения квалификации)' : wResult := 17;
          end;
      }
  }
 
  var sNameLevel: string = Trim(iExClFnc.GetSegCode(31, _cRecAny1));
  if ( wResult = 0 )
    if ( sNameLevel <> '')
      case sNameLevel of
      'ОПДП' : wResult := 33;
      end;
  if ( wResult = 0 )
    if ( getfirst CatLevel where((_cRecAny1 == CatLevel.nRec)) = tsOk )
    {
      sNameLevel := Trim(iExClFnc.GetSegCode(31, CatLevel.cParent));
      if ( sNameLevel <> '')
        case sNameLevel of
        'ОПДП' : wResult := 33;
        end;
    }

  
  var sNameQual : string= Trim(iCatFunc.GetCatalogsName(_cRecAny1));
  if ( wResult = 0 )
    if ( sNameQual <> '')
      case sNameQual of
        'Программа развития кадрового резерва':   wResult := 25;
        'Обучение в рамках Федеральных программ': wResult := 29;
      end;

  if ( wResult = 0 )
    wResult := 21;

  result := wResult;
}

function wWhatRowForma(_cRecAny: comp) : word; cacheable;//wWhatRowForma(Education.Mode)
{
  var sCodeForma : string;

  result := 999;

  sCodeForma := iCatFunc.GetCatalogsCode(_cRecAny);
  case sCodeForma of
    '1': result := 37;
    '2': result := 40;
    '4': result := 43;
  else   result :=999; 
  end;
  if ( result = 999 )
  {
    sCodeForma := iCatFunc.GetCatalogsName(_cRecAny);
    case sCodeForma of
    'Дистанционное': result := 43;
    end;
  }
}

function wWhatRowProvider(_cRecAny: comp) : word; cacheable;
{
  var sCodeProvider: string = Trim(iExClFnc.GetSegCode(31, _cRecAny));
  result := 999;
/*
  if getfirst ExClassVal where((Education.Name == ExClassVal.cRec and word(31) == ExClassVal.ClassCode)) = tsOk
    if getfirst ExClassSeg where((ExClassVal.cClassSeg == ExClassSeg.nRec)) = tsOk
*/
  if ( sCodeProvider <> '')
    case sCodeProvider of
    'ССП' : result := 46;
    'ОТР' : result := 49;
  //      'ВПРФ': result := 52;
    'ВП'  : result := 55;
    end;
}

