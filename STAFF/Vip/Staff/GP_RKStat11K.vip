function OpenNewRKS : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExistRKS : boolean;
{
  result := false;
  if xlOpenExcel(true)
  {
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlOpenWorkBook(sToExistFile)
      result := true;
  }
}

function SetParamRK : boolean;
{
  result := false;
  if RunWindowModal(WinRKParam)=cmDefault
    result := true;
}

procedure PrintRash;
{
  var lLine : longint;
  var lRB, lRE, lCB, lCE : longint = 1;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Печать расшифровки.', 0);
  lRB := lRE := 2;
  lCB := 1;
  lLine:=0;
  xlMergeCells(1,1,1,4);
  xlSetCellStringValue('Расшифровка листа 11-к. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
  if isvalid(#ttSpecRK)
  {
    lCE := 0;
    lCE++; xlSetCellStringValue('№пп',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Год',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Табельный №',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Категория',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Форма обучения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Учебное заведение',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Поставщики образовательных услуг',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Программы',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Вид образования',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Основание',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Код'+chr(10)+'специальности'+chr(10)+'по диплому',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Специальность по диплому',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Тема обучения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Часов',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Стоимость'+chr(10)+'обучения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Строки',lRE,lCE,lRE,lCE);
    lRE++;
    
    var lRecCount: longint = recordsintable(#ttSpecRK);
    xlSetNumberFormat('@', lRE, 3, lRE+lRecCount, 3);
    xlSetNumberFormat('# ##0,00;-# ##0,00;', lRE, 16, lRE+lRecCount, 16);

    var wMatrixSizeRow: word = 100;
    if (not xlCreateMatrix(wMatrixSizeRow, lCE))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    var lRowMatrix: longint = 1;
    var lRowCurMx : longint = lRE;

    #define FrmCl lRowMatrix, lCE
    _loop ttSpecRK ordered index ttSpecRK01
    {
      if (not NextVisual) break;
      lCE := 0;
      lCE++; xlStWriteToMatrix(#FrmCl, ++lLine               );
      lCE++; xlStWriteToMatrix(#FrmCl, Year(ttSpecRK.dFinish));
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sTbNmb       );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sFIO         );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sEmplKat     );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sModeEdu     );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sInst        );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sProvider    );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sProgram     );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sViObr       );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sReason      );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sSpecCode    );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sSpecName    );
      lCE++; xlStWriteToMatrix(#FrmCl, iCatFunc.GetCatalogsName(ttSpecRK.cTema));
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.liChas       );
      lCE++; xlDoWriteToMatrix(#FrmCl, ttSpecRK.dbPaySum     );
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sRows        );
      lRE++;
      lRowMatrix++;
      
      if ( lRowMatrix > wMatrixSizeRow )
      {
        if (not xlWriteMatrixToExcel(lRowCurMx, 1))
          message('Ошибка функции xlWriteMatrixToExcel.', error);
        xlFreeMatrix;
        lRowCurMx += wMatrixSizeRow;
        lRowMatrix := 1;
        if (not xlCreateMatrix(wMatrixSizeRow, lCE))
        {
          message('Ошибка функции xlCreateMatrix.', error);
          xlKillExcel;
          StopVisual;
          exit;
        }
      }
    }
    if (not xlWriteMatrixToExcel(lRowCurMx, 1))
      message('Ошибка функции xlWriteMatrixToExcel.', error);
    xlFreeMatrix;
  }
  lRE--;
  xlWrapText(lRB,lCB,lRB,lCE);
  xlAutoFit(lRB+1,lCB,lRE,lCE);
  xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
  StopVisual;
}

procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  initRK;

  if isStayAlone
    if SetParamRK
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);

  if isDoRep
  {
    MakeRK;
    if isDataRK
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNewRKS  ;}
        if wToExistFile = 1 {isOkFile := OpenExistRKS;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        PrintRK;

        if (wPrintRash = 1) and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='11-к' break;
          }
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 11-К'); 
          xlSetActiveSheet(i);
          PrintRash;
        }

        xlSetActiveSheetByName('11-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }
    else if isStayAlone message('Нет данных для отчета.');
  }
  SaveRK;
  ClearRK;
  closeinterface(cmDefault);
}
//++++++++++++++++++++++++++++++++++++++++++++++++
//--------------------------------------------------------
function bSetRepParam : boolean;  
{
  result := false;
  if RunWindowModal(WinRKParamEx)=cmDefault
    result := true;
}//function bSetRepParam
Function GetReportName: String;
{
  GetReportName := '#(GPNam) (ЭМ)';
}
function GetPriority : Integer;
{
  GetPriority := 11;
}
procedure initRKStatRepParam;
{
  initRK;
}
function dRepOnDateParam : date;
{
  dRepOnDateParam := dRep;
}
//--------------------------------------------------------
handleevent
  cmInit:
  {
    isStayAloneAll := true;
    PrintRepPage(true);
  }
  cmPick:
  {
    case CurField of
      #sPodr1:
        if (RunInterface('PICKCATALOGEX', -11, 0, Comp(100), mPodr1) = cmDefault)
          set sPodr1 := sSetPodrName(mPodr1);
      #sEdu1:
        if (RunInterface('PICKCATALOGEX', -9, 0, Comp(100), mEdu1) = cmDefault)
          set sEdu1 := sSetEduName(mEdu1);
      #sToExistFile:
      {
        set sToExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
      #sFromExistFile:
      {
        set sFromExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sPodr1:        {ClearMarker(mPodr1); set sPodr1 := sSetPodrName(mPodr1);}
      #sEdu1:         {ClearMarker(mEdu1);  set sEdu1  := sSetEduName(mEdu1);}
      #sToExistFile:  {set sToExistFile:='';}
      #sFromExistFile:{set sFromExistFile:='';}
    end;
  }
  cmCheckField:
  {
    case CurField of
      #wToExistFile:
      {
        if wToExistFile = 1 
          ToggleFieldVisible(#sToExistFile,true )
        else
          ToggleFieldVisible(#sToExistFile,false);
      }
      #wFromExistFile:
      {
        if wFromExistFile = 1 
          ToggleFieldVisible(#sFromExistFile,true )
        else
          ToggleFieldVisible(#sFromExistFile,false);
      }
    end;
  }
end;


End.
//---------------------------------------------------------------------------------
#include UserReport.vih
VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;
Procedure Run;
{
  runinterface(#(GPInt));
}
Function GetReportName: String;
{
  GetReportName := '#(GPNam) (ЭМ)';
}
Function GetGroupName (Level : Word) : String;
{
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Формы "Роскосмоса"';
  End;
}
function GetPriority : Integer;
{
  GetPriority := 3;
}
function VisibleInModule(Ind : Byte) : String;
{
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
}
End.
