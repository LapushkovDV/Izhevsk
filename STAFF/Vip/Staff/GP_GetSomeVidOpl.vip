/*************************************************************************************************\
* Наименование:  Множественный выбор нескольких Видов Оплат                                       *
* Контур/Модуль:                                                                                  *
* Примечание:    Интерфейс множественного выбора значений Видов Оплат                             *
*                Возвращает маркер с НРЕКами выбранных позиций (KlVidOpl.nrec)                    *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#819          |22/03/18|Потапов А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

/*
Интерфейс множественного выбора значений KlVidOpl
Возвращает маркер с KlVidOpl.nrec

Параметры:
mVidOplSelected - возвращаемый маркер
wMode          - режим работы
  0 - тихо заполняет маркер всеми значениями классификатора
  1 - запускает окно выбора
*/

Interface GP_GetSomeVidOpl 'Множественный выбор нескольких значений Видов оплат' EscClose, Cyan;

var
  mVidOplSelected : tPtr;
  wMode : word;

create view
as select
  if (IsValid(tnKlVidOpl),
   (if(FoundMarker(mVidOplSelected, KlVidOpl.nrec), '√', '')),
   ' ')
   (FieldName = isVidOplSelected),
  *
from
  KlVidOpl (KLVIDOPL04)
;

parameters mVidOplSelected, wMode;

!-------------------------------------------------------------------------------
Browse brGP_KlVidOpl ('Выбор значения', , sci1Esc);
Table KlVidOpl;
Fields
  { Font = { Color = if((isVidOplSelected = '√'), ColorMark, 0) }};

  isVidOplSelected '' ('',, sci1EnIns): [3], Protect, Centered, NoAutoSize;

  KlVidOpl.VIDOPLP 'Код вида оплаты'
                    ('Код вида оплаты',, sci1EnIns): [8],
                    Protect, Centered, NoAutoSize;
  KlVidOpl.NVIDOPL 'Наименование Оплаты'
                    ('Наименование Оплаты',, sci1EnIns): [22],
                    Protect;
end;
!-------------------------------------------------------------------------------
HandleEvent
  cmInit:
  {
    if wMode = 0
    {
      ClearMarker(mVidOplSelected);
      _loop KlVidOpl
        InsertMarker(mVidOplSelected, KlVidOpl.nrec);
      CloseInterface(cmDefault);
    }
    if ( getfirst KlVidOpl = tsOk ) {}
  }
  cmSelAll:
  {
    ClearMarker(mVidOplSelected);
    _loop KlVidOpl
      InsertMarker(mVidOplSelected, KlVidOpl.nrec);
    ReReadRecord(#KlVidOpl);
  }
  cmUnSelAll:
  {
    ClearMarker(mVidOplSelected);
    ReReadRecord(#KlVidOpl);
  }    
  cmDoMarkUnMark:
  {
    if ( not FoundMarker(mVidOplSelected, KlVidOpl.nrec) )
      InsertMarker(mVidOplSelected, KlVidOpl.nrec)
    else
      DeleteMarker(mVidOplSelected, KlVidOpl.nrec);
    if ( getnext KlVidOpl = tsOk ) {}
    ReReadRecord(#KlVidOpl);
  }
  cmDefault :
  {
    if ( GetMarkerCount(mVidOplSelected) = 0 )
      InsertMarker(mVidOplSelected, KlVidOpl.nrec);
    CloseInterface(cmDefault);
  }
  cmCancel:
  {
    CloseInterface(cmCancel);
  }
end;
end.
