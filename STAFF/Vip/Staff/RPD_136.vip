#component "Z_StaffOrders"

#include RPD.vih
#include WorkWithContract.vih
#include GP_RepLaborContract.vih

vipInterface RPD_136(RPD_35)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  function IRPD_Base2.GetPanel4Agreement: LongInt;
end;

interface RPD_136 escClose;

  create view
    as select
      WWC.GetContractString(Appointments.ResComp[1]) (fieldname = ContractStr);

  overloadFormats scrDet35;

  screen scrDet35 (, hcStaffWinPr, scStaffMyPnl);
    table Education;
    fields
      LeadPersons.FIO ('Преподаватель / наставник',, scStaffMyPnlPick): protect;
      EduLevelCat.Name ('Вид образования', hcStaffPersonsEducation, scStaffMyPnlPick): protect;
      EduModeCat.Name ('Форма обучения', hcStaffEduName, scStaffMyPnlPick): protect;
      EduNameCat.Name ('Наименование учебного заведения', hcStaffEduName, scStaffMyPnlPick): protect;
      TopicEductCat.Name ('Тема обучения',, scStaffMyPnlPick): protect;
      EduSpecialityCat.Name ('Специальность', hcStaffEduSpeciality, scStaffMyPnlPick): protect;
      Education.PaySum ('Сумма обучения'): [10.3];
      UOWrkTabel.Num ('Условное обозначение',, scStaffMyPnlPick): protect;
      Education.FromDate ('Дата поступления', hcStaffEduFromDate): noProtect;
      Education.ToDate ('Дата окончания', hcStaffEduToDate): noProtect;
      Education.LastDate ('Дата квалификационного экзамена'): noProtect;
      Education.LastTime ('Время квалификационного экзамена'): noProtect;
      EduReasonCat.Name ('Основание для обучения',, scStaffMyPnlPick): protect;
      ContDoc.SBottom ('График занятий', hcStaffWinPr), noProtect;
      ContractStr ('Доп. соглашение к трудовому договору'): protect, pickButton;
    buttons
      cmViewAdvance1,,, 'Просмотр примечания к приказу', hcStaffWinPr;
    <<
`Преподаватель`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Вид образования`         .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Форма обучения`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Учебное заведение`       .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Тема обучения`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Специальность`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Стоимость`               .@@@@@@@@@@@    `Условное обозначение`.@@@@@@@@@@@
`Дата начала`             .@@@@@@@@@@@    `Дата окончания`      .@@@@@@@@@@@
`Дата экзамена`           .@@@@@@@@@@@    `Время экзамена`      .@@@@@@@@@@@
`Основание для обучения`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`График занятий`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Договор`                 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                              <. Примечание .>
    >>
  end;

  // Открытие / скрытие полей для редактирования в зависимости от того, утвержден ли приказ
  procedure EnableDisable;
  begin
    inherited::EnableDisable;
    if fnFieldsOpen then
      SetFieldOption(#ContractStr, ofSelectable)
    else
      ClearFieldOption(#ContractStr, ofSelectable);
  end;

  // Функция возвращает идентификатор панели с дополнительным соглашением по РПД (для перерисовки после редактирования)
  function GetPanel4Agreement: LongInt;
  begin
    result := #Education;
  end;

  handleEvent
    cmPick:
      case CurField of
        #Persons.FIO, #Persons.TabNmb, #Persons.StrTabN:
          begin
            case inherited::handleEvent(cmPick) of
              heAbort:
                begin
                  abort;
                  exit;
                end;
              heStop:
                begin
                  stop;
                  exit;
                end;
            end;
            DeleteAndCreateAgreement;
          end;
       #ContractStr:
         if IsValid(tnAppointments) then
         begin
           var _cContract: Comp = Appointments.ResComp[1];
           set _cContract := WWC.ShowContractWinDates(_cContract, ContDoc.Person, 0, ContDoc.dPrik, ZeroDate, CN_WWC_EDIT);
           if _cContract != Appointments.ResComp[1] then
           begin
             Appointments.ResComp[1] := _cContract;
             WWC.PutContractInfo(Appointments.ResComp[1], Appointments.cDog, Appointments.ContractNmb, Appointments.ContractDate);
             update current Appointments;
           end;
         end else
           Message('Назначение не найдено - невозможно привязать договор');
       #LeadPersons.FIO:
         begin
           var _cPerson: tNRec = Education.cInf2;
           if PickPerson(_cPerson) then
             set Education.cInf2 := _cPerson;
         end;
       #EduModeCat.Name:
         begin
           var _Mode: tNRec = Education.Mode;
           if RunInterface('PickCatalog2', -15, _Mode, 0, 0) = cmDefault then
             set Education.Mode := _Mode;
         end;
      else
        inherited::HandleEvent(cmPick);
      end;
    cmDelOnProtect:
      case CurField of
       #ContractStr:
         begin
           WWC.DelContractIfNew(Appointments.ResComp[1], 0);
           set Appointments.ResComp[1] := 0;
           set Appointments.cDog := 0;
           set Appointments.ContractNmb := '';
           set Appointments.ContractDate := ZeroDate;
           update current Appointments;
         end;
        #LeadPersons.FIO:
          set Education.cInf2 := 0;
        #EduModeCat.Name:
          set Education.Mode := 0;
      else
        inherited::HandleEvent(cmDelOnProtect);
      end;
    cmHotKeys:
      begin
        var menuID: LongInt;
        menuID := LoadMenu('RPD_Menu');

        prFillMenu(menuID);

        if IsValid(tnAppointments) then
          if Appointments.ResComp[1] != 0 then
            AddMenuItem(menuID, 'Печать договора (Word)', cmValue17);

        AddMenuItem(menuID,'separator',1);
        AddMenuItemEx2(menuID, 'Запомнить текущие данные', 'Запомнить данные', hcNoContext, cmSaveDoc, kbCtrlF2, 'Ctrl+F2');
        AddMenuItemEx2(menuID, 'Создать новые данные как копию запомненных', 'Создать новые данные как копию запомненных', hcNoContext, cmRestoreDoc, kbCtrlF3, 'Ctrl+F3');
        AddMenuItemEx2(menuID, 'Скопировать всем', 'Скопировать данные всем работникам в приказе', hcNoContext, cmValue10, kbNoKey, '');

        PutHotCommand(RunLoadMenu(menuID));
      end;
    cmValue17: // Печать договора (Word)
      if UpDateTable then
      begin
        var Rep: GP_RepLaborContract;
        Rep.Run(ContDoc.TypeOper, 0, ContDoc.NRec, ContDoc.Person, 0);
      end;
  end;

end.
