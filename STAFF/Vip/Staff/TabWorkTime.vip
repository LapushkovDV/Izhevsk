//******************************************************************************
table struct tmpSigners
(
  kod   : word
, FIO   : string
, Dol   : string
)
with index
(
  tmpSignersO1 = kod
);
table struct SAbsence
(
  NRec        : comp
, Sign        : string
, Mark        : string[5]
, Description : string
, Days        : byte
, Hours       : double
, Beginning   : date
, Ending      : date
, Kind        : word
, Additive    : boolean
, PlansHours  : double
, isMissed    : boolean
)
with index
(
  SAbsence01 = NRec(Surrogate, Unique)
, SAbsence02 = isMissed + MARK
);
//*****************************************************************************
table struct tmpAllPodr 
(
  NRec    : comp
, cParent : comp
, Name    : string
)
with index
(
  tmpAllPodr01 = NRec (Unique, Surrogate)
);

