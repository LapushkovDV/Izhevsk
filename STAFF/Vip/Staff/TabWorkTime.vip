  boGch: boolean; // #166 #96 при wMode = 1 - true
  boDbl: boolean; // EM-54 wOutHHDouble >  0 выводить время в долях часа


  _sDeskr: string;

//******************************************************************************
Create view vM
var
  pMnPlan:comp;
  pMyOrg :comp;
as select
  tmpTabWorkTime.*
from 
  tmpTabWorkTime
, tmpAllPodr
, LsTab
, Appointments(APNTBYPERSON)
, tmpSigners
, SABSENCE, SAbsence SAbsence2
, MnPlan
, KlKatego AppEmpCategoryCat
, KatOrg
, Prvidopl
//, PrVidopl PrVidopl_F
//, PrVidopl PrVidopl_IT
, GP_TimeTable
, LSchet   LSchetPodr
, KatPodr
, em_unidoc_head euhPers
where
((
    tmpTabWorkTime.LSTABNREC  == LStab.NRec
AND LStab.cLSchet             == LSchet.NRec
AND LSchet.tPerson            == Persons.NRec

AND LSTab.tPerson             == Appointments.Person
AND LSchet.NRec               == Appointments.cAddNRec2 (NoIndex)
//AND (dEnd  >= Appointments.AppointDate
//   AND (//dBeg  <= Appointments.DismissDate// or
//      Appointments.DismissDate = ZeroDate
//       )
//    )

AND Appointments.cAddNRec2    == LSchetPodr.NRec
AND LStab.Cex                 == KatPodr.NRec

AND Appointments.EmpCategory == AppEmpCategoryCat.NRec
AND LStab.NRec               == LSTABMSK.CLSTAB

AND pMnPlan                  == MnPlan.Nrec
AND pMyOrg                   == KatOrg.NRec
/*
AND pcCostSharing            == PrVidopl_F.Choice
AND LSchet.NRec              == PrVidopl_F.cLSch
AND dBeg                     == PrVidopl_F.DATAN (noindex)
AND Prvidopl.Dataf           == PrVidopl_F.DataF(noindex)
AND (Prvidopl.Nrec <> Prvidopl_F.Nrec)

AND pcCostSharing            == PRVIDOPL_IT.CHOICE
AND LSchet.NRec              == PrVidopl_IT.cLSch
AND dBeg                     == PrVidopl_IT.DATAN (noindex)
AND (Prvidopl.Nrec <> Prvidopl_IT.Nrec)
*/
AND LSTab.cLSchet            == GP_TimeTable.cLSchet
AND LSTab.YearN              == GP_TimeTable.YearN
AND LSTab.MesN               == GP_TimeTable.MonthN
))


bounds ByPersonalAccount =
    pcCostSharing             == PrVidOpl.Choice
AND LSchet.NRec               == PrVidOpl.cLSch
AND dBeg                      == PrVidOpl.DataN (noindex)
and dBeg <<=  PrVidOpl.DataF (noindex)
and ( tmpTabWorkTime.MaskDay[Day(PrVidOpl.DataF)] )
//AND dBeginning                == PrVidOpl.DataF (noindex) //разобьем по периодам


bounds ByTemplate =
  pcCostsSharingTemplates == PRVIDOPL.CHOICE
  and pMnPlan == PRVIDOPL.MNREC
  and dBeg == PRVIDOPL.DATAN (noindex)

;

//Для определения подразделений верхнего уровня в фильтрах
create view vPodr
var
  _katpodrNrec: comp;
as select tmpAllPodr.Nrec
from KatPodr,
     tmpAllPodr,
     tmpAllPodr tmpAllPodrParent
where ((
  _katpodrNrec == KatPodr.Nrec and
  tmpAllPodr.cParent == tmpAllPodrParent.Nrec
))
;

Parameters
  sPodr
, dBeg
, dEnd
, wMode  // #166 #96
;

