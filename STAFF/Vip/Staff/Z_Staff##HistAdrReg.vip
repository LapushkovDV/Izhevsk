
#include ExtAttr.vih
#include ExtAttr.var

#component "Z_Staff"

alter interface HistAdrReg;

ExtendFormats StaffHistAdrReg;
browse StaffHistAdrReg;
    Fields
    [datvvod] dGetAttr(25096,TempAddress.NRecAddress,'Дата ввода') 'Действ. с' ('Действует с', hcStaffHistAdrReg, sci1378EnEsc) : [10];
  end;

HandleEvent
cmInit:
{
   if (wGetTune('UP.FAKELGAL.FAKEL') = 0) then
  {
    cfsSetExtProp('c_STAFFHISTADRREG_DATVVOD_Действ._с', 'Visible', false);
  }
  case inherited :: handleEvent (cmInit) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
}
cmExprFieldChanged:
{
  case inherited :: handleEvent (cmExprFieldChanged) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
  var d1:date;
  case CurField of
    #datvvod:
    {
      d1:=StrToDate(ExprFieldValue,'DD/MM/YYYY');
      dsetAttr(25096,TempAddress.NRecAddress,'Дата ввода', d1);
    }
  end;
}
end;
end.
