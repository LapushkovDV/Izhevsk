\*************************************************************************************************/

#include AdrFunc.vih // Функции работы с адресами

#component "Z_STAFF"

alter interface PostEducation;

  const
    NAME_ATTR_TICKET_NUM = 'Номер билета';
    NAME_ATTR_THEORY_GRADE = 'Оценка за теорию';
    NAME_ATTR_PRACTICE_GRADE = 'Оценка за практику';
  end;

  var
    iAdrFunc: AddressFunc;
    oExtAttr: IExtAttr;

  OverloadFormats sc1_PlanEduc;

  screen sc1_PlanEduc (, hcStaff_PovKvalif_plgr, sci1478EnIns);
    show at (1, 21, 40, ) fixed_y;
    table PlanEduc;
  fields
    ImproveName ('Вид повышения квалификации'): protect, pickButton;
    Institution.Name ('Учебное заведение'): protect, pickButton;
    Facility.Name ('тема'): protect, pickButton;
    ActEducations.wAttrAct('Код тематики'): protect, pickButton;
    PlanEduc.Summa ('Сумма'): [10.3,'\3p[|-]3666`666`666`666`666.888'], noProtect;
    Count ('Продолжительность обучения сутки'): protect;
  <<
`Вид повышения    ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Учебное заведение` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Тема             ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Код тематики     `        .@@@@@@
`Сумма            ` .@@@@@@@@@@@@@
`Продолжительность`        .@@@@@@
  >>
  end;

  screen scrActEduc;
    show at (41, 21,, ) fixed_y;
    table ActEducations;
    fields
      iAdrFunc.GetFullAddressInd(ActEducations.cRef1) ('Место нахождения'): skip;
      ICatFunc.GetCatalogsName(ActEducations.cMode) ('Форма обучения'): skip;
      ICatFunc.GetCatalogsName(ActEducations.cTopic) ('Специальность по диплому'): skip;
      ICatFunc.GetCatalogsName(ActEducations.cQualType) ('Квалификация по диплому'): skip;
      ActEducations.dBegin ('Дата начала'): skip;
      ActEducations.dEnd ('Дата окончания'): skip;
      ICatFunc.GetCatalogsName(ActEducations.cRef2) ('Документ'): skip;
      ActEducations.LastUser ('Номер документа'): skip;
      ActEducations.LastDate ('Дата выдачи'): skip;
      ICatFunc.GetCatalogsName(ActEducations.cRef3) ('Вид повышения квалификации'): skip;
      ActEducations.summa ('Сумма'): [10.3, '\3p[|-]3666`666`666`666`666.888'], skip;
      ICatFunc.GetCatalogsName(ActEducations.cReason) ('Основание'), skip;
      ActEducations.sText ('Примечание'): skip;
  <<
 Место нахождения .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Форма обучения   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Специальность    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Квалификация     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Даты поступл./оконч.        .@@@@@@@@@@@     .@@@@@@@@@@@
 Документ         .@@@@@@@@@@@@@@@@@@@@@@  №  .@@@@@@@@@@@  выдан .@@@@@@@@@@@
 Вид повышения квалификации.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Стоимость .@@@@@@@@@@@@@@@ Основание:.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Примечание.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  >>
  end;


  handleEvent
    cmInit:
      begin
        inherited::HandleEvent(cmInit);
        oExtAttr.CreateAttr(coPlanEduc, NAME_ATTR_TICKET_NUM, 0); // Тип - String
        oExtAttr.CreateAttr(coPlanEduc, NAME_ATTR_THEORY_GRADE, 1); // Тип - Double
        oExtAttr.CreateAttr(coPlanEduc, NAME_ATTR_PRACTICE_GRADE, 1); // Тип - Double
      end;
    cmPickClass:
      if UpdateTable then
        case CurTable of
          #PlanEduc:
            if PlanEduc.NRec != 0 then
              RunInterface(ExClassifier, coPlanEduc, PlanEduc.NRec);
        end;
    cmPickAttr:
      if UpdateTable then
        case CurTable of
          #PlanEduc:
            if PlanEduc.NRec != 0 then
              RunInterface(Attribute, coPlanEduc, PlanEduc.NRec);
        end;
    cmHotKeys:
      case CurTable of
        #PlanEduc:
          begin
            var menuID: LongInt;
            menuID := LoadMenu('PMPost');
            AddMenuItem(MenuID,'separator',1);
            AddMenuItemEx2(menuID, 'Внешняя классификация', 'Внешняя классификация',
             hcGkatalM1ExtClass, cmPickClass, kbAltC, 'Alt+C');
            AddMenuItemEx2(menuID, 'Внешние атрибуты', 'Заполнение внешних атрибутов по данной позиции',
             hcGkatalM1Attr, cmPickAttr, kbAltA, 'Alt+A');
            PutHotCommand(RunLoadMenu(menuID));
         end;
     end;
  end;

end.
