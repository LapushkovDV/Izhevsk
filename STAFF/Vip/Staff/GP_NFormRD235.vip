#include CatFunc.vih // Функции работы с Catalogs
#include DeptIer.vih // Функции работы с подразделениями
#include TotalOrganizationAttributes.vih // Работа с атрибутами организации
#include AppFuncs.vih // Функции работы с назначениями
#include GP_EducFunc.vih // Функции работы с уровнями образования
#include GP_Signers.vih // Библиотека для вывода подписей в отчетах
#include GP_StrFunc.vih // Функции работы со строками

interface GP_NFormRD235;

  const
    SG_CONST_REP = cgReport_KASSFRO; // код группы отчётов для выбора подписантов
    SG_TAG_REP = 'StOrderRPD235'; // код отчёта для выбора подписантов
  end;

  create view
    var
      pcTitleDoc: tNRec;
      pcPersons: tNRec;
      pContDoc: tNRec;
      pTypeOper: Integer;
    from
      KlVidOpl,
      PrMemo,
      Notes,
      synonym Persons PersonsA,
      synonym Appointments AppointmentsA,
      synonym Education EducationP
    where((
          pcTitleDoc       == TitleDoc.NRec
      and pTypeOper        == PartDoc.TypeOper
      and TitleDoc.NRec    == PartDoc.cDoc
      and pContDoc         == ContDoc.NRec
      and pcPersons        == Persons.NRec
      and ContDoc.cStr     == Appointments.NRec
      and ContDoc.NRec     == Education.cContDoc
      and ContDoc.NRec     == Fortune.cFCont
      and Fortune.FortCurr == KlVal.NRec
    ));

  parameters pcTitleDoc, pcPersons, pContDoc, pTypeOper;

  form Frm ('GP_NFormRD235.out','GP_NFormRD235');

  var
    ICatFunc: CatalogsFunctions;
    IDepartIer: DepartIer;
    VAppFuncs: AppointmentsFunctions;

  #include TotalOrganizationAttributes.var // объявление и инициализация TOA
  #include GP_Signers.var
  #include GP_EducFunc.var
  #include GP_StrFunc.var

  file mFile;

  // Возвращает полное название подразделения в иерархии от нижнего к верхнему
  /*
  function GetFullDepName(cDep: Comp; AddCode: Boolean = false; NCase: Byte = 1; Delimiter: String = ' '): String;
