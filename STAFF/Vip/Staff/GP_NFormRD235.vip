  procedure OutPrMemo(_cDoc: tNRec; _wRef: tNRec);
  var
    S: String;
  begin
    if getFirst PrMemo where ((_cDoc == PrMemo.cDoc and _wRef == PrMemo.wRef)) = tsOk then
    begin
      _try
      begin
        mFile.OpenMemo(PrMemo.Info);
        while not mFile.Eof do
        begin
          mFile.ReadLn(S);
          Frm.PutEventByID(feDoLoop, fcPartDocMemo);
          Frm.Write(S); // PartDocMemoText
        end;
      end
      _except
        on ExFile:
          begin
          end;
        on ExFileNotFound:
          begin
          end;
      _finally
      begin
        mFile.Close;
      end;
    end;
  end;

  procedure OutNotes(_Owner: tNRec; _Choice: Word);
  var
    S: String;
  begin
    if getFirst Notes where ((_Choice == Notes.Choice and _Owner == Notes.Owner)) = tsOk then
    begin
      _try
      begin
        mFile.OpenMemo(Notes.Note);
        while not mFile.Eof do
        begin
          mFile.ReadLn(S);
          Frm.PutEventByID(feDoLoop, fcCommentMemo);
          Frm.Write(S); // CommentMemoText
        end;
      end
      _except
        on ExFile:
          begin
          end;
        on ExFileNotFound:
          begin
          end;
      _finally
      begin
        mFile.Close;
      end;
    end;
  end;

  // Выводит в поток формы данные об указанном человеке на указанную дату
  procedure WritePersonData(_cPerson: tNRec; _Date: Date);
  var
    cApp: tNRec;
  begin
    cApp := 0;
    if _cPerson != 0 then
      if getFirst fastFirstRow PersonsA where ((_cPerson == PersonsA.NRec)) != tsok then
        _cPerson := 0;
    if _cPerson != 0 then
    begin
      cApp := VAppFuncs.GetAppNRec_OnDate(_cPerson, _Date);
      if cApp != 0 then
        if getFirst fastFirstRow AppointmentsA where ((cApp == AppointmentsA.NRec)) != tsok then
          cApp := 0;
    end;
    if _cPerson != 0 then
    begin
      Frm.Write(PersonsA.NRec); // ...NRec
      Frm.Write(PersonsA.FIO); // ...FIO
      Frm.Write(GetStrTabn(PersonsA.TabNmb, PersonsA.StrTabn)); // ...TabN
      Frm.Write(PersonsA.Sex); // ...Gender
    end else
      Frm.SkipFormat(3);
    if cApp != 0 then
    begin
      Frm.Write(AppointmentsA.Department); // ...DepNRec
      Frm.Write(ICatFunc.GetCatalogsCode(AppointmentsA.Department)); // ...DepCode
      Frm.Write(ICatFunc.GetCatalogsName(AppointmentsA.Department)); // ...DepName
    end else
      Frm.SkipFormat(2);
  end;

  // Получает пользовательский код оплаты для указанной доплаты
  function GetVidOpl(_сRaise: tNRec): LongInt;
  var
    VidOplS: LongInt;
  begin
    result := 0;
    // Системный вид оплаты
    VidOplS := LongInt(Substr(ICatFunc.GetCatalogsCatData(_сRaise), 1, 5));
    if GetFirst KlVidOpl where ((VidOplS == KlVidOpl.VidOpl)) = tsOk then
      result := KlVidOpl.VidOplP;
  end;

  procedure GenerateForm;
  var
    RaiseCurrTypeName: String;
    cEducP: tNRec;
  begin
    // Выбираем группу подписантов
    if not oGP_Signers.Init(SG_CONST_REP, SG_TAG_REP, true, TitleDoc.DocDate) then
      exit;
    Frm.Write(pTypeOper); // TypeOper
    Frm.Write(pcTitleDoc); // TitleDocNRec
    Frm.Write(pContDoc); // ContDocNRec
    Frm.Write(pcPersons); // PersonsNRec
    
    TOA.Bind(0); // связываем TOA с собственной организацией
    Frm.Write(ObjDepartIer4(IDepartIer).GetOrgName(coGetTune('MyOrg'))); // OrgName
    Frm.Write(Trim(TOA.GetJuridicalInfo.GetOkpoCode)); // OrgOKPO

    Frm.Write(TitleDoc.DocNmb); // OrderNum
    Frm.Write(TitleDoc.DocDate); // OrderDate

    Frm.Write(Persons.FIO); // FIO
    Frm.Write(GetStrTabn(Persons.TabNmb, Persons.StrTabn)); // TabN
    Frm.Write(Persons.AppDate); // DtPos
    Frm.Write(Persons.Sex); // Gender

    Frm.Write(Appointments.Department); // DepNRec
    // Message(OGP_SF.GetFullDepName(Appointments.Department, true, 2)); // ***
    Frm.Write(ICatFunc.GetCatalogsCode(Appointments.Department)); // DepCode
    Frm.Write(ICatFunc.GetCatalogsName(Appointments.Department)); // DepName
    Frm.Write(OGP_SF.GetPersPost(Persons.NRec, 1, Education.FromDate)); // Position

    Frm.Write(ICatFunc.GetCatalogsName(oGP_EducFunc.GetBestEducLvl(Persons.NRec, Education.FromDate))); // PsnEducLevel

    WritePersonData(Education.cInf2, Education.FromDate); // Mentor...

    Frm.Write(Education.FromDate); // DateBeg
    Frm.Write(Education.ToDate); // DateEnd
    Frm.Write(Education.LastDate); // TestDate
    Frm.Write(Education.LastTime); // TestTime
    Frm.Write(ICatFunc.GetCatalogsName(Education.Name)); // Institution
    Frm.Write(ICatFunc.GetCatalogsName(Education.Level)); // EducLevel
    Frm.Write(ICatFunc.GetCatalogsName(Education.Speciality)); // Speciality
    Frm.Write(ICatFunc.GetCatalogsName(Education.cAddInf1)); // Subject
    Frm.Write(Education.PaySum); // Sum
    Frm.Write(ICatFunc.GetCatalogsName(Education.cReason)); // EducReason
    Frm.Write(ContDoc.SBottom); // OrderReason

    // Получаем ссылку на образование работника с видом "Высшее профессиональное"
    cEducP := oGP_EducFunc.GetEducBySysCode(Persons.NRec, -98);
    if cEducP != 0 then
      if getFirst EducationP where ((cEducP == EducationP.NRec)) != tsOk then
        cEducP := 0;
    if cEducP != 0 then
    begin
      Frm.Write(ICatFunc.GetCatalogsName(EducationP.Name)); // InstitutionPr
      Frm.Write(ICatFunc.GetCatalogsName(EducationP.Level)); // EducLevelPr
      Frm.Write(ICatFunc.GetCatalogsName(EducationP.Speciality)); // SpecialityPr
      Frm.Write(ICatFunc.GetCatalogsName(EducationP.cAddInf1)); // SubjectPr
      Frm.Write(EducationP.FromDate); // DateBegPr
      Frm.Write(EducationP.ToDate); // DateEndPr
    end else
      Frm.SkipFormat(6);

    Frm.Write(GetVidOpl(Fortune.cFType)); // RaiseCode
    Frm.Write(ICatFunc.GetCatalogsName(Fortune.cFType)); // RaiseName
    Frm.Write(Fortune.DocSum); // RaiseSum
    Frm.Write(Fortune.wAttr1); // RaiseCurrType
    case Fortune.wAttr1 of
      1: RaiseCurrTypeName := KlVal.SimvolV; // валюта
      2: RaiseCurrTypeName := '%'; // проценты
      else
        RaiseCurrTypeName := 'руб.'; // нац.валюта
    end;
    Frm.Write(RaiseCurrTypeName); // RaiseCurrTypeName

    OutPrMemo(PartDoc.NRec, 2);
    OutNotes(ContDoc.NRec, cKadryDisNotes);

    if not Frm.Error then
      Frm.ShowFile();
  end;

  handleEvent
    cmInit:
      begin
        GenerateForm;
        abort;
      end;
  end;

end.
