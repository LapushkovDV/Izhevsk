//*****************************************************************************

//Возвращает Грейд и вгз  (_f = 1 - Грейд; _f = 2 - ВГЗ)
function GetGrayd(_str: string;_f: word): string;
{
  var chek: word;
  result := '';
  chek := Pos('-А',_str) + Pos('-В',_str) + Pos('-С',_str);
  if (chek <> 0)
  {
    if(_f = 1)
    {
      result := Substr(_str,1,chek-1);
    }
    else
    {
      result := Substr(_str,chek+1,1);
    }
  }
}

function GetFIO(sFio : string; bFirstF : boolean) : string;
{
  var   str, str2 : string;

  sFio := Trim(sFio);
  str  := sFio;
  str2 := '';

  if (InStr('.', sFio) = 2)
    {
      if (NOT bFirstF)
        {
          result := sFio;
          Exit;
        }
      else
        {
          var pref : string; pref := SubStr(sFio, 1, 2);
          sFIO := Trim(SubStr(sFio, 3, Length(sFio)));
          pref := pref + SubStr(sFio, 1, 2);
          sFIO := Trim(SubStr(sFio, 3, Length(sFio))) + ' ' + pref;
          result := sFio;
          Exit;
        }
    }

  if (InStr(' ', sFio) <> 0)
    {
       sFio := SubStr(sFio, 1, InStr(' ', sFio) - 1);
       str  := Trim(SubStr(str, InStr(' ', str) + 1, Length(str) - InStr(' ', str)));

       if (InStr(' ', str) <> 0)
         {
           str2 := SubStr(str, 1, 1) + '.';

           if (InStr(' ', str) <> 0)
             {
               str  := Trim(SubStr(str, InStr(' ', str) + 1, Length(str) - InStr(' ', str)));
               str2 := str2 + ' ' + SubStr(str, 1, 1) + '.';
             }
         }
       else
         str2 := str;

       if (bFirstF)
         str := sFio + ' ' + str2;
       else
         str := str2 + ' ' + sFio;
    }

  GetFIO := str;
}
//*****************************************************************************
Function GetFioSinger(c : comp) : string;
{
  result := '';
  if (GetFirst SelPicks where (( c == SelPicks.NRec )) = tsOk)
    if (GetFirst MnSpAdd where (( SelPicks.cRec == MnSpAdd.nRec )) = tsOk)
      result := iPsnFunc.GetFIO(MnSpAdd.cOwner);
}
//*****************************************************************************
Procedure CreateVacancy(kolEd : double);
{
  if (kolEd <= 0)
    Exit;

  set tmpDocs.NRec     := comp(0);
  set tmpDocs.FIO      := 'вакансия';
  set tmpDocs.CountSEd := if (kolEd > 1, 1, kolEd);
  kolEd := kolEd - tmpDocs.CountSEd;
  set tmpDocs.dOklad   := tmpDocs.TaxRate;
  if (insert current tmpDocs = tsOk)
     CreateVacancy(kolEd);

}
//*****************************************************************************
Procedure ProcessData;
{
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет обработка премий', RecordsInTable(#tmpDocs));

  var Markers1    : longint; Markers1    := InitMarker('CatalogsMarker1', 8, 200, 10);
  var Markers2    : longint; Markers2    := InitMarker('CatalogsMarker2', 8, 200, 10);
  var Markers3    : longint; Markers3    := InitMarker('CatalogsMarker3', 8, 200, 10);

  var DeptMarker  : longint;
  var KategMarker : longint;
  var cntDept     : longint; cntDept  := 0;
  var cntKateg    : longint; cntKateg := 0;

  if ((wFilters and 1) = 1)
    {
      DeptMarker  := InitMarker(DeptMarkerName      , 8, 200, 10);
      cntDept  := GetMarkerCount(DeptMarker);
    }

  if ((wFilters and 2) = 2)
    {
      KategMarker := InitMarker(KategMarkerName     , 8, 200, 10);
      cntKateg := GetMarkerCount(KategMarker);
    }


  sql
  select
  str.nrec
  ,case when coalesce(gpraise.procent,99999)=99999 then gptt.MONTHLYBONUS[1] else gpraise.procent end
  from staffstruct str
  left join catalogs dep on str.department=dep.nrec
  left join catalogs post on str.post=post.nrec
  left join tarstav tt on str.tariff = tt.nrec
  left join GP_TARSTAVEXT gptt on tt.nrec=gptt.ctarstav
  left join GP_KPI_RAISE_STS_SP gpraise on str.nrec=gpraise.cstaffstruct and gptt.CMONTHLYBONUSTYPE[1]=gpraise.cdoplata
                                           and :(dateSts)>=gpraise.datan and (:(dateSts)<=gpraise.datok or 0=gpraise.datok)
  where (dep.datn<=:(dateSts) and (dep.datok>=:(dateSts) or dep.datok=0)) //по действующему подр
  and (str.dinput<=:(dateSts) and (str.dclose>=:(dateSts) or str.dclose=0)) //по действующей ставке
  into tmpPremSHR;
  RereadRecord(tntmpPremSHR);



  external  _LOOP tmpDocs
     if (Not NextVisual)
       {
         break;
       }
     else
      {
        if ((wFilters and 1) = 1 AND cntDept > 0)
          {
            if (FoundMarker(DeptMarker, tmpDocs.PodrRec))
             {
              set tmpDocs.isPrint := 1;
             }
            else
              continue;
          }
        else
          set tmpDocs.isPrint := 1;

        if ((wFilters and 2) = 2 AND cntKateg > 0)
          {
            if (FoundMarker(KategMarker, tmpDocs.CategID))
              set tmpDocs.isPrint := 1;
            else
              continue;
          }
        else
          set tmpDocs.isPrint := 1;
          /*
        if (tmpDocs.PodrRec <> comp(0))
          if (GetFirst tmpIerPodr where ((tmpDocs.PodrRec == tmpIerPodr.NRec)) <> tsOk)
            {
              ClearBuffer(#tmpIerPodr);
              tmpIerPodr.NRec           := tmpDocs.PodrRec;
              tmpIerPodr.cParent        := tmpDocs.ParentPodrRec;
              tmpIerPodr.SortPodrCode   := tmpDocs.SortPodrCode;
              tmpIerPodr.PodrName       := tmpDocs.PodrName;
              tmpIerPodr.PodrCode       := tmpDocs.PodrCode;
              tmpIerPodr.ParentPodrName := tmpDocs.ParentPodrName;
              tmpIerPodr.ParentPodrCode := tmpDocs.ParentPodrCode;
              if (insert current tmpIerPodr = tsOk)
                {}
            }         */

        if (GetLast HistoryStr where (( IFHS.GetHistoryStrNRec(tmpDocs.cStaffStruct,dateSts) == HistoryStr.NRec )) = tsOk) {}
          dKolPers := dKolPers + HistoryStr.HWorkStations;

        var d1 : double; d1 := 0;
        var d2 : double; d2 := 0;

        _LOOP RaiseStS
          if (GetFirst RaiseAlg = tsOk)
            {
             if (FoundMarker(Markers1, RaiseStS.RaiseType))
               {
                 d1 += RaiseAlg.Sum;
                 continue;
               }
             else if (FoundMarker(Markers2, RaiseStS.RaiseType))
               {
                 d1 += RaiseAlg.Sum;
                 continue;
               }
             else if (FoundMarker(Markers3, RaiseStS.RaiseType))
               {
                 d1 += RaiseAlg.Sum;
                 continue;
               }
            }
        if (d1 <> 0)
          set tmpDocs.DoplataUslT  := d1/100;
        if (d2 <> 0)
          set tmpDocs.DoplataOther := d2/100;

        if (wType = 0)
          {
            /* Мошкарева сказала не схлопывать 0_-   спустя пару лет
            if (GetFirst tmpDocs2 where ((tmpDocs.PodrRec       ==  tmpDocs2.PodrRec
                                      AND tmpDocs.PostNRec      ==  tmpDocs2.PostNRec
                                      AND tmpDocs.Discharge     ==  tmpDocs2.Discharge
                                      AND tmpDocs.LevelPayment  ==  tmpDocs2.LevelPayment
                                      AND tmpDocs.RatePayment   ==  tmpDocs2.RatePayment
                                      AND tmpDocs.Tarif         ==  tmpDocs2.Tarif
                                      AND tmpDocs.TarifMax      ==  tmpDocs2.TarifMax
                                      AND tmpDocs.ClassCondJob  ==  tmpDocs2.ClassCondJob
                                      AND tmpDocs.DoplataUslT   ==  tmpDocs2.DoplataUslT
                                      AND 1                     ==  tmpDocs2.isPrint
                                      AND (tmpDocs.NRec         <>  tmpDocs2.NRec))) = tsOk)
              {
                tmpDocs2.CountSEd := tmpDocs2.CountSEd + tmpDocs.CountSEd;
                if (update current tmpDocs2 = tsOk)
                  {}
                set tmpDocs.isPrint := 0;
              }
              */
          }

        if (wType = 1)
          {
            if (Trim(ManualNotesStaffStr.NoteStr) <> '')
             set tmpDocs.sNote := ManualNotesStaffStr.NoteStr;

            var kolEd     : double;  kolEd    := tmpDocs.WorkStations;
            var sFIO      : string;  sFIO     := '';
            var cnt       : integer; cnt      := 0;
            var isVac     : boolean; isVac    := false;
            var dPrintSt  : double;  dPrintSt := 0;
            var draise    : double;

            //собираем % премии

            //AND tmpDocsPrn.cStaffStruct == ss1.nrec
            //A ND ss1.Tariff == ts1.nrec

            if getfirst tmpPremSHR where ((tmpdocs.cStaffStruct==tmpPremSHR.cStaffStruct)) = tsOk
            {
              set tmpDocs.eprem:=tmpPremSHR.raise;
            }

            _LOOP Appointments
              {
                if (GetFirst Persons <>  tsOk)
                  continue;
                draise:=0;
                if getfirst raise where ((    persons.nrec==raise.person
                                          and appointments.nrec==raise.appoint
                                          and comp(000A00000003DA57h)==raise.raisetype
                                          and (dateSts>=raise.FROMDATE
                                          and (dateSts<=raise.TODATE or 0=raise.TODATE)) )) =tsok
                {
                  draise:=raise.sum;
                  if getlast raisehist where ((    raise.nrec ==raisehist.craise
                                          and (dateSts>=raisehist.drec and 0<>raisehist.drec))) =tsok

                  {
                     draise:=raisehist.RHSUM;
                  }


                  set tmpDocs.isn:=draise;
                }

                if getfirst raise where ((    persons.nrec==raise.person
                                          and appointments.nrec==raise.appoint
                                          and comp(000A000000041196h)==raise.raisetype
                                          and (dateSts>=raise.FROMDATE
                                          and (dateSts<=raise.TODATE or 0=raise.TODATE)) )) =tsok
                {
                  draise:=raise.sum;
                  if getlast raisehist where ((    raise.nrec ==raisehist.craise
                                          and (dateSts>=raisehist.drec and 0<>raisehist.drec))) =tsok

                  {
                     draise:=raisehist.RHSUM;
                  }


                  set tmpDocs.isn:=draise;
                }
                if getfirst raise where ((    persons.nrec==raise.person
                                          and appointments.nrec==raise.appoint
                                          and comp(000A000000041223h)==raise.raisetype
                                          and (dateSts>=raise.FROMDATE
                                          and (dateSts<=raise.TODATE or 0=raise.TODATE)) )) =tsok
                {
                  draise:=raise.sum;
                  if getlast raisehist where ((    raise.nrec ==raisehist.craise
                                          and (dateSts>=raisehist.drec and 0<>raisehist.drec))) =tsok

                  {
                     draise:=raisehist.RHSUM;
                  }


                  set tmpDocs.isn:=draise;
                }
                if getfirst raise where ((    persons.nrec==raise.person
                                          and appointments.nrec==raise.appoint
                                          and comp(0001000000003F16h)==raise.raisetype
                                          and (dateSts>=raise.FROMDATE
                                          and (dateSts<=raise.TODATE or 0=raise.TODATE)) )) =tsok
                {
                  set tmpDocs.SECRET:=raise.sum;
                }


                var dNeedStaff : double; dNeedStaff := 0;
                /*
                if (GetLast HistoryStr where (( IFHS.GetHistoryStrNRec(StaffStruct.NRec,dateSts) == HistoryStr.NRec )) = tsOk)
                   set tmpDocs.dOklad    := HistoryStr.
                else
                  set tmpDocs.dOklad     := Appointments.TaxRate;
                  */
                if (trim(sFio) <> '' AND dPrintSt <> 0)
                  sFIO := sFIO + ' (' + DoubleToStr(dPrintSt,'[|-]3666.88') + ')';

                inc(cnt);

                var sVacnFio : string; sVacnFio := '';
                var cVac : comp; cVac := iSHR.GetLongVacationByDate(Appointments.NRec, dateSts);
                if (Getfirst Vacations where ((cVac == Vacations.NRec)) = tsOk)
                  if (GetFirst KlOtpusk = tsOk)
                    sVacnFio := KlOtpusk.NOtpus + ' ' 
                              + if (Persons.CSOVM = 1 AND IsValid(#KLSOVM), KLSOVM.NSOVM + ' ', '') 
                              + Persons.FIO;

                isVac := (trim(sVacnFio) <> '' OR isVac);

                if (trim(sVacnFio) = '')
                  kolEd := kolEd - Appointments.Rate;

                if (NOT isVac)
                  dPrintSt := Appointments.Rate;
                else
                  dPrintSt := 0;

                var tmpFIO : string; tmpFIO := if (word(Persons.cSovm) = 1 AND IsValid(#KLSOVM), KLSOVM.NSOVM + ' ', '') + Persons.FIO;

                case Appointments.Lprizn of
                 3,31 : {
                       tmpFIO     := 'совместительство. ' + tmpFIO;
                       dNeedStaff := Appointments.Rate;
                     }
                   2  : {
                       tmpFIO     := 'совмещение. ' + tmpFIO;
                       dNeedStaff := Appointments.Rate;
                     }
                 else if (isVac AND trim(sVacnFio) = '')
                  {
                    dNeedStaff := Appointments.Rate;
                  }

                end;

/*                if (Appointments.Lprizn = 3 OR Appointments.Lprizn = 31)
                  {
                    tmpFIO     := 'совм. ' + tmpFIO;
                    dNeedStaff := Appointments.Rate;
                  }
                else if (isVac AND trim(sVacnFio) = '')
                  {
                    dNeedStaff := Appointments.Rate;
                  }
*/
                sFIO  := sVacnFio
                       + if(trim(sVacnFio) <> '' AND trim(sFIO) <> '', ', ', '')
                       + sFIO;
                if (trim(sVacnFio) = '')
                  sFIO  := sFIO
                         + if (trim(sFIO) <> '' AND trim(tmpFIO) <> '', ', ', '')
                         + tmpFIO;
                sFIO := sFIO + if (dNeedStaff <> 0 , ' (' + DoubleToStr(dNeedStaff,'[|-]3666.88') + ')', '');
                if (dNeedStaff <> 0)
                  dPrintSt := 0;
              }

            if (isVac AND cnt = 1)
               kolEd := 0;
            else if (cnt = 0)
              {
                CreateVacancy(kolEd);
                continue;
              }

            set tmpDocs.FIO := sFIO + if (dPrintSt <> 0  AND cnt > 1, ' (' + DoubleToStr(dPrintSt,'[|-]3666.88') + ')', '');
            set tmpDocs.STabNmb := Persons.strTabN;
            if (kolEd > 0 AND kolEd <> tmpDocs.WorkStations)
              kolEd := 0;

              //////
          }

        if (update current tmpDocs <> tsOk)
          {}
      }

  DoneMarker(Markers1   , 'CatalogsMarker1');
  DoneMarker(Markers2   , 'CatalogsMarker2');
  DoneMarker(Markers3   , 'CatalogsMarker3');

  if ((wFilters and 1) = 1)
    DoneMarker(DeptMarker , DeptMarkerName      );
  if ((wFilters and 2) = 2)
    DoneMarker(KategMarker, KategMarkerName     );

  delete all tmpDocs where ((0 == tmpDocs.isPrint));

  External _LOOP tmpIerPodr
    if (GetFirst tmpDocs where (( tmpIerPodr.NRec == tmpDocs.PodrRec)) <> tsOk)
      if (delete current tmpIerPodr <> tsOk)
        {}

  External _LOOP tmpIerPodr where (( comp(0)  << tmpIerPodr.cParent))
    if (GetFirst tmpIerPodr2 where ((tmpIerPodr.cParent ==  tmpIerPodr2.NRec)) <> tsOk)
      {
        set tmpIerPodr.cParent := comp(0);
        if (update current tmpIerPodr = tsOk)
          {}
      }

  StopVisual('',0);
}
//*****************************************************************************
Procedure PrintItem(code : string; dKolEd : double);
{
  pXL.ClearTblBuffer;
  pXL.SetTblStringFldValue('Total_MainCode'    , '''' + code);
  pXL.SetTblNumberFldValue('Total_Level'       , 0);
  pXL.SetTblNumberFldValue('Total_Type'        , 0);
  pXL.SetTblStringFldValue('Total_PodrCode'    , '''' + code);
  pXL.SetTblStringFldValue('Total_MainPodrCode', '''' + code);
  pXL.SetTblNumberFldValue('Total_CountSEd'    , dKolEd);
  pXL.SetTblStringFldValue('Total_Post'        , 'Итого по подразделению');
  pXL.InsTblRow;
}

//*****************************************************************************
Procedure PrintLineTotal;
{
  var sCode  : string;  sCode  := '';
  var bPrint : boolean; bPrint := false;
  var dKolEd : double;  dKolEd := 0; 
  _LOOP tmpDocs ordered by tmpDocs.PodrCode
    {
      NextVisual;

      if (sCode = SubStr(tmpDocs.PodrCode, 1, 3))
        {
          dKolEd := dKolEd + tmpDocs.CountSEd;
        }  
      else
        {
          if (bPrint)
            {
              PrintItem(sCode, dKolEd);
            }

          sCode := SubStr(tmpDocs.PodrCode, 1, 3);
          bPrint := true;
          dKolEd := tmpDocs.CountSEd;
        }
    }

  if (bPrint)
    {
      PrintItem(sCode, dKolEd);
    }
}

//*****************************************************************************
Procedure PrintLine(parent : comp; iLevel : word; var cntSubPodr : longint; var dKS : double);
{
   inc(iLevel);

   External _LOOP tmpIerPodr where ((parent == tmpIerPodr.cParent)) ordered tmpIerPodr.SortPodrCode
     {
       //logstrtofile('D:\log.txt', 'tmpIerPodr ->' + tmpIerPodr.PodrCode + ' ' + tmpIerPodr.PodrName);
       inc(cntSubPodr);
       var _CountSEd : double;
       var cnt : longint; cnt := 0;
       _LOOP tmpDocsPrn where ((tmpIerPodr.NRec == tmpDocsPrn.PodrRec)) ordered tmpDocsPrn.wOrder, tmpDocsPrn.bMulti(desc), tmpDocsPrn.Tarif(desc), tmpDocsPrn.TarifMax(desc)
         {
           //logstrtofile('D:\log.txt', 'tmpDocs ->' + tmpDocsPrn.PodrCode + ' ' + tmpDocsPrn.PodrName);
           NextVisual;

           inc(cnt);
           if (_needGroup) then {
           if (getfirst FastFirstRow tmpRepGroup where ((     tmpDocsPrn.PodrCode     == tmpRepGroup.PodrCode
                                                          and tmpDocsPrn.PostName     == tmpRepGroup.PostName
                                                          and tmpDocsPrn.Tarif        == tmpRepGroup.Tarif
                                                          and tmpDocsPrn.TarifMax     == tmpRepGroup.TarifMax
                                                          and tmpDocsPrn.TaxRate      == tmpRepGroup.TaxRate
                                                          and tmpDocsPrn.Discharge    == tmpRepGroup.Discharge
                                                          and tmpDocsPrn.Category     == tmpRepGroup.Category
                                                          and tmpDocsPrn.LevelPayment == tmpRepGroup.LevelPayment
                                                          and tmpDocsPrn.TypePayment  == tmpRepGroup.TypePayment
                                                          and tmpDocsPrn.ClassCondJob == tmpRepGroup.ClassCondJob
                                                 )) <> tsOk) then
           {
             insert tmpRepGroup
              set
                  PodrName        := tmpDocsPrn.PodrName,
                  PodrCode        := tmpDocsPrn.PodrCode,
                  Category        := tmpDocsPrn.Category,
                  SubCategory     := tmpDocsPrn.SubCategory,
                  PostName        := tmpDocsPrn.PostName,
                  Discharge       := tmpDocsPrn.Discharge,
                  CategoryW       := tmpDocsPrn.CategoryW,
                  LevelPayment    := tmpDocsPrn.LevelPayment,
                  CategoryW       := tmpDocsPrn.CategoryW,
                  LevelPayment    := tmpDocsPrn.LevelPayment,
                  Tarif           := tmpDocsPrn.Tarif,
                  TarifMax        := tmpDocsPrn.TarifMax,
                  TaxRate         := tmpDocsPrn.TaxRate,
                  dOklad          := tmpDocsPrn.dOklad,
                  TypePayment     := tmpDocsPrn.TypePayment,
                  RatePayment     := tmpDocsPrn.RatePayment,
                  ClassCondJob    := tmpDocsPrn.ClassCondJob,
                  DoplataUslT     := tmpDocsPrn.DoplataUslT,
                  DoplataOther    := tmpDocsPrn.DoplataOther,
                  VidPr           := tmpDocsPrn.VidPr,
                  CountSEd        := tmpDocsPrn.CountSEd,
                  sNote           := tmpDocsPrn.sNote;

             _CountSEd := 0;

             _loop tmpDocsPrn2 where ((     tmpRepGroup.PodrCode      == tmpDocsPrn2.PodrCode
                                        and tmpRepGroup.PostName      == tmpDocsPrn2.PostName
                                        and tmpRepGroup.Tarif         == tmpDocsPrn2.Tarif
                                        and tmpRepGroup.TarifMax      == tmpDocsPrn2.TarifMax
                                        and tmpRepGroup.TaxRate       == tmpDocsPrn2.TaxRate
                                        and tmpRepGroup.Discharge     == tmpDocsPrn2.Discharge
                                        and tmpRepGroup.Category      == tmpDocsPrn2.Category
                                        and tmpRepGroup.LevelPayment  == tmpDocsPrn2.LevelPayment
                                        and tmpRepGroup.TypePayment   == tmpDocsPrn2.TypePayment
                                        and tmpRepGroup.ClassCondJob  == tmpDocsPrn2.ClassCondJob))
               {
                 _CountSEd := _CountSEd + tmpDocsPrn2.CountsED;
               }
             }
             else
              {
                continue;
              }
           }
           else
            {
              _CountSEd := tmpDocsPrn.CountSEd
            }

             pXL.ClearTblBuffer;
             pXL.SetTblStringFldValue('MainCode'    , '''' + SubStr(tmpDocsPrn.PodrCode,1,3));
             pXL.SetTblNumberFldValue('Level'       , iLevel);
             pXL.SetTblNumberFldValue('Type'        , 0);
             pXL.SetTblStringFldValue('NRec'        , tmpDocsPrn.NRec        );
             pXL.SetTblStringFldValue('cStaffStruct', tmpDocsPrn.cStaffStruct);
             pXL.SetTblStringFldValue('nRecKPS'     , tmpDocsPrn.nRecKPS     );
             pXL.SetTblStringFldValue('PodrName'    , tmpDocsPrn.PodrName);
             pXL.SetTblStringFldValue('PodrCode'    , tmpDocsPrn.PodrCode);
             pXL.SetTblStringFldValue('MainPodrCode', '''' + tmpDocsPrn.ParentPodrCode);

             pXL.SetTblStringFldValue('Category'    , tmpDocsPrn.Category   );
             pXL.SetTblStringFldValue('SubCategory' , tmpDocsPrn.SubCategory);

             pXL.SetTblStringFldValue('Post'        , tmpDocsPrn.PostName);

             if (tmpDocsPrn.Discharge <> 0)
               pXL.SetTblStringFldValue('Discharge'   , tmpDocsPrn.Discharge);

             pXL.SetTblStringFldValue('CategoryW'   , tmpDocsPrn.CategoryW);

             pXL.SetTblStringFldValue('LevelPayment', '''' + tmpDocsPrn.LevelPayment);
             pXL.SetTblNumberFldValue('Tarif'       , tmpDocsPrn.Tarif);
             if (tmpDocsPrn.isWorker = 0)
               pXL.SetTblNumberFldValue('TarifMax'  , tmpDocsPrn.TarifMax);


             pXL.SetTblNumberFldValue('TarifCur', tmpDocsPrn.TaxRate);

             if (tmpDocsPrn.dOklad > 0)
               pXL.SetTblNumberFldValue('dOklad'      , tmpDocsPrn.dOklad);

             pXL.SetTblStringFldValue('TypePayment' , tmpDocsPrn.TypePayment);
             pXL.SetTblStringFldValue('RatePayment' , tmpDocsPrn.RatePayment);
             pXL.SetTblStringFldValue('ClassCondJob', '''' + tmpDocsPrn.ClassCondJob);

             if (tmpDocsPrn.DoplataUslT <> 0)
               pXL.SetTblNumberFldValue('DoplataUslT' , tmpDocsPrn.DoplataUslT);
             if (tmpDocsPrn.DoplataOther <> 0)
               pXL.SetTblNumberFldValue('DoplataOther', tmpDocsPrn.DoplataOther);

             pXL.SetTblStringFldValue('VidPr', tmpDocsPrn.VidPr);

             pXL.SetTblNumberFldValue('CountSEd'    , _CountSEd);
             pXL.SetTblStringFldValue('sNote'       , tmpDocsPrn.sNote   );

             pXL.SetTblStringFldValue('OKPDTR', tmpDocsPrn.CatCode);
             pXL.SetTblStringFldValue('TABNMB', chr(39) + tmpDocsPrn.STabNmb);

             pXL.SetTblStringFldValue('FIO'         , tmpDocsPrn.FIO     );
             pXL.SetTblStringFldValue('BalanSch'    , sGetAttr(coStaffStruct,tmpDocsPrn.cStaffStruct,'Балансовый счет присвоенный к должности') );
             pXL.SetTblStringFldValue('CategorGK'   , sGetAttr(coStaffStruct,tmpDocsPrn.cStaffStruct,'Категория по методике категорирования ГК') );

             pXL.SetTblStringFldValue('Grade'   , GetGrayd(ts1.Naitar, 1) );
             pXL.SetTblStringFldValue('VGZ'   , GetGrayd(ts1.Naitar, 2) );
             pXL.SetTblStringFldValue('ISN'   , tmpDocsPrn.isn );
             pXL.SetTblStringFldValue('SECRET'   , tmpDocsPrn.SECRET );
             pXL.SetTblStringFldValue('EPREM'   , tmpDocsPrn.EPREM );

             pXL.InsTblRow;
             dKS := dKS + tmpDocsPrn.CountSEd;



         }
       if (cnt > 0)
         {
           pXL.ClearTblBuffer;
           pXL.SetTblNumberFldValue('Level'       , iLevel);
           pXL.SetTblNumberFldValue('Type'        , 1);
           pXL.SetTblStringFldValue('Post'        , if (Length(tmpDocsPrn.PodrCode) = 3, 'Итого по подразделению', 'Итого'));
           pXL.SetTblStringFldValue('PodrCode'    , '''' + tmpDocsPrn.PodrCode);
           pXL.InsTblRow;
         }

       var tmpCnt : longint; tmpCnt := 0;
       PrintLine(tmpIerPodr.NRec, iLevel, tmpCnt, dKS);
       cntSubPodr += tmpCnt;
     }

   if (cntSubPodr > 0 AND iLevel > 1 AND sLastPodrPrint <> tmpIerPodr.ParentPodrCode)
     {
       cntSubPodr := 0;
       pXL.ClearTblBuffer;
       pXL.SetTblNumberFldValue('Level'       , iLevel - 1);
       pXL.SetTblNumberFldValue('Type'        , 2);
       pXL.SetTblStringFldValue('Post'        , if (Length(tmpIerPodr.ParentPodrCode) = 3, 'Итого по подразделению', 'Итого'));
       pXL.SetTblStringFldValue('PodrCode'    , '''' + tmpIerPodr.ParentPodrCode);
       pXL.SetTblNumberFldValue('CountSEd'    , dKS);
       dKS := 0;
       pXL.InsTblRow;
       sLastPodrPrint := tmpIerPodr.ParentPodrCode;
     }
}

//*****************************************************************************
Procedure PrintRepost;
{
  ID := if (wType = 0, 'StaffStructNewEM', 'StaffStructNewRastEM');

  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpDocs));

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'       , CommonFormHeader);
  pXL.SetStringVar('sOrgName',   oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', StrToDate(dDateDoc, 'DD/MM/YYYY')));
  if (GetFirst KatOrg where ((coGetTune('MyOrg') == KatOrg.NRec)) = tsOk)
    {
      pXL.SetStringVar('sOrgOkpo'  , '''' + KatOrg.Okpo);
      pXL.SetStringVar('sShortName', KatOrg.ShortName);
    }

  pXL.SetStringVar('sNumDoc'   , '''' + sNumDoc  );
  pXL.SetStringVar('dDateDoc'  , '''' + Replace(dDateDoc, '/', '.'));
  pXL.SetStringVar('dPeriod'   , '''' + dateSts);
  pXL.SetStringVar('sNumPrikaz', sNumPrikaz);
  pXL.SetStringVar('dPrikaz'   , '''' + dPrikaz  );
  pXL.SetNumberVar('dKolPers'  , dKolPers  );
  pXL.SetStringVar('osnova'    , if (Trim(sNumPrikaz) = '', '', '№' + sNumPrikaz) + if(Trim(dPrikaz) = '', '', ' от ' + dPrikaz));
  pXL.SetStringVar('Year'      , SubStr(dPrikaz, length(dStaffStr) - 3, 4));

  if (GetFirst PersonsDop = tsOk)
    {
      pXL.SetStringVar('DopFIO'   , iPsnFunc.GetFIO(PersonsDop.NRec));

      if (GetFirst CatalogsDop = tsOk)
        pXL.SetStringVar('DopPost', CatalogsDop.Name);
    }

  if (iFeeSigners.FeeSignersIsValid)
  {
    var wFeeSignersNum, wFeeSignersCount : word;
    wFeeSignersCount := iFeeSigners.GetFeeSignersCount;

    if (iFeeSigners.GetSignerFirst)
    {
      For (wFeeSignersNum := 1; wFeeSignersNum <= wFeeSignersCount; wFeeSignersNum++)
      {
         if (iFeeSigners.GetSignerRole = 'Согласовано (шапка)')
         {
           pXL.SetStringVar('soglFIOHead', GetFioSinger(iFeeSigners.GetSignerNRec));//GetFIO(iFeeSigners.GetSignerFIO(7), false));
           pXL.SetStringVar('soglDolHead', iFeeSigners.GetSignerPosition(1));
         }
         else if (iFeeSigners.GetSignerRole = 'Утверждающее лицо')
         {
           pXL.SetStringVar('utvFIOHead', GetFioSinger(iFeeSigners.GetSignerNRec));//GetFIO(iFeeSigners.GetSignerFIO(7), false));
           pXL.SetStringVar('utvDolHead', iFeeSigners.GetSignerPosition(1));
         }
         else if (iFeeSigners.GetSignerRole = 'Согласовано')
         {
           pXL.SetStringVar('soglFIO', GetFioSinger(iFeeSigners.GetSignerNRec));//GetFIO(iFeeSigners.GetSignerFIO(7), false));
           pXL.SetStringVar('soglDol', iFeeSigners.GetSignerPosition(1));
         }
         else
         {
           ClearBuffer(#tmpSigners);
           tmpSigners.kod := iFeeSigners.GetSignerNumber;
           tmpSigners.Fio     := GetFioSinger(iFeeSigners.GetSignerNRec);//GetFIO(iFeeSigners.GetSignerFIO(7), false);
           tmpSigners.Dol := iFeeSigners.GetSignerPosition(1);
           tmpSigners.cSinger := iFeeSigners.GetSignerNRec;
           if (insert current tmpSigners = tsOk)
             {}
         }

        if (not iFeeSigners.GetSignerNext)
          break;
      }
    }
  }

  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('StaffStructEM');
  pXL.CreateTblFld('Level');
  pXL.CreateTblFld('Type');
  pXL.CreateTblFld('NRec');
  pXL.CreateTblFld('cStaffStruct');
  pXL.CreateTblFld('nRecKPS');
  pXL.CreateTblFld('PodrName');
  pXL.CreateTblFld('PodrCode');
  pXL.CreateTblFld('MainPodrCode');
  pXL.CreateTblFld('Post');
  pXL.CreateTblFld('Discharge');
  pXL.CreateTblFld('Category');
  pXL.CreateTblFld('VidPr');
  pXL.CreateTblFld('CategoryW');
  pXL.CreateTblFld('SubCategory');
  pXL.CreateTblFld('LevelPayment');
  pXL.CreateTblFld('TypePayment');
  pXL.CreateTblFld('CountSEd');
  pXL.CreateTblFld('RatePayment');
  pXL.CreateTblFld('Tarif');
  pXL.CreateTblFld('TarifMax');
  pXL.CreateTblFld('DoplataUslT');
  pXL.CreateTblFld('DoplataOther');
  pXL.CreateTblFld('sNote');
  pXL.CreateTblFld('FIO');
  pXL.CreateTblFld('ClassCondJob');
  pXL.CreateTblFld('dOklad');
  pXL.CreateTblFld('CountSEd_Vac');
  pXL.CreateTblFld('MainCode');
  pXL.CreateTblFld('TarifCur');
  pXL.CreateTblFld('OKPDTR');
  pXL.CreateTblFld('TABNMB');
  pXL.CreateTblFld('BalanSch');
  pXL.CreateTblFld('CategorGK');
  pXL.CreateTblFld('Grade');
  pXL.CreateTblFld('VGZ');
  pXL.CreateTblFld('ISN');
  pXL.CreateTblFld('SECRET');
  pXL.CreateTblFld('EPREM');

  var cntSubPodr : longint; cntSubPodr := 0;
  var dKS        : double;         dKS := 0;
  PrintLine(comp(0), 0, cntSubPodr, dKS);

  pXL.PublishTbl('StaffStructEM');

  if (wType = 0)
    { 
      pXL.CreateTbl('StaffStructEM_Total');
      pXL.CreateTblFld('Total_Level');
      pXL.CreateTblFld('Total_Type');
      pXL.CreateTblFld('Total_NRec');
      pXL.CreateTblFld('Total_cStaffStruct');
      pXL.CreateTblFld('Total_nRecKPS');
      pXL.CreateTblFld('Total_PodrName');
      pXL.CreateTblFld('Total_PodrCode');
      pXL.CreateTblFld('Total_MainPodrCode');
      pXL.CreateTblFld('Total_Post');
      pXL.CreateTblFld('Total_Discharge');
      pXL.CreateTblFld('Total_Category');
      pXL.CreateTblFld('Total_VidPr');
      pXL.CreateTblFld('Total_CategoryW');
      pXL.CreateTblFld('Total_SubCategory');
      pXL.CreateTblFld('Total_LevelPayment');
      pXL.CreateTblFld('Total_TypePayment');
      pXL.CreateTblFld('Total_CountSEd');
      pXL.CreateTblFld('Total_RatePayment');
      pXL.CreateTblFld('Total_Tarif');
      pXL.CreateTblFld('Total_TarifMax');
      pXL.CreateTblFld('Total_DoplataUslT');
      pXL.CreateTblFld('Total_DoplataOther');
      pXL.CreateTblFld('Total_sNote');
      pXL.CreateTblFld('Total_FIO');
      pXL.CreateTblFld('Total_ClassCondJob');
      pXL.CreateTblFld('Total_dOklad');
      pXL.CreateTblFld('Total_CountSEd_Vac');
      pXL.CreateTblFld('Total_MainCode');
      pXL.CreateTblFld('Total_Grade');
      pXL.CreateTblFld('Total_VGZ');

      PrintLineTotal;

      pXL.PublishTbl('StaffStructEM_Total');
    }

  pXL.CreateTbl('StaffStructEM_Singer');
  pXL.CreateTblFld('SignerFIO');
  pXL.CreateTblFld('SignerDol');

  _LOOP tmpSigners
    {
       pXL.ClearTblBuffer;
       pXL.SetTblStringFldValue('SignerFIO', tmpSigners.FIO);//GetFIO(tmpSigners.FIO, false));
       pXL.SetTblStringFldValue('SignerDol', tmpSigners.Dol);
       pXL.InsTblRow;
       //pXL.ClearTblBuffer;
       //pXL.SetTblStringFldValue('SignerFIO', '');
       //pXL.SetTblStringFldValue('SignerDol', '');
       //pXL.InsTblRow;
    }

  pXL.PublishTbl('StaffStructEM_Singer');

  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);

}

//*****************************************************************************
  SQL QUERY SqltmpDocs =
    SELECT
       #comp(0)                                                                                      as NRec
     , SS.NRec                                                                                       as cStaffStruct
     , #comp(0)                                                                                      as nRecKPS
     , Coalesce(CH.Name, Coalesce(CD.Name, ''))                                                      as PodrName
     , Coalesce(CH.Code, Coalesce(CD.Code, ''))                                                      as PodrCode
     , SS.Department                                                                                 as PodrRec
     , Coalesce(CP.bMulti, 0)                                                                        as bMulti
     , Coalesce(PCD.Name, '')                                                                        as ParentPodrName
     , Coalesce(PCD.Code, '')                                                                        as ParentPodrCode
     , Coalesce(CD.cParent, #comp(0))                                                                as ParentPodrRec
     , SS.Post                                                                                       as PostNRec
     , Coalesce(CP.Name, '')                                                                         as PostName
     , Coalesce(CP.Code, '')                                                                         as PostCode
     , Coalesce(HH.wCategory, SS.Category)                                                           as Discharge
     , Coalesce(SK.Code, '')                                                                         as VidPr
     , CASE WHEN Coalesce(KK.Kod, 9999) < 5 THEN 'рабочие'
                                            ELSE 'РСС' END                                           as CategoryW
     , Coalesce(KK.NaiKat, '')                                                                       as SubCategory
     , Coalesce(GPTSE.NameT3, Coalesce(TS.NAITAR, ''))                                               as LevelPayment
     , CASE WHEN UPPER(Coalesce(KSO.NaSisOpl, '')) = 'ОКЛАД' THEN 'повременная'
                                                             ELSE Coalesce(KSO.NaSisOpl, '') END     as TypePayment
     , Coalesce(HH.HWorkStations, SS.WorkStations)                                                   as CountSEd
     , CASE WHEN UPPER(Coalesce(KSO.NaSisOpl, '')) = 'ОКЛАД'
             AND Coalesce(KK.Kod, 9999) < 5  THEN
               CASE WHEN Coalesce(TS.Summa1, 0) > 0 THEN 'МТС' ELSE 'Оклад' END
            ELSE
               CASE WHEN UPPER(Coalesce(KSO.NaSisOpl, '')) = 'СДЕЛЬНАЯ' THEN 'ЧТС' 
                    ELSE Coalesce(KSO.NaSisOpl, '') 
               END
       END                                                                                           as RatePayment
     , 0                                                                                             as DoplataUslT
     , 0                                                                                             as DoplataOther
     , ''                                                                                            as sNote
     , ''                                                                                            as FIO
     , Coalesce(KK.Kod, 0)                                                                           as Category
     , CASE WHEN Coalesce(KK.Kod, 99999) < 5 THEN 1
                                             ELSE 0 END                                              as isWorker
     , CASE WHEN Coalesce(KK.Kod, 99999) < 5 THEN Coalesce(HH.HTaxRate, SS.TaxRate)
                                             ELSE Coalesce(HH.HMinTaxRate, SS.MinSumma) END          as Tarif
     , Coalesce(HH.HMaxTaxRate, SS.MaxSumma)                                                         as TarifMax
     , Coalesce(SWCC.Code, '')                                                                       as ClassCondJob
     , Coalesce(KK.wChoise, 0)                                                                       as wOrder
     , Coalesce(HH.HTaxRate, SS.TaxRate)                                                             as dOklad
     , CASE WHEN LTrim(RTrim(Coalesce(CD.Code, '')))  = '' THEN REPLACE(LPAD('', 20), ' ', '0') + '-' + REPLACE(LPAD('', 20), ' ', '0')
            WHEN INSTR('-', Coalesce(CD.Code, ''), 1) = 0  THEN REPLACE(LPAD('', 20-LENGTH(Coalesce(CD.Code, ''))), ' ', '0')
                                                              + Coalesce(CD.Code, '') + '-' + REPLACE(LPAD('', 20), ' ', '0')
            WHEN INSTR('-', Coalesce(CD.Code, ''), 1) > 0  THEN REPLACE(LPAD('', 20-LENGTH(SUBSTRING(Coalesce(CD.Code, ''),1, INSTR('-', Coalesce(CD.Code, ''), 1)-1))), ' ', '0')
                                                              + SUBSTRING(Coalesce(CD.Code, ''),1, INSTR('-', Coalesce(CD.Code, ''), 1)-1)
                                                              + '-'
                                                      	      + REPLACE(LPAD('', 20-LENGTH(SUBSTRING(Coalesce(CD.Code, ''), INSTR('-', Coalesce(CD.Code, ''), 1) + 1, LENGTH(Coalesce(CD.Code, '')) -INSTR('-', Coalesce(CD.Code, ''))))), ' ', '0')
		                                                          + SUBSTRING(Coalesce(CD.Code, ''), INSTR('-', Coalesce(CD.Code, ''), 1) + 1, LENGTH(Coalesce(CD.Code, '')) -INSTR('-', Coalesce(CD.Code, ''), 1))
            ELSE Coalesce(CD.Code, '')
       END                                                                                           as SortPodrCode
     , 0                                                                                             as isPrint
     , Coalesce(KK.NRec, #comp(0))                                                                   as CategID
     , #comp(0)                                                                                      as cParent
     , Coalesce(HH.HWorkStations, SS.WorkStations)                                                   as WorkStations
     , Coalesce(HH.HTaxRate, SS.TaxRate)                                                             as TaxRate
     , cCode.Code                                                                                    as CatCode
    FROM
         StaffStruct SS  LEFT JOIN Catalogs      CD       on SS.Department  = CD.NRec
                         LEFT JOIN Catalogs      PCD      on CD.cParent     = PCD.NRec
                         LEFT JOIN Catalogs      CP       on SS.Post        = CP.NRec
                         LEFT JOIN Attrnam       anC      on 25031          = anC.wTable
                                                         and 'Профессия'    = anC.Name
                         LEFT JOIN Attrval       avC      on anC.wTable     = avC.wTable
                                                         and anC.nRec       = avC.cAttrNam
                                                         and CP.nRec        = avC.cRec
                         LEFT JOIN SpKau         cCode    on avC.vComp      = cCode.nRec

                         LEFT JOIN KlKatego      KK       on SS.EmpCategory = KK.NRec
                         LEFT JOIN TarStav       TS       on SS.Tariff      = TS.Nrec
                         LEFT JOIN GP_TarStavExt GPTSE    on SS.Tariff      = GPTSE.cTarStav
                         LEFT JOIN KlSisOpl      KSO      on SS.PayModel    = KSO.SisOpl
                         LEFT JOIN Catalogs      SWCC     on SS.WorkCond    = SWCC.Nrec
                         LEFT JOIN (SELECT MAX(NRec)  OVER (PARTITION BY StaffStr, dHist) maxNRec
                                         , MAX(dHist) OVER (PARTITION BY StaffStr) maxDate
                                         //, H.*
                                         ,H.wCategory
                                         ,H.HWorkStations
                                         ,H.HMinTaxRate
                                         //убираем ошибку с правами на поля
                                         ,(H.HTaxRate +0.00) as HTaxRate
                                         ,H.HMaxTaxRate
                                         ,H.StaffStr
                                         ,H.dHist
                                         ,H.NRec
                                    FROM HistoryStr H
                                    WHERE dHist <= :dateSts) HH on SS.NRec    = HH.StaffStr
                                                               AND HH.maxDate = HH.dHist
                                                               AND HH.maxNRec = HH.NRec
                         LEFT JOIN AttrVal       AV       on :wTable          = AV.wTable
                                                         AND SS.Department    = AV.cRec
                                                         AND :AttrName        = AV.cAttrNam
                         LEFT JOIN SpKau         SK       on AV.vComp         = SK.NRec
                         LEFT JOIN (SELECT tCH.NRec, tCH.cCat, MAX(tCH.NRec)  OVER (PARTITION BY tCH.cCat) maxNRec, tCH.Name, tCH.Code
                                    FROM CatHist tCH
                                    WHERE :NeedDate       >= tCH.Dat1 
                                       AND (:NeedDate       < tCH.Dat2
                                         OR 0               = tCH.Dat2)
                                   ) CH       on SS.Department    = CH.cCat AND CH.NRec = CH.maxNRec
   WHERE   :dateSts >= SS.dInput
      AND (:dateSts <= SS.dClose 
        OR 0 = SS.dClose)
  ;
//*****************************************************************************
  SQL QUERY SqltmpIerPodr =
      SELECT 
         SS.PodrNRec                              as NRec
       , Coalesce(CD.cParent, #comp(0))           as cParent
       , Coalesce(CH.Name, Coalesce(CD.Name, '')) as PodrName
       , Coalesce(CH.Code, Coalesce(CD.Code, '')) as PodrCode
       , Coalesce(PCD.Name, '')                   as ParentPodrName
       , Coalesce(PCD.Code, '')                   as ParentPodrCode
       , CASE WHEN LTrim(RTrim(Coalesce(CD.Code, '')))  = '' THEN REPLACE(LPAD('', 20), ' ', '0') + '-' + REPLACE(LPAD('', 20), ' ', '0')
              WHEN INSTR('-', Coalesce(CD.Code, ''), 1) = 0  THEN REPLACE(LPAD('', 20-LENGTH(Coalesce(CD.Code, ''))), ' ', '0')
                                                                + Coalesce(CD.Code, '') + '-' + REPLACE(LPAD('', 20), ' ', '0')
              WHEN INSTR('-', Coalesce(CD.Code, ''), 1) > 0  THEN REPLACE(LPAD('', 20-LENGTH(SUBSTRING(Coalesce(CD.Code, ''),1, INSTR('-', Coalesce(CD.Code, ''), 1)-1))), ' ', '0')
                                                                + SUBSTRING(Coalesce(CD.Code, ''),1, INSTR('-', Coalesce(CD.Code, ''), 1)-1)
                                                                + '-'
                                                        	      + REPLACE(LPAD('', 20-LENGTH(SUBSTRING(Coalesce(CD.Code, ''), INSTR('-', Coalesce(CD.Code, ''), 1) + 1, LENGTH(Coalesce(CD.Code, '')) -INSTR('-', Coalesce(CD.Code, ''))))), ' ', '0')
		                                                            + SUBSTRING(Coalesce(CD.Code, ''), INSTR('-', Coalesce(CD.Code, ''), 1) + 1, LENGTH(Coalesce(CD.Code, '')) -INSTR('-', Coalesce(CD.Code, ''), 1))
              ELSE Coalesce(CD.Code, '')
         END                                     as SortPodrCode
      FROM (SELECT Department  as PodrNRec
            FROM   StaffStruct
            WHERE   :dateSts >= dInput
               AND (:dateSts <= dClose
                 OR 0 = dClose)
               AND Department > #comp(0)
            GROUP BY Department
           ) SS LEFT JOIN Catalogs CD  on SS.PodrNRec  = CD.NRec
                LEFT JOIN Catalogs PCD on CD.cParent   = PCD.NRec
                LEFT JOIN (SELECT tCH.NRec, tCH.cCat, MAX(tCH.NRec)  OVER (PARTITION BY tCH.cCat) maxNRec, tCH.Name, tCH.Code
                           FROM CatHist tCH
                           WHERE :NeedDate       >= tCH.Dat1 
                              AND (:NeedDate       < tCH.Dat2
                                OR 0               = tCH.Dat2)
                          ) CH       on SS.PodrNRec = CH.cCat AND CH.NRec = CH.maxNRec
  ;

//*****************************************************************************

SQL QUERY SqltmpDocs2 =
    SELECT
       #comp(0)                                                                                      as NRec
     , SS.NRec                                                                                       as cStaffStruct
     , #comp(0)                                                                                      as nRecKPS
     , Coalesce(CH.Name, Coalesce(CD.Name, ''))                                                      as PodrName
     , Coalesce(CH.Code, Coalesce(CD.Code, ''))                                                      as PodrCode
     , SS.Department                                                                                 as PodrRec
     , Coalesce(CP.bMulti, 0)                                                                        as bMulti
     , Coalesce(PCD.Name, '')                                                                        as ParentPodrName
     , Coalesce(PCD.Code, '')                                                                        as ParentPodrCode
     , Coalesce(CD.cParent, #comp(0))                                                                as ParentPodrRec
     , SS.Post                                                                                       as PostNRec
     , Coalesce(CP.Name, '')                                                                         as PostName
     , Coalesce(CP.Code, '')                                                                         as PostCode
     , Coalesce(HH.wCategory, SS.Category)                                                           as Discharge
     , Coalesce(SK.Code, '')                                                                         as VidPr
     , CASE WHEN Coalesce(KK.Kod, 9999) < 5 THEN 'рабочие'
                                            ELSE 'РСС' END                                           as CategoryW
     , Coalesce(KK.NaiKat, '')                                                                       as SubCategory
     , Coalesce(GPTSE.NameT3, Coalesce(TS.NAITAR, ''))                                               as LevelPayment
     , CASE WHEN UPPER(Coalesce(KSO.NaSisOpl, '')) = 'ОКЛАД' THEN 'повременная'
                                                             ELSE Coalesce(KSO.NaSisOpl, '') END     as TypePayment
     , SUM(Coalesce(HH.HWorkStations, SS.WorkStations))                                                   as CountSEd
     , CASE WHEN UPPER(Coalesce(KSO.NaSisOpl, '')) = 'ОКЛАД'
             AND Coalesce(KK.Kod, 9999) < 5  THEN
               CASE WHEN Coalesce(TS.Summa1, 0) > 0 THEN 'МТС' ELSE 'Оклад' END
            ELSE
               CASE WHEN UPPER(Coalesce(KSO.NaSisOpl, '')) = 'СДЕЛЬНАЯ' THEN 'ЧТС'
                    ELSE Coalesce(KSO.NaSisOpl, '')
               END
       END                                                                                           as RatePayment
     , 0                                                                                             as DoplataUslT
     , 0                                                                                             as DoplataOther
     , ''                                                                                            as sNote
     , ''                                                                                            as FIO
     , Coalesce(KK.Kod, 0)                                                                           as Category
     , CASE WHEN Coalesce(KK.Kod, 99999) < 5 THEN 1
                                             ELSE 0 END                                              as isWorker
     , CASE WHEN Coalesce(KK.Kod, 99999) < 5 THEN Coalesce(HH.HTaxRate, SS.TaxRate)
                                             ELSE Coalesce(HH.HMinTaxRate, SS.MinSumma) END          as Tarif
     , Coalesce(HH.HMaxTaxRate, SS.MaxSumma)                                                         as TarifMax
     , Coalesce(SWCC.Code, '')                                                                       as ClassCondJob
     , Coalesce(KK.wChoise, 0)                                                                       as wOrder
     , Coalesce(HH.HTaxRate, SS.TaxRate)                                                             as dOklad
     , CASE WHEN LTrim(RTrim(Coalesce(CD.Code, '')))  = '' THEN REPLACE(LPAD('', 20), ' ', '0') + '-' + REPLACE(LPAD('', 20), ' ', '0')
            WHEN INSTR('-', Coalesce(CD.Code, ''), 1) = 0  THEN REPLACE(LPAD('', 20-LENGTH(Coalesce(CD.Code, ''))), ' ', '0')
                                                              + Coalesce(CD.Code, '') + '-' + REPLACE(LPAD('', 20), ' ', '0')
            WHEN INSTR('-', Coalesce(CD.Code, ''), 1) > 0  THEN REPLACE(LPAD('', 20-LENGTH(SUBSTRING(Coalesce(CD.Code, ''),1, INSTR('-', Coalesce(CD.Code, ''), 1)-1))), ' ', '0')
                                                              + SUBSTRING(Coalesce(CD.Code, ''),1, INSTR('-', Coalesce(CD.Code, ''), 1)-1)
                                                              + '-'
                                                      	      + REPLACE(LPAD('', 20-LENGTH(SUBSTRING(Coalesce(CD.Code, ''), INSTR('-', Coalesce(CD.Code, ''), 1) + 1, LENGTH(Coalesce(CD.Code, '')) -INSTR('-', Coalesce(CD.Code, ''))))), ' ', '0')
		                                                          + SUBSTRING(Coalesce(CD.Code, ''), INSTR('-', Coalesce(CD.Code, ''), 1) + 1, LENGTH(Coalesce(CD.Code, '')) -INSTR('-', Coalesce(CD.Code, ''), 1))
            ELSE Coalesce(CD.Code, '')
       END                                                                                           as SortPodrCode
     , 0                                                                                             as isPrint
     , Coalesce(KK.NRec, #comp(0))                                                                   as CategID
     , #comp(0)                                                                                      as cParent
     , Coalesce(HH.HWorkStations, SS.WorkStations)                                                   as WorkStations
     , Coalesce(HH.HTaxRate, SS.TaxRate)                                                             as TaxRate
    FROM
         StaffStruct SS  LEFT JOIN Catalogs      CD       on SS.Department  = CD.NRec
                         LEFT JOIN Catalogs      PCD      on CD.cParent     = PCD.NRec
                         LEFT JOIN Catalogs      CP       on SS.Post        = CP.NRec
                         LEFT JOIN KlKatego      KK       on SS.EmpCategory = KK.NRec
                         LEFT JOIN TarStav       TS       on SS.Tariff      = TS.Nrec
                         LEFT JOIN GP_TarStavExt GPTSE    on SS.Tariff      = GPTSE.cTarStav
                         LEFT JOIN KlSisOpl      KSO      on SS.PayModel    = KSO.SisOpl
                         LEFT JOIN Catalogs      SWCC     on SS.WorkCond    = SWCC.Nrec
                         LEFT JOIN (SELECT MAX(NRec)  OVER (PARTITION BY StaffStr, dHist) maxNRec
                                         , MAX(dHist) OVER (PARTITION BY StaffStr) maxDate
                                         //, H.*
                                         ,H.wCategory
                                         ,H.HWorkStations
                                         ,H.HMinTaxRate
                                         //убираем ошибку с правами на поля
                                         ,(H.HTaxRate +0.00) as HTaxRate
                                         ,H.HMaxTaxRate
                                         ,H.StaffStr
                                         ,H.dHist
                                         ,H.NRec
                                    FROM HistoryStr H
                                    WHERE dHist <= :dateSts) HH on SS.NRec    = HH.StaffStr
                                                               AND HH.maxDate = HH.dHist
                                                               AND HH.maxNRec = HH.NRec
                         LEFT JOIN AttrVal       AV       on :wTable          = AV.wTable
                                                         AND SS.Department    = AV.cRec
                                                         AND :AttrName        = AV.cAttrNam
                         LEFT JOIN SpKau         SK       on AV.vComp         = SK.NRec
                         LEFT JOIN (SELECT tCH.NRec, tCH.cCat, MAX(tCH.NRec)  OVER (PARTITION BY tCH.cCat) maxNRec, tCH.Name, tCH.Code
                                    FROM CatHist tCH
                                    WHERE :NeedDate       >= tCH.Dat1
                                       AND (:NeedDate       < tCH.Dat2
                                         OR 0               = tCH.Dat2)
                                   ) CH       on SS.Department    = CH.cCat AND CH.NRec = CH.maxNRec
   WHERE   :dateSts >= SS.dInput
      AND (:dateSts <= SS.dClose
        OR 0 = SS.dClose)
   GROUP BY
       SS.NRec
     , Coalesce(CH.Name, Coalesce(CD.Name, ''))
     , Coalesce(CH.Code, Coalesce(CD.Code, ''))
     , SS.Department
     , Coalesce(CP.bMulti, 0)
     , Coalesce(PCD.Name, '')
     , Coalesce(PCD.Code, '')
     , Coalesce(CD.cParent, #comp(0))
     , SS.Post
     , Coalesce(CP.Name, '')
     , Coalesce(CP.Code, '')
     , Coalesce(HH.wCategory, SS.Category)
     , Coalesce(SK.Code, '')
     , CASE WHEN Coalesce(KK.Kod, 9999) < 5 THEN 'рабочие'
                                            ELSE 'РСС' END
     , Coalesce(KK.NaiKat, '')
     , Coalesce(GPTSE.NameT3, Coalesce(TS.NAITAR, ''))
     , CASE WHEN UPPER(Coalesce(KSO.NaSisOpl, '')) = 'ОКЛАД' THEN 'повременная'
                                                             ELSE Coalesce(KSO.NaSisOpl, '') END
     , CASE WHEN UPPER(Coalesce(KSO.NaSisOpl, '')) = 'ОКЛАД'
             AND Coalesce(KK.Kod, 9999) < 5  THEN
               CASE WHEN Coalesce(TS.Summa1, 0) > 0 THEN 'МТС' ELSE 'Оклад' END
            ELSE
               CASE WHEN UPPER(Coalesce(KSO.NaSisOpl, '')) = 'СДЕЛЬНАЯ' THEN 'ЧТС'
                    ELSE Coalesce(KSO.NaSisOpl, '')
               END
       END
     , Coalesce(KK.Kod, 0)
     , CASE WHEN Coalesce(KK.Kod, 99999) < 5 THEN 1
                                             ELSE 0 END
     , CASE WHEN Coalesce(KK.Kod, 99999) < 5 THEN Coalesce(HH.HTaxRate, SS.TaxRate)
                                             ELSE Coalesce(HH.HMinTaxRate, SS.MinSumma) END
     , Coalesce(HH.HMaxTaxRate, SS.MaxSumma)
     , Coalesce(SWCC.Code, '')
     , Coalesce(KK.wChoise, 0)
     , Coalesce(HH.HTaxRate, SS.TaxRate)
     , CASE WHEN LTrim(RTrim(Coalesce(CD.Code, '')))  = '' THEN REPLACE(LPAD('', 20), ' ', '0') + '-' + REPLACE(LPAD('', 20), ' ', '0')
            WHEN INSTR('-', Coalesce(CD.Code, ''), 1) = 0  THEN REPLACE(LPAD('', 20-LENGTH(Coalesce(CD.Code, ''))), ' ', '0')
                                                              + Coalesce(CD.Code, '') + '-' + REPLACE(LPAD('', 20), ' ', '0')
            WHEN INSTR('-', Coalesce(CD.Code, ''), 1) > 0  THEN REPLACE(LPAD('', 20-LENGTH(SUBSTRING(Coalesce(CD.Code, ''),1, INSTR('-', Coalesce(CD.Code, ''), 1)-1))), ' ', '0')
                                                              + SUBSTRING(Coalesce(CD.Code, ''),1, INSTR('-', Coalesce(CD.Code, ''), 1)-1)
                                                              + '-'
                                                      	      + REPLACE(LPAD('', 20-LENGTH(SUBSTRING(Coalesce(CD.Code, ''), INSTR('-', Coalesce(CD.Code, ''), 1) + 1, LENGTH(Coalesce(CD.Code, '')) -INSTR('-', Coalesce(CD.Code, ''))))), ' ', '0')
		                                                          + SUBSTRING(Coalesce(CD.Code, ''), INSTR('-', Coalesce(CD.Code, ''), 1) + 1, LENGTH(Coalesce(CD.Code, '')) -INSTR('-', Coalesce(CD.Code, ''), 1))
            ELSE Coalesce(CD.Code, '')
       END
     , Coalesce(KK.NRec, #comp(0))
     , Coalesce(HH.HWorkStations, SS.WorkStations)
     , Coalesce(HH.HTaxRate, SS.TaxRate)
  ;

//*****************************************************************************



function FullTables(sqlHandle : string; tableHandle : longint) : boolean;
{
  var stmt             : Longint;
  var ExecuteErrorCode : longint;
  result := false;
  _try
    {
      sqlFreeStr(stmt);
      stmt :=0;
      stmt := sqlAllocStmt;
      ExecuteErrorCode:=sqlPrepare(stmt,sqlHandle);
      if (ExecuteErrorCode = 0)
        {
          sqlBindParamByName(stmt,'dateSts'      , dateSts);
          sqlBindParamByName(stmt,'AttrName'     , AttrNam.NRec);
          sqlBindParamByName(stmt,'wTable'       , coCatalogs);
          sqlBindParamByName(stmt,'NeedDate'     , dateSts);

          ExecuteErrorCode := SqlExecute(stmt);
          if (ExecuteErrorCode = 0)
            {
              ExecuteErrorCode := SqlFetchIntoByName(stmt, tableHandle);
              ReReadRecord(tableHandle);

              if (ExecuteErrorCode <> 0)
                {
                  Message('Ошибка : ' + string(ExecuteErrorCode));
                  exit;
                }
            }
          else
            {
              Message('Ошибка : ' + string(ExecuteErrorCode));
              exit;
            }
        }
      else
        {
          Message('Ошибка : ' + string(ExecuteErrorCode));
          Exit;
        }
      result := TRUE;
    }
  _finally
    {
    }
}

//*****************************************************************************
Procedure ClearMyMarker(sMarker : string);
{
   if (Trim(sMarker) = '')
    Exit;

  var hMarker : longint; hMarker := InitMarker(sMarker, 8, 200, 10);
  ClearMarker(hMarker);
  DoneMarker(hMarker, sMarker);
}
//*****************************************************************************
Function GetFilterText (sMarker : string; wTable : word) : string;
{
  if (Trim(sMarker) = '')
    {
      result := '';
      Exit;
    }

  var hMarker : longint; hMarker := InitMarker(sMarker, 8, 200, 10);
  if (GetMarkerCount(hMarker) = 0)
    result := 'не установлен';
  else
    if (GetMarkerCount(hMarker) = 1)
      {
        if(wTable = coCatalogs)
          {
            GetMarker(hMarker, 0, cFltPodr);
            set cFltPodr := cFltPodr;
            result := FltCatalog.Name;
          }
        else
          {
            GetMarker(hMarker, 0, cFltCateg);
            set cFltCateg := cFltCateg;
            result := FltKlKatego.NaiKat;
          }

        set wFilters := wFilters or if(wTable = coCatalogs, word(1), word(2));
      }
    else
      {
        result := 'множественный фильтр (' + string(GetMarkerCount(hMarker)) + ')';
        set wFilters := wFilters or if(wTable = coCatalogs, word(1), word(2));
      }
  DoneMarker(hMarker, sMarker);
}
//*****************************************************************************

Procedure PickPremia(sourceMarker, destMarker : string; var sNameRaise : string; var sTypeRaise : string);
{
  var nRecRasesStS : comp; nRecRasesStS := 0;
  var sourceMarkerHandle : longint; sourceMarkerHandle := InitMarker(sourceMarker, 8, 200, 10);
  var destMarkerHandle   : longint; destMarkerHandle   := InitMarker(destMarker  , 8, 200, 10);
  ClearMarker(sourceMarkerHandle);
  CopyMarker(sourceMarkerHandle, destMarkerHandle);
  DoneMarker(sourceMarkerHandle, sourceMarker);

  RunInterface(PickCatalog2, iEntryPoint, nRecRasesStS, cParMode);

  sourceMarkerHandle := InitMarker(sourceMarker, 8, 200, 10);
  CopyMarker(destMarkerHandle, sourceMarkerHandle);

  DoneMarker(sourceMarkerHandle, sourceMarker);

  if(GetMarkerCount(destMarkerHandle) > 1)
  {
    if (Length(nameRaise1) = 0)
      Set sNameRaise := 'По нескольким доплатам';
    Set sTypeRaise := 'По нескольким доплатам';
  }
  else
  {
    GetMarker(destMarkerHandle, 0, nRecRasesStS) ;
    if (Length(nameRaise1) = 0)
      Set sNameRaise := iCatFunc.GetCatalogsName(nRecRasesStS);
    Set sTypeRaise := iCatFunc.GetCatalogsName(nRecRasesStS);
  }
  DoneMarker(destMarkerHandle, destMarker);
}

//*****************************************************************************

HandleEvent

cmInit: 
  {
    if (GetFirst AttrNam <> tsOk)
      {
        Message('Отсутствует атрибут ''Вид производства'' для таблицы ''Каталоги''!');
        Abort;
        Exit;
      }

    DeptMarkerName  := 'CatalogsMarkerT3';
    KategMarkerName := 'Kategory_Marker';

    if (NOT ReadMyDsk(sFeeSigners, 'T3_2004_sFeeSigners', True))
      set sFeeSigners := '';

    if (NOT ReadMyDsk(cPersDop, 'T3_2004_cPersDop', True))
      set cPersDop := comp(0);

    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);

    if (sFeeSigners <> '')
      iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sFeeSigners);
/*
    set DeptFilter    := GetFilterText(DeptMarkerName, coCatalogs);
    set KategFilter   := GetFilterText(KategMarkerName, coKlKatego);

    if (ReadMyDsk(nameRaise1, 'EM_StaffStSnameRaise1' , false)) {}
    if (ReadMyDsk(nameRaise2, 'EM_StaffStSnameRaise2' , false)) {}
    if (ReadMyDsk(nameRaise3, 'EM_StaffStSnameRaise3' , false)) {}
    if (ReadMyDsk(typeRaise1, 'EM_StaffStStypeRaise1' , false)) {}
    if (ReadMyDsk(typeRaise2, 'EM_StaffStStypeRaise2' , false)) {}
    if (ReadMyDsk(typeRaise3, 'EM_StaffStStypeRaise3' , false)) {}

    if (not ReadMyDsk(dateSts, 'EM_StaffStSdateSts'   , false)) or (dateSts = ZeroDate)
      dateSts:= Cur_Date;
    if (ReadMyDsk(sNumPrikaz , 'EM_StaffStSnumPrikaz' , false)) {}
    if (ReadMyDsk(dPrikaz    , 'EM_StaffStSdatePrikaz', false)) {}
    if (ReadMyDsk(wType      , 'EM_StaffStSwType'     , false)) {}
  }

cmOk:
  {
*/
    delete all tmpSelectedPodr;
    delete all tmpDocs;
    delete all tmpSigners;
    delete all tmpIerPodr;

    if ( dateSts = ZeroDate)
      {
        Message('Не указана дата штатного расписания. Формирование отчета не возможно.');
        abort;
        exit;
      }
     if (NOT FullTables(SqltmpDocs   , #tmpDocs))
        Exit;


     if (GetFirst tmpDocs <> tsOk)
       {
         Message('Отсутствуют данные!');
         Exit;
       }

     if (NOT FullTables(SqltmpIerPodr, #tmpIerPodr))
       Exit;

     ProcessData;
     if(Message('Группировать строки по одинаковым должностям?', YesNo) = cmYes) then
     {
       _needGroup := true;
     }
     PrintRepost;
     Abort;
  }
/*
cmCancel:
  {
    PutCommand(cmDone);
  }

cmCheckField:
  {
    case CurField of
      #wFilters :
      {
       // Если был установлен фильтр по подразделениям
        if ( ( word(OldFieldValue) and word(1) ) = 0 )
          if ( ( wFilters and Word(1) ) <> 0 )
          {
            SelectField(#DeptFilter);
            PutCommand(cmPick);
          }

        // если установлен фильтр по категориям
        if ( ( word(OldFieldValue) and word(2) ) = 0 )
          if ( ( wFilters and 2 ) > 0 )
          {
            SelectField(#KategFilter);
            PutCommand(cmPick);
          }

        // если снят фильтр по подразделениям
        if ( ( word(OldFieldValue) and word(1) ) <> 0 )
          if ( ( wFilters and Word(1) ) = 0 )
          {
            ClearMyMarker(DeptMarkerName);
            set DeptFilter := 'не установлен';
          }

        // если снят фильтр по категориям
        if ( ( word(OldFieldValue) and word(2) ) <> 0 )
          if ( ( wFilters and 2 ) = 0 )
          {
            ClearMyMarker(KategMarkerName);
            set KategFilter :=  'не установлен';
          }
      }
    end;
  }

cmPick:
  {
    iEntryPoint     := -17;         // Вход в каталог надбавок
    cParMode        := 100;         // С мн

    case CurField of
      #sFeeSigners:
      {
        iFeeSigners.RunWindowFeeSigners(1);
        set sFeeSigners := iFeeSigners.GetFeeSignersName;
      }
      #PersonsDop.FIO:
        if (iGetKau.GetCodeKau(cgiPick, cgKau_KatPersons, cPersDop) <> 0)
          set cPersDop := cPersDop;
      #typeRaise1:
        {
          PickPremia('CatalogsMarker', 'EM_CatalogsMarker1', nameRaise1, typeRaise1);
          Set nameRaise1 := nameRaise1;
          Set typeRaise1 := typeRaise1;
        }
      #typeRaise2:
        {
          PickPremia('CatalogsMarker', 'EM_CatalogsMarker2', nameRaise2, typeRaise2);
          Set nameRaise2 := nameRaise2;
          Set typeRaise2 := typeRaise2;
        }
      #typeRaise3:
        {
          PickPremia('CatalogsMarker', 'EM_CatalogsMarker3', nameRaise3, typeRaise3);
          Set nameRaise3 := nameRaise3;
          Set typeRaise3 := typeRaise3;
        }
      #DeptFilter :
        {
          var tmpComp : Comp ;  tmpComp := cFltPodr;
          var bMarkerUpdated : Boolean ;
          var bDateChanged : Boolean ;

          if (not ReadMyDsk(bMarkerUpdated, 'PickCatalogs2_bMarkerUpdated', bDateChanged))
            bMarkerUpdated := True
          else
            {
              // обнуляем значение
              bDateChanged := False ;
              SaveMyDsk(bMarkerUpdated, 'PickCatalogs2_bMarkerUpdated') ;
            }

          var destMarker : longint; destMarker := InitMarker(DeptMarkerName  , 8, 200, 10);
          var srcMarker  : longint; srcMarker  := InitMarker('CatalogsMarker', 8, 200, 10);
          CopyMarker(srcMarker, destMarker);
          DoneMarker(srcMarker, 'CatalogsMarker');
          RunInterface(PickCatalog2, Integer(-11), tmpComp, Comp(100)) ;
          srcMarker  := InitMarker('CatalogsMarker', 8, 200, 10);
          CopyMarker(destMarker, srcMarker) ;
          DoneMarker(srcMarker, 'CatalogsMarker');
          DoneMarker(destMarker, DeptMarkerName);
          set DeptFilter    := GetFilterText(DeptMarkerName, coCatalogs);
        }
      #KategFilter:
        {
          var tmpComp : Comp ;  tmpComp := cFltCateg;
          var destMarker : longint; destMarker := InitMarker(KategMarkerName  , 8, 200, 10);
          if (RunInterface('PickKat1', word(0), destMarker, vfMultipleSelection) <> cmDefault)
            {}
          DoneMarker(destMarker, KategMarkerName);
          set KategFilter   := GetFilterText(KategMarkerName, coKlKatego);

        }
    end;
  }

cmDelOnProtect:
  {
    case CurField of
      #sFeeSigners :
      {
        Set sFeeSigners := '';
        SaveMyDsk(sFeeSigners, 'EM_T3_2004_sFeeSigners');
      }
      #PersonsDop.FIO:
        set cPersDop := comp(0);
      #typeRaise1:
        {
          ClearMyMarker('EM_CatalogsMarker1');
          Set nameRaise1 := '';
          Set typeRaise1 := '';
        }
      #typeRaise2:
        {
          ClearMyMarker('EM_CatalogsMarker2');
          Set nameRaise2 := '';
          Set typeRaise2 := '';
        }
      #typeRaise3:
        {
          ClearMyMarker('EM_CatalogsMarker3');
          Set nameRaise3 := '';
          Set typeRaise3 := '';
        }
      #DeptFilter :
        {
          ClearMyMarker(DeptMarkerName);
          Set DeptFilter := 0;
        }
      #KategFilter:
        {
          ClearMyMarker(KategMarkerName);
          Set KategFilter := 0;
        }


    end;
  }


cmDefault:
  {
  }
