Create view
var
  ID
, DeptFilter
, KategFilter
, sNumDoc
, sNumPrikaz
, sFeeSigners
, sXLSFileName
, SXLTFileName       : string;
  _needGroup         : boolean;
  nameRaise1         : string;
  nameRaise2         : string;
  nameRaise3         : string;
  typeRaise1         : string;
  typeRaise2         : string;
  typeRaise3         : string;

  DeptMarkerName     : string;
  KategMarkerName    : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;

  dKolPers           : double;

  wFilters           : Word;
  wType              : word;

  cPersDop           : comp;

  dDateDoc
, dStaffStr
, dPrikaz
, dateSts            : date;

  cParMode           : comp;
  cFltPodr
, cParentItem
, cFltCateg          : comp;

  iEntryPoint        : integer;
  sLastPodrPrint     : string;
as select
  *
from 
  tmpSelectedPodr
, Persons PersonsDop
, Catalogs CatalogsDop
, tmpDocs
, tmpDocs tmpDocs2
, tmpSigners
, RaiseStS
, RaiseAlg
, Catalogs FltCatalog
, KlKatego FltKlKatego
, SelPicks
, KatOrg
, MnSpAdd
, HistoryStr
, tmpIerPodr
, ManualNotesStaffStr
, tmpIerPodr tmpIerPodr2
, Persons
, Appointments
, Appointments AppointmentsDop
, Vacations
, KlOtpusk
, tmpDocs tmpDocsPrn
, AttrNam
, KlSovm
, tmpRepGroup
, tmpDocs tmpDocsPrn2
//, AttrNam anProf
//, AttrVal avProf
//, Catalogs catCode
, StaffStruct ss1
, Tarstav ts1
, tmpPremSHR
, Raise
, Raisehist
where
((
    cPersDop              == PersonsDop.NRec
AND PersonsDop.AppointCur == AppointmentsDop.NRec
AND AppointmentsDop.Post  == CatalogsDop.NRec
AND tmpDocs.cStaffStruct  == RaiseStS.StaffStr
AND RaiseSts.Nrec         == RaiseAlg.RaiseStSt
AND cFltPodr              == FltCatalog.NRec
AND cFltCateg             == FltKlKatego.NRec
AND cParentItem           == tmpDocs2.ParentPodrRec
AND coStaffStruct         == ManualNotesStaffStr.wTbl
AND tmpDocs.cStaffStruct  == ManualNotesStaffStr.cRec
AND Appointments.Person   == Persons.NRec
AND Vacations.VacType     == KlOtpusk.Nrec
AND word(Persons.cSovm)   == KlSovm.Sovm   

AND coCatalogs            == AttrNam.wTable
AND 'Вид производства'    == AttrNam.Name

AND tmpDocs.cStaffStruct  == Appointments.StaffStr
  AND (dateSts  >= Appointments.AppointDate
   AND (dateSts <= Appointments.DismissDate
     OR Day(Appointments.DismissDate) = 0)
   AND (dateSts <= Appointments.Dateend
     OR Day(Appointments.Dateend) = 0)
   AND  2 <> Appointments.wAddWord1
   AND  (  0 = Appointments.lPrizn
      OR   3 = Appointments.lPrizn
      OR  70 = Appointments.lPrizn
      OR   2 = Appointments.lPrizn
      OR 100 = Appointments.lPrizn
        )
      )
AND tmpDocsPrn.cStaffStruct == ss1.nrec
AND ss1.Tariff == ts1.nrec


/*
AND tmpDocsPrn.cStaffStruct == app1.StaffStr
AND (dateSts  >= app1.AppointDate
   AND (dateSts <= app1.DismissDate
     OR Day(app1.DismissDate) = 0)
   AND (dateSts <= app1.Dateend
     OR Day(app1.Dateend) = 0)
   AND  2 <> app1.wAddWord1
   AND  (  0 = app1.lPrizn
      OR   3 = app1.lPrizn
      OR  70 = app1.lPrizn
      OR   2 = app1.lPrizn
      OR 100 = app1.lPrizn
        )
      )
AND app1.person == pers1.nrec
AND pers1.APPOINTCUR == raise1.APPOINT
AND pers1.NREC == raise1.PERSON
AND 000A00000003DA57h == raise1.RAISETYPE
AND tmpDocsPrn.STabNmb == pers1.strtabn (noindex)  */
))
;

