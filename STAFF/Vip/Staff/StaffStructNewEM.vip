table struct tmpDocs
(
  NRec           : comp
, cStaffStruct   : comp
, nRecKPS        : comp
, PodrName       : string[200]
, PodrCode       : string[100]
, PodrRec        : comp
, bMulti         : word
, ParentPodrName : string[200]
, ParentPodrCode : string[100]
, ParentPodrRec  : comp
, PostNRec       : comp
, PostName       : string[200]
, PostCode       : string[100]
, Discharge      : word
, VidPr          : string[200]
, CategoryW      : string[100]
, SubCategory    : string[100]
, LevelPayment   : string[100]
, TypePayment    : string[100]
, CountSEd       : double
, RatePayment    : string[100]
, DoplataUslT    : double
, DoplataOther   : double
, sNote          : string[200]
, isn            : double
, SECRET           : double
, EPREM           : double
, FIO            : string[200]
, Category       : string[200]
, isWorker       : word
, Tarif          : double
, TarifMax       : double
, ClassCondJob   : string[100]
, wOrder         : word
, dOklad         : double
, SortPodrCode   : string[100]
, isPrint        : word
, CategID        : comp
, cParent        : comp
, WorkStations   : double
, TaxRate        : double
, CatCode        : string[100]
, STabNmb        : string[20]
)
with index
(
  tmpDocs01 = NRec  (unique, surrogate)
, tmpDocs02 = ParentPodrRec
, tmpDocs03 = isPrint
, tmpDocs04 = PodrRec + wOrder + bMulti(desc) + Tarif(desc) + TarifMax(desc)
, tmpDocs05 = PodrRec + PostNRec + Discharge + LevelPayment + RatePayment + Tarif + TarifMax + ClassCondJob + DoplataUslT + isPrint
, tmpDocs06 = PodrCode
, ind7 =  PodrCode +   PostName + Tarif + TarifMax + TaxRate + Discharge +   Category +   LevelPayment +   TypePayment +   ClassCondJob



);

