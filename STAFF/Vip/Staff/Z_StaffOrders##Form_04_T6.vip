#component "Z_StaffOrders"

alter interface Form_04_T6
  ( '')
;

  overload
    procedure PrintNFormT6;
  end;

  var sFile: string;
  var sFileName: string;
  var sFileVBS: string;
  var sFileTmp: string;
  File RtfToDBF;

  procedure PrintNFormT6;
  {
    Inherited::PrintNFormT6;

    if wGetTune('UP.FAKELGAL.FAKEL') = 1
    {
    
      if(message('Сохраненить PDF-файл приказа в папке'+chr(13)+
        sGetTune('Fakel.Prik.SaveFile')+'?',YesNo)=cmYes)
      {
      var aErrorCode : integer;
      sFile    :=TranslatePath ( GetStringParameter ( 'Files','OutputFilesDirectory', 0 ));
      sFileName:=TitleDoc.DocNmb+'_'+iStrFunc.UnVisibleDate(TitleDoc.DocDate, 'DD-MM-YYYY');//+'_'+iPsnFuncs.Get_LastName(Persons.NRec);
      sFileTmp :='C:\Temp\'; 
    
      if fileexist(sFile+sFileName+'.rtf')
        DeleteFile(sFile+sFileName+'.rtf');
    
      CopyMoveFile(sFile+'form_t6.rtf',sFileTmp+sFileName+'.rtf',false,ecmfClientFrom+ecmfClientTo);
    
      sFileVBS := sFileTmp+sFileName+'.vbs';
    
      if fileexist(sFileVBS)
        DeleteFile(sFileVBS);
    
      RtfToDBF.openfile(sFileVBS,stCreate);
    
      RtfToDBF.WriteLn('bRecursive = False');
      RtfToDBF.WriteLn('sFolder = "'+sFileTmp+'"');
      RtfToDBF.WriteLn('Set oFSO = CreateObject("Scripting.FileSystemObject")');
      RtfToDBF.WriteLn('Set oWord = CreateObject("Word.Application")');
      RtfToDBF.WriteLn('oWord.Visible = True');
    
      RtfToDBF.WriteLn('Set oFolder = oFSO.GetFolder(sFolder)');
      RtfToDBF.WriteLn('ConvertFolder(oFolder)');
      RtfToDBF.WriteLn('oWord.Quit');
    
      RtfToDBF.WriteLn('Sub ConvertFolder(oFldr)');
      RtfToDBF.WriteLn('  For Each oFile In oFldr.Files');
    
      var _s : string = '';
      ConvertOemToUtf8(sFileName,_s);
//      RtfToDBF.WriteLn('    If LCase(oFSO.GetFileName(oFile.Name)) = "'+_s+'.rtf" Then');
//      RtfToDBF.WriteLn('    If LCase(oFSO.GetFileName(oFile.Name)) = "'+DocBasFn866to1251(sFileName)+'.rtf" Then');
//Oem2Ansi(
      RtfToDBF.WriteLn('    If LCase(oFSO.GetFileName(oFile.Name)) = "'+sFileName+'.rtf" Then');
      RtfToDBF.WriteLn('        Set oDoc = oWord.Documents.Open(oFile.path)');
      RtfToDBF.WriteLn('        Str = left(oFile,instr(1,oFile,".")-1)'); 
      RtfToDBF.WriteLn('        oWord.ActiveDocument.SaveAs Str & ".pdf", 17');
      RtfToDBF.WriteLn('        oDoc.Close');
      RtfToDBF.WriteLn('    End If');
      RtfToDBF.WriteLn('Next');
    
      RtfToDBF.WriteLn('If bRecursive Then');
      RtfToDBF.WriteLn('    For Each oSubfolder In oFldr.Subfolders');
      RtfToDBF.WriteLn('        ConvertFolder oSubfolder');
      RtfToDBF.WriteLn('    Next');
      RtfToDBF.WriteLn('End If');
      RtfToDBF.WriteLn('End Sub');
    
      RtfToDBF.Close();
    
      if fileexist(sFileTmp+sFileName+'.pdf')
        DeleteFile(sFileTmp+sFileName+'.pdf');

      ExecProgram('Start /Wait',sFileVBS,'Ожидайте..',0, aErrorCode);
      if aErrorCode <> 0
        Message('Были ошибки при конвертации'+aErrorCode);
    
      if fileexist(sGetTune('Fakel.Prik.SaveFile')+sFileName+'.pdf')
      {
        if(message('PDF-файл уже существует.'+chr(13)+
          'Заменить?',YesNo)=cmYes)
        {
          DeleteFile(sGetTune('Fakel.Prik.SaveFile')+sFileName+'.pdf');
          CopyMoveFile(sFileTmp+sFileName+'.pdf',sGetTune('Fakel.Prik.SaveFile')+sFileName+'.pdf',false,ecmfClientFrom+ecmfClientTo);
        }
      }
      else
        CopyMoveFile(sFileTmp+sFileName+'.pdf',sGetTune('Fakel.Prik.SaveFile')+sFileName+'.pdf',false,ecmfClientFrom+ecmfClientTo);

      if fileexist(sFileVBS)
        DeleteFile(sFileVBS);
      if fileexist(sFileTmp+sFileName+'.rtf')
        DeleteFile(sFileTmp+sFileName+'.rtf');
      if fileexist(sFileTmp+sFileName+'.pdf')
        DeleteFile(sFileTmp+sFileName+'.pdf');
    
////    ExecProgram('Start /Wait',sGetTune('Fakel.Prik.SaveFile')+sFileName+'.pdf',0, aErrorCode);
      }

    }//if wGetTune('UP.Fakel.OTPUSKPOLE') = 1

  }

end.