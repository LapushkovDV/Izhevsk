#component "Z_Zar"

#include AttrTablePick.vih
#include ExtAttr.Vih
#include TotalOrganizationAttributes.vih  // работа с атрибутами организации

alter interface PickKat1
 ( '')
var  refAttrTablePick : AttrTablePick;
var iExAttr : iExtAttr;

Create view WorkingCategory
As Select
 refAttrTablePick.sGetValue(coKlKatego, iExAttr.AttrID(coKlKatego, 'Укрупненная категория'), ForSorting.nRec)
  (FieldName = IndKateg)
;

HandleEvent
cmInit:
{
//==============================
var ww_field:longint;
var ww_fieldname:string;
var lErr:longint;
//==============================
  inherited :: HandleEvent (cmInit);

  if wGetTune('UP.FakelGAL.Fakel') = 1
  {
  ww_fieldname := 'IndKateg';
  lErr:=cfsCreateObject ('TreeColumn','TRKLKATEG',ww_fieldname,FALSE,ww_field); 

  cfsSetProp(ww_fieldname, 'Original', False);
  cfsSetProp(ww_fieldname, 'Visible', True);
  cfsSetProp(ww_fieldname, 'Hidden', False);
  cfsSetProp(ww_fieldname, 'Protect', True);
  cfsSetProp(ww_fieldname, 'Skip', False);
  cfsSetProp(ww_fieldname, 'UpCase', False);
  cfsSetProp(ww_fieldname, 'Password', False);
  cfsSetProp(ww_fieldname, 'NoValidCheck', True);
  cfsSetProp(ww_fieldname, 'StatusCtx', scInterfac1);//scIfaceSelect
  cfsSetProp(ww_fieldname, 'PickButton', True);
  cfsSetProp(ww_fieldname, 'CalcButton', False);
  cfsSetProp(ww_fieldname, 'Calendar', False);
  cfsSetProp(ww_fieldname, 'Title', 'Относится к категории');
  cfsSetProp(ww_fieldname, 'FieldName', ww_fieldname);
  cfsSetProp(ww_fieldname, 'Index', integer(4));
  cfsSetProp(ww_fieldname, 'DefaultWidth', integer(6));
  cfsSetProp(ww_fieldname, 'SpinButton', False);
  cfsSetProp(ww_fieldname, 'NoAutoSize', False);
  cfsSetProp(ww_fieldname, 'MaxLen', integer(255));
  cfsSetProp(ww_fieldname, 'DropTarget', False);
  cfsSetProp(ww_fieldname, 'DropSource', False);
  }

}
//cmAccording: // перестройка визуализации дерева по Alt+S
//{
//  inherited :: HandleEvent (cmAccording)
//}
cmPick:
{
  if Curfield = #IndKateg
  {

    refAttrTablePick.PickValue(coKlKatego, iExAttr.AttrID(coKlKatego, 'Укрупненная категория'), ForSorting.nRec);//30962247438173915
    RereadRecord(#ForSorting);
  }
}

//cmEdit:
//{
//  inherited :: HandleEvent (cmEdit)
//}

cmDelete:
{

  if Curfield = #IndKateg
  {
    iExAttr.coSetAttr(coKlKatego, ForSorting.nRec, 'Укрупненная категория', 0, '');
    RereadRecord(#ForSorting);
  }

}

end;
end.
