\*************************************************************************************************/

#IFNDEF __GP_FORMT12_VIH__
#DEFINE __GP_FORMT12_VIH__

#component "GP_Staff"

objInterface GP_ObjFormT12;

  // Инициализирует расчет
  // Параметры:
  //  _pDBeg - дата начала отчетного периода
  //  _pDEnd - дата окончания отчетного периода
  //  _pSettings - доп.параметры (1 - показывать подробный лог)
  // Возвращает true, если операция завершилась успешно
  function Init(_pDBeg: Date; _pDEnd: Date; _pSettings: Word): Boolean;

  // Деинициализирует расчет
  procedure Done;

  // Анализирует данные по одному лицевому счету, формирует одну или несколько строк формы
  // и записывает результат в таблицу TmpFormT12
  // Для вызова этой функции требуется вызов Init и Done
  // Параметры:
  //  _cLSchet - ссылка на лицевой счет
  // Возвращает true, если операция завершилась успешно
  function GenerateFormData(_cLSchet: Comp): Boolean;

  // Очищает таблицу TmpFormT12
  // Для вызова этой функции не требуется вызов Init и Done
  procedure Clear;

  // Создаёт копию табеля по лицевому счету с указанным NRec за указанный месяц (если она еще не создана)
  // Если уже есть копия с указанной датой формирования, она перезаписывается
  // Для вызова этой функции не требуется вызов Init и Done
  // Параметры:
  //  _DForm        - дата формирования копиии
  //  _cLSchet      - ссылка на лицевой счет
  //  _Month        - месяц
  //  _Year         - год
  //  _ReplIfExists - если true, то в случае, если копия с такой датой создания уже есть, она презаписывается
  //                  если false, то в случае, если уже есть хоть одна копия, ничего не делается
  //  _ShowInfo     - если true, то после создания копии выводится сообщение, что был создан корректировочный табель
  // Возвращает true, если операция завершилась успешно
  function CreateCopy(_DForm: Date; _cLSchet: tNRec; _Month: Byte; _Year: Word; _ReplIfExists: Boolean; _ShowInfo: Boolean): Boolean;

  // Копирует указанную запись из таблицы GP_TimeTable в таблицу TmpFormT12
  // Для вызова этой функции не требуется вызов Init и Done
  // Параметры:
  //  _cGP_TimeTable - ссылка на сохранённый табель (запись в таблице GP_TimeTable)
  // Возвращает true, если операция завершилась успешно
  function LoadCopy(_cGP_TimeTable: tNRec): Boolean;

  // Копирует все копии табеля по лицевому счету с указанным NRec за указанный месяц из таблицы GP_TimeTable в таблицу TmpFormT12
  // Для вызова этой функции не требуется вызов Init и Done
  // Параметры:
  //  _cLSchet - ссылка на лицевой счет
  //  _Month   - месяц
  //  _Year    - год
  // Возвращает true, если операция завершилась успешно
  // function LoadCopies(_cLSchet: tNRec; _Month: Byte; _Year: Word): Boolean;

  // Удаляет все копии табеля по лицевому счету с указанным NRec за указанный месяц
  // Для вызова этой функции не требуется вызов Init и Done
  // Параметры:
  //  _cLSchet - ссылка на лицевой счет
  //  _Month   - месяц
  //  _Year    - год
  // Возвращает true, если операция завершилась успешно
  // function DeleteCopies(_cLSchet: tNRec; _Month: Byte; _Year: Word): Boolean;

  // Копирует табели за указанный период, если дата начала периода меньше даты начала отчетного периода модуля Зарплата
  // Для вызова этой функции не требуется вызов Init и Done
  // Параметры:
  //  _DForm        - дата формирования копиии
  //  _cLSchet      - ссылка на лицевой счет
  //  _FromDate     - дата с
  //  _ToDate       - дата по
  //  _ReplIfExists - если true, то существующие копиии перезаписываются
  //                  если false, то если копии уже есть, ничего не делается
  //  _ShowInfo     - если true, то после создания копии выводится сообщение, что был создан корректировочный табель
  // Возвращает true, если операция завершилась успешно
  procedure CopyLSTabs(_DForm: Date; _cLSchet: tNRec; _FromDate: Date; _ToDate: Date; _ReplIfExists: Boolean; _ShowInfo: Boolean);

end;

vipInterface GP_FormT12 Implements GP_ObjFormT12;
#endif
