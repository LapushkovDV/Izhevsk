/*************************************************************************************************\
* Наименование: Работа с доплатами и рабочей корзиной                                             *
* Контур/Модуль: Кадры                                                                            *
* Примечание: При формировании записи в корзине об удалении надбавки должен устанавливаться       *
*             номер и дата приказа, который был удален                                            *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1171         |28/03/18|Евдокимов М.А.           |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_Staff"

alter interface SetRR;

overload
  procedure ISetRR.DelRaiseMsg(cRaise: comp; cPers: comp; cApp: comp);
end;

//Сообщения в корзину об удалении доплат
procedure ISetRR.DelRaiseMsg(cRaise: comp; cPers: comp; cApp: comp);
{

  //Запоминаем номер приказа, по которому сформирована надбавка
  if GetFirst FastFirstRow Raise where (( cRaise == Raise.NRec )) = tsOk
  {
    var titleDocDocNmb: string = '';
    var titleDocDocDate: date = 0;

    if GetFirst FastFirstRow ContDoc where (( Raise.cRDop == ContDoc.Nrec )) = tsOk
      if GetFirst FastFirstRow PartDoc where (( ContDoc.cPart == PartDoc.Nrec )) = tsOk
        if PartDoc.TypeOper = 9 and (GetFirst FastFirstRow TitleDoc where (( PartDoc.cDoc == TitleDoc.Nrec )) = tsOk)
        {
          titleDocDocNmb  := TitleDoc.DocNmb;
          titleDocDocDate := TitleDoc.DocDate;
        }

    //Вызываем стандартный обработчик удаления надбавки, который формирует ZarSignal и удаляет Raise
    inherited::DelRaiseMsg(cRaise, cPers, cApp);

    //В ZarSignal пишем номер и дату приказа из надбавки
    if isValid(#ZarSignal)
    {
      ZarSignal.String2 := titleDocDocNmb;
      ZarSignal.Date10 := titleDocDocDate;
      update current ZarSignal;
    }
  }

}

end.
