/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*                "Штатное расписание ЭМ"                                                          *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Отчеты->Отчеты по штатному расписанию->Штатное расписание->Штатное расписание ЭМ *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#199          |28/04/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_StaffReports"

#include FeeSigners.Vih
#include GetKau.vih     // Обьектный интерфес выбора КАУ

alter interface T3_2004

#include FeeSigners.Var
#include GetKau.var    // Обьектный интерфес выбора КАУ


ExtendFormats StaffStructReports;


create view
var 
  sFeeSigners    : string;
  cPersDop       : comp;
  wType          : word;
as select
  *
from
  Persons PersonsDop
where 
((
   cPersDop == PersonsDop.NRec
))
;

screen StaffStructReports;
  Fields
   wType          ('Тип отчета ') :[list 0 '"Штатное расписание" ЭМ'
                                       , 1 '"Штатная расстановка" ЭМ'
                                       , 2 'Отчеты "Галактика"'], protect;
   sFeeSigners ('Группа подписантов (F3 - выбор)',,sci13Esc) : Protect;
   PersonsDop.FIO ('Группа подписантов (F3 - выбор)',,sci13Esc) : Protect;
<<
 `Тип отчета`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
















 `Подписанты:`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@    
              .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;


HandleEvent

cmInit: 
  {
    if (ReadMyDsk(wType      , 'EM_StaffStSwType'     , false)) {}

    if (NOT ReadMyDsk(sFeeSigners, 'T3_2004_sFeeSigners', True))
      set sFeeSigners := '';

    if (NOT ReadMyDsk(cPersDop   , 'T3_2004_cPersDop'   , True))
      set cPersDop := comp(0);

    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);

    if (sFeeSigners <> '')
      iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sFeeSigners);

    inherited :: handleEvent (cmInit);
  }

cmOk:
  {
    SaveMyDsk(sFeeSigners, 'T3_2004_sFeeSigners');
    SaveMyDsk(cPersDop   , 'T3_2004_cPersDop'   );
    SaveMyDsk(wType      , 'EM_StaffStSwType'   );

    if (wType = 2)
      {
        inherited :: handleEvent (cmOk); 
      }
    else
      RunInterface(EMStaffStructReport, wType, dateSts, numPrikaz, datePrikaz, wFilters);
  }

cmPick:
  {
    case CurField of
      #sFeeSigners:
      {
        iFeeSigners.RunWindowFeeSigners(1);
        set sFeeSigners := iFeeSigners.GetFeeSignersName;
      }
      #PersonsDop.FIO:
        if (iGetKau.GetCodeKau(cgiPick, cgKau_KatPersons, cPersDop) <> 0)
          set cPersDop := cPersDop;
    end;

    inherited :: handleEvent (cmPick);
  }

cmDelOnProtect:
  {
    case CurField of
      #sFeeSigners :
      {
        Set sFeeSigners := '';
        SaveMyDsk(sFeeSigners, 'T3_2004_sFeeSigners');
      }
      #PersonsDop.FIO:
        set cPersDop := comp(0);
    end;

    inherited :: handleEvent (cmDelOnProtect);
  }

end;
end.