#component "Z_WT"

#include FeeSigners.Vih
#include GetKau.vih                     
#include CLSFuncs.vih // ф-ии пересканирования текущих л/с
Alter Interface PRINTT13;
show (4, 1, 72, 30);

// фильтр подразделений с учетом актуальности подразделений
#define AdvancedDepartmentFilterActual
// фильтр по лицевым счетам с анализом актуальности сотрудников относительно переданного периода
#define PersonalAccountFilterActual

overload
  procedure CreateSortingList;
end;

Table Struct tFlt
(
    wKau : word
  , cRec : comp
)
with index
(
    i01 = wKau
  , i02 = cRec
);
Table Struct tFltPers
(
    tabn : string
  , cRec : comp
)
with index
(
    i01 = tabn
  , i02 = cRec
);
#include FeeSigners.Var

ExtendFormats FormPar;
Create view
var 
  sFeeSigners    : string;
  wShowFirstPage : word;
  wOutHHDouble: word;
   _cMnP  : comp;
  _sMnP  : string;
   iGetKau : GetKau;
   _tekmes  : word;
   _tekyear  : word;
   _rej  : longint;
    _sDeskr  : string;
from
  ZarSignal
  ,mnplan
  ,tFlt
  ,tFltPers

;

procedure CreateSortingList;
var CLSF: CurLSFunctions;
    mPodrs: TPtr;
{
  inherited::CreateSortingList;
  if PafSource = 1
  {
    mPodrs := CLSF.LoadCurrentDepartmentList;
    external _loop SortingTable
    {
      if not FoundMarker(mPodrs, SortingTable.Detail)
        delete current SortingTable;
    }
    DoneMarker(mPodrs, '');
  }
}

Procedure DelPick(_w : word);
{
  Delete From tFlt where ((_w == tFlt.wKau));
  sql delete from em_unidoc_head where wtype=1213 and description=:(_sDeskr);
}

Procedure InsPick(_w : word; _c : comp);
{
  ClearBuffer(#tFlt);
    tFlt.wKau := _w;
    tFlt.cRec := _c;
  Insert Current tFlt;
}
Procedure InsPers;
{
   _loop tFlt
   {
       //message(tFlt.crec);

     sql
     select distinct nachisl.strtabn as tabn, nachisl.clsch as crec
     from nachisl
     where mes=:(VEDMONTH) and yeark=:(VEDYEAR)
     and TBLD[1]=7 and  CKAUD[1]=:(tFlt.crec)
     into tFltPers;
     RereadRecord(tntFltPers);

     sql
     select distinct sumvidop.strtabn as tabn, sumvidop.clsch as crec
     from sumvidop
     where mes=:(VEDMONTH) and yeark=:(VEDYEAR)
     and TBLD[1]=7 and  CKAUD[1]=:(tFlt.crec)
     into tFltPers;
       RereadRecord(tntFltPers);

   }
  // message(recordsintable(tntFltPers));


   sql delete from em_unidoc_head where wtype=1213 and description=:(_sDeskr);
   _loop tFltPers
   {
     sql insert into em_unidoc_head (wtype,addcomp[1],addstring[1],description)
     values (1213,:(tFltPers.cRec),:(tFltPers.tabn),:(_sDeskr));
    // wtype=1213, addcomp[1]=:(tFltPers.cRec),addstring[1]=:(tFltPers.tabn),description=:(_sDeskr);
   }

   delete all from tFltPers;
  //  message(recordsintable(tntFltPers));

}

screen FormPar;
show (,,,28);
table zar_user;
fields
    wShowFirstPage ('Применить фильтр по', , sci1Esc), NoProtect;
    sFeeSigners ('Группа подписантов (F3 - выбор)',,sci13Esc) : Protect;
    wOutHHDouble ('Выводить время в долях часа (для военкомата)', , sci1Esc), NoProtect;
    _smnP ('Производственный заказ',,) : Protect, PickButton;
<<














   [.] печать первой страницы``Подписанты:`.@@@@@@@@@@@@@@@@@@@












   [.] выводить в долях часа `  `Заказ:`.@@@@@@@@@@@@@@@@@@@@
>>
end;

function CheckBasket:boolean;
var lCount:longint;
{
  result:=false;

  StartNewVisual(vtRotateVisual, vfTimer, 'Проверка Рабочей корзины...', 0);

  lCount:=0;
  _loop ZarSignal
  where((
    CurrentPeriodBeginning <<= ZarSignal.LstDate(noindex) and
    CurrentPeriodEnding >>= ZarSignal.LstDate(noindex) and
    coLSCHET == FORMARKS.CHOICE and ZarSignal.cLschetZPL == FORMARKS.clschet(noindex)
  )) {
    if (not NextVisual) break;
    if ((ZarSignal.FilialNo and 1b)<>0) continue;//признак обработанности записи
    if (not IsValidAll(tnFORMARKS)) continue;

    lCount++;
    break;
  }

  StopVisual;

  if (lCount>0)
    if (message('По выбранным сотрудникам есть необработанные записи в Рабочей корзине.'#13+
                'Печатать отчет?',YesNo+Warning)<>cmYes) exit;

  result:=true;
}

HandleEvent
cmInit:
  {
    _sDeskr:=sGetTune('USER.OWNNAME');

    if (NOT ReadMyDsk(sFeeSigners, 'PRINTT13_sFeeSigners', True))
      set sFeeSigners := '';

    if (NOT ReadMyDSK(wShowFirstPage, 'PRINTT13_wShowFirstPage', FALSE))
      set wShowFirstPage := word(0);

    if (NOT ReadMyDSK(wOutHHDouble, 'PRINTT13_wOutHHDouble', FALSE))
      set wOutHHDouble := word(0);

    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);

    if (sFeeSigners <> '')
      iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sFeeSigners);

    //_tekmes:=month(dgettune('UP.TEKBUD'));
    //_tekyear:=year(dgettune('UP.TEKBUD'));
    //if  _tekmes=mon

    inherited :: handleEvent (cmInit);

    SetWindowTitle(wnMainWindow, 'Параметры печати');

    set PreferredAbsenceCoding := 1; //Условные обозначения - Пользовательские
    ClearFieldOption(#PreferredAbsenceCodingStr, ofSelectable); //Запрещаем модификацию поля Условные обозначения

    set TabEmpty := TabEmpty and not 2; //Снимаем флаг Включать входные неявки
    cfsSetCurrentContainer('PRINTT13');
    cfsSetProp('ci_FORMPAR_INCLUDEWEEKENDS_Включать_выходные_в_неявки', 'Skip', True); // Запрещаем модификацию флага Включать входные неявки
    cfsSetProp('ci_FORMPAR_TOTALHOURS_Учитывать_почасовые_отклонения', 'Skip', True); // Запрещаем модификацию флага Учитывать почасовые отклонения

    set TypeRep := 0; //Формат вывода - Текст
    ClearFieldOption(#TypeRep, ofSelectable); //Запрещаем модификацию поля Формат вывода
    ClearFieldOption(#NOTPREFERRED, ofSelectable); //Запрещаем модификацию поля Типовые виды неявок

    set PAFSource := 1;
    RescanPanel(#StaffStruct);
  }
cmOk:
  {
    SaveMyDsk(sFeeSigners   , 'PRINTT13_sFeeSigners'   );
    SaveMyDSK(wShowFirstPage, 'PRINTT13_wShowFirstPage');
    SaveMyDSK(wOutHHDouble  , 'PRINTT13_wOutHHDouble'  );
    if (not CheckBasket) exit;

    delete all from tFltPers;
    InsPers;

    inherited :: handleEvent (cmOk);

  }

cmPick:
  {
    var _i : longint;
    case CurField of
      #FiltrPublic:
      {
        if PafSource = 1
        {
          var CLSF: CurLSFunctions;
          CLSF.SetPeriodManual(CurrentPeriodBeginning, CurrentPeriodEnding);
          CLSF.ReScan;
        }
      }
      #sFeeSigners:
      {
        iFeeSigners.RunWindowFeeSigners(1);
        set sFeeSigners := iFeeSigners.GetFeeSignersName;
      }
     #_sMnP:
     {
      DelPick(cgKau_Zakaz);
      var _tmpMarkerName : string;
      var stMarker       : longint;

      if (iGetKau.GetCodeKau(cgiMulti, cgKau_Zakaz, _cMnP) <> 0) then
      {
        _tmpMarkerName := iGetKau.GetMarkerName(cgKau_Zakaz);
        stMarker       := InitMarker(_tmpMarkerName, 8, 10, 100, true);
        _i             := 0;
        while getmarker(stMarker, _i, _cMnP)
        {
         InsPick(cgKau_Zakaz, _cMnP);
          _i++;
        }
        DoneMarker(stMarker, _tmpMarkerName);
      }
      if (getFirst MnPlan where ((_cMnP == MnPlan.nRec)) = tsOk) then
      {
        set _sMnP := MnPlan.Number + if((_i-1) > 0, ' и еще ' + string(_i - 1), '');
      }
     }
    end;

    inherited :: handleEvent (cmPick);
  }

cmDelOnProtect:
  {
    case CurField of
      #sFeeSigners :
      {
        Set sFeeSigners := '';
        SaveMyDsk(sFeeSigners, 'PRINTT13_sFeeSigners');
      }
      #_sMnP:
     {
     DelPick(cgKau_Zakaz);
      set _sMnP := '';
      set _cMnP := 0h;
     }


    end;

    inherited :: handleEvent (cmDelOnProtect);
  }

end;
end.
