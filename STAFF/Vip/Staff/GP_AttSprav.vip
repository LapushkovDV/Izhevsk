/*************************************************************************************************\
* Наименование: Справка о выполнении рекомендаций комиссии по аттестации                          *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Отчеты / Отчеты пользователя / Аттестации / Справка о выполнении рекомендаций       *
*             комиссии по аттестации                                                              *
* Примечание:                                                                                     *
* Форма реализована на основании исходных текстов стандартного интерфейса AttSprav.               *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#162          |27/07/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#define GPInt GP_AttSprav // #(GPInt)
#define GPNam Справка о выполнении рекомендаций комиссии по аттестации // #(GPNam)

#include CatFunc.vih
#include History.vih

interface GP_AttSprav '#(GPNam)' (, hcStaff_JRegistrAttestacSotr) gray, escClose;
  show at (,, 66, 11);

  const
    // ST_SHOW_NOT_CLOSED = 1; // С учетом незакрытых аттестаций
    ST_SHOW_TOTALS = 1; // Печатать итоги по плановым и фактическим аттестациям
  end;

  table struct ReportT
  (
    NRec: tNRec,
    Counter: Word,
    counterTrue: Word
  )
  with index
  (
    ReportT01 = NRec
  );

  create view
    var
      BDate, EDate: Date; // Отчётный период
      cAttType: tNRec; // Тип аттестации
    from
      Regimechanges,
      ReportT,
      PlanAtt,
      synonym Catalogs AttTypeCat
    where
    ((
      /*
          0                   == RegimeChanges.FilialNo (noIndex)
      and BDate              <<= RegimeChanges.FromDate (noIndex)
      and EDate              >>= RegimeChanges.FromDate (noIndex)
      */
          0                   == RegimeChanges.FilialNo
      and BDate              <<= RegimeChanges.FromDate
      and EDate              >>= RegimeChanges.FromDate
      and RegimeChanges.NRec  == PlanAtt.cRecommend
      and PlanAtt.cRef3       == Attestation.NRec
      and cAttType            == AttTypeCat.NRec
    ))
  ;

  var
    fOption: Word;
    fRec: String;
    iCatFunc: CatalogsFunctions;
    RecMarker1: TPtr;

  #include History.var

  form Frm('#(GPInt).out', '#(GPInt)') with noVisual;

  function RecomFromMarker: String;
  var
    tmpComp: tNRec;
  begin
    case GetMarkerCount(RecMarker1) of
      0: RecomFromMarker := 'всем видам рекомендаций';
      1: begin
           GetMarker(RecMarker1, 0, tmpComp);
           RecomFromMarker := iCatFunc.GetCatalogsName(tmpComp);
         end;
    else
      RecomFromMarker := 'нескольким видам рекомендаций <' + String(GetMarkerCount(RecMarker1)) + '>';
    end; //case
  end;

  screen Params;
    fields
      BDate: noProtect;
      EDate: noProtect;
      fRec ('По каким рекомендациям давать развернутую информацию',, sci13Esc): protect, pickButton;
      AttTypeCat.Name ('Тип аттестации',, sci13Esc): protect, pickButton;
      fOption: noProtect;
    buttons
      cmOk;
      cmCancel;
  <<

`Период аттестации с`.@@@@@@@@@@`по`.@@@@@@@@@@

`Дать развернутую информацию по` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Тип аттестации`                 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

`Дополнительные параметры:`
! [.] С учетом незакрытых аттестаций `
  [.] Печатать итоги по плановым и фактическим аттестациям `

                   <.Сформировать.> <.Отмена.>
  >>
  end;

  // Проверяет соответствие установленному фильтру по типу аттестации
  function CheckAttType: Boolean;
  begin
    result := true;
    if cAttType = 0 then
      exit;
    if not IsValid(tnAttestation) then
      result := false
    else
      if cAttType != Attestation.cType then
        result := false;
  end;

  procedure CreateReport;
  var
    CounterOther: Word;
    CounterOtherTrue: Word;
    TotalSummaAct: Word;
    TotalSummaPlan: Word;
  begin
    CounterOther := 0;
    CounterOtherTrue := 0;
    TotalSummaAct := 0;
    TotalSummaPlan := 0;
    _loop RegimeChanges
    begin
      // if (fOption and ST_SHOW_NOT_CLOSED) = 0 and Day(RegimeChanges.todate) != 2 then
      //  continue;
      _loop PlanAtt
      begin
        if not CheckAttType then
          continue;
        if GetMarkerCount(RecMarker1) != 0 and (not FoundMarker(RecMarker1, PlanAtt.cKateg)) and PlanAtt.cKateg != 0 then
        begin
          Inc(CounterOther);
          if PlanAtt.wDone = 1 then
            Inc(CounterOtherTrue);
        end else
          if getFirst ReportT where ((PlanAtt.cKateg == ReportT.NRec)) = tsOk then
          begin
            Inc(ReportT.Counter);
            if PlanAtt.wDone = 1 then
              Inc(ReportT.countertrue);
            update current ReportT;
          end else
          begin
            ReportT.NRec := PlanAtt.cKateg;
            ReportT.Counter := 1;
            if PlanAtt.wDone = 1 then
              ReportT.countertrue := 1;
            insert current ReportT;
          end;
      end;
    end;
    _loop PlanAtt where ((
          0      == PlanAtt.wCod (NoIndex)
      and BDate <<= PlanAtt.dDop1 (NoIndex)
      and EDate >>= PlanAtt.dDop1 (NoIndex)
    ))
    begin
      if not CheckAttType then
        continue;
      Inc(TotalSummaPlan);
    end;
    Frm.Write(oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', BDate)); // предприятие
    Frm.Write(BDate); // дата1
    Frm.Write(EDate); // дата2
    if cAttType != 0 then
      Frm.Write(AttTypeCat.Name)  // тип_аттестации
    else
      Frm.SkipFormat(1);
    if getLast ReportT = tsOk then
      do begin
        Frm.PutEventByID(feDoLoop, fcRecCycle);
        Frm.write(if(ReportT.NRec = 0, 'без рекомендации', iCatFunc.GetCatalogsName(ReportT.NRec))); // рекомендация
        Frm.write(ReportT.Counter); // план
        Frm.write(ReportT.CounterTrue); // факт
        TotalSummaAct := TotalSummaAct + Counter;
      end while getPrev ReportT = tsok;
    if CounterOther != 0 then
    begin
      Frm.PutEventByID(fetrue, fcShowOther);
      Frm.Write('Другие рекомендации'); // др_рекомендация
      Frm.Write(CounterOther); // др_план
      Frm.Write(CounterOtherTrue); // др_факт
      TotalSummaAct := TotalSummaAct + CounterOther;
    end;
    if (fOption and ST_SHOW_TOTALS) != 0 then
    begin
      Frm.PutEventByID(feTrue, fcShowTotal);
      Frm.write(TotalSummaPlan); // итог_план
      Frm.write(TotalSummaAct); // итог_факт
    end;
    Frm.ShowFile('Справка');
    delete all ReportT;
  end;

  handleEvent
    cmInit:
      begin
        RecMarker1 := InitMarker('RecMarker', 8, 100, 10);
        set fRec := RecomFromMarker;
        if not ReadMyDSK(BDate, '#(GPInt)_BDate', false) then
          BDate := sub_months(cur_date, 12);
        if not ReadMyDSK(EDate, '#(GPInt)_EDate', false) then
          EDate := cur_date;
        if not ReadMyDSK(cAttType, '#(GPInt)_cAttType', false) then
          cAttType := 0;
        if not ReadMyDSK(fOption, '#(GPInt)_fOption', false) then
          fOption := 0;
      end;
    cmPick:
      case CurField of
        #fRec:
          begin
            var tmpComp: tNRec;
            RunInterface(PickCatalogEx, -125, tmpComp, 100, RecMarker1);
            set fRec := RecomFromMarker;
          end;
        #AttTypeCat.Name:
          begin
            var tmpComp: tNRec;
            if RunInterface(PickCatalog2, -126, tmpComp, 0) = cmDefault then
              set cAttType := tmpComp;
          end;
      end;
    cmDone:
      begin
        DoneMarker(Recmarker1, 'Recmarker');
        SaveMyDSK(BDate, '#(GPInt)_BDate');
        SaveMyDSK(EDate, '#(GPInt)_EDate');
        SaveMyDSK(cAttType, '#(GPInt)_cAttType');
        SaveMyDSK(fOption, '#(GPInt)_fOption');
      end;
    cmDelOnprotect:
      case curfield of
        #fRec:
          begin
            Clearmarker(Recmarker1);
            set fRec := RecomFromMarker;
          end;
        #AttTypeCat.Name:
          set cAttType := 0;
      end;
    cmOk:
      begin
        CreateReport;
        CloseInterface(cmCancel);
      end;
  end;

end.

//=[ Функции для подключения отчета ]=================================

#include UserReport.vih

vipinterface UserReport_#(GPInt) implements IUserReport;

interface UserReport_#(GPInt);

  procedure Run;
  begin
    RunInterface('#(GPInt)');
  end;

  function GetReportName: String;
  begin
    result := '#(GPNam)';
  end;

  function GetGroupName(Level: Word): String;
  begin
    result := '';
    case Level of
      1: result := 'Аттестации';
    end;
  end;

  function GetPriority: Integer;
  begin
    result := 0;
  end;

  function VisibleInModule(Ind: Byte): String;
  begin
    result := '';
    case Ind of
      1: result := 'STAFFMAINMENU';
    end;
  end;

end.
