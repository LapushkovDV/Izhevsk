#component "Z_Staff"

alter interface PrikPsn;

  create view Psn
    as select
      if (bPrT1 = 2, if(IsValid(tnKatOrg), KatOrg.Code, ''), CatDep.Code) (FieldName = DeptCode)
    from
      synonym Catalogs CatDep
    where ((
      Persons.Department == CatDep.NRec
    ));

  overloadFormats brwPsn;

  browse brwPsn;
   fields
     Persons.TabNmb 'Таб. номер' ('Табельный номер '): [10], protect, noAutoSize;
     Persons.StrTabN 'Таб. номер' ('Табельный номер '): [10], protect, noAutoSize;
     sSovm 'Таб. совм.' ('Табельный номер совмещения'): [10], protect;
     Persons.FIO 'Фамилия, имя, отчество' ('Фамилия Имя Отчество'): [40], protect, noAutoSize;
     DeptCode 'Код подр.' ('Подразделение'): [10], skip;
     DeptName 'Подразделение' ('Подразделение'): [30], skip;
  end;

end.
