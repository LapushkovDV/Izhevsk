/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*                РПД № 72 "Привлечение сотрудника к сверхурочной работе"                          *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Управление персоналом->Документы->Все приказы по персоналу->                     *
*                   Окно редактирования приказа =Приказ=->                                        *
*                   Контекстное меню <Печать индивидуальной формы приказа>                        *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#169          |26/07/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
#include xlReport.vih
#include DeptIer.vih // получить всякие свойства по записи таблицы Catalogs
#include History.vih

Interface iEMOvertimeReport 'РПД № 72 "Привлечение сотрудника к сверхурочной работе"'  escclose, cyan, doaccept;
  Show at (, , 60, 8);
//*****************************************************************************
#include History.var
//*****************************************************************************
table struct tmpOvertime
(
  NRec         : comp
, cPers        : comp
, FIO          : string
, TabNum       : string
, BeginDate    : date
, EndDate      : date
, Dol          : string
, Podr         : string
, PodrCode     : string
, Hours        : double
, Obozn        : string
)
with index
(
  tmpOvertime01 = NRec (Surrogate, Unique)
)
;

//******************************************************************************

Create view
var
  sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol
, sPodpis1Npp
, sPodpis2Npp        : string;

  sCase
, sNumDoc
, dDateDoc
, ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;

  cTitleDoc
, ContDocNrec        : comp; 
as select
  if ((Appointments.lPrizn = 0),  
       GetStrTabN(Persons.TabNmb, Persons.StrTabN), 
       GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN))
    (FieldName = fAppTabN)
, 13
    (FieldName = wType)
, 'Em_Report_' + string(wType)
    (FieldName = nameNastr)
, *
from 
  TitleDoc 
, PartDoc
, ContDoc
, Persons
, tmpOvertime
, Appointments
, Catalogs    PostCat
, Catalogs    DepCat
, KatOrg
, WorkContracts
, UOWrkTabel(UOWT02)
where
((
    ContDoc.Person         ==  Persons.NRec
AND ContDoc.cStr           ==  Appointments.NRec
AND Appointments.Post      ==  PostCat.NRec

AND coGetTune('MyOrg')     == KatOrg.NRec

AND ContDoc.ObjNrec        == WorkContracts.NRec
AND WorkContracts.cVid     == UOWRKTABEL.Nrec
))

bounds byContDoc =
    ContDocNrec             ==  ContDoc.NRec
AND ContDoc.cPart           ==  PartDoc.NRec
AND PartDoc.cDoc            ==  TitleDoc.NRec


bounds byTitleDoc =
    cTitleDoc               ==  TitleDoc.NRec
AND TitleDoc.NRec           ==  PartDoc.cDoc
AND PartDoc.NRec            ==  ContDoc.cPart
AND 1                       ==  ContDoc.SeqNmb


;

Parameters
  sNumDoc
, dDateDoc
, cTitleDoc
, ContDocNrec
;
//*****************************************************************************
var IDepartIer : DepartIer;  // иерархия подразделений
//*****************************************************************************
Procedure InitTable;
{
  var i : word; i := 0;

  _LOOP ContDoc
    { 
      ClearBuffer(#tmpOvertime);
      tmpOvertime.NRec         := GetNextNRec(#tmpOvertime, 0);
      tmpOvertime.cPers        := Persons.NRec;
      tmpOvertime.FIO          := Persons.FIO;
      tmpOvertime.TabNum       := fAppTabN;
      tmpOvertime.Dol          := PostCat.Name;
      tmpOvertime.Podr         := IDepartIer.GetFulDepName(ContDoc.cDopRef);

      if (GetFirst DepCat where ((ContDoc.cDopRef == DepCat.NRec)) = tsOk)
        tmpOvertime.PodrCode   := DepCat.Code;

      if (InStr(ContDoc.SBottom, sCase) = 0)
       sCase := sCase + if (Trim(sCase) = '', '', ', ') + ContDoc.SBottom;

      if (GetFirst WorkContracts = tsOk)
        {
          tmpOvertime.BeginDate    := WorkContracts.dBeg;
          tmpOvertime.EndDate      := WorkContracts.dEnd;
          tmpOvertime.Hours        := double(WorkContracts.LastUser);
          tmpOvertime.Obozn        := if (GetFirst UOWRKTABEL = tsOk, UOWRKTABEL.Name + '(' + UOWRKTABEL.NUM + ')', '');
        }
      if (insert current tmpOverTime = tsOk)
        {}
    }
}
//******************************************************************************
Procedure PrintLine;
{
   _LOOP tmpOvertime
     if (Not NextVisual)
     {
       break; 
     }
     else   
     { 
       pXL.ClearTblBuffer;
                                 
       pXL.SetTblStringFldValue('FIO'       , tmpOvertime.FIO);
       pXL.SetTblStringFldValue('TabNum'    , '''' + tmpOvertime.TabNum);                                            
       if (tmpOvertime.BeginDate <> ZeroDate)
         pXL.SetTblStringFldValue('BeginDate' , '''' + DateToStr(tmpOvertime.BeginDate, 'DD.MM.YYYY'));                                            
       if (tmpOvertime.EndDate <> ZeroDate)
         pXL.SetTblStringFldValue('EndDate'   , '''' + DateToStr(tmpOvertime.EndDate  , 'DD.MM.YYYY'));                                             
       pXL.SetTblStringFldValue('Dol'       , tmpOvertime.Dol );
       pXL.SetTblStringFldValue('Podr'      , tmpOvertime.Podr);
       pXL.SetTblStringFldValue('PodrCode'  , '''' + tmpOvertime.PodrCode);
       pXL.SetTblNumberFldValue('Hours'     , tmpOvertime.Hours);
       pXL.SetTblStringFldValue('Obozn'     , tmpOvertime.Obozn);
       pXL.InsTblRow;                     
     }
}

//*****************************************************************************
Procedure PrintRepost;
{
  ID := 'Overtime';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpOvertime));

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'           , CommonFormHeader);

  var sNameCity : string; sNameCity := '';
  pXL.SetStringVar('org'           , oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', Cur_Date));
  pXL.SetStringVar('Num'           , '''' + sNumDoc );
  if (StrToDate(dDateDoc, 'DD/MM/YYYY') <> ZeroDate)
    pXL.SetStringVar('Date'          , '''' + DateToStr(StrToDate(dDateDoc, 'DD/MM/YYYY'), 'DD.MM.YYYY'));
  pXL.SetStringVar('case'          , sCase);

  pXL.SetStringVar('SoglFIO'       , sSogls);
  pXL.SetStringVar('SoglDol'       , sSoglsDol);
  pXL.SetStringVar('Sogl2FIO'      , sSogls2);
  pXL.SetStringVar('Sogl2Dol'      , sSogls2Dol);
  pXL.SetStringVar('UtvrFIO'       , sUtve);
  pXL.SetStringVar('UtvrDol'       , sUtveDol);
  pXL.SetStringVar('sPodpis1FIO'   , sPodpis1);
  pXL.SetStringVar('sPodpis1Dol'   , sPodpis1Dol);
  pXL.SetStringVar('sPodpis2FIO'   , sPodpis2);
  pXL.SetStringVar('sPodpis2Dol'   , sPodpis2Dol);

  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('Overtime');
  pXL.CreateTblFld('FIO'      );
  pXL.CreateTblFld('TabNum'   );
  pXL.CreateTblFld('BeginDate');
  pXL.CreateTblFld('EndDate'  );
  pXL.CreateTblFld('Dol'      );
  pXL.CreateTblFld('Podr'     );
  pXL.CreateTblFld('PodrCode' );
  pXL.CreateTblFld('Hours'    );
  pXL.CreateTblFld('Obozn'    );
  PrintLine;

  pXL.PublishTbl('Overtime');

  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);
}

HandleEvent

cmInit: 
  {                         
    RunInterface(iEMGetNastrPodp, wType);

    if (NOT ReadMyDsk(sSogls     , nameNastr + '_sSogls', true))
      sSogls := '';

    if (NOT ReadMyDsk(sSoglsDol  , nameNastr + '_sSoglsDol', true))
      sSoglsDol := '';

    if (NOT ReadMyDsk(sSogls2    , nameNastr + '_sSogls2', true))
      sSogls2 := '';

    if (NOT ReadMyDsk(sSogls2Dol , nameNastr + '_sSogls2Dol', true))
      sSogls2Dol := '';

    if (NOT ReadMyDsk(sUtve      , nameNastr + '_sUtve', true))
      sUtve := '';

    if (NOT ReadMyDsk(sUtveDol   , nameNastr + '_sUtveDol', true))
      sUtveDol := '';

    if (NOT ReadMyDsk(sPodpis2   , nameNastr + '_sPodpis2', true))
      sPodpis2 := '';

    if (NOT ReadMyDsk(sPodpis2Dol, nameNastr + '_sPodpis2Dol', true))
      sPodpis2Dol := '';

    if (NOT ReadMyDsk(sPodpis2Npp, nameNastr + '_sPodpis2Npp', true))
      sPodpis2Npp := '';

    if (NOT ReadMyDsk(sPodpis1   , nameNastr + '_sPodpis1', true))
      sPodpis1 := '';

    if (NOT ReadMyDsk(sPodpis1Dol, nameNastr + '_sPodpis1Dol', true))
      sPodpis1Dol := '';

    if (NOT ReadMyDsk(sPodpis1Npp, nameNastr + '_sPodpis1Npp', true))
      sPodpis1Npp := '';

    PushBounds(if (ContDocNrec <> comp(0), tbbyContDoc, tbbyTitleDoc));
    InitTable;
    PrintRepost;
  }

end;
end.
