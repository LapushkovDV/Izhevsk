#include GP_DepFunc.vih
#include ExtAttr.vih
#include StrFunc.vih
#include CatFunc.vih
#include odecl.vih
#include AppFuncs.vih             // объект для работы с назначениями
#include FeeSigners.vih

#component "Z_StaffOrders"

alter interface NFormRD35a
  ( '')

#include FeeSigners.var

Create view
var vid: Word;
  i : integer;
  soExtAttr  : iExtAttr;
  iOdecl     : declension;          // Переменная типа интерфейс declension 
  VAppFuncs  : AppointmentsFunctions; // работа с назначениями
  sSigner      : string;
  sPostUtvLico : string;
  sFIOUtvLico  : string;
  sFIOOtvetstv : string;
  PrimOtvetstv : string;
  RukFIO	: string;
  RukDolg	: string;
from
  Persons LeadPersons
  ,persons personsRuk
  ,appointments LeadAppointments
  ,APPOINTMENTS APPOINTMENTSRuk
where ((
  Education.cInf2         == LeadPersons.Nrec
))
;

form NForm35aWord ('NForm35aWord.out','NForm35aWord') with novisual;

var oGP_DepFunc: GP_DepFunc;

Window winSign 'Выбор подписантов';
Show At (,, 70, 7);
  Screen s1(,,sci1Esc);
    fields
      vid  ('Формат отчета'): NoProtect;
      RukFIO (''), protect, PickButton;
      sSigner('Подписанты',,sci13Esc): {Font = {BackColor = if(sSigner = '', ColorNeed, 0)}}, protect, PickButton;
    buttons
      cmOk,,,'Запуск',,;
      cmCancel,,,'Выход',,;
    << 'Параметры отчета'
       (.) Документ Word  `
       (.) FastReport    `
  `Контроль`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Подписанты`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
     <. ~С~формировать .>                         <. ~З~акрыть .>
    >>
  end;
handleevent
  cmPick:
  {
    Case CurField of
      #sSigner:
        if iFeeSigners.RunMainWindow(1)
          set sSigner := iFeeSigners.GetFeeSignersName;

      #RukFIO:
      {
        var cper:comp;
        cper:=0;
        runinterface(F_PODOT::GetPers,cper);
        if getfirst fastfirstrow PersonsRuk where ((cper == PersonsRuk.Nrec)) = tsOk
        {
          RukFIO := iOdecl.FIODeclension(personsRuk.nrec, PersonsRuk.FIO,2);
          if getfirst fastfirstrow appointmentsRuk where ((VAppFuncs.GetAppNrec_OnDate(PersonsRuk.Nrec, Cur_Date) == appointmentsRuk.Nrec))=tsok
          {
            If soExtAttr.sGetAttr(coCatalogs, AppointmentsRuk.Post, 'Родительный падеж')!=''
              RukDolg := soExtAttr.sGetAttr(coCatalogs, AppointmentsRuk.Post, 'Родительный падеж');
            else
              RukDolg := iCatFunc.GetCatalogsName(AppointmentsRuk.Post);
          }
          SaveMyDsk(RukFIO, 'NFormRD35a_RukFIO');
          SaveMyDsk(RukDolg, 'NFormRD35a_RukDolg')
        }
      }
    end;
  }
  cmDelOnProtect:
  {
    case CurField of
      #sSigner:
        set sSigner := '';
    end;
  }
  cmOk:
  {
    SaveMyDSK(vid, 'vidNFormRD35a');

    if trim(sSigner) <> '' 
      CloseWindowEx(winSign, cmDefault)
    else
      message('Не заданы подписанты!', Error);
  }
  cmCancel:
  {
    SaveMyDSK(vid, 'vidNFormRD35a');

    CloseWindowEx(winSign, cmCancel);
  }
end;
end;

Procedure PrintNForm35aWord;
{
  Org :=  ObjDepartIer4(IDepartIer).GetOrgName(coGetTune('MyOrg'));
  OKPO := Trim(TOA.GetJuridicalInfo.GetOkpoCode);
  cAddrPredp := TOA.GetJuridicalInfo.GetJuridicalAddress;
  RCity := Trim(TOA.GetJuridicalInfo.GetJuridicalAddressStr);

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Печать отчета...', RecordsInTable(#ContDoc)*2);

  i := 0;

  _loop ContDoc
  {
    if not NextVisual
      break;

    inc(i);
    NForm35aWord.PutEventById(fedoloop, fcNForm35aWord_CYCLE);
    NForm35aWord.Write(i);
    If soExtAttr.sGetAttr(coCatalogs, APPOINTMENTS.Post, 'Творительный падеж')!=''
      NForm35aWord.Write(soExtAttr.sGetAttr(coCatalogs, APPOINTMENTS.Post, 'Творительный падеж'));
    else
      NForm35aWord.Write(iCatFunc.GetCatalogsName(APPOINTMENTS.Post));

    NForm35aWord.Write(oGP_DepFunc.GetFullDepName(Appointments.Department, DF_ADD_CODE, 2, '/'));
//    NForm35aWord.Write(oGP_DepFunc.GetDepName(Appointments.Department,2,0,if(Education.FromDate <> ZeroDate, Education.FromDate, Cur_Date)));

//    NForm35aWord.Write(Substr(iCatFunc.GetCatalogsCode(Appointments.Department),1,3));

    NForm35aWord.Write(GetSurnameWithInitials(iOdecl.FIODeclension(persons.nrec, Persons.FIO,5)));

    NForm35aWord.Write(GetStrTabn(Persons.TabNmb,Persons.StrTabn));

    if getfirst fastfirstrow LeadAppointments where ((VAppFuncs.GetAppNrec_OnDate(Persons.Nrec, if(Education.FromDate <> ZeroDate, Education.FromDate, Cur_Date)) == LeadAppointments.Nrec))=tsok
    {
      If soExtAttr.sGetAttr(coCatalogs, LeadAppointments.Post, 'Родительный падеж')!=''
        NForm35aWord.Write(soExtAttr.sGetAttr(coCatalogs, LeadAppointments.Post, 'Родительный падеж'));
      else
        NForm35aWord.Write(iCatFunc.GetCatalogsName(LeadAppointments.Post));
    
      NForm35aWord.Write(oGP_DepFunc.GetFullDepName(LeadAppointments.Department, DF_ADD_CODE, 2, '/'));
//      NForm35aWord.Write(oGP_DepFunc.GetDepName(LeadAppointments.Department,2,0,if(Education.FromDate <> ZeroDate, Education.FromDate, Cur_Date)));
    
//      NForm35aWord.Write(Substr(iCatFunc.GetCatalogsCode(LeadAppointments.Department),1,3));
    
      NForm35aWord.Write(GetSurnameWithInitials(iOdecl.FIODeclension(LeadPersons.nrec, LeadPersons.FIO,2)));

      NForm35aWord.Write(GetStrTabn(LeadPersons.TabNmb,LeadPersons.StrTabn));
    }
    else
      NForm35aWord.Skipformat(5);

    NForm35aWord.Write(DateToStr(Education.FromDate,'DD.MM.YYYY'));
    NForm35aWord.Write(DateToStr(Education.ToDate,'DD.MM.YYYY'));  

  }


  inc(i);
  NForm35aWord.Write(i);

  _loop ContDoc
  {
    if not NextVisual
      break;

    if getfirst fastfirstrow LeadAppointments where ((VAppFuncs.GetAppNrec_OnDate(Persons.Nrec, if(Education.FromDate <> ZeroDate, Education.FromDate, Cur_Date)) == LeadAppointments.Nrec))=tsok
    {
      NForm35aWord.PutEventById(fedoloop, fcNForm35aWord_CYCLE2);
      NForm35aWord.Write(GetSurnameWithInitials(iOdecl.FIODeclension(LeadPersons.nrec, LeadPersons.FIO,3)));
    }
  }

  inc(i);
  NForm35aWord.Write(i);

  NForm35aWord.Write(RukDolg);
  NForm35aWord.Write(GetSurnameWithInitials(RukFIO));

  NForm35aWord.Write(sPostUtvLico);
  NForm35aWord.Write(sFIOUtvLico); 
  NForm35aWord.Write(sFIOOtvetstv);
  NForm35aWord.Write(PrimOtvetstv);

  if (not NForm35aWord.error) and i!=0
    NForm35aWord.showFile('Приказ о наставничестве.');
  else
  {
    NForm35aWord.abortForm;
    message(chr(3)+'Нет данных для формирования справки', OkButton);
  }

  StopVisual('', 0);
}

HandleEvent
cmInit:
  {

    if wGetTune('UP.FakelGAL.Fakel') = 1
    {
      if (not ReadMyDsk(RukFIO, 'NFormRD35a_RukFIO', false))
        RukFIO := 'не установлен';
      if (not ReadMyDsk(RukDolg, 'NFormRD35a_RukDolg', false))
        RukDolg := 'не установлен';
//      if RunInterface(Z_StaffOrders::SelTypePrintTD) = cmDefault
//      {
        ReadMyDSK(vid, 'vidNFormRD35a',true);
//      }
      if (not (ReadMyDsk(sSigner, 'NFormRD35a_sSigner', false)))
        sSigner:=sGetTune('UP.Staff.SignatoryAuthority');

      iFeeSigners.InitFeeSigners(cgReport_7416);
        
      if (RunWindowModal(winSign) = cmDefault)
      {
        iFeeSigners.FindFeeSignersByName(cgReport_7416, sSigner);
        if iFeeSigners.FeeSignersIsValid
        {
          if (not iFeeSigners.RestrictFeeByRole(2,'UtvLico'))
            iFeeSigners.GetSignerFirst;
        
          sPostUtvLico:= iFeeSigners.GetSignerPosition(1);
          sFIOUtvLico:= iFeeSigners.GetSignerFIO(13);
          iFeeSigners.ClearRestriction;
        
          if (not iFeeSigners.RestrictFeeByRole(2,'Otvetstv'))
            iFeeSigners.GetSignerFirst;
        
          sFIOOtvetstv := iFeeSigners.GetSignerFIO(1);
          PrimOtvetstv := iFeeSigners.GetSignerInfo(3);
          iFeeSigners.ClearRestriction;
        }
      }
      SaveMyDsk(sSigner, 'NFormRD35a_sSigner');
    }
    else
      vid := 1;

    IDepartIer.GetBossName();
    TOA.Bind(0); // связываем TOA с собственной организацией

    if vid = 0
    {
      PrintNForm35aWord;
    }
    else
     PrintNForm35aFR;

    abort;
  }       // cmInit
end;      // HandleEvent
end.
