  // Возращает информацию о снятии с воинского учета
  // Работник считается снятым с воинского учета, если у него в разделе 5 картотеки
  // в поле "Вид учета" выбрано значение, которое входит в группу с названием "Не состоит"
  function DecommisInfo: String;
  begin
    result := '';
    if not IsValidAll(tnPersons) then
      exit;
    if not IsValidAll(tnConscription) then
      exit;
    // Значение в поле "Вид учёта"
    if getFirst Catalogs where ((Conscription.AcntKind == Catalogs.NRec)) != tsOk then
      exit;
    // Есть у вида учёта родительская группа?
    if Catalogs.cParent = 0 then
      exit;
    var _VidUch: String = Catalogs.Name;
    var _cParent: Comp = Catalogs.cParent;
    if getFirst Catalogs where ((_cParent == Catalogs.NRec)) != tsOk then
      exit;
    if LoCase(Catalogs.Name) = 'не состоит' then
    result := _VidUch;
  end;

  handleEvent
    cmOnVipLoad:
      begin
        // oGP_Log.Init('GP_FormT2.log', true, true, true);
        // oGP_Log.SetVerboseMode(true);
        PrevDept := 0;
        PrevPost := 0;
        CompactMode := true;
      end;
    //cmOnVipUnLoad:
    //  oGP_Log.Done(true);
  end;

end.
