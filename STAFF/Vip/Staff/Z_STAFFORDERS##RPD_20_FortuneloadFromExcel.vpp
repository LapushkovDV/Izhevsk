PROCEdURE fillrecArrayByTypeTable(_type: byte; _log: string);
{
    var _npp: byte;
        _npp := 1;
    SetLimit(_recArray, 0);
    SetLimit(_recArray, 1);
   if _type = 0
     {
   //   _recArray[_npp].def := 'Код'          ; SetLimit(_recArray, GetLimit(_recArray) + 1); _npp++;
      _recArray[_npp].def := 'Табельный №'      ; SetLimit(_recArray, GetLimit(_recArray) + 1); _npp++;
      _recArray[_npp].def := 'Процент премии'        ;
     }
}


PROCEdURE FillInsertTables(_log: string; _nrow : longint);
{
  var _i: byte;
  var _ProcentFortune : double;
  var _StrTabn  : string;
  clearBuffer(tntmpPersYearFortune);

    logstrtofile(_log,'- строка' + _nrow);
  for(_i := 1; _I <= getLimit(_recArray); _i++)
  {
    case upcase(_recArray[_i].def) of
      Upcase('Табельный №'   ) : { _StrTabn        := Trim(_recArray[_i].value)
                                 };
      Upcase('Процент премии') : { _ProcentFortune := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''))
                                 };
    end;
    logstrtofile(_log,_recArray[_i].def + ' = ' +Trim(_recArray[_i].value));
  }
    logstrtofile(_log,'---');
   if _ProcentFortune >= 0 and _StrTabn <> '' and _ProcentFortune <= 100
    then
     {
      var hstr : longint = 0;

    MysqlAddStr(hstr, '  select  Pers.nrec      as cPersons ');
    MysqlAddStr(hstr, '        , Pers.StrTabn   as StrTabn      ');
    MysqlAddStr(hstr, '        , Pers.Fio       as Fio          ');
    MysqlAddStr(hstr, '        , App.Nrec       as cAppoint     ');
    MysqlAddStr(hstr, '        , App.CADDNREC2  as cLschet      ');
    MysqlAddStr(hstr, '        , App.Department as Department   ');
    MysqlAddStr(hstr, '        , ' + _ProcentFortune + ' as ProcentFortune                                                      ');
    MysqlAddStr(hstr, '        , 0 as SumTime                                                                ');
    MysqlAddStr(hstr, '        , 0 as Summa                                                                  ');
    MysqlAddStr(hstr, '        , (select top 1 1 from GP_KPI_PERS_RAISE where CPERSONS = Pers.nrec) as possiblePersPrem ');
    MysqlAddStr(hstr, '  from Persons Pers                                                                   ');
    MysqlAddStr(hstr, '  join Appointments App on App.nrec = case when Pers.AppointCur = #date(0,0,0) then Pers.AppointLast  else Pers.AppointCur end  ');
    MysqlAddStr(hstr, '  join catalogs Dep on dep.nrec = App.Department                                      ');
    MysqlAddStr(hstr, '  join catalogs Dolj on Dolj.nrec = App.post                                             ');
    MysqlAddStr(hstr, '  where  Pers.strtabn = '''+_StrTabn+''' ');
    MysqlAddStr(hstr, ' and pers.isemployee = ''С'' ');
    var objQuery: iQuery;
      objQuery := queryManager.createQuery(hstr);

    if objQuery.execute.errorCode != tsOk
     then {
        logstrtofile(_log,'Ошибка выполнения запроса '+ objQuery.errorCode);
        }
        else
        {
          sqlCopyInto(objQuery, tntmpPersYearFortune, true);
        }
     }
     else
     {
       logstrtofile(_log,'Строка '+ _nrow+ ' пустой табельный или процент = 0  или процент больше 100 ' + '| _ProcentFortune='+_ProcentFortune  +' _StrTabn='+_StrTabn);
     }


}
Function SearchCellsByName(_name, _log: string; _nrow: word): word;
{
  var
    _result: word;
  var
    _iCol: word;
  _result := 0;
  for (_iCol := 1; _iCol <= 512; _iCol++)
  {
    var
      _iCellStr: string;
      _iCellStr :='';
    xlGetCellValue(_nrow, _iCol, _iCellStr);
    _iCellStr := trim(_iCellStr);

    if UpCase(_iCellStr) = UpCase(_name)
    {
      _result := _iCol;
      LogStrTofile(_log, 'OK. Найдена ячейка ' + _name + ' колонка ' + _iCol);
      break;
    }
  }
 LogStrTofile(_log, '***********************************************************************');
  result := _result
} // Functio SearchCellsByName(_name, _log : string) : byte;

Function OpenFile(_file, _listName, _log: string; var _bookname: string): boolean;
{

  result := false;
  LogStrTofile(_log, 'Файл:  ' + _file);
  xlOpenNewExcel(false);
  xlDisplayAlerts(false);

//  if not xlcreateExcelWithTemplate(_file, false)
  if not(xlSetActiveWorkBookByName(_file))
     if not(xlOpenWorkBook(_file))
  {
    StopVisual('', 0);
    LogStrTofile(_log, 'Ошибка открытия файла ' + _file);
    Message('Ошибка открытия файла ', error);

    xlCloseWorkBook(1);
    xlKillExcel;
    Stop;     abort;    exit;
  }
  If not xlIsExcelValid
  {
    StopVisual('', 0);
    LogStrTofile(_log, 'Ошибка запуска EXCEL ');
    Message('Ошибка запуска EXCEL ', error);
    xlCloseWorkBook(1);
    xlKillExcel;
    Stop;    abort;    exit;
  }

  xlGetActiveWorkBookName(_bookname);
    XLDISPLAYALERTS(false);
//  if not xlSetActiveSheetByName(_listName)
  if not xlSetActiveSheet(1)
  {
    StopVisual('', 0);
    LogStrTofile(_log, 'Ошибка не найден первый лист ');// + _listName);
    Message('Ошибка не найден лист ' + _listName, error);
    xlCloseWorkBookByName(_bookname);
    xlKillExcel;
    Stop;    abort;    exit;
  }
  result := true;
} // Functio OpenFile(_file, _listName : string) : boolean;

Function CheckFileFillValues(_file: string; _log: string): boolean;
{
  result := false;
//  ClearAll;
//  StartNewVisual(vtRotateVisual, vfTimer, 'Файл: ', 1);
// LogStrTofile(_log,'Файл:  ' + _file);
  SetVisualHeader('Файл:  ' + _file
  + ''#13'' + 'Инициализация EXCEL'
+ ''#13'' + ''
  );

  var _bookname: string;

  if not OpenFile(_file, coListName, _log, _bookname) then  {    Stop;    abort;    exit;  }

//  xlSetActiveWorkBookByName(_bookname);
//if not xlSetActiveSheet(1)

  var
    _iCellStr: string;
  var
    Nrow: word;
  var
    isErrorFile: boolean;
  var
    _i: byte;

  isErrorFile := false;

  Nrow := 1; // Считаем, что все находится на первой строке

  for(_i := 1; _I <= getLimit(_recArray); _i++)
  {
    setvisualHeader('Файл:  ' + _file + ''#13'' +
    'Просмотр заголовка файла, лист ' + coListName
    + ''#13'' + _I);
    _recArray[_i].column := SearchCellsByName(_recArray[_i].def, _log, nrow);
    if _recArray[_i].column = 0 then
    {
      LogStrTofile(_log, 'ОШИБКА. НЕ найдена ячейка ' + _recArray[_i].def);
      isErrorFile := true;
    }
  }
  if isErrorFile
  {
    xlCloseWorkBookByName(_bookname);
    xlKillExcel;
    Stop;       abort;    exit;
  }

  Nrow := 2;
  if not isErrorFile
  {
   setvisualHeader('Файл:  ' + _file + ''#13'' +
   'Просмотр данных файла, лист ' + coListName
   + ''#13'' + ''
   );
    do
    {
//      setvisualHeader('Просмотр файла, строка ' + nrow);
      for(_i := 1; _I <= getLimit(_recArray); _i++)
      {
//        LogStrTofile(_log, 'Строка ' + nrow + ' колонка' + _recArray[_i].column);
       setvisualHeader('Файл:  ' + _file + ''#13'' +
       'Просмотр данных файла, лист ' + coListName
            + ''#13'' + Nrow);
        xlGetCellValue(nrow, _recArray[_i].column, _recArray[_i].value);
        if _recArray[1].value <> '' then  _recArray[_i].value := trim(_recArray[_i].value)
      } // for(_i:=1; _I<= getLimit(_recArray);_i++)
      if _recArray[1].value <> ''
      {
        FillInsertTables  (_log, nrow);
      } // if _recArray[1].Value <> ''
      Nrow++
    }
    while _recArray[1].value <> ''
   setvisualHeader('Файл:  ' + _file + ''#13'' +
   'закрываем EXCEL'
      + ''#13'' + ''
   );
   LogStrTofile(_log, 'Обработано строк в файле: ' + (Nrow-1));
   LogStrTofile(_log, '*************************************************************************************');
  } //  if not isErrorFile

  xlCloseWorkBookByName(_bookname);
  xlKillExcel;
  setvisualHeader('Файл:  ' + _file + ''#13'' +
  'Сбор данных из файла завершен'
      + ''#13'' + ''
  );

//  StopVisual('', 0);
  result := (not isErrorFile);

} // Functio CheckFileFillValues();

Function FillFromExcel : boolean ;
{
    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Выборка данных', 0);
 delete all tmpPersYearFortune;
 fillrecArrayByTypeTable(0, _logGlobal);
 result := CheckFileFillValues(_FileWithPersons,_logGlobal);
 stopvisual;
}
