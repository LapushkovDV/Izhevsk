cmSelectAll:{
  inherited::handleevent(cmSelectAll);

  if (GetCurrentFormat=brSubCat)
    ReScanPanel(#mtCatalogs);
}
cmUnSelectAll:{
  inherited::handleevent(cmUnSelectAll);

  if (GetCurrentFormat=brSubCat)
    ReScanPanel(#mtCatalogs);
}
cmInvertAll:{
  inherited::handleevent(cmInvertAll);

  if (GetCurrentFormat=brSubCat)
    ReScanPanel(#mtCatalogs);
}
cmHotKeys:
{
  if iEntryPoint = -11
  {
    var tmpcFlag: comp;
    tmpcFlag := cFlag;
    cFlag := cFlag or 1;
    inherited::handleevent(cmHotKeys);
    cFlag := tmpcFlag;

  }
  else
    inherited::handleevent(cmHotKeys);
}
// -Key------------ <Alt-A> ----------------------------
cmPickAttr:// внешние атрибуты
{ //----  #45.17
  if pVA_VID_PROIZV=0
    pVA_VID_PROIZV:=ExtAttr_ID(coCatalogs,'Вид производства');
  var _pVid_Proizv:comp=coGetAttrID(coCatalogs,Catalogs.Nrec,pVA_VID_PROIZV);
  //--------------------------
  inherited::handleevent(cmPickAttr);
  //--------------------------
  var _pVid_Proizv_New:comp=coGetAttrID(coCatalogs,Catalogs.Nrec,pVA_VID_PROIZV);
  if _pVid_Proizv_New<>_pVid_Proizv
  { var _pPodr:comp=GetKatPodrByCatalogs(Catalogs.Nrec);
    if _pPodr<>0
    { var _sVid_Proizv_New:string=sGetAttrID(coCatalogs,Catalogs.Nrec,pVA_VID_PROIZV);
      coSetAttrID(coKatPodr,_pPodr,pVA_VID_PROIZV,_pVid_Proizv_New,_sVid_Proizv_New);
    }
  }
} // cmPickAttr:
end; // HandleEvent
end.
