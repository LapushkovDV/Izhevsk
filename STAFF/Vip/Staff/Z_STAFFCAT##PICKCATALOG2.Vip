#include GP_WorkingConditions.vih
#include GetKau.vih // выбор значения аналитики

#component "Z_STAFFCAT"
Alter InterFace PickCatalog2;
#include GetKau.var // выбор значения аналитики
overload
  function CommonInitByParams: boolean;
  procedure CheckCatalogsBounds;
end;

ExtendFormats scrCatalogs, scrVidOpl, SCRPOST, TRCAT, SCRTYPEEDUC;

var
  oWorkingConditions:GP_ObjWorkingConditions(GP_WorkingConditions) New;
  pVA_VID_PROIZV:comp=0;
  cMyRecProf : comp = 0h;
//-----------------------
Create View
as select
  oWorkingConditions.PayForHarmWork (fieldname = PayForHarmWork),
  oWorkingConditions.PayForHarmWorkProc+0 (fieldname = PayForHarmWorkProc),
  oWorkingConditions.VacForHarmWork (fieldname = VacForHarmWork),
  oWorkingConditions.VacationDays+0 (fieldname = VacationDays),
  oWorkingConditions.WorkRegime (fieldname = WorkRegime),
  sGetAttr(coCatalogs,Catalogs.Nrec,'Профессия') (fieldname = AttrProf),
  coGetAttr(coCatalogs,Catalogs.Nrec,'Профессия') (fieldname = cAttrProf)
from
   oWorkingConditions
  ,SpKau SpKauProf
where
((
  cMyRecProf == SpKauProf.nrec
))
bounds ByWorkingConditions = Catalogs.NRec==oWorkingConditions.cCat;

function CommonInitByParams: boolean;
{
  if iEntryPoint = -11
  {
    var tmpcFlag: comp;
    tmpcFlag := cFlag;

    cFlag := cFlag or 1;

    if not ReadMyDsk(SelFilter, 'PickCatFilter_Filter', false)
    {
      SelFilter := 2;
      savemydsk(SelFilter, 'PickCatFilter_Filter');
    }

    if SelFilter = 2
      SaveMyDsk(cur_date, 'PickCatFilter_bDate');

    result := inherited::CommonInitByParams;

    cFlag := tmpcFlag;
  }
  else
    result := inherited::CommonInitByParams;


  if (isMarkMode)
    SetHelpAndStatusContext(brSubCat, -1, sci147InsEn, hcKeepCurrent);
}

// Установка ограничений на Catalogs в зависимости от режима просмотра, точки входа, сортировки
procedure CheckCatalogsBounds;
{
  if iEntryPoint = -11
  {
    var tmpcFlag: comp;
    tmpcFlag := cFlag;
    cFlag := cFlag or 1;
    inherited::CheckCatalogsBounds;
    cFlag := tmpcFlag;
  }
  else
    inherited::CheckCatalogsBounds;
}

//------------------------------------------------------------------------------
// Окно редактирования записи Catalogs
//------------------------------------------------------------------------------
