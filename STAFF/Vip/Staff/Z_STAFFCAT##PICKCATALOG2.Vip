handleevent
cminit:
{
  inherited :: handleEvent (cmInit);
  cfssetprop('i_SCRPOST_CATALOGS.CODE','SKIP',TRUE);
  set cMyRecProf := coGetAttr(coCatalogs,Catalogs.Nrec,'Профессия')
}
cmPositionChanged:
{
 inherited :: handleEvent (cmPositionChanged);
 set cMyRecProf := coGetAttr(coCatalogs,Catalogs.Nrec,'Профессия')
}
end;
end;//Window wCatalogs

Tree 1 trCat (, hcStaffViewCatalogs, sci147LTreeEnEsc);
  Show at (, 2,,);
  Table Catalogs;
fields
 AttrProf 'Профессия' ('Профессия из каталога'): [10], Protect;
End;



function IsWorkingConditionsCat:boolean;
{
  result:=RootSysCode=-33;//Условия труда
}

function GetCurCatalogs(var cCat:comp):boolean;
{
  result:=IsValidAll(tnCatalogs);
  if (result)
    cCat:=Catalogs.NRec;
}

WindowEvent wCatalogs;
cmInit:{
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  SetFieldAndLabelVisible(fnPayForHarmWork,IsWorkingConditionsCat);
  SetFieldAndLabelVisible(fnPayForHarmWorkProc,IsWorkingConditionsCat);
  SetFieldAndLabelVisible(fnVacForHarmWork,IsWorkingConditionsCat);
  SetFieldAndLabelVisible(fnVacationDays,IsWorkingConditionsCat);
  SetFieldAndLabelVisible(fnWorkRegime,IsWorkingConditionsCat);
  if (IsWorkingConditionsCat) {
    if (not BoundActive(tbByWorkingConditions))
      AddBounds(tbByWorkingConditions);
    ReReadRecord(tnoWorkingConditions);

    BindEvent(GetCurCatalogs,oWorkingConditions.GetCurCatalogs);
  }
  if not ( -22 = RootSysCode or 49 = RootSysCode or 13 = RootSysCode or
      1400 = RootSysCode or 1401 = RootSysCode or 1402 = RootSysCode
         )
    {
     ClearFieldState(#AttrProf, sfVisible);
    }
    else
     {
      SetFieldState(#AttrProf, sfVisible);
     }
}
cmDone:{
  case inherited :: handleEvent (cmDone) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (IsWorkingConditionsCat) {
    if (BoundActive(tbByWorkingConditions))
      SubBounds(tbByWorkingConditions);

    UnBindEvent(GetCurCatalogs,oWorkingConditions.GetCurCatalogs);
  }
}
end;

TableEvent Table Catalogs;
cmExprFieldChanged:{
  case inherited :: handleEvent (cmExprFieldChanged) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnPayForHarmWorkProc:{
      if (IsNew) SetModified(true);
      if (not UpdateTable) exit;

      set oWorkingConditions.PayForHarmWorkProc:=double(ExprFieldValue);
    }
    fnVacationDays:{
      if (IsNew) SetModified(true);
      if (not UpdateTable) exit;

      set oWorkingConditions.VacationDays:=double(ExprFieldValue);
    }
  end;
}
cmPick:{
  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnPayForHarmWork,fnVacForHarmWork,fnWorkRegime:{
      if (IsNew) SetModified(true);
      if (not UpdateTable) exit;
    }
  end;

  case CurField of
    fnPayForHarmWork:{
      if (oWorkingConditions.PickPayForHarmWork)
        set PayForHarmWork;
    }
    fnVacForHarmWork:{
      if (oWorkingConditions.PickVacForHarmWork)
        set VacForHarmWork;
    }
    fnWorkRegime:{
      if (oWorkingConditions.PickWorkRegime)
        set WorkRegime;
    }
    end;
  case CurField of
    fnPayForHarmWork,fnVacForHarmWork,fnWorkRegime:
      {ReReadRecord(tnoWorkingConditions);
      }
    fnAttrProf:
    {
     if (iGetKau.GetCodeKau(cgiPick, 10066, cMyRecProf) > 0 )
       {
        set cMyRecProf  := cMyRecProf;
        if isvalid(tnSpKauProf)
        then
         {
          coSetAttr(coCatalogs,Catalogs.Nrec,'Профессия',cMyRecProf, ShowKau(10066, cMyRecProf));
          set Catalogs.code := SpKauProf.code;
         }
       }
    }
  end;
}
cmDelOnProtect:{
  case inherited :: handleEvent (cmDelOnProtect) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnPayForHarmWork,fnVacForHarmWork,fnWorkRegime:{
      abort;
      if (not UpdateTable) exit;
    }
  end;

  case CurField of
    fnPayForHarmWork:{
      if (oWorkingConditions.DelPayForHarmWork)
        set PayForHarmWork;
    }
    fnVacForHarmWork:{
      if (oWorkingConditions.DelVacForHarmWork)
        set VacForHarmWork;
    }
    fnWorkRegime:{
      if (oWorkingConditions.DelWorkRegime)
        set WorkRegime;
    }
    end;
  case CurField of
    fnPayForHarmWork,fnVacForHarmWork,fnWorkRegime:
     {
       ReReadRecord(tnoWorkingConditions);
     }
   fnAttrProf:
    {
      coSetAttr(coCatalogs,Catalogs.Nrec,'Профессия',0h, '');
      set Catalogs.code := '';
    }
  end;


}
end;

