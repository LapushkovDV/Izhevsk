#include GP_FormT12Gen.vih
#include GP_Log.vih // Объектный интерфейс для вывода протокола
#include GP_StrFunc.vih
#include GP_Signers.vih // Библиотека для вывода подписей в отчетах
#include History.vih

interface GP_FormT12Gen;

  const
    REP_NAME = 'GP_FormT12Gen';
    TEMPLATE_FILE_NAME = 'GP_FormT12.xltm';
    FIRST_BODY_ROW = 19;
    FIRST_BODY_COL = 1;
    LAST_BODY_COL = 36;
    BODY_ROW_HEIGH = 8;
    SG_CONST_REP = cgReport_KASSFRO; // код группы отчётов для выбора подписантов
    SG_TAG_REP = 'FormT12'; // код группы отчётов для выбора подписантов
    ST_SHOW_LEGEND = 1; // Показывать первый лист
    MAX_ABSENCE_COUNT = 14; // Максимально кол-во неявок
    MAX_ORDER_COUNT = 14; // Максимально кол-во заказов
    ABSENCE_ROWS = 7; // Кол-во строк для вывода неявок
    ORDER_ROWS = 7; // Кол-во строк для вывода заказов
    // Константы ошибок при работе с Excel
    XE_BAD_OP           =  0; // не удалось выполнить операцию с Excel-файлом
    XE_CREATE_FILE      =  1; // не удалось создать файл
    XE_OPEN_FILE        =  2; // не удалось открыть файл
    XE_INIT_FILE        =  3; // не удалось инициализировать Excel
    XE_CREATE_MATRIX    =  4; // не удалось создать матрицу
    XE_FREE_MATRIX      =  5; // не удалось освободить матрицу
    XE_OUT_MATRIX       =  6; // не удалось вывести матрицу в отчёт
    XE_WRITE_TO_MATRIX  =  7; // не удалось записать значение в матрицу
    XE_FORMAT_CELL      =  8; // не удалось отформатировать ячейку
    XE_SET_CELL_VALUE   =  9; // не удалось записать значение в ячейку
    XE_SET_CELL_FORMULA = 10; // не удалось записать формулу
    XE_RUN_MACRO        = 11; // не удалось запустить макрос
    XE_ADD_SHEET        = 12; // не удалось добавить вкладку
    XE_DEL_SHEET        = 13; // не удалось удалить вкладку
    XE_RENAME_SHEET     = 14; // не удалось переименовать вкладку
    XE_WRONG_TEMPLATE   = 15; // в xlt шаблоне не найден лист с именем
  end;

  create view
    var
      pDBeg: Date;
      pDEnd: Date;
      pDepFilter: String;
      pSettings: Word;
      IsAborted: Boolean;
      R, C: LongInt;
      NPP: LongInt;
    from 
      TmpFormT12 (tmpTabWorkTime03),
      synonym Catalogs CatPosition
    where ((
          TmpFormT12.cLSchet   == LSchet.NRec
      and LSchet.tPerson       == Persons.NRec
      and TmpFormT12.cPosition == CatPosition.NRec
    ))
  ;

  #include GP_Log.var
  #include GP_StrFunc.var
  #include GP_Log.var
  #include GP_Signers.var
  #include History.var

  var
    DaysInCurMonth: Byte;

  //------------------------------------------------------------------------------------------------------------------------------

  // Исключение для генерации ошибок, связанных с выводом в Excel файл
  exception ExOnExecelError;

  // Генерирует ошибку, связанную с выводом в Excel файл
  procedure ExcelError(ErrCode: Word; AddInfo: String);
  var
    ErrText: String;
  begin
    case ErrCode of
      XE_BAD_OP:
        ErrText := 'не удалось выполнить операцию с Excel-файлом';
      XE_CREATE_FILE:
        ErrText := 'не удалось создать файл';
      XE_OPEN_FILE:
        ErrText := 'не удалось открыть файл';
      XE_INIT_FILE:
        ErrText := 'не удалось инициализировать Excel';
      XE_CREATE_MATRIX:
        ErrText := 'не удалось создать матрицу';
      XE_OUT_MATRIX:
        ErrText := 'не удалось вывести матрицу в отчёт';
      XE_WRITE_TO_MATRIX:
        ErrText := 'не удалось записать значение в матрицу';
      XE_WRONG_TEMPLATE:
        ErrText := 'в xlt шаблоне не найден лист с именем';
      XE_FORMAT_CELL:
        ErrText := 'не удалось отформатировать ячейку';
      XE_SET_CELL_VALUE:
        ErrText := 'не удалось записать значение в ячейку';
      XE_RUN_MACRO:
        ErrText := 'не удалось запустить макрос';
      XE_ADD_SHEET:
        ErrText := 'не удалось добавить вкладку';
      XE_DEL_SHEET:
        ErrText := 'не удалось удалить вкладку';
      XE_RENAME_SHEET:
        ErrText := 'не удалось переименовать вкладку';
      XE_FREE_MATRIX:
        ErrText := 'не удалось освободить матрицу';
      XE_SET_CELL_FORMULA:
        ErrText := 'не удалось записать формулу';
    else
      ErrText := '';
    end;
    oGP_Log.Error(ErrText + ' ' + AddInfo);
    _raise ExOnExecelError;
  end;

  // Эта Функция делает более удобной проверку результата операции с Excel
  // Первым параметром передаем функцию, которая работает с Excel, а вторым и третьим - информацию об ошибке,
  // которая будет выведена, если эта функция вернёт false (т.е. выполнится с ошибкой)
  procedure xlOp(IsCorrect: Boolean; ErrCode: Word; AddInfo: String);
  begin
    if not IsCorrect then
      ExcelError(ErrCode, AddInfo);
  end;

  file MacroFile;

  function CreateMacro(MacroFileName: string): Boolean;
  begin
    result := false;
    if MacroFile.OpenFile(MacroFileName, stCreate) then
    begin
      MacroFile.Writeln('Sub FormatReport');
      MacroFile.Writeln('  Sheets("' + OEM2ANSI('Лист 1') + '").Select');
      MacroFile.Writeln('  ActiveWindow.SelectedSheets.Visible = False');
      MacroFile.Writeln('  Sheets("' + OEM2ANSI('Отчет') + '").Select');
      MacroFile.Writeln('End Sub');
      MacroFile.Close;
      result := true;
    end else
      oGP_Log.Error('Не удалось создать файл "' + MacroFileName + '"');
  end;

  procedure RunMacro;
  var
    MacroFileName: String;
  begin
    if IsAborted then
      exit;
    MacroFileName := GetDefaultUserPath + REP_NAME + '.bas';
    if not CreateMacro(MacroFileName) then
      exit;
    xlImportModule(MacroFileName);
    xlRunMacro('FormatReport');
    DeleteFile(MacroFileName);
  end;

  //-[ Public ]-------------------------------------------------------------------------

  // Инициализирует форму
  function Init(_pDBeg: Date; _pDEnd: Date; _DepFilter: String; _Settings: Word): Boolean;
  var
    FileName: String;
  begin
    IsAborted := false;
    pDBeg := _pDBeg;
    pDEnd := _pDEnd;
    pDepFilter := _DepFilter;
    pSettings := _Settings;
    R := FIRST_BODY_ROW;
    NPP := 0;
    result := true;
    oGP_Log.Init('GP_FormT12Gen.log', true, true, true);
    oGP_Log.SetVerboseMode(true); // Показывать подробный лог
    // Инициализация подписантов
    oGP_Signers.Init(cgReport_KASSFRO, SG_TAG_REP, false, pDEnd);
    // Открытие шаблона
    FileName := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\' + TEMPLATE_FILE_NAME;
    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);
    _try
    begin
      SetVisualHeader('Создание Excel-файла...');
      xlOp(ExistFile(FileName), XE_OPEN_FILE, FileName);
      xlOp(xlCreateExcelWithTemplate(FileName, True), XE_CREATE_FILE, FileName);
      xlOp(xlIsExcelValid, XE_INIT_FILE, 'xlIsExcelValid');
      xlOp(xlSetActiveSheetByName('Отчет'), XE_INIT_FILE, 'Ошибка при активации вкладки "Отчет"');
      // Заполняем ячейки шапки
      // Наименование организации (A4 - C1:R4)
      xlOp(xlSetCellStringValue(oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', pDEnd), 4, 1, 4, 1), XE_SET_CELL_VALUE, '');
      // Структурное подразделение (A6 - C1:R4)
      xlOp(xlSetCellStringValue(pDepFilter, 6, 1, 6, 1), XE_SET_CELL_VALUE, '');
      // Дата составления (Y10 - C25:R10)
      xlOp(xlSetCellStringValue(DateToStr(Cur_Date, 'DD.MM.YYYY'), 10, 25, 10, 25), XE_SET_CELL_VALUE, '');
      // Отчетный период с (AF10 - C32:R10)
      xlOp(xlSetCellStringValue(DateToStr(pDBeg, 'DD.MM.YYYY'), 10, 32, 10, 32), XE_SET_CELL_VALUE, '');
      // Отчетный период с (AH10 - C34:R10)
      xlOp(xlSetCellStringValue(DateToStr(pDEnd, 'DD.MM.YYYY'), 10, 34, 10, 34), XE_SET_CELL_VALUE, '');
      SetVisualHeader('Формирование отчета...');
    end
    _except on ExOnExecelError:
    begin
      IsAborted := true;
    end;
  end;

  // Возвращает True, если день, соответсвующий указанной ячейка для дня существует
  function IsValidDayCell(R, C: Byte): Boolean;
  begin
    result := false;
    // В 16-ю колонку 1 строки не выводится ничего
    if R = 1 and C = 16 then
      exit;
    // Во 2-й строке кол-во ячеек зависит от того, сколько дней в месяце
    if R = 2 and ((R - 1) * 15 + C > DaysInCurMonth) then
      exit;
    result := true;
  end;

  // Выводит в форму все записи из временной таблицы TmpFormT12
  procedure OutTmpFormT12;
  var
    I, J, N: Byte;
    D: Double;
    S: String;
    CI, RI: LongInt;
    SumFormat2D: String;
    DayDate: Date;
  begin
    if IsAborted then
      exit;
    SumFormat2D := '# ##0' + GetDecimalSeparator + '00';

    _try
    begin
      _loop TmpFormT12
      begin
        DaysInCurMonth := Last_Day(Date(1, Month(TmpFormT12.DBeg), Year(TmpFormT12.DBeg)));

        C := FIRST_BODY_COL - 1;

        // Рисуем границы ячеек
        /*
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB + xlInsideV + xlInsideH, xlThin, 0, 0, 
         R, FIRST_BODY_COL, R + BODY_ROW_HEIGH - 1, LAST_BODY_COL), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlMedium, 0, 0, 
         R, FIRST_BODY_COL, R + BODY_ROW_HEIGH - 1, LAST_BODY_COL), XE_FORMAT_CELL, '');
        */
        // Выравниваем содержимое ячеек по верхнему краю и по центру
        xlOp(xlAlignCellsEx(xlCenter, xlTop, R, FIRST_BODY_COL, R + BODY_ROW_HEIGH - 1, LAST_BODY_COL), XE_FORMAT_CELL, '');
        // Устанавливаем текстовый формат для всех ячеек
        xlOp(xlSetNumberFormat('@', R, FIRST_BODY_COL, R + BODY_ROW_HEIGH - 1, LAST_BODY_COL), XE_FORMAT_CELL, '');

        // Номер по порядку
        xlOp(xlMergeCells(R, ++C, R + BODY_ROW_HEIGH - 1, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellNumberValue(++NPP, R, C, R, C), XE_SET_CELL_VALUE, '');
        // Фамилия, инициалы, должность (специальность, профессия)
        xlOp(xlMergeCells(R, ++C, R + BODY_ROW_HEIGH - 1, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellStringValue(oGP_SF.ShortFIO(TmpFormT12.PersonName) + 
         if(IsValidAll(tnCatPosition), ''#10#10 + CatPosition.Name, ''), R, C, R, C), XE_SET_CELL_VALUE, '');
        // Дни
        for (I := 1; I <= 16; I++)
        begin
          C++;
          for (J := 1; J <= 2; J++)
          begin
            N := (J - 1) * 15 + I;
            RI := (J - 1) * (BODY_ROW_HEIGH div 2) + R;
            // Если это не существующий день
            if not IsValidDayCell(J, I) then
            begin
              // 16-й день первой строки не выводим
              /*
              xlOp(xlMergeCells(RI, C, RI + (BODY_ROW_HEIGH div 2) - 1, C), XE_FORMAT_CELL, '');
              xlOp(xlSetCellStringValue('X', RI, C, RI, C), XE_SET_CELL_VALUE, '');
              xlOp(xlSetBackColor(0C0C0C0h, RI, C, RI, C), XE_SET_CELL_VALUE, '');
              */
              xlOp(xlSetCellStringValue('X', RI, C, RI + 1, C), XE_SET_CELL_VALUE, '');
              xlOp(xlSetBackColor(595959h, RI, C, RI + 3, C), XE_SET_CELL_VALUE, '');
            end else
            begin
              DayDate := To_Date(N, Month(pDBeg), Year(pDBeg));
              // Если этот день не попадает в этот период
              if DayDate < TmpFormT12.DBeg or DayDate > TmpFormT12.DEnd then
              begin
                // xlOp(xlMergeCells(RI, C, RI + (BODY_ROW_HEIGH div 2) - 1, C), XE_FORMAT_CELL, '');
                xlOp(xlSetCellStringValue('X', RI, C, RI, C), XE_SET_CELL_VALUE, '');
                // Для красоты можно подкрасить цветом дни, которые находятся за пределами периода
                // Отключено потому что стандартная форма это не поддерживает.
                // xlOp(xlSetBackColor(0DDEBF7h, RI, C, RI + 3, C), XE_SET_CELL_VALUE, '');
              end else
              begin
                // Дни: заголовок
                S := TmpFormT12.DMark[N];
                if S != '' then
                begin
                  xlOp(xlSetCellStringValue(S, RI, C, RI, C), XE_SET_CELL_VALUE, '');
                end;
                // Дни: отработано часов
                D := TmpFormT12.DHours[N];
                S := if(D != 0, oGP_SF.TimeDToH(D), '');
                if S != '' then
                begin
                  xlOp(xlSetCellStringValue(S, RI + 1, C, RI + 1, C), XE_SET_CELL_VALUE, '');
                end;
                // Дни: тип
                S := TmpFormT12.DMarkAdd[N];
                if S != '' then
                begin
                  xlOp(xlSetCellStringValue(S, RI + 2, C, RI + 2, C), XE_SET_CELL_VALUE, '');
                end;
                // Дни: часов по ночным, сверхурочным и т.д.
                D := TmpFormT12.DHoursAdd[N];
                S := if(D != 0, oGP_SF.TimeDToH(D), '');
                if S != '' then
                begin
                  xlOp(xlSetCellStringValue(S, RI + 3, C, RI + 3, C), XE_SET_CELL_VALUE, '');
                end;
              end;
            end;
          end;
        end;
        // Отработано за I половину месяца
        /*
        xlOp(xlMergeCells(R, ++C, R + 1, C), XE_FORMAT_CELL, '');
        xlOp(xlMergeCells(R + 2, C, R + 3, C), XE_FORMAT_CELL, '');
        xlOp(xlMergeCells(R + 4, C, R + 7, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellNumberValue(TmpFormT12.Day1P, R, C, R, C), XE_SET_CELL_VALUE, '');
        xlOp(xlSetNumberFormat(SumFormat2D, R + 2, C, R + 2, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellNumberValue(TmpFormT12.Chas1P, R + 2, C, R + 2, C), XE_SET_CELL_VALUE, '');
        */
        xlOp(xlSetCellNumberValue(TmpFormT12.Day1P, R, ++C, R, C), XE_SET_CELL_VALUE, '');
        xlOp(xlSetNumberFormat(SumFormat2D, R + 1, C, R + 1, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellNumberValue(TmpFormT12.Chas1P, R + 1, C, R + 1, C), XE_SET_CELL_VALUE, '');
        // Отработано за месяц
        /*
        xlOp(xlMergeCells(R, ++C, R + 3, C), XE_FORMAT_CELL, '');
        xlOp(xlMergeCells(R + 4, C, R + 5, C), XE_FORMAT_CELL, '');
        xlOp(xlMergeCells(R + 6, C, R + 7, C), XE_FORMAT_CELL, '');
        xlOp(xlSetNumberFormat(SumFormat2D, R + 4, C, R + 7, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellNumberValue(TmpFormT12.Day1P + TmpFormT12.Day2P, R + 4, C, R + 4, C), XE_SET_CELL_VALUE, '');
        xlOp(xlSetNumberFormat(SumFormat2D, R + 6, C, R + 6, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellNumberValue(TmpFormT12.Chas1P + TmpFormT12.Chas2P, R + 6, C, R + 6, C), XE_SET_CELL_VALUE, '');
        */
        xlOp(xlSetCellNumberValue(TmpFormT12.Day1P + TmpFormT12.Day2P, R + 4, ++C, R + 4, C), XE_SET_CELL_VALUE, '');
        xlOp(xlSetNumberFormat(SumFormat2D, R + 5, C, R + 5, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellNumberValue(TmpFormT12.Chas1P + TmpFormT12.Chas2P, R + 5, C, R + 5, C), XE_SET_CELL_VALUE, '');
        // Табельный номер
        xlOp(xlMergeCells(R, ++C, R + BODY_ROW_HEIGH - 1, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellStringValue('''' + GetStrTabN(LSchet.TabN, LSchet.StrTabN), R, C, R, C), XE_SET_CELL_VALUE, '');
        // Категория
        xlOp(xlMergeCells(R, ++C, R + BODY_ROW_HEIGH - 1, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellNumberValue(TmpFormT12.Kateg, R, C, R, C), XE_SET_CELL_VALUE, '');
        // Данные по видам и направлениям затрат
        C++;
        for (J := 1; J <= 2; J++)
        begin
          for (I := 1; I <= BODY_ROW_HEIGH; I++)
          begin
            CI := C + ((J - 1) * 3);
            RI := R + I - 1;
            N := (J - 1) * BODY_ROW_HEIGH + I;
            if N > MAX_ORDER_COUNT then
              break;
            // Вид оплаты: код
            if TmpFormT12.OCode[N] != 0 then
              xlOp(xlSetCellStringValue(TmpFormT12.OCode[N], RI, CI, RI, CI), XE_SET_CELL_VALUE, '');
            // Вид оплаты: счет
            if TmpFormT12.OAcc[N] != '' then
              xlOp(xlSetCellStringValue('''' + TmpFormT12.OAcc[N], RI, CI + 1, RI, CI + 1), XE_SET_CELL_VALUE, '');
            else
              // для экономии времени выводим до первой записи с незаполненым полем Счет
              break;
            // Вид оплаты: часы
            if TmpFormT12.OHours[N] != 0 then
            begin
              // xlOp(xlSetCellStringValue(oGP_SF.TimeDToH(TmpFormT12.OHours[N]), RI, CI + 2, RI, CI + 2), XE_SET_CELL_VALUE, '');
              xlOp(xlSetNumberFormat(SumFormat2D, RI, CI + 2, RI, CI + 2), XE_FORMAT_CELL, '');
              xlOp(xlSetCellNumberValue(TmpFormT12.OHours[N], RI, CI + 2, RI, CI + 2), XE_SET_CELL_VALUE, '');
            end;
          end;
        end;
        C += 5;
        // Ночные
        xlOp(xlMergeCells(R, ++C, R + BODY_ROW_HEIGH - 1, C), XE_FORMAT_CELL, '');
        xlOp(xlSetNumberFormat(SumFormat2D, R, C, R, C), XE_FORMAT_CELL, '');
        if TmpFormT12.TN > 0.001 then
          xlOp(xlSetCellNumberValue(TmpFormT12.TN, R, C, R, C), XE_SET_CELL_VALUE, '');
        // Сверхурочные
        xlOp(xlMergeCells(R, ++C, R + BODY_ROW_HEIGH - 1, C), XE_FORMAT_CELL, '');
        xlOp(xlSetNumberFormat(SumFormat2D, R, C, R, C), XE_FORMAT_CELL, '');
        if TmpFormT12.TS > 0.001 then
          xlOp(xlSetCellNumberValue(TmpFormT12.TS, R, C, R, C), XE_SET_CELL_VALUE, '');
        // Работа в выходные
        // xlOp(xlMergeCells(R, ++C, R + 3, C), XE_FORMAT_CELL, '');
        xlOp(xlSetNumberFormat(SumFormat2D, R, ++C, R, C), XE_FORMAT_CELL, '');
        if TmpFormT12.TRBHours > 0.001 then
          xlOp(xlSetCellNumberValue(TmpFormT12.TRBHours, R, C, R, C), XE_SET_CELL_VALUE, '');
        if TmpFormT12.TRBDays > 0 then
          xlOp(xlSetCellNumberValue(TmpFormT12.TRBDays, R + 1, C, R + 1, C), XE_SET_CELL_VALUE, '');
        // Работа в выходные с компенсацией отпуском
        // xlOp(xlMergeCells(R + 4, C, R + 7, C), XE_FORMAT_CELL, '');
        xlOp(xlSetNumberFormat(SumFormat2D, R + 4, C, R + 4, C), XE_FORMAT_CELL, '');
        if TmpFormT12.TROHours > 0.001 then
          xlOp(xlSetCellNumberValue(TmpFormT12.TROHours, R + 4, C, R + 4, C), XE_SET_CELL_VALUE, '');
        if TmpFormT12.TRODays > 0 then
          xlOp(xlSetCellNumberValue(TmpFormT12.TRODays, R + 5, C, R + 5, C), XE_SET_CELL_VALUE, '');
        // Неявки по причинам
        C++;
        for (I := 1; I <= 2; I++)
        begin
          for (J := 1; J <= BODY_ROW_HEIGH; J++)
          begin
            CI := C + ((I - 1) * 2);
            RI := R + J - 1;
            N := (I - 1) * BODY_ROW_HEIGH + J;
            if N > MAX_ABSENCE_COUNT then
              break;
            // Неявки: код
            if TmpFormT12.ACode[N] != '' then
              xlOp(xlSetCellStringValue(TmpFormT12.ACode[N], RI, CI, RI, CI), XE_SET_CELL_VALUE, '')
            else
              // для экономии времени выводим до первой неявки с незаполненым полем Код
              break;
            // Неявки: дни
            if TmpFormT12.ADays[N] != 0 then
            begin
              xlOp(xlSetCellStringValue(TmpFormT12.ADays[N], RI, CI + 1, RI, CI + 1), XE_SET_CELL_VALUE, '');
              xlOp(xlSetNumberFormat(SumFormat2D, RI, CI + 1, RI, CI + 1), XE_FORMAT_CELL, '');
            end;
          end;
        end;
        C += 3;
        // Кол-во выходных и праздничных дней
        xlOp(xlMergeCells(R, ++C, R + BODY_ROW_HEIGH - 1, C), XE_FORMAT_CELL, '');
        //xlOp(xlSetNumberFormat(SumFormat2D, R, C, R, C), XE_FORMAT_CELL, '');
        xlOp(xlSetCellNumberValue(TmpFormT12.TV, R, C, R, C), XE_SET_CELL_VALUE, '');

        // Рисуем границы ячеек
        /*
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB + xlInsideV + xlInsideH, xlThin, 0, 0, 
         R, FIRST_BODY_COL, R + BODY_ROW_HEIGH - 1, LAST_BODY_COL), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlMedium, 0, 0, 
         R, FIRST_BODY_COL, R + BODY_ROW_HEIGH - 1, LAST_BODY_COL), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlMedium, 0, 0, 
         R, FIRST_BODY_COL + 1, R + BODY_ROW_HEIGH - 1, FIRST_BODY_COL + 1), XE_FORMAT_CELL, '');
        */
        // 
        // Номер по порядку; Фамилия, инициалы, должность (специальность, профессия)
        C := FIRST_BODY_COL;
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB + xlInsideV, xlMedium, 0, 0, 
         R, C, R + BODY_ROW_HEIGH - 1, C + 1), XE_FORMAT_CELL, '');
        C += 2;
        // Отметки о явках и неявках на работу по числам месяца; Отработано за
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlMedium, 0, 0, 
         R, C, R + BODY_ROW_HEIGH - 1, C + 15), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlBorderB + xlInsideV, xlThin, 0, 0, 
         R, C, R + 3, C + 15), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlInsideV, xlThin, 0, 0, 
         R + 4, C, R + BODY_ROW_HEIGH - 1, C + 15), XE_FORMAT_CELL, '');
        C += 16;
        // Отработано за
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlMedium, 0, 0, 
         R, C, R + BODY_ROW_HEIGH - 1, C + 1), XE_FORMAT_CELL, '');
        // xlOp(xlFrameCells(xlInsideV + xlInsideH, xlThin, 0, 0,
        //  R, C, R + BODY_ROW_HEIGH - 1, C + 1), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlBorderR + xlBorderB, xlThin, 0, 0,
          R, C, R + 3, C), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlBorderL + xlBorderT, xlThin, 0, 0,
          R + 4, C + 1, R + BODY_ROW_HEIGH - 1, C + 1), XE_FORMAT_CELL, '');
        C += 2;
        // табельный номер; Категория
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB + xlInsideV, xlMedium, 0, 0, 
         R, C, R + BODY_ROW_HEIGH - 1, C + 1), XE_FORMAT_CELL, '');
        C += 2;
        // Данные по видам и направлениям затрат
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlMedium, 0, 0, 
         R, C, R + BODY_ROW_HEIGH - 1, C + 5), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlInsideV + xlInsideH, xlThin, 0, 0,
         R, C, R + BODY_ROW_HEIGH - 1, C + 5), XE_FORMAT_CELL, '');
        C += 6;
        // Работа: в ночное время(Н); сверхурочная(С); в выходные и праздничны дни
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlMedium, 0, 0, 
         R, C, R + BODY_ROW_HEIGH - 1, C + 2), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlBorderR + xlInsideV + xlInsideH, xlThin, 0, 0,
         R, C, R + BODY_ROW_HEIGH - 1, C + 1), XE_FORMAT_CELL, '');

        xlOp(xlFrameCells(xlBorderB, xlThin, 0, 0,
         R, C + 2, R + 3, C + 2), XE_FORMAT_CELL, '');

        C += 3;
        // Неявки по причинам
        xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlMedium, 0, 0, 
         R, C, R + BODY_ROW_HEIGH - 1, C + 4), XE_FORMAT_CELL, '');
        xlOp(xlFrameCells(xlInsideV + xlInsideH, xlThin, 0, 0,
         R, C, R + BODY_ROW_HEIGH - 1, C + 4), XE_FORMAT_CELL, '');
        R += BODY_ROW_HEIGH;
      end;
    end
    _except on ExOnExecelError, ExUserBreak:
    begin
      IsAborted := true;
    end;
  end;

  procedure OutSign(C: LongInt; L1, L2, L3: Byte; Title, Role: String; ShowDate: Boolean);
  var
    CI, CL: LongInt;
    SignerPosition, SignerName: String;
  begin
    SignerPosition := '';
    SignerName := '';
    if Role != '' then
      if oGP_Signers.GetFirst(Role) then
      begin
        SignerPosition := oGP_Signers.GetPosition;
        SignerName := oGP_Signers.GetFIO(1, 2);
      end;

    CI := C;
    CL := CI + L1 + L2 + L3 - 1;
    xlOp(xlMergeCells(R, CI, R, CL), XE_FORMAT_CELL, '');
    xlOp(xlSetCellStringValue(Title, R, CI, R, CI), XE_SET_CELL_VALUE, '');
    xlOp(xlSetFontSize(10, R, CI, R + 1, CL), XE_FORMAT_CELL, '');
    xlOp(xlSetFontSize(7, R + 2, CI, R + 2, CL), XE_FORMAT_CELL, '');
    xlOp(xlSetFontStyle(xlItalic, R + 2, CI, R + 2, CL), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlBottom, R + 1, CI, R + 1, CL), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, R + 2, CI, R + 2, CL), XE_FORMAT_CELL, '');
    xlOp(xlFrameCells(xlBorderB, xlThin, 0, 0, R + 1, CI, R + 1, CL), XE_FORMAT_CELL, '');

    // Должность
    xlOp(xlMergeCells(R + 1, CI, R + 1, CI + L1 - 1), XE_FORMAT_CELL, '');
    xlOp(xlSetCellStringValue(SignerPosition, R + 1, CI, R + 1, CI), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, CI, R + 2, CI + L1 - 1), XE_FORMAT_CELL, '');
    xlOp(xlSetCellStringValue('должность', R + 2, CI, R + 2, CI), XE_SET_CELL_VALUE, '');
    // Подпись
    CI += L1;
    xlOp(xlMergeCells(R + 1, CI, R + 1, CI + L2 - 1), XE_FORMAT_CELL, '');
    xlOp(xlMergeCells(R + 2, CI, R + 2, CI + L2 - 1), XE_FORMAT_CELL, '');
    xlOp(xlSetCellStringValue('подпись', R + 2, CI, R + 2, CI), XE_SET_CELL_VALUE, '');
    // Фамилия И.О.
    CI += L2;
    xlOp(xlMergeCells(R + 1, CI, R + 1, CI + L3 - 1), XE_FORMAT_CELL, '');
    xlOp(xlSetCellStringValue(SignerName, R + 1, CI, R + 1, CI), XE_SET_CELL_VALUE, '');
    xlOp(xlMergeCells(R + 2, CI, R + 2, CI + L3 - 1), XE_FORMAT_CELL, '');
    xlOp(xlSetCellStringValue('расшифровка подписи', R + 2, CI, R + 2, CI), XE_SET_CELL_VALUE, '');
    // Дата
    if ShowDate then
    begin
      CI += L3;
      xlOp(xlSetCellStringValue('"___"_________ 20__', R + 1, CI, R + 1, CI), XE_SET_CELL_VALUE, '');
    end;
  end;

  // Завершает формирование формы и показывает сформированную форму
  procedure Done;
  begin
    if not IsAborted then
      _try
      begin
        // Выводим подписи
        /*
        // Так как в форме Валенты - слишком мало места для должности
        OutSign(1, 3, 4, 5, 'Ответственное лицо', 'Otvetstv', false); // Роль "Ответственный"
        OutSign(14, 7, 4, 7, 'Руководитель структурного подразделения', 'Direct', true); // Роль "Директор"
        R += 3;
        OutSign(14,  7, 4, 7, 'Работник кадровой службы', 'ProvLico', true); // Роль "Проверяющее лицо"
        R += 3;
        */
        /*
        OutSign(1, 5, 4, 5, 'Ответственное лицо', 'Otvetstv', false); // Роль "Ответственный"
        OutSign(16, 7, 4, 6, 'Руководитель структурного подразделения', 'Direct', true); // Роль "Директор"
        R += 3;
        OutSign(16,  7, 4, 6, 'Работник кадровой службы', 'ProvLico', true); // Роль "Проверяющее лицо"
        R += 3;
        */
        OutSign(1, 5, 3, 5, 'Ответственное лицо', 'Otvetstv', false); // Роль "Ответственный"
        OutSign(15, 9, 3, 6, 'Руководитель структурного подразделения', 'Direct', true); // Роль "Директор"
        R += 3;
        OutSign(15, 9, 3, 6, 'Работник кадровой службы', 'ProvLico', true); // Роль "Проверяющее лицо"
        R += 3;

        // Пока что макрос только скрывает Лист 1, если его не нужно формировать
        if (pSettings and ST_SHOW_LEGEND) = 0 then
        begin
          // Запускаем макрос
          RunMacro;
        end;
      end
      _except on ExOnExecelError:
      begin
        IsAborted := true;
      end;

    // Закрываем Excel и показываем форму и лог
    StopVisual('', 0);
    xlKillExcel;
    oGP_Log.Done(true);
  end;

  handleEvent
    cmOnVipLoad:
      begin
        pDBeg := ZeroDate;
        pDEnd := ZeroDate;
        pDepFilter := 'без учета подразделения';
      end;
  end;

end.
