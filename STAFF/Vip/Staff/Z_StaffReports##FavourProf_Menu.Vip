cmValue1:
  {
    if not InitWorkingTable // инициализируем табель
    {
      abort;
      exit;
    }

    if (RepYear = 0)
      {
      Message('Не заполнено поле "Отчетный год"', Information);
      abort;
      exit;
      }

    if (Period = 0) and ( wFormat > 1 )
      {
      Message('Не заполнено поле "Отчетный период"', Information);
      abort;
      exit;
      }

    if ( VInter.GetPsnCount = 0 )
      {
        VInter.SelectAllPsn;
        ReDrawPanel(CurTable);
      }

    VInter.StoreAllParams;
    VInter.IntClose(true);
    RunInterface('GP_Staff::FavourProfFR',   FavourProf_Menu(Self));
    DoneWorkingTable; // прибить табель

  }

cmCheckField:
  {
    inherited :: handleEvent (cmCheckField);
  }

cmOk:
  {
    inherited :: handleEvent (cmOk);
  }
    
end;
end.
