/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*                РПД № 42 "Перенос отпуска"                                                       *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Управление персоналом->Документы->Все приказы по персоналу->                     *
*                   Окно редактирования приказа =Приказ=->                                        *
*                   Контекстное меню <Печать групповой формы приказа>                             *
*                   Контекстное меню <Печать индивидуальной формы приказа>                        *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#167          |20/06/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
#include xlReport.vih
#include DeptIer.vih // получить всякие свойства по записи таблицы Catalogs
#include History.vih

Interface iEMTransferVacationReport 'РПД № 42 "Перенос отпуска"'  escclose, cyan, doaccept;
  Show at (, , 60, 8);
//*****************************************************************************
#include History.var
//*****************************************************************************
table struct tmpVacation
(
  NRec         : comp
, FIO          : string
, TabNum       : string
, NumDoc       : string
, DateDoc      : date
, Dol          : string
, Podr         : string
, VacationBeg  : date
, VacationEnd  : date
, VacationNum  : string
, VacationDate : date
, PeriodBeg    : date
, PeriodEnd    : date
, KolDays      : double
, NewBeg       : date
, NewEnd       : date
, cause1       : string
, cause2       : string
)
with index
(
  tmpVacation01 = NRec (Surrogate, Unique)
)
;

//******************************************************************************

Create view
var
  sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol   
, sPodpis1Npp
, sPodpis2Npp        : string;

  sNumDoc
, dDateDoc
, ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;

  cTitleDoc
, ContDocNrec        : comp; 

as select
  if ((Appointments.lPrizn = 0),  
       GetStrTabN(Persons.TabNmb, Persons.StrTabN), 
       GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN))
    (fieldname = fAppTabN)
, 8
    (FieldName = wType)
, 'Em_Report_' + string(wType)
    (FieldName = nameNastr)
, *
from 
  TitleDoc 
, PartDoc
, ContDoc
, Persons
, Vacations
, FactOtpusk ValFactOtp
, TitleDoc   TitleDocFO
, FactOtpusk NoFact
, WorkPeriod
, WorkPeriod ValWorkPeriod
, tmpVacation
, Appointments
, Catalogs    PostCat
, KatOrg
where
((
    ContDoc.Person         ==  Persons.NRec

AND ContDoc.ObjNrec        ==  Vacations.NRec
AND Vacations.cFactOtpusk  ==  NoFact.NRec
AND NoFact.cWorkPeriod     ==  WorkPeriod.NRec

AND ContDoc.cNew1          ==  ValFactOtp.nRec
AND ValFactOtp.cPrikaz     ==  TitleDocFO.NRec
AND ValFactOtp.cWorkPeriod ==  ValWorkPeriod.nRec

AND ContDoc.cStr           ==  Appointments.NRec
AND Appointments.Post      ==  PostCat.NRec

))

bounds byContDoc =
    ContDocNrec             ==  ContDoc.NRec
AND ContDoc.cPart           ==  PartDoc.NRec
AND PartDoc.cDoc            ==  TitleDoc.NRec


bounds byTitleDoc =
    cTitleDoc               ==  TitleDoc.NRec
AND TitleDoc.NRec           ==  PartDoc.cDoc
AND PartDoc.NRec            ==  ContDoc.cPart
AND 1                       ==  ContDoc.SeqNmb
;

Parameters
  sNumDoc
, dDateDoc
, cTitleDoc
, ContDocNrec
;
//*****************************************************************************
var IDepartIer: DepartIer; //иерархия подразделений
//*****************************************************************************
Procedure InitTable;
{
  _LOOP ContDoc
    { 
      ClearBuffer(#tmpVacation);
      tmpVacation.FIO          := Persons.FIO;
      tmpVacation.TabNum       := fAppTabN;
      tmpVacation.NumDoc       := TitleDoc.DocNmb;
      tmpVacation.DateDoc      := TitleDoc.DocDate;
      tmpVacation.Dol          := PostCat.Name;
      tmpVacation.Podr         := IDepartIer.GetFulDepName(ContDoc.cDopRef);
      tmpVacation.VacationBeg  := ContDoc.Dat1;
      tmpVacation.VacationEnd  := ContDoc.Dat2;

      if (ContDoc.wAttrDoc3 = 0)
        {
          if (GetFirst Vacations = tsOk)
            {
              tmpVacation.VacationDate  :=  Vacations.DocDate; 
              tmpVacation.VacationNum   :=  Vacations.FOUNDATION;
            }

          if (GetFirst WorkPeriod = tsOk)
            {
              tmpVacation.PeriodBeg := WorkPeriod.dPerBeg;
              tmpVacation.PeriodEnd := WorkPeriod.dPerEnd;
            }     
        }
      else
        {
          if (GetFirst ValFactOtp = tsOk)
            if (GetFirst TitleDocFO = tsOk)
              {                              
                tmpVacation.VacationDate := TitleDocFO.DocDate; 
                tmpVacation.VacationNum  := TitleDocFO.DocNmb;
              }                         

          if (GetFirst ValWorkperiod = tsOk)
            {
              tmpVacation.PeriodBeg := ValWorkperiod.dPerBeg;
              tmpVacation.PeriodEnd := ValWorkperiod.dPerEnd;
            }     
        }

      tmpVacation.KolDays      := ContDoc.WORDER;
      tmpVacation.NewBeg       := ContDoc.dPrik;
      tmpVacation.NewEnd       := _GetDate(_FromSec100(ContDoc.cCat2));
      tmpVacation.cause1       := ContDoc.sBottom;
      tmpVacation.cause2       := '';
      if (insert current tmpVacation = tsOk)
        {}
    }
}
//******************************************************************************
Procedure PrintLine;
{
   _LOOP tmpVacation
     if (Not NextVisual)
     {
       break; 
     }
     else   
     { 
       pXL.ClearTblBuffer;

       pXL.SetTblStringFldValue('FIO'           , tmpVacation.FIO);
       pXL.SetTblStringFldValue('TabNum'        , '''' + tmpVacation.TabNum);
       pXL.SetTblStringFldValue('NumDoc'        , '''' + tmpVacation.NumDoc);

       if (tmpVacation.DateDoc <> ZeroDate)
         pXL.SetTblStringFldValue('DateDoc'       , '''' + DateToStr(tmpVacation.DateDoc, 'DD.MM.YYYY'));

       pXL.SetTblStringFldValue('Dol'           , tmpVacation.Dol         );
       pXL.SetTblStringFldValue('Podr'          , tmpVacation.Podr        );

       if (tmpVacation.VacationBeg <> ZeroDate)
         pXL.SetTblStringFldValue('VacationBeg'   , '''' + DateToStr(tmpVacation.VacationBeg , 'DD.MM.YYYY'));

       if (tmpVacation.VacationEnd <> ZeroDate)
         pXL.SetTblStringFldValue('VacationEnd'   , '''' + DateToStr(tmpVacation.VacationEnd , 'DD.MM.YYYY'));

       if (tmpVacation.VacationDate <> ZeroDate)
         pXL.SetTblStringFldValue('VacationDate'  , '''' + DateToStr(tmpVacation.VacationDate, 'DD.MM.YYYY'));

       pXL.SetTblStringFldValue('VacationNum'   , tmpVacation.VacationNum );

       if (tmpVacation.PeriodBeg <> ZeroDate)
         pXL.SetTblStringFldValue('PeriodBeg'     , '''' + DateToStr(tmpVacation.PeriodBeg   , 'DD.MM.YYYY'));

       if (tmpVacation.PeriodEnd <> ZeroDate)
         pXL.SetTblStringFldValue('PeriodEnd'     , '''' + DateToStr(tmpVacation.PeriodEnd   , 'DD.MM.YYYY'));

       pXL.SetTblNumberFldValue('KolDays'       , tmpVacation.KolDays     );

       if (tmpVacation.NewBeg <> ZeroDate)
         pXL.SetTblStringFldValue('NewBeg'        , '''' + DateToStr(tmpVacation.NewBeg      , 'DD.MM.YYYY'));

       if (tmpVacation.NewEnd <> ZeroDate)
         pXL.SetTblStringFldValue('NewEnd'        , '''' + DateToStr(tmpVacation.NewEnd      , 'DD.MM.YYYY'));

       pXL.SetTblStringFldValue('cause1'        , tmpVacation.cause1      );
       pXL.SetTblStringFldValue('Text'          , 'Перенести отпуск представленный ранее с ' + if (tmpVacation.VacationBeg <> ZeroDate, DateToStr(tmpVacation.VacationBeg, 'DD.MM.YYYY'), '')
                                        + ' по ' + if (tmpVacation.VacationEnd <> ZeroDate, DateToStr(tmpVacation.VacationEnd, 'DD.MM.YYYY'),'') +' (приказ от ' + tmpVacation.VacationNum
                                        + ' №' + if (tmpVacation.VacationDate <> ZeroDate, DateToStr(tmpVacation.VacationDate, 'DD.MM.YYYY'),'') + '), за период с ' + if (tmpVacation.PeriodBeg <> ZeroDate, DateToStr(tmpVacation.PeriodBeg, 'DD.MM.YYYY'), '')
                                        + ' по ' + if (tmpVacation.PeriodEnd <> ZeroDate, DateToStr(tmpVacation.PeriodEnd, 'DD.MM.YYYY'),'')  + ', на ' + string(tmpVacation.KolDays) 
                                        + ' календарных дней, на даты с ' + if (tmpVacation.NewBeg <> ZeroDate, DateToStr(tmpVacation.NewBeg, 'DD.MM.YYYY'), '') + ' по ' + if (tmpVacation.NewEnd <> ZeroDate, DateToStr(tmpVacation.NewEnd, 'DD.MM.YYYY'), '') + '.');

       pXL.InsTblRow;                     
     }
}

//*****************************************************************************
Procedure PrintRepost;
{
  ID := 'TransferVacation';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpVacation));

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'           , CommonFormHeader);
  pXL.SetStringVar('org'           , oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', Cur_Date));
  if (GetFirst KatOrg where ((coGetTune('MyOrg') == KatOrg.NRec)) = tsOk)
    pXL.SetStringVar('OKPO'        , '''' + KatOrg.Okpo);

  pXL.SetStringVar('SoglFIO'       , sSogls);
  pXL.SetStringVar('SoglDol'       , sSoglsDol);
  pXL.SetStringVar('Sogl2FIO'      , sSogls2);
  pXL.SetStringVar('Sogl2Dol'      , sSogls2Dol);
  pXL.SetStringVar('UtvrFIO'       , sUtve);
  pXL.SetStringVar('UtvrDol'       , sUtveDol);
  pXL.SetStringVar('sPodpis1FIO'   , sPodpis1);
  pXL.SetStringVar('sPodpis1Dol'   , sPodpis1Dol);
  pXL.SetStringVar('sPodpis2FIO'   , sPodpis2);
  pXL.SetStringVar('sPodpis2Dol'   , sPodpis2Dol);

  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('TransferVacation');
  pXL.CreateTblFld('FIO'         );  
  pXL.CreateTblFld('TabNum'      );
  pXL.CreateTblFld('NumDoc'      );
  pXL.CreateTblFld('DateDoc'     );
  pXL.CreateTblFld('Dol'         );
  pXL.CreateTblFld('Podr'        );
  pXL.CreateTblFld('VacationBeg' );
  pXL.CreateTblFld('VacationEnd' );
  pXL.CreateTblFld('VacationNum' );
  pXL.CreateTblFld('VacationDate');
  pXL.CreateTblFld('PeriodBeg'   );
  pXL.CreateTblFld('PeriodEnd'   );
  pXL.CreateTblFld('KolDays'     );
  pXL.CreateTblFld('NewBeg'      );
  pXL.CreateTblFld('NewEnd'      );
  pXL.CreateTblFld('cause1'      );
  pXL.CreateTblFld('cause2'      );
  pXL.CreateTblFld('Text'        );

  PrintLine;

  pXL.PublishTbl('TransferVacation');

  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);
}

HandleEvent

cmInit: 
  {
    RunInterface(iEMGetNastrPodp, wType);

    if (NOT ReadMyDsk(sSogls     , nameNastr + '_sSogls', true))
      sSogls := '';

    if (NOT ReadMyDsk(sSoglsDol  , nameNastr + '_sSoglsDol', true))
      sSoglsDol := '';

    if (NOT ReadMyDsk(sSogls2    , nameNastr + '_sSogls2', true))
      sSogls2 := '';

    if (NOT ReadMyDsk(sSogls2Dol , nameNastr + '_sSogls2Dol', true))
      sSogls2Dol := '';

    if (NOT ReadMyDsk(sUtve      , nameNastr + '_sUtve', true))
      sUtve := '';

    if (NOT ReadMyDsk(sUtveDol   , nameNastr + '_sUtveDol', true))
      sUtveDol := '';

    if (NOT ReadMyDsk(sPodpis2   , nameNastr + '_sPodpis2', true))
      sPodpis2 := '';

    if (NOT ReadMyDsk(sPodpis2Dol, nameNastr + '_sPodpis2Dol', true))
      sPodpis2Dol := '';

    if (NOT ReadMyDsk(sPodpis2Npp, nameNastr + '_sPodpis2Npp', true))
      sPodpis2Npp := '';

    if (NOT ReadMyDsk(sPodpis1   , nameNastr + '_sPodpis1', true))
      sPodpis1 := '';

    if (NOT ReadMyDsk(sPodpis1Dol, nameNastr + '_sPodpis1Dol', true))
      sPodpis1Dol := '';

    if (NOT ReadMyDsk(sPodpis1Npp, nameNastr + '_sPodpis1Npp', true))
      sPodpis1Npp := '';

    PushBounds(if (ContDocNrec <> comp(0), tbbyContDoc, tbbyTitleDoc));
    InitTable;
    PrintRepost;
  }

end;
end.
