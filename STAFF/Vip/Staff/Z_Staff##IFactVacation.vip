/*************************************************************************************************\
  Наименование:  Объект работы с фактическими отпусками сотрудников
  Контур/Модуль: Управление персоналом
  Примечание: Скрыта колонка "Рабочий период пакета отпусков"
  Вид работы  |Номер           |Дата    |Исполнитель              |Проект
  -----------------------------------------------------------------------------------------------
  Разработка  |#0000           |02/10/18|Евдокимов М.А.           |НПО Энергомаш
\************************************************************************************************/

#component "Z_Staff"

alter interface IFactVacation;

handleevent

  cmInit:
  {
    if inherited::handleevent(cmInit) = heAbort
      Abort;
    ClearFieldState(#fWorkPeriod, sfVisible);
  }

  cmOnVipLoad:
  {
    case inherited::handleevent(cmOnVipLoad) of
      heAbort: Abort;
      heStop: Stop;
    end;
    ClearFieldState(#fWorkPeriod, sfVisible);
  }

end;

end.
