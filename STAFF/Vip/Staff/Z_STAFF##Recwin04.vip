ExtendFormats scrPersons4;
screen scrPersons4;
  table tmpPersons;
Fields
  [datvvod0] dGetAttr(25001,tmpPersons.nrec,'Дата ввода') ('Сведения действуют с',,)  : NoProtect;
  Buttons
  cmValue7,[singleLine],,,'История семейного пеоложения';
<<


      Сведения действуют с .@@@@@@@@@@@@     <.История.>
>>
end; // scrPersons4


ExtendFormats brwPsnLinks;
browse brwPsnLinks;
  table PsnLinks;
Fields
  [datvvod1] dGetAttr(25005,PsnLinks.nrec,'Дата ввода') 'Сведения действуют с'  : [10], NoProtect;

end;


Handleevent
cmOnVipLoad:
{
   if (wGetTune('UP.FAKELGAL.FAKEL') = 0) then
  {
    cfsSetExtProp('T_SCRPERSONS4_Сведения_действуют_с', 'Visible', false);
    cfsSetExtProp('i_SCRPERSONS4_DATVVOD0', 'Visible', false);
    cfsSetExtProp('b_SCRPERSONS4_История', 'Visible', false);
    cfsSetExtProp('c_BRWPSNLINKS_DATVVOD1_Сведения_действуют_с', 'Visible', false);
  }

  case inherited :: handleEvent (cmOnVipLoad) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
}
cmStaffSeeDopInfo:
{
  putcommand(cmValue68);
}
cmValue68:
{ pGP_File_hRef.InitParam(
   if(false,cgiNotEdit,0)   //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
                // Если документ только на чтение следует вызвать cgiNotEdit
  ,coPersons //_wTable    : word; указать код таблицы документа системы
  ,tmpPersons.Nrec //_cRec      : comp=0;   // указать поле в таблице
  ,1 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
  ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
    ,'Файлы по сотруднику ' + Persons.fio
   );
}
cmExprFieldChanged:
{
  case inherited :: handleEvent (cmExprFieldChanged) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
  var d0,d1:date;
  case CurField of
    #datvvod0:
    {
      d0:=StrToDate(ExprFieldValue,'DD/MM/YYYY');
      dsetAttr(25001,tmpPersons.nrec,'Дата ввода', d0);
    }
    #datvvod1:
    {
      d1:=StrToDate(ExprFieldValue,'DD/MM/YYYY');
      dsetAttr(25005,PsnLinks.nrec,'Дата ввода', d1);
    }
  end;
}

cmValue7:
{
  RunInterface('Recwin04_history',persons.nrec);
}
cmPick:
{
  var ParentSav: comp = 0; // NRec каталога при вызове интерфейса выбора
  var famstat:string;
  var persnrec:comp;
  case CurField of

    #FamilyStateCat.Name:
    {
      ReReadRecord(tnPersons);
      ParentSav := Persons.FamilyState;
      if (RunInterface('PickCatalog2', -8, ParentSav, 0) = cmDefault)
      {
        Persons.FamilyState := ParentSav;
        update current Persons;
        dsetAttr(25001,Persons.nrec,'Дата ввода', cur_date);
        ReReadRecord(tntmpPersons);
        if wGetTune('UP.FakelGAL.Fakel') = 1
       {
        famstat:=FamilyStateCat.Name;
        persnrec:=persons.nrec;
        histwin.insert euh set euh.wtype:=word(777),
                               euh.wparenttable:=word(25001),
                               euh.cparentdoc:=persnrec,//,
                               euh.adddate[1]:=cur_date,
                               euh.addstring[1]:=famstat;
       }

      }
    }

    #PsnLinksTypeCat.Name:
    {
      ParentSav := PsnLinks.LinkType;
      if (RunInterface('PickCatalog2', -16, ParentSav, 0) = cmDefault)
      {
        set PsnLinks.LinkType := ParentSav;
        PsnLinks.wPrizn3 := SetChildNum(tmpPersons.Nrec, PsnLinks.LinkType, PsnLinks.wPrizn3);
        PsnLinks.CRez1 := GetRodstvoLink(PsnLinks.LinkType, Persons.Sex);

        RescanPanel(tnPsnLinks);

        if (PsnLinks.RBornDate <> ZeroDate)
          PutCommand(cmValue4);

        UpdateTableWithInserted;
        SyncData(PsnLinks.NRec, PsnLinks.FromPerson, PsnLinks.ToPerson, PsnLinks.LinkType, iCatFunc.GetSysCode(PsnLinks.LinkType)); // общие дети
      }
      PD.CreateTableCatChildren();
    }

    #PsnLinksRodSv.Name,
    #fLinksRodSv:
    {
      ParentSav := PsnLinks.CRez1;
      if (RunInterface('PickCatalog2', 1500, ParentSav, 0) = cmDefault)
      {
        set PsnLinks.CRez1 := ParentSav;
        UpdateTableWithInserted;
        PD.SetStatus(PsnLinks.NRec);
        if (wGetTune('COUNTRY') <> ccRus)
          PD.SetLgotaNew2(Persons.NRec);
        if PsnLinks.RBornDate <> ZeroDate and PsnLinks.LinkType <> 0
          ReReadRecord(#PsnLinks);
        SetVisibleFields();
      }
    }

    #LPLivName:
    {
      ParentSav := PsnLinks.RPassAddr;
      strAddrTitle := 'Место проживания ' + PsnLinks.RFIO;
      RunInterface('AddressWinN', strAddrTitle, ParentSav, 6, PsnLinks.NRec);
      set PsnLinks.RPassAddr := ParentSav;
      UpdateTableWithInserted;
      ReDrawPanel(tnPsnLinks);
    }

    #PsnLinks.RFIO:
    {
      if (PsnLinks.LinkType = 0)
      {
        message('Не задана родственная связь!', Warning);
        abort;
        exit;
      }

      var wK: word = 0;
      var DummyMarker1, DummyMarker2: TPtr = 0;

      DummyMarker1 := InitMarker('', 8, 1, 1);
      DummyMarker2 := InitMarker('', 8, 1, 1);

      ParentSav := PsnLinks.ToPerson;

      if (viCYPersons.Choice(DummyMarker1, 1, vfCanSelect, wK, ParentSav, DummyMarker2))
      {
         PsnLinks.ToPerson := vWorkPsnLinks.cPers := viCYPersons.GetPsnByKindChoice(wK, ParentSav);

         if (vWorkPsnLinks.GetFirst Persons = tsOk)
         {
           PsnLinks.RFIO := vWorkPsnLinks.Persons.FIO;
           set PsnLinks.RBornDate := vWorkPsnLinks.Persons.BornDate;
           UpdateTableWithInserted;
           SyncData(PsnLinks.NRec, PsnLinks.FromPerson, PsnLinks.ToPerson, PsnLinks.LinkType, iCatFunc.GetSysCode(PsnLinks.LinkType)); // общие дети
         }
      }

      DoneMarker(DummyMarker1, '');
      DoneMarker(DummyMarker2, '');

      SetVisibleFields();
    }

    #fSex:
    {
      case PsnLinks.Nmb4 of

        0, 2: set PsnLinks.Nmb4 := 1;

        1: set PsnLinks.Nmb4 := 2;

      end;

      UpdateTableWithInserted;
    }

    #fOneParrent:
    {
      case PsnLinks.wPrizn2 of

        0: set PsnLinks.wPrizn2 := 1;

        1: set PsnLinks.wPrizn2 := 0;

      end;

      UpdateTableWithInserted;
    }

  end;  // case
} // end cmPick

end;
end.

object 'Z_STAFF::RECWIN04' : InterfaceWindow {
  ScriptFontSize = 10;
  ScriptFontFace = 'Calibri';
  EmbName = 'Z_STAFF::RECEPTIONMAIN->';
  object BRWPSNLINKS : Browser {
    ViewFlags = 6;
    RowColorDark = 10;
    VerDelimiterWidth = 1;
    object 'c_BRWPSNLINKS_PSNLINKS.STR1_Прим.' : Column {
      DefaultPickButton = True;
    } // c_BRWPSNLINKS_PSNLINKS.STR1_Прим. : Column
    // Информация: объект "'ExtAttr: PSNLINKS,2814749767107975'" типа Column не найден в базовой конфигурации!
    object 'ExtAttr: PSNLINKS,2814749767107975' : Column {
      Original = False;
      Visible = True;
      Hidden = False;
      Protect = False;
      Skip = False;
      StatusCtx = 150;
      Title = 'Родственник в ЭМ';
      FieldName = 'ExtAttr: PSNLINKS,2814749767107975,5,25001,3,0,Родственник в ЭМ';
      DefaultValue = '';
      Index = 8;
      DefaultWidth = 26;
      DefaultPickButton = True;
      PassiveFormat = '';
      HeaderAlign = 3;
    } // ExtAttr: PSNLINKS,2814749767107975 : Column
  } // BRWPSNLINKS : Browser
} // Z_STAFF::RECWIN04 : InterfaceWindow
