#include GetKau.Vih

#include GP_File_hRef.Vih


#component "Z_Staff"
alter interface Recwin04;

#include GetKau.Var
#include GP_File_hRef.Vpp

CReate view histwin
 as select *
from em_unidoc_head euh
;
