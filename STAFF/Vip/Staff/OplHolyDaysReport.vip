/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*                РПД № 90 "Работа в выходные и праздничные дни"                                   *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Управление персоналом->Документы->Все приказы по персоналу->                     *
*                   Окно редактирования приказа =Приказ=->                                        *
*                   Контекстное меню <Печать индивидуальной формы приказа>                        *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#168          |26/06/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
#include xlReport.vih
#include DeptIer.vih // получить всякие свойства по записи таблицы Catalogs
#include History.vih

Interface iEMOplHolyDaysReport 'РПД № 90 "Работа в выходные и праздничные дни"'  escclose, cyan, doaccept;
  Show at (, , 60, 8);
//*****************************************************************************
#include History.var
//*****************************************************************************
table struct tmpHolydays
(
  NRec         : comp
, cPers        : comp
, FIO          : string
, TabNum       : string
, NumDoc       : string
, DateDoc      : date
, Dol          : string
, Podr         : string
, Holyday      : string
, Hours        : word
, NightHours   : word
, NightEvening : word
, Condition    : string
, cause        : string
)
with index
(
  tmpHolydays01 = NRec (Surrogate, Unique)
)
;
//*****************************************************************************
table struct tmpDays
(
  cDay         : comp
, DateDoc      : date
)
with index
(
  tmpDays01 = cDay + DateDoc
)
;

//******************************************************************************

Create view
var
  sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol
, sPodpis1Npp
, sPodpis2Npp
, s4Dol
, s4Fio
, s5Dol
, s5Fio
, s51Dol
, s51Fio
, s52Dol
, s52Fio            : string;

  wHours       
, wNightHours  
, wNightEvening      : word;


  sHolyday     
, sCondition   
, scause       
, sNumDoc
, dDateDoc
, ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;

  cTitleDoc
, ContDocNrec        : comp; 
as select
  if ((Appointments.lPrizn = 0),  
       GetStrTabN(Persons.TabNmb, Persons.StrTabN), 
       GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN))
    (FieldName = fAppTabN)
, 12
    (FieldName = wType)
, 'Em_Report_' + string(wType)
    (FieldName = nameNastr)
, *
from 
  TitleDoc 
, PartDoc
, ContDoc
, Persons
, tmpHolydays
, Appointments
, Vacations
, KlOtpusk OsnKlOtpusk
, Catalogs    PostCat
, KatOrg
, SalScale
, sTerr
, tmpDays
, AddressN
where
((
    ContDoc.Person         ==  Persons.NRec
AND ContDoc.cStr           ==  Appointments.NRec
AND Appointments.Post      ==  PostCat.NRec

AND ContDoc.ObjNrec        ==  Vacations.NRec
AND Vacations.VacType      ==  OsnKlOtpusk.NRec

AND coGetTune('MyOrg')     == KatOrg.NRec

AND 0                      == SalScale.wTblCode
AND ContDoc.NRec           == SalScale.cUnit

))

bounds byContDoc =
    ContDocNrec             ==  ContDoc.NRec
AND ContDoc.cPart           ==  PartDoc.NRec
AND PartDoc.cDoc            ==  TitleDoc.NRec


bounds byTitleDoc =
    cTitleDoc               ==  TitleDoc.NRec
AND TitleDoc.NRec           ==  PartDoc.cDoc
AND PartDoc.NRec            ==  ContDoc.cPart
AND 1                       ==  ContDoc.SeqNmb


;

Parameters
  sNumDoc
, dDateDoc
, cTitleDoc
, ContDocNrec
;
//*****************************************************************************
var IDepartIer : DepartIer;  // иерархия подразделений
//*****************************************************************************
Procedure InitTable;
{
  var i : word; i := 0;

  _LOOP ContDoc
    { 
      ClearBuffer(#tmpHolydays);
      tmpHolydays.NRec         := GetNextNRec(#tmpHolydays, 0);
      tmpHolydays.cPers        := Persons.NRec;
      tmpHolydays.FIO          := Persons.FIO;
      tmpHolydays.TabNum       := fAppTabN;
      tmpHolydays.NumDoc       := TitleDoc.DocNmb;
      tmpHolydays.DateDoc      := TitleDoc.DocDate;
      tmpHolydays.Dol          := PostCat.Name;
      tmpHolydays.Podr         := IDepartIer.GetFulDepName(ContDoc.cDopRef);
      tmpHolydays.cause        := ContDoc.SBottom;

      _LOOP SalScale
        {
          if (GetFirst tmpDays where ((tmpHolydays.NRec  == tmpDays.cDay
                                   AND SalScale.LastDate == tmpDays.DateDoc)) <> tsOk)
            {
              ClearBuffer(#tmpDays);
              tmpDays.cDay    := tmpHolydays.NRec;
              tmpDays.DateDoc := SalScale.LastDate;
              if (insert current tmpDays = tsOk)
                {}
            }
          if (GetFirst tmpDays where ((comp(0)           == tmpDays.cDay
                                   AND SalScale.LastDate == tmpDays.DateDoc)) <> tsOk)
            {
              ClearBuffer(#tmpDays);
              tmpDays.cDay    := comp(0);
              tmpDays.DateDoc := SalScale.LastDate;
              if (insert current tmpDays = tsOk)
                {}
            }

          tmpHolydays.Hours        := if (tmpHolydays.Hours        < SalScale.fSum0, word(SalScale.fSum0), tmpHolydays.Hours       );
          tmpHolydays.NightHours   := if (tmpHolydays.NightHours   < SalScale.fMin , word(SalScale.fMin ), tmpHolydays.NightHours  );
          tmpHolydays.NightEvening := if (tmpHolydays.NightEvening < SalScale.fMax , word(SalScale.fMax ), tmpHolydays.NightEvening);
        }

      _LOOP backward tmpDays where ((tmpHolydays.NRec  == tmpDays.cDay)) ordered by tmpDays.DateDoc
        {
          inc(i);
          if (i = 1)
            {
              tmpHolydays.Holyday := if (tmpDays.DateDoc <> ZeroDate, DateToStr(tmpDays.DateDoc, 'DD.MM.YYYY'), '');
            } 
          else if (i = 2)
            {
              tmpHolydays.Holyday := if (tmpDays.DateDoc <> ZeroDate, DateToStr(tmpDays.DateDoc, 'DD.MM.YYYY'), '') + ' и ' + tmpHolydays.Holyday;
            } 
          else
            {
              tmpHolydays.Holyday := if (tmpDays.DateDoc <> ZeroDate, DateToStr(tmpDays.DateDoc, 'DD.MM.YYYY'), '') + ', ' + tmpHolydays.Holyday;
            } 
        }    

      if (insert current tmpHolydays = tsOk)
        {
          wHours        := if (tmpHolydays.Hours        < wHours       , wHours       , tmpHolydays.Hours       );
          wNightHours   := if (tmpHolydays.NightHours   < wNightHours  , wNightHours  , tmpHolydays.NightHours  );
          wNightEvening := if (tmpHolydays.NightEvening < wNightEvening, wNightEvening, tmpHolydays.NightEvening);
        }  
    }

  i := 0;
  _LOOP backward  tmpDays where ((comp(0)  == tmpDays.cDay)) ordered by tmpDays.DateDoc
    {
      inc(i);
      if (i = 1)
        {
          sHolyday := if (tmpDays.DateDoc <> ZeroDate, DateToStr(tmpDays.DateDoc, 'DD.MM.YYYY'), '');
        } 
      else if (i = 2)
        {
          sHolyday := if (tmpDays.DateDoc <> ZeroDate, DateToStr(tmpDays.DateDoc, 'DD.MM.YYYY'), '') + ' и ' + sHolyday;
        } 
      else
        {
          sHolyday := if (tmpDays.DateDoc <> ZeroDate, DateToStr(tmpDays.DateDoc, 'DD.MM.YYYY'), '') + ', ' + sHolyday;
        } 
    }    
}
//******************************************************************************
Procedure PrintLine;
{
   _LOOP tmpHolydays
     if (Not NextVisual)
     {
       break; 
     }
     else   
     { 
       pXL.ClearTblBuffer;
                                 
       pXL.SetTblStringFldValue('FIO'         , tmpHolydays.FIO);
       pXL.SetTblStringFldValue('TabNum'      , '''' + tmpHolydays.TabNum);                                            
       pXL.SetTblStringFldValue('NumDoc'      , '''' + tmpHolydays.NumDoc);                                            
       if (tmpHolydays.DateDoc <> ZeroDate) 
         pXL.SetTblStringFldValue('DateDoc'     , '''' + DateToStr(tmpHolydays.DateDoc, 'DD.MM.YYYY'));                                             
       pXL.SetTblStringFldValue('Dol'         , tmpHolydays.Dol );
       pXL.SetTblStringFldValue('Podr'        , tmpHolydays.Podr);
       pXL.SetTblStringFldValue('Holyday'     , tmpHolydays.Holyday);
       pXL.SetTblNumberFldValue('Hours'       , tmpHolydays.Hours       );
       pXL.SetTblNumberFldValue('NightHours  ', tmpHolydays.NightHours  );
       pXL.SetTblNumberFldValue('NightEvening', tmpHolydays.NightEvening);
       //pXL.SetTblNumberFldValue('Condition'      , tmpHolydays.dHours);
       pXL.SetTblStringFldValue('cause'       , tmpHolydays.cause );
       pXL.InsTblRow;                     
     }
}

//*****************************************************************************
Procedure PrintRepost;
{
  ID := 'OplHolyDays';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpHolydays));

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'           , CommonFormHeader);

  var sNameCity : string; sNameCity := '';
  pXL.SetStringVar('org'           , oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', tmpHolydays.DateDoc));
  if (GetFirst KatOrg = tsOk)
    { 
      pXL.SetStringVar('OKPO'        , '''' + KatOrg.Okpo);

      if (KatOrg.cJuridicalAddr <> comp(0))
        if (GetFirst AddressN where ((KatOrg.cJuridicalAddr == AddressN.NRec)) = tsOk)
          {
            var nrecTerr : comp; nrecTerr := if (AddressN.cStreet <> comp(0), AddressN.cStreet, AddressN.cSterr);
            while (GetFirst sTerr where (( nrecTerr == sTerr.NRec )) = tsOk)
              {
                if (sTerr.wType = atdeCity)
                  sNameCity := 'г. ' + sTerr.sName + if (Trim(sNameCity) = '', '', ', ' + sNameCity); 
                else if (sTerr.wType = atdeOblast OR sTerr.wType = atdeRegion)
                  sNameCity := sNameCity + if (Trim(sNameCity) = '', '', ', ') + sTerr.sName;
                nrecTerr := sTerr.cParent;
              }
          }
    }

  pXL.SetStringVar('Num'           , '''' + tmpHolydays.NumDoc);
  if (tmpHolydays.DateDoc <> ZeroDate) 
    pXL.SetStringVar('Date'          , '''' + DateToStr(tmpHolydays.DateDoc, 'DD.MM.YYYY'));
  pXL.SetStringVar('City'          , sNameCity);
  pXL.SetStringVar('Holydays'      , sHolyday);
  pXL.SetStringVar('Hours'         , wHours);
  pXL.SetStringVar('DateSogl'      , '');

  pXL.SetStringVar('SoglFIO'       , sSogls);
  pXL.SetStringVar('SoglDol'       , sSoglsDol);
  pXL.SetStringVar('Sogl2FIO'      , sSogls2);
  pXL.SetStringVar('Sogl2Dol'      , sSogls2Dol);
  pXL.SetStringVar('UtvrFIO'       , sUtve);
  pXL.SetStringVar('UtvrDol'       , sUtveDol);
  pXL.SetStringVar('sPodpis1FIO'   , sPodpis1);
  pXL.SetStringVar('sPodpis1Dol'   , sPodpis1Dol);
  pXL.SetStringVar('sPodpis2FIO'   , sPodpis2);
  pXL.SetStringVar('sPodpis2Dol'   , sPodpis2Dol);

  if (GetFirst tmpDays where ((tmpHolydays.NRec  == tmpDays.cDay)) ordered by tmpDays.DateDoc = tsOk)
    if (tmpDays.DateDoc <> ZeroDate)  
      pXL.SetStringVar('dSrok', '''' + DateToStr(Sub_Day(tmpDays.DateDoc, 1), 'DD.MM.YYYY'));        

  pXL.SetStringVar('s4Dol'         , s4Dol );
  pXL.SetStringVar('s4Fio'         , s4Fio );
  pXL.SetStringVar('s5Dol'         , s5Dol );
  pXL.SetStringVar('s5Fio'         , s5Fio );
  pXL.SetStringVar('s51Dol'        , s51Dol);
  pXL.SetStringVar('s51Fio'        , s51Fio);
  pXL.SetStringVar('s52Dol'        , s52Dol);
  pXL.SetStringVar('s52Fio'        , s52Fio);


  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('OplHolyDays');
  pXL.CreateTblFld('cPers');
  pXL.CreateTblFld('FIO');
  pXL.CreateTblFld('TabNum');
  pXL.CreateTblFld('NumDoc');
  pXL.CreateTblFld('DateDoc');
  pXL.CreateTblFld('Dol');
  pXL.CreateTblFld('Podr' );
  pXL.CreateTblFld('Holyday');
  pXL.CreateTblFld('Hours');
  pXL.CreateTblFld('NightHours');
  pXL.CreateTblFld('NightEvening');
  pXL.CreateTblFld('Condition');       
  pXL.CreateTblFld('cause');       
  PrintLine;

  pXL.PublishTbl('OplHolyDays');

  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);
}

HandleEvent

cmInit: 
  {                         
    RunInterface(iEMGetNastrPodp, wType);

    if (NOT ReadMyDsk(sSogls     , nameNastr + '_sSogls', true))
      sSogls := '';

    if (NOT ReadMyDsk(sSoglsDol  , nameNastr + '_sSoglsDol', true))
      sSoglsDol := '';

    if (NOT ReadMyDsk(sSogls2    , nameNastr + '_sSogls2', true))
      sSogls2 := '';

    if (NOT ReadMyDsk(sSogls2Dol , nameNastr + '_sSogls2Dol', true))
      sSogls2Dol := '';

    if (NOT ReadMyDsk(sUtve      , nameNastr + '_sUtve', true))
      sUtve := '';

    if (NOT ReadMyDsk(sUtveDol   , nameNastr + '_sUtveDol', true))
      sUtveDol := '';

    if (NOT ReadMyDsk(sPodpis2   , nameNastr + '_sPodpis2', true))
      sPodpis2 := '';

    if (NOT ReadMyDsk(sPodpis2Dol, nameNastr + '_sPodpis2Dol', true))
      sPodpis2Dol := '';

    if (NOT ReadMyDsk(sPodpis2Npp, nameNastr + '_sPodpis2Npp', true))
      sPodpis2Npp := '';

    if (NOT ReadMyDsk(sPodpis1   , nameNastr + '_sPodpis1', true))
      sPodpis1 := '';

    if (NOT ReadMyDsk(sPodpis1Dol, nameNastr + '_sPodpis1Dol', true))
      sPodpis1Dol := '';

    if (NOT ReadMyDsk(sPodpis1Npp, nameNastr + '_sPodpis1Npp', true))
      sPodpis1Npp := '';

    if (NOT ReadMyDsk(s4Fio      , nameNastr + '_sZamDirD', true))
      s4Fio := '';

    if (NOT ReadMyDsk(s4Dol      , nameNastr + '_sZamDirDolD', true))
      s4Dol := '';

    if (NOT ReadMyDsk(s5Fio      , nameNastr + '_sSoglsOsnD', true))
      s5Fio := '';

    if (NOT ReadMyDsk(s5Dol      , nameNastr + '_sSoglsOsnDolD', true))
      s5Dol := '';

    if (NOT ReadMyDsk(s51Fio    , nameNastr + '_sOtvD', true))
      s51Fio := '';

    if (NOT ReadMyDsk(s51Dol , nameNastr + '_sOtvDolD', true))
      s51Dol := '';

    if (NOT ReadMyDsk(s52Fio    , nameNastr + '_sMainBuhD', true))
      s52Fio := '';

    if (NOT ReadMyDsk(s52Dol , nameNastr + '_sMainBuhDolD', true))
      s52Dol := '';

    PushBounds(if (ContDocNrec <> comp(0), tbbyContDoc, tbbyTitleDoc));
    InitTable;
    PrintRepost;
  }

end;
end.
