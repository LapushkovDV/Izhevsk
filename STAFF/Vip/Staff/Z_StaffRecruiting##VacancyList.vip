var IsRunFromInit:boolean;
    iQBuilder:GP_QueryBuilder new;
    UDL: IUserDepartmentsList(UserDepartmentsIterator);
    DepAccessMarker:TPtr;
    ManualNotesStaffStr:GP_ObjManualNotes(GP_ManualNotes) New;
    _dataSetCounter: longint;
   _log : string = '';
table struct TreeStaffStruct(
  NRec:comp,cNode:comp,IsLeaf:word,
  cDep:comp,cStaffStruct:comp,
  DepName:string,DepCode:string,PostName:string,WorkCond:string,
  WorkStations  : double,
  Workers       : double, // кол-во вакансий
  Status        : byte, // является ли ставка замещаемой по конкурсу
  FutureWorkers : double,
  TaxRate:double,MinSumma:double,MaxSumma:double
)
with index (
  i1=NRec(Surrogate,Unique),
  i2=cNode+DepCode,
  i3=cDep+IsLeaf
);

create view vVacancyList
var cTreeNode:comp;
from
   UDL, ManualNotesStaffStr
  ,TreeStaffStruct(i2)
  ,TreeStaffStruct TreeStaffStruct2
  ,Catalogs IerCatDep
  ,StaffStruct StaffStructExt
  ,KlKatego
where((
  cTreeNode                    == TreeStaffStruct.cNode and
  coStaffStruct                == ManualNotesStaffStr.wTbl and
  TreeStaffStruct.cStaffStruct == ManualNotesStaffStr.cRec and
  TreeStaffStruct.cStaffStruct == StaffStructExt.Nrec and
  StaffStructExt.EmpCategory   == KlKatego.Nrec
));

create view vGetTopPodr
var
  _catDepNrec: comp;
as select catDep.Nrec
from catalogs catDep, catalogs catDepParent
where ((
  _catDepNrec == catDep.Nrec and
  catDep.cParent == catDepParent.Nrec
));

function GetTopPodrCode(aCatDepNrec: comp): string; cacheable;
{
  result := '';
  vGetTopPodr._catDepNrec := aCatDepNrec;
  if vGetTopPodr.getfirst catDep = tsOk
  {
    result := vGetTopPodr.catDep.Code;
    if length(vGetTopPodr.catDep.Code) > 3
      if vGetTopPodr.getfirst catDepParent = tsOk
        if vGetTopPodr.catDepParent.SysCode != -11
          result := GetTopPodrCode(vGetTopPodr.catDepParent.Nrec);
  }
}

function GetTopPodrName(aCatDepNrec: comp): string; cacheable;
{
  result := '';
  vGetTopPodr._catDepNrec := aCatDepNrec;
  if vGetTopPodr.getfirst catDep = tsOk
  {
    result := vGetTopPodr.catDep.Name;
    if length(vGetTopPodr.catDep.Code) > 3
      if vGetTopPodr.getfirst catDepParent = tsOk
        if vGetTopPodr.catDepParent.SysCode != -11
          result := GetTopPodrName(vGetTopPodr.catDepParent.Nrec);
  }
}

Function IsExistLogOtpusk(_cStaffStruct : comp) : string;
{
var _iIStafStruLongVac     : StaffStruct; //ШР
 Result := '';
 //logstrtofile('Zekka.log', '_cStaffStruct = ' + _cStaffStruct);
 //logstrtofile('Zekka.log', 'dateCondition = ' + dateCondition);
/// logstrtofile('Zekka.log', 'Appointments.StaffStr = ' + Appointments.StaffStr);
  _loop Appointments where ((_cStaffStruct == Appointments.StaffStr))
   {
   // logstrtofile('Zekka.log', '_cStaffStruct_loop = ' + _cStaffStruct);
  //    logstrtofile('Zekka.log', 'Appointments.nrec = ' + Appointments.nrec);
  //    logstrtofile('Zekka.log', 'Appointments.StaffStr = ' + Appointments.StaffStr);
    if _iIStafStruLongVac.GetLongVacationByDate(Appointments.nrec, dateCondition) <> 0
     {
    //   logstrtofile('Zekka.log', 'Result = ' + Result);
       Result := '+' ;
