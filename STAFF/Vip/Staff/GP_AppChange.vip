/*************************************************************************************************\
* Наименование:  Функция вычисления - менялось ли назначение в течение периода до указанной даты  *
*                Разработка отчетов в рамках Процесса #210                                        *
* Контур/Модуль: Кадры                                                                            *
* Примечание:    Отчеты пользователя                                                              *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#             |08/06/17|Потапов А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include GP_AppChange.vih

Interface GP_AppChange;

create view
from
  appointments
, contdoc
;

function State(cPerson, cSelfAppoint : comp; dDate : date; iMonths : integer) : string;
Var
  cCoDoc : comp;
{
  result := '';
  _loop appointments where
  ((          cPerson == appointments.PERSON
  and sub_Months(dDate,iMonths) <<= appointments.APPOINTDATE and (appointments.APPOINTDATE <= dDate)
  ))
  {
    //сравниваем текущее в выборке назначение с назначением в приказе для отчета
    //если не совпадает, значит были изменения, определяем какие
    if appointments.nrec <> cSelfAppoint //contdoc.cSTR 
    {
      cCoDoc := appointments.CCONT;
      if getfirst contdoc where ((cCoDoc == contdoc.nrec)) = tsOk
      {
        if (contdoc.TYPEOPER = 1) or (contdoc.TYPEOPER = 5)
        {
          result := 'Менялось'+chr(10)+'назначение';
        }
      }
    }
  }
}

end.
