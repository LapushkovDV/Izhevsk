/*************************************************************************************************\
* Наименование: Журнал учета личных карточек формы Т-2 (Т-2ГС)                                    *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Пятое окно картотеки - Сведения о военском учете                                 *
* Примечание Добавлено поле - внешний атрибут "Регистрационный №"                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2078         |29/12/17|Шунин А.Г.               |НПО Энергомаш                    *
\*************************************************************************************************/
#include ExtAttr.vih

#component "Z_STAFF"
#doc
 Пятое окно картотеки - Сведения о военском учете
#end

Alter Interface RECWIN05;

var soExtAttr  : iExtAttr;

Create view
var dDatOts     :Date;
    sSerOts     :String;
    sNomOts     :String;
   // sViduch     :String;
as select
  *
  ,ConsAcntKindCat1.Name(FieldTitle='Наимен.вида воин.учета(устар.)')
from
 ATTRNAM GP_RegATTRNAM
,ATTRVAL REGN
,synonym Catalogs ConsAcntKindCat1
Where
((
        coCONSCRIPTION == GP_RegATTRNAM.WTABLE
and 'Регистрационный №' == GP_RegATTRNAM.NAME
and GP_RegATTRNAM.nRec == REGN.CATTRNAM
and CONSCRIPTION.nRec == REGN.CREC
and GP_RegATTRNAM.WTABLE == REGN.WTABLE
and CONSCRIPTION.AcntKind   == ConsAcntKindCat1.Nrec


))
;

// 'Z_STAFF::RECEPTIONMAIN.WINAPPOINTMENTS.WINDOW06.Z_STAFF::RECWIN06.SCRAPPOINTMENTS1.APPKATPODRFULL'
// CONSRELCAT.NAME = 'Военнообязанный'
// 'Z_STAFF::RECEPTIONMAIN.WINCONSCRIPTION.WINDOW05.Z_STAFF::RECWIN05.SCRCONSCRIPTION.CONSCRIPTION.DAT1'

ExtendFormats SCRCONSCRIPTION;
Screen SCRCONSCRIPTION; //'';
   Table CONSCRIPTION;
Fields
  REGN.VSTRING:Protect, NoDel, pickButton;
  ConsAcntKindCat1.Name ('Наимен.вида воин.учета(устар.)') : pickbutton, protect;
  sSerOts: noProtect;
  sNomOts: noProtect;
  dDatOts: noProtect;
<<






















 Регистрационный № .@@@@@@@@ Вид воинского учета (устар.).@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Отсрочка: серия .@@@@@@@@ номер .@@@@@@@@ дата .@@@@@@@@@@
>>
end; //Screen SCRCONSCRIPTION
// -----------------------------------------------------------------------------
function NeedReg: boolean;
{
  NeedReg := persons.CSOVM = comp(0) and CONSRELCAT.NAME = 'Военнообязанный' ;
}
#include GP_File_hRef.Vpp

TableEvent
  table tmpPersons;
cmIdle:
{
  if isValid(tnCONSCRIPTION)
  {
    if (soExtAttr.AttrID(coCONSCRIPTION, 'Отсрочка дата') = 0)
      soExtAttr.CreateAttr(coCONSCRIPTION, 'Отсрочка дата', cgAttrType_Date);
    
    if (soExtAttr.AttrID(coCONSCRIPTION, 'Отсрочка серия') = 0)
      soExtAttr.CreateAttr(coCONSCRIPTION, 'Отсрочка серия', cgAttrType_Str);

    if (soExtAttr.AttrID(coCONSCRIPTION, 'Отсрочка номер') = 0)
      soExtAttr.CreateAttr(coCONSCRIPTION, 'Отсрочка номер', cgAttrType_Str);

    dDatOts := soExtAttr.dGetAttr(coCONSCRIPTION, CONSCRIPTION.nRec, 'Отсрочка дата');
    sSerOts := soExtAttr.sGetAttr(coCONSCRIPTION, CONSCRIPTION.nRec, 'Отсрочка серия');
    sNomOts := soExtAttr.sGetAttr(coCONSCRIPTION, CONSCRIPTION.nRec, 'Отсрочка номер');
  }
  else
  {
    dDatOts := date(0,0,0);
    sSerOts := '';
    sNomOts := '';
  }
inherited::handleevent(cmIdle);
}
end; // TableEvent table tmpPersons
// -----------------------------------------------------------------------------
handleevent
cmInit:
{
  if NeedReg
    SetFieldOption(#REGN.VSTRING,ofSelectable) //    SetFieldState(#REGN.VSTRING,sfVisible)
  else
    ClearFieldOption(#REGN.VSTRING,ofSelectable );//  ClearFieldState(#REGN.VSTRING,sfVisible);

  inherited::handleevent(cmInit);
}
cmStaffSeeDopInfo:
{
  putcommand(cmValue68);
}
cmValue68:
{ pGP_File_hRef.InitParam(
   if(false,cgiNotEdit,0)   //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
                // Если документ только на чтение следует вызвать cgiNotEdit
  ,coPersons //_wTable    : word; указать код таблицы документа системы
  ,tmpPersons.Nrec //_cRec      : comp=0;   // указать поле в таблице
  ,1 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
  ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
    ,'Файлы по сотруднику ' + Persons.fio
   );
}

cmCheckField:
{

  if Curfield = #dDatOts
  {
    if isValid(tnCONSCRIPTION)
      soExtAttr.dSetAttr(coCONSCRIPTION, CONSCRIPTION.nRec, 'Отсрочка дата', dDatOts)
  }
  if Curfield = #sSerOts
  {
    if isValid(tnCONSCRIPTION)
      soExtAttr.sSetAttr(coCONSCRIPTION, CONSCRIPTION.nRec, 'Отсрочка серия', sSerOts)
  }
  if Curfield = #sNomOts
  {
    if isValid(tnCONSCRIPTION)
      soExtAttr.sSetAttr(coCONSCRIPTION, CONSCRIPTION.nRec, 'Отсрочка номер', sNomOts)
  }

inherited::handleevent(cmCheckField);
}

cmPositionChanged:
{
  if NeedReg
    SetFieldOption(#REGN.VSTRING,ofSelectable) //    SetFieldState(#REGN.VSTRING,sfVisible)
  else
    ClearFieldOption(#REGN.VSTRING,ofSelectable );//  ClearFieldState(#REGN.VSTRING,sfVisible);

inherited::handleevent(cmPositionChanged);
}
cmPick:
{
  case curfield of
    #REGN.VSTRING:
    if not NeedReg
    message('Регистрация только для "Военнообязанный" по основному месту работы')
    else
    {
      if not isValid(#GP_RegATTRNAM)
      {
        message('Не найден внешний атрибут "Регистрационный №" типа STRING к таблице CONSCRIPTION');
      }
      else
      {
          Var sMess: string = 'Зарегестрировать ?';
          if isValid(#REGN) then
          {
             if REGN.VDATE = PERSONS.APPDATE then
             {
               Message('Зарегистрирован при принятии на работу ' +REGN.VDATE+  ''#13'Перерегистрация не требуется');
               sMess := ''
             }
             else sMess := 'Сделать перерегистрацию ?'
          }

          if sMess <> ''
          if Yes = Message(sMess, YesNo)
          {
            var NextNum: longint = 1;

            Sql select Max(VLONGINT) from ATTRVAL where ATTRVAL.CATTRNAM = :(GP_RegATTRNAM.nRec) into (NextNum);

            NextNum++;
            REGN.CATTRNAM:= GP_RegATTRNAM.nRec;
            REGN.WTABLE  := GP_RegATTRNAM.WTABLE;
            REGN.CREC    := CONSCRIPTION.nRec;
            REGN.VDATE   := PERSONS.APPDATE;
            REGN.VLONGINT:= NextNum;
            REGN.VSTRING := string(REGN.VLONGINT);

            if isValid(#REGN) UpDate current RegN
                   else       insert current RegN;

            RescanPanel(#CONSCRIPTION);

          }
      }
    }
   #ConsAcntKindCat1.Name:
    {
      ParentSav := Conscription.AcntKind;
      if (RunInterface('PickCatalog2', -54, ParentSav, 0) = cmDefault)
      {
        GetFirst ConsAcntKindCat1 where (( ParentSav == ConsAcntKindCat1.Nrec ));
        set Conscription.AcntKind := ParentSav;
        update current Conscription;
        RescanPanel(#CONSCRIPTION);
      }
    }
    else
      inherited::handleevent(cmPick);
  end;
}
end;


end.
