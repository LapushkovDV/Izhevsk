#include UserReport.vih
#include ComFiltr.vih
#include CatFunc.vih
#include RunStaj.vih
#include ExtClass.vih
#include GP_3GD.vih
#include GP_AppChange.vih
#include GP_XlOutExt.vih

#define GPInt GP_JRegKomL // #(GPInt)
#define GPNam Журнал регистрации и учета компенсаций за найм жилья // #(GPNam)

Interface #(GPInt) '#(GPNam) (ЭМ)' EscClose, Gray;
  show (,,86,14);

const
#include Excel.inc;
end;

table struct ttPerFlt // для фильтра по персоналу
(
  cRecPers : comp
)
with index
(
  ttPerFlt01  = cRecPers
);

table struct ttTypOp //ttTypOp.wCodeOper
(
  wCodeOper : word
, sNameOper : string
)
with index
(
  ttTypOp01 = wCodeOper
);

table struct ttResStr // статический набор данных
(
  nRec      : comp
, cRecPers  : comp
, sTbNmb    : string
, sFIO      : string
, sDept     : string
, sDepP     : string
, sPost     : string
, cKomp     : comp
, lVOpl     : longint
, sKomp     : string
, sKomC     : string
, sStaj     : string
, sTrud     : string
, sNDop     : string
, dDDop     : date
, dDDoD     : date
, dbSumK    : double
, iISupr    : integer
, iIChil    : integer //?
, sIChil    : string
, sPrik     : string
, sIsCh     : string
)
with index
(
  ttResStr00 = nRec(Surrogate)
, ttResStr01 = cRecPers + sKomC
, ttResStr02 = sFIO
);

table struct ttPers
(
  cRecPsn : comp,
  sFIO    : string
)
with index
(
  ttPers00 = cRecPsn
, ttPers01 = sFIO
);

table struct ttSumOpl
(
  cRecPsn : comp
, sVOpl   : string
, lVOpl   : longint
, wYear   : word
, wMonth  : word
, dbSum   : double
)
with index
(
  ttSumOpl01 = cRecPsn + lVOpl + wYear + wMonth 
, ttSumOpl02 = cRecPsn + sVOpl + wYear + wMonth 
);
table struct ttVidOpl
(
  cRecPsn : comp
, sVOpl   : string
, lVOpl   : longint
)
with index
(
  ttVidOpl01 = cRecPsn + lVOpl
);

var
  dBeg, dEnd    : date;
  VCommonFiltr  : CommonFiltr; // Для встраивания фильтра по подразделениям / сотрудникам
  MadeReport    : boolean;
  cPersNRec     : comp;
  PersMarker    : TPtr;
  RPDMarker     : TPtr;
  iCatFunc      : CatalogsFunctions;
  iRunStaj      : Runstaj;
  i3GD          : GP_3GD;
  iAppCh        : GP_AppChange;
  iOut          : GP_XlOutExt;
  sFullName     : string;
  sRPD          : string;
  wRPD          : word;
  lRB, lRE,
  lCB, lCE,
  lSB, lSE,
  lDB, lDE,
  lRow          : longint;
  wTypOper      : word;
  iRowB, iRowE,
  iNPP          : integer;

create view
var
  cPersOpl : comp;
  lVidOpl  : longint;
from
  persons
, appointments
, appointments appfirst
, raisehist
, GP_RaiseHistExt101
, raise
, TYPEPR
, ttPerFlt
, ttResStr
, ttTypOp
, ttPers
, ttSumOpl
, ttVidOpl
, KlVidOpl
, contdoc
, SpAllStaff SpAS_Cnt
, SpAllStaff SpAS_Agr
, SumVidOp
where
((
       ttPerFlt.cRecPers == persons.nrec
and persons.APPOINTFIRST == appfirst.nrec
and    ttPerFlt.cRecPers == raisehist.CPSN and (raisehist.DOCDATE >= dBeg and raisehist.DOCDATE <= dEnd)
and     raisehist.cRaise == raise.nrec
and   raisehist.cContDoc == contdoc.nrec
and     contdoc.TypeOper == ttTypOp.wCodeOper
and         contdoc.cStr == appointments.nrec
and       RaiseHist.nrec == GP_RaiseHistExt101.cRaiseH
and                    7 == SpAS_Cnt.wNoCon  //Ищем ссылку на допсоглашение отображаемое непосредственно в приказе
and         contdoc.NRec == SpAS_Cnt.CLINKT  //независимо от того что в карточке
and                    0 == SpAS_Cnt.INUM    //допсоглашение из карточки устарело?
and            coContDoc == SpAS_Cnt.WCHOISE 
and      SpAS_Cnt.cBaseT == SpAS_Agr.nRec

and           year(dBeg)<<= SumVidOp.YearN and (year(dEnd) >= SumVidOp.YearN and cPersOpl = SumVidOp.TPerson /*and lVidOpl = SumVidOp.VIDOPL*/)
))
;

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

procedure Run;
{
  var kol, i    : integer;
  var cPersNRec : comp;
  var sR2I      : string;
  var sCT, sNT  : string;
  var dbTotalIt : double;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);

  if (VCommonFiltr.GetPsnCount = 0)
    VCommonFiltr.SelectAllPsn;

  PersMarker := InitMarker('#(GPInt)_PSN_'+UserName(),8,200,100);
  PersMarker := VCommonFiltr.GetPersonsMarker;
  kol:=  GetMarkerCount(PersMarker);
  i := 0;
  while i < kol
  {
    GetMarker(PersMarker, i, cPersNRec);
    insert ttPerFlt set ttPerFlt.cRecPers := cPersNRec;
    i++;
    if (not NextVisual) break;
  }
  
  if isvalid(#ttPerFlt)
  _loop ttPerFlt
  {
    if isvalid(#RaiseHist)
    _loop RaiseHist
    {
      if (not NextVisual) break;  
    
      if isvalid(#Raise)
      if isvalid(#contdoc)
      if isvalid(#ttTypOp)
      if raise.OrderDate1 = RaiseHist.DOCDATE and raise.OrderDate2 = 0
      {
        if isvalid(#persons)
        {
          if getfirst ttPers where((persons.nrec == ttPers.cRecPsn)) <> tsOk
          {
            clearbuffer(#ttPers);
            ttPers.cRecPsn := persons.nrec;
            ttPers.sFIO := persons.fio;
            insert current ttPers;
          }
          clearbuffer(#ttResStr);
          ttResStr.cRecPers := persons.nrec;
          ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
          ttResStr.sFIO     := persons.FIO;
          if isvalid(#appointments)
          {
            ttResStr.sDept  := iCatFunc.GetCatalogsCode(appointments.DEPARTMENT);
            ttResStr.sPost  := iCatFunc.GetCatalogsName(appointments.POST);
            ttResStr.sDepP  := i3GD.sCode3GD(appointments.DEPARTMENT);
          }
          if RaiseHist.CRAISE <> 0
          {
            ttResStr.sKomp  := iCatFunc.GetCatalogsName(RaiseHist.cRaiseType);
            ttResStr.sKomC  := iCatFunc.GetCatalogsCode(RaiseHist.cRaiseType);
//            ttResStr.cKomp  := RaiseHist.nRec;
            ttResStr.lVOpl  := longint(Trim(iCatFunc.GetCatalogsCatData(RaiseHist.cRaiseType)));
            if getfirst ttVidOpl where((ttPers.cRecPsn == ttVidOpl.cRecPsn and ttResStr.lVOpl == ttVidOpl.lVOpl)) <> tsOk
            {
              clearbuffer(#ttVidOpl);
              ttVidOpl.cRecPsn := ttPers.cRecPsn;
              ttVidOpl.lVOpl   := ttResStr.lVOpl;
              if getfirst KlVidOpl where ((ttResStr.lVOpl == KlVidOpl.VidOpl)) = tsOk
                ttVidOpl.sVOpl   := KlVidOpl.NVidOpl;
              insert current ttVidOpl;
            }
          }
          if isvalid(#appfirst)
            ttResStr.sTrud  := appfirst.contractnmb + ' от ' + datetostr(appfirst.contractdate,'DD.MM.YYYY');

          ttResStr.sStaj    := iRunStaj.RunStrStaj(persons.nrec,89,dEnd);
          if isvalid(#SpAS_Cnt)
            if isvalid(#SpAS_Agr)
            {
              ttResStr.sNDop:= SpAS_Agr.RESSTRING[1];
              ttResStr.dDDop:= SpAS_Agr.RESDATE[1];
            }
          ttResStr.dDDoD    := RaiseHist.dDat2;
          ttResStr.dbSumK   := RaiseHist.RHSUM;
          if isvalid(#GP_RaiseHistExt101)
          {
            ttResStr.iISupr   := GP_RaiseHistExt101.FMembers;
            ttResStr.iIChil   := GP_RaiseHistExt101.FMembCh;
          }
          ttResStr.sPrik    := RaiseHist.DOCNMB+' от '+datetostr(RaiseHist.DOCDATE,'DD.MM.YYYY');
          ttResStr.sIsCh    := iAppCh.State(persons.nrec,contdoc.cSTR,dEnd,12);
          insert current ttResStr;
        }
      }
    }
  }
  if isvalid(#ttResStr)
  {
    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xls';
    xlCreateExcel(sFullName, TRUE);
    iOut.xlSummaryRowAbove;
    lRB  := 4;
    lRow := 1;
    lDB  := lDE := lRB + 2;
    lCB  := 1;
    lCE  := 1;
    iNPP := 1;
    dbTotalIt:=0;

    iOut.StringValL('#(GPNam) за период с '+datetostr(dBeg,'DD.MM.YYYY')+' по '+datetostr(dEnd,'DD.MM.YYYY'),2,3,2,3);
    xlSetFontSize(14,2,3,2,3); xlSetFontStyle(xlBold,2,3,2,3);
    
    #define FrmHd  lRB,  lCE,  lRB,  lCE
    #define FrmHs  lRB+1,lCE,  lRB+1,lCE
    iOut.Header2Row('№ п/п',                          #FrmHd); lCE++;
    iOut.Header2Row('Таб. Ном.',                      #FrmHd); lCE++;
    iOut.Header2Row('ФИО',                            #FrmHd); lCE++;
    iOut.Header2Row('№ цеха/ отдел',                  #FrmHd); lCE++;
    iOut.Header2Row('Код вышест. подр.',              #FrmHd); lCE++;
    iOut.Header2Row('Должность / специальность',      #FrmHd); lCE++;
    iOut.Header2Row('Вид компенсации',                #FrmHd); lCE++;
    iOut.Header2Row('Стаж работы на предприятии',     #FrmHd); lCE++;
    iOut.Header2Row('№ трудового договора',           #FrmHd); lCE++;
    iOut.Header2Row('№ доп. согла-шения',             #FrmHd); lCE++;
    iOut.Header2Row('Дата заклю-чения',               #FrmHd); lCE++;
    iOut.Header2Row('Срок действия доп. согл.',       #FrmHd); lCE++;
    iOut.Header2Row('Размер компен-сации',            #FrmHd); lCE++;
    iOut.Header2Row('Дата начисл. компен-сации',      #FrmHd); lCE++;
    iOut.Header2Row('Начислено компен-сации',         #FrmHd); lCE++;
    iOut.HeaderIns ('Количество членов семьи',        #FrmHd, 2);
    iOut.Header1Row('супруг(а)',                      #FrmHs); lCE++;
    iOut.Header1Row('дети',                           #FrmHs); lCE++;
    
    iOut.Header2Row('Номер и дата списка',            #FrmHd); lCE++;
    iOut.Header2Row('Изменение условий',              #FrmHd); lCE++;

    #define FrmCl lDE,lSE,lDE,lSE
    _loop ttPers ordered index ttPers01
    {
      lSB := lSE := 1;
/*01*/  iOut.IntegerVal(lRow,           #FrmCl); lRow++;
      _loop ttResStr where((ttPers.cRecPsn==ttResStr.cRecPers))
      {
        if (not NextVisual) break;
        
        lSB := lSE := 1;
/*01*/  lSE++;
/*02*/  iOut.StringValC(ttResStr.sTbNmb,#FrmCl); lSE++;
/*03*/  iOut.StringValL(ttResStr.sFio,  #FrmCl); lSE++;
/*04*/  iOut.CodeVal   (ttResStr.sDept, #FrmCl); lSE++;
/*05*/  iOut.CodeVal   (ttResStr.sDepP, #FrmCl); lSE++;
/*06*/  iOut.StringValL(ttResStr.sPost, #FrmCl); lSE++;
/*07*/  iOut.StringValL(ttResStr.sKomp, #FrmCl); lSE++;
/*08*/  iOut.StringValR(ttResStr.sStaj, #FrmCl); lSE++;
/*09*/  iOut.StringValR(ttResStr.sTrud, #FrmCl); lSE++;
/*10*/  iOut.StringValR(ttResStr.sNDop, #FrmCl); lSE++;
/*11*/  iOut.DateVal   (ttResStr.dDDop, #FrmCl); lSE++;
/*12*/  iOut.DateVal   (ttResStr.dDDoD, #FrmCl); lSE++;
/*13*/  iOut.DoubleVal (ttResStr.dbSumK,#FrmCl); lSE++;
/*14*/  lSE++;
/*15*/  lSE++;
/*16*/  iOut.IntegerVal(ttResStr.iISupr,#FrmCl); lSE++;
/*17*/  iOut.IntegerVal(ttResStr.iIChil,#FrmCl); lSE++;
/*18*/  iOut.StringValR(ttResStr.sPrik, #FrmCl); lSE++;
/*19*/  iOut.StringValC(ttResStr.sIsCh, #FrmCl); lSE++;
        dbTotalIt := dbTotalIt + ttResStr.dbSumK;
        lDE++;
      }
      var isSumm : boolean;
      cPersOpl := ttPers.cRecPsn;
      if isvalid(#SumVidOp)
      {
        isSumm := false;
        _loop SumVidOp
        {
          if  date(1,month(dBeg),year(dBeg)) <= date(1,SumVidOp.MesN,SumVidOp.YearN)
          and sub_day(add_months(date(1,month(dEnd),year(dEnd)),1),1) >= sub_day(add_months(date(1,SumVidOp.MesN,SumVidOp.YearN),1),1)
          {
            if getfirst ttVidOpl where((ttPers.cRecPsn==ttVidOpl.cRecPsn and SumVidOp.VidOpl==ttVidOpl.lVOpl)) = tsOk
            {
              if getfirst ttSumOpl where ((  ttPers.cRecPsn==ttSumOpl.cRecPsn 
                                         and ttVidOpl.lVOpl==ttSumOpl.lVOpl  
                                         and SumVidOp.YearN==ttSumOpl.wYear
                                         and SumVidOp.MesN ==ttSumOpl.wMonth
              /*if getfirst ttSumOpl*/   )) <> tsOk
              {
                clearbuffer(#ttSumOpl);
                ttSumOpl.cRecPsn := ttPers.cRecPsn;
                ttSumOpl.wYear   := SumVidOp.YearN;
                ttSumOpl.wMonth  := SumVidOp.MesN ;
                ttSumOpl.dbSum   := SumVidOp.Summa;
                ttSumOpl.lVOpl   := ttVidOpl.lVOpl;
                insert current ttSumOpl;
                isSumm := true;
              }
              else
              {
                ttSumOpl.dbSum += SumVidOp.Summa;
                update current ttSumOpl;
              }
            }
          }
        }
        if isSumm
        {
          lSE := 3; 
          xlSetFontStyle(xlBold,lDE,lCB,lDE,lCE);
          iOut.HeaderInsL('Итого Начислено компенсации по '+ttResStr.sFio, #FrmCl, 5); lDE++;
          iRowB:=lDE;
          _loop ttVidOpl where((ttPers.cRecPsn==ttVidOpl.cRecPsn))
          _loop ttSumOpl where((ttPers.cRecPsn==ttSumOpl.cRecPsn and ttVidOpl.lVOpl==ttSumOpl.lVOpl))
          {
            lSB := 1;
            lSE := 7; 
/*07*/      iOut.StringValL(ttVidOpl.sVOpl, #FrmCl);
            lSE := 14;
/*13*/      iOut.DateVal   (sub_day(add_months(date(1,ttSumOpl.wMonth,ttSumOpl.wYear),1),1), #FrmCl);
            lSE := 15;
/*15*/      iOut.DoubleVal (ttSumOpl.dbSum, #FrmCl);
            lDE++;
          }
          iRowE := lDE - 1;
          //=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;N8:N11)
          iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;O'+iRowB+':O'+iRowE+')', iRowB-1, 15, iRowB-1, 15);
          iOut.xlSetSummaryRow(iRowB, iRowE, iNPP++);
        }
      }
    }

    var iItC : integer;
    #define FrmIt lDE,iItC,lDE,iItC
    iOut.xlR1C1OnOff(true);
    iItC :=  3; iOut.StringValL('Итого:',  #FrmIt);
    iItC := 13; iOut.FormulaDoubleVal('=СУММ(R'+lDB+'C'+iItC+':R'+(lDE-1)+'C'+iItC+')', #FrmIt);
    iOut.xlR1C1OnOff(false);
    iItC := 15; iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;O'+lDB+':O'+(lDE-1)+')', #FrmIt);

    lSE := 1;
    #define FrmBl lDB,lSE,lDE,lSE
    xlSetRowHeight(30,lRB,1,lRB,1);
    xlSetRowHeight(30,lRB+1,1,lRB+1,1);
/*01*/xlSetColumnWidth( 4,#FrmBl); lSE++;
/*02*/xlSetColumnWidth( 6,#FrmBl); lSE++;
/*03*/xlSetColumnWidth(20,#FrmBl); lSE++;
/*04*/xlSetColumnWidth(8,#FrmBl); lSE++;
/*05*/xlSetColumnWidth(8,#FrmBl); lSE++;
/*06*/xlSetColumnWidth(20,#FrmBl); lSE++;
/*07*/xlSetColumnWidth(20,#FrmBl); lSE++;
/*08*/xlSetColumnWidth(17,#FrmBl); lSE++;
/*09*/xlSetColumnWidth(18,#FrmBl); lSE++;
/*10*/xlSetColumnWidth(8,#FrmBl); lSE++;
/*11*/xlSetColumnWidth(10,#FrmBl); lSE++;
/*12*/xlSetColumnWidth(10,#FrmBl); lSE++;
/*13*/xlSetColumnWidth(10,#FrmBl); lSE++;
/*14*/xlSetColumnWidth(10,#FrmBl); lSE++;
/*15*/xlSetColumnWidth(10,#FrmBl); lSE++;
/*16*/xlSetColumnWidth(10,#FrmBl); lSE++;
/*17*/xlSetColumnWidth(10,#FrmBl); lSE++;
/*18*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*19*/xlSetColumnWidth(12,#FrmBl); lSE++;
  
    xlSetFontSize(11,lRB,lCB,lDE,lCE); xlSetFontStyle(xlBold,lRB,lCB,lRB+1,lCE); xlSetFontStyle(xlBold,lDE,1,lDE,lCE);
    xlWrapText(lRB,lCB,lDE,lCE);
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0,lRB,lCB,lDE,lCE-1);
    iOut.StringValL('Ответственный исполнитель: '+sGetTune('User.FIO'),lDE+2,3,lDE+2,3);
    xlSetFontSize(11,lDE+2,3,lDE+2,3); xlSetFontStyle(xlBold,lDE+2,3,lDE+2,3);
    iOut.xlTitleEachPageO(lRB,lDB-1);
    iOut.xlPageScaleLandscape(1);
    xlFreeze(lDB,1);
    StopVisual;
    xlKillExcel;
  }
  else
  {
    StopVisual;
    message('Нет данных для формирования отчета!');
  }

}

Screen s1(,,sci1Esc);
  show at (,,85,4);
  fields
    dBeg ('Начало периода',,):{Font = {BackColor = if(dBeg = 0, ColorNeed, 0)}}, noprotect;
    dEnd ('конец периода',,): {Font = {BackColor = if(dEnd = 0, ColorNeed, 0)}}, noprotect;
    sRPD ('Распорядительное действие',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sRPD = 'не установлен', ColorNeed, 0)}}, protect;
  << 'Параметры отчета'
   `Период отчета`
    .@@@@@@@@@@ .@@@@@@@@@@@

    Действие     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  >>
end;  
embedded ComFiltrEmbedded 'Фильтры' interface VCommonFiltr;
  show (,5,85,11);
end
Screen s2(,,sci1Esc);
  show (,12,85,13);
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
  <<
     <. ~С~формировать .>                         <. ~З~акрыть .>
  >>
end;

procedure FillRPDStr;
{
  var i,kol : integer;
  Set sRPD := 'не установлен';

  kol :=  GetMarkerCount(RPDMarker);
  if (kol = 1)
  {
    if GetMarker(RPDMarker, 0, wRPD)
      if GetFirst TypePr where ((wRPD == TypePr.CodOper)) = tsOk
      {
        set sRPD:= TypePr.NOper;
        clearbuffer(#ttTypOp);
        ttTypOp.wCodeOper := TYPEPR.CODOPER;
        ttTypOp.sNameOper := TYPEPR.NOPER;
        insert current ttTypOp;
      }
  }
  else
  {
    set sRPD := 'Несколько распорядительных действий (' + kol + ')';
    i := 0;
    while i < kol
    {
      GetMarker(RPDMarker, i, wRPD);
      if GetFirst TypePr where ((wRPD == TypePr.CodOper)) = tsOk
      {
        clearbuffer(#ttTypOp);
        ttTypOp.wCodeOper := TYPEPR.CODOPER;
        ttTypOp.sNameOper := TYPEPR.NOPER;
        insert current ttTypOp;
      }
      i++;
    }
  }
}

handleevent
  cmInit:
  {
    delete all from ttPerFlt;
    delete all from ttResStr;
    delete all from ttTypOp;
    if (not (ReadMyDsk(dBeg, '#(GPInt)_dBeg', false)))
      dBeg := date(1,1,year(Cur_Date));
    if (not (ReadMyDsk(dEnd, '#(GPInt)_dEnd', false)))
      dEnd := date(31,12,year(Cur_Date));
    MadeReport:= false;
    wRPD := 0;
    Set sRPD := 'не установлен';
    RPDMarker := InitMarker('#(GPInt)_RPD_' + UserName(), 4, 10, 5);// Маркер для RPD
    if GetMarkerCount(RPDMarker) >0 FillRPDStr;
    i3GD.Init3GD;
  }
  cmPick:
  {
    case CurField of
    #sRPD:
    {
      wRPD := 101;
      if RunInterface ('PickManyRPD', wRPD, RPDMarker, vfMultipleSelection,0) = cmDefault
      {
        delete all from ttTypOp;
        FillRPDStr;
      }
    }
    end;
  }
  cmDelOnProtect:
  {
    case CurField of
    #sRPD:
    {
      Set sRPD := 'не установлен';
      delete all from ttTypOp;
      ClearMarker(RPDMarker);
    }
    end;
  }
  cmOk:
  {
    if (dBeg = 0) or (dEnd = 0) or (dBeg > dEnd)
    {
      message('Задан некорректный период!');
    }
    else
    {
      if wRPD = 0
      {message('Не задано РПД!');}
      else
      {
        Run;
        SaveMyDsk(dBeg, '#(GPInt)_dBeg');
        SaveMyDsk(dEnd, '#(GPInt)_dEnd');
        MadeReport:= true;
        VCommonFiltr.IntClose(MadeReport);
        VCommonFiltr.StoreAllParams;
        Notify(cmEvaluateAndModify, 0);
        DoneMarker(RPDMarker, '#(GPInt)_RPD_' + UserName());
        DoneMarker(PersMarker, '#(GPInt)_PSN_' + UserName());
      
        closeinterface(cmDefault);
      }
    }
  }
  cmCancel:
  {
    VCommonFiltr.IntClose(MadeReport);
    DoneMarker(RPDMarker, '#(GPInt)_RPD_' + UserName());
    DoneMarker(PersMarker, '#(GPInt)_PSN_' + UserName());
    SaveMyDsk(dBeg, '#(GPInt)_dBeg');
    SaveMyDsk(dEnd, '#(GPInt)_dEnd');
  }
end;
end.



VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;

Procedure Run;
Begin
  runinterface(#(GPInt));
End;

Function GetReportName: String;
Begin
  GetReportName := '#(GPNam) (ЭМ)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Компенсации и льготы';
    2 : GetGroupName := 'Журналы регистрации и учета';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;

End.
