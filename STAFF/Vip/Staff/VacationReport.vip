#include xlReport.vih
#include DeptIer.vih // получить всякие свойства по записи таблицы Catalogs
#include History.vih

procedure DisableLoadMonthlyScheduleMessages; external 'G_Zarpl.dll';
procedure EnableLoadMonthlyScheduleMessages; external 'G_Zarpl.dll';


Interface iEMVacationReport 'РПД № 6 "Оформление очередного отпуска"'  escclose, cyan, doaccept;
  Show at (, , 60, 8);
//*****************************************************************************
#include History.var
//*****************************************************************************
table struct tmpVacation
(
  NRec        : comp
, FIO         : string
, cPerson     : comp
, dPeriod1    : date
, dPeriod2    : date
, wType       : word
, sPodr       : string
, wTypeOtpusk : word
, NameType    : string
, wDayCount   : double
, dat1        : date
, dat2        : date
, isPrint     : boolean
, cStr        : comp
, cDop        : comp
)
with index
(
  tmpVacation01 = NRec (Surrogate, Unique)
, tmpVacation02 = wTypeOtpusk + wType + cPerson + dPeriod1 + dPeriod2 + isPrint
, tmpVacation03 = wTypeOtpusk + cDop
, tmpVacation04 = wType + cPerson + dPeriod1 + dPeriod2 + isPrint
, tmpVacation05 = cPerson + dPeriod1 + dPeriod2
, tmpVacation06 = FIO + dPeriod1 + dPeriod2
//, tmpVacation03 =!!! wType + TabNum + dPeriod1 + dPeriod2 + npp
)
;

//******************************************************************************

Create view
var
  sFeeSigners
, sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol 
, sPodpis1Npp
, sPodpis2Npp        : string;

  EnhancedTimeFormat : boolean;

  wShowFirstPage 
, wCountry           : word;

  sNumDoc
, dDateDoc
, ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;

  dBeg
, dEnd               : date;

  cTitleDoc
, ContDocNrec        : comp; 

as select
  if ((Appointments.lPrizn = 0),  
       GetStrTabN(Persons.TabNmb, Persons.StrTabN), 
       GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN))
    (fieldname = fAppTabN)
, 9
    (FieldName = wType)
, 'Em_Report_' + string(wType)
    (FieldName = nameNastr)
, TitleDoc.NRec
from 
  TitleDoc
, PartDoc
, ContDoc
, Persons
, Persons PersonsContDoc
, PutVacCon
, PutVacation
, KlOtpusk
, WorkPeriod  WP_WorkPeriodRemain
, WorkPeriod  WP_WorkPeriodOtp
, Catalogs    PostCat
, Catalogs    Catalogs2
, tmpVacation
//, tmpVacation tmpVacation2
, Appointments
, Appointments Appointments2
, SpKau
, KlOtpusk OsnKlOtpusk
, PutVacCon CalcPutVacCon
, WORKPERIOD
, KatOrg
where
((
    cTitleDoc               ==  TitleDoc.NRec
AND TitleDoc.NRec           ==  PartDoc.cDoc
AND PartDoc.NRec            ==  ContDoc.cPart
AND ContDoc.Person          ==  PersonsContDoc.NRec
AND tmpVacation.cPerson     ==  Persons.NRec
AND coContDoc               ==  PutVacCon.wTable
AND ContDoc.NRec            ==  PutVacCon.cTable
AND PutVacCon.cPutVacation  ==  PutVacation.NRec
AND PutVacation.cKlOtpusk   ==  KlOtpusk.NRec
AND PutVacation.cWPRemain   ==  WP_WorkPeriodRemain.NRec
AND PutVacation.cWorkPeriod ==  WP_WorkPeriodOtp.NRec
AND tmpVacation.cStr        ==  Appointments.NRec
AND Appointments.Post       ==  PostCat.NRec
AND ContDoc.cNew1           ==  OsnKlOtpusk.NRec

AND coContDoc               == CalcPutVacCon.wTable
AND ContDoc.nrec            == CalcPutVacCon.cTable

AND ContDoc.cWorkPeriod     ==  WorkPeriod.nRec
AND ContDoc.cStr            ==  Appointments2.NRec
))

order by PutVacCon.wNum
;

Parameters
  sNumDoc
, dDateDoc
, cTitleDoc
, ContDocNrec
;
//*****************************************************************************
var IDepartIer : DepartIer; // иерархия подразделений
//*****************************************************************************
function fnGetDuration: double;
{
  result := 0;

  if getfirst CalcPutVacCon = tsOk
   _loop CalcPutVacCon
      result += CalcPutVacCon.wDayCount;
  else
    {
      DisableLoadMonthlyScheduleMessages;
      result := OtpKolDn(if (wCountry = ccKaz, OsnKlOtpusk.wFlag1, OsnKlOtpusk.IsRabDn)
                                        , ContDoc.Dat1
                                        , ContDoc.Dat2
                                        , Appointments.cAddNrec2);
      EnableLoadMonthlyScheduleMessages;
    }
}
//*****************************************************************************
// проверить - нужен ли этот уровень
Function GetPrintNeed(pRec:comp) : boolean; cacheable;
{ 
  Result := TRUE;

  var res : comp; res := coGetAttr(coCatalogs, pRec, 'Не выводить при печати');
  if (res = 0) exit;

  if (GetFirst Spkau where ((res == SpKau.NRec)) = tsOk AND UpCase(SpKau.Name) = 'ДА')
    Result := FALSE;
}
//*****************************************************************************
Function GetPodrFullName(ccPodr : comp) : string;
{
  var sRes : string; sRes := '';
  var sCode : string; sCode := '';

  if (GetFirst Catalogs2 where ((ccPodr == Catalogs2.NRec)) = tsOk)
  do
    {
      ccPodr := Catalogs2.cParent;   

      //if (Trim(sRes) <> '' AND Catalogs2.bPick <> 0)
      if (NOT GetPrintNeed(Catalogs2.NRec))
        continue;

      sCode := SubStr(Catalogs2.Code, 1, 3);
      sRes  := sRes + Catalogs2.Name + ' ';
    }
  while (GetFirst Catalogs2 where ((ccPodr == Catalogs2.NRec)) = tsOk and Catalogs2.SysCode = 0);
  
  sRes := sRes + '(' + sCode + ')';

  result := Trim(sRes);
}
//*****************************************************************************
Procedure InitTable;
{
  if (GetFirst TitleDoc = tsOk)
    _LOOP PartDoc
      _LOOP ContDoc
        { 
          if (ContDocNrec <> comp(0))
            if (ContDocNrec <> ContDoc.NRec)
              continue;

          var dTmp: date; dTmp := ContDoc.Dat1;
  
          _LOOP PutVacCon
            if (PutVacCon.wDayCount > 0)
              {
                ClearBuffer(#tmpVacation);
                tmpVacation.cPerson     := ContDoc.Person;
                tmpVacation.FIO         := PersonsContDoc.FIO;
                tmpVacation.dPeriod1    := if (PutVacation.wTypeVac = 0, WP_WorkPeriodOtp.dPerBeg, WP_WorkPeriodRemain.dPerBeg);
                tmpVacation.dPeriod2    := if (PutVacation.wTypeVac = 0, WP_WorkPeriodOtp.dPerEnd, WP_WorkPeriodRemain.dPerEnd);
                tmpVacation.dPeriod1    := if (tmpVacation.dPeriod1 = ZeroDate, ContDoc.dPrik    , tmpVacation.dPeriod1);
                tmpVacation.dPeriod2    := if (tmpVacation.dPeriod2 = ZeroDate, ContDoc.dRezerve , tmpVacation.dPeriod2);
                tmpVacation.dat1        := dTmp;
                tmpVacation.dat2         := OtpDatOK(KlOtpusk.IsRabDn
                                          , dTmp
                                          , Trunc(Abs(PutVacCon.wDayCount) + 0.99999)
                                          , Appointments2.cAddNrec2
                                          );
                tmpVacation.wType       := PutVacation.wTypeVac;
                tmpVacation.sPodr       := GetPodrFullName(ContDoc.cDopRef); // IDepartIer.GetFulDepName(ContDoc.cDopRef);
                tmpVacation.wTypeOtpusk := if (KlOtpusk.KOTPUS = 1 OR KlOtpusk.KOTPUS = 11, 0, 1);
                tmpVacation.NameType    := KlOtpusk.NOTPUS;
                tmpVacation.wDayCount   := PutVacCon.wDayCount;  
                //tmpVacation.dat1        := ContDoc.dat1;
                //tmpVacation.dat2        := ContDoc.dat2;
                tmpVacation.isPrint     := false;
                tmpVacation.cStr        := ContDoc.cStr;
                tmpVacation.cDop        := PutVacCon.cTable;
                if (insert current tmpVacation = tsOk)
                  {}

                dTmp := Add_Day(tmpVacation.dat2, 1);
              }

           if (GetFirst OsnKlOtpusk = tsOk)
             {
                ClearBuffer(#tmpVacation);
                SET tmpVacation.cStr    := ContDoc.cStr;
                tmpVacation.cPerson     := ContDoc.Person;
                tmpVacation.FIO         := PersonsContDoc.FIO ;
                tmpVacation.dPeriod1    := WorkPeriod.dPerBeg;
                tmpVacation.dPeriod2    := WorkPeriod.dPerEnd;
                tmpVacation.dPeriod1    := if (tmpVacation.dPeriod1 = ZeroDate, ContDoc.dPrik    , tmpVacation.dPeriod1);
                tmpVacation.dPeriod2    := if (tmpVacation.dPeriod2 = ZeroDate, ContDoc.dRezerve , tmpVacation.dPeriod2);
                //tmpVacation.wType       := PutVacation.wTypeVac;
                tmpVacation.sPodr       := GetPodrFullName(ContDoc.cDopRef); //IDepartIer.GetFulDepName(ContDoc.cDopRef);
                tmpVacation.wTypeOtpusk := if (OsnKlOtpusk.KOTPUS = 1 OR OsnKlOtpusk.KOTPUS = 11, 0, 1);
                tmpVacation.NameType    := OsnKlOtpusk.NOTPUS;
                tmpVacation.wDayCount   := fnGetDuration;  
                tmpVacation.dat1        := ContDoc.dat1;
                tmpVacation.dat2        := ContDoc.dat2;
                tmpVacation.isPrint     := false;
                tmpVacation.cDop        := ContDoc.NRec;
                if (insert current tmpVacation = tsOk)
                  {}
             }
        }
}
//******************************************************************************
Procedure PrintLine;
{
   var npp : longint; npp := 0;
   var sLn : string; sLn := '';

   _LOOP tmpVacation /*where ((0 == tmpVacation.wTypeOtpusk))*/ ordered by tmpVacation.FIO, tmpVacation.dPeriod1, tmpVacation.dPeriod2 // tmpVacation.cPerson, tmpVacation.dPeriod1, tmpVacation.dPeriod2
     if (Not NextVisual)
     {
       break; 
     }
     else   
     {
       var isIns : boolean; isIns := false;
       pXL.ClearTblBuffer;
       if (sLn != fAppTabN)
          {
            inc(npp);
          }

       pXL.SetTblStringFldValue('npp'        , npp        );

       if (GetFirst Persons = tsOk)
         {
           pXL.SetTblStringFldValue('sFIO'       , Persons.FIO);
           pXL.SetTblStringFldValue('TabNum'     , '''' + fAppTabN);
         }

       pXL.SetTblStringFldValue('sPodr'      , tmpVacation.sPodr);

       if (GetFirst PostCat = tsOk)
         pXL.SetTblStringFldValue('sDol'       , PostCat.Name);

       if (tmpVacation.wTypeOtpusk = 0)
         {
           pXL.SetTblStringFldValue('OtpTypeOs'  , tmpVacation.NameType);
           pXL.SetTblNumberFldValue('iDays'      , tmpVacation.wDayCount);
         }

       if (tmpVacation.dPeriod1 <> ZeroDate)
         pXL.SetTblStringFldValue('dPeriod1'   , '''' + DateToStr(tmpVacation.dPeriod1, 'DD.MM.YYYY'));

       if (tmpVacation.dPeriod2 <> ZeroDate)
         pXL.SetTblStringFldValue('dPeriod2'   , '''' + DateToStr(tmpVacation.dPeriod2, 'DD.MM.YYYY'));

//       pXL.SetTblStringFldValue('iDays_rab'  , tmpVacation.iDays_rab  );
//       pXL.SetTblStringFldValue('myType'     , tmpVacation.myType     );
       if (tmpVacation.dat1 <> ZeroDate)
         pXL.SetTblStringFldValue('dat1'       , '''' + DateToStr(tmpVacation.dat1, 'DD.MM.YYYY'));
       if (tmpVacation.dat2 <> ZeroDate)
         pXL.SetTblStringFldValue('dat2'       , '''' + DateToStr(tmpVacation.dat2, 'DD.MM.YYYY'));
       //pXL.SetTblStringFldValue('sFoundation', tmpVacation.sFoundation);

       if (tmpVacation.wTypeOtpusk <> 0)
         {
           pXL.SetTblStringFldValue('OtpTypeDop', tmpVacation.NameType );
           pXL.SetTblNumberFldValue('iDaysDop'  , tmpVacation.wDayCount);

         }

/*
       external _LOOP tmpVacation2 where ((1                     == tmpVacation2.wTypeOtpusk
                                      AND tmpVacation.cDop       == tmpVacation2.cDop )) //ordered by tmpVacation2.npp
         {
           NextVisual;

           if (isIns)
             pXL.ClearTblBuffer;

           pXL.SetTblStringFldValue('OtpTypeDop', tmpVacation2.NameType );
           pXL.SetTblNumberFldValue('iDaysDop'  , tmpVacation2.wDayCount);

           if (isIns)
             {
               pXL.SetTblStringFldValue('npp'        , npp        );
               //pXL.SetTblStringFldValue('iDays_rab'  , tmpVacation2.iDays_rab  );
               //pXL.SetTblStringFldValue('myType'     , tmpVacation2.myType     );
                
               if (tmpVacation.dPeriod1 <> ZeroDate)
                 pXL.SetTblStringFldValue('dPeriod1'   , '''' + DateToStr(tmpVacation2.dPeriod1, 'DD.MM.YYYY'));
               if (tmpVacation.dPeriod2 <> ZeroDate)
                 pXL.SetTblStringFldValue('dPeriod2'   , '''' + DateToStr(tmpVacation2.dPeriod2, 'DD.MM.YYYY'));
               if (tmpVacation.dat1 <> ZeroDate)
                 pXL.SetTblStringFldValue('dat1'       , '''' + DateToStr(tmpVacation2.dat1    , 'DD.MM.YYYY'));
               if (tmpVacation.dat2 <> ZeroDate)
                 pXL.SetTblStringFldValue('dat2'       , '''' + DateToStr(tmpVacation2.dat2    , 'DD.MM.YYYY'));
               //pXL.SetTblStringFldValue('sFoundation', tmpVacation2.sFoundation);
             }

           pXL.InsTblRow;
           isIns := true;
         }

       if (NOT isIns) */
         pXL.InsTblRow;
         sLn := fAppTabN;
     }
}

//*****************************************************************************
Procedure PrintRepost;
{
  ID := 'Vacation';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpVacation));

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'           , CommonFormHeader);
  var sFullNameOrg : string; sFullNameOrg := ''; 
  pXL.SetStringVar('org'           , oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', StrToDate(dDateDoc, 'DD/MM/YYYY')));

  if (GetFirst KatOrg where ((coGetTune('MyOrg') == KatOrg.NRec)) = tsOk)
    {
      pXL.SetStringVar('OKPO'        , '''' + KatOrg.Okpo);


      if sGetAttr(coKatOrg,KatOrg.Nrec,VA_KatOrg_FullNAME) = ''
        then pXL.SetStringVar('orgS', KatOrg.ShortName)
        else pXL.SetStringVar('orgS', sGetAttr(coKatOrg,KatOrg.Nrec,VA_KatOrg_FullNAME));

      if (Trim(KatOrg.Name) <> '')
        pXL.SetStringVar('orgS2'     , '(' + KatOrg.Name + ')');
    }

  pXL.SetStringVar('NumDoc'        , '''' + sNumDoc );
  pXL.SetStringVar('DateDoc'       , '''' + Replace(dDateDoc, '/', '.'));

  pXL.SetStringVar('SoglFIO'       , sSogls);
  pXL.SetStringVar('SoglDol'       , sSoglsDol);
  pXL.SetStringVar('Sogl2FIO'      , sSogls2);
  pXL.SetStringVar('Sogl2Dol'      , sSogls2Dol);
  pXL.SetStringVar('UtvrFIO'       , sUtve);
  pXL.SetStringVar('UtvrDol'       , sUtveDol);
  pXL.SetStringVar('sPodpis1FIO'   , sPodpis1);
  pXL.SetStringVar('sPodpis1Dol'   , sPodpis1Dol);
  pXL.SetStringVar('sPodpis2FIO'   , sPodpis2);
  pXL.SetStringVar('sPodpis2Dol'   , sPodpis2Dol);

  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('tblVacation');
  pXL.CreateTblFld('npp');
  pXL.CreateTblFld('sFIO');
  pXL.CreateTblFld('TabNum');
  pXL.CreateTblFld('sPodr');
  pXL.CreateTblFld('sDol');
  pXL.CreateTblFld('OtpTypeOs');
  pXL.CreateTblFld('OtpTypeDop');
  pXL.CreateTblFld('dPeriod1');
  pXL.CreateTblFld('dPeriod2');
  pXL.CreateTblFld('iDays');
  pXL.CreateTblFld('iDays_rab');
  pXL.CreateTblFld('iDaysDop');
  pXL.CreateTblFld('myType');
  pXL.CreateTblFld('dat1');
  pXL.CreateTblFld('dat2');
  pXL.CreateTblFld('sFoundation');

  PrintLine;

  pXL.PublishTbl('tblVacation');

  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);
}

HandleEvent

cmInit: 
  {
    RunInterface(iEMGetNastrPodp, wType);

    if (NOT ReadMyDsk(sSogls     , nameNastr + '_sSogls', true))
      sSogls := '';

    if (NOT ReadMyDsk(sSoglsDol  , nameNastr + '_sSoglsDol', true))
      sSoglsDol := '';

    if (NOT ReadMyDsk(sSogls2    , nameNastr + '_sSogls2', true))
      sSogls2 := '';

    if (NOT ReadMyDsk(sSogls2Dol , nameNastr + '_sSogls2Dol', true))
      sSogls2Dol := '';

    if (NOT ReadMyDsk(sUtve      , nameNastr + '_sUtve', true))
      sUtve := '';

    if (NOT ReadMyDsk(sUtveDol   , nameNastr + '_sUtveDol', true))
      sUtveDol := '';

    if (NOT ReadMyDsk(sPodpis2   , nameNastr + '_sOtv', true))
      sPodpis2 := '';

    if (NOT ReadMyDsk(sPodpis2Dol, nameNastr + '_sOtvDol', true))
      sPodpis2Dol := '';

    if (NOT ReadMyDsk(sPodpis2Npp, nameNastr + '_sPodpis2Npp', true))
      sPodpis2Npp := '';

    if (NOT ReadMyDsk(sPodpis1   , nameNastr + '_sPodpis1', true))
      sPodpis1 := '';

    if (NOT ReadMyDsk(sPodpis1Dol, nameNastr + '_sPodpis1Dol', true))
      sPodpis1Dol := '';

    if (NOT ReadMyDsk(sPodpis1Npp, nameNastr + '_sPodpis1Npp', true))
      sPodpis1Npp := '';

    wCountry := wGetTune('COUNTRY');
    InitTable;
    PrintRepost;
  }

end;
end.
