function OpenNewRKS : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExistRKS : boolean;
{
  result := false;
  if xlOpenExcel(true)
  {
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlOpenWorkBook(sToExistFile)
      result := true;
  }
}

function SetParam5k : boolean;
{
  result := false;
  if RunWindowModal(Win5KParam)=cmDefault
    result := true;
}
procedure PrintRash;
{
  var lLine : longint;
  var lRB, lRE, lCB, lCE : longint = 1;
  var sAgeT: string;
  var dAge : date;
  var wDays, wMonths, wYears : word;


  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Печать расшифровки.', 0);
  lRB := lRE := 2;
  lCB := 1;
  lLine:=0;
  xlMergeCells(1,1,1,4);
  xlSetCellStringValue('Расшифровка листа 5. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
//  message(Year(dRep));
  delete all from mtPsn5K2Del where ((word(Year(dRep)-1) == mtPsn5K2Del.wYear));//mtPsn5K2Del.wYear <> Year(dRep);
  if isvalid(#ttPsn5K)
  {
    lCE := 0;
    //'+chr(10)+'
    //, sTBN    : string[20] 
   //, sFIO    : string[60] 
   //, sPodr   : string

    //
    lCE++; xlSetCellStringValue('Номер'+chr(10)+'сторки'+chr(10)+'отчета',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Табельный'+chr(10)+'номер',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Подразделение',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'приема'+chr(10)+'на работу',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'увольнения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Возраст',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Год',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Номер и наименование РПД',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'приказа по персоналу'+chr(10)+'оформления пенсии'+chr(10)+'начала выплат в НПФ',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Номер приказа'+chr(10)+'по персоналу',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'начала',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'конца', lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'отмены',lRE,lCE,lRE,lCE);
    lRE++;

    var lRecCount: longint = recordsintable(#ttPsn5K);
    xlSetNumberFormat('@', lRE, 2, lRE+lRecCount, 2);
    xlSetNumberFormat('@', lRE, 4, lRE+lRecCount, 4);
    var wMatrixSizeRow: word = 100;
    if (not xlCreateMatrix(wMatrixSizeRow, lCE))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    var lRowMatrix: longint = 1;
    var lRowCurMx : longint = lRE;

    #define FrmCl lRowMatrix, lCE
    _loop ttPsn5K ordered index ttPsn5K02
    {
//      if ( wFromExistFile = 1 )
//        if ( ttPsn5K.wYear < Year(dRep) )
//          continue;
      if (not NextVisual) break;
      lCE := 0;
      lCE++; xlStWriteToMatrix(#FrmCl, ttPsn5K.wRow);
      lCE++; xlStWriteToMatrix(#FrmCl, ttPsn5K.sTBN);
      lCE++; xlStWriteToMatrix(#FrmCl, ttPsn5K.sFIO);
      lCE++; xlStWriteToMatrix(#FrmCl, ttPsn5K.sPodr);
      lCE++; if ( ttPsn5K.dApp <> 0 ) xlDtWriteToMatrix(#FrmCl, ttPsn5K.dApp);
      lCE++; if ( ttPsn5K.dDiss <> 0 ) xlDtWriteToMatrix(#FrmCl, ttPsn5K.dDiss);
      lCE++; xlStWriteToMatrix(#FrmCl, ttPsn5K.wAge);
      lCE++; xlStWriteToMatrix(#FrmCl, ttPsn5K.wYear);
      lCE++; xlStWriteToMatrix(#FrmCl, ttPsn5K.iKodRPD+' '+ttPsn5K.sNameRPD);
      lCE++; if ( ttPsn5K.dDateRPD <> 0 ) xlDtWriteToMatrix(#FrmCl, ttPsn5K.dDateRPD);
      lCE++; xlStWriteToMatrix(#FrmCl, ttPsn5K.sNmbRPD);
      lCE++; if ( ttPsn5K.dBeg <> 0 ) xlDtWriteToMatrix(#FrmCl, ttPsn5K.dBeg);
      lCE++; if ( ttPsn5K.dEnd <> 0 ) xlDtWriteToMatrix(#FrmCl, ttPsn5K.dEnd);
      lCE++; if ( ttPsn5K.dStop <> 0 ) xlDtWriteToMatrix(#FrmCl, ttPsn5K.dStop);
/*
      lCE++; xlSetCellStringValue(ttPsn5K.wRow                                                       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttPsn5K.sTBN               ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttPsn5K.sFIO                                                       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttPsn5K.sPodr              ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(if(ttPsn5K.dApp    <>0,datetostr(ttPsn5K.dApp    ,'DD.MM.YYYY'),''),lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(if(ttPsn5K.dDiss   <>0,datetostr(ttPsn5K.dDiss   ,'DD.MM.YYYY'),''),lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttPsn5K.wAge                                                       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttPsn5K.wYear                                                      ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttPsn5K.iKodRPD+' '+ttPsn5K.sNameRPD                               ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(if(ttPsn5K.dDateRPD<>0,datetostr(ttPsn5K.dDateRPD,'DD.MM.YYYY'),''),lRE,lCE,lRE,lCE);
      lCE++; xlSetCellStringValue(ttPsn5K.sNmbRPD                                                    ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellDateValue(ttPsn5K.dBeg                                                       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellDateValue(ttPsn5K.dEnd                                                       ,lRE,lCE,lRE,lCE);
      lCE++; xlSetCellDateValue(ttPsn5K.dStop                                                      ,lRE,lCE,lRE,lCE);
*/

      lRE++;
      lRowMatrix++;
      
      if ( lRowMatrix > wMatrixSizeRow )
      {
        if (not xlWriteMatrixToExcel(lRowCurMx, 1))
          message('Ошибка функции xlWriteMatrixToExcel.', error);
        xlFreeMatrix;
        lRowCurMx += wMatrixSizeRow;
        lRowMatrix := 1;
        if (not xlCreateMatrix(wMatrixSizeRow, lCE))
        {
          message('Ошибка функции xlCreateMatrix.', error);
          xlKillExcel;
          StopVisual;
          exit;
        }
      }
    }
    if (not xlWriteMatrixToExcel(lRowCurMx, 1))
      message('Ошибка функции xlWriteMatrixToExcel.', error);
    xlFreeMatrix;
  }
  lRE--;
//  xlWrapText(lRB,lCB,lRB,lCE);
  xlAutoFit(lRB/*+1*/,lCB,lRE,lCE);
  xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
  xlSetCellStringValue('Версия отчета 20181003_1200', lRE+3, 1, lRE+3, 1);
  xlSetFontSize( 5, lRE+3, 1, lRE+3, 1);
  StopVisual;
}

procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  init5K;

  if isStayAlone
    if SetParam5k
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);

  if isDoRep
  {
    Make5K;
//    PostProcess5K;
    if isData5K
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNewRKS  ;}
        if wToExistFile = 1 {isOkFile := OpenExistRKS;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        Print5K;

        if (wPrintRash = 1) and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='5-к' break;
          }
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 5-К'); 
          xlSetActiveSheet(i);
          PrintRash;
        }

        xlSetActiveSheetByName('5-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }
    else if isStayAlone message('Нет данных для отчета.');
  }
  Save5K;
  Clear5K;
  closeinterface(cmDefault);
}
