#include Padezh.vih
#component "F_Common"

#doc
Доработка интерфейса "Редактирование группы подписантов"
#end
//---------------------------------------------
Alter Interface iPositionManual;
//---------------------------------------------
#include FeeSigners.inc
//---------------------------------------------

OverLoad
function GetBoundConst (arwNumber: word): word;
Function oPositionManual.GetPositionName (cComp: comp; pFlag: word; _cSelPick : comp=0): string;
Procedure SetFioPersons;
Procedure SetFioModify2;
Function oPositionManual.InitInter: boolean;
end;

//---------------------------------------------
Create view
//---------------------------------------------
from
   PersPod _PersonsPodPosition1
  ,PersPod _PersonsPodPosition2
  ,PersPod _PersonsPodPosition3
  ,PersPod _PersonsPodPosition4
  ,PersPod _PersonsPodPosition5
  ,PersPod _PersonsPodPosition6
where ((
      GetBoundConst(word(41))    == _PersonsPodPosition1.TipMode
  and KatSigner.nRec             == _PersonsPodPosition1.cPersons

  and GetBoundConst(word(42))    == _PersonsPodPosition2.TipMode
  and KatSigner.nRec             == _PersonsPodPosition2.cPersons

  and GetBoundConst(word(43))    == _PersonsPodPosition3.TipMode
  and KatSigner.nRec             == _PersonsPodPosition3.cPersons

  and GetBoundConst(word(44))    == _PersonsPodPosition4.TipMode
  and KatSigner.nRec             == _PersonsPodPosition4.cPersons

  and GetBoundConst(word(45))    == _PersonsPodPosition5.TipMode
  and KatSigner.nRec             == _PersonsPodPosition5.cPersons

  and GetBoundConst(word(46))    == _PersonsPodPosition6.TipMode
  and KatSigner.nRec             == _PersonsPodPosition6.cPersons
));

//---------------------------------------------
//--- так для проформы
//---------------------------------------------
function GetBoundConst (arwNumber: word): word;
{
  if KatSigner.TypeOwn=toPersons and arwNumber>40
  { Result:=arwNumber
  }
  else Result:=Inherited::GetBoundConst (arwNumber);
} // function GetBoundConst

//---------------------------------------------
// Забираем целиком
//---------------------------------------------
Function oPositionManual.GetPositionName (cComp: comp; pFlag: word; _cSelPick : comp=0): string;
{
  var vsResult: string;
  vsResult := '';

  SetGetParam(cComp,_cSelPick);

  if _cSelPick <> 0
  {
    vsResult := sGetAttr(coSelPicks, _cSelPick, 'Подписант_Должность_П' + string(pFlag));
    if vsResult <> ''
    {
      GetPositionName := vsResult;
      exit;
    }
  }

  case (KatSigner.TypeOwn) of
    toPersons:
    {
      case (pFlag) of
        1:
        {
          vsResult := sGetAttr(coMnSpAdd, KatSigner.Nrec, 'должность');
          //GP
          if vsResult = ''
            if isValid(tn_PersonsPodPosition1)
              if _PersonsPodPosition1.FIO <> ''
               vsResult := _PersonsPodPosition1.FIO;
          //end GP
          if vsResult = ''
            if isValid(tnPersonsPodPosition1)
              if PersonsPodPosition1.FIO <> ''
              vsResult := PersonsPodPosition1.FIO;

          if vsResult = ''
            if isValid(tnCatalogs)
              vsResult :=  Catalogs.Name;

          if vsResult = ''
            vsResult := GetPersonDolg(KatSigner.cOwner);
        }
        2:
        { if isValid(tn_PersonsPodPosition2)
            vsResult :=_PersonsPodPosition2.FIO;
          if vsResult=''
          vsResult := if(isValid(tnPersonsPodPosition2), PersonsPodPosition2.FIO, '');
        }
        3:
        { if isValid(tn_PersonsPodPosition3)
            vsResult :=_PersonsPodPosition3.FIO;
          if vsResult=''
          vsResult := if(isValid(tnPersonsPodPosition3), PersonsPodPosition3.FIO, '');
        }
        4:
        { if isValid(tn_PersonsPodPosition4)
            vsResult :=_PersonsPodPosition4.FIO;
          if vsResult=''
          vsResult := if(isValid(tnPersonsPodPosition4), PersonsPodPosition4.FIO, '');
        }
        5:
        { if isValid(tn_PersonsPodPosition5)
            vsResult :=_PersonsPodPosition5.FIO;
          if vsResult=''
          vsResult := if(isValid(tnPersonsPodPosition5), PersonsPodPosition5.FIO, '');
        }
        6:
        { if isValid(tn_PersonsPodPosition6)
            vsResult :=_PersonsPodPosition6.FIO;
          if vsResult=''
          vsResult := if(isValid(tnPersonsPodPosition6), PersonsPodPosition6.FIO, '');
        }
      end;
    } // toPersons
    toPersPod:
    {
      case (pFlag) of
        1:
        {
          vsResult := sGetAttr(coMnSpAdd, KatSigner.Nrec, 'должность');
          if vsResult = ''
            vsResult := if(isValid(tnPersPodPosition1), PersPodPosition1.FIO, '');
        }
        2: vsResult := if(isValid(tnPersPodPosition2), PersPodPosition2.FIO, '');
        3: vsResult := if(isValid(tnPersPodPosition3), PersPodPosition3.FIO, '');
        4: vsResult := if(isValid(tnPersPodPosition4), PersPodPosition4.FIO, '');
        5: vsResult := if(isValid(tnPersPodPosition5), PersPodPosition5.FIO, '');
        6: vsResult := if(isValid(tnPersPodPosition6), PersPodPosition6.FIO, '');
      end;
    } // toPersPod
  end;

  GetPositionName := vsResult;
} // function GetPositionName


//---------------------------------------------
// Забираем целиком
//---------------------------------------------
Procedure SetFioPersons;
{
  if true // isValid(tnCatalogs)
  {
    if (getFirst _PersonsPodPosition1 != tsOk)
    {
      clearbuffer(#_PersonsPodPosition1);
      if Length(Fio1) > 60// ограничение поля в таблице
      {
        sSetAttr(coMnSpAdd, KatSigner.Nrec, 'должность', Fio1);
        _PersonsPodPosition1.FIO := '';
      }
      else
      {
        _PersonsPodPosition1.FIO := Fio1;
        ExtAttr_DeleteValue(coMnSpAdd, KatSigner.Nrec, 'должность');
      }
      _PersonsPodPosition1.cPersons :=  KatSigner.Nrec;//Catalogs.nRec;
      _PersonsPodPosition1.TipMode  :=  cgCommisPositionManual1+20;
      if insert current  _PersonsPodPosition1 <> tsOk {};
    }
    if (getFirst _PersonsPodPosition2 != tsOk)
    {
      clearbuffer(#_PersonsPodPosition2);
      _PersonsPodPosition2.FIO := Fio2;
      _PersonsPodPosition2.cPersons :=  KatSigner.Nrec;//Catalogs.nRec;
      _PersonsPodPosition2.TipMode  :=  cgCommisPositionManual2+20;
      if insert current  _PersonsPodPosition2 <> tsOk {};
    }
    if (getFirst _PersonsPodPosition3 != tsOk)
    {
      clearbuffer(#_PersonsPodPosition3);
      _PersonsPodPosition3.FIO := Fio3;
      _PersonsPodPosition3.cPersons :=  KatSigner.Nrec;//Catalogs.nRec;
      _PersonsPodPosition3.TipMode  :=  cgCommisPositionManual3+20;
       if insert current  _PersonsPodPosition3 <> tsOk {};
    }
    if (getFirst _PersonsPodPosition4 != tsOk)
    {
      clearbuffer(#_PersonsPodPosition4);
      _PersonsPodPosition4.FIO := Fio4;
      _PersonsPodPosition4.cPersons :=  KatSigner.Nrec;//Catalogs.nRec;
      _PersonsPodPosition4.TipMode  :=  cgCommisPositionManual4+20;
       if insert current  _PersonsPodPosition4 <> tsOk {};
    }
    if (getFirst _PersonsPodPosition5 != tsOk)
    {
      clearbuffer(#_PersonsPodPosition5);
      _PersonsPodPosition5.FIO := Fio5;
      _PersonsPodPosition5.cPersons :=  KatSigner.Nrec;//Catalogs.nRec;
      _PersonsPodPosition5.TipMode  :=  cgCommisPositionManual5+20;
       if insert current  _PersonsPodPosition5 <> tsOk {};
    }
    if (getFirst _PersonsPodPosition6 != tsOk)
    {
      clearbuffer(#_PersonsPodPosition6);
      _PersonsPodPosition6.FIO := Fio6;
      _PersonsPodPosition6.cPersons :=  KatSigner.Nrec;//Catalogs.nRec;
      _PersonsPodPosition6.TipMode  :=  cgCommisPositionManual6+20;
       if insert current  _PersonsPodPosition6 <> tsOk {};
    }
  }
} // procedure SetFioPersons

Procedure SetFioModify2;
{
  RereadRecord;

  if cSelPick <> 0
  {
    if _PersonsPodPosition1.Fio <> FIO1
      sSetAttr(coSelPicks, cSelPick, 'Подписант_Должность_П1', FIO1);
    if _PersonsPodPosition2.Fio <> FIO2
      sSetAttr(coSelPicks, cSelPick, 'Подписант_Должность_П2', FIO2);
    if _PersonsPodPosition3.Fio <> FIO3
      sSetAttr(coSelPicks, cSelPick, 'Подписант_Должность_П3', FIO3);
    if _PersonsPodPosition4.Fio <> FIO4
      sSetAttr(coSelPicks, cSelPick, 'Подписант_Должность_П4', FIO4);
    if _PersonsPodPosition5.Fio <> FIO5
      sSetAttr(coSelPicks, cSelPick, 'Подписант_Должность_П5', FIO5);
    if _PersonsPodPosition6.Fio <> FIO6
      sSetAttr(coSelPicks, cSelPick, 'Подписант_Должность_П6', FIO6);
  }
  else
  {
    if Length(Fio1) > 60// ограничение поля в таблице
    {
      sSetAttr(coMnSpAdd, KatSigner.Nrec, 'должность', Fio1);
      _PersonsPodPosition1.FIO := '';
    }
    else
    {
      _PersonsPodPosition1.FIO := Fio1;
      ExtAttr_DeleteValue(coMnSpAdd, KatSigner.Nrec, 'должность');
    }
    if UpDate Current _PersonsPodPosition1 <> tsOk {};

    _PersonsPodPosition2.FIO   :=  FIO2;
    if UpDate Current _PersonsPodPosition2 <> tsOk {};

    _PersonsPodPosition3.FIO   :=  FIO3;
    if UpDate Current _PersonsPodPosition3 <> tsOk {};

    _PersonsPodPosition4.FIO   :=  FIO4;
    if UpDate Current _PersonsPodPosition4 <> tsOk {};

    _PersonsPodPosition5.FIO   :=  FIO5;
    if UpDate Current _PersonsPodPosition5 <> tsOk {};

    _PersonsPodPosition6.FIO   :=  FIO6;
    if UpDate Current _PersonsPodPosition6 <> tsOk {};
  }

} // procedure SetFioModify2

Function oPositionManual.InitInter: boolean;
{ Result:=Inherited::InitInter;
  if ( KatSigner.typeOwn = toPersons)
  {
    if (getFirst _PersonsPodPosition1 = tsOk) and
       (getFirst _PersonsPodPosition2 = tsOk) and
       (getFirst _PersonsPodPosition3 = tsOk) and
       (getFirst _PersonsPodPosition4 = tsOk) and
       (getFirst _PersonsPodPosition5 = tsOk) and
       (getFirst _PersonsPodPosition6 = tsOk)
      bPersons := true;
    else
      bPersons := false;
  }
} //Function InitInter: boolean;

//---------------------------------------------
//Изменение форматов
//---------------------------------------------
//ExtendFormats scPersPodPosition;
OverLoadFormats scPersPodPosition;
Screen scPersPodPosition (,,sci1Esc);
Table KatSigner;
Fields
  FIO1 ('Вариант написания должности №1',,) : noProtect;
  FIO2 ('Вариант написания должности №2',,) : noProtect;
  FIO3 ('Вариант написания должности №3',,) : noProtect;
  FIO4 ('Вариант написания должности №4',,) : noProtect;
  FIO5 ('Вариант написания должности №5',,) : noProtect;
  FIO6 ('Вариант написания должности №6',,) : noProtect;
    buttons
    cmValue1,,,
       'Применить изменения';
    cmCancel,,,
       'Отменить';
<<

`Именительный` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Родительный ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Дательный   ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Винительный ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Творительный` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Предложный  ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

                 <.Сохранить.>    <. Выход  .>

>>
end; // screen scPersPodPosition
end.
