/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*                РПД № 60 "Изменение режима работы"                                               *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Управление персоналом->Документы->Все приказы по персоналу->                     *
*                   Окно редактирования приказа =Приказ=->                                        *
*                   Контекстное меню <Печать групповой формы приказа>                             *
*                   Контекстное меню <Печать индивидуальной формы приказа>                        *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#172          |26/05/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
#include xlReport.vih
#include DeptIer.vih // получить всякие свойства по записи таблицы Catalogs
#include History.vih

Interface iEMChangeTimeWorkReport 'РПД № 60 "Изменение режима работы"'  escclose, cyan, doaccept;
  Show at (, , 60, 8);
//*****************************************************************************
#include History.var
//*****************************************************************************
Create view
var
  sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol
, sPodpis1Npp
, sPodpis2Npp            : string;

  sNumDoc
, dDateDoc
, ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;

  cTitleDoc          : comp; 

as select
  6
    (FieldName = wType)
, 'Em_Report_' + string(wType)
    (FieldName = nameNastr)
, *
from 
  tmpChangeTime
, KatOrg
, KlRejim
, Grafik
, SpGraf
, WorkPattern
, GP_WorkPatternExt
where 
((
    coGetTune('MyOrg')        == KatOrg.NRec
AND tmpChangeTime.WorkRegime  == KlRejim.NREJIM (NoIndex)
AND KlRejim.cCalendar         == Grafik.NRec
AND Grafik.Nrec               == SpGraf.cGrafik
AND SpGraf.cWorkPattern       == WorkPattern.NRec
AND WorkPattern.NRec          == GP_WorkPatternExt.cWorkPattern
))
;

Parameters
  sNumDoc
, dDateDoc
, cTitleDoc
;
//*****************************************************************************
var IDepartIer : DepartIer;  // иерархия подразделений
//*****************************************************************************
Procedure PrintLine;
{
   _LOOP tmpChangeTime
     if (Not NextVisual)
     {
       break; 
     }
     else   
     { 
       pXL.ClearTblBuffer;

       pXL.SetTblStringFldValue('FIO'         , tmpChangeTime.sFIO         );
       pXL.SetTblStringFldValue('FIO_VP'      , tmpChangeTime.sFIO_VP      );
       pXL.SetTblStringFldValue('TabNum'      , '''' + tmpChangeTime.TabNum);                                            
       pXL.SetTblStringFldValue('NumDoc'      , '''' + tmpChangeTime.NumDoc);                                            
       pXL.SetTblStringFldValue('DateDoc'     , '''' + tmpChangeTime.DateDoc);                                             
       pXL.SetTblStringFldValue('Dol'         , tmpChangeTime.Dol          );
       pXL.SetTblStringFldValue('Podr'        , tmpChangeTime.Podr         );
       pXL.SetTblStringFldValue('dBeg'        , '''' + tmpChangeTime.dBeg  );
       pXL.SetTblStringFldValue('dEnd'        , '''' + tmpChangeTime.dEnd  );
       pXL.SetTblStringFldValue('WorkRegime'  , tmpChangeTime.WorkRegime   );
       pXL.SetTblStringFldValue('cause'       , tmpChangeTime.cause        );
       
       var dWorkHours : double; dWorkHours := 0;
       var sholydays  : string; sHolydays  := '';
       var tmpTime    : double; tmpTime    := 0;
       var minBeg     : Time;   minBeg     := Time(0,0,0,0);
       var minEnd     : Time;   minEnd     := Time(0,0,0,0);
       var maxEnd     : Time;   maxEnd     := Time(0,0,0,0);
       var minDay     : string; minDay     := '';
       var lunchTimeB : time;   lunchTimeB := Time(0,0,0,0);
       var lunchTimeE : Time;   lunchTimeE := Time(0,0,0,0);

       if (GetFirst Grafik = tsOk)
         {
           _LOOP SpGraf 
             {
               if (SpGraf.DayChas = 0)
                 {
                   sHolydays += if (trim(sHolydays) = '', '', ', ') + 
                      icase(Year(SpGraf.dDate);'','понедельник','вторник','среда','четверг','пятница','суббота','воскресенье';'');
                 }
               else
                 {
                   dWorkHours += SpGraf.DayChas + SpGraf.DayMin / 60;
                   if (GetFirst WorkPattern = tsOk)
                     {
                       if (WorkPattern.tStartDay < minBeg OR minBeg = Time(0,0,0,0))
                         minBeg := WorkPattern.tStartDay;

                       if (WorkPattern.tEndDay <= minEnd OR minEnd = Time(0,0,0,0))
                         {
                           minEnd := WorkPattern.tEndDay;
                           minDay += if (trim(minDay) = '', '', ', ') + 
                                    icase(Year(SpGraf.dDate);'','понедельник','вторник','среда','четверг','пятница','суббота','воскресенье';'');
                         }

                       if (WorkPattern.tEndDay > maxEnd)
                         maxEnd := WorkPattern.tEndDay;

                       if (lunchTimeB = Time(0,0,0,0) AND lunchTimeE = Time(0,0,0,0))
                         {
                           lunchTimeB := GP_WorkPatternExt.StartBreak1;
                           lunchTimeE := GP_WorkPatternExt.EndBreak1;
                         }  
                     }
                 }   
             }  
                    
         }

       pXL.SetTblNumberFldValue('WorkHours'   , dWorkHours);
       pXL.SetTblStringFldValue('Holydays'    , sholydays);
       pXL.SetTblStringFldValue('beginWork'   , TimeToStr(minBeg, 'HH:MM'));
       pXL.SetTblStringFldValue('LanchTime'   , TimeToStr(lunchTimeB, 'HH:MM') + ' - '  + TimeToStr(lunchTimeE, 'HH:MM'));
       pXL.SetTblStringFldValue('endWork'     , TimeToStr(maxEnd, 'HH:MM'));
       pXL.SetTblStringFldValue('endFriday'   , TimeToStr(minEnd, 'HH:MM'));

       pXL.InsTblRow;                     
     }
}

//*****************************************************************************
Procedure PrintRepost;
{
  ID := 'ChangeTimeWorkReport';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpChangeTime));

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'           , CommonFormHeader);

  pXL.SetStringVar('org'           , oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', StrToDate(dDateDoc, 'DD/MM/YYYY')));
  if (GetFirst KatOrg = tsOk)
    pXL.SetStringVar('OKPO'        , '''' + KatOrg.Okpo);

  pXL.SetStringVar('Num'           , '''' + sNumDoc);
  pXL.SetStringVar('Date'          , '''' + Replace(dDateDoc, '/', '.'));

  pXL.SetStringVar('SoglFIO'       , sSogls);
  pXL.SetStringVar('SoglDol'       , sSoglsDol);
  pXL.SetStringVar('Sogl2FIO'      , sSogls2);
  pXL.SetStringVar('Sogl2Dol'      , sSogls2Dol);
  pXL.SetStringVar('UtvrFIO'       , sUtve);
  pXL.SetStringVar('UtvrDol'       , sUtveDol);
  pXL.SetStringVar('sPodpis1FIO'   , sPodpis1);
  pXL.SetStringVar('sPodpis1Dol'   , sPodpis1Dol);
  pXL.SetStringVar('sPodpis2FIO'   , sPodpis2);
  pXL.SetStringVar('sPodpis2Dol'   , sPodpis2Dol);

  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('TimeWork');
  pXL.CreateTblFld('FIO'       );
  pXL.CreateTblFld('FIO_VP'    );
  pXL.CreateTblFld('TabNum'    );
  pXL.CreateTblFld('NumDoc'    );
  pXL.CreateTblFld('DateDoc'   );
  pXL.CreateTblFld('Dol'       );
  pXL.CreateTblFld('Podr'      );
  pXL.CreateTblFld('dBeg'      );
  pXL.CreateTblFld('dEnd'      );
  pXL.CreateTblFld('WorkRegime');
  pXL.CreateTblFld('cause'     );
  pXL.CreateTblFld('WorkHours' );
  pXL.CreateTblFld('Holydays'  );
  pXL.CreateTblFld('beginWork' );
  pXL.CreateTblFld('LanchTime' );
  pXL.CreateTblFld('endWork'   );
  pXL.CreateTblFld('endFriday' );
  PrintLine;

  pXL.PublishTbl('TimeWork');

  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);
}

HandleEvent

cmInit: 
  {
    RunInterface(iEMGetNastrPodp, wType);

    if (NOT ReadMyDsk(sSogls     , nameNastr + '_sSogls', true))
      sSogls := '';

    if (NOT ReadMyDsk(sSoglsDol  , nameNastr + '_sSoglsDol', true))
      sSoglsDol := '';

    if (NOT ReadMyDsk(sSogls2    , nameNastr + '_sSogls2', true))
      sSogls2 := '';

    if (NOT ReadMyDsk(sSogls2Dol , nameNastr + '_sSogls2Dol', true))
      sSogls2Dol := '';

    if (NOT ReadMyDsk(sUtve      , nameNastr + '_sBoss', true))
      sUtve := '';

    if (NOT ReadMyDsk(sUtveDol   , nameNastr + '_sBossDol', true))
      sUtveDol := '';

    if (NOT ReadMyDsk(sPodpis2   , nameNastr + '_sPodpis2', true))
      sPodpis2 := '';

    if (NOT ReadMyDsk(sPodpis2Dol, nameNastr + '_sPodpis2Dol', true))
      sPodpis2Dol := '';

    if (NOT ReadMyDsk(sPodpis2Npp, nameNastr + '_sPodpis2Npp', true))
      sPodpis2Npp := '';

    if (NOT ReadMyDsk(sPodpis1   , nameNastr + '_sPodpis1', true))
      sPodpis1 := '';

    if (NOT ReadMyDsk(sPodpis1Dol, nameNastr + '_sPodpis1Dol', true))
      sPodpis1Dol := '';

    if (NOT ReadMyDsk(sPodpis1Npp, nameNastr + '_sPodpis1Npp', true))
      sPodpis1Npp := '';

    PrintRepost;
  }

end;
end.
