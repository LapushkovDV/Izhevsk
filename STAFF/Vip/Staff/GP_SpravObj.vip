#include FeeSigners.vih
#include RunStaj.vih
#include AdrFunc.vih
#include CatFunc.vih
#include StrFunc.vih
#include Academic.vih
#include EducFunc.vih
#include DeptIer.vih         // Функции работы с подразделениями
#include APPFUNCS.VIH
#include GP_DepFunc.vih

interface GP_SpravObj 'Справка-объективка (ЕМ)' escClose, Blue;
  show(20,10,90,17);

table struct tt4Sort
(
  sVar1 : string,
  sVar2 : string,
  sVar3 : string,
  sVar4 : string,
  sVar5 : string,
  dVar1 : date,
  dVar2 : date
)
with index
(
  tt4Sort01 = sVar1 + sVar2 + dVar1
, tt4Sort02 = dVar1 (Desc)
, tt4Sort03 = dVar1
);

#include FeeSigners.var
var
  iRunStaj: Runstaj;
  iAdrFunc: AddressFunc;
  iStrFunc: StringFunctions;
  iCatFunc: CatalogsFunctions;
  iDptFunc: DepartIer;
  iAcaFunc: InfoAcademic;
  iEduFunc: EducFunctions;
  iAppFuncs: AppointmentsFunctions;
#include GP_DepFunc.var
//    iDepFunc : GP_DepFunc;

create view
var
  cPersNr: comp;
  sSigner: string;
  __cAppRep: comp;
from
  persons
, appointments
, appointments AppOwn (APNTBYPERSON)
, catalogs  CatPost
, catalogs  CatDept
, catalogs  CatFamy
, EDUCATION EdMain
, catalogs  CatVidEdMain
, catalogs  CatNamEdMain
, catalogs  CatDocEdMain
, catalogs  CatSpcEdMain
, catalogs  CatKvlEdMain
, catalogs  CatDocML
, EDUCATION EdPer
, catalogs  CatPerVid
, catalogs  CatPerNam
, catalogs  CatPerTem
, EDUCATION EdPov
, catalogs  CatPovVid
, catalogs  CatPovNam
, catalogs  CatPovTem
// , badge
// , catalogs  catbadg
, lang
, catalogs  langn
, catalogs  langl
, planatt
, catalogs  attrez
, fortune
, catalogs  catfort
, punishments
, catalogs  catpunish
, catalogs  catProst
, experience
, catalogs  catExWork
, catalogs  catExPost
, AddressN  AddrBorn

, Appointments StajApp

, tt4Sort

where
((
                    cPersNr == persons.nrec
and               __cAppRep == appointments.nrec
and       appointments.POST == CatPost.nrec
and appointments.DEPARTMENT == CatDept.nrec
and     persons.FAMILYSTATE == CatFamy.nrec
     
and persons.nrec == EdMain.person
and            1 == EdMain.wType
and EdMain.LEVEL == CatVidEdMain.nrec
and  EdMain.NAME == CatNamEdMain.nrec
     
and                    -5 == CatDocML.SysCode
and         CatDocML.nrec == CatDocEdMain.cParent
and String(EdMain.SeqNmb) == CatDocEdMain.Code 
and     EdMain.SPECIALITY == CatSpcEdMain.nrec
and  EdMain.QUALIFICATION == CatKvlEdMain.nrec
     
and   persons.nrec == EdPer.person
and              3 == EdPer.wType
and    EdPer.LEVEL == CatPerVid.nrec
and     EdPer.Name == CatPerNam.nrec
and EdPer.cAddInf1 == CatPerTem.nrec
     
and   persons.nrec == EdPov.person
and              2 == EdPov.wType
and    EdPov.LEVEL == CatPovVid.nrec
and     EdPov.Name == CatPovNam.nrec
and EdPov.cAddInf1 == CatPovTem.nrec

/* 
and  persons.nrec == badge.person
and badge.appoint == catbadg.nrec
and (
      (catbadg.addinf = 'C+')                       //системные каталоги ученых званий/степеней
      or
      (catbadg.addinf = '' and catbadg.SYSCODE = 0) //добавленные пользователем каталоги ученых званий/степеней
    )
*/     
and  persons.nrec == lang.person
and lang.language == langn.nrec
and    lang.level == langl.nrec
    
and  persons.nrec == planatt.cpers
and planatt.cType == attrez.nrec
    
and   persons.nrec == fortune.cpers
and fortune.cFType == catfort.nrec
     
and       persons.nrec == punishments.cpsn
and punishments.cPType == catpunish.nrec
and punishments.cRef2  == catProst.nrec
     
and              persons.nrec == experience.person
and experience.ENTERPRISENAME == catExWork.nrec
and           experience.POST == catExPost.nrec

and persons.nrec == AppOwn.Person

and persons.nrec == AddrBorn.cPerson
and      word(3) == AddrBorn.ObjType         

and cPersNr == StajApp.Person

));
parameters
  cPersNr;

form frm('GP_SpravObj.pro', 'GP_SpravObj');

function sPsnStaj(_dEnd: date) : string;
var
  dBegSt, dEndSt: date = 0; // дата начала и конца работы по назначению
  lDays: longint = 0;       // количество дней стажа
  wYears, wMonths, wDays: word = 0;  
{
  result := '';

  _loop StajApp
  {
    //просматриваем все основные назначения по человеку 
    if ( StajApp.AppointDate > _dEnd or StajApp.LPrizn <> 0 )
      continue;
    
    dBegSt := StajApp.AppointDate;
    if ( StajApp.DismissDate <= _dEnd and StajApp.DismissDate <> 0 )
      dEndSt := StajApp.DismissDate
    else
      dEndSt := _dEnd;
    //вычисляем дни назначения по методике РФ
    lDays += longint(((Year (dEndSt) - Year (dBegSt)) * 360 +
                      (Month(dEndSt) - Month(dBegSt)) *  30 +
                      (Day  (dEndSt) - Day  (dBegSt)))) + 1;
  }
  wYears := DivI(lDays, 360);
  wMonths:= DivI(lDays mod 360, 30);
  wDays  := lDays mod 360 mod 30;
  if lDays = 0
    result := ''
  else
    result := if(wYears  <> 0, string(wYears )+' '+iStrFunc.DeclYMD(wYears,  ymdYears) +' ', '')
             +if(wMonths <> 0, string(wMonths)+' '+iStrFunc.DeclYMD(wMonths, ymdMonths)+' ', '')   
             +if(wDays   <> 0, string(wDays  )+' '+iStrFunc.DeclYMD(wDays,   ymdDays)      , '') ;
}

function sClearZeroInStaj(_sStajStr: string): string;
{
  result := if(pos('0 лет ', _sStajStr) = 1, Replace(_sStajStr, '0 лет ', ''), _sStajStr);
  result := Replace(result, ' 0 дней', '');//0 лет // 0 дней
}

procedure RunRep;
var
  s2Print: string;
  d2Print: date;
  sTitl:   string;
{
  frm.ReInit;
  if ( frm.Error ) exit;
  if isvalid(#persons)
  {
    s2Print := Persons.fio;
    frm.write(s2Print);
    set __cAppRep := iAppFuncs.GetAppNrec_OnDate(Persons.NRec, Cur_Date);
    if isvalid(#appointments)
    {
      if isvalid(#CatPost) {s2Print := CatPost.name} else {s2Print := ''}; frm.write(s2Print);
      //iDptFunc.GetFulDepName(CatDept.nRec)
//      if isvalid(#CatDept) {s2Print := trim(iCatFunc.GetCatalogsLongName(CatDept.nRec))+' ('+substr(CatDept.Code,1,3)+')'} else {s2Print := ''}; frm.write(s2Print);
//      if isvalid(#CatDept) {s2Print := Replace(iDptFunc.GetFulDepName(CatDept.nRec),'\',' ')+' ('+substr(CatDept.Code,1,3)+')'} else {s2Print := ''}; frm.write(s2Print);
      if isvalid(#CatDept) {s2Print := oGP_DepFunc.GetFullDepName(CatDept.nRec, DF_ADD_CODE + DF_CHK_ATTR, 1, ' ')} else {s2Print := ''}; frm.write(s2Print);
                            d2Print := Persons.BORNDATE;                   frm.write(if(d2Print<>0,datetostr(d2Print,'DD.MM.YYYY'),''));
      if isvalid(#AddrBorn){s2Print := iAdrFunc.GetFullAddressInd(AddrBorn.nRec);} else {s2Print := ''}; frm.write(s2Print);
      if isvalid(#CatFamy) {s2Print := CatFamy.name} else {s2Print := ''}; frm.write(s2Print);
      // education main 
      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      if isvalid(#EdMain)
      {
        _loop EdMain
        {
          if ( EdMain.TODATE > Cur_Date or EdMain.TODATE = 0 )
            continue;

          clearbuffer(#tt4Sort);
          if isvalid(#CatVidEdMain)   tt4Sort.sVar1 := CatVidEdMain.name;
          if isvalid(#CatNamEdMain)   tt4Sort.sVar2 := CatNamEdMain.name;
                                      tt4Sort.dVar1 := EdMain.TODATE;
/*
          if ( locase(trim(tt4Sort.sVar1)) = 'аспирантура' )
            if ( EdMain.TODATE < Cur_Date )
                                      tt4Sort.dVar1 := 0;
*/
          if isvalid(#CatDocML)
            if isvalid(#CatDocEdMain) tt4Sort.sVar3 := CatDocEdMain.name;
          if isvalid(#CatSpcEdMain)   tt4Sort.sVar4 := CatSpcEdMain.name;
          if isvalid(#CatKvlEdMain)   tt4Sort.sVar5 := CatKvlEdMain.name;
           
          insert current tt4Sort;
        }
      }
      sTitl := 'Образование, учреждение, год окончания';
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort01
        {
/*
          if ( tt4Sort.dVar1 > Cur_Date or tt4Sort.dVar1 = 0 )
            continue;
*/
          frm.write(sTitl); sTitl:='';
//          frm.write(tt4Sort.sVar1+', '+tt4Sort.sVar2+', год окончания: '+year(tt4Sort.dVar1));
          frm.write(tt4Sort.sVar1+', '+tt4Sort.sVar2+if(year(tt4Sort.dVar1) <> 0, ', '+year(tt4Sort.dVar1), ''));
        }
      } else {frm.write(sTitl);frm.write('');}
      frm.putevent(febreak);
      
      sTitl := 'Специальность/квалификация по диплому';
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort02
        {
          frm.write(sTitl); sTitl:='';
//          frm.write('Документ: ' + tt4Sort.sVar3+', специальность: '+tt4Sort.sVar4+', квалификация: '+tt4Sort.sVar5);
          frm.write(tt4Sort.sVar4+' / '+tt4Sort.sVar5);
        }
      } else {frm.write(sTitl);frm.write('');}
      frm.putevent(febreak);

      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      if isvalid(#EdPer)
      {
        _loop EdPer
        {
          clearbuffer(#tt4Sort);
          if isvalid(#CatPerVid)    tt4Sort.sVar1 := CatPerVid.name;
          if isvalid(#CatPerNam)    tt4Sort.sVar2 := CatPerNam.name;
          if isvalid(#CatPerTem)    tt4Sort.sVar3 := CatPerTem.name;
                                    tt4Sort.dVar1 := EdPer.TODATE;
          insert current tt4Sort;
        }
      }
      sTitl := 'Профессиональная переподготовка';
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort02
        {
          frm.write(sTitl); sTitl:='';
          // frm.write(tt4Sort.sVar1+', '+tt4Sort.sVar2+', тема: '+tt4Sort.sVar3+', год окончания: '+year(tt4Sort.dVar1));
          frm.write( tt4Sort.sVar2
                    +if(tt4Sort.sVar3 = '', '', ', '+tt4Sort.sVar3)
                    +if(tt4Sort.dVar1 = 0, '', ', '+To_Char(year(tt4Sort.dVar1))));
        }
      } else {frm.write(sTitl);frm.write('');}
      frm.putevent(febreak);


      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      if isvalid(#EdPov)
      {
        _loop EdPov
        {
          clearbuffer(#tt4Sort);
          if isvalid(#CatPovVid)    tt4Sort.sVar1 := CatPovVid.name;
          if isvalid(#CatPovNam)    tt4Sort.sVar2 := CatPovNam.name;
          if isvalid(#CatPovTem)    tt4Sort.sVar3 := CatPovTem.name;
                                    tt4Sort.dVar1 := EdPov.TODATE;
          insert current tt4Sort;
        }
      }
      sTitl := 'Повышение квалификации';
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort02
        {
          frm.write(sTitl); sTitl:='';
          // frm.write(tt4Sort.sVar1+', '+tt4Sort.sVar2+', тема: '+tt4Sort.sVar3+', год окончания: '+year(tt4Sort.dVar1));
          frm.write( tt4Sort.sVar2
                    +if(tt4Sort.sVar3 = '', '', ', '+tt4Sort.sVar3)
                    +if(tt4Sort.dVar1 = 0, '', ', '+To_Char(year(tt4Sort.dVar1))));
        }
      } else {frm.write(sTitl);frm.write('');}
      frm.putevent(febreak);

      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      
      // Ученые степени и т.д.
      var sAcaRange, sAcaName: string;//  = '';
      var dAcaDate: date;//  = 0;
      sAcaRange := iEduFunc.GetNameDegree(cPersNr, 2);
      if ( sAcaRange <> '' )
      {
        sAcaName := iEduFunc.GetNameOrg(cPersNr, 2);
        dAcaDate := iEduFunc.GetDateDegree(cPersNr, 2);
        clearbuffer(#tt4Sort);
        tt4Sort.sVar1 := sAcaRange
                       + if(dAcaDate = 0, '', ', '+DateToStr(dAcaDate,'DD.MM.YYYY'))
                       + if(sAcaName = '', '', ', '+sAcaName);
        insert current tt4Sort;
        sAcaRange := sAcaName := '';
        dAcaDate  := 0;
      }
      sAcaRange := iEduFunc.GetNameDegree(cPersNr, 10);
      if ( sAcaRange <> '' )
      {
        sAcaName := iEduFunc.GetNameOrg(cPersNr, 10);
        dAcaDate := iEduFunc.GetDateDegree(cPersNr, 10);
        clearbuffer(#tt4Sort);
        tt4Sort.sVar1 := sAcaRange
                       + if(dAcaDate = 0, '', ', '+DateToStr(dAcaDate,'DD.MM.YYYY'))
                       + if(sAcaName = '', '', ', '+sAcaName);
        insert current tt4Sort;
        sAcaRange := sAcaName := '';
        dAcaDate  := 0;
      }
      sAcaRange := iEduFunc.GetNameAcademRank(cPersNr);
      if ( sAcaRange <> '' )
      {
        sAcaName := iEduFunc.GetNameOrgAcademRank(cPersNr);
        dAcaDate := iEduFunc.GetDateAcademRank(cPersNr);
        clearbuffer(#tt4Sort);
        tt4Sort.sVar1 := sAcaRange
                       + if(dAcaDate = 0, '', ', '+DateToStr(dAcaDate,'DD.MM.YYYY'))
                       + if(sAcaName = '', '', ', '+sAcaName);
        insert current tt4Sort;
        sAcaRange := sAcaName := '';
        dAcaDate  := 0;
      }
      sTitl := 'Ученая степень, ученое звание';
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort01
        {
          frm.write(sTitl); sTitl:='';
          frm.write(tt4Sort.sVar1);
        }
      } else {frm.write(sTitl);frm.write('');}
      frm.putevent(febreak);

      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      if isvalid(#lang)
      {
        _loop lang
        {
          clearbuffer(#tt4Sort);
          if isvalid(#langn)    tt4Sort.sVar1 := langn.name;
          if isvalid(#langl)    tt4Sort.sVar2 := langl.name;
          insert current tt4Sort;
        }
      }
      sTitl := 'Знание иностранного языка';
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort01 
        {
          frm.write(sTitl); sTitl:='';
          frm.write(tt4Sort.sVar1+', '+tt4Sort.sVar2);
        }
      } else {frm.write(sTitl);frm.write('');}
      frm.putevent(febreak);

      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      if isvalid(#planatt)
      {
        _loop planatt
        {
          clearbuffer(#tt4Sort);
          if isvalid(#attrez)   tt4Sort.sVar1 := attrez.name;
                                tt4Sort.dVar1 := planatt.dat1;
          insert current tt4Sort;
        }
      }
      sTitl := 'Аттестация';
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort02
        {
          frm.write(sTitl); sTitl:='';
          frm.write(if(tt4Sort.dVar1<>0,datetostr(tt4Sort.dVar1,'DD.MM.YYYY'),'')+', '+tt4Sort.sVar1);
        }
      } else {frm.write(sTitl);frm.write('');}
      frm.putevent(febreak);

      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      if isvalid(#fortune)
      {
        _loop fortune
        {
          clearbuffer(#tt4Sort);
          if isvalid(#catfort)  tt4Sort.sVar1 := catfort.name;
                                tt4Sort.dVar1 := fortune.DocDate;
          insert current tt4Sort;
        }
      }
      sTitl := 'Профессиональные достижения, награды';
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort02
        {
          frm.write(sTitl); sTitl:='';
          frm.write(if(tt4Sort.dVar1<>0,datetostr(tt4Sort.dVar1,'DD.MM.YYYY'),'')+', '+tt4Sort.sVar1);
        }
      } else {frm.write(sTitl);frm.write('');}
      frm.putevent(febreak);

      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      if isvalid(#punishments)
      {
        _loop punishments
        {
          clearbuffer(#tt4Sort);
          if isvalid(#catpunish)  tt4Sort.sVar1 := catpunish.name;
          if isvalid(#catProst)   tt4Sort.sVar2 := catProst.name;
                                  tt4Sort.dVar1 := punishments.docdate;
                                  tt4Sort.sVar3 := punishments.docnmb;
          insert current tt4Sort;
        }
      }
      sTitl := 'Имеет ли дисциплинарные взыскания';
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort02
        {
          frm.write(sTitl); sTitl:='';
          frm.write('Взыскание: '+tt4Sort.sVar1+', за: '+tt4Sort.sVar2+', приказ от '+if(tt4Sort.dVar1<>0,datetostr(tt4Sort.dVar1,'DD.MM.YYYY'),'')+' № '+tt4Sort.sVar3);
        }
      } else {frm.write(sTitl);frm.write('');}
      frm.putevent(febreak);

//      frm.write('Общий стаж: '+iRunStaj.RunStrStaj(persons.nrec, 61, 0));
      frm.write('Общий стаж: '+sClearZeroInStaj(iRunStaj.NRunStrStajBoln(persons.nrec, iCatFunc.GetCatalogsNRec(1456), Cur_Date)));
      var sEM_Staj: string = iRunStaj.RunStrStaj(persons.nrec, 89, 0);
      frm.write('На предприятии: '+if(sEM_Staj <> '', sEM_Staj, sPsnStaj(Cur_Date))); 

      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      if isvalid(#experience)
      {
        _loop experience
        {
          clearbuffer(#tt4Sort);
          if isvalid(#catExWork)  tt4Sort.sVar1 := catExPost.name;
          if isvalid(#catExPost)  tt4Sort.sVar2 := catExWork.name;
                                  tt4Sort.dVar1 := experience.ENTRANCEDATE;
                                  tt4Sort.dVar2 := experience.RETIREMENTDATE;
          insert current tt4Sort;
        }
      }
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort03//tt4Sort02
        {
          frm.write(if(tt4Sort.dVar1<>0,datetostr(tt4Sort.dVar1,'DD.MM.YYYY'),''));
          frm.write(if(tt4Sort.dVar2<>0,datetostr(tt4Sort.dVar2,'DD.MM.YYYY'),''));
          frm.write(tt4Sort.sVar1+', '+tt4Sort.sVar2);
        }
      }// else {frm.write('');frm.write('');frm.write('');}
      if isvalid(#tt4Sort) {delete all from tt4Sort;}
      if isvalid(#AppOwn)
      {
        _loop AppOwn
        {
          clearbuffer(#tt4Sort);
          tt4Sort.sVar1 := iCatFunc.GetCatalogsName(AppOwn.Post);
          var sAppAddInf: string = if(AppOwn.LPrizn = 2,
                                      ' (совмещение должностей)', 
                                      if(AppOwn.LPrizn = 3 , ' (внутреннее совместительство)',''));
          tt4Sort.sVar2 := oGP_DepFunc.GetFullDepName(AppOwn.Department, DF_ADD_CODE + DF_CHK_ATTR, 1, ' ')
                          +' АО "НПО Энергомаш"'
                          +sAppAddInf;
          tt4Sort.dVar1 := AppOwn.AppointDate;
          tt4Sort.dVar2 := AppOwn.DismissDate;
          if ( AppOwn.LPrizn = 2 )
            tt4Sort.dVar2 := AppOwn.DateEnd;
          insert current tt4Sort;
        }
      }
      if isvalid(#tt4Sort)
      {
        _loop tt4Sort ordered index tt4Sort03//tt4Sort02
        {
          frm.write(if(tt4Sort.dVar1<>0,datetostr(tt4Sort.dVar1,'DD.MM.YYYY'),''));
          frm.write(if(tt4Sort.dVar2<>0,datetostr(tt4Sort.dVar2,'DD.MM.YYYY'),''));
          frm.write(tt4Sort.sVar1+', '+tt4Sort.sVar2);
        }
      } else {frm.write('');frm.write('');frm.write('');}
      frm.putevent(febreak);

      if iFeeSigners.GetSignerFirst
      {
        do
        {
          frm.write(iFeeSigners.GetSignerPosition(1));
          frm.write(iStrFunc.GetFIO(iFeeSigners.GetSignerFIO(1)));
        } while iFeeSigners.GetSignerNext;
      }
      frm.putevent(febreak);
    }
  }
  frm.ShowFile;
}


Panel p1
  Show At (,,,);
    Screen s1(,,sci1Esc);
      fields
        sSigner('Подписант',,sci13Esc):protect,pickbutton;
      buttons
        cmOk,,,'Запуск',,;
        cmCancel,,,'Выход',,;
      << 'Параметры отчета'

       `Подписант`
        .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

       <. ~С~формировать .>                         <. ~З~акрыть .>
      >>
      end;
end;

HandleEvent
  cmInit:
  {
    if (not (ReadMyDsk(sSigner, 'GP_SpravObj_sSigner', false)))
      sSigner:=sGetTune('UP.Staff.SignatoryAuthority');

    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);
    if (not iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigner))
      sSigner:='';
    if cPersNr = comp(0)
    {
      message('Создание справки-объективки запускается из карточки сотрудника.');
      CloseInterface(cmDefault);
    }
  }
  cmPick:
  {
    Case CurField of
      #sSigner:
      {
        if iFeeSigners.RunMainWindow(1)
          set sSigner:=iFeeSigners.GetFeeSignersName;

      }
    end;
  }
  cmOk:
  {
    if trim(sSigner) <> '' 
    {
      RunRep;
      SaveMyDsk(sSigner, 'GP_SpravObj_sSigner');
      CloseInterface(cmDefault);
    } else message('Не заданы подписанты!');
  }
end;
end.
