  // #include GP_Log.var

  // Рассчитывает стаж работы по занимаемой должности
  // По законодательству периоды стажа считаются так:
  // каждые 30 дней переводятся в месяцы, а кажде 12 месяцев - в годы.
  // Но тем не менее, широко распространен учет страхового стажа по другой схеме - полные месяцы и годы учитываются как есть,
  // а дни, составляющие неполные начальный и конечный месяцы складываются и переводятся в месяцы по 30 дней.
  // Этот алгоритм и реализован в этой функции.
  // Параметры:
  //  DateFrom, DateTo - дата начала и окончания периода
  //  Y, M, D - как входные, играют роль стажа на начало периода, как выходные, конечного результата
  procedure CalcStrahStaj(DateFrom, DateTo: Date; var Y, M, D: Integer);
  begin
    var RY: Integer = 0;
    var RM: Integer = 0; 
    var RD: Integer = 0;
    // Если дата начала и окончания периода в одном месяце
    if Month(DateFrom) = Month(DateTo) and Year(DateFrom) = Year(DateTo) then
    begin
      // Рассчитываем кол-во дней между датой начала и окончания периода
      RD := Day(DateTo) - Day(DateFrom) + 1;
    end else
    begin
      // Дата начала и окончания периода в разных месяцах
      var DF: Date = To_Date(1, Month(DateFrom), Year(DateFrom));
      var DT: Date = To_Date(1, Month(DateTo), Year(DateTo));
      // Если период начинается не с первого числа месяца
      if Day(DateFrom) > 1 then
      begin
        // Первый целый месяц - следующий за месяцем начала периода
        DF := Add_Months(DF, 1);
        // Добавляем кол-во дней из первого месяца
        RD := RD + Last_Day(DateFrom) - Day(DateFrom) + 1;
      end;
      // Если период заканчивается не последним днем месяца
      if Day(DateTo) != Last_Day(DateTo) then
      begin
        // Последний целый месяц - месяц, предшествующий месяцу конца периода
        DT := Add_Months(DT, -1);
        // Добавляем кол-во дней из последнего месяца
        RD := RD + Day(DateTo);
      end;
      // Рассчитываем кол-во целых месяцев в периоде
      if DT >= DF then
        RM := Months_Between(DF, DT) + 1;
    end;

    // SET aMonths = aMonths + aDays DIV 30;
    // SET aDays = aDays % 30;
    // RETURN CONCAT(LPAD(aDays, 2, '0'), '.', LPAD(aMonths % 12, 2, '0'), '.', LPAD(aMonths DIV 12, 2, '0'));
    // Если в функцию передан начальный стаж, добавим его к результату
    RM += Y * 12 + M;
    RD += D;

    // Распределим дни из нецелых месяцев и начального стажа
    RM += RD div 30;
    RD := RD mod 30;

    // Результат работы функции
    Y := RM div 12;
    M := RM mod 12; 
    D := RD;
  end;

  // Рассчитывает стаж работы по занимаемой должности
  function CalcAppStaj(cPerson: Comp; OnDate: Date; var Y, M, D: Integer; var StartDate: Date): String;
  var
    _cApp: tNRec;
    _cPost: tNRec;
  begin
    Y := 0;
    M := 0;
    D := 0;
    StartDate := ZeroDate;
    // Определяем назначение на указанную дату
    _cApp := VAppFuncs.GetAppNrec_OnDate(cPerson, OnDate);
    if getFirst Appointments where ((_cApp == Appointments.NRec)) = tsOK then
    begin
      // Должность, которую занимал работник на указанную дату
      _cPost := Appointments.Post;
      if _cPost != 0 then
      begin
        StartDate := Appointments.AppointDate;
        // Определяем дату, с которой работник начал работать на данной должности
        _loop backward Appointments where ((cPerson == Appointments.Person and 0 == Appointments.lPrizn)) ordered by index ApntByDate // ApntByPerson
        begin
          // Если в данном назачении та же должность
          if Appointments.Post = _cPost then
            StartDate := Appointments.AppointDate
          else
            break;
        end;
        if StartDate != ZeroDate then
          CalcStrahStaj(StartDate, OnDate, Y, M, D);
      end;  
    end;
    result := To_Char(Y)  + ' ' + iStrFunc.DeclYMD(Y, ymdYears)   + ' ' +
     To_Char(M) + ' ' + iStrFunc.DeclYMD(M, ymdMonths) + ' ' +
     To_Char(D) + ' ' + iStrFunc.DeclYMD(D, ymdDays);
  end;

