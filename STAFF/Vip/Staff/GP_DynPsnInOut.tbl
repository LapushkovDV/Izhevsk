table struct ttRepPeriod
(
  nRec        : comp,
  sNamePeriod : string,
  sSortPeriod : string,
  dBegPeriod  : date,
  dEndPeriod  : date
)
with index
(
  ttRepPeriod00 = nRec(Surrogate),
  ttRepPeriodRepSort = sSortPeriod
);

table struct ttTypeKat
(
  nRec         : comp,
  sAbbrTypeKat : string,
  iSortTypeKat : string
)
with index
(
  ttTypeKat00 = nRec(Surrogate),
  ttTypeKat01 = sAbbrTypeKat,
  ttTypeKatRepSort = iSortTypeKat
);

table struct ttEmplKat
(
  nRec     : comp,
  cTypeKat : comp,
  sNameKat : string,
  iSortKat : integer
)
with index
(
  ttEmplKat00 = nRec(Surrogate),
  ttEmplKatRepSort = cTypeKat + iSortKat
);

table struct ttRepInpData
(
  nRec       : comp,
  cTypeKat   : comp,
  cEmplKat   : comp,
  cRepPeriod : comp,
 // 0 - данные строк, 
 // 1 - итог по подр. за период
 // 2 - итоги по подр. по столбцам в периоде
 // 3 - итоги по всем подр. по столбцам в периоде
 // 4 - итог по всем подр. за период
 // 5 - численность всего за период
 // 6 - средний возраст за период
 // 7 - текучесть за период
  wTypeData  : word,
  lAgePeriod1: longint,
  lAgePeriod2: longint,
  lAgePeriod3: longint
)
with index
(
  ttRepInpData00      = nRec(Surrogate),
  ttRepInpDataRepSort = cTypeKat + cEmplKat + cRepPeriod + wTypeData,
  ttRepInpDataItogLoc = cTypeKat + cRepPeriod + wTypeData,
  ttRepInpDataItogTot = cRepPeriod + wTypeData,
  ttRepInpTypeKatChek = cTypeKat + wTypeData,
  ttRepInpEmplKatChek = cEmplKat + wTypeData
);

table struct ttRepOutData
(
  nRec        : comp,
  cTypeKat    : comp,
  cEmplKat    : comp,
  cRepPeriod  : comp,
 // 0 - данные строк, 
 // 1 - итог по подр. за период
 // 2 - итоги по подр. по столбцам в периоде
 // 3 - итоги по всем подр. по столбцам в периоде
 // 4 - итог по всем подр. за период
  wTypeData   : word,
  lAgePeriod1 : longint,
  lAgePeriod2 : longint,
  lAgePeriod3 : longint,
  lStajPeriod1: longint,
  lStajPeriod2: longint,
  lStajPeriod3: longint
)
with index
(
  ttRepOutData00      = nRec(Surrogate),
  ttRepOutDataRepSort = cTypeKat + cEmplKat + cRepPeriod + wTypeData,
  ttRepOutDataItogLoc = cTypeKat + cRepPeriod + wTypeData,
  ttRepOutDataItogTot = cRepPeriod + wTypeData,
  ttRepOutTypeKatChek = cTypeKat + wTypeData,
  ttRepOutEmplKatChek = cEmplKat + wTypeData
);

table struct ttLog
(
  nRec   : comp,
  sFIO   : string,
  sMode  : string,
  sReason: string,
  dDate  : date
)
with index
(
  ttLog00 = nRec(Surrogate),
  ttLogSort = sMode + dDate + sFIO
);
