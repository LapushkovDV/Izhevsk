#include GP_3GD.vih
#include ExtClass.vih
#include CatFunc.vih

Interface GP_3GD;

#include ExtClass.var

var 
  wSeg3GD : word;
  cCurPodr: comp;
  gpEctCl : iExtClass;
  iCatFunc: CatalogsFunctions;

create view
as select *
from
  catalogs cat3ier;

procedure Init3GD;
{
  wSeg3GD := gpEctCl.GetClassCode(coCatalogs,'Вышестоящий руководитель');
  if wSeg3GD = 0 message('Не проинициализировался классификатор 3ГД!');
}

function bFindCurZGDPodr(cStart : comp) : boolean;
  var 
    cRecSR : comp ;
    cRecDp : comp ;
    is3GD  : boolean;    
    sRes   : string;
{
  cRecSR  := iCatFunc.GetCatalogsNRec(-11);
  is3GD   := false;
  cCurPodr:= comp(0);
  sRes    := '';
  cRecDp  := cStart;
  result := false;
  if getfirst cat3ier where((cStart == cat3ier.nrec)) <> tsOk
    exit;
  if cat3ier.MainLink <> cRecSR
    exit;
  do
  {
    if getfirst cat3ier where((cRecDp == cat3ier.nrec)) = tsOk
    {
      if cat3ier.nrec <> cRecSR
      {
        sRes := gpEctCl.GetSegCode(wSeg3GD,cat3ier.nrec);
        if sRes <> '' {is3GD  := true; cCurPodr := cat3ier.nrec;}
        else          cRecDP := cat3ier.cParent;
      }
      else
      {
        is3GD  := true;
      }
    } else is3GD  := true;
  } while not is3GD;
  if cCurPodr <> 0 result := true;
//  else             result := false;
}
function sTypeCurZGDPodr : string;
{
  sTypeCurZGDPodr := SubStr(gpEctCl.GetSegCode(wSeg3GD,cCurPodr),1,1);
}
function sCodeCurZGDPodr : string;
{
  sCodeCurZGDPodr := gpEctCl.GetSegCode(wSeg3GD,cCurPodr);
}
function sNameCurZGDPodr : string;
{
  sNameCurZGDPodr := gpEctCl.GetSegName(wSeg3GD,cCurPodr);
}

function sAbbrCurZGDPodr : string;
{
  var sTemp : string;
  sTemp := sTypeCurZGDPodr;
  case sTemp of
  '1': sAbbrCurZGDPodr := 'ПР' ;
  '2': sAbbrCurZGDPodr := 'НИК';
  '3': sAbbrCurZGDPodr := 'ГИ' ;
  '4': sAbbrCurZGDPodr := 'КБ' ;
  '5': sAbbrCurZGDPodr := 'АУП';
  else sAbbrCurZGDPodr := ''   ;
  end;
}


function sTypePodr(cStart : comp) : string; cacheable;
  var 
    cRecSR : comp ;
    cRecDp : comp ;
    is3GD  : boolean = false;    
    sRes   : string  = '';
{
  cRecSR := iCatFunc.GetCatalogsNRec(-11);
//  is3GD  := false;
//  sRes   := '';
  cRecDp := cStart;
  cCurPodr:= comp(0);
  if getfirst cat3ier where((cStart == cat3ier.nrec)) <> tsOk
    exit;
  if cat3ier.MainLink <> cRecSR
    exit;
  do
  { //уточнить само у себя может быть вышестоящим?
    if getfirst cat3ier where((cRecDp == cat3ier.nrec)) = tsOk
    {
      if cat3ier.nrec <> cRecSR
      {
        sRes := gpEctCl.GetSegCode(wSeg3GD,cat3ier.nrec);
        if sRes <> '' {is3GD  := true; sRes := cat3ier.code;}
        else          cRecDP := cat3ier.cParent;
      }
      else is3GD  := true;
    } else is3GD  := true;
  } while not is3GD;
  sTypePodr := sRes;
}



function sCode3GD(cStart : comp) : string; cacheable;
  var 
    cRecSR : comp ;
    cRecDp : comp ;
    is3GD  : boolean = false;    
    sRes   : string  = '';   
{
  cRecSR := iCatFunc.GetCatalogsNRec(-11);
//  is3GD  := false;
//  sRes   := '';
  cRecDp := cStart;
  if getfirst cat3ier where((cStart == cat3ier.nrec)) <> tsOk
    exit;
  if cat3ier.MainLink <> cRecSR
    exit;
  do
  { //уточнить само у себя может быть вышестоящим?
    if getfirst cat3ier where((cRecDp == cat3ier.nrec)) = tsOk
    {
      if cat3ier.nrec <> cRecSR
      {
        sRes := gpEctCl.GetSegCode(wSeg3GD,cat3ier.nrec);
        if sRes <> '' {is3GD  := true; sRes := cat3ier.code;}
        else          cRecDP := cat3ier.cParent;
      }
      else is3GD  := true;
    } else is3GD  := true;
  } while not is3GD;
  sCode3GD := sRes;
}

end.