function OpenNewRKS : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExistRKS : boolean;
{
  result := false;
  xlOpenExcel(true);
  if xlOpenWorkBook(sToExistFile)
    result := true;
}

function SetParam4k : boolean;
{
  result := false;
  if RunWindowModal(Win4KParam)=cmDefault
    result := true;
}
procedure PrintRash;
{
  var lLine : longint;
  var lRB, lRE, lCB, lCE : longint = 1;
  var sAgeT: string;
  var dAge : date;
  var wDays, wMonths, wYears : word;


  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Печать расшифровки.', 0);
  lRB := lRE := 2;
  lCB := 1;
  lLine:=0;
  xlMergeCells(1,1,1,4);
  xlSetCellStringValue('Расшифровка листа 4. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
  if isvalid(#ttPsn4K)
  {
    lCE := 0;
    lCE++; xlSetCellStringValue('№пп',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Таб.№',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Код подр.',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата приема на работу',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Вид образования',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата окончания образовательного учреждения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата увольнения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Причина увольнения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Причина предыдущего увольнения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Возраст',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Год',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Строки',lRE,lCE,lRE,lCE);
    lRE++;
    _loop ttPsn4K ordered index ttPsn4K02
    {
      if (not NextVisual) break;
      if ttPsn4K.isFirst and ttPsn4K.cEduLev <> 0
//      if 2=2
      {//if(dDate<>0,datetostr(dDate,'DD.MM.YYYY'),'')
        lCE := 0;
        lCE++; xlSetCellStringValue(++lLine       ,lRE,lCE,lRE,lCE);
        lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttPsn4K.sTbNmb,lRE,lCE,lRE,lCE);
        lCE++; xlSetCellStringValue(ttPsn4K.sFIO,lRE,lCE,lRE,lCE);
        lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttPsn4K.sPodr,lRE,lCE,lRE,lCE);
        lCE++; if ( ttPsn4K.dBegWrk <> 0 ) xlSetCellDateValue(ttPsn4K.dBegWrk,lRE,lCE,lRE,lCE);
        lCE++; xlSetCellStringValue(iCatFunc.GetCatalogsName(ttPsn4K.cEduLev),lRE,lCE,lRE,lCE);
        lCE++; if ( ttPsn4K.dEndEdu <> 0 ) xlSetCellDateValue(ttPsn4K.dEndEdu,lRE,lCE,lRE,lCE);
        lCE++; if ( ttPsn4K.dEndWrk <> 0 ) xlSetCellDateValue(ttPsn4K.dEndWrk,lRE,lCE,lRE,lCE);
        lCE++; xlSetCellStringValue(iCatFunc.GetCatalogsName(ttPsn4K.cRsnDis1),lRE,lCE,lRE,lCE);
        lCE++; xlSetCellStringValue(iCatFunc.GetCatalogsName(ttPsn4K.cRsnDis2),lRE,lCE,lRE,lCE);
        lCE++; xlSetCellStringValue(ttPsn4K.wAge,lRE,lCE,lRE,lCE);
        lCE++; xlSetCellStringValue(ttPsn4K.wYear,lRE,lCE,lRE,lCE);
        lCE++; xlSetNumberFormat('@',lRE,lCE,lRE,lCE); xlSetCellStringValue(ttPsn4K.sRows,lRE,lCE,lRE,lCE);
        lRE++;
      }
    }
  }
  lRE--;
  xlWrapText(lRB,lCB,lRB,lCE);
  xlAutoFit(lRB+1,lCB,lRE,lCE);
  xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
  StopVisual;
}

procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  init4K;

  if isStayAlone
    if SetParam4k
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);

  if isDoRep
  {
    Make4K;
    PostProcess4K;
    if isData4K
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNewRKS  ;}
        if wToExistFile = 1 {isOkFile := OpenExistRKS;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        Print4K;

        if (wPrintRash = 1) and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='4-к' break;
          }
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 4-К'); 
          xlSetActiveSheet(i);
          PrintRash;
        }

        xlSetActiveSheetByName('4-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }
    else if isStayAlone message('Нет данных для отчета.');
  }
  Save4K;
  Clear4K;
  closeinterface(cmDefault);
}
