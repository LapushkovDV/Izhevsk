window Win4KParamEx 'Параметры формирования. Лист 4-К.' Gray;
//  show at (,,95,32);
  show at (,,95,13);
Screen sEx(,,sci1Esc);
  fields
    dRep   ('Дата формирования'): {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    sPodr1 ('Выбранные подразделения',hcStaffAppDepartment,sci13Esc): {Font = {BackColor = if(sPodr1 = 'Не выбраны подразделения', ColorNeed, 0)}},Protect, PickButton ;
    sEdu1  ('Высшие образования' ,hcStaffAppDepartment,sci13Esc): {Font = {BackColor = if(sEdu1 = 'Не выбрано', ColorNeed, 0)}},Protect, PickButton ;
    sEdu2  ('Среднее проф.образование',hcStaffAppDepartment,sci13Esc): {Font = {BackColor = if(sEdu2 = 'Не выбрано', ColorNeed, 0)}},Protect, PickButton ;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
<< 'Параметры отчета'

 `Дата формирования       `.@@@@@@@@@@@
 `Подразделения для отчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Высшее образование      `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Среднее проф.образование`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   <. ~С~охранить .>                                                        <. ~З~акрыть .>
>>
end;
HandleEvent
  cmOK:
  {
    Save4K;
    init4K;
    if not isCheckRepParam(true)
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
  cmCancel:
  {
    Save4K;
    CloseWindowEx(CurWindow,cmCancel);
  }
end;
end;//Win4KParamEx
