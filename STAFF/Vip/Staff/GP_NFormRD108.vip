#define RD 108 //#(RD)

#doc
Печать группового приказа "Реестр работников на удержание части стоимости путевок" РД #(RD)
#end
interface GP_NFormRD#(RD) 'Реестр работников на удержание части стоимости путевок' (,,scStaffEmplMain) EscClose;
  show at (00,05,80,15);

table struct ttReport
(
  sPodr : string
, sPodrS: string
, sTbNmb: string
, sFIO  : string
, sPost : string
, sDogN : string
, dbKomp: double
, dbUder: double
, sSpoOp: string
, wSpoOp: word
, sTel  : string[50] //Контактный телефон представителя ребенка
, RFio  : string //Ф.И.О. ребенка
, RType : string[50] //Код степени родства
, RTel  : string[50] // Контактный телефон ребенка
, SvidRogd:string// Свидетельство о рождении или паспорт
, RBornDate:date // Дата рождения
, School_Addr :string//Шк., класс
, Home_Addr:string //Домашний адрес

)
with index
(
  ttReport01 = sFIO
);

table struct mtReport // Для потока с агрегацией сумм по человеку
(
  sPodrS: string
, sTbNmb: string
, sFIO  : string
, sPost : string
, dbUder: double
)
with index
(
  idx_mtReport01 = sFIO + sTbNmb
);

// Potapov b 2230
table struct mtVypiska // Для потока Выписки
(
  sPodrS:  string
, sTbNmb:  string
, sFIO:    string
, sPost:   string
, dbUder:  double
, sNVouch: string
)
with index
(
  mtVypiska01 = sTbNmb + sNVouch
);


table struct mtSigners
(
  wIdx:  word
, sPost: string
, sFIO:  string
)
with index
(
  mtSigners01 = wIdx
);
// Potapov e 2230

var
  cPolisOMS
, cAddrTemp
, cAddrBase
, cAddrSch
, cTel
, cBornSvid
, cCatChild     : comp;

  Catsys_M11:comp;
  pNrec     :comp;
  //----------------------------------
  iCatFunc   : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  iStrFunc   : StringFunctions;     // Переменная типа интерфейс StringFunctions
  iAppFunc   : AppointmentsFunctions;
  IDepartIer : DepartIer;           // Переменная типа интерфейс DepartIer
  iAdrFunc   : AddressFunc;           // Переменная типа интерфейс AddressFunc
  //----------------------------------
#include FeeSigners.var

Create view MakeReport1View
var
  cDoc:     comp;
  PersNrec: comp;
  iOper:    integer;
  sSigner:  string;
  sPostSignHead
 ,sFIOSignHead: string; // Potapov 2230
  dHead: date;
  sNameUch: string; // Potapov 2230
as  select
  Persons.Nrec

from
  Persons
, Appointments
, TitleDoc
, PartDoc
, ContDoc
, GP_RaiseHistExt#(RD)
, ttReport (ttReport01)
, mtReport (idx_mtReport01)
, SpAllStaff SpAS_Cnt
, SpAllStaff SpAS_Agr
, COMMUNICATIONS
, PsnLinks
, Catalogs
// Potapov b 2230
, mtSigners (mtSigners01)
, mtVypiska (mtVypiska01)
// Potapov e 2230
where
((              cDoc == TitleDoc.Nrec             
and            iOper == PartDoc.TypeOper          
and    TitleDoc.Nrec == PartDoc.cDoc              
and     PartDoc.Nrec == ContDoc.cPart             
and PartDoc.TypeOper == ContDoc.TypeOper
and   ContDoc.Person == Persons.Nrec
and   ContDoc.Person == COMMUNICATIONS.Person
and                2 == COMMUNICATIONS.OBJTYPE
and     ContDoc.cStr == Appointments.Nrec         
and     ContDoc.Nrec == RaiseHist.cContDoc        
and   RaiseHist.nrec == GP_RaiseHistExt#(RD).cRaiseH

and                    7 == SpAS_Cnt.wNoCon  //Ищем ссылку на допсоглашение отображаемое непосредственно в приказе
and         contdoc.NRec == SpAS_Cnt.CLINKT  //независимо от того что в карточке
and                    0 == SpAS_Cnt.INUM    //допсоглашение из карточки устарело?
and            coContDoc == SpAS_Cnt.WCHOISE 
and      SpAS_Cnt.cBaseT == SpAS_Agr.nRec
//-----------------
and                pNrec == Catalogs.Nrec
and GP_RaiseHistExt108.cChild == PsnLinks.nrec

//-----------------
and  PsnLinks.Nrec == Sys_Uder.cex
and  string(2)     == Sys_Uder.NMNEM


//--------------------
))
;
parameters cDoc, iOper;


Function GetFioRucSocPolitik : string;
{ //Управление социальной политики 957
  Result:='';
  if getfirst Catalogs where (( catSys_M11 == Catalogs.MainLink
    and 0 == Catalogs.Lpr and '957' == Catalogs.Code ))=tsok
   Result:=GetCatalogs_Boss_Fio(Catalogs.Nrec);
}

DataStream DTS_NForm#(RD)
(
  [NoDoc]        TitleDoc.DocNmb;
  [DDoc]         DateToStr(TitleDoc.DocDate, 'DD.MM.YYYY');
  [RepOnDate]    DateToStr(TitleDoc.DocDate, 'month') + ' ' +DateToStr(TitleDoc.DocDate, 'YYYY') + ' года.';
  [sSignPost]    iAppFunc.GetAppPost(iAppFunc.GetAppNrec_OnDate(coGetTune('UP.STAFF.SIGNATORYAUTHORITY'), cur_date));
  [sSignFIO]     iStrFunc.GetFIO(sGetTune('UP.STAFF.SIGNATORYAUTHORITY'));
  [RespReport]   sGetTune('User.FIO');
  [sRucSocPolitik] GetFioRucSocPolitik();
  [sdHead]         DateToStr(dHead, 'month') + ' ' +DateToStr(dHead, 'YYYY') + ' года.';
// Potapov b 2230
  [PostSignHead]   sPostSignHead;
  [FIOSignHead]    sFIOSignHead;
  [NameUch]        sNameUch;
  [VouchFrom]      DateToStr(PARTDOC.DDAT1, 'DD.MM.YYYY');
  [VouchTo]        DateToStr(PARTDOC.DDAT2, 'DD.MM.YYYY');
// Potapov e 2230
  table ttReport
  (
    [CodePodr]      ttReport.sPodr; 
    [CodePodrShort] ttReport.sPodrS; 
    [TabNmb]        ttReport.sTbNmb;
    [FIO]           ttReport.sFIO;
    [Post]          ttReport.sPost;
    [NoDogGost]     ttReport.sDogN;
    [SumKomp]       ttReport.dbKomp;
    [SumUder]       ttReport.dbUder;
    [SposOplat]     ttReport.sSpoOp;
    [TypeOpl]       ttReport.wSpoOp;
    //------------------------------------
    [sTel       ]   ttReport.sTel       ;//Контактный телефон представителя ребенка
    [RFio       ]   ttReport.RFio       ;//Ф.И.О. ребенка
    [RType      ]   ttReport.RType      ;//Тип "ДЕТИ"
    [RTel       ]   ttReport.RTel       ;// Контактный телефон ребенка
    [SvidRogd   ]   ttReport.SvidRogd   ;// Свидетельство о рождении или паспорт
    [RBornDate  ]   if(ttReport.RBornDate=ZeroDate,'',DateToStr(ttReport.RBornDate,'DD.MM.YYYY'))  ;// Дата рождения
    [School_Addr]   ttReport.School_Addr;//Шк., класс
    [Home_Addr  ]   ttReport.Home_Addr  ;//Домашний адрес

  ); //table ttReport
  table mtReport // Отдельный поток с агрегацией сумм по человеку
  (
    [CodePodrShort] mtReport.sPodrS; 
    [TabNmb]        mtReport.sTbNmb;
    [FIO]           mtReport.sFIO;
    [Post]          mtReport.sPost;
    [SumUder]       mtReport.dbUder;
  ); // mtReport
// Potapov b 2230
  table mtVypiska // Для потока Выписки
  (
    [CodePodrShort] mtVypiska.sPodrS; 
    [TabNmb]        mtVypiska.sTbNmb;
    [FIO]           mtVypiska.sFIO;
    [Post]          mtVypiska.sPost;
    [SumUder]       mtVypiska.dbUder;
    [NVouch]        mtVypiska.sNVouch;
  ); // mtVypiska

  table mtSigners
  (
    [sPostSign]  mtSigners.sPost; 
    [sFIOSign]   iStrFunc.GetFIO(mtSigners.sFIO);
  );
// Potapov e 2230
)// DataStream DTS_NForm
end;
// Potapov b 2230
