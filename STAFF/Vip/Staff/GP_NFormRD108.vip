// Делаем временную табличку с подписантами
// для датастрима
Window winSign 'Выбор подписантов для выписки';
Show At (,, 70, 7);
  Screen s1(,,sci1Esc);
    fields
      sSigner('Подписанты для выписки',,sci13Esc): /*{Font = {BackColor = if(sSigner = '', ColorNeed, 0)}},*/ protect;
    buttons
      cmOk,,,'Запуск',,;
      cmCancel,,,'Выход',,;
    << 'Параметры отчета'

     `Подписанты для выписки`
      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     <. ~С~формировать .>                         <. ~З~акрыть .>
    >>
  end;
handleevent
  cmPick:
  {
    Case CurField of
      #sSigner:
        if iFeeSigners.RunMainWindow(1)
          set sSigner := iFeeSigners.GetFeeSignersName;
    end;
  }
  cmDelOnProtect:
  {
    case CurField of
      #sSigner:
        set sSigner := '';
    end;
  }
  cmOk:
  {
/*
    if trim(sSigner) <> '' 
      CloseWindowEx(winSign, cmDefault)
    else
      message('Не заданы подписанты!', Error);
*/
    CloseWindowEx(winSign, cmDefault)
  }
  cmCancel:
  {
    CloseWindowEx(winSign, cmCancel);
  }
end;
end;

procedure InsertFeeSignersList(_wIdx: word; _sPost: string; _sFIO: string);
{
  ClearBuffer(#mtSigners);
  mtSigners.wIdx  := _wIdx;
  mtSigners.sPost := _sPost;
  mtSigners.sFIO  := _sFIO;
  if (insert current mtSigners <> tsOk) {}
}

procedure MakeFeeSignersList;
var
  sPostCur, sFIOCur: string = '';
  iNPP: integer = 0;
{
  iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigner);
  if iFeeSigners.FeeSignersIsValid
    if iFeeSigners.GetSignerFirst
      do
      {
        if ( iFeeSigners.GetSignerRole = 'Гл. бухгалтер')
        {
          sPostSignHead:= iFeeSigners.GetSignerPosition(cgCommisFIOManual3);
          sFIOSignHead := iFeeSigners.GetSignerFIO(cgCommisFIOManual2);
          iStrFunc.GetFioIn(sFIOSignHead);
        }
        else
        {
          sPostCur := iFeeSigners.GetSignerPosition(1);
          sFIOCur  := iFeeSigners.GetSignerFIO(cgCommisFIOManual1);
          InsertFeeSignersList(++iNPP, sPostCur, sFIOCur);
        }
      } while iFeeSigners.GetSignerNext;
}
// Potapov e 2230
//////////////////////////////////////////
//──────────────────────────────────────────────────────────────────────────────
//  печать в FasrReport
//──────────────────────────────────────────────────────────────────────────────
Procedure PrintNForm#(RD)FR;
{
  if getfirst TitleDoc=tsok
  _loop PartDoc
  {
    if ( dHead = 0 )
      if ( PartDoc.wAttr1 <> 0 and PartDoc.wAttr2 <> 0 )
        dHead := To_Date(1, PartDoc.wAttr1, PartDoc.wAttr2);
    _loop ContDoc
    {
      _loop RaiseHist
      {
        if ( dHead = 0 )
          dHead := RaiseHist.dRec;

        ClearBuffer(#ttReport);
        if getfirst Persons=tsok
        {
          ttReport.sTbNmb:= if (Appointments.lPrizn = 0, GetStrTabn(Persons.TabNmb,Persons.StrTabn), 
                                                         GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN));
          ttReport.sFIO  := Persons.FIO;    
        }
        if getfirst Appointments=tsok
        {
          ttReport.sPodr := IDepartIer.GetCodeOnDate(Appointments.Department,if (Day(TitleDoc.DocDate) > 0, TitleDoc.DocDate, Cur_Date));
          ttReport.sPodrS:= SubStr(ttReport.sPodr,1,3);
          ttReport.sPost := if ( boGetTune('UP.STAFF.USE_LONGNAME_ANK'),trim(iCatFunc.GetCatalogsLongName(Appointments.Post)),
                                                                        trim(iCatFunc.GetCatalogsName(Appointments.Post)));
        }
        ttReport.dbKomp  := RaiseHist.RHSUM;
        if isvalid(#SpAS_Cnt)
          if isvalid(#SpAS_Agr)
            ttReport.sDogN   := SpAS_Agr.RESSTRING[1]+' от '+datetostr(SpAS_Agr.RESDATE[1],'DD.MM.YYYY');
        if getfirst GP_RaiseHistExt#(RD) =tsok
        {
          ttReport.dbUder:= GP_RaiseHistExt#(RD).UdCost;  
          ttReport.sSpoOp:= trim(iCatFunc.GetCatalogsName(GP_RaiseHistExt#(RD).cSposOpl));
          ttReport.wSpoOp:= 1;
        }
        //------------------------------------
        _Loop COMMUNICATIONS
        { 
          ttReport.sTel:=ttReport.sTel+if(ttReport.sTel<>'',', ','')+COMMUNICATIONS.ADDR       ;//Контактный телефон представителя ребенка
        }
        if getfirst GP_RaiseHistExt#(RD) =tsok
        { 
          _Loop GP_RaiseHistExt#(RD)
          { 
            // Potapov b 2230
            ClearBuffer(#mtVypiska);
            mtVypiska.sPodrS  := ttReport.sPodrS;
            mtVypiska.sTbNmb  := ttReport.sTbNmb;
            mtVypiska.sFIO    := ttReport.sFIO;
            mtVypiska.sPost   := ttReport.sPost;
            mtVypiska.dbUder  := GP_RaiseHistExt#(RD).UdCost;
            mtVypiska.sNVouch := GP_RaiseHistExt#(RD).NumPut;
            if ( Trim(sNameUch) = '' )  
              sNameUch := iCatFunc.GetCatalogsName(GP_RaiseHistExt#(RD).cSanUch);
            // Potapov e 2230
            if getfirst PsnLinks=tsok
            {  
              ttReport.RFio       :=PsnLinks.RFio;//Ф.И.О. ребенка
              ttReport.RType      :=iCatFunc.GetCatalogsCode(PsnLinks.LinkType);//Ф.И.О. ребенка
              if ttReport.RType <>'ДЕТИ'
              { pNrec:=PsnLinks.LinkType;
                if Getfirst Catalogs=tsok
                { ttReport.RType      :=iCatFunc.GetCatalogsCode(Catalogs.cParent);
                }
              }
              ttReport.RTel       :=sGetAttrID(coPsnLinks,PsnLinks.Nrec,cTel);// Контактный телефон ребенка
              if getlast sys_uder=tsok      ttReport.SvidRogd   :=sys_uder.LastUser;// Свидетельство о рождении или паспорт
              ttReport.RBornDate  :=PsnLinks.RBornDate;// Дата рождения
              ttReport.School_Addr:=sGetAttrID(coPsnLinks,PsnLinks.Nrec,cAddrSch );//Шк., класс
              ttReport.Home_Addr  :=sGetAttrID(coPsnLinks,PsnLinks.Nrec,cAddrBase);//Домашний адрес
              if ttReport.Home_Addr=''
              ttReport.Home_Addr:=iAdrFunc.GetFullAddressInd(PsnLinks.RPassAddr);
              // Potapov b 2230
              // mtVypiska.sFIO  := ttReport.RFio; // по замечаниям - вместо ФИО родственника - остваляем ФИО сотрудника
              mtVypiska.sPost := iCatFunc.GetCatalogsName(PsnLinks.LinkType) + DateToStr(PsnLinks.RBornDate, ' YYYY г.р.');
              // Potapov e 2230
            }
            insert current ttReport;
            // Potapov b 2230
            insert current mtVypiska;
            // Potapov e 2230
            // Что бы ничего не поломать в существующем потоке, создаем отдельный поток для итоговых сумм в разрезе человека
            // Potapov b
            ClearBuffer(#mtReport);
            if ( getfirst mtReport where ((ttReport.sFIO == mtReport.sFIO and ttReport.sTbNmb == mtReport.sTbNmb)) <> tsOk )
            {
              mtReport.sFIO  := ttReport.sFIO;
              mtReport.sTbNmb:= ttReport.sTbNmb;
              mtReport.sPodrS:= ttReport.sPodrS;
              mtReport.sPost := ttReport.sPost;
              insert current mtReport;
            }
            mtReport.dbUder  += GP_RaiseHistExt#(RD).UdCost;
            update current mtReport;
            // Potapov e
          }
        // для 1512 нужны все - перенести в отчет
        //if ttReport.dbUder <> 0 and ttReport.sSpoOp <> 'Банкомат'
        }
        else insert current ttReport;
      }
    }
  }
  RunFReport(DTS_NForm#(RD), '', False);
}

//──────────────────────────────────────────────────────────────────────────────
HandleEvent
cmInit:
  {
    // Potapov b 2230
    if (not (ReadMyDsk(sSigner, 'RPD108_sSigner', false)))
      sSigner:=sGetTune('UP.Staff.SignatoryAuthority');
    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);
    if (not iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigner))
      sSigner:='';

    if (RunWindowModal(winSign) <> cmDefault)
      CloseInterface(cmDefault);
    
    SaveMyDsk(sSigner, 'RPD108_sSigner');
    MakeFeeSignersList;
    // Potapov e 2230
 //====================================
      cPolisOMS := ExtAttr_Id(coPsnLinks,'Полис ОМС ребенка (члена семьи)');
      if cPolisOMS = 0
        cPolisOMS := ExtAttr_Create(coPsnLinks,'Полис ОМС ребенка (члена семьи)', cgAttrType_Str);

      //Полис ОМС ребенка (члена семьи)
      cPolisOMS := ExtAttr_Id(coPsnLinks,'Полис ОМС ребенка (члена семьи)');
      if cPolisOMS = 0
          cPolisOMS := ExtAttr_Create(coPsnLinks,'Полис ОМС ребенка (члена семьи)', cgAttrType_Str);

      //Адрес временного места пребывания ребенка (члена семьи)
      cAddrTemp := ExtAttr_ID(coPsnLinks,'Адрес временного места пребывания ребенка (члена семьи)');
      if cAddrTemp = 0
          cAddrTemp := ExtAttr_Create(coPsnLinks,'Адрес временного места пребывания ребенка (члена семьи)', cgAttrType_Str);

      //Постоянное место проживания родственника
      cAddrBase := ExtAttr_Id(coPsnLinks,'Постоянное место проживания родственника');
      if cAddrBase = 0
          cAddrBase := ExtAttr_Create(coPsnLinks,'Постоянное место проживания родственника', cgAttrType_Str);


      //Адрес школы (дет.сад) ребенка
      cAddrSch := ExtAttr_Id(coPsnLinks,'Адрес школы (дет.сад) ребенка');
      if cAddrSch = 0
          cAddrSch := ExtAttr_Create(coPsnLinks,'Адрес школы (дет.сад) ребенка', cgAttrType_Str);

      //Телефон
      cTel := ExtAttr_Id(coPsnLinks,'Контактный телефон родственника');
      if cTel = 0
          cTel := ExtAttr_Create(coPsnLinks,'Контактный телефон родственника', cgAttrType_Str);

      catSys_M11:=iCatFunc.GetCatalogsNRec(-11);
    //-------------------------------
    PrintNForm#(RD)FR;
    //-------------------------------
    CloseInterface(cmDefault);
  }       // cmInit
end;      // HandleEvent
end.
