function bSetRepParam : boolean;  
{
  result := false;
  if RunWindowModal(Win2KParamEx)=cmDefault
    result := true;
}//function bSetRepParam
Function GetReportName: String;
{
  GetReportName := '#(GPNam) (ЭМ)';
}
function GetPriority : Integer;
{
  GetPriority := 2;
}
procedure initRKStatRepParam;
{
  init2K;
}
function dRepOnDateParam : date;
{
  dRepOnDateParam := dRep;
}
//--------------------------------------------------------
handleevent
  cmInit:
  {
    isStayAloneAll := true;
    PrintRepPage(true);
  }
  cmPick:
  {
    case CurField of
      #sKatWorker1:
        if (RunInterface('PICKKAT1', 0, mKatWorker1, vfMultipleSelection) = cmDefault)
          set sKatWorker1 := sSetKatName(mKatWorker1);
      #sKatWorker2:
        if (RunInterface('PICKKAT1', 0, mKatWorker2, vfMultipleSelection) = cmDefault)
          set sKatWorker2 := sSetKatName(mKatWorker2);
      #sKatWorker3:
        if (RunInterface('PICKKAT1', 0, mKatWorker3, vfMultipleSelection) = cmDefault)
          set sKatWorker3 := sSetKatName(mKatWorker3);
      #sKatWorker4:
        if (RunInterface('PICKKAT1', 0, mKatWorker4, vfMultipleSelection) = cmDefault)
          set sKatWorker4 := sSetKatName(mKatWorker4);

      #sKatType1:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType1) = cmDefault)
          set sKatType1 := sSetTypName(mKatType1);
      #sKatType2:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType2) = cmDefault)
          set sKatType2 := sSetTypName(mKatType2);
      #sKatType3:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType3) = cmDefault)
          set sKatType3 := sSetTypName(mKatType3);
      #sKatType4:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType4) = cmDefault)
          set sKatType4 := sSetTypName(mKatType4);
      #sKatType5:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType5 ) = cmDefault)
          set sKatType5 := sSetTypName(mKatType5 );
      #sKatType6:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType6 ) = cmDefault)
          set sKatType6 := sSetTypName(mKatType6 );
      #sKatType7:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType7 ) = cmDefault)
          set sKatType7 := sSetTypName(mKatType7 );
      #sKatType8:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType8 ) = cmDefault)
          set sKatType8 := sSetTypName(mKatType8 );
      #sKatType9:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType9 ) = cmDefault)
          set sKatType9 := sSetTypName(mKatType9 );
      #sKatType10:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType10) = cmDefault)
          set sKatType10:= sSetTypName(mKatType10);
      #sKatType11:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType11) = cmDefault)
          set sKatType11:= sSetTypName(mKatType11);
      #sKatType12:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType12) = cmDefault)
          set sKatType12:= sSetTypName(mKatType12);
      #sKatType13:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType13) = cmDefault)
          set sKatType13:= sSetTypName(mKatType13);
      #sPodr1:
        if (RunInterface('PICKCATALOGEX', -11, 0, Comp(100), mPodr1) = cmDefault)
          set sPodr1 := sSetPodrName(mPodr1);
      #sToExistFile:
      {
        set sToExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
      #sFromExistFile:
      {
        set sFromExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sKatWorker1: {ClearMarker(mKatWorker1); set sKatWorker1 := sSetKatName (mKatWorker1);}
      #sKatWorker2: {ClearMarker(mKatWorker2); set sKatWorker2 := sSetKatName (mKatWorker2);}
      #sKatWorker3: {ClearMarker(mKatWorker3); set sKatWorker3 := sSetKatName (mKatWorker3);}
      #sKatWorker4: {ClearMarker(mKatWorker4); set sKatWorker4 := sSetKatName (mKatWorker4);}

      #sKatType1:   {ClearMarker(mKatType1 );  set sKatType1   := sSetKatName (mKatType1 );}
      #sKatType2:   {ClearMarker(mKatType2 );  set sKatType2   := sSetKatName (mKatType2 );}
      #sKatType3:   {ClearMarker(mKatType3 );  set sKatType3   := sSetKatName (mKatType3 );}
      #sKatType4:   {ClearMarker(mKatType4 );  set sKatType4   := sSetKatName (mKatType4 );}
      #sKatType5:   {ClearMarker(mKatType5 );  set sKatType5   := sSetKatName (mKatType5 );}
      #sKatType6:   {ClearMarker(mKatType6 );  set sKatType6   := sSetKatName (mKatType6 );}
      #sKatType7:   {ClearMarker(mKatType7 );  set sKatType7   := sSetKatName (mKatType7 );}
      #sKatType8:   {ClearMarker(mKatType8 );  set sKatType8   := sSetKatName (mKatType8 );}
      #sKatType9:   {ClearMarker(mKatType9 );  set sKatType9   := sSetKatName (mKatType9 );}
      #sKatType10:  {ClearMarker(mKatType10);  set sKatType10  := sSetKatName (mKatType10);}
      #sKatType11:  {ClearMarker(mKatType11);  set sKatType11  := sSetKatName (mKatType11);}
      #sKatType12:  {ClearMarker(mKatType12);  set sKatType12  := sSetKatName (mKatType12);}
      #sKatType13:  {ClearMarker(mKatType13);  set sKatType13  := sSetKatName (mKatType13);}
      
      #sPodr1:      {ClearMarker(mPodr1);      set sPodr1      := sSetPodrName(mPodr1);}
      #sToExistFile:{set sToExistFile:='';}
      #sFromExistFile:{set sFromExistFile:='';}
    end;
  }
  cmCheckField:
  {
    case CurField of
      #wToExistFile:
      {
        if wToExistFile = 1 
          ToggleFieldVisible(#sToExistFile,true )
        else
          ToggleFieldVisible(#sToExistFile,false);
      }
      #wFromExistFile:
      {
        if wFromExistFile = 1 
          ToggleFieldVisible(#sFromExistFile,true )
        else
          ToggleFieldVisible(#sFromExistFile,false);
      }
    end;
  }
end;
end.
