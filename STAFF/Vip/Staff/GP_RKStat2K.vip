#define GPInt GP_RKStat_List2K // #(GPInt)
#define GPNam 02-К "Сведения о списочной численности работников в разрезе категорий персонала и стажа работы на предприятии" // #(GPNam)

VipInterface #(GPInt) Implements IGP_RKStat;
Interface #(GPInt);

const
#include Excel.inc;
end;
#include TotalOrganizationAttributes.var

table struct ttStat2K
(
  wTKat : word
, wMKat : word
, wLKat : word
, dbVal : array[1..12] of double
)
with index
(
  ttStat2K01 = wTKat + wMKat + wLKat
);
table struct ttItog2K
(
  wLKat : word
, dbVal : array[1..12] of double
)
with index
(
  ttItog2K01 = wLKat
);


var
  dRep          : date;
  iCatFunc      : CatalogsFunctions;
  iChRPD        : GP_ChRPD;
  iRunStaj      : Runstaj;
  iRKPRash      : GP_RKPrintRash;
  iUDR          : GP_UDR_RKStat;
  sFullName     : string;
  sKatWorker1
 ,sKatWorker2
 ,sKatWorker3
 ,sKatWorker4   : string;
  sKatType1
 ,sKatType2
 ,sKatType3
 ,sKatType4
 ,sKatType5
 ,sKatType6
 ,sKatType7
 ,sKatType8
 ,sKatType9
 ,sKatType10
 ,sKatType11
 ,sKatType12
 ,sKatType13    : string;
  sPodr1        : string;
  mKatWorker1
 ,mKatWorker2
 ,mKatWorker3
 ,mKatWorker4   : TPtr;
  mPodr1        : TPtr;
  mKatType1
 ,mKatType2
 ,mKatType3
 ,mKatType4
 ,mKatType5
 ,mKatType6
 ,mKatType7
 ,mKatType8
 ,mKatType9
 ,mKatType10
 ,mKatType11
 ,mKatType12
 ,mKatType13    : TPtr;
  mPersRash2k   : TPtr;
  mPersRash2kErr: TPtr;
  wPrintRash    : word;
  wToExistFile  : word;
  sToExistFile  : string;
  wFromExistFile  : word;
  sFromExistFile  : string;
  isStayAloneAll: boolean = false;

create view
var
  cPodrV : comp;
  dRepV  : date;
  wLKIt  : word;
from
  ttStat2K
, ttItog2K
, StaffStruct
, Appointments
, contdoc DisDocCheck
, LSchet     
, Persons
, KlKatego
where
((
    cPodrV == StaffStruct.Department
and dRepV >>= StaffStruct.dInput
//and ((dRepV<=StaffStruct.dClose or StaffStruct.dClose=0) and dRepV>=StaffStruct.dInput)
//----
and StaffStruct.nRec == Appointments.StaffStr
and ( ( dRepV <= Appointments.DismissDate or Appointments.DismissDate = 0 ) and dRepV >= Appointments.AppointDate )
and Appointments.nrec == DisDocCheck.cStr and (DisDocCheck.TypeOper = integer(8))
//----
and Appointments.cAddnRec2 == LSchet.nRec
and Appointments.Person == Persons.nRec
))
;

function sSetKatName(mSetKat: TPtr): string;
{
  if (getMarkerCount(mSetKat) = 0)
  {
    result := 'Не выбраны категории';
    exit;
  }
  else
    if (getMarkerCount(mSetKat) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetKat, 0, cTmp);
      if GetFirst KlKatego where (( cTmp == KlKatego.NRec )) = tsOk
        result := KlKatego.NaiKat;
      else
        result := '';
    }
    else
      result := 'Несколько категорий (' + string(getMarkerCount(mSetKat)) + ')';
}

function sSetTypName(mSetPdr: TPtr): string;
{
  if (getMarkerCount(mSetPdr) = 0)
  {
    result := 'Не выбраны категории';
    exit;
  }
  else
    if (getMarkerCount(mSetPdr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько категорий (' + string(getMarkerCount(mSetPdr)) + ')';
}

function sSetPodrName(mSetPdr: TPtr): string;
{
  if (getMarkerCount(mSetPdr) = 0)
  {
    result := 'Не выбраны подразделения';
    exit;
  }
  else
    if (getMarkerCount(mSetPdr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько подразделений (' + string(getMarkerCount(mSetPdr)) + ')';
}

function wWhatKatT(cKateg : comp) : word;
{
  result := 0;

  if cKateg <> comp(0)
  {
    if FoundMarker(mKatType1, cKateg)
    {result := 1}
      else
    if FoundMarker(mKatType2, cKateg)
    {result := 1}
      else
    if FoundMarker(mKatType3, cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType4, cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType5, cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType6, cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType7, cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType8, cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType9, cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType10,cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType11,cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType12,cKateg)
    {result := 2}
      else
    if FoundMarker(mKatType13, cKateg)
    {result := 3}
  }
}

function wWhatKatM(cKateg : comp) : word;
{
  result := 0;

  if cKateg <> comp(0)
  {
    if FoundMarker(mKatType1, cKateg)
    {result := 10}
      else
    if FoundMarker(mKatType2, cKateg)
    {result := 11}
      else
    if FoundMarker(mKatType3, cKateg)
    {result := 20}
      else
    if FoundMarker(mKatType4, cKateg)
    {result := 21}
      else
    if FoundMarker(mKatType5, cKateg)
    {result := 22}
      else
    if FoundMarker(mKatType6, cKateg)
    {result := 23}
      else
    if FoundMarker(mKatType7, cKateg)
    {result := 24}
      else
    if FoundMarker(mKatType8, cKateg)
    {result := 25}
      else
    if FoundMarker(mKatType9, cKateg)
    {result := 26}
      else
    if FoundMarker(mKatType10,cKateg)
    {result := 27}
      else
    if FoundMarker(mKatType11,cKateg)
    {result := 28}
      else
    if FoundMarker(mKatType12,cKateg)
    {result := 29}
      else
    if FoundMarker(mKatType13, cKateg)
    {result := 30}
  }
}

function wWhatKatL(cKateg : comp) : word;
{
  if cKateg <> comp(0)
  {
    if FoundMarker(mKatWorker1, cKateg)
    {result := 1}
      else
    if FoundMarker(mKatWorker2, cKateg)
    {result := 2}
      else
    if FoundMarker(mKatWorker3, cKateg)
    {result := 3}
      else
    if FoundMarker(mKatWorker4, cKateg)
    {result := 4}
  }
  else
  {result := 0}
}

function wWhatStajPeriod(cPsn : comp; dOnDate : date) : word;
{
  var wStajPsn : word;

  wStajPsn := iRunStaj.GetStajYears(cPsn, 89, dOnDate);
  if wStajPsn < 1
    result := 1
  else
  if wStajPsn < 3
    result := 3
  else
  if wStajPsn < 5
    result := 5
  else
  if wStajPsn < 10
    result := 7
  else
  if wStajPsn < 20
    result := 9
  else
    result := 11;
}

function isDataFor2k(wT, wM, wL : word) : boolean;
{
  result := false;
  if (wT = 1)
    if (wM = 10 or wM = 11)
      if (wL = 1 or wL = 2 or wL = 3)
        result := true;
  if (wT = 2)
    if (wM >= 20 and wM <= 26)
      if (wL = 1 or wL = 2)
        result := true;
  if (wT = 2)
    if (wM >= 27 and wM <= 29)
      if (wL = 4)
        result := true;
  if (wT = 3)
    if (wM = 30)
      if (wL >= 1 and wL <= 4)
        result := true;
}
function OpenFromRKS : boolean;
{
  result := false;
  xlOpenExcel(true);
  xlDisplayAlerts(false);
  if xlOpenWorkBook(sFromExistFile)
    result := true;
}
function CloseFromRKS : boolean;
{
  result := false;
  if xlCloseWorkBookByName(sFromExistFile)
//  if xlKillExcel
    result := true;
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
  xlDisplayAlerts(true);
  if isStayAloneAll
    xlKillExcel;
}

procedure SetPrewRow(_wTF, _wMF, _wLF, _wRow: word);
{
  if ( getfirst ttStat2K where
  ((  _wTF == ttStat2K.wTKat
  and _wMF == ttStat2K.wMKat
  and _wLF == ttStat2K.wLKat
  )) <> tsOk )
  {
    clearbuffer(#ttStat2K);
    ttStat2K.wTKat := _wTF;
    ttStat2K.wMKat := _wMF;
    ttStat2K.wLKat := _wLF;
    insert current ttStat2K;
  }
  var iI: integer;
  var dbFrom: double;
  for(iI := 2; iI <= 7; iI++)
  {
    dbFrom := 0;
    if xlGetCellValue( _wRow, (iI*3), dbFrom)
      ttStat2K.dbVal[(iI-1)*2] := dbFrom;
  }
  update current ttStat2K;
}

procedure InitPrevResults;
{
    if OpenFromRKS
    {
      if xlSetActiveSheetByName('2-к')
      { //xlGetCellValue
        SetPrewRow(1, 10, 1,  6);
        SetPrewRow(1, 10, 2,  7);
        SetPrewRow(1, 10, 3,  8);
        SetPrewRow(1, 11, 1,  9);
        SetPrewRow(1, 11, 2, 10);
        SetPrewRow(1, 11, 3, 11);
        SetPrewRow(2, 20, 1, 17);
        SetPrewRow(2, 20, 2, 18);
        SetPrewRow(2, 21, 1, 19);
        SetPrewRow(2, 21, 2, 20);
        SetPrewRow(2, 22, 1, 21);
        SetPrewRow(2, 22, 2, 22);
        SetPrewRow(2, 23, 1, 23);
        SetPrewRow(2, 23, 2, 24);
        SetPrewRow(2, 24, 1, 25);
        SetPrewRow(2, 24, 2, 26);
        SetPrewRow(2, 25, 1, 27);
        SetPrewRow(2, 25, 2, 28);
        SetPrewRow(2, 26, 1, 29);
        SetPrewRow(2, 26, 2, 30);
        SetPrewRow(2, 27, 4, 31);
        SetPrewRow(2, 28, 4, 32);
        SetPrewRow(2, 29, 4, 33);
        SetPrewRow(3, 30, 1, 39);
        SetPrewRow(3, 30, 2, 40);
        SetPrewRow(3, 30, 3, 41);
        SetPrewRow(3, 30, 4, 42);
      }
      if CloseFromRKS {}
    }
}

procedure Make2k;
{
  var kol, i,   j   : integer;
  var wTF, wMF, wLF : word;
  var cPodrT : comp;
  var isFreeDate: boolean = if (( day(dRep) = 31 ) and ( month(dRep) = 12 ), false, true);

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Формирую данные для Листа 2-к.', 0);
  kol := GetMarkerCount(mPodr1);
//Предыдущий период-----------------------------------
  if isFreeDate
  {
    dRepV := To_Date(1, month(dRep), Year(dRep)-1); 
    dRepV := To_Date(last_day(dRepV), month(dRepV), Year(dRepV)); //на случай високосного года
  }
  else
    dRepV := To_Date(31, 12, Year(dRep)-1); 
  i   := 0;
  
  if ( wFromExistFile = 1 )
  {
    InitPrevResults;
  }
  else
  while i < kol
  {
    GetMarker(mPodr1, i++, cPodrT);
    set cPodrV := cPodrT;
    if isvalid(#StaffStruct)
    _loop StaffStruct
    {
      if isvalid(#Appointments)
      _loop Appointments
      {
        if (not NextVisual) break;
        if ( Appointments.DismissDate = dRepV )
          if isvalid(#DisDocCheck)
            if iChRPD.isConfirmed(DisDocCheck.nRec)
              continue;
        if isvalid(#LSchet)
        if isvalid(#Persons)
        if LSchet.Sovm <> 1 and LSchet.Sovm <> 2 and ( Appointments.lPrizn = 0 or Appointments.lPrizn = 100 ) and Appointments.Rate<>0
        {
          wTF := wWhatKatT(StaffStruct.cInf3);
          wMF := wWhatKatM(StaffStruct.cInf3);
          wLF := wWhatKatL(StaffStruct.EmpCategory);
          if isDataFor2k(wTF, wMF, wLF)
          {
            if getfirst ttStat2K where
            ((  wTF == ttStat2K.wTKat
            and wMF == ttStat2K.wMKat
            and wLF == ttStat2K.wLKat
            ))<>tsOk
            {
              clearbuffer(#ttStat2K);
              ttStat2K.wTKat := wTF;
              ttStat2K.wMKat := wMF;
              ttStat2K.wLKat := wLF;
              insert current ttStat2K;
            }
            ttStat2K.dbVal[wWhatStajPeriod(Persons.nRec,dRepV)+1] += 1;
            update current ttStat2K;
          }
        }
      }
    }
  }
//Текущий период   -----------------------------------
  set dRepV := dRep; 
  i   := 0;
  while i < kol
  {
    GetMarker(mPodr1, i++, cPodrT);
    set cPodrV := cPodrT;
    if isvalid(#StaffStruct)
    _loop StaffStruct
    {
      if isvalid(#Appointments)
      _loop Appointments
      {
        if (not NextVisual) break;
        if ( Appointments.DismissDate = dRepV )
          if isvalid(#DisDocCheck)
            if iChRPD.isConfirmed(DisDocCheck.nRec)
              continue;
        if isvalid(#LSchet)
        if isvalid(#Persons)
        if LSchet.Sovm <> 1 and LSchet.Sovm <> 2 and ( Appointments.lPrizn = 0 or Appointments.lPrizn = 100 ) and Appointments.Rate<>0
        {
          wTF := wWhatKatT(StaffStruct.cInf3);
          wMF := wWhatKatM(StaffStruct.cInf3);
          wLF := wWhatKatL(StaffStruct.EmpCategory);
          if isDataFor2k(wTF, wMF, wLF)
          {
            if getfirst ttStat2K where
            ((  wTF == ttStat2K.wTKat
            and wMF == ttStat2K.wMKat
            and wLF == ttStat2K.wLKat
            ))<>tsOk
            {
              clearbuffer(#ttStat2K);
              ttStat2K.wTKat := wTF;
              ttStat2K.wMKat := wMF;
              ttStat2K.wLKat := wLF;
              insert current ttStat2K;
            }
            ttStat2K.dbVal[wWhatStajPeriod(Persons.nRec,dRepV)] += 1;
            update current ttStat2K;
            if not FoundMarker(mPersRash2k,Appointments.nRec)
              InsertMarker(mPersRash2k,Appointments.nRec);
          }
          else
          {
            if not FoundMarker(mPersRash2kErr,Appointments.nRec)
              InsertMarker(mPersRash2kErr,Appointments.nRec);
          }
        }
      }
    }
  }
  StopVisual;
}

function isData2k : boolean;
{
  if isvalid(#ttStat2K)
    result := true
  else
    result := false;
}

procedure PrintRow2k(wKT, wKM, wKL, wRow : word);
{
  var wCol : integer;
  if getfirst ttStat2K where((wKT==ttStat2K.wTKat and wKM==ttStat2K.wMKat and wKL==ttStat2K.wLKat)) = tsOk
  {
    if (not NextVisual) exit;
    wCol:=6 ; xlSetCellNumberValue(ttStat2K.dbVal[1] ,wRow,wCol,wRow,wCol); //6
    wCol:=8 ; xlSetCellNumberValue(if(ttStat2K.dbVal[2] <>0, ttStat2K.dbVal[1]/ttStat2K.dbVal[2] ,0) ,wRow,wCol,wRow,wCol); //8
    wCol:=9 ; xlSetCellNumberValue(ttStat2K.dbVal[3] ,wRow,wCol,wRow,wCol); //9
    wCol:=11; xlSetCellNumberValue(if(ttStat2K.dbVal[4] <>0, ttStat2K.dbVal[3]/ttStat2K.dbVal[4] ,0) ,wRow,wCol,wRow,wCol); //11
    wCol:=12; xlSetCellNumberValue(ttStat2K.dbVal[5] ,wRow,wCol,wRow,wCol); //12
    wCol:=14; xlSetCellNumberValue(if(ttStat2K.dbVal[6] <>0, ttStat2K.dbVal[5]/ttStat2K.dbVal[6] ,0) ,wRow,wCol,wRow,wCol); //14
    wCol:=15; xlSetCellNumberValue(ttStat2K.dbVal[7] ,wRow,wCol,wRow,wCol); //15
    wCol:=17; xlSetCellNumberValue(if(ttStat2K.dbVal[8] <>0, ttStat2K.dbVal[7]/ttStat2K.dbVal[8] ,0) ,wRow,wCol,wRow,wCol); //17
    wCol:=18; xlSetCellNumberValue(ttStat2K.dbVal[9] ,wRow,wCol,wRow,wCol); //18
    wCol:=20; xlSetCellNumberValue(if(ttStat2K.dbVal[10]<>0, ttStat2K.dbVal[9]/ttStat2K.dbVal[10],0),wRow,wCol,wRow,wCol); //20
    wCol:=21; xlSetCellNumberValue(ttStat2K.dbVal[11],wRow,wCol,wRow,wCol); //21
    wCol:=23; xlSetCellNumberValue(if(ttStat2K.dbVal[12]<>0,ttStat2K.dbVal[11]/ttStat2K.dbVal[12],0),wRow,wCol,wRow,wCol); //23
    if getfirst ttItog2K where((0 == ttItog2K.wLKat))<>tsOk
    {
      clearbuffer(#ttItog2K);
      ttItog2K.wLKat := 0;
      insert current ttItog2K;
    }
    ttItog2K.dbVal[2] += ttStat2K.dbVal[2] ; 
    ttItog2K.dbVal[4] += ttStat2K.dbVal[4] ;
    ttItog2K.dbVal[6] += ttStat2K.dbVal[6] ;
    ttItog2K.dbVal[8] += ttStat2K.dbVal[8] ;
    ttItog2K.dbVal[10]+= ttStat2K.dbVal[10];
    ttItog2K.dbVal[12]+= ttStat2K.dbVal[12];
    update current ttItog2K;
    
    if getfirst ttItog2K where((wKL == ttItog2K.wLKat))<>tsOk
    {
      clearbuffer(#ttItog2K);
      ttItog2K.wLKat := wKL;
      insert current ttItog2K;
    }
    ttItog2K.dbVal[2] += ttStat2K.dbVal[2] ; 
    ttItog2K.dbVal[4] += ttStat2K.dbVal[4] ;
    ttItog2K.dbVal[6] += ttStat2K.dbVal[6] ;
    ttItog2K.dbVal[8] += ttStat2K.dbVal[8] ;
    ttItog2K.dbVal[10]+= ttStat2K.dbVal[10];
    ttItog2K.dbVal[12]+= ttStat2K.dbVal[12];
    update current ttItog2K;
  }
  else
  {
    if (not NextVisual) exit;
    wCol:=6 ; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //6
    wCol:=8 ; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //8
    wCol:=9 ; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //9
    wCol:=11; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //11
    wCol:=12; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //12
    wCol:=14; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //14
    wCol:=15; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //15
    wCol:=17; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //17
    wCol:=18; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //18
    wCol:=20; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //20
    wCol:=21; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //21
    wCol:=23; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol); //23
  }

}
procedure PrintIt2k(wKL, wRow : word);
{
  var wCol : word;

  if getfirst ttItog2K where((wKL == ttItog2K.wLKat))=tsOk
  {
    if (not NextVisual) exit;
    wCol:= 8; if ttItog2K.dbVal[2]=0
              {xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);}
              else
              {xlSetCellFormula('=F'+wRow+'/'+integer(ttItog2K.dbVal[2] ),wRow,wCol,wRow,wCol);}
    wCol:=11; if ttItog2K.dbVal[4]=0
              {xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);}
              else
              {xlSetCellFormula('=I'+wRow+'/'+integer(ttItog2K.dbVal[4] ),wRow,wCol,wRow,wCol);} 
    wCol:=14; if ttItog2K.dbVal[6]=0
              {xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);}
              else
              {xlSetCellFormula('=L'+wRow+'/'+integer(ttItog2K.dbVal[6] ),wRow,wCol,wRow,wCol);} 
    wCol:=17; if ttItog2K.dbVal[8]=0
              {xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);}
              else
              {xlSetCellFormula('=O'+wRow+'/'+integer(ttItog2K.dbVal[8] ),wRow,wCol,wRow,wCol);}  
    wCol:=20; if ttItog2K.dbVal[10]=0
              {xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);}
              else
              {xlSetCellFormula('=R'+wRow+'/'+integer(ttItog2K.dbVal[10]),wRow,wCol,wRow,wCol);}   
    wCol:=23; if ttItog2K.dbVal[12]=0
              {xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);}
              else
              {xlSetCellFormula('=U'+wRow+'/'+integer(ttItog2K.dbVal[12]),wRow,wCol,wRow,wCol);} 
  }
  else
  {
    if (not NextVisual) exit;
    wCol:= 8; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);
    wCol:=11; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);
    wCol:=14; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);
    wCol:=17; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);
    wCol:=20; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);
    wCol:=23; xlSetCellNumberValue(0,wRow,wCol,wRow,wCol);
  }
}
procedure Print2k;
{
  if isData2k
  if xlSetActiveSheetByName('2-к')
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Выгружаю данные для Листа 2-к в Excel.', 0);
    TOA.Bind(0);
    xlSetCellStringValue(Trim(TOA1.GetNaming.GetFullName()),2,5,2,5);
    xlSetCellStringValue(DateToStr(dRep,'DD.MM.YYYY'),3,5,3,5);
    PrintRow2k(1, 10, 1, 6);
    PrintRow2k(1, 10, 2, 7);
    PrintRow2k(1, 10, 3, 8);
    PrintRow2k(1, 11, 1, 9);
    PrintRow2k(1, 11, 2,10);
    PrintRow2k(1, 11, 3,11);
    PrintRow2k(2, 20, 1,17);
    PrintRow2k(2, 20, 2,18);
    PrintRow2k(2, 21, 1,19);
    PrintRow2k(2, 21, 2,20);
    PrintRow2k(2, 22, 1,21);
    PrintRow2k(2, 22, 2,22);
    PrintRow2k(2, 23, 1,23);
    PrintRow2k(2, 23, 2,24);
    PrintRow2k(2, 24, 1,25);
    PrintRow2k(2, 24, 2,26);
    PrintRow2k(2, 25, 1,27);
    PrintRow2k(2, 25, 2,28);
    PrintRow2k(2, 26, 1,29);
    PrintRow2k(2, 26, 2,30);
    PrintRow2k(2, 27, 4,31);
    PrintRow2k(2, 28, 4,32);
    PrintRow2k(2, 29, 4,33);
    PrintRow2k(3, 30, 1,39);
    PrintRow2k(3, 30, 2,40);
    PrintRow2k(3, 30, 3,41);
    PrintRow2k(3, 30, 4,42);
    PrintIt2k (0, 44);
    PrintIt2k (1, 45);
    PrintIt2k (2, 46);
    PrintIt2k (3, 47);
    PrintIt2k (4, 48);
    StopVisual;
  }
}

procedure Save2k;
{
  iUDR.SaveMarker('RKS1_2_mKat1', mKatWorker1); DoneMarker(mKatWorker1, '');
  iUDR.SaveMarker('RKS1_2_mKat2', mKatWorker2); DoneMarker(mKatWorker2, '');
  iUDR.SaveMarker('RKS1_2_mKat3', mKatWorker3); DoneMarker(mKatWorker3, '');
  iUDR.SaveMarker('RKS1_2_mKat4', mKatWorker4); DoneMarker(mKatWorker4, '');

  iUDR.SaveMarker('RKS1_2_mKatType1' , mKatType1 ); DoneMarker(mKatType1 , '');
  iUDR.SaveMarker('RKS1_2_mKatType2' , mKatType2 ); DoneMarker(mKatType2 , '');
  iUDR.SaveMarker('RKS1_2_mKatType3' , mKatType3 ); DoneMarker(mKatType3 , '');
  iUDR.SaveMarker('RKS1_2_mKatType4' , mKatType4 ); DoneMarker(mKatType4 , '');
  iUDR.SaveMarker('RKS1_2_mKatType5' , mKatType5 ); DoneMarker(mKatType5 , '');
  iUDR.SaveMarker('RKS1_2_mKatType6' , mKatType6 ); DoneMarker(mKatType6 , '');
  iUDR.SaveMarker('RKS1_2_mKatType7' , mKatType7 ); DoneMarker(mKatType7 , '');
  iUDR.SaveMarker('RKS1_2_mKatType8' , mKatType8 ); DoneMarker(mKatType8 , '');
  iUDR.SaveMarker('RKS1_2_mKatType9' , mKatType9 ); DoneMarker(mKatType9 , '');
  iUDR.SaveMarker('RKS1_2_mKatType10', mKatType10); DoneMarker(mKatType10, '');
  iUDR.SaveMarker('RKS1_2_mKatType11', mKatType11); DoneMarker(mKatType11, '');
  iUDR.SaveMarker('RKS1_2_mKatType12', mKatType12); DoneMarker(mKatType12, '');
  iUDR.SaveMarker('RKS1_2_mKatType13', mKatType13); DoneMarker(mKatType13, '');

  iUDR.SaveMarker('RKS1_2_mPodr1', mPodr1); DoneMarker(mPodr1, '');
  
  DoneMarker(mPersRash2k,'');
  DoneMarker(mPersRash2kErr,'');

  iUDR.SaveDate  ('RKS1_2_dRep'      , dRep        );
  iUDR.SaveWord  ('RKS2_wToExistFile', wToExistFile);
  iUDR.SaveString('RKS2_sToExistFile', sToExistFile);
  iUDR.SaveWord  ('RKS2_wPrintRash'  , wPrintRash  );
  iUDR.SaveWord  ('RKS2_wFromExistFile', wFromExistFile);
  iUDR.SaveString('RKS2_sFromExistFile', sFromExistFile);
}
procedure Clear2k;
{
  delete all from ttStat2K;
}
procedure init2k;
{
  set dRep := iUDR.ReadDate('RKS1_2_dRep');
  if dRep = 0
    set dRep := To_Date(31,12,Year(Cur_Date));
  
  set wPrintRash   := iUDR.ReadWord  ('RKS2_wPrintRash'  );
  set sToExistFile := iUDR.ReadString('RKS2_sToExistFile');
  set wToExistFile := iUDR.ReadWord  ('RKS2_wToExistFile');
  if wToExistFile = 1 
    ToggleFieldVisible(#sToExistFile,true )
  else
    ToggleFieldVisible(#sToExistFile,false);

  set sFromExistFile := iUDR.ReadString('RKS2_sFromExistFile');
  set wFromExistFile := iUDR.ReadWord  ('RKS2_wFromExistFile');
  if wFromExistFile = 1 
    ToggleFieldVisible(#sFromExistFile,true )
  else
    ToggleFieldVisible(#sFromExistFile,false);
  
  mPodr1 := iUDR.ReadMarker('RKS1_2_mPodr1'); set sPodr1 := sSetPodrName(mPodr1);

  mKatWorker1 := iUDR.ReadMarker('RKS1_2_mKat1'); set sKatWorker1 := sSetKatName(mKatWorker1);
  mKatWorker2 := iUDR.ReadMarker('RKS1_2_mKat2'); set sKatWorker2 := sSetKatName(mKatWorker2);
  mKatWorker3 := iUDR.ReadMarker('RKS1_2_mKat3'); set sKatWorker3 := sSetKatName(mKatWorker3);
  mKatWorker4 := iUDR.ReadMarker('RKS1_2_mKat4'); set sKatWorker4 := sSetKatName(mKatWorker4);

  mPersRash2k    := initMarker('', 8, 1000, 100, true);
  mPersRash2kErr := initMarker('', 8, 1000, 100, true);

  mKatType1  := iUDR.ReadMarker('RKS1_2_mKatType1' ); set sKatType1  := sSetTypName(mKatType1 );
  mKatType2  := iUDR.ReadMarker('RKS1_2_mKatType2' ); set sKatType2  := sSetTypName(mKatType2 );
  mKatType3  := iUDR.ReadMarker('RKS1_2_mKatType3' ); set sKatType3  := sSetTypName(mKatType3 );
  mKatType4  := iUDR.ReadMarker('RKS1_2_mKatType4' ); set sKatType4  := sSetTypName(mKatType4 );
  mKatType5  := iUDR.ReadMarker('RKS1_2_mKatType5' ); set sKatType5  := sSetTypName(mKatType5 );
  mKatType6  := iUDR.ReadMarker('RKS1_2_mKatType6' ); set sKatType6  := sSetTypName(mKatType6 );
  mKatType7  := iUDR.ReadMarker('RKS1_2_mKatType7' ); set sKatType7  := sSetTypName(mKatType7 );
  mKatType8  := iUDR.ReadMarker('RKS1_2_mKatType8' ); set sKatType8  := sSetTypName(mKatType8 );
  mKatType9  := iUDR.ReadMarker('RKS1_2_mKatType9' ); set sKatType9  := sSetTypName(mKatType9 );
  mKatType10 := iUDR.ReadMarker('RKS1_2_mKatType10'); set sKatType10 := sSetTypName(mKatType10);
  mKatType11 := iUDR.ReadMarker('RKS1_2_mKatType11'); set sKatType11 := sSetTypName(mKatType11);
  mKatType12 := iUDR.ReadMarker('RKS1_2_mKatType12'); set sKatType12 := sSetTypName(mKatType12);
  mKatType13 := iUDR.ReadMarker('RKS1_2_mKatType13'); set sKatType13 := sSetTypName(mKatType13);
}

function isCheckRepParam(isStayAlone : boolean) : boolean;
{
  result := false;
  if dRep = 0
  {if isStayAlone message('Не задана дата!', error); exit;}
  if ( day(dRep) = 31 and month(dRep) = 12 ) {}
  else
  {
    if isStayAlone
      if ( message('Дата формирования отчета отличается от регламентной!'#3+chr(13)+'Продолжить?'#3, Information+yesNo) <> cmYes )
        exit;
  }
  if GetMarkerCount(mKatWorker1) = 0
  or GetMarkerCount(mKatWorker2) = 0
  or GetMarkerCount(mKatWorker3) = 0
  or GetMarkerCount(mKatWorker4) = 0 
  or GetMarkerCount(mKatType1 ) = 0 
  or GetMarkerCount(mKatType2 ) = 0 
  or GetMarkerCount(mKatType3 ) = 0 
  or GetMarkerCount(mKatType4 ) = 0 
  or GetMarkerCount(mKatType5 ) = 0 
  or GetMarkerCount(mKatType6 ) = 0 
  or GetMarkerCount(mKatType7 ) = 0 
  or GetMarkerCount(mKatType8 ) = 0 
  or GetMarkerCount(mKatType9 ) = 0 
  or GetMarkerCount(mKatType10) = 0 
  or GetMarkerCount(mKatType11) = 0 
  or GetMarkerCount(mKatType12) = 0 
  or GetMarkerCount(mKatType13) = 0 
  {if isStayAlone message('Не установлена одна из категорий!'); exit;}
  if GetMarkerCount(mPodr1) = 0
  {if isStayAlone message('Не заданы подразделения!'); exit;}
  if wToExistFile = 1
    if not ExistFile(sToExistFile)
    {if isStayAlone message('Ошибка открытия файла!'); exit;}
  if ( wFromExistFile = 1 )
    if not ExistFile(sFromExistFile)
    {if isStayAlone message('Ошибка открытия входного файла!'); exit;}
  result := true;
}
//++++++++++++++++++++++++++++++++++++++++++++++++
window Win2kParamEx 'Параметры формирования. Лист 2-К.' Gray;
  show at (,,95,35);
Screen sEx(,,sci1Esc);
  fields
    dRep   ('Дата формирования'): {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    sPodr1 ('Выбранные подразделения',hcStaffAppDepartment,sci13Esc): {Font = {BackColor = if(sPodr1 = 'Не выбраны подразделения', ColorNeed, 0)}},Protect, PickButton ;
    sKatWorker1 ('Руководители',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker1 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatWorker2 ('Специалисты' ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker2 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatWorker3 ('Служащие'    ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker3 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatWorker4 ('Рабочие'     ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker4 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType1   ('Административный персонал   ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType1 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType2   ('Цеховой персонал (кроме ИТР)',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType2 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType3   ('Инженеры-конструкторы  КБ                 ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType3 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType4   ('Инженеры-технологи КБ                     ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType4 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType5   ('Инженеры-конструкторы завод               ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType5 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType6   ('Инженеры-технологи завод                  ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType6 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType7   ('Инженеры-конструкторы ИК                  ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType7 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType8   ('Инженеры-технологи, инженеры-испытатели ИК',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType8 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType9   ('Научные подразделения                     ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType9 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType10  ('Основные рабочие                          ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType10= 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType11  ('Производственные рабочие                  ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType11= 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType12  ('Вспомогательные рабочие                   ',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType12= 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType13  ('Персонал непромышленной сферы',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType13 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    wFromExistFile('Считать данные за прошлый период из файла'), noprotect;
    sFromExistFile('Считать данные за прошлый период из файла',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sFromExistFile = '', ColorNeed, 0)}},protect;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
<< 'Параметры отчета'

 `Дата формирования       `.@@@@@@@@@@@
 Регламентная дата формирования 31 декабря
 `Подразделения для отчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Соответствие категорий`
  `Руководители`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Специалисты `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Служащие    `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Рабочие     `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Административно управленческий персонал    `
  `Административный персонал                 `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Цеховой персонал (кроме ИТР)              `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Основной производственный персонал         `
  `Инженеры-конструкторы  КБ                 `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Инженеры-технологи КБ                     `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Инженеры-конструкторы завод               `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Инженеры-технологи завод                  `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Инженеры-конструкторы ИК                  `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Инженеры-технологи, инженеры-испытатели ИК`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Научные подразделения                     `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Основные рабочие                          `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Производственные рабочие                  `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Вспомогательные рабочие                   `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  
  `Персонал непромышленной сферы             `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  [.] Считать данные за прошлый период из файла`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   <. ~С~охранить .>                                                        <. ~З~акрыть .>
>>
end;
HandleEvent
  cmOK:
  {
    Save2k;
    init2k;
    if not isCheckRepParam(true)
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
  cmCancel:
  {
    Save2k;
    CloseWindowEx(CurWindow,cmCancel);
  }
end;
end;//Win2kParamEx
