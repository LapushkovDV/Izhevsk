  `Научные подразделения                     `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Основные рабочие                          `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Производственные рабочие                  `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Вспомогательные рабочие                   `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  
  `Персонал непромышленной сферы             `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   [.] Добавить в существующий файл          `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   [.] Считать данные за прошлый период из файла`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   [.] Печать расшифровки`

   <. ~С~формировать .>                                                     <. ~З~акрыть .>
>>
end;
HandleEvent
  cmOK:
  {
    if not isCheckRepParam(true)
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
end;
end;//Win2kParam
//++++++++++++++++++++++++++++++++++++++++++++++++
function OpenNew2k : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExist2k : boolean;
{
  result := false;
  xlOpenExcel(true);
  if xlOpenWorkBook(sToExistFile)
    result := true;
}

function SetParam2k : boolean;
{
  result := false;
  if RunWindowModal(Win2kParam)=cmDefault
    result := true;
}

procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  init2k;

  if isStayAlone
    if SetParam2k
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);
  
  if isDoRep
  {
    Make2k;
    if isData2k
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNew2K;}
        if wToExistFile = 1 {isOkFile := OpenExist2K;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        Print2k;
        if wPrintRash = 1 and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='2-к' break;
          }//while i<=j
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 2-К'); 
          xlSetActiveSheet(i);
          iRKPRash.RKRash1(mPersRash2k, mPersRash2kErr, '2-К',dRep);
        }//if wPrintRash = 1 and isStayAlone
        xlSetActiveSheetByName('2-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }//if isOkFile
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }//if isData2k
    else if isStayAlone message('Нет данных для отчета.');
  }//if isDoRep
  Save2k;
  Clear2k;
  closeinterface(cmDefault);
}
//++++++++++++++++++++++++++++++++++++++++++++++++
