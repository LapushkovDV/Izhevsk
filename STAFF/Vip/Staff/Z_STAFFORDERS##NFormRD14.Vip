#component "Z_STAFFORDERS"
#doc
Печать  приказа "о выходе на работу и изменении даты окончания отпуска
по уходу за ребенком" РД 14
#end
#include GP_DepFunc.vih
//******************************************************************************
Alter Interface NFormRD14 ('');
//******************************************************************************
#include GP_DepFunc.var
OverLoad
DataStream DTS_RPD14;
End;
//------------------------------------------------------------------------------
// Поток данных для вывода на печать
DataStream DTS_RPD14
// описание потока данных
(
  // расширяем существующую
  Table inherited::NForm14Data
  (
   [DATEENDOTPUSK] CONTDOC.DAT1;
   [sPodrNAME] oGP_DepFunc.GetFullDepName(Appointments.Department, 0, 1, ' ', TitleDoc.DocDate);// iCatFunc.GetCatalogsName(Appointments.Department);
   [sPodrCode] SubStr(IDepartIer.GetCodeOnDate(Appointments.Department,
                                               if (Day(TitleDoc.DocDate) > 0, TitleDoc.DocDate, Cur_Date)),
                      1, 3);
  );
)
end;


