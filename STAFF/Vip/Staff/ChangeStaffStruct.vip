#include xlReport.vih
#include STRUCTFN.VIH
#include StrPrFilter.vih                 // фильтр реестра приказов
#include InfoFromHistoryStr.vih          // получение актуальных величин
#include StaffStruct.vih
#include LReports.vih
#include RunRaise.vih                    // Интерфейс расчета доплат в кадрах
#include CatFunc.vih                     // Интерфейс работы с каталогом

interface iChangeStaffSturct 'Отчет по изменениям ШР' EscClose;

//*****************************************************************************
table struct tmpT3
(
  NRec           : comp
, cDolIskl       : comp
, sDolIskl       : string
, dKolIskl       : double
, dOkladCIskl    : double
, dOkladIskl     : double
, dTotalIskl     : double
, cMainPodr      : comp
, cPodrIskl      : comp
, PodrNameIskl   : string
, PodrCodeIskl   : string
, sDolVvod       : string
, cDolVvod       : comp
, dKolVvod       : double
, dOkladCVvod    : double
, dOkladVvod     : double
, dTotalVvod     : double
, cPodrVvod      : comp
, PodrNameVvod   : string
, PodrCodeVvod   : string
, sType          : string
, dDate          : date
, cStaff         : comp
, wPrint         : word
, NPP            : word
)
with index
(
  tmpT301 = NRec (Unique, Surrogate)
, tmpT302 = cMainPodr + cStaff
, tmpT303 = cMainPodr + cPodrIskl + wPrint + cDolIskl + dDate
, tmpT304 = cMainPodr + cPodrVvod + wPrint + cDolVvod + dDate
, tmpT305 = cMainPodr + wPrint + dDate + NPP
, tmpT306 = wPrint
)              
;

table struct tmpPodr
(
  NRec      : comp
, Name      : string
, Code      : string
, dKolStaff : double
, dSumOklad : double
)
with index
(
  tmpPodr01 = NRec(Unique) 
, tmpPodr02 = Code
);
//*****************************************************************************
create view
var 
  dBeginPeriod
, dEndPeriod     : date;

  wTypeRDP       : word;

  hMarker1  
, hMarker2
, hMarker3       : longint;

as select 
  *
from
  StrTitle    StrTitleEm
, StrPart     StrPartEm
, StrCont     StrContEm
, StaffStruct StaffStructEm
, StaffStruct StaffStructEm2
, HistoryStr  HistoryStrEm
, HistoryStr  HistoryStrEm2
, HistoryStr  HistoryStrFirstEm
, Catalogs    CatalogsEMI
, Catalogs    CatalogsSum
, tmpT3
, tmpT3 tmpT3_2
, tmpPodr
, Catalogs    PodrEm    
, RaiseStS    RaiseStSEm2   
, StaffStruct StaffStructNew


where 
((
    tmpPodr.NRec == tmpT3.cMainPodr
AND 1            == tmpT3.wPrint
)) 
order by tmpT3.dDate, tmpT3.NPP   
order by tmpPodr.Code 
;
//*****************************************************************************
var FOEm       : StrPrFilterEx;                // объект фильтра для
var iSHR       : StaffStruct;                  // ШР
var iRaise     : RunRaise;                     // Функции работы с доплатами
var IFHS       : InfoFromHistoryStr;           // получение последней записи истории 
var iCatFunc   : CatalogsFunctions;            // Переменная типа интерфейс CatalogsFunctions
var iStaffStr  : StaffStruct;                  // ШР
//*****************************************************************************

Form frmReport('iEM_CnahgeStaffStruct.out', 'iEM_CnahgeStaffStruct') with novisual;
//*****************************************************************************
datastream ChangeStaffSturctStream
(
  [CFH     ]      CommonFormHeader;
  [BeginPeriod]   DateToStr(dBeginPeriod, 'DD.MM.YYYY');
  [EndPeriod]     DateToStr(dEndPeriod  , 'DD.MM.YYYY');

  table tmpPodr
  (
     [PodrNRec]  tmpPodr.NRec;
     [PodrName]  tmpPodr.Name;
     [PodrCode]  tmpPodr.Code;
     [KolStaff]  tmpPodr.dKolStaff;
     [dSumOklad] tmpPodr.dSumOklad;
  );
  table tmpT3
  (
    [cDolIskl]     tmpT3.cDolIskl;  
    [sDolIskl]     tmpT3.sDolIskl;  
    [dKolIskl]     tmpT3.dKolIskl;  
    [dOkladIskl]   tmpT3.dOkladIskl;
    [dOkladCIskl]  tmpT3.dOkladCIskl;
    [dTotalIskl]   tmpT3.dTotalIskl;
    [PodrNRecIskl] tmpT3.cPodrIskl;
    [PodrNameIskl] tmpT3.PodrNameIskl;
    [PodrCodeIskl] tmpT3.PodrCodeIskl;

    [cDolVvod]     tmpT3.cDolVvod; 
    [sDolVvod]     tmpT3.sDolVvod;   
    [dKolVvod]     tmpT3.dKolVvod;  
    [dOkladVvod]   tmpT3.dOkladVvod;
    [dOkladCVvod]  tmpT3.dOkladCVvod;
    [dTotalVvod]   tmpT3.dTotalVvod;
    [PodrNRecVvod] tmpT3.cPodrVvod;
    [PodrNameVvod] tmpT3.PodrNameVvod;
    [PodrCodeVvod] tmpT3.PodrCodeVvod;

    [sType]        tmpT3.sType;     
    [dDate]        tmpT3.dDate;     
    [cStaff]       tmpT3.cStaff;    
  );
)
end;
//*****************************************************************************
Procedure PrintReport;
{
  frmReport.Write(CommonFormHeader);

  if (dBeginPeriod <> ZeroDate) 
    frmReport.Write(DateToStr(dBeginPeriod, 'DD.MM.YYYY'));     
  else
    frmReport.SkipFormat(1);   

  if (dEndPeriod <> ZeroDate) 
    frmReport.Write(DateToStr(dEndPeriod, 'DD.MM.YYYY'));     
  else
    frmReport.SkipFormat(1);   

  _LOOP tmpPodr ordered by tmpPodr.Code
    {
      if (GetFirst tmpT3_2 where ((tmpPodr.NRec == tmpT3_2.cMainPodr
                               AND 1            == tmpT3_2.wPrint)) <> tsOk)
        continue;

      frmReport.PutEventById(feDoLoop, fcLoopPodr);
      frmReport.Write(tmpPodr.NRec);
      frmReport.Write(tmpPodr.Name);
      frmReport.Write(tmpPodr.Code);
      frmReport.Write(tmpPodr.dKolStaff);
      frmReport.Write(tmpPodr.dSumOklad);

      _LOOP tmpT3
        {
          frmReport.PutEventById(feDoLoop, fcLoopDoc);
          if (tmpT3.cDolIskl = comp(0))
            frmReport.SkipFormat(5);
          else
            {     
              frmReport.Write(tmpT3.cDolIskl);  
              frmReport.Write(tmpT3.sDolIskl);  
              frmReport.Write(tmpT3.dKolIskl);  
              frmReport.Write(tmpT3.dOkladIskl);
              frmReport.Write(tmpT3.dOkladCIskl);
              frmReport.Write(tmpT3.dTotalIskl);
            }

          if (tmpT3.cDolVvod = comp(0))
            frmReport.SkipFormat(5);
          else
            {  
              frmReport.Write(tmpT3.cDolVvod); 
              frmReport.Write(tmpT3.sDolVvod);   
              frmReport.Write(tmpT3.dKolVvod);  
              frmReport.Write(tmpT3.dOkladVvod);
              frmReport.Write(tmpT3.dOkladCVvod);
              frmReport.Write(tmpT3.dTotalVvod);
            } 
          frmReport.Write(tmpT3.sType);     
          if (tmpT3.dDate <> ZeroDate) 
            frmReport.Write(DateToStr(tmpT3.dDate, 'DD.MM.YYYY'));     
          else
            frmReport.SkipFormat(1);   
          frmReport.Write(tmpT3.cStaff);    
        }
    }

  if (NOT frmReport.error)
    frmReport.showFile('Изменениям ШР (iCNII_CardPersRep.out)');
  else
    frmReport.abortForm;
}
//*****************************************************************************
Function GetFirstHistory(ccStaff : comp; ddInput, ddHistDate : date) : boolean;
{

  var dd   : date;    dd   := if (ddInput > dBeginPeriod, ddInput, dBeginPeriod);

  if (GetFirst HistoryStrFirstEm where ((ccStaff  == HistoryStrFirstEm.StaffStr
                                     AND dd       == HistoryStrFirstEm.dHist)) <> tsOk)
    if (ddInput = dBeginPeriod)
      {
        result := false;
        exit;
      }     
    else
      if (GetLast HistoryStrFirstEm where ((ccStaff      == HistoryStrFirstEm.StaffStr
                                        AND dd          <<= HistoryStrFirstEm.dHist
                                        AND ddHistDate  >>  HistoryStrFirstEm.dHist)) <> tsOk)
        {
           result := false;
           exit;
        }

  result := true;

}

//*****************************************************************************
Function GetTypeName(vid : word) : string;
{
  case vid of
     1: result := 'Создание структурного подразделения';
    20: result := 'Создание ставки';
    30: result := 'Добавление доплаты';
     2: result := 'Ликвидация структурного подразделения';
    21: result := 'Ликвидация ставки';
    31: result := 'Удаление доплаты';
    22: result := 'Изменение количества ставок';
    23: result := 'Изменение атрибутов ставки';
    32: result := 'Изменение доплаты';
     3: result := 'Переименование структурного подразделения';
     4: result := 'Переподчинение структурного подразделения';
   100: result := 'Прочие действия';
  end;
}

function CountSumRaiseEm(markerHandle: TPtr; sst : comp; dd : date): double;
var
  countMark: longInt;
  i   : longInt;
  Item: Comp ;

{
  CountSumRaiseEm := 0;

  countMark := GetMarkerCount(markerHandle);

  for (i := 0; i < countMark; i := i + 1)
  {
    GetMarker(markerHandle, i, Item);
    if (GetFirst RaiseStSEm2  where ((sst   == RaiseStSEm2.StaffStr  
                                  and Item  == RaiseStSEm2.RaiseType and
                                    (
                                      ( dd >= RaiseStSEm2.Dat1 ) and
                                      ( ( dd <= RaiseStSEm2.Dat2 ) or ( Day(RaiseStSEm2.Dat2) = 0 ) )
                                    )
                                 )) = tsOK)
    {
      CountSumRaiseEm += ObjRunRaiseSts(iRaise).GetSumRaiseStS(RaiseStSEm2.NRec, dd, coStaffStruct, sst);
    }
  }
}

//*****************************************************************************
Function GetSumOklad(cc, sst : comp; dd : date; var dClearOklad : double) : double;
{
  var res : double; res := 0;

  var ccc : comp; ccc := if (cc <> comp(0), cc, IFHS.GetHistoryStrNRec(sst,dd));
  var sumRaise1 : double; sumRaise1:= CountSumRaiseEm(InitMarker('Order_CatalogsMarker1', 8, 200, 10), sst, dd); //HistoryStrEm2.dHist);
  var sumRaise2 : double; sumRaise2:= CountSumRaiseEm(InitMarker('Order_CatalogsMarker2', 8, 200, 10), sst, dd); //HistoryStrEm2.dHist);
  var sumRaise3 : double; sumRaise3:= CountSumRaiseEm(InitMarker('Order_CatalogsMarker3', 8, 200, 10), sst, dd); //HistoryStrEm2.dHist);
  var OutTaxRate : double; OutTaxRate := 0;   

  if (GetLast HistoryStrEm2 where ((ccc == HistoryStrEM2.NRec )) = tsOk) 
    {
      if (HistoryStrEM2.wPayModel = 30) // оклад
        OutTaxRate := HistoryStrEM2.HTaxRate;
      else
        OutTaxRate := ObjCatFunc1(iCatFunc).ReceiveSMH_Tuning(HistoryStrEM2.cWorkRegim) * HistoryStrEM2.HTaxRate; //часовая тарифная ставка
    }
  else
    {
      if (GetFirst StaffStructNew where (( sst == StaffStructNew.NRec)) = tsOk)
        if (StaffStructNew.PayModel = 30) // оклад
          OutTaxRate := StaffStructEm.TaxRate;
        else
          OutTaxRate := ObjCatFunc1(iCatFunc).ReceiveSMH_Tuning(StaffStructEm.WorkRegime) * StaffStructEm.TaxRate;; //часовая тарифная ставка          
    }

  dClearOklad := OutTaxRate;

  result := (OutTaxRate + sumRaise1 + sumRaise2 + sumRaise3);
}
//*****************************************************************************
Function GetMainPodr(cPodr : comp) : comp;
{
  result := comp(0);
  
  if (GetFirst PodrEm where (( cPodr == PodrEm.NRec)) = tsOk)
    if (length(PodrEm.Code) = 3)
      result := PodrEm.NRec;
    else 
      result := GetMainPodr(PodrEm.cParent);
}
//*****************************************************************************
Procedure CalcSumPodr(cPodr : comp; var dSumOklad : double; var dKolStaff : double);
{
  External _LOOP CatalogsSum where ((cPodr == CatalogsSum.cParent))
    CalcSumPodr(CatalogsSum.NRec, dSumOklad, dKolStaff);
    
  _LOOP StaffStructEm2 where ((cPodr          == StaffStructEm2.Department
                           AND 0             <<  StaffStructEm2.SeqNmb    
                           AND Sub_Day(dBeginPeriod, 1)  >>= StaffStructEm2.dInput (Noindex)
                           AND (Sub_Day(dBeginPeriod, 1) <= StaffStructEm2.dClose
                             OR ZeroDate     = StaffStructEm2.dClose )))// ordered by StaffStructEm2.SeqNmb (NoIndex)
    {
      var OutTaxRate : double; OutTaxRate := 0;   
      var sumRaise1 : double; sumRaise1:= CountSumRaiseEm(hMarker1, StaffStructEM2.NRec, dBeginPeriod);
      var sumRaise2 : double; sumRaise2:= CountSumRaiseEm(hMarker2, StaffStructEM2.NRec, dBeginPeriod);
      var sumRaise3 : double; sumRaise3:= CountSumRaiseEm(hMarker3, StaffStructEM2.NRec, dBeginPeriod);

      if (GetLast HistoryStrEm2 where (( IFHS.GetHistoryStrNRec(StaffStructEm2.NRec, Sub_Day(dBeginPeriod, 1)) == HistoryStrEM2.NRec )) = tsOk)
        {
          dKolStaff := dKolStaff + HistoryStrEM2.HWorkStations;

          if (HistoryStrEM2.wPayModel = 30) // оклад
            OutTaxRate := HistoryStrEM2.HTaxRate;
          else
            OutTaxRate := ObjCatFunc1(iCatFunc).ReceiveSMH_Tuning(HistoryStrEM2.cWorkRegim) * HistoryStrEM2.HTaxRate; //часовая тарифная ставка

          dSumOklad := dSumOklad + 
             (HistoryStrEm2.HWorkStations * (OutTaxRate + sumRaise1 + sumRaise2 + sumRaise3));
        }
    }
}
//*****************************************************************************
Procedure CreateNewRecord(cPodr : comp; pStaff : comp);
{ #__UNUSED__(cPodr, pStaff)
  if (GetFirst HistoryStrEm where ((StrContEm.cHist == HistoryStrEm.NRec)) <> tsOk)
    Exit;


  var ccMainPodr : comp; ccMainPodr := cPodr;

  if (GetFirst tmpPodr where ((ccMainPodr == tmpPodr.NRec)) <> tsOk)
    {
      ccMainPodr := GetMainPodr(ccMainPodr);
      if (ccMainPodr = comp(0))
        ccMainPodr := cPodr;

      ClearBuffer(#tmpPodr);
      tmpPodr.NRec := ccMainPodr;
      if (GetFirst PodrEm where ((ccMainPodr == PodrEm.NRec)) = tsOk)
        {
          tmpPodr.Code      := PodrEm.Code;
          tmpPodr.Name      := PodrEm.Name;

          var dKolStaff : double; dKolStaff := 0;
          var dSumOklad : double; dSumOklad := 0;

          CalcSumPodr(PodrEm.NRec, dSumOklad, dKolStaff);

          tmpPodr.dKolStaff := dKolStaff;
          tmpPodr.dSumOklad := dSumOklad;
        }  
      if (insert current tmpPodr = tsOk)
        {}
    }

  if (GetFirst PodrEm where ((cPodr == PodrEm.NRec)) <> tsOk)
    {}

  case StrPartEM.wCodOper of
     1,  //Создание структурного подразделения
    20:  //Создание ставки
       {
         if (GetFirst tmpT3_2 where ((ccMainPodr          == tmpT3_2.cMainPodr 
                                  AND cPodr               == tmpT3_2.cPodrVvod 
                                  AND 1                   == tmpT3_2.wPrint
                                  AND comp(0)             == tmpT3_2.cDolVvod
                                  AND HistoryStrEm.dHist  == tmpT3_2.dDate)) <> tsOk)
           {
             ClearBuffer(#tmpT3_2);
             tmpT3_2.cPodrVvod     := cPodr;
             tmpT3_2.cMainPodr     := ccMainPodr; 
             tmpT3_2.PodrNameVvod  := PodrEm.Name;
             tmpT3_2.PodrCodeVvod  := PodrEm.Code;
             tmpT3_2.dDate         := HistoryStrEm.dHist;
             tmpT3_2.wPrint        := 1;
             tmpT3_2.NPP           := StrPartEM.nRazd;
             if (insert current tmpT3_2 = tsOk)
               {}
           } 

         tmpT3_2.cDolVvod   := StaffStructEm.Post;

         if (GetFirst CatalogsEMI where ((tmpT3_2.cDolVvod == CatalogsEMI.NRec)) = tsOk)
           tmpT3_2.sDolVvod := CatalogsEMI.Name;

         tmpT3_2.dKolVvod   := HistoryStrEm.HWorkStations + HistoryStrEm.HWorkers;           
         tmpT3_2.dOkladVvod := GetSumOklad(HistoryStrEm.NRec, if (StrContEM.cRef = comp(0), StaffStructEm.NRec, StrContEM.cRef), dEndPeriod, tmpT3_2.dOkladCVvod ); //HistoryStrEm.HTaxRate;                                 
       }
     2,  //Ликвидация структурного подразделения
    21:  //Ликвидация ставки
      {
         if (GetFirst tmpT3_2 where ((ccMainPodr          == tmpT3_2.cMainPodr 
                                  AND cPodr               == tmpT3_2.cPodrIskl 
                                  AND 1                   == tmpT3_2.wPrint 
                                  AND comp(0)             == tmpT3_2.cDolIskl
                                  AND HistoryStrEm.dHist  == tmpT3_2.dDate)) <> tsOk)
           {
             ClearBuffer(#tmpT3_2);
             tmpT3_2.cPodrIskl     := cPodr;
             tmpT3_2.cMainPodr     := ccMainPodr; 
             tmpT3_2.PodrNameIskl  := PodrEm.Name;
             tmpT3_2.PodrCodeIskl  := PodrEm.Code;
             tmpT3_2.dDate         := HistoryStrEm.dHist;
             tmpT3_2.wPrint        := 1;
             tmpT3_2.NPP           := StrPartEM.nRazd;
             if (insert current tmpT3_2 = tsOk)
               {}
           } 

         tmpT3_2.cDolIskl   := StaffStructEm.Post;

         if (GetFirst CatalogsEMI where ((tmpT3_2.cDolIskl == CatalogsEMI.NRec)) = tsOk)
           tmpT3_2.sDolIskl := CatalogsEMI.Name;

         tmpT3_2.dKolIskl   := HistoryStrEm.HWorkStations + HistoryStrEm.HWorkers;           
         tmpT3_2.dOkladIskl := GetSumOklad(HistoryStrEm.NRec, if (StrContEM.cRef = comp(0), StaffStructEm.NRec, StrContEM.cRef), dEndPeriod, tmpT3_2.dOkladCIskl); //HistoryStrEm.HTaxRate;                                 
      }
    22,  //Изменение количества ставок
    23,  //Изменение атрибутов ставки
    30,  //Добавление доплаты
    31,  //Удаление доплаты
    32:  //Изменение доплаты
       {
         ClearBuffer(#tmpT3_2);
         tmpT3_2.cPodrIskl     := cPodr;
         tmpT3_2.cPodrVvod     := cPodr;
         tmpT3_2.cMainPodr     := ccMainPodr; 
         tmpT3_2.PodrNameVvod  := PodrEm.Name;
         tmpT3_2.PodrCodeVvod  := PodrEm.Code;
         tmpT3_2.PodrNameIskl  := PodrEm.Name;
         tmpT3_2.PodrCodeIskl  := PodrEm.Code;
         tmpT3_2.dDate         := HistoryStrEm.dHist;
         tmpT3_2.wPrint        := 1;
         tmpT3_2.NPP           := StrPartEM.nRazd;
         if (insert current tmpT3_2 = tsOk)
           {}

         tmpT3_2.cDolIskl := StaffStructEm.Post;

         if (GetFirst CatalogsEMI where ((tmpT3_2.cDolIskl == CatalogsEMI.NRec)) = tsOk)
           tmpT3_2.sDolIskl := CatalogsEMI.Name;

         if (GetLast HistoryStrFirstEm where ((StaffStructEm.NRec == HistoryStrFirstEm.StaffStr
                                           AND HistoryStrEm.dHist >> HistoryStrFirstEm.dHist)) = tsOk) 
           {
             tmpT3_2.dKolIskl   := HistoryStrFirstEm.HWorkStations + HistoryStrFirstEm.HWorkers;
             tmpT3_2.dOkladIskl := GetSumOklad(HistoryStrFirstEm.NRec, if (StrContEM.cRef = comp(0), StaffStructEm.NRec, StrContEM.cRef), HistoryStrFirstEm.dHist, tmpT3_2.dOkladCIskl); //HistoryStrFirstEm.HTaxRate;
           }
         else
           {
             tmpT3_2.dKolIskl    := StaffStructEm.WorkStations;
             tmpT3_2.dOkladIskl  := StaffStructEm.TaxRate;
             tmpT3_2.dOkladCIskl := StaffStructEm.TaxRate;
           }

         tmpT3_2.cDolVvod   := StaffStructEm.Post;

         if (GetFirst CatalogsEMI where ((tmpT3_2.cDolVvod == CatalogsEMI.NRec)) = tsOk)
           tmpT3_2.sDolVvod := CatalogsEMI.Name;

         if (IsValid(#HistoryStrEm))
           { 
             tmpT3_2.dKolVvod   := HistoryStrEm.HWorkStations + HistoryStrEm.HWorkers;           
             tmpT3_2.dOkladVvod := GetSumOklad(HistoryStrEm.NRec, if (StrContEM.cRef = comp(0), StaffStructEm.NRec, StrContEM.cRef), dEndPeriod, tmpT3_2.dOkladCVvod); //HistoryStrEm.HTaxRate;                                  
           }
         else
           {
             tmpT3_2.dKolIskl   := StaffStructEm.WorkStations;
             tmpT3_2.dOkladIskl := GetSumOklad(comp(0), if (StrContEM.cRef = comp(0), StaffStructEm.NRec, StrContEM.cRef), dEndPeriod, tmpT3_2.dOkladCIskl); //HistoryStrEm.HTaxRate;                                  
           }

         if (tmpT3_2.cDolIskl = tmpT3_2.cDolVvod AND tmpT3_2.dKolIskl = tmpT3_2.dKolVvod AND tmpT3_2.dOkladIskl = tmpT3_2.dOkladVvod)
           tmpT3_2.wPrint := 1; ///0
       }
   else
     exit; 
   end;

  if (tmpT3_2.dKolIskl   = 0 AND 
      tmpT3_2.dKolVvod   = 0 AND 
      tmpT3_2.dOkladIskl = 0 AND 
      tmpT3_2.dOkladVvod = 0)
    tmpT3_2.wPrint := 1; //0

  tmpT3_2.dTotalIskl := tmpT3_2.dKolIskl * tmpT3_2.dOkladIskl;
  tmpT3_2.dTotalVvod := tmpT3_2.dKolVvod * tmpT3_2.dOkladVvod;

  if (tmpT3_2.dDate = ZeroDate)
    tmpT3_2.dDate := StaffStructEm.dInput;

  tmpT3_2.sType += if (Trim(tmpT3_2.sType) = '', '', ',') + GetTypeName(StrPartEM.wCodOper);

  if (update current tmpT3_2 = tsOk)
    {}
}

//*****************************************************************************
Procedure CreatTmpTableEm;
{
  delete all tmpPodr;
  delete all tmpT3_2;

  var mEM : TPtr ; mEM := InitMarker('CatalogsMarkerT3EM', 8, 200, 10);

  var wFilters : word;
  if (NOT ReadMyDsk(wFilters, 'T3_2004_From_Order_wFiltersEM', true))
    set wFilters := 0;

  
  _LOOP StrTitleEM where ((1                   == StrTitleEm.wStatus
                       AND dBeginPeriod       <<= StrTitleEm.DocDate
                       AND dEndPeriod         >>= StrTitleEm.DocDate))
    if (FOEm.IfAccess(StrTitleEM.NRec))
      _LOOP StrPartEM where ((StrTitleEm.NRec == StrPartEm.cDoc))
        { 
          if (wTypeRDP <> 0)
            if (StrPartEM.wCodOper <> if(wTypeRDP = 1, 20, 21))
              continue; 

          _LOOP StrContEM where ((StrPartEm.NRec == StrContEm.cPart))
            if (GetFirst StaffStructEm where ((if (StrContEM.cRef = comp(0), StrContEm.cStr, StrContEM.cRef) == StaffStructEm.NRec)) = tsOk)
              {
                if ((wFilters and 1) = 1)
                  if (NOT FoundMarker(mEM, StrContEm.cCatStr))
                    continue;

                CreateNewRecord(StrContEm.cCatStr, StaffStructEm.NRec);
              }
        }

  DoneMarker(mEM, 'CatalogsMarkerT3EM') ;
}

//*****************************************************************************
HandleEvent

cmInit: 
  {
    hMarker1 := InitMarker('CatalogsMarker1', 8, 200, 10);
    hMarker2 := InitMarker('CatalogsMarker2', 8, 200, 10);
    hMarker3 := InitMarker('CatalogsMarker3', 8, 200, 10);

    if (NOT ReadMyDsk(dBeginPeriod, 'T3_2004_From_Order_dBeginPeriod', True))
      set dBeginPeriod := ZeroDate;

    if (NOT ReadMyDsk(dEndPeriod, 'T3_2004_From_Order_dEndPeriod', True))
      set dEndPeriod := ZeroDate;

    if (NOT ReadMyDsk(wTypeRDP, 'T3_2004_From_Order_wTypeRDP', True))
      set wTypeRDP := 0;
      
    CreatTmpTableEm;
    //PrintReport;
    //delete all tmpT3_2 where ((1 == tmpT3_2.wPrint));
      
    RunFReport(ChangeStaffSturctStream, '', false);
    //PrintReportFP;
  }

cmDone:
  {
    DoneMarker(hMarker1, 'CatalogsMarker1');
    DoneMarker(hMarker2, 'CatalogsMarker2');
    DoneMarker(hMarker3, 'CatalogsMarker3');
  }

end;
end.
