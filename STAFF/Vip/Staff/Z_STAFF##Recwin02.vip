/*************************************************************************************************\
* Наименование: Окно "Сведения об образовании"                                                    *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Сотрудники / Картотека сотрудников                                                  *
* Примечание:                                                                                     *
*  На вкладки "Все виды", "Повышение квалификации" и "Профессиональная переподготовка" добавлено  *
*  поле "Кол-во часов".                                                                           *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1919         |04/03/18|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

/*
Изначально планировалось добавить эти поля с помощью alter interface, но при попытке сделать
alter на интерфейс Recwin02 начинаются необъяснимые глюки: пропадают вкладки в окне "Сведения об
образовании", при перемещении по списку образований не обновляется информация о виде образования
в анкетном редакторе. Поэтому пришлось реализовать добавлении полей с помощь скрипта конфигуратора.
*/
#include ExtAttr.vih
#include ExtAttr.var

#include GP_File_hRef.Vih
#component "Z_Staff"
#doc
Наименование: Окно "Сведения об образовании"                                                    *
Контур/Модуль: Управление персоналом                                                            *
Пункт меню: Сотрудники / Картотека сотрудников                                                  *
Перехвачены события для отвязки от объекта vPersCh
в противном случае возникают проблемы при наличии открытой картотеки
сотрудников и попыткой ввести образование в РПД 1
#end
alter interface Recwin02;
OverLoad
procedure LoadInterface;
procedure CurrentFields;
end;


var
  kl_Init:boolean=false;


ExtendFormats scrLearningNow2;
screen scrLearningNow2 'Образование';
table LevelEducation;
Fields
  [datvvod] dGetAttr(25006,EDUCATION.Nrec,'Дата ввода') ('Дата ввода записи') :noprotect;

<<











                              Сведения действуют с.@@@@@@@@@@
>>
end;   //screen


procedure LoadInterface;
{ Inherited::LoadInterface;
  if kl_init
  { UnBindEvent(onPositionChangeByDept, vPersCh.onPositionChangeByDept);
  }
}

procedure CurrentFields;
{ Inherited::CurrentFields;
  SetFieldOption(#EduSpecialityCat.Name, ofSelectable);
}

TableEvent
  table tmpPersons;
cmIdle:
{
  pr_WriteEventToLog('Просмотр 2-го окна картотеки для табельного номера "'
      + GetStrTabN(tmpPersons.TabNmb, tmpPersons.StrTabN) + '"'
      + if(boGetTune('UP.COMMONUP.WriteFIOToSupportLog'), ' (' + tmpPersons.FIO + ')', ''));
  Idle;
  if kl_init {}
  else
  { UnBindEvent(onPositionChangeByDept, vPersCh.onPositionChangeByDept);
    vPersCh.PositionChangeByDept(tmpPersons.Nrec, tmpPersons.Department, wTypeView);
    BindEvent(onPositionChangeByDept, vPersCh.onPositionChangeByDept);
  }
}

end;//TableEvent     table tmpPersons;

TableEvent
  table LevelEducation;
cmExprFieldChanged:
{
  case inherited :: handleEvent (cmExprFieldChanged) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
  var d1:date;
  case CurField of
    #datvvod:
    {
      d1:=StrToDate(ExprFieldValue,'DD/MM/YYYY');
      dsetAttr(25006,EDUCATION.Nrec,'Дата ввода', d1);
    }
  end;
}

end;//TableEvent     table tmpPersons;

#include GP_File_hRef.Vpp
HandleEvent
cmInit:
{ kl_Init:=true;


  case inherited :: handleEvent (cmInit) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;

// LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' , -1  , -1, 0);
}
cmOnVipLoad:
{
    if (wGetTune('UP.FAKELGAL.FAKEL') = 0) then
  {
    cfsSetExtProp('T_SCRLEARNINGNOW2_Сведения_действуют_с', 'Visible', false);
    cfsSetExtProp('i_SCRLEARNINGNOW2_DATVVOD', 'Visible', false);
  }


  case inherited :: handleEvent (cmOnVipLoad) of
  heAbort:{abort;exit;}
  heStop:{stop;exit;}
  end;
}
cmStaffSeeDopInfo:
{
  putcommand(cmValue68);
}
cmValue68:
{ pGP_File_hRef.InitParam(
   if(false,cgiNotEdit,0)   //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
                // Если документ только на чтение следует вызвать cgiNotEdit
  ,coPersons //_wTable    : word; указать код таблицы документа системы
  ,tmpPersons.Nrec //_cRec      : comp=0;   // указать поле в таблице
  ,1 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
  ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
    ,'Файлы по сотруднику ' + Persons.fio
   );
}

end;
end.


object 'Z_STAFF::RECWIN02' : InterfaceWindow {
  EmbName = 'Z_STAFF::RECEPTIONMAIN->';
  // Анкетный редактор для вкладки "Все виды"
  object SCRLEARNINGNOW1 : Screen {
    object 'i_SCRLEARNINGNOW1_EDUCATION.NMB2' : PanelInputLine {
      Original = False;
      HelpLine = 'Количество часов';
      FieldName = 'Field: EDUCATION.NMB2';
      Origin_X = 174;
      Origin_Y = 242;
      Size_X = 113;
      Size_Y = 16;
      Points = 0;
      MaxLen = 6;
    }
    object 'T_SCRLEARNINGNOW1_Кол-во_часов' : Label {
      Original = False;
      Title = 'Кол-во часов';
      Origin_X = 17;
      Origin_Y = 241;
      Size_X = 99;
      Size_Y = 16;
    }
  }
  // Анкетный редактор для вкладки "Повышение квалификации"
  object SCRLEARNINGNOW3 : Screen {
    object 'i_SCRLEARNINGNOW3_EDUCATION.NMB2' : PanelInputLine {
      Original = False;
      HelpLine = 'Количество часов';
      FieldName = 'Field: EDUCATION.NMB2';
      Origin_X = 174;
      Origin_Y = 334;
      Size_X = 113;
      Size_Y = 16;
      Points = 0;
      MaxLen = 6;
    }
    object 'T_SCRLEARNINGNOW3_Кол-во_часов' : Label {
      Original = False;
      Title = 'Кол-во часов';
      Origin_X = 17;
      Origin_Y = 333;
      Size_X = 99;
      Size_Y = 16;
    }
    // Так как мы добавляем поле "Кол-во часов" с самом низу экрана, чтобы под ним
    // была пустая строка, добавим под ним еще одно вычисляемое поле с атрибутом Skip
    // В само вычисляемое выражение будем выводить просто пробел (' ')
    object 'i_SCRLEARNINGNOW3_Space' : PanelInputLine {
      Original = False;
      Skip = True;
      FieldName = ''' ''';
      Origin_X = 174;
      Origin_Y = 354;
      Size_X = 113;
      Size_Y = 16;
    }
  }
  // Анкетный редактор для вкладки "Профессиональная переподготовка"
  object SCRLEARNINGNOW4 : Screen {
    object 'i_SCRLEARNINGNOW4_EDUCATION.NMB2' : PanelInputLine {
      Original = False;
      HelpLine = 'Количество часов';
      FieldName = 'Field: EDUCATION.NMB2';
      Origin_X = 174;
      Origin_Y = 312;
      Size_X = 113;
      Size_Y = 16;
      Points = 0;
      MaxLen = 6;
    }
    object 'T_SCRLEARNINGNOW4_Кол-во_часов' : Label {
      Original = False;
      Title = 'Кол-во часов';
      Origin_X = 18;
      Origin_Y = 312;
      Size_X = 99;
      Size_Y = 16;
    }
    // Так как мы добавляем поле "Кол-во часов" с самом низу экрана, чтобы под ним
    // была пустая строка, добавим под ним еще одно вычисляемое поле с атрибутом Skip
    // В само вычисляемое выражение будем выводить просто пробел (' ')
    object 'i_SCRLEARNINGNOW4_Space' : PanelInputLine {
      Original = False;
      Skip = True;
      FieldName = ''' ''';
      Origin_X = 174;
      Origin_Y = 332;
      Size_X = 113;
      Size_Y = 16;
    }
  }
  // Табличный редактор
  object BRWEDUCATION : Browser {
    object 'c_BRWEDUCATION_EDUCATION.EDUCATION.NMB2_К-во_час.' : Column {
      Original = False;
      Title = 'К-во час.';
      HelpLine = 'Количество часов';
      FieldName = 'Field: EDUCATION.NMB2';
      Index = 5;
      DefaultWidth = 10;
      Points = 0;
      MaxLen = 6;
    }
  }
}
