cmValue5:
{
  FieldMon := 1;

  case CurField of
    #Tmp_WinPlanOtpusk.Mon[1]: set FieldMon := 1;
    #Tmp_WinPlanOtpusk.Mon[2]: set FieldMon := 2;
    #Tmp_WinPlanOtpusk.Mon[3]: set FieldMon := 3;
    #Tmp_WinPlanOtpusk.Mon[4]: set FieldMon := 4;
    #Tmp_WinPlanOtpusk.Mon[5]: set FieldMon := 5;
    #Tmp_WinPlanOtpusk.Mon[6]: set FieldMon := 6;
    #Tmp_WinPlanOtpusk.Mon[7]: set FieldMon := 7;
    #Tmp_WinPlanOtpusk.Mon[8]: set FieldMon := 8;
    #Tmp_WinPlanOtpusk.Mon[9]: set FieldMon := 9;
    #Tmp_WinPlanOtpusk.Mon[10]: set FieldMon := 10;
    #Tmp_WinPlanOtpusk.Mon[11]: set FieldMon := 11;
    #Tmp_WinPlanOtpusk.Mon[12]: set FieldMon := 12;
  end; // case



  RunWindowModal(wnMon);
}
cmValue8:
{

  If getfirst PlanOtpuskSave where((wYearPlanVac == PlanOtpuskSave.Year_Vac
                               and wTuneVacType == PlanOtpuskSave.VacType
                               and (PlanOtpuskSave.WSTATUS = 65535
                               ))) = tsOk
    Message('Первоначальный график уже сформирован. Операция невозможна.')
  else
  if GetMarkerCount(Marker) > 0
  {

    StartNewVisual(vtIndicatorVisual, 0, 'Загрузка плановых отпусков...', RecordsInTable(#Tmp_WinPlanOtpusk));
    
    _loop Tmp_WinPlanOtpusk
    {
    
      if not NextVisual
        break;
    
      if (Tmp_WinPlanOtpusk.Prizn = 3)
        continue;

      if not Foundmarker(Marker, Tmp_WinPlanOtpusk.Nrec)
        continue;

      _loop PlanOtpuskSave where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskSave.Person
                               and wYearPlanVac == PlanOtpuskSave.Year_Vac
                               and wTuneVacType == PlanOtpuskSave.VacType
//                               and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskSave.Appoint(NoIndex)
                               and (PlanOtpuskSave.WSTATUS = 0
                               )))
      {

              if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskSave.Appoint == AppointmentsPlan.Nrec)) = tsOk)
                and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
                continue;

              ClearBuffer(#PlanOtpusk);
              PlanOtpusk.Buffer  := PlanOtpuskSave.Buffer;
              PlanOtpusk.Nrec    := 0;
              PlanOtpusk.WSTATUS := 65535;
              if ( insert current PlanOtpusk = tsOk ) 
              {
                ClearBuffer(#WorkPCon);
                WorkPCon.wTable      := coPlanOtpusk;
                WorkPCon.cTable      := PlanOtpusk.Nrec;
                WorkPCon.cWorkPeriod := Tmp_WinPlanOtpusk.WorkP;
                if (insert current WorkPCon = tsOK) {}
              }
      }

    }

    StopVisual('', 0);

    DisableCommand(cmValue8);
  }
  else
  {
    Message('Нет выбранных сотрудников')
  }
}
