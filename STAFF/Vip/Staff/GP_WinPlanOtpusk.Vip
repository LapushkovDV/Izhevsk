cmSelectAll :
{
  PushPos(#Tmp_WinPlanOtpusk);
  ClearMarker(Marker);
  StartNewVisual(vtRotateVisual, vfTimer+vfBreak+vfConfirm,
          ''#3'Помечаю ...'#13#3, 1);
  if (GetFirst Tmp_WinPlanOtpusk = tsOK)
  do
  if (not NextVisual)
     Break;
  else
  {
    if (SearchMarker(Marker,Tmp_WinPlanOtpusk.NRec,IndexMarker))
      InsertMarker(Marker,Tmp_WinPlanOtpusk.NRec);
    else
    {
      InsertMarker(Marker,Tmp_WinPlanOtpusk.NRec);
    }
  }
  while (GetNext Tmp_WinPlanOtpusk = tsOK);
  PopPos(#Tmp_WinPlanOtpusk);
  ReReadRecord;
  RescanPanel(#Tmp_WinPlanOtpusk);
  RescanPanel(#Zar_User);
  StopVisual('',0);
}
cmUnSelectAll :
{
  ClearMarker(Marker);
  ReReadRecord;
  RescanPanel(#Tmp_WinPlanOtpusk);
  RescanPanel(#Zar_User);
}
cmDone:
{

  if not FlagIntOpt
  if Message(''#3'Сохранить изменения в отпусках?', YesNo) = cmYes
  {

    PushPos(#Tmp_WinPlanOtpusk);
    ClearMarker(Marker);
    StartNewVisual(vtRotateVisual, vfTimer+vfBreak+vfConfirm,
            ''#3'Помечаю ...'#13#3, 1);
    if (GetFirst Tmp_WinPlanOtpusk = tsOK)
    do
    if (not NextVisual)
       Break;
    else
    {
      if (SearchMarker(Marker,Tmp_WinPlanOtpusk.NRec,IndexMarker))
        InsertMarker(Marker,Tmp_WinPlanOtpusk.NRec);
      else
      {
        InsertMarker(Marker,Tmp_WinPlanOtpusk.NRec);
      }
    }
    while (GetNext Tmp_WinPlanOtpusk = tsOK);
    PopPos(#Tmp_WinPlanOtpusk);
    ReReadRecord;
    RescanPanel(#Tmp_WinPlanOtpusk);
    RescanPanel(#Zar_User);
    StopVisual('',0);

    SaveUtv(word(-4000));

    ClearMarker(Marker);
  }

  SaveMyDsk(wYearPlanVac, 'WinPlanOtpusk_wYearPlanVac');
  SaveMyDsk(FiltrPodr, 'k_FiltrPodr');
  DoneMarker(_PodrMArkerPointer,'');
  DoneMarker(mrkOuterClassfier,'');
  DoneMarker(Marker,'WinPlanOtpusk');
}

cmUpdateRecord :
{

  Day14_28;
  SetWin;

}

cmDeleteRecord:
{

  if getfirst fastfirstrow Tmp_PlanOtpuskNO where((Tmp_WinPlanOtpuskM.Nrec == Tmp_PlanOtpuskNO.cWinPlOtp 
                               and(Tmp_PlanOtpuskM.Nrec <> Tmp_PlanOtpuskNO.Nrec))) = tsOk
  {
    Tmp_PlanOtpuskNO.DURATION += Tmp_PlanOtpuskM.DURATION;
    Tmp_PlanOtpuskNO.DatEnd   := GetLastDate(Tmp_PlanOtpuskNO.DatBeg,Tmp_PlanOtpuskNO.DURATION);
    update current Tmp_PlanOtpuskNO;

    delete current Tmp_PlanOtpuskM;
  }
  else
    if Message('''Запись одиночная. Удалить?', YesNo) = cmYes
    {

      PushPos(#Tmp_WinPlanOtpusk);
      if getfirst fastfirstrow Tmp_WinPlanOtpusk where((Tmp_PlanOtpuskM.cWinPlOtp == Tmp_WinPlanOtpusk.Nrec)) = tsOk
      {
        Tmp_WinPlanOtpusk.Mon[Tmp_PlanOtpuskM.Mon] := 0;
        SetWin;
      }
      PopPos(#Tmp_WinPlanOtpusk);

      delete current Tmp_PlanOtpuskM;
    }

}

