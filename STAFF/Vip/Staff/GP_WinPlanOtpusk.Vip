<<
  <.Редактировать.>  <.Сохранить.>  <.На согласование.>  <.Согласование.>                                                                          Итого летние месяцы:.@@@@@ %

  <.Отклонить.>      <.Утвердить.>             <.  Отмена  .>
>>

end;   //screen

procedure MonField(i:integer);
{
//message(Tmp_WinPlanOtpusk.Mon[i]+'/'+Tmp_WinPlanOtpusk.WRESERVE[i]+'/'+Tmp_WinPlanOtpusk.MonFact[i]+'/'+(getfirst Tmp_PlanOtpuskTMP where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskTMP.cWinPlOtp
//                                            and i  == Tmp_PlanOtpuskTMP.Mon[i])) = tsOk))

//    if (getfirst Tmp_PlanOtpuskTMP where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskTMP.cWinPlOtp
//                                            and i  == Tmp_PlanOtpuskTMP.Mon)) = tsOk)
//message(Tmp_WinPlanOtpusk.Nrec)

  if GetMarkerCount(_PodrMArkerPointer) > 0 and Not Foundmarker(_PodrMArkerPointer, Tmp_WinPlanOtpusk.Cex)
  {
    Message('Редактирование запрешено!' + chr(13)
      + chr(3) + 'Сотрудник отображен в подразделении информационно.', Warning + OkButton);
    set Tmp_WinPlanOtpusk.Mon[i] := 0;
  }
  else
    if Tmp_WinPlanOtpusk.WRESERVE != -32000 and Tmp_WinPlanOtpusk.WRESERVE != -4000 and Tmp_WinPlanOtpusk.WRESERVE != -8000
    {

      set Tmp_WinPlanOtpusk.Mon[i] := 0;
      Message('Редактирование запрешено! Неоходимо создавать приказ', Warning + OkButton);
      PushPos(#Tmp_PlanOtpuskTMP);
      _loop Tmp_PlanOtpuskTMP where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskTMP.cWinPlOtp
                                            and i  == Tmp_PlanOtpuskTMP.Mon))
        Tmp_WinPlanOtpusk.Mon[i] += Tmp_PlanOtpuskTMP.DURATION;
      PopPos(#Tmp_PlanOtpuskTMP);
    }
    else
      if Tmp_WinPlanOtpusk.AppD>date(Last_Day(Date(1,i,wYearPlanVac)),i,wYearPlanVac)
      {
        Message('Сотрудник еще не принят!', Warning + OkButton);
        set Tmp_WinPlanOtpusk.Mon[i] := 0;
      }
      else
        if Tmp_WinPlanOtpusk.Prizn=3
        {
          Message('Совмещение будет заполено из основного назначения!', Warning + OkButton);
          set Tmp_WinPlanOtpusk.Mon[i] := 0;
        }
        else
          if Tmp_WinPlanOtpusk.MonFact[i]
          {
            Message('Фактические отпуска привязанные к плану!', Warning + OkButton);
            FlagField := false;
          }
//message(Tmp_WinPlanOtpusk.Nrec)
}


function SummTMPPlan(WinNrec:comp;iMon:Integer):double;
{
  SummTMPPlan := 0;
  PushPos(#Tmp_PlanOtpusk);
  _loop Tmp_PlanOtpusk where ((WinNrec  == Tmp_PlanOtpusk.cWinPlOtp
                               and iMon == Tmp_PlanOtpusk.Mon))
    SummTMPPlan += Tmp_PlanOtpusk.DURATION;
  PopPos(#Tmp_PlanOtpusk);

}

procedure DelTMPPlan(WinNrec:comp;iMon:Integer);
{
  _loop Tmp_PlanOtpusk where ((WinNrec == Tmp_PlanOtpusk.cWinPlOtp
                           and iMon    == Tmp_PlanOtpusk.Mon))
    delete current Tmp_PlanOtpusk;
}

procedure SetWin;
{
  if UpDate current Tmp_WinPlanOtpusk=tsOk
  {

    for(j:= 1; j<= 12; j++)
    {
    
      if Tmp_WinPlanOtpusk.Mon[j] = 0
      {
        DelTMPPlan(Tmp_WinPlanOtpusk.Nrec,j);
      }
      else
      {

        if Tmp_WinPlanOtpusk.Mon[j] != SummTMPPlan(Tmp_WinPlanOtpusk.Nrec,j)
        {
          DelTMPPlan(Tmp_WinPlanOtpusk.Nrec,j);
        
          ClearBuffer(#Tmp_PlanOtpusk);
          Tmp_PlanOtpusk.Nrec      := GetNextnRec(#Tmp_PlanOtpusk,0);
          Tmp_PlanOtpusk.cPlOtp    := 0;
          Tmp_PlanOtpusk.cWinPlOtp := Tmp_WinPlanOtpusk.Nrec;
          Tmp_PlanOtpusk.DURATION  := Tmp_WinPlanOtpusk.Mon[j];
          Tmp_PlanOtpusk.Mon       := j;
          Tmp_PlanOtpusk.DatBeg    := date(1,j,wYearPlanVac);
          Tmp_PlanOtpusk.DatEnd    := GetLastDate(Tmp_PlanOtpusk.DatBeg,Tmp_PlanOtpusk.DURATION);
          Tmp_PlanOtpusk.WRESERVE  := Tmp_WinPlanOtpusk.WRESERVE;
          if (insert current Tmp_PlanOtpusk != tsOk) {}
        }
      }
    }
  }
}


HandleEvent  // for panel
cmCheckField:
{
//message(Tmp_WinPlanOtpusk.Nrec)
  FlagField := true;

  case CurField of
    #Tmp_WinPlanOtpusk.Prich:
    {
      if Tmp_WinPlanOtpusk.WorkP = 0
        Message('Отсутствует период начинающийся в' + wYearPlanVac + ' году. Причина не сохранена.')
      else
        sSetAttr(coWorkPeriod, Tmp_WinPlanOtpusk.WorkP, 'Причина отказа', Tmp_WinPlanOtpusk.Prich)
    }
    #dPlanOtOld:
    {
      IncTMP;
    }
    #Tmp_WinPlanOtpusk.Mon[1]:  //
    {
      MonField(1);
    }
    #Tmp_WinPlanOtpusk.Mon[2]:  //
    {
      MonField(2);
    }
    #Tmp_WinPlanOtpusk.Mon[3]:  //
    {
      MonField(3);
    }
    #Tmp_WinPlanOtpusk.Mon[4]:  // Тема кандидатской диссертации
    {
      MonField(4);
    }
    #Tmp_WinPlanOtpusk.Mon[5]:  //
    {
      MonField(5);
    }
    #Tmp_WinPlanOtpusk.Mon[6]:  //
    {
      MonField(6);
    }
    #Tmp_WinPlanOtpusk.Mon[7]:  //
    {
      MonField(7);
    }
    #Tmp_WinPlanOtpusk.Mon[8]:  //
    {
      MonField(8);
    }
    #Tmp_WinPlanOtpusk.Mon[9]:  //
    {
      MonField(9);
    }
    #Tmp_WinPlanOtpusk.Mon[10]:  //
    {
      MonField(10);
    }
    #Tmp_WinPlanOtpusk.Mon[11]:  //
    {
      MonField(11);
    }
    #Tmp_WinPlanOtpusk.Mon[12]:  //
    {
      MonField(12);
    }
  end; // case

  Day14_28;
//message(Tmp_WinPlanOtpusk.Nrec)

  if Tmp_WinPlanOtpusk.Prizn != 3 and FlagField
  {
    SetWin;
  }

//message(Tmp_WinPlanOtpusk.Nrec)

  ReReadRecord;
}
End; // HandleEvent for panel
end; // Panel

Procedure PerenosPeriod(Tmp_PlanNrec:Comp);
{

  _loop Tmp_PlanOtpuskTMP where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskTMP.cWinPlOtp))
  {
    if Tmp_PlanOtpuskTMP.Nrec != Tmp_PlanNrec
    if iStrFunc.isCrossPeriod(PlanOtpusk.PlanYearBeg,PlanOtpusk.PlanYearEnd, Tmp_PlanOtpuskTMP.DatBeg,Tmp_PlanOtpuskTMP.DatEnd)
    {
//message('Ko='+Tmp_PlanOtpusk.DatBeg+'='+Tmp_PlanOtpusk.DatEnd+'/'+Tmp_PlanOtpusk.Nrec)

      PlanOtpusk.PlanYearBeg := Add_Day(Tmp_PlanOtpuskTMP.DatEnd,1);
      PlanOtpusk.PlanYearEnd := GetLastDate(PlanOtpusk.PlanYearBeg, Tmp_WinPlanOtpusk.Mon[j]);
      PerenosPeriod(Tmp_PlanNrec);
    }
  }
/*
  PushPos(#PlanOtpuskD);
  _loop PlanOtpuskD where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskD.Person
                         and wYearPlanVac == PlanOtpuskD.Year_Vac
                         and wTuneVacType == PlanOtpuskD.VacType
//                         and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskD.Appoint(NoIndex)
                         and (PlanOtpuskD.WSTATUS = 0 and PlanOtpuskD.Nrec != 0
                         )))
  {

    if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
      and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
      continue;

    if iStrFunc.isCrossPeriod(PlanOtpusk.PlanYearBeg,PlanOtpusk.PlanYearEnd, PlanOtpuskD.PlanYearBeg,PlanOtpuskD.PlanYearEnd)
    {
      PlanOtpusk.PlanYearBeg := Add_Day(PlanOtpuskD.PlanYearEnd,1);
      PlanOtpusk.PlanYearEnd := GetLastDate(PlanOtpusk.PlanYearBeg, Tmp_WinPlanOtpusk.Mon[j]);
      PerenosPeriod(Tmp_PlanNrec);
    }

  }
  PopPos(#PlanOtpuskD);
*/
}

Procedure SaveUtv(RESERVE:Integer);
{

  if GetMarkerCount(Marker) > 0
  {

    StartNewVisual(vtIndicatorVisual, 0, 'Загрузка плановых отпусков...', RecordsInTable(#Tmp_WinPlanOtpusk));
    
    _loop Tmp_WinPlanOtpusk
    {
    
      if not NextVisual
        break;
    
      if (Tmp_WinPlanOtpusk.Prizn = 3)
        continue;

      if not Foundmarker(Marker, Tmp_WinPlanOtpusk.Nrec)
        continue;
    
      wCalcMode := word(0);

      RESERVE   := Tmp_WinPlanOtpusk.WRESERVE;
    
      for(j:= 1; j<= 12; j++)
      {
    
        var bDURATION : boolean = false;
        var dDURATION : double = 0;
        var bPlan : boolean = true;

        if Tmp_WinPlanOtpusk.Mon[j] = 0
        {
          _loop PlanOtpuskD where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskD.Person
                                 and wYearPlanVac == PlanOtpuskD.Year_Vac
                                 and wTuneVacType == PlanOtpuskD.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                 and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                 )))
          {
    
            if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
              and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
              continue;

            _Loop WorkPCon where (( coPlanOtpusk          == WorkPCon.wTable      and
                                  PlanOtpuskD.Nrec        == WorkPCon.cTable      and
                                  Tmp_WinPlanOtpusk.WorkP == WorkPCon.cWorkPeriod ))
              delete current WorkPCon;

            _Loop Tmp_PlanOtpuskTMP where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskTMP.cWinPlOtp
                                            and j  == Tmp_PlanOtpuskTMP.Mon))
              delete current Tmp_PlanOtpuskTMP;

            delete current PlanOtpuskD;
    
          }

          if getfirst fastfirstrow Tmp_WinPlanOtpuskSovm where((Tmp_WinPlanOtpusk.cPerson == Tmp_WinPlanOtpuskSovm.cPerson
                                                            and 3                      == Tmp_WinPlanOtpuskSovm.Prizn)) = tsOk
          {

            _loop PlanOtpuskD where((Tmp_WinPlanOtpuskSovm.cPerson == PlanOtpuskD.Person
                                   and wYearPlanVac == PlanOtpuskD.Year_Vac
                                   and wTuneVacType == PlanOtpuskD.VacType
//                                   and Tmp_WinPlanOtpuskSovm.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                   and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                   )))
            {
        
              if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
                and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpuskSovm.Prizn
                continue;

              _Loop WorkPCon where (( coPlanOtpusk              == WorkPCon.wTable      and
                                    PlanOtpuskD.Nrec            == WorkPCon.cTable      and
                                    Tmp_WinPlanOtpuskSovm.WorkP == WorkPCon.cWorkPeriod ))
                delete current WorkPCon;

              _Loop Tmp_PlanOtpuskTMP where ((Tmp_WinPlanOtpuskSovm.Nrec == Tmp_PlanOtpuskTMP.cWinPlOtp
                                            and j  == Tmp_PlanOtpuskTMP.Mon))
                delete current Tmp_PlanOtpuskTMP;

              delete current PlanOtpuskD;
        
            }

            Tmp_WinPlanOtpuskSovm.Mon[j] := 0;
            UpDate current Tmp_WinPlanOtpuskSovm;

          }

        }
    
        _loop PlanOtpuskD where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskD.Person
                                 and wYearPlanVac == PlanOtpuskD.Year_Vac
                                 and wTuneVacType == PlanOtpuskD.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                 and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                 )))
        {

          if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
           and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
           continue;

          bPlan := false;
          dDURATION += PlanOtpuskD.DURATION
    
        }

        _loop PlanOtpuskD where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskD.Person
                                 and wYearPlanVac == PlanOtpuskD.Year_Vac
                                 and wTuneVacType == PlanOtpuskD.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                 and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                 )))
        {
    
          if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
           and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
           continue;

          if GetFirst FastFirstRow Tmp_PlanOtpusk where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpusk.cWinPlOtp
                                                      and PlanOtpuskD.PlanYearBeg == Tmp_PlanOtpusk.DatBeg
                                                      and PlanOtpuskD.PlanYearEnd == Tmp_PlanOtpusk.DatEnd
                                                      )) <> tsok
          {
            bDURATION := true;
            break;
          }

        }

//message(j+'/'+SummTMPPlan(Tmp_WinPlanOtpusk.Nrec,j))

        if (bPlan or bDURATION) and SummTMPPlan(Tmp_WinPlanOtpusk.Nrec,j) != 0
        {
    

//message('k/'+j)

          var FlagRESERV :boolean = true; 

          _loop PlanOtpuskD where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskD.Person
                                 and wYearPlanVac == PlanOtpuskD.Year_Vac
                                 and wTuneVacType == PlanOtpuskD.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                 and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                 )))
          {
    

            if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
              and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
              continue;

            _Loop WorkPCon where (( coPlanOtpusk          == WorkPCon.wTable      and
                                  PlanOtpuskD.Nrec        == WorkPCon.cTable      and
                                  Tmp_WinPlanOtpusk.WorkP == WorkPCon.cWorkPeriod ))
              delete current WorkPCon;

//message(PlanOtpuskD.wRESERVE);

//            if PlanOtpuskD.wRESERVE = -32000 or PlanOtpuskD.wRESERVE = -8000  or PlanOtpuskD.wRESERVE = -4000 or PlanOtpuskD.wRESERVE = 0
              FlagRESERV := true;
//            else
//              FlagRESERV := false;

            delete current PlanOtpuskD;
    
          }
    
          if FlagRESERV
          _Loop Tmp_PlanOtpusk where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpusk.cWinPlOtp
                                         and j == Tmp_PlanOtpusk.Mon))
          {

            ClearBuffer(#PlanOtpusk);
            PlanOtpusk.Person      := Tmp_WinPlanOtpusk.cPerson;
            PlanOtpusk.Appoint     := Tmp_WinPlanOtpusk.Appoint;
            PlanOtpusk.VacType     := wTuneVacType;
            PlanOtpusk.Year_Vac    := wYearPlanVac;
            PlanOtpusk.Year_Work   := wYearPlanVac;
    
            if GetFirst FastFirstRow WorkPeriodTMP where((Tmp_WinPlanOtpusk.WorkP == WorkPeriodTMP.Nrec)) = tsOk
            {
              PlanOtpusk.WORKYEARBEG := WorkPeriodTMP.DPERBEG;
              PlanOtpusk.WORKYEAREND := WorkPeriodTMP.DPEREND;
            }
    
            var cTmpWP:comp = 0;
            cTmpWP := funGetFirstPeriodInTune;
        
////    if ( funCalcDateBeg(cTmpWP) = date(0, 0, 0) ) // если человек принят на работу позже даты, на которую формируем
////      exit;
      

            PlanOtpusk.PlanYearBeg := Tmp_PlanOtpusk.DatBeg;
            PlanOtpusk.PlanYearEnd := Tmp_PlanOtpusk.DatEnd;

            PerenosPeriod(Tmp_PlanOtpusk.Nrec);

//message(j+'/'+Tmp_PlanOtpusk.DURATION)
            PlanOtpusk.DURATION    := Tmp_PlanOtpusk.DURATION;

            PlanOtpusk.wRESERVE    := RESERVE;

          if ( insert current PlanOtpusk = tsOk ) 
          {

            Tmp_PlanOtpusk.cPlOtp    := PlanOtpusk.Nrec;
            if (Update current Tmp_PlanOtpusk != tsOk) {}

            ClearBuffer(#WorkPCon);
            WorkPCon.wTable      := coPlanOtpusk;
            WorkPCon.cTable      := PlanOtpusk.Nrec;
            WorkPCon.cWorkPeriod := Tmp_WinPlanOtpusk.WorkP;
            if (insert current WorkPCon = tsOK) {}

            var TMPPlanOtpusk : type$PlanOtpusk;
            TMPPlanOtpusk := PlanOtpusk.Buffer;

            if getfirst fastfirstrow Tmp_WinPlanOtpuskSovm where((Tmp_WinPlanOtpusk.cPerson == Tmp_WinPlanOtpuskSovm.cPerson
                                                              and 3                      == Tmp_WinPlanOtpuskSovm.Prizn)) = tsOk
            {

              FlagRESERV := true;

              _loop PlanOtpuskD where((Tmp_WinPlanOtpuskSovm.cPerson == PlanOtpuskD.Person
                                     and wYearPlanVac == PlanOtpuskD.Year_Vac
                                     and wTuneVacType == PlanOtpuskD.VacType
//                                     and Tmp_WinPlanOtpuskSovm.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                     and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                     )))
              {
        
                if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
                  and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpuskSovm.Prizn
                  continue;

                _Loop WorkPCon where (( coPlanOtpusk              == WorkPCon.wTable      and
                                      PlanOtpuskD.Nrec            == WorkPCon.cTable      and
                                      Tmp_WinPlanOtpuskSovm.WorkP == WorkPCon.cWorkPeriod ))
                  delete current WorkPCon;

//                if PlanOtpuskD.wRESERVE = -32000  or PlanOtpuskD.wRESERVE = -8000  or PlanOtpuskD.wRESERVE = -4000 or PlanOtpuskD.wRESERVE = 0
                  FlagRESERV := true;
//                else
//                  FlagRESERV := false;

                delete current PlanOtpuskD;
        
              }

              if FlagRESERV
//              _Loop Tmp_PlanOtpuskSovm where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskSovm.cWinPlOtp
//                                           and j == Tmp_PlanOtpuskSovm.Mon))
              {

              ClearBuffer(#PlanOtpusk);
              PlanOtpusk.Buffer := TMPPlanOtpusk;
              PlanOtpusk.Nrec   := 0;
              PlanOtpusk.Appoint:= Tmp_WinPlanOtpuskSovm.Appoint;
              if GetFirst FastFirstRow WorkPeriodTMP where((Tmp_WinPlanOtpuskSovm.WorkP == WorkPeriodTMP.Nrec)) = tsOk
              {
                PlanOtpusk.WORKYEARBEG := WorkPeriodTMP.DPERBEG;
                PlanOtpusk.WORKYEAREND := WorkPeriodTMP.DPEREND;
              }

              PlanOtpusk.wRESERVE    := RESERVE;

              if ( insert current PlanOtpusk = tsOk ) 
              {

                Tmp_PlanOtpuskSovm.cPlOtp    := PlanOtpusk.Nrec;
                if (UpDate current Tmp_PlanOtpuskSovm != tsOk) {}

                ClearBuffer(#WorkPCon);
                WorkPCon.wTable      := coPlanOtpusk;
                WorkPCon.cTable      := PlanOtpusk.Nrec;
                WorkPCon.cWorkPeriod := Tmp_WinPlanOtpuskSovm.WorkP;
                if (insert current WorkPCon = tsOK) {}

                Tmp_WinPlanOtpuskSovm.Mon[j] := PlanOtpusk.DURATION;//SummTMPPlan(Tmp_WinPlanOtpuskSovm.Nrec,j)
                Tmp_WinPlanOtpuskSovm.WRESERVE := RESERVE;

                if UpDate current Tmp_WinPlanOtpuskSovm=tsOk
                {
                  for(k:= 1; k<= 12; k++)
                  {
                  
                    if Tmp_WinPlanOtpuskSovm.Mon[k] = 0
                    {
                      DelTMPPlan(Tmp_WinPlanOtpuskSovm.Nrec,k);
                    }
                    else
                    {
                      if Tmp_WinPlanOtpuskSovm.Mon[k] != SummTMPPlan(Tmp_WinPlanOtpuskSovm.Nrec,k)
                      {
                        DelTMPPlan(Tmp_WinPlanOtpuskSovm.Nrec,k);
                      
                        ClearBuffer(#Tmp_PlanOtpusk);
                        Tmp_PlanOtpusk.Nrec      := GetNextnRec(#Tmp_PlanOtpusk,0);
                        Tmp_PlanOtpusk.cPlOtp    := 0;
                        Tmp_PlanOtpusk.cWinPlOtp := Tmp_WinPlanOtpuskSovm.Nrec;
                        Tmp_PlanOtpusk.DURATION  := Tmp_WinPlanOtpuskSovm.Mon[k];
                        Tmp_PlanOtpusk.Mon       := k;
                        Tmp_PlanOtpusk.DatBeg    := date(1,k,wYearPlanVac);
                        Tmp_PlanOtpusk.DatEnd    := GetLastDate(Tmp_PlanOtpusk.DatBeg,Tmp_PlanOtpusk.DURATION);
                        Tmp_PlanOtpusk.WRESERVE  := Tmp_WinPlanOtpuskSovm.WRESERVE;
                        if (insert current Tmp_PlanOtpusk != tsOk) {}
                      }
                    }
                  }
                }
              }//if ( insert current PlanOtpusk = tsOk ) 

              }//_Loop Tmp_PlanOtpuskSovm where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskSovm.cWinPlOtp

            }

          }//if ( insert current PlanOtpusk = tsOk ) 

          }//_Loop Tmp_PlanOtpusk where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpusk.cWinPlOtp

        }
      
      }//for(j:= 1; j<= 12; j++)
    
    }
    
    SetFieldOption(#Tmp_WinPlanOtpusk.Prich , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[1] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[2] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[3] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[4] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[5] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[6] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[7] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[8] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[9] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[10], ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[11], ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[12], ofProtected);
    SetInterfaceOptions(opEscClose or opCyanInterface);
    FlagIntOpt:=True;

    RescanPanel(#Tmp_WinPlanOtpusk);
    RescanPanel(#Zar_User);
    ReReadRecord;

    StopVisual('', 0);
    DisableCommand(cmCheckField);

  }
  else
  {
    Message('Нет выбранных сотрудников')
  }

}

Procedure SaveUtv6(RESERVE:Integer);
{

  if GetMarkerCount(Marker) > 0
  {

  StartNewVisual(vtIndicatorVisual, 0, 'Проверка плановых отпусков...', RecordsInTable(#Tmp_WinPlanOtpusk));

  intInit;
  var Flag : boolean = false;

//message('SaveUtv6/'+Tmp_WinPlanOtpusk.Nrec)

  PushPos(#Tmp_WinPlanOtpusk);

  _loop Tmp_WinPlanOtpusk
  {

    if not NextVisual
      break;

    if not Foundmarker(Marker, Tmp_WinPlanOtpusk.Nrec)
      continue;

    if (RESERVE = -16000 or RESERVE = -32000 or RESERVE = -8000) and Tmp_WinPlanOtpusk.wRESERVE = 0
    {
      displ('[-] запрет изменения статуса "Утв." по '+ Tmp_WinPlanOtpusk.FIO + ' ('+Tmp_WinPlanOtpusk.Tabn+')');
      Flag := true;
      continue;
    }

    if ((Tmp_WinPlanOtpusk.Day14) or (Tmp_WinPlanOtpusk.Day28) or (Tmp_WinPlanOtpusk.Day28Plus)) and Tmp_WinPlanOtpusk.OtpUxod = '' and Tmp_WinPlanOtpusk.Prizn!=3
    {

      displ('-->'+ Tmp_WinPlanOtpusk.FIO + ' ('+Tmp_WinPlanOtpusk.Tabn+')');

      if Tmp_WinPlanOtpusk.Day28Plus
        displ('[-] необходимо заполнить не менее 28 дней текущего года и ' + Tmp_WinPlanOtpusk.wDayOld + ' остаток прошлого года');

      if Tmp_WinPlanOtpusk.Day28
        displ('[-] необходимо заполнить не менее 28 дней в год');

      if Tmp_WinPlanOtpusk.Day14
        displ('[-] необходимо заполнить не менее 14 дней одним отрезком');

      Flag := true;
    }

  }

  PopPos(#Tmp_WinPlanOtpusk);

//message('==============SaveUtv6/'+Tmp_WinPlanOtpusk.Nrec)

  ExitProc;

  StopVisual('', 0);

  if Flag
  {
    Message('Необходимо поправить план отпусков(ФИО выделено красным) или выбраны "Утв."', Warning + OkButton);
    abort;
    exit;
  }
  else
  {

    StartNewVisual(vtIndicatorVisual, 0, 'Загрузка плановых отпусков...', RecordsInTable(#Tmp_WinPlanOtpusk));

    PushPos(#Tmp_WinPlanOtpusk);
    
    _loop Tmp_WinPlanOtpusk
    {
    
      if not NextVisual
        break;
    
    if (Tmp_WinPlanOtpusk.Prizn = 3)
        continue;
    
      if not Foundmarker(Marker, Tmp_WinPlanOtpusk.Nrec)
        continue;

      if RESERVE = -16000 and Tmp_WinPlanOtpusk.wRESERVE = 0
        continue;

      wCalcMode := word(0);
    
      for(j:= 1; j<= 12; j++)
      {
    
        var bDURATION : boolean = false;
        var dDURATION : double = 0;
        var bPlan : boolean = true;

        if Tmp_WinPlanOtpusk.Mon[j] = 0
        {
          _loop PlanOtpuskD where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskD.Person
                                 and wYearPlanVac == PlanOtpuskD.Year_Vac
                                 and wTuneVacType == PlanOtpuskD.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                 and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                 )))
          {
    
            if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
              and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
              continue;

            _Loop WorkPCon where (( coPlanOtpusk          == WorkPCon.wTable      and
                                  PlanOtpuskD.Nrec        == WorkPCon.cTable      and
                                  Tmp_WinPlanOtpusk.WorkP == WorkPCon.cWorkPeriod ))
              delete current WorkPCon;

            _Loop Tmp_PlanOtpuskTMP where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskTMP.cWinPlOtp
                                            and j  == Tmp_PlanOtpuskTMP.Mon))
              delete current Tmp_PlanOtpuskTMP;

            delete current PlanOtpuskD;
    
          }

          if getfirst fastfirstrow Tmp_WinPlanOtpuskSovm where((Tmp_WinPlanOtpusk.cPerson == Tmp_WinPlanOtpuskSovm.cPerson
                                                            and 3                      == Tmp_WinPlanOtpuskSovm.Prizn)) = tsOk
          {

            _loop PlanOtpuskD where((Tmp_WinPlanOtpuskSovm.cPerson == PlanOtpuskD.Person
                                   and wYearPlanVac == PlanOtpuskD.Year_Vac
                                   and wTuneVacType == PlanOtpuskD.VacType
//                                   and Tmp_WinPlanOtpuskSovm.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                   and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                   )))
            {
        
              if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
                and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpuskSovm.Prizn
                continue;

              _Loop WorkPCon where (( coPlanOtpusk              == WorkPCon.wTable      and
                                    PlanOtpuskD.Nrec            == WorkPCon.cTable      and
                                    Tmp_WinPlanOtpuskSovm.WorkP == WorkPCon.cWorkPeriod ))
                delete current WorkPCon;

              _Loop Tmp_PlanOtpuskTMP where ((Tmp_WinPlanOtpuskSovm.Nrec == Tmp_PlanOtpuskTMP.cWinPlOtp
                                              and j  == Tmp_PlanOtpuskTMP.Mon))
                delete current Tmp_PlanOtpuskTMP;

              delete current PlanOtpuskD;
        
            }

            Tmp_WinPlanOtpuskSovm.Mon[j] := 0;
            UpDate current Tmp_WinPlanOtpuskSovm;

          }

        }
    
        _loop PlanOtpuskD where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskD.Person
                                 and wYearPlanVac == PlanOtpuskD.Year_Vac
                                 and wTuneVacType == PlanOtpuskD.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                 and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                 )))
        {

          if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
            and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
            continue;

          bPlan := false;
          dDURATION += PlanOtpuskD.DURATION
    
        }

        _loop PlanOtpuskD where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskD.Person
                                 and wYearPlanVac == PlanOtpuskD.Year_Vac
                                 and wTuneVacType == PlanOtpuskD.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                 and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                 )))
        {
    
          if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
            and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
            continue;

          if GetFirst FastFirstRow Tmp_PlanOtpusk where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpusk.cWinPlOtp
                                                      and PlanOtpuskD.PlanYearBeg == Tmp_PlanOtpusk.DatBeg
                                                      and PlanOtpuskD.PlanYearEnd == Tmp_PlanOtpusk.DatEnd
                                                      )) <> tsok
          {
             bDURATION := true;
             break;
          }
          else
          {
            PlanOtpuskD.wRESERVE := RESERVE;
            update current PlanOtpuskD;
            Tmp_PlanOtpusk.wRESERVE := RESERVE;
            update current Tmp_PlanOtpusk;
            Tmp_WinPlanOtpusk.wRESERVE    := RESERVE;
            update current Tmp_WinPlanOtpusk;

            if getfirst fastfirstrow Tmp_WinPlanOtpuskSovm where((Tmp_WinPlanOtpusk.cPerson == Tmp_WinPlanOtpuskSovm.cPerson
                                                              and 3                      == Tmp_WinPlanOtpuskSovm.Prizn)) = tsOk
            {

              _loop PlanOtpuskSovm where((Tmp_WinPlanOtpuskSovm.cPerson == PlanOtpuskSovm.Person
                                       and wYearPlanVac == PlanOtpuskSovm.Year_Vac
                                       and wTuneVacType == PlanOtpuskSovm.VacType
//                                       and Tmp_WinPlanOtpuskSovm.Appoint == PlanOtpuskSovm.Appoint(NoIndex)
                                       and (j = Month(PlanOtpuskSovm.PlanYearBeg) and PlanOtpuskSovm.WSTATUS = 0
                                       )))
              {
          
                if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskSovm.Appoint == AppointmentsPlan.Nrec)) = tsOk)
                  and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpuskSovm.Prizn
                  continue;

                if GetFirst FastFirstRow Tmp_PlanOtpuskSovm where ((Tmp_WinPlanOtpuskSovm.Nrec == Tmp_PlanOtpuskSovm.cWinPlOtp
                                                            and PlanOtpuskSovm.PlanYearBeg == Tmp_PlanOtpuskSovm.DatBeg
                                                            and PlanOtpuskSovm.PlanYearEnd == Tmp_PlanOtpuskSovm.DatEnd
                                                            )) = tsok
                {
                  PlanOtpuskSovm.wRESERVE := RESERVE;
                  update current PlanOtpuskSovm;
                  Tmp_PlanOtpuskSovm.wRESERVE := RESERVE;
                  update current Tmp_PlanOtpuskSovm;
                  Tmp_WinPlanOtpuskSovm.wRESERVE    := RESERVE;
                  update current Tmp_WinPlanOtpuskSovm;
                }

              }

            }

          }

        }

        if (bPlan or bDURATION) and SummTMPPlan(Tmp_WinPlanOtpusk.Nrec,j) != 0
        {
    
          _loop PlanOtpuskD where((Tmp_WinPlanOtpusk.cPerson == PlanOtpuskD.Person
                                 and wYearPlanVac == PlanOtpuskD.Year_Vac
                                 and wTuneVacType == PlanOtpuskD.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                 and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                 )))
          {
    
             if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
               and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
               continue;

            _Loop WorkPCon where (( coPlanOtpusk          == WorkPCon.wTable      and
                                  PlanOtpuskD.Nrec        == WorkPCon.cTable      and
                                  Tmp_WinPlanOtpusk.WorkP == WorkPCon.cWorkPeriod ))
              delete current WorkPCon;

            delete current PlanOtpuskD;
    
          }
    
          _Loop Tmp_PlanOtpusk where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpusk.cWinPlOtp
                                         and j == Tmp_PlanOtpusk.Mon))
          {

            ClearBuffer(#PlanOtpusk);
            PlanOtpusk.Person      := Tmp_WinPlanOtpusk.cPerson;
            PlanOtpusk.Appoint     := Tmp_WinPlanOtpusk.Appoint;
            PlanOtpusk.VacType     := wTuneVacType;
            PlanOtpusk.Year_Vac    := wYearPlanVac;
            PlanOtpusk.Year_Work   := wYearPlanVac;
    
            if GetFirst FastFirstRow WorkPeriodTMP where((Tmp_WinPlanOtpusk.WorkP == WorkPeriodTMP.Nrec)) = tsOk
            {
              PlanOtpusk.WORKYEARBEG := WorkPeriodTMP.DPERBEG;
              PlanOtpusk.WORKYEAREND := WorkPeriodTMP.DPEREND;
            }
    
            var cTmpWP:comp = 0;
            cTmpWP := funGetFirstPeriodInTune;
        
////    if ( funCalcDateBeg(cTmpWP) = date(0, 0, 0) ) // если человек принят на работу позже даты, на которую формируем
////      exit;
      

            PlanOtpusk.PlanYearBeg := Tmp_PlanOtpusk.DatBeg;
            PlanOtpusk.PlanYearEnd := Tmp_PlanOtpusk.DatEnd;

            PerenosPeriod(Tmp_PlanOtpusk.Nrec);

            PlanOtpusk.DURATION    := Tmp_PlanOtpusk.DURATION;

            PlanOtpusk.wRESERVE    := RESERVE;

          if ( insert current PlanOtpusk = tsOk ) 
          {

            Tmp_PlanOtpusk.cPlOtp    := PlanOtpusk.Nrec;
            if (Update current Tmp_PlanOtpusk != tsOk) {}

            ClearBuffer(#WorkPCon);
            WorkPCon.wTable      := coPlanOtpusk;
            WorkPCon.cTable      := PlanOtpusk.Nrec;
            WorkPCon.cWorkPeriod := Tmp_WinPlanOtpusk.WorkP;
            if (insert current WorkPCon = tsOK) {}

            var TMPPlanOtpusk : type$PlanOtpusk;
            TMPPlanOtpusk := PlanOtpusk.Buffer;

            if getfirst fastfirstrow Tmp_WinPlanOtpuskSovm where((Tmp_WinPlanOtpusk.cPerson == Tmp_WinPlanOtpuskSovm.cPerson
                                                              and 3                      == Tmp_WinPlanOtpuskSovm.Prizn)) = tsOk
            {

              _loop PlanOtpuskD where((Tmp_WinPlanOtpuskSovm.cPerson == PlanOtpuskD.Person
                                     and wYearPlanVac == PlanOtpuskD.Year_Vac
                                     and wTuneVacType == PlanOtpuskD.VacType
//                                     and Tmp_WinPlanOtpuskSovm.Appoint == PlanOtpuskD.Appoint(NoIndex)
                                     and (j = Month(PlanOtpuskD.PlanYearBeg) and PlanOtpuskD.WSTATUS = 0
                                     )))
              {
        
                if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpuskD.Appoint == AppointmentsPlan.Nrec)) = tsOk)
                  and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpuskSovm.Prizn
                  continue;

                _Loop WorkPCon where (( coPlanOtpusk              == WorkPCon.wTable      and
                                      PlanOtpuskD.Nrec            == WorkPCon.cTable      and
                                      Tmp_WinPlanOtpuskSovm.WorkP == WorkPCon.cWorkPeriod ))
                  delete current WorkPCon;

                delete current PlanOtpuskD;
        
              }

              _Loop Tmp_PlanOtpuskSovm where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskSovm.cWinPlOtp
                                           and j == Tmp_PlanOtpuskSovm.Mon))
              {

              ClearBuffer(#PlanOtpusk);
              PlanOtpusk.Buffer := TMPPlanOtpusk;
              PlanOtpusk.Nrec   := 0;
              PlanOtpusk.Appoint:= Tmp_WinPlanOtpuskSovm.Appoint;
              if GetFirst FastFirstRow WorkPeriodTMP where((Tmp_WinPlanOtpuskSovm.WorkP == WorkPeriodTMP.Nrec)) = tsOk
              {
                PlanOtpusk.WORKYEARBEG := WorkPeriodTMP.DPERBEG;
                PlanOtpusk.WORKYEAREND := WorkPeriodTMP.DPEREND;
              }

              PlanOtpusk.wRESERVE    := RESERVE;

              if ( insert current PlanOtpusk = tsOk ) 
              {

                Tmp_PlanOtpuskSovm.cPlOtp    := PlanOtpusk.Nrec;
                if (UpDate current Tmp_PlanOtpuskSovm != tsOk) {}

                ClearBuffer(#WorkPCon);
                WorkPCon.wTable      := coPlanOtpusk;
                WorkPCon.cTable      := PlanOtpusk.Nrec;
                WorkPCon.cWorkPeriod := Tmp_WinPlanOtpuskSovm.WorkP;
                if (insert current WorkPCon = tsOK) {}

                Tmp_WinPlanOtpuskSovm.Mon[j] := PlanOtpusk.DURATION;
                Tmp_WinPlanOtpuskSovm.WRESERVE := RESERVE;

                if UpDate current Tmp_WinPlanOtpuskSovm=tsOk
                {
                  for(k:= 1; k<= 12; k++)
                  {
                  
                    if Tmp_WinPlanOtpuskSovm.Mon[k] = 0
                    {
                      DelTMPPlan(Tmp_WinPlanOtpuskSovm.Nrec,k);
                    }
                    else
                    {
                      if Tmp_WinPlanOtpuskSovm.Mon[k] != SummTMPPlan(Tmp_WinPlanOtpuskSovm.Nrec,k)
                      {
                        DelTMPPlan(Tmp_WinPlanOtpuskSovm.Nrec,k);
                      
                        ClearBuffer(#Tmp_PlanOtpusk);
                        Tmp_PlanOtpusk.Nrec      := GetNextnRec(#Tmp_PlanOtpusk,0);
                        Tmp_PlanOtpusk.cPlOtp    := 0;
                        Tmp_PlanOtpusk.cWinPlOtp := Tmp_WinPlanOtpuskSovm.Nrec;
                        Tmp_PlanOtpusk.DURATION  := Tmp_WinPlanOtpuskSovm.Mon[k];
                        Tmp_PlanOtpusk.Mon       := k;
                        Tmp_PlanOtpusk.DatBeg    := date(1,j,wYearPlanVac);
                        Tmp_PlanOtpusk.DatEnd    := GetLastDate(Tmp_PlanOtpusk.DatBeg,Tmp_PlanOtpusk.DURATION);
                        Tmp_PlanOtpusk.WRESERVE  := Tmp_WinPlanOtpuskSovm.WRESERVE;
                        if (insert current Tmp_PlanOtpusk != tsOk) {}
                      }
                    }
                  }
                }
              }//if ( insert current PlanOtpusk = tsOk ) 

              }//_Loop Tmp_PlanOtpuskSovm where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpuskSovm.cWinPlOtp

            }

          }//if ( insert current PlanOtpusk = tsOk ) 

          }//_Loop Tmp_PlanOtpusk where ((Tmp_WinPlanOtpusk.Nrec == Tmp_PlanOtpusk.cWinPlOtp

        }
      
      }//for(j:= 1; j<= 12; j++)
    
    }

    PopPos(#Tmp_WinPlanOtpusk);
    
    SetFieldOption(#Tmp_WinPlanOtpusk.Prich , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[1] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[2] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[3] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[4] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[5] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[6] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[7] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[8] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[9] , ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[10], ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[11], ofProtected);
    SetFieldOption(#Tmp_WinPlanOtpusk.Mon[12], ofProtected);
    SetInterfaceOptions(opEscClose or opCyanInterface);
    FlagIntOpt:=True;

    RescanPanel(#Tmp_WinPlanOtpusk);
    RescanPanel(#Zar_User);
    ReReadRecord;

    StopVisual('', 0);
    DisableCommand(cmCheckField);

  }

  }
  else
  {
    Message('Нет выбранных сотрудников')
  }

//  message('+++++++++SaveUtv6/'+Tmp_WinPlanOtpusk.Nrec)
}

Window wnMon (, hcNoContext, ) escclose, Blue;//Cyan;

  browse bTmp_PlanOtpusk ('Период отпуска', ,sci1EscIns);//sci147EnEsc
   table Tmp_PlanOtpuskM;
  Fields
    Tmp_WinPlanOtpuskM.FIO   'ФИО'     ('Фамилия имя отчество') :[28], Protect;
    iCatFunc.GetCatalogsName(Tmp_WinPlanOtpuskM.Post) 'Должность' ('Должность'):[12], Protect;
    iCatFunc.GetCatalogsCode(Tmp_WinPlanOtpuskM.Dep) 'Код'#13'подразделения' ('Код подразделения'):[12], Protect;
    Tmp_PlanOtpuskM.DatBeg   'Дата c'  ('Дата c'):[10], NoProtect;
    Tmp_PlanOtpuskM.DatEnd   'Дата по' ('Дата по'):[10], Skip;
    Tmp_PlanOtpuskM.DURATION 'Дней'    ('Дней'):[5], NoProtect;
  end; // browse
/*
HandleEvent
cmInit:
{
  // Загружаем протектор
  LoadVipRef(Protector, 'Protector');
  Protector.LinkTo(cfsGetCurrentContainerSelf, 'MainWindow');
  if FlagIntOpt
  {
  Protector.SetProtectedStatusCtx(sci1EscIns);
  SetInterfaceOptions(opEscClose or opCyanInterface);
  }
  else
  {
  SetInterfaceOptions(opEscClose);
  Protector.SetProtectedStatusCtx(sci18EscIns);
  }
}

end;
*/
end; //Window wnMon ;

function Peresechenie:boolean;
{
  Peresechenie := false;
  _loop Tmp_PlanOtpuskPer where((Tmp_PlanOtpuskM.cWinPlOtp == Tmp_PlanOtpuskPer.cWinPlOtp))
  {
    if Tmp_PlanOtpuskM.Nrec != Tmp_PlanOtpuskPer.Nrec
    if iStrFunc.isCrossPeriod(Tmp_PlanOtpuskM.DatBeg,Tmp_PlanOtpuskM.DatEnd, Tmp_PlanOtpuskPer.DatBeg,Tmp_PlanOtpuskPer.DatEnd)
    {
      Message('Ошибка пересечение дат '+Tmp_PlanOtpuskM.DatBeg+'-'+Tmp_PlanOtpuskM.DatEnd+' и '+Tmp_PlanOtpuskPer.DatBeg+'-'+Tmp_PlanOtpuskPer.DatEnd, Error);
      Peresechenie := true;
      break;
    }
  }
}

HandleEvent
  cmCheckField:
  {
/*    if Tmp_PlanOtpuskM.WRESERVE != -32000  or PlanOtpuskD.wRESERVE != -8000  or PlanOtpuskD.wRESERVE != -4000
    {
      Message('Редактирование запрешено! Неоходимо создавать приказ', Warning + OkButton);
    }
    else
*/
    case CurField of
    #Tmp_PlanOtpuskM.DURATION:
    {
      if Tmp_PlanOtpuskM.DURATION != 0
      {
        if Tmp_WinPlanOtpuskM.Mon[FieldMon] > Tmp_PlanOtpuskM.DURATION
        {
        
          Tmp_PlanOtpuskM.DatEnd    := GetLastDate(Tmp_PlanOtpuskM.DatBeg,Tmp_PlanOtpuskM.DURATION);
          if Not Peresechenie
          {
            update current Tmp_PlanOtpuskM;
        
          ClearBuffer(#Tmp_PlanOtpuskDbl);
          Tmp_PlanOtpuskDbl.Buffer    := Tmp_PlanOtpuskM.Buffer;
          Tmp_PlanOtpuskDbl.Nrec      := GetNextnRec(#Tmp_PlanOtpusk,0);
          Tmp_PlanOtpuskDbl.DURATION  := Tmp_WinPlanOtpuskM.Mon[FieldMon] - SummTMPPlan(Tmp_WinPlanOtpuskM.Nrec,FieldMon);
          Tmp_PlanOtpuskDbl.DatBeg    := Add_Day(Tmp_PlanOtpuskM.DatEnd,1);
          Tmp_PlanOtpuskDbl.DatEnd    := GetLastDate(Tmp_PlanOtpuskDbl.DatBeg,Tmp_PlanOtpuskDbl.DURATION);
          if (insert current Tmp_PlanOtpuskDbl != tsOk) {}
          }
        
        }
        if Tmp_WinPlanOtpuskM.Mon[FieldMon] < Tmp_PlanOtpuskM.DURATION
        {
          Message(chr(3)+'Превышено плановое количество дней', okButton);
          Tmp_PlanOtpuskM.DURATION := Tmp_WinPlanOtpuskM.Mon[FieldMon];
          Tmp_PlanOtpuskM.DatEnd   := GetLastDate(Tmp_PlanOtpuskM.DatBeg,Tmp_PlanOtpuskM.DURATION);
          if Not Peresechenie
            update current Tmp_PlanOtpuskM;
        }
      }
      else
        Message(chr(3)+'Количество дней не должно быть 0!', okButton);
    }
    #Tmp_PlanOtpuskM.DatBeg:
    {

      if year(Tmp_PlanOtpuskM.DatBeg) = WYEARPLANVAC
      {

        if Month(Tmp_PlanOtpuskM.DatBeg) != FieldMon
        {
          Tmp_PlanOtpuskM.DatBeg := date(Day(Tmp_PlanOtpuskM.DatBeg),FieldMon,Year(Tmp_PlanOtpuskM.DatBeg));
          Tmp_PlanOtpuskM.DatEnd := GetLastDate(Tmp_PlanOtpuskM.DatBeg,Tmp_PlanOtpuskM.DURATION);
        
          if Not Peresechenie
            update current Tmp_PlanOtpuskM;
        }
        else
        {
          Tmp_PlanOtpuskM.DatEnd    := GetLastDate(Tmp_PlanOtpuskM.DatBeg,Tmp_PlanOtpuskM.DURATION);
          if Not Peresechenie
            update current Tmp_PlanOtpuskM;
        }
      }
      else
        Message(chr(3)+'Дата должна попадать в диапазон '+WYEARPLANVAC+' года!', okButton);

    }
    #Tmp_PlanOtpuskM.DatEnd:
    {

//      if year(Tmp_PlanOtpuskM.DatEnd) = WYEARPLANVAC
//      {

        Tmp_PlanOtpuskM.DURATION := To_Days(Sub_Date(Tmp_PlanOtpuskM.DatEnd,Tmp_PlanOtpuskM.DatBeg));
        if Not Peresechenie
        {
          update current Tmp_PlanOtpuskM;
        
        if Tmp_WinPlanOtpuskM.Mon[FieldMon] > Tmp_PlanOtpuskM.DURATION
        {
          ClearBuffer(#Tmp_PlanOtpuskDbl);
          Tmp_PlanOtpuskDbl.Buffer    := Tmp_PlanOtpuskM.Buffer;
          Tmp_PlanOtpuskDbl.Nrec      := GetNextnRec(#Tmp_PlanOtpusk,0);
          Tmp_PlanOtpuskDbl.DURATION  := Tmp_WinPlanOtpuskM.Mon[FieldMon] - SummTMPPlan(Tmp_WinPlanOtpuskM.Nrec,FieldMon);
          Tmp_PlanOtpuskDbl.DatBeg    := Add_Day(Tmp_PlanOtpuskM.DatEnd,1);
          Tmp_PlanOtpuskDbl.DatEnd    := GetLastDate(Tmp_PlanOtpuskDbl.DatBeg,Tmp_PlanOtpuskDbl.DURATION);
          if (insert current Tmp_PlanOtpuskDbl != tsOk) {}
        }
        if Tmp_WinPlanOtpuskM.Mon[FieldMon] < Tmp_PlanOtpuskM.DURATION
        {
          Message(chr(3)+'Превышено плановое количество дней', okButton);
          Tmp_PlanOtpuskM.DURATION := Tmp_WinPlanOtpuskM.Mon[FieldMon];
          Tmp_PlanOtpuskM.DatEnd   := GetLastDate(Tmp_PlanOtpuskM.DatBeg,Tmp_PlanOtpuskM.DURATION);
          if Not Peresechenie
            update current Tmp_PlanOtpuskM;
        }

        }
        
//      }
//      else
//        Message(chr(3)+'Дата должна попадать в диапазон '+WYEARPLANVAC+' года!', okButton);
    }

    end; //case

    ReReadRecord(#Tmp_PlanOtpuskM);
//    RescanPanel(#Tmp_PlanOtpuskM);
    RescanPanel(#Zar_User);
}

cmInit:
{
  mtClear(#Tmp_WinPlanOtpusk, mfNormal);
  mtClear(#Tmp_PlanOtpusk, mfNormal);

  Marker := InitMarker('WinPlanOtpusk',8,100,10,FALSE) ;
  ClearMarker(Marker);

  if not ReadMyDsk(Filtrpodr,'k_Filtrpodr',false)
    {}
  mrkOuterClassfier:=InitMarker('Z_Statis_mrkOuterClassfier',8,20,10); //маркер с отмеченными классификаторами

  if GetMarkerCount(mrkOuterClassfier) = 0
    MarkerNotNull:= false;
  else MarkerNotNull:=true;

  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  FlagIntOpt := true;
  dPlanOtOld := date(1,Month(Add_Months(Cur_Date,1)),Year(Cur_Date));

  wTuneVacType := word(coGetTune('UP.ZAR.KlPlanOtp'));

  if (not ReadMyDsk(wYearPlanVac, 'WinPlanOtpusk_wYearPlanVac', false))
    wYearPlanVac := Year(Cur_Date);

  if Year(Cur_Date) > wYearPlanVac
    wYearPlanVac := Year(Cur_Date);

  SetTitle('Плановые отпуска на ' + wYearPlanVac + ' год');

  If getfirst PlanOtpuskSave where((wYearPlanVac == PlanOtpuskSave.Year_Vac
                               and wTuneVacType == PlanOtpuskSave.VacType
                               and (PlanOtpuskSave.WSTATUS = 65535))) = tsOk
    DisableCommand(cmValue8);

  if Not isValid(#Formarks)
    PutCommand(cmValue3);
  else
    IncTMP;

  SetEnableCommand(cmValue6, wGetTune('NPOEM_OWN.PLOTP.USERROLE') = 1);
}             	
