{

  if (((CurField = #Tmp_WinPlanOtpusk.Mon[1]    and (1  >= Month(Cur_date) and wYearPlanVac = year(Cur_date)))
     or (CurField = #Tmp_WinPlanOtpusk.Mon[2]  and (2  >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
     or (CurField = #Tmp_WinPlanOtpusk.Mon[3]  and (3  >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
     or (CurField = #Tmp_WinPlanOtpusk.Mon[4]  and (4  >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
     or (CurField = #Tmp_WinPlanOtpusk.Mon[5]  and (5  >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
