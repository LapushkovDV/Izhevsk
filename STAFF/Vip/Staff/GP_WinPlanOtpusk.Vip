     or (CurField = #Tmp_WinPlanOtpusk.Mon[7]  and (7  >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
     or (CurField = #Tmp_WinPlanOtpusk.Mon[8]  and (8  >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
     or (CurField = #Tmp_WinPlanOtpusk.Mon[9]  and (9  >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
     or (CurField = #Tmp_WinPlanOtpusk.Mon[10] and (10 >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
     or (CurField = #Tmp_WinPlanOtpusk.Mon[11] and (11 >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
     or (CurField = #Tmp_WinPlanOtpusk.Mon[12] and (12 >= Month(Cur_date) and wYearPlanVac = year(Cur_date))) 
     ) or wYearPlanVac > year(Cur_date)) 
     and (not FlagIntOpt)
    EnableCommand(cmValue5);
  else
    DisableCommand(cmValue5);

  PutHotCommand(RunMenu('hkWinPlanOtpusk'));
