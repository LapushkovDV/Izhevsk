      ,{Font = {backcolor = if(Tmp_WinPlanOtpusk.AppD>date(Last_Day(Date(1,12,wYearPlanVac)),12,wYearPlanVac),ColorSysBlack,if(Tmp_WinPlanOtpusk.Mon[12]!=0, if(Tmp_WinPlanOtpusk.MonFact[12],ColorSysFuchsia,ColorSysYellow), 0)); bold = true}};                       

