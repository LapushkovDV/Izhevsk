    Tmp_WinPlanOtpusk.wDayOld   'Остаток'#13'прошлого года' ('Остаток прошлого года') :[5], Protect,{Font = {backcolor = if(Ostatok<0, ColorSysRed, if(Ostatok>0, ColorSysGreen,0)); bold = true}};

