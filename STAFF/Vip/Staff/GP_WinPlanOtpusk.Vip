cmMarkUnMark :
{
  if (SearchMarker(Marker,Tmp_WinPlanOtpusk.NRec,IndexMarker))
  {
     DeleteMarker(Marker,Tmp_WinPlanOtpusk.NRec);
//     if (GetNext Tmp_WinPlanOtpusk = tsOk) /*CallToNeighBours(cmPosDown,#Tmp_WinPlanOtpusk);*/
  }
  else
