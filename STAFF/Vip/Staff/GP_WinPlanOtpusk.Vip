interface GP_WinPlanOtpusk 'Плановые отпуска' EscClose, Cyan;
  Show at (,,80,27);

const
  // Константы значений поля WorkPeriod.wTypePeriod, определяющие тип периода
  cnWP_Work        = word(0);   // обычные рабочий период
  cnWP_Shift       = word(1);   // сдвиг рабочего периода
  cnWP_Hidden      = word(2);   // скрытый внутренний рабочий период
  cnWP_Accounting  = word(3);   // период учета
  cnWP_FuturePVac  = word(4);   // рабочие периоды полагающихся отпусков, выданных авансом
  cnWP_NeedCorrect = word(100); // РП подлежащие корректировке после установки связи совместительств
end;

var iCatFunc   : CatalogsFunctions;
var iFV        : iFactVacation New;
var iStrFunc   : StringFunctions;
var VAppFuncs  : AppointmentsFunctions;
var Protector  : IProtector; // для режима редактирования
var MLFP       : MainLschetForPersons;  // нахождение основного л\с
var CLSF       : CurLSFunctions;
var soExtAttr  : iExtAttr;

  table struct Tmp_WinPlanOtpusk
  (
    Nrec           :Comp,
    cPerson        :Comp,
    FIO            :String,
    Tabn           :String,
    Post           :Comp,
    AppD           :Date,
    DisD           :Date,
    Appoint        :Comp,
    Mon            :array[1..12] of double,
    MonFact        :array[1..12] of boolean,
    wDay           :Integer,
    wDayDop        :Integer,
    wDayOld        :Integer,
    Day14          :Boolean,
    Day28          :Boolean,
    Day28Plus      :Boolean,
    OtpUxod        :string,
    WorkP          :Comp,
    Dep            :Comp,
    Prizn          :Integer,
    WRESERVE       :Integer,
    Cex            :Comp,
    Prich          :string
  )
  with index
  (
    Tmp_WinPlanOtpusk01 = cPerson + Prizn,
    Tmp_WinPlanOtpusk02 = FIO,
    Tmp_WinPlanOtpusk03 = Nrec,
    Tmp_WinPlanOtpusk04 = Appoint
  )
  ;

  table struct Tmp_PlanOtpusk
  (
    Nrec           :Comp,
    cPlOtp         :Comp,
    cWinPlOtp      :Comp,
    DURATION       :double,
    Mon            :Integer,
    DatBeg         :Date,
    DatEnd         :Date,
    Prizn          :Integer,
    WRESERVE       :Integer
  )
  with index
  (
    Tmp_PlanOtpusk00 = Nrec,
    Tmp_PlanOtpusk01 = cPlOtp,
    Tmp_PlanOtpusk02 = cWinPlOtp + cPlOtp,
    Tmp_PlanOtpusk03 = cWinPlOtp + Mon,
    Tmp_PlanOtpusk04 = Mon,
    Tmp_PlanOtpusk05 = cWinPlOtp + DatBeg + DatEnd
  )
  ;

create view
var
  wYearPlanVac     ,
  wTuneVacType     :word;
  j,k,
  SumPutVac        : integer;
  wCalcMode,
  cCur_WorkPeriod  : Comp;
  dDateCalc:      date;
  iWP       : WorkPeriods;
  cWPRec  : comp;
  FlagField: boolean;
  FlagIntOpt: boolean;
  FieldMon  : integer;
  EditMode  : Boolean;
  dPlanOtOld:Date;
  p2             : double;
  _PodrMArkerPointer: Longint; // сам маркер
  mrkOuterClassfier : longInt;   //маркер с отмеченными классификаторами
  MarkerNotNull     : boolean;   // флаг - маркер не пустой
  Marker      : longint;
  IndexMarker       : longint;
  #include PAFilter.var
(
  FiltrPodr,
  FiltrPublic
)
as select
  #include GP_Podrfiltr1.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.
  ,if(Tmp_WinPlanOtpusk.Prizn=0,'осн.',
     if(Tmp_WinPlanOtpusk.Prizn=2,'зам.',
       if(Tmp_WinPlanOtpusk.Prizn=3,'совм.',
    'другое'))) 
  ( FieldName = sPrizn)

  ,if(Tmp_WinPlanOtpusk.WRESERVE = -4000,'Черновик',
    if(Tmp_WinPlanOtpusk.WRESERVE = -32000,'На согласование',
      if(Tmp_WinPlanOtpusk.WRESERVE = -16000,'Согласовано',
        if(Tmp_WinPlanOtpusk.WRESERVE = -8000,'Отклонено',
   'Утверждено'))))
  ( FieldName = Utver)
  ,if (Foundmarker(Marker,Tmp_WinPlanOtpusk.Nrec),'V',' ' )
  (FieldName = picked)

from
 Zar_User
 ,Lschet
 ,Lschet Lschet1
 ,Lschet LschetN
 ,Persons PersonsN
 ,Persons Persons1
 ,Tmp_WinPlanOtpusk(Tmp_WinPlanOtpusk02)
 ,Tmp_WinPlanOtpusk Tmp_WinPlanOtpuskSovm
 ,Tmp_PlanOtpusk
 ,Appointments
 ,Appointments AppointmentsPlan
 ,WorkPeriod                     (WorkPeriod08)
 ,WorkPeriod WorkPeriodTMP
 ,PlanOtpusk
 ,WorkPeriod ForDate_WorkPeriod
 ,WorkPeriod Find_WorkPeriod
 ,PlanOtpusk PlanOtpuskD
 ,CurLschet
 ,WorkPCon
 ,PutVacation
 ,Vacations
 ,KlOtpusk
 ,Prazd
 ,Tmp_PlanOtpusk Tmp_PlanOtpuskM (Tmp_PlanOtpusk05)
 ,Tmp_PlanOtpusk Tmp_PlanOtpuskNO
 ,Tmp_PlanOtpusk Tmp_PlanOtpuskSovm
 ,Tmp_PlanOtpusk Tmp_PlanOtpuskTMP
 ,Tmp_WinPlanOtpusk Tmp_WinPlanOtpuskM
 ,Tmp_PlanOtpusk Tmp_PlanOtpuskDbl
 ,Tmp_PlanOtpusk Tmp_PlanOtpuskPer
 ,LSchet LSchetTabN
 ,FactOtpusk
 ,PlanOtpusk     PlanOtpuskSovm
 ,PlanOtpusk     PlanOtpuskSave
 ,Tmp_WinPlanOtpusk Tmp_WinPlanOtpuskItog
// ,PlanOtpusk PlanOtpuskOld
// ,WorkPeriod WorkPeriodOld
// ,Vacations VacationsOld
where 
((
  _cLSchet                == Formarks.Choice     
  and Formarks.cLschet    == Lschet1.nrec
  and LSchet1.tPerson     == Persons1.Nrec
  and Persons1.Nrec       == Appointments.PERSON
    and (
     date(31, 12, wYearPlanVac)  >= Appointments.AppointDate   and
     (date(31, 12, wYearPlanVac) <= Appointments.DismissDate or
      Day(Appointments.DismissDate) = 0) and
      2 <> Appointments.wAddWord1            //только по штатному
      and
      (
        0 = Appointments.lPrizn
//        or
//        70 = Appointments.lPrizn
        or
        3 = Appointments.lPrizn
      )
      and Appointments.person <> 0
    )
  and Appointments.NRec   == WorkPeriod.cAppointment
  and Appointments.Person == WorkPeriod.cPerson
  and cnWP_Work           == WorkPeriod.wTypePeriod

  and WorkPeriodTMP.NRec  == PutVacation.cWorkPeriod 


  and cCur_WorkPeriod     == ForDate_WorkPeriod.nRec

  and Appointments.NRec   == Find_WorkPeriod.cAppointment
  and Appointments.Person == Find_WorkPeriod.cPerson
  and cnWP_Work           == Find_WorkPeriod.wTypePeriod

  and FieldMon                  == Tmp_PlanOtpuskM.Mon
  and Tmp_PlanOtpuskM.cWinPlOtp == Tmp_WinPlanOtpuskM.Nrec

  and #include GP_Podrfiltr2.vpp  // вычисляемые поля для фильтров по сотрудн. и подразд.
))
;

#include GP_PODRPAFilter.vpp
var IntInitSession: IContextSession;

function CaptureIntInitContext: boolean;
{
  var CL: ContextList;
  InitContextSessionOwner;
  Result := CL.Add(IntInitSession, 'IntInit');
}

HandleEvent
  cmInit:
  {
    if not CaptureIntInitContext
      abort;
  }

  cmOnVipLoad:
  {
    if not CaptureIntInitContext
      abort;
  }
end;

//_________________________________________________________
//  Расчет конечной даты с учетом праздников
Function GetLastDate (var Datan: date; var Days: double) :date;
  var pr: integer;  // количество праздничных дней в диапазоне
  var tmpDatan: date;
{

    tmpDatan := Datan;
    pr := 0;
    do
    {
  
      if (getfirst Prazd where ((tmpDatan == Prazd.Ddate)) <> tsOk)// or (PerenosDat = '0')
        inc(pr);
      else
      {
        if SubStr(Prazd.NAME, 1, 1) = '+' or SubStr(Prazd.NAME, 1, 1) = '-' or SubStr(Prazd.NAME, 1, 1) = '>'
          inc(pr);
      }
  
      tmpDatan := ADD_DAY(tmpDatan, 1);
  
    }
    while Days > pr
  
    GetLastDate := Sub_day(tmpDatan, 1);

}
// согласно параметрам ищем
function funCalcDateBeg(cPar_WorkPeriod: comp): date;
var
  dWorkDate: date;
{
  funCalcDateBeg  := ZeroDate;
  cCur_WorkPeriod := cPar_WorkPeriod;
  dWorkDate       := ZeroDate;

  case wCalcMode of

    word(0): //по истечении 11 месяцев
      {
        if (GetFirst ForDate_WorkPeriod = tsOk)
          dWorkDate := Add_Months(ForDate_WorkPeriod.dPerBeg, 11);
        funCalcDateBeg := if (dWorkDate < date(1, 1, wYearPlanVac), date(1, 1, wYearPlanVac), dWorkDate);
      }

    word(1): //по истечении 6 месяцев
      {
        if (GetFirst ForDate_WorkPeriod = tsOk)
          dWorkDate := Add_Months(ForDate_WorkPeriod.dPerBeg, 6);
        funCalcDateBeg := if (dWorkDate < date(1, 1, wYearPlanVac), date(1, 1, wYearPlanVac), dWorkDate);
      }

    word(2): //по истечении 3 месяцев
      {
        if (GetFirst ForDate_WorkPeriod = tsOk)
          dWorkDate := Add_Months(ForDate_WorkPeriod.dPerBeg, 3);
        funCalcDateBeg := if (dWorkDate < date(1, 1, wYearPlanVac), date(1, 1, wYearPlanVac), dWorkDate);
      }

    word(3): //на указанную дату
      {
        if ( ( GetFirst Find_WorkPeriod = tsOk ) and
             ( Find_WorkPeriod.dPerBeg <= dDateCalc ) )
          funCalcDateBeg := dDateCalc; //считаю так правильнее, хотя и планируем только на будущее
      }

    word(4): //
      {
        if (GetFirst ForDate_WorkPeriod = tsOk)
          dWorkDate := Add_Day(ForDate_WorkPeriod.dPerEnd, 1);
        funCalcDateBeg := if (dWorkDate < date(1, 1, wYearPlanVac), date(1, 1, wYearPlanVac), dWorkDate);
      }


  end; //case
}
// проверка перед созданием записи, врозвращает nRec самой ранней
function funGetFirstPeriodInTune: comp;
{
  funGetFirstPeriodInTune := comp(0);

  _loop WorkPeriod
    {
      if ( ( Year(WorkPeriod.dPerBeg) = wYearPlanVac ) or
           ( Year(WorkPeriod.dPerEnd) = wYearPlanVac ) )
        {
          funGetFirstPeriodInTune := WorkPeriod.nRec;
          exit;
        }
    }
}

Procedure Day14_28;
{
      Tmp_WinPlanOtpusk.Day14     := true;
      Tmp_WinPlanOtpusk.Day28     := true;
      Tmp_WinPlanOtpusk.Day28Plus := true;

      var SummDay : longint = 0 ;

      for(j:= 1; j<= 12; j++)
      {
        SummDay += Tmp_WinPlanOtpusk.Mon[j];

        if Tmp_WinPlanOtpusk.Day14
        {

          if Tmp_WinPlanOtpusk.Mon[j] >= 14
            Tmp_WinPlanOtpusk.Day14 := false;

        }

      }

      if SummDay >= 28
        Tmp_WinPlanOtpusk.Day28 := false;

      if SummDay >= 28 + Tmp_WinPlanOtpusk.wDayOld
        Tmp_WinPlanOtpusk.Day28Plus := false;
}

Procedure IncTMP;
{

  StartNewVisual(vtIndicatorVisual, 0, 'Загрузка плановых отпусков...', RecordsInTable(#Formarks));

  mtClear(#Tmp_WinPlanOtpusk, mfNormal);
  mtClear(#Tmp_PlanOtpusk, mfNormal);

  IntInit;

  _loop Formarks
  {

    if not NextVisual
      break;

    _loop LSchet1
    {

    if (LSchet1.DatPos > Date(31,12,wYearPlanVac))
      continue;

    if (Lschet1.DATUV > date(0,0,0) and Lschet1.DATUV < Date(1,1,wYearPlanVac))
      continue;

//message(Lschet1.TabN)

    _loop Persons1
    {
    // обходим тех, кто еще не принят на работу
    if (Persons1.AppDate > Date(31,12,wYearPlanVac))
      continue;
    // уволенных обходим
    if (Persons1.DisDate > date(0,0,0) and Persons1.DisDate < Date(1,1,wYearPlanVac))
      continue;

//message(Persons1.TabNmb)

//    if GetLast FastFirstRow Appointments = tsOk
    _loop Appointments
    {
//message('Appointments.Nrec/'+Appointments.Nrec+'/'+Appointments.lPrizn+'/'+)

      if (GetFirst FastFirstRow Tmp_WinPlanOtpusk where ((Appointments.NRec == Tmp_WinPlanOtpusk.Appoint)) = tsOk)
        continue;

      ClearBuffer(#Tmp_WinPlanOtpusk);
      Tmp_WinPlanOtpusk.Nrec    := GetNextnRec(#Tmp_WinPlanOtpusk,0);
      Tmp_WinPlanOtpusk.cPerson := Persons1.Nrec;
      Tmp_WinPlanOtpusk.FIO     := Persons1.FIO;
      Tmp_WinPlanOtpusk.Post    := Appointments.Post;
      if (GetFirst LSchetTabN where ((APPOINTMENTS.cAddNrec2 == LSchetTabN.nRec)) = tsOk)
      {
        Tmp_WinPlanOtpusk.Cex   := LSchetTabN.Cex;
        Tmp_WinPlanOtpusk.Tabn    := GetStrTabN(LSchetTabN.TabN,  LSchetTabN.StrTabN);
      }

      if appointments.lprizn=0
      {
        Tmp_WinPlanOtpusk.Cex   := persons1.galdep;
      }
      Tmp_WinPlanOtpusk.Appoint := Appointments.NRec;
      Tmp_WinPlanOtpusk.Dep     := Appointments.Department;
      Tmp_WinPlanOtpusk.Prizn   := Appointments.lPrizn;
      Tmp_WinPlanOtpusk.AppD    := Persons1.AppDate;
      Tmp_WinPlanOtpusk.DisD    := Persons1.DisDate;

      Tmp_WinPlanOtpusk.OtpUxod := '';

      _loop Vacations where ((
                              Appointments.Person ==  Vacations.Person
                            ))
      {

        if (GetFirst FastFirstRow  KlOtpusk where ((Vacations.VacType == KlOtpusk.NRec)) = tsOk)
        {

          if KlOtpusk.days = 'ОЖ' or KlOtpusk.days = 'Р'
          {

             if iStrFunc.isCrossPeriod(Date(1,1,wYearPlanVac),Date(31,12,wYearPlanVac), Vacations.FactYearBeg,Vacations.FactYearEnd)
             {
               Tmp_WinPlanOtpusk.OtpUxod := 'По уходу за ребенком';
//               Tmp_WinPlanOtpusk.OtpUxod := substr(KLOTPUSK.NOTPUS,pos(' до ',KLOTPUSK.NOTPUS),length(KLOTPUSK.NOTPUS));
               break;
             }

          }

        }

      }
      
      Tmp_WinPlanOtpusk.WRESERVE:= -4000;

      for(j:= 1; j<= 12; j++)
      {
      
        Tmp_WinPlanOtpusk.Mon[j]     := 0;
        Tmp_WinPlanOtpusk.MonFact[j] := False;
      
        _loop PlanOtpusk where((Tmp_WinPlanOtpusk.cPerson == PlanOtpusk.Person
                                 and wYearPlanVac == PlanOtpusk.Year_Vac
                                 and wTuneVacType == PlanOtpusk.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpusk.Appoint(NoIndex)
                                 and (j = Month(PlanOtpusk.PlanYearBeg) and PlanOtpusk.WSTATUS = 0
                                 )))
        {

          if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpusk.Appoint == AppointmentsPlan.Nrec)) = tsOk)
            and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
            continue;

          if Not Tmp_WinPlanOtpusk.MonFact[j]
            if (GetFirst FastFirstRow FactOtpusk where ((PlanOtpusk.NRec == FactOtpusk.cPlanOtpusk)) = tsOk)
              Tmp_WinPlanOtpusk.MonFact[j] := true;

          Tmp_WinPlanOtpusk.Mon[j] += PlanOtpusk.DURATION;
          Tmp_WinPlanOtpusk.WRESERVE   := PlanOtpusk.WRESERVE;

          ClearBuffer(#Tmp_PlanOtpusk);
          Tmp_PlanOtpusk.Nrec      := GetNextnRec(#Tmp_PlanOtpusk,0);
          Tmp_PlanOtpusk.cPlOtp    := PlanOtpusk.Nrec;
          Tmp_PlanOtpusk.cWinPlOtp := Tmp_WinPlanOtpusk.Nrec;
          Tmp_PlanOtpusk.DURATION  := PlanOtpusk.DURATION;
          Tmp_PlanOtpusk.Mon       := Month(PlanOtpusk.PlanYearBeg);
          Tmp_PlanOtpusk.DatBeg    := PlanOtpusk.PlanYearBeg;
          Tmp_PlanOtpusk.DatEnd    := PlanOtpusk.PlanYearEnd;
          Tmp_PlanOtpusk.WRESERVE  := PlanOtpusk.WRESERVE;

          if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpusk.Appoint == AppointmentsPlan.Nrec)) = tsOk)
            Tmp_PlanOtpusk.Prizn     := AppointmentsPlan.lPrizn;

          if (insert current Tmp_PlanOtpusk != tsOk) {}

        }
      
      }

      // найдем РП для пересчета сдвигов, корректировка даты начала должна быть снаружи метода при изменении даты приема в карточке
      cWPRec := iWP.GetWPByDateAndApp(Persons1.NRec, Appointments.NRec, date(31,12,wYearPlanVac), True);

      if cWPRec = 0 
      {
        displ('-->'+ Tmp_WinPlanOtpusk.FIO + ' ('+Tmp_WinPlanOtpusk.Tabn+'), Долж.:'+iCatFunc.GetCatalogsName(Appointments.Post));
        displ('[-] отсутствует период начинающийся в ' + wYearPlanVac + ' году');
      }

      if GetFirst FastFirstRow WorkPeriodTMP where((cWPRec == WorkPeriodTMP.Nrec)) = tsOk
      {

        Tmp_WinPlanOtpusk.WorkP := WorkPeriodTMP.Nrec;
        Tmp_WinPlanOtpusk.Prich := sGetAttr(coWorkPeriod, Tmp_WinPlanOtpusk.WorkP, 'Причина отказа');

        _loop PutVacation
        {

          if GetFirst FastFirstRow KlOtpusk where((PutVacation.cKlOtpusk == KlOtpusk.NRec)) = tsOk
          {

            if KlOtpusk.KOTPUS = 1
            {
              if PutVacation.wTypeVac = word(1)
                Tmp_WinPlanOtpusk.wDay    += PutVacation.wDayCount;
              else
                Tmp_WinPlanOtpusk.wDay    += PutVacation.wDayCount*( (12-Month(WorkPeriodTMP.DPERBEG)+if(31-Day(WorkPeriodTMP.DPERBEG)>=15,1,0) )/12);

            }
            else
            {
              if PutVacation.wTypeVac = word(1)
                Tmp_WinPlanOtpusk.wDayDop += PutVacation.wDayCount;
              else
                Tmp_WinPlanOtpusk.wDayDop += PutVacation.wDayCount*( (12-Month(WorkPeriodTMP.DPERBEG)+if(31-Day(WorkPeriodTMP.DPERBEG)>=15,1,0) )/12);
            }

          }

        }

      }
/*
      var PlanWDay : Integer = 0;
      var FactWDay : Integer = 0;

//MESSAGE('wTuneVacType/'+wTuneVacType+'/'+wYearPlanVac);
      _loop PlanOtpuskOld where ((Persons1.Nrec == PlanOtpuskOld.Person 
                     and wYearPlanVac - 1 == PlanOtpuskOld.Year_Vac
                               and wTuneVacType == PlanOtpuskOld.VacType
                               and (PlanOtpuskOld.WSTATUS = 0)	
                                ))
      {
//message('PlanOtpuskOld/'+PlanOtpuskOld.PlanYearBeg
//+'/'+PlanOtpuskOld.PlanYearEnd
//+'/'+PlanOtpuskOld.Year_Vac+'/'+PlanOtpuskOld.VacType+'/'+PlanOtpuskOld.DURATION);
        PlanWDay += PlanOtpuskOld.DURATION;
      }

      cWPRec := iWP.GetWPByDateAndApp(Persons1.NRec, Appointments.NRec, date(31,12,wYearPlanVac-1), True);

      if cWPRec = 0 
      {
      }
      else
      {

        if GetFirst FastFirstRow WorkPeriodOld where((cWPRec == WorkPeriodOld.Nrec)) = tsOk
        {

//         Vacations.cWorkPeriod == WorkPeriod.NRec       and
//             Vacations.VacType == KlOtpusk.NRec         and  // отпуска
//         Vacations.cFactOtpusk == FactOtpusk.NRec       and
//                Vacations.NRec == Otpusk.cVacations     and
//message('WorkPeriodOld/'+WorkPeriodOld.DPERBEG+'/'+WorkPeriodOld.DPEREND);

          _loop VacationsOld where((cWPRec  == VacationsOld.cWorkPeriod))
          {
            FactWDay += VacationsOld.Duration;
//message('VacationsOld/'+VacationsOld.Duration);
          }

        }

      }
      Tmp_WinPlanOtpusk.wDayOld := PlanWDay - FactWDay;
*/

      Tmp_WinPlanOtpusk.wDayOld := soExtAttr.doGetAttr(coWorkPeriod, cWPRec, 'Дополнительное количество дней');

      var D : date = date(0,0,0);

      PushPos(#PlanOtpusk);
//      if dPlanOtOld < date(1,1,wYearPlanVac)
//      for(D := dPlanOtOld; D < date(1,1,wYearPlanVac); D := Add_Months(D,1))
//      {
/*
        _loop PlanOtpusk where((Tmp_WinPlanOtpusk.cPerson == PlanOtpusk.Person
                                 and Year(dPlanOtOld) == PlanOtpusk.Year_Vac
                                 and wTuneVacType == PlanOtpusk.VacType
//                                 and Tmp_WinPlanOtpusk.Appoint == PlanOtpusk.Appoint(NoIndex)
                                 and ((dPlanOtOld <=  PlanOtpusk.PlanYearBeg   and
                                      Date(31,12,Year(wYearPlanVac-1)) >= PlanOtpusk.PlanYearBeg
                                 ) and PlanOtpusk.WSTATUS = 0)
                                 ))
        {

          if (GetFirst FastFirstRow AppointmentsPlan where ((PlanOtpusk.Appoint == AppointmentsPlan.Nrec)) = tsOk)
            and AppointmentsPlan.lPrizn != Tmp_WinPlanOtpusk.Prizn
            continue;

          Tmp_WinPlanOtpusk.wDay -= PlanOtpusk.DURATION;
        }
*/

//      }
      PopPos(#PlanOtpusk);
      
      Day14_28;

      if (insert current Tmp_WinPlanOtpusk != tsOk) {}

    }

    }

    }

  }

  ExitProc;

  StopVisual('', 0);
}

Window wnFormTune;

screen scrFormTune;
  show at (,,,);
  fields
    wYearPlanVac  ('Установите год формирования отпуска',,sci1Esc): NoProtect, SpinButton [1,2019,2100];
buttons
  cmOK;
  cmCancel;
<<

  Год формирования плана-графика отпусков:.@@@@@@@@@@@

     <.Продолжить.>                           <.  Отмена  .>

>>
end; // screen scrFormTune

HandleEvent
cmOk:
{

  if wYearPlanVac < 2019
  {
      Message('Планирование отпусков начинается с 2019 года!', Warning + OkButton);
      set wYearPlanVac := 2019;
      exit;
  }

  CloseInterface(cmClose);

}
end;

end; //Window FormTune;



Window wnMess ;

screen scr1;
fields
  Zar_User.GrupStN ('Выбор фильтра', hcNoContext): noprotect;
  FiltrPodr  ('Фильтр по подразделению', hcNoContext): protect, pickbutton;
  FiltrPublic('Фильтр по работникам', hcNoContext): protect,pickbutton;

buttons
  cmOK;
  cmCancel;
<<

  Фильтр по: 
  [.] подразделению` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  [.] работникам   ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     <.Продолжить.>                           <.  Отмена  .>

>>
end;

HandleEvent

cmInit:
{
  InitUser(1);

  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;
}


cmCheckField:
{
  PodrPubCheck;
  RedrawPanel(#Zar_User);
}//cmCheckField

cmPick:
{
  PodrPubPick;
  RedrawPanel(#Zar_User);
}

cmOk:
{
  _PodrMArkerPointer := CLSF.LoadFullCurrentDepartmentList;

  update current Zar_User;

  if not FillMarks then
  {
    abort;
    exit;
  }

  IncTMP;

  CloseInterface(cmClose);

}
end;

end;

function ItogObsh(Nom:word): longint;
{
  ItogObsh := 0;

  _loop Tmp_WinPlanOtpuskItog
  {

    if Tmp_WinPlanOtpuskItog.Prizn != 0
      continue;

    if GetMarkerCount(_PodrMArkerPointer) > 0 and Not Foundmarker(_PodrMArkerPointer, Tmp_WinPlanOtpuskItog.Cex)
      continue;

    Case Nom of
    1: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[1];
    2: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[2];
    3: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[3];
    4: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[4];
    5: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[5];
    6: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[6];
    7: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[7];
    8: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[8];
    9: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[9];
    10: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[10];
    11: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[11];
    12: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[12];
    13: ItogObsh += Tmp_WinPlanOtpuskItog.wDay   ;
    14: ItogObsh += Tmp_WinPlanOtpuskItog.wDayDop;
    15: ItogObsh += Tmp_WinPlanOtpuskItog.Mon[1] +
                    Tmp_WinPlanOtpuskItog.Mon[2] +
                    Tmp_WinPlanOtpuskItog.Mon[3] +
                    Tmp_WinPlanOtpuskItog.Mon[4] +
                    Tmp_WinPlanOtpuskItog.Mon[5] +
                    Tmp_WinPlanOtpuskItog.Mon[6] +
                    Tmp_WinPlanOtpuskItog.Mon[7] +
                    Tmp_WinPlanOtpuskItog.Mon[8] +
                    Tmp_WinPlanOtpuskItog.Mon[9] +
                    Tmp_WinPlanOtpuskItog.Mon[10] +
                    Tmp_WinPlanOtpuskItog.Mon[11] +
                    Tmp_WinPlanOtpuskItog.Mon[12];
    end;
  }

}

