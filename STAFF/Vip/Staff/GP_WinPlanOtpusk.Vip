  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки
  xlSetCellStringValue('Дней, июль',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки
  xlSetCellStringValue('Дней, август',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки
  xlSetCellStringValue('Дней, сентябрь',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки
  xlSetCellStringValue('Дней, октябрь',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки
  xlSetCellStringValue('Дней, ноябрь',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки
  xlSetCellStringValue('Дней, декабрь',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetCellStringValue('Остаток',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetFontStyle(xlBold, CurRow, 1, CurRow, NumCol);
  xlAlignCellsEx(xlCenter,xlTop, CurRow, 1, CurRow, NumCol); //текст в ячейке по центру

  _Loop Tmp_WinPlanOtpusk
  {

    nextvisual;

    Numcol:=0;

    xlSetCellStringValue(Tmp_WinPlanOtpusk.FIO                            , ++CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(Tmp_WinPlanOtpusk.TabN                           , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(iCatFunc.GetCatalogsName(Tmp_WinPlanOtpusk.Post) , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(iCatFunc.GetCatalogsCode(Tmp_WinPlanOtpusk.Dep)  , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(sPrizn                                           , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(Utver                                            , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(Tmp_WinPlanOtpusk.Prich                          , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(iStrFunc.UnVisibleDate(Tmp_WinPlanOtpusk.DisD, 'DD.MM.YYYY')                           , CurRow, ++NumCol, CurRow, NumCol);

    xlSetCellStringValue(Tmp_WinPlanOtpusk.OtpUxod                                     , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.wDay   !=0,Tmp_WinPlanOtpusk.wDay   ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.wDayDop!=0,Tmp_WinPlanOtpusk.wDayDop,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[1] !=0,Tmp_WinPlanOtpusk.Mon[1] ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[2] !=0,Tmp_WinPlanOtpusk.Mon[2] ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[3] !=0,Tmp_WinPlanOtpusk.Mon[3] ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[4] !=0,Tmp_WinPlanOtpusk.Mon[4] ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[5] !=0,Tmp_WinPlanOtpusk.Mon[5] ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[6] !=0,Tmp_WinPlanOtpusk.Mon[6] ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[7] !=0,Tmp_WinPlanOtpusk.Mon[7] ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[8] !=0,Tmp_WinPlanOtpusk.Mon[8] ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[9] !=0,Tmp_WinPlanOtpusk.Mon[9] ,'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[10]!=0,Tmp_WinPlanOtpusk.Mon[10],'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[11]!=0,Tmp_WinPlanOtpusk.Mon[11],'') , CurRow, ++NumCol, CurRow, NumCol);
    xlSetCellStringValue(if(Tmp_WinPlanOtpusk.Mon[12]!=0,Tmp_WinPlanOtpusk.Mon[12],'') , CurRow, ++NumCol, CurRow, NumCol);

    xlSetCellStringValue(if((Tmp_WinPlanOtpusk.wDay+   
    Tmp_WinPlanOtpusk.wDayDop)
    -(Tmp_WinPlanOtpusk.Mon[1] 
    +Tmp_WinPlanOtpusk.Mon[2] 
    +Tmp_WinPlanOtpusk.Mon[3] 
    +Tmp_WinPlanOtpusk.Mon[4] 
    +Tmp_WinPlanOtpusk.Mon[5] 
    +Tmp_WinPlanOtpusk.Mon[6] 
    +Tmp_WinPlanOtpusk.Mon[7] 
    +Tmp_WinPlanOtpusk.Mon[8] 
    +Tmp_WinPlanOtpusk.Mon[9] 
    +Tmp_WinPlanOtpusk.Mon[10]
    +Tmp_WinPlanOtpusk.Mon[11]
    +Tmp_WinPlanOtpusk.Mon[12])!=0,

    (Tmp_WinPlanOtpusk.wDay+   
    Tmp_WinPlanOtpusk.wDayDop)
    -(Tmp_WinPlanOtpusk.Mon[1] 
    +Tmp_WinPlanOtpusk.Mon[2] 
    +Tmp_WinPlanOtpusk.Mon[3] 
    +Tmp_WinPlanOtpusk.Mon[4] 
    +Tmp_WinPlanOtpusk.Mon[5] 
    +Tmp_WinPlanOtpusk.Mon[6] 
    +Tmp_WinPlanOtpusk.Mon[7] 
    +Tmp_WinPlanOtpusk.Mon[8] 
    +Tmp_WinPlanOtpusk.Mon[9] 
    +Tmp_WinPlanOtpusk.Mon[10]
    +Tmp_WinPlanOtpusk.Mon[11]
    +Tmp_WinPlanOtpusk.Mon[12]),'')                                           , CurRow, ++NumCol, CurRow, NumCol);

  }

  Numcol:=0;
  xlSetCellStringValue('Итого дней'                            , ++CurRow, ++NumCol, CurRow, NumCol);
  xlMergeCells(CurRow, NumCol, CurRow, 11); // об]единение ячеек
  Numcol:=11;
  xlSetCellStringValue(if(ItogObsh(1) !=0,ItogObsh(1) ,'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(2) !=0,ItogObsh(2) ,'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(3) !=0,ItogObsh(3) ,'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(4) !=0,ItogObsh(4) ,'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(5) !=0,ItogObsh(5) ,'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(6) !=0,ItogObsh(6) ,'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(7) !=0,ItogObsh(7) ,'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(8) !=0,ItogObsh(8) ,'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(9) !=0,ItogObsh(9) ,'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(10)!=0,ItogObsh(10),'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(11)!=0,ItogObsh(11),'')                          , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(12)!=0,ItogObsh(12),'')                          , CurRow, ++NumCol, CurRow, NumCol);

  NumCol++;

  xlSetFontStyle(xlBold, CurRow, 1, CurRow, NumCol);

  Numcol:=0;
  xlSetCellStringValue('Итого %'                            , ++CurRow, ++NumCol, CurRow, NumCol);
  xlMergeCells(CurRow, NumCol, CurRow, 11); // об]единение ячеек
  Numcol:=11;
  xlSetCellStringValue(if(ItogObsh(1)/ItogObsh(15)*100 !=0,ItogObsh(1)/ItogObsh(15)*100 ,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(2)/ItogObsh(15)*100 !=0,ItogObsh(2)/ItogObsh(15)*100 ,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(3)/ItogObsh(15)*100 !=0,ItogObsh(3)/ItogObsh(15)*100 ,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(4)/ItogObsh(15)*100 !=0,ItogObsh(4)/ItogObsh(15)*100 ,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(5)/ItogObsh(15)*100 !=0,ItogObsh(5)/ItogObsh(15)*100 ,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(6)/ItogObsh(15)*100 !=0,ItogObsh(6)/ItogObsh(15)*100 ,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(7)/ItogObsh(15)*100 !=0,ItogObsh(7)/ItogObsh(15)*100 ,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(8)/ItogObsh(15)*100 !=0,ItogObsh(8)/ItogObsh(15)*100 ,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(9)/ItogObsh(15)*100 !=0,ItogObsh(9)/ItogObsh(15)*100 ,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(10)/ItogObsh(15)*100!=0,ItogObsh(10)/ItogObsh(15)*100,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(11)/ItogObsh(15)*100!=0,ItogObsh(11)/ItogObsh(15)*100,'') , CurRow, ++NumCol, CurRow, NumCol);
  xlSetCellStringValue(if(ItogObsh(12)/ItogObsh(15)*100!=0,ItogObsh(12)/ItogObsh(15)*100,'') , CurRow, ++NumCol, CurRow, NumCol);

  NumCol++;

  xlSetFontStyle(xlBold, CurRow, 1, CurRow, NumCol);

  xlWrapText(2, 1, CurRow, Numcol);//перенос по словам
  xlFrameCells(xlBorderL + xlBorderR + xlBorderT + xlBorderB + xlInsideV + xlInsideH,
                          xlThin, xlContinuous, 0, 2, 1, CurRow, Numcol);//рамка xlThick - жирная

  xlKillExcel;

  StopVisual('', 0);
}
