cmPrintDoc:
{
var CurRow:longint = 1;
var NumCol:longint = 1;

  StartNewVisual(vtIndicatorVisual, vfTimer, ''#3'Идет выгрузка данных в отчет', RecordsInTable(#Tmp_WinPlanOtpusk));

  xlCreateExcel('Плановые отпуска',true);

  xlSetCellStringValue('Плановые отпуска на '+wYearPlanVac+' год', 1, 1, 1, 1);
  xlSetFontStyle(xlBold, 1, 1, 1, 1);
  xlSetFontSize(18, 1, 1, 1, 1);

  xlSetCellStringValue('Фамилия имя отчество',++CurRow , Numcol, CurRow, Numcol);
  xlSetColumnWidth(40, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetCellStringValue('Табельный номер',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(12, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetCellStringValue('Должность',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(20, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

