  Fields
    [ItogLeto] (ItogObsh(5)+ItogObsh(6)+ItogObsh(7)+ItogObsh(8)+ItogObsh(9))/(ItogObsh(15))*100 ('Итого летние месяцы',,sci1Esc): Protect,{Font = {color = if(ItogLeto>=55, ColorErrorRec, 0);bold = true}};
  
