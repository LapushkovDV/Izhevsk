  cmValue1 , default,,, hcOkHelp     , scGalDial;
  cmValue2 ,        ,,, hcOkHelp     , scGalDial;
  cmValue9 ,        ,,, hcOkHelp     , scGalDial;
  cmValue7 ,        ,,, hcOkHelp     , scGalDial;
  cmValue10 ,       ,,, hcOkHelp     , scGalDial;
  cmValue6 ,        ,,, hcOkHelp     , scGalDial;
