  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetCellStringValue('Отпусков основных',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetCellStringValue('Отпусков дополнительных',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetCellStringValue('Дней, январь',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки
