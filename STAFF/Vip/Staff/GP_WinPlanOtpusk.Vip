  xlSetColumnWidth(12, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetCellStringValue('Вид назначения',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(5, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetCellStringValue('Состояние отпуска',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(15, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

  xlSetCellStringValue('Причина отказа',CurRow , ++Numcol, CurRow, Numcol);
  xlSetColumnWidth(10, CurRow, Numcol, CurRow, Numcol); //ширина ячейки

