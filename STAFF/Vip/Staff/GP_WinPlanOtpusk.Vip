      ,{Font = {backcolor = if(Tmp_WinPlanOtpusk.AppD>date(Last_Day(Date(1,9,wYearPlanVac)),9,wYearPlanVac),ColorSysBlack,if(Tmp_WinPlanOtpusk.Mon[9]!=0, if(Tmp_WinPlanOtpusk.MonFact[9],ColorSysFuchsia,ColorSysYellow), 0)); bold = true}};                     
    Tmp_WinPlanOtpusk.Mon[10]   'Октябрь,'#13'дней' ('Дней, октябрь')           :[5], Protect
      ,{Font = {backcolor = if(Tmp_WinPlanOtpusk.AppD>date(Last_Day(Date(1,10,wYearPlanVac)),10,wYearPlanVac),ColorSysBlack,if(Tmp_WinPlanOtpusk.Mon[10]!=0, if(Tmp_WinPlanOtpusk.MonFact[10],ColorSysFuchsia,ColorSysYellow), 0)); bold = true}};                       
    Tmp_WinPlanOtpusk.Mon[11]   'Ноябрь,'#13'дней' ('Дней, ноябрь')             :[5], Protect
      ,{Font = {backcolor = if(Tmp_WinPlanOtpusk.AppD>date(Last_Day(Date(1,11,wYearPlanVac)),11,wYearPlanVac),ColorSysBlack,if(Tmp_WinPlanOtpusk.Mon[11]!=0, if(Tmp_WinPlanOtpusk.MonFact[11],ColorSysFuchsia,ColorSysYellow), 0)); bold = true}};                         
