/*************************************************************************************************\
* Наименование: Изменение пунктов меню для типовых форм Т12, Т13                                  *
* Контур/Модуль: Табельный учет                                                                   *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |2069          |28/03/18|Евдокимов М.А.           |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_WT"

//Интерфейс вызывается в точке расширения при входе в персонал, зарплату, табельный учет
//Устанавливает видимость пунктов меню. Добавляем корректировки пунктов меню для форм Т12, Т13
alter interface MENUVISIBLE;
handleevent
cmInit:
{
  inherited::handleevent(cmInit);
  if StartMenu = 'MENU_STAFFMAINMENU' or StartMenu = 'MENU_TABEL'
  {
    cfsSetProp('M_cmRunInterface(Z_WT::VEDT12(0))#1', cfpVisible, false);
    cfsSetProp('M_cmRunInterface(Z_WT::PRINTT13)#1', cfpTitle, 'Типовые формы Т1~2~, Т13');
  }
}
end;
end.
