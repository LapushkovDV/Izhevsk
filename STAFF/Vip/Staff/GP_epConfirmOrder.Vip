#include DeclarePointsOrders.VIH
#include GP_Order_Email.Vih
handler with replace GP_epConfirmOrder_Email on ExtensionPoint epConfirmOrder (
  NrecTitleDoc : Comp)
Action
{  Timelog_Init;
   timelog('GP_epConfirmOrder_Email:NrecTitleDoc='+string(NrecTitleDoc));
   var pGP_Order_Email:GP_Order_Email;
   pGP_Order_Email.SendOrder(NrecTitleDoc);
   Result := true;
}
