/*************************************************************************************************\
* Наименование: Приказ на совмещение \ внутреннее совместительство (РПД-4)                        *
* Контур/Модуль: Кадры                                                                            *
* Примечание: Глючит печать - не находится ContDoc, но не всегда                                  *
*            cTitleDoc    == TitleDoc.Nrec     and                                                *
*         PartDoc.Nrec   == ContDoc.cPart     and                                                 *
*      PartDoc.TypeOper  == ContDoc.TypeOper  and                                                 *
*                 1      == ContDoc.SeqNmb    and                                                 *
*               PersNrec == ContDoc.Person    and                                                 *
*             OldAppNrec == ContDoc.cStr(NoIndex)and                                              *
*                                                                                                 *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#345          |14/07/17|Кузьмин П.Ю.             |НПО Энергомаш                    *
* Доработка   |#1195         |26/10/17|Кузьмин П.Ю.             |НПО Энергомаш                    *
* Доработка   |#1358         |04/12/17|Кузьмин П.Ю.             |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_STAFFORDERS"
Alter interface NFORMT5_2004;
OverLoad
procedure RunReportT5_Base(_PersNrec: comp; _NewAppNrec: comp; typeReports: word; _OldAppNrec: comp; _isFR: boolean);
Procedure ReportT5sovm;
end;

//Не передается ContDoc.Nrec
Procedure ReportT5sovm;
var boPrint:boolean;
{ //000000001004F10Ah

  if getfirst PArtDoc<>tsok
  { timelog('NFORMT5_2004->ReportT5sovm нет Partdoc');

  }
  boPrint:=false;
  _Loop PartDoc
  { timelog('NFORMT5_2004->ReportT5sovm Partdoc.Nrec='+String(Partdoc.Nrec,0,0)+', TitleDoc.Nrec='+String(TitleDoc.Nrec,0,0));
    _Loop ContDoc
    { timelog('NFORMT5_2004->ReportT5sovm  Contdoc.Nrec='+String(Contdoc.Nrec,0,0));
      boPrint:=True;
    }
  }
  if not boPrint
  { timelog('NFORMT5_2004->ReportT5sovm не нашли Contdoc');
    if getfirst PArtDoc<>tsok {}
    if getfirst ContDoc<>tsok
    { if IsValidAll(#NewApp)
      if NewApp.Nrec>0
      if getfirst ContDoc where (( NewApp.cCont == ContDoc.Nrec )) =tsok
      { timelog('NFORMT5_2004->ReportT5sovm нашли Contdoc но назначению');
      }

    }
  }
  Inherited::ReportT5sovm;
}
procedure RunReportT5_Base(_PersNrec: comp; _NewAppNrec: comp; typeReports: word; _OldAppNrec: comp; _isFR: boolean);
{ timelog_Init;
  timelog('NFORMT5_2004-RunReportT5_Base '
   +'_PersNrec='+string(_PersNrec,0,0)+', _NewAppNrec='+string(_NewAppNrec,0,0)
   +', typeReports='+string(typeReports)+', _OldAppNrec='+string(_OldAppNrec,0,0)+', _isFR='+string(_isFR)
   ) ;
  Inherited::RunReportT5_Base(_PersNrec,_NewAppNrec, typeReports, _OldAppNrec, _isFR);

}
end.
