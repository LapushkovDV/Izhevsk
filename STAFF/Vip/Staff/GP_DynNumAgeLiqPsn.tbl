table struct ttRepPeriod
(
  nRec        : comp,
  sNamePeriod : string,
  sSortPeriod : string,
  dBegPeriod  : date,
  dEndPeriod  : date
)
with index
(
  ttRepPeriod00 = nRec(Surrogate),
  ttRepPeriodRepSort = sSortPeriod
);

table struct ttTypePodr
(
  nRec          : comp,
//  cRecPodr      : comp,
  sNameTypePodr : string,
  sSortTypePodr : string,
  sNumTypePodr  : string
)
with index
(
  ttTypePodr00      = nRec(Surrogate),
//  ttTypePodr01      = cRecPodr,
  ttTypePodrRepSort = sSortTypePodr
);

table struct ttPodr
(
  nRec      : comp,
  cTypePodr : comp,
  cnRecPodr : comp,
  sTypePodr : string,
  sNamePodr : string,
  sSortPodr : string
)
with index
(
  ttPodr00      = nRec(Surrogate),
  ttPodr01      = cnRecPodr,
  ttPodrRepSort = cTypePodr + sSortPodr
);

table struct ttEmplKat
(
  nRec     : comp,
  cTypePodr: comp,
  cPodr    : comp,
  cnRecEmpl: comp,
  sNameKat : string,
  iSortKat : integer
)
with index
(
  ttEmplKat00 = nRec(Surrogate),
  ttEmplKat01 = cTypePodr + cPodr + cnRecEmpl,
  ttEmplKatRepSort1 = cTypePodr + cPodr + iSortKat,
  ttEmplKatRepSort2 = cTypePodr + iSortKat
);

table struct ttRepData
(
  nRec       : comp,
  cTypePodr  : comp,
  cPodr      : comp,
  cEmplKat   : comp,
  cRepPeriod : comp,
 // 0 - данные строк по категориям 
 // 1 - итоги по типам подр. за период
 // 2 - итоги по подр. за период
 // 3 - итоги по предпр. за период
 // 4,5,6,7,8 - итог по возраст. группам за период
  wTypeData  : word,
  lStavPlan  : longint,
  lStavFact  : longint,
  lStavAge   : longint,
  lStavDiss  : longint
)
with index
(
  ttRepInpData00      = nRec(Surrogate),
  ttRepInpDataRepSort1= cTypePodr  + cPodr      + cEmplKat + cRepPeriod + wTypeData,
  ttRepInpDataRepSort2= cTypePodr  + cEmplKat + cRepPeriod + wTypeData,
  ttRepInpDataItogType= cTypePodr  + cRepPeriod + wTypeData,
  ttRepInpDataItogPodr= cPodr      + cRepPeriod + wTypeData,
  ttRepInpDataItogTot = cRepPeriod + wTypeData,
  ttRepInpTypePodrChek= cTypePodr  + wTypeData,
  ttRepInpPodrChek    = cPodr      + wTypeData,
  ttRepInpEmplKatChek = cEmplKat   + wTypeData
);

table struct ttLog
(
  nRec   : comp,
  cRecDep: comp,
  sAddInf: string,
  sMode  : string,
  sReason: string
)
with index
(
  ttLog00 = nRec(Surrogate),
  ttLogSort = sMode + sAddInf,
  ttLogDep  = sMode + cRecDep
);

table struct ttRash // for sort
(
  sCodPodr : string
 ,sNamePodr: string
 ,sCodZGD  : string
 ,sNameZGD : string
 ,sVidPro  : string
)
with index
(
//  ttRKRash01 = sTKat + sKat + sFio
  ttRash01 = sCodZGD + sCodPodr
)
;

table struct ttZGD
(
  cRecDept : comp
, sCodeZGD : string
, sNameZGD : string
)
with index
(
  ttZGD01 = cRecDept
);
