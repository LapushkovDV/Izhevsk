//#endregion Перекрытые методы
//******************************************************************************

//******************************************************************************
// HandleEvent главного интерфейса
//******************************************************************************

handleEvent


    cmInit:
    {
      boIfAccess_NoMes:=if(DocNRec>0,false,true);
      case inherited :: handleEvent (cmInit) of
       heAbort:{abort;exit;}
       heStop:{stop;exit;}
      end;
      boIfAccess_NoMes:=false;
    }
    // актуализация состояния тулбара (событий) при перемещении по записям таблицы
    cmPositionChanged:
    { boIfAccess_NoMes:=true;
      inherited :: handleEvent (cmPositionChanged);
      boIfAccess_NoMes:=false;
    }
    /*cmHotKeys:
    {
      //Проверяем, разрешено ли данному пользователю утверждать приказ
      if IsNeedToDisable
        EnableCommand(cmLegend);
      else
        DisableCommand(cmLegend);
      inherited::handleEvent(cmHotKeys);

    }  */

    cmValue34: //Пункт локального меню Создание сводного приказа на работу в вых. дни
    {
//  20210929 lapushkovdv объект теперь на пометке стоит в приказах
      var PrMarkers: TPtr = InitMarker('', 8, 100, 100);
      pMarker.ExportTo(PrMarkers);

      if UpdateTable
      {
        var titledocNrec: comp = 0;
        case message('Сформировать новый приказ?'#13'' +
                     '[Да]     - сформировать новый приказ'#13'' +
                     '[Нет]    - заполнить текущий приказ'#13'' +
                     '[Отмена] - прервать формирование приказа', mfYesNoCancel) of
          cmYes: titledocNrec := 0;
          cmNo:
          {
            if tmpTitleDoc.wStatus != 0
            {
              Message('Запрещено добавлять позиции в утвержденный приказ', error);
              exit;
            }

            var isRPD90Found: boolean = false;
            PushPos(#PartDoc);
            _loop PartDoc
              isRPD90Found := isRPD90Found or (PartDoc.TypeOper = 90);
            PopPos(#PartDoc);
            if not isRPD90Found
            {
              Message('Текущий документ не является приказом на работу в выходные и праздничные дни'#13'' +
                      'Установите курсор на приказ на работу в выходные и праздничные дни'#13'' +
                      'и повторите операцию', error);
              exit;
            }

            titledocNrec := tmpTitleDoc.Nrec;
          }
          else exit;
        end;

        var p: IAtlProtocol;
        p := IAtlProtocol(new(AtlProtocol, Init));

        p.Clear;
        p.Visible := true;
        p.AutoFlush := true;

        p.LogStartVisual(if(titledocNrec = 0, 'Формирование приказа', 'Заполнение приказа'), 0);

        var newTitleDocNrec: comp;
        newTitleDocNrec := _rpd90Helper.CreateStaffOrderByClaims(PrMarkers, titleDocNrec, p);

        p.LogStopVisual;
        p.Refresh;

        if getfirst tmpTitleDoc where ((newTitleDocNrec == TmpTitleDoc.nRec)) != tsOk
          if GetFirst FastFirstRow TitleDocnmb where ((newTitleDocNrec == TitleDocNmb.nRec)) = tsOk
          {
            ClearBuffer(tntmpTitleDoc);
            tmpTitleDoc.nRec        := newTitleDocNrec;
            tmpTitleDoc.DocNmb      := TitleDocNmb.DocNmb;
            tmpTitleDoc.DocText     := TitleDocNmb.DocText;
            tmpTitleDoc.DocDate     := TitleDocNmb.DocDate;
            tmpTitleDoc.DocDateCopy := TitleDocNmb.DocDate;
            tmpTitleDoc.wStatus     := TitleDocNmb.wStatus;
            tmpTitleDoc.DocType     := TitleDocNmb.DocType;
            Insert Current tmpTitleDoc;
          }

        Delete All tmpTitleDocRab;
        if bUsePersTypePr or StandAccess
          FillFinalTmpTable(true)
        else
          FillFinalTmpTable(false);

        if getfirst tmpTitleDoc where ((newTitleDocNrec == TmpTitleDoc.nRec)) = tsOk
          ReReadRecord(tnTmpTitleDoc)

      }

    }

    cmDone:
    {
      DoneMarker(_disabledPartDocMarker, '');
      inherited::HandleEvent(cmDone);
    }

    cmExprFieldChanged:
    {
      case inherited :: handleEvent (cmExprFieldChanged) of
       heAbort:{abort;exit;}
       heStop:{stop;exit;}
      end;

      case curfield of
      #sCommentariy:
      {
        sSetAttr(coTitleDoc, TitleDoc.Nrec, 'Комментарий', ExprFieldValue);
      }
      end;
    }

end;
end.

#include GP_MenuDynamic.vih
//Добавление пунктов контекстного меню в интерфейсе списка приказов по персоналу
handler with replace GP_MenuDynamic_AddItems_OrdersList on ExtensionPoint GP_MenuDynamic_AddItems
action
{
  result := true;
  timelog('GP_MenuDynamic_AddItems_OrdersList:start');
  DeleteMenuHowDynamics('Z_StaffOrders::prikaz_hotkey');

  var MenuID, NewMenuId: longint = 0;
  _try
  {
    MenuID := LoadMenu('Z_StaffOrders::prikaz_hotkey', false);
    if (not ConcatMenu(MenuId, LoadMenu('Z_StaffOrders::GP_OrdersList', false)))
    {
      timelog('ошибка добавления Z_StaffOrders::GP_OrdersList ');
      _raise ExAddMenuItemError;
    }
    if (not StoreMenuHowDynamics(MenuID,'Z_StaffOrders::prikaz_hotkey'))
    {
      timelog('ошибка сохранения Z_StaffOrders::prikaz_hotkey ');
      _raise ExAddMenuItemError;
    }
  }
  _except
    on ExVip:
      message('Ошибка регистрации контекстного меню в списке приказов по персоналу'#13 + ExploreException, error);
  _finally
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  timelog('GP_MenuDynamic_AddItems_OrdersList:finish');
}

GP_OrdersList menu
{
  - 'Создание сводного приказа на работу в вых. дни', cmValue34, 'Сформировать сводный приказ на работу в выходные и праздничные дни по заявкам', hcNoContest, '',,,,;
}
