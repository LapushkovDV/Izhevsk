//******************************************************************************
// Главная вьюха
//******************************************************************************
Create view OrdersList
as select
  sGetAttr(coTitleDoc, TitleDoc.Nrec, 'Комментарий') (FieldName = sCommentariy)
  from ServStav
  where ((
      PartDocPrav.TypeOper == ServStav.wTblCode
  and pUserID    == ServStav.cUnit
  and longint(1) == ServStav.FilialNo(NoIndex)
  ));

  //Возвращает истину если пользователю запрещено утверждать текущий приказ
  function IsNeedToDisable: Boolean;
  {
    result := false;
    if wGetTune('UP.STAFF.COMMONRULES.APPROVE_ORDERS') = 1
      if getfirst PartDocPrav where ((TitleDoc.nRec == PartDocPrav.cDoc
         and 20 == PartDocPrav.TypeOper(noindex) )) = tsOk
        result := true;
     if bUsePersTypePr
     _Loop PartDocPrav where ((TitleDoc.nRec == PartDocPrav.cDoc ))
     { if getfirst ServStav where
        (( PartDocPrav.TypeOper == ServStav.wTblCode
        and pUserID    == ServStav.cUnit
        and longint(1) == ServStav.FilialNo(NoIndex)
         ))<>tsok
       { Result:=true;
         exit;
       }
       if (longint(ServStav.cServ) and 32)<>0
       { Result:=true;
         exit;
       }
     } //_Loop PartDocPrav where ((TitleDoc.nRec == PartDocPrav.cDoc
  } //function IsNeedToDisable: Boolean;


ExtendFormats BRWDOC;
Browse BRWDOC;
Table TMPTITLEDOC;
Fields
  sTXOGetField('X$USERS','XU$FULLNAME',TITLEDOC.ATL_OWNER) 'Создал приказ' (,,sci13Esc):[20],Protect,NoPickButton;
  sCommentariy 'Комментарий' (,,sci13Esc):[20],Protect,NoPickButton;
end;

 // extendformats  EDITTITLE;



