ExtendFormats EditTitle;
Window WhatIsInOrder;

Screen EditTitle;
Fields
sCommentariy : noProtect, noPickButton;
<<




 `Комментарий`       .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;
