#include xlReport.vih
#include DeptIer.vih // получить всякие свойства по записи таблицы Catalogs
#include History.vih
#include odecl.vih        // Функции склонения ФИО

Interface iEMWithdrawVacationReport 'Приказ об отзыве сотрудника из отпуска'  escclose, cyan, doaccept;
  Show at (, , 60, 8);
//*****************************************************************************
#include History.var
//*****************************************************************************
Create view
var
  sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol
, sPodpis1Npp
, sPodpis2Npp            : string;

  EnhancedTimeFormat : boolean;

  wShowFirstPage 
, wCountry           : word;

  sNumDoc
, dDateDoc
, ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;

  dBeg
, dEnd               : date;

  cTitleDoc
, PersNrec           : comp; 

as select
  if ((Appointments.lPrizn = 0),  
       GetStrTabN(Persons.TabNmb, Persons.StrTabN), 
       GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN))
    (fieldname = fAppTabN)
, 7
    (FieldName = wType)
, 'Em_Report_' + string(wType)
    (FieldName = nameNastr)
, *
from 
  TitleDoc
, PartDoc
, ContDoc
, Persons
, ExClassVal
, ExClassSeg
, Appointments
, tmpWithdrawVac
, KatOrg
, OtpOtz
, AllVacCon (ALLVACCON05)
, KlOtpusk    AllVacFO_KlOtpusk
, KlOtpusk    AllVacKlOtpusk
, FactOtpusk  AllVacFactOtpusk
where
((
    cTitleDoc                ==  TitleDoc.NRec
AND TitleDoc.NRec            ==  PartDoc.cDoc
AND 25045                    ==  ExClassVal.wTable
AND ContDoc.NRec             ==  ExClassVal.cRec
AND ExClassVal.cClassSeg     ==  ExClassSeg.NRec
AND ContDoc.Person           ==  Persons.NRec
AND ContDoc.cStr             ==  Appointments.NRec

AND ContDoc.ObjNrec          == OtpOtz.Nrec
AND                     0    == AllVacCon.wTable
AND                     0    == AllVacCon.cTable
AND OtpOtz.nRec              == AllVacCon.cOtpOtz
AND AllVacCon.resword[1]     == AllVacKlOtpusk.KOtpus

AND ContDoc.cNew1            == AllVacFactOtpusk.NRec
AND AllVacFactOtpusk.VacType == AllVacFO_KlOtpusk.KOtpus
))

bounds byPersNrec =
    PersNrec                ==  ContDoc.Person
AND PartDoc.Nrec            ==  ContDoc.cPart
AND 1                       ==  ContDoc.Seqnmb


bounds byTitleDoc =
    tmpWithdrawVac.cContDoc ==  ContDoc.NRec

;

Parameters
  sNumDoc
, dDateDoc
, cTitleDoc
, PersNrec
;
//*****************************************************************************
var IDepartIer : DepartIer; // иерархия подразделений
var iOdecl     : declension;  // Переменная типа интерфейс declension
//*****************************************************************************
function GetFIO(sFio : string; bFirstF : boolean) : string;
{
  var   str, str2 : string;

  sFio := Trim(sFio);
  str  := sFio;
  str2 := '';

  if (InStr(' ', sFio) <> 0)
    {
       sFio := SubStr(sFio, 1, InStr(' ', sFio) - 1);
       str  := Trim(SubStr(str, InStr(' ', str) + 1, Length(str) - InStr(' ', str)));

       if (InStr(' ', str) <> 0)
         {
           str2 := SubStr(str, 1, 1) + '.';

           if (InStr(' ', str) <> 0)
             {
               str  := Trim(SubStr(str, InStr(' ', str) + 1, Length(str) - InStr(' ', str)));
               str2 := str2 + ' ' + SubStr(str, 1, 1) + '.';
             }
         }
       else
         str2 := str;

       if (bFirstF)
         str := sFio + ' ' + str2;
       else
         str := str2 + ' ' + sFio;
    }

  GetFIO := str;
}

//*****************************************************************************
Procedure PrintRepost;
{
  ID := 'WithdrawVacation';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpWithdrawVac));

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'           , CommonFormHeader);

  pXL.SetStringVar('org'           , oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', Cur_Date));
  if (GetFirst KatOrg where ((coGetTune('MyOrg') == KatOrg.NRec)) = tsOk)
    pXL.SetStringVar('OKPO'        , '''' + KatOrg.Okpo);

  pXL.SetStringVar('SoglFIO'       , sSogls);
  pXL.SetStringVar('SoglDol'       , sSoglsDol);
  pXL.SetStringVar('Sogl2FIO'      , sSogls2);
  pXL.SetStringVar('Sogl2Dol'      , sSogls2Dol);
  pXL.SetStringVar('UtvrFIO'       , sUtve);
  pXL.SetStringVar('UtvrDol'       , sUtveDol);
  pXL.SetStringVar('sPodpis1FIO'   , sPodpis1);
  pXL.SetStringVar('sPodpis1Dol'   , sPodpis1Dol);
  pXL.SetStringVar('sPodpis2FIO'   , sPodpis2);
  pXL.SetStringVar('sPodpis2Dol'   , sPodpis2Dol);

  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('WithdrawVacation');
  pXL.CreateTblFld('cause'       );
  pXL.CreateTblFld('cause2'      );
  pXL.CreateTblFld('NameVacation');
  pXL.CreateTblFld('FIO'         );
  pXL.CreateTblFld('Dol'         );
  pXL.CreateTblFld('Podr'        );
  pXL.CreateTblFld('DateWithdraw');
  pXL.CreateTblFld('dBeg'        );
  pXL.CreateTblFld('dEnd'        );
  pXL.CreateTblFld('NumDoc'      );
  pXL.CreateTblFld('DateDoc'     );
  pXL.CreateTblFld('TitleDoc'    );
  pXL.CreateTblFld('Text'        );
  pXL.CreateTblFld('FIOI'        );

  _LOOP tmpWithdrawVac
    {
      pXL.ClearTblBuffer;

      if (GetFirst TitleDoc = tsOk) 
        if (GetFirst PartDoc = tsOk)
          if (GetFirst ContDoc = tsOk)
            if (GetFirst ExClassVal = tsOk)
              if (GetFirst ExClassSeg = tsOk)
                {
                  pXL.SetTblStringFldValue('cause2', EXCLASSSEG.NAME);
                }

     var sCase : string;
     if (NOT ReadMyDsk(sCase, nameNastr + '_sCase', true))
       sCase := '';

     pXL.SetTblStringFldValue('cause' , sCase);

     if (trim(tmpWithdrawVac.NameVacation) = '')
       if (GetFirst OtpOtz = tsOk)
         if (GetFirst AllVacCon = tsOk)
           set tmpWithdrawVac.NameVacation := if (ContDoc.wAttrDoc3 = 0, AllVacKlOtpusk.NOtpus, 
                      'Пакет отпусков: ' + AllVacFO_KlOtpusk.NOtpus);

      pXL.SetTblStringFldValue('NameVacation'  , tmpWithdrawVac.NameVacation);
      pXL.SetTblStringFldValue('FIO'           , tmpWithdrawVac.FIO         );
      pXL.SetTblStringFldValue('Dol'           , tmpWithdrawVac.Dol         );
      pXL.SetTblStringFldValue('Podr'          , tmpWithdrawVac.Podr        );

      if (tmpWithdrawVac.DateWithdraw <> ZeroDate)
        pXL.SetTblStringFldValue('DateWithdraw'  , '''' + DateToStr(tmpWithdrawVac.DateWithdraw, 'DD.MM.YYYY'));

      if (tmpWithdrawVac.dBeg <> ZeroDate)
        pXL.SetTblStringFldValue('dBeg'          , '''' + DateToStr(tmpWithdrawVac.dBeg, 'DD.MM.YYYY'));

      if (tmpWithdrawVac.dEnd <> ZeroDate)
        pXL.SetTblStringFldValue('dEnd'          , '''' + DateToStr(tmpWithdrawVac.dEnd, 'DD.MM.YYYY'));

      pXL.SetTblStringFldValue('NumDoc'        , '''' + tmpWithdrawVac.NumDoc);

      if (tmpWithdrawVac.DateDoc <> ZeroDate)
        pXL.SetTblStringFldValue('DateDoc'       , '''' + DateToStr(tmpWithdrawVac.DateDoc, 'DD.MM.YYYY'));

      pXL.SetTblStringFldValue('TitleDoc'      , 'об отзыве из ' + iOdecl.FIODeclension(0, loCase(tmpWithdrawVac.NameVacation), 2));
      pXL.SetTblStringFldValue('Text'          , 'Отменить ' + tmpWithdrawVac.NameVacation
                                               + ' (' + tmpWithdrawVac.FIO + ', ' + tmpWithdrawVac.Dol + ', ' + tmpWithdrawVac.Podr
                                               + ') c ' + if (tmpWithdrawVac.dBeg <> ZeroDate, DateToStr(tmpWithdrawVac.dBeg, 'DD.MM.YYYY'), '') + ' по ' + if (tmpWithdrawVac.dEnd <> ZeroDate, DateToStr(tmpWithdrawVac.dEnd, 'DD.MM.YYYY'), '')
                                               + '(приказ от ' + if (tmpWithdrawVac.DateDoc <> ZeroDate, DateToStr(tmpWithdrawVac.DateDoc, 'DD.MM.YYYY'), '') + ' №' + tmpWithdrawVac.NumDoc + ')');

      if (GetFirst Persons = tsOk)
        pXL.SetTblStringFldValue('FIOI'          , GetFIO(Persons.FIO, false));

      pXL.InsTblRow;
    }

  pXL.PublishTbl('WithdrawVacation');

  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);
}

HandleEvent

cmInit: 
  {
    RunInterface(iEMGetNastrPodp, wType);

    if (NOT ReadMyDsk(sSogls     , nameNastr + '_sSogls', true))
      sSogls := '';

    if (NOT ReadMyDsk(sSoglsDol  , nameNastr + '_sSoglsDol', true))
      sSoglsDol := '';

    if (NOT ReadMyDsk(sSogls2    , nameNastr + '_sSogls2', true))
      sSogls2 := '';

    if (NOT ReadMyDsk(sSogls2Dol , nameNastr + '_sSogls2Dol', true))
      sSogls2Dol := '';

    if (NOT ReadMyDsk(sUtve      , nameNastr + '_sUtve', true))
      sUtve := '';

    if (NOT ReadMyDsk(sUtveDol   , nameNastr + '_sUtveDol', true))
      sUtveDol := '';

    if (NOT ReadMyDsk(sPodpis2   , nameNastr + '_sPodpis2', true))
      sPodpis2 := '';

    if (NOT ReadMyDsk(sPodpis2Dol, nameNastr + '_sPodpis2Dol', true))
      sPodpis2Dol := '';

    if (NOT ReadMyDsk(sPodpis2Npp, nameNastr + '_sPodpis2Npp', true))
      sPodpis2Npp := '';

    if (NOT ReadMyDsk(sPodpis1   , nameNastr + '_sPodpis1', true))
      sPodpis1 := '';

    if (NOT ReadMyDsk(sPodpis1Dol, nameNastr + '_sPodpis1Dol', true))
      sPodpis1Dol := '';

    if (NOT ReadMyDsk(sPodpis1Npp, nameNastr + '_sPodpis1Npp', true))
      sPodpis1Npp := '';

    PushBounds(if (PersNrec <> comp(0), tbbyPersNrec, tbbyTitleDoc));
    PrintRepost;
  }

end;
end.
