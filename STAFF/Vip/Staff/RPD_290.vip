#include RPD.vih
#include ShowEmbMemo.vih

#component "Z_StaffOrders"

#doc
РПД 290 - заявка на работу в выходные и праздничные. При утверждении приказа никаких изменений в БД
не выполняется. В точке расширения GP_epConfirmOrder_RPD290 реализована установка статуса 2 в утвержденном
приказе.
#end
vipinterface RPD_290(RPD_90);
public:
  function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
  function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
end;

interface RPD_290;
//ExtendFormats BrPart;
overloadformats BRPSN;
overloadformats scrFoundation;
overloadformats scrDet90;


function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
{
  cNrec := cNrec;
  result:= true; // нас никакие проверки не интересуют, просто утверждаем
}

function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{
  cNrec := cNrec;
  result := true;
}


screen scrPart (, hcStaffWinPr, sci1378Esc);
show at (,,,2) ;
Table PartDoc;
Fields
  PARTDOC.DDAT1 ('Дата выхода') : NoProtect,NoDel;

<<
 Дата выхода .@@@@@@@@@@@
>>
end;

browse brPsn  (, hcStaffWinPr, sci1378Esc);
show at (,3,,14) ;
table ContDoc;
fields
    fullNamePodr 'Подразделение' ('Подразделение', hcStaffWinPr, ): [25], protect;
    [Podr_Kod] iCatFunc.GetCatalogsCode(ContDoc.cDopRef) 'Код' ('Код Подразделения', hcStaffWinPr, ): [6], protect,NoDel;
    Persons.FIO    'ФИО' ('Фамилия имя отчество', hcStaffWinPr, ): [28], protect;
    Persons.StrTabn  'Табельный №' ('Табельный номер'): [12], skip;
    Catalogs.Name  'Должность'('Должность (из основного назначения или совмещения - для увольнения совместителей)' , hcStaffWinPr) :[15], skip;
end;

screen scrDet90 (,hcStaffWinPr, sci178Esc);  //Награждение/поощрение, премирование
//show at (, 5,,);
show at (, 15,,16) ;
<<
>>
end;

screen scrFoundation (,hcStaffWinPr, sci178Esc);  //Награждение/поощрение, премирование
//show at (, 5,,);
show at (, 17,,) ;
<<
>>
end;

TableEvent table PartDoc;
cmUpdateRecord:
{ if  inherited :: handleEvent (cmUpdateRecord)=heAbort then Abort;
  Update current PartDoc;
}
cmCheckField:
{
   if  inherited :: handleEvent (cmCheckField)=heAbort then Abort;
   Update current PartDoc;
}
end;//TableEvent table PartDoc



end.

#include DeclarePointsOrders.vih
#include Query.vih
//Утверждение приказа. Если утверждаемый приказ - это заявка на работу в вых. дни,
//он должен переводиться в статус 2, а не 1.
handler with replace GP_epConfirmOrder_RPD290 on ExtensionPoint epConfirmOrder (NrecTitleDoc: Comp)
Action
{
  //Получаем количество РПД утверждаемого приказа
  var rpdCount: word =
  queryManager.createQuery('select count(*) from PartDoc where cDoc = :NrecTitleDoc')
              .setParam('NrecTitleDoc', NrecTitleDoc)
              .getResultValue;
  //Получаем количество РПД290 утверждаемого приказа
  var rpd290Count: word =
  queryManager.createQuery('select count(*) from PartDoc where cDoc = :NrecTitleDoc and TypeOper = 290')
              .setParam('NrecTitleDoc', NrecTitleDoc)
              .getResultValue;
  //Если все РПД утверждаемого приказа = 290 - меняем статус приказа на 2 (Исполняется)
  if rpdCount > 0 and rpdCount = rpd290Count
  {
    queryManager.createQuery('update TitleDoc set wStatus = 2 where TitleDoc.Nrec = :NrecTitleDoc')
                .setParam('NrecTitleDoc', NrecTitleDoc)
                .Execute;
  }

  Result := true;
}
