//******************************************************************************
Alter Interface RPD_8 ('');
//******************************************************************************
OverLoad
function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
Procedure IRPD_Base.EnableDisable;
Procedure CheckDatesAndClose(_DisDate : date);
end;
var
  iGP_SCUD_PersEdit:GP_SCUD_PersEdit;//для работы с картотекой в СКУД
//------------------------------------------
create view vScud
var
  pPersons:comp;
  wMesN :word;
  wYearN: word;
from GP_SCUD_Saldo, GP_SCUD_Pers
where ((
     pPersons         == GP_SCUD_Pers.cPersons
and GP_SCUD_Pers.Nrec == GP_SCUD_SALDO.cGP_SCUD_Pers
and wYearN            == GP_SCUD_SALDO.YearN
and wMesN             == GP_SCUD_SALDO.MesN
));
//------------------------------------------


//--------------------------------------------
// Рассчитать кол-во дней остатка выходных
//--------------------------------------------
Function CalcDaysHoliday(_pPersons:comp;_DisDate:date):double; cacheable;
{ Result:=0;
  if _pPersons=0 then exit;
  vScud.pPersons:=_pPersons;
  if vScud.getfirst GP_Scud_Pers<>tsok then exit;
  vScud.wYearN:=year(_DisDate);//VDISDATE);
  vScud.wMesN :=month(_DisDate);
  if vScud.getfirst GP_SCUD_Saldo<>tsok then exit;
  Result:=longint((vScud.GP_SCUD_Saldo.CH_Holiday_Ost+vScud.GP_SCUD_Saldo.CH_Holiday_Cur-
        vScud.GP_SCUD_Saldo.CH_Holiday_Opl))/10000;
} //Function CalcDaysHoliday:double;

//--------------------------------------------
// Рассчитать кол-во дней остатка переработки
//--------------------------------------------
Function CalcHoursOverWork2(_pPersons:comp;_DisDate:date):double; cacheable;
{ Result:=0;
  if _pPersons=0 then exit;
  vScud.pPersons:=_pPersons;
  if vScud.getfirst GP_Scud_Pers<>tsok then exit;
  vScud.wYearN:=year(_DisDate);
  vScud.wMesN :=month(_DisDate);
  if vScud.getfirst GP_SCUD_Saldo<>tsok then exit;
  Result:=Round((vScud.GP_SCUD_Saldo.CH_Over2_Ost+vScud.GP_SCUD_Saldo.CH_Over2_Cur-
        vScud.GP_SCUD_Saldo.CH_Over2_Opl),2);
} //Function CalcHoursOverWork2:double;

//******************************************************************************
// можно вынести в RPD_BASE, но тогда начинают идти 6 предупреждений на base_Payment
// да и EnableDisable в 8 перехвачена
//******************************************************************************
Create view vNotes
var
  nRecTable:comp;
  wChoice  :word;
From Notes
where ((
      wChoice     == Notes.choice
  and nRecTable   == Notes.Owner
));
//----------------------------


File FMemo;


Function MyCheckNotes(_wChoice:word):boolean;
{ Result:=false;
  vNotes.nRecTable:=ContDoc.Nrec;
  vNotes.wChoice  :=_wChoice;
  Result:=vNotes.Getfirst Notes=tsok;
  if not Result exit;
  if FMemo.OpenMemo(vNotes.Notes.NOTE)
  { Result:=FMemo.GetSize()<>0;
    FMemo.Close;
  }
} //Function MyCheckNotes(_wChoice:word):boolean;
//******************************************************************************
// Установить надписи на кнопках
//******************************************************************************
Procedure MySetButtonTitle(_nm_screen:string='');
{ //'Z_STAFFORDERS::NOTESFORCONTDOC.Memo_NOTES.NOTE'
  var ww_str:string;
  if _nm_screen='' _nm_screen:='b_SCRDOC';
  //cmViewAdvance1
  ww_str:=if(MyCheckNotes(3002),'Примечан.+','Примечание');
  cfsSetProp(_nm_screen+'_Примечание',cfpTitle,ww_str);
  //--
  ww_str:=if(MyCheckNotes(3005),'Доп.условия+','Доп. условия');
  cfsSetProp(_nm_screen+'_Доп._условия',cfpTitle,ww_str);
  ReScanPanel(#PERSONS);
} //Procedure MySetButtonTitle;

//-----------------------------------------
// проверим принадлежность доплаты к РПД 11
// #231.#12 при утверждении приказов на увольнении Доплата на полис ДМС не должна попадать в корзину
//-----------------------------------------
Function CheckRaiseRPD111(_RaiseType:comp):boolean; cacheable;
{ Result:=false;
  ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD111');
  if _RaiseType=ParentSav
  { Result:=true; Exit;
  }
  if getfirst Catalogs where (( _RaiseType == Catalogs.Nrec )) =tsok
  { if Catalogs.cParent=ParentSav
    { Result:=true; Exit;
    }
  }
} //Function CheckRaiseRPD111(_RaiseType:comp):boolean; cacheable;

//******************************************************************************
//#region Стандартные методы

//******************************************************************************
// Проверка доплаты на то, нужно ли ее закрывать и закрытие, если "да"
//******************************************************************************
Procedure CheckDatesAndClose(_DisDate : date);
{ if CheckRaiseRPD111(Raise.RaiseType) then
  {
    exit;
  }
  Inherited::CheckDatesAndClose(_DisDate);
}  //Procedure CheckDatesAndClose(_DisDate : date);

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure IRPD_Base.EnableDisable;
{ MySetButtonTitle('b_SCRDOC');
  Inherited::EnableDisable
}//Procedure EnableDisable;

//******************************************************************************
//  Процедура утверждения индивидуального приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{ Result:=Inherited::ChildConfirmOneOrder(cNrec);
  if Result
  { iGP_SCUD_PersEdit.MakeBufferPers(Persons.Nrec,ContDoc.ObjNrec,TitleDoc.Nrec,Contdoc.Nrec,PartDoc.TypeOper)
  }
} //function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;

