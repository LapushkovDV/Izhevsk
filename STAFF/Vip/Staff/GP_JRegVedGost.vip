procedure PrintReestr;
{
  #define FrmClR lRER, ++lCER

  var lRecTable: longint = recordsintable(#mtReport);
  var lRBR, lRER, lCBR, lCER : longint = 1;
  var lLineR : longint;
  
  xlSetSheetName(2,'Реестр на выплату компенсаций'); 
  xlSetActiveSheet(2);
  xlMergeCells(lRBR, lCBR, lRBR, 8);
  xlSetCellStringValue('Реестр работников на выплату компенсаций', lRBR, lCBR, lRBR, lCBR);
  xlSetFontSize(14,  lRBR, lCBR, lRBR, lCBR); xlSetFontStyle(xlBold,  lRBR, lCBR, lRBR, lCBR); lRBR++;
  xlMergeCells(lRBR, lCBR, lRBR, 8);
  xlSetCellStringValue('стоимости услуг ведомственной гостиницы', lRBR, lCBR, lRBR, lCBR);   lRBR++;
  xlMergeCells(lRBR, lCBR, lRBR, 8);
  xlSetCellStringValue('с ' + DateToStr(dBeg, 'DD.MM.YYYY') + ' по ' + DateToStr(dEnd, 'DD.MM.YYYY'), lRBR, lCBR, lRBR, lCBR); lRBR += 2;

  lCER := 0;
  lCER++; xlSetCellStringValue('№'+chr(10)+'п/п',                    lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('№'+chr(10)+'подр',                   lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('Таб.'+chr(10)+'ном.',                lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('ФИО работника',                      lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('Должность,'+chr(10)+'специальность', lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('Срок'+chr(10)+'договора',            lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('№ Договора',                         lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('Сумма'+chr(10)+'начисления',         lRBR, lCER, lRBR, lCER);
  xlSetFontStyle(xlBold, lRBR, lCBR, lRBR, lCER);

  if (not xlCreateMatrix(lRecTable, lCER))
  {
    message('Ошибка функции xlCreateMatrix.',error);
    xlKillExcel;
    StopVisual;
    exit;
  }

  lLineR := 0;
  _loop mtReport
  {
    if ( mtReport.dbKomp = 0 ) continue;
    if (not NextVisual) break;
    lCER := 0;
    xlStWriteToMatrix(#FrmClR, ++lLineR);
    xlStWriteToMatrix(#FrmClR, mtReport.sPodr  );
    xlStWriteToMatrix(#FrmClR, mtReport.sTbNmb );
    xlStWriteToMatrix(#FrmClR, mtReport.sFIO   );
    xlStWriteToMatrix(#FrmClR, mtReport.sPost  );
    xlStWriteToMatrix(#FrmClR, mtReport.sPeriod);
    xlStWriteToMatrix(#FrmClR, mtReport.sDogN  );
    xlDoWriteToMatrix(#FrmClR, mtReport.dbKomp );
    lRER++;
  }
  xlSetNumberFormat('@', lRBR+1, 1, lRBR+lRER, 7);
  xlSetNumberFormat('# ##0,00;-# ##0,00;', lRBR+1, 8, lRBR+lRER, 8);
  if (not xlWriteMatrixToExcel(lRBR+1, 1))
    message('Ошибка функции xlWriteMatrixToExcel.',error);
  xlFreeMatrix;
  xlSetCellStringValue('Итого:', (lRBR+lRER), 4, (lRBR+lRER), 4);
  iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;H'+(lRBR+1)+':H'+(lRBR+lRER-1)+')', (lRBR+lRER), 8, (lRBR+lRER), 8);
  xlSetFontStyle(xlBold, (lRBR+lRER), lCBR, (lRBR+lRER), lCER);
  
  xlSetColumnWidth( 4, lRBR, 1, lRBR, 1);
  xlSetColumnWidth( 6, lRBR, 2, lRBR, 2);
  xlSetColumnWidth( 6, lRBR, 3, lRBR, 3);
  xlSetColumnWidth(30, lRBR, 4, lRBR, 4);
  xlSetColumnWidth(30, lRBR, 5, lRBR, 5);
  xlSetColumnWidth(12, lRBR, 6, lRBR, 6);
  xlSetColumnWidth(12, lRBR, 7, lRBR, 7);
  xlSetColumnWidth(12, lRBR, 8, lRBR, 8);
  
  xlAlignCellsEx(xlCenter, xlCenter, 1, lCBR, (lRBR+lRER), lCER);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, lRBR, lCBR, lRBR+lRER, lCER);

  lRER += 2 + lRBR;
  _loop mtSigners
  {
    xlMergeCells(lRER, 1, lRER, 5);
    xlSetCellStringValue(mtSigners.sPost, lRER, 1, lRER, 1);
    xlMergeCells(lRER, 6, lRER, 8);
    xlAlignCellsEx(xlRight, xlCenter, lRER, 6, lRER, 8);
    xlSetCellStringValue(iStrFunc.GetFIO(mtSigners.sFIO), lRER, 6, lRER, 6);
    xlSetFontStyle(xlBold,  lRER, 1, lRER, 6); lRER += 2;
  }
  xlWrapText(lRBR, lCBR, (lRBR+lRER), lCER);

  xlSetSheetName(3,'Реестр на удержание из ЗП'); 
  xlSetActiveSheet(3);

  lRBR := lRER := lCBR := lCER := 1;
  xlMergeCells(lRBR, lCBR, lRBR, 8);
  xlSetCellStringValue('Реестр работников на удержание', lRBR, lCBR, lRBR, lCBR);
  xlSetFontSize(14,  lRBR, lCBR, lRBR, lCBR); xlSetFontStyle(xlBold,  lRBR, lCBR, lRBR, lCBR); lRBR++;
  xlMergeCells(lRBR, lCBR, lRBR, 8);
  xlSetCellStringValue('стоимости услуг ведомственной гостиницы', lRBR, lCBR, lRBR, lCBR);   lRBR++;
  xlMergeCells(lRBR, lCBR, lRBR, 8);
  xlSetCellStringValue('с ' + DateToStr(dBeg, 'DD.MM.YYYY') + ' по ' + DateToStr(dEnd, 'DD.MM.YYYY'), lRBR, lCBR, lRBR, lCBR); lRBR += 2;

  lCER := 0;
  lCER++; xlSetCellStringValue('№'+chr(10)+'п/п',                    lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('№'+chr(10)+'подр',                   lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('Таб.'+chr(10)+'ном.',                lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('ФИО работника',                      lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('Должность,'+chr(10)+'специальность', lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('Срок'+chr(10)+'договора',            lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('№ Договора',                         lRBR, lCER, lRBR, lCER);
  lCER++; xlSetCellStringValue('Сумма'+chr(10)+'удержания',          lRBR, lCER, lRBR, lCER);
  xlSetFontStyle(xlBold, lRBR, lCBR, lRBR, lCER);

  if (not xlCreateMatrix(lRecTable, lCER))
  {
    message('Ошибка функции xlCreateMatrix.',error);
    xlKillExcel;
    StopVisual;
    exit;
  }

  lLineR := 0;
  _loop mtReport
  {
    if ( mtReport.wSpoOp = 0 ) continue;
    if ( mtReport.dbUder = 0 ) continue;
    if ( not NextVisual ) break;
    lCER := 0;
    xlStWriteToMatrix(#FrmClR, ++lLineR);
    xlStWriteToMatrix(#FrmClR, mtReport.sPodr  );
    xlStWriteToMatrix(#FrmClR, mtReport.sTbNmb );
    xlStWriteToMatrix(#FrmClR, mtReport.sFIO   );
    xlStWriteToMatrix(#FrmClR, mtReport.sPost  );
    xlStWriteToMatrix(#FrmClR, mtReport.sPeriod);
    xlStWriteToMatrix(#FrmClR, mtReport.sDogN  );
    xlDoWriteToMatrix(#FrmClR, mtReport.dbUder );
    lRER++;
  }
  xlSetNumberFormat('@', lRBR+1, 1, lRBR+lRER, 7);
  xlSetNumberFormat('# ##0,00;-# ##0,00;', lRBR+1, 8, lRBR+lRER, 8);
  if (not xlWriteMatrixToExcel(lRBR+1, 1))
    message('Ошибка функции xlWriteMatrixToExcel.',error);
  xlFreeMatrix;
  xlSetCellStringValue('Итого:', (lRBR+lRER), 4, (lRBR+lRER), 4);
  iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;H'+(lRBR+1)+':H'+(lRBR+lRER-1)+')', (lRBR+lRER), 8, (lRBR+lRER), 8);
  xlSetFontStyle(xlBold, (lRBR+lRER), lCBR, (lRBR+lRER), lCER);
  
  xlSetColumnWidth( 4, lRBR, 1, lRBR, 1);
  xlSetColumnWidth( 6, lRBR, 2, lRBR, 2);
  xlSetColumnWidth( 6, lRBR, 3, lRBR, 3);
  xlSetColumnWidth(30, lRBR, 4, lRBR, 4);
  xlSetColumnWidth(30, lRBR, 5, lRBR, 5);
  xlSetColumnWidth(12, lRBR, 6, lRBR, 6);
  xlSetColumnWidth(12, lRBR, 7, lRBR, 7);
  xlSetColumnWidth(12, lRBR, 8, lRBR, 8);
  
  xlAlignCellsEx(xlCenter, xlCenter, 1, lCBR, (lRBR+lRER), lCER);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, lRBR, lCBR, lRBR+lRER, lCER);

  lRER += 2 + lRBR;
  _loop mtSigners
  {
    xlMergeCells(lRER, 1, lRER, 5);
    xlSetCellStringValue(mtSigners.sPost, lRER, 1, lRER, 1);
    xlMergeCells(lRER, 6, lRER, 8);
    xlAlignCellsEx(xlRight, xlCenter, lRER, 6, lRER, 8);
    xlSetCellStringValue(iStrFunc.GetFIO(mtSigners.sFIO), lRER, 6, lRER, 6);
    xlSetFontStyle(xlBold,  lRER, 1, lRER, 6); lRER += 2;
  }
  xlWrapText(lRBR, lCBR, (lRBR+lRER), lCER);

//------------------------------
  lRecTable := recordsintable(#mtDelRaise);
  if ( lRecTable <> 0 )
  {
    lRBR := lRER := lCBR := lCER := 1;
    
    xlSetSheetName(4,'Реестр на отмену компенсаций'); 
    xlSetActiveSheet(4);
    xlMergeCells(lRBR, lCBR, lRBR, 8);
    xlSetCellStringValue('Реестр работников на отмену компенсаций', lRBR, lCBR, lRBR, lCBR);
    xlSetFontSize(14,  lRBR, lCBR, lRBR, lCBR); xlSetFontStyle(xlBold,  lRBR, lCBR, lRBR, lCBR); lRBR++;
    xlMergeCells(lRBR, lCBR, lRBR, 8);
    xlSetCellStringValue('стоимости услуг ведомственной гостиницы', lRBR, lCBR, lRBR, lCBR);   lRBR++;
    xlMergeCells(lRBR, lCBR, lRBR, 8);
    xlSetCellStringValue('с ' + DateToStr(dBeg, 'DD.MM.YYYY') + ' по ' + DateToStr(dEnd, 'DD.MM.YYYY'), lRBR, lCBR, lRBR, lCBR); lRBR += 2;

    lCER := 0;
    lCER++; xlSetCellStringValue('№'+chr(10)+'п/п',                    lRBR, lCER, lRBR, lCER);
    lCER++; xlSetCellStringValue('№'+chr(10)+'подр',                   lRBR, lCER, lRBR, lCER);
    lCER++; xlSetCellStringValue('Таб.'+chr(10)+'ном.',                lRBR, lCER, lRBR, lCER);
    lCER++; xlSetCellStringValue('ФИО работника',                      lRBR, lCER, lRBR, lCER);
    lCER++; xlSetCellStringValue('Должность,'+chr(10)+'специальность', lRBR, lCER, lRBR, lCER);
    lCER++; xlSetCellStringValue('Срок'+chr(10)+'договора',            lRBR, lCER, lRBR, lCER);
    lCER++; xlSetCellStringValue('№ Договора',                         lRBR, lCER, lRBR, lCER);
    lCER++; xlSetCellStringValue('Сумма'+chr(10)+'начисления',         lRBR, lCER, lRBR, lCER);
    lCER++; xlSetCellStringValue('Отменяется'+chr(10)+'с даты',        lRBR, lCER, lRBR, lCER);
    xlSetFontStyle(xlBold, lRBR, lCBR, lRBR, lCER);

    if (not xlCreateMatrix(lRecTable, lCER))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }

    lLineR := 0;
    _loop mtDelRaise
    {
      if ( not FoundMarker(PersMarker, mtDelRaise.cPsn) ) continue;
      if ( not NextVisual ) break;
      lCER := 0;
      xlStWriteToMatrix(#FrmClR, ++lLineR);
      xlStWriteToMatrix(#FrmClR, mtDelRaise.sPodr  );
      xlStWriteToMatrix(#FrmClR, mtDelRaise.sTbNmb );
      xlStWriteToMatrix(#FrmClR, mtDelRaise.sFIO   );
      xlStWriteToMatrix(#FrmClR, mtDelRaise.sPost  );
      xlStWriteToMatrix(#FrmClR, if(mtDelRaise.dFrom<>0,'с '  +datetostr(mtDelRaise.dFrom,'DD.MM.YYYY'),'')
                                +if(mtDelRaise.dTo<>0,  ' по '+datetostr(mtDelRaise.dTo,  'DD.MM.YYYY'),''));
      xlStWriteToMatrix(#FrmClR, mtDelRaise.sDogN  );
      xlDoWriteToMatrix(#FrmClR, mtDelRaise.dbKomp );
      xlDtWriteToMatrix(#FrmClR, mtDelRaise.dAbort );
      lRER++;
    }
    xlSetNumberFormat('@', lRBR+1, 1, lRBR+lRER, 7);
    xlSetNumberFormat('# ##0,00;-# ##0,00;', lRBR+1, 8, lRBR+lRER, 8);
    if (not xlWriteMatrixToExcel(lRBR+1, 1))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;
    xlSetCellStringValue('Итого:', (lRBR+lRER), 4, (lRBR+lRER), 4);
    iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;H'+(lRBR+1)+':H'+(lRBR+lRER-1)+')', (lRBR+lRER), 8, (lRBR+lRER), 8);
    xlSetFontStyle(xlBold, (lRBR+lRER), lCBR, (lRBR+lRER), lCER);
    
    xlSetColumnWidth( 4, lRBR, 1, lRBR, 1);
    xlSetColumnWidth( 6, lRBR, 2, lRBR, 2);
    xlSetColumnWidth( 6, lRBR, 3, lRBR, 3);
    xlSetColumnWidth(30, lRBR, 4, lRBR, 4);
    xlSetColumnWidth(30, lRBR, 5, lRBR, 5);
    xlSetColumnWidth(12, lRBR, 6, lRBR, 6);
    xlSetColumnWidth(12, lRBR, 7, lRBR, 7);
    xlSetColumnWidth(12, lRBR, 8, lRBR, 8);
    xlSetColumnWidth(12, lRBR, 9, lRBR, 9);
    
    xlAlignCellsEx(xlCenter, xlCenter, 1, lCBR, (lRBR+lRER), lCER);
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, lRBR, lCBR, lRBR+lRER, lCER);

    lRER += 2 + lRBR;
    _loop mtSigners
    {
      xlMergeCells(lRER, 1, lRER, 5);
      xlSetCellStringValue(mtSigners.sPost, lRER, 1, lRER, 1);
      xlMergeCells(lRER, 6, lRER, 8);
      xlAlignCellsEx(xlRight, xlCenter, lRER, 6, lRER, 8);
      xlSetCellStringValue(iStrFunc.GetFIO(mtSigners.sFIO), lRER, 6, lRER, 6);
      xlSetFontStyle(xlBold,  lRER, 1, lRER, 6); lRER += 2;
    }
    xlWrapText(lRBR, lCBR, (lRBR+lRER), lCER);
  }
//------------------------------  
  xlSetActiveSheet(1);
}

procedure MakeReestrOneRecord;
{
  ClearBuffer(#mtReport);

  mtReport.sTbNmb:= if (Appointments.lPrizn = 0, GetStrTabn(Persons.TabNmb,Persons.StrTabn), 
                                                 GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN));
  mtReport.sFIO  := Persons.FIO;    

  mtReport.sPodr := SubStr(iCatFunc.GetCatalogsCode(Appointments.Department),1,3);
  mtReport.sPost := if ( boGetTune('UP.STAFF.USE_LONGNAME_ANK'),trim(iCatFunc.GetCatalogsLongName(Appointments.Post)),
                                                                trim(iCatFunc.GetCatalogsName(Appointments.Post)));
  mtReport.dbKomp  := RaiseHist.RHSUM;
  mtReport.sPeriod := if(RaiseHist.dRec<>0 ,  'с '+datetostr(RaiseHist.dRec ,'DD.MM.YYYY'),'')
                     +if(RaiseHist.dDat2<>0,' по '+datetostr(RaiseHist.dDat2,'DD.MM.YYYY'),'');
  if isvalid(#GP_RaiseHistExt107)
  {
    mtReport.sDogN := GP_RaiseHistExt107.NumDog;
    mtReport.dbUder:= GP_RaiseHistExt107.SummaMes;  
    mtReport.sSpoOp:= iCatFunc.GetCatalogsName(GP_RaiseHistExt107.cSposOpl);
    mtReport.wSpoOp:= if(pos('из зарплаты',mtReport.sSpoOp)<>0,1,0) ;
  }
  insert current mtReport;
}

procedure Run;
{
  var kol, i    : integer;
  var cPersNRec : comp;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);

  
  if ( wModeRep = 1 )
  {
    if (not (ReadMyDsk(sSigner, 'RPD107_sSigner', false)))
      sSigner := sGetTune('UP.Staff.SignatoryAuthority');
    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);
    if (not iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigner))
      sSigner:='';

    if (RunWindowModal(winSign) = cmDefault)
    {
      MakeFeeSignersList;
    }
    SaveMyDsk(sSigner, 'RPD107_sSigner');
  }

  if (VCommonFiltr.GetPsnCount = 0)
    VCommonFiltr.SelectAllPsn;

  PersMarker := InitMarker('#(GPInt)_PSN_'+UserName(),8,200,100);
  PersMarker := VCommonFiltr.GetPersonsMarker;

  RestartVisual('Заполняю таблицу фильтров',1);
  kol:=  GetMarkerCount(PersMarker);
  i := 0;
  while i < kol
  {
    GetMarker(PersMarker, i, cPersNRec);
    insert ttPerFlt set ttPerFlt.cRecPers := cPersNRec;
    i++;
    if (not NextVisual) break;
  }

  FillZGD;

//  message(coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_107.VIDUD')); // !!!ПОЧЕМУ coGetTune возвращает код (KlVidUd.VidUd) а не nRec???
  //      vSpr.pCatParentDot:=coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD107');
  cDopl107 := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD107');
  if ( cDopl107 = 0 ) message('Не задана настройка UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD107', Error);
  
  set wVidUd := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_107.VIDUD');
  if getfirst KlVidUd where((wVidUd == KlVidUd.VidUd)) = tsOk
  {
    cVidUd := KlVidUd.nRec;
    sVidUd := KlVidUd.NVidUd;
  }
  else
  {message('Не задана настройка UP.STAFF.PRIKAZ_PERS.RPD_107.VIDUD', Error)}

  RestartVisual('Идет сбор данных', 1);
  if isvalid(#ttPerFlt)
  _loop ttPerFlt
  {
    if (not NextVisual) break;
    if isvalid(#persons) {}
    if isvalid(#RaiseHist)
    _loop RaiseHist
    {
    
      if ( not isvalid(#Raise) ) continue;
      if ( not isvalid(#contdoc) ) continue;
      if ( not isvalid(#appointments) ) continue;
      if ( not isvalid(#ttTypOp) ) continue;
      if raise.OrderDate1 = RaiseHist.DOCDATE and raise.OrderDate2 = 0
      {
        //Для реестров
        if ( wModeRep = 1 )
          MakeReestrOneRecord;
        //---
//        if (not NextVisual) break;
        if getfirst ttPers where((persons.nrec == ttPers.cRecPsn)) <> tsOk
        {
          clearbuffer(#ttPers);
          ttPers.cRecPsn := persons.nrec;
          ttPers.sFIO := persons.fio;
          insert current ttPers;
        }
        clearbuffer(#ttResStr);
        //Добавляем общие данные строку для склейки в разрезе:
        if getfirst ttResStr where((  persons.nrec             == ttResStr.cRecPers
// 2018.02.28 Обновление. Склеиваем ВСЕ в одну строку за месяц
//                                   and RaiseHist.cRaiseType     == ttResStr.cKomp
                                  and Year (RaiseHist.DOCDATE) == ttResStr.wDocYear
                                  and Month(RaiseHist.DOCDATE) == ttResStr.wDocMonth
                                  ))<>tsOk
        {
          ttResStr.cRecPers := persons.nrec;
          ttResStr.cKomp    := RaiseHist.cRaiseType;
          ttResStr.wDocYear := Year (RaiseHist.DOCDATE);
          ttResStr.wDocMonth:= Month(RaiseHist.DOCDATE);
          ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
          ttResStr.sFIO     := persons.FIO;
          ttResStr.sKomp    := iCatFunc.GetCatalogsName(RaiseHist.cRaiseType);
          ttResStr.sKomC    := iCatFunc.GetCatalogsCode(RaiseHist.cRaiseType);
          ttResStr.sStaj    := iRunStaj.RunStrStaj(persons.nrec,89,dEnd);
          set lVOplT        := longint(Trim(iCatFunc.GetCatalogsCatData(RaiseHist.cRaiseType)));
          ttResStr.lVidOpl  := lVOplT;
          //проверяем - есть ли в таблице для фильтра по видам оплат текущий, добавляем если нет
          if getfirst ttVidOpl where ((lVOplT == ttVidOpl.lVOpl)) <> tsOk
          {
            if getfirst KlVidOpl where ((lVOplT == KlVidOpl.VidOpl)) = tsOk
              insert ttVidOpl 
                set 
                  ttVidOpl.lVOpl := ttResStr.lVidOpl,
                  ttVidOpl.sVOpl := KlVidOpl.NVidOpl,
                  ttVidOpl.cKomp := ttResStr.cKomp;
          }
          ttResStr.sIsCh    := iAppCh.State(persons.nrec,contdoc.cSTR,dEnd,12);
          #CommonFields
          insert current ttResStr;
        }
        //тут проверяем дату документа и дату уже существующей записи в ttResStr
        //если обрабатываем более новый документ - обновляем необходимые поля более свежими данными
        if ttResStr.dDocDate < RaiseHist.DOCDATE 
        {
          #CommonFields
        }
        //суммируем остальное
        if isvalid(#GP_RaiseHistExt107)
        {
          ttResStr.dbPayM   += GP_RaiseHistExt107.PlataMes; 
          ttResStr.dbDedM   += GP_RaiseHistExt107.SummaMes; 
        }
        ttResStr.dbSumK   += RaiseHist.RHSUM;
        ttResStr.sPrik    += ' '+RaiseHist.DOCNMB+' от '+datetostr(RaiseHist.DOCDATE,'DD.MM.YYYY');
        if ( ContDoc.wAttrDoc3 = 1 ) 
          ttResStr.sIsSup := 'Да';
        if isValid(#PsnLinks)
          ttResStr.sChild1 := PsnLinks.Rfio+', рожд. '+DateToStr(PsnLinks.RBornDate, 'DD.MM.YYYY');
        if isValid(#PsnLinks2)
          ttResStr.sChild2 := PsnLinks2.Rfio+', рожд. '+DateToStr(PsnLinks2.RBornDate, 'DD.MM.YYYY');
        update current ttResStr;
      }
    }

    if isvalid(#LSchet)
    _loop LSchet
    {
      //Oplaty
      if isvalid(#SumVidOp)
      _loop SumVidOp
      {
        dSumE := date(Last_Day(date(1,SumVidOp.MesN,SumVidOp.YearN)),SumVidOp.MesN,SumVidOp.YearN);
        if isvalid(#ttVidOpl)
        if  date(1,month(dBeg),year(dBeg)) <= date(1,SumVidOp.MesN,SumVidOp.YearN)
        and date(Last_Day(dEnd),month(dEnd),year(dEnd)) >= dSumE
        {
          clearbuffer(#ttResStr);
          //вставляем отвязанную запись по выплате если нет приказа за месяц
          if getfirst ttResStr where((  persons.nrec   == ttResStr.cRecPers
// 2018.02.28 Обновление. Склеиваем ВСЕ в одну строку за месяц
//                                     and ttVidOpl.cKomp == ttResStr.cKomp
                                    and SumVidOp.YearN == ttResStr.wDocYear
                                    and SumVidOp.MesN  == ttResStr.wDocMonth
                                    )) <> tsOk
          {//if getfirst ttResStr
            ttResStr.cRecPers := persons.nrec;
            ttResStr.cKomp    := ttVidOpl.cKomp;
            ttResStr.wDocYear := SumVidOp.YearN;
            ttResStr.wDocMonth:= SumVidOp.MesN;
            ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
            ttResStr.sFIO     := persons.FIO;
            ttResStr.sKomp    := iCatFunc.GetCatalogsName(ttVidOpl.cKomp);
            ttResStr.sKomC    := iCatFunc.GetCatalogsCode(ttVidOpl.cKomp);
            ttResStr.sStaj    := iRunStaj.RunStrStaj(persons.nrec,89,dEnd);
            ttResStr.lVidOpl  := SumVidOp.VidOpl;
            //----------------------------------------------------------------
            set cApp4SumVidOp := iAppFunc.GetAppNrec_OnDate(persons.nrec,dSumE);
            if isvalid(#App4SumVidOp)
            {
              ttResStr.sDept  := substr(iCatFunc.GetCatalogsCode(App4SumVidOp.DEPARTMENT),1,3);
              ttResStr.sPost  := iCatFunc.GetCatalogsName(App4SumVidOp.POST);
              if isvalid(#ttZGDV)
                ttResStr.sDepP:= ttZGDV.sCodeZGD;
              ttResStr.sIsCh  := iAppCh.State(persons.nrec,App4SumVidOp.nRec,dEnd,12);
            }
            insert current ttResStr;
            if getfirst ttPers where((persons.nrec == ttPers.cRecPsn)) <> tsOk
            {
              clearbuffer(#ttPers);
              ttPers.cRecPsn := persons.nrec;
              ttPers.sFIO := persons.fio;
              insert current ttPers;
            }
          }//if getfirst ttResStr
          //апдейтим ttResStr по текущему курсору (новому или существующему)
          ttResStr.dbSumZ += SumVidOp.Summa;
          ttResStr.dNach  := dSumE;
          update current ttResStr;
        }
      }
      //Uderzhaniya
      if isvalid(#SumVidUd)
      _loop SumVidUd
      {
        dSumE := date(Last_Day(date(1,SumVidUd.MesN,SumVidUd.YearN)),SumVidUd.MesN,SumVidUd.YearN);
        if  date(1,month(dBeg),year(dBeg)) <= date(1,SumVidUd.MesN,SumVidUd.YearN)
        and date(Last_Day(dEnd),month(dEnd),year(dEnd)) >= dSumE
        {
          clearbuffer(#ttResStr);
          //вставляем отвязанную запись по выплате если нет приказа за месяц
          if getfirst ttResStr where((  persons.nrec   == ttResStr.cRecPers
// 2018.02.28 Обновление. Склеиваем ВСЕ в одну строку за месяц
//                                     and cVidUd         == ttResStr.cKomp
                                    and SumVidUd.YearN == ttResStr.wDocYear
                                    and SumVidUd.MesN  == ttResStr.wDocMonth
                                    )) <> tsOk
          {//if getfirst ttResStr
            ttResStr.cRecPers := persons.nrec;
            ttResStr.cKomp    := cVidUd;
            ttResStr.wDocYear := SumVidUd.YearN;
            ttResStr.wDocMonth:= SumVidUd.MesN;
            ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
            ttResStr.sFIO     := persons.FIO;
            ttResStr.sKomp    := sVidUd;
//            ttResStr.sKomC    := iCatFunc.GetCatalogsCode(ttVidOpl.cKomp);
            ttResStr.sStaj    := iRunStaj.RunStrStaj(persons.nrec,89,dEnd);
            ttResStr.lVidOpl  := wVidUd;
            //----------------------------------------------------------------
            set cApp4SumVidUd := iAppFunc.GetAppNrec_OnDate(persons.nrec,dSumE);
            if isvalid(#App4SumVidUd)
            {
              ttResStr.sDept  := substr(iCatFunc.GetCatalogsCode(App4SumVidUd.DEPARTMENT),1,3);
              ttResStr.sPost  := iCatFunc.GetCatalogsName(App4SumVidUd.POST);
              if isvalid(#ttZGDU)
                ttResStr.sDepP:= ttZGDU.sCodeZGD;
              ttResStr.sIsCh  := iAppCh.State(persons.nrec,App4SumVidUd.nRec,dEnd,12);
            }
            insert current ttResStr;
            if getfirst ttPers where((persons.nrec == ttPers.cRecPsn)) <> tsOk
            {
              clearbuffer(#ttPers);
              ttPers.cRecPsn := persons.nrec;
              ttPers.sFIO := persons.fio;
              insert current ttPers;
            }
          }//if getfirst ttResStr
          //апдейтим ttResStr по текущему курсору (новому или существующему)
          ttResStr.dbSumU += SumVidUd.SumUd;
          ttResStr.dNach  := dSumE;
          update current ttResStr;
        }
      }
    }
  }

  //это реестр по отмене доплат 
  //делается по РПД10 так что выбираем отдельно
  if ( wModeRep = 1 )
  {
    sql select
      TitleDoc.DOCDATE,
      DelRaise.DFROMDATE,
      DelRaise.dToDate,
      DelRaise.dRaiseAbort,
      GP_RaiseHistExt107.NumDog,
      Persons.STRTABN,
      Persons.FIO,
      Persons.NRec,
      CatDept.Code,
      CatPost.Name,
      RaiseCat.NRec,
      RaiseCat.cParent,
      DelRaise.dSum1
    from
               ContDoc
    inner join DelRaise on 1 = DelRaise.wTypeInfo and ContDoc.NRec = DelRaise.cOrderCont1
    left  join Catalogs RaiseCat on DelRaise.cRaiseType = RaiseCat.Nrec
    left  join Appointments on ContDoc.cStr = Appointments.NRec
    left  join Catalogs CatPost on Appointments.Post = CatPost.NRec
    left  join Catalogs CatDept on Appointments.Department = CatDept.NRec
    left  join Persons on Appointments.Person = Persons.NRec
    left  join PartDoc on ContDoc.cPart = PartDoc.NRec
    left  join TitleDoc on PartDoc.cDoc = TitleDoc.NRec
    left  join Raise on ContDoc.nRec = Raise.cRDopEnd
    left  join RaiseHist on Raise.Nrec = RaiseHist.cRaise
    left  join GP_RaiseHistExt107 on RaiseHist.nrec = GP_RaiseHistExt107.cRaiseH
    where
        ( contdoc.typeoper = 10 )
    and ( RaiseCat.NRec = :(cDopl107) or RaiseCat.cParent = :(cDopl107) )
    and ( TitleDoc.DOCDATE >= :(dBeg) and TitleDoc.DOCDATE <= :(dEnd) )
    and ( TitleDoc.wStatus = 1 )
    and ( GP_RaiseHistExt107.NumDog is not null )
    into mtDelRaise
    ;
  }
  if isvalid(#ttResStr)
  {
    RestartVisual('Выгружаю данные',1);
    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xls';

    xlCreateExcel(sFullName, TRUE);
    if ( wModeRep = 1 )
    {
      xlAddSheet; xlAddSheet; xlAddSheet; xlSetActiveSheet(1);
      xlSetSheetName(1,'Журнал регистрации и учета'); 
    }
    lRB  := 3;
    lHS  := 3;
