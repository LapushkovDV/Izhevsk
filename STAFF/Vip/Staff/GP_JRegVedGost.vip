      iOut.HeaderInsL('Итого по '+ttResStr.sFio, #FrmCl, 5);
      iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;P'+iRowB+':P'+(lDE-1)+')', lDE, 16, lDE, 16);
