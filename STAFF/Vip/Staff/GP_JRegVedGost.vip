ttResStr.sDept    := substr(iCatFunc.GetCatalogsCode(appointments.DEPARTMENT),1,3);
ttResStr.sPost    := iCatFunc.GetCatalogsName(appointments.POST);
if isvalid(#ttZGDD)
  ttResStr.sDepP    := ttZGDD.sCodeZGD;
ttResStr.dNachR   := RaiseHist.dRec;
ttResStr.dDogB    := RaiseHist.dDat2; 
if isvalid(#GP_RaiseHistExt107)
{
  ttResStr.sDogG  := GP_RaiseHistExt107.NumDog;
  ttResStr.dDogG  := GP_RaiseHistExt107.SrokDog; 
  ttResStr.iKatN  := GP_RaiseHistExt107.Kateg; 
  ttResStr.iKolM  := GP_RaiseHistExt107.KolMest;
  ttResStr.sSpoO  := iCatFunc.GetCatalogsName(GP_RaiseHistExt107.cSposOpl); 
  ttResStr.iISupr := GP_RaiseHistExt107.FMembers;
  ttResStr.iIChil := GP_RaiseHistExt107.FMembCh;
}
//--------------------------------------------------------------------------------------
#end
