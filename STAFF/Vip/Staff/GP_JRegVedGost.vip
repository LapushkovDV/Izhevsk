#include FeeSigners.var

var
  dBeg, dEnd    : date;
  VCommonFiltr  : CommonFiltr; // Для встраивания фильтра по подразделениям / сотрудникам
  MadeReport    : boolean;
  wModeRep      : word;
  cPersNRec     : comp;
  PersMarker    : TPtr;
  RPDMarker     : TPtr;
  mKomp         : TPtr;
  iCatFunc      : CatalogsFunctions;
  iRunStaj      : Runstaj;
  iAppFunc      : AppointmentsFunctions;
  i3GD          : GP_3GD;
  iAppCh        : GP_AppChange;
  iOut          : GP_XlOutExt;
  IDepartIer    : DepartIer;           // Переменная типа интерфейс DepartIer
  iStrFunc      : StringFunctions;     // Переменная типа интерфейс StringFunctions
  sFullName     : string;
  sRPD          : string;
  wRPD          : word;
  sKomp         : string;
  wKomp         : word;
  lRB, lHS,
  lCB, lCE,
  lSB, lSE,
  lDB, lDE,
  lRow   : longint;
  dSumE  : date;
  lVOplT : longint; 
  cVidUd : comp;
  wVidUd : word;
  sVidUd : string;
  sSigner: string;
  cDopl107: comp;

create view
var
  cApp4SumVidOp : comp;
  cApp4SumVidUd : comp;
  cMainLinkDept : comp;
from
  persons
, appointments
, appointments App4SumVidOp
, appointments App4SumVidUd
, SumVidOp
, SumVidUd
, raisehist
, GP_RaiseHistExt107
, raise
, TYPEPR
, ttPerFlt
, ttResStr
, ttTypOp
, ttPers
, ttVidOpl
, contdoc
, TitleDoc
, PartDoc
, Catalogs CatSposobOplaty
, mtReport (mtReport01)
, mtSigners (mtSigners01)
, KlVidOpl
, LSchet
//, Catalogs CatUd //UP.STAFF.PRIKAZ_PERS.RPD_107.VIDUD
, KlVidUd
, Catalogs ZGDDept
, ttZGD
, ttZGD ttZGDD
, ttZGD ttZGDV
, ttZGD ttZGDU
, PsnLinks 
, PsnLinks PsnLinks2
, mtDelRaise

where
((
     ttPerFlt.cRecPers == persons.nrec
and  ttPerFlt.cRecPers == raisehist.CPSN and (raisehist.DOCDATE >= dBeg and raisehist.DOCDATE <= dEnd)
and   raisehist.cRaise == raise.nrec
and raisehist.cContDoc == contdoc.nrec
and      ContDoc.cPart == PartDoc.Nrec
and       PartDoc.cDoc == TitleDoc.Nrec
and     RaiseHist.nrec == GP_RaiseHistExt107.cRaiseH
and GP_RaiseHistExt107.cSposOpl == CatSposobOplaty.nRec
and       contdoc.cStr == appointments.nrec
and   contdoc.TypeOper == ttTypOp.wCodeOper
and  appointments.DEPARTMENT == ttZGDD.cRecDept
// -----
and    ContDoc.cAddInf == PsnLinks.nRec
and    ContDoc.CNEW4   == PsnLinks2.nRec

and ttPerFlt.cRecPers  == LSchet.tPerson
//Oplaty
and LSchet.nRec        == SumVidOp.cLSch
and year(dBeg)        <<= SumVidOp.YearN and (year(dEnd) >= SumVidOp.YearN)
and    SumVidOp.VIDOPL == ttVidOpl.lVOpl
and      cApp4SumVidOp == App4SumVidOp.nRec
and  App4SumVidOp.DEPARTMENT == ttZGDV.cRecDept
//Uderzhaniya
and LSchet.nRec        == SumVidUd.cLSch
//and year(dBeg)        <<= SumVidUd.YearV and (year(dEnd) >= SumVidUd.YearV and SumVidUd.VidUd = wVidUd)
and year(dBeg)        <<= SumVidUd.YearN and (year(dEnd) >= SumVidUd.YearN and SumVidUd.VidUd = wVidUd)
and      cApp4SumVidUd == App4SumVidUd.nRec
and  App4SumVidUd.DEPARTMENT == ttZGDU.cRecDept


and integer(0)    == ZGDDept.LPr
and cMainLinkDept == ZGDDept.MainLink
and ZGDDept.nRec  == ttZGD.cRecDept
))
;

//Подписанты----------------------

Window winSign 'Выбор подписантов';
Show At (,, 70, 7);
  Screen sSig(,,sci1Esc);
    fields
      sSigner('Подписанты',,sci13Esc): {Font = {BackColor = if(sSigner = '', ColorNeed, 0)}}, protect;
    buttons
      cmOk,,,'Запуск',,;
      cmCancel,,,'Выход',,;
    << 'Параметры отчета'

     `Подписанты`
      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     <. ~С~формировать .>                         <. ~З~акрыть .>
    >>
  end;
handleevent
  cmPick:
  {
    Case CurField of
      #sSigner:
        if iFeeSigners.RunMainWindow(1)
          set sSigner := iFeeSigners.GetFeeSignersName;

    end;
  }
  cmDelOnProtect:
  {
    case CurField of
      #sSigner:
        set sSigner := '';
    end;
  }
  cmOk:
  {
    if trim(sSigner) <> '' 
      CloseWindowEx(winSign, cmDefault)
    else
      message('Не заданы подписанты!', Error);
  }
  cmCancel:
  {
    CloseWindowEx(winSign, cmCancel);
  }
end;
end;

procedure InsertFeeSignersList(_wIdx: word; _sPost: string; _sFIO: string);
{
  ClearBuffer(#mtSigners);
  mtSigners.wIdx  := _wIdx;
  mtSigners.sPost := _sPost;
  mtSigners.sFIO  := _sFIO;
  if (insert current mtSigners <> tsOk) {}
}

procedure MakeFeeSignersList;
var
  sPostCur, sFIOCur: string = '';
{
  iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigner);
  if iFeeSigners.FeeSignersIsValid
  {
    if iFeeSigners.RestrictFeeByRole(1, cgRole_UtvLico)
      if iFeeSigners.GetSignerFirst
      {
        sPostCur := iFeeSigners.GetSignerPosition(1);
        sFIOCur  := iFeeSigners.GetSignerFIO(cgCommisFIOManual1);
        InsertFeeSignersList(1, sPostCur, sFIOCur);
      }
    iFeeSigners.ClearRestriction;
    if iFeeSigners.RestrictFeeByRole(1, 1002)
      if iFeeSigners.GetSignerFirst
      {
        sPostCur := iFeeSigners.GetSignerPosition(1);
        sFIOCur  := iFeeSigners.GetSignerFIO(cgCommisFIOManual1);
        InsertFeeSignersList(2, sPostCur, sFIOCur);
      }
    iFeeSigners.ClearRestriction;
    if iFeeSigners.RestrictFeeByRole(1, cgRole_Otvetstv)
      if iFeeSigners.GetSignerFirst
      {
        sPostCur := iFeeSigners.GetSignerPosition(1);
        sFIOCur  := iFeeSigners.GetSignerFIO(cgCommisFIOManual1);
        InsertFeeSignersList(3, sPostCur, sFIOCur);
      }
    iFeeSigners.ClearRestriction;
  }
}
//----------------------

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

procedure FillZGD;
{
  set cMainLinkDept := iCatFunc.GetCatalogsNRec(-11);
  RestartVisual('Заполняю описатель иерархии ЗГД',1);
  i3GD.Init3GD;
  if isvalid(#ZGDDept)
  _loop ZGDDept
  {
    if (not NextVisual) break;
    if not isvalid(#ttZGD)
    {
      ClearBuffer(#ttZGD);
      ttZGD.cRecDept := ZGDDept.nRec;
      ttZGD.sCodeZGD := i3GD.sCode3GD(ZGDDept.nRec);
      insert current ttZGD;
    }
  }
}

