#define GPNam Журнал регистрации и учета компенсации стоимости услуг ведомственной гостиницы // #(GPNam)

Interface #(GPInt) '#(GPNam) (ЭМ)' EscClose, Gray;
  show (,,86,19);

const
#include Excel.inc;
end;

table struct ttPerFlt // для фильтра по персоналу
(
  cRecPers : comp
)
with index
(
  ttPerFlt01  = cRecPers
);

table struct ttTypOp
(
  wCodeOper : word
, sNameOper : string
)
with index
(
  ttTypOp01 = wCodeOper
);

table struct ttResStr // статический набор данных
(
  nRec      : comp
, cRecPers  : comp        
, dDocDate  : date
, wDocMonth : word
, wDocYear  : word   
, sTbNmb    : string      //02
, sFIO      : string      //03
, sDept     : string      //04
, sDepP     : string      //05
, sPost     : string      //06
, sKomp     : string      //07
, sKomC     : string
, cKomp     : comp
, sStaj     : string      //08

, sDogG     : string      //09 ? номер и дата договора с гостиницей (н)
, dDogB     : date        //   дата начала действия договора
, dDogG     : date        //10 ? срок действия этого договора       (н)
, iKatN     : integer     //11 ? категория номера                   (н)
, iKolM     : integer     //12 ? количество мест                    (н)
, dNach     : date        //13 ? предварительно - дата назначения компенсации - окончательно из заплаты последний день месяца
, dNachR    : date        // дата начисления компенсации
, sSpoO     : string      //14 ? способ оплаты                      (н) видимо из каталогс-а но к чему вязать?
, dbPayM    : double      //15 ? плата за месяц                     (н)
, dbDedM    : double      //16 ? сумма за месяц к удержанию         (н)
, dbSumZ    : double
, dbSumU    : double
, lVidOpl   : longint

, dbSumK    : double      //17
, sPrik     : string      //18
, iISupr    : integer     //19
, iIChil    : integer     //20
, sIChil    : string  // ?
, sIsCh     : string      //21
, sIsSup    : string
, sChild1   : string
, sChild2   : string
)
with index
(
  ttResStr00 = nRec(Surrogate)
, ttResStr01 = cRecPers + sKomC + dNach
, ttResStr02 = sFIO + dNach + sKomC
, ttResStr03 = cRecPers + lVidOpl
, ttResStr04 = cRecPers + cKomp + wDocYear + wDocMonth
// 2018.02.28 Обновление. Склеиваем ВСЕ в одну строку за месяц
, ttResStr05 = cRecPers + wDocYear + wDocMonth
);

table struct ttPers
(
  cRecPsn : comp,
  sFIO    : string
)
with index
(
  ttPers00 = cRecPsn
, ttPers01 = sFIO
);

