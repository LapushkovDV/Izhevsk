/*************************************************************************************************\
* Наименование:  Приказы по штатному расписанию - Создание структурного подразделения             *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Доработки для учета в СКУД                                                       *
* #45                                                                                             *
* 1. Если для нового СЕ ШР заполнен ВА "Вид производства", то при утверждении приказа, после того,*
*    как будет добавлена новая запись в каталог подразделений (KatPodr), необходимо привязать к   *
*    нему такое же значение ВА "Вид производства".                                                *
* 2. Сделать обязательным для заполнения ВА "Вид производства"                                    *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#45           |14/03/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#include AttrTablePick.vih

#component "Z_STAFFSHR"
#doc
<b>Приказы по штатному расписанию - Создание структурного подразделения</b>
<p>#45
<p>1. Если для нового СЕ ШР заполнен ВА "Вид производства", то при утверждении приказа, после того,
 как будет добавлена новая запись в каталог подразделений (KatPodr), необходимо привязать к
 нему такое же значение ВА "Вид производства".
<p>2. Сделать обязательным для заполнения ВА "Вид производства"                                    *
<p>3. Вытащить ВА "Вид производства" в интерфейс РПД 1, 3 и 4
<p>4. Для РПД 3 и 4, заполнять поле "Вид производства" значением "по умолчанию", взятому из ШР.
<p>5. При утверждении приказов по РПД 3 и 4 обрабатывать заполнение/изменение
ВА "Вид производства" в СЕ ШР и каталоге подразделений.
#end
//*************************************************
Alter Interface SHR_RPD_1;
//*************************************************
Overload
  function ISHR_RPD_Base.CheckCurrOrder: boolean;
  Function ISHR_RPD_Base.ConfirmCurrOrder: boolean;
end;//Overload
#include ShowKau.Vpp
//------
var refAttrTablePick  : AttrTablePick;
var pVA_VID_PROIZV  :comp;
var pVA_VID_PROIZV_H:comp;
//------
create view
as select
  sGetAttrID(coCatalogs,Podr.Nrec,pVA_VID_PROIZV) (FieldName=sVID_PROIZV)
;
//--------------------------------------
// Функции
//--------------------------------------

#doc
  Процедура проверки корректности заполнения приказа
#end
  Function ISHR_RPD_Base.CheckCurrOrder: boolean;
  { Result:=Inherited::CheckCurrOrder;
    if coGetAttrID(coCatalogs,Podr.Nrec,pVA_VID_PROIZV)=0
    { result := false;
      SetOrderMsg('Не заполнен внешний атрибут "Вид производства" (локальное меню в нижней части экрана - внешние атрибуты)');
    }
  } //function ISHR_RPD.CheckOrder: boolean;


#doc
  Процедура утверждения приказа по текущему работнику (по таблице StrCont)
#end
  Function ISHR_RPD_Base.ConfirmCurrOrder: boolean;
  { timelog('SHR_RPD_1->ConfirmCurrOrder 001');
    Result:=Inherited::ConfirmCurrOrder;
    timelog('SHR_RPD_1->ConfirmCurrOrder 002');
    //VInterf.StaffPodr(PodrNew.Nrec); //Создание подразделения в KatPodr
    var _pPodr:comp=GetKatPodrByCatalogs(PodrNew.Nrec);
    if _pPodr<>0
    { CopyAllAttrEx(coCatalogs, PodrNew.nRec,coKatPodr,_pPodr);
    }
    var _pVID_PROIZV:comp  =coGetAttrID(coCatalogs,Podr.Nrec,pVA_VID_PROIZV);
    var _sVID_PROIZV:string= sGetAttrID(coCatalogs,Podr.Nrec,pVA_VID_PROIZV);
    coSetAttrID(coCatHist,CatHist.Nrec,pVA_VID_PROIZV_H,_pVID_PROIZV,_sVID_PROIZV);

    timelog('SHR_RPD_1->ConfirmCurrOrder finish');
  } //Function ISHR_RPD.ConfirmOrder: boolean;

//-------------------------------
OverloadFormats brStr;
//-------------------------------
browse brStr (, hcStaffWinStrPr);
table StrCont;
fields
  browseOrder '№':[1];
  Podr.Name  'Структурное подразделение' ('Наименование структурного подразделения',, sci1378Esc): [35], protect;
  Podr.Code  'Код' ('Код структурного подразделения',, sci1378Esc): [15], protect;
  Podr.DatN  'Дата введения' ('Дата введения структурного подразделения',, sci178Esc): [15], protect, noAutoSize;
end;

//-------------------------------
ExtendFormats scrDet1;
//-------------------------------
screen scrDet1 (,hcStaffWinStrPr, scStaffMyPnl);     //создание стр.подразделения
show at (,5,,);
table Podr;
  fields
    sVID_PROIZV   ('ВА "Вид производства"',,sci13Esc) : protect,PickButton;

<<



                        Вид производства .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

//--------------------------------------------
// Обработчик событий интерфейса
//--------------------------------------------
HandleEvent
//--------------------------------
cmOnVipLoad:
{ timelog_init;
  pVA_VID_PROIZV  :=ExtAttr_ID(coCatalogs,'Вид производства');
  pVA_VID_PROIZV_H:=ExtAttr_ID(coCatHist,'Вид производства');
  if  inherited :: handleEvent (cmOnVipLoad)=heAbort then Abort;
} //cmOnVipLoad:

//--------------------------------
cmPick:
{ //----------------------------------
  if inherited::handleEvent(cmpick)=heAbort Abort;
  //----------------------------------
  case curField of
  #sVID_PROIZV:
  { refAttrTablePick.PickValue ( coCatalogs, pVA_VID_PROIZV, Podr.nrec );
    ReScanPanel(#Podr);
  }
  end;
} //cmPick:
end;//HandleEvent
end. //Alter Interface SHR_RPD_1;
