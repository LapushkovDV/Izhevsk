#include GP_FormT12.vih

#component "Z_Sredn"

// Подавляем предупреждение "Метод интерфейса "SICKLEAVESFORMATION.FillBlisnet" ... не был использован"
#errorlevel 0
alter interface SickLeavesFormation;

  #include GP_FormT12.var

  overload
    procedure FillBlisnet;
  end;

  procedure FillBlisnet;
  begin
    // Если в настройке "Управление персоналом \ Табельный учет \ Создавать корректировочные табели
    // при внесении больничного за прошлый период" установлено значение "да"
    if boGetTune('UP.WT.AUTO_COPY_TBL_BL') then
      // При групповом формировании больничных в случае, если дата начала больничного меньше даты начала
      // отчетного периода модуля Зарплата
      if DataN < dGetTune('UP.DATOTCH') then
        // Создаем копии табелей за период больничного для всех выбранных работников
        _loop FORMARKS
        begin
          oGP_FormT12.CopyLSTabs(Cur_Date, Lschet.NRec, DataN, DataOk, false, false);
        end;
    inherited::FillBlisnet;
  end;
end.
#errorlevel reset
