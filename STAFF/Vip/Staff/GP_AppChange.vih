#ifndef __GP_AppChange_vih__
#define __GP_AppChange_vih__

#component "GP_Staff"

objInterface GP_AppChange_Obj;

//Возвращает "Менялось назначение" если Менялось назначение, иначе ''
//По указанному человеку cPerson
//От указанной даты dDate отнимается количество указанных месяцев iMonths
//В этом диапазоне производится поиск назначений вида прием и перемещение
//Если в диапазоне находится хотя бы одно назначение отличающееся от эталонного cSelfAppoint
//Функция возвращает положительный результат
function State(cPerson, cSelfAppoint : comp; dDate : date; iMonths : integer) : string;

end;

vipInterface GP_AppChange Implements GP_AppChange_Obj;
#endif
