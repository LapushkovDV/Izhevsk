  // ***************

  // Доп. обработка неявки для формы ЭМ
  procedure ProcessAbsenceEM(absenceIndex: Integer; dayNo: Byte; kind: Word);
  var
    mark: String[5];
    hours: Double;
    hoursGr: Double;
    days: Double;
    MappedOn: Boolean;
  begin
    // отклонение с типом "уменьшение" либо "увеличение"  
    if kind = akTableAbsence then
    begin
      hours := 0;
      // получаем условное обозначение неявки
      if // WT_GetMonthlyAbsenceAttribute(absenceIndex, aaMark, mark) and
        WT_GetMonthlyAbsenceAttribute(absenceIndex, aaHours, hours) then
      begin
        if hours = 0 then
          exit;
        // в зависимости от настройки берем либо системный, либо пользовательский код
        if PreferredAbsenceCoding = 0 then
          mark := AC.GetStandardCode(atMonthly, AbsenceIndex, To_Date(dayNo, pMonth, pYear), MappedOn)
        else
          mark := AC.GetUserCode(atMonthly, AbsenceIndex, To_Date(dayNo, pMonth, pYear), MappedOn);
        /*
        oGP_Log.Info('*** День: ' + To_Char(dayNo) + ' kind: ' + To_Char(kind) + ' mark: ' + mark + ' ' + 
         ' hours: ' + To_Char(hours, 0, 2) + 
         ' TmpFormT12.DHours[' + To_Char(dayNo) + ']: ' + To_Char(TmpFormT12.DHours[dayNo], 0, 2) +
         ' MappedOn: ' + To_Char(MappedOn));
        */
        if MappedOn then
        begin
          // Рассчитываем кол-во дней
          hoursGr := WT_GetHoursInDay(dayNo, hkWholeWorking, stPlanned);
          if hoursGr != 0 then
            days := Round(hours / hoursGr, 2)
          else
            days := 1;
          oGP_Log.Info('hoursGr: ' + To_Char(hoursGr, 0, 2) + ' days: ' + To_Char(days, 0, 2));
          // помечаем день в третьей строке
          SetMarkAdd(dayNo, mark, hours);
          SummableAbsence(mark, hours, days);
        end;
      end;
    end;
  end;

  // Дополнительный анализ табеля для расчета показателей, которых нет в оригинальной форме табеля
  // В момент запуска функции табель уже загружен и установлен фильтр по датам периода
  procedure AnalysisForEM;
  var
    I: Byte;
    _Hours: Double;
  begin
    // Если есть "второй слой" пометок дней, скопируем его в третью строку
    if UseSecondaryDays then
      for (I := AD_DayNo(TmpFormT12.DBeg); I <= AD_DayNo(TmpFormT12.DEnd); I++)
        SetMarkAdd(I, MarkDaySecondary[I], 0);

    for (I := AD_DayNo(TmpFormT12.DBeg); I <= AD_DayNo(TmpFormT12.DEnd); I++)
    begin
      if TmpFormT12.DMark[I] = MARK_WEEKEND then
        TmpFormT12.TV += 1; // Кол-во выходных и праздничных дней
      // Ночные
      _Hours := WT_GetHoursInDayEx(I, hkNight, stActual, 0);
      if _Hours != 0 then
      begin
        SetMarkAdd(I, MARK_NIGHT_WORK, _Hours);
        TmpFormT12.TN += _Hours;
      end;
      // Часы работы по приказу на сверхурочную работу за оплату 
      _Hours := WT_GetHoursInDayEx(I, hkOvertimeWorkOrder, stActual, 0);
      if _Hours != 0 then
      begin
        SetMarkAdd(I, MARK_OVERTIME_WORK, _Hours);
        TmpFormT12.TN += _Hours;
      end;
      // Работа в выходные
      if TmpFormT12.DMark[I] = MARK_WORK_ON_WEEKEND then
      begin
        TmpFormT12.TRBDays += 1;
        TmpFormT12.TRBHours += TmpFormT12.DHours[I];
      end;
      // Работа в выходные с компенсацией отпуском
      if TmpFormT12.DMark[I] = MARK_WORK_ON_WEEKEND_COMP then
      begin
        TmpFormT12.TRODays += 1;
        TmpFormT12.TROHours += TmpFormT12.DHours[I];
      end;
    end;
    // TestAbsences;
  end;

  function ProcessPeriod(_DBeg: Date; _DEnd: Date; _cPosition: Comp; _Kateg: Word): Boolean;
  begin
    // Если дата окончания периода меньше даты начала отчетного периода
    if _DEnd < pDBeg then
      exit;
    // Если дата начала периода больше даты окончания отчетного периода
    if _DBeg > pDEnd then
      exit;
    if _DBeg < pDBeg then
      _DBeg := pDBeg;
    if _DBeg < LSchet.DatPos then
      _DBeg := LSchet.DatPos;
    if LSchet.DatUv != ZeroDate then
      if _DEnd > LSchet.DatUv then
        _DEnd := LSchet.DatUv;
    ClearBuffer(#SPeriods);
    SPeriods.DBeg := _DBeg;
    SPeriods.DEnd := _DEnd;
    SPeriods.cPosition := _cPosition;
    SPeriods.Kateg := _Kateg;
    if insert current SPeriods != tsOk then
    begin
      result := false;
      oGP_Log.Error('Не удалось добавить запись в таблицу SPeriods');
    end else
      result := true;
  end;

  // Формирует список периодов по текущему лицевому счету
  function FillSPeriods: Boolean;
  var
    _DBeg: Date;
    _cPosition: Comp;
    _Kateg: Word;
  begin
    result := false;

    if (delete all from SPeriods) != tsOk then
      exit;

    oGP_Log.Info(' Табель: Должность: ' + ICatFunc.GetCatalogsName(LSTab.cAppoint));

    _DBeg := pDBegPer;
    if _DBeg < LSchet.DatPos then
      _DBeg := LSchet.DatPos;
    _cPosition := LSTab.cAppoint;
    _Kateg := LSTab.Kateg;

    _loop Perexod
    begin
      // Обрабатываем только переходы, в которых изменялась должность или категория
      if _cPosition = Perexod.cAppoint and _Kateg = Perexod.Kateg then
        continue;
      oGP_Log.Info(' Переход: с ' + oGP_SF.DateToStrE(Perexod.DatIzm) + ' Должность: ' + ICatFunc.GetCatalogsName(Perexod.cAppoint));
      // if Perexod.DatIzm != pDBeg then
      // begin
      if not ProcessPeriod(_DBeg, Add_Day(Perexod.DatIzm, -1), _cPosition, _Kateg) then
        exit;
      _DBeg := Perexod.DatIzm;
      // end;
      _cPosition := Perexod.cAppoint;
      _Kateg := Perexod.Kateg;
    end;

    if not ProcessPeriod(_DBeg, pDEnd, _cPosition, _Kateg) then
      exit;
    result := true;
  end;

  // Анализирует данные по одному лицевому счету, формирует одну или несколько строк формы
  // и записывает результат в таблицу TmpFormT12
  function GenerateFormData(_cLSchet: Comp): Boolean;
  begin
    result := false;
    set pcCurLSchet := _cLSchet;
    if not IsValidAll(tnLSchet) then
    begin
      oGP_Log.Error('Не найдена запись в таблице LSchet (LSchet.NRec = ' + To_Char(_cLSchet, 0, 0) + ')');
      exit;
    end;
    oGP_Log.Info('');
    oGP_Log.Info('Таб.№ ' + GetStrTabN(LSchet.TabN, LSchet.StrTabN) + ' ' + Persons.FIO + 
     '  принят: ' + oGP_SF.DateToStrE(LSchet.DatPos) + 
     '  уволен: ' + oGP_SF.DateToStrE(LSchet.DatUv)
    );
    // Если поступил после окончания отчетного периода
    if LSchet.DatPos > pDEnd then
      exit;
    // Если уволен до начала отчетного периода
    if LSchet.DatUv != ZeroDate then
      if LSchet.DatUv < pDBeg then
        exit;

    if not IsValidAll(tnLSTab) then
    begin
      oGP_Log.Error('Не найден табель работника за ' + DateToStr(pDBeg, 'MM.YYYY') + 
       ' (Таб.№ ' + GetStrTabN(LSchet.TabN, LSchet.StrTabN) + ')');
      exit;
    end;

    if LoadWorkingTable(LSchet.NRec, pMonth, pYear) != 0 then
    begin
      oGP_Log.Error('Не удалось загрузить табель работника за ' + DateToStr(pDBeg, 'MM.YYYY') + 
       ' (Таб.№ ' + GetStrTabN(LSchet.TabN, LSchet.StrTabN) + ')');
      exit;
    end;

    if not FillSPeriods then
      exit;

    oGP_Log.Info(' Периоды:');
    _loop SPeriods
    begin
      oGP_Log.Info('  с ' + oGP_SF.DateToStrE(SPeriods.DBeg) + 
       ' по ' + oGP_SF.DateToStrE(SPeriods.DEnd) +
       ' должность: ' + ICatFunc.GetCatalogsName(SPeriods.cPosition)
      );
      ClearBuffer(#TmpFormT12);
      TmpFormT12.DBeg := SPeriods.DBeg;
      TmpFormT12.DEnd := SPeriods.DEnd;
      TmpFormT12.cLSchet := LSchet.NRec;
      TmpFormT12.TabN := LSchet.TabN;
      TmpFormT12.StrTabN := LSchet.StrTabN;
      TmpFormT12.PersonName := Persons.FIO;
      TmpFormT12.cPosition := SPeriods.cPosition;
      TmpFormT12.Kateg := SPeriods.Kateg;

      // Заполняем данные по дням на основании алгоритмов из стандартной формы (PrintT13.vip)
      WT_ResetFilter;
      ProcessNotation;
      AnalysisForEM;
      ProcessOrders;

      if insert current TmpFormT12 != tsOk then
      begin
        oGP_Log.Error('Не удалось добавить запись в таблицу TmpFormT12');
        exit;
      end;

      SPeriods.cTmpFormT12 := TmpFormT12.NRec;
      if update current SPeriods != tsOk then
      begin
        oGP_Log.Error('Не удалось обновить запись в таблице SPeriods');
        exit;
      end;
    end;

    result := true;
  end;

  //------------------------------------------------------------------------------------------------
  // Функции для создания копий табеля и работы с ними
  //------------------------------------------------------------------------------------------------
   // Создаёт копию табеля по лицевому счету с указанным NRec за указанный месяц
  function CreateCopy_Ex(_DForm: Date; _cLSchet: tNRec; _Month: Byte; _Year: Word; _ShowInfo: Boolean): Boolean;
  var
    dBeg, dEnd: Date;
  begin
    result := true;
    pcCurLSchet := _cLSchet;
    pYear       := _Year;
    set pMonth  := _Month;
    // Если нет табеля за указанный месяц нечего и копировать
    if not IsValidAll(tnLSTab) then
      exit;

    // Формируем форму в таблице в памяти
    Clear;
    dBeg := To_Date(1, _Month, _Year);
    dEnd := To_Date(Last_Day(dBeg), _Month, _Year);
    if Init(dBeg, dEnd, 0) then
    // if Init(_DBeg, _DEnd, ST_SHOW_VERBOSE_LOG) then
    begin
      // Наполняем форму данными
      GenerateFormData(_cLSchet);
      // Создаём копию
      _loop TmpFormT12
      begin
        ClearBuffer(#GP_TimeTable);
        GP_TimeTable.TabN       := LSchet.TabN;
        GP_TimeTable.StrTabN    := LSchet.StrTabN;
        GP_TimeTable.cLSchet    := _cLSchet;
        GP_TimeTable.Cex        := LSTab.Cex;
        GP_TimeTable.MonthN     := _Month;
        GP_TimeTable.YearN      := _Year;
        GP_TimeTable.DForm      := _DForm;
        GP_TimeTable.DBeg       := TmpFormT12.DBeg;
        GP_TimeTable.DEnd       := TmpFormT12.DEnd;
        GP_TimeTable.PersonName := TmpFormT12.PersonName;
        GP_TimeTable.cPosition  := TmpFormT12.cPosition;
        GP_TimeTable.Kateg      := TmpFormT12.Kateg;
        GP_TimeTable.DMark      := TmpFormT12.DMark;
        GP_TimeTable.DHours     := TmpFormT12.DHours;
        GP_TimeTable.DMarkAdd   := TmpFormT12.DMarkAdd;
        GP_TimeTable.DHoursAdd  := TmpFormT12.DHoursAdd;
        GP_TimeTable.OCode      := TmpFormT12.OCode;
        GP_TimeTable.OAcc       := TmpFormT12.OAcc;
        GP_TimeTable.OHours     := TmpFormT12.OHours;
        GP_TimeTable.ACode      := TmpFormT12.ACode;
        GP_TimeTable.ADays      := TmpFormT12.ADays;
        GP_TimeTable.AHours     := TmpFormT12.AHours;
        GP_TimeTable.Day1P      := TmpFormT12.Day1P;
        GP_TimeTable.Chas1P     := TmpFormT12.Chas1P;
        GP_TimeTable.Day2P      := TmpFormT12.Day2P;
        GP_TimeTable.Chas2P     := TmpFormT12.Chas2P;
        GP_TimeTable.TN         := TmpFormT12.TN;
        GP_TimeTable.TS         := TmpFormT12.TS;
        GP_TimeTable.TRBDays    := TmpFormT12.TRBDays;
        GP_TimeTable.TRBHours   := TmpFormT12.TRBHours;
        GP_TimeTable.TRODays    := TmpFormT12.TRODays;
        GP_TimeTable.TROHours   := TmpFormT12.TROHours;
        GP_TimeTable.TV         := TmpFormT12.TV;
        if insert current GP_TimeTable != tsOk then
        begin
          result := false;
          Message('Ошибка: Не удалось добавить запись в таблицу GP_TimeTable');
          break;
        end else begin
          if year(Cur_date)>GP_TimeTable.YearN
          or (  year(Cur_date)>GP_TimeTable.YearN
            and month(Cur_date)>GP_TimeTable.MonthN
            )
          { if getfirst GP_SCUD_PERS=tsok
             pGP_SCUD_EventsEdit.CalcAll(GP_SCUD_PERS.Nrec
             ,GP_TimeTable.YearN
             ,GP_TimeTable.MonthN
             ,2 //1
             ,true
             ,0
             );
          }
          if _ShowInfo then
            Message('Создан корректировочный табель за ' +
             DateToStr(To_Date(1, GP_TimeTable.MonthN, GP_TimeTable.YearN), 'month YYYY') + ' г.', Information);
        end;
      end;
    end;

    Done;
  end;

  // Создаёт копию табеля по лицевому счету с указанным NRec за указанный месяц (если она еще не создана),
  // в отличие от прежней версии перезаписывает копию, если табель находится в текущем бух.периоде
function CreateCopy(_DForm: Date; _cLSchet: tNRec; _Month: Byte; _Year: Word; _ReplIfExists: Boolean; _ShowInfo: Boolean): Boolean;
var dDate, dDatePer : Date;
{
  result := true;

  pcCurLSchet := _cLSchet;
  pYear       := _Year;
  set pMonth  := _Month;
  dDate := date(1,_Month, _Year);
  dDatePer := date(1, month(dGetTune('UP.DATOTCH')), year(dGetTune('UP.DATOTCH')));
    // Если нет табеля за указанный месяц нечего и копировать
  if not IsValidAll(tnLSTab) then
    exit;

    // С параметром _ReplIfExists = true эта функция вызывается вручную
  if _ReplIfExists then
  {
    if IsValidAll(tnGP_TimeTable) //Есть уже копия
    {
      if (dDatePer > dDate)//если табель за прошлый бух период - копию не перезаписываем
        exit;

      if delete GP_TimeTableS where ((_cLSchet == GP_TimeTableS.cLSchet
                                  and _Year    == GP_TimeTableS.YearN
                                  and _Month   == GP_TimeTableS.MonthN)) != tsOk
      {
        Message('Ошибка: Не удалось удалось удалить запись из таблицы GP_TimeTable');
        exit;
      }
    }
  }
  else
  {
    // С параметром _ReplIfExists = false эта функция вызывается автоматически при создании больничного за прошлый период
    // если уже есть хоть одна копия
    if IsValidAll(tnGP_TimeTable) then
      exit;// новую копию не создаём
  }
  //удалим записи, за позапрошлый год
  var wYear : word = _Year-1;
  delete all GP_TimeTableS where ((_cLSchet == GP_TimeTableS.cLSchet
                                  and wYear >> GP_TimeTableS.YearN));


  Result := CreateCopy_Ex(_DForm, _cLSchet, _Month, _Year, _ShowInfo);
}

  // Копирует текущую запись из таблицы GP_TimeTable в таблицу TmpFormT12
  function LoadCurRec: Boolean;
  begin
    result := true;
    ClearBuffer(#TmpFormT12);
    TmpFormT12.TabN         := GP_TimeTableS.TabN;
    TmpFormT12.StrTabN      := GP_TimeTableS.StrTabN;
    TmpFormT12.cLSchet      := GP_TimeTableS.cLSchet;
    TmpFormT12.DBeg         := GP_TimeTableS.DBeg;
    TmpFormT12.DEnd         := GP_TimeTableS.DEnd;
    TmpFormT12.PersonName   := GP_TimeTableS.PersonName;
    TmpFormT12.cPosition    := GP_TimeTableS.cPosition;
    TmpFormT12.Kateg        := GP_TimeTableS.Kateg;
    TmpFormT12.DMark        := GP_TimeTableS.DMark;
    TmpFormT12.DHours       := GP_TimeTableS.DHours;
    TmpFormT12.DMarkAdd     := GP_TimeTableS.DMarkAdd;
    TmpFormT12.DHoursAdd    := GP_TimeTableS.DHoursAdd;
    TmpFormT12.OCode        := GP_TimeTableS.OCode;
    TmpFormT12.OAcc         := GP_TimeTableS.OAcc;
    TmpFormT12.OHours       := GP_TimeTableS.OHours;
    TmpFormT12.ACode        := GP_TimeTableS.ACode;
    TmpFormT12.ADays        := GP_TimeTableS.ADays;
    TmpFormT12.AHours       := GP_TimeTableS.AHours;
    TmpFormT12.Day1P        := GP_TimeTableS.Day1P;
    TmpFormT12.Chas1P       := GP_TimeTableS.Chas1P;
    TmpFormT12.Day2P        := GP_TimeTableS.Day2P;
    TmpFormT12.Chas2P       := GP_TimeTableS.Chas2P;
    TmpFormT12.TN           := GP_TimeTableS.TN;
    TmpFormT12.TS           := GP_TimeTableS.TS;
    TmpFormT12.TRBDays      := GP_TimeTableS.TRBDays;
    TmpFormT12.TRBHours     := GP_TimeTableS.TRBHours;
    TmpFormT12.TRODays      := GP_TimeTableS.TRODays;
    TmpFormT12.TROHours     := GP_TimeTableS.TROHours;
    TmpFormT12.TV           := GP_TimeTableS.TV;
    if insert current TmpFormT12 != tsOk then
    begin
      result := false;
      Message('Ошибка: Не удалось добавить запись в таблицу TmpFormT12');
      exit;
    end;
  end;

  // Копирует указанную запись из таблицы GP_TimeTableS в таблицу TmpFormT12
  function LoadCopy(_cGP_TimeTable: tNRec): Boolean;
  begin
    result := false;
    if getFirst GP_TimeTableS where ((_cGP_TimeTable == GP_TimeTableS.NRec)) != tsOk then
    begin
      Message('Ошибка: Не найдена запись в таблице GP_TimeTable (GP_TimeTable.NRec = ' + To_Char(_cGP_TimeTable, 0, 0) + ')');
      exit;
    end;
    result := LoadCurRec;
  end;

  // Копирует все копии табеля по лицевому счету с указанным NRec за указанный месяц из таблицы GP_TimeTableS в таблицу TmpFormT12
  /*
  function LoadCopies(_cLSchet: tNRec; _Month: Byte; _Year: Word): Boolean;
  begin
    result := true;
    _loop GP_TimeTableS where ((
          _cLSchet == GP_TimeTableS.cLSchet
      and _Month   == GP_TimeTableS.MonthN
      and _Year    == GP_TimeTableS.YearN
    ))
    begin
