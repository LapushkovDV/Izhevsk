  // Копирует табели за указанный период, если дата начала периода меньше даты начала отчетного периода модуля Зарплата
  procedure CopyLSTabs(_DForm: Date; _cLSchet: tNRec; _FromDate: Date; _ToDate: Date; _ReplIfExists: Boolean; _ShowInfo: Boolean);
  var
    DatOtch: Date;
    D: Date;
    M: Byte;
    Y: Word;
  begin
    // Если дата с или дата по пустая, ничего не копируем
    if _FromDate = ZeroDate or _ToDate = ZeroDate then
      exit;
    DatOtch := dGetTune('UP.DATOTCH');
    M := Month(_FromDate);
    Y := Year(_FromDate);
    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, ''#3'Создание копии табеля...'#13, 0);
    while true do
    begin
      if not NextVisual then
        break;
      D := To_Date(1, M, Y);
      if D >= DatOtch then
        break;
      if D > _ToDate then
        break;
      CreateCopy(_DForm, _cLSchet, M, Y, _ReplIfExists, _ShowInfo);
      if M = 12 then
      begin
        M := 1;
        Y++;
      end else
        M++;
    end;
    StopVisual('', 0);
  end;

  handleEvent
    cmOnVipLoad:
      begin
        pDBeg := ZeroDate;
        pDEnd := ZeroDate;
        // объект работа с условными обозначениями выходного
        LoadVipRef(Weekend, 'WeekendMarker');
      end;
  end;

end.
