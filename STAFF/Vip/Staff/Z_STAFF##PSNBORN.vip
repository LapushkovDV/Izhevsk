#component "Z_Staff"

alter interface PSNBORN;

   ExtendFormats brPsn;

 browse brPsn;
 show at (,);
table MyTmpForPers;
   fields
    { Font = { Color = if (RedColor, ColorNotOk, 0 )}};
     VisPers.StrTabN 'Таб. номер' ('Табельный номер '): [10], protect, noAutoSize;
     CatPost.name 'Должность' ('Должность '): [ 25], skip, NoAutoSize;
     CatDep.code  'Цех' ('Код подразделения '): [ 8], skip, NoAutoSize, Centered;
  end;

end.
