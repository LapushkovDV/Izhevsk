table struct ttRepPADL
(
  nRec      : comp,
  cPodr     : comp,
  sPodr     : string,
  sPodrN    : string,
  iPodr     : integer,
  iAllWork  : double,//integer,
  iAllWorkSP: double,//integer,
  iUvolSP   : double,//integer,
  iAllDiss  : integer,
  iRng1Diss : integer,
  iRng2Diss : integer,
  iRng3Diss : integer,
  iStajDiss : integer,
  iAllDissL : integer,
  iRng1DissL: integer,
  iRng2DissL: integer,
  iRng3DissL: integer,
  iStajDissL: integer,
  dbLiq     : double
)
with index
(
  ttRepPADL00 = nRec(Surrogate),
  ttRepPADL01 = cPodr,
  ttRepPADL02 = sPodr
);

table struct ttSSC
(
  cPodr     : comp,
  dDatCur   : date,
  lKolWork  : longint
)
with index
(
  ttSSC00 = cPodr + dDatCur
);

table struct ttTypeDiss
(
  nRec      : comp,
  cTypeDiss : comp,
  sTypeDiss : string,
  sSort     : string
)
with index
(
  ttKlTypeDiss00 = nRec(Surrogate),
  ttKlTypeDiss01 = cTypeDiss,
  ttKlTypeDiss02 = sTypeDiss(Desc),
  ttKlTypeDiss03 = sSort + sTypeDiss
);

table struct ttDissByType
(
  nRec      : comp,
  cRepPADL  : comp,
  cTypeDiss : comp,
  iDiss     : integer
)
with index
(
  ttDissByType00 = nRec(Surrogate),
  ttDissByType01 = cRepPADL + cTypeDiss
);

table struct ttLog
(
  wMode  : word,
  sWho   : string,
  sReason: string
)
with index
(
  ttLog01 = wMode + sWho
);