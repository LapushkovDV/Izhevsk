#include CatFunc.vih         // ”ã­ªæ¨¨ à ¡®âë á Catalogs
#include StrFunc.vih         // ”ã­ªæ¨¨ à ¡®âë á® áâà®ª ¬¨
#include DeptIer.vih         // ”ã­ªæ¨¨ à ¡®âë á ¯®¤à §¤¥«¥­¨ï¬¨
#include AppFuncs.vih

#define RD 103 //#(RD)

#doc
¥ç âì £àã¯¯®¢®£® ¯à¨ª §  "¥¥áâà à ¡®â­¨ª®¢ ­  ª®¬¯¥­á æ¨î áâ®¨¬®áâ¨ ¯à®¥§¤  ª ¬¥áâã à ¡®âë ¨ ®¡à â­®" „ #(RD)
#end
interface GP_NFormRD#(RD) '¥¥áâà à ¡®â­¨ª®¢ ­  ª®¬¯¥­á æ¨î áâ®¨¬®áâ¨ ¯à®¥§¤  ª ¬¥áâã à ¡®âë ¨ ®¡à â­®' (,,scStaffEmplMain) EscClose;
  show at (00,05,80,15);

table struct ttReport
(
  sPodr : string
, sTbNmb: string
, sFIO  : string
, sPost : string
, sDogN : string
, dbKomp: double
, dbUder: double
, sSpoOp: string
, wSpoOp: word
)
with index
(
  ttReport01 = sFIO
);

Create view MakeReport1View
var
  cDoc       : comp;
  PersNrec   : comp;
  iOper      : integer;
  iCatFunc   : CatalogsFunctions;   // ¥à¥¬¥­­ ï â¨¯  ¨­â¥àä¥©á CatalogsFunctions
  iStrFunc   : StringFunctions;     // ¥à¥¬¥­­ ï â¨¯  ¨­â¥àä¥©á StringFunctions
  iAppFunc   : AppointmentsFunctions;
  IDepartIer : DepartIer;           // ¥à¥¬¥­­ ï â¨¯  ¨­â¥àä¥©á DepartIer
  cDopSog    : comp;

as  select
  *

from
  Persons
, Appointments
, TitleDoc
, PartDoc
, ContDoc
, fortune
, ContDoc contdoc102
, raisehist raisehist102
, ttReport (ttReport01)
, SpAllStaff SpAS_Cnt
, SpAllStaff SpAS_Agr

where
((              cDoc == TitleDoc.Nrec             
and            iOper == PartDoc.TypeOper          
and    TitleDoc.Nrec == PartDoc.cDoc              
and     PartDoc.Nrec == ContDoc.cPart             
and PartDoc.TypeOper == ContDoc.TypeOper
and   ContDoc.Person == Persons.Nrec              
and     ContDoc.cStr == Appointments.Nrec         
and     ContDoc.nRec == fortune.CFCONT
and     Persons.Nrec == contdoc102.person
and              102 == contdoc102.typeoper
and  contdoc102.nRec == raisehist102.CCONTDOC

and                    7 == SpAS_Cnt.wNoCon  //ˆé¥¬ ááë«ªã ­  ¤®¯á®£« è¥­¨¥ ®â®¡à ¦ ¥¬®¥ ­¥¯®áà¥¤áâ¢¥­­® ¢ ¯à¨ª §¥
and              cDopSog == SpAS_Cnt.CLINKT  //­¥§ ¢¨á¨¬® ®â â®£® çâ® ¢ ª àâ®çª¥
and                    0 == SpAS_Cnt.INUM    //¤®¯á®£« è¥­¨¥ ¨§ ª àâ®çª¨ ãáâ à¥«®?
and            coContDoc == SpAS_Cnt.WCHOISE 
and      SpAS_Cnt.cBaseT == SpAS_Agr.nRec
))
;
parameters cDoc, iOper;


DataStream DTS_NForm#(RD)
(
  [RepOnDate]    DateToStr(TitleDoc.DocDate,'month') + ' ' +DateToStr(TitleDoc.DocDate,'YYYY') + ' £®¤ .';
  [sSignPost]    iAppFunc.GetAppPost(iAppFunc.GetAppNrec_OnDate(coGetTune('UP.STAFF.SIGNATORYAUTHORITY'),cur_date));
  [sSignFIO]     iStrFunc.GetFIO(sGetTune('UP.STAFF.SIGNATORYAUTHORITY'));
  table ttReport
  (
    [CodePodr]  ttReport.sPodr; 
    [TabNmb]    ttReport.sTbNmb;
    [FIO]       ttReport.sFIO;
    [Post]      ttReport.sPost;
    [NoDogGost] ttReport.sDogN;
    [SumKomp]   ttReport.dbKomp;
  );
)// DataStream DTS_NForm
end;
//ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ
//  ¯¥ç âì ¢ FasrReport
//ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ
Procedure PrintNForm#(RD)FR;
{
  if isvalid(#TitleDoc)
  if isvalid(#PartDoc)
  _loop PartDoc
  {
    if isvalid(#ContDoc)
    _loop ContDoc
    {
        ClearBuffer(#ttReport);
        if isvalid(#Persons)
        {
          ttReport.sTbNmb:= if (Appointments.lPrizn = 0, GetStrTabn(Persons.TabNmb,Persons.StrTabn), 
                                                         GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN));
          ttReport.sFIO  := Persons.FIO;    
        }
        if isvalid(#Appointments)
        {
          ttReport.sPodr := IDepartIer.GetCodeOnDate(Appointments.Department,if (Day(TitleDoc.DocDate) > 0, TitleDoc.DocDate, Cur_Date));
          ttReport.sPost := if ( boGetTune('UP.STAFF.USE_LONGNAME_ANK'),trim(iCatFunc.GetCatalogsLongName(Appointments.Post)),
                                                                        trim(iCatFunc.GetCatalogsName(Appointments.Post)));
        }
        if isvalid(#fortune)
        {
          if isvalid(#contdoc102)
            _loop contdoc102
              if isvalid(#raisehist102)
                _loop raisehist102
                  if Fortune.DocDate >= raisehist102.dRec and Fortune.DocDate <= raisehist102.dDat2
                    cDopSog := contdoc102.nRec;
        
          ttReport.dbKomp := fortune.DocSum;
        }
        if isvalid(#SpAS_Cnt)
          if isvalid(#SpAS_Agr)
            ttReport.sDogN   := SpAS_Agr.RESSTRING[1]+' ®â '+datetostr(SpAS_Agr.RESDATE[1],'DD.MM.YYYY');
        insert current ttReport;
    }
  }
  RunFReport(DTS_NForm#(RD), '', False);
}

//ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ
HandleEvent
cmInit:
  {
    PrintNForm#(RD)FR;
    CloseInterface(cmDefault);
  }       // cmInit
end;      // HandleEvent
end.
