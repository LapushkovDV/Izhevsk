function bSetRepParam : boolean;  
{
  result := false;
  if RunWindowModal(WinRKParamEx)=cmDefault
    result := true;
}//function bSetRepParam
Function GetReportName: String;
{
  GetReportName := '#(GPNam) (ЭМ)';
}
function GetPriority : Integer;
{
  GetPriority := 12;
}
procedure initRKStatRepParam;
{
  initRK;
}
function dRepOnDateParam : date;
{
  dRepOnDateParam := dRep;
}
//--------------------------------------------------------
handleevent
  cmInit:
  {
    isStayAloneAll := true;
    PrintRepPage(true);
  }
  cmPick:
  {
    case CurField of
      #sKatWorker1:
        if (RunInterface('PICKKAT1', 0, mKatWorker1, vfMultipleSelection) = cmDefault)
          set sKatWorker1 := sSetKatName(mKatWorker1);
      #sKatWorker2:
        if (RunInterface('PICKKAT1', 0, mKatWorker2, vfMultipleSelection) = cmDefault)
          set sKatWorker2 := sSetKatName(mKatWorker2);
      #sKatWorker3:
        if (RunInterface('PICKKAT1', 0, mKatWorker3, vfMultipleSelection) = cmDefault)
          set sKatWorker3 := sSetKatName(mKatWorker3);
      #sKatWorker4:
        if (RunInterface('PICKKAT1', 0, mKatWorker4, vfMultipleSelection) = cmDefault)
          set sKatWorker4 := sSetKatName(mKatWorker4);

      #sKatType1:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType1) = cmDefault)
          set sKatType1 := sSetTypName(mKatType1);
      #sKatType2:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType2) = cmDefault)
          set sKatType2 := sSetTypName(mKatType2);
      #sKatType3:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType3) = cmDefault)
          set sKatType3 := sSetTypName(mKatType3);
      #sKatType4:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType4) = cmDefault)
          set sKatType4 := sSetTypName(mKatType4);
      #sKatType5:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType5 ) = cmDefault)
          set sKatType5 := sSetTypName(mKatType5 );
      #sKatType6:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType6 ) = cmDefault)
          set sKatType6 := sSetTypName(mKatType6 );

      #sKatEdu1:
        if (RunInterface('PICKCATALOGEX', 701, 0, Comp(100), mKatEdu1 ) = cmDefault)
          set sKatEdu1 := sSetTypName(mKatEdu1 );
      #sKatEdu2:
        if (RunInterface('PICKCATALOGEX', 701, 0, Comp(100), mKatEdu2 ) = cmDefault)
          set sKatEdu2 := sSetTypName(mKatEdu2 );
      #sKatEdu3:
        if (RunInterface('PICKCATALOGEX', 701, 0, Comp(100), mKatEdu3 ) = cmDefault)
          set sKatEdu3 := sSetTypName(mKatEdu3 );

      #sPodr1:
        if (RunInterface('PICKCATALOGEX', -11, 0, Comp(100), mPodr1) = cmDefault)
          set sPodr1 := sSetPodrName(mPodr1);
      #sToExistFile:
      {
        set sToExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
      #sFromExistFile:
      {
        set sFromExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sKatWorker1: {ClearMarker(mKatWorker1); set sKatWorker1 := sSetKatName (mKatWorker1);}
      #sKatWorker2: {ClearMarker(mKatWorker2); set sKatWorker2 := sSetKatName (mKatWorker2);}
      #sKatWorker3: {ClearMarker(mKatWorker3); set sKatWorker3 := sSetKatName (mKatWorker3);}
      #sKatWorker4: {ClearMarker(mKatWorker4); set sKatWorker4 := sSetKatName (mKatWorker4);}

      #sKatType1:   {ClearMarker(mKatType1 );  set sKatType1   := sSetTypName (mKatType1 );}
      #sKatType2:   {ClearMarker(mKatType2 );  set sKatType2   := sSetTypName (mKatType2 );}
      #sKatType3:   {ClearMarker(mKatType3 );  set sKatType3   := sSetTypName (mKatType3 );}
      #sKatType4:   {ClearMarker(mKatType4 );  set sKatType4   := sSetTypName (mKatType4 );}
      #sKatType5:   {ClearMarker(mKatType5 );  set sKatType5   := sSetTypName (mKatType5 );}
      #sKatType6:   {ClearMarker(mKatType6 );  set sKatType6   := sSetTypName (mKatType6 );}

      #sKatEdu1:    {ClearMarker(mKatEdu1 );   set sKatEdu1    := sSetTypName (mKatEdu1 );}
      #sKatEdu2:    {ClearMarker(mKatEdu2 );   set sKatEdu2    := sSetTypName (mKatEdu2 );}
      #sKatEdu3:    {ClearMarker(mKatEdu3 );   set sKatEdu3    := sSetTypName (mKatEdu3 );}

      #sPodr1:      {ClearMarker(mPodr1);      set sPodr1      := sSetPodrName(mPodr1);}
      #sToExistFile:{set sToExistFile:='';}
      #sFromExistFile:{set sFromExistFile:='';}
    end;
  }
  cmCheckField:
  {
    case CurField of
      #wToExistFile:
      {
        if wToExistFile = 1 
          ToggleFieldVisible(#sToExistFile,true )
        else
          ToggleFieldVisible(#sToExistFile,false);
      }
      #wFromExistFile:
      {
        if wFromExistFile = 1 
          ToggleFieldVisible(#sFromExistFile,true )
        else
          ToggleFieldVisible(#sFromExistFile,false);
      }
    end;
  }
end;


End.
//---------------------------------------------------------------------------------
#include UserReport.vih
VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;
Procedure Run;
{
  runinterface(#(GPInt));
}
Function GetReportName: String;
{
  GetReportName := '#(GPNam) (ЭМ)';
}
Function GetGroupName (Level : Word) : String;
{
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Формы "Роскосмоса"';
  End;
}
function GetPriority : Integer;
{
  GetPriority := 3;
}
function VisibleInModule(Ind : Byte) : String;
{
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
}
End.
