window WinRKParamEx 'Параметры формирования. Лист 12-к.' Gray;
  show at (,,95,34);
Screen sEx(,,sci1Esc);
  fields
    dRep   ('Дата формирования'): {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    sPodr1 ('Выбранные подразделения',hcStaffAppDepartment,sci13Esc): Protect, PickButton ;
    sKatWorker1 ('Руководители',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker1 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatWorker2 ('Специалисты' ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker2 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatWorker3 ('Служащие'    ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker3 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatWorker4 ('Рабочие'     ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatWorker4 = 'Не выбраны категории', ColorNeed, 0)}},protect;
    sKatType1   ('Административно управленческий персонал',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType1 = 'Не задано', ColorNeed, 0)}},protect;
    sKatType2   ('ИТР'                                    ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType2 = 'Не задано', ColorNeed, 0)}},protect;
    sKatType3   ('Основные рабочие'                       ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType3 = 'Не задано', ColorNeed, 0)}},protect;
    sKatType4   ('Производственные рабочие'               ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType4 = 'Не задано', ColorNeed, 0)}},protect;
    sKatType5   ('Вспомогательные рабочие'                ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType5 = 'Не задано', ColorNeed, 0)}},protect;
    sKatType6   ('Персонал непромышленной сферы'          ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatType6 = 'Не задано', ColorNeed, 0)}},protect;
    sKatEdu1    ('Общее образование'                      ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatEdu1  = 'Не задано', ColorNeed, 0)}},protect;
    sKatEdu2    ('Среднее профессиональное образование'   ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatEdu2  = 'Не задано', ColorNeed, 0)}},protect;
    sKatEdu3    ('Высшее образование'                     ,, scStaffKatPodrRefsPick): {Font = {BackColor = if(sKatEdu3  = 'Не задано', ColorNeed, 0)}},protect;
    wFromExistFile('Считать данные за прошлый период из файла'), noprotect;
    sFromExistFile('Считать данные за прошлый период из файла',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sToExistFile = '', ColorNeed, 0)}},protect;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
<< 'Параметры отчета'

 `Дата формирования       `.@@@@@@@@@@@
 `Подразделения для отчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Соответствие категорий`
  `Руководители`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Специалисты `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Служащие    `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Рабочие     `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Административно управленческий персонал      `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Основной производственный персонал         `
   `ИТР                                        `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   `Основные рабочие                           `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   `Производственные рабочие                   `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   `Вспомогательные рабочие                    `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Персонал непромышленной сферы                `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  `Виды образований                           `
   `Общее образование                          `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   `Среднее профессиональное образование       `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   `Высшее образование                         `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  [.] Считать данные за прошлый период из файла`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   <. ~С~охранить .>                                                        <. ~З~акрыть .>
>>
end;
HandleEvent
  cmOK:
  {
    SaveRK;
    initRK;
    if not isCheckRepParam(true)
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
  cmCancel:
  {
    SaveRK;
    CloseWindowEx(CurWindow,cmCancel);
  }
end;
end;//WinRKParamEx
