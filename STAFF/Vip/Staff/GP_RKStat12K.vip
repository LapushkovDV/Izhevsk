#include TotalOrganizationAttributes.var

table struct ttStatRK
(
  wAgeBl   : word
, wEduRw   : word
, wCol     : word
, lVal     : array [0..1] of longint
)
with index
(
  ttStatRK01 = wAgeBl + wEduRw + wCol
);
table struct ttSpecRK
(
  cPsn      : comp
, isInRep   : boolean
, sFIO      : string
, dAppoint  : date
, dDismiss  : date
, cLevel    : array [0..1] of comp
, dEduc     : array [0..1] of date
, dBorn     : date
, wAge      : array [0..1] of word
, dPens     : date
, cKat      : array [0..1] of comp
, cAdChar   : array [0..1] of comp
, cDegree   : array [0..1] of comp
, dDegree   : array [0..1] of date
, sPlWrk    : array [0..1] of string[5]
, isError   : boolean
, sWhatError: string
)
with index
(
  ttSpecRK00 = cPsn
, ttSpecRK01 = sFIO
);

table struct mtForError
(
  lRowError: longint
);

#ifdef RKSTATDEBUG
  File LogFile;
#endif



