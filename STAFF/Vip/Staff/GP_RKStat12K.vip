function OpenNewRKS : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExistRKS : boolean;
{
  result := false;
  if xlOpenExcel(true)
  {
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlOpenWorkBook(sToExistFile)
      result := true;
  }
}

function SetParamRK : boolean;
{
  result := false;
  if RunWindowModal(WinRKParam)=cmDefault
    result := true;
}

function sKatEmpl(cAny : comp) : string; cacheable;
{
  result := '';
  if GetFirst KlKatego where ((cAny == KlKatego.NRec)) = tsOk
    result := KlKatego.NaiKat;
}

procedure PrintRash;
{
  var lLine : longint;
  var lRB, lRE, lCB, lCE : longint = 1;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Печать расшифровки.', 0);
  lRB := lRE := 2;
  lCB := 1;
  lLine:=0;
  xlMergeCells(1,1,1,4);
  xlSetCellStringValue('Расшифровка листа 12-к. Данные на '+datetostr(dRep,'DD.MM.YYYY')+'.',1,1,1,1);
  if isvalid(#ttSpecRK)
  {
/*
    var lRecCount: longint = recordsintable(#ttSpecRK);
*/
    
    lCE := 0;
    //'+chr(10)+'
    lCE++; xlSetCellStringValue('№пп',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('ФИО',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Вид'+chr(10)+'работы',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'приема'+chr(10)+'на работу',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'увольнения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Вид'+chr(10)+'образования',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'окончания',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'рождения',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Возраст',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Дата'+chr(10)+'оформления'+chr(10)+'пенсии',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Категория персонала',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Доп.характеристика ставки',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Ученая степень',lRE,lCE,lRE,lCE);
    lCE++; xlSetCellStringValue('Ошибка',lRE,lCE,lRE,lCE);
//    lCE++; xlSetCellStringValue('Дата'+chr(10)+'присвоения'+chr(10)+'ученой'+chr(10)+'степени',lRE,lCE,lRE,lCE);
    lRE++;
    var wMatrixSizeRow: word = 100;
    if (not xlCreateMatrix(wMatrixSizeRow, lCE))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    var lRowMatrix: longint = 1;
    var lRowCurMx : longint = lRE;
    
    /*#define FrmCl lRE, lCE, lRE, lCE*/
    #define FrmCl lRowMatrix, lCE
    _loop ttSpecRK ordered index ttSpecRK01
    {
//      if not ttSpecRK.isInRep continue; ttSpecRK.sPlWrk[wPeriod]

      if (not NextVisual) break;
      lCE := 0;//datetostr(dRep,'DD.MM.YYYY')
      lCE++; xlStWriteToMatrix(#FrmCl, ++lLine); //xlSetCellStringValue(++lLine, #FrmCl);
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sFIO); //xlSetCellStringValue(sFIO, #FrmCl);
      lCE++; if ( wFromExistFile = 0 )
               xlStWriteToMatrix(#FrmCl,
                 if(ttSpecRK.sPlWrk[1]<>'',datetostr(dRepP,'На DD.MM.YYYY : ')+ttSpecRK.sPlWrk[1]+chr(10),'')+
                 if(ttSpecRK.sPlWrk[0]<>'',datetostr(dRep ,'На DD.MM.YYYY : ')+ttSpecRK.sPlWrk[0],''))
             else
               xlStWriteToMatrix(#FrmCl, ttSpecRK.sPlWrk[0]);
/*
               xlSetCellStringValue(
                 if(ttSpecRK.sPlWrk[1]<>'',datetostr(dRepP,'На DD.MM.YYYY : ')+ttSpecRK.sPlWrk[1]+chr(10),'')+
                 if(ttSpecRK.sPlWrk[0]<>'',datetostr(dRep ,'На DD.MM.YYYY : ')+ttSpecRK.sPlWrk[0],'')
                 , #FrmCl)
             else
               xlSetCellStringValue(ttSpecRK.sPlWrk[0], #FrmCl);
*/
      lCE++; if ( ttSpecRK.dAppoint <> 0 ) xlDtWriteToMatrix(#FrmCl, ttSpecRK.dAppoint); //xlSetCellDateValue(ttSpecRK.dAppoint, #FrmCl);
      lCE++; if ( ttSpecRK.dDismiss <> 0 ) xlDtWriteToMatrix(#FrmCl, ttSpecRK.dDismiss); //xlSetCellDateValue(ttSpecRK.dDismiss, #FrmCl);
      lCE++; if ( wFromExistFile = 0 )
               xlStWriteToMatrix(#FrmCl,
                 if(ttSpecRK.cLevel[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cLevel[1])+chr(10),'')+
                 if(ttSpecRK.cLevel[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cLevel[0]),''))
             else
               xlStWriteToMatrix(#FrmCl, iCatFunc.GetCatalogsName(ttSpecRK.cLevel[0]));
/*
               xlSetCellStringValue(
                 if(ttSpecRK.cLevel[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cLevel[1])+chr(10),'')+
                 if(ttSpecRK.cLevel[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cLevel[0]),'')
                 , #FrmCl)
             else
               xlSetCellStringValue(iCatFunc.GetCatalogsName(ttSpecRK.cLevel[0]), #FrmCl);
*/
      lCE++; if ( wFromExistFile = 0 )
               xlStWriteToMatrix(#FrmCl,
                 if(ttSpecRK.dEduc[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+datetostr(ttSpecRK.dEduc[1],'DD.MM.YYYY')+chr(10),'')+
                 if(ttSpecRK.dEduc[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+datetostr(ttSpecRK.dEduc[0],'DD.MM.YYYY'),''))
             else
               if ( ttSpecRK.dEduc[0] <> 0 )
                 xlDtWriteToMatrix(#FrmCl, ttSpecRK.dEduc[0]);
/*
               xlSetCellStringValue(
                 if(ttSpecRK.dEduc[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+datetostr(ttSpecRK.dEduc[1],'DD.MM.YYYY')+chr(10),'')+
                 if(ttSpecRK.dEduc[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+datetostr(ttSpecRK.dEduc[0],'DD.MM.YYYY'),'')
                 , #FrmCl)
             else
               if ( ttSpecRK.dEduc[0] <> 0 )
                 xlSetCellDateValue(ttSpecRK.dEduc[0], #FrmCl);
*/
      lCE++; if ( ttSpecRK.dBorn <> 0 ) xlDtWriteToMatrix(#FrmCl, ttSpecRK.dBorn);// xlSetCellDateValue(ttSpecRK.dBorn, #FrmCl);
      lCE++; if ( wFromExistFile = 0 )
               xlStWriteToMatrix(#FrmCl, 
                 if(ttSpecRK.wAge[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+ttSpecRK.wAge[1]+chr(10),'')+
                 if(ttSpecRK.wAge[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+ttSpecRK.wAge[0],''))
             else
               xlStWriteToMatrix(#FrmCl, ttSpecRK.wAge[0]);
/*
               xlSetCellStringValue(
                 if(ttSpecRK.wAge[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+ttSpecRK.wAge[1]+chr(10),'')+
                 if(ttSpecRK.wAge[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+ttSpecRK.wAge[0],'')
                 , #FrmCl)
             else
               xlSetCellStringValue(ttSpecRK.wAge[0], #FrmCl);
*/
      lCE++; if ( ttSpecRK.dPens <> 0 ) xlDtWriteToMatrix(#FrmCl, ttSpecRK.dPens); //xlSetCellDateValue(ttSpecRK.dPens, #FrmCl);
      lCE++; if ( wFromExistFile = 0 )
               xlStWriteToMatrix(#FrmCl,
                 if(ttSpecRK.cKat[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+sKatEmpl(ttSpecRK.cKat[1])+chr(10),'')+
                 if(ttSpecRK.cKat[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+sKatEmpl(ttSpecRK.cKat[0]),''))
             else
               xlStWriteToMatrix(#FrmCl, sKatEmpl(ttSpecRK.cKat[0]));
/*
               xlSetCellStringValue(
                 if(ttSpecRK.cKat[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+sKatEmpl(ttSpecRK.cKat[1])+chr(10),'')+
                 if(ttSpecRK.cKat[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+sKatEmpl(ttSpecRK.cKat[0]),'')
                 , #FrmCl)
             else
               xlSetCellStringValue(sKatEmpl(ttSpecRK.cKat[0]), #FrmCl);
*/
      lCE++; if ( wFromExistFile = 0 )
               xlStWriteToMatrix(#FrmCl,
                 if(ttSpecRK.cAdChar[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cAdChar[1])+chr(10),'')+
                 if(ttSpecRK.cAdChar[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cAdChar[0]),''))
             else
               xlStWriteToMatrix(#FrmCl, iCatFunc.GetCatalogsName(ttSpecRK.cAdChar[0]));
/*
               xlSetCellStringValue(  //here
                 if(ttSpecRK.cAdChar[1]<>0,datetostr(dRepP,'На DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cAdChar[1])+chr(10),'')+
                 if(ttSpecRK.cAdChar[0]<>0,datetostr(dRep ,'На DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cAdChar[0]),'')
                 , #FrmCl)
             else
               xlSetCellStringValue(iCatFunc.GetCatalogsName(ttSpecRK.cAdChar[0]), #FrmCl);
*/
      lCE++; if ( wFromExistFile = 0 )
               xlStWriteToMatrix(#FrmCl,
                 if(ttSpecRK.cDegree[0]<>0,datetostr(ttSpecRK.dDegree[0],'Присвоено DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cDegree[0]),'')+
                 if(ttSpecRK.cDegree[1]<>0,chr(10)+datetostr(ttSpecRK.dDegree[1],'Присвоено DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cDegree[1]),'')
                 )
             else
               if ( ttSpecRK.cDegree[0] <> 0 ) or ( ttSpecRK.cDegree[1] <> 0 )
                 xlStWriteToMatrix(#FrmCl,
                   if(ttSpecRK.cDegree[0]<>0,datetostr(ttSpecRK.dDegree[0],'Присвоено DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cDegree[0]),'')+
                   if(ttSpecRK.cDegree[1]<>0,chr(10)+datetostr(ttSpecRK.dDegree[1],'Присвоено DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cDegree[1]),'')
                 );
/*
               xlSetCellStringValue(
                 if(ttSpecRK.cDegree[0]<>0,datetostr(ttSpecRK.dDegree[0],'Присвоено DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cDegree[0])+chr(10),'')+
                 if(ttSpecRK.cDegree[1]<>0,datetostr(ttSpecRK.dDegree[1],'Присвоено DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cDegree[1]),'')
                 , #FrmCl)
             else
               if ( ttSpecRK.cDegree[0] <> 0 )
                 xlSetCellStringValue(datetostr(ttSpecRK.dDegree[0],'Присвоено DD.MM.YYYY : ')+iCatFunc.GetCatalogsName(ttSpecRK.cDegree[0]), #FrmCl);
*/
      lCE++; xlStWriteToMatrix(#FrmCl, ttSpecRK.sWhatError); //xlSetCellStringValue(ttSpecRK.sWhatError, #FrmCl);
      if ttSpecRK.isError
        insert mtForError set mtForError.lRowError := lRE;
//        xlSetFontColor(-16776961, lRE, 1, lRE, lCE);

      lRE++;
      lRowMatrix++;
      
      if ( lRowMatrix > wMatrixSizeRow )
      {
        if (not xlWriteMatrixToExcel(lRowCurMx, 1))
          message('Ошибка функции xlWriteMatrixToExcel.', error);
        xlFreeMatrix;
        lRowCurMx += wMatrixSizeRow;
        lRowMatrix := 1;
        if (not xlCreateMatrix(wMatrixSizeRow, lCE))
        {
          message('Ошибка функции xlCreateMatrix.', error);
          xlKillExcel;
          StopVisual;
          exit;
        }
      }
    }
    if (not xlWriteMatrixToExcel(lRowCurMx, 1))
      message('Ошибка функции xlWriteMatrixToExcel.', error);
    xlFreeMatrix;
  }

  
  lRE--;

  lCE := 1;
  xlSetColumnWidth( 5,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(30,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(20,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(15,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(15,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(40,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(25,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(15,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(16,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(15,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(55,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(70,lRB,lCE,lRE,lCE); lCE++;
  xlSetColumnWidth(40,lRB,lCE,lRE,lCE); lCE++;
  xlSetRowHeight(30,lRB+1,lCB,lRE,lCE); 
  _loop mtForError
    xlSetFontColor(-16776961, mtForError.lRowError, 1, mtForError.lRowError, lCE);
  
  
  xlAlignCellsEx(xlCenter,xlCenter,lRB,lCB,lRB,lCE);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0, lRB,lCB,lRE,lCE);
  StopVisual;
}

procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  ClearRK;
  initRK;

  if isStayAlone
    if SetParamRK
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);

  if isDoRep
  {
    MakeRK;
    if isDataRK
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNewRKS  ;}
        if wToExistFile = 1 {isOkFile := OpenExistRKS;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        PrintRK;

        if (wPrintRash = 1) and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='12-к' break;
          }
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 12-к'); 
          xlSetActiveSheet(i);
          PrintRash;
        }

        xlSetActiveSheetByName('12-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }
    else if isStayAlone message('Нет данных для отчета.');
  }
  SaveRK;
  ClearRK;
  closeinterface(cmDefault);
}
