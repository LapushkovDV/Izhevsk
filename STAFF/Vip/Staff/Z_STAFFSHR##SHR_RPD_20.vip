     cfsSetProp('i_SCRDET20_HOZOPER.NAME1', cfpSkip, true);
     cfsSetProp('i_SCRDET20_KLFILTER.PARAM', cfpSkip, true);
     cfsSetProp('i_SCRDET20_NAMEXTRKAU', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.DNEW2', cfpSkip, true);
