function CopyAttrComp(wTblSrc:word;cRecSrc,cIDSrc:comp;wTblDst:word;cRecDst,cIDDst:comp):boolean;
var cVal:comp;
    sVal:string;
{
  result:=false;
  if (wTblSrc=0 or cRecSrc=0 or cIDSrc=0 or wTblDst=0 or cRecDst=0 or cIDDst=0) exit;

  cVal:=coGetAttrID(wTblSrc,cRecSrc,cIDSrc);
  sVal:=sGetAttrID(wTblSrc,cRecSrc,cIDSrc);

  result:=coSetAttrID(wTblDst,cRecDst,cIDDst,cVal,sVal);
}

//******************************************************************************
//  Процедура утверждения приказа по текущему работнику (по таблице StrCont)
//******************************************************************************
function ConfirmCurrOrder: boolean;
{
  result:=inherited::ConfirmCurrOrder;
  if (not result) exit;

  result:=CopyAttrComp(coStrCont,StrCont.NRec,cAttrBossPost,coStaffStruct,StrCont.cRef,cAttrBossPostSHR);

  if (result and StrCont.cHist<>0) {
    //проверим настройку и скопируем внешние атрибуты
    if boGetTune('UP.STAFF.AttrCopy_SHR')//Синхронизировать внешние атрибуты в ШР с историей ШР
      iAttrCopy.UpdateArrt(StrCont.cRef, StrCont.cHist, CoStaffStruct, CoHistoryStr);
  }

  oManualNotes.AddRec(coStaffStruct,StrCont.cRef,ExtAttrNote);
}

//**********************************************
// события интерфейса
//**********************************************
HandleEvent
//------------------------------
cmOnVipLoad:
{ timelog_init;
  case inherited :: handleEvent (cmOnVipLoad) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  cAttrBossPost:=ExtAttr_CreateComp(coStrCont,'Должность функционального руководителя',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
  cAttrBossPostSHR:=ExtAttr_CreateComp(coStaffStruct,'Должность функционального руководителя',
                                            cgAttrType_Comp,cgKatKau_System,coStaffStruct);

  cAttrNote:=ExtAttr_Create(coStrCont,'Примечание',cgAttrType_Str);

  cAttrCategorGK:=ExtAttr_CreateComp(coStaffStruct,'Категория по методике категорирования ГК',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);

  cAttrBalanSch:=ExtAttr_Create(coStaffStruct,'Балансовый счет присвоенный к должности',0);

  cfsSetExtProp('i_SCRDET20_SSDOPATTRCAT.NAME',cfpFontBackColor,if(IsValidAll(tnSSDopAttrCat),0,ColorNeed));

  cfsSetProp('b_SCRDET20_Выбрать_ставку', cfpVisible, false);  // скрыть кнопку "Выбрать ставку"
}
//------------------------------
cmExprFieldChanged:{
  case inherited :: handleEvent (cmExprFieldChanged) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnExtAttrNote:{
      if (ExprFieldValue='')
        ExtAttr_DeleteValueID(coStrCont,StrCont.NRec,cAttrNote)
      else
        sSetAttrID(coStrCont,StrCont.NRec,cAttrNote,ExprFieldValue);
    }
    fnBalanSch:{
      if (ExprFieldValue='')
        ExtAttr_DeleteValueID(coStaffStruct,StrCont.NRec,cAttrBalanSch)
      else
        sSetAttrID(coStaffStruct,StrCont.NRec,cAttrBalanSch,ExprFieldValue);
    }
  end;
}
//------------------------------
cmPick:
{
  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnBossPost:{
      if (oAttrTablePick.PickValue(coStrCont, cAttrBossPost, StrCont.NRec))
        set BossPost;
    }
    fnCategorGK:{
      if (oAttrTablePick.PickValue(coStaffStruct, cAttrCategorGK, StrCont.NRec))
        set CategorGK;
    }
    #SSWorkCondCat.Name:{//Условия труда
      if (StaffStruct.WorkCond<>0 and IsFieldModified(#StaffStruct.WorkCond)) {
        var SetWorkCond:GP_SetWorkCondToOrder;
        SetWorkCond.RunForRPD20(StaffStruct.buffer,StrPart.cDoc,StrCont.cCatStr);
        set StaffStruct.WorkRegime;
        OnIdle(StrCont.NRec);
      }
    }
  end;
}
//------------------------------
cmCheckField:
{ case CurField of
  #StaffStruct.TaxRate:
  {
#IFDEF _GP_
// разблокируем ручное изменение оклада
#ELSE
          if ( StaffStruct.Tariff <> 0 ) // есть тарифная сетка
            if ( double(OldFieldValue) <> StaffStruct.TaxRate )
            {
              Message('С привязкой к тарифной сетке оклад можно изменить только посредством корректирующих коэффициентов,'#13 +
                      'либо отвязав его от тарифной сетки.', Information);
              set StaffStruct.TaxRate := double(OldFieldValue);
              abort;
            }
#ENDIF
   }
   else
   { case inherited :: handleEvent (cmCheckField) of
     heAbort:{abort;exit;}
     heStop:{stop;exit;}
     end;
   }
   end;

}
//------------------------------
cmDelOnProtect:{
  if StrTitle.wStatus > 0
    {
      abort;
      exit;
    }

  case CurField of
    fnBossPost:{
      ExtAttr_DeleteValueID(coStrCont,StrCont.NRec,cAttrBossPost);
      set BossPost;
    }
  end;

  case inherited :: handleEvent (cmDelOnProtect) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
end;

end.
