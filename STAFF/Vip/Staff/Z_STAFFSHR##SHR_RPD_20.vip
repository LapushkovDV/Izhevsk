#include ExtAttr.vih
#include AttrTablePick.vih

#include GP_SetWorkCondToOrder.vih
#include GP_ManualNotes.vih

#component "Z_StaffSHR"
//Приказ по ШР "Создание ставки" (РПД-20)
alter interface SHR_RPD_20;
overload
  Procedure ISHR_RPD_Base.EnableDisable;
  function ISHR_RPD_Base.CheckCurrOrder: boolean;
  function ISHR_RPD_Base.ConfirmCurrOrder: boolean;
end;
ExtendFormats scrDet20;

//include ExtAttr.var
var cAttrBossPost,cAttrBossPostSHR,cAttrNote:comp;
    cAttrBalanSch: comp;
    cAttrCategorGK: comp;
    oAttrTablePick:AttrTablePick;
    oManualNotes:GP_ManualNotes;

const
  // Роли
  coRoleAdmin        = 000A000000000041h; // Администратор (Приказы по ШР)
  coRoleOOPOT        = 000A000000000043h; // Пользователь ООПиОТ
  coRoleUOT          = 000A000000000044h; // Пользователь УОТ

  // Статус "Согласовано ОТ"
  coSTATUSSOGLOT     = 000A0000000000BAh;
  // Статус "Проект"
  coSTATUSPROG       = 000A0000000000B9h;
    // Статус "Черновик"
  coSTATUSCHERN      = 000A0000000000B8h;

end;
//-------------------------------
OverloadFormats brStr;
//-------------------------------
browse brStr (, hcStaffWinStrPr);
table StrCont;
fields
  browseOrder '№':[1];
  Podr.Name  'Структурное подразделение' ('Наименование структурного подразделения',, sci1378Esc): [35], protect;
  Podr.Code  'Код' ('Код структурного подразделения',, sci1378Esc): [15], protect;
  Podr.DatN  'Дата введения' ('Дата введения структурного подразделения',, sci178Esc): [15], protect, noAutoSize;
end;

screen scrDet20 (,hcStaffWinStrPr, sci1Esc);
table StaffStruct;
fields
  [BossPost] sGetAttrID(coStrCont,StrCont.NRec,cAttrBossPost)
    ('Должность функционального руководителя',,sci13Esc):protect,
    {Font={BackColor=if(BossPost='',ColorNeed,0)}};
  [ExtAttrNote] sGetAttrID(coStrCont,StrCont.NRec,cAttrNote)
    ('Примечание ручное',,):noprotect;
  [BalanSch] sGetAttrID(coStaffStruct,StrCont.NRec,cAttrBalanSch)
    ('Балансовый счет присвоенный к должности',,):noprotect;
  [CategorGK] sGetAttrID(coStaffStruct,StrCont.NRec,cAttrCategorGK)
    ('Категория по методике категорирования ГК',,sci13Esc):protect;
<<












`Должность функционального руководителя`            .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@


 Примечание руч.          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Балансовый счет          .@@@@@@@@@   Категория ГК .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

// Функция проверки роли пользователя
Function userInRole(_userID: comp; _roleID: comp) : boolean; cacheable; {
  Result := False;
  if (RecordExists GP_USERROLES where ((_UserID == GP_USERROLES.CUSER and _roleID == GP_USERROLES.CROLE)) = tsOK) {
    Result := True;
  }
}

/*Function GetStatus() : comp; {
  Result := 0h;
  if (RecordExists GP_USERROLES where ((_UserID == GP_USERROLES.CUSER and _roleID == GP_USERROLES.CROLE)) = tsOK) {
    Result := True;
  }
}*/


//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  inherited::EnableDisable;

  ToggleFieldSelectable(fnBossPost,StrTitle.wStatus=0);
  ToggleFieldSelectable(fnExtAttrNote,StrTitle.wStatus=0);

  var pUserId : comp = UserID();
  if (userInRole(pUserID, coRoleOOPOT)) {
     cfsSetProp('i_SCRDET20_KLREJIM.NREJIM', cfpSkip, true);
     cfsSetProp('i_SCRDET20_SSWORKCONDCAT.NAME', cfpSkip, true);
     cfsSetProp('i_SCRDET20_OVERWORKCALCULATION', cfpSkip, true);
     cfsSetProp('i_SCRDET20_OSOB_USL', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.DNEW1', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.SSOUTPR', cfpSkip, true);
     cfsSetProp('b_SCRDET20_Добавление_доплаты', cfpSkip, true);
     cfsSetProp('b_SCRDET20_Привязка_отпусков', cfpSkip, true);
     cfsSetProp('c_BRSTR_PODR.NAME_Структурное_подразделение', cfpSkip, false);
     cfsSetProp('c_BRSTR_PODR.CODE_Код', cfpSkip, false);
  }
  if ((userInRole(pUserID, coRoleOOPOT) and StrTitle.CATTR1 = coSTATUSPROG)
or    (userInRole(pUserID, coRoleUOT)   and StrTitle.CATTR1 = coSTATUSCHERN)
or    (userInRole(pUserID, coRoleUOT)   and StrTitle.CATTR1 = coSTATUSSOGLOT)
or    (userInRole(pUserID, coRoleOOPOT) and StrTitle.CATTR1 = coSTATUSSOGLOT)
     ) {
     cfsSetProp('i_SCRDET20_KLREJIM.NREJIM', cfpSkip, true);
     cfsSetProp('i_SCRDET20_SSWORKCONDCAT.NAME', cfpSkip, true);
     cfsSetProp('i_SCRDET20_OVERWORKCALCULATION', cfpSkip, true);
     cfsSetProp('i_SCRDET20_OSOB_USL', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.DNEW1', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.SSOUTPR', cfpSkip, true);
     cfsSetProp('b_SCRDET20_Добавление_доплаты', cfpSkip, true);
     cfsSetProp('b_SCRDET20_Привязка_отпусков', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.SEQNMB', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.WORKSTATIONS', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.DINPUT', cfpSkip, true);
     cfsSetProp('i_SCRDET20_POSTCAT.NAME', cfpSkip, true);
     cfsSetProp('i_SCRDET20_KLKATEGO.NAIKAT', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.SNAMEST', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STRDOPINFOCAT.NAME', cfpSkip, true);
     cfsSetProp('i_SCRDET20_SSDOPATTRCAT.NAME', cfpSkip, true);
     cfsSetProp('i_SCRDET20_KLSISOPL.NASISOPL', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.TAXRATE', cfpSkip, true);
     cfsSetProp('i_SCRDET20_KLVAL.SIMVOLV', cfpSkip, true);
     cfsSetProp('i_SCRDET20_BOSSPOST', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.MINSUMMA', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.MAXSUMMA', cfpSkip, true);
     cfsSetProp('i_SCRDET20_EXTATTRNOTE', cfpSkip, true);
     cfsSetProp('i_SCRDET20_BALANSCH', cfpSkip, true);
     cfsSetProp('i_SCRDET20_CATEGORGK', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STRCONT.SBOTTOM', cfpSkip, true);
     cfsSetProp('i_SCRDET20_SCHETDEB', cfpSkip, true);
     cfsSetProp('i_SCRDET20_SUBSCHDEB', cfpSkip, true);
     cfsSetProp('i_SCRDET20_NAMKAUD', cfpSkip, true);
     cfsSetProp('i_SCRDET20_HOZOPER.NAME1', cfpSkip, true);
     cfsSetProp('i_SCRDET20_KLFILTER.PARAM', cfpSkip, true);
     cfsSetProp('i_SCRDET20_NAMEXTRKAU', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.DNEW2', cfpSkip, true);
     cfsSetProp('b_SCRDET20_N_п/п_ставок', cfpSkip, true);
     cfsSetProp('c_BRSTR_PODR.NAME_Структурное_подразделение', cfpSkip, true);
     cfsSetProp('c_BRSTR_PODR.CODE_Код', cfpSkip, true);

  }
  if (userInRole(pUserID, coRoleUOT)) {
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.SEQNMB', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.WORKSTATIONS', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.DINPUT', cfpSkip, true);
     cfsSetProp('i_SCRDET20_POSTCAT.NAME', cfpSkip, true);
     cfsSetProp('i_SCRDET20_KLKATEGO.NAIKAT', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.SNAMEST', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STRDOPINFOCAT.NAME', cfpSkip, true);
     cfsSetProp('i_SCRDET20_SSDOPATTRCAT.NAME', cfpSkip, true);
     cfsSetProp('i_SCRDET20_KLSISOPL.NASISOPL', cfpSkip, true);
     cfsSetProp('i_SCRDET20_STAFFSTRUCT.TAXRATE', cfpSkip, true);
     cfsSetProp('i_SCRDET20_KLVAL.SIMVOLV', cfpSkip, true);
