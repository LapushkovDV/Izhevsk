     cfsSetProp('i_SCRDET20_STRCONT.SBOTTOM', cfpSkip, true);
     cfsSetProp('i_SCRDET20_SCHETDEB', cfpSkip, true);
     cfsSetProp('i_SCRDET20_SUBSCHDEB', cfpSkip, true);
