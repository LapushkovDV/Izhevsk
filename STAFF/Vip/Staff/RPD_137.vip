#component "Z_StaffOrders"

#include RPD.vih
#include NumberOfAddAgreement.vih // работа с доп. соглашениями

vipInterface RPD_137(RPD_35)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  function IRPD_Base2.GetPanel4Agreement: LongInt;
  function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
end;

interface RPD_137 escClose;

create view
from
  Variance;

  overloadFormats scrDet35;

  screen scrDet35 (, hcStaffWinPr, scStaffMyPnl);
    table Education;
    fields
      //LeadPersons.FIO ('Преподаватель / наставник',, scStaffMyPnlPick): protect;
      EduLevelCat.Name ('Вид образования', hcStaffPersonsEducation, scStaffMyPnlPick): protect;
      //EduModeCat.Name ('Форма обучения', hcStaffEduName, scStaffMyPnlPick): protect;
      //EduNameCat.Name ('Наименование учебного заведения', hcStaffEduName, scStaffMyPnlPick): protect;
      //TopicEductCat.Name ('Тема обучения',, scStaffMyPnlPick): protect;
      EduSpecialityCat.Name ('Специальность', hcStaffEduSpeciality, scStaffMyPnlPick): protect;
      //Education.PaySum ('Сумма обучения'): [10.3];
      //UOWrkTabel.Num ('Условное обозначение',, scStaffMyPnlPick): protect;
      Education.FromDate ('Дата поступления', hcStaffEduFromDate): noProtect;
      Education.ToDate ('Дата окончания', hcStaffEduToDate): noProtect;
      //Education.LastDate ('Дата квалификационного экзамена'): noProtect;
      //Education.LastTime ('Время квалификационного экзамена'): noProtect;
      //Education.Nmb2 ('Количество часов'): noProtect;
      //EduReasonCat.Name ('Основание для обучения',, scStaffMyPnlPick): protect;
      //ContDoc.SBottom ('График занятий', hcStaffWinPr), noProtect;
      //fAgreement ('Доп. соглашение к трудовому договору'): protect, pickbutton;
    buttons
      cmViewAdvance1,,, 'Просмотр примечания к приказу', hcStaffWinPr;
    <<
!`Преподаватель`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Область аттестации`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
!`Форма обучения`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
!`Учебное заведение`       .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
!`Тема обучения`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Специализация`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
!`Стоимость`               .@@@@@@@@@@@    `Условное обозначение`.@@@@@@@@@@@
`Дата начала`             .@@@@@@@@@@@    `Дата окончания`      .@@@@@@@@@@@
!`Дата экзамена`           .@@@@@@@@@@@    `Время экзамена`      .@@@@@@@@@@@
!`Кол-во часов`            .@@@@@@@@@@@
!`Основание для обучения`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
!`График занятий`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
!`Доп. соглашение`         .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                              <. Примечание .>
    >>
  end;

  // Открытие / скрытие полей для редактирования в зависимости от того, утвержден ли приказ
  procedure EnableDisable;
  begin
    inherited::EnableDisable;
    // Скроем поле "Доп. соглашение", если оно отключено в каталоге РПД
    if not NOAA.NeedFormAddAgreementPers(ContDoc.TypeOper)
      SetFieldAndLabelVisible(#fAgreement, false);
    else
    begin
      SetFieldAndLabelVisible(#fAgreement, true);
      // Если приказ не утвержден
      if fnFieldsOpen then
        SetFieldOption(#fAgreement, ofSelectable);
      else
        ClearFieldOption(#fAgreement, ofSelectable);
    end;
  end;

  // Функция возвращает идентификатор панели с дополнительным соглашением по РПД (для перерисовки после редактирования)
  function GetPanel4Agreement: LongInt;
  begin
    result := #Education;
  end;

//******************************************************************************
//  Процедура утверждения приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function ChildConfirmOneOrder(cNrec : comp = 0): boolean;
var d:date;
{
  result := Inherited::ChildConfirmOneOrder(cNrec);
  if (not result) exit;

  //Добавляем отклонение в табель
  if (IsValid(tnUOWrkTabel))
    if (boGetTune('UP.ZAR.WORKINGTABLEAUTOREFORM')) // автоматически переформировать табель
      if (GetFirstLschet(ContDoc.Person))
        if (InitWorkingTable) {
          for(d:=date(1,Month(Education.FromDate),Year(Education.FromDate));
              d<=Education.ToDate;
              d:=Add_Months(d,1)) {
            if (LoadWorkingTable(LSchet.nRec, Month(d), Year(d))=0) {
              if (WT_IsNew) //Табель не сформирован
                ReFormWorkingTable(LSchet.nRec, Month(d), Year(d));

              ClearBuffer(tnVariance);
              Variance.cLSchet := LSchet.nRec;
              Variance.cLSTab := WT_GetCurrent;
              Variance.Kind := 1;
              Variance.Priority := 0;
              Variance.cUO := UOWrkTabel.NRec;
              //Variance.WorkingHours := ;
              if (d<Education.FromDate)
                Variance.Beginning := Day(Education.FromDate)
              else
                Variance.Beginning := Day(d);

              if (Month(Education.ToDate)=Month(d) and Year(Education.ToDate)=Year(d))
                Variance.Ending    := Day(Education.ToDate)
              else
                Variance.Ending    := Last_Day(d);

              Variance.LastDate  := Cur_Date; //дата назначения
              Variance.LastUser  := DateToStr(TitleDoc.DocDate,'DD/MM/YY')+' №'+TitleDoc.DocNmb;//Примечание
              insert current Variance;

              ReFormWorkingTable(LSchet.nRec, Month(d), Year(d));
            }
          }

          DoneWorkingTable;
        }
}

  handleEvent
    cmPick:
      case CurField of
        #Persons.FIO, #Persons.TabNmb, #Persons.StrTabN:
          begin
            case inherited::handleEvent(cmPick) of
              heAbort:
                begin
                  abort;
                  exit;
                end;
              heStop:
                begin
                  stop;
                  exit;
                end;
            end;
            DeleteAndCreateAgreement;
          end;
       #fAgreement:
         begin
           NOAA.ShowAgreementWin(GetCo4Agreement(), GetNRec4Agreement(), GetDate4Agreement(), GetContract4Pick(), ContDoc.Person, ContDoc.cStr);
           ReDrawPanel(GetPanel4Agreement());
         end;
       #LeadPersons.FIO:
         begin
           var _cPerson: tNRec = Education.cInf2;
           if PickPerson(_cPerson) then
             set Education.cInf2 := _cPerson;
         end;
       #EduModeCat.Name:
         begin
           var _Mode: tNRec = Education.Mode;
           if RunInterface('PickCatalog2', -15, _Mode, 0, 0) = cmDefault then
             set Education.Mode := _Mode;
         end;
      else
        inherited::HandleEvent(cmPick);
      end;
    cmDelOnProtect:
      case CurField of
        #fAgreement:
          begin
            NOAA.DeleteAgreementLinks(GetCo4Agreement(), GetNRec4Agreement());
            ReDrawPanel(GetPanel4Agreement());
          end;
        #LeadPersons.FIO:
          set Education.cInf2 := 0;
        #EduModeCat.Name:
          set Education.Mode := 0;
      else
        inherited::HandleEvent(cmDelOnProtect);
      end;
  end;

end.
