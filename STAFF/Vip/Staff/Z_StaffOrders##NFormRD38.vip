#include GP_DepFunc.vih
#include ExtAttr.vih
#include StrFunc.vih
#include CatFunc.vih
#include odecl.vih
#include AppFuncs.vih             // объект для работы с назначениями
#include FeeSigners.vih

#component "Z_StaffOrders"

procedure DisableLoadMonthlyScheduleMessages; external 'G_Zarpl.dll';
procedure EnableLoadMonthlyScheduleMessages; external 'G_Zarpl.dll';

alter interface NFormRD38
  ( '')

overload
  procedure FillTablePlanOtpusk;
end;

#include FeeSigners.var

Create view
var vid: Word;
  i : integer;
  soExtAttr  : iExtAttr;
  iOdecl     : declension;          // Переменная типа интерфейс declension 
  VAppFuncs  : AppointmentsFunctions; // работа с назначениями
  sSigner      : string;
  sPostUtvLico : string;
  sFIOUtvLico  : string;
  sFIOOtvetstv : string;
  PrimOtvetstv : string;
from
 tpNFormRD38  gp_tpNFormRD38
 ,tpNFormRD38 gp_tpNFormRD38_1
 ,tpNFormRD38 gp_tpNFormRD38_2
where ((
      1 == gp_tpNFormRD38_1.wChoice
  and 2 == gp_tpNFormRD38_2.wChoice
  and gp_tpNFormRD38_1.wDet     == gp_tpNFormRD38_2.wDet
  and (gp_tpNFormRD38_1.sFIO     = gp_tpNFormRD38_2.sFIO
  and  gp_tpNFormRD38_1.cDolg    = gp_tpNFormRD38_2.cDolg
  and  gp_tpNFormRD38_1.NOtpus   = gp_tpNFormRD38_2.NOtpus
  and  gp_tpNFormRD38_1.dBegin   = gp_tpNFormRD38_2.dBegin
  and  gp_tpNFormRD38_1.dEnd     = gp_tpNFormRD38_2.dEnd
  and  gp_tpNFormRD38_1.wDur     = gp_tpNFormRD38_2.wDur
  and gp_tpNFormRD38_1.dRpBegin  = gp_tpNFormRD38_2.dRpBegin
  and gp_tpNFormRD38_1.dRpEnd    = gp_tpNFormRD38_2.dRpEnd)
));

form NForm38Word ('NForm38Word.out','NForm38Word') with novisual;

var oGP_DepFunc: GP_DepFunc;

Window winSign 'Выбор подписантов';
Show At (,, 70, 7);
  Screen s1(,,sci1Esc);
    fields
      vid  ('Формат отчета'): NoProtect;
      sSigner('Подписанты',,sci13Esc): {Font = {BackColor = if(sSigner = '', ColorNeed, 0)}}, protect, PickButton;
    buttons
      cmOk,,,'Запуск',,;
      cmCancel,,,'Выход',,;
    << 'Параметры отчета'
       (.) Документ Word  `
       (.) FastReport    `
  `Подписанты`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
     <. ~С~формировать .>                         <. ~З~акрыть .>
    >>
  end;
handleevent
  cmPick:
  {
    Case CurField of
      #sSigner:
        if iFeeSigners.RunMainWindow(1)
          set sSigner := iFeeSigners.GetFeeSignersName;

    end;
  }
  cmDelOnProtect:
  {
    case CurField of
      #sSigner:
        set sSigner := '';
    end;
  }
  cmOk:
  {
    SaveMyDSK(vid, 'vidNFormRD38');

    if trim(sSigner) <> '' 
      CloseWindowEx(winSign, cmDefault)
    else
      message('Не заданы подписанты!', Error);
  }
  cmCancel:
  {
    SaveMyDSK(vid, 'vidNFormRD38');

    CloseWindowEx(winSign, cmCancel);
  }
end;
end;

Procedure PrintNForm38Word;
{

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Печать отчета...', RecordsInTable(#tpNFormRD38Choice1)+RecordsInTable(#tpNFormRD38Choice2));

  i := 0;

  NForm38Word.Write(TitleDoc.DocNmb);                                          // номер приказа
  NForm38Word.Write(iStrFunc.UnVisibleDate(TitleDoc.DocDate, 'DD.MM.YYYY'));   // дата приказа

  NForm38Word.Write(ContDoc.sBottom);

  NForm38Word.Write(iOdecl.FIODeclension(Persons.NRec, Persons.FIO, 1));
  NForm38Word.Write(GetStrTabn(Persons.TabNmb,Persons.StrTabn));
  NForm38Word.Write(GetPostByPadeg(Appointments.Post, 1));
  NForm38Word.Write(oGP_DepFunc.GetFullDepName(Appointments.Department, DF_ADD_CODE, 1, '/'));

  _loop tpNFormRD38Choice1
  {
    i++;

    if not NextVisual
      break;

    NForm38Word.PutEventById(fedoloop, fcNForm38Word_CYCLE1);

    NForm38Word.Write(tpNFormRD38Choice1.wChoice);
    NForm38Word.Write(tpNFormRD38Choice1.NOtpus);
    NForm38Word.Write(iStrFunc.UnVisibleDate(tpNFormRD38Choice1.dBegin, '"DD" mon YYYY'));
    NForm38Word.Write(iStrFunc.UnVisibleDate(tpNFormRD38Choice1.dEnd, '"DD" mon YYYY'));
    NForm38Word.Write(tpNFormRD38Choice1.wDur);
    NForm38Word.Write(tpNFormRD38Choice1.dRpBegin);
    NForm38Word.Write(tpNFormRD38Choice1.dRpEnd);
  }

  _loop tpNFormRD38Choice2
  {
    i++;

    if not NextVisual
      break;

    NForm38Word.PutEventById(fedoloop, fcNForm38Word_CYCLE2);

    NForm38Word.Write(tpNFormRD38Choice2.wChoice);
    NForm38Word.Write(tpNFormRD38Choice2.NOtpus);
    NForm38Word.Write(iStrFunc.UnVisibleDate(tpNFormRD38Choice2.dBegin, '"DD" mon YYYY'));
    NForm38Word.Write(iStrFunc.UnVisibleDate(tpNFormRD38Choice2.dEnd, '"DD" mon YYYY'));
    NForm38Word.Write(tpNFormRD38Choice2.wDur);
    NForm38Word.Write(tpNFormRD38Choice2.dRpBegin);
    NForm38Word.Write(tpNFormRD38Choice2.dRpEnd);
  }


  NForm38Word.Write(sPostUtvLico);
  NForm38Word.Write(sFIOUtvLico); 
  NForm38Word.Write(sFIOOtvetstv);
  NForm38Word.Write(PrimOtvetstv);

  if (not NForm38Word.error) and i!=0
    NForm38Word.showFile('Приказ о наставничестве.');
  else
  {
    NForm38Word.abortForm;
    message(chr(3)+'Нет данных для формирования справки', OkButton);
  }

  StopVisual('', 0);
}

procedure FillTablePlanOtpusk;
{
  inherited::FillTablePlanOtpusk;

  //Удаление из временной таблицы строк плана по которым не было изменений
  _loop gp_tpNFormRD38_1
    if getfirst gp_tpNFormRD38_2 = tsOk
    {
      update current gp_tpNFormRD38_2 set gp_tpNFormRD38_2.wChoice := word(-9);
      update current gp_tpNFormRD38_1 set gp_tpNFormRD38_1.wChoice := word(-9);
    }
  delete all gp_tpNFormRD38 where ((word(-9) == gp_tpNFormRD38.wChoice));
}

HandleEvent
cmInit:
  {
  boUsePartOrders := boGetTune('UP.STAFF.USE_PART_ORDERS'); //значение настройки частичного утверждения приказов

  if (EDLG.GetAllMemonRec(word(38),word(2)) > comp(0))
    wLg := 1;
  else
    wLg := 0;

    if wGetTune('UP.FakelGAL.Fakel') = 1
    {
//      if RunInterface(Z_StaffOrders::SelTypePrintTD) = cmDefault
//      {
        ReadMyDSK(vid, 'vidNFormRD38',true);
//      }
      if (not (ReadMyDsk(sSigner, 'NFormRD38_sSigner', false)))
        sSigner:=sGetTune('UP.Staff.SignatoryAuthority');

      iFeeSigners.InitFeeSigners(cgReport_7416);
        
      if (RunWindowModal(winSign) = cmDefault)
      {
        iFeeSigners.FindFeeSignersByName(cgReport_7416, sSigner);
        if iFeeSigners.FeeSignersIsValid
        {
          if (not iFeeSigners.RestrictFeeByRole(2,'UtvLico'))
            iFeeSigners.GetSignerFirst;
        
          sPostUtvLico:= iFeeSigners.GetSignerPosition(1);
          sFIOUtvLico:= iFeeSigners.GetSignerFIO(13);
          iFeeSigners.ClearRestriction;
        
          if (not iFeeSigners.RestrictFeeByRole(2,'Otvetstv'))
            iFeeSigners.GetSignerFirst;
        
          sFIOOtvetstv := iFeeSigners.GetSignerFIO(1);
          PrimOtvetstv := iFeeSigners.GetSignerInfo(3);
          iFeeSigners.ClearRestriction;
        }
      }
      SaveMyDsk(sSigner, 'NFormRD38_sSigner');
    }
    else
      vid := 1;

  DisableLoadMonthlyScheduleMessages;

    if vid = 0
    {
      // заполнение таблицы отпусков
      FillTablePlanOtpusk;
      PrintNForm38Word;
    }
    else
     ReportT38FR;

  EnableLoadMonthlyScheduleMessages;

    abort;
  }       // cmInit
end;      // HandleEvent
end.
