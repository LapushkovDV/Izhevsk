#include XMLConverter.vih
#include tXmlTables.tbl
#include CatFunc.vih

#component "Z_Staff"
VipInterface XML_ImportOn Licensed(free);

Interface  XML_ImportOn;


table struct XML11 (
FIO              :string  "FIO",
SurnamePer       :string  "Фамилия",
NamePer          :string  "Имя",
PatronymicPer    :string  "Отчество",
BirthdayPer      :string "День рождения",
SnilsPer         :string "СНИЛС",
UUIDPer          :comp   "УИД",
DataDissPer      :string "Дата увольнения",
VidDissPer       :string "Вид увольнения",
DiscrptPer       :string "Вид Мероприятия",
PostPer          :string "Должность",
JoinPer          :string "Совместимость",
StructDepPer     :string "Структурное подразделение",
DocNormativPer   :string "Нормативный документ",
StatPer          :string "Статья",
ChastPer         :string "Часть",
PunktPer         :string "Пункт",
CausePer         :string "причина увольнения",
NameOsnPer       :string "Наименование документа (Приказ)",
DataOsnPer       :string "Дата документа",
NumOsnPer        :string "Номер документа",
SerialOsnPer     :string "Серия документа",
NmbPrikaz        :string "Полный номер документа",
NameORG          :string "Наименование организации"

);

table struct Debug (

Post : String "Должность"

);

Var
 oXMLConverter: XMLConverter;
ExpNrec :comp;
_cNrecPers : comp;
Name_File :String;
StrokaEx : Longint;
_value1         : String;
_value2         : String;
_value3         : String;
_value4         : String;
_value5         : String;
_value6         : String;
_value7         : String;
_value8         : String;
_value9         : String;
_value10        : String;
_value11        : String;
_value12        : String;
_value13        : String;
_value14        : String;
_value15        : String;
_value16        : String;
_value17        : String;
_value18        : String;
_value19        : String;
_value20        : String;
_value21        : String;
_value22        : String;
n               : Longint;
iCatFunc: CatalogsFunctions;
 DataOsnPer1 : date;

create view
var
_FIOPer : String;
_SNILS :  String;
_BirthDay :Date;
_cNrecPer : comp;

as select *
from
Debug,
TxmlNode,
TxmlNode TxmlNode_my,
TxmlNode TxmlNode_my1,
TxmlNode TxmlNode_my2,
TxmlNode TxmlNode_my3,
TxmlNode TxmlNodeMer,
TxmlNode TxmlNode_ORG,
XML11,
EXPERIENCE exp,
EXPERIENCE exp1,
persons,
PASSPORTS,
PASSPORTS pass1,
catalogs,
catalogs cat,
catalogs cat1,
catalogs cat2,
catalogs catpost
where((
persons.galdep == catalogs.code (noindex)
));

#declare GetValXML(AdrXmlStruct)
  Trim(GetXMLMap.GetAttrValueByName(#AdrXmlStruct))
#end


Parameters _FIOPer, _SNILS, _BirthDay;

Window winXML11;
Browse brXML11;
  table XML11;
  Fields
      XML11.SurnamePer       'фамилия'   : [5], Protect;
      XML11.NamePer          'Имя'       : [5], Protect;
      XML11.PatronymicPer    'Отчество'   : [5], Protect;
      XML11.BirthdayPer      'День рождения' : [5], Protect;
      XML11.SnilsPer         'СНИЛС': [5], Protect;
      XML11.UUIDPer          'УИД': [5], Protect;
      XML11.DataDissPer      'Дата увольнения': [5], Protect;
      XML11.VidDissPer       'Вид увольнения' : [5], Protect;
      XML11.DiscrptPer       'Вид Мероприятия': [5], Protect;
      XML11.PostPer          'Должность'      : [5], Protect;
      XML11.JoinPer          'Совместимость'  : [5], Protect;
      XML11.StructDepPer     'Структурное подразделение' : [5], Protect;
      XML11.DocNormativPer   'Нормативный документ' : [5], Protect;
      XML11.StatPer          'Статья'     : [5], Protect;
      XML11.ChastPer         'Часть'      : [5], Protect;
      XML11.PunktPer         'Пункт'          : [5], Protect;
      XML11.CausePer         'Причина увольнения'  : [5], Protect;
      XML11.NameOsnPer       'Наименование документа (Приказ)' : [5], Protect;
      XML11.DataOsnPer       'Дата документа'  : [5], Protect;
      XML11.NumOsnPer        'Номер документа' : [5], Protect;
      XML11.SerialOsnPer     'Серия документа'  : [5], Protect;




end;
end;

Window winDebug;
Browse brDebug;
  table Debug;
  Fields
      Debug.Post             'Должность'   : [5], Protect;

end;
end;

Screen FileXMLOn;
fields
  Name_File : protect,pickbutton;

 buttons
cmOK,,,'Загрузить файл', , sci1Esc;
cmCancel,,,'Выход', ,sci1Esc;

<<
    Файл .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

    <.~З~агрузить.>           <.~О~тмена.>
>>
end;


handleevent

CmInit:         //не используем
{

}

cmPick:
    {
      var vsTmp, IdFile: string;
       case CurField of
    #Name_File:
    {
      vsTmp := GetFileName('*.xml', 'Выберите файл импорта');
      if (vsTmp <> '')
      {
          if Yes = Message('Загрузить XML файл?',yesNo+Confirmation)
         {
         }
         set Name_File:=vsTmp;
      }
      //else exit;
    }
    end;

    }

   // case



cmOK:
{
 var cNrecXML, cNrecXML_1, cNrecXML_2, cNrecXML_3, cNrecXML_4, cNrecXML_5,cNrecXML_OSN, cNrecXML_OSN1 : comp;

//проверка XML файла на загрузку и занесение его в таблицу
if (not oXMLConverter.LoadTxmlTables(Name_File))
  Message('Загрузка XML-файла завершена с ошибками.');
else {message('Загрузка файла успешна!');}

//позиционируемся на ЗЛ (Форма ХМЛ)
do {
 if GetFirst TxmlNode where ((cNrecXML == TxmlNode.cNode)) = tsOK {
          cNrecXML        := TxmlNode.nRec;
          cNrecXML_OSN    := TxmlNode.cNode;


          }
}
while  TxmlNode.Name <> 'Работодатель'
//******************************ПОЛУЧАЕМ НАИМЕНОВАНИЕ ОРГАНИЗАЦИИ В РАБОТОДАТЕЛЕ*****************************

 _loop TxmlNode_ORG where ((cNrecXML_OSN == TxmlNode_ORG.cNode and 'Работодатель' == TxmlNode_ORG.name))
       {
         cNrecXML_OSN1   := TxmlNode_ORG.nRec;
         if getfirst TxmlNode_my1 where((cNrecXML_OSN1 == TxmlNode_my1.cNode
                                                and 'НаименованиеОрганизации' == TxmlNode_my1.Name )) = tsOK
                                            {
                                                XML11.NameORG := TxmlNode_my1.sVal;

                                            }

       }



//*******************************ИДЕМ ЦИКЛОМ ПО XML ПО <ЗЛ>**************************************************
        var n : longint;
        n := 1;
       _loop TxmlNode_my where ((cNrecXML_OSN == TxmlNode_my.cNode and 'ЗЛ' == TxmlNode_my.name))
       {
          cNrecXML_2 := TxmlNode_my.nRec;


//если снилс такой как и у чела на которого нужно завести дело добовляем всю инфу о нем, иначе следующий ЗЛ
//************************************************************************************************************

                      if getfirst TxmlNode_my2 where ((cNrecXML_2 == TxmlNode_my2.cNode
                                                                and 'УТ2:ФИО' == TxmlNode_my2.Name )) = tsOK
                      {

                          cNrecXML_3 := TxmlNode_my2.nrec;

                      _loop TxmlNode_my2 where ((cNrecXML_3 == TxmlNode_my2.cNode))
                          {
                            if  (TxmlNode_my2.name = 'УТ2:Фамилия')
                            {

                              XML11.SurnamePer := TxmlNode_my2.sVal + ' ';
                            }
                            if  (TxmlNode_my2.name = 'УТ2:Имя')
                            {
                              XML11.NamePer := TxmlNode_my2.sVal + ' ';
                            }
                            if  (TxmlNode_my2.name = 'УТ2:Отчество')
                            {
                              XML11.PatronymicPer := TxmlNode_my2.sVal;
                            }
                            //получили фио
                            XML11.FIO := XML11.SurnamePer + XML11.NamePer + XML11.PatronymicPer;
                          }
                          //записываем СНИЛС
                          if getfirst TxmlNode_my2 where ((cNrecXML_2 == TxmlNode_my2.cNode
                                                                and 'УТ2:СНИЛС' == TxmlNode_my2.Name )) = tsOK
                          {
                             XML11.SnilsPer := TxmlNode_my2.sVal;
                          }
                          // дата по-тупому занесена в хмл поэтому вот так
                          if getfirst TxmlNode_my2 where ((cNrecXML_2 == TxmlNode_my2.cNode
                                                            and 'ДатаРождения' == TxmlNode_my2.Name )) = tsOK
                          {
                            var mm, dd, yyyy, try : string;
                              try := TxmlNode_my2.sVal;
                             XML11.BirthdayPer := '';
                             dd := SubStr(TxmlNode_my2.sVal,9,2) + '/';
                             mm := SubStr(try,6,2) + '/';
                             yyyy := SubStr(TxmlNode_my2.sVal,0,4);
                             XML11.BirthdayPer := dd + mm + yyyy;
                          }
                          //спускаемся в трудовуюдеятельность затем в мероприятие
                          if getfirst TxmlNode_my2 where ((cNrecXML_2 == TxmlNode_my2.cNode
                                                    and 'ТрудоваяДеятельность' == TxmlNode_my2.Name )) = tsOK
                          {

                             cNrecXML_2 :=  TxmlNode_my2.nrec;
                              _loop TxmlNodeMer where ((cNrecXML_2 == TxmlNodeMer.cNode
                                                             and 'Мероприятие' == TxmlNodeMer.Name ))
                                {
                                   cNrecXML_3 :=  TxmlNodeMer.nrec;
                                   _loop TxmlNode_my2 where ((cNrecXML_3 == TxmlNode_my2.cNode))
                                   {

                                     //получаем данные уровня мероприятия

                                     if (TxmlNode_my2.name = 'UUID')
                                     {

                                        XML11.UUIDPer := TxmlNode_my2.sVal;
                                     }
                                     if (TxmlNode_my2.name = 'Дата')
                                     {

                                       var mm, dd, yyyy, try : string;
                                       try := TxmlNode_my2.sVal;
                                       XML11.DataDissPer := '';
                                       dd := SubStr(TxmlNode_my2.sVal,9,2) + '/';
                                       mm := SubStr(try,6,2) + '/';
                                       yyyy := SubStr(TxmlNode_my2.sVal,0,4);
                                       XML11.DataDissPer := dd + mm + yyyy;


                                     }
                                     if (TxmlNode_my2.name = 'Вид')
                                     {

                                       XML11.VidDissPer :=  TxmlNode_my2.sVal;
                                     }
                                     if (TxmlNode_my2.name = 'Сведения')
                                     {
                                       XML11.PostPer := '';
                                       XML11.DiscrptPer :=  TxmlNode_my2.sVal;
                                     }
                                     if (TxmlNode_my2.name = 'Должность')
                                     {

                                       if (XML11.VidDissPer = 5 or XML11.VidDissPer = 2 or XML11.VidDissPer = 1)
                                       {
                                           XML11.PostPer :=  TxmlNode_my2.sVal;
                                       }
                                     }

                                     if (TxmlNode_my2.name = 'ЯвляетсяСовместителем')
                                     {

                                       XML11.JoinPer :=  TxmlNode_my2.sVal;
                                     }
                                     if (TxmlNode_my2.name = 'СтруктурноеПодразделение')
                                     {

                                       XML11.StructDepPer :=  TxmlNode_my2.sVal;
                                     }
                                     //Заходим в основание увольнение

                                     if (XML11.VidDissPer = 5)
                                      {
                                       if (TxmlNode_my2.name = 'ОснованиеУвольнения')
                                       {

                                         cNrecXML_4 := TxmlNode_my2.nrec;
                                         _loop  TxmlNode_my3 where ((cNrecXML_4 == TxmlNode_my3.cNode))
                                         {
                                            if (TxmlNode_my3.name = 'УТ2:НормативныйДокумент')
                                             {

                                               XML11.DocNormativPer :=  TxmlNode_my3.sVal;
                                             }
                                            if (TxmlNode_my3.name = 'УТ2:Статья')
                                             {

                                               XML11.StatPer :=  TxmlNode_my3.sVal;
                                             }
                                            if (TxmlNode_my3.name = 'УТ2:Часть')
                                             {

                                               XML11.ChastPer :=  TxmlNode_my3.sVal;
                                             }
                                            if (TxmlNode_my3.name = 'УТ2:Пункт')
                                             {

                                               XML11.PunktPer :=  TxmlNode_my3.sVal;
                                             }
                                         }
                                        }

                                     }
                                     else
                                     {
                                       XML11.DocNormativPer := '';
                                        XML11.StatPer :=  '';
                                        XML11.ChastPer :=  '';
                                         XML11.PunktPer :=  '';
                                     }
                                     XML11.CausePer := '';
                                     if (TxmlNode_my2.name = 'Причина')
                                     {

                                       XML11.CausePer :=  TxmlNode_my2.sVal;
                                     }
                                     //Заходим в основание

                                     if (TxmlNode_my2.name = 'Основание')
                                     {
                                       cNrecXML_5 := TxmlNode_my2.nrec;
                                        _loop  TxmlNode_my3 where ((cNrecXML_5 == TxmlNode_my3.cNode))
                                       {
                                          if (TxmlNode_my3.name = 'Наименование')
                                           {
                                             XML11.NameOsnPer :=  TxmlNode_my3.sVal;
                                           }
                                           if (TxmlNode_my3.name = 'Дата')
                                           {
                                             var DataOsnPer1 : date;
                                             var mm, dd, yyyy, try : string;
                                             try := TxmlNode_my3.sVal;
                                             XML11.DataOsnPer := '';
                                             dd := SubStr(TxmlNode_my3.sVal,9,2) + '/';
                                             mm := SubStr(try,6,2) + '/';
                                             yyyy := SubStr(TxmlNode_my3.sVal,0,4);
                                             XML11.DataOsnPer := dd + mm + yyyy;
                                             DataOsnPer1 := StrToDate(XML11.DataOsnPer, 'DD/MM/YYYY');

                                           }
                                           if (TxmlNode_my3.name = 'Номер')
                                           {
                                             XML11.NumOsnPer :=  TxmlNode_my3.sVal;

                                           }
                                           if (TxmlNode_my3.name = 'Серия')
                                           {
                                             XML11.SerialOsnPer :=  TxmlNode_my3.sVal;
                                           }

                                       }
                                     }
                                   }

                                if XML11.SurnamePer <> '' then insert current XML11;
                          }
                         }
                  }
     }


/*************ОСУЩЕСТВЛЯЕМ ПРОВЕРКУ ЗАНЕСЕНЫ ЛИ УЖЕ ДАННЫЕ ПО СОТРУДНИКУ ИЛИ НЕТ*****************************
******УДАЛЯЕМ ИЗ ВРЕМЯНКИ ДАННЫЕ КОТОРЫЕ УЖЕ БЫЛИ ЗАНЕСЕНЫ И ВСТАВЛЯЕМ В ТАБЛИЦУ EXPERINCE AND ATTRAVAL*****/

var p, l : longint;
p := 0;



//проверка времянки на уже занесенные данные в таблицу EXP
var dateprikaz : date;
var doc, FIOper : string;



_loop XML11
{
  l++;
  doc := XML11.NumOsnPer + XML11.SerialOsnPer;
  dateprikaz:= strtodate(XML11.DataOsnPer, 'DD/MM/YYYY');

  if getfirst PASSPORTS where ((XML11.SnilsPer == PASSPORTS.NMB (noindex))) = tsOK
  {
    _cNrecPers := PASSPORTS.person

  }


  if getfirst exp1 where ((_cNrecPers == exp1.person and doc == exp1.JOBORDERNMB (noindex)
                                                        and dateprikaz == exp1.JOBORDERDATE (noindex))) = tsOK
    {
      p++  ;
      delete current XML11;
    }


}

message ('Найдено повторяющиеся записи: ' + p + ' шт.');

//Вставляем в таблицу EXP and ATTRVAL

_loop XML11
{


             var _newNrecEXP, _newNrecATTRV, _cNrecPers1 : comp;
             _newNrecEXP                 :=  GetNextNrec(#exp, 0);
             set exp.nrec                := _newNrecEXP;


             set exp.filialno := 5;
             if getfirst pass1 where ((XML11.SnilsPer == pass1.NMB(noindex))) = tsOK
              {
                set exp.PERSON  := pass1.person;
                _cNrecPers1  := pass1.person;
              }


             set exp.ENTRANCEDATE := strtodate(XML11.DataDissPer, 'DD/MM/YYYY');

             if (XML11.NameORG = 'АО "НАУЧНО-ИССЛЕДОВАТЕЛЬСКИЙ ИНСТИТУТ МАШИНОСТРОЕНИЯ"')
                                                                     then XML11.NameORG := 'АО "НИИМаш"';

             if getfirst cat1 where ((XML11.NameORG == cat1.name(noindex))) = tsOK
             {

               set exp.ENTERPRISENAME := cat1.nrec;
             }

             set exp.WATTR1 := XML11.VidDissPer;

             if (XML11.VidDissPer = 5 or XML11.VidDissPer = 2 or XML11.VidDissPer = 1 ){
             var CodeUval :string;


             //Петр Метелев разрешил так находить причину увольнения
             if (XML11.PunktPer = '5' and XML11.ChastPer = '1' and XML11.StatPer = '77')
             {
              CodeUval := 'п. 5 ч. 1 ст. 77 ТК РФ' ;
             }
             if (XML11.PunktPer = '8' and XML11.ChastPer = '1' and XML11.StatPer = '77')
             {
              CodeUval := 'п.8 ч.1 ст.77 ТК' ;
             }
             if (XML11.PunktPer = '3' and XML11.ChastPer = '1' and XML11.StatPer = '77')
             {
              CodeUval := 'п.3 ч.1 ст.77 ТК РФ' ;
             }
             if (XML11.PunktPer = '5' and XML11.ChastPer = '' and XML11.StatPer = '77')
             {
              CodeUval := 'п.5 ст.77 ТК' ;
             }
             if (XML11.PunktPer = '1' and XML11.ChastPer = '' and XML11.StatPer = '81')
             {
              CodeUval := 'п.1 ст.81 ТК' ;
             }
             if (XML11.PunktPer = '1' and XML11.ChastPer = '' and XML11.StatPer = '83')
             {
              CodeUval := 'п.1 ст.83 ТК' ;
             }
             if (XML11.PunktPer = '2' and XML11.ChastPer = '' and XML11.StatPer = '81')
             {
              CodeUval := 'п.2 ст.81 ТК' ;
             }
             if (XML11.PunktPer = '6' and XML11.ChastPer = '' and XML11.StatPer = '83')
             {
              CodeUval := 'п.6 ст.83 ТК' ;
             }
             if (XML11.PunktPer = '7' and XML11.ChastPer = '' and XML11.StatPer = '77')
             {
              CodeUval := 'п.7 ст.77 ТК' ;
             }
             if (XML11.PunktPer = '6' and XML11.ChastPer = '' and XML11.StatPer = '77')
             {
              CodeUval := 'п.6 ст.77 ТК' ;
             }
             if (XML11.PunktPer = '5' and XML11.ChastPer = '' and XML11.StatPer = '81')
             {
              CodeUval := 'п.5 ст.81 ТК' ;
             }
             if (XML11.PunktPer = '6б' and XML11.ChastPer = '' and XML11.StatPer = '81')
             {
              CodeUval := 'п.6б ст.81 ТК' ;
             }
             if (XML11.PunktPer = '6а' and XML11.ChastPer = '' and XML11.StatPer = '81')
             {
              CodeUval := 'п.6а ст.81 ТК' ;
             }
             if (XML11.PunktPer = '2' and XML11.ChastPer = '' and XML11.StatPer = '77')
             {
              CodeUval := 'п.2 ст.77 ТК' ;
             }
             if (XML11.PunktPer = '2' and XML11.ChastPer = '1' and XML11.StatPer = '77')
             {
              CodeUval := 'п.2 ст.77 ТК' ;
             }
             if (XML11.PunktPer = '3' and XML11.ChastPer = '' and XML11.StatPer = '29')
             {
              CodeUval := 'п.3 ст. 29 КЗОТ' ;
             }
             if (XML11.PunktPer = '3' and XML11.ChastPer = '' and XML11.StatPer = '33')
             {
              CodeUval := 'п.3 ст.33 ФЗ' ;
             }
             if (XML11.PunktPer = '5' and XML11.ChastPer = '' and XML11.StatPer = '29')
             {
              CodeUval := 'п.5 ст.29 КЗоТ' ;
             }
             if (XML11.PunktPer = '4' and XML11.ChastPer = '' and XML11.StatPer = '83')
             {
              CodeUval := 'п.4 ст.83 ТК' ;
             }
             if (XML11.PunktPer = '3' and XML11.ChastPer = '' and XML11.StatPer = '77')
             {
              CodeUval := 'п.3 ст.77 ТК РФ' ;
             }
             if (XML11.PunktPer = '1' and XML11.ChastPer = '' and XML11.StatPer = '77')
             {
              CodeUval := 'п.1 ст.77 ТК РФ' ;
             }
             if (XML11.PunktPer = '5' and XML11.ChastPer = '' and XML11.StatPer = '83')
             {
              CodeUval := 'п.5 ст.83 ТК РФ' ;
             }
             if (XML11.PunktPer = '10' and XML11.ChastPer = '' and XML11.StatPer = '83')
             {
              CodeUval := 'п.10 ст.83 ТК' ;
             }
             if (XML11.PunktPer = '5' and XML11.ChastPer = '' and XML11.StatPer = '29')
             {
              CodeUval := 'п.5 ст.29 КЗоТ ' ;
             }
             if (XML11.PunktPer = '' and XML11.ChastPer = '' and XML11.StatPer = '33')
             {
              CodeUval := '33' ;
             }
             if (XML11.PunktPer = '' and XML11.ChastPer = '' and XML11.StatPer = '31')
             {
              CodeUval := 'ст.31 КЗоТ' ;
             }
             if (XML11.PunktPer = '' and XML11.ChastPer = '' and XML11.StatPer = '80')
             {
              CodeUval := 'ст.80 ТК' ;
             }
             if (XML11.PunktPer = '' and XML11.ChastPer = '' and XML11.StatPer = '71')
             {
              CodeUval := 'ст.71 ТК' ;
             }



             if getfirst cat2 where ((CodeUval == cat2.code (noindex))) = tsOK
                 {
                  set exp.CREASON := cat2.nrec;
                 }

             }

             if (XML11.VidDissPer = 4)
             {
                  XML11.PostPer := '';
             }
             if (XML11.VidDissPer = 3 )
             {
                XML11.PostPer := '';
             }
             if (XML11.VidDissPer = 2 or XML11.VidDissPer = 1 or XML11.VidDissPer = 5)
             {
                var post : string;
                post := trim(XML11.PostPer);
                //если нет такой профессии вставляем в каталог
                if (getfirst fastfirstrow cat where (( COMP(000A0000000399CFh) == cat.mainlink (noindex) and post == cat.name (noindex)))) <> tsOK
                            {
                                 Insert cat Set
                                 cat.mainlink := comp(000A0000000399CFh)
                               , cat.name     := trim(XML11.PostPer)
                               , cat.GROUPCODE := 2    ;
                              message('Добавили в справочник профессию "' + cat.name + '"');
                            }

              }
                 var post1 : string;
                 post1 := trim(XML11.PostPer);
                 if getfirst catpost where ((comp(000A0000000399CFh) == catpost.mainlink(noindex) and post1 == catpost.name(noindex))) = tsOK
                     {

                         set exp.post :=  catpost.nrec;
                     }
             set exp.WATTR2 := XML11.JoinPer;
             var NmbDoc : string;
             NmbDoc := XML11.NumOsnPer + XML11.SerialOsnPer;
             set exp.JOBORDERNMB := NmbDoc;
             set exp.JOBORDERDATE :=  strtodate(XML11.DataOsnPer, 'DD/MM/YYYY');


/******************************Вставляем в таблицу exper***************************************************/
            insert current exp;
}





if getfirst XML11 = tsOK
{
   runwindowmodal(winXML11);
}
else
{
message('Данных нет для добавления. Проверьте данные XML файла.')
}

}
end;
end.
