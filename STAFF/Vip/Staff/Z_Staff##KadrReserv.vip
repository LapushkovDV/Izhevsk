#include DepartmentsLimiter.vih
#include CatFunc.Vih
#component "Z_Staff"
//Список сотрудников, подлежащих аттестации
alter interface KadrReserv;
//*********************************
Function GetCompetenceCode:String;Forward;
//*********************************

overloadFormats  BRWKADRRESERV1;
overloadFormats  BRWKADRRESERV2;
//-------------------------------
var wSTATPERS:word;

create view KadrReserv
var
  pLevCatRezerv:comp;
as select
 if (isValid(tnCatStaffStr),  CatStaffStr.Code, '') ( FieldName = CompetenceCode )
from
/*
     CompetencePers ComPers
   , catalogs Cat
*/
     Catalogs CatStaffStr
   , COMPETENCESTAFFSTR ComStaffStr
   , COMPETENCESTAFFSTR ComStaffStr_UP
   , catalogs CatCheck
//----- Компетенции по должностям ---
  , COMPETENCEPOST
  , COMPETENCEPOST COMPETENCEPOST_UP
where ((
/* изменили задание: брать не от человека, а от должности в ШР. + еще выбор добавить прямо в этом интерфейсе
Persons.Nrec == ComPers.cPers
   and  ComPers.cName == Cat.nrec
and pLevCatRezerv == Cat.cParent (Noindex) // Вышестоящий элемент Уровни кадрового резерва
*/
    FuturePost.cStaffStr   == ComStaffStr_UP.CSTAFFSTR
and pLevCatRezerv          == ComStaffStr_UP.cName
and FuturePost.cStaffStr   == ComStaffStr.CSTAFFSTR
and ComStaffStr_UP.Nrec    == ComStaffStr.cParent
and ComStaffStr.cName      == CatStaffStr.nrec
and pLevCatRezerv          == CatStaffStr.cParent (Noindex) // Вышестоящий элемент Уровни кадрового резерва
//----- Компетенции по должностям ---
and StaffStruct.Post       == COMPETENCEPOST.CPOST
and CompetencePost.cParent == CompetencePost_Up.NRec  // Вышестоящая компетенция
and pLevCatRezerv          == CompetencePost_Up.cName(noindex) //'Уровни кадрового резерва'

))
bounds byWork    'С'  == Persons.IsEmployee  and  0   == Persons.DisDate
bounds byCurrent 'С'  == Persons.IsEmployee
bounds byDis     'У'  == Persons.IsEmployee

;


Create view vSpr
as select Catalogs.Nrec
From Catalogs CatMain
, Catalogs
where
((                         100 == CatMain.SysCode
and                          0 == Catalogs.Lpr
and               CatMain.Nrec == Catalogs.MainLink
and 'Уровни кадрового резерва' == Catalogs.Name
))
;

//========================================================
// Визуальная часть
//========================================================
Window wnFilter 'Установите фильтры'  Cyan, EscClose;
  Show at (,,40,5);
Screen scrFilter 'Фильтры' ('Фильтры',,sci13Esc);
Table Persons;
Fields
  wSTATPERS :[List
      0 'Работающие'
    , 1 'Текущая картотека'
    , 2 'Архивная картотека'
    , 3 'Все'
    ], Protect;
Buttons
  cmOk    ,,, 'Установить фильтр', hcAllBOk, scGalDial;
  cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;
<<
 `База для просмотра`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <. Продолжить .>  <.   Отмена   .>

>>
end; //Screen scrFilter (,,sci13Esс);
HandleEvent
cmInit:
{
}
cmDone:
{
}
cmOk:
{ CloseWindowEx(wnFilter,cmDefault)

}
end;// HandleEvent
end; //Windows wnFilter 'Установите фильтры' , Cyan, EscClose;


  browse brwKadrReserv1 (,hcStaff_KadrRezerv_sotr, sci1Esc);
#IFDEF _2018_10_19_
    show at (, 7,,16);
#ELSE
    show at (,,,10);
#ENDIF
    table tmpPersons;
    Fields
    tmpPersons.FIO 'Фамилия, имя, отчество'
              ('ФИО сотрудника', hcStaff_KadrRezerv_sotr) : [35], protect,nodel;
    tmpPersons.TabN 'Таб.номер'
              ('Табельный номер', hcStaff_KadrRezerv_sotr) : [10], protect,nodel;
    tmpPersons.StrTabN 'Таб.номер'
              ('Табельный номер', hcStaff_KadrRezerv_sotr) : [10], protect,nodel;
#IFDEF _GP_
    CatalogsSts1.code 'Код структурной единицы'
//    Podr1 'Структурная единица'
              ('Структурная единица', hcStaff_KadrRezerv_sotr) : [9], protect,nodel;
#ENDIF

    CatalogsSts1.Name 'Структурная единица'
//    Podr1 'Структурная единица'
              ('Структурная единица', hcStaff_KadrRezerv_sotr) : [19], protect,nodel;
    CatalogsPost1.Name 'Текущая должность'
              ('Текущая должность', hcStaff_KadrRezerv_sotr) : [16], protect,nodel;
#IFDEF _GP_
    Persons.DisDate 'Дата увольнения'
              ('Дата увольнения', hcStaff_KadrRezerv_sotr) : [11], protect,nodel;
#ENDIF

    end; // brwKadrReserv1


  //----------------------------------------------------------
  browse brwKadrReserv2(,hcStaff_KadrRezerv_sotr, sci1378Esc);
#IFDEF _2018_10_19_
//    show at (,17,,25);
    show at (,17,,);
#ELSE
    show at (,11,,);
#ENDIF
    table FuturePost;
    Fields
    NewPodr 'Планируемая структурная единица', '(Организация)'
              ('Планируемая структурная единица (Организация)', hcStaff_KadrRezerv_sotr) : [30], pickbutton, protect;
#IFDEF _GP_
    if ( FuturePost.iPrizn = 0, CatalogsSts2.Code, CatNewPodr.code )
             'Код планируемой структурной единицы', '(Код организации)'
              ('Код планируемой структурной единицы (Организации)', hcStaff_KadrRezerv_sotr) : [9], pickbutton, protect;
#ENDIF

    NewPost 'Планируемая', 'должность'
              ('Планируемая должность', hcStaff_KadrRezerv_sotr) : [15], pickbutton, protect;
    FuturePost.dat1 'Дата', 'зачисления'
              ('Дата зачисления в резерв', hcStaff_KadrRezerv_sotr) : [10,'DD/MM/YYYY'], NoProtect, Centered;
    FuturePost.dat2 'Дата', 'выбытия'
              ('Рекомендуемая дата перехода на должность', hcStaff_KadrRezerv_sotr) : [10,'DD/MM/YYYY'], NoProtect, Centered;
    FuturePost.iPrizn 'Организация'
              ('Тип организации', hcStaff_KadrRezerv_sotr): [List 'Собственная', 'Другая'], Protect;
    FoundatCat.Name 'Основание'
              ('Основание', hcStaff_KadrRezerv_sotr): [10], pickbutton, protect;
#IFDEF _GP_
    CompetenceCode 'Код уровня'
              ('Код уровня', hcStaff_KadrRezerv_sotr): [10], pickbutton, protect;
#ENDIF
    end;  // brwKadrReserv2


//-----------------------------------
// Прочитать параметры
//-----------------------------------
Procedure ReadParam;
{ if not ReadMyDsk(wSTATPERS,'KadrReserv_wSTATPERS',true) wSTATPERS:=0;
} //Procedure ReadParam;

//-----------------------------------
// Сохранить параметры
//-----------------------------------
Procedure SaveParam;
{ SaveMyDsk(wSTATPERS,'KadrReserv_wSTATPERS');
} //Procedure ReadParam;


//-----------------------------------
// Получить код  компетенции
//-----------------------------------
Function GetCompetenceCode:String;
{
  _Loop ComStaffStr
  {  if (isValid(tnCatStaffStr))
     { Result:=CatStaffStr.Code;
       break;
     }
  }
} //Function GetCompetenceCode:String;

Function GetLevCatRezerv  :comp;
{ Result:=0;
  if vSpr.Getfirst Catmain=tsok
    if vSpr.Getfirst Catalogs=tsok
      Result:=vSpr.Catalogs.Nrec;
} //Function GetLevCatRezerv  :comp;


//-------------------------------
// Вставить запись вышестоящего уровня
//-------------------------------
Procedure Ins_ComStaffStr_UP;
{ timelog('KadrReserv->Ins_ComStaffStr_UP:Start');
  //if isValidAll(tnComStaffStr_UP) then exit;
  if getfirst ComStaffStr_UP=tsok then exit;
  if FuturePost.cStaffStr=0 then exit;
  timelog('KadrReserv->Ins_ComStaffStr_UP:INS');

  insert  ComStaffStr_UP set
          ComStaffStr_UP.CSTAFFSTR := FuturePost.cStaffStr
         ,ComStaffStr_UP.cName     := pLevCatRezerv
         ,ComStaffStr_UP.WWEIGHT   := 100
         ,ComStaffStr_UP.WPOS      := 1 // надо бы номер проставить....
         ;
} //Procedure Ins_ComStaffStr_UP;


//-----------------------------------
// #2104.#2
// Проверить наличие кода компетенции по ставке
// В момент добавления новой записи о кадровом резерве,
// подставлять в графу "Код уровня" значение по умолчанию,
// с закладки "Компетенции" профиля должности.
// Компетенция должна лежать в папке "Уровни кадрового резерва".
//-----------------------------------
Function CheckCompetenceCode:boolean;
{ Result :=False;
  timelog('KadrReserv->CheckCompetenceCode:Start');
  Ins_ComStaffStr_UP;
  if isValidAll(tnComStaffStr) then exit;
  timelog('KadrReserv->CheckCompetenceCode:Ищем по должности');
  _Loop COMPETENCEPOST
  { //if isValidAll(tnCOMPETENCEPOST_UP)
    timelog('KadrReserv->CheckCompetenceCode:есть компетенция');
    if getfirst CompetencePost_Up=tsok
    { timelog('KadrReserv->CheckCompetenceCode:создаем по должности');
      insert ComStaffStr set
          ComStaffStr.CSTAFFSTR := FuturePost.cStaffStr
         ,ComStaffStr.cName     := COMPETENCEPOST.cName
         ,ComStaffStr.WWEIGHT   := 100
         ,ComStaffStr.cParent   := ComStaffStr_UP.Nrec
         ,ComStaffStr.WPOS      := 1 // надо бы номер проставить....
        ;
      break;
    }
  } //_Loop COMPETENCEPOST
  Result:=True;
} //Function CheckCompetenceCode:boolean;

//------------------------------
// Заполнить времянку
//------------------------------
Procedure FillTmpPersons(_wIsEmployee:word);
{ NextVisual;
  case _wIsEmployee of
  1: PushBounds(tbbyWork);
  2: PushBounds(tbbyCurrent);
  3: PushBounds(tbbyDis);
  end;
  _loop Persons
  { NextVisual;
//------------------------------------------------------------------------------
    //Разграничение доступа
    //Нет доступа к подразделению
    if not VuserAcs.Exists(Persons.Department)
      continue;
//------------------------------------------------------------------------------
    ClearBuffer(#tmpPersons);
    tmpPersons.FIO     := Persons.FIO;
    tmpPersons.TabN    := Persons.TabNmb;
    tmpPersons.StrTabN := Persons.StrTabN;
    tmpPersons.PersNrec:= Persons.Nrec;
    insert current tmpPersons;
  } //_loop Persons
} //Procedure FillTmpPersons(_sIsEmployee:string);

//------------------------------
// установка фильтра
//------------------------------
Procedure SetFilterBounds;
{ if (delete all tmpPersons <> tsOk){};
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm,
                      'Подготовка информации', RecordsInTable(#Persons));
  NextVisual;
  case wSTATPERS of
  0: FillTmpPersons(1);
  1: FillTmpPersons(2);
  2: FillTmpPersons(3);
  3:
  { FillTmpPersons(2);
    FillTmpPersons(3);
  }
  end;
  StopVisual('', 0);

  if (getfirst tmpPersons <> tsOk){};
  PopBounds(#Persons);

} //Procedure SetFilterBounds;



//********************************************
// события интерфейса
//********************************************
Handleevent
cmInit:
{ timelog_init;
  pLevCatRezerv:=GetLevCatRezerv;
  timelog('KadrReserv->cmInit:pLevCatRezerv='+string(pLevCatRezerv,0,0));
  ReadParam;
  /* Заберем целиком
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
  */
        if not GetVipRef(VuserAcs, 'UserDepartmentsIterator')
        {
          Message('Не найден интерфейс разграничения прав доступа UserDepartmentsIterator.', Information);
          abort;
          exit;
        }

        if (wGetTune('FormatClockNumber') = 0)
        {
          ClearFieldState(#tmpPersons.StrTabn, sfVisible);
        }
        else
        {
          ClearFieldState(#tmpPersons.Tabn, sfVisible);
        }
#IFDEF _GP_
      SetFilterBounds;
#ELSE
//==============================================================================
        if (delete all tmpPersons <> tsOk){};
        StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm,
                      'Подготовка информации', RecordsInTable(#Persons));
        _loop Persons where (('С'  == Persons.IsEmployee  and
                               0   == Persons.DisDate))
        { NextVisual;
//------------------------------------------------------------------------------
          //Разграничение доступа
          //Нет доступа к подразделению
          if not VuserAcs.Exists(Persons.Department)
            continue;
//------------------------------------------------------------------------------
          ClearBuffer(#tmpPersons);
          tmpPersons.FIO := Persons.FIO;
          tmpPersons.TabN:= Persons.TabNmb;
          tmpPersons.StrTabN:= Persons.StrTabN;
          tmpPersons.PersNrec:= Persons.Nrec;
          insert current tmpPersons;
        }
        StopVisual('', 0);

        if (getfirst tmpPersons <> tsOk){};
        PopBounds(#Persons);
#ENDIF

}
cmDone:
{ SaveParam;
  case inherited :: handleEvent (cmDone) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
cmPick:
{
  case inherited :: handleEvent (cmpick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
 case curfield of
  // -----------
  #NewPodr:
  { if FuturePost.cStaffStr>0
    CheckCompetenceCode;
    ReScanPanel(#FuturePost);
  }
  #CompetenceCode:
   { SetModified(true);
     UpdateTable;

    var cNrec : comp;
    cNrec := if(isValid(tnCatStaffStr),CatStaffStr.nrec,0h);
    if isValidAll(tnFuturePost)
    if (RunInterface('Z_STAFFCAT::PickCatalog2', 100, cNrec, 0,0) <> cmCancel)
    {  if getfirst fastfirstrow CatCheck where ((cNrec == CatCheck.nrec)) = tsOK
       {
        if CatCheck.cParent <> pLevCatRezerv
        {
          Message('Необходимо выбрать запись, подчиненную "Уровни кадрового резерва"',error)
        }
        else
         {
          Ins_ComStaffStr_UP;
          if getfirst ComStaffStr=tsok // isValid(tnComStaffStr)
           {
            update current ComStaffStr set ComStaffStr.cName := cNrec;
           }
           else
           {
             insert ComStaffStr set
               ComStaffStr.CSTAFFSTR := FuturePost.cStaffStr
              ,ComStaffStr.cName     := cNrec
              ,ComStaffStr.WWEIGHT   := 100
              ,ComStaffStr.WPOS      := 1 // надо бы номер проставить....
              ,ComStaffStr.cParent   := ComStaffStr_Up.Nrec
             ;
           }
         } // else if CatCheck.cParent <> pLevCatRezerv
      } // if getfirst fastfirstrow CatCheck where ((cNrec == CatCheck.nrec)) = tsOK
     } // if (RunInterface('Z_STAFFCAT::PickCatalog2', 100, cNrec, 0) <> cmCancel)
     //rereadrecord;
     ResCanPanel(#FuturePost);
   } // #CompetenceCode:
 end;
} // end cmpick:
cmFilterSave:
{ if RunWindowModal(wnFilter)=cmDefault
  { SetFilterBounds;

  }

}
end;
end.


