procedure PrintRepPage(isStayAlone : boolean);
{
  var isOkFile : boolean = false;
  var isDoRep  : boolean = false; 
  
  ClearRK;
  initRK;

  if isStayAlone
    if SetParamRK
      isDoRep := true;
  if not isStayAlone
    isDoRep := isCheckRepParam(true);

  if isDoRep
  {
    MakeRK;
    if isDataRK
    {
      if isStayAlone
      {
        if wToExistFile = 0 {isOkFile := OpenNewRKS  ;}
        if wToExistFile = 1 {isOkFile := OpenExistRKS;}
      }
      else
      {
        isOkFile := true;
      }
      if isOkFile
      {
        PrintRK;

/* в ТЗ нет расшифровки, отключаем. если понадобится включаем
        if (wPrintRash = 1) and isStayAlone
        {
          var i, j : integer = 0;
          var s    : string = '';
          xlGetSheetsCount(j);
          while i<=j
          {
            xlSetActiveSheet(++i);
            xlGetSheetName(i,s);
            if s='7-к' break;
          }
          xlSetActiveSheet(++i);
          xlAddSheet;
          xlSetSheetName(i,'Расшифровка 7-к'); 
          xlSetActiveSheet(i);
          PrintRash;
        }
*/

        xlSetActiveSheetByName('7-к');
        if wToExistFile = 0 {sToExistFile:='';}
        if isStayAlone
          xlKillExcel;
      }
      else if isStayAlone message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
    }
    else if isStayAlone message('Нет данных для отчета.');
  }
  SaveRK;
  ClearRK;
  closeinterface(cmDefault);
}
//++++++++++++++++++++++++++++++++++++++++++++++++
//--------------------------------------------------------
function bSetRepParam : boolean;  
{
  result := false;
  if RunWindowModal(WinRKParamEx)=cmDefault
    result := true;
}//function bSetRepParam
Function GetReportName: String;
{
  GetReportName := '#(GPNam) (ЭМ)';
}
function GetPriority : Integer;
{
  GetPriority := 7;
}
procedure initRKStatRepParam;
{
  initRK;
}
function dRepOnDateParam : date;
{
  dRepOnDateParam := dRep;
}
//--------------------------------------------------------
tableevent table OborCfgCol;
  cmUpdateRecord: update current OborCfgCol;
end;

handleevent
  cmInit:
  {
    PrintRepPage(true);
  }
  cmPick:
  {
    case CurField of
      #FiltrPodr: { PAF.ChangeDepartmentFilter(true); RereadRecord; }
      #sToExistFile: set sToExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #FiltrPodr:      { PAF.ClearDepartmentFilter; RereadRecord; }
      #sToExistFile:{ set sToExistFile:=''; }
    end;
  }
  cmCheckField:
  {
    case CurField of
      #wToExistFile:
      {
        if wToExistFile = 1 
          ToggleFieldVisible(#sToExistFile,true )
        else
          ToggleFieldVisible(#sToExistFile,false);
      }
      #dRep:
      {
        RefreshOborCfg;
        RereadRecord(#OborCfgCol);
      }
    end;
  }
end;


End.
