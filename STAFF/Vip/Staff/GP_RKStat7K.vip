window WinRKParamEx 'Параметры формирования. Лист 7-к.' Gray;
show at (,,95,14);
Screen sEx(,,sci1Esc);
  show (,,,4) fixed_y;
  fields
    dRep   ('Дата формирования'): {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    FiltrPodr ('Выбранные подразделения',hcStaffAppDepartment,sci13Esc): Protect, PickButton ;
<< 'Параметры отчета'

 `Дата формирования       `.@@@@@@@@@@@
 `Подразделения для отчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;
browse brManualValuesEx (,,sci1Esc);
  show(,5,,12);
  table OborCfgCol;
  fields
    OborCfgCol.Name 'Показатель': [40], protect;
    OborCfgCol.Sum[1] '1 полугодие': [10,2], noprotect;
    OborCfgCol.Sum[2] '2 полугодие': [10,2], noprotect;
    OborCfgCol.Attr[0] 'Результат': [List 0 'Суммировать', 1 'Замещать'], protect;
end;
screen sc2Ex(,,sci1Esc);
  show(,13,,) fixed_y;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
<<
   <. ~С~охранить .>                                                        <. ~З~акрыть .>
>>
end;
HandleEvent
  cmOK:
  {
    SaveRK;
    initRK;
    if not isCheckRepParam(true)
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
  cmCancel:
  {
    SaveRK;
    CloseWindowEx(CurWindow,cmCancel);
  }
end;
end;//WinRKParamEx
