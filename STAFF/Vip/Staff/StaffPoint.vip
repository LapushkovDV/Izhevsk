#include RPD.vih
#include EMStaffFunc.vih
      
handler with replace epRPD_CheckBeforeEM on extensionPoint epRPD_CheckBefore(cContDoc: comp) [2]
action
{
  var oEMStaffFunc : EMStaffFunc;
