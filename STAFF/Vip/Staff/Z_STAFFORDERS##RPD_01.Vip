function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
{
  result:=inherited::ChildCheckOneOrder(cNrec);

  if (not IsValidAll(tnJobNatureCat)) {
    SetErrorOrder('Приказ утвердить нельзя: не указан характер работы.');
    result := false;
  }

  if (ContDoc.dat1<>ZeroDate) {
    if (ContDoc.dat1 <> Add_Day(ContDoc.dPrik,13) and
        ContDoc.dat1 <> Sub_Day(Add_Months(ContDoc.dPrik,2),1) and
        ContDoc.dat1 <> Sub_Day(Add_Months(ContDoc.dPrik,3),1) and
        ContDoc.dat1 <> Sub_Day(Add_Months(ContDoc.dPrik,6),1)) {
      SetErrorOrder('Приказ утвердить нельзя: поле "Испыт.срок по." должно содержать значения: 2 недели, 2 месяца, 3 месяца, 6 месяцев.');
      result := false;
    }
  }

  if (ContDoc.wDopAttr=UsualReception) //Прием/Обычное оформление приказа
  { if (getfirst fastfirstrow Passports where((Persons.NRec==Passports.Person and 501==Passports.SysCode))=tsok)
    { //СНИЛС
      var RecCount:longint=0;
      var _sFio    :string='';
      var _StrTabn :string='';
      //var d1:date=date(1,1,Year(ContDoc.dPrik));
      sql
        select Count(Passports.NRec),Max(Persons.Fio),Max(Persons.StrTabn)
        from        Passports
        inner join Persons on Persons.Nrec = Passports.Person
      where   Passports.Nmb = :(Passports.Nmb) and  Passports.SysCode = 501
          and Passports.Person <>:(Persons.Nrec)
      into (RecCount, _sFio, _StrTabn);
      if (RecCount>0)
      {
        result := false;
        SetErrorOrder('Приказ утвердить нельзя: необходимо выбрать вариант оформления приказа "Повторное трудоустройство".');
        SetErrorOrder('СНИЛС повторяется например у '+_StrTabn+','+_sFio+', всего '+string(RecCount)+' повторений' );
      }
      else
      if (bCheckBeforePrint)
      { SetErrorOrder('Предыдущее трудоустройство проверено.',Information);
      }
    } //if (getfirst fastfirstrow Passports where((Persons.NRec==Passports.Person and 501==Passports.SysCode))=tsok)
  }//if (ContDoc.wDopAttr=UsualReception) //Прием/Обычное оформление приказа
  // что то я не понял - скобок не хватает?
  if (not result and boUsePartOrders and ContDoc.wYearPr = 3)
    update current ContDoc set ContDoc.wYearPr := 0;
} //function ChildCheckOneOrder(cNrec : comp = 0): boolean;

Procedure CreateTrDog(_c : comp);
{
  if (_c <> 0h) then
  {
    Exit;
  }

  /*var newNum : string = '';

  if (getLast LastSpAllStaff where ((     5 == LastSpAllStaff.wNoCon (noIndex)
                                      and 0 << LastSpAllStaff.nRec              )) = tsOk) then
  {
    newNum := string(if(LongInt(LastSpAllStaff.ResString[1]) > 0, LongInt(LastSpAllStaff.ResString[1]) + 1, 1));
  }*/

  ClearBuffer(#SpAllStaff);
    SpAllStaff.nRec         := 0h;
    SpAllStaff.wNoCon       := 5;
    SpAllStaff.ResComp[1]   := cTrDogType;
    SpAllStaff.ResDate[1]   := TitleDoc.DocDate; //ContDoc.dPrik;
    SpAllStaff.ResDate[2]   := TitleDoc.DocDate; //ContDoc.dPrik;
    SpAllStaff.ResString[1] := TitleDoc.DocNmb; //newNum;
  Insert Current SpAllStaff;

  cTrDog := SpAllStaff.nRec;
}

Procedure FillFirstPersons(bCheckNeedTabn: boolean);
{
  inherited::FillFirstPersons(bCheckNeedTabn);

  if (wFakel = 1) then
  {
    Set Persons.JobNature := cJobNature;
    Update Current Persons;
  }
}


//******************************************************************************
// События таблицы ContDoc
//******************************************************************************
TableEvent table ContDoc;
cmCheckField:
{ timelog('RPD_1->ContDoc->cmCheckField:start');
  case inherited::handleEvent(cmCheckField) of
    heAbort: { abort; exit; }
    heStop: { stop; exit; }
  end;
  timelog('RPD_1->ContDoc->cmCheckField:finish');

}
end;//TableEvent table ContDoc

TableEvent Table Appointments;
  cmCheckField :
  {
    if (inherited::HandleEvent(cmCheckField) = heAbort) then
    {
      Abort;
    }
    if (wFakel = 1) then
    {
      Case CurField Of
        #ContDoc.dPrik:
        {
          ContDoc.Dat1 := Sub_Day(Add_Months(ContDoc.dPrik, 3), 1);
          SetModified(true);
          if (getFirst FastFirstRow LastSpAllStaff where ((cTrDog == LastSpAllStaff.nRec)) = tsOk) then
          {
            set LastSpAllStaff.ResDate[1] := ContDoc.dPrik;
            Update Current LastSpAllStaff;
          }
        }
      End;
    }
  }
  cmSetDefault:
  {
    if (inherited::HandleEvent(cmSetDefault) = heAbort) then
    {
      Abort;
    }
    if (wFakel = 1) then
    {
      if (ContDoc.dPrik <> Date(0, 0, 0)) then
      {
        ContDoc.Dat1 := Sub_Day(Add_Months(ContDoc.dPrik, 3), 1);
        CreateTrDog(cTrDog);
        Appointments.KindApp := cKindApp;
        Appointments.ResComp[1] := SpAllStaff.nRec;
      }
    }
  }
End;

//------------------------
// События интерфейса
//------------------------
HandleEvent
  cmIdle: // бывают ведь и различные виды приема, когда надо дизеблить
  {
    case inherited::handleEvent(cmIdle) of
    heAbort: { abort; exit; }
    heStop: { stop; exit; }
    end;
    // Если сдвиг еще не произведен
    if (not IsShiftAllObj)
    { //'Z_STAFFORDERS::ORDERSLIST.WHATISINORDER.MDF.Z_STAFFORDERS::CONTAINEROFORDERS.MDF.
      //Z_STAFFORDERS::RPD_1.FIRSTSCR.STRAHCAT.CATDATA'
      // Сдвигаем в анкетном редакторе FirstScr поля чтобы освободить место для новых полей
      IsShiftAllObj := ShiftAllObj('FIRSTSCR', 'i_FIRSTSCR_CONTDOC.WORDER');
    }
  }
cmViewAdvance1: //просмотр примечания к приказу
{ if  inherited :: handleEvent (cmViewAdvance1)=heAbort then Abort;
  MySetButtonTitle;
}

cmValue21: //доп. условия
{ if  inherited :: handleEvent (cmValue21)=heAbort then Abort;
  MySetButtonTitle;
  // почему то сразу не обновляется
  EnableDisable;
}
cmOnVipLoad:
{
  timelog_init;
  timelog('RPD_1->cmOnVipLoad');

  case inherited::handleEvent(cmOnVipLoad) of
    heAbort: { abort; exit; }
    heStop:  { stop; exit; }
  end;

  wFakel := wGetTune('UP.FakelGAL.Fakel');
  if (wFakel = 1) then
  {
    cTrDog := 0h;
    cTrDogType := coGetTune('FAKEL.UP.RPD1.TRDOGTYPE');
    cJobNature := coGetTune('FAKEL.UP.RPD1.JOBNATURE');
    cKindApp   := coGetTune('FAKEL.UP.RPD1.KINDAPP');
  }
}
cmCheckField:
{ timelog('RPD_1->cmCheckField:start');
  case inherited::handleEvent(cmCheckField) of
    heAbort: { abort; exit; }
    heStop: { stop; exit; }
  end;
  case CurField of
  #ContDoc.wDopAttr, #ContDoc.wOrder:
  {  EnableDisableBankReq;
    //EnableDisable;
  }
  end;
  timelog('RPD_1->cmCheckField:Finish');
}
cmPick:
{ timelog('RPD_1->cmPick:Start');
  case inherited::handleEvent(cmPick) of
  heAbort: { abort; exit; }
  heStop: { stop; exit; }
  end;
  timelog('RPD_1->cmPick:Finish');
}

end;

END.
