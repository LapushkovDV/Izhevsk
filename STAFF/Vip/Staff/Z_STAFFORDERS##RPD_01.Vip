// Сдвигает в анкетном редакторе scr вниз на DeltaCount строк все поля начиная с поля ObjFrom
function ShiftAllObj(scr, ObjFrom: string; DeltaCount: word = 1): boolean;
{
  result := false;

  var yFrom: integer = 0;
  var rc: longint = cfsGetProp(ObjFrom, cfpOrigin_Y, yFrom);
  if (rc <> cfOK or yFrom = 0)
    exit;
  var Delta: integer = 0;
  rc := cfsGetProp(ObjFrom, cfpSize_Y, Delta);
  if (rc <> cfOK or Delta = 0)
    exit;
  Delta += 6;
  Delta *= DeltaCount;

  var aList: array [1..1] of string;
  SetLimit(aList, 0);
  rc := cfsEnumObjects(scr, aList, false);
  if (rc <> cfOK)
    exit;

  var i, n: longint;
  n := Count(aList);
  for (i := 1; i <= n; i++) {
    if (UpCase(aList[i]) = 'L_FIRSTSCR_БАНКОВСКИЕ_РЕКВИЗИТЫ_И_ПЕРЕЧИСЛЕНИЯ' or
        UpCase(aList[i]) = 'I_FIRSTSCR_CONTDOC.WATTRDOC4')
      continue;
    var y: integer = 0;
    rc := cfsGetProp(aList[i], cfpOrigin_Y, y);
    if (rc = cfOK) {
      if (y = 0) { // Может быть элемент скрыт
        var IsVisible: boolean = false;
        rc := cfsGetProp(aList[i], cfpVisible, IsVisible);
        if (not IsVisible and rc = cfOK) {
          cfsSetProp(aList[i], cfpVisible, true);
          cfsGetProp(aList[i], cfpOrigin_Y, y);
          cfsSetProp(aList[i], cfpVisible, false);
        }
      }

      if (y > yFrom)
        rc := cfsSetProp(aList[i], cfpOrigin_Y, y + Delta);
    }
  }
  result := true;
}
extendFormats FirstScr;

screen FirstScr;
  Show  at (, 5,, 12.2) fixed_y;
  Table ContDoc;// Без этого не работаю стандартные обработчики по событиям таблицы ContDoc
  fields
    ContDoc.wAttrDoc4 ('Копировать, или нет в открываемый лицевой счёт банковские реквизиты и перечисления из постоянных удержаний старого лицевого счёта',, sci13EnEsc):
     [LIST 0 'копировать из старого ЛС',
           1 'не заполнять'
     ], protect;
<<










`Банковские реквизиты и перечисления`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>

end;

procedure EnableDisableBankReq;
{
  // Поле "Банковские реквизиты и перечисления" доступно только если в поле "Вариант оформ-я" значение "Повторное трудоустройство"
  // и в поле "Вариант ЛС и карточки" значение "Новые ЛС и карточка" или "Новый ЛС, старая карточка"
  // RepeatEmpl - константа из стандартного интерфейса RPD_1
  //SetFieldAndLabelVisible(#ContDoc.wAttrDoc4, fnFieldsOpen and ContDoc.wDopAttr = RepeatEmpl
  // and (ContDoc.wOrder = 0 or ContDoc.wOrder = 2));
  SetFieldAndLabelVisible(#ContDoc.wAttrDoc4,ContDoc.wDopAttr = RepeatEmpl);
  ToggleFieldSelectable(#ContDoc.wAttrDoc4,TitleDoc.wStatus=0);
}

