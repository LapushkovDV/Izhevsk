Procedure DeleteNewDataUnderButtons(cComp: comp);
{ //на вход идет ContDoc.Person - если там 0, то будет удалено много информации по не утвержденным приказам
  if cComp=0 then Exit;
  Inherited::DeleteNewDataUnderButtons(cComp);
}

//******************************************************************************
//  Процедура удаления
//******************************************************************************
procedure IRPD_Base.MyDel;
{ if TitleDoc.wStatus=1
    iGP_SCUD_PersEdit.DeleteBufferPers(Persons.Nrec,ContDoc.ObjNrec,TitleDoc.Nrec,Contdoc.Nrec,PartDoc.TypeOper);
  inherited::MyDel;
} //procedure IRPD_Base.MyDel;
//******************************************************************************
//  Процедура утверждения индивидуального приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{ 
  // Ищем предыдущий лицевой счёт
  var _cLSchetSrc: tNRec = 0;
  if cNrec <> 0
    GetFirst ContDoc where ((cNrec == ContDoc.NRec));
  if (GetFirstLschet(ContDoc.cNew1))
    _cLSchetSrc := LSchet.NRec;
  Result:=Inherited::ChildConfirmOneOrder(cNrec);
  if Result
  { iGP_SCUD_PersEdit.MakeBufferPers(Persons.Nrec,ContDoc.ObjNrec,TitleDoc.Nrec,Contdoc.Nrec,PartDoc.TypeOper);
    // Если в поле "Вариант оформ-я" выбрано значение "Повторное трудоустройство"
    if (ContDoc.wDopAttr = RepeatEmpl)
      // и в поле "Вариант ЛС и карточки" значение "Новые ЛС и карточка" или "Новый ЛС, старая карточка"
      if (ContDoc.wOrder = 0 or ContDoc.wOrder = 2)
        // и в поле "Банковские реквизиты и перечисления" выбрано "копировать из старого ЛС"
        if (ContDoc.wAttrDoc4 = 0)
        {
          // Копируем в открываемый лицевой счёт банковские реквизиты и перечисления из постоянных удержаний
          // старого лицевого счета
          // Ищем новый лицевой счёт
          //var _cLSchetDst: tNRec = oGP_LSBankReq.FindLSchet(ContDoc.LiTabN, ContDoc.StTabN);
          var _cLSchetDst: tNRec=0;
          if ( GetFirstLschet(Persons.nRec) )
            _cLSchetDst:=Lschet.nrec;

          timelog('RPD1->ChildConfirmOneOrder:Банк '+string(_cLSchetSrc,0,0)+', '+string(_cLSchetDst,0,0));
          if (_cLSchetSrc <> 0 and _cLSchetDst <> 0)
          and (_cLSchetSrc <>  _cLSchetDst)
          {
            // в поле "Начало пересчёта" проставляем наибольшую дату из двух: либо дату повторного приема на работу из приказа,
            // либо дату начала отчётного периода модуля Зарплата
            var _StartPerDt: Date = dGetTune('UP.DATOTCH');
            if (ContDoc.dPrik > _StartPerDt)
              _StartPerDt := ContDoc.dPrik;
            // Копируем банковские реквизиты
            oGP_LSBankReq.CopyBankReq(_cLSchetSrc, _cLSchetDst, true, _StartPerDt);
            displ('Скопированы банковские реквизиты');
            //Проведена привязка старого и нового лицевых счетов сотрудника: Абратанов Николай
          }
          else
          { displ(Persons.fio+': Не скопированы банковские реквизиты');
          }
        }
  }
} //function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;

//******************************************************************************
// можно вынести в RPD_BASE, но тогда начинают идти 6 предупреждений на base_Payment
// да и EnableDisable в 8 перехвачена
//******************************************************************************
Create view vNotes
var
  nRecTable:comp;
  wChoice  :word;
From Notes
where ((
      wChoice     == Notes.choice
  and nRecTable   == Notes.Owner
));

File FMemo;

Function MyCheckNotes(_wChoice:word):boolean;
{ Result:=false;
  vNotes.nRecTable:=ContDoc.Nrec;
  vNotes.wChoice  :=_wChoice;
  Result:=vNotes.Getfirst Notes=tsok;
  if not Result exit;
  if FMemo.OpenMemo(vNotes.Notes.NOTE)
  { Result:=FMemo.GetSize()<>0;
    FMemo.Close;
  }
} //Function MyCheckNotes(_wChoice:word):boolean;
//******************************************************************************
// Установить надписи на кнопках
//******************************************************************************
Procedure MySetButtonTitle(_nm_screen:string='');
{ //'Z_STAFFORDERS::NOTESFORCONTDOC.Memo_NOTES.NOTE'
  var ww_str:string;
  if _nm_screen='' _nm_screen:='b_SCRDOC';
  //cmViewAdvance1
  ww_str:=if(MyCheckNotes(3002),'Примечан.+','Примечание');
  cfsSetProp(_nm_screen+'_Примечание',cfpTitle,ww_str);
  //--
  ww_str:=if(MyCheckNotes(3005),'Доп.условия+','Доп. условия');
  cfsSetProp(_nm_screen+'_Доп._условия',cfpTitle,ww_str);
  ReScanPanel(#PERSONS);
} //Procedure MySetButtonTitle;

