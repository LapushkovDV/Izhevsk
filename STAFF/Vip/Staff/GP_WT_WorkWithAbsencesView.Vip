table struct local tmp_report_sp
(  nrec     :comp
 , pr       :Integer
 , sortname :string // для сортировки
 , cRec     :comp   // ссылка на заголовок
 , FIo      :string
 , cPers    :comp
 , cPost    :comp
 , cPodr    :comp
 , Kateg    :word
 , MesN     :word
 , YearN    :word
 , dmd : array[1..38] of double
 , dms : array[1..38] of string
)
with index
( tmp_report_sp01  = nrec (AutoInc, Unique),
  tmp_report_sp03  = cRec+sortname+YearN+MesN,
  tmp_report_sp04  = cRec+cPers+cPodr+cPost+YearN+MesN+Kateg
);
//------------------
// Для предвыборки табеля
Table Struct local tmp_LsTab
( cLstab  :comp
 ,cPerexod:comp
 ,cKatPodr:comp
 ,cAppoint:comp
 ,Kateg   :word
 ,Fio     :string[100]
 ,cPersons:comp
 ,cLschet :comp
 ,Podr_Kod:string[10]
 ,STRTABN:string[10]
 ,Podr_KodAll:string[10]
 ,Podr_Name:string
 ,Podr_Nrec:comp
 ,sPost   :string
 ,MesN    :word
 ,YearN   :word
)
with index
( tmp_LsTab01 = cLsTab + cPerexod
);

//------------------
// Для предвыборки заявлений
Table Struct local tmp_Zauv
(   EventDate:date //   : date "Дата события"
  , EventTmB :time //  : time "Время события с"
  , EventTmE :time //  : time "Время события по"
  , wType    :word //  0 - личные невыходы,1 - служебные
  , cPersons :comp
  , cGP_SCUD_PERS :comp
  //, DocNumber:string[30]
  //, DocDate:date
  , cGp_SCUD_DOC_SP :comp
  , cGp_SCUD_DOC    :comp

)
with index
( tmp_Zauv01 = cPersons + EventDate
);
