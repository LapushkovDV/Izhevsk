/*************************************************************************************************\
* Наименование: Интерфейс редактирования РПД 235 "Проведение обучения (наставничество)"           *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Документы / Все приказы по персоналу                                                *
* Примечание:                                                                                     *
* К каталог "Распорядительные действия по персоналу" РПД 235 нужно занести вручную.               *
* РПД 235 полностью наследует РПД 35. добавлено одно поле: "Наставник".                           *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#338          |06/06/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

/*
РПД 235 наследует всю логику и все поля из РПД 35.

Добавлены следующие поля:
- Наставник
- Дата экзамена
- Время экзамена
- Вид, сумма и тип доплаты наставнику

Чтобы не выбирать группу подписантов каждый раз при формировании формы, разработан специальный интерфейс,
в котором можно указать какую группу подписантов для какой формы нужно использовать.
Этот интефейс вызывается пунтктом меню "Управление персоналом / Отчеты / Отчеты пользователя / Настройки /
Настройка подписей в отчетах".

В форме используются подписанты со следующими ролями:

1. Роль "Ответственный":
организовать обучение ...

2. Роль "Главный бухгалтер":
Главному бухгалтеру ...

3. Роль "Проверяющее лицо":
Контроль за исполнением настоящего приказа возложить на ...

4. Роль "Утверждающее лицо":
Подпись под приказом ...

В случае, если в приказе указан вид и сумма доплаты наставнику, при утверждении приказа в рабочую корзину
помещается запись с данными для назначения доплаты наставнику.

Перед тестированием нужно добавить запись с каталог РПД (Управление персоналом / Настройка / Заполнение каталогов /
Распорядительные действия по персоналу) с кодом 235, например:
Код: 235
Название: Проведение обучения (наставничество)
Отдельная нумерация: нет
Номер группы: 2
Доп.согл.: нет
*/
#component "Z_StaffOrders"

#include RPD.vih
#include AppFuncs.vih // Функции работы с назначениями

vipInterface RPD_235(RPD_35)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base.MyDel;
  function IRPD_Base.ChildCheckOneOrder(cNRec: Comp = 0): Boolean;
  function IRPD_Base.ChildConfirmOneOrder(cNRec: Comp = 0): Boolean;
end;

interface RPD_235 escClose;

  create view
    as select
      if (Fortune.wAttr1 = 0, 'нац.валюта',
        if (Fortune.wAttr1 = 1, KlVal.SimvolV,
         if (Fortune.wAttr1 = 2, 'проценты', ' ')))
          (FieldName = CurrNameFort)
    from
      Fortune,
      KlVal,
      ZarSignal,
      KlVidOpl,
      synonym LSchet LSchetL,
      synonym Catalogs FortRaiseCat
    where ((
          ContDoc.NRec     == Fortune.cFCont
      and Fortune.cFType   == FortRaiseCat.NRec
      and Fortune.FortCurr == KlVal.NRec
    ))
  ;

  var
    VAppFuncs: AppointmentsFunctions;

  overloadFormats scrDet35;

  // Экран почти полностью взят из РПД 35, добавлено одно поле: "Наставник"
  screen scrDet35 (, hcStaffWinPr, scStaffMyPnl);
    show at (, 5,, 14);
    table Education;
    fields
      LeadPersons.FIO ('Наставник',, scStaffMyPnlPick): protect;
      EduLevelCat.Name ('Вид образования', hcStaffPersonsEducation, scStaffMyPnlPick): protect;
      EduNameCat.Name ('Наименование учебного заведения', hcStaffEduName, scStaffMyPnlPick): protect;
      TopicEductCat.Name ('Тема обучения',, scStaffMyPnlPick): protect;
      EduSpecialityCat.Name ('Специальность', hcStaffEduSpeciality, scStaffMyPnlPick): protect;
      Education.PaySum ('Сумма обучения'): [10.3];
      Education.FromDate ('Дата поступления', hcStaffEduFromDate): noProtect;
      Education.ToDate ('Дата окончания', hcStaffEduToDate): noProtect;
      Education.LastDate ('Дата квалификационного экзамена'): noProtect;
      Education.LastTime ('Время квалификационного экзамена'): noProtect;
      Education.Nmb2 ('Количество часов'): noProtect;
      EduReasonCat.Name ('Основание для обучения',, scStaffMyPnlPick): protect;
      ContDoc.SBottom ('Основание для приказа', hcStaffWinPr), noProtect;
    buttons
      cmViewAdvance1,,, 'Просмотр примечания к приказу', hcStaffWinPr;
    <<
`Наставник`              .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Вид образования`        .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Учебное заведение`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Тема обучения`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Специальность`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Стоимость`              .@@@@@@@@@@@       
`Дата начала`            .@@@@@@@@@@@           `Дата окончания`.@@@@@@@@@@@
`Дата экзамена`          .@@@@@@@@@@@           `Время экзамена`.@@@@@@@@@@@
`Кол-во часов`           .@@@@@@@@@@@
`Основание для обучения` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Основание для приказа`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                              <. Примечание .>
    >>
  end;

  screen scrFortune (, hcStaffWinPr, sci1Esc);
    show at (, 15,,);
    table Fortune;
    fields
      FortRaiseCat.Name ('Вид доплаты',, sci13Esc): protect;
      Fortune.DocSum ('Сумма доплаты') : [11.2], noProtect;
      CurrNameFort ('Валюта или проценты.',, sci13Esc), Protect;
    <<

 Вид доплаты наставнику  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Сумма (процент)         .@@@@@@@@@@@@ .@@@@@@@@@@@@@@@@@@
    >>
  end;

  procedure EnableDisable;
  begin
    inherited::EnableDisable;
    // Если приказ не утвержден
    if fnFieldsOpen then
    begin
      SetFieldOption(#FortRaiseCat.Name, ofSelectable);
      SetFieldOption(#Fortune.DocSum, ofSelectable);
      SetFieldOption(#CurrNameFort, ofSelectable);
      SetFieldOption(#Education.Nmb2, ofSelectable);
    end else
    begin
      ClearFieldOption(#FortRaiseCat.Name, ofSelectable);
      ClearFieldOption(#Fortune.DocSum, ofSelectable);
      ClearFieldOption(#CurrNameFort, ofSelectable);
      ClearFieldOption(#Education.Nmb2, ofSelectable);
    end;
  end;

  procedure MyDel;
  begin
    if IsValid(tnFortune) then
      delete current Fortune;
    inherited::MyDel;
  end;

  // Добавление записи о доплате наставнику в рабочую корзину
  function InsZarSignal: Boolean;
  var
    _cLSchet: comp;
    _VidOpl: LongInt;
  begin
    result := false;
    // Если не заполнено поле "Наставник"
    if Education.cInf2 = 0 then
      exit;
    // Если не заполнено поле "Сумма(процент)"
    if Fortune.DocSum = 0 then
      exit;
    // Если не найден лицевой счёт наставника
    if not MLFP.GetMainLschetWorkIndep(LeadPersons.NRec, _cLSchet) then
      exit;
    if getFirst LSchetL where ((_cLSchet == LSchetL.NRec)) != tsOk then
      exit;
    // Если не заполнено поле "Вид доплаты"
    if not IsValid(tnFortRaiseCat) then
      exit;
    // Если у вида доплаты не указан код вид доплаты из модуля зарплата
    _VidOpl := LongInt(Substr(FortRaiseCat.CatData, 1, 5));
    if _VidOpl = 0 then
      exit;
    // Если не найден вид доплаты из модуля зарплата
    if GetFirst KlVidOpl where((_VidOpl == KlVidOpl.VidOpl)) != tsOK then
      exit;
    // Общая часть
    ClearBuffer(#ZarSignal);
    ZarSignal.SubSysCode := 1;
    ZarSignal.SrcTable := 16;
    ZarSignal.FstDate := Cur_Date;
    ZarSignal.FstTime := Cur_Time;
    ZarSignal.LstDate := ZarSignal.FstDate;
    ZarSignal.LstTime := ZarSignal.FstTime;
    ZarSignal.tPerson := LeadPersons.NRec;
    ZarSignal.TabN := LeadPersons.TabNmb;
    ZarSignal.LastUser := LeadPersons.StrTabN;
    ZarSignal.Cex := LeadPersons.GalDep;
    ZarSignal.TabNZpl := LSchetL.TabN;
    ZarSignal.CexZpl := LSchetL.Cex;
    ZarSignal.cLSchetZpl := LschetL.NRec;
    ZarSignal.StrTabN := LSchetL.StrTabN;
    ZarSignal.FilialNo := ZarSignal.FilialNo or 4;
    // Добавляем ссылку на назначение
    ZarSignal.CexZpl := VAppFuncs.GetAppNRec_OnDate(LeadPersons.NRec, Education.FromDate);

    // Часть с данными, записываемыми при утверждении приказа
    if Fortune.FilialNo = 0 // старая схема выплаты в расчет зп
      ZarSignal.MsgCode := 9;
    else
      ZarSignal.MsgCode := 14;
    ZarSignal.SrcRec := Fortune.NRec;
    ZarSignal.Date1 := Education.FromDate;
    ZarSignal.Date2 := Education.ToDate;
    ZarSignal.Word1 := Fortune.wAttr1;    // Raise.RaiseAttr
    ZarSignal.Double1 := Fortune.DocSum;
    ZarSignal.Comp3 := LSchetL.NRec;
    ZarSignal.Comp1 := KlVidOpl.NRec;
    ZarSignal.Comp2 := Fortune.FortCurr;
    ZarSignal.Date10 := Fortune.DocDate;
    ZarSignal.String2 := Fortune.DocNmb;

    if insert current ZarSignal != tsOk then
    begin
      Message('Не удалось добавить запись о доплате наставнику в рабочую корзину', Error);
      exit;
    end;
    result := true;
  end;

  // Проверка корректности данных перед утверждением приказа
  function ChildCheckOneOrder(cNRec: Comp = 0): Boolean;
  begin
    result := true;
    if not inherited::ChildCheckOneOrder(cNRec) then
      result := false;
    if Education.cInf2 = 0 or not IsValid(tnLeadPersons) then
    begin
      SetErrorOrder('Не указан наставник!');
      result := false;
    end;
  end;

  // Утверждение приказа
  function ChildConfirmOneOrder(cNRec: Comp = 0): Boolean;
  begin
    result := false;
    if inherited::ChildConfirmOneOrder(cNRec) then
    begin
      Fortune.cPers := ContDoc.Person;
      Fortune.DocNmb := TitleDoc.DocNmb;
      Fortune.DocDate := TitleDoc.DocDate;
      update current Fortune;
      //InsZarSignal;
      result := true;
    end;
  end;

  tableevent table Fortune;
    cmSetDefault:
      begin
        ClearBuffer(tnFortune);
        Fortune.cFCont := ContDoc.NRec;
        Fortune.DocDate := TitleDoc.DocDate;
        Fortune.DocNmb := TitleDoc.DocNmb;
        Fortune.wAttr1 := 0; // нац.валюта
      end;
    cmInsertRecord:
      begin
        if insert current Fortune = tsOk then
          update current ContDoc;
      end;
    cmUpdateRecord:
      begin
        if update current Fortune = tsOk then
          update current ContDoc;
      end;
  end;

  handleEvent
    cmPick:
      begin
        case CurField of
          #FortRaiseCat.Name:
            begin
              var _cFType: tNRec = Fortune.cFType;
              if RunInterface('PickCatalog2', -17, _cFType, 0, 0) = cmDefault then
                set Fortune.cFType := _cFType;
            end;
          #CurrNameFort:
            case RunMenu('StaffChooseRaiseType') of
              cmValue1: // в нац. валюте
                begin
                  set Fortune.FortCurr := 0;
                  set Fortune.wAttr1 := 0;
                end;
              cmValue2: // в процентах
                begin
                  set Fortune.FortCurr := 0;
                  set Fortune.wAttr1 := 2;
                end;
              cmValue3:  // в иностранной валюте
                begin
                  var _cCurrency: tNRec = Fortune.FortCurr;
                  if RunInterface('StaffGetCurrency', _cCurrency) = cmDefault then
                  begin
                    set Fortune.FortCurr := _cCurrency;
                    set Fortune.wAttr1 := 1;
                  end;
                end;
            end;
          #LeadPersons.FIO:
            begin
              var _cPerson: tNRec = Education.cInf2;
              if PickPerson(_cPerson) then
                set Education.cInf2 := _cPerson;
            end;
        end;
        inherited::HandleEvent(cmPick);
      end;
    cmDelOnProtect:
      case CurField of
        #FortRaiseCat.Name:
          set Fortune.cFType := 0;
        #LeadPersons.FIO:
          set Education.cInf2 := 0;
      else
        inherited::HandleEvent(cmDelOnProtect);
      end;
    cmPrintDoc:
      if UpdateTable then
        RunInterface('GP_NFormRD235', TitleDoc.NRec, ContDoc.Person, ContDoc.NRec, PartDoc.TypeOper);
  end;

end.
