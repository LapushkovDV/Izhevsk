Interface GP_RKStat_stazh 'Стаж' EscClose, Cyan;
Show at (1,1,100,45);


Table Struct gp_stazh
(
   NRec          : comp
  ,strtabn       : string
  ,fio           : string
  ,snils         : string
  ,depnrec       : comp
  ,depart        : string
  ,sex           : string
  ,borndate      : date
  ,appdate       : date
  ,disdate       : date
  ,delcode       : string
  ,yearn         : word
  ,mesn          : word
  ,dayn          : word
  ,years         : word
  ,mess          : word
  ,days          : word
)
with index
(
  ind0=nrec,
  ind1=fio
);

var dRep,dRepfrom:date;
    iRunStaj: Runstaj;
    iCatFunc      : CatalogsFunctions;
    mPodr1        : TPtr;
    iStrFunc   : StringFunctions;
    _sDepartment:string;
    mDept: LongInt;
    _cPodr:comp;


    wyearn
   ,wmesn
   ,wdayn
   ,wyears
   ,wmess
   ,wdays          : word ;
   RowNo    : longint;
   ColNo    : longint;

   BYears          :  integer;
    BMonths         :  integer;
    BDays           :  integer;
    cTypeStaj       :  comp;
    isRunOk         :  boolean;
    isFirst         :  boolean;
    cLschet         :  comp;
    NorthStaj        : comp;

   excelpath, sZamName: string;
  counter, countermatrix: longint;

#include GetKau.var
create view
as select *
from
   gp_stazh,
   ServLen,
   catalogs,
  ServLen  ServLen2(SlByPosition)
;


Procedure CalcStajBetweenDate(PsnNRec: comp; StajNrec: comp; BegDate: date; EndDate: date);
  { // расчет стажа за период
  var allDay     : integer;
  var allDay_Per : integer;
  var numAlg     : word;
  var BegDateW   : date;
  var EndDateW   : date;

  BYears  := 0;
  BMonths := 0;
  allDay  := 0;
  numAlg  := 0;

  if (GetFirst Catalogs where ((StajNrec == Catalogs.NRec)) = tsOk)
    numAlg := Catalogs.bPick;

  if ( StajNrec <> 0 )
    {
    _loop ServLen2
           where ((PsnNRec == ServLen2.Person  and
    (slStaffServLenCur     =  ServLen2.CurRec  or
     slStaffServLenOld     =  ServLen2.CurRec) and
                  StajNrec == ServLen2.Position ))
        {
        if (not iStrFunc.isCrossPeriod(ServLen2.FromDate, ServLen2.ToDate, BegDate, EndDate))
          continue;

       if (ServLen2.Rate < 0.0001)
         ServLen2.Rate := 1.0;

       BegDateW := BegDate;
       if (ServLen2.FromDate > BegDateW)
         BegDateW := ServLen2.FromDate;

       EndDateW := EndDate;
       if (Day(ServLen2.ToDate) <> 0 and ServLen2.ToDate < EndDateW)
         EndDateW := ServLen2.ToDate;

       case numAlg of

          2: // Алгоритм ТК РФ
              {
              if (BegDateW <> ZeroDate)
                {
                allDay_Per := longint(((Year(EndDateW)  - Year(BegDateW))  * 360 +
                                      (Month(EndDateW) - Month(BegDateW)) * 30 +
                                      (Day(EndDateW)   - Day(BegDateW)))  * ServLen2.Rate);

                if (ServLen2.ToDate <> Date(0,0,0))
                   allDay_Per := allDay_Per + 1;

                allDay := allDay + allDay_Per;

                set BYears   := DivI(allDay, 360);
                if (BYears < 0)
                  set BYears   := 0;

                set BMonths  := DivI(allDay mod 360, 30);
                if (BMonths < 0)
                  set BMonths := 0;

                set BDays    := allDay mod 30;
                if (BDays < 0)
                  set BDays := 0;

                if (Day(BegDateW) = 1 and Day(EndDateW) = Last_Day(EndDateW))
                {
                if (BDays >= 28)
                  BMonths++;
                BDays    := 0;
                }
                }
              }

          else //
              {
              if (BegDateW <> ZeroDate)
                {
                allDay_Per := longint(((Year(EndDateW)  - Year(BegDateW))  * 360 +
                                      (Month(EndDateW) - Month(BegDateW)) * 30 +
                                      (Day(EndDateW)   - Day(BegDateW)))  * ServLen2.Rate);

                if (ServLen2.FromDate <= EndDate)
                   allDay_Per := allDay_Per + 1;

                allDay := allDay + allDay_Per;

                set BYears   := DivI(allDay, 360);
                if (BYears < 0)
                  set BYears   := 0;

                set BMonths  := DivI(allDay mod 360, 30);
                if (BMonths < 0)
                  set BMonths := 0;

                set BDays    := allDay mod 30;
                if (BDays < 0)
                  set BDays := 0;
                }
              }
        end; //case
      }
    }
  }

  public function GetStajYearsBetweenDate(PsnNRec: comp; StajNrec: comp; BegDate: date; EndDate: date) : word;
  {
  CalcStajBetweenDate(PsnNRec, StajNrec, BegDate, EndDate);

  result := BYears;
  }

public function GetStajMonthsBetweenDate(PsnNRec: comp; StajNrec: comp; BegDate: date; EndDate: date) : word;
  {
  CalcStajBetweenDate(PsnNRec, StajNrec, BegDate, EndDate);

  result := BMonths;
  }

public function GetStajDaysBetweenDate(PsnNRec: comp; StajNrec: comp; BegDate: date; EndDate: date) : word;
  {
  CalcStajBetweenDate(PsnNRec, StajNrec, BegDate, EndDate);

  result := BDays;
  }

procedure init_stazh(datefrom,dateto : date);
{
  delete all from gp_stazh;

  sql
  Select
   pers.nrec         as  NRec
  ,pers.strtabn      as  strtabn
  ,pers.fio          as  fio
  ,pas.nmb           as  snils
  ,dep.nrec          as  depnrec
  ,dep.KOD          as  depart
  ,pers.sex          as  sex
  ,pers.borndate     as  borndate
  ,ls.datpos      as  appdate
  ,(case when ls.datuv<=:(dateto) then ls.datuv else 0 end)  as  disdate
  ,del.code          as delcode
  from lschet ls
  join persons pers on ls.tperson=pers.nrec
  left join passports pas on pas.person=pers.nrec and 501=pas.syscode
  join appointments app on app.nrec= (case when pers.disdate=0 or pers.disdate>:(dateto) then pers.appointcur else pers.appointlast end)
  left join katpodr dep on dep.nrec=ls.cex
  left join catalogs del on del.nrec = app.CDISREASON
  where (ls.datuv=0 or ls.datuv>=:(datefrom)) and ls.datpos<=:(dateto)
  into gp_stazh;

  _loop gp_stazh
  {
  if (_sDepartment <> '')
      if not FoundMarker(mDept, gp_stazh.depnrec) then delete current gp_stazh;
  }

  //message(recordsintable(tngp_stazh));
}

procedure dop_init_stazh(daterep : date);
{
  _loop gp_stazh
  {

    wyearn:=GetStajYearsBetweenDate(gp_stazh.Nrec, comp(000A0000000399C6h),gp_stazh.appdate, daterep);
    wmesn:=GetStajMonthsBetweenDate(gp_stazh.Nrec, comp(000A0000000399C6h),gp_stazh.appdate,daterep);
    wdayn:=GetStajDaysBetweenDate(gp_stazh.Nrec, comp(000A0000000399C6h),gp_stazh.appdate, daterep);
    wyears:=iRunStaj.NGetStajYears(gp_stazh.Nrec, comp(000A0000000399C6h), daterep);
    wmess:=iRunStaj.NGetStajMonths(gp_stazh.Nrec, comp(000A0000000399C6h), daterep);
    wdays:=iRunStaj.NGetStajDays(gp_stazh.Nrec,  comp(000A0000000399C6h), daterep);
    if (wyearn=wyears and wmesn=wmess and (wdayn-1)=wdays) then wdayn:=wdayn-1;
    gp_stazh.yearn:=wyearn;
    gp_stazh.mesn:= wmesn;
    gp_stazh.dayn:= wdayn;
    gp_stazh.years:=wyears;
    gp_stazh.mess:= wmess;
    gp_stazh.days:= wdays;
    update current gp_stazh;

  }
}


procedure UpdateFiltersState;
{
  var SelCnt: LongInt;
  var cTemp: Comp;
  _sDepartment := '';
  SelCnt := GetMarkerCount(mDept);
  if SelCnt > 0 then
  _sDepartment := 'Выбрано подразделений: ' + String(SelCnt);
  ReReadRecord;
}

Browse brGP_Stazh ('Стаж', , sci1Esc);
  Show at (1,4,98,43);
Table gp_stazh;
Fields
  strtabn   'Табель' ('Табель',, sci14EnIns): [10], Protect;
  fio       'ФИО'    ('ФИО',, sci14EnIns): [10], Protect;
  snils     'Снилс' ('Снилс',, sci14EnIns): [6], Protect;
  depart    'Подразделение' ('Подразделение',, sci14EnIns): [5], Protect;
  sex       'Пол' ('Пол',, sci14EnIns): [3], Protect;
  borndate  'День рождения' ('День рождения',, sci14EnIns): [8], Protect;
  appdate   'Принят' ('Принят',, sci14EnIns): [8], Protect;
  disdate   'Уволен' ('Уволен',, sci14EnIns): [8], Protect;
  yearn     'год' ('год',, sci14EnIns): [3], Protect;
  mesn      'месяц' ('месяц',, sci14EnIns): [3], Protect;
  dayn      'день' ('день',, sci14EnIns): [3], Protect;
  years     'сум год' ('сум год',, sci14EnIns): [3], Protect;
  mess      'сум месяц' ('сум месяц',, sci14EnIns): [3], Protect;
  days      'сум день' ('сум день',, sci14EnIns): [3], Protect;
  delcode   'Причина увольнения' ('Причина увольнения',, sci14EnIns): [15], Protect;
end;

Screen s1(,,sci1Esc);
Show at (1,1,98,3);
  fields
    dRep ('Дата',, sci13Esc): noprotect;
    _sDepartment, protect, pickbutton;
  buttons
    cmOk,,,'Запуск',,;
    cmValue1,,,'Печать',,;
<<
      `Дата формирования `.@@@@@@@@@@@                <. ~С~формировать .>   <. ~П~ечать .>
      `Подразделения     `.@@@@@@@@@@@@@@@@@@@@@@
>>
end;
!-------------------------------------------------------------------------------
HandleEvent

cmInit:
{
  drep:=date(31,12,year(cur_date)-1);
}
cmOk:
{
  drepfrom:=date(01,01,year(drep));
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm,'Отбор данных...' , 0);
  init_stazh(drepfrom,drep);
  dop_init_stazh(drep);
  ReReadRecord;
  StopVisual;
}
cmValue1:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm,'Печать...' , 0);
  if RecordsInTable(tngp_stazh)=0
  {
    drepfrom:=date(01,01,year(drep));
    init_stazh(drepfrom,drep);
    dop_init_stazh(drep);
    ReReadRecord;
  }

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\GP_RKStat_stazh.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  var i : longint = 0;
  RowNo:=4;
  var firstRow  : longint =RowNo;
  RowNo:=0;
  xlCreateMatrix(RecordsInTable(tngp_stazh), 16);
  _Loop gp_stazh ordered by Fio
      {
        ColNo := 0;
        i++;
        xlStWriteToMatrix(++RowNo, ++ColNo, i);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) +gp_stazh.strtabn);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) +gp_stazh.Fio );
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) +gp_stazh.snils);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) +gp_stazh.depart );
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) +gp_stazh.sex);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) +gp_stazh.borndate);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) +gp_stazh.appdate);
        xlStWriteToMatrix(  RowNo, ++ColNo, gp_stazh.yearn);
        xlStWriteToMatrix(  RowNo, ++ColNo, gp_stazh.mesn);
        xlStWriteToMatrix(  RowNo, ++ColNo, gp_stazh.dayn);
        xlStWriteToMatrix(  RowNo, ++ColNo, gp_stazh.years);
        xlStWriteToMatrix(  RowNo, ++ColNo, gp_stazh.mess);
        xlStWriteToMatrix(  RowNo, ++ColNo, gp_stazh.days);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) + gp_stazh.delcode);
        xlStWriteToMatrix(  RowNo, ++ColNo, chr(39) +if (gp_stazh.disdate=0,'',gp_stazh.disdate));


      }
  XLWRITEMATRIXTOEXCEL(firstRow, 1);
  XLFREEMATRIX;

  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, xlContinuous, 0, firstRow, 1, firstRow + RowNo - 1, 16);
  xlAutoFit(1, 1, firstRow + RowNo - 1, 16);
  xlKillExcel;
  StopVisual;
}
cmPick:
{
   case CurField of
    #_sDepartment:
      {
        var _tmpMarkerName : string;
        var stMarker       : longint;
        if (iGetKau.GetCodeKau(cgiMulti, cgKau_KatPodr, _cPodr) <> 0) then
        {
          _tmpMarkerName := iGetKau.GetMarkerName(cgKau_KatPodr);
          mDept       := InitMarker(_tmpMarkerName, 8, 10, 100, true);
          UpdateFiltersState;
        }
      }
  end;
}
cmDelOnProtect:
{
  case CurField of
    #_sDepartment:
    {
      set _sDepartment := '';
      set _cPodr := 0h;
    }
  end;
  ReReadRecord;
}


end;
end.
