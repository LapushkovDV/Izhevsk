#ifdef ComponentVersion
#Component "GP_STAFF"
#end

#ifndef __GP_RKStat_vih__
#define __GP_RKStat_vih__

ObjInterface IGP_RKStat;

  //наименование отчета для отображения в списке
  function GetReportName : String;

  //номер по порядку в списке
  function GetPriority : Integer;

  //загрузка значений параметров
  procedure initRKStatRepParam;
  
  //проверка корректности заданных параметров
  function isCheckRepParam(isStayAlone : boolean) : boolean;

  //возвращает дату на которую формируется отчет
  function dRepOnDateParam : date;

  //вызов окна редактирования параметров
  function bSetRepParam : boolean;  

  //печать страницы отчета
  procedure PrintRepPage(isStayAlone : boolean);

end;
#end