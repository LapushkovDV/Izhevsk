/*************************************************************************************************\
* Наименование:  Печать группового приказа "Назначение персональных надбавок" РД 09               *
*                РПД № 08 Интерфейс приказа "Увольнение"                                          *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание: 776 Ведомость премирования (цеха, УМиОТ )                                           *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#776          |17/01/18|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/
#include GP_DepFunc.vih

#component "Z_STAFFORDERS"
#doc
Печать группового приказа "Назначение персональных надбавок" РД 09
776 Ведомость премирования (цеха, УМиОТ )
#end

//******************************************************************************
Alter Interface NFormRD20a ('');
//******************************************************************************
var oGP_DepFunc: GP_DepFunc;

OverLoad
datastream DTS_NForm20a;
Procedure PrintNForm20aFR;
End;
  //---------------------------
  Var
  //---------------------------
  boPrint_Group_First:boolean; // признак первой записи с ContDoc
  //---------------------------
  KAU_PROJECT:word=0; // КАУ Проект

  //---------------------------
  ATTR_ZAKAZ_P:comp;//ВА Заказ к части приказа
  ATTR_ZAKAZ_C:comp;//ВА Заказ к содержимому приказа
  ATTR_PROJECT_P:comp;//ВА Проект к части приказа
  ATTR_PROJECT_C:comp;//ВА Проект к содержимому приказа

  //---- Для сортировок
Table struct Tmp_PR_SP
(  sortkey   :string[250]
  ,cContDoc  :comp // ссылка на нижный уровень
  ,Person    :comp
  ,AppNrec   :comp// ContDoc.cStr;
  ,FIO       :string[100] //    Persons.FIO;
  ,BornDate  :date //Persons.BornDate;
  ,TabN      :string [100] //    fTabNmb;
  ,Dolgn     :string // if ( boGetTune('UP.STAFF.USE_LONGNAME_ANK'),trim(iCatFunc.GetCatalogsLongName(Appointments.Post)),
                    //trim(iCatFunc.GetCatalogsName(Appointments.Post)));
  ,Podr      :string // ]     IDepartIer.GetLongNameHistOrSamPodr(Appointments.Department,
                     //if (Fortune.Dat1 <> ZeroDate, Fortune.Dat1, Cur_Date));
  ,Razr      :string[20] //     longInt(Appointments.cCat2) + ' разряд';
  ,NameRaise :string //]  iCatFunc.GetCatalogsName(Fortune.cFType);
  ,SummaRaise :double //  if (Fortune.DocSum <> 0,if (Fortune.wAttr1 = 2, string(Fortune.DocSum)
  ,sSummaRaise:string //  if (Fortune.DocSum <> 0,if (Fortune.wAttr1 = 2, string(Fortune.DocSum)
  ,DateRaise :string[20] //  iStrFunc.UnVisibleDate(Fortune.Dat1, '');
  ,FoundRaise:string // iCatFunc.GetCatalogsName(Fortune.cRef1);
  ,Snote     :string // Fortune.sNote;        //Примечание
  ,sBottom   :string //  ContDoc.sBottom;      //Основание

  ,FIO_IO     :string //MyGetInitial(Persons.FIO,True);
  ,Podr_Code  :string //iCatFunc.GetCatalogsCode(Appointments.Department);
  ,Kateg      :string //KlKatego.Kod;
  ,Zakaz      :string //MnPlan_C.NUMBER;
  ,Zakaz_Name :string //MnPlan_C.Name;
  ,VidOpl     :longint //longint(iCatFunc.GetCatalogsCode(Fortune.cFType));
  ,WorkDay    :double //double(ContDoc.cNew1)/100000;
  ,WorkHour   :double //double(ContDoc.cNew2)/100000;
  ,Summa      :double //
  ,Summa_Attr :word // Fortune.wAttr1;
)
with index
( Tmp_PR_SP01 = SortKey
);

Create view MakeReport1View
as select
 //---------------------------
  coGetAttrID(coPartDoc,PartDoc.Nrec,ATTR_ZAKAZ_P   ) (FieldName=pZAKAZ_P   ,FieldTitle='Заказ приказа') //
 ,coGetAttrID(coContDoc,ContDoc.Nrec,ATTR_ZAKAZ_C   ) (FieldName=pZAKAZ_C   ,FieldTitle='Заказ') //
 ,coGetAttrID(coPartDoc,PartDoc.Nrec,ATTR_PROJECT_P ) (FieldName=pPROJECT_P ,FieldTitle='Проект приказа') //
 ,coGetAttrID(coContDoc,ContDoc.Nrec,ATTR_PROJECT_C ) (FieldName=pPROJECT_C ,FieldTitle='Проект') //
 //---------------------------

From KlKatego
 ,MNPLAN, MNPLAN MNPLAN_C
 ,SPKAU , SPKAU SPKAU_C
 ,Tmp_PR_SP
 ,PrMemo
where ((
  Appointments.EmpCategory == KlKatego.Nrec
  and pZAKAZ_P   ==  MNPLAN.Nrec // Заказ приказа
  and pZAKAZ_C   ==  MNPLAN_C.Nrec  // Заказ
  and pPROJECT_P ==  SpKau.Nrec  // Проект приказа
  and pPROJECT_C ==  SpKau_C.Nrec  // Проект
//------------- Шапка раздела  -----------------
  and  PartDoc.Nrec == PrMemo.cDoc
  and             2 == PrMemo.wRef

))
//bounds byTmp_sort Tmp_PR_SP.cContDoc == ContDoc.Nrec
//ordered Order_DEP_Fio by Tmp_PR_SP.sortkey
;

create view vSpr
as select
   katkau.nrec
from
  katkau
where ((
       1        == KATKAU.SYSNUM
  and  0        == KATKAU.ISACTIVE
  and  'Проект' == katkau.name

)) ;

Function GetPeriod(_DT:date) : string;
{ Result:=DateToStr(_DT,'month YYYY');

}

Function GetCexCode:string;
{ Result:=iCatFunc.GetCatalogsCode(Appointments.Department);
  if pos('-',Result)>0
    Result:=SubStr(result,1,pos('-',Result)-1);

}

Function GetDescription:string;
{ Result:=ContDoc.SBottom;

}
//------------------------------------------------------------------------------
// Поток данных для вывода на печать
datastream DTS_NForm20a
// описание потока данных
(
  [Period] GetPeriod(Fortune.Dat1);
  [Cex]    GetCexCode;
  [Vidopl] longint(iCatFunc.GetCatalogsCode(Fortune.cFType));
  [RaiseName] iCatFunc.GetCatalogsName(Fortune.cFType);
  [Project_Code] SPKAU.Code ;//'Код проекта'
  [Project_name] SpKau.NAME ;//'Наименование проекта'
  [DateSostS]    DateToStr(TitleDoc.DocDate, 'month YYYY г.');
  [PrMemo_Exist] IsvalidAll(tnPrMemo);
  [PrMemo_Info]  PRMEMO.INFO;
  [Description]  GetDescription;
  // расширяем существующую
  Table inherited::ContDoc
  ( //----------------------------


    //----------------------------
    [FIO_IO]     MyGetInitial(Persons.FIO,True);
    [Podr_Code]  iCatFunc.GetCatalogsCode(Appointments.Department);
    [Podr_Nastr] oGP_DepFunc.GetFullDepName(Appointments.Department, DF_FROM_ROOT, 1, '/');
    [Kateg]      KlKatego.Kod;
    [Zakaz]      MnPlan_C.NUMBER;
    [Zakaz_Name] MnPlan_C.Name;
    [VidOpl]     longint(iCatFunc.GetCatalogsCode(Fortune.cFType));
    [WorkDay]    double(ContDoc.cNew1)/100000;
    [WorkHour]   double(ContDoc.cNew2)/100000;
    [Summa]      Fortune.DocSum;
    [Summa_Attr] Fortune.wAttr1;

  );
  Table Tmp_Pr_SP
  (
    [ContDocNrec]   Tmp_Pr_SP.cContDoc;
    [PersNrec]      Tmp_Pr_SP.Person;
    [AppointNrec]   Tmp_Pr_SP.FIO;
    [FIO]           Tmp_Pr_SP.FIO;
    [BornDate]      Tmp_Pr_SP.BornDate;

    [TabN]          Tmp_Pr_SP.TabN;
    [Dolgn]         Tmp_Pr_SP.Dolgn;
    [Podr]          Tmp_Pr_SP.Podr;
    [Razr]          Tmp_Pr_SP.Razr;
    [NameRaise]     Tmp_Pr_SP.NameRaise;
    [SummaRaise]    Tmp_Pr_SP.SummaRaise;
    [sSummaRaise]   Tmp_Pr_SP.sSummaRaise;
    [DateRaise]     Tmp_Pr_SP.DateRaise;
    [FoundRaise]    Tmp_Pr_SP.FoundRaise;
    [Snote]         Tmp_Pr_SP.Snote;        //Примечание
    [sBottom]       Tmp_Pr_SP.sBottom;      //Основание

     //--------------------------
    [FIO_IO]     Tmp_Pr_SP.FIO_IO;
    [Podr_Code]  Tmp_Pr_SP.Podr_Code;
    [Kateg]      Tmp_Pr_SP.Kateg;
    [Zakaz]      Tmp_Pr_SP.Zakaz;
    [Zakaz_Name] Tmp_Pr_SP.Zakaz_Name;
    [VidOpl]     Tmp_Pr_SP.VidOpl;
    [WorkDay]    Tmp_Pr_SP.WorkDay;
    [WorkHour]   Tmp_Pr_SP.WorkHour;
    [Summa]      Tmp_Pr_SP.Summa;
    [Summa_Attr] Tmp_Pr_SP.Summa_Attr;

  );
)
/*  Не пашет! Нужен DataSet в оригинале Сделаем свою времянку
handleEvent table ContDoc
cmPreProcess:
{ if getfirst tmp_Pr_sp<>tsok
  { BreakProcess;
  }
}
cmOnProcess:
{ if (boPrint_Group_First)
  { boPrint_Group_First := false;
    ContinueDataset;
  }
  else
  { if getnext tmp_Pr_sp<>tsok
    {  BreakProcess;
    }
    else
    { ContinueDataset;
    }
  }
}
end;
*/
end;//datastream DTS_NForm9a


Procedure PrintNForm20aFR;
{ ATTR_ZAKAZ_P:=ExtAttr_CreateComp(coPartDoc,'Заказ', cgAttrType_Comp, word(0), cgKau_Zakaz );///Производственные заказы
  ATTR_ZAKAZ_C:=ExtAttr_CreateComp(coContDoc,'Заказ', cgAttrType_Comp, word(0), cgKau_Zakaz );///Производственные заказы
  if (vSpr.getfirst katkau<>tsok)
  {  message('Не нашли пользовательскую аналитику "Проект"');
  }
  else
  {
     KAU_PROJECT:=vSpr.katkau.KODGROUP;
     ATTR_PROJECT_P:=ExtAttr_CreateComp(coPartDoc,'Проект', cgAttrType_Comp, word(0), KAU_PROJECT );
     ATTR_PROJECT_C:=ExtAttr_CreateComp(coContDoc,'Проект', cgAttrType_Comp, word(0), KAU_PROJECT );

  }
  boPrint_Group_First:=false;
  PushBounds(#ContDoc);
  delete all Tmp_PR_SP;
  _Loop ContDoc
  { insert into Tmp_PR_SP set
       Tmp_PR_SP.sortkey:=Norm_Fld(iCatFunc.GetCatalogsCode(Appointments.Department),20)
                                         +Persons.FIO
      ,Tmp_PR_SP.cContDoc:=ContDoc.Nrec
      ,Tmp_PR_SP.Person   :=ContDoc.Person
      ,Tmp_PR_SP.AppNrec  := ContDoc.cStr
      ,Tmp_PR_SP.FIO      :=    Persons.FIO
      ,Tmp_PR_SP.BornDate :=Persons.BornDate
      ,Tmp_PR_SP.TabN     :=fTabNmb
      ,Tmp_PR_SP.Dolgn    :=if ( boGetTune('UP.STAFF.USE_LONGNAME_ANK'),trim(iCatFunc.GetCatalogsLongName(Appointments.Post)),
                            trim(iCatFunc.GetCatalogsName(Appointments.Post)))
      ,Tmp_PR_SP.Podr     := IDepartIer.GetLongNameHistOrSamPodr(Appointments.Department,
                           if (Fortune.Dat1 <> ZeroDate, Fortune.Dat1, Cur_Date))
      ,Tmp_PR_SP.Razr      :=  longInt(Appointments.cCat2) + ' разряд'
      ,Tmp_PR_SP.NameRaise :=  iCatFunc.GetCatalogsName(Fortune.cFType)
      ,Tmp_PR_SP.SummaRaise:=  if (Fortune.wAttr1 = 2, 0, Fortune.DocSum)
      ,Tmp_PR_SP.sSummaRaise:=  if (Fortune.DocSum <> 0,if (Fortune.wAttr1 = 2, string(Fortune.DocSum)
                                                                  + '%'
                                                                  , string(Fortune.DocSum)
                                                                    + ' '
                                                                    + if(IsValid(tnKlVal), KlVal.SimvolV, '')), '')
      ,Tmp_PR_SP.Summa :=Fortune.DocSum
      ,Tmp_PR_SP.DateRaise := iStrFunc.UnVisibleDate(Fortune.Dat1, '')
      ,Tmp_PR_SP.FoundRaise:= iCatFunc.GetCatalogsName(Fortune.cRef1)
      ,Tmp_PR_SP.Snote     := Fortune.sNote        //Примечание
      ,Tmp_PR_SP.sBottom   := ContDoc.sBottom      //Основание

      ,Tmp_PR_SP.FIO_IO     :=MyGetInitial(Persons.FIO,True)
      ,Tmp_PR_SP.Podr_Code  :=iCatFunc.GetCatalogsCode(Appointments.Department)
      ,Tmp_PR_SP.Kateg      :=KlKatego.Kod
      ,Tmp_PR_SP.Zakaz      :=MnPlan_C.NUMBER
      ,Tmp_PR_SP.Zakaz_Name :=MnPlan_C.Name
      ,Tmp_PR_SP.VidOpl     :=longint(iCatFunc.GetCatalogsCode(Fortune.cFType))
      ,Tmp_PR_SP.WorkDay    :=double(ContDoc.cNew1)/100000
      ,Tmp_PR_SP.WorkHour   :=double(ContDoc.cNew2)/100000
      ,Tmp_PR_SP.Summa      :=Fortune.DocSum //
      ,Tmp_PR_SP.Summa_Attr :=Fortune.wAttr1
       ;
  } //_Loop ContDoc

  //PushBounds(tbByTmp_Sort);
  //SetOrder(tiOrder_DEP_Fio)
  inherited :: PrintNForm20aFR;
}

END.
