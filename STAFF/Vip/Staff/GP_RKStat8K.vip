    set dRep := iUDR.ReadDate('RKS8_dRep');
    if dRep = 0
      set dRep := To_Date(31, 12, Year(Cur_Date));

    set wPrintRash   := iUDR.ReadWord  ('RKS8_wPrintRash');
    set sToExistFile := iUDR.ReadString('RKS8_sToExistFile');
    set wToExistFile := iUDR.ReadWord  ('RKS8_wToExistFile');
    if wToExistFile = 1 
      ToggleFieldVisible(#sToExistFile,true )
    else
      ToggleFieldVisible(#sToExistFile,false);

    mPodr1 := iUDR.ReadMarker('RKS8_mPodr1'); set sPodr1 := sSetPodrName(mPodr1);
    //potapov e

/* potapov
    
    if (not (ReadMyDsk(dRep, 'RKS8_dRep', false)))
      set dRep := To_Date(31, 12, Year(Cur_Date));
    if (not (ReadMyDsk(wToExistFile, 'RKS8_wToExistFile', false)))
      set wToExistFile := 0;
    if (wToExistFile = 1)
      ToggleFieldVisible(#sToExistFile, true)
    else
      ToggleFieldVisible(#sToExistFile, false);
    if (not (ReadMyDsk(sToExistFile, 'RKS8_sToExistFile', false)))
      set sToExistFile := '';
    if (not (ReadMyDsk(wPrintRash, 'RKS8_wPrintRash', false)))
      set wPrintRash := 1;
    mPodr1 := initMarker('RKS8_mPodr1_' + UserName(), 8, 1000, 100);
    set sPodr1 := sSetPodrName(mPodr1);
*/
  }

  function isCheckRepParam(isStayAlone: boolean): boolean;
  {
    result := false;
    if (dRep = 0)
    {
      if (isStayAlone)
        Message('Не задана дата!');
      exit;
    }
    if (not (Day(dRep) = 31 and Month(dRep) = 12))
    {
      if (isStayAlone)
        if (Message('Некорректно задана дата!'#13 +
         'Отчет ежегодный.'#13 +
         'Дата формирования отчета - последний день года.'#13 + 
         'Продолжить?', YesNo) != Yes)
        {
           exit;
        }
    }
    if (wToExistFile = 1)
      if (not ExistFile(sToExistFile))
      {
        if (isStayAlone)
          oGP_Log.Error('Не удалось открыть файл ' + sToExistFile);
        exit;
      }
    result := true;
  }
  
  window Win8KParamEx 'Параметры формирования. Лист 8-К.' Gray;
    show at (,, 80, 6);

    screen sEx(,,sci1Esc);
      fields
        dRep ('Дата формирования'): {font = {backColor = if(dRep = 0, colorNeed, 0)}}, noProtect;
        sPodr1 ('Выбранные подразделения', hcStaffAppDepartment, sci13Esc):
         {font = {backColor = if(sPodr1 = 'Не выбраны подразделения', colorNeed, 0)}}, protect, pickButton;
      buttons
        cmOk, default,, 'Запуск';
        cmCancel,,, 'Выход';
      << 'Параметры отчета'

 `Дата формирования       `.@@@@@@@@@@@
 `Подразделения для отчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <. ~С~охранить .>                                              <. ~З~акрыть .>
      >>
    end;

    handleEvent
      cmOK:
      {
        Save8K;
        init8K;
        if (not isCheckRepParam(true))
          exit;
        CloseWindowEx(CurWindow,cmDefault);
      }
      cmCancel:
      {
        Save8K;
        CloseWindowEx(CurWindow,cmCancel);
      }
    end;

  end;
  
  window Win8KParam 'Параметры формирования. Лист 8-К.' Gray;
    show at (,, 80, 10);

    Screen s1(,, sci1Esc);
      fields
        dRep ('Дата формирования'): {font = {backColor = if(dRep = 0, colorNeed, 0)}}, noProtect;
        sPodr1 ('Выбранные подразделения', hcStaffAppDepartment, sci13Esc):
         {font = {backColor = if(sPodr1 = 'Не выбраны подразделения', colorNeed, 0)}}, protect, pickButton;
        wPrintRash ('Печать расшифровки'), noProtect;
        wToExistFile('Добавить в существующий файл'), noProtect;
        sToExistFile('Добавить в существующий файл',, scStaffKatPodrRefsPick):
         {font = {backColor = if(sToExistFile = '', colorNeed, 0)}}, protect;
      buttons
        cmOk, default,, 'Запуск';
        cmCancel,,, 'Выход';
    << 'Параметры отчета'

 `Дата формирования       `.@@@@@@@@@@@
 `Подразделения для отчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   [.] Печать расшифровки`

   [.] Добавить в существующий файл`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <. ~С~формировать .>                                           <. ~З~акрыть .>
    >>
    end;

    HandleEvent
      cmOK:
      {
        if (not isCheckRepParam(true))
          exit;
        CloseWindowEx(CurWindow, cmDefault);
      }
    end;
  end;

  function OpenNewRKS: boolean;
  {
    result := false;
    sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
    if xlCreateExcelWithTemplate(sToExistFile, true)
      result := true;
  }

  function OpenExistRKS: boolean;
  {
    result := false;
    if (xlOpenExcel(true))
    {
      // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
      if (xlGetActiveWorkBookName('Книга1'))
        xlCloseWorkBookByName('Книга1');
      if (xlOpenWorkBook(sToExistFile))
        result := true;
    }
  }

  function SetParam8K: boolean;
  {
    result := false;
    if (RunWindowModal(Win8KParam) = cmDefault)
      result := true;
  }

  // Возвращает код СЕ ШР + Наименование СЕ ШР
  function GetDepDef(_cDep: tNRec): String;
  {
    if (getFirst Catalogs where((_cDep == Catalogs.NRec)) = tsOk)
      result := Trim(Catalogs.Code + ' ' + Catalogs.Name);
    else
      result := '';
  }

  // Возвращает должность в формате: Наименование должности + код СЕ ШР + Наименование СЕ ШР
  function GetPostDef(_cDep: tNRec; _cPost: tNRec; _FromDate: Date): String;
  {
    if (_FromDate != ZeroDate)
      result := 'с ' + DateToStr(_FromDate, 'DD.MM.YYYY');
    else
      result := '';
    result += if(result != '', ' ', '') + iCatFunc.GetCatalogsName(_cPost);
    result += if(result != '', ' ', '') + GetDepDef(_cDep);
  }

  // Возвращает строку с описанием должности на начало отчетного периода или список должностей перемещений
  function GetAppStr(_AppRecType: byte): string;
  {
    result := '';
    _loop SApp where((Persons.NRec == SApp.cPerson and _AppRecType == SApp.AppRecType))
    {
      result += if(result != '', '; ', '') + GetPostDef(AppointmentsR.Department, AppointmentsR.Post,
       AppointmentsR.AppointDate);
    }
  }

  // Возвращает строку с описанием образования
  function GetEducStr: string;
  {
    result := '';
    _loop SEducation where((Persons.NRec == SEducation.cPerson))
    {
      // Дата окончания обучения + Наименование учебного заведения + Вид образования + Тема обучения
      result += if(result != '', '; ', '') + DateToStr(EducationR.ToDate, 'DD.MM.YYYY') + ', ' + SEducation.Institution + ', ' 
       + iCatFunc.GetCatalogsName(EducationR.Level) + ', ' + SEducation.Subject;
    }
  }

  // Печать расшифровки
  procedure PrintRash;
  {
    var NPP: longint;
    var R, C: longint;
    var FirstHeadRow, LastHeadRow: longint;
    var FirstBodyRow, LastBodyRow: longint;
    var FirstRow: longint;
    var FirstCol, LastCol: longint;

    FirstRow := 1;
    FirstCol := 1;

    StartNewVisual(vtNumericVisual, vfTimer + vfBreak + vfConfirm, 'Печать расшифровки.', 0);
    NPP := 0;
    R := FirstRow;
    xlSetCellStringValue('Расшифровка листа 8-К. Данные на ' + DateToStr(dRep,'DD.MM.YYYY') + '.', R, 1, R, 1);
    // Шапка отчета
    R++;
    FirstHeadRow := R;
    LastHeadRow := FirstHeadRow;
    FirstBodyRow := LastHeadRow + 1;
    LastBodyRow := FirstBodyRow + RecordsInTable(#SData) - 1;
    C := FirstCol - 1;

    // № п/п
    xlSetCellStringValue('№ п/п', R, ++C, R, C);
    xlSetColumnWidth(6, R, C, R, C);
    // Тип данных
    xlSetCellStringValue('Тип данных', R, ++C, R, C);
    xlSetColumnWidth(15, R, C, R, C);
    // Табельный номер
    xlSetCellStringValue('Табельный номер', R, ++C, R, C);
    xlSetColumnWidth(10, R, C, R, C);
    xlSetNumberFormat('@', FirstBodyRow, C, LastBodyRow, C);
    xlAlignCellsEx(xlCenter, xlBottom, FirstBodyRow, C, LastBodyRow, C);
    // ФИО
    xlSetCellStringValue('ФИО', R, ++C, R, C);
    xlSetColumnWidth(35, R, C, R, C);
    // Дата приема на работу
    xlSetCellStringValue('Дата приема на работу', R, ++C, R, C);
    xlSetColumnWidth(10, R, C, R, C);
    xlAlignCellsEx(xlCenter, xlBottom, FirstBodyRow, C, LastBodyRow, C);
    // Дата увольнения
    xlSetCellStringValue('Дата уволь-нения', R, ++C, R, C);
    xlSetColumnWidth(10, R, C, R, C);
    xlAlignCellsEx(xlCenter, xlBottom, FirstBodyRow, C, LastBodyRow, C);
    // Дата рождения
    xlSetCellStringValue('Дата рож-дения', R, ++C, R, C);
    xlSetColumnWidth(10, R, C, R, C);
    xlAlignCellsEx(xlCenter, xlBottom, FirstBodyRow, C, LastBodyRow, C);
    // Возраст, лет
    xlSetCellStringValue('Возраст, лет', R, ++C, R, C);
    xlSetColumnWidth(8, R, C, R, C);
    // Возраст, полных лет и месяцев
    xlSetCellStringValue('Возраст, полных лет и месяцев на ' + DateToStr(dRep, 'DD.MM.YYYY'), R, ++C, R, C);
    xlSetColumnWidth(15, R, C, R, C);
    xlAlignCellsEx(xlCenter, xlBottom, FirstBodyRow, C, LastBodyRow, C);
    // Организация
    xlSetCellStringValue('Организация', R, ++C, R, C);
    xlSetColumnWidth(50, R, C, R, C);
    // Целевая должность
    xlSetCellStringValue('Целевая должность', R, ++C, R, C);
    xlSetColumnWidth(60, R, C, R, C);
    // Уровень КР
    xlSetCellStringValue('Уровень КР', R, ++C, R, C);
    xlSetColumnWidth(9, R, C, R, C);
    xlAlignCellsEx(xlCenter, xlBottom, FirstBodyRow, C, LastBodyRow, C);
    // Дата зачисления в кадровый резерв
    xlSetCellStringValue('Дата зачисления в кадровый резерв', R, ++C, R, C);
    xlSetColumnWidth(10, R, C, R, C);
    xlAlignCellsEx(xlCenter, xlBottom, FirstBodyRow, C, LastBodyRow, C);
    // Дата выбытия из кадрового резерва
    xlSetCellStringValue('Дата выбытия из кадрового резерва', R, ++C, R, C);
    xlSetColumnWidth(10, R, C, R, C);
    xlAlignCellsEx(xlCenter, xlBottom, FirstBodyRow, C, LastBodyRow, C);
    // Время пребывания в кадровом резерве
    xlSetCellStringValue('Время пребывания в кадровом резерве на ' + DateToStr(dRep, 'DD.MM.YYYY'), R, ++C, R, C);
    xlSetColumnWidth(15, R, C, R, C);
    xlAlignCellsEx(xlCenter, xlBottom, FirstBodyRow, C, LastBodyRow, C);
    // Основание зачисления (выбытия) из кадрового 
    xlSetCellStringValue('Основание зачисления (выбытия) из кадрового ', R, ++C, R, C);
    xlSetColumnWidth(22, R, C, R, C);
    // Должность на начало отчетного года
    xlSetCellStringValue('Должность на начало отчетного года', R, ++C, R, C);
    xlSetColumnWidth(60, R, C, R, C);
    // Было перемещение
    xlSetCellStringValue('Было перемещение', R, ++C, R, C);
    xlSetColumnWidth(60, R, C, R, C);
    // Обучение кадрового резерва
    xlSetCellStringValue('Обучение кадрового резерва', R, ++C, R, C);
    xlSetColumnWidth(60, R, C, R, C);
    LastCol := C;

    xlWrapText(FirstHeadRow, FirstCol, LastBodyRow, LastCol);
    xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, FirstCol, LastHeadRow, LastCol);
    // xlAutoFit(FirstBodyRow, FirstCol, LastBodyRow, LastCol);
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0,
     FirstHeadRow, FirstCol, LastBodyRow, LastCol);
    // Тело отчета
    _loop SData
    {
      if (not NextVisual)
        break;
      R++;
      C := FirstCol - 1;
      // № п/п
      xlSetCellStringValue(++NPP, R, ++C, R, C);
      // Тип данных
      // для записей кадрового резерва выводится текст "Резерв"
      // Для расшифровки строки 5, выводить текст "Критические должности"
      xlSetCellStringValue(if(SData.DataType = DATA_TYPE_CRITICAL, 'Критические должности', 'Резерв'), R, ++C, R, C);
      // Табельный номер
      xlSetCellStringValue(GetStrTabN(Persons.TabNmb, Persons.StrTabN), R, ++C, R, C);
      // ФИО
      xlSetCellStringValue(Persons.FIO, R, ++C, R, C);
      // Дата приема на работу
      xlSetCellDateValue(Persons.AppDate, R, ++C, R, C);
      // Дата увольнения
      xlSetCellDateValue(Persons.DisDate, R, ++C, R, C);
      // Дата рождения
      xlSetCellDateValue(Persons.BornDate, R, ++C, R, C);
      // Возраст, лет
      xlSetCellStringValue(SData.AgeM div 12, R, ++C, R, C);
      // Возраст, полных лет и месяцев
      xlSetCellStringValue(if (FuturePost.iPrizn = RES_OWN_ORG, AgeMToStr(SData.AgeM), ''), R, ++C, R, C);
      // Организация
      xlSetCellStringValue(GetDepDef(cPlanDep), R, ++C, R, C);
      // Целевая должность
      xlSetCellStringValue(GetPostDef(cPlanDep, cPlanPost, ZeroDate), R, ++C, R, C);
      // Уровень КР
      xlSetCellStringValue(SData.CRLevel, R, ++C, R, C);
      // Дата зачисления в кадровый резерв
      xlSetCellDateValue(SData.Dat1, R, ++C, R, C);
      // Дата выбытия из кадрового резерва
      xlSetCellDateValue(SData.Dat2, R, ++C, R, C);
      // Время пребывания в кадровом резерве
      xlSetCellStringValue(AgeMToStr(SData.TimeInKRM), R, ++C, R, C);
      // Основание зачисления (выбытия) из кадрового 
      xlSetCellStringValue(ReasonCat.Name, R, ++C, R, C);
      // Должность на начало отчетного года
      xlSetCellStringValue(GetAppStr(APP_START), R, ++C, R, C);
      // Было перемещение
      xlSetCellStringValue(GetAppStr(APP_MOVE), R, ++C, R, C);
      // Обучение кадрового резерва
      xlSetCellStringValue(GetEducStr, R, ++C, R, C);
    }
    StopVisual;
  }

  procedure PrintRepPage(isStayAlone: boolean);
  {
    var isOkFile: boolean = false;
    var isDoRep: boolean = false;

    oGP_Log.Init('#(GPInt).log', true, true, true);
    init8K;

    if (isStayAlone)
      if (SetParam8K)
        isDoRep := true;
    if (not isStayAlone)
      isDoRep := isCheckRepParam(true);

    if (isDoRep)
    {
      Make8K;
      if (isData8K)
      {
        if (isStayAlone)
        {
          if (wToExistFile = 0)
            isOkFile := OpenNewRKS;
          if (wToExistFile = 1)
            isOkFile := OpenExistRKS;
        }
        else
          isOkFile := true;

        if (isOkFile)
        {
          Print8K;
          if ((wPrintRash = 1) and isStayAlone)
          {
            var i, j: integer = 0;
            var s: string = '';
            xlGetSheetsCount(j);
            while (i <= j)
            {
              xlSetActiveSheet(++i);
              xlGetSheetName(i,s);
              if (s = '8-к')
                break;
            }
            xlSetActiveSheet(++i);
            xlAddSheet;
            xlSetSheetName(i, 'Расшифровка 8-к');
            xlSetActiveSheet(i);
            PrintRash;
          }
          xlSetActiveSheetByName('8-к');
          if (wToExistFile = 0)
          {
            sToExistFile := '';
          }
          if (isStayAlone)
            xlKillExcel;
        }
        else
          if (isStayAlone)
            Message('Проверьте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');
      }
      else
        if (isStayAlone)
          Message('Нет данных для отчета.');
    }
    Save8K;
    oGP_Log.Done(true);
    closeinterface(cmDefault);
  }

  //--------------------------------------------------------

  function bSetRepParam: boolean;
  {
    result := false;
    if RunWindowModal(Win8KParamEx)=cmDefault
      result := true;
  }

  function GetReportName: string;
  {
    GetReportName := '#(GPNam) (ЭМ)';
  }

  function GetPriority: integer;
  {
    GetPriority := 6;
  }

  procedure initRKStatRepParam;
  {
    init8K;
  }

  function dRepOnDateParam: date;
  {
    dRepOnDateParam := dRep;
  }

  //--------------------------------------------------------

  handleevent
    cmInit:
      PrintRepPage(true);
    cmPick:
      case CurField of
        #sPodr1:
          if (RunInterface('PickCatalogEx', -11, 0, 100, mPodr1) = cmDefault)
            set sPodr1 := sSetPodrName(mPodr1);
        #sToExistFile:
          set sToExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      end;
    cmDelOnprotect:
      case CurField of
        #sPodr1:
        {
          ClearMarker(mPodr1);
          set sPodr1 := sSetPodrName(mPodr1);
        }
        #sToExistFile:
          set sToExistFile := '';
      end;
    cmCheckField:
      case CurField of
        #wToExistFile:
        {
          if wToExistFile = 1
            ToggleFieldVisible(#sToExistFile, true)
          else
            ToggleFieldVisible(#sToExistFile, false);
        }
      end;
  end;

end.
//---------------------------------------------------------------------------------

#include UserReport.vih

vipInterface UserReport_#(GPInt)R Implements IUserReport;

interface UserReport_#(GPInt)R;

  procedure Run;
  {
    RunInterface(#(GPInt));
  }

  function GetReportName: string;
  {
    result := '#(GPNam) (ЭМ)';
  }

  Function GetGroupName (Level: word): string;
  {
    result := '';
    case Level of
      1: result := 'Формы "Роскосмоса"';
    end;
  }

  function GetPriority: integer;
  {
    GetPriority := 3;
  }

  function VisibleInModule(Ind: byte): string;
  {
    result := '';
    case Ind of
      1: result := 'STAFFMAINMENU';
    end;
  }

end.
