VipInterface Dissmissfor_ZGD Licensed(free);

Interface Dissmissfor_ZGD 'Отчет уволенные для ЗГД' EscClose ;
  Show at (,,43,5);



table struct DataAppPer
  (

     LSper          : comp      "Nrec LS"
   , pp             :integer "п/п"
   , AppNrecPer    : comp      "Nrec сотрудника APP"
   ,  PerNrec      : comp     "Nrec сотрудника"
   , KolPerNrec   : comp     "Количество повторяющихся значений"
   , Kodper       : String   "Код подразделения"
   , NamePodr     : String   "Наименование подразделения"
   , PerFio       : String   "ФИО"
   , PostFio      : String   "Должность"
   , AppPerData   : date     "Прием или перевод"
   , TaxPer       : String   "Зп сотрудника"
   , KatPer       : String   "Категория должности"
   , DissDataper  : String   "Дата увольнения"
   , DiscriptDiss : String   "Причина увольнения"
   , TrueDiscPer  : String   "Истинная причина увольнения"
   , StajInJob    : String   "Стаж работы в данной должности"
   , AgePer       : Integer  "Возраст"
   , EduPer       : String   "Вид образования"
   , EduPer1      : String   "Специальность"
   , EduonPPer    : String   "Отметка о целевом обучении"
   , KolNar       : String   "Кол-во нарушений"
   , VidNar       : String   "Нарушения"
    , SumTime     : double
   ,PlanDays      : double   "План дни (по табелю)"
   ,FactDays      : double   "Факт дни (по табелю)"
   ,DissDay       : double   "Дни отсутствия (по табелю)"
   ,PercAbsence   : double   "% отсутствия',#FrmHd"
   ,PercWorkTime  : double   "% переработанного времени"
   ,PercLoad      : double   "% загруженности"
   ,LSzayava      : double   "Личное заявление (дни)"
   ,PoruchLead    : double   "Поручение руководителя (дни)"
   ,SverhNorm     : double   "Отработано сверх нормы"

  )
  with index
(
 ind1 = pp
)  ;
   table struct tmp_NrecPer
  (
    PerNrec       : comp     "Nrec сотрудника"
  )
    with index
(
 ind21 = PerNrec
)  ;
  table struct PerData
  (
    PerNrec       : comp     "Nrec сотрудника"

   , Kolvo        : integer  "количество повторений"
   , possiblePersPrem : word  "Плак (незнаю что)"
   ,SumTime        :double
  );

var
  VCommonFiltr  : CommonFiltr; // Для встраивания фильтра по подразделениям / сотрудникам
  MadeReport    : boolean;
  mPsn          : TPtr;
  iCatFunc      : CatalogsFunctions;
   Ntab, pp : integer;
   DateStart, DateEnd : date;

  iOut          : GP_XlOutExt;
  sFullName,
  sFileName     : string;
  lRB, lRE,
  lCB, lCE,
  lDB, lDE,
  iNPP          : integer;
  __year,_year1,__yearN   : integer;
  _mes          : byte;

    create view PerNrecTbl

    as select
    PerForV.nrec


    from
    PerData,
    DataAppPer,
    DataAppPer DataAppPer1,
    persons ,
    persons PerForV,
    persons PerMarker,
    appointments,
//    appointments a,
    appointments appKol ,
    appointments AppNum ,
    appointments  AppEduCel,
    catalogs   CatEduCel,
    catalogs catAppDEP ,
    catalogs catDiss,
    catalogs catAppPost ,
    APPHIST,
    APPHIST appH,
    APPHIST AppNumH,
    EDUCATION,
    EDUCATION EduMarker,
    EDUCATION EduMarker1,
    catalogs,
    catalogs CatMarker,
    catalogs CatMarker1,
    catalogs CatPunish,
//    catalogs CatEdu,
//    catalogs CatEduSpec,
     Lschet Lschet__yearPrem ,
     Lschet Lschet__yearPrem1 ,
    KlKatego,
    PUNISHMENTS,
    tmp_NrecPer
    where((
    DateStart <<= PerForV.DISDATE and
    DateEnd >>= PerForV.DISDATE

    ));

 Procedure myLog(_STR : string);
{
  if UpCase(username) = upcase('david.davtyan')
   {
     LogStrtofile('_DissMissfoZGD.log',DateToStr(cur_date,'YYYY-MM-DD')+'_'+timetostr(Cur_time,'HH:MM:SS')+': '+_STR);
   }
}
 Procedure MysqlAddStr(var query_handle: longInt; add_query_str: string);
{
  sqlAddStr(query_handle, add_query_str);
  MyLog('sql: ' + add_query_str);
}
