 procedure Run;

{

  var kol, i    : integer = 0;
  var   cPersNRec : comp;
  var   cAddrNeed : comp;
  var   sAny      : string;
  var   iRow      : integer = 0;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);
  /*
  if (VCommonFiltr.GetPsnCount = 0)
    VCommonFiltr.SelectAllPsn;

  mPsn := InitMarker('Dissmissfor_ZGD'+UserName(),8,200,100);
  mPsn := VCommonFiltr.GetPersonsMarker;
  kol  := GetMarkerCount(mPsn);
  */

  var num : integer;

  _loop tmp_NrecPer //where ((DateStaиrt <<= tmp_NrecPer.DisDate  and DateEnd >>= tmp_NrecPer.DisDate))
  {

    set PerData.PerNrec :=  tmp_NrecPer.PerNrec;

    Num := 0;
    var work: comp;
        work := 0;
        var taxa : string = '';

    _loop AppNum where ((tmp_NrecPer.PerNrec == AppNum.person (noindex) and 0 == AppNum.LPRIZN (noindex))) ordered AppNum.ORDERDATE
    {
      var eggg  : comp;
      eggg := AppNum.WORKREGIME;

      _loop AppNumH where((AppNum.nrec == AppNumH.CAPPOINT(noindex) and 5 == AppNumH.CODOPER )) ordered AppNumH.drec
      {
         Num++;
      }
    }

    PerData.Kolvo := Num;
    insert current PerData;
    If (not NextVisual) break;
  }

    if IsValid(#PerData)


 pp:=0;
  _loop PerData     ////
  {
    var KolPer, Staj : integer;  //количество одинаковых людей (для объединения), а стаж для стажа                           000000001004FBFCh
    var chekNrec:comp;
    var Post: string;
    var I_month, I_month1, I_monthN   : integer;
        KolPer                  := 0;
        Staj                    := 0;
        Post                    := '';
        __year                   := 0;
        __yearN                  := 0;
        _year1                  := 0;
        I_month                  := 0;
        I_monthN                 := 0;
        I_month1                 := 0;
        Ntab                    := PerData.Kolvo;
        DataAppPer.VidNar       := '';
        DataAppPer.DiscriptDiss := '';
        var work: comp;
        work := 0;
        var taxa : string = '';

    _loop appKol where ((PerData.PerNrec == appKol.person (noindex) and 0 == appKol.LPRIZN (noindex))) ordered appKol.APPOINTDATE
    {
     var  PUNISH       : integer;
     var _Plan         : double  = 0;
     var _Fact         : double  = 0;
     var DaysFact1Sum  : double  = 0;
     var DaysPlanSum   : double  = 0;
     var DaysOverSum   : double  = 0;
     var DaysOverSumN  : double  = 0;
     var DaysFact1SumN : double  = 0;
     var DaysPlanSumN  : double  = 0;
     var DaysPlan      : double = 0;
     var DaysFact      : double = 0;
     var DaysOver      : double = 0;
     var DaysOverN     : double = 0;
     var DaysPlanN     : double = 0;
     var DaysFactN     : double = 0;
     var DaysWorking   : double = 0;
     //_mes := 12;
     PUNISH            := 0;
     var eggg  : comp;
      eggg :=appKol.WORKREGIME;

        _loop AppH where((appKol.nrec == AppH.CAPPOINT(noindex) and 5 == AppH.CODOPER)) ordered appH.drec
        {
          clearbuffer(tnDataAppPer);
          pp++;
          DataAppPer.pp := pp;

                set DataAppPer.AppNrecPer := appKol.nrec;

                DataAppPer.DissDataper := '';



                if (not NextVisual) break;

          /************************************************************************************************************/



               if getfirst EduMarker where ((PerData.PerNrec == EduMarker.person ))  = tsOK
                {
                  if getfirst CatMarker where ((EduMarker.level == CatMarker.nrec ))  = tsOK
                  {
                   set DataAppPer.EduPer := CatMarker.name
                  }
                }
                if getfirst EduMarker1 where ((PerData.PerNrec == EduMarker1.person))  = tsOK
                {

                  if getfirst CatMarker1 where (( EduMarker1.SPECIALITY == CatMarker1.nrec))  = tsOK
                  {
                     set DataAppPer.EduPer1 := CatMarker1.name
                  }
                }


              if getfirst PerMarker where (( PerData.PerNrec == PerMarker.nrec )) = tsOk
              {

               set DataAppPer.PerFio := PerMarker.Fio;
               set DataAppPer.PerNrec := PerData.PerNrec;
               set DataAppPer.AgePer := year(cur_date) -  year(PerMarker.BORNDATE);
              }



              var n: integer;
              n:=0;
              if (PUNISH < 1) {
                _loop PUNISHMENTS where ((PerData.PerNrec == PUNISHMENTS.CPSN))
                {
                  n++;

                  if getfirst CatPunish where ((PUNISHMENTS.CPTYPE == CatPunish.nrec)) = tsOK
                  {
                   set DataAppPer.VidNar := CatPunish.name + ', ' + DataAppPer.VidNar
                  }
                }
              }
              PUNISH++;
              set DataAppPer.KolNar := n;

              if getfirst AppEduCel where ((PerData.PerNrec == AppEduCel.person (noindex) and 100 == AppEduCel.LPRIZN (noindex))) = tsOk
              {
                  if getfirst CatEduCel where ((AppEduCel.KINDAPP == CatEduCel.nrec and comp(000A000000039A38h) == CatEduCel.mainlink (noindex))) = tsOK
                  {
                    DataAppPer.EduonPPer:= CatEduCel.name ;
                  }
              }

              if getfirst catAppDEP where ((appKol.DEPARTMENT == catAppDEP.nrec)) = tsOk
              {
                set DataAppPer.Kodper := catAppDEP.code   ;
                set DataAppPer.NamePodr := catAppDEP.name;
              }

              set  DataAppPer.TaxPer := AppH.TAXRATE ;



              if getfirst KLkatego where((appKol.EmpCategory == KlKatego.NRec)) = tsOk
              {
                set DataAppPer.KatPer := KlKatego.NaiKat;
              }

               set DataAppPer.KolPerNrec := KolPer;

               set DataAppPer.AppPerData := appH.DREC ;

              if getfirst catAppPost where ((appKol.Post == catAppPost.nrec)) = tsOk
              {
                set DataAppPer.PostFio := catAppPost.name;                                //    000000000000000Eh
              }


              if (Post = '')
              {
                Post := DataAppPer.PostFio ;
                Staj := year(appH.DREC);
                DataAppPer.StajInJob := '';
              }
              else if  (Post <> DataAppPer.PostFio)
              {

                DataAppPer.StajInJob :=  year(appH.DREC) - Staj;
                staj:= year(appH.DREC);
              }
              else
              {
                 DataAppPer.StajInJob := '';
              }


              KolPer++;
              if (KolPer = PerData.Kolvo) {
                 if getfirst catDiss where((appKol.CDISREASON == catDiss.nrec)) = tsOk   //  000A00000003B824h CDISREASON   причина увольнения  // 000A00000003B64Eh CDISDASIS  основание увольнения         000000000000F3DFh
                {
                 // message(string(appKol.nrec,0,0) + '  OK');
                                                       //   000A00000003B824h         00000000047ACA49h        000000001004EF42h
                  set DataAppPer.DiscriptDiss := catDiss.name;
                }
                if (appKol.DORDERDISDATE <> 0)
                {
                set DataAppPer.DissDataper := datetostr(appKol.DORDERDISDATE, 'DD/MM/YYYY');
                }
                else DataAppPer.DissDataper := '';
              }

/********************************************ТАБЕЛЯ!!!*******************************************************/



   var _npp : longint = 0;
   var CS: IContextSession; // для захвата прикладного контекста табеля
    // В код обработчика инициализации интерфейса добавлены строки:
   var CL: ContextList;
   var _allTime : double = 0;
    if (not CL.Add(CS, 'WorkingTable'))
    {
      Message('Не удалось загрузить функции по работе с табелем',error);
      abort;
      exit;
    }
      _mes := 12 ;


        Ntab--;  //счетсик для последнего назначения
        if (Ntab = 0)
        {
          myLog('Последняя запись');
          var _month, _month1, _year, _yearn :integer;
           _month:=0; _month1:=0; _year:=0; _yearn :=0;
           _month := month(DataAppPer.AppPerData);
           _year := year(DataAppPer.AppPerData);
           if (appKol.DORDERDISDATE <> 0)
         {
            _month1 :=  month(appKol.DORDERDISDATE);
            _yearn :=  year(appKol.DORDERDISDATE);
         }
         else
         {
           _month1 :=  month(cur_date);
            _yearn :=  year(cur_date);
         }
         var yerN, monM : integer;
         for (yerN :=_year ; yerN <= _yearn; yerN++)
              {


                  if(yerN = _yearn)
                  {
                    _mes:= _month1;
                  }

                for  (monM := _month; monM <=  _mes; monM++ )    //12 vtczwtd
                {

                   _loop Lschet__yearPrem Where ((PerData.PerNrec == Lschet__yearPrem.tPerson (noindex) and 0 == Lschet__yearPrem.sovm ))
                      {


                            if (LoadWorkingTable(Lschet__yearPrem.nrec, monM, yerN) = 0)
                            {
                               var _DaysFactN : double = WT_GetDays(dkWorking , stActual);
                               var _DaysPlanN : double = WT_GetDays(dkWorking , stPlanned);
                               var _DaysOverN : double = WT_GetDays(dkOverWork , stActual);
                               var _DaysOverN1 : double = WT_GetDays(dkWorkingWeekendHoliday , stActual);

                                if (_DaysFactN <> 0)
                                {
                                DaysPlanN := DaysPlanN + _DaysPlanN;
                                DaysFactN := DaysFactN + _DaysFactN;
                                DaysOverN := _DaysOverN1 + _DaysOverN + DaysOverN;
                                }

                               // myLog(dataappper.PerFio + ' yer='+yerN+ '  mon = '+monM +' _DaysFact='+_DaysFactN + ' _DaysPlan=' +_DaysPlanN);
                            }
                             myLog(dataappper.PerFio + '  начал работать с ' + yerN + ' мес ' + monM + '  по  ' +  _yearn + ' мес ' + _month1);
                      }
                      if (monM = 12)
                    {
                      _month:=1;
                      break;
                    }

                }
                DaysFact1SumN := DaysFactN + DaysFact1SumN;
                DaysPlanSumN := DaysPlanN + DaysPlanSumN;
                DaysOverSumN := DaysOverSumN + DaysOverN;

              }
         set DataAppPer.PlanDays :=  DaysPlanSumN;
         set DataAppPer.FactDays :=  DaysFact1SumN;
         set DataAppPer.SverhNorm :=  DaysOverSumN;
        }
       // message(DataAppPer.PlanDays + ' ok')  ;




      /***************для всех назначений******************************************************************/
      if (__year = 0)
      {
        __year := year(DataAppPer.AppPerData);
        I_month := month(DataAppPer.AppPerData);
      }
      else
      {
          if (_year1 <> 0)
          {
           __year := _year1;
           _year1 :=  year(DataAppPer.AppPerData);
           I_month :=  I_month1;
           I_month1 :=  month(DataAppPer.AppPerData) ;

          }
          if (__year <> 0)
          {
            _year1 := year(DataAppPer.AppPerData);
            I_month1 :=  month(DataAppPer.AppPerData) ;
          }


      }

      var yer, mon : integer;
        _mes := 12 ;
      for (yer :=__year ; yer <= _year1; yer++)
      {
          if(yer = _year1)
            {
              _mes:= I_month1;
            }
        for  (mon := I_month; mon <=  _mes;mon++ )    //12 vtczwtd
        {

           _loop Lschet__yearPrem1 Where ((PerData.PerNrec == Lschet__yearPrem1.tPerson (noindex) and 0 == Lschet__yearPrem1.sovm ))
              {


                    if (LoadWorkingTable(Lschet__yearPrem1.nrec, mon, yer) = 0)
                    {
                       var _DaysFact : double = WT_GetDays(dkWorking , stActual);
                       var _DaysPlan : double = WT_GetDays(dkWorking , stPlanned);
                       var _DaysOver : double = WT_GetDays(dkOverWork , stActual);
                       var _DaysOver1 : double = WT_GetDays(dkWorkingWeekendHoliday , stActual);

                        if (_DaysFact <> 0)
                        {
                        DaysPlan := DaysPlan + _DaysPlan;
                        DaysFact := DaysFact + _DaysFact;
                        DaysOver := _DaysOver1 + _DaysOver + DaysOver;
                        }
                       myLog(dataappper.PerFio +  ' DaysOver=' +DaysOver);

                    }

              }
          //myLog(dataappper.PerFio + '  начал работать с ' + yer + ' мес ' + mon + '  по  ' +  _year1 + ' мес ' + I_month1);
          if (mon = 12)
              {
                I_month:=1;
                break;
              }

        }

        DaysFact1Sum := DaysFact + DaysFact1Sum;
        DaysPlanSum := DaysPlan + DaysPlanSum;
        DaysOverSum := DaysOverSum + DaysOver;
        myLog(dataappper.PerFio +  ' DaysOverSum=' +DaysOverSum);
        DaysPlan :=0;
        DaysFact :=0;
        DaysOver :=0;
      }

     /* if (Ntab = 0)  {
         message(DaysFact1Sum + '  '+ DaysPlanSum) ;
        }      */
      var pp1:integer;
       pp1:=pp - 1;

       myLog('следущая позиция');
       insert current  DataAppPer;
       if (chekNrec = PerData.PerNrec)
       {
         if getfirst DataAppPer1 where((pp1 == DataAppPer1.pp)) = tsOK
         {
              update current DataAppPer1 set DataAppPer1.PlanDays := DaysPlanSum ;
              update current DataAppPer1 set DataAppPer1.FactDays := DaysFact1Sum ;
              update current DataAppPer1 set DataAppPer1.SverhNorm := DaysOverSum ;

         }


       }

       DaysPlan :=0;
       DaysFact :=0;
       DataAppPer.PlanDays  := 0 ;
       DataAppPer.FactDays := 0 ;
       DaysFact1Sum := 0;
       DaysPlanSum := 0;

      chekNrec := PerData.PerNrec;
    }



  }


  }


 if isvalid(#DataAppPer)
      {

    sFileName := 'Отчет на '+DateToStr(Cur_Date, 'MMDDYYYY:') + TimeToStr(cur_time, 'HH:MM:SS');
    sFullName := GetDefaultUserPath + '\'+sFileName+'.xlsx';
    xlCreateExcel(sFullName, TRUE);
    lRB  := 1;
    lDB  := lRB + 1;
    lCB  := 1;
    lCE  := 1;
    iNPP := 1;
    RestartVisual('Выгрузка данных.',1);

    #define FrmHd  lRB,  lCE,  lRB,  lCE
    iOut.Header1Row('Код подразделения',#FrmHd); lCE++;
    iOut.Header1Row('Наименование подразделения',#FrmHd); lCE++;
    iOut.Header1Row('Ф.И.О.',#FrmHd); lCE++;
    iOut.Header1Row('Должность',#FrmHd); lCE++;
    iOut.Header1Row('Категория должности',#FrmHd); lCE++;
    iOut.Header1Row('Прием/перевод/изменение оклада',#FrmHd); lCE++;
    iOut.Header1Row('Заработная плата',#FrmHd); lCE++;
    iOut.Header1Row('Дата увольнения',#FrmHd); lCE++;
    iOut.Header1Row('Причина увольнения',#FrmHd); lCE++;
    iOut.Header1Row('Истинная причина увольнения',#FrmHd); lCE++;
    iOut.Header1Row('Стаж в должности',#FrmHd); lCE++;
    iOut.Header1Row('Возраст',#FrmHd); lCE++;
    iOut.Header1Row('Вид образования, специальность',#FrmHd); lCE++;
    iOut.Header1Row('Отметка о целевом обучении',#FrmHd); lCE++;
    iOut.Header1Row('Количество нарушений трудовой дисциплины',#FrmHd); lCE++;
    iOut.Header1Row('Дисциплинарные взыскания',#FrmHd); lCE++;
    iOut.Header1Row('План дни (по табелю)',#FrmHd); lCE++;
    iOut.Header1Row('Факт дни (по табелю)',#FrmHd); lCE++;
    iOut.Header1Row('Дни отсутствия (по табелю)',#FrmHd); lCE++;
    iOut.Header1Row('% отсутствия',#FrmHd); lCE++;
    iOut.Header1Row('% переработанного времени',#FrmHd); lCE++;
    iOut.Header1Row('% загруженности',#FrmHd); lCE++;
    iOut.Header1Row('Личное заявление (дни)',#FrmHd); lCE++;
    iOut.Header1Row('Поручение руководителя (дни)',#FrmHd); lCE++;
    iOut.Header1Row('Отработано сверх нормы',#FrmHd); lCE++;

    _loop DataAppPer iNPP++;
    if (not xlCreateMatrix(iNPP+1,lCE))
    {
      message('Ошибка функции xlCreateMatrix.',error);
      xlKillExcel;
      StopVisual;
      exit;
    }
    xlSetNumberFormat('@',lRB, 1,iNPP+1, lCE);


    var RowU, merge : longint;
    RowU:= 2;
    merge :=0 ;
    lDE := 1;
    _loop PerData //объединение
    {
       if (merge = 0) {
       merge++;
       xlMergeCells(2, 3,  1 + PerData.Kolvo , 3);
       xlMergeCells(2, 8,      PerData.Kolvo , 8);
       xlMergeCells(2, 9,      PerData.Kolvo , 9);
       xlMergeCells(2, 12, 1 + PerData.Kolvo , 12);
       xlMergeCells(2, 13, 1 + PerData.Kolvo , 13);
       xlMergeCells(2, 14, 1 + PerData.Kolvo , 14);
       xlMergeCells(2, 15, 1 + PerData.Kolvo , 15);
       xlMergeCells(2, 16, 1 + PerData.Kolvo , 16);
      // xlFrameCells(xlBorderT, xlThin, 0, 0, 1,1,1 + PerData.Kolvo,25)
       RowU := 2 + PerData.Kolvo

       }
       else {

       xlMergeCells(RowU, 3, RowU + PerData.Kolvo - 1 , 3);
       xlMergeCells(RowU, 8, RowU + PerData.Kolvo - 2 , 8);
       xlMergeCells(RowU, 9, RowU + PerData.Kolvo - 2 , 9);
       xlMergeCells(RowU, 12, RowU + PerData.Kolvo - 1 , 12);
       xlMergeCells(RowU, 13, RowU + PerData.Kolvo - 1 , 13);
       xlMergeCells(RowU, 14, RowU + PerData.Kolvo - 1 , 14);
       xlMergeCells(RowU, 15, RowU + PerData.Kolvo - 1 , 15);
       xlMergeCells(RowU, 16, RowU + PerData.Kolvo - 1 , 16);
       //xlFrameCells(xlBorderT, xlThin, 0, 0, 1,1,RowU + PerData.Kolvo - 1,25)
       RowU := RowU + PerData.Kolvo

       }
    }
   _loop DataAppPer
    {

      if (not NextVisual) break;

      xlStWriteToMatrix(lDE,1,DataAppPer.Kodper                        );// iOut.Header1Row('Код подразделения',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,2,DataAppPer.NamePodr                      );// iOut.Header1Row('Наименование подразделения',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,3,DataAppPer.PerFio                        );// iOut.Header1Row('Ф.И.О.',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,4,DataAppPer.PostFio                       );// iOut.Header1Row('Должность',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,5,DataAppPer.KatPer                        );// iOut.Header1Row('Категория должности',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,6,DataAppPer.AppPerData                    );// iOut.Header1Row('Прием/перевод/изменение оклада',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,7,DataAppPer.TaxPer                        );// iOut.Header1Row('Заработная плата',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,8,DataAppPer.DissDataper                   );// iOut.Header1Row('Дата увольнения',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,9,DataAppPer.DiscriptDiss                  );// iOut.Header1Row('Причина увольнения',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,10,DataAppPer.TrueDiscPer                  );// iOut.Header1Row('Истинная причина увольнения',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE - 1,11,DataAppPer.StajInJob                    );// iOut.Header1Row('Стаж в должности',#FrmHd); lCE+
      xlStWriteToMatrix(lDE,12,DataAppPer.AgePer                       );// iOut.Header1Row('Возраст',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,13,DataAppPer.EduPer + '; '+ DataAppPer.EduPer1  );// iOut.Header1Row('Вид образования, специальность',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,14,DataAppPer.EduonPPer                    );// iOut.Header1Row('Отметка о целевом обучении',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,15,DataAppPer.KolNar                       );// iOut.Header1Row('Количество нарушений трудовой дисциплины',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,16,DataAppPer.VidNar                       );// iOut.Header1Row('Дисциплинарные взыскания',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE,17,DataAppPer.PlanDays                      );// iOut.Header1Row('План дни (по табелю)',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE ,18,DataAppPer.FactDays                     );// iOut.Header1Row('Факт дни (по табелю)',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE ,19,DataAppPer.PlanDays - DataAppPer.FactDays);// iOut.Header1Row('Дни отсутствия (по табелю)',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE ,20, (((DataAppPer.PlanDays - DataAppPer.FactDays)* 100)/DataAppPer.PlanDays) + '%'  );// iOut.Header1Row('% отсутствия',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE ,21,((DataAppPer.SverhNorm* 100)/DataAppPer.PlanDays) + '%');// iOut.Header1Row('% переработанного времени',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE ,22,( 100 - ((DataAppPer.SverhNorm* 100)/DataAppPer.PlanDays) - ((DataAppPer.PlanDays - DataAppPer.FactDays)* 100)/DataAppPer.PlanDays) + '%');// iOut.Header1Row('% загруженности',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE ,23,''                                      );// iOut.Header1Row('Личное заявление (дни)',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE ,24,''                                      );// iOut.Header1Row('Поручение руководителя (дни)',#FrmHd); lCE++;
      xlStWriteToMatrix(lDE ,25,DataAppPer.SverhNorm                                      );// iOut.Header1Row('Отработано сверх нормы',#FrmHd); lCE++;

      lDE++;

    }


   xlSetFontStyle(xlBold, 1, 1, 1, 25);
   xlSetRowHeight(30, 1, 1, 1, 25);
   xlAlignCellsEx(-4108,-4160, 1,1, lDE, 25);
   xlFrameCells(xlBorderB, xlThick, 0, 0, 1,1,1,25);
   //xlFreeze(lDE,3)

    RestartVisual('Вставка данных в Excel.',1);
    if (not xlWriteMatrixToExcel(2,1))
      message('Ошибка функции xlWriteMatrixToExcel.',error);
    xlFreeMatrix;
    xlAutoFit(lRB,lCB,lDE,lCE);
    xlSetSheetName(1, 'РЕЕСТР');

    xlKillExcel;
  }
  else
  {
    message('Нет данных для формирования отчета!');
  }
  StopVisual;

}



/************************************************************************************************************/
 /*
embedded ComFiltrEmbedded 'Фильтры' interface VCommonFiltr;
  show (,,85,6);
end      */

Screen s2('Параметры отчета',,sci1Esc);

  fields
    DateStart, noprotect;
    DateEnd, noprotect;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
    <<

    В период с:.@@@@@@@@@@  по:.@@@@@@@@@@

    <.Сформировать.>     <. ~З~акрыть .>

    >>
end;

handleevent
  cmInit:
  {


    delete all from PerData;
    delete all from DataAppPer;
    DateStart := cur_date;
    DateEnd := cur_date;
  }
  cmOk:
  {
    //Fill_NrecPer  ;
  delete all from tmp_NrecPer;

  sql
  select persons.nrec
  from persons
  where persons.disdate between :(DateStart) and :(DateEnd)
  and  not exists (select p.nrec
        from persons p
        inner join catalogs on catalogs.nrec = p.DEPARTMENT
        where catalogs.name = 'Ветераны'
        and persons.nrec  = p.nrec)

        and not exists (select p1.nrec
        from persons p1
        inner join catalogs c1 on c1.nrec = p1.DEPARTMENT
        where c1.name = '_Студенты'
        and persons.nrec  = p1.nrec)

        and not exists (select p2.nrec
        from persons p2
        inner join catalogs c2 on c2.nrec = p2.DEPARTMENT
        where c2.name = '_Профком'
        and persons.nrec  = p2.nrec)

        and not exists (select p3.nrec
        from persons p3
        inner join catalogs c3 on c3.nrec = p3.DEPARTMENT
        where c3.name = '_Физические лица'
        and persons.nrec  = p3.nrec)

        and not exists (select p4.nrec
        from persons p4
        inner join catalogs c4 on c4.nrec = p4.DEPARTMENT
        where c4.name = 'Договора подряда'
        and persons.nrec  = p4.nrec)


  into tmp_NrecPer;


    Run;

    closeinterface(cmDefault);
  }
  cmCancel:
  {
    closeinterface(cmDefault);
  }
end;
end.

#include UserReport.vih

VipInterface UserReport_Dissmissfor_ZGD Implements IUserReport;
Interface UserReport_Dissmissfor_ZGD;
Procedure Run;                                  {runinterface(Dissmissfor_ZGD);}
Function  GetReportName               : String; {GetReportName := 'Отчет уволенные для ЗГД';}
Function  GetGroupName (Level : Word) : String; {Level:=Level;GetGroupName := '';}
function  GetPriority                 : Integer;{GetPriority := 0;}
function  VisibleInModule(Ind : Byte) : String; {Ind:=Ind; VisibleInModule := 'STAFFMAINMENU';} // для Пушковой Перенесено из MENUZARP';}
End.
