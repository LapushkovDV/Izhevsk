var
  dBeg, dEnd    : date;
  VCommonFiltr  : CommonFiltr;
  MadeReport    : boolean;
  cPersNRec     : comp;
  PersMarker    : TPtr;
  iCatFunc      : CatalogsFunctions;
  iStrFunc      : StringFunctions;
  iAppFuncs     : AppointmentsFunctions;
  iPsnFuncs     : PersonsFunctions;
  iAdrFunc      : AddressFunc;
  iOut          : GP_XlOutExt;
  iChRPD        : GP_ChRPD;
  sFullName     : string;
  lRB, lRE,
  lCB, lCE,
  lSB, lSE,
  lDB, lDE,
  lRow          : longint;
  dOnDate       : date;
  cRecNeedApp   : comp;
  cRecDMSCat    : comp;
  sSigner       : string; 

create view
var
  cPsnComm : comp;
from
  ttPerFlt
, persons
, GP_RaiseHistExt111 GPRHist111
, raisehist RHist111
, ContDoc CDoc111
//Main
, ContDoc CDoc8
, Appointments App8
, ContDoc CDoc1
, Appointments App1
, ContDoc CDoc5
, ContDoc CDoc5O
, Appointments App5
, CasePsn
//add
, Appointments AppNeed
, CompetencePost ComPostNeed
, Catalogs CatNeed
, Passports PassInvalid
, AddressN AddrNeed
, Communications
, Catalogs CatComm
//result
, ttPage1
, ttPage2
, ttPage3
, ttPage4
, ttPage5
where
((
    ttPerFlt.cRecPers == persons.nrec
//страница 1
and ttPerFlt.cRecPers == CDoc8.Person
and integer(8) == CDoc8.TypeOper// and (CDoc8.wYearPR = 1 or CDoc8.wYearPR = 2)
and CDoc8.cStr == App8.nRec and (App8.DismissDate >= dBeg and App8.DismissDate <= dEnd and App8.lPrizn = 0)
//страница 2
and ttPerFlt.cRecPers == CDoc1.Person
and integer(1) == CDoc1.TypeOper// and (CDoc1.wYearPR = 1 or CDoc1.wYearPR = 2)
and CDoc1.cStr == App1.nRec and (App1.AppointDate >= dBeg and App1.AppointDate <= dEnd and App1.lPrizn = 0)
//страница 3
and ttPerFlt.cRecPers == CDoc5.Person
and integer(5) == CDoc5.TypeOper
and integer(2) == CDoc5.SeqNmb
and CDoc5.cPart == CDoc5O.cPart
and integer(1) == CDoc5O.SeqNmb// and (CDoc5O.wYearPR = 1 or CDoc5O.wYearPR = 2)
and CDoc5.cStr == App5.nRec and (App5.AppointDate >= dBeg and App5.AppointDate <= dEnd and App5.lPrizn = 0)
//страница 5
and ttPerFlt.cRecPers == CasePsn.cPsn and (CasePsn.dChange >= dBeg and CasePsn.dChange <= dEnd)
//Вспомогательные выборки что бы не перегружать данными основные наборы
//для приемов
and cRecNeedApp == AppNeed.nRec 
and AppNeed.Post == ComPostNeed.cPost //ComPost1.cName -> catalogs
and ComPostNeed.cName == CatNeed.nRec
and cPsnComm == Communications.Person
and Communications.ComType == CatComm.nRec
//Инвалидность
and ttPerFlt.cRecPers == PassInvalid.Person
and integer(560) == PassInvalid.SysCode
//address и страница 4
and ttPerFlt.cRecPers == AddrNeed.cPerson
and word(2) == AddrNeed.ObjType         
//DMS
and ttPerFlt.cRecPers == GPRHist111.cPerson (noindex) and (GPRHist111.DateBeg <= dOnDate and GPRHist111.DateEnd >= dOnDate)
and GPRHist111.cRaiseH == RHist111.nrec
and RHist111.cContDoc == CDoc111.nrec// and (CDoc111.wYearPR = 1 or CDoc111.wYearPR = 2)
))
;

file xlPageScaleLandMacros;
procedure xlPageScaleLandscapeByName(iPage : integer; sPage : string; iFitToPagesWide : integer);
{
  var MacrosFN: String;
  MacrosFN := GetDefaultUserPath + 'xlPageScale.bas';
  if xlPageScaleLandMacros.OpenFile(MacrosFN, stCreate)
  {
    xlPageScaleLandMacros.Writeln('Sub xlPageScale'+iPage);
    xlPageScaleLandMacros.Writeln('  Sheets("'+sPage+'").Select');
    xlPageScaleLandMacros.Writeln('  Application.PrintCommunication = False');
    xlPageScaleLandMacros.Writeln('  ActiveSheet.PageSetup.Orientation = xlLandscape');
    xlPageScaleLandMacros.Writeln('  ActiveSheet.PageSetup.FitToPagesWide = '+iFitToPagesWide);
    xlPageScaleLandMacros.Writeln('  Application.PrintCommunication = True');
    xlPageScaleLandMacros.Writeln('End Sub');
    xlPageScaleLandMacros.Close;
    xlImportModule(MacrosFN);
    xlRunMacro('xlPageScale'+iPage);
    DeleteFile(MacrosFN);
  }
}

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

function isDMSOnDate(dAny : date) : boolean;
{
  result := false;
  set dOnDate := dAny;
  if isvalid(#GPRHist111)
    if isvalid(#RHist111)
      if isvalid(#CDoc111)
        if iChRPD.isConfirmed(CDoc111.nRec)
          result := true;
}
function sNeedVarStrah(sRecAny : comp) : string;
{
  result := '';
  set cRecNeedApp := sRecAny;
  if isvalid(#AppNeed)
    if isvalid(#ComPostNeed)
    _loop ComPostNeed
      if isvalid(#CatNeed)
        if CatNeed.cParent = cRecDMSCat
          result := CatNeed.Name;
}
procedure FindPostDept(cRecAny : comp; var sPost, sDept : string);
{
  sPost := sDept := '';
  set cRecNeedApp := cRecAny;
  if isvalid(#AppNeed)
  {
    sPost := iCatFunc.GetCatalogsName(AppNeed.Post);
//    sDept := iCatFunc.GetCatalogsName(AppNeed.Department);
    sDept := iCatFunc.GetCatalogsCode(AppNeed.Department);
  }
}

function sRepPhoneList(cPsn : comp; sAny : string) : string;
{
  result:='';
  set cPsnComm := cPsn;
  if isvalid(#Communications)
  _loop Communications
    if isvalid(#CatComm)
      if Pos(sAny,LoCase(CatComm.Name))<>0
        result+=if(Trim(result)<>'','; ','')+Communications.Addr;
}

procedure MakePage1;
{
  var dDismiss : date = 0;

  if isvalid(#CDoc8)
  _loop CDoc8
    if iChRPD.isConfirmed(CDoc8.nRec)
      if isvalid(#App8)
        if dDismiss < App8.DismissDate
          dDismiss := App8.DismissDate;
  if dDismiss <> 0
  {
    if isDMSOnDate(dDismiss)
    {
      clearbuffer(#ttPage1);
      ttPage1.sFamil := iStrFunc.Get_LastName (Persons.FIO);
      ttPage1.sImya  := iStrFunc.Get_FirstName(Persons.FIO);
      ttPage1.sOtch  := iStrFunc.GetPatronymic(Persons.FIO);
      ttPage1.dBorn  := Persons.BornDate;
      ttPage1.sSex   := Persons.Sex;
      ttPage1.sNoPolis   := GPRHist111.PolisDMS;
      ttPage1.sVarStrah  := iCatFunc.GetCatalogsName(GPRHist111.cVarStrah);
      ttPage1.dPolisE  := GPRHist111.DateEnd;
      ttPage1.cRecPsn  := Persons.nRec;
      ttPage1.dDismiss := dDismiss;
      insert current ttPage1;
    }
  }
}
procedure MakePage2;
{
  var isAppoint    : boolean = false;
  var cRecAppOnEnd : comp = 0;

  if isvalid(#CDoc1)
  _loop CDoc1
    if iChRPD.isConfirmed(CDoc1.nRec)
      if isvalid(#App1)
        isAppoint := true;
  
  if isAppoint
  {
    if ( getfirst ttPage1 where((Persons.nRec == ttPage1.cRecPsn)) = tsOk )
      if CalcDaysBetweenDates(ttPage1.dDismiss, App1.AppointDate, false) <= 5
      {
        delete current ttPage1;
        exit;
      }
    clearbuffer(#ttPage2);
    ttPage2.sFamil := iStrFunc.Get_LastName (Persons.FIO);
    ttPage2.sImya  := iStrFunc.Get_FirstName(Persons.FIO);
    ttPage2.sOtch  := iStrFunc.GetPatronymic(Persons.FIO);
    ttPage2.dBorn  := Persons.BornDate;
    ttPage2.sSex   := Persons.Sex;

    cRecAppOnEnd := iAppFuncs.GetAllAppNRec_IncludeDate(ttPerFlt.cRecPers, dEnd, 0);
    ttPage2.sVarStrah := sNeedVarStrah(cRecAppOnEnd);          
    FindPostDept(cRecAppOnEnd, ttPage2.sPost, ttPage2.sDept);

    if isvalid(#PassInvalid)
    _loop PassInvalid
      if iStrFunc.isCrossPeriod(dBeg, dEnd, PassInvalid.GivenDate, PassInvalid.ToDate)
        ttPage2.sInvalid := iCatFunc.GetCatalogsName(comp(PassInvalid.GivenPodr));
    if isvalid(#AddrNeed)
    _loop AddrNeed
      if (AddrNeed.dRegBeg = 0 and AddrNeed.dRegEnd = 0)
      or (AddrNeed.dRegEnd = 0 and AddrNeed.dRegBeg <= dBeg)
      or (iStrFunc.isCrossPeriod(dBeg, dEnd, AddrNeed.dRegBeg, AddrNeed.dRegEnd))
        ttPage2.sAddress := iAdrFunc.GetFullAddressInd(AddrNeed.nRec);

    ttPage2.sHPhone := sRepPhoneList(ttPerFlt.cRecPers, 'дом');//iPsnFuncs.GetCommunicationPer(ttPerFlt.cRecPers,psnLinksPhoneHome);
    ttPage2.sWPhone := sRepPhoneList(ttPerFlt.cRecPers, 'раб');//iPsnFuncs.GetCommunicationPer(ttPerFlt.cRecPers,psnLinksPhoneWork);
    ttPage2.sMPhone := iPsnFuncs.GetCommunicationPer(ttPerFlt.cRecPers,psnLinksPhoneMobile);

    insert current ttPage2;
  }
}
procedure MakePage3;
{
  var dMove : date = 0;
  var sVarStrahOldT
     ,sVarStrahNewT : string = '';

  if isvalid(#CDoc5)
  _loop CDoc5
    if isvalid(#CDoc5O)
      if iChRPD.isConfirmed(CDoc5O.nRec)
        if isvalid(#App5)
          if ( dMove < App5.AppointDate )
            dMove := App5.AppointDate;
  if ( dMove <> 0 )
  {
    if isDMSOnDate(dMove)
    {
      sVarStrahOldT := iCatFunc.GetCatalogsName(GPRHist111.cVarStrah);                                 
      sVarStrahNewT := sNeedVarStrah(iAppFuncs.GetAllAppNRec_IncludeDate(ttPerFlt.cRecPers, dMove, 0));
      if ( sVarStrahOldT <> sVarStrahNewT )
      {
        clearbuffer(#ttPage3);
        ttPage3.sFamil := iStrFunc.Get_LastName (Persons.FIO);
        ttPage3.sImya  := iStrFunc.Get_FirstName(Persons.FIO);
        ttPage3.sOtch  := iStrFunc.GetPatronymic(Persons.FIO);
        ttPage3.dBorn  := Persons.BornDate;
        ttPage3.sSex   := Persons.Sex;
        ttPage3.sVarStrahOld  := sVarStrahOldT;
        ttPage3.sVarStrahNew  := sVarStrahNewT;
        ttPage3.sNoPolis   := GPRHist111.PolisDMS;
        ttPage3.fSumPolis:= RHist111.RHSum;
        ttPage3.dPolisB  := GPRHist111.DateBeg;
        ttPage3.dPolisE  := GPRHist111.DateEnd;
        insert current ttPage3;
      }
    }
  }
}
procedure MakePage4;
{
  var sAddressT : string = '';
  var dRegBegT  : date = 0;

  if isvalid(#AddrNeed)
  _loop AddrNeed
    if iStrFunc.isHitPeriod(dBeg, dEnd, AddrNeed.dRegBeg)
    {
      sAddressT := iAdrFunc.GetFullAddressInd(AddrNeed.nRec);
      dRegBegT  := AddrNeed.dRegBeg;
    }

  if sAddressT <> ''
  {
    if isDMSOnDate(dRegBegT)
    {
      clearbuffer(#ttPage4);
      ttPage4.sFamil := iStrFunc.Get_LastName (Persons.FIO);
      ttPage4.sImya  := iStrFunc.Get_FirstName(Persons.FIO);
      ttPage4.sOtch  := iStrFunc.GetPatronymic(Persons.FIO);
      ttPage4.dBorn  := Persons.BornDate;
      ttPage4.sSex   := Persons.Sex;
      ttPage4.sAddress   := sAddressT;
      ttPage4.sVarStrah  := iCatFunc.GetCatalogsName(GPRHist111.cVarStrah);
      ttPage4.sNoPolis   := GPRHist111.PolisDMS;
      ttPage4.dPolisB  := GPRHist111.DateBeg;
      ttPage4.dPolisE  := GPRHist111.DateEnd;
      insert current ttPage4;
    }
  }
}
procedure MakePage5;
{
  var dChangeT  : date = 0;

  if isvalid(#CasePsn)
  _loop CasePsn
    dChangeT := CasePsn.dChange; 

  if dChangeT <> 0
  {
    if isDMSOnDate(dChangeT)
    {
      clearbuffer(#ttPage5);
      ttPage5.sFamilO:= iStrFunc.Get_LastName (CasePsn.PsnV);
      ttPage5.sImyaO := iStrFunc.Get_FirstName(CasePsn.PsnV);
      ttPage5.sOtchO := iStrFunc.GetPatronymic(CasePsn.PsnV);
      ttPage5.sFamilN:= iStrFunc.Get_LastName (CasePsn.PsnD);
      ttPage5.sImyaN := iStrFunc.Get_FirstName(CasePsn.PsnD);
      ttPage5.sOtchN := iStrFunc.GetPatronymic(CasePsn.PsnD);
      ttPage5.dBorn  := Persons.BornDate;
      ttPage5.sSex   := Persons.Sex;
      ttPage5.sVarStrah  := iCatFunc.GetCatalogsName(GPRHist111.cVarStrah);
      ttPage5.sNoPolis   := GPRHist111.PolisDMS;
      ttPage5.dPolisB  := GPRHist111.DateBeg;
      ttPage5.dPolisE  := GPRHist111.DateEnd;
      insert current ttPage5;
    }
  }
}


#define FrmCl  lRE, lCE, lRE, lCE
#define FrmBl  lRB, lCE, lRE, lCE
#define AllTab lRB, lCB, lRE, lCE-1
#define repT   1,   1,   1,   1
#define repTA  1,   1,   1,   50
//'+chr(10)+'

#declare CommonInsuranceHeader
  iOut.StringValC('№'+chr(10)+'п/п', #FrmCl); lCE++;
  iOut.StringValC('№ полиса', #FrmCl); lCE++;
  iOut.StringValC('Фамилия', #FrmCl); lCE++;
  iOut.StringValC('Имя', #FrmCl); lCE++;
  iOut.StringValC('Отчество', #FrmCl); lCE++;
  iOut.StringValC('Дата'+chr(10)+'рождения', #FrmCl); lCE++;
//  iOut.StringValC('Пол', #FrmCl); lCE++;
#end
#declare CommonInsuranceColumnWidth
  xlSetColumnWidth( 5,#FrmBl); lCE++;
  xlSetColumnWidth(20,#FrmBl); lCE++;
  xlSetColumnWidth(20,#FrmBl); lCE++;
  xlSetColumnWidth(20,#FrmBl); lCE++;
  xlSetColumnWidth(20,#FrmBl); lCE++;
  xlSetColumnWidth(17,#FrmBl); lCE++;
//  xlSetColumnWidth( 4,#FrmBl); lCE++;
#end

procedure PrintPage1(iNumPageT : integer);
{
  xlSetActiveSheet(iNumPageT);
  lRB  := iTabBeg;
  lRow := 1;
  lRE := lRB;
  lCB  := 1;
  lCE  := 1;
  
//  iOut.StringValL('1. Список лиц, подлежащих исключению из Списка Застрахованных за период с '+datetostr(dBeg,'DD.MM.YYYY')+' по '+datetostr(dEnd,'DD.MM.YYYY'),#repT);
  iOut.StringValL('1. Список лиц, подлежащих исключению из Списка Застрахованных с',#repT);
  xlSetCellDateValue(dBeg,1,5,1,5);
  xlSetNumberFormat('[$-F800]ДДДД, ММММ ДД, ГГГГ',1,5,1,5);
  xlSetFontSize(12,#repTA); xlSetFontStyle(xlBold,#repTA);

  #CommonInsuranceHeader
  iOut.StringValC('Вариант страхования', #FrmCl); lCE++;
  iOut.StringValC('Пол', #FrmCl); lCE++;
//  iOut.StringValC('Дата'+chr(10)+'окончания', #FrmCl); lCE++;
  iOut.StringValC('Примечание', #FrmCl); lCE++;
  lRE++;
  
  if isvalid(#ttPage1)
  _loop ttPage1 ordered index ttPage1Rep
  {
    if (not NextVisual) break;
    lCE  := 1;
    iOut.IntegerVal(lRow++,            #FrmCl); lCE++;
    iOut.CodeVal   (ttPage1.sNoPolis,  #FrmCl); lCE++;
    iOut.StringValL(ttPage1.sFamil,    #FrmCl); lCE++;
    iOut.StringValL(ttPage1.sImya ,    #FrmCl); lCE++;
    iOut.StringValL(ttPage1.sOtch ,    #FrmCl); lCE++;
    xlAlignCellsEx(xlRight,xlCenter,   #FrmCl);
    xlSetCellDateValue(ttPage1.dBorn , #FrmCl); lCE++;
    iOut.StringValL(ttPage1.sVarStrah, #FrmCl); lCE++;
    iOut.StringValC(ttPage1.sSex  ,    #FrmCl); lCE++;
    xlAlignCellsEx(xlRight,xlCenter,   #FrmCl);
//    xlSetCellDateValue(ttPage1.dPolisE,#FrmCl); lCE++;
    lRE++;
  }
  lRE--;
  lCE := 1;
  
  #CommonInsuranceColumnWidth
  xlSetColumnWidth(20,#FrmBl); lCE++;
  xlSetColumnWidth( 4,#FrmBl); lCE++;
//  xlSetColumnWidth(12,#FrmBl); lCE++;
  xlSetColumnWidth(20,#FrmBl); lCE++;
  
  xlWrapText(#AllTab);
  xlSetFontSize(10,#AllTab);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0,#AllTab);
  iOut.StringValL(sSigner,lRE+2,2,lRE+2,2);
  xlSetSheetName(iNumPageT,'1.Исключение');
  xlPageScaleLandscapeByName(iNumPageT, Oem2Ansi('1.Исключение'), 1);
}
procedure PrintPage2(iNumPageT : integer);
{
  xlSetActiveSheet(iNumPageT);
  lRB  := iTabBeg;
  lRow := 1;
  lRE := lRB;
  lCB  := 1;
  lCE  := 1;
  
//  iOut.StringValL('2. Список лиц, подлежащих включению в Список Застрахованных за период с '+datetostr(dBeg,'DD.MM.YYYY')+' по '+datetostr(dEnd,'DD.MM.YYYY'),#repT);
//  xlSetFontSize(12,#repT); xlSetFontStyle(xlBold,#repT);
  iOut.StringValL('2. Список лиц, подлежащих включению в Список Застрахованных с',#repT);
  xlSetCellDateValue(dBeg,1,7,1,7);
  xlSetNumberFormat('[$-F800]ДДДД, ММММ ДД, ГГГГ',1,7,1,7);
  iOut.StringValC('по',1,9,1,9);
  xlSetCellDateValue(dEnd,1,10,1,10);
  xlSetNumberFormat('[$-F800]ДДДД, ММММ ДД, ГГГГ',1,10,1,10);
  xlSetFontSize(12,#repTA); xlSetFontStyle(xlBold,#repTA);

  #CommonInsuranceHeader
  iOut.StringValC('Пол', #FrmCl); lCE++;
  iOut.StringValC('Вариант страхования', #FrmCl); lCE++;
  iOut.StringValC('Стоимость полиса', #FrmCl); lCE++;
  iOut.StringValC('Инвалидность', #FrmCl); lCE++;
  iOut.StringValC('Адрес'+chr(10)+'фактического'+chr(10)+'проживания', #FrmCl); lCE++;
  iOut.StringValC('Домашний'+chr(10)+'телефон', #FrmCl); lCE++;
  iOut.StringValC('Рабочий'+chr(10)+'телефон', #FrmCl); lCE++;
  iOut.StringValC('Мобильный'+chr(10)+'телефон', #FrmCl); lCE++;
  iOut.StringValC('Должность', #FrmCl); lCE++;
  iOut.StringValC('Подразделение', #FrmCl); lCE++;
