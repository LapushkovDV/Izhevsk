table struct ttPerFlt // для фильтра по персоналу
(
  cRecPers : comp
)
with index
(
  ttPerFlt01  = cRecPers
);

table struct ttPage1
(
  cRecPsn  : comp
, sFamil   : string[20]
, sImya    : string[20]
, sOtch    : string[20]
, dBorn    : date
, sSex     : string[1]
, sNoPolis : string
, sVarStrah: string 
, dPolisE  : date
, dDismiss : date
)
with index
(
  ttPage1Rep = sFamil + sImya + sOtch
, ttPage1Dis = cRecPsn + dDismiss
)
;
table struct ttPage2
(
  cRecPsn  : comp
, sFamil   : string[20]
, sImya    : string[20]
, sOtch    : string[20]
, dBorn    : date
, sSex     : string[1]
, sInvalid : string[10]
, sVarStrah: string 
, sAddress : string
, sHPhone  : string
, sWPhone  : string
, sMPhone  : string
, sPost    : string
, sDept    : string
)
with index
(
  ttPage2Rep = sFamil + sImya + sOtch
)
;
table struct ttPage3
(
  cRecPsn  : comp
, sFamil   : string[20]
, sImya    : string[20]
, sOtch    : string[20]
, dBorn    : date
, sSex     : string[1]
, sVarStrahOld: string 
