  MNPLAN.NUMBER ('Код заказа',hcStaffWinPr,sci1378Esc) :Protect,  PickButton,QuickChoice;
//  MNPLAN.NAME   ('Наименование заказа',hcStaffWinPr,sci1378Esc) :Protect, NoDel, PickButton,QuickChoice;
  SPKAU.Code    ('Код проекта',hcStaffWinPr,sci1378Esc) :Protect,  PickButton,QuickChoice;
  SpKau.NAME    ('Наименование проекта',hcStaffWinPr,sci1378Esc) :Protect,  PickButton,QuickChoice;
  dSumma        ('Итого по приказу',,sci1Esc) : [10.2] , Protect, Nodel, NoPickButton;
  FortRaiseCat_P.Name ('Премия для приказа')  : Protect,PickButton;
  PartDoc.WINF2 : NoProtect,NoDel;//#1442
  PartDoc.DDAT1 ('Дата назначений') : NoProtect,NoDel;
<<
