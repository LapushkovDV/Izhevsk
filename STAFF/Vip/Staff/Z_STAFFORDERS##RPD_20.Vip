    ContDoc.wAttrDoc2 'Назначение'('Основное назначение или совмещение',, sci178Esc):
      [list 'основное назначение', 'совмещение', 'отсутствует'], [15], noautosize, protect;
    fullNamePodr 'Подразделение' ('Подразделение', hcStaffWinPr, ): [25], protect;
    [Podr_Kod] iCatFunc.GetCatalogsCode(ContDoc.cDopRef) 'Код' ('Код Подразделения', hcStaffWinPr, ): [6], protect,NoDel;
    Persons.FIO    'ФИО' ('Фамилия имя отчество', hcStaffWinPr, ): [28], protect;
    fTabNmb        'Табельный №' ('Табельный номер'): [12], skip;
    Catalogs.Name  'Должность'('Должность (из основного назначения или совмещения - для увольнения совместителей)' , hcStaffWinPr) :[15], skip;
    FORTUNE.DOCSUM 'Сумма' ('Основное назначение или совмещение',, sci178Esc) :[10.2,'\2p[|-]366`666`666`666`666.88'],NoProtect,NoPickButton; //[10,2],
    CurrNameFort   'Тип'  ('Валюта или проценты.',, sci1378Esc) :[10] ,Protect;
//--------------
    MNPLAN_C.NUMBER   'Заказ, код'           ('Код заказа'          ,hcStaffWinPr,sci1378Esc) :[10],Protect,  PickButton,QuickChoice;
//    MNPLAN_C.NAME   'Заказ, наименование'  ('Наименование заказа' ,hcStaffWinPr,sci1378Esc) :[20],Protect, NoDel, PickButton,QuickChoice;
//    SPKAU_C.Code    'Проект, код'          ('Код проекта'         ,hcStaffWinPr,sci1378Esc) :[10],Protect, NoDel, PickButton,QuickChoice;
//    SpKau_C.NAME    'Проект, наименование' ('Наименование проекта',hcStaffWinPr,sci1378Esc) :[20],Protect, NoDel, PickButton,QuickChoice;
//--------------
    PersOrderState 'Исполнение'  ('Исполнение', hcStaffWinPr): [12], skip,
    {font = {color = if ( isValid(#ContDoc) and (TitleDoc.wStatus <> 1) and (ContDoc.wYearPr = 0 or ContDoc.wYearPr = 3) and isValid(#AllMemo), ColorSysRed, 0)}};
end;

