Alter Interface RPD_20 ('');

//******************************************************************************
OverLoad
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_BASE.SetRelation(Value: comp);
  procedure prFillMenu(_menuID: longint);
end;
type rowRecord = record
  def: string;
  column: byte;
  value: string;
end;

var   _recArray: array [1..1] of rowRecord;

table struct tmpPersYearFortune
(
    cPersons       : comp
  , StrTabn        : String
  , Fio            : String
  , cAppoint       : comp
  , cLschet        : comp
  , Department     : comp
  , ProcentFortune : double
  , SumTime        : double
  , summa          : double
  , possiblePersPrem : word
)
with index
(
 ind0 = cPersons
)
;
//******************************************************************************
// Forward описания функций
//******************************************************************************
Function CalcSumma(_Nrec:comp) :double;forward;

//******************************************************************************
#include ShowKau.Vpp
#include GetKau.var
//******************************************************************************
var
  //---------------------------
  // Объекты
  //---------------------------
  pMarker       : IMarker(Marker) new; // функция пометки
  //---------------------------
  _year    : word;
  _mes     : byte;
  _SummaRaspred : double = 0;
  KAU_PROJECT:word=0; // КАУ Проект
  //---------------------------
  ATTR_ZAKAZ_P:comp;//ВА Заказ к части приказа
  ATTR_ZAKAZ_C:comp;//ВА Заказ к содержимому приказа
  ATTR_PROJECT_P:comp;//ВА Проект к части приказа
  ATTR_PROJECT_C:comp;//ВА Проект к содержимому приказа
  //---------------------------
  pTmp          :comp;// временный указатель на справочник
  MarkerTmp     :Longint;
  isOpenSearch  :boolean=false;
  isCalcFortune : boolean = false;
  _typeSelectPersons : Word = 0;
  _FileWithPersons   : String = '';
    _logGlobal
  , _PersExclude : string = '';
create view
as select
 //---------------------------
  coGetAttrID(coPartDoc,PartDoc.Nrec,ATTR_ZAKAZ_P   ) (FieldName=pZAKAZ_P   ,FieldTitle='Заказ приказа') //
 ,coGetAttrID(coContDoc,ContDoc.Nrec,ATTR_ZAKAZ_C   ) (FieldName=pZAKAZ_C   ,FieldTitle='Заказ') //
 ,coGetAttrID(coPartDoc,PartDoc.Nrec,ATTR_PROJECT_P ) (FieldName=pPROJECT_P ,FieldTitle='Проект приказа') //
 ,coGetAttrID(coContDoc,ContDoc.Nrec,ATTR_PROJECT_C ) (FieldName=pPROJECT_C ,FieldTitle='Проект') //
 //---------------------------
 , CalcSumma(PartDoc.Nrec) (FieldName=dSumma ,FieldTitle='Итого') //
from
 MNPLAN, MNPLAN MNPLAN_C
,SPKAU , SPKAU SPKAU_C
// для суммирования
, ContDoc ContDoc_Scan
, Fortune Fortune_Scan
, Catalogs FortRaiseCat_P // для групповой привязки
, tmpPersYearFortune
, UOWRKTABEL
, Lschet Lschet_YearPrem
where
((
      pZAKAZ_P   ==  MNPLAN.Nrec // Заказ приказа
  and pZAKAZ_C   ==  MNPLAN_C.Nrec  // Заказ
  and pPROJECT_P ==  SpKau.Nrec  // Проект приказа
  and pPROJECT_C ==  SpKau_C.Nrec  // Проект
  // для суммирования
  and PartDoc.Nrec == ContDoc_Scan.cPart
  and 0 << ContDoc_Scan.Seqnmb //
  //and ContDoc.cStr == Appointments.Nrec
  //and Appointments.Post == Catalogs.Nrec
  and ContDoc_Scan.Nrec  == Fortune_Scan.cFCont
  and PartDoc.CREF1      == FortRaiseCat_P.Nrec

))
; // create view
//******************************************************************************

create view vSpr
as select
   katkau.nrec
from
  katkau
where ((
       1        == KATKAU.SYSNUM
  and  0        == KATKAU.ISACTIVE
  and  'Проект' == katkau.name

)) ;
