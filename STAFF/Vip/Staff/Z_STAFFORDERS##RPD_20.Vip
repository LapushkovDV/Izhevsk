Function MysqlAddStr(var query_handle: longInt; add_query_str: string): longInt;
{
   Result:=sqlAddStr(query_handle, add_query_str);
     LogStrToFile(_logGlobal,add_query_str);
} //Function MysqlAddStr(var query_handle: longInt; add_query_str: string): longInt;


procedure FillFromDataBaseWithConditions;
{

   StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Выборка данных', 0);
    var _begYear : date = date(01,01,_year);
    var _endYear : date = date(31,12,_year);
    var _workFrom : date = date(01,10,_year); // по положению П-12-2018  работать начали до октября
    var _disdate : date = Titledoc.DOCdate;   // по положению П-12-2018  работающие на дату приказа
//    var _fio : string= 'Лапушков Дмитрий Владимирович';
    var _PunishZamechanie : comp = 000A00000003B80Dh; //Замечание
    var _PunishVigovor    : comp = 000A00000003B76Ch;  //Выговор
    delete all tmpPersYearFortune;

      var hstr : longint = 0;

    MysqlAddStr(hstr, '  select  Pers.nrec      as cPersons ');
    MysqlAddStr(hstr, '        , Pers.StrTabn   as StrTabn      ');
    MysqlAddStr(hstr, '        , Pers.Fio       as Fio          ');
    MysqlAddStr(hstr, '        , App.Nrec       as cAppoint     ');
    MysqlAddStr(hstr, '        , App.CADDNREC2  as cLschet      ');
    MysqlAddStr(hstr, '        , App.Department as Department   ');
    MysqlAddStr(hstr, '        , coalesce((select top 1 0.5 from PUNISHMENTS                                 ');
    MysqlAddStr(hstr, '                         where PUNISHMENTS.CPSN = pers.nrec                           ');
    MysqlAddStr(hstr, '                         and PUNISHMENTS.LASTDATE between #date('+datetostr(_begYear,'DD,MM,YYYY')+') and #date('+datetostr(_endYear,'DD,MM,YYYY')+') ');
    MysqlAddStr(hstr, '                         and PUNISHMENTS.CPTYPE = #comp('+_PunishZamechanie+')                ');
    MysqlAddStr(hstr, '          ),1) as ProcentFortune                                                      ');
    MysqlAddStr(hstr, '        , 0 as SumTime                                                                ');
    MysqlAddStr(hstr, '        , 0 as Summa                                                                  ');
    MysqlAddStr(hstr, '        , (select top 1 1 from GP_KPI_PERS_RAISE where CPERSONS = Pers.nrec) as possiblePersPrem ');
    MysqlAddStr(hstr, '  from Persons Pers                                                                   ');
    MysqlAddStr(hstr, '  join Appointments App on App.nrec = case when Pers.AppointCur = #date(0,0,0) then Pers.AppointLast  else Pers.AppointCur end  ');
    MysqlAddStr(hstr, '  join catalogs Dep on dep.nrec = App.Department                                      ');
    MysqlAddStr(hstr, '  join catalogs Dolj on Dolj.nrec = App.post                                             ');
    MysqlAddStr(hstr, '   join ( select App.PERSON from Appointments App                                        ');
    MysqlAddStr(hstr, '            where  (App.DISMISSDATE = #date(0,0,0) or App.DISMISSDATE >= #date('+datetostr(_disdate,'DD,MM,YYYY')+')) and App.lPrizn in (100,0)');
    MysqlAddStr(hstr, '           group by App.PERSON                                                           ');
    MysqlAddStr(hstr, '        ) appCurYearUvolen on appCurYearUvolen.person = Pers.nrec                        ');
    MysqlAddStr(hstr, '   join ( select App.PERSON from Appointments App                                        ');
    MysqlAddStr(hstr, '            where  App.AppointDate <= #date('+datetostr(_workFrom,'DD,MM,YYYY')+') and App.lPrizn in (100,0)   ');
    MysqlAddStr(hstr, '           group by App.PERSON                                                           ');
    MysqlAddStr(hstr, '        ) appCurYearPriem on appCurYearPriem.person = Pers.nrec                          ');
    MysqlAddStr(hstr, '   join (Select pers.nrec as cPers from Lstab LS                                         ');
    MysqlAddStr(hstr, '            join Lschet on Lschet.Nrec = LS.cLschet                                      ');
    MysqlAddStr(hstr, '            join persons pers on pers.nrec = lschet.tPerson                              ');
    MysqlAddStr(hstr, '         where LS.YearN = '+string(_year)+' and LS.MesN >= 1 and LS.Mesn < 10                         ');
    MysqlAddStr(hstr, '         group by pers.nrec                                                              ');
    MysqlAddStr(hstr, '         ) tabel on tabel.cPers = pers.nrec                                              ');
    MysqlAddStr(hstr, '  where  Pers.nrec not in (select PUNISHMENTS.CPSN from PUNISHMENTS                       ');
    MysqlAddStr(hstr, '                         where PUNISHMENTS.LASTDATE between #date('+datetostr(_begYear,'DD,MM,YYYY')+') and #date('+datetostr(_endYear,'DD,MM,YYYY')+') ');
    MysqlAddStr(hstr, '                        and PUNISHMENTS.CPTYPE = #comp('+_PunishVigovor+')');
    MysqlAddStr(hstr, '                       )    ');
    MysqlAddStr(hstr, ' and pers.isemployee = ''С'' ');
    MysqlAddStr(hstr, ' and substring(dep.code, 1, 3) not in (''972'')  ');
/*
    MysqlAddStr(hstr, '  and PERS.APPDATE <= #date('+datetostr(_workFrom,'DD,MM,YYYY')+')                                                  ');
    MysqlAddStr(hstr, '  and (App.DISMISSDATE = 0 or App.DISMISSDATE >= #date('+datetostr(_disdate,'DD,MM,YYYY')+') )                        ');
*/
/* испытательный срок убираем, отбираем всех
    MysqlAddStr(hstr, 'and pers.nrec not in (select                                ');
    MysqlAddStr(hstr, '   pers.nrec                                                ');
    MysqlAddStr(hstr, 'from Persons Pers                                           ');
    MysqlAddStr(hstr, 'join ContDoc CD on CD.PERSON = pers.nrec                    ');
    MysqlAddStr(hstr, 'join PartDoc PD on Pd.Nrec = CD.cPart                       ');
    MysqlAddStr(hstr, 'where PD.TYPEOPER = 1                                       ');
    MysqlAddStr(hstr, 'and CD.dat1 >= #date('+datetostr(_disdate,'DD,MM,YYYY')+')  ');
    MysqlAddStr(hstr, 'and pers.isemployee = ''С''   )                             ');
*/
  var _tmpName :string = iGetKau.GetMarkerName(cgKau_Persons);
  var Marker_Tmp  : longint =InitMarker(_tmpName, 8, 50, 10, True);
  if getmarkercount(Marker_Tmp) > 0
    MysqlAddStr(hstr, 'and pers.nrec not in (Select cRec from t'+SubStr(_tmpName,1,19) +' )    ');
 DoneMarker(Marker_Tmp,_tmpName);
    var objQuery: iQuery;
      objQuery := queryManager.createQuery(hstr);

    if objQuery.execute.errorCode != tsOk
     then {
        logstrtofile(_logGlobal,'Ошибка выполнения запроса '+ objQuery.errorCode);
        }
    else
    {
      sqlCopyInto(objQuery, tntmpPersYearFortune, true);
    }
   stopvisual;

}
#include Z_STAFFORDERS##RPD_20_FortuneloadFromExcel.vpp
Procedure CalcYearFortune;
{
var _FileLog : string = '_YearFortuneCalc_'+ DatetoStr(Cur_Date,'YYYYMMDD')+'_'+TimeToStr(Cur_Time,'HHMMSS')+'.csv';
DeleteFile(_FileLog);

var _isContinue : boolean  = true ;
   case _typeSelectPersons of
    0 : FillFromDataBaseWithConditions
    1 : _isContinue := FillFromExcel
   end;
   if not _isContinue  then
   {
     message('В процессе работы обнаружены ошибки',error);
     ProcessText(_logGlobal, vfEscable or vfNewTitle or vfMacroSize, 'Протокол обработки файлов и загрузки данных');
     exit;
   }
   var _npp : longint = 0;
   var CS: IContextSession; // для захвата прикладного контекста табеля
    // В код обработчика инициализации интерфейса добавлены строки:
   var CL: ContextList;
   var _allTime : double = 0;
    if (not CL.Add(CS, 'WorkingTable'))
    {
      Message('Не удалось загрузить функции по работе с табелем',error);
      abort;
      exit;
    }

   StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak, 'Расчет времени по табелю', recordsInTable(tntmpPersYearFortune));
    _loop tmpPersYearFortune
    {
      If not nextvisual then Break;
      var Imonth           : byte = 1;
//      var DaysVacation     : double = 0;
      var HourVacation     : double = 0;
      var HourBusinessTrip : double = 0;
      var HourWorking      : double = 0;
//      var DaysBusinessTrip : double = 0;
//      var DaysWorking      : double = 0;
      setvisualheader('Расчет времени по табелю за  ' + _mes +' месяцев'+
      +''#13''+ tmpPersYearFortune.Fio);
      for (Imonth:= 1; Imonth<= _mes; Imonth++)
       {

        var _date123456789 : date = date(01,Imonth,_year);
        _date123456789 := date(last_day(_date123456789),Imonth,_year);
        var isPersPremiyainMonth : byte = 0;
        var __cPersons :comp = tmpPersYearFortune.cPersons;
        if tmpPersYearFortune.possiblePersPrem = 1
        _try
        {
          sql
            select top 1
             1
            from GP_KPI_PERS_RAISE PERS_RAISE
            where PERS_RAISE.CPERSONS = :(__cPersons) and
             :(_date123456789) between PERS_RAISE.FRomDATE and case when PERS_RAISE.TODATE = 0 then #date(01,01,2100) else PERS_RAISE.TODATE end

            into (isPersPremiyainMonth)
            ;
        }
        _except else {}

        if isPersPremiyainMonth = 1 then continue;

        _loop Lschet_YearPrem Where ((tmpPersYearFortune.cPersons == Lschet_YearPrem.tPerson))and Lschet_YearPrem.sovm = 0
        if (LoadWorkingTable(Lschet_YearPrem.nrec, Imonth, _year) = 0)
        {
//          var Hours: Double;
          // рабочих часов по факту за месяц
          // Hours := WT_GetHours(hkWorking, stActual);
          // кол-во дней, отработанных в особо вредных условиях
//          DaysWorking := DaysWorking + WT_GetDaysEx(dkWorking, stActual, 0);
          HourWorking := HourWorking + WT_GetHours(hkWorking, stActual);

          if (WT_LoadMonthlyAbsences = 0)
          {

//            LogStrTofile('TestTabel.log', 'WT_LoadMonthlyAbsences = 0)')

            var _iAbsence: integer;
            for (_iAbsence := 0; _iAbsence < WT_GetMonthlyAbsenceCount; Inc(_iAbsence))
            {
              var Notation: comp;
              Notation := 0;
              if not((not WT_GetMonthlyAbsenceAttribute(_iAbsence, aaNotation, Notation))
                  or (Notation = 0))
              {
                  var Hours: double;
//                  var Days: byte;
                  var AbsenceKind: word;
                  Hours := AbsenceKind := 0 ;//Days := 0;
                  WT_GetMonthlyAbsenceAttribute(_iAbsence, aaHours, Hours);
                //  WT_GetMonthlyAbsenceAttribute(_iAbsence, aaDays, Days);
                  WT_GetMonthlyAbsenceAttribute(_iAbsence, aaKind, AbsenceKind);
                   // WT_GetMonthlyAbsenceAttribute(I, aaHours, Hours);
                  case AbsenceKind of
                   akVacation    :
                          {
                            if(getfirst UOWRKTABEL where ((Notation == UOWRKTABEL.NREC))
                                                    and (UOWRKTABEL.NUM = 'ОТ'
                                                      or UOWRKTABEL.NUM = 'ОД'
                                                        )
                              )= tsOK
                             {
                             //  DaysVacation := DaysVacation + Days;
                                 HourVacation := HourVacation + Hours;
                             }
/*
//                            WT_GetMonthlyAbsenceAttribute(I, aaCode, VacationCode);
                            var _Description : string = '';
                            WT_GetMonthlyAbsenceAttribute(I, aaDescription, _Description);
                            if Instr('ОСНОВНОЙ',upcase(_Description)) <> 0 or Instr('ДОПОЛНИТ',upcase(_Description)) <> 0
                             then DaysVacation := DaysVacation + Days;
*/
                          }
//                   akBusinessTrip: DaysBusinessTrip := DaysBusinessTrip + Days;
                     akBusinessTrip: HourBusinessTrip := HourBusinessTrip + Hours;
                  end;
              }
             }
          }
        }
//        LogStrTofile('TestTabel.log', 'cPerson = '+ string(tmpPersYearFortune.cPersons,0,0)+' ' + string(DaysWorking) + ' ' + string(DaysVacation) + ' ' +string(DaysBusinessTrip))
       }
//       var _SumTime : double = (DaysVacation + DaysBusinessTrip + DaysWorking)*tmpPersYearFortune.ProcentFortune;
         var _SumTime : double = (HourVacation + HourBusinessTrip + HourWorking)*tmpPersYearFortune.ProcentFortune;
        update current tmpPersYearFortune set tmpPersYearFortune.SumTime := _SumTime;
        _allTime := _allTime + _SumTime;
     }
   stopVisual;
   StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak, 'Заполнение приказа', recordsInTable(tntmpPersYearFortune));
    var _SummaRaspredFact : double = 0;
    LogStrTofile(_FileLog, 'cPersons;StrTabn;Fio;cAppoint;cLschet;Department;ProcentFortune;SumTime;summa;');

    delete tmpPersYearFortune where tmpPersYearFortune.SumTime = 0;

   _loop tmpPersYearFortune
    {
     if not NextVisual break;
      _npp++;
      var _SummaCur :double = Round(tmpPersYearFortune.SumTime * _SummaRaspred/ _allTime ,0);
      Insert ContDoc set
      	  ContDoc.CPART    := PartDoc.nrec
      	, ContDoc.WREC     := _npp
      	, ContDoc.NUMPART  := 1
      	, ContDoc.TYPEOPER := PartDoc.TYPEOPER
      	, ContDoc.OBJTYPE  := 1
      	, ContDoc.SEQNMB   := 1
      	, ContDoc.CDOPREF  := tmpPersYearFortune.Department // Appointments.Department
      	, ContDoc.PERSON   := tmpPersYearFortune.cPersons   // Persons.nrec
      	, ContDoc.CSTR     := tmpPersYearFortune.cAppoint   // Appointments.nrec
      ;
      insert FORTUNE set
          FORTUNE.CFTYPE   := PartDoc.CREF1
        ,	FORTUNE.DOCNMB   := Titledoc.DOCNMB
        ,	FORTUNE.DOCDATE  := Titledoc.DOCdate
        ,	FORTUNE.DOCSUM   := _summaCur //tmpPersYearFortune.summa
        , FORTUNE.CFCONT   := ContDoc.nrec
        , FORTUNE.WCHOICE  := PartDoc.TYPEOPER
        , FORTUNE.DAT1     := PartDoc.DDAT1
        , FORTUNE.FILIALNO := PartDoc.WINF2
        , FORTUNE.wAttr1   := CheckTypeRaise(PartDoc.cRef1);
      ;
     _SummaRaspredFact := _SummaRaspredFact + _SummaCur;
     LogStrTofile(_FileLog, tmpPersYearFortune.cPersons +';'+tmpPersYearFortune.StrTabn+';'+tmpPersYearFortune.Fio+';'+tmpPersYearFortune.cAppoint+';'+tmpPersYearFortune.cLschet
      +';'+tmpPersYearFortune.Department+';'+tmpPersYearFortune.ProcentFortune+';'+tmpPersYearFortune.SumTime+';'+tmpPersYearFortune.summa);
    }

    LogStrTofile(_FileLog, '');
    LogStrTofile(_FileLog, '');

    LogStrTofile(_FileLog,  ShortStrToWin('К распределению;Распределено;СуммаДней'));
    LogStrTofile(_FileLog, string(_SummaRaspred)+';'+string(_SummaRaspredFact)+';'+string(_allTime));

  stopvisual;
}
function CreatetFilter(_nameMarker: string): boolean;
{
      If Upcase(UserName) = 'LAPUSHKOV_DV'
       {
         LogStrToFile(_logGlobal,'_nameMarker = ' + _nameMarker);
       }

  result := false;
  var strID   : LongInt;  strID   := 0;
  sqlFreeStr(strID);
  strID:=0;
  var Marker_Tmp  : longint =InitMarker(_nameMarker, 8, 50, 10, True);

  sqlAddStr(strID, 'table t'+SubStr(_nameMarker,1,19));
  sqlAddStr(strID, '(');
  sqlAddStr(strID, ' cRec: comp');
  sqlAddStr(strID, ')');
  sqlAddStr(strID, 'with index');
  sqlAddStr(strID, '(');
  sqlAddStr(strID, ' i0 = cRec');
  sqlAddStr(strID, ');');
  sqlDropTmpTable('t'+SubStr(_nameMarker,1,19));

  if sqlCreateTmpTable(strID, ctmNormal) = tsOk
  {
    var _i : longint = 0;
    var _cRec : comp = 0h;
    While(GetMarker(Marker_Tmp,_i,_cRec)=true) DO
    {
      var _directQuery : string = 'INSERT INTO t'+SubStr(_nameMarker,1,19)+' (cRec) VALUES (#comp('+String(_cRec,0,0)+'))';
      var _Err: longint = sqlExecDirect(_directQuery);

      If Upcase(UserName) = 'LAPUSHKOV_DV'
       {
         LogStrToFile(_logGlobal,_directQuery);
         LogStrToFile(_logGlobal,'_Err = ' + string(_Err));
       }
     _i++;
    }
    var _directQuery : string = 'INSERT INTO t'+SubStr(_nameMarker,1,19)+' (cRec) VALUES (#comp(0))';
    result := true;
  }
  DoneMarker(Marker_Tmp,_nameMarker);
}
Window winSetYearFortune 'Параметры расчета годовой премии', doaccept;
show at (,,55,8) ;
 Screen scrYearFortune;
  Fields
   _year         : NoProtect;
   _mes         : NoProtect;
   _SummaRaspred : ['\2p[|-]366`666`666`666`666.88'], NoProtect;
   _typeSelectPersons : NoProtect;
   _FileWithPersons : protect, PickButton;
   _PersExclude : Protect, pickbutton;
  Buttons
  cmOk, Default,, 'Сформировать годовую премия с распределением',, scGalDial;
  cmCancel,,, 'Закрыть окно без формирования премии',, scGalDial;

 <<'Параметры формирования годовой премии'
                      `Год`.@@@@@
         `Учет времени по` .@@ месяц включительно
    `Сумма для распределения`.@@@@@@@@@@@@@@@@@@@
 (.) -производить отбор по условиям положения о премировании`
 (.) -использовать файл со списком  `
`Файл с сотрудниками`.@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Исключить сотрудников из премии`.@@@@@@@@@@@@@@@
    <.Продолжить.>                 <.Отмена.>
 >>
end;
Handleevent
CmInit:
{
   _logGlobal := '_YearFortuneCalc_QUERY_'+ DatetoStr(Cur_Date,'YYYYMMDD')+'_'+TimeToStr(Cur_Time,'HHMMSS')+'.log';
  var _tmpName :string= iGetKau.GetMarkerName(cgKau_Persons);
  var Marker_Tmp  : longint =InitMarker(_tmpName, 8, 50, 10, True);
  clearmarker(Marker_Tmp);
 DoneMarker(Marker_Tmp,_tmpName);
      cfssetprop('L_SCRYEARFORTUNE_Файл_с_сотрудниками', 'Visible',_typeSelectPersons = 1);
      cfssetprop('i_SCRYEARFORTUNE_FileWithPersons'    , 'Visible',_typeSelectPersons = 1);
      cfssetprop('L_SCRYEARFORTUNE_Исключить_сотрудников_из_премии', 'Visible',_typeSelectPersons = 0);
      cfssetprop('i_SCRYEARFORTUNE_PersExclude'                    , 'Visible',_typeSelectPersons = 0);

 _mes := 12;
}
cmOk:
 {
  if _SummaRaspred <=0
   {
    Message('Сумма для распределения должна быть больше 0',error);
    Exit;
   }

   if _FileWithPersons = ''  and _typeSelectPersons = 1
   {
    Message('для режима загрузки из файла надо выбрать файл',error);
    Exit;

   }

    if _mes < 1 or _mes > 12
    then {
      message('Введите месяц между 1 и 12',error)
     }
    else {
      CalcYearFortune;
      Closewindow(winSetYearFortune);
     }
 }
 cmdelonprotect:
 {
   case curfield of
    #_PersExclude:{
         var _tmpName :string= iGetKau.GetMarkerName(cgKau_Persons);
         var Marker_Tmp  : longint =InitMarker(_tmpName, 8, 50, 10, True);
         clearmarker(Marker_Tmp);
          set _PersExclude := '';
         DoneMarker(Marker_Tmp,_tmpName);
     }
   end;
  rereadrecord;
 }
 cmPick:
 {
   case curfield of
    #_PersExclude:{
       if iGetKau.GetCodeKau(cgiMulti,cgKau_Persons,0h)<>cmCancel
       {
         var _tmpName :string= iGetKau.GetMarkerName(cgKau_Persons);
         var Marker_Tmp  : longint =InitMarker(_tmpName, 8, 50, 10, True);
          set _PersExclude := 'Выбрано ' + getmarkercount(Marker_Tmp);
         DoneMarker(Marker_Tmp,_tmpName);
        CreatetFilter(_tmpName);
       }
     }
     #_FileWithPersons:{
        _FileWithPersons := GetFileName('*.xls*','Выбор файла со списком сотрудников');
      }
   end;
  rereadrecord;
 }
end;

end;


Procedure CreateYearFortune;
{

  // годовое премирование по положению П-012-2019
  if PartDoc.TYPEOPER <> 20
   {
    Message('Годовую премию можно формировать только по РПД20',error);
    Exit;
   }
  if getfirst contdoc = tsOK
   {
    Message('В приказе уже есть сотрудники',error);
    Exit;
   }
   _year := year(Titledoc.DOCdate);
   isCalcFortune := false;
    RunWindowModal(winSetYearFortune)

}
//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table PartDoc;
cmUpdateRecord:
{ if  inherited :: handleEvent (cmUpdateRecord)=heAbort then Abort;
  Update current PartDoc;
}
cmCheckField:
{ if  inherited :: handleEvent (cmCheckField)=heAbort then Abort;
  case CurField of
  #PartDoc.DDat1:
  { if IsValidAll(#ContDoc)
    if message('Обновить дату назначения выплаты во всем приказе?',YesNo)=cmYes
    {  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfScreenBottom, 'Установка значений..', pMarker.Count);
       _Loop ContDoc_Scan
       { if not NextVisual break;
         if getfirst Fortune_Scan<>tsok
         { InsFortune_Scan;
         }
         else
         { Fortune_Scan.Dat1:=PartDoc.dDat1;
           update current Fortune_Scan;
         }
       } //   _Loop ContDoc_Scan
       StopVisual('',0);
       ReReadRecord(#ContDoc);
       ReReadRecord(#Fortune);
    }
  }
  #PartDoc.WINF2: //#1442
  { if IsValidAll(#ContDoc)
    if message('Обновить признак выплаты во всем приказе?',YesNo)=cmYes
    {  StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfScreenBottom, 'Установка значений..', pMarker.Count);
       _Loop ContDoc_Scan
       { if not NextVisual break;
         if getfirst Fortune_Scan<>tsok
         { InsFortune_Scan;
         }
         else
         { Fortune_Scan.FilialNo:= PartDoc.WINF2;
           update current Fortune_Scan;
         }
       } //   _Loop ContDoc_Scan
       StopVisual('',0);
       ReReadRecord(#ContDoc);
       ReReadRecord(#Fortune);
    }
  }
  end;
}
end;//TableEvent table PartDoc

TableEvent table ContDoc;
cmDeleteRecord:
{ if  inherited :: handleEvent (cmDeleteRecord)=heAbort then Abort;
  ReScanPanel(#PartDoc); // пересчитать сумму
}
cmSetDefault:
{ if  inherited :: handleEvent (cmSetDefault)=heAbort then Abort;
  ClearBuffer(tnFortune);

}
cmInsertRecord:
{ if  inherited :: handleEvent (cmInsertRecord)=heAbort then Abort;
  MakeValidForTune;
  ReScanPanel(#Fortune);
}
cmCheckField:
{
  if  inherited :: handleEvent (cmCheckField)=heAbort then Abort;
  MakeValidFortune;
  case CurField of
  #FORTUNE.DOCSUM:
  { MakeValidFortune;
    update current Fortune;
    ReScanPanel(#PartDoc); // пересчитать сумму
    ReScanPanel(#Fortune);
  }
  end;
}
end;//TableEvent table ContDoc

TableEvent table FORTUNE;
cmCheckField:
{
  if  inherited :: handleEvent (cmCheckField)=heAbort then Abort;
  case CurField of
  #FORTUNE.DOCSUM:
  { ReScanPanel(#PartDoc); // пересчитать сумму
  }
  end;
  SetMFiledValueMark(CurField);
}
cmSetDefault:
{ if  inherited :: handleEvent (cmSetDefault)=heAbort then Abort;
  Fortune.wChoice := 20;
  Fortune.cFType   := PartDoc.cRef1;
  Fortune.wAttr1   := CheckTypeRaise(PartDoc.cRef1);
  set Fortune.FilialNo := PartDoc.WINF2;// #1442
  set FORTUNE.DAT1 := PartDoc.dDat1;
}
end;//TableEvent table FORTUNE

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    cmValue59:
    {
     CreateYearFortune;
     rereadrecord;
    }
    cmOpenSearch :
    {
      if TitleDoc.wStatus=1
         abort;
      isOpenSearch:= true;
      ProcessCommand(cmPick);
      isOpenSearch:= false;
    }
  cmCheckField:
  {
  if  inherited :: handleEvent (cmCheckField)=heAbort then Abort;
    case curfield of
    #_typeSelectPersons:
     {
      cfssetprop('L_SCRYEARFORTUNE_Файл_с_сотрудниками', 'Visible',_typeSelectPersons = 1);
      cfssetprop('i_SCRYEARFORTUNE_FileWithPersons'    , 'Visible',_typeSelectPersons = 1);
      cfssetprop('L_SCRYEARFORTUNE_Исключить_сотрудников_из_премии', 'Visible',_typeSelectPersons = 0);
      cfssetprop('i_SCRYEARFORTUNE_PersExclude'                    , 'Visible',_typeSelectPersons = 0);
     }
    end;

  }
    cmPick:
    {

       if  inherited :: handleEvent (cmPick)=heAbort then Abort;
       MyPick(CurField);
    }
    cmDelOnProtect:
    {  if  inherited :: handleEvent (cmDelOnProtect)=heAbort then Abort;
       MyDelOnProtect(CurField);
    }
    cmOnVipUnload:
    { if  inherited :: handleEvent (cmOnVipUnload)=heAbort then Abort;
      DoneMarker(MarkerTmp,'')

    }

    cmOnVipLoad:
    {  if  inherited :: handleEvent (cmOnVipLoad)=heAbort then Abort;
       ATTR_ZAKAZ_P:=ExtAttr_CreateComp(coPartDoc,'Заказ', cgAttrType_Comp, word(0), cgKau_Zakaz );///Производственные заказы
       ATTR_ZAKAZ_C:=ExtAttr_CreateComp(coContDoc,'Заказ', cgAttrType_Comp, word(0), cgKau_Zakaz );///Производственные заказы
       MarkerTmp:=InitMarker('', 8, 100, 10 );
       if (vSpr.getfirst katkau<>tsok)
       {  message('Не нашли пользовательскую аналитику "Проект"');
       }
       else
       {
         KAU_PROJECT:=vSpr.katkau.KODGROUP;
         ATTR_PROJECT_P:=ExtAttr_CreateComp(coPartDoc,'Проект', cgAttrType_Comp, word(0), KAU_PROJECT );
         ATTR_PROJECT_C:=ExtAttr_CreateComp(coContDoc,'Проект', cgAttrType_Comp, word(0), KAU_PROJECT );

       }
       pMarker.IsNeedCheckDelete := false;

    }
  end;
END.
