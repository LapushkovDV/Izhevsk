//******************************************************************************\
// Подсчет сумм
//******************************************************************************
Function CalcSumma(_Nrec:comp) :double;
{ Result:=if(Fortune.wAttr1=0,FORTUNE.DOCSUM,0);
  if _Nrec=0 then Exit;
  _Loop fullcache ContDoc_Scan
  {  if ContDoc.Nrec = ContDoc_Scan.Nrec then continue;
     Result:=Result + if(Fortune_Scan.wAttr1=0,FORTUNE_Scan.DOCSUM,0);
  } //_Loop fullcach ContDoc_Scan
} //Function CalcSumma(_Nrec:comp) :double;\


//******************************************************************************\
// Установить значения полей
//******************************************************************************
Procedure SetMFiledValueMark(_field:longint );
var fTmp :double=0;
    dTmp:date=date(0,0,0);
    wTmp:word=0;
{ if pMarker.Count=0 exit;
  case _Field of
   #MNPLAN_C.NUMBER  //'Код заказа'
  ,#MNPLAN_C.NAME   ://'Заказ, наименование'
  { pTmp:=pZAKAZ_C;
  }
   #SPKAU_C.Code    //'Проект, код'
  ,#SpKau_C.NAME   ://'Проект, наименование'
   {
     pTmp:=pZAKAZ_C;
   }
   #FORTRAISECAT.NAME:
   { pTmp:=Fortune.cFType;
   }
   #FortForRaiseCat.Name:
   { pTmp:=Fortune.cRef1;
   }
   #FortuneDocName.Name:
   { pTmp:=Fortune.cRef2;
   }
   #FORTUNE.DOCSUM:
   { fTmp:=FORTUNE.DOCSUM;
    wTmp:=Fortune.wAttr1;
   }
   #FORTUNE.DAT1:
   { dTmp:=FORTUNE.DAT1;
   }
   #FORTUNE.FILIALNO:
   { wTmp:=FORTUNE.FILIALNO
   }
   else exit;
   end;
   //--------------------
   if message('Скопировать выбранные значения'
     +chr(13)+'отобранным сотрудникам?', YesNo) <> cmYes
   { Exit;
   }
   //--------------------

   StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfScreenBottom, 'Установка значений..', pMarker.Count);

   _Loop ContDoc_Scan
   { if ContDoc_Scan.Nrec=ContDoc.Nrec then continue;
     if ( getfirst pMarker where ((ContDoc_Scan.Nrec == pMarker.pNRec)) <> tsOK )
               continue;
     if not NextVisual break;
     if getfirst Fortune_Scan<>tsok
     { clearbuffer(#Fortune_Scan);
       Fortune_Scan.cFCont  := ContDoc_Scan.nRec;
       Fortune_Scan.DocDate := TitleDoc.DocDate;
       Fortune_Scan.DocNmb  := TitleDoc.DocNmb;
       Fortune_Scan.wChoice := 20;
       insert current Fortune_Scan;

     }
     case _Field of
     #MNPLAN_C.NUMBER  //'Код заказа'
     ,#MNPLAN_C.NAME   ://'Заказ, наименование'
     { //pTmp:=pZAKAZ_C
       coSetAttrID(coContDoc,ContDoc_Scan.Nrec,ATTR_ZAKAZ_C,pTmp, #ShowKau(cgKau_Zakaz, pTmp)   )
     }
     #SPKAU_C.Code    //'Проект, код'
     ,#SpKau_C.NAME   ://'Проект, наименование'
     {
       coSetAttrID(coContDoc,ContDoc_Scan.Nrec,ATTR_PROJECT_C,pTmp, #ShowKau(KAU_PROJECT, pTmp)   )
     }
     #FORTRAISECAT.NAME:
     { Update current Fortune_Scan Set Fortune_Scan.cFType:=pTmp;
     }
     #FortForRaiseCat.Name:
     { Update current Fortune_Scan Set Fortune_Scan.cRef1:=pTmp;
     }
     #FortuneDocName.Name:
     { Update current Fortune_Scan Set Fortune_Scan.cRef2:=pTmp;
     }
     #FORTUNE.DOCSUM:
     { Update current Fortune_Scan Set Fortune_Scan.DOCSUM:=fTmp, Fortune_Scan.wAttr1:=wTmp;
     }
     #FORTUNE.DAT1:
     { Update current Fortune_Scan Set Fortune_Scan.DAT1:=dTmp;
     }
     #FORTUNE.FILIALNO:
     { Update current Fortune_Scan Set Fortune_Scan.FILIALNO:=wTmp;
     }
     end;

   } //_Loop ContDoc_Scan
   StopVisual('',0);
   ReScanPanel(#ContDoc)
} //Procedure SetMFiledValueMark;

Procedure MakeValidFortune;
var ww_nrec:comp;
{  ww_nrec:=0;
   ww_nrec:=Fortune.Nrec;
   if ww_nrec=0
   { //ClearBuffer(tnFortune);
     Fortune.cFCont  := ContDoc.nRec;
     Fortune.DocDate := TitleDoc.DocDate;
     Fortune.DocNmb  := TitleDoc.DocNmb;
     Fortune.cFType  := PartDoc.cRef1;
     Fortune.wAttr1  := CheckTypeRaise(PartDoc.cRef1);
     Fortune.Dat1    := PartDoc.DDat1;
     Fortune.FilialNo:= PartDoc.WINF2;//#1442
     Fortune.wChoice := 20;
     insert current Fortune;
   }
   else
   { update current ForTune;
   }
} //Procedure MakeValidFortune;



//******************************************************************************\
// Выбор полей
//******************************************************************************
Function MyPick(_field:longint ) :boolean;
{   Result:=false;
    if TitleDoc.wStatus=1
    {  Message('Приказ утвержден!');
       exit;
    }

    ClearMarker(MarkerTmp);
    var _cgi:word;
    _cgi := if (not isOpenSearch, cgiPick + cgiNotClear, cgiPick);
    var IsNeedCopy:boolean=false;
    //Message(QuickChoiceName)

    case _Field of
    // #MNPLAN_C.NUMBER  //'Код заказа'
    //,#MNPLAN.NUMBER  //'Код заказа'
     #SPKAU.Name    //'Проект, код'
    ,#SPKAU_C.Name    //'Проект, код'
    :
    { //Доработка  KBU\F_GetAn_GtKodGroup.Vip

      if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed_Name';
    }
    else
    {
      if (QuickChoiceName <> '')  QuickChoiceName := 'qcKau_Needed';//qcByName';
    }
    end;
    case _Field of
    #MNPLAN_C.NUMBER  //'Код заказа'
   ,#MNPLAN_C.NAME   ://'Заказ, наименование'
    { pTmp:=pZAKAZ_C;
      if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
      { coSetAttrID(coContDoc,ContDoc.Nrec,ATTR_ZAKAZ_C,pTmp, #ShowKau(cgKau_Zakaz, pTmp)   );
        IsNeedCopy:=true
      }
      ReScanPanel(#ContDoc)
    }
    #MNPLAN.NUMBER  //'Код заказа'
   ,#MNPLAN.NAME   ://'Заказ, наименование'
    { pTmp:=pZAKAZ_P;
      if iGetKau.GetCodeKau(cgiPick, cgKau_Zakaz, pTmp)<>0 //cmCancel
      { coSetAttrID(coPartDoc,PartDoc.Nrec,ATTR_ZAKAZ_P,pTmp, #ShowKau(cgKau_Zakaz, pTmp)   );
        if getfirst MnPlan=tsok {}
      }
      ReScanPanel(#PartDoc)
    }
    #SPKAU_C.Code    //'Проект, код'
   ,#SpKau_C.NAME   ://'Проект, наименование'
    {
      pTmp:=pZAKAZ_C;
      //InsertMarker(MarkerTmp,pTmp)
      //if iGetKau.GetCodeKau(cgiPick, KAU_PROJECT, pTmp)<>0 //cmCancel
      if RunInterface(F_GetAn::GtKodGroup,cgiPick,KAU_PROJECT, pTmp,MarkerTmp,KAU_PROJECT)<>cmCancel
      { coSetAttrID(coContDoc,ContDoc.Nrec,ATTR_PROJECT_C,pTmp, #ShowKau(KAU_PROJECT, pTmp)   );
        IsNeedCopy:=true

      }
      ReScanPanel(#ContDoc)
    }
    #SPKAU.Code    //'Проект, код'
   ,#SpKau.NAME   ://'Проект, наименование'
    {
      pTmp:=pZAKAZ_P;
      if iGetKau.GetCodeKau(cgiPick, KAU_PROJECT, pTmp)<>0 //cmCancel
      { coSetAttrID(coPartDoc,PartDoc.Nrec,ATTR_PROJECT_P,pTmp, #ShowKau(KAU_PROJECT, pTmp)   );
        ReScanPanel(#PartDoc) ;
        if getfirst SpKau=tsok {};
      }
    }
    #CurrNameFort:// ('Валюта или проценты.',, sci1378Esc) ,Protect;
    { Set Fortune.DocSum:=Fortune.DocSum;
      MakeValidFortune;
      update current Fortune;
      ReScanPanel(#PartDoc); // пересчитать сумму
      ReScanPanel(#Fortune);
    }
    #FortRaiseCat_P.Name:
    {
      ParentSav := PartDoc.cRef1;
      if (RunInterface(PickCatalog2, iFortRaiseSysCode, ParentSav, 0) = cmDefault)
      { //PreviousType := Fortune.cFType; // взвести флаг того, что поменяли наименование
        set PartDoc.cRef1 := ParentSav;
        //set Fortune.wAttr1 := CheckTypeRaise(ParentSav);
        if message('Заменить вид доплаты во всем приказе?',YesNo)=cmYes
        { StartNewVisual(vtIndicatorVisual, vfTimer+vfBreak+vfScreenBottom, 'Установка значений..', pMarker.Count);
          _Loop ContDoc_Scan
          {
            if not NextVisual break;
            if getfirst Fortune_Scan<>tsok
            { clearbuffer(#Fortune_Scan);
              Fortune_Scan.cFCont  := ContDoc_Scan.nRec;
              Fortune_Scan.DocDate := TitleDoc.DocDate;
              Fortune_Scan.DocNmb  := TitleDoc.DocNmb;
              Fortune_Scan.cFType  := PartDoc.cRef1;
              Fortune_Scan.wAttr1  := CheckTypeRaise(PartDoc.cRef1);
              Fortune_Scan.Dat1    :=PartDoc.DDat1;
              Fortune_Scan.FilialNo:= PartDoc.WINF2;
              Fortune_Scan.wChoice := 20;
              insert current Fortune_Scan;
            }
            else
            { Fortune_Scan.cFType  := PartDoc.cRef1;
              Fortune_Scan.wAttr1  := CheckTypeRaise(PartDoc.cRef1);
              Fortune_Scan.FilialNo:= PartDoc.WINF2;
              Fortune_Scan.wChoice := 20;
              update current Fortune_Scan;

            }
          } //   _Loop ContDoc_Scan
          ReReadRecord(#ContDoc);
          ReReadRecord(#Fortune);
          StopVisual('',0);
        } //if message('Заменить вид доплаты во всем приказе?',YesNo)=cmYes
      } //if (RunInterface(PickCatalog2, iFortRaiseSysCode, ParentSav, 0) = cmDefault)
    } //#FortRaiseCat_P.Name:

    end;
    Result:=true;
    SetMFiledValueMark(_field)
} //Function MyPick(_field:longint ) :boolean;

//******************************************************************************\
// Выбор полей
//******************************************************************************
Function MyDelOnProtect(_field:longint ) :boolean;
{   Result:=false;
    if TitleDoc.wStatus=1
    {  Message('Приказ утвержден!');
       exit;
    }

    ClearMarker(MarkerTmp);
    var IsNeedCopy:boolean=false;
    case _Field of
    #MNPLAN_C.NUMBER  //'Код заказа'
   ,#MNPLAN_C.NAME   ://'Заказ, наименование'
    { pTmp:=0;
      coSetAttrID(coContDoc,ContDoc.Nrec,ATTR_ZAKAZ_C,pTmp, #ShowKau(cgKau_Zakaz, pTmp)   );
      IsNeedCopy:=true;
      ReScanPanel(#ContDoc)
    }
    #MNPLAN.NUMBER  //'Код заказа'
   ,#MNPLAN.NAME   ://'Заказ, наименование'
    { pTmp:=0;
      coSetAttrID(coPartDoc,PartDoc.Nrec,ATTR_ZAKAZ_P,pTmp, #ShowKau(cgKau_Zakaz, pTmp)   );
      ReScanPanel(#PartDoc)
    }
    #SPKAU_C.Code    //'Проект, код'
   ,#SpKau_C.NAME   ://'Проект, наименование'
    {
      pTmp:=0;
      coSetAttrID(coContDoc,ContDoc.Nrec,ATTR_PROJECT_C,pTmp, #ShowKau(KAU_PROJECT, pTmp)   );
      IsNeedCopy:=true;
      ReScanPanel(#ContDoc)
    }
    #SPKAU.Code    //'Проект, код'
   ,#SpKau.NAME   ://'Проект, наименование'
    {
      pTmp:=0;
      coSetAttrID(coPartDoc,PartDoc.Nrec,ATTR_PROJECT_P,pTmp, #ShowKau(KAU_PROJECT, pTmp)   );
      if getfirst SpKau=tsok {};
      ReScanPanel(#PartDoc) ;
    }
    end;
    Result:=true;
    SetMFiledValueMark(_field)
} //Function MyDelOnProtect(_field:longint ) :boolean;



//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
procedure EnableDisable_Dop;
{
  if fnFieldsOpen
  {
    SetFieldOption(#SPKAU.Code     , ofSelectable);
    SetFieldOption(#SPKAU.Name     , ofSelectable);
    SetFieldOption(#SPKAU_C.Code   , ofSelectable);
    SetFieldOption(#SPKAU_c.Name   , ofSelectable);
    SetFieldOption(#MNPLAN.NUMBER  , ofSelectable);
    SetFieldOption(#MNPLAN.Name    , ofSelectable);
    SetFieldOption(#MNPLAN_C.NUMBER, ofSelectable);
    SetFieldOption(#MNPLAN_c.Name  , ofSelectable);
  }
  else
  { ClearFieldOption(#SPKAU.Code     , ofSelectable);
    ClearFieldOption(#SPKAU.Name     , ofSelectable);
    ClearFieldOption(#SPKAU_C.Code   , ofSelectable);
    ClearFieldOption(#SPKAU_c.Name   , ofSelectable);
    ClearFieldOption(#MNPLAN.NUMBER  , ofSelectable);
    ClearFieldOption(#MNPLAN.Name    , ofSelectable);
    ClearFieldOption(#MNPLAN_C.NUMBER, ofSelectable);
    ClearFieldOption(#MNPLAN_c.Name  , ofSelectable);

  }
}//procedure EnableDisable_Dop;

