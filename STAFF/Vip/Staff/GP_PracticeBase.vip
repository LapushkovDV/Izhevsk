/**************************************************************************************************\
* Наименование: Форма "База регистрации практик"                                                  *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Отчеты / Отчеты пользователя / Обучение и развитие персонала / База регистрации     *
*             практик                                                                             *
* Форма формируется на основании утвержденных приказов с распорядительным действием № 201 "Прием  *
* на практику" за указанный период (отбор ведётся по полю "Дата начала"), при этом выбираются     *
* только приказы с характером назначения "Практика" и заполненным полем "Руководитель стажировки".*
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#336          |18/05/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/
// Добавить условие - обрабатывать только отвержденные приказы

#include GP_Log.vih // Объектный интерфейс для вывода протокола
#include CatFunc.vih // Функции работы с каталогом
#include StrFunc.vih // Функции работы со строками
#include GP_StrFunc.vih // Функции работы со строками

interface GP_PracticeBase 'База регистрации практик' EscClose;

  const
    REP_NAME = 'GP_PracticeBase'; // Название отчёта
    REP_TITLE = 'База регистрации практик'; // Заголовок отчёта
    TAB_CNT = 1; // Количество закладок в отчёте
    TAB_TITLE_1 = 'Отчёт'; // Название закладки 2
    EXT_ATTR_TARG_EDUC = 'Договор на целевое обучение'; // Название внешнего атрибута к таблице Education для определения целевиков
    // Константы ошибок при работе с Excel
    XE_BAD_OP           =  0; // не удалось выполнить операцию с Excel-файлом
    XE_CREATE_FILE      =  1; // не удалось создать файл
    XE_OPEN_FILE        =  2; // не удалось открыть файл
    XE_INIT_FILE        =  3; // не удалось инициализировать Excel
    XE_CREATE_MATRIX    =  4; // не удалось создать матрицу
    XE_FREE_MATRIX      =  5; // не удалось освободить матрицу
    XE_OUT_MATRIX       =  6; // не удалось вывести матрицу в отчёт
    XE_WRITE_TO_MATRIX  =  7; // не удалось записать значение в матрицу
    XE_FORMAT_CELL      =  8; // не удалось отформатировать ячейку
    XE_SET_CELL_VALUE   =  9; // не удалось записать значение в ячейку
    XE_SET_CELL_FORMULA = 10; // не удалось записать формулу
    XE_RUN_MACRO        = 11; // не удалось запустить макрос
    XE_ADD_SHEET        = 12; // не удалось добавить вкладку
    XE_DEL_SHEET        = 13; // не удалось удалить вкладку
    XE_RENAME_SHEET     = 14; // не удалось переименовать вкладку
    XE_WRONG_TEMPLATE   = 15; // в xlt шаблоне не найден лист с именем
  end;

  // Чтобы иметь возможность сортировать данные в отчёте используем дополнительную таблицу с индексом
  table struct SData
  (
    cContDoc: tNRec,       // Ссылка на таблицу ContDoc
    cPerson: tNRec,        // Ссылка на таблицу Persons
    FIO: String[60],       // ФИО
    DateFrom: Date,        // Дата начала практики
    DateTo: Date,          // Дата окончания практики
    OrderNum: String[20],  // Номер приказа
    OrderDate: Date,       // Дата приказа
    cSpeciality: tNRec     // Специальность
  )
  With index
  (
    SData01 = FIO
  );

  create view
    var
      pDBeg, pDEnd: Date; // Отчётный период
    from
      SData (SData01),
      GP_SpContDoc201,
      ContDoc,
      TitleDoc,
      Persons,
      Catalogs,
      Education,
      Communications (ComByPerson),
      synonym ContDoc ContDocI,
      synonym Persons PersonsI,
      synonym Persons PersonsM,
      synonym Appointments AppointmentsI
    where ((
          SData.cContDoc           == ContDoc.NRec
      and SData.cPerson            == Persons.NRec
      and ContDoc.Person           == PersonsM.NRec
      and ContDoc.cStr             == Appointments.NRec
      // Таблицы для построения индекса
      and GP_SpContDoc201.cContDoc == ContDocI.NRec
      and ContDocI.cPart           == PartDoc.NRec
      and GP_SpContDoc201.cPerson  == PersonsI.NRec
      and PartDoc.cDoc             == TitleDoc.NRec
      and ContDocI.cStr            == AppointmentsI.NRec
    ))
  ;

  var
    IsAborted: Boolean;
    ICatFunc: CatalogsFunctions;
    oExtAttr: IExtAttr;
    // Переменные для работы с Excel
    RecCnt: LongInt; // Количество строк в отчёте
    FirstCol: LongInt; // Номер первой колонки отчёта
    LastCol: LongInt; // Номер последней колонки отчёта
    FirstHeadRow: LongInt; // Номер первой строки отчёта
    FirstBodyRow: LongInt; // Номер первой строки тела отчёта
    LastBodyRow: LongInt; // Номер последней строки отчёта

  #include StrFunc.var
  #include GP_StrFunc.var
  #include GP_Log.var

  window winParam 'База регистрации практик' DoAccept, EscClose, Gray;
    show at (,, 39, 5);

    screen scrParam ('',, sci1EnEsc);
    fields
      pDBeg ('Дата начала отчетного периода'): noProtect;
      pDEnd ('Дата окончания отчетного периода'): noProtect;
    buttons
      cmOk,,, 'Ввод - принять выбор',,sci1Esc;
      cmCancel,,, 'Отмена',,sci1Esc;
    <<

`Период с`.@@@@@@@@@@`по`.@@@@@@@@@@@

     <.  ~O~K  .> <.О~т~мена.>
    >>
    end;

    handleEvent
      cmOk:
        PutCommand(cmDefault);
      cmDefault:
        if pDBeg > pDEnd then
        begin
          Message('Дата начала периода должна быть'#13'меньше даты окончания периода');
          abort;
        end;
    end;
  end;

  // инициализация параметров отчета
  function InitParam: Boolean;
  begin
    if not ReadMyDsk(pDBeg, REP_NAME + 'pDBeg', false) then
    begin
      pDBeg := Cur_Date;
      pDBeg := To_Date(1, Month(pDBeg), Year(pDBeg));
    end;
    if not ReadMyDsk(pDEnd, REP_NAME + 'pDEnd', false) then
    begin
      pDEnd := Cur_Date;
      pDEnd := To_Date(Last_Day(pDEnd), Month(pDEnd), Year(pDEnd));
    end;
    result := true;
  end;

  // сохранение параметров отчета
  procedure SaveParam;
  begin
    SaveMyDsk(pDBeg, REP_NAME + 'pDBeg');
    SaveMyDsk(pDEnd, REP_NAME + 'pDEnd');
  end;

  // установка параметров отчета
  function AskParam: Boolean;
  begin
    result := false;
    if not InitParam then
      Exit;
    if RunWindowModal(winParam) = cmDefault then
    begin
      SaveParam;
      result := true;
    end;
  end;

  //------------------------------------------------------------------------------------------------------------------------------

  // Исключение для генерации ошибок, связанных с выводом в Excel файл
  exception ExOnExecelError;

  // Генерирует ошибку, связанную с выводом в Excel файл
  procedure ExcelError(ErrCode: Word; AddInfo: String);
  var
    ErrText: String;
  begin
    case ErrCode of
      XE_BAD_OP:
        ErrText := 'не удалось выполнить операцию с Excel-файлом';
      XE_CREATE_FILE:
        ErrText := 'не удалось создать файл';
      XE_OPEN_FILE:
        ErrText := 'не удалось открыть файл';
      XE_INIT_FILE:
        ErrText := 'не удалось инициализировать Excel';
      XE_CREATE_MATRIX:
        ErrText := 'не удалось создать матрицу';
      XE_OUT_MATRIX:
        ErrText := 'не удалось вывести матрицу в отчёт';
      XE_WRITE_TO_MATRIX:
        ErrText := 'не удалось записать значение в матрицу';
      XE_WRONG_TEMPLATE:
        ErrText := 'в xlt шаблоне не найден лист с именем';
      XE_FORMAT_CELL:
        ErrText := 'не удалось отформатировать ячейку';
      XE_SET_CELL_VALUE:
        ErrText := 'не удалось записать значение в ячейку';
      XE_RUN_MACRO:
        ErrText := 'не удалось запустить макрос';
      XE_ADD_SHEET:
        ErrText := 'не удалось добавить вкладку';
      XE_DEL_SHEET:
        ErrText := 'не удалось удалить вкладку';
      XE_RENAME_SHEET:
        ErrText := 'не удалось переименовать вкладку';
      XE_FREE_MATRIX:
        ErrText := 'не удалось освободить матрицу';
      XE_SET_CELL_FORMULA:
        ErrText := 'не удалось записать формулу';
    else
      ErrText := '';
    end;
    oGP_Log.Error(ErrText + ' ' + AddInfo);
    _raise ExOnExecelError;
  end;

  // Эта Функция делает более удобной проверку результата операции с Excel
  // Первым параметром передаем функцию, которая работает с Excel, а вторым и третьим - информацию об ошибке,
  // которая будет выведена, если эта функция вернёт false (т.е. выполнится с ошибкой)
  procedure xlOp(IsCorrect: Boolean; ErrCode: Word; AddInfo: String);
  begin
    if not IsCorrect then
      ExcelError(ErrCode, AddInfo);
  end;

  // Создаёт Excel файл и создаёт в нём вкладки для вывода отчёта
  procedure PrepareExcelFile(OutFileName: String);
  var
    TabCnt: Word;
  begin
    if ExistFile(OutFileName) then
      DeleteFile(OutFileName);
    SetVisualHeader('Создание Excel-файла...');
    // Создаем файл Excel
    xlOp(xlCreateExcel(OutFileName, True), XE_CREATE_FILE, OutFileName);
    xlOp(xlIsExcelValid, XE_INIT_FILE, '');
    // Переименуем вкладки
    // Если в отчете меньше вкладок, чем нам нужно добавим недостающие
    TabCnt := 0;
    xlOp(xlGetSheetsCount(TabCnt), XE_ADD_SHEET, '');
    while TabCnt < TAB_CNT do
    begin
      xlOp(xlAddSheet, 11, '');
      TabCnt++;
    end;
    // Если в больше вкладок, чем нам нужно, удалим лишние
    while TabCnt > TAB_CNT do
    begin
      xlOp(xlDeleteSheet(1), XE_DEL_SHEET, '');
      TabCnt--;
    end;
    // Переименуем вкладки
    xlOp(xlSetSheetName(1, TAB_TITLE_1), XE_RENAME_SHEET, '');
  end;

  procedure OutTitle(var R: LongInt);
  begin
    // Выводим заголовок
    xlOp(xlSetCellStringValue(REP_TITLE + ' за период с ' + DateToStr(pDBeg, 'DD.MM.YYYY') + ' по ' + DatetoStr(pDEnd, 'DD.MM.YYYY'), R, 1, R, 1), XE_SET_CELL_VALUE, '');
    // сделаем его жирным
    xlOp(xlSetFontStyle(xlBold, R, 1, R, 1), XE_FORMAT_CELL, '');
    // и крупным
    xlOp(xlSetFontSize(14, R, 1, R, 1), XE_FORMAT_CELL, '');
    R++;
  end;

  // Вывод шапки отчёта
  procedure OutHeader(var R: LongInt);
  var
    C: Word;
  begin
    SetVisualHeader('Форматирование Excel-файла...');
    FirstCol := 1;

    C := FirstCol - 1;
    // №
    xlOp(xlSetCellStringValue('№', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(6, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // ФИО
    xlOp(xlSetCellStringValue('ФИО', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(35, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlLeft, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Целевики
    xlOp(xlSetCellStringValue('Целевики', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetFontColor(0000FFh, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlSetColumnWidth(35, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlLeft, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Приказ
    xlOp(xlSetCellStringValue('Приказ', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(25, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlLeft, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Вид практики
    xlOp(xlSetCellStringValue('Вид практики', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(30, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlLeft, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Подр.
    xlOp(xlSetCellStringValue('Подр.', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(8, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Руководитель
    xlOp(xlSetCellStringValue('Руководитель', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(35, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlLeft, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Период с
    xlOp(xlSetCellStringValue('Период с', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // по
    xlOp(xlSetCellStringValue('по', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Учебное заведение
    xlOp(xlSetCellStringValue('Учебное заведение', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(30, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlLeft, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Количество
    xlOp(xlSetCellStringValue('Количество', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Шифр специальности
    xlOp(xlSetCellStringValue('Шифр специальности', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(15, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Специальность
    xlOp(xlSetCellStringValue('Специальность', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(65, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlLeft, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Индивидуальное задание
    xlOp(xlSetCellStringValue('Индивидуальное задание', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(17, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Лист оценки
    xlOp(xlSetCellStringValue('Лист оценки', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(15, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Оплата руководителю
    xlOp(xlSetCellStringValue('Оплата руководителю', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(22, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlLeft, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Договор со студентом
    xlOp(xlSetCellStringValue('Договор со студентом', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(15, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Курс
    xlOp(xlSetCellStringValue('Курс', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(8, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Остались на стажировку
    xlOp(xlSetCellStringValue('Остались на стажировку', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(11, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // IQ
    xlOp(xlSetCellStringValue('IQ', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(8, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Дальнейшее прохождение практики студентом (мнение)
    xlOp(xlSetCellStringValue('Дальнейшее прохождение практики студентом (мнение)', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(15, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Мнение руководителя по зачислению в штат
    xlOp(xlSetCellStringValue('Мнение руководителя по зачислению в штат', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(15, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Общий балл
    xlOp(xlSetCellStringValue('Общий балл', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(8, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Пришел бы снова на практику
    xlOp(xlSetCellStringValue('Пришел бы снова на практику', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(10, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Хотел бы студент снова работать на предприятии
    xlOp(xlSetCellStringValue('Хотел бы студент снова работать на предприятии', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(15, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Общее мнение студента о практике
    xlOp(xlSetCellStringValue('Общее мнение студента о практике', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(10, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Дата трудо-устройства
    xlOp(xlSetCellStringValue('Дата трудо-устройства', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(12, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlCenter, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');
    // Контакт. тел.
    xlOp(xlSetCellStringValue('Контакт. тел.', R, ++C, R, C), XE_SET_CELL_VALUE, '');
    xlOp(xlSetColumnWidth(45, R, C, R, C), XE_FORMAT_CELL, '');
    xlOp(xlAlignCellsEx(xlLeft, xlTop, FirstHeadRow, C, LastBodyRow, C), XE_FORMAT_CELL, '');

    LastCol := C;

    // Выравниваем содержимое ячеек шапки по верхнему краю и по центру
    xlOp(xlAlignCellsEx(xlCenter, xlTop, R, FirstCol, R, LastCol), XE_FORMAT_CELL, '');
    // Делаем шрифт шапки жирным
    xlOp(xlSetFontStyle(xlBold, R, FirstCol, R, LastCol), XE_FORMAT_CELL, '');;

    // Для всех ячеек в шапке включаем перенос слов
    // xlOp(xlWrapText(R, FirstCol, R, LastCol), XE_FORMAT_CELL, '');
    // Устанавливаем текстовый формат для всех ячеек шапки
    xlOp(xlSetNumberFormat('@', R, FirstCol, R, LastCol), XE_FORMAT_CELL, '');
    // Увеличиваем высоту шапки
    xlOp(xlSetRowHeight(75, R, FirstCol, R, LastCol), XE_FORMAT_CELL, '');

    // Для всех ячеек в форме включаем перенос слов
    xlOp(xlWrapText(R, FirstCol, LastBodyRow, LastCol), XE_FORMAT_CELL, '');
    // Рисуем границы ячеек для всей формы
    xlOp(xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB + xlInsideV + xlInsideH, xlThin, 0, 0, R, FirstCol, LastBodyRow, LastCol), XE_FORMAT_CELL, '');

    R += 1;
  end;

  // Возращает контактные телефоны по указанной карточке сотрудника
  function GetPhoneNumbers(_cPersons: tNRec): String;
  var
    CurNum: String;
  begin
    result := '';
    _loop Communications where ((_cPersons == Communications.Person))
    begin
      CurNum := '';
      if getFirst Catalogs where ((Communications.ComType == Catalogs.NRec)) = tsOk then
      begin
        case Catalogs.SysCode of
          67: CurNum := 'раб. ' + Communications.Addr; // Рабочий
          66: CurNum := 'дом. ' + Communications.Addr; // Домашний
          71: CurNum := 'моб. ' + Communications.Addr; // Мобильный
        end;
      end;
      if CurNum != '' then
      begin
        if result != '' then
          result += ', ';
        result += CurNum;
      end;
    end;
  end;

  // Возращает дату и номер договора на целевое обучение
  function GetTrgTrainAgrNum: String;
  begin
    result := '';
    // Проверим все записи об образовании работника, у которых совпадает "Дата с"
    _loop Education where ((
          SData.cPerson == Education.Person
      and ContDoc.Dat1 == Education.FromDate
    ))
    begin
      // Если совпадает значение поля "Учебное заведение"
      if ContDoc.cNew7 = Education.Name then
        result := Replace(oExtAttr.sGetAttr(coEducation, Education.NRec, EXT_ATTR_TARG_EDUC), '/', '.');
    end;
  end;

  // Вывод тела отчёта
  procedure OutBody(var R: LongInt);
  var
    C: Word;
    N: LongInt;
    S: String;
  begin
    SetVisualHeader('Вывод данных в отчет...');
    N := 0;
    _loop SData
    begin
      if IsAborted then
        break;
      NextVisual;
      C := FirstCol - 1;
      // №
      xlOp(xlSetCellNumberValue(++N, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // ФИО
      xlOp(xlSetCellStringValue(Persons.FIO, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Целевики
      xlOp(xlSetCellStringValue(GetTrgTrainAgrNum, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Приказ
      xlOp(xlSetCellStringValue(DateToStr(SData.OrderDate, 'DD.MM.YYYY') + ' № ' + SData.OrderNum, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Вид практики
      xlOp(xlSetCellStringValue(ICatFunc.GetCatalogsName(ContDoc.cNew3), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Подр.
      if IsValid(tnAppointments) then
        xlOp(xlSetCellStringValue(ICatFunc.GetCatalogsCode(Appointments.Department), R, ++C, R, C), XE_SET_CELL_VALUE, '')
      else
        C++;
      // Руководитель
      S := ICatFunc.GetCatalogsName(Appointments.Post);
      xlOp(xlSetCellStringValue(if(S !='', S + ' ', '') + oGP_SF.ShortFIO(PersonsM.FIO), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Период с
      xlOp(xlSetCellDateValue(SData.DateFrom, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // по
      xlOp(xlSetCellDateValue(SData.DateTo, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Учебное заведение
      xlOp(xlSetCellStringValue(ICatFunc.GetCatalogsName(ContDoc.cNew7), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Количество
      xlOp(xlSetCellStringValue('1', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Шифр специальности
      xlOp(xlSetCellStringValue(ICatFunc.GetCatalogsCode(SData.cSpeciality), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Специальность
      xlOp(xlSetCellStringValue(ICatFunc.GetCatalogsName(SData.cSpeciality), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Индивидуальное задание
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Лист оценки
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Оплата руководителю
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Договор со студентом
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Курс
      xlOp(xlSetCellStringValue(ContDoc.wAttrDoc4, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Остались на стажировку
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // IQ
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Дальнейшее прохождение практики студентом (мнение)
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Мнение руководителя по зачислению в штат
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Общий балл
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Пришел бы снова на практику
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Хотел бы студент снова работать на предприятии
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Общее мнение студента о практике
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Дата трудо-устройства
      xlOp(xlSetCellStringValue('', R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Контакт. тел.
      xlOp(xlSetCellStringValue(GetPhoneNumbers(Persons.NRec), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      R++;
    end;
  end;

  // Возвращает true если приказ утвержден
  function IsConfirmed: Boolean;
  begin
    result := TitleDoc.wStatus = 1 or ContDocI.wYearPr = 1 or ContDocI.wYearPr = 2;
  end;

  // Подготовка данных для отчёта
  procedure PrepareData;
  var
    cKindNaznEntry: tNRec;
    cPractice: tNRec;
  begin
    if IsAborted then
      exit;
    // Ищем в каталоге "Характер назначения" запись с кодом "Практика"
    cKindNaznEntry := ICatFunc.GetCatalogsNRec(-123);
    if getFirst Catalogs where ((cKindNaznEntry == Catalogs.cParent and 'Практика' == Catalogs.Code)) != tsOk then
    begin
      oGP_Log.Error('Не найдена запись с кодом "Практика" в каталоге "Характер назначения"');
      exit;
    end;
    cPractice := Catalogs.NRec;
    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Анализ данных...', 1);
    _try
      begin
        // Отбираем все практики, дата начала которых попадает в отчётный период
        _loop GP_SpContDoc201 
        where ((
             pDBeg <<= GP_SpContDoc201.DateFrom
         and pDEnd >>= GP_SpContDoc201.DateFrom
        ))
        begin
          if IsAborted then
            break;
          NextVisual;
          // На всякий случай игнорируем записи, не привязанные к приказу
          if not IsValid(tnTitleDoc) then
            continue;
          // Обрабатываем только утверждённые приказы
          if not IsConfirmed then
            continue;
          ClearBuffer(#SData);
          SData.cContDoc := ContDocI.NRec;
          SData.cPerson := GP_SpContDoc201.cPerson;
          SData.FIO := PersonsI.FIO;
          SData.DateFrom := GP_SpContDoc201.DateFrom;
          SData.DateTo := GP_SpContDoc201.DateTo;
          SData.OrderNum := TitleDoc.DocNmb;
          SData.OrderDate := TitleDoc.DocDate;
          SData.cSpeciality := GP_SpContDoc201.cSpeciality;
          if insert current SData != tsOk then
          begin
            oGP_Log.Error('Не удалось добавить запись в таблицу SData (ContDoc.NRec = ' + To_Char(ContDocI.NRec, 0, 0) + ')');
            continue;
          end;
        end;
      end
    _except
      on ExUserBreak:
        begin
          IsAborted := true;
        end;
    StopVisual('', 0);
  end;

  file MacroFile;

  function CreateMacro(MacroFileName: string): Boolean;
  begin
    result := false;
    if MacroFile.OpenFile(MacroFileName, stCreate) then
    begin
      MacroFile.Writeln('Sub FormatReport');
      MacroFile.Writeln('  Selection.AutoFilter');
      MacroFile.Writeln('End Sub');
      MacroFile.Close;
      result := true;
    end else
      oGP_Log.Error('Не удалось создать файл "' + MacroFileName + '"');
  end;

  procedure RunMacro;
  var
    MacroFileName: String;
  begin
    if IsAborted then
      exit;
    MacroFileName := GetDefaultUserPath + REP_NAME + '.bas';
    if not CreateMacro(MacroFileName) then
      exit;
    xlImportModule(MacroFileName);
    xlRunMacro('FormatReport');
    DeleteFile(MacroFileName);
  end;

  // Формирует отчёт
  procedure CreateReport;
  var
    OutFileName: String;
    R: LongInt;
  begin
    IsAborted := false;
    PrepareData;
    if IsAborted then
      exit;

    RecCnt := RecordsInTable(#SData);
    if RecCnt = 0 then
    begin
      Message('Нет данных для формирования отчёта');
      exit;
    end;

    OutFileName := GetDefaultUserPath + REP_TITLE + ' с ' + DatetoStr(pDBeg, 'DD.MM.YYYY') + ' по ' + DatetoStr(pDEnd, 'DD.MM.YYYY') + '.xlsx';
    StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', RecCnt);
    _try
    begin
      PrepareExcelFile(OutFileName);
      R := 1;
      // Выводим заголовок отчёта
      OutTitle(R);
      FirstHeadRow := R;
      FirstBodyRow := FirstHeadRow + 1; // Высота шапки - 1 строка
      LastBodyRow := FirstBodyRow + RecCnt - 1;
      // Выводим шапку отчёта
      OutHeader(R);
      // Выводим тело отчёта
      OutBody(R);
      // Запускаем макрос
      RunMacro;
    end
    _except on ExOnExecelError, ExUserBreak:
    begin
      IsAborted := true;
    end;
    StopVisual('',0);
    xlKillExcel;
  end;

  //------------------------------------------------------------------------------------------------------------------------------

  HandleEvent
    cmInit:
      begin
        if AskParam then
        begin
          oGP_Log.Init(REP_NAME + '.log', true, true, true);
          oGP_Log.SetVerboseMode(true);
          CreateReport;
          oGP_Log.Done(true);
        end;
        abort;
      end;
  end;

end.

//=[ Функции для подключения отчета ]=================================

#include UserReport.vih

vipinterface UserReport_GP_PracticeBase implements IUserReport;

interface UserReport_GP_PracticeBase;

  procedure Run;
  begin
    RunInterface('GP_PracticeBase');
  end;

  function GetReportName: String;
  begin
    result := 'База регистрации практик';
  end;

  function GetGroupName(Level: Word): String;
  begin
    result := '';
    case Level of
      1: result := 'Обучение и развитие персонала';
    end;
  end;

  function GetPriority: Integer;
  begin
    result := 0;
  end;

  function VisibleInModule(Ind: Byte): String;
  begin
    result := '';
    case Ind of
      1: result := 'STAFFMAINMENU';
    end;
  end;

end.
