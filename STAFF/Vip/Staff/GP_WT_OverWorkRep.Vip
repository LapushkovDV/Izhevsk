Show at (,,50,16);

//====================
  procedure SelectMarKat;forward;
//====================
table struct tmp_report_gr
( nrec     :comp
 ,pr       :Integer
 ,sortname :string // для сортировки
 ,NumRec   :Longint //Кол-во записей в группировке
 ,cRec     :comp
 ,LevCode  :Word
 ,LevTitle :String[200]
 ,LevName  :String[200]
 ,LevKod   :String[50]
 ,dmd : array[1..20] of double
 ,dms : array[1..200] of string
 ,wTable   :word //код таблицы
 ,cRecord  :comp //ссылка на запись
)
with index
( tmp_report_gr01  = nrec (AutoInc, Unique),
  tmp_report_gr02  = pr+sortname,
  tmp_report_gr03  = cRec+sortname,
  tmp_report_gr05  = cRec+dms[1]
);

table struct tmp_report_sp
(  nrec     :comp
 , pr       :Integer
 , sortname :string // для сортировки
 , cRec     :comp   // ссылка на заголовок
 , FIo      :string
 , cPers    :comp
 , cPost    :comp
 , Kateg    :word
 , dmd : array[1..20] of double
 , dms : array[1..20] of string
)
with index
( tmp_report_sp01  = nrec (AutoInc, Unique),
  tmp_report_sp03  = cRec+sortname,
  tmp_report_sp04  = cRec+cPers+cPost+Kateg
);
//------------------
// Для предвыборки табеля
Table Struct tmp_LsTab
( cLstab  :comp
 ,cPerexod:comp
 ,cKatPodr:comp
 ,cAppoint:comp
 ,Kateg   :word
 ,Fio     :string[100]
 ,cPersons:comp
 ,cLschet :comp
 ,Podr_Kod:string[10]
 ,sPost   :string
 ,MesN    :word
)
with index
( tmp_LsTab01 = cLsTab + cPerexod
);


