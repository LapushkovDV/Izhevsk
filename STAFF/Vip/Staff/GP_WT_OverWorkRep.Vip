var
  CS: IContextSession; // для захвата прикладного контекста табеля
  //---------------
  iCatFunc            : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  iQBuilder:GP_QueryBuilder new;
  //для стандартного фильтра по подразделению
  PAF:  TraditionalPersonalAccountFilter;
  CLSF:      CurLSFunctions;
  //-----------------------
  viCYPersons         : ChoiseYourPersons;
  //-----------------------
  wMesB,wMesE, wMes:word;
  DTB,DTE,DTB_Period,DTE_Period:date;
  wYear:word;
  sPopdis  :string;// подпись отчета
  sDolg    :string;// подпись отчета
  maxColCount:Longint;
  pNotationRV1,pNotationRV2:comp;

#include Excel_Var.vpp
  //-----------------------------------------
  // Фильтры - базовые
  //-----------------------------------------
   wFilter:word;
   wOption:word;
   wVivod :word;
   DepList :longint;
   VidKat      : string[100];
   MarkKat:longint;
Create view
var
  pRep       :comp;
  pRep_Main  :comp;
  pPost      :comp;
  pDepartMent:comp;
  pLschet    :comp;
  sUserName:string;
as select KlKatego.Nrec
, (PAF.GetDepartmentFilterStr)  (fieldname = FiltrPodr)
, tmp_LsTab.*
From KlKatego, tmp_report_Gr(tmp_report_gr03), tmp_report_sp(tmp_report_sp03)
, tmp_report_Gr tmp_report_Gr_Up
, ZAR_USER
, StaffStruct
, tmp_LsTab(tmp_LsTab01)
where
((
   sUserName == Zar_User.OwnName
//---------------
and pDepartment == StaffStruct.Department
and pPost       == StaffStruct.POST
and DTE_Period >>= StaffStruct.DInPut
and ( StaffStruct.DClose=ZeroDate
     or StaffStruct.DClose>=DTB
  )
 and  pRep == tmp_report_gr.cRec
 and  tmp_report_gr.NRec == tmp_report_sp.cRec
 and  pRep == tmp_report_Gr_Up.Nrec
))
;

//------------------------------------
Create view vSpr
var
  pPerson :comp;
From Persons, Appointments
where
((  pPerson == Persons.Nrec
and Persons.Appointcur == Appointments.Nrec
));

//------------------------------------
create view vPodr
var
 sPodr_kod:string;
From KatPodr
where (( sPodr_kod == KatPodr.kod));

//------------------------------------
Create view v1
from  UOWRKTABEL;



