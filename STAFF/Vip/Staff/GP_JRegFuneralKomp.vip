#include UserReport.vih
#include ComFiltr.vih
#include CatFunc.vih
#include AppFuncs.vih
#include GP_AppChange.vih
#include GP_XlOutExt.vih

#define GPInt GP_JRegFuneralKomp // #(GPInt)
//#define GPNam Журнал регистрации и учета материальной помощи (компенсации стоимости ритуальных услуг) // #(GPNam)
#define GPNam Журнал регистрации и учета материальной помощи (в т.ч. компенсации стоимости ритуальных услуг) // #(GPNam)

Interface #(GPInt) '#(GPNam) (ЭМ)' EscClose, Gray;
  show (,,86,14);

const
#include Excel.inc;
end;

table struct ttPerFlt // для фильтра по персоналу
(
  cRecPers : comp
)
with index
(
  ttPerFlt01  = cRecPers
);

table struct ttTypOp
(
  wCodeOper : word
, sNameOper : string
)
with index
(
  ttTypOp01 = wCodeOper
);

table struct ttResStr // статический набор данных
(
  nRec      : comp
, cRecPers  : comp        
, sKomp     : string      //18
, sSource   : string      //18
, sKomC     : string
, lVOpl     : longint
, sTbNmb    : string      //02
, sFIO      : string      //03
, sDept     : string      //04
, sPost     : string      //06
, sSNILS    : string      //07
, sINN      : string      //08
, sPrik     : string      //09
, dbKompSt  : double      //10
, dKomp     : date        //11
, dPay      : date        //12
, dbPay     : double      //13
, sFIODead  : string      //14
, dBornDead : date        //15
, iAgeDead  : integer     //16
, sDeptDead : string      //17
, sIsCh     : string      //18
, sVOpl   : string
, dbSum   : double
, wYear   : word
, wMonth  : word
, dSort   : date
)
with index
(
  ttResStr00 = nRec(Surrogate)
, ttResStr01 = cRecPers + sKomC + dKomp
, ttResStr02 = sFIO + sKomp + dKomp
, ttResStr03 = cRecPers + lVOpl + wYear + wMonth 
, ttResStr04 = cRecPers + dSort
);
table struct ttPers
(
  cRecPsn : comp,
  sFIO    : string
)
with index
(
  ttPers00 = cRecPsn
, ttPers01 = sFIO
);

/*
table struct ttSumOpl
(
  cRecPsn : comp
, sVOpl   : string
, lVOpl   : longint
, wYear   : word
, wMonth  : word
, dbSum   : double
)
with index
(
  ttSumOpl01 = cRecPsn + lVOpl + wYear + wMonth 
, ttSumOpl02 = cRecPsn + sVOpl + wYear + wMonth 
);
*/
table struct ttVidOpl
(
  cRecPsn : comp
, sVOpl   : string
, lVOpl   : longint
)
with index
(
  ttVidOpl01 = cRecPsn + lVOpl
);

var
  dBeg, dEnd    : date;
  VCommonFiltr  : CommonFiltr; // Для встраивания фильтра по подразделениям / сотрудникам
  MadeReport    : boolean;
  cPersNRec     : comp;
  PersMarker    : TPtr;
  RPDMarker     : TPtr;
  iCatFunc      : CatalogsFunctions;
  iAppFunc      : AppointmentsFunctions;
  iAppCh        : GP_AppChange;
  iOut          : GP_XlOutExt;
  sFullName     : string;
  sRPD          : string;
  wRPD          : word;
  lRB, lHS,
  lCB, lCE,
  lSB, lSE,
  lDB, lDE,
  lRow          : longint;
  wTypOper      : word;
  iRowB, iRowE,
  iNPP          : integer;
  cPostV, cDeptV: comp;

create view
var
  cPersOpl : comp;
  lVidOpl  : longint;
  cApp4SumVidOp : comp;
from
  persons
, appointments
, persons FuneralPsn
, passports
, raisehist
, raise
, TYPEPR
, ttPerFlt
, ttResStr
, ttTypOp
, ttPers
// , ttSumOpl
, ttVidOpl
, LSchet
, SumVidOp
, KlVidOpl
, contdoc
, GP_RaiseHistExt104
, Catalogs CatParent
, appointments App4SumVidOp
where
((
    ttPerFlt.cRecPers == persons.nrec
and ttPerFlt.cRecPers == raisehist.CPSN and (raisehist.DOCDATE >= dBeg and raisehist.DOCDATE <= dEnd)
and raisehist.cRaise == raise.nrec
and raisehist.cContDoc == contdoc.nrec
and contdoc.cStr == appointments.nrec
and contdoc.TypeOper == ttTypOp.wCodeOper
and RaiseHist.nRec == GP_RaiseHistExt104.cRaiseH
and GP_RaiseHistExt104.cPerson == FuneralPsn.nRec
and RaiseHist.cRaiseType == CatParent.nRec

and ttPers.cRecPsn == LSchet.tPerson
and LSchet.nRec == SumVidOp.cLSch
and year(dBeg) <<= SumVidOp.YearV and (year(dEnd) >= SumVidOp.YearV)
and cApp4SumVidOp == App4SumVidOp.nRec
// and ttPerFlt.cRecPsn == ttVidOpl.cRecPsn
// and SumVidOp.VIDOPL == ttVidOpl.lVOpl

// and                 year(dBeg)<<= SumVidOp.YearN and (year(dEnd) >= SumVidOp.YearN and cPersOpl = SumVidOp.TPerson /*and lVidOpl = SumVidOp.VIDOPL*/)
))
;

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

procedure Run;
{
  var kol, i    : integer;
  var cPersNRec : comp;
  var sCT, sNT  : string;
  var dbTotPay
  ,   dbTotKompSt
  : double;
  var iKolRow: integer;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);

  if (VCommonFiltr.GetPsnCount = 0)
    VCommonFiltr.SelectAllPsn;

  PersMarker := InitMarker('#(GPInt)_PSN_'+UserName(),8,200,100);
  PersMarker := VCommonFiltr.GetPersonsMarker;
  kol:=  GetMarkerCount(PersMarker);
  i := 0;
  while i < kol
  {
    GetMarker(PersMarker, i, cPersNRec);
    insert ttPerFlt set ttPerFlt.cRecPers := cPersNRec;
    i++;
    if (not NextVisual) break;
  }
  
  if isvalid(#ttPerFlt)
  _loop ttPerFlt
  {
    if isvalid(#RaiseHist)
    _loop RaiseHist
    {
    
      if isvalid(#Raise)
      if isvalid(#ContDoc)
      if isvalid(#ttTypOp)
      if raise.OrderDate1 = RaiseHist.DOCDATE//  and raise.OrderDate2 = 0
      {
        if isvalid(#persons)
        {
          if (not NextVisual) break;
          if getfirst ttPers where((persons.nrec == ttPers.cRecPsn)) <> tsOk
          {
            clearbuffer(#ttPers);
            ttPers.cRecPsn := persons.nrec;
            ttPers.sFIO := persons.fio;
            insert current ttPers;
          }
          clearbuffer(#ttResStr);
          ttResStr.cRecPers := persons.nrec;
          ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
          ttResStr.sFIO     := persons.FIO;
          cPostV:=cDeptV:=comp(0);
          if isvalid(#appointments)
          {
            cPostV := appointments.DEPARTMENT;
            cDeptV := appointments.POST;      
            ttResStr.sDept  := iCatFunc.GetCatalogsCode(cPostV);
            ttResStr.sPost  := iCatFunc.GetCatalogsName(cDeptV);
          }
          ttResStr.sKomp    := iCatFunc.GetCatalogsName(RaiseHist.cRaiseType);
          ttResStr.sKomC    := iCatFunc.GetCatalogsCode(RaiseHist.cRaiseType);
          if isvalid(#CatParent)
            ttResStr.sSource:= iCatFunc.GetCatalogsName(CatParent.cParent);
          ttResStr.lVOpl    := longint(Trim(iCatFunc.GetCatalogsCatData(RaiseHist.cRaiseType)));
          if getfirst ttVidOpl where((ttPers.cRecPsn == ttVidOpl.cRecPsn and ttResStr.lVOpl == ttVidOpl.lVOpl)) <> tsOk
          {
            clearbuffer(#ttVidOpl);
            ttVidOpl.cRecPsn := ttPers.cRecPsn;
            ttVidOpl.lVOpl   := ttResStr.lVOpl;
            if getfirst KlVidOpl where ((ttResStr.lVOpl == KlVidOpl.VidOpl)) = tsOk
              ttVidOpl.sVOpl   := KlVidOpl.NVidOpl;
            insert current ttVidOpl;
          }
          if getfirst passports where((persons.nrec == passports.person and 505 == passports.syscode)) = tsOk
            ttResStr.sINN   := passports.NMB;
          if getfirst passports where((persons.nrec == passports.person and 501 == passports.syscode)) = tsOk
            ttResStr.sSNILS := passports.NMB;
          ttResStr.sPrik    := RaiseHist.DOCNMB+' от '+datetostr(RaiseHist.DOCDATE,'DD.MM.YYYY');
          ttResStr.dbKompSt := RaiseHist.RHSUM;
          if isvalid(#GP_RaiseHistExt104)
          {
            ttResStr.dKomp    := GP_RaiseHistExt104.dZayav;
            ttResStr.dPay     := GP_RaiseHistExt104.DatePay;
            ttResStr.dbPay    := GP_RaiseHistExt104.SummPay;
            if isvalid(#FuneralPsn)
            {
              ttResStr.sFIODead  := FuneralPsn.FIO;
              ttResStr.dBornDead := FuneralPsn.BORNDATE;
              ttResStr.iAgeDead  := Year(Sub_Date(dEnd, FuneralPsn.BORNDATE))-1;
              ttResStr.sDeptDead := iCatFunc.GetCatalogsCode(FuneralPsn.DEPARTMENT);
            }
          }
          ttResStr.wYear := Year(RaiseHist.DRec);
          ttResStr.wMonth:= Month(RaiseHist.DRec);
          ttResStr.dSort := RaiseHist.DRec;
          ttResStr.sIsCh := iAppCh.State(persons.nrec,contdoc.cSTR,dEnd,12);
          insert current ttResStr;
        }
      }
    }// _loop RaiseHist
    if ( getfirst ttPers where((ttPerFlt.cRecPers == ttPers.cRecPsn)) = tsOk )
    if IsValid(#LSchet)
    _loop LSchet
    if IsValid(#SumVidOp)
    {
      _loop SumVidOp
      {
        if  date(1,month(dBeg),year(dBeg)) <= date(1,SumVidOp.MesN,SumVidOp.YearN)
        and sub_day(add_months(date(1,month(dEnd),year(dEnd)),1),1) >= sub_day(add_months(date(1,SumVidOp.MesN,SumVidOp.YearN),1),1)
        {
          if getfirst ttVidOpl where((ttPers.cRecPsn==ttVidOpl.cRecPsn and SumVidOp.VidOpl==ttVidOpl.lVOpl)) = tsOk
          {
            if (not NextVisual) break;
            if getfirst ttResStr where ((  ttPers.cRecPsn==ttResStr.cRecPers 
                                       and ttVidOpl.lVOpl==ttResStr.lVOpl  
                                       and SumVidOp.YearN==ttResStr.wYear
                                       and SumVidOp.MesN ==ttResStr.wMonth
            /*if getfirst ttResStr*/   )) <> tsOk
            {
              clearbuffer(#ttResStr);
              ttResStr.cRecPers := persons.nrec;
              ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
              ttResStr.sFIO     := persons.FIO;
              set cApp4SumVidOp := iAppFunc.GetAppNrec_OnDate(persons.nrec, sub_day(add_months(date(1,SumVidOp.MesN,SumVidOp.YearN),1),1));
              if isvalid(#App4SumVidOp)
              {
                ttResStr.sPost  := iCatFunc.GetCatalogsName(App4SumVidOp.POST);
                ttResStr.sDept  := iCatFunc.GetCatalogsCode(App4SumVidOp.DEPARTMENT);
              }
              if ( ttResStr.sPost = '' or ttResStr.sDept = '' )
              {
                ttResStr.sPost  := iCatFunc.GetCatalogsName(cPostV);
                ttResStr.sDept  := iCatFunc.GetCatalogsCode(cDeptV);
              }
              ttResStr.wYear   := SumVidOp.YearN;
              ttResStr.wMonth  := SumVidOp.MesN ;
              ttResStr.dbSum   := SumVidOp.Summa;
              ttResStr.lVOpl   := ttVidOpl.lVOpl;
              ttResStr.sKomp   := ttVidOpl.sVOpl;
              ttResStr.dSort   := sub_day(add_months(date(1,SumVidOp.MesN,SumVidOp.YearN),1),1);
              insert current ttResStr;
            }
            else
            {
              ttResStr.dbSum += SumVidOp.Summa;
              update current ttResStr;
            }
          }
        }
      }
    }
  }
  if isvalid(#ttResStr)
  {
    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xls';

    xlCreateExcel(sFullName, TRUE);
    iOut.xlSummaryRowAbove;
    lRB  := 4;
    lRow := 1;
    lHS  := 2;
    lDB  := lDE := lRB + lHS;
    lCB  := lCE := 1;
    iNPP := 1;

    #define repT 2,3,2,3
    iOut.StringValL('#(GPNam) за период с '+datetostr(dBeg,'DD.MM.YYYY')+' по '+datetostr(dEnd,'DD.MM.YYYY'),#repT);
    xlSetFontSize(14,#repT); xlSetFontStyle(xlBold,#repT);

    #define FrmHd  lRB,  lCE,  lRB,  lCE
    #define FrmHu  lRB+1,lCE,  lRB+1,lCE
/*01*/iOut.Header2Row('№ п/п',                      #FrmHd); lCE++;
      iOut.HeaderIns ('Подавший заявление',         #FrmHd, 4);
/*02*/iOut.Header1Row('Таб. Ном.',                  #FrmHu); lCE++;
/*03*/iOut.Header1Row('ФИО',                        #FrmHu); lCE++;
/*04*/iOut.Header1Row('№ цеха / отдел',             #FrmHu); lCE++;
/*05*/iOut.Header1Row('Должность / специальность',  #FrmHu); lCE++;
/*06*/iOut.Header2Row('Вид материальной помощи',    #FrmHd); lCE++;
      iOut.Header2Row('Источник выплаты',           #FrmHd); lCE++;
/*07*/iOut.Header2Row('СНИЛС',                      #FrmHd); lCE++;
/*08*/iOut.Header2Row('ИНН',                        #FrmHd); lCE++;
/*09*/iOut.Header2Row('Номер и дата списка',        #FrmHd); lCE++;
/*10*/iOut.Header2Row('Сумма мат.помощи (компенс.)',#FrmHd); lCE++;
/*11*/iOut.Header2Row('Дата подачи заявления',      #FrmHd); lCE++;
//      iOut.HeaderIns ('Выплата',                    #FrmHd, 2);
/*12*///iOut.Header1Row('Дата',                       #FrmHu); lCE++;
/*13*///iOut.Header1Row('Сумма',                      #FrmHu); lCE++;
      iOut.Header2Row('Дата начисл. компен-сации',      #FrmHd); lCE++;
      iOut.Header2Row('Начислено компен-сации',         #FrmHd); lCE++;
      iOut.HeaderIns ('Сведения об умершем',        #FrmHd, 4);
/*14*/iOut.Header1Row('ФИО',                        #FrmHu); lCE++;
/*15*/iOut.Header1Row('Дата рождения',              #FrmHu); lCE++;
/*16*/iOut.Header1Row('Воз-раст',                   #FrmHu); lCE++;
/*17*/iOut.Header1Row('№ цеха/ отдела',             #FrmHu); lCE++;
/*18*/iOut.Header2Row('Изменение условий',          #FrmHd); lCE++;
    
    #define FrmCl lDE,lSE,lDE,lSE
    _loop ttPers ordered index ttPers01
    {
      lSB := lSE := 1;
      iKolRow:=0;
      iRowB:=lDE;
/*01*/iOut.IntegerVal(lRow,               #FrmCl); lRow++;
      _loop ttResStr where((ttPers.cRecPsn==ttResStr.cRecPers)) ordered index ttResStr04
      {
        if (not NextVisual) break;
        lSB := lSE := 1;
/*01*/  lSE++;
/*02*/  iOut.CodeVal   (ttResStr.sTbNmb,    #FrmCl); lSE++;
/*03*/  iOut.StringValL(ttResStr.sFio,      #FrmCl); lSE++;
/*04*/  iOut.CodeVal   (ttResStr.sDept,     #FrmCl); lSE++;
/*05*/  iOut.StringValL(ttResStr.sPost,     #FrmCl); lSE++;
/*06*/  iOut.StringValL(ttResStr.sKomp,     #FrmCl); lSE++;
        iOut.StringValL(ttResStr.sSource,   #FrmCl); lSE++;
/*07*/  iOut.CodeVal   (ttResStr.sSNILS,    #FrmCl); lSE++;
/*08*/  iOut.CodeVal   (ttResStr.sINN,      #FrmCl); lSE++;
/*09*/  iOut.StringValR(ttResStr.sPrik,     #FrmCl); lSE++;
/*10*/  iOut.DoubleVal (ttResStr.dbKompSt,  #FrmCl); lSE++;
/*11*/  iOut.DateVal   (ttResStr.dKomp,     #FrmCl); lSE++;
/*12*///  iOut.DateVal   (ttResStr.dPay,      #FrmCl); lSE++;
/*13*///  iOut.DoubleVal (ttResStr.dbPay,     #FrmCl); lSE++;
/*14*/  if ( ttResStr.dbSum <> 0 ) iOut.DateVal   (sub_day(add_months(date(1,ttResStr.wMonth,ttResStr.wYear),1),1), #FrmCl);
        lSE++;
/*15*/  iOut.DoubleVal (ttResStr.dbSum, #FrmCl); lSE++;
/*16*/  iOut.StringValL(ttResStr.sFIODead,  #FrmCl); lSE++;
/*17*/  iOut.DateVal   (ttResStr.dBornDead, #FrmCl); lSE++;
/*18*/  iOut.IntegerVal(ttResStr.iAgeDead,  #FrmCl); lSE++;
/*19*/  iOut.CodeVal   (ttResStr.sDeptDead, #FrmCl); lSE++;
/*20*/  iOut.StringValC(ttResStr.sIsCh,     #FrmCl); lSE++;
        lDE++; iKolRow++;
      }
      if iKolRow > 1
      {
        iOut.xlSetSummaryRow(iRowB+1, lDE-1, iNPP++);
        lSE := 3; 
        xlSetFontStyle(xlBold,lDE,lCB,lDE,lCE);
        iOut.HeaderInsL('Итого Начислено компенсации по '+ttResStr.sFio, #FrmCl, 5); lDE++;
        iRowE := lDE - 1;
        iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;K'+iRowB+':K'+(iRowE-1)+')', iRowE, 11, iRowE, 11);
        iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;N'+iRowB+':N'+(iRowE-1)+')', iRowE, 14, iRowE, 14);
      }
/*
      var isSumm : boolean;
      cPersOpl := ttPers.cRecPsn;
      if IsValid(#LSchet)
      _loop LSchet
      if isvalid(#SumVidOp)
      {
        isSumm := false;
        _loop SumVidOp
        {
          if  date(1,month(dBeg),year(dBeg)) <= date(1,SumVidOp.MesN,SumVidOp.YearN)
          and sub_day(add_months(date(1,month(dEnd),year(dEnd)),1),1) >= sub_day(add_months(date(1,SumVidOp.MesN,SumVidOp.YearN),1),1)
          {
            if getfirst ttVidOpl where((ttPers.cRecPsn==ttVidOpl.cRecPsn and SumVidOp.VidOpl==ttVidOpl.lVOpl)) = tsOk
            {
              if getfirst ttSumOpl where ((  ttPers.cRecPsn==ttSumOpl.cRecPsn 
                                         and ttVidOpl.lVOpl==ttSumOpl.lVOpl  
                                         and SumVidOp.YearN==ttSumOpl.wYear
                                         and SumVidOp.MesN ==ttSumOpl.wMonth
                                         )) <> tsOk
              {
                clearbuffer(#ttSumOpl);
                ttSumOpl.cRecPsn := ttPers.cRecPsn;
                ttSumOpl.wYear   := SumVidOp.YearN;
                ttSumOpl.wMonth  := SumVidOp.MesN ;
                ttSumOpl.dbSum   := SumVidOp.Summa;
                ttSumOpl.lVOpl   := ttVidOpl.lVOpl;
                insert current ttSumOpl;
                isSumm := true;
              }
              else
              {
                ttSumOpl.dbSum += SumVidOp.Summa;
                update current ttSumOpl;
              }
            }
          }
        }
        if isSumm
        {
          lSE := 3; 
          xlSetFontStyle(xlBold,lDE,lCB,lDE,lCE);
          iOut.HeaderInsL('Итого Начислено компенсации по '+ttResStr.sFio, #FrmCl, 5); lDE++;
          iRowB:=lDE;
          _loop ttVidOpl where((ttPers.cRecPsn==ttVidOpl.cRecPsn))
          _loop ttSumOpl where((ttPers.cRecPsn==ttSumOpl.cRecPsn and ttVidOpl.lVOpl==ttSumOpl.lVOpl))
          {
            lSB := 1;
            lSE := 6; 
            iOut.StringValL(ttVidOpl.sVOpl, #FrmCl); // 05
            lSE := 13;
            iOut.DateVal   (sub_day(add_months(date(1,ttSumOpl.wMonth,ttSumOpl.wYear),1),1), #FrmCl); // 14
            lSE := 14;
            iOut.DoubleVal (ttSumOpl.dbSum, #FrmCl); // 15
            lDE++;
          }
          iRowE := lDE - 1;
          //=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;N8:N11)
          iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;N'+iRowB+':N'+iRowE+')', iRowB-1, 14, iRowB-1, 14);
          iOut.xlSetSummaryRow(iRowB, iRowE, iNPP++);
        }
      }
*/
    }

    var iItC : integer;
    #define FrmIt lDE,iItC,lDE,iItC
    #define Itog  '=СУММ(R'+lDB+'C'+iItC+':R'+(lDE-1)+'C'+iItC+')'
    iOut.xlR1C1OnOff(true);
    iItC :=  3; iOut.StringValR       ('Итого:', #FrmIt);
//    iItC := 11; iOut.FormulaDoubleVal (#Itog,    #FrmIt);
//    iItC := 14; iOut.FormulaDoubleVal (#Itog,    #FrmIt);
    iOut.xlR1C1OnOff(false);
    iItC := 11; iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;K'+lDB+':K'+(lDE-1)+')', #FrmIt);
    iItC := 14; iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;N'+lDB+':N'+(lDE-1)+')', #FrmIt);

    lSE := 1;
    #define FrmBl lDB,lSE,lDE,lSE
/*01*/xlSetColumnWidth( 5,#FrmBl); lSE++;
/*02*/xlSetColumnWidth( 6,#FrmBl); lSE++;
/*03*/xlSetColumnWidth(20,#FrmBl); lSE++;
/*04*/xlSetColumnWidth( 7,#FrmBl); lSE++;
/*05*/xlSetColumnWidth(20,#FrmBl); lSE++;
/*06*/xlSetColumnWidth(20,#FrmBl); lSE++;
      xlSetColumnWidth(20,#FrmBl); lSE++;
/*07*/xlSetColumnWidth(13,#FrmBl); lSE++;
/*08*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*09*/xlSetColumnWidth(10,#FrmBl); lSE++;
/*10*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*11*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*12*///xlSetColumnWidth(12,#FrmBl); lSE++;
/*13*///xlSetColumnWidth(12,#FrmBl); lSE++;
/*12*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*13*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*14*/xlSetColumnWidth(20,#FrmBl); lSE++;
/*15*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*16*/xlSetColumnWidth( 5,#FrmBl); lSE++;
/*17*/xlSetColumnWidth( 8,#FrmBl); lSE++;
/*18*/xlSetColumnWidth(12,#FrmBl); lSE++;
  
    xlSetFontStyle(xlBold,lRB,lCB,lDB-1,lCE);
    xlSetFontStyle(xlBold,lDE,lCB,lDE,lCE);
    #define AllTab lRB,lCB,lDE,lCE-1
    xlSetFontSize(11,#AllTab); 
    xlWrapText(#AllTab);
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0,#AllTab);
    #define ResPer lDE+2,3,lDE+2,3
    iOut.StringValL('Ответственный исполнитель: '+sGetTune('User.FIO'),#ResPer);
    xlSetFontSize(11,#ResPer); xlSetFontStyle(xlBold,#ResPer);
    iOut.xlTitleEachPageO(lRB,lDB-1);
    iOut.xlPageScaleLandscape(1);
    xlFreeze(lDB,1);
    StopVisual;
    xlKillExcel;
  }
  else
  {
    StopVisual;
    message('Нет данных для формирования отчета!');
  }

}

Screen s1(,,sci1Esc);
  show at (,,85,4);
  fields
    dBeg ('Начало периода',,):{Font = {BackColor = if(dBeg = 0, ColorNeed, 0)}}, noprotect;
    dEnd ('Конец периода',,): {Font = {BackColor = if(dEnd = 0, ColorNeed, 0)}}, noprotect;
    sRPD ('Распорядительное действие',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sRPD = 'не установлено', ColorNeed, 0)}}, protect;
  << 'Параметры отчета'
   `Период отчета`
    .@@@@@@@@@@ .@@@@@@@@@@@

    Действие     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  >>
end;  
embedded ComFiltrEmbedded 'Фильтры' interface VCommonFiltr;
  show (,5,85,11);
end
Screen s2(,,sci1Esc);
  show (,12,85,13);
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
  <<
     <. ~С~формировать .>                         <. ~З~акрыть .>
  >>
end;

procedure FillRPDStr;
{
  var i,kol : integer;
  Set sRPD := 'не установлено';

  kol :=  GetMarkerCount(RPDMarker);
  if (kol = 1)
  {
    if GetMarker(RPDMarker, 0, wRPD)
      if GetFirst TypePr where ((wRPD == TypePr.CodOper)) = tsOk
      {
        set sRPD:= TypePr.NOper;
        clearbuffer(#ttTypOp);
        ttTypOp.wCodeOper := TYPEPR.CODOPER;
        ttTypOp.sNameOper := TYPEPR.NOPER;
        insert current ttTypOp;
      }
  }
  else
  {
    set sRPD := 'Несколько распорядительных действий (' + kol + ')';
    i := 0;
    while i < kol
    {
      GetMarker(RPDMarker, i, wRPD);
      if GetFirst TypePr where ((wRPD == TypePr.CodOper)) = tsOk
      {
        clearbuffer(#ttTypOp);
        ttTypOp.wCodeOper := TYPEPR.CODOPER;
        ttTypOp.sNameOper := TYPEPR.NOPER;
        insert current ttTypOp;
      }
      i++;
    }
  }
}

handleevent
  cmInit:
  {
    delete all from ttPerFlt;
    delete all from ttResStr;
    delete all from ttTypOp;
    if (not (ReadMyDsk(dBeg, '#(GPInt)_dBeg', false)))
      dBeg := date(1,1,year(Cur_Date));
    if (not (ReadMyDsk(dEnd, '#(GPInt)_dEnd', false)))
      dEnd := date(31,12,year(Cur_Date));
    MadeReport:= false;
    wRPD := 0;
    Set sRPD := 'не установлено';
    RPDMarker := InitMarker('#(GPInt)_RPD_' + UserName(), 4, 10, 5);// Маркер для RPD
    if GetMarkerCount(RPDMarker) >0 FillRPDStr;
  }
  cmPick:
  {
    case CurField of
    #sRPD:
    {
      wRPD := 104;
      if RunInterface ('PickManyRPD', wRPD, RPDMarker, vfMultipleSelection,0) = cmDefault
      {
        delete all from ttTypOp;
        FillRPDStr;
      }
    }
    end;
  }
  cmDelOnProtect:
  {
    case CurField of
    #sRPD:
    {
      Set sRPD := 'не установлено';
      delete all from ttTypOp;
      ClearMarker(RPDMarker);
    }
    end;
  }
  cmOk:
  {
    if (dBeg = 0) or (dEnd = 0) or (dBeg > dEnd)
    {
      message('Задан некорректный период!');
    }
    else
    {
      if GetMarkerCount(RPDMarker) = 0
      {message('Не задано РПД!');}
      else
      {
        Run;
        SaveMyDsk(dBeg, '#(GPInt)_dBeg');
        SaveMyDsk(dEnd, '#(GPInt)_dEnd');
        MadeReport:= true;
        VCommonFiltr.IntClose(MadeReport);
        VCommonFiltr.StoreAllParams;
        Notify(cmEvaluateAndModify, 0);
        DoneMarker(RPDMarker, '#(GPInt)_RPD_' + UserName());
        DoneMarker(PersMarker, '#(GPInt)_PSN_' + UserName());
      
        closeinterface(cmDefault);
      }
    }
  }
  cmCancel:
  {
    VCommonFiltr.IntClose(MadeReport);
    DoneMarker(RPDMarker, '#(GPInt)_RPD_' + UserName());
    DoneMarker(PersMarker, '#(GPInt)_PSN_' + UserName());
    SaveMyDsk(dBeg, '#(GPInt)_dBeg');
    SaveMyDsk(dEnd, '#(GPInt)_dEnd');
  }
end;
end.



VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;

Procedure Run;
Begin
  runinterface(#(GPInt));
End;

Function GetReportName: String;
Begin
  GetReportName := '#(GPNam) (ЭМ)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Компенсации и льготы';
    2 : GetGroupName := 'Журналы регистрации и учета';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;

End.
