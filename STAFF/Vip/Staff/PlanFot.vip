#include UserReport.vih
                                            
vipinterface UserReport_iPlanFot implements IUserReport licensed(free);

interface UserReport_iPlanFot;

create view
  var
    Dummy: Byte;
;

procedure Run;
begin
  RunInterface(iPlanFot);
end;

function GetReportName: String;
begin
  GetReportName := 'Плановый ФОТ за квартал (расшифровка)';
end;

function GetGroupName(Level: Word): String;
begin
#__UNUSED__(Level)
  GetGroupName := 'Отчеты по ФОТ';
end;

function GetPriority: Integer;
begin
  GetPriority := 0;
end;

function VisibleInModule(Ind: Byte): String;
begin
#__UNUSED__(Ind)
  VisibleInModule := 'StaffMainMenu';
end;

end.
