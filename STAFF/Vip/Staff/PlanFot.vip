/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*                "Плановый ФОТ за квартал (расшифровка)"                                          *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Управление персоналом -> Отчеты -> Отчеты пользователя> -> Папка "Отчеты по ФОТ" *  
*                Плановый ФОТ за квартал (расшифровка)                                            *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#159          |30/07/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
#include xlReport.vih
#include CatFunc.vih   // Функции работы с Catalogs
#include GetKau.vih    // Обьектный интерфес выбора КАУ
#include PickBuh.vih   // Обьектный интерфес работы с таблицей PickBuh
#include History.vih

Interface iPlanFot 'Плановый ФОТ за квартал (расшифровка)' DoAccept, EscClose, Cyan;
  Show at (, , 60, 10);

#include GetKau.var    // Обьектный интерфес выбора КАУ
#include History.var
//*****************************************************************************
const 
  ccNpp  = 20;
end;
//*****************************************************************************
table struct tmpReport
(
  sCategory  : string
, Spec       : string
, sKval      : string
, sPodr      : string
, cPodr      : comp
, dKolStav   : double
, dOklad     : double
, sFIO       : string
, Vred       : string
, Note       : string
, bonus      : array[1..ccNpp] of double

)
with index
(
  tmpReport01 = sCategory + cPodr
);

//*****************************************************************************
table struct tmpSt
(
  NRec       : comp
, sName      : string
, sCode      : string
, npp        : word
)
with index
(
  tmpSt01 = NRec (Unique)
, tmpSt02 = sCode
, tmpSt03 = npp
);

//******************************************************************************  
create view
var 
  hPersonsMarker
, DeptMarkerCat
, DeptMarker
, CatMarker      : longint;
  PersNRec
, cPodrFlt       : comp;

  dBegin
, dEnd           : date;

  sNote
, sPodr
, sVidDopl
, sPerson 
, ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;
as select
  'iPlanFot'
    (FieldName = NameInterface)  

, *
from
  Persons
, tmpReport
, tmpReport tmpReport2
, Appointments
, StaffStruct
, Catalogs
, Catalogs CatalogsDep
, Catalogs CatalogsPost
, KlKatego
, RaiseStS
, Catalogs RaiseCat
, RaiseAlg
, tmpSt
where 
((
    StaffStruct.Department  == CatalogsDep.NRec
AND StaffStruct.Post        == CatalogsPost.NRec
AND ( 0 <> Appointments.Person        
  AND  dEnd  >= Appointments.AppointDate 
  AND (dBegin  <= Appointments.DismissDate or
             Appointments.DismissDate = ZeroDate)
     )
AND Appointments.StaffStr   == StaffStruct.Nrec
AND Appointments.Person     == Persons.NRec

AND StaffStruct.EmpCategory == KlKatego.Nrec

AND StaffStruct.NRec        == RaiseStS.StaffStr
AND RaiseStS.RaiseType      == RaiseCat.Nrec
AND RaiseSts.Nrec           == RaiseAlg.RaiseStSt

))
;
//******************************************************************************
var iCatFunc   : CatalogsFunctions;    // Переменная типа интерфейс CatalogsFunctions
//******************************************************************************
Function GetPodrNameFilter : string;
{
  DeptMarker    := InitMarker(NameInterface + '_sPodr', 8, 200, 10);

  var nRecMark : comp; nRecMark := comp(0);                                                         
  case GetMarkerCount(DeptMarker) of
    0: result := 'не установлен';
    1: 
      {
        GetMarker(DeptMarker, 0, nRecMark);
        result := iCatFunc.GetCatalogsName(nRecMark);
      }
    else
      result := 'Несколько подразделений (' + string(GetMarkerCount(DeptMarker)) + ')';
  end;
  
  DoneMarker(DeptMarker, NameInterface + '_sPodr');
}

//******************************************************************************
Function GetCatNameFilter : string;
{
  CatMarker    := InitMarker(NameInterface + '_CatalogsMarker', 8, 200, 10);

  var nRecMark : comp; nRecMark := comp(0);                                                         
  case GetMarkerCount(CatMarker) of
    0: result := 'не установлен';
    1: 
      {
        GetMarker(CatMarker, 0, nRecMark);
        result := iCatFunc.GetCatalogsName(nRecMark);
      }
    else
      result := 'Несколько вид доплат (' + string(GetMarkerCount(CatMarker)) + ')';

  end;
  
  DoneMarker(CatMarker, NameInterface + '_CatalogsMarker');
}


//******************************************************************************

Screen scrWin;
Fields
   dBegin           ('Дата начала периодп'         , , sci13Esc)  : NoProtect;
   dEnd             ('Дата начала периодп'         , , sci13Esc)  : NoProtect;
   sPodr            ('Подразделения'               , , sci13Esc)  : Protect;
   sVidDopl         ('Вид доплат'                  , , sci13Esc)  : Protect;
Buttons
   cmOk    , Default, , 'Продолжить';
   cmCancel,        , , 'Отменить';
<<
  `Период с ` .@@@@@@@@@@@ `по` .@@@@@@@@@@@
  `Подразделения`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Вид доплат   `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     <. Продолжить .>         <.  Отменить  .>
>>
end;

//******************************************************************************
HandleEvent
cmPick:
  case CurField of
    #sPodr:
      {
        DeptMarker    := InitMarker(NameInterface + '_sPodr', 8, 200, 10);
        DeptMarkerCat := InitMarker('', 8, 200, 10);
        CopyMarker(DeptMarkerCat, DeptMarker);
        DoneMarker(DeptMarkerCat, 'CatalogsMarker');

        if (RunInterface(Z_StaffCat::PickCatalog2, integer(-11), 0, comp(100)) = cmDefault)
          {
            DeptMarkerCat := InitMarker('CatalogsMarker', 8, 50, 10);
            CopyMarker(DeptMarker, DeptMarkerCat);
            DoneMarker(DeptMarkerCat, '');
          }

        DoneMarker(DeptMarker, NameInterface + '_sPodr');

        set sPodr := GetPodrNameFilter;
      }
    #sVidDopl:
      {   
        CatMarker     := InitMarker(NameInterface + '_CatalogsMarker', 8, 200, 10);
        DeptMarkerCat := InitMarker('CatalogsMarker', 8, 200, 10);
        CopyMarker(DeptMarkerCat, CatMarker);
        DoneMarker(DeptMarkerCat, 'CatalogsMarker');

        var cRecStS : comp;
        RunInterface(PickCatalog2, -17, cRecStS, 100);

        DeptMarkerCat := InitMarker('CatalogsMarker', 8, 200, 10);
        CopyMarker(CatMarker, DeptMarkerCat) ;
        DoneMarker(CatMarker, NameInterface + '_CatalogsMarker');

        set sVidDopl := GetCatNameFilter;
      }
  end;

cmDelOnProtect:
  case CurField of
    #sPodr:
      {
        DeptMarker := InitMarker(NameInterface + '_sPodr', 8, 200, 10);
        ClearMarker(DeptMarker);
        set sPodr := 'не установлен';
        DoneMarker(DeptMarker, NameInterface + '_sPodr');
      }
    #sVidDopl:
      {
        CatMarker := InitMarker(NameInterface + '_CatalogsMarker', 8, 200, 10);
        ClearMarker(CatMarker);
        set sVidDopl := 'не установлен';
        DoneMarker(CatMarker, NameInterface + '_CatalogsMarker');
      }

  end;
end;
//*****************************************************************************
type docType = record as table tmpReport;
//*****************************************************************************
Procedure PrintItog(ccPodr : comp; ssPodr : string; ssCategory : string);
{
  var itog : docType;
  var i : word;

  ClearAdvRecord(itog);

  _LOOP tmpReport2 where ((ccPodr  == tmpReport2.cPodr
                       AND ssCategory == tmpReport2.sCategory))
    {
      itog.dOklad   := itog.dOklad   + tmpReport2.dOklad;
      itog.dKolStav := itog.dKolStav + tmpReport2.dKolStav;

      for (i := 1; i <= ccNpp; inc(i))
        itog.bonus[i] := itog.bonus[i] + tmpReport2.bonus[i];
    }

  pXL.ClearTblBuffer;

  pXL.SetTblStringFldValue('Spec'  , 'Кат.' + ssCategory);
  pXL.SetTblStringFldValue('Cat'   , ssCategory   );
  pXL.SetTblStringFldValue('Podr'  , ssPodr       );                               
  pXL.SetTblStringFldValue('Level' , 'Итого'      );                                 
  pXL.SetTblNumberFldValue('Oklad' , itog.dOklad  );
  pXL.SetTblNumberFldValue('Kol'   , itog.dKolStav);     

  i := 0;
  _LOOP tmpSt ordered by tmpSt.sCode
    {
      inc(i);  
       
      if (itog.bonus[tmpSt.npp] <> 0 )  
        pXL.SetTblNumberFldValue('St' + string(i) + 'V', itog.bonus[tmpSt.npp]);
    }

  pXL.InsTblRow;                     
}
//*****************************************************************************
Procedure PrintLine;
{
   var sLastCateg : string; sLastCateg := '';
   var cLastPodr  : comp;   cLastPodr  := comp(-1);
   var sLastPodr  : string; sLastPodr  := '';

   _LOOP tmpReport ordered by tmpReport.sCategory, tmpReport.cPodr
     if (Not NextVisual)
     {
       break; 
     }
     else   
     { 
       if (cLastPodr <> comp(-1) 
       AND (cLastPodr <> tmpReport.cPodr
        OR sLastCateg <> tmpReport.sCategory))
          {
            PrintItog(cLastPodr, sLastPodr, sLastCateg);
          } 

       sLastCateg := tmpReport.sCategory;
       cLastPodr  := tmpReport.cPodr;
       sLastPodr  := tmpReport.sPodr;

       pXL.ClearTblBuffer;

       pXL.SetTblStringFldValue('Cat'   , '''' + tmpReport.sCategory);
       pXL.SetTblStringFldValue('Spec'  , tmpReport.Spec     );
       pXL.SetTblStringFldValue('Kval'  , tmpReport.sKval    );                               
       pXL.SetTblStringFldValue('Podr'  , tmpReport.sPodr    );                               
       pXL.SetTblNumberFldValue('Kol'   , tmpReport.dKolStav );                                 
       pXL.SetTblNumberFldValue('Oklad' , tmpReport.dOklad   );
       pXL.SetTblStringFldValue('FIO'   , tmpReport.sFIO     );     
       pXL.SetTblStringFldValue('Vred'  , tmpReport.Vred     );
       pXL.SetTblStringFldValue('Note'  , tmpReport.Note     );

       var i : word; i := 0;
       _LOOP tmpSt ordered by tmpSt.sCode
         {
           inc(i);  
            
           if (tmpReport.bonus[tmpSt.npp] <> 0 )  
             pXL.SetTblNumberFldValue('St' + string(i) + 'V', tmpReport.bonus[tmpSt.npp]);
         }

       pXL.InsTblRow;                     
     }

   PrintItog(tmpReport.cPodr, tmpReport.sPodr, tmpReport.sCategory);

}
//*****************************************************************************
Procedure PrintRepost;
{
  ID := 'PlanFotReport';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpReport));

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'           , CommonFormHeader);

  pXL.SetStringVar('dBeg'          , '''' + DateToStr(dBegin, 'DD.MM.YYYY'));
  pXL.SetStringVar('dEnd'          , '''' + DateToStr(dEnd  , 'DD.MM.YYYY'));

  var i : word; i := 0;
  _LOOP tmpSt ordered by tmpSt.sCode
    {
      inc(i);
      pXL.SetStringVar('St' + string(i) + 'N', 'в/о ' + tmpSt.sCode);
    }

  DeptMarker    := InitMarker(NameInterface + '_sPodr', 8, 200, 10);

  var item : comp;
  var countMark : longint; countMark := GetMarkerCount(DeptMarker);
  var sPodr : string; sPodr := '';

  for (i := 0; i < countMark; i := i + 1)
    if (GetMarker(DeptMarker, i, item))
      if (GetFirst Catalogs where ((item == Catalogs.NRec)) = tsOk)
        sPodr := sPodr + if (trim(sPodr) = '', '', ', ') + Catalogs.Name;

  DoneMarker(DeptMarker, NameInterface + '_sPodr');

  pXL.SetStringVar('podr'          , sPodr);

  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('Report');
  pXL.CreateTblFld('Cat'  );
  pXL.CreateTblFld('Level');
  pXL.CreateTblFld('Spec' );
  pXL.CreateTblFld('Kval' );
  pXL.CreateTblFld('Podr' );
  pXL.CreateTblFld('Kol'  );
  pXL.CreateTblFld('Oklad');
  pXL.CreateTblFld('FIO'  );
  pXL.CreateTblFld('Vred' );
  pXL.CreateTblFld('Note' );

  for (i := 1; i <= ccNpp; inc(i))
    pXL.CreateTblFld('St' + string(i) + 'V');

  PrintLine;

  pXL.PublishTbl('Report');

  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);
}
//*****************************************************************************
Function GetNum(cRec : comp; _Name, _Code : string) : comp;
{
  var i : word;
  var wRes : word; wRes := 0;
  var lastI : word; lastI := 1;

  if (cRec <> 0)
    if (GetFirst tmpSt where ((cRec == tmpSt.NRec)) = tsOk)
      wRes := tmpSt.npp;
    else
      {
        var _npp : word; _npp := 1;
        if (GetLast tmpSt ordered by tmpSt.Npp = tsOk)
          _npp := tmpSt.Npp + 1; 

        if (_npp > ccNpp)
          {
            result := 0;
            Exit;
          }

        ClearBuffer(#tmpSt);
        tmpSt.NRec  := cRec;
        tmpSt.sName := _Name;
        tmpSt.sCode := _Code;
        tmpSt.npp   := _npp;
        if (insert current tmpSt = tsOk)
          {}  

        wRes := _npp; 
      } 

  result := wRes;
}
//******************************************************************************
Procedure CreateTmpTable;
{
  DeptMarker    := InitMarker(NameInterface + '_sPodr'         , 8, 200, 10);
  CatMarker     := InitMarker(NameInterface + '_CatalogsMarker', 8, 200, 10);

  var isFiltrDep : boolean; isFiltrDep :=  GetMarkerCount(DeptMarker) <> 0;
  var isFiltrCat : boolean; isFiltrCat :=  GetMarkerCount(CatMarker) <> 0;

  _loop Appointments
    if (GetFirst StaffStruct = tsOk)
      if (GetFirst Persons = tsOk)
        {
          if (isFiltrDep)
            if (NOT FoundMarker(DeptMarker, StaffStruct.Department))
              continue; 
          
          ClearBuffer(#tmpReport);
          
          if (GetFirst KlKatego = tsOk)
            tmpReport.sCategory  := KlKatego.Kod;

          tmpReport.Spec       := CatalogsPost.Name;

          if (StaffStruct.Category <> 0)
            tmpReport.sKval      := StaffStruct.Category;

          tmpReport.sPodr      := CatalogsDep.Name;
          tmpReport.cPodr      := CatalogsDep.NRec;
          tmpReport.dKolStav   := Appointments.Rate;
          tmpReport.dOklad     := StaffStruct.TaxRate;
          tmpReport.sFIO       := Persons.FIO;

          var num  : word; 

          _LOOP RaiseStS 
            if (RaiseAlg.Sum <> 0)
              {
                if (isFiltrCat)
                  if (NOT FoundMarker(CatMarker, RaiseStS.RaiseType))
                    continue; 

                if (GetFirst RaiseCat = tsOk)
                  {}

                num := GetNum(RaiseCat.NRec, RaiseCat.Name, RaiseCat.Code);
                if (num > 0 AND num <= ccNpp)
                  tmpReport.bonus[num] := RaiseAlg.Sum;  
              }
           
          if (insert current tmpReport = tsOk)
            {}  
        }

  DoneMarker(DeptMarker, NameInterface + '_sPodr');
  DoneMarker(CatMarker , NameInterface + '_CatalogsMarker');

}
//******************************************************************************
HandleEvent

cmInit: 
  {
    set sPodr    := GetPodrNameFilter;
    set sVidDopl := GetCatNameFilter;

    if (NOT ReadMyDSK(dBegin, NameInterface + '_dBegin', FALSE))
      set dBegin := ZeroDate;

    if (NOT ReadMyDSK(dEnd, NameInterface + '_dEnd', FALSE))
      set dEnd := ZeroDate;

  }

cmOk:
  {
    SaveMyDsk(dBegin   , NameInterface + '_dBegin');
    saveMyDsk(dEnd     , NameInterface + '_dEnd');
    PutCommand(cmDefault);
  }

cmDefault:
  {
    CreateTmpTable;

    if (RecordsInTable(#tmpReport) = 0)
      {
        Message('Отсутствуют данные!');
        CloseInterface(cmDefault);

      }
    else
      {
        PrintRepost;
        CloseInterface(cmDefault);
      }
  }

end;
end.

