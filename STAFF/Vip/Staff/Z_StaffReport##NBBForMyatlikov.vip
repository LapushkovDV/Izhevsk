#component "Z_StaffReports"

#include FeeSigners.Vih

alter interface NBBForMyatlikov;

#include FeeSigners.Var


extendtabbedsheets NBBForMyatlikov;


var 
  sFeeSigners    : string;

  sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sOtv
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol   
, sOtvDol  
, nameNastr          : string;

  sPodpis1Npp
, sPodpis2Npp        : word;


TabbedSheet StaffPanel;

//TabbedSheet Top StaffPanel;
 show (,,, 16);

//OverloadFormats StaffStructReports3;

screen StaffStructReports3EM 'Подписанты';
  Fields
   sFeeSigners ('Группа подписантов (F3 - выбор)',,sci13Esc) : Protect;
<<
 `Подписанты:`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@    
>>
end;
end;

HandleEvent

cmInit: 
  {
    if (NOT ReadMyDsk(sFeeSigners, 'NBBForMyatlikov_sFeeSigners', True))
      set sFeeSigners := '';

    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);

    if (sFeeSigners <> '')
      iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sFeeSigners);

    inherited :: handleEvent (cmInit);

    if (VIDOTCH = 0)
      {
        SetTabbedSheetVisible(StaffStructReports3, true);
        SetTabbedSheetVisible(StaffStructReports3EM, false); 
      }
    else
      {
        SetTabbedSheetVisible(StaffStructReports3, false);
        SetTabbedSheetVisible(StaffStructReports3EM, true); 
      }
  }

cmCheckField:
  if (CurField = #VIDOTCH)
    if (VIDOTCH = 0)
      {
        SetTabbedSheetVisible(StaffStructReports3, true);
        SetTabbedSheetVisible(StaffStructReports3EM, false); 
      }
    else
      {
        SetTabbedSheetVisible(StaffStructReports3, false);
        SetTabbedSheetVisible(StaffStructReports3EM, true); 
      }
cmOk:
  {
    nameNastr := 'Em_Report_11';

    sPodpis1    := '';
    sPodpis1Dol := '';
    sPodpis1Npp := 999;
    sPodpis2    := '';
    sPodpis2Dol := '';
    sPodpis2Npp := 999;

    if (iFeeSigners.FeeSignersIsValid)
      {
        var wFeeSignersNum, wFeeSignersCount : word;
        wFeeSignersCount := iFeeSigners.GetFeeSignersCount;

        if (iFeeSigners.GetSignerFirst)
        {
          For (wFeeSignersNum := 1; wFeeSignersNum <= wFeeSignersCount; wFeeSignersNum++)
          {
             if (iFeeSigners.GetSignerRole = 'Согласовано (шапка)')
             {
               sSogls     := iFeeSigners.GetSignerFIO(7);
               sSoglsDol  := iFeeSigners.GetSignerPosition(1);
             }
             else if (iFeeSigners.GetSignerRole = 'Утверждающее лицо')
             {
               sUtve     := iFeeSigners.GetSignerFIO(7);
               sUtveDol  := iFeeSigners.GetSignerPosition(1);
             }
             else if (iFeeSigners.GetSignerRole = 'Проверяющее лицо')
             {  
               if (iFeeSigners.GetSignerNumber < sPodpis1Npp)
                 {
                   sPodpis2    := sPodpis1;   
                   sPodpis2Dol := sPodpis1Dol;
                   sPodpis2Npp := sPodpis1Npp;
                   sPodpis1    := iFeeSigners.GetSignerFIO(7);     
                   sPodpis1Dol := iFeeSigners.GetSignerPosition(1);
                   sPodpis1Npp := iFeeSigners.GetSignerNumber;
                 }
               else if (iFeeSigners.GetSignerNumber < sPodpis2Npp)
                 {
                   sPodpis2    := iFeeSigners.GetSignerFIO(7);     
                   sPodpis2Dol := iFeeSigners.GetSignerPosition(1);
                   sPodpis2Npp := iFeeSigners.GetSignerNumber;
                 } 
             }
             else if (iFeeSigners.GetSignerRole = 'Ответственный')
             {
               sOtv     := iFeeSigners.GetSignerFIO(7);
               sOtvDol  := iFeeSigners.GetSignerPosition(1);
             }
             else if (iFeeSigners.GetSignerRole = 'Согласовано (подножие)')
             {
               sSogls2     := iFeeSigners.GetSignerFIO(7);
               sSogls2Dol  := iFeeSigners.GetSignerPosition(1);
             }

            if (not iFeeSigners.GetSignerNext)
              break;
          }
        }
      }

    SaveMyDsk(sSogls     , nameNastr + '_sSogls');
    SaveMyDsk(sSoglsDol  , nameNastr + '_sSoglsDol');
    SaveMyDsk(sSogls2    , nameNastr + '_sSogls2');
    SaveMyDsk(sSogls2Dol , nameNastr + '_sSogls2Dol');
    SaveMyDsk(sUtve      , nameNastr + '_sUtve');
    SaveMyDsk(sUtveDol   , nameNastr + '_sUtveDol');
    SaveMyDsk(sOtv       , nameNastr + '_sOtv');
    SaveMyDsk(sOtvDol    , nameNastr + '_sOtvDol');
    SaveMyDsk(sPodpis2   , nameNastr + '_sPodpis2');
    SaveMyDsk(sPodpis2Dol, nameNastr + '_sPodpis2Dol');
    SaveMyDsk(sPodpis2Npp, nameNastr + '_sPodpis2Npp');
    SaveMyDsk(sPodpis1   , nameNastr + '_sPodpis1');
    SaveMyDsk(sPodpis1Dol, nameNastr + '_sPodpis1Dol');
    SaveMyDsk(sPodpis1Npp, nameNastr + '_sPodpis1Npp'); 

    SaveMyDsk(sFeeSigners, 'NBBForMyatlikov_sFeeSigners');
    inherited :: handleEvent (cmOk);
  }

cmPick:
  {
    case CurField of
      #sFeeSigners:
      {
        iFeeSigners.RunWindowFeeSigners(1);
        set sFeeSigners := iFeeSigners.GetFeeSignersName;
      }
    end;

    inherited :: handleEvent (cmPick);
  }

cmDelOnProtect:
  {
    case CurField of
      #sFeeSigners :
      {
        Set sFeeSigners := '';
        SaveMyDsk(sFeeSigners, 'NBBForMyatlikov_sFeeSigners');
      }

    end;

    inherited :: handleEvent (cmDelOnProtect);
  }

end;
end.