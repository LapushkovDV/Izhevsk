Interface #(GPInt);

const
#include Excel.inc;
sGroupOUV   = '_ВУЗы (высшие учебные заведения)';
sGroupOUS   = '_ССУЗы (средние специальные учебные заведения)';
sDogovor    = 'Учебный (целевики)';
sDocCEdu    = 'Договор на целевое обучение';
sDissEdu    = 'Дата отчисления из обр.учреждения';
sNIOKR      = 'НИОКР';
wBaseKaf    = 32; 
end;
#include ExtAttr.var
#include ExtClass.var
#include TotalOrganizationAttributes.var

table struct ttStatRK
(
  sNameOU   : string
, sCodeSpc  : string[100]
, sNameBaseK: string
, sInstUpGr : string
//, fVal1     : array [ 1..18] of integer
//, fVal2     : array [20..35] of integer
//, dbVal     : array [37..38] of double
, dbVal     : array [ 1..38] of double
)
with index
(
  ttStatRK01 = sNameOU + sCodeSpc
);
table struct tt15SpecRK
(
  sCodeSpc: string[100]
, iRow    : integer
)
with index
(
  tt15SpecRK01 = sCodeSpc
);
table struct tt15OURK
(
  sOU  : string
)
with index
(
  tt15OURK01 = sOU
);
table struct ttBaseKaf
(
  cInst    : comp
, sInstName: string
, sBaseName: string
, sInstUpGr: string 
)
with index
(
  ttBaseKaf00 = cInst
);

table struct ttPsnFlags
(
  cPsn : comp
, sFIO : string[60]
, dBorn: date
, isFl : array [1..35] of boolean
)
with index
(
  ttPsnFlags00 = cPsn
, ttPsnFlags01 = sFIO + dBorn
);

table struct ttSpecRK
(
  cPsn      : comp
, cInst     : comp
, cSpec     : comp
, sTypePsn  : string[1]
, sFIO      : string
, dAppoint  : date
, dDismiss  : date
, dDisEdu   : date
, sDissRea  : string
, sVidEdu   : string
, dBegEdu   : date
, dEndEdu   : date
, sInst     : string
, sLevelInst: string
, sBaseKaf  : string
, sSpecName : string
, sSpecCode : string
, sDeptCode : string
, sPost     : string
, sDogEduC  : string
, sDogEduU  : string
, sColunms  : string
)
with index
(
  ttSpecRK00 = cInst + cSpec + cPsn
, ttSpecRK01 = sInst + sSpecCode + sFIO
);


var
//  dRep          : date;
//  dBeg          : date;
//  dBegEdu       : date;
  iCatFunc      : CatalogsFunctions;
  iAppFuncs     : AppointmentsFunctions;
  iStrFunc      : StringFunctions;
//  iRunStaj      : Runstaj;
  ExtAttr       : iExtAttr;
  iExtCls       : iExtClass;
  iEduFunc      : EducFunctions;
  iChRPD        : GP_ChRPD;
  iUDR          : GP_UDR_RKStat;
  sFullName     : string;
  sPodr1        : string;
  mPodr1        : TPtr;
  isFilterPodr  : boolean;
  wPrintRash    : word;
  wToExistFile  : word;
  sToExistFile  : string;
  cRecTopOUV    : comp;
  cRecTopOUS    : comp;
//  cRecDogovor   : comp;
  cDocCEdu      : comp;
  cDissEdu      : comp;
  cDissReason   : comp;
  cDocCEduPsn   : comp;
  _cRecPsn      : comp;
  //-----------------------
  dEduBeg, dEduEnd: date = 0; //костыль из-за РПД236
  cEduAlt: comp = 0;          //костыль из-за РПД236
  wCourse: word = 0;          //костыль из-за РПД236


create view
var
  dRep          : date;
  dBeg          : date;
  dBegEdu       : date;
  cRecDogovor   : comp;
  cNIOKR        : comp;
as select *
from
  ttStatRK
, ttSpecRK
, tt15SpecRK
, tt15OURK
, ttBaseKaf
, ttBaseKaf ttBKEdu
, ttBaseKaf ttBKNIOKR
, ttPsnFlags
, Persons
, Education
, ContDoc CDoc136
, PartDoc  PDoc136
, TitleDoc TDoc136
, Appointments App136
, SpAllStaff Dog136
, ContDoc CDoc1
, Appointments App1
, AppHist
, Catalogs CatBase
, GP_SPCONTDOC201 GPCDoc201
, ContDoc CDoc201
// для разных запросов
//, Catalogs CatAny
//, Dogovor DogEdu
//, KatVidD VidDogEdu
// для фильтра по подразделениям
, Appointments AppStaff
, StaffStruct  StaffApp
//NIOKR
//, DopTables
, DopInfo
, Persons PsnNIOKR
//-------------
, ContDoc   CDoc236
, Education Educ236
, ContDoc   CDoc236_0
, Education Educ236_0
where
((
//    Persons.nRec       == Education.Person
//and dBegEdu           <<= Education.FromDate
    Education.Name     == ttBKEdu.cInst
and Education.cContDoc == CDoc136.nRec and (CDoc136.TypeOper = 136) //((CDoc136.TypeOper = 136) and (CDoc136.wYearPR = 1 or CDoc136.wYearPR = 2))
and      CDoc136.cPart == PDoc136.nRec
and       PDoc136.cDoc == TDoc136.nRec
and CDoc136.cStr       == App136.nRec //and (/*App136.ContractDate >= dBeg and App136.ContractDate <= dRep and*/ App136.cDog = cRecDogovor)
and App136.ResComp[1]  == Dog136.nRec
and _cRecPsn           == Persons.nRec
//-----------
and            236 == CDoc236.TypeOper
and CDoc136.Person == CDoc236.Person
and Education.nRec == CDoc236.ObjnRec and ( CDoc236.wDopAttr = 1 )
and   CDoc236.nRec == Educ236.cContDoc
and            236 == CDoc236_0.TypeOper
and CDoc136.Person == CDoc236_0.Person
and Education.nRec == CDoc236_0.ObjnRec and ( CDoc236_0.wDopAttr = 0 )
and CDoc236_0.nRec == Educ236_0.cContDoc
//-------
and Persons.nRec  == App1.Person 
and dBeg         <<= App1.AppointDate and ( App1.AppointDate <= dRep )
and App1.nRec     == AppHist.cAppoint and ( AppHist.CodOper = 1 )
and App1.nRec     == CDoc1.cStr and ( CDoc1.TypeOper = 1 )

/*
and Education.Person   == CDoc1.Person
and integer(1)         == CDoc1.TypeOper //and (CDoc1.wYearPR = 1 or CDoc1.wYearPR = 2)
and CDoc1.cStr         == App1.nRec and (App1.AppointDate >= dBeg and App1.AppointDate <= dRep and App1.lPrizn = 0 and App1.DateEnd = 0)
*/
and Education.Person   == GPCDoc201.cPerson (noindex)
and GPCDoc201.cContDoc == CDoc201.nRec //and (CDoc201.wYearPr = 1 or CDoc201.wYearPr = 2)
//-------------
and dBeg              <<= DopInfo.dFld[1] and (DopInfo.dFld[1] <= dRep and DopInfo.cDopTbl = cNIOKR)
and DopInfo.cFld[3]    == ttBKNIOKR.cInst
and DopInfo.cPerson    == PsnNIOKR.nRec
//and cDocCEduPsn     == DogEdu.nRec
//and DogEdu.cVidDog  == VidDogEdu.nRec
/*
and word(3)            == OldOrgD.wObj
and Education.Person   == OldOrgD.cParent
and Education.Person   == Badge.Person
and Education.Name     == Badge.Appoint
and integer(-24)       == Badge.BadgeYear
and integer(11)        == Badge.BadgeMonth
and Education.Person   == BadgeN.Person
and integer(2)         == BadgeN.BadgeMonth
and Education.Person   == CDoc8.Person
and integer(8)         == CDoc8.TypeOper and (CDoc8.wYearPR = 1 or CDoc8.wYearPR = 2)
and CDoc8.cStr         == App8.nRec and (App8.DismissDate >= dBeg and App8.DismissDate <= dRep)
*/
//---------
/*
and cDocCEduPsn     == DogEdu.nRec
and DogEdu.cVidDog  == VidDogEdu.nRec
*/
))
;

function sSetPodrName(mSetPdr: TPtr): string;
{
  if ( getMarkerCount(mSetPdr) = 0 )
  {
    result := 'Все подразделения';
    exit;
  }
  else
    if ( getMarkerCount(mSetPdr) = 1 )
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько подразделений (' + string(getMarkerCount(mSetPdr)) + ')';
}
