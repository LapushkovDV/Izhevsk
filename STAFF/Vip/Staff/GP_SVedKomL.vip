table struct ttPerFlt // для фильтра по персоналу
(
  cRecPers : comp
)
with index
(
  ttPerFlt01  = cRecPers
);

table struct ttHeaD
(
  nRec  : comp
, sCode : string
, sName : string
, dbItC : double  
  
)
with index
(
  ttHeaD01 = nRec(Surrogate)
, ttHeaD02 = sCode+sName
);

table struct ttTypOp
(
  wCodeOper : word
, sNameOper : string
)
with index
(
  ttTypOp01 = wCodeOper
);

table struct ttResDyn
(
  cPers : comp
, cHead : comp
, dbSum : double
)
with index
(
  ttResDyn01 = cPers + cHead
);

table struct ttResStr // статический набор данных
