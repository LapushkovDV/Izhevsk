//=============================================================================
// Заполнение данных по зарплате
// очень медленно - но пока так
Function FillZarpl :boolean;
var
  _RaiseSum:double;
  sCT, sNT : string;
  iVidOpl  :longint=0;
  iVidOplP :longint=0;

{ Result := False;
  _Loop ttVidopl
  { _RaiseSum:=GetSumOplFromZP(ttVidopl.VidOpl);
    if (not NextVisual) exit;
    if _RaiseSum=0 then continue;
    //-----------------------------
    sNT     := ttVidopl.Name;
    sCT     := ttVidopl.Code;
    iVidOpl := ttVidopl.Vidopl;
    //-----------------------------
    //clearbuffer(#ttResStr);
    if getfirst ttResStr where((ttPerFlt.cRecPers == ttResStr.cRecPers)) <> tsOk
    {
      if isvalidAll(#persons)
      {
        ttResStr.cRecPers := persons.nrec;
        ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
        ttResStr.sFIO     := persons.FIO;
        set cRecApp := iAppFunc.GetAppNrec_OnDate(persons.nrec, dEnd);
        if isvalidAll(#Appointments)
        {
          ttResStr.sDept  := iCatFunc.GetCatalogsCode(appointments.DEPARTMENT);
          if ( trim(ttResStr.sDept) = '' )
            ttResStr.sDept:= iCatFunc.GetCatalogsName(appointments.DEPARTMENT);
          ttResStr.sPost  := iCatFunc.GetCatalogsName(appointments.POST);
          if isvalidall(#ttZGDD)
            ttResStr.sDepP:= ttZGDD.sCodeZGD;
        }
        ttResStr.dBorn    := persons.BORNDATE;
        ttResStr.sStaj    := iRunStaj.RunStrStaj(persons.nrec,89,dEnd);
        if isvalid(#PINN)
          ttResStr.sINN   := PINN.NMB;
        if isvalid(#PSNILS)
          ttResStr.sSNILS := PSNILS.NMB;
        ttResStr.sIsCh   := iAppCh.State(persons.nrec,0,dEnd,12);
        insert current ttResStr;
      }
    }
    ttResStr.dbItRow += _RaiseSum; //RaiseHist.RHSUM;
    update current ttResStr;

    clearbuffer(#ttHeaD);
    if getfirst ttHeaD where ((sCT == ttHeaD.sCode  and sNT == ttHeaD.sName)) <> tsOk
    {
      ttHeaD.sCode := sCT;
      ttHeaD.sName := sNT;
      ttHeaD.dbItC := _RaiseSum; //RaiseHist.RHSUM;
      insert current ttHeaD;
    }
    else
    {
      ttHeaD.dbItC := ttHeaD.dbItC + _RaiseSum;//RaiseHist.RHSUM;
      update current ttHeaD;
    }
    //-------------------------------
    clearbuffer(#ttResDyn);
    if getfirst ttResDyn where((ttResStr.nRec == ttResDyn.cPers and ttHeaD.nRec == ttResDyn.cHead)) <> tsOk
    {
      ttResDyn.cPers := ttResStr.nRec;
      ttResDyn.cHead := ttHeaD.nRec;
      ttResDyn.dbSum := _RaiseSum;
      insert current ttResDyn;
    }
    else
    {
      ttResDyn.dbSum := ttResDyn.dbSum + _RaiseSum;
      update current ttResDyn;
    }

  } //_Loop ttVidopl
  Result := True;
} //Function FiilZarpl :boolean;

//=============================================================================
Function FillOrder :boolean;
{ Result:=False;
    ClearMarker(Marker_Raise);
    _Loop Raise
    //_loop RaiseHist
    if getfirst RaiseHist =tsok
    {
      if (not NextVisual) exit;
      //if isvalid(#Raise)
      if isvalid(#contdoc)
      if isvalid(#ttTypOp)
      if raise.OrderDate1 = RaiseHist.DOCDATE and raise.OrderDate2 = 0
      {
        // Для РПД 102 "Проезд к месту работы и обратно. Доп.соглашение" сумму берем из архива оплат
        // и результатов расчёта модуля зарплата
        // теперь и все остальное
        var sCT, sNT : string;
        var iVidOpl  :longint=0;
        var iVidOplP :longint=0;
        if getfirst ttVidopl where (( RaiseHist.cRaiseType ==   ttVidopl.cRaiseType )) <>tsok
        { sCT := iCatFunc.GetCatalogsCatData(RaiseHist.cRaiseType);
          sNT := iCatFunc.GetCatalogsName(RaiseHist.cRaiseType);
          iVidopl:= longint(Substr(sCT, 1, 5));
          if (GetFirst KlVidOpl where ((iVidOpl == KlVidOpl.VidOpl)) = tsOk)
          { sCT:=string(KlVidOpl.VidoplP,3);
            iVidOplP:=KlVidOpl.VidoplP;
          }
          else
          { sCT := iCatFunc.GetCatalogsCode(RaiseHist.cRaiseType);

          }
          insert into ttVidopl set
             ttVidopl.cRaiseType:=RaiseHist.cRaiseType
            ,ttVidopl.Name      :=sNT
            ,ttVidopl.Code      :=sCT
            ,ttVidopl.Vidopl    :=iVidopl
            ,ttVidopl.VidoplP   :=iVidoplP
            ;

        }
        else
        { sNT     := ttVidopl.Name;
          sCT     := ttVidopl.Code;
          iVidOpl := ttVidopl.Vidopl;
        }
        var _RaiseSum: double = 0;
        case ContDoc.TypeOper of
        102:
        { if not FoundMarker(Marker_Raise, iVidOpl)//RaiseHist.cRaiseType)
          {  _RaiseSum := GetSumOplFromZP(iVidOpl);
              InsertMarker(Marker_Raise,iVidOpl ); //RaiseHist.cRaiseType
          }
          else
          { _RaiseSum:=0;
          }
        } //if (ContDoc.TypeOper = 102)
        101:// сумму доплаты умножать на кол-ко месяцев действия доплаты
        { _RaiseSum := RaiseHist.RHSUM*Calc_Period(RAISEHIST.DREC,RAISEHIST.DDAT2,1);
        }
        107:// сумму доплаты рассчитать по алгоритму: сумма доплаты * кол-во полных месяцев действия доплаты + сумма доплаты/полное кол-во календарных дней в
        { _RaiseSum := RaiseHist.RHSUM*Calc_Period(RAISEHIST.DREC,RAISEHIST.DDAT2,2);
        }
        else
        { _RaiseSum := RaiseHist.RHSUM;
        }
        end;

        //clearbuffer(#ttResStr);
        if getfirst ttResStr where((ttPerFlt.cRecPers == ttResStr.cRecPers)) <> tsOk
        {
          if isvalid(#persons)
          {
            ttResStr.cRecPers := persons.nrec;
            ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
            ttResStr.sFIO     := persons.FIO;
            set cRecApp := iAppFunc.GetAppNrec_OnDate(persons.nrec, dEnd);
            if isvalid(#Appointments)
            {
              ttResStr.sDept  := iCatFunc.GetCatalogsCode(appointments.DEPARTMENT);
              if ( trim(ttResStr.sDept) = '' )
                ttResStr.sDept:= iCatFunc.GetCatalogsName(appointments.DEPARTMENT);
              ttResStr.sPost  := iCatFunc.GetCatalogsName(appointments.POST);
              if isvalid(#ttZGDD)
                ttResStr.sDepP:= ttZGDD.sCodeZGD;
            }
            ttResStr.dBorn    := persons.BORNDATE;
            ttResStr.sStaj    := iRunStaj.RunStrStaj(persons.nrec,89,dEnd);
            if isvalid(#PINN)
              ttResStr.sINN   := PINN.NMB;
            if isvalid(#PSNILS)
              ttResStr.sSNILS := PSNILS.NMB;
            ttResStr.sIsCh   := iAppCh.State(persons.nrec,0,dEnd,12);
            insert current ttResStr;
          }
        }
        ttResStr.dbItRow += _RaiseSum; //RaiseHist.RHSUM;
        update current ttResStr;

        clearbuffer(#ttHeaD);
        if RaiseHist.CRAISE <> 0
        {
          if getfirst ttHeaD where ((sCT == ttHeaD.sCode  and sNT == ttHeaD.sName)) <> tsOk
          {
            ttHeaD.sCode := sCT;
            ttHeaD.sName := sNT;
            ttHeaD.dbItC := _RaiseSum; //RaiseHist.RHSUM;
            insert current ttHeaD;
          }
          else
          {
            ttHeaD.dbItC := ttHeaD.dbItC + _RaiseSum;//RaiseHist.RHSUM;
            update current ttHeaD;
          }
        } //if RaiseHist.CRAISE <> 0
        else
        {
          if getfirst ttHeaD where ((ttTypOp.wCodeOper == ttHeaD.sCode  and ttTypOp.sNameOper == ttHeaD.sName)) <> tsOk
          {
            ttHeaD.sCode := ttTypOp.wCodeOper;
            ttHeaD.sName := ttTypOp.sNameOper;
            ttHeaD.dbItC := _RaiseSum;//RaiseHist.RHSUM;
            insert current ttHeaD;
          }
          else
          {
            ttHeaD.dbItC := ttHeaD.dbItC +_RaiseSum;// RaiseHist.RHSUM;
            update current ttHeaD;
          }
        } // else if RaiseHist.CRAISE <> 0
        //-------------------------------
        clearbuffer(#ttResDyn);
        if getfirst ttResDyn where((ttResStr.nRec == ttResDyn.cPers and ttHeaD.nRec == ttResDyn.cHead)) <> tsOk
        {
          ttResDyn.cPers := ttResStr.nRec;
          ttResDyn.cHead := ttHeaD.nRec;
          ttResDyn.dbSum := _RaiseSum;
          insert current ttResDyn;
        }
        else
        {
          ttResDyn.dbSum := ttResDyn.dbSum + _RaiseSum;
          update current ttResDyn;
        }
      } //if raise.OrderDate1 = RaiseHist.DOCDATE and raise.OrderDate2 = 0
    } //if getfirst RaiseHist


  Result:=true;
} //Function FiilOrder :boolean;

//=============================================================================
// основной запуск
procedure Run;
var
   vliErrorCode : longint;
   ww_Str:string;
{
  timelog('#(GPInt)->Run:Start');
  //------------------
  MtClear(#ttVidopl,mfNormal );
  MtClear(#ttSum   ,mfNormal );
  //------------------
  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);
  //-----------------
  if (VCommonFiltr.GetPsnCount = 0)
    VCommonFiltr.SelectAllPsn;

  if (getfirst TypePr where TypePr.NOPER = 'Компенсации и льготы') = tsOk
  {
    cKomL := TypePr.nRec;
    _loop TypePr where TypePr.CTDOP = cKomL
    {
      clearbuffer(#ttTypOp);
      ttTypOp.wCodeOper := TYPEPR.CODOPER;
      ttTypOp.sNameOper := TYPEPR.NOPER;
      insert current ttTypOp;
    }
  }

//---------------
  RestartVisual('Заполняю таблицу фильтров',1);
  PersMarker := InitMarker('',8,200,100);
  PersMarker := VCommonFiltr.GetPersonsMarker;
  kol:=  GetMarkerCount(PersMarker);
  i := 0;
  //-----------------
  if wTypeRep=1
  { sqlDropTmpTable ( 'TEMPVIB' ); //На всякий случай дропнем
    sqlCreateTmpTable ( 'Table TEMPVIB ( WLIST:word, CREC:comp,wVidopl:word) with index (a1 = wlist+crec);', ctmNormal );
    Fill_ttVidopl(0);

  } //if wTypeRep=1
  while i < kol
  {
    GetMarker(PersMarker, i, cPersNRec);
    insert ttPerFlt set ttPerFlt.cRecPers := cPersNRec;
    i++;
    if wTypeRep=1
    { ww_Str:='insert into TEMPVIB (WLIST,CREC,wVidopl) values ('+string(1)+', #comp('+string(cPersNRec)+'),0 )';
      vliErrorCode:=sqlExecDirect(ww_str);
    }
    if (not NextVisual) break;
  }
  
  FillZGD;
  
  RestartVisual('Идет сбор данных',1);
  if isvalid(#ttPerFlt)
  _loop ttPerFlt
  {
    if wTypeRep=1 // Зарплата
    { if not FillZarpl break;
    }
    else
    { if not FillOrder break;
    }
  } //_loop ttPerFlt
  timelog('#(GPInt)->Run:Report '+string(RecordsInTable(#ttResStr)));

  //==============================
  if isvalid(#ttResStr)
  {
    RestartVisual('Выгружаю данные',1);
    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xls';

    xlCreateExcel(sFullName, TRUE);
    lRB  := 4;
    lRow := 1;
    lDB  := lDE := lRB + 3;
    lCB  := 1;
    lCE  := 1;

    iOut.xlR1C1OnOff(true);
    iOut.StringValL
    (
      '#(GPNam) за период с '+datetostr(dBeg,'DD.MM.YYYY')+' по '+datetostr(dEnd,'DD.MM.YYYY'),2,3,2,3
    );
    xlSetFontSize(14,2,3,2,3); xlSetFontStyle(xlBold,2,3,2,3);

    #define FrmHdr lRB,lCE,lRB,lCE
    iOut.Header3Row('№ п/п',                      #FrmHdr); lCE++;
    iOut.Header3Row('Таб. Ном.',                  #FrmHdr); lCE++;
    iOut.Header3Row('ФИО',                        #FrmHdr); lCE++;
    iOut.Header3Row('Подраз-'+chr(10)+'деление (код)',  #FrmHdr); lCE++;
    iOut.Header3Row('Код вышест.'+chr(10)+'подразд.',   #FrmHdr); lCE++;
    iOut.Header3Row('Должность',                  #FrmHdr); lCE++;
    iOut.Header3Row('Дата рождения',              #FrmHdr); lCE++;
    iOut.Header3Row('Стаж работы на предприятии', #FrmHdr); lCE++;
    iOut.Header3Row('СНИЛС',                      #FrmHdr); lCE++;
    iOut.Header3Row('ИНН',                        #FrmHdr); lCE++;
    iOut.Header3Row('Изменение'+chr(10)+'условий',#FrmHdr); lCE++;
    iOut.Header3Row('Итого компенсаций и льгот',  #FrmHdr); lCE++;

    if isvalid(#ttHeaD)
    _loop ttHeaD ordered index ttHeaD02
    {
      iOut.Header1Row(ttHeaD.sName,        lRB+1,lCE,lRB+1,lCE);
      iOut.Header1Row('В/о '+ttHeaD.sCode, lRB+2,lCE,lRB+2,lCE); lCE++;
    }
    iOut.HeaderIns('Суммы компенсаций и льгот по видам',lRB,13,lRB,13, lCE-13);

    #define FrmCl lDE,lSE,lDE,lSE
    _loop ttResStr ordered index ttResStr02
    {
      if (not NextVisual) break;

      lSB := lSE := 1;
      iOut.IntegerVal(lRow,            #FrmCl); lSE++;
      iOut.CodeVal   (ttResStr.sTbNmb, #FrmCl); lSE++;
      iOut.StringValL(ttResStr.sFio,   #FrmCl); lSE++;
      iOut.CodeVal   (ttResStr.sDept,  #FrmCl); lSE++;
      iOut.CodeVal   (ttResStr.sDepP,  #FrmCl); lSE++;
      iOut.StringValL(ttResStr.sPost,  #FrmCl); lSE++;
//       iOut.DateVal   (ttResStr.dBorn,  #FrmCl); lSE++;
      xlSetCellDateValue(ttResStr.dBorn,  #FrmCl); lSE++;
      iOut.StringValR(ttResStr.sStaj,  #FrmCl); lSE++;
      iOut.StringValC(ttResStr.sSNILS, #FrmCl); lSE++;
      iOut.CodeVal   (ttResStr.sINN,   #FrmCl); lSE++;
      iOut.StringValC(ttResStr.sIsCh,  #FrmCl); lSE++;
      iOut.FormulaDoubleVal('=СУММ(R'+lDE+'C'+13+':R'+lDE+'C'+(lCE-1)+')',#FrmCl); lSE++;
      if isvalid(#ttHeaD)
      _loop ttHeaD ordered index ttHeaD02
      {
        if getfirst ttResDyn where((ttResStr.nRec == ttResDyn.cPers and ttHeaD.nRec == ttResDyn.cHead)) = tsOk
        {
          iOut.DoubleVal(ttResDyn.dbSum,#FrmCl);
        }
        lSE++;
      }
      lDE++;
      lRow++;
    }

    iOut.StringValR('Итого:',lDE,3,lDE,3);
    lSE := 13;

    var dbTotalIt : double;
    dbTotalIt:=0;

    if isvalid(#ttHeaD)
    _loop ttHeaD ordered index ttHeaD02
    {                            // FrmCl lDE,lSE,lDE,lSE
      iOut.FormulaDoubleVal('=СУММ(R'+lDB+'C'+lSE+':R'+(lDE-1)+'C'+lSE+')',#FrmCl); lSE++;
      dbTotalIt := dbTotalIt+ttHeaD.dbItC;
    }
    iOut.FormulaDoubleVal('=СУММ(R'+lDB+'C'+12+':R'+(lDE-1)+'C'+12+')',lDE,12,lDE,12);

    lSE := 1;
    #define FrmBl lDB,lSE,lDE,lSE
    xlSetColumnWidth( 5,#FrmBl); lSE++;
    xlSetColumnWidth( 8,#FrmBl); lSE++;
    xlSetColumnWidth(30,#FrmBl); lSE++;
    xlSetColumnWidth(10,#FrmBl); lSE++;
    xlSetColumnWidth(10,#FrmBl); lSE++;
    xlSetColumnWidth(30,#FrmBl); lSE++;
    xlSetColumnWidth(10,#FrmBl); lSE++;
    xlSetColumnWidth(24,#FrmBl); lSE++;
    xlSetColumnWidth(14,#FrmBl); lSE++;
    xlSetColumnWidth(14,#FrmBl); lSE++;
    xlSetColumnWidth(14,#FrmBl); lSE++;
    xlSetColumnWidth(14,#FrmBl); lSE++;
    
    xlSetColumnWidth(14,lRB,12,lDE,lCE);

    xlSetFontSize(11,lRB,lCB,lDE,lCE); xlSetFontStyle(xlBold,lRB,lCB,lRB+2,lCE); xlSetFontStyle(xlBold,lDE,1,lDE,lCE);
    xlWrapText(lRB,lCB,lRB+2,lCE);
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0,lRB,lCB,lDE,lCE-1);
    iOut.StringValL('Ответственный исполнитель: '+sGetTune('User.FIO'),lDE+2,3,lDE+2,3);
    xlSetFontSize(11,lDE+2,3,lDE+2,3); xlSetFontStyle(xlBold,lDE+2,3,lDE+2,3);
    iOut.xlR1C1OnOff(false);
    iOut.TitleEachPage(lRB,lDB-1,'#(GPInt)');
    xlFreeze(7,6);
    xlKillExcel;
  } //if isvalid(#ttResStr)
  else
  {
    message('Нет данных для формирования отчета!');
  }
  StopVisual;
  timelog('#(GPInt)->Run:finish');

} //procedure Run;


//**********************************************************
Screen s1(,,sci1Esc);
  show at (,,85,4);
  fields
    dBeg ('Начало периода',,):{Font = {BackColor = if(dBeg = 0, ColorNeed, 0)}}, noprotect;
    dEnd ('конец периода',,): {Font = {BackColor = if(dEnd = 0, ColorNeed, 0)}}, noprotect;
    wTypeRep   : NoProtect;
  << 'Параметры отчета'
   `Период отчета`    .@@@@@@@@@@ .@@@@@@@@@@@
        (.)  По РПД`
        (.)  По Зарплате`
  >>
end;  
embedded ComFiltrEmbedded 'Фильтры' interface VCommonFiltr;
  show (,5,85,10);
end
Screen s2(,,sci1Esc);
  show (,11,85,12);
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
  <<
     <. ~С~формировать .>                         <. ~З~акрыть .>
  >>
end;

handleevent
  cmInit:
  { timelog_init;
    if (not (ReadMyDsk(dBeg, '#(GPInt)_dBeg', false)))
      dBeg := date(1,1,year(Cur_Date));
    if (not (ReadMyDsk(dEnd, '#(GPInt)_dEnd', false)))
      dEnd := date(31,12,year(Cur_Date));
    wTypeRep:=0;
    if (not (ReadMyDsk(wTypeRep, '#(GPInt)_wTypeRep', false)))
      wTypeRep := 0;
    dOtchPer      := dGetTune('Up.DatOtch');
    MadeReport:= false;
    Marker_Raise:=InitMarker('', 8, 50, 10, True);

  }
  cmDone:
  { DoneMarker(Marker_Raise,'');


  }
  cmOk:
  {
    if (dBeg = 0) or (dEnd = 0) or (dBeg > dEnd)
    {
      message('Задан некорректный период!');
    }
    else
    {
      Run;
      SaveMyDsk(dBeg    , '#(GPInt)_dBeg'    );
      SaveMyDsk(dEnd    , '#(GPInt)_dEnd'    );
      SaveMyDsk(wTypeRep, '#(GPInt)_wTypeRep');

      MadeReport:= true;
      VCommonFiltr.IntClose(MadeReport);
      VCommonFiltr.StoreAllParams;
      Notify(cmEvaluateAndModify, 0);
    
      closeinterface(cmDefault);
    }
  }
  cmCancel:
  {
    VCommonFiltr.IntClose(MadeReport);
  }
end;
end.



VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;

Procedure Run;
Begin
  runinterface(#(GPInt));
End;
!-------------------------------------------------------------------------------
! Наименование отчета в списке
!-------------------------------------------------------------------------------
Function GetReportName: String;
Begin
  GetReportName := '#(GPNam) (ЭМ)';
End;

!-------------------------------------------------------------------------------
! Наименования групп, в которые входит отчет
!-------------------------------------------------------------------------------
Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Компенсации и льготы';
  End;
End;

!-------------------------------------------------------------------------------
! Приоритет отчета - сортировка внутри группы выполняется сначала
! по приоритету, а затем по наименованию
!-------------------------------------------------------------------------------
function GetPriority : Integer;
begin
  GetPriority := 3;
end;

!-------------------------------------------------------------------------------
! ModuleID модулей, в которых будет виден отчет
! '*' - отчет будет виден в любом модуле
!-------------------------------------------------------------------------------
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
//    2 : VisibleInModule := 'STAFFMAINMENU2';
  end;
end;

!-------------------------------------------------------------------------------
End.
