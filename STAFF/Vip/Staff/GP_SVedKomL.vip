//======================================
var
  dBeg, dEnd    : date;
  dOtchPer      : date; // dGetTune('Up.DatOtch')
  VCommonFiltr  : CommonFiltr; // Для встраивания фильтра по подразделениям / сотрудникам
  MadeReport    : boolean;
  PersMarker    : TPtr;
  iCatFunc      : CatalogsFunctions;
  iAppFunc      : AppointmentsFunctions; // cAppOnDate iAppFunc
  iRunStaj      : Runstaj;
  iOut          : GP_XlOutExt;
  i3GD          : GP_3GD;
  iAppCh        : GP_AppChange;
  sFullName     : string;
  lRB, lRE,
  lCB, lCE,
  lSB, lSE,
  lDB, lDE,
  lRow          : longint;
  wTypOper      : word;
  Marker_Raise  : longint;
  wTypeRep      : word;//0 - по РДП, 1 - по зарплате
create view
var
  cMainLinkDept : comp;
  cRecApp       : comp;
as select persons.nrec
from
  persons
, Appointments
, passports PINN
, passports PSNILS
, raisehist
, raise
, TYPEPR
, ttPerFlt
, ttResStr
, ttTypOp
, ttHeaD
, ttResDyn
, contdoc
, Catalogs ZGDDept
, ttZGD
, ttZGD ttZGDD
, KlVidOpl
, SumVidOp
, Nachisl
, ttVidopl
, ttSum
where
((
     ttPerFlt.cRecPers == persons.nrec
and  ttPerFlt.cRecPers == Raise.Person
and  Dend >>= Raise.FROMDATE
and  DBeg <<= Raise.FROMDATE // иначе полис ДМС попадает дважды
and  (  ( Raise.TODATE=ZeroDate
    and   Raise.DRABORT=ZeroDate
        )
   or  ( dBeg<= Raise.TODATE)
   or  ( dBeg<= Raise.DRABORT)
    )
//and  ttPerFlt.cRecPers == raisehist.CPSN
and Raise.Nrec == raisehist.CRAISE
/*
and (
//        raisehist.DOCDATE >= dBeg
//    and raisehist.DOCDATE <= dEnd
        RAISEHIST.DREC >= dBeg
    and RAISEHIST.DREC <= dEnd
    )
 and   raisehist.cRaise == raise.nrec
*/
and raisehist.cContDoc == contdoc.nrec
and   ContDoc.TypeOper == ttTypOp.wCodeOper

and ttPerFlt.cRecPers == PINN.person
and integer(505)      == PINN.syscode
and ttPerFlt.cRecPers == PSNILS.person
and integer(501)      == PSNILS.syscode

and cRecApp                 == Appointments.nRec
and appointments.DEPARTMENT == ttZGDD.cRecDept

and integer(0)    == ZGDDept.LPr
and cMainLinkDept == ZGDDept.MainLink
and ZGDDept.nRec  == ttZGD.cRecDept

and Persons.NRec  == LSchet.tPerson
))
;

//=========================================
Create view vCatalogs
Var
  pCatParent:comp;
From
  Catalogs
 ,Catalogs CatMain
where ((
     -17        == CatMain.SysCode
 and pCatParent == Catalogs.cParent
));

//=========================================
function sFPF : string;
{  sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');
}


//=========================================
Procedure Fill_ttVidopl(_pParent:comp);
var
   vliErrorCode : longint;
   ww_Str:string;
{ if _pParent=0
  { if vCatalogs.getfirst CatMain<>tsok exit;
    _pParent:=vCatalogs.CatMain.Nrec;
  }
  var sCT, sNT : string;
  var iVidOpl  : longint=0;
  var _pNrec   : comp=0;
  vCatalogs.pCatParent:=_pParent;
  vCatalogs._Loop Catalogs
  { if _pParent=vCatalogs.CatMain.Nrec
    { if vCatalogs.Catalogs.Name<>'Компенсации и льготы' continue;
    } //if _pParent:=vCatalogs.CatMain.Nrec
    //-------------------------------
    _pNrec:=vCatalogs.Catalogs.Nrec;
    //-------------------------------
    Fill_ttVidopl(_pNrec);
    //-------------------------------
    vCatalogs.pCatParent:=_pParent;
    if vCatalogs.Getfirst Catalogs where (( _pNrec == Catalogs.Nrec )) =tsok {}
    //-------------------------------
    sCT := iCatFunc.GetCatalogsCatData(_pNrec);
    if sCT='' then continue;
    sNT := iCatFunc.GetCatalogsName(_pNrec);
    iVidopl:= longint(Substr(sCT, 1, 5));
    if iVidopl=0 then continue;
    if getfirst ttVidopl where (( iVidopl == ttVidopl.Vidopl )) <>tsok
    { if (GetFirst KlVidOpl where ((iVidOpl == KlVidOpl.VidOpl)) = tsOk)
      { sCT:=string(KlVidOpl.VidoplP,3);
        sNT:=KLVIDOPL.NVIDOPL;
        Insert into ttVidopl set
             ttVidopl.cRaiseType:=_pNrec
            ,ttVidopl.Name      :=sNT
            ,ttVidopl.Code      :=sCT
            ,ttVidopl.Vidopl    :=iVidopl
            ,ttVidopl.VidoplP   :=KlVidOpl.VidoplP
            ;
        timelog('#(GPInt)->Fill_ttVidopl:ttVidopl.Name='+ttVidopl.Name+', Vidopl='+string(ttVidopl.Vidopl)+',VidoplP='+string(ttVidopl.VidoplP));
        ww_Str:='insert into TEMPVIB (WLIST,CREC,wVidopl) values ('+string(2)+', #comp(0),'+string(iVidopl)+')';
        vliErrorCode:=sqlExecDirect(ww_str);

      }
    }//if getfirst ttVidopl (( iVidopl == ttVidopl.Vidopl )) <>tsok
  } //vCatalogs._Loop Catalogs
} //Procedure Fill_ttVidopl(_pParent:comp);

//=========================================
procedure FillZGD;
{
  set cMainLinkDept := iCatFunc.GetCatalogsNRec(-11);
  RestartVisual('Заполняю описатель иерархии ЗГД',1);
  i3GD.Init3GD;
  if isvalid(#ZGDDept)
  _loop ZGDDept
  {
    if (not NextVisual) break;
    if not isvalid(#ttZGD)
    {
      ClearBuffer(#ttZGD);
      ttZGD.cRecDept := ZGDDept.nRec;
      ttZGD.sCodeZGD := i3GD.sCode3GD(ZGDDept.nRec);
      insert current ttZGD;
    }
  }
} //procedure FillZGD;

// Рассчитывает сумму всех оплат с указанным пользовательским кодом в архиве оплат
// и результатов расчёта модуля зарплата
function GetSumOplFromZP(_VidOplS: longint): double;
{
  result := 0;
  //if (getFirst KlVidOpl where((_VidOplS == KlVidOpl.VidOplS)) != tsOk)
  //  exit;
  var DtOpl: Date;
  var _YearB:word=year(dBeg);
  var _YearE:word=year(dEnd);
  _loop LSchet
  {
    // Считаем сумму по всем записям по указанной оплате, попадающим в отчетный период, в архиве оплат
    _loop SumVidOp where ((
         LSchet.NRec == SumVidOp.cLSch
     and _YearB <<= SumVidOp.YearN
     and _YearE >>= SumVidOp.YearN
     and _VidOplS == SumVidOp.VidOpl (noindex)
    ))
    {
      DtOpl := To_Date(1, SumVidOp.MesN, SumVidOp.YearN);
      if (DtOpl > dEnd or DtOpl < dBeg)
        continue;
      result += SumVidOp.Summa;
    }
    // Считаем сумму по всем записям по указанной оплате, попадающим в отчетный период, в результатах расчёта
    if dEnd >=dOtchPer
    _loop Nachisl where ((
         LSchet.NRec == Nachisl.cLSch
     and  _VidOplS    == Nachisl.VidOplS(noindex)
    )) //and Nachisl.VidOplS = KlVidOpl.VidOpl
    {
      DtOpl := To_Date(1, Nachisl.MesN, Nachisl.YearN);
      if (DtOpl > dEnd or DtOpl < dBeg)
        continue;
      result += Nachisl.Summa;
    }
  }
} //function GetSumOplFromZP(_VidOplP: longint): double;

//=============================================================================
// Рассчитать кол во периодов
function Calc_Period(_DTB,_DTE:date; _wType:word) :double;
{
  Result:=0;
  if _DTE<_DTB then exit;
  var _MonB : word = Month(_DTB);
  var _MonE : word = Month(_DTE);
  var _YearB: word = Year(_DTB);
  var _YearE: word = Year(_DTE);
  case _wType of
  1: //101 сумму доплаты умножать на кол-ко месяцев действия доплаты
  { Result:=(_YearE-_YearB)*12+(1+_MonE-_MonB);
  }
  2: //107 сумму доплаты рассчитать по алгоритму:
     //сумма доплаты * кол-во полных месяцев действия доплаты
     //+ сумма доплаты* кол-во календарных дней действия доплаты в неполных месяцах
     //            /полное кол-во календарных дней в неполных месяцах действия доплаты
  { var _wdtb:date=_DTB; // стартовая дата
    var _dn1 :word=0; //кол-во календарных дней действия доплаты в неполных месяцах
    var _dn2 :word=0; //полное кол-во календарных дней в неполных месяцах действия доплаты
    var _Last:word=0;
    var _wdte:date;
    do
    { _Last:=Last_Day(_wdtb);
      _wdte:=Date(_Last,Month(_wdtb),Year(_wdtb));
      if _wdte>_DTE _wdte:=_DTE;
      if day(_wdtb)<>1 or Day(_wdte)<>_Last
      { _dn1 += 1+Day(_wdte)-day(_wdtb);
        _dn2 += _Last;
      } //if day(_wdtb)<>1 or Day(_wdte)<>_Last
      else
      { Result+=1.00;
      }
      _wdtb:=add_months(_wdtb,1);
      _wdtb:=Date(1,Month(_wdtb),Year(_wdtb));
    } while _wdtb<=_DTE;
    // есть неполные месяца
    if _dn2>0
       Result+= _dn1/_dn2;
  } //2
  end; //case _wType
} //function Calc_Period(_DTB,_DTE:date; _wType:word) :double;

