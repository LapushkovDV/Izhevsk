#component "Z_Staff"
VipInterface Recwin04_history Licensed(Free) parameters (cparent:comp);


Interface Recwin04_history 'История семеного положения'  gray;
  show at (,, 45, 10);

create view
var
  cparent:comp;
as select *
from
  em_unidoc_head euh
where
((
  word(777) == euh.wtype and
  word(25001) == euh.WPARENTTABLE and
  cparent == euh.cparentdoc
));
Parameters cparent;
Browse WIN_History (,,sci1Esc);
 table euh;
 fields
   euh.adddate[1]    'Дата ввода','изменений': [10],protect;
   euh.addstring[1]  'Семейное положение'    : [25],protect;
 end;

end.
