#include CatFunc.vih         // Функции работы с Catalogs
#include StrFunc.vih         // Функции работы со строками
#include DeptIer.vih         // Функции работы с подразделениями
#include AppFuncs.vih
#include FeeSigners.vih

#define RD 107 //#(RD)

#doc
Печать группового приказа "Компенсации и льготы. Компенсация стоимости гостиничных услуг" РД #(RD)
#end
interface GP_NFormRD#(RD) 'Компенсации и льготы. Компенсация стоимости гостиничных услуг' (,,scStaffEmplMain) EscClose;
  show at (00,05,80,15);

table struct ttReport
(
  sPodr   : string
, sTbNmb  : string
, sFIO    : string
, sPost   : string
, sDogN   : string
, dbKomp  : double
, dbUder  : double
, sSpoOp  : string
, wSpoOp  : word
, sPeriod : string
)
with index
(
  ttReport01 = sFIO
);

table struct mtSigners
(
  wIdx:  word
, sPost: string
, sFIO:  string
)
with index
(
  mtSigners01 = wIdx
);

#include FeeSigners.var

Create view MakeReport1View
var
  cDoc:        comp;
  PersNrec:    comp;
  iOper:       integer;
  sSigner:     string;
  iCatFunc:    CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  iStrFunc:    StringFunctions;     // Переменная типа интерфейс StringFunctions
  iAppFunc:    AppointmentsFunctions;
  IDepartIer:  DepartIer;           // Переменная типа интерфейс DepartIer

as  select
  *

from
  Persons
, Appointments
, TitleDoc
, PartDoc
, ContDoc
, GP_RaiseHistExt#(RD)
, Catalogs CatSposobOplaty
, ttReport (ttReport01)
, mtSigners (mtSigners01)

where
((              cDoc == TitleDoc.Nrec             
and            iOper == PartDoc.TypeOper          
and    TitleDoc.Nrec == PartDoc.cDoc              
and     PartDoc.Nrec == ContDoc.cPart             
and PartDoc.TypeOper == ContDoc.TypeOper
and   ContDoc.Person == Persons.Nrec              
and     ContDoc.cStr == Appointments.Nrec         
and     ContDoc.Nrec == RaiseHist.cContDoc        
and   RaiseHist.nrec == GP_RaiseHistExt#(RD).cRaiseH
and GP_RaiseHistExt#(RD).cSposOpl == CatSposobOplaty.nRec
))
;
parameters cDoc, iOper;

DataStream DTS_NForm#(RD)
(
  [RepOnDate]    DateToStr(TitleDoc.DocDate,'month') + ' ' +DateToStr(TitleDoc.DocDate,'YYYY') + ' года.';
  [NoPric]       TitleDoc.DocNmb;
  [DtPric]       if(TitleDoc.DocDate<>0,DateToStr(TitleDoc.DocDate,'DD.MM.YYYY'),'');
  [sSignPost]    iAppFunc.GetAppPost(iAppFunc.GetAppNrec_OnDate(coGetTune('UP.STAFF.SIGNATORYAUTHORITY'),cur_date));
  [sSignFIO]     iStrFunc.GetFIO(sGetTune('UP.STAFF.SIGNATORYAUTHORITY'));
  [Exec]         sGetTune('User.FIO');

  table ttReport
  (
    [CodePodr]  ttReport.sPodr; 
    [TabNmb]    ttReport.sTbNmb;
    [FIO]       ttReport.sFIO;
    [Post]      ttReport.sPost;
    [NoDogGost] ttReport.sDogN;
    [SumKomp]   ttReport.dbKomp;
    [SumUder]   ttReport.dbUder;
    [SposOplat] ttReport.sSpoOp;
    [TypeOpl]   ttReport.wSpoOp;
    [Period]    ttReport.sPeriod;
  );

  table mtSigners
  (
    [sPostSign]  mtSigners.sPost; 
    [sFIOSign]   iStrFunc.GetFIO(mtSigners.sFIO);
  );
)
end;

Window winSign 'Выбор подписантов';
Show At (,, 70, 7);
  Screen s1(,,sci1Esc);
    fields
      sSigner('Подписанты',,sci13Esc): {Font = {BackColor = if(sSigner = '', ColorNeed, 0)}}, protect;
    buttons
      cmOk,,,'Запуск',,;
      cmCancel,,,'Выход',,;
    << 'Параметры отчета'

     `Подписанты`
      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     <. ~С~формировать .>                         <. ~З~акрыть .>
    >>
  end;
handleevent
  cmPick:
  {
    Case CurField of
      #sSigner:
        if iFeeSigners.RunMainWindow(1)
          set sSigner := iFeeSigners.GetFeeSignersName;

    end;
  }
  cmDelOnProtect:
  {
    case CurField of
      #sSigner:
        set sSigner := '';
    end;
  }
  cmOk:
  {
    if trim(sSigner) <> '' 
      CloseWindowEx(winSign, cmDefault)
    else
      message('Не заданы подписанты!', Error);
  }
  cmCancel:
  {
    CloseWindowEx(winSign, cmCancel);
  }
end;
end;

procedure InsertFeeSignersList(_wIdx: word; _sPost: string; _sFIO: string);
{
  ClearBuffer(#mtSigners);
  mtSigners.wIdx  := _wIdx;
  mtSigners.sPost := _sPost;
  mtSigners.sFIO  := _sFIO;
  if (insert current mtSigners <> tsOk) {}
}

procedure MakeFeeSignersList;
var
  sPostCur, sFIOCur: string = '';
{
  iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigner);
  if iFeeSigners.FeeSignersIsValid
  {
    if iFeeSigners.RestrictFeeByRole(1, cgRole_UtvLico)
      if iFeeSigners.GetSignerFirst
      {
        sPostCur := iFeeSigners.GetSignerPosition(1);
        sFIOCur  := iFeeSigners.GetSignerFIO(cgCommisFIOManual1);
        InsertFeeSignersList(1, sPostCur, sFIOCur);
      }
    iFeeSigners.ClearRestriction;
    if iFeeSigners.RestrictFeeByRole(1, 1002)
      if iFeeSigners.GetSignerFirst
      {
        sPostCur := iFeeSigners.GetSignerPosition(1);
        sFIOCur  := iFeeSigners.GetSignerFIO(cgCommisFIOManual1);
        InsertFeeSignersList(2, sPostCur, sFIOCur);
      }
    iFeeSigners.ClearRestriction;
    if iFeeSigners.RestrictFeeByRole(1, cgRole_Otvetstv)
      if iFeeSigners.GetSignerFirst
      {
        sPostCur := iFeeSigners.GetSignerPosition(1);
        sFIOCur  := iFeeSigners.GetSignerFIO(cgCommisFIOManual1);
        InsertFeeSignersList(3, sPostCur, sFIOCur);
      }
    iFeeSigners.ClearRestriction;
  }
}

//──────────────────────────────────────────────────────────────────────────────
//  печать в FasrReport
//──────────────────────────────────────────────────────────────────────────────
Procedure PrintNForm#(RD)FR;
{
  if isvalid(#TitleDoc)
  if isvalid(#PartDoc)
  _loop PartDoc
  {
    if isvalid(#ContDoc)
    _loop ContDoc
    {
      if isvalid(#RaiseHist)
      _loop RaiseHist
      {
        ClearBuffer(#ttReport);
        if isvalid(#Persons)
        {
          ttReport.sTbNmb:= if (Appointments.lPrizn = 0, GetStrTabn(Persons.TabNmb,Persons.StrTabn), 
                                                         GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN));
          ttReport.sFIO  := Persons.FIO;    
        }
        if isvalid(#Appointments)
        {
//          ttReport.sPodr := IDepartIer.GetCodeOnDate(Appointments.Department,if (Day(TitleDoc.DocDate) > 0, TitleDoc.DocDate, Cur_Date));
          ttReport.sPodr := SubStr(iCatFunc.GetCatalogsCode(Appointments.Department),1,3);
          ttReport.sPost := if ( boGetTune('UP.STAFF.USE_LONGNAME_ANK'),trim(iCatFunc.GetCatalogsLongName(Appointments.Post)),
                                                                        trim(iCatFunc.GetCatalogsName(Appointments.Post)));
        }
        ttReport.dbKomp  := RaiseHist.RHSUM;
        ttReport.sPeriod := if(RaiseHist.dRec<>0 ,  'с '+datetostr(RaiseHist.dRec ,'DD.MM.YYYY'),'')
                           +if(RaiseHist.dDat2<>0,' по '+datetostr(RaiseHist.dDat2,'DD.MM.YYYY'),'');
        if isvalid(#GP_RaiseHistExt#(RD))
        {
          ttReport.sDogN := GP_RaiseHistExt#(RD).NumDog;
          ttReport.dbUder:= GP_RaiseHistExt#(RD).SummaMes;  
          ttReport.sSpoOp:= iCatFunc.GetCatalogsName(GP_RaiseHistExt#(RD).cSposOpl);
          ttReport.wSpoOp:= if(pos('из зарплаты',ttReport.sSpoOp)<>0,1,0) ;
        }
        insert current ttReport;
      }
    }
  }
  RunFReport(DTS_NForm#(RD), '', False);
}

//──────────────────────────────────────────────────────────────────────────────
HandleEvent
cmInit:
  {
    if (not (ReadMyDsk(sSigner, 'RPD107_sSigner', false)))
      sSigner:=sGetTune('UP.Staff.SignatoryAuthority');
    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);
    if (not iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigner))
      sSigner:='';

    if (RunWindowModal(winSign) = cmDefault)
    {
      MakeFeeSignersList;
      PrintNForm#(RD)FR;
    }
    SaveMyDsk(sSigner, 'RPD107_sSigner');
    CloseInterface(cmDefault);
  }       // cmInit
end;      // HandleEvent
end.
