#include GP_RKStat.vih
#include GP_UDR_RKStat.vih

//Интерфейс для вызова отчетов GP_RKStat

Interface GP_RKStat 'Отчетные формы "Роскосмоса"' EscClose, Cyan;
Show at (1,1,100,45);

const
  IfcPrefix  = 'GP_RKStat_';
#ifdef ComponentVersion
  ObjIfcName = 'GP_STAFF::IGP_RKStat';
#else
  ObjIfcName = 'IGP_RKStat';
#end
end;

Table Struct GP_RKStatList
(
   NRec          : comp
  ,ReportName    : string//[100]
  ,InterfaceName : string[50]
  ,Priority      : integer
  ,dRepOnDate    : date
  ,isParOk       : boolean
)
with index
(
   tiGP_RKStatList01 = NRec (Unique, Surrogate)
  ,tiGP_RKStatList02 = Priority + ReportName
);

var
  GP_RKStat : IGP_RKStat;
  iUDR      : GP_UDR_RKStat;
  wToExistFile : word;
  sToExistFile : string;
  mRepSelected : tPtr;
  wFromExistFile  : word;
  sFromExistFile  : string;

create view vGP_RKStat
as select

  if (IsValid(tnGP_RKStatList),
   (if (FoundMarker(mRepSelected, GP_RKStatList.NRec) = True, '√',' ')),
   ' ')
   (FieldName = isRepMarked),

  if(GP_RKStatList.isParOk,'да','нет') (fieldname = sSetParam)
  ,
  *
from
   GP_RKStatList        (tiGP_RKStatList02)
;

procedure AddReport(ReportName, InterfaceName : string; Priority : integer; dRepOnDate : date; isParOk : boolean);
{
  clearbuffer(#GP_RKStatList);
  GP_RKStatList.ReportName    := ReportName;
  GP_RKStatList.InterfaceName := InterfaceName;
  GP_RKStatList.Priority      := Priority;
  GP_RKStatList.dRepOnDate    := dRepOnDate;
  GP_RKStatList.isParOk       := isParOk;
  insert current GP_RKStatList;
}

function MakeGP_RKStatList: boolean;
var
  ImpCount, i : integer;
  sRepName    : string;
{
  MakeGP_RKStatList := false;
  if (not LoadImplementationList(ObjIfcName, IfcPrefix)) {
    Message('Не удалось загрузить список отчетов', Error + OkButton);
    Exit;
  }
  ImpCount := GetImplementationCount;
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Загрузка списка отчетов', ImpCount);
  _try 
  {
    for (i := 0; i < ImpCount; i := i + 1) 
    {
      if GetVipRef(GP_RKStat, GetImplementationName(i)) 
      {
        sRepName := GetImplementationName(i);
        GP_RKStat.initRKStatRepParam;
        AddReport(GP_RKStat.GetReportName, sRepName, GP_RKStat.GetPriority, GP_RKStat.dRepOnDateParam, GP_RKStat.isCheckRepParam(false));
        FreeVipInterface(GP_RKStat);
      }
      NextVisual;
    }
  }
  _except on ExUserBreak : {}
  _finally
    StopVisual('', 0);
  UnloadImplementationList;
  if RecordsInTable(#GP_RKStatList) = 0 {
    Message('Нет отчетов', OkButton);
    Exit
  }
  MakeGP_RKStatList := true;
}

function OpenNewRKS : boolean;
{
  result := false;
  sToExistFile := TranslatePath('%ClientStartPath%') +'XLS_ЭМ\Staff\RKStat.xltm';
  if xlCreateExcelWithTemplate(sToExistFile, true)
    result := true;
}
function OpenExistRKS : boolean;
{
  result := false;
  if xlOpenExcel(true)
  {
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlGetActiveWorkBookName('Книга1')
      xlCloseWorkBookByName('Книга1');
    // только ради того, чтобы прибить Книгу1, которая непонятно чем открывается и висит 2 файла
    if xlOpenWorkBook(sToExistFile)
      result := true;
  }
}

procedure PrintReportsRKS;
{
  var isOkFile : boolean = false;
  var isAllRep : boolean = false; 
  var i        : integer = 0;
  var kol      : integer;
  var cRep     : comp; 

  if wToExistFile = 0 {isOkFile := OpenNewRKS;}
  if wToExistFile = 1 {isOkFile := OpenExistRKS;}
  if isOkFile
  {
    
    if GetMarkerCount(mRepSelected) = 0
    {
      _loop GP_RKStatList
        InsertMarker(mRepSelected, GP_RKStatList.NRec);
      isAllRep := true;
    }
    
    kol:=  GetMarkerCount(mRepSelected);
    while i < kol
    {
      GetMarker(mRepSelected, i++, cRep);
      if getfirst GP_RKStatList where ((cRep == GP_RKStatList.nRec)) = tsOk
      {
        if GetVipRef(GP_RKStat, GP_RKStatList.InterfaceName)
        {
          GP_RKStat.initRKStatRepParam;
          if GP_RKStat.isCheckRepParam(false)
            GP_RKStat.PrintRepPage(false)
          else
            message('Не установлены параметры отчета "' + GP_RKStatList.ReportName + '"', Error + OkButton);
          FreeVipInterface(GP_RKStat);
        }//if GetVipRef
        else
          Message('Не удалось загрузить интерфейс "' + GP_RKStatList.InterfaceName + '"', Error + OkButton);
      }//if getfirst GP_RKStatList
    }//while i < kol
    xlKillExcel;
    if (wToExistFile = 0) sToExistFile := '';
    if isAllRep ClearMarker(mRepSelected);
  }//if isOkFile
  else {if (wToExistFile = 0) {message('Проверте наличие файла шаблона по пути EXE\XLS_ЭМ\Staff');}}
}

Browse brGP_RKStat ('Выбор отчета', , sci1Esc);
  Show at (1,1,98,30);
Table GP_RKStatList;
Fields
  { Font = { Color = if((isRepMarked = '√') and (GP_RKStatList.isParOk), ColorMark, if(GP_RKStatList.isParOk,0,ColorSysRed)) }};

  isRepMarked              '' ('',, sci14EnIns): [3], Protect, Centered, NoAutoSize;

  GP_RKStatList.ReportName 'Наименование отчета'
                           ('Наименование отчета',, sci14EnIns): [22],
                           Protect;
  GP_RKStatList.dRepOnDate 'Отчет','на дату'
                           ('Отчет на дату',, sci14EnIns): [14, 'DD/MM/YYYY'],
                           Centered, NoAutoSize;
  sSetParam                'Установлены','параметры'
                           ('Установлены параметры',, sci14EnIns): [11],
                           Protect, Centered, NoAutoSize;
end;
Screen s1(,,sci1Esc);
Show at (1,31,98,43);
  fields
    wToExistFile ('[V] - Добавить в существующий файл, [ ] - Создать новый файл',, sci13Esc):
                 noprotect;
    sToExistFile ('Выберите файл, в который необходимо добавить данные',, sci13Esc):
                 {Font = {BackColor = if(sToExistFile = '', ColorNeed, 0)}},
                 protect, PickButton;
    wFromExistFile('Считать данные за прошлый период из файла'), noprotect;
    sFromExistFile('Считать данные за прошлый период из файла',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sFromExistFile = '', ColorNeed, 0)}},protect;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
    cmEdit,,,'Параметры текущего отчета',,;
<<

   [.] Добавить в существующий файл:`
   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
   
   [.] Считать данные за прошлый период из файла:`
   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  
   <. ~С~формировать .>          <. ~З~акрыть .>          <. ~П~араметры .>

>>
end;
!-------------------------------------------------------------------------------
HandleEvent
  cmInit:
  {
    delete all from GP_RKStatList;
    if (not (ReadMyDsk(wToExistFile, 'RKS_wToExistFile', false)))
      set wToExistFile := 0;
    if wToExistFile = 1 
      ToggleFieldVisible(#sToExistFile,true )
    else
      ToggleFieldVisible(#sToExistFile,false);
    if (not (ReadMyDsk(sToExistFile, 'RKS_sToExistFile', false)))
      set sToExistFile := '';

    set sFromExistFile := iUDR.ReadString('RKS_sFromExistFile');
    set wFromExistFile := iUDR.ReadWord  ('RKS_wFromExistFile');
    if wFromExistFile = 1 
      ToggleFieldVisible(#sFromExistFile,true )
    else
      ToggleFieldVisible(#sFromExistFile,false);
    
    mRepSelected := InitMarker('RKS_RepSelect', 8, 200, 10);

    if (not MakeGP_RKStatList) {Abort; Exit;}
    SetWindowTitle(wnMainWindow,'Отчетные формы "Роскосмоса"');
    if getfirst GP_RKStatList = tsOk {}
  }
  cmEdit:
  {
    if GetVipRef(GP_RKStat, GP_RKStatList.InterfaceName)
    {
      GP_RKStat.initRKStatRepParam;
      GP_RKStat.bSetRepParam;
      GP_RKStat.initRKStatRepParam;
      GP_RKStatList.dRepOnDate := GP_RKStat.dRepOnDateParam;
      GP_RKStatList.isParOk    := GP_RKStat.isCheckRepParam(false);
      update current GP_RKStatList;
      FreeVipInterface(GP_RKStat);
    }//if GetVipRef
    ReReadRecord(#GP_RKStatList);
  }
  cmSelAll:
  {
    ClearMarker(mRepSelected);
    _loop GP_RKStatList
      InsertMarker(mRepSelected, GP_RKStatList.NRec);
    ReReadRecord(#GP_RKStatList);
  }
  cmUnSelAll:
  {
    ClearMarker(mRepSelected);
    ReReadRecord(#GP_RKStatList);
  }    
  cmDoMarkUnMark:
  {
    if (FoundMarker(mRepSelected, GP_RKStatList.NRec) = false)
      InsertMarker(mRepSelected, GP_RKStatList.NRec)
    else
      DeleteMarker(mRepSelected, GP_RKStatList.NRec);
    if getnext GP_RKStatList = tsOk {}
    ReReadRecord(#GP_RKStatList);
  }
  cmDefault :
  {
    PrintReportsRKS;
  }
  cmOK:
  {
    iUDR.SaveWord  ('RKS1_wFromExistFile', wFromExistFile);
    iUDR.SaveString('RKS1_sFromExistFile', sFromExistFile);
    iUDR.SaveWord  ('RKS2_wFromExistFile', wFromExistFile);
    iUDR.SaveString('RKS2_sFromExistFile', sFromExistFile);
    iUDR.SaveWord  ('RKS3_wFromExistFile', wFromExistFile);
    iUDR.SaveString('RKS3_sFromExistFile', sFromExistFile);
    iUDR.SaveWord  ('RKS5_wFromExistFile', wFromExistFile);
    iUDR.SaveString('RKS5_sFromExistFile', sFromExistFile);
    iUDR.SaveWord  ('RKS10_wFromExistFile', wFromExistFile);
    iUDR.SaveString('RKS10_sFromExistFile', sFromExistFile);
    iUDR.SaveWord  ('RKS11_wFromExistFile', wFromExistFile);
    iUDR.SaveString('RKS11_sFromExistFile', sFromExistFile);
    iUDR.SaveWord  ('RKS12_wFromExistFile', wFromExistFile);
    iUDR.SaveString('RKS12_sFromExistFile', sFromExistFile);
    PrintReportsRKS;
  }
  cmCancel:
  {
    SaveMyDsk (wToExistFile, 'RKS_wToExistFile'); //
    SaveMyDsk (sToExistFile, 'RKS_sToExistFile'); //
    iUDR.SaveWord  ('RKS_wFromExistFile', wFromExistFile);
    iUDR.SaveString('RKS_sFromExistFile', sFromExistFile);
    CloseInterface(cmDefault);
  }
  cmPick:
  {
    case CurField of
      #sToExistFile: {set sToExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');}
      #sFromExistFile:
      {
        set sFromExistFile := GetFileName('*.xls;*.xlsx;*.xlsm','Выбор файла...');
      }
    end;
  }
  cmCheckField:
  {
    case CurField of
      #wToExistFile:
      {
        if wToExistFile = 1 
          ToggleFieldVisible(#sToExistFile,true )
        else
          ToggleFieldVisible(#sToExistFile,false);
      }
      #wFromExistFile:
      {
        if wFromExistFile = 1 
          ToggleFieldVisible(#sFromExistFile,true )
        else
          ToggleFieldVisible(#sFromExistFile,false);
      }
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sToExistFile:{set sToExistFile:='';}
      #sFromExistFile:{set sFromExistFile:='';}
    end;
  }
  cmHotKeys:
  {
     case CurTable of
       #GP_RKStatList: PutHotCommand(RunMenu('mnuGP_RKStat'));
     end;
  }
end;
end.
