* Наименование: Приказ по ШР "Переименование структурного подразделения" (РПД-3)                  *
* Контур/Модуль: Кадры                                                                            *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1092         |25/09/17|Кузьмин П.Ю.             |НПО Энергомаш                    *
\*************************************************************************************************/
#include AttrTablePick.vih

#component "Z_StaffSHR"
#doc
Приказы по штатному расписанию - Переподчинение структурного подразделения
<p>#1092
<p>#45                                                                                             *
<p>1. Вытащить ВА "Вид производства" в интерфейс РПД 1, 3 и 4
<p>2. Для РПД 3 и 4, заполнять поле "Вид производства" значением "по умолчанию", взятому из ШР.
<p>3. При утверждении приказов по РПД 3 и 4 обрабатывать заполнение/изменение
ВА "Вид производства" в СЕ ШР и каталоге подразделений.
#end
alter interface SHR_RPD_3;
overload
  function myInsert : boolean;
  function ISHR_RPD_Base.CheckCurrOrder: boolean;
  Function ISHR_RPD_Base.ConfirmCurrOrder: boolean;
end;
#include ShowKau.Vpp

//------
var pVA_VID_PROIZV:comp;
var pVA_VID_PROIZV_H:comp;
var refAttrTablePick  : AttrTablePick;
//-----------------------
create view
as select
  sGetAttrID(coCatHist,CatHistNew.Nrec,pVA_VID_PROIZV_H) (FieldName=sVID_PROIZV)
;


//--------------------------------------
// Функции
//--------------------------------------
function myInsert : boolean;
{
  result:=inherited::myInsert;
  if (not result) exit;
  var _pVID_PROIZV:comp  =coGetAttrID(coCatalogs,Podr.Nrec,pVA_VID_PROIZV);
  var _sVID_PROIZV:string= sGetAttrID(coCatalogs,Podr.Nrec,pVA_VID_PROIZV);
  if (IsValidAll(tnCatHistNew)) {
    CatHistNew.Name:=CatHistOld.Name;
    set CatHistNew.Code:=CatHistOld.Code;
    update current CatHistNew;
    if _pVID_PROIZV<>0
      coSetAttrID(coCatHist,CatHistNew.Nrec,pVA_VID_PROIZV_H,_pVID_PROIZV,_sVID_PROIZV);
  }

  if (IsValidAll(tnSHR_ConditionNew)) {
    set SHR_ConditionNew.FldCondition:=SHR_ConditionOld.FldCondition;
    update current SHR_ConditionNew;
  }
}

//--------------------------------------
#doc
  Процедура проверки корректности заполнения приказа
#end
  Function ISHR_RPD_Base.CheckCurrOrder: boolean;
  { Result:=Inherited::CheckCurrOrder;
    if coGetAttrID(coCatHist,CatHistNew.Nrec,pVA_VID_PROIZV_H)=0
    { result := false;
      SetOrderMsg('Не заполнено поле "Вид производства" ');
    }
  } //function ISHR_RPD.CheckOrder: boolean;


#doc
  Процедура утверждения приказа по текущему работнику (по таблице StrCont)
#end
  Function ISHR_RPD_Base.ConfirmCurrOrder: boolean;
  { timelog('SHR_RPD_1->ConfirmCurrOrder 001');
    var _pVID_PROIZV:comp  =coGetAttrID(coCatHist,CatHistNew.Nrec,pVA_VID_PROIZV_H);
    var _sVID_PROIZV:string= sGetAttrID(coCatHist,CatHistNew.Nrec,pVA_VID_PROIZV_H);
    coSetAttrID(coCatalogs,Podr.Nrec,pVA_VID_PROIZV,_pVID_PROIZV,_sVID_PROIZV);
    //-------------------------
    // здесь будет новый CatHistNew!!
    Result:=Inherited::ConfirmCurrOrder;
    if not Result then Exit;
    //-------------------------
    coSetAttrID(coCatHist,CatHistNew.Nrec,pVA_VID_PROIZV_H,_pVID_PROIZV,_sVID_PROIZV);
    coSetAttrID(coCatalogs,Podr.Nrec,pVA_VID_PROIZV,_pVID_PROIZV,_sVID_PROIZV);

    timelog('SHR_RPD_1->ConfirmCurrOrder 002');
    //VInterf.StaffPodr(PodrNew.Nrec); //Создание подразделения в KatPodr
    var _pPodr:comp=GetKatPodrByCatalogs(Podr.Nrec);
    if _pPodr<>0
    { CopyAllAttrEx(coCatalogs, Podr.nRec,coKatPodr,_pPodr);
    }
    timelog('SHR_RPD_1->ConfirmCurrOrder finish');
  } //Function ISHR_RPD.ConfirmOrder: boolean;

//-------------------------------
OverloadFormats brStr;
//-------------------------------
browse brStr (, hcStaffWinStrPr);
table StrCont;
fields
  browseOrder '№':[1];
  Podr.Name  'Структурное подразделение' ('Наименование структурного подразделения',, sci1378Esc): [35], protect;
  Podr.Code  'Код' ('Код структурного подразделения',, sci1378Esc): [15], protect;
  Podr.DatN  'Дата введения' ('Дата введения структурного подразделения',, sci178Esc): [15], protect, noAutoSize;
end;

//-------------------------------
ExtendFormats scrDet3;
//-------------------------------
screen scrDet3 (,hcStaffWinStrPr, scStaffMyPnl);     //переименование стр.подразделения
show at (,5,,);
table StrCont;
  fields
    sVID_PROIZV   ('ВА "Вид производства"',,sci13Esc) : protect,PickButton;

<<










                                       Вид производства .@@@@@@@@@@@@@@@@@@@@@


>>
end; // screen scrDet3


//--------------------------------------------
// Обработчик событий интерфейса
//--------------------------------------------
HandleEvent
//--------------------------------
cmOnVipLoad:
{ timelog_init;
  pVA_VID_PROIZV  :=ExtAttr_ID(coCatalogs,'Вид производства');
  pVA_VID_PROIZV_H:=ExtAttr_ID(coCatHist,'Вид производства');
  timelog('SHR_RPD_4->cmOnVipLoad:pVA_VID_PROIZV_H='+string(pVA_VID_PROIZV_H,0,0));
  if  inherited :: handleEvent (cmOnVipLoad)=heAbort then Abort;
} //cmOnVipLoad:
//--------------------------------
cmPick:
{ //----------------------------------
  if inherited::handleEvent(cmpick)=heAbort Abort;
  //----------------------------------
  case curField of
  #sVID_PROIZV:
  { refAttrTablePick.PickValue ( coCatHist, pVA_VID_PROIZV_H, CatHistNew.nrec );
    ReScanPanel(#StrCont);
  }
  end;
} //cmPick:
end;//HandleEvent

end.
