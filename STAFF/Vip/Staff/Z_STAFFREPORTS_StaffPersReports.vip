procedure CheckReport;
{

  inherited::CheckReport;

  if (GetFirst Catalogs where (( ParentNrec == Catalogs.Nrec )) = tsOk)
  {
    if Catalogs.Name = 'Расписка при приеме документов'
    {
      SetFieldAndLabelVisible(#fSigner, true);
    }
    else
    {
//      SetFieldAndLabelVisible(#fSigner, false);
    }
  }
  if (GetFirst RepNameCat = tsOK) {};
  if (GetFirst RepVersion <> tsOK)
  {
  }
  else
  {
    case Substr(RepVersion.Formula, 40, 2) of
      '04': SetFieldAndLabelVisible(#fSigner, true);  // Карточка гражданина (Форма №10)
      '99': SetFormat(scrCurDate99);      // Наим.военкомата, ФИО руководителя, ФИО отв. за ВУС
    end;
  }
}

HandleEvent
cmStaffRepBuild:
{
  Inherited::HandleEvent(cmStaffRepBuild);

  case strRepUnload of
    ' Z':{
           SaveMyDsk(sFIO_Last_F4     , 'Forma4UdIsv_sFIO_Last_F4'     );
           SaveMyDsk(sFIO_FirstPatr_F4, 'Forma4UdIsv_sFIO_FirstPatr_F4');
           SaveMyDsk(sBornDate_F4     , 'Forma4UdIsv_sBornDate_F4'     );
           SaveMyDsk(sPost_F4         , 'Forma4UdIsv_sPost_F4'     );
           SaveMyDsk(sPost2_F4        , 'Forma4UdIsv_sPost2_F4'     );
           SaveMyDsk(sVUS_F4          , 'Forma4UdIsv_sVUS_F4'          );
           SaveMyDsk(sSostav          , 'Forma4UdIsv_sSostav'          );
           SaveMyDsk(sVoenZvan        , 'Forma4UdIsv_sVoenZvan'        );
           SaveMyDsk(sOrg1            , 'Forma4UdIsv_sOrg1'            );
           SaveMyDsk(sOrg2            , 'Forma4UdIsv_sOrg2'            );
           SaveMyDsk(sOrg3            , 'Forma4UdIsv_sOrg3'            );
           SaveMyDsk(sKomDD           , 'Forma4UdIsv_sKomDD'           );
           SaveMyDsk(sKomMM           , 'Forma4UdIsv_sKomMM'           );
           SaveMyDsk(sKomYY           , 'Forma4UdIsv_sKomYY'           );
           SaveMyDsk(sNom             , 'Forma4UdIsv_sNom'             );
           SaveMyDsk(sKodBED          , 'Forma4UdIsv_sKodBED'          );
           SaveMyDsk(sKodPost         , 'Forma4UdIsv_sKodPost'         );
           SaveMyDsk(sMonth           , 'Forma4UdIsv_sMonth'           );
           SaveMyDsk(sPostRuk         , 'Forma4UdIsv_sPostRuk'         );
           SaveMyDsk(sFIORuk          , 'Forma4UdIsv_sFIORuk'          );
           SaveMyDsk(sVoenkomat1      , 'Forma4UdIsv_sVoenkomat1'      );
           SaveMyDsk(sVoenkomat2      , 'Forma4UdIsv_sVoenkomat2'      );
           SaveMyDsk(sVoenkomat3      , 'Forma4UdIsv_sVoenkomat3'      );
           SaveMyDsk(sVoenkomat4      , 'Forma4UdIsv_sVoenkomat4'      );
           SaveMyDsk(sVoenkomat5      , 'Forma4UdIsv_sVoenkomat5'      );
           SaveMyDsk(sVoenkomat6      , 'Forma4UdIsv_sVoenkomat6'      );
           SaveMyDsk(sFIOVoen         , 'Forma4UdIsv_sFIOVoen'         );
           SaveMyDsk(sVoenkomat1_2    , 'Forma4UdIsv_sVoenkomat1_2'    );
           SaveMyDsk(sVoenkomat2_2    , 'Forma4UdIsv_sVoenkomat2_2'    );
           SaveMyDsk(sVoenkomat3_2    , 'Forma4UdIsv_sVoenkomat3_2'    );
           SaveMyDsk(sFIOVoen_2       , 'Forma4UdIsv_sFIOVoen_2'       );


           RunInterface(F_USERREPORT::Forma4UdIsv, ParentNrec);
         }
  end;
}
end; // HandleEvent
end; // panRepFormulae

HandleEvent

cmInit:
{
  Inherited::HandleEvent(cmInit);

  TOA.Bind(0); // связываем TOA с собственной организацией
//Trim(TOA.GetJuridicalInfo.GetName)
//Trim(TOA1.GetNaming.GetFullName())


//           if ( not(ReadMyDsk(sFIO_Last_F4     , 'Forma4UdIsv_sFIO_Last_F4'     , false))) {}
//           if ( not(ReadMyDsk(sFIO_FirstPatr_F4, 'Forma4UdIsv_sFIO_FirstPatr_F4', false))) {}
//           if ( not(ReadMyDsk(sBornDate_F4     , 'Forma4UdIsv_sBornDate_F4'     , false))) {}
//           if ( not(ReadMyDsk(sVUS_F4          , 'Forma4UdIsv_sVUS_F4'          , false))) {}
//           if ( not(ReadMyDsk(sSostav          , 'Forma4UdIsv_sSostav'          , false))) {}
//           if ( not(ReadMyDsk(sVoenZvan        , 'Forma4UdIsv_sVoenZvan'        , false))) {}
           if ( not(ReadMyDsk(sOrg1            , 'Forma4UdIsv_sOrg1'            , false)))
    sOrg1 := Trim(TOA1.GetNaming.GetFullName());
           if ( not(ReadMyDsk(sOrg2            , 'Forma4UdIsv_sOrg2'            , false))) {}
           if ( not(ReadMyDsk(sOrg3            , 'Forma4UdIsv_sOrg3'            , false))) {}
           if ( not(ReadMyDsk(sKomDD           , 'Forma4UdIsv_sKomDD'           , false))) {}
           if ( not(ReadMyDsk(sKomMM           , 'Forma4UdIsv_sKomMM'           , false))) {}
           if ( not(ReadMyDsk(sKomYY           , 'Forma4UdIsv_sKomYY'           , false))) {}
           if ( not(ReadMyDsk(sNom             , 'Forma4UdIsv_sNom'             , false))) {}
//           if ( not(ReadMyDsk(sKodBED          , 'Forma4UdIsv_sKodBED'          , false))) {}
//           if ( not(ReadMyDsk(sKodPost         , 'Forma4UdIsv_sKodPost'         , false))) {}
           if ( not(ReadMyDsk(sMonth           , 'Forma4UdIsv_sMonth'           , false))) {}
           if ( not(ReadMyDsk(sPostRuk         , 'Forma4UdIsv_sPostRuk'         , false))) {}
           if ( not(ReadMyDsk(sFIORuk          , 'Forma4UdIsv_sFIORuk'          , false))) {}
           if ( not(ReadMyDsk(sVoenkomat1      , 'Forma4UdIsv_sVoenkomat1'      , false))) {}
           if ( not(ReadMyDsk(sVoenkomat2      , 'Forma4UdIsv_sVoenkomat2'      , false))) {}
           if ( not(ReadMyDsk(sVoenkomat3      , 'Forma4UdIsv_sVoenkomat3'      , false))) {}
           if ( not(ReadMyDsk(sVoenkomat4      , 'Forma4UdIsv_sVoenkomat4'      , false))) {}
           if ( not(ReadMyDsk(sVoenkomat5      , 'Forma4UdIsv_sVoenkomat5'      , false))) {}
           if ( not(ReadMyDsk(sVoenkomat6      , 'Forma4UdIsv_sVoenkomat6'      , false))) {}
           if ( not(ReadMyDsk(sFIOVoen         , 'Forma4UdIsv_sFIOVoen'         , false))) {}
           if ( not(ReadMyDsk(sVoenkomat1_2    , 'Forma4UdIsv_sVoenkomat1_2'    , false))) {}
           if ( not(ReadMyDsk(sVoenkomat2_2    , 'Forma4UdIsv_sVoenkomat2_2'    , false))) {}
           if ( not(ReadMyDsk(sVoenkomat3_2    , 'Forma4UdIsv_sVoenkomat3_2'    , false))) {}
           if ( not(ReadMyDsk(sFIOVoen_2       , 'Forma4UdIsv_sFIOVoen_2'       , false))) {}

  if ( getfirst PersonsF4 = tsOk )
  {
    sFIO_Last_F4      := UpCase(iStrFunc.Get_LastName(PersonsF4.FIO));
    sFIO_FirstPatr_F4 := UpCase(iStrFunc.Get_FirstName(PersonsF4.FIO)+' '+iStrFunc.GetPatronymic(PersonsF4.FIO));
    sBornDate_F4      := Year(PersonsF4.BornDate);
    sPost_F4 := UpCase(VAppFuncs.GetAppPost(VAppFuncs.GetAppNrec_OnDate(PersonsF4.nRec, Cur_Date)));

    if ( getfirst ConscriptionF4 = tsOk )
    {
      if ( getfirst ConsVUSCat = tsOk )
      sVUS_F4           := UpCase(if(ConsVUSCat.Name <> '',
          ConsVUSCat.Code + ' (' + ConsVUSCat.Name + ')',
          ConsVUSCat.Code));


      if ( getfirst ConsAcntStrucCat = tsOk )
        sSostav := UpCase(ConsAcntStrucCat.Name);

      if ( getfirst ConsMilRankCat = tsOk )
        sVoenZvan := UpCase(ConsMilRankCat.Name);
/*
      if sVoenkomat1 = ''
        sVoenkomat1 := UpCase(ConscriptionF4.MilCardBy);
      if sVoenkomat1_2 = ''
        sVoenkomat1_2 := UpCase(ConscriptionF4.MilCardBy);
*/
      if ( getfirst ConsSpecAccCat = tsOk )
      {
        sKodBED   := UpCase(ConsSpecAccCat.Name);
        sKodPost  := UpCase(ConsSpecAccCat.Code);
      }

      if ( getfirst ConsMilComissCat = tsOk )
      {
/*
        sVoenkomat1   := UpCase(ConsMilComissCat.Name);
        sVoenkomat1_2 := UpCase(ConsMilComissCat.Name);
*/
      }

    }
  }

}

cmDone:
{
  Inherited::HandleEvent(cmDone);
  SaveMyDsk(sOrg1, 'Forma4UdIsv_sOrg1') ;
  SaveMyDsk(sOrg2, 'Forma4UdIsv_sOrg2') ;
  SaveMyDsk(sOrg3, 'Forma4UdIsv_sOrg3') ;

           SaveMyDsk(sFIO_Last_F4     , 'Forma4UdIsv_sFIO_Last_F4'     );
           SaveMyDsk(sFIO_FirstPatr_F4, 'Forma4UdIsv_sFIO_FirstPatr_F4');
           SaveMyDsk(sBornDate_F4     , 'Forma4UdIsv_sBornDate_F4'     );
           SaveMyDsk(sPost_F4         , 'Forma4UdIsv_sPost_F4'     );
           SaveMyDsk(sPost2_F4        , 'Forma4UdIsv_sPost2_F4'     );
           SaveMyDsk(sVUS_F4          , 'Forma4UdIsv_sVUS_F4'          );
           SaveMyDsk(sSostav          , 'Forma4UdIsv_sSostav'          );
           SaveMyDsk(sVoenZvan        , 'Forma4UdIsv_sVoenZvan'        );
           SaveMyDsk(sOrg1            , 'Forma4UdIsv_sOrg1'            );
           SaveMyDsk(sOrg2            , 'Forma4UdIsv_sOrg2'            );
           SaveMyDsk(sOrg3            , 'Forma4UdIsv_sOrg3'            );
           SaveMyDsk(sKomDD           , 'Forma4UdIsv_sKomDD'           );
           SaveMyDsk(sKomMM           , 'Forma4UdIsv_sKomMM'           );
           SaveMyDsk(sKomYY           , 'Forma4UdIsv_sKomYY'           );
           SaveMyDsk(sNom             , 'Forma4UdIsv_sNom'             );
           SaveMyDsk(sKodBED          , 'Forma4UdIsv_sKodBED'          );
           SaveMyDsk(sKodPost         , 'Forma4UdIsv_sKodPost'         );
           SaveMyDsk(sMonth           , 'Forma4UdIsv_sMonth'           );
           SaveMyDsk(sPostRuk         , 'Forma4UdIsv_sPostRuk'         );
           SaveMyDsk(sFIORuk          , 'Forma4UdIsv_sFIORuk'          );
           SaveMyDsk(sVoenkomat1      , 'Forma4UdIsv_sVoenkomat1'      );
           SaveMyDsk(sVoenkomat2      , 'Forma4UdIsv_sVoenkomat2'      );
           SaveMyDsk(sVoenkomat3      , 'Forma4UdIsv_sVoenkomat3'      );
           SaveMyDsk(sVoenkomat4      , 'Forma4UdIsv_sVoenkomat4'      );
           SaveMyDsk(sVoenkomat5      , 'Forma4UdIsv_sVoenkomat5'      );
           SaveMyDsk(sVoenkomat6      , 'Forma4UdIsv_sVoenkomat6'      );
           SaveMyDsk(sFIOVoen         , 'Forma4UdIsv_sFIOVoen'         );
           SaveMyDsk(sVoenkomat1_2    , 'Forma4UdIsv_sVoenkomat1_2'    );
           SaveMyDsk(sVoenkomat2_2    , 'Forma4UdIsv_sVoenkomat2_2'    );
           SaveMyDsk(sVoenkomat3_2    , 'Forma4UdIsv_sVoenkomat3_2'    );
           SaveMyDsk(sFIOVoen_2       , 'Forma4UdIsv_sFIOVoen_2'       );
}

end; // HandleEvent

end.
