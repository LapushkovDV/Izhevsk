Create View
var sAdress1      : String;
sFIO_Last_F4      : string;
sFIO_FirstPatr_F4 : string;
sBornDate_F4      : string;
sPost_F4          : string;
sPost2_F4          : string;
sVUS_F4           : string;
sSostav           : string;
sVoenZvan         : string;
sOrg1             : string;
sOrg2             : string;
sOrg3             : string;
sKomDD            : string;
sKomMM            : string;
sKomYY            : string;
sNom              : string;
sKodBED           : String;
sKodPost          : string;
sMonth            : string;
sPostRuk          : string;
sFIORuk           : string;
sVoenkomat1       : string;
sVoenkomat2       : string;
sVoenkomat3       : string;
sVoenkomat4       : string;
sVoenkomat5       : string;
sVoenkomat6       : string;
sFIOVoen          : string;
sVoenkomat1_2     : string;
sVoenkomat2_2     : string;
sVoenkomat3_2     : string;
sFIOVoen_2        : string;
as select
  sGetAttr(coCatalogs,Catalogs.Nrec,'Адрес военкомата') (fieldname = sAdress)
from
Persons PersonsF4
,Conscription ConscriptionF4
,Catalogs ConsVUSCat
,Catalogs ConsAcntStrucCat
,Catalogs ConsMilRankCat
,Catalogs ConsSpecAccCat
,Catalogs ConsMilComissCat
where((
cPersonPar                    == PersonsF4.Nrec
and PersonsF4.Nrec            == ConscriptionF4.Person
and ConscriptionF4.VUS        == ConsVUSCat.Nrec
and ConscriptionF4.AcntStruc  == ConsAcntStrucCat.Nrec
and ConscriptionF4.MilRank    == ConsMilRankCat.Nrec
and ConscriptionF4.SpecAcc    == ConsSpecAccCat.NRec
and ConscriptionF4.MilComiss  == ConsMilComissCat.Nrec
))
;

#include StrFunc.var  // Функции работы со строками (iStrFunc)
//------------------------------------------------------------------------------
// Окно редактирования записи Catalogs
