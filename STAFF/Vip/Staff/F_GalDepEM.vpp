// Галактика ERP 8.1 - Управление персоналом
// Поиск подразделения по структурной единице ШР
//------------------------------------------------------------------------------

Function GalDepartmentNrec(cStaffDep: comp): comp;
{
  var cTmp: comp;
  cTmp := cStaffDep;
  var bNotFind: boolean;
  bNotFind := True;
  result := 0;

  do
  {
    if (GetFirst ExtCatLinks
           where (( epStaffDepartment == ExtCatLinks.ObjType and
                    moStaff           == ExtCatLinks.ModType and
                    cTmp              == ExtCatLinks.StaffCat )) = tsOk)
    {
      bNotFind := False;
      result := ExtCatLinks.ExtCat;
    }
    else
    {
      if (GetFirst Catalogs
            where (( cTmp == Catalogs.NRec)) = tsOk)
        cTmp := Catalogs.cParent;
      else
        bNotFind := False;
    }
  }
  while (bNotFind);
}
