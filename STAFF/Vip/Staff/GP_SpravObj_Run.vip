#doc
  интерфейс, реализующий вызов интерфейса формирования отчета "Справка-объективка (ЕМ)"
#end

VipInterface RunUsersRep_GP_SpravObj_Run implements IRunUsersRep
;

interface RunUsersRep_GP_SpravObj_Run;
  // Запустить пользовательский интерфейс
  procedure RunUserReport(IntNrec : comp);
