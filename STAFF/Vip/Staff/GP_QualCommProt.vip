* Наименование: Форма "Протокол заседания аттестационной / квалификационной комиссии"             *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Отчеты / Отчеты пользователя / Обучение и развитие персонала / Протокол заседания   *
*             аттестационной / квалификационной комиссии                                          *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#341          |30/06/17|Тищенко Р.Н.             |НПО Энергомаш                    *
* Разработка  |#342          |30/06/17|Тищенко Р.Н.             |НПО Энергомаш                    *
* Разработка  |#343          |30/06/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include CatFunc.vih // Функции работы с каталогом
#include GP_EducFunc.vih // Функции работы с уровнями образования
#include StrFunc.vih // Функции работы со строками
#include FeeSigners.Vih // Функции работы с подписантами
#include AppFuncs.vih // Функции работы с назначениями
// #include GP_Log.vih // Объектный интерфейс для вывода протокола
#include GP_StrFunc.vih // Функции работы со строками

interface GP_QualCommProt 'Протокол заседания аттестационной / квалификационной комиссии' escClose;

  const
    REP_NAME = 'GP_QualCommProt'; // Название отчёта
    SG_CONST_REP = cgReport_KASSFRO; // код группы отчётов для выбора подписантов
    SG_TAG_REP = 'QualCommProt'; // код отчёта для выбора подписантов
  end;

  function GetActEducName(dBeg: Date; dEnd: Date; cSubject: tNRec; cInstitution: tNRec): String; forward;

  create view
    var
      pcActEduc: tNRec; // Мероприятие по повышению квалификации
    as select
      GetActEducName(ActEducations.dBegin, ActEducations.dEnd, ActEducations.cName, ActEducations.cPlace) (fieldName = ActEducName)
    from
      ActEducations,
      Appointments
    where ((
          pcActEduc          == ActEducations.NRec
      and ActEducations.NRec == PlanEduc.cAct (noIndex)
      and PlanEduc.cPers     == Persons.NRec
      and PlanEduc.NRec      == Education.cRef1
    ))
  ;

  form Frm ('GP_QualCommProt.out','GP_QualCommProt');

  var
    IsAborted: Boolean;
    FeeSignersGroup: String;
    ICatFunc: CatalogsFunctions;
    VAppFuncs: AppointmentsFunctions;

  #include StrFunc.var
  #include FeeSigners.var
  // #include GP_Log.var
  #include GP_StrFunc.var
  #include GP_EducFunc.var

  window winParam 'Протокол заседания аттестационной / квалификационной комиссии' doAccept, escClose, gray;
    show at (,, 100, 8);

    screen scrParam ('',, sci1EnEsc);
    fields
      ActEducName ('Мероприятие по повышению квалификации',, sci13EnEsc): protect;
      FeeSignersGroup ('Группа подписантов',, sci13EnEsc): protect;
    buttons
      cmOk,,, 'Ввод - принять выбор',,sci1Esc;
      cmCancel,,, 'Отмена',,sci1Esc;
    <<

`Мероприятие`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Группа подписантов`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

                                     <.  ~O~K  .> <.О~т~мена.>
    >>
    end;

    handleEvent
      cmOk:
        PutCommand(cmDefault);
      cmDefault:
        if pcActEduc = 0 then
        begin
          Message('Поле "Мероприятие" обязательно для заполнения');
          abort;
        end;
    end;
  end;

  // инициализация параметров отчета
  function InitParam: Boolean;
  begin
    if not ReadMyDsk(pcActEduc, REP_NAME + 'pcActEduc', false) then
      pcActEduc := 0;
    if not ReadMyDsk(FeeSignersGroup, 'FeeSigners_' + To_Char(SG_CONST_REP) + '_' + SG_TAG_REP, false) then
      FeeSignersGroup := '';
    result := true;
  end;

  // сохранение параметров отчета
  procedure SaveParam;
  begin
    SaveMyDsk(pcActEduc, REP_NAME + 'pcActEduc');
    SaveMyDsk(FeeSignersGroup, 'FeeSigners_' + To_Char(SG_CONST_REP) + '_' + SG_TAG_REP);
  end;

  // установка параметров отчета
  function AskParam: Boolean;
  begin
    result := false;
    if not InitParam then
      Exit;
    if RunWindowModal(winParam) = cmDefault then
    begin
      SaveParam;
      result := true;
    end;
  end;

  // Формирует строку с информацией о мероприятии для поля выбора
  function GetActEducName(dBeg: Date; dEnd: Date; cSubject: tNRec; cInstitution: tNRec): String;
  var
    S: String;
  begin
    result := '';
    if dBeg != ZeroDate then
      result := 'с ' + DateToStr(dBeg, 'DD.MM.YYYY');
    if dEnd != ZeroDate then
      result += if(result != '', ' ', '') + 'по ' + DateToStr(dEnd, 'DD.MM.YYYY');
    S := ICatFunc.GetCatalogsName(cSubject);
    if S != '' then
      result += if(result != '', ' ', '') + S;
    S := ICatFunc.GetCatalogsName(cInstitution);
    if S != '' then
      result += if(result != '', ' ', '') + 'в ' + S;
  end;

  procedure ProcessOnePlanRec;
  var
    cAppoint: tNRec; // ссылка на текущее назначение
  begin
    // Пропускаем записи, у которых нет отметки о фактическом повышении квалификации (* в последней колонке)
    if not IsValid(tnEducation) then
      exit;
    Frm.PutEventByID(feDoLoop, fcPsnList);
    Frm.Write(PlanEduc.NRec); // PlanEducNRec
    Frm.Write(Persons.FIO); // PersFIO
    Frm.Write(GetStrTabn(Persons.TabNmb, Persons.StrTabn)); // PersTabN
    Frm.Write(Persons.BornDate); // PersBornDate
    cAppoint := VAppFuncs.GetAppNrec_OnDate(Persons.NRec, PlanEduc.dPlan1);
    if getfirst Appointments where ((cAppoint == Appointments.NRec)) = tsOK then
    begin
      Frm.Write(ICatFunc.GetCatalogsCode(Appointments.Department)); // PersDepCode
      Frm.Write(ICatFunc.GetCatalogsName(Appointments.Department)); // PersDepDepName
      Frm.Write(ICatFunc.GetCatalogsName(Appointments.Post)); // PersPosition
    end else
      Frm.SkipFormat(3);
    Frm.Write(ICatFunc.GetCatalogsName(oGP_EducFunc.GetBestEducLvl(Persons.NRec))); // PersEducLvl
    Frm.Write(ICatFunc.GetCatalogsName(Education.Qualification)); // PersQual
    Frm.Write(Education.Series); // PersDiplSeries
    Frm.Write(Education.DiplomNmb); // PersDiplNum
    Frm.Write(Education.DiplomDate); // PersDiplDate
  end;

  // Формирует отчёт
  procedure CreateReport;
  begin
    IsAborted := false;
    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчёта...', 1);
    Frm.Write(ActEducations.NRec); // ActEducationsNRec
    Frm.Write(ActEducations.LastUser); // DocNum - поле "Номер документа" в мероприятии
    Frm.Write(ActEducations.LastDate); // DocDate - поле "выдан" в мероприятии
    Frm.Write(ActEducations.dBegin); // ActEdFrom - поле "Дата начала" в мероприятии
    Frm.Write(ActEducations.dEnd); // ActEdTo - поле "Дата окончания" в мероприятии
    Frm.Write(ActEducations.sText); // ActEdNote - поле "Примечание" в мероприятии
    Frm.Write(ICatFunc.GetCatalogsName(ActEducations.cName)); // ActEdSubject - поле "Тема" в мероприятии
    Frm.Write(ICatFunc.GetCatalogsName(ActEducations.cRef3)); // ActEdType - поле "Вид повышения квалификации"
    _try
      begin
        _loop PlanEduc
        begin
          if IsAborted then
            break;
          NextVisual;
          ProcessOnePlanRec;
        end;
      end
    _except
      on ExUserBreak:
        begin
          IsAborted := true;
        end;
    StopVisual('', 0);
    if not IsAborted and not Frm.Error then
      Frm.ShowFile();
  end;

  //------------------------------------------------------------------------------------------------------------------------------

  handleEvent
    cmInit:
      begin
        iFeeSigners.InitFeeSigners(SG_CONST_REP);
        if AskParam then
        begin
          // oGP_Log.Init(REP_NAME + '.log', true, true, true);
          // oGP_Log.SetVerboseMode(true);
          CreateReport;
          // oGP_Log.Done(true);
        end;
        abort;
      end;
    cmPick:
      case CurField of
        #ActEducName:
          begin
            var _cActEduc: tNRec = pcActEduc;
            if Runinterface(ActEduc, _cActEduc) = cmDefault then
              set pcActEduc := _cActEduc;
          end;
        #FeeSignersGroup:
          begin
            if iFeeSigners.RunMainWindow(1) then
              set FeeSignersGroup := iFeeSigners.GetFeeSignersName;
          end;
      end;
    cmDelOnProtect:
      case CurField of
        #FeeSignersGroup:
          set FeeSignersGroup := '';
      end;
  end;

end.

//=[ Функции для подключения отчета ]=================================

#include UserReport.vih

vipinterface UserReport_GP_QualCommProt implements IUserReport;

interface UserReport_GP_QualCommProt;

  procedure Run;
  begin
    RunInterface('GP_QualCommProt');
  end;

  function GetReportName: String;
  begin
    result := 'Протокол заседания аттестационной / квалификационной комиссии';
  end;

  function GetGroupName(Level: Word): String;
  begin
    result := '';
    case Level of
      1: result := 'Обучение и развитие персонала';
    end;
  end;

  function GetPriority: Integer;
  begin
    result := 0;
  end;

  function VisibleInModule(Ind: Byte): String;
  begin
    result := '';
    case Ind of
      1: result := 'STAFFMAINMENU';
    end;
  end;

end.
