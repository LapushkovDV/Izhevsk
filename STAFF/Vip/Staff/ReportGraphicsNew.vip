//*****************************************************************************
table struct tmpTable
(
  NRec    : comp
, dDays   : array [1..31] of double
, dNight  : array [1..31] of double
, Name    : string
, numSmena: string
, wMonth  : word
, wYear   : word
, daysPr  : double
, hoursPr : double
)
with index
(
  tmpTable01 = NRec(Surrogate, Unique)
, tmpTable02 = wYear + wMonth + Name
)
;
//*****************************************************************************
table struct tmpRejim
(
  NRec    : comp
, wLine   : word
, npp     : word
, cRec    : array[1..4] of comp
, Name    : array[1..4] of string
, sDesc   : array[1..4] of string
, Line1   : array[1..4] of string
, Line2   : array[1..4] of string
, Line3   : array[1..4] of string
, Line4   : array[1..4] of string
, Line5   : array[1..4] of string
, Line6   : array[1..4] of string
, Line7   : array[1..4] of string
, Line8   : array[1..4] of string
, Line9   : array[1..4] of string
, Line10  : array[1..4] of string
, Hours1  : array[1..4] of double
, Hours2  : array[1..4] of double
, Hours3  : array[1..4] of double
, Hours4  : array[1..4] of double
, Hours5  : array[1..4] of double
, Hours6  : array[1..4] of double
, Hours7  : array[1..4] of double
, Hours8  : array[1..4] of double
, Hours9  : array[1..4] of double
, Hours10 : array[1..4] of double
, Beg1    : array[1..4] of string
, Beg2    : array[1..4] of string
, Beg3    : array[1..4] of string
, Beg4    : array[1..4] of string
, Beg5    : array[1..4] of string
, Beg6    : array[1..4] of string
, Beg7    : array[1..4] of string
, Beg8    : array[1..4] of string
, Beg9    : array[1..4] of string
, Beg10   : array[1..4] of string
, End1    : array[1..4] of string
, End2    : array[1..4] of string
, End3    : array[1..4] of string
, End4    : array[1..4] of string
, End5    : array[1..4] of string
, End6    : array[1..4] of string
, End7    : array[1..4] of string
, End8    : array[1..4] of string
, End9    : array[1..4] of string
, End10   : array[1..4] of string
, Break1  : array[1..4] of string
, Break2  : array[1..4] of string
, Break3  : array[1..4] of string
, Break4  : array[1..4] of string
, Break5  : array[1..4] of string
, Break6  : array[1..4] of string
, Break7  : array[1..4] of string
, Break8  : array[1..4] of string
, Break9  : array[1..4] of string
, Break10 : array[1..4] of string
)
with index
(
  tmpRejim01 = NRec(Surrogate, Unique)
, tmpRejim02 = wLine + cRec[1] + npp
, tmpRejim03 = wLine + cRec[2] + npp
, tmpRejim04 = wLine + cRec[3] + npp
, tmpRejim05 = wLine + cRec[4] + npp
)
;
//*****************************************************************************
table struct tmpTT
(
  NRec         : comp
, cRec         : comp
, cPattern     : comp
, sPattern     : string
, Hours        : double
, wCol         : word
, StartWorkDay : time
, EndWorkDay   : time
, StartBreak1  : time
, EndBreak1    : time
, StartBreak2  : time
, EndBreak2    : time
)
with index
(
  tmpTT01 = NRec(Surrogate, Unique)
, tmpTT02 = cRec + wCol + cPattern + Hours + StartWorkDay + EndWorkDay + StartBreak1 + EndBreak1 + StartBreak2 + EndBreak2    
, tmpTT04 = cRec + Hours
);

//******************************************************************************

Create view
var 
  sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sOtvet
, sSoglOsn
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol  
, sOtvetDol
, sSoglOsnDol
, sTitle 
, sTitle2            : string;

  dBeg
, dEnd               : date;

  totalHoursWeek     : double;

  sFeeSigners
, ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;

  wYear              : word;

  cPodrBoss          : comp;
as select
  tmpReportGraphics.*
from 
  tmpReportGraphics
, KLRejim KLRejim2
, Grafik
, WorkPattern
, WorkPattern WorkPattern2
, SpGraf
, WorkPattern TemplateWorkPattern
, KLNDR
, KLNDR KLNDR2
, tmpSigners
, tmpTable
, tmpTable tmpTable2
, ExClassName
, ExClassVal
, ExClassSeg
, tmpRejim
, tmpTT
, GP_KLNDREXT
, AttrNam
, AttrVal 
, Persons PodrBoss
, Appointments BossApp      
where 
((
    tmpReportGraphics.Name           == KlRejim.NRejim (NoIndex)
AND KlRejim.cCalendar                == Grafik.NRec
AND Grafik.cWorkPattern[1]           == WorkPattern.NRec

AND coKlRejim                        == ExClassName.wTable
AND 'Номер смены'                    == ExClassName.Name

AND ExClassName.ClassCode            == ExClassVal.ClassCode
AND coKlRejim                        == ExClassVal.wTable
AND KlRejim.NRec                     == ExClassVal.cRec

AND ExClassVal.cClassSeg             == ExClassSeg.NRec

AND 11                              >>= KlRejim2.Rejim
//AND KlRejim.Hours                    == KlRejim2.Hours (NoIndex)
and (KlRejim.Hours=0 or KlRejim.Hours  = KlRejim2.Hours)

AND coKLREJIM                        == AttrNam.wTable
AND 'Описание режима работы'         == AttrNam.Name

AND AttrNam.wTable                   == AttrVal.wTable
AND KLREJIM.NRec                     == AttrVal.cRec
AND AttrNam.NRec                     == AttrVal.cAttrNam

AND cPodrBoss                        == PodrBoss.NRec
AND PodrBoss.AppointCur              == BossApp.Nrec
))
;
