  pXL.CreateTblFld('Lunch49Rejim');
  pXL.CreateTblFld('Lunch410Rejim');
                    
  _LOOP tmpRejim ordered by tmpRejim.wLine
    {
      NextVisual;
      pXL.ClearTblBuffer;
      var rr : word; rr := 0; 
      for (i :=1; i <= 4; inc(i))
        {                    
          if (tmpRejim.cRec[i] <> comp(0))
            rr := i;
   
          pXL.SetTblStringFldValue('Name'  + string(i) +   'Rejim', tmpRejim.Name[i]);
          pXL.SetTblStringFldValue('Descr' + string(i) +   'Trjim', tmpRejim.sDesc[i]);

          pXL.SetTblStringFldValue('Line'  + string(i) +  '1Rejim', tmpRejim.Line1[i]);
          pXL.SetTblStringFldValue('Line'  + string(i) +  '2Rejim', tmpRejim.Line2[i]);
          pXL.SetTblStringFldValue('Line'  + string(i) +  '3Rejim', tmpRejim.Line3[i]);
          pXL.SetTblStringFldValue('Line'  + string(i) +  '4Rejim', tmpRejim.Line4[i]);
          pXL.SetTblStringFldValue('Line'  + string(i) +  '5Rejim', tmpRejim.Line5[i]);
          pXL.SetTblStringFldValue('Line'  + string(i) +  '6Rejim', tmpRejim.Line6[i]);
          pXL.SetTblStringFldValue('Line'  + string(i) +  '7Rejim', tmpRejim.Line7[i]);
          pXL.SetTblStringFldValue('Line'  + string(i) +  '8Rejim', tmpRejim.Line8[i]);
          pXL.SetTblStringFldValue('Line'  + string(i) +  '9Rejim', tmpRejim.Line9[i]);
          pXL.SetTblStringFldValue('Line'  + string(i) + '10Rejim', tmpRejim.Line10[i]);

          if (tmpRejim.Hours1[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) +  '1Rejim', tmpRejim.Hours1[i]);
          if (tmpRejim.Hours2[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) +  '2Rejim', tmpRejim.Hours2[i]);
          if (tmpRejim.Hours3[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) +  '3Rejim', tmpRejim.Hours3[i]);
          if (tmpRejim.Hours4[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) +  '4Rejim', tmpRejim.Hours4[i]);
          if (tmpRejim.Hours5[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) +  '5Rejim', tmpRejim.Hours5[i]);
          if (tmpRejim.Hours6[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) +  '6Rejim', tmpRejim.Hours6[i]);
          if (tmpRejim.Hours7[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) +  '7Rejim', tmpRejim.Hours7[i]);
          if (tmpRejim.Hours8[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) +  '8Rejim', tmpRejim.Hours8[i]);
          if (tmpRejim.Hours9[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) +  '9Rejim', tmpRejim.Hours9[i]);
          if (tmpRejim.Hours10[i] <> 0)
            pXL.SetTblNumberFldValue('Hours' + string(i) + '10Rejim', tmpRejim.Hours10[i]);

          if (tmpRejim.Beg1[i] <> tmpRejim.End1[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '1Rejim', '''' + tmpRejim.Beg1[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '1Rejim', '''' + tmpRejim.End1[i]);
            }

          if (tmpRejim.Beg2[i] <> tmpRejim.End2[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '2Rejim', '''' + tmpRejim.Beg2[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '2Rejim', '''' + tmpRejim.End2[i]);
            }

          if (tmpRejim.Beg3[i] <> tmpRejim.End3[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '3Rejim', '''' + tmpRejim.Beg3[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '3Rejim', '''' + tmpRejim.End3[i]);
            }

          if (tmpRejim.Beg4[i] <> tmpRejim.End4[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '4Rejim', '''' + tmpRejim.Beg4[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '4Rejim', '''' + tmpRejim.End4[i]);
            }

          if (tmpRejim.Beg5[i] <> tmpRejim.End5[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '5Rejim', '''' + tmpRejim.Beg5[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '5Rejim', '''' + tmpRejim.End5[i]);
            }

          if (tmpRejim.Beg6[i] <> tmpRejim.End6[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '6Rejim', '''' + tmpRejim.Beg6[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '6Rejim', '''' + tmpRejim.End6[i]);
            }

          if (tmpRejim.Beg7[i] <> tmpRejim.End7[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '7Rejim', '''' + tmpRejim.Beg7[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '7Rejim', '''' + tmpRejim.End7[i]);
            }

          if (tmpRejim.Beg8[i] <> tmpRejim.End8[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '8Rejim', '''' + tmpRejim.Beg8[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '8Rejim', '''' + tmpRejim.End8[i]);
            }

          if (tmpRejim.Beg9[i] <> tmpRejim.End9[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '9Rejim', '''' + tmpRejim.Beg9[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '9Rejim', '''' + tmpRejim.End9[i]);
            }

          if (tmpRejim.Beg10[i] <> tmpRejim.End10[i])
            {
              pXL.SetTblStringFldValue('Begin' + string(i) +  '10Rejim', '''' + tmpRejim.Beg10[i]);
              pXL.SetTblStringFldValue('End'   + string(i) +  '10Rejim', '''' + tmpRejim.End10[i]);
            }


          pXL.SetTblStringFldValue('Lunch' + string(i) +  '1Rejim', tmpRejim.Break1[i]);
          pXL.SetTblStringFldValue('Lunch' + string(i) +  '2Rejim', tmpRejim.Break2[i]);
          pXL.SetTblStringFldValue('Lunch' + string(i) +  '3Rejim', tmpRejim.Break3[i]);
          pXL.SetTblStringFldValue('Lunch' + string(i) +  '4Rejim', tmpRejim.Break4[i]);
          pXL.SetTblStringFldValue('Lunch' + string(i) +  '5Rejim', tmpRejim.Break5[i]);
          pXL.SetTblStringFldValue('Lunch' + string(i) +  '6Rejim', tmpRejim.Break6[i]);
          pXL.SetTblStringFldValue('Lunch' + string(i) +  '7Rejim', tmpRejim.Break7[i]);
          pXL.SetTblStringFldValue('Lunch' + string(i) +  '8Rejim', tmpRejim.Break8[i]);
          pXL.SetTblStringFldValue('Lunch' + string(i) +  '9Rejim', tmpRejim.Break9[i]);
          pXL.SetTblStringFldValue('Lunch' + string(i) + '10Rejim', tmpRejim.Break10[i]);
        }            
      pXL.SetTblNumberFldValue('kolRejim', rr);
      pXL.InsTblRow;
    }

  pXL.PublishTbl('tblRejim');
  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('',0);

}

HandleEvent

cmInit: 
  {
    if (GetFirst tmpReportGraphics <> tsOk) 
      {
        Message('Отсутствуют данные!');
        CloseInterface(cmCancel);
        Exit;    
      }

    iFeeSigners.InitFeeSigners(cgReport_KASSFRO);

    if (NOT ReadMyDsk(sFeeSigners, 'iEnergoGraphics_sFeeSigners', True))
      set sFeeSigners := '';

    if (NOT ReadMyDsk(cPodrBoss, 'iEnergoGraphics_cPodrBoss', True))
      set cPodrBoss := comp(0);

    /*
    if (NOT ReadMyDsk(dBeg, 'iEnergoGraphics_dBeg', True))
      set dBeg := ZeroDate;

    if (NOT ReadMyDsk(dEnd, 'iEnergoGraphics_dEnd', True))
      set dEnd := ZeroDate;
    */

    dBeg := Date( 1, 1, wYear);
    dEnd := Date(31,12, wYear);
     
    if (sFeeSigners <> '')
      iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sFeeSigners);
  }

cmOk:
  {
    PutCommand(cmDefault);
  }

cmPick:
  {
    case CurField of
      #sFeeSigners:
      {
        iFeeSigners.RunWindowFeeSigners(1);
        set sFeeSigners := iFeeSigners.GetFeeSignersName;
      }
      #PodrBoss.FIO:
        if (iGetKau.GetCodeKau(cgiPick, cgKau_KatPersons, cPodrBoss) <> 0)
          set cPodrBoss := cPodrBoss;
    end;

  }

cmDelOnProtect:
  {
    case CurField of
      #sFeeSigners :
      {
        Set sFeeSigners := '';
        SaveMyDsk(sFeeSigners, 'iEnergoGraphics_sFeeSigners');
      }
      #PodrBoss.FIO :
      {
        set cPodrBoss := comp(0);
      }
    end;
  }

cmDefault:
  {
    if (dBeg = ZeroDate)
      {
        Message('Необходимо задать дату начала периода!');
        SelectField(#dBeg);
        Abort;
        Exit;
      }
    else if (Year(dBeg) <> tmpReportGraphics.wYear)
      {
        Message('Дата начала периода должен находиться в ' + tmpReportGraphics.wYear + ' году.');
        SelectField(#dBeg);
        Abort;
        Exit;
      }

    if (dEnd = ZeroDate)
      {
        Message('Необходимо задать дату окончания периода!');
        SelectField(#dEnd);
        Abort;
        Exit;
      }
    else if (Year(dEnd) <> tmpReportGraphics.wYear)
      {
        Message('Дата окончания периода должен находиться в ' + tmpReportGraphics.wYear + ' году.');
        SelectField(#dEnd);
        Abort;
        Exit;
      }

    SaveMyDsk(sFeeSigners, 'iEnergoGraphics_sFeeSigners');
    SaveMyDsk(dBeg       , 'iEnergoGraphics_dBeg');
    SaveMyDsk(dEnd       , 'iEnergoGraphics_dEnd');
    SaveMyDsk(cPodrBoss  , 'iEnergoGraphics_cPodrBoss');
    CreateTable;
    PrintRepost;
  }

cmDone:
  {
  }

end;
end.
