Parameters
  wYear
;
//*****************************************************************************
var iCatFunc   : CatalogsFunctions;     // Переменная типа интерфейс CatalogsFunctions
//******************************************************************************
File MemoFile;
//*****************************************************************************

Screen scrMain (,, sci1Esc);
  show (,,,)  ;
Fields
   dBeg                                                      : NoProtect;
   dEnd                                                      : NoProtect;
   PodrBoss.FIO('Руководитель подразделения'     ,,sci13Esc) : Protect;
   sFeeSigners ('Группа подписантов (F3 - выбор)',,sci13Esc) : Protect;
Buttons
  cmOk    ,,, 'Сформировать печатную форму в соответствии с установленными параметрами',, scGalDial;
  cmCancel,,, 'Закрыть окно без формирования печатной формы',, scGalDial;

<<

 `Период формирования с`.@@@@@@@@@@@@@` по `.@@@@@@@@@@@@@
 `Руководитель подразделения`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Подписанты:`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

       <. Формировать .>       <. Отказ .>
>>
end;

//*****************************************************************************
Function GetMemoVal : string;
{
  var sRes : string; sRes := '';

  if (GetFirst AttrVal = tsOk)
    {
      MemoFile.OpenMemo(AttrVal.vLVar);  
      if (MemoFile.GetSize <> 0)
        while not MemoFile.EOF do
          {
            var buf : string;
            MemoFile.ReadLn(buf);
            sRes := sRes + if (Trim(sRes) = '', '', ''#10#13) + buf;
          }

      MemoFile.Close;
    }

  result := sRes;
}
//*****************************************************************************
Function GetTimeWork(cGrafik : comp; nDay : word; var lcount : double) : string;
{
  var res : string; res := ''; 
  if (GetFirst SpGraf where ((cGrafik         == SpGraf.cGrafik
                          AND date(1,1,nDay)  == SpGraf.dDate)) = tsOk)
    {
      lcount := lcount + (SpGraf.DayChas + SpGraf.DayMin / 60.0) 
                       + (SpGraf.EvnChas + SpGraf.EvnMin / 60.0);

      if (GetFirst TemplateWorkPattern where ((SpGraf.cWorkPattern == TemplateWorkPattern.NRec)) = tsOk)
        { 
           res := TemplateWorkPattern.NameP;
        }
    }

  result := res;
}

Function GetNameDay(i : word) : string;
{
  var res : string='';

   case i of
     1 : res := 'понедельник';
     2 : res := 'вторник';
     3 : res := 'среда';
     4 : res := 'четверг';
     5 : res := 'пятница';
     6 : res := 'суббота';  
     7 : res := 'воскресенье';
  end;

  result := res;
}

function GetQuarter(dDate: date) : comp; cacheable;
{
  GetQuarter := ((Month(dDate) - 1) div 3) + 1;
}
//*****************************************************************************
function GetBreakValue(bb1, be1, bb2, be2 : time) : string;
{
  result := '';

  if (bb1 <> be1)
    result := 'c ' + TimeToStr(bb1, 'HH-MM');
  if (be1 <> bb1)
    result += if (trim(result) = '', '', ' ') + 'до ' + TimeToStr(be1, 'HH-MM');
  if (trim(result) <> '' AND (bb2 <> be2 OR be2 <> bb2))
    result += ''#10#13;
  if (bb2 <> be2)
    result += if (trim(result) = '', '', ' ') + 'c '  + TimeToStr(bb2, 'HH-MM');
  if (be2 <> bb2)
    result += if (trim(result) = '', '', ' ') + 'до ' + TimeToStr(be2, 'HH-MM');
}
//*****************************************************************************
function GetFIO(sFio : string; bFirstF : boolean) : string;
{
  var   str, str2 : string;

  sFio := Trim(sFio);
  str  := sFio;
  str2 := '';

  if (InStr('.', sFio) = 2)
    {
      if (NOT bFirstF)
        {
          result := sFio;
          Exit; 
        }
      else
        {
          var pref : string; pref := SubStr(sFio, 1, 2); 
          sFIO := Trim(SubStr(sFio, 3, Length(sFio)));
          pref := pref + SubStr(sFio, 1, 2);              
          sFIO := Trim(SubStr(sFio, 3, Length(sFio))) + ' ' + pref;
          result := sFio;
          Exit;  
        }
    }

  if (InStr(' ', sFio) <> 0)
    {
       sFio := SubStr(sFio, 1, InStr(' ', sFio) - 1);
       str  := Trim(SubStr(str, InStr(' ', str) + 1, Length(str) - InStr(' ', str)));

       if (InStr(' ', str) <> 0)
         {
           str2 := SubStr(str, 1, 1) + '.';

           if (InStr(' ', str) <> 0)
             {
               str  := Trim(SubStr(str, InStr(' ', str) + 1, Length(str) - InStr(' ', str)));
               str2 := str2 + ' ' + SubStr(str, 1, 1) + '.';
             }
         }
       else
         str2 := str;

       if (bFirstF)
         str := sFio + ' ' + str2;
       else
         str := str2 + ' ' + sFio;
    }

  GetFIO := str;
}
//*****************************************************************************

//*****************************************************************************
Procedure CreateTable;
{
  var nnn : word; nnn := 0;
  var npp : word; npp := 0;
   _LOOP tmpReportGraphics ordered by tmpReportGraphics.sSmena
     if (Not NextVisual)
     {
       break; 
     }
     else   
     { 
       inc(nnn);

       set tmpReportGraphics.wLine := word(Trunc((nnn-1)/4)) + 1;
       set tmpReportGraphics.wCol  := nnn - ((tmpReportGraphics.wLine - 1) * 4);
       if (update current tmpReportGraphics = tsOk)
         {}  

       var i, j, n : word;  

       if (GetFirst KlRejim = tsOk)
         { 
           if (totalHoursWeek = 0)
             totalHoursWeek := KlRejim.Hours;
           if (trim(sTitle2) = '')
             if (((KLREJIM.FILIALNO and 6) shr 1) = 2)
               {
                 sTitle2 := 'по суммированному учету рабочего времени (учетный период - '
                          + iCase(Longint((KLREJIM.FILIALNO and 48) shr 4); 
                                  'месяц', 'квартал', 'полугодие', 'год') + ')';
               } 
              
           case tmpReportGraphics.wCol of
              1 :
                  {
                    if (GetFirst tmpRejim where ((tmpReportGraphics.wLine == tmpRejim.wLine
                                              AND comp(0)                 == tmpRejim.cRec[1])) ordered by tmpRejim.npp <> tsOk)
                      {
                        ClearBuffer(#tmpRejim);
                        inc(npp); 
                        tmpRejim.npp   := npp;
                        tmpRejim.wLine := tmpReportGraphics.wLine;
                        if (insert current tmpRejim = tsOk)
                          {}
                      }
                  }
              2 :
                  {  
                    if (GetFirst tmpRejim where ((tmpReportGraphics.wLine == tmpRejim.wLine
                                              AND comp(0)                 == tmpRejim.cRec[2])) ordered by tmpRejim.npp <> tsOk)
                      {
                        ClearBuffer(#tmpRejim);
                        inc(npp); 
                        tmpRejim.npp   := npp;
                        tmpRejim.wLine := tmpReportGraphics.wLine;
                        if (insert current tmpRejim = tsOk)
                          {}
                      }                 
                  }
              3 :
                  {    
                    if (GetFirst tmpRejim where ((tmpReportGraphics.wLine == tmpRejim.wLine
                                              AND comp(0)                 == tmpRejim.cRec[3])) ordered by tmpRejim.npp <> tsOk)
                      {
                        ClearBuffer(#tmpRejim);
                        inc(npp); 
                        tmpRejim.npp   := npp;
                        tmpRejim.wLine := tmpReportGraphics.wLine;
                        if (insert current tmpRejim = tsOk)
                          {}
                      }               
                  }
              4 :
                  {    
                    if (GetFirst tmpRejim where ((tmpReportGraphics.wLine == tmpRejim.wLine
                                              AND comp(0)                 == tmpRejim.cRec[4])) ordered by tmpRejim.npp <> tsOk)
                      {
                        ClearBuffer(#tmpRejim);
                        inc(npp); 
                        tmpRejim.npp   := npp;
                        tmpRejim.wLine := tmpReportGraphics.wLine;
                        if (insert current tmpRejim = tsOk)
                          {}
                      }               
                  }
              else {Message('Error ' + tmpReportGraphics.wCol );}
           end;

           set tmpRejim.cRec[tmpReportGraphics.wCol]  := KlRejim.NRec;
           set tmpRejim.Name[tmpReportGraphics.wCol]  := KlRejim.NRejim + if (KLREJIM.REJIM = 0, '', '(код ' + string(KLREJIM.REJIM) + ')');
           set tmpRejim.sDesc[tmpReportGraphics.wCol] := Trim(GetMemoVal);
           if (update current tmpRejim = tsOk)
             {} 

           for(i := Month(dBeg); i <= Month(dEnd); inc(i))
             if (GetFirst Klndr where ((KLREJIM.REJIM           == Klndr.rejim
                                    AND tmpReportGraphics.wYear == Klndr.YEARK
                                    AND i                       == Klndr.MONTHK)) = tsOk)
               {
                 if (GetFirst GP_KlndrExt where ((Klndr.Rejim   == GP_KlndrExt.Rejim
                                              AND Klndr.YEARK   == GP_KlndrExt.YearK 
                                              AND Klndr.MONTHK  == GP_KlndrExt.MonthK)) = tsOk)
                   {}

                 for(j := 1; j <= 31; inc(j))
                   if (Last_Day(Date(1, Klndr.MONTHK, Klndr.YEARK)) >= j and Date(j, Klndr.MONTHK, Klndr.YEARK) <= dEnd) 
                   if ((double(Klndr.DAYCHAS[j]) + Klndr.DAYMIN[j] / 60)  <> 0)   
                   {
                     if (IsValid(#GP_KlndrExt))
                       if (GetFirst WorkPattern2 where ((GP_KlndrExt.cWorkPattern[j] == WorkPattern2.NRec)) = tsOk)
                         {}

                     if (GetFirst tmpTT where ((tmpRejim.NRec                                                           == tmpTT.cRec
                                            AND tmpReportGraphics.wCol                                                  == tmpTT.wCol
                                            AND if (IsValid(#WorkPattern2), WorkPattern2.NRec, comp(0))                 == tmpTT.cPattern
                                            AND double(KLNDR.DAYCHAS[j]) + KLNDR.DAYMIN[j] / 60                         == tmpTT.Hours
                                            AND if (IsValid(#GP_KlndrExt), GP_KlndrExt.StartWorkDay[j], time(0,0,0,0))  == tmpTT.StartWorkDay
                                            AND if (IsValid(#GP_KlndrExt), GP_KlndrExt.EndWorkDay[j]  , time(0,0,0,0))  == tmpTT.EndWorkDay 
                                            AND if (IsValid(#GP_KlndrExt), GP_KlndrExt.StartBreak1[j] , time(0,0,0,0))  == tmpTT.StartBreak1
                                            AND if (IsValid(#GP_KlndrExt), GP_KlndrExt.EndBreak1[j]   , time(0,0,0,0))  == tmpTT.EndBreak1  
                                            AND if (IsValid(#GP_KlndrExt), GP_KlndrExt.StartBreak2[j] , time(0,0,0,0))  == tmpTT.StartBreak2
                                            AND if (IsValid(#GP_KlndrExt), GP_KlndrExt.EndBreak2[j]   , time(0,0,0,0))  == tmpTT.EndBreak2 )) <> tsOk)
                      {
                        ClearBuffer(#tmpTT);
                        tmpTT.cRec         := tmpRejim.NRec                                       ;
                        tmpTT.cPattern     := if (IsValid(#WorkPattern2), WorkPattern2.NRec, comp(0));
                        tmpTT.sPattern     := if (IsValid(#WorkPattern2), WorkPattern2.NameP, '');
                        tmpTT.Hours        := double(Klndr.DAYCHAS[j]) + Klndr.DAYMIN[j] / 60     ;
                        tmpTT.wCol         := tmpReportGraphics.wCol;
                        tmpTT.StartWorkDay := if (IsValid(#GP_KlndrExt), GP_KlndrExt.StartWorkDay[j], time(0,0,0,0));
                        tmpTT.EndWorkDay   := if (IsValid(#GP_KlndrExt), GP_KlndrExt.EndWorkDay[j]  , time(0,0,0,0));
                        tmpTT.StartBreak1  := if (IsValid(#GP_KlndrExt), GP_KlndrExt.StartBreak1[j] , time(0,0,0,0));
                        tmpTT.EndBreak1    := if (IsValid(#GP_KlndrExt), GP_KlndrExt.EndBreak1[j]   , time(0,0,0,0));
                        tmpTT.StartBreak2  := if (IsValid(#GP_KlndrExt), GP_KlndrExt.StartBreak2[j] , time(0,0,0,0));
                        tmpTT.EndBreak2    := if (IsValid(#GP_KlndrExt), GP_KlndrExt.EndBreak2[j]   , time(0,0,0,0));

                        if (insert current tmpTT = tsOk)
                          {
                            for (n := 1; n <= 10; inc(n))
                              {
                                if (tmpRejim.Hours1[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours1[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line1[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg1[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End1[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break1[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);
                                    break;   
                                  }
                                else if (tmpRejim.Hours2[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours2[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line2[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg2[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End2[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break2[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);

                                    break;
                                  }
                                else if (tmpRejim.Hours3[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours3[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line3[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg3[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End3[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break3[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);
                                    break;
                                  }
                                else if (tmpRejim.Hours4[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours4[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line4[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg4[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End4[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break4[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);
                                    break;
                                  }
                                else if (tmpRejim.Hours5[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours5[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line5[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg5[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End5[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break5[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);

                                    break;
                                  }                    
                                else if (tmpRejim.Hours6[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours6[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line6[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg6[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End6[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break6[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);
                                    break;
                                  }
                                else if (tmpRejim.Hours7[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours7[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line7[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg7[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End7[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break7[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);
                                    break;
                                  }
                                else if (tmpRejim.Hours8[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours8[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line8[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg8[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End8[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break8[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);
                                    break;
                                  }
                                else if (tmpRejim.Hours9[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours9[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line9[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg9[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End9[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break9[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);
                                    break;
                                  }
                                else if (tmpRejim.Hours10[tmpReportGraphics.wCol] = 0)
                                  {
                                    set tmpRejim.Hours10[tmpReportGraphics.wCol] := tmpTT.Hours;
                                    set tmpRejim.Line10[tmpReportGraphics.wCol]  := tmpTT.sPattern;  
                                    set tmpRejim.Beg10[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.StartWorkDay, 'HH-MM');
                                    set tmpRejim.End10[tmpReportGraphics.wCol]   := TimeToStr(tmpTT.EndWorkDay  , 'HH-MM');  
                                    set tmpRejim.Break10[tmpReportGraphics.wCol] := GetBreakValue(tmpTT.StartBreak1, tmpTT.EndBreak1, tmpTT.StartBreak2, tmpTT.EndBreak2);
                                    break;
                                  }
                              }
                            if (update current tmpRejim = tsOk)
                              {}
                          }
                      }
                   }
               }

           sTitle := sTitle + if (Trim(sTitle) = '', '', '; ') + KlRejim.NRejim + if (KLNDR.REJIM = 0, '', '(код ' + string(KLNDR.REJIM) + ')');

           for(i := Month(dBeg); i <= Month(dEnd); inc(i))
             if (GetFirst KLNDR where ((KLREJIM.REJIM           == KLNDR.rejim
                                    AND tmpReportGraphics.wYear == KLNDR.YEARK
                                    AND i                       == KLNDR.MONTHK)) = tsOk)
               {
                 var LastDay : word; LastDay := AM_Days(i, tmpReportGraphics.wYear);
                 if (GetFirst tmpTable where ((tmpReportGraphics.wYear == tmpTable.wYear
                                           AND i                       == tmpTable.wMonth
                                           AND tmpReportGraphics.Name  == tmpTable.Name)) <> tsOk)
                   {
                     ClearBuffer(#tmpTable);
                     tmpTable.Name    := KlRejim.NRejim;
                     tmpTable.wMonth  := i;
                     tmpTable.wYear   := tmpReportGraphics.wYear;
                     var _wRejim2:word=1;
                     if (GetFirst KLREJIM2 = tsOk)
                         _wRejim2:=KlRejim2.Rejim;
                     if (GetFirst KlNdr2 where ((_wRejim2              == KlNdr2.Rejim
                                             AND tmpReportGraphics.wYear == KlNdr2.YEARK
                                             AND i                       == KlNdr2.MONTHK)) = tsOk)
                     { for(j := 1; j <= LastDay; inc(j))
                       {
                         tmpTable.daysPr  := tmpTable.daysPr  + if (KLNDR2.DAYCHAS[j] <> 0 or KLNDR2.DAYMIN[j] > 0, 1, 0);
                         tmpTable.hoursPr := tmpTable.hoursPr + double(KLNDR2.DAYCHAS[j]) + KLNDR2.DAYMIN[j] / 60;
                       }
                     }
                     if (GetFirst ExClassSeg = tsOk)
                       tmpTable.numSmena:= ExClassSeg.Value;

                     if (insert current tmpTable = tsOk) 
                       {}
                   } 

                 for(j := 1; j <= LastDay; inc(j))
                   { 
                     set tmpTable.dDays[j]  := double(KLNDR.DAYCHAS[j]) + double(KLNDR.DAYMIN[j]) / 60;
                     set tmpTable.dNight[j] := double(KLNDR.CHNChas[j]) + double(KLNDR.CHNMin[j]) / 60;
                   }

                 if (update current tmpTable = tsOk)
                   {} 
               } 
         }
     }
}
//*****************************************************************************
Procedure PrintLine(isDay : boolean);
{
  pXL.ClearTblBuffer;
  pXL.SetTblStringFldValue('NameGrafic', tmpTable.Name);    
  pXL.SetTblStringFldValue('numCmena'  , if (tmpTable.numSmena = '', ' ', tmpTable.numSmena));   
  pXL.SetTblNumberFldValue('wYear'     , tmpTable.wYear);   
  pXL.SetTblNumberFldValue('wMonth'    , tmpTable.wMonth);
  pXL.SetTblNumberFldValue('isDay'     , if (isDay, 1, 0));

  var totalDays  : double; totalDays  := 0;
  var workDays   : double; workDays   := 0;
  var holyDays   : double; holyDays   := 0;
  var workHour   : double; workHour   := 0;
  var TotalUnWork: double; TotalUnWork:= 0;
  var TotalUpWork: double; TotalUpWork:= 0;
  var TotalNight : double; TotalNight := 0;
  var lastDay : word; lastDay := AM_Days(tmpTable.wMonth, tmpTable.wYear);

  var j : word;
  for(j := 1; j <= 31; inc(j))  
    {
      workDays += if (isDay, if (tmpTable.dDays[j] > 0, 1, 0), 0);
      holyDays += if (isDay, if (tmpTable.dDays[j] > 0, 1, 0), 0);
      workHour += if (isDay, tmpTable.dDays[j], 0);

      //if (if (isDay, tmpTable.dDays[j], tmpTable.dNight[j]) <> 0)

      if (lastDay >= j)  
        pXL.SetTblNumberFldValue('MD' + j + 'T', if (isDay, tmpTable.dDays[j], tmpTable.dNight[j]));
      else
        pXL.SetTblStringFldValue('MD' + j + 'T', ' ');
    } 
  //#384.#41 не заполняются поля exPrWorkDays WorkDaysPK, WorkHourPK
  pXL.SetTblNumberFldValue('TotalDays'  , totalDays  );
  pXL.SetTblNumberFldValue('WorkDays'   , workDays   );
  pXL.SetTblNumberFldValue('HolyDays'   , holyDays   );
  pXL.SetTblNumberFldValue('WorkHour'   , workHour   );
  pXL.SetTblNumberFldValue('WorkDaysPK' , tmpTable.daysPr );
  pXL.SetTblNumberFldValue('WorkHourPK' , tmpTable.hoursPr);
  pXL.SetTblNumberFldValue('TotalUnWork', TotalUnWork);
  pXL.SetTblNumberFldValue('TotalUpWork', TotalUpWork);
  pXL.SetTblNumberFldValue('TotalNight' , TotalNight );
  pXL.InsTblRow;
}
//*****************************************************************************
Procedure PrintRepost;
{
  ID := 'GraphicsNew';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Идет формирование отчета', RecordsInTable(#tmpRejim));

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'       , CommonFormHeader);

  delete all tmpSigners;

  if (iFeeSigners.FeeSignersIsValid)
  {
    var wFeeSignersNum, wFeeSignersCount : word;
    wFeeSignersCount := iFeeSigners.GetFeeSignersCount;

    if (iFeeSigners.GetSignerFirst)
    {
      For (wFeeSignersNum := 1; wFeeSignersNum <= wFeeSignersCount; wFeeSignersNum++)
      {
         if (iFeeSigners.GetSignerRole = 'Согласовано (шапка)')
         {
           sSogls     := iFeeSigners.GetSignerFIO(7);
           sSoglsDol  := iFeeSigners.GetSignerPosition(1);
         }
         else if (iFeeSigners.GetSignerRole = 'Утверждающее лицо')
         {
           sUtve     := iFeeSigners.GetSignerFIO(7);
           sUtveDol  := iFeeSigners.GetSignerPosition(1);
         }
         else if (iFeeSigners.GetSignerRole = 'Проверяющее лицо')
         {  
           ClearBuffer(#tmpSigners);
           tmpSigners.kod := iFeeSigners.GetSignerNumber;
           tmpSigners.Fio := iFeeSigners.GetSignerFIO(7);
           tmpSigners.Dol := iFeeSigners.GetSignerPosition(1);
           if (insert current tmpSigners = tsOk)
             {}
         }
         else if (iFeeSigners.GetSignerRole = 'Согласовано (подножие)')
         {
           sSogls2     := iFeeSigners.GetSignerFIO(7);
           sSogls2Dol  := iFeeSigners.GetSignerPosition(1);
         }
         else if (iFeeSigners.GetSignerRole = 'Ответственный')
         {
           sOtvet    := iFeeSigners.GetSignerFIO(7);
           sOtvetDol := iFeeSigners.GetSignerPosition(1);
         }
         else if (iFeeSigners.GetSignerRole = 'Согласовано')
         {
           sSoglOsn    := iFeeSigners.GetSignerFIO(7);
           sSoglOsnDol := iFeeSigners.GetSignerPosition(1);
         }

        if (not iFeeSigners.GetSignerNext)
          break;
      }
    }
  }

  _LOOP tmpSigners ordered by tmpSigners.Kod
  {
    if (sPodpis1 = '')
    {
      sPodpis1    := tmpSigners.Fio;
      sPodpis1Dol := tmpSigners.Dol;
    }
    else if (sPodpis2 = '')
    {
      sPodpis2    := tmpSigners.Fio;
      sPodpis2Dol := tmpSigners.Dol;
    }
  } 

  sPodpis2     := sPodpis1;   
  sPodpis2Dol  := sPodpis1Dol;



  //sPodpis1     := sOtvet;
  //sPodpis1Dol  := sOtvetDol;
  sPodpis1     := GetFIO(PodrBoss.Fio, true);
  sPodpis1Dol  := iCatFunc.GetCatalogsName(BossApp.Post);

  pXL.SetStringVar('SoglFIO'   , sSogls     );
  pXL.SetStringVar('SoglDol'   , sSoglsDol  );
  pXL.SetStringVar('Sogl2FIO'  , sSogls2    );
  pXL.SetStringVar('Sogl2Dol'  , sSogls2Dol );
  pXL.SetStringVar('UtvrFIO'   , sUtve      );
  pXL.SetStringVar('UtvrDol'   , sUtveDol   );
  pXL.SetStringVar('Podpis1FIO', sPodpis1   );
  pXL.SetStringVar('Podpis1Dol', sPodpis1Dol);
  pXL.SetStringVar('Podpis2FIO', sPodpis2   );
  pXL.SetStringVar('Podpis2Dol', sPodpis2Dol);
  pXL.SetStringVar('Otvet'     , sOtvet     );
  pXL.SetStringVar('SoglOsn'   , sSoglOsn   );
  pXL.SetStringVar('OtvetDol'  , sOtvetDol  );
  pXL.SetStringVar('SoglOsnDol', sSoglOsnDol);

  pXL.SetStringVar('Title'     , sTitle     );
  pXL.SetStringVar('Title2'    , sTitle2    );

  if (dBeg <> ZeroDate)
    pXL.SetStringVar('beg'       , '''' + DateToStr(dBeg, 'DD.MM.YYYY'));

  if (dEnd <> ZeroDate)
    pXL.SetStringVar('end'       , '''' + DateToStr(dEnd, 'DD.MM.YYYY'));

  pXL.SetNumberVar('totalHoursWeek', totalHoursWeek);
  pXL.SetStringVar('nightTime' ,'Часы ночной работы с 22:00 до 06:00 следующего дня' );



  pXL.PublishVar;  // Excel

  pXL.CreateTbls(sXLSFileName);
  pXL.CreateTbl('tblGraphics');     
  pXL.CreateTblFld('numCmena');
  pXL.CreateTblFld('wMonth');
  pXL.CreateTblFld('wYear');
  pXL.CreateTblFld('isDay');
  pXL.CreateTblFld('NameGrafic');
  pXL.CreateTblFld('TotalDays');
  pXL.CreateTblFld('WorkDays');
  pXL.CreateTblFld('HolyDays');
  pXL.CreateTblFld('WorkHour');
  pXL.CreateTblFld('WorkDaysPK');
  pXL.CreateTblFld('WorkHourPK');

  var i, j : word;
  for(j := 1; j <= 31; inc(j))
    pXL.CreateTblFld('MD' + j + 'T');


  pXL.CreateTblFld('TotalUnWork');
  pXL.CreateTblFld('TotalUpWork');
  pXL.CreateTblFld('TotalNight');

  var wQ : word; wQ := 0;
  var printLastData : word; printLastData := 0;
    
  _LOOP tmpTable ordered by tmpTable.wYear, tmpTable.wMonth, tmpTable.Name
    if (Not NextVisual)
    {
      break; 
    }
    else   
    {                  
      if (printLastData <> Trunc((tmpTable.wMonth - 1) / 3) + 1 AND printLastData <> 0) 
        if (((tmpTable.wMonth - 1) / 3) * 3 = word((tmpTable.wMonth -1) /3) * 3 AND wQ <> word((tmpTable.wMonth -1) /3))
          {
            wQ := word((tmpTable.wMonth -1) /3);
            _LOOP tmpTable2 where ((tmpTable.wYear  == tmpTable2.wYear
                                AND tmpTable.wMonth == tmpTable2.wMonth)) ordered by tmpTable2.Name
              {
                pXL.ClearTblBuffer;
                pXL.SetTblNumberFldValue('isDay'     , 2);    
                pXL.SetTblStringFldValue('wMonth'    , word(tmpTable2.wMonth/3) + ' кв.');
                pXL.SetTblStringFldValue('numCmena'  , if (tmpTable2.numSmena = '', ' ', tmpTable2.numSmena));
                pXL.SetTblStringFldValue('MD31T'     , if (tmpTable2.numSmena = '', ' ', tmpTable2.numSmena));
                pXL.InsTblRow;
              }
          }
      
      printLastData := word(Trunc((tmpTable.wMonth - 1) / 3) + 1);

      PrintLine(TRUE);
      PrintLine(FALSE);
    }

  _LOOP tmpTable2 where ((tmpTable.wYear  == tmpTable2.wYear
                      AND tmpTable.wMonth == tmpTable2.wMonth)) ordered by tmpTable2.Name
    {
      pXL.ClearTblBuffer;
      pXL.SetTblNumberFldValue('isDay'     , 2);    
      pXL.SetTblStringFldValue('wMonth'    , word(tmpTable2.wMonth/3) + ' кв.');
      pXL.SetTblStringFldValue('numCmena'  , if (tmpTable2.numSmena = '', ' ', tmpTable2.numSmena));
      pXL.SetTblStringFldValue('MD31T'     , if (tmpTable2.numSmena = '', ' ', tmpTable2.numSmena));
      pXL.InsTblRow;
    }

  _LOOP tmpTable2 where ((tmpTable.wYear  == tmpTable2.wYear
                      AND tmpTable.wMonth == tmpTable2.wMonth)) ordered by tmpTable2.Name
    {
      pXL.ClearTblBuffer;
      pXL.SetTblNumberFldValue('isDay'     , 3);    
      pXL.SetTblNumberFldValue('wMonth'    , tmpTable2.wYear);
      pXL.SetTblStringFldValue('numCmena'  , if (tmpTable2.numSmena = '', ' ', tmpTable2.numSmena));
      pXL.SetTblStringFldValue('MD31T'     , if (tmpTable2.numSmena = '', ' ', tmpTable2.numSmena));
      pXL.InsTblRow;
    }


  pXL.PublishTbl('tblGraphics');

  pXL.CreateTbl('tblRejim');     
  pXL.CreateTblFld('kolRejim');
  pXL.CreateTblFld('Name1Rejim');
  pXL.CreateTblFld('Name2Rejim');
  pXL.CreateTblFld('Name3Rejim');
  pXL.CreateTblFld('Name4Rejim');
  pXL.CreateTblFld('Descr1Trjim');
