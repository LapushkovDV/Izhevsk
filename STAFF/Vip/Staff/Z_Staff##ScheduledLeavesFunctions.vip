#component "Z_Staff"

//ScheduledLeavesFunctions - Функции для работы с плановыми отпусками, в т.ч. функции расчета смещений рабочих
//периодов сотрудников

//РПД 131 "Прогул" при утверждении формирует отпуск "Прогул" и неявку ПР в табеле сотрудника с типом
//akVacation "о". При пересчете табеля эта неявка не смещает рабочий период сотрудника,
//а нужно чтобы смещала. Смещают рабочий период неявки с типом akVacation только если это
//отпуск по уходу за ребенком или административный отпуск длиною более n дней. Перекрываем
//Функцию определения принадлежности отпуска: если проверяется принадлежность отпуска на уход за ребенком
//и наименование проверяемого отпуска = "Прогул" - функция возвращает истину. Таким образом, при расчете
//смещений Прогул будет обрабатываться как отпуск по уходу, т.е. будет смещать рабочий период.
alter interface ScheduledLeavesFunctions;

overload
  function IsChildOf(Code, Parent: word): boolean;
end;

function IsChildOf(Code, Parent: word): boolean;
{
  if Parent = ChildCareLeaveCode
    if getfirst KLOTPUSK where ((Code == KLOTPUSK.KOTPUS)) = tsOk
      if KLOTPUSK.NOTPUS = 'Прогул'
      {
        result := true;
        exit;
      }

  result := inherited::IsChildOf(Code, Parent);
}

end.
