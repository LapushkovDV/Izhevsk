#ifndef __GP_PartDocAccessController__
#define __GP_PartDocAccessController__

//Константы для маски прав доступа к РПД
//Управление персоналом | Настройка | Права доступа | к распорядительным действиям | к распорядительным действиям
const
  GP_ATTRNAM_NAME_PARTDOC_HIDDEN = 'Скрыто'; //Наименование строкового внешнего атрибута PartDoc c признаком скрытости РПД
  GP_ATTRVAL_VALUE_PARTDOC_HIDDEN = '+';     //Значение строкового внешнего атрибута PartDoc, для обозначения признака скрытости РПД
  GP_BIT_RPD_ENABLED: word = 1;            //РПД доступно, используется стандартным функционалом
  GP_BIT_RPD_ENABLED_ONLY_DESGR: word = 2; //По РПД доступны только приказы PartDoc с группой дескрипторов пользователя
  GP_BIT_RPD_ENABLED_ONLY_DESCR: word = 4; //По РПД доступны только приказы PartDoc с дескриптором пользователя
  GP_BIT_RPD_ENABLED_HIDDEN: word = 8;     //По РПД доступны скрытые приказы
end;

#doc
Объектный интерфейс с функциями для проверки доступа к PartDoc в зависимости от пользователя
#end
objinterface GP_IPartDocAccessController;
  #doc
  Получить маску доступа для пользователя по коду РПД
  #end
  function GetUsersAccessFlag(cUser: comp; typeOper: word): comp;

  #doc
  Возвращает true, если пользователь cUser имеет доступ к PartDoc
  #end
  function UserHasAccess(cUser: comp; partdocNrec: comp): boolean;

  #doc
  Возвращает маркер со списком недоступных PartDoc. Таких, для которых установлена доступность
  (нулевой бит в servstav.cserv установлен), но отличается дескриптор или группа дескрипторов
  в зависимости от первого или второго бита servstav.cserv.
  #end
  function GetDisabledPartDocMarker(cUser: comp = 0): TPtr;
end;

#doc
Класс с функциями для проверки доступа к PartDoc с учетом дескриптора
и группы дескрипторов пользователя. Стандартный функционал проверяет только доступность РПД в целом:
проверяется активность нулевого бита в servstav.cserv. GP_PartDocAccessController анализирует первый и
второй биты servstav.cserv для установки запрета по группе дескрипторов или дескриптору пользователя.
Ссылка на пользователя-создателя сохраняется в partdoc.cref2 с помощью триггера before insert;
22.11.17. Анализируется третий бит - признак доступности скрытых РПД. Сам признак скрытости РПД приказа
хранится во внешнем атрибуте "Скрыто" к PartDoc.
#end
vipinterface GP_PartDocAccessController implements GP_IPartDocAccessController
  licensed(free);

#end
