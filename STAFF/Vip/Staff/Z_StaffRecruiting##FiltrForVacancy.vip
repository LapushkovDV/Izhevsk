#component "Z_StaffRecruiting"

alter interface FiltrForVacancy

handleevent

  cmInit:
  {
    case inherited::handleevent(cmInit) of
      heAbort: { abort; exit; }
      heStop: stop;
    end;
    var sButtonTitle: string = '';
    if not ReadMyDsk(sButtonTitle, 'FiltrForVacancy_ChangeButtonTitle', false) sButtonTitle := '';
    if sButtonTitle != ''
    {
      cfsSetCurrentContainer(cfsGetCurrentContainerSelf);
      cfsSetProp('b_FORBUTTONS_Применить_фильтр', 'Title', sButtonTitle);
    }
  }

end;

end.
