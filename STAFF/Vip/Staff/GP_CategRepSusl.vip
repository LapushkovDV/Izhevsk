  // Вывод тела расшифровки
procedure OutBodyData(var R: LongInt);
  var
    C: Word;
{
    SetVisualHeader('Вывод расшифровки в отчет...');
    _loop SData
    {
      if IsAborted then
        break;
      NextVisual;
      C := FirstCol - 1;
      // Код ЗГД
    //  xlOp(xlSetCellStringValue(String(CAT.Code, 1, 3), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // ЗГД 1 уровень
     // xlOp(xlSetCellStringValue(string(personsZGD.FIO), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Первые три символа кода подразделения
      xlOp(xlSetCellStringValue(SubStr(SData.DepCode, 1, 3), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Код подразделения
      xlOp(xlSetCellStringValue(SData.DepCode, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Наименование подразделения
      xlOp(xlSetCellStringValue(CatDepR.Name, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Должность
      xlOp(xlSetCellStringValue(CatPosR.Name, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Код категории
      xlOp(xlSetCellNumberValue(KlKategoR.Kod, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Наименование категории
      xlOp(xlSetCellStringValue(KlKategoR.NaiKat, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Таб №
      xlOp(xlSetCellStringValue(GetStrTabN(PersonsR.TabNmb, PersonsR.StrTabN), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // ФИО сотрудника
      xlOp(xlSetCellStringValue(PersonsR.FIO, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Дата приема
      xlOp(xlSetCellDateValue(PersonsR.AppDate, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Дата увольнения
      xlOp(xlSetCellDateValue(PersonsR.DisDate, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // История приемов и увольнений на предприятии
      xlOp(xlSetCellStringValue(GetPrevWorkPer(PersonsR.NRec), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Код вида работы
      xlOp(xlSetCellNumberValue(Word(PersonsR.cSovm), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Наименование вида работы
      xlOp(xlSetCellStringValue(KlSovmR.NSovm, R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // количество занимаемых ставок
      xlOp(xlSetCellStringValue(String(sData.rate), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Условия труда
      xlOp(xlSetCellStringValue(String(wk.Code), R, ++C, R, C), XE_SET_CELL_VALUE, '');
      // Количество ставок (декрет)
      xlOp(xlSetCellStringValue(String(if(SData.otpNum = '2'  or SData.otpNum = '4' or SData.otpNum = '5'
                                        or SData.otpNum = '6','1','0')), R, ++C, R, C), XE_SET_CELL_VALUE, '');

      R++;
    }
}

  // Выводит информацию о текущем работнике в лог
procedure OutPersonInfoToLog;
 {
    if not IsPsnInfoLogged then
    {
      IsPsnInfoLogged := true;
      oGP_Log.Info('Таб.№ ' + GetStrTabN(Persons.TabNmb, Persons.StrTabN) + ' ' + Persons.FIO + ':' +
       ' Вид работы: ' + To_Char(KlSovm.Sovm) + ' ' + KlSovm.NSovm);
    }
 }

  // Подготовка данных для отчёта
procedure PrepareData;
  var
    _DepCode: String[3];
 {
    if IsAborted then
      exit;
    StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Анализ данных...', 1);
    _try
     {
        /*if not (ConditionActive(tcByOtpDat)) {
          PushCondition(tcByOtpDat);
        }   */

        TPersonNum := 0;
        TWomenNum := 0;
        _loop Appointments
       {
          if IsAborted then
            break;
          NextVisual;
          IsPsnInfoLogged := false;
          #ifdef __DEBUG__
          oGP_Log.Info('');
          OutPersonInfoToLog;
          oGP_Log.Info(' Подразделение: ' + CatDep.Code + ' ' + CatDep.Name);
          #end
          // Если не влючен параметр "выводить внешних совместителей"
          if (pSettings and ST_SHOW_EXT_SOVM) = 0 then
            // В отчет не должны попадать внешние совместители, у которых вид работы с кодом = 1 "По совместительству (внешнее)"
            if (Word(Persons.cSovm) = 1)
            {
              #ifdef __DEBUG__
              oGP_Log.Info('  Код вида работы = ' + To_Char(Word(Persons.cSovm)) + '. В отчет не включен.');
              #end
              continue;
            }
          // Если работник уволен до или в дату, на которую формируется отчёт, не выводим его
          if (Persons.DisDate != ZeroDate and Persons.DisDate <= pDate)
          {
            #ifdef __DEBUG__
            oGP_Log.Info('  Дата увольнения в карточке = ' + DateToStr(Persons.DisDate, 'DD.MM.YYYY') + '. В отчет не включен.');
            #end
            continue;
          }
          if (pFilters and FT_ST_STR_ED) != 0 then
            if not FoundMarker(fmDept, Appointments.Department) then
            {
              #ifdef __DEBUG__
              oGP_Log.Info('  Не соответствует фильтру по подразделению. В отчет не включен.');
              #end
              continue;
            }
          if not IsValid(tnKlKatego) then
          {
            oGP_Log.Error('Не заполнена категория (Таб.№ ' + GetStrTabN(Persons.TabNmb, Persons.StrTabN) + ' ' + Persons.FIO + ')');
            continue;
          }
          #ifdef __DEBUG__
          oGP_Log.Info('  Включен в отчет');
          #end
          if not IsValid(tnCatDep) then
          {
            OutPersonInfoToLog;
            oGP_Log.Info(' Ошибка: некорректная ссылка в Appointments.Department = ' + To_Char(Appointments.Department, 0, 0) +
             ' (Appointments.NRec = ' + To_Char(Appointments.NRec, 0, 0) + ')');
            continue;
          }
          // Добавляем запись в расшифровку
          ClearBuffer(#SData);
          SData.TabNmb := Persons.TabNmb;
          SData.StrTabn := Persons.StrTabn;
          SData.cPerson := Appointments.Person;
          SData.cDep := Appointments.Department;
          SData.cPosition := Appointments.Post;
          SData.cCateg := Appointments.EmpCategory;
          SData.DepCode := CatDep.Code;
          SData.rate    := Appointments.rate;
          SData.cAppoint    := Appointments.nrec;
         // SData.cAppZGD := Appointments.STAFFSTR;



          _loop otpusk where ((Appointments.Person == otpusk.TPERSON (noindex))) {
             if (pdate >= otpusk.datan and pdate <= otpusk.datok) {
                Sdata.otpNum := otpusk.KOTPUS;
             }
          }


          if insert current SData != tsOk then
         {
            oGP_Log.Error('Не удалось добавить запись в таблицу SData (Appointments.NRec = ' + 
             To_Char(Appointments.NRec, 0, 0) + ')');
            continue;
         }
          // Обновляем список категорий
          if getFirst SCateg where ((SData.cCateg == SCateg.cCateg)) != tsOk then
          {
            ClearBuffer(#SCateg);
            SCateg.cCateg := SData.cCateg;
            SCateg.Code := KlKatego.Kod;
            SCateg.Name := KlKatego.NaiKat;
            SCateg.PersonNum := 1;
            if insert current SCateg != tsOk then
           {
              oGP_Log.Error('Не удалось добавить запись в таблицу SCateg (Appointments.NRec = ' + 
               To_Char(Appointments.NRec, 0, 0) + ')');
              continue;
           }
          } else
          {
            SCateg.PersonNum := SCateg.PersonNum + 1;
            if update current SCateg != tsOk then
            begin
              oGP_Log.Error('Не удалось обновить запись в таблице SCateg (Appointments.NRec = ' + 
               To_Char(Appointments.NRec, 0, 0) + ')');
              continue;
            end;
          }
          // Обновляем список подразделений
          _DepCode := SubStr(CatDep.Code, 1, 3);
          if getFirst SDep where ((_DepCode == SDep.Code)) != tsOk then
          {
            ClearBuffer(#SDep);
            SDep.NRec := RecordsInTable(#SDep) + 1;
            SDep.Code := _DepCode;
            SDep.PersonNum := 1;
            if Persons.Sex = 'Ж' then
              SDep.WomenNum := 1;
            if insert current SDep != tsOk then
            {
              oGP_Log.Error('Не удалось добавить запись в таблицу SDep (Appointments.NRec = ' + 
               To_Char(Appointments.NRec, 0, 0) + ')');
              continue;
            };
          } else
          {
            SDep.PersonNum := SDep.PersonNum + 1;
            if Persons.Sex = 'Ж' then
              SDep.WomenNum := SDep.WomenNum + 1;
            if update current SDep != tsOk then
            {
              oGP_Log.Error('Не удалось обновить запись в таблице SDep (Appointments.NRec = ' + 
               To_Char(Appointments.NRec, 0, 0) + ')');
              continue;
            }
          }
          // Увеличиваем общие итоги
          TPersonNum++;
          if Persons.Sex = 'Ж' then
            TWomenNum++;
          // Обновляем данные по кол-ву человек этой категории в этом подразделении
          if getFirst SDepCateg where ((SDep.NRec == SDepCateg.cSDep and SCateg.cCateg == SDepCateg.cCateg)) != tsOk then
          {
            ClearBuffer(#SDepCateg);
            SDepCateg.cSDep := SDep.NRec;
            SDepCateg.cCateg := SCateg.cCateg;
            SDepCateg.PersonNum := 1;
            if insert current SDepCateg != tsOk then
            {
              oGP_Log.Error('Не удалось добавить запись в таблицу SDepCateg (Appointments.NRec = ' + 
               To_Char(Appointments.NRec, 0, 0) + ')');
              continue;
            }
          } else
          {
            SDepCateg.PersonNum := SDepCateg.PersonNum + 1;
            if update current SDepCateg != tsOk then
            {
              oGP_Log.Error('Не удалось обновить запись в таблице SDepCateg (Appointments.NRec = ' + 
               To_Char(Appointments.NRec, 0, 0) + ')');
              continue;
            }
          }
       }
     }
    _except
      on ExUserBreak:
        {
          IsAborted := true;
        }
    StopVisual('', 0);
 }

  file MacroFile;

  function CreateMacro(MacroFileName: string): Boolean;
  {
    result := false;
    if MacroFile.OpenFile(MacroFileName, stCreate) then
    {
      MacroFile.Writeln('Sub FormatReport');
      MacroFile.Writeln('  Sheets("' + Oem2Ansi(TAB_TITLE_2) + '").Select');
      MacroFile.Writeln('  Selection.AutoFilter');
      MacroFile.Writeln('  Sheets("' + Oem2Ansi(TAB_TITLE_1) + '").Select');
      MacroFile.Writeln('  Application.PrintCommunication = False');
      MacroFile.Writeln('  With ActiveSheet.PageSetup');
      MacroFile.Writeln('    .Orientation = xlPortrait');
      MacroFile.Writeln('    .LeftMargin = Application.InchesToPoints(0.7)');
      MacroFile.Writeln('    .RightMargin = Application.InchesToPoints(0.4)');
      MacroFile.Writeln('    .TopMargin = Application.InchesToPoints(0.75)');
      MacroFile.Writeln('    .BottomMargin = Application.InchesToPoints(0.75)');
      MacroFile.Writeln('    .HeaderMargin = Application.InchesToPoints(0.3)');
      MacroFile.Writeln('    .FooterMargin = Application.InchesToPoints(0.3)');
      MacroFile.Writeln('    .PaperSize = xlPaperA4');
      MacroFile.Writeln('    .PrintTitleRows = "$2:$4"');
      MacroFile.Writeln('    .PrintTitleColumns = ""');
      MacroFile.Writeln('    .RightFooter = "&P"');
//    MacroFile.Writeln('    .FitToPagesWide = 1');
      MacroFile.Writeln('  End With');
      MacroFile.Writeln('  Application.PrintCommunication = True');
      MacroFile.Writeln('End Sub');
      MacroFile.Close;
      result := true;
  } else
      oGP_Log.Error('Не удалось создать файл "' + MacroFileName + '"');
  }

  procedure RunMacro;
  var
    MacroFileName: String;
  {
    if IsAborted then
      exit;
    MacroFileName := GetDefaultUserPath + REP_NAME + '.bas';
    if not CreateMacro(MacroFileName) then
      exit;
    xlImportModule(MacroFileName);
    xlRunMacro('FormatReport');
    DeleteFile(MacroFileName);
  }

  // Формирует отчёт
  procedure CreateReport;
  var
    OutFileName: String;
    R: LongInt;
  {
    IsAborted := false;
    PrepareData;
    if IsAborted then
      exit;

    DataRecCnt := RecordsInTable(#SData);
    if DataRecCnt = 0 then
    {
      Message('Нет данных для формирования отчёта');
      exit;
    }

    RepRecCnt := RecordsInTable(#SDep);

    OutFileName := GetDefaultUserPath + REP_TITLE + ' на ' + DatetoStr(pDate, 'DD.MM.YYYY') + '.xlsx';
    StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', RepRecCnt + DataRecCnt);
    _try
    {
      PrepareExcelFile(OutFileName);

      // Страница "Отчёт"
      xlOp(xlSetActiveSheet(1), XE_SET_SHEET, TAB_TITLE_1);
      FirstHeadRow := 2; // Одну строку оставляем для заголовка
      FirstBodyRow := FirstHeadRow + 3; // Высота шапки - 3 строки
      LastBodyRow := FirstBodyRow + RepRecCnt - 1;
      R := 1;
      // Выводим загловок отчёта
      OutTitleRep(R);
      // Выводим шапку отчёта
      OutHeaderRep(R);
      // Выводим тело отчёта
      OutBodyRep(R);
      // Выводим подвал отчёта
      OutFooterRep(R);

      // Страница "Расшифровка"
      xlOp(xlSetActiveSheet(2), XE_SET_SHEET, TAB_TITLE_2);
      R := 1;
      // Выводим заголовок отчёта
      FirstHeadRow := R;
      FirstBodyRow := FirstHeadRow + 1; // Высота шапки - 1 строка
      LastBodyRow := FirstBodyRow + DataRecCnt - 1;
      // Выводим шапку отчёта
      OutHeaderData(R);
      // Выводим тело отчёта
      OutBodyData(R);

      // Запускаем макрос
      xlOp(xlSetActiveSheet(1), XE_SET_SHEET, TAB_TITLE_1);
      RunMacro;
  }
    _except on ExOnExecelError, ExUserBreak:
    {
      IsAborted := true;
  }
    StopVisual('',0);
    xlKillExcel;
  }

  //------------------------------------------------------------------------------------------------------------------------------

  HandleEvent
    cmInit:
      {
        fmDept := InitMarker(REP_NAME + 'fmDept', 8, 30, 10);
        if AskParam then
        begin
          oGP_Log.Init(REP_NAME + '.log', true, true, true);
          oGP_Log.SetVerboseMode(true);
          CreateReport;
          oGP_Log.Done(true);
        end;
        DoneMarker(fmDept, REP_NAME + 'fmDept');
        abort;
      }
    cmCheckField:
      case CurField of
        #pFilters:
          if pFilters > Word(OldFieldValue) then
          {
            case (pFilters - Word(OldFieldValue)) of
              FT_ST_STR_ED:
                {
                  SelectField(#fsDept);
                  PutCommand(cmPick);
                }
            end;
          }

      end;
    cmPick:
      case CurField of
        #fsDept:
          {
            // Сохраняем в dsk текущий фильтр по структурным единицам
            DoneMarker(fmDept, 'CatalogsMarker');
            // Вызываем интерфейс выбора структурных единиц
            RunInterface('Z_STAFFCAT::PickCatalog2', CAT_DEP_ENTRY, 0, 100, 0);
            // Считываем из dsk список выбранных структурных единиц
            fmDept := InitMarker('CatalogsMarker', 8, 30, 10);
            pFilters := pFilters or FT_ST_STR_ED;
            UpdateFiltersState;
          }
      end;
    cmDelOnProtect:
      case CurField of
        #fsDept:
          {
            ClearMarker(fmDept);
            pFilters := pFilters and (not FT_ST_STR_ED);
            UpdateFiltersState;
          }
      end;
  end;

end.

//=[ Функции для подключения отчета ]=================================

#include UserReport.vih

vipinterface UserReport_GP_CategRepsusl implements IUserReport;

interface UserReport_GP_CategRepsusl;

  procedure Run;
  begin
    RunInterface('GP_CategRepsusl');
  end;

  function GetReportName: String;
  begin
    result := 'Отчёт о списочной численности';
  end;

  function GetGroupName(Level: Word): String;
  begin
    result := '';
    case Level of
      1: result := 'Ведение картотеки сотрудников';
    end;
  end;

  function GetPriority: Integer;
  begin
    result := 0;
  end;

  function VisibleInModule(Ind: Byte): String;
  begin
    result := '';
    case Ind of
      1: result := 'STAFFMAINMENU';
    end;
  end;

end.
