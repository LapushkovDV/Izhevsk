//******************************************************************************
// Временная таблица с выводимым данными по каждой ставке
//******************************************************************************
Table Struct RT
(
  sPost        : string 
, FIO          : string  // ФИО сотрудника
, dQuant       : double  // кол-во ставок
, Razriad      : word    // разряд (который из оклада)
, TarifKoeff   : double  // тарифный коэффициент
, CorrKoeff    : double  // корректирующий коэффициент
, dOklad       : double  // тарифная ставка\оклад
, dTar1        : double  // сумма доплаты в колонку тарифов
, dTarPerc1    : double  // процент по данной доплате
, dTar2        : double  // сумма доплаты в колонку тарифов
, dTarPerc2    : double  // процент по данной доплате
, dTar3        : double  // сумма доплаты в колонку тарифов
, dTarPerc3    : double  // процент по данной доплате
, dTar4        : double  // сумма доплаты в колонку тарифов
, dTarPerc4    : double  // процент по данной доплате
, dTar5        : double  // сумма доплаты в колонку тарифов
, dTarPerc5    : double  // процент по данной доплате
, dRaise1      : double  // сумма доплаты в колонку Надбавок
, dRaisePerc1  : double  // процент по данной доплате
, dRaise2      : double  // сумма доплаты в колонку Надбавок
, dRaisePerc2  : double  // процент по данной доплате
, dRaise3      : double  // сумма доплаты в колонку Надбавок
, dRaisePerc3  : double  // процент по данной доплате
, dRaise4      : double  // сумма доплаты в колонку Надбавок
, dRaisePerc4  : double  // процент по данной доплате
, dRaise5      : double  // сумма доплаты в колонку Надбавок
, dRaisePerc5  : double  // процент по данной доплате
, cPodr        : comp    // ссылка на подразделение
, sPodrName    : string
, sPodrCode    : string  
, KatPersCode  : string
, KatPersName  : string
, DopKat       : string
, VidPr        : string
, MinOklad     : double
, MaxOklad     : double
, SysOpl       : string
, LevelOpl     : string
, VidStav      : string
, dVred        : double
)
with index
(
  RT0 = cPodr + sPost + FIO
);
//******************************************************************************
// Временная таблица с итогами по каждому уровню
//******************************************************************************
Table Struct RezultTable
(
  LevelIer: word, // глубина записи
  sDepart: string,
  dQuant: double, // кол-во ставок
  dOklad: double,  // тарифная ставка\оклад
  dTar1: double, // сумма доплаты в колонку тарифов
  dTar2: double, // сумма доплаты в колонку тарифов
  dTar3: double, // сумма доплаты в колонку тарифов
  dTar4: double, // сумма доплаты в колонку тарифов
  dTar5: double, // сумма доплаты в колонку тарифов
  dRaise1: double, // сумма доплаты в колонку Надбавок
  dRaise2: double, // сумма доплаты в колонку Надбавок
  dRaise3: double, // сумма доплаты в колонку Надбавок
  dRaise4: double, // сумма доплаты в колонку Надбавок
  dRaise5: double, // сумма доплаты в колонку Надбавок
  Itogo: double // Итого
)
with index
(
  RezultTable0 = LevelIer(Unique)
);
  var
  //-----------
    cIer: word;          // группировка
    cFullNameIer: word;          // полное имя с учетом иерархии
    SortPodr: word;
    Level: word; // глубина иерархии
    nameRaise, nameTarif: string; // заголовки для колонок
//----------- Поля надбавок, доплат
    nameRaise1: string;
    nameRaise2: string;
    nameRaise3: string;
    nameRaise4: string;
    nameRaise5: string;
//----------- Поля повышения тарифного оклада
    nameTar1: string;
    nameTar2: string;
    nameTar3: string;
    nameTar4: string;
    nameTar5: string;
//----маркеры странных доплат---------------------------------------------------
    DS1, DS2, DDDopl: TPtr;
    Summa1, Summa2: double; // суммы, от коих рассчитывается процент
//---  Остальное
    BaseSize: double; // размер базовой величины
    TarifStavka: double; // тарифная ставка первого разряда
    DeptMarker_T3: TPtr; // маркер подразделений
    LongNamePoPo: word; // длинное наименование для должностей и подразделений
    _SearchMarker: TPtr;
    ExcelName: string; // имя выходного файла отчет
    numCol: byte; // кол-во столбцов отчета
    numPostColumn: byte; // стоблец, в коем должностной оклад
// --- Вспомогательные переменные длы вывода
    TdQuant, TdTotal, TdTotalOklad : double;
    TdBonus1, TdBonus2, TdBonus3, TdBonus4, TdBonus5: double;
    TdRR1, TdRR2, TdRR3, TdRR4, TdRR5: double;
    TdBonusOklad1, TdBonusOklad2, TdBonusOklad3, TdBonusOklad4, TdBonusOklad5: double;
    TdRROklad1, TdRROklad2, TdRROklad3, TdRROklad4, TdRROklad5: double;
    PrevHier: word; // уровень иерархии предыдущей записи
// ---- закладка "подписывающие"
    FIO_Liza, Post_Liza, FIO_First, Post_First, FIO_Second, Post_Second, FIO_Third, Post_Third: string; // фио и должности подписывающих отчет
//-------признак вывода в отчет
    YesTar1, YesTar2, YesTar3, YesTar4, YesTar5: word; // тарифные
    YesRaise1, YesRaise2, YesRaise3, YesRaise4, YesRaise5: word; // надбавочные

  sPodpis1
, sPodpis2
, sSogls
, sSogls2
, sUtve
, sOtv
, sPodpis1Dol
, sPodpis2Dol
, sSoglsDol
, sSogls2Dol
, sUtveDol
, sOtvDol
, sPodpis1Npp
, sPodpis2Npp        : string;

  ddKolWorkers       : double;

  ID
, sXLSFileName
, SXLTFileName       : string;

  pxlrepsetup        : xlrepsetup;
  pXL                : XlsRepBuilder;
//------- Маркеры
  NBB_MarkersT1, NBB_MarkersT2, NBB_MarkersT3, NBB_MarkersT4, NBB_MarkersT5
 ,NBB_MarkersR1, NBB_MarkersR2, NBB_MarkersR3, NBB_MarkersR4, NBB_MarkersR5
    : tPtr;
//******************************************************************************
// Логическая таблица
//******************************************************************************
Create view NBB_SHR
var
  dateSts  : date;          // Дата штатного расписания
  wUserName: string;
  pMyOrg   : comp;
As  Select
  11
    (FieldName = wType)
, 'Em_Report_' + string(wType)
    (FieldName = nameNastr)
, StaffStruct.Nrec
From
  KlKatego
, StaffStruct
, SHierarchyTable
, Persons
, Appointments
, CatPodrDeptIer
, CatPodrDeptIer CatPodrDeptIerNaim
, Raise
, TarStav
, RezultTable
, AppHist
, Catalogs AppKatPodr
, Catalogs AppKatPodr2
, Catalogs AppKatPost
, Catalogs AppKatPost2
, Catalogs AppDopAttrCat
, KlKatego KlKatego2
, KlKatego KlKatego22
, KatOrg
, SPKAU
, KlSisOpl    SSPayModelCat
//, Raise Raise2
//, RaiseHist
//, Catalogs Catalogs2
, GP_TarStavExt
, RaiseSts
, RaiseAlg
//, Catalogs RaiseCat
where 
((  
    wUserName                 == StafUser.StUser 
// ограничения для подтягивания нужных ставок
AND CatPodrDeptIer.cPodr     == StaffStruct.Department
AND StaffStruct.EmpCategory  == KlKatego.Nrec

AND dateSts                 >>= StaffStruct.dInput        
// дополнительные условия отбора ставок
and (dateSts <= StaffStruct.dClose or
                0 = Day(StaffStruct.dClose))

AND StaffStruct.PayModel     == SSPayModelCat.SisOpl
// люди на ставках
AND StaffStruct.NRec         == Appointments.StaffStr
and StaffStruct.NRec == RaiseStS.StaffStr
AND (dateSts >= RaiseStS.dat1 and
                ( 0 = Day(RaiseStS.dat2) or
                  dateSts <= RaiseStS.dat2)
    )
AND RaiseSts.NRec == RaiseAlg.RaiseStSt
and StaffStruct.Tariff == TarStav.Nrec
and TarStav.NRec == GP_TarStavExt.cTarStav
AND Appointments.Person /== Persons.NRec
//AND Appointments.Person      == Persons.NRec

AND Appointments.NRec        == AppHist.cAppoint // для получения сумм доплат
// только для подтяжки нужного подразделения
AND SHierarchyTable.cPodr    == CatPodrDeptIerNaim.cPodr

AND Appointments.Department  == AppKatPodr.NRec
AND Appointments.Post        == AppKatPost.NRec

AND StaffStruct.Department   == AppKatPodr2.NRec
AND StaffStruct.Post         == AppKatPost2.NRec

AND AppKatPost.cRef2         == KlKatego2.NRec
AND AppKatPost2.cRef2        == KlKatego22.NRec

AND Appointments.cRef3       == AppDopAttrCat.Nrec

AND pMyOrg       == KatOrg.NRec


))

bounds Ord1   as  SHierarchyTable.cPodr == RT.cPodr

order CatPodrCode1 by CatPodrDeptIer.Code
order SHierarchyTableCode       by SHierarchyTable.Code
order SHierarchyTableSortKey    by SHierarchyTable.sortKey;
//******************************************************************************
// объявление и инициализация TOA
//******************************************************************************
#include TotalOrganizationAttributes.var

//******************************************************************************
// Процедура создания нужного кол-ва записей уровней иерархии
//******************************************************************************
Procedure FillLevelTable;
{
  var i: word;     // нулевой уровень: итог всего предприятия
  for (i := 0; i <= Level; inc(i))
  {
    ClearBuffer(#RezultTable);
    RezultTable.LevelIer := i;
    Insert Current RezultTable;
  }
}
//******************************************************************************
// Процедура подгрузки из деска настроек отчета
//******************************************************************************
Procedure LoadVariables;
{
  // переменные закладки "Доплаты"
  if (ReadMyDsk(nameRaise1  , 'NBB_StaffStSnameRaise1'  , false)) {}
  if (ReadMyDsk(nameRaise2  , 'NBB_StaffStSnameRaise2'  , false)) {}
  if (ReadMyDsk(nameRaise3  , 'NBB_StaffStSnameRaise3'  , false)) {}
  if (ReadMyDsk(nameRaise4  , 'NBB_StaffStSnameRaise4'  , false)) {}
  if (ReadMyDsk(nameRaise5  , 'NBB_StaffStSnameRaise5'  , false)) {}
  if (ReadMyDsk(YesRaise1   , 'NBB_YesRaise1'           , false)) {}
  if (ReadMyDsk(YesRaise2   , 'NBB_YesRaise2'           , false)) {}
  if (ReadMyDsk(YesRaise3   , 'NBB_YesRaise3'           , false)) {}
  if (ReadMyDsk(YesRaise4   , 'NBB_YesRaise4'           , false)) {}
  if (ReadMyDsk(YesRaise5   , 'NBB_YesRaise5'           , false)) {}
  // переменные закладки "Повышение тарифного коэффициента"
  if (ReadMyDsk(nameTar1    , 'NBB_StaffStSnameTar1'    , false)) {}
  if (ReadMyDsk(nameTar2    , 'NBB_StaffStSnameTar2'    , false)) {}
  if (ReadMyDsk(nameTar3    , 'NBB_StaffStSnameTar3'    , false)) {}
  if (ReadMyDsk(nameTar4    , 'NBB_StaffStSnameTar4'    , false)) {}
  if (ReadMyDsk(nameTar5    , 'NBB_StaffStSnameTar5'    , false)) {}
  if (ReadMyDsk(YesTar1     , 'NBB_YesTar1'             , false)) {}
  if (ReadMyDsk(YesTar2     , 'NBB_YesTar2'             , false)) {}
  if (ReadMyDsk(YesTar3     , 'NBB_YesTar3'             , false)) {}
  if (ReadMyDsk(YesTar4     , 'NBB_YesTar4'             , false)) {}
  if (ReadMyDsk(YesTar5     , 'NBB_YesTar5'             , false)) {}
  // Переменные закладки "подписывающих"
  if (ReadMyDsk(FIO_Liza    , 'NBB_FIO_Liza'            , false)) {}
  if (ReadMyDsk(Post_Liza   , 'NBB_Post_Liza'           , false)) {}

  if (ReadMyDsk(FIO_First   , 'NBB_FIO_First'           , false)) {}
  if (ReadMyDsk(FIO_Second  , 'NBB_FIO_Second'          , false)) {}
  if (ReadMyDsk(FIO_Third   , 'NBB_FIO_Third'           , false)) {}
  if (ReadMyDsk(Post_First  , 'NBB_Post_First'          , false)) {}
  if (ReadMyDsk(Post_Second , 'NBB_Post_Second'         , false)) {}
  if (ReadMyDsk(Post_Third  , 'NBB_Post_Third'          , false)) {}
  // Особенные % доплаты
  if (ReadMyDsk(Summa1      , 'NBB_Summa1'              , false)) {}
  if (ReadMyDsk(Summa2      , 'NBB_Summa2'              , false)) {}
  // остальные переменные
  if (ReadMyDsk(dateSts     , 'NBB_StaffStSdateSts'     , false)) {}
  if (ReadMyDsk(cIer        , 'NBB_StaffStScIer'        , false)) {}
  if (ReadMyDsk(cFullNameIer, 'NBB_StaffStScFullNameIer', false)) {}
  if (ReadMyDsk(LongNamePoPo, 'NBB_LongNamePoPo'        , false)) {}

  if (not ReadMyDsk(TarifStavka, 'NBB_TarifStavka'      , false))
    TarifStavka := 0;

  if (not ReadMyDsk(BaseSize   , 'NBB_BaseSize'         , false))
    BaseSize := 0;

  if (not ReadMyDsk(level      , 'NBB_StaffStS_level'   , false))
    level := 0;

  if (not ReadMyDsk(SortPodr   , 'NBB_StaffStS_SortPodr', false))
    SortPodr := 0;

  if (not ReadMyDsk(nameRaise  , 'NBB_StaffStSnameRaise', false))
    nameRaise := 'Надбавки, доплаты';

  if (not ReadMyDsk(nameTarif  , 'NBB_StaffStSnameTarif', false))
    nameTarif := 'Повышение тарифного оклада';

  if (NOT ReadMyDsk(sSogls     , nameNastr + '_sSogls', true))
    sSogls := '';

  if (NOT ReadMyDsk(sSoglsDol  , nameNastr + '_sSoglsDol', true))
    sSoglsDol := '';

  if (NOT ReadMyDsk(sSogls2    , nameNastr + '_sSogls2', true))
    sSogls2 := '';

  if (NOT ReadMyDsk(sSogls2Dol , nameNastr + '_sSogls2Dol', true))
    sSogls2Dol := '';

  if (NOT ReadMyDsk(sUtve      , nameNastr + '_sUtve', true))
    sUtve := '';

  if (NOT ReadMyDsk(sUtveDol   , nameNastr + '_sUtveDol', true))
    sUtveDol := '';

  if (NOT ReadMyDsk(sPodpis2   , nameNastr + '_sPodpis2', true))
    sPodpis2 := '';

  if (NOT ReadMyDsk(sPodpis2Dol, nameNastr + '_sPodpis2Dol', true))
    sPodpis2Dol := '';

  if (NOT ReadMyDsk(sPodpis2Npp, nameNastr + '_sPodpis2Npp', true))
    sPodpis2Npp := '';

  if (NOT ReadMyDsk(sPodpis1   , nameNastr + '_sPodpis1', true))
    sPodpis1 := '';

  if (NOT ReadMyDsk(sPodpis1Dol, nameNastr + '_sPodpis1Dol', true))
    sPodpis1Dol := '';

  if (NOT ReadMyDsk(sOtv       , nameNastr + '_sOtv', true))
    sOtv := '';

  if (NOT ReadMyDsk(sOtvDol    , nameNastr + '_sOtvDol', true))
    sOtvDol := '';

  if (NOT ReadMyDsk(sPodpis1Npp, nameNastr + '_sPodpis1Npp', true))
    sPodpis1Npp := '';

  ID := 'Shr_Vac';
  if (NOT ReadMyDsk(sXLTFileName,ID,true))
    set sXLTFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ID + '.xlt';
}
//******************************************************************************
// Функция находит суммарный размер доплат маркера, причитающихся данной ставке
//******************************************************************************
function CountSumRaise(markerHandle: TPtr; wSP: byte; Post: boolean): double;
// wSP - 0   для получения суммы по доплате
// wSP - 1   для получения процента по доплате
// Post - true уже можно посчитать величину должностного оклада
// Post - false нельзя посчитать величину должностного оклада
  var countMark: longInt;
      i: longInt;
      Item: Comp;
{
  CountSumRaise := 0;
  countMark := GetMarkerCount(markerHandle);
  for (i := 0; i < countMark; i := i + 1)
  {
    if GetMarker(markerHandle, i, Item)
      if (GetFirst FastFirstRow Raise  where ((
                Appointments.NRec == Raise.Appoint and
                Item == Raise.RaiseType(noIndex)
                )) = tsOK)
      {
        case wSP of
          0:
          {
            // к сожалению появились еще случаи, когда сумма доплаты должна
            // рассчитываться от отдельных сумм, введенных в настройках.
            // Надо проверять :(
            if FoundMarker(DS1, Item) // от первой суммы
            {
              CountSumRaise := CountSumRaise + Summa1 / 100 * iRaise.GetPercentRaise(
                                                                      Raise.NRec,
                                                                      dateSts
                                                                      );
            }
            else
              if FoundMarker(DS1, Item) // от первой суммы
              {
                CountSumRaise := CountSumRaise + Summa2 / 100 * iRaise.GetPercentRaise(
                                                                        Raise.NRec,
                                                                        dateSts
                                                                        );
              }
              else
                if (Post) and (FoundMarker(DDDopl, Item)) // от должностного оклада
                {
                  CountSumRaise := CountSumRaise + (RT.dOklad + RT.dTar1 + RT.dTar2
                                + RT.dTar3 + RT.dTar4 + RT.dTar5)
                                / 100 * iRaise.GetPercentRaise(
                                                              Raise.NRec,
                                                              dateSts
                                                              );
                }
                else
                  if GetLast AppHist = tsOk
                    CountSumRaise := CountSumRaise + iRaise.GetSumRaise(
                                                                        Raise.NRec,
                                                                        dateSts,
                                                                        coAppHist,
                                                                        AppHist.Nrec
                                                                        );
          }
          1:  CountSumRaise := CountSumRaise + iRaise.GetPercentRaise(
                                                                      Raise.NRec,
                                                                      dateSts
                                                                      );
        end; //case
      }
  }
} //function CountSumRaise(markerHandle: TPtr; wSP: byte; Post: boolean): double;

//*****************************************************************************
procedure InsPos(bApp:boolean);
{
  Timelog('NBB_Vacancy->InsPos 001');
  if (bApp)
    { 
      // обходим сотрудников вне шр
      if Appointments.wAddWord1 = 2
        exit;
      // только для основного назначения и совместителей
      if not ( 0 = Appointments.Lprizn or 3 = Appointments.Lprizn)
        exit;
      // сотрудников в долгосрочных отпусках обходим
      if iStaffStr.GetLongVacationByDate(Appointments.NRec, dateSts) <> 0
        exit;
      // проверим по дате
      if Appointments.AppointDate > dateSts
        exit;
       
      if (Appointments.DismissDate > date(0,0,0) and
          Appointments.DismissDate < dateSts)
        exit;
    }
  Timelog('NBB_Vacancy->InsPos 002');

  ClearBuffer(#RT);
  var stemp : string;
  RT.CPODR     := if(level = 0, 0, if (bApp, Appointments.Department, StaffStruct.Department));
  RT.sPodrName := if(level = 0, 0, if (bApp, AppKatPodr.Name, AppKatPodr2.Name));
  RT.sPodrCode := if(level = 0, 0, if (bApp, AppKatPodr.Code, AppKatPodr2.Code));
  RT.FIO       := if(bApp, Persons.FIO, '');

  InsertMarker(_SearchMarker, if (bApp, Appointments.Department, StaffStruct.Department));
  // должность
  if LongNamePoPo = 1 // длинное наименование должности
    stemp := iCatFunc.GetCatalogsLongName(if (bApp, Appointments.Post, StaffStruct.Post));
  else
    stemp := iCatFunc.GetCatalogsName(if (bApp, Appointments.Post, StaffStruct.Post));

  RT.SPOST     := stemp;
  // разряд по окладу
  if (StaffStruct.Category <> 0)
    RT.Razriad := if (bApp, Appointments.Category, StaffStruct.Category);
  // количество занимаемых ставок
  RT.dQuant    := if (bApp, Appointments.Rate, StaffStruct.WorkStations);
  // оклад
  RT.dOklad    := if (bApp AND Appointments.TaxRate <> 0, Appointments.TaxRate, StaffStruct.TaxRate);
  RT.MinOklad  := StaffStruct.MinSumma;
  RT.MaxOklad  := StaffStruct.MaxSumma;
  // корректирующий коэффициент
  RT.CorrKoeff := if(bApp,double(Appointments.LastUser),0);

  if (GetFirst KlKatego2 = tsOk)
    {
      RT.KatPersCode := KlKatego2.Kod;
      RT.KatPersName := KlKatego2.NaiKat;
    } 
  else   
    if (GetFirst KlKatego22 = tsOk)
      {
        RT.KatPersCode := KlKatego22.Kod;
        RT.KatPersName := KlKatego22.NaiKat;
      }

  if (GetFirst SSPayModelCat = tsOk)
    {
      RT.SysOpl   := if(SSPayModelCat.sisopl < 30, 'сдельно', 'повременная');
      RT.VidStav  := if (SSPayModelCat.NaSisOpl = 'Оклад' AND RT.KatPersCode < 5, 'Месячная тарифная ставка (МТС)', 
                       if (SSPayModelCat.NaSisOpl = 'Сдельная', 'Часовая тарифная ставка (ЧТС)', SSPayModelCat.NaSisOpl));
    }

  RT.dVred := 0;
  //_LOOP Catalogs2 where Catalogs2.Name like 'Доплата за вредность%'
  Timelog('NBB_Vacancy->InsPos 003');
    if (RT.dVred = 0)
    _LOOP RaiseStS
    /*
     where ((StaffStruct.NRec == RaiseStS.StaffStr
                       AND (dateSts >= RaiseStS.dat1 and
                                 ( 0 = Day(RaiseStS.dat2) or
                                   dateSts <= RaiseStS.dat2))))
                                   */
      //if (GetFirst RaiseCat where ((RaiseStS.RaiseType == RaiseCat.Nrec)) = tsOk)
        if (GetFirst RaiseAlg /*where ((RaiseSts.NRec == RaiseAlg.RaiseStSt))*/ = tsOk) 
          if (RaiseAlg.RaiseAttr = 2)   
            if (RT.dVred = 0)
              {
                RT.dVred := RaiseAlg.Sum / 100;
                break; 
              }
    


  /*
      if (IsValid(#Appointments))
        {
          _LOOP Raise2 where ((Appointments.Person      == Raise2.Person
                           AND Appointments.NRec        == Raise2.Appoint
                           //AND Catalogs2.NRec           == Raise2.RaiseType
                           AND (dateSts >= Raise2.FromDate and
                               ( 0 = Day(Raise2.ToDate) or
                                 dateSts <= Raise2.ToDate))))  
            if (RT.dVred = 0)
              _LOOP RaiseHist where ((Raise2.NRec == RaiseHist.cRaise
                                  AND 0           == RaiseHist.wStatus(NoIndex)))                
                {
                  RT.dVred := RaiseHist.rHSum / 100;
                  break; 
                }
        }
      else
        {
          _LOOP Raise2 where ((Appointments.NRec        == Raise2.Appoint 
                           //AND Catalogs2.NRec           == Raise2.RaiseType (NoIndex)
                           AND (dateSts >= Raise2.FromDate and
                               ( 0 = Day(Raise2.ToDate) or
                                 dateSts <= Raise2.ToDate))))  
            if (RT.dVred = 0)
              _LOOP RaiseHist where ((Raise2.NRec == RaiseHist.cRaise
                                  AND 0           == RaiseHist.wStatus(NoIndex)))                
                {
                  RT.dVred := RaiseHist.rHSum / 100;
                  break; 
                }
        } 
  */

  var cDopKat : comp; cDopKat := coGetAttr(coCatalogs, if (IsValid(#Appointments), Appointments.Department, StaffStruct.Department) , 'Вид производства');
  if (GetFirst SpKau where ((cDopKat == SpKau.NRec)) = tsOk)
    RT.VidPr := SpKau.Code;

  if (GetFirst AppDopAttrCat = tsOk)
    RT.DopKat := AppDopAttrCat.Code;

  Timelog('NBB_Vacancy->InsPos 004');
  if (GetFirst FastFirstRow TarStav /*where ((StaffStruct.Tariff == TarStav.Nrec))*/ = tsOk)
    {
      //RT.SysOpl     := TarStav.NaiTar; - замечание от 13.09 - не в той колонке
      RT.LevelOpl   := TarStav.NaiTar;
      RT.TarifKoeff := TarStav.KolMin;
      //замечание от 13.09 - не в той колонке - уберем вообще
      //if (GetFirst GP_TarStavExt where ((TarStav.NRec == GP_TarStavExt.cTarStav)) = tsOk)
      //  RT.LevelOpl := GP_TarStavExt.NameT3;
    }
  // подсчет сумм по доплатам в соответствующем маркере
  // тарифные доплаты
  Timelog('NBB_Vacancy->InsPos 005');
  if (YesTar1 = 1)
  {
    RT.dTar1     := CountSumRaise(NBB_MarkersT1, 0, false);
    RT.dTarPerc1 := CountSumRaise(NBB_MarkersT1, 1, false);
  }

  if (YesTar2 = 1)
  {
    RT.dTar2     := CountSumRaise(NBB_MarkersT2, 0, false);
    RT.dTarPerc2 := CountSumRaise(NBB_MarkersT2, 1, false);
  }

  if (YesTar3 = 1)
  {
    RT.dTar3     := CountSumRaise(NBB_MarkersT3, 0, false);
    RT.dTarPerc3 := CountSumRaise(NBB_MarkersT3, 1, false);
  }

  if (YesTar4 = 1)
  {
    RT.dTar4     := CountSumRaise(NBB_MarkersT4, 0, false);
    RT.dTarPerc4 := CountSumRaise(NBB_MarkersT4, 1, false);
  }

  if (YesTar5 = 1)
  {
    RT.dTar5     := CountSumRaise(NBB_MarkersT5, 0, false);
    RT.dTarPerc5 := CountSumRaise(NBB_MarkersT5, 1, false);
  }
  // надбавки
  if (YesRaise1 = 1)
  {
    RT.dRaise1     := CountSumRaise(NBB_MarkersR1, 0, true);
    RT.dRaisePerc1 := CountSumRaise(NBB_MarkersR1, 1, false);
  }

  if (YesRaise2 = 1)
  {
    RT.dRaise2     := CountSumRaise(NBB_MarkersR2, 0, true);
    RT.dRaisePerc2 := CountSumRaise(NBB_MarkersR2, 1, false);
  }

  if (YesRaise3 = 1)
  {
    RT.dRaise3     := CountSumRaise(NBB_MarkersR3, 0, true);
    RT.dRaisePerc3 := CountSumRaise(NBB_MarkersR3, 1, false);
  }

  if (YesRaise4 = 1)
  {
    RT.dRaise4     := CountSumRaise(NBB_MarkersR4, 0, true);
    RT.dRaisePerc4 := CountSumRaise(NBB_MarkersR4, 1, false);
  }

  if (YesRaise5 = 1)
  {
    RT.dRaise5     := CountSumRaise(NBB_MarkersR5, 0, true);
    RT.dRaisePerc5 := CountSumRaise(NBB_MarkersR5, 1, false);
  }

  insert current RT;
  Timelog('NBB_Vacancy->InsPos 005');

} //procedure InsPos(bApp:boolean);


//===============================================
// Вставить одну запись
//===============================================
Function PickTmpTableWithNeedInfoOne:boolean;
{ Result:=False;

    _loop fullcache StaffStruct
    { NextViSual;
      ddKolWorkers += iStaffStr.GetRateOnDate(StaffStruct.NRec, dateSts);
      var str : string; str := iCatFunc.GetCatalogsName(StaffStruct.Post);

      // пойдем искать подходящие записи о назначениях
      //if (GetFirst Appointments = tsOk)
      if (RecordExists Appointments = tsOk)
        {
          _loop fullcache Appointments
          {
            InsPos(true);
          }
        }
      else
        InsPos(false);
    }

  Result:=true;
}//Function PickTmpTableWithNeedInfoOne:boolean;

//******************************************************************************
// Набить временную таблицу информацией на основании настроек отчета
//******************************************************************************
Function PickTmpTableWithNeedInfo:boolean;
{ Result:=false;
  TimeLog('PickTmpTableWithNeedInfo Start');
  var DeptCount: longint;
  // кол-во записей в маркере подразделений
  DeptCount := GetMarkerCount(DeptMarker_T3);
  if DeptCount>0
  { StoreMarker(DeptMarker_T3,'DepartIer_FltMarker')
  }
  // Создаем таблицу CatPodrDeptIer с иерархией
  iDepartIer.CreateDeptIerTabl(dateSts, cIer);
  //PushConditionForLeave(tcOnStaffStruct, tnStaffStruct);
  SetOrder (tiCatPodrCode1);
  ddKolWorkers := 0;
 //------------------------------------------------------------------------------
  if (DeptCount > 0)
  { var ii:longint;
    var _pNrec:comp=0;
    TimeLog('PickTmpTableWithNeedInfo DeptCount > 0');
    For(ii:=0;ii<DeptCount;ii++)
    { if not NextViSual exit;
      GetMarker(DeptMarker_T3,ii,_pNrec);
      if getfirst CatPodrDeptIer where (( _pNrec == CatPodrDeptIer.cPodr ))<>tsok continue;
      if (vUserAcs.Accessibility(CatPodrDeptIer.cPodr, 0) <> 1)
        continue;
      PickTmpTableWithNeedInfoOne;
    }//For(ii:=0;ii<DeptCount;ii++)

  } //if (DeptCount > 0)
  else
  { TimeLog('PickTmpTableWithNeedInfo DeptCount = 0');
    _loop fullcache CatPodrDeptIer
    {  if not NextViSual exit;
      //------------------------------------------------------------------------------
      //Разграничение доступа
      //Нет доступа к подразделению
      if (vUserAcs.Accessibility(CatPodrDeptIer.cPodr, 0) <> 1)
        continue;
      PickTmpTableWithNeedInfoOne;
    } // end _loop CatPodrDeptIer
  }
  Result:=true;
  //PopConditionForLeave(tcOnStaffStruct, tnStaffStruct);
  TimeLog('PickTmpTableWithNeedInfo Finish')
}
//******************************************************************************
// Возвращает наименование соответствующей колонки
//******************************************************************************
Function GetNameColumn(b: byte): string;
{
  case b of
    1:  GetNameColumn := nameTar1;
    2:  GetNameColumn := nameTar2;
    3:  GetNameColumn := nameTar3;
    4:  GetNameColumn := nameTar4;
    5:  GetNameColumn := nameTar5;
    11: GetNameColumn := nameRaise1;
    12: GetNameColumn := nameRaise2;
    13: GetNameColumn := nameRaise3;
    14: GetNameColumn := nameRaise4;
    15: GetNameColumn := nameRaise5;
    else
      GetNameColumn := '';
  end; //case
}
//******************************************************************************
// Возвращает
//******************************************************************************
Function GetBird(b: byte): boolean;
{
  case b of
    1:  GetBird := if(YesTar1   = 1, true, false);
    2:  GetBird := if(YesTar2   = 1, true, false);
    3:  GetBird := if(YesTar3   = 1, true, false);
    4:  GetBird := if(YesTar4   = 1, true, false);
    5:  GetBird := if(YesTar5   = 1, true, false);
    11: GetBird := if(YesRaise1 = 1, true, false);
    12: GetBird := if(YesRaise2 = 1, true, false);
    13: GetBird := if(YesRaise3 = 1, true, false);
    14: GetBird := if(YesRaise4 = 1, true, false);
    15: GetBird := if(YesRaise5 = 1, true, false);
    else
      GetBird := false;
  end; //case
}
//*****************************************************************************
Function PreparePrint: boolean;
{
  PreparePrint := true;

  //Set sXLSFileName := pXL.CreateXLT(sXLTFileName, True);
  Set sXLSFileName := pXL.CreateReport(sXLTFileName, True);

  if not pxlrepsetup.checkParam(0, ID, sXLTFileName)
   {
     Runinterface('XlRepSetup', 1, ID, sXLTFileName);
     ReadMyDsk(sXLTFileName, ID, true);
   }

  pXL.CreateVar(sXLSFileName);
  pXL.SetStringVar('CFH'           , CommonFormHeader);

  //pXL.SetStringVar('org'           , oHistory.sGetField(coKatOrg, coGetTune('MyOrg'), 'REP.KATORGNAME', dateSts));
  if (GetFirst KatOrg = tsOk)
    {
      pXL.SetStringVar('org'       , KatOrg.Name);
      pXL.SetStringVar('OKPO'      , '''' + KatOrg.Okpo);
    }

  if (dateSts <> ZeroDate)
    pXL.SetStringVar('Date'        , '''' + DateToStr(dateSts, 'DD.MM.YYYY'));
  if (dateSts <> ZeroDate)
    pXL.SetStringVar('Osn'         , '''' + DateToStr(dateSts, 'DD.MM.YYYY'));

  pXL.SetStringVar('SoglFIO'       , sSogls);
  pXL.SetStringVar('SoglDol'       , sSoglsDol);
  pXL.SetStringVar('Sogl2FIO'      , sSogls2);
  pXL.SetStringVar('Sogl2Dol'      , sSogls2Dol);
  pXL.SetStringVar('UtvrFIO'       , sUtve);
  pXL.SetStringVar('UtvrDol'       , sUtveDol);
  pXL.SetStringVar('OtvFIO'        , sOtv);
  pXL.SetStringVar('OtvDol'        , sOtvDol);
  pXL.SetStringVar('sPodpis1FIO'   , sPodpis1);
  pXL.SetStringVar('sPodpis1Dol'   , sPodpis1Dol);
  pXL.SetStringVar('sPodpis2FIO'   , sPodpis2);
  pXL.SetStringVar('sPodpis2Dol'   , sPodpis2Dol);

  pXL.SetStringVar('ColPovTarifOklad' , nameTarif);
  pXL.SetStringVar('ColPov1TarifOklad', GetNameColumn(1));
  pXL.SetStringVar('ColPov2TarifOklad', GetNameColumn(2));
  pXL.SetStringVar('ColPov3TarifOklad', GetNameColumn(3));
  pXL.SetStringVar('ColPov4TarifOklad', GetNameColumn(4));
  pXL.SetStringVar('ColPov5TarifOklad', GetNameColumn(5));

  pXL.SetStringVar('ColNad' , nameRaise);
  pXL.SetStringVar('Col1Nad', GetNameColumn(11));
  pXL.SetStringVar('Col2Nad', GetNameColumn(12));
  pXL.SetStringVar('Col3Nad', GetNameColumn(13));
  pXL.SetStringVar('Col4Nad', GetNameColumn(14));
  pXL.SetStringVar('Col5Nad', GetNameColumn(15));

  pXL.SetNumberVar('kolPers', ddKolWorkers);

  pXL.PublishVar;  // Excel
 
  pXL.CreateTbls(sXLSFileName);

  pXL.CreateTbl('Table');
  pXL.CreateTblFld('Level'      );
  pXL.CreateTblFld('PodrName'   );
  pXL.CreateTblFld('PodrNRec'   );
  pXL.CreateTblFld('PodrCode'   );
  pXL.CreateTblFld('Post'       );
  pXL.CreateTblFld('FIO'        );
  pXL.CreateTblFld('Oklad'      );
  pXL.CreateTblFld('Razriad'    );
  pXL.CreateTblFld('KatPersCode');
  pXL.CreateTblFld('KatPersName');
  pXL.CreateTblFld('DopKat'     );
  pXL.CreateTblFld('VidPr'      );

  pXL.CreateTblFld('LevelOpl'   );
  pXL.CreateTblFld('SysOpl'     );
  pXL.CreateTblFld('KolEd'      );
  pXL.CreateTblFld('VidStav'    );
  
  pXL.CreateTblFld('MinOklad'   );
  pXL.CreateTblFld('MaxOklad'   );

  pXL.CreateTblFld('ColPov1TarifOkladVal');
  pXL.CreateTblFld('ColPov2TarifOkladVal');
  pXL.CreateTblFld('ColPov3TarifOkladVal');
  pXL.CreateTblFld('ColPov4TarifOkladVal');
  pXL.CreateTblFld('ColPov5TarifOkladVal');
  pXL.CreateTblFld('ColPov1TarifOkladPer');
  pXL.CreateTblFld('ColPov2TarifOkladPer');
  pXL.CreateTblFld('ColPov3TarifOkladPer');
  pXL.CreateTblFld('ColPov4TarifOkladPer');
  pXL.CreateTblFld('ColPov5TarifOkladPer');

  pXL.CreateTblFld('Col1NadVal');
  pXL.CreateTblFld('Col2NadVal');
  pXL.CreateTblFld('Col3NadVal');
  pXL.CreateTblFld('Col4NadVal');
  pXL.CreateTblFld('Col5NadVal');
  pXL.CreateTblFld('Col1NadPer');
  pXL.CreateTblFld('Col2NadPer');
  pXL.CreateTblFld('Col3NadPer');
  pXL.CreateTblFld('Col4NadPer');
  pXL.CreateTblFld('Col5NadPer');

  pXL.CreateTblFld('dVred');
  
  pXL.CreateTblFld('Note');

}
//******************************************************************************
// Вывод строки ИТОГО для одного подразделения
//******************************************************************************
Procedure ItogoOutPut(a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14: double);
{
  if (a1 <> 0)
    pXL.SetTblNumberFldValue('KolEd'   , a1);

  if (a2 <> 0)
    pXL.SetTblNumberFldValue('Oklad'   , a2);
  
  if (a13 <> 0)
    pXL.SetTblNumberFldValue('MinOklad', a13);
  
  if (a14 <> 0)
    pXL.SetTblNumberFldValue('MaxOklad', a14);


  
  if (a2 <> a3)
    pXL.SetTblNumberFldValue('ColPov1TarifOkladVal', a3);
  
  if (a4 <> 0)
    pXL.SetTblNumberFldValue('ColPov2TarifOkladVal', a4);
  
  if (a5 <> 0)
    pXL.SetTblNumberFldValue('ColPov3TarifOkladVal', a5);
  
  if (a6 <> 0)
    pXL.SetTblNumberFldValue('ColPov4TarifOkladVal', a6);
  
  if (a7 <> 0)
    pXL.SetTblNumberFldValue('ColPov5TarifOkladVal', a7);

  
  if (a8 <> 0)
    pXL.SetTblNumberFldValue('Col1NadVal', a8);
  
  if (a9 <> 0)
    pXL.SetTblNumberFldValue('Col2NadVal', a9);
  
  if (a10 <> 0)
    pXL.SetTblNumberFldValue('Col3NadVal', a10);
  
  if (a11 <> 0)
    pXL.SetTblNumberFldValue('Col4NadVal', a11);
  
  if (a12 <> 0)
    pXL.SetTblNumberFldValue('Col5NadVal', a12);
}
//******************************************************************************
// Вывод Итого по уровню
//******************************************************************************
Procedure LevelItogo(dive: word);
{
  var wFlag: boolean=false;
  if GetLast RezultTable where ((PrevHier >> RezultTable.LevelIer)) = tsOk
    wFlag := true
  else
    wFlag := false;

  while wFlag
  {
    pXL.ClearTblBuffer;
    pXL.SetTblNumberFldValue('Level', 1);
    pXL.SetTblStringFldValue('PodrName'  , 'Итого по  ' +  Trim(RezultTable.sDepart) + ':');
    ItogoOutPut(RezultTable.dQuant, RezultTable.dOklad, RezultTable.DTar1,
                RezultTable.DTar2, RezultTable.DTar3, RezultTable.DTar4,
                RezultTable.DTar5, RezultTable.DRaise1, RezultTable.DRaise2,
                RezultTable.DRaise3, RezultTable.DRaise4, RezultTable.DRaise5, 0, 0);
    pXL.InsTblRow;

    // а теперь почистить итоги этого уровня
    Update Current RezultTable
                                set RezultTable.dQuant := 0,
                                    RezultTable.dOklad := 0,
                                    RezultTable.DTar1 := 0,
                                    RezultTable.DTar2 := 0,
                                    RezultTable.DTar3 := 0,
                                    RezultTable.DTar4 := 0,
                                    RezultTable.DTar5 := 0,
                                    RezultTable.DRaise1 := 0,
                                    RezultTable.DRaise2 := 0,
                                    RezultTable.DRaise3 := 0,
                                    RezultTable.DRaise4 := 0,
                                    RezultTable.DRaise5 := 0;
                                    RezultTable.Itogo := 0;

    wFlag := false;
    if GetPrev RezultTable where ((PrevHier >> RezultTable.LevelIer)) = tsOk
      if RezultTable.LevelIer >= dive
        wFlag := true;
  }//while wFlag
}
//******************************************************************************
//  Печать итогов и подножия типа подписи
//******************************************************************************
Procedure PrintBottom;
{
  var p: word;
  for (p := PrevHier - 1; p >= 1; dec(p))
  {
    if GetFirst FastFirstRow RezultTable where ((p == RezultTable.LevelIer)) = tsOk
    {
      pXL.ClearTblBuffer;
      pXL.SetTblNumberFldValue('Level', 1);
      pXL.SetTblStringFldValue('PodrName'  , 'Итого по  ' +  Trim(RezultTable.sDepart) + ':');
      ItogoOutPut(RezultTable.dQuant, RezultTable.dOklad, RezultTable.DTar1,
                  RezultTable.DTar2, RezultTable.DTar3, RezultTable.DTar4,
                  RezultTable.DTar5, RezultTable.DRaise1, RezultTable.DRaise2,
                  RezultTable.DRaise3, RezultTable.DRaise4, RezultTable.DRaise5, 0, 0);
      pXL.InsTblRow;
    }
  }

  pXL.ClearTblBuffer;
  pXL.SetTblNumberFldValue('Level', 1);
  pXL.SetTblStringFldValue('PodrName'  , 'Всего по : ' + KatOrg.Name);
  // вывод результата по всей организации
  if GetLast FastFirstRow RezultTable where ((0 == RezultTable.LevelIer)) = tsOk
  {
    ItogoOutPut(RezultTable.dQuant, RezultTable.dOklad, RezultTable.DTar1,
                RezultTable.DTar2, RezultTable.DTar3, RezultTable.DTar4,
                RezultTable.DTar5, RezultTable.DRaise1, RezultTable.DRaise2,
                RezultTable.DRaise3, RezultTable.DRaise4, RezultTable.DRaise5, 0, 0);
  }
  pXL.InsTblRow;
}
//******************************************************************************
// Модификация таблицы результатов по уровням
//******************************************************************************
Procedure UpdRez;
{
  Update RezultTable where (((PrevHier + 1 )>> RezultTable.LevelIer))
                          set RezultTable.dQuant  := RezultTable.dQuant  + TdQuant,
                              RezultTable.dOklad  := RezultTable.dOklad  + TdTotal,
                              RezultTable.DTar1   := RezultTable.DTar1   + TdBonus1,
                              RezultTable.DTar2   := RezultTable.DTar2   + TdBonus2,
                              RezultTable.DTar3   := RezultTable.DTar3   + TdBonus3,
                              RezultTable.DTar4   := RezultTable.DTar4   + TdBonus4,
                              RezultTable.DTar5   := RezultTable.DTar5   + TdBonus5,
                              RezultTable.DRaise1 := RezultTable.DRaise1 + TdRR1,
                              RezultTable.DRaise2 := RezultTable.DRaise2 + TdRR2,
                              RezultTable.DRaise3 := RezultTable.DRaise3 + TdRR3,
                              RezultTable.DRaise4 := RezultTable.DRaise4 + TdRR4,
                              RezultTable.DRaise5 := RezultTable.DRaise5 + TdRR5,
                              RezultTable.Itogo   := RezultTable.Itogo   +
                                (TdTotal + TdBonus1 + TdBonus2 + TdBonus3 + TdBonus4 + TdBonus5
                                        + TdRR1 + TdRR2 + TdRR3 + TdRR4 + TdRR5)
}
//******************************************************************************
// Получаем наименование подразделения с учетом настройки "с иерархией"
//******************************************************************************
Function GetRightName: string;
{
  GetRightName := '';

  if (cFullNameIer = 0) // с учетом иерархии
    GetRightName := SHierarchyTable.Name;
  else
    if GetFirst FastFirstRow CatPodrDeptIerNaim = tsOk
      GetRightName := CatPodrDeptIerNaim.Name;
}
//******************************************************************************
// Вывод в форму таблицы сформированных данных
//******************************************************************************
Function PrintReport(_HierarchyLevel : word): word;
  var InAlllRec : boolean;
      TotalRec : boolean;
      _tmpInt : integer;
      TName   : string;
      isAllOk :boolean;
{
  PrintReport := 5;



  if GetMarkerCount(_SearchMarker) = 0
  {
    PrintReport := 1;
    StopVisual('', 0);
    exit;
  }



  // навесили связь между таблицей найденных данных и иерархией подразделений
  PushBounds(tbOrd1);
//  Надобно откоментарить код, наверно, а то потом и сам не разберешься.
//  Итак начнем:
//  SH_CreateHierarchy - строим иерархию подразделений , при этом раставляем признак
//                       того, нужно ли нам подразделение в этом отчете или нет.
//                       в маркере _SearchMarker и хранятся те, что нужны
  TName := '';
  NextVisual;
  iSHierarchy.SH_CreateHierarchyExt(dateSts, _SearchMarker, false,10); // создать иерархию 10 - не перестраиваем по новой иерархию!
  TimeLog('NBB_Vacancy->PrintReport SH_CreateHierarchy _HierarchyLevel='+String(_HierarchyLevel)+', '+GetMarkerCount(_SearchMarker));
  // перенес пониже
  if not PreparePrint // подготовить ехсел для вывода данных
  {
    PrintReport := 0;
    StopVisual('', 0);
    exit;
  }


  StopVisual('', 0);

  StartNewVisual(vtIndicatorVisual, vfTimer, ''#3'Идет выгрузка данных в отчет...', RecordsInTable(#SHierarchyTable));
  //  SH_ClearValueOnLevel - очищаем итоги по всем уровням
  iSHierarchy.SH_ClearValueOnLevel(-1, -1);
  if SortPodr = 0
    SetOrder(tiSHierarchyTableCode); // Сортируем по коду
  else
    SetOrder(tiSHierarchyTableSortKey); // Сортируем по наименованию

  //  цикл по табличке с постоенной иерархией
  _Loop SHierarchyTable
  {
    if not NextVisual
    { isAllOk:=false;
      break
    }
    if not(SHierarchyTable.actual) //- признак нужно ли нам это подразделение в этом отчете
      continue;
    //  Разберемся с уровнем иерархии, до которого необходимо выводить ИНФУ
    //  InAlllRec - признак, является ли запись записью "ИТОГО..."
    //  TotalRec  - признак, является ли запись записью "ВСЕГО..."
    InAlllRec := false;
    TotalRec  := false;
    //  определяем тип записи в иерархии
    if (iSHierarchy.SH_IsLevel_In_All(SHierarchyTable.Nrec))
      InAlllRec := true
    else
      if (iSHierarchy.SH_IsLevel_Total(SHierarchyTable.Nrec))
        TotalRec  := true;
    //  получаем количество записей на конкретном уровне
    _tmpInt := Integer(iSHierarchy.SH_GetValueOnLevel(SHierarchyTable.levelIer, 1));

    //  проверка для того, что бы не выводить 2 записи в случае, когда подряд идет "ИТОГО" и "ВСЕГО"
    //  либо же на уровне 0 записей
    if (InAlllRec) and (_tmpInt = 0)
      continue;

    if (SHierarchyTable.levelIer <= _HierarchyLevel) // закончился уровень - выводим итого
    {
      if (TName <> '')
        if (TdQuant <> 0)
        {
          pXL.ClearTblBuffer;
          pXL.SetTblNumberFldValue('Level', 1);
          pXL.SetTblStringFldValue('PodrName', 'Итого:');
          ItogoOutPut(TdQuant, TdTotal, TdBonus1, TdBonus2, TdBonus3,
                TdBonus4, TdBonus5, TdRR1, TdRR2, TdRR3, TdRR4, TdRR5, 0, 0);

          // апдейт итоговых записей
          UpdRez;

          TdQuant := 0;
          TdRR1 := 0;
          TdRROklad1 := 0;
          TdRR2 := 0;
          TdRROklad2 := 0;
          TdRR3 := 0;
          TdRROklad3 := 0;
          TdRR4 := 0;
          TdRROklad4 := 0;
          TdRR5 := 0;
          TdRROklad5 := 0;
          TdBonus1 := 0;
          TdBonusOklad1 := 0;
          TdBonus2 := 0;
          TdBonusOklad2 := 0;
          TdBonus3 := 0;
          TdBonusOklad3 := 0;
          TdBonus4 := 0;
          TdBonusOklad4 := 0;
          TdBonus5 := 0;
          TdBonusOklad5 := 0;
          TdTotal := 0;
          TdTotalOklad := 0;
          pXL.InsTblRow;

          // сначала проверка на то, не надо ли выводить  итоги
          if (SHierarchyTable.levelIer < PrevHier)
            LevelItogo(SHierarchyTable.levelIer);
        }//if TName <> ''

      pXL.ClearTblBuffer;
      pXL.SetTblNumberFldValue('Level', 1);
      pXL.SetTblStringFldValue('PodrName'  , GetRightName);
      pXL.InsTblRow;

      TName:= SHierarchyTable.Name;
    } //закончился уровень - выводим итого

    // прописать наименование подразделения
    if GetLast FastFirstRow RezultTable where ((SHierarchyTable.levelIer == RezultTable.LevelIer)) = tsOk
    {
      RezultTable.sDepart:= GetRightName;
      Update Current RezultTable;
    }

    if (_HierarchyLevel = 0)
      SHierarchyTable.cPodr := 0;
  // =============================================================================
  //  ну а дальше вообще все просто выводим все нужные записи с информацией для конкретного
  //  подразделения, выбранного в иерерхии .... и так, пока не надоест!
    if (not (TotalRec) and not (InAlllRec))
    {
      // а теперь выгрузка данных текущего подразделения
      _loop RT
      {
        pXL.ClearTblBuffer;
        pXL.SetTblNumberFldValue('Level', 0);
        pXL.SetTblStringFldValue('PodrName', GetRightName);
        pXL.SetTblNumberFldValue('PodrNRec', RT.cPodr);
        pXL.SetTblStringFldValue('PodrCode', RT.sPodrCode);

        pXL.SetTblStringFldValue('Post'   , RT.sPost  );
        pXL.SetTblStringFldValue('FIO'    , if (trim(RT.FIO) = '', 'вакансия', RT.FIO));

        if (RT.dOklad <> 0)
          pXL.SetTblNumberFldValue('Oklad'   , RT.dOklad );

        if (RT.MinOklad <> 0)
          pXL.SetTblNumberFldValue('MinOklad', RT.MinOklad);
  
        if (RT.MaxOklad <> 0)
          pXL.SetTblNumberFldValue('MaxOklad', RT.MaxOklad);


        pXL.SetTblNumberFldValue('Razriad', RT.Razriad);

        pXL.SetTblStringFldValue('KatPersCode', RT.KatPersCode);
        pXL.SetTblStringFldValue('KatPersName', RT.KatPersName);
        pXL.SetTblStringFldValue('DopKat'     , RT.DopKat);
        pXL.SetTblStringFldValue('VidPr'      , RT.VidPr);

        pXL.SetTblStringFldValue('LevelOpl'   , RT.LevelOpl);
        pXL.SetTblStringFldValue('SysOpl'     , RT.SysOpl);
        pXL.SetTblNumberFldValue('KolEd'      , RT.dQuant);
        pXL.SetTblStringFldValue('VidStav'    , RT.VidStav);

        pXL.SetTblNumberFldValue('dVred'      , RT.dVred);

        if GetBird(1)
          {
            if (RT.DTar1 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladVal', RT.DTar1    );

            if (RT.DTarPerc1 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladPer', RT.DTarPerc1);
          }
        if GetBird(2)
          {                                                                 
            if (RT.DTar2 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladVal', RT.DTar2    );

            if (RT.DTarPerc2 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladPer', RT.DTarPerc2);
          }
        if GetBird(3)
          {                                                                
            if (RT.DTar3 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladVal', RT.DTar3    );

            if (RT.DTarPerc3 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladPer', RT.DTarPerc3);
          }
        if GetBird(4)
          {                                                                 
            if (RT.DTar4 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladVal', RT.DTar4    );

            if (RT.DTarPerc4 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladPer', RT.DTarPerc4);
          }
        if GetBird(5)
          {                                                                
            if (RT.DTar5 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladVal', RT.DTar5    );

            if (RT.DTarPerc5 <> 0)
              pXL.SetTblNumberFldValue('ColPov1TarifOkladPer', RT.DTarPerc5);
          }
        if GetBird(11)
          {
            if (RT.DRaise1 <> 0)
              pXL.SetTblNumberFldValue('Col1NadVal', RT.DRaise1    );
            
            if (RT.DRaisePerc1 <> 0)
              pXL.SetTblNumberFldValue('Col1NadPer', RT.DRaisePerc1);
          }
        if GetBird(12)
          {                                                          
            if (RT.DRaise2 <> 0)
              pXL.SetTblNumberFldValue('Col1NadVal', RT.DRaise2    );
            
            if (RT.DRaisePerc2 <> 0)
              pXL.SetTblNumberFldValue('Col1NadPer', RT.DRaisePerc2);
          }
        if GetBird(13)
          {                                                        
            if (RT.DRaise3 <> 0)
              pXL.SetTblNumberFldValue('Col1NadVal', RT.DRaise3    );
            
            if (RT.DRaisePerc3 <> 0)
              pXL.SetTblNumberFldValue('Col1NadPer', RT.DRaisePerc3);
          }
        if GetBird(14)
          {                                                        
            if (RT.DRaise4 <> 0)
              pXL.SetTblNumberFldValue('Col1NadVal', RT.DRaise4    );
            
            if (RT.DRaisePerc4 <> 0)
              pXL.SetTblNumberFldValue('Col1NadPer', RT.DRaisePerc4);
          }
        if GetBird(15)
          {                                                        
            if (RT.DRaise5 <> 0)
              pXL.SetTblNumberFldValue('Col1NadVal', RT.DRaise5    );
            
            if (RT.DRaisePerc5 <> 0)
              pXL.SetTblNumberFldValue('Col1NadPer', RT.DRaisePerc5);
          }

        pXL.InsTblRow;

        TdQuant       := TdQuant       + RT.DQUANT;
        TdBonus1      := TdBonus1      + RT.DTar1   * RT.DQUANT;
        TdBonusOklad1 := TdBonusOklad1 + RT.DTar1;
        TdBonus2      := TdBonus2      + RT.DTar2   * RT.DQUANT;
        TdBonusOklad2 := TdBonusOklad2 + RT.DTar2;
        TdBonus3      := TdBonus3      + RT.DTar3   * RT.DQUANT;
        TdBonusOklad3 := TdBonusOklad3 + RT.DTar3;
        TdBonus4      := TdBonus4      + RT.DTar4   * RT.DQUANT;
        TdBonusOklad4 := TdBonusOklad4 + RT.DTar4;
        TdBonus5      := TdBonus5      + RT.DTar5   * RT.DQUANT;
        TdBonusOklad5 := TdBonusOklad5 + RT.DTar5;
        TdRR1         := TdRR1         + RT.DRaise1 * RT.DQUANT;
        TdRROklad1    := TdRROklad1    + RT.DRaise1;
        TdRR2         := TdRR2         + RT.DRaise2 * RT.DQUANT;
        TdRROklad2    := TdRROklad2    + RT.DRaise2;
        TdRR3         := TdRR3         + RT.DRaise3 * RT.DQUANT;
        TdRROklad3    := TdRROklad3    + RT.DRaise3;
        TdRR4         := TdRR4         + RT.DRaise4 * RT.DQUANT;
        TdRROklad4    := TdRROklad4    + RT.DRaise4;
        TdRR5         := TdRR5         + RT.DRaise5 * RT.DQUANT;
        TdRROklad5    := TdRROklad5    + RT.DRaise5;
        TdTotalOklad  := TdTotalOklad  + RT.dOklad;
        TdTotal       := TdTotal       + RT.dOklad  * RT.DQUANT;
      }

      PrevHier := SHierarchyTable.levelIer;

      if (_HierarchyLevel = 0)
        break;
    }// if (not (TotalRec) and not (InAlllRec))
  }// _Loop SHierarchyTable

  if _HierarchyLevel > 0
  {
    pXL.ClearTblBuffer;
    pXL.SetTblNumberFldValue('Level', 1);
    pXL.SetTblStringFldValue('PodrName', 'Итого:');
    ItogoOutPut(TdQuant, TdTotal, TdBonus1, TdBonus2, TdBonus3,
              TdBonus4, TdBonus5, TdRR1, TdRR2, TdRR3, TdRR4, TdRR5, 0, 0);
    pXL.InsTblRow;
  }
  UpdRez; //апдейт таблицы итогов по уровням

  PopBounds(tbOrd1);
  PrintBottom; // печать подножия

  pXL.PublishTbl('Table');

  pXL.LoadReport(sXLSFileName);
  pXL.DisConnectExcel;
  StopVisual('', 0);
}
//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
HandleEvent
cmInit:
  {
    wUserName:=UserName();
    pMyOrg:=coGetTune('MyOrg');
    TimeLog_Init;
    StartNewVisual(vtNumericVisual, vfTimer, ''#3'Идет загрузка требуемых объектов и данных', 1);
    LoadVariables; // загрузить настройки отчета
    TimeLog('NBB_Vacancy->cmInit');
    TOA.Bind(0); // связываем TOA с собственной организацией

    var dVar: double;// передернуть объект для данных
    dVar := iRaise.GetPercentRaise(comp(0), date(0,0,0));
    // грузим объект иерархий
    // пусть сам грузиться LoadVipRef(objSHierarchy, 'StructHierarchy');
    // инициализация нужных маркеров
    DeptMarker_T3 := InitMarker('NBB_DeptMarker_T3', 8, 200, 10); // подразделений
    _SearchMarker := InitMarker('', 8, 200, 10);                  // вспомогательный
    DDDopl        := InitMarker('NBB_MarkerDDDopl', 8, 200, 10);  // маркер от должностного оклада
    DS1           := InitMarker('NBB_MarkerDS1', 8, 200, 10);     // маркер от первой суммы
    DS2           := InitMarker('NBB_MarkerDS2', 8, 200, 10);     // маркер от второй суммы
    //---------
    NBB_MarkersT1:=InitMarker('NBB_MarkersT1', 8, 200, 10);
    NBB_MarkersT2:=InitMarker('NBB_MarkersT2', 8, 200, 10);
    NBB_MarkersT3:=InitMarker('NBB_MarkersT3', 8, 200, 10);
    NBB_MarkersT4:=InitMarker('NBB_MarkersT4', 8, 200, 10);
    NBB_MarkersT5:=InitMarker('NBB_MarkersT5', 8, 200, 10);
    NBB_MarkersR1:=InitMarker('NBB_MarkersR1', 8, 200, 10);
    NBB_MarkersR2:=InitMarker('NBB_MarkersR2', 8, 200, 10);
    NBB_MarkersR3:=InitMarker('NBB_MarkersR3', 8, 200, 10);
    NBB_MarkersR4:=InitMarker('NBB_MarkersR4', 8, 200, 10);
    NBB_MarkersR5:=InitMarker('NBB_MarkersR5', 8, 200, 10);
    // наполним таблицу уровней

    FillLevelTable;
    TimeLog('NBB_Vacancy->FillLevelTable');
    // набить временную таблицу, из которой будем затем осуществлять вывод
    PickTmpTableWithNeedInfo;
    TimeLog('NBB_Vacancy->PickTmpTableWithNeedInfo');
    // запустить формирование отчета
    case PrintReport(Level) of
      0: Message('Не удалось загрузить шаблон ' + ID, Information);
      1:
      {
        Message('Нет данных для формирования отчета', Information);
      }
    end; //case
    TimeLog('NBB_Vacancy->PrintReport finish');

    // закрыть маркер подразделений
    DoneMarker(DeptMarker_T3, 'NBB_DeptMarker_T3');  // подразделений
    DoneMarker(_SearchMarker , '' ); // вспомогательный
    DoneMarker(DDDopl, 'NBB_MarkerDDDopl');
    DoneMarker(DS1, 'NBB_MarkerDS1');
    DoneMarker(DS2, 'NBB_MarkerDS2');
    DoneMarker(NBB_MarkersT1, '');
    DoneMarker(NBB_MarkersT2, '');
    DoneMarker(NBB_MarkersT3, '');
    DoneMarker(NBB_MarkersT4, '');
    DoneMarker(NBB_MarkersT5, '');
    DoneMarker(NBB_MarkersR1, '');
    DoneMarker(NBB_MarkersR2, '');
    DoneMarker(NBB_MarkersR3, '');
    DoneMarker(NBB_MarkersR4, '');
    DoneMarker(NBB_MarkersR5, '');

    // закрыть интерфейс
    ExitProc; // лениво искать, но похоже, что не закрывается IntInit при работе объекта по доплатам
    TimeLog('NBB_Vacancy->Finish');
    abort;
    exit;
  }
end;
End.
