Procedure Tabel_Init;
{ Loadworkingtable(tmp_lstab.clschet,wMes,wYear);
  WT_ResetFilter;
  //kol_vixod:=WT_GetDaysBwDates(dkWeeKend,1, dtb,dte);
  //mylogwrite(false,'Табель '+string(lstab.tabn)+', выходных='+string(kol_vixod));
}

//==============================
// сбор данных
//==============================
Function SborData : boolean;
var _pLsTab:comp;
    wErr:longint;
{ SborData:=False;
  timelog('GP_WT_WorkWithAbsences->SborData:Start');

  DTB:=date(1,wMes,wYear);
  DTE:=date(Last_Day(DTB),wMes,wYear);
  if DTB<DTB_Period DTB:=DTB_Period;
  if DTE>DTE_Period DTE:=DTE_Period;
  DayB:=Day(DTB);
  DayE:=Day(DTE);
  MyLogWrite(false,' Сбор '+DateToStr(DTB,'DD/MM/YYYY')+' - '+DateToStr(DTE,'DD/MM/YYYY') );
  if not iNextVisual('Сбор данных за '+string(wMes)+' мес. '+string(wYear)+' год' ) exit;
  delete all tmp_LsTab;
  _Try
  { var hStrFilter,hStrFilter1:longint=0;
    var hStrFilter_kat :longint=0;
    var hStrFilter_Pers:longint=0;
    var Q: IQuery;
    //-------------------
    Q:=queryManager.createQuery(SQLQuery(
      select  Distinct
       Lstab.Nrec as cLstab // :comp
      ,#Comp(0) as cPerexod//:comp
      ,CASE WHEN LsTab.Cexoz=#Comp(0) then LsTab.cex else LsTab.Cexoz End as cKatPodr//:comp
      ,CASE WHEN LsTab.cAppoint=#COMP(0) THEN Lschet.cAppoint ELSE LsTab.cAppoint END as cAppoint//:comp
      ,LsTab.Kateg as Kateg //  :word
      ,Persons.Fio as Fio   ///  :string[100]
      ,LsTab.tPerson as cPersons//:comp
      ,LsTab.cLschet as cLschet // :comp
      ,COALESCE(SubString(KatPodr.Kod,1,3),'-') as Podr_kod
      ,KatPodr.Kod as Podr_kodAll
      ,Persons.STRTABN as STRTABN
      ,COALESCE(KatPodr.Name,'-') as Podr_name
      ,COALESCE(KatPodr.Nrec,#Comp(0)) as Podr_nrec

      ,COALESCE(Catalogs.Name,'') as sPost
      ,LsTab.MesN //   :word
      ,LsTab.YearN //
      From LsTab
      Inner join Persons on Persons.Nrec = LsTab.tPerson
      Inner join Lschet  on Lschet.Nrec = LsTab.cLschet
        and (Lschet.DatUv=#Date(0,0,0)  or Lschet.DatUv>=:(DTB) )
        and Lschet.Sovm<>3
      //Left outer join KatPodr on KatPodr.Nrec =CASE WHEN LsTab.Cexoz=#Comp(0) Then LsTab.cex Else LsTab.Cexoz End
      Left outer join KatPodr on KatPodr.Nrec = LsTab.cex
      left outer join Catalogs on Catalogs.Nrec = CASE WHEN LsTab.cAppoint=#COMP(0) THEN Lschet.cAppoint ELSE LsTab.cAppoint END
      left outer join KlKatego on KlKatego.Kod = LsTab.Kateg
      left outer join MOVELSC on MOVELSC.CLSCHET =Lschet.nrec
          and MOVELSC.DATPOS<=:(DTE)
          and MOVELSC.DATUV >=:(DTB)
      where lstab.yearn =:(wYear)
         and LsTab.mesn =:(wMes)
         and (Lschet.DAtPos<=:(DTE) or COALESCE(MOVELSC.Nrec,#comp(0))<>#comp(0) )
         %Filter_LsTab
         %Filter_Kat
         %Filter_Pers
      Union
      SELECT   Distinct
       Lstab.Nrec as  cLstab // :comp
      ,Perexod.Nrec as cPerexod//:comp
      ,Perexod.Cexp as cKatPodr//:comp
      ,Perexod.cAppoint as cAppoint//:comp
      ,Perexod.Kateg as Kateg //  :word
      ,Persons.Fio as Fio   ///  :string[100]
      ,LsTab.tPerson as cPersons//:comp
      ,LsTab.cLschet   as cLschet // :comp
      ,COALESCE(SubString(KatPodr.Kod,1,3),'-') as Podr_kod
      ,KatPodr.Kod as Podr_kodAll
      ,Persons.STRTABN as STRTABN
      ,COALESCE(KatPodr.Name,'-') as Podr_name
      ,COALESCE(KatPodr.Nrec,#Comp(0)) as Podr_nrec
      ,COALESCE(Catalogs.Name,'') as sPost
      ,LsTab.MesN //   :word
      ,LsTab.YearN //
      From LsTab
      inner join Perexod on PEREXOD.CLSCH = lstab.cLSchet
          and PEREXOD.DATIZM>=:(DTB) and PEREXOD.DATIZM<=:(DTE)
      Inner join Persons on Persons.Nrec = LsTab.tPerson
      Inner join Lschet  on Lschet.Nrec = LsTab.cLschet
        and (Lschet.DatUv=#Date(0,0,0)  or Lschet.DatUv>=:(DTB) )
      Left outer join KatPodr on KatPodr.Nrec = Case
             when Perexod.Cexp = #Comp(0) then LsTab.cex else Perexod.Cexp end
      left outer join Catalogs on Catalogs.Nrec = Case
             when Perexod.cAppoint = #Comp(0) then LsTab.cAppoint else Perexod.cAppoint end
      left outer join KlKatego on KlKatego.Kod = Perexod.Kateg
      where lstab.yearn =:(wYear)
         and LsTab.mesn =:(wMes)
         %Filter_Perexod
         %Filter_Kat
         %Filter_Pers
    )); //queryManager.createQuery(SQLQuery(
    if IsBitCTW(wFilter,1)
    { //sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and CASE WHEN LsTab.Cexoz=#Comp(0) Then LsTab.cex Else LsTab.Cexoz End ',DepList));
      sqlAddStr(hStrFilter ,iQBuilder.MakeCriteriaFromMarker(' and LsTab.cex  ',DepList));
      sqlAddStr(hStrFilter1,iQBuilder.MakeCriteriaFromMarker(' and Perexod.cexp ',DepList));
      timelog('SborData:фильтр по подразделениям hStrFilter='+string(hStrFilter));
    }
    //---------------------
    if (hStrFilter<>0)
    { Q.setMacro('Filter_LsTab',hStrFilter);
      sqlFreeStr(hStrFilter);
    }
    else
    { Q.setMacro('Filter_LsTab','');
    }
    //---------------------
    if (hStrFilter1<>0)
    { Q.setMacro('Filter_Perexod',hStrFilter1);
      sqlFreeStr(hStrFilter1);
    }
    else
    { Q.setMacro('Filter_Perexod','');
    }
    //---------------------
    if IsBitCTW(wFilter,2)
    { sqlAddStr(hStrFilter_kat ,iQBuilder.MakeCriteriaFromMarker(' and KlKatego.Nrec ',MarkKat));
      timelog('SborData:фильтр по категориям hStrFilter='+string(hStrFilter_Kat));
    }
    if (hStrFilter_Kat<>0)
    { Q.setMacro('Filter_Kat',hStrFilter_Kat);
      sqlFreeStr(hStrFilter_Kat);
    }
    else
    { Q.setMacro('Filter_Kat','');
    }
    //---------------------
    if IsBitCTW(wFilter,3)
    { sqlAddStr(hStrFilter_Pers ,iQBuilder.MakeCriteriaFromMarker(' and Lstab.tPerson ',Marker_Persons));
      timelog('SborData:фильтр по сотрудникам hStrFilter='+string(hStrFilter_Pers));
    }
    if (hStrFilter_Pers<>0)
    { Q.setMacro('Filter_Pers',hStrFilter_Pers);
      sqlFreeStr(hStrFilter_Pers);
    }
    else
    { Q.setMacro('Filter_Pers','');
    }

    //---------------------

    if (Q.Execute.ErrorCode<>0)
    { message('Ошибка выполнения DSQL запроса 1 при отборе значений ('+string(Q.ErrorCode)+').',error);
      Exit;
    }
    else
    { wErr:=sqlCopyInto(Q.getResultSet,TNtmp_LsTab,true);
      timelog('SborData этап 1 '+String(wErr)+', выбрали '+RecordsInTable(TNtmp_LsTab));
    }
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса 001 '+ExploreException);
  }
  _finally
  {
  }
  StopVisual('',0);
  StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak + vfConfirm
        ,'Сбор данных за '+string(wMes)+' мес. '+string(wYear)+' год'
        ,RecordsInTable(#tmp_Lstab));
  _pLsTab:=0;
  _loop fullcache tmp_lstab
  { if not nextvisual then exit;
    if _pLsTab<>tmp_lsTab.cLstab
    { _pLsTab:=tmp_lsTab.cLstab;
      Tabel_Init;
    }
    InsTabel(tmp_lsTab.cPerexod);
  } // _loop lstab
  SborData:=true;
  timelog('GP_WT_WorkWithAbsences->SborData:FINISH '+RecordsInTable(#tmp_report_sp));

} //Function SborData : boolean;

//=======================================
Function HideShowColumnXLS(hideColumn:longint; _width:word=0):boolean;
{ Result:=xlSetColumnWidth(_width, 1,hideColumn, 1,hideColumn);
}

//=======================================
// Печать данных
//---------------------------------------
Function PrintDoc(_wTP:word; _wLev:word; _Prec:comp):longint;
var
    ii:word;
    ww_str:string;
{ #__UNUSED__(_wTP,_wLev,_Prec)
  Result:=0;

  set PRep:=_Prec;
  maxColCount:=37;//29 + 2 на месяц/год
  if not iNextVisual('Вывод данных ')
  { Result:=-1;
     exit;
  }
  ww_str:='Отчетный период: '+DateToStr(DTB_Period,'DD month YYYY г.')
      +' -' +DateToStr(DTE_Period,'DD month YYYY г.')
    ;
  wexrow:=2; wexcol:=1;
  MyPutExcel(ww_Str,10,0,-1,-1);
  //-----------------

  HeaderStrCount:=4;
  wexrow:=HeaderStrCount+1;
  MyXlCreaMatrix(1000,maxColCount);
  wexrow:=wexrow-1;
  _Loop tmp_report_sp
  { wexrow++;wexcol:=1;
    if not NextVisual then break;

    MyPutExcel(chr(13)+tmp_report_sp.dms[1],10,0,-1,-1);//№ подразделение
    MyPutExcel(chr(13)+tmp_report_sp.dms[36],10,0,-1,-1);//полное подразделение
    MyPutExcel(tmp_report_sp.dms[2],10,0,-1,-1);//наименование подразделения
    MyPutExcel(tmp_report_sp.dms[3],10,0,-1,-1);//Фамилия
    MyPutExcel(chr(13)+tmp_report_sp.dms[37],10,0,-1,-1);//табельный номер
    MyPutExcel(tmp_report_sp.dms[4],10,0,-1,-1);//Должность
    MyPutExcelNumber(tmp_report_sp.Kateg ,0,10,0,-1,-1);//Категория
    MyPutExcelNumber(tmp_report_sp.Yearn ,0,10,0,-1,-1);//Год
    MyPutExcelNumber(tmp_report_sp.MesN ,0,10,0,-1,-1);//Месяц

    for(ii:=5;ii<=maxColCount;ii++)
    {
      if isBitCTW(wOption,1)
      {
        MyPutExcelNumber(tmp_report_sp.dmd[ii]/24,5,10,0,-1,-1);//Фамилия
      }
      else
      {
        MyPutExcelNumber(Round(tmp_report_sp.dmd[ii]/8,2),if(ii>=5,2,0),10,0,-1,-1);//Кадры сказали считать в днях,а именно делить на 8...
      }
    }

  } //_Loop tmp_report_SP
  //нужно установить формат
  if isBitCTW(wOption,1)
  { //сделал в шаблоне xlSetNumberFormat('[h]:mm:ss;@',HeaderStrCount+1,7,wexrow,maxColCount);
  }
  MyxlWriteMatrix(wexrow);
  xlFreeMatrix;
  matrixkl:=False;
  MyxlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, HeaderStrCount+1 ,1,wexrow,maxColCount); //Обрамление
  xlWrapText(HeaderStrCount, 1, wexrow, maxColCount);
  //-------- спрячем колонки с месяцем и годом

  if not isBitCTW(wOption,2)
  { HideShowColumnXLS(8);
    HideShowColumnXLS(9);
  }


  //******************************************
  // Подписи
  //******************************************
  wexrow:=wexrow+3;  wexcol:=1;
  xlMergeCells(wexrow,1,wexrow,3);
  MyPutExcel(sDolg,10,0,-1,-1); //
  wexrow:=wexrow+1;  wexcol:=1;
  xlMergeCells(wexrow,1,wexrow,3);
  MyPutExcel(MyGetInitial(sPopdis,true),10,0,-1,-1); //
  wexcol:=8;//6
  MyPutExcel('подпись',8,0,-1,-1); //
  MyxlFrameCells( xlBorderT  , xlThin, 0, 0, wexrow ,5,wexrow,6); //Обрамление

} //Function PrintDoc(_wTP:word; _wLev:word; _Prec:comp):longint;


//------------------------------------
// Установить период в датах
//------------------------------------
Procedure SetPeriodDT;
{ DTB_Period:=date(1,wMesB,wYearE);
  DTE_Period:=date(Last_Day(Date(1,wMesE,wYearE)),wMesE,wYearE);
}
//------------------------------------
//
//------------------------------------
Function FormDoc:boolean;
var
   werr:word;
{ timelog('FormDoc:Start');
  if IsBitCTW(wFilter,1)
  { if DepList <> 0
      DoneMarker(DepList, '');
    DepList := CLSF.LoadCurrentDepartmentList;
  }
  ClearFuncCache;
  pStatus_GetDefault:=pGP_SCUD_A.GetStatus_Default();
#IFDEF GP_WT_WorkWithA_PER_BY_MES
  SetPeriodDT;

  if DTB_Period>DTE_Period
  { Message('Начало периода не может быть больше окончания');
    Exit;
  }
#ELSE
  wMesB :=Month(DTB_Period);
  wYearB:=Year (DTB_Period);
  wMesE :=Month(DTE_Period);
  wYearE:=Year (DTE_Period);
#ENDIF
  DT_Calc:=DTB_Period;
  LogFileNm:=GetStringParameter('Files','OutputFilesDirectory',0)
                               +'!GP_WT_OVER.log';
  nmtemplate:='GP_WT_WorkWithAbsences.xlsm';
  if isBitCTW(wOption,1)
  { nmtemplate:='GP_WT_WorkWithAbsences_H_MM.xlsm';
  }
  werr:=ExcelInit(nmtemplate,true);

  if FileExist(LogFileNm) DeleteFile(LogFileNm);
  MyLogWrite(true,'START');
  MyLogWrite(false,' pN otationRV1='+string(pNotationRV1,0,0)+', pNotationRV2='+string(pNotationRV2,0,0));
  matrixkl:=false;
  //----------------------------
  ResetBounds(#tmp_Report_sp);
  Delete all tmp_Report_sp;
  Delete all tmp_Report_sp;
  SetBounds(#tmp_Report_sp);

  ResetBounds(#tmp_Zauv);
  Delete all tmp_Zauv;
  Delete all tmp_Zauv;
  SetBounds(#tmp_Zauv);

  //----------------------------
  // Инициализация
  //----------------------------
  MyLogWrite(false,' Вершина дерева '+string(pRep_Main));

  //----------------------------
  // Сбор данных
  //----------------------------
  //--- соберем заявления
  _TRY
  { SQL Select
       GP_SCUD_Doc.DocDate                as EventDate // : date "Дата события"
     , GP_SCUD_Doc_SP.EventTmB            as EventTmB  // : time "Время события с"
     , GP_SCUD_Doc_SP.EventTmE            as EventTmE  //  : time "Время события по"
     , COALESCE(GP_SCUD_Reason.wType,0)   as wType
     , GP_SCUD_PERS.cPersons              as cPersons
     , GP_SCUD_Doc_SP.cGP_Scud_Pers       as cGP_Scud_Pers
     , Gp_SCUD_DOC_SP.Nrec as cGp_SCUD_DOC_SP// :comp
     , Gp_SCUD_DOC.Nrec as cGp_SCUD_DOC //    :comp
    FROM
      Gp_SCUD_DOC
    Inner join GP_SCUD_Doc_SP on GP_SCUD_Doc_SP.cGP_SCUD_Doc = GP_SCUD_Doc.Nrec
    inner join GP_SCUD_PERS   on GP_SCUD_PERS.Nrec = GP_SCUD_Doc_SP.cGP_SCUD_PERS
    inner join GP_SCUD_Reason on GP_SCUD_Reason.Nrec = GP_SCUD_Doc.cReason
    WHERE  GP_SCUD_Doc.wType=1010 //GP_iSC_statement_on_absence;//1010
      and (GP_SCUD_Doc.cStatus<>:(pStatus_GetDefault) )
      and :(DTB_Period)<=GP_SCUD_Doc.DocDate
      and :(DTE_Period)>=GP_SCUD_Doc.DocDate
    into Tmp_ZAUV ;
  }
  _except
  else
  { timelog('Возникло исключение при запуске запроса 001 '+ExploreException);
  }
  _finally
  { timelog('отобрали заявлений '+String(RecordsInTable(#Tmp_ZAUV)));
  }
  //------------------------------


  //for(wMes:=wMesB;wMes<=wMesE;wMes++)
  DT_Calc:=DTB_Period;
  do
  { wMes :=month(DT_CALC);
    wYear:=year(DT_CALC);

    Result:=SborData;
    if not Result exit;
    DT_CALC:=Add_months(DT_CALC,1);
  } //for(wMes:=wMesB;wMes<=wMesE;wMes++)
  while DT_Calc<DTE_Period
  //---------------------------------
  delete tmp_report_sp where
      tmp_report_sp.dmd[06]=0 and tmp_report_sp.dmd[07]=0 and tmp_report_sp.dmd[08]=0 and tmp_report_sp.dmd[09]=0 and tmp_report_sp.dmd[10]=0
  and tmp_report_sp.dmd[11]=0 and tmp_report_sp.dmd[12]=0 and tmp_report_sp.dmd[13]=0 and tmp_report_sp.dmd[14]=0 and tmp_report_sp.dmd[15]=0
  and tmp_report_sp.dmd[16]=0 and tmp_report_sp.dmd[17]=0 and tmp_report_sp.dmd[18]=0 and tmp_report_sp.dmd[19]=0 and tmp_report_sp.dmd[20]=0
  and tmp_report_sp.dmd[21]=0 and tmp_report_sp.dmd[22]=0 and tmp_report_sp.dmd[23]=0 and tmp_report_sp.dmd[24]=0 and tmp_report_sp.dmd[25]=0
  ;
  //---------------------------------

  StopVisual('',0);
  //----------------------------
  // Печать
  //----------------------------
  StartNewVisual(vtIndicatorVisual,vfTimer + vfBreak + vfConfirm,'Вывод данных'
        ,RecordsInTable(#tmp_report_sp));
  PrintDoc(0,0,0);
  MyXlEnd;
  Timelog('FomDoc : Finish  ');
} //Function FormDoc:boolean;

//-------------------------------------
Screen scrParam 'Параметры формирования' (,,sci1Esc);
Table Zar_User;
Fields
#IFDEF GP_WT_WorkWithA_PER_BY_MES
  wMesB :#Month_List
  wYearB:noProtect;
  wMese :#Month_List
  wYearE:noProtect;
#ELSE
  DTB_Period : noprotect;
  DTE_Period : noprotect;
#ENDIF
  sPopdis  :NoProtect,PickButton;// подпись отчета
  sDolg    :NoProtect,PickButton;// подпись отчета
  logfilekl:NoProtect;
  wFilter:NoProtect;
  //FILTR_KatPodr : Protect,PickButton;
  FiltrPodr: Protect,PickButton;
  VidKat   : Protect,PickButton;
  Filtr_Persons: Protect,PickButton;
  wOption:NoProtect;
Buttons
#IFDEF GP_WT_WorkWithA_PER_BY_MES
  cmValue1, [singleline],,, 'назад' , hcAllBOk, scGalDial;
  cmValue2, [singleline],,, 'вперед', hcAllBOk, scGalDial;
  cmValue3, [singleline],,, 'назад' , hcAllBOk, scGalDial;
  cmValue4, [singleline],,, 'вперед', hcAllBOk, scGalDial;
#ENDIF
  cmOk,default,,'Сформировать отчет', hcOplTrudhlp, sci1Esc;
  cmCancel,,,'Выход', hcOplTrudhlp, sci1Esc;
<<
#IFDEF GP_WT_WorkWithA_PER_BY_MES
  `Период`
  `c` .@@@@@@@@@@ мес. .@@@@@@ год <.<<.> <.>>.>
  `по`.@@@@@@@@@@ мес. .@@@@@@ год <.<<.> <.>>.>
#ELSE
  `Период`
  `c` .@@@@@@@@@@@@@@  `по`.@@@@@@@@@@@@@
#ENDIF
  `Фио подписанта`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Должность подписанта`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@

  `Фильтры`                  [.] Отладка`
  [.] По подразделению`.@@@@@@@@@@@@@@@@@@@@@
  [.] По категории`    .@@@@@@@@@@@@@@@@@@@@@
  [.] По сотруднику`   .@@@@@@@@@@@@@@@@@@@@@

  `Опции`
  [.] Выводить время в часах-минуты`
  [.] Выводить раздельно по месяцам`

  <.~С~формировать.>   <.  ~О~тмена  .>
>>
end; //scrParam 'Параметры формирования' (,,sci1Esc), Cyan;


//--------------------------------------------
// Обработчик событий интерфейса
//--------------------------------------------
HandleEvent
//------------------------------
cmInit:
{ TimeLog_Init;
  ReadParam;
  var CL: ContextList;
  if (not CL.Add(CS, 'WorkingTable'))
  { abort;
    exit;
  }
  sUserName:=UserName();
}
//------------------------------
cmDone:
{ SaveParam;
}
//------------------------------
cmPick:
{  case CurField of
   //----------------------------
   #sPopdis,#sDolg :
   {
      var wK:word;
      var DummyMarker1, DummyMarker2: TPtr;
      var _pTmp:comp=0;
      var _cRec:comp;
      DummyMarker1 := InitMarker('', 8, 10, 10);
      DummyMarker2 := InitMarker('', 8, 1, 1);
      wK:=0;
      _pTmp:=0;

      if (viCYPersons.Choice(DummyMarker1, 3, vfCanSelect, wK, _cRec, DummyMarker2))
      {
        set _pTmp:=viCYPersons.GetPsnByKindChoice(wK, _cRec);
        vSpr.pPerson :=_pTmp;
        if vSpr.Getfirst Persons=tsok
        { sPopdis:=vSpr.Persons.Fio;
          if vSpr.Getfirst Appointments=tsok
           sDolg:=iCatFunc.GetCatalogsName(vSpr.Appointments.Post);
        }
      }
      DoneMarker(DummyMarker1, '');
      DoneMarker(DummyMarker2, '');
   }

   //------------
   #FiltrPodr:
   {
     SetupDepartments(comp(11));
     //UpdateFilter;
     if PAF.IsDepartmentFilterSet <> IsBitCtW(wFilter,1)
       BitOnW(wFilter,1);
   }
   //------------------------------
   #VidKat:
   {
      RunInterface(pickkat1,word(0), MarkKat, vfMultipleSelection);
      SelectMarKat;
      BitOnW(wFilter,2);
   }
   //------------------------------
   #Filtr_Persons:
   { KauMarkerName := iGetKau.GetMarkerName(cgKau_Persons);
     StoreMarker(Marker_Persons,KauMarkerName);
     If (iGetKau.GetCodeKau(cgiPickMult+cgiNotClear,cgKau_Persons,Comp(0)) <> 0)
     { Marker_Tmp  :=InitMarker(KauMarkerName, 8, 50, 10, True);
       CopyMarker(Marker_Persons,Marker_Tmp);
       DoneMarker(Marker_Tmp,'');
       SetFilterNm(#Filtr_Persons);
       BitOnW(wFilter,3);
     }
   }
   end;
} //cmPick:
cmDelOnProtect:
{
   case CurField of
   //--------------
   #FiltrPodr:
   {
     PAF.ClearDepartmentFilter;
     ReReadRecord(#ZAR_USER);
     BitOffW(wFilter,1);
     //   UpdateFilter;
   }
   //------------------------------
   #VidKat:
   { ClearMarker(MarkKat);
      SelectMarKat;
      BitOffW(wFilter,2);
   }
   //------------------------------
   #Filtr_Persons:
   { ClearMarker(Marker_Persons);
     BitOffW(wFilter,3);
     SetFilterNm(#Filtr_Persons);
   }
   end;
} //cmDelOnProtect:
#IFDEF GP_WT_WorkWithA_PER_BY_MES
//------------------------------
cmValue1:
{ set wMesB:=wMesB-1;
  if wMesB=0
  { wMesB:=12; wYearB:=wYearB-1;
  }
  SetPeriodDT;
  if DTE_Period<DTB_Period
  { set wmesE :=wMesB;
    set wYearE:=wYearB;
  }
}
//------------------------------
cmValue2:
{ set wMesB:=wMesB+1;
  if wMesB>12
  { wMesB:=1; wYearB:=wYearB+1;
  }
  SetPeriodDT;
  if DTE_Period<DTB_Period
  { set wmesE :=wMesB;
    set wYearE:=wYearB;
  }
}
//------------------------------
cmValue3:
{ set wMesE:=wMesE-1;
  if wMesE=0
  { wMesE:=12; wYearE:=wYearE-1;
  }
  SetPeriodDT;
  if DTE_Period<DTB_Period
  { set wmesB :=wMesE;
    set wYearB:=wYearE;
  }
}
//------------------------------
cmValue4:
{ set wMesE:=wMesE+1;
  if wMesE>12
  { wMesE:=1; wYearE:=wYearE+1;
  }
  SetPeriodDT;
  if DTE_Period<DTB_Period
  { set wmesB :=wMesE;
    set wYearB:=wYearE;
  }
}
#ENDIF
//------------------------------
cmCheckField:
{ case CurField of
#IFDEF GP_WT_WorkWithA_PER_BY_MES
  #wmesB,#wYearB:
  { SetPeriodDT;
    if DTE_Period<DTB_Period
    { message('Дата окончания периода не может быть меньше даты начала');
      set DTE_Period:=DTB_Period;
      set wmesE :=wMesB;
      set wYearE:=wYearB;
    }
  }
  //------------------------------
  #wmesE,#wYearE:
  { SetPeriodDT;
    if DTE_Period<DTB_Period
    { message('Дата окончания периода не может быть меньше даты начала');
      set DTB_Period:=DTE_Period;
      set wmesB :=wMesE ;
      set wYearB:=wYearE;
    }
  }
#ELSE
  //------------------------------
  #DTB_Period:
  { if DTE_Period<DTB_Period
    { message('Дата окончания периода не может быть меньше даты начала');
      set DTE_Period:=DTB_Period;
    }
  }
  //------------------------------
  #DTE_Period:
  { if DTE_Period<DTB_Period
    { message('Дата окончания периода не может быть меньше даты начала');
      set DTB_Period:=DTE_Period;
    }
  }
#ENDIF
  end;
}
//------------------------------
cmOk:
{  xlKillExcel;
   StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Подготовка данных для отчета',0);
   if not FormDoc then message('Ошибки при формировании');
   StopVisual('',0);
   xlKillExcel;
   //CloseInterFace(cmDone);
}
end;

end.
