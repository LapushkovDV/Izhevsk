Procedure SaveParam;
{ SaveMyDsk(wMesB    ,'GP_WT_OverWorkRep_wMesB'    );
  SaveMyDsk(wMesE    ,'GP_WT_OverWorkRep_wMesE'    );
  SaveMyDsk(DTB_Period ,'GP_WT_OverWorkRep_DTB_Period' );
  SaveMyDsk(DTE_Period ,'GP_WT_OverWorkRep_DTE_Period' );
  SaveMyDsk(wYearB    ,'GP_WT_OverWorkRep_wYearB'    );
  SaveMyDsk(wYearE    ,'GP_WT_OverWorkRep_wYearE'    );
  SaveMyDsk(wFilter  ,'GP_WT_OverWorkRep_wFilter'  );
  SaveMyDsk(wOption  ,'GP_WT_OverWorkRep_wOption'  );
  SaveMyDsk(wVivod   ,'GP_WT_OverWorkRep_wVivod'   );
  SaveMyDsk(sPopdis  ,'GP_WT_OverWorkRep_sPopdis'  );//
  SaveMyDsk(sDolg    ,'GP_WT_OverWorkRep_sDolg'    );
  SaveMyDsk(logfilekl,'GP_WT_OverWorkRep_logfilekl');
  DoneMarker(MarkKat ,'VIDNej_MarkKat');
  DoneMarker(Marker_Persons, 'GP_WT_OverWorkRep_Persons');

} //Procedure SaveParam;

//------------------------------------
//
//------------------------------------
Procedure ReadParam;
{ if not ReadMyDsk(wMesB    ,'GP_WT_OverWorkRep_wMesB'    ,False) wMesB  :=MonthRas;
  if not ReadMyDsk(wMesE    ,'GP_WT_OverWorkRep_wMesE'    ,False) wMesE  :=MonthRas;
  if not ReadMyDsk(wYearB   ,'GP_WT_OverWorkRep_wYearB'   ,False) wYearB  :=YearRas;
  if not ReadMyDsk(wYearE   ,'GP_WT_OverWorkRep_wYearE'   ,False) wYearE  :=YearRas;
  if not ReadMyDsk(DTB_Period ,'GP_WT_OverWorkRep_DTB_Period',False ) DTB_Period:=date(1,wMesB,wYearB);
  if not ReadMyDsk(DTE_Period ,'GP_WT_OverWorkRep_DTE_Period',False ) DTE_Period:=date(Last_Day(date(1,wMesE,wYearE) ),wMesE,wYearE);

  if not ReadMyDsk(wFilter  ,'GP_WT_OverWorkRep_wFilter'  ,False) wFilter:=0;
  if not ReadMyDsk(wOption  ,'GP_WT_OverWorkRep_wOption'  ,False) wOption:=0;
  if not ReadMyDsk(wVivod   ,'GP_WT_OverWorkRep_wVivod'   ,False) wVivod :=127;
  if not ReadMyDsk(sPopdis  ,'GP_WT_OverWorkRep_sPopdis'  ,False) sPopdis:=sGetTune('USER.FIO');//
  if not ReadMyDsk(sDolg    ,'GP_WT_OverWorkRep_sDolg'    ,False) sDolg  :='';
  if not ReadMyDsk(logfilekl,'GP_WT_OverWorkRep_logfilekl',False) LogFileKl  :=false;
  MarkKat := InitMarker('VIDNej_MarkKat', 8, 10, 10);
  Marker_Persons  :=InitMarker('GP_WT_OverWorkRep_Persons' , 8, 50, 10, True);
  SelectMarKat;
  SetFilterNM(0);
} //Procedure ReadParam;

//------------------------------------------------------------------------------
// Пометка категорий
//------------------------------------------------------------------------------
  procedure SelectMarKat;
  var i1:longint;
      _pNrec:comp;
  {
      VidKat := '';
      if GetMarkerCount(MarkKat)>1
      { set VidKat:='множественный выбор ('+string(GetMarkerCount(MarkKat))+')';
      }
      else
      for (I1 := 0; I1 < GetMarkerCount(MarkKat); I1 := I1 + 1)
      { if (GetMarker(MarkKat, I1, _pNrec))
        if (GetFirst Klkatego where ((_pNrec == Klkatego.NREC)) = tsOk)
        { set VidKat:=Klkatego.naikat;
          break;
        }
      }

    if (VidKat= '')
      set VidKat:='не установлен';
    redrawpanel(#Zar_User);
  } // procedure SelectMarKat

//------------------------------------------------------------------------------
// обработка изменения фильтра по подразделениям  - см CompSrc\Z\Z_PayRep\vip\VIEWREES.VIP
//------------------------------------------------------------------------------
  procedure SetupDepartments(Change: comp);
  {
    var p2: double;    // для компиляции
    var PrCex: comp;
    PrCex := ZAR_USER.CURCEX;
    RunInterface('GetPodaln', Change, prCex, p2);
  }

  //---------------------------------------
  // Установка наименований фильтров
  //---------------------------------------
  Procedure SetFilterNM(_Field:longint=0);
  { if _Field=0 or _Field=#Filtr_Persons
    { #mrkfiltr_(Persons_Flt,Persons,Nrec,wc_nrec,Persons_Flt.Fio)
    }
    ReScanPanel(#Zar_User);
  } //Procedure SetFilterNM(_Field:longint)



Function Chk_Filter(_pCex:comp) :boolean; Cacheable;
{ Result:=True;
  if IsBitCtW(wFilter,1)
  { if not FoundMarker(DepList,_pCex)
    { Result:=False;
    }
  }
} //Function Chk_Filter(_pCex:comp) :boolean; Cacheable;

Function MyGet_Func_Boss(_pPodr:comp;_pPost:comp):string; cacheable;
var _pPost_FB:comp;
    _pPersons_FB:comp;
{ Result:='-';
  //if (wOption and 1)>0 then Exit;
  pDepartMent:=GetCatalogsByKatPodr(_pPodr);
  pPost:=_pPost;
  if getfirst StaffStruct=tsok
  { _pPost_FB   :=0;
    _pPersons_FB:=0;
    Result:=MyGetInitial(Get_Func_Boss(StaffStruct.Nrec,_pPost_FB,_pPersons_FB,DTE),True);
    if Result=''
    { Result:='-'
    }
    else
    { Result:=Result+chr(10)+iCatFunc.GetCatalogsName(_pPost_FB);
    }
  }
  //

} //Function MyGet_Func_Boss(_pPodr:comp;_pPost:comp):string; cacheable;


Procedure InsTabel(_Change:comp);
var ii,jj:word;
    _ChafF:double;
    _Mes,_Year:word;
{ WT_ResetFilter;
  // если включено раздельное ведение табелей
  //    if (SeparateTableKeeping)
  // установим фильтр по данному переходу в межпериод
  WT_SetAttributeFilter(wtaChange, _Change);
  WT_AddDayRangeFilter(DayB,DayE);
  _Mes:=0;_Year:=0;
  if IsBitCTW(wOption,2)
  { _Mes :=wMes;
    _Year:=wYear;
  }
  var _boIns:boolean=false;
  if getfirst tmp_report_sp where (( 0 == tmp_report_sp.cRec
     and tmp_LsTab.cPersons == tmp_report_sp.cPers
     and tmp_LsTab.Podr_nrec== tmp_report_sp.cPodr
     and tmp_LsTab.cAppoint == tmp_report_sp.cPost
     and _Year             == tmp_report_sp.YearN
     and _Mes              == tmp_report_sp.MesN
     //and tmp_LsTab.Kateg    == tmp_report_sp.Kateg
     ))<>tsok
  { ClearBuffer(#tmp_report_sp);
    tmp_report_sp.cRec:=0;
    tmp_report_sp.SortName:=tmp_LsTab.Fio;
    tmp_report_sp.Kateg   :=tmp_LsTab.Kateg;
    tmp_report_sp.cPers   :=tmp_LsTab.cPersons;
    tmp_report_sp.cPodr   :=tmp_LsTab.Podr_Nrec;
    tmp_report_sp.cPost   :=tmp_LsTab.cAppoint;
    tmp_report_sp.dms[1]  :=tmp_LsTab.Podr_kod;
    tmp_report_sp.dms[36]  :=tmp_LsTab.Podr_kodAll;
    tmp_report_sp.dms[37]  :=tmp_LsTab.STRTABN;
    tmp_report_sp.dms[2]  :=tmp_LsTab.Podr_name;
    tmp_report_sp.dms[3]  :=tmp_LsTab.FIO;
    tmp_report_sp.dms[4]  :=tmp_LsTab.sPost;
    tmp_report_sp.dms[5]  :=string(tmp_LsTab.Kateg);
    tmp_report_sp.YearN   :=_Year;
    tmp_report_sp.MesN    :=_Mes ;
    insert current tmp_report_sp;

  }

  //------------------
  // Здесь вычислим часы
  //------------------
  //плановые часы по графику
  //tmp_report_sp.dmd[5]:=tmp_report_sp.dmd[5]+WT_GetHoursEx(hkworking,stPlanned,0);
  tmp_report_sp.dmd[5]:=tmp_report_sp.dmd[5]+WT_GetHoursBwDaysEx(hkworking,0,0,stPlanned,1,31,0) ;
  //фактически отработанное время, час.
  tmp_report_sp.dmd[6]:=tmp_report_sp.dmd[6]+WT_GetHoursEx(hkworking,stActual,0);
  if WT_LoadMonthlyAbsences = 0
  { var _AbsenceCount:longint=WT_GetAbsenceCount(atMonthly);
    for(jj := 0; jj < _AbsenceCount; Inc(jj))
    { var pNotation: comp=0;
      var _aaMark:string;
      _aaMark:='';
      // if not WT_GetAbsenceAttribute(atMonthly, jj, aaNotation, pNotation)
      if not WT_GetAbsenceAttribute(atMonthly, jj, aaMark, _aaMark) then continue;
      var _aaBeginning , _aaEnding :date=ZeroDate;
      if not WT_GetAbsenceAttribute(atMonthly, jj, aaBeginning, _aaBeginning) then continue;
      if not WT_GetAbsenceAttribute(atMonthly, jj, aaEnding   , _aaEnding   ) then continue;

      ii:=0;
      case _aaMark of
      'ОТ' : ii:=07;
      'ОД' : ii:=08;
      'У'  : ii:=09;
      'УД' : ii:=10;
      'ДО' : ii:=11;
      'Д'  : ii:=12;
      'Г'  : ii:=13;
      'ПР' : ii:=14;
      'Б'  : ii:=15;
      'К'  : ii:=16;
      'ПК' : ii:=17;
      'ПМ' : ii:=18;
      'Т'  : ii:=19;
      'ОТГ': ii:=20;
      'РВ' : ii:=21; //РВ
      'РО' : ii:=22;
      'ОВК' : ii:=27;
      'НД'  : ii:= 28;
      'РП'  : ii:= 29;
      // 30 должно быть  НБ вроде как
      'НН'  : ii:= 31; // впереди оставлена дырка под НБ
      else continue;
      end;
      _ChafF:=0;
      WT_GetAbsenceAttribute(atMonthly, jj, aaHours,_ChafF);
      if _ChafF=0
        _ChafF:=WT_GHBDEx(1,0,0,-1,_aaBeginning , _aaEnding,0);

      tmp_report_sp.dmd[ii]+=_ChafF;
    } //for(jj := 0; jj < WT_GetAbsenceCount(atMonthly); Inc(jj))
  } //if WT_LoadMonthlyAbsences = 0

  //сверхурочка
  tmp_report_sp.dmd[23]+=WT_GetHours(hkOverwork,stActual)+WT_GetHours(hkOverworkRest,stActual);
  //------------------------
  // подхватим переработку
  if true //_boIns //только первый раз
  { if getfirst GP_Scud_Saldo =tsok
    { for(jj := 1; jj <=31 ; jj++)
      { if WT_TestDayEx(jj
         ,dkWorking //2
         ,stPlanned //0
         ,0
         )
       {  tmp_report_sp.dmd[26]+=GP_Scud_Saldo.CH_OVERWORK2[jj];
       }
     } //for(jj := 1; jj <=31 ; jj++)
    } //if getfirst GP_Scud_Saldo
    //---------------- Заявления
    _Loop  tmp_Zauv
    { jj:=Day(tmp_Zauv.EventDate);
      if not WT_TestDayEx(jj
        ,dkWorking //2
        ,stPlanned //0
        ,0
         ) then continue;
      if not pGP_SCUD_A.SetDocPosition(0,tmp_Zauv.cGP_SCUD_DOC,tmp_Zauv.cGP_SCUD_DOC_SP) then continue;
     _ChafF:=iGP_SCUD_Function.GetDoubleFromTime(
               pGP_SCUD_A.GetPlanTime(tmp_Zauv.cGp_SCUD_PERS
                  ,tmp_Zauv.EventDate //_DT:date;
                  ,tmp_Zauv.EventTMB , tmp_Zauv.EventTME)
                   );
     case tmp_Zauv.wType of
     2: tmp_report_sp.dmd[24]+=_ChafF;
     1: tmp_report_sp.dmd[25]+=_ChafF;
     end;

    } //_Loop  tmp_Zauv
  }

  update current tmp_report_sp;
} //Function InsTabel(_Change:comp);

