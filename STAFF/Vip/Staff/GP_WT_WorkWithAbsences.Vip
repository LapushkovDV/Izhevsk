Create view
var
  pRep       :comp;
  pRep_Main  :comp;
  pPost      :comp;
  pDepartMent:comp;
  pLschet    :comp;
  sUserName:string;
as select KlKatego.Nrec
, (PAF.GetDepartmentFilterStr)  (fieldname = FiltrPodr)
, tmp_LsTab.*
, tmp_Zauv.*
From KlKatego,  tmp_report_sp(tmp_report_sp03)
, ZAR_USER
, StaffStruct
, tmp_LsTab(tmp_LsTab01)
// подхватим переработку
, GP_Scud_Saldo
//------- фильтры
 , Persons    Persons_Flt
where
((
   sUserName == Zar_User.OwnName
//---------------
and pDepartment == StaffStruct.Department
and pPost       == StaffStruct.POST
and DTE_Period >>= StaffStruct.DInPut
and ( StaffStruct.DClose=ZeroDate
     or StaffStruct.DClose>=DTB
  )
 and  0 == tmp_report_sp.cRec
// подхватим переработку
and tmp_LsTab.cPersons == GP_SCUD_PERS.cPersons
//and GP_SCUD_PERS.Nrec  == GP_Scud_Saldo.cGP_SCUD_PERS
and tmp_LsTab.cPersons  == GP_Scud_Saldo.cPersons
and wYear               == GP_Scud_Saldo.Yearn
and tmp_LsTab.MesN      == GP_Scud_Saldo.MESN
and tmp_LsTab.cPersons  == tmp_Zauv.cPersons
and DTB        <<= tmp_Zauv.EventDate
and DTE        >>= tmp_Zauv.EventDate
//------- фильтры
and wc_nrec == Persons_Flt.Nrec

))
;

//------------------------------------
Create view vSpr
var
  pPerson :comp;
From Persons, Appointments
where
((  pPerson == Persons.Nrec
and Persons.Appointcur == Appointments.Nrec
));

//------------------------------------
create view vPodr
var
 sPodr_kod:string;
From KatPodr
where (( sPodr_kod == KatPodr.kod));




