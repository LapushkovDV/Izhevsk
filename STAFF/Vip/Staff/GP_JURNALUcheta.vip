// (Issue:#2078) Журнал учета личных карточек формы Т-2 (Т-2ГС)
#include UserReport.vih

VipInterface UserReport_GP_JURNALUchetaT2GS Implements IUserReport;
Interface UserReport_GP_JURNALUchetaT2GS 'Журнал учета личных карточек формы Т-2 (Т-2ГС) на граждан РФ, пребывающих в запасе и работающих в НПО Энергомаш' gray;
show (, , 150, 40);

var
 D1,  D2  :date;
 ItogALL, ItogOut: longint;
 LastRec: comp;

table struct tmpV
(
  cPers:COMP,
  Din: Date,
  SortFld: string[100]
//  Comm: string[1],
//  Spec: string[1]
)
with index (i1=SortFld , i2 = cPers, ixl = Din + SortFld);

create view vT
  as
select tmpV.* from tmpV, persons
,CONSCRIPTION
,CATALOGS MILRANK
,CATALOGS ACNTKIND
,CATALOGS VUS

,ATTRNAM GP_RegATTRNAM
,ATTRVAL REGN

,KatPodr CurPodr
// ,catalogs CurPost
where
((
  tmpV.cPers == persons.nRec
 and Persons.nRec == CONSCRIPTION.person
 and CONSCRIPTION.MILRANK == MILRANK.nRec
 and CONSCRIPTION.VUS == VUS.nRec
 and  CONSCRIPTION.ACNTKIND== ACNTKIND.nRec

and
//                  25002 == GP_RegATTRNAM.WTABLE
         coCONSCRIPTION == GP_RegATTRNAM.WTABLE
and 'Регистрационный №' == GP_RegATTRNAM.NAME
and GP_RegATTRNAM.nRec == REGN.CATTRNAM
and CONSCRIPTION.nRec == REGN.CREC
and GP_RegATTRNAM.WTABLE == REGN.WTABLE

and persons.GALDEP == CurPodr.nrec

/*
and persons.appointcur == appointments.nrec
and appointments.staffstr == staffstruct.nrec
and staffstruct.post == CurPost.nrec
*/

))
;

