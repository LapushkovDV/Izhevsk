function isOut : boolean;
{
  if persons.DISDATE > Date(0,0,0) isOut := true
  else
  if not isValid(#ACNTKIND) isOut := true
  else
  if ACNTKIND.Name = 'Общий воинский учет' isOut := false
  else
  if ACNTKIND.Name = 'Специальный воинский учет' isOut := false
  else isOut := true;
  /*
  isOut := ACNTKIND.Name <> 'Специальный воинский учет'
           and
           ACNTKIND.Name <> 'Общий воинский учет';
           */

}
Browse brMain '' (,,sci14Esc) ;
show at (,,,35);
Table tmpV;
// recMarker=pMarker;
//fixedLeft (mtMain.EventDate, GP_SCUD_Pers.Fio);

Fields // {font = { italic = isOut }};
//  {font = {color = if(isOut, ColorNotOk, 0)}};
 if(isOut, 'x', '') 'П' ('x- снят с учета') : [10],Protect;
 persons.APPDATE 'Дата','приёма' : [10],Protect;
 REGN.VSTRING    'Регистрационный','номер'       : [10],Protect;

 MILRANK.Name 'Воинское','звание'       : [20],Protect;
 Persons.Fio 'Ф.И.О.','сотрудника'      : [30],Protect;

 persons.BORNDATE 'Дата','рождения' : [10],Protect;
 VUS.CODE         'ВУС'             : [7],Protect;

 CurPodr.KOD 'Подраз','деление'     : [10],Protect;

 ACNTKIND.NAME 'Вид','учета'       : [30],Protect;
// '-' 'Общий','учет'       : [7],Protect;
// '+' 'Спец.','учет'       : [7],Protect;
 persons.DISDATE 'Дата','увольнения' : [10],Protect;

'' 'Примечение'       : [20],Protect;

//  mtMain.t5h  'Отсутствие в','середине дня(час)' :[10,2],Protect;
end;//Browse brMain
//------------------------------------------------------
screen ScrDocSp ;
show at (,36,,) ;
Fields
D1: skip;
D2: skip;
 ItogALL : skip;
 ItogOut : skip;
<<
    Всего за период с.@@@@@@@@@@ по.@@@@@@@@@@  Принято.@@@@@@@@@@  Снято.@@@@@@@@@@
>>
end;

procedure SborData;
{
  startNewVisual(vtRotateVisual, vfThread + vfTimer, 'Пожалуйста, подождите...', 100);

  mtClear(#tmpV, mfNormal);
  sql
  select persons.nrec, persons.APPDATE, persons.FIO
  from persons
  inner join CONSCRIPTION on Persons.nRec = CONSCRIPTION.person
  inner join catalogs CONSRELCAT on CONSCRIPTION.CONSREL = CONSRELCAT.nRec and CONSRELCAT.Name = 'Военнообязанный'
  where
    persons.CSOVM = #comp(0) // Основное место работы
    and
    (
       ( (:D1)  <=  persons.APPDATE    and  persons.APPDATE <= (:D2) )
    )
  into tmpV
  ;

  ItogALL := RecordsIntable(#tmpV);

  sql
  select Count(*)
  from persons
  inner join CONSCRIPTION on Persons.nRec = CONSCRIPTION.person
  inner join catalogs CONSRELCAT on CONSCRIPTION.CONSREL = CONSRELCAT.nRec and CONSRELCAT.Name = 'Военнообязанный'

  left join catalogs ACNTKINDCAT on CONSCRIPTION.ACNTKIND = ACNTKINDCAT.nRec

  where
    persons.CSOVM = #comp(0) // Основное место работы
    and
    (
       ( (:D1)  <=  persons.APPDATE    and  persons.APPDATE <= (:D2) )
    )
    and
      (
         ( persons.DISDATE > #Date(0,0,0) )
         or
         ACNTKINDCAT.nRec is null
         or
         (
           ACNTKINDCAT.Name <> 'Специальный воинский учет'
           and
           ACNTKINDCAT.Name <> 'Общий воинский учет'
         )
      )
  into (ItogOut)
  ;


  if ReadMyDsk(LastRec, 't2gsLastRec',false)
  {
     if getfirst tmpV where (( LastRec == tmpV.cPers ))  <> tsOK
     if getfirst tmpV  = tsOK {}
  }
  else
     if getfirst tmpV = tsOK  {}


  ReReadRecord(#tmpV); // с ReScanPanel через таблицу в памяти плохо позиционируется

  stopVisual('', 0);

}

var
 Counter, MaxLine, MaxCol , ii, Coli: longint;
 ExcelFileName: string;


procedure SOutXL(pCol:longint;pStr: string);
{
  xlSetCellStringValue(pStr,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}
procedure DOutXL(pCol:longint;pDt: date );
{
  xlSetCellDateValue(pDt,Counter,MaxCol+pCol,Counter,MaxCol+pCol);
}


HandleEvent

cmInit: {

   if not ReadMyDsk(D1, 't2gsD1',false) { D1 := Cur_Date; D1 := Date( 01 ,MONTH(D1),YEAR(D1))}
   if not ReadMyDsk(D2, 't2gsD2',false) { D2 := Date( Last_Day(D1) ,MONTH(D1),YEAR(D1)) }

      if not isValid(#GP_RegATTRNAM)
      {
        message('Не найден внешний атрибут "Регистрационный №" типа STRING к таблице CONSCRIPTION');
        CloseInterface(cmDone);
        exit;
      }

      if RunWindowModal(wnFilter)=cmDefault
      {
        SaveMyDsk(D1, 't2gsD1');
        SaveMyDsk(D2, 't2gsD2');

        SborData;
      }
      else
      { CloseInterface(cmDone);
        exit;
      }


}


cmDone:{

  SaveMyDsk(tmpV.cPers, 't2gsLastRec');

}


cmDo:
{

//  SaveMyDsk(bSkipByFlag, 'Tabel2_bSkipByFlag');
//  SaveMyDsk(nm_file    , 'Tabel2_nm_file');
}

cmHotKeys:
{
  case CurTable of
  #tmpV:
  { ProcessCommand(RunMenu('GP_JURNALUchetaT2GS_Main_HotKey'));
  }
  end;
}
cmFilterSave:
{
      SaveMyDsk(tmpV.cPers, 't2gsLastRec');
      if RunWindowModal(wnFilter)=cmDefault
      {
        SaveMyDsk(D1, 't2gsD1');
        SaveMyDsk(D2, 't2gsD2');

        SborData;
      }
}
cmValue2: // Зарегестрировать ВСЕХ
{
  var NextNum: longint = 1;

  Sql select Max(VLONGINT) from ATTRVAL where ATTRVAL.CATTRNAM = :(GP_RegATTRNAM.nRec) into (NextNum);

  PushPos(#tmpV);
  _Loop tmpV
  _Loop Persons
  _Loop CONSCRIPTION
  _Loop GP_RegATTRNAM
  if getfirst REGN <> tsOK
  {
    NextNum++;
    REGN.CATTRNAM:= GP_RegATTRNAM.nRec;
    REGN.WTABLE  := GP_RegATTRNAM.WTABLE;
    REGN.CREC    := CONSCRIPTION.nRec;
    REGN.VLONGINT:= NextNum;
    REGN.VDATE   := PERSONS.APPDATE;
    REGN.VSTRING := string(REGN.VLONGINT);
    insert current RegN;
  }
  PopPos(#tmpV);
  ReReadRecord(#tmpV);
}
cmValue3: // Зарегестрировать текущую
{
  var NextNum: longint = 1;

  Sql select Max(VLONGINT) from ATTRVAL where ATTRVAL.CATTRNAM = :(GP_RegATTRNAM.nRec) into (NextNum);

  if not isValid(#REGN)
  {
    NextNum++;
    REGN.CATTRNAM:= GP_RegATTRNAM.nRec;
    REGN.WTABLE  := GP_RegATTRNAM.WTABLE;
    REGN.CREC    := CONSCRIPTION.nRec;
    REGN.VLONGINT:= NextNum;
    REGN.VDATE   := PERSONS.APPDATE;
    REGN.VSTRING := string(REGN.VLONGINT);
    insert current RegN;
  }
  ReReadRecord(#tmpV);
}

cmValue4: // Обновить дату регистрации
{
      if not isValid(#GP_RegATTRNAM)
      {
        message('Не найден внешний атрибут "Регистрационный №" типа STRING к таблице CONSCRIPTION');
      }
      else
      {
          Sql
          UpDate ATTRVAL set ATTRVAL.VDATE = PERSONS.APPDATE
          from CONSCRIPTION, Persons
          where
           ATTRVAL.CATTRNAM = :(GP_RegATTRNAM.nRec)
          and ATTRVAL.CREC = CONSCRIPTION.nRec
          and CONSCRIPTION.person = Persons.nRec

          and PERSONS.APPDATE > #Date(0,0,0)
          and ATTRVAL.VDATE <> PERSONS.APPDATE
          ;

      }

}
cmEdit: { RunInterface(Z_STAFF::RECWIN05, tmpV.cPers, 0);   ReReadRecord(#tmpV); }

cmPrintDoc:
{

  ExcelFileName := 'GP_JURNALUchetaT2GS.xls';
  ExcelFileName := TranslatePath('%ClientStartPath%') + 'XLS_ЭМ\Staff\' + ExcelFileName ;

  if (not ExistFile(ExcelFileName))
  { message('Не найден шаблон файла "'+ExcelFileName+'"',error);
    exit;
  }

  if (not xlCreateExcelWithTemplate(ExcelFileName,true))
  { message('Ошибка создания нового файла в Excel"'+ExcelFileName+'".',error);
    exit;
  }

StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Выгрузка отчета в Excel ...', ItogALL div 3);
Counter:=5;

      PushPos(#tmpV);
      _Loop tmpV ordered by index ixl
      _Loop Persons
      _Loop CONSCRIPTION
      {
         Counter++;
         if Counter mod 3 = 0
         if not nextvisual break;

          xlSetCellStringValue('', Counter, 1, Counter, 11);
          dOutXL( 1, persons.APPDATE);

          if getfirst REGN = tsOK
          sOutXL( 2, REGN.VSTRING);

          if isValid(#MILRANK)
          sOutXL( 3, MILRANK.Name );

          sOutXL( 4, Persons.Fio  );

          dOutXL( 5, persons.BORNDATE);

          if isValid(#VUS)
          sOutXL( 6, VUS.CODE   );

          if isValid(#CurPodr)
          sOutXL( 7, CurPodr.KOD);

          if isValid(#ACNTKIND)
          {
          //          sOutXL( 8, ACNTKIND.NAME);

            xlSetCellStringValue('-', Counter, 8, Counter, 9);

            if ACNTKIND.Name = 'Общий воинский учет'       sOutXL( 8, '+')
            else
            if ACNTKIND.Name = 'Специальный воинский учет' sOutXL( 9, '+')

          }


          if persons.DISDATE > Date(0,0,0)
          sOutXL( 10, 'уволен '#13 + persons.DISDATE);


     } // _Loop

  xlWrapText(6, 1, Counter, 11);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin, 0, 0, 6, 1, Counter, 11);

  xlSetFontSize(10, 6, 1, Counter, 11);


  Counter++;
  Counter++;
  sOutXL( 2, 'Всего за период с ' +D1+ ' по ' + D2 + ' Принято ' + ItogALL + ' Снято ' + ItogOut);
  xlAlignCells(xlLeft, Counter, 2, Counter, 11);

  xlkillExcel;
  StopVisual('',0);

      PopPos(#tmpV);
      ReReadRecord(#tmpV);


}
end;

// Запуск отчета на выполнение при выборе его из списка отчетов
procedure Run;
{
  RunWindow(wnMainWindow);
}

// Наименование отчета в списке
function GetReportName: String;
{
  result := 'Журнал учета личных карточек формы Т-2 (Т-2ГС)';
}

function GetGroupName (Level : Word) : String;
{ #__UNUSED__(Level)
  GetGroupName := 'Ведение картотеки сотрудников';
}

// Приоритет отчета - сортировка внутри группы выполняется сначала
// по приоритету, а затем по наименованию
function GetPriority : Integer;
{
  result := 0;
}

// ModuleID модулей, в которых будет виден отчет
// '*' - отчет будет виден в любом модуле
function VisibleInModule(Ind : Byte) : String;
{
  result := '';
  case Ind of
    1 : result := 'STAFFMAINMENU';
  end;
}

end.

