#include GP_RKStat.vih
#include CatFunc.vih
//#include StrFunc.vih
#include APPFUNCS.VIH
#include TotalOrganizationAttributes.vih
#include GP_ChRPD.vih
#include GP_UDR_RKStat.vih

#define GPInt GP_RKStat_List13K_V // #(GPInt)
#define GPNam 13-К "Сведения о сотрудничестве с учебными заведениями (ВУЗы)" // #(GPNam)
//13-к (для ВУЗов)
VipInterface #(GPInt) Implements IGP_RKStat;
Interface #(GPInt);

const
#include Excel.inc;
sGroupOU = '_ВУЗы (высшие учебные заведения)';
end;

#include TotalOrganizationAttributes.var

table struct ttStatRK
(
  sNameOU : string
, sCodeSpc: string[100]
, dbVal : array [1..12] of double
)
with index
(
  ttStatRK01 = sNameOU + sCodeSpc
);
table struct tt13SpecRK
(
  sCodeSpc: string[100]
, iRow    : integer
)
with index
(
  tt13SpecRK01 = sCodeSpc
);
table struct tt13OURK
(
  sOU  : string
)
with index
(
  tt13OURK01 = sOU
);
table struct ttPsnFlags
(
  cPsn : comp
, sFIO : string[60]
, dBorn: date
, isFl : array [1..18] of boolean
)
with index
(
  ttPsnFlags00 = cPsn
, ttPsnFlags01 = sFIO + dBorn
);


table struct ttSpecRK
(
  cPsn      : comp
, sTypePsn  : string[1]
, sFIO      : string[60]
, dAppoint  : date
, dDismiss  : date
, sVidEdu   : string
, dBegEdu   : date
, dEndEdu   : date
, sInst     : string
, sLevelInst: string
, sSpecName : string
, sSpecCode : string
, dDateTo   : date
, sDeptCode : string
, sPost     : string
, dBegPract : date
, dEndPract : date
, sNo201    : string[20]
, sPract    : string
, dNIOKR    : date
, fSumNIOKR : double
, sColunms  : string
)
with index
(
  ttSpecRK01 = sInst + sSpecCode + sFIO
);


var
  dRep          : date;
  iCatFunc      : CatalogsFunctions;
  iAppFuncs     : AppointmentsFunctions;
  iChRPD        : GP_ChRPD;
  iUDR          : GP_UDR_RKStat;
  sFullName     : string;
  sPodr1        : string;
  mPodr1        : TPtr;
  sEdu1         : string;
  mEdu1         : TPtr;
  isFilterPodr  : boolean;
  wPrintRash    : word;
  wToExistFile  : word;
  sToExistFile  : string;
//   cRecTopOU     : comp;


create view
var
  dBeg     : date;
  cNIOKR   : comp;
from
  ttStatRK
, ttSpecRK
, tt13SpecRK
, tt13OURK
, ttPsnFlags
, Education
, Appointments
, apphist
, Appointments AppStaff
, Persons
, Persons PsnEdu
, ContDoc
, GP_SPCONTDOC201
, ContDoc  ContDoc201
, PartDoc  PartDoc201
, TitleDoc TitleDoc201
, Appointments App201
, Catalogs CatAny
//, StaffStruct  StaffApp
, StaffStruct
, DopTables
, DopInfo
where
((
      date(1, 1, year(dBeg))<<= Education.ToDate (noindex)// and (Education.ToDate <= dEnd or Education.ToDate = 0)
and         Education.Person == PsnEdu.nRec
and         Education.Person == Appointments.Person 
and                    dBeg <<= Appointments.AppointDate and ( Appointments.AppointDate <= dRep )
and        Appointments.nRec == AppHist.cAppoint and ( AppHist.CodOper = 1 )
and        Appointments.nRec == ContDoc.cStr and (ContDoc.TypeOper = 1)
and    Appointments.StaffStr == StaffStruct.nRec

and         Education.Person == GP_SPCONTDOC201.cPerson (noindex)
and GP_SPCONTDOC201.cContDoc == ContDoc201.nRec
and         ContDoc201.cPart == PartDoc201.nRec
and          PartDoc201.cDoc == TitleDoc201.nRec
and          ContDoc201.cStr == App201.nRec

and                     dBeg<<= DopInfo.dFld[1] and (DopInfo.dFld[1] <= dRep and DopInfo.cDopTbl = cNIOKR)
))
;

function sSetPodrName(mSetPdr: TPtr): string;
{
  if (getMarkerCount(mSetPdr) = 0)
  {
    result := 'Все подразделения';
    exit;
  }
  else
    if (getMarkerCount(mSetPdr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько подразделений (' + string(getMarkerCount(mSetPdr)) + ')';
}

function sSetEduName(_mSetEdu: TPtr): string;
{
  if (getMarkerCount(_mSetEdu) = 0)
  {
    result := 'Не выбрано';
    exit;
  }
  else
    if (getMarkerCount(_mSetEdu) = 1)
    {
      var cTmp: comp = 0;
      GetMarker(_mSetEdu, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько видов (' + string(getMarkerCount(_mSetEdu)) + ')';
}

function isDeptNot4Report(wMode: word; cRecAny : comp) : boolean;
{
  result := isFilterPodr;
  if result //StaffStruct
    if ( wMode = 0 )
    {
      if isValid(#StaffStruct)
        if FoundMarker(mPodr1, StaffStruct.Department) 
          result := false;
    }
    else
    {
      if ( GetFirst AppStaff where((iAppFuncs.GetAppNrec_OnDate(cRecAny, dRep) == AppStaff.NRec)) = tsOk )
        if FoundMarker(mPodr1, AppStaff.Department) 
          result := false;
    }
/*
  result := false;
  if isFilterPodr
    if GetFirst AppStaff where((iAppFuncs.GetAppNrec_OnDate(cRecAny, dRep) == AppStaff.NRec)) = tsOk
      if getfirst StaffApp where((AppStaff.StaffStr == StaffApp.nRec)) = tsOk
        if (not FoundMarker(mPodr1,StaffApp.Department))
          result := true;
*/
}

function isPsnFirstFlag(_sFIO: string[60]; _dBorn: date; iCol : integer) : boolean;
{
  result := true;
  if ( getfirst ttPsnFlags where((_sFIO == ttPsnFlags.sFIO and _dBorn == ttPsnFlags.dBorn)) <> tsOk )
  {
    clearbuffer(#ttPsnFlags);
    ttPsnFlags.sFIO  := _sFIO;
    ttPsnFlags.dBorn := _dBorn;
    ttPsnFlags.isFl[iCol] := false;
    insert current ttPsnFlags;
  }
  if ttPsnFlags.isFl[iCol] = true
    result := false
  else
    update current ttPsnFlags set ttPsnFlags.isFl[iCol] := true;
}

procedure LocateSetRow(sNameOUT : string; sCodeSpcT: string[100]; iColT : integer; dbVal : double);
{
  if not isPsnFirstFlag(PsnEdu.FIO, PsnEdu.BornDate, iColT)
    exit;
  ClearBuffer(#ttStatRK);
  if getfirst ttStatRK where ((sNameOUT==ttStatRK.sNameOU and sCodeSpcT==ttStatRK.sCodeSpc))<>tsOk
  {
    ttStatRK.sNameOU  := sNameOUT;
    ttStatRK.sCodeSpc := sCodeSpcT;
    insert current ttStatRK;
  }
  ttStatRK.dbVal[iColT] += dbVal;
  update current ttStatRK;
}
function LocateSetRowNIOKR(sNameOUT : string; sCodeSpcT: string[100]; iColT : integer; dbVal : double): boolean;
{
  result := false;
  ClearBuffer(#ttStatRK);
  if ( getfirst ttStatRK where ((sNameOUT==ttStatRK.sNameOU and sCodeSpcT==ttStatRK.sCodeSpc)) = tsOk )
  {
    ttStatRK.sNameOU  := sNameOUT;
    ttStatRK.sCodeSpc := sCodeSpcT;
    ttStatRK.dbVal[iColT] += dbVal;
    update current ttStatRK;
    result := true;
  }
}

procedure SetRowSpec(wMode : word; _sColunms: string);
{
  ClearBuffer(#ttSpecRK);
  if ( wMode = 1 or wMode = 2 )
  {
    if ( getfirst CatAny where ((Education.Name == CatAny.nRec)) = tsOk )
      if ( getfirst Persons where((Education.Person == Persons.nRec)) = tsOk )
        if ( getfirst ttSpecRK where ((  iCatFunc.GetCatalogsLongName(Education.Name)   == ttSpecRK.sInst
                                     and iCatFunc.GetCatalogsCode(Education.Speciality) == ttSpecRK.sSpecCode
                                     and Persons.FIO                                    == ttSpecRK.sFIO
                                     )) <> tsOk )
        {
          ttSpecRK.cPsn      := Persons.nRec;
          ttSpecRK.sFIO      := Persons.FIO;
          ttSpecRK.sTypePsn  := Persons.isEmployee;
          ttSpecRK.sVidEdu   := iCatFunc.GetCatalogsName(Education.Level);
          ttSpecRK.dBegEdu   := Education.FromDate;
          ttSpecRK.dEndEdu   := Education.ToDate;
          ttSpecRK.dAppoint  := Persons.AppDate;
          ttSpecRK.sInst     := iCatFunc.GetCatalogsLongName(Education.Name);
          ttSpecRK.sLevelInst:= iCatFunc.GetCatalogsName(CatAny.cParent);
          ttSpecRK.sSpecName := iCatFunc.GetCatalogsName(Education.Speciality);
          ttSpecRK.sSpecCode := iCatFunc.GetCatalogsCode(Education.Speciality);
        }
  }
  if ( wMode = 1 )
  {
    ttSpecRK.dAppoint  := Appointments.AppointDate;
    ttSpecRK.dDismiss  := Appointments.DismissDate;
    ttSpecRK.dDateTo   := Appointments.DateEnd;
    ttSpecRK.sDeptCode := iCatFunc.GetCatalogsCode(Appointments.Department);
    ttSpecRK.sPost     := iCatFunc.GetCatalogsName(Appointments.Post);
  }
  if ( wMode = 2 )
  {
    ttSpecRK.sDeptCode := iCatFunc.GetCatalogsCode(App201.Department);
    ttSpecRK.dBegPract := GP_SPCONTDOC201.DateFrom;
    ttSpecRK.dEndPract := GP_SPCONTDOC201.DateTo;
    ttSpecRK.sPract    := iCatFunc.GetCatalogsName(ContDoc201.cNew3);
    if isvalid(#PartDoc201)
      if isvalid(#TitleDoc201)
        ttSpecRK.sNo201:= TitleDoc201.DocNmb;
  }
  if ( wMode = 3 )
  {
    if getfirst Persons where((DopInfo.cPerson == Persons.nRec)) = tsOk
    {
      ttSpecRK.sFIO      := Persons.FIO;
      ttSpecRK.sTypePsn  := Persons.isEmployee;
      ttSpecRK.dAppoint  := Persons.AppDate;
      if getfirst CatAny where ((DopInfo.cFld[3] == CatAny.nRec)) = tsOk
      {
        ttSpecRK.sInst     := iCatFunc.GetCatalogsLongName(DopInfo.cFld[3]);
        ttSpecRK.sLevelInst:= iCatFunc.GetCatalogsName(CatAny.cParent);
      }
      ttSpecRK.sSpecName := iCatFunc.GetCatalogsName(DopInfo.cFld[2]);
      ttSpecRK.sSpecCode := iCatFunc.GetCatalogsCode(DopInfo.cFld[2]);
    }
    if getfirst AppStaff where((iAppFuncs.GetAppNrec_OnDate(DopInfo.cPerson, dRep) == AppStaff.NRec)) = tsOk
    {
      ttSpecRK.sDeptCode := iCatFunc.GetCatalogsCode(AppStaff.Department);
      ttSpecRK.sPost     := iCatFunc.GetCatalogsName(AppStaff.Post);
    }
    ttSpecRK.dNIOKR    := DopInfo.dFld[1];
    ttSpecRK.fSumNIOKR := DopInfo.fFldSum[1];
  }
  ttSpecRK.sColunms := _sColunms;
  insert current ttSpecRK;
}


procedure MakeRK;
{
  var dbValT       : array [1..2] of double;
  var wRowT        : word;
  var wRowKat      : word;
  var wRowProgramm : word;
  var cRecSST      : comp;
  var i            : integer;
  var isCurSetT    : boolean;
  var sColunmsT    : string;
  var isFirstWork  : boolean;


  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Формируются данные для Листа 13-к (для ВУЗов).', 0);
  if (GetMarkerCount(mPodr1) > 0) isFilterPodr:=true else isFilterPodr:=false;
  set dBeg := date(1,11,Year(dRep)-1);
/*
  cRecTopOU:= iCatFunc.GetCatalogsNRec(-24);
*/
  if (getfirst DopTables where trim(DopTables.sTblName)='НИОКР') = tsOk
    set cNIOKR := DopTables.nRec;
/*
  if getfirst CatAny where((cRecTopOU == CatAny.cParent and sGroupOU == CatAny.Name)) = tsOk
    cRecTopOU:= CatAny.nRec;
  else
    exit;
*/

  if isvalid(#Education)
  _loop Education
  {
//     if ( Education.wType <> 1 ) // пока только с закладки 2
//       continue;
//     if ( getfirst CatAny where((Education.Name == CatAny.nRec)) = tsOk )
//     if ( Education.wType = 1 ) // на будущее
    if not isvalid(#PsnEdu)
      continue;
    if not FoundMarker(mEdu1, Education.Level)
      continue;
//    set iTypeOper := 1
    isFirstWork := false;
    if ( Education.wType = 1 )
      if isvalid(#Appointments)
        _loop Appointments
        {
          if not isvalid(#AppHist)
            continue;
          if isvalid(#ContDoc)
            if not iChRPD.isConfirmed(ContDoc.nRec)
              continue;
          if isDeptNot4Report(0, Appointments.Person)
            continue;
          if ( iCatFunc.GetCatalogsName(PsnEdu.JobNature) <> 'Постоянно' )
            continue;

          sColunmsT := '';
          
          LocateSetRow(iCatFunc.GetCatalogsLongName(Education.Name), iCatFunc.GetCatalogsCode(Education.Speciality), 1, 1);
          sColunmsT += ' '+to_char(4+1);
          if ( Education.ToDate >= dBeg )
          {
            if Appointments.AppointDate <= Education.ToDate
            {
              LocateSetRow(iCatFunc.GetCatalogsLongName(Education.Name), iCatFunc.GetCatalogsCode(Education.Speciality), 4, 1);
              sColunmsT += ' '+to_char(4+4);
            }
            if Appointments.AppointDate <= Education.ToDate and (Education.ToDate >= dBeg and Education.ToDate <= dRep)
            {
              LocateSetRow(iCatFunc.GetCatalogsLongName(Education.Name), iCatFunc.GetCatalogsCode(Education.Speciality), 5, 1);
              sColunmsT += ' '+to_char(4+5);
              isFirstWork := true;
            }
            if ( isFirstWork and Appointments.LPrizn = 0 )
              if Appointments.AppointDate >= Education.ToDate and (Education.ToDate >= dBeg and Education.ToDate <= dRep)
              {
                LocateSetRow(iCatFunc.GetCatalogsLongName(Education.Name), iCatFunc.GetCatalogsCode(Education.Speciality), 6, 1);
                sColunmsT += ' '+to_char(4+6);
              }
          }
          SetRowSpec(1, sColunmsT);
        }

    if ( Education.ToDate >= dBeg )
      if isvalid(#GP_SPCONTDOC201)
      _loop GP_SPCONTDOC201
        if isvalid(#ContDoc201)
        {
          if iChRPD.isConfirmed(ContDoc201.nRec)
          if isvalid(#App201)
          {
            sColunmsT := '';
            if isDeptNot4Report(1, App201.Person) continue;
            //ContDoc.cNew3               == CatPractType.NRec  
//            if Education.ToDate > dRep and (GP_SPCONTDOC201.DateTo >= dBeg and GP_SPCONTDOC201.DateTo <= dRep)
            if (GP_SPCONTDOC201.DateTo >= dBeg and GP_SPCONTDOC201.DateTo <= dRep)
            {
              LocateSetRow(iCatFunc.GetCatalogsLongName(Education.Name),iCatFunc.GetCatalogsCode(Education.Speciality),2,1);
              sColunmsT += ' '+to_char(4+2);
              if ( iCatFunc.GetCatalogsName(ContDoc201.cNew3) = 'Преддипломная' )
              {
                LocateSetRow(iCatFunc.GetCatalogsLongName(Education.Name),iCatFunc.GetCatalogsCode(Education.Speciality),3,1);
                sColunmsT += ' '+to_char(4+3);
              }
            }
/*
            if (Education.ToDate > dRep and Education.ToDate <= To_Date(1,11,Year(dRep)+1)) and (GP_SPCONTDOC201.DateTo >= dBeg and GP_SPCONTDOC201.DateTo <= dRep)
              if ( iCatFunc.GetCatalogsName(ContDoc201.cNew3) = 'Преддипломная' )
              {
                LocateSetRow(iCatFunc.GetCatalogsLongName(Education.Name),iCatFunc.GetCatalogsCode(Education.Speciality),3,1);
                sColunmsT += ' '+to_char(4+3);
              }
*/
            SetRowSpec(2, sColunmsT);
          }
        }
  }
  if isvalid(#DopInfo)
  _loop DopInfo
  {
/*
    if getfirst CatAny where((DopInfo.cFld[3] == CatAny.nRec)) = tsOk
      if CatAny.cParent <> cRecTopOU
        continue;
*/
    sColunmsT := '';
    if isDeptNot4Report(1, DopInfo.cPerson) continue;
    LocateSetRowNIOKR(iCatFunc.GetCatalogsLongName(DopInfo.cFld[3]),iCatFunc.GetCatalogsCode(DopInfo.cFld[2]),7,1);
    sColunmsT += ' '+to_char(4+7);
    if LocateSetRowNIOKR(iCatFunc.GetCatalogsLongName(DopInfo.cFld[3]),iCatFunc.GetCatalogsCode(DopInfo.cFld[2]),8,DopInfo.fFldSum[1])
    {
      sColunmsT += ' '+to_char(4+8);
      SetRowSpec(3, sColunmsT);
    }
  }
  StopVisual;
}

function isDataRK : boolean;
{
  if isvalid(#ttStatRK)
    result := true
  else
    result := false;
}

procedure FillSpc;
{
  var sCodeSpcT : string[100] = '';
  var i : integer = 2;
  if xlSetActiveSheetByName('УЗиНП')
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Синхронизирую список специальностей для Листа 13-к (для ВУЗов).', 0);
    do
    {
      if (not NextVisual) break;
      xlGetCellValue(i,3,sCodeSpcT);
      if trim(sCodeSpcT) <> ''
      {
        clearbuffer(#tt13SpecRK);
        tt13SpecRK.sCodeSpc := trim(sCodeSpcT);
        tt13SpecRK.iRow := i;
        insert current tt13SpecRK;
      }
      i++;
    } while trim(sCodeSpcT) <> '';
    StopVisual;
  }
}
procedure FillOU;
{
  var sOUT : string = '';
  var i : integer = 2;
  if xlSetActiveSheetByName('Перечни')
  {
    StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Синхронизирую список ОУ для Листа 13-1-к (для ССУЗов).', 0);
    do
    {
      if (not NextVisual) break;
      xlGetCellValue(i, 3, sOUT);
      if ( trim(sOUT) <> '' )
      {
        clearbuffer(#tt13OURK);
        tt13OURK.sOU := trim(sOUT);
        insert current tt13OURK;
      }
      i++;
    } while ( trim(sOUT) <> '' );
    StopVisual;
  }
}

procedure SetCodeSpcCell(iRowT : integer);
{
  if getfirst tt13SpecRK where((ttStatRK.sCodeSpc == tt13SpecRK.sCodeSpc)) = tsOk
  {
    if xlSetActiveSheetByName('УЗиНП')
      xlCopyToBuff(tt13SpecRK.iRow,3,tt13SpecRK.iRow,3);
    if xlSetActiveSheetByName('13-к (для ВУЗов)')
      xlPasteAllFromBuff(iRowT,3,iRowT,3);
  }
}
function isCodeSpcCell(_sCodeSpc: string): boolean; cacheable;
{
  result := false;
  if ( getfirst tt13SpecRK where((_sCodeSpc == tt13SpecRK.sCodeSpc)) = tsOk )
    result := true;
}
function isOUCell(_sOU: string): boolean; cacheable;
{
  result := false;
  if ( getfirst tt13OURK where((_sOU == tt13OURK.sOU)) = tsOk )
    result := true;
}


procedure PrintRK;
{
//  var dbValT  : array [1..2] of double;
  var i : integer;
  var iRow : integer = 7;

  if isDataRK
  {
    FillSpc;
    FillOU;
    if xlSetActiveSheetByName('13-к (для ВУЗов)')
    {
      StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Выгружаю данные для Листа 13-к (для ВУЗов) в Excel.', 0);
      TOA.Bind(0);
      xlSetCellStringValue(Trim(TOA1.GetNaming.GetFullName()),2,3,2,3);
////    xlSetCellStringValue(DateToStr(dRep,'DD.MM.YYYY'),3,3,3,3); // в представленном заказчиком файле такая дата красная.
      xlSetCellDateValue(dRep,3,3,3,3);
      _loop ttStatRK  ordered index ttStatRK01
      {
        xlSetCellStringValue(ttStatRK.sNameOU, iRow,2,iRow,2); 
        SetCodeSpcCell(iRow);
////      xlSetNumberFormat('@',iRow,3,iRow,3);
//        xlSetCellStringValue(' ',iRow,3,iRow,3); 
//        xlAddCellStringValue(ttStatRK.sCodeSpc,iRow,3); 
        for(i:=1;i<=12;i++)
        {
          if (not NextVisual) break;
          xlSetCellNumberValue(ttStatRK.dbVal[i],iRow,4+i,iRow,4+i); 
        }
        iRow++;
      }
  
      StopVisual;
    }
  }
}
/*
  sNameOU : string
, sCodeSpc: string[100]
, dbVal : array [1..12] of double
*/
procedure SaveRK;
{
  iUDR.SaveMarker('RKS13V_mPodr1', mPodr1);
  iUDR.SaveMarker('RKS13V_mEdu1' , mEdu1 );
  DoneMarker(mPodr1, '');
  DoneMarker(mEdu1 , '');
  iUDR.SaveDate  ('RKS13V_dRep'        , dRep        );
  iUDR.SaveWord  ('RKS13V_wToExistFile', wToExistFile);
  iUDR.SaveString('RKS13V_sToExistFile', sToExistFile);
  iUDR.SaveWord  ('RKS13V_wPrintRash'  , wPrintRash  );
}
procedure ClearRK;
{
  delete all from ttStatRK;
}
procedure initRK;
{
  set dRep := iUDR.ReadDate('RKS13V_dRep');
  if dRep = 0
    set dRep := To_Date(31,10,Year(Cur_Date));
  
  set wPrintRash   := iUDR.ReadWord  ('RKS13V_wPrintRash'  );
  set sToExistFile := iUDR.ReadString('RKS13V_sToExistFile');
  set wToExistFile := iUDR.ReadWord  ('RKS13V_wToExistFile');
  if wToExistFile = 1 
    ToggleFieldVisible(#sToExistFile,true )
  else
    ToggleFieldVisible(#sToExistFile,false);

  mPodr1     := iUDR.ReadMarker('RKS13V_mPodr1');
  set sPodr1 := sSetPodrName(mPodr1);
  mEdu1      := iUDR.ReadMarker('RKS13V_mEdu1');
  set sEdu1  := sSetEduName(mEdu1);
}

function isCheckRepParam(isStayAlone : boolean) : boolean;
{
  result := false;
  if dRep = 0
  {if isStayAlone message('Не задана дата!'); exit;}
  if Day(dRep) <> 30 and Month(dRep) <> 10
  {if isStayAlone message('Некорректно задана дата!'+chr(13)+'Дата формирования отчета - 30 октября.', Error ); exit;}
  if wToExistFile = 1
  if not ExistFile(sToExistFile)
  {if isStayAlone message('Ошибка открытия файла!'); exit;}
  if ( getMarkerCount(mEdu1) = 0 )
  {if isStayAlone message('Не заданы виды образования!', Error); exit;}
  result := true;
}
