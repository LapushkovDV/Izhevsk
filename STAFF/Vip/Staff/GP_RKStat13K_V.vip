window WinRKParamEx 'Параметры формирования. Лист 13-к (для ВУЗов).' Gray;
  show at (,,95,12);
Screen sEx(,,sci1Esc);
  fields
    dRep   ('Дата формирования'): {Font = {BackColor = if(dRep = 0, ColorNeed, 0)}}, noprotect;
    sPodr1 ('Выбранные подразделения',hcStaffAppDepartment,sci13Esc): {Font = {BackColor = if(sPodr1 = 'Не выбраны подразделения', ColorNeed, 0)}},Protect, PickButton ;
    sEdu1  ('Выбранные образования',hcStaffAppDepartment,sci13Esc): {Font = {BackColor = if(sEdu1 = 'Не выбрано', ColorNeed, 0)}},Protect, PickButton ;
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
<< 'Параметры отчета'

 `Дата формирования       `.@@@@@@@@@@@
 `Подразделения для отчета`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Виды образований        `.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

   <. ~С~охранить .>                                                        <. ~З~акрыть .>
>>
end;
HandleEvent
  cmOK:
  {
    SaveRK;
    initRK;
    if not isCheckRepParam(true)
      exit;
    CloseWindowEx(CurWindow,cmDefault);
  }
  cmCancel:
  {
    SaveRK;
    CloseWindowEx(CurWindow,cmCancel);
  }
end;
end;//WinRKParamEx
