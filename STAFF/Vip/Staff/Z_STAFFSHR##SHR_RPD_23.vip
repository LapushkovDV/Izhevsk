#include AttrTablePick.vih
#include LinkSHRVac.vih

#include GP_SetWorkCondToOrder.vih
#include GP_ManualNotes.vih

#component "Z_StaffSHR"
#doc
  Приказ по ШР "Изменение атрибутов ставки" (РПД-23)
  <p>#1469
#end

Alter Interface SHR_RPD_23;
overload
  Procedure ISHR_RPD_Base.EnableDisable;
  function ISHR_RPD_Base.CheckCurrOrder: boolean;
  function ISHR_RPD_Base.ConfirmCurrOrder: boolean;
  function ISHR_RPD_Base.DeleteCurrOrder: boolean;
end;

OverloadFormats brStr;
ExtendFormats scrDet23;

var iSHRVac : LinkSHRVac new;
    cAttrBossPost,cAttrBossPostSHR,cAttrNote:comp;
    oAttrTablePick:AttrTablePick;
    oManualNotes:GP_ObjManualNotes(GP_ManualNotes) New;

create view
from
   oManualNotes
  ,StaffStruct StaffStrForVac
  ,VacationSts
  ,VacationAlg
  ,VacationSts VacationSts_New
  ,VacationAlg VacationAlg_New
where((
  StrCont.cRef  == StaffStrForVac.NRec
  and StrCont.cStr     == VacationSts.cStaffStruct
  and VacationSts.Nrec == VacationAlg.cVacationSts
  and StrCont.cRef     == VacationSts_New.cStaffStruct
  and VacationSts_New.Nrec == VacationAlg_New.cVacationSts
  and VacationSts.cKotPus  == VacationSts_New.cKotPus

  and coStaffStruct==oManualNotes.wTbl
  and StrCont.cStr==oManualNotes.cRec
));

// Получить функционального руководителя
Function GetBossPost:string;
{
  Case StrPart.wCodOper of
    123,124:{
      Result:=sGetAttrID(coStaffStruct, StrCont.cStr, cAttrBossPostSHR);
    }
    else {
      Result:=sGetAttrID(coStrCont, StrCont.NRec, cAttrBossPost);
    }
  end;
}

browse brStr (, hcStaffWinStrPr);
table StrCont;
fields
  browseOrder '№':[1];
  Podr.Name   'Структурное подразделение' ('Наименование структурного подразделения',, sci1378Esc): [35], protect;
  Podr.Code   'Код' ('Код структурного подразделения',, sci1378Esc): [15], protect;
  Podr.DatN   'Дата введения' ('Дата введения структурного подразделения',, sci178Esc): [15], protect, noAutoSize;
end;

screen scrDet23 (, hcStaffWinStrPr, scStaffMyPnl); // изменение атрибутов ставки
table HistoryStr;
fields
  [BossPost] GetBossPost()
    ('Должность функционального руководителя',,scStaffMyPnlPick):protect,
    {Font={BackColor=if(BossPost='',ColorNeed,
                        if(BossPost<>sGetAttrID(coStaffStruct,StrCont.cStr,cAttrBossPostSHR),ColorSysAqua,0))}};
  [ExtAttrNote] sGetAttrID(coStrCont,StrCont.NRec,cAttrNote)
    ('Примечание ручное',,):noprotect;
buttons
  cmValue6,,, 'Выбрать полагающееся отпуска',, sci1Esc;
<<











`Должность функционального руководителя`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@


 Примечание руч. .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

                                                              <.Привязка отпусков.>
>>
end;

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  inherited::EnableDisable;

  ToggleFieldSelectable(fnBossPost,StrTitle.wStatus=0);
  ToggleFieldSelectable(fnExtAttrNote,StrTitle.wStatus=0);

  if (StrTitle.wStatus=0)
    EnableCommand(cmValue6)
  else
    DisableCommand(cmValue6);
}

//******************************************************************************
// Функция проверки корректности заполнения приказа
//******************************************************************************
function CheckCurrOrder: boolean;
{
  result:=inherited::CheckCurrOrder;

  case StrPart.wCodOper of
    123,124:{}
    else {
      if (coGetAttrID(coStrCont,StrCont.NRec,cAttrBossPost)=0)
      and bogettune('NPOEM_OWN.EM_UUK.NEED_DOLJNOST_RUKOVODITELYA'){
        SetOrderMsg('Не указана должность функционального руководителя.');
        result := false;
      }
    }
  end;

  if (not IsValidAll(tnSSDopAttrCat))
  and bogettune('NPOEM_OWN.EM_UUK.NEED_DOPHARAKTERISTIKA') {
    SetOrderMsg('Не указана дополнительная характеристика.');
    result := false;
  } else {
//АУП Административно управленческий персонал
//  АП (Административный персонал)
//    Руководители
//    Специалисты
//    Служащие
//  ЦП Цеховой персонал (кроме ИТР)
//    Руководители
//    Специалисты
//    Служащие
/*так кодить нельзя!

Комментирую, т.к. надо работать

Что сделать: сделать таблицу соответствия категорий и доп характереистик


    if SSDopAttrCat.code = 'АУП АП'
    {
      if getfirst KlKatego where ((HistoryStr.CSPR2 == KlKatego.Nrec)) = tsok
      {
        if klkatego.kod = 5 or klkatego.kod = 6 or klkatego.kod = 7 {}
        else
        {
          SetOrderMsg('Дополнительная характеристика не соответствует категории.');
          result := false;
        }
      }
    }

    if SSDopAttrCat.code = 'АУП ЦП'
    {
      if getfirst KlKatego where ((HistoryStr.CSPR2 == KlKatego.Nrec)) = tsok
      {
        if klkatego.kod = 5 or klkatego.kod = 6 or klkatego.kod = 7 {}
        else
        {
          SetOrderMsg('Дополнительная характеристика не соответствует категории.');
          result := false;
        }
      }
    }

    if SubStr(SSDopAttrCat.code, 1, 3) = 'ИТР'
    {
      if getfirst KlKatego where ((HistoryStr.CSPR2 == KlKatego.Nrec)) = tsok
      {
        if klkatego.kod = 5 or klkatego.kod = 6 {}
        else
        {
          SetOrderMsg('Дополнительная характеристика не соответствует категории.');
          result := false;
        }
      }
    }
    //Если выбрана доп.характеристика с кодом "ПНС", то код категории должности должен быть: 4, или 5, или 6, или 7.
    if SubStr(SSDopAttrCat.code, 1, 3) = 'ПНС'
    {
      if getfirst KlKatego where ((HistoryStr.CSPR2 == KlKatego.Nrec)) = tsok
      {
        if klkatego.kod = 4 or klkatego.kod = 5 or klkatego.kod = 6 or klkatego.kod = 7 {}
        else
        {
          SetOrderMsg('Дополнительная характеристика не соответствует категории.');
          result := false;
        }
      }
    }

    if SSDopAttrCat.code = 'ОР'
    {
      if getfirst KlKatego where ((HistoryStr.CSPR2 == KlKatego.Nrec)) = tsok
      {
        if klkatego.kod = 1 {}
        else
        {
          SetOrderMsg('Дополнительная характеристика не соответствует категории.');
          result := false;
        }
      }
    }

    if SSDopAttrCat.code = 'ПР'
    {
      if getfirst KlKatego where ((HistoryStr.CSPR2 == KlKatego.Nrec)) = tsok
      {
        if klkatego.kod = 3 {}
        else
        {
          SetOrderMsg('Дополнительная характеристика не соответствует категории.');
          result := false;
        }
      }
    }

    if SSDopAttrCat.code = 'ВР'
    {
      if getfirst KlKatego where ((HistoryStr.CSPR2 == KlKatego.Nrec)) = tsok
      {
        if klkatego.kod = 2 or klkatego.kod = 4 {}
        else
        {
          SetOrderMsg('Дополнительная характеристика не соответствует категории.');
          result := false;
        }
      }
    }
    */
  } //if (not IsValidAll(tnSSDopAttrCat)) {
} //function CheckCurrOrder: boolean;

function CopyAttrComp(wTblSrc:word;cRecSrc,cIDSrc:comp;wTblDst:word;cRecDst,cIDDst:comp):boolean;
var cVal:comp;
    sVal:string;
{
  result:=false;
  if (wTblSrc=0 or cRecSrc=0 or cIDSrc=0 or wTblDst=0 or cRecDst=0 or cIDDst=0) exit;

  cVal:=coGetAttrID(wTblSrc,cRecSrc,cIDSrc);
  sVal:=sGetAttrID(wTblSrc,cRecSrc,cIDSrc);

  result:=coSetAttrID(wTblDst,cRecDst,cIDDst,cVal,sVal);
}

//******************************************************************************
//  Процедура утверждения приказа по текущему работнику (по таблице StrCont)
//******************************************************************************
function ConfirmCurrOrder: boolean;
{
  result:=inherited::ConfirmCurrOrder;
  if (not result) exit;

  if(StrPart.wCodOper=23)
    result:=CopyAttrComp(coStrCont,StrCont.NRec,cAttrBossPost,coStaffStruct,StrCont.cStr,cAttrBossPostSHR);

  if (result and StrCont.cCont1<>0) {
    //проверим настройку и скопируем внешние атрибуты
    if boGetTune('UP.STAFF.AttrCopy_SHR')//Синхронизировать внешние атрибуты в ШР с историей ШР
      iAttrCopy.UpdateArrt(StrCont.cStr, StrCont.cCont1, CoStaffStruct, CoHistoryStr);
  }

  if (result and StrCont.cRef<>0) {//Привязка отпусков
    // Закроем отпуска при наличии
    _Loop fullcache VacationSts
    { if getfirst VacationSts_New=tsok
      { update current VacationStS
          set VacationStS.dEndExist:=Sub_Day(HISTORYSTR.DHIST,1);
        update current VacationStS_New
          set VacationStS_New.dBegExist:=HISTORYSTR.DHIST;
      }
    } //_Loop fullcache VacationSts
    iSHRVac.pVacationLink(StrCont.cRef, StrCont.cStr);
    delete StaffStrForVac where((StrCont.cRef==StaffStrForVac.NRec));
    StrCont.cRef:=0;
    update current StrCont;
  }

  oManualNotes.UpdateFirstRec(coStaffStruct,StrCont.cStr,ExtAttrNote);
}

function DeleteCurrOrder: boolean;
{
  if (StrCont.cRef<>0) {//Привязка отпусков
    iSHRVac.pVacationDelete(StrCont.cRef);
    delete StaffStrForVac where((StrCont.cRef==StaffStrForVac.NRec));
  }

  result:=inherited :: DeleteCurrOrder;
}

procedure InitStaffStrForVac;
{
  if (StrCont.cRef<>0) exit;

  ClearBuffer(tnStaffStrForVac);
  StaffStrForVac.LastUser := '1';
  insert current StaffStrForVac;

  StrCont.cRef:=StaffStrForVac.NRec;
  update current StrCont;
}

//**********************************************
// события интерфейса
//**********************************************
HandleEvent
//------------------------------
cmOnVipLoad:{
  timelog_Init;
  timelog('SHR_RPD_23->cmOnVipLoad');

  cAttrBossPost:=ExtAttr_CreateComp(coStrCont,'Должность функционального руководителя',
                                         cgAttrType_Comp,cgKatKau_System,coStaffStruct);
  cAttrBossPostSHR:=ExtAttr_CreateComp(coStaffStruct,'Должность функционального руководителя',
                                            cgAttrType_Comp,cgKatKau_System,coStaffStruct);

  cAttrNote:=ExtAttr_Create(coStrCont,'Примечание',cgAttrType_Str);

  case inherited :: handleEvent (cmOnVipLoad) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  cfsSetExtProp('i_SCRDET23_HISTSISOPL.NASISOPL',cfpFontBackColor,if(StaffStruct.PayModel<>HistoryStr.wPayModel,ColorSysAqua,0));
  cfsSetExtProp('i_SCRDET23_HISTORYSTR.HTAXRATE',cfpFontBackColor,if(StaffStruct.TaxRate<>HistoryStr.HTaxRate,ColorSysAqua,0));
  cfsSetExtProp('i_SCRDET23_HISTORYSTR.HMAXTAXRATE',cfpFontBackColor,if(HistoryStr.HMaxTaxRate<>StaffStruct.MaxSumma,ColorSysAqua,0));
  cfsSetExtProp('i_SCRDET23_HISTORYSTR.HMINTAXRATE',cfpFontBackColor,if(HistoryStr.HMinTaxRate<>StaffStruct.MinSumma,ColorSysAqua,0));
  cfsSetExtProp('i_SCRDET23_HISTKLREJIM.NREJIM',cfpFontBackColor,if(HistoryStr.cWorkRegim<>StaffStruct.WorkRegime,ColorSysAqua,0));
  cfsSetExtProp('i_SCRDET23_HISTWORKCOND.NAME',cfpFontBackColor,if(StaffStruct.WorkCond<>HistoryStr.cWorkCond,ColorSysAqua,0));
  cfsSetExtProp('i_SCRDET23_KLKATEGO.NAIKAT',cfpFontBackColor,if(HistoryStr.cSpr2<>StaffStruct.EmpCategory,ColorSysAqua,0));
  cfsSetExtProp('i_SCRDET23_OSOB_USL',cfpFontBackColor,if(HistoryStr.cRez2<>AKps.GetStaffStrMainKPS(StaffStruct.NRec),ColorSysAqua,0));
  cfsSetExtProp('i_SCRDET23_HISTORYSTR.DFLD',cfpFontBackColor,if(HistoryStr.dFld<>StaffStruct.dNew1,ColorSysAqua,0));
  cfsSetExtProp('i_SCRDET23_SSDOPATTRCAT.NAME',cfpFontBackColor,if(HistoryStr.cSpr3=0,ColorNeed,if(HistoryStr.cSpr3<>StaffStruct.cInf3,ColorSysAqua,0)) );
}
//------------------------------
cmExprFieldChanged:{
  case inherited :: handleEvent (cmExprFieldChanged) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnExtAttrNote:{
      if (ExprFieldValue='')
        ExtAttr_DeleteValueID(coStrCont,StrCont.NRec,cAttrNote)
      else
        sSetAttrID(coStrCont,StrCont.NRec,cAttrNote,ExprFieldValue);
    }
  end;
}
//------------------------------
cmPick:{
  var cStaffStruct:comp=StrCont.cStr;

  case CurField of
    #HistWorkCond.Name:{
      if (HISTORYSTR.DHIST)=ZeroDate
      { message('Не заполнено поле "Дата изменения"'+chr(13)+
                'Изменение "Условия запрещено"');
        abort;
        Exit;
      }
    }
  end;

  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnBossPost:{
      if (oAttrTablePick.PickValue(coStrCont, cAttrBossPost, StrCont.NRec))
        set BossPost;
    }
    #PostCat.Name:{
      if (CopyAttrComp(coStaffStruct,StrCont.cStr,cAttrBossPostSHR,coStrCont,StrCont.NRec,cAttrBossPost))
        set BossPost;

      if (StrCont.cStr<>0 and StrCont.cStr <> cStaffStruct)
        if (getfirst oManualNotes where((coStaffStruct==oManualNotes.wTbl and StrCont.cStr==oManualNotes.cRec))=tsok)
          if (sSetAttrID(coStrCont,StrCont.NRec,cAttrNote,oManualNotes.NoteStr))
            set ExtAttrNote;

      //Нужно скопировать отпуска
      InitStaffStrForVac;
    }
    #HistWorkCond.Name:{//Условия труда
      if (HistoryStr.cWorkCond<>0 and IsFieldModified(#HistoryStr.cWorkCond))
      {  timelog('SHR_RPD_23->cmPick->#HistWorkCond.Name');

        InitStaffStrForVac;
        var SetWorkCond:GP_SetWorkCondToOrder;
        SetWorkCond.RunForRPD23(HistoryStr.buffer,StaffStruct.buffer,StrPart.cDoc,StrCont.cCatStr,StrCont.cRef);
        set HistoryStr.cWorkRegim;
        OnIdle(StrCont.NRec);
      }
    }
  end;
}
//------------------------------
cmCheckField:
{ case CurField of
  #HistoryStr.HTaxRate:
  {
#IFDEF _GP_
// разблокируем ручное изменение оклада
#ELSE
          if ( HistoryStr.cTariff <> 0 ) // есть тарифная сетка
            if ( double(OldFieldValue) <> HistoryStr.HTaxRate )
            {
              Message('С привязкой к тарифной сетке оклад можно изменить только посредством корректирующих коэффициентов,'#13 +
                      'либо отвязав его от тарифной сетки.', Information);
              set HistoryStr.HTaxRate := double(OldFieldValue);
              abort;
            }
#ENDIF
          SetModified(true);
  }
  else
  { case inherited :: handleEvent (cmCheckField) of
     heAbort:{abort;exit;}
     heStop:{stop;exit;}
     end;
  }
  end;
}
//------------------------------
cmDelOnProtect:{
  if StrTitle.wStatus > 0
    {
      abort;
      exit;
    }

  case CurField of
    fnBossPost:{
      ExtAttr_DeleteValueID(coStrCont,StrCont.NRec,cAttrBossPost);
      set BossPost;
    }
  end;

  case inherited :: handleEvent (cmDelOnProtect) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
cmValue6:{//Привязка отпусков
  InitStaffStrForVac;

  // может скопировать?
  if getfirst VacationStS=tsok {}

  iSHRVac.pSetValidOtp(StrCont.cRef);
  iSHRVac.pRunWindow;
}
end;

end.
