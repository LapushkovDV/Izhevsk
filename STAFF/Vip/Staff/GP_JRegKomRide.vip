/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*         "Журнал регистрации и учета компенсации стоимости проезда к месту работы и обратно (ЭМ)"*
* Контур/Модуль: Кадры                                                                            *
* Примечание:    Отчеты пользователя                                                              *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#248          |01/06/17|Потапов А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/
/*
Разработка изначально была рассчитана на выборку данных из приказов по РПД 102 и 103
разнообразно связанных между собой или не связанных (по сотруднику и периоду дат).
Потом заказчиком было принято решение приказы с РПД 103 отменить.
Соответственно данные по ним в разработке стали не нужны.
Весь код касающийся отбора данных и вывода на печать по РПД 103 убран в комментарии.
При необходимости вернуть все назад - раскомментарить.
*/

#include UserReport.vih
#include ComFiltr.vih
#include CatFunc.vih
#include RunStaj.vih
#include GP_3GD.vih
#include GP_AppChange.vih
#include GP_XlOutExt.vih

#define GPInt GP_JRegKomRide // #(GPInt)
#define GPNam Журнал регистрации и учета компенсации стоимости проезда к месту работы и обратно // #(GPNam)

Interface #(GPInt) '#(GPNam) (ЭМ)' EscClose, Gray;
  show (,,86,14);

const
#include Excel.inc;
end;

table struct ttPerFlt // для фильтра по персоналу
(
  cRecPers : comp
)
with index
(
  ttPerFlt01  = cRecPers
);

table struct ttTypOp // для фильтра по РПД
(
  wCodeOper : word
, sNameOper : string
)
with index
(
  ttTypOp01 = wCodeOper
);

table struct ttResStr // данные для отчета
(
  nRec      : comp
, cRecPers  : comp
, cAppPers  : comp
, d102Beg   : date
, d102End   : date
, sTbNmb    : string    //02
, sFIO      : string    //03
, sDept     : string    //04
, sDepP     : string    //05
, sPost     : string    //06
, sKomp     : string    //07
, sKomC     : string
, lVOpl     : longint
, sStaj     : string    //08
, sTrud     : string    //09
, sDopS     : string    //10
, dDopS     : date      //11
, dDopSrok  : date      //12
, dImpl     : date      //13
, dbSumK    : double    //14
, sPrik     : string    //15
, sIsCh     : string    //16
)
with index
(
  ttResStr00 = nRec(Surrogate)
, ttResStr01 = cRecPers + sKomC + dDopS
, ttResStr02 = sFIO + dDopS
, ttResStr03 = cAppPers + d102Beg + d102End
);

table struct ttPers
(
  cRecPsn : comp,
  sFIO    : string
)
with index
(
  ttPers00 = cRecPsn
, ttPers01 = sFIO
);

table struct ttSumOpl
(
  cRecPsn : comp
, sVOpl   : string
, lVOpl   : longint
, wYear   : word
, wMonth  : word
, dbSum   : double
)
with index
(
  ttSumOpl01 = cRecPsn + lVOpl + wYear + wMonth 
, ttSumOpl02 = cRecPsn + sVOpl + wYear + wMonth 
);
table struct ttVidOpl
(
  cRecPsn : comp
, sVOpl   : string
, lVOpl   : longint
)
with index
(
  ttVidOpl01 = cRecPsn + lVOpl
);

var
  dBeg, dEnd    : date;
  VCommonFiltr  : CommonFiltr; // Для встраивания фильтра по подразделениям / сотрудникам
  MadeReport    : boolean;
  cPersNRec     : comp;
  PersMarker    : TPtr; // маркер по commonfilter
  RPDMarker     : TPtr; // маркер по РПД
  iCatFunc      : CatalogsFunctions; // каталоги
  iRunStaj      : Runstaj;
  i3GD          : GP_3GD;
  iAppCh        : GP_AppChange;
  iOut          : GP_XlOutExt;
  sFullName     : string;
  sRPD          : string;
  wRPD          : word;
  lRB, lRE,
  lCB, lCE,
  lSB, lSE,
  lDB, lDE,
  lRow          : longint;
  wTypOper      : word;
  iRowB, iRowE,
  iNPP          : integer;

create view
var
  cPersOpl : comp;
  lVidOpl  : longint;
from
  persons
, appointments
, appointments appfirst
//, appointments AppFort  //103
//, Fortune               //103
//, ContDoc  ContFort     //103
//, PartDoc  PartFort     //103
//, TitleDoc TitleFort    //103
, raisehist
, raise
, TYPEPR
, ttPerFlt
, ttResStr
, ttTypOp
//, ttTypOp  ttTypOpFort  //103
, ttPers
, ttSumOpl
, ttVidOpl
, KlVidOpl
, contdoc
, SpAllStaff SpAS_Cnt
, SpAllStaff SpAS_Agr
, SumVidOp
where
((
       ttPerFlt.cRecPers == persons.nrec
and persons.APPOINTFIRST == appfirst.nrec
and    ttPerFlt.cRecPers == raisehist.CPSN and (raisehist.DOCDATE >= dBeg and raisehist.DOCDATE <= dEnd)
and     raisehist.cRaise == raise.nrec
and   raisehist.cContDoc == contdoc.nrec
and     contdoc.TypeOper == ttTypOp.wCodeOper
and         contdoc.cStr == appointments.nrec
and                    7 == SpAS_Cnt.wNoCon  //Ищем ссылку на допсоглашение отображаемое непосредственно в приказе
and         contdoc.NRec == SpAS_Cnt.CLINKT  //независимо от того что в карточке
and                    0 == SpAS_Cnt.INUM    //допсоглашение из карточки устарело?
and            coContDoc == SpAS_Cnt.WCHOISE //vipinterface NumberOfAddAgreement не осилил
and      SpAS_Cnt.cBaseT == SpAS_Agr.nRec
//-----------------------------------------------------------------------------------------------------------
and           year(dBeg)<<= SumVidOp.YearN and (year(dEnd) >= SumVidOp.YearN and cPersOpl = SumVidOp.TPerson /*and lVidOpl = SumVidOp.VIDOPL*/)
//-----------------------------------------------------------------------------------------------------------
//103
/*
and    ttPerFlt.cRecPers == Fortune.cPers and (Fortune.DOCDATE >= dBeg and Fortune.DOCDATE <= dEnd)
and       Fortune.cFCont == ContFort.nRec
and    ContFort.TypeOper == ttTypOpFort.wCodeOper
and        ContFort.cStr == AppFort.nrec
and       ContFort.cPart == PartFort.nRec
and        PartFort.cDoc == TitleFort.nRec
*/
))
;

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

procedure Run;
{
  var kol, i    : integer;
  var cPersNRec : comp;
  var sR2I      : string;
  var sCT, sNT  : string;
//  var dbTotalIt : double;
  var dDatDopSog: date;
  var sNomDopSog: string;

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);

  if (VCommonFiltr.GetPsnCount = 0)
    VCommonFiltr.SelectAllPsn;

  // набиваем маркер из commonfulter
  PersMarker := InitMarker('#(GPInt)_PSN_'+UserName(),8,200,100);
  PersMarker := VCommonFiltr.GetPersonsMarker;
  kol:=  GetMarkerCount(PersMarker);
  i := 0;
  while i < kol
  {
    GetMarker(PersMarker, i, cPersNRec);
    insert ttPerFlt set ttPerFlt.cRecPers := cPersNRec;
    i++;
    if (not NextVisual) break;
  }
  
  // заполняем табличку ttResStr данными для отчета
  if isvalid(#ttPerFlt)
  _loop ttPerFlt
  {
    if isvalid(#RaiseHist)
    _loop RaiseHist
    {
      // проверяем утвержден ли приказ и корректность РПД
      if isvalid(#Raise) 
      if isvalid(#contdoc)
      if isvalid(#ttTypOp)
      if raise.OrderDate1 = RaiseHist.DOCDATE and raise.OrderDate2 = 0
      {
        if isvalid(#persons)
        {
          if getfirst ttPers where((persons.nrec == ttPers.cRecPsn)) <> tsOk
          {
            clearbuffer(#ttPers);
            ttPers.cRecPsn := persons.nrec;
            ttPers.sFIO := persons.fio;
            insert current ttPers;
          }
          if (not NextVisual) break;
          clearbuffer(#ttResStr);
          ttResStr.cRecPers := persons.nrec;
          ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
          ttResStr.sFIO     := persons.FIO;
          if isvalid(#appointments)
          {
            ttResStr.sDept  := iCatFunc.GetCatalogsCode(appointments.DEPARTMENT);
            ttResStr.sPost  := iCatFunc.GetCatalogsName(appointments.POST);
            ttResStr.sDepP  := i3GD.sCode3GD(appointments.DEPARTMENT);
          }
          ttResStr.sKomp    := iCatFunc.GetCatalogsName(RaiseHist.cRaiseType);
          ttResStr.sKomC    := iCatFunc.GetCatalogsCode(RaiseHist.cRaiseType);
          ttResStr.lVOpl    := longint(Trim(iCatFunc.GetCatalogsCatData(RaiseHist.cRaiseType)));
          if getfirst ttVidOpl where((ttPers.cRecPsn == ttVidOpl.cRecPsn and ttResStr.lVOpl == ttVidOpl.lVOpl)) <> tsOk
          {
            clearbuffer(#ttVidOpl);
            ttVidOpl.cRecPsn := ttPers.cRecPsn;
            ttVidOpl.lVOpl   := ttResStr.lVOpl;
            if getfirst KlVidOpl where ((ttResStr.lVOpl == KlVidOpl.VidOpl)) = tsOk
              ttVidOpl.sVOpl   := KlVidOpl.NVidOpl;
            insert current ttVidOpl;
          }
          ttResStr.sStaj    := iRunStaj.RunStrStaj(persons.nrec,89,dEnd);
          if isvalid(#appfirst)
            ttResStr.sTrud  := if(appfirst.contractnmb<>'',appfirst.contractnmb + ' от ' + datetostr(appfirst.contractdate,'DD.MM.YYYY'),'');
          if isvalid(#SpAS_Cnt)
            if isvalid(#SpAS_Agr)
            {
              ttResStr.sDopS:= SpAS_Agr.RESSTRING[1];
              ttResStr.dDopS:= SpAS_Agr.RESDATE[1];
            }
          ttResStr.dDopSrok := RaiseHist.dDat2;
          ttResStr.cAppPers := Appointments.nRec;
          ttResStr.d102Beg  := RaiseHist.dRec;
          ttResStr.d102End  := RaiseHist.dDat2;
//          ttResStr.dbSumK   := 0;
          ttResStr.sPrik    := RaiseHist.DOCNMB+' от '+datetostr(RaiseHist.DOCDATE,'DD.MM.YYYY');
//          ttResStr.dImpl    := 0;
          ttResStr.sIsCh    := iAppCh.State(persons.nrec,contdoc.cSTR,dEnd,12);
          
          insert current ttResStr;
        }
      }
    }
  }
//103
/*
  if isvalid(#ttPerFlt)
  _loop ttPerFlt
  {
    if isvalid(#Fortune)
    _loop Fortune
    {
      if isvalid(#ContFort)
      if isvalid(#ttTypOpFort)
      if isvalid(#persons)
      if isvalid(#AppFort)
      {
        if getfirst ttResStr where
        ((
                 AppFort.nRec == ttResStr.cAppPers 
        and   Fortune.DocDate>>= ttResStr.d102Beg and (Fortune.DocDate <= ttResStr.d102End)
        )) = tsOk
        {
          if (not NextVisual) break;
          if ttResStr.sPrik = ''
          {
            ttResStr.dbSumK   := Fortune.DocSum;
            if isvalid(#PartFort )
            if isvalid(#TitleFort)
              ttResStr.sPrik    := TitleFort.DOCNMB+' от '+datetostr(TitleFort.DOCDATE,'DD.MM.YYYY');
            ttResStr.sKomp    := iCatFunc.GetCatalogsName(Fortune.cFType);
            ttResStr.sKomC    := iCatFunc.GetCatalogsCode(Fortune.cFType);
            ttResStr.dImpl    := Fortune.Dat1;
            update current ttResStr;
          }
          else
          {
            ttResStr.nRec     := GetNextnRec(#ttResStr, 0);
            ttResStr.dbSumK   := Fortune.DocSum;
            if isvalid(#PartFort )
            if isvalid(#TitleFort)
              ttResStr.sPrik  := TitleFort.DOCNMB+' от '+datetostr(TitleFort.DOCDATE,'DD.MM.YYYY');
            ttResStr.sKomp    := iCatFunc.GetCatalogsName(Fortune.cFType);
            ttResStr.sKomC    := iCatFunc.GetCatalogsCode(Fortune.cFType);
            ttResStr.dImpl    := Fortune.Dat1;
            insert current ttResStr;
          }
        }
        else
        {
          if (not NextVisual) break;
          clearbuffer(#ttResStr);
          ttResStr.cRecPers := persons.nrec;
          ttResStr.sTbNmb   := if(persons.STRTABN='',persons.TABNMB,persons.STRTABN);
          ttResStr.sFIO     := persons.FIO;
          ttResStr.sKomp    := iCatFunc.GetCatalogsName(Fortune.cFType);
          ttResStr.sKomC    := iCatFunc.GetCatalogsCode(Fortune.cFType);
          if isvalid(#appointments)
          {
            ttResStr.sDept  := iCatFunc.GetCatalogsCode(AppFort.DEPARTMENT);
            ttResStr.sPost  := iCatFunc.GetCatalogsName(AppFort.POST);
            ttResStr.sDepP  := i3GD.sCode3GD(AppFort.DEPARTMENT);
          }
          ttResStr.sStaj    := iRunStaj.RunStrStaj(persons.nrec,89,dEnd);
          if isvalid(#appfirst)
            ttResStr.sTrud  := if(appfirst.contractnmb<>'',appfirst.contractnmb + ' от ' + datetostr(appfirst.contractdate,'DD.MM.YYYY'),'');
          ttResStr.cAppPers := AppFort.nRec;
          ttResStr.dbSumK   := Fortune.DocSum;
          if isvalid(#PartFort )
          if isvalid(#TitleFort)
            ttResStr.sPrik    := TitleFort.DOCNMB+' от '+datetostr(TitleFort.DOCDATE,'DD.MM.YYYY');
          ttResStr.dImpl    := Fortune.Dat1;
          ttResStr.sIsCh    := iAppCh.State(persons.nrec,ContFort.cSTR,dEnd,12);
          
          insert current ttResStr;
        }
      }
    }
  }
*/

  // выводим данные в отчет
  if isvalid(#ttResStr)
  {
    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xls';

    xlCreateExcel(sFullName, TRUE);
    iOut.xlSummaryRowAbove;
    lRB  := 4;
    lRow := 1;
    lDB  := lDE := lRB + 1;
    lCB  := 1;
    lCE  := 1;
//    dbTotalIt:=0;

    //заголовок
    #define repT 2,3,2,3
    iOut.StringValL('#(GPNam) за период с '+datetostr(dBeg,'DD.MM.YYYY')+' по '+datetostr(dEnd,'DD.MM.YYYY'),#repT);
    xlSetFontSize(14,#repT); xlSetFontStyle(xlBold,#repT);

    // шапочка
    #define FrmHd lRB,lCE,lRB,lCE
/*01*/iOut.StringValC('№ п/п',                         #FrmHd); lCE++;
/*02*/iOut.StringValC('Таб. Ном.',                     #FrmHd); lCE++;
/*03*/iOut.StringValC('ФИО',                           #FrmHd); lCE++;
/*04*/iOut.StringValC('№ цеха / отдел',                #FrmHd); lCE++;
/*05*/iOut.StringValC('Код вышест. подразд.',          #FrmHd); lCE++;
/*06*/iOut.StringValC('Должность / специальность',     #FrmHd); lCE++;
/*07*/iOut.StringValC('Вид компенсации',               #FrmHd); lCE++;
/*08*/iOut.StringValC('Стаж работы на предприятии',    #FrmHd); lCE++;
/*09*/iOut.StringValC('№ трудового договора',          #FrmHd); lCE++;
/*10*/iOut.StringValC('№ доп. согла-шения ',           #FrmHd); lCE++;
/*11*/iOut.StringValC('Дата заключения',               #FrmHd); lCE++;
/*12*/iOut.StringValC('Срок действия доп. соглашения ',#FrmHd); lCE++;
/*13*///iOut.StringValC('Дата назначения компенсации',   #FrmHd); lCE++;
/*13*/iOut.StringValC('Дата начис-ления компен-сации', #FrmHd); lCE++;
/*14*///iOut.StringValC('Назначено компен-сации',           #FrmHd); lCE++;
/*14*///iOut.StringValC('Размер компен-сации',           #FrmHd); lCE++;
/*14*/iOut.StringValC('Факт. сумма компен-сации',      #FrmHd); lCE++;
///*15*/iOut.StringValC('Дата начисления компенсации',      #FrmHd); lCE++;
///*16*/iOut.StringValC('Начислено компен-сации',        #FrmHd); lCE++;
/*17*/iOut.StringValC('Номер и дата списка',           #FrmHd); lCE++;
/*18*/iOut.StringValC('Изменение условий',             #FrmHd); lCE++;

    //строки отчета
    #define FrmCl lDE,lSE,lDE,lSE
    _loop ttPers ordered index ttPers01
    {
      lSB := lSE := 1;
/*01*/iOut.IntegerVal(lRow,              #FrmCl); lSE++;
      _loop ttResStr where((ttPers.cRecPsn==ttResStr.cRecPers))
      {
        if (not NextVisual) break;
    
        lSB := lSE := 1;
/*01*/  lSE++;
/*02*/  iOut.StringValC(ttResStr.sTbNmb,   #FrmCl); lSE++;
/*03*/  iOut.StringValL(ttResStr.sFio,     #FrmCl); lSE++;
/*04*/  iOut.CodeVal   (ttResStr.sDept,    #FrmCl); lSE++;
/*05*/  iOut.CodeVal   (ttResStr.sDepP,    #FrmCl); lSE++;
/*06*/  iOut.StringValL(ttResStr.sPost,    #FrmCl); lSE++;
/*07*/  iOut.StringValL(ttResStr.sKomp,    #FrmCl); lSE++;
/*08*/  iOut.StringValR(ttResStr.sStaj,    #FrmCl); lSE++;
/*09*/  iOut.StringValR(ttResStr.sTrud,    #FrmCl); lSE++;
/*10*/  iOut.StringValC(ttResStr.sDopS,    #FrmCl); lSE++;
/*11*/  iOut.DateVal   (ttResStr.dDopS,    #FrmCl); lSE++;
/*12*/  iOut.DateVal   (ttResStr.dDopSrok, #FrmCl); lSE++;
/*13*/  iOut.DateVal   (ttResStr.dImpl,    #FrmCl); lSE++;
/*14*/  /*iOut.DoubleVal (ttResStr.dbSumK,   #FrmCl);*/ lSE++;
/*15*///  lSE++;
/*16*///  lSE++;
/*17*/  iOut.StringValR(ttResStr.sPrik,    #FrmCl); lSE++;
/*18*/  iOut.StringValC(ttResStr.sIsCh,    #FrmCl); lSE++;
//        dbTotalIt := dbTotalIt + ttResStr.dbSumK;
        lDE++;
        lRow++;
      }
      var isSumm : boolean;
      cPersOpl := ttPers.cRecPsn;
      if isvalid(#SumVidOp)
      {
        isSumm := false;
        _loop SumVidOp
        {
          if  date(1,month(dBeg),year(dBeg)) <= date(1,SumVidOp.MesN,SumVidOp.YearN)
          and sub_day(add_months(date(1,month(dEnd),year(dEnd)),1),1) >= sub_day(add_months(date(1,SumVidOp.MesN,SumVidOp.YearN),1),1)
          {
            if getfirst ttVidOpl where((ttPers.cRecPsn==ttVidOpl.cRecPsn and SumVidOp.VidOpl==ttVidOpl.lVOpl)) = tsOk
            {
              if getfirst ttSumOpl where ((  ttPers.cRecPsn==ttSumOpl.cRecPsn 
                                         and ttVidOpl.lVOpl==ttSumOpl.lVOpl  
                                         and SumVidOp.YearN==ttSumOpl.wYear
                                         and SumVidOp.MesN ==ttSumOpl.wMonth
              /*if getfirst ttSumOpl*/   )) <> tsOk
              {
                clearbuffer(#ttSumOpl);
                ttSumOpl.cRecPsn := ttPers.cRecPsn;
                ttSumOpl.wYear   := SumVidOp.YearN;
                ttSumOpl.wMonth  := SumVidOp.MesN ;
                ttSumOpl.dbSum   := SumVidOp.Summa;
                ttSumOpl.lVOpl   := ttVidOpl.lVOpl;
                insert current ttSumOpl;
                isSumm := true;
              }
              else
              {
                ttSumOpl.dbSum += SumVidOp.Summa;
                update current ttSumOpl;
              }
            }
          }
        }
        if isSumm
        {
          lSE := 3; 
//          iOut.StringValL('Итого выплачено компенсации по '+ttResStr.sFio, #FrmCl); lDE++;
          xlSetFontStyle(xlBold,lDE,lCB,lDE,lCE);
          iOut.HeaderInsL('Итого Начислено компенсации по '+ttResStr.sFio, #FrmCl, 5); lDE++;
          iRowB:=lDE;
          _loop ttVidOpl where((ttPers.cRecPsn==ttVidOpl.cRecPsn))
          _loop ttSumOpl where((ttPers.cRecPsn==ttSumOpl.cRecPsn and ttVidOpl.lVOpl==ttSumOpl.lVOpl))
          {
            lSB := 1;
            lSE := 7; 
/*07*/      iOut.StringValL(ttVidOpl.sVOpl, #FrmCl);
            lSE := 13;
/*13*/      iOut.DateVal   (sub_day(add_months(date(1,ttSumOpl.wMonth,ttSumOpl.wYear),1),1), #FrmCl);
            lSE := 14;
/*15*/      iOut.DoubleVal (ttSumOpl.dbSum, #FrmCl);
            lDE++;
          }
          iRowE := lDE - 1;
          //=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;N8:N11)
          iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;N'+iRowB+':N'+iRowE+')', iRowB-1, 14, iRowB-1, 14);
          iOut.xlSetSummaryRow(iRowB, iRowE, iNPP++);
        }
      }
    }
    var iItC : integer;
    #define FrmIt lDE,iItC,lDE,iItC
    iOut.xlR1C1OnOff(true);
    iItC :=  3; iOut.StringValL('Итого:',  #FrmIt);
//    iItC := 13; iOut.FormulaDoubleVal('=СУММ(R'+lDB+'C'+iItC+':R'+(lDE-1)+'C'+iItC+')', #FrmIt);
    iOut.xlR1C1OnOff(false);
    iItC := 14; iOut.FormulaDoubleVal('=ПРОМЕЖУТОЧНЫЕ.ИТОГИ(9;N'+lDB+':N'+(lDE-1)+')', #FrmIt);

    //форматируем отчет
    lSE := 1;
    #define FrmBl lDB,lSE,lDE,lSE
    xlSetRowHeight(40,lRB,1,lRB,1);
/*01*/xlSetColumnWidth( 4,#FrmBl); lSE++;
/*02*/xlSetColumnWidth( 6,#FrmBl); lSE++;
/*03*/xlSetColumnWidth(17,#FrmBl); lSE++;
/*04*/xlSetColumnWidth( 8,#FrmBl); lSE++;
/*05*/xlSetColumnWidth( 8,#FrmBl); lSE++;
/*06*/xlSetColumnWidth(16,#FrmBl); lSE++;
/*07*/xlSetColumnWidth(18,#FrmBl); lSE++;
/*08*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*09*/xlSetColumnWidth(17,#FrmBl); lSE++;
/*10*/xlSetColumnWidth( 9,#FrmBl); lSE++;
/*11*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*12*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*13*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*14*/xlSetColumnWidth(10,#FrmBl); lSE++;
/*15*///xlSetColumnWidth(12,#FrmBl); lSE++;
/*16*///xlSetColumnWidth(10,#FrmBl); lSE++;
/*17*/xlSetColumnWidth(12,#FrmBl); lSE++;
/*18*/xlSetColumnWidth(12,#FrmBl); lSE++;

    xlSetFontSize(11,lDB,lCB,lDE,lCE); xlSetFontSize(10,lRB,lCB,lDB-1,lCE);
    xlSetFontStyle(xlBold,lRB,lCB,lRB,lCE); xlSetFontStyle(xlBold,lDE,1,lDE,lCE);
    xlWrapText(lRB,lCB,lDE,lCE);
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB or xlInsideV or xlInsideH, xlThin,0,0,lRB,lCB,lDE,lCE-1);
    #define ResPer lDE+2,3,lDE+2,3
    iOut.StringValL('Ответственный исполнитель: '+sGetTune('User.FIO'),#ResPer);
    xlSetFontSize(11,#ResPer); xlSetFontStyle(xlBold,#ResPer);
    iOut.xlTitleEachPageO(lRB,lDB-1);
    iOut.xlPageScaleLandscape(1);
    xlFreeze(lDB,1);
    StopVisual;
    xlKillExcel;
  }
  else
  {
    StopVisual;
    message('Нет данных для формирования отчета!');
  }

}

Screen s1(,,sci1Esc);
  show at (,,85,4);
  fields
    dBeg ('Начало периода',,):{Font = {BackColor = if(dBeg = 0, ColorNeed, 0)}}, noprotect;
    dEnd ('конец периода',,): {Font = {BackColor = if(dEnd = 0, ColorNeed, 0)}}, noprotect;
    sRPD ('Распорядительное действие',, scStaffKatPodrRefsPick): {Font = {BackColor = if(sRPD = 'не установлен', ColorNeed, 0)}}, protect;
  << 'Параметры отчета'
   `Период отчета`
    .@@@@@@@@@@ .@@@@@@@@@@@

    Действие     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  >>
end;  
embedded ComFiltrEmbedded 'Фильтры' interface VCommonFiltr;
  show (,5,85,11);
end
Screen s2(,,sci1Esc);
  show (,12,85,13);
  buttons
    cmOk,,,'Запуск',,;
    cmCancel,,,'Выход',,;
  <<
     <. ~С~формировать .>                         <. ~З~акрыть .>
  >>
end;

//заполнение содержимого поля фильтра по РПД
procedure FillRPDStr;
{
  var i,kol : integer;
  Set sRPD := 'не установлен';

  kol :=  GetMarkerCount(RPDMarker);
  if (kol = 1)
  {
    if GetMarker(RPDMarker, 0, wRPD)
      if GetFirst TypePr where ((wRPD == TypePr.CodOper)) = tsOk
      {
        set sRPD:= TypePr.NOper;
        clearbuffer(#ttTypOp);
        ttTypOp.wCodeOper := TYPEPR.CODOPER;
        ttTypOp.sNameOper := TYPEPR.NOPER;
        insert current ttTypOp;
      }
  }
  else
  {
    set sRPD := 'Несколько распорядительных действий (' + kol + ')';
    i := 0;
    while i < kol
    {
      GetMarker(RPDMarker, i, wRPD);
      if GetFirst TypePr where ((wRPD == TypePr.CodOper)) = tsOk
      {
        clearbuffer(#ttTypOp);
        ttTypOp.wCodeOper := TYPEPR.CODOPER;
        ttTypOp.sNameOper := TYPEPR.NOPER;
        insert current ttTypOp;
      }
      i++;
    }
  }
}

handleevent
  cmInit:
  {
    delete all from ttPerFlt;
    delete all from ttResStr;
    delete all from ttTypOp;
    if (not (ReadMyDsk(dBeg, '#(GPInt)_dBeg', false)))
      dBeg := date(1,1,year(Cur_Date));
    if (not (ReadMyDsk(dEnd, '#(GPInt)_dEnd', false)))
      dEnd := date(31,12,year(Cur_Date));
    MadeReport:= false;
    wRPD := 0;
    Set sRPD := 'не установлен';
    RPDMarker := InitMarker('#(GPInt)_RPD_' + UserName(), 8,200,100);// Маркер для RPD
    if GetMarkerCount(RPDMarker) >0 FillRPDStr;
    i3GD.Init3GD;
  }
  cmPick:
  {
    case CurField of
    #sRPD:
    {
      wRPD := 103; // предустанавливаем код РПД для которого собственно и отчет
      if RunInterface ('PickManyRPD', wRPD, RPDMarker, vfMultipleSelection,0) = cmDefault
      {
        delete all from ttTypOp;
        FillRPDStr;
      }
    }
    end;
  }
  cmDelOnProtect:
  {
    case CurField of
    #sRPD:
    {
      Set sRPD := 'не установлен';
      delete all from ttTypOp;
      ClearMarker(RPDMarker);
    }
    end;
  }
  cmOk:
  {
    if (dBeg = 0) or (dEnd = 0) or (dBeg > dEnd)
    {
      message('Задан некорректный период!');
    }
    else
    {
      if wRPD = 0
      {message('Не задано РПД!');}
      else
      {
        Run;
        SaveMyDsk(dBeg, '#(GPInt)_dBeg');
        SaveMyDsk(dEnd, '#(GPInt)_dEnd');
        MadeReport:= true;
        VCommonFiltr.IntClose(MadeReport);
        VCommonFiltr.StoreAllParams;
        Notify(cmEvaluateAndModify, 0);
        DoneMarker(RPDMarker, '#(GPInt)_RPD_' + UserName());
        DoneMarker(PersMarker, '#(GPInt)_PSN_' + UserName());
      
        closeinterface(cmDefault);
      }
    }
  }
  cmCancel:
  {
    VCommonFiltr.IntClose(MadeReport);
    DoneMarker(RPDMarker, '#(GPInt)_RPD_' + UserName());
    DoneMarker(PersMarker, '#(GPInt)_PSN_' + UserName());
    SaveMyDsk(dBeg, '#(GPInt)_dBeg');
    SaveMyDsk(dEnd, '#(GPInt)_dEnd');
  }
end;
end.



VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;

Procedure Run;
Begin
  runinterface(#(GPInt));
End;

Function GetReportName: String;
Begin
  GetReportName := '#(GPNam) (ЭМ)';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Компенсации и льготы';
    2 : GetGroupName := 'Журналы регистрации и учета';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;

End.
