Procedure DisAbleAppointments;
{ Inherited::DisAbleAppointments;
  cfsSetProp('c_BRWAPPOINTMENTS3_APPOINTMENTS.APPOINTDATE_Дата_с',cfpSkip,False);
  cfsSetProp('c_BRWAPPOINTMENTS3_APPOINTMENTS.APPOINTDATE_Дата_с',cfpProtect,true);
  cfsSetProp('c_BRWAPPOINTMENTS_APPOINTMENTS.APPOINTDATE_Дата_с',cfpSkip,False);
  cfsSetProp('c_BRWAPPOINTMENTS_APPOINTMENTS.APPOINTDATE_Дата_с',cfpProtect,true);
}
