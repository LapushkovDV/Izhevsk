#component "Z_STAFF"

Alter interface ReceptionMain

#include GP_File_hRef.Vpp

HandleEvent
cmInit:
{
 Inherited::HandleEvent(CmInit);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' , -1  , -1, 0);
 // Во все карточки добавляем скрпеочку
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  WINCOMMONDATA    , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  WINEDUCATION     , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  WINSERVLEN       , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winPsnLinks      , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winConscription  , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winAppointments  , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winVacations     , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winExperience    , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winDopTbls       , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winPenStaj       , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winCompetence    , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winBankDetails   , -1, 1);
 LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' ,  winOrders        , -1, 1);

}

cmStaffSeeDopInfo:
{
  putcommand(cmValue68);
}
cmValue68:
{ pGP_File_hRef.InitParam(
   if(false,cgiNotEdit,0)   //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
                // Если документ только на чтение следует вызвать cgiNotEdit
  ,coPersons //_wTable    : word; указать код таблицы документа системы
  ,Persons.Nrec //_cRec      : comp=0;   // указать поле в таблице
  ,1 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
  ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
    ,'Файлы по сотруднику ' + Persons.fio
   );
}

end;
end.
