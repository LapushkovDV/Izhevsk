#include GP_MenuDynamic.vih

#component "Z_STAFF"
#doc
Сотрудники - кадровый резерв - по должностям
<p>#2104 переключение списка подразделений на линейный список ALT+S
при просмотре кадрового резерва по подразделениям
#end
Alter Interface KADRRESERVPOST;
//*********************************
Function GetCompetenceCode:String;Forward;
//*********************************
var
  IsCurrTree: boolean; // дерево или список

Create view VStruct
var
  pLevCatRezerv:comp;
as select
 if (isValid(tnCatStaffStr),  CatStaffStr.Code, '') ( FieldName = CompetenceCode )
// GetCompetenceCode() ( FieldName = CompetenceCode )
from
/*
     CompetencePers ComPers
   , catalogs Cat
*/
//----- Компетенции по ставке ---
     Catalogs CatStaffStr
   , COMPETENCESTAFFSTR ComStaffStr
   , COMPETENCESTAFFSTR ComStaffStr_UP
//----- Компетенции по должностям ---
, COMPETENCEPOST
, COMPETENCEPOST COMPETENCEPOST_UP
where ((
/* изменили задание: брать не от человека, а от должности в ШР. + еще выбор добавить прямо в этом интерфейсе
Persons.Nrec == ComPers.cPers
   and  ComPers.cName == Cat.nrec
and pLevCatRezerv == Cat.cParent (Noindex) // Вышестоящий элемент Уровни кадрового резерва
*/
//    FuturePost.cStaffStr == ComStaffStr.CSTAFFSTR
       StaffStruct.Nrec    == ComStaffStr_UP.CSTAFFSTR
and    pLevCatRezerv       == ComStaffStr_UP.cName
and    StaffStruct.Nrec    == ComStaffStr.CSTAFFSTR
and    ComStaffStr_UP.Nrec == ComStaffStr.cParent
and    ComStaffStr.cName   == CatStaffStr.nrec
and    pLevCatRezerv       == CatStaffStr.cParent (Noindex) // Вышестоящий элемент Уровни кадрового резерва
//----- Компетенции по должностям ---
and StaffStruct.Post       == COMPETENCEPOST.CPOST
and CompetencePost.cParent == CompetencePost_Up.NRec  // Вышестоящая компетенция
and pLevCatRezerv          == CompetencePost_Up.cName(noindex) //'Уровни кадрового резерва'
))
// боундсы для сортировки линейной  структуры
//bounds SortN ordered by TmpCatalogs.Name
//bounds SortK ordered by TmpCatalogs.Code
; //Create view VStruct

//----------------------
Create view vSpr
var
  pCatCheck:comp;
as select Catalogs.Nrec
From Catalogs CatMain
, Catalogs
, Catalogs CatCheck
where
((                         100 == CatMain.SysCode
and                          0 == Catalogs.Lpr
and               CatMain.Nrec == Catalogs.MainLink
and 'Уровни кадрового резерва' == Catalogs.Name
and                  pCatCheck == CatCheck.Nrec
));//Create view vSpr


//*******************************************
browse brCat (,hcStaff_KadrRezerv_dolj, sci1Esc);// дерево
  show at (,,,10);
  Table TmpCatalogs;
Fields
     TmpCatalogs.Name 'Наименование структурной единицы ШР'
     ('Наименование структурной единицы ШР'): [45], protect;
     TmpCatalogs.Code 'Код'
     ('Код структурной единицы ШР') : [10], protect;
     TmpCatalogs.DatN 'Дата','создания'
     ('Дата создания структурной единицы ШР') : [10,'DD/MM/YYYY'], protect, centered;
end; //tree

//*******************************************
overloadFormats  BRWKADRRESERV1;
//*******************************************
browse brwKadrReserv1(,hcStaff_KadrRezerv_dolj, sci1378Esc);
  show at (,18,,);
  table FuturePost;
  Fields
  Persons.FIO 'Фамилия, имя, отчество'
            ('ФИО сотрудника', hcStaff_KadrRezerv_dolj) : [30];
  Persons.TabNmb 'Таб.номер'
            ('Табельный номер', hcStaff_KadrRezerv_dolj, sci178Esc) : [10];
  Persons.StrTabN 'Таб.номер'
            ('Табельный номер', hcStaff_KadrRezerv_dolj, sci178Esc) : [10];
  CatEduc.Name 'Образование'
            ('Образование', hcStaff_KadrRezerv_dolj, sci178Esc) : [25], protect;
  FuturePost.dat1 'Дата зачисления'
            ('Рекомендуемая дата перехода на должность', hcStaff_KadrRezerv_dolj) : [10,'DD/MM/YYYY'], centered;
  FuturePost.dat2 'Дата выбытия'
            ('', hcStaff_KadrRezerv_dolj) : [10,'DD/MM/YYYY'], centered;
  FoundatCat.Name 'Основание'
            ('Основание', hcStaff_KadrRezerv_dolj): [10], pickbutton, protect;
#IFDEF _GP_
    CompetenceCode 'Код уровня'
              ('Код уровня', hcStaff_KadrRezerv_sotr): [10], pickbutton, protect;
#ENDIF
  end; // brwKadrReserv1


//-----------------------------------
// Получить код  компетенции
//-----------------------------------
Function GetCompetenceCode:String;
{ _Loop ComStaffStr
  {  if (isValid(tnCatStaffStr))
     { Result:=CatStaffStr.Code;
       break;
     }
  }
} //Function GetCompetenceCode:String;


//-----------------------------------
// Получить уровень кода компетенции
//-----------------------------------
Function GetLevCatRezerv  :comp;
{ Result:=0;
  if vSpr.Getfirst Catmain=tsok
    if vSpr.Getfirst Catalogs=tsok
      Result:=vSpr.Catalogs.Nrec;
} //Function GetLevCatRezerv  :comp;


//-------------------------------
// Вставить запись вышестоящего уровня
//-------------------------------
Procedure Ins_ComStaffStr_UP;
{ //if not isValidAll(tnComStaffStr_UP)
  timelog('KadrReservPost->Ins_ComStaffStr_UP:Start');
  if getfirst ComStaffStr_UP=tsok then exit;
  timelog('KadrReservPost->Ins_ComStaffStr_UP:INS');
  insert ComStaffStr_UP set
          ComStaffStr_UP.CSTAFFSTR := StaffStruct.nrec
         ,ComStaffStr_UP.cName     := pLevCatRezerv
         ,ComStaffStr_UP.WWEIGHT   := 100
         ,ComStaffStr_UP.WPOS      := 1 // надо бы номер проставить....
         ;
} //Procedure Ins_ComStaffStr_UP;

//-----------------------------------
// #2104.#2
// Проверить наличие кода компетенции по ставке
// В момент добавления новой записи о кадровом резерве,
// подставлять в графу "Код уровня" значение по умолчанию,
// с закладки "Компетенции" профиля должности.
// Компетенция должна лежать в папке "Уровни кадрового резерва".
//-----------------------------------
Function CheckCompetenceCode:boolean;
{ Result :=False;
  timelog('KadrReservPost->CheckCompetenceCode:Start');

  Ins_ComStaffStr_UP;
  if getfirst ComStaffStr=tsok then exit;
  timelog('KadrReservPost->CheckCompetenceCode:Ищем по должности');
  _Loop COMPETENCEPOST
  { timelog('KadrReservPost->CheckCompetenceCode:есть компетенция');
    //if isValidAll(tnCOMPETENCEPOST_UP)
    if getfirst CompetencePost_Up=tsok
    { timelog('KadrReservPost->CheckCompetenceCode:нашли');

      insert ComStaffStr set
          ComStaffStr.CSTAFFSTR := StaffStruct.Nrec//FuturePost.cStaffStr
         ,ComStaffStr.cName     := COMPETENCEPOST.cName
         ,ComStaffStr.WWEIGHT   := 100
         ,ComStaffStr.cParent   := ComStaffStr_UP.Nrec
         ,ComStaffStr.WPOS      := 1 // надо бы номер проставить....
        ;
      break;
    }
  } //_Loop COMPETENCEPOST
  Result:=True;
} //Function CheckCompetenceCode:boolean;

//**********************************************
// обработчик событий FuturePost
//**********************************************
panel panFuturePost;
table FuturePost;
HandleEvent
//---------------------
cmInsertRecord:
{
  case inherited :: handleEvent (cmInsertRecord) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

} //cmInsertRecord:
cmInsert:
{ CheckCompetenceCode;
  case inherited :: handleEvent (cmInsert) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

}
//---------------------
cmPick:
{ //---------------------------------
  timelog('KadrReservPost->panFuturePost->cmPick');
  case CurField of
  #Persons.Fio:
  { // проверим заранее наличие кода компетенции по ставке
     timelog('KadrReservPost->panFuturePost->cmPick->#Persons.Fio');
     CheckCompetenceCode;
  }
  end;
  //---------------------------------
  case inherited :: handleEvent (cmpick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
  case curfield of
  #CompetenceCode:
  { SetModified(true);
    UpdateTable;

    var cNrec : comp;
    cNrec := if(isValid(tnCatStaffStr),CatStaffStr.nrec,0h);
    if isValidAll(tnFuturePost)
    if (RunInterface('Z_STAFFCAT::PickCatalog2', 100, cNrec, 0,0) <> cmCancel)
    {  vSpr.pCatCheck:=cNrec;
       if vSpr.getfirst fastfirstrow CatCheck = tsOK
       {
        if vSpr.CatCheck.cParent <> pLevCatRezerv
        {
          Message('Необходимо выбрать запись, подчиненную "Уровни кадрового резерва"',error)
        }
        else
         {
          //if isValid(tnCatStaffStr)
          Ins_ComStaffStr_UP;
          if getfirst ComStaffStr=tsok
           {
            update current ComStaffStr set ComStaffStr.cName := cNrec;
           }
           else
           {
             insert ComStaffStr set
               ComStaffStr.CSTAFFSTR := FuturePost.cStaffStr
              ,ComStaffStr.cName     := cNrec
              ,ComStaffStr.WWEIGHT   := 100
              ,ComStaffStr.WPOS      := 1 // надо бы номер проставить....
              ,ComStaffStr.cParent   := ComStaffStr_Up.Nrec
             ;
           }
         } // else if CatCheck.cParent <> pLevCatRezerv
      } // if getfirst fastfirstrow CatCheck where ((cNrec == CatCheck.nrec)) = tsOK
     } // if (RunInterface('Z_STAFFCAT::PickCatalog2', 100, cNrec, 0) <> cmCancel)
     //rereadrecord;
     ResCanPanel(#FuturePost);
   } // #CompetenceCode:
   end;
 } // end cmpick:

end;
end;//panel panFuturePost

//**********************************************
// обработчик событий интерфейса
//**********************************************
 HandleEvent
//---------------------
  cmInit:
  { timelog_init;
    pLevCatRezerv:=GetLevCatRezerv;
    timelog('KadrReservPost->cmInit:pLevCatRezerv='+string(pLevCatRezerv,0,0));
    IsCurrTree:=true;
    case inherited::handleEvent(cmInit) of
     heAbort: { abort; exit; }
     heStop: { stop; exit; }
    end;

  }
//---------------------
  cmAccording :
  { var _pNrec:comp;
    _pNrec:=TmpCatalogs.Nrec;
    if IsCurrTree  // из дерева в список
    { IsCurrTree := false;

      ResetBounds(tnTmpCatalogs);
      if getfirst TmpCatalogs where (( _pNrec == TmpCatalogs.Nrec ))=tsok {}
      SetFormat(brCat);
      ReScanPanel(tnTmpCatalogs);
    }
    else  // из списка в дерево
    { IsCurrTree := true;
      PushBounds(tnTmpCatalogs);
      SetFormat(trCat);
      ReScanPanel(tnTmpCatalogs);
      TreeJumpToRecord(trCat, _pNrec);
      ReScanPanel(tnTmpCatalogs);
    }
  }
 end;

end.

handler with replace GP_MenuDynamic_AddItems_KADRRESERVPOST on ExtensionPoint GP_MenuDynamic_AddItems
action
{
  result:=true;
  timelog_init;
  var MenuID:longint=0;
  MenuID:=0;
  var sMenu:string='Z_STAFF::KadrReservPost';
  DeleteMenuHowDynamics(sMenu);
  //------------------------------------
  //Сотрудники - кадровый резерв - по должностям
  //Z_Staff##KADRRESERVPOST - локальное меню
  //------------------------------------
   MenuID:=0;
  _try {
    timelog('GP_MenuDynamic_AddItems_KADRRESERVPOST->'+sMenu);

    MenuID:=LoadMenuEx(sMenu,false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddMenuItemEx(MenuID,'Режим представления: линейный/иерархический'
              ,'Изменить вид интерфейса: иерархический <-> плоский',hcHotKeySaveDoc,cmAccording,kbAltS)//kbCtrlF2);
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,sMenu))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню "кадровый резерв" -> локальное меню'#13+
              ExploreException,error);
    }
  _finally {
     if (MenuID<>0) DisposeLoadMenu(MenuID);
  }
  timelog('GP_MenuDynamic_AddItems_KADRRESERVPOST->'+sMenu+' finish');

} //handler with replace

#doc
Удаление пунктов меню "Сотрудники - кадровый резерв - по должностям"
#end
handler with replace GP_MenuDynamic_DelItems_KADRRESERVPOST on ExtensionPoint GP_MenuDynamic_DelItems
action
{
  result:=true;
  var sMenu:string='Z_STAFF::KadrReservPost';
  DeleteMenuHowDynamics(sMenu);
}
