#include GetKau.vih
#include RPD.Vih
#include Marker.Vih
#component "Z_STAFFORDERS"
#doc
  Интерфейс приказа "Назначение единовременных выплат с днями и часами"
  Доработки системы для учета по заказам.pptx
#end
//******************************************************************************
Alter Interface RPD_13 ('');
//******************************************************************************
OverLoad
  procedure IRPD_Base3.PrintRPD(typePrint: TPtr; fcEnter: word);
  function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
end;

//******************************************************************************
// Печать приказа
//******************************************************************************
procedure PrintRPD(typePrint: TPtr; fcEnter: word);
{
  case typePrint of
    0:
    {
      RunInterface('NFormRD09a', TitleDoc.Nrec, PartDoc.TypeOper);
    }
    else
    { Inherited::PrintRPD(typePrint,fcEnter);

    }
    end;
}

function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
begin
  result := inherited::ChildCheckOneOrder(cNrec);
  if (result)
  {
    pushpos(tnPartdoc);
    pushpos(tnContdoc);
    pushpos(tnRaiseHist);
    _loop Partdoc
    {
      _loop Contdoc
      {
        _loop RaiseHist
        {
          if ( (RAISECAT.CODE = '11' and not (APPOINTMENTS.PAYMODEL = 30 or APPOINTMENTS.PAYMODEL = 40))
                or
               (RAISECAT.CODE = '15' and not (APPOINTMENTS.PAYMODEL = 20)) )
          {
            SetErrorOrder('Приказ утвердить нельзя: вид доплаты не соответствует виду ставки работника', Error);
            result := false;
          }
        }
      }
    }
    poppos(tnPartdoc);
    poppos(tnContdoc);
    poppos(tnRaiseHist);
  }
end;

END.
