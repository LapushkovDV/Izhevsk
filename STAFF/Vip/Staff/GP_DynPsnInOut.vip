function wWhatAgePeriod(dBorn, dAppoint : date) : word;
{
  var wAgePsn : word=0;
  var wRez    : word=0;

  if dBorn <> 0 
  {
    wAgePsn := Year(dAppoint) - Year(dBorn);
    if wAgePsn < 31
      wRez := 1
    else
    if wAgePsn < 50
      wRez := 2
    else
      wRez := 3;
  }
  else
  {
    wRez := 0;
  }
  wWhatAgePeriod := wRez;
}

function wWhatStajPeriod(cPsn : comp; dDismiss : date) : word;
{
  var wStajPsn : word=0;
  var wRez     : word=0;
  
  wStajPsn := iRunStaj.GetStajYears(cPsn, 89, dDismiss);
  if wStajPsn < 1
    wRez := 1
  else
  if wStajPsn < 5
    wRez := 2
  else
    wRez := 3;
  wWhatStajPeriod := wRez;
}


procedure MadeDataByAppoint;
{
  var bIsDo : boolean;
  
  iNextVisual('Формируем приемы.');
  if isvalid(#AppPers)
  _loop AppPers
  {
    if ('С' = AppPers.IsEmployee or 'У' = AppPers.IsEmployee)
    if isvalid(#ttRepPeriod)
    _loop ttRepPeriod
    {
      if isvalid(#AppApp)
      _loop AppApp
      {
        if (not NextVisual) break;
        bIsDo := false;
        cFType:=cFKat:=cFPer:=0;wAge:=0;
        if AppPers.AppointFirst = AppApp.nRec { bIsDo := true;}
        if not bIsDo
        { 
          if isvalid(#AppDoc) 
            {bIsDo := true;}
        }
//#include GP_MadeDataIn.vpp      
        if bIsDo
        {
          if isvalid(#AppStruct)
          {
            cFType:= cCheckTypeKat(AppStruct.cInf3);
            if cFType = 0
            {
              sCode4Reason := 'Подр. '+iCatFunc.GetCatalogsCode(AppStruct.Department)+'/ № ставки '+AppStruct.SeqNmb;
              if getfirst ttLog where
              ((    'Доп.хар.' == ttLog.sMode
              and            0 == ttLog.dDate
              and sCode4Reason == ttLog.sFIO
              )) <> tsOk
              {
                clearbuffer(#ttLog);
                ttLog.sFIO    := sCode4Reason;
                ttLog.sMode   := 'Доп.хар.';
                ttLog.sReason := 'У СЕ ШР отсутствует доп. характеристика';
                ttLog.dDate   := 0;
                insert current ttLog;
              }
            }
          }
          if cFType <> 0
          {
//            cFKat := cCheckKat (AppApp.EmpCategory, cFType);
            cFKat := cCheckKat (AppStruct.EmpCategory, cFType);
            if cFKat = 0
            {
              sCode4Reason := 'Подр. '+iCatFunc.GetCatalogsCode(AppStruct.Department)+'/ № ставки '+AppStruct.SeqNmb;
              if getfirst ttLog where
              ((   'Категория' == ttLog.sMode
              and            0 == ttLog.dDate
              and sCode4Reason == ttLog.sFIO
              )) <> tsOk
              {
                clearbuffer(#ttLog);
                ttLog.sFIO    := sCode4Reason;
                ttLog.sMode   := 'Категория';
                ttLog.sReason := 'У СЕ ШР не задана категория.';
                ttLog.dDate   := 0;
                insert current ttLog;
              }
            }
          }
          cFPer := ttRepPeriod.nRec;
          wAge  := wWhatAgePeriod(AppPers.BornDate, AppApp.AppointDate);
          if wAge = 0
          {
            sCode4Reason := AppPers.FIO;
            if getfirst ttLog where
            ((         'Дата рожд.'== ttLog.sMode
            and                  0 == ttLog.dDate
            and       sCode4Reason == ttLog.sFIO
            )) <> tsOk
            {
              clearbuffer(#ttLog);
              ttLog.sFIO    := sCode4Reason;
              ttLog.sMode   := 'Дата рожд.';
              ttLog.sReason := 'У сотрудника не задана дата рождения.';
              ttLog.dDate   := 0;
              insert current ttLog;
            }
          }
        }
        if cFType <> 0 and cFKat <> 0 and cFPer <> 0 and wAge <> 0
        {
          if wIsRasshifr = 1
          {
            clearbuffer(#ttLog);
            ttLog.sFIO  := AppPers.FIO;
            ttLog.sMode := 'Прием';
            ttLog.dDate := AppApp.AppointDate;
            insert current ttLog;
          }
          if isvalid(#ttRepInpData)
          {
            case wAge of 
            1: ttRepInpData.lAgePeriod1++;
            2: ttRepInpData.lAgePeriod2++;
            3: ttRepInpData.lAgePeriod3++;
            end;
            update current ttRepInpData;
          }
          else
          {
            ClearBuffer(#ttRepInpData);
            //подразделение
            ttRepInpData.cTypeKat := cFType;
            //категория
            ttRepInpData.cEmplKat := cFKat;
            //возрастной интервал
            case wAge of 
            1: ttRepInpData.lAgePeriod1 := 1;
            2: ttRepInpData.lAgePeriod2 := 1;
            3: ttRepInpData.lAgePeriod3 := 1;
            end;
            ttRepInpData.cRepPeriod := cFPer;
            ttRepInpData.wTypeData  := 0;
            insert current ttRepInpData;
          }
//====================================================================================================================
          if isvalid(#ttRepInpItog1)
          {
            ttRepInpItog1.lAgePeriod1++;
            update current ttRepInpItog1;
          }
          else
          {
            ClearBuffer(#ttRepInpItog1);
            //подразделение
            ttRepInpItog1.cTypeKat   := cFType;
            ttRepInpItog1.lAgePeriod1:= 1;
            ttRepInpItog1.cRepPeriod := cFPer;
            ttRepInpItog1.wTypeData  := 1;
            insert current ttRepInpItog1;
          }
//====================================================================================================================
          if isvalid(#ttRepInpItog2)
          {
            case wAge of 
            1: ttRepInpItog2.lAgePeriod1++;
            2: ttRepInpItog2.lAgePeriod2++;
            3: ttRepInpItog2.lAgePeriod3++;
            end;
            update current ttRepInpItog2;
          }
          else
          {
            ClearBuffer(#ttRepInpItog2);
            ttRepInpItog2.cTypeKat   := cFType;
            case wAge of 
            1: ttRepInpItog2.lAgePeriod1 := 1;
            2: ttRepInpItog2.lAgePeriod2 := 1;
            3: ttRepInpItog2.lAgePeriod3 := 1;
            end;
            ttRepInpItog2.cRepPeriod := cFPer;
            ttRepInpItog2.wTypeData  := 2;
            insert current ttRepInpItog2;
          }
//====================================================================================================================
          if isvalid(#ttRepInpItog3)
          {
            case wAge of 
            1: ttRepInpItog3.lAgePeriod1++;
            2: ttRepInpItog3.lAgePeriod2++;
            3: ttRepInpItog3.lAgePeriod3++;
            end;
            update current ttRepInpItog3;
          }
          else
          {
            ClearBuffer(#ttRepInpItog3);
            case wAge of 
            1: ttRepInpItog3.lAgePeriod1 := 1;
            2: ttRepInpItog3.lAgePeriod2 := 1;
            3: ttRepInpItog3.lAgePeriod3 := 1;
            end;
            ttRepInpItog3.cRepPeriod := cFPer;
            ttRepInpItog3.wTypeData  := 3;
            insert current ttRepInpItog3;
          }
//====================================================================================================================
          if isvalid(#ttRepInpItog4)
          {
            ttRepInpItog4.lAgePeriod1++;
            update current ttRepInpItog4;
          }
          else
          {
            ClearBuffer(#ttRepInpItog4);
            ttRepInpItog4.lAgePeriod1:= 1;
            ttRepInpItog4.cRepPeriod := cFPer;
            ttRepInpItog4.wTypeData  := 4;
            insert current ttRepInpItog4;
          }
//====================================================================================================================
        }
      }
    }
  }
}
procedure MadeStatByAppoint;
{
  iNextVisual('Формируем статистику по приемам.');
  _loop AllPers
  {
    if (('С' = AllPers.IsEmployee) or ('У' = AllPers.IsEmployee))
    _loop ttRepPeriod
    {
      if (not NextVisual) break;
      if GetFirst AllApp where (( IAppFuncs.GetAppNrec_OnDate(AllPers.NRec, ttRepPeriod.dEndPeriod) == AllApp.NRec )) <> tsOk
        continue;
      if not isvalid(#AllStruct) continue;
      if cCheckTypeKat(AllStruct.cInf3) = 0 or cCheckKat(AllApp.EmpCategory, cCheckTypeKat(AllStruct.cInf3)) = 0
        continue;
      if (Date(0,0,0) = AllApp.DismissDate) or (AllApp.DismissDate > ttRepPeriod.dEndPeriod)
      {
        //подсчитываем количество работников на конец периода
        if isvalid(#ttRepInpItog5)
        {
          ttRepInpItog5.lAgePeriod1++;
          update current ttRepInpItog5;
        }
        else
        {
          ClearBuffer(#ttRepInpItog5);
          ttRepInpItog5.lAgePeriod1:= 1;
          ttRepInpItog5.cRepPeriod := ttRepPeriod.nRec;
          ttRepInpItog5.wTypeData  := 5;
          insert current ttRepInpItog5;
        }
        //суммируем их возраст
        var lAgePerson : longint;
        lAgePerson := Year(ttRepPeriod.dEndPeriod) - Year(AllPers.BornDate);
        if lAgePerson > 100
        {
          sCode4Reason := AllPers.FIO;
          if getfirst ttLog where
          ((         'Дата рожд.'== ttLog.sMode
          and   AllPers.BornDate == ttLog.dDate
          and       sCode4Reason == ttLog.sFIO
          )) <> tsOk
          {
            clearbuffer(#ttLog);
            ttLog.sFIO    := sCode4Reason;
            ttLog.sMode   := 'Дата рожд.';
            ttLog.sReason := 'У сотрудника странная дата рождения.';
            ttLog.dDate   := AllPers.BornDate;
            insert current ttLog;
          }
        }
        if isvalid(#ttRepInpItog6)
        {
          ttRepInpItog6.lAgePeriod1 := ttRepInpItog6.lAgePeriod1 + lAgePerson;
          update current ttRepInpItog6;
        }
        else
        {
          ClearBuffer(#ttRepInpItog6);
          ttRepInpItog6.lAgePeriod1:= lAgePerson;
          ttRepInpItog6.cRepPeriod := ttRepPeriod.nRec;
          ttRepInpItog6.wTypeData  := 6;
          insert current ttRepInpItog6;
        }
      }
    }
  }
}

procedure MadeDataByDismiss;
{
  var bIsDo : boolean;
  iNextVisual('Формируем увольнения.');
  if isvalid(#DisPers)
  _loop DisPers
  {
    if ('С' = DisPers.IsEmployee or 'У' = DisPers.IsEmployee)
    if isvalid(#ttRepPeriod)
    _loop ttRepPeriod
    {
      if isvalid(#DisApp)
      _loop DisApp
      {
        if (not NextVisual) break;
        cFType:=cFKat:=cFPer:=0;wAge:=0;
        bIsDo := false;
        if DisPers.AppointLast = DisApp.nRec bIsDo := true;
        if not bIsDo
        { 
          if isvalid(#DisDoc) bIsDo := true;
        }
//#include GP_MadeDataOut.vpp      
        if bIsDo
        {
          if isvalid(#DisStruct)
          {
            cFType:= cCheckTypeKat(DisStruct.cInf3);
            if cFType = 0
            {
              sCode4Reason := 'Подр. '+iCatFunc.GetCatalogsCode(DisStruct.Department)+'/ № ставки '+DisStruct.SeqNmb;
              if getfirst ttLog where
              ((    'Доп.хар.' == ttLog.sMode
              and            0 == ttLog.dDate
              and sCode4Reason == ttLog.sFIO
              )) <> tsOk
              {
                clearbuffer(#ttLog);
                ttLog.sFIO    := sCode4Reason;
                ttLog.sMode   := 'Доп.хар.';
                ttLog.sReason := 'У СЕ ШР отсутствует доп. характеристика';
                ttLog.dDate   := 0;
                insert current ttLog;
              }
            }
          }
          if cFType <> 0
          {
//            cFKat := cCheckKat (DisApp.EmpCategory, cFType);
            cFKat := cCheckKat (DisStruct.EmpCategory, cFType);
            if cFKat = 0 
            {
              sCode4Reason := 'Подр. '+iCatFunc.GetCatalogsCode(DisStruct.Department)+'/ № ставки '+DisStruct.SeqNmb;
              if getfirst ttLog where
              ((   'Категория' == ttLog.sMode
              and            0 == ttLog.dDate
              and sCode4Reason == ttLog.sFIO
              )) <> tsOk
              {
                clearbuffer(#ttLog);
                ttLog.sFIO    := sCode4Reason;
                ttLog.sMode   := 'Категория';
                ttLog.sReason := 'У СЕ ШР не задана категория.';
                ttLog.dDate   := 0;
                insert current ttLog;
              }
            }
          }
          cFPer := ttRepPeriod.nRec;
          wAge  := wWhatAgePeriod(DisPers.BornDate, DisApp.DismissDate);
          if wAge = 0
          {
            sCode4Reason := DisPers.FIO;
            if getfirst ttLog where
            ((         'Дата рожд.'== ttLog.sMode
            and                  0 == ttLog.dDate
            and       sCode4Reason == ttLog.sFIO
            )) <> tsOk
            {
              clearbuffer(#ttLog);
              ttLog.sFIO    := sCode4Reason;
              ttLog.sMode   := 'Дата рожд.';
              ttLog.sReason := 'У сотрудника не задана дата рождения.';
              ttLog.dDate   := 0;
              insert current ttLog;
            }
          }
          wStaj := wWhatStajPeriod(DisPers.nRec,DisApp.DismissDate);
        }
        if cFType <> 0 and cFKat <> 0 and cFPer <> 0 and wAge <> 0
        {
          if wIsRasshifr = 1
          {
            clearbuffer(#ttLog);
            ttLog.sFIO  := DisPers.FIO;
            ttLog.sMode := 'Увольнение';
            ttLog.dDate := DisApp.DismissDate;
            insert current ttLog;
          }
          if isvalid(#ttRepOutData)
          {
            case wAge of 
            1: ttRepOutData.lAgePeriod1++;
            2: ttRepOutData.lAgePeriod2++;
            3: ttRepOutData.lAgePeriod3++;
            end;
            case wStaj of 
            1: ttRepOutData.lStajPeriod1++;
            2: ttRepOutData.lStajPeriod2++;
            3: ttRepOutData.lStajPeriod3++;
            end;
            update current ttRepOutData;
          }
          else
          {
            ClearBuffer(#ttRepOutData);
            //подразделение
            ttRepOutData.cTypeKat := cFType;
            //категория
            ttRepOutData.cEmplKat := cFKat;
            //возрастной интервал
            case wAge of 
            1: ttRepOutData.lAgePeriod1 := 1;
            2: ttRepOutData.lAgePeriod2 := 1;
            3: ttRepOutData.lAgePeriod3 := 1;
            end;
            case wStaj of 
            1: ttRepOutData.lStajPeriod1 := 1;
            2: ttRepOutData.lStajPeriod2 := 1;
            3: ttRepOutData.lStajPeriod3 := 1;
            end;
            ttRepOutData.cRepPeriod := cFPer;
            ttRepOutData.wTypeData  := 0;
            insert current ttRepOutData;
          }
//====================================================================================================================
          if isvalid(#ttRepOutItog1)
          {
            ttRepOutItog1.lAgePeriod1++;
            ttRepOutItog1.lStajPeriod1++;
            update current ttRepOutItog1;
          }
          else
          {
            ClearBuffer(#ttRepOutItog1);
            //подразделение
            ttRepOutItog1.cTypeKat   := cFType;
            ttRepOutItog1.lAgePeriod1:= 1;
            ttRepOutItog1.lStajPeriod1:= 1;
            ttRepOutItog1.cRepPeriod := cFPer;
            ttRepOutItog1.wTypeData  := 1;
            insert current ttRepOutItog1;
          }
//====================================================================================================================
          if isvalid(#ttRepOutItog2)
          {
            case wAge of 
            1: ttRepOutItog2.lAgePeriod1++;
            2: ttRepOutItog2.lAgePeriod2++;
            3: ttRepOutItog2.lAgePeriod3++;
            end;
            case wStaj of 
            1: ttRepOutItog2.lStajPeriod1++;
            2: ttRepOutItog2.lStajPeriod2++;
            3: ttRepOutItog2.lStajPeriod3++;
            end;
            update current ttRepOutItog2;
          }
          else
          {
            ClearBuffer(#ttRepOutItog2);
            ttRepOutItog2.cTypeKat   := cFType;
            case wAge of 
            1: ttRepOutItog2.lAgePeriod1 := 1;
            2: ttRepOutItog2.lAgePeriod2 := 1;
            3: ttRepOutItog2.lAgePeriod3 := 1;
            end;
            case wStaj of 
            1: ttRepOutItog2.lStajPeriod1 := 1;
            2: ttRepOutItog2.lStajPeriod2 := 1;
            3: ttRepOutItog2.lStajPeriod3 := 1;
            end;
            ttRepOutItog2.cRepPeriod := cFPer;
            ttRepOutItog2.wTypeData  := 2;
            insert current ttRepOutItog2;
          }
//====================================================================================================================
          if isvalid(#ttRepOutItog3)
          {
            case wAge of 
            1: ttRepOutItog3.lAgePeriod1++;
            2: ttRepOutItog3.lAgePeriod2++;
            3: ttRepOutItog3.lAgePeriod3++;
            end;
            case wStaj of 
            1: ttRepOutItog3.lStajPeriod1++;
            2: ttRepOutItog3.lStajPeriod2++;
            3: ttRepOutItog3.lStajPeriod3++;
            end;
            update current ttRepOutItog3;
          }
          else
          {
            ClearBuffer(#ttRepOutItog3);
            case wAge of 
            1: ttRepOutItog3.lAgePeriod1 := 1;
            2: ttRepOutItog3.lAgePeriod2 := 1;
            3: ttRepOutItog3.lAgePeriod3 := 1;
            end;
            case wStaj of 
            1: ttRepOutItog3.lStajPeriod1 := 1;
            2: ttRepOutItog3.lStajPeriod2 := 1;
            3: ttRepOutItog3.lStajPeriod3 := 1;
            end;
            ttRepOutItog3.cRepPeriod := cFPer;
            ttRepOutItog3.wTypeData  := 3;
            insert current ttRepOutItog3;
          }
//====================================================================================================================
          if isvalid(#ttRepOutItog4)
          {
            ttRepOutItog4.lAgePeriod1++;
            update current ttRepOutItog4;
          }
          else
          {
            ClearBuffer(#ttRepOutItog4);
            ttRepOutItog4.lAgePeriod1:= 1;
            ttRepOutItog4.cRepPeriod := cFPer;
            ttRepOutItog4.wTypeData  := 4;
            insert current ttRepOutItog4;
          }
//====================================================================================================================
        }
      }
    }
  }
}



#declare TableBorders
//++++++++++++++++++++++++++++++++++++++++++++++++
  xlFrameCells(xlInsideV or xlInsideH, xlThin,0,0, lBB, lCB, lBE, lCE);
  xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlThick,0,0, lBB, lCB, lBE, lCE);
//++++++++++++++++++++++++++++++++++++++++++++++++
#end

#define repT       2,    3,    2,    3
#define repT1      1,    3,    1,    3
#define repT2      2,    3,    2,    3
#define FrmHd    lRB,  lCE,  lRB,  lCE
#define FrmHu    lRB+1,lCE,  lRB+1,lCE
#define FrmHb    lRB+2,lCE,  lRB+2,lCE
#define FrmCl    lDE,  lSE,  lDE,  lSE
#define FrmBl    lRB,  lSE,  lDE,  lSE
#define FrmDat   lRB,    3,  lDE,  lCE
#define AllTab   lRB,  lCB,  lDE-1,lCE
#define LBR      '+chr(10)+' 

procedure PrintReportByAppoint;
var  lRB, lHS,
     lCB, lCE,
     lSB, lSE,
     lBB, lBE,
     lDB, lDE : longint;
{
  iNextVisual('Выгружаю приемы.');
  lRB  := 4;
  lHS  := 2;
  lDB  := lDE := lRB + lHS;
  lCB  := lCE := 1;

  iOut.StringValL('Динамика численности персонала (прием) с '+datetostr(dBeg,'DD.MM.YYYY')+' по '+datetostr(dEnd,'DD.MM.YYYY'),#repT1);
  xlSetFontSize(14,#repT1); xlSetFontStyle(xlBold,#repT1);
  iOut.StringValL(Trim(TOA1.GetNaming.GetFullName()),#repT2);
  xlSetFontSize(14,#repT2); xlSetFontStyle(xlBold,#repT2);

  iOut.HeaderIns2('Наименование категорий',          #FrmHd, 2); lCE := lCE + 2;
  _loop ttRepPeriod
  {
    if (not NextVisual) break;
    iOut.HeaderIns(ttRepPeriod.sNamePeriod,          #FrmHd, 3);
    iOut.Header1Row('до 30 лет',                     #FrmHu); lCE++;
    iOut.Header1Row('31-49 лет',                     #FrmHu); lCE++;
    iOut.Header1Row('свыше 50 лет',                  #FrmHu); lCE++;
  }
  iOut.HeaderIns(Year(dEnd)+' план',               #FrmHd, 3);
  iOut.Header1Row('до 30 лет',                     #FrmHu); lCE++;
  iOut.Header1Row('31-49 лет',                     #FrmHu); lCE++;
  iOut.Header1Row('свыше 50 лет',                  #FrmHu);
  
  lSB := 1;
  lBB := lRB; lBE := lDB-1;
  #TableBorders
  xlSetFontStyle(xlBold,lBB, lCB, lBE, lCE);
  _loop ttTypeKat ordered index ttTypeKatRepSort
  {
//    if isvalid(#ttRepICheck1)
//    {
      lSE := 1;
      lBB := lDE;
      iOut.StringValC(ttTypeKat.sAbbrTypeKat,#FrmCl); lSE++;
      iOut.StringValC('',#FrmCl); lSE++;
      xlSetFontStyle(xlBold,lDE, lCB, lDE, lCE);
      _loop ttRepPeriod
      {
        if isvalid(#ttRepInpItog1) 
          iOut.HeaderIns(ttRepInpItog1.lAgePeriod1,#FrmCl,3)
        else
          iOut.HeaderIns(0,#FrmCl,3);
        lSE := lSE+3;
        iOut.HeaderIns('',#FrmCl,3);
        if (not NextVisual) break;
      }
      lDE++;
      lSE := 2; iOut.StringValL('из них:',#FrmCl); lDE++;
      _loop ttEmplKat
      {
        lSE := 2; iOut.StringValL(ttEmplKat.sNameKat,#FrmCl); lSE++;
        _loop ttRepPeriod
        {
//          if isvalid(#ttRepICheck0)
//          {
            if isvalid(#ttRepInpData) 
            {
              iOut.IntegerVal(ttRepInpData.lAgePeriod1,#FrmCl); lSE++;
              iOut.IntegerVal(ttRepInpData.lAgePeriod2,#FrmCl); lSE++;
              iOut.IntegerVal(ttRepInpData.lAgePeriod3,#FrmCl); lSE++;
            }
            else
            {
              iOut.IntegerVal(0,#FrmCl); lSE++;
              iOut.IntegerVal(0,#FrmCl); lSE++;
              iOut.IntegerVal(0,#FrmCl); lSE++;
            }
//              lSE := lSE+3;
            if (not NextVisual) break;
//          }
        }
        lDE++;
      }
      lSE := 1; iOut.StringValL('Всего',#FrmCl); lSE := lSE+2;
      xlSetFontStyle(xlBold,lDE, lCB, lDE, lCE);
      _loop ttRepPeriod
      {
        if isvalid(#ttRepInpItog2)
        {
          iOut.IntegerVal(ttRepInpItog2.lAgePeriod1,#FrmCl); lSE++;
          iOut.IntegerVal(ttRepInpItog2.lAgePeriod2,#FrmCl); lSE++;
          iOut.IntegerVal(ttRepInpItog2.lAgePeriod3,#FrmCl); lSE++;
        }
        else
        {
          iOut.IntegerVal(0,#FrmCl); lSE++;
          iOut.IntegerVal(0,#FrmCl); lSE++;
          iOut.IntegerVal(0,#FrmCl); lSE++;
        }
//          lSE := lSE+3;
        if (not NextVisual) break;
      }
      lBE := lDE;
      #TableBorders
      lDE++;
//    }
  }
  lBB := lDE;
  lSE := 1;
  iOut.HeaderIns2('ЧИСЛЕННОСТЬ ПРИНЯТЫХ ПО ГОДАМ',#FrmCl, 2); lDE := lDE +2;
  iOut.HeaderIns ('ЧИСЛЕННОСТЬ ВСЕГО',               #FrmCl, 2); lDE++;
  iOut.HeaderIns ('СРЕДНИЙ ВОЗРАСТ',                 #FrmCl, 2); lDE++;
  iOut.HeaderIns ('ТЕКУЧЕСТЬ',                       #FrmCl, 2);
  lBE := lDE;
  lSE := 3;
  _loop ttRepPeriod
  {
    lDE := lBB;
    if (not NextVisual) break;
    if isvalid(#ttRepInpItog3)
    {
      iOut.IntegerVal(ttRepInpItog3.lAgePeriod1,#FrmCl); lSE++;
      iOut.IntegerVal(ttRepInpItog3.lAgePeriod2,#FrmCl); lSE++;
      iOut.IntegerVal(ttRepInpItog3.lAgePeriod3,#FrmCl); lSE++;
    }
    else
    {
      iOut.IntegerVal(0,#FrmCl); lSE++;
      iOut.IntegerVal(0,#FrmCl); lSE++;
      iOut.IntegerVal(0,#FrmCl); lSE++;
    }
    lSE := lSE - 3;
    lDE++;
    if isvalid(#ttRepInpItog4)
      iOut.HeaderIns(ttRepInpItog4.lAgePeriod1,#FrmCl,3)
    else
      iOut.HeaderIns(0,#FrmCl,3);
    lDE++;
    if isvalid(#ttRepInpItog5)
    {
      iOut.HeaderIns(ttRepInpItog5.lAgePeriod1,#FrmCl,3);
      iKolWork := ttRepInpItog5.lAgePeriod1;
    }
    else
    {
      iOut.HeaderIns(0,#FrmCl,3);
      iKolWork := 0;
    }
    lDE++;
    if isvalid(#ttRepInpItog6)
    {
      iMidAge := ttRepInpItog6.lAgePeriod1;
      iOut.HeaderIns(if(iMidAge <> 0 and iKolWork <> 0,round(iMidAge/iKolWork,2),'-'),#FrmCl,3)
    }
    else
      iOut.HeaderIns('-',#FrmCl,3);
    lDE++;
    if isvalid(#ttRepOutItog4)
      iOut.HeaderIns(if(iKolWork=0,'-',(ttRepOutItog4.lAgePeriod1/iKolWork*100)+'%'),#FrmCl,3)
    else
      iOut.HeaderIns('-',#FrmCl,3);

    lSE := lSE + 3;
  }
  lDE := lBB + 1;
  //выводим хвостики планового столбца
  iOut.HeaderIns('',#FrmCl,3); lDE++; iOut.HeaderIns('',#FrmCl,3); lDE++; iOut.HeaderIns('',#FrmCl,3); lDE++; iOut.HeaderIns('',#FrmCl,3);
  #TableBorders
  xlSetFontStyle(xlBold,lBB, lCB, lBE, lCE);
  
  var lTb : longint;
  for(lTb := 3 ;lTb < lCE; lTb := lTb + 3)
  {
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlThick,0,0, lRB, lTb, lDE, lTb + 2);
  }
  
  lSE := 2;
  xlSetColumnWidth(14,#FrmBl);
  xlSetColumnWidth(6, #FrmDat);
  xlSetNumberFormat('0;-0;"-"',lDB,3,lDE-2,lCE);
  iOut.xlRangeVert4C(lRB+1, 1);
  xlSetFontSize(11,#AllTab); 
  xlWrapText(#AllTab);
  xlFreeze(1,3);
}

procedure PrintReportByDismiss;
var  lRB, lHS,
     lCB, lCE,
     lSB, lSE,
     lBB, lBE,
     lDB, lDE : longint;
{
  iNextVisual('Выгружаю увольнения.');
  lRB  := 4;
  lHS  := 3;
  lDB  := lDE := lRB + lHS;
  lCB  := lCE := 1;

  iOut.StringValL('Динамика численности персонала (увольнение) с '+datetostr(dBeg,'DD.MM.YYYY')+' по '+datetostr(dEnd,'DD.MM.YYYY'),#repT1);
  xlSetFontSize(14,#repT1); xlSetFontStyle(xlBold,#repT1);
  iOut.StringValL(Trim(TOA1.GetNaming.GetFullName()),#repT2);
  xlSetFontSize(14,#repT2); xlSetFontStyle(xlBold,#repT2);

  iOut.HeaderIns3('Наименование категорий',          #FrmHd, 2); lCE := lCE + 2;
  _loop ttRepPeriod
  {
    if (not NextVisual) break;
    iOut.HeaderIns(ttRepPeriod.sNamePeriod,        #FrmHd, 6);
    iOut.HeaderIns('Возраст',                      #FrmHu, 3);
    iOut.Header1Row('до 30 лет',                   #FrmHb); lCE++;
    iOut.Header1Row('31-49 лет',                   #FrmHb); lCE++;
    iOut.Header1Row('свыше 50 лет',                #FrmHb); lCE++;
    iOut.HeaderIns('Стаж работы на предприятии',#FrmHu, 3);
    iOut.Header1Row('до 1 года',                   #FrmHb); lCE++;
    iOut.Header1Row('от 1 до 5 лет',               #FrmHb); lCE++;
    iOut.Header1Row('свыше 5 лет',                 #FrmHb); lCE++;
  }
  lCE--;
  
  lSB := 1;
  lBB := lRB; lBE := lDB-1;
  #TableBorders
  xlSetFontStyle(xlBold,lBB, lCB, lBE, lCE);
  _loop ttTypeKat ordered index ttTypeKatRepSort
  {
//    if isvalid(#ttRepOCheck1)
//    {
      lSE := 1;
      lBB := lDE;
      iOut.StringValC(ttTypeKat.sAbbrTypeKat,#FrmCl); lSE++;
      iOut.StringValC('',#FrmCl); lSE++;
      xlSetFontStyle(xlBold,lDE, lCB, lDE, lCE);
      _loop ttRepPeriod
      {
        if isvalid(#ttRepOutItog1) 
          iOut.HeaderIns(ttRepOutItog1.lAgePeriod1,#FrmCl,6)
        else
          iOut.HeaderIns(0,#FrmCl,6);
        lSE := lSE+6;
        iOut.HeaderIns('',#FrmCl,3);
        if (not NextVisual) break;
      }
      lDE++;
      lSE := 2; iOut.StringValL('из них:',#FrmCl); lDE++;
      _loop ttEmplKat
      {
//        if isvalid(#ttRepOCheck0)
//        {
          lSE := 2; iOut.StringValL(ttEmplKat.sNameKat,#FrmCl); lSE++;
          _loop ttRepPeriod
          {
            if isvalid(#ttRepOutData) 
            {
              iOut.IntegerVal(ttRepOutData.lAgePeriod1,#FrmCl); lSE++;
              iOut.IntegerVal(ttRepOutData.lAgePeriod2,#FrmCl); lSE++;
              iOut.IntegerVal(ttRepOutData.lAgePeriod3,#FrmCl); lSE++;
              iOut.IntegerVal(ttRepOutData.lStajPeriod1,#FrmCl); lSE++;
              iOut.IntegerVal(ttRepOutData.lStajPeriod2,#FrmCl); lSE++;
              iOut.IntegerVal(ttRepOutData.lStajPeriod3,#FrmCl); lSE++;
            }
            else
            {
              iOut.IntegerVal(0,#FrmCl); lSE++;
              iOut.IntegerVal(0,#FrmCl); lSE++;
              iOut.IntegerVal(0,#FrmCl); lSE++;
              iOut.IntegerVal(0,#FrmCl); lSE++;
              iOut.IntegerVal(0,#FrmCl); lSE++;
              iOut.IntegerVal(0,#FrmCl); lSE++;
            }
//              lSE := lSE+6;
            if (not NextVisual) break;
          }
          lDE++;
//        }
      }
      lSE := 1; iOut.StringValL('Всего',#FrmCl); lSE := lSE+2;
      xlSetFontStyle(xlBold,lDE, lCB, lDE, lCE);
      _loop ttRepPeriod
      {
        if isvalid(#ttRepOutItog2)
        {
          iOut.IntegerVal(ttRepOutItog2.lAgePeriod1,#FrmCl); lSE++;
          iOut.IntegerVal(ttRepOutItog2.lAgePeriod2,#FrmCl); lSE++;
          iOut.IntegerVal(ttRepOutItog2.lAgePeriod3,#FrmCl); lSE++;
          iOut.IntegerVal(ttRepOutItog2.lStajPeriod1,#FrmCl); lSE++;
          iOut.IntegerVal(ttRepOutItog2.lStajPeriod2,#FrmCl); lSE++;
          iOut.IntegerVal(ttRepOutItog2.lStajPeriod3,#FrmCl); lSE++;
        }
        else
        {
          iOut.IntegerVal(0,#FrmCl); lSE++;
          iOut.IntegerVal(0,#FrmCl); lSE++;
          iOut.IntegerVal(0,#FrmCl); lSE++;
          iOut.IntegerVal(0,#FrmCl); lSE++;
          iOut.IntegerVal(0,#FrmCl); lSE++;
          iOut.IntegerVal(0,#FrmCl); lSE++;
        }
//          lSE := lSE+6;
        if (not NextVisual) break;
      }
      lBE := lDE;
      #TableBorders
      lDE++;
//    }
  }
  lBB := lDE;
  lSE := 1;
  iOut.HeaderIns2('ВСЕГО УВОЛЕННЫХ ПО ГОДАМ',#FrmCl, 2); lDE++;
  lBE := lDE;
  lSE := 3;
  _loop ttRepPeriod
  {
    lDE := lBB;
    if (not NextVisual) break;
    if isvalid(#ttRepOutItog3)
    {
      iOut.IntegerVal(ttRepOutItog3.lAgePeriod1,#FrmCl); lSE++;
      iOut.IntegerVal(ttRepOutItog3.lAgePeriod2,#FrmCl); lSE++;
      iOut.IntegerVal(ttRepOutItog3.lAgePeriod3,#FrmCl); lSE++;
      iOut.IntegerVal(ttRepOutItog3.lStajPeriod1,#FrmCl); lSE++;
      iOut.IntegerVal(ttRepOutItog3.lStajPeriod2,#FrmCl); lSE++;
      iOut.IntegerVal(ttRepOutItog3.lStajPeriod3,#FrmCl); lSE++;
    }
    else
    {
      iOut.IntegerVal(0,#FrmCl); lSE++;
      iOut.IntegerVal(0,#FrmCl); lSE++;
      iOut.IntegerVal(0,#FrmCl); lSE++;
      iOut.IntegerVal(0,#FrmCl); lSE++;
      iOut.IntegerVal(0,#FrmCl); lSE++;
      iOut.IntegerVal(0,#FrmCl); lSE++;
    }
    lSE := lSE - 6;
    lDE++;
    if isvalid(#ttRepOutItog4)
      iOut.HeaderIns(ttRepOutItog4.lAgePeriod1,#FrmCl,6)
    else
      iOut.HeaderIns(0,#FrmCl,6);

    lSE := lSE + 6;
  }
  #TableBorders
  xlSetFontStyle(xlBold,lBB, lCB, lBE, lCE);
  
  var lTb : longint;
  for(lTb := 3 ;lTb < lCE; lTb := lTb + 6)
  {
    xlFrameCells(xlBorderL or xlBorderR or xlBorderT or xlBorderB, xlThick,0,0, lRB, lTb, lDE, lTb + 5);
  }
  iOut.xlRangeVert4C(lRB+2, 2);
  lSE := 2;
  xlSetColumnWidth(14,#FrmBl);
  xlSetColumnWidth(6, #FrmDat);
  xlSetRowHeight(30,5,1,5,1);
  xlSetFontSize(11,#AllTab); 
  xlSetNumberFormat('0;-0;"-"',lDB,3,lDE,lCE);
  xlWrapText(#AllTab);
  xlFreeze(1,3);
}

procedure PrintLog;
{
  iNextVisual('Выгружаю расшифровку.');

  var lDE,  lSE : longint;
  lDE := lSE := 1;
  if isvalid(#ttLog)
  {
    iOut.StringValC('Операция',#FrmCl); lSE++;
    iOut.StringValC('Дата'    ,#FrmCl); lSE++;
    iOut.StringValC('Значение',#FrmCl); lSE++;
    iOut.StringValC('Причина' ,#FrmCl);
    lDE++;
    _loop ttLog ordered index ttLogSort
    {
      if (not NextVisual) break;
      lSE := 1;
      iOut.StringValL(ttLog.sMode,#FrmCl); lSE++;
      iOut.DateVal(ttLog.dDate,#FrmCl); lSE++;
      iOut.StringValL(ttLog.sFIO,#FrmCl); lSE++;
      iOut.StringValL(ttLog.sReason,#FrmCl); lSE++;
      lDE++;
    }
    xlSetColumnWidth(14,1,1,lDE,1);
    xlSetColumnWidth(14,1,2,lDE,2);
    xlSetColumnWidth(40,1,3,lDE,3);
    xlSetColumnWidth(60,1,4,lDE,4);
  }
}

procedure Run;
{

  StartNewVisual(vtNumericVisual, vfTimer+vfBreak+vfConfirm,'Процесс...', 0);

  InitRepPeriod(dBeg, dEnd);
  initKatData;

  //приемы
  MadeDataByAppoint;
  MadeStatByAppoint;
  //dismiss
  MadeDataByDismiss;


  if (RecordsInTable(#ttRepInpData)=0) and (RecordsInTable(#ttRepOutData)=0)
  {
    message('Нет данных для отчета!', Error);
    stopvisual;
    abort;
    exit;
  }
  else
  {
    sFullName := GetDefaultUserPath + '#(GPNam)'+sFPF+'.xls';

    xlCreateExcel(sFullName, TRUE);
    xlAddSheet;
    xlAddSheet;
   
    xlSetActiveSheet(1);
    xlSetSheetName(1,'Приемы');
    PrintReportByAppoint;
    xlSetActiveSheet(2);
    xlSetSheetName(2,'Увольнения');
    PrintReportByDismiss;
    if isvalid(#ttLog)
    {
      xlSetActiveSheet(3);
      if wIsRasshifr = 1
        xlSetSheetName(3,'Расшифровка')
      else
        xlSetSheetName(3,'Протокол');
      PrintLog;
    }
    xlSetActiveSheet(1);
    xlKillExcel;
    StopVisual;
  }
}

