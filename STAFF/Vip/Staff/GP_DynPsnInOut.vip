    sKatWorker4 ('Рабочие'     ,,scStaffKatPodrRefsPick):{Font = {BackColor = if(sKatWorker4 = 'Не выбраны категории', ColorNeed, 0)}}, protect;
    sKatType1   ('АУП'         ,,scStaffKatPodrRefsPick):{Font = {BackColor = if(sKatType1 = 'Не выбраны категории', ColorNeed, 0)}}, protect;
    sKatType2   ('ПР'          ,,scStaffKatPodrRefsPick):{Font = {BackColor = if(sKatType2 = 'Не выбраны категории', ColorNeed, 0)}}, protect;
    sKatType3   ('КБ'          ,,scStaffKatPodrRefsPick):{Font = {BackColor = if(sKatType3 = 'Не выбраны категории', ColorNeed, 0)}}, protect;
    sKatType4   ('НИК'         ,,scStaffKatPodrRefsPick):{Font = {BackColor = if(sKatType4 = 'Не выбраны категории', ColorNeed, 0)}}, protect;
