    Соответствие категорий

    `Руководители` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    `Специалисты`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    `Служащие`     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    `Рабочие`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

    `АУП`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    `ПР`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    `КБ`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    `НИК`          .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

     [.] Печать расшифровки`
    
     <. ~С~формировать .>                         <. ~З~акрыть .>
  >>
end;

function sSetKatName(mSetKat: TPtr): string;
{
  if (getMarkerCount(mSetKat) = 0)
  {
    result := 'Не выбраны категории';
    exit;
  }
  else
    if (getMarkerCount(mSetKat) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetKat, 0, cTmp);
      if GetFirst KlKatego where (( cTmp == KlKatego.NRec )) = tsOk
        result := KlKatego.NaiKat;
      else
        result := '';
    }
    else
      result := 'Несколько категорий (' + string(getMarkerCount(mSetKat)) + ')';
}
function sSetTypName(mSetPdr: TPtr): string;
{
  if (getMarkerCount(mSetPdr) = 0)
  {
    result := 'Не выбраны категории';
    exit;
  }
  else
    if (getMarkerCount(mSetPdr) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetPdr, 0, cTmp);
        result := iCatFunc.GetCatalogsName(cTmp);
    }
    else
      result := 'Несколько категорий (' + string(getMarkerCount(mSetPdr)) + ')';
}

#declare CloseGpInterface
//++++++++++++++++++++++++++++++++++++++++++++++++
  DoneMarker(mKatWorker1,'#(GPInt)_mKat1_' + UserName());
  DoneMarker(mKatWorker2,'#(GPInt)_mKat2_' + UserName());
  DoneMarker(mKatWorker3,'#(GPInt)_mKat3_' + UserName());
  DoneMarker(mKatWorker4,'#(GPInt)_mKat4_' + UserName());
  DoneMarker(mKatType1,  '#(GPInt)_mTyp1_' + UserName());
  DoneMarker(mKatType2,  '#(GPInt)_mTyp2_' + UserName());
  DoneMarker(mKatType3,  '#(GPInt)_mTyp3_' + UserName());
  DoneMarker(mKatType4,  '#(GPInt)_mTyp4_' + UserName());
  SaveMyDsk(dBeg,        '#(GPInt)_dBeg');
  SaveMyDsk(dEnd,        '#(GPInt)_dEnd');
  SaveMyDsk(wIsRasshifr, '#(GPInt)_wIsRasshifr');
  closeinterface(cmDefault);
//++++++++++++++++++++++++++++++++++++++++++++++++
#end

handleevent
  cmInit:
  {
    var isOk      : boolean;
    
    if (not (ReadMyDsk(dBeg, '#(GPInt)_dBeg', false)))
      dBeg := date(1,1,year(Cur_Date));
    if (not (ReadMyDsk(dEnd, '#(GPInt)_dEnd', false)))
      dEnd := date(31,12,year(Cur_Date));
    if (not (ReadMyDsk(wIsRasshifr, '#(GPInt)_wIsRasshifr', false)))
      wIsRasshifr := 0;

    mKatWorker1 := initMarker('#(GPInt)_mKat1_' + UserName(), 8, 1000, 100);
    mKatWorker2 := initMarker('#(GPInt)_mKat2_' + UserName(), 8, 1000, 100);
    mKatWorker3 := initMarker('#(GPInt)_mKat3_' + UserName(), 8, 1000, 100);
    mKatWorker4 := initMarker('#(GPInt)_mKat4_' + UserName(), 8, 1000, 100);
    mKatType1   := initMarker('#(GPInt)_mTyp1_' + UserName(), 8, 1000, 100);
    mKatType2   := initMarker('#(GPInt)_mTyp2_' + UserName(), 8, 1000, 100);
    mKatType3   := initMarker('#(GPInt)_mTyp3_' + UserName(), 8, 1000, 100);
    mKatType4   := initMarker('#(GPInt)_mTyp4_' + UserName(), 8, 1000, 100);
    set sKatWorker1 := sSetKatName(mKatWorker1);
    set sKatWorker2 := sSetKatName(mKatWorker2);
    set sKatWorker3 := sSetKatName(mKatWorker3);
    set sKatWorker4 := sSetKatName(mKatWorker4);
    set sKatType1   := sSetTypName(mKatType1  );
    set sKatType2   := sSetTypName(mKatType2  );
    set sKatType3   := sSetTypName(mKatType3  );
    set sKatType4   := sSetTypName(mKatType4  );

    TOA.Bind(0);
  }
  cmPick:
  {
    case CurField of
      #sKatWorker1:
        if (RunInterface('PICKKAT1', 0, mKatWorker1, vfMultipleSelection) = cmDefault)
          set sKatWorker1 := sSetKatName(mKatWorker1);
      #sKatWorker2:
        if (RunInterface('PICKKAT1', 0, mKatWorker2, vfMultipleSelection) = cmDefault)
          set sKatWorker2 := sSetKatName(mKatWorker2);
      #sKatWorker3:
        if (RunInterface('PICKKAT1', 0, mKatWorker3, vfMultipleSelection) = cmDefault)
          set sKatWorker3 := sSetKatName(mKatWorker3);
      #sKatWorker4:
        if (RunInterface('PICKKAT1', 0, mKatWorker4, vfMultipleSelection) = cmDefault)
          set sKatWorker4 := sSetKatName(mKatWorker4);
      #sKatType1:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType1) = cmDefault)
          set sKatType1 := sSetTypName(mKatType1);
      #sKatType2:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType2) = cmDefault)
          set sKatType2 := sSetTypName(mKatType2);
      #sKatType3:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType3) = cmDefault)
          set sKatType3 := sSetTypName(mKatType3);
      #sKatType4:
        if (RunInterface('PICKCATALOGEX', -375, 0, Comp(100), mKatType4) = cmDefault)
          set sKatType4 := sSetTypName(mKatType4);
    end;
  }
  cmDelOnprotect:
  {
    case CurField of
      #sKatWorker1:
      {
        ClearMarker(mKatWorker1);
        set sKatWorker1 := sSetKatName(mKatWorker1);
      }
      #sKatWorker2:
      {
        ClearMarker(mKatWorker2);
        set sKatWorker2 := sSetKatName(mKatWorker2);
      }
      #sKatWorker3:
      {
        ClearMarker(mKatWorker3);
        set sKatWorker3 := sSetKatName(mKatWorker3);
      }
      #sKatWorker4:
      {
        ClearMarker(mKatWorker4);
        set sKatWorker4 := sSetKatName(mKatWorker4);
      }
      #sKatType1:
      {
        ClearMarker(mKatType1);
        set sKatType1 := sSetTypName(mKatType1);
      }
      #sKatType2:
      {
        ClearMarker(mKatType2);
        set sKatType2 := sSetTypName(mKatType2);
      }
      #sKatType3:
      {
        ClearMarker(mKatType3);
        set sKatType3 := sSetTypName(mKatType3);
      }
      #sKatType4:
      {
        ClearMarker(mKatType4);
        set sKatType4 := sSetTypName(mKatType4);
      }
    end;
  }
  cmOk:
  {
    if (dBeg = 0) or (dEnd = 0) or (dBeg > dEnd)
    {
      message('Задан некорректный период!');
    }
    else
    {
      if GetMarkerCount(mKatWorker1) = 0
      or GetMarkerCount(mKatWorker2) = 0
      or GetMarkerCount(mKatWorker3) = 0
      or GetMarkerCount(mKatWorker4) = 0 
      or GetMarkerCount(mKatType1 ) = 0 
      or GetMarkerCount(mKatType2 ) = 0 
      or GetMarkerCount(mKatType3 ) = 0 
      or GetMarkerCount(mKatType4 ) = 0 
      {message('Не установлена одна из категорий!');}
      else
      {
        Run;
        #CloseGpInterface
      }
    }
  }

  cmCancel:
  {
    #CloseGpInterface
  }
end;
end.



VipInterface UserReport_#(GPInt)R Implements IUserReport;
Interface UserReport_#(GPInt)R;

Procedure Run;
Begin
  runinterface(#(GPInt));
End;

Function GetReportName: String;
Begin
  GetReportName := '#(GPNam) (ЭМ)';
End;


Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Ведение картотеки сотрудников';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'STAFFMAINMENU';
  end;
end;

End.
