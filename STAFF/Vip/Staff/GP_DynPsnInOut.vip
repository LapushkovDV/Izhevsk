create view
from
  ttRepPeriod
, ttTypeKat
, ttEmplKat
, ttRepInpData
, ttRepInpData ttRepInpItog1
, ttRepInpData ttRepInpItog2
, ttRepInpData ttRepInpItog3
, ttRepInpData ttRepInpItog4
, ttRepInpData ttRepInpItog5
, ttRepInpData ttRepInpItog6
, ttRepInpData ttRepInpItog7
, ttRepInpData ttRepICheck0
, ttRepInpData ttRepICheck1
, ttRepOutData
, ttRepOutData ttRepOutItog1
, ttRepOutData ttRepOutItog2
, ttRepOutData ttRepOutItog3
, ttRepOutData ttRepOutItog4
, ttRepOutData ttRepOCheck0
, ttRepOutData ttRepOCheck1
, Persons      AllPers
, Persons      AppPers
, Persons      DisPers
, Appointments AllApp
, Appointments AppApp
, Appointments DisApp
, ContDoc      AllDoc
, ContDoc      AppDoc
, ContDoc      DisDoc
, StaffStruct  AllStruct
, StaffStruct  AppStruct
, StaffStruct  DisStruct
, KlKatego
, ttLog
where
((
//-------------------------------------------------------
              AppPers.nRec == AppApp.Person
and ttRepPeriod.dBegPeriod<<= AppApp.AppointDate and (ttRepPeriod.dEndPeriod >= AppApp.AppointDate)
and        AppApp.StaffStr == AppStruct.nRec
and           AppPers.nRec == AppDoc.Person
and                      1 == AppDoc.TypeOper and (AppDoc.cStr = AppApp.nRec)
//-------------------------------------------------------
and           DisPers.nRec == DisApp.Person
and ttRepPeriod.dBegPeriod<<= DisApp.DismissDate and (ttRepPeriod.dEndPeriod >= DisApp.DismissDate)
and        DisApp.StaffStr == DisStruct.nRec
and           DisPers.nRec == DisDoc.Person
and                      8 == DisDoc.TypeOper and (DisDoc.cStr = DisApp.nRec)
//-------------------------------------------------------
and         ttTypeKat.nRec == ttEmplKat.cTypeKat
and         ttTypeKat.nRec == ttRepInpData.cTypeKat
and         ttEmplKat.nRec == ttRepInpData.cEmplKat
and       ttRepPeriod.nRec == ttRepInpData.cRepPeriod
and                word(0) == ttRepInpData.wTypeData

and         ttEmplKat.nRec == ttRepICheck0.cEmplKat
and                word(0) == ttRepICheck0.wTypeData
and         ttTypeKat.nRec == ttRepICheck1.cTypeKat
and                word(1) == ttRepICheck1.wTypeData

and         ttTypeKat.nRec == ttRepInpItog1.cTypeKat
and       ttRepPeriod.nRec == ttRepInpItog1.cRepPeriod
and                word(1) == ttRepInpItog1.wTypeData

and         ttTypeKat.nRec == ttRepInpItog2.cTypeKat
and       ttRepPeriod.nRec == ttRepInpItog2.cRepPeriod
and                word(2) == ttRepInpItog2.wTypeData

and       ttRepPeriod.nRec == ttRepInpItog3.cRepPeriod
and                word(3) == ttRepInpItog3.wTypeData

and       ttRepPeriod.nRec == ttRepInpItog4.cRepPeriod
and                word(4) == ttRepInpItog4.wTypeData

and       ttRepPeriod.nRec == ttRepInpItog5.cRepPeriod
and                word(5) == ttRepInpItog5.wTypeData

and       ttRepPeriod.nRec == ttRepInpItog6.cRepPeriod
and                word(6) == ttRepInpItog6.wTypeData

and       ttRepPeriod.nRec == ttRepInpItog7.cRepPeriod
and                word(7) == ttRepInpItog7.wTypeData
//-------------------------------------------------------
and         ttTypeKat.nRec == ttEmplKat.cTypeKat
and         ttTypeKat.nRec == ttRepOutData.cTypeKat
and         ttEmplKat.nRec == ttRepOutData.cEmplKat
and       ttRepPeriod.nRec == ttRepOutData.cRepPeriod
and                word(0) == ttRepOutData.wTypeData

and         ttEmplKat.nRec == ttRepOCheck0.cEmplKat
and                word(0) == ttRepOCheck0.wTypeData
and         ttTypeKat.nRec == ttRepOCheck1.cTypeKat
and                word(1) == ttRepOCheck1.wTypeData

and         ttTypeKat.nRec == ttRepOutItog1.cTypeKat
and       ttRepPeriod.nRec == ttRepOutItog1.cRepPeriod
and                word(1) == ttRepOutItog1.wTypeData

and         ttTypeKat.nRec == ttRepOutItog2.cTypeKat
and       ttRepPeriod.nRec == ttRepOutItog2.cRepPeriod
and                word(2) == ttRepOutItog2.wTypeData

and       ttRepPeriod.nRec == ttRepOutItog3.cRepPeriod
and                word(3) == ttRepOutItog3.wTypeData

and       ttRepPeriod.nRec == ttRepOutItog4.cRepPeriod
and                word(4) == ttRepOutItog4.wTypeData
//-------------------------------------------------------
and        AllApp.StaffStr == AllStruct.nRec
and           AllPers.nRec == AllDoc.Person
and                      8 == AllDoc.TypeOper and (AllDoc.cStr = AllApp.nRec)
))
;

function sFPF : string; {sFPF := DateToStr(Cur_Date(),'_YYMMDD')+TimeToStr(Cur_Time(),'_HHMMSS');}

procedure InitRepPeriod(dBeg, dEnd : date);
{
  var wYear : word;
  var wMonth: word;
  var wKvart: word; 
  
  delete all from ttRepPeriod;
  wYear := Year(dBeg);
  while wYear <> Year(dEnd) do
  {
    ClearBuffer(#ttRepPeriod);
    ttRepPeriod.sNamePeriod := wYear;
    ttRepPeriod.sSortPeriod := wYear+'.1';
    ttRepPeriod.dBegPeriod  := Date( 1, 1,wYear);
    ttRepPeriod.dEndPeriod  := Date(31,12,wYear);
    insert current ttRepPeriod;
    wYear++;
  }
  for(wMonth := 1; wMonth <= 10; wMonth := wMonth + 3)
  {
    if date(1,wMonth,wYear) < dEnd
    {
      ClearBuffer(#ttRepPeriod);
      wKvart := 1+round(wMonth/3);
      ttRepPeriod.sNamePeriod := wKvart + ' квартал ' + wYear;
      ttRepPeriod.sSortPeriod := wYear+'.'+wKvart;
      ttRepPeriod.dBegPeriod  := Date( 1, wMonth,wYear);
      ttRepPeriod.dEndPeriod  := Sub_Day(Add_Months(Date(1, wMonth,wYear),3), 1);
      insert current ttRepPeriod;
    }
  }
}



function cCheckKat(cKat, cTypKat : comp) : comp;
{
  var iKatCodeSort : integer;

  iKatCodeSort := 0;
  if FoundMarker(mKatWorker4, cKat)
    iKatCodeSort := 4;
  else
    if FoundMarker(mKatWorker1, cKat)
      iKatCodeSort := 1;
    else
      if FoundMarker(mKatWorker2, cKat)
        iKatCodeSort := 2;
      else
        if FoundMarker(mKatWorker3, cKat)
          iKatCodeSort := 3;
  
  if getfirst ttEmplKat where((cTypKat == ttEmplKat.cTypeKat and iKatCodeSort == ttEmplKat.iSortKat)) = tsOk
  {
    cCheckKat := ttEmplKat.nRec;
  }
  else 
    cCheckKat := comp(0);

}

function cCheckTypeKat(cChTKat : comp) : comp;
{
  var sAbbr : string;
  var iTypeKatCodeSort : integer;

  iTypeKatCodeSort := 0;
  if FoundMarker(mKatType1, cChTKat)
    iTypeKatCodeSort := 1;
  else
    if FoundMarker(mKatType2, cChTKat)
      iTypeKatCodeSort := 2;
    else
      if FoundMarker(mKatType3, cChTKat)
        iTypeKatCodeSort := 3;
      else
        if FoundMarker(mKatType4, cChTKat)
          iTypeKatCodeSort := 4;
  if getfirst ttTypeKat where((iTypeKatCodeSort == ttTypeKat.iSortTypeKat)) = tsOk
  {
    cCheckTypeKat := ttTypeKat.nRec;
  }
  else
  {
    cCheckTypeKat := comp(0);
  }
}

