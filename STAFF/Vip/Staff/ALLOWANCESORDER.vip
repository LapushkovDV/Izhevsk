Function InsertDocSpec : boolean;
{
  result := false;
  if getfirst Cdoc1 = tsOK
   {
    Message('В приказе уже есть сотрудники', error);
     stop; abort; exit;
   }

 if (getfirst tTmpImport where tTmpImport.err <> '' ) = tsOK
 {
   message('В импортируемом файле есть ошибке. Загрузка прервана', error );
   stop; abort; exit;
 }

  if _cTypeOper = 20
      {
        if (getfirst tTmpImport where tTmpImport.Sumdop = 0) = tsOK {
              message('В импортируемом файле есть ошибке. Загрузка прервана', error );
              stop; abort; exit;
        }
      }

  //вставляем в contdoc and raise and raisehist

      var wrec : longint = 0;

    _loop tTmpImport
     if isvalidall(tnPer)
     {
     //contdoc
        wrec++;
           clearbuffer(tnCdoc1);
             Cdoc1.nrec    := GetNextNrec(#Cdoc1, 0);
             Cdoc1.cpart   := _cPartDoc ;
             Cdoc1.person  := Per.nrec      ;
             Cdoc1.cdopref := Per.DEPARTMENT;
             Cdoc1.CSTR    := per.appointcur;
             Cdoc1.wrec    := wrec;
             Cdoc1.numpart := 1;
             Cdoc1.objtype := 1;
             Cdoc1.seqnmb  := 1;
            insert current cdoc1;
         //Raise and RaiseHist

         clearbuffer(tnr1);

         if (_cTypeOper = 9 or _cTypeOper = 104 or _cTypeOper = 105) {

            //проверка на дату назначения надбавки
            if getfirst  AppR where ((tTmpImport.BegDate >>= AppR.APPOINTDATE
                                     and tTmpImport.cPers == AppR.person)) != tsOK {
               message ('Дата установки надбавки меньше даты приёма или последнего перевода сотрудника');
               break;
             }

             r1.nrec      := GetNextNrec(#r1, 0);
             r1.raisetype := tTmpImport.raisetype;
             r1.sum       := tTmpImport.Sumdop;
             r1.raiseattr := tTmpImport.VidValue;
             r1.fromdate  := tTmpImport.BegDate;
             r1.todate    := tTmpImport.EndDate;
             r1.crdop     := Cdoc1.nrec;
             r1.person    := Cdoc1.person;
             r1.appoint   := per.appointcur;
            insert current r1;

            clearbuffer(tnRH);
             RH.nrec       := GetNextNrec(#RH, 0);
             RH.Craise     := r1.nrec;
             RH.wtypeoper  := _cTypeOper;
             RH.drec       := tTmpImport.BegDate;
             RH.docdate    := tTmpImport.EndDate;
             RH.craisetype := r1.raisetype;
             RH.ihattr     := tTmpImport.VidValue;
             RH.cpsn       := Cdoc1.person;
             RH.ccontdoc   :=  Cdoc1.nrec;
             RH.ddat2      := tTmpImport.EndDate;
             RH.DOCNMB     := TitleDoc.DocNmb;
             RH.RHSUM      := tTmpImport.Sumdop;
            insert current RH;
         }

      if (_cTypeOper = 20) {
            clearbuffer(tnfortune);
             fortune.cfcont    := Cdoc1.nrec;
             fortune.docnmb    := TitleDoc.DocNmb;
             Fortune.DocDate   := TitleDoc.DocDate;
             fortune.docsum    := tTmpImport.Sumdop;
             fortune.wchoice   := 20;
             fortune.dat1      := tTmpImport.BegDate;
             fortune.fortattr  := tTmpImport.VidValue;
             fortune.FILIALNO  := PDoc.WINF2;
             fortune.cftype    := tTmpImport.raisetype;
             fortune.fortattr := tTmpImport.VidValue;
            insert current fortune;
      }

     if (_cTypeOper = 10)  {

      clearbuffer(tndelraise)   ;
       delraise.iraseattr     := 2;
       delraise.wtypeinfo     := 1 ;
       delraise.cref1         := tTmpImport.cPers;
       delraise.cordercont1   := Cdoc1.nrec;
       delraise.cappointments := Cdoc1.cstr;
       delraise.craisetype    := tTmpImport.raisetype;

      if getfirst RDL where (( tTmpImport.cPers == RDL.person
                     and delraise.cappointments == RDL.appoint (noindex)
                        and delraise.craisetype == RDL.raisetype (noindex))) = tsOK {
        delraise.csource     := RDL.nrec;
        delraise.cordercont2 := RDL.crdop;
        delraise.dfromdate   := RDL.fromdate;
      }

       delraise.dsum3         := tTmpImport.Dsum3;
       delraise.wprizn2       := tTmpImport.VidDRaise;
       delraise.ccurrency     := tTmpImport.VidValue;
       delraise.draiseabort   := tTmpImport.dataDRaise;
      insert current delraise;
     }
   }
  result := true;
}


window wintTmpImport;
browse brtTmpImport;
 table tTmpImport;
fields {Font = {BackColor = if(tTmpImport.err <> '', colorError,0)}};
 tTmpImport.StrTabN     'Табельный номер'       : [ 5], Protect, NoPickButton;
 Per.Fio                'ФИО'                   : [10], Protect, NoPickButton;
 CatDopl.name           'Вид доплаты'           : [ 8], Protect, NoPickButton;
 tTmpImport.Kodvdop     'Код доплаты/надбавки'  : [ 3], Protect, NoPickButton;
 tTmpImport.Sumdop      'Сумма доп'             : [ 4,2], Protect, NoPickButton;
 tTmpImport.ChasF       'Часы'                  : [ 4,2], Protect, NoPickButton;
 tTmpImport.VidValue    'Код валюты'            : [ 2], Protect, NoPickButton;
 tTmpImport.BegDate     'С даты'                : [ 4], Protect, NoPickButton;
 tTmpImport.EndDate     'По дату'               : [ 4], Protect, NoPickButton;
 tTmpImport.err         'Описание ошибки'       : [10], Protect, NoPickButton;
 tTmpImport.VidDRaise   'Вид снятия'           : [ 4], Protect, NoPickButton;
 tTmpImport.Dsum3       '% снижения'           : [ 4,4], Protect, NoPickButton;
 tTmpImport.dataDRaise1 'Снизить по дату'      : [ 4], Protect, NoPickButton;
 tTmpImport.dataDRaise  'Дата снятия'          : [ 4], Protect, NoPickButton;

end;
handleevent
CmInit: {
   if getfirst tTmpImport = tsOK {}
   Rereadrecord;
 }
cmHotKeys:{
    PutHotCommand(RunMenu('mnuAllowancesorderImportDocs'));
}
cmValue1: {
  if (_cTypeOper = 12) then
  {
    Create_RPD12();
    PutCommand(cmClose);
  }
  else
  {
    if InsertDocSpec then PutCommand(cmClose);
  }
}
cmValue2: {
   CalcSDZ;
   rereadrecord;
}
end;
end;

