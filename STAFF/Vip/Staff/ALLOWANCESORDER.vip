Screen FileExel;
fields
  Name_File : protect,pickbutton;

buttons
  cmOk,,,'Загрузить файл', ,sci1Esc;
  cmCancel,,,'Выход', ,sci1Esc;


<<
    Файл .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

    <.~З~агрузить.>           <.~О~тмена.>
>>
end;


handleevent

CmInit:         //не используем
{
  if getfirst titledoc <> tsOK
   {
     Message('Не найден приказ ' + _cTitleDoc, error);
     stop; abort; exit;
   }
  if getfirst PDoc <> tsOK
   {
     Message('Не найдена часть приказа (PartDoc) ' + _cPartDoc, error);
     stop; abort; exit;
   }

   _cTypeOper := PDoc.typeoper;

   if getfirst Catalogs where ((-17  == Catalogs.sysCode)) <> tsOK
    {
     Message('Не найден справочник "Виды доплат/единовременных выплат" (syscode = -17)', error);
     stop; abort; exit;
    }
  _cMainLinkDoplat := Catalogs.nrec;

  if getfirst Cdoc1 = tsOK
   {
    Message('В приказе уже есть сотрудники', error);
     stop; abort; exit;
   }
}


//проверка названий столбцов
cmPick:
{
  case CurField of
    #Name_File: {
      Name_File := GetFileName('*.xls*','Выберите файл');
      if Name_File != ''
      {
         set Name_File:=Name_File;
      }
      //else exit;
    }
  end;
}


  //импортируем
cmOK:
{
  if (_cTypeOper = 12) then
  {
    ReadExcel_RPD12();
  }
  else
  {
    if _log = '' then _log:= GetStringParameter('Files', 'OutputFilesDirectory', 0)+'\RPD_ImportEXCEL_LOG_'+Username+'_'+datetostr(cur_date,'YYYYMMDD')+timetostr(cur_time,'HHMMSS')+'.log';
    StartNewVisual(vtRotateVisual, vfTimer, 'Импорт данных', 1);
    deletefile(_log);
    _ListName := 'Лист1';
    delete all tTmpImport;
    fillrecArrayByTypeTable(_log);
    var _isError : boolean = (not CheckFileFillValues(Name_File, _log));
    //   CheckRawData_Import(_log);
    stopVisual;
    ProcessText(_log,vfRunModal Or vfNewTitle,'Протокол загрузки данных');

    if (_cTypeOper = 10) then {
      ClearFieldState(#tTmpImport.Sumdop , sfVisible);
      ClearFieldState(#tTmpImport.BegDate, sfVisible);
      ClearFieldState(#tTmpImport.EndDate, sfVisible);
      ClearFieldState(#tTmpImport.ChasF  , sfVisible);
     }
     else {
       ClearFieldState(#tTmpImport.VidDRaise  , sfVisible);
       ClearFieldState(#tTmpImport.Dsum3      , sfVisible);
       ClearFieldState(#tTmpImport.dataDRaise1, sfVisible);
       if _cTypeOper = 20
       {
         if (getfirst tTmpImport where tTmpImport.ChasF <> 0) <> tsOK then {
            ClearFieldState(#tTmpImport.ChasF  , sfVisible);
            DisableCommand(cmValue2);
         }
       }
     }
  }



/*
  if getfirst tTmpImport = tsOK
  if (_cTypeOper = 10)
   then runwindowmodal(wintTmpImport1)
   else runwindowmodal(wintTmpImport);
*/
  runwindowmodal(wintTmpImport);
  CloseInterface(-1);
