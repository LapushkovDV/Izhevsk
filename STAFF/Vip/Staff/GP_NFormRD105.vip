#include CatFunc.vih         // Функции работы с Catalogs
#include StrFunc.vih         // Функции работы со строками
#include DeptIer.vih         // Функции работы с подразделениями
#include AppFuncs.vih

#define RD 105 //#(RD)

#doc
Печать группового приказа "Приказ о премировании (для передачи в бухгалтерию)" РД #(RD)
#end
interface GP_NFormRD#(RD) 'Приказ о премировании (для передачи в бухгалтерию)' (,,scStaffEmplMain) EscClose;
  show at (00,05,80,15);

table struct ttReport
(
  sDepName  : string
, sTbNmb    : string
, sFIO      : string
, sPost     : string
, sDogN     : string
, sRaiseName: string
, dbSum     : double
, dFrom     : date
, dTo       : date
)
with index
(
  ttReport01 = sFIO
);

Create view MakeReport1View
var
  cDoc       : comp;
  PersNrec   : comp;
  iOper      : integer;
  iCatFunc   : CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
  iStrFunc   : StringFunctions;     // Переменная типа интерфейс StringFunctions
  iAppFunc   : AppointmentsFunctions;
  IDepartIer : DepartIer;           // Переменная типа интерфейс DepartIer

as  select
  *

from
  TitleDoc
, PartDoc
, ContDoc
, Persons
, Appointments
, RaiseHist
, GP_RaiseHistExt#(RD)
, SpAllStaff SpAS_Cnt
, SpAllStaff SpAS_Agr
, ttReport (ttReport01)

where
((              cDoc == TitleDoc.Nrec             
and            iOper == PartDoc.TypeOper          
and    TitleDoc.Nrec == PartDoc.cDoc              
and     PartDoc.Nrec == ContDoc.cPart             
and PartDoc.TypeOper == ContDoc.TypeOper
and   ContDoc.Person == Persons.Nrec              
and     ContDoc.cStr == Appointments.Nrec         
and     ContDoc.Nrec == RaiseHist.cContDoc
and   RaiseHist.nrec == GP_RaiseHistExt#(RD).cRaiseH

and                    7 == SpAS_Cnt.wNoCon  //Ищем ссылку на допсоглашение отображаемое непосредственно в приказе
and         contdoc.NRec == SpAS_Cnt.CLINKT  //независимо от того что в карточке
and                    0 == SpAS_Cnt.INUM    //допсоглашение из карточки устарело?
and            coContDoc == SpAS_Cnt.WCHOISE 
and      SpAS_Cnt.cBaseT == SpAS_Agr.nRec
))
;
parameters cDoc, iOper;

DataStream DTS_NForm#(RD)
(
  [RepOnDate]    DateToStr(TitleDoc.DocDate,'month YYYY года.');
  [DocDate]      TitleDoc.DocDate;
  [DocNmb]       TitleDoc.DocNmb;
  [sSignPost]    iAppFunc.GetAppPost(iAppFunc.GetAppNrec_OnDate(coGetTune('UP.STAFF.SIGNATORYAUTHORITY'),cur_date));
  [sSignFIO]     iStrFunc.GetFIO(sGetTune('UP.STAFF.SIGNATORYAUTHORITY'));
  table ttReport
  (
    [DepName]       ttReport.sDepName;
    [TabNmb]        ttReport.sTbNmb;
    [FIO]           ttReport.sFIO;
    [Post]          ttReport.sPost;
    [NoDogGost]     ttReport.sDogN;
    [Sum]           ttReport.dbSum;
    [dFrom]         ttReport.dFrom;
    [dTo]           ttReport.dTo;
    [RaiseName]     ttReport.sRaiseName;
  );
)// DataStream DTS_NForm
end;
//──────────────────────────────────────────────────────────────────────────────
//  печать в FastReport
//──────────────────────────────────────────────────────────────────────────────
Procedure PrintNForm#(RD)FR;
{
  if isvalid(#TitleDoc)
  if isvalid(#PartDoc)
  _loop PartDoc
  {
    if isvalid(#ContDoc)
    _loop ContDoc
    {
      if isvalid(#RaiseHist)
      _loop RaiseHist
      {
        ClearBuffer(#ttReport);
        if isvalid(#Persons)
        {
          ttReport.sTbNmb:= if (Appointments.lPrizn = 0, GetStrTabn(Persons.TabNmb,Persons.StrTabn), 
                                                         GetStrTabN(Appointments.AppTabNmb, Appointments.StrTabN));
          ttReport.sFIO  := Persons.FIO;    
        }
        if isvalid(#Appointments)
        {
          ttReport.sDepName:= iDepartIer.GetFulDepName(Appointments.Department);
          ttReport.sPost := if ( boGetTune('UP.STAFF.USE_LONGNAME_ANK'),trim(iCatFunc.GetCatalogsLongName(Appointments.Post)),
                                                                        trim(iCatFunc.GetCatalogsName(Appointments.Post)));
        }
        ttReport.dbSum      := RaiseHist.RHSUM;
        ttReport.dFrom      := RaiseHist.dRec;
        ttReport.dTo        := RaiseHist.dDat2;
        ttReport.sRaiseName := iCatFunc.GetCatalogsName(RaiseHist.cRaiseType);
        if isvalid(#SpAS_Cnt)
          if isvalid(#SpAS_Agr)
            ttReport.sDogN   := SpAS_Agr.RESSTRING[1]+' от '+datetostr(SpAS_Agr.RESDATE[1],'DD.MM.YYYY');
        insert current ttReport;
      }
    }
  }
  RunFReport(DTS_NForm#(RD), '', False);
}

//──────────────────────────────────────────────────────────────────────────────
HandleEvent
cmInit:
  {
    PrintNForm#(RD)FR;
    CloseInterface(cmDefault);
  }       // cmInit
end;      // HandleEvent
end.
