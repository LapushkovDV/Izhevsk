/*************************************************************************************************\
* Наименование:  Копирование режимов работ                                                        *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Запуск - Учет времени - Режимы работ                                             *
*                Необходимо реализовать функционал по копированию режимов работ с шаблонами       *
*                 и возможностью указания кол-ва дней сдвига.                                     *
*                Требования:                                                                      *
*                1) Возможность указания кол-ва создаваемых режимов;                              *
*                2) Возможность указания кол-ва дней сдвига относительно копируемого режима;      *
*                3) Добавить шаг сдвига для последующих режимов;                                  *
*                4) Добавить checkbox для определения учитывать, или нет шаблон режима            *
*                Быстродействие функции SH_CreateHierarchyExt                                     *
* Примечание 761: Добавлено поле "Производственный календарь".                                    *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#841          |24/07/17|Кириллов Э.П.            |НПО Энергомаш                    *
* Разработка  |#761          |22/09/17|Тищенко Р.Н.             |НПО Энергомаш                    *
* Доработка   |#89424        |22/01/25|Андреев С.И.             |СКУД, Гибкий график              *
\*************************************************************************************************/
#include GP_MenuDynamic.vih
#include ExtAttr.Vih
#include ExtClass.vih
#include AttrTablePick.vih
#include GP_ExtClass.vih

#component "Z_CALENDAR"

Alter Interface KLREJIM;

  const
    EXT_CL_WORK_TIME = 'Продолжительность рабочего времени';
    EXT_CL_SHIFT_NUM = 'Номер смены';
  end;

  #include GP_ExtClass.var

  var
    //-------- Параметры  для клонирования
    wClone_Type  :word;//Режим клонирования
    wClone_Sdvig :word;//Дней для сдвига
    wClone_Copy  :word;//
    wClone_Step  :word;//шаг клонирования
    //--------------------------
    oExtAttr: iExtAttr;
    oExtClass: iExtClass;
    refAttrTablePick: AttrTablePick;
    WorkTimeClassCode, ShiftNumClassCode: Word;

  create view
    as select
      (oExtClass.GetSegName(WorkTimeClassCode, KlRejim.NRec)) (FieldName = WorkTime),
      (oExtClass.GetSegName(ShiftNumClassCode, KlRejim.NRec)) (FieldName = ShiftNum)
    from
      GP_KlRejim,
      GP_TimeNorms,
      // AttrNam,
      synonym KlRejim KlRejimL
    where ((
          KlRejim.NRec                 == GP_KlRejim.cKlRejim
      and GP_KlRejim.cGP_PrCal         == GP_PrCal.NRec
      and Year(dGetTune('UP.DATOTCH')) == GP_TimeNorms.Year
      and GP_KlRejim.cGP_PrCal         == GP_TimeNorms.cGP_PrCal
    ));

  //**************************************
  Create view vSpr //vklrejim
  var
    pklrejim_Clone:comp;
    pTempalate_Clone:comp;
  as select klrejim_Clone.Nrec
  From
     klrejim klrejim_Clone
   , GRAFIK Tempalate_Clone
   , klrejim klrejim_Find(KLREJIM01)
   , SpGraf SpGraf_Clone
   , SpGraf SpGraf_Clone1
  where ((
      pklrejim_Clone   == klrejim_Clone.Nrec
  and pTempalate_Clone == Tempalate_Clone.NREC
  and pTempalate_Clone == SpGraf_Clone.cGrafik
  // Для копирования буфера
  and SpGraf_Clone.Nrec== SpGraf_Clone1.Nrec
  ));

  //******************************************************************************
  // Визуальная часть
  //******************************************************************************
  Window wnCloneParam 'Параметры клонирование режима'  Cyan, EscClose;
    Show at (,,72,7);
  Screen scrClone '' ('Параметры клонирование режима',,sci1Esc);
  Table klrejim;
  Fields
    klrejim.Rejim  : Protect,NoPickButton,NoDel;
    klrejim.NRejim : Protect,NoPickButton,NoDel;
    wClone_Copy  (,,):NoProtect;//
    wClone_Type  (,,):NoProtect;//Режим клонирования
    wClone_Sdvig (,,):NoProtect;//Дней для сдвига
    wClone_Step  (,,):NoProtect;//шаг клонирования
  Buttons
    cmOk    ,,, 'Задать учебный год', hcAllBOk, scGalDial;
    cmCancel,,, 'Отмена', hcAllBCancel, scGalDial;
  <<
 `Режим работ для клонирования`.@@@@@@@.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Количество копий режима`     .@@@@@@@@@@
 [.] Создавать новый шаблон` `кол-во дней сдвига`.@@@@@ `c шагом`.@@@@

 <. Продолжить .>  <.   Отмена   .>
  >>
  end; //Screen scrFilter (,,sci13Esс);

  HandleEvent
  cmInit:
  { wClone_Copy :=1;
    wClone_Type :=1;
    wClone_Sdvig:=1;
    wClone_Step :=1;
  }
  cmOk:
  { CloseWindowEx(wnCloneParam,cmDefault)

  }
  end; // HandleEvent
  end; // Windows wnFilter 'Установите фильтры' , Cyan, EscClose;

  //--------------------------------------
  extendFormats RRR, RejimInfo;
  //--------------------------------------

  browse RRR;
    table KlRejim;
  fields
    GP_PrCal.Name 'Производственный', 'календарь' ('Производственный календарь',, sci1378InsPM): [20], protect, pickButton;
    TempalateGrafik.Name 'Шаблон' ('Шаблон',, sci1378InsPM): [20], protect, pickButton;
  end;
  //--------------------------------------
  screen RejimInfo;
  fields
    GP_TimeNorms.Hours ('Среднее количество часов в месяце'): [5.2], skip;
    WorkTime ('Продолжительность рабочего времени',, sci1378InsPM): protect, pickbutton;
    ShiftNum ('Номер смены',, sci1378InsPM): protect, pickbutton;
  <<





















  .@@@@@@@@@


 `Продолжительность рабочего времени`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Номер смены`.@@@@@@@@@@@@@@@@@@@@@
  >>
  end;

  //******************************************************************************
  // Функции
  //******************************************************************************

  //------------------------------------
  // Клонирование режимов работ
  //------------------------------------
  Function CloneRejim:boolean;
  var _wClone_Sdvig:word;
      ii :word;
      _pCalendar:comp;// ссылка на шаблон
  { Result:=false;
    if not isValid(#KlRejim)
    { Message('Нет режимов для клонирования');
      Exit;
    }
    IntInit;
    if RunWindowModal(wnCloneParam)<>cmDefault exit;
    if wClone_Copy=0
    { Message('На задано кол-во копий режима');
    }
    vSpr.pklrejim_Clone:=KlRejim.Nrec;
    _pCalendar:=KLREJIM.cCalendar;
    if (wClone_Type and 1)>0
    if getfirst  TempalateGRAFIK<>tsok
    { Displ('В клонируемом режиме не задан шаблон');
      set wClone_Type:=wClone_Type xor 1;
    }
    _wClone_Sdvig:=wClone_Sdvig;
    For(ii:=1;ii<=wClone_Copy;ii++)
    { vSpr.pTempalate_Clone:=KLREJIM.cCalendar;
      _pCalendar:=KLREJIM.cCalendar;
      if vSpr.Getfirst klrejim_Clone=tsok    { }

      //копируем шаблон
      if (wClone_Type and 1)>0 and KLREJIM.cCalendar>0
      { if vSpr.getfirst Tempalate_Clone=tsok {}
        vSpr.Tempalate_Clone.Nrec:=0;
        vSpr.Tempalate_Clone.CODE:=TempalateGRAFIK.Code+'_'+String(ii+1);
        vSpr.Tempalate_Clone.Name:=TempalateGRAFIK.Name+'_'+String(ii+1);
        vSpr.Insert Current Tempalate_Clone;
        Displ('Создан шаблон '+string(vSpr.Tempalate_Clone.CODE)+' '+vSpr.Tempalate_Clone.Name);

        //Запомним здесь - еще дни копировать
        _pCalendar:=vSpr.Tempalate_Clone.Nrec;
        //vSpr.pTempalate_Clone;
        //Здесь нужно перетусовать дни с учетом сдвига.
        //сначала найдем  длину периода
        var _MaxDay:word;_MaxDay:=0;

        vSpr._Loop fullcache SpGraf_Clone
        { if _MaxDay<Year(vSpr.SpGraf_Clone.dDate)
            _MaxDay:=Year(vSpr.SpGraf_Clone.dDate);
        }

        vSpr._Loop fullcache SpGraf_Clone
        { if vSpr.GetFirst SpGraf_Clone1=tsok {}
          var _next_npp:word;

          _next_npp:=year(vSpr.SpGraf_Clone.dDate)+_wClone_Sdvig;
          //перемещаем последние дни в начало
          if _next_npp>_MaxDay _next_npp:=_next_npp-_MaxDay;
          vSpr.SpGraf_Clone1.dDate:=::Date(day(vSpr.SpGraf_Clone.dDate)
                                       ,month(vSpr.SpGraf_Clone.dDate)
                                       ,_next_npp
                                       );
          vSpr.SpGraf_Clone1.Nrec    :=0;
          vSpr.SpGraf_Clone1.cGrafik :=_pCalendar;
          vSpr.Insert Current SpGraf_Clone1;
        } //vSpr._Loop fullcache SpGraf_Clone

      } //if (wClone_Type and 1)>0 and KLREJIM.cCalendar>0

      // создаем сам режим
      if vSpr.GetLast klrejim_Find=tsok
      { vSpr.klrejim_Clone.Rejim:=vSpr.klrejim_Find.Rejim+1;
        if klrejim.rejimc = klrejim.rejim
        { vSpr.klrejim_Clone.Rejimc:=vSpr.klrejim_Clone.Rejim;

        }

      }
      vSpr.klrejim_Clone.Nrec:=0;
      vSpr.klrejim_Clone.cCalendar:=_pCalendar;
      vSpr.klrejim_Clone.Nrejim:=vSpr.klrejim_Clone.Nrejim+'_'+String(ii+1);
      vSpr.insert current klrejim_Clone;
      Displ('Создан режим '+string(vSpr.klrejim_Clone.Rejim)+' '+vSpr.klrejim_Clone.Nrejim);
      _wClone_Sdvig:=_wClone_Sdvig+wClone_Step;

    } //For(ii:=1;ii<=wClone_Copy;ii++)
    ReReadRecord(#KlRejim);
    if getlast klrejim=tsok {}
    ReScanPanel(#KlRejim);
    ShowErrors();
    ExitProc;
    Result:=True;
  } //Function CloneRejim:boolean;

  //*****************************************************
  tableEvent table KlRejim ;
    cmSetDefault:
      begin
        case inherited::handleEvent(cmSetDefault) of
          heAbort: { abort; exit; }
          heStop: { stop; exit; }
        end;
        KlRejim.NRec := GetNextNRec(tnKlRejim, 0);
        ClearBuffer(#GP_KlRejim);
        GP_KlRejim.cKlRejim := KlRejim.NRec;
        if (getLast KlRejimL ordered by KlRejimL.Rejim) = tsOk then
          KlRejim.Rejim := KlRejimL.Rejim + 1
        else
          KlRejim.Rejim := 1;
      end;
    cmInsertRecord:
      begin
        case inherited::handleEvent(cmInsertRecord) of
          heAbort: { abort; exit; }
          heStop: { stop; exit; }
        end;
        if IsValidAll(tnKlRejim) then
          insert current GP_KlRejim;
      end;
    cmUpdateRecord:
      begin
        case inherited::handleEvent(cmUpdateRecord) of
          heAbort: { abort; exit; }
          heStop: { stop; exit; }
        end;
        if IsValidAll(tnGP_KlRejim) then
          update current GP_KlRejim
        else
          if KlRejim.NRec != 0 then
          begin
            GP_KlRejim.cKlRejim := KlRejim.NRec;
            insert current GP_KlRejim;
          end;
      end;
    cmDelOnProtect:
      begin
        case inherited::handleEvent(cmDelOnProtect) of
          heAbort: { abort; exit; }
          heStop: { stop; exit; }
        end;
        if EditMode then
          case CurField of
            #WorkTime:
              if UpdateTable then
                if IsValidAll(tnKlRejim) then
                  if oGP_ExtClass.DelAllValues(WorkTimeClassCode, KlRejim.NRec) then
                    RedrawPanel(#KlRejim);
            #ShiftNum:
              if UpdateTable then
                if IsValidAll(tnKlRejim) then
                  if oGP_ExtClass.DelAllValues(ShiftNumClassCode, KlRejim.NRec) then
                    RedrawPanel(#KlRejim);
            #GP_PrCal.Name:
              if IsValidAll(tnGP_KlRejim) then
                if GP_KlRejim.cGP_PrCal != 0 then
                begin
                  SetModified(true);
                  set GP_KlRejim.cGP_PrCal := 0;
                end;
          end;
      end;
    cmDeleteRecord:
      if IsValidAll(tnKlRejim) then
      begin
        var cDelRec: Comp = KlRejim.NRec;
        var RecDeleted: Boolean = true;
        case inherited::handleEvent(cmDeleteRecord) of
          heAbort: { abort; exit; }
          heStop: { stop; exit; }
        end;
        // Если после вызова родительского обработчика запись осталась валидной, значит удаление отменили
        if IsValidAll(tnKlRejim) and cDelRec = KlRejim.NRec then
          RecDeleted := false;
        // Если запись в KlRejim была удалена
        if RecDeleted then
          // Нужно удалить и запись в GP_KlRejim
          delete GP_KlRejim where ((cDelRec == GP_KlRejim.cKlRejim))
        else
          Message('Запись не удалена');
      end;
    cmCheckField:
      begin
        case inherited::handleEvent(cmCheckField) of
          heAbort: { abort; exit; }
          heStop: { stop; exit; }
        end;
        case CurField of
          // Если поле "Продолжительность интервала, часов" изменено вручную
          #KlRejim.Hours:
            // Если заполнено поле "Производственный календарь"
            if IsValidAll(tnGP_PrCal) then
              // Если задан интервал "Неделя"
              if KlRejim.Interval = 2 then
                // Значения полей "Продолжительность интервала, часов" и 
                // "Продолжительность рабочей недели" из производственного календаря не равны нулю
                if KlRejim.Hours > 0 and GP_PrCal.WeekLength > 0 then
                begin
                  // Если значения полей "Продолжительность интервала, часов" и 
                  // "Продолжительность рабочей недели" из производственного календаря не равны
                  if Abs(KlRejim.Hours - GP_PrCal.WeekLength) > 0.001 then
                  begin
                    // Рассчитываем коэффициент фактического времени
                    SF.SetKForRejim(KlRejim.NRec, Round(KlRejim.Hours / GP_PrCal.WeekLength, 1));
                    // Устанавливаем Дополнительный признак "Неполный рабочий день"
                    KlRejim.VidOplN := KlRejim.VidOplN or 1;
                  end else
                  begin
                    // Обнуляем коэффициент фактического времени
                    SF.SetKForRejim(KlRejim.NRec, 0);
                    // Снимаем признак "Неполный рабочий день"
                    KlRejim.VidOplN := KlRejim.VidOplN and (not 1);
                  end;
                  RescanPanel(tnKlRejim);
                end;
        end;
      end;
  end; //tableEvent table KlRejim

  //******************************************************************************
  // HandleEvent самого интерфейса
  //******************************************************************************
  handleEvent
    cmInit:
      begin
        inherited::handleEvent(cmInit);
        // В поле "Среднее количество часов в месяце" вместо поля KlRejim.SredCh
        // выводим поле GP_TimeNorms.Hours из таблицы "Среднемесячная норма времени"
        ClearFieldState(#KlRejim.SredCh, sfVisible);
        WorkTimeClassCode := oExtClass.GetClassCode(coKlRejim, EXT_CL_WORK_TIME);
        ShiftNumClassCode := oExtClass.GetClassCode(coKlRejim, EXT_CL_SHIFT_NUM);
      end;
    cmPick:
      case CurField of
        #WorkTime:
          if UpdateTable then
            if IsValidAll(tnKlRejim) then
            begin
              var _cRec: Comp;
              _cRec := 0;
              if oGP_ExtClass.PickValue(WorkTimeClassCode, KlRejim.NRec, false) then
                RedrawPanel(#KlRejim);
            end;
        #ShiftNum:
          if UpdateTable then
            if IsValidAll(tnKlRejim) then
            begin
              var _cRec: Comp;
              _cRec := 0;
              if oGP_ExtClass.PickValue(ShiftNumClassCode, KlRejim.NRec, false) then
                RedrawPanel(#KlRejim);
            end;
        #GP_PrCal.Name:
          begin
            var _cGP_PrCal: tNRec = GP_KlRejim.cGP_PrCal;
            if RunInterface('GP_PrCalendars', cgiPick, _cGP_PrCal) = cmDefault then
            begin
              set GP_KlRejim.cGP_PrCal := _cGP_PrCal;
              // Если поле "Интервал" не заполнено
              if KlRejim.Interval = 0 then
                // Устанавливаем значение для поля "Интервал" значение "Неделя"
                KlRejim.Interval := 2;
              // Если поле "Продолжительность интервала, часов" не заполнено
              if KlRejim.Hours = 0 then
                // Копируем значение поля производственного календаря "Продолжительность рабочей недели"
                // в поле "Продолжительность интервала, часов"
                KlRejim.Hours := GP_PrCal.WeekLength;
              SetModified(true);
            end;
          end;
        else
          inherited::handleEvent(cmPick);
      end;
    cmPickClass:
      begin
        inherited::handleEvent(cmPickClass);
        RedrawPanel(#KlRejim);
      end;
    cmPickAttr:
      begin
        inherited::handleEvent(cmPickAttr);
        RedrawPanel(#KlRejim);
      end;
    cmValue60: // Клонирование режима работ
      CloneRejim;
  end;
end.

handler with replace GP_MenuDynamic_AddItems_KLREJIM on ExtensionPoint GP_MenuDynamic_AddItems
action
{
  result:=true;
  timelog_init;
  var MenuID:longint=0;
  MenuID:=0;
  //------------------------------------
  //Учет времени - Режимы работ
  //Z_CALENDAR##KLREJIM - локальное меню
  //------------------------------------
   MenuID:=0;
   DeleteMenuHowDynamics('Z_CALENDAR::OperatingModeClassifierPopup');
  _try {
    timelog('GP_MenuDynamic_AddItems_KLREJIM->Z_CALENDAR::OperatingModeClassifierPopup');

    MenuID:=LoadMenuEx('Z_CALENDAR::OperatingModeClassifierPopup',false,true);
    if MenuID=0
    {
      _raise ExAddMenuItemError;
    }
    if not AddMenuItemEx(MenuID,'Клонирование режима работ'
              ,'Создание режимов работ на базе текущего',hcHotKeySaveDoc,cmValue60,0)//kbCtrlF2);
    {
      _raise ExAddMenuItemError;
    }

    if (not StoreMenuHowDynamics(MenuID,'Z_CALENDAR::OperatingModeClassifierPopup'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню "режимы работ" -> локальное меню'#13+
              ExploreException,error);
    }
  _finally {
     if (MenuID<>0) DisposeLoadMenu(MenuID);
  }
  timelog('GP_MenuDynamic_AddItems_KLREJIM->Z_CALENDAR::OperatingModeClassifierPopup finish');

} //handler with replace

#doc
Удаление пунктов меню модуля "Заработная плата"
#end
handler with replace GP_MenuDynamic_DelItems_KLREJIM on ExtensionPoint GP_MenuDynamic_DelItems
action
{
  result:=true;

  DeleteMenuHowDynamics('Z_CALENDAR::OperatingModeClassifierPopup')
}
