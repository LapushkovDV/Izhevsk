// Таблица для передачи информации в форму
table struct TmpFormT12
(
  NRec: Comp,                            // № записи
  DBeg: Date,                            // Дата с
  DEnd: Date,                            // Дата по
  cLSchet: Comp,                         // Ссылка на лицевой счет
  TabN: tTabN,                           // Табельный номер
  StrTabN: TabNStr,                      // Строковое значение табельного номера
  PersonName: String[60],                // Фамилия Имя Отчество
  cPosition: Comp,                       // Должность
  Kateg: Word,                           // Код категории
  DMark: array [1..31] of String[5],     // Дни: пометки обычные
  DHours: array [1..31] of Double,       // Дни: отработано часов
  DMarkAdd: array [1..31] of String[20], // Дни: тип
  DHoursAdd: array [1..31] of Double,    // Дни: часов по ночным, сверхурочным и т.д.
  OCode: array [1..14] of Word,          // Вид оплаты: код
  OAcc: array [1..14] of String[20],     // Вид оплаты: счет
  OHours: array [1..14] of Double,       // Вид оплаты: часы
  ACode: array [1..14] of String[5],     // Неявки: код
  ADays: array [1..14] of Double,        // Неявки: дни
  AHours: array [1..14] of Double,       // Неявки: часы
  Day1P: Double,                         // отработано дней за 1-ю половину месяца
  Chas1P: Double,                        // отработано часов за 1-ю половину месяца
  Day2P: Double,                         // отработано дней за 2-ю половину месяца
  Chas2P: Double,                        // отработано часов за 2-ю половину месяца
  TN: Double,                            // Ночные
  TS: Double,                            // Сверхурочные
  TRBDays: Double,                       // Работа в выходные: дней
  TRBHours: Double,                      // Работа в выходные: часов
  TRODays: Double,                       // Работа в выходные с компенсацией отпуском: дней
  TROHours: Double,                      // Работа в выходные с компенсацией отпуском: часов
  TV: Double                             // Кол-во выходных и праздничных дней
)
with index
(
  tmpTabWorkTime01 = NRec (Surrogate, Unique),
  tmpTabWorkTime02 = TabN + StrTabN + DBeg,
  tmpTabWorkTime03 = PersonName + DBeg
);
