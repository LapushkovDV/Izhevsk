#component "Z_StaffOrders"
#include MoneyRound.vih
#include RPD.vih
#include GP_EducFunc.vih // Функции работы с уровнями образования

vipInterface RPD_201(RPD_Base_Raise)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base.MyDel;
  function IRPD_Base.ChildCheckOneOrder(cNRec: Comp = 0): Boolean;
  function IRPD_Base.ChildConfirmOneOrder(cNRec: Comp = 0): Boolean;
  procedure IRPD_Base.PrintOrder(typePrint: TPtr; fcEnter: word);
  function IRPD.CheckOrder: Boolean;
end;

interface RPD_201;

  const
    // Константы для задания режима выбора в GP_SelPerson (неплохо бы их вынести в какой-то общий файл, но пока не знаю куда)
    SP_FIRED = 1; // уволенные сотрудники
    SP_TRAINEE = 2; // практиканты
    VO_PRIMARY = 0; // Вариант оформления: первичный приём
    VO_REPEATED = 1; // Вариант оформления: повторный приём
  end;

  create view
    from
      GP_SpContDoc201,
      InfPsn2,
      synonym Persons PersonsS,
      synonym Persons PersonsT,
      synonym Education EducationT,
      synonym Catalogs CatSpeciality,
      synonym Catalogs CatPractType,
      synonym Catalogs CatEduLevel,
      synonym Catalogs CatInstitution
    where ((
          ContDoc.NRec                == GP_SpContDoc201.cContDoc
      and ContDoc.cNew5               == CatEduLevel.NRec  
      and ContDoc.cNew3               == CatPractType.NRec  
      and ContDoc.cNew7               == CatInstitution.NRec
      and GP_SpContDoc201.cPerson     == PersonsS.NRec
      and GP_SpContDoc201.cSpeciality == CatSpeciality.NRec
    ))
  ;

  #include GP_EducFunc.var

  OverloadFormats scrDetRaise;
  /*
  OverloadFormats brPsn, scrDetRaise;

  browse brPsn (, hcStaffWinPr, sci1378Esc);
    show at (,,, 8) fixed_y;
    table ContDoc;
    fields
      ContDoc.wAttrDoc2 #3'Вид назначения'('Основное назначение или совмещение',, sci178Esc): [list 'основное назначение', 'совмещение'], [15], noAutoSize, protect;
      fullNamePodr #3'Подразделение' ('Подразделение'): [25], protect;
      Persons.FIO #3'ФИО руководителя практики' ('Фамилия имя отчество руководителя практики'): [28], protect;
      sTabNmb #3'Табельный №' ('Табельный номер'): [12], skip;
      Catalogs.Name #3'Должность' ('Должность (из основного назначения или совмещения - для увольнения совместителей)', hcStaffWinPr): [15], skip;
      PersOrderState #3'Исполнение' ('Исполнение', hcStaffWinPr): [12], skip,
       {font = {Color = if(isValid(#ContDoc) and (TitleDoc.wStatus <> 1) and (ContDoc.wYearPr = 0 or ContDoc.wYearPr = 3) and isValid(#AllMemo), ColorSysRed, 0)}};
  end;
  */

  screen scrDetRaise (, hcStaffWinPr, sci1ESc);
    show at (, 9,, 16) fixed_y;
    table ContDoc;
  fields
    CatPractType.Name ('Вид практики'): protect, pickButton,
     {font = {BackColor = if(ContDoc.cNew3 = 0, colorNeed, 0)}};
    CatEduLevel.Name ('Вид образования'): protect, pickButton;
    CatInstitution.Name ('Учебное заведение'): protect, pickButton,
     {font = {BackColor = if(ContDoc.cNew7 = 0, colorNeed, 0)}};
    ContDoc.Dat1 ('Дата поступления в учебное заведение'):
     {font = {BackColor = if(ContDoc.Dat1 = ZeroDate, colorNeed, 0)}};
    ContDoc.Dat2 ('Дата окончания учебного заведения'):
     {font = {BackColor = if(ContDoc.Dat2 = ZeroDate, colorNeed, 0)}};
    ContDoc.wAttrDoc4 ('Курс'): SpinButton [1, 0, 9];
    fAgreement ('Доп. соглашение к трудовому договору'): protect, pickButton;
    ContDoc.SBottom ('Основание'): [40], noprotect;
  buttons
    cmViewAdvance1,,, 'Просмотр примечания к приказу', hcStaffWinPr;
    cmValue21,,, 'Дополнительные условия по приказу';
  <<

`Вид практики`     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ <.  Примечание  .>
`Вид образования`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Учебное заведение`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ <. Доп. условия .>
`Дата поступления` .@@@@@@@@@@@   `Дата окончания`.@@@@@@@@@@@     `Курс`.@@@@@
`Доп. соглашение`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Основание`        .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  >>
  end;

  browse brwRaise201 'Назначение доплат' (,, sci178Esc);
    show at (, 17,, 21) fixed_y;
    table RaiseHist;
    fields
      RaiseCat.Name 'Вид доплаты/надбавки руководителю' ('Вид доплаты/надбавки  руководителю', hcStaffRaiseType, sci1378Esc):[20], protect;
      RaiseHist.RHSum 'Сумма или % за', 'одного практиканта' ('Сумма/процент доплаты/надбавки за одного практиканта', hcStaffRaiseSum): [20.3], noProtect, noautosize;
      CurrName 'Валюта' ('Валюта оплаты.', hcStaffRaiseCurr, sci1378Esc): [15], protect, noautosize;
      // RaiseHist.dRec 'С даты' ('Дата, с которой установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [12], noProtect, centered, noautosize;
      // RaiseHist.dDat2 'По дату' ('Дата, по которую установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [12], noProtect, centered, noautosize;
  end;

  browse brwSpContDoc 'Список практикантов' (,, sci178Esc);
    show at (,22,,);
    table GP_SpContDoc201;
    fields
      GP_SpContDoc201.RecType  'Вариант оформ-я' ('Вариант оформления',, sci178Esc): [list 0 'первичный приём', 1 'повторный приём'], [20], protect, noautosize;
      GP_SpContDoc201.FIO      'ФИО практиканта' ('Фамилия имя отчество практиканта'): [28], pickButton;
      GP_SpContDoc201.DateFrom 'С даты'          ('Дата начала практики'): [12], centered, noautosize;
      GP_SpContDoc201.DateTo   'По дату'         ('Дата окончания практики'): [12], centered, noautosize;
      CatSpeciality.Name       'Специальность'   ('Специальность'): [30], protect, pickButton;
  end;

  procedure EnableDisable;
  begin
    inherited::EnableDisable;
    // Если приказ не утвержден
    if fnFieldsOpen then
    begin
      SetHelpAndStatusContext(brwRaise201, -1, sci178Esc, 'StaffWinPr');
      SetHelpAndStatusContext(brwSpContDoc, -1, sci178Esc, 'StaffWinPr');
    end else
    begin
      SetHelpAndStatusContext(brwRaise201, -1, sci1Esc, 'StaffWinPr');
      SetHelpAndStatusContext(brwSpContDoc, -1, sci1Esc, 'StaffWinPr');
    end;
    ToggleFieldSelectable(#CatPractType.Name, fnFieldsOpen);
    ToggleFieldSelectable(#CatEduLevel.Name, fnFieldsOpen);
    ToggleFieldSelectable(#CatInstitution.Name, fnFieldsOpen);
    ToggleFieldSelectable(#ContDoc.Dat1, fnFieldsOpen);
    ToggleFieldSelectable(#ContDoc.Dat2, fnFieldsOpen);
    ToggleFieldSelectable(#ContDoc.wAttrDoc4, fnFieldsOpen);
    ToggleFieldSelectable(#GP_SpContDoc201.RecType, fnFieldsOpen);
    ToggleFieldSelectable(#GP_SpContDoc201.FIO, fnFieldsOpen);
    ToggleFieldSelectable(#GP_SpContDoc201.DateFrom, fnFieldsOpen);
    ToggleFieldSelectable(#GP_SpContDoc201.DateTo, fnFieldsOpen);
    ToggleFieldSelectable(#CatSpeciality.Name, fnFieldsOpen);
  end;

  // Удаление текущей позиции приказа
  procedure MyDel;
  begin
    delete novisual GP_SpContDoc201 where ((ContDoc.NRec == GP_SpContDoc201.cContDoc));
    inherited::MyDel;
  end;

  tableEvent table RaiseHist;
    cmSetDefault:
      begin
        // Зададим полю "Вид оплаты" значение по-умолчанию
        inherited::HandleEvent(cmSetDefault);
        // Управление персоналом / Управление и учет кадров / Приказы / Приказы по персоналу / Доплаты по умолчанию
        var _cRaiseType: tNRec = 0;
        _cRaiseType := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD201');
        if _cRaiseType != 0 then
        begin
          RaiseHist.cRaiseType := _cRaiseType;
          RaiseHist.iHAttr := CheckTypeRaise(_cRaiseType);
          Raise.RaiseAttr := RaiseHist.iHAttr;
          Raise.RaiseType := _cRaiseType;
        end;
      end;
  end;

  // Проверка приказа
  function CheckOrder: Boolean;
  begin
    PushPos(#ContDoc);
    PushPos(#PartDoc);
    PushPos(#GP_SpContDoc201);
    PushPos(#RaiseHist);
    result := inherited::CheckOrder;
    PopPos(#RaiseHist);
    PopPos(#GP_SpContDoc201);
    PopPos(#PartDoc);
    PopPos(#ContDoc);
  end;

  // Проверяет, есть ли уже текущий практикант в справочнике практикантов.
  // Поиск выполянется по комбинации значений полей ФИО + Дата рождения.
  // В проверке участвуют все записи каталога Persons, которые можно выбрать
  // при оформилении с вариантом оформления "повторный приём"
  // Возвращает true, если дублей нет
  function CheckForDoublesInPersons(ShowErr: boolean = true): boolean;
  begin
    result := false;
    // Если не повторный приём, проверку на дубли не производим
    if GP_SpContDoc201.RecType != VO_PRIMARY then
    begin
      result := true;
      exit;
    end;
    // Поверяем в картотеке в текущих
    _loop PersonsT where (('С' == PersonsT.IsEmployee and GP_SpContDoc201.FIO == PersonsT.FIO))
    begin
      if PersonsT.DisDate != ZeroDate and TitleDoc.DocDate >= PersonsT.DisDate then
      begin
        if ShowErr then
          SetErrorOrder('Практикант ' + GP_SpContDoc201.FIO + ': Уже есть в картотеке. Таб.№ ' +
           GetStrTabN(PersonsT.TabNmb, PersonsT.StrTabN) + '!');
        exit;
      end;
    end;
    // Поверяем в картотеке в архиве
    _loop PersonsT where (('У' == PersonsT.IsEmployee and GP_SpContDoc201.FIO == PersonsT.FIO))
    begin
      if PersonsT.DisDate != ZeroDate and TitleDoc.DocDate >= PersonsT.DisDate then
      begin
        if ShowErr then
          SetErrorOrder('Практикант ' + GP_SpContDoc201.FIO + ': Уже есть в картотеке. Таб.№ ' +
           GetStrTabN(PersonsT.TabNmb, PersonsT.StrTabN) + '!');
        exit;
      end;
    end;
    // Поверяем в справочнике практикантов
    if getFirst PersonsT where (('Р' == PersonsT.IsEmployee and GP_SpContDoc201.FIO == PersonsT.FIO)) = tsOk then
    begin
      if ShowErr then
        SetErrorOrder('Практикант ' + GP_SpContDoc201.FIO + ': Уже есть в справочнике практикантов!');
      exit;
    end;
    result := true;
  end;

  // Проверка корректности данных перед утверждением приказа 
  #errorlevel 0 // Подавляем предупреждения о неиспользуемых параметрах 
  function ChildCheckOneOrder(cNRec: Comp = 0): Boolean;
  var
    bLschet: Boolean;
    I: Word;
  begin
    result := true;
    // Проверяем доплаты
    if getFirst fastFirstRow RaiseHist <> tsOk then
    begin
      SetErrorOrder('Нет данных о назначенных доплатах!');
      result := false;
    end else
    begin
      _loop RaiseHist
      begin
        if Raise.RaiseType = 0 then
        begin
          SetErrorOrder('Не указан вид доплаты!');
          result := false;
        end
      end;
    end;
    // Проверяем связь назначения и лицевого счета
    bLschet := true;
    if IsValid(#Appointments) then
    begin
      if Appointments.lprizn = 0 and Appointments.cAddNRec2 = 0 then
        bLschet := false;
    end else
      if GetFirst ExistAppoint where ((Persons.AppointLast == ExistAppoint.nRec)) <> tsOk then
        bLschet := false
      else
        if ExistAppoint.lPrizn = 0 and ExistAppoint.cAddNRec2 = 0 then
          bLschet := false;
    if not bLschet then
    begin
      SetErrorOrder('У сотрудника отсутствует связь назначения и лицевого счета!');
      result := false;
    end;
    // Проверяем обязательные данные приказа
    if ContDoc.cNew3 = 0 then
    begin
      SetErrorOrder('Не заполнено поле "Вид практики"!');
      result := false;
    end;
    if ContDoc.cNew7 = 0 then
    begin
      SetErrorOrder('Не заполнено поле "Учебное заведение"!');
      result := false;
    end;
    if ContDoc.Dat1 = ZeroDate then
    begin
      SetErrorOrder('Не заполнено поле "Дата поступления"!');
      result := false;
    end;
    if ContDoc.Dat2 = ZeroDate then
    begin
      SetErrorOrder('Не заполнено поле "Дата окончания"!');
      result := false;
    end;
    // Проверяем список практикантов
    if getFirst fastFirstRow GP_SpContDoc201 <> tsOk then
    begin
      SetErrorOrder('Нет данных о практикантах!');
      result := false;
    end else
    begin
      I := 0;
      _loop GP_SpContDoc201
      begin
        I++;
        if GP_SpContDoc201.cPerson = 0 and Trim(GP_SpContDoc201.FIO) = '' then
        begin
          SetErrorOrder('У практиканта в записи № ' + To_Char(I) + ' не заполнено поле ФИО!');
          result := false;
          continue;
        end;
        if GP_SpContDoc201.DateFrom = ZeroDate then
        begin
          SetErrorOrder('Практикант ' + GP_SpContDoc201.FIO + ': Не заполнено поле "С даты"!');
          result := false;
        end;
        if GP_SpContDoc201.DateTo = 0 then
        begin
          SetErrorOrder('Практикант ' + GP_SpContDoc201.FIO + ': Не заполнено поле "По дату"!');
          result := false;
        end;
        if GP_SpContDoc201.cSpeciality = 0 then
        begin
          SetErrorOrder('Практикант ' + GP_SpContDoc201.FIO + ': Не заполнено поле "Специальность"!');
          result := false;
        end;
        // Проверяем, есть ли уже текущий практикант в справочнике практикантов
        if not CheckForDoublesInPersons then
          result := false;
      end;
    end;
  end;
  #errorlevel reset

  function LocateTraineePerson(RecNum: Word): Boolean;
  begin
    result := true;
    // Если повторный приём, ищем карточку
    if GP_SpContDoc201.RecType = VO_REPEATED then
    begin
      // Что в поле GP_SpContDoc201.cPerson не 0 проверено в ChildCheckOneOrder
      if getFirst PersonsT where ((GP_SpContDoc201.cPerson == PersonsT.NRec)) != tsOk then
      begin
        SetErrorOrder('У практиканта в записи № ' + To_Char(RecNum) + ' не корректная ссылка на карточку!');
        result := false;
        exit;
      end;
    end else
    begin
      // Если первичное трудоустройство
      // Проверим, возможно в приказе уже есть практиканты с таким значением поля "ФИО практиканта"
      if CheckForDoublesInPersons(false) then
      begin
        // Практикантов с таким значением поля "ФИО практиканта" не найдено.
        // Создаём карточку в интерфейсе "Сотрудники / Подбор персонала / Список кандидатов / Практиканты"
        ClearBuffer(#PersonsT);
        PersonsT.IsEmployee := 'Р';
        PersonsT.FIO := GP_SpContDoc201.FIO;
        PersonsT.Sex := if(oDeclension1(iODecl).VerifyGender(PersonsT.FIO) = 1, 'Ж', 'М');
        PersonsT.AppDate := TitleDoc.DocDate;
        PersonsT.Department := ContDoc.cDopRef;
        if insert current PersonsT != tsOk then
        begin
          SetErrorOrder('Не удалось добавить карточку практиканта ' + GP_SpContDoc201.FIO);
          result := false;
          exit;
        end;
        // Пропишем в приказе ссылку на созданную карточку
        GP_SpContDoc201.cPerson := PersonsT.NRec;
        if update current GP_SpContDoc201 != tsOk then
        begin
          SetErrorOrder('Не удалось обновить запись в таблице GP_SpContDoc201');
          result := false;
          exit;
        end;
      end else
      begin
        // В приказе уже есть практикант с таким значением поля "ФИО практиканта".
        // Меняем в этой записи вариант оформления на "повторный приём"
        GP_SpContDoc201.RecType := VO_REPEATED;
        // Пропишем в приказе ссылку на найденную карточку
        GP_SpContDoc201.cPerson := PersonsT.NRec;
        if update current GP_SpContDoc201 != tsOk then
        begin
          SetErrorOrder('Не удалось обновить запись в таблице GP_SpContDoc201');
          result := false;
          exit;
        end else
          SetErrorOrder('Практикант ' + GP_SpContDoc201.FIO + ' встречается в приказе несколько раз.', Warning);
      end;
    end;
  end;

  // Добавляет запись с информацией о прохождении практики в раздел "6. Сведения о прохождении практики"
  function AddRecToSection6: Boolean;
  begin
    result := true;
    // Если в приказ была выбрана карточка уволенного сотрудника, сведения о прохождении практики добавить нельзя -
    // в обычной карточке нет такого раздела
    if PersonsT.IsEmployee != 'Р' then
      exit;
    ClearBuffer(#InfPsn2);
    InfPsn2.cPers := PersonsT.NRec;
    InfPsn2.cRef3 := ContDoc.NRec;
    InfPsn2.FilialNo := 1;
    InfPsn2.cRef2 := Persons.NRec; // Руководитель практики
    InfPsn2.Str2 := ContDoc.SBottom; // Основание
    InfPsn2.dBeg := GP_SpContDoc201.DateFrom; // Дата с
    InfPsn2.dEnd := GP_SpContDoc201.DateTo; // Дата по
    InfPsn2.cRef1 := ContDoc.cNew3; // Вид практики
    if insert current InfPsn2 != tsOk then
    begin
      SetErrorOrder('Не удалось добавить запись в раздел 6 карточки практиканта ' + GP_SpContDoc201.FIO);
      result := false;
      exit;
    end;
  end;

  // Добавляет запись с информацией об образовании из приказа в раздел "2. Сведения об образовании"
  function AddRecToSection2: Boolean;
  begin
    result := true;
    // Проверим, может это образование уже есть в карточке
    _loop EducationT where ((PersonsT.NRec == EducationT.Person))
    begin
      // Считаем, что такое образование уже есть если совпадает учебное заведение и дата с
      if EducationT.Name = ContDoc.cNew7 and EducationT.FromDate = ContDoc.Dat1 then
      begin
        // Такое образования в карточке уже есть - обновим дату по, специальность и курс
        EducationT.ToDate := ContDoc.Dat2;
        EducationT.Course := ContDoc.wAttrDoc4;
        EducationT.Speciality := GP_SpContDoc201.cSpeciality;
        if update current EducationT != tsOk then
        begin
          SetErrorOrder('Не удалось обновить запись в разделе 2 карточки практиканта ' + GP_SpContDoc201.FIO);
          result := false;
        end;
        exit;
      end;
    end;
    // Такого образования в карточке еще нет - добавляем
    ClearBuffer(#EducationT);
    EducationT.Person := PersonsT.NRec;
    EducationT.Name := ContDoc.cNew7;
    EducationT.Level := ContDoc.cNew5;
    EducationT.FromDate := ContDoc.Dat1;
    EducationT.ToDate := ContDoc.Dat2;
    EducationT.Course := ContDoc.wAttrDoc4;
    EducationT.Speciality := GP_SpContDoc201.cSpeciality;
    if insert current EducationT != tsOk then
    begin
      SetErrorOrder('Не удалось добавить запись в раздел 2 карточки практиканта ' + GP_SpContDoc201.FIO);
      result := false;
      exit;
    end;
  end;

  // Создание доплат
  // SendToZP - если true, добавляет данные об оплате в рабочую корзину
  function CreateRaises(bSendToZP: Boolean; RecNum: Word): Boolean;
  begin
    result := true;
    ResetBounds(#Raise);
    // Проходим по всем доплатам
    _loop RaiseHist
    begin
      // В приказе есть одна запись в таблице Raise - ее используем для доплаты за первого практиканта
      // Для остальных практикантов создадим новые записи в Raise
      if RecNum > 1 then
      begin
        ClearBuffer(#Raise);
        Raise.Sum := RaiseHist.rHSum;
        Raise.RaiseAttr := RaiseHist.iHAttr;
        Raise.RaiseType := RaiseHist.cRaiseType;
        Raise.RaiseCurr := RaiseHist.cRef1;
      end else
      begin
        if getFirst Raise where((RaiseHist.cRaise == Raise.nRec)) != tsOk then
        begin
          SetErrorOrder('Не надена запись в таблице Raise', Warning);
          result := false;
          continue;
        end;
      end;
      Raise.OrderNmb1 := TitleDoc.DocNmb;
      Raise.OrderDate1 := TitleDoc.DocDate;
      Raise.Appoint := Appointments.NRec;
      Raise.Person := ContDoc.Person;
      Raise.FromDate := GP_SpContDoc201.DateFrom;
      Raise.ToDate := GP_SpContDoc201.DateTo;
      if Raise.cRDopEnd = 0 then
        set Raise.dRAbort := Raise.ToDate;
      if RecNum > 1 then
      begin
        if insert current Raise != tsOk then
        begin
          SetErrorOrder('Не удалось добавить запись в таблицу Raise', Warning);
          result := false;
          continue;
        end;
      end else
      begin
        if update current Raise != tsOk then
        begin
          SetErrorOrder('Не удалось обновить запись в таблице Raise', Warning);
          result := false;
          continue;
        end;
      end;
      // Обновляем историю
      iHRaise.UpdNeedRHist(Raise.NRec, 0, Raise.OrderDate1, Raise.OrderNmb1);
      NOAA.AddToAgreement(NOAA.getFirstAgreementByLink(GetCo4Agreement(), GetNRec4Agreement()), coRaiseHist, RaiseHist.NRec);
      if getLast ConfirmRHist where ((
            Raise.NRec == ConfirmRHist.cRaise
        and ZeroDate << ConfirmRHist.dRec
        and (ConfirmRHist.wTypeOper != 11 and ConfirmRHist.wStatus = 0)
      )) = tsOk
      begin
        delete ConfirmRHist where ((ContDoc.NRec == ConfirmRHist.cContDoc and 1 == ConfirmRHist.wStatus(NoIndex)));
      end;
      // Фомируем запись в рабочей корзине
      if bSendToZP then
      begin
        if IsValid(#Appointments) then
          SRR.MadeMsg(Raise.NRec, Persons.NRec, Appointments.NRec)
        else
          SRR.MadeMsg(Raise.NRec, Persons.NRec, 0);
      end;
    end;
    SetBounds(#Raise);
  end;

  // Утверждение приказа
  #errorlevel 0 // Подавляем предупреждения о неиспользуемых параметрах 
  function ChildConfirmOneOrder(cNRec: Comp = 0): Boolean;
  var
    I: Word;
    bSendToZP: Boolean;
  begin
    result := false;
    // Проверяем наличие лицевого счёта
    if getFirst LSchet where ((Appointments.cAddNRec2 == LSchet.NRec)) != tsOk then
    begin
      bSendToZP := false;
      SetErrorOrder('Лицевой счет сотрудника не найден. Запись в рабочей корзине создана не будет.', Warning);
    end else
    begin
      bSendToZP := true;
      if Hour(LSchet.LastTime) = Byte(1) then
        SetErrorOrder('Лицевой счет сотрудника закрыт для расчета', Warning);
    end;
    I := 0;
    _loop GP_SpContDoc201
    begin
      I++;
      if not LocateTraineePerson(I) then
        exit;
      AddRecToSection6;
      AddRecToSection2;
      CreateRaises(bSendToZP, I);
    end;
    result := true;
  end;
  #errorlevel reset

  // Печать группового приказа
  #errorlevel 0 // Подавляем предупреждения о неиспользуемых параметрах 
  procedure PrintOrder(typePrint: TPtr; fcEnter: word);
  begin
    // Message('Печать группового приказа. PartDoc.TypeOper = ' + To_Char(PartDoc.TypeOper) + ', PartDoc.NRec: ' + To_Char(PartDoc.NRec, 0, 0));
    if UpdateTable then
      RunInterface('GP_NFormRD201', PartDoc.NRec);
  end;
  #errorlevel reset

  tableEvent table GP_SpContDoc201;
    cmSetDefault:
      GP_SpContDoc201.cContDoc := ContDoc.NRec;
    cmInsertRecord:
      insert current GP_SpContDoc201;
    cmUpdateRecord:
      update current GP_SpContDoc201;
    cmDeleteRecord:
      if Message('Вы действительно хотите удалить запись ?', YesNo) = cmYes then
        delete current GP_SpContDoc201;
    cmCheckField:
      case CurField of
        #GP_SpContDoc201.RecType:
          // Если значение поля "Вариант оформления" изменилось на первичный приём
          if GP_SpContDoc201.RecType = VO_PRIMARY then
          begin
            // Очистим поле ФИО
            GP_SpContDoc201.cPerson := 0;
            set GP_SpContDoc201.FIO := '';
          end;
        #GP_SpContDoc201.FIO:
          begin
            if GP_SpContDoc201.cPerson != 0 then
              Message('В этой позиции приказа был выбран сотрудник из каталога'#13 +
               'Вариант оформления изменён на первичный приём', Information);
            // Если изменили руками значение поля ФИО, удалим ссылку на карточку и изменим вариант оформления на первичный приём
            GP_SpContDoc201.cPerson := 0; 
            if GP_SpContDoc201.RecType != VO_PRIMARY then
              set GP_SpContDoc201.RecType := VO_PRIMARY;
          end;
      end;
    cmPick:
      case CurField of
        #GP_SpContDoc201.FIO:
          begin
            var ParentSav: tNRec = GP_SpContDoc201.cPerson;
            if RunInterface('GP_SelPerson', SP_FIRED + SP_TRAINEE, ParentSav, TitleDoc.DocDate) = cmDefault then
            begin
              set GP_SpContDoc201.cPerson := ParentSav;
              GP_SpContDoc201.RecType := VO_REPEATED;
              GP_SpContDoc201.FIO := PersonsS.FIO;
              // Обновим значение поля "Специальность" из раздела 2 картотеки (из образования с наивысшим уровнем)
              var _cEduc: tNRec = oGP_EducFunc.GetBestEduc(GP_SpContDoc201.cPerson);
              if _cEduc != 0 then
                if getFirst EducationT where ((_cEduc == EducationT.NRec)) = tsOk then
                  if GP_SpContDoc201.cSpeciality = 0 and EducationT.Speciality != 0 then
                    GP_SpContDoc201.cSpeciality := EducationT.Speciality;
              RescanPanel(#GP_SpContDoc201);
            end;
          end;
        #CatSpeciality.Name:
          begin
            var ParentSav: tNRec = GP_SpContDoc201.cSpeciality;
            if RunInterface(PickCatalog2, -32, ParentSav, 0) = cmDefault then
              set GP_SpContDoc201.cSpeciality := ParentSav;
          end;
      end;
  end;

  tableEvent table ContDoc;
    cmPick:
      case CurField of
        #CatPractType.Name:
          begin
            var ParentSav: tNRec = ContDoc.cNew3;
            if RunInterface(PickCatalog2, -210, ParentSav, 0) = cmDefault then
              set ContDoc.cNew3 := ParentSav;
          end;
        #CatEduLevel.Name:
          begin
            var ParentSav: tNRec = ContDoc.cNew5;
            if RunInterface(PickCatalog2, -9, ParentSav, 0) = cmDefault then
              set ContDoc.cNew5 := ParentSav;
          end;
        #CatInstitution.Name:
          begin
            var ParentSav: tNRec = ContDoc.cNew7;
            if RunInterface(PickCatalog2, -24, ParentSav, 0) = cmDefault then
              set ContDoc.cNew7 := ParentSav;
          end;
      end;
  end;

  handleEvent
    cmCalc:
      begin
        update current ContDoc set TypeOper = 9;
        inherited::Handleevent(cmCalc);
        update ContDoc where ((PartDoc.NRec == ContDoc.cPart)) set ContDoc.TypeOper = 201;
      end;
    cmPrintDoc:
      Message('Индивидуальная форма приказа для этого РПД не предусмотрена.'#13'Используйте печать групповой формы приказа');
    cmMulSelDO: // Наследовать поле
      if UpdateTable then
        UpdNeedField(CurField);
  end;

end.

// Скрипт конфигуратора, который переименовыват поле "ФИО" в браузере brPsn руководителя практики@
object 'Z_STAFFORDERS::RPD_201' : InterfaceWindow {
  EmbName = 'Z_STAFFORDERS::ORDERSLIST->Z_STAFFORDERS::CONTAINEROFORDERS->';
  object BRPSN : Browser {
    object 'c_BRPSN_PERSONS.FIO_ФИО' : Column {
      Title = 'ФИО руководителя практики';
      HelpLine = 'Фамилия имя отчество руководителя практики';
    }
  }
}
