#component "Z_StaffReports"
alter interface ChangPersons;
  show at (,, 76, 19);

overload
  DataStream DSChange;
  procedure ForPostApp (Param1: word);
  procedure ForVremApp (Param1: word);
end;

table struct tmp4Raz
(
  cPsn  : comp,
  dChan : date,
  wRazr1: word,
  wRazr2: word,
  sKlKt1: string,
  sKlKt2: string
)
with index
(
  tmp4Raz = cPsn + dChan
);

table struct tmp4CP
(
  sNamePodr     : string[255],
  sNamePodrLong : string[255],
  sCodePodr     : string[100]
)
with index
(
  tmp4CP01 = sNamePodr
);

table struct tmp4KR
(
  sTbNmb    : string[20],
  isKadrR   : string[2]
)
with index
(
  tmp4KR01 = sTbNmb
);

table struct tmp4CKR
(
  cRecCKR : comp
, iLevel  : integer
)
with index
(
  tmp4CKR01 = cRecCKR
);

Var
  sCodePodr1,
  sCodePodr2  : string;
  sKadrRezerv : string;
  sNamPodrV   : string;
  cCatComp    : comp;
  cRecAll     : comp;
  sRazr1,
  sRazr2      : string;
  mFilterEmplKat : TPtr;
  wFilterEmplKat : word;
  sFilterEmplKat : string;
  cFilterEmplKat : comp;
  isDelFromDS : boolean;
  cMainLink_11: comp;
  cEmplKat1,
  cEmplKat2   : comp;
  __cPsn : comp;

create view
from
  competencepers
, competencepost
, HISTCOMPETENCE
, catalogs catcomp
, catalogs catlong
, klkatego KlKat
, klkatego KlAppointments
, klkatego KlChangeApp   
, klkatego SSKlAppointments
, klkatego SSKlChangeApp   
, contdoc CDoc1
, tmp4CP
, tmp4CP tmp4CPOut1
, tmp4CP tmp4CPOut2
, tmp4KR
, tmp4KR tmp4KROut
, tmp4Raz
, tmp4Raz tmp4RazOut
, tmp4CKR
, staffstruct SSAppointments
, staffstruct SSChangeApp
, FuturePost EMFuturePost
, StaffStruct EMStaffStruct
, CompetenceStaffStr EMCompetenceStaffStr
where
((
    tmpChange.Depart1   == tmp4CPOut1.sNamePodr
and tmpChange.Depart2   == tmp4CPOut2.sNamePodr
and tmpChange.TabNmb1   == tmp4KROut.sTbNmb
and tmpChange.PersNrec  == tmp4RazOut.cPsn
and tmpChange.DateChang == tmp4RazOut.dChan
and Appointments.STAFFSTR      == SSAppointments.nRec
and Appointments.EmpCategory   == KlAppointments.nRec
and SSAppointments.EmpCategory == SSKlAppointments.nRec
and ChangeApp.STAFFSTR      == SSChangeApp.nRec
and ChangeApp.EmpCategory   == KlChangeApp.nRec
and SSChangeApp.EmpCategory == SSKlChangeApp.nRec
and tmpChange.TabNmb1   == tmp4KR.sTbNmb
and tmpChange.PersNrec  == tmp4Raz.cPsn
and tmpChange.DateChang == tmp4Raz.dChan
and __cPsn                 == EMFuturePost.cPers
and EMFuturePost.cStaffStr == EMStaffStruct.NRec
and EMStaffStruct.NRec     == EMCompetenceStaffStr.cStaffStr and ( EMCompetenceStaffStr.cParent <> 0 )
))
;

function sGetKadrRezStr(_cPsn: comp): string;
{
  result := '';
  set __cPsn := _cPsn;
  if isValid(#EMFuturePost)
    _loop EMFuturePost
      if isValid (#EMStaffStruct)
//фильтр по датам. отключен
//        if ( ( EMFuturePost.Dat2 = 0 ) or ( EMFuturePost.Dat2 > DateN ) )
          result += if(trim(result)='', '', ';'+chr(13))
                  + iCatFunc.GetCatalogsCode(EMStaffStruct.Department) + ' '
                  + iCatFunc.GetCatalogsName(EMStaffStruct.Post) + ' ' + chr(13)
                  + 'с ' + if(EMFuturePost.Dat1<>0, EMFuturePost.Dat1, '')
                  + ' по ' + if(EMFuturePost.Dat2<>0, EMFuturePost.Dat2, '') + chr(13)
                  + ' Уровень ' + if(isValid(#EMCompetenceStaffStr), iCatFunc.GetCatalogsCode(EMCompetenceStaffStr.cName), '');

  if ( trim(result) = '' )
    result := tmp4KROut.isKadrR
  else
    result += '.';
}

function isKadrRez(cPers , cPost : comp; dChange : date): boolean;
{
  var iLevelPers,
      iLevelPost: integer; //код уровня компетенции по сотруднику и должности для сравнения приоритетов
  var dDatePers : date; // дата назначения компетенции
  var cRecAny   : comp;

  iLevelPers := 100;
  iLevelPost := 0;
  dDatePers  := 0;
  _loop competencepers where((cPers == competencepers.CPERS))
  {
    cRecAny := competencepers.cname;
    if getfirst tmp4CKR where((cRecAny == tmp4CKR.cRecCKR))= tsOk
    {
      cRecAny := competencepers.nrec;
      if getfirst HISTCOMPETENCE where((cRecAny == HISTCOMPETENCE.CSOURCEREC)) = tsOk
      {
        if dDatePers < HISTCOMPETENCE.DBEG
        {
          iLevelPers := tmp4CKR.iLevel;
          dDatePers  := HISTCOMPETENCE.DBEG;
        }
      }
    }
  }
  
  _loop competencepost where((cPost == competencepost.Cpost))
  {
    cRecAny := competencepost.cname;
    if getfirst tmp4CKR where((cRecAny == tmp4CKR.cRecCKR))= tsOk
      iLevelPost := tmp4CKR.iLevel
  }
  if (iLevelPost <> 0 and iLevelPers <> 100) and (iLevelPost >= iLevelPers) and (dChange >= dDatePers)
  {isKadrRez := true} else {isKadrRez := false}
}

function InitCatComp : boolean;
{
  cCatComp := iCatFunc.GetCatalogsNRec(100);
  if getfirst CatComp where((cCatComp == catcomp.cparent and 'Уровни кадрового резерва' == catcomp.name)) = tsOk
  {
    cCatComp := CatComp.nRec;
    _loop CatComp where((cCatComp == catcomp.cparent))
    {
      clearbuffer(#tmp4CKR);
      tmp4CKR.cRecCKR := catcomp.nrec;
      case trim(catcomp.code) of
      'I'  ,'1' :{tmp4CKR.iLevel := 1;}
      'II' ,'2' :{tmp4CKR.iLevel := 2;}
      'III','3' :{tmp4CKR.iLevel := 3;}
      'IV' ,'4' :{tmp4CKR.iLevel := 4;}
      '100'     :{tmp4CKR.iLevel := 100;}
      end;
      insert current tmp4CKR;
    }
    InitCatComp    := true;
  }
  else InitCatComp := false;
}

function sRetLongPodrEM(cAny : comp) : string; cacheable;
var
  isNotEnd : boolean = true;
{//cMainLink_11 catlong
  result := '';
  do
  {
    if getfirst catlong where((cAny == catlong.nrec)) = tsOk
    {
      if catlong.MainLink <> cMainLink_11 or catlong.cParent = cMainLink_11
        isNotEnd := false;
      if pos('директо',locase(catlong.name)) <> 0// or pos('энергом',locase(catlong.name)) <> 0
        isNotEnd := false;
      if isNotEnd
      {
        result += ' '+catlong.name;
        cAny := catlong.cParent;
      }
    }
    else isNotEnd := false;
  } while isNotEnd;
  result := trim(result);
}

#declare AddDopInfoTbl (App1, App2)
if tmpChange.FIO = '' exit;
isDelFromDS := false;
cEmplKat1:=cEmplKat2:=comp(0);
cRecAll := ChangeApp.cCont;
if getfirst CDoc1 where ((cRecAll == CDoc1.nRec and (CDoc1.TypeOper = 1))) = tsOk
{
  isDelFromDS := true;
}
if wFilterEmplKat = 1
{
  if getMarkerCount(mFilterEmplKat) > 0
  {
    if isvalid(tnSS#App1)
      cEmplKat1 := SS#App1.EmpCategory
    else
      cEmplKat1 := #App1.EmpCategory  ;
    if isvalid(tnSS#App2)
      cEmplKat2 := SS#App2.EmpCategory
    else
      cEmplKat2 := #App2.EmpCategory  ;
//    cFilterEmplKat := if(wBefAftFiltr = 0, ChangeApp.EMPCATEGORY, Appointments.EMPCATEGORY);
    if  (not FoundMarker(mFilterEmplKat, cEmplKat1))
    and (not FoundMarker(mFilterEmplKat, cEmplKat2))
    {
      isDelFromDS := true;
    }
  }
}
//if ChangeApp.StaffStr=Appointments.StaffStr and TmpChange.Depart1 = TmpChange.Depart2 and TmpChange.Post1 = TmpChange.Post2
if ( TmpChange.Depart1 = TmpChange.Depart2 and TmpChange.Post1 = TmpChange.Post2 )
{
  isDelFromDS := true;
}
if isDelFromDS
{
  if (delete current tmpChange) = tsOk {}
}
else
{  
  sNamPodrV := TmpChange.Depart1;
  if getfirst tmp4CP where ((sNamPodrV == tmp4CP.sNamePodr)) <> tsOk
  {
    clearbuffer(#tmp4CP);
    tmp4CP.sNamePodr := sNamPodrV;
    tmp4CP.sNamePodrLong := sRetLongPodrEM(#App1.Department);
    tmp4CP.sCodePodr := iCatFunc.GetCatalogsCode(#App1.Department);
    insert current tmp4CP;
  }

  sNamPodrV := TmpChange.Depart2;
  if getfirst tmp4CP where ((sNamPodrV == tmp4CP.sNamePodr)) <> tsOk
  {
    clearbuffer(#tmp4CP);
    tmp4CP.sNamePodr := sNamPodrV;
    tmp4CP.sNamePodrLong := sRetLongPodrEM(#App2.Department);
    tmp4CP.sCodePodr := iCatFunc.GetCatalogsCode(#App2.Department);
    insert current tmp4CP;
  }
  
  if isKadrRez(Persons.nRec,#App2.post,tmpChange.DateChang)
  if not isvalid(#tmp4KR)
  {
    clearbuffer(#tmp4KR);
    tmp4KR.sTbNmb  := tmpChange.TabNmb1;
    tmp4KR.isKadrR := 'Да';
    insert current tmp4KR;
  }
  if not isvalid(#tmp4Raz)
  {
    clearbuffer(#tmp4Raz);
    tmp4Raz.cPsn  :=tmpChange.PersNrec;
    tmp4Raz.dChan :=tmpChange.DateChang; 
    if isvalid(tnSS#App1)
    {
      tmp4Raz.wRazr1 := SS#App1.Category;
      tmp4Raz.sKlKt1 := SSKl#App1.KOD;
    }
    else
    {
      tmp4Raz.wRazr1 := #App1.cCat2;
      tmp4Raz.sKlKt1 := Kl#App1.KOD;
    }
    if isvalid(tnSS#App2)
    {
      tmp4Raz.wRazr2 := SS#App2.Category;
      tmp4Raz.sKlKt2 := SSKl#App2.KOD;
    }
    else
    {
      tmp4Raz.wRazr2 := #App2.cCat2;
      tmp4Raz.sKlKt2 := Kl#App2.KOD;
    }
    insert current tmp4Raz;
  }
}
#end

DataStream DSChange (
  [DateNDot]   iStrFunc.UnVisibleDate(DateN, 'DD.MM.YYYY');
  [DateOkDot]  iStrFunc.UnVisibleDate(DateOk, 'DD.MM.YYYY');
  Table inherited::tmpChange
  (
    [sCodePodr1]  tmp4CPOut1.sCodePodr;    
    [sLongPodr1]  tmp4CPOut1.sNamePodrLong;
    [sCodePodr2]  tmp4CPOut2.sCodePodr;    
    [sLongPodr2]  tmp4CPOut2.sNamePodrLong;
    [sKadrRezerv] sGetKadrRezStr(tmpChange.PersNrec); //tmp4KROut.isKadrR;
    [DateChangDot]   iStrFunc.UnVisibleDate(tmpChange.DateChang, 'DD.MM.YYYY');
    [OrderDateDot]   iStrFunc.UnVisibleDate(tmpChange.OrderDate, 'DD.MM.YYYY');
    [OrderDate2Dot]  iStrFunc.UnVisibleDate(tmpChange.OrderDate2, 'DD.MM.YYYY');
    [DateChEndDot]   iStrFunc.UnVisibleDate(tmpChange.DateChEnd, 'DD.MM.YYYY');
    [sRazr1]         if(tmp4RazOut.wRazr1<>0,tmp4RazOut.wRazr1,'');
    [sRazr2]         if(tmp4RazOut.wRazr2<>0,tmp4RazOut.wRazr2,'');
    [sCateg1]     tmp4RazOut.sKlKt1;
    [sCateg2]     tmp4RazOut.sKlKt2;
  );
)
end;

procedure ForPostApp (Param1: word );
{
  ClearBuffer(#TmpChange);
  inherited :: ForPostApp(Param1);
  #AddDopInfoTbl(Appointments,ChangeApp)
}
procedure ForVremApp (Param1: word);
{
  ClearBuffer(#TmpChange);
  inherited :: ForVremApp(Param1);
  #AddDopInfoTbl(ChangeApp,Appointments)
}

//ExtendFormats scrButtons;
OverloadFormats scrButtons;
Screen scrButtons ('', , scStaffForButton);
  show (, 13,,);
  table tmpChange;
Fields
    wFilterEmplKat('Вид отчета',, sci1Esc) : noprotect;
    sFilterEmplKat('Выберете категории',, sci13Esc) : protect;
Buttons
  cmStaffAllDep, default,, 'Печать отчета';
  cmCancel,,, 'Отмена';
<<

     [.] Категории`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

    <. Сформировать .>                                <.    Отмена    .>

>>
end; // screen scrButtons

function sSetKatName(mSetKat: TPtr): string;
{
  if (getMarkerCount(mSetKat) = 0)
  {
    result := 'все категории';
    exit;
  }
  else
    if (getMarkerCount(mSetKat) = 1)
    {
      var cTmp: comp;
      GetMarker(mSetKat, 0, cTmp);
      if GetFirst KlKat where (( cTmp == KlKat.NRec )) = tsOk
        result := KlKat.NaiKat;
      else
        result := '';
    }
    else
      result := 'несколько категорий (' + string(getMarkerCount(mSetKat)) + ')';
}

HandleEvent
  cmStaffAllDep: // формировать отчет
  {
    delete all from tmp4CP;
    delete all from tmp4KR;
    delete all from tmp4Raz;
    delete all from tmp4CKR;
    case inherited :: handleEvent (cmStaffAllDep) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;
  }
  cmCheckField:
  {
    case inherited :: handleEvent (cmCheckField) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;
    case CurField of
      #wFilterEmplKat:
      {
        if wFilterEmplKat = 0 ClearMarker(mFilterEmplKat);
        if wFilterEmplKat = 1 RunInterface('PICKKAT1', 0, mFilterEmplKat, vfMultipleSelection);
        set sFilterEmplKat := sSetKatName(mFilterEmplKat);
      }
    end;
  }
  cmPick:
  {
    case inherited :: handleEvent (cmPick) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;
    case CurField of
      #sFilterEmplKat:
      {
        if (RunInterface('PICKKAT1', 0, mFilterEmplKat, vfMultipleSelection) = cmDefault)
        {
          set sFilterEmplKat := sSetKatName(mFilterEmplKat);
          set wFilterEmplKat := 1;
        }
      }
    end;
  }
  cmDelOnprotect:
  {
    case inherited :: handleEvent (cmDelOnprotect) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;
    case CurField of
      #sFilterEmplKat: {ClearMarker(mFilterEmplKat); set sFilterEmplKat := sSetKatName(mFilterEmplKat); set wFilterEmplKat := 0;}
    end;
  }
  cmDone:
  {
    case inherited :: handleEvent (cmDone) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;
    SaveMyDsk(wFilterEmplKat, 'ChangPersons_wFilterEmplKat');
    DoneMarker(mFilterEmplKat,'ChPers_mKat_'  + UserName());
  }
  cmInit: 
  {
    case inherited :: handleEvent (cmInit) of
      heAbort:{abort;exit;}
      heStop:{stop;exit;}
    end;
    delete all from tmp4CP;
    delete all from tmp4KR;
    delete all from tmp4Raz;
    delete all from tmp4CKR;
    if not InitCatComp message('Не проинициализирован каталог компетенций!');
    if not (ReadMyDsk(wFilterEmplKat, 'ChangPersons_wFilterEmplKat', false))
      set wFilterEmplKat := 0;
    mFilterEmplKat := initMarker('ChPers_mKat_'  + UserName(), 8, 10, 10);
    if wFilterEmplKat = 0 ClearMarker(mFilterEmplKat);
    set sFilterEmplKat := sSetKatName(mFilterEmplKat);
    cMainLink_11 := iCatFunc.GetCatalogsNRec(-11);
  }
end;
end.
