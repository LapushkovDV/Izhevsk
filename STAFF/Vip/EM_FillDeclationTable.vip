#Component "EM"
#include CatFunc.vih           // Функции работы с Catalogs
#include StrFunc.vih           // Функции работы со строками
#include odecl.vih             // Функции склонения ФИО
#include SpecialPropetiesForG.vih      // Для обработки склонений справочника
#include GP_ODecl.Vih

interface EM_FillDeclationTable;
table struct tmpPost
(
  Crec : comp
, name : string
)
with index
(
 ind0 = Crec
)
;
create view
var
    iOdecl:declension;
    SPFG:SpecialPropetiesForG;  // работа с визирующими лицами, поворотами и склонениямти подразделений
    iCatFunc:CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
    iStrFunc:StringFunctions;     // Переменная типа интерфейс StringFunctions
         iGP_ODecl:GP_ODecl;
from
  PERSONS
, APPOINTMENTS App
, CATALOGS post
, EM_DECLESIONOBJ DeclPers
, EM_DECLESIONOBJ DeclPost
, tmpPost
, EM_DECLESIONOBJ DeclPodr
, catalogs Main_Link_Podr
, CATALOGS katpodr
where (( root == persons.nrec
and (Persons.disdate = 0 or Persons.disdate > cur_date and persons.isemployee= 'С')
  and if(Persons.APPOINTCUR <> 0h, Persons.APPOINTCUR ,Persons.APPOINTLAST)  == App.nrec
	and       app.POST == post.NREC
  and      coPersons == DeclPers.TYPE
  and   persons.nrec == DeclPers.cRec
  and        coCatalogs == DeclPost.TYPE
  and      tmpPost.Crec == DeclPost.cRec
  and                 -11 == Main_Link_Podr.syscode
  and Main_Link_Podr.nrec == katpodr.mainlink       (noindex)
  and          coCatalogs == DeclPodr.TYPE
  and        katpodr.nrec == DeclPodr.cRec


     ))
// order by Persons.Fio
;

function GetCatalogsNameDeclension(cCat:comp;Pp:byte;IsPost:boolean=false):string;
var nCat:string;
    iSpace:byte;
{
  // поищем нужный атрибут с указанным падежом
  result := Trim(SPFG.GetNeedString(true, Pp, cCat, ''));
  if (result<>'') exit;

  nCat:=Trim(iCatFunc.GetCatalogsName(cCat));

  if (IsPost) {
    iSpace:=Pos(' ',nCat);
    if (iSpace<>0)
      result := Trim(iOdecl.FIODeclension(0, SubStr(nCat,1,iSpace-1), Pp)) + ' ' + SubStr(nCat,iSpace+1,255);
  }

  if (result='')
    result := Trim(iOdecl.FIODeclension(0, nCat, Pp));

  if (result=nCat) //Если ничего не помогло...
    result := iGP_ODecl.My_Sclonenie(nCat,Pp);
}
function GetFIODeclension(_cPersons:comp;_Infinitive: string; _NCase: word):string; Cacheable;
{
   result := iOdecl.FIODeclension(_cPersons,_Infinitive, _NCase);
}
function GetShortFIODeclension(_cPersons:comp;_Infinitive: string; _NCase: word):string;
{
   var _fio : string = GetFIODeclension(_cPersons,_Infinitive,_NCase);
   result:=iStrFunc.Get_LastName(_fio) +' '+ SubStr(iStrFunc.Get_FirstName(_fio),1,1)+'.'+ SubStr(iStrFunc.GetPatronymic(_fio),1,1)+'.';
}


HandleEvent
cmInit:
{
  StartNewVisual(vtRotateVisual, vfTimer,'Поехали', 0);
  delete all tmpPost;
 _loop Persons
 {
   SetVisualHeader('Заполнение таблицы склонений по сотрудникам'
    + ''#13'' + Persons.Fio);
  if getfirst DeclPers <> tsOK
   {
     insert DeclPers set
       DeclPers.TYPE := coPersons
      ,DeclPers.cRec := persons.nrec
     ;
   }

   Update current DeclPers set
     DeclPers.DECLFULL[1]    := Persons.Fio
    ,DeclPers.DECLFULL[2]    := GetFIODeclension(Persons.Nrec, Persons.Fio,2)
    ,DeclPers.DECLFULL[3]    := GetFIODeclension(Persons.Nrec, Persons.Fio,3)
    ,DeclPers.DECLFULL[4]    := GetFIODeclension(Persons.Nrec, Persons.Fio,4)
    ,DeclPers.DECLFULL[5]    := GetFIODeclension(Persons.Nrec, Persons.Fio,5)
    ,DeclPers.DECLFULL[6]    := GetFIODeclension(Persons.Nrec, Persons.Fio,6)
    ,DeclPers.DECLSHORT[1]   := iStrFunc.Get_LastName(Persons.Fio) +' ' + SubStr(iStrFunc.Get_FirstName(Persons.Fio),1,1)+'.'+ SubStr(iStrFunc.GetPatronymic(Persons.Fio),1,1)+'.'
    ,DeclPers.DECLSHORT[2]   := GetShortFIODeclension(Persons.Nrec, Persons.Fio,2)
    ,DeclPers.DECLSHORT[3]   := GetShortFIODeclension(Persons.Nrec, Persons.Fio,3)
    ,DeclPers.DECLSHORT[4]   := GetShortFIODeclension(Persons.Nrec, Persons.Fio,4)
    ,DeclPers.DECLSHORT[5]   := GetShortFIODeclension(Persons.Nrec, Persons.Fio,5)
    ,DeclPers.DECLSHORT[6]   := GetShortFIODeclension(Persons.Nrec, Persons.Fio,6)
    ,DeclPers.Gender         := Persons.Sex
   ;

  if getfirst Post = tsOK
  {
     if getfirst tmpPost where ((Post.nrec == tmpPost.Crec)) <> tsOK
     {
      Insert tmpPost set tmpPost.Crec := Post.nrec, tmpPost.name := Post.name;
     }
  }
 }

 _loop tmpPost
 {
   SetVisualHeader('Заполнение таблицы склонений по должностям'
    + ''#13'' + tmpPost.name);

   if getfirst DeclPost <> tsOk
    {
       Insert DeclPost set
         DeclPost.TYPE := coCatalogs
        ,DeclPost.cRec := tmpPost.crec
       ;
    }
    Update current DeclPost set
     DeclPost.DECLFULL[1]    := tmpPost.name
    ,DeclPost.DECLFULL[2]    := GetCatalogsNameDeclension(tmpPost.crec,2,true)
    ,DeclPost.DECLFULL[3]    := GetCatalogsNameDeclension(tmpPost.crec,3,true)
    ,DeclPost.DECLFULL[4]    := GetCatalogsNameDeclension(tmpPost.crec,4,true)
    ,DeclPost.DECLFULL[5]    := GetCatalogsNameDeclension(tmpPost.crec,5,true)
    ,DeclPost.DECLFULL[6]    := GetCatalogsNameDeclension(tmpPost.crec,6,true)
    ;
 }

  _loop katpodr
 {
   SetVisualHeader('Заполнение таблицы склонений по подразделениям'
    + ''#13'' + katpodr.name);

   if getfirst DeclPodr <> tsOk
    {
       Insert DeclPodr set
         DeclPodr.TYPE := coCatalogs
        ,DeclPodr.cRec := katpodr.nrec
       ;
    }
    Update current DeclPodr set
     DeclPodr.DECLFULL[1]    := katpodr.name
    ,DeclPodr.DECLFULL[2]    := GetCatalogsNameDeclension(katpodr.nrec,2,true)
    ,DeclPodr.DECLFULL[3]    := GetCatalogsNameDeclension(katpodr.nrec,3,true)
    ,DeclPodr.DECLFULL[4]    := GetCatalogsNameDeclension(katpodr.nrec,4,true)
    ,DeclPodr.DECLFULL[5]    := GetCatalogsNameDeclension(katpodr.nrec,5,true)
    ,DeclPodr.DECLFULL[6]    := GetCatalogsNameDeclension(katpodr.nrec,6,true)
    ;
 }

  StopVisual;
}
end;
end.
