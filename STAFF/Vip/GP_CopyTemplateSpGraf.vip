#include GP_CopyTemplateSpGraf.vih
interface GP_CopyTemplateSpGraf;

var CopyCount:word;

create view
from
  SpGraf;

window WinParam 'Параметры копирования' DoAccept, EscClose, Gray;
show(50,5,86,10);

screen scParam (,,sci1Esc);
fields
  CopyCount:NoProtect;
buttons
  cmOK,,,'Продолжить',,sci1Esc;
  cmCancel,,,'Выход',,sci1Esc;
buttons
<<

 `Количество добавляемых строк`.@@@

 <.Продолжить.>       <.  Отмена  .>
>>
end;

HandleEvent
cmInit:{
  ReadMyDsk(CopyCount,#__InterfaceName__+'CopyCount',false);
  if (CopyCount=0) CopyCount:=1;
}
cmDone:{
  SaveMyDsk(CopyCount,#__InterfaceName__+'CopyCount');
}
cmOK:{
  PutCommand(cmDefault);
}
cmDefault:{
  if (CopyCount=0) {
    message('Пожалуйста, укажите количество добавляемых строк.');
    abort;
  }
}
end;
end;//WinParam

function Run(buf:type$SpGraf):boolean;
var i,wLastPos:word;
{
  result:=false;

  if (RunWindowModal(WinParam)<>cmDefault) exit;

  if (getlast SpGraf where((buf.cGrafik==SpGraf.cGrafik))=tsok)
    wLastPos:=Year(SpGraf.dDate)
  else
    wLastPos:=0;

  for(i:=1;i<=CopyCount;i++) {
    SpGraf.buffer:=buf;
    SpGraf.NRec:=0;
    SpGraf.dDate:=date(1, 1, wLastPos+i);
    if (insert current SpGraf <> tsok) {
      message('Ошибка вставки записи в таблицу SpGraf.',error);
      break;
    }
  }

  result:=true;
}

end.
