/*************************************************************************************************\
* Наименование:  Действующие справки об инвалидности                                              *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2282          |19/04/18 |Ермолов К.Р.            |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih

interface gp_invalid 'Параметры отчета' gray
Show at (,,26,5);

table struct deistv
(
tabnum: string,
fio: string,
borndate: date,
podr: string,
datanach: date,
datakon: date
)
with index
(
i1 = tabnum (unique)
)
;

table struct prodlen
(
tabnum: string,
fio: string,
borndate: date,
podr: string,
datanach: date,
datakon: date
)
with index
(
i1 = tabnum (unique)
)
;

table struct doki
(
tabnum: string,
fio: string,
borndate: date,
podr: string,
datanach: date,
datakon: date,
ser: string,
nmb: string,
gruppa: string
)
with index
(
i1 = tabnum + datanach + datakon (unique)
)
;

create view invalid

var
ExcelPath: string;
counter: longint;
dnach: date;

as select * from deistv, prodlen, doki;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  dnach: NoProtect,NoDel;
  buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    На дату:.@@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  dnach:= cur_date;
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from deistv;

  sql
  select persons.strtabn, persons.fio, persons.borndate, substring(katpodr.kod,1,3), min(passports.givendate), min(passports.todate)
  from passports
  left join persons on persons.nrec = passports.person
  left join katpodr on katpodr.nrec = persons.galdep
  where syscode = 560 and (passports.todate >= :(dnach) or passports.todate = 0) and persons.isemployee = 'С' and substring(katpodr.kod,1,3) <> 'Вет'
  group by persons.strtabn, persons.fio, persons.borndate, substring(katpodr.kod,1,3)
  into deistv;

  delete all from prodlen;

  sql
  select persons.strtabn, persons.fio, persons.borndate, substring(katpodr.kod,1,3), max(passports.givendate), max(passports.todate)
  from passports
  left join persons on persons.nrec = passports.person
  left join katpodr on katpodr.nrec = persons.galdep
  where syscode = 560 and persons.isemployee = 'С'
  group by persons.strtabn, persons.fio, persons.borndate, substring(katpodr.kod,1,3)
  having count(persons.strtabn) > 1
  into prodlen
  ;

  delete all from doki;

  sql
  select persons.strtabn, persons.fio, persons.borndate, substring(katpodr.kod,1,3), passports.givendate, passports.todate, passports.ser, passports.nmb, catalogs.name
  from passports
  left join persons on persons.nrec = passports.person
  left join katpodr on katpodr.nrec = persons.galdep
  left join catalogs on cast(int64(catalogs.nrec) as string) = passports.givenpodr
  where passports.syscode = 560 and persons.isemployee = 'С'
  into doki
  ;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_invalid.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  xlsetcellstringvalue('ДЕЙСТВУЮЩИЕ СПРАВКИ ОБ ИНВАЛИДНОСТИ НА ' + dnach, 1, 1, 1, 1);

  counter:= 3;

  _loop deistv
  {
    if dnach >= deistv.datanach or deistv.datanach = 0
    {
      counter++;
      xlsetcellstringvalue(counter - 3, counter, 1, counter, 1);
      xlsetcellstringvalue(deistv.tabnum, counter, 2, counter, 2);
      xlsetcellstringvalue(deistv.fio, counter, 3, counter, 3);
      xlsetcellstringvalue(deistv.borndate, counter, 4, counter, 4);
      xlsetcellstringvalue(deistv.podr, counter, 5, counter, 5);
      xlsetcellstringvalue(deistv.datanach, counter, 8, counter, 8);
      if deistv.datakon = 0
      {
        xlsetcellstringvalue('Бессрочно', counter, 9, counter, 9);
      }
      else
      {
        xlsetcellstringvalue(deistv.datakon, counter, 9, counter, 9);
      }

      _loop doki where ((deistv.tabnum == doki.tabnum and deistv.datanach == doki.datanach and deistv.datakon == doki.datakon))
      {
        xlsetcellstringvalue(doki.ser + ' ' + doki.nmb, counter, 6, counter, 6);
        xlsetcellstringvalue(doki.gruppa, counter, 7, counter, 7);
      }

      _loop prodlen where ((deistv.tabnum == prodlen.tabnum)) and deistv.datanach <> prodlen.datanach
      {
        xlsetcellstringvalue(prodlen.datanach, counter, 12, counter, 12);
        xlsetcellstringvalue(prodlen.datakon, counter, 13, counter, 13);

        _loop doki where ((prodlen.tabnum == doki.tabnum and prodlen.datanach == doki.datanach and prodlen.datakon == doki.datakon))
        {
          xlsetcellstringvalue(doki.ser + ' ' + doki.nmb, counter, 10, counter, 10);
          xlsetcellstringvalue(doki.gruppa, counter, 11, counter, 11);
        }
      }
    }
  }

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter, 13);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_invalid Implements IUserReport;
Interface UserReport_invalid;

Procedure Run;
Begin
  runinterface(gp_invalid);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Действующие справки об инвалидности';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
   Case Level of
    1 : GetGroupName := 'Отчеты по вредным условиям труда';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
