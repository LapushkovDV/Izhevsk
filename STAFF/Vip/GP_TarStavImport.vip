#include GP_TarStavImport.vih
interface GP_TarStavImport;

var cRiseCatRoot,cRankCatRoot:comp;
    IsError:boolean;
    CurRow:longint;
    MinRazrDatIzm:date;

//Протокол
table struct SProt(kod:word,str:string) with index (i1=kod);

create view
var sFileXLS:string;
from
  SProt,
  TarStav,GP_TarStavExt,
  KlSisOpl,Catalogs;

window WinImportParam 'Импорт справочника окладов/тарифных ставок' Gray;
show(20,5,75,11);

screen ScParam(,,sci1Esc);
fields
  sFileXLS('Путь к файлу c данными',,sci13Esc):protect,pickbutton,
    {font={backcolor=if(sFileXLS='',ColorNeed,0)}};
buttons
  cmOK,,,'Импорт данных',,sci1Esc;
  cmCancel,,,'Выход',,sci1Esc;
<<

 `Путь к файлу c данными`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <.   Импорт   .>                     <.   Отмена   .>
>>
end;

function CheckInPutVars:boolean;
{
  CheckInPutVars:=false;

  if (sFileXLS='') {
    message('Пожалуйста, укажите Путь к файлу c данными!');
    selectfield(#sFileXLS);
    putcommand(cmPick);
    exit;
  }
  if (not ExistFile(sFileXLS)) {
    message('Файла "'+sFileXLS+'" не существует!');
    exit;
  }

  CheckInPutVars:=true;
}

HandleEvent
cmInit:{
  ReadMyDSK(sFileXLS,#__InterfaceName__+'sFileXLS',false);
}
cmDone:{
  SaveMyDSK(sFileXLS,#__InterfaceName__+'sFileXLS');
}
cmPick:{
  case CurField of
    #sFileXLS:{
      var sTmp:string;
      sTmp:=getfilename('*.xls;*.xlsx','Укажите путь к файлу c данными');
      if (sTmp<>'') set sFileXLS:=sTmp;
    }
  end;
}
cmOK:{
  //Проверка параметров
  if (not CheckInPutVars) exit;

  CloseWindowEx(CurWindow,cmDefault);
}
end;
end;

procedure AddToProt(k:word;s:string);
{
  if (getfirst SProt where((k==SProt.kod and s==SProt.str(noindex)))<>tsok)
    insert SProt set SProt.kod:=k,SProt.str:=s;
  IsError:=IsError or (k<100);
}

function GetDuration(dtStart:_DateTime):string;
var sTmp:string;
{
  dtStart:=_FromSec100(_SubDateTime(_CurDateTime,dtStart));
  sTmp:='';
  if (_CompareDateTime(dtStart,_DateTime(0,0,0,0,1,0,0))=-1) sTmp:='SS сек. SSS микросек.'
  else if (_CompareDateTime(dtStart,_DateTime(0,0,0,1,0,0,0))=-1) sTmp:='NN мин. SS сек.'
  else if (_CompareDateTime(dtStart,_DateTime(0,0,1,0,0,0,0))=-1) sTmp:='HH ч. NN мин.'
  else sTmp:='DDD д. HH ч. NN мин.';
  result:=_DateTimeToStr(dtStart,sTmp)
}

var DateStart:_DateTime;
procedure PrintProtocol;
var ProtFileName:string;
    CountRec:longint;
{
  if (getfirst SProt <> tsok) exit;

  ProtFileName:=CreateTmpFileName;

  LogStrToFile(ProtFileName,'          Протокол импорта справочника окладов/тарифных ставок');
  LogStrToFile(ProtFileName,'');
  LogStrToFile(ProtFileName,'Пользователь: '+sGetTune('USER.FIO')+' ('+UserName+')');
  LogStrToFile(ProtFileName,'Дата запуска: '+_DateTimeToStr(DateStart,'DD.MM.YY HH:NN:SS'));
  LogStrToFile(ProtFileName,'Время исполнения: '+GetDuration(DateStart));

  if (getfirst SProt where((100>>SProt.kod))=tsok) {
    LogStrToFile(ProtFileName,'');
    _loop SProt where((100>>SProt.kod))
      LogStrToFile(ProtFileName,'Ошибка: '+SProt.str);
  }

  if (getfirst SProt where((100<<SProt.kod and 200>>SProt.kod))=tsok) {
    LogStrToFile(ProtFileName,'');
    _loop SProt where((100<<SProt.kod and 200>>SProt.kod))
      LogStrToFile(ProtFileName,'Предупреждение: '+SProt.str);
  }

  if (getfirst SProt where((1001==SProt.kod))=tsok) {
    LogStrToFile(ProtFileName,'');
    CountRec:=0;
    LogStrToFile(ProtFileName,'Добавлены следующие записи:');
    _loop SProt where((1001==SProt.kod)) {
      LogStrToFile(ProtFileName,'  '+SProt.str);
      CountRec++;
    }
    LogStrToFile(ProtFileName,'Всего '+string(CountRec));
  }

  if (getfirst SProt where((1002==SProt.kod))=tsok) {
    LogStrToFile(ProtFileName,'');
    CountRec:=0;
    LogStrToFile(ProtFileName,'Изменены следующие записи:');
    _loop SProt where((1002==SProt.kod)) {
      LogStrToFile(ProtFileName,'  '+SProt.str);
      CountRec++;
    }
    LogStrToFile(ProtFileName,'Всего '+string(CountRec));
  }

  delete all SProt;
  ProcessText(ProtFileName,vfNewTitle+vfToErase+vfMacroSize,'Протокол импорта справочника окладов/тарифных ставок');
}

function ReadStrFromMatrix(Col:longint):string;
{
  result:='';
  xlReadFromMatrix(CurRow,Col,result);
}

function ReadWordFromMatrix(Col:longint):word;
var sTmp:string;
{
  result:=0;

  sTmp:=Trim(ReadStrFromMatrix(Col));
  if (sTmp='') exit;

  result:=word(sTmp);
}

function ReadDblFromMatrix(Col:longint):double;
var sTmp:string;
{
  result:=0;

  sTmp:=Trim(ReadStrFromMatrix(Col));
  if (sTmp='') exit;
  sTmp:=Replace(sTmp,',','.');

  result:=double(sTmp);
}

function GetBonusType(Col:longint):comp;
var sTmp:string;
{
  result:=0;

  sTmp:=ReadStrFromMatrix(Col);
  if (Trim(sTmp)='') exit;

  if (getfirst fastfirstrow Catalogs
      where((0==Catalogs.lPr and cRiseCatRoot==Catalogs.MainLink and sTmp==Catalogs.Name))<>tsok) {
    AddToProt(12,'не найден Вид оплаты с именем "'+sTmp+'" в строке № '+string(CurRow+1));
    exit;
  }
  result:=Catalogs.NRec;
}

function GetProfStatus(Col:longint):comp;
var sTmp:string;
{
  result:=0;

  sTmp:=ReadStrFromMatrix(Col);
  if (Trim(sTmp)='') exit;

  if (getfirst fastfirstrow Catalogs
      where((0==Catalogs.lPr and cRankCatRoot==Catalogs.MainLink and sTmp==Catalogs.Name))<>tsok) {
    AddToProt(13,'не найден Профессиональный статус с именем "'+sTmp+'" в строке № '+string(CurRow+1));
    exit;
  }
  result:=Catalogs.NRec;
}

function ReadOneRec(var buf:type$p_TarStav;var bufExt:type$p_GP_TarStavExt):boolean;
var sTmp:string;
{
  result:=false;
  IsError:=false;

  sTmp:=ReadStrFromMatrix(1);
  if (getfirst fastfirstrow KlSisOpl where((sTmp==KlSisOpl.NASISOPL(noindex)))<>tsok)
    AddToProt(10,'не найдена Система оплаты с именем "'+sTmp+'" в строке № '+string(CurRow+1))
  else
    buf.SisOpl:=KlSisOpl.SisOpl;

  buf.NaiTar:=ReadStrFromMatrix(3);
  if (Trim(buf.NaiTar)='')
    AddToProt(11,'не указано Наименование тарифа в строке № '+string(CurRow+1));

  buf.Summa1:=ReadDblFromMatrix(5);
  buf.Tarif:=ReadDblFromMatrix(6);
  buf.TarMin:=ReadDblFromMatrix(7);
  buf.TarMax:=ReadDblFromMatrix(8);

  bufExt.NameT3:=ReadStrFromMatrix(9);
  bufExt.GropuT3:=ReadStrFromMatrix(10);
  bufExt.SchemeName:=ReadStrFromMatrix(11);
  bufExt.MonthlyBonus[1]:=ReadDblFromMatrix(12);
  bufExt.cMonthlyBonusType[1]:=GetBonusType(13);
  bufExt.MonthlyBonus[2]:=ReadDblFromMatrix(14);
  bufExt.cMonthlyBonusType[2]:=GetBonusType(15);
  bufExt.MonthlyBonus[3]:=ReadDblFromMatrix(16);
  bufExt.cMonthlyBonusType[3]:=GetBonusType(17);
  bufExt.QuarterlyBonus:=ReadDblFromMatrix(18);
  bufExt.cQuarterlyBonusType:=GetBonusType(19);
  bufExt.AnnualBonus:=ReadDblFromMatrix(20);
  bufExt.cAnnualBonusType:=GetBonusType(21);
  bufExt.PersonalBonus[1]:=ReadDblFromMatrix(22);
  bufExt.cProfStatus[1]:=GetProfStatus(23);
  bufExt.PersonalBonus[2]:=ReadDblFromMatrix(24);
  bufExt.cProfStatus[2]:=GetProfStatus(25);
  bufExt.PersonalBonus[3]:=ReadDblFromMatrix(26);
  bufExt.cProfStatus[3]:=GetProfStatus(27);
  bufExt.PersonalBonus[4]:=ReadDblFromMatrix(28);
  bufExt.cProfStatus[4]:=GetProfStatus(29);
  bufExt.PersonalBonus[5]:=ReadDblFromMatrix(30);
  bufExt.cProfStatus[5]:=GetProfStatus(31);

  result:=not IsError;
}

function InsOneRec:boolean;
var TarStavCodTar,TarStavRazr:word;
    buf:type$p_TarStav;
    bufExt:type$p_GP_TarStavExt;
{
  result:=true;

  TarStavCodTar:=ReadWordFromMatrix(2);
  if (TarStavCodTar=0) {
    AddToProt(2,'не указана Тарифная сетка в строке № '+string(CurRow+1));
    exit;
  }

  TarStavRazr:=ReadWordFromMatrix(4);

  if (getfirst TarStav
      where((
        MinRazrDatIzm==TarStav.DatIzm and
        TarStavCodTar==TarStav.CodTar(noindex) and
        TarStavRazr==TarStav.Razr(noindex)
      ))=tsok) {
    buf:=TarStav.bufferp;
    if (getfirst GP_TarStavExt where((TarStav.NRec==GP_TarStavExt.cTarStav))=tsok)
      bufExt:=GP_TarStavExt.bufferp
    else
      ClearAdvRecord(bufExt);
  } else {
    ClearAdvRecord(buf);
    buf.DatIzm:=MinRazrDatIzm;
    buf.CodTar:=TarStavCodTar;
    buf.Razr:=TarStavRazr;
    ClearAdvRecord(bufExt);
  }

  if (not ReadOneRec(buf,bufExt)) exit;

  TarStav.bufferp:=buf;
  if (TarStav.NRec=0) {
    result:=insert current TarStav = tsok;
    if (result)
      AddToProt(1001,TarStav.NaiTar+' (Тарифная сетка: '+string(TarStav.CodTar)+', Разряд категория: '+string(TarStav.Razr)+')');
    else
      AddToProt(1,'вставки записи в таблицу TarStav.');
  } else {
    result:=update current TarStav = tsok;
    if (result)
      AddToProt(1002,TarStav.NaiTar+' (Тарифная сетка: '+string(TarStav.CodTar)+', Разряд категория: '+string(TarStav.Razr)+')');
    else
      AddToProt(1,'модификации записи в таблице TarStav.');
  }
  if (not result) exit;

  GP_TarStavExt.bufferp:=bufExt;
  GP_TarStavExt.cTarStav:=TarStav.NRec;
  if (GP_TarStavExt.NRec=0) {
    result:=insert current GP_TarStavExt = tsok;
    if (not result)
      AddToProt(1,'вставки записи в таблицу GP_TarStavExt.');
  } else {
    result:=update current GP_TarStavExt = tsok;
    if (not result)
      AddToProt(1,'модификации записи в таблице GP_TarStavExt.');
  }
}

procedure LoadFromXLS;
var RowCountXLS,ColCountXLS:longint;
{
  RowCountXLS:=0;
  ColCountXLS:=0;
  xlGetUsedRange(0,0,RowCountXLS,ColCountXLS);
  if (RowCountXLS<2) {
    message('Файл "'+sFileXLS+'" пуст!',error);
    exit;
  }
  RowCountXLS--;//Первая строка - шапка

  if (ColCountXLS<>31) ColCountXLS:=31;

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Импорт из Excel...', RowCountXLS);

  //Читаем в матрицу
  if (not xlReadMatrixFromExcel(2,1,RowCountXLS+1,ColCountXLS))
    AddToProt(1,'выполнения xlReadMatrixFromExcel')
  else
    for(CurRow:=1;CurRow<=RowCountXLS;CurRow++) {
      if (not NextVisual) break;

      if (not InsOneRec) break;
    }

  StopVisual;
}

procedure Run(MinRazrDatIzm:date);
{
  if (RunWindowModal(WinImportParam)<>cmDefault) exit;

  DateStart:=_CurDateTime;
  private::MinRazrDatIzm:=MinRazrDatIzm;

  if (getfirst fastfirstrow Catalogs where((-17==Catalogs.SysCode))<>tsok) {
    message('Не найден каталог "Виды доплат/единовременных выплат".',error);
    exit;
  }
  cRiseCatRoot:=Catalogs.NRec;

  if (getfirst fastfirstrow Catalogs where((-176==Catalogs.SysCode))<>tsok) {
    message('Не найден каталог "Классность/звания".',error);
    exit;
  }
  cRankCatRoot:=Catalogs.NRec;

  if (not xlOpenNewExcel(false)) {
    message('Ошибка при открытии Excel.',error);
    exit;
  }

  if (not xlOpenWorkBook(sFileXLS))
    message('Ошибка при открытии файла "'+sFileXLS+'".',error)
  else {
    LoadFromXLS;
    xlCloseWorkBookByName(sFileXLS);
  }

  xlKillExcel;

  PrintProtocol;
}

HandleEvent
cmInit:abort;
end;
end.
