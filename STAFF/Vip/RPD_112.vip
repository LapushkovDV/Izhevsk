#component "Z_StaffOrders"
#include MoneyRound.vih
#include RPD.vih

#doc
  Интерфейс приказа "ДМС. Оказанные услуги"
#end


VipInterface RPD_112(RPD_Base_Raise)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base.MyDel;
end;

Interface RPD_112 '' escclose;

view as
select *
         from GP_RaiseHistExt112, Contdoc ContdocDMS, RaiseHist RaiseHistDMS, Catalogs VarStrah
where
   ((RaiseHist.nrec == GP_RaiseHistExt112.cRaiseH
and Contdoc.Person == GP_RaiseHistExt111.cPerson (noindex)
and Titledoc.docdate >>= GP_RaiseHistExt111.datebeg and (Titledoc.docdate <= GP_RaiseHistExt111.dateend)
and GP_RaiseHistExt111.cRaiseH /== RaiseHistDMS.nrec
and RaiseHistDMS.cContDoc /== ContDocDMS.nrec and (1 = ContdocDMS.wYearPR)
and GP_RaiseHistExt111.cVarStrah == VarStrah.nrec

//and RaiseHist.cRaise == Raise.nrec
//and Raise.RaiseType  == RaiseCat.nrec
)) //and  Titledoc.docdate <=
;
//******************************************************************************
// Окно содержимого приказа на назначение персональных надбавок
//******************************************************************************
Browse brwRaise112 'Назначение доплаты' (,, sci178Esc);
  show at (, 9,,14);
  table RaiseHist;
    Fields
  RaiseCat.Name     'Вид доплаты/надбавки', ('Вид доплаты/надбавки.', hcStaffRaiseType, sci1378Esc):[20], protect;
  RaiseHist.rHSum   'Сумма/процент доплаты/надбавки', ('Сумма/процент доплаты/надбавки', hcStaffRaiseSum): [13.3], noprotect;
  'Нац.валюта'      'Валюта', ('Валюта оплаты.', hcStaffRaiseCurr, sci1378Esc):[10] , protect;
  RaiseHist.dRec    'С даты', ('Дата, с которой установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered;
  RaiseHist.dDat2   'По дату', ('Дата, по которую установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered;
end;   //  brwRaise

screen scrRaise112Ext112 'Назначение доплаты (расширение)' (,, sci178Esc);
  show at (, 15,,17);
  table GP_RaiseHistExt112;
    Fields
  GP_RaiseHistExt112.NameUsl   ('Наименование услуги'): noprotect;
  GP_RaiseHistExt112.SummaUsl  ('Стоимость оказанной услуги'): noprotect;
  GP_RaiseHistExt111.PolisDMS  ('Полис ДМС'): skip;
  VarStrah.Name                ('Вариант страхования'): skip;
  GP_RaiseHistExt111.DateBeg   ('Начало действия'): skip, centered;
  GP_RaiseHistExt111.DateEnd   ('Окончание действия'): skip, centered;

<<
 `Наименование услуги` .@@@@@@@@@@@@@@@@@@@@@@@@@@@ `Размер в денежном эквиваленте` .@@@@@@@@@
 `Номер полиса ДМС`    .@@@@@@@@@@@@@@@@@@@@@@@@@@@ `Вид страхования`   .@@@@@@@@@@@@@@@@@@@@@
 `Начало действия`     .@@@@@@@@@@                  `Окончание действия`.@@@@@@@@@@

>>

end;   //  brwRaise

//******************************************************************************
// Процедура удаления своих записей, привязанных у удаляемому приказу
//******************************************************************************
Procedure MyDel;
{
  _loop RaiseHist
  {
    delete all from GP_RAISEHISTEXT112 where ((RaiseHist.Nrec == GP_RaiseHistExt112.cRaiseH));
  }
  inherited::MyDel;
}




//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  inherited::EnableDisable;
//  cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
//  cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер приказа');
//  cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата приказа');

  if fnFieldsOpen // не утвержден
  {
    SetHelpAndStatusContext(brwRaise112, -1, sci178Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt112.NameUsl, true);
    ToggleFieldSelectable(#GP_RaiseHistExt112.SummaUsl, true);
  }
  else //утвержден
  {
    SetHelpAndStatusContext(brwRaise112, -1, sci1Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt112.NameUsl, false);
    ToggleFieldSelectable(#GP_RaiseHistExt112.SummaUsl, false);
  }
}

TableEvent table RaiseHist;
  cmSetDefault:
  {
    //message('Докомпилировали обработчик');
    inherited::HandleEvent(cmSetDefault);
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD112');
    if (ParentSav <> 0)
    {
      RaiseHist.cRaiseType := ParentSav;
      RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
      Raise.RaiseAttr := RaiseHist.iHAttr;
      Raise.RaiseType := ParentSav;
    }
  }
end;

TableEvent table GP_RaiseHistExt112;
  cmSetDefault:
  {
    //message('cmSetDefault GP_RaiseHistExt112');
    GP_RaiseHistExt112.cRaiseH := RaiseHist.nrec;
    //message('установили нрек для расширения '+RaiseHist.nrec);
  }
  cmInsertRecord:
  {
    //inherited::HandleEvent(cmInsertRecord);
    //message('cmInsertRecord GP_RaiseHistExt112');
    GP_RaiseHistExt112.cRaiseH := RaiseHist.nrec;
    insert current GP_RaiseHistExt112;
  }
  cmUpdateRecord:
  {
    //message('cmUpdateRecord GP_RaiseHistExt112');
    GP_RaiseHistExt112.cRaiseH := RaiseHist.nrec;
    update current GP_RaiseHistExt112;
  }
  cmDeleteRecord:
  {
    //message('cmUpdateRecord GP_RaiseHistExt112');
    delete current GP_RaiseHistExt112;
  }
end;

//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent

    cmMulSelDO:
    {
      if UpdateTable
        UpdNeedField(CurField);
    }
    cmCalc:
    {
      update current ContDoc set TypeOper = 9;
      inherited::Handleevent(cmCalc);
      Message(PartDoc.nrec);
      update ContDoc where ((PartDoc.nrec == contdoc.cPart)) set TypeOper = 112;
    }

    cmHotKeys:
    {
      var LocalMenu:longint;
      //Добавим пункт меню для импорта реестра гостиничных услуг

      LocalMenu := LoadMenu('Rpd_MenuCopy');
      AddMenuItem(LocalMenu, 'Импорт сведений об оказанных услугах по ДМС', cmValue31);
      PutHotCommand(RunLoadMenu(LocalMenu));

    }
    cmValue31://Импорт гостиничных услуг
    {
      RunInterface('GP_RPD112_Import', PartDoc.nrec);
      ReReadRecord;
    }
  end;

End.
