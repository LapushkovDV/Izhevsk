#ifndef __GP_Func_ZP_VIH__
#define __GP_Func_ZP_VIH__

#component "GP_ZP"
Type TSchKauParam=Record
  Schet :string;
  SubSch:string;
  cKau:array[1..6] of Comp;
  wTbl:array[1..6] of word;
end;
#Declare FUNC_ZP_Fill_To_SchKauParam (wTable,sch,sub,cKau,wTbl)
do //чтобы изолировать объявление переменных
{ var ii:word;
  PSchKauParam.Schet :=#(wTable).#(Sch);
  PSchKauParam.SubSch:=#(wTable).#(Sub);
  For(ii:=1;ii<=6;ii++)
  { PSchKauParam.cKau[ii]:=#(wTable).#(cKau)[ii];
    PSchKauParam.wTbl[ii]:=#(wTable).#(wTbl)[ii];
  }

} while False
#end

#Declare FUNC_ZP_Fill_From_SchKauParam (wTable,sch,sub,cKau,wTbl)
do //чтобы изолировать объявление переменных
{ var ii:word;
  #(wTable).#(Sch):=PSchKauParam.Schet ;
  #(wTable).#(Sub):=PSchKauParam.SubSch;
  For(ii:=1;ii<=6;ii++)
  { #(wTable).#(cKau)[ii]:=PSchKauParam.cKau[ii];
    #(wTable).#(wTbl)[ii]:=PSchKauParam.wTbl[ii];
    if #(wTable).#(wTbl)[ii]=cgKau_Zakaz
    { if timelog_status>0
        timelog('FUNC_ZP_Fill_From_SchKauParam ii='+string(ii)+', Заказ!' +ShowKau(PSchKauParam.cKau[ii],PSchKauParam.cKau[ii]));
    }
  }
} while False
#end

#doc
Функции по заработной плате
#3574 функционал замены ссылок на ПС в модуле Заработная плата, для перехода с одного ПС на другой.
#end


VipInterface GP_Func_ZP #Licensed_Free ;
Public:
  Constructor Init;
//------------------------------------------------------------------------------
#doc
 Найти бухсчет по заказу
#end
Function GetBuhschetByMnPlan(_pMnPlan:comp):comp;
#doc
 Найти  бухсчет по заказу в плане счетов по умолчанию
#end
Function GetBuhschetByMnPlanCur(_pMnPlan:comp):comp;
#doc
 Установить параметры по плану
#end
Function SetFieldsByMnPlan(_pMnPlan:comp;var PSchKauParam:TSchKauParam ):boolean;

#doc
 проверить правильность счета/счубсчета по заказу
#end
Function Check_Analitic_MnPlan(var PSchKauParam:TSchKauParam ):boolean;

end;
#endif //GP_Func_ZP
