#include GP_EmailRun.Vih

interface RepRpd158_EmailSender;

var
pGP_EmailRun: GP_EmailRun;
email_num_row: longint = 0;
NPOEM_OWN_EMAIL_TYPE: word = wGetTune('NPOEM_OWN.EMAIL_TYPE');

procedure SendEmailToUsers; Forward;
procedure WriteMailText(text: string); Forward;
function GetRepFilePath: string; Forward;

Create View
var
  wTypeReport: word;
  wTypeRun: word;
  StartDate : date;
  EndDate   : date;
  RepFilePath : string;
select
1
from
  Em_UniDoc_Head UniDocEmail
, Em_UniDic UniDicEmail
where
((
      159         == UniDocEmail.wType
  and 159         == UniDicEmail.wType
  and UniDocEmail.nRec == UniDicEmail.cParent (noIndex)
  and wTypeReport == UniDocEmail.AddWord[1] (noindex)
))
;
Parameters
  wTypeReport, // 0 - авто определение по дню месяца, 1 - ежемесячный, 2 - ежедневный
  wTypeRun;    // фильтр ON/OFF

screen scOne;
<<
>>
end;

HandleEvent
cmInit:
{
  if (wTypeReport > 2)
  {
    message('Некорректное значение параметра');
    stop;
    abort;
    exit;
  }
  if (wTypeReport = 0) // авто по дню месяца
  {
    if (Day(Cur_Date) = 1)
      wTypeReport := 1;
    else
      wTypeReport := 2;
  }

  RepFilePath := GetRepFilePath;
  if (FileExist(RepFilePath)) deletefile(RepFilePath);
  RunInterface('RepRpd158', wTypeReport, wTypeRun);
  SendEmailToUsers;
  PutHotCommand(cmOk);
}
cmOk:
{
  CloseInterface(cmDone);
}
end;

function GetRepFilePath: string;
{
  var OutputFilesDirectory : string = GetStringParameter('Files','OutputFilesDirectory',0);
  var _FileName : string = 'Кадровые перестановки';
  result := OutputFilesDirectory + _FileName + DateToStr(cur_date,'_YYYYMMDD')+'.XLSX'; // получаем путь до файла и имя файла как в отчете
}

procedure WriteMailText(text: string);
{
  email_num_row++;
  pGP_EmailRun.Write_Text(email_num_row, text);
}

procedure SendEmailToUsers;
{
  if (FileExist(RepFilePath) <> true)
  {
    exit;
  }

  StartNewVisual(vtRotateVisual, vfTimer, 'Отправка писем...', 0);
  _loop UniDocEmail
  {
    if (UniDocEmail.AddString[2] = '') then continue;
    email_num_row := 0;
    WriteMailText('Добрый день, ' + UniDocEmail.AddString[1] + '!' + ' Получите отчет.');
    var _email_attach1 : string = RepFilePath;
    pGP_EmailRun.EmailSend
    (
       NPOEM_OWN_EMAIL_TYPE // : word ;
     , UniDocEmail.AddString[2] // _email_addr :string ;
     , 'Отчет по кадровым перестановкам ' + DateToStr(Cur_Date, 'DD.MM.YYYY') + if(wTypeReport=1, '(Ежемесячный)', if(wTypeReport=2, '(Ежедневный)', '')) // _email_subject :string ;
     , '' //_email_text :string ;
     , _email_attach1 //_email_attach1 :string ;
     , '' //_email_attach2 :string ;
     , '' //_email_attach3 :string ;
     , '' //_email_attach4 :string ;
     , ''//'"INTERFACE Z_StaffOrders::OrdersList('+string(TitleDoc.Nrec,0,0)+')"' //_email_attach5 :string ;
     , '' //_email_addr_copy :string='';
     , '' //_email_addr_from :string=''
    );
  }
  StopVisual;
}

End.
