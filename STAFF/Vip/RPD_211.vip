//*************************************
function ChildConfirmOneOrder(cNrec : comp = 0): boolean;
var Marker_Tmp:longint;
    ii:longint;
    _pnrec:comp;
{ Marker_Tmp  :=InitMarker('', 8, 50, 10, True);
  ClearMarker(Marker_Tmp);
  if cNrec <> 0
  { if GetFirst ContDoc where ((cNrec == ContDoc.NRec))=tsok {};
    cNrec:=0;
  }
  _Loop fullcache Raise where (( ContDoc.NRec == RAISE.CRDOP ))
  { InsertMarker(Marker_Tmp,Raise.Nrec);
    update current Raise set RAISE.CRDOP:=0,RAISE.Person:=0;
  }
  //--------------------------
  Result:=Inherited::ChildConfirmOneOrder(cNrec);
  //--------------------------
  for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
  { if GetMarker(Marker_Tmp,ii,_pNrec)
    { if getfirst Raise where (( _pNrec == Raise.Nrec ))=tsok
        update current Raise   set
           RAISE.CRDOP:=ContDoc.Nrec
          //#1209.11 ,RAISE.Person:=ContDoc.Person
        ;
    }
  } //for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
  DoneMarker(Marker_Tmp,'');
  if Result
  { iGP_SCUD_PersEdit.MakeBufferPers(Persons.Nrec,ContDoc.ObjNrec,TitleDoc.Nrec,Contdoc.Nrec,PartDoc.TypeOper);
  }
}//function IRPD_RPD1.ChildConfirmOneOrder(cNrec : comp = 0): boolean;

procedure FillAndRefillCartLSlist(wHowCut: word);
{
  SetLimit(arCartLS, 0);
  SetLimit(arCartLSVal, 0);

  arCartLS[0] := 'Новые ЛС и карточка';
  arCartLS[1] := 'Старый ЛС, новая карточка';
  arCartLS[2] := 'Новый ЛС, старая карточка';
  arCartLS[3] := 'Старые ЛС и карточка';

  arCartLSVal[0] := 0;
  arCartLSVal[1] := 1;
  arCartLSVal[2] := 2;
  arCartLSVal[3] := 3;

  case wHowCut of
    1:
      {
        ArrAtDelete(arCartLS, 3); // удаление 'Те же карточка и л\с'
        ArrAtDelete(arCartLSVal, 3); // удаление 'Те же карточка и л\с'
        ArrAtDelete(arCartLS, 2); // удаление 'Новый л\с'
        ArrAtDelete(arCartLSVal, 2); // удаление 'Новый л\с'
      }
    2:
      {
        ArrAtDelete(arCartLS, 1); // удаление 'Новая карточка'
        ArrAtDelete(arCartLSVal, 1); // удаление 'Новая карточка'
        ArrAtDelete(arCartLS, 0); // удаление 'Новые карточка и л\с'
        ArrAtDelete(arCartLSVal, 0); // удаление 'Новые карточка и л\с'
      }
  end;
#IFDEF _GP_
  SetEnumList(FirstScr_211, #ContDoc.wOrder, arCartLS, arCartLSVal);
  //из FillAndRefillList
  if (FromRecwin)
  { SetHelpAndStatusContext(FirstScr_211, -1, sci13Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, -1, sci13Esc, hcStaffNazn);
    SetHelpAndStatusContext(FirstScr_211, #Persons.FIO, sci13Esc, hcStaffNazn);
    SetHelpAndStatusContext(FirstScr_211, #ClockNumberPerson, sci1Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, #Appointments.wAddWord1, sci1Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, #Appointments.ContractDate, sci1Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, #Appointments.ContractNmb, sci1Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, #AppHist.TaxRate, sci1Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, #i_kategory, sci1Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, #AppHist.coef1, sci1Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, #InfPsn1.sum1, sci1Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, #InfPsn1.sum2, sci1Esc, hcStaffNazn);
    SetHelpAndStatusContext(scrDoc_211, #Appointments.Foundation, sci1Esc, hcStaffNazn);
  }

#ELSe
  SetEnumList(FirstScr, #ContDoc.wOrder, arCartLS, arCartLSVal);
#endif
}

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  inherited::EnableDisable;

  ToggleFieldSelectable(#Appointments.wAddWord1,false);
  ToggleFieldSelectable(#JobNatureCat.Name,false);
}

procedure SetRelation(Value: comp);
{
  if (not BoundActive(tbByNRecOrder)) {
    ResetBounds(tnContDoc);
    AddBounds(tbByNRecOrder);
  }

  inherited::SetRelation(Value);
}

//******************************************************************************
// Печать индивидуального приказа вызванная из события cmPrintDoc
//******************************************************************************
procedure PrintFromPD;
{
  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,1,ContDoc.NRec,ContDoc.Person,Appointments.NRec);
}

TableEvent table ContDoc;
cmSetDefault:{
  if (not BoundActive(tbByNRecOrder)) {
    abort;
    exit;
  }

  case inherited :: handleEvent (cmSetDefault) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (IsValidAll(tnPersons)) {
    Persons.JobNature:=cPersonsJobNatureDef;
    update current Persons;
  }
}
cmCheckField:{
  case inherited :: handleEvent (cmCheckField) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (CurField=#ContDoc.wDopAttr and IsValidAll(tnPersons))
    if (Persons.JobNature<>cPersonsJobNatureDef) {
      set Persons.JobNature:=cPersonsJobNatureDef;
      update current Persons;
    }
}
cmInsertRecord:{
  case inherited :: handleEvent (cmInsertRecord) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (PartDoc.TypeOper<>ContDoc.TypeOper and IsValidAll(tnContDoc)) {
    ContDoc.TypeOper:=PartDoc.TypeOper;
    update current ContDoc;
  }
}
end;

TableEvent table Appointments;
cmSetDefault:{
  case inherited :: handleEvent (cmSetDefault) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  Appointments.wAddWord1 := 1;//по ШР
}
end;

HandleEvent
cmOnVipLoad:{
  case inherited :: handleEvent (cmOnVipLoad) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  if (FromRecwin)
    FillAndRefillCartLSlist(1);
  else
    FillAndRefillCartLSlist(0);

  SetFormat(FirstScr_211);

  SetLimit(arGroup, 0);
  SetLimit(arGroupVal, 0);
  arGroup[0] := 'Обычное оформление приказа';
  arGroup[1] := 'Повторное трудоустройство';
  arGroupVal[0] := UsualReception;
  arGroupVal[1] := RepeatEmpl;
  SetEnumList(FirstScr_211, #ContDoc.wDopAttr, arGroup, arGroupVal);

  SetFormat(scrDoc_211);

  var cNode:comp=iCatFunc.GetCatalogsNRec(-12);
  if (getfirst fastfirstrow JobNatureCat
      where(('Временно'==JobNatureCat.Name and cNode==JobNatureCat.MainLink and 0==JobNatureCat.lPr))=tsok)
    cPersonsJobNatureDef:=JobNatureCat.NRec
  else
    cPersonsJobNatureDef:=0;

}
cmPick:{
  case inherited :: handleEvent (cmPick) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    #Persons.FIO:{
      if (IsValidAll(tnPersons))
        if (Persons.JobNature<>cPersonsJobNatureDef) {
          set Persons.JobNature:=cPersonsJobNatureDef;
          update current Persons;
        }
    }
  end;
}
cmHotKeys:{
  if ( not UpdateTable )
    exit;

  var menuID: longint;
  menuID := LoadMenu('RPD_PR211');

  prFillMenu(menuID);

  PutHotCommand(RunLoadMenu(menuID));
}
cmValue17:{//Печать доп. соглашения (Word)
  if (not UpDateTable) exit;

  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,0,ContDoc.NRec,ContDoc.Person,Appointments.NRec);
}
end;

end.

