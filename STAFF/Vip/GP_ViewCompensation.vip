#include OrdersList.vih
#include PerTypePr.vih           // Разграничение доступа
#include DepartmentsLimiter.vih  //Интерфейс разграничения прав доступа к подразделениям
#include PickCat.vih
#include UserReport.vih

VipInterface UserReport_GP_ViewCompensation Implements IUserReport;
interface UserReport_GP_ViewCompensation 'Просмотр компенсаций и льгот' Cyan;
show(10,5,150,30);

var OL:OrdersList New;
    VPerTypePr:SetPersonsTypePr;
    vUserAcs:UserDepartmentsIterator;
    mAccessRPD,mRPD,mFilterDep:longint;

table struct MemPerson(NRec:comp,StrTabn:string,FIO:string)
with index (i=FIO,i2=NRec);
table struct MemPersonRPD(Person:comp,CodOper:word,NOper:string,Sum:double)
with index (i=Person+CodOper);

create view
from
  MemPerson,
  MemPersonRPD
where((
  MemPerson.NRec==MemPersonRPD.Person
));

browse brPersons (,,sci1Esc);
show(,,60,);
table MemPerson;
fields
  MemPerson.StrTabn 'Табельный №':[12],Protect;
  MemPerson.FIO 'ФИО':[45],Protect;
end;

browse brMemPersonRPD (,,sci1Esc);
show(61,,,10);
table MemPersonRPD;
fields
  MemPersonRPD.CodOper 'Код' ('Код РПД', ):[5], Protect,NoAutoSize;
  MemPersonRPD.NOper 'Наименование РПД' ('Наименование РПД',, ): [45], Protect,NoDel;
end;

embedded brOrdersList interface;
show(61,11,,);
end;

procedure FillMemPersonAndRPD;
var hStr,FilterDepCount,AccessRPDCount,i:longint;
    cRec:comp;
    wRPD:word;
    IsWhereExist:boolean;
{
  StartNewVisual( vtRotateVisual, vfTimer, 'Отбор сотрудников...', 0);

  FilterDepCount:=GetMarkerCount(mFilterDep);
  AccessRPDCount:=GetMarkerCount(mAccessRPD);

  //Отбор сотрудников
  delete all MemPerson;
  IsWhereExist:=false;
  hStr:=0;
  sqlAddStr(hStr,'select Persons.NRec, Persons.StrTabn, Persons.FIO');
  sqlAddStr(hStr,'from Persons');

  //Фильтр по СЕ ШР
  if (FilterDepCount>0) {
    if (IsWhereExist)
      sqlAddStr(hStr,'  and');
    else {
      sqlAddStr(hStr,'where');
      IsWhereExist:=true;
    }
    sqlAddStr(hStr,'  Persons.Department in (');
    for(i:=0;i<FilterDepCount;i++) {
      GetMarker(mFilterDep,i,cRec);
      sqlAddStr(hStr,'     '+if(i<>0,',','')+'#comp('+string(cRec,0,0)+')');
    }
    sqlAddStr(hStr,'  )');
  }

  //Ограничения доступа по СЕ ШР
  cRec:=vUserAcs.First;
  if (cRec<>0) {
    if (IsWhereExist)
      sqlAddStr(hStr,'  and');
    else {
      sqlAddStr(hStr,'where');
      IsWhereExist:=true;
    }
    sqlAddStr(hStr,'  Persons.Department in (');
    i:=0;
    while(cRec<>0) {
      sqlAddStr(hStr,'     '+if(i<>0,',','')+'#comp('+string(cRec,0,0)+')');
      cRec:=vUserAcs.Next;
      i++;
    }
    sqlAddStr(hStr,'  )');
  }

  if (sqlSelectIntoByName(hStr,tnMemPerson)<>tsok)
    message('Ошибка выполнения DSQL запроса при отборе сотрудников.',error);
  sqlFreeStr(hStr);

  //Отбор РПД для сотрудников
  delete MemPersonRPD where((0<<=MemPersonRPD.Person));
  IsWhereExist:=false;
  hStr:=0;
  sqlAddStr(hStr,'select distinct ContDoc.Person,TypePr.CodOper,TypePr.NOper');
  sqlAddStr(hStr,'from ContDoc');
  sqlAddStr(hStr,'inner join TypePr on (ContDoc.TypeOper=TypePr.CodOper)');
  sqlAddStr(hStr,'inner join TypePr Gr on (TypePr.cTDop=Gr.NRec and Gr.NOper=''Компенсации и льготы'')');
  sqlAddStr(hStr,'inner join Persons on (ContDoc.Person=Persons.NRec)');

  //Фильтр по СЕ ШР
  if (FilterDepCount>0) {
    if (IsWhereExist)
      sqlAddStr(hStr,'  and');
    else {
      sqlAddStr(hStr,'where');
      IsWhereExist:=true;
    }
    sqlAddStr(hStr,'  Persons.Department in (');
    for(i:=0;i<FilterDepCount;i++) {
      GetMarker(mFilterDep,i,cRec);
      sqlAddStr(hStr,'     '+if(i<>0,',','')+'#comp('+string(cRec,0,0)+')');
    }
    sqlAddStr(hStr,'  )');
  }

  //Ограничения доступа по СЕ ШР
  cRec:=vUserAcs.First;
  if (cRec<>0) {
    if (IsWhereExist)
      sqlAddStr(hStr,'  and');
    else {
      sqlAddStr(hStr,'where');
      IsWhereExist:=true;
    }
    sqlAddStr(hStr,'  Persons.Department in (');
    i:=0;
    while(cRec<>0) {
      sqlAddStr(hStr,'     '+if(i<>0,',','')+'#comp('+string(cRec,0,0)+')');
      cRec:=vUserAcs.Next;
      i++;
    }
    sqlAddStr(hStr,'  )');
  }
  cRec:=vUserAcs.First;
  if (cRec<>0) {
    if (IsWhereExist)
      sqlAddStr(hStr,'  and');
    else {
      sqlAddStr(hStr,'where');
      IsWhereExist:=true;
    }
    sqlAddStr(hStr,'  ContDoc.cDopRef in (');
    i:=0;
    while(cRec<>0) {
      sqlAddStr(hStr,'     '+if(i<>0,',','')+'#comp('+string(cRec,0,0)+')');
      cRec:=vUserAcs.Next;
      i++;
    }
    sqlAddStr(hStr,'  )');
  }

  //Ограничения доступа по РПД
  if (AccessRPDCount>0) {
    if (IsWhereExist)
      sqlAddStr(hStr,'  and');
    else {
      sqlAddStr(hStr,'where');
      IsWhereExist:=true;
    }
    sqlAddStr(hStr,'  ContDoc.TypeOper in (');
    for(i:=0;i<AccessRPDCount;i++) {
      GetMarker(mAccessRPD,i,wRPD);
      sqlAddStr(hStr,'     '+if(i<>0,',','')+string(wRPD));
    }
    sqlAddStr(hStr,'  )');
  }

  if (sqlSelectIntoByName(hStr,tnMemPersonRPD)<>tsok)
    message('Ошибка выполнения DSQL запроса при отборе РПД для сотрудников.',error);
  sqlFreeStr(hStr);

  ReReadRecord(tnMemPerson);
  StopVisual;
}

procedure SetConditionForOL;
{
  ClearMarker(mRPD);
  if (IsValidAll(tnMemPersonRPD))
    InsertMarker(mRPD,MemPersonRPD.CodOper);
  else
    InsertMarker(mRPD,0);
  OL.SetPersonAndOpers(MemPerson.nRec, mRPD);
}

TableEvent Table MemPerson;
cmPositionChanged:
  SetConditionForOL;
end;

TableEvent Table MemPersonRPD;
cmPositionChanged:
  SetConditionForOL;
end;

HandleEvent
cmInit:{
  var cLastPerson:comp;
  cLastPerson:=0;
  ReadMyDsk(cLastPerson,#__InterfaceName__+'cLastPerson',true);

  if (cLastPerson<>0)
    if (getfirst MemPerson where((cLastPerson==MemPerson.NRec))=tsok) {};

  mRPD:=InitMarker('',2,0,1);
  mAccessRPD := VPerTypePr.GetAccessMarkerToRPD;

  mFilterDep:=InitMarker('',8,0,1);

  FillMemPersonAndRPD;

  BindEmbeddedInterface(brOrdersList, OL);// связать область с реализацией
  OL.Editable := false;
  SetConditionForOL;
}
cmDone:{
  SaveMyDsk(MemPerson.NRec,#__InterfaceName__+'cLastPerson');
  DoneMarker(mRPD,'');
  DoneMarker(mFilterDep,'');
}
cmHotKeys:{
  PutContextMenuCommand('GP_ViewCompensation_HotKeys');
}
cmFilterSave:{
  var cRec:comp;
  cRec:=0;
  GetMarker(mFilterDep,0,cRec);
  StoreMarker(mFilterDep,'CatalogsMarker');
  if (RunInterface(PickCatalog2,-11,cRec,100)<>cmDefault)
    ClearMarker(mFilterDep)
  else {
    DoneMarker(mFilterDep,'');
    mFilterDep:=InitMarker('CatalogsMarker',8,0,1);
  }

  FillMemPersonAndRPD;
}
end;

// Запуск отчета на выполнение при выборе его из списка отчетов
procedure Run;
{
  RunWindow(wnMainWindow);
}

// Наименование отчета в списке
function GetReportName: String;
{
  result := 'Просмотр компенсаций и льгот';
}

function GetGroupName (Level : Word) : String;
{
  result := '';
  case Level of
    1 : result := 'Компенсации и льготы';
  end;
}

// Приоритет отчета - сортировка внутри группы выполняется сначала
// по приоритету, а затем по наименованию
function GetPriority : Integer;
{
  result := 0;
}

// ModuleID модулей, в которых будет виден отчет
// '*' - отчет будет виден в любом модуле
function VisibleInModule(Ind : Byte) : String;
{
  result := '';
  case Ind of
    1 : result := 'STAFFMAINMENU';
  end;
}
end.

GP_ViewCompensation_HotKeys menu
{
 - 'Фильтр ...', cmFilterSave, 'Установить фильтр на данные', hcNoContext, 'Alt+B', kbAltB, sci1Esc;
}
