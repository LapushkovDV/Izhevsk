#include FeeSigners.vih
#include GP_UserFilterList.vih
#include GP_UserFilterPersons.vih
#include GP_UserFilterPeriod.vih
#include GP_UserFilterShrRpd.vih

#component "GP_Staff"

#include GP_RepShrChangesParams.vih
interface GP_RepShrChangesParams;

var
  _signer1        : GP_UserFilterPersons noauto;
  _signer2        : GP_UserFilterPersons noauto;
  _signer3        : GP_UserFilterPersons noauto;
  _signer4        : GP_UserFilterPersons noauto;
  _signer5        : GP_UserFilterPersons noauto;
  _rpd            : GP_UserFilterShrRpd noauto;
  _filterStore    : GP_IUserFilterStore;
  _userFilterList : GP_ObjUserFilterList;
  _feeSigners     : FeeSigners;
  _feeSignersFld  : string;

create view
as select *
from selection;

//Обновляет представление поля выбранной группы подписантов
procedure RefreshFeeSignersFld;
{
  if getfirst fastfirstrow selection where ((_feeSigners.GetFeeSigners == selection.nrec)) = tsOk
    _feeSignersFld := selection.name;
  else
    _feeSignersFld := '';
}

//Добавляет в пустой фильтр РПД пометку по умолчанию
procedure CheckRpdMarker;
{
  if GetMarkerCount(_rpd.Marker) = 0
  {
    InsertMarker(_rpd.Marker, 20); //Ввод ставки
    InsertMarker(_rpd.Marker, 21); //Исключение ставки
    InsertMarker(_rpd.Marker, 22); //Изменение количества ставок
    _rpd.RefreshFilterStr;
  }
}

Window WinRepParam 'Параметры печати' doAccept, escClose, gray;
Show(,,75, 12);

Screen scrParam ('',, sci1EnEsc);
Fields
  [RpdFld]        _rpd.FilterStr     : Protect, PickButton;
                  _feeSignersFld     : Protect, PickButton;
  [Signer1Fld]    _signer1.FilterStr : Protect, PickButton;
  [Signer2Fld]    _signer2.FilterStr : Protect, PickButton;
  [Signer3Fld]    _signer3.FilterStr : Protect, PickButton;
  [Signer4Fld]    _signer4.FilterStr : Protect, PickButton;
  [Signer5Fld]    _signer5.FilterStr : Protect, PickButton;
Buttons
  cmDoOk, default;
  cmCancel;
<<

 `Вид распорядительного действия`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Группа подписантов`            .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Подпись 1`                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Подпись 2`                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Подпись 3`                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Подпись 4`                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Подпись 5`                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

                                            <. Продолжить .> <. Отмена .>
>>
End; //Screen scrParam

Handleevent

cmDoOk: putcommand(cmDefault);

cmPick:
{
  case CurField of
    #_feeSignersFld:
    {
      _feeSigners.RunMainWindow(1);
      RefreshFeeSignersFld;
    }
  else
    _userFilterList.Pick(CurField);
  end;
  rereadrecord;
}

cmInit:
{
  rereadrecord;
}

End; //Handleevent WinRepParam

End; //Window WinRepParam

Handleevent

cmDelOnProtect:
{
  case CurField of
    #_feeSignersFld:
    {
      _feeSigners.ClearFeeSigners;
      RefreshFeeSignersFld;
    }
  else
    _userFilterList.Del(CurField);
  end;
  rereadrecord;
}

end;

Constructor Init;
{
  result := false;
}

Constructor GP_RepShrChangesParams(store: GP_IUserFilterStore);
{
  _filterStore    := store;
  _userFilterList := GP_ObjUserFilterList( new(GP_UserFilterList,UserFilterList(store)) );

  var d1, d2: date;
  d1 := date(1, month(cur_date), year(cur_date));
  d2 := date(last_day(d1), month(d1), year(d1));

  _rpd := new(GP_UserFilterShrRpd, GP_UserFilterShrRpd(#RpdFld, 'rpdFilterMarker', vfMultipleSelection));
  _userFilterList.Add(GP_IUserFilter(_rpd));

  _signer1 := new(GP_UserFilterPersons, GP_UserFilterPersons(#signer1fld, 'signer1', vfCanSelect)); _userFilterList.Add(GP_IUserFilter(_signer1));
  _signer2 := new(GP_UserFilterPersons, GP_UserFilterPersons(#signer2fld, 'signer2', vfCanSelect)); _userFilterList.Add(GP_IUserFilter(_signer2));
  _signer3 := new(GP_UserFilterPersons, GP_UserFilterPersons(#signer3fld, 'signer3', vfCanSelect)); _userFilterList.Add(GP_IUserFilter(_signer3));
  _signer4 := new(GP_UserFilterPersons, GP_UserFilterPersons(#signer4fld, 'signer4', vfCanSelect)); _userFilterList.Add(GP_IUserFilter(_signer4));
  _signer5 := new(GP_UserFilterPersons, GP_UserFilterPersons(#signer5fld, 'signer5', vfCanSelect)); _userFilterList.Add(GP_IUserFilter(_signer5));

  _feeSigners.InitFeeSigners(cgReport_KASSFRO);

  result := true;

}

Procedure Load;
{
  _feeSigners.FindFeeSignersByNRec(_filterStore.LoadComp('FeeSignersNrec'));
  RefreshFeeSignersFld;
  _userFilterList.Load;
  CheckRpdMarker;
}

Procedure Save;
{
  _filterStore.SaveComp(_feeSigners.GetFeeSigners, 'FeeSignersNrec');
  _userFilterList.Save;
}

Function ShowUI: word;
{
  result := runwindowmodal(WinRepParam);
}

end.
