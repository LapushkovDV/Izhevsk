#ifndef __GP_ManualNotes_VIH__
#define __GP_ManualNotes_VIH__

#component "GP_Staff"

ObjInterface GP_ObjManualNotes;
  function DelRec(wTbl:word;cRec:comp):boolean;
  function AddRec(wTbl:word;cRec:comp;Note:string):boolean;
  function UpdateFirstRec(wTbl:word;cRec:comp;Note:string):boolean;

  function Pick(wTbl:word;cRec:comp):boolean;

  property wTbl:word read;
  property cRec:comp read;
  property NoteNumber:longint read;
  property NoteStr:string read;

  index iByTblRec = wTbl, cRec, NoteNumber;
end;

VipInterface GP_ManualNotes Implements GP_ObjManualNotes;

#endif
