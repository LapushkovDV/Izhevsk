//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  MySetButtonTitle();
  inherited::EnableDisable;

  ToggleFieldSelectable(#WorkContracts.dEnd,false);
}

function CalcHours(d1,d2:date):double;
var _itSu:double;
{
 _itSu:=0;
 /*
  _loop GP_WorkContracts
  where((
        ContDoc.Person==GP_WorkContracts.cPers
    and d1<<=GP_WorkContracts.dBeg
    and d2>>=GP_WorkContracts.dBeg
    and GP_WorkContracts.cDoc/==GP_ContDoc.NRec
    and ContDoc.Person==GP_ContDoc.Person(noindex)
    and ContDoc.TypeOper==GP_ContDoc.TypeOper(noindex)
  )) {
    _itSu+=double(GP_WorkContracts.LastUser);
  }
 */
  SQL select
     sum(Cast(WorkContracts.LastUser as double))
  from WorkContracts
  inner join ContDoc on ContDoc.ObjNrec= WorkContracts.Nrec
             and ContDoc.TypeOper=:(ContDoc.TypeOper)
  where WorkContracts.cPers=:(Contdoc.Person)
  and WorkContracts.dBeg>=:(d1) and WorkContracts.dBeg<=:(d2)
  into (_itSu);
  Result:=_itSu;
  if timelog_status>0
  { timelog('CalcHours d1= '+string(d1)+',d2='+string(d2)+',Result='+string(Result));
  }

} //function CalcHours(d1,d2:date):double;


function CalcHoursC(d1,d2:date):double;
var _itSuV:double;
{
 _itSuV:=0;

  //Добавим отклонения с кодом С
  var _wYear:integer=Year(d2);
  var _wMes_b:word=Month(d1);
  var _wMes_e:word=Month(d2);
  var _wDay_b:word=Day(d1);
  var _wDay_e:word=Day(d2);
  //-------------------------
  SQL select
     sum(Variance.WORKINGHOURS)
  from Appointments
  inner join LsTab on LsTab.CLSCHET = Appointments.cAddNrec2
                  and LsTab.YearN   = :(_wYear)
                  and LsTab.MesN   >= :(_wMes_b)
                  and LsTab.MesN   <= :(_wMes_e)
  inner join Variance on Variance.cLsTab = LsTab.Nrec
                     and VARIANCE.KIND =2 //увеличение
                     and (LsTab.MesN   > :(_wMes_b) or VARIANCE.BEGINNING>=:(_wDay_b))
                     and (LsTab.MesN   < :(_wMes_e) or VARIANCE.ENDING   <=:(_wDay_e))
  inner join UOWRKTABEL on UOWRKTABEL.NREC= VARIANCE.CUO
                       and UOWRKTABEL.NUM='С'
  where Appointments.Nrec = :(ContDoc.cStr)
  into (_itSuV);
  Result:=_itSuV;
  if timelog_status>0
  { timelog('CalcHoursC d1= '+string(d1)
    +',d2='+string(d2)
    +',_itSuV='+string(_itSuV,0,2)
    +',Result='+string(Result,0,2));
  }

} //function CalcHoursC(d1,d2:date):double;

function ChildCheckOneOrder(cNrec : comp = 0): boolean;
var _ch:double;
{
  result:=inherited::ChildCheckOneOrder(cNrec);
  _ch:=CalcHours(Sub_Day(WorkContracts.dBeg,1),WorkContracts.dBeg)+CalcHoursC(Sub_Day(WorkContracts.dBeg,1),WorkContracts.dBeg);
  if (UOWRKTABEL.NUM = 'С') and (wGetTune('UP.NiimashGAL.Niimash') = 1)
  {
    _ch:=CalcHoursC(date(1,1,Year(WorkContracts.dBeg)),date(31,12,Year(WorkContracts.dBeg)) );
    if (_ch>120)
    {
      SetErrorOrder('Приказ утвердить нельзя: отработано более 120 часов в год.('+string(_ch,0,1)+')');
      result := false;
    }

  }

  if (UOWRKTABEL.NUM <> 'СД') and (wGetTune('UP.NiimashGAL.Niimash') = 0)
  {
    if (_ch>4)
    {
      SetErrorOrder('Приказ утвердить нельзя: отработано более 4-х часов в день/два дня подряд.('+string(_ch,0,1)+')');
      result := false;
    }
    else
    { _ch:=CalcHours(WorkContracts.dBeg,Add_Day(WorkContracts.dBeg,1))+CalcHoursC(WorkContracts.dBeg,Add_Day(WorkContracts.dBeg,1));
      if (_ch>4)
      {
        SetErrorOrder('Приказ утвердить нельзя: отработано более 4-х часов в день/два дня подряд.('+string(_ch,0,1)+')');
        result := false;
      }
    }

    _ch:=CalcHours(date(1,1,Year(WorkContracts.dBeg)),date(31,12,Year(WorkContracts.dBeg)) )+CalcHoursC(date(1,1,Year(WorkContracts.dBeg)),date(31,12,Year(WorkContracts.dBeg)) );

    if (_ch>120) {
      SetErrorOrder('Приказ утвердить нельзя: отработано более 120 часов в год.('+string(_ch,0,1)+')');
      result := false;
    }
  }
}

//******************************************************************************
//  Процедура утверждения индивидуального приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{ Result:=Inherited::ChildConfirmOneOrder(cNrec);
  if Result
  { //iGP_SCUD_PersEdit.MakeBufferPers(Persons.Nrec,ContDoc.ObjNrec,TitleDoc.Nrec,Contdoc.Nrec,PartDoc.TypeOper)
    if getfirst GP_SCUD_Pers=tsok
    { _Loop fullcache WorkContracts
      { iGP_SCUD_EventsEdit.CalcAll(GP_SCUD_PERS.Nrec
           ,year(WorkContracts.dBeg )
           ,month(WorkContracts.dBeg )
           ,2
           ,true
           ,0
           );
      }
    }
  }
} //function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;

//------------------------------------------------
//
//------------------------------------------------
Function Import_From_Scud:boolean;
var _chas:double;
    _Day:word;
    _EnhancedTimeFormat:boolean;
    _Mes:string;
{ Result:=False;
  UpdateTable;
  PushPos(#WorkContracts);
  PushPos(#ContDoc);
  StartNewVisual(vtNumericVisual,vfTimer + vfBreak + vfConfirm,'Подготовка данных',0);
  _EnhancedTimeFormat:=boGetTune('UP.ZAR.WT.EnhancedTimeFormat');

  _Loop fullcache ContDoc
  { if ContDoc.Person=0 continue;
    if not iNextVisual('Подготовка данных'+chr(13)+Persons.Fio)
    { break;
    }
    if getfirst GP_SCUD_Pers<>tsok
    { displ('Не нашли запись в справочнике сотрудников СКУД для '+Persons.Fio)

    }
    // это не может быть
    if getfirst WorkContracts<>tsok
    { continue;
      ClearBuffer(#WorkContracts);
      var _pNrec:comp=GetNextNrec(#WorkContracts,0);
      WorkContracts.Nrec     :=_pNrec;
      WorkContracts.cPers    := Persons.Nrec;
      WorkContracts.cApp     := Appointments.Nrec;
      WorkContracts.FilialNo := 10;
      WorkContracts.cDoc     := ContDoc.Nrec;
      insert current WorkContracts;
      update current ContDoc set ContDoc.ObjNrec := _pNrec;
    }
    _Loop fullcache WorkContracts
    { _Day:=day(WorkContracts.dBeg );
      _Mes:='Заменили часы для "'+Persons.Fio+ '" c '+WorkContracts.LastUser+' на ';
      iGP_SCUD_EventsEdit.CalcAll(GP_SCUD_PERS.Nrec
           ,year(WorkContracts.dBeg)
           ,month(WorkContracts.dBeg)
           ,1
           ,true
           ,_Day
           );
      _chas:=iGP_SCUD_EventsEdit.GetCalc_CH_Over_Day(_Day);
      WorkContracts.LastUser:=string(_chas,0,2);
      _mes:=_mes+string(_chas,0,2);
      update current WorkContracts;
      displ(_mes);
    } //_Loop fullcache WorkContracts
  } //_Loop fullcache ContDoc

  PopPos(#ContDoc);
  ReScanPanel(#ContDoc);
  PopPos(#WorkContracts);
  ReScanPanel(#WorkContracts);

  StopVisual('',0);
  ShowErrors;
  Result:=true;

} //Function Import_From_Scud:boolean;

Function GetTypeOpl(_wType:word):string;
{ Result:='-';
  case _wType of
  10: Result:=' ';
  1 : Result:='за отгул';
  0 : Result:='за оплату';
  end;
} //Function GetTypeOpl(_wType:word):string;

//===========================================
// Жалуются, что после печати идут ошибки ввода
procedure PrintRPD(typePrint: TPtr; fcEnter: word);
{ Pushpos(#ContDoc);
  Inherited::PrintRPD(typePrint, fcEnter);
  Poppos(#ContDoc);
  ReScanPanel(#ContDoc);
  ReScanPanel(#WorkContracts);

} //procedure IRPD_Base.PrintRPD(typePrint: TPtr; fcEnter: word);


