//******************************************************************************
// Окно содержимого приказа: Привлечение сотрудника к сверхурочной работе
//******************************************************************************
screen scrDet72 (, hcStaffWinPr, scStaffMyPnl);
  show at (,5,,);
  table WorkContracts;
fields
  WorkContracts.dBeg ('Дата начала неявки'): [10,'DD/MM/YYYY'], noprotect;
  WorkContracts.dEnd ('Дата окончания неявки'): [10,'DD/MM/YYYY'], noprotect;
  UP_CountHours    //( double(WorkContracts.LastUser) )
    ('Количество сверхурочных часов'): [10.2], noprotect;
  UOWRKTABEL.NUM ('Условное обозначение',,scStaffMyPnlPick): protect, pickButton;

  WorkContracts.filialNo
      ('Способ оплаты. Т.е. платить ли сотруднику что-либо или он работает за отгул',, scStaffPr1Pick):
          [list 10 ' ', 1 'за отгул', 0 'за оплату'], protect
          ;

!  GetTypeOpl(WorkContracts.filialNo) ('Способ оплаты. Т.е. платить ли сотруднику что-либо или он работает за отгул',, ): Protect;
  ContDoc.SBottom ('Основание', hcStaffWinPr), noprotect;
Buttons
//GP
  cmValue41,,, 'Забрать часы из СКУД';
//GP
  cmViewAdvance1,,, 'Просмотр примечания к приказу', hcStaffWinPr;
<<
  `Отработано с`  .@@@@@@@@@@@@        `по`.@@@@@@@@@@@@
  `Кол-во часов`  .@@@@@@ `Условное обозначение`.@@@@@@@
  `Способ оплаты` .@@@@@@@@@@@@   <.Часы из СКУД.> <. Примечание .>
  `Основание`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end; // screen scrDet72



//******************************************************************************
// События таблицы WorkContracts
//******************************************************************************
TableEvent Table WorkContracts;

cmSetDefault:
{
  ClearBuffer(#WorkContracts);
  WorkContracts.cPers := Persons.Nrec;
  WorkContracts.cApp  := Appointments.Nrec;
  //GP WorkContracts.FilialNo := 10;
  //---------------------------------
  WorkContracts.FilialNo:=0;// За оплату.
  WorkContracts.cVid    := pUOWRKTABEL_CV;
  WorkContracts.cDoc    := ContDoc.Nrec;
}
cmInsertRecord:
{
  var _pNrec:comp=GetNextNrec(#WorkContracts,0);
  WorkContracts.cDoc := ContDoc.Nrec;
  WorkContracts.Nrec :=_pNrec;
  if ( insert current WorkContracts <> tsOK )
  { Message('Ошибка вставки записи о неявке для сотрудника: ' + Persons.FIO + ' (т.н. ' + GetStrTabn(Appointments.AppTabNmb,Appointments.StrTabn) + ')', Error);
  }
  else
  {
    //set ContDoc.ObjNrec := WorkContracts.Nrec;
    set ContDoc.ObjNrec := _pNrec;
    if ( update current ContDoc <> tsOK ) {}
    ReScanPanel(#WorkContracts);
  }
}

cmUpdateRecord:
{
  if ( update current WorkContracts <> tsOK )
  {  Message('Ошибка обновления записи о неявке для сотрудника: ' + Persons.FIO + ' (т.н. ' + GetStrTabn(Appointments.AppTabNmb,Appointments.StrTabn) + ')'
      +chr(13)+'попробуйте еще раз'
      , Error);
     RereadRecord(#WorkContracts);
  }
}

cmCheckField:{
  case CurField of
  #WorkContracts.dBeg:
  { set WorkContracts.dEnd:=WorkContracts.dBeg;
    SetModified(true);
    UpdateTable();
  }
  end;

  case inherited :: handleEvent (cmCheckField) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}

end;

//------------------------
// События интерфейса
//------------------------
handleevent
cmOnVipLoad:
{ timelog_init;
  sUO:='С';
  if getfirst UOWRKTABEL_F=tsok // where (( 'С' == UOWRKTABEL_F.NUM ))=tsok
    pUOWRKTABEL_CV:=UOWRKTABEL_F.Nrec;
  if inherited::handleEvent(cmOnVipLoad) = heAbort
        abort;
}
cmViewAdvance1: //просмотр примечания к приказу
{ if  inherited :: handleEvent (cmViewAdvance1)=heAbort then Abort;
  MySetButtonTitle;
}
/*
cmValue21: //доп. условия
{ if  inherited :: handleEvent (cmValue21)=heAbort then Abort;
  MySetButtonTitle;
  // почему то сразу не обновляется
  EnableDisable;
} */
//GP
cmValue41: //часы из скуд
{ if TitleDoc.wStatus =1
  { message('Приказ не в оформляемом статусе'
         +', импорт часов запрещен!'
    ) ;
    exit;
  }
  Import_From_Scud;
}
//GP
end;



