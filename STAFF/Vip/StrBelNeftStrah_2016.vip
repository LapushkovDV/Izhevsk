#component "Z_StaffReports"
alter interface StrBelNeftStrah_2016;
overload
  procedure InitTmp1;
//  procedure InitTmp;
  function CheckPostInDepart(nRecCatalog: comp): boolean;
end;

procedure InitTmp1;
{
//  AddArea(5,'InitTmp1');
  ReSetBounds(#TmpCatalogs);
  delete all TmpCatalogs; // Очищаем временную таблицу
  SetBounds(#TmpCatalogs);

  StartNewVisual(vtNumericVisual, vfBreak + vfTimer, 'Подготовка информации', 1000);

  sql
    select distinct
      Catalogs.NRec,
      CatHist.cParent,
      CatHist.Name,
      Catalogs.Code,
      Catalogs.DatN,
      CatHist.Dat2 as DatOk,
      Catalogs.SysCode
    from
      Catalogs
      inner join (
        select CatHist.cCat, max(CatHist.Dat1) MaxDate:date
        from CatHist
        where :(DFiltr)>=CatHist.Dat1
        group by CatHist.cCat
      ) CatH1 on (Catalogs.NRec = CatH1.cCat)
      inner join (
        select CatHist.cCat, CatHist.Dat1, max(cast(CatHist.lastuser as integer)) MaxNpp
        from CatHist
        where :(DFiltr)>=CatHist.Dat1
        group by CatHist.cCat, CatHist.Dat1
      ) CatH2 on (Catalogs.NRec = CatH2.cCat and CatH1.MaxDate = CatH2.Dat1)
      inner join CatHist on (Catalogs.NRec = CatHist.cCat and CatH1.MaxDate = CatHist.Dat1 and CatH2.MaxNpp = cast(CatHist.lastuser as integer))
    where
      Catalogs.lPr = 0 and Catalogs.MainLink = (select NRec from Catalogs where -11 = SysCode)
      and 1 <> Catalogs.bMulti
      and (CatHist.wFld1 <> 2 or #Date(0,0,0) = CatHist.Dat2 or :(DFiltr) <= CatHist.Dat2)
    into TmpCatalogs ByName;

/*  _loop AllCatHist
  {
    if (1 = AllCatHist.bMulti)
      continue; // Отбрасываем студенческие подразделения

    if (CurNrec <> AllCatHist.cCat)
    {
      CurNrec := AllCatHist.cCat;

      if (GetLast CatHist = tsOk)
      {
        if (CatHist.wFld1 = 2)
          if ((ZeroDate <> CatHist.Dat2) and (DFiltr > CatHist.Dat2))
            continue;

        ClearBuffer(#TmpCatalogs);
        TmpCatalogs.NRec := CatHist.cCat;
        TmpCatalogs.cParent := CatHist.cParent;
        TmpCatalogs.Name := CatHist.Name;
        TmpCatalogs.Code := BasicCatal.Code;
        TmpCatalogs.DatN := BasicCatal.DatN;
        TmpCatalogs.DatOk := CatHist.Dat2;
        TmpCatalogs.SysCode := BasicCatal.SysCode;
        insert current TmpCatalogs;
      }
    }
  } */

  StopVisual;
//  CloseArea(5);
} // procedure InitTmp1
