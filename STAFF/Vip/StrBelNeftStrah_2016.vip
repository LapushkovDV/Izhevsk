function CheckPostInDepart(nRecCatalog: comp): boolean;
{
  result:=false;
  if (GetMarkerCount(DeptMarker) <> 0)
    if (not FoundMarker(DeptMarker, nRecCatalog)) exit;

  //AddArea(3,'CheckPostInDepart');
  result:=inherited::CheckPostInDepart(nRecCatalog);
  //CloseArea(3);
}
