/*************************************************************************************************\
* Наименование: Добавление поля Создатель в список аттестаций                                     *
* Контур/Модуль: Управление персоналом                                                            *
* Пункт меню: Сотрудники / Аттестация сотрудников / Сведения об аттестации сотрудников            *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#1510         |05/09/17|Тищенко Р.Н.             |НПО Энергомаш                    *
* Разработка  |#47           |05/09/17|Тищенко Р.Н.             |НПО Энергомаш                    *
\*************************************************************************************************/

#component "Z_Staff"
#doc
Сотрудники / Аттестация сотрудников / Сведения об аттестации сотрудников
<p>#1510 Добавление поля Создатель в список аттестаций
<p>#47   заполнение поля создатель по умолчанию
#end

alter interface AttEditOrderList;

  overloadFormats OdrerHead;

  function GetUserCreatorFIO: string; forward;

  create view
    as select
      GetUserCreatorFIO() (FieldName = UserCreatorFIO)
    from
      synonym X$Users UserCreator,
      synonym X$Users X$UsersS
    where ((
          Attestation.LastUser == UserCreator.Atl_NRec
    ));

  screen OdrerHead (,, sci1EnEsc);
    show at (,, 116, 10);
    table Attestation;
    fields
      Attestation.AttDate ('Дата приказа'): noProtect;
      Attestation.AttNmb ('Номер приказа'): noProtect;
      AttType.Name ('Тип аттестации'): protect, pickButton;
      UserCreatorFIO ('Создатель'): protect, pickButton;
    <<
       `Дата приказа  ` .@@@@@@@@@@
       `Номер приказа ` .@@@@@@@@@@
       `Тип аттестации` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
       `Создатель`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
    >>
  end;

  function GetUserCreatorFIO: string;
  begin
    result := '';
    if IsValidAll(tnUserCreator) then
    begin
      var S: String = sGetTuneEx('USER.FIO', UserCreator.xu$UserOffice, UserCreator.Atl_NRec);
      result := if(S = '', if(UserCreator.xu$FullName = '', UserCreator.XU$LoginName + ' (учетная запись пользователя)',
        UserCreator.xu$FullName), S);
    end;
  end;

  tableEvent table Attestation;
    cmSetDefault:
      begin
        case CurTable of
          #Attestation:
            Attestation.LastUser := UserId;
        end;
        inherited::handleEvent(cmSetDefault);
      end;
    cmPick:
      case curfield of
        #UserCreatorFIO:
          begin
            case wGetTune('DOC.CHANGEDESCRINDOC') of
              1: Message(''#3'Установлен запрет на изменение дескриптора в документах', Error);
              2: if Message(''#3'Изменить создателя на своего пользователя?', YesNo) = cmYes then
                   set Attestation.LastUser := UserId;
              0: begin
                   var _LoginName: String = '';
                   if getFirst X$UsersS where ((UserId == X$UsersS.Atl_NRec)) = tsOk then
                     _LoginName := X$UsersS.XU$LoginName;
                   if RunInterface(GetUser, _LoginName) = cmDefault then
                     if getFirst X$UsersS where ((_LoginName == X$UsersS.XU$LoginName)) = tsOk then
                       set Attestation.LastUser := string(X$UsersS.Atl_NRec,0,0);
                 end;
            end;
            RedrawPanel(#Attestation);
          end;
        else
          inherited::handleEvent(cmPick);
      end;
  end;

  handleEvent
    cmDelOnProtect:
      case curfield of
        #UserCreatorFIO:
          set Attestation.LastUser := 0;
        else
          inherited::handleEvent(cmDelOnProtect);
      end;
  end;

end.
