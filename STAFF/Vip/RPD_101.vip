#include MoneyRound.vih
#include RPD.vih

#doc
  Интерфейс приказа "Компенсация стоимости найма жилья"
#end


VipInterface RPD_101(RPD_Base_Raise)
  licensed(free);
public:
  procedure IRPD_Base.EnableDisable;
  procedure IRPD_Base.MyDel;
  function IRPD_Base.ChildCheckOneOrder(cNrec:comp = 0):boolean;
end;

Interface RPD_101 '' escclose;

view as
select *
         from GP_RaiseHistExt101, catalogs Catalogs_dopl
where
((RaiseHist.nrec == GP_RaiseHistExt101.cRaiseH
//and RaiseHist.cRaise == Raise.nrec
//and Raise.RaiseType  == RaiseCat.nrec
));
//******************************************************************************
// Окно содержимого приказа на назначение персональных надбавок
//******************************************************************************
Browse brwRaise101 'Назначение доплаты' (,, sci178Esc);
  show at (, 9,,14);
  table RaiseHist;
    Fields
  RaiseCat.Name     'Вид доплаты/надбавки', ('Вид доплаты/надбавки.', hcStaffRaiseType, sci1378Esc):[20], protect;
  RaiseHist.rHSum   'Сумма/процент доплаты/надбавки', ('Сумма/процент доплаты/надбавки', hcStaffRaiseSum): [13.3], noprotect,   {Font = {BackColor = if (RaiseHist.rHSum = 0, ColorNeed, 0)}};
  'Нац.валюта'      'Валюта', ('Валюта оплаты.', hcStaffRaiseCurr, sci1378Esc):[10] , protect;
  RaiseHist.dRec    'С даты', ('Дата, с которой установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered,   {Font = {BackColor = if (year(RaiseHist.dRec) = 0, ColorNeed, 0)}};
  RaiseHist.dDat2   'По дату', ('Дата, по которую установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered,   {Font = {BackColor = if (year(RaiseHist.dDat2) = 0, ColorNeed, 0)}};
end;   //  brwRaise

screen scrRaise101Ext101 'Назначение доплаты (расширение)' (,, sci178Esc);
  show at (, 15,,17);
  table GP_RaiseHistExt101;
    Fields
  GP_RaiseHistExt101.FMembers  ('Количество членов семьи'): [5], noprotect, centered;
  //GP_RaiseHistExt101.DatePay   ('Дата выплаты'): [10], noprotect, centered;
  GP_RaiseHistExt101.FMembCh   ('Количество членов семьи, дети'): [5], noprotect, centered;
  //GP_RaiseHistExt101.SummPay   ('Сумма выплаты'): [10.2], noprotect;

<<

 `Количество членов семьи, супруг(а)` .@@@@
 `Количество членов семьи (дети)`     .@@@@

>>

end;   //  brwRaise

function CheckOtherRaise101(d1, d2:date): boolean;
{
  Result := false;

  _loop ContDocSec where (( ContDoc.Person == ContDocSec.Person
                            and 0 << ContDocSec.cPart(noIndex)
                            and 101 == ContDocSec.Typeoper ))
  {
    if (getfirst fastfirstrow RaiseSec where (( ContDocSec.Nrec == RaiseSec.cRDop
                                             and Raise.Person == RaiseSec.Person
                                             and ContDoc.cStr == RaiseSec.Appoint(noIndex)
                                             and Raise.RaiseType == RaiseSec.RaiseType(noIndex)
                                             //and Raise.Sum == RaiseSec.Sum(noIndex)
                                             //and Raise.FromDate == RaiseSec.FromDate(noIndex)
                                             //and Raise.ToDate == RaiseSec.ToDate(noIndex)
                                             and Raise.RaiseAttr == RaiseSec.RaiseAttr(noIndex)))
                                             and ( (d1 >= RaiseSec.FromDate and d1 <= RaiseSec.ToDate) or
                                             (d2 >= RaiseSec.FromDate and d2 <= RaiseSec.ToDate) and (d1 <= d2)     )
//                                               and ( (Raise.FromDate >= RaiseSec.FromDate and Raise.FromDate <= RaiseSec.ToDate) or
//                                               (Raise.ToDate >= RaiseSec.FromDate and Raise.ToDate <= RaiseSec.ToDate) and (Raise.FromDate <= Raise.ToDate)     )
                                             ) = tsok
    {
      //message('Raise.FromDate:'+d1+' Raise.ToDate:'+d2+' RaiseSec.FromDate:'+RaiseSec.FromDate+' RaiseSec.ToDate'+RaiseSec.ToDate+' '+RaiseSec.nrec);
      Result := true;
      exit;
    }
  }
} //function CheckOtherRaise: boolean;


//******************************************************************************
// Процедура удаления своих записей, привязанных у удаляемому приказу
//******************************************************************************
Procedure MyDel;
{
  _loop RaiseHist
  {
    delete all from GP_RAISEHISTEXT101 where ((RaiseHist.Nrec == GP_RaiseHistExt101.cRaiseH));
  }
  inherited::MyDel;
}



//******************************************************************************
// Функция проверки корректности заполнения индивидуального приказа
//******************************************************************************
function ChildCheckOneOrder(cNrec:comp = 0): boolean;
{
  #__UNUSED__(cNrec)
  result := inherited::ChildCheckOneOrder(cNrec);
  var bConfirm : boolean;
  bConfirm := boGetTune('UP.STAFF.RPD_9.RPD9_CheckOtherRaises');
  _loop RaiseHist
  {
    if not bConfirm
      if CheckOtherRaise101(Raise.FromDate, Raise.ToDate)
      {
        SetErrorOrder('У сотрудника уже есть пересечение с аналогичной доплатой в утвержденном приказе!');
        result := false;
      }
  }
}


//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  var sTitle:string;
  inherited::EnableDisable;
  cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
  cfsGetProp('WHATISINORDER',cfpTitle, sTitle);
  cfsSetProp('WHATISINORDER',cfpTitle, replace(sTitle,'Приказ','Список'));
  cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер списка');
  cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата списка');

  if fnFieldsOpen // не утвержден
  {
    SetHelpAndStatusContext(brwRaise101, -1, sci178Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt101.FMembers, true);
    ToggleFieldSelectable(#GP_RaiseHistExt101.FMembCh, true);
  }
  else //утвержден
  {
    SetHelpAndStatusContext(brwRaise101, -1, sci1Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt101.FMembers, false);
    ToggleFieldSelectable(#GP_RaiseHistExt101.FMembCh, false);
  }
  var ParentSav : comp;
  ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD101');
  if (ParentSav <> 0)
  {
    //Проверим, это группа или лист
    if (getfirst catalogs_dopl where ((ParentSav == catalogs_dopl.cparent)) ) <> tsOk
    {
      ToggleFieldSelectable(#RaiseCat.Name, false);
    }
    else
    {
      ToggleFieldSelectable(#RaiseCat.Name, true);
    }
  }

}


TableEvent table RaiseHist;
  cmSetDefault:
  {
    //message('Докомпилировали обработчик');
    inherited::HandleEvent(cmSetDefault);
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD101');
    if (ParentSav <> 0)
    {
      //Проверим, это группа или лист
      if (getfirst catalogs_dopl where ((ParentSav == catalogs_dopl.cparent)) ) = tsOk
      {
        if getfirst catalogs_dopl where ((ParentSav == catalogs_dopl.nrec)) = tsOk {};
        if catalogs_dopl.syscode = 0
          message('У группы доплат должно быть заполнено поле SysCode!');
        else
        {
          //Группа
//          var cDopl:comp;
//          if (RunInterface(Z_StaffCat::PickCatalog2, catalogs_dopl.syscode, cDopl, 0) = cmDefault)
//          {
//            set RaiseHist.cRaiseType := cDopl;
//            set RaiseHist.iHAttr := CheckTypeRaise(cDopl);
//            set Raise.RaiseAttr := RaiseHist.iHAttr;
//            set Raise.RaiseType := cDopl;
//          }
        }
      } else
      {
        //лист
        set RaiseHist.cRaiseType := ParentSav;
        set RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
        set Raise.RaiseAttr := RaiseHist.iHAttr;
        set Raise.RaiseType := ParentSav;
      }
      //UpdateTableWithInserted();
      //ReReadRecord;

    } else
    {
      message('Ошибка! Не заполнена настройка "Доплата по умолчанию" для РПД 101');
      abort;
    }
  }
  cmCheckRecord:
  {
    if (RaiseHist.rhSum = 0 or year(RaiseHist.dRec) = 0 or year(RaiseHist.dDat2) = 0)
    {
       message('Заполните все обязательные поля!');
       abort;
    }
  }
end;

TableEvent table GP_RaiseHistExt101;
  cmSetDefault:
  {
    //message('cmSetDefault GP_RaiseHistExt101');
    GP_RaiseHistExt101.cRaiseH := RaiseHist.nrec;
    //message('установили нрек для расширения '+RaiseHist.nrec);
  }
  cmInsertRecord:
  {
    //inherited::HandleEvent(cmInsertRecord);
    //message('cmInsertRecord GP_RaiseHistExt101');
    GP_RaiseHistExt101.cRaiseH := RaiseHist.nrec;
    insert current GP_RaiseHistExt101;
  }
  cmUpdateRecord:
  {
    //message('cmUpdateRecord GP_RaiseHistExt101');
    GP_RaiseHistExt101.cRaiseH := RaiseHist.nrec;
    update current GP_RaiseHistExt101;
  }
  cmDeleteRecord:
  {
    //message('cmUpdateRecord GP_RaiseHistExt101');
    delete current GP_RaiseHistExt101;
  }
end;

