#doc
ЭМ.Приложение к приказу. Уведомления о переименовании подразделения
#end
interface GP_FrmRenPodr 'ЭМ.Приложение к приказу. Уведомления о переименовании подразделения ' (,,scStaffEmplMain) EscClose;
  show at (00,05,80,15);

table struct tempStrProd
(
  Post         : String,
  Podr         : string,
  fio          : String,
  kodPodr      : string,
  dateContr    : date,
  NumContr     : string,
  cPodr        : comp
)
with index
(
  tmpStrTitle01 = Post
);

  var    DateUved :date;
  var    DatePrik :date;
  var    NumPrik  :string;
  var    NamePrik :string;
  var    DateBeg  :date;
  var    NamePodr :string;
  var    kodPodr  :string;
  var    NameUpr  :string;
  var    Datedo   :date;
  var    CurDate  :date = cur_date;
  var    sPerson  :string;
  hPersonsMarker  :longint;
  var _tmpMarkerName : string;
  create view
var
  PersNRec:comp;
 as select
'GP_FrmRenPodr'
    (FieldName = NameInterface)

 , *
 from tempStrProd
 ,katpodr podrZGD1
 ,katpodr podrZGD2
 ,katpodr podrZGD3
 ,Persons
 ,catalogs
 ,Appointments
 ,katpodr
 /*where
 ((
    podrZGD1.cpodr == podrZGD2.nrec
 ))*/
 ;

  form StsRenPodr ('GP_FormStsRenPodr.out','GP_FormStsRenPodr');

Function GetPersNameFilter : string;
{
  hPersonsMarker := InitMarker(_tmpMarkerName, 8, 200, 10);
  var nRecMark : comp; nRecMark := comp(0);
  //getmarker(hPersonsMarker, 0, PersNRec);
  //message(string(PersNRec,0,0));
  case GetMarkerCount(hPersonsMarker) of
    0: result := 'не установлен';
    1:
      {
        GetMarker(hPersonsMarker, 0, nRecMark);
        if (GetFirst Persons where ((nRecMark == Persons.NRec)) = tsOk)
          result := Persons.Fio;
      }
    else
      result := 'Несколько сотрудников (' + string(GetMarkerCount(hPersonsMarker)) + ')';
  end;

  DoneMarker(hPersonsMarker, _tmpMarkerName);
}

function CheckUprav(_cPodr:comp):string;
{
   if getfirst podrZGD1 where ((_cPodr == podrZGD1.nrec)) = tsOk
     if getfirst podrZGD2 where ((podrZGD1.cpodr == podrZGD2.nrec)) = tsOk
      {
        if (podrZGD2.cpodr = 0000000006164E7Dh or podrZGD2.cpodr = 0000000001322806h or podrZGD2.cpodr = 0h )
         result:= podrZGD1.name + '(' + podrZGD1.kod + ')';
        else
        {
          if getfirst podrZGD3 where ((podrZGD2.cpodr == podrZGD3.nrec)) = tsOk
          {
            if (podrZGD3.cpodr = 0000000006164E7Dh or podrZGD3.cpodr = 0000000001322806h or podrZGD3.cpodr = 0h )
              result:=podrZGD1.name  + ' / ' + podrZGD2.name + ' (' + podrZGD2.kod + ')';
            else
              result:=podrZGD1.name  + ' / ' + podrZGD2.name + ' (' + podrZGD2.kod + ')' + ' / ' + podrZGD3.name + ' (' + podrZGD3.kod + ')';
          }
        }

      }
}



procedure CreateFields;
{
Delete All tempStrProd;

/*sql
select
post.name,katpodr.name,persons.fio,katpodr.kod,app.CONTRACTDATE,app.CONTRACTNMB,katpodr.nrec
from STRTITLE
join  StrPart on STRTITLE.nrec = StrPart.cDoc
join  StrCont on StrPart.Nrec = StrCont.cPart
join cathist on  StrCont.CCONT1 = cathist.nrec
join catalogs on  cathist.CCAT =  catalogs.nrec
join EXTCATLINKS on catalogs.nrec = EXTCATLINKS.STAFFCAT
join katpodr on  EXTCATLINKS.EXTCAT = katpodr.nrec
join persons on  katpodr.nrec = persons.GALDEP and  (persons.DISDATE = 0 or persons.DISDATE > :(CurDate))
left join Appointments App on App.nrec = Persons.AppointCur
left join catalogs post on  post.nrec = App.post
WHERE STRTITLE.nrec = #comp(0h) and   StrPart.wCodOper = 3
into tempStrProd;  */


//message (SubStr(tempStrProd.fio,pos(' ',tempStrProd.fio),30));
var _i : longint;
hPersonsMarker := InitMarker(_tmpMarkerName, 8, 200, 10);

  _i := 0;
while getmarker(hPersonsMarker, _i, PersNRec)
{
    if getfirst persons where ((PersNRec == persons.nrec)) = tsOk
    {
        ClearBuffer(#tempStrProd);
        tempStrProd.fio := persons.fio;
        if getfirst katpodr where ((Persons.GALDEP == katpodr.nrec)) = tsOk{
            tempStrProd.Podr := katpodr.name;
            tempStrProd.kodPodr := katpodr.kod;
            tempStrProd.cPodr := katpodr.nrec;
        }
        if getfirst Appointments where ((Persons.AppointCur == Appointments.nrec)) = tsOk{
            tempStrProd.NumContr := Appointments.CONTRACTNMB;
            tempStrProd.dateContr := Appointments.CONTRACTDATE;
            if getfirst catalogs where ((Appointments.post == catalogs.nrec)) = tsOk
               tempStrProd.Post := catalogs.name;

        }
        insert current tempStrProd;
    }
    _i++;
}
DoneMarker(hPersonsMarker, _tmpMarkerName);



_loop tempStrProd
{
StsRenPodr.PutEventById(feDoLoop, fcSStsRenPodr_Cycle1);
StsRenPodr.write(DateUved);
StsRenPodr.write(tempStrProd.Post);
StsRenPodr.write(CheckUprav(tempStrProd.cPodr));
StsRenPodr.write(tempStrProd.fio);
StsRenPodr.write(tempStrProd.fio);
StsRenPodr.write(DatePrik);
StsRenPodr.write(NumPrik);
StsRenPodr.write(NamePrik);
StsRenPodr.write(tempStrProd.Podr);
StsRenPodr.write(tempStrProd.kodPodr);
StsRenPodr.write(tempStrProd.dateContr);
StsRenPodr.write(tempStrProd.NumContr);
StsRenPodr.write(DateBeg);
StsRenPodr.write(CheckUprav(tempStrProd.cPodr)/*tempStrProd.Podr*/);
StsRenPodr.write(tempStrProd.kodPodr);
StsRenPodr.write(NamePodr);
StsRenPodr.write(kodPodr);
StsRenPodr.write(tempStrProd.dateContr);
StsRenPodr.write(tempStrProd.NumContr);
StsRenPodr.write(tempStrProd.fio);
StsRenPodr.write(NameUpr);
StsRenPodr.write(Datedo);
}
  if (not StsRenPodr.Error)
      StsRenPodr.showfile();
  StsRenPodr.ReInit;
}


//─────────────────────────────────────────────────────────────────────────
  panel panMakeRep;
    screen scrMakeRep;
Fields
   sPerson ('Сотрудники',,sci13Esc)  : Protect;
  [RpdFld1]    DateUved : noProtect;
  [RpdFld2]    DatePrik : noProtect;
  [RpdFld3]    NumPrik  : noProtect;
  [RpdFld4]    NamePrik : noProtect;
  [RpdFld5]    DateBeg  : noProtect;
  [RpdFld9]    Datedo   : noProtect;
  [RpdFld6]    NamePodr : noProtect;
  [RpdFld7]    kodPodr  : noProtect;
  [RpdFld8]    NameUpr  : noProtect;
Buttons
  cmDoOk, default;
  cmCancel;
<<
 `Сотрудники`                     .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Дата`                           .@@@@@@@@@@@@@@@@
 `Дата приказа`                   .@@@@@@@@@@@@@@@@
 `Номер приказа`                  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Наименование приказа`           .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Дата начала`.@@@@@@@@@@@@@@@@        `Дата до`       .@@@@@@@@@@@@@@@@
 `Название будущего подразделения`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Код будущего подразделения`     .@@@@
 `Название будущего управления`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
                                            <. Продолжить .> <. Отмена .>
>>
    end; // scrRepBuild
  end; // panMakeRep


// *****************************************************************************
HandleEvent
cmInit:
{
  //message('TEST' + string(StrTitleNrec,0,0));

}    // cmInit
cmPick:
{
  case CurField of
   #sPerson:
      {
        hPersonsMarker := InitMarker(NameInterface + '_persons', 8, 200, 10);
        if (iGetKau.GetCodeKau(cgiMulti + cgiNotClear, cgKau_Persons, PersNRec) > 0)
          {
            _tmpMarkerName := iGetKau.GetMarkerName(cgKau_Persons);
            hPersonsMarker := InitMarker(_tmpMarkerName, 8, 200, 10);
            DoneMarker(hPersonsMarker, _tmpMarkerName);
          }
          set sPerson := GetPersNameFilter;
      }
   end;
}

cmDoOk:
{

  CreateFields;
}
  end;      // HandleEvent
end.

