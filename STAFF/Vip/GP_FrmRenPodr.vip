begin
  GetReportName := 'Уведомление о переименовании подразделений';
end;

function GetGroupName(Level: Word): String;
begin
#__UNUSED__(Level)
   GetGroupName := '';
end;

function GetPriority: Integer;
begin
  GetPriority := 0;
end;

function VisibleInModule(Ind: Byte): String;
begin
#__UNUSED__(Ind)
  VisibleInModule := 'StaffMainMenu';
end;

end.
