/*************************************************************************************************\
* Наименование:  ШР РПД 123                                                                       *
* Контур/Модуль: Кадры                                                                            *
* Примечание:    РПД на основе 23-го. При выборе ставки режим работы устанавливается не из ставки,*
*                а из первого назначения, привязанного к этой ставке. Закрыты все поля, кроме     *
*                условий труда                                                                    *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#000          |29/03/17|Евдокимов М.А.           |НПО Энергомаш                    *
\*************************************************************************************************/

#include SHR_RPD.vih

#component "Z_STAFFSHR"

vipinterface SHR_RPD_123(SHR_RPD_23);
public:
  procedure ISHR_RPD_Base.AfterConfirmAllCont;
  Procedure ISHR_RPD_Base.EnableDisable;
end;

interface SHR_RPD_123;

create view
as select gp_stafuser.StUser
from stafuser gp_stafuser
where (( UserName == gp_stafuser.StUser));

create view vApp
var
  _staffstructNrec: comp;
as select app.nrec
from appointments app
where ((
  _staffstructNrec == app.StaffStr
));

procedure AfterConfirmAllCont;
{
  if getfirst gp_stafuser != tsOk
    insert gp_stafuser set gp_stafuser.StUser := UserName;
  gp_stafuser.cRRR2 := 2; //UpdateSS wTypeUpdate
  gp_stafuser.cRRR3 := 010000000b; //UpdateSS wFieldForUpdate
  gp_stafuser.cRRR4 := 3; //UpdateSS wTypeOrder
  update current gp_stafuser;

  _loop StrPart
  {

    if StrPart.wCodOper != 123
      Continue;

    _loop StrCont
    {
      UpdateSS.Sts_Hist3(StrCont.cCont1, StrTitle.DocNmb, StrTitle.DocDate, StrPart.Nrec);
    }

  }
}

Procedure EnableDisable;
{
  inherited::EnableDisable;
  if StrTitle.wStatus = 0
  {
    ClearFieldOption(#HistSisOpl.NaSisOpl, ofSelectable);     //Система оплаты
    ClearFieldOption(#HistoryStr.HTaxRate, ofSelectable);     //Оклад/ставка
    ClearFieldOption(#HistKlVal.SimvolV, ofSelectable);       //Валюта оклада
    ClearFieldOption(#HistoryStr.HMinTaxRate, ofSelectable);  //Мин. оклад
    ClearFieldOption(#HistoryStr.HMaxTaxRate, ofSelectable);  //Макс. оклад
    //ClearFieldOption(#HistKlRejim.NRejim, ofSelectable);      //Режим
    //ClearFieldOption(#HistWorkCond.Name, ofSelectable);       //Условия
    ClearFieldOption(#KlKatego.NaiKat, ofSelectable);         //Категория
    ClearFieldOption(#SSDopAttrCat.Name, ofSelectable);       //Доп. хар-ка
  }
  //--- из РПД 23
  cfsSetProp('i_SCRDET23_BOSSPOST', cfpDefaultPickButton,false);
}

handleevent

cmPick:
{
  if inherited::handleevent(cmPick) = heOk
  {
    case curfield of
      #PostCat.Name:
      {
        if getfirst HistoryStr = tsOk
        {
          vApp._staffstructNrec := StrCont.cStr;
          if vApp.getFirst app = tsOk
          {
            set HistoryStr.cWorkRegim := vApp.app.WorkRegime;
            UpdateTable;
          }
        }
      }
    end;
  }
}

end; //handleevent

end.
