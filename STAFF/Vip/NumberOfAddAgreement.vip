#include GP_RepLaborContract.vih
#include GP_MenuDynamic.vih

#component "Z_StaffOrders"
alter interface NumberOfAddAgreement;
overload
  procedure INumberOfAddAgreementNew.ShowAgreementWin(_wLink: word; _cLink: comp; _dateAgreement: date; _cContract: comp; _cPsn: comp = 0; _cApp: comp = 0);
end;

create View  NumberOfAddAgreement
from
  ContDoc GP_ContDoc,
  AppHist GP_AppHist;

procedure ShowAgreementWin(_wLink: word; _cLink: comp; _dateAgreement: date; _cContract: comp; _cPsn: comp = 0; _cApp: comp = 0);
var CanPrintWord:boolean;
    cContDoc:comp;
{
  CanPrintWord:=false;
  cContDoc:=0;
  case _wLink of
    coContDoc:
      cContDoc:=_cLink;
    coAppHist:
      if (_cLink<>0)
        if (getfirst fastfirstrow GP_AppHist where((_cLink==GP_AppHist.NRec))=tsok)
          cContDoc:=GP_AppHist.cContDoc;
  end;

  if (cContDoc<>0)
    if (getfirst fastfirstrow GP_ContDoc where((cContDoc==GP_ContDoc.NRec))=tsok)
      case GP_ContDoc.TypeOper of
        3, 4, 5, 9, 10, 35, 50, 60, 61, 65, 70,
        101, 102, 104, 105, 107, 108, 109, 110, 111, 112, 113, 114, 115, 135, 136,
        201, 209, 236:
          CanPrintWord:=true;
      end;

  if (not CanPrintWord)
    DisableCommand(cmValue10);//Печать соглашения в Word

  inherited::ShowAgreementWin(_wLink,_cLink,_dateAgreement,_cContract,_cPsn,_cApp);
}

windowevent wnAgreement;
cmValue10:{//Печать соглашения в Word
  var Rep:GP_RepLaborContract;
  Rep.Run(GP_ContDoc.TypeOper,0,GP_ContDoc.NRec,GP_ContDoc.Person,0);
}
end;
end.

//Добавление пункта меню "Печать соглашения в Word"
handler with replace GP_MenuDynamic_AddItems_NumberOfAddAgreement on ExtensionPoint GP_MenuDynamic_AddItems
action
{
  result:=true;
  timelog('GP_MenuDynamic_AddItems_NumberOfAddAgreement');

  var MenuID:longint=0;
  _try {
    MenuID:=LoadMenuEx('Z_StaffOrders::OneAgreementMenu',false,true);

    AddMenuItem(MenuID,'separator',1);
    AddMenuItemEx(MenuID,'Печать соглашения в Word',
                         'Печать соглашения в Word','',cmValue10,0);

    if (not StoreMenuHowDynamics(MenuID,'Z_StaffOrders::OneAgreementMenu'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:{
      message('Ошибка регистрации меню для интерфейса обработки номеров доп. соглашений'#13+
              ExploreException,error);
    }
  _finally {
    if (MenuID<>0) DisposeLoadMenu(MenuID);
  }
  timelog('GP_MenuDynamic_AddItems_NumberOfAddAgreement finish');
}

//Удаление пункта меню "Печать соглашения в Word"
handler with replace GP_MenuDynamic_DelItems_NumberOfAddAgreement on ExtensionPoint GP_MenuDynamic_DelItems
action
{
  result:=true;

  DeleteMenuHowDynamics('Z_StaffOrders::OneAgreementMenu');
}
