#include SHR_RPD.vih

#component "Z_STAFFSHR"

vipinterface SHR_RPD_124(SHR_RPD_23);
public:
  procedure ISHR_RPD_Base.AfterConfirmAllCont;
  function ISHR_RPD_Base.ConfirmCurrOrder: boolean;
  Procedure ISHR_RPD_Base.EnableDisable;
end;

interface SHR_RPD_124;

create view vApp
var
  _staffstructNrec: comp;
as select app.nrec
from appointments app, AppHist
where ((
  _staffstructNrec == app.StaffStr and
  app.Nrec == AppHist.cAppoint
));

function ISHR_RPD_Base.ConfirmCurrOrder: boolean;
{
  //Перед проведением приказа обновляем поля HistoryStr из StaffStruct
  //это происходит при выборе ставки (в стандартном рпд23 а значит и в текущем),
  //чтобы точно изменить только доп характеристики ставки еще раз копируем
  if IsValidAll(tnStaffStruct)
  {
    set HistoryStr.HWorkStations:= StaffStruct.WorkStations;
    set HistoryStr.cTariff    := StaffStruct.Tariff;
    set HistoryStr.wCategory  := StaffStruct.Category;
    set HistoryStr.HMaxTaxRate:= StaffStruct.MaxSumma;
    set HistoryStr.HMinTaxRate:= StaffStruct.MinSumma;
    set HistoryStr.wPayModel  := StaffStruct.PayModel;
    set HistoryStr.cWorkCond  := StaffStruct.WorkCond;
    set HistoryStr.cWorkRegim := StaffStruct.WorkRegime;
    set HistoryStr.cCurrency  := StaffStruct.PayCurrency;
    set HistoryStr.HTaxRate   := StaffStruct.TaxRate;
    set HistoryStr.LastUser   := StaffStruct.LastUser;
    set HistoryStr.cRez1      := StaffStruct.cDop1;
    set HistoryStr.cRez2      := AKps.GetStaffStrMainKPS(StaffStruct.NRec);
    set HistoryStr.dFld       := StaffStruct.dNew1;
    set HistoryStr.cSpr2      := StaffStruct.EmpCategory;
    //set HistoryStr.cSpr3      := StaffStruct.cInf3;
    update current HistoryStr;
  }

  result := Inherited::ConfirmCurrOrder;
}

procedure AfterConfirmAllCont;
{
//Замечания 29.05.18 - не обновлять информацию в назначениях сотрудников, поэтому, код ниже закомменчиваем
}

Procedure EnableDisable;
{
  inherited::EnableDisable;

  cfsSetCurrentContainer(cfsGetCurrentContainerSelf);
  if StrTitle.wStatus = 0
  {
    ClearFieldOption(#HistSisOpl.NaSisOpl, ofSelectable);     //Система оплаты
    ClearFieldOption(#HistKlVal.SimvolV, ofSelectable);       //Валюта оклада
    ClearFieldOption(#HistWorkCond.Name, ofSelectable);       //Условия
    ClearFieldOption(#KlKatego.NaiKat, ofSelectable);         //Категория
    ClearFieldOption(#osob_usl, ofSelectable);                //Условия труда
    ClearFieldOption(#HistoryStr.dFld, ofSelectable);         //Дата проведения спец. оценки
  }

  ClearFieldState(#HistoryStr.hTaxRate, sfVisible);         //Оклад
  HideLabel4Field(#HistoryStr.hTaxRate);

  ClearFieldState(#HistoryStr.hMinTaxRate, sfVisible);      //Минимальный оклад
  HideLabel4Field(#HistoryStr.hMinTaxRate);

  ClearFieldState(#HistoryStr.hMaxTaxRate, sfVisible);      //Максимальный оклад
  HideLabel4Field(#HistoryStr.hMaxTaxRate);
  cfsSetProp('T_SCRDET23_Мин.-макс.оклад', cfpHidden, true);
  cfsSetProp('T_SCRDET23_-', cfpHidden, true);

  ClearFieldState(#HistTarStav.NaiTar, sfVisible);          //Тариф
  HideLabel4Field(#HistTarStav.NaiTar);
  cfsSetProp('T_SCRDET23_Тариф', cfpHidden, true);
  cfsSetProp('T_SCRDET23_Оклад/cтавка', cfpHidden, true);

  ClearFieldState(#HistKlRejim.NRejim, sfVisible);          //Режим
  HideLabel4Field(#HistKlRejim.NRejim);
  cfsSetProp('T_SCRDET23_Режим', cfpHidden, true);

  ClearFieldState(#HistWorkCond.Name, sfVisible);           //Условия
  HideLabel4Field(#HistWorkCond.Name);

  ShowButton(scrDet23, cmValue10, false);                   //Добавление доплаты
  ShowButton(scrDet23, cmValue11, false);                   //Удаление доплаты
  //--- из РПД 23
  cfsSetProp('i_SCRDET23_BOSSPOST', cfpDefaultPickButton,false);
}

handleevent
cmPick:
{
  if inherited::handleevent(cmPick) = heOk
  {
    case curfield of
      #PostCat.Name:
      {
        if getfirst HistoryStr = tsOk
        {
          //Устанавливаем дату изменения как максимальную дату из истории назначений по данной ставке + 1 день
          vApp._staffstructNrec := StrCont.cStr;
          var d: date = 0;
          vApp._loop app
            vApp._loop AppHist
              if d < vApp.AppHist.dRec d := vApp.AppHist.dRec;

          set HistoryStr.dHist := if(d > 0, Add_Day(d, 1), Cur_Date);
          UpdateTable;
        }
      }
    end;
  }
}
end; //handleevent

end.
