#include GetAttrTable.vih

VipInterface GP_CreateAttrRef implements ObjCreateAttrRefPlugin  licensed (Free);
Interface GP_CreateAttrRef;

Create view
var
  pAttrVal:comp;
  pCatalogs:comp;
  pvPlan :comp;
As Select AttrVal.Nrec
From
  AttrVal, AttrNam, Catalogs, vPlan
where ((
     pAttrVal == AttrVal.Nrec
and  AttrVal.cAttrNam == AttrNam.Nrec
and  pCatalogs        == Catalogs.Nrec
and  pVPlan           == vPlan.nrec

));

//  AttrRef ссылка на интерфейс GetAttrTable
Procedure AddAttrRefTable (AttrRef : ObjGetAttrTable);
{
  AttrRef.AddTable(coStaffStruct);//ссылка на ставку ШР
  AttrRef.AddTable(coCatalogs);//ссылка на Catalogs
  AttrRef.AddTable(coVPLAN);//ссылка на группы планов
}

//  Реализация интерфейса вызова для таблицы
Function PickValueRef (_coTable: word; _cAttrVal: comp): boolean;
var
  bChangeValue : boolean;
{
  result := false;
  pAttrVal:=_cAttrVal;
  if (getfirst fastfirstrow AttrVal<> tsOk)
    Exit;

  bChangeValue := false;
  case _coTable of
    coVPLAN :
    { result := true;
      pVPlan:=AttrVal.vComp;
      if (RunInterface(GRVPLAN,pVPlan,0
        ,17//pWorkType
         ) <> cmCancel)
        if (cRec<>AttrVal.vComp) {
          bChangeValue:=true;
          AttrVal.vComp:=pVPlan;
          if getfirst VPlan=tsok
            AttrVal.vString:=VPlan.Name
        }


    }
    coStaffStruct:{//ссылка на ставку ШР
      result := true;
      var cRec:comp;
      cRec:=AttrVal.vComp;
      if (RunInterface(GP_PickStaffStruct,cgiPick,cRec,AttrVal.vString) = cmDefault)
        if (cRec<>AttrVal.vComp) {
          bChangeValue:=true;
          AttrVal.vComp:=cRec;
        }
      }
    coCatalogs:
    { var  _syscode:longint=0;
      result := true;
      pCatalogs:=AttrVal.vComp;
      if pos(',',AttrNam.Name)>0
      {  _syscode:=longint(trim(substr(AttrNam.Name,pos(',',AttrNam.Name)+1,100)))
      }
      if RunInterface (PickCatalog2, _syscode, pCatalogs, comp(0), comp(0)) = cmDefault
      {
        AttrVal.vComp:= pCatalogs;
        if getfirst Catalogs =0   AttrVal.vString :=Catalogs.Code+' '+Catalogs.Name ;
        bChangeValue:=true;
      }
    }
  end; // case

  if (bChangeValue) {
    var err : word;
    err := Update current AttrVal;
    if (err <> 0) {
      Message ('Ошибка N ' + string(err) + ' обновления записи в таблице AttrVal.');
      exit;
    }
  }

}
end.

//------------------------------------------------------------------------------
Handler with replace GP_CreateAttrRefTable on extensionPoint  epCreateAttrRefTable (AttrRef : ObjGetAttrTable) [110]
Action
{
   Result := true;
   var ifc : GP_CreateAttrRef;
   ifc.AddAttrRefTable (AttrRef);
}


//------------------------------------------------------------------------------
Handler with replace GP_PickTableRef on extensionPoint  epPickTableRef (_coTable: word; _cAttrVal: comp) [110]
Action
{
   var ifc : GP_CreateAttrRef;
   Result := not ifc.PickValueRef (_coTable, _cAttrVal);
}
