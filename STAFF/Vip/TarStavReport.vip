/*************************************************************************************************\
* Наименование:  Разработка отчетной формы                                                        *
*                       "Тарифные ставки и профессии"                                             *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:    Управление персоналом -> Операции -> Тарифные ставки -> Контекстное меню "Печать"*                             *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#156          |27/08/17|Валента А.В.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include TarRates.vih

interface TarStavReport '' EscClose;

table struct tblSchema
(
  NRec   : comp
, Name   : string
, cM1    : comp
, cM2    : comp
, cM3    : comp
, cQ     : comp
, cY     : comp
)
with index
(
  tblSchema01 = NRec (Unique, Surrogate)
, tblSchema02 = Name
);
//*****************************************************************************
table struct tblReport
(
  NRec        : comp
, cSchema     : comp
, sSysOpl     : string
, sTarNet     : string
, sClassOpl   : string
, sRaz        : string
, Tarif       : double
, MinOklad    : double
, MaxOklad    : double
, NadBM       : double
, NadB        : double
, NadA        : double
, NadAP       : double
, NadAPP      : double
, Pr021       : double
, Pr022       : double
, Pr023       : double
, PrQ         : double
, PrY         : double
)
with index
(
  tblReport01 = NRec (Unique, Surrogate)
, tblReport02 = cSchema
);
//*****************************************************************************

create view
var
  ChangeDate: date;
 
  cM1
, cM2
, cM3 

, cQ
, cY    : comp;
as select
  *
from
  TarStav
, GP_TarStavExt
, tblSchema
, tblReport
, tblReport tblReport2
, MinRazr
, Catalogs
where 
((
    tblSchema.NRec    == tblReport.cSchema

AND ChangeDate        == MinRazr.DatIzm
AND ChangeDate        == TarStav.DatIzm
AND TarStav.NRec      == GP_TarStavExt.cTarStav
AND TarStav.SisOpl    == KlSisOpl.SisOpl

))

order by TarStav.SisOpl
;

Parameters
  ChangeDate
;

//*****************************************************************************
Function GetNameColumn(cRec : comp) : string;
{
  var sRes : string; sRes := '';

  if (GetFirst Catalogs where ((cRec == Catalogs.NRec)) = tsOk)
    sRes := Catalogs.Name + ' (в/о ' + Catalogs.Code + ')'; 
   
  result := sRes;
}
//*****************************************************************************

datastream TarStavReportStream
(
  [CFH        ]      CommonFormHeader;
  [dReport]      DateToStr(ChangeDate, 'DD.MM.YYYY');

  table tblSchema
  (
     [NRec]  tblSchema.NRec;
     [Name]  tblSchema.Name;
     [cM1 ]  GetNameColumn(tblSchema.cM1);
     [cM2 ]  GetNameColumn(tblSchema.cM2);
     [cM3 ]  GetNameColumn(tblSchema.cM3);
     [cQ  ]  GetNameColumn(tblSchema.cQ );
     [cY  ]  GetNameColumn(tblSchema.cY );
  );                                    
  table tblReport
  (
     [NRec     ]  tblReport.NRec     ;
     [cSchema  ]  tblReport.cSchema  ;
     [sSysOpl  ]  tblReport.sSysOpl  ;
     [sTarNet  ]  tblReport.sTarNet  ;
     [sClassOpl]  tblReport.sClassOpl;
     [sRaz     ]  tblReport.sRaz     ;
     [Tarif    ]  tblReport.Tarif    ;
     [MinOklad ]  tblReport.MinOklad ;
     [MaxOklad ]  tblReport.MaxOklad ;
     [NadBM    ]  tblReport.NadBM    ;
     [NadB     ]  tblReport.NadB     ;
     [NadA     ]  tblReport.NadA     ;
     [NadAP    ]  tblReport.NadAP    ;
     [NadAPP   ]  tblReport.NadAPP   ;
     [Pr021    ]  tblReport.Pr021    ;
     [Pr022    ]  tblReport.Pr022    ;
     [Pr023    ]  tblReport.Pr023    ;
     [PrQ      ]  tblReport.PrQ      ;
     [PrY      ]  tblReport.PrY      ;
  ); 
)
end;
//*****************************************************************************
Function CreateGroup(name : string) : comp;
{
  if (GetFirst tblSchema where ((name == tblSchema.Name)) <> tsOk)
    {
      ClearBuffer(#tblSchema);
      tblSchema.Name := name;
      if (insert current tblSchema = tsOk)
        {}
    }

  result := tblSchema.NRec;
}
//*****************************************************************************
procedure ReportForm;
{
  delete all tblSchema;
  delete all tblReport;
  
  _LOOP TarStav
    {
      var nameSchema : string; nameSchema := '';

      ClearBuffer(#tblReport2);
      set tblReport2.sSysOpl   := KlSisOpl.NaSisOpl;
      set tblReport2.sTarNet   := TarStav.CodTar;
      set tblReport2.sClassOpl := TarStav.NaiTar;
      set tblReport2.sRaz      := TarStav.Razr;
      set tblReport2.Tarif     := TarStav.Tarif;
      set tblReport2.MinOklad  := TarStav.TarMin;
      set tblReport2.MaxOklad  := TarStav.TarMax;

      if (GetFirst GP_TarStavExt = tsOk) 
        { 
          tblReport2.cSchema   := CreateGroup(GP_TarStavExt.SchemeName);
          var i : word;
          for (i := 1; i <= 3; inc(i))
            {
              if (tblSchema.cM1 <> GP_TarStavExt.cMonthlyBonusType[i]  
              AND tblSchema.cM2 <> GP_TarStavExt.cMonthlyBonusType[i]  
              AND tblSchema.cM3 <> GP_TarStavExt.cMonthlyBonusType[i])
                {
                  if (tblSchema.cM1 = comp(0))
                    set tblSchema.cM1 := GP_TarStavExt.cMonthlyBonusType[i];
                  else if (tblSchema.cM2 = comp(0))
                    set tblSchema.cM2 := GP_TarStavExt.cMonthlyBonusType[i];
                  else if (tblSchema.cM3 = comp(0))
                    set tblSchema.cM3 := GP_TarStavExt.cMonthlyBonusType[i];
                }
            }

          if (tblSchema.cQ = comp(0))  
            set tblSchema.cQ := GP_TarStavExt.cQuarterlyBonusType;

          if (tblSchema.cY = comp(0)) 
            set tblSchema.cY := GP_TarStavExt.cAnnualBonusType;

          if (update current tblSchema = tsOk)
            {}  

          set tblReport2.NadBM     := GP_TarStavExt.PersonalBonus[1];
          set tblReport2.NadB      := GP_TarStavExt.PersonalBonus[2];
          set tblReport2.NadA      := GP_TarStavExt.PersonalBonus[3];
          set tblReport2.NadAP     := GP_TarStavExt.PersonalBonus[4];
          set tblReport2.NadAPP    := GP_TarStavExt.PersonalBonus[5];

          for(i := 1; i <= 3; inc(i))
            {
              if (tblSchema.cM1 = GP_TarStavExt.cMonthlyBonusType[i])
                set tblReport2.Pr021 := GP_TarStavExt.MonthlyBonus[i];
              if (tblSchema.cM2 = GP_TarStavExt.cMonthlyBonusType[i])
                set tblReport2.Pr022 := GP_TarStavExt.MonthlyBonus[i];
              if (tblSchema.cM3 = GP_TarStavExt.cMonthlyBonusType[i])
                set tblReport2.Pr023 := GP_TarStavExt.MonthlyBonus[i];
            }

          if (tblSchema.cQ = GP_TarStavExt.cQuarterlyBonusType)
            set tblReport2.PrQ       := GP_TarStavExt.QuarterlyBonus;

          if (tblSchema.cY = GP_TarStavExt.cAnnualBonusType)
            set tblReport2.PrY       := GP_TarStavExt.AnnualBonus;
        }
      else
        tblReport2.cSchema   := CreateGroup('');

      if (insert current tblReport2 = tsOk)
        {}
    }

  RunFReport(TarStavReportStream, '', false);
} //procedure ReportForm;

HandleEvent

cmInit:
  {
    ReportForm;
  } //cmInit:

end;
end.
