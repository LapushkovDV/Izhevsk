/*************************************************************************************************\
* Наименование:  Условие труда на рабчем месте                                                    *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |              |14/01/24 |Лапыгин Д.С.             |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih
#include AppointKps.vih
#include AppFuncs.vih // Функции работы с назначениями
#include CatFunc.vih  // Функции работы с каталогом

interface gp_harmatwork 'Параметры отчета' gray
Show at (,,43,5);

var AKPS: AppointKps;
    VAppFuncs: AppointmentsFunctions;
    ICatFunc: CatalogsFunctions;

Table Struct Sotr (
    NRec       : comp,
    Tabn       : string,
    Fio        : string,
    lsnrec     : comp,
    lscexdop   : comp,
    appnrec    : comp,
    shrnrec    : comp,
    Podr_code  : string,
    Podr_name  : string,
    Post       : string,
    appus      : string,
    lsUsl      : string,
    appUsl     : string,
    shrUsl     : string,
    lsDopl     : double,
    appDopl    : double,
    shrDopl    : double

)
    with index (
      ind0 = NRec
);

create view gp_harmatwork

var
data_sel: date;
counter: longint;
ExcelPath: string;

select *
from sotr
   , appointments
   , InfPsn3
   , doplata
   , raise
   , raisests
   , raisealg
where ((
          sotr.appnrec   == appointments.nrec and
          sotr.shrnrec   == InfPsn3.cPers     and
          cgsStaff       == InfPsn3.LastUser  and
          cgKpsKind_Main == InfPsn3.LastTime  and
          raisests.nrec  == raisealg.raisestst
      ))
;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  data_sel, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    На дату:.@@@@@@@@@@

    <.Сформировать.>

    >>
end;

procedure FillSotr;
var hStr:longint;
    strdate:string;
{
  StartNewVisual( vtRotateVisual, vfTimer, 'Отбор сотрудников...', 0);

  strdate:=day(data_sel)+','+month(data_sel) +','+year(data_sel);

  delete all Sotr;


  hStr:=0;
  sqlAddStr(hStr,'select Persons.NRec             as nrec                    ');
  sqlAddStr(hStr,'     , Persons.StrTabn          as tabn                    ');
  sqlAddStr(hStr,'     , Persons.FIO              as fio                     ');
  sqlAddStr(hStr,'     , LSCHET.nrec              as lsnrec                  ');
  sqlAddStr(hStr,'     , LSCHET.CEXDOP[10]        as lscexdop                ');

  sqlAddStr(hStr,'from Persons                                               ');
  sqlAddStr(hStr,'join lschet on lschet.tperson = persons.nrec               ');
  sqlAddStr(hStr,'join katpodr on katpodr.nrec = persons.galdep              ');

  sqlAddStr(hStr,'where (Persons.disdate=0 or Persons.disdate>=#date('+strdate+')) ');
  sqlAddStr(hStr,'  and (lschet.datuv=0 or lschet.datuv>=#date('+strdate+')) ');
  sqlAddStr(hStr,'  and katpodr.kod not in (  ''446'', ''702'', ''719'', ''Вет'' ');
   sqlAddStr(hStr,'  , ''_Профком'', ''_Студенты'', ''_ФИЗ ЛИЦ'', '''')  ');

  if (sqlSelectIntoByName(hStr,tnSotr)<>tsok)
    message('Ошибка выполнения DSQL запроса при отборе сотрудников.',error);
  sqlFreeStr(hStr);

  _loop Sotr
  {
     Set Sotr.appnrec := VAppFuncs.GetAppNRec_OnDate(sotr.NRec, data_sel);
     Update Current Sotr;

     _loop appointments
     {
       Set Sotr.shrnrec   :=appointments.staffstr;
       Set Sotr.podr_code :=ICatFunc.GetCatalogsCode(appointments.department);
       Set Sotr.podr_name :=ICatFunc.GetCatalogsName(appointments.department);
       Set Sotr.post      :=VAppFuncs.GetAppPost(appointments.nrec);
       Set Sotr.appus     :=VAppFuncs.GetWorkCondAppHist(appointments.nrec, data_sel);
       Update Current Sotr;
     }

     Set Sotr.lsUsl  :=Akps.GetKpsSTR(sotr.lscexdop);
     Set Sotr.appUsl :=AKps.GetKpsSTR(AKps.GetMainKPS(Sotr.appnrec));
     Update Current Sotr;

     _loop InfPsn3
     {
       Set Sotr.shrUsl :=Akps.GetKpsSTR(InfPsn3.cref1);
       Update Current Sotr;
     }

     _loop doplata where (( sotr.lsnrec == doplata.clsch
                        and 62 == doplata.vidopl
                        and (data_sel >= doplata.datann and (data_sel <= doplata.datok or 0=doplata.datok))
                          ))
     {
       set Sotr.lsdopl:=doplata.proc;
       Update Current Sotr;
     }

     _loop raise where ((    sotr.nrec==raise.person
                         and sotr.appnrec==raise.appoint
                         and comp(0001000000000574h)==raise.raisetype
                         and (data_sel>=raise.FROMDATE
                         and (data_sel<=raise.TODATE or 0=raise.TODATE)) ))
     {
       set Sotr.appdopl:=raise.sum;
       Update Current Sotr;
     }

      _loop raisests where ((    sotr.shrnrec==raisests.staffstr
                         and comp(0001000000000574h)==raisests.raisetype
                         and (data_sel>=raisests.DRBEG
                         and (data_sel<=raisests.DREND or 0=raisests.DREND)) ))
     {
       _loop raisealg
       {
         set Sotr.shrdopl:=raisealg.sum;
         Update Current Sotr;
       }
     }

  }

  StopVisual;

}

handleevent

cmInit:
{
  data_sel:= cur_date;
}

cmGo:
{
  FillSotr;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_harmatwork.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  counter:= 3;

  _loop Sotr
  {
    counter++;
    xlsetcellstringvalue(Sotr.Tabn, counter, 1, counter, 1);
    xlsetcellstringvalue(Sotr.FIO , counter, 2, counter, 2);
    xlsetcellstringvalue(Sotr.podr_code, counter, 3, counter, 3);
    xlsetcellstringvalue(Sotr.podr_name, counter, 4, counter, 4);
    xlsetcellstringvalue(Sotr.post, counter, 5, counter, 5);
    xlsetcellstringvalue(Sotr.appus, counter, 6, counter, 6);
    xlsetcellstringvalue(Sotr.lsUsl, counter, 7, counter, 7);
    xlsetcellstringvalue(Sotr.appUsl, counter, 8, counter, 8);
    xlsetcellstringvalue(Sotr.shrUsl, counter, 9, counter, 9);
    xlsetcellstringvalue(Sotr.lsdopl, counter, 10, counter, 10);
    xlsetcellstringvalue(Sotr.appdopl, counter, 11, counter, 11);
    xlsetcellstringvalue(Sotr.shrdopl, counter, 12, counter, 12);
  }

  xlframecells(1+2+4+8+16+32, 2, 1, 1, 5, 1, counter, 12);
  xlframecells(2, 3, 1, 1, 4, 6, counter, 6);
  xlframecells(2, 3, 1, 1, 4, 9, counter, 9);
  xlframecells(2, 3, 1, 1, 4, 12, counter, 12);

  StopVisual('',0);
  xlkillExcel;

}

end;
end.

VipInterface UserReport_harmatwork Implements IUserReport;
Interface UserReport_harmatwork;

Procedure Run;
Begin
  runinterface(gp_harmatwork);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Условие труда на рабочем месте ЛС/Картотека/ШР';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
  Case Level of
    1 : GetGroupName := 'Отчеты по вредным условиям труда';
  End;
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
