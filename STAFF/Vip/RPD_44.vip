#include GP_RepLaborContract.vih

#component "Z_StaffOrders"
alter interface RPD_44;
overload
  procedure prFillMenu(_menuID: longint);
end;

//включение стандартных пунктов контекстного меню приказа
procedure prFillMenu(_menuID: longint);
{
  inherited::prFillMenu(_menuID);

  AddMenuItem(_menuID,'separator',1);
  AddMenuItem(_menuID, 'Печать приказа в Word ЭМ', cmValue18);
}

HandleEvent
cmValue18:{//Печать приказа в Word ЭМ
  if (not UpDateTable) exit;

  var Rep:GP_RepLaborContract;
  Rep.Run(ContDoc.TypeOper,1,ContDoc.NRec,ContDoc.Person,ContDoc.ObjNRec);
}
end;
end.
