#include CatFunc.vih         // Функции работы с Catalogs
#include RunStaj.vih         // Функции расчета стажей

#include GP_UserFilterStoreDSK.vih
#include GP_UserFilterCatalogs.vih
#include GP_UserFilterDopTables.vih
#include GP_UserFilterKlKatego.vih
#include GP_UserFilterList.vih
#include GP_QueryBuilder.vih

#include GP_AutoMarkPersons.vih
interface GP_AutoMarkPersons;

var UserFilterList:GP_ObjUserFilterList;
    FilterStore:GP_IUserFilterStore;
    iQBuilder:GP_QueryBuilder new;
    iCatFunc:CatalogsFunctions;
    iRunStaj:RunStaj;

table struct MemPersons(NRec:comp);

create view
var ViewBase,Gender,ServiceFrom,ServiceTo,AgeFrom,AgeTo:word;
from
  MemPersons;

window WinParam 'Параметры отбора' DoAccept, EscClose, Gray;
show(50,5,96,25);

screen scParam (,,sci13Esc);
fields
  ViewBase:[list 'текущие','архивные','работающие','уволенные','вся картотека'],Protect;
  [LengthOfService] UserFilterList.FilterStr(1) (,,sci13Esc):Protect,PickButton;
  ServiceFrom (,,sci1Esc):NoProtect,LessNull;
  ServiceTo (,,sci1Esc):NoProtect,LessNull;
  Gender:[list '-','М','Ж'],Protect;
  AgeFrom (,,sci1Esc):NoProtect,LessNull;
  AgeTo (,,sci1Esc):NoProtect,LessNull;
  [ParticipationInMilitaryConflicts] UserFilterList.FilterStr(2) (,,sci13Esc):Protect,PickButton;
  [Veteran] UserFilterList.FilterStr(3) (,,sci13Esc):Protect,PickButton;
  [Category] UserFilterList.FilterStr(4) (,,sci13Esc):Protect,PickButton;
  [Features] UserFilterList.FilterStr(5) ('Содержание графы анкеты',,sci13Esc):Protect,PickButton;
buttons
  cmOK,,,'Продолжить',,sci1Esc;
  cmCancel,,,'Выход',,sci1Esc;
buttons
<<
 `База для просмотра`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Стаж работы`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  Период стажа
 `от`.@@@@ `до`.@@@@
 `Пол`.@@@
  Возраст
 `от`.@@@@ `до`.@@@@
 `Участие в военных конфликтах`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Ветеран`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Категория персонала`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Анкетные данные`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 <.Продолжить.>                 <.  Отмена  .>
>>
end;

HandleEvent
cmInit:{
  ReadMyDsk(ViewBase,#__InterfaceName__+'ViewBase',false);
  ReadMyDsk(ServiceFrom,#__InterfaceName__+'ServiceFrom',false);
  ReadMyDsk(ServiceTo,#__InterfaceName__+'ServiceTo',false);
  if (ServiceFrom=0 and ServiceTo=0) {
    ServiceFrom:=25;
    ServiceTo:=70;
  }
  ReadMyDsk(Gender,#__InterfaceName__+'Gender',false);
  ReadMyDsk(AgeFrom,#__InterfaceName__+'AgeFrom',false);
  ReadMyDsk(AgeTo,#__InterfaceName__+'AgeTo',false);

  FilterStore:=GP_IUserFilterStore(new(GP_UserFilterStoreDSK,InitDSK(#__InterfaceName__)));
  UserFilterList:=GP_ObjUserFilterList(new(GP_UserFilterList,UserFilterList(FilterStore)));
  UserFilterList.Add(GP_IUserFilter(new(GP_UserFilterCatalogs,UserFilterCatalogs(fnLengthOfService,'mLengthOfService',-19))));
  UserFilterList.Add(GP_IUserFilter(new(GP_UserFilterCatalogs,UserFilterCatalogs(fnParticipationInMilitaryConflicts,
                                                                                 'mParticipationInMilitaryConflicts',1450))));
  UserFilterList.Add(GP_IUserFilter(new(GP_UserFilterDopTables,UserFilterDopTables(fnVeteran,'mVeteran'))));
  UserFilterList.Add(GP_IUserFilter(new(GP_UserFilterKlKatego,UserFilter(fnCategory,'mKlKatego'))));
  UserFilterList.Add(GP_IUserFilter(new(GP_UserFilterCatalogs,UserFilterCatalogs(fnFeatures,'mFeatures',58))));

  var m:TPtr;
  m:=FilterStore.LoadMarker('mLengthOfService');
  if (GetMarkerCount(m)=0) {
    InsertMarker(m,iCatFunc.GetCatalogsNRec(89));//По умолчанию установить значение "Стаж работы на предприятии"
    FilterStore.SaveMarker(m,'mLengthOfService');
  }
  else
    DoneMarker(m,'');

  UserFilterList.Load;
}
cmDone:{
  SaveMyDsk(ViewBase,#__InterfaceName__+'ViewBase');
  SaveMyDsk(ServiceFrom,#__InterfaceName__+'ServiceFrom');
  SaveMyDsk(ServiceTo,#__InterfaceName__+'ServiceTo');
  SaveMyDsk(Gender,#__InterfaceName__+'Gender');
  SaveMyDsk(AgeFrom,#__InterfaceName__+'AgeFrom');
  SaveMyDsk(AgeTo,#__InterfaceName__+'AgeTo');

  UserFilterList.Save;
}
cmOK:{
  PutCommand(cmDefault);
}
end;
end;//WinParam

function Run(Marker:TPtr):boolean;
var m,mLengthOfService:TPtr;
    i,mCount:longint;
    cTypeStaj:comp;
    wStajYears:word;
    flag:boolean;
{
  result:=false;
  if (Marker=0) exit;

  if (RunWindowModal(WinParam)<>cmDefault) exit;

  StartNewVisual(vtRotateVisual, vfTimer, 'Отбор сотрудников...', 0);

  delete all MemPersons;
  iQBuilder.AddToSelect('distinct Persons.NRec');
  iQBuilder.AddToFrom('Persons');

  iQBuilder.AddToWhere('Persons.dDop1=',ZeroDate);//Умершие сотрудники, не должны попадать в выборку

  case ViewBase of
    0://текущие
      iQBuilder.AddToWhere('Persons.IsEmployee=', 'С');
    1://архивные
      iQBuilder.AddToWhere('Persons.IsEmployee=', 'У');
    2:{//работающие
      iQBuilder.AddToWhere('Persons.IsEmployee=', 'С');
      iQBuilder.AddToWhere('Persons.DisDate=',ZeroDate);
    }
    3://уволенные
      iQBuilder.AddToWhere('Persons.DisDate>',ZeroDate);
    4:{//вся картотека, т.е. текущие и архивные
      iQBuilder.AddToWhere('(Persons.IsEmployee=', 'С');
      iQBuilder.AddToWhere('or Persons.IsEmployee=''У'')');
    }
  end;

  //Стаж работы
  mLengthOfService:=FilterStore.LoadMarker('mLengthOfService');
  if (GetMarkerCount(mLengthOfService)>0) {
    iQBuilder.AddToFrom('inner join ServLen on (Persons.NRec = ServLen.Person and '+string(slStaffServLenCur)+' = ServLen.CurRec)');
    iQBuilder.AddToWhereMarker('ServLen.Position',mLengthOfService);
  }

  case Gender of
    1:iQBuilder.AddToWhere('Persons.Sex=', 'М');
    2:iQBuilder.AddToWhere('Persons.Sex=', 'Ж');
  end;

  //Возраст
  if (AgeFrom<>0)
    iQBuilder.AddToWhere('Persons.BornDate<=', Sub_Months(Cur_Date,12*AgeFrom));
  if (AgeTo<>0)
    iQBuilder.AddToWhere('Persons.BornDate>=', Sub_Months(Cur_Date,12*AgeTo));

  //Участие в военных конфликтах
  m:=FilterStore.LoadMarker('mVeteran');
  if (GetMarkerCount(m)>0) {
    iQBuilder.AddToFrom('inner join DopInfo on (Persons.NRec = DopInfo.cPerson)');
    iQBuilder.AddToWhereMarker('DopInfo.cDopTbl',m);
  }
  DoneMarker(m,'');

  //Ветеран
  m:=FilterStore.LoadMarker('mParticipationInMilitaryConflicts');
  if (GetMarkerCount(m)>0)
    iQBuilder.AddToWhereMarker('Persons.cPrizn1',m);
  DoneMarker(m,'');

  //Категория персонала
  m:=FilterStore.LoadMarker('mKlKatego');
  if (GetMarkerCount(m)>0) {
    iQBuilder.AddToFrom('inner join Appointments on ('+
                        'case when Persons.AppointCur = #comp(0) then Persons.AppointLast '+
                             'else Persons.AppointCur end = Appointments.Nrec)');
    iQBuilder.AddToWhereMarker('Appointments.EmpCategory',m);
  }
  DoneMarker(m,'');

  //Анкетные данные
  m:=FilterStore.LoadMarker('mFeatures');
  if (GetMarkerCount(m)>0) {
    iQBuilder.AddToFrom('inner join Features on (Persons.Nrec = Features.Person)');
    iQBuilder.AddToWhereMarker('Features.Position',m);
  }
  DoneMarker(m,'');

  result:=sqlSelectInto(iQBuilder.Make,tnMemPersons)=tsok;
  if (not result)
    message('Ошибка выполнения DSQL запроса при отборе сотрудников.',error)
  else {
    ClearMarker(Marker);

    mCount:=GetMarkerCount(mLengthOfService);
    cTypeStaj:=0;
    _loop MemPersons {
      if (mCount>0 and (ServiceFrom<>0 or ServiceTo<>0)) {
        flag:=false;
        for(i:=0;i<mCount;i++) {
          GetMarker(mLengthOfService,i,cTypeStaj);
          wStajYears:=iRunStaj.NGetStajYears(MemPersons.Nrec, cTypeStaj, Cur_Date);

          flag:=ServiceFrom<>0 and wStajYears<ServiceFrom;
          flag:=flag or (ServiceTo<>0 and wStajYears>ServiceTo);
          if (flag) break;
        }
        if (flag) continue;
      }

      InsertMarker(Marker,MemPersons.NRec);
    }
  }
  DoneMarker(mLengthOfService,'');

  StopVisual;
}

HandleEvent
cmInit:abort;
cmPick:{
  if (UserFilterList.Pick(CurField))
    RedrawPanel(CurTable);
}
cmDelOnProtect:{
  if (UserFilterList.Del(CurField))
    RedrawPanel(CurTable);
}
end;

end.
