//******************************************************************************
// Возвращает наименование ведомости удержаний по коду вида удержаний
//******************************************************************************
function GetNMnem(wVidUd: word): string;
{
  var s1, s2: string='';
  s2 := ' (пр. №' + TitleDoc.DocNmb + ')';
  vKlVidUd._wVidUd := wVidUd;
  if vKlVidUd.getfirst klvidud = tsOk
    s1 := vKlVidUd.klvidud.nvidud;
  else
    s1 := 'Межрасчетное удержание';
  result := substr(s1, 1, 39 - length(s2)) + s2;
}

//******************************************************************************
// Процедура удаления своих записей, привязанных у удаляемому приказу
//******************************************************************************
Procedure MyDel;
{
  _loop RaiseHist
  {
    if funIsOrderConfirm and isValidAll(tnSposobOplaty)
      _Loop GP_RaiseHistExt108
      {
        if locase(trim(SposobOplaty.Name)) = 'удержание из зарплаты'
        {
          var _params: TGP_SetPrVidOplRK_Params;
          _params.cPers   := persons.nrec;
          _params.cApp    := appointments.nrec;
          _params.wTable  := 116; //coGP_RaiseHistExt108;
          _params.cRec    := RaiseHist.Nrec; //GP_RaiseHistExt108.nrec;
          _params.wVidUd  := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_108.VIDUD');
          if (_params.wVidUd = 0) _params.wVidUd := 5;
          _params.wVidOpl := 7;
          _params.dBeg    := RaiseHist.dRec;
          _params.dEnd    := RaiseHist.dDat2;
          _params.dSum    := GP_RaiseHistExt108.UdCost;
          _params.wChoice := 1;
          _params.cContDoc:= contdoc.nrec;
          _params.nMnem   := GetNMnem(_params.wVidUd);
          _setZarSignal.DelRR(_params);
        }
      }
    delete all from GP_RAISEHISTEXT108 where ((RaiseHist.Nrec == GP_RaiseHistExt108.cRaiseH));
  }
  inherited::MyDel;
  //if TitleDoc.wStatus<>0
  if funIsOrderConfirm
    SRR.DelRaiseMsg(Raise.NRec, Raise.Person, Raise.Appoint);
}

//******************************************************************************
// Устанавливает связь между приказом и его содержимым
//******************************************************************************
procedure IRPD_Base.SetRelation(Value: comp);
{ Inherited::SetRelation(Value);
  if (not funIsOrderConfirm) and (not isValid(#ContDoc))
  and isValid(#PartDoc)
  and PartDoc.wAttr1=0
  and PartDoc.wAttr2=0
  { update current PartDoc set PartDoc.wAttr1:=MonthRas,PartDoc.wAttr2:=YearRas;
    ReScanPanel(#PartDoc);
  }
} //procedure IRPD_Base_Raise.SetRelation(Value: comp);

//******************************************************************************
// Функция проверки корректности заполнения индивидуального приказа
//******************************************************************************
function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
var _year:word;
    _cChild:comp;
    _Nrec:comp ;
{ Result:=Inherited::ChildCheckOneOrder(cNrec);
  if not Result then exit;
  Timelog('RPD_108->ChildCheckOneOrder');

// По детям необходим контроль на источник компенсации
// (соц.защита компенсирует путевку ребенку только 1 раз в год)
  _Loop GP_RaiseHistExt108
  { if GP_RaiseHistExt108.CCHILD=0 then continue;
    if GP_RaiseHistExt108.SumComp=0 then continue;
    Timelog('  Persons.Fio='+Persons.Fio);
    delete all tmp_check108;
    Timelog('  children.RFIO='+children.RFIO);
    _year:=Year(GP_RaiseHistExt108.DatZBeg);
    _Nrec:=GP_RaiseHistExt108.Nrec;
    _cChild:=GP_RaiseHistExt108.CCHILD;
    _try
    { SQL select
         TitleDoc.DocDate
        ,TitleDoc.DocNMB
        ,GP_RaiseHistExt108.DatZBeg
      From GP_RaiseHistExt108
      inner join RaiseHist on RaiseHist.Nrec = GP_RaiseHistExt108.CRAISEH
      inner join ContDoc   on ContDoc.Nrec = RaiseHist.cContDoc
      inner join PartDoc   on PartDoc.Nrec = ContDoc.cPart
      inner join TitleDoc  on TitleDoc.Nrec= PartDoc.cDoc
      //   AND TitleDoc.DOCYEAR =:(TitleDoc.DOCYEAR)
      where GP_RaiseHistExt108.CCHILD = :(_CCHILD)
      and GP_RaiseHistExt108.Nrec<>:(_Nrec)
      and Year(DateTime(GP_RaiseHistExt108.DatZBeg,0)) =:(_year)
      and GP_RaiseHistExt108.SumComp>0

      into tmp_check108;
    }
    _Except
    else
    { timelog('Возникло исключение при запуске запроса 001 '+ExploreException);
    }
    _finally
    {

    }
    _Loop tmp_check108
    { Result:=false;
      SetErrorOrder('на родственника '+Children.RFio
        +' есть приказ № "'+tmp_check108.Docnmb+DateToStr(tmp_check108.DocDate,'" от DD/MM/YYYY')+' за '+string(_year)+' г.');
    }
  } //_Loop GP_RaiseHistExt108
} //function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;


//******************************************************************************
//  Процедура утверждения приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
var Marker_Tmp:longint;
    ii:longint;
    _pnrec:comp;
{
  Marker_Tmp  :=InitMarker('', 8, 50, 10, True);
  ClearMarker(Marker_Tmp);
  if cNrec <> 0
  { if GetFirst ContDoc where ((cNrec == ContDoc.NRec))=tsok {};
    cNrec:=0;
  }
  _loop fullcache RaiseHist
  {
    if isValidAll(#GP_RaiseHistExt108)
    { var _params: TGP_SetPrVidOplRK_Params;
      _params.cPers   := persons.nrec;
      _params.cApp    := appointments.nrec;
      _params.wTable  := 116; //coGP_RaiseHistExt108;
      _params.cRec    := RaiseHist.Nrec; //GP_RaiseHistExt108.nrec;
      _params.wVidUd  := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_108.VIDUD');
      if (_params.wVidUd = 0) _params.wVidUd := 5;
      _params.wVidOpl := 7;
      _params.dBeg    := RaiseHist.dRec;
      _params.dEnd    := RaiseHist.dDat2;
      _params.dSum    := 0;
      _params.wChoice := 1;
      _params.cContDoc:= contdoc.nrec;
      _params.nMnem   := GetNMnem(_params.wVidUd);
      _Loop GP_RaiseHistExt108
       if isValidAll(tnSposobOplaty)
        if locase(trim(SposobOplaty.Name)) = 'удержание из зарплаты'
        { _params.dSum    :=_params.dSum+ GP_RaiseHistExt108.UdCost;
        }
      if _params.dSum>0
        _setZarSignal.SetRR(_params);
    } //if isValidAll(#GP_RaiseHistExt108)
    //-----------------
    // Уберем вообще доплату
    //-----------------
    InsertMarker(Marker_Tmp,RaiseHist.Nrec);
    update current RaiseHist set RaiseHist.cContDoc:=0;
  } //_loop fullcache RaiseHist
  //***************************************
  result := inherited::ChildConfirmOneOrder(cNrec);
  //***************************************
  //убираем лишние записи из корзины
  //--------------------------
  //1
  /*
    delete DelZarSignal where (( word(1)    == DelZarSignal.SubSysCode and
                                 word(16)   == DelZarSignal.SrcTable   and
                                 Raise.NRec == DelZarSignal.SrcRec and (ZarSignal.MsgCode = 9) ));
  */
  //--------------------------
  //2  SRR.DelRaiseMsg(Raise.NRec, Raise.Person, Raise.Appoint);
  //3
  //--------------------------
  for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
  { if GetMarker(Marker_Tmp,ii,_pNrec)
    { if getfirst RaiseHist where (( _pNrec == RaiseHist.Nrec ))=tsok
        update current RaiseHist set RaiseHist.cContDoc:=ContDoc.Nrec;
    }
  }//for(ii:=0;ii<GetMarkerCount(Marker_Tmp);ii++)
}//function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  var sTitle:string;
  inherited::EnableDisable;

  cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
  cfsGetProp('WHATISINORDER',cfpTitle, sTitle);
  cfsSetProp('WHATISINORDER',cfpTitle, replace(sTitle,'Приказ','Список'));
  cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер списка');
  cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата списка');
  //Закроем сумму доплаты, чтобы пользователь ее не испортил
  ToggleFieldSelectable(#RaiseHist.rHSum, false);
  //ToggleFieldSelectable(#GP_RAISEHISTEXT108.SUMPRED, false);
  //-----------------------
  ToggleFieldSelectable(#GP_RaiseHistExt108.DateVyd , fnFieldsOpen);
  ToggleFieldSelectable(#GP_RaiseHistExt108.DatZBeg , fnFieldsOpen);
  ToggleFieldSelectable(#GP_RaiseHistExt108.DatZEnd , fnFieldsOpen);
  ToggleFieldSelectable(#GP_RaiseHistExt108.KolMest , fnFieldsOpen);
  ToggleFieldSelectable(#GP_RaiseHistExt108.FullCost, fnFieldsOpen);
  ToggleFieldSelectable(#GP_RaiseHistExt108.UdCost  , fnFieldsOpen);
  ToggleFieldSelectable(#UdCostPercent              , fnFieldsOpen);
    //ToggleFieldSelectable(#GP_RaiseHistExt108.SumPred, true);
  ToggleFieldSelectable(#SanUch.name                , fnFieldsOpen);
  ToggleFieldSelectable(#VidPutevki.name            , fnFieldsOpen);
  ToggleFieldSelectable(#IstComp.name               , fnFieldsOpen);
  ToggleFieldSelectable(#SposobOplaty.name          , fnFieldsOpen);
  ToggleFieldSelectable(#children.RFIO              , fnFieldsOpen);
  //------------ PartDoc
  ToggleFieldSelectable(#SanUch_M.name              , fnFieldsOpen);
  ToggleFieldSelectable(#IstComp_M.name             , fnFieldsOpen);
  ToggleFieldSelectable(#SposobOplaty_M.name        , fnFieldsOpen);
  ToggleFieldSelectable(#PartDoc.DDat1              , fnFieldsOpen);
  ToggleFieldSelectable(#PartDoc.DDat2              , fnFieldsOpen);
  ToggleFieldSelectable(#PartDoc.LastDate           , fnFieldsOpen);
  ToggleFieldSelectable(#PartDoc.wAttr1             , fnFieldsOpen);
  ToggleFieldSelectable(#PartDoc.wAttr2             , fnFieldsOpen);

  if fnFieldsOpen // не утвержден
  {
    SetHelpAndStatusContext(brwRaise108, -1, sci178Esc, 'StaffWinPr');
  }
  else //утвержден
  { SetHelpAndStatusContext(brwRaise108, -1, sci1Esc, 'StaffWinPr');
  }
} //Procedure EnableDisable;

//Проверяет на валидность данные в записи RaiseHist
function RaiseHistIsValid: boolean;
{
  result := RaiseHist.dRec > 0 and
            RaiseHist.dDat2 > 0 and
            GP_RaiseHistExt108.cSposOpl != 0 and
            GP_RaiseHistExt108.cIstComp != 0 and
            GP_RaiseHistExt108.FullCost > 0;
}

//Возвращает текст сообщения пользователю с детализацией о невалидности записи RaiseHist
function GetNotValidRaiseHistUserInfo: string;
{
  var EmptyRequiredFields: string = ''; //незаполненные обязательные поля

  if RaiseHist.dRec = 0
    EmptyRequiredFields += 'С даты';

  if RaiseHist.dDat2 = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'По дату';

  if GP_RaiseHistExt108.cSposOpl = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'Способ оплаты';

  if GP_RaiseHistExt108.cIstComp = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'Источник компенсации';

  if GP_RaiseHistExt108.FullCost <= 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'Стоимость путевки';

  result := if(EmptyRequiredFields = '', '',
               ''#3'Не заполнены обязательные поля: '#13 + EmptyRequiredFields);
}

//*************************************
// Заполнить буфер GP_RaiseHistExt108
//*************************************
Procedure MakeBuffer_GP_RaiseHistExt108;
{   clearbuffer(#GP_RaiseHistExt108);
    GP_RaiseHistExt108.Nrec := GetNextNrec(tnGP_RaiseHistExt108, 0);
    GP_RaiseHistExt108.KolMest :=1;
    GP_RaiseHistExt108.cRaiseH := RaiseHist.Nrec;
    GP_RaiseHistExt108.DateVyd := PartDoc.LastDate;
    GP_RaiseHistExt108.DatZBeg := PartDoc.DDat1;
    GP_RaiseHistExt108.DatZEnd := PartDoc.DDat2;
    GP_RaiseHistExt108.cSposOpl:= PartDoc.cRef1;
    GP_RaiseHistExt108.cIstComp:= PartDoc.cCat;
    set GP_RaiseHistExt108.cSanUch := PartDoc.cPref;
}

//******************************************************************************
// Печать приказа
//******************************************************************************

procedure PrintRPD(typePrint: TPtr; fcEnter: word);
{
  #__UNUSED__(typePrint,fcEnter)
  ReScanPanel(#Contdoc);
  var RaiseStr: array[0..8] of string;
  var Kol: integer; //для подсчета количества итераций
  case typePrint of
    0:
    {
      RunInterface('GP_NFormRD108', TitleDoc.Nrec, PartDoc.TypeOper);
    }
  end;
} //procedure PrintRPD(typePrint: TPtr; fcEnter: word);

//Пересчитывает расчетные поля с суммами, обновляет панель
procedure OnSumFieldChanged;
{ timelog('RPD_108->OnSumFieldChanged:START');
  var _UdCost:double=GP_RaiseHistExt108.UdCost;
  var _UdSum :double=0;
  var _WATTRDOC3:word=0;// 'мест'
  var _WATTRDOC4:word=0;// 'детей'
  var _CNEW7    :double=0;//'Полная стоимость путевки'
  timelog('RPD_108->OnSumFieldChanged:001');
  var _fSumma:double=0;
  _fSumma:=GP_RAISEHISTEXT108.FULLCOST - (GP_RAISEHISTEXT108.SUMCOMP+ GP_RAISEHISTEXT108.UDCOST);
  set Raise.Sum                  := _fSumma;
  set RaiseHist.rHSum            := _fSumma;
  set GP_RAISEHISTEXT108.SUMPRED := _fSumma;
  timelog('RPD_108->OnSumFieldChanged:002');
  //------------------ для накопления
  set _UdSum    :=Raise.Sum;
  set _UdCost   :=GP_RaiseHistExt108.UdCost;
  set _WATTRDOC3:=GP_RaiseHistExt108.KolMest;
  set _WATTRDOC4:=GP_RaiseHistExt108.KolDet;
  set _Cnew7    :=GP_RaiseHistExt108.FullCost;
  var _Raise_Sum      :double=Raise.Sum;
  var _RaiseHist_rHSum:double=RaiseHist.rHSum;
  timelog('RPD_108->OnSumFieldChanged:003');
  _Loop fullcache RaiseHistCheck  //where (( ContDoc.nRec  == RaiseHistCheck.cContDoc ))
  { timelog('RPD_108->OnSumFieldChanged:_Loop RaiseHistCheck, Nrec='+string(RaiseHistCheck.Nrec,0,0));
    _Loop fullcache GP_RH_EXT108_Scan //where (( RaiseHistCheck.nrec  == GP_RH_EXT108_Scan.cRaiseH ))
    { timelog('RPD_108->OnSumFieldChanged:_Loop GP_RH_EXT108_Scan, Nrec='+string(GP_RH_EXT108_Scan.Nrec,0,0));
      if GP_RaiseHistExt108.Nrec=GP_RH_EXT108_Scan.Nrec continue;
      _fSumma:=GP_RH_EXT108_Scan.FULLCOST - GP_RH_EXT108_Scan.SUMCOMP - GP_RH_EXT108_Scan.UDCOST;
      if RaiseHistCheck.Nrec=RaiseHist.Nrec
      { _Raise_Sum        += _fSumma;
        _RaiseHist_rHSum  += _fSumma;
      }
      _UdSum    +=_fSumma;
      _UdCost   +=GP_RH_EXT108_Scan.UdCost;
      _WATTRDOC3+=GP_RH_EXT108_Scan.KolMest;
      _WATTRDOC4+=GP_RH_EXT108_Scan.KolDet;
      _Cnew7    +=GP_RH_EXT108_Scan.FullCost;
    } //_Loop fullcache GP_RH_EXT108_Scan
  } //_Loop fullcache RaiseHistCheck
  Raise.Sum      := _Raise_Sum;
  RaiseHist.rHSum:= _RaiseHist_rHSum;
  timelog('RPD_108->OnSumFieldChanged:004');
  update current RaiseHist;
  update current Raise;
  timelog('RPD_108->OnSumFieldChanged:005');
  var _str:string='';
  _str:=String(_UdSum,0,2)+';'+string(_UdCost,0,2);
  timelog('RPD_108->OnSumFieldChanged:_str='+_str
     +',взрослых _WATTRDOC3='+string(_WATTRDOC3)
     +',детей _WATTRDOC4='+string(_WATTRDOC4)
     +',Стоим.путевки _CNEW7='+string(_CNEW7)
     );
  if ContDoc.LASTUSER<>_str
  or ContDoc.WATTRDOC3<>_WATTRDOC3// 'взрослых'
  or ContDoc.WATTRDOC4<>_WATTRDOC4// 'детей'
  or ContDoc.CNEW7    <>comp(_Cnew7)// 'Стоим.путевки'
  { ContDoc.LASTUSER:=_str;
    ContDoc.WATTRDOC3:=_WATTRDOC3;// 'мест'
    ContDoc.WATTRDOC4:=_WATTRDOC4;// 'детей'
    ContDoc.CNEW7    :=comp(_Cnew7);// 'Стоим.путевки'

    Update Current ContDoc;
  }
  timelog('RPD_108->OnSumFieldChanged:006');
  //SetModified(True);
  ReDrawPanel(#ContDoc);
  ReDrawPanel(#RaiseHist);
  timelog('RPD_108->OnSumFieldChanged:Finish');
} //procedure OnSumFieldChanged;


//******************************
TableEvent table GP_RaiseHistExt108;
  cmSetDefault:
  { MakeBuffer_GP_RaiseHistExt108
  }
  cmInsertRecord:
  { insert current GP_RaiseHistExt108;
  }
  cmUpdateRecord:
  { Timelog('RPD_108->GP_RaiseHistExt108->cmUpdateRecord Start');
    update current GP_RaiseHistExt108;
    Timelog('RPD_108->GP_RaiseHistExt108->cmUpdateRecord finish');

  }
  cmDeleteRecord:
  { if message('Удалить информацию о путевке?',YesNo)=cmYes
      delete current GP_RaiseHistExt108;
  }
  cmCheckRecord:
  { Timelog('RPD_108->GP_RaiseHistExt108->cmCheckRecord Start');
    if inherited::handleevent(cmCheckRecord) = heAbort
      Abort
    else
    {
      if not RaiseHistIsValid
      {
        Message(GetNotValidRaiseHistUserInfo, Error);
        Abort;
      }
    }
    Timelog('RPD_108->GP_RaiseHistExt108->cmCheckRecord Finish');
  }
end;
//******************************
TableEvent table RaiseHist;
  cmSetDefault:
  {
    //message('Докомпилировали обработчик');
    inherited::HandleEvent(cmSetDefault);
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD108');
    if (ParentSav <> 0)
    {
      RaiseHist.cRaiseType := ParentSav;
      RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
      Raise.RaiseAttr := RaiseHist.iHAttr;
      Raise.RaiseType := ParentSav;
    }
    RaiseHist.Nrec := GetNextNrec(tnRaiseHist, 0);
    if PartDoc.wAttr1>0 and PartDoc.wAttr2>2000
    { RAISEHIST.DREC:=date(1,PartDoc.wAttr1,PartDoc.wAttr2);
      RAISEHIST.DDAT2:=date(Last_Day(RAISEHIST.DREC),PartDoc.wAttr1,PartDoc.wAttr2);
    }
    MakeBuffer_GP_RaiseHistExt108;
    SetModified(true);
  }
  cmInsertRecord:
  {
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      GP_RaiseHistExt108.cRaiseH := RaiseHist.nrec;
      insert current GP_RaiseHistExt108;
    }
  }
  cmUpdateRecord:
  {
    if inherited::handleevent(cmUpdateRecord) = heOk
    {
      if isValidAll(#GP_RaiseHistExt108)
        update current GP_RaiseHistExt108;
    }
  }
  cmDeleteRecord:
  {
    //if isValidAll(#GP_RaiseHistExt108)
    //  delete current GP_RaiseHistExt108;
    delete all from GP_RAISEHISTEXT108 where ((RaiseHist.Nrec == GP_RaiseHistExt108.cRaiseH));

    inherited::handleevent(cmDeleteRecord);
  }
end;


//******************************
TableEvent table PartDoc;
 cmUpdateRecord:
 {
   update current PartDoc;
 }
end;//TableEvent table PartDoc;

//******************************
TableEvent table ContDoc;
  cmInsertRecord:
  {
    //При добавлении нового сотрудника в приказ вызываем выбор вида доплаты/надбавки
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      if SelectFormat(brwRaise108)
      {
        SelectField(#RaiseCat.Name);
        PutCommand(cmPick);
      }
    }
  }
end;


//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    cmOnVipLoad:
    { //====================================
      timelog_init;
      Timelog('RPD_108->cmOnVipLoad');
      cPolisOMS := ExtAttr_Id(coPsnLinks,'Полис ОМС ребенка (члена семьи)');
      if cPolisOMS = 0
        cPolisOMS := ExtAttr_Create(coPsnLinks,'Полис ОМС ребенка (члена семьи)', cgAttrType_Str);

      //Полис ОМС ребенка (члена семьи)
      cPolisOMS := ExtAttr_Id(coPsnLinks,'Полис ОМС ребенка (члена семьи)');
      if cPolisOMS = 0
          cPolisOMS := ExtAttr_Create(coPsnLinks,'Полис ОМС ребенка (члена семьи)', cgAttrType_Str);

      //Адрес временного места пребывания ребенка (члена семьи)
      cAddrTemp := ExtAttr_ID(coPsnLinks,'Адрес временного места пребывания ребенка (члена семьи)');
      if cAddrTemp = 0
          cAddrTemp := ExtAttr_Create(coPsnLinks,'Адрес временного места пребывания ребенка (члена семьи)', cgAttrType_Str);

      //Постоянное место проживания родственника
      cAddrBase := ExtAttr_Id(coPsnLinks,'Постоянное место проживания родственника');
      if cAddrBase = 0
          cAddrBase := ExtAttr_Create(coPsnLinks,'Постоянное место проживания родственника', cgAttrType_Str);


      //Адрес школы (дет.сад) ребенка
      cAddrSch := ExtAttr_Id(coPsnLinks,'Адрес школы (дет.сад) ребенка');
      if cAddrSch = 0
          cAddrSch := ExtAttr_Create(coPsnLinks,'Адрес школы (дет.сад) ребенка', cgAttrType_Str);

      //Телефон
      cTel := ExtAttr_Id(coPsnLinks,'Контактный телефон родственника');
      if cTel = 0
          cTel := ExtAttr_Create(coPsnLinks,'Контактный телефон родственника', cgAttrType_Str);

      inherited::HandleEvent(cmOnVipLoad);
    } //cmOnVipLoad

    cmMulSelDO:
    {
      if UpdateTable
        UpdNeedField(CurField);
    }

    cmCheckField:
    {
      inherited::HandleEvent(cmCheckField);
      case CurField of
        #PartDoc.wAttr1,#PartDoc.wAttr2:
        { if PartDoc.wAttr1>13
          { message('Месяц не может быть больше 12');
            set PartDoc.wAttr1:=12;
          }
          if PartDoc.wAttr2>0 and PartDoc.wAttr2<YearRas
          { message('Год не может быть меньше '+string(YearRas));
            PartDoc.wAttr2:=YearRas;
            set PartDoc.wAttr1:=12;
          }
          if PartDoc.wAttr1>0 and PartDoc.wAttr2=YearRas
          and PartDoc.wAttr1<MonthRas
          { message('Месяц в году расчета не может быть больше '+string(MonthRas));
            set PartDoc.wAttr1:=MonthRas;
          }
          if PartDoc.wAttr1<>0  and PartDoc.wAttr2>2000
          { var _wDt:date=Date(1,PartDoc.wAttr1,PartDoc.wAttr2);
            if isValid(#ContDoc)
            if message('Установить во всем РПД период выплаты '+DateToStr(_wDt,'MM/YYYY?'),YesNo)=cmYes
            { PushPos(#ContDoc);
              _Loop fullcache Contdoc
              { _Loop fullcache RaiseHist
                { update current RaiseHist set RAISEHIST.DREC:=date(1,PartDoc.wAttr1,PartDoc.wAttr2)
                      ,RAISEHIST.DDAT2:=date(Last_Day(_wDt),PartDoc.wAttr1,PartDoc.wAttr2);
                }
              }
              PopPos(#ContDoc);
              ReScanPanel(#ContDoc);
            } //if message('Установить во всем приказе период '+DateToStr(_wDt,'MM/YYYY?'),YesNo)
          }  //if PartDoc.wAttr1<>0  and PartDoc.wAttr2>2000
        } //#PartDoc.wAttr1,#PartDoc.wAttr2:
        #GP_RaiseHistExt108.DateVyd,
        #SanUch.name,
        #VidPutevki.name,
        #GP_RaiseHistExt108.NumPut,
        #GP_RaiseHistExt108.DatZBeg,
        #GP_RaiseHistExt108.DatZEnd,
        #GP_RaiseHistExt108.KolMest,
        #GP_RaiseHistExt108.KolDet,
        #GP_RaiseHistExt108.DateOtrT,
        #GP_RaiseHistExt108.DateSpVozm
        //#children.RFIO
        :
        { SetModified(True);
          //UpdateTable;
          OnSumFieldChanged;
        }
        #GP_RAISEHISTEXT108.FULLCOST: OnSumFieldChanged;
        #GP_RAISEHISTEXT108.SUMCOMP:  OnSumFieldChanged;
        #GP_RAISEHISTEXT108.UDCOST:   OnSumFieldChanged;
      end;
    }

    cmExprFieldChanged:
    { Timelog('RPD_108->cmExprFieldChanged');

      case curfield of
        #UdCostPercent:
        {
          if GP_RaiseHistExt108.FullCost = 0
            Set GP_RaiseHistExt108.FullCost := 100;
          Set GP_RaiseHistExt108.UdCost := GP_RaiseHistExt108.FullCost * double(replace(ExprFieldValue,',','.')) / 100;
          OnSumFieldChanged;
        }
        #SumCompPercent:
        { Timelog('RPD_108->cmExprFieldChanged>#SumCompPercent Start');

          if GP_RaiseHistExt108.FullCost = 0
            Set GP_RaiseHistExt108.FullCost := 100;
          //------------------------
          var _fProc:double=double(replace(ExprFieldValue,',','.'));
          //#224.#30.1 Суммы Размера компенсации (ФСС,ПФ): = (Полная стоимость путевки - Стоимость для работника) * <Процент Размер компенсации (ФСС,ПФ)>
          Set GP_RaiseHistExt108.SumComp := Round((GP_RaiseHistExt108.FullCost-GP_RAISEHISTEXT108.UDCOST) * _fProc / 100,2);
          Timelog('RPD_108->cmExprFieldChanged>#SumCompPercent Finish');
        }
      end;
    }

    cmPick:
    {
      case CurField of
        #RaiseCat.Name:
        {
          ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD108');
          var ParentSav1:comp=0;
          var wPickResult: word = cmCancel;
          if ParentSav>0
          { if GetFirst FastFirstRow Catalogs where ((ParentSav == Catalogs.cParent)) = tsOk
            { ParentSav1:=Catalogs.Nrec;
              if GetNext FastFirstRow Catalogs where ((ParentSav == Catalogs.cParent)) = tsOk
              { wPickResult := RunInterface(Z_STAFFCAT::PickCatalog2, 0, ParentSav, 0, 0);
              }
              else
              { ParentSav:=ParentSav1;
                wPickResult :=cmDefault;
              }
            }
            else
            { wPickResult :=cmDefault;
            }
          }
          else
          { wPickResult := RunInterface(GP_STAFF::GP_PickCatalogWithOneRec, -17, ParentSav);

          }
          if (wPickResult = cmDefault)
          {
            //PreviousType := RaiseHist.cRaiseType; // взвести флаг того, что поменяли наименование
            set RaiseHist.cRaiseType := ParentSav;
            set RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
            set Raise.RaiseAttr := RaiseHist.iHAttr;
            set Raise.RaiseType := ParentSav;
            ReReadRecord(tnCatalogs);
          }

          exit;
        } //RaiseCat.Name
      end;
      inherited::HandleEvent(cmPick);
      case CurField of
        #persons.fio:
        {

          if isvalidall(#Persons)
          {
            //Запрещаем пользователю выбирать умерших сотрудников
            if (Persons.ddop1 != 0)
            {
              message('Запрещено выбирать сотрудников с заполненным полем "Дата смерти"', error);
              PutCommand(cmDelOnProtect);
            }
            else
            {
              //Если пользователь выбрал корректного сотрудника и это новая позиция -
              //сразу вызываем вставку этой записи, чтобы далее вызвать добавление вида доплаты/надбавки
              if(isNew) UpdateTable();
              SelectFieldInFormat(brwRaise108, #RaiseCat.Name);
            }
          }
        }
        #SposobOplaty.name:{
          //
          if (RunInterface(Z_StaffCat::PickCatalog2, 4001, GP_RaiseHistExt108.cSposOpl, 0) = cmDefault)
            SetModified(True);
          ReReadRecord(tnCatalogs);
        }
        #SposobOplaty_M.name:{
          var cTmp:comp=PartDoc.cRef1;
          if (RunInterface(Z_StaffCat::PickCatalog2, 4001, cTmp, 0) = cmDefault)
          { set PartDoc.cRef1:=cTmp;
          }
          ReReadRecord(tnCatalogs);
        }
        #SanUch.name:{
          //
          if (RunInterface(Z_StaffCat::PickCatalog2, 4003, GP_RaiseHistExt108.cSanUch, 0) = cmDefault)
            SetModified(True);
          ReReadRecord(tnCatalogs);
        }
        #SanUch_M.name:{
          //
          var cTmp:comp=PartDoc.CPREF;
          if (RunInterface(Z_StaffCat::PickCatalog2, 4003, cTmp, 0) <> cmCancel)
          { set PartDoc.CPREF:=cTmp;
            SetModified(True);
          }
        }
        #IstComp.name:{
          //
          if (RunInterface(Z_StaffCat::PickCatalog2, 4002, GP_RaiseHistExt108.cIstComp, 0) = cmDefault)
            SetModified(True);
          ReReadRecord(tnCatalogs);
        }
        #IstComp_M.name:{
          var cTmp:comp=PartDoc.cCat;
          if (RunInterface(Z_StaffCat::PickCatalog2, 4002, cTmp, 0) = cmDefault)
          { set PartDoc.cCat:=cTmp;
          }
        }
        #VidPutevki.name:{
          //
          if (RunInterface(Z_StaffCat::PickCatalog2, 4004, GP_RaiseHistExt108.cVidPut, 0) = cmDefault)
            SetModified(True);
          ReReadRecord(tnCatalogs);
        }
        #Children.RFIO:{
          var cTmp:comp=GP_RaiseHistExt108.cChild;
          if (RunInterface(GP_Staff::GP_PickRelatives, Persons.nrec, cTmp,'') = cmDefault)
          { set GP_RaiseHistExt108.cChild:=cTmp;
            if isValid(#Children)
            { var _sCode:string='';
              if getfirst Catalogs where (( Children.LinkType == Catalogs.Nrec )) =tsok
              { _sCode:=Catalogs.code;
                if _sCode<>'ДЕТИ'
                cTmp:=Catalogs.cParent;
                if getfirst Catalogs where (( cTmp == Catalogs.Nrec )) =tsok
                  _sCode:=Catalogs.code;
              }
              if _sCode='ДЕТИ'
              { set GP_RaiseHistExt108.KolMest:=0;
                set GP_RaiseHistExt108.KolDet :=1;
              }
            }
            SetModified(True);
          }
          RescanPanel(tnGP_RaiseHistExt108);
        }
      end;
    }

    cmDelOnProtect:
    {
      case CurField of
        #Children.RFIO:
        {
          GP_RaiseHistExt108.cChild := 0;
          SetModified(True);
          RescanPanel(tnGP_RaiseHistExt108);
        }
      else
        inherited::handleevent(cmDelOnProtect);
      end;
    }

    cmOnVipUnload:{
      Timelog_init;
      Timelog('RPD_108->cmOnVipUnload');
      inherited::Handleevent(cmOnVipUnload);
      cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
      cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер приказа');
      cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата приказа');

    }

  end;

End.
