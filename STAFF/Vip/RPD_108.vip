//****************************************************8
Interface RPD_108 '' escclose;
//****************************************************8
Table Struct tmp_check108
(  DocDate :date
  ,DocNmb  :string[100]
  ,DatZBeg :date
)
with index
( tmp_check108 = DocDate + DocNmb
);
var
  _setZarSignal: GP_SetPrVidOplRK;  //формирование записей в рабочей корзине
  cPolisOMS
, cAddrTemp
, cAddrBase
, cAddrSch
, cTel
, cBornSvid
, cCatChild     : comp;

create view
as select
  if(GP_RaiseHistExt108.FullCost > 0,
          round(GP_RaiseHistExt108.UdCost / GP_RaiseHistExt108.FullCost * 100, 2), 0)
          (fieldname=UdCostPercent ,  fieldtitle='Процент удержания')

, if(GP_RaiseHistExt108.FullCost-GP_RAISEHISTEXT108.UDCOST > 0,
       round(GP_RaiseHistExt108.SumComp / (GP_RaiseHistExt108.FullCost-GP_RAISEHISTEXT108.UDCOST) * 100, 2), 0)
          (fieldname=SumCompPercent ,  fieldtitle='Процент компенсации ФСС')
, tmp_check108.*
, GP_RH_EXT108_Scan.cRaiseH
from
     GP_RaiseHistExt108
   , GP_RAISEHISTEXT108 GP_RH_EXT108_Scan
   , Catalogs SposobOplaty
   , Catalogs SposobOplaty_M
   , Catalogs VidPutevki
   , Catalogs SanUch
   , Catalogs SanUch_M
   , Catalogs IstComp
   , Catalogs IstComp_M
   , PSNLinks Children
   , tmp_check108
where
   ((
    RaiseHist.nrec              == GP_RaiseHistExt108.cRaiseH
// RPD_BASE_RAISE >>>>>>>>>>>>>>>>>>>>
//and ContDoc.nRec                == RaiseHistCheck.cContDoc
// RPD_BASE_RAISE <<<<<<<<<<<<<<<<<<<
and RaiseHistCheck.nrec         == GP_RH_EXT108_Scan.cRaiseH
//and (GP_RaiseHistExt108.Nrec<>GP_RH_EXT108_Scan.Nrec)
//-------------------------------------
and GP_RaiseHistExt108.cSposOpl == SposobOplaty.nrec
and GP_RaiseHistExt108.cIstComp == IstComp.nrec
and GP_RaiseHistExt108.cSanUch  == SanUch.nrec
and GP_RaiseHistExt108.cVidPut  == VidPutevki.nrec
and GP_RaiseHistExt108.cChild   == Children.nrec
//-------------------------------------
and PartDoc.CREF1               == SposobOplaty_M.nrec
//and PartDoc.CREF2               == IstComp_M.nrec
and PartDoc.CCAT               == IstComp_M.nrec
and PartDoc.CPREF               == SanUch_M.nrec
//-------------------------------------
//and Raise.RaiseType  == RaiseCat.nrec

));

create view vKlVidUd
var
  _wVidUd: word;
from klvidud
where ((
  _wVidUd == klvidud.vidud
))
;


