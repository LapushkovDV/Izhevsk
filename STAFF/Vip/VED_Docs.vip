const
coZagranPassportSysCode = 503 ; // Загранпаспорт гражданина РФ
coVisaSysCode           = 1591; // Виза
coWorkTownPhonename = 'Рабочий городской'  ;
end;

#doc
EM::VED_Docs_Zagran
Ведение документов сотрудников для заграницы (Виза и Загранпаспорт гражданина РФ)
#end
const
 coAttrVisa_Visadays   = 'Количество дней';
 coAttrVisa_VisaNumber = 'Номер';
end;
//************************************************************
Interface VED_Docs_Zagran 'ВЭД. Ведение документов сотрудников' (,,sci17EnEsc), EscClose;
//************************************************************
Show At (,,120,30)
//----------------------------------------

Create View
 select
           Pers.Nrec         (fieldname = cPers)
         , Pers.StrTabN      (fieldname = StrTabN)
         , Pers.FIO          (fieldname = Fio)
         , Pers.DisDate      (fieldname = DisDate)
         , if(length(KP.code) = 3, KP.code, KpParent.code) (fieldname = Department)
         , if(length(KP.code) = 3 , ''    , KP.code)  (fieldname = Unit)
         , if(length(KP.code) = 3, KP.Name, KpParent.Name) (fieldname = Departmentname)
         , if(length(KP.code) = 3 , ''    , KP.name)  (fieldname = UnitName)

         , post.Name (fieldname = PostPers)
         , Passports.SER       (FieldName = DocSeriya)
         , Passports.NMB       (FieldName = DocNMB)
         , Passports.GIVENBY   (FieldName = DocGivenBy)
         , Passports.GIVENDATE (FieldName = DocGivenDate)
//         , Passports.GIVENPODR (FieldName = DocNGivenPodr)
         , Passports.TODATE    (FieldName = DocToDate)
         , DocNames.name        (FieldName = DocName)
         , sgetattr(coVisaDrv,VisaDrv.nrec,coAttrVisa_Visadays   ) (FieldName = _Visadays   )
         , sgetattr(coVisaDrv,VisaDrv.nrec,coAttrVisa_VisaNumber ) (FieldName = _VisaNumber )
     from  PERSONS pers
     , Catalogs KP
     , Catalogs KPParent
     , appointments app
     , Catalogs Post
     , Passports
     , catalogs DocNames
     , catalogs PassportsSelect
     , Catalogs CatalogsVidDocs
     , VisaDrv
     , KATSTATE
     , attrval
where ((               root == pers.nrec
        and pers.Department == kp.nrec
        and      kp.cparent == KPParent.nrec
        and Pers.appointCur == app.nrec
        and        app.post == post.nrec
        and       pers.nrec == Passports.PERSON
        and ( Passports.syscode = coZagranPassportSysCode  // Загранпаспорт гражданина РФ
//           or Passports.syscode = coVisaSysCode // Виза
         )
        AND Passports.NREC  == VisaDrv.CPASSPORTS
        and VisaDrv.CSTATE  == KATSTATE.nrec
        and Passports.DOCNAME == DocNames.nrec
        and          1        == Appendix.ObjBlock
        and        pers.Nrec  == Appendix.Person
        and             200   == Appendix.ObjType

        //  для выбора документов
        and                   -3 == CatalogsVidDocs.syscode // шапка видов документов
        and CatalogsVidDocs.nrec == PassportsSelect.mainlink (noindex)
       and ( PassportsSelect.syscode = coZagranPassportSysCode  // Загранпаспорт гражданина РФ
//          or PassportsSelect.syscode = coVisaSysCode // Виза
           )

        ))
and Pers.IsEmployee = 'С'
and isvalid(tnKp)
and (KP.code <> '' or KpParent.code<> '')
and (Pers.DisDate = date(0,0,0)
or Pers.DisDate >= cur_date
     )
and (
       isValidall(tnKP)
    or isValidall(tnKpParent)
    )

//and pers.fio = 'Коногорский Алексей Анатольевич'
;

#include GP_File_hRef.Vpp

Browse brVED_PersDocs 'Ведение загран. документов' (,,sci1Esc)
show at (,,70,);
Table Pers
 FIELDS
    StrTabN     'ТабН' ('ТабН')   : [3] ,Protect,NoDel;
    Fio         'ФИО' ('ФИО')   : [10] ,Protect,NoDel;
//    DisDate     'Дата','увольнения' ('Дата увольнения')   : [10] ,Protect,NoDel;
    Department  'Подр.' ('Подразделение')   : [3] ,Protect,NoDel;
    Unit        'Цех' ('Цех')   : [3] ,Protect,NoDel;
    PostPers    'Должность' ('Должность')   : [5] ,Protect,NoDel;
end;//Browse

Text Appendix.Contents: PanelLast;
  show at (71,,85, 8);
Screen scrPersInfo
show at (86,,,8);
Fields
 StrTabN       : Protect,NoDel;
 Fio           : Protect,NoDel;
 Pers.BornDate : Protect,NoDel;
 PERS.APPDATE  : Protect,NoDel;
 Department    : Protect,NoDel;
 DepartmentName: Protect,NoDel;
 Unit          : Protect,NoDel;
 UnitName      : Protect,NoDel;
 PostPers      : Protect,NoDel;
<<
 Таб. номер.@@@@@@@@
 ФИО       .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 Дата рождения        .@@@@@@@@@@
 Дата приема на работу.@@@@@@@@@@

 Подразделение.@@@@@@@.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Цех          .@@@@@@@.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 Должность    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;
Screen scrpassport
show at (71,9,,9);
<<
Заграничные паспорта
>>
end;
Browse brVED_Docs1 'Ведение загран. документов' (,,sci17Esc)
show at (71,10,,15);
Table Passports
 FIELDS
    DocName      'Документ' ('Тип Документа')              : [8] ,Protect,NoDel, PickButton;
    DocSeriya    'Серия' ('Серия документа')               : [3] ,NoProtect,NoDel, noPickButton;
    DocNMB       'Номер' ('Номер Документа')               : [6] ,NoProtect,NoDel, noPickButton;
    DocGivenDate 'Дата выдачи' ('дата выдачи документа')   : [5] ,NoProtect,NoDel, noPickButton;
    DocToDate    'Дата окончания' ('Дата окончания действия документа')   : [5] ,NoProtect,NoDel;
    DocGivenBy   'Выдан' ('Кем выдан документ')            : [10] ,NoProtect,NoDel, noPickButton;
end;
Screen scrVisas
show at (71,16,,16);
<<
Визы к заграничному паспорту
>>
end;

Browse brVED_Docs1Visa 'Визы' (,,sci178Esc)
show at (71,17,,);
Table VisaDrv
 FIELDS
    KATSTATE.name   'Страна' ('Страна ')              : [5] ,Protect,NoDel, PickButton;
    VisaDrv.BEGDATE 'Действует с' ('Дата начала действия визы')              : [3] ,NoProtect,NoDel, NoPickButton;
    VisaDrv.ENDDATE 'Действует по' ('Дата окончания действия визы')               : [3] ,NoProtect,NoDel, NoPickButton;
    _Visadays       'Кол-во дней' ('количество дней, сколько можно находиться на территории')               : [3] ,NoProtect,NoDel, NoPickButton;
    _VisaNumber     'Номер визы' ('номер визы')               : [6] ,NoProtect,NoDel, NoPickButton;
end;

Window wbSelTypeDoc 'Выбор типа документа', doAccept;
browse brSelTypeDoc
table PassportsSelect
fields
   PassportsSelect.name 'Наименование документа' ('Наименование документа') : Protect, NoPickButton;
end;
Handleevent
cmDone:
{
 putcommand(cmDefault);
}
end;
end;
TableEvent table VisaDrv
cmCheckField:
{
  UpdateTable;
}
cmUpdateRecord:
{
  Update Current VisaDrv;
 ReScanPanel(#VisaDrv);
}
cmPositionChanged:
{
 UpdateTable;
 ReScanPanel(#VisaDrv);
}
cmInsertRecord:
 {
   Insert current VisaDrv;
 }
cmPick:
{
  case curfield of
   #KatState.name:
   {
     var _cState : comp = VisaDrv.cstate;
     RunInterface(L_KATORG::GETSTATE,_cState)
     set VisaDrv.cstate := _cState;
     UpdateTable;
   }
   end;
   Rereadrecord;
}
CmDeleteRecord:
{
  delete attrval where ((coVisaDrv == attrval.wTable and VisaDrv.nrec == attrval.crec));
  delete current VisaDrv;
}
end; //GP_SCUD_Doc
//******************************************************************************
// HandleEvent таблиц
//******************************************************************************
TableEvent table Passports
cmCheckField:
{
  UpdateTable;
}
cmUpdateRecord:
{
  Update Current Passports;
 ReScanPanel(#Pers);
}
cmPositionChanged:
{
 UpdateTable;
      ReScanPanel(#Pers);
}
cmInsert:
{
//  if runwindowModal(wbSelTypeDoc) <> cmDefault then {stop;abort;exit;}
  runwindowModal(wbSelTypeDoc)
}
cmSetDefault:
{
  Passports.docname := PassportsSelect.nrec;
  Passports.Syscode := PassportsSelect.Syscode;
  Passports.PERSON  := pers.nrec;
}
cmInsertRecord:
 {
   Insert current Passports;
 }
    cmPick:
    {
      case curfield of
       #DocName:
       {
         runwindowModal(wbSelTypeDoc)
         Passports.docname := PassportsSelect.nrec;
         Passports.Syscode := PassportsSelect.Syscode;
         Passports.PERSON  := pers.nrec;
         UpdateTable;
       }
       end;
       Rereadrecord;
    }

end; //GP_SCUD_Doc


//------------------------------
//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
HandleEvent
    //-----------------------------
    cmInit:
    {
    //добавить тулбар в окно редактирования
     LoadAndShowToolBar_GP('GP_Common::tbFile_Doc' , -1, -1, 1);

      ReScanPanel(#Pers);
    }
    cmExprFieldChanged:
    {
      case curfield of
       #_Visadays  :  ssetAttr(coVisaDrv,VisaDrv.nrec,coAttrVisa_Visadays  , ExprFieldValue);
       #_VisaNumber:  ssetAttr(coVisaDrv,VisaDrv.nrec,coAttrVisa_VisaNumber, ExprFieldValue);
      end;
      rereadrecord;
    }
    cmValue68:
      {
           pGP_File_hRef.InitParam(
           //if(not CanEditTbl,cgiNotEdit,0)   //_wIntMode  : word;  // режим запуска (cgiNo, cgiPick, ...) см.GLOCONST.INC
           0             // Если документ только на чтение следует вызвать cgiNotEdit
          ,coPersons//_wTable    : word; указать код таблицы документа системы
          ,Pers.Nrec //_cRec      : comp=0;   // указать поле в таблице
          ,1 //_Option    //: longint=0; // опции,  1 - открыть окно,0 для встраивания
          ,true//_NoVisual  //: boolean=false //не перерисовывать экраны
          ,'Документы сотрудника: '+Pers.Fio
           );
       }
    cmHotKeys:
    {
        ProcessCommand(RunMenu('EM_VED_ZAGRAN__HotKey'));
    }

end;
end.

EM_VED_ZAGRAN__HotKey Menu
{
// - 'Фильтр на данные'     , cmFilterSave, 'Фильтр на данные', hcProc_NagrKaf, 'Alt+B',kbAltB, scMenuCtx;
- 'Просмотр/привязка файлов', cmValue68, 'Просмотр/привязка файлов', hcGkatalM1ExtClass, 'Alt+C', kbAltC, sci1Esc;
}
