//******************************************************************************
//                                                      
// Галактика 8.10
// Создание/модификация настроек для Fakel -
// Зарплата Управлением персоналом
//******************************************************************************
#define ComponentVersion

#include CreateTune.vih

//------------------------------------------------------------------------------
Handler with replace Fakel_DateModifyTune on ExtensionPoint
  epDateModifyTuneEx (TS : ObjStartCreateTuneEx) [201]
Action
{
   TS.SetLastDateModTuneComp('Fakel', 03, 09, 2022);
   result := true;
}
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
Handler with replace Fakel_CreateTune on extensionPoint
  epCreateTuneComponent (TR: ObjCreateTuneEx) [201]
Action
{
  Result := true;
  TR.SetComponent('Fakel');     // установить имя компонента

  // для случаев изменения типа настройки и конвертации ее предыдущего значения
  var CanUpdateValue: boolean;

  TR.SetNextNumberTune(30000); // а вдруг не тронут?!
//------------------------------------------------------------------------------
//******************************************************************************
  TR.SetParent('Tune');
  TR.AddPartA('Fakel','Настройки Факел','');
//******************************************************************************
  TR.SetParent('Fakel');
//------------------------------------------------------------------------------
//******************************************************************************
  TR.AddPartA('Fakel.GALCOMMON', 'Общие настройки системы', '');
  TR.SetParent('Fakel.GALCOMMON');

  TR.AddTuneU('UP.FakelGAL.Fakel', 'Показывать поля для Факела', ftList, '0', '', '0');
   TR.AddList(0, 'Нет');
   TR.AddList(1, 'Да');

//******************************************************************************
  TR.SetParent('Fakel');
//------------------------------------------------------------------------------
//******************************************************************************
  TR.AddPartA('Fakel.UP', 'Управление персоналом', '');
  TR.SetParent('Fakel.UP');

  TR.AddPartA('Fakel.Kartoteka', 'Картотека', '');
  TR.SetParent('Fakel.Kartoteka');

  TR.SetParent('Fakel.UP');
//******************************************************************************
  TR.AddPartA('Fakel.OTPUSK', 'Отпуска', '');
  TR.SetParent('Fakel.OTPUSK');

  TR.AddTuneU('UP.Fakel.OTPUSKPOLE', 'Показывать поле использованных отпусков', ftList, '0', '', '0');
   TR.AddList(0, 'Нет');
   TR.AddList(1, 'Да');

  TR.SetParent('Fakel.UP');
//------------------------------------------------------------------------------
//******************************************************************************
  TR.AddPartA('Fakel.Prik', 'Приказы', '');
  TR.SetParent('Fakel.Prik');

  TR.AddTuneS('Fakel.Prik.SaveFile', 'Путь сохранения PDF-файлов приказа', ftString, '', '', '');
}
