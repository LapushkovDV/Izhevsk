Browse brwRaise107 'Назначение доплаты' (,, sci178Esc);
  show at (, 9,,12);
  table RaiseHist;
    Fields
  RaiseCat.Name     'Вид доплаты/надбавки', ('Вид доплаты/надбавки.', hcStaffRaiseType, sci1378Esc):[20], protect;
  RaiseHist.rHSum   'Сумма/процент доплаты/надбавки', ('Сумма/процент доплаты/надбавки', hcStaffRaiseSum): [13.3], noprotect,
    {Font = {BackColor = if (RaiseHist.rHSum <= 0, ColorNeed, 0)}};
  'Нац.валюта'      'Валюта', ('Валюта оплаты.', hcStaffRaiseCurr, sci1378Esc):[10] , protect;
  RaiseHist.dRec    'С даты', ('Дата, с которой установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered,
    {Font = {BackColor = if (RaiseHist.dRec = 0, ColorNeed, 0)}};
  RaiseHist.dDat2   'По дату', ('Дата, по которую установлена доплата', hcStaffRaiseFromDate, sci1378Esc): [10,'DD/MM/YYYY'], noprotect, centered,
    {Font = {BackColor = if (RaiseHist.dDat2 = 0, ColorNeed, 0)}};
end;   //  brwRaise

