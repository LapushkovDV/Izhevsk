//******************************************************************************
// Процедура удаления своих записей, привязанных у удаляемому приказу
//******************************************************************************
Procedure MyDel;
{
  _loop RaiseHist
  {
    if funIsOrderConfirm and isValidAll(tnSposobOpl)
      if isValidAll(#GP_RaiseHistExt107)
      {
        if locase(trim(SposobOpl.Name)) = 'удержание из зарплаты'
        {
          case _setUderRK.DelSU(132, RaiseHist.Nrec, 212, 5, contdoc.nrec) of
            0, // вероятно, что пользователь сам удалил обработанные сигналы
            1: // грохнули обработанный сигнал
            {
              var _params: TGP_SetUderRK_Params;
              _params.cPers   := persons.nrec;
              _params.cApp    := appointments.nrec;
              _params.wTable  := 132;
              _params.cRec    := RaiseHist.Nrec;
              _params.wVidUd  := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_107.VIDUD');
              if (_params.wVidUd = 0) _params.wVidUd := 15;
              _params.dBeg    := RaiseHist.dRec;
              _params.dEnd    := RaiseHist.dDat2;
              _params.dSum    := GP_RaiseHistExt107.SummaMes;
              _params.cContDoc:= contdoc.nrec;
              if _setUderRK.CloseSU(_params) = 0
                SetErrorOrder('Не удалось послать сообщение в РК о прекращении действия удержания: '
                              + _params.wVidUd + ' от ' + string(_params.dBeg), Warning);
            }
            100: SetErrorOrder('Не удалось удалить соответствующие записи в РК', Warning);
          end; // case
        }
      }
    delete all from GP_RAISEHISTEXT107 where ((RaiseHist.Nrec == GP_RaiseHistExt107.cRaiseH));
  }
  inherited::MyDel;
}

//Выполняет проверку текущего приказа
function ChildCheckOneOrder(cNrec : comp = 0): boolean;
{ Result:=Inherited::ChildCheckOneOrder(cNrec);
  _Loop RaiseHist
  { if (getfirst RaiseCheck where ((
      // для проверки
           ContDoc.Person == RaiseCheck.Person
       and RaiseHist.dDat2>>= RaiseCheck.FromDate(noindex)
       and(  RaiseHist.dRec<=RaiseCheck.ToDate
         and RaiseCheck.Nrec<>Raise.Nrec
         and FoundMarker(Marker_raise,RaiseCheck.RaiseType)
       )
     )) )=tsok
    { SetErrorOrder('У сотрудника  уже есть доплата такого типа с '
        +DateToStr(RaiseCheck.FromDate,'')+' по '+DateToStr(RaiseCheck.ToDate,''));
      Result:=false;
    } //if getfirst RaiseCheck=tsok
  } //_Loop RaiseHist
  //Проверки доплат для полисов ДМС не нужны
} //function ChildCheckOneOrder(cNrec : comp = 0): boolean;

//******************************************************************************
//  Процедура утверждения приказа по текущему работнику (по таблице ContDoc)
//******************************************************************************
function IRPD_Base.ChildConfirmOneOrder(cNrec : comp = 0): boolean;
{ //-----------------------------------
  // проверим и при необходимости создадим организацию
  if coGetTune('UP.STAFF.RECEPTION.GP_KATORGGROUP')>0
     pGP_Staff_Func.CheckKatOrgByPers(ContDoc.Person,True);
  //-----------------------------------
  _loop RaiseHist
  {
    if isValidAll(#GP_RaiseHistExt107)
    {
      if isValidAll(tnSposobOpl)
        if locase(trim(SposobOpl.Name)) = 'удержание из зарплаты'
        {
          var _params: TGP_SetUderRK_Params;
          _params.cPers   := persons.nrec;
          _params.cApp    := appointments.nrec;
          _params.wTable  := 132; //coGP_RaiseHistExt107;
          _params.cRec    := RaiseHist.Nrec; //GP_RaiseHistExt107.nrec;
          _params.wVidUd  := coGetTune('UP.STAFF.PRIKAZ_PERS.RPD_107.VIDUD');
          if (_params.wVidUd = 0) _params.wVidUd := 15;
          _params.dBeg    := RaiseHist.dRec;
          _params.dEnd    := RaiseHist.dDat2;
          _params.dSum    := GP_RaiseHistExt107.SummaMes;
          _params.cContDoc:= contdoc.nrec;
          _setUderRK.OpenSU(_params);
        }
    }
  }
  result := inherited::ChildConfirmOneOrder(cNrec);
}



//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure EnableDisable;
{
  var sTitle:string;
  inherited::EnableDisable;

  cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
  cfsGetProp('WHATISINORDER',cfpTitle, sTitle);
  cfsSetProp('WHATISINORDER',cfpTitle, replace(sTitle,'Приказ','Список'));
  cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер списка');
  cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата списка');


  if fnFieldsOpen // не утвержден
  {
    SetHelpAndStatusContext(brwRaise107, -1, sci178Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt107.NumDog, true);
    ToggleFieldSelectable(#GP_RaiseHistExt107.SrokDog, true);
    ToggleFieldSelectable(#GP_RaiseHistExt107.Kateg, true);
    ToggleFieldSelectable(#GP_RaiseHistExt107.KolMest, true);
    ToggleFieldSelectable(#SposobOpl.name, true);
    ToggleFieldSelectable(#GP_RaiseHistExt107.PlataMes, true);
    ToggleFieldSelectable(#GP_RaiseHistExt107.SummaMes, true);
    ToggleFieldSelectable(#GP_RaiseHistExt107.FMembers, true);
    ToggleFieldSelectable(#GP_RaiseHistExt107.FMembCh, true);
  }
  else //утвержден
  {
    SetHelpAndStatusContext(brwRaise107, -1, sci1Esc, 'StaffWinPr');
    ToggleFieldSelectable(#GP_RaiseHistExt107.NumDog, false);
    ToggleFieldSelectable(#GP_RaiseHistExt107.SrokDog, false);
    ToggleFieldSelectable(#GP_RaiseHistExt107.Kateg, false);
    ToggleFieldSelectable(#GP_RaiseHistExt107.KolMest, false);
    ToggleFieldSelectable(#SposobOpl.name, false);
    ToggleFieldSelectable(#GP_RaiseHistExt107.PlataMes, false);
    ToggleFieldSelectable(#GP_RaiseHistExt107.SummaMes, false);
    ToggleFieldSelectable(#GP_RaiseHistExt107.FMembers, false);
    ToggleFieldSelectable(#GP_RaiseHistExt107.FMembCh, false);
  }
}

//Проверяет на валидность данные в записи RaiseHist
function RaiseHistIsValid: boolean;
{
  result := RaiseHist.rHSum > 0 and
            RaiseHist.dRec > 0 and
            RaiseHist.dDat2 > 0 and
            GP_RaiseHistExt107.cSposOpl != 0 and
            GP_RaiseHistExt107.PlataMes > 0 and
            GP_RaiseHistExt107.SummaMes > 0;
}

//Возвращает текст сообщения пользователю с детализацией о невалидности записи RaiseHist
function GetNotValidRaiseHistUserInfo: string;
{
  var EmptyRequiredFields: string = ''; //незаполненные обязательные поля

  if RaiseHist.rHSum <= 0
    EmptyRequiredFields := 'Сумма/процент доплаты/надбавки';

  if RaiseHist.dRec = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'С даты';

  if RaiseHist.dDat2 = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'По дату';

  if GP_RaiseHistExt107.cSposOpl = 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'Способ оплаты';

  if GP_RaiseHistExt107.PlataMes <= 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'Плата за месяц';

  if GP_RaiseHistExt107.SummaMes <= 0
    EmptyRequiredFields += if(EmptyRequiredFields = '', '', ''#13#3) + 'Сумма за месяц (к удержанию)';

  result := if(EmptyRequiredFields = '', '',
               ''#3'Не заполнены обязательные поля: '#13 + EmptyRequiredFields);
}

TableEvent table RaiseHist;
  cmSetDefault:
  {
    //message('Докомпилировали обработчик');
    inherited::HandleEvent(cmSetDefault);
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD107');
    if (ParentSav <> 0)
    {
      RaiseHist.cRaiseType := ParentSav;
      RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
      Raise.RaiseAttr := RaiseHist.iHAttr;
      Raise.RaiseType := ParentSav;
    }
    RaiseHist.Nrec := GetNextNrec(tnRaiseHist, 0);
    clearbuffer(#GP_RaiseHistExt107);
    GP_RaiseHistExt107.Nrec := GetNextNrec(tnGP_RaiseHistExt107, 0);
    GP_RaiseHistExt107.cRaiseH := RaiseHist.Nrec;
    SetModified(true);
  }
  cmInsertRecord:
  {
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      GP_RaiseHistExt107.cRaiseH := RaiseHist.nrec;
      insert current GP_RaiseHistExt107;
    }
  }
  cmUpdateRecord:
  {
    if inherited::handleevent(cmUpdateRecord) = heOk
    {
      if isValidAll(#GP_RaiseHistExt107)
        update current GP_RaiseHistExt107;
    }
  }
  cmDeleteRecord:
  {
    if isValidAll(#GP_RaiseHistExt107)
      delete current GP_RaiseHistExt107;
    inherited::handleevent(cmDeleteRecord);
  }
  cmCheckRecord:
  {
    if not RaiseHistIsValid
    {
      Message(GetNotValidRaiseHistUserInfo, Error);
      Abort;
    }
    inherited::handleevent(cmCheckRecord);
  }
end;

TableEvent table ContDoc;
  cmInsertRecord:
  {
    //При добавлении нового сотрудника в приказ вызываем выбор вида доплаты/надбавки
    if inherited::handleevent(cmInsertRecord) = heOk
    {
      if SelectFormat(brwRaise107)
      {
        SelectField(#RaiseCat.Name);
        PutCommand(cmPick);
      }
    }
  }
end;

