end;

Interface RPD_107 '' escclose;

var
  _extClass: iExtClass;
  _setUderRK: GP_SetUderRK;
  pGP_Staff_Func :GP_Staff_Func;
  Marker_Raise:longint;
view as select PsnLinks.RFio,PsnLinks2.RFio
from
   GP_RaiseHistExt107
  , Catalogs SposobOpl
  ,PsnLinks
  ,PsnLinks PsnLinks2
  //,Raise RaiseCheck
where
    ((RaiseHist.nrec == GP_RaiseHistExt107.cRaiseH
and GP_RaiseHistExt107.cSposOpl == SposobOpl.nrec
//and RaiseHist.cRaise == Raise.nrec
//and Raise.RaiseType  == RaiseCat.nrec
  and ContDoc.cAddInf == PsnLinks.nRec
  and ContDoc.CNEW4   == PsnLinks2.nRec

));

