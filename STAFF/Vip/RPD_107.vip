//******************************************************************************
// HandleEvent самого интерфейса
//******************************************************************************
  HandleEvent
    cmcheckfield:
    {
      case CurField of
        #GP_RaiseHistExt107.NumDog,
        #GP_RaiseHistExt107.SrokDog,
        #GP_RaiseHistExt107.Kateg,
        #GP_RaiseHistExt107.KolMest,
        #SposobOpl.name,
        #GP_RaiseHistExt107.PlataMes,
        #GP_RaiseHistExt107.SummaMes,
        #GP_RaiseHistExt107.FMembers,
        #GP_RaiseHistExt107.FMembCh:
        {
          SetModified(true);
        }
        #RaiseHist.dDat2:
        {
          Set GP_RaiseHistExt107.SrokDog := RaiseHist.dDat2;
        }
        #ContDoc.WATTRDOC3:
        { update current ContDoc;

        }
      end;
      inherited::handleevent(cmCheckField);
    }

    cmMulSelDO:
    {
      if UpdateTable
        UpdNeedField(CurField);
    }
    cmPick:
    {
      case CurField of
        #RaiseCat.Name:
        {
          ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD107');

          var wPickResult: word = cmCancel;
          if GetFirst FastFirstRow Catalogs where ((ParentSav == Catalogs.cParent)) = tsOk
            wPickResult := RunInterface(Z_STAFFCAT::PickCatalog2, 0, ParentSav, 0, 0);
          else
            wPickResult := RunInterface(GP_STAFF::GP_PickCatalogWithOneRec, -17, ParentSav);

          if (wPickResult = cmDefault)
          {
            //PreviousType := RaiseHist.cRaiseType; // взвести флаг того, что поменяли наименование
            set RaiseHist.cRaiseType := ParentSav;
            set RaiseHist.iHAttr := CheckTypeRaise(ParentSav);
            set Raise.RaiseAttr := RaiseHist.iHAttr;
            set Raise.RaiseType := ParentSav;
            ReReadRecord(tnCatalogs);

            var d: double;
            d := double(_extClass.GetSegCode(
              _extClass.GetClassCode(coCatalogs,'Дотация стоимости гостиничных услуг'), RaiseHist.cRaiseType));
            if d != 0
              set RaiseHist.rhSum := d;

            d := double(_extClass.GetSegCode(
              _extClass.GetClassCode(coCatalogs, 'Прейскурант оказания гостиничных услуг'), RaiseHist.cRaiseType));
            if d != 0
            {
              set GP_RaiseHistExt107.SummaMes := d;
              set GP_RaiseHistExt107.PlataMes := d;
            }

            d := double(_extClass.GetSegCode(
              _extClass.GetClassCode(coCatalogs,'Количество мест'), RaiseHist.cRaiseType));
            if d != 0
              set GP_RaiseHistExt107.KolMest := d;

            var w: word;
            w := double(_extClass.GetSegCode(
              _extClass.GetClassCode(coCatalogs,'Категория номера'), RaiseHist.cRaiseType));
            set GP_RaiseHistExt107.Kateg := w;

          }

          exit;
        } //RaiseCat.Name
        #PsnLinks.rFIO:
        { var cTemp: comp;
          cTemp := ContDoc.cAddInf;
          if ( RunInterface(PickChildForPers, cTemp, ContDoc.Person) <> cmCancel )
          { set ContDoc.cAddInf := cTemp;
            if ( update current ContDoc <> tsOk ) {} //
            ReScanPanel(#GP_RaiseHistExt107);
          }
        }
        #PsnLinks2.rFIO:
        { var cTemp: comp;
          cTemp := ContDoc.CNEW4;
          if ( RunInterface(PickChildForPers, cTemp, ContDoc.Person) <> cmCancel )
          { set ContDoc.CNEW4 := cTemp;
            if ( update current ContDoc <> tsOk ) {} //
            ReScanPanel(#GP_RaiseHistExt107);
          }
        }
      end;
      //--------------------
      if inherited::HandleEvent(cmPick) =heAbort Abort;
      //--------------------
      case CurField of
        #SposobOpl.name:{
          //
          RunInterface(Z_StaffCat::PickCatalog2, 4001, GP_RaiseHistExt107.cSposOpl, 0);
          SetModified(True);
          ReReadRecord(tnCatalogs);
        }
        #persons.fio:
        {

          if isvalidall(#Persons)
          {
            //Запрещаем пользователю выбирать умерших сотрудников
            if (Persons.ddop1 != 0)
            {
              message('Запрещено выбирать сотрудников с заполненным полем "Дата смерти"', error);
              PutCommand(cmDelOnProtect);
            }
            else
            {
              //Если пользователь выбрал корректного сотрудника и это новая позиция -
              //сразу вызываем вставку этой записи, чтобы далее вызвать добавление вида доплаты/надбавки
              if(isNew) UpdateTable();
              SelectFieldInFormat(brwRaise107, #RaiseCat.Name);
            }

          }
        }
      end;
    }
    cmDelOnProtect:
    { //--------------------
      if inherited::HandleEvent(cmDelOnProtect) =heAbort Abort;
      //--------------------
        case CurField of
        #PsnLinks.rFIO:
        { set ContDoc.cAddInf := 0;
          if ( update current ContDoc <> tsOk ) {} //
          ReScanPanel(#GP_RaiseHistExt107);
        }
        #PsnLinks2.rFIO:
        { set ContDoc.CNEW4 := 0;
          if ( update current ContDoc <> tsOk ) {} //
          ReScanPanel(#GP_RaiseHistExt107);
        }
        end;
    }
    cmHotKeys:
    {
      var LocalMenu:longint;
      //Добавим пункт меню для импорта реестра гостиничных услуг
      LocalMenu := LoadMenu('Rpd_MenuCopy');
      AddMenuItem(LocalMenu, 'Импорт гостиничных услуг', cmValue31);
      PutHotCommand(RunLoadMenu(LocalMenu));
    }
    cmValue31://Импорт гостиничных услуг
    {
      RunInterface('GP_RPD107_Import', PartDoc.nrec);
      ReReadRecord;
    }
    cmOnVipload:{
      timelog_init;
      Marker_Raise  :=InitMarker('', 8, 50, 10, True);
      ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD107');
      if ParentSav>0
      { timelog('RPD_107->cmOnVipload:Доплата для проверки '+string(ParentSav,0,0));
        InsertMarker(Marker_Raise,ParentSav);
        _Loop Catalogs where ((ParentSav == Catalogs.cParent))
        { InsertMarker(Marker_Raise,Catalogs.Nrec);
          if timelog_status>0
            timelog('RPD_107->cmOnVipload:Доплата для проверки '+string(Catalogs.Nrec,0,0)+','+Catalogs.Name);
        } //_Loop Catalogs where ((ParentSav == Catalogs.cParent))
      } //if ParentSav>0
      inherited::Handleevent(cmOnVipload);
    }//cmOnVipload:{
    cmOnVipUnload:{
      DoneMarker(Marker_Raise,'');
      inherited::Handleevent(cmOnVipUnload);
      cfsSetCurrentContainer('Z_STAFFORDERS::ORDERSLIST');
      cfsSetProp('L_EDITTITLE_N_приказа',cfpTitle,'Номер приказа');
      cfsSetProp('L_EDITTITLE_Дата_приказа',cfpTitle,'Дата приказа');

    }

  end;

End.
