/*************************************************************************************************\
* Наименование:  Отчет "Движение сотрудников по предприятию"                                      *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#2525          |06/06/18 |Ермолов К.Р.            |НПО Энергомаш                   *
\*************************************************************************************************/

#include userreport.vih

interface gp_dvizh 'Параметры отчета' gray
Show at (,,43,5);

table struct _tabl
(
p0: string,
p1: date,
p2: date,
p3: string,
p4: word,
p5: string,
p6: word,
p7: string,
p8: string,
p9: decimal(31,15),
p10: date,
p11: string,
p12: word,
p13: string,
p14: string,
p15: string,
p16: word,
p17: decimal(31,15),
p18: string,
p19: string,
p20: date
)
with index
(
i1 = p0
)
;

create view gp_dvizh

var
counter, countpp, countermatrix: longint;
excelpath: string;
data1, data2: date;

select * from _tabl;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  data1, noprotect;
  data2, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    В период с:.@@@@@@@@@@  по:.@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  data1:= cur_date;
  data2:= cur_date;
}

cmGo:
{
StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

delete all from _tabl;

sql
select distinct   A.Fio as fio,
         A.APPOINTDATE as PREVAPPOINTDATE,
         A.DISMISSDATE as PREVDISSMISSDATE,
         A.TABN as TabnPrev,
         A.Kategoria as KategPrev,
         PostPrev.name as PostPrev,
         A.category as RAZR,
         DepPrev.Code as DepPrev,
         case
           when length(DepPrev.Code) = 3 then
             DepPrev.NAME
           else
             DepPrev.NAME + ' / ' +
             (select NAME from CATALOGS where CATALOGS.NREC = DEPPREV.CPARENT)
         end as DepPrevNAME,
         A.TaxRate as taxRatePrev,
         AN.APPOINTDATE as NEXTAPPOINTDATE,
         AN.STRTABN as TabnNext,
         Kateg.KOD as KategNext,
         PostNext.name as PostNext,
         DepNext.code as DepNext,
         case
           when length(DepNext.Code) = 3 then
             DepNext.NAME
           else
             DepNext.NAME + ' / ' +
             (select NAME from CATALOGS where CATALOGS.NREC = DepNext.CPARENT)
         end as DepPrevNAME,
         AN.category as RAZRNEXT,
         AN.TaxRate as taxRateNext,
         case when AN.DATEEND = 0 then 'Перевод' else 'Временный перевод' end as Perevod,
         AN.ORDERNMB   as ORDERNMB,
         AN.ORDERDATE  as ORDERDATE
  from (
           select A.NREC as nrec,
                  A.PERSON as person ,
                  P.FIO as fio,
                  A.STRTABN as Tabn,
                  Kateg.KOD  as Kategoria,
                  A.APPOINTDATE as APPOINTDATE,
                  A.DISMISSDATE as DISMISSDATE,
                  A.Department as Department,
                  A.TaxRate as taxRate,
                  A.Post as Post,
                  A.KindApp as KindApp,
                  A.category,
                  (select Max(SA.NREC) from APPOINTMENTS SA where SA.PERSON = A.PERSON and sa.lprizn = A.LPRIZN and SA.APPOINTDATE = (
                    (select min(APPOINTDATE) from APPOINTMENTS SSA where SSA.PERSON = A.PERSON and ssa.lprizn = A.LPRIZN and SSA.APPOINTDATE > A.APPOINTDATE group by SSA.PERSON) )
                  )
                  as NEXTAPPOINTREC
           from APPOINTMENTS A
              join  PERSONS P on A.PERSON = p.nrec
              left join KlKatego Kateg  on A.EmpCategory = Kateg.Nrec
           where
             A.LPRIZN = 0
       ) A
   join APPOINTMENTS AN        on A.NEXTAPPOINTREC = AN.NREC
   left join Catalogs DepPrev  on A.Department = DepPrev.nrec
   left join Catalogs DepNext  on AN.Department = DepNext.nrec
   left join Catalogs PostPrev on A.post = PostPrev.nrec
   left join Catalogs postNext on AN.post = PostNext.nrec
   left join KlKatego Kateg    on AN.EmpCategory = Kateg.Nrec
where
                (
                   (     a.APPOINTDATE>= :(data1)
                     and a.APPOINTDATE <= :(data2)
                   )
                or
                   (       a.DISMISSDATE >= :(data1)
                     and a.DISMISSDATE <= :(data2)
                   )
                  or
                   (     an.APPOINTDATE>= :(data1)
                     and an.APPOINTDATE <= :(data2)
                   )
               )
/*  and
(//      A.Department <> AN.Department or 20200428 Киселева Ольга Валентиновна сказала выводить надо....
                A.Post <> AN.Post
       or    A.KindApp <> AN.KindApp 17,08,2020 перевод на месте не попал в отчет Пётр Метелёв
)
*/


into _tabl;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_dvizh.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  xlsetcellstringvalue('ДВИЖЕНИЕ СОТРУДНИКОВ ПО ПРЕДПРИЯТИЮ НА ПЕРИОД С ' + data1 + ' ПО ' + data2, 1, 1, 1, 1);

  counter:= 3;
  countpp:= 0;
  countermatrix:= 0;

  xlCreateMatrix(100, 22);

  _loop _tabl
  {
    countpp++;
    countermatrix++;
    xlStWriteToMatrix(countermatrix, 1, countpp);
    xlStWriteToMatrix(countermatrix, 2, _tabl.p0);
    xlDtWriteToMatrix(countermatrix, 3, _tabl.p1);
    xlDtWriteToMatrix(countermatrix, 4, _tabl.p2);
    xlStWriteToMatrix(countermatrix, 5, _tabl.p3);
    xlDoWriteToMatrix(countermatrix, 6, _tabl.p4);
    xlStWriteToMatrix(countermatrix, 7, _tabl.p5);
    xlDoWriteToMatrix(countermatrix, 8, _tabl.p6);
    xlStWriteToMatrix(countermatrix, 9, _tabl.p7);
    xlStWriteToMatrix(countermatrix, 10, _tabl.p8);
    xlDoWriteToMatrix(countermatrix, 11, _tabl.p9);
    xlDtWriteToMatrix(countermatrix, 12, _tabl.p10);
    xlStWriteToMatrix(countermatrix, 13, _tabl.p11);
    xlDoWriteToMatrix(countermatrix, 14, _tabl.p12);
    xlStWriteToMatrix(countermatrix, 15, _tabl.p13);
    xlStWriteToMatrix(countermatrix, 16, _tabl.p14);
    xlStWriteToMatrix(countermatrix, 17, _tabl.p15);
    xlDoWriteToMatrix(countermatrix, 18, _tabl.p16);
    xlDoWriteToMatrix(countermatrix, 19, _tabl.p17);
    xlStWriteToMatrix(countermatrix, 20, _tabl.p18);
    xlStWriteToMatrix(countermatrix, 21, _tabl.p19);
    xlDtWriteToMatrix(countermatrix, 22, _tabl.p20);

    if countermatrix = 100
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  xlFreeMatrix;

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter - 1, 22);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_dvizh Implements IUserReport;
Interface UserReport_dvizh;

Procedure Run;
Begin
  runinterface(gp_dvizh);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Движение сотрудников по предприятию';
End;

Function GetGroupName (Level : Word) : String;
Begin
#__UNUSED__(Level)
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
