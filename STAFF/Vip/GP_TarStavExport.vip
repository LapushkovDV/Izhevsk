/*************************************************************************************************\
* Наименование: Реализация класса GP_TarStavExport "Экспорт справочника окладов/тарифных ставок"  *
* Контур/Модуль: Кадры                                                                            *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#158          |08/08/17|Кузьмин П.Ю.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include CatFunc.vih           // Функции работы с Catalogs

#include GP_TarStavExport.vih
interface GP_TarStavExport;

var iCatFunc:CatalogsFunctions;   // Переменная типа интерфейс CatalogsFunctions
    CurExcelRow:longint;

create view
from
  TarStav,KlSisOpl,GP_TarStavExt;

procedure WriteCatalogsNameToMatrix(CurExcelCol:longint;cCat:comp);
{
  if (cCat=0) exit;

  xlStWriteToMatrix(CurExcelRow,CurExcelCol,iCatFunc.GetCatalogsName(cCat));
}

procedure Run(MinRazrDatIzm:date);
var TarStavCount,ColCount:longint;
{
  if (not xlOpenNewExcel(true)) {
    message('Ошибка при открытии Excel.',error);
    exit;
  }

  TarStavCount:=0;
  _loop TarStav where((MinRazrDatIzm==TarStav.DatIzm)) TarStavCount++;

  ColCount:=31;
  if (not xlCreateMatrix(TarStavCount+1,ColCount)) {
    message('Ошибка функции xlCreateMatrix.',error);
    xlKillExcel;
    exit;
  }

  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Экспорт в Excel...', TarStavCount);

  //Шапка
  CurExcelRow:=1;
  xlStWriteToMatrix(CurExcelRow,1,'Система оплаты');
  xlStWriteToMatrix(CurExcelRow,2,'Тарифная сетка');
  xlStWriteToMatrix(CurExcelRow,3,'Наименование тарифа');
  xlStWriteToMatrix(CurExcelRow,4,'Разряд, категория');
  xlStWriteToMatrix(CurExcelRow,5,'Месячная тарифная ставка');
  xlStWriteToMatrix(CurExcelRow,6,'Тариф (оклад)');
  xlStWriteToMatrix(CurExcelRow,7,'Диапазон окладов, минимальный');
  xlStWriteToMatrix(CurExcelRow,8,'Диапазон окладов, максимальный');
  xlStWriteToMatrix(CurExcelRow,9,'Наименование тарифа для Т-3');
  xlStWriteToMatrix(CurExcelRow,10,'Группировка для Т-3');
  xlStWriteToMatrix(CurExcelRow,11,'Наименование схемы');
  xlStWriteToMatrix(CurExcelRow,12,'Целевой размер месячной премии 1');
  xlStWriteToMatrix(CurExcelRow,13,'Вид оплаты месячной премии 1');
  xlStWriteToMatrix(CurExcelRow,14,'Целевой размер месячной премии 2');
  xlStWriteToMatrix(CurExcelRow,15,'Вид оплаты месячной премии 2');
  xlStWriteToMatrix(CurExcelRow,16,'Целевой размер месячной премии 3');
  xlStWriteToMatrix(CurExcelRow,17,'Вид оплаты месячной премии 3');
  xlStWriteToMatrix(CurExcelRow,18,'Целевой размер квартальной премии');
  xlStWriteToMatrix(CurExcelRow,19,'Вид оплаты квартальной премии');
  xlStWriteToMatrix(CurExcelRow,20,'Целевой размер годовой премии');
  xlStWriteToMatrix(CurExcelRow,21,'Вид оплаты годовой премии');
  xlStWriteToMatrix(CurExcelRow,22,'Персональная надбавка 1');
  xlStWriteToMatrix(CurExcelRow,23,'Профессиональный статус 1');
  xlStWriteToMatrix(CurExcelRow,24,'Персональная надбавка 2');
  xlStWriteToMatrix(CurExcelRow,25,'Профессиональный статус 2');
  xlStWriteToMatrix(CurExcelRow,26,'Персональная надбавка 3');
  xlStWriteToMatrix(CurExcelRow,27,'Профессиональный статус 3');
  xlStWriteToMatrix(CurExcelRow,28,'Персональная надбавка 4');
  xlStWriteToMatrix(CurExcelRow,29,'Профессиональный статус 4');
  xlStWriteToMatrix(CurExcelRow,30,'Персональная надбавка 5');
  xlStWriteToMatrix(CurExcelRow,31,'Профессиональный статус 5');

  _loop TarStav
  where((
    MinRazrDatIzm == TarStav.DatIzm and
    TarStav.SisOpl == KlSisOpl.SisOpl and
    TarStav.NRec == GP_TarStavExt.cTarStav
  )) {
    if (not NextVisual) break;

    CurExcelRow++;
    if (IsValidAll(tnKlSisOpl))
      xlStWriteToMatrix(CurExcelRow,1,KlSisOpl.NaSisOpl);
    xlDoWriteToMatrix(CurExcelRow,2,TarStav.CodTar);
    xlStWriteToMatrix(CurExcelRow,3,''''+TarStav.NaiTar);
    xlDoWriteToMatrix(CurExcelRow,4,TarStav.Razr);
    xlDoWriteToMatrix(CurExcelRow,5,TarStav.Summa1);
    xlDoWriteToMatrix(CurExcelRow,6,TarStav.Tarif);
    xlDoWriteToMatrix(CurExcelRow,7,TarStav.TarMin);
    xlDoWriteToMatrix(CurExcelRow,8,TarStav.TarMax);

    if (not IsValidAll(tnGP_TarStavExt)) continue;

    xlStWriteToMatrix(CurExcelRow,9,''''+GP_TarStavExt.NameT3);
    xlStWriteToMatrix(CurExcelRow,10,''''+GP_TarStavExt.GropuT3);
    xlStWriteToMatrix(CurExcelRow,11,''''+GP_TarStavExt.SchemeName);
    xlDoWriteToMatrix(CurExcelRow,12,GP_TarStavExt.MonthlyBonus[1]);
    WriteCatalogsNameToMatrix(13,GP_TarStavExt.cMonthlyBonusType[1]);
    xlDoWriteToMatrix(CurExcelRow,14,GP_TarStavExt.MonthlyBonus[2]);
    WriteCatalogsNameToMatrix(15,GP_TarStavExt.cMonthlyBonusType[2]);
    xlDoWriteToMatrix(CurExcelRow,16,GP_TarStavExt.MonthlyBonus[3]);
    WriteCatalogsNameToMatrix(17,GP_TarStavExt.cMonthlyBonusType[3]);
    xlDoWriteToMatrix(CurExcelRow,18,GP_TarStavExt.QuarterlyBonus);
    WriteCatalogsNameToMatrix(19,GP_TarStavExt.cQuarterlyBonusType);
    xlDoWriteToMatrix(CurExcelRow,20,GP_TarStavExt.AnnualBonus);
    WriteCatalogsNameToMatrix(21,GP_TarStavExt.cAnnualBonusType);
    xlDoWriteToMatrix(CurExcelRow,22,GP_TarStavExt.PersonalBonus[1]);
    WriteCatalogsNameToMatrix(23,GP_TarStavExt.cProfStatus[1]);
    xlDoWriteToMatrix(CurExcelRow,24,GP_TarStavExt.PersonalBonus[2]);
    WriteCatalogsNameToMatrix(25,GP_TarStavExt.cProfStatus[2]);
    xlDoWriteToMatrix(CurExcelRow,26,GP_TarStavExt.PersonalBonus[3]);
    WriteCatalogsNameToMatrix(27,GP_TarStavExt.cProfStatus[3]);
    xlDoWriteToMatrix(CurExcelRow,28,GP_TarStavExt.PersonalBonus[4]);
    WriteCatalogsNameToMatrix(29,GP_TarStavExt.cProfStatus[4]);
    xlDoWriteToMatrix(CurExcelRow,30,GP_TarStavExt.PersonalBonus[5]);
    WriteCatalogsNameToMatrix(31,GP_TarStavExt.cProfStatus[5]);
  }//_loop TarStav

  if (not xlWriteMatrixToExcel(1,1))
    message('Ошибка функции xlWriteMatrixToExcel.',error);
  else {
    //Форматирование
    xlSetColumnWidth(10,1,1,1,ColCount);
    xlSetColumnWidth(40,1,3,1,3);
    xlSetColumnWidth(30,1,9,1,11);
    xlSetColumnWidth(30,1,13,1,13);
    xlSetColumnWidth(30,1,15,1,15);
    xlSetColumnWidth(30,1,17,1,17);
    xlSetColumnWidth(30,1,19,1,19);
    xlSetColumnWidth(30,1,21,1,21);
    xlSetColumnWidth(30,1,23,1,23);
    xlSetColumnWidth(30,1,25,1,25);
    xlSetColumnWidth(30,1,27,1,27);
    xlSetColumnWidth(30,1,29,1,29);
    xlSetColumnWidth(30,1,31,1,31);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,5,CurExcelRow,8);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,12,CurExcelRow,12);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,14,CurExcelRow,14);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,16,CurExcelRow,16);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,18,CurExcelRow,18);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,20,CurExcelRow,20);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,22,CurExcelRow,22);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,24,CurExcelRow,24);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,26,CurExcelRow,26);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,28,CurExcelRow,28);
    xlSetNumberFormat('# ##0' + xlGetDecimalSeparator + '00',2,30,CurExcelRow,30);
    xlSetFontStyle(xlBold,1,1,1,ColCount);
    xlWrapText(1,1,CurExcelRow,ColCount);
    xlAlignCellsEx(xlCenter,xlCenter,1,1,1,ColCount);
    xlAlignCellsEx(xlGeneral,xlCenter,2,1,CurExcelRow,ColCount);
    xlFrameCells(xlBorderL+xlBorderR+xlBorderT+xlBorderB+xlInsideH+xlInsideV,xlThin,xlContinuous,0,1,1,CurExcelRow,ColCount);
  }

  xlFreeMatrix;
  xlKillExcel;

  StopVisual;
}

end.
