#ifndef __GP_IDepartIer__
#define __GP_IDepartIer__

#include DeptIer.vih

#component "Z_StaffCat"

#doc
Расширение для стандартного DepartIer для Энергомаша
#end
objinterface GP_IDepartIer;

  #doc
    Заполняет несортированный контейнер nrec'ами из иерархии подразделений
    по тому же алгоритму, что и GetFulDepName. Нулевой элемент - нрек подразделения
    самого верхнего уровня, последний элемент - DepCatNrec
  #end
  Procedure FillFulDepContainer(DepCatNrec: comp; var DepContainerId: TPtr);

  #doc
    Полный код подразделения с учетом уровня иерархии по тому же принципу, что и GetFulDepName
  #end
  Function GetFulDepCode(DepCatNRec: Comp; Separator: string = '\'): String;

end;

vipinterface GP_DepartIer(DepartIer) implements GP_IDepartIer licensed(free);
public:
  #doc
    Создание временной таблицы подразделений на заданную дату</brief>
    Иерархия строится по отделам (длина кода подразделения = 3) / Подотделам (длина кода > 3)
  #end
  procedure ObjDepartIer.CreateDeptIerTabl(DateBuild: date; cIer: word);
end;
#end
