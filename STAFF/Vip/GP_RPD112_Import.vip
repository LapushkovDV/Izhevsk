

Interface GP_RPD112_Import 'Импорт новых полисов ДМС' (,,sci178Ins) Cyan,DoAccept;
show at (,,60,10);
Var
  cPartDoc: comp;
  FName   : string;
  str     :integer;
  val     :string;
  status  : boolean;

//Таблица в памяти для импортируемых данных
Table Struct tmp112Import (
    NRec      : comp,
    Tabn      : string,
    FIO       : string,
    cPerson   : comp,
    NumPolis  : string,
    cPolisDMS : comp,
    DBeg      : date,
    DEnd      : date,
    cVarStr   : comp,
    VarStr    : string,
    NameUsl   : string,
    SumUsl    : double,
    DateUsl   : date
)
    with index (
      AttNpp = NRec(Surrogate)
);


Create view as select *
from Catalogs, Catalogs CatParent, Persons, tmp112Import, Contdoc, Raise, RaiseHist,
Appointments, Contdoc ContdocDMS, RaiseHist RaiseHistDMS,
Catalogs VarStrah, GP_RaiseHistExt112, TitleDoc, PartDoc, GP_RaiseHistExt111
;

Parameters cPartDoc;


function OpenAndReadFile(FileName:string):boolean; //true - отсутствие ошибок
{
  var err:string;
  var find:boolean;
  var catVarStr:comp;
  var cntWB:word = 0;
  var dDog, fioP, tabnum, sVarStr, tmpDate:string;
  fioP := '';  dDog:=''; tabnum := ''; sVarStr := ''; tmpDate := '';
  if (getfirst catParent where ((4006 == catparent.syscode)) )= tsOk
    catVarStr:= catParent.nrec;
  else
  {
    message('Ошибка! Не найден каталог Варианты страхования (системный код 4006)');
    exit;
  }
  xlOpenNewExcel(true);
  xlOpenWorkBook(FileName);
  xlSetActiveSheet(1);
  str := 6;
  status := true;
  do
  {
    err:='';
    xlGetCellValue(str, 1, val);
    xlGetCellValue(str, 2, tabnum);
    xlGetCellValue(str, 3, fiop);
    xlGetCellValue(str, 13, sVarStr);
    if (tabnum <> '')
    {
      ClearBuffer(#tmp112Import);
      if (getfirst titledoc where ((cPartDoc == partdoc.nrec and partdoc.cdoc == titledoc.nrec)) = tsOk) {};
      //Найдем сотрудника и спопоб пополнения
      if (getfirst Persons where (('С' == Persons.IsEmployee and fioP == Persons.FIO and tabnum == Persons.strtabn (noindex) )) = tsOk)
      {
      } else
      {
        status := false;
        //Проверим, есть ли Persons без С
        if (getfirst Persons where ((fioP == Persons.FIO (noindex) and tabnum == Persons.strtabn (noindex) )) = tsOk)
          err:='Ошибка! '+fioP+' не является сотрудником предприятия!';
        else
          err:='Ошибка! Не найден сотрудник '+tabnum+' '+fioP+'!';


      }
      //message('!'+catSposOpl+'!,!'+SposobOpl+'!');
      if  (getfirst VarStrah where ((catVarStr == VarStrah.cparent)) and UpCase(sVarStr) = UpCase(VarStrah.name) ) = tsOk
      {
        tmp112Import.cVarStr:= VarStrah.nrec;
        tmp112Import.VarStr := VarStrah.name;
      } else
      {
        status := false;
        err := err + ' Ошибка! Не найден способ оплаты по названию '+sVarStr;
      }
      find := false;
      if (getfirst GP_RaiseHistExt111 where ((Persons.nrec == GP_RaiseHistExt111.cPerson (noindex)
            and Titledoc.docdate >>= GP_RaiseHistExt111.datebeg and (Titledoc.docdate <= GP_RaiseHistExt111.dateend)
            and GP_RaiseHistExt111.cRaiseH /== RaiseHistDMS.nrec
            )) ) = tsOk
      {
        //Проверим, что приказ утвержден
//        if getfirst RaiseHistDMS where ((GP_RaiseHistExt111.cRaiseH /== RaiseHistDMS.nrec)) = tsOk
//        {
          if getfirst ContDocDMS where ((RaiseHistDMS.cContDoc /== ContDocDMS.nrec and (1 = ContdocDMS.wYearPR))) = tsOk
          {
            find := true;
          } else {
          }


      } else
      {
        message('Не нашли gp111 для сотрудника '+string(Persons.nrec,0,0)+' на дату '+titledoc.docdate);
      }
      if (not Find)
      {
        status := false;
        err := err + ' Ошибка! Не найден действующий полис на дату приказа '+TitleDoc.DocDate;
      }


      if (err <> '')
      {
        xlSetCellStringValue(err, str, 23, str, 23 );
        xlSetColumnWidth(50, str, 23, str, 23);
      }
      if (status)
      {
        //Добавим строку в служебную таблицу
        tmp112Import.tabn := tabnum;
        tmp112Import.cPerson := Persons.nrec;
        xlGetCellValue(str, 3,tmp112Import.FIO);
        xlGetCellValue(str, 10,tmp112Import.NumPolis);
        xlGetCellValue(str, 18,tmp112Import.NameUsl);
        xlGetCellValue(str, 16,tmp112Import.SumUsl);
        xlGetCellValue(str, 11,tmpDate);
        tmp112Import.dBeg   := strToDate(trim(tmpDate),'DD.MM.YYYY');
        xlGetCellValue(str, 12,tmpDate);
        tmp112Import.dEnd   := strToDate(trim(tmpDate),'DD.MM.YYYY');
        xlGetCellValue(str, 17,tmpDate);
        tmp112Import.dateUsl:= strToDate(trim(tmpDate),'DD.MM.YYYY');

        insert current tmp112Import;
      }
    }
    str++;
  } while (val <> '');
  puttabletodbf(#tmp112Import,'tmp112Import.dbf',ptfFullTable);
  xlGetWorkBooksCount(cntWB);
  xlSaveWorkBook(0);
  xlCloseWorkBook(1);
  xlKillExcel;
  OpenAndReadFile := status;
}

procedure LoadData; //Создание строк приказа по данным в таблице в памяти
{
  var npp:word;
  npp:= 1;
  if getfirst PartDoc where ((cPartDoc == PartDoc.nrec)) = tsOk
    if getfirst TitleDoc where ((PartDoc.cDoc == TitleDoc.nrec)) = tsOk
    {};
  _loop tmp112Import
  {
    ClearBuffer(#ContDoc);
    ContDoc.cPart := cPartDoc;
    ContDoc.NumPart := 1;
    ContDoc.wrec := npp;
    ContDoc.TypeOper := 112;
    ContDoc.Person := tmp112Import.cPerson;
    //Найдем назначение, действующее на дату приказа
    if (getlast Appointments where ((ContDoc.Person == Appointments.Person and 0 == Appointments.LPrizn and TitleDoc.DocDate >>= Appointments.AppointDate)) ) = tsOk
    {
      ContDoc.cStr := Appointments.nrec;
      ContDoc.cDopRef := Appointments.Department;
    }

    ContDoc.objType := 1;
    ContDoc.SeqNmb := 1;
    insert current ContDoc;


    ClearBuffer(#Raise);
    Raise.Person := tmp112Import.cPerson;
    Raise.Sum := tmp112Import.SumUsl;
    Raise.crDop := ContDoc.nrec;
    Raise.FromDate := tmp112Import.dateUsl;
    Raise.ToDate := tmp112Import.dateUsl;
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD112');
    if (ParentSav <> 0)
    {
      Raise.RaiseType := ParentSav;
    }
    insert current Raise;

    ClearBuffer(#RaiseHist);
    RaiseHist.cPsn := tmp112Import.cPerson;
    RaiseHist.cRaise := Raise.nrec;
    RaiseHist.wTypeOper := 9;
    RaiseHist.RHSum := Raise.Sum;
    RaiseHist.cContDoc := ContDoc.nrec;
    RaiseHist.DRec := tmp112Import.dateUsl;
    RaiseHist.DDat2:= tmp112Import.dateUsl;
    if (ParentSav <> 0)
    {
      RaiseHist.cRaiseType := ParentSav;
    }

    insert current RaiseHist;

    ClearBuffer(#GP_RaiseHistExt112);
    GP_RaiseHistExt112.cRaiseH := RaiseHist.nrec;

    GP_RaiseHistExt112.NameUsl := tmp112Import.NameUsl;
    GP_RaiseHistExt112.SummaUsl:= tmp112Import.SumUsl;
    insert current GP_RaiseHistExt112;

    npp++;
  }
  //Обновим описание приказа
  //update current titledoc set DocText := 'Компенсация стоимости гостиничных услуг (импорт из файла) '+Cur_Date;
}

  HandleEvent
    cmInit:
    {
      //Запросим имя файла Excel для импорта
      FName := GetFileName('*.xls;*.xlsx','Выберите файл Excel для импорта полисов ДМС...');
      //Откроем и проверим файл
      if OpenAndReadFile(FName)
      {
        //Загрузим данные файла в приказ
        LoadData;
        message('Импорт завершен успешно!');
      } else {
        message('При проверке файла обнаружены ошибки! См. файл, колонка 23.');
      }
    }
  End; //HandleEvent
end.
