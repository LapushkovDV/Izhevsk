

Interface GP_RPD111_Import 'Импорт новых полисов ДМС' (,,sci178Ins) Cyan,DoAccept;
show at (,,60,10);
Var
  cPartDoc: comp;
  FName   : string;
  str     :integer;
  val     :string;
  status  : boolean;

//Таблица в памяти для импортируемых данных
Table Struct tmp111Import (
    NRec      : comp,
    Tabn      : string,
    FIO       : string,
    cPerson   : comp,
    NumPolis  : string,
    DBeg      : date,
    DEnd      : date,
    cVarStr   : comp,
    VarStr    : string,
    dBorn     : date,
    summaV    : double,
    summaSP   : double
)
    with index (
      AttNpp = NRec(Surrogate)
);


Create view as select *
from Catalogs, Catalogs CatParent, Persons, tmp111Import, Contdoc, Raise, RaiseHist, Appointments,
Catalogs VarStrah, GP_RaiseHistExt111, TitleDoc, PartDoc
;

Parameters cPartDoc;


function OpenAndReadFile(FileName:string):boolean; //true - отсутствие ошибок
{
  var err:string;
  var catVarStr:comp;
  var BornDate:date;
  var cntWB:word = 0;
  var dDog, fioP, tabnum, sVarStr, tmpDate, f1, f2, f3:string;
  fioP := '';  dDog:=''; tabnum := ''; sVarStr := ''; tmpDate := ''; f1 := ''; f2 := ''; f3 := '';
  if (getfirst catparent where ((4006 == catparent.syscode)) )= tsOk
    catVarStr:= catParent.nrec;
  else
  {
    message('Ошибка! Не найден каталог Варианты страхования (системный код 4006)');
    exit;
  }
  xlOpenNewExcel(true);
  xlOpenWorkBook(FileName);
  xlSetActiveSheet(1);
  StartNewVisual(vtNumericVisual, vfTimer,'Проверка файла...', 0);
  str := 3;
  status := true;
  do
  {
    err:='';
    xlGetCellValue(str, 1, val);
    xlGetCellValue(str, 2, tabnum);
    xlGetCellValue(str, 3, f1);
    xlGetCellValue(str, 4, f2);
    xlGetCellValue(str, 5, f3);
    fioP := trim(f1) + ' ' + trim(f2) + ' ' + trim(f3);
    xlGetCellValue(str, 6,tmpDate);
    BornDate   := strToDate(trim(tmpDate),'DD.MM.YYYY');
    //message('В файле:'+tmpDate+', Преобразовали:'+strToDate(trim(tmpDate),'DD.MM.YYYY'));
    xlGetCellValue(str, 14, sVarStr);
    if (tabnum <> '')
    {
      ClearBuffer(#tmp111Import);
      //Найдем сотрудника и спопоб пополнения
      if (getfirst Persons where (('С' == Persons.IsEmployee and fioP == Persons.FIO and BornDate == Persons.BornDate (noindex) )) = tsOk)
      {
      } else
      {
        status := false;
        //Проверим, есть ли Persons без С
        if (getfirst Persons where ((fioP == Persons.FIO (noindex) and BornDate == Persons.BornDate (noindex) )) = tsOk)
          err:='Ошибка! '+fioP+' не является сотрудником предприятия!';
        else
          err:='Ошибка! Не найден сотрудник '+fioP + ' (колонки 3;4;5). Дата рождения: ' +BornDate+' (колонка 6)!';


      }
      //message('!'+catSposOpl+'!,!'+SposobOpl+'!');
      if  (getfirst VarStrah where ((catVarStr == VarStrah.cparent)) and UpCase(sVarStr) = UpCase(VarStrah.name) ) = tsOk
      {
        tmp111Import.cVarStr:= VarStrah.nrec;
        tmp111Import.VarStr := VarStrah.name;
      } else
      {
        status := false;
        err := err + ' Ошибка! Не найден вариант страхования по названию '+sVarStr+' (колонка 14)';
      }
      xlSetCellStringValue(err, str, 23, str, 23 );
      xlSetColumnWidth(50, str, 23, str, 23);
      if (status)
      {
        //Добавим строку в служебную таблицу
        tmp111Import.tabn := tabnum;
        tmp111Import.cPerson := Persons.nrec;
        tmp111Import.FIO := fioP;
        xlGetCellValue(str, 2,tmp111Import.NumPolis);
        xlGetCellValue(str, 7,tmpDate);
        tmp111Import.dBeg   := strToDate(trim(tmpDate),'DD.MM.YYYY');
        xlGetCellValue(str, 8,tmpDate);
        tmp111Import.dEnd   := strToDate(trim(tmpDate),'DD.MM.YYYY');
        xlGetCellValue(str, 16,tmp111Import.SummaV);
        xlGetCellValue(str, 17,tmp111Import.SummaSP);

        insert current tmp111Import;
      }
    }
    str++;
  //} while (val <> '');
  NextVisual;
  } while (tabnum <> '');
  puttabletodbf(#tmp111Import,'tmp111Import.dbf',ptfFullTable);
  xlGetWorkBooksCount(cntWB);
  xlSaveWorkBook(0);
  xlCloseWorkBook(1);
  xlKillExcel;
  OpenAndReadFile := status;
  StopVisual;
}

procedure LoadData; //Создание строк приказа по данным в таблице в памяти
{
  var npp:word;
  npp:= 1;
  if getfirst PartDoc where ((cPartDoc == PartDoc.nrec)) = tsOk
    if getfirst TitleDoc where ((PartDoc.cDoc == TitleDoc.nrec)) = tsOk
    {};
  StartNewVisual(vtNumericVisual, vfTimer,'Создание записей...', 0);
  _loop tmp111Import
  {
    ClearBuffer(#ContDoc);
    ContDoc.cPart := cPartDoc;
    ContDoc.NumPart := 1;
    ContDoc.wrec := npp;
    ContDoc.TypeOper := 111;
    ContDoc.Person := tmp111Import.cPerson;
    //Найдем назначение, действующее на дату приказа
    if (getlast Appointments where ((ContDoc.Person == Appointments.Person and 0 == Appointments.LPrizn and TitleDoc.DocDate >>= Appointments.AppointDate)) ) = tsOk
    {
      ContDoc.cStr := Appointments.nrec;
      ContDoc.cDopRef := Appointments.Department;
    }

    ContDoc.objType := 1;
    ContDoc.SeqNmb := 1;
    insert current ContDoc;


    ClearBuffer(#Raise);
    Raise.Person := tmp111Import.cPerson;
    //Raise.Sum := tmp111Import.SumComp;
    Raise.crDop := ContDoc.nrec;
    Raise.FromDate := tmp111Import.dBeg;
    Raise.ToDate := tmp111Import.dEnd;
    Raise.Sum := tmp111Import.SummaSP;
    var ParentSav : comp;
    ParentSav := coGetTune('UP.STAFF.PRIKAZ_PERS.DOPLATY.RPD111');
    if (ParentSav <> 0)
    {
      Raise.RaiseType := ParentSav;
    }
    insert current Raise;

    ClearBuffer(#RaiseHist);
    RaiseHist.cPsn := tmp111Import.cPerson;
    RaiseHist.cRaise := Raise.nrec;
    RaiseHist.wTypeOper := 9;
    //RaiseHist.RHSum := Raise.Sum;
    RaiseHist.RHSum := tmp111Import.SummaSP;
    RaiseHist.cContDoc := ContDoc.nrec;
    RaiseHist.DRec := tmp111Import.dBeg;
    RaiseHist.DDat2:= tmp111Import.dEnd;
    if (ParentSav <> 0)
    {
      RaiseHist.cRaiseType := ParentSav;
    }

    insert current RaiseHist;

    ClearBuffer(#GP_RaiseHistExt111);
    GP_RaiseHistExt111.cRaiseH := RaiseHist.nrec;
    GP_RaiseHistExt111.cPerson := tmp111Import.cPerson;
    GP_RaiseHistExt111.PolisDMS := tmp111Import.NumPolis;
    GP_RaiseHistExt111.DateBeg := tmp111Import.dBeg;
    GP_RaiseHistExt111.DateEnd := tmp111Import.dEnd;
    GP_RaiseHistExt111.cVarStrah := tmp111Import.cVarStr;
    GP_RaiseHistExt111.SummaVoz := tmp111Import.SummaV;
    insert current GP_RaiseHistExt111;

    npp++;
    NextVisual;
  }
  StopVisual;
  //Обновим описание приказа
  //update current titledoc set DocText := 'Компенсация стоимости гостиничных услуг (импорт из файла) '+Cur_Date;
}

  HandleEvent
    cmInit:
    {
      //Запросим имя файла Excel для импорта
      FName := GetFileName('*.xls;*.xlsx','Выберите файл Excel для импорта полисов ДМС...');
      //Откроем и проверим файл
      if OpenAndReadFile(FName)
      {
        //Загрузим данные файла в приказ
        LoadData;
        message('Импорт завершен успешно!');
      } else {

        message('При проверке файла обнаружены ошибки! См. файл, колонка 23.');
      }
    }
  End; //HandleEvent
end.
