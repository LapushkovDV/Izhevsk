#include userreport.vih

interface gp_vremperevod 'Параметры отчета' gray
Show at (,,43,5);

table struct tab1
(
tabnum: string,
fio: string,
podr: string,
podrnew: string,
datanach: date,
dataend: date,
prichina: string
)
with index
(
i1 = tabnum
)
;

create view gp_dvizh

var
counter, countermatrix: longint;
excelpath: string;
data1, data2: date;

select * from tab1;

screen scr ('Параметры отчета',,sci13Esc);
  fields
  data1, noprotect;
  data2, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    В период с:.@@@@@@@@@@  по:.@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  data1:= cur_date;
  data2:= cur_date;
}

cmGo:
{
StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

delete all from tab1;

  sql
  select persons.strtabn, persons.fio, c2.code, c1.code, appointments.appointdate, appointments.dateend, c3.name
  from appointments
  inner join persons on persons.nrec = appointments.person
  left join appointments a1 on a1.nrec = case when persons.appointcur = a1.nrec then persons.appointcur else persons.appointlast end
  left join catalogs c1 on c1.nrec = appointments.department
  left join catalogs c2 on c2.nrec = a1.department
  left join catalogs c3 on c3.nrec = appointments.typemove
  where appointments.lprizn = 70 and (appointments.dateend = 0 or appointments.dateend >= :(data1)) and appointments.appointdate <= :(data2)
  into tab1;

  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_vremperevod.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  xlsetcellstringvalue('ВРЕМЕННЫЕ ПЕРЕВОДЫ НА ПЕРИОД С ' + data1 + ' ПО ' + data2, 1, 1, 1, 1);

  counter:= 3;
  countermatrix:= 0;

  xlCreateMatrix(100, 7);

  _loop tab1
  {
    countermatrix++;
    xlStWriteToMatrix(countermatrix, 1, tab1.tabnum);
    xlStWriteToMatrix(countermatrix, 2, tab1.fio);
    xlStWriteToMatrix(countermatrix, 3, tab1.podr);
    xlStWriteToMatrix(countermatrix, 4, tab1.podrnew);
    xlDtWriteToMatrix(countermatrix, 5, tab1.datanach);
    xlDtWriteToMatrix(countermatrix, 6, tab1.dataend);
    xlStWriteToMatrix(countermatrix, 7, tab1.prichina);

    if countermatrix = 100
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  xlFreeMatrix;

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 2, 1, counter - 1, 7);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_vremperevod Implements IUserReport;
Interface UserReport_vremperevod;

Procedure Run;
Begin
  runinterface(gp_vremperevod);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Информация по временным переводам';
End;

Function GetGroupName (Level : Word) : String;
Begin
  #__UNUSED__(Level)
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
