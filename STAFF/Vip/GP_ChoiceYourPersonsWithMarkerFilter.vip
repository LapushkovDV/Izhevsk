#include ChoiseYourPersons.vih

#component "Z_STAFF"

#include GP_ChoiceYourPersonsWithMarkerFilter.vih
Interface GP_ChoiceYourPersonsWithMarkerFilter;

Var
  FilterMarker: TPtr;

Create view
Where FoundMarker(FilterMarker, TmpPersons.Nrec);


HandleEvent // Interface

cmOnVipLoad:
{
  Private::FilterMarker := InitMarker('', SizeOf(Comp), 10, 100, True);
}

cmOnVipUnload:
{
  DoneMarker(Private::FilterMarker, '');
}

End;


property GP_ObjChoiceYourPersonsWithMarkerFilter.FilterMarker: TPtr read Private::FilterMarker;

End.
