/*************************************************************************************************\
* Наименование:  Информация о сотрудниках работающих на текущую дату
* Приложение № 1 к распоряжению Госкорпорации <Роскосмос>                             *
* Контур/Модуль: Управление персоналом                                                            *
* Примечание:                                                                                     *
* Вид работы  |Номер          |Дата    |Исполнитель              |Проект                          *
* ----------------------------------------------------------------------------------------------- *
\*************************************************************************************************/

#include userreport.vih


interface gp_sotrudniki_ROSKOSMOS 'Приложение № 1 к распоряжению Госкорпорации <Роскосмос>' gray
Show at (,,26,5);

table struct tab1
(
        personsnrec : comp
      , appnrec     : comp
      , persfio     : string
      , persstrtabn : string
      , WorkPhone   : string
      , Postname    : string
      , postkod     : string
      , katpodrkod  : string
      , katpodrname : string

)
with index
(
i1 = persfio
)
;



create view

var
  excelpath : string;
  counter
, countermatrix: longint;
  data: date;

as select
 tab1.persfio
from
 tab1
;

screen scr ('Приложение № 1 к распоряжению Госкорпорации <Роскосмос>',,sci13Esc);
  fields
  data, noprotect;
 buttons
    cmGo, ,, 'Сформировать' ,,;
    <<

    На дату:.@@@@@@@@@@

    <.Сформировать.>

    >>
end;

handleevent

cmInit:
{
  data:= cur_date;
}

cmGo:
{
  StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Формирование отчета...', 1);

  delete all from tab1;

  sql
  select
        persons.nrec
      , appointments.nrec
      , persons.fio
      , persons.strtabn
      , WorkPhone.Phone
      , Post.name
      , postkod.code
      , katpodr.kod
      , katpodr.name
  from persons
  inner join appointments on appointments.person = persons.nrec and appointments.appointdate <= :(data) and (appointments.dismissdate >= :(data) or appointments.dismissdate = 0) and (appointments.lprizn = 0 or appointments.lprizn = 100)
  inner join extcatlinks on extcatlinks.staffcat = appointments.department
  inner join katpodr on katpodr.nrec = extcatlinks.extcat
  left join catalogs Post on Post.nrec = appointments.post
  left join attrnam anpost on anpost.wtable = 25031 and anpost.name = 'Профессия'
  left join attrval avpost on avpost.wtable = anpost.wtable and avpost.cattrnam = anpost.nrec and avpost.crec = post.nrec
  left join spkau postkod on postkod.nrec = avpost.vcomp
  outer apply (SELECT top 1 com.addr as phone from COMMUNICATIONS com JOIN Catalogs phone ON com.COMTYPE = Phone.nrec
                WHERE com.OBJTYPE = 2 AND phone.name = 'Рабочий номер' AND com.person = persons.nrec
              ) WorkPhone
// Профессия 25031
  where persons.strtabn <> '' and katpodr.name <> '_Профком' and katpodr.name <> '_Студенты' and katpodr.name <> '_Физические лица'
  and katpodr.name <> 'Ветераны' and persons.isemployee = 'С'
  into tab1
  ;


 stopvisual;
 StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Выгрузка в EXCEL', recordsintable(tntab1));
  ExcelPath:= TranslatePath('%ClientStartPath%');
  xlCreateExcelWithTemplate(ExcelPath+'XLS_ЭМ\Staff\gp_sotrudniki_ROSKOSMOS.xlsx',true);
  if (xlIsExcelValid) xlSetActiveWorkBookByName('1');

  counter:= 9;
  countermatrix:= 0;

  xlsetcellstringvalue('ИНФОРМАЦИЯ О СОТРУДНИКАХ РАБОТАЮЩИХ НА ' + data, 1, 1, 1, 1);

  xlCreateMatrix(1000, 8);

  _loop tab1
  {
    nextvisual;
    setvisualheader('Выгрузка в EXCEL'+
                     +''#13'' + tab1.persfio);
    countermatrix++;

    xlStWriteToMatrix(countermatrix, 1, tab1.persfio     );
    xlStWriteToMatrix(countermatrix, 2, chr(39) + tab1.persstrtabn );
    xlStWriteToMatrix(countermatrix, 3, tab1.WorkPhone   );
    xlStWriteToMatrix(countermatrix, 4, tab1.Postname    );
    xlStWriteToMatrix(countermatrix, 5, chr(39) + tab1.postkod     );
    xlStWriteToMatrix(countermatrix, 6, tab1.katpodrname );
    xlStWriteToMatrix(countermatrix, 7, chr(39) + tab1.katpodrkod  );



    if countermatrix = 1000
    {
      xlWriteMatrixToExcel(counter, 1);
      counter:= counter + countermatrix;
      xlClearMatrix;
      countermatrix:= 0;
    }
  }

  xlWriteMatrixToExcel(counter, 1);
  counter:= counter + countermatrix;
  xlFreeMatrix;

  xlframecells(1+2+4+8+16+32, 3, 1, 1, 9, 1, counter - 1, 7);

  StopVisual('',0);
  xlkillExcel;
}

end;
end.

VipInterface UserReport_gp_sotrudniki_ROSKOSMOS Implements IUserReport;
Interface UserReport_gp_sotrudniki_ROSKOSMOS;

Procedure Run;
Begin
  runinterface(gp_sotrudniki_ROSKOSMOS);
End;

Function GetReportName: String;
Begin
  GetReportName := 'Информация о сотрудниках. Приложение № 1 к распоряжению Госкорпорации <Роскосмос>';
End;

Function GetGroupName (Level : Word) : String;
Begin
  GetGroupName := '';
End;

function GetPriority : Integer;
begin
  GetPriority := 3;
end;

function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '';
  case Ind of
    1 : VisibleInModule := 'staffmainmenu';
  end;
end;

End.
