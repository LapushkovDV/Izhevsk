#ifndef __GP_SetPrVidOplRK__
#define __GP_SetPrVidOplRK__

#component "GP_STAFF"

type TGP_SetPrVidOplRK_Params = record
  cPers   : comp;   //Сотрудник
  cApp    : comp;   //Назначение
  wTable  : word;   //код таблицы источника
  cRec    : comp;   //нрек записи источника
  wVidUd  : word;   //системный код вида удержания
  wVidOpl : word;   //системный код вида оплаты
  dBeg    : date;   //дата начала выплаты
  dEnd    : date;   //дата окончания выплаты
  wSumType: word;   //вид суммы: 0-НДЕ, 1-валюта, 2-процент
  dSum    : double; //сумма разовой доплаты/удержания
  cVal    : comp;   //нрек валюты
  wChoice : word;   //признак 0 - доплата, 1 - удержание
  cContDoc: comp;   //нрек приказа
  nMnem   : string[40]; //наименование ведомости sys_mbf (если не задано - сформируется автоматически)
end;

objinterface GP_ISetPrVidOplRK;
  Function SetRR (_params: TGP_SetPrVidOplRK_Params): comp;
  Function DelRR (_params: TGP_SetPrVidOplRK_Params): comp;
end;

vipinterface GP_SetPrVidOplRK implements GP_ISetPrVidOplRK;

#end
