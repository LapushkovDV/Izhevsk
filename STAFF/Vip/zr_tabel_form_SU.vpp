procedure ZR_tabel_form_SU;
{


_loop KLREJIM
{
clearbuffer(#zr_rejim);
zr_rejim.rejim:=klrejim.rejim;
zr_rejim.Priznak:=klrejim.Filialno;
insert current zr_rejim;
}


_loop lschet
{
clearbuffer(#LschetPovt);
LschetPovt.strtabn:=lschet.strtabn;
LschetPovt.Nrec:=lschet.nrec;
LschetPovt.datpos:=lschet.datpos;
LschetPovt.datuv:=lschet.datuv;
LschetPovt.priznak:=0;
insert current LschetPovt;

	_loop Movelsc where ((lschet.nrec==movelsc.clschet))
	{
	clearbuffer(#LschetPovt);
	LschetPovt.strtabn:=lschet.strtabn;
	LschetPovt.Nrec:=lschet.nrec;
	LschetPovt.datpos:=movelsc.datpos;
	LschetPovt.datuv:=movelsc.datuv;
	LschetPovt.priznak:=100;
	LschetPovt.NrecMove:=movelsc.nrec;
	insert current LschetPovt;
	}
}


StartNewVisual(vtNumericVisual,vfTimer,'Формирование информации по табелям',1);

		_loop lstab where ((God==lstab.yearn and mesEnd>>=lstab.mesn and mesBeg<<=lstab.mesn(noindex))) and (ipOtlad=0 or (ipOtlad=1 and lstab.strtabn=strtabnOtlad))
		{
		nextvisual;
		datum1:=date(01,lstab.mesn,lstab.yearn);
		datum2:=sub_day(sub_months(date(01,lstab.mesn,lstab.yearn),-1),1);

			clearbuffer(#zr_tabel);
			zr_tabel.nrecLSTAB:=lstab.nrec;
			zr_tabel.strtabn:=lstab.strtabn;
			zr_tabel.clsch:=lstab.clschet;
			zr_tabel.tperson:=lstab.tperson;
			zr_tabel.tarif:=lstab.tarif;
			zr_tabel.kateg:=lstab.kateg;
			zr_tabel.CAPPOINT:=lstab.CAPPOINT;
			zr_tabel.SISOPL:=lstab.SISOPL;
			zr_tabel.CODTAR:=lstab.CODTAR;
			zr_tabel.RAZR:=lstab.RAZR;
			//zr_tabel.cexoz:=lstab.cexoz;
      zr_tabel.cexoz:=lstab.cex;
			zr_tabel.rejim:=lstab.rejim;
			zr_tabel.datan:=datum1;
			zr_tabel.datok:=datum2;
			zr_tabel.cschetd:=lstab.cschetd;
			zr_tabel.shpz:=lstab.param;
			insert current zr_tabel;


			_loop LschetPovt where ((Lstab.clschet==LschetPovt.nrec and 100==LschetPovt.Priznak))
			{
			clearbuffer(#zr_tabel);
			zr_tabel.nrecLSTAB:=lstab.nrec;
			zr_tabel.strtabn:=lstab.strtabn;
			zr_tabel.clsch:=lstab.clschet;
			zr_tabel.tperson:=lstab.tperson;
			zr_tabel.kateg:=lstab.kateg;
			//zr_tabel.cexoz:=lstab.cexoz;
      zr_tabel.cexoz:=lstab.cex;
			zr_tabel.CAPPOINT:=lstab.CAPPOINT;
			zr_tabel.tarif:=lstab.tarif;
			zr_tabel.SISOPL:=lstab.SISOPL;
			zr_tabel.CODTAR:=lstab.CODTAR;
			zr_tabel.RAZR:=lstab.RAZR;
			zr_tabel.rejim:=lstab.rejim;
			zr_tabel.datan:=datum1;
			zr_tabel.datok:=datum2;
			zr_tabel.cschetd:=lstab.cschetd;
			zr_tabel.shpz:=lstab.param;
			zr_tabel.priznakPovt:=100;
			zr_tabel.NrecMove:=lschetPovt.NrecMove;
			insert current zr_tabel;
			}
			


		}//loop lstab


		_loop zr_tabel
		{
			if getfirst LschetPovt where ((zr_tabel.clsch==LschetPovt.nrec and zr_tabel.PriznakPovt==LschetPovt.Priznak and zr_tabel.NrecMove==lschetPovt.NrecMove))=tsok
			{
					if LschetPovt.datpos<=zr_tabel.datok and LschetPovt.datpos>zr_tabel.datan
					{
					zr_tabel.datan:=LschetPovt.datpos;
					update current zr_tabel;
					}

					if LschetPovt.datuv<zr_tabel.datok and LschetPovt.datuv>=zr_tabel.datan
					{
					zr_tabel.datok:=LschetPovt.datuv;
					update current zr_tabel;
					}

					if LschetPovt.datuv<zr_tabel.datan and LschetPovt.datuv<>date(0,0,0) 
					{
					delete current zr_tabel;
					}

					if LschetPovt.datpos>zr_tabel.datok
					{
					delete current zr_tabel;
					}
			}//getfirst lschet
		}




Stopvisual('',0);



StartNewVisual(vtNumericVisual,vfTimer,'Обработка переходов в межпериод',1);

_loop zr_tabel
{
nextvisual;
		datum1:=zr_tabel.datan;
		datum2:=zr_tabel.datok;

	_loop perexod where ((zr_tabel.clsch==perexod.clsch))
	{
		if month(perexod.datizm)=month(datum1) and year(perexod.datizm)=year(datum1) //and perexod.strtabn=16923
		{
		nextvisual;
		clearbuffer(#zr_perexod);
		zr_perexod.nrecPerexod:=perexod.nrec;
		zr_perexod.strtabn:=perexod.strtabn;
		zr_perexod.clsch:=perexod.clsch;
		zr_perexod.kateg:=perexod.kateg;
		zr_perexod.CAPPOINT:=perexod.CAPPOINT;
		zr_perexod.SISOPL:=perexod.SISOPL;
		zr_perexod.tarif:=perexod.tarif;
		zr_perexod.CODTAR:=perexod.CODTAR;
		zr_perexod.RAZR:=perexod.RAZR;
		zr_perexod.cexoz:=perexod.cexp;
		zr_perexod.cschetd:=perexod.cschetd;
		zr_perexod.shpz:=perexod.param;
		zr_perexod.rejim:=perexod.rejim;
               if getfirst katpodr where ((zr_perexod.cexoz == katpodr.nrec)) = tsOK
{
!  message(katpodr.kod + '  ' + katpodr.name);
}
		zr_perexod.datan:=perexod.datizm;
		if (perexod.datok>datum2 or perexod.datok=date(0,0,0)) zr_perexod.datok:=datum2 else zr_perexod.datok:=perexod.datok;
		insert current zr_perexod;
		}


		if month(perexod.datok)=month(datum1) and year(perexod.datok)=year(datum1) //and perexod.strtabn=16923
		{
		nextvisual;
		clearbuffer(#zr_perexod);
		zr_perexod.nrecPerexod:=perexod.nrec;
		zr_perexod.clsch:=perexod.clsch;
		zr_perexod.strtabn:=perexod.strtabn;
		zr_perexod.kateg:=perexod.kateg;
		zr_perexod.CAPPOINT:=perexod.CAPPOINT;
		zr_perexod.SISOPL:=perexod.SISOPL;
		zr_perexod.tarif:=perexod.tarif;
		zr_perexod.CODTAR:=perexod.CODTAR;
		zr_perexod.RAZR:=perexod.RAZR;
		zr_perexod.cexoz:=perexod.cexp;
		zr_perexod.cschetd:=perexod.cschetd;
		zr_perexod.shpz:=perexod.param;
		zr_perexod.rejim:=perexod.rejim;
          if getfirst katpodr where ((zr_perexod.cexoz == katpodr.nrec)) = tsOK
{
!  message(katpodr.kod + '  ' + katpodr.name);
}
		zr_perexod.datok:=perexod.datok;
		if (perexod.datizm<datum1) zr_perexod.datan:=datum1 else zr_perexod.datan:=perexod.datizm;
		if getfirst zr_perexod1 where ((perexod.nrec==zr_perexod1.NrecPerexod))<>tsok insert current zr_perexod;
		}
	}//loop perexod
}//loop zr_tabel


!PutTableToDBF(#zr_perexod, 'D:\zr_perexod.dbf', ptfFullTable);


StopVisual('',0);

delete all from zr_perexod where zr_perexod.datok < zr_perexod.datan; // Изменение Казачек Д.В.

StartNewVisual(vtNumericVisual,vfTimer,'Разбиение по периодам',1);

_loop zr_perexod
{
nextvisual;
	if getfirst zr_tabel where ((zr_perexod.clsch==zr_tabel.clsch and zr_perexod.datan>>zr_tabel.datan and zr_perexod.datok<<zr_tabel.datok(noindex)))=tsok
	{
	VremOkon:=zr_tabel.datok;

	zr_tabel.datok:=sub_day(zr_perexod.datan,1);
	update current zr_tabel;
	zr_tabel.nrec:=0;
	zr_tabel.datan:=sub_day(zr_perexod.datok,-1);
	zr_tabel.datok:=VremOkon;
	insert current zr_tabel;




	clearbuffer(#zr_tabel1);
	zr_tabel1.NrecLSTAB:=zr_tabel.NrecLSTAB;
	zr_tabel1.strtabn:=zr_tabel.strtabn;
	zr_tabel1.clsch:=zr_tabel.clsch;
	zr_tabel1.kateg:=zr_perexod.kateg;
	zr_tabel1.CAPPOINT:=zr_perexod.CAPPOINT;
	zr_tabel1.SISOPL:=zr_perexod.SISOPL;
	zr_tabel1.tarif:=zr_perexod.tarif;
	zr_tabel1.CODTAR:=zr_perexod.CODTAR;
	zr_tabel1.RAZR:=zr_perexod.RAZR;
	zr_tabel1.cexoz:=zr_perexod.cexoz;
	zr_tabel1.cschetd:=zr_perexod.cschetd;
	zr_tabel1.shpz:=zr_perexod.shpz;
	zr_tabel1.sex:=zr_perexod.sex;
	zr_tabel1.rejim:=zr_perexod.rejim;
	zr_tabel1.paramRejim:=zr_perexod.paramRejim;
	zr_tabel1.datan:=zr_perexod.datan;
	zr_tabel1.datok:=zr_perexod.datok;
	zr_tabel1.tperson:=zr_tabel.tperson;
	insert current zr_tabel1;
	delete current zr_perexod;
	}



	if getfirst zr_tabel where ((zr_perexod.clsch==zr_tabel.clsch and zr_perexod.datan==zr_tabel.datan and zr_perexod.datok<<zr_tabel.datok(noindex)))=tsok
	{
	zr_tabel.datan:=sub_day(zr_perexod.datok,-1);
	update current zr_tabel;

	clearbuffer(#zr_tabel1);
	zr_tabel1.NrecLSTAB:=zr_tabel.NrecLSTAB;
	zr_tabel1.strtabn:=zr_tabel.strtabn;
	zr_tabel1.clsch:=zr_tabel.clsch;
	zr_tabel1.kateg:=zr_perexod.kateg;
	zr_tabel1.cexoz:=zr_perexod.cexoz;
	zr_tabel1.CAPPOINT:=zr_perexod.CAPPOINT;
	zr_tabel1.SISOPL:=zr_perexod.SISOPL;
	zr_tabel1.tarif:=zr_perexod.tarif;
	zr_tabel1.CODTAR:=zr_perexod.CODTAR;
	zr_tabel1.RAZR:=zr_perexod.RAZR;
	zr_tabel1.cschetd:=zr_perexod.cschetd;
	zr_tabel1.shpz:=zr_perexod.shpz;
	zr_tabel1.sex:=zr_perexod.sex;
	zr_tabel1.rejim:=zr_perexod.rejim;
	zr_tabel1.paramRejim:=zr_perexod.paramRejim;
	zr_tabel1.datan:=zr_perexod.datan;
	zr_tabel1.datok:=zr_perexod.datok;
	zr_tabel1.tperson:=zr_tabel.tperson;
	insert current zr_tabel1;

	if zr_tabel1.cexoz=0 zr_tabel1.cexoz:=zr_tabel.cexoz;
	if zr_tabel1.rejim=0 zr_tabel1.rejim:=zr_tabel.rejim;
	if zr_tabel1.kateg=0 zr_tabel1.kateg:=zr_tabel.kateg;
	if zr_tabel1.cappoint=0 zr_tabel1.cappoint:=zr_tabel.cappoint;
	if zr_tabel1.codtar=0 zr_tabel1.codtar:=zr_tabel.codtar;
	if zr_tabel1.sisopl=0 zr_tabel1.sisopl:=zr_tabel.sisopl;
	if zr_tabel1.tarif=0 zr_tabel1.tarif:=zr_tabel.tarif;
	if zr_tabel1.razr=0 zr_tabel1.razr:=zr_tabel.razr;
	if zr_tabel1.shpz='' zr_tabel1.shpz:=zr_tabel.shpz;
	if zr_tabel1.cschetd='' zr_tabel1.cschetd:=zr_tabel.cschetd;
	update current zr_tabel1;

	delete current zr_perexod;
	}



	if getfirst zr_tabel where ((zr_perexod.clsch==zr_tabel.clsch and zr_perexod.datan>>zr_tabel.datan and zr_perexod.datok==zr_tabel.datok(noindex)))=tsok
	{
	zr_tabel.datok:=sub_day(zr_perexod.datan,1);
	update current zr_tabel;

	clearbuffer(#zr_tabel1);
	zr_tabel1.NrecLSTAB:=zr_tabel.NrecLSTAB;
	zr_tabel1.strtabn:=zr_tabel.strtabn;
	zr_tabel1.clsch:=zr_tabel.clsch;
	zr_tabel1.kateg:=zr_perexod.kateg;
	zr_tabel1.CAPPOINT:=zr_perexod.CAPPOINT;
	zr_tabel1.SISOPL:=zr_perexod.SISOPL;
	zr_tabel1.tarif:=zr_perexod.tarif;
	zr_tabel1.CODTAR:=zr_perexod.CODTAR;
	zr_tabel1.RAZR:=zr_perexod.RAZR;
	zr_tabel1.cexoz:=zr_perexod.cexoz;
	zr_tabel1.cschetd:=zr_perexod.cschetd;
	zr_tabel1.shpz:=zr_perexod.shpz;
	zr_tabel1.sex:=zr_perexod.sex;
	zr_tabel1.rejim:=zr_perexod.rejim;
	zr_tabel1.paramRejim:=zr_perexod.paramRejim;
	zr_tabel1.datan:=zr_perexod.datan;
	zr_tabel1.datok:=zr_perexod.datok;
	zr_tabel1.tperson:=zr_tabel.tperson;
	insert current zr_tabel1;
	delete current zr_perexod;
	}


	if getfirst zr_tabel where ((zr_perexod.clsch==zr_tabel.clsch and zr_perexod.datan==zr_tabel.datan and zr_perexod.datok==zr_tabel.datok))=tsok
	{
	if zr_perexod.rejim<>0 	zr_tabel.rejim:=zr_perexod.rejim;
	if zr_perexod.paramrejim<>0 zr_tabel.paramRejim:=zr_perexod.paramRejim;
	if zr_perexod.cschetd<>'' zr_tabel.cschetd:=zr_perexod.cschetd;
	if zr_perexod.shpz<>'' zr_tabel.shpz:=zr_perexod.shpz;
	if zr_perexod.kateg<>0 zr_tabel.kateg:=zr_perexod.kateg;
	if zr_perexod.cexoz<>0 zr_tabel.cexoz:=zr_perexod.cexoz;
	if zr_perexod.cappoint<>0 zr_tabel.cappoint:=zr_perexod.cappoint;
	if zr_perexod.codtar<>0 zr_tabel.codtar:=zr_perexod.codtar;
	if zr_perexod.sisopl<>0 zr_tabel.sisopl:=zr_perexod.sisopl;
	if zr_perexod.tarif<>0 zr_tabel.tarif:=zr_perexod.tarif;
	if zr_perexod.razr<>0 zr_tabel.razr:=zr_perexod.razr;
	update current zr_tabel;
	delete current zr_perexod;
	}

}
StopVisual('',0);


StartNewVisual(vtNumericVisual,vfTimer,'Подстановка незаполненных значений',1);

_loop zr_tabel ordered by datan
{
nextvisual;
	if zr_tabel.cexoz=0
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.cexoz:=zr_tabel1.cexoz;
		update current zr_tabel;
		}
	}

	if zr_tabel.rejim=0
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.rejim:=zr_tabel1.rejim;
		update current zr_tabel;
		}
	}

	if zr_tabel.kateg=0
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.kateg:=zr_tabel1.kateg;
		update current zr_tabel;
		}
	}

	if zr_tabel.cschetd=''
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.cschetd:=zr_tabel1.cschetd;
		update current zr_tabel;
		}
	}

	if zr_tabel.shpz=''
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.shpz:=zr_tabel1.shpz;
		update current zr_tabel;
		}
	}

	if zr_tabel.cappoint=0
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.cappoint:=zr_tabel1.cappoint;
		update current zr_tabel;
		}
	}

	if zr_tabel.codtar=0
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.codtar:=zr_tabel1.codtar;
		update current zr_tabel;
		}
	}

	if zr_tabel.sisopl=0
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.sisopl:=zr_tabel1.sisopl;
		update current zr_tabel;
		}
	}

	if zr_tabel.tarif=0
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.tarif:=zr_tabel1.tarif;
		update current zr_tabel;
		}
	}

	if zr_tabel.razr=0
	{
		if getfirst zr_tabel1 where ((zr_tabel.clsch==zr_tabel1.clsch and sub_day(zr_tabel.datan,1)==zr_tabel1.datok))=tsok
		{
		zr_tabel.razr:=zr_tabel1.razr;
		update current zr_tabel;
		}
	}



}

StopVisual('',0);


StartNewVisual(vtNumericVisual,vfTimer,'Подсчет часов',1);



_loop zr_tabel
{
nextvisual;

	if getfirst zr_rejim where ((zr_tabel.rejim==zr_rejim.rejim))=tsok
	{
	zr_tabel.priznak:=zr_rejim.priznak;
	update current zr_tabel;
	}
	
	if zr_tabel.priznak<>52 continue;


    if LoadWorkingTable(zr_tabel.cLSch, month(zr_tabel.datan), year(zr_tabel.datan)) = 0
      {
        zr_tabel.PlanCh := WT_GHBD(hkWorking, 0, 0, stPlanned, zr_tabel.datan, zr_tabel.datok);// - WT_GetAbsencesHours(stActual, 'НВ', datNach1, DatNach2);
        zr_tabel.chasf  := WT_GHBD(hkWorking, 0, 0, stActual , zr_tabel.datan, zr_tabel.datok);
        zr_tabel.chasfPrazdn  := WT_GHBD(4, 0, 0, stActual , zr_tabel.datan, zr_tabel.datok);//праздничные
        update current zr_tabel;
      }

    if LoadWorkingTable(NrecLschet, month(zr_tabel.datan), year(zr_tabel.datan)) = 0
//    if LoadWorkingTable(zr_tabel.cLSch, month(zr_tabel.datan), year(zr_tabel.datan)) = 0
      {
        zr_tabel.PlanChPK := WT_GHBD(hkWorking, 0, 0, stPlanned, zr_tabel.datan, zr_tabel.datok);// - WT_GetAbsencesHours(stActual, 'НВ', datNach1, DatNach2);
!        zr_tabel.chasf  := WT_GHBD(hkWorking, 0, 0, stActual , zr_tabel.datan, zr_tabel.datok);
        update current zr_tabel;
      }


	if getfirst klndr where ((year(zr_tabel.datan)==klndr.yeark and month(zr_tabel.datan)==klndr.monthk and 1==klndr.rejim))=tsok
	{}

      i:=day(zr_tabel.datan);

	if getfirst lstab where ((zr_tabel.nrecLstab==lstab.nrec))=tsok
	{
	UmNorm:=0;
		do
		{
			if lstab.days[i]='У' or lstab.days[i]='ОТ' or lstab.days[i]='ОД' or lstab.days[i]='Б' or lstab.days[i]='ДО'  or lstab.days[i]='ПК' or lstab.days[i]='ПМ' or lstab.days[i]='К'  or lstab.days[i]='Д'  or lstab.days[i]='Г'  or lstab.days[i]='ОЖ' or lstab.days[i]='Р' or lstab.days[i]='КД'
			{
			UmNorm:=UmNorm+klndr.DAYCHAS[i]+klndr.DAYMIN[i]/60;
			}

			if 
			date(i,    month(zr_tabel.datan)   ,   year(zr_tabel.datan)    )  =  date(30,04,year(zr_tabel.datan))
			or date(i,month(zr_tabel.datan),year(zr_tabel.datan))=date(08,05,year(zr_tabel.datan))
			or date(i,month(zr_tabel.datan),year(zr_tabel.datan))=date(11,06,year(zr_tabel.datan))
			or date(i,month(zr_tabel.datan),year(zr_tabel.datan))=date(03,11,year(zr_tabel.datan))
			or date(i,month(zr_tabel.datan),year(zr_tabel.datan))=date(31,12,year(zr_tabel.datan))
			or date(i,month(zr_tabel.datan),year(zr_tabel.datan))=date(22,02,year(zr_tabel.datan))
			or date(i,month(zr_tabel.datan),year(zr_tabel.datan))=date(07,03,year(zr_tabel.datan))
			{
				if double(lstab.days[i])>0
				{
                                zr_tabel.ChasfPredPrazdn:=zr_tabel.ChasfPredPrazdn+1;
				}
			

			}


		i++;
		}
		while i<=day(zr_tabel.datok)
	zr_tabel.ChasfUN:=UmNorm;
	update current zr_tabel;
	}

	if getfirst katpodr where ((zr_tabel.cexoz==katpodr.nrec))=tsok
	{
	zr_tabel.kodCex:=substr(katpodr.kod,1,3);
	update current zr_tabel;
	}


	if getfirst lschet where ((zr_tabel.clsch==lschet.nrec))=tsok
	{
		if getfirst persons where ((lschet.tperson==persons.nrec))=tsok
		{
		zr_tabel.fio:=persons.fio;
		update current zr_tabel;
		}
	}

}

StopVisual('',0);

delete zr_tabel where zr_tabel.priznak<>52;

!PutTableToDBF (#Zr_tabel,'\\tsclient\C\Users\Nikolai.Plinda\Desktop\TerminalFiles\Zr_tabelPoter.xls',ptfFullTable);



if (KodPodrazd_Option = 1) and (KodPodrazd<>'')
{

_loop zr_tabel
{
	if getfirst PodrZR where ((zr_tabel.cexoz==PodrZR.nrec))=tsok
	{
		if getfirst PodrZR_OZ where ((podrZR.cPodrOz==PodrZR_Oz.nrec))=tsok
		{
			if POdrZR_OZ.Kod<>KodPodrazd
			{					
			delete current zr_tabel;
			nextvisual;
			}
		}
	}
	else
	{
	delete current zr_tabel;
	nextvisual;
	}

!if zr_tabel.cexoz

}

}
}
