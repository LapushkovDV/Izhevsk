#doc
Кадровские функции
<p>1. Поиск и создание организации.

#end
//*********************************************
Interface GP_Staff_Func;
//*********************************************
#include GetKau.Var
var
  iAdrFunc : AddressFunc;            // Переменная типа интерфейс AddressFunc
  iCatFunc : CatalogsFunctions;  //функции каталогов
  LL       : KatOrgFuncs; //KatOrgFuncsObj;
  IPsnFuncs: PersonsFunctions;
  iStrFunc : StringFunctions;
  //-------------------------------
  ObjPhone,
  ObjEmail : word;
  //-------------------------------
  sLastError :string;
  //-------------------------------
  pVA_Persons_KatOrg :comp;//'Физическое лицо (контрагент)'; #219
  pVA_KatOrg_Persons :comp;//'.Сотрудник (ссылка на карточку)'; #219.#30
  //-----------------------------
  pVA_KatOrg_Create_Pers  :comp;// 'Создано, Сотрудник';
  pVA_KatOrg_Create_Date  :comp;// 'Создано, Дата';
  pVA_KatOrg_Create_Time  :comp;// 'Создано, Время';

//*********************************************
create view
var
  pPersons:comp;
  pKatOrg :comp;
  pKatOrgDescrMain:comp;//ссылка на группу организаций
  sKatState:string;
  pMemo:comp;
as select Persons.Nrec
From
    Persons
  , KatOrg
  , KatOrg KatOrg2
  , AllMemo AllMemoOrg
  , KatOrgDescr KatOrgDescrMain
  , KatOrgDescr
  , PODRINFO
  , AddressN
  , Communications
  , PASSPORTS
  //-----------------
  , Appointments
  , lschet
  , Shtraf
  , KlVidud
  , KatOrg KatOrg_LS
  , KatBank KatBank_LS
  , KatBank KatBank_Shtraf
  //----------  мемо поле ----------------------
  , DocInfo
  , AttrVal
  , Notes
  , APPENDIX

where
((
      pPersons == Persons.Nrec
  //--- карточка сотрудника
  and Persons.PasspRus        == Passports.NRec
  and Persons.PasspAddr       == AddressN.Nrec
  and Persons.Nrec == Communications.Person
  and if(Persons.AppointCur=0, Persons.AppointLast,Persons.AppointCur) == Appointments.Nrec
  //----------------------
  and Appointments.cAddNrec2 == Lschet.Nrec
  and lschet.cpodr           == KatOrg_LS.Nrec
  and lschet.ClschDop        == KatBank_LS.Nrec
  and lschet.nrec            == Shtraf.cLsch
  and Shtraf.vidud           == KlVidUd.Vidud
  and SHTRAF.CBANKPOL        == KATBANK_Shtraf.NREC

  //-- организация
  and pKatOrg == KatOrg.Nrec
  and pKatOrgDescrMain     == KatOrgDescrMain.Nrec
  and KatOrgDescrMain.Code == KatOrgDescr.Code
  and KatOrg.Nrec          == KatOrgDescr.cRec
  and KatOrgDescr.Nrec     == KontrIer.cRecDs
  and KatOrg.Nrec          == PODRINFO.CPODR
  //Z_STAFF::RECWIN13.SCRBANKDETAILS.KATBANK.NAME'
  and KatOrg.Nrec          == KatBank.cOrg

  //==========================
  and sKatState == KatState.Nrec
  //==========================
  and coKatOrg          == AllMemoOrg.wTable
  and KatOrg.Nrec       == AllMemoOrg.cRec

  and '00000'              == KatOrg2.Code
  //===========================
  and pMemo == Notes.Nrec
  and pMemo == APPENDIX.Nrec
  and pMemo == ALLMEMO.Nrec
  and pMemo == PrMEMO.Nrec

));

File MemoFile;

//=====================================
Constructor Init;
{ Result:=True;
  pKatOrgDescrMain:=coGetTune('UP.STAFF.RECEPTION.GP_KATORGGROUP');//'Группа контрагентов для автосоздания организации');
  //-------------------------
  pVA_Persons_KatOrg:=ExtAttr_ID(coPersons,VA_Persons_KatOrg);
  pVA_KatOrg_Persons:=ExtAttr_ID(coKatOrg ,VA_KatOrg_Persons);//'Сотрудник (ссылка на карточку)'); #219
  //-------------------------
  pVA_KatOrg_Create_Pers  :=ExtAttr_ID(coKatOrg , VA_KatOrg_Create_Pers);//  , cgAttrType_Comp, cgKatKau_Table , cgKau_Persons);// 'Создано, Сотрудник';
  pVA_KatOrg_Create_Date  :=ExtAttr_ID(coKatOrg , VA_KatOrg_Create_Date);//  , cgAttrType_Date);// 'Создано, Дата';
  pVA_KatOrg_Create_Time  :=ExtAttr_ID(coKatOrg , VA_KatOrg_Create_Time);//  , cgAttrType_Time);// 'Создано, Время';
  //-------------------------

  ObjPhone := 2;
  ObjEmail := 3;
  if getfirst KatOrgDescrMain<>tsok
  { Message('Проверьте настройку UP.STAFF.RECEPTION.GP_KATORGGROUP');
  }
} //constructor Init;

//=====================================
Function GetLastError:string;
{ Result:=sLastError;

} //Function GetLastError:string;


//=====================================
Function GetLastKatOrgCode(sCode : string) : string;
var
  wLen  : word;
{
  wLen := Length(sCode) + 1;

  if (wLen < 20)
    if (GetLast KatOrg2 where ((PadCH('1', '0', wLen)                   <<= KatOrg2.Code AND
                                PadCH(PadCH('', '9', wLen), ''#255, 20) >>= KatOrg2.Code AND
                                (wLen = length(KatOrg2.Code)) )) = tsOk)
      sCode := GetLastKatOrgCode(KatOrg2.Code);

  GetLastKatOrgCode := sCode;
} //Function GetLastKatOrgCode(sCode : string) : string;

//=====================================
Function GetNextKatOrgCode : string;
var NumPP : string;
{ if ( GetLast fastfirstrow KatOrg2 ordered by KatOrg2.Code = tsOk )
  { NumPP := GetLastKatOrgCode(KatOrg2.Code);
    if (NumPP = PadCh('', '9', Length(NumPP)))
        NumPP := '0' + NumPP;
    GetNextKatOrgCode := NextNumStr(NumPP);
  }
  else
    GetNextKatOrgCode := '000001';
}



//=====================================
#doc
   Поиск организации по ссылке на сотрудника, фио и дате рождения
#end
Function FindOrgByPers(
   _pPersons:comp
  ;_sFio  :string
  ;_dBornDate:Date
) : comp;
{ Result:=0;
  if _pPersons>0
  { pKatOrg:=coGetAttrID(coPersons,_pPersons,pVA_Persons_KatOrg);
    if Getfirst KAtorg=tsok
    { Result:=pKatOrg;
      exit;
    }
    pPersons:=_pPersons;
    if getfirst Persons=tsok
    { _SFio:=Persons.Fio;
      _dBornDate:=Persons.BornDate;
    }
  } //if _pPersons>0
  //'L_KATORG::KATORG.WKATORG.INDIVIDUALINFOEMBEDDED.L_KATORG::ORGANIZATIONINDIVIDUALINFO.SCINDIVIDUAL.DDATEOFBIRTH'
  var _kl_found:word=0;
  var _dDT :date=ZeroDate;
  _Loop KatOrg2 where (( _SFio == KatOrg2.Name ))
  { _kl_found++;
    Result:=KatOrg2.Nrec;
    if _dBornDate<>ZeroDate
    { _dDT:=dGetAttr(coKatOrg,  KatOrg2.Nrec, 'ФЛ. Дата рождения');
      _kl_found:=1;
      break;

    }
  }
  if _kl_found>1
  { message('Есть несколько записей в справочнике организаций'
     +chr(13)+_sFio
     +chr(13)+'Установите дату рождения в нужной записи!'
     );
    Result:=0;
  }
} //Function FindOrgByPers(

//=====================================
// Проверка есть ли такой Nrec
Function CheckKatOrgNrec(_pKatOrg:Comp):Comp;
{
  Result:=_pKatOrg;
  if _pKatOrg=0 then exit;
  pKatOrg:=_pKatOrg;
  if GetFirst KatOrg <> tsOk
      Result:=0; //Если уже есть, то обнулим
}//Function CheckKatOrgNrec(cOrgNrec:Comp):Comp;

//=====================================
// #219.#30
// установить связь между картотекой сотрудников и организацией
Procedure SetRef2Org(_pKatOrg:comp;_pPersons:comp);
{ if _pKatOrg=0 or _pPersons=0 then Exit;
  if coGetAttrID(coKatOrg,  _pKatOrg,pVA_KatOrg_Persons)<>_pPersons
  { coSetAttrID(coKatOrg,  _pKatOrg,pVA_KatOrg_Persons,_pPersons,ShowKau(cgKau_Persons,_pPersons));
  }
  if coGetAttrID(coPersons,_pPersons,pVA_Persons_KatOrg)<>_pKAtorg
  { coSetAttrID(coPersons,_pPersons,pVA_Persons_KatOrg,_pKatOrg,ShowKau(cgKau_KatOrg,_pKatOrg));
  }
} //Procedure SetRef2Org;

//=====================================
// Установка атрибутов организации
Procedure SetAttrOrg;
{
  //------------------
  // #219.#30
  SetRef2Org(KatOrg.Nrec,Persons.Nrec);
  //------------------
  KATORG.WTYPE  :=1;
  // можно и проще KatOrg.cPostAddr:=Persons.PasspAddr
  if KatOrg.cPostAddr=0
  { if getfirst AddressN=tsok
    {
      AddressN.ObjType:=3;
      AddressN.Nrec   :=GetNextNrec(#AddressN,0);
      AddressN.cPerson :=0;
      KatOrg.cPostAddr:=AddressN.Nrec;
      insert current AddressN;
    }
  }
  if (GetFirst Communications where (( Persons.Nrec == Communications.Person and
                                       ObjPhone     == Communications.ObjType (noindex)
                                          )) = tsOk )
      KATORG.TEL := Communications.Addr;
  if (GetFirst Communications where (( Persons.Nrec == Communications.Person and
                                       ObjEmail     == Communications.ObjType (noindex)
                                          )) = tsOk )
     KATORG.EMAIL := Communications.EMail;
  //---------------------------
  update current KatOrg;
  //---------------------------
  if getfirst Podrinfo<>0
  { ClearBuffer(#Podrinfo);
    PODRINFO.CPODR := KatOrg.Nrec;
    Insert current PODRINFO;
  }
  sSetAttr(coKatOrg,  KatOrg.Nrec, 'Полное наименование' ,KatOrg.Name); //

  sSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Фамилия' ,iStrFunc.Get_LastName (KatOrg.Name)); //
  sSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Имя'     ,iStrFunc.Get_FirstName(KatOrg.Name));//
  sSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Отчество',iStrFunc.GetPatronymic(KatOrg.Name));//
  //--------------------------------------
  doSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Статус налогоплательщика',1);//1 резидент, 2 не резидент
  coSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Адрес', Persons.PasspAddr, iAdrFunc.GetFullAddressInd(Persons.PasspAddr));
  //sSetAttr(coKatOrg ,  KatOrg.Nrec, 'ФЛ. Место рождения', iAdrFunc.GetFullAddressInd(Persons.BornAddr));

  sKatState :=iCatFunc.GetCatalogsName(Persons.Gr);
  if getfirst KatState=tsok
  { coSetAttr(coKatOrg, KatOrg.Nrec, 'ФЛ. Гражданство', KatState.NRec, KatState.Name);
  }
  //-------------------------------
  dSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Дата рождения'            , Persons.BornDate);
  if getfirst Passports=tsok
  { sSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Документ. Серия'          , trim(Passports.Ser));
    sSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Документ. Номер'          , trim(Passports.Nmb));
    dSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Документ. Дата выдачи'    , Passports.GivenDate);
    sSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Документ. Номер'          , trim(Passports.Nmb));
    sSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Документ. Код вида', iCatFunc.GetCatalogsCode(Passports.DocName));
    sSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Документ. Вид'     , iCatFunc.GetCatalogsName(Passports.DocName));
    sSetAttr(coKatOrg,  KatOrg.Nrec, 'ФЛ. Документ. Выдан'          , trim(Passports.GivenBy));
  } //if getfirst Passports=tsok

  //----------------------
  // запишем, кто создал
  if coGetAttrID(coKatOrg, KatOrg.nrec, pVA_KATOrg_Create_Pers)=0
    coSetAttrID(coKatOrg, KatOrg.nrec, pVA_KATOrg_Create_Pers, GetPersonsByUser(0), sGetTune('User.Fio'));
  if dGetAttrID (coKatOrg, KatOrg.nrec, pVA_KatOrg_Create_Date )=ZeroDate
    dSetAttrID (coKatOrg, KatOrg.nrec, pVA_KatOrg_Create_Date, Cur_Date );
  if tGetAttrID(coKatOrg,  KatOrg.Nrec,pVA_KatOrg_Create_Time)=ZeroTime
     tSetAttrID (coKatOrg, KatOrg.nrec, pVA_KatOrg_Create_Time, Cur_Time );

} //Procedure SetAttrDop(ww_table:word);


//=====================================
Procedure MakeKatOrgDescr;
{
  if getfirst KatOrgDescr<>0
  { ClearBuffer(#KatOrgDescr);
    KatOrgDescr.Code   := KatOrgDescrMain.Code;
    KatOrgDescr.cGroup := KatOrgDescrMain.Nrec;
    KatOrgDescr.isLeaf := 1;
    KatOrgDescr.cRec := KatOrg.Nrec;
    KatOrgDescr.Name := KatOrg.Name;
    KatOrgDescr.ShortName := KatOrg.ShortName;

    if (Insert current KatOrgDescr = tsOk){}
      LL.InsertAllIerdescrEx(KatOrgDescr.NRec, KatOrgDescr.Name, KatOrgDescr.ShortName);
  }
} //Procedure MakeKatOrgDescr;

//=====================================
#doc
   Создание расчетного счета
#end
Function MakeKatBank:boolean;
{ Result:=false;
  //if getfirst KAtBank=tsok then exit;
  _Loop fullcache Appointments
  {  _Loop fullcache Lschet
    { _Loop fullcache KatBank_Ls
      { var _schet1:string=Lschet.pasport;
        if _schet1=''
          _schet1:=Lschet.NomCard ;
        if getfirst KatBank where (( KatOrg.nrec == KatBank.cOrg
           and KatBank_Ls.Name == KatBank.Name
           and ( _schet1='' or KatBank.Schet1=_schet1)
            ))=tsok
        {  continue;
        }
        KatBank_Ls.Nrec:=0;
        KatBank_LS.cOrg:=KatOrg.Nrec;
        KATBANK_LS.AKTIV:=1;// по умолчанию
        KatBank_Ls.Schet1:=_Schet1;
        Insert Current KatBank_LS;
        if getfirst KatBank where (( KatOrg.nrec == KatBank.cOrg
           and 1 == KATBANK.AKTIV
           and (KATBANK_LS.Nrec<>KATBANK.Nrec)
            ))=tsok
        { update current KatBank set KATBANK.AKTIV:=0;
        }
        break;
      } //_Loop fullcache KatBank_Ls
      _Loop fullcache Shtraf
      { var _schet1:string=SHTRAF.NOMLSH;
        if _schet1<>''
        { if _schet1=Lschet.pasport then continue;
        }
        else
        { _schet1:=SHTRAF.NOMCARD;
          if _schet1=Lschet.NomCard then continue;
        }
        if _schet1='' then continue;
        _Loop fullcache KlVidud
        { if klvidud.VHVO3 <> '0' then continue; //только перечисление!
          _Loop fullcache KatBank_Shtraf
          { if getfirst KatBank where (( KatOrg.nrec == KatBank.cOrg
              and KatBank_Shtraf.Name == KatBank.Name
              and ( _schet1='' or KatBank.Schet1=_schet1)
               ))=tsok
            {  continue;
            }
            KatBank_Shtraf.Nrec:=0;
            KatBank_Shtraf.cOrg:=KatOrg.Nrec;
            KatBank_Shtraf.Schet1:=_Schet1;
            KATBANK_Shtraf.AKTIV:=0;// рабочий
            Insert Current KatBank_Shtraf;
            break;
          } //_Loop KatBank_Shtraf
          break;
        } //_Loop KlVidopl
      } //_Loop Shtraf
      break;
    } //_Loop Lschet
    break;
  } //_Loop Appointments
  Result:=true;
} //Function MakeKatBank:boolean;
//=====================================
#doc
   Создание организации по ссылке на сотрудника
#end
Function CheckKatOrgByPers(
   _pPersons:comp
  ;_need_create :boolean
  ;_boMes       :boolean=True
) : comp;
var isInsert : boolean;
    sPrefiks : string;
//    sPrefiksName: string;
//    jk:word;
{ Result:=0;
  sLastError:='';
  if _pPersons=0
  { sLastError:='Ошибка поиска сотрудника';
    if _boMes Message(sLastError);
    exit;
  }
  pPersons:=_pPersons;
  if GetFirst Persons <> tsOk then
  { sLastError:='Некорректная ссылка на сотрудника '+String(_pPersons,0,0);
    if _boMes Message(sLastError);
    Exit;
  }
  if Persons.Fio=''
  { sLastError:='Не введено ФИО сотрудника';
    if _boMes Message(sLastError);
    exit;
  }
  //Persons.GALDEPHOST; - можно сюда
  //CompSrc\Z\Z_Staff\vip\PrikPsn.vip - но наверное там это филиал
  pKatOrg:=FindOrgByPers(_pPersons,'',ZeroDate);
  if pKatOrg>0
  if (GetFirst FastFirstRow KatOrg  = tsOk )
  { if trim(locase(Katorg.Name))<>trim(locase(Persons.Fio))
    { sLastError:='Не совпадает ФИО сотрудника : '+Persons.Fio
        +chr(13)+'c контрагентом : '+KatOrg.Name;
      if _boMes Message(sLastError);
      exit;
    }
    //------------------
    // #219.#30
    SetRef2Org(KatOrg.Nrec,Persons.Nrec);
    //------------------------
    Result:=KatOrg.Nrec;
    if KatOrg.UNN  = ''
    and IPsnFuncs.GetUniqueTaxNumber(Persons.Nrec) <> ''
     then
      {
        sLastError := 'Обновили ИНН c '+KatOrg.UNN+' на ' + IPsnFuncs.GetUniqueTaxNumber(Persons.Nrec);
        set KatOrg.UNN := IPsnFuncs.GetUniqueTaxNumber(Persons.Nrec);
        update current KatOrg;
      }
    sLastError:='организация '+KatOrg.Name + ' уже существует. ' + sLastError;
    exit;
  } //if (GetFirst FastFirstRow KatOrg  = tsOk )
  if not _need_create then exit;

  //- не заполняется U_AbitStudKontr.cStudent     piU_CreateContr.CreateContr(U_Student.cPersons)

  isInsert := False;
  sPrefiks := '';

  while not isInsert do
  {
     timelog('GP_Staff_Func->CheckKatOrg: создаем запись '+Persons.Fio);
     ClearBuffer(#KatOrg);
     KatOrg.Nrec := 0; //Если задали на входе, то можно и присвоить
     KatOrg.Name := Persons.FIO;
     KatOrg.ShortName := Persons.FIO;
     KatOrg.UNN  := sPrefiks+IPsnFuncs.GetUniqueTaxNumber(Persons.Nrec)+if(length(sPrefiks)>0,'.','');
     KatOrg.TIPORG := '';
     KATORG.WTYPE  :=1;
     if ( Insert current KatOrg = tsOk )
     { SetAttrOrg;
       MakeKatOrgDescr;
       MakeKatBank;
       sLastError:='организация "'+KatOrg.Name + '" создана';
       //Пусть 0 создали, Result:=KatOrg.Nrec;
       break;
     }
     sPrefiks := sPrefiks + ' ';
     if (Length(sPrefiks) >10)
     {
       isInsert := true;
     }
  } //while not isInsert do
}//Function CreateOrgByPers(

//=====================================
#doc
   Обновление данных по организации
   При отсутствии связи - обязательное условие - полное совпадение ФИО.
#end
Function UpdateOrgFromPersons(_PKatOrg:comp):boolean;
{ Result:=True;
  set pKatOrg :=_pKatOrg;
  if getfirst KatOrg<>tsok then
  { sLastError:='Не нашли запись в KatOrg по nrec='+String(pKatOrg,0,0);
    exit;
  }
  var _pPersons:comp=coGetAttrId(coKatOrg,_PKatOrg,pVA_KatOrg_Persons );

  if _pPersons=0 //поищем встречный ВА
  { _Try
    { SQL
        select Attrval.cRec From AttrVal
        where //Attrval.wTable   = :(coPersons) //coPersons
              Attrval.cAttrNam = :(pVA_Persons_KatOrg)
        and   Attrval.vComp    = :(_PKatOrg)
        into (_pPersons);
        if _pPersons<>0
        { coSetAttrId(coKatOrg,_PKatOrg,pVA_KatOrg_Persons,_pPersons,ShowKau(cgKau_Persons,_pPersons) )
        }
    }
    _Except
    else
    {

    }
  }
  if _pPersons=0
  { if getfirst Persons where ((
          'С' <<= Persons.IsEmployee
      and 'У' >>= Persons.IsEmployee
      and KatOrg.name == Persons.Fio(noindex)
      ))<>tsok
    { sLastError:='В картотеке сотрудников нет '+KatOrg.Name;
       exit;
    }
    _pPersons:=Persons.Nrec;
    if getnext Persons where ((
          'С' <<= Persons.IsEmployee
      and 'У' >>= Persons.IsEmployee
      and KatOrg.name == Persons.Fio(noindex)
      ))=tsok
    { sLastError:='В картотеке сотрудников есть несколько '+KatOrg.Name;
      if iGetKau.GetCodeKau(cgiPick,cgKau_Persons,_pPersons)=0
      { exit;
      }
    }
  } //if _pPersons=0
  if _pPersons=0 then exit;
  set pPersons:=_pPersons;
  if getfirst Persons<>tsok then
  { sLastError:='Не нашли запись в Persons по nrec='+String(pPersons,0,0);
    exit;
  }
  SetAttrOrg;
  MakeKatBank;
  Result:=True;

} //Function UpdateOrgFromPersons(_PKatOrg:comp):boolean;


//=====================================
#doc
 Проинициализировать мемо поле
#end
function InitMem(_wtable :word ; _cRec: Comp): Boolean;
{ pMemo:=_cRec;
  InitMem := false;
  //---------------------------
  case _wtable of
  //---------------------------
  coDocInfo :
  { if GetFirst  fastfirstrow DocInfo = tsOK
    { if MemoFile.OpenMemo(DocInfo.TEXTDATA)
      { MemoFile.Seek(0);
        InitMem := true;
      }
    }
  }
  coPrMemo :
  { if GetFirst  fastfirstrow PrMemo = tsOK
    { if MemoFile.OpenMemo(PrMemo.Info)
      { MemoFile.Seek(0);
        InitMem := true;
      }
    }
  }
  coNotes :
  { if GetFirst  fastfirstrow Notes = tsOK
    { if MemoFile.OpenMemo(Notes.NOTE)
      { MemoFile.Seek(0);
        InitMem := true;
      }
    }
  }
  coAttrVal:{
   if GetFirst  fastfirstrow AttrVal = tsOK
    { if MemoFile.OpenMemo(AttrVal.VLVAR)
      { MemoFile.Seek(0);
        InitMem := true;
      }
    }
  }
  coAPPENDIX:
  { if GetFirst  fastfirstrow APPENDIX = tsOK
    { if MemoFile.OpenMemo(APPENDIX.CONTENTS)
      { MemoFile.Seek(0);
        InitMem := true;
      }
    }
  }
  coALLMEMO:
  { if GetFirst  fastfirstrow ALLMEMO = tsOK
    { if MemoFile.OpenMemo(ALLMEMO.Mem)
      { MemoFile.Seek(0);
        InitMem := true;
      }
    }
  }
  end ;

} //function InitMem(_wtable :word ; _cRec: Comp): Boolean;

//=====================================
#doc
закрыть мемополе
#end
procedure DoneMemo(_wtable:word=0;need_upd:boolean=false);
var wwTsok:longint;
{
  MemoFile.Close;
  wwTsok:=-1;
  if need_upd and _wtable>0
  case _wtable of
  coDocInfo : wwTsok:=update current DocInfo;
  coPrMemo  : wwTsok:=update current PrMemo;
  coNotes   : wwTsok:=update current Notes;
  coAttrVal : wwTsok:=update current AttrVal;
  coAPPENDIX: wwTsok:=update current APPENDIX;
  coALLMEMO : wwTsok:=update current ALLMEMO;
  end;

} //procedure DoneMemo(_wtable:word=0;need_upd:boolean=false);

//=====================================
function GetAllStringFromMemo(_wtable :word ; _cRec: Comp;var S: String): Boolean;
var s1 :string ;
{ Result:=false ;
  S:='';
  if not InitMem(_wtable,_cRec) then exit;
  while not MemoFile.EOF
  { MemoFile.Readln(s1);
    S:=S+if(Length(S)>0,+ chr(13) +chr(10),'')+ s1 ;
  }
//logstrtofile('!attrmemmo.log','1 '+nmattr+'/'+string(_wtable)+'/'+string(_cRec)+'/'+s)
  Result := true;
  MemoFile.Close;
} //function GetAllStringFromMemo(_wtable :word ; _cRec: Comp;var S: String): Boolean;

//=====================================
#doc
 InitMemo(coPrMemo, PrMemo.nrec);
 var _s:string;
 do
 { if  not GetOneStringFromMemo(_s) then break
 } while True
 DoneMemo;
#end
function GetOneStringFromMemo(var S: String): Boolean;
{ Result := false;
  S := '';
  if not MemoFile.EOF
  {
    MemoFile.Readln(S);
    Result := true;
  }
} //function GetOneStringFromMemo(_wtable :word ; _cRec: Comp;var S: String): Boolean;

end.
