#include FeeSigners.vih
#include StrFunc.vih           // Функции работы со строками
#include CatFunc.vih           // Функции работы с Catalogs

interface GP_NFormRD209;

#include FeeSigners.var
var cPartDoc:comp;
    sSigners:string;
    iStrFunc:StringFunctions;
    iCatFunc:CatalogsFunctions;

create view
from
  PartDoc,ContDoc,
  Persons,Appointments,RaiseHist,Education,
  Notes,PrMemo,KatOrg,Catalogs
where((
      cPartDoc       == PartDoc.NRec
  and PartDoc.NRec   == ContDoc.cPart
  and ContDoc.Person == Persons.NRec
  and ContDoc.cStr   == Appointments.NRec
  and ContDoc.NRec   == RaiseHist.cContDoc
  and ContDoc.Person == Education.Person
  //---  Шапка приказа
  and    cPartDoc == PrMemo.cDoc
  and    2 == PrMemo.wRef

));

parameters cPartDoc;

form Frm('GP_NFormRD209.out','GP_NFormRD209');

function GetShortFIO(FIO:string):string;
{
  result:=SubStr(iStrFunc.Get_FirstName(FIO),1,1)+'. '+
          SubStr(iStrFunc.GetPatronymic(FIO),1,1)+'. '+
          iStrFunc.Get_LastName(FIO);
}

function DoubleToStringWithBracket(Val:double):string;
var i,p:byte;
    sTmp:string;
{
  result:=Trim(DoubleToString(0,Val));

  p:=0;
  for(i:=Length(result)-2;i>0;i--) {
    sTmp:=LoCase(SubStr(result,i,3));
    if (sTmp='коп') p:=i
    else if (sTmp='руб') {
      p:=i;
      break;
    }
  }

  if (p<>0)
    result:='('+SubStr(result,1,p-2)+')'+SubStr(result,p-1,255);

  result:=Trim(Replace(result,' 00 копеек',''));
}

function GetPostName(cPost:comp):string;
{
  if ( boGetTune('UP.STAFF.USE_LONGNAME_ANK') )//Выводить длинное наименование должности в анкетной форме
    result:=iCatFunc.GetCatalogsLongName(cPost)
  else
    result:=iCatFunc.GetCatalogsName(cPost);
}

procedure FindDescendants(mCat:longint;cCat:comp);
{
  _loop Catalogs where((cCat==Catalogs.cParent)) {
    InsertMarker(mCat,Catalogs.NRec);
    PushPos(tnCatalogs);
    FindDescendants(mCat,Catalogs.NRec);
    PopPos(tnCatalogs);
  }//_loop Catalogs
}

procedure PrintRep;
var Sum,SumIt:double;
    f:boolean;
    hMemo,i,MesCount,mHigherEducation:longint;
    MemoStr,DatesBeg,DatesEnd:string;
    StrAr:array[1] of string;
{
  if (Frm.Error) exit;

  Frm.Write(PartDoc.NRec);

  if (getfirst fastfirstrow KatOrg where((coGetTune('MYORG')==KatOrg.NRec))=tsok)
    Frm.Write(trim(KatOrg.ShortName))
  else
    Frm.SkipFormat(1);

  f:=false;
  if (getfirst ContDoc = tsok)
    if (getfirst RaiseHist = tsok) {
      f:=true;
      Frm.Write(RaiseHist.rHSum,'[|-]3666 666 666.88');
      Frm.Write(DoubleToStringWithBracket(RaiseHist.rHSum));
      Frm.Write(DateToStr(RaiseHist.dRec,'DD.MM.YYYY'));
      Frm.Write(DateToStr(RaiseHist.dDat2,'DD.MM.YYYY'));
      Frm.Write(iCatFunc.GetCatalogsName(RaiseHist.cRaiseType));
      Frm.Write(iCatFunc.GetCatalogsCode(RaiseHist.cRaiseType));
    }
  if (not f)
    Frm.SkipFormat(6);

  //Подписанты "Приказ о выплатах по образовательной деятельности"
  if (iFeeSigners.FeeSignersIsValid and sSigners<>'')
  { //ОтветстенныйДолжность
    if (iFeeSigners.RestrictFeeByRole(2,'Otvetstv')) {
      Frm.Write(iFeeSigners.GetSignerPosition(3));
      Frm.Write(MyGetInitial(iFeeSigners.GetSignerFIO(3),true));
    }
    else
      Frm.SkipFormat(2);
    //ГлБухДолжность
    if (iFeeSigners.RestrictFeeByRole(2,'GlBux')) {
      Frm.Write(iFeeSigners.GetSignerPosition(3));
      Frm.Write(MyGetInitial(iFeeSigners.GetSignerFIO(3),true));
    }
    else
      Frm.SkipFormat(2);
    //ПровЛицоДолжность
    if (iFeeSigners.RestrictFeeByRole(2,'ProvLico')) {
      Frm.Write(iFeeSigners.GetSignerPosition(4));
      Frm.Write(MyGetInitial(iFeeSigners.GetSignerFIO(4),true));
    }
    else
      Frm.SkipFormat(2);
    //УтверждЛицоДолжность
    if (iFeeSigners.RestrictFeeByRole(2,'UtvLico')) {
      Frm.Write(iFeeSigners.GetSignerPosition(1));
      //Frm.Write(MyGetInitial(iFeeSigners.GetSignerFIO(1),true));
      // просят инициалы в начале
      Frm.Write(MyGetInitial(iFeeSigners.GetSignerFIO(1),false));
    }
    else
      Frm.SkipFormat(2);
    //координатор>
    if (iFeeSigners.RestrictFeeByRole(2,'Koord')) {
      Frm.Write(iFeeSigners.GetSignerPosition(3));
      Frm.Write(MyGetInitial(iFeeSigners.GetSignerFIO(3),true));
    }
    else
      Frm.SkipFormat(2);
  }
  else
    Frm.SkipFormat(8);
  var _wkol:word=0;

  //Примечание (кнопка)
  f:=false;
  _wkol:=0 ;
  if (getfirst ContDoc = tsok)
    if (getfirst fastfirstrow Notes where((cKadryDisNotes == Notes.choice and ContDoc.Nrec == Notes.Owner))=tsok)
      if (IsMemoText(tnNotes)) {
        hMemo:=CreateFileHandle('');
        if (File_OpenMemo(Notes.Note,hMemo)) {
          f:=true;

          MemoStr:='';
          File_ReadLn(MemoStr,hMemo);
          Frm.Write(MemoStr);

          MemoStr:='';
          File_ReadLn(MemoStr,hMemo);
          Frm.Write(MemoStr);

          File_Close(hMemo);
        }
        DeleteFileHandle(hMemo);
      }
  if (not f)
    Frm.SkipFormat(2);
  //-------------------
  //ДопУсл1  cKadryDopInfo
  _wkol:=0;
  if (getfirst ContDoc = tsok)
    if (getfirst fastfirstrow Notes where((cKadryDopInfo == Notes.choice and ContDoc.Nrec == Notes.Owner))=tsok)
      if (IsMemoText(tnNotes)) {
        hMemo:=CreateFileHandle('');
        if (File_OpenMemo(Notes.Note,hMemo))
        { f:=true;

          MemoStr:='';
          File_ReadLn(MemoStr,hMemo);
          Frm.Write(MemoStr);

          MemoStr:='';
          File_ReadLn(MemoStr,hMemo);
          Frm.Write(MemoStr);

          File_Close(hMemo);
        }
        DeleteFileHandle(hMemo);
      }
  if (not f)
    Frm.SkipFormat(2);

  //-----ДопУсл2
  //-------------------

  //Шапка раздела
  f:=false;
  _wkol:=0;
  if (getfirst ContDoc = tsok)
    //if (getfirst fastfirstrow PrMemo where((ContDoc.cPart == PrMemo.cDoc and 2 == PrMemo.wRef))=tsok)
    if (getfirst fastfirstrow PrMemo=tsok)
      if (IsMemoText(tnPrMemo)) {
        hMemo:=CreateFileHandle('');
        if (File_OpenMemo(PrMemo.Info,hMemo)) {
          f:=true;
          while not File_eof(hMemo) and _wkol<10
          { MemoStr:='';
            File_ReadLn(MemoStr,hMemo);
            Frm.Write(MemoStr);
            _wkol++;
            if _wkol>10 break;
          }
          File_Close(hMemo);
        }
        DeleteFileHandle(hMemo);
      }
  //if (not f)  Frm.SkipFormat(1);
  while _wkol<10
  { case _wkol of
    1: MemoStr:='Об установлении надбавки за обучение';
    //В форме пусть печатается
    //2: MemoStr:='В соответствии с "Положением об оплате труда работников, привлекаемых к учебной деятельности в АО "НПО Энергомаш"'
    //    +', утвержденным приказом от 19.07.2017 г. № 407 "О введении в действие Положения"';
    else MemoStr:='';
    end;
    _wkol++;
    //Frm.Write(MemoStr+ ' '+string(_wkol));
    Frm.Write(MemoStr);
  } //while _wkol<10

  mHigherEducation:=InitMarker('',8,0,1);
  InsertMarker(mHigherEducation,iCatFunc.GetCatalogsNRec(-98));
  FindDescendants(mHigherEducation,iCatFunc.GetCatalogsNRec(-98));
  InsertMarker(mHigherEducation,iCatFunc.GetCatalogsNRec(-97));
  FindDescendants(mHigherEducation,iCatFunc.GetCatalogsNRec(-97));

  i:=0;
  SumIt:=0;
  _loop ContDoc {
    Frm.PutEventByID(feDoLoop, fcGP_NFormRD209_ContDoc);

    Frm.Write(++i);
    Frm.Write(Persons.FIO);
    Frm.Write(GetStrTabn(Persons.TabNmb,Persons.StrTabn));
    Frm.Write(GetPostName(Appointments.Post));
    Frm.Write(SubStr(iCatFunc.GetCatalogsCode(Appointments.Department),1,3));
    Frm.Write(ContDoc.SBottom);

    SetLimit(StrAr,0);
    _loop Education where((ContDoc.Person == Education.Person)) ordered by Education.FromDate {
      if (FoundMarker(mHigherEducation,Education.Level)) {
        StrAr[1]:=string(Education.Course);
        StrAr[2]:=iCatFunc.GetCatalogsName(Education.Name);
        StrAr[3]:=iCatFunc.GetCatalogsName(Education.cDirect);
      }
    }//_loop Education
    Frm.Write(StrAr[1]);
    Frm.Write(StrAr[2]);
    Frm.Write(StrAr[3]);

    DatesBeg:='';DatesEnd:='';
    MesCount:=0;Sum:=0;
    _loop RaiseHist {
      if (RaiseHist.dRec<>ZeroDate)
        DatesBeg+=if(DatesBeg<>'',' ','')+DateToStr(RaiseHist.dRec,'DD.MM.YYYY');
      if (RaiseHist.dDat2<>ZeroDate)
        DatesEnd+=if(DatesEnd<>'',' ','')+DateToStr(RaiseHist.dDat2,'DD.MM.YYYY');

      if (RaiseHist.dRec<>ZeroDate and RaiseHist.dDat2<>ZeroDate) {
        MesCount+=Months_Between(RaiseHist.dDat2,RaiseHist.dRec);
        if (Day(RaiseHist.dRec)=1 and Day(RaiseHist.dDat2)=Last_Day(RaiseHist.dDat2))
          MesCount+=1;
      }

      Sum+=RaiseHist.rHSum;
    }//_loop RaiseHist

    Frm.Write(DatesBeg);
    Frm.Write(DatesEnd);
    Frm.Write(MesCount);
    Frm.Write(Sum,'[|-]3666 666 666.88');
    Frm.Write(Sum*MesCount,'[|-]3666 666 666.88');
    SumIt+=Sum*MesCount;
  }//_loop ContDoc
  Frm.Write(SumIt,'[|-]3666 666 666.88');

  DoneMarker(mHigherEducation,'');

  Frm.ShowFile;
}

HandleEvent
cmInit:{
  abort;

  sSigners:='';
  if (RunInterface('GetFeeSigners', cgReport_KASSFRO, sSigners)<>cmDefault) exit;

  iFeeSigners.InitFeeSigners(cgReport_KASSFRO);
  if (sSigners<>'')
    if (not iFeeSigners.FindFeeSignersByName(cgReport_KASSFRO, sSigners))
      sSigners:='';

  PrintRep;
}
end;

end.
