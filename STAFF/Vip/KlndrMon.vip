/*************************************************************************************************\
* Наименование: Доработка интерфейса редактирования графиков работ в разрезе календарных дней     *
* Контур/Модуль: Кадры                                                                            *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер задачи  |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#49           |16/03/17|Кузьмин П.Ю.             |НПО Энергомаш                    *
* Доработка   |#1303         |22/11/17|Кузьмин П.Ю.             |НПО Энергомаш                    *
\*************************************************************************************************/

#include GP_FillKlndrFromWorkPattern.vih

#component "Z_Calendar"
//Интерфейс просмотра и редактирования спецификации зарплатного графика
alter interface KlndrMon;
overload
  procedure GetHours(D: byte);
  procedure SetHours(D: byte);
end;
ExtendFormats HoursBrowse;

var iFillKlndrFromWorkPattern:GP_FillKlndrFromWorkPattern;

create view
var StartWorkDay,EndWorkDay,
    StartBreak1,EndBreak1,
    StartBreak2,EndBreak2,
    StartShift2,EndShift2:time;
    WorkPatternStr:string;
from
  GP_KlndrExt,GP_KlRejimYear,
  WorkPattern WorkPattern_GP,
  Grafik Grafik_GP
where((
  OperatingMode == GP_KlndrExt.Rejim
  and ScheduleYear == GP_KlndrExt.YearK
  and ScheduleMonth == GP_KlndrExt.MonthK
  and KlRejim.cCalendar == Grafik_GP.NRec
  and KlRejim.NRec == GP_KlRejimYear.cKlRejim
  and ScheduleYear == GP_KlRejimYear.Year
));

procedure GetHours(D: byte);
{
  inherited::GetHours(D);

  StartWorkDay:=GP_KlndrExt.StartWorkDay[D];
  EndWorkDay:=GP_KlndrExt.EndWorkDay[D];
  StartBreak1:=GP_KlndrExt.StartBreak1[D];
  EndBreak1:=GP_KlndrExt.EndBreak1[D];
  StartBreak2:=GP_KlndrExt.StartBreak2[D];
  EndBreak2:=GP_KlndrExt.EndBreak2[D];
  StartShift2:=GP_KlndrExt.StartShift2[D];
  EndShift2:=GP_KlndrExt.EndShift2[D];
  if (GP_KlndrExt.cWorkPattern[D]=0)
    WorkPatternStr:=''
  else if (getfirst fastfirstrow WorkPattern_GP
      where((GP_KlndrExt.cWorkPattern[D]==WorkPattern_GP.NRec))=tsok)
    {
    WorkPatternStr:=WorkPattern_GP.NameP;
    WorkStart := GP_KlndrExt.StartWorkDay[D];
    WorkEnd := GP_KlndrExt.EndWorkDay[D];
    sPatternName := WorkPattern_GP.NameP;
    }
  else
    WorkPatternStr:='?!!! '+string(GP_KlndrExt.cWorkPattern[D],0,0);
}

procedure SetHours(D: byte);
{
  inherited::SetHours(D);

  GP_KlndrExt.StartWorkDay[D]:=StartWorkDay;
  GP_KlndrExt.EndWorkDay[D]:=EndWorkDay;
  GP_KlndrExt.StartBreak1[D]:=StartBreak1;
  GP_KlndrExt.EndBreak1[D]:=EndBreak1;
  GP_KlndrExt.StartBreak2[D]:=StartBreak2;
  GP_KlndrExt.EndBreak2[D]:=EndBreak2;
  GP_KlndrExt.StartShift2[D]:=StartShift2;
  set GP_KlndrExt.EndShift2[D]:=EndShift2;
}

browse HoursBrowse (,hcCha,sci1Esc);
NoTableNavigation;
fields
  StartWorkDay 'Начало','раб. дня':[11,'HH:MM'],NoProtect,NoAutoSize;
  EndWorkDay   'Окончание','раб. дня':[11,'HH:MM'],NoProtect,NoAutoSize;
  StartBreak1  'Начало','перерыва 1':[11,'HH:MM'],NoProtect,NoAutoSize;
  EndBreak1    'Окончание','перерыва 1':[11,'HH:MM'],NoProtect,NoAutoSize;
  StartBreak2  'Начало','перерыва 2':[11,'HH:MM'],NoProtect,NoAutoSize;
  EndBreak2    'Окончание','перерыва 2':[11,'HH:MM'],NoProtect,NoAutoSize;
  StartShift2  'Начало','смены 2':[11,'HH:MM'],NoProtect,NoAutoSize;
  EndShift2    'Окончание','смены 2':[11,'HH:MM'],NoProtect,NoAutoSize;
  WorkPatternStr 'Шаблон рабочего дня':[20],Protect,PickButton;
end;

TableEvent table GP_KlndrExt;
cmUpdateRecord:{
  update current GP_KlndrExt;
}
end;

function IsCheckDate:boolean;
{
  result:=IsValidAll(tnGP_KlRejimYear);

  if (result)
    result:=GP_KlRejimYear.CheckDate<>ZeroDate;
}

HandleEvent
cmInit:{
  case inherited :: handleEvent (cmInit) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  //Убрать из окна просмотра и редактирования графика работ колонку <Вечерних часов>
//  ToggleFieldVisible(fnEveningHoursStr,false);

  if (not IsValidAll(tnGP_KlndrExt)) {
    ClearBuffer(tnGP_KlndrExt);
    GP_KlndrExt.Rejim:=OperatingMode;
    GP_KlndrExt.YearK:=ScheduleYear;
    GP_KlndrExt.MonthK:=ScheduleMonth;
    insert current GP_KlndrExt;
  }

  if (IsCheckDate) {
    DisableCommand(cmEdit);
    DisableCommand(cmDoKlndr);
  }
}
cmPick:{

    case CurField of
    #sPatternName,fnWorkPatternStr:{
      if (CurDay<1 or 31<CurDay or not IsInEditMode) exit;

      var cRec:comp;
      cRec:=GP_KlndrExt.cWorkPattern[CurDay];
      if (RunInterface('GP_WorkPattern', cRec) <> cmCancel) {
        iFillKlndrFromWorkPattern.SetWorkPattern(cRec,Grafik_GP.cCalendar,CurDay,Klndr.buffer,GP_KlndrExt.buffer);
        set Klndr.Holidayh[CurDay]:=Klndr.Holidayh[CurDay];
        set GP_KlndrExt.cWorkPattern[CurDay]:=GP_KlndrExt.cWorkPattern[CurDay];
        SumMonthlyDaysAndHours;
        ReScanPanel(tnNoTable);
      }
    }
    else
     { case inherited :: handleEvent (cmPick) of
       heAbort:{abort;exit;}
       heStop:{stop;exit;}
       end;
     }
  end;

}
cmDelOnProtect:{
  case inherited :: handleEvent (cmDelOnProtect) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnWorkPatternStr:{
      if (CurDay<1 or 31<CurDay or not IsInEditMode) exit;

      set GP_KlndrExt.cWorkPattern[CurDay]:=0;
      ReScanPanel(tnNoTable);
    }
  end;
}
cmExprFieldChanged:{
  if (CurDay>=1 and 31>=CurDay)
    if (GP_KlndrExt.cWorkPattern[CurDay]<>0) {
      message('Если установлен Шаблон рабочего дня, то ручная корректировка графика невозможна.');
      RescanPanel(tnNoTable);
      exit;
    }

  case inherited :: handleEvent (cmExprFieldChanged) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;
}
cmCheckField:{
  case inherited :: handleEvent (cmCheckField) of
    heAbort:{abort;exit;}
    heStop:{stop;exit;}
  end;

  case CurField of
    fnStartWorkDay,fnEndWorkDay,
    fnStartBreak1,fnEndBreak1,
    fnStartBreak2,fnEndBreak2,
    fnStartShift2,fnEndShift2:{
      if (CurDay>=1 and 31>=CurDay)
        if (GP_KlndrExt.cWorkPattern[CurDay]<>0) {
          message('Если установлен Шаблон рабочего дня, то ручная корректировка графика невозможна.');
          RescanPanel(tnNoTable);
          exit;
        }

      SetModified(true);
      UpdateTable;
    }
  end;
}
end;

end.
