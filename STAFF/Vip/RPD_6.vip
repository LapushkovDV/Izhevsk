/************************************************************************************************\
* Наименование: Интерфейс приказа "оформление отпуска"                                            *
* Контур/Модуль: Кадры                                                                            *
* Примечание: критичная ошибка - 65535 дней отпуска                                               *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
* Разработка  |#000          |15/11/17|Кириллов Э.П.            |НПО Энергомаш                    *
\*************************************************************************************************/

#include AttrTablePick.vih
#include ExtAttr.Vih
#include GP_RepLaborContract.vih
#include GP_SCUD_PersEdit.Vih

#include GP_RepLaborContractAlterRPD.inc

#component "Z_StaffOrders"
#doc
  Интерфейс приказа "оформление отпуска"
  Ошибка отрицательного остатка
#end
//GP_RepLaborContractAlterRPD(5) - нужны еще
alter interface RPD_6;

var  refAttrTablePick : AttrTablePick;
var iExAttr : iExtAttr;

overload
  function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
  function fnCalcDayCountIz:  integer;//IRPD_Base_Otpusk.
  Procedure IRPD_Base.EnableDisable;
end;
// функция расчет поля "Из дней" с учетом дней выданных этим же приказом
function fnCalcDayCountIz :  integer;
{ Result:=Inherited::fnCalcDayCountIz;
  if Result<0 Result:=0;
}

function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
{ Result:=Inherited::ChildCheckOneOrder(cNrec);
  if Result
  { if Persons.DisDate<>ZeroDate
    { if Persons.DisDate<=CONTDOC.DAT2
      { message('Сотрудник '+Persons.Fio
         +chr(13)+'Уволен '+DateToStr(Persons.DisDate,'DD/MM/YYYY')
         +chr(13)+'что меньше даты окончания отпуска'
         +chr(13)+DateToStr(CONTDOC.DAT2,'DD/MM/YYYY')
        )
      }
    } //if Persons.DisDate<>ZeroDate
    if APPOINTMENTS.DATEEND<>ZeroDate
    { if APPOINTMENTS.DATEEND<=CONTDOC.DAT2
      { message('Сотрудник '+Persons.Fio
         +chr(13)+'Назначен по '+DateToStr(Persons.DisDate,'DD/MM/YYYY')
         +chr(13)+'что меньше даты окончания отпуска'
         +chr(13)+DateToStr(CONTDOC.DAT2,'DD/MM/YYYY')
        )
      }
    } //if Persons.DisDate<>ZeroDate
  } //if Result
} //function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;

//******************************************************************************
// можно вынести в RPD_BASE, но тогда начинают идти 6 предупреждений на base_Payment
// да и EnableDisable в 8 перехвачена
//******************************************************************************
Create view vNotes
var
  nRecTable:comp;
  wChoice  :word;
From Notes
where ((
      wChoice     == Notes.choice
  and nRecTable   == Notes.Owner
));

File FMemo;

Function MyCheckNotes(_wChoice:word):boolean;
{ Result:=false;
  vNotes.nRecTable:=ContDoc.Nrec;
  vNotes.wChoice  :=_wChoice;
  Result:=vNotes.Getfirst Notes=tsok;
  if not Result exit;
  if FMemo.OpenMemo(vNotes.Notes.NOTE)
  { Result:=FMemo.GetSize()<>0;
    FMemo.Close;
  }
} //Function MyCheckNotes(_wChoice:word):boolean;
//******************************************************************************
// Установить надписи на кнопках
//******************************************************************************
Procedure MySetButtonTitle(_nm_screen:string='');
{ //'Z_STAFFORDERS::NOTESFORCONTDOC.Memo_NOTES.NOTE'
  var ww_str:string;
  if _nm_screen='' _nm_screen:='b_SCRDOC';
  //cmViewAdvance1
  ww_str:=if(MyCheckNotes(3002),'Примечание +','Примечание');
  //cfsSetProp(_nm_screen+'_Примечание',cfpTitle,ww_str);
  cfsSetProp(_nm_screen+'_Примечание_к_приказу',cfpTitle,ww_str);
  //--
  ww_str:=if(MyCheckNotes(3005),'Доп.условия+','Доп. условия');
  cfsSetProp(_nm_screen+'_Доп._условия',cfpTitle,ww_str);
  ReScanPanel(#PERSONS);
} //Procedure MySetButtonTitle;

//******************************************************************************
// Процедура открытия\закрытия полей для редактирования
//******************************************************************************
Procedure IRPD_Base.EnableDisable;
{ MySetButtonTitle('b_scrEmpty');
  if Timelog_Status>0
  {  Timelog('RPD_6->EnableDisable: fnFieldsOpen='
      +string(fnFieldsOpen)
      +', fnCheckDetalisationMode='  +string(fnCheckDetalisationMode(ContDoc.cNew5))
      +', ContDoc.cNew5='+string(ContDoc.cNew5)
      +', wModeView='  +string(wModeView)
      +', funIsChaild='+string(funIsChaild)
       );
  }
  Inherited::EnableDisable;
}//Procedure EnableDisable;

//------------------------
// События интерфейса
//------------------------
HandleEvent
cmPick:
{

  Inherited::HandleEvent(cmPick); 

  if CurField = #CONTDOC.SBOTTOM
  {
    refAttrTablePick.PickValue(coCONTDOC, iExAttr.AttrID(coCONTDOC, 'Основание'), CONTDOC.nRec);
    if refAttrTablePick.sGetValue(coCONTDOC, iExAttr.AttrID(coCONTDOC, 'Основание'), CONTDOC.nRec) != ''
    {
      CONTDOC.SBOTTOM := refAttrTablePick.sGetValue(coCONTDOC, iExAttr.AttrID(coCONTDOC, 'Основание'), CONTDOC.nRec);
      update current CONTDOC;
    }
    RereadRecord(#CONTDOC);
  }
}
cmOnVipLoad:
{ timelog_init;
  if  inherited :: handleEvent (cmOnVipLoad)=heAbort then Abort;
  if wGetTune('UP.FakelGAL.Fakel') = 1
  {
   cfsSetProp('i_SCRDET6_CONTDOC.SBOTTOM','StatusCtx',sci13Esc); 
  }
}
cmViewAdvance1: //просмотр примечания к приказу
{ if  inherited :: handleEvent (cmViewAdvance1)=heAbort then Abort;
  MySetButtonTitle('b_scrEmpty');
}

cmValue21: //доп. условия
{ if  inherited :: handleEvent (cmValue21)=heAbort then Abort;
  MySetButtonTitle('b_scrEmpty');
  // почему то сразу не обновляется
  EnableDisable;
}
end;
//******************************************************************************
end.
