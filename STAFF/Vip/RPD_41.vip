#include AttrTablePick.vih
#include ExtAttr.Vih
#include GP_RepLaborContract.vih

#component "Z_StaffOrders"
alter interface RPD_41;

var  refAttrTablePick : AttrTablePick;
var iExAttr : iExtAttr;

overload
  procedure IRPD.EnableDisable;
  function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
end;

Procedure EnableDisable;
{ 
  inherited::EnableDisable;

}

function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;
{ Result:=Inherited::ChildCheckOneOrder(cNrec);
  if Result
  { if Persons.DisDate<>ZeroDate
    { if Persons.DisDate<=CONTDOC.DAT2
      { message('Сотрудник '+Persons.Fio
         +chr(13)+'Уволен '+DateToStr(Persons.DisDate,'DD/MM/YYYY')
         +chr(13)+'что меньше даты окончания отпуска'
         +chr(13)+DateToStr(CONTDOC.DAT2,'DD/MM/YYYY')
        )
      }
    } //if Persons.DisDate<>ZeroDate
    if APPOINTMENTS.DATEEND<>ZeroDate
    { if APPOINTMENTS.DATEEND<=CONTDOC.DAT2
      { message('Сотрудник '+Persons.Fio
         +chr(13)+'Назначен по '+DateToStr(Persons.DisDate,'DD/MM/YYYY')
         +chr(13)+'что меньше даты окончания отпуска'
         +chr(13)+DateToStr(CONTDOC.DAT2,'DD/MM/YYYY')
        )
      }
    } //if Persons.DisDate<>ZeroDate
  } //if Result
} //function IRPD_Base.ChildCheckOneOrder(cNrec : comp = 0): boolean;

HandleEvent

cmPick:
{
  Inherited::HandleEvent(cmPick); 


  if CurField = #CONTDOC.SBOTTOM
  {
    refAttrTablePick.PickValue(coCONTDOC, iExAttr.AttrID(coCONTDOC, 'Основание'), CONTDOC.nRec);
    if refAttrTablePick.sGetValue(coCONTDOC, iExAttr.AttrID(coCONTDOC, 'Основание'), CONTDOC.nRec) != ''
    {
      CONTDOC.SBOTTOM := refAttrTablePick.sGetValue(coCONTDOC, iExAttr.AttrID(coCONTDOC, 'Основание'), CONTDOC.nRec);
      update current CONTDOC;
    }
    RereadRecord(#CONTDOC);
  }

}

cmOnVipLoad:
{ Inherited::HandleEvent(cmOnVipLoad); 
//==============================
  if wGetTune('UP.FakelGAL.Fakel') = 1
  {

   cfsSetProp('i_SCRDET41_CONTDOC.SBOTTOM','StatusCtx',sci13Esc); 

  }
}

end;

end.
