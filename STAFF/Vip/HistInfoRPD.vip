#component "Z_StaffOrders"
alter interface HistInfoRPD;
overload
  procedure IHistInfoRPD.SetRealtionForHistInfo(_ContNRec, _PersonNRec, _AppointNRec, _ShrNRec: comp; _dtHist: date; bBlock: boolean);
  procedure IHistInfoRPD.UpdateHistInfoOnDate(_dtHist: date);
end;

procedure SetRealtionForHistInfo(_ContNRec, _PersonNRec, _AppointNRec, _ShrNRec: comp; _dtHist: date; bBlock: boolean);
{
  inherited::SetRealtionForHistInfo(_ContNRec, _PersonNRec, _AppointNRec, _ShrNRec, Sub_Day(_dtHist, 1), bBlock);
}

procedure UpdateHistInfoOnDate(_dtHist: date);
{
  inherited::UpdateHistInfoOnDate(Sub_Day(_dtHist, 1));
}

end.
