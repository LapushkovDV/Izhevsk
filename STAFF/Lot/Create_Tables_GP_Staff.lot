  , GP_REP_Col_ALG02 = cGP_REP_ALG
  , GP_REP_Col_ALG03 = cGP_REP_ALG_F
);

Create Table GP.GP_REP_SOOTV "Отчет, Таблица соотв. для импорта1"
  With Table_CODE = 31666
  With replace
  With TableOptions Branched
(   Nrec           :  Comp                "Номер записи"
