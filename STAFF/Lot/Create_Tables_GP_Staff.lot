  //---------------------------------------
  // Заработная плата
  //---------------------------------------
  Create table GP.GP_RaspAvans "Распределение сумм авансов1"
  With table_Code = 31898
  With replace
  With TableOptions Branched
  (
    NRec       : comp "Номер записи"
  , Tabn       : longint "Табельный номер"
  , StrTabn    : string  "Табельный номер строчный"
  , cLschet    : comp    "Ссылка на лиц.счет"
  , cPersons   : comp    "Ссылка на карточку сотрудника"
  , cKatPodr   : comp    "ссылка на подразделение сотрудника"
  , Procent    : tSumma  "Процент - поля для ручного ввода" // цифрового значения (10; 15,24; 30,5 и т.д.)
  , cMnPlan    : comp    "ссылка на аналитику Заказ"
  , DataN      : Date    "Дата начала действия записи"
  , DataOk     : Date    "Дата окончания действия условия"
  , isArh      : word    "1 - архив"
  , cUser      : comp    "Пользователь"
  , DInput     : date    "Дата ввода"
  , cvPlan     : Ref (vPlan) "Группа планов"
  , wType      : word "Тип 0-накладные, 1-прямые"
  )
  With index
  (
    RaspAvans01 = NRec(Unique, Surrogate, Journal),
    RaspAvans02 = Tabn+StrTabn+DataN,
    RaspAvans03 = isArh+Tabn+StrTabn+DataN,
    RaspAvans04 = cLschet+isArh+DataN,
    RaspAvans05 = cPersons+isArh
  );

  Create table GP.GP_RaspVO "Распределение видов оплат по заказам1"
  With table_Code = 31897
  With replace
  With TableOptions Branched
  (
    NRec       : comp    "Номер записи"
  , TP         : word    "0 - виды оплат,1 удержаний"
  , VidOpl     : word    "Системный код ВО"
  , VidOplP    : word    "Пользовательский код"
  , cKatPodr   : comp    "ссылка на подразделение"
  , Code       : string[30] "Код"
  , Procent    : tSumma  "Процент - поля для ручного ввода" // цифрового значения (10; 15,24; 30,5 и т.д.)
  , cMnPlan    : comp    "ссылка на аналитику Заказ"
  , cBuhSchet  : comp    "Ссылка на план счетов"
  , Schet      : string[21] "Счет бухгалтерского учета"
  , SubSch     : string[21] "Номер субсчета"
  , DataN      : Date    "Дата начала действия записи"
  , DataOk     : Date    "Дата окончания действия условия"
  , isArh      : word    "1 - архив"
  , cUser      : comp    "Пользователь"
  , DInput     : date    "Дата ввода"
//-----------------------------
  , CAddFld        : tNRec_x10   "Параметры типа comp"
  //1 - ссылка на DepFunc
  , DAddFld        : Date_x10    "Параметры типа date"
  , SAddFld        : S60_x10     "параметры типа string"
  , WAddFld        : Word_x10    "параметры типа word"

  )
  With index
  (
    GP_RaspVO01 = NRec(Unique, Surrogate, Journal),
    GP_RaspVO02 = TP+DataN+VidOplP,
    GP_RaspVO03 = TP+VidOplP+DataN,
    GP_RaspVO04 = TP+VidOpl+DataN,
    GP_RaspVO05 = TP+IsArh+DataN+VidOplP,
    GP_RaspVO06 = TP+IsArh+VidOplP+DataN,
    GP_RaspVO07 = TP+IsArh+VidOpl+DataN,
    GP_RaspVO08 = TP+Code+DataN,
    GP_RaspVO09 = TP+DataN+CODE+VidOplP,
    GP_RaspVO10 = cKatPodr+TP+DataN+VidOplP,
    GP_RaspVO11 = cMnPlan +TP+DataN+VidOplP,
    GP_RaspVO12 = cKatPodr+TP+VidOplP+DataN,
    GP_RaspVO13 = cMnPlan +TP+VidOplP+DataN,
    GP_RaspVO14 = cKatPodr+TP+isArh+DataN+VidOplP,
    GP_RaspVO15 = cMnPlan +TP+isArh+DataN+VidOplP,
    GP_RaspVO16 = cKatPodr+TP+isArh+VidOplP+DataN,
    GP_RaspVO17 = cMnPlan +TP+isArh+VidOplP+DataN
  );

