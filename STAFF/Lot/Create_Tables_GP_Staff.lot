#include DicTypes.def           // Словарные типы данных.

Create table GP.GP_KlndrExt "Расширение таблицы Календарные часы1"
  With table_Code = 31501
  With replace
  With TableOptions Branched
  (
    NRec         : comp "Номер записи",
    Rejim        : word "Код Режима Работы",
    YearK        : integer "Год",
    MonthK       : integer "Месяц",
    StartWorkDay : array[1..31] of time "Начало рабочего дня",
    EndWorkDay   : array[1..31] of time "Окончание рабочего дня",
    StartShift2  : array[1..31] of time "Начало смены 2",
    EndShift2    : array[1..31] of time "Окончание смены 2",
    StartBreak1  : array[1..31] of time "Начало перерыва 1",
    EndBreak1    : array[1..31] of time "Окончание перерыва 1",
    StartBreak2  : array[1..31] of time "Начало перерыва 2",
    EndBreak2    : array[1..31] of time "Окончание перерыва 2",
    cWorkPattern : array[1..31] of comp "Шаблон рабочего дня"
  )
  With index
  (
    KlndrExt01 = NRec(Unique, Surrogate, Journal),
    KlndrExt02 = Rejim+YearK+MonthK
  );

Create table GP.GP_WorkPatternExt "Расширение таблицы Шаблон рабочего дня1"
  With table_Code = 31502
  With replace
  With TableOptions Branched
  (
    NRec         : comp "Номер записи",
    cWorkPattern : ref(WorkPattern) "Шаблон рабочего дня",
    StartBreak1  : time "Начало перерыва 1",
    EndBreak1    : time "Окончание перерыва 1",
    StartBreak2  : time "Начало перерыва 2",
    EndBreak2    : time "Окончание перерыва 2",
    StartShift2  : time "Начало смены 2",
    EndShift2    : time "Окончание смены 2",
    cPreHolidayPattern : ref(WorkPattern) "Шаблон предпраздничного дня"
  )
  With index
  (
    WorkPatternExt01 = NRec(Unique, Surrogate, Journal),
    WorkPatternExt02 = cWorkPattern
  );

