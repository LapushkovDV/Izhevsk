  //-------------------------------------------
  Create table GP.GP_SCUD_Days "Скуд - регистрация дней1"
  With table_Code = 31651
  With replace
  With TableOptions Branched
  (   NRec           : comp "Номер записи"
    , cGP_SCUD_Doc   : ref(GP_SCUD_Doc)  "ссылка на документ"
    , cGP_SCUD_Doc_SP: ref(GP_SCUD_Doc_SP)  "ссылка на спец. документа"
    , cGP_SCUD_PERS  : ref(GP_SCUD_PERS) "ссылка на сотрудника"
    , wType          : word "Тип 0 - отраб., 1 использ. "
    , wVid           : word "1 - св.,2 перер. ,3 - выход."
    , EventDate      : date   "Дата события"
    , chasf          : double   "Кол-во часов"
    , Ost            : double   "Остаток"
  )
  With index
  ( GP_SCUD_Days01 = NRec(Unique, Surrogate, Journal)
   ,GP_SCUD_Days02 = cGP_SCUD_Doc+wType+wVid+EventDate // Для контроля возможности удаления документа
   ,GP_SCUD_Days03 = cGP_SCUD_Doc_SP+wType+wVid+EventDate
   ,GP_SCUD_Days04 = cGP_SCUD_PERS+wType+wVid+EventDate
  );

 //-----------------------------------------------
 //1754 необходимо разработать отдельный функционал по разграничению прав доступа по подразделениям аналогичному в модуле ЗП
 // На базе USERRIGHTS 16056
 Create table GP.GP_USERRIGHTS "GP Права пользователей на подразделения"
  With table_Code = 31652
  With replace
  With TableOptions Branched
  (
     NRec       : comp "Номер записи"
    ,OWNNAME    : string[60]   "имя пользователя"
    ,CGROUP     : comp         "ссылка на вышестоящее подразделение"
    ,CRECDS     : ref(KatPodr) "ссылка на KatPodr"
    ,NAME       : string[200]  "наименование подразделения"
    ,KOD        : string[20]   "код подразделения"
    ,ISLEAF     : word         "признак нижнего уровня"
    ,MARKED     : string[1]    "'+' - поле помечено"
    ,CUSER      : comp         "Ссылка на пользователя"
    //----
    ,wType      : word         "0 мотивация,1 СКУД"
  )
  With index
  (
    GP_USERRIGHTS01 = NRec(Unique, Surrogate, Journal)
   ,GP_USERRIGHTS02 = CRECDS  + OWNNAME+ wType
   ,GP_USERRIGHTS03 = OWNNAME + CGROUP + NAME +wType
   ,GP_USERRIGHTS04 = OWNNAME + CGROUP + KOD  +wType
   ,GP_USERRIGHTS05 = CRECDS  + CUSER  + wType
   ,GP_USERRIGHTS06 = CUSER   + CGROUP + NAME +wType
   ,GP_USERRIGHTS07 = CUSER   + CGROUP + KOD  +wType
   //--------------------------
   ,GP_USERRIGHTS12 = wType   + CRECDS  + OWNNAME
   ,GP_USERRIGHTS13 = wType   + OWNNAME + CGROUP + NAME
   ,GP_USERRIGHTS14 = wType   + OWNNAME + CGROUP + KOD
   ,GP_USERRIGHTS15 = wType   + CRECDS  + CUSER
   ,GP_USERRIGHTS16 = wType   + CUSER   + CGROUP + NAME
   ,GP_USERRIGHTS17 = wType   + CUSER   + CGROUP + KOD

  );
  //--- 20180301 #1971 -----------------------
  //--- 20180301 #816 -----------------------
  Create table GP.GP_KPI_Pers_Class "Премии за классность и т.п.1"
  With table_Code = 31653
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cDoplata       : ref(Catalogs) "Тип премии"
   , cPersons       : ref(Persons)  "Сотрудник"
   , cAppoint       : ref(Appointments)  "Вакансия"
   , FromDate       : date "C даты"
   , ToDate         : date "по дату"
   , Procent        : tSumma "Процент"
   , cTitleDoc      : Ref(TitleDoc) "Приказ"
   , cContDoc       : Ref(ContDoc)  "содержимое приказа"
   , Summa          : tSumma "Сумма"
   , Vidopl         : word "Вид оплат"
   , DocNumber      : string[30] "Номер приказа"
   , DocDate        : Date       "Дата приказа"
   , Fio            : String[50] "Фамилия, Имя, Отчество"
   //--- #816 для привязки водителей и секретарей к ЗГД
   , cLink_App      : Ref(Appointments) "Связать с назначением др. сотр."
   , cLink_Pers     : Ref(Persons) "Связать с картотекой др. сотр."
   , cLink_Staff    : Ref(StaffStruct) "Связать с картотекой др. сотр."
  )
  With index
  (
    GP_Pers_Class01 = NRec(Unique, Surrogate, Journal),
    GP_Pers_Class02 = cDoplata+cPersons+FromDate,
    GP_Pers_Class03 = cAppoint+FromDate,
    GP_Pers_Class04 = cContDoc+cPersons+cDoplata+FromDate,
    GP_Pers_Class05 = Vidopl+Fio+FromDate,
    GP_Pers_Class06 = Fio+Vidopl+FromDate,
    GP_Pers_Class07 = FromDate,
    GP_Pers_Class08 = cLink_Pers+Vidopl,
    GP_Pers_Class09 = cLink_Staff+Vidopl
  );

  //--- 20180315 #175 #1410 -----------------------
  Create table GP.GP_EMAIL "Для отложенной рассылки по EMAIL1"
  With table_Code = 31654
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cUser          : ref(x$Users) "ссылка на пользователя"
   //---------------------
   , PrepareDate    : date "Дата подготовки для отправки"
   , PrepareTime    : time "Время подготовки для отправки"
   , SendDate       : date "Дата подготовки для отправки"
   , SendTime       : time "Время подготовки для отправки"
   //---------------------
   , Email          : string  "Email 1"
   , Email2         : string  "Email 2"
   , Email_Copy     : string  "Email копия"
   , Email_CC       : string  "Email скрытая копия"
   //---------------------
   , subject        : string "Тема"
   , email_text     : string "Содержание письма"
   , attach1        : string "Путь на файл 1"
   , attach2        : string "Путь на файл 2"
   , attach3        : string "Путь на файл 3"
   , attach4        : string "Путь на файл 4"
   , attach5        : string "Путь на файл 5"
   //---------------------
   , cKatPodr       : ref(KatPodr) "ссылка на подразделение"
   , Fio            : string[50]  "Фио отправителя"
   //---------------------
   , DESCR          : tDescr     "Дескриптор пользователя"
   , DesGr          : tDesGr     "Группа Дескрипторов пользователя"
   , Status         : word "0-prepare,1-to send,2-ok,3-err"
   , LBody          : LVar "Текст письма"

  )
  With index
  (
     GP_EMAIL01 = NRec(Unique, Surrogate, Journal)
    ,GP_EMAIL02 = DESCR+PrepareDate+PrepareTime
    ,GP_EMAIL03 = DESGR+PrepareDate+PrepareTime
    ,GP_EMAIL04 = DESCR+SendDate+SendTime
    ,GP_EMAIL05 = DESGR+SendDate+SendTime
    ,GP_EMAIL06 = PrepareDate+PrepareTime
    ,GP_EMAIL07 = SendDate+SendTime
    //------------------
    ,GP_EMAIL08 = Status+DESCR+PrepareDate+PrepareTime
    ,GP_EMAIL09 = Status+DESGR+PrepareDate+PrepareTime
    ,GP_EMAIL10 = Status+DESCR+SendDate+SendTime
    ,GP_EMAIL11 = Status+DESGR+SendDate+SendTime
    ,GP_EMAIL12 = Status+PrepareDate+PrepareTime
    ,GP_EMAIL13 = Status+SendDate+SendTime

  );

  //--- 20180412 #175  -----------------------
  Create table GP.GP_FILE_HREF "Для хранения ссылок на файлы1"
  With table_Code = 31655
  With replace
  With TableOptions Branched
  (  NRec           : comp "Номер записи"
   , cUser          : ref(x$Users) "ссылка на пользователя"
   //---------------------
   , Add_Date    : date "Дата генерации ссылки"
   , Add_Time    : time "Время генерации ссылки"
   //---------------------
   , TipDoc         : word  "Тип документа"
   , wTable         : word  "код таблицы"
   , cRec           : comp  "Документ"
   , KODGRKAU       : word  "Код аналитики"
   , isArch         : word  "Признак архивности 1- архив,2 к удалению"
   , sFile          : string "Файл"
   , hRef           : string "ссыдка"
   //---------------------
   , subject        : string "Примечание"
   , comment        : string "комментарии"
   //---------------------
   , DESCR          : tDescr     "Дескриптор пользователя"
   , DesGr          : tDesGr     "Группа Дескрипторов пользователя"
   , Status         : word "0-prepare,1-to send,2-ok,3-err"
   //-----------------------------
   , CAddFld        : tNRec_x10   "Параметры типа comp"
   , DAddFld        : Date_x10    "Параметры типа date"
   //, SAddFld        : S60_x10     "параметры типа string"
   , WAddFld        : Word_x10    "параметры типа word"
  )
  With index
  (
     GP_FILE_HREF01 = NRec(Unique, Surrogate, Journal)
    ,GP_FILE_HREF02 = DESCR+ADD_Date+ADD_Time
    ,GP_FILE_HREF03 = DESGR+ADD_Date+ADD_Time
    ,GP_FILE_HREF04 = ADD_Date+ADD_Time
    ,GP_FILE_HREF05 = cUser+ADD_Date+ADD_Time
    ,GP_FILE_HREF06 = Wtable+cRec+sFile
    ,GP_FILE_HREF07 = Wtable+cRec+hRef
    ,GP_FILE_HREF08 = Wtable+cRec+isArch+sFile
    ,GP_FILE_HREF09 = Wtable+cRec+isArch+hRef
  );

  //--- 20180907 #3349  -----------------------
