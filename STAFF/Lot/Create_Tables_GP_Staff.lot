Create Table NACHISLZAKAZ "Начисления позаказно1"
  With Table_CODE = 31891
  With Replace
  With TableOptions Branched
(
   nRec       : comp           "Номер записи"
 , TABN       : longint         "Табельный номер"
 , CEX        : comp            "Цех адм. подчинения"
 , CEXOZ      : comp            "Цех отнесения затрат"
 , CPODR      : comp            "Ссылка на доплату"
 , CPODROZ    : comp            "Ссылка на класс.вычетов"
 , MES        : word            "Месяц, за который начислено"
 , MESN       : word            "Месяц, в котором начислено"
 , YEARN      : integer         "Год, в котором начислено"
 , VIDOPL     : longint         "Вид оплаты пользователя"
 , KATEG      : word            "Код категории(должности)"
 , DATAN      : date            "Дата начала   выплат"
 , DATOK      : date            "Дата окон-ния выплат"
 , KOLDN      : double          "Количество дней"
 , CHASF      : double          "Количество часов"
 , SUMMA      : double          "Сумма оплаты"
 , PRIZPR     : word            "Признак проводки"
 , CSCHETD    : string[20]      "дебет. счет"
 , CSUBSCHD   : string[21]      "Субсчет дебет. счета"
 , CKAUD      : array [1..6] of comp  "КАУ дебет. счета"
 , TBLD       : array [1..6] of word  "таблицы КАУ дебет. счета"
 , CSCHETK    : string[20]      "кредит. счет"
 , CSUBSCHK   : string[21]      "Субсчет кредит. счета"
 , CKAUK      : array [1..6] of comp  "КАУ кредит. счета"
 , TBLK       : array [1..6] of word  "таблицы КАУ кредит. счета"
 , CLSCH      : comp             "Код работника из ЛСЧ"
 , TPERSON    : comp             "Код работника из ФЛ"
 , SISOPL     : word             "Код системы оплаты"
 , CODTAR     : word             "Код тарифа"
 , RAZR       : word             "Разряд"
 , VIDOPLS    : longint          "Системный Вид оплаты"
 , OTKUDA     : string[1]        "Признак откуда допл."
 , CAPPOINT   : comp             "Ссылка на должность"
