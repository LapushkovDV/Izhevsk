PROCEdURE FillInsertTables(_nrow : longint; _file : string); {
 var _i: byte;
  clearBuffer(tntRows);
  tRows.nrow := _nrow;

    for(_i := 1; _I <= getLimit(_recArray); _i++) {
     case typeTable of
      cotblTmpltBudgetVid   : {
        case upcase(_recArray[_i].def) of
          Upcase('№'                      ) : tRows.statya_kod   := Trim(_recArray[_i].value);
          Upcase('Статья бюджета'         ) : tRows.statya_name  := Trim(_recArray[_i].value);
          Upcase('Категория'              ) : tRows.Category     := Trim(_recArray[_i].value);
         end;
      }
      cotblTmpltBudgetSHPZ  : {
        case upcase(_recArray[_i].def) of
          Upcase('№'                      ) : tRows.statya_kod   := Trim(_recArray[_i].value);
          Upcase('Статья бюджета'         ) : tRows.statya_name  := Trim(_recArray[_i].value);
          Upcase('Категория'              ) : tRows.Category     := Trim(_recArray[_i].value);
          Upcase('СЧЕТ ШПЗ'               ) : tRows.SHPZ         := Trim(_recArray[_i].value);
        end;
      }

      cotblInstnBudgetVid
     ,cotblInstnBudgetVidCorr : {
         case upcase(_recArray[_i].def) of
          Upcase('Код подразделения'      ) : tRows.podr_kod     := Trim(_recArray[_i].value);
          Upcase('Код службы'             ) : tRows.cex_kod      := Trim(_recArray[_i].value);
          Upcase('Наименование службы'    ) : tRows.cex_name     := Trim(_recArray[_i].value);
          Upcase('Код МВЗ'                ) : tRows.MVZ_kod      := Trim(_recArray[_i].value);
          Upcase('Наименование МВЗ'       ) : tRows.MVZ_name     := Trim(_recArray[_i].value);
          Upcase('Код передела'           ) : tRows.peredel_kod  := Trim(_recArray[_i].value);
          Upcase('Наименование передела'  ) : tRows.peredel_name := Trim(_recArray[_i].value);
          Upcase('№'                      ) : tRows.statya_kod   := Trim(_recArray[_i].value);
          Upcase('Статья бюджета'         ) : tRows.statya_name  := Trim(_recArray[_i].value);
          Upcase('Категория'              ) : tRows.Category     := Trim(_recArray[_i].value);
          Upcase('Январь'                 ) : tRows.sum1         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Февраль'                ) : tRows.sum2         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Март'                   ) : tRows.sum3         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Апрель'                 ) : tRows.sum4         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Май'                    ) : tRows.sum5         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Июнь'                   ) : tRows.sum6         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Июль'                   ) : tRows.sum7         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Август'                 ) : tRows.sum8         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Сентябрь'               ) : tRows.sum9         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Октябрь'                ) : tRows.sum10        := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Ноябрь'                 ) : tRows.sum11        := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Декабрь'                ) : tRows.sum12        := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
         end;
      }
      cotblInstnBudgetSHPZ
     ,cotblInstnBudgetSHPZCorr : {
         case upcase(_recArray[_i].def) of
          Upcase('Код подразделения'      ) : tRows.podr_kod     := Trim(_recArray[_i].value);
          Upcase('Код службы'             ) : tRows.cex_kod      := Trim(_recArray[_i].value);
          Upcase('Наименование службы'    ) : tRows.cex_name     := Trim(_recArray[_i].value);
          Upcase('Код МВЗ'                ) : tRows.MVZ_kod      := Trim(_recArray[_i].value);
          Upcase('Наименование МВЗ'       ) : tRows.MVZ_name     := Trim(_recArray[_i].value);
          Upcase('Код передела'           ) : tRows.peredel_kod  := Trim(_recArray[_i].value);
          Upcase('Наименование передела'  ) : tRows.peredel_name := Trim(_recArray[_i].value);
          Upcase('№'                      ) : tRows.statya_kod   := Trim(_recArray[_i].value);
          Upcase('Статья бюджета'         ) : tRows.statya_name  := Trim(_recArray[_i].value);
          Upcase('Категория'              ) : tRows.Category     := Trim(_recArray[_i].value);
          Upcase('СЧЕТ ШПЗ'               ) : tRows.SHPZ         := Trim(_recArray[_i].value);
          Upcase('Январь'                 ) : tRows.sum1         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Февраль'                ) : tRows.sum2         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Март'                   ) : tRows.sum3         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Апрель'                 ) : tRows.sum4         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Май'                    ) : tRows.sum5         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Июнь'                   ) : tRows.sum6         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Июль'                   ) : tRows.sum7         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Август'                 ) : tRows.sum8         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Сентябрь'               ) : tRows.sum9         := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Октябрь'                ) : tRows.sum10        := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Ноябрь'                 ) : tRows.sum11        := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
          Upcase('Декабрь'                ) : tRows.sum12        := Double(replace(replace(Trim(_recArray[_i].value),',','.'),' ',''));
         end;
      }
    end;
  }
  if tRows.statya_name <> '' and upcase(tRows.Category) <> 'ВСЕГО' then {
     insert current tRows;
   }
} // PROCEdURE FillInsertTableeNaklSFO(_log: string);

Function getColor(_FlagErr: byte) : word;
{
  case _FlagErr of
   0 : Result := 0
   1 : Result := ColorNeed
   2 : Result := ColorError
  else
  {
   Result := 0;
  }
  end;
}


#declare seterror(_str)
  tRows.FlagErr := 2 ;
  tRows.Descr   := tRows.Descr + #_str;
//  mylog(#_str);
#end

#declare setwarning(_str)
  tRows.FlagErr := if(tRows.FlagErr > 1, tRows.FlagErr , 1) ;
  tRows.Descr   := tRows.Descr + #_str;
//  mylog(#_str);
#end
#declare insertspkau
      insert current spkau_check set
         spkau_check.code     := _code
       , spkau_check.name     := _name
       , spkau_check.KODGRKAU := _kodGrKau
      ;
#end
function getspkaubycodename(_kodGrKau : word; _code, _name : string) : comp; cacheable; {
   result := 0h;
  if trim(_code) <> '' {
    if(getfirst spkau_check where ((_kodGrKau == spkau_check.KODGRKAU))
                         and upcase(spkau_check.code) = upcase(_code)) <> tsOK {
      #insertspkau
    }
    result := spkau_check.nrec;
    exit;
  }
  if trim(_name) <> '' {
    if(getfirst spkau_check where ((_kodGrKau == spkau_check.KODGRKAU))
                         and upcase(spkau_check.name) = upcase(_name)) <> tsOK {
      #insertspkau
    }
    result := spkau_check.nrec;
    exit;
  }
}

Procedure CheckErrors_tRows;
{
  update tRows set tRows.FlagErr := 0, tRows.Descr := '';
  StartNewVisual(vtIndicatorVisual , vfTimer, 'Проверка данных',recordsintable(tntRows));

  _loop tRows {
    nextvisual;

     if tRows.statya_kod = '' {// №'
      #seterror('|пустой код статьи')
     }
     if tRows.statya_name = '' { // Статья бюджета'
      #seterror('|пустое наименование статьи')
     }
     if tRows.Category = '' {    // Категория'
      #seterror('|пустое наименование категории')
     }

     case typeTable of
       cotblTmpltBudgetSHPZ
      ,cotblInstnBudgetSHPZ
      ,cotblInstnBudgetSHPZCorr : {
        if tRows.SHPZ = '' { // СЧЕТ ШПЗ
          #seterror('|пустой счет ШПЗ')
        }
      }
     end;
     case typeTable of
       cotblInstnBudgetVid
      ,cotblInstnBudgetVidCorr
      ,cotblInstnBudgetSHPZ
      ,cotblInstnBudgetSHPZCorr : {
          if tRows.podr_kod = ''   {  // Код подразделения'
           #seterror('|пустой Код подразделения')
          }
          if tRows.cex_kod   = ''    { //  Код службы'
           #seterror('|пустой Код службы')
          }
          if tRows.cex_name  = ''    { //  Наименование службы'
           #seterror('|пустое Наименование службы')
          }
          if tRows.MVZ_kod   = ''    { //  Код МВЗ'
           #seterror('|пустой Код МВЗ')
          }
          if tRows.MVZ_name  = ''    { //  Наименование МВЗ'
           #seterror('|пустое Наименование МВЗ')
          }
          if tRows.peredel_kod  = '' { //  Код передела'
           #seterror('|пустой Код передела')
          }
          if tRows.peredel_name = '' { //  Наименование передела'
           #seterror('|пустое Наименование передела')
          }
          if tRows.sum1 = 0 and tRows.sum2 = 0 and tRows.sum3 = 0 and tRows.sum4  = 0 and tRows.sum5  = 0 and tRows.sum6  = 0 and
             tRows.sum7 = 0 and tRows.sum8 = 0 and tRows.sum9 = 0 and tRows.sum10 = 0 and tRows.sum11 = 0 and tRows.sum12 = 0 {
              #setwarning('|все суммы нулевые')
             }
      }
     end;
    update current tRows;

    if _cTemplate <> 0h and tRows.FlagErr < 2 { // проверим наличие в шаблоне разреза если по строке нет ошибки
      case typeTable of
         cotblInstnBudgetSHPZ
        ,cotblInstnBudgetSHPZCorr : {
          if getfirst Budg_Tmplt_sp where ((                _cTemplate == Budg_Tmplt_sp.cTemplate
           and getspkaubycodename(_wStatya,tRows.statya_kod, tRows.statya_name) == Budg_Tmplt_sp.cStatya
                            and getspkaubycodename(_wCategory, '', tRows.Category) == Budg_Tmplt_sp.cCategory
                                and getspkaubycodename(_wShpz, '', tRows.SHPZ) == Budg_Tmplt_sp.cSHPZ )) = tsOK {
                                 update current tRows set tRows.cTmpltSp := Budg_Tmplt_sp.nrec
                                }
        }
         cotblInstnBudgetVid
        ,cotblInstnBudgetVidCorr : {
          if getfirst Budg_Tmplt_sp where ((                _cTemplate == Budg_Tmplt_sp.cTemplate
           and getspkaubycodename(_wStatya, tRows.statya_kod, tRows.statya_name) == Budg_Tmplt_sp.cStatya
                            and getspkaubycodename(_wCategory, '', tRows.Category) == Budg_Tmplt_sp.cCategory)) = tsOK {
                                 update current tRows set tRows.cTmpltSp := Budg_Tmplt_sp.nrec
                                }
        }
      end;
      if tRows.cTmpltSp = 0h {
       #seterror('|в шаблоне нет строки с такой аналитикой (статья, категория, ШПЗ)')
      }
     }
   }
   if visualizationactive  StopVisual('The End',vfTimer);
}


#include OpenFileExcelSearchCells.vpp


procedure MyLog(_log : string); {
  if _logFile = '' then _logFile := GetStringParameter('Files', 'OutputFilesDirectory', 0) + 'budget_import_'+UserName+'_'+DateToStr(Cur_date, 'YYYYMMDD') + '_' + timetostr(Cur_time, 'HH.MM.SS')  + '.log';
//  logstrtofile(_logFile,ShortStrToWin(_log));
  logstrtofile(_logFile,_log);
}



procedure Insert_budget; {
  Setvisualheader('Создание/обновление ТМЦ');
  StartNewVisual(vtIndicatorVisual, vfTimer, 'Создание/обновление бюджета',recordsintable(tntRows));

  _loop tRows {
    nextvisual;


 case typeTable of
      cotblTmpltBudgetVid   : {
          if getfirst fastfirstrow Budg_Tmplt_sp where ((                _cTemplate == Budg_Tmplt_sp.cTemplate
           and getspkaubycodename(_wStatya, tRows.statya_kod, tRows.statya_name) == Budg_Tmplt_sp.cStatya
                            and getspkaubycodename(_wCategory, '', tRows.Category) == Budg_Tmplt_sp.cCategory)) <> tsOK {
                                 insert current Budg_Tmplt_sp set
                                    Budg_Tmplt_sp.cTemplate := _cTemplate
                                  , Budg_Tmplt_sp.cStatya   := getspkaubycodename(_wstatya, tRows.statya_kod, tRows.statya_name)
                                  , Budg_Tmplt_sp.cCategory := getspkaubycodename(_wCategory, '', tRows.Category)
                                 ;
                                }

      }
      cotblTmpltBudgetSHPZ  : {
          if getfirst fastfirstrow Budg_Tmplt_sp where ((                _cTemplate == Budg_Tmplt_sp.cTemplate
           and getspkaubycodename(_wstatya, tRows.statya_kod, tRows.statya_name) == Budg_Tmplt_sp.cStatya
                            and getspkaubycodename(_wCategory, '', tRows.Category) == Budg_Tmplt_sp.cCategory
                                and getspkaubycodename(_wSHPZ, '', tRows.SHPZ) == Budg_Tmplt_sp.cSHPZ )) <> tsOK {
                                 insert current Budg_Tmplt_sp set
                                    Budg_Tmplt_sp.cTemplate := _cTemplate
                                  , Budg_Tmplt_sp.cStatya   := getspkaubycodename(_wstatya, tRows.statya_kod, tRows.statya_name)
                                  , Budg_Tmplt_sp.cCategory := getspkaubycodename(_wCategory, '', tRows.Category)
                                  , Budg_Tmplt_sp.cSHPZ     := getspkaubycodename(_wSHPZ, '', tRows.SHPZ)
                                 ;
                                }
      }
      cotblInstnBudgetVid
     ,cotblInstnBudgetVidCorr
     ,cotblInstnBudgetSHPZ
     ,cotblInstnBudgetSHPZCorr : {
       insert Budg_Instance_sp set
          Budg_Instance_sp.cTemplate := _cTemplate
        , Budg_Instance_sp.cInstance := _cInstance
        , Budg_Instance_sp.planfact  := 1
        , Budg_Instance_sp.cTmpltSp  := tRows.cTmpltSp
        , Budg_Instance_sp.cPodr     := getspkaubycodename(_wPODR   , '', tRows.podr_kod)
        , Budg_Instance_sp.cCex      := getspkaubycodename(_wCEX    , tRows.cex_kod, tRows.cex_name)
        , Budg_Instance_sp.cMVZ      := getspkaubycodename(_wMVZ    , tRows.MVZ_kod, tRows.MVZ_name)
        , Budg_Instance_sp.cPeredel  := getspkaubycodename(_wPEREDEL, tRows.peredel_kod, tRows.peredel_name)
        , Budg_Instance_sp.summa[1]  := tRows.sum1
        , Budg_Instance_sp.summa[2]  := tRows.sum2
        , Budg_Instance_sp.summa[3]  := tRows.sum3
        , Budg_Instance_sp.summa[4]  := tRows.sum4
        , Budg_Instance_sp.summa[5]  := tRows.sum5
        , Budg_Instance_sp.summa[6]  := tRows.sum6
        , Budg_Instance_sp.summa[7]  := tRows.sum7
        , Budg_Instance_sp.summa[8]  := tRows.sum8
        , Budg_Instance_sp.summa[9]  := tRows.sum9
        , Budg_Instance_sp.summa[10] := tRows.sum10
        , Budg_Instance_sp.summa[11] := tRows.sum11
        , Budg_Instance_sp.summa[12] := tRows.sum12
       ;
      }
    end;


  }
  stopvisual;
}
window winImportBudget;
Screen scrImportBudget;
  show at (,,, 7);
  Fields
    ListName   : NoProtect,{Font = {backcolor = if(ListName = '', colorneed,0);}};
    File_input :  Protect, PickButton,{Font = {backcolor = if(File_input = '', colorneed,0);}};
    _strResult : skip, {Font = {backcolor = if(_strResult <> '', colorneed,0);}};

  buttons
    cmOK,,,;
    cmCreateDocs,,,;
    cmCancel,,,;
<<'Импорт ТМЦ из EXCEL'
`Наименование листа`.@@@@@@@@@@@@@@@@
`EXCEL Файл`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  <.Загрузить файл.>           <.Создать/обновить бюджет.>            <. Отмена .>
>>
end;
 browse brtRows_br('',,sci1Esc);
  show at(,8,,);
 table tRows_br;
 fields
 {Font = {backcolor = getColor(tRows_br.FlagErr);}};
  tRows_br.nrow        'Строка','в файле' headerAlign = centered:protect,[4];
  tRows_br.podr_kod       'Код','подразделения'     headerAlign = centered:protect,[4];
  tRows_br.cex_kod        'Код','службы'            headerAlign = centered:protect,[4];
  tRows_br.cex_name       'Наименование','службы'   headerAlign = centered:protect,[4];
  tRows_br.MVZ_kod        'Код','МВЗ'               headerAlign = centered:protect,[4];
  tRows_br.MVZ_name       'Наименование','МВЗ'      headerAlign = centered:protect,[4];
  tRows_br.peredel_kod    'Код','передела'          headerAlign = centered:protect,[4];
  tRows_br.peredel_name   'Наименование','передела' headerAlign = centered:protect,[4];
  tRows_br.statya_kod     '№'                       headerAlign = centered:protect,[4];
  tRows_br.statya_name    'Статья','бюджета'        headerAlign = centered:protect,[4];
  tRows_br.Category       'Категория'               headerAlign = centered:protect,[4];
  tRows_br.SHPZ           'СЧЕТ','ШПЗ'              headerAlign = centered:protect,[4];
  tRows_br.sum1           'Январь'                  headerAlign = centered:protect,[4];
  tRows_br.sum2           'Февраль'                 headerAlign = centered:protect,[4];
  tRows_br.sum3           'Март'                    headerAlign = centered:protect,[4];
  tRows_br.sum4           'Апрель'                  headerAlign = centered:protect,[4];
  tRows_br.sum5           'Май'                     headerAlign = centered:protect,[4];
  tRows_br.sum6           'Июнь'                    headerAlign = centered:protect,[4];
  tRows_br.sum7           'Июль'                    headerAlign = centered:protect,[4];
  tRows_br.sum8           'Август'                  headerAlign = centered:protect,[4];
  tRows_br.sum9           'Сентябрь'                headerAlign = centered:protect,[4];
  tRows_br.sum10          'Октябрь'                 headerAlign = centered:protect,[4];
  tRows_br.sum11          'Ноябрь'                  headerAlign = centered:protect,[4];
  tRows_br.sum12          'Декабрь'                 headerAlign = centered:protect,[4];
  tRows_br.Descr       'Описание'         headerAlign = centered:protect,[8];
 end;
end;

procedure importbudget(__cTemplate, __cInstance : comp; __typeTable : word); {
  set _cTemplate := __cTemplate;
  set _cInstance := __cInstance;
  set typeTable := __typeTable;
  var _ibudget_templates : budget_templates;
 _wSTATYA   := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.STATYA');
 _wCATEGORY := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.CATEGORY');
 _wSHPZ     := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.SHPZ');
 _wPODR     := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.PODR');
 _wCEX      := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.CEX');
 _wMVZ      := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.MVZ');
 _wPEREDEL  := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.PEREDEL');

  case typeTable of
     cotblTmpltBudgetVid
    ,cotblInstnBudgetVid
    ,cotblInstnBudgetVidCorr : set ListName := coListNameVid;
     cotblTmpltBudgetSHPZ
    ,cotblInstnBudgetSHPZ
    ,cotblInstnBudgetSHPZCorr : set ListName := coListNameShpz;
  end;

  case typeTable of
     cotblTmpltBudgetVid : {
      ClearFieldState(#tRows_br.podr_kod    , sfVisible);
      ClearFieldState(#tRows_br.cex_kod     , sfVisible);
      ClearFieldState(#tRows_br.cex_name    , sfVisible);
      ClearFieldState(#tRows_br.MVZ_kod     , sfVisible);
      ClearFieldState(#tRows_br.MVZ_name    , sfVisible);
      ClearFieldState(#tRows_br.peredel_kod , sfVisible);
      ClearFieldState(#tRows_br.peredel_name, sfVisible);
      SetFieldState(tRows_br.statya_kod     , sfVisible);
      SetFieldState(tRows_br.statya_name    , sfVisible);
      SetFieldState(tRows_br.Category       , sfVisible);
      ClearFieldState(#tRows_br.SHPZ        , sfVisible);
      ClearFieldState(#tRows_br.sum1        , sfVisible);
      ClearFieldState(#tRows_br.sum2        , sfVisible);
      ClearFieldState(#tRows_br.sum3        , sfVisible);
      ClearFieldState(#tRows_br.sum4        , sfVisible);
      ClearFieldState(#tRows_br.sum5        , sfVisible);
      ClearFieldState(#tRows_br.sum6        , sfVisible);
      ClearFieldState(#tRows_br.sum7        , sfVisible);
      ClearFieldState(#tRows_br.sum8        , sfVisible);
      ClearFieldState(#tRows_br.sum9        , sfVisible);
      ClearFieldState(#tRows_br.sum10       , sfVisible);
      ClearFieldState(#tRows_br.sum11       , sfVisible);
      ClearFieldState(#tRows_br.sum12       , sfVisible);
     }
     cotblTmpltBudgetSHPZ : {
      ClearFieldState(#tRows_br.podr_kod    , sfVisible);
      ClearFieldState(#tRows_br.cex_kod     , sfVisible);
      ClearFieldState(#tRows_br.cex_name    , sfVisible);
      ClearFieldState(#tRows_br.MVZ_kod     , sfVisible);
      ClearFieldState(#tRows_br.MVZ_name    , sfVisible);
      ClearFieldState(#tRows_br.peredel_kod , sfVisible);
      ClearFieldState(#tRows_br.peredel_name, sfVisible);
      SetFieldState(tRows_br.statya_kod     , sfVisible);
      SetFieldState(tRows_br.statya_name    , sfVisible);
      SetFieldState(tRows_br.Category       , sfVisible);
      SetFieldState(#tRows_br.SHPZ        , sfVisible);
      ClearFieldState(#tRows_br.sum1        , sfVisible);
      ClearFieldState(#tRows_br.sum2        , sfVisible);
      ClearFieldState(#tRows_br.sum3        , sfVisible);
      ClearFieldState(#tRows_br.sum4        , sfVisible);
      ClearFieldState(#tRows_br.sum5        , sfVisible);
      ClearFieldState(#tRows_br.sum6        , sfVisible);
      ClearFieldState(#tRows_br.sum7        , sfVisible);
      ClearFieldState(#tRows_br.sum8        , sfVisible);
      ClearFieldState(#tRows_br.sum9        , sfVisible);
      ClearFieldState(#tRows_br.sum10       , sfVisible);
      ClearFieldState(#tRows_br.sum11       , sfVisible);
      ClearFieldState(#tRows_br.sum12       , sfVisible);

     }
      cotblInstnBudgetVid
     ,cotblInstnBudgetVidCorr  : {
      SetFieldState(#tRows_br.podr_kod    , sfVisible);
      SetFieldState(#tRows_br.cex_kod     , sfVisible);
      SetFieldState(#tRows_br.cex_name    , sfVisible);
      SetFieldState(#tRows_br.MVZ_kod     , sfVisible);
      SetFieldState(#tRows_br.MVZ_name    , sfVisible);
      SetFieldState(#tRows_br.peredel_kod , sfVisible);
      SetFieldState(#tRows_br.peredel_name, sfVisible);
      SetFieldState(tRows_br.statya_kod     , sfVisible);
      SetFieldState(tRows_br.statya_name    , sfVisible);
      SetFieldState(tRows_br.Category       , sfVisible);
      ClearFieldState(#tRows_br.SHPZ        , sfVisible);
      SetFieldState(#tRows_br.sum1        , sfVisible);
      SetFieldState(#tRows_br.sum2        , sfVisible);
      SetFieldState(#tRows_br.sum3        , sfVisible);
      SetFieldState(#tRows_br.sum4        , sfVisible);
      SetFieldState(#tRows_br.sum5        , sfVisible);
      SetFieldState(#tRows_br.sum6        , sfVisible);
      SetFieldState(#tRows_br.sum7        , sfVisible);
      SetFieldState(#tRows_br.sum8        , sfVisible);
      SetFieldState(#tRows_br.sum9        , sfVisible);
      SetFieldState(#tRows_br.sum10       , sfVisible);
      SetFieldState(#tRows_br.sum11       , sfVisible);
      SetFieldState(#tRows_br.sum12       , sfVisible);
     }
      cotblInstnBudgetSHPZ
     ,cotblInstnBudgetSHPZCorr : {
      SetFieldState(#tRows_br.podr_kod    , sfVisible);
      SetFieldState(#tRows_br.cex_kod     , sfVisible);
      SetFieldState(#tRows_br.cex_name    , sfVisible);
      SetFieldState(#tRows_br.MVZ_kod     , sfVisible);
      SetFieldState(#tRows_br.MVZ_name    , sfVisible);
      SetFieldState(#tRows_br.peredel_kod , sfVisible);
      SetFieldState(#tRows_br.peredel_name, sfVisible);
      SetFieldState(tRows_br.statya_kod     , sfVisible);
      SetFieldState(tRows_br.statya_name    , sfVisible);
      SetFieldState(tRows_br.Category       , sfVisible);
      SetFieldState(#tRows_br.SHPZ        , sfVisible);
      SetFieldState(#tRows_br.sum1        , sfVisible);
      SetFieldState(#tRows_br.sum2        , sfVisible);
      SetFieldState(#tRows_br.sum3        , sfVisible);
      SetFieldState(#tRows_br.sum4        , sfVisible);
      SetFieldState(#tRows_br.sum5        , sfVisible);
      SetFieldState(#tRows_br.sum6        , sfVisible);
      SetFieldState(#tRows_br.sum7        , sfVisible);
      SetFieldState(#tRows_br.sum8        , sfVisible);
      SetFieldState(#tRows_br.sum9        , sfVisible);
      SetFieldState(#tRows_br.sum10       , sfVisible);
      SetFieldState(#tRows_br.sum11       , sfVisible);
      SetFieldState(#tRows_br.sum12       , sfVisible);

     }
  end;


  if _wSTATYA = 0 or _wCATEGORY = 0 or _wSHPZ = 0 or _wPODR = 0 or _wCEX = 0 or _wMVZ = 0 or _wPEREDEL = 0 {
    stop;abort;exit;
  }
 runwindowmodal(winImportBudget);
}

handleevent
cminit:{
 rereadrecord;
}
cmpick:{
  case curfield of
   #File_input: {
      File_input := GetFileName('*.xlsx;*.xls', 'Выбор файла для загрузки');
      ClearAll;
    }
  end;
rereadrecord;
}
cmOK: {
    if File_input = '' {
     message('не выбран файл шаблона', error) ;
     stop;abort;exit;
    }
    if ListName = '' {
     message('не задано наименование EXCEL листа', error);
     stop;abort;exit;
    }

//    var _srvFileName : string = GetStringParameter('Files', 'OutputFilesDirectory', 0) + OleGenerateGUID+'.xlsx';
    MyLog('File_input ' + File_input);
//    CopyMoveFile(File_input,_srvFileName,false, ecmfClientFrom + ecmfServerTo );
    GetFileFromClient(File_input, true);
    File_input := ConvertClientPathToSrv(File_input);
    MyLog('on server File_input ' + File_input);

  StartNewVisual(vtRotateVisual, vfTimer, 'Он сказал поехали и махнул рукой', 1);
    ClearAll;
    fillrecArrayByTypeTable;

    var _isError : boolean = false;
    MyLog( '***********************************************************************');
    _isError := not CheckFileFillValues(File_input);
    if _isError then {
      ProcessText(_logFile, vfEscable or vfNewTitle or vfMacroSize, 'Протокол обработки файлов и загрузки данных');
     if visualizationactive  StopVisual('The End',vfTimer);
     if visualizationactive  StopVisual('The End',vfTimer);

      stop; abort; exit;
    }

  CheckErrors_tRows;
    set _strResult := '';
   if(getfirst tRows where tRows.FlagErr = 2 )= tsOK {
    set _strResult := 'В файле есть ошибки. Загрузка невозможна';
    if visualizationactive  StopVisual('The End',vfTimer);
    if visualizationactive  StopVisual('The End',vfTimer);
    stop; abort; exit;
  }

 if visualizationactive  StopVisual('The End',vfTimer);
 if visualizationactive  StopVisual('The End',vfTimer);
  rereadrecord(tntRows_br);
} // cmOK
cmCreateDocs: {
  if getfirst tRows <> tsOK {
    Message('Сначала загрузите файл',error);
    stop; abort; exit;
  }
  if(getfirst tRows where tRows.FlagErr = 2 )= tsOK {
    Message('В файле есть ошибки. Загрузка невозможна',error);
    stop; abort; exit;
  }

  var _isError : boolean = false;
   StartNewVisual(vtRotateVisual, vfTimer, 'Он сказал поехали и махнул рукой', 1);
    Insert_budget;
   if visualizationactive  StopVisual('The End',vfTimer);
   ProcessText(_logFile, vfEscable or vfNewTitle or vfMacroSize, 'Протокол работы');
   rereadrecord(tntRows_br);
}
end;
end.
