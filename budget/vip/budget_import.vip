const
end;
#component "BUDGET"
Interface budget_import 'Импорт бюджетов';

#include VarsTypes.var

Table Struct tRows (
    nrow         : longint
  , FlagErr      : byte
  , Descr        : string
  , podr_kod     : string // Код подразделения
  , cex_kod      : string // Код службы
  , cex_name     : string // Наименование службы
  , MVZ_kod      : string // Код МВЗ
  , MVZ_name     : string // Наименование МВЗ
  , peredel_kod  : string // Код передела
  , peredel_name : string // Наименование передела
  , statya_kod   : string // №
  , statya_name  : string // Статья бюджета
  , Category     : string // Категория
  , SHPZ         : string // СЧЕТ ШПЗ
  , sum1         : double // Январь
  , sum2         : double // Февраль
  , sum3         : double // Март
  , sum4         : double // Апрель
  , sum5         : double // Май
  , sum6         : double // Июнь
  , sum7         : double // Июль
  , sum8         : double // Август
  , sum9         : double // Сентябрь
  , sum10        : double // Октябрь
  , sum11        : double // Ноябрь
  , sum12        : double // Декабрь
  , cTmpltSp     : comp
)
with index (
   Index1 = nrow
)
;


procedure MyLog(_log : string); forward;

create view
 var

  ListName   : string = 'Лист1';

  _dateArch  : date = to_date(01,01,2024);

    File_input
  , _strResult
  , _logFile   : string= '';
  typeTable  : word = 0;
    _cTemplate
  , _cInstance : comp;
      _wSTATYA
    , _wCATEGORY
    , _wSHPZ
    , _wPODR
    , _wCEX
    , _wMVZ
    , _wPEREDEL : word;

from
    Budg_Tmplt_sp
  , Budg_Instance_sp
  , spkau spkau_check
  , tRows
  , tRows tRows_BR
;

PROCEdURE ClearAll; {
 delete all tRows;
 EnableFuncCache(true);
 ClearFuncCache;
 rereadrecord;
} // PROCEdURE ClearAll;

