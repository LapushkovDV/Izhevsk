#ifnDef _budget_copy_INCLUDED_
#define _budget_copy_INCLUDED_
#component "BUDGET"

ObjInterface o_budget_copy;
public:
#doc
Копирование шаблона бюджета
 __cTemplate - ссылка на шаблон

Возвращается ссылка на созданный шаблон бюджета
#end
function copytemplate(__cTemplate : comp) : comp;

#doc
Копирование варианта бюджета
 __cInstance - ссылка на вариант

 Возвращается ссылка на созданный вариант бюджета
#end
function  copyinstance(__cInstance : comp) : comp;

end;

