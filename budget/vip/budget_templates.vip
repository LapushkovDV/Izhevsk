#include budget_import.vih
#include budget_templates.vih
#component "BUDGET"
#doc
Шаблоны бюджетов
#end


Interface budget_templates '' (,,sci17EnEsc), EscClose;
create view
var
      _wSTATYA
    , _wCATEGORY
    , _wSHPZ
    , _wPODR
    , _wCEX
    , _wMVZ
    , _wPEREDEL : word;

 as select
 if(Budg_Templates.type = 1
    ,'по виду'
    ,if(Budg_Templates.type = 2
        ,'по ШПЗ'
        ,'НЕИЗВЕСТНЫЙ ТИП'
       )
   ) (fieldname = typeTemplate)
from
   Budg_Templates
 , Budg_Tmplt_sp
 , spKau Statya
 , spKau Category
 , spKau SHPZ
 , Budg_Instance
 , Budg_Instance_sp

 where ((
          Budg_Templates.nrec == Budg_Tmplt_sp.cTemplate
  and Budg_Tmplt_sp.cStatya   == Statya.nrec
  and Budg_Tmplt_sp.cCategory == Category.nrec
  and Budg_Tmplt_sp.cSHPZ     == SHPZ.nrec
 ))
;

function getcheckwgettune(_tuneName : string) : word; {
  result := wgettune(_tuneName);
  if result = 0 {
    message('работа интерфейса невозможна: не установлена настройка ' +
    +''#13'' + gettunename(_tuneName), error);
  }
}


procedure PositionChanged; {
  if Budg_Templates.type = 1 then {
    ClearFieldState(#SHPZ.name, sfVisible);
   } else {
    SetFieldState(#SHPZ.name, sfVisible);
   }
   rereadrecord;
}
browse brbudgetTemplates 'Шаблоны бюджета' (,,sci1478Esc);
//show at (,,,15);
Table Budg_Templates;
Fields
  Budg_Templates.year 'Год'  ('Год шаблона бюджета')  : [12] ,Protect,NoDel;
  typeTemplate        'Тип'  ('тип шаблона бюджета')  : [12] ,Protect,NoDel;
  Budg_Templates.name 'Наименование'  ('наименование шаблона бюджета')  : [12] ,Protect,NoDel;
end;//Browse


Window wnEditTemplate 'Редактирование шаблона бюджета';
Screen ScrEdit (,,sci18Esc);
 Show at (,,,3);
 Table Budg_Templates;
Fields
  Budg_Templates.year ('Год шаблона бюджета')  : NoProtect;
  Budg_Templates.type ('тип шаблона бюджета')  :[ LIST 1'по виду',2'по ШПЗ'], Protect;
  Budg_Templates.name ('наименование шаблона бюджета')  : [12] ,NoProtect;
<<
`год`  .@@@@@@@@@@@ `тип` .@@@@@@@@@
`Наименование`  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;
browse brbudgetTemplatesSP 'позиции шаблона' (,,sci1Esc);
show at (,4,,);
Table Budg_Tmplt_sp;
 Fields
  Statya.code   'Статья код' ('код статьи позиции шаблона бюджета')  : [12] ,Protect,NoDel;
  Statya.name   'Статья'     ('Статья позиции шаблона бюджета')  : [12] ,Protect,NoDel;
  Category.name 'Категория'  ('Категория позиции шаблона бюджета')  : [12] ,Protect,NoDel;
  SHPZ.name     'ШПЗ'        ('ШПЗ позиции шаблона бюджета')  : [12] ,Protect,NoDel;
end;//Browse
end;
windowevent wnEditTemplate;
cminit :{
  PositionChanged
}

cmHotKeys : {
  case CurTable of
  #Budg_Templates: {
    ProcessCommand(RunMenu('GP_budget_template_HotKey'));
  }
  end;
}

end;

TableEvent table Budg_Templates;
cmSetDefault: {
   Budg_Templates.type := 1;
   Budg_Templates.year := year(cur_date);
   Budg_Templates.name := datetostr(cur_date,'DD.MM.YYYY')+' ' + timetostr(cur_time,'HH:MM:SS') + ' ' +USERNAME;
  Insert current Budg_Templates;
  SetNew(false);
  PutCommand(cmEdit)
}
cmCheckField: {
   updatetable;
}
cmInsertRecord: {
  Insert Current Budg_Templates;
  PositionChanged
}
cmUpdateRecord: {
  Update Current Budg_Templates;
  PositionChanged;
}
cmDeleteRecord:
{
var _mesString : string = '';
  if getfirst Budg_Instance where ((Budg_Templates.nrec == Budg_Instance.cTemplate)) = tsOK {
    _mesString := 'По шаблону есть сформированный экземпляр бюджета. ' +
              +''#13'' +'удаление запрещено!';
  }

  _loop Budg_Tmplt_sp {
   if getfirst fastfirstrow Budg_Instance_sp where ((Budg_Tmplt_sp.nrec == Budg_Instance_sp.cTmpltSp)) = tsOK {
    _mesString := 'К позициям шаблона есть записи экземпляра/факта' +
              +''#13'' +'удаление запрещено!';
     break;
   }
  }

  if _mesString <> '' {
    message(_mesString, error);
    exit;
  }
   if message('Удалить шаблон бюджета?', YesNo)=cmYes {
       _loop Budg_Tmplt_sp delete current Budg_Tmplt_sp;
       delete Current Budg_Templates;
    }
}

cmPositionChanged:{
  PositionChanged;
}
end;


handleevent
cminit : {
 _wSTATYA   := getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.STATYA');
 _wCATEGORY := getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.CATEGORY');
 _wSHPZ     := getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.SHPZ');
 _wPODR     := getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.PODR');
 _wCEX      := getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.CEX');
 _wMVZ      := getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.MVZ');
 _wPEREDEL  := getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.PEREDEL');


 if _wSTATYA = 0 or _wCATEGORY = 0 or _wSHPZ = 0 or _wPODR = 0 or _wCEX = 0 or _wMVZ = 0 or _wPEREDEL = 0 {
    stop;abort;exit;
  }

}
cmDefault:{
  PutCommand(cmEdit);
}
cmEdit:{
  RunWindowModal(wnEditTemplate);
}
cmvalue1 : {
  var _ibudget_import : budget_import;
  _ibudget_import.importbudget(Budg_Templates.nrec, 0h, if(Budg_Templates.type = 1, cotblTmpltBudgetVid, cotblTmpltBudgetSHPZ));
  rereadrecord;
}
cmPickAttr: {
  if UpdateTable
  case CurTable of
  #Budg_Templates: RunInterface('C_EXTCLASS::Attribute', coBudg_Templates, Budg_Templates.nRec);
  end;
  ClearFuncCache;
}

end;
end.
GP_budget_template_HotKey Menu
{
- 'Импорт данных'   , cmValue1, 'Импортировать шаблон бюджета из EXCEL',  ,'',,sci1Esc;
 -----------;
- 'Внешние атрибуты', cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}
