#include budget_templates.vih
#include budget_import.vih
#include budget_print.vih

#component "BUDGET"
#doc
Варианты бюджетов
#end


Interface budget_instance '' (,,sci17EnEsc), EscClose;
create view
var
      _wSTATYA
    , _wCATEGORY
    , _wSHPZ
    , _wPODR
    , _wCEX
    , _wMVZ
    , _wPEREDEL : word;

 as select
  if(Budg_Templates.type = 1
    ,'по виду'
    ,if(Budg_Templates.type = 2
        ,'по ШПЗ'
        ,'НЕИЗВЕСТНЫЙ ТИП'
       )
   ) (fieldname = typeTemplate)
 , if(Budg_Templates_select.type = 1
    ,'по виду'
    ,if(Budg_Templates_select.type = 2
        ,'по ШПЗ'
        ,'НЕИЗВЕСТНЫЙ ТИП'
       )
   ) (fieldname = typeTemplateSelect)

   ,   Budg_Instance_sp.summa[1] + Budg_Instance_sp.summa[2] + Budg_Instance_sp.summa[3] + Budg_Instance_sp.summa[4] + Budg_Instance_sp.summa[5] + Budg_Instance_sp.summa[6]  +
     + Budg_Instance_sp.summa[7] + Budg_Instance_sp.summa[8] + Budg_Instance_sp.summa[9] + Budg_Instance_sp.summa[10] + Budg_Instance_sp.summa[11] + Budg_Instance_sp.summa[12]
      (fieldname = SUMYEAR)
from
   Budg_Templates
 , Budg_Tmplt_sp
 , spKau Statya
 , spKau Category
 , spKau SHPZ
 , spKau Podr
 , spKau Cex
 , spKau MVZ
 , spKau Peredel

 , Budg_Instance
 , Budg_Instance_sp
 , x$users

 , Budg_Templates    Budg_Templates_select

 where ((    Budg_Instance.nrec == Budg_Instance_sp.cInstance
    and Budg_Instance.cTemplate == Budg_Templates.nrec
//  and     Budg_Templates.nrec   == Budg_Tmplt_sp.cTemplate
  and Budg_Instance_sp.cTmpltSp == Budg_Tmplt_sp.nrec
  and Budg_Tmplt_sp.cStatya     == Statya.nrec
  and Budg_Tmplt_sp.cCategory   == Category.nrec
  and Budg_Tmplt_sp.cSHPZ       == SHPZ.nrec
  and Budg_Instance_sp.cPodr    == Podr.nrec
  and Budg_Instance_sp.cCex     == Cex.nrec
  and Budg_Instance_sp.cMVZ     == MVZ.nrec
  and Budg_Instance_sp.cPeredel == Peredel.nrec
  and Budg_Instance_sp.atl_lastuser == x$users.atl_nrec
 ))

bounds byAuthor userid /== Budg_Instance_sp.ATL_LASTUSER (noindex) // для демонстрации достаточно, а так надо норм права делать
;

function getcheckwgettune(_tuneName : string) : word; {
  result := wgettune(_tuneName);
  if result = 0 {
    message('работа интерфейса невозможна: не установлена настройка ' +
    +''#13'' + gettunename(_tuneName), error);
  }
}




browse brbudgetTemplates 'Варианты бюджета' (,,sci1478Esc);
//show at (,,,15);
Table Budg_Instance;
Fields
  Budg_Templates.year 'Год'  ('Год шаблона бюджета')  : [12] ,Protect,NoDel;
  Budg_Instance.status 'Статус'  ('статус бюджета')  : [12] ,Protect,NoDel;
  Budg_Instance.name   'Наименование'  ('наименование бюджета')  : [12] ,Protect,NoDel;
  typeTemplate        'Тип'  ('тип шаблона бюджета')  : [12] ,Protect,NoDel;
  Budg_Templates.year 'Наименование','шаблона'  ('наименование шаблона бюджета')  : [12] ,Protect,NoDel;
  Budg_Templates.name 'Наименование','шаблона'  ('наименование шаблона бюджета')  : [12] ,Protect,NoDel;
end;//Browse


Window wnEditInstance 'Просмотр бюджета';
Screen ScrEdit (,,sci18Esc);
 Show at (,,,3);
 Table Budg_Instance;
Fields
  Budg_Templates.year ('Год шаблона бюджета')  : Skip;
  typeTemplate ('тип шаблона бюджета')  : Skip;
  Budg_Instance.status ('статус бюджета')  : [12] ,Protect,NoDel;
  Budg_Templates.name ('наименование шаблона бюджета')  : [12] ,Protect, pickbutton;
  Budg_Instance.name   ('наименование бюджета')  : [12] ,noProtect;
<<
`год`  .@@@@@@@@@@@ `тип` .@@@@@@@@@ `статус`.@@@@@@@@@
`Шаблон`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
`Наименование`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;
browse brbudgetTemplatesSP 'позиции шаблона' (,,sci1Esc);
show at (,4,,);
Table Budg_Instance_sp;
 Fields
  x$users.XU$LOGINNAME 'Автор'            : [8] ,Protect,NoDel;
  Podr.code 'Код подразделения'           : [12] ,Protect,NoDel;
  Cex.code  'Код службы'                  : [12] ,Protect,NoDel;
  Cex.name  'Наименование службы'         : [12] ,Protect,NoDel;
  MVZ.code  'Код МВЗ'                     : [12] ,Protect,NoDel;
  MVZ.name  'Наименование МВЗ'            : [12] ,Protect,NoDel;
  Peredel.code 'Код передела'             : [12] ,Protect,NoDel;
  Peredel.name 'Наименование передела'    : [12] ,Protect,NoDel;
  Statya.code   'Статья код' ('код статьи позиции шаблона бюджета')  : [12] ,Protect,NoDel;
  Statya.name   'Статья'     ('Статья позиции шаблона бюджета')  : [12] ,Protect,NoDel;
  Category.name 'Категория'  ('Категория позиции шаблона бюджета')  : [12] ,Protect,NoDel;
  SHPZ.name     'ШПЗ'        ('ШПЗ позиции шаблона бюджета')  : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[1]  'Январь'     : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[2]  'Февраль'    : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[3]  'Март'       : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[4]  'Апрель'     : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[5]  'Май'        : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[6]  'Июнь'       : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[7]  'Июль'       : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[8]  'Август'     : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[9]  'Сентябрь'   : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[10] 'Октябрь'    : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[11] 'Ноябрь'     : [12] ,Protect,NoDel;
  Budg_Instance_sp.summa[12] 'Декабрь'    : [12] ,Protect,NoDel;
  SUMYEAR                    'Год'        : [12] ,Protect,NoDel;
end;//Browse
end;
procedure PositionChanged; {
  if Budg_Templates.type = 1 then {
    ClearFieldState(#SHPZ.name, sfVisible);
   } else {
    SetFieldState(#SHPZ.name, sfVisible);
   }

  if wgettune('GP_ADDITIONAL_TUNES.BUDGET.TYPEUSER') = 0
   then pushbounds(tbbyAuthor)
   else popbounds(tbbyAuthor);

   setwindowtitle(wnEditInstance, 'Просмотр бюджета ' + if(wgettune('GP_ADDITIONAL_TUNES.BUDGET.TYPEUSER') = 0, '(записи пользователя "' + username+'")', '(записи всех пользователей)'));
   rereadrecord;
}
windowevent wnEditInstance;
cminit :{
  PositionChanged;
}

cmHotKeys : {
  case CurTable of
  #Budg_Instance: {
    ProcessCommand(RunMenu('GP_budget_instance_HotKey'));
  }
  end;
}

end;

TableEvent table Budg_Instance;
cmSetDefault: {
//  message('Budg_Instance');
  Insert current Budg_Instance;
  SetNew(false);
  PutCommand(cmEdit)
}
cmCheckField: {
   updatetable;
}
cmInsertRecord: {
  Insert Current Budg_Instance;
  PositionChanged
}
cmUpdateRecord: {
  Update Current Budg_Instance;
  PositionChanged;
}
cmDeleteRecord:
{
   if message('Удалить бюджет?', YesNo)=cmYes {
       _loop Budg_Instance_sp delete current Budg_Instance_sp;
       delete Current Budg_Instance;
    }
}

cmPositionChanged:{
  PositionChanged;
}
end;

window winBudg_Templates_select 'Выбор шаблона бюджета', doaccept;
browse brBudg_Templates_select 'Выбор шаблона бюджета' (,,sci1Esc);
//show at (,,,15);
Table Budg_Templates_select;
Fields
  Budg_Templates_select.year 'Год'  ('Год шаблона бюджета')  : [8] ,Protect,NoDel;
  typeTemplateSelect        'Тип'  ('тип шаблона бюджета')  : [10] ,Protect,NoDel;
  Budg_Templates_select.name 'Наименование','шаблона'  ('наименование шаблона бюджета')  : [12] ,Protect,NoDel;
end;//Browse
end;
windowevent winBudg_Templates_select;
cmDefault: {
 closewindow(winBudg_Templates_select);
}
end;

handleevent
cminit : {
  var _ibudget_templates : budget_templates;
 _wSTATYA   := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.STATYA');
 _wCATEGORY := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.CATEGORY');
 _wSHPZ     := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.SHPZ');
 _wPODR     := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.PODR');
 _wCEX      := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.CEX');
 _wMVZ      := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.MVZ');
 _wPEREDEL  := _ibudget_templates.getcheckwgettune('GP_ADDITIONAL_TUNES.BUDGET.PEREDEL');
//  message('cminit : { ');

 if _wSTATYA = 0 or _wCATEGORY = 0 or _wSHPZ = 0 or _wPODR = 0 or _wCEX = 0 or _wMVZ = 0 or _wPEREDEL = 0 {
    stop;abort;exit;
  }

}
cmDefault:{
  PutCommand(cmEdit);
}
cmEdit:{
  RunWindowModal(wnEditInstance);
}
cmvalue1 : {
  if Budg_Instance.cTemplate = 0h {
    message('Не выбран шаблон бюджета', error);
    stop;abort;exit;
  }
  var _ibudget_import : budget_import;
  _ibudget_import.importbudget(Budg_Templates.nrec, Budg_Instance.nrec, if(Budg_Templates.type = 1, cotblInstnBudgetVid, cotblInstnBudgetSHPZ));
  rereadrecord;
}
cmvalue2 : {
  if Budg_Instance.cTemplate = 0h {
    message('Не выбран шаблон бюджета', error);
    stop;abort;exit;
  }
  var _ibudget_import : budget_import;
  _ibudget_import.importbudget(Budg_Templates.nrec, Budg_Instance.nrec, if(Budg_Templates.type = 1, cotblInstnBudgetVidCorr, cotblInstnBudgetSHPZCorr));
  rereadrecord;
}

cmPickAttr: {
  if UpdateTable
  case CurTable of
  #Budg_Instance: RunInterface('C_EXTCLASS::Attribute', coBudg_Instance, Budg_Instance.nRec);
  end;
  ClearFuncCache;
}
cmPick: {
  case curfield of
  #Budg_Templates.name :
   if runwindowmodal(winBudg_Templates_select) = cmDefault {
       set Budg_Instance.cTemplate := Budg_Templates_select.nrec;
       updatetable;
   }
  end;
  rereadrecord;
}
cmPrintDoc: {
  var _ibudget_print : budget_print;
   _ibudget_print.printInstance(Budg_Instance.nrec);
}
end;
end.
GP_budget_instance_HotKey Menu
{
- 'Импорт данных'   , cmValue1, 'Импортировать шаблон бюджета из EXCEL',  ,'',,sci1Esc;
- 'Импорт корректировки данных'   , cmValue2, 'Импортировать корректировку шаблона бюджета из EXCEL',  ,'',,sci1Esc;
 -----------;
- 'Печать бюджета', cmPrintDoc,'Печать варианта бюджета (все позиции)',,'Ctrl+P',kbCtrlP,sci1Esc;
 -----------;
- 'Внешние атрибуты', cmPickAttr , 'Заполнение внешних атрибутов по данной позиции', hcGkatalM1Attr, 'Alt+A', kbAltA, sci1Esc;

}
