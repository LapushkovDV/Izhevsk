/*************************************************************************************************\
* Наименование: Создание настроек компоненты                                                      *
* Контур/Модуль: Кадры                                                                            *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *
\*************************************************************************************************/
#include TuneSpec.vih

#include CreateTune.vih

Handler with replace budget_DateModifyTune on extensionPoint
  epDateModifyTuneEx (TS: ObjStartCreateTuneEx) [1]
Action
{
  // Здесь указываем дату, когда последний раз изменяли этот файл, чтобы автоматически запускалось
  // обновление реестра настроек
  TS.SetLastDateModTuneComp('budget', 01, 07, 2018);
  Result := true;
}

Handler with replace GP_CreateTune_budget on extensionPoint
  epCreateTuneComponent (TR: ObjCreateTuneEx) [210]
Action
{
  Result := true;
  //----------------------------------------------------------------------------
  // Обязательно установить  имя компонента
  TR.SetComponent('BUDGET');
  //----------------------------------------------------------------------------
  //---------------------
  // Главный раздел
  //---------------------
  TR.SetParent('Tune');
  TR.AddPartA('GP_ADDITIONAL_TUNES','Дополнительные настройки','');
  //------------------------------------------------
  // Главный раздел
  TR.SetParent('GP_ADDITIONAL_TUNES');
  TR.AddPartA('GP_ADDITIONAL_TUNES.BUDGET','Бюджет','');
  TR.SetParent('GP_ADDITIONAL_TUNES.BUDGET');
  TR.AddTuneU('GP_ADDITIONAL_TUNES.EM_IIKO.SETUDERTOALL', 'Тип пользователя бюджетов', ftList,1,'','');
      TR.AddList(0, 'Пользователь');
      TR.AddList(1, 'Администратор');

  TR.AddTuneS('GP_ADDITIONAL_TUNES.BUDGET.STATYA','Аналитика-статья', ftWord,0,'','');
   TR.AddIntr('GetKauTable'); // LongVal wGetTune
  TR.AddTuneS('GP_ADDITIONAL_TUNES.BUDGET.CATEGORY','Аналитика-категория', ftWord,0,'','');
   TR.AddIntr('GetKauTable'); // LongVal wGetTune
  TR.AddTuneS('GP_ADDITIONAL_TUNES.BUDGET.SHPZ','Аналитика-ШПЗ', ftWord,0,'','');
   TR.AddIntr('GetKauTable'); // LongVal wGetTune
  TR.AddTuneS('GP_ADDITIONAL_TUNES.BUDGET.PODR'   ,'Аналитика-Подразделение', ftWord,0,'','');
    TR.AddIntr('GetKauTable'); // LongVal wGetTune
  TR.AddTuneS('GP_ADDITIONAL_TUNES.BUDGET.CEX'    ,'Аналитика-Цех', ftWord,0,'','');
   TR.AddIntr('GetKauTable'); // LongVal wGetTune
  TR.AddTuneS('GP_ADDITIONAL_TUNES.BUDGET.MVZ'    ,'Аналитика-МВЗ', ftWord,0,'','');
   TR.AddIntr('GetKauTable'); // LongVal wGetTune
  TR.AddTuneS('GP_ADDITIONAL_TUNES.BUDGET.PEREDEL','Аналитика-Передел', ftWord,0,'','');
   TR.AddIntr('GetKauTable'); // LongVal wGetTune

}
