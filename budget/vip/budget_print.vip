#include budget_print.vih
#include budget_import.vih

#component "BUDGET"

#doc
 Печать бюджетов
#end

Interface budget_print 'отчет о внешней потребности на основании плана снабжения';


create view
 var
  column0 : word = 0;

   _xlListName : string;

  _cTemplate
, _cInstance : comp;

 _ibudget_import : budget_import;
as select
       Budg_Instance_sp.summa[1] + Budg_Instance_sp.summa[2] + Budg_Instance_sp.summa[3] + Budg_Instance_sp.summa[4] + Budg_Instance_sp.summa[5] + Budg_Instance_sp.summa[6]  +
     + Budg_Instance_sp.summa[7] + Budg_Instance_sp.summa[8] + Budg_Instance_sp.summa[9] + Budg_Instance_sp.summa[10] + Budg_Instance_sp.summa[11] + Budg_Instance_sp.summa[12]
      (fieldname = SUMYEAR)

from
   Budg_Templates
 , Budg_Tmplt_sp
 , spKau Statya
 , spKau Category
 , spKau SHPZ
 , spKau Podr
 , spKau Cex
 , spKau MVZ
 , spKau Peredel

 , Budg_Instance
 , Budg_Instance_sp

where ((
                     _cTemplate == Budg_Templates.nrec
  and                _cInstance == Budg_Instance.nrec
      ))
bounds byTemplate
          Budg_Templates.nrec   == Budg_Tmplt_sp.cTemplate
  and Budg_Tmplt_sp.cStatya     == Statya.nrec
  and Budg_Tmplt_sp.cCategory   == Category.nrec
  and Budg_Tmplt_sp.cSHPZ       == SHPZ.nrec

bounds byInstance
             Budg_Instance.nrec == Budg_Instance_sp.cInstance
  and Budg_Instance_sp.cPodr    == Podr.nrec
  and Budg_Instance_sp.cCex     == Cex.nrec
  and Budg_Instance_sp.cMVZ     == MVZ.nrec
  and Budg_Instance_sp.cPeredel == Peredel.nrec
  and Budg_Instance_sp.cTmpltSp == Budg_Tmplt_sp.nrec
  and Budg_Tmplt_sp.cStatya     == Statya.nrec
  and Budg_Tmplt_sp.cCategory   == Category.nrec
  and Budg_Tmplt_sp.cSHPZ       == SHPZ.nrec

;

function CreateExcel (FExcelName : string) : boolean; {
 //_ibudget_import.mylog('CreateExcel FExcelName = ' + FExcelName);
  setvisualheader('Инициализация EXCEL');
    result := true;

    DeleteFile(FExcelName);

    if (not xlCreateExcel(FExcelName, true))
    {
      message('ОШИБКА! Не удалось инициализировать сессию Excel', Error);
      xlKillExcel;
      result := false;
      exit;
    }

    if (not xlIsExcelValid)
    {
      message('ОШИБКА! Не удалось инициализировать сессию Excel', Error);
      xlKillExcel;
      result := false;
      exit
    }
  var xlCount : word;
  xlCount := 0;
   Do
   {
    xlGetSheetsCount(xlCount);
    xlDeleteSheet(xlCount);
//     _ibudget_import.mylog('CreateExcel xlCount = ' + xlCount);
   } while xlCount > 1

    xlSetActiveSheet(1);
    xlSetSheetName(1, _xlListName+'_'+UserName);
}

Procedure MyPrintMatrixToExcel(var nrow, nrowReal : longint); {
//       _ibudget_import.mylog('MyPrintMatrixToExcel nrow = ' + string(nrow));
 if (nrow + nrowReal) mod 2399 = 0 then {
   SetVisualheader('Формирование отчета'+
            ''#13'' + 'Выгружено строк ' + string(nrowReal));
   }

 if nrow = 500 then
  {
   xlWritematrixToExcel(nrowReal,1+column0);
   xlclearMatrix;
   nrowReal := nrowReal + nrow-1;
   nrow := 1;
  }
}


Procedure PrintLineReport_Matrix; {
  var column_count : longint = 0;
  var filename : string = GetStringParameter('Files','OutputFilesDirectory',0)+'BUDGET_' + if(_cInstance = 0h,'template','instance') + '_'+UserName + '_'+datetostr(cur_date, 'YYYYMMDD')+'_'+TimeToStr(Cur_Time,'HHMMSS')+'.xlsx';
  if not CreateExcel(filename)
    then {Stop; Abort; exit;}


 setvisualheader('Печать заголовка');

 column_count := if(Budg_Templates.type = 1,23,24); // по ШПЗ на 1 колонку больше (как раз ЩПЗ)

 xlCreateMatrix(500,column_count);

 var Nrow0, Nrow, column, nrowreal : longint;
 nrowreal := 1;
 Nrow := column := 1;

 XlSetColumnWidth(1,1,1,1,1);
 Nrow++;
 Nrow0 := Nrow;
 xlStWriteToMatrix(nrow, 1,'Бюджет затрат на оплату труда АО "АВТОВАЗ" в разбивке по ' +if(Budg_Templates.type = 1,'видам', 'ШПЗ') + 'на '+string(Budg_Templates.year)+' год');
 xlMergeCells(nrow,column+column0,nrow,column+column0+8);
 Nrow++;
 xlStWriteToMatrix(nrow, 1,Budg_Instance.name);
 xlMergeCells(nrow,column+column0,nrow,column+column0+8);
 Nrow++;
 Nrow++;
 column := 1;
 XlSetColumnWidth(10,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Код подразделения'); column++;
 XlSetColumnWidth(10,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Код службы'); column++;
 XlSetColumnWidth(22,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Наименование службы'); column++;
 XlSetColumnWidth(10,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Код МВЗ'); column++;
 XlSetColumnWidth(22,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Наименование МВЗ'); column++;
 XlSetColumnWidth(10,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Код передела'); column++;
 XlSetColumnWidth(22,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Наименование передела'); column++;
 XlSetColumnWidth(8,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'№'); column++;
 XlSetColumnWidth(28,1,column,1,column);
 xlStWriteToMatrix(nrow, column,if(Budg_Templates.type = 1,'Показатель','Статья бюджета')); column++;
 XlSetColumnWidth(18,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Категория'); column++;
 if Budg_Templates.type = 2 {
   XlSetColumnWidth(10,1,column,1,column);
   xlStWriteToMatrix(nrow, column,'СЧЕТ ШПЗ'); column++;
  }
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Январь'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Февраль'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Март'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Апрель'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Май'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Июнь'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Июль'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Август'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Сентябрь'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Октябрь'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Ноябрь'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'Декабрь'); column++;
 XlSetColumnWidth(12,1,column,1,column);
 xlStWriteToMatrix(nrow, column,'ГОД');
 Nrow++;
 #declare bodyloop
    column :=1;
   MyPrintMatrixToExcel(Nrow,NrowReal);
      if _cInstance <> 0h xlStWriteToMatrix(nrow, column, Podr.code); column++;
      if _cInstance <> 0h xlStWriteToMatrix(nrow, column, Cex.code); column++;
      if _cInstance <> 0h xlStWriteToMatrix(nrow, column, Cex.name); column++;
      if _cInstance <> 0h xlStWriteToMatrix(nrow, column, MVZ.code); column++;
      if _cInstance <> 0h xlStWriteToMatrix(nrow, column, MVZ.name); column++;
      if _cInstance <> 0h xlStWriteToMatrix(nrow, column, Peredel.code); column++;
      if _cInstance <> 0h xlStWriteToMatrix(nrow, column, Peredel.name); column++;
     xlStWriteToMatrix(nrow, column, Statya.code); column++;
     xlStWriteToMatrix(nrow, column, Statya.name); column++;
     xlStWriteToMatrix(nrow, column, Category.name); column++;
     if Budg_Templates.type = 2 {
       xlStWriteToMatrix(nrow, column, SHPZ.name); column++;
      }
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[1])  ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[2])  ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[3])  ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[4])  ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[5])  ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[6])  ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[7])  ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[8])  ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[9])  ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[10]) ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[11]) ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, Budg_Instance_sp.summa[12]) ; column++;
      if _cInstance <> 0h xldoWriteToMatrix(nrow, column, SUMYEAR)  ;

   Nrow++;

 #end
 if _cInstance = 0h then {
     _loop Budg_Tmplt_sp {
        #bodyloop
     }
    } else {
       _loop Budg_Instance_sp {
          #bodyloop
       }
     }


 xlWriteMatrixToExcel(NrowReal,1+column0);

  //xlwraptext(1, 1, nrow+nrowreal-2, column_count + 1);
  setvisualheader('"Разлиновка" отчета');
 xlFrameCells(63, 2, 1, 1, Nrow0, 1, nrow+nrowreal-2, column_count);

 xlSetNumberFormat('# ##0,00',3,column_count-12,nrow+nrowreal-2, column_count);

// xlSetNumberFormat('# ##0',3,_column_qoute,nrow+nrowreal-2, _column_qoute);
 xlSaveWorkBookByName(filename);
 xlKillExcel;
}


procedure printInstance(__cInstance : comp); {

 set _cInstance := __cInstance;
 if getfirst Budg_Instance <> tsOK {
   message('Не найден вариант бюджета ' + string(__cInstance,0,0), error);
   exit;
  }
 set _cTemplate := Budg_Instance.cTemplate;
 set _xlListName := if(Budg_Templates.type = 1,'бюджет (по видам)','бюджет (по ШПЗ)');

popbounds(tbbyTemplate);
pushbounds(tbbyInstance);

StartNewVisual(vtRotateVisual, vfBreak+vfTimer,'Формирование отчета' , 1);
 PrintLineReport_Matrix;
if VisualizationActive then stopvisual;
}

procedure printTemplate(__cTemplate : comp); {
 set _cInstance := 0h;
 set _cTemplate := __cTemplate;
 if getfirst Budg_Templates <> tsOK {
   message('Не найден шаблон бюджета ' + string(__cTemplate,0,0), error);
   exit;
  }
 set _xlListName := if(Budg_Templates.type = 1,'бюджет (по видам)','бюджет (по ШПЗ)');

popbounds(tbbyInstance);
pushbounds(tbbyTemplate);


 StartNewVisual(vtRotateVisual, vfBreak+vfTimer,'Формирование отчета' , 1);
  PrintLineReport_Matrix;
 if VisualizationActive then stopvisual;
}

handleevent
cminit:{
}
end;
end.
