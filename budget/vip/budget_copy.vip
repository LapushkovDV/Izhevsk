/*************************************************************************************************\
* Наименование: Ижевск. Импорт складов (НЕ подразделений)                                         *
* Контур/Модуль:                                                                                  *
* Примечание:                                                                                     *
*                                                                                                 *
* Вид работы  |Номер         |Дата    |Исполнитель              |Проект                           *
* ----------------------------------------------------------------------------------------------- *

\*************************************************************************************************/
#include budget_copy.vih

const
end;
#component "BUDGET"
Interface budget_copy 'Импорт бюджетов';

create view
 var
     _cTemplate
  , _cInstance : comp;
from
    Budg_Tmplt_sp
  , Budg_Instance_sp
  , Budg_Templates
  , Budg_Instance
  , Budg_Tmplt_sp Budg_Tmplt_sp_new
  , Budg_Instance_sp Budg_Instance_sp_new
  , Budg_Templates   Budg_Templates_new
  , Budg_Instance    Budg_Instance_new

 WHERE ((       _cTemplate == Budg_Templates.nrec
   and Budg_Templates.nrec == Budg_Tmplt_sp.cTemplate
            and _cInstance == Budg_Instance.nrec
    and Budg_Instance.nrec == Budg_Instance_sp.cInstance
       ))
;

function copytemplate(__cTemplate : comp) : comp; {
  result := 0h;
  set _cTemplate := __cTemplate;
  if getfirst Budg_Templates <> tsOK {exit;}
    Budg_Templates_new.buffer := Budg_Templates.buffer;
    Budg_Templates_new.nrec   := 0h;
    Budg_Templates_new.name   := 'КОПИЯ (' + datetostr(cur_date,'DD.MM.YYYY')+' ' + timetostr(cur_time,'HH:MM:SS') + ' ' +USERNAME+ ') ' + Budg_Templates_new.name;
   if insert current Budg_Templates_new <> tsOK {exit;}
  StartNewVisual(vtRotateVisual, +vfTimer,'Копирование шаблона бюджета' , 1);
  _loop Budg_Tmplt_sp {
    Budg_Tmplt_sp_new.buffer    := Budg_Tmplt_sp.buffer;
    Budg_Tmplt_sp_new.nrec      := 0h;
    Budg_Tmplt_sp_new.cTemplate := Budg_Templates_new.nrec;
   insert current Budg_Tmplt_sp_new;
  }
  result := Budg_Templates_new.nrec;
  Stopvisual;
}

function copyinstance(__cInstance : comp) : comp; {

  result := 0h;
  set _cInstance := __cInstance;
  if getfirst Budg_Instance <> tsOK {exit;}
    Budg_Instance_new.buffer := Budg_Instance.buffer;
    Budg_Instance_new.nrec   := 0h;
    Budg_Instance_new.name   := 'КОПИЯ (' + datetostr(cur_date,'DD.MM.YYYY')+' ' + timetostr(cur_time,'HH:MM:SS') + ' ' +USERNAME+ ')   ' + Budg_Instance_new.name;
   if insert current Budg_Instance_new <> tsOK {exit;}
  StartNewVisual(vtRotateVisual, +vfTimer,'Копирование варианта бюджета' , 1);
  _loop Budg_Instance_sp {
    Budg_Instance_sp_new.buffer    := Budg_Instance_sp.buffer;
    Budg_Instance_sp_new.nrec      := 0h;
    Budg_Instance_sp_new.cInstance := Budg_Instance_new.nrec;
   insert current Budg_Instance_sp_new;
  }
  result := Budg_Instance_new.nrec;
  Stopvisual;
}

handleevent
cminit:{
 rereadrecord;
}
end;
end.
