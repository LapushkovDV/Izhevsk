//Drop table Budg_Templates;
//Drop table Budg_Tmplt_sp;
//Drop table Budg_Instance;
//Drop table Budg_Instance_sp;

Create table Budg_Templates "Шаблоны бюджетов"
With table_Code = 31625
With replace
with tableoptions Branched
(
  NRec : comp "Номер записи",
  year : word "Год",
  type : byte "Тип шаблона (по ШПЗ, по виду)",
  name : string "Наименование"
)
With index
(
  i_nrec = NRec(Unique, Surrogate, Journal),
  i_year = year
)
;

Create table  Budg_Tmplt_sp "Шаблоны бюджетов. Спецификация"
With table_Code = 31626
With replace
with tableoptions Branched
(
  NRec      : comp                "Номер записи",
  cTemplate : ref(Budg_Templates) "Шаблон",
  cStatya   : ref(Spkau) "Статья",
  cCategory : ref(Spkau) "Категория",
  cSHPZ     : ref(Spkau) "ШПЗ"
)
With index
(
  i_nrec   = NRec(Unique, Surrogate, Journal),
  i_analit = cTemplate + cStatya + cCategory + cSHPZ
)
;

Create table  Budg_Instance "Экземпляры бюджета"
With table_Code = 31627
With replace
with tableoptions Branched
(
  NRec : comp "Номер записи",
  cTemplate : ref(Budg_Templates) "Шаблон",
  status    : byte   "Статус",
  name      : string "Наименование"
)
With index
(
  i_nrec = NRec(Unique, Surrogate, Journal),
  i_tmplt = cTemplate
)
;

Create table  Budg_Instance_sp "Экземпляры бюджета спец"
With table_Code = 31628
With replace
with tableoptions Branched
(
  NRec : comp "Номер записи",
  cTemplate : ref(Budg_Templates) "Шаблон",
  cInstance : ref(Budg_Instance)  "Экземпляр",
  planfact  : byte                "1-план,2-факт",
  cTmpltSp  : ref(Budg_Tmplt_sp)  "Позиция шаблона",
  cPodr     : ref(Spkau) "Подразделение",
  cCex      : ref(Spkau) "Цех",
  cMVZ      : ref(Spkau) "МВЗ",
  cPeredel  : ref(Spkau) "Передел",
  summa     : array[1..12] of double "Суммы по месяцам"
)
With index
(
  i_nrec      = NRec(Unique, Surrogate, Journal),
  i_tmpltsp   = cTmpltSp,
  i_pftmpltsp = planfact + cTmpltSp,
  i_instance  = cInstance,
  i_Template  = cTemplate,
  i_Analitika = planfact + cTmpltSp + cPodr + cCex + cMVZ + cPeredel
)
;


