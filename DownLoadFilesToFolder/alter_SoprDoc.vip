////////////// подменяем обработчик событий 
#component "L_SOPRDOC"
#declare inheritedcmAddMenu(cmAddMenu)
   {
   var tmpmrk : TPtr = InitMarker('Algoritm_DownLoadFilesToFolder', 8, 100, 10);
   clearMarker(tmpmrk);
   pMarker.ExportTo(tmpmrk);
   donemarker(tmpmrk, 'Algoritm_DownLoadFilesToFolder');
   inherited::handleEvent(#cmAddMenu);
  }
#end
alter interface SOPRDOCB;
Handleevent
cmAddMenu01:  #inheritedcmAddMenu(cmAddMenu01)
cmAddMenu02:  #inheritedcmAddMenu(cmAddMenu02)
cmAddMenu03:  #inheritedcmAddMenu(cmAddMenu03)
cmAddMenu04:  #inheritedcmAddMenu(cmAddMenu04)
cmAddMenu05:  #inheritedcmAddMenu(cmAddMenu05)
cmAddMenu06:  #inheritedcmAddMenu(cmAddMenu06)
cmAddMenu07:  #inheritedcmAddMenu(cmAddMenu07)
cmAddMenu08:  #inheritedcmAddMenu(cmAddMenu08)
cmAddMenu09:  #inheritedcmAddMenu(cmAddMenu09)
cmAddMenu10:  #inheritedcmAddMenu(cmAddMenu10)
end;
end. // interface
