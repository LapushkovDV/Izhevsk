//***********************************
VipInterface Algoritm_DownLoadFilesToFolder Implements oAlgoritm_Sys;
//***********************************
#doc
Алгоритм для загрузки файлов в папку
#end
Interface Algoritm_DownLoadFilesToFolder;
//***********************************
Var
 _TypeCpNrec : word;
 _cpNrec     : comp;
Create view
Var
 nrecFormPl    : Comp;//Настройка алгоритма
 _logname : string;
As Select
 FormPl.nrec
From
   FormPl

Where
((
       nrecFormPl == FormPl.NRec
))
;

Function GenerateNewFile: string; {
 result := AddSlashToPath(GetStringParameter('Files','OutputFilesDirectory',0))+ 'Algoritm_DownLoadFilesToFolder_'+DateToStr(cur_date,'YYYYMMDD')+'_'+timetostr(cur_time,'HHMMSS-SSS');
}

function getlogname: string; {
  if _logname = '' then {
    _logname := GenerateNewFile+'.log';
  }
  result := _logname;
}
procedure timelog(_str: string); {
 logstrtofile(getlogname,DateToStr(cur_date,'YYYYMMDD')+'-'+timetostr(cur_time,'HHMMSS') + '|' + _str);
}


//-------------------------
//Номер системного алгоритма
Function GetNum: Word; {
  Result := 4556;
} //Function GetNum: Word;


//-------------------------
Function GetName: String;
{ Result := 'Выгрузка файлов на диск';
}; //Function GetName: String;


//-------------------------
Function GetMemo(st: oSteckCommonString): Boolean; {
  Result := True;
  st.Push(GetName);
  st.Push('   выгрузка файлов из файлового сервиса в папку');
  st.Push('   Используется FILESREF_File_hRef и WEB API по хранению файлов');
  st.Push('   Адрес API задается в настройке ' + gettunename('FILESREF.HREF_PATHAPI'));
}; //Function GetMemo(st: oSteckCommonString): Boolean;


//-------------------------
Function GetNameInter: String;{
  Result := 'Algoritm_DownLoadFilesToFolder';
} //Function GetNameInter: String;


//-------------------------
Function GetNameInterPr: String;{
  Result := 'Algoritm_DownLoadFilesToFolder_Setup';
} //Function GetNameInterPr: String;


//-------------------------
Function InitInter(Var pt: TRecAcc): Boolean;
{ #__UNUSED__(pt)
  Result := True;
} //Function InitInter(Var pt: TRecAcc): Boolean;


Function getwtablebyTypeCpNrec(_typeCpNrec : word) : word;  //"""""""""""""""""""""""""!!!!!!!!!!!!!!!! эту функцию надо в FILESREF_File_hRef унести
{
  result := _typeCpNrec;
  case _typeCpNrec of
    1101 // До снабжение
  , 1201 // ДО сбыт
  , 1501 //  ДО/ЛЗК на отпуск в производство
      :{
        result := 1102; // basedoc
      }
    2101 // Приходная накладная
  , 2111 // Акт на прием услуг
  , 2201 // Накладная на отпуск
  , 2211 // Акт на оказание услуг
  , 2106 // Накладная на возврат товаров по рекламации в продаже
  , 2626 // Акт на возврат оборудования и материалов
  , 2501 // Накладная на отпуск в производство /склад-подразделение/
  , 2502 // Накладная на приход готовой продукции из производства /подразделение-склад/
  , 2503 // Накладная на возврат сырья из производства /подразделение-склад/
  , 2504 // Акт на списание МЦ из производства /подразделение-.../
  , 2505 // Межцеховая накладная (полуфабрикат) /подразделение-подразделение/
  , 2506 // Накладная на внутреннее перемещение в производстве (МЦ) /подразделение-подразделение/
  , 2507 // Акт на брак
  , 2508 // Акт на оказание услуг
  , 2600 // Накладная на внутреннее перемещение - склад
  , 2630 // Акт пересортицы - склад
  , 2532 // Накладная на расход сырья /по накладной на приход готовой продукции из производства /
      :{
         result := 1109; // katsopr
      }
    74 // СФ сбыт
  , 75 // СФ поставщика
      : {
         result := 3500; // 3500 SCHFACT
      }
    7 // договор
      :{
       result := 1707;
      }
    2 // Ссылка на ObjAcct
     :{
       result := 11016;
      }
    3 // Ссылка на SpObjAcc
     :{
       result := 11033;
      }
    4 // Ссылка на ObjParam
     :{
       result := 11226;
      }
    5 // Ссылка на SpObjPar
     :{
       result := 11227;
      }
    6 // Ссылка на Indent
     :{
       result := 31011;
      }
    8 // Ссылка на CalPlan
     :{
       result := 1702;
      }
    9 // Ссылка на OperPlan
     :{
       result := 11096;
      }
    10 // Ссылка на SklOrder
     :{
       result := 1111;
      }
    11 // Ссылка на RsvOper
     :{
       result := 11103;
      }
    3101 // на всякий
   ,3111 // Сводный сопроводительный документ снабжение
   ,3201 //сводная накладная
   ,3211 // Сводный сопроводительный документ сбыт
     :{
       result := 1137 // сводный сопроводительный документ, но на него не прикручечны доп функции локального меню... ждлемс
     }
    end;
}
function PosR(_substr: string; _s: string): byte;  //"""""""""""""""""""""""""!!!!!!!!!!!!!!!! эту функцию надо в FILESREF_File_hRef унести
var ww_str:string;
    ii :word;
    len_sub:word;
{ ww_str:='';
  Result:=0;
  len_sub:=length(_substr);
  for(ii:=length(_s);ii>0;ii--)
  { ww_str:=substr(_s,ii,1)+ww_str;
    if substr(ww_str,1,len_sub)=_substr
    { Result:=ii;
      break
    }
  }
} //function PosR(substr: string; s: string): byte;
Function GetExtFromFile(__file : widestring) :string; {  //"""""""""""""""""""""""""!!!!!!!!!!!!!!!! эту функцию надо в FILESREF_File_hRef унести
 result := substr(__file,PosR('.',__file)+1,100);
}
Function GetNameFromFile(__file : widestring) :string; {  //"""""""""""""""""""""""""!!!!!!!!!!!!!!!! эту функцию надо в FILESREF_File_hRef унести
  if instr('\',__file) <> 0 then{
    result := Substr(__file,PosR('\',__file)+1,200); // windows
  }
  else {
    result := Substr(__file,PosR('/',__file)+1,200); // linux
  }
  result := Substr(result,1, PosR('.',result)-1);
}


//Запуск алгоритма
Function RunInter(wflag: Word; Var pt: TRecAcc): Boolean;
//var isAllOk:boolean;
{ #__UNUSED__(wflag,pt)

  Result  := false;

  set nrecFormPl := pt.cFormPl;
  if getfirst FormPl <> tsOK
   {
         message('Не найдена настройка алгоритма ' + string(nrecFormPl,0,0), error);
         pt.Binding:=8;
     exit;
   }
  _TypeCpNrec := pt.TypeCpNrec;
  _cpNrec     := pt.cpNrec;
   var _dirDest : widestring = GetDirName('Выберите папку для сохранения файлов');

   _dirDest := AddSlashToPath(_dirDest);

   var pFILESREF_File_hRef : FILESREF_File_hRef;
    if (NullVipRef(pFILESREF_File_hRef))
    _try {
        if (not LoadVipRef(pFILESREF_File_hRef, 'C_FILESREF::FILESREF_File_hRef')) {
         message('Не удалось загрузить C_FILESREF::FILESREF_File_hRef',error);
        }
     }
/*    _except
      on ExPathNotFound: Message('1. Нормально (Исключение ExPathNotFound)',0);
      on ExFile        : Message('НЕ ДОЛЖНО БЫТЬ (Исключение ExFile) 1',0);
*/
    _except else{}
//      on ExObjIfcBadVar : message('переменная не является ссылкой на VIP-интерфейс.');
//      on ExObjIfcNoLoad : message('невозможно загрузить интерфейс.');
//      on ExObjIfcNoImpl : message('VIP-интерфейс не реализует нужный OBJ-интерфейс.');

    _finally {};


//      pFILESREF_File_hRef.EnableTimeLog;

    var _wTable: word = getwtablebyTypeCpNrec(_TypeCpNrec);
    var iDownLoadFilesToFolder : DownLoadFilesToFolder;

    var lResp: TPtr = 0;

   var m_service : tptr =  HttpConnect_CreateEx('https://ya.ru','','',true);


    lResp := iDownLoadFilesToFolder.DownloadFiles(_wTable, _cpNrec);


    var _filesPath : widestring[60000];

        if (lResp <> 0) {
          var _str : string = '';
          var _lPosB, _LPosE : longint;
          _lPosB :=0; _LPosE:= 254;
          DO {
            _str := HttpConnect_GetLongStringSubString(m_service, lResp, _lPosB, _lPosE);
//            logstrtofile('c:\debug\DiaDoc_filesLoad.log','_str='+_str);
            if _str = ''
              Break;

            _lPosB +=254;
            _lPosE +=254;
            _filesPath += _str;
//             logstrtofile('c:\debug\DiaDoc_filesLoad.log','in Do_While Set _filesPath='+_filesPath);
          } WHILE _lPosB < 60000;
        }

      var _curPos : word = 1;
      var _oneFile : string ='';

      _filesPath:=Replace(_filesPath,chr(10),'');
      _filesPath:=Replace(_filesPath,chr(13),'');



       while true {

        if pos(';',_filesPath) = 0 then break;
        var _oneFile : string = substr(_filesPath,_curPos,instr(';',_filesPath)-1);
        timelog(_oneFile);

        var _fileDest : widestring = _dirDest + GetNameFromFile(_oneFile) + '.'+ GetExtFromFile(_oneFile);

          PutSrvFileToClient(_oneFile, _fileDest, true);
          CopyMoveFile(_oneFile, _fileDest, false, ecmfServerFrom + ecmfClientTo);

        _filesPath := substr(_filesPath,instr(';',_filesPath)+1,60000);
      }

      if _filesPath <> '' {
        var _oneFile : string = substr(_filesPath,1,255);
        timelog(_oneFile);
     }
   HttpConnect_Free(m_service);
} //Function RunInter(wflag: Word; Var pt: TRecAcc): Boolean;

End.
