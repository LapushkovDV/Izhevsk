#include FILESREF_File_hRef.Vih
#include DownLoadFilesToFolder.Vih

#component "GP"


//#include SaldoFuncs.vih

//***********************************
//***********************************
#doc
Алгоритм для загрузки файлов в папку
#end
Interface DownLoadFilesToFolder;

create view
from
   File_hRef
 , katsopr
;
function getoutdir : widestring; {
 var _getoutdir : widestring = AddSlashToPath(GetStringParameter('Files','OutputFilesDirectory',0)); // ExDirectoryOut;
//     MESSAGE('_getoutdir=' + _getoutdir + ' 0_0 ' + ExDirectoryOut);
  _getoutdir := _getoutdir + OleGenerateGUID;
  VerifyPathName(_getoutdir, true); // создаем путь, если нет его
  result := _getoutdir
}
function replaceprohibitsymbols(_str : string) : string; {
  _str := replace(_str,'<','_');
  _str := replace(_str,'>','_');
  _str := replace(_str,':','_');
  _str := replace(_str,'"','_');
  _str := replace(_str,'/','_');
  _str := replace(_str,'\','_');
  _str := replace(_str,'|','_');
  _str := replace(_str,'?','_');
  _str := replace(_str,'*','_');
 result := _str;
}

function getprefixname(_wTable    : word;  // код таблицы
                       _cRec      : comp   // выбранная запись
                      ) :string; cacheable;{
  result := olegenerateguid;
  case _wTable of
   coKatSopr: {
     if getfirst katsopr where ((_cRec == katsopr.nrec)) = tsOK {
      result :='nakl_' +string(katsopr.vidsopr)+'_' + replaceprohibitsymbols(katsopr.nsopr) + '_' + datetostr(katsopr.dsopr,'YYYY-MM-DD');
     }
   }
  end;
}

Function DownloadFiles(_wTable    : word;  // код таблицы
                       _cRec      : comp   // выбранная запись
                      ) : tptr; {

  if getfirst File_hRef where ((_wTable == File_hRef.wTable
                           and _cRec    == File_hRef.cRec
                           and   0      == File_hRef.isArch)) <> tsOK then exit;

   var m_service : tptr =  HttpConnect_CreateEx('https://ya.ru','','',true);
     var _result : TPtr = HttpConnect_CreateLongString(m_service);


   var _DirTmp : widestring = getoutdir;

   _loop File_hRef where ((_wTable == File_hRef.wTable
                      and _cRec    == File_hRef.cRec
                      and   0      == File_hRef.isArch)) {
    var iFILESREF_File_hRef : FILESREF_File_hRef;
    var _filePath : widestring = iFILESREF_File_hRef.GetFileOnDiskByGuid(File_hRef.GUIDAPI, _DirTmp, File_hRef.NAME);

    var _fileDest : widestring = AddSlashToPath(_DirTmp) + getprefixname(_wTable, _cRec) +'\'+ '_'+ File_hRef.NAME;

    CopyMoveFile(_filePath, _fileDest, true, ecmfServerFrom + ecmfServerTo);
    HttpConnect_AddValueToLongString(m_service, _fileDest, _result);
    HttpConnect_AddValueToLongString(m_service, ';', _result);
  }
 result := _result;
}

End.
