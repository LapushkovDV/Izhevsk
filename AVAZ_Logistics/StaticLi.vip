/**************************************************
 Глобальные методы
***************************************************/

#include StaticLi.vih
#include Query.vih

Interface LiFunctionSt ;

  Create view
    var
     _curmc : comp;
     i,i1 : word;
     isNeedIns : boolean = False;
  as select
     *
  from
    KatMc_Ext   ,
    KatMc_DblVal,
    KatMc_DatVal,
    KatMc_LongVal,
    KatMc_BoolVal,
    KatMc_CompVal,
    KatMc_StrVal,
    GP_LexiQue LexiQue
   where 
   ((
        _curmc == KatMc_StrVal.crec
    and _curmc == KatMc_CompVal.crec
    and _curmc == KatMc_DblVal.crec
    and _curmc == KatMc_DatVal.crec
    and _curmc == KatMc_LongVal.crec
    and _curmc == KatMc_BoolVal.crec
   ))
  ;

   Function SetPosMc_Str (_nrec : comp): Boolean;
   {
     _curmc:=_nrec;
     Result:=(getfirst KatMc_StrVal=tsok);
     if (not Result)
       if isNeedIns
         insert KatMc_StrVal set KatMc_StrVal.crec:=_nrec;       
   }
 
   Function SetPosMc_Comp (_nrec : comp): Boolean;
   {
     _curmc:=_nrec;
     Result:=(getfirst KatMc_CompVal=tsok);
     if (not Result)
       if isNeedIns
         insert KatMc_CompVal set KatMc_CompVal.crec:=_nrec;       
   }
 
   Function SetPosMc_Dbl (_nrec : comp): Boolean;
   {
     _curmc:=_nrec;
     Result:=(getfirst KatMc_DblVal=tsok);
     if (not Result)
       if isNeedIns
         insert KatMc_DblVal set KatMc_DblVal.crec:=_nrec;       
   }
 
   Function SetPosMc_Dat (_nrec : comp): Boolean;
   {
     _curmc:=_nrec;
     Result:=(getfirst KatMc_DatVal=tsok);
     if (not Result)
       if isNeedIns
         insert KatMc_DatVal set KatMc_DatVal.crec:=_nrec;       
   }
 
   Function SetPosMc_Long (_nrec : comp): Boolean;
   {
     _curmc:=_nrec;
     Result:=(getfirst KatMc_LongVal=tsok);
     if (not Result)
       if isNeedIns
         insert KatMc_LongVal set KatMc_LongVal.crec:=_nrec;       
   }
 
   Function SetPosMc_Bool (_nrec : comp): Boolean;
   {
     _curmc:=_nrec;
     Result:=(getfirst KatMc_BoolVal=tsok);
     if (not Result)
       if isNeedIns
         insert KatMc_BoolVal set KatMc_BoolVal.crec:=_nrec;       
   }

   Function GetVsdData (var obinfo : vsdStruct): word;
   var j: integer=0;
   {
     Result:=0;
     _loop Katmc_Ext
     {
       if (not Katmc_Ext.PrzLex)
         continue;
 
       j++
       obinfo.numpole[j] :=Katmc_Ext.IndxType;
       obinfo.namepole[j]:=Katmc_Ext.namepole;
       obinfo.code[j]    :=Katmc_Ext.kodan;
     }
     Result:=j;
   }

  Function GetPosFieldValue (name_field: s100; _cmc: comp): variant;
  var _curType,_cur_indx,_realIndx : word=0;
  var CntStr,CntLong,CntDat,CntDbl,Cntan,CntBool: word; 
  {
    Result:=VT_EMPTY;
    if _cmc=0h
      exit;

    isNeedIns:=false;

    _loop Katmc_Ext
    {
      if (name_field=Katmc_Ext.NamePole)
      {
        _curType :=Katmc_Ext.NppType;
        _cur_indx:=Katmc_Ext.IndxType;
        break;        
      }
    }
//    Message('_curType='+_curType+';_cur_indx='+_cur_indx);

    Case _curType of 
      FtString  :
      {
        if SetPosMc_Str(_cmc)
        {
          Result:=KatMc_StrVal.val[_cur_indx];
        }
      }
      FtComp    : 
      {
        if SetPosMc_Comp(_cmc)
        {
          if (not KatMc_Ext.przlex)
            Result :=ShowKau(word(KatMc_Ext.kodan),KatMc_CompVal.val[_cur_indx])
          else
            if getfirst LexiQue where ((KatMc_CompVal.val[_cur_indx] == LexiQue.nrec))=tsok
              Result:=LexiQue.CRIT_FULL_NAME_RUS;                   
        }
//        Message('!!!Result='+string(Result));
      }
      FtDouble  : 
      {
        if SetPosMc_Dbl(_cmc)
          Result:=KatMc_DblVal.val[_cur_indx];
      }
      ftLongint : 
      {
        if SetPosMc_Long(_cmc)
          Result:=KatMc_LongVal.val[_cur_indx];
      }
      ftDate    : 
      {
        if SetPosMc_Dat(_cmc)
          Result:=Result:=DateToStr(KatMc_DatVal.val[_cur_indx],'DD.MM.YYYY');//KatMc_DatVal.val[_cur_indx];//{ Message('vdat='+KatMc_ExtVal.vdat[_cur_indx]); Result:=DateToStr(KatMc_ExtVal.vdat[_cur_indx],'DD.MM.YYYY'); }
      }      
      ftBoolean :
      {
        if SetPosMc_Bool(_cmc)
          Result:=String(if(KatMc_BoolVal.val[_cur_indx]=true,'Да','Нет'));
      }
    end;
  }

  Function SetPosFieldValue (name_field: s100; _cmc: comp; Value : variant): Boolean;
  var _curType,_cur_indx : word=0;
  {
    Result:=false;
    if _cmc=0h
      exit;
    isNeedIns:=true;

    _loop Katmc_Ext
    {
      if (name_field=Katmc_Ext.NamePole)
      {
        _curType :=Katmc_Ext.NppType;
        _cur_indx:=Katmc_Ext.IndxType;
        break;        
      }
    }

    Case _curType of 
      FtString  :
      {
        if SetPosMc_Str(_cmc)
        {
          KatMc_StrVal.val[_cur_indx]:=String(Value);
          Result:=(Update current KatMc_StrVal=tsok);
        }
      }
      FtComp    : 
      {
        if SetPosMc_Comp(_cmc)
        {
          KatMc_CompVal.val[_cur_indx]:=Comp(Value)
          Result:=(Update current KatMc_CompVal=tsok);
!          if (not KatMc_Ext.przlex)
!            KatMc_CompVal.val[_cur_indx]:=Comp(Value)
!          else
!            if getfirst LexiQue where ((KatMc_CompVal.val[_cur_indx] == LexiQue.nrec))=tsok
!              Result:=LexiQue.CRIT_FULL_NAME_RUS;                   
        }
//        Message('!!!Result='+string(Result));
      }
      FtDouble  : 
      {
        if SetPosMc_Dbl(_cmc)
        {
          KatMc_DblVal.val[_cur_indx]:=Double(Value);
          Result:=(Update current KatMc_DblVal=tsok);
        }
      }
      ftLongint : 
      {
        if SetPosMc_Long(_cmc)
        {
          KatMc_LongVal.val[_cur_indx]:=Longint(Value);
          Result:=(Update current KatMc_LongVal=tsok);
        }
      }
      ftDate    : 
      {
        if SetPosMc_Dat(_cmc)
        {
          KatMc_DatVal.val[_cur_indx]:=Value;
          Result:=(Update current KatMc_DatVal=tsok);
        }
      }      
      ftBoolean :
      {
        if SetPosMc_Bool(_cmc)
        {
//           Message('ftBoolean set record='+_cur_indx+'|'+KatMc_BoolVal.nrec);
          KatMc_BoolVal.val[_cur_indx]:=Boolean(Value);
          Result:=(Update current KatMc_BoolVal=tsok);
        }
      }
    end;
  }

  Function GetAnyFieldLi_Str ( indx : word;  _nrec : comp ) : String;
  {   
    Result:='';
    if SetPosMc_Str(_nrec)
      Result:= KatMc_StrVal.val[indx];
  } 

  Function GetAnyFieldLi_Dat (indx : word;  _nrec : comp ) : Date;
  {
    Result:=to_date(0,0,0);
    if SetPosMc_Dat(_nrec)
       Result:= KatMc_DatVal.val[indx];
  } 

  Function GetAnyFieldLi_Long (indx : word;  _nrec : comp ) : Longint;
  {
    if SetPosMc_Long(_nrec)
      Result:= KatMc_LongVal.val[indx]
    else
      Result:=0;
  }

  Function GetAnyFieldLi_Bool (indx : word;  _nrec : comp ) : String;
  {
    if SetPosMc_Bool(_nrec)
      Result:=if(KatMc_BoolVal.val[indx]=true,'Да','Нет');
    else
      Result:='';
  }

  Function GetAnyFieldLi_Dbl (indx : word;  _nrec : comp ) : Double;
  {
    if SetPosMc_Dbl(_nrec)
      Result:= KatMc_DblVal.val[indx]
    else
      Result:=0;
  }

  Function GetAnyFieldLi_Kau  (indx : word;  _nrec : comp ) : String; 
  {
    Result :='';
    if getfirst KatMc_Ext where ((indx==Katmc_Ext.IndxType and FtComp==Katmc_Ext.nppType))=tsok {}

    if SetPosMc_Comp(_nrec)
    {
      if (not KatMc_Ext.przlex)
        Result :=ShowKau(word(KatMc_Ext.kodan),KatMc_CompVal.val[indx])
      else
        if getfirst LexiQue where ((KatMc_CompVal.val[indx] == LexiQue.nrec))=tsok
          Result:=LexiQue.CRIT_FULL_NAME_RUS;                   
    }
  }

  HandleEvent
    CmOnvipload:
    {
    }
  end;
end.  
