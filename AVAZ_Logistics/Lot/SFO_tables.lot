
Create Table AVAZ.SFO_PLN_STAFF "Плановая численность персонала"
  With Table_CODE = 31850
  With Replace
  With TableOptions Branched
(

 NRec     : comp                   "Номер записи"
,cDolj    : comp                   "Должность"
,cPodr    : comp                   "Подразделение"
,cBrig    : comp                   "Бригада"
,cUchast  : comp                   "Участок"
,cNorma   : comp                   "Норма СФО"
,Year     : word                   "Год"
,PlanMes  : array[1..12] of double "Месяц"

)
With Index
(
  SFO_PLN_STAFF01  =  NRec(Unique, Surrogate, Journal)
 ,SFO_PLN_STAFF02  =  cDolj + cPodr + cUchast + cBrig + cNorma + Year
);

Create Table AVAZ.SFO_PLNSTAFFTURNOVER "Коэффициент текучести"
  With Table_CODE = 31851
  With Replace
  With TableOptions Branched
(
  NRec     : comp                   "Номер записи"
 ,cPodr    : comp                   "Подразделение"
 ,Year     : word                   "Год"
 ,PlanMes  : array[1..12] of double "Месяц"
)
With Index
(
  SFO_PLN01  =  NRec(Unique, Surrogate, Journal)
, SFO_PLN02  =  cPodr + Year
);
