#include DicTypes.def

//drop table KatMc_Ext;
//drop table KatMc_ExtGr;
//drop table KatMc_ExtVal;

Create table KatMc_Ext "Расширение таблицы Katmc список полей"
  With table_Code = 31825
  With replace
  With TableOptions Branched
  (
    NRec       : comp "Номер записи",
    IndxType   : word,
    NamePole   : s100,
    NppType    : word, // String/Longint/COmp и т.д.
    AllPole    : boolean, // Поле для любой записи ТМЦ или нет ( нет - раграничение по группе ТМЦ)
    NppPole    : word, // порядок отображения их в каким то формате (Browse/Screen).Зачастую, это имеет значение
    kodan      : s20,
    PrzLex     : boolean,// Добавлено 30/09/2025 для идентификации лексиконовых полей
    isVisible  : word
  )
  With index
  (
    Indx0 = NRec(Unique, Surrogate, Journal),
    Indx1 = IndxType+NppType
  );

Create table KatMc_ExtGr "Расширение таблицы Katmc группа ТМЦ"
  With table_Code = 31826
  With replace
  With TableOptions Branched
  (
    NRec       : comp "Номер записи",
    cRec       : ref(GroupMC) "Группа ТМЦ",
    cPole      : ref(KatMc_Ext) "Поле"
//    NumPole   : word,
//    NppPole   : word
  )
  With index
  (
    Indx0 = NRec(Unique, Surrogate, Journal),
    Indx1 = cRec+cPole
  );

