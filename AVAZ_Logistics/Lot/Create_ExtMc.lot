Create table KatMc_StrVal "Расширение каталога ТМЦ string-значения"
  With table_Code = 31827
  With replace
  With TableOptions Branched
  (
    NRec      : comp "Номер записи",
    cRec      : ref(Katmc) "Запись таблицы",
    val       : array[1..30] of string
  )
  With index
  (
    Indx0 = NRec(Unique, Surrogate, Journal),
    Indx1 = cRec
  );

