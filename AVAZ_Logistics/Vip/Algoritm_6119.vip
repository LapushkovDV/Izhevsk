#component "M_MnPlan"
VipInterface Algoritm_6119 implements oAlgoritm_Sys;
Interface Algoritm_6119;
show(5,1,160,30);


#include ExtAttr.var
#include oEdIzm.var
#include MTRFuncs.var
//#include SklOrder.var
#include modifOrd.var


var
     cWorkFormPl,pNrec:comp;
     wEvnCode: Word;
     sEvnLine: String;
     tError : word;


create view

var _ROB,_ROD,_ROST : string;


as select
  *
from
    FormPl,katsopr,spsopr,katkod
 where ((
           cWorkFormPl         == FormPl.NRec
           and
           pNrec == KatSopr.nrec
           and
           KatSopr.nrec == SpSOpr.csopr

            ))
 ;


exception ExUser1, ExUser2;

Function GetNum : word;
{
  GetNum := 6119;
}

function GetName : string;
{
  GetName := 'Алгоритм Формирование размеров СФО на основе ВА спецификации накладной склад-спецодежда';
}

Function GetMemo ( st:oSteckCommonString ) : Boolean;
{
  GetMemo := True;

  st.push('Алгоритм Формирование размеров СФО на основе ВА спецификации накладной склад-спецодежда');
}

Function GetNameInter : String;
{
  GetNameInter := 'Algoritm_6119' ;
}

Function GetNameInterPr : String;
{
  GetNameInterPr := 'AlgoritmSetup_6119' ;
}

function itsTaraM(cc:comp):boolean;
{
  Result:= word(sGetAttr(coKatMc,cc,VA_TARAM))>0;
}

procedure InsertSize(pTypeSize:comp;ss:string);
{
 if ss='' then exit;
 if (GetFirst KatKod Where (( cgKatKod_SizesSFO == KatKod.wType and
                                          pTypeSize == KatKod.cOrg1 and
                                         ss == KatKod.Kod  )) <> tsOk)
  {
    ClearBuffer(#KatKod);
    KatKod.nRec   := GetNextNRec(#KatKod, 0);
    KatKod.wType  := cgKatKod_SizesSFO;
    KatKod.cOrg1  := pTypeSize;
    KatKod.Kod    := ss;
    insert current katkod;
  }

 // стандарт сам все перенесет, со своих атрибутов, нужно только пополнить справочники в этом алгоритме
/*
  if getfirst MBPIN where ((SpSopr.nrec == MBPIN.cspsopr))=tsok then
   {
     set MBPIN.sizes[word(pTypeSize)]:=ss;
     update current MBPIN;
     message(MBPIN.sizes[word(pTypeSize)]+'  -    '+pTypeSize)
    // if getfirst KATMBP where ((MBPIN.CMBP == KATMBP.nrec))=tsok then
     // {
    //   set KATMBP.sizes[word(pTypeSize)]:=ss;
    //   update current KATMBP;
    //  }
   }
*/
}

function MakeAlg(typeDoc : word): boolean;
{
  if getfirst KatSopr<>tsok then {result := false;exit;}
  result := true;
  _loop spsopr
  {
    _ROB :=trim(sGetAttr(coSpSopr,SpSopr.nrec,VA_SO_ROB));       // szObuv1
    _ROD :=trim(sGetAttr(coSpSopr,SpSopr.nrec,VA_SO_ROD));      //  szWear1
    _ROST:=trim(sGetAttr(coSpSopr,SpSopr.nrec,VA_SO_ROST));      //  szHRost
    InsertSize(szObuv1,_ROB);
    InsertSize(szWear1,_ROD);
    InsertSize(szHRost,_ROST);
  }
}


Function InitInter( Var pt:TRecAcc ) : Boolean;
{
  InitInter := False;

_try
{
 pt.Visua    := Word(0);
 pt.MessEnd  := Word(0);

  cWorkFormPl := pt.cFormPl;
  if (GetFirst FormPl <> tsOk)
  {
   wEvnCode := 1;
   sEvnLine := 'Пользовательский алгоритм не найден (скорее всего, он был удален)';
   _raise ExUser2;
  }

 InitInter := True;
}  //'_try

_except
 on ExUser1:
  pt.Error := 1;

 on ExUser2:
 {
  Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally
{
 //'
}
}




//=======================================================================
Function RunInter( wflag:Word; Var pt:TRecAcc ) : Boolean;
{
  #__UNUSED__(wflag)


  pNrec:=pt.cpNrec;

  if (not MakeAlg(pt.TypeCpNrec))
   {
    RunInter := False;
    pt.Binding := 8; // запрет
    pt.Error   := 1; // запрос
   }
  else
    RunInter := True;

}  //'_try

 HandleEvent
   CmValue1 : {
              }
 end;
end.
