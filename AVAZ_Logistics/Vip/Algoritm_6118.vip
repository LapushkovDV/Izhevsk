create view



as select
  *
from
    FormPl,spsopr,katmc,KatSopr, KatSopr KatSopr_New,spsopr spsopr_select,sklorder,TmpBalSch
 where ((
           cWorkFormPl         == FormPl.NRec
           and
           pNrec               == KatSopr.nrec
           and
           KatSopr_New.nrec    == spsopr.csopr
           and
           word(1)             == spsopr.prmc
           and
           spsopr.cmcusl       == katmc.nrec
       ))
 ;


exception ExUser1, ExUser2;

form frm1wed     ('err2wed.OUT'  , 'ERRR'     ) with novisual;

