#include MakeOptionsByDefines.vpp ;
Function MakeRashOrd(NeedMsg: boolean; pDateOrd: longint): boolean;
var
  wMode  : word; // пакетный или обычный режим
  wParam : word; // дополнительный параметр
  lHandle: TPtr; // heandle отчета
{

  MakeOptionsByDefines(wMode, wParam);

  var wParamInt : word = 0;
  //----------------------------------------------------------------------------
  // при пакетном переводе со склада в ОС/НМА
  ReadMyDsk(wParamInt, 'SopInMov_BatchMode', true);
  var dtDateOrd : date;
  dtDateOrd := LongToDate(pDateOrd);

  if ((wParamInt and 1) <> 0)
  {
    wMode := wMode or WMODE_BATCH;

    if (pDateOrd = ZeroDate)
      dtDateOrd := if (KatSopr_New.dOpr = ZeroDate, if(KatSopr_New.DateUchet <> ZeroDate, KatSopr_New.DateUchet, KatSopr_New.dSopr), KatSopr_New.dOpr);
    //----------------------------------------------------------------------------
    // при пакетном переводе со склада в ОС/НМА не выдавать сообщения при удалении ордеров
    // чтобы не сломать if (NOT DeleteOrders(KatSopr.NRec, True !?!, True, True, wMode, wParam))
    // т.к. в makeorder_rash.vpp почему-то в DeleteOrders не используется параметр NeedMsg
    wParam := wParam OR 128;
  }
  //----------------------------------------------------------------------------
  wParam := wParam OR 32; // не выдавать сообщение об окончании операции

  //--делать UpdateTable только если НЕ используется пакетный режим
  if ((wMode and WMODE_BATCH) = 0)
    if (NeedMsg)
      if NOT UpdateTable
        Exit;

  lHandle   := 0;
  wParamInt := 0;
  ReadMyDsk(wParamInt, 'MsgBatch_wParamInt' + 'MsgBatch', true);

  if (wGetTune('Doc.Sell.ShowReportNew') = 2)
    SaveMyDsk(word(2), 'MsgBatch_wParamInt' + 'MsgBatch');
  else
    SaveMyDsk(word(0), 'MsgBatch_wParamInt' + 'MsgBatch');

  // если установлена настройка формирования протокола в формате FastReport
  if (wGetTune('Doc.Sell.ShowReportNew') = 1)
    lHandle := frm1wed.Handle
  else
  {
    if (wMode and WMODE_LOG_TO_MSGBATCH) <> WMODE_LOG_TO_MSGBATCH
    {
      if (wMode and WMODE_BATCH) = WMODE_BATCH
        wMode += WMODE_LOG_TO_MSGBATCH;
      else
        if (wGetTune('Doc.Sell.ShowReportNew') = 2)
          wMode += WMODE_LOG_TO_MSGBATCH;
    }
  }


  MakeRashOrd := oMakeOrder.MakeRashOrd(KatSopr_New.NRec, NeedMsg, dtDateOrd, 1, wMode or WMODE_BATCH, wParam or WMODE_BATCH or ORD_No_Protocol,  lHandle);
 // MakeRashOrd := oMakeOrder.MakeRashOrd(KatSopr_New.NRec, NeedMsg, pDateOrd, 1, wMode or WMODE_BATCH, wParam or WMODE_BATCH or ORD_No_Protocol,  lHandle);
  SaveMyDsk(wParamInt, 'MsgBatch_wParamInt' + 'MsgBatch');


 // ReReadRecord(#KatSopr);
}


function CheckMakeMBPOperation: boolean;
{
  CheckMakeMBPOperation := vMakeMBP.ChkMakeOpers(KatSopr_New.NRec);
}

//-----------------------------------------------------------------------------

function MakeMBPOperation:boolean;
var ShowErr : Boolean;
{
 //message(1);
  Result:=false;
  if (not CheckMakeMBPOperation)
    Exit;
 // message(2);
  if ((KatSopr_New.vidSopr = 602) and (coGetTune('Sklad.Sklad_Spec.BeforeOrder') <> 0))
    if (RunInterface('SimpleWayToRunAlgorithm', coGetTune('Sklad.Sklad_Spec.BeforeOrder'), Word(2600), KatSopr_New.NRec, Comp(0)) = cmCancel) {Exit;};

// message(3);

 if (not MakeRashOrd(false, DateToLong(KAtSopr_new.dsopr)))
 //   if (not MakeRashOrd(true, DateToLong(KAtSopr_new.dsopr)))
  {
  //    frm1wed.showFile;
    Exit;
  }
// message(4);


  if ((KatSopr_New.vidSopr = 602) and (coGetTune('Sklad.Sklad_Spec.AfterOrder') <> 0))
    if (RunInterface('SimpleWayToRunAlgorithm', coGetTune('Sklad.Sklad_Spec.AfterOrder'), Word(2600), KatSopr_New.NRec, Comp(0))  = cmCancel) {Exit;};

  vMakeMBP.SetMess(false);
  vMakeMBP.MakeOpers(KatSopr_New.nRec);


  if ((KatSopr_New.vidSopr = 602) and (coGetTune('Sklad.Sklad_Spec.AfterMakeMBP') <> 0))
    if (RunInterface('SimpleWayToRunAlgorithm', coGetTune('Sklad.Sklad_Spec.AfterMakeMBP'), Word(0), KatSopr_New.NRec, Comp(0))  = cmCancel) {Exit;};
 //message(5);

  Result:=true;
}


function CheckSCHUCH:boolean;
var tBS:comp;
{
  Result:=false;
  tBS:=coGetAttr(coKatMc,KatMc.nrec,VA_KATMC_SCHUCH);
  if (tBS=0) exit;
  if (getfirst TmpBalSch where ((tBS == TmpBalSch.cBS))=tsok)  {Result:=true;}
}


function  MakeSopr(tip:word):boolean;
{
  Result:=true;

    NewDoc:=0;



  RunInterface('l_SoprDoc::iCopySopr', _MainSopr, Word(602), NewDoc, 0);
  if getfirst fastfirstrow KatSopr_New where ((NewDoc == KatSopr_New.nrec))<>tsok then exit;


  _loop spsopr
  {

   if (getfirst fastfirstrow katmc = tsok)
   {
   if tip=1
    {

     if katmc.CGROUPSFO<>0 then continue;
    }
    else
    {

     if (katmc.PRMAT=2)
       if (CheckSCHUCH) continue;
    }
    if getfirst fastfirstrow spsopr_select where ((spsopr.nrec == spsopr_select.nrec))=tsok then  oSDfuns.SpSopr_Delete(spsopr_select.nrec);
   }
 }


  set KatSopr_New.name := 'Создана по приходной накладной №'+_NS+' от '+_DS;
  set KatSopr_New.cpodrto:=KatSopr_New.cpodrfrom;
  set KatSopr_New.cmolto :=KatSopr_New.cmolfrom;
  set KatSopr_New.CORGPLAT := _MainSopr;
  set KatSopr_New.SubTip := tip; // Спецодежда = 1
  update current KatSopr_New;
  oKatSoprFunc.RecalcSoprDoc(KatSopr_New.VidSopr, KatSopr_New.NRec, 0, KatSopr_New.cVal, 0);

  if not MakeMBPOperation then
   {
  //  message(6);

    if (oMakeOrder.DeleteOrders(KatSopr_New.nrec, True, True, True, 1, 0)) then
    {
  // message(7);

     _loop SpSopr where ((KatSopr_New.nrec == spsopr.csopr))
     {
       if getfirst spsopr_select where ((spsopr.nrec == spsopr_select.nrec))=tsok then  oSDfuns.SpSopr_Delete(spsopr_select.nrec);
     }
     //  message(8);

     if ( RecordExists SpSopr where (( KatSopr_New.nrec == SpSopr.cSopr )) <> tsOk )
     {
       oSDfuns.DeleteSoprHoz(KatSopr_New.nRec, KatSopr_New.VidSopr);
  //  message(9);

       oSDfuns.KatSopr_delete(KatSopr_New.nRec);
 //   message(10);

     }
    }
   //  message(11);


    if (Not oMakeOrder.DeleteOrders(_MainSopr, False, True, True, 0, WMODE_BATCH)) then {}
   //  message(12);

   }
   else
    {

      if (getfirst fastfirstrow KatSopr where ((_MainSopr == KatSopr.nrec))=tsok)
      {
      if (getfirst fastfirstrow sklorder where ((KatSopr.nrec == SklOrder.csopr))=tsok and (Katsopr.dopr=ZeroDate)) then
       {
         set KatSopr.dopr:=SklOrder.dord;
         update current KatSopr;
       }
      }
    }
   //  message(13);

  // if (Not oMakeOrder.DeleteOrders(KatSopr.NRec, True, True, True, 1, 0))
 //       Exit;


}



function MakeAlg(typeDoc : word): boolean;
var i:word;
{
  if getfirst KatSopr<>tsok then {result := false;exit;}

  delete all TmpBalSch;
  for (i:=1;i<=10;i:=i+1)
   {
     if FormPl.RESCOMP[i]=0 then continue;
     ClearBuffer(#TmpBalSch);
     set TmpBalSch.cBS := FormPl.RESCOMP[i];
     set TmpBalSch.sBS := FormPl.RESNAME[i];
     insert current TmpBalSch;
   }



  result := true;
  // надо проверить есть ли вообще СФО или СТО , и если нет, то просто выйти по хорошему...
  bSFO:=false;
  bSTO:=false;


  _loop spsopr where ((KatSopr.nrec == spsopr.csopr and word(1) == spsopr.prmc))
  {
    if getfirst fastfirstrow katmc <> tsok then continue;
    if (katmc.CGROUPSFO<>0) bSFO:=true;
    if (katmc.PRMAT=2)
       if (CheckSCHUCH) bSTO:=true;
    if (bSFO and bSTO) break;
  }

  _NS:=KatSopr.nsopr;
  _DS:=DateToStr(KatSopr.dsopr,'DD.MM.YYYY');
  _MainSopr:=KatSopr.NRec;

  if bSTO MakeSopr(0);
  if bSFO MakeSopr(1);
}


Function InitInter( Var pt:TRecAcc ) : Boolean;
{
  InitInter := False;

_try
{
 pt.Visua    := Word(0);
 pt.MessEnd  := Word(0);

  cWorkFormPl := pt.cFormPl;
  if (GetFirst FormPl <> tsOk)
  {
   wEvnCode := 1;
   sEvnLine := 'Пользовательский алгоритм не найден (скорее всего, он был удален)';
   _raise ExUser2;
  }

 InitInter := True;
}  //'_try

_except
 on ExUser1:
  pt.Error := 1;

 on ExUser2:
 {
  Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally
{
 //'
}
}




//=======================================================================
Function RunInter( wflag:Word; Var pt:TRecAcc ) : Boolean;
{
  #__UNUSED__(wflag)

  pNrec:=pt.cpNrec;
 // if pt.TypeCpNrec=0 or pt.TypeCpNrec=toPlanSnab then pNrec:=pt.cMnplan;
  pt.Error = 0;
  if (not MakeAlg(pt.TypeCpNrec))
   {
    RunInter := False;
    pt.Binding := 8; // запрет
    pt.Error   := 1; // запрос
   }
  else
  {
     pt.Error = 0;
     RunInter := True;
  }

}  //'_try

 HandleEvent
   CmValue1 : {
              }
 end;
end.
