#component "L_Sklad"
alter Interface SopInMov;


Create View Quality
 select * from
 KatSopr CardBrak;

ExtendFormats scrHeader;
Window EditSopr;
Panel pnHeader
  Table KatSopr;
Screen scrHeader (, hcSklRedNaklOb, sci1378EscOrd);
  Show at(, , 108, 15) Fixed_Y;
Fields
 [NumKB] sGetAttr(coKatSopr,KatSopr.NRec,'Номер КБ') : Protect,PickButton;
<<











  `Номер КБ              `.@@@@@@@@@@@@@@@@@
>>
end;

HandleEvent
cmDelOnProtect :
{
 case CurField of
  #NumKB : {
      ExtAttr_DeleteValue(coKatSopr,KatSopr.NRec,'КБ');
      ExtAttr_DeleteValue(coKatSopr,KatSopr.NRec,'Номер КБ');
      RescanPanel(#KatSopr);
  }
  else inherited::handleevent( cmDelOnProtect );
 end;
};
cmPick:
{
 case CurField of
  #NumKB : {
    var vc: comp;
    set vc:= coGetAttr(coKatSopr,KatSopr.NRec,'Номер КБ');
    if RunInterface('AVAZ_Quality::PickCardBrak',vc)=cmDefault then
    {
     if Quality.getfirst fastfirstrow CardBrak where((vc == CardBrak.NRec))=tsOk then
     {
      coSetAttr(coKatSopr,KatSopr.NRec,'КБ',Quality.CardBrak.NRec,Quality.CardBrak.NSopr);
      sSetAttr(coKatSopr,KatSopr.NRec,'Номер КБ',Quality.CardBrak.NSopr);
     }
    }
  }
  else inherited::handleevent( cmPick );
 end;
};

End;
End;
HandleEvent
cmDelOnProtect :
{
 case CurField of
  #NumKB : {
      ExtAttr_DeleteValue(coKatSopr,KatSopr.NRec,'КБ');
      ExtAttr_DeleteValue(coKatSopr,KatSopr.NRec,'Номер КБ');
      RescanPanel(#KatSopr);
  }
  else inherited::handleevent( cmDelOnProtect );
 end;
};
end;
End;
HandleEvent
cmDelOnProtect :
{
 case CurField of
  #NumKB : {
      ExtAttr_DeleteValue(coKatSopr,KatSopr.NRec,'КБ');
      ExtAttr_DeleteValue(coKatSopr,KatSopr.NRec,'Номер КБ');
      RescanPanel(#KatSopr);
  }
  else inherited::handleevent( cmDelOnProtect );
 end;
};
end;

end.
