function FormatCellStr(pRow, pCol: longInt): string;
{
  result := '(' + pRow + ':' + pCol + ')';
}

procedure SetErrorMessage(pLocalMessage: string);
{
  sErrMessage := pLocalMessage;
  lErrMessageMode := Error;
  _raise ExExcelFatalError;
}

procedure SetLastErrorMessageCode(pLocalMessage: string);
{
  SetErrorMessage(''#3'' + pLocalMessage + '.'#13#3 + 'Код ошибки: ' + xlGetLastError);
}


procedure CreateExcelWithTemplate(pTemplateName: string);
{
  if not xlCreateNewExcelWithTemplate(pTemplateName, true)
    SetLastErrorMessageCode('Ошибка инициализация сессии работы с Excel по шаблону с именем "' + pTemplateName + '"');
}

procedure SetCellNumberValue(pValue: double; pRow, pCol: longInt);
{
  if (pValue <> 0)
    if not xlSetCellNumberValue(pValue, pRow, pCol, pRow, pCol)
      SetLastErrorMessageCode('Ошибка установки числового значения ' + string(pValue) + ' в ячейку ' + FormatCellStr(pRow, pCol));
}

procedure SetCellDateValue(pValue: Date; pRow, pCol: longInt);
{
  if not xlSetCellDateValue(pValue, pRow, pCol, pRow, pCol)
    SetLastErrorMessageCode('Ошибка установки Даты ' + string(pValue) + ' в ячейку ' + FormatCellStr(pRow, pCol));
}

procedure SetCellStringValue(pValue: string; pRow, pCol: longInt);
{
  if (pValue<>'' )if not xlSetCellStringValue(chr(39) + string(pValue), pRow, pCol, pRow, pCol)
    SetLastErrorMessageCode('Ошибка установки строкового значения ' + string(pValue) + ' в ячейку ' + FormatCellStr(pRow, pCol));
}

procedure WriteMatrixToExcel(pRow, pCol: longInt);
{
  if not xlWriteMatrixToExcel(pRow, pCol)
    SetLastErrorMessageCode('Ошибка записи всех значений динамического массива в заданный диапазон ячеек ' +
    FormatCellStr(pRow, pCol));
}
