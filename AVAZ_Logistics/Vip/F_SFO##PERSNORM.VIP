#component "F_SFO"
#include ShowKau.vpp            // declare á Š€“
#include AttrTablePick.vih
Alter Interface PersNorms;
Panel pnlPersNorm;
  Table PersNorm;


HandleEvent
cmPick:
 {
       ClearMyDsk('AVAZ_GET_CHK');
       ClearMyDsk('AVAZ_GET_UCH');
       ClearMyDsk('AVAZ_GET_BRIG');
       ClearMyDsk('AVAZ_GET_D');
       ClearMyDsk('AVAZ_GET_P');
       SaveMyDsk(coGetAttr ( coPersCard, PersCard.nrec, VA_SO_UCH ),'AVAZ_GET_UCH');
       SaveMyDsk(coGetAttr ( coPersCard, PersCard.nrec, VA_SO_BRIG ),'AVAZ_GET_BRIG');
       SaveMyDsk(PersCard.CPOST,'AVAZ_GET_D');
       SaveMyDsk(PersCard.CPODR,'AVAZ_GET_P');
       SaveMyDsk(word(1),'AVAZ_GET_CHK');
       inherited::handleevent(cmPick);
       ClearMyDsk('AVAZ_GET_CHK');
       ClearMyDsk('AVAZ_GET_UCH');
       ClearMyDsk('AVAZ_GET_BRIG');
       ClearMyDsk('AVAZ_GET_D');
       ClearMyDsk('AVAZ_GET_P');
 }
 end;
end;
End.
