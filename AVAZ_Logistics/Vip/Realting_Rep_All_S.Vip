Interface Realting_Rep_All_S 'Общая площадь недвижимости', escClose, cyan;
Show at (,,67,14);

#include PersInfo.var

table struct TmpOborot
(
   S         : string
  ,OS        : string
  ,InvNum    : string
  ,Name      : string
  ,NomGen    : string
  ,Predpr    : string
  ,Podr      : string
  ,Proc      : double
  ,S_All     : double
  ,S_Pro     : double
  ,S_Vsp     : double
  ,S_bit     : double
  ,S_en      : double
  ,S_Skl     : double
  ,Prim      : string
  ,Tip       : word
  ,CO        : comp
  ,wStatus   : word
  ,DEND      : date
  ,osisp     : string
)
with index
(
   TmpOborot01 = S
  ,TmpOborot02 = tip+OS+S+CO
  ,TmpOborot03 = tip+CO
  ,TmpOborot04 = tip+oS+CO
)
;

#Include GetKau.var
var pOsFun : OsFun;

Create View
var 
  cCurPlanSch : comp;
   cper,cfpco_f,cBild        : comp;    // период планирования
  DTB,DTE,PersPosDate,PersDisDate     : date;    //период формирования
  WorkYear,wCardLink:word;
  PriznPotr,PerPotr,Priz1,Priz2,i:word;
  sErrMessage: string;
  lErrMessageMode,lCountRow,tKol,tCO: longInt;
  sFileName,MegaS,_SA: string;
  i1,i2,i3,i4:double;
  Marker,MarkerCO:TPtr;
  nMarkers : string[30];
  i_s_all, t_s_all,
 i_S_Pro, t_S_Pro,
 i_S_Vsp, t_S_Vsp,
 i_S_bit, t_S_bit,
 i_S_en , t_S_en ,
 i_S_Skl, t_S_Skl:double;
 fObj,fCO:string;
   pRent     : RltRentHistory;
 liRep :longint;

 As select
TmpOborot.*
From
   TmpOborot,
   TmpOborot TmpOborot2,
   TmpOborot TmpOborot3,
   fpco,
   KATORG,
   fpco FPCO_F,
   RLTOBJTREE,
   RLTBUILDINGS,
   RLTBUILDINGS RLTBUILDINGS_M,
   RLTFLOORS,
   RLTROOMS,
   RLTRENTS,
   RLTATTRHIST  RLTATTRHIST_build,
   RLTATTRHIST  RLTATTRHIST_Room ,
   rltLinks,
   nastros,
   spkatos,
   ISPOS  ,
   dogovor

where((
     roBuilding        == RLTOBJTREE.vidobj
     and
     RLTOBJTREE.cobj   == RLTBUILDINGS.nrec
     and
     roBuilding        == RLTATTRHIST_build.vidobj
     and
     RLTBUILDINGS.nrec == RLTATTRHIST_build.cobj
     and
     DTB               >>= RLTATTRHIST_build.DCHANGE
     and
     RLTBUILDINGS.nrec  == RLTFLOORS.CBUILDING
     and
     RLTBUILDINGS.nrec  == RLTROOMS.CBUILDING
     and
     RLTFLOORS.nrec     == RLTROOMS.CFLOOR
     AND
     roRoom             == RLTATTRHIST_Room.vidobj
     and
     RLTROOMS.nrec      == RLTATTRHIST_Room.cobj
     and
     DTB               >>= RLTATTRHIST_Room.DCHANGE
     AND
     roRoom             == RLTRENTS.vidobj
     and
     RLTROOMS.nrec      == RLTRENTS.cobj
     and
     DTB               >>= RLTRENTS.DFROM
     and
     RLTRENTS.CFPCO     == fpco.nrec
     and
     cfpco_f == fpco_f.nrec
     and
     NastrOs.nRec          == SpKatOs.cNastrOs
     and
     RLTBUILDINGS.cKatOs   == SpKatOs.cKatOs
     and
     SpKatOS.CISP         == ISPOS.nRec
 ));


var aOsRep : tRealOs;

Panel pnParam;
NoTableNavigation;
screen scParam 'Общая площадь недвижимости' (,,sci13Esc);
Fields
  DTB : NoProtect;
  FCO                    ('Подразделение',, sci1378Esc) : Protect,PickButton;
  fObj                   ('Установите фильтр по объектам недвижимости',, sci1378Esc) : Protect,PickButton;
  Priz1 :NoProtect;
 // Priz2 :NoProtect;
Buttons
  cmOk,,,'Сформировать отчет', , sci1Esc;
  cmCancel,,,'Выход', , sci1Esc;
<<

  `На дату `     .@@@@@@@@@@@

  `Подразделение/Контрагенты( ЦО )`
   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  `Здания/сооружения`
   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

    [.] Группировать по подразделениям`

         <.~С~формировать.>           <. ~О~тмена  .>

>>

end; //scrParam
End; //pnParam


procedure MarkKol;
{
  Marker := InitMarker('GetRltBuilding', 8, 200, 100, false);
  tKol:=GetMarkerCount(Marker);
  if tKol=0 then set fObj:='';
  if tKol>1 then set fObj:='Выбрано : '+string(tKol);
  if tkol=1 then
   {
            GetMarker(Marker, 0, cBild);
            if getfirst RLTBUILDINGS_M where ((cBild == RLTBUILDINGS_M.nrec ))=tsok
             then  set fObj:=RLTBUILDINGS_M.Name;
   }
   DoneMarker(Marker, 'GetRltBuilding');

}

procedure MarkCO;
{
  nMarkers := iGetKau.GetMarkerName(cgKau_FpCO);
  Marker  := InitMarker(nMarkers,8,200,100,false);
  tCO:=GetMarkerCount(Marker);
  if tCO=0 then set fCO:='';
  if tCO>1 then set fCO:='Выбрано : '+string(tCO);
  if tCO=1 then
   {
            GetMarker(Marker, 0, cfpco_f);
            if getfirst fpco_f =tsok
             then  set fCO:=fpco_f.Name;
   }
   DoneMarker(Marker, nMarkers);
}

Function ShowKauT(_wKau : Word; _cKau : Comp;T : word): String;
{
  Result := if (GetAnyKAU(cgAkSimple, _wKau, _cKau), GivenAnName(T), '');
}

function CheckInPutVars:boolean;
{
  result:=false;

  if (DTB=ZeroDate) {
    message('Пожалуйста, укажите дату');

    exit;
  }

  result:=true;
}


function GetDEND:date;
var pRTYPE:type$rltRents;
{
  Result:=ZeroDate;
  pRent.GetRentRec(RLTROOMS.nrec, roRoom, DTB,pRTYPE);
  if pRTYPE.dTo<>ZeroDate then Result:=pRTYPE.dTo;
}

Function GetAreaOneObj(os_nrec : comp; var aInf : tObjArea ) : Boolean;
  var
   _MyOrg,_CO,nrecdog,nrecdog_up,real_nrec :comp;
   _Predpr,_NomGen,_NameD,PS,_Podr,_Prim:string;
   _S_All_B:double;
   cnt,indx : longint;
//   i : word;
   yesPodr : boolean;
{
  result:=false;
  Marker := InitMarker('GetRltBuilding', 8, 200, 100, false);
  ClearMarker(Marker);
  DTB :=cur_date;
  ResetBounds(#RLTBUILDINGS)
  if getfirst RLTBUILDINGS where ((os_nrec == RLTBUILDINGS.ckatos))=tsok
  {
    InsertMarker(Marker,rltBuildings.nRec);
    tKol:=1;
  }
  setBounds(#RLTBUILDINGS)

  if GetMarkerCount(Marker)=0
    exit;

  cnt :=0;

  _loop RLTOBJTREE
  {
    if getfirst RLTBUILDINGS =tsok then
    {
     if tKol>0 then
      {
        if not FoundMarker(Marker,RLTBUILDINGS.nrec) then continue;
      }

      if getlast RLTATTRHIST_build = tsok
      {
        _NomGen:=RLTATTRHIST_build.svalues[6];
        _S_All_B:= RLTATTRHIST_build.dovalues[4];
      }

      _loop RLTFLOORS
      {

        _NameD:='Этаж №'+string(RLTFLOORS.NO);
        var tND:string=_NameD;
        _loop RLTROOMS
        {
          _SA:=sGetAttr ( corltRooms, rltRooms.nrec, 'VA_RLT_NAME' );
          _NameD:=tND+if(RLTROOMS.NOFACT<>'',', '+RLTROOMS.NOFACT,'')+if(_SA<>'',', '+_SA,'');
          _Podr:='';PS:=''; _CO:=0;
          if getfirst RLTRENTS = tsok then
          {

            if cfpco_f<>0 then if ( cfpco_f<>RLTRENTS.CFPCO) then continue;
            if getfirst fpco=tsok then
           {

//             _Podr:=fpco.name;
//           if Priz1=1 then {PS:=if(fpco.code<>'',fpco.code+', ','')+ fpco.name;_CO:= fpco.nrec;}
             nrecdog:=nrecdog_up:=0;
             real_nrec:=fpco.cmean;
             if fpco.coTable=1
             {
               if getlast rltLinks where (( RLTROOMS.nrec == rltLinks.cobj and 50 == rltLinks.VIDOBJ))=tsok
                 nrecdog:=rltLinks.cDogovor;
               if getfirst fastfirstrow dogovor where ((rltLinks.cDogovor == dogovor.nrec))=tsok
                 if (dogovor.tidk=401 and dogovor.cdogovor<>0h)
               {
                 nrecdog_up :=dogovor.cdogovor;
               }
             }
//             li1:=FindItem(aInf,real_nrec);
//             if li1=-1
            }
             yesPodr:=false;

//            if getlast RLTATTRHIST_Room = tsok
            if getfirst fastfirstrow RLTATTRHIST_Room = tsok
            {

             for(i:=1;i<=Count(aInf);i++)
             {
               if (aInf[i].objrec=real_nrec and fpco.coTable=aInf[i].tipobj)
               {
                 if aInf[i].tipobj=2
                 {
                   yesPodr:=true;
                   indx :=i;
                   Break;
                 }
                 else
                  if aInf[i].dognrec =nrecdog
                 {
                   yesPodr:=true;
                   indx :=i;
                   Break;
                 }
               }
             }

             if (not yesPodr)
             {
               cnt++;
               aInf[cnt].objrec  :=real_nrec;//RLTRENTS.CFPCO;
               aInf[cnt].tipobj  :=fpco.coTable;
               aInf[cnt].dognrec :=nrecdog;
               aInf[cnt].dognrec_up :=nrecdog_up;
               aInf[cnt].allArea   := RLTATTRHIST_Room.DOVALUES[4];
               aInf[cnt].ManufArea := RLTATTRHIST_Room.DOVALUES[10];
               aInf[cnt].VspArea   := RLTATTRHIST_Room.DOVALUES[11];
             }
             else
             {
               aInf[indx].allArea   += RLTATTRHIST_Room.DOVALUES[4];
               aInf[indx].ManufArea += RLTATTRHIST_Room.DOVALUES[10];
               aInf[indx].VspArea   += RLTATTRHIST_Room.DOVALUES[11];
             }
            }
           }

        }
      }
    }
  }

  DoneMarker(Marker, 'GetRltBuilding');
//  Message('cntarr='+Count(aInf));
  if Count(aInf)>0
    Result:=true;
}

function GetData:boolean;
var
 _MyOrg,_CO:comp;
 _Predpr,_NomGen,_NameD,PS,_Podr,_Prim,_OSISp:string;
 _S_All_B:double;


{
 Result:=true;
 liRep:=0;
 delete all TmpOborot;
    i_s_all:=   i_S_Pro:=   i_S_Vsp:=   i_S_bit:=   i_S_en:=   i_S_Skl:=0;
 StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Анализ данных...',0);
 i1:=i2:=i3:=i4:=0;
 _MyOrg:=coGetTune('MYORG') ;_Predpr:='';
 if getfirst katorg where ((_MyOrg == katorg.nrec))=tsok then  _Predpr:=KatOrg.shortname;
  Marker := InitMarker('GetRltBuilding', 8, 200, 100, false);
  MarkerCO := InitMarker(iGetKau.GetMarkerName(cgKau_FpCO), 8, 200, 100, false);
 _loop RLTOBJTREE
 {
 if getfirst RLTBUILDINGS =tsok then
 {
   if tKol>0 then
    {
      if not FoundMarker(Marker,RLTBUILDINGS.nrec) then continue;
    }

   _NomGen:=''; _S_All_B:=0; _OSISp:='';

   if getfirst spkatos=tsok then
    {

     if getfirst ISPOS = tsok then    _OSISp:= ISPOS.nameis;
    }
   if getfirst RLTATTRHIST_build = tsok
    {
      _NomGen:=RLTATTRHIST_build.svalues[6];
      _S_All_B:= RLTATTRHIST_build.dovalues[4];
    }
    _NameD:='';
    var SS:string=RLTBUILDINGS.Name;
    var SS_Inv:string=RLTBUILDINGS.InvNo;
    if SS='' then SS:=RLTOBJTREE.SortName;
    if SS_Inv='' then SS_Inv:=Substr(SS,1,Pos('/',SS)-1);
    liRep++;
    aOsRep[liRep]:= RLTBUILDINGS.ckatos;

    _loop RLTFLOORS
    {
     _NameD:='Этаж №'+string(RLTFLOORS.NO);
     var tND:string=_NameD;
     _loop RLTROOMS
      {
        _SA:=sGetAttr ( corltRooms, rltRooms.nrec, 'VA_RLT_NAME' );
        _NameD:=tND+if(RLTROOMS.NOFACT<>'',', '+RLTROOMS.NOFACT,'')+if(_SA<>'',', '+_SA,'');
        _Podr:='';PS:=''; _CO:=0;
        if getfirst RLTRENTS = tsok then
        {


        if tCO>0 then
          {
              if not FoundMarker(MarkerCO,RLTRENTS.CFPCO) then continue;
          }

        if getfirst fpco=tsok then
         {

           //_Podr:=fpco.name;
           //if Priz1=1 then {PS:=if(fpco.code<>'',fpco.code+', ','')+ fpco.name;_CO:= fpco.nrec;}

       //   _Podr:= ShowKau(cgKau_FPCO,fpco.nrec);
        //  if Priz1=1 then {PS:=_Podr;_CO:= fpco.nrec;}
           _Podr:=PS:=if(fpco.abbr<>'',fpco.abbr+', ','')+ fpco.name;
          if Priz1=1 then {_CO:= fpco.nrec;}

          }
        }
        if cfpco_f<>0 then if ( _Podr='') then continue;
        if Priz1=1 then IF PS='' THEN PS:=' Без подразделения';
        t_s_all :=          t_S_Pro :=            t_S_Vsp :=          t_S_bit :=                  t_S_en  :=        t_S_Skl := 0;
        _Prim:='';
        if getfirst fastfirstrow RLTATTRHIST_Room = tsok
        {
        t_s_all := RLTATTRHIST_Room.DOVALUES[4];
        t_S_Pro := RLTATTRHIST_Room.DOVALUES[10];
        t_S_Vsp := RLTATTRHIST_Room.DOVALUES[11];
        t_S_bit := RLTATTRHIST_Room.DOVALUES[12];
        t_S_en  := RLTATTRHIST_Room.DOVALUES[13];
        t_S_Skl := RLTATTRHIST_Room.DOVALUES[14];
        _Prim   := RLTATTRHIST_Room.SVALUES[7];
        }
        i_s_all  :=  i_s_all + t_s_all ;
        i_S_Pro  :=  i_S_Pro + t_S_Pro ;
        i_S_Vsp  :=  i_S_Vsp + t_S_Vsp ;
        i_S_bit  :=  i_S_bit + t_S_bit ;
        i_S_en   :=  i_S_en  + t_S_en  ;
        i_S_Skl  :=  i_S_Skl + t_S_Skl ;

         ClearBuffer(#TmpOborot);
         set  TmpOborot.S       := SS_Inv+SS+'#'+_NameD;
         set  TmpOborot.OS      := SS_Inv+SS;
         set  TmpOborot.InvNum  := SS_inv;
         set  TmpOborot.Name    := _NameD;
         set  TmpOborot.NomGen  := '';
         set  TmpOborot.Predpr  := '';
         set  TmpOborot.Podr    := _Podr;
         set  TmpOborot.Proc    :=  t_s_all/_S_All_B*100;
         set  TmpOborot.S_All   :=  t_s_all;
         set  TmpOborot.S_Pro   :=  t_S_Pro;
         set  TmpOborot.S_Vsp   :=  t_S_Vsp;
         set  TmpOborot.S_bit   :=  t_S_bit;
         set  TmpOborot.S_en    :=  t_S_en;
         set  TmpOborot.S_Skl   :=  t_S_Skl;
         set  TmpOborot.Prim    := _prim;
         set  TmpOborot.CO      := _CO;
         set  TmpOborot.wStatus:= pRent.GetRentStatus(RLTROOMS.nrec, roRoom, DTB);
         set  TmpOborot.DEND   := GetDEND;
         set  TmpOborot.osisp   :=_OSISp;
         Insert current TmpOborot;

         if  getfirst tmpoborot where ((1 == TmpOborot.Tip  and '' == tmpoborot.OS and SS_Inv+SS == tmpoborot.S and _CO == tmpoborot.CO))=tsok then
          {
                set  TmpOborot.S_All   :=  TmpOborot.S_All+t_s_all;
                set  TmpOborot.S_Pro   :=  TmpOborot.S_Pro+t_S_Pro;
                set  TmpOborot.S_Vsp   :=  TmpOborot.S_Vsp+t_S_Vsp;
                set  TmpOborot.S_bit   :=  TmpOborot.S_bit+t_S_bit;
                set  TmpOborot.S_en    :=  TmpOborot.S_en +t_S_en;
                set  TmpOborot.S_Skl   :=  TmpOborot.S_Skl+t_S_Skl;
                set  TmpOborot.Proc    :=  TmpOborot.S_All/_S_All_B*100;
                update current TmpOborot;

          }
           else
          {
                ClearBuffer(#TmpOborot);
                set  TmpOborot.S       := SS_Inv+SS;
                set  TmpOborot.InvNum  := SS_inv;
                set  TmpOborot.Name    := SS;
                set  TmpOborot.NomGen  := _NomGen;
                set  TmpOborot.Predpr  := _Predpr;
                set  TmpOborot.Podr    := '';
                set  TmpOborot.Proc    :=  t_s_all/_S_All_B*100;
                set  TmpOborot.S_All   :=  t_s_all;
                set  TmpOborot.S_Pro   :=  t_S_Pro;
                set  TmpOborot.S_Vsp   :=  t_S_Vsp;
                set  TmpOborot.S_bit   :=  t_S_bit;
                set  TmpOborot.S_en    :=  t_S_en;
                set  TmpOborot.S_Skl   :=  t_S_Skl;
                set  TmpOborot.Prim    := '';
                set  TmpOborot.TIP     := 1;
                set  TmpOborot.CO      := _CO;
                set  TmpOborot.osisp   :=_OSISp;
                Insert current TmpOborot;
          }

         if  getfirst tmpoborot where ((2 == TmpOborot.Tip  and _CO == tmpoborot.CO))=tsok then
          {
                set  TmpOborot.S_All   :=  TmpOborot.S_All+t_s_all;
                set  TmpOborot.S_Pro   :=  TmpOborot.S_Pro+t_S_Pro;
                set  TmpOborot.S_Vsp   :=  TmpOborot.S_Vsp+t_S_Vsp;
                set  TmpOborot.S_bit   :=  TmpOborot.S_bit+t_S_bit;
                set  TmpOborot.S_en    :=  TmpOborot.S_en +t_S_en;
                set  TmpOborot.S_Skl   :=  TmpOborot.S_Skl+t_S_Skl;
                update current TmpOborot;

          }
           else
          {
                ClearBuffer(#TmpOborot);
                set  TmpOborot.S       := PS+SS_Inv+SS;
                set  TmpOborot.InvNum  := SS_inv;
                set  TmpOborot.Name    := PS;
                set  TmpOborot.S_All   :=  t_s_all;
                set  TmpOborot.S_Pro   :=  t_S_Pro;
                set  TmpOborot.S_Vsp   :=  t_S_Vsp;
                set  TmpOborot.S_bit   :=  t_S_bit;
                set  TmpOborot.S_en    :=  t_S_en;
                set  TmpOborot.S_Skl   :=  t_S_Skl;
                set  TmpOborot.Prim    := '';
                set  TmpOborot.TIP     := 2;
                set  TmpOborot.CO      := _CO;
                set  TmpOborot.osisp   :=_OSISp;
                Insert current TmpOborot;
          }







      }
    }
 }
 }
 lCountRow := RecordsInTable(#TmpOborot);
 DoneMarker(Marker, 'GetRltBuilding');
 DoneMarker(MarkerCO, iGetKau.GetMarkerName(cgKau_FpCO));
 if lCountRow<=0 then Result:=false;
 StopVisual('',0);
}

#include ExFunc.vpp;

function GenS1(w:word):string;
{
  Result:='';
  Case w of
   1: Result:='арендуется';
   2: Result:='закреплен';
  end;
}
procedure PrintData;
{

 var lColLast,lBegRow,lColNo,lRowNo:longint;
 lColLast  := 13;
 lRowNo    := 4;

// PuttableToDBF(#TmpOborot,'TmpOborot_2.dbf',ptfFullTable);
  var sTemplateName: string = TranslatePath(StartPathName+'XLS\AVAZ\Realting_Rep_All_S.xlsx');
 StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Печать отчета',lCountRow);
 _try
  {
  CreateExcelWithTemplate(sTemplateName);
  _try
   {

    SetCellStringValue('[' + UserName +' '+ _DateTimeToStr(_CurDateTime,'DD/MM/YY HH:NN') + ']',1,1);
    SetCellStringValue('Общая площадь на '+DateToStr(DTB,'DD Month YYYY')+' г.',2,1);
/*
     lColNo:= 0;
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo); SetCellNumberValue(i1                                      ,lRowNo,lColNo);
     inc(lColNo);
     inc(lColNo); SetCellNumberValue(i2                                      ,lRowNo,lColNo);
     inc(lColNo);
     inc(lColNo); SetCellNumberValue(i3                                      ,lRowNo,lColNo);
     lRowNo++;
     */
//  Инв. номер	Наименование	Номер по ген. плану	Предприятие	Подразделение	Процент	Общая площадь	Произв.	Вспом.	С.быт.	Энерг. хоз-во	Склад. хоз-во	Примечание
     _loop TmpOborot where ((2 == TmpOborot.tip))
    {
    If priz1=1 then
    {
    lColNo:= 0;

     inc(lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.Name                                         ,lRowNo,lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.S_All                                        ,lRowNo,lColNo);
/*
     inc(lColNo); SetCellNumberValue(TmpOborot.S_Pro                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.S_Vsp                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.S_bit                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.S_en                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.S_Skl                                        ,lRowNo,lColNo);
*/
     inc(lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.osisp                                        ,lRowNo,lColNo);

     if TmpOborot.tip=2 then
       {
        xlSetFontStyle(xlBold ,lRowNo,1,lRowNo,lColNo     );
        xlSetFontColor(0FF0000h ,lRowNo,1,lRowNo,lColNo     );
       }

     lBegRow:= lRowNo;
     lRowNo++;
    }
    _loop TmpOborot2 where ((1 == TmpOborot2.tip and TmpOborot.CO == TmpOborot2.CO))
    {
     lColNo:= 0;

     inc(lColNo); SetCellStringValue(TmpOborot2.InvNum                                       ,lRowNo,lColNo);
     if TmpOborot2.tip<>1 then
       {
         xlSetFontColor(0FFFFFEh ,lRowNo,1,lRowNo,1     );
       }
     inc(lColNo); SetCellStringValue(TmpOborot2.Name                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot2.NomGen                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot2.Predpr                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot2.Podr                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(GenS1(TmpOborot2.wStatus)                                          ,lRowNo,lColNo);
     inc(lColNo); SetCellDateValue(TmpOborot2.DEND                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot2.Proc                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot2.S_All                                        ,lRowNo,lColNo);
/*
     inc(lColNo); SetCellNumberValue(TmpOborot2.S_Pro                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot2.S_Vsp                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot2.S_bit                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot2.S_en                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot2.S_Skl                                        ,lRowNo,lColNo);
*/
     inc(lColNo); SetCellStringValue(TmpOborot2.Prim                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot2.osisp                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(GenS1(TmpOborot2.wStatus)                               ,lRowNo,lColNo);
     inc(lColNo); SetCellDateValue(TmpOborot2.DEND                                         ,lRowNo,lColNo);


     if TmpOborot2.tip=1 then
       {
        xlSetFontStyle(xlBold ,lRowNo,1,lRowNo,lColNo     );
       }


     lBegRow:= lRowNo;
     lRowNo++;

    _loop TmpOborot3 where ((0 == TmpOborot3.tip and TmpOborot2.s == TmpOborot3.Os  and TmpOborot.CO == TmpOborot3.CO))
    {
     if not NextVisual then continue;
     lColNo:= 0;

     inc(lColNo); SetCellStringValue(TmpOborot3.InvNum                                       ,lRowNo,lColNo);
     if TmpOborot3.tip<>1 then
       {
         xlSetFontColor(0FFFFFEh ,lRowNo,1,lRowNo,1     );
       }
     inc(lColNo); SetCellStringValue(TmpOborot3.Name                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot3.NomGen                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot3.Predpr                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot3.Podr                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(GenS1(TmpOborot3.wStatus)                                          ,lRowNo,lColNo);
     inc(lColNo); SetCellDateValue(TmpOborot3.DEND                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot3.Proc                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot3.S_All                                        ,lRowNo,lColNo);
/*
     inc(lColNo); SetCellNumberValue(TmpOborot3.S_Pro                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot3.S_Vsp                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot3.S_bit                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot3.S_en                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot3.S_Skl                                        ,lRowNo,lColNo);
*/
     inc(lColNo); SetCellStringValue(TmpOborot3.Prim                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot3.osisp                                        ,lRowNo,lColNo);
     lBegRow:= lRowNo;
     lRowNo++;

    }
    }
    }

     lColNo:= 0;

     inc(lColNo);
     inc(lColNo); SetCellStringValue('Итого:'                                                ,lRowNo,lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo); SetCellNumberValue(i_s_all                                     ,lRowNo,lColNo);
/*
     inc(lColNo); SetCellNumberValue(i_S_Pro                                     ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(i_S_Vsp                                     ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(i_S_bit                                     ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(i_S_en                                      ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(i_S_Skl                                     ,lRowNo,lColNo);
*/
     inc(lColNo);
     xlSetFontStyle(xlBold ,lRowNo,1,lRowNo,lColNo     );
     lBegRow:= lRowNo;
     lRowNo++;


}
  _finally
   {
    StopVisual;
   }
  }
  _except
    on ExExcelFatalError:
     {
      StopVisual;
      message(sErrMessage, lErrMessageMode);
     }
  _finally
    xlKillExcel;


}

Function GetDataObjReal(dat: date ; var aOs : tRealOs ) : Boolean;
{

  DTB:=dat;
  var phUNastrOsPos:comp=pOsFun.GetUserNastrOsPos(15);
  if (GetFirst NastrOs where (( phUNastrOsPos == NastrOs.nRec )) = tsOk)
    {}
  Setlimit(aOsRep,0); 
  If(GetData)
  {
    aOs:=aOsRep;
  }
}

HandleEvent
//----------------------

cmInit:
{
  MarkKol;
  MarkCO;
   //var pOsFun : OsFun;
  ReadMyDsk(DTB, 'Realting_Rep_All_S_DTB',true);
  if DTB=ZeroDate then DTB:=Cur_date;
  ReadMyDsk(Priz1, 'Realting_Rep_All_S_Priz1',true);
  ReadMyDsk(cfpco_f, 'Realting_Rep_All_S_cfpco_f',true);
   RescanPanel(#FpCo_F);
  var phUNastrOsPos:comp=pOsFun.GetUserNastrOsPos(15);
  if (GetFirst NastrOs where (( phUNastrOsPos == NastrOs.nRec )) = tsOk)
        {
        }
}


cmOk:
{


  If(Not GetData)
  {
    message('Нет данных! ');
    exit;
  }
  

  PrintData;
}
//---------------------------
cmPick:{
  if curfield=#fco {
     var tc:comp;
     if iGetKau.GetCodeKau(cgiPickLeaf+cgiPickMult,cgKau_FpCO, tc)>0 then
         {
              MarkCo;
         }
  }
  if curfield=#fObj then
  {

        if ( RunInterface('L_Realting::GetRltBuilding', comp(0), cBild, cgiMulti + cgiNotClear) <> cmCancel )
          {
               MarkKol;
          }

  }
   RereadRecord(#FpCo_F);

} //cmPick:

//---------------------------
cmDelOnProtect:{
  if curfield=#fCO
  {
   tCO:=0;set fCO:='';
   Marker := InitMarker(iGetKau.GetMarkerName(cgKau_FpCO), 8, 200, 100, false);
   ClearMarker(Marker);
   DoneMarker(Marker, iGetKau.GetMarkerName(cgKau_FpCO));
   RescanPanel(#FpCo_F);
  }
  if curfield=#fObj then
  {
   tKol:=0;set fObj:='';
   Marker := InitMarker('GetRltBuilding', 8, 200, 100, false);
   ClearMarker(Marker);
   DoneMarker(Marker, 'GetRltBuilding');
   RescanPanel(#FpCo_F);
  }
}

//---------------------------

cmDone:{
  SaveMyDsk(DTB, 'Realting_Rep_All_S_DTB');
  SaveMyDsk(Priz1, 'Realting_Rep_All_S_Priz1');
  SaveMyDsk(cfpco_f, 'Realting_Rep_All_S_cfpco_f');
}

end;

End.

VipInterface UserReport_Realting_Rep_All_S Implements IUserReport;

Interface UserReport_Realting_Rep_All_S;

create view;

procedure Run;
begin
 RunInterface(Realting_Rep_All_S);
end;
function GetReportName: String;
begin
  GetReportName := 'Общая площадь недвижимости';
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := 'Недвижимость';
  case Level of
    1 : GetGroupName := 'Недвижимость';
  end;
end;

function GetPriority : Integer;
begin
  GetPriority := -100;
end;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '*';
!  case Ind of    // нет 
!    1 : VisibleInModule := 'B_OSN';
!    2 : VisibleInModule := '';
!  end;
end;
end.
