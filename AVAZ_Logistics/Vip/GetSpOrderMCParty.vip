#component "M_UP"

Interface GetSpOrderMCParty 'Выбор МЦ из спецификации ордера', escClose, doAccept, cyan;

Create view
Var
//------------------------------------------------------------------------------
  cSklOrder_
, cMC_
, cParty_
, cSpecMTR_
                : comp;
//-----,-------------------------------------------------------------------------
  dkol_
, dPrice_                : double;
//------------------------------------------------------------------------------

From
  SpOrder
, SklOrder
, KatEd
, KatMC
, KatParty
, SPECMTR
Where
((
       cSklOrder_         == SklOrder.NRec
  AND  SklOrder.NRec      == SpOrder.cSklOrder

  AND  SpOrder.cParty     == KatParty.NRec
  AND  SpOrder.cMC        == KatMC.NRec
  AND  KatMC.cEd          == KatEd.NRec
))
;

Parameters
  cSklOrder_
, cMC_
, cParty_
, dkol_
, dPrice_
, cSpecMTR_
;



Panel pnMC;

Browse br1 ('', hcNoContext, sci1Esc);
  Table SpOrder;

Fields

  KatMC.Barkod
                'Номенклатурный','номер'
                : [10], Protect;
  KatMC.Name
                'Наименование МЦ'
                : [20], Protect;
  KatParty.KOD
                'Партия', 'код'
                : [10], Protect;
  KatParty.Name
                'Партия', 'наименование'
                : [15], Protect;
  KatEd.abbr
                'ЕдИзм'
                : [6], Protect, NoAutoSize, Centered;
  SpOrder.kol
                'Количество'#13'прихода'
                : [10.2], Protect;
  SpOrder.srPrice
                'Цена'
                : [10.2], Protect;

end; //br1
end; //p

//******************************************************************************

HandleEvent

cmInit:
  {
    if cSklOrder_ = 0
      {
        Message('Не указан ордер');
        Exit;
      }
  }
cmDone:
{
  cMC_    := SpOrder.cmc;
  cParty_ := SpOrder.cparty;
  dkol_   := SpOrder.kol;
  dPrice_ := SpOrder.srprice;
  if getfirst fastfirstrow specmtr where ((coSpOrder == specmtr.COTABLE and SpOrder.nrec == specmtr.CSPEC))=tsok then
     cSpecMTR_:=specmtr.nrec;
}
end; // HandleEvent
End. // Interface

//******************************************************************************
