#component "L_SOPRDOC"
#include KatSopr.vih
#include CopySopr.vih
#include RaschActKoeff.vih
#include WoodFuns.Vih
#include ChAkts.obj
#include AktRecFun.vih
#include Svert.vih
#include CopyAkt.inc
#include CopyObjAcct.vih
#include SpyTNTPR.vih

//******************************************************************************
//******************************************************************************

alter Interface iCopySopr;

overload
 Function CheckPodrArchiv (_cPodr : comp) : boolean;

end;
Function CheckPodrArchiv (_cPodr : comp) : boolean;
{
  Result := True;
  if (_cPodr = 0)
    Exit;

  if KVidSoprIn <> cgKB_Doc
   if GetFirst KatPodr where (( _cPodr == KatPodr.nRec )) = tsOk
    if (KatPodr.LASTDATE <> ZeroDate) and (KatPodr.LASTDATE <= Cur_Date)
    {
      Message('Невозможно создать документы по подразделению в архиве "' + KatPodr.Name + '"!');
      Result := False;
    }
}

End.
