#include ExtrKau.vih // дополнительная аналитика
#include iDF.vih
Interface iDF '' EscClose, doAccept;

var
 ExtKauFunc:               ExtrKauFunctions;   // функции работы с допаналитикой

create view as
select lschet.*
from lschet
    ,spkau
    ,spkau spkau_chk
    ,kaureff
    ,attrval attrvald
;

Function GetBrUchNrec(_sPar:string; _cLS : comp) : comp;
var _cBU,_cB,_cU:comp;
{
  Result := 0;
  if getfirst fastfirstrow lschet where ((_cLS == lschet.nrec)) <> tsok then exit;
  _cBU:= ExtKauFunc.fcGetDopAnExtr(cgKAU_BrUch,LSCHET.KAUEXTR, LSCHET.TBLEXTR);
  if getfirst fastfirstrow spkau where ((_cBu == spkau.nrec)) <> tsok then exit;
  if getfirst fastfirstrow Kaureff where ((
    coSpKau ==  Kaureff.coTable
    and
    SpKau.nrec ==  Kaureff.crec
    and
    cgKau_KatPodr ==  Kaureff.wkau
    ))=tsok
     {
       _cU:=SpKau.nrec;
       _cB:=0;
     }
    else
     {
      _cB:=SpKau.nrec;
      _cU:=0;
       if getfirst fastfirstrow Kaureff where ((
          coSpKau ==  Kaureff.coTable
          and
          SpKau.cnode ==  Kaureff.crec
          and
          cgKau_KatPodr ==  Kaureff.wkau
        ))=tsok
       {
          _cU:=SpKau.cnode;
       }

     }
   Result:=_cBU;
   case _sPar of
    VA_SO_BRIG : Result:= _cB;
    VA_SO_UCH  : Result:= _cU;
   end;
}


procedure SaveBrUchFromLStoPK(_cLS : comp;_cPK:comp);
var _tc:comp;
    _ts:string;
    cAttr_Uch,cAttr_Brig:comp;
{
       cAttr_Uch:=ExtAttr_ID ( coPersCard,VA_SO_UCH);
       cAttr_Brig:=ExtAttr_ID ( coPersCard,VA_SO_BRIG);
       _tc:=GetBrUchNrec(VA_SO_BRIG, _cLS);
       _ts:='';if getfirst fastfirstrow spkau_chk where ((_tc == spkau_chk.nrec))=tsok then _ts:=spkau_chk.name;
       if _tc <>0 then coSetAttrID(coPersCard,_cPK, cAttr_Brig, _tc, _ts) ;
                  else delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Brig == attrvald.CATTRNAM)) ;
       _tc:=GetBrUchNrec(VA_SO_UCH, _cLS);
       _ts:='';if getfirst fastfirstrow spkau_chk where ((_tc == spkau_chk.nrec))=tsok then _ts:=spkau_chk.name;
       if _tc <>0 then coSetAttrID(coPersCard,_cPK, cAttr_UCH, _tc, _ts) ;
                  else delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Uch == attrvald.CATTRNAM)) ;

}

end.
