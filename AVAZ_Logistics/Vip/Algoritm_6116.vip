
#define OBJINT_ALGORITM
#include objintpl.vin
#include NalTunes.vih
#include PlPor.vih

#component "M_MnPlan"
VipInterface Algoritm_6116 implements oAlgoritm_Sys;
Interface Algoritm_6116;
show(5,1,160,30);


#include ExtAttr.var
var
     cWorkFormPl,pNrec:comp;
     wEvnCode: Word;
     sEvnLine: String;
     tError : word;



create view



as select
  *
from
    FormPl,SaldTune SaldTuneR,SpecMtr SpecMtrR,SaldTune SaldTune2,SpecMtr SpecMtr2,SOPRORDB,spsopr,katsopr
 where ((
             cWorkFormPl                 == FormPl.NRec
             and  coSoprOrdB             == SpecMTRR.coTable
             and  SoprOrdB.nRec          == SpecMTRR.cSpec
             and  ( 0                    <> SpecMTRR.cSpec )
             and  SpecMTRR.cSaldTune     == SaldTuneR.nRec
             and  coSpSopr               == SpecMTR2.coTable
             and  SpSopr.nRec            == SpecMTR2.cSpec
             and  ( 0                    <> SpecMTR2.cSpec )
             and  SpecMTR2.cSaldTune     == SaldTune2.nRec

        ))
 ;


exception ExUser1, ExUser2;

Function GetNum : word;
{
  GetNum := 6116;
}

function GetName : string;
{
  GetName := 'Алгоритм проверки распределения позиций по тарным местам';
}

Function GetMemo ( st:oSteckCommonString ) : Boolean;
{
  GetMemo := True;

  st.push('Алгоритм проверки распределения позиций по тарным местам');
}

Function GetNameInter : String;
{
  GetNameInter := 'Algoritm_6116' ;
}

Function GetNameInterPr : String;
{
  GetNameInterPr := 'AlgoritmSetup_6116' ;
}

function itsTaraM(cc:comp):boolean;
{
  Result:= word(sGetAttr(coKatMc,cc,VA_TARAM))>0;
}


function CheckORDB(typeDoc : word): boolean;
var MaxKol:double;
var cAttr_KatPar,_tp:comp;
{
  result := true;
  cAttr_KatPar:=ExtAttr_ID ( coSoprOrdB,VA_KatPar);

  if Getfirst katsopr where ((pNrec == katsopr.nrec))<>tsok then {result := false; exit;}
  _loop spsopr where ((katsopr.nrec == spsopr.csopr))
  {
  if itsTaraM(spsopr.cmcusl) then
   {

    MaxKol:=SPSOPR.KOLFACT;
    if getfirst SoprOrdB where ((SpSOpr.nrec == SoprOrdB.cspsopr)) <>tsok then
      {
        Message('Позиция № '+word(spsopr.npp)+' - Нет распределения по тарным местам');
        result := false; exit;
      }
    if spsopr.cparty=0 then
       {
             Message('Позиция № '+word(spsopr.npp)+' - Нет Партии в позиции');
             result := false; exit;
       }
    if  getfirst fastfirstrow  SaldTune2 <>tsok then
           {
             Message('Позиция № '+word(spsopr.npp)+' - Нет ЦУ в позиции');
             result := false; exit;
           }
     _loop SoprOrdB where ((SpSOpr.nrec == SoprOrdB.cspsopr))
    {
      if coGetAttrID ( coSoprOrdB, SoprOrdB.nrec, cAttr_KatPar )=0 then
       {
             Message('Позиция № '+word(spsopr.npp)+' - Нет Партии в распределении по тарным местам');
             result := false; exit;
       }

      if  getfirst fastfirstrow  SaldTuneR <>tsok then
           {
             Message('Позиция № '+word(spsopr.npp)+' - Нет ЦУ в распределении по тарным местам');
             result := false; exit;
           }

      MaxKol:=MaxKol-SoprOrdB.kol;

    }
    if Round(MaxKol,4)<>0 then
      {
        Message('Позиция № '+word(spsopr.npp)+' - Количество в распределении не равно количеству по позиции');
        result := false; exit;
      }
   }
  }
}


Function InitInter( Var pt:TRecAcc ) : Boolean;
{
  InitInter := False;

_try
{
 pt.Visua    := Word(0);
 pt.MessEnd  := Word(0);

  cWorkFormPl := pt.cFormPl;
  if (GetFirst FormPl <> tsOk)
  {
   wEvnCode := 1;
   sEvnLine := 'Пользовательский алгоритм не найден (скорее всего, он был удален)';
   _raise ExUser2;
  }

 InitInter := True;
}  //'_try

_except
 on ExUser1:
  pt.Error := 1;

 on ExUser2:
 {
  Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally
{
 //'
}
}




//=======================================================================
Function RunInter( wflag:Word; Var pt:TRecAcc ) : Boolean;
{
  #__UNUSED__(wflag)

  pNrec:=pt.cpNrec;
  if pt.TypeCpNrec=0 or pt.TypeCpNrec=toPlanSnab then pNrec:=pt.cMnplan;
  if (not CheckORDB(pt.TypeCpNrec))
   {
    RunInter := False;
    pt.Binding := 8; // запрет
    pt.Error   := 1; // запрос
   }
  else
    RunInter := True;

}  //'_try

 HandleEvent
   CmValue1 : {
              }
 end;
end.
