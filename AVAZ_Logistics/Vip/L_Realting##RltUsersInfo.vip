#component "L_Realting"
#include EditDoc.vih
#include TXOPick.vih
#include KatOrg.vih

#doc
Документы по арендаторам
#end
Alter Interface RltUsersInfo;

create view as
select if (rltLinks.VidObj = roRoom,
    '№ '+rltGetStringFieldFromTable('rltRooms', 'NoFact', rltLinks.cObj)+'  '+rltGetStringFieldFromTable('rltRooms', 'NOBTI', rltLinks.cObj),
    if (rltLinks.VidObj = roPlace,
      if (trim(rltGetStringFieldFromTable('rltPlaces', 'Name', rltLinks.cObj)) = ''
       , rltGetStringFieldFromTable('rltPlaces', 'Addr', rltLinks.cObj)
       , rltGetStringFieldFromTable('rltPlaces', 'Name', rltLinks.cObj)),
      ''))
    ( FieldName = rltRoomName ),
if (rltLinks.VidObj = roRoom,rltGetAnyFieldFromTable('RLTBUILDINGS','INVNO',rltGetCompFieldFromTable('rltRooms', 'CBUILDING', rltLinks.cObj))+' '+rltGetAnyFieldFromTable('RLTBUILDINGS','NAME',rltGetCompFieldFromTable('rltRooms', 'CBUILDING', rltLinks.cObj))            ,
      if (rltLinks.VidObj = roPlace,rltGetAnyFieldFromTable('RLTBUILDINGS','INVNO',rltGetCompFieldFromTable('RLTPLACES', 'CBUILDING', rltLinks.cObj))+' '+rltGetAnyFieldFromTable('RLTBUILDINGS','NAME',rltGetCompFieldFromTable('RLTPLACES', 'CBUILDING', rltLinks.cObj))    ,
      ''))
    ( FieldName = rltObjName )
from rltlinks ,rltAttrHist,rltAttrHist rltAttrHist2 ,rltAttrHist rltAttrHistD,SpDocs SpDocsD , rltLinks rltLinksD,Dogovor DogovorD
where
((
 SpDocs.nRec          == rltLinks.cSpDocs
and rltLinks.VidObj      == rltAttrHist2.VidObj
and rltLinks.cObj        == rltAttrHist2.cObj
and Dogovor.dBeg        <<= rltAttrHist2.dChange
and rltAttrHist2.VidObj  == rltAttrHist.VidObj
and rltAttrHist2.cObj    == rltAttrHist.cObj
and rltAttrHist2.dChange == rltAttrHist.dChange
and DogovorD.TiDk     == SpDocsD.TiDk
and DogovorD.nRec     == SpDocsD.cDoc
and SpDocsD.nRec          == rltLinksD.cSpDocs
and rltLinksD.VidObj      == rltAttrHistD.VidObj
and rltLinksD.cObj        == rltAttrHistD.cObj
and DogovorD.dBeg        <<= rltAttrHistD.dChange
))

;
ExtendFormats brSpecDog;
ExtendFormats brTabDogovor;
ExtendFormats MyTree;

function GetSDog(_Dog:comp):double;
var Sum:double;
{
  Result:=0;
  if getfirst fastfirstrow DogovorD where ((_Dog == DogovorD.nrec))<>tsok then exit;
  _loop SpDocsD
   _loop rltLinksD
    if getfirst rltAttrHistD =tsok then Result:=Result+ RLTATTRHISTD.DOVALUES[4];

}

function GetSKontr(_Org:comp):double;
var Sum:double;
{
  Result:=0;
  _loop DogovorD where ((1 == DogovorD.direct and _Org == DogovorD.cOrg))
   _loop SpDocsD
    _loop rltLinksD
      if getfirst rltAttrHistD =tsok then Result:=Result+ RLTATTRHISTD.DOVALUES[4];

}

Browse brSpecDog (,,sci1Esc);
  Table SpDocs;

Fields
   rltObjName      'Объект','недвижимости'(,, sci1378Esc) : [10], protect,nopickbutton;
   rltRoomName     'Комната/Площадь'(,, sci1378Esc) : [17], protect,nopickbutton;
   if(IsValid(#RLTATTRHIST),RLTATTRHIST.DOVALUES[4],0) 'Площадь' ('Площадь') : [11.2], Protect,nopickbutton;
   RLTATTRHIST.SVALUES[8] 'Ось расположения' : [20], Protect,nopickbutton;
end;
Browse brTabDogovor (,,sci14Esc);
  Table Dogovor;

Fields
  GetSDog(Dogovor.nrec) 'Площадь' ('Площадь') : [11.2], Protect,nopickbutton;
end;

Panel pTree
  Table KatH;

Tree MyTree (,,sci1EscTree);


Fields
 GetSKontr(KatH.cmean) 'Площадь' ('Площадь') : [11.2], Protect,nopickbutton,noautosize;
end;
end
end.
