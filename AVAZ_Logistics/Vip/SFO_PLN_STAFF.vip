#include AttrTablePick.vih
#include ExtAttr.vih
#include KauReff.vih
#Include Getkau.vih
#include UserReport.vih;

#Doc
 Интерфейс для ввода плановой численности персонала</Brief>
#End

Interface SFO_PLN_STAFF 'Ввод плановой численности персонала', escClose, cyan;
Show At (,,190,);
var
 WorkYear:word;
 iKauReff : EditKauReff;
#include ExtAttr.var
#Include GetKau.var
/*
table struct SFO_PLN_STAFF (
 NREC  :COMP
,cDolj : comp
,cPodr : comp
,cBrig : comp
,cUchast : comp
,cNorma : comp
,Year : word
,PlanMes : array[1..12] of double
)
with index
(
  SFO_PLN_STAFF01 = cDolj+cPodr+cUchast+cBrig +cNorma+Year
)
;
*/


Create view t2
as select SFO_PLN_STAFF.*

from SFO_PLN_STAFF//,SFO_PLN_STAFF SFO_CHK
, SpKau KatUch
, BRIGAD KatBrig
, KatPodr
, KatKod
, Catalogs
, NormSFO
Where
((

 cgKatKod_NormSFO == KatKod.wType
 And
 KatKod.cOrg1    ==   Catalogs.nrec
 And
 KatKod.cOrg2   ==   KatPodr.nrec
 And
 KatKod.cOrg4   == KatUch.nrec
 And
 KatKod.cOrg5  == KatBrig.nrec
 And
 KatKod.cGroup  == NormSFO.nrec
 and
 KatKod.cOrg1  == SFO_PLN_STAFF.cDolj
 And
 KatKod.cOrg2  == SFO_PLN_STAFF.cPodr
 And
 KatKod.cOrg4  == SFO_PLN_STAFF.cUchast
 And
 KatKod.cOrg5  == SFO_PLN_STAFF.cBrig
 And
 KatKod.cGroup == SFO_PLN_STAFF.cNorma
 and
 WorkYear      == SFO_PLN_STAFF.Year


))
;

function CalcSR:double;
{
  Result:=(SFO_PLN_STAFF.PlanMes[01] +
           SFO_PLN_STAFF.PlanMes[02] +
           SFO_PLN_STAFF.PlanMes[03] +
           SFO_PLN_STAFF.PlanMes[04] +
           SFO_PLN_STAFF.PlanMes[05] +
           SFO_PLN_STAFF.PlanMes[06] +
           SFO_PLN_STAFF.PlanMes[07] +
           SFO_PLN_STAFF.PlanMes[08] +
           SFO_PLN_STAFF.PlanMes[09] +
           SFO_PLN_STAFF.PlanMes[10] +
           SFO_PLN_STAFF.PlanMes[11] +
           SFO_PLN_STAFF.PlanMes[12])/12;

}
function GetF(i:word):double;
{
  Result:=If(not isvalid(#SFO_PLN_STAFF),0,SFO_PLN_STAFF.PlanMes[i]);
}
/*
procedure CheckF(i:word);
{ var tval:double=SFO_PLN_STAFF.PlanMes[i];
  if getfirst fastfirstrow SFO_CHK where ((
        KatKod.cOrg1  == SFO_CHK.cDolj
        And
        KatKod.cOrg2  == SFO_CHK.cPodr
        And
        KatKod.cOrg4  == SFO_CHK.cUchast
        And
        KatKod.cOrg5  == SFO_CHK.cBrig
        And
        KatKod.cGroup == SFO_CHK.cNorma
        and
        WorkYear      == SFO_CHK.Year    )) <> tsok
    {
      ClearBuffer(#SFO_CHK);
      set SFO_CHK.cDolj   := KatKod.cOrg1   ;
      set SFO_CHK.cPodr   := KatKod.cOrg2   ;
      set SFO_CHK.cUchast := KatKod.cOrg4   ;
      set SFO_CHK.cBrig   := KatKod.cOrg5   ;
      set SFO_CHK.cNorma  := KatKod.cGroup  ;
      set SFO_CHK.Year    := WorkYear       ;
      insert current SFO_CHK;
    }
  set SFO_CHK.PlanMes[i]:=tval;
  update current SFO_CHK;
  ReScanPanel(#KatKod);
}
*/
procedure CheckF(i:word;ss:string);
{ var tval:double=double(ss);
  if getfirst fastfirstrow SFO_PLN_STAFF  <> tsok
    {
      ClearBuffer(#SFO_PLN_STAFF);
      set SFO_PLN_STAFF.cDolj   := KatKod.cOrg1   ;
      set SFO_PLN_STAFF.cPodr   := KatKod.cOrg2   ;
      set SFO_PLN_STAFF.cUchast := KatKod.cOrg4   ;
      set SFO_PLN_STAFF.cBrig   := KatKod.cOrg5   ;
      set SFO_PLN_STAFF.cNorma  := KatKod.cGroup  ;
      set SFO_PLN_STAFF.Year    := WorkYear       ;
      insert current SFO_PLN_STAFF;
    }
  set SFO_PLN_STAFF.PlanMes[i]:=tval;
  update current SFO_PLN_STAFF;
  ReScanPanel(#KatKod);
}
Panel p1;
screen scR1;
Show At (,,,3);
  Table KatKod;
Fields
  WorkYear : noProtect, spinButton [1, 2000, 3000];
<<

 `Нормативная численность персонала на ` .@@@@@@@@@@@ год

>>
end;




Browse br1 ('', hcNoContext, sci14Esc);
Show At (,4,,);
Table KatKod;

Fields
  Catalogs.Code             'Код','должности' ('Должность работника') : [8],Protect,noPickButton,nodel,noAutoSize;
  Catalogs.name             'Наименование','должности' ('Должность работника') : [25],Protect,noPickButton,nodel;
  KatPodr.kod               'Код','подразделения'  ('Подразделение') : [8],Protect,noPickButton,nodel,noAutoSize;
  KatBrig.NMBRIG            'Бригада' ('Бригада работника') : [17],Protect,noPickButton,nodel,noAutoSize;
  KatUch.name               'Участок'('Участок работника') : [10],Protect,noPickButton,nodel,noAutoSize;
  NormSFO.name              'Норма','СФО' ('Норма') : [20],Protect,noPickButton,nodel;
  [fPlanMes_01] GetF(01)    'Январь'    ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_02] GetF(02)    'Февраль'   ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_03] GetF(03)    'Март'      ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_04] GetF(04)    'Апрель'    ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_05] GetF(05)    'Май'       ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_06] GetF(06)    'Июнь'      ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_07] GetF(07)    'Июль'      ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_08] GetF(08)    'Август'    ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_09] GetF(09)    'Сентябрь'  ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_10] GetF(10)    'Октябрь'   ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_11] GetF(11)    'Ноябрь'    ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  [fPlanMes_12] GetF(12)    'Декабрь'   ('Месяц') : [8.0],NoProtect,noPickButton,noAutoSize;
  CalcSR                    'Среднее'   ('Среднее') : [10.2],Protect,Skip,noAutoSize;
end; //br1

HandleEvent

cmExprFieldChanged:
 {
   case curfield of
    #fPlanMes_01 : CheckF(01,ExprFieldValue);
    #fPlanMes_02 : CheckF(02,ExprFieldValue);
    #fPlanMes_03 : CheckF(03,ExprFieldValue);
    #fPlanMes_04 : CheckF(04,ExprFieldValue);
    #fPlanMes_05 : CheckF(05,ExprFieldValue);
    #fPlanMes_06 : CheckF(06,ExprFieldValue);
    #fPlanMes_07 : CheckF(07,ExprFieldValue);
    #fPlanMes_08 : CheckF(08,ExprFieldValue);
    #fPlanMes_09 : CheckF(09,ExprFieldValue);
    #fPlanMes_10 : CheckF(10,ExprFieldValue);
    #fPlanMes_11 : CheckF(11,ExprFieldValue);
    #fPlanMes_12 : CheckF(12,ExprFieldValue);


   end;

}
cmCheckField:
 {
   case curfield of
    #WorkYear: ReScanPanel(#KatKod);
   end;
}


end;
end;




HandleEvent
cmInit:
  {
    ReadMyDSK(WorkYear,'SFO_PLN_STAFF_WorkYear',false);
    if WorkYear=0 then WorkYear:=Year(Cur_Date);
  }
cmDone:
{
  SaveMyDSK(WorkYear,'SFO_PLN_STAFF_WorkYear');
}
end; // HandleEvent
End. // Interface


VipInterface UserReport_SFO_PLN_STAFF Implements IUserReport;

Interface UserReport_SFO_PLN_STAFF;

create view;

procedure Run;
begin
 RunInterface(SFO_PLN_STAFF);
end;
function GetReportName: String;
begin
  GetReportName := 'Ввод плановой численности персонала';
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := 'СФО';
  case Level of
    1 : GetGroupName := 'СФО';
  end;
end;

function GetPriority : Integer;
begin
  GetPriority := -100;
end;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '*';
end;
end.
