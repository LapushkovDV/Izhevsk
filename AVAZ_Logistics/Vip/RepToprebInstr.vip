#component "AVAZ_Logistics"
Interface RepToprebInstr 'Расчет потребности в закупке инструмента' ('', hcNoContext, sci1Esc);
  Show at(,,40,10);

var BegDat,EndDat : Date;
    NormDat, ValDat, PriceDat : Date;
    flagSvod : word;

Create View;

Screen scRep '' ('', hcNoContext, sci13Esc);
//  Table ;
Fields
 BegDat   : NoProtect;
 EndDat   : NoProtect;
 NormDat  : NoProtect;
 PriceDat : NoProtect;
 ValDat   : NoProtect;
 [Plan] '' : Protect,PickButton;
 flagSvod : NoProtect;
Buttons
 cmOk;
 cmCancel;
<<
 `Период`.@@@@@@@@@@@`-`.@@@@@@@@@@@
 `Дата состава норм`.@@@@@@@@@@@
 `Дата цены`        .@@@@@@@@@@@
 `Дата курса валют` .@@@@@@@@@@@
 `План`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  [.] Сводная по всем подразделениям`

  <. Сформировать .>  <. Отмена .>

>>
End;
HandleEvent // Interface

cmInit:
{
  set BegDat:= Date(1,1,Year(Cur_Date));
  set EndDat:= Date(31,12,Year(Cur_Date));
  set NormDat:= ValDat:= PriceDat:= Cur_Date;
};

End;
end.

#include UserReport.vih;
VipInterface UserReport_RepToprebInstr Implements IUserReport;
Interface UserReport_RepToprebInstr;
create view;
procedure Run;
begin
 RunInterfaceNoModal(RepToprebInstr);
end;
function GetReportName: String;
begin
  GetReportName := 'Расчет потребности в закупке инструмента';
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := 'СТО';
  case Level of
    1 : GetGroupName := 'СТО';
  end;
end;
function GetPriority : Integer;
begin
  GetPriority := -100;
end;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '*';
end;
end.
