#component "F_SFO"
#include ShowKau.vpp            // declare с КАУ
#include AttrTablePick.vih
#define __NRMSFOGT_VIP__

#doc
Интерфейс выбора норм выдачи СФО.<br>
#end
Alter Interface getNormSFO;
var
  _cFU,_cFB,_cFD,_cFP:comp;
  _FFF:word;
var refAttrTablePick: AttrTablePick;


function EnabledU:boolean;
var _cU,_cB:comp;
{
  Result:=false; _cU:=0;
//not bGetAttrId(coNormSFO, NormSFO.Nrec, cArchiveRecordAttrib)
  if getfirst fastfirstrow KatKod where ((NormSFO.nrec == KatKod.cgroup(noindex) ))  =tsok then
  {
    _cU:=KatKod.corg4;

  }
  if _CU=0 then Exit;
  if _cFU=_cU then Result:=true;
}

function EnabledB:boolean;
var _cU,_cB:comp;
{
  Result:=false; _cB:=0;
//not bGetAttrId(coNormSFO, NormSFO.Nrec, cArchiveRecordAttrib)
  if getfirst fastfirstrow KatKod where ((NormSFO.nrec == KatKod.cgroup(noindex) ))  =tsok then
  {
    _cB:=KatKod.corg5;
  }
  if _CB=0 then Exit;
  if _cFB=_cB then Result:=true;

}

function EnabledAVA:boolean;
{
  Result:=false;
 // message(_cFU+'  '+_cFB+'    '+_cFD+'  '+_cFP+'    '+_FFF );
  _loop KatKod where ((NormSFO.nrec == KatKod.cgroup(noindex) ))
  {
//     message(katkod.name+'    '+(_cFD=KatKod.corg1)+'  '+(_cFP=KatKod.corg2)+'    '+(_cFU=KatKod.corg4)+'  '+(_cFB=KatKod.corg5));
  if _cFD=KatKod.corg1 and _cFP=KatKod.corg2 and (_cFU=KatKod.corg4 or comp(0) = _cFU) and (_cFB=KatKod.corg5 or comp(0) = _cFB) then {Result:=true;exit}

  }
}


create view as
select Attrvald.* from Attrval Attrvald
Bounds WithAva =
      root == NormSFO.Nrec
  and (EnabledAva)
;

HandleEvent
cmInit:{

  ReadMyDsk(_FFF,'AVAZ_GET_CHK',false);
  ReadMyDsk(_cFU,'AVAZ_GET_UCH',false);
  ReadMyDsk(_cFB,'AVAZ_GET_BRIG',false);
  ReadMyDsk(_cFD,'AVAZ_GET_D',false);
  ReadMyDsk(_cFP,'AVAZ_GET_P',false);

  If inherited::handleevent ( cmInit ) = heAbort then abort;

  if boGetTune('AVTOVAZ.AVAZ_SFO.DPBU') and (_FFF>0)
      {

    //   if _cFU<>0 then
   //     {
//        if not BoundActive(tbWithUch)
  //        AddBounds(tbWithUch);
   //     }
   //    if _cFB<>0 then
   //     {
    //    if not BoundActive(tbWithBrig)
      //    AddBounds(tbWithBrig);
   //     }


       if not BoundActive(tbWithAVA)
          AddBounds(tbWithAVA);

       if RecordExists NormSFO <>tsok then
          { message('Нет норм выдачи спецодежды, соответствующих фильтру!',Information);abort;Exit;}
      };





}
end;
end.
