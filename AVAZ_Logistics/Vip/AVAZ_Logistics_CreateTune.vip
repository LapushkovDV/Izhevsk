
#include CreateTune.vih

//------------------------------------------------------------------------------
Handler with replace GP_CreateTune_SQlRep on extensionPoint epCreateTuneComponent (TR: ObjCreateTuneEx) [219]
  // Внимание, приоритеты вызова обработчиков см. в CreateTune.vih
Action
{
  Result := true;
///--------------------------
  TR.SetComponent('GP');
  // ------------------------------------------------------------------------
  TR.SetParent('Tune');
  TR.AddPartA('AVTOVAZ','АвтоВАЗ','');
  //----------------------------------------------------------------------------
  TR.SetParent('AVTOVAZ');
    TR.AddTuneS('AVTOVAZ.TARNMESTA_PARTY', 'Партия-заглушка для учета тарных мест' , ftCompString,0,'','');
      TR.AddIntr('GET_TARNMESTA_PARTY');
    TR.AddTuneS('AVTOVAZ.TARNMESTA_CU'   , 'ЦУ для учета тарных мест' , ftCompString,0,'','');
     TR.AddIntr('GET_TARNMESTA_CU');

///--------------------------

  TR.SetComponent('GP');

  TR.SetParent('AVTOVAZ');
   TR.AddPartA('AVAZ_SFO','СФО','');


  TR.SetParent('AVAZ_SFO');
   TR.AddTuneS('AVTOVAZ.AVAZ_SFO.DPBU',    'Учитывать должность, подразделение, бригаду и участок при выборе норм в ЛК', ftBoolean, '0', '', 'NastrProizvUMPRefresh');


  TR.SetParent('AVTOVAZ');
       TR.AddTuneS('AVTOVAZ.BRAK_CU'   , 'ЦУ для учета брака' , ftCompString,0,'','');
     TR.AddIntr('GET_TARNMESTA_CU');
}
//------------------------------------------------------------------------------
