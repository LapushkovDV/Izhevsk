
#define OBJINT_ALGORITM
#include objintpl.vin
#include NalTunes.vih
#include PlPor.vih
#include oEdIzm.vih
#include MTRFuncs.vih
#include modifOrd.vih

#component "M_MnPlan"
VipInterface Algoritm_6117 implements oAlgoritm_Sys;
Interface Algoritm_6117;
show(5,1,160,30);


#include ExtAttr.var
#include oEdIzm.var
#include MTRFuncs.var
//#include SklOrder.var
#include modifOrd.var

table struct tmpord
(
 crec:comp
)
with index
(
 tmpord01 = crec
)
;

var
     cWorkFormPl,pNrec:comp;
     wEvnCode: Word;
     sEvnLine: String;
     tError : word;


create view



as select
  *
from
    FormPl,tmpord ,sklorder,SOPRORDB,spsopr
 where ((
           cWorkFormPl         == FormPl.NRec
            ))
 ;


exception ExUser1, ExUser2;

Function GetNum : word;
{
  GetNum := 6117;
}

function GetName : string;
{
  GetName := 'Алгоритм замены партий и ЦУ в приходном ордере';
}

Function GetMemo ( st:oSteckCommonString ) : Boolean;
{
  GetMemo := True;

  st.push('Алгоритм замены партий и ЦУ в приходном ордере');
}

Function GetNameInter : String;
{
  GetNameInter := 'Algoritm_6117' ;
}

Function GetNameInterPr : String;
{
  GetNameInterPr := 'AlgoritmSetup_6117' ;
}

function itsTaraM(cc:comp):boolean;
{
  Result:= word(sGetAttr(coKatMc,cc,VA_TARAM))>0;
}


function CheckORDB(typeDoc : word): boolean;
var _Koef:double;
     _tc:comp;
{
  result := true;
//  typeDoc =2101;
  delete all tmpord;
 _loop sklorder where ((pNrec == sklorder.csopr))
 _loop sporder where ((sklorder.nrec == sporder.CSKLORDER))
 {
  if not itsTaraM(sporder.cmc) then continue;
  if getfirst SpSopr where ((sporder.cspsopr == SpSopr.nrec))=tsok then
  {
    _Koef :=fEdIzm.GetKoefOtpEdT(SpSopr.NRec, SpSopr.cOtpEd, coSpSopr);
    if _Koef=0 then _koef:=1;
     _loop SOPRORDB where ((spsopr.nrec == SOPRORDB.CSPSOPR))
    {
     if getfirst tmpord where ((  SOPRORDB.nrec == tmpord.crec ))=tsok then continue;
     if Round(sporder.kol,5) = Round (_Koef*SOPRORDB.kol,5) then
      {     // копирование


             _tc := coGetAttr(coSoprOrdB,SoprOrdB.nrec,VA_KATPAR);
             if _tc<>0 then
                {
                 set sporder.cparty:=_tc;
                 update current sporder;
                }

             oMTRFun.CopySpecMTR(coSOPRORDB, SOPRORDB.nrec, coSpOrder, SpOrder.nRec);
             oModifOrds.AnySpOrder_UpDate(TypeSpOrder(SpOrder.buffer));
             ClearBuffer(#tmpord);
             set tmpord.crec:= SOPRORDB.nrec;
             Insert current tmpord;
             break;
      }
    }
  }
 }
}


Function InitInter( Var pt:TRecAcc ) : Boolean;
{
  InitInter := False;

_try
{
 pt.Visua    := Word(0);
 pt.MessEnd  := Word(0);

  cWorkFormPl := pt.cFormPl;
  if (GetFirst FormPl <> tsOk)
  {
   wEvnCode := 1;
   sEvnLine := 'Пользовательский алгоритм не найден (скорее всего, он был удален)';
   _raise ExUser2;
  }

 InitInter := True;
}  //'_try

_except
 on ExUser1:
  pt.Error := 1;

 on ExUser2:
 {
  Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally
{
 //'
}
}




//=======================================================================
Function RunInter( wflag:Word; Var pt:TRecAcc ) : Boolean;
{
  #__UNUSED__(wflag)

  pNrec:=pt.cpNrec;
  if pt.TypeCpNrec=0 or pt.TypeCpNrec=toPlanSnab then pNrec:=pt.cMnplan;
  if (not CheckORDB(pt.TypeCpNrec))
   {
    RunInter := False;
    pt.Binding := 8; // запрет
    pt.Error   := 1; // запрос
   }
  else
    RunInter := True;

}  //'_try

 HandleEvent
   CmValue1 : {
              }
 end;
end.
