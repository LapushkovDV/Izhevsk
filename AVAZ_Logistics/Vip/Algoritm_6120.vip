
#define OBJINT_ALGORITM
#include objintpl.vin
#include NalTunes.vih
#include PlPor.vih
#include oEdIzm.vih
#include MTRFuncs.vih
#include modifOrd.vih
#include CopySoprDoc.vih
#include SDfuns.vih
#include KatSoprFunc.Vih
#include make_mbp.vih

#include MakeOrder.vih
#include CreateOrder.vih

#component "M_MNPLAN"
VipInterface Algoritm_6120 implements oAlgoritm_Sys;
Interface Algoritm_6120;
show(5,1,160,30);


#include ExtAttr.var
#include oEdIzm.var
#include MTRFuncs.var
//#include SklOrder.var
#include modifOrd.var
#include CopySoprDoc.var
#include SDfuns.var
#include KatSoprFunc.Var
#include make_mbp.var
#include CreateOrder.var


var
     cWorkFormPl,pNrec:comp;
     wEvnCode: Word;
     sEvnLine: String;
     tError : word;


create view



as select
  *
from
    FormPl,spsopr,KatSopr,spsopr spsopr_select
 where ((
           cWorkFormPl         == FormPl.NRec

       ))
 ;


exception ExUser1, ExUser2;

form frm1wed     ('err2wed.OUT'  , 'ERRR'     ) with novisual;

var oMakeOrder: MakeOrder;

Function GetNum : word;
{
  GetNum := 6120;
}

function GetName : string;
{
  GetName := 'Алгоритм После удаления ордера удалить связанную накладную МЦ -> СФО,СТО';
}

Function GetMemo ( st:oSteckCommonString ) : Boolean;
{
  GetMemo := True;

  st.push('Алгоритм После удаления ордера удалить связанную накладную МЦ -> СФО,СТО');
}

Function GetNameInter : String;
{
  GetNameInter := 'Algoritm_6120' ;
}

Function GetNameInterPr : String;
{
  GetNameInterPr := 'AlgoritmSetup_6120' ;
}




function MakeAlg(typeDoc : word): boolean;

{
  result := true;

  _loop KatSopr where ((word(602) == KatSopr.vidsopr and pNrec == KatSopr.CORGPLAT))
  {
  if (oMakeOrder.DeleteOrders(KatSopr.nrec, false, True, True, 1, 128)) then
    {

      var pSaveRec : comp;
      pSaveRec := KatSopr.nRec;

      if (vMakeMBP.ChkDeleteOpers(pSaveRec))
        {
          vMakeMBP.DeleteOpers(pSaveRec);
        }

     _loop SpSopr where ((KatSopr.nrec == spsopr.csopr))
     {
       if getfirst spsopr_select where ((spsopr.nrec == spsopr_select.nrec))=tsok then  if oSDfuns.SpSopr_Delete(spsopr_select.nrec)<>tsok then result := false;
     }

     if ( RecordExists SpSopr where (( KatSopr.nrec == SpSopr.cSopr )) <> tsOk )
     {
       oSDfuns.DeleteSoprHoz(KatSopr.nRec, KatSopr.VidSopr);
       if oSDfuns.KatSopr_delete(KatSopr.nRec)<>tsok then result := false;
     }

    } else result := false;
  }
  oModifOrds.ClearSemaphoreSklad('KatSopr_DeleteOrders', pNrec);

}


Function InitInter( Var pt:TRecAcc ) : Boolean;
{
  InitInter := False;

_try
{
 pt.Visua    := Word(0);
 pt.MessEnd  := Word(0);

  cWorkFormPl := pt.cFormPl;
  if (GetFirst FormPl <> tsOk)
  {
   wEvnCode := 1;
   sEvnLine := 'Пользовательский алгоритм не найден (скорее всего, он был удален)';
   _raise ExUser2;
  }

 InitInter := True;
}  //'_try

_except
 on ExUser1:
  pt.Error := 1;

 on ExUser2:
 {
  Message(''#3 + String(wEvnCode) + ' ' + sEvnLine, Error);
 }

_finally
{
 //'
}
}




//=======================================================================
Function RunInter( wflag:Word; Var pt:TRecAcc ) : Boolean;
{
  #__UNUSED__(wflag)

  pNrec:=pt.cpNrec;
 // if pt.TypeCpNrec=0 or pt.TypeCpNrec=toPlanSnab then pNrec:=pt.cMnplan;
  if (not MakeAlg(pt.TypeCpNrec))
   {
    Message('Возникли проблемы с отменой проведения накладной МЦ-Спецоснастка');
    RunInter := False;
    pt.Binding := 8; // запрет
    pt.Error   := 1; // запрос
   }
  else
  {
     pt.Error = 0;
     RunInter := True;
  }

}  //'_try


end.
