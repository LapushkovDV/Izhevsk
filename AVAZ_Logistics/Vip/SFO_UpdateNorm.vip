#include AttrTablePick.vih
#include ExtAttr.vih
#include KauReff.vih
#Include Getkau.vih
#include KatSopr.vih
#Include oEdIzm.vih
#include PersNrCt.vih
#Include GrafFunc.vih
#Doc
  Алгоритм закрытия нормы после перевода сотрудника</Brief>
#End


Interface SFO_UpdateNorm 'Алгоритм закрытия нормы после перевода сотрудника', escClose, gray;

#include PersNrCt.var
Create view
var
  cPC,cAttr_Uch,cAttr_Brig:comp;
  d1,d2:date;
  _cPost,_cPodr,_wSex,_cUch,_cBrig:comp;
as select PersCard.*
from  PersCard
     ,PersNorm
     ,PERSSPEC
     ,persons
where
 ((
   cPC == Perscard.nrec
   and
   PersCard.nRec == PersNorm.cPersCard and
   (
 //   (Word(1) = PersNorm.specFlag) and
    (Word(0) = PersNorm.indFlag)  and
    (Word(1) = PersNorm.Status)
   )
   and
   PersCard.nrec == PERSSPEC.cPersCard
   and
   PersNorm.nrec == PERSSPEC.cpersnorm
 ));

Parameters cPC,D1,D2;

HandleEvent
cmInit:
 {
   cAttr_Uch:=ExtAttr_ID ( coPersCard,VA_SO_UCH);
   cAttr_Brig:=ExtAttr_ID ( coPersCard,VA_SO_BRIG);

   if (getfirst Perscard<>tsok)
   {
     CloseInterface(cmCancel);
     Exit;
   }

   _loop PersNorm
   {
    _loop PERSSPEC
    {
     set PERSSPEC.STATUS         := word(0);
     set PERSSPEC.EMPTCLOSED     := word(1);
     set PERSSPEC.TODATE         := D1;
     update current PERSSPEC;
    }
    set PersNorm.STATUS         := word(0);
    set PersNorm.TODATE         := D1;
    update current PersNorm
   }

    _cPost:=_cPodr:=_wSex:=_cUch:=_cBrig:=0;
    _cPost := PersCard.cPost;
    _cPodr := PersCard.cPodr;
    if getfirst Persons where ((PersCard.cPersons == Persons.nRec))=tsok
     {
      _wSex:=if ( Persons.sex = 'Ж', 2, if ( Persons.sex = 'М', 1, 0));
     }
    _cUch := coGetAttrID ( coPersCard, PersCard.nrec, cAttr_Uch );
    _cBrig:= coGetAttrID ( coPersCard, PersCard.nrec, cAttr_Brig ) ;
/*
    message('_cPodr='+to_char(_cPodr,0)+
            '_cPost='+to_char(_cPost,0)+
            '_wSex='+comp(_wSex)+
            '_cUch='+to_char(_cUch,0)+
            '_cBrig='+to_char(_cBrig,0)+'     cgKatKod_NormSFO='+word(cgKatKod_NormSFO));
*/
    _LOOP KatKod where (( cgKatKod_NormSFO == KatKod.wType and
                          _cPost == KatKod.cOrg1 and
                          _cPodr == KatKod.cOrg2 and
                          _wSex  == KatKod.cOrg3


                          ))
    {
     if _cUch<>0 then if _cUch  <> KatKod.cOrg4 then continue;
     if _cBrig<>0 then if _cBrig <> KatKod.cOrg5 then continue;

    ClearBuffer(#PersNorm);
    set PersNorm.cPersCard := PersCard.nRec;
    set PersNorm.cNormSFO  := KatKod.cGroup;
    set PersNorm.cPodr     := PersCard.cPodr;
    set PersNorm.cPost     := PersCard.cPost;
    set PersNorm.cMol      := PersCard.cMol;
    set PersNorm.frDate    := if (To_Days(D2) = 0, Cur_Date, D2);
    set PersNorm.Status    := Word(1);
    set PersNorm.specFlag  := KatKod.cWord1;
    set PersNorm.osnFlag   := KatKod.cWord2;
    set PersNorm.indFlag   := KatKod.cWord3;

    if (Insert Current PersNorm = tsOk)
    {
      update current PersCard set PersCard.chDate := Cur_Date;
    }

    iPersNorm.CountPersNorm(PersNorm.nrec, True);
    }
 }
end; // HandleEvent
End. // Interface

//******************************************************************************
