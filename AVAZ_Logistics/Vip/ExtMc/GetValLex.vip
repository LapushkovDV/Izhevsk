#component ""
Interface GetValLex DoAccept;

  Create view
    var curcode : s20;
        ret_nrec : comp;
  from
    GP_LexiQue
  where
  ((
     curcode == GP_LexiQue.Group_Code
  ))
  ;

Parameters curcode,ret_nrec;

  Browse BrwLexVal;
  table GP_LexiQue;
  fields
   GP_LexiQue.CRIT_FULL_NAME 'CRIT_FULL_NAME' : [50],protect;
   GP_LexiQue.CRIT_FULL_NAME_RUS 'CRIT_FULL_NAME_RUS'  : [50],protect;
  end;

  HandleEvent
    CmDefault:
    {
      ret_nrec:=GP_LexiQue.nrec;
    }
  end;
end.