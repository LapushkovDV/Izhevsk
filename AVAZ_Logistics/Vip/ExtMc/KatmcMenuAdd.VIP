#include MenuDynamic.vih

handler with replace AVAZ_MenuDynamic_AddItems_Katmc1 on ExtensionPoint AVAZ_MenuDynamic_AddItems
action
{
  result:=true;

  var MenuID:longint=0;
  _try 
  {
    MenuID:=LoadMenuEx('C_Common::AllMC',false,true);
    AddMenuItem(MenuID,'separator',0);

    if(not ConcatMenu(MenuId, LoadMenu('Li_Katmc_AddNastr1', false)))
      Message('ошибка добавления AVAZ_REALTING_MenuOper');
    if (not StoreMenuHowDynamics(MenuID,'C_Common::AllMC'))
      _raise ExAddMenuItemError;
  }
  _except
    on ExVip:
    {
      message('Ошибка регистрации меню Управление недвижимостью "Функция переноса площадей"'#13+
              ExploreException,error);
    }
  _finally 
    {
      if (MenuID<>0) DisposeLoadMenu(MenuID);  
    }
}

handler with replace AVAZ_MenuDynamic_DelItems_Katmc1 on ExtensionPoint AVAZ_MenuDynamic_DelItems
action
{
  result:=true;
  DeleteMenuHowDynamics('C_Common::AllMC');
}

Li_Katmc_AddNastr1 Menu
{
  - 'Настройка дополнительных полей к ТМЦ', cmRunInterface('vGetExt_Katmc(0,0)'),,;
}