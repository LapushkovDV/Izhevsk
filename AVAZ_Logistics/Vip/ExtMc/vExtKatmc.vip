#include Getkau.vih 
#include Protector.vih
#include Marker.vih

#component ""
Interface vGetExt_Katmc;

  var InfoProtector   : IProtector;
  var pMarker: IMarker(Marker) new;

  Create view
    var
      IsInEditMode : boolean;
      new_ankod, CloseCommand,wRun : word;
      new_an,new_ankodS: s20;
      cGrMc,curGroup : comp;
      mFltGroupMc : tPtr;

  as select
    Case(KatMc_Ext.NppType;
            ftString  :   'Строка',
            ftDouble  :   'Число',
            ftDate    :   'Дата',
            ftLongint :  'Целочисленное',
            ftComp    :  'Ссылка',
            ftBoolean :  'Признак';
            '') (fieldname=TipPole)
    ,if(KatMc_Ext.AllPole=True,'Общий','Групповой') (fieldname=PrznVis)
    ,if(KatMc_Ext.Isvisible=0,'-','V') (fieldname=VisField)
 
  from
    KatMc_Ext,
    KatMc_Ext KatMc_Ext1,
    KatMc_ExtGr

  Bounds BGr   =   false == KatMc_Ext.AllPole (noindex)
  Bounds BMain = curgroup     == KatMc_ExtGr.cRec
             and KatMc_Ext.nrec == KatMc_ExtGr.cPole                 
  ;

  parameters wRun,cGrMc;

  Procedure SetEditMode(Value: boolean);
  {
    InfoProtector.SetProtected(not Value);
    IsInEditMode := Value;
    ReScanPanel(#KatMc_Ext);
  }

  Function CheckNpp(_npp: word): Boolean;
  {
    Result:=true;
    if (getfirst KatMc_Ext1 where (KatMc_Ext1.NppPole = _npp))=tsok
      Result:=false;
  }

  Function GetIndxType(_type : word): word;
   var valindx: word=0;
  {
    Result:=0;   
    _loop KatMc_Ext1 where ( _type = KatMc_Ext1.NppType)
    {
      if valindx<KatMc_Ext1.IndxType
        valindx:=KatMc_Ext1.IndxType;
    }
    valindx++;
    Result:=valindx;
  }

  Window WinAn;
  Screen ScrNewRec;
    fields
      new_ankodS   : noprotect,PickButton;
   buttons
     cmValue1,,,'',,;
<<

  `Каталог аналитики`.@@@@@@@@@@@@@@@@@@@@@@@@@@@


   <. Ок .>
>>
  end;

  HandleEvent
    CmInit :
    { 
      CloseCommand:=CmCancel;
    }

    CmValue1:
    {
      CloseCommand:=CmValue1;
      CloseWindow(WinAn);
    }

    CmPick:
    {
        if (Boolean(KatMc_Ext.przlex))
        {
          Message('Для VSD составляющей задайте код группы критерия вручную');
          exit;         
        }

!        if (not new_przlex)
!        {
          if (RunInterface('GetKauTable', cgiPick, 0, new_ankod, 0) <> cmCancel)
          {
            new_an:=GetAnalitikName(new_ankod);
            new_ankodS:=string(new_ankod)
          }
!        }
        ReScanPanel(curtable);
    }
  end;
 end;


  Browse BrwNastrGr (,,sci1EnEscInsPM);;
  table KatMc_Ext;
   recMarker = pMarker{KatMc_Ext.nrec};
  fields
    KatMc_Ext.NamePole 'Имя поля' : [50],protect,noPickButton;
    TipPole  'Тип данных'  : [15],protect;
    [ValAn1] 
       if(KatMc_Ext.przlex=false,GetAnalitikName(word(KatMc_Ext.kodan)),KatMc_Ext.kodan) 'Каталог аналитики':[20],Protect;  
  end;


  Browse BrwTuneExt_MC;
   table KatMc_Ext;
//    recMarker = pMarker{tTuneExt.indx};
   fields
    KatMc_Ext.NamePole 'Имя поля' : [50],noprotect,noPickButton;
    TipPole  'Тип данных'  : [15],protect;
    KatMc_Ext.NppPole '#п/п'    : [6],noprotect;
    PrznVis   'Признак данных' : [15],protect,pickbutton;
//    tTuneExt.npp 'Номер п/п' : [5],protect;
    [PrzSvd] if(KatMc_Ext.przlex,'V','-') 'VSD' :[5],protect;
    VisField 'Видно', 'по умолч.'  : [7],protect;
    [ValAn] 
       if(KatMc_Ext.przlex=false,GetAnalitikName(word(KatMc_Ext.kodan)),KatMc_Ext.kodan) 'Каталог аналитики':[20],Protect;  
  end;

  TableEvent table KatMc_Ext;
    CmSetDefault:
    {     
    }

    CmUpdateRecord:
    {
      if (Update current KatMc_Ext)=tsok
      {
      }
    }
    CmDeleteRecord:
    {
      if delete current KatMc_Ext=tsok
      {
      }
    }
    CmPositionChanged:
    {
      if KatMc_Ext.NppType<>FtComp
        SetFieldOption(#ValAn,ofProtected)
      else
        ClearFieldOption(#ValAn,ofProtected);
    }
/*    cmExprFieldChanged:
    {
      case CurField of
      #nPole:{
               if not (isvalidall(tnKatMc_ExtGr))
               {
                stop;
                exit;
               }

               Var tmpVal  : String = ExprFieldValue;
               KatMc_ExtGr.NppPole:=Double(tmpVal);
               Update current KatMc_ExtGr;
               set nPole;
             }
      end;
    }
*/
    CmCheckRecord:
    {
      if GetCurrentFormat=BrwTuneExt_MC
      {
       if KatMc_Ext.NppPole<>0
        if (not CheckNpp(KatMc_Ext.NppPole))
        {
          Message('Уже есть поле с номером ='+KatMc_Ext.NppPole,Error);
          abort;
        }

       if KatMc_Ext.IndxType=0
       {
          Message('Укажите тип данных у поля !',Error);
          abort;
       }
//         KatMc_Ext.IndxType:=GetIndxType(KatMc_Ext.NppType);
      }
    }

    CmInsertRecord:
    {
      Insert Current KatMc_Ext;
    }
  end;

  HandleEvent

    CmInit:
    {
     
      if cGrMc>0
      {
        curgroup:=cGrMc;
        pMarker.UnselectAll;
        PushBounds(tbbGr);
        AddBounds(tbbmain);
        mFltGroupMc := InitMarker('', 8, 1, 1);
        ResetBounds(tnKatMc_Ext);
         _loop KatMc_Ext
        {
          if getfirst KatMc_ExtGr=tsok
            InsertMarker(mFltGroupMc,KatMc_ExtGr.cPole);
        }  
        pMarker.ImportFrom(mFltGroupMc);
        setBounds(tnKatMc_Ext);
//        SelectPanel(#);
        ClearMarker(mFltGroupMc);
        DoneMarker(mFltGroupMc,'');
        SetFormat(BrwNastrGr);
        SetTitle('Задайте поля для текущей группы (пометка Insert)');
      }
      else
      {
        if cfsSetCurrentContainer(cfsGetCurrentContainerSelf)<>0
            Message('Текущий контейнер интерфейса не установлен',Error);

        LoadVipRef(InfoProtector,'Protector');
        InfoProtector.LinkTo(cfsGetCurrentContainerSelf,'BrwTuneExt_MC');
        InfoProtector.SetProtectedStatusCtx(sci14EnEsc);
        SetEditMode(false);
        SetFormat(BrwTuneExt_MC);
      }
    }


    cmDoMarkUnMark:
    {
     var answer_ : word;

     if isvalid(#pMarker)
       answer_:=Message('Выполним отвязку поля '''+KatMc_Ext.NamePole+''' ?',YesNo+Confirmation);
     else
       answer_:=Message('Выполним привязку поля '''+KatMc_Ext.NamePole+''' ?',YesNo+Confirmation);

//      Message('cmDoMarkUnMark');
      if answer_<>CmYes
      {
        stop;
        exit;
      }

      if getfirst KatMc_ExtGr<>tsok
      {
        Insert KatMc_ExtGr set KatMc_ExtGr.crec:=curgroup,KatMc_ExtGr.cPole:=KatMc_Ext.nrec;//ж,KatMc_ExtGr.NppPole:=pMarker.Count+1;;
      }
      else
      {
//          Message('delete');
//          pMarker.UnMark;
         delete safe KatMc_ExtGr;
//          PutCommand(CmValue5);
      }
       RescanPanel(curtable);
    }     


    CmInsert:
    {
      if Message('Добавим новую запись ?',YesNo+Confirmation)<>CmYes
         exit;
    }

    CmEdit :
    {
      case getcurrentformat of
        BrwTuneExt_MC : { SetEditMode(true);/* cfssetprop('KATEGZADDKZ','Palette',integer(wpGrayWindow)); SelectFormat(ScrEdit); */}
      end;
    }

    cmCancel:
    {
      case getcurrentformat of
        BrwTuneExt_MC : 
        {
          if IsInEditMode
          {
            abort;
            SetEditMode(false);
//                                       cfssetprop('WinRepl','Palette',integer(wpBlueWindow));
            SelectFormat(BrwTuneExt_MC);
            RescanPanel(curtable);
          }
        }
      end;
    }

    CmPick:
    {
     Case curfield of
     #ValAn:
     {
       RunWindowModal(WinAn);
       if CloseCommand<>CmValue1
         exit
       else
       {
         KatMc_Ext.kodan:=string(new_ankodS);
         SetModified(True);
       }      
         ReScanPanel(curtable);
     }
     #TipPole:
     {
       var newt : longint;
       if RunDialog(TypdataLi,newt)=CmOk
       {
        set KatMc_Ext.NppType:=Case(newt;
                                 0 : ftString,
                                 1 : ftDouble,
                                 2 : ftDate,
                                 3 : ftComp,
                                 4 : ftLongint,
                                 5 : ftBoolean
                                );
        set KatMc_Ext.IndxType:=GetIndxType(KatMc_Ext.NppType);
        SetModified(True);
//        UpdateTable;
       }
       set TipPole;
     }
     #PrznVis:
     {
       if PrznVis='Общий'
         KatMc_Ext.AllPole:=False
       else
         KatMc_Ext.AllPole:=True;
       SetModified(True);
       set PrznVis;
//       ReScanPanel(curtable);
     }
     #PrzSvd:
     {
       KatMc_Ext.przlex:=(not KatMc_Ext.przlex);
       SetModified(True);
       set PrzSvd;
     }
     #VisField:
     {
       Katmc_Ext.isVisible:=(Katmc_Ext.isVisible xor 1);
       set VisField;
     }
     end;
    }

   CmDefault:
   {
     if GetCurrentformat=BrwNastrGr
       CloseInterface(cmDefault);
   }
  end;
end.

TypdataLi DIALOG
ORIGIN 3,9
Fields
  tip   ('',, scGalDial)
        : longint;

Buttons
  cmOk,Default,, 'Ввод',  , scGalDial;
  cmCancel,,,    'Отмена', , scGalDial;
<< 'Выберите значение'

    (.) Строковой`
    (.) Числовой`
    (.) Дата`
    (.) Ссылка на аналитику`
    (.) Целочисленный`
    (.) Признак`

   <.~П~родолжить.>  <. ~О~тмена .>
>>
