#component ""

Interface vGetExt_Katmc_Edit;

#include GetKau.var

 Function GetVal( _num,_type: word; prz: boolean) : String; Forward;

  Create view
    var
      new_ankod, CloseCommand,wRun : word;
      new_an: s20;
      cGrMc,curGroup,cmc,curmc : comp;
      mFltGroupMc : tPtr;
     _vlong : longint;
     _vString : string;
     _vNum : double;
     _vDate : date; 
     _vcomp : comp;
     _vbool : boolean;
     _vcompstr : string;

  as select
    Case(KatMc_Ext.NppType;
            ftString  :   'Строка',
            ftDouble  :   'Число',
            ftDate    :   'Дата',
            ftLongint :  'Целочисленное',
            ftComp    :  'Ссылка',
            ftBoolean :  'Признак';
            '') (fieldname=TipPole)
    ,if(KatMc_Ext.AllPole=True,'Общий','Групповой') (fieldname=PrznVis)
    ,GetVal(KatMc_Ext.indxtype,KatMc_Ext.NppType,KatMc_Ext.PrzLex) (fieldname=fVal)
 
  from
    KatMc_Ext,
    KatMc_Ext KatMc_Ext1,
    KatMc_ExtGr,
    KatMc_DblVal,
    KatMc_DatVal,
    KatMc_LongVal,
    KatMc_BoolVal,
    KatMc_CompVal,
    KatMc_StrVal,
    Gp_LEXIQUE LexiQue
  where 
  ((
          curgroup     == KatMc_ExtGr.cRec
    and KatMc_Ext.nrec == KatMc_ExtGr.cPole
//     and ( (isvalidall(tnKatMc_ExtGr)=true ) or (KatMc_Ext.AllPole=true))
    and curmc == KatMc_StrVal.crec
    and curmc == KatMc_CompVal.crec
    and curmc == KatMc_DblVal.crec
    and curmc == KatMc_DatVal.crec
    and curmc == KatMc_LongVal.crec
    and curmc == KatMc_BoolVal.crec
  ))
  and ( (isvalidall(tnKatMc_ExtGr)=true ) or (KatMc_Ext.AllPole=true))
//    Bounds BGr   =   false == KatMc_Ext.AllPole (noindex)
  ;

  parameters cGrMc,Cmc;


  Function GetVal( _num,_type: word; prz: boolean) : String;
  {
//    yesrecord:=false;
    Result:='';   

//    yesrecord:=true;

    Case _type of
      FtString :{
                  if getfirst KatMc_StrVal=tsok
                     Result:=KatMc_StrVal.val[_num];
                }
      FtComp   : {
                   if (not prz)
                     Result:=ShowKau(word(KatMc_Ext.kodan),KatMc_Compval.val[_num])
                   else
                     if getfirst LexiQue where ((KatMc_Compval.val[_num] == LexiQue.nrec))=tsok
                       Result:=LexiQue.CRIT_FULL_NAME_RUS;
                 }
      FtDouble : {
                   if getfirst KatMc_DblVal=tsok
                     Result:=if(KatMc_DblVal.val[_num] < 0
                         , DoubleToStr(KatMc_DblVal.val[_num], '36666666666666667.89999999')
                         , DoubleToStr(KatMc_DblVal.val[_num], '66666666666666667.89999999')
                        )
                 }
      ftLongint: {
                   if getfirst KatMc_LongVal=tsok
                     Result:=String(KatMc_LongVal.val[_num]);
                 }
      ftDate   : {
                   if getfirst KatMc_DatVal=tsok
                     Result:=if(KatMc_DatVal.val[_num]=to_date(0,0,0),'',DateToStr(KatMc_DatVal.val[_num],'DD/MM/YYYY'));
                 }
      ftBoolean :{

                   Result:=if(KatMc_BoolVal.val[_num]=True,'Да','Нет');
                 }
    end;
  }


Window ValueInputWindow 'Редактирование значения' EscClose;
  Show at (, , 62, 5);

Screen BooleanInputScreen (, , sci1Esc);
//  Table AttrVal;

Fields
  _vbool ('Установка признака' , ,) : NoProtect;
Buttons
  cmOk, Default;
  cmCancel;
<<

     (.)  нет`
     (.)  да`

 <.~У~становить.>                               <.  Отмена  .>
>>
  end;

