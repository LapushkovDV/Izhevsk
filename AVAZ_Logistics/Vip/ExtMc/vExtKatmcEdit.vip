  Procedure UpdateRecord_Value(_idscr : longint);
  {
//    if not isvalid(#Valmc)
!    if getfirst Valmc<>tsok
!    {
!      Insert Valmc set Valmc.crec:=curmc;
!      MakeValid(#Valmc)
!    }

    Case _idscr of
      StringInputScreen :
        {
          if getfirst KatMc_StrVal<>tsok
          {
             Insert KatMc_StrVal set KatMc_StrVal.crec:=curmc;
             MakeValid(#KatMc_StrVal)
          }

          Update current KatMc_StrVal set KatMc_StrVal.val[KatMc_Ext.indxtype]:=_vString;
        }
      LongIntInputScreen :
        {
          if getfirst KatMc_LongVal<>tsok
          {
             Insert KatMc_LongVal set KatMc_LongVal.crec:=curmc;
             MakeValid(#KatMc_LongVal)
          }

          Update current KatMc_LongVal set KatMc_LongVal.val[KatMc_Ext.indxtype]:=_vlong;
        }
      DoubleInputScreen :
        {
          if getfirst KatMc_DblVal<>tsok
          {
             Insert KatMc_DblVal set KatMc_DblVal.crec:=curmc;
             MakeValid(#KatMc_DblVal)
          }

          Update current KatMc_DblVal set KatMc_DblVal.val[KatMc_Ext.indxtype]:=_vnum;
        }
      DateInputScreen :
        {
          if getfirst KatMc_DatVal<>tsok
          {
             Insert KatMc_DatVal set KatMc_DatVal.crec:=curmc;
             MakeValid(#KatMc_DatVal)
          }

          Update current KatMc_DatVal set KatMc_DatVal.val[KatMc_Ext.indxtype]:=_vdate;
        }
      CompInputScreen :
        {
          if getfirst KatMc_CompVal<>tsok
          {
             Insert KatMc_CompVal set KatMc_CompVal.crec:=curmc;
             MakeValid(#KatMc_CompVal)
          }

          Update current KatMc_CompVal set KatMc_CompVal.val[KatMc_Ext.indxtype]:=_vcomp;
//           _vcompstr:=ShowKau(tTuneExt.kodan,valmc.ckau[_num])
//          set fVal;
        }
      BooleanInputScreen :
        {
          if getfirst KatMc_BoolVal<>tsok
          {
             Insert KatMc_BoolVal set KatMc_BoolVal.crec:=curmc;
             MakeValid(#KatMc_BoolVal)
          }

          Update current KatMc_BoolVal set KatMc_BoolVal.val[KatMc_Ext.indxtype]:=_vbool;
        }
    end;
    set fVal;
  }

  HandleEvent 
    CmInit:
    {
      Case Katmc_Ext.npptype of
       FtString:
       {
         _vString:='';
         if isvalidall(tnKatMc_StrVal)
          _vString:=KatMc_StrVal.val[KatMc_Ext.indxtype];
         SetFormat(StringInputScreen);
       }
       FtLongint:
       {
         _vLong:=0;
         if isvalidall(tnKatmc_LongVal)
          _vlong:=Katmc_LongVal.val[KatMc_Ext.indxtype];
         SetFormat(LongIntInputScreen);
       }
       FtDouble:
       {
         _vnum:=0;
         if isvalidall(tnKatmc_DblVal) 
          _vnum:=Katmc_DblVal.val[KatMc_Ext.indxtype];
         SetFormat(DoubleInputScreen);
       }
       FtDate:
       {
         _vdate:=date(0,0,0);
         if isvalidall(tnKatmc_DatVal)
          _vdate:=Katmc_DatVal.val[KatMc_Ext.indxtype];
         SetFormat(DateInputScreen);
       }
       FtComp:
       {
         _vcomp:=0h;
         _vcompstr:='';
         if isvalidall(tnKatmc_CompVal)
          {
            _vcomp:=Katmc_CompVal.val[KatMc_Ext.indxtype];
            if (not KatMc_Ext.PrzLex)
             _vcompstr:=ShowKau(word(KatMc_Ext.kodan),Katmc_CompVal.val[KatMc_Ext.indxtype])
            else
             if getfirst LexiQue where ((Katmc_CompVal.val[KatMc_Ext.indxtype] == LexiQue.nrec))=tsok
               _vcompstr:=LexiQue.CRIT_FULL_NAME_RUS;
          }
         SetFormat(CompInputScreen);
       }
       FtBoolean:
       {
         _vbool:=false;
        if isvalidall(tnKatmc_BoolVal)
          _vbool:=Katmc_BoolVal.val[KatMc_Ext.indxtype];
         SetFormat(BooleanInputScreen);
       }
      end;
    }
    CmOk :
    {
      UpdateRecord_Value(GetCurrentformat);
      CloseWindow(ValueInputWindow);
    }
    CmPick:
    {
      case curfield of
        #_vcompstr:
        {
          var cKau : comp= 0;
          if (not KatMc_Ext.PrzLex)
          {
            if (iGetKau.GetCodeKau(cgiPick, word(KatMc_Ext.kodan), ckau) <> 0)
            {
              _vcomp:=ckau;
              set _vcompstr:=ShowKau(word(KatMc_Ext.kodan),_vcomp);
              ReDrawPanel(tnNotable);
            }
          }
          else
          {
            if RunInterface('GetValLex',KatMc_Ext.kodan,ckau)=CmDefault
             if getfirst GP_LexiQue where ((ckau == GP_LexiQue.nrec))=tsok
            {
              _vcomp:=ckau;
              set _vcompstr:=GP_LexiQue.CRIT_FULL_NAME_RUS;
              ReDrawPanel(tnNotable);
            }
          }
        }
      end;

    }
/*
    cmDelOnProtect:
    {
     Message('call cmDelOnProtect');

     Case GetCurrentformat of
       StringInputScreen :
       {
         if getfirst KatMc_StrVal=tsok
         Update current KatMc_StrVal set KatMc_StrVal.val[KatMc_Ext.indxtype]:='';          
       }
       LongIntInputScreen :
       {
         if getfirst KatMc_LongVal=tsok
           Update current KatMc_LongVal set KatMc_LongVal.val[KatMc_Ext.indxtype]:=0;
       }
     end;
     ReScanPanel(curtable);
    }
*/
  end;
end; // win



  Browse BrwTuneExt_MC;
   table KatMc_Ext;
//    recMarker = pMarker{tTuneExt.indx};
   fields
    KatMc_Ext.NamePole 'Имя поля' : [50],protect,noPickButton;
    TipPole  'Тип данных'  : [15],protect;
//    KatMc_Ext.NppPole '#п/п'    : [6],noprotect;
    PrznVis   'Признак данных' : [15],protect,pickbutton;
//    tTuneExt.npp 'Номер п/п' : [5],protect;
    [PrzSvd] if(KatMc_Ext.przlex,'V','-') 'VSD' :[5],protect;
    fVal 'Значение' : [40], Protect, PickButton;
  end;

  TableEvent table KatMc_Ext;

    CmUpdateRecord:
    {
    }
    CmDeleteRecord:
    {
    }
    CmPositionChanged:
    {
    }
/*    cmExprFieldChanged:
    {
      case CurField of
      #nPole:{
               if not (isvalidall(tnKatMc_ExtGr))
               {
                stop;
                exit;
               }

               Var tmpVal  : String = ExprFieldValue;
               KatMc_ExtGr.NppPole:=Double(tmpVal);
               Update current KatMc_ExtGr;
               set nPole;
             }
      end;
    }
*/
  end;

  HandleEvent

    CmInit:
    {
      curGroup :=cGrmc;
      curmc    :=cmc;
      SetTitle('Настройка дополнительных полей Автоваз');
      if (curmc<>0 or curGroup<>0)
      {
        cfsSetProp('c_BRWTUNEEXT_MC_TIPPOLE_Тип_данных','PickButton',false);
        cfsSetProp('c_BRWTUNEEXT_MC_TIPPOLE_Тип_данных','DefaultPickButton',false);
        cfsSetProp('c_BRWTUNEEXT_MC_PRZNVIS_Признак_данных','PickButton',false);
        cfsSetProp('c_BRWTUNEEXT_MC_PRZNVIS_Признак_данных','DefaultPickButton',false);
        cfsSetProp('c_BRWTUNEEXT_MC_PRZSVD_VSD','PickButton',false);
        cfsSetProp('c_BRWTUNEEXT_MC_PRZSVD_VSD','DefaultPickButton',false);
      }
    }

    CmPick:
    {
      if curfield=#fval
      {
        RunWindowmodal(ValueInputWindow);
           //Rereadrecord(curtable);
      }
    }
cmOpenSearch :
{

  if (CurField = #fVal)
  {
    Abort;
    RunWindowmodal(ValueInputWindow);   
  }
}

    cmDelOnProtect:
    {
//     Message('call cmDelOnProtect');
     Case GetCurrentformat of
       StringInputScreen :
       {
         if getfirst KatMc_StrVal=tsok
         Update current KatMc_StrVal set KatMc_StrVal.val[KatMc_Ext.indxtype]:='';          
       }
       LongIntInputScreen :
       {
         if getfirst KatMc_LongVal=tsok
           Update current KatMc_LongVal set KatMc_LongVal.val[KatMc_Ext.indxtype]:=0;
       }
       DateInputScreen :
       {
         if getfirst KatMc_DatVal=tsok
           Update current KatMc_DatVal set KatMc_DatVal.val[KatMc_Ext.indxtype]:=to_date(0,0,0);
       }
       CompInputScreen :
       {
         if getfirst KatMc_CompVal=tsok
           Update current KatMc_CompVal set KatMc_CompVal.val[KatMc_Ext.indxtype]:=0h;
         _vcomp:=0h;
         _vcompstr:='';
       }
     end;
     ReReadRecord(curtable);
    }

  end;
end.
