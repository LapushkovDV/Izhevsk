Table Struct MemToolBars
(
  ID         : longint
, WinID      : longint
, ScreenID   : longint
, Owner      : word // 0 - главное окно, 1 - EditSopr
, Name       : string[50]
)
with index
(
  MemToolBars01 = Owner + Name
);


