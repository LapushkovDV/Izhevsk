var arName : array[1] of string;
var arIndBd,arIndNpp,arType,arIndType,arVis : array[1] of word;

Create view vMemToolBars
as select
  MemToolBars.*
From
  MemToolBars;

var DatLabel : Date;
    PodrLabel : String;

Create view vPickPodr
as select
  *
From
 Pick
,KatPodr
where
((
  11 == Pick.wList
and Pick.crec == KatPodr.nrec
));


Procedure GetAddField;
{
  RunInterface('vGetExt_Katmc_Edit',Katmc.cGroupmc,Katmc.nrec); 
}


Procedure LoadAndShowToolBar(__Name: string[50]; __WinID: integer; __ScreenID: longint; __Owner: word);
{
   if (vMemToolBars.GetFirst MemToolBars where (( __Owner == MemToolBars.Owner And
                                    __Name  == MemToolBars.Name )) = tsOk)
    Exit;

   vMemToolBars.Insert into MemToolBars set
     MemToolBars.ID       := Longint(LoadToolBarEx(__Name))
   , MemToolBars.WinID    := __WinID
   , MemToolBars.ScreenId := __ScreenId
   , MemToolBars.Owner    := __Owner
   , MemToolBars.Name     := __Name
   ;

   ApplyToolBarEx(vMemToolBars.MemToolBars.ID, __WinID, __ScreenID, -1, TB_SHOW);
}

Window wnLabel 'Инвентаризационный ярлык' ('', hcNoContext, sci13Esc) doaccept, escclose;
  Show at(,,60,7);
Screen scLabel '' ('', hcNoContext, sci1Esc);
Fields
 DatLabel  : NoProtect;
 PodrLabel : Protect,PickButton;
Buttons
 cmOk;
 cmCancel;
<<

 `Дата`.@@@@@@@@@@@

 `Подразделение`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

        <. Сформировать .>     <.    Отмена    .>

>>
End;
HandleEvent
cmInit:
{
 set DatLabel:= Cur_Date;
 set PodrLabel:= '';
 vPickPodr.delete all Pick;
};

cmPick:
{
 case CurField of
  #PodrLabel  :
   {
    var npp: word; set npp:=0;

    if RunInterface('Z_KATPODR::GetSomeSklad')<>cmCancel then {
     vPickPodr._loop Pick
     {
      inc(npp);
     }
    if npp=1 then {
      if vPickPodr.getfirst fastfirstrow KatPodr=tsOk then
      set PodrLabel:=vPickPodr.KatPodr.Name;
     }
     else
     {
      set PodrLabel:='Выбрано ('+npp+ ')';
     }
    };
   };				//11
 end;
};

cmOk:
{
 if PodrLabel='' then
 {
  Message('Выберите подразделение!');
 }
 else
  PutCommand(cmDefault);
}
End;



End;

procedure Print_InvLabel;
{
  if RunWindowModal(wnLabel)=cmDefault then
  {
    var
      iL: iLabel;
    iL.Init;
    if (pMarker.Count > 0) // Помечено несколько записей
    {
      StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Печать Инвентаризационный ярлык', pMarker.Count);
      SubBounds(tbRMKatMC1);
      AddBounds(tbRMKatMC2);
      _LOOP pMarker
      {
        if not NextVisual then
          Break;
      vPickPodr._loop Pick
       {
        iL.AddMC(DatLabel, vPickPodr.Pick.cRec, KatMC.NRec, 0, 0, 0);
       }
      }

      SubBounds(tbRMKatMC2);
      AddBounds(tbRMKatMC1);

      pMarker.UnselectAll; // снять пометки

      StopVisual('', 0);
    }
    else
    {
      vPickPodr._loop Pick
       {
        iL.AddMC(DatLabel, vPickPodr.Pick.cRec, KatMC.NRec, 0, 0, 0);
       }
    }
    iL.Print;
  };
};

window wKatMC 'Редактирование матценности' EscClose;
HandleEvent
  CmValue68:
    GetAddField;

  cmValue50:
    Print_InvLabel;
end;
end;

HandleEvent
  CmInit:
  {
    Inherited:: HandleEvent(CmInit)
!     Message('Call CmOnvipLoad');
    LoadAndShowToolBar('L_MCU::tbExtMc_li', wnMainWindow, -1, 0);
    LoadAndShowToolBar('L_MCU::tbExtMc_li', WKATMC, -1, 1);

    st := cfsGetObjInfo(
    'brMC2', // Имя объекта, инфо о котором надо получить
    cur_o_Br, // строка с именем объекта
    aself_Br, // указатель объекта
    cont_i_Br, // имя группы, в которую вставлен объект
    aObjType_Br   // имя типа объекта
    );
//     Message('st='+string(st));
    if st = 0
    {
      var
        l, j, li2: word = 0;

!          if getfirst KatMc_Ext=tsok
!          {  
      CntStr := CntLong := CntDat := CntDbl := Cntan := CntBool := 0;
      Setlimit(arName, 0);
      Setlimit(arIndBd, 0);
      Setlimit(arIndNpp, 0);
      Setlimit(arType, 0);
      Setlimit(arIndType, 0);
      SetLimit(arVis, 0);

      _loop KatMc_Ext
      {
        if (Katmc_Ext.NppType) = 0
          break;
        l++;

        if Katmc_Ext.NppType = FtString
          CntStr++
        else
          if Katmc_Ext.NppType = FtDouble
            CntDbl++
          else
            if Katmc_Ext.NppType = FtLongint
              CntLong++
            else
              if Katmc_Ext.NppType = FtDate
                CntDat++
              else
                if Katmc_Ext.NppType = FtComp
                  Cntan++;
                else
                  if Katmc_Ext.NppType = FtBoolean
                    CntBool++;

        li := li + l;

        li2 := GetLimit(arName);
        arName[li2 + 1] := Katmc_Ext.NamePole;
        if (Katmc_Ext.PrzLex)
          arName[li2 + 1] := arName[li2 + 1] + chr(13) + '(состав SVD)';
        arIndBd[li2 + 1] := l;
        arIndNpp[li2 + 1] := Katmc_Ext.NppPole;
        arType[li2 + 1] := Katmc_Ext.NppType;
        arVis[li2 + 1] := Katmc_Ext.IsVisible;
        arIndType[li2 + 1] := Case(Katmc_Ext.NppType;
        FtString: CntStr,
        FtDouble: CntDbl,
        FtLongint: CntLong,
        FtDate: CntDat,
        FtComp: Cntan,
        FtBoolean: CntBool
        );
        if Count(arName) > 1
          for(j := Count(arName); j <> 0; j--)
          {
            if j < Count(arName)
            {
              if (arIndNpp[j] = 0 and arIndNpp_Prev = 0)
              {
              }
              else
                if arIndNpp_Prev > 0// не 0 ..
                {
                  if (arIndNpp_Prev < arIndNpp[j] or arIndNpp[j] = 0) //.. и больше пред элемента
                  { //надо менять местами
                    arName[j + 1] := arName[j];
                    arIndBd[j + 1] := arIndBd[j];
                    arIndNpp[j + 1] := arIndNpp[j];
                    arType[j + 1] := arType[j];
                    arIndType[j + 1] := arIndType[j];
                    arVis[j + 1] := arVis[j];

                    arName[j] := arName_Prev;
                    arIndBd[j] := arIndBd_Prev;
                    arIndNpp[j] := arIndNpp_Prev;
                    arType[j] := arType_Prev;
                    arIndType[j] := arIndType_Prev;
                    arVis[j] := arVis_Prev
      
                    arName_Prev := arName[j];
                    arIndBd_Prev := arIndBd[j];
                    arIndNpp_Prev := arIndNpp[j];
                    arType_Prev := arType[j];
                    arIndType_Prev := arIndType[j];
                    arVis_Prev := arVis[j];
                  }
                  else
                  {
                    break;
                  }
                }

            }
            else
              if (j = Count(arName))
              {
                arName_Prev := arName[j];
                arIndBd_Prev := arIndBd[j];
                arIndNpp_Prev := arIndNpp[j];
                arType_Prev := arType[j];
                arIndType_Prev := arIndType[j];
                arVis_Prev := arVis[j];
              }
          }
      }

//           logstrtofile('c:\debug\katmc_view.log','count arName='+Count(arName));

      for(j := 1; j <= Count(arName); j++)
      {
//              logstrtofile('c:\debug\katmc_view.log',j+';arName='+arName[j]+';arIndBd='+arIndBd[j]+';arIndNpp='+arIndNpp[j]+';arType='+arType[j]+';arIndType='+arIndType[j]);
!                if j=3
!                  break;
        Case arType[j] of
          FtString:
          {
            cfsCreateObject('Column', aself_Br, 'fstr' + string(arIndType[j]), False, aself2_Br);
            cfsSetProp(aself2_Br, 'Title', arName[j]);
            cfsSetProp(aself2_Br, 'Visible', arVis[j] > 0);
            cfsSetProp(aself2_Br, 'Protect', True);
            cfsSetProp(aself2_Br, 'Skip', False);
            cfsSetProp(aself2_Br, 'StatusCtx', 0);
            cfsSetProp(aself2_Br, 'NoAutoSize', True);
            cfsSetProp(aself2_Br, 'Defaultwidth', integer(20));
          }

          FtDouble:
          {
            cfsCreateObject('Column', aself_Br, 'fdbl' + string(arIndType[j]), False, aself2_Br);
            cfsSetProp(aself2_Br, 'Title', arName[j]);
            cfsSetProp(aself2_Br, 'Visible', arVis[j] > 0);
            cfsSetProp(aself2_Br, 'Protect', True);
            cfsSetProp(aself2_Br, 'Skip', False);
            cfsSetProp(aself2_Br, 'Points', 2);
            cfsSetProp(aself2_Br, 'PassiveFormat', '\2p[|-]36`666`666`666`666.88');
            cfsSetProp(aself2_Br, 'StatusCtx', 0);
            cfsSetProp(aself2_Br, 'Defaultwidth', integer(20));
          }

          FtLongint:
          {
            cfsCreateObject('Column', aself_Br, 'flong' + string(arIndType[j]), False, aself2_Br);
            cfsSetProp(aself2_Br, 'Title', arName[j]);
            cfsSetProp(aself2_Br, 'Visible', arVis[j] > 0);
            cfsSetProp(aself2_Br, 'Protect', True);
            cfsSetProp(aself2_Br, 'Skip', False);
            cfsSetProp(aself2_Br, 'StatusCtx', 0);
            cfsSetProp(aself2_Br, 'Defaultwidth', integer(20));
          }

          FtDate:
          {
            cfsCreateObject('Column', aself_Br, 'fdat' + string(arIndType[j]), False, aself2_Br);
            cfsSetProp(aself2_Br, 'Title', arName[j]);
            cfsSetProp(aself2_Br, 'Visible', arVis[j] > 0);
            cfsSetProp(aself2_Br, 'Protect', True);
            cfsSetProp(aself2_Br, 'Skip', False);
            cfsSetProp(aself2_Br, 'StatusCtx', 0);
            cfsSetProp(aself2_Br, 'Defaultwidth', integer(15));
          }

          FtComp:
          {
            cfsCreateObject('Column', aself_Br, 'fkau' + string(arIndType[j]), False, aself2_Br);
            cfsSetProp(aself2_Br, 'Title', arName[j]);
            cfsSetProp(aself2_Br, 'Visible', arVis[j] > 0);
            cfsSetProp(aself2_Br, 'Protect', True);
            cfsSetProp(aself2_Br, 'Skip', False);
            cfsSetProp(aself2_Br, 'StatusCtx', 0);
            cfsSetProp(aself2_Br, 'Defaultwidth', integer(20));
          }

          FtBoolean:
          {
            cfsCreateObject('Column', aself_Br, 'fbool' + string(arIndType[j]), False, aself2_Br);
            cfsSetProp(aself2_Br, 'Title', arName[j]);
            cfsSetProp(aself2_Br, 'Visible', arVis[j] > 0);
            cfsSetProp(aself2_Br, 'Protect', True);
            cfsSetProp(aself2_Br, 'Skip', False);
            cfsSetProp(aself2_Br, 'StatusCtx', 0);
            cfsSetProp(aself2_Br, 'Defaultwidth', integer(15));
          }

        end;

      }
//          }
    }//BRW2

  }

  CmValue68:
  {
    GetAddField;
    ReScanPanel(#katmc)
  }
  cmValue50:
  {
    Print_InvLabel;
  }
end;
end.

//Локальное меню главного окна интерфейса <link Interface L_MCU::KatMC>L_MCU::KatMC - Каталог материальных ценностей (МЦ)</link>
mnuKatMC_Print Menu
{
 = 'Печать', 'Печать каталога', hcOkatalSMCLocMenu, sci1Esc;
  {
   - '~П~ечать каталога', cmPrintDoc, 'Печать каталога матценностей', hcOkatalSMCLocMenu, 'Ctrl+P', kbCtrlP, sci1Esc,,,,bmpPrintDoc;
   - 'Печать каталога по внешней классификации', cmPlansNo, 'Печать каталога матценностей по внешней классификации', hcPrintKatalIntClass, 'Alt+P', kbAltP, sci1Esc;
   - 'Печать содержания драгметаллов в МЦ', cmValue18, 'Печать содержания драгметаллов в МЦ', hcOKatalLocMDragMet, '', , sci1Esc;
