#component "L_MCU"

Alter Interface GETGRMCSS;

  Create view
    var
      st,aself,aSelf1,aself2 : longint ;
      cur_o,cont_i,aObjType : string ;
      aself_,aSelf1_,aself2_ : longint ;
      cur_o_,cont_i_,aObjType_ : string ;
  ;

  HandleEvent
  cmHotKeys:
  {
     var DopMenuID  : string;
     DeleteMenuHowDynamics('L_MCU::mnuGetGrMCSS');
     DopMenuID := LoadMenu('L_MCU::mnuGetGrMCSS', false);
     AddMenuItem(DopMenuID, 'SEPARATOR', 0);
     AddMenuItem(DopMenuID, 'Дополнительные поля к группе', cmValue45);
     StoreMenuHowDynamics (DopMenuID, 'L_MCU::mnuGetGrMCSS');
     DisposeLoadMenu (DopMenuID);
     ReinitHeaderMenu;
     if Inherited::HandleEvent(cmHotKeys)=heAbort abort;
  }
     CmValue45:
     {
       RunInterface('vGetExt_Katmc',1,GroupMC.nrec);
     }
  end;
end.

