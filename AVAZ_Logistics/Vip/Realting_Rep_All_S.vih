#ifndef __vih_Realting_Rep_All_S__
#define __vih_Realting_Rep_All_S__

type arObjArea_ = Record
  objrec    : comp ; // Подразделение/Органиация
  tipobj    : word ; // Подразделение/Органиация 0/1
  dognrec   : comp ; // Договор тек ( тот,коорый привязан в неджвижке. Это может быть как основной, так и допник)
  dognrec_up  : comp ; // Договор выщестояший
  allArea   : double ; //Общая площадь
  ManufArea : double ; //Произв площадь
  VspArea   : double ; //Вспомог площадь
end;

type tObjArea = array[1] of arObjArea_;
type tRealOs  = array[1] of comp;

#component "AVAZ_LOGISTICS"

VipInterface Realting_Rep_All_S;
Public:
 Function GetAreaOneObj(os_nrec : comp; var aInf : tObjArea ) : Boolean;
 Function GetDataObjReal(dat: date; var aOs : tRealOs ) : Boolean;
end;

#end