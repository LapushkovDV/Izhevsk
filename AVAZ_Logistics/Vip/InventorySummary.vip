#component "AVAZ_Logistics"
#include IExcelBase_v2.vih

VipInterface InventorySummary (IExcelBase_v2);
Interface InventorySummary 'Сводная инвентаризационная ведомость';
 Show at(,,55,10);

Table Struct TmpInv
(
   Nrec   : comp
  ,TipDoc : word
  ,OnsPost : String
  ,Dat    : Date
  ,cMc    : comp
  ,Color  : String
  ,cPodr  : comp
  ,cParty : comp
  ,VIN    : String
  ,VidSob : String
  ,Kontrg : String
  ,KolBuh : Double
  ,KolFact: Double
  ,KolUrg : Double
  ,KolOtk : Double
  ,KolBrak: Double
  ,KolInvBrk : Double
  ,Price  : Double
  ,Summa  : Double
 ,cSaldTune : comp
 ,cObj  : comp
 ,cKau  : array [1..9] of comp
)
With Index
(
  TmpInv01 = Dat
 ,TmpInv99 = Nrec(unique,surrogate)
);

Table Struct TmpSvod
(
   Nrec   : comp
  ,cMc    : comp
  ,cPodr  : comp
  ,Color  : String
  ,KolBuh : Double
  ,KolFact: Double
  ,KolUrg : Double
  ,KolOtk : Double
  ,Summa  : Double
)
With Index
(
  TmpSvod01 = cMc + Color + cPodr
 ,TmpSvod99 = Nrec(unique,surrogate)
);

Table Struct TmpMC
(
  Nrec   : comp
 ,cMc    : comp
 ,BarKod : String
 ,Name   : String
 ,Color  : String
 ,xlRow  : Longint
)
With Index
(
  TmpMC01 = BarKod
 ,TmpMC02 = cMc + Color
 ,TmpMC99 = Nrec(unique,surrogate)
);

Table Struct TmpPodr
(
  Nrec  : comp
 ,cPodr : comp
 ,Kod   : String
 ,Name  : String
 ,xlCol : Longint
)
With Index
(
  TmpPodr01 = Kod
 ,TmpPodr02 = cPodr
 ,TmpPodr99 = Nrec(unique,surrogate)
);

Table Struct TmpOrder
(
  Nrec  : comp
 ,Dat   : Date
 ,cPodr : comp
 ,cMc   : comp
 ,cParty: comp
 ,cSaldTune : comp
 ,cObj  : comp
 ,cKau  : array [1..9] of comp
 ,Kol   : Double
)
With Index
(
  TmpPodr01 = Dat + cPodr + cMc + cParty + cSaldTune + cObj + cKau[1] + cKau[2] + cKau[3] + cKau[4] + cKau[5] + cKau[6] + cKau[7] + cKau[8] + cKau[9]
 ,TmpPodr99 = Nrec(unique,surrogate)
);




type myTRec = record
  Color  : String;
  VIN    : String;
  VidSob : String;
  Kontrg : String;
  KolBrak : Double;
  KolInvBrk : Double;
  cSaldTune : comp;
  cObj  : comp;
  cKau  : array [1..9] of comp;
end;

var BegDat,EndDat : Date; // Период инвентаризации
    TipInv  : word; // Тип инвентаризации 0 и 2
    myRec: myTRec;
    CU_Li , CU_Brak : comp;
    i : Longint;


Create View
as select *
from
  TmpInv
, TmpMC
, TmpPodr
, TmpSvod
, InvTab
, SpInvTab
, KatMc
, KatEd
, KatPodr
, KatParty
, SpecMTR
, SALDTUNE
where
((
    TipInv == InvTab.TipDoc
and BegDat <<= InvTab.dInv
and EndDat >>= InvTab.dInv

and InvTab.NRec == SpInvTab.cInvTab
and coSpInvTab  == SpecMTR.coTable
and SpInvTab.NRec == SpecMTR.cSpec

and SpecMTR.cSaldTune == SALDTUNE.NRec

and TmpInv.cMc == KatMc.NRec
and TmpInv.cPodr == KatPodr.NRec
and TmpInv.cParty == KatParty.NRec


and TmpInv.Dat       == TmpOrder.Dat
and TmpInv.cPodr     == TmpOrder.cPodr
and TmpInv.cMc       == TmpOrder.cMc
and TmpInv.cParty    == TmpOrder.cParty
and TmpInv.cSaldTune == TmpOrder.cSaldTune
and TmpInv.cObj      == TmpOrder.cObj
and TmpInv.cKau[1]    == TmpOrder.cKau[1]
and TmpInv.cKau[2]    == TmpOrder.cKau[2]
and TmpInv.cKau[3]    == TmpOrder.cKau[3]
and TmpInv.cKau[4]    == TmpOrder.cKau[4]
and TmpInv.cKau[5]    == TmpOrder.cKau[5]
and TmpInv.cKau[6]    == TmpOrder.cKau[6]
and TmpInv.cKau[7]    == TmpOrder.cKau[7]
and TmpInv.cKau[8]    == TmpOrder.cKau[8]
and TmpInv.cKau[9]    == TmpOrder.cKau[9]

));

Screen scRep '' ('', hcNoContext, sci1Esc);
Fields
 BegDat : NoProtect;
 EndDat : NoProtect;
Buttons
 cmOk;
 cmCancel;
<<

 `Период:`.@@@@@@@@@@@`-`.@@@@@@@@@@@






        <. Сформировать .>   <. Отмена .>

>>
End;

procedure GetMTR;
{
  set myRec.Color  := '';
  set myRec.VIN    := '';
  set myRec.VidSob := '';
  set myRec.Kontrg := '';
  set myRec.KolBrak := 0;
  set myRec.KolInvBrk := 0;
  set myRec.cSaldTune := 0;
  set myRec.cObj      := 0;
  for(i:=1;i<=9;i++)
  {
   set myRec.cKau[i]:= 0;
  }


  if GetFirst fastfirstrow SpecMTR=tsOk then
  {
   set myRec.cSaldTune := SpecMTR.cSaldTune;
   set myRec.cObj      := SpecMTR.cObj;
   for(i:=1;i<=9;i++)
   {
    set myRec.cKau[i]:= SpecMTR.cKau[i];
   }
   if SpecMTR.cSaldTune = CU_Li then
    {
     set myRec.VidSob := ShowKau(SALDTUNE.wObj, SpecMTR.cObj);
     set myRec.Kontrg := ShowKau(SALDTUNE.wKau[1], SpecMTR.cKau[1]);
     set myRec.Color  := ShowKau(SALDTUNE.wKau[3], SpecMTR.cKau[3]);
     set myRec.VIN    := ShowKau(SALDTUNE.wKau[4], SpecMTR.cKau[4]);
    };
   if SpecMTR.cSaldTune = CU_Brak then
    {
     set myRec.KolBrak := SpInvTab.KOLPRG;
     set myRec.KolInvBrk := SpInvTab.Kol;
    };
  };
}


procedure GetInvVed(_TipDoc : word);
{
  set TipInv:= _TipDoc;
 StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, if(TipInv=2,'Инвентаризация производства','Инвентаризация склада'), RecordsInTable(#InvTab));
 _loop InvTab
 {
  if not NextVisual then break;
  _loop SpInvTab
  {
   GetMTR;
   ClearBuffer(#TmpInv);
   set TmpInv.TipDoc   := InvTab.TipDoc;
   set TmpInv.OnsPost  := 'Не реализовано!';
   set TmpInv.Dat      := InvTab.dInv;
   set TmpInv.cMc      := SpInvTab.cMC;
   set TmpInv.Color    := myRec.Color;
   set TmpInv.cPodr    := InvTab.cSklad;
   set TmpInv.cParty   := SpInvTab.cParty;
   set TmpInv.VIN      := myRec.VIN;
   set TmpInv.VidSob   := myRec.VidSob;
   set TmpInv.Kontrg   := myRec.Kontrg;
   set TmpInv.KolBuh   := SpInvTab.KOLPRG;
   set TmpInv.KolFact  := SpInvTab.Kol;
   set TmpInv.KolOtk   := TmpInv.KolFact - TmpInv.KolBuh;
   set TmpInv.KolBrak  := myRec.KolBrak;
   set TmpInv.KolInvBrk:= myRec.KolInvBrk;
   set TmpInv.Price    := SpInvTab.PRICE;
   set TmpInv.Summa    := TmpInv.Price * TmpInv.KolOtk;
   set TmpInv.cSaldTune:= myRec.cSaldTune;
   set TmpInv.cObj     := myRec.cObj;
   for(i:=1;i<=9;i++)
   {
    set TmpInv.cKau[i]  := myRec.cKau[i];
   }
   insert current TmpInv;

   _loop TmpOrder
   {
    set TmpInv.KolUrg   := TmpInv.KolUrg + TmpOrder.Kol;
    update current TmpInv;
   }
  };
 };
 StopVisual( '', 0 );
};

procedure SetSummaFormula(pRow, pCol, pBRow, pERow, pBCol, pECol: longint);
{
  var
    sCells: string = '=СУММ('+ConvertXlsColumnNoToLetter(pBCol) + string(pBRow ) + ':' +
                     ConvertXlsColumnNoToLetter(pECol) + string(pERow)+')';
  SetCellFormula(sCells, pRow, pCol);
};


procedure ExportToExcel;
{
 var sTemplateName: string = TranslatePath(StartPathName+'XLS\AVAZ\inventory_summary.xltm');
 var lRow, lCol, EndRow,EndCol : Longint;
 StartNewVisual(vtRotateVisual, vfTimer, 'Формирование сводной ведомости...', 1);
 _try
 _try
 {
 CreateExcelWithTemplate(sTemplateName);

     // Лист 1 - Выгрузка
     xlSetActiveSheetByName('Выгрузка');
     set lRow:= 2;
     _loop TmpInv
     {
      if GetFirst fastfirstrow KatMc=tsOk then {};
      if GetFirst fastfirstrow KatPodr=tsOk then {};
      if GetFirst fastfirstrow KatParty=tsOk then {};

      set lCol:=0;
      inc(lCol);SetCellDateValue(TmpInv.Dat, lRow, lCol);
      inc(lCol);SetCellStringValue(TmpInv.OnsPost, lRow, lCol);
      inc(lCol);SetCellStringValue(KatMc.BarKod, lRow, lCol);
      inc(lCol);SetCellStringValue(KatMc.Obozn, lRow, lCol);
      inc(lCol);SetCellStringValue(KatMc.Name, lRow, lCol);
      inc(lCol);SetCellStringValue(KatMc.BarKod2, lRow, lCol);
      inc(lCol);SetCellStringValue(TmpInv.Color , lRow, lCol);
      inc(lCol);SetCellStringValue(KatPodr.Kod, lRow, lCol);
      inc(lCol);SetCellStringValue(TmpInv.VIN, lRow, lCol);
      inc(lCol);SetCellStringValue(TmpInv.VidSob, lRow, lCol);
      inc(lCol);SetCellStringValue(TmpInv.Kontrg, lRow, lCol);
      inc(lCol);SetCellStringValue(KatParty.Name, lRow, lCol);
      inc(lCol);SetCellNumberValue(TmpInv.KolBuh, lRow, lCol);
      inc(lCol);SetCellNumberValue(TmpInv.KolFact, lRow, lCol);
      inc(lCol);SetCellNumberValue(TmpInv.KolUrg, lRow, lCol);
      inc(lCol);SetCellNumberValue(TmpInv.KolOtk, lRow, lCol);
      inc(lCol);SetCellNumberValue(TmpInv.KolBrak, lRow, lCol);
      inc(lCol);SetCellNumberValue(TmpInv.KolInvBrk, lRow, lCol);
      inc(lCol);SetCellNumberValue(TmpInv.Price, lRow, lCol);
      inc(lCol);SetCellNumberValue(TmpInv.Summa, lRow, lCol);
      lRow++;

      if GetFirst fastfirstrow TmpMc where((KatMc.NRec == TmpMc.cMc and TmpInv.Color == TmpMc.Color))<>tsOk then
      {
       ClearBuffer(#TmpMc);
       set TmpMc.cMc    := KatMc.NRec;
       set TmpMc.BarKod := KatMc.BarKod;
       set TmpMc.Name   := KatMc.Name;
       set TmpMc.Color  := TmpInv.Color;
       insert current TmpMc;
      }
      if GetFirst fastfirstrow TmpPodr where((KatPodr.NRec == TmpPodr.cPodr))<>tsOk then
      {
       ClearBuffer(#TmpPodr);
       set TmpPodr.cPodr := KatPodr.NRec;
       set TmpPodr.Kod   := KatPodr.Kod;
       set TmpPodr.Name  := KatPodr.Name;
       insert current TmpPodr;
      }

      if GetFirst fastfirstrow TmpSvod where((KatMc.NRec == TmpSvod.cMc and TmpInv.Color == TmpSvod.Color and KatPodr.NRec == TmpSvod.cPodr))<>tsOk then
      {
       ClearBuffer(#TmpSvod);
       set TmpSvod.cMc    := KatMc.NRec;
       set TmpSvod.cPodr  := KatPodr.NRec;
       set TmpSvod.Color  := TmpInv.Color;
       insert current TmpSvod;
      }

       set TmpSvod.KolBuh := TmpSvod.KolBuh  + TmpInv.KolBuh;
       set TmpSvod.KolFact:= TmpSvod.KolFact + TmpInv.KolFact;
       set TmpSvod.KolUrg := TmpSvod.KolUrg  + TmpInv.KolUrg;
       set TmpSvod.KolOtk := TmpSvod.KolOtk  + TmpInv.KolOtk;
       set TmpSvod.Summa  := TmpSvod.Summa   + TmpInv.Summa;
       update current TmpSvod;
     }

     // Лист 2 - Сводная
     xlSetActiveSheetByName('Сводная');
     set lCol:=4;
     _loop TmpPodr
     {
      xlMergeCells(1,lCol,1,lCol+4);
      SetCellStringValue(TmpPodr.Kod+' '+TmpPodr.Name   , 1, lCol);
      SetCellStringValue('Бух.учет '    , 2, lCol);
      SetCellStringValue('Факт'         , 2, lCol+1);
      SetCellStringValue('Урегулировано', 2, lCol+2);
      SetCellStringValue('Отклонение'   , 2, lCol+3);
      SetCellStringValue('Сумма'        , 2, lCol+4);

      set TmpPodr.xlCol := lCol;
      update current TmpPodr;
      set lCol := lCol + 5;
     }
     set EndCol:= lCol - 1;

     set lRow:= 3;
     _loop TmpMc
     {
      set lCol:= 0;
      inc(lCol);SetCellStringValue(TmpMc.BarKod, lRow, lCol);
      inc(lCol);SetCellStringValue(TmpMc.Name  , lRow, lCol);
      inc(lCol);SetCellStringValue(TmpMc.Color , lRow, lCol);
      set TmpMc.xlRow := lRow;
      update current TmpMc;
      lRow++;
     }
     set EndRow:= lRow;

     _loop TmpSvod
     {
      if GetFirst fastfirstrow TmpMc where((TmpSvod.cMc == TmpMc.cMc and TmpSvod.Color == TmpMc.Color))=tsOk then
      {
        set lRow:= TmpMc.xlRow;
        if GetFirst fastfirstrow TmpPodr where((TmpSvod.cPodr == TmpPodr.cPodr))=tsOk then
        {
          set lCol:= TmpPodr.xlCol;
          SetCellNumberValue(TmpSvod.KolBuh, lRow, lCol);
          SetCellNumberValue(TmpSvod.KolFact, lRow, lCol+1);
          SetCellNumberValue(TmpSvod.KolUrg, lRow, lCol+2);
          SetCellNumberValue(TmpSvod.KolOtk, lRow, lCol+3);
          SetCellNumberValue(TmpSvod.Summa, lRow, lCol+4);
        }
      }
     };


     for(lCol:=4;lCol <= EndCol; lCol++)
     {
       SetSummaFormula(EndRow, lCol, 3, EndRow - 1, lCol, lCol);
     };

     SetCellStringValue('ИТОГО' , EndRow, 3);
     xlFrameCells(1 or 2 or 4 or 8 or 16 or 32, 2, 1, 1, 1, 1, EndRow ,EndCol);
    }
    _except
      on ExExcelFatalError:
        Message('При формировании отчета Excel произошла ошибка с кодом ' + string(xlGetLastError), Error);
  _finally
  {
    xlKillExcel;
    if VisualizationActive() then StopVisual('', 0);
  }
};

function Get_CU(_wType: word; _Name: string):comp;
{
 result:= 0;
 if GetFirst fastfirstrow SALDTUNE
  where((_wType == SALDTUNE.wType and _Name == SALDTUNE.Name))=tsOk then
   result:= SALDTUNE.NRec;
};

procedure GetOrders;
{

 insert visual 'Подсчет ордеров' TmpOrder(Dat,cPodr,cMc,cParty,cSaldTune,cObj,cKau[1],cKau[2],cKau[3],cKau[4],cKau[5],cKau[6],cKau[7],cKau[8],cKau[9],Kol)
  select SklOrder.dOrd,SklOrder.cPodr,SpOrder.cMC,SpOrder.cParty,SpecMTR.cSaldTune,SpecMTR.cObj,
         SpecMTR.cKau[1],SpecMTR.cKau[2],SpecMTR.cKau[3],SpecMTR.cKau[4],SpecMTR.cKau[5],
         SpecMTR.cKau[6],SpecMTR.cKau[7],SpecMTR.cKau[8],SpecMTR.cKau[9],
         if(SklOrder.VidOrder=0,SpOrder.Kol,-1*SpOrder.Kol)
  from SklOrder, SpOrder, SpecMTR
   where((BegDat <<= SklOrder.dOrd
          and EndDat >>= SklOrder.dOrd
          and SklOrder.NRec == SpOrder.cSklOrder
          and coSpOrder  == SpecMTR.coTable
          and SpOrder.NRec == SpecMTR.cSpec
        ))
        and (SklOrder.TipOrd = 2 or SklOrder.TipOrd =3);
};

HandleEvent // Interface

cmInit:
{
 set BegDat  := EndDat:= Cur_Date;
 set CU_Li   := Get_CU(5,'ЦУ ЛИ');
 set CU_Brak := Get_CU(3,'Брак');
};

cmDone:
{

};

cmOk:
{
 delete all TmpInv;
 delete all TmpMC;
 delete all TmpPodr;
 delete all TmpSvod;
 GetOrders;
 GetInvVed(0);
 GetInvVed(2);
 ExportToExcel;
};
End;
end.

#include UserReport.vih;
VipInterface UserReport_InventorySummary Implements IUserReport;
Interface UserReport_InventorySummary;
create view;
procedure Run;
begin
 RunInterfaceNoModal(InventorySummary);
end;
function GetReportName: String;
begin
  GetReportName := 'Сводная инвентаризационная ведомость';
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := 'Качество';
  case Level of
    1 : GetGroupName := 'Качество';
  end;
end;
function GetPriority : Integer;
begin
  GetPriority := -100;
end;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '*';
end;
end.
