  Persons.Sex      ('Пол работника') : Protect;
  HiPodName        ('Вышестоящее структурное подразделение (если есть)') : Protect, EditButton;
  PersPosDate      ('Дата приема работника на работу') : [,'DD/MM/YYYY'], Protect;
  MolName          ('Материально ответственное лицо на котором числятся выданные предметы',, sci1378Esc) : Protect, EditButton;
  PersCard.perDate ('Дата последнего перевода из одного подразделения в другое') : [,'DD/MM/YYYY'], Protect;
  [Uch_name]   if(sCurUch='',sGetAttrID ( coPersCard, PersCard.nrec, cAttr_Uch ),sCurUch) ('Участок работника') : Protect,PickButton;
  [Brig_name]  if(sCurBrig='',sGetAttrID ( coPersCard, PersCard.nrec, cAttr_Brig ),sCurBrig)   ('Бригада работника') : Protect,PickButton;
  BelongDescr      ('Организационно-технологическая принадлежность и направление деятельности',, sci1378Esc): Protect, noDel;
  PersCard.disDate ('Дата увольнения работника') : [,'DD/MM/YYYY'], NoProtect;
  CatalogsApp.Name ('Характер назначения') : Protect;
  PersCard.attDate ('Дата первой аттестации работника для отсчета сроков службы') : [,'DD/MM/YYYY'], NoProtect,
    {Font = {BackColor = if (To_Days(PersCard.attDate) = 0, ColorNeed, 0)}};
  Catalogs.Name    ('Должность, занимаемая работником') : Protect, EditButton;
  PersCard.chDate  ('Дата последнего изменения норм') : [,'DD/MM/YYYY'], Protect;
