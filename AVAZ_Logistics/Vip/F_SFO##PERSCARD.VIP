#component "F_SFO"
#include ShowKau.vpp            // declare с КАУ
#include AttrTablePick.vih
#include iDF.vih
#include PiP_Documents.vih
#include Permission.vih
#define __PERSCARD_VIP__

#doc
Интерфейс выбора и редактирования ЛК учета СФО.<br>
#end
Alter Interface getPersCard;
var
  cAttr_Uch,cAttr_Brig,_cOldV,_cNewV,cCurUch,cCurBrig,_tc:comp;
  D1,D2:date;
  sCurUch,sCurBrig,_ts:string;
  DF:AVAZ_Logistics::iDF;
var refAttrTablePick: AttrTablePick;

overload
procedure choosePerson(tcPodr : comp);
procedure chkCardStatus;
end;

create view as
select Attrvald.* from Attrval Attrvald,spkau spkau_chk;

OverloadFormats scPersCard;


procedure MakeUch;
{
    cCurUch:=0; sCurUch:='';
    _tc:=DF.GetBrUchNrec(VA_SO_UCH,Perscard.CLSCHET) ;
    if _tc<>0 then
    {
     _ts:='';if getfirst fastfirstrow spkau_chk where ((_tc == spkau_chk.nrec))=tsok then _ts:=spkau_chk.name;
     cCurUch:= _tc; sCurUch:= _ts;

    }
    else delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Uch == attrvald.CATTRNAM)) ;
}

procedure MakeBrig;
{
    _tc:=0;_ts:='';
    cCurBrig:=0; sCurBrig:='';
    _tc:=DF.GetBrUchNrec(VA_SO_BRIG,Perscard.CLSCHET) ;
    if _tc<>0 then
    {
     _ts:='';if getfirst fastfirstrow spkau_chk where ((_tc == spkau_chk.nrec))=tsok then _ts:=spkau_chk.name;
      cCurBrig:= _tc; sCurBrig:= _ts;

    }
    else delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Brig == attrvald.CATTRNAM)) ;

}

procedure SaveUchBrig;
{
       if cCurBrig<>0 then coSetAttrID(coPersCard, PersCard.nrec, cAttr_Brig, cCurBrig, sCurBrig) ;
                      else delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Brig == attrvald.CATTRNAM)) ;
       if cCurUch <>0 then coSetAttrID(coPersCard, PersCard.nrec, cAttr_Uch, cCurUch, sCurUch) ;
                      else delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Brig == attrvald.CATTRNAM)) ;

}

procedure chkCardStatus;
{
   inherited::chkCardStatus;
  // Персональное звание
  if (cCurUch<>DF.GetBrUchNrec(VA_SO_UCH,Perscard.CLSCHET)) or (cCurBrig<>DF.GetBrUchNrec(VA_SO_BRIG,Perscard.CLSCHET))
    if Message('Изменились данные по Участку и Бригаде работника. Заменить данными из лицевого счета?',yesNo )=cmYes then
     {
       MakeUch;
       MakeBrig;
       SaveUchBrig;
       Rescanpanel(#PersCard);
     }
     else
       if Message('Очистить данные по Участку и Бригаде в ЛК?',okCancel  )=cmOk  then
         {
          delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Uch == attrvald.CATTRNAM)) ;
          delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Brig == attrvald.CATTRNAM)) ;
          cCurUch:=0;sCurUch:='';
          cCurBrig:=0;sCurBrig:='';
          Rescanpanel(#PersCard);
        }

 }



procedure choosePerson(tcPodr : comp);
var _OldLS:comp;

{
 _OldLS:=Perscard.CLSCHET;
 inherited::choosePerson(tcPodr);


 if  (coGetAttrID ( coPersCard, PersCard.nrec, cAttr_Uch)=0) or (PersCard.nrec=0) or (_OldLS <> Perscard.CLSCHET) then
 {
    MakeUch;
 }

 if   (coGetAttrID ( coPersCard, PersCard.nrec, cAttr_Brig)=0) or (PersCard.nrec=0) or (_OldLS <> Perscard.CLSCHET)  then
 {
    MakeBrig;
 }

}



Window editPersCard;

Screen scPersCard ('Личная карточка учета специальной (форменной) одежды',, sci178Esc);
//  Show At (,,, 17);
  Table PersCard, EventNavigation;
