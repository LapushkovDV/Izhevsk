end;



HandleEvent
cmPick:
 {
   case CurField of
   #Uch_name :
   {
      if ( UpdateTable )
      {
        refAttrTablePick.PickValue ( coPersCard, cAttr_Uch, PersCard.nrec );
        ReReadRecord ( #PersCard );
      }
   }
   #Brig_name :
   {
      if ( UpdateTable )
      {
        refAttrTablePick.PickValue ( coPersCard, cAttr_Brig, PersCard.nrec );
        ReReadRecord ( #PersCard );
      }
   }
  #shOF, #shDF, #shOS, #shDS:
      {
       ClearMyDsk('AVAZ_GET_CHK');
       ClearMyDsk('AVAZ_GET_UCH');
       ClearMyDsk('AVAZ_GET_BRIG');
       ClearMyDsk('AVAZ_GET_D');
       ClearMyDsk('AVAZ_GET_P');
       SaveMyDsk(coGetAttrID ( coPersCard, PersCard.nrec, cAttr_Uch ),'AVAZ_GET_UCH');
       SaveMyDsk(coGetAttrID ( coPersCard, PersCard.nrec, cAttr_Brig ),'AVAZ_GET_BRIG');
       SaveMyDsk(PersCard.CPOST,'AVAZ_GET_D');
       SaveMyDsk(PersCard.CPODR,'AVAZ_GET_P');
       SaveMyDsk(word(1),'AVAZ_GET_CHK');
      }
     end;
  case Inherited::HandleEvent(cmPick) of
   heAbort :  Abort;
   heStop  :  Exit;
  end;
  ClearMyDsk('AVAZ_GET_CHK');
  ClearMyDsk('AVAZ_GET_UCH');
  ClearMyDsk('AVAZ_GET_BRIG');
  ClearMyDsk('AVAZ_GET_D');
  ClearMyDsk('AVAZ_GET_P');
 }
  cmValue7:
  {
    if (isClosedCard(PersCard.Status, True))
      Exit;

    if (isProtected(#PersCard))
    {
      ProcessCommand(cmProtectedInput);
      Exit;
    }

    if (not isLSchet)
      Exit;

    if (not UpdateTable)
      Exit;

    if (not bIsDuty)
      if (PersCard.Status = crdMoving)
        if (Message('Для данного работника в этом'#13 +
                    'месяце перевод уже проводили!'#13 +
                    'Выполнять повторный перевод?', Warning + YesNo) <> cmYes)
          Exit;

    if (Message('Для возврата или списания спецодежды используйте'#13 +
                'функции локального меню "Возврат", "Выбытие".'#13 +
                'Будете перемещать всю спецодежду, ' + if (bIsDuty, 'числящуюся'#13, 'используемую'#13) +
                if (bIsDuty, 'на карточке?', 'работником?'), Warning + YesNo) <> cmYes)
      Exit;

   D1:=Cur_date;
   D2:=Add_Day(D1,1);
   if ( RunDialog('AVAZ_Logistics::AV_SFO_GetInterval', D1, D2 ) = cmCancel )
          Exit;
  _cOldV:=PersCard.cpodr;
   RunInterface('MoveSFOParams', PersCard.nRec, if (bIsDuty, Word(1), Word(0)));
   ReReadRecord(#PersCard);
  _cNewV:=PersCard.cpodr;
  if(_cOldV<>_cNewV)
  {
  RunInterface('AVAZ_Logistics::SFO_UpdateNorm', PersCard.nrec, D1, D2);
  }
  ShowCurNorms;
  RefreshPersSFO;
}
//--------------------------------
  cmValue30: // Смена должности
  {


    if (bIsDuty)
      Exit;

    if (not isLSchet)
      Exit;

    if (not UpdateTable)
      Exit;

    if (isClosedCard(PersCard.Status, True))
      Exit;

    if (isProtected(#PersCard))
    {
      ProcessCommand(cmProtectedInput);
      Exit;
    }

    var cNewPost : comp;
    cNewPost := iPersInfo.GetPostNRec(PersCard.nRec);

    if (PersCard.cPost = cNewPost)
      Exit;

    if (Message('Изменить должность в ЛК учета СФО?', Confirmation + YesNo) = cmYes)
    {
      D1:=Cur_date;
      D2:=Add_Day(D1,1);
      if ( RunDialog('AVAZ_Logistics::AV_SFO_GetInterval', D1, D2 ) = cmCancel )
          Exit;
      iMovePers.SetPost(PersCard.nRec, cNewPost, ZeroDate);
      ReReadRecord(#PersCard);
      RunInterface('AVAZ_Logistics::SFO_UpdateNorm', PersCard.nrec, D1, D2);

    }
  ReReadRecord(#PersCard);
  ReScanPanel(#shPersSFO);
  }
end;
TableEvent
 cmDelOnProtect:
 {
  Case CurField of
   #Uch_name :
   {
      if ( UpdateTable )
      {
        delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Uch == attrvald.CATTRNAM)) ;
        cCurUch:=0;sCurUch:='';
        ReReadRecord ( #PersCard );
      }
   }
   #Brig_name :
   {
      if ( UpdateTable )
      {
        delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Brig == attrvald.CATTRNAM)) ;
        cCurBrig:=0;sCurBrig:='';
        ReReadRecord ( #PersCard );
      }
   }

  end;
  inherited::handleevent(cmDelOnProtect);
 }

end;
end;

Panel pnlGetPersCard;
  Table PersCard;

HandleEvent // Panel pnlGetPersCard
cmInsertRecord:
  {
    prevAtt := PersCard.attDate;

    if (Insert Current PersCard = tsOk)
    {
      // формирование разрешений
      if (oPipPerm.MakePermissionsAlg(word(2), pDocTiDkGal, 0, PersCard.nRec, PersCard.DocBelong, false) = cgMakePermissionsAlg_Changed)
        if (Update Current PersCard <> tsOk) {};
      if cCurBrig<>0 then coSetAttrID(coPersCard, PersCard.nrec, cAttr_Brig, cCurBrig, sCurBrig) ;
      if cCurUch <>0 then coSetAttrID(coPersCard, PersCard.nrec, cAttr_Uch, cCurUch, sCurUch) ;

      if (not bIsDuty)
        if (boGetTune('Fin.SFO.CanEditPersNorm'))
          RunInterface('AVAZ_Logistics::SFO_UpdateNorm', PersCard.nrec, PersCard.attDate, PersCard.attDate);
    }
  }
cmPositionChanged :
 {
    If inherited::handleevent ( cmPositionChanged ) = heAbort then abort;
    cCurBrig:=coGetAttrID ( coPersCard, PersCard.nrec, cAttr_brig);
    sCurBrig:='';if getfirst fastfirstrow spkau_chk where ((cCurBrig == spkau_chk.nrec))=tsok then sCurBrig:=spkau_chk.name;
    cCurUch:=coGetAttrID ( coPersCard, PersCard.nrec, cAttr_Uch);
    sCurUch:='';if getfirst fastfirstrow spkau_chk where ((cCurUch == spkau_chk.nrec))=tsok then sCurUch:=spkau_chk.name;
    Rescanpanel(#PersCard);
 }

cmUpdateRecord:
  {
    If inherited::handleevent ( cmUpdateRecord ) = heAbort then abort;
    if PersCard.nrec<>0 then
    {
      SaveUchBrig;
      if (not bIsDuty)
        if (boGetTune('Fin.SFO.CanEditPersNorm'))
          RunInterface('AVAZ_Logistics::SFO_UpdateNorm', PersCard.nrec, PersCard.attDate, PersCard.attDate);
    }
    ReReadRecord(if (BoundActive(tbByCards), #tblCards, #PersCard));
 }
cmDeleteRecord :
  {

    if (not isDelConfirmed)
    {
      Abort;
      Exit;
    }

    delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Brig == attrvald.CATTRNAM)) ;
    delete all AttrvalD where ((coPersCard == attrvald.wtable and PersCard.nrec == attrvald.crec and cAttr_Uch == attrvald.CATTRNAM)) ;
    DelPersCard;
    ReReadRecord(if (BoundActive(tbByCards), #tblCards, #PersCard));
  }

end; // HandleEvent Panel pnlGetPersCard
end; // Panel pnlGetPersCard


HandleEvent
cmInit:{
  cAttr_Uch:=ExtAttr_ID ( coPersCard,VA_SO_UCH);
  cAttr_Brig:=ExtAttr_ID ( coPersCard,VA_SO_BRIG);
  If inherited::handleevent ( cmInit ) = heAbort then abort;
}
end;
END.
