  cmValue1,,, 'Редактирование размеров и других атрибутов одежды для работника', hcSFOIPersSizes, sci1Esc;
  cmValue4,,, 'Формирование требований на выдачу для работника', hcSFOINewReqBut, sci1Esc;
  cmValue5,,, 'Просмотр и обработка требований на выдачу СФО по работнику', hcSFOIReqBut, sci1Esc;
  cmValue2,,, 'Просмотр и редактирование истории норм и их спецификации по работнику', hcSFOINormHist, sci1Esc;
  cmValue18,,, 'Просмотр и редактирование периодов приостановки по работнику', hcSFO_PriostSrokNoski, sci1Esc;
