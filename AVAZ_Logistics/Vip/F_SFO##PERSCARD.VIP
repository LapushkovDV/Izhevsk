  PrsCrdStatus     ('Статус личной карточки учета специальной (форменной) одежды') : Protect,
    {Font = {Bold = True; Color = if (isClosedCard(PersCard.Status, False), ColorNotOk, if (statPersBreak = 'Не действует', 0, ColorNotOk))}};
