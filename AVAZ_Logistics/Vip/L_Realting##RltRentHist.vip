#component "L_Realting"
alter Interface RltRentHistory


OverloadFormats brRentsList;
Window wRents

Browse brRentsList 'Операции с объектом' (,,sci178Esc);
Fields
  rltRents.npp   '№','п/п'                                          :  [3],    skip, Centered;
  GetOprName     'Вид операции'       ('Вид операции над объектом',,) : [30], protect, Centered;
  rltRents.dDoc  'Дата','документа' ('Дата документа',,)            : [11], protect, Centered;
  rltRents.NoDoc 'Номер документа'    ('Номер документа',,)           : [20], protect;
  rltRents.dFrom 'На период','с'    ('Начальная дата периода',,)    : [10], protect, Centered;
  rltRents.dTo   'На период','по'   ('Конечная дата периода',,)     : [10], protect, Centered;
  if(fpco.abbr<>'',fpco.abbr+', ','')+fpCO.Name      'Подразделение/',
                 'Организация'        ('Подразделение/Организация',,) : [25], protect;
end; // Browse

end;
end.
