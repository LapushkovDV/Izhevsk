HandleEvent


cmPick:
 {
  case CurField of
    #sRoomAddr2:
    {
      iAdrFunc.PickAddress(rltAttrHist.coValues[4]);
      set rltAttrHist.coValues[4] := rltAttrHist.coValues[4];
    }
  //******************************************************************************
  end;
  inherited::handleevent(cmPick);
 }
end; // HandleEvent

end; // Window
HandleEvent
cmCheckField:
 {

    case Inherited::HandleEvent(cmCheckField) of
      heAbort :  Abort;
      heStop  :  Exit;
    end;

 // wBuildingAttrsEdit

  if CurWindow = wRoomAttrsEdit then
  case CurField of
    #rltAttrHist.doValues[4]:
    { var tS1:double=GetSumPByBuilding(BuildingsRecBuf.COBJ);
      var tSA:double= Round(BuildingsRecBuf.doValues[4],2);
      IF tS1>tSA then
       {
         message('Площадь объекта : '+DoubleToStr(tSA,'66666666.88')+ ', а суммарная площадь помещений : '+DoubleToStr(tS1,'66666666.88')+'. Проверьте корректность площадей!',Information);
       }
    }

  end;

 }

end;
End.
