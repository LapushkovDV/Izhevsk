#declare LabelFont(AttrType,Ind)
{ Font = { Bold   = (PrevRecBuf.#(AttrType)Values[#Ind] <> rltAttrHist.#(AttrType)Values[#Ind]);
           Italic = (PrevRecBuf.#(AttrType)Values[#Ind]  = rltAttrHist.#(AttrType)Values[#Ind]) } };
#end

#declare AttrFont(AttrType,Ind)
{ Font = { Bold  = (PrevRecBuf.#(AttrType)Values[#Ind] <> rltAttrHist.#(AttrType)Values[#Ind]) } };
#end
Alter Interface RltAttrsEdit;

OverloadFormats scrRoomAttrsValues;

create view as select RLTBUILDINGS_CHK.* from  RLTBUILDINGS RLTBUILDINGS_CHK, RLTFLOORS RLTFLOORS_CHK ,RLTROOMS RLTROOMS_CHK ,RLTATTRHIST RLTATTRHIST_Room
where((
     RLTBUILDINGS_CHK.nrec  == RLTFLOORS_CHK.CBUILDING
     and
     RLTBUILDINGS_CHK.nrec  == RLTROOMS_CHK.CBUILDING
     and
     RLTFLOORS_CHK.nrec     == RLTROOMS_CHK.CFLOOR
     AND
     roRoom                 == RLTATTRHIST_Room.vidobj
     and
     RLTROOMS_CHK.nrec      == RLTATTRHIST_Room.cobj
     and
     rltAttrHist.dChange  >>=  RLTATTRHIST_Room.DCHANGE

));

function GetSumPByBuilding(_cBuild:comp):double;
var tSum:double;
{
 Result:=tSum:=0;
 if getfirst RLTBUILDINGS_CHK where ((_cBuild == RLTBUILDINGS_CHK.nrec))=tsok then
 {

    _loop RLTFLOORS_CHK
    {
     _loop RLTROOMS_CHK
      {
        if getfirst fastfirstrow RLTATTRHIST_Room = tsok
         {
              if rltAttrHist.nrec= RLTATTRHIST_Room.nrec then continue;
              tSum := tSum + Round(RLTATTRHIST_Room.DOVALUES[4],2);
         }
      }
    }
 }
 tSum:=tSum+Round(rltAttrHist.doValues[4],2);
 Result:=tSum;
}



Window wRoomAttrsEdit;

Screen scrRoomAttrsValues 'Значения атрибутов' (,,sci1Esc);
Table rltAttrHist;
  Bevel b01 { 0,  1,  0,  1, bsRaised , bsHorizontal};
  Bevel b02 { 0,  5,  0,  5, bsRaised , bsHorizontal};
  Bevel b03 { 1, 12, 40, 16, bsLowered, bsFrame     };
  Bevel b03 { 1, 19, 40, 22, bsLowered, bsFrame     };
 // Bevel b04 { 1, 22, 40, 26, bsLowered, bsFrame     };
//  Bevel b05 { 0, 35,  0, 35, bsRaised , bsHorizontal};
