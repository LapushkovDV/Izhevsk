

#include TuneSpec.vih
#include FeeSigners.vih
#include GetKau.vih

VipInterface GP_IntrTune_CommonVAZ implements ObjIntrTuneComponent licensed (FREE);

// Обработчик точки расширения epIntrTuneComponent
// Должен вернуть FALSE если обработка проводилась. TRUE - если не проводилась.
handler with replace GP_IntrTune_CommonVAZ on extensionPoint epIntrTuneComponent (TR: objTuneIntr; TVal: TTuneVal; Inter: string)
action
{
   var ifc : GP_IntrTune_CommonVAZ;
   result := not ifc.TuneIntrComponent (TR, TVal, Inter);
}
#doc
 обработчики настроек
#end
//-----------------------------------
Interface GP_IntrTune_CommonVAZ;
//-----------------------------------
//-----------------------------------

var
 Markers:tPtr;
 KAuMarkerName:string;
 wStr:string;
 j:longint;
Create view
from
  KatParty
, SaldTune
;
// Обязательно должна вернуть False если обработка не производилась, иначе true
Public Function TuneIntrComponent (TR: objTuneIntr; TVal: TTuneVal; Inter: string) : boolean;
{
  Var PrOk : boolean;  PrOk := False;

  TuneIntrComponent := true; // Чтобы в каждом case не писать это

  case UpCase(Inter) of

  'GET_TARNMESTA_PARTY': {
      var _cParty : comp =TVal.CompVal;
      If RunInterface(L_KATPARTY::GETPAR__,_cParty,0h)<>cmCancel
      {
        if getfirst katparty where ((_cParty == katparty.nrec)) = tsOK {
            TVal.CompVal:=katparty.nrec;
            TVal.strVal :=katparty.name;
            PrOk := true;
        }
      }
  }
  'GET_TARNMESTA_CU': {
      var _cSald : comp =TVal.CompVal;
      If RunInterface(L_SALDOMTR::GETSALDTUNE, _cSald, 0)<>cmCancel
      {
        if getfirst SaldTune where ((_cSald == SaldTune.nrec)) = tsOK {
            TVal.CompVal:=SaldTune.nrec;
            TVal.strVal :=SaldTune.name;
            PrOk := true;
        }
      }
  }
  else
    TuneIntrComponent := false;  // Если не зашли в обработку, то обязательно установим в false
  end;  // case

  if (PrOk)
    TR.UpdateTuneVal(TVal);
}     // TuneIntrComponent
end. // интерфейс
