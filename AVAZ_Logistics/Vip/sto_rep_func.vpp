
function RangesIntersect(B1, E1, B2, E2: date): boolean;
{
   var Min: date;
   var Max: date;
   // наибольшая из дат начала
   Min := if(B1 > B2, B1, B2);
   // наименьшая из ненулевых дат окончания
   if Day(E1) = 0
     E1 := E2
   else
     if Day(E2) = 0
       E2 := E1;
   Max := if(E1 < E2, E1, E2);
   RangesIntersect := (Min <= Max) or (Day(Max) = 0);
}


Function ShowKauT(_wKau : Word; _cKau : Comp;T : word): String;
{
  Result := if (GetAnyKAU(cgAkSimple, _wKau, _cKau), GivenAnName(T), '');
}


function CheckInPutVars:boolean;
{
  result:=false;

  if (DTB=date(0,0,0) or DTE=date(0,0,0)) {
    message('Пожалуйста, укажите период.');

    exit;
  }

  result:=true;
}



procedure GetPODRCEXUCH(c1:comp;var p1:string;var p2:string;var p3:string);
var c2,c3:comp;
{
  p1:='';
  p2:='';
  p3:='';
  if getfirst fastfirstrow katpodr where ((c1 == katpodr.nrec)) =tsok
  {
    p1:=katpodr.kod;
    c2:=katpodr.cpodr;
  }
  if getfirst fastfirstrow katpodr where ((c2 == katpodr.nrec)) =tsok
  {
    p2:=katpodr.kod;
    c3:=katpodr.cpodr;
  }
  if getfirst fastfirstrow katpodr where ((c3 == katpodr.nrec)) =tsok
  {
    p3:=katpodr.kod;
  }
}
function FindPS(cmc:comp):comp;
{
  Result:=0;
  _loop  HDR_PS where ((cgKAU_KatMC == HDR_PS.cTypeIzd and cmc == HDR_PS.cIzd and (cPS_SHAB_Instr = HDR_PS.CDOCNASTR)))
   if RangesIntersect(DTB,DTE,HDR_PS.DTBEG,HDR_PS.DTEND) then Result:=HDR_PS.nrec;
}

procedure GetDopAnal(var _sAnalog:string;var _sUslNorm:string);
{
 _sAnalog:='';
 _sUslNorm:='';
 if getfirst fastfirstrow spkau where((tmppotr.canval2 == spkau.nrec))=tsok then _sUslNorm:=spkau.name;
 if getfirst fastfirstrow spkau where((tmppotr.canval3 == spkau.nrec))=tsok then _sAnalog:=spkau.name;
}

