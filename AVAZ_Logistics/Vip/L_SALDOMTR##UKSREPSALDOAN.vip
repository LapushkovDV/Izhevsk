#include iLabel.vih
#component "L_SALDOMTR"
alter Interface UksRepSaldoAn
var iL : iLabel;

Create view
as select * from
 SPECMTR
where
((
    TmpSaldo1.CSALDTUNE == SPECMTR.CSALDTUNE
and TmpSaldo1.COBJ      == SPECMTR.COBJ
and TmpSaldo1.CKAU[1]   == SPECMTR.CKAU[1]
and TmpSaldo1.CKAU[2]   == SPECMTR.CKAU[2]
and TmpSaldo1.CKAU[3]   == SPECMTR.CKAU[3]
and TmpSaldo1.CKAU[4]   == SPECMTR.CKAU[4]
and TmpSaldo1.CKAU[5]   == SPECMTR.CKAU[5]
and TmpSaldo1.CKAU[6]   == SPECMTR.CKAU[6]
and TmpSaldo1.CKAU[7]   == SPECMTR.CKAU[7]
and TmpSaldo1.CKAU[8]   == SPECMTR.CKAU[8]
and TmpSaldo1.CKAU[9]   == SPECMTR.CKAU[9]
));
Window wnOst 'Отчет: складские остатки по аналитикам целевого учета МТР.' ('', hcMTR_SkladskieOstatki, sci1Esc);
HandleEvent // Interface
cmValue50:
{
  iL.Init;
  _loop TmpSaldo1
  {
   iL.AddMC(dDate,TmpSaldo1.cPodr,TmpSaldo1.cMC,SPECMTR.Nrec,TmpSaldo1.cParty,0);
  }
  iL.Print;
}
end;
end;

end.

mnu_Ost Menu
{
- 'Печать', cmPrintDoc, 'Печать отчета',,,, sci1Esc;
- 'Печать Инвентаризационный ярлык', cmValue50;
}
