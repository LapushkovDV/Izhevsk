#component "L_Sklad"

Alter Interface iInvOpPrn;
  Overload Procedure SpInvOp_UserAlg;
end;

//------------------------------------------------------------------------------
// пользовательские алгоритмы для позиции спецификации
Procedure SpInvOp_UserAlg;
   var ss_ : s20='';
   var pos_ss_ : integer = 0;
{
!  if SetPosMc_Comp(SpInvOp.cMC)
!  {
//    Message('getval='+String(GetPosFieldValue('Счет б/у',SpInvOp.cMC)))
    ss_:=GetPosFieldValue('Счет б/у',SpInvOp.cMC);
    pos_ss_ :=instr(' ',ss_);
    SpInvOp.Schet := String(Substr(ss_,1,pos_ss_-1)); // GetPosFieldValue('Счет учета ТМЦ');
!  }

  if (SpInvOp.IKol > 0) or (SpInvOp.NKol > 0)
    GetInfoByOrderOnDate;

  update current SpInvOp;
}
End. // interface
