
#define OBJINT_ALGORITM
#include objintpl.vin
#include PSManager.vih

#component "M_MnPlan"
VipInterface AlgoritmSetup_6118 implements oAlgoritmSetup;
Interface AlgoritmSetup_6118 'Настройка алгоритма № 6118' (,hcNoContext,) EscClose;
show(5,2,80,17);
#include PSManager.var

create view
var
  cFormPl ,myPlansNo: comp;
  sSch, sSub: string;

as
select  FormPl.nrec
from    FormPl,BuhSchet
where((cFormPl==FormPl.NRec));

Parameters cFormPl;

procedure GetSSS(ww:word);
{

    if (GetFirst BuhSchet where (( FormPl.RESCOMP[ww] == BuhSchet.Nrec)) = tsOk)
    {
      sSch :=  BuhSchet.Schet;
      sSub :=  BuhSchet.SubSch;
    }
    if (RunInterface(F_BuhSchet::GetBuhSchet, word(cgiPick or cgiPickExt) , MyPlansNo, sSch, sSub) = cmCancel)
    Exit;
    if (GetFirst BuhSchet where ((sSch == BuhSchet.Schet and sSub == BuhSchet.SubSch)) = tsOk)
    {
      set FormPl.RESCOMP[ww]  := BuhSchet.Nrec;
      set FormPl.RESNAME[ww]  := sSch + if(BuhSchet.Code = '', '', '.' + sSub) + ' ' + BuhSchet.Name;
    }

}


screen scMain;
Table FormPl;
Fields
 [f01] Substr(FormPl.RESNAME[01],2,Length(FormPl.RESNAME[01])) ('Счет БУ', , sci13Esc): Protect,PickButton;
 [f02] Substr(FormPl.RESNAME[02],2,Length(FormPl.RESNAME[02])) ('Счет БУ', , sci13Esc): Protect,PickButton;
 [f03] Substr(FormPl.RESNAME[03],2,Length(FormPl.RESNAME[03])) ('Счет БУ', , sci13Esc): Protect,PickButton;
 [f04] Substr(FormPl.RESNAME[04],2,Length(FormPl.RESNAME[04])) ('Счет БУ', , sci13Esc): Protect,PickButton;
 [f05] Substr(FormPl.RESNAME[05],2,Length(FormPl.RESNAME[05])) ('Счет БУ', , sci13Esc): Protect,PickButton;
 [f06] Substr(FormPl.RESNAME[06],2,Length(FormPl.RESNAME[06])) ('Счет БУ', , sci13Esc): Protect,PickButton;
 [f07] Substr(FormPl.RESNAME[07],2,Length(FormPl.RESNAME[07])) ('Счет БУ', , sci13Esc): Protect,PickButton;
 [f08] Substr(FormPl.RESNAME[08],2,Length(FormPl.RESNAME[08])) ('Счет БУ', , sci13Esc): Protect,PickButton;
 [f09] Substr(FormPl.RESNAME[09],2,Length(FormPl.RESNAME[09])) ('Счет БУ', , sci13Esc): Protect,PickButton;
 [f10] Substr(FormPl.RESNAME[10],2,Length(FormPl.RESNAME[10])) ('Счет БУ', , sci13Esc): Protect,PickButton;

buttons
  cmDoOk;
<<
  Балансовые счета для определения спец оснастки:

  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  <.    Ок    .>

>>
end;

TableEvent Table FormPl;
 cmUpdateRecord :
  {
   Update Current FormPl;
  };


 cmDoOk :
  {
   If UpdateTable
     CloseInterface(cmDefault);
  };
End;
//=======================================================================
//'ИНИЦИАЛИЗАЦИЯ ИНТЕРФЕЙСА
//-----------------------------------------------------------------------
Function asInitInter( p_cFormPl:Comp ) : Boolean;
{
 cFormPl:=p_cFormPl;
 asInitInter := getfirst FormPl = tsok;
}

//=======================================================================
//'ЗАВЕРШЕНИЕ РАБОТЫ С ИНТЕРФЕЙСОМ
//-----------------------------------------------------------------------
Function asDoneInter : Boolean;
{
 asDoneInter := True;
}

//=======================================================================
//'ПО КОМАНДЕ CMSETDEFAULT
//-----------------------------------------------------------------------
Procedure asOnCmSetDefault;
{
  if (FormPl.NRec<>0) update current FormPl;
}

//=======================================================================
//'ПРИ ВСТАВКЕ НАСТРОЙКИ В ШАБЛОН
//-----------------------------------------------------------------------
Procedure asOnSetWayAccou( p_cWayAccou:Comp );
{
  #__UNUSED__(p_cWayAccou)
}

function CheckTune: Boolean;// Проверка корректности
{
  CheckTune:= False;

  CheckTune:= True;
} // function CheckTune: Boolean

//*********************************************
HandleEvent         // от ИНТЕРФЕЙСА
//*********************************************

 cmInit :
  {
   If GetFirst FormPl <> tsOk
    {
     Message('Ошибка поиска алгоритма!');
     Abort;
    };
   if (not iPSManager.GetTunePlansSch(MyPlansNo))
    {
      Message('Ошибка инициализации плана счетов', Error);
      Abort;
      Exit;
    }
  };
 cmPick :
  {
   Case CurField Of
    #f01 : GetSSS(01);
    #f02 : GetSSS(02);
    #f03 : GetSSS(03);
    #f04 : GetSSS(04);
    #f05 : GetSSS(05);
    #f06 : GetSSS(06);
    #f07 : GetSSS(07);
    #f08 : GetSSS(08);
    #f09 : GetSSS(09);
    #f10 : GetSSS(10);
   end;
   update current formpl;
   rescanpanel(#formpl);
  }
 cmDelOnProtect :
  {
    Case CurField Of
    #f01 : {set FormPl.RESNAME[01]:=''; set FormPl.RESCOMP[01]  := 0;  }
    #f02 : {set FormPl.RESNAME[02]:=''; set FormPl.RESCOMP[02]  := 0;  }
    #f03 : {set FormPl.RESNAME[03]:=''; set FormPl.RESCOMP[03]  := 0;  }
    #f04 : {set FormPl.RESNAME[04]:=''; set FormPl.RESCOMP[04]  := 0;  }
    #f05 : {set FormPl.RESNAME[05]:=''; set FormPl.RESCOMP[05]  := 0;  }
    #f06 : {set FormPl.RESNAME[06]:=''; set FormPl.RESCOMP[06]  := 0;  }
    #f07 : {set FormPl.RESNAME[07]:=''; set FormPl.RESCOMP[07]  := 0;  }
    #f08 : {set FormPl.RESNAME[08]:=''; set FormPl.RESCOMP[08]  := 0;  }
    #f09 : {set FormPl.RESNAME[09]:=''; set FormPl.RESCOMP[09]  := 0;  }
    #f10 : {set FormPl.RESNAME[10]:=''; set FormPl.RESCOMP[10]  := 0;  }
   end;
   update current formpl;
   rescanpanel(#formpl);
  };
 cmDoOk :
  {
   If UpdateTable
     CloseInterface(cmDefault);
  };
end; //handleevent

end.  //'interface
