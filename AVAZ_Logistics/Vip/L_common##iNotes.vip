
#component "L_COMMON"
#include Notes.vih
#include FALBEEXTPBDF.vih
#include DOfuns.vih

#doc
Интерфейс содержит реализацию методов работы со статусами
#end
alter Interface iNotes;

overload
   function NotesObj.GetWorkDocNotes(pVidDoc : word) : Boolean;
   function NotesObj.GetVidNoteByVidDoc(pVidDoc : word) : word;
   function NotesObj.GetVidDocByVidNote(pVidNote : word; pDoc: comp) : word;
   function NotesObj.GetDocInfo(pVidDoc : word; pDoc: comp; var DocInf: TDocInfoS) : boolean;
end;

create view as select KatDoc.* from KatDoc;

Procedure ChkMyDoc(WDoc:word;sName:string);
var cNode:comp;
    verKatDoc,wSysNum:word;
begin
   PushPos(#KatDoc);
   if (GetFirst KatDoc where ((WDoc == KatDoc.TiDkGal)) = tsOk) Exit;
   if (GetFirst KatDoc where (('Складские операции' == KatDoc.Name (noindex))) <> tsOk) Exit;
   verKatDoc  := KatDoc.version;
   cNode      := KatDoc.nrec;
   wSysNum    := KatDoc.SysNum;
   ClearBuffer(#KatDoc);
   set KatDoc.SysNum    := wSysNum;
   set KatDoc.Version   := verKatDoc;

   set KatDoc.TiDkGal   := wDoc;
   set KatDoc.TiDkUsers := KatDoc.TiDkGal;
   set KatDoc.cNode     := cNode;
   set KatDoc.Name      := sName;
   set KatDoc.Direct    := SetDirectType(wDoc);
   insert current KatDoc;
   PopPos(#KatDoc);
end;

//******************************************************************************
// Возможность документа пользоваться системой статусов
function GetWorkDocNotes(pVidDoc : word) : Boolean;
{
  case pVidDoc of
  cgKB_Doc : {
       ChkMyDoc(cgKB_Doc,'Карта брака');
       Result := True;
       exit;
      }
  cgAct_on_Quality : {
       ChkMyDoc(cgAct_on_Quality,'Акт по качеству');
       Result := True;
       exit;
      }
  end;
 Result:=inherited::GetWorkDocNotes(pVidDoc);
}


//******************************************************************************
// Получить вид статуса по виду документа
function GetVidNoteByVidDoc(pVidDoc : word) : word;
{
  Result := 0;
  case pVidDoc of
     cgKB_Doc : {
        Result := cgKB_Doc;
       exit;
      }
     cgAct_on_Quality : {
        Result := cgAct_on_Quality;
       exit;
      }
  end;
  Result:=inherited::GetVidNoteByVidDoc(pVidDoc);
}

//******************************************************************************
// Получить вид документа по виду статуса
function GetVidDocByVidNote(pVidNote : word; pDoc: comp) : word;
{
  Result := 0;
  case pVidDoc of
     cgKB_Doc : {
       if ( GetFirst KatSopr where (( pDoc == KatSopr.nRec )) = tsOk )
          Result := KatSopr.VidSopr;
       exit;
      }
     cgAct_on_Quality : {
       if ( GetFirst KatSopr where (( pDoc == KatSopr.nRec )) = tsOk )
          Result := KatSopr.VidSopr;
       exit;
      }
  end;
  Result:=inherited::GetVidDocByVidNote(pVidNote,pDoc);
}

//******************************************************************************
// Получить номер и дату документа
function GetDocInfo(pVidDoc : word; pDoc: comp; var DocInf: TDocInfoS) : boolean;
var pOrg: comp;
{
  Result := False;

  pOrg := 0;

  ClearAdvRecord(DocInf);

  DocInf.SignN := 'Номер документа';
  DocInf.SignD := 'Дата документа';

  case pVidDoc of
   cgKB_Doc :
      {
        if ( GetFirst KatSopr where (( pDoc == KatSopr.nRec )) = tsOk )
          {
            Result := True;

            DocInf.NoDoc := KatSopr.NSopr;
            DocInf.dDoc  := KatSopr.dSopr;

            pOrg := KatSopr.cOrg;
          }
      }
   cgAct_on_Quality :
      {
        if ( GetFirst KatSopr where (( pDoc == KatSopr.nRec )) = tsOk )
          {
            Result := True;

            DocInf.NoDoc := KatSopr.NSopr;
            DocInf.dDoc  := KatSopr.dSopr;
          }
      }
   end;
   Result:=inherited::GetDocInfo(pVidDoc,pDoc,DocInf);
}
end.

//******************************************************************************
