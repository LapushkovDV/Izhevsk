#include AttrTablePick.vih
#include ExtAttr.vih
#include KauReff.vih
#Include Getkau.vih
#include UserReport.vih;

#Doc
 Интерфейса для ввода коэффициента текучести</Brief>
#End

Interface SFO_PLNSTAFFTURNOVER 'Ввод коэффициента текучести', escClose, cyan;
Show At (,,170,);
var
 WorkYear:word;
 iKauReff : EditKauReff;
 St:string;
#include ExtAttr.var
#Include GetKau.var
 /*
table struct SFO_PLNSTAFFTURNOVER (
 NREC  :COMP
,cPodr : comp
,Year : word
,PlanMes : array[1..12] of double
)
with index
(
  SFO_PLN01 = cPodr+Year
)
;
*/
table struct tPodr (
 cPodr : comp
,sPodr : string[20]
)
with index
(
  tPodr01 = sPodr+cPodr(Unique),
  tPodr02 = cPodr
)
;

Create view  t1
as select SFO_PLNSTAFFTURNOVER.*

from SFO_PLNSTAFFTURNOVER
, KatPodr,tPodr

Where
((
  tPodr.cPodr ==   KatPodr.nrec
  and
  tPodr.cPodr ==SFO_PLNSTAFFTURNOVER.cPodr
  and
  WorkYear  == SFO_PLNSTAFFTURNOVER.Year
))
;

function CalcI:double;
{
  Result:=(SFO_PLNSTAFFTURNOVER.PlanMes[01] +
           SFO_PLNSTAFFTURNOVER.PlanMes[02] +
           SFO_PLNSTAFFTURNOVER.PlanMes[03] +
           SFO_PLNSTAFFTURNOVER.PlanMes[04] +
           SFO_PLNSTAFFTURNOVER.PlanMes[05] +
           SFO_PLNSTAFFTURNOVER.PlanMes[06] +
           SFO_PLNSTAFFTURNOVER.PlanMes[07] +
           SFO_PLNSTAFFTURNOVER.PlanMes[08] +
           SFO_PLNSTAFFTURNOVER.PlanMes[09] +
           SFO_PLNSTAFFTURNOVER.PlanMes[10] +
           SFO_PLNSTAFFTURNOVER.PlanMes[11] +
           SFO_PLNSTAFFTURNOVER.PlanMes[12]);

}
function GetF(i:word):double;
{
  Result:=If(not isvalid(#SFO_PLNSTAFFTURNOVER),0,SFO_PLNSTAFFTURNOVER.PlanMes[i]);
}

procedure CheckF(i:word;ss:string);
{ var tval:double=double(ss);
  if getfirst fastfirstrow SFO_PLNSTAFFTURNOVER  <> tsok
    {
      ClearBuffer(#SFO_PLNSTAFFTURNOVER);
      set SFO_PLNSTAFFTURNOVER.cPodr   := KatPodr.nrec   ;
      set SFO_PLNSTAFFTURNOVER.Year    := WorkYear       ;
      insert current SFO_PLNSTAFFTURNOVER;
    }
  set SFO_PLNSTAFFTURNOVER.PlanMes[i]:=tval;
  update current SFO_PLNSTAFFTURNOVER;
  ReScanPanel(#tPodr);
}
Panel p1;
screen scR1;
Show At (,,,3);
  Table tPodr;
Fields
  WorkYear : noProtect, spinButton [1, 2000, 3000];
<<

 `Коэффициента текучести на ` .@@@@@@@@@@@ год

>>
end;




Browse br1 ('', hcNoContext, sci14Esc);
Show At (,4,,);
Table tPodr;

Fields
  KatPodr.kod               'Код','подразделения'  ('Подразделение') : [7],Protect,noPickButton,nodel,noAutoSize;
  KatPodr.name              'Название','подразделения'  ('Подразделение') : [30],browseText(St),Protect,noPickButton,nodel;
  [fPlanMes_01] GetF(01)    'Январь'    ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_02] GetF(02)    'Февраль'   ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_03] GetF(03)    'Март'      ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_04] GetF(04)    'Апрель'    ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_05] GetF(05)    'Май'       ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_06] GetF(06)    'Июнь'      ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_07] GetF(07)    'Июль'      ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_08] GetF(08)    'Август'    ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_09] GetF(09)    'Сентябрь'  ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_10] GetF(10)    'Октябрь'   ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_11] GetF(11)    'Ноябрь'    ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  [fPlanMes_12] GetF(12)    'Декабрь'   ('Месяц') : [10.2], browseAvg,NoProtect,noPickButton,noAutoSize;
  CalcI                     'Итого','с начала года'   ('Итого с начала года') : [10.2], browseAvg,Protect,Skip,noAutoSize;
  CalcI/12                  'Среднее'   ('Среднее') : [10.2], browseAvg,Protect,Skip,noAutoSize;
end; //br1

HandleEvent

cmExprFieldChanged:
 {
   case curfield of
    #fPlanMes_01 : CheckF(01,ExprFieldValue);
    #fPlanMes_02 : CheckF(02,ExprFieldValue);
    #fPlanMes_03 : CheckF(03,ExprFieldValue);
    #fPlanMes_04 : CheckF(04,ExprFieldValue);
    #fPlanMes_05 : CheckF(05,ExprFieldValue);
    #fPlanMes_06 : CheckF(06,ExprFieldValue);
    #fPlanMes_07 : CheckF(07,ExprFieldValue);
    #fPlanMes_08 : CheckF(08,ExprFieldValue);
    #fPlanMes_09 : CheckF(09,ExprFieldValue);
    #fPlanMes_10 : CheckF(10,ExprFieldValue);
    #fPlanMes_11 : CheckF(11,ExprFieldValue);
    #fPlanMes_12 : CheckF(12,ExprFieldValue);


   end;

}
cmCheckField:
 {
   case curfield of
    #WorkYear: ReScanPanel(#tPodr);
   end;
}


end;
end;




HandleEvent
cmInit:
  {
    ReadMyDSK(WorkYear,'SFO_PLNSTAFFTURNOVER_WorkYear',false);
    if WorkYear=0 then WorkYear:=Year(Cur_Date);
    St:='Среднее по заводу';
    insert into tPodr select KatPodr.nrec,KatPodr.kod  from KatKod where ((    cgKatKod_NormSFO == KatKod.wType  And KatKod.cOrg2   ==   KatPodr.nrec  ))  ignore_errors(tsDuplicateKey);
    delete tPodr where ((0==tPodr.cPodr));
  }
cmDone:
{
  SaveMyDSK(WorkYear,'SFO_PLNSTAFFTURNOVER_WorkYear');
}
end; // HandleEvent
End. // Interface


VipInterface UserReport_SFO_PLNSTAFFTURNOVER Implements IUserReport;

Interface UserReport_SFO_PLNSTAFFTURNOVER;

create view;

procedure Run;
begin
 RunInterface(SFO_PLNSTAFFTURNOVER);
end;
function GetReportName: String;
begin
  GetReportName := 'Ввод коэффициента текучести';
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := 'СФО';
  case Level of
    1 : GetGroupName := 'СФО';
  end;
end;

function GetPriority : Integer;
begin
  GetPriority := -100;
end;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '*';
end;
end.
