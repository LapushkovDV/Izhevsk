                : [24], QuickChoice;
//------------------------------------------------------------------------------
  [KatPar_Name]  sGetAttrID ( coSoprOrdB, SoprOrdB.nrec, cAttr_KatPar )     'Партия'     ('Партия', , sci1378Esc)
                : [24], Protect, PickButton;
//------------------------------------------------------------------------------
  PercentSumma    'Сумма'      ('Часть стоимости, распределяемое на данный разрез')
                : [17], [brForSopr_RVPrice, '\2p[|-]36`666`666`666`666.88'], noprotect, NoAutoSize;
//------------------------------------------------------------------------------
  Percent         'Процент'    ('Распределяемый на данный разрез процент от общего количества МЦ')
                : [8.3], noprotect, NoAutoSize;
//------------------------------------------------------------------------------
  SoprOrdB.Kol    'Количество' ('Количество МЦ, распределяемое на данный разрез')
                : [12], [prSignsInKol, '\3p[|-]36`666`666`666`666.888'], NoAutoSize;
//------------------------------------------------------------------------------
  SoprOrdB.Price  'Учетная','цена (НДЕ)'
                : [17], [brForSopr_Price, '\2p[|-]36`666`666`666`666.88'], NoAutoSize, Protect;
//------------------------------------------------------------------------------
  SoprOrdB.VPrice 'Учетная','Цена (вал)'
                : [17], [brForSopr_VPrice, '\2p[|-]36`666`666`666`666.88'], NoAutoSize, Protect;

  SaldTuneR.Name    'Объект ЦУ' ('',, sci1378Esc): [10], Protect, NoAutoSize, PickButton;
  vsKau1R           'КАУ 1'     ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;
  vsKau2R           'КАУ 2'     ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;
  vsKau3R           'КАУ 3'     ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;
  vsKau4R           'КАУ 4'     ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;
  vsKau5R           'КАУ 5'     ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;
  vsKau6R           'КАУ 6'     ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;
  vsKau7R           'КАУ 7'     ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;
  vsKau8R           'КАУ 8'     ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;
  vsKau9R           'КАУ 9'     ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;
  vsKau10R          'КАУ 10'    ('',, sci1378Esc): [12], Protect, NoAutoSize, PickButton;

end;
TableEvent  table SoprOrdB;
cmDeleteRecord:  {
  _tc:=0 ;
  if (CurTable = #SoprOrdB)   { _tc:=SoprOrdB.nrec;}
  If inherited::handleevent ( cmDeleteRecord ) <> heAbort then
  {
  if (CurTable = #SoprOrdB)
   {
    delete all specmtrr where  ((coSoprOrdB == specmtrr.coTable and _tc == specmtrr.cspec));
    delete all AttrvalD where ((coSoprOrdB == attrvald.wtable and _tc == attrvald.crec)) ;
   }
  }
}
 cmDelOnProtect:
 {
  Case CurField of
    #SaldTuneR.Name
  , #vsKau1R
  , #vsKau2R
  , #vsKau3R
  , #vsKau4R
  , #vsKau5R
  , #vsKau6R
  , #vsKau7R
  , #vsKau8R
  , #vsKau9R
  , #vsKau10R :
      if ( UpdateTable and isValid(#SoprOrdB) )
      {
/*
            if itsTaraM(SpSopr.cmcusl)  {
                //RereadRecord(#SpSopr);
              abort;exit;
            }
*/
        RunInterface('EditMtr2Spec_2', coSoprOrdB, SoprOrdB.NRec, cgPr_Auto, cgAct_Del, GetLinkMTRAutoPick(CurField));
        RereadRecord(#SoprOrdB);
      }
  #KatPar_Name :
   {
      if ( UpdateTable and isValid(#SoprOrdB) )
      {
        delete all AttrvalD where ((coSoprOrdB == attrvald.wtable and SoprOrdB.nrec == attrvald.crec and cAttr_KatPar == attrvald.cattrnam)) ;
        ReReadRecord ( #SoprOrdB );
      }
   }

  end;
  inherited::handleevent(cmDelOnProtect);
 }
end;

end;
HandleEvent


cmHotKeys:
 {
 case CurTable of
  #SoprOrdB:
    PutHotCommand(RunMenu('SoprDocbSpecifInfoSoprOrdB_AVAZ'));
  else
    PutHotCommand(RunMenu('SoprDocbSpecifInfo_AVAZ'));
  end;
 }
 cmValue1 :
 {
 _loop SoprOrdBP where ((SpSOpr.nrec == SoprOrdBP.cspsopr))
 {
  _tc := coGetAttr(coSoprOrdB,SoprOrdBP.nrec,VA_KATPAR);
   if _tc=0 then
     {
       _tc := oMakeParty.MakeNewParty(spsopr.nrec, ProtParty, AutoSetParty);
       if _tc<>0 then    {       coSetAttr(coSoprOrdB,SoprOrdBP.nrec,VA_KATPAR,_tc,#ShowKau(word(10),_tc));      }
     }
 }
  RescanPanel(#SoprOrdB);

 }
cmPick:
{
  Case CurField Of
   #KatPar_Name :
   {
      if ( UpdateTable and isValid(#SoprOrdB) )
      {
        refAttrTablePick.PickValue ( coSoprOrdB, cAttr_KatPar, SoprOrdB.nrec );
        ReReadRecord ( #SoprOrdB );
      }
   }
  #SaldTuneR.Name
  , #vsKau1R
  , #vsKau2R
  , #vsKau3R
  , #vsKau4R
  , #vsKau5R
  , #vsKau6R
  , #vsKau7R
  , #vsKau8R
  , #vsKau9R
  , #vsKau10R :
      if ( UpdateTable and isValid(#SoprOrdB) )
      {
/*  Сказали в распределении давать выбор ЦУ

            if itsTaraM(SpSopr.cmcusl)
             {

                _tcu:=coGetTune('AVTOVAZ.TARNMESTA_CU');
                if (not IsValid(#SaldTuneR)) then oMtrFun.LinkMtrToSpec(coSoprOrdB,SoprOrdB.nrec,_tcu);
                                            else if  (SaldTuneR.nrec<>_tcu)    then oMtrFun.LinkMtrToSpec(coSoprOrdB,SoprOrdB.nrec,_tcu);
                RescanPanel(#SoprOrdB);
                abort;exit;
             }
            else
*/

         {
           RunInterface('EditMtr2Spec_2', coSoprOrdB,SoprOrdB.nrec, cgPr_Auto, cgAct_Pick, GetLinkMTRAutoPick(CurField));
           RescanPanel(#SoprOrdB);
         }
      }
 end;
  If inherited::handleevent ( cmPick ) = heAbort then abort;
}

end;
end;

HandleEvent
 cmInit:
  {
    cAttr_KatPar:=ExtAttr_ID ( coSoprOrdB,VA_KatPar);
    If inherited::handleevent ( cmInit ) = heAbort then abort;
  }
end;
end.

