#component "L_SOPRDOC"
#define _SOPRDOCB_VIP
#include ShowKau.vpp            // declare с КАУ
#include AttrTablePick.vih
#include soprdocb.vih

Alter Interface SoprDocB;

table struct del_ordb
(
 crec:comp
);

OverloadFormats  brRaspred;

var _tcu,_tc,cAttr_KatPar:comp;
var refAttrTablePick: AttrTablePick;
var fPick:boolean;

Function  GetKAUFieldR(pNum : integer) : string; Forward;

create view as
select
  SaldTuneR.name
, GetKAUFieldR(1)  ( FieldName = vsKau1R )
, GetKAUFieldR(2)  ( FieldName = vsKau2R )
, GetKAUFieldR(3)  ( FieldName = vsKau3R )
, GetKAUFieldR(4)  ( FieldName = vsKau4R )
, GetKAUFieldR(5)  ( FieldName = vsKau5R )
, GetKAUFieldR(6)  ( FieldName = vsKau6R )
, GetKAUFieldR(7)  ( FieldName = vsKau7R )
, GetKAUFieldR(8)  ( FieldName = vsKau8R )
, GetKAUFieldR(9)  ( FieldName = vsKau9R )
, GetKAUFieldR(10) ( FieldName = vsKau10R )

from
  SaldTune SaldTuneR
 ,SpecMTR SpecMTRR
 ,SpecMTR SpecMTR_Chk
 ,Attrval AttrvalD
 ,del_ordb
 ,SoprOrdB SoprOrdBP
 ,SpSopr SpSopr_Chk
 ,SaldTune SaldTune_chk
where
 ((
     coSoprOrdB             == SpecMTRR.coTable
and  SoprOrdB.nRec          == SpecMTRR.cSpec
and  ( 0                    <> SpecMTRR.cSpec )
and  SpecMTRR.cSaldTune     == SaldTuneR.nRec

and  coSpSopr               == SpecMTR_Chk.coTable
and  SpSopr_Chk.nRec        == SpecMTR_Chk.cSpec
and  ( 0                    <> SpecMTR_Chk.cSpec )
and  SpecMTR_Chk.cSaldTune  == SaldTune_Chk.nRec

 ));


 Function GetKAUFieldR(pNum : integer) : string;
{
  Result := #ShowKau(if(pNum = 1, SaldTuneR.wObj, SaldTuneR.wKau[pNum - 1]), if(pNum = 1, SpecMTRR.cObj, SpecMTRR.cKau[pNum - 1]));
}


function itsTaraM(cc:comp):boolean;
{
  Result:= word(sGetAttr(coKatMc,cc,VA_TARAM))>0;
}


procedure GetTAP;
{
 if (SpSopr.cParty = 0)
  {
  if itsTaraM(spsopr.cmcusl) then
   {
           set SpSopr.cParty:=coGetTune('AVTOVAZ.TARNMESTA_PARTY');
           update current SpSopr;
   }
   else
   {
           set SpSopr.cParty:=FactoryPriceMakeParty;
           update current SpSopr;
           ModifyKatParty;
           Update Current KatParty;
           KatParty.Name := NameParty;
           Update Current KatParty;
           RunInterface('iKatPartydGodn', SpSopr.cParty, KatSopr.nRec);
           RunInterface('iKatPartyKATPARTYCENAZAV', SpSopr.nRec);
    }
  }
}

Window EditSopr;
Panel pnSpecif
Show (, 14, , 21);
Table SpSopr;

TableEvent  table SpSopr;
cmDeleteRecord:  {
  if (CurTable = #SpSopr)
    {
      delete all del_ordb;
      _loop SoprOrdB
       {
         ClearBuffer(#del_ordb);
         set del_ordb.crec:=SoprOrdB.nrec;
         insert current del_ordb;
       }
    }
  If inherited::handleevent ( cmDeleteRecord ) <> heAbort then
  {
  if (CurTable = #SpSopr)
   {
   _loop del_ordb
    {
     delete all specmtrr where  ((coSoprOrdB == specmtrr.coTable and del_ordb.crec == specmtrr.cspec));
     delete all AttrvalD where ((coSoprOrdB == attrvald.wtable and del_ordb.crec  == attrvald.crec)) ;
    }
   }
  }
}
end;

HandleEvent
  cmPick:
  {
  fPick:=false;
  Case CurField of
    #SaldTune.Name
  , #vsKau1
  , #vsKau2
  , #vsKau3
  , #vsKau4
  , #vsKau5
  , #vsKau6
  , #vsKau7
  , #vsKau8
  , #vsKau9
  , #vsKau10 :
      if ( UpdateTable and isValid(#SpSopr) )
      {
            if itsTaraM(SpSopr.cmcusl)
             {
                _tcu:=coGetTune('AVTOVAZ.TARNMESTA_CU');
                if (not IsValid(#SaldTune)) then oMtrFun.LinkMtrToSpec(coSpSopr,spsopr.nrec,_tcu);
                                            else if  (SaldTune.nrec<>_tcu)    then oMtrFun.LinkMtrToSpec(coSpSopr,spsopr.nrec,_tcu);
                RescanPanel(#SpSopr);
                abort;exit;
             }
      }
  #KatParty.Name, #KatParty.KOD, #KatParty.RNPT   :
    {
      if ( UpdateTable and isValid(#SpSopr) )
      {
            if itsTaraM(SpSopr.cmcusl)
             {
                _tc:= coGetTune('AVTOVAZ.TARNMESTA_PARTY');
//                _tcu:=coGetTune('AVTOVAZ.TARNMESTA_CU');
                if SpSopr.cparty=_tc then { abort;exit; }

             }
      }
    }
    #KatMC.Name,
    #KatMC.BarKod:  {delete all pick where ((word(7) == pick.wlist));fPick:=true;}
   end;
   case Inherited::HandleEvent(cmPick) of
      heAbort :  Abort;
      heStop  :  Exit;
   end;
  if fPick then
      {
       _loop pick where ((word(7) == pick.wlist))
        {
          _loop SpSopr_Chk where ((KatSopr.nrec == SpSopr_Chk.csopr and Pick.crec  == SpSopr_Chk.cmcusl and word(1)  == SpSopr_Chk.prmc))
          {
            if itsTaraM(SpSopr_Chk.cmcusl)
             {
              set SpSopr_Chk.cparty:=coGetTune('AVTOVAZ.TARNMESTA_PARTY');
              update current SpSopr_Chk;
              _tcu:=coGetTune('AVTOVAZ.TARNMESTA_CU');
               if (not IsValid(#SaldTune_chk)) then oMtrFun.LinkMtrToSpec(coSpSopr,SpSopr_Chk.nrec,_tcu);
                                            else if  (SaldTune_chk.nrec<>_tcu)    then oMtrFun.LinkMtrToSpec(coSpSopr,SpSopr_Chk.nrec,_tcu);
             }
             else
             {
              set SpSopr_Chk.cparty:=0;
              update current SpSopr_Chk;

             }

          }
        }
      }
 }
 cmDelOnProtect:
 {
  Case CurField of
    #SaldTune.Name
  , #vsKau1
  , #vsKau2
  , #vsKau3
  , #vsKau4
  , #vsKau5
  , #vsKau6
  , #vsKau7
  , #vsKau8
  , #vsKau9
  , #vsKau10 :
      if ( UpdateTable and isValid(#SpSopr) )
      {
            if itsTaraM(SpSopr.cmcusl)  {
                //RereadRecord(#SpSopr);
              abort;exit;
            }
      }
  end;
  inherited::handleevent(cmDelOnProtect);
 }
end;
end;
HandleEvent
cmValue50:
{
 RunInterface('AVAZ_Logistics::Avaz_PrintM4',KatSopr.NRec);
};
  cmGeneratePartys:{
    if (Not OtkatToOldState(True, CurCommand))
        Exit;
    Case CurTable of
      #SpSopr:
      {
           if (isNew)
           {
            Message('Не указана матценность!');
            Exit;
           }
           GetTAP;
           RescanPanel(#SpSopr);
           Exit;
      }
      #KatSopr:
      {
        PushPos(#SpSopr);
        _LOOP SpSopr where ((KatSopr.nRec == SpSopr.cSopr
          and 1 == SpSopr.PrMc ))
           {
             GetTAP;
           }
        PopPos(#SpSopr);
      }
    end;
    inherited::handleevent(cmGeneratePartys);
  }
  cmInit:
   {
    case Inherited::HandleEvent(cmInit) of
      heAbort :  Abort;
      heStop  :  Exit;
    end;
    SetTabbedSheetVisible(scKauEdit, false);
   }
end;
end;

Window SpecifInfo
Panel pnRaspred;
  show (, 18);
Browse brRaspred 'Распределение по складам' ('', hcZakupWNaklEditSpec, sci178Esc);
  Table SoprOrdB;

Fields
//------------------------------------------------------------------------------
  KatPodrOrd1_Name 'Склад'      ('Название склада, куда должна быть помещена МЦ', , sci1378Esc)
                : [24], QuickChoice;
