Interface SFO_POTR_REP 'Расчет потребности СФО', escClose, cyan;
Show at (,,50,14);

  var GValues: array [0..0] of String;
   var lValues: array [0..3] of String;
    var sValues: array [0..11] of string;
#include PersInfo.var


table struct tmpPriceGroup
(
  cgroup         : comp
 ,price : double
)
with index
(
  tmpPriceGroup01 = cgroup
)
;
table struct TmpOborot
(
  S         : string
 ,KPodr     : string[20]
 ,Brig      : string[50]
 ,Uch       : string[50]
 ,KDol      : string[20]
 ,NDol      : string[50]
 ,NomSFO    : string[20]
 ,NameSFO   : string[80]
 ,ED        : string[20]
 ,Norm11    : double
 ,Plan      : double
 ,Koef      : double
 ,Potr      : double
 ,Price     : double
 ,Summa     : double
)
with index
(
  TmpOborot01 = S
)
;






Create View
var 
  cCurPlanSch : comp;
   cper        : comp;    // период планирования
  DTB,DTE,PersPosDate,PersDisDate     : date;    //период формирования
  WorkYear,wCardLink:word;
  PriznPotr,PerPotr,Priz1,Priz2,i:word;
  sErrMessage: string;
  lErrMessageMode,lCountRow: longInt;
  sFileName,MegaS: string;
  i1,i2,i3,i4:double;
  _Uch,
  _Brig,
  _Post,
  _Podr,
  _Norm:comp;
  tKPodr
 ,tBrig
 ,tUch
 ,tKDol
 ,tNDol
 ,tNomSFO
 ,tNameSFO,tED:string;
 tNorm11
 ,tPlan
 ,tKoef
 ,tPotr
 ,tPrice
 ,tSumma:double;


From
   TmpOborot
  ,PersCard
  ,PersNorm
 , Catalogs
 , KatPodr
 , SpKau KatUch
 , BRIGAD KatBrig
 , NormSFO
 , PersSpec
 , GroupSFO
 , KatEd
 , tmpPriceGroup
 , KatMC KatMC_pr
 , sporder
 , SFO_PLN_STAFF
 , SFO_PLNSTAFFTURNOVER
where((
  word(0) << Perscard.status
  and
  PersCard.nrec == PersNorm.CPERSCARD
  and
  _Uch          == KatUch.nrec
  and
  _Brig         == KatBrig.nrec
  and
  _Post         == Catalogs.nrec
  and
  _Podr         == KatPodr.nrec
  and
  _Norm         == NormSFO.nrec
  and
  PersCard.nrec == PersSpec.cPersCard
  and
  PersNorm.nrec == PersSpec.cPersNorm
  and
  PersSpec.cGroupSFO == GroupSFO.nrec
  and
  GroupSFO.ced == kated.nrec

 ));


Panel pnParam;
NoTableNavigation;
screen scParam 'Расчет потребности СФО' (,,sci1Esc);
Fields
  WorkYear : NoProtect, SpinButton [1,2024,2100];
  PriznPotr : [ list 0 'годовая', 1 'квартальная',2 'месячная'];
  PerPotr   : [ list 0 '1-ый квартал', 1 '2-ой квартал',2 '3-ий квартал',3 '4-ый квартал'];
  Priz1 :NoProtect;
  Priz2 :NoProtect;
Buttons
  cmOk,,,'Сформировать отчет', , sci1Esc;
  cmCancel,,,'Выход', , sci1Esc;
<<

    `Год`     .@@@@@@@@@@@

    `Признак потребности` .@@@@@@@@@@@@@@@@@@

    `Период`     .@@@@@@@@@@@@@@@@@@@@@@@@@@@


      [.] Учитывать коэффициент текучести `

      [.] Сводная потребность `

    <.~С~формировать.>           <. ~О~тмена  .>

>>

end; //scrParam
End; //pnParam


function RangesIntersect(B1, E1, B2, E2: date): boolean;
{
   var Min: date;
   var Max: date;
   // наибольшая из дат начала
   Min := if(B1 > B2, B1, B2);
   // наименьшая из ненулевых дат окончания
   if Day(E1) = 0
     E1 := E2
   else
     if Day(E2) = 0
       E2 := E1;
   Max := if(E1 < E2, E1, E2);
   RangesIntersect := (Min <= Max) or (Day(Max) = 0);
}


Function ShowKauT(_wKau : Word; _cKau : Comp;T : word): String;
{
  Result := if (GetAnyKAU(cgAkSimple, _wKau, _cKau), GivenAnName(T), '');
}

function CheckInPutVars:boolean;
{
  result:=false;

  if (DTB=date(0,0,0) or DTE=date(0,0,0)) {
    message('Пожалуйста, укажите период.');

    exit;
  }

  result:=true;
}






function GetNorm11(td:double):double;
{
  Result:=1;
  Case word(Round(td,2)) of
   12:	Result:=1;
   24:	Result:=0.5;
   30:	Result:=0.4;
   36:	Result:=0.3;
   42:	Result:=0.2;
   48:	Result:=0.25;
   60:	Result:=0.16;

  end;
}

function GET_PLN_STAFF(i:word):double;
{
  Result:=0;
  if getfirst fastfirstrow SFO_PLN_STAFF where  ((
     _Post  == SFO_PLN_STAFF.cDolj
     And
     _Podr  == SFO_PLN_STAFF.cPodr
     And
     _Uch  == SFO_PLN_STAFF.cUchast
     And
     _Brig  == SFO_PLN_STAFF.cBrig
     And
     _Norm == SFO_PLN_STAFF.cNorma
     and
     WorkYear      == SFO_PLN_STAFF.Year
    )) =tsok
    then Result:= SFO_PLN_STAFF.PlanMes[i];

}

function GET_PLNSTAFFTURNOVER(i:word):double;
{
  if (Priz1=0) then {Result:=1;exit;}
  if getfirst fastfirstrow SFO_PLNSTAFFTURNOVER where  ((
     _Podr  == SFO_PLNSTAFFTURNOVER.cPodr
     and
     WorkYear      == SFO_PLNSTAFFTURNOVER.Year
    )) =tsok
    then Result:= SFO_PLNSTAFFTURNOVER.PlanMes[i];
  if Result=0 then  Result:=1;
}

function GetPricePrih:double;
var PR:double;
MaxD:date;
{
  Result:=0;
  if getfirst tmpPriceGroup where ((GROUPSFO.nrec == tmpPriceGroup.cgroup))<>tsok
   then
    {
      MaxD:=ZeroDate;PR:=0;
      _loop KatMC_pr where ((GROUPSFO.nrec == KatMC_pr.cgroupsfo))
      {
         if getlast sporder where ((word(0) == sporder.sp and word(0) == sporder.vidorder and  KatMC_pr.nrec == sporder.cmc and DTB >>= sporder.dord and (word(1) = sporder.tipord )))=tsok
       then
        {
          if MaxD< sporder.dord then {MaxD:=sporder.dord;Pr:=sporder.srprice;}
        }

      }
      ClearBuffer(#tmpPriceGroup);
      set tmpPriceGroup.cgroup:= GROUPSFO.nrec;
      set tmpPriceGroup.price := Pr;
      insert current tmpPriceGroup;
    }

  Result:=tmpPriceGroup.Price;
}

function GetData:boolean;
{
 Result:=true;
 delete all TmpOborot;
 delete all tmpPriceGroup;
 wCardLink := wGetTune('Fin.SFO.PersCardLink');
 StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Анализ данных...',0);
 i1:=i2:=i3:=i4:=0;
 _loop  PersCard
 {
   if not NextVisual then
    {
     Result:=false;
     StopVisual('',0);
     exit;
    }
   PersPosDate := iPersInfo.GetPosDate(if (wCardLink = 0, PersCard.cLSchet, PersCard.cPersons), wCardLink + 1);
   PersDisDate := PersCard.DISDATE;
   if (not RangesIntersect(DTB,DTE,PersPosDate,PersDisDate))  continue;
   _loop PersNorm
   {

     if (not RangesIntersect(DTB,DTE,PersNorm.frDate,PersNorm.toDate))  continue;
       _Uch :=coGetAttr ( coPersCard, PersCard.nrec, VA_SO_UCH );
       _Brig:=coGetAttr ( coPersCard, PersCard.nrec, VA_SO_BRIG );
       _Post:=PersCard.CPOST;
       _Podr:=PersCard.CPODR;
       _Norm:=PersNorm.CNORMSFO;
       tKPodr:=tBrig:=tUch:=tKDol:=tNDol:=tNomSFO:=tNameSFO:=tED:='';


       if getfirst fastfirstrow Catalogs=tsok then
           {
            tKDol:=Catalogs.code ; tNDol:= Catalogs.name;
           }
       if getfirst fastfirstrow KatPodr =tsok then
           {
            tKPodr:=KatPodr.kod;
           }
       if getfirst fastfirstrow KatUch  =tsok then
           {
            tUch:=KatUch.name;
           }
       if getfirst fastfirstrow KatBrig =tsok then
           {
            tBrig:=KatBrig.NMBRIG;
           }
   //    if getfirst fastfirstrow NormSFO =tsok then
   //        {
   //         tKPodr:=tKPodr+' # '+perscard.CARDNOM+' # '+ NormSFO.name;
   //        }
       _loop PersSpec
       {
        tNomSFO:=tNameSFO:=tED:='';
        tNorm11:=tPlan:=tKoef:=tPotr:=tPrice:=tSumma:=0;
        if getfirst fastfirstrow GROUPSFO =tsok then
           {
            tNomSFO:=GROUPSFO.KOD;tNameSFO:=GROUPSFO.NAME;
           }
        if getfirst fastfirstrow KatEd =tsok then
           {
            tED:=KatEd.abbr;
           }

        if Priz2=1 then
            {
             MegaS:=tNomSFO;  tKPodr:=tBrig:=tUch:=tKDol:=tNDol:='';
            }
            else
            {
             MegaS:=tKPodr+'#'+string(_Podr)+'#'+tBrig+'#'+tUch+'#'+tKDol+'#'+tNomSFO;
            }


         tNorm11:=GetNorm11(PERSSPEC.SROK);

         for (i := Month(DTB); i<=Month(DTE); i := i+1)
            tPlan:= tPlan+GET_PLN_STAFF(i);

         var tMes:word=0;
         for (i := Month(DTB); i<=Month(DTE); i := i+1)
            {tKoef:= tKoef+ GET_PLNSTAFFTURNOVER(i);inc(tMes)};
         if tMes<>0 then tKoef:=tKoef/ tMes;

         for (i := Month(DTB); i<=Month(DTE); i := i+1)
          {
            tPotr:= tPotr+ tNorm11*GET_PLN_STAFF(i)*GET_PLNSTAFFTURNOVER(i);
      //      message('tNameSFO='+tNameSFO+' tPotr = '+string(tPotr)+' tNorm11 = '+string(tNorm11)+' GET_PLN_STAFF(i) = '+string(GET_PLN_STAFF(i))+' GET_PLNSTAFFTURNOVER(i) = '+string(GET_PLNSTAFFTURNOVER(i))+'     '+string(i));
          }
         tPrice:=GetPricePrih;

         tSumma:= tPrice*tPotr;
         i1:=i1+tPlan;
         i2:=i2+tPotr;
         i3:=i3+tSumma;



         if getfirst TmpOborot where ((
                             MegaS == TmpOborot.S
                                      ))=tsok then
              {
               set TmpOborot.Plan       :=  TmpOborot.Plan+tPlan         ;
               set TmpOborot.Koef       :=  (TmpOborot.Koef+tKoef)/2         ;
               set TmpOborot.Potr       :=  TmpOborot.Potr+tPotr         ;
               set TmpOborot.Summa      :=  TmpOborot.Summa+tSumma        ;
               set TmpOborot.Price      :=  TmpOborot.Summa/TmpOborot.Potr        ;
               update current TmpOborot;
              }

            else
             {
               ClearBuffer(#TmpOborot);
               set TmpOborot.S          :=  MegaS            ;
               set TmpOborot.KPodr      :=  tKPodr        ;
               set TmpOborot.Brig       :=  tBrig         ;
               set TmpOborot.Uch        :=  tUch          ;
               set TmpOborot.KDol       :=  tKDol         ;
               set TmpOborot.NDol       :=  tNDol         ;
               set TmpOborot.NomSFO     :=  tNomSFO       ;
               set TmpOborot.NameSFO    :=  tNameSFO      ;
               set TmpOborot.ED         :=  tED           ;
               set TmpOborot.Norm11     :=  tNorm11       ;
               set TmpOborot.Plan       :=  tPlan         ;
               set TmpOborot.Koef       :=  tKoef         ;
               set TmpOborot.Potr       :=  tPotr         ;
               set TmpOborot.Price      :=  tPrice        ;
               set TmpOborot.Summa      :=  tSumma        ;
               insert current TmpOborot;
             }


       }
   }


 }
 lCountRow := RecordsInTable(#TmpOborot);
 if lCountRow<=0 then Result:=false;
 StopVisual('',0);
}

#include ExFunc.vpp;

procedure PrintData;
{

 var lColLast,lBegRow,lColNo,lRowNo:longint;
 lColLast  := if(Priz1=1, 15,15);
 lRowNo    := 4;

 var sTemplateName: string =  TranslatePath(StartPathName+'XLS\AVAZ\sfo_potr_rep.xlsx');

 StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Печать отчета',lCountRow);
 _try
  {
  CreateExcelWithTemplate(sTemplateName);

  _try
   {

  SetCellStringValue('[' + UserName +' '+ _DateTimeToStr(_CurDateTime,'DD/MM/YY HH:NN') + ']',1,1);
  SetCellStringValue('Расчет потребности СИЗ, период '+DateToStr(DTB,'DD.MM.YYYY')+' - '+DateToStr(DTE,'DD.MM.YYYY')+if(Priz1=1,', учитывать коэффициент текучести',''),2,1);

     lColNo:= 0;
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);
     inc(lColNo); SetCellNumberValue(i1                                      ,lRowNo,lColNo);
     inc(lColNo);
     inc(lColNo); SetCellNumberValue(i2                                      ,lRowNo,lColNo);
     inc(lColNo);
     inc(lColNo); SetCellNumberValue(i3                                      ,lRowNo,lColNo);
     lRowNo++;

    _loop TmpOborot
    {
     if not NextVisual then continue;
     lColNo:= 0;
     inc(lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.KPodr                                      ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.Brig                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.Uch                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.KDol                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.NDol                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.NomSFO                                     ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.NameSFO                                    ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.ED                                         ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.Norm11                                     ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.Plan                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.Koef                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.Potr                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.Price                                      ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.Summa                                      ,lRowNo,lColNo);

    // i1:= i1+ TmpOborot.Plan;

     lBegRow:= lRowNo;
     lRowNo++;

    }
     lColNo:= 0;
  //   inc(lColNo); SetCellStringValue('Итого за период '+fPer                                     ,lRowNo,lColNo);
     xlSetFontStyle(xlBold,4,1,4,lColLast);
     if Priz2=1 then
         xlDeleteRange(xlShiftToLeft ,1,2,lRowNo,6)
    //      xlRunMacro('delcol()');
    //    if upcase(UserName) = upcase('koltsov') then PuttableToDBF(#TmpOborot,'TmpOborot_1.dbf',ptfFullTable);


}
  _finally
   {
    StopVisual;
   }
  }
  _except
    on ExExcelFatalError:
     {
      StopVisual;
      message(sErrMessage, lErrMessageMode);
     }
  _finally
    {

    xlKillExcel;
    if VisualizationActive() then StopVisual('', 0);
    }

}

HandleEvent
//----------------------

cmInit:
{



  GValues[0] := 'Год';



  lValues[0] := '1-ый квартал';
  lValues[1] := '2-ой квартал';
  lValues[2] := '3-ий квартал';
  lValues[3] := '4-ый квартал';






  sValues[0] := 'Январь';
  sValues[1] := 'Февраль';
  sValues[2] := 'Март';
  sValues[3] := 'Апрель';
  sValues[4] := 'Май';
  sValues[5] := 'Июнь';
  sValues[6] := 'Июль';
  sValues[7] := 'Август';
  sValues[8] := 'Сентябрь';
  sValues[9] := 'Октябрь';
  sValues[10] := 'Ноябрь';
  sValues[11] := 'Декабрь';





  if not ReadMyDsk(WorkYear, 'SFO_POTR_REP_WorkYear',true) WorkYear:=Year(Cur_date);
  ReadMyDsk(PriznPotr, 'SFO_POTR_REP_PriznPotr',true);
  ReadMyDsk(PerPotr, 'SFO_POTR_REP_PerPotr',true);
  ReadMyDsk(Priz1, 'SFO_POTR_REP_Priz1',true);
  ReadMyDsk(Priz2, 'SFO_POTR_REP_Priz2',true);

  case  PriznPotr of
    0:   SetEnumList(scParam, #PerPotr, gValues);
    1:   SetEnumList(scParam, #PerPotr, lValues);
    2:   SetEnumList(scParam, #PerPotr, sValues);
  end;
}
cmCheckField:{
if CurField=#PriznPotr then
 {
  case  PriznPotr of
    0:   SetEnumList(scParam, #PerPotr, gValues);
    1:   SetEnumList(scParam, #PerPotr, lValues);
    2:   SetEnumList(scParam, #PerPotr, sValues);
  end;
  PerPotr:=0;
 }
}

cmOk:
{
  case  PriznPotr of
   0: {
      DTB:=date(1,1,WorkYear);
      DTE:=date(31,12,WorkYear);
    }
   1: {
       case PerPotr of
        0:{
           DTB:=date(1,1,WorkYear);
           DTE:=date(31,03,WorkYear);

        }
        1:{
           DTB:=date(1,4,WorkYear);
           DTE:=date(30,06,WorkYear);

        }
        2:{
           DTB:=date(1,7,WorkYear);
           DTE:=date(30,09,WorkYear);

        }
        3:{
           DTB:=date(1,10,WorkYear);
           DTE:=date(31,12,WorkYear);

        }

       end;
    }
   2: {
      DTB:=date(1,PerPotr+1,WorkYear);
      DTE:=date(Last_Day(DTB),PerPotr+1,WorkYear);
    }
  end;

  If(Not GetData)
  {
    message('Нет данных за указанный период! '+DateToStr(DTB,'DD.MM.YYYY')+' - '+DateToStr(DTE,'DD.MM.YYYY'));
    exit;
  }
  

  PrintData;
}
//---------------------------
cmPick:{

} //cmPick:

//---------------------------
cmDelOnProtect:{

}

//---------------------------

cmDone:{
  SaveMyDsk(WorkYear, 'SFO_POTR_REP_WorkYear');
  SaveMyDsk(PriznPotr, 'SFO_POTR_REP_PriznPotr');
  SaveMyDsk(PerPotr, 'SFO_POTR_REP_PerPotr');
  SaveMyDsk(Priz1, 'SFO_POTR_REP_Priz1');
  SaveMyDsk(Priz2, 'SFO_POTR_REP_Priz2');
}

end;

End.

VipInterface UserReport_SFO_POTR_REP Implements IUserReport;

Interface UserReport_SFO_POTR_REP;

create view;

