begin
 RunInterface(SFO_POTR_REP);
end;
function GetReportName: String;
begin
  GetReportName := 'Расчет потребности СФО';
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := 'СФО';
  case Level of
    1 : GetGroupName := 'СФО';
  end;
end;

function GetPriority : Integer;
begin
  GetPriority := -100;
end;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '*';
end;
end.
