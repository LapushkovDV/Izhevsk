{
- 'Сохранить объект в буфер'   , cmSaveDoc   , 'Сохранить объект в буфер'              , hcctxSoprSaveDoc   , 'Ctrl+F2', kbCtrlF2, sci1Esc,,,,bmpCopyDoc;
- 'Копировать объект из буфера', cmRestoreDoc, 'Копировать сохраненный в буфере объект', hcctxSoprRestoreDoc, 'Ctrl+F3', kbCtrlF3, sci1Esc,,,,bmpPasteDoc;
}

