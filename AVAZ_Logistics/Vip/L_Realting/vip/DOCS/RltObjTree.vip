#include ZemComplAttr.vih
#include PlaceAttr.vih
#include BuildingAttr.vih
#include FloorAttr.vih
#include HouseAttr.vih
#include RoomAttr.vih
#include CustomAttr.vih
#include RltObjsOnStatus.vih
#include rltCOTree.vih
#include RltObjCopyPaste.vih
#include RltRentHist.vih

#include rltTree.han

#doc
Интерфейс иерархического представления объектов недвижимости
#end
Interface VipRltObjTree 'Объекты недвижимости' (,hcNedvigWindow,) EscClose, Cyan;
  Show At (,,140,33);

var
  oCopyPaste : RltObjCopyPaste;
  oCoIer     : VipRltCOTree;
  pRent      : RltRentHistory;

Create view

Var
  CurGroup,
  UpCurGroup : comp;
  CurObjVid  : word;
  pObj       : comp;
  wVidObj    : word;

As select
  *

From
  rltObjTree
, rltObjTree rltObjChild
, rltObjTree rltObjOwner
, rltObjTree rltObjTree2
, rltRooms
, rltPlaces
, rltCustoms

Where
((

    CurGroup          == rltObjTree.cOwner
and rltObjTree.nRec   == rltObjChild.cOwner
and rltObjTree.cOwner == rltObjOwner.nRec
and rltObjTree.cObj   == rltRooms.nRec
and rltObjTree.cObj   == rltPlaces.nRec
and rltObjTree.cObj   == rltCustoms.nRec

))

Order by rltObjTree.SortName

;

Parameters wVidObj, pObj;

Function GetObjColor(pObj : comp; wVidObj : word; dDate : date): word;
var
  ObjStatus: integer;
{
  ObjStatus := pRent.GetRentStatus(pObj, wVidObj, dDate);

  Result := if((ObjStatus = 3) or (ObjStatus = 0), ColorSysRed, if(ObjStatus = 1, ColorSysGreen, 0));
}

var oObjRef     : array [1..6] of tRltObjCommon;
var oPlacesRent : tRltObjsOnStatus;

TabbedSheet TOP tshMain;
  Show At (,,50,);

Tree trRltObjects 'Иерархия объектов недвижимости' (,,sci178EscTreeA); WideOffset, DottedLines, LinesAtRoot;
Table rltObjTree;
Fields
/*
  Объект не используется (статус 0 или 3)       - шрифт красный
  Объект арендуется      (статус 1)             - шрифт зеленый
  Объект закреплен за подразделением (статус 2) - шрифт обычный
  Жирным выделяются объекты
*/
  {
    Font = {
             Color = GetObjColor(rltObjTree.cObj, rltObjTree.VidObj, Cur_Date);
             Bold  = (pRent.GetRentStatus(rltObjTree.cObj, rltObjTree.VidObj, Cur_Date) > -1)
           }
  };
  rltObjTree.SortName 'Объект' ('Выделение цветом: зеленый - "аренда"; красный - "не используется"'): protect;
end;

Embedded emIerOnCO 'Объекты недвижимости по ЦО' Interface oCoIer;
end;

end; // TabbedSheet

Embedded emAttrs interface;
  Show At (51,,,);
end;

procedure CheckInitedCurrentObj(wVidObj : word); forward;

procedure doSetPosition(pObj : comp; wVidObj : word);
{
  CheckInitedCurrentObj(wVidObj);

  if (wVidObj = roPlaces)
    oPlacesRent.SetPosition(pObj, roPlace)
  else
    if (wVidObj >= 10)
      tRltObjCommon(oObjRef[wVidObj div 10]).SetPosition(pObj);

}

procedure doEmbeddedInterface(wVidObj : word);
{
  CheckInitedCurrentObj(wVidObj);

  if (wVidObj = roPlaces)
    BindEmbeddedInterface(emAttrs, oPlacesRent, 'wPlaceRent')
  else
    if (wVidObj >= 10)
      BindEmbeddedInterface(emAttrs, oObjRef[wVidObj div 10], 'wMain');
}

procedure AfterInsertObj(pOwner, pObj : comp; wVidObj : word; sName : string);
var pPos : comp;
{
  insert rltObjTree set rltObjTree.cOwner   := pOwner,
                        rltObjTree.cObj     := pObj,
                        rltObjTree.VidObj   := wVidObj,
                        rltObjTree.SortName := sName;

  pPos := rltObjTree.nRec;
  case wVidObj of
    roZemCompl :
      {
        insert rltObjTree set rltObjTree.cOwner   := pPos,
                              rltObjTree.cObj     := pObj,
                              rltObjTree.VidObj   := roPlaces,
                              rltObjTree.SortName := 'Благоустроенная территория';
        insert rltObjTree set rltObjTree.cOwner   := pPos,
                              rltObjTree.cObj     := pObj,
                              rltObjTree.VidObj   := roBuildings,
                              rltObjTree.SortName := 'Здания и сооружения';
      }
    roFloor :
      {
        insert rltObjTree set rltObjTree.cOwner   := pPos,
                              rltObjTree.cObj     := pObj,
                              rltObjTree.VidObj   := roHouses,
                              rltObjTree.SortName := 'Помещения';
        insert rltObjTree set rltObjTree.cOwner   := pPos,
                              rltObjTree.cObj     := pObj,
                              rltObjTree.VidObj   := roRooms,
                              rltObjTree.SortName := 'Комнаты/Площади';
      }
  end;
  CurGroup := pOwner;
  TreeJumpToRecord(trRltObjects, pPos);
  case wVidObj of
    roRoom  : RereadRecord(#rltRooms);
    roPlace : RereadRecord(#rltPlaces);
    roCustom: RereadRecord(#rltCustoms);
  end;

  RereadRecord(#rltObjTree);
  doSetPosition(pObj, wVidObj);
  doEmbeddedInterface(wVidObj);
  SelectFormat(emAttrs);
}

procedure AfterUpdateObj(pRltOwner, pObj : comp; wVidObjOwner, wVidObj : word; sName : string);
var
  pOwner, pPos : comp;
{
  if (GetFirst rltObjTree2
         where (( wVidObjOwner == rltObjTree2.VidObj and
                  pRltOwner    == rltObjTree2.cObj )) = tsOK)
    pOwner := rltObjTree2.nRec
  else
    pOwner := 0;
  if (rltObjOwner.VidObj <> wVidObjOwner)
  // нужно отредактировать не текущую запись
  // например, стоим на комнате в помещении,
  // а редактируем фактический номер комнаты вне помещения
    _loop rltObjTree2 where (( pObj    == rltObjTree2.cObj and
                               wVidObj == rltObjTree2.VidObj ))
      {
        if (rltObjTree2.cOwner <> rltObjTree.cOwner)
          {
            update current rltObjTree2 set rltObjTree2.cOwner   := pOwner,
                                           rltObjTree2.SortName := sName;
            Break;
          }
      }
  else
  // редактируем текущую запись
    {
      pPos := rltObjTree.nRec;

      update rltObjTree where (( pPos == rltObjTree.nRec ))
        set rltObjTree.cOwner   := pOwner,
            rltObjTree.SortName := sName;

      CurGroup := pOwner;
      TreeJumpToRecord(trRltObjects, pPos);
    }

  ReScanPanel(#rltObjTree);
  RereadRecord(#rltObjTree);
}

procedure AfterModifyStatus;
{
  ReScanPanel(#rltObjTree);
  RereadRecord(#rltObjTree);
}

procedure SetOwnerPosition(pRltOwner, pObj : comp; wVidObjOwner, wVidObj : word);
var pOwner : comp;
{
  if (GetFirst rltObjTree2
         where (( wVidObjOwner == rltObjTree2.VidObj and
                  pRltOwner    == rltObjTree2.cObj )) = tsOK)
    {
      pOwner := rltObjTree2.nRec;

      if (GetFirst rltObjTree2
             where (( wVidObj == rltObjTree2.VidObj and
                      pObj    == rltObjTree2.cObj )) = tsOK)
        {
          CurGroup := pOwner;
          TreeJumpToRecord(trRltObjects, rltObjTree2.nRec);

          ReScanPanel(#rltObjTree);
          RereadRecord(#rltObjTree);
        }
    }
}

procedure CheckInitedCurrentObj(wVidObj : word);
var oRltObj: tRltObjCommon;
{
  case wVidObj of
  //***********************************************************
    roPlaces:
      if NullVipRef(oPlacesRent)
        LoadVipRef(oPlacesRent, 'RltObjsOnStatus');
  //***********************************************************
    roZemCompl
  , roPlace
  , roBuilding
  , roFloor
  , roRoom
  , roHouse
  , roCustom
    :
      if NullVipRef(oObjRef[wVidObj div 10])
        {
          StartNewVisual(vtRotateVisual, vfScreenBottom + vfTimer, 'Инициализация объекта ...', 0);
          case wVidObj of
            roZemCompl : oRltObj := tRltObjCommon(new(ZemComplAttr));
            roPlace    : oRltObj := tRltObjCommon(new(PlaceAttr));
            roBuilding : oRltObj := tRltObjCommon(new(BuildingAttr));
            roFloor    : oRltObj := tRltObjCommon(new(FloorAttr));
            roRoom     : oRltObj := tRltObjCommon(new(RoomAttr));
            roHouse    : oRltObj := tRltObjCommon(new(HouseAttr));
            roCustom   : oRltObj := tRltObjCommon(new(CustomAttr));
          end;

          if NullVipRef(oRltObj)
            message('Ошибка загрузки объектного интерфейса. Тип ' + string(wVidObj), Warning)
          else
            {
              BindEvent(AfterInsertObj   , oRltObj.AfterInsertObj);
              BindEvent(AfterUpdateObj   , oRltObj.AfterUpdateObj);
              BindEvent(AfterModifyStatus, oRltObj.AfterModifyStatus);
              BindEvent(SetOwnerPosition , oRltObj.SetOwnerPosition);
              oObjRef[wVidObj div 10] := oRltObj;
              tRltObjCommon(oObjRef[wVidObj div 10]).SetMainEditWin;
            }

          StopVisual('', 0);
        }
  //***********************************************************
  end;
}

#rltTreeTypeFuncs

Panel pObjTree;
Table rltObjTree;

HandleEvent
  cmIdle :
  {
    if IsValid(#rltObjTree)
      {
        CheckInitedCurrentObj(rltObjTree.VidObj);

        if (CurObjVid <> rltObjTree.VidObj)
          {
            CurObjVid := rltObjTree.VidObj;
            UnBindEmbeddedInterface(emAttrs);
            if ((rltObjTree.VidObj >= 10) or (rltObjTree.VidObj = roPlaces))
              doEmbeddedInterface(rltObjTree.VidObj);
          }
        if ((rltObjTree.VidObj >= 10) or (rltObjTree.VidObj = roPlaces))
          doSetPosition(rltObjTree.cObj, rltObjTree.VidObj);
      }
    else
      {
        CurObjVid := 0;
        UnBindEmbeddedInterface(emAttrs);
      }
  }

  cmAltInsert :
  {
    case rltObjTree.VidObj of
      roCustom :
        if ( rltObjTree.cOwner = 0 )
          {
            CheckInitedCurrentObj(roCustom);
            tRltObjCommon(oObjRef[roCustom div 10]).doInsertObj(rltObjTree.cObj, rltObjTree.nRec);
          }
    end;
  }

  cmAddNewRec :
  {
    var wVidObj : word;
    var pNewObj, pOwner, pRltOwner : comp;
    var sName : string;

    if not IsValid(#rltObjTree)
      {
        case RunMenu('mnuNewCustomObjRlt') of
          cmValue1 : // 'Земельный участок'
            wVidObj := roZemCompl;
          cmValue2 : // 'Нестандартный объект'
            wVidObj := roCustom;
        else
          Exit;
        end;

        pOwner    := 0;
        pRltOwner := 0;
      }
    else
      {
        case rltObjTree.VidObj of
          roPlaces, roBuildings, roHouses, roRooms :
            {
              wVidObj   := rltObjTree.VidObj*10;
              pOwner    := rltObjTree.nRec;
              pRltOwner := rltObjTree.cObj;
            }
          roFloor, roPlace, roHouse :
            {
              wVidObj   := rltObjTree.VidObj;
              pOwner    := rltObjTree.cOwner;
              pRltOwner := rltObjOwner.cObj;
            }
          roRoom :
            {
              wVidObj   := rltObjTree.VidObj;
              pOwner    := rltObjTree.cOwner;
              pRltOwner := rltObjOwner.cObj;

              if ( ( rltRooms.cHouse <> 0 ) AND ( rltObjOwner.VidObj = roHouse ) )
                if (GetFirst rltObjTree2 where (( rltObjOwner.cOwner == rltObjTree2.nRec )) = tsOK)
                  pRltOwner := rltObjTree2.cObj;
            }
        else //roZemCompl, roBuilding
          {
            wVidObj   := rltObjTree.VidObj;
            pOwner    := rltObjTree.cOwner;
            pRltOwner := 0;

            case wVidObj of
              roBuilding :
                {
                  case RunMenu('mnuNewObjRlt') of
                    cmValue1 : // 'Здание/сооружение'
                      {
                        wVidObj   := roBuilding;
                        pRltOwner := rltObjOwner.cObj;
                      }
                    cmValue2 : // 'Этаж'
                      {
                        wVidObj   := roFloor;
                        pRltOwner := rltObjTree.cObj;
                        pOwner    := rltObjTree.nRec;
                      }
                  else
                    Exit;
                  end;
                }
              roZemCompl
            , roCustom
               :
                {
                  if ( rltObjTree.cOwner <> 0 )
                    pRltOwner := rltObjOwner.cObj
                  else
                    case RunMenu('mnuNewCustomObjRlt') of
                      cmValue1 : // 'Земельный участок'
                        wVidObj := roZemCompl;
                      cmValue2 : // 'Нестандартный объект'
                        wVidObj := roCustom;
                    else
                      Exit;
                    end;
                }
            end;
          }
        end;
      }

    if (wVidObj >= 10)
      {
        CheckInitedCurrentObj(wVidObj);
        tRltObjCommon(oObjRef[wVidObj div 10]).doInsertObj(pRltOwner, pOwner);
      }
  }

  // Тиражирование
  cmValue3 :
  {
    RunInterface('ObjReplicator', rltObjTree.buffer);

    RereadRecord(#rltRooms);
    RereadRecord(#rltObjTree);
    PutCommand(cmIdle);
  }

  cmDelete :
  {
    if IsValid(#rltObjTree)
      if (rltObjTree.VidObj >= 10)
        {
          CheckInitedCurrentObj(rltObjTree.VidObj);
          if tRltObjCommon(oObjRef[rltObjTree.VidObj div 10]).doDeleteObj(rltObjTree.cObj)
            {
              delete safe rltObjChild;
              delete rltObjTree2 where (( rltObjTree.VidObj == rltObjTree2.VidObj and
                                          rltObjTree.cObj   == rltObjTree2.cObj ));
              RereadRecord(#rltObjTree);
              PutCommand(cmIdle);
            }
        }
  }

  #trlTreeCmdHandler

end;
end;

Function OnPositionChanged(_pObj : comp; _wVidObj : word; pPos : comp) : boolean;
{
  OnPositionChanged := false;

  if (pPos = 0)
    {
      if (GetFirst rltObjTree
             where (( _pObj == rltObjTree.cObj and _wVidObj == rltObjTree.VidObj )) <> tsOK)
        Exit;
    }
  else
    if (GetFirst rltObjTree where (( pPos == rltObjTree.nRec )) <> tsOK)
      Exit;

  OnPositionChanged := true;

  if (CurObjVid <> _wVidObj)
    UnBindEmbeddedInterface(emAttrs);

  CurObjVid := _wVidObj;
  CurGroup  := rltObjTree.cOwner;

  TreeJumpToRecord(trRltObjects, rltObjTree.nRec);
  doEmbeddedInterface(rltObjTree.VidObj);
  doSetPosition(rltObjTree.cObj, rltObjTree.VidObj);
}

// Реализация метода объектного интерфейса IPasteConfirm для получения подтверждений от пользователя
// для управления режимами работы copy/paste объектов.
// Функция должна возвращать true, если при вставке скопированного объекта необходимо также копировать
// все подчиненные объекты.
Public Function RequestToCopyChildObjects(_srcObject: type$RltObjTree): boolean;
{
  #__UNUSED__(_srcObject)

  result := Message('Копировать подчиненные объекты?', Confirmation + yesNo) = cmYes;
}

HandleEvent

  cmInit :
  {
    BindEvent(OnPositionChanged , oCoIer.OnPositionChanged);

    UpCurGroup := 0;

    if (pObj <> 0)
      {
        if OnPositionChanged(pObj, wVidObj, 0)
          tRltObjCommon(oObjRef[wVidObj div 10]).SetAttrsEditWin
        else
          {
            message('Не найден объект недвижимости (cObj='+string(pObj)+', VidObj='+string(wVidObj)+')', Information);
            Abort;
            Exit;
          }
      }
    else
      {
        CurObjVid := 0; CurGroup := 0;
        TreeGetFirst(trRltObjects);
        PutCommand(cmIdle);
      }
  }

  cmDone :
  {
    var i : byte;

    for (i := 1; i <= 6; i++)
      if not NullVipRef(oObjRef[i])
        FreeVipInterface(oObjRef[i]);

    if not NullVipRef(oPlacesRent)
      FreeVipInterface(oPlacesRent);

    if not NullVipRef(oCoIer)
      FreeVipInterface(oCoIer);
  }

  cmImp :
  {
    case rltObjTree.VidObj of
      roBuilding :
        RunInterface('RltObjInfo'     , rltObjTree.VidObj, rltObjTree.cObj);
      roPlaces :
        RunInterface('RltObjInfo'     , roZemCompl       , rltObjTree.cObj);
      roHouse, roFloor :
        RunInterface('RltInfoOnChilds', rltObjTree.VidObj, rltObjTree.cObj, Cur_Date);
    end;
  }

  cmSwitchFormat :
  {
    if ((Target = trRltObjects) and (rltObjTree.VidObj >= 10))
      {
        CheckInitedCurrentObj(rltObjTree.VidObj);
        if not tRltObjCommon(oObjRef[rltObjTree.VidObj div 10]).doUpdateObj Abort;
      }
  }

  #cmShowHideAllHandler

  cmHotKeys :
  {
    if Not IsValid(#rltObjTree)
      Exit;

    SetEnableCommand(cmSaveDoc   , oCopyPaste.CanBeCopied(rltObjTree.buffer));
    SetEnableCommand(cmRestoreDoc, oCopyPaste.CanBePasted(rltObjTree.buffer));

    var sMenu: string;
    sMenu := 'L_Realting::mnuRltObjCommon;SEPARATOR;';

    case rltObjTree.VidObj of
      roBuilding:
        sMenu += 'L_Realting::mnuRltObjFinder;SEPARATOR;'
               + 'L_Realting::mnuRltObjTreeOnBuilding';

      roPlaces:
        sMenu += 'L_Realting::mnuRltObjFinder;SEPARATOR;'
               + 'L_Realting::mnuRltObjTreeOnPlaces';

      roHouse:
        sMenu += 'L_Realting::mnuRltObjFinder;SEPARATOR;'
               + 'L_Realting::mnuRltObjTreeOnChilds';

      roFloor:
        sMenu += 'L_Realting::mnuRltObjReplicate;SEPARATOR;'
               + 'L_Realting::mnuRltObjFinder;SEPARATOR;'
               + 'L_Realting::mnuRltObjTreeOnChilds';

      roCustom:
        sMenu += 'L_Realting::mnuRltObjFinder;SEPARATOR;'
               + 'L_Realting::' + if(rltObjTree.cOwner = 0, 'mnuRltObjNewSubCustom', 'mnuRltObjTree');

      roRoom:
        sMenu += 'L_Realting::mnuRltObjReplicate;SEPARATOR;'
               + 'L_Realting::mnuRltObjFinder;SEPARATOR;'
               + 'L_Realting::mnuRltObjTree';
      else
        sMenu += 'L_Realting::mnuRltObjFinder;SEPARATOR;'
               + 'L_Realting::mnuRltObjTree';
    end;

    if (sMenu != '')
      PutHotCommand(RunDynMenu(sMenu));
  }

cmSaveDoc: // Скопировать объект
  if (oCopyPaste.Copy(rltObjTree.buffer))
    Message('Объект скопирован в буфер.');

cmRestoreDoc: // Вставить скопированный объект в текущую позицию
  {
    if (not oCopyPaste.Paste(rltObjTree.buffer, IPasteConfirm(self)))
      Message(oCopyPaste.GetLastErrorMessage());
    else
      RereadRecord();
  }

cmNal:
  {
    if (RunInterface('GetObjFinder', wVidObj, pObj) <> cmCancel) //rltObjTree.VidObj, rltObjTree.cObj);
      PutCommand(cmInit);

    if ((rltObjTree.VidObj >= 10) or (rltObjTree.VidObj = roPlaces))
      doEmbeddedInterface(rltObjTree.VidObj);

    ReReadRecord;
  }


end;

end.

