ToolBar
  F_Common::tbBuhFilter
, F_BuhRep::tbTreeControl
;

TabbedSheet BOTTOM tshMain
  Show at (39,,,15);

tree  brTabDogovor 'Договоры' (,,sci14Esc);
  Table Dogovor;

Fields
  if (IsValid(#Dogovor), oDogFuns.GetDogovorViewName(Dogovor.nRec, Dogovor.TiDk, if(Dogovor.cZamena = 0, 0, dvnZamena) or dvnTree), '')
                     'Документ'
        : [14], Protect, NoAutoSize;
//********************************************************************************
//  if(Dogovor.cDogovor>0,'ДС','Дог')     'ТД'
//                    ('Тип Договора')
//                    : [4], Protect, Centered, NoAutoSize;
//********************************************************************************
  Dogovor.DesGr     'Группа'
                   ('Код группы пользователей')
                    : [4], Protect, Centered, NoAutoSize;
//********************************************************************************
  Dogovor.Descr     'Дескр.'
                    ('Дескриптор(идентификатор) пользователя')
                    : [4], Protect, Centered, NoAutoSize;
//********************************************************************************
  KatVidD.Name      'Вид документа'
                    : [14], Skip, Centered;
//********************************************************************************
  Dogovor.dDoc      'Дата'
                    ('Дата заключения')
                    : [10,'DD/MM/YYYY'], Protect, Centered, NoAutoSize;
//********************************************************************************
  Dogovor.dBeg      'С'
                    ('Дата начала действия')
                    : [10,'DD/MM/YYYY'], Protect, Centered, NoAutoSize;
//********************************************************************************
  Dogovor.dEnd      'По'
                     ('Дата окончания действия')
                     : [10,'DD/MM/YYYY'], Protect, Centered, NoAutoSize;
//********************************************************************************
  Dogovor.NoDoc     'Номер'
                    ('Внутренний номер')
                    : [10], Protect, NoAutoSize;
//********************************************************************************
  Dogovor.NoDoc_Ext 'Вх.номер'
                    ('Входящий номер')
                    : [10], Protect, NoAutoSize;
//********************************************************************************
  if((Dogovor.Direct mod 2) = 1, '1->2', '2->1')
                    'Вид'
                    ('"1->2" - документ на продажу; "2->1" - документ на закупку')
                    : [4], Protect, Centered, NoAutoSize;
//********************************************************************************
  KatNotesDog.sName 'Статус'
                    ('Статус документа')
                    : [8], Protect, Centered, NoAutoSize, { Font = { Italic = TRUE } };
//********************************************************************************
  if(Dogovor.TipMoney = 1,'НДЕ', if (Dogovor.TipMoney = 2, 'Вал-НДЕ', 'Вал'))
                    'Тип'
                    : [7], Skip, Centered, NoAutoSize;
//********************************************************************************
  SimValDog         'Вал'
                    : [3], Skip, Centered, NoAutoSize, { Font = { Italic = TRUE } };
//********************************************************************************
  Dogovor.Summa     'Сумма'
                    ('Общая (планируемая) сумма')
                    : [15,'\2p[|-]3666`666`666`666.88'], Protect, NoAutoSize, LessNull;
//********************************************************************************
  GetSDog(Dogovor.nrec) 'Площадь' ('Площадь') : [10.2], NoAutoSize,Protect,nopickbutton;
end;


