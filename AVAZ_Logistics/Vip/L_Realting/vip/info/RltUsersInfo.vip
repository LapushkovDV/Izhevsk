Browse brSpecDog (,,sci1Esc);
  Show at (39,16,,);

  Table SpDocs;

Fields
//********************************************************************************
  SpDocs.CODE   '№'#13'п/п': [4], Skip, Centered, NoAutoSize;
//********************************************************************************
  SpDocs.PrMC   'Тип': [4], Skip, [LIST 1 'Т', 'У','УП','ДС','ГП'], Centered, NoAutoSize;
//********************************************************************************
  SpDogGrName   'Группа' ('Группа МЦ/Услуги'): [15], Protect, NoAutoSize;
//********************************************************************************
  SpDogName     'Продукция' ('Наименование МЦ/Услуги'): [20], Protect;
//********************************************************************************
  KOEDog.Name   'ЕдИзм' ('Единица измерения')
                : [5], Protect, Centered, NoAutoSize, { Font = { Italic = TRUE } };
//********************************************************************************
  if(SpDocs.Direct = 1,'1->2', '2->1'): [4], Skip;
//********************************************************************************
  SpDocs.Kol    'Количество' ('Количество'): [10.3], Protect;
//********************************************************************************
  SpDocs.Price  'Цена' ('Цена в валюте'): [10.2], Protect;
//********************************************************************************
  SpDocs.Summa  'Сумма' ('Стоимость в валюте') : [11.2], Protect;
//********************************************************************************
  SpDocs.SumNDS 'Налоги' ('Налоги') : [9.2], Protect;
//********************************************************************************
  SpDocs.Period 'Периодичность'
                ('Период отгрузки МЦ/услуг',,):
                [LIST 0 'нет',
                        'расчетный',
                        'год',
                        'квартал',
                        'месяц',
                        'неделя',
                        'день'],
                Skip, [13], Centered;
//********************************************************************************
   rltObjName      'Объект','недвижимости'(,, sci1378Esc) : [10], protect,nopickbutton;
//********************************************************************************
   rltRoomName     'Комната/Площадь'(,, sci1378Esc) : [17], protect,nopickbutton;
//********************************************************************************
   if(IsValid(#RLTATTRHIST),RLTATTRHIST.DOVALUES[4],0) 'Площадь' ('Площадь') : [11.2], Protect,nopickbutton;
//********************************************************************************
   RLTATTRHIST.SVALUES[8] 'Ось расположения' : [20], Protect,nopickbutton;

end;

Browse brSpecBD (,,sci1Esc);
  Show at (39,16,,);

  Table SpStep;

Fields
//********************************************************************************
  SpStep.Npp    '№'#13'п/п': [4], Skip, Centered, NoAutoSize;
//********************************************************************************
  if(SpStep.PrMC = 1, KatMCStep.BarKod, KatUslStep.Kod)
                'Ном.номер' ('Ном.номер') : [13], Protect, NoAutoSize;
//********************************************************************************
  if(SpStep.PrMC = 1, KatMCStep.Name, KatUslStep.Name)
                'Наименование'('Наименование') : [20], Protect;
//********************************************************************************
  KOEStep.Name  'ЕдИзм'
                : [5], Protect, Centered, NoAutoSize, { Font = { Italic = TRUE } };
//********************************************************************************
  SpStep.KolSkl 'Количество' ('Количество') : [10], [prSignsInKol], Protect, NoAutoSize;
//********************************************************************************
  SpStep.Price  'Цена'('Цена за единицу'): [12], NoAutoSize, [brForPrice];
//********************************************************************************
  Round(SpStep.Kol*SpStep.Price, 2)
                'Стоимость' ('Стоимость'): [12], [brForSumma], NoAutoSize, Protect, LessNull;
//********************************************************************************
end;

Browse brSpecKS (,,sci1Esc);
  Show at (39,16,,);

  Table SpSopr;

Fields
//********************************************************************************
  SpSopr.Npp     '№'#13'п/п': [4], Skip, Centered, NoAutoSize;
//********************************************************************************
  if(SpSopr.PrMC = 1, KatMCSopr.BarKod, KatUslSopr.Kod)
                 'Ном.номер' ('Ном.номер') : [13], Protect, NoAutoSize;
//********************************************************************************
  if(SpSopr.PrMC = 1, KatMCSopr.Name, KatUslSopr.Name)
                 'Наименование'('Наименование') : [16], Protect;
//********************************************************************************
  KOESopr.Name   'ЕдИзм'
                 : [5], Protect, Centered, NoAutoSize, { Font = { Italic = TRUE } };
//********************************************************************************
  SpSopr.KolFact 'Количество' : [10], [prSignsInKol], Protect;
//********************************************************************************
  if(KatSopr.cVal = 0, SpSopr.Price * SpSopr.KolFact, SpSopr.VPrice * SpSopr.KolFact)
                 'Стоимость' : [12], [brForSopr_RVPrice], Protect, LessNull;
//********************************************************************************
  SpSopr.rPrice  'Цена (НДЕ)' : [12], [brForSopr_Price], Protect;
//********************************************************************************
  SpSopr.rVPrice 'Цена (вал)' : [12], [brForSopr_VPrice], Protect;
//********************************************************************************
end;

Browse scBaseFin (,,sci1Esc);
  Show at (39,16,,);

  Table SoprHoz;

Fields
//********************************************************************************
  SoprHoz.DatOb    'Дата'
                   ('Дата проведения типовой хозяйственной операции.')
                   : [10,'DD/MM/YYYY'], Protect, Centered, NoAutoSize;
//********************************************************************************
  ATXOPick.GetHozOperName(myPlansNo, SoprHoz.BufferP)
                   'Хозяйственная операция'
                   ('Хозяйственная операция по первичному документу.')
                   : [32], Protect;
//********************************************************************************
  SoprHoz.Summa    'Сумма в НДЕ'
                   ('Сумма платежа по типовой хозяйственной операции.')
                   : [14.2], Protect;
//********************************************************************************
  SoprHoz.SumValut 'Сумма в валюте'
                   ('Сумма платежа по типовой хозяйственной операции.')
                   : [11.2], Protect;
//********************************************************************************
  SimValSH         'Вал'
                   : [3], Skip, Centered, NoAutoSize, { Font = { Italic = TRUE } };
//********************************************************************************
  SoprHoz.VhSumHoz 'П'('Признак: "+" - сумма по ТХО входит в расчет суммы по документу')
                   : [1], Protect, NoAutoSize, Centered;
//********************************************************************************
end;

Procedure RescanViews;
{
  case CurFormatInArea(brTabKatSopr201) of
    brTabDogovor:
      {
        RereadRecord(#Dogovor);
        RereadRecord(#SpDocs);
      }

    brTabBaseFin:
      {
        RereadRecord(#BaseFin);
        RereadRecord(#SoprHoz);
      }

    brTabBaseDocSell, brTabBaseDocBuy:
      {
        RereadRecord(#BaseDoc);
        RereadRecord(#SpStep);
      }

    brTabKatSopr201, brTabKatSopr101, brTabKatSopr211, brTabKatSopr111:
      {
        RereadRecord(#KatSopr);
        RereadRecord(#SpSopr);
      }
  end;
}

Panel pTree
  Table KatH;

Tree MyTree (,,sci1EscTree);
  Show at (,,38,);

Fields
  KatH.Name      'Пользователь' : [20], Protect;
  NameTable      'Тип'          : [13], Protect, Centered, NoAutoSize;
  KatH.LevelCode 'Код'          :  [5], Protect, Centered, NoAutoSize;
  GetSKontr(KatH.cmean) 'Площадь' ('Площадь') : [11.2], Protect,nopickbutton,noautosize;
end;

HandleEvent

cmPositionChanged:
  RescanViews;

end;
end;

HandleEvent

cmInit:
  {
    if ( GetFirst fpCO where (( comp(0)      == fpCO.cMain and
                                comp(0)      == fpCO.cNode and
                                'Арендаторы' == fpCO.Name )) <> tsOK )
      {
        message('Не найден обобщающий ЦО "Арендаторы"', Information);
        Abort;
        Exit;
      }

    myPlansNo := coGetTune('Fin.User.cPlansSch');

    if ( myPlansNo = 0 )
      myPlansNo := coGetTune('Konsolid.cPlansSch');

    if ( myPlansNo = 0 )
      {
        message('Установите текущий план счетов в настройке системы!'#13#13
              + GetTuneName('Fin.User.cPlansSch')
              + ''#13
              + GetTuneName('Konsolid.cPlansSch'), CancelButton);
        Abort;
        Exit;
      }

    cParent  := fpCO.nRec;
    cTopRec  := 0;
    cNodeTop := fpCO.nRec;

    if ( RecordExists KatH <> tsOK )
      {
        message('Не найдены ЦО в обобщающем ЦО "Арендаторы"', Information);
        Abort;
        Exit;
      }

    BegDate := ZeroDate;

    PushConditionForLeave(tcbyDogOrg, #Dogovor);
    PushConditionForLeave(tcbyBDOrg , #BaseDoc);
    PushConditionForLeave(tcbyKSOrg , #KatSopr);

    SetTableBackOrderIn(tnDogovor, true);
    SetTableBackOrderIn(tnBaseDoc, true);
    SetTableBackOrderIn(tnKatSopr, true);
    SetTableBackOrderIn(tnBaseFin, true);

    if ( GetFirst Dogovor <> tsOK )
      {}
  }

cmTreeTop:
  cParent := cNodeTop;

cmTreeUp:
  if IsValid(#KatH)
    cParent := KatH.cNode
  else
    cParent := cNodeTop;

cmTreeDown:
  if IsValid(#KatH)
    cParent := KatH.Nrec
  else
    cParent := cNodeTop;

cmTreeNeedOwner:
  if ( KatH.cNode = cNodeTop )
    TreeJumpToRecord(MyTree, 0);
  else
    TreeJumpToRecord(MyTree, KatH.cNode);

cmTreeNodeType:
  if ( Not ( IsValid(#SubKat) AND IsValid(#KatH) ) )
    TreeSetNodeType(MyTree, ntfText);

cmColumnClicked:
  {
    case Target Of
      #KatH.LevelCode:
        {
          PushBounds(tbbyTreeKatH);
          SetColumnSorting(MyTree, Target, -1);
        }

      #KatH.Name:
        {
          PushBounds(tbbyTreeKatHName);
          SetColumnSorting(MyTree, Target, -1);
        }
    end;
    ReScanPanel(#KatH);
  }

cmShowAll: // Раскрыть все ветки
  {
    StartNewVisual(vtRotateVisual, vfTimer, 'Раскрытие всех веток...'#13, 1);
    TreePushPos(MyTree);
    do
      {
        NextVisual;
        TreeOpenNode(MyTree);
      }
    while TreeGetNext(MyTree);

    StopVisual('', 0);
    TreePopPos(MyTree);
    RereadRecord(#KatH);
  }

cmHideAll: // Свернуть все ветки
  {
    TreeGetFirst(MyTree);
    TreeCloseAllOpenedNode(MyTree);
    RereadRecord(#KatH);
  }

cmHotKeys:
  {
    case CurTable of
      #KatH:
        {
          case KatH.coTable of
            cgKau_KatOrg:
              PutHotCommand(RunMenu('mnuRltUsersInfoOnOrg'));

            cgKau_KatPodr:
              PutHotCommand(RunMenu('mnuRltUsersInfoOnPodr'));
          else
              PutHotCommand(RunMenu('mnuRltUsersInfo'));
          end;
        }
      #Dogovor, #BaseDoc, #KatSopr, #BaseFin:
              PutHotCommand(RunMenu('mnuRltUsersInfoEditDoc'));
    end;
  }

cmEdit:
  {
    case CurTable of
      #BaseDoc:
        if IsValid(#BaseDoc)
          {
            iEditDoc.RunEditBaseDoc(BaseDoc.VidDoc, BaseDoc.nRec);
            ReReadRecord(#BaseDoc);
          }

      #Dogovor:
        if IsValid(#Dogovor)
          {
            iEditDoc.RunEditHozDoc(coDogovor, Dogovor.TiDk, Dogovor.TiDk, Dogovor.nRec);
            ReReadRecord(#Dogovor);
          }

      #KatSopr:
        if IsValid(#KatSopr)
          {
            iEditDoc.RunEditHozDoc(coKatSopr, KatSopr.VidSopr, KatSopr.VidSopr, KatSopr.nRec);
            ReReadRecord(#KatSopr);
          }

      #BaseFin:
        {
          if ( not IsValid(#BaseFin) )
            Exit;

          PutCommand(cmDefault);

          case BaseFin.TiDkGal of
            80..88:
              iEditDoc.RunEditHozDoc(coBaseFin, BaseFin.TiDkGal, BaseFin.TipDoc, BaseFin.cVeksl);

            93:
              if ( GetFirst BaseDocCes where (( BaseFin.cBaseDoc == BaseDocCes.nRec )) = tsOk )
                iEditDoc.RunEditHozDoc(coBaseFin, 91, 0, BaseDocCes.cPodrTo);

            94..95:
              {
                var TiDkCes : word;

                case BaseFin.TiDkGal of
                  94 : TiDkCes := 90;
                  95 : TiDkCes := 92;
                end; //case

                if ( GetFirst SpStep1 where (( word(200)    == SpStep1.PrMC and
                                               BaseFin.nRec == SpStep1.cMCUsl )) = tsOk )
                  if ( GetFirst StepDoc1 where (( SpStep1.cStepDoc == StepDoc1.nRec )) = tsOk )
                    iEditDoc.RunEditHozDoc(coBaseFin, TiDkCes, BaseFin.TipDoc, StepDoc1.cBaseDoc);
              }
          //---------------------
          // Акт взаимозачета (спецификация). В EditDoc'е передается ссылка на BaseFin, а не cPlPor.
            71:
              iEditDoc.RunEditHozDoc(coBaseFin, BaseFin.TiDkGal, BaseFin.TipDoc, BaseFin.NRec);
          //---------------------
            else
              iEditDoc.RunEditHozDoc(coBaseFin, BaseFin.TiDkGal, BaseFin.TipDoc, BaseFin.cPlPor);
          //---------------------
          end; // case

          ReReadRecord(#BaseFin);
        }
    end;
  }

cmImp:
  {
    case KatH.coTable of
      cgKau_KatOrg:
        RunInterface('KatOrg', KatH.cMean, comp(0), word(0));

      cgKau_KatPodr:
        RunInterface('KatPodr', word(0), KatH.cMean);
    end;

    RereadRecord(#KatH);
  }

cmChangeTabbedSheetFormat:
  {
    case Target of
      brTabDogovor:
        {
          SelectPanel(#Dogovor);
          SetFormat(brSpecDog);
          if ( GetFirst Dogovor <> tsOK )
            {}
          ReReadRecord(#Dogovor);
          ReReadRecord(#SpDocs);
        }

      brTabBaseFin:
        {
          SelectPanel(#BaseFin);
          SetFormat(scBaseFin);
          if ( GetFirst BaseFin <> tsOK )
            {}
          ReReadRecord(#BaseFin);
          ReReadRecord(#SoprHoz);
        }

      brTabBaseDocSell, brTabBaseDocBuy:
        {
          set wVidDoc := if(Target = brTabBaseDocSell, 201, 101);
          SelectPanel(#BaseDoc);
          SetFormat(brSpecBD);
          if ( GetFirst BaseDoc <> tsOK )
            {}
          ReReadRecord(#BaseDoc);
          ReReadRecord(#SpStep);
        }

      brTabKatSopr101, brTabKatSopr111, brTabKatSopr201, brTabKatSopr211:
        {
          case Target of
            brTabKatSopr101: set wVidSopr := 101;
            brTabKatSopr111: set wVidSopr := 111;
            brTabKatSopr201: set wVidSopr := 201;
            brTabKatSopr211: set wVidSopr := 211;
          end;

          SelectPanel(#KatSopr);
          SetFormat(brSpecKS);
          if ( GetFirst KatSopr <> tsOK )
            {}
          ReReadRecord(#KatSopr);
          ReReadRecord(#SpSopr);
        }

    end;
  }

cmDelOnProtect:
  Abort;

cmFilterSave:
  {
    var D1, D2 : date;
    D1 := BegDate;
    D2 := EndDate;

    while TRUE do
      {
        if ( RunDialog('GetInterval', D1, D2 ) = cmCancel )
          Break;

        if ( ( D1 > D2 ) AND ( D2 <> ZeroDate ) )
          {
            Message('Некорректно задан период!', Warning);
            Continue;
          }

        if ( ( EndDate = ZeroDate ) AND ( D2 <> ZeroDate ) )
          {
            AddBounds(tbbyDGDate);
            AddBounds(tbbyBDDate);
            AddBounds(tbbyKSDate);
            AddBounds(tbbyBFDate);
          }

        if ( ( EndDate <> ZeroDate ) AND ( D2 = ZeroDate ) )
          {
            SubBounds(tbbyDGDate);
            SubBounds(tbbyBDDate);
            SubBounds(tbbyKSDate);
            SubBounds(tbbyBFDate);
          }

        set BegDate := D1;
        set EndDate := D2;

        RescanViews;

        Break;
      }
  }
end;
HandleEvent

cmTreeTop:
  pDogovor := 0;

//********************************************************************************

cmTreeUp:
  pDogovor := Dogovor.cDogovor;

//********************************************************************************

cmTreeDown:
  pDogovor := Dogovor.nRec;

//********************************************************************************

cmTreeNodeType:
{
  var DocTreeType : byte;

  DocTreeType := GetDocTreeType;

  TreeSetNodeType(brTabDogovor,
                  DocTreeType,
                  GetDocTreeIconEx(Dogovor.TiDk, Dogovor.Status, DocTreeType, Dogovor.cNote));
}

//********************************************************************************

cmTreeNeedOwner:
  TreeJumpToRecord(brTabDogovor, Dogovor.cDogovor);
end;

end.

#declare mnuShowHideAll
 - 'Раскрыть все подуровни от текущего',cmShowAll,'',hcGkatalSHier,'Ctrl+''+''',kbCtrlGrayPlus ,scMenuCtx,,,,bmpOpenFolders ;
 - 'Закрыть подуровни'                 ,cmHideAll,'',hcGkatalSHier,'Ctrl+''-''',kbCtrlGrayMinus,scMenuCtx,,,,bmpCloseFolders;
#end

