#include EditDoc.vih
#include TXOPick.vih
#include KatOrg.vih
#include DogFuns.vih

#doc
Документы по арендаторам
#end
Interface RltUsersInfo 'Документы по арендаторам' (, hci_nedvig_Win_DokArendat,) EscClose, Cyan;
#include DogFuns.var
#include EditDoc.var

table struct TmpRltObj
(
   VidObj        : word
   ,cObj         : comp
)
with index
(
   TmpRltObj01 = VidObj + cObj
)
;
Create view

Var
  cParent
, cNodeTop
, cTopRec
, MyPlansNo
, pDogovor: comp;

  wVidDoc
, wVidSopr : word;

  BegDate
, EndDate  : date;

  ATXOPick : iTXOPick;

As select
  if (KatH.coTable = cgKau_KatOrg , 'организация',
  if (KatH.coTable = cgKau_KatPodr, 'подразделение',
  if (KatH.coTable = cgKau_Persons, 'сотрудник',
  if (KatH.coTable = cgKau_FpCO   , 'ЦО'
                                  , ''))))
    ( FieldName = NameTable )

, oValFunc.GetValSymbol(Dogovor.cVal) ( FieldName = SimValDog )
, oValFunc.GetValSymbol(BaseDoc.cVal) ( FieldName = SimValBD  )
, oValFunc.GetValSymbol(KatSopr.cVal) ( FieldName = SimValKS  )
, oValFunc.GetValSymbol(BaseFin.cVal) ( FieldName = SimValFin )
, oValFunc.GetValSymbol(SoprHoz.KodValut) ( FieldName = SimValSH  )

, if (SpDocs.cMCUsl = 0,'',
    if ((SpDocs.prMC = 1) or (SpDocs.prMC = 4) or (SpDocs.prMC = 5),
      if (isValid(tnKatMCDog), KatMCDog.Name, '? MC ' + string(SpDocs.cMCUsl)),
        if ((SpDocs.prMC = 2) or (SpDocs.prMC = 3),
          if (isValid(tnKatUslDog), KatUslDog.Name, '? Услуга ' + string(SpDocs.cMCUsl)), '')))
    ( FieldName = SpDogName )

, if (SpDocs.cGrMCUsl = 0,'',
    if ((SpDocs.prMC = 1) or (SpDocs.prMC = 4) or (SpDocs.prMC = 5),
      if (isValid(tnGroupMCDog), GroupMCDog.Name, '? Группа МЦ ' + string(SpDocs.cGrMCUsl)),
        if ((SpDocs.prMC = 2) or (SpDocs.prMC = 3),
          if (isValid(tnGroupUslDog), GroupUslDog.Name, '? Группа услуг ' + string(SpDocs.cGrMCUsl)),'')))
    ( FieldName = SpDogGrName )

, if (rltLinks.VidObj = roRoom,
    '№ '+rltGetStringFieldFromTable('rltRooms', 'NoFact', rltLinks.cObj)+'  '+rltGetStringFieldFromTable('rltRooms', 'NOBTI', rltLinks.cObj),
    if (rltLinks.VidObj = roPlace,
      if (trim(rltGetStringFieldFromTable('rltPlaces', 'Name', rltLinks.cObj)) = ''
       , rltGetStringFieldFromTable('rltPlaces', 'Addr', rltLinks.cObj)
       , rltGetStringFieldFromTable('rltPlaces', 'Name', rltLinks.cObj)),
      ''))
    ( FieldName = rltRoomName )
, if (rltLinks.VidObj = roRoom,rltGetAnyFieldFromTable('RLTBUILDINGS','INVNO',rltGetCompFieldFromTable('rltRooms', 'CBUILDING', rltLinks.cObj))+' '+rltGetAnyFieldFromTable('RLTBUILDINGS','NAME',rltGetCompFieldFromTable('rltRooms', 'CBUILDING', rltLinks.cObj))            ,
      if (rltLinks.VidObj = roPlace,rltGetAnyFieldFromTable('RLTBUILDINGS','INVNO',rltGetCompFieldFromTable('RLTPLACES', 'CBUILDING', rltLinks.cObj))+' '+rltGetAnyFieldFromTable('RLTBUILDINGS','NAME',rltGetCompFieldFromTable('RLTPLACES', 'CBUILDING', rltLinks.cObj))    ,
      ''))
    ( FieldName = rltObjName )

,*

From
  fpCO     KatH
, fpCO     SubKat
, fpCO     UpKat
, fpCO
, Dogovor
, BaseDoc
, KatSopr
, BaseFin
, BaseDoc  BaseDocCes
, SpStep
, SpStep   SpStep1
, StepDoc
, StepDoc  StepDoc1
, KatNotes KatNotesDog
, KatNotes KatNotesBD
, KatNotes KatNotesKS
, KatOtpEd KOEDog
, KatOtpEd KOEStep
, KatOtpEd KOESopr
, KatMC    KatMCDog
, KatMC    KatMCStep
, KatMC    KatMCSopr
, KatUsl   KatUslDog
, KatUsl   KatUslStep
, KatUsl   KatUslSopr
, GroupMC  GroupMCDog
, GroupUsl GroupUslDog
, SpDocs
, SpSopr
, KatVidD
, KatDoc
, SoprHoz
, rltlinks
, rltAttrHist
, rltAttrHist rltAttrHist2
, rltAttrHist rltAttrHistD
, SpDocs SpDocsD
, rltLinks rltLinksD
, Dogovor DogovorD
, Dogovor DogAttach1
, TmpRltObj
Where
((

    comp(0)          == KatH.cMain
and cParent          == KatH.cNode
and cTopRec          == SubKat.cMain
and KatH.Nrec        == SubKat.cNode
and KatH.cNode       == UpKat.Nrec

//and comp(0)          == Dogovor.cDogovor
and BegDate         <<= Dogovor.dDoc
and wVidDoc          == BaseDoc.VidDoc
and BegDate         <<= BaseDoc.dDoc
and wVidSopr         == KatSopr.VidSopr
and BegDate         <<= KatSopr.dSopr
and KatH.cMean       == BaseFin.cOrg
and BegDate         <<= BaseFin.dDoc

and Dogovor.cVidDog  == KatVidD.nRec

and Dogovor.cNote    == KatNotesDog.nRec
and BaseDoc.cNote    == KatNotesBD.nRec
and KatSopr.cNote    == KatNotesKS.nRec

and BaseFin.tiDkGal  == KatDoc.TiDkGal

and Dogovor.TiDk     == SpDocs.TiDk
and Dogovor.nRec     == SpDocs.cDoc
and KatSopr.nRec     == SpSopr.cSopr
and BaseDoc.nRec     == StepDoc.cBaseDoc
and StepDoc.nRec     == SpStep.cStepDoc
and BaseFin.cSoprHoz == SoprHoz.nRec

and SpDocs.cOtpEd    == KOEDog.nRec
and SpDocs.cMCUsl    == KatMCDog.nRec
and SpDocs.cMCUsl    == KatUslDog.nRec
and SpDocs.cGrMCUsl  == GroupMCDog.nRec
and SpDocs.cGrMCUsl  == GroupUslDog.nRec

and SpStep.cOtpEd    == KOEStep.nRec
and SpStep.cMCUsl    == KatMCStep.nRec
and SpStep.cMCUsl    == KatUslStep.nRec

and SpSopr.cOtpEd    == KOESopr.nRec
and SpSopr.cMCUsl    == KatMCSopr.nRec
and SpSopr.cMCUsl    == KatUslSopr.nRec
//
and SpDocs.nRec          == rltLinks.cSpDocs
and rltLinks.VidObj      == rltAttrHist2.VidObj
and rltLinks.cObj        == rltAttrHist2.cObj
and Dogovor.dend        >>= rltAttrHist2.dChange
and rltAttrHist2.VidObj  == rltAttrHist.VidObj
and rltAttrHist2.cObj    == rltAttrHist.cObj
and rltAttrHist2.dChange == rltAttrHist.dChange
and DogovorD.TiDk        == SpDocsD.TiDk
and DogovorD.nRec        == SpDocsD.cDoc
and SpDocsD.nRec          == rltLinksD.cSpDocs
and rltLinksD.VidObj      == rltAttrHistD.VidObj
and rltLinksD.cObj        == rltAttrHistD.cObj
and DogovorD.dend        >>= rltAttrHistD.dChange
and Dogovor.nRec        == DogAttach1.cDogovor

))

Order by Dogovor.dDoc , Dogovor.NoDoc,
         BaseDoc.dDoc , BaseDoc.NoDoc,
         KatSopr.dSopr, KatSopr.NSopr,
         BaseFin.dDoc

Bounds MainBound  =  pDogovor   == Dogovor.cDogovor
                     ordered by TableOrder


Bounds byTreeKatH     =  cTopRec == KatH.cMain
                     and cParent == KatH.cNode ordered by KatH.LevelCode
Bounds byTreeKatHName =  cTopRec == KatH.cMain
                     and cParent == KatH.cNode ordered by KatH.Name

Bounds    byDGDate EndDate >>= Dogovor.dDoc(NoIndex)

Bounds    byBDDate EndDate >>= BaseDoc.dDoc(NoIndex)

Bounds    byKSDate EndDate >>= KatSopr.dSopr(NoIndex)

Bounds    byBFDate EndDate >>= BaseFin.dDoc(NoIndex)

Condition byDogOrg Dogovor.cOrg = KatH.cMean

Condition byBDOrg BaseDoc.cOrg = KatH.cMean

Condition byKSOrg KatSopr.cOrgBase = KatH.cMean
;

#include Direct.vpp
Function GetDocTreeType : byte;
{
  if ( RecordExists DogAttach1 <> tsOK )
    Result := ntfText
  else
    Result := ntfText;//ntfOpen;//if(TreeNodeIsOpen(Dogovor), ntfOpen, ntfClose);
}
//********************************************************************************
#define SHOW_NOTES_ICONS
#include DogIcons.vpp
//********************************************************************************

function GetSDog(_Dog:comp):double;
var Sum:double;
{
  Result:=0;
  if getfirst fastfirstrow DogovorD where ((_Dog == DogovorD.nrec))<>tsok then exit;
  _loop SpDocsD
   _loop rltLinksD
    {
      if SpDocsD.cdoc <> DogovorD.nrec then continue; //какая-то проблема при линковке к договору, позже посмотрим что за беда
      if getfirst rltAttrHistD =tsok then Result:=Result+ RLTATTRHISTD.DOVALUES[4];
    }
}

function GetSKontr(_Org:comp):double;
var Sum:double;
{
  Result:=0;
  delete all TmpRltObj;
  _loop DogovorD where ((1 == DogovorD.direct and _Org == DogovorD.cOrg))
   _loop SpDocsD
    _loop rltLinksD
       {
        if SpDocsD.cdoc <> DogovorD.nrec then continue; //какая-то проблема при линковке к договору, позже посмотрим что за беда
        if getfirst rltAttrHistD =tsok then
         {
          if getfirst fastfirstrow TmpRltObj where ((rltLinksD.vidobj == TmpRltObj.vidobj and rltLinksD.cobj == TmpRltObj.cobj)) = tsok then continue;
          ClearBuffer(#TmpRltObj);
          set TmpRltObj.vidobj:=rltLinksD.vidobj;
          set TmpRltObj.cobj:=rltLinksD.cobj;
          insert current TmpRltObj;
          Result:=Result+ RLTATTRHISTD.DOVALUES[4];
         }
       }
}

