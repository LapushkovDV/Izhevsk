#include FloorMainAttr.vih

#doc
Базовый интерфейс для объекта недвижимости <b>Этаж</b>
#end
Interface FloorMainAttr Cyan;

Create view

As select
  if(trim(rltZemCompl.Name) = '', rltZemCompl.Addr, rltZemCompl.Name + ' (' + rltZemCompl.Addr + ')')
    ( FieldName = ZemComplViewName )

, if(trim(rltBuildings.Name) = '', rltBuildings.Addr, rltBuildings.Name + ' (' + rltBuildings.Addr + ')')
    ( FieldName = BuildingViewName )

From
  rltFloors,
  rltFloors rltFloors2,
  rltZemCompl,
  rltBuildings,
  rltHouses,
  rltRooms

Where

((

    pObj                   == rltFloors.nRec
and rltFloors.cBuilding    == rltBuildings.nRec
and rltBuildings.cZemCompl == rltZemCompl.nRec

))

;

function doInsertObj(pRltOwner, pOwner : comp) : boolean;
var
  NewNo    : string;
  NewLevel : longint;
{
  if (GetLast rltFloors2 where (( pRltOwner == rltFloors2.cBuilding ))
         ordered by rltFloors2.cBuilding, rltFloors2.Level = tsOK)
    {
      NewNo    := rltFloors2.No;
      NewLevel := rltFloors2.Level;
    }
  else
    {
      NewNo    := '00';
      NewLevel := 0;
    }

  NextNumStr(NewNo);
  NewLevel++;

  var NewNrec : comp; NewNrec := GetNextNrec(#rltFloors, 0);

  if ((insert rltFloors2 set rltFloors2.nRec      := NewNrec,
                             rltFloors2.cBuilding := pRltOwner,
                             rltFloors2.Level     := NewLevel,
                             rltFloors2.No        := NewNo) <> tsOK)
    doInsertObj := false
  else
    {
      doInsertObj := true;
      oAttrs.CreateHistory(NewNrec, roFloor);
      AfterInsertObj(pOwner, NewNrec, roFloor, 'Этаж №' + NewNo);
      SelectField(#rltBuildings.InvNo);
    }
}

function doDeleteObj(pObj : comp) : boolean;
{
  doDeleteObj := false;
  if (RecordExists rltHouses where (( rltFloors.cBuilding == rltHouses.cBuilding and
                                      pObj                == rltHouses.cFloor )) = tsOK)
    {
      message('Удаление этажа с помещениями невозможно', Information);
      Exit;
    }
  if (RecordExists rltRooms where (( rltFloors.cBuilding == rltRooms.cBuilding and
                                     pObj                == rltRooms.cFloor )) = tsOK)
    {
      message('Удаление этажа с комнатами невозможно', Information);
      Exit;
    }

  if (message('Удалить объект недвижимости (этаж)?', YesNo + Confirmation) <> cmYes) Exit;

  doDeleteObj := delete rltFloors where (( pObj == rltFloors.nRec )) = tsOK;
  oAttrs.DestroyHistory(pObj, roFloor);
}

TabbedSheet TOP tshMain;

Screen scrMain 'Основные атрибуты' (,,sci1Esc);
Table rltFloors;
  Bevel b1 { 0, 0, 46,  8, bsLowered, bsFrame};
  Bevel b2 { 0, 7, 46, 10, bsLowered, bsFrame};
Fields
  ZemComplViewName   : skip;
  BuildingViewName   : skip;
  rltBuildings.InvNo : skip;
  rltFloors.No ('Номер этажа',,) : noprotect;
  rltFloors.Level ('Уровень этажа',,) : noprotect, SpinButton[1, -20, 500];
<<

 `Земельный участок:`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Здание/сооружение`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Инвентарный номер здания/сооружения`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Этаж:` .@@@@@@@@@@@@@@@@@ `Уровень:` .@@@@@
>>
end;

Embedded brFloorExAttr 'Внешние атрибуты' interface oAttribute;
Cache = Slave
end;

Embedded brFloorExClass 'Внешняя классификация' interface oExClass;
Cache = Slave
end;

end; // TabbedSheet

function GetMainFormat : longint;
{
  Result := scrMain;
}

procedure Refresh;
{
  RereadRecord(#rltFloors);

  Inherited::Refresh;
}

procedure ReSetPosition;
{
  if ( GetFirst rltFloors = tsOK )
    {}
}

Panel pMain
  Table rltFloors;

HandleEvent
  cmUpdateRecord : if (update current rltFloors = tsOK)
                     AfterUpdateObj(rltFloors.cBuilding, rltFloors.nRec, roBuilding, roFloor, 'Этаж №' + rltFloors.No);
end;

end; // Panel

Constructor Init;
{
  Result := InitRltObj(corltFloors);
}

end.
