#include BuildingAttr.vih
#include RltObjsOnStatus.vih
#include RltComPay.vih
#include RltImpAndPay.vih
#include RltOsFnc.vih

#doc
Интерфейс атрибутов объекта недвижимости <b>Здание/Сооружение</b>
#end
Interface BuildingAttr Cyan;

Create view

Var
  oRooms : tRltObjsOnStatus;
  oComPay: tRltComPay;
  oImpPay: tRltImpAndPay;

As select
  oValFunc.GetValSymbol(NastrOs.cVal)
    (FieldName = KatOSValName)

From
  KatOs,
  NastrOs,
  SpKatOs,
  KatPodr,
  KatMol,
  IsPos

Where
((

    pObj                == rltBuildings.nRec
and pObj                == rltPlaces.cBuilding
and rltBuildings.cKatOs == KatOs.nRec
and NastrOs.nRec        == SpKatOs.cNastrOs
and KatOs.nRec          == SpKatOs.cKatOs
and KatOs.cPodr         == KatPodr.nRec
and KatOs.cMol          == KatMol.nRec
and SpKatOS.cisp        == IspOS.nrec

));

#doc
Окно для встраивания в интерфейс <link Interface L_Realting::VipRltObjTree>Объекты недвижимости</link> с информацией по объекту недвижимости <b>Здание/Сооружение</b>
#end
Window wMain Cyan

Screen srcAttrs;
  Show At (,,,2) fixed_Y;
Fields
  'АТРИБУТЫ ЗДАНИЯ/СООРУЖЕНИЯ' : protect, centered, {Font = {Bold = true}};
<<
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

TabbedSheet BOTTOM tshMain;
  Show At (,3,,);

Embedded emMain 'Основная информация' interface oMain;
end;

Panel pMain

Screen scrKatOs 'Карточка ОС' (,,sci1Esc);
  Bevel b1 { 0, 2, 54, 17, bsLowered, bsFrame};
Fields
  KatOs.NameOs   ('Наименование основного средства',,sci13Esc) : protect;
  KatOs.InNum    ('Инвентарный номер основного средства') : protect;
  KatOs.PsNum    ('Номер паспорта объекта') : protect;
  KatOs.GodV     ('Дата выпуска') : protect;
  KatOs.DateK    ('Дата ввода в эксплуатацию') : protect;
  KatPodr.Name   ('Подразделение ') : protect;
  KatMol.Name    ('Материально ответственное лицо') : protect;
  IsPos.NAMEIS   ('Признак использования') : protect;
  SpKatOs.Stoim  ('Балансовая стоимость') : [14.2, '\2p[|-]36`666`666`666`666.88'], protect;
  KatOSValName : protect;
  SpKatOs.SumIzn ('Сумма износа')         : [14.2, '\2p[|-]36`666`666`666`666.88'], protect;
  SpKatOs.SIznM  ('Износ за месяц')       : [14.2, '\2p[|-]36`666`666`666`666.88'], protect;
  SpKatOs.Stoim - SpKatOs.SumIzn - SpKatOs.SIznM
                 ('Остаточная стоимость') : [14.2, '\2p[|-]36`666`666`666`666.88'], protect;


<<
  `Наименование ОС:`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Инвентарная Карточка`
  `Инвентарный номер:`       &`Номер паспорта:`
  .@@@@@@@@@@@@@@@@@@@@@@@  .@@@@@@@@@@@@@@@@@@@@@@@
  `Дата выпуска:`.@@@@@@@@@@`Дата ввода:`.@@@@@@@@@@
  `Подразделение:`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `МОЛ:`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Признак использования:`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Стоимость:`           .@@@@@@@@@@@@@@@@@@@@@.@@@@
  `Сумма износа:`        .@@@@@@@@@@@@@@@@@@@@@
  `Износ за месяц:`      .@@@@@@@@@@@@@@@@@@@@@
  `Остаточная стоимость:`.@@@@@@@@@@@@@@@@@@@@@
>>
end;

HandleEvent

  cmPick :
  {
    case CurField of
      #KatOs.NameOs :
        {
          if (RunInterface('KatOSs',
                           word(15), // Тип
                           rltBuildings.cKatOs,
                           word(1),  // 1 - одиночный выбор
                           comp(0),  // ограничения по подразделению
                           comp(0),  // ограничения по виду
                           comp(0),  // ограничения по МОЛ
                           comp(0)   // не показывать этот
                          ) <> cmCancel)
            {
              update current rltBuildings;
              oMain.Refresh;
            }
        }
    end;
  }

  cmDelOnProtect :
  {
    case CurField of
      #KatOs.NameOs :
        {
          update current rltBuildings set rltBuildings.cKatOs := 0;
          oMain.Refresh;
        }
    else
      Abort;
    end;
  }

end;

end; // Panel

Embedded emAttrs 'Изменяемые параметры' interface oAttrs.wHistory;
end;

Browse brPlaces 'Привязанные места на б/т' (,,sci1Esc);
Table rltPlaces;
Fields
  rltPlaces.Name 'Наименование'       ('Наименование места на благоустроенной территории') : protect;
  rltPlaces.Addr 'Адрес места на б/т' ('Адрес места на благоустроенной территории') : protect;
end;

Embedded emRents 'Закрепление' interface oRents.wRents;
end;

Embedded emRooms 'Аренда/закрепление комнат' interface oRooms.wRoomRent;
end;

Embedded emImpPay 'Благоустройство' interface oImpPay;
end;

Embedded emComPay 'Коммунальные начисления' interface oComPay.winBComPay;
end;

end; // TabbedSheet

function GetMainFormat: longint;
{
  Result := emMain;
}

function GetAttrsFormat: longint;
{
  Result := emAttrs;
}

function GetRentFormat: longint;
{
  Result := emRents;
}

procedure Refresh;
{
  ReReadRecord(#rltBuildings);
  ReReadRecord(#rltPlaces);
}

function SetCurrentPosition(aPanel: longint): boolean;
{
  Result := TRUE;

  if NOT inherited::SetCurrentPosition(aPanel)
    case aPanel of
      emRooms  :  oRooms.SetPosition(pObj, roRoom);
      emComPay : oComPay.SetPosition(pObj, roBuilding);
      emImpPay : oImpPay.SetPosition(pObj, roBuilding);
    else
      Result := FALSE;
    end;
}

procedure SetPositionChildren;
{
  if (GetFirst rltBuildings = tsOK)
    {}

  SetCurrentPosition(GetCurrentFormat);
}

function RefreshCurrentPosition(aPanel: longint): boolean;
{
  Result := TRUE;

  if NOT inherited::RefreshCurrentPosition(aPanel)
    case aPanel of
      emRooms  :  oRooms.Refresh;
      emComPay : oComPay.Refresh;
      emImpPay : oImpPay.Refresh;
    end;
}

HandleEvent

cmSwitchFormat :
  if NOT OnSwitchFormat
    case Target of
      scrKatOs : RereadRecord(#rltBuildings);
    end;

end;

end; // Window

Constructor Init;
#ifdef __USE_GETDIRECT__
var phUNastrOsPos : PositionHandle;
#else
var phUNastrOsPos : comp;
#end
{
  Result := FALSE;

  if NOT InitRltObj(roBuilding)
    Exit;

  LoadVipRef(oRooms , 'RltObjsOnStatus' );
  LoadVipRef(oComPay, 'vRltComPay'      );
  LoadVipRef(oImpPay, 'RltImpAndPay'    );

  var CanUseKatOs : boolean;

  CanUseKatOs := TRUE;

  if not DemoMode
    CanUseKatOs := Lic_ModuleMayBeUsed('B_OSN');

  if CanUseKatOs
    {
      var oRltOsFnc : RltOsFnc;
      phUNastrOsPos := oRltOsFnc.GetUserNastrOsPos15;
#ifdef __USE_GETDIRECT__
      if (phUNastrOsPos = NULL)
#else
      if (GetFirst NastrOs where (( phUNastrOsPos == NastrOs.nRec )) <> tsOk)
#end
        {
          CanUseKatOs := FALSE;
          message('Не установлен метод учета модуля "Основные средства"!' +
          ''#13#13'Заполните каталог методов учета.', OkButton);
        }
#ifdef __USE_GETDIRECT__
      else
        GetDirect(tnNastrOs, phUNastrOsPos);
#end
    }
  if not CanUseKatOs
    SetTabbedSheetVisible(scrKatOs, FALSE);

  Result := TRUE;
}

end.
