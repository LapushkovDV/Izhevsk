// Не предназначен для использования в качестве видимого (интерактивного) интерфейса.
// Интерфейс содержит реализации методов tRltObjCommon, позволяющие использовать их
// не в интерактивном режиме. А именно:
//   - метод doInsertObject не требует от пользователя ввода адреса. Поэтому адрес нового
//     здания/сооружения необходимо задавать в обработчике события AfterInsertObj.

#include BuildingAttrSimple.vih
#include RltAttrHist.vih

Interface BuildingAttrSimple;

var
  oAttrs: RltAttrHistory;

create view
from
  rltBuildings
, rltZemCompl
;

function doInsertObj(pRltOwner, pOwner: comp): boolean;
{
  result := false;

  if (GetFirst rltZemCompl where ((pRltOwner == rltZemCompl.nRec)) != tsOK)
   {
    if pRltOwner<>0 then Message('Не найден Земельный участок( Nrec='+To_Char(pRltOwner,0)+' )'#13'Необходимо проверить ссылочную целостность!',Warning);
    exit;
   }

  if ((insert rltBuildings set rltBuildings.cZemCompl := pRltOwner) = tsOK)
  {
    oAttrs.CreateHistory(rltBuildings.nRec, roBuilding);
    AfterInsertObj(pOwner, rltBuildings.nRec, roBuilding, '');
    result := true;
  }
}

