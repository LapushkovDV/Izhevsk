Embedded brBuildingExAttr 'Внешние атрибуты' interface oAttribute;
Cache = Slave
end;

Embedded brBuildingExClass 'Внешняя классификация' interface oExClass;
Cache = Slave
end;

end; // TabbedSheet

function GetMainFormat : longint;
{
  Result := scrMain;
}

procedure Refresh;
{
  RereadRecord(#rltBuildings);

  Inherited::Refresh;
}

procedure ReSetPosition;
{
  if (GetFirst rltBuildings = tsOK)
    {}
}

Panel pMain
Table rltBuildings;

HandleEvent

  cmUpdateRecord :
  {
    if (update current rltBuildings = tsOK)
      {
        AfterUpdateObj(rltBuildings.cZemCompl,
                       rltBuildings.nRec,
                       roBuildings,
                       roBuilding,
                       if(trim(rltBuildings.Name) = '', rltBuildings.Addr, rltBuildings.Name));
      }
  }

  cmPick :
  {
    case CurField of
      #OtvPodr.Name :
        {
          var pCO : comp; pCO := rltBuildings.cFpCO;
          if (RunInterface('GetCO', cgiPick, comp(0), comp(0), pCO) <> cmCancel)
            {
              set rltBuildings.cFpCO := pCO;
              UpdateTable;
            }
        }
      #ZemComplViewName :
        if (RunInterface(GetZemCompl, rltBuildings.cZemCompl) <> cmCancel)
          {
            set rltBuildings.cZemCompl := rltBuildings.cZemCompl;
            set rltBuildings.Addr      := iAdrFunc.GetFullAddress(rltBuildings.cAddr);
            UpdateTable;
          }
      #rltBuildings.Addr :
        if iAdrFunc.PickAddress(rltBuildings.cAddr)
          {
            set rltBuildings.cAddr := rltBuildings.cAddr;
            set rltBuildings.Addr  := iAdrFunc.GetFullAddress(rltBuildings.cAddr);
          }
    end;
  }

  cmDelOnProtect :
  {
    case CurField of
      #OtvPodr.Name :
        set rltBuildings.cFpCO := 0;
    end;
  }

  #PurposesCmPickHndlr(rltBuildings)

end;

end; // Panel

Constructor Init;
{
  Result := InitRltObj(corltBuildings);
}

HandleEvent

cmOpenSearch:
  {
    case CurField of
      #ZemComplViewName :
        {
          QuickChoiceName := 'qcZemComplName';
          ProcessCommand(cmPick);
        }
    end;
  }

  #PurposesCmOpenSearchHndlr

end;

end.
