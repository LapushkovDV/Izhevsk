#include BuildingMainAttr.vih
#include RltRentHist.vih
#include AdrFunc.vih

#include RltPurposes.defs

#doc
Базовый интерфейс для объекта недвижимости <b>Здание/Строение</b>
#end
Interface BuildingMainAttr Cyan;

Create view

Var
  oRents: RltRentHistory;

As select
  if(trim(rltZemCompl.Name) = '', rltZemCompl.Addr, rltZemCompl.Name + ' (' + rltZemCompl.Addr + ')')
    ( FieldName = ZemComplViewName )

From
  rltBuildings,
  rltBuildings rltBuildings2,
  rltZemCompl,
  rltRents(rltRents03),
  fpCO,
  fpCO OtvPodr,
  KatNazna,
  rltFloors,
  rltHouses,
  rltRooms
#PurposesTbl

Where
((
    pObj                   == rltBuildings.nRec
and rltBuildings.cZemCompl == rltZemCompl.nRec
and rltBuildings.cFpCo     == OtvPodr.nRec
and roBuilding             == rltRents.VidObj
and rltBuildings.nRec      == rltRents.cObj
and rltRents.cFpCO         == fpCO.nRec
and rltRents.pPurposes     == KatNazna.nRec

#PurposesRelat(rltBuildings)

));

#include AdrFunc.var

function doInsertObj(pRltOwner, pOwner : comp) : boolean;
var pAddr : comp;
{
  result := false;
  pAddr := 0;
  if (GetFirst rltZemCompl where (( pRltOwner == rltZemCompl.nRec )) = tsOK)
   {
    if iAdrFunc.PickAddress(pAddr) and (pAddr <> 0)
      {
        var NewNrec : comp;   NewNrec := GetNextNrec(#rltBuildings, 0);
        var NewAddr : string; NewAddr := iAdrFunc.GetFullAddress(pAddr);

        if ((insert rltBuildings2 set rltBuildings2.nRec      := NewNrec,
                                      rltBuildings2.cZemCompl := pRltOwner,
                                      rltBuildings2.cAddr     := pAddr,
                                      rltBuildings2.Addr      := NewAddr) = tsOK)
          {
            result := true;
            oAttrs.CreateHistory(NewNrec, roBuilding);
            AfterInsertObj(pOwner, NewNrec, roBuilding, NewAddr);
            SelectField(#rltBuildings.Name);
          }
      }
   }
   else
   {
    if pRltOwner<>0 then Message('Не найден Земельный участок( Nrec='+To_Char(pRltOwner,0)+' )'#13'Необходимо проверить ссылочную целостность!',Warning);
   }
}

function doDeleteObj(pObj : comp) : boolean;
{
  doDeleteObj := false;
  if (RecordExists rltFloors where (( pObj == rltFloors.cBuilding )) = tsOK)
    {
      message('Удаление здания/сооружения с этажами невозможно', Information);
      Exit;
    }
  if (RecordExists rltHouses where (( pObj == rltHouses.cBuilding )) = tsOK)
    {
      message('Удаление здания/сооружения с помещениями невозможно', Information);
      Exit;
    }
  if (RecordExists rltRooms where (( pObj == rltRooms.cBuilding )) = tsOK)
    {
      message('Удаление здания/сооружения с комнатами невозможно', Information);
      Exit;
    }
  if (message('Удалить объект недвижимости (здание/сооружение)?', YesNo + Confirmation) <> cmYes) Exit;
  doDeleteObj := delete rltBuildings where (( pObj == rltBuildings.nRec )) = tsOK;
  oAttrs.DestroyHistory(pObj, roBuilding);
  oRents.DestroyHistory(pObj, roBuilding);
}

TabbedSheet TOP tshMain;

Screen scrMain 'Основные атрибуты' (,,sci1Esc);
Table rltBuildings;
  Bevel b1 { 0,  0, 47,  8, bsLowered, bsFrame};
  Bevel b2 { 1, 18, 41, 22, bsLowered, bsFrame};
  Bevel b3 { 0,  7, 47, 24, bsLowered, bsFrame};
  Bevel b4 { 0, 23, 47, 28, bsLowered, bsFrame};
  Bevel b5 { 0, 27, 47, 32, bsLowered, bsFrame};
  Bevel b6 { 0, 31, 47, 35, bsLowered, bsFrame};
Fields
  OtvPodr.Name              ('Связанный со зданием ЦО',,sci13Esc) : protect;
  ZemComplViewName          ('Земельный участок',,sci13Esc) : protect, QuickChoice;
  rltBuildings.Name         ('Представление объекта недвижимости в иерархии',,) : noprotect;
  rltBuildings.Addr         ('Адрес здания/сооружения',,sci13Esc) : noprotect;
  rltBuildings.IsBuildings  ('Здание/сооружение',,sci13Esc) : [LIST 0 'Здание', 'Сооружение'], protect;
  rltBuildings.InvNo        ('Инвентарный номер здания/сооружения',,) : noprotect;
  rltBuildings.Flats        ('Количество квартир',,) : noprotect, SpinButton[1, 1, 10000];
  rltBuildings.Rooms        ('Количество комнат',,) : noprotect, SpinButton[1, 1, 10000];
  rltBuildings.Material     ('Материал стен',,) : noprotect;
  rltBuildings.BuildYear    ('Год постройки',,) : noprotect, SpinButton[1, 1000, 2100];
  rltBuildings.Floors       ('Этажность (без учета подземных этажей)',,) : noprotect;
  rltBuildings.GroundFloors ('Подземная этажность',,) : noprotect, SpinButton[1, 1, 100];
  rltBuildings.dAkt         ('Дата акта ввода здания в эксплуатацию',,sci13Esc) : ['DD/MM/YYYY'], noprotect;
  rltBuildings.NoAkt        ('Номер акта ввода здания в эксплуатацию',,) : noprotect;
  rltBuildings.IsMonument   ('Памятник архитектуры (Да/Нет)',,sci13Esc) : noprotect;
#PurposesFields(rltBuildings)
  rltRents.wPurposes : [LIST 0 'Основное', 'Вспомогательное'], skip;
  KatNazna.Name : skip;
  fpCO.Name  : skip;
<<

