>>
end;

Embedded brHouseExAttr 'Внешние атрибуты' interface oAttribute;
Cache = Slave
end;

Embedded brHouseExClass 'Внешняя классификация' interface oExClass;
Cache = Slave
end;

end; // TabbedSheet

//********************************************************************************
// Добавление записей в оборудование по F7 без cmSetDefault
//********************************************************************************

function GetMainFormat : longint;
{
  Result := scrMain;
}

procedure Refresh;
{
  RereadRecord(#rltRooms);

  Inherited::Refresh;
}

procedure ReSetPosition;
{
  if ( GetFirst rltRooms = tsOK )
    {}
}

Panel pMain
  Table rltRooms;

HandleEvent

cmUpdateRecord:
  if ( update current rltRooms = tsOK )
    {
      if ( rltRooms.cHouse <> 0 )
        AfterUpdateObj(rltRooms.cHouse, rltRooms.nRec, roHouse, roRoom, rltRooms.NoBTI);

      AfterUpdateObj(rltRooms.cFloor, rltRooms.nRec, roRooms, roRoom, rltRooms.NoFact);
    }

cmPick:
  {
    case CurField of
      #rltHouses.No:
        {
          var pHouse : comp; pHouse := rltRooms.cHouse;

          if ( RunInterface('GetHouse', rltRooms.cBuilding, rltRooms.cFloor, pHouse) <> cmCancel )
            {
              if ( rltRooms.cHouse = 0 )
                // создаем запись комнаты по помещению в иерархии
                if ( GetFirst rltObjTree
                        where (( roHouse == rltObjTree.VidObj and
                                 pHouse  == rltObjTree.cObj )) = tsOK )
                  {
                    var pOwner : comp; pOwner := rltObjTree.nRec;

                    if ( RecordExists rltObjTree where (( pOwner        == rltObjTree.cOwner and
                                                          roRoom        == rltObjTree.VidObj and
                                                          rltRooms.nRec == rltObjTree.cObj )) <> tsOK )
                      insert rltObjTree
                        set rltObjTree.cOwner   := pOwner,
                            rltObjTree.VidObj   := roRoom,
                            rltObjTree.cObj     := rltRooms.nRec,
                            rltObjTree.SortName := rltRooms.NoBTI;
                  }

              set rltRooms.cHouse := pHouse;

              UpdateTable;
            }
        }
    end;
  }

#PurposesCmPickHndlr(rltRooms)

cmDelOnProtect:
  {
    case CurField of
      #rltHouses.No:
        {
          // удаляем запись комнаты по помещению в иерархии
          if ( GetFirst rltObjTree
                  where (( roHouse         == rltObjTree.VidObj and
                           rltRooms.cHouse == rltObjTree.cObj )) = tsOK )
            {
              var pOwner : comp; pOwner := rltObjTree.nRec;

              delete rltObjTree where (( pOwner        == rltObjTree.cOwner and
                                         roRoom        == rltObjTree.VidObj and
                                         rltRooms.nRec == rltObjTree.cObj ));
            }

          set rltRooms.cHouse := 0;

          UpdateTable;

          SetOwnerPosition(rltRooms.cFloor, rltRooms.nRec, roRooms, roRoom);
        }
    end;
  }

end;

end; // Panel

Constructor Init;
{
  Result := InitRltObj(corltRooms);
}

HandleEvent

cmOpenSearch:
  {
    case CurField of
      #rltHouses.No:
        {
          QuickChoiceName := 'qcHouseNo';
          ProcessCommand(cmPick);
        }
    end;
  }

#PurposesCmOpenSearchHndlr

end;

end.
