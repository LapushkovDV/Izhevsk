#include RoomMainAttr.vih
#include AdrFunc.vih
#include RoomAttr.vih
#include RltRentHist.vih
#include Notes.vih

#include RltPurposes.defs

#doc
Базовый интерфейс для объекта недвижимости <b>Комната</b>
#end
Interface RoomMainAttr Cyan;

Create view

Var
  oRents: RltRentHistory;
  oNotes: iNotes;

As select
  if(trim(rltZemCompl.Name) = '', rltZemCompl.Addr, rltZemCompl.Name + ' (' + rltZemCompl.Addr + ')')
    ( FieldName = ZemComplViewName )

, if(trim(rltBuildings.Name) = '', rltBuildings.Addr, rltBuildings.Name + ' (' + rltBuildings.Addr + ')')
    ( FieldName = BuildingViewName )

From
  rltRooms
, rltRooms rltRooms2
, rltSpRooms(rltSpRooms05)
, KatMC
, KatOs
, KatOtpEd
, rltZemCompl
, rltBuildings
, rltFloors
, rltFloors rltFloors2
, rltHouses
, rltObjTree
, rltRents(rltRents03)
, rltCOMPAY rltWorkPlace
, rltCOMPAY rltWorkPlacePers
, fpCO OtvPodr
, KatNazna
#PurposesTbl

Where
((

    pObj                   == rltRooms.nRec
and rltRooms.cFloor        == rltFloors.nRec
and rltRooms.cHouse        == rltHouses.nRec
and rltRooms.cBuilding     == rltBuildings.nRec
and rltBuildings.cZemCompl == rltZemCompl.nRec
and rltRooms.nRec          == rltSpRooms.cRoom
and rltSpRooms.cMC         == KatMC.nRec
and rltSpRooms.cMC         == KatOs.nRec
and rltSpRooms.cEd         == KatOtpEd.nRec
and roRoom                 == rltRents.VidObj
and rltRooms.nRec          == rltRents.cObj
and rltRents.cFpCO         == OtvPodr.nRec
and rltRents.pPurposes     == KatNazna.nRec
and rltRooms.nRec          == rltWorkPlace.cObj
and roRoomWorkPlace        == rltWorkPlace.VidObj
and rltWorkPlace.Nrec      == rltWorkPlacePers.cObj
and roRoomWorkPlaceP       == rltWorkPlacePers.VidObj

#PurposesRelat(rltRooms)

));

Function GetRoomArea(dDate : date) : double;
var Buf : type$rltAttrHist;
{
  oAttrs.GetHistoryRec(rltRooms.nRec, roRoom, dDate, Buf);
  GetRoomArea := Buf.doValues[4]; // площадь комнаты
}

#include AdrFunc.var

Function doInsertObj(pRltOwner, pOwner : comp) : boolean;
var
  NewNoFact
, NewNoBTI : string;
  pHouse   : comp;
{
  if ( GetFirst rltFloors2 where (( pRltOwner == rltFloors2.nRec )) = tsOK )
    {
    }

  pHouse   := 0;
  NewNoBTI := '';

  if ( GetFirst rltObjTree where (( pOwner == rltObjTree.nRec )) = tsOK )
    if ( rltObjTree.VidObj = roHouse )
      {
        pHouse := rltObjTree.cObj;

        if ( GetLast rltRooms2
                where (( rltFloors2.cBuilding == rltRooms2.cBuilding and
                         rltFloors2.nRec      == rltRooms2.cFloor    and
                         pHouse               == rltRooms2.cHouse ))
                ordered by rltRooms2.cBuilding, rltRooms2.cFloor, rltRooms2.cHouse, rltRooms2.NoBTI = tsOK )
          NewNoBTI := rltRooms2.NoBTI
        else
          NewNoBTI := '000';

        NextNumStr(NewNoBTI);
      }

  if ( GetLast rltRooms2
          where (( rltFloors2.cBuilding == rltRooms2.cBuilding and
                   rltFloors2.nRec      == rltRooms2.cFloor ))
          ordered by rltRooms2.cBuilding, rltRooms2.cFloor, rltRooms2.NoFact = tsOK )
    NewNoFact := rltRooms2.NoFact
  else
    NewNoFact := '000';

  NextNumStr(NewNoFact);

  var NewNrec : comp; NewNrec := GetNextNrec(#rltRooms, 0);

  if ( (insert rltRooms2
          set rltRooms2.nRec      := NewNrec,
              rltRooms2.cHouse    := pHouse,
              rltRooms2.cBuilding := rltFloors2.cBuilding,
              rltRooms2.cFloor    := rltFloors2.nRec,
              rltRooms2.NoFact    := NewNoFact,
              rltRooms2.NoBTI     := NewNoBTI) <> tsOK )
    doInsertObj := false
  else
    {
      if ( pHouse <> 0 )
      // создаем запись комнаты по этажу в иерархии
        if ( GetFirst rltObjTree
                where (( roRooms   == rltObjTree.VidObj and
                         pRltOwner == rltObjTree.cObj )) = tsOK )
          {
            var pOwner : comp; pOwner := rltObjTree.nRec;

            insert rltObjTree
              set rltObjTree.cOwner   := pOwner,
                  rltObjTree.VidObj   := roRoom,
                  rltObjTree.cObj     := NewNrec,
                  rltObjTree.SortName := NewNoFact;
          }

      doInsertObj := true;

      oAttrs.CreateHistory(rltRooms2.nRec, roRoom);
      AfterInsertObj(pOwner, rltRooms2.nRec, roRoom, if(pHouse = 0, rltRooms2.NoFact, rltRooms2.NoBTI));
      SelectField(#rltRooms.NoFact);
    }
}

Function doDeleteObj(pObj : comp) : boolean;
{
  doDeleteObj := false;

  if ( message('Удалить объект недвижимости (комнату)?', YesNo+CancelButton) <> cmYes )
    Exit;

  delete safe rltSpRooms;
  _Loop rltWorkPlace
  {
    _Loop rltWorkPlacePers
      delete current rltWorkPlacePers;
    delete current rltWorkPlace;
  }

  doDeleteObj := delete rltRooms where (( pObj == rltRooms.nRec )) = tsOK;
  oAttrs.DestroyHistory(pObj, roRoom);
  oRents.DestroyHistory(pObj, roRoom);
}

TabbedSheet TOP tshMain;

Screen scrMain 'Основные атрибуты' (,,sci1Esc);
  Table rltRooms;

  Bevel b1 { 0,  0, 47,  9, bsLowered, bsFrame};
  Bevel b2 { 2,  9, 33, 14, bsLowered, bsFrame};
  Bevel b3 { 0,  8, 47, 18, bsLowered, bsFrame};
  Bevel b5 { 0, 14, 47, 18, bsLowered, bsFrame};
  Bevel b6 { 0, 17, 47, 22, bsLowered, bsFrame};
  Bevel b7 { 0, 21, 47, 26, bsLowered, bsFrame};
Fields
  ZemComplViewName   : Skip;
  BuildingViewName   : Skip;
  rltBuildings.InvNo : Skip;
  rltFloors.No       : Skip;
  rltFloors.Level    : Skip;
  rltRooms.NoFact ('Фактический номер комнаты',,) : NoProtect;
  rltHouses.No    ('Входит в состав помещения',,sci13Esc) : Protect, QuickChoice;
  rltRooms.NoBTI  ('Номер комнаты в помещении по БТИ',,) : NoProtect;
  oRents.GetRentStatusName(rltRooms.nRec, roRoom, Cur_Date): skip;
  OtvPodr.Name       : Skip;
#PurposesFields(rltRooms)
  rltRents.wPurposes : [LIST 0 'Основное', 'Вспомогательное'], Skip;
  KatNazna.Name      : Skip;
<<

