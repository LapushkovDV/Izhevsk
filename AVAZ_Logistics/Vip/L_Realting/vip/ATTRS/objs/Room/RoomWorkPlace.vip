#include RoomMainAttr.vih
#include RoomWorkPlace.vih
#include AdrFunc.vih
#include RoomAttr.vih
#include RltRentHist.vih
#include Notes.vih
#include Getkau.vih

#include RltPurposes.defs

#doc
Базовый интерфейс для объекта недвижимости <b>Комната</b>
Базовый интерфейс для объекта недвижимости Комната - рабочие места
#end
Interface RoomWorkPlace Cyan;
Var
  oNotes: iNotes;
#include AdrFunc.var
#include GetKau.var

Create view
var
  wVidObj  // Вид объекта - рабочие места
, wVidObjP // Вид объекта - рабочие места - сотрудники
          : word;
As select
  rltRooms.Nrec
From
  rltRooms
, rltSpRooms(rltSpRooms05)
, KatMC
, KatOs
, KatOtpEd
, rltZemCompl
, rltBuildings
, rltFloors
, rltHouses
, rltObjTree
, rltCOMPAY rltWorkPlace
, rltCOMPAY rltWorkPlace2
, rltCOMPAY rltWorkPlacePers
, rltCOMPAY rltWorkPlacePers2
, fpCO OtvPodr
, KatNotes
, Catalogs CatPost
, Persons
, Appointments
#PurposesTbl

Where
((

    pObj                   == rltRooms.nRec
and rltRooms.cFloor        == rltFloors.nRec
and rltRooms.cHouse        == rltHouses.nRec
and rltRooms.cBuilding     == rltBuildings.nRec
and rltBuildings.cZemCompl == rltZemCompl.nRec
and rltRooms.nRec          == rltSpRooms.cRoom
and rltSpRooms.cMC         == KatMC.nRec
and rltSpRooms.cMC         == KatOs.nRec
and rltSpRooms.cEd         == KatOtpEd.nRec
and pObj                   == rltWorkPlace.cObj
and wVidObj                == rltWorkPlace.VidObj  //roRoomWorkPlace
and rltWorkPlace.cOtpED    == KatNotes.Nrec
//--------------------
and rltWorkPlace.Nrec      == rltWorkPlacePers.cObj
and wVidObjP               == rltWorkPlacePers.VidObj //roRoomWorkPlaceP
and rltWorkPlacePers.cOtpEd   == CatPost.Nrec
and rltWorkPlacePers.cUsl     == Persons.Nrec
and Persons.AppointCur        == Appointments.Nrec
and rltWorkPlacePers.CFPCO    == OtvPodr.nRec
//----
and rltWorkPlace.Nrec      == rltWorkPlacePers2.cObj
and wVidObjP               == rltWorkPlacePers2.VidObj //roRoomWorkPlaceP
and ( rltWorkPlacePers2.DTO = ZeroDate or rltWorkPlacePers2.DTO > cur_date )

#PurposesRelat(rltRooms)

));

Create View vSpr
var
  pStaff: comp;
  pPodr : comp;
as select
  extcatlinks.objtype
From
  extcatlinks
, Fpco
, KatPodr
where ((
    11              == extcatlinks.objtype
and  1              == extcatlinks.modtype
and pStaff          == extcatlinks.staffcat
and pPodr           == KatPodr.Nrec  // extcatlinks.extcat
and 2               == FpCo.coTable
and KatPodr.Nrec    == FpCo.CMeaN
));

Function GetRoomArea(dDate : date) : double;
var Buf : type$rltAttrHist;
{
  oAttrs.GetHistoryRec(rltRooms.nRec, roRoom, dDate, Buf);
  GetRoomArea := Buf.doValues[4]; // площадь комнаты
}

// поиск центра ответственности по структурному подразделению
Function FindFPCOBtStaffDep(_cRec : Comp) : comp;
{
  Result := 0;
  vSpr.pStaff := _cRec;

  if VSpr.Getfirst extcatlinks <> tsok
    Exit;

  set vSpr.pPodr := vSpr.extcatlinks.extcat;

  if vSpr.Getfirst KatPodr <> tsok
    Exit;

  DO {
    if VSpr.Getfirst FpCO = tsok
    {
      Result := vSpr.Fpco.Nrec;
      Break;
    }
    var _cTmp : comp =  vSpr.KatPodr.cPodr;

    if _cTmp = 0
      break;

    set vSpr.pPodr := _cTmp;

    if vSpr.Getfirst KatPodr <> tsok
      break;

  } while vSpr.pPodr <> 0;
}

Function setDefualtPers : boolean;
{
  Result := False;
  if Getfirst Persons <> tsok
    Exit;

  rltWorkPlacePers.cFPco  := FindFPCOBtStaffDep(Persons.Department);
  if Getfirst Appointments = tsok
    set rltWorkPlacePers.cOtpEd := Appointments.Post;
  rltWorkPlacePers.DFrom := Cur_Date;
}

Function doInsertObj(pRltOwner, pOwner : comp) : boolean;
{
  Result := False;
  var _wVidObj  : word = wVidObj;
  var _wVidObjP : word = wVidObjP;

  // pRltOwner - rltObj.nrec
  if pRltOwner <> 0
    if Getfirst rltObjTree where (( pRltOwner == rltObjTree.Nrec )) = tsok
    {
      case rltObjTree.VidObj of
      roRooms, roRoom :
      {
        _wVidObj  := roRoomWorkPlace;
        _wVidObjP := roRoomWorkPlaceP;
      }
      else
      {
        Message('Добавление рабочего места для вида объекта ' + string(rltObjTree.VidObj)  + ' не предусмотрена' );
        Exit;
      }
      end;
    }
  var _wNum : word = 1;
  if getlast rltWorkPlace2 where ((
            pOwner         == rltWorkPlace2.cObj
        and _wVidObj       == rltWorkPlace2.VidObj
      )) = tsok
    _wNum := rltWorkPlace2.wYear;


  var NewNrec : comp; NewNrec := GetNextNrec(#rltWorkPlace, 0);
  if (Insert rltWorkPlace set
      rltWorkPlace.wYear  := _wNum
    , rltWorkPlace.cObj   := pOwner
    , rltWorkPlace.VidObj := _wVidObj
    , rltWorkPlace.DFrom  := Cur_date
    , rltWorkPlace.sNum   := LPadCh(string(_wNum, 0, 0),'0',5)
    , rltWorkPlace.cOtpEd := oNotes.GetFirstNote(cgDoc_0463, 0)
    , rltWorkPlace.Nrec   := NewNrec
    ) = tsok
      Result := true;
}

Function doDeleteObj(pObj : comp) : boolean;
{
  Result := false;
  if pObj <> 0
    if Getfirst rltWorkPlace where (( pObj == rltWorkPlace.Nrec )) <> tsok
    {
      Message('Запись ' + string(pObj,0,0) +' не найдена в рабочих местах!');
      Exit;
    }
  if ( message('Удалить рабочее место?', YesNo+CancelButton) <> cmYes )
    Exit;

  _Loop rltWorkPlacePers where (( rltWorkPlace.cObj == rltWorkPlacePers.cObj
       and  rltWorkPlace.VidObj + 1  == rltWorkPlacePers.VidObj ))
    delete current rltWorkPlacePers;

  Result := delete current rltWorkPlace = tsok;
}

Window wnWorkPlaceEdit 'Редактирование рабочего места' (,,sci1Esc);
Show at (,,50,10);
screen scrWorkPlaceEdit;
  Table rltWorkPlace;
Fields
  rltWorkPlace.wYear ('Номер'         )  :  NoProtect, NoDel ;
  rltWorkPlace.sNum  ('Наименование'  )  :  NoProtect, NoDel;
  rltWorkPlace.DFrom ('Действует с'   )  :  NoProtect, NoDel;
  rltWorkPlace.DTO   ('Действует по'  )  :  NoProtect, NoDel;
  KatNotes.Name      ('Статус'      ,, sci13Esc)  :  Protect, NoDel, EditButton, PickButton;
<<
  `Номер        ` .@@@@@@@@@@@@
  `Наименование ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Действует с  ` .@@@@@@@@@@@@
  `Действует по ` .@@@@@@@@@@@@
  `Статус       ` .@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end; //scrWorkPlaceEdit
HandleEvent
cmPick:
{
  case CurField of
    #KatNotes.Name:
    {
      UpdateTable;
      var fcNrec : comp = rltWorkPlace.Nrec;
      var fcNote : comp = rltWorkPlace.cOtpEd;
      var fwStat : word = if(isValid(#KatNotes), KatNotes.Status, 0);
      var fwStatP: word = fwStat;
      var fwMask : word = 0;
      if (RunInterface('StatLog', word(1), fcNrec, cgDoc_0463, fwStat, fcNote, fwMask) = cmDefault)
      {
        Set rltWorkPlace.cOtpED  := fcNote;
        Update current rltWorkPlace;
      }

    }
  end;
}
cmEdit:
{
  case Curfield of
  #KatNotes.Name :
  {
    RunInterface('StatLog'
               , word(0)
               , rltWorkPlace.nRec
               , cgDoc_0463
               , if(isValid(#KatNotes), KatNotes.Status, 0)
               , rltWorkPlace.cOtpEd
               , word(0)
                );

  }
  end;
}
end;
end; //Window wnWorkPlaceEdit

Window wnPersonsEdit 'Редактирование сотрудника' (,,sci1Esc);
Show at (,,70,10);
screen scrPersonsEdit;
  Table rltWorkPlacePers;
Fields
  Persons.DisDate        ('Дата увольнения')    : Protect ,NoDel;
  Persons.Fio            ('Фио'                   ,,sci13Esc) : Protect, NoDel, PickButton ;
  rltWorkPlacePers.DFrom ('Действует с'           ,,sci1Esc ) : NoProtect, NoDel;
  rltWorkPlacePers.DTO   ('Действует по'          ,,sci1Esc ) : NoProtect, NoDel;
  CatPost.Name           ('Должность'             ,,sci138Esc) : Protect, NoDel;
  OtvPodr.Name           ('Центр ответственности' ,,sci138Esc) : Protect, NoDel;
<<
  `Фио                  `                  `Уволен` .@@@@@@@@@@@@
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Действует с ` .@@@@@@@@@@  `по` .@@@@@@@@@@@@
  `Должность            `
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  `Центр ответственности`
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end; //scrWorkPlaceEdit
HandleEvent
cmPick:
{
  SetModified(True);
  UpdateTable;
  case CurField of
  #Persons.Fio    :
  {
    var _pPersons : comp = rltWorkPlacePers.cUsl;
    iGetKau.GetCodeKau(cgiPick, cgkau_persons, _pPersons);
    if _pPersons <> 0
      if rltWorkPlacePers.cUsl <> _pPersons
      {
        setDefualtPers;
        UpdateTable;
      }

  }
  #CatPost.Name   :
  {
    var _cTmp : comp = rltWorkPlacePers.cOtpED;
    if RunInterface('PickCatalog2',-22,_cTmp,0)<>cmCancel
    {
      set rltWorkPlacePers.cOtpED := _cTmp;
      UpdateTable;
    }
  }
  #OtvPodr.Name   :
  {
    var pCO : comp; pCO := rltWorkPlacePers.cFpCO;
    if (RunInterface('GetCO', cgiPick, comp(0), comp(0), pCO) <> cmCancel)
    {
      set rltWorkPlacePers.cFpCO := pCO;
      UpdateTable;
    }

  }
  end;
}
end;
end; //Window wnPersonsEdit


Browse brWorkPlace 'Рабочие места' (,,sci1478Esc);
  Show at (,,,10);
  Table rltWorkPlace;
Fields
  {Font= { Bold = isValidall(#rltWorkPlacePers2) }} ;
  rltWorkPlace.wYear 'Номер'         : [5] , Protect, NoDel ;
  rltWorkPlace.sNum  'Наименование'  : [20], Protect, NoDel;
  rltWorkPlace.DFrom 'Действует с'   : [12], Protect, NoDel;
  rltWorkPlace.DTO   'Действует по'  : [12], Protect, NoDel;
  KatNotes.Name      'Статус'        : [10], Protect, NoDel;
end;

Browse brPersons 'Работники' (,,sci1478Esc);
  Show at (,11,,);
  Table rltWorkPlacePers;
Fields
  {Font= { Color = if(Persons.DisDate <> ZeroDate , ColorSysRed , 0) } };
  Persons.Fio        'Фио'          : [40] , Protect, NoDel ;
  Persons.DisDate    'Уволен'     ('Дата увольнения')   : Protect,NoDel;
  rltWorkPlacePers.DFrom 'Действует с' : [12], Protect, NoDel;
  rltWorkPlacePers.DTO   'Действует по': [12], Protect, NoDel;
  CatPost.Name        'Должность'             (,,sci1378Esc) : [20], Protect, NoDel;
  OtvPodr.Name        'Центр ответственности' (,,sci1378Esc) : [20], Protect, NoDel;
end;


//********************************************************************************
// Добавление записей в оборудование по F7 без cmSetDefault
//********************************************************************************

function GetMainFormat : longint;
{
  Result := brWorkPlace;
}

procedure Refresh;
{
  RereadRecord(#rltWorkPlace);

  Inherited::Refresh;
}

procedure SetPositionVidObj(pNewPos : comp; _VidObj : word);
{
  wVidObj  := _VidObj;
  wVidObjP := _VidObj +1;
  set pObj  := pNewPos;
}

procedure ReSetPosition;
{
  if ( GetFirst rltWorkPlace = tsOK )
    {}
}

TableEvent Table rltWorkPlace;
cmSetDefault:
{
  //abort;
}
cmUpdateRecord:
{
  if ( update current rltWorkPlace = tsOK )
    {
    }
}
cmDeleteRecord:
{
  doDeleteObj(0);
}
//PurposesCmPickHndlr(rltWorkPlace)


end;


TableEvent Table rltWorkPlacePers;
cmSetDefault:
{
  //abort;
}
cmUpdateRecord:
{
  if ( update current rltWorkPlacePers = tsOK )
    {
    }
}
cmDeleteRecord:
{
  if Message('Удалить запись ?' ,YesNo) =cmYes
    Delete current rltWorkPlacePers;
}


end;

Constructor Init;
{
  Result := InitRltObj(corltRooms);
  wVidObj  := roRoomWorkPlace;
  wVidObjP := roRoomWorkPlaceP;

}

HandleEvent
cmEdit :
{
  PutCommand(cmDefault);
}
cmInsert :
{
  case CurTable of
  #rltWorkPlace :
  {
    doInsertObj(0,pObj);
    RunWindowModal(wnWorkPlaceEdit);
    ReReadRecord(#rltWorkPlace);
    abort;
  }
  #rltWorkPlacePers :
  {

    var _pPersons : comp = 0;
    iGetKau.GetCodeKau(cgiPick, cgkau_persons, _pPersons);
    if  _pPersons <> 0 then
    {
      ClearBuffer(#rltWorkPlacePers);
      rltWorkPlacePers.VidObj := wVidObjP;
      rltWorkPlacePers.cObj   := rltWorkPlace.Nrec;
      rltWorkPlacePers.cUsl   := _pPersons;
      rltWorkPlacePers.DFrom  := Cur_Date;
      setDefualtPers;
      insert current rltWorkPlacePers;
      RunwindowModal(wnPersonsEdit);
      ReReadRecord(#rltWorkPlacePers);
    }
    abort;
  }
  end;
}
cmDefault:
{
  case GetCurrentFormat  of
  brWorkPlace : RunWindowModal(wnWorkPlaceEdit);
  brPersons   : RunwindowModal(wnPersonsEdit);
  end;
}

cmOpenSearch:
  {
  }

#PurposesCmOpenSearchHndlr

end;

end.
