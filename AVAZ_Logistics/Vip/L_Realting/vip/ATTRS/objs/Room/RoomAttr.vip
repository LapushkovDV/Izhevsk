#include RoomAttr.vih
#include RltComPay.vih
#include RltImpAndPay.vih
#include RoomWorkPlace.vih

#doc
Атрибуты объекта недвижимости <b>Комната</b>
#end
Interface RoomAttr Cyan;
#include RoomWorkPlace.var

Create view

Var
  oComPay : tRltComPay;
  oImpPay : tRltImpAndPay;
  wVidPos : word;

As select
  iCASE(rltSpRooms.Vid mod 10; KatMC.Name, KatOs.NameOs, rltSpRooms.Name; rltSpRooms.Name)
    ( FieldName = ThingName )

, iCASE(rltSpRooms.Vid mod 10; KatMC.BarKod, KatOs.InNum, ''; '')
    ( FieldName = ThingKod )

From
  rltSpRooms(rltSpRooms05)
, KatMC
, KatOs
, KatOtpEd
, Pick

Where
((
    pObj           == rltSpRooms.cRoom and ( (rltSpRooms.Vid div 10) = wVidPos )
and rltSpRooms.cMC == KatMC.nRec
and rltSpRooms.cMC == KatOs.nRec
and rltSpRooms.cEd == KatOtpEd.nRec
));

Function GetRoomArea(dDate : date) : double;
var Buf : type$rltAttrHist;
{
  oAttrs.GetHistoryRec(pObj, roRoom, dDate, Buf);
  GetRoomArea := Buf.doValues[4]; // площадь комнаты
}

#doc
Окно для встраивания в интерфейс <link Interface L_Realting::VipRltObjTree>Объекты недвижимости</link> с информацией по объекту недвижимости <b>Комната</b>
#end
Window wMain Cyan

Screen srcAttrs;
  Show At (,,,2) fixed_Y;
Fields
  'АТРИБУТЫ КОМНАТЫ' : protect, centered, {Font = {Bold = true}};
<<
  .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
>>
end;

TabbedSheet BOTTOM tshMain;
  Show At (,3,,);

Embedded emMain 'Основная информация' interface oMain;
end;

Embedded emAttrs 'Изменяемые параметры' interface oAttrs.wHistory;
end;

Embedded emWorkPlace 'Рабочие места' interface oRoomWorkPlace;
end;

Browse brSpRoomsO 'Оборудование' (,,sci1378Esc);
  Table rltSpRooms;
Fields
  rltSpRooms.Vid 'Вид'         ('Вид оборудования. Матценность/Основное средство/Пользовательское значение',,)
                                 : [LIST 'МЦ', 'ОС', 'Прочее'], [7], Protect, NoAutoSize, Centered;
  ThingName      'Наименование'('Наименование оборудования',,) : [25], Protect, QuickChoice, NoDel;
  ThingKod       'Номер'       ('Номенклатурный/инвентарный номер оборудования',,) : [10], Protect, QuickChoice, NoDel;
  KatOtpEd.ABBR  'ЕдИзм'       ('Единица измерения',,) : [5], Protect, QuickChoice, DelRel, NoAutoSize, Centered;
  rltSpRooms.Kol 'Количество'  ('Количество',,sci178Esc) : [6.2, '\2p[|-]36`666.88'], NoProtect, NoAutoSize;
end;

Browse brSpRoomsK 'Коммуникации' (,,sci1378Esc);
  Table rltSpRooms;
Fields
  rltSpRooms.Vid 'Вид'         ('Вид коммуникации. Матценность/Основное средство/Пользовательское значение',,)
                                 : [LIST 10 'МЦ', 11 'ОС', 12 'Прочее'], [7], Protect, NoAutoSize, Centered;
  ThingName      'Наименование'('Наименование коммуникации',,) : [25], Protect, QuickChoice, NoDel;
  ThingKod       'Номер'       ('Номенклатурный/инвентарный номер коммуникации',,) : [10], Protect, QuickChoice, NoDel;
  KatOtpEd.ABBR  'ЕдИзм'       ('Единица измерения',,) : [5], Protect, QuickChoice, DelRel, NoAutoSize, Centered;
  rltSpRooms.Kol 'Кол-во'      ('Количество',,sci178Esc) : [6.2, '\2p[|-]36`666.88'], NoProtect, NoAutoSize;
end;

Embedded emRents 'Аренда/закрепление' Interface oRents.wRents;
end;

Embedded emImpPay 'Благоустройство' Interface oImpPay;
end;

Embedded emComPay 'Коммунальные начисления' Interface oComPay.winRComPay;
end;


end; // TabbedSheet

Procedure OnChangeVid;
{
  ToggleFieldProtected(#ThingName, (rltSpRooms.Vid mod 10) <> 2);

  ToggleFieldSelectable(#ThingKod     , (rltSpRooms.Vid mod 10) <> 2);
  ToggleFieldSelectable(#KatOtpEd.ABBR, (rltSpRooms.Vid mod 10) <> 1);

  SetHelpAndStatusContext(brSpRoomsO, -1, if((rltSpRooms.Vid mod 10) = 2, sci178Esc, sci1378Esc), '');
  SetHelpAndStatusContext(brSpRoomsK, -1, if((rltSpRooms.Vid mod 10) = 2, sci178Esc, sci1378Esc), '');
}

//********************************************************************************
// Обработчик табличных событий оборудования/коммуникаций комнаты
//********************************************************************************
Panel pSpRooms
 Table rltSpRooms;

HandleEvent

cmSetDefault:
{
  rltSpRooms.Vid := 10 * wVidPos;
  OnChangeVid;
}

cmPositionChanged:
{

  OnChangeVid;
}

cmIdle:
{
  OnChangeVid;
}

cmExprFieldChanged:
{
  case CurField of
    #ThingName:
      if ( (rltSpRooms.Vid mod 10) = 2 )
        {
          set rltSpRooms.Name := ExprFieldValue;
        }
  end;
}

cmCheckField:
{
  case CurField of
    #rltSpRooms.Vid:
      {
        if ( rltSpRooms.Vid <> word(OldFieldValue) )
          {
            if ( rltSpRooms.Name <> '' )
              set rltSpRooms.Name := '';

            if ( rltSpRooms.cMC <> 0 )
              set rltSpRooms.cMC := 0;

            if ( rltSpRooms.cEd <> 0 )
              set rltSpRooms.cEd := 0;

            OnChangeVid;
          }
      }
    #rltSpRooms.Kol:
      {
        if ( rltSpRooms.Kol <= 0.0 )
          {
            message('Количество должно быть положительным числом!', Warning);
            Abort;
            Exit;
          }

        if IsValid(#KatOtpEd)
          if ( ( KatOtpEd.Diskret = 1 ) AND ( trunc(rltSpRooms.Kol) <> rltSpRooms.Kol ) )
            {
              message('Данная отпускная единица неделима!'#13#13 + 'Введите целое число!', Information);
              Abort;
              Exit;
            }
      }
  end;
}

cmCheckRecord:
{
  if (
      ( rltSpRooms.cMC = 0 ) AND ( (rltSpRooms.Vid mod 10) <> 2 )
       OR
      ( rltSpRooms.Name = '' ) AND ( (rltSpRooms.Vid mod 10) = 2 )
     )
    {
      message('Укажите ' + if(wVidPos = 0, 'оборудование', 'коммуникацию') + '!', Warning);
      SelectField(#ThingName);
      PutCommand(cmPick);
      Abort;
      Exit;
    }

  if ( ( rltSpRooms.cEd = 0 ) AND ( (rltSpRooms.Vid mod 10) = 0 ) )
    {
      message('Укажите единицу измерения!', Warning);
      SelectField(#KatOtpEd.ABBR);
      PutCommand(cmPick);
      Abort;
      Exit;
    }

  if ( rltSpRooms.Kol <= 0.0 )
    {
      message('Укажите количество!', Warning);
      SelectField(#rltSpRooms.Kol);
      Abort;
      Exit;
    }
}

cmInsertRecord:
  insert current rltSpRooms;

cmDeleteRecord:
  if ( message('Удалить "' + ThingName + '" из списка ' + if(wVidPos = 0, 'оборудования', 'коммуникаций') + '?', YesNo + CancelButton) = cmYes )
    delete current rltSpRooms;

cmUpdateRecord:
  update current rltSpRooms;

cmPick:
{
  case CurField of
    #ThingName, #ThingKod:
      {
        var pMC : comp; pMC := rltSpRooms.cMC;

        case (rltSpRooms.Vid mod 10) of
        //******************************************************************************
          0:
            if ( RunInterface('GetMC', pMC) = cmCancel )
              Exit;
        //******************************************************************************
          1:
            if (RunInterface('KatOss',
                             word(15), // Тип
                             pMC,
                             word(1),  // 1 - одиночный выбор
                             comp(0),  // ограничения по подразделению
                             comp(0),  // ограничения по виду
                             comp(0),  // ограничения по МОЛ
                             comp(0)   // не показывать этот
                            ) = cmCancel )
              Exit;
        //******************************************************************************
          2:
            Exit;
        end;

        if ( pMC = rltSpRooms.cMC )
          Exit;

        PushPos(#rltSpRooms);

        var pRoom : comp; pRoom := rltSpRooms.cRoom;

        if ( RecordExists rltSpRooms
                   where (( pRoom == rltSpRooms.cRoom and
                            pMC   == rltSpRooms.cMC )) = tsOK )
          {
            PopPos(#rltSpRooms);
            message(if(wVidPos = 0, 'Такое оборудование уже указано', 'Такая коммуникация уже указана') + ' в списке!', Information);
          }
        else
          {
            PopPos(#rltSpRooms);

            set rltSpRooms.cMC := pMC;

            rltSpRooms.Name := iCASE((rltSpRooms.Vid mod 10); KatMC.Name, KatOs.NameOs, ''; '');

            if ( (rltSpRooms.Vid mod 10) = 0 )
              if ( GetFirst KatOtpEd
                      where (( pMC     == KatOtpEd.cMCUSL and
                               word(1) == KatOtpEd.Akt    and
                               word(1) == KatOtpEd.PrMC )) = tsOK )
                set rltSpRooms.cEd := KatOtpEd.nRec;

            if ( rltSpRooms.Kol <= 0.0 )
              SelectField(#rltSpRooms.Kol);
          }
      }

    #KatOtpEd.ABBR:
      {
        if ( rltSpRooms.cEd = 0 )
          Exit;

        var pEd : comp; pEd := rltSpRooms.cEd;

        var tmpKoef : double;
        tmpKoef := if(IsValid(#KatOtpEd), KatOtpEd.Koef, 1);

        if ( RunInterface('GetOtpEd', rltSpRooms.cMC, pEd, word(1)) <> cmCancel )
          if ( pEd <> rltSpRooms.cEd )
            {
              set rltSpRooms.cEd := pEd;

              if ( wGetTune('Doc.ChangeOtpEd') = 0 )
                {
                  set rltSpRooms.Kol := rltSpRooms.Kol * (tmpKoef / KatOtpEd.Koef);

                  if ( ( KatOtpEd.Diskret = 1 ) AND ( trunc(rltSpRooms.Kol) <> rltSpRooms.Kol ) )
                    set rltSpRooms.Kol := trunc(rltSpRooms.Kol + 1);
                }
            }
      }
  end;
}

end; // HandleEvent

end; // Panel

//********************************************************************************
// Добавление записей в оборудование/коммуникации по F7 без cmSetDefault
//********************************************************************************

HandleEvent

cmAltInsert:
{
  if ( CurTable <> #rltSpRooms )
    Exit;

  if ( RunInterface('GetSomeMC', word(1)) <> cmCancel )
    {
      var pRoom : comp; pRoom := rltSpRooms.cRoom;

      StartNewVisual(vtNumericVisual
                   , vfTimer + vfBreak + vfConfirm
                   , 'Пополнение ' + if(wVidPos = 0, 'оборудования', 'коммуникаций') + ' комнаты'#13
                   + 'выбранными позициями каталога...'#13
                   , 1);

      _loop Pick where (( word(7) == Pick.wList )) ordered by index pick02
        {
          if not NextVisual
            Break;

          var IsFound : boolean;

          IsFound := GetFirst rltSpRooms
                        where (( pRoom     == rltSpRooms.cRoom and
                                 Pick.cRec == rltSpRooms.cMC   and
                                 ((rltSpRooms.Vid mod 10) = 0)
                              )) = tsOK;

          if not IsFound
            ClearBuffer(#rltSpRooms);

          if ( GetFirst KatMC where (( Pick.cRec == KatMC.nRec )) <> tsOK )
            {}

          if ( GetFirst KatOtpEd
                  where (( Pick.cRec == KatOtpEd.cMCUSL and
                           word(1)   == KatOtpEd.Akt    and
                           word(1)   == KatOtpEd.PrMC )) = tsOK )
            rltSpRooms.cEd := KatOtpEd.Nrec
          else
            {
              message('Не задана активная отпускная единица измерения для ' + KatMC.Name + '!', Warning);
              rltSpRooms.cEd := 0;
            }

          rltSpRooms.Vid  := wVidPos * 10;
          rltSpRooms.cMC  := Pick.cRec;
          rltSpRooms.Name := KatMC.Name;

          if ( ( KatOtpEd.Diskret = 1 ) AND ( trunc(Pick.PickKol) <> Pick.PickKol ) )
            rltSpRooms.Kol := rltSpRooms.Kol + trunc(Pick.PickKol + 1)
          else
            rltSpRooms.Kol := rltSpRooms.Kol + Pick.PickKol;

          if IsFound
            update current rltSpRooms
          else
            insert current rltSpRooms;
        }

      StopVisual('', 0);
      ReReadRecord(#rltSpRooms);
    }
  Stop;
}

end;

//********************************************************************************

function GetMainFormat: longint;
{
  Result := emMain;
}

function GetAttrsFormat: longint;
{

  Result := emAttrs;
}

function GetRentFormat: longint;
{
  Result := emRents;
}

procedure Refresh;
{
  ReReadRecord(#rltSpRooms);
  OnChangeVid;
}

function SetCurrentPosition(aPanel: longint): boolean;
{
  Result := TRUE;
  aPanel:=if(aPanel=-65537,if(target=0,GetMainFormat,target),aPanel);
  if NOT inherited::SetCurrentPosition(aPanel)
    case aPanel of
      emComPay : oComPay.SetPosition(pObj, roRoom);
      emImpPay : oImpPay.SetPosition(pObj, roRoom);
      emWorkPlace : oRoomWorkPlace.SetPositionVidObj(pObj, roRoomWorkPlace);
    else
      Result := FALSE;
    end;
}

function RefreshCurrentPosition(aPanel: longint): boolean;
{
  Result := TRUE;
  if NOT inherited::RefreshCurrentPosition(aPanel)
    case aPanel of
      emComPay : oComPay.Refresh;
      emImpPay : oImpPay.Refresh;
    end;
}

HandleEvent

cmOpenSearch:
  {
    case CurField of
      #ThingName:
        if ( (rltSpRooms.Vid mod 10) = 0 )
          {
            QuickChoiceName := 'qcKatMcName';
            ProcessCommand(cmPick);
          }

      #ThingKod:
        if ( (rltSpRooms.Vid mod 10) = 0 )
          {
            QuickChoiceName := 'qcKatMcBarKod';
            ProcessCommand(cmPick);
          }

      #KatOtpEd.ABBR:
        {
          QuickChoiceName := 'qcKatOtpEdGrMABBR';
          ProcessCommand(cmPick);
        }
    end;
  }

cmChangeTabbedSheetFormat: // + GetCurrentFormat
  if not UpdateTable
    {
      Abort;
      Stop;
    }

cmSwitchFormat:
  if NOT OnSwitchFormat
    if UpdateTable
      case Target of
        emComPay  : oComPay.SetPosition(pObj, roRoom);
        emImpPay  : oImpPay.SetPosition(pObj, roRoom);
        emWorkPlace : oRoomWorkPlace.SetPositionVidObj(pObj, roRoomWorkPlace);
        brSpRoomsO: { set wVidPos := 0; RereadRecord(#rltSpRooms); }
        brSpRoomsK: { set wVidPos := 1; RereadRecord(#rltSpRooms); }
      end;

cmHotKeys:
  case GetCurrentFormat of
    brSpRoomsO, brSpRoomsK:
      PutHotCommand(RunMenu('mnuRoomAttr_SpRoom'));
  end;

end;

end; // Window

procedure SetOwnerPositionOfRoom(pRltOwner, pObj : comp; wVidObjOwner, wVidObj : word);
{
  SetOwnerPosition(pRltOwner, pObj, wVidObjOwner, wVidObj);
}

Constructor Init;
{
  Result := FALSE;

  if NOT InitRltObj(roRoom)
    Exit;

  LoadVipRef(oComPay, 'vRltComPay'  );
  LoadVipRef(oImpPay, 'RltImpAndPay');

  BindEvent(SetOwnerPositionOfRoom, oMain.SetOwnerPosition);

  Result := TRUE;

}
end.

#doc
Элемент локального меню главного окна интерфейса <link Interface L_Realting::RoomAttr>L_Realting::RoomAttr - Атрибуты объекта недвижимости <b>Комната</b></link>
#end
mnuRoomAttr_SpRoom Menu
{
  - 'Добавление позиций из каталога МЦ', cmAltInsert, , , 'Alt+F7', kbAltF7, sci1Esc;
}
