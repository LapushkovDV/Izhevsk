
#component "L_Realting"
#include RltPurposes.defs
#include AttrTablePick.vih
#include ExtAttr.vih

alter Interface RoomMainAttr;
overload
//Function doInsertObj(pRltOwner, pOwner : comp) : boolean;
end;
OverloadFormats scrMain;

#include ExtAttr.var

function GetPrim(cc:comp):string;forward;

create view as select GetPrim(rltRooms.nrec)(FieldName = AV_prim)
from RLTATTRHIST,RLTATTRHIST RLTATTRHIST_f
where
 ((   roRoom                 == RLTATTRHIST.VIDOBJ
   and rltRooms.nRec          == RLTATTRHIST.cObj
 ));


function GetPrim(cc:comp):string;
{
  Result:='';
  if GetLast RLTATTRHIST_f where ((roRoom == RLTATTRHIST_f.VIDOBJ and cc == RLTATTRHIST_f.cobj and Cur_Date>>=RLTATTRHIST_f.DCHANGE ))=tsok
   {
      Result:=RLTATTRHIST_f.SVALUES[7];
   }
}
Screen scrMain 'Основные атрибуты' (,,sci1Esc);
  Table rltRooms;

  Bevel b1 { 0,  0, 47,  9, bsLowered, bsFrame};
  Bevel b2 { 0, 10, 47, 28, bsLowered, bsFrame};
Fields
  ZemComplViewName   : Skip;
  BuildingViewName   : Skip;
  rltBuildings.InvNo : Skip;
  rltFloors.No       : Skip;
  rltFloors.Level    : Skip;
  rltRooms.NoFact ('Фактический номер комнаты',,) : NoProtect;
  rltHouses.No    ('Входит в состав помещения',,sci13Esc) : Protect, QuickChoice;
  rltRooms.NoBTI  ('Номер комнаты в помещении по БТИ',,) : NoProtect;
  [DopName] sGetAttr ( corltRooms, rltRooms.nrec, 'VA_RLT_NAME' )
                     ( 'Наименование',,sci13Esc ) : noprotect, noPickButton;
  oRents.GetRentStatusName(rltRooms.nRec, roRoom, Cur_Date): skip;
  OtvPodr.Name       : Skip;
#PurposesFields(rltRooms)
  rltRents.wPurposes : [LIST 0 'Основное', 'Вспомогательное'], Skip;
  KatNazna.Name      : Skip;
<<

 `Земельный участок:`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Здание/сооружение`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Инвентарный номер здания/сооружения`
 .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Этаж:` .@@@@@@@@@@@@@@@@@ `Уровень:` .@@@@@


 `Номер комнаты:`
  `Фактический:`    .@@@@@@@@@@@@@@@@@@@@@@@@
  `Помещение:`      .@@@@@@@@@@@@@@@@@@@@@@@@
  `Наименование:`   .@@@@@@@@@@@@@@@@@@@@@@@@
  `Наим.:`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Статус:`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `ЦО:`    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

 `Основное назначение:`
   `Вид:`          .@@@@@@@@@@@@@@@@@@@@@@@@@
   `Наименование:` .@@@@@@@@@@@@@@@@@@@@@@@@@

 `Цель использования:`
   `Вид:`          .@@@@@@@@@@@@@@@@@@@@@@@@@
   `Наименование:` .@@@@@@@@@@@@@@@@@@@@@@@@@

>>
end;
HandleEvent
cmCheckField: {
  if CurField=#RLTATTRHIST.SVALUES[7] then Update Current RLTATTRHIST;
  if CurField=#RLTATTRHIST.SVALUES[8] then Update Current RLTATTRHIST;
  inherited::HandleEvent(cmCheckField);
  }
cmExprFieldChanged :
 {
  Case CurField Of
   #DopName :
    {
     If trim ( ExprFieldValue ) = ''
       ExtAttr_DeleteValue ( corltRooms, rltRooms.nrec, 'VA_RLT_NAME' );
      else
       sSetAttr ( corltRooms, rltRooms.nrec, 'VA_RLT_NAME', ExprFieldValue );
    };
   end;
  inherited::HandleEvent(cmExprFieldChanged);
 };
cmDelOnProtect :
 {
  Case CurField Of
   #DopName :
    {
      ExtAttr_DeleteValue ( corltRooms, rltRooms.nrec, 'VA_RLT_NAME' );
    };
   end;
  inherited::HandleEvent(cmDelOnProtect);
 };

end;

HandleEvent
cmUpdateRecord:
  if ( update current rltRooms = tsOK )
    {
      if ( rltRooms.cHouse <> 0 )
        AfterUpdateObj(rltRooms.cHouse, rltRooms.nRec, roHouse, roRoom, rltRooms.NoBTI);

      AfterUpdateObj(rltRooms.cFloor, rltRooms.nRec, roRooms, roRoom, rltRooms.NoFact+' / '+rltRooms.NoBTI);
    }
end;
end.
