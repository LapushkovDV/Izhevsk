
#include UserReport.vih
#include XLReport.vih
#include FpPeriod.vih
#include PersInfo.vih
#include oiPotrGt.vih
#include InLogistRepFuncs.vih
#include ValFunc.vih
exception ExExcelFatalError;


#Doc
 План расхода инструмента на следующий месяц</Brief>
#End

Interface STO_PLAN_R_M_REP 'План расхода инструмента на следующий месяц', escClose, blue;
Show at (,,70,21);

//Производство	Цех	Участок	Код номенклатуры	Наименование	Ед.изм.	Объем производства	Норматив на 1 а/м, кол-во	Норматив на объем призводства, кол0во	Калькулируемая единица	Цена, руб	Сумма, руб


table struct TmpOborot
(
  S         : string
 ,sProIzv   : string[15]
 ,sCex      : string[35]
 ,sUch      : string[35]
 ,sBarkod   : string[15]
 ,sName     : string[80]
 ,sEd       : string[15]
 ,ObProizv  : double
 ,Norm      : double
 ,NormObPr  : double
 ,sKE       : string[80]
 ,Cena      : double
 ,Summa     : double
 ,crec      : comp
)
with index
(
  TmpOborot01 = sBarkod + crec +ske
)
;
table struct TmpKE
(
  S         : string
 ,kol     : double
)
with index
(
  TmpKE01 = s
)
;



var
   sErrMessage: string;
  lErrMessageMode,lCountRow: longInt;
  iLFuncs: AVAZ_Logistics::iInLogistRepFuncs;

#include ValFunc.var
Create View
var 
  DateNorm,  DatePrice,  DateCurs ,DateMesPlan,DTB,DTE : date;
  FixCursUS,FixCursEU:double;
  PlanName,_sPodr,_sCex,_sUch,_tVal,sKE  :string;
  TipPlan : word;
  _cMnPlan,cRPStatus,cPS_SHAB_Instr,_cKE:comp;
  _cWA,HDRn,_tSP:comp;
  m_GetPotr: oiPotrGt;
  tKol:double;
  _tCena,       _tCur:TSumma;
From
   TmpOborot
  ,MnPlan
  ,WayAccou
  ,spmnplan
  ,spmnpl
  ,valspmnp
  ,HDR_PS
  ,DOCNASTR
  ,katmc katmc_res
  ,katotped
  ,katpodr
  ,spsopr
  ,spkau
  ,TmpKE
where((
 _cMnPlan == MnPlan.nrec
  and
  _cWA == WayAccou.nrec
  and
  mnplan.nrec == spmnplan.cmnplan
  and
  (DTB<=spmnplan.ENDDATE and DTE>=spmnplan.ENDDATE )
  and
  spmnplan.nrec == spmnpl.cspmnplan
  and
  spmnpl.nrec == valspmnp.cspmnpl

 ));


Panel pnParam;
NoTableNavigation;
screen scParam 'План расхода инструмента на следующий месяц' (,,sci1Esc);
Fields
  DateNorm  :NoProtect;
  DatePrice :NoProtect;
  DateCurs  :NoProtect;
  FixCursUS :[10.6],NoProtect;
  FixCursEU :[10.6],NoProtect;
  DateMesPlan   :NoProtect;
  WayAccou.Name :Protect,PickButton;
  MnPlan.name  :Protect,PickButton;

Buttons
  cmOk,,,'Сформировать отчет', , sci1Esc;
  cmCancel,,,'Выход', , sci1Esc;
<<

    `Дата состава норм расхода инструмента`  .@@@@@@@@@@@

    `Дата цены`                              .@@@@@@@@@@@

    `Дата курса валют`                       .@@@@@@@@@@@

    `Фиксированный курс доллара (за 100)`    .@@@@@@@@@@@

    `Фиксированный курс евро (за 100)`       .@@@@@@@@@@@

    `Месяц плана`                            .@@@@@@@@@@@

    `Шаблон плана`   .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

    `Название плана` .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@



    <.~С~формировать.>           <. ~О~тмена  .>

>>

end; //scrParam
End; //pnParam


#include sto_rep_func.vpp;

function GetData:boolean;

{
 Result:=true;
 StartNewVisual(vtRotateVisual, vfTimer + vfBreak + vfConfirm, 'Анализ данных...',0);
 tKol:=0;
 delete all TmpPotr;
 delete all Tmpoborot;
 delete all TmpKE;
 _loop  spmnplan
 {
   if not NextVisual then
    {
     Result:=false;
     StopVisual('',0);
     exit;
    }



  HDRn:=FindPS(spmnplan.cizd);
  if HDRn=0 then continue;


   tKol:=0;
   _loop spmnpl
    _loop valspmnp
     tKol:=valspmnp.kol;


  sKE:='';
  _cKE := coGetAttr(coKatMC,spmnplan.cizd,VA_KATMC_KE);
  if _cKE<>0 then
   {
     if getfirst fastfirstrow spkau where ((_cKE == spkau.nrec))=tsok
      {
        sKE:=spkau.name;
      }
   }

  if tKol<>0 then
   {
     if getfirst TmpKE where ((sKE == TmpKE.S))=tsok then
      {
        set TmpKE.kol:=TmpKE.kol+tKOl;
        update current TmpKE;
      }
      else
      {
       ClearBuffer(#TmpKE);
       set TmpKE.kol:=tKOl;
       set TmpKE.s:=sKE;
       insert current TmpKE;
      }
   }

  m_GetPotr.SetWorkDate(spmnplan.ENDDATE);
  m_GetPotr.SetWorkFlag(011010b);
  m_GetPotr.GetDocPotrEx(HDRn, 10,tKol,spmnplan.cOtpEd);
  _loop tmppotr where ((cgKAU_KatMC == tmppotr.TRESOURCE))
   {

     if getfirst fastfirstrow katmc_res where ((tmppotr.cresource == katmc_res.nrec))<>tsok then continue;
     if TmpPotr.Kind=1 and TmpPotr.PrMat=1 then continue;
     if getfirst tmpoborot where ((katmc_res.barkod == tmpoborot.sBarkod and katmc_res.nrec == tmpoborot.crec and sKE == tmpoborot.sKE)) = tsok then
      {
       set TmpOborot.Norm     :=TmpOborot.Norm + tmppotr.RASX;
       update current TmpOborot;
      }
      else
      {
       ClearBuffer(#TmpOborot);
       GetPODRCEXUCH(tmppotr.cdep,_sUch,_sCex,_sPodr);
       set TmpOborot.sProIzv  :=_sPodr;
       set TmpOborot.sCex     :=_sCex;
       set TmpOborot.sUch     :=_sUch;
       set TmpOborot.sBarkod  :=katmc_res.barkod;
       set TmpOborot.sName    :=katmc_res.name;
       set tmpoborot.sKE      :=sKE;
       if getfirst fastfirstrow katotped where ((tmppotr.ced == katotped.nrec))=tsok
       then
           set TmpOborot.sEd      :=katotped.abbr;
 //      set TmpOborot.ObProizv :=tKol;
       set TmpOborot.Norm     :=tmppotr.RASX;
  //     set TmpOborot.NormObPr :=tKol * TmpOborot.Norm;
  //     set TmpOborot.CalcEd   :=0;

 //      set TmpOborot.Summa    :=0;
       set TmpOborot.crec     :=katmc_res.nrec;
       _tSp:=iLFuncs.GetLastPrihSpSopr(katmc_res.nrec,DatePrice);
       _tCena:=0;
       _tCur:=0;
       if getfirst fastfirstrow spsopr where ((_tSP == spsopr.nrec))=tsok then
        {

           _tVal:=oValFunc.GetValSimv(spsopr.cVAL);
           if spsopr.cVAL<>0 then
            {
              case _tVal of
               'USD' : _tCur:=FixCursUS;
               'EUR' : _tCur:=FixCursEU;
              end;
              if _tCur=0 then _tCur:=oValFunc.Rate(spsopr.cVAL,DateCurs);
              if _tCur=0 then _tCena:=spsopr.price;
                         else _tCena:=spsopr.vprice*_tCur;
            }
            else
            {
              _tCena:=spsopr.price;
            }
          set TmpOborot.Cena     := _tCena;
        }
       insert current TmpOborot;

      }
   }

 }




 lCountRow := RecordsInTable(#TmpOborot);
 if lCountRow<=0 then Result:=false;
 StopVisual('',0);
}

#include ExFunc.vpp;

procedure PrintData;
{

 var lColLast,lBegRow,lColNo,lRowNo:longint;
 lColLast  := 12;
 lRowNo    := 5;

 var sTemplateName: string =  TranslatePath(StartPathName+'XLS\AVAZ\sto_plan_r_m.xlsx');

 StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Печать отчета',lCountRow);
 _try
  {
  CreateExcelWithTemplate(sTemplateName);

  _try
   {

  SetCellStringValue('[' + UserName +' '+ _DateTimeToStr(_CurDateTime,'DD.MM.YYYY HH:NN') + ']',1,1);
  SetCellStringValue(DateToStr(DTB,'DD.MM.YYYY')+' - '+DateToStr(DTE,'DD.MM.YYYY'),3,2);
  SetCellStringValue(DateToStr(DateNorm,'DD.MM.YYYY'),3,5);

    _loop TmpOborot
    {
     if not NextVisual then continue;
     tKol:=0;
      if getfirst TmpKE where ((TmpOborot.sKE == TmpKE.S))=tsok then
      {
        tKol:=TmpKE.kol;
      }
     lColNo:= 0;
     inc(lColNo); SetCellStringValue(TmpOborot.sProIzv                                    ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.sCex                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.sUch                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.sBarkod                                    ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.sName                                      ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.sEd                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(tKol                                                 ,lRowNo,lColNo);
     inc(lColNo); if tkol<>0 then SetCellNumberValue(TmpOborot.Norm /tKol                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.Norm                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellStringValue(TmpOborot.sKE                                        ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.Cena                                       ,lRowNo,lColNo);
     inc(lColNo); SetCellNumberValue(TmpOborot.Norm*TmpOborot.Cena                        ,lRowNo,lColNo);
     lBegRow:= lRowNo;
     lRowNo++;

    }
     lColNo:= 0;
//     xlSetFontStyle(xlBold,4,1,4,lColLast);
}
  _finally
   {
    StopVisual;
   }
  }
  _except
    on ExExcelFatalError:
     {
      StopVisual;
      message(sErrMessage, lErrMessageMode);
     }
  _finally
    {

    xlKillExcel;
    if VisualizationActive() then StopVisual('', 0);
    }

}

HandleEvent
//----------------------

cmInit:
{
  if (Not LoadVipRef (m_GetPotr, 'M_TPP::iPotrPS'))
      {
        Message('Системная ошибка !!!' + 'Не загружен интерфейс <' + 'iPotrPS'
                + '>', Error + CancelButton);
        Abort;
        Exit;
      }
  if not ReadMyDsk(DateMesPlan, 'R_M_REP_DateMesPlan',true) DateMesPlan:=Cur_date;
  if not ReadMyDsk(DateNorm   , 'R_M_REP_DateNorm',true) DateNorm:=Cur_date;
  if not ReadMyDsk(DateCurs   , 'R_M_REP_DateCurs',true) DateCurs:=Cur_date;
  if not ReadMyDsk(DatePrice  , 'R_M_REP_DatePrice',true) DatePrice:=Cur_date;

 ReadMyDsk(FixCursUS  , 'R_M_REP_FixCursUS',true);
 ReadMyDsk(FixCursEU  , 'R_M_REP_FixCursEU',true);
 ReadMyDsk(_cMnplan   , 'R_M_REP_cMnPlan',true);
 ReadMyDsk(_cWA       , 'R_M_REP_cWA',true);
 if getfirst fastfirstrow Mnplan =tsok then {}
 if getfirst fastfirstrow WayAccou =tsok then {}
 cRPStatus:=0;
 if getfirst katnotes where ((1200 == katnotes.viddoc and (Pos('УТВ',UPCASE(katnotes.name))>0)))=tsok then cRPStatus:=katnotes.nrec;
 if cRPStatus=0 then {message('Не найден статус "утвержден" для плана!');exit;}
 cPS_SHAB_Instr:=0;
 if getfirst DOCNASTR where ((word(1) == DOCNASTR.dtype  and PS_SHAB_Instr == DOCNASTR.NAME))=tsok then cPS_SHAB_Instr:=DOCNASTR.nrec;
 if cPS_SHAB_Instr=0 then {message('Не найден шаблон производственной спецификации "'+PS_SHAB_Instr+'"!');exit;}

}
cmOk:
{
  SaveMyDsk(DateMesPlan, 'R_M_REP_DateMesPlan');
  SaveMyDsk(DateNorm   , 'R_M_REP_DateNorm');
  SaveMyDsk(DatePrice  , 'R_M_REP_DatePrice');
  SaveMyDsk(DateCurs   , 'R_M_REP_DateCurs');
  SaveMyDsk(FixCursUS  , 'R_M_REP_FixCursUS');
  SaveMyDsk(FixCursEU  , 'R_M_REP_FixCursEU');
  SaveMyDsk(DateMesPlan, 'R_M_REP_DateMesPlan');
  SaveMyDsk(_cMnplan   , 'R_M_REP_cMnPlan');
  SaveMyDsk(_cWA       , 'R_M_REP_cWA');
  DTB:=date(1,Month(DateMesPlan),Year(DateMesPlan));
  DTE:=date(Last_Day(DateMesPlan),Month(DateMesPlan),Year(DateMesPlan));
  if getfirst fastfirstrow WayAccou <> tsok then
    {
      Message('Необходимо выбрать план или шаблон пана!',information);
      Abort;Exit;
    }
  if _cMnPlan=0 then
   {
     if getfirst fastfirstrow  Mnplan where ((_cWA == mnplan.cwayaccou
                            and
                            (cRPStatus = mnplan.cstatus
                             and
                              DateMesPlan>=mnplan.startdate
                             and
                              DateMesPlan<=mnplan.enddate
                            )

                        )) <> tsok then
      {
       Message('На дату '+DateToStr(DateMesPlan,'DD.MM.YYYY')+' нет плана в утвержденном статусе!',information);
       Abort;Exit;

      }
     _cmnplan:=mnplan.nrec;

   }
  If(Not GetData)
  {
    message('Нет данных за указанный период c '+DateToStr(DTB,'DD.MM.YYYY')+' по '+DateToStr(DTE,'DD.MM.YYYY'));
    exit;
  }
  

  PrintData;
}
//---------------------------
cmPick:{
   Case CurField Of
    #WayAccou.name :
     {
      RunInterface(NastrPl,0,_cWA,1);
      if getfirst fastfirstrow wayaccou=tsok {}
      RescanPanel(#WayAccou);
     };
    #MnPlan.Name :
     {
      if (RunInterface('M_MNPLAN::GetMnPlan', word(1), word(0), _cMnPlan,
            _cWA, word(0), word(0), word(0), comp(0), False, '', word(0)) <> cmCancel)
          {
            if getfirst fastfirstrow mnplan=tsok
              {
                if _cWA=0 then set _cWA:=Mnplan.cwayaccou;
              }
          }
      RescanPanel(#MnPlan);
     };
   end;
} //cmPick:

//---------------------------
cmDelOnProtect:{
    Case CurField Of
    #WayAccou.name :
     {
      set _cWA := 0;
     };
    #MnPlan.Name:
     {
      set _cMnPlan := 0;
     };

   End;
   RescanPanel(#MnPlan);
}
cmDone:
{
    if (not NullVipRef(m_GetPotr))
      FreeVipInterface(m_GetPotr);
}
end;

End.

VipInterface UserReport_STO_PLAN_R_M_REP Implements IUserReport;

Interface UserReport_STO_PLAN_R_M_REP;

create view;

procedure Run;
begin
 RunInterface(STO_PLAN_R_M_REP);
end;
function GetReportName: String;
begin
  GetReportName := 'План расхода инструмента на следующий месяц';
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := 'СТО';
  case Level of
    1 : GetGroupName := 'СТО';
  end;
end;

function GetPriority : Integer;
begin
  GetPriority := -100;
end;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '*';
end;
end.
