#component "M_UP"
#Define OBJINT_ACCOUNT
#Include OBJINTPL.VIN

exception ExExcelFatalError;

#component "AVAZ_Logistics"
Interface RepSpisInstrument 'Списание инструмента' ('', hcNoContext, sci1Esc);
  Show at(,,50,10);

table struct tmpExcel
(
  Nrec    : comp
 ,cPodr   : comp
 ,cMc     : comp
 ,Kol     : Double
 ,Summa   : Double
)
with index
(
  tmpExcel01 = Nrec(unique,surrogate)
 ,tmpExcel02 = cPodr + cMc
)
;

Var  getN     : Util_GetName;
Var  GlDt     : GlobData;
Var  gKau     : OiWorkWithKAU;

var MyPlansNo : comp;
    KodPlnSCH : String[1];
    tSchD,GetSchD,GetSubSchD : String;
    tSchK,GetSchK,GetSubSchK : String;
    PointOut : comp;
    coStatCalc : comp;
    BegDat,EndDat : Date;
    sPickMC : String;

   sErrMessage: string;
   lErrMessageMode,lCountRow: longInt;

   QKol : Double;

Create View
as select
 *
from
 tmpExcel
,PLANSSCH
,SpKau
,BUHSCHET KATH
,Pick PickMc
,KatMc
,KatMc GetKatMc
,Oborot
,KatPodr
,KatPodr TopPodr
,KatEd
,KatSopr
,SklOrder
,SpOrder
where
((
    MyPlansNo == PLANSSCH.NRec
and PointOut == SpKau.NRec
and  word(7) == PickMc.wList

and GetSchD == Oborot.SCHETO
and coStatCalc == Oborot.KAUOS[5]
and BegDat <<= Oborot.DatOb
and EndDat >>= Oborot.DatOb

and tmpExcel.cPodr == KatPodr.NRec
and tmpExcel.cMc   == KatMc.Nrec
and KatMc.cED      == KatEd.NRec

and 1 == SpOrder.SP
and 0 == SpOrder.VidOrder
and BegDat <<= SpOrder.dOrd
and EndDat >>= SpOrder.dOrd
and SpOrder.cSklOrder == SklOrder.NRec
and SklOrder.cSopr == KatSopr.Nrec
));


Screen scRep '' ('', hcNoContext, sci13Esc);
  Table tmpExcel;
Fields
 SpKau.Name : Protect,PickButton;
 BegDat     : NoProtect;
 EndDat     : NoProtect;
 tSchD      : Protect,PickButton;
 tSchK      : Protect,PickButton;
 sPickMC    : Protect,PickButton;
Buttons
 cmOk;
 cmCancel;
<<

 `Точка схода автомобиля с конвейера`.@@@@@@@@@@@

 `Период` .@@@@@@@@@@@`-`.@@@@@@@@@@@
 `Счет ДТ`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Счет КТ`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Номенклатура`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

       <. Сформировать .>  <. Отмена .>

>>
End;

#include ExFunc.vpp;

procedure PrintData;
{

 var lColLast,lBegRow,lColNo,lRowNo:longint;
 lColLast  := 15;
 lRowNo    := 6;

  var sTemplateName: string = TranslatePath(StartPathName+'XLS\AVAZ\repspisinstrument.xltm');
 StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Печать отчета',lCountRow);
 _try
  {
  CreateExcelWithTemplate(sTemplateName);
  _try
   {
    SetCellStringValue(DateToStr(BegDat,'DD.MM.YYYY')+' - '+DateToStr(EndDat,'DD.MM.YYYY'),2,2);
    SetCellStringValue(DateToStr(Cur_Date,'DD.MM.YYYY'),2,6);

    _loop tmpExcel
    {
     set lColNo:= 0;
     inc(lColNo);
     inc(lColNo);
     inc(lColNo);SetCellStringValue(KatPodr.Kod,lRowNo,lColNo);
     inc(lColNo);SetCellStringValue(KatPodr.Name,lRowNo,lColNo);
     inc(lColNo);SetCellStringValue(KatMc.BarKod,lRowNo,lColNo);
     inc(lColNo);SetCellStringValue(KatMc.Name,lRowNo,lColNo);
     inc(lColNo);SetCellStringValue(KatEd.Name,lRowNo,lColNo);
     inc(lColNo);SetCellStringValue(DateToStr(BegDat,'DD.MM.YYYY')+' - '+DateToStr(EndDat,'DD.MM.YYYY'),lRowNo,lColNo);
     inc(lColNo);SetCellNumberValue(tmpExcel.Kol,lRowNo,lColNo);
     inc(lColNo);SetCellNumberValue(Double(tmpExcel.Summa/tmpExcel.Kol),lRowNo,lColNo);
     inc(lColNo);SetCellNumberValue(tmpExcel.Summa,lRowNo,lColNo);
     inc(lColNo);SetCellNumberValue(QKol,lRowNo,lColNo);
     inc(lColNo);SetCellNumberValue(Double(tmpExcel.Kol/QKol),lRowNo,lColNo);
     inc(lColNo);SetCellNumberValue(Double(tmpExcel.Summa/tmpExcel.Kol)/QKol,lRowNo,lColNo);
     inc(lColNo);SetCellNumberValue(Double(tmpExcel.Summa/QKol),lRowNo,lColNo);

     inc(lRowNo);
    }


   }
  _finally
   {
    StopVisual;
   }
  }
  _except
    on ExExcelFatalError:
     {
      StopVisual;
      message(sErrMessage, lErrMessageMode);
     }
  _finally
    xlKillExcel;


};

function ChkVAPodr(_cPodr : comp): Boolean;
{
 var tVA : comp;
 result:= false;
 set tVA := coGetAttr(coKatPodr,_cPodr,VA_STO_KT);

 if tVA=0 then
 {
  if GetFirst fastfirstrow TopPodr where((_cPodr == TopPodr.Nrec))=tsOk then
  result:= ChkVAPodr(TopPodr.cPodr);
 }
 else
 {
  if tVA = PointOut then set result:= true;
  exit;
 }

}

procedure GetQKol;
{
 set QKol:= 0;
 StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Подсчет объема производства...', RecordsInTable(#SpOrder));
 _loop SpOrder
 {
  if GetFirst fastfirstrow GetKatMc where((SpOrder.cMC == GetKatMc.NRec))<>tsOk then continue;
  if GetKatMc.kGroupMC <> '2000000' then continue;
  if GetFirst fastfirstrow SklOrder<>tsOk then continue;
  if GetFirst fastfirstrow KatSopr<>tsOk then continue;
  if KatSopr.VidSopr <> 502 and KatSopr.VidSopr <> 505 then continue;
  if not ChkVAPodr(KatSopr.CPODRTO) then continue;
  set QKol:= QKol + SpOrder.Kol;
 }
 StopVisual( '', 0 );
};

procedure GetOborot;
{
 delete all tmpExcel;
 StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Анализ проводок за период...', RecordsInTable(#Oborot));
 _loop Oborot
 {
   if not NextVisual then break;
   if Oborot.SchetK<>GetSchK or Oborot.SubSchK<>GetSubSchK then continue;
   if sPickMC <> 'не установлен' then
   {
     if GetFirst fastfirstrow PickMC
      where((word(7) == PickMc.wList and Oborot.KauKs[2] == PickMC.cRec))<>tsOk then continue;
   }
   if GetFirst fastfirstrow tmpExcel
    where((Oborot.KodSPO == tmpExcel.cPodr and Oborot.KauKs[2] == tmpExcel.cMc))<>tsOk then
    {
     ClearBuffer(#tmpExcel);
     set tmpExcel.cPodr:= Oborot.KodSPO;
     set tmpExcel.cMc  := Oborot.KauKs[2];
     set tmpExcel.Kol  := Oborot.Kol;
     set tmpExcel.Summa:= Oborot.SumOb;
     insert current tmpExcel;
    }
    else
    {
     set tmpExcel.Kol  := tmpExcel.Kol + Oborot.Kol;
     set tmpExcel.Summa:= tmpExcel.Summa + Oborot.SumOb;
     update current tmpExcel;
    }

 }
 StopVisual( '', 0 );
};

function GetNrecKau_Name(_KodGrKau : Word; _Name : String):comp;
{
 result:= 0;
 if GetFirst fastfirstrow SpKau
  where((_KodGrKau == SpKau.KodGrKau and _Name == SpKau.Name))=tsOk
   then set result:= SpKau.NRec;
};


function GetNameSht(_SCHET,_SUBSCH : string):String;
{
 result:= '';
 if GetFirst fastfirstrow KATH where((_SCHET == KATH.SCHET and _SUBSCH == KATH.SUBSCH)) = tsOk then
     {
      set result:= KATH.Code+' '+KATH.Name;
     }
};

HandleEvent // Interface

cmInit:
{
 set MyPlansNo:= coGetTune('KONSOLID.CPLANSSCH');

 set coStatCalc:= GetNrecKau_Name(cgKAU_StatCalc,sKAU_StatCalc);
 set PointOut:= GetNrecKau_Name(cgKAU_PointOut,sKauKT45);
 if GetFirst fastfirstrow SpKau=tsOk then {};

 set BegDat:= Date(1,Month(Cur_Date),Year(Cur_Date));
 set EndDat:= Date(Last_Day(Cur_Date),Month(Cur_Date),Year(Cur_Date));
 set sPickMC:= 'не установлен';

 set GetSchD    := '120';
 set GetSubSchD := '';
 set GetSchK    := '110';
 set GetSubSchK := '111';

 set tSchD:= GetNameSht(GetSchD,GetSubSchD);
 set tSchK:= GetNameSht(GetSchK,GetSubSchK);

 if (Not GetVipRef (Gldt, 'GlobDataSource'))
  {
    Message(''#3'Системная ошибка !!!'#13 +
            ''#3'Не загружен интерфейс <' + 'GlobDataSource' + '>', Error);
    Exit;
  }

  if (nullVipRef(GetN))
    GetN    := gldt.uGetName();
  if (nullVipRef(gKAU))
    gKAU    := gldt.GetoiWorkWithKAU();
};

cmPick:
{
  case CurField of
  #SpKau.Name:
  {
      var vc : comp;
      vc := PointOut;
      gKau.KauPick2(cgKAU_PointOut,vc);
      set PointOut := vc;
      RescanPanel(#tmpExcel);
  }

   #tSchD:{
   set tSchD:= '';
   if RunInterface('F_BUHSCHET::GETBUHSCHET',0,MyPlansNo,GetSchD,GetSubSchD)=cmDefault then
   {
    set tSchD:= GetNameSht(GetSchD,GetSubSchD);
   }
   };
   #tSchK:{
   set tSchK:= '';
   if RunInterface('F_BUHSCHET::GETBUHSCHET',0,MyPlansNo,GetSchK,GetSubSchK)=cmDefault then
   {
    set tSchK:= GetNameSht(GetSchK,GetSubSchK);
   }
   };
   #sPickMC : {
     var cfMc : comp;
     var i : longint;
     delete all PickMc;
     if RunInterface('L_MCU::GetSomeMC',0)<>cmCancel {
      i:= 0; _loop PickMc {i++; cfMc:= PickMC.cRec};
      if GetFirst fastfirstrow KatMc where((cfMc == KatMc.NRec))=tsOk then {};
      set sPickMC := if (i = 0, 'не установлен'
                       , if (i = 1, KatMc.Name,'множественный выбор (' + string(i) + ')'));
     }
   }
  end;
};

cmDelOnProtect:
{
  case CurField of
   #SpKau.Name: {
    set PointOut:= 0;
   };
   #tSchD: {
    set tSchD:= GetSchD:= GetSubSchD:= '';
   };
   #tSchK:{
    set tSchD:= GetSchD:= GetSubSchD:= '';
   };
   #sPickMC : {
    delete all PickMc;
    set sPickMC:= 'не установлен';
   }
  end;
};

cmOk:
{
 GetOborot;
 if not isValid(#tmpExcel) then
 {
  Message('Нет данных для отчета!');
  exit;
 };
 GetQKol;
 PrintData;
};

End;


End.

#include UserReport.vih;
VipInterface UserReport_RepSpisInstrument Implements IUserReport;
Interface UserReport_RepSpisInstrument;
create view;
procedure Run;
begin
 RunInterfaceNoModal(RepSpisInstrument);
end;
function GetReportName: String;
begin
  GetReportName := 'Списание инструмента в разрезе производственных участков';
end;
function GetGroupName (Level : Word) : String;
begin
  GetGroupName := 'СТО';
  case Level of
    1 : GetGroupName := 'СТО';
  end;
end;
function GetPriority : Integer;
begin
  GetPriority := -100;
end;
function VisibleInModule(Ind : Byte) : String;
begin
  VisibleInModule := '*';
end;
end.
