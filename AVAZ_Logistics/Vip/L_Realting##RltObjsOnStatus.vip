#component "L_Realting"
#include RltObjsOnStatus.vih
#include RltRentHist.vih

#doc
Список комнат и мест на б/т по организациям, подразделениям
#end
Alter Interface RltObjsOnStatus
create view
as select rltAttrHist.* from rltAttrHist;


OverloadFormats  brRoomRents;
OverloadFormats  brRoomPodrs;


function GetPL:double;
var Sum:double;
{
  Result:=0;
  if getfirst rltAttrHist where ((rltRents.VidObj  == rltAttrHist.VidObj
                              and rltRents.cObj    == rltAttrHist.cObj
                              and rltRents.dFrom  <<= rltAttrHist.dChange
                              and rltRents.dTo    >>= rltAttrHist.dChange (NoIndex) )) =tsok then
     Result:= RLTATTRHIST.DOVALUES[4];

}

function GetOS:string;
{
  Result:='';
  if getfirst rltAttrHist where ((rltRents.VidObj  == rltAttrHist.VidObj
                              and rltRents.cObj    == rltAttrHist.cObj
                              and rltRents.dFrom  <<= rltAttrHist.dChange
                              and rltRents.dTo    >>= rltAttrHist.dChange (NoIndex))) =tsok then
     Result:= RLTATTRHIST.SVALUES[8];

}

Window wRoomRent;

TabbedSheet tshRooms;

Table rltRooms;

Browse brRoomRents 'Аренда' (,,sci1Esc);
Fields
  rltRooms.NoFact '№ (факт)'           ('Фактический номер комнаты',,)        :  [6], protect;
  rltRooms.NoBTI  '№ по БТИ'  ('Номер комнаты в помещении по БТИ',,) :  [10], protect;
  sGetAttr ( corltRooms, rltRooms.nrec, 'VA_RLT_NAME' ) 'Примечание' :  [30], protect;
  fpCo.ABBR       'Код'                ('Код подразделения',,)                : [4], protect;
  fpCo.Name       'Арендатор'          ('Организация-арендатор',,)            : [20], protect;
  rltRents.dFrom  'На период','с'    ('На период с',,)                      : [10, 'DD/MM/YYYY'], protect;
  rltRents.dTo    'На период','по'   ('На период с',,)                      : [10, 'DD/MM/YYYY'], protect;
  rltRents.dDoc   'Дата','документа' ('Дата документа',,)                   : [10, 'DD/MM/YYYY'], protect;
  rltRents.NoDoc  'Номер документа'    ('Номер документа',,)                  : [20], protect;
  GetOS           'Ось расположения'    ('Ось расположения',,)                  : [20], protect;
  GetPL           'Площадь' ('Площадь') : [11.2], Protect,nopickbutton;
end;

Browse brRoomPodrs 'Закрепление' (,,sci1Esc);
Fields
  rltRooms.NoFact '№ (факт)'           ('Фактический номер комнаты',,)        :  [6], protect;
  rltRooms.NoBTI  '№ по БТИ'           ('Номер комнаты в помещении по БТИ',,) :  [10], protect;
  sGetAttr ( corltRooms, rltRooms.nrec, 'VA_RLT_NAME' ) 'Примечание' :  [30], protect;
  fpCo.ABBR       'Код'               ('Код подразделения',,)            : [4], protect;
  fpCo.Name       'Подразделение'      ('Закреплено за подразделением',,)     : [20], protect;
  rltRents.dFrom  'На период','с'    ('На период с',,)                      : [10, 'DD/MM/YYYY'], protect;
  rltRents.dTo    'На период','по'   ('На период с',,)                      : [10, 'DD/MM/YYYY'], protect;
  rltRents.dDoc   'Дата','документа' ('Дата документа',,)                   : [10, 'DD/MM/YYYY'], protect;
  rltRents.NoDoc  'Номер документа'    ('Номер документа',,)                  : [20], protect;
  GetOS           'Ось расположения'    ('Ось расположения',,)                  : [20], protect;
  GetPL           'Площадь' ('Площадь') : [11.2], Protect,nopickbutton;
end;


end; // TabbedSheet
end;
end.
