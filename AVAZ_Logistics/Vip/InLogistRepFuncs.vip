#include Query.vih

Interface iInLogistRepFuncs '' EscClose, doAccept;

//******************************************************************************
// запрос возвращает дату и цену последнего прихода по МЦ

sql query qGetLastPrihPriceDate =
select top 1 doprttn, price from spsopr
where doprttn > 0 //с ордерами
  and vidsopr = 101 //приходные
  and prmc = 1 // МЦ
  and kolfact > 0
  and cmcusl = :qMCNrec
order by doprttn desc
;

sql query qGetLastPrihPriceByDate =
select top 1 nrec,doprttn, price from spsopr
where doprttn <= :qDate //с ордерами
  and doprttn > 0
  and vidsopr = 101 //приходные
  and prmc = 1 // МЦ
  and kolfact > 0
  and cmcusl = :qMCNrec
order by doprttn desc
;
//******************************************************************************
// функция возвращает цену последнего прихода по МЦ

Function GetLastPrihPrice( cMC: comp ): double;
{
  result := 0;
  var pQuery: IQuery = QueryManager.CreateQuery(qGetLastPrihPriceDate);
  pQuery.setParam('qMCNrec', cMC);
  var pResultSet : IResultSet = pQuery.getResultSet;
  if pQuery.errorCode = tsOk then {
    if pResultSet.getFirst = tsOk then {
      result := pResultSet.row.val('price');
    }
  }
} // function GetLastPrihPrice
//******************************************************************************
// функция возвращает nrec последнего прихода по МЦ на дату

Function GetLastPrihSpSopr( cMC: comp; DD:date ): comp;
{
  result := 0;
  var pQuery: IQuery = QueryManager.CreateQuery(qGetLastPrihPriceByDate);
  pQuery.setParam('qMCNrec', cMC);
  pQuery.setParam('qDate', DD);
  var pResultSet : IResultSet = pQuery.getResultSet;
  if pQuery.errorCode = tsOk then {
    if pResultSet.getFirst = tsOk then {
      result := pResultSet.row.val('nrec');
    }
  }
} // function GetLastPrihSpSopr
//******************************************************************************
// функция возвращает дату последнего прихода по МЦ

Function GetLastPrihDate( cMC: comp ): date;
{
  result := date(0,0,0);
  var pQuery: IQuery = QueryManager.CreateQuery(qGetLastPrihPriceDate);
  pQuery.setParam('qMCNrec', cMC);
  var pResultSet : IResultSet = pQuery.getResultSet;
  if pQuery.errorCode = tsOk then {
    if pResultSet.getFirst = tsOk then {
      result := pResultSet.row.val('doprttn');
    }
  }
} // function GetLastPrihDate

//******************************************************************************
// функция возвращает наименование вида заявки по нрек заявки

Function GetVidZayavki(cINDENT: comp): string;
{
  result := 'не определен';
  InitServTXO(0);
  var vsTempName : string = UpCase(sTxoGetField('RESINFO', 'NAME', coTxoGetField('INDENT', 'CTYPE', cINDENT)));
  if InStr('ОСНОВНАЯ',vsTempName) > 0 then {
      result := 'основная';
  } else {
    if InStr('ПРЕДВАРИТЕЛЬНАЯ',vsTempName) > 0 then {
      result := 'предварительная';
    } else {
      if InStr('НА КВАРТАЛ',vsTempName) > 0 then {
        result := 'на квартал';
      } else {
        if InStr('ДОПОЛНИТЕЛЬНАЯ',vsTempName) > 0 then {
          result := 'дополнительная';
        }
      }
    }
  }
} // function GetLastPrihDate

//******************************************************************************
// запрос возвращает нрек карты брака по нрек акта на списание

sql query qGetKartBrak =
select top 1 nrec
from katsopr
where CNZAKAZ = :qcAktSpis
and vidsopr = 21053 //Карта брака
;

//******************************************************************************
// функция возвращает нрек карты брака по нрек акта на списание

Function GetKartBrak(cActSpis: comp): comp;
{
  result := 0h;
  var pQuery: IQuery = QueryManager.CreateQuery(qGetKartBrak);
  pQuery.setParam('qcAktSpis', cActSpis);
  var pResultSet : IResultSet = pQuery.getResultSet;
  if pQuery.errorCode = tsOk then {
    if pResultSet.getFirst = tsOk then {
      result := pResultSet.row.val('nrec');
    }
  }
} // function GetKartBrak

//******************************************************************************
// запрос возвращает номер акта по качеству по нрек карты брака

sql query qGetAktQualNum =
select top 1 nsopr,TypeDoc
from spsopr
join katsopr on katsopr.nrec = spsopr.csopr
where spsopr.cadocsp = :qcKartBrak
and spsopr.wadocsp = 21053 //Карта брака
;

//******************************************************************************
// функция возвращает номер акта по качеству по нрек карты брака

Function GetAktQualNum(cKartBrak: comp): string;
{
  result := '';
  var pQuery: IQuery = QueryManager.CreateQuery(qGetAktQualNum);
  pQuery.setParam('qcKartBrak', cKartBrak);
  var pResultSet : IResultSet = pQuery.getResultSet;
  if pQuery.errorCode = tsOk then {
    if pResultSet.getFirst = tsOk then {
      result := pResultSet.row.val('nsopr')+iCase(pResultSet.row.val('TypeDoc');'_02','_03','_01';'');
    }
  }
} // function GetAktQualNum

//******************************************************************************
// запрос возвращает дату и цену последнего прихода по МЦ и партии

sql query qGetLastPrihPartyDate =
select top 1 dord from sporder
where tipord = 1
and vidorder = 0
  and kol > 0
  and cmc = :qMCNrec
  and cparty = :qcParty
order by dord desc
;

//******************************************************************************
// функция возвращает дату последнего прихода по МЦ и партии

Function GetLastPrihPartyDate(cMC, cParty: comp): date;
{
  result := date(0,0,0);
  var pQuery: IQuery = QueryManager.CreateQuery(qGetLastPrihPartyDate);
  pQuery.setParam('qMCNrec', cMC);
  pQuery.setParam('qcParty', cParty);
  var pResultSet : IResultSet = pQuery.getResultSet;
  if pQuery.errorCode = tsOk then {
    if pResultSet.getFirst = tsOk then {
      result := pResultSet.row.val('dord');
    }
  }
} // function GetLastPrihDate

//******************************************************************************

end. // interface
