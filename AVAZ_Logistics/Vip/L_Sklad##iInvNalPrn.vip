#include iLabel.vih

#component "L_Sklad"
//------------------------------------------------------------------------------
//                                                                  (c) Топ Софт
// Система T2 ERP - Складской учет
// Инвентаризационный ярлык
//------------------------------------------------------------------------------

#include InvTagPrn.vih
#include SDfuns.vih

/*
Печатается только из окна редактирования.
Можно печатать текущую позицию спецификации (помеченные) или всю спецификацию описи.
*/

//------------------------------------------------------------------------------
#doc
Инвентаризационный ярлык
#end
Interface iInvTagPrn '' EscClose;

#include SDfuns.var

//------------------------------------------------------------------------------
table struct InvTag
(
  nRec      : comp,
  TipDoc    : word,
  cInvTab   : comp,
  dInv      : date,
  Sklad     : string,
  MCBarKod  : string,
  MCName    : string,
  KatEdName : string,
  MOL       : string,
  MOLPost   : string,
  BarCode   : string,
  RNum      : string
)
with index
(
  indInvTag0 = nRec (Unique)
);

var iL : iLabel;

//------------------------------------------------------------------------------
Create view
Var
  cFixSpDoc : comp;
  GroupName : string;
  cMyOrg    : comp;
  ParFlt,
  ParView   : byte;
  i, mCount : longint;
As select
  *
From
  SpInvTab,
  InvTab,
  KatPodr,
  KatMOL,
  KatMC,
  KatEd,
  RzKutPrih,
  KatOrg,
  SPECMTR,
  InvTag
Where
((
    cFixSpDoc        == SpInvTab.nRec
and SpInvTab.cInvTab == InvTab.nRec
and InvTab.cSklad    == KatPodr.nRec
and SpInvTab.cMC     == KatMC.nRec
and KatMC.cEd        == KatEd.nRec
and InvTab.cMol      == KatMOL.nRec
and SpInvTab.cRzKut  == RzKutPrih.nRec
and cMyOrg           == KatOrg.nRec
and coSpInvTab       == SPECMTR.coTable
and SpInvTab.NRec    == SPECMTR.cSpec
))
;

//------------------------------------------------------------------------------
Procedure ReadParam;
{
  if not ReadMyDsk(ParFlt, 'ParFlt_iInvTagPrn', False)
    set ParFlt := cgSelSpDoc;
  if not ReadMyDsk(ParView, 'ParView_iInvTagPrn', false)
    set ParView := 0;
}

//------------------------------------------------------------------------------
Procedure SaveParam;
{
  SaveMyDsk(ParFlt,  'ParFlt_iInvTagPrn');
  SaveMyDsk(ParView, 'ParView_iInvTagPrn');
}

//------------------------------------------------------------------------------
#declare FieldInvTag
  ParFlt ('Выводить на печать выбранные/все документы') : [List cgSelSpDoc 'По выбранным документам (по текущему)',
                                                                cgFltSpDoc 'По документам в рамках ограничений'], Protect;
  ParView('Не отображать окно настройки при печати',,sci1Esc): NoProtect, NoFrame;
#end

//------------------------------------------------------------------------------
#declare ScreenInvTag

 `Отчет`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

  [.] не отображать окно настройки при печати`

#end

//------------------------------------------------------------------------------
Window wiPrintInvTag 'Настройка печати инвентаризационного ярлыка' (,hcSklMInventLocMenu,) DoAccept, EscClose, Gray;
  Show at (,,54,7);
Screen scPrintInvTag (,,sci13Esc);
  NoTableNavigation;
Fields
  #FieldInvTag
Buttons
  cmOk, Default,,'Продолжить',,sci1Esc;
  cmCancel,,,'Отмена',,sci1Esc;
<<
  #ScreenInvTag
     <. Продолжить .>             <.   Отмена   .>
>>
end;
HandleEvent
cmOk:
{
  SaveParam;
  PutCommand(cmDefault);
}
end; // Handle
end; // Window

//------------------------------------------------------------------------------
Window wiSetParamInvTag 'Настройка печати инвентаризационного ярлыка' (,hcSklMInventLocMenu,) DoAccept, EscClose, Gray;
  Show at (,,54,7);
Screen scSetParamInvTag (,,sci13Esc);
  NoTableNavigation;
Fields
  #FieldInvTag
Buttons
  cmOk, Default,,'Сохранить',,sci1Esc;
  cmCancel,,,'Отмена',,sci1Esc;
<<
  #ScreenInvTag
     <. Сохранить .>             <.   Отмена   .>
>>
end;
HandleEvent
cmInit:
{
  ReadParam;
}
cmOk:
{
  SaveParam;
  PutCommand(cmDefault);
}
end; // Handle
end; // Window

// -----------------------------------------------------------------------------
form curform ('Inv_Jarl.out', 'Inv_Jarl') with novisual;

//------------------------------------------------------------------------------
Function InsInvTag: boolean;
{
  Result := false;
  iL.AddMC(InvTab.dInv,KatPodr.Nrec,KatMC.NRec,SPECMTR.Nrec,SpInvTab.cParty,0);
}

//------------------------------------------------------------------------------
Procedure PrintData;
{
  iL.Print;
}

//------------------------------------------------------------------------------
//  Печать документа
Public function Print(_Marker: TPtr): boolean;
{
  Result := false;

  mCount := GetMarkerCount(_Marker);

  if (mCount = 0)
  {
    message(''#3'Нет данных для печати!', Information);
    exit;
  }

  cMyOrg := coGetTune('MyOrg');

  MTClear(#InvTag, mfNormal);
  iL.Init;
  StartNewVisual(vtIndicatorVisual, vfTimer + vfBreak + vfConfirm, 'Формирование потока данных...', mCount);

  for(i:= 0; i<mCount; i++)
  {
    if not NextVisual
      break;

    if GetMarker(_Marker, i, cFixSpDoc)
      if (GetFirst SpInvTab = tsOk)
        if (GetFirst InvTab = tsOk)
          InsInvTag;
  }

  StopVisual;

/*  if (GetFirst InvTag <> tsOk)
  {
    message(''#3'Нет данных для печати!', Information);
    exit;
  }  */

  PrintData;

  Result := true;
}

//------------------------------------------------------------------------------
//  Параметры печати
Public function GetParam: word;
{
  Result := 0;

  ReadParam;

  if (ParView = 0)
    if (RunWindowModal(wiPrintInvTag) <> cmDefault)
      exit;

  Result := ParFlt;
}

//------------------------------------------------------------------------------
// Настройка печати
Public function SetParam: boolean;
{
  Result := (RunWindowModal(wiSetParamInvTag) = cmDefault);
}
End.
