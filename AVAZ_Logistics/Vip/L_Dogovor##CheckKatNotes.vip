
#component "L_DOGOVOR"
#include Notes.vih

#doc
Проверка целостности статусов
#end
Alter Interface CheckKatNotes;

overload
procedure ChkKatNotes ;

end;

procedure ChkKatNotes ;
{
  if (Not oNotes.GetWorkDocNotes(pVidDoc))
    {
      Message('Незарегистрированный вид в ChkNotes.vip, вид - '+string(pVidDoc),Information);
      Exit;
    }

  ReSetBounds(#KatNotes);

  case pVidDoc of
    cgKB_Doc:
      {
      AddNote (0,0,0,'0','Создана'              ,'cоздана' ,1) ;
      AddNote (0,0,1,'1','Решение введено'      ,'введено',1) ;
      AddNote (0,0,2,'2','Закрыта'              ,'закрыта',1) ;
      AddNote (0,0,3,'3','Аннулирована'         ,'аннул.',1) ;

      delete KatNotes where ((pVidDoc == KatNotes.VidDoc and
                              word(3) << KatNotes.Status));
      }
    cgAct_on_Quality:
      {
      AddNote (0,0,0,'0','Создан'               ,'cоздан' ,1) ;
      AddNote (0,0,1,'1','Сдан в ДПЛ'           ,'ДПЛ',1) ;
      AddNote (0,0,2,'2','На рассмотрении у ГБ' ,'ГБ',1) ;
      AddNote (0,0,3,'3','Закрыт'               ,'закрыт',1) ;
      AddNote (0,0,4,'4','Аннулирована'         ,'аннул.',1) ;

      delete KatNotes where ((pVidDoc == KatNotes.VidDoc and
                              word(4) << KatNotes.Status));
      }
    end;
  inherited::ChkKatNotes;
}
end. // Interface
