#component "F_SFO"
#Include GetKau.vih
#doc
Интерфейс редактирования соответствия должностей и норм выдачи спецодежды.<br>
#end
Interface ListOfNorms 'Соответствие должностей и норм выдачи спецодежды' (, hcSFO_SootvDolgnNorm,) Cyan, EscClose;
  Show At (,, 110,);

Table Struct tblPostList
(
  NRec  : comp,
  cPost : comp,
  sPost : string,
  cPodr : comp,
  sPodr : string,
  cUch  : comp,
  sUch  : string,
  cBrig : comp,
  sBrig : string,
  wSex  : word
)
With Index
(
  tblPostList01 = NRec (Unique, Surrogate),
  tblPostList02 = cPost + cPodr + wSex + cUch + cBrig,
  tblPostList03 = sPost + sPodr + wSex + sUch + sBrig
);

var cpPostList : Record As Table tblPostList;
#Include GetKau.var
Create View
As Select
//-------------------------
  if (KatKod.cWord1 = 0, 'Ф', 'С')
                       (FieldName = NormSp),
//-------------------------
  if (KatKod.cWord2 = 0, 'О', 'Д')
                       (FieldName = NormOsn),
//-------------------------
  if (KatKod.cWord3 = 0, 'О', 'С')
                       (FieldName = NormSovm),
//-------------------------
  tblPostList.*, KatKod.*
From
  NormSFO
, Catalogs
, KatPodr
, KatKod
, SpKau KatUch
, SpKau KatBrig
, tblPostList
, Synonym KatKod KatKodS
, Synonym tblPostList svPostList
, Synonym tblPostList tblPostListS

Where
((
// список должность - подразделение - пол
    tblPostList.cPost == Catalogs.nRec
and tblPostList.cPodr == KatPodr.nRec
and tblPostList.cUch  == KatUch.nRec
and tblPostList.cBrig == KatBrig.nRec

// список норм
and tblPostList.nRec == svPostList.nRec
and cgKatKod_NormSFO == KatKod.wType
and svPostList.cPost == KatKod.cOrg1
and svPostList.cPodr == KatKod.cOrg2
and svPostList.wSex  == KatKod.cOrg3
and svPostList.cUch  == KatKod.cOrg4
and svPostList.cBrig == KatKod.cOrg5 (NoIndex)
and KatKod.cGroup    == NormSFO.nRec
))
Order by tblPostList.sPost, tblPostList.sPodr, tblPostList.wSex
;

//----------------------------------------------------------------------------

Form frmReport('ListOfNorms.OUT', 'LstNrSFOProt') With NoVisual;

//------------------------------------------------------------------------------
// Окно редактирования
//------------------------------------------------------------------------------
Window wiEditParams 'Редактирование соответствия' EscClose;
  Show At (,, 70, 15);

Screen scEditParams ('Редактирование соответствия "должность - норма"',, sci1378Esc);
  Show At (,,, 7);
  Table tblPostList;
Fields
  Catalogs.Name    ('Должность работника') : Protect,PickButton,
    {Font = {BackColor = if (tblPostList.cPost = 0, ColorNeed, 0)}};
  Catalogs.Code    ('Должность работника') : Protect,
    {Font = {BackColor = if (tblPostList.cPost = 0, ColorNeed, 0)}};
  KatPodr.Name     ('Подразделение работника') : Protect,PickButton;
  KatPodr.Kod      ('Подразделение работника') : Protect;
  KatUch.name      ('Участок работника') : Protect,PickButton;
  KatBrig.name     ('Бригада работника') : Protect,PickButton;
  tblPostList.wSex ('Пол работника') : [List ' ', 'Муж.', 'Жен.'], Protect,PickButton;
<<

 `Должность`    .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@
 `Подразделение`.@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ .@@@@@@@@@
 `Участок`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Бригада`      .@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
 `Пол`          .@@@@@@@@@@@@


>>
End; // Screen scEditParams

Browse brEditNorm ('Список норм',, sci1378Esc);
  Show At (, 8,,);
  Table KatKod;
Fields
  NormSFO.Kod  'Код','нормы' ('Код нормы выдачи спецодежды') : [10], Protect,PickButton, NoAutoSize;
  NormSFO.Name 'Наименование','нормы' ('Наименование нормы выдачи спецодежды') : [50], Protect,PickButton;
  NormSp       'Ф' ('Норма выдачи форменной или специальной одежды') : [4],  Protect, NoAutoSize;
  NormOsn      'О' ('Основная или дополнительная норма')             : [4],  Protect, NoAutoSize;
  NormSovm     'Д' ('Норма выдачи по основной должности или по совместительству') : [4], Protect, NoAutoSize;
End; // Browse brEditNorm

End; // Window wiEditParams

//------------------------------------------------------------------------------
// Главное окно интерфейса
//------------------------------------------------------------------------------

Browse brPostList ('Должности работников',, sci1478Esc);
  Show At (,,, 10);
  Table tblPostList;
Fields
  Catalogs.Name    'Наименование','должности'     ('Наименование должности')     : [25], Protect,
    {Font = {BackColor = if (tblPostList.cPost = 0, ColorNeed, 0)}};
  Catalogs.Code    'Код','должности'              ('Код должности')              : [12], Protect, NoAutoSize,
    {Font = {BackColor = if (tblPostList.cPost = 0, ColorNeed, 0)}};
  KatPodr.Name     'Наименование','подразделения' ('Наименование подразделения') : [25], Protect;
  KatPodr.Kod      'Код','подразделения'          ('Код подразделения')          : [12], Protect, NoAutoSize;
  KatUch.name 'Наименование','Участок'   ('Участок работника') : [25], Protect;
  KatBrig.name 'Наименование','Бригада'  ('Бригада работника') :[25], Protect;
  if (tblPostList.wSex = 2, 'Ж', if (tblPostList.wSex = 1, 'М', ''))
                   'Пол','работника'              ('Пол работника')              : [3],  Protect;
End; // Browse brPostList

Browse brNormList ('Список норм',, sci1Esc);
  Show At (, 11,,);
  Table KatKod;
Fields
  NormSFO.Kod  'Код','нормы' ('Код нормы выдачи спецодежды') : [10], Protect, NoAutoSize;
  NormSFO.Name 'Наименование','нормы' ('Наименование нормы выдачи спецодежды') : [50], Protect;
  NormSp       'Ф' ('Норма выдачи форменной или специальной одежды') : [4],  Protect, NoAutoSize;
  NormOsn      'О' ('Основная или дополнительная норма')             : [4],  Protect, NoAutoSize;
  NormSovm     'Д' ('Норма выдачи по основной должности или по совместительству') : [4], Protect, NoAutoSize;
End; // Browse brNormList

//------------------------------------------------------------------------------
// Обработчики событий
//------------------------------------------------------------------------------
TableEvent Table tblPostList;
//---------------------
  cmSetDefault:
  {
    ClearBuffer(#tblPostList);
    SelectField(#Catalogs.Name);
    PutCommand(cmEdit);
  }
//-----------------------
  cmInsertRecord:
    Insert Current tblPostList;
//-----------------------
  cmUpdateRecord:
  {
    if (isValid(#svPostList))
      _LOOP KatKodS where (( cgKatKod_NormSFO == KatKodS.wType and
                             svPostList.cPost == KatKodS.cOrg1 and
                             svPostList.cPodr == KatKodS.cOrg2 and
                             svPostList.wSex  == KatKodS.cOrg3 and
                             svPostList.cUch  == KatKodS.cOrg4 and
                             svPostList.cBrig == KatKodS.cOrg5 (NoIndex)

                             ))
      {
        KatKodS.cOrg1 := tblPostList.cPost;
        KatKodS.cOrg2 := tblPostList.cPodr;
        KatKodS.cOrg3 := tblPostList.wSex;
        KatKodS.cOrg4 := tblPostList.cUch;
        KatKodS.cOrg5 := tblPostList.cBrig;
        Update Current KatKodS;
      }

    Update Current tblPostList;
  }
//-----------------------
  cmDeleteRecord:
    if (Message('Удалить текущее соответствие?', Confirmation + YesNo) = cmYes)
    {
      Delete KatKodS where (( cgKatKod_NormSFO  == KatKodS.wType and
                              tblPostList.cPost == KatKodS.cOrg1 and
                              tblPostList.cPodr == KatKodS.cOrg2 and
                              tblPostList.wSex  == KatKodS.cOrg3 and
                              tblPostList.cUch  == KatKodS.cOrg4 and
                              tblPostList.cBrig == KatKodS.cOrg5 (NoIndex)

                              ));
      Delete Current tblPostList;
    }
//-----------------------
  cmCheckRecord:
  {
    if (tblPostList.cPost = Comp(0))
    {
      Message('Укажите должность или удалите запись!', Information);
      SelectField(#Catalogs.Name);
      Abort;
      Exit;
    }

    if (GetFirst tblPostListS Where (( tblPostList.cPost == tblPostListS.cPost and
                                       tblPostList.cPodr == tblPostListS.cPodr and
                                       tblPostList.wSex  == tblPostListS.wSex and
                                       tblPostList.cUch  == tblPostListS.cUch and
                                       tblPostList.cBrig == tblPostListS.cBrig and
                                       (tblPostList.nRec <> tblPostListS.nRec) )) = tsOk)
    {
      Message('В списке уже есть запись с такими параметрами.'#13+
              'Измените параметры или удалите запись!', Information);
      SelectField(#Catalogs.Name);
      Abort;
      Exit;
    }
  }
//-----------------------
End; // TableEvent Table tblPostList

TableEvent Table KatKod;
//---------------------
  cmSetDefault:
  {
    ClearBuffer(#KatKod);
    KatKod.wType  := cgKatKod_NormSFO;
    KatKod.cOrg1  := tblPostList.cPost;
    KatKod.cOrg2  := tblPostList.cPodr;
    KatKod.cOrg3  := tblPostList.wSex;
    KatKod.cOrg4  := tblPostList.cUch;
    KatKod.cOrg5  := tblPostList.cBrig;
    KatKod.cWord1 := (wGetTune('Fin.SFO.FormOrSpec'));
    SelectField(#NormSFO.Name);
  }
//---------------------
  cmInsertRecord:
    insert current KatKod;
//---------------------
  cmUpdateRecord:
    update current KatKod;
//---------------------
  cmDeleteRecord:
    if (Message('Удалить информацию о текущей норме?', Confirmation + YesNo) = cmYes)
      delete current KatKod;
//---------------------
  cmCheckRecord:
  {
    if (KatKod.cGroup = Comp(0))
    {
      Message('Укажите норму выдачи или удалите запись!', Information);
      SelectField(#Catalogs.Name);
      Abort;
      Exit;
    }

    if (KatKod.cOrg1 = Comp(0))
    {
      Message('Укажите должность или удалите запись!', Information);
      SelectField(#Catalogs.Name);
      Abort;
      Exit;
    }

    if (GetFirst KatKodS Where (( cgKatKod_NormSFO == KatKodS.wType and
                                  KatKod.cOrg1     == KatKodS.cOrg1 and
                                  KatKod.cOrg2     == KatKodS.cOrg2 and
                                  KatKod.cOrg3     == KatKodS.cOrg3 and
                                  KatKod.cOrg4     == KatKodS.cOrg4 and
                                  KatKod.cOrg5     == KatKodS.cOrg5 (NoIndex)and
                                  KatKod.cGroup    == KatKodS.cGroup (NoIndex) and
                                      (KatKod.nRec <> KatKodS.nRec) )) = tsOk)
    {
      Message('Текущая норма уже есть в списке.'#13+
              'Измените норму или удалите запись!', Information);
      SelectField(#NormSFO.Name);
      Abort;
      Exit;
    }
  }
//---------------------
End; // TableEvent Table KatKod

//------------------------------------------------------------------------------
procedure LoadPostList;
{
  Delete All tblPostList;

  _LOOP KatKodS where (( cgKatKod_NormSFO == KatKodS.wType ))
    if (GetFirst tblPostList where (( KatKodS.cOrg1 == tblPostList.cPost and
                                      KatKodS.cOrg2 == tblPostList.cPodr and
                                Word(KatKodS.cOrg3) == tblPostList.wSex and
                                KatKodS.cOrg4 == tblPostList.cUch and
                                KatKodS.cOrg5 == tblPostList.cBrig
                                )) <> tsOk)
    {
      ClearBuffer(#tblPostList);
      set tblPostList.cPost := KatKodS.cOrg1;
      set tblPostList.cPodr := KatKodS.cOrg2;
      set tblPostList.wSex  := Word(KatKodS.cOrg3);
      set tblPostList.cUch := KatKodS.cOrg4;
      set tblPostList.cBrig := KatKodS.cOrg5;
      tblPostList.sPost := Catalogs.Name;
      tblPostList.sPodr := KatPodr.Name;
      tblPostList.sUch  := KatUch.Name;
      tblPostList.sBrig := KatBrig.name;
      Insert Current tblPostList;
    }
}

//------------------------------------------------------------------------------
HandleEvent // Interface
//----------------------
  cmInit:
  {
    LoadPostList;
    if (GetFirst tblPostList <> tsOk) {};
    ClearAdvRecord(cpPostList);
  }
//----------------------
  cmEdit:
    if (CurWindow <> wiEditParams)
      RunWindow(wiEditParams);
//----------------------
  cmPick:
  {
    case (CurField) of



    #KatUch.name:
         if iGetKau.GetCodeKau(cgiNo,cgKAU_BrUch, tblPostList.cUch)>0 then
         {
          set tblPostList.cUch := tblPostList.cUch;
          set tblPostList.sUch := KatUch.Name;

         }
    #KatBrig.name:
         if iGetKau.GetCodeKau(cgiNo,cgKAU_BrUch, tblPostList.cBrig)>0 then
         {
          set tblPostList.cBrig := tblPostList.cbrig;
          set tblPostList.sBrig := KatBrig.name;

         }

    //----------------
      #Catalogs.Name, #Catalogs.Code:
        if (RunInterface('PickCatalog2', Integer(-22), tblPostList.cPost, Comp(0)) = cmDefault)
        {
          set tblPostList.cPost := tblPostList.cPost;
          set tblPostList.sPost := Catalogs.Name;
        }
    //----------------
      #KatPodr.Name, #KatPodr.Kod:
        if (RunInterface('GetAnyPodr', tblPostList.cPodr, Word(0)) = cmDefault)
        {
          set tblPostList.cPodr := tblPostList.cPodr;
          set tblPostList.sPodr := KatPodr.Name;
        }
    //----------------
      #NormSFO.Kod, #NormSFO.Name:
        RunInterface('getNormSFO', KatKod.cGroup, '', Word(0));
    //----------------
      #NormSp:  set KatKod.cWord1 := if (KatKod.cWord1 = 0, 1, 0);
    //----------------
      #NormOsn: set KatKod.cWord2 := if (KatKod.cWord2 = 0, 1, 0);
    //----------------
    end;
  }
//----------------------
  cmDelOnProtect:
  {
    Stop;

    if (CurWindow <> wiEditParams)
      Exit;

    case (CurField) of
    #KatUch.name:
         {
          set tblPostList.cUch :=  Comp(0);
          set tblPostList.sUch := '';

         }
    #KatBrig.name:
         {
          set tblPostList.cBrig :=  Comp(0);
          set tblPostList.sBrig := '';
         }
     //----------------
      #Catalogs.Name, #Catalogs.Code:
      {
        set tblPostList.cPost := Comp(0);
        set tblPostList.sPost := '';
      }
    //----------------
      #KatPodr.Name, #KatPodr.Kod:
      {
        set tblPostList.cPodr := Comp(0);
        set tblPostList.sPodr := '';
      }
    //----------------
      #NormSFO.Kod, #NormSFO.Name:
        set KatKod.cGroup := Comp(0);
    //----------------
    end;
  }
//----------------------
  cmPrintDoc:
  {
    if (not UpdateTable)
      Exit;

    if (RecordExists KatKodS where (( cgKatKod_NormSFO == KatKodS.wType )) <> tsOk)
    {
      Message('Не заданы соответствия между должностями и нормами!');
      Exit;
    }

    frmReport.SetGroup('Соответствия');
    PushPos(#tblPostList);
    PushPos(#KatKod);

    _LOOP tblPostList
    {
      if (not isValid(#KatKod))
        Continue;

      frmReport.Write(Catalogs.Code);
      frmReport.Write(Catalogs.Name);
      frmReport.Write(KatPodr.Name);
      frmReport.Write(KatPodr.Kod);
      frmReport.SkipFormat(1);
      frmReport.Write(tblPostList.wSex);
      frmReport.SkipFormat(2);
      frmReport.PutEvent(feBreak);

      _LOOP KatKod
      {
        frmReport.Write(NormSFO.Kod);
        frmReport.Write(NormSFO.Name);
        frmReport.SkipFormat(4);
        frmReport.Write(if (KatKod.cWord1 = 0, 'Форм.', 'Спец.'));
        frmReport.Write(if (KatKod.cWord2 = 0, 'Осн.', 'Доп.'));
        frmReport.PutEvent(feBreak);
      }
    }

    frmReport.PutEvent(feBreak);
    PopPos(#tblPostList);
    PopPos(#KatKod);
    ReReadRecord;

    if (frmReport.Error)
      frmReport.AbortForm;
    else
      frmReport.ShowFile('Соответствия должностей и норм выдачи спецодежды');
  }
//----------------------
  cmSaveDoc:
    if (UpdateTable)
    {
      ClearAdvRecord(cpPostList);

      if (isValid(#tblPostList))
        cpPostList := tblPostList.Buffer;
    }
//----------------------
  cmReStoreDoc:
  {
    if (not UpdateTable)
      Exit;

    if (cpPostList.cPost = 0)
      Exit;

    if (GetFirst KatKodS where (( cgKatKod_NormSFO == KatKodS.wType and
                                  cpPostList.cPost == KatKodS.cOrg1 and
                                  cpPostList.cPodr == KatKodS.cOrg2 and
                                  cpPostList.wSex  == KatKodS.cOrg3 and
                                  cpPostList.cUch  == KatKodS.cOrg4 and
                                  cpPostList.cBrig == KatKodS.cOrg5 (NoIndex)



                                  )) <> tsOk)
      Exit;

    if (Message('Вставить записи из буфера?', Confirmation + YesNo) <> cmYes)
      Exit;

    PushPos(#KatKod);

    _LOOP KatKod where (( cgKatKod_NormSFO == KatKod.wType and
                          cpPostList.cPost == KatKod.cOrg1 and
                          cpPostList.cPodr == KatKod.cOrg2 and
                          cpPostList.wSex  == KatKod.cOrg3 and
                          cpPostList.cUch  == KatKod.cOrg4 and
                          cpPostList.cBrig == KatKod.cOrg5(NoIndex)

                          ))
    {
      if (GetFirst KatKodS where (( cgKatKod_NormSFO  == KatKodS.wType and
                                    tblPostList.cPost == KatKodS.cOrg1 and
                                    tblPostList.cPodr == KatKodS.cOrg2 and
                                    tblPostList.wSex  == KatKodS.cOrg3 and
                                    tblPostList.cUch  == KatKodS.cOrg4 and
                                    tblPostList.cBrig == KatKodS.cOrg5 (NoIndex)and
                                    KatKod.cGroup     == KatKodS.cGroup (NoIndex) )) = tsOk)
        Continue;

      KatKod.nRec  := 0;
      KatKod.cOrg1 := tblPostList.cPost;
      KatKod.cOrg2 := tblPostList.cPodr;
      KatKod.cOrg3 := tblPostList.wSex;
      KatKod.cOrg4 := tblPostList.cUch;
      KatKod.cOrg5 := tblPostList.cBrig;
      Insert Current KatKod;
    }

    PopPos(#KatKod);
    ReReadRecord(#KatKod);
    ReDrawPanel(#tblPostList);
    Message('Вставка записей завершена!');
  }
//----------------------
  cmHotKeys:
    PutHotCommand(RunMenu('ListOfNorms_HotKeys'));
//----------------------
End; // HandleEvent Interface
End. // Interface

ListOfNorms_HotKeys Menu
{
- 'Печать списка соответствий', cmPrintDoc, 'Печать списка соответствий', hcSFO_SootvDolgnNorm, 'Ctrl+P', kbCtrlP, sci1Esc;
-----------;
- 'Сохранение списка норм', cmSaveDoc, 'Сохранение списка норм, соответствующих текущей должности', hcSFO_SootvDolgnNorm, 'Ctrl+F2', kbCtrlF2, sci1Esc;
- 'Вставка сохраненного списка норм', cmRestoreDoc, 'Вставка сохраненного списка норм для текущей должности', hcSFO_SootvDolgnNorm, 'Ctrl+F3', kbCtrlF3, sci1Esc;
}
