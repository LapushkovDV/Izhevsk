const
  stCreate = 22;
  frMailParam = 22;
  frExportXLSX = 15;
end;

type
  frxSendMailParam = record
   MailTo     : String;
   Subject    : String;
   Body       : String;
   ShowDialog : Boolean;
end;

type
frxXLSXExportParam = record
  Pages           : String;  // Перечень страниц для экспорта (1,2 или 1-10,15). Если пусто, то все страницы.
  SuppressPageHeadersFooters : Boolean; // Неразрывный.

  Picture         : Boolean; // Экспортирование картинок.
  DeleteEmptyRows : Boolean; // Удаление пустых строк.
  ShowDialog      : Boolean; // Отображение диалога настроек экспорта.
  OpenAfterExport : Boolean; // Открытие сформированного файла после экспорта.
end;

#component "AVAZ_Logistics"
exception ExExcelFatalError;
Interface Avaz_PrintM4 '' ('', hcNoContext, sci1Esc);

var sErrMessage: string;
    lErrMessageMode,lCountRow: longInt;

Create View
var cNakl : comp;
as select *
from
 KatSopr
,SpSopr
,SklOrder
,SpOrder
,KatOrg
,KatPodr
,Dogovor
,KatMc
,KatEd
,KlVal
where
((
    cNakl == KatSopr.NRec
and KatSopr.cOrg == KatOrg.NRec
and KatSopr.cOrg == KatOrg.NRec
and KatSopr.cVal == KlVal.Nrec
and KatSopr.NRec == SklOrder.cSopr
and SklOrder.Nrec == SpOrder.cSklOrder
and SklOrder.cPodr == KatPodr.NRec
and SpOrder.cSpSopr == SpSopr.Nrec
and SpOrder.cMC == KatMc.NRec
and KatMc.cED == KatEd.NRec

));

Parameters cNakl;

datastream Rep
(
 table SklOrder
 (
  [ShrKod]  SklOrder.NRec;
  [nOrd]    SklOrder.nOrder;
  [dOrd]    SklOrder.dOrd;
  [myOrg]   sGetTune('MYORG');
  [PosINN]  KatOrg.UNN;
  [PosName] KatOrg.Name;
  [PosAdr]  KatOrg.Addr;
  [Podr]    KatPodr.Name;
  [PodrKod] KatPodr.Kod;
  [Dog_Ext] Dogovor.NoDoc_Ext;
  [Dog_Dat] Dogovor.dDoc;
  [Dog_Num] if(Dogovor.NoDoc<>'',Dogovor.NoDoc,Dogovor.NoDoc_Ext);
  [nSoprDoc] KatSopr.NSopr;
  [dSoprDoc] KatSopr.dSopr;
  [nSoprDocVA] sGetAttr(coKatSopr,KatSopr.NRec,VA_Q_N_TRAN);
  [dSoprDocVA] dGetAttr(coKatSopr,KatSopr.NRec,VA_Q_N_TRAN);
  [NDOVER] KatSopr.NDOVER;
  [DDOVER] KatSopr.DDOVER;
  [Val]    KlVal.SIMVOLV;
 );
 table SpOrder
 (
  [McName]  KatMc.Name;
  [McKod]   KatMc.BarKod;
  [EdKod]   sGetAttr(coKatEd,KatEd.NRec,'Код');
  [EdName]  KatEd.Name;
  [NaklKol] SpSopr.KolFact;
  [OrdKol]  SpOrder.Kol;
  [Price]   SpOrder.RSrPrice;
  [Sum]     Double(SpOrder.Kol * SpOrder.RSrPrice);
  [SumNds]  Double(SpSopr.SumNDS/SpSopr.KolFact*SpOrder.Kol);
  [Summa]   Double((SpOrder.Kol * SpOrder.RSrPrice)+Double(SpSopr.SumNDS/SpSopr.KolFact*SpOrder.Kol));
  [SumVal]  Double(SpOrder.Kol * SpOrder.RVPrice);
  [Cennik] '';

 );
)
 handleEvent
  cmPreProcess:  StartNewVisual(vtRotateVisual,vfTimer+vfBreak+vfConfirm, 'Формируется отчет', 0);
  cmPostProcess: StopVisual('', 0);
 end;
end;

