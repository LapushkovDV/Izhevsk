procedure Print;
{
  if UpCase(UserName) = UpCase('Evchic') then RunFReport(Rep,'', true);

  var FReport: Longint;
  var MailParam: frxSendMailParam;
  var BiffParam: frxXLSXExportParam;
  var AttachFile: string;

  set AttachFile:= '';

  ClearAdvRecord(MailParam);
  ClearAdvRecord(BiffParam);

  FReport := FRCreate(Rep);

 if FROpenReport(FReport, 'Приходный ордер М-4') then
 {
   if FRSetParameters(FReport,frExportXLSX,'ShowDialog := False;OpenAfterExport := true;') then
   {
    if FRExportReport(FReport, frExportXLSX, AttachFile) then {} else Message('Ошибка экспорта');
   }
   else
   {
     Message('Ошибка параметров');
   }
 }
 FRDestroy(FReport);

};

HandleEvent // Interface
cmInit:
{
 if GetFirst fastfirstrow SklOrder<>tsOk then
 {
   Message('Отсутствуют приходный ордер',Warning);
   exit;
 }
 Print;
}
End;
End.
