#component "F_MBP"
Alter Interface SPIS_MBP;


Window SpisDocWindow 'Акт на списание' EscClose;
HandleEvent // Interface
cmValue70:
{
  UpdateTable;
  RunInterface('AVAZ_Logistics::ImpExcelToDocMBP',MBPMove.Nrec);
}
end;
end;

HandleEvent // Interface
cmInit: {
  case Inherited::HandleEvent(cmInit) of
  heAbort :  Abort;
  heStop  :  Exit;
  end;

  //добавить тулбар в окно редактирования
  ApplyToolBarEx(Longint(LoadToolBarEx('AVAZ_Logistics::tbMBP_Doc')), SPISDOCWINDOW, -1 , -1, TB_SHOW);
  ReScanPanel(#MBPMove);
  //------------------------------------------------------
};

cmValue70:
{
  UpdateTable;
  RunInterface('AVAZ_Logistics::ImpExcelToDocMBP',MBPMove.Nrec);
}
end;
end.
