Window WorkMoveMBPWindow;

Browse BrowseOutE;
  Show at (, 11,, 20);
  Table MBPIn;
Fields
  {Font = {Color = if (FoundMarker(SpecMarker, MBPIn.nRec), ColorMark, 0)}};
  isPicked// if (FoundMarker(SpecMarker, MBPIn.nRec), 'V', '')
                 'V'            ('Признак выбора спецификации')                             : [1],   Skip,    noAutoSize;
  MBPIn.KolDoc   'Введено'      ('Количество предметов, вводимое в эксплуатацию')           : [8.3],          noAutoSize,
    {Font = {BackColor = if (Abs(MBPIn.KolDoc) < 0.000001, ColorNeed, 0)}};
  WorkEd         'ЕдИзм'        ('Используемая единица измерения')                          : [5],   Protect, noAutoSize;
  MBPIn.PercNach '% изн.'       ('Процент износа, начисляемый при вводе в эксплуатацию')    : [6.2], NoProtect, noAutoSize;
  InDocSum       'Сумма'        ('Балансовая стоимость введенных в эксплуатацию предметов') : [15.2],         noAutoSize;
  KatMBP.Name    'Наименование' ('Наименование предметов')                                  : [28],  Protect, EditButton;
  KatMBP.NNumber 'Номенклат. №' ('Номенклатурный номер предметов', hcMBPFReleterSign)       : [13],  Protect, noAutoSize, EditButton;
  PartyName      'Партия'       ('Партия предметов')                                        : [8],   Protect, noAutoSize, EditButton;
  GroupSFO.Name  'Наименование','спецификации нормы'  ('Наименование спецификации нормы выдачи спецодежды')                      : [28],  Protect;
  GroupSFO.Kod   'Код','спецификации'  ('Код спецификации нормы выдачи спецодежды')                               :  [9],  Protect, noAutoSize;
  SrokExpl       'Срок','службы'  ('Срок службы введенных в эксплуатацию предметов в месяцах')               : [14],   Protect, noAutoSize;
  IsSerialReg    'У'            ('"С" - учет серийных номеров, "М" - маркировка, "-" - не ведется. Красный цвет - количество серийных номеров не совпадает с количеством предметов'): [2], Protect, noAutoSize, Centered,
    {Font = {Color = GetSerialColor}};
  SaldTune.Name  'Набор АЦУ'    ('')                                                        : [10], Protect, noAutoSize;
  vsKau1         'КАУ 1'        ('')                                                        : [12], Protect, noAutoSize;
  vsKau2         'КАУ 2'        ('')                                                        : [12], Protect, noAutoSize;
  vsKau3         'КАУ 3'        ('')                                                        : [12], Protect, noAutoSize;
  vsKau4         'КАУ 4'        ('')                                                        : [12], Protect, noAutoSize;
  vsKau5         'КАУ 5'        ('')                                                        : [12], Protect, noAutoSize;
  vsKau6         'КАУ 6'        ('')                                                        : [12], Protect, noAutoSize;
  vsKau7         'КАУ 7'        ('')                                                        : [12], Protect, noAutoSize;
  vsKau8         'КАУ 8'        ('')                                                        : [12], Protect, noAutoSize;
  vsKau9         'КАУ 9'        ('')                                                        : [12], Protect, noAutoSize;
  vsKau10        'КАУ 10'       ('')                                                        : [12], Protect, noAutoSize;
End; // Browse BrowseOutE

HandleEvent // Interface
cmValue70:
{

  UpdateTable;
  RunInterface('AVAZ_Logistics::ImpExcelToDocMBP',MBPMove.Nrec);
}
end;

end;

HandleEvent // Interface
cmInit: {
  case Inherited::HandleEvent(cmInit) of
  heAbort :  Abort;
  heStop  :  Exit;
  end;
  cAttr_Spec_rab:=ExtAttr_ID ( coMBPMove,VA_SO_Spec_rab);
  cAttr_Spec_norm:=ExtAttr_ID ( coMBPMove,VA_SO_Spec_norm);
  //добавить тулбар в окно редактирования
  ApplyToolBarEx(Longint(LoadToolBarEx('AVAZ_Logistics::tbMBP_Doc')), WorkMoveMBPWindow, -1 , -1, TB_SHOW);
  ReScanPanel(#MBPMove);
  //------------------------------------------------------
};

cmValue70:
{
  UpdateTable;
  RunInterface('AVAZ_Logistics::ImpExcelToDocMBP',MBPMove.Nrec);
}
end;
end.
